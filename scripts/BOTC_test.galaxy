    g_tipLine[470] = StringToText("暴乱");
    g_tipLine[471] = StringToText("：如果暴乱提名并处决了") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择的那名玩家，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
