int BOTC_NewList (int d, int w, int h, int x, int y) {
    DialogControlCreate(d, c_triggerControlTypeListBox);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), w, h);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, x, y);
    return DialogControlLastCreated();
