    }
    DialogControlSetPosition(g_pickSec[0], PlayerGroupAll(), c_anchorTopLeft, 30, 46);
    DialogControlSetPosition(g_pickSec[1], PlayerGroupAll(), c_anchorTopLeft, 30, 336);
    DialogControlSetPosition(g_pickSec[2], PlayerGroupAll(), c_anchorTopLeft, 30, 496);
    DialogControlSetPosition(g_pickSec[3], PlayerGroupAll(), c_anchorTopLeft, 30, 656);
    libNtve_gf_SetDialogItemText(g_pickSec[0], TextWithColor(StringToText("镇民"), Color(0, 191, 255)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_pickSec[1], TextWithColor(StringToText("外来者"), Color(0, 191, 255)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_pickSec[2], TextWithColor(StringToText("爪牙"), Color(255, 69, 0)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_pickSec[3], TextWithColor(StringToText("恶魔"), Color(255, 0, 0)), PlayerGroupAll());

    // 网格位置：镇民 0..12 = 第一行 9 个 + 第二行 4 个；外来者 13..16 / 爪牙 17..20 各一行 4 个；恶魔 21 单独一个
    // 建 64 格（位置 / 图标 / 名字 都由 BOTC_PickLayout 按当前板子摆；用不到的格会藏起来）
    for (j = 0; j < 64; j += 1) {
        g_pickBtn[j] = BOTC_NewButton(g_pickDlg, 85, 85, 60, 76, "");
