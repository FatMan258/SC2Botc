int         g_testDaySec;     // 今天已经过去多少秒
bool        g_testNomAuto;    // 【测试】今天的自动提名是否做过了
// 【测试猎手弹窗】聊天里发 slay / slayd / slayp 打开：游戏第 1 个白天让 玩家2 自动声称【猎手】猎杀 玩家3
//   slay  = 先把座位 2 变成真猎手；slayd = 「酒鬼猎手」（魔典写猎手、其实是酒鬼）；
//   slayp = 「中毒的猎手」（真猎手 + 中毒 token）
bool        g_testSlayOn;     // 开关（发同一条指令再发一次 = 关掉）
int         g_testSlayMode;   // 0 = 真猎手 / 1 = 酒鬼猎手 / 2 = 中毒的猎手
bool        g_testSlayDone;   // 这一局已经自动跑过一次了

