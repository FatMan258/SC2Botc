//--------------------------------------------------------------------------------------------------
// 昼夜：夜间遮罩 + 说书人切换按钮
//--------------------------------------------------------------------------------------------------
void BOTC_NightApply () {
    if (g_isNight) {
        // 引擎级光照：黑夜（Agria Night），2 秒渐暗
        GameSetLighting("AgriaNight", 2.0);      // 夜晚：Agria Night，2 秒渐暗
    }
    else {
        // 白天：Agria 日光，2 秒渐变
        GameSetLighting("Agria", 2.0);
    }
}

// 昼夜切换的统一入口：
//   夜里 → 白天：立刻切（天亮那边有「白天 X」黄字提示）
//   白天 → 黑夜：**先走 5 秒倒计时**（BOTC_NightPending），倒计时结束才真的入夜
void BOTC_NightToggle () {
    if (g_isNight) {
        BOTC_NightGo();
    }
    else {
        BOTC_NightPending();
    }
}

// 白天 → 黑夜的 5 秒倒计时：先把提名环节收掉，再一边倒数一边等，到点才真的入夜
void BOTC_NightPending () {
    if (g_nightPend) {
        return;                        // 已经在倒数了，别叠
    }
    if (g_startPending) {
        BOTC_Notice(g_teller, "正式开始的 10 秒倒计时还在走：等它结束就会自动进入第 1 夜。");
        return;                        // 免得倒计时期间又手动切昼夜
    }
    if (g_isNight) {
        return;
    }
    if (g_gameOver) {
        return;                        // 已经分出胜负：不再切昼夜
    }
    g_nightPend = true;                // ⚠ 先立旗：下面 BOTC_NomClose() 会反过来调 NightToggle
    if (g_phase != 0) {
        BOTC_NomClose();               // 提名环节立刻收掉（不然这 5 秒里还能接着提名）
    }
    // 倒计时期间不要音乐：把当前这首 / 排队要放的那首都停掉（BOTC_NomClose 会顺手排上白天的曲子）
    BOTC_MusicStop();
    g_nightPendSec = 5;
    BOTC_PlaySfx(g_sfxCountName);      // daojishi
    BOTC_BigNoticeC(IntToString(g_nightPendSec) + " 秒后进入夜晚", Color(255, 215, 60));
    TimerStart(g_tNightPend, 1.0, true, c_timeGame);
}

bool BOTC_NightPendFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_nightPend) {
        return true;                   // 没在倒数：这一拍不动
    }
    if (g_gameOver) {
        g_nightPend = false;           // 这 5 秒里分出胜负了：不再入夜
        return true;
    }
    g_nightPendSec = g_nightPendSec - 1;
    if (g_nightPendSec <= 0) {
        g_nightPend = false;
        BOTC_NightGo();                // 倒计时结束：真的入夜（会放 ping + 弹「夜晚 X」+ 换夜晚曲）
        return true;
    }
    BOTC_BigNoticeC(IntToString(g_nightPendSec) + " 秒后进入夜晚", Color(255, 215, 60));
    return true;
}

// 真正执行昼夜切换（原来的 BOTC_NightToggle 内容）
void BOTC_NightGo () {
    int q;
    if (g_gameOver) {
        g_nightPend = false;           // 已经分出胜负：不再切昼夜（免得盖在胜利面板上）
        return;
    }
    if (g_isNight) {
        // 【月之子的那一刀先结算】（用户 2026-09-20）：它是**夜里**发生的，要在「天亮了」之前算掉 ----
        //   否则会被记成「今天有人死」（僵怖当晚被误挡），还会给死者打上「死于今日」。
        BOTC_MoonChildResolve();
        // 【保留角色】道士 / 鸩造成的醉酒只持续到黎明。
        for (q = 2; q <= 13; q += 1) {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 142] || g_tokOn[(((g_teller * 14) + q) * 256) + 144]) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 142] = false;
                g_tokOn[(((g_teller * 14) + q) * 256) + 144] = false;
                BOTC_PmStore(g_teller, "【黎明】" + BOTC_NameStr(q) + " 的道士 / 鸩醉酒到期。");
            }
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 156] || g_tokOn[(((g_teller * 14) + q) * 256) + 157]) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 156] = false;
                g_tokOn[(((g_teller * 14) + q) * 256) + 157] = false;
                BOTC_PmStore(g_teller, "【黎明】" + BOTC_NameStr(q) + " 的杂技演员提示 token 到期。");
            }
        }
        g_isNight = false;        // 【恐惧之灵(102)】（用户 2026-10-03）：昨晚换了新目标 -> 白天公开播报一句「恐惧蔓延了」（红字）
        if (g_fearPending) {
            g_fearPending = false;
            BOTC_PubAnnounce("恐惧蔓延了");
        }
        // 时段编号：进入白天 = 第（当前夜号）天。编号还没启动（正式开始前）就只记准备阶段
        if (g_nightNum > 0) {
            g_dayNum = g_nightNum;
        }
        // 新的一天：处决名额重新开放
        g_execUsedToday = false;
        // 新的一天：快进票重新投（昨天那几票不带过来）
        BOTC_SkipReset();
        libNtve_gf_SetDialogItemText(g_nightBtn, StringToText("进入夜晚"), PlayerGroupSingle(g_teller));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("天亮了"));
        // 天亮那声 baitian（音效）：放出来，4 秒后淡出停掉 ---- 刚好接上 4 秒后进来的白天音乐
        BOTC_PlaySfxTimed(g_sfxDayName, 4.0);
        // 屏幕中上方弹**黄色**大字「白天 X」（跟「夜晚 X」同一套位置；准备阶段号码是 0 就不弹）
        if (g_dayNum >= 1) {
            BOTC_BigNoticeC("白天 " + IntToString(g_dayNum), Color(255, 215, 60));
        }
        // 【天亮自动收回技能】用户 2026-09-19：不管谁触发的「进入白天」，天亮那一刻
        //   把所有还开着的技能收回来（免得技能面板 / 技能按钮留到白天）
        BOTC_SkillRetractAll();
        g_wakeMode = false;            // 白天不许唤醒：顺手退出唤醒模式（按钮也会跟着藏起来）
        g_autoOn = false;              // 自动唤醒：白天收掉，下一夜从头来
        g_autoLast = 0;
        g_chatSay[g_teller] = 0;              // 说书人回车切回公聊
        libNtve_gf_SetDialogItemText(g_sayBtnP[g_teller], StringToText("聊天：公聊"), PlayerGroupSingle(g_teller));
        // 进入白天：重置今天的提名次数与投票
        BOTC_NomReset();
        if (g_dayNum > 0) {
            BOTC_PeriodRecord("---- 第" + IntToString(g_dayNum) + "天 ----");
        }
        else {
            BOTC_PeriodRecord("---- 准备阶段（进入白天）----");
        }
        // 天亮了：先放弃夜晚那一层的优先级，再切发言时段
        //   ⚠ 不要在这里直接 BOTC_MusicStop() 再放新的 ---- 淡出还没走完就播，
        //     引擎会接不上（表现就是"切完白天没声音，再点一下公聊/私聊才响"）。
        //     统一交给 BOTC_DayMusicRefresh() 走「淡出 → 4 秒 → 播放」那条路（昼夜切换留 4 秒）。
        BOTC_MusicDropPrio(1);
        // 进入白天：**默认就是私聊时段**（用户 2026-09-17）；**正式开始之前默认公聊**。
        //   智能说书那边，要是本局设置投的是「把私聊换成自由发言」，那就直接进自由发言。
        if (g_dayNum > 0) {
            BOTC_ChatModeSet(1);
        }
        else {
            BOTC_ChatModeSet(2);       // 还没正式开始：默认公聊（用户 2026-09-17）
        }
        BOTC_DayMusicRefresh(4.0);
        // 天亮结算：小恶魔的刀在这里生效、播报昨晚的死亡（僧侣的保护同时失效）
        BOTC_DawnResolve();
        // 【利维坦（127）】只在进入白天后公开；中毒 / 醉酒 / 死亡当天不通知。
        BOTC_LeviathanDayCheck();
        // 【维齐尔（141）】第一个白天公开身份；使用能力层判定，炼金术士借到也会播报。
        BOTC_VizierAnnounce();
        // 【进入白天 → 全场自动弹魔典】（用户 2026-09-20 提的，2026-09-22 修）----
        //   ⚠ 这一行原来被放进了下面「入夜」那一支（注释写着「进入白天」），所以天亮从来没弹过。
        //   现在挪到天亮这一支的末尾（天亮结算 + 猎手测试之后）：天一亮，全场每个人的魔典都会自己弹出来。
        DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    }
    else {
        g_isNight = true;
        BOTC_OrganDuskClear();
        // 时段编号：进入夜晚 = 第（当前天号 + 1）夜
        if (g_dayNum > 0 || g_nightNum > 0) {
            g_nightNum = g_dayNum + 1;
        }
        libNtve_gf_SetDialogItemText(g_nightBtn, StringToText("进入白天"), PlayerGroupSingle(g_teller));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("天黑了"));
        if (g_nightNum > 0) {
            BOTC_PeriodRecord("---- 第" + IntToString(g_nightNum) + "夜 ----");
        }
        else {
            BOTC_PeriodRecord("---- 准备阶段（进入夜晚）----");
        }
        // 点【进入夜晚】→ 自动切成公聊模式（夜里不再限制，统一按公聊走）
        BOTC_ChatModeSet(2);
        BOTC_PullAllToPublic();
        // 【小怪宝】（用户 2026-10-22）：第 1 夜不自动打开恶人频道；从第 2 夜起才自动拉群。
        if (g_lmOn && g_nightNum > 1) {
            BOTC_LmGroupChat();
        }
        // 邪恶小窗：入夜自动关掉（用户 2026-09-17）
        BOTC_EvilClose();
        // 【夜晚不计时】（用户 2026-09-19）：聊天时段计时是**白天**的事 ----
        //   入夜就把那条倒计时收掉（真人说书 / 智能说书都收，免得夜里还挂着「公聊时间：2:51」）。
        if (g_tmOn) {
            g_tmOn = false;
            g_tmLeft = 0;
            BOTC_TimerRender();
        }
        // 进夜晚先把提名环节收掉（提名只能在白天）
        if (g_phase != 0) {
            BOTC_NomClose();
        }
        // 进夜晚：把白天那一轮的投票状态全清掉 ---- 魔典上的「已投 / 弃权 / 票数 / 待处决」标记
        //   是当天的事，不该跟着进夜里（g_vote 清空后下面的 BOTC_NomUI() 会把标记刷成空白）
        BOTC_NomReset();
        // 进夜晚：开始放夜晚那首音乐（昼夜切换留 4 秒，给「天黑了」的大提示）
        BOTC_MusicPlay(g_musicNightName, 3, 4.0);   // 优先级 3：夜晚最高，谁都盖不掉
        // 入夜的那一下：一声 ping + 屏幕中上方的大字「夜晚 X」
        BOTC_NightBanner();
        // 黄昏结算：投毒者的毒到期（毒只算一个夜晚 + 一个白天）
        BOTC_DuskResolve();
        // 新的一夜：清空「今晚被唤醒过」的名单（侍女 24 要查这个）
        for (q = 0; q < 14; q += 1) {
            g_wokeTonight[q] = false;
        }
        // 【女巫（65）】（用户 2026-09-21）：只剩 3 名存活 → 她失去能力、诅咒立刻解除；
        //   官方移除时机「黄昏时」：每晚入夜把上一天那份「被诅咒」收掉（她可以每晚重新诅咒同一个人）
        BOTC_WitchSync();
        BOTC_WitchCurseClear("黄昏到了");
        // 【镜像双子（64）】（用户 2026-09-21）：第一夜（含还没正式开始的「准备阶段」）自动开面板让说书人配对；
        //   ⚠ 第一夜入夜时夜号还是 0，所以判断写 <= 1（之前写成 == 1 → 从来没触发过）
        if (g_nightNum <= 1 && BOTC_RoleInPlay(64)) {
            g_twinA = 0;
            for (q = 2; q <= 13; q += 1) {
                if (g_seatOn[q] && BOTC_HasAbility(q, 64)) {
                    g_twinA = q;
                }
            }
            if (g_twinA >= 2 && g_twinB < 2) {
                g_twinPick = true;
                BOTC_SkillOpen(1);
                libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
                BOTC_Notice(g_teller, "【镜像双子】第一夜：点一名对立阵营的玩家当对立双子。");
                BOTC_PmStore(g_teller, "【镜像双子】镜像双子是 " + BOTC_NameStr(g_twinA) + "：请你点一名对立阵营玩家当对立双子。");
            }
        }
        BOTC_AutoWakeReset();
        g_goonBy = 0;                 // 莽夫（37）：新的一夜，重新算「第一个选他的人」
        // 修补匠（35）/ 月之子（36）：真人说书时的提醒（智能说书自己会掷 / 自己会选）
        if (g_nightNum >= 2) {
            for (q = 2; q <= 13; q += 1) {
                if (BOTC_HasAbility(q, 35) && !BOTC_SeatDead(q)) {
                    BOTC_PmStore(g_teller, "【修补匠】" + BOTC_NameStr(q) + " 可能今晚死亡。");
                }
            }
        }
        // 造谣者（28）：只提醒真正拥有且能力生效的造谣者。
        //   假声称仍会公聊播报，但夜间提示不能覆盖或顶掉真造谣的声明。
        for (q = 2; q <= 13; q += 1) {
            if (!g_gossipDone[q] || StringLength(g_gossipTextBy[q]) <= 0) {
                continue;
            }
            if (!BOTC_AbilityWorks(q, 28)) {
                continue;
            }
            BOTC_PmStore(g_teller, "【造谣者】" + BOTC_NameStr(q) + " 今天的公开声明：「" + g_gossipTextBy[q] + "」。如果是真的，今晚一名玩家死亡，用【死亡标记】点他。");
            BOTC_Notice(g_teller, "造谣者今天声明过：如果是真的，今晚要有一名玩家死亡。");
        }
        // 镇长的特殊胜利：黄昏时只剩 3 人活着、且今天没处决过人 → 善良胜
        BOTC_CheckMayorWin();
    }
    BOTC_NightApply();
    BOTC_DeclareRender();
    BOTC_NomUI();                  // 【进入提名环节】按钮按昼夜显隐
    BOTC_WakeRender();             // 【唤醒】按钮只在夜里给说书人（白天藏起来）
}

// 游戏正式开始：进入第一夜，身份锁死（说书人之后只能改 token）
void BOTC_GameStart () {
    int i;
    int q;

    if (g_startPending) {
        BOTC_Notice(g_teller, "已经在倒数了：10 秒倒计时走完就会自动进入第 1 夜。");
        return;
    }
    // 步骤一：在场的每个座位都要有身份（说书人那份魔典上）；没人的空位不参与校验
    BOTC_GrimRelayout();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (g_mark[(g_teller * 14) + q] <= 0) {
            BOTC_Notice(g_teller, "还有座位没发牌，先【随机发牌】或手动指定身份再开始。");
            return;
        }
    }
    // 步骤二：必须由说书人点过【确认发放】---- 不然玩家自己那份魔典里不会有身份，
    //   却不能正式开始，这是之前漏掉的校验（原来这里会自动确认一次）。
    if (!g_dealConfirmed) {
        BOTC_Notice(g_teller, "还没【确认发放】：先点魔典下面的【确认发放】（让每位玩家在自己魔典里看到身份），再点【游戏正式开始】。");
        return;
    }

    // 校验通过 → 放 UI 音效 + 演 10 秒倒计时；**真正「进入第 1 夜」那一套等倒计时走完再做**
    //   （用户 2026-09-16 要求：倒计时 10 秒后再执行进入夜晚的指令）
    BOTC_PlaySfx(g_sfxStartName);
    g_startPending = true;
    g_swapUnlocked = false;        // 【点正式开始 → 重新锁上【换座位】】（用户 2026-10-07）
    BOTC_SwapCancelAll();          // 【撤回所有人在选的换座位】（用户 2026-10-11）
    BOTC_BsBtnRender();            // 顺手刷一次：这一下按钮就该从所有人屏幕上消失
    // 【点下去的那一瞬间】就把【随机发牌】/【确认发放】收掉（用户 2026-09-17 要求：别等倒数走完才消失）；
    //   同时把按钮改成【取消正式开始】，这样 10 秒倒数里还能再点一下把它撤掉
    BOTC_NomUI();
    libNtve_gf_SetDialogItemText(g_grimStart, StringToText("取消正式开始"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "游戏正式开始：10 秒倒计时结束后自动进入第 1 夜。");
    BOTC_StartCdBegin();
}

// 倒计时走完才真正执行：进入第 1 夜、锁身份、夜晚音乐 / 大字、各类按钮刷新
// ==================================================================================================
// 【何方教众（Whose Cult Is It Anyway）· 板子 9 的角色实现】（用户 2026-10-10）
//   新角色：103 传教士 / 104 国王 / 105 村夫 / 106 异教领袖 / 107 半兽人 / 108 唱诗男孩 /
//          109 解谜大师 / 110 狂热者 / 111 堤丰之首 / 112 小怪宝 / 113 暴风捕手（传奇）
//   判定口径（跟其它板子一致）：技能读**登记层**（BOTC_PairTeam / BOTC_SeatRegAlign）、
//   死亡一律走 BOTC_MarkDeathQuietSrc / BOTC_DemonStrike（自动过免死、红叉、播报）。
// ==================================================================================================

// 【传教士（103）】（用户 2026-10-10）：现在有没有一个「存活且清醒」的传教士
//   他死亡 / 离场 / 中毒酒鬼 → 被他标记的爪牙不再失去能力
bool BOTC_MissionaryActive () {
    int s;
    s = BOTC_AbilitySeat(103);
    if (s < 1 || s > 13) {
        return false;
    }
    if (BOTC_SeatDead(s)) {
        return false;
    }
    return true;
}

// 【唱诗男孩（108）】（用户 2026-10-10）：国王这一格有没有「夜间 · 恶魔杀」的死亡标记
//   ⚠ 判的是**死亡 token**（说书人在 token 面板手动打的那一格），不是公屏红叉：
//     红叉（BOTC_SeatDead 里的 g_deadShown）只表示「公布他死了」，不带死因。
bool BOTC_ChoirboyKingDead () {
    int ks;
    int k;
    ks = BOTC_AbilitySeat(104);
    if (ks < 1 || ks > 13) {
        return false;
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] != 1) { continue; }        // 只认夜间
        if (g_deathByDemon[k] != 1) { continue; }     // 只认恶魔杀
        if (g_tokOn[(((g_teller * 14) + ks) * 256) + g_deathTok[k]]) {
            return true;
        }
    }
    return false;
}
// 【狂热者（110）】（用户 2026-10-10）：存活 ≥ 5 人时必须投票（不能弃权）
bool BOTC_ZealotMustVote (int p) {
    int i;
    int n;
    if (!BOTC_AbilityWorks(p, 110)) {
        return false;
    }
    if (BOTC_SeatDead(p)) {
        return false;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        n = n + 1;
    }
    return (n >= 5);
}

// 【国王（104）】（用户 2026-10-10）：统计「在场的座位里死了几个 / 活着几个」
//   条件 = 死亡数 ≥ 存活数（跟剧本卡一致；官网是「大于或等于」）
bool BOTC_KingConditionOK () {
    int i;
    int dn;
    int an;
    dn = 0;
    an = 0;
    if (BOTC_LeviathanAlive() && BOTC_SomeoneDiedToday()) {
        return true;          // 相克：利维坦在场，只要今天至少死过一名玩家，国王今晚就能得到信息
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatDead(i)) { dn = dn + 1; }
        else { an = an + 1; }
    }
    return (dn >= an);
}

// 【国王 · 弹身份网格】：与送葬者 / 守鸦人一致，选择一个角色后只发送该角色。
void BOTC_KingOpen (int p) {
    if (p < 2 || p > 13) {
        return;
    }
    g_pickMode[g_teller] = 42;
    g_pickWho[g_teller] = p;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

// 【国王 · 把答案发出去】：格式与送葬者 / 守鸦人一致。
void BOTC_KingAnswer (int p, int role) {
    if (p < 2 || p > 13) {
        return;
    }
    if (role < 0 || role > 148) {
        return;
    }
    BOTC_PmInfo(g_who[p], "【信息】你得知" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【国王】已告诉 " + BOTC_NameStr(p) + "：你得知" + g_roleName[role] + "。");
}

// 【暴风捕手 · 发送特定信息】（用户 2026-10-11）：给某个玩家开身份网格 →
//   点一个角色 = 把「暴风捕手给邪恶发的那句同款」发给他：你得知 A 是 B
//   （A = 那个角色现在坐哪一格，B = 那个角色）。场上没人拿这个角色 → 那张格子直接不列出来。
void BOTC_SpecStormOpen (int q) {
    int i;
    int seat;
    if (q < 2 || q > 13) {
        return;
    }
    g_pickMode[g_teller] = 23;
    g_pickWho[g_teller] = q;
    BOTC_PickFilter(g_teller, false);
    for (i = 0; i < g_gridN; i += 1) {
        seat = BOTC_SeatOfRole(g_gridSlot[i]);
        if (seat >= 2 && seat <= 13) {
            continue;                     // 场上有人拿这个角色 → 留着
        }
        if (seat < 2 && BOTC_SeatTrueRole(1) == g_gridSlot[i]) {
            continue;                     // 说书人自己那一格（-t 试技能）
        }
        DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(g_teller), false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【暴风捕手】点一个角色 → 告诉他「你得知 A 是 这个角色」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

// 【暴风捕手 · 把这句话发出去】
void BOTC_SpecStormPick (int p, int role) {
    int seat;
    if (p < 2 || p > 13) {
        return;
    }
    if (role < 0 || role > 148) {
        return;
    }
    seat = BOTC_SeatOfRole(role);
    if (seat < 2 && BOTC_SeatTrueRole(1) == role) {
        seat = 1;
    }
    if (seat < 1 || seat > 13) {
        BOTC_Notice(g_teller, "【暴风捕手】场上现在没有「" + g_roleName[role] + "」这个人，没发。");
        return;
    }
    BOTC_PmInfo(g_who[p], "【信息】你得知" + BOTC_NameStr(seat) + " 是" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【暴风捕手】已告诉 " + BOTC_NameStr(p) + "：你得知 " + BOTC_NameStr(seat) + " 是" + g_roleName[role] + "。");
}
// 【国王 · 首夜那一步】（用户 2026-10-10）：把「谁是国王」告诉**恶魔**
//   恶魔 = **只发真恶魔**（阵营 3）。疯子那一边用户自己用【发送特定信息 → 国王】补
//   （用户 2026-10-10：疯子要跟别的「假恶魔信息」一起由说书人自己给，脚本别自动发）。
//   不唤醒国王本人：这一步由 BOTC_AutoWakeNext 在他的夜序位次上替他跑。
void BOTC_KingAnnounce () {
    int seat;
    int i;
    int n;
    seat = BOTC_SeatOfRole(104);
    if (seat < 2 || seat > 13) {
        return;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatTeam(i) != 3) { continue; }                              // 只发真恶魔（疯子那边手动）
        BOTC_PmInfo(g_who[i], "【信息】你得知" + BOTC_NameStr(seat) + "是国王。");
        n = n + 1;
    }
    BOTC_Notice(g_teller, "【国王】已告诉恶魔：国王是 " + BOTC_NameStr(seat) + "。");
}

// 【唱诗男孩（108）】（用户 2026-10-10）：恶魔夜里杀死了国王 → 让他进入「可以唤醒」状态（信息由说书人手动发）
void BOTC_ChoirboyCheck (int victim) {
    int cs;
    if (victim < 2 || victim > 13) { return; }
    if (!BOTC_AbilityWorks(victim, 104)) { return; }
    cs = BOTC_AbilitySeat(108);
    if (cs < 1 || cs > 13) { return; }
    if (BOTC_SeatDead(cs)) { return; }
    // 【不自动发信息】（用户 2026-10-10）：这里只提醒说书人 —— 能不能唤醒由 BOTC_ChoirboyKingDead 现查
    //   （国王的「死亡（恶魔）」token 在不在），不记状态，也不看红叉。
    BOTC_Notice(g_teller, "【唱诗男孩】国王被恶魔杀死 → 可以唤醒他了。");
}

// 【何方教众 · 首夜设置】（用户 2026-10-10）
//   村夫（105）复数 → 其中一个醉酒；暴风捕手（113）→ 让邪恶阵营知道异教领袖是谁。
//   ⚠ 都是「给一个合理默认 + 私聊告诉说书人」，说书人想换谁直接把 token 挪一下就行。
//   （半兽人失足 / 解谜大师醉酒 / 唱诗男孩→国王：已改到「随机发身份」那一刻，见 BOTC_Deal。）
void BOTC_HfSetupFirstNight () {
    int i;
    int n;
    int pick;
    // ① 村夫：两个以上村夫 → 其中一个醉酒（标记 126）
    n = 0;
    pick = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatTrueRole(i) != 105) { continue; }
        n = n + 1;
        if (pick == 0) { pick = i; }
    }
    if (n >= 2) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 126] = true;
        BOTC_PmStore(g_teller, "【村夫】醉酒标记：" + BOTC_NameStr(pick));
    }
    // ④ 国王（104）：**开局不告诉恶魔**（用户 2026-10-10）—— 这条要等到「国王那一格夜序位次」再发，
    //   这样疯子也能同步收到（他以为自己是恶魔；收不到就会看出来自己是假的）。见 BOTC_KingAnnounce。
    // ⑤ 小怪宝（112）/ 堤丰之首（111）：首夜的「设置」由说书人自己做，这里只提醒一句
    if (BOTC_RoleInPlay(112)) {
        BOTC_PmStore(g_teller, "【小怪宝】首夜：爪牙决定谁照看 → 给他打「是恶魔（小怪宝）」。");
    }
    // ⑥ 暴风捕手（113，传奇角色）（用户 2026-10-11 改）：
    //   · 保护的身份在场 → 他带「免死（暴风捕手）133」（只挡夜间死亡）；这里再同步一次 + 补播报；
    //   · 「你得知 A 是 B」不再在这里发 ---- 改成首夜唤醒时的一步（BOTC_StormEvilStep，排在邪恶互认之前）。
    if (BOTC_StormInGame()) {
        BOTC_StormSync();             // 正式开局这一下才播报（g_started 已经为真）
    }
}

// 【本局板子上有没有暴风捕手（113）】（用户 2026-10-11）：两条路都算 ----
//   ① 板子直接带他（g_boardRole）；② 他是这块板的「传奇角色」（板子清单写在 g_boardLegacy，
//      进游戏时由 BOTC_LegacyApply 写进 g_legacyOn[113]；「添加传奇角色」面板里也能手动开 / 关）。
//   有这个角色 = 暴风捕手在场（用户口径）。
bool BOTC_StormInGame () {
    return (g_legacyOn[113] || BOTC_BoardHasRole(113));
}

// 【暴风捕手（113）】（用户 2026-10-11）：保护哪个角色由板子定（何方教众默认「异教领袖」106，
//   自定义剧本 = 做板子时点的那一个）。这里一次把三件事做掉：
//   ① 找到「保护的身份」坐在哪一格；② 给他打上「免死（暴风捕手）133」（别处那枚一并撤掉）；
//   ③ **游戏正式开始之后**往公聊播报「暴风捕手保护X」（X = 保护的身份），一条只播一次 ----
//      ⚠ 播报跟「保护的身份在不在场」无关：只要板子上有暴风捕手就播（用户 2026-10-11 明确）。
//   ⚠ 这枚免死**只挡夜间死亡**（见 BOTC_DeathBlocker 里 kind == 1 那一条）：处决 / 白天死照旧。
//   ⚠ 发牌 / 确认发放都会调它（换座位是整体对调，token 跟着人走，不用再补）。
void BOTC_StormSync () {
    int q;
    int seat;
    if (g_stormRole < 0 || g_stormRole > 148) {
        g_stormRole = 106;
    }
    seat = 0;
    // 【本局有没有暴风捕手 = 板子上有没有这个角色】（用户 2026-10-11）：走 BOTC_StormInGame()
    //   （传奇角色不进 g_boardRole、也不发给座位，只记在 g_legacyOn[113] 里）。
    if (BOTC_StormInGame()) {
        seat = BOTC_SeatOfRole(g_stormRole);
        if (seat < 2 && BOTC_SeatTrueRole(1) == g_stormRole) {
            seat = 1;                     // 说书人自己那一格（-t 试技能）
        }
    }
    for (q = 1; q <= 13; q += 1) {
        if (q == seat) { continue; }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 133]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 133] = false;
        }
    }
    if (seat >= 1 && seat <= 13) {
        g_tokOn[(((g_teller * 14) + seat) * 256) + 133] = true;
        g_stormOn = true;
        g_stormSeat = seat;
    }
    else {
        g_stormOn = false;
        g_stormSeat = 0;
    }
    // 【播报时机】（用户 2026-10-11 明确）：**游戏正式开始之后**才播 ----
    //   之前是「发牌 / 确认发放」那几次就播了，用户点一次【随机发牌】就播一次，不对。
    if (BOTC_StormInGame() && g_started && !g_stormSaid) {
        g_stormSaid = true;
        BOTC_PubAnnounce("暴风捕手保护" + g_roleName[g_stormRole]);
        if (seat >= 1 && seat <= 13) {
            BOTC_PmStore(g_teller, "【暴风捕手】保护 " + g_roleName[g_stormRole] + "（" + BOTC_NameStr(seat) + "）：已打上「免死（暴风捕手）」，只挡夜间死亡。");
        }
    }
}

// 【暴风捕手 · 首夜那一步】（用户 2026-10-11）：在「邪恶互认」**之前**走一步 ----
//   给每个邪恶玩家（爪牙 + 恶魔，活着在场）发一句「你得知 A 是 B」：
//   A = 保护身份那个人的座位号，B = 保护的身份。本局没有那个角色（或没有暴风捕手）就不发。
//   返回 true = 这一下就是这个步骤（说书人再按一次【开始唤醒】才进邪恶互认）。
bool BOTC_StormEvilStep () {
    int i;
    int n;
    int seat;
    if (g_stormEvilSent) {
        return false;                     // 这一局已经发过了
    }
    if (!BOTC_StormInGame()) {
        return false;                     // 板子上没有暴风捕手：这一步不存在
    }
    g_stormEvilSent = true;
    seat = BOTC_SeatOfRole(g_stormRole);
    if (seat < 2 && BOTC_SeatTrueRole(1) == g_stormRole) {
        seat = 1;
    }
    if (seat < 1 || seat > 13) {
        return false;                     // 保护的身份不在场：什么都没有（2026-10-11 用户要求：别写提示）
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatTeam(i) != 2 && BOTC_SeatTeam(i) != 3) { continue; }
        BOTC_PmInfo(g_who[i], "【信息】你得知" + BOTC_NameStr(seat) + " 是" + g_roleName[g_stormRole] + "。");
        n = n + 1;
    }
    BOTC_Notice(g_teller, "【暴风捕手】已告诉 " + IntToString(n) + " 名邪恶：你得知 " + BOTC_NameStr(seat) + " 是" + g_roleName[g_stormRole] + "。");
    return true;
}

// 【何方教众 · 唤醒时的附加动作】（用户 2026-10-10）
//   国王（104）→ 弹答题框；小怪宝（112）→ 给说书人一句提醒（触发型能力，不用选目标）。
void BOTC_HfWakeAction (int q) {
    int r;
    int i;
    int n;
    int n2;
    // 按当前正在使用的身份判：普通唤醒看魔典，科学怪人额外唤醒则看借来的善良角色。
    r = BOTC_ActRoleOf(q);
    if (r < 0 || r > 148) { return; }
    // ① 国王（104）：条件满足时给他一个存活角色的名字（说书人填框、原样发给他）
    if (r == 104) {
        n = 0;
        n2 = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_SeatDead(i)) { n = n + 1; }
            else { n2 = n2 + 1; }
        }
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【国王】" + BOTC_NameStr(q) + " 中毒/酒鬼：随便给。");
        }
        else {
            if (BOTC_LeviathanAlive() && BOTC_SomeoneDiedToday()) {
                BOTC_PmStore(g_teller, "【国王×利维坦相克】利维坦在场，且今天至少有一名玩家死亡 → 条件满足。");
            }
            else {
                if (n >= n2) {
                    BOTC_PmStore(g_teller, "【国王】条件满足：死 " + IntToString(n) + " / 活 " + IntToString(n2) + "。");
                }
                else {
                    BOTC_PmStore(g_teller, "【国王】条件不满足：死 " + IntToString(n) + " / 活 " + IntToString(n2) + "。");
                }
            }
        }
        BOTC_KingOpen(q);      // 【用户 2026-10-10】答题框改成身份网格：点一个存活角色就告诉他
        return;
    }
    // ④ 小怪宝（112）：提醒说书人把通用「是恶魔」标记挪给「照看小怪宝」的那个人
    if (r == 112) {
        BOTC_PmStore(g_teller, "【小怪宝】爪牙决定谁照看 → 给他打「是恶魔（小怪宝）」。");
        return;
    }
}

// 【小怪宝（112）· 恶人频道】（用户 2026-10-11）：
//   小怪宝局的夜里，把「说书人 + 开局时的邪恶玩家」拉进**同一条私聊**，
//   让他们在群里商量谁照看小怪宝。用户口径：「就是私聊那里，把这几个人自动拉进群聊，包括说书人」
//   ---- 所以不另做界面，直接用现成的会话系统（BOTC_CreateSess / BOTC_JoinSess）。
//   拉起时机：① 游戏正式开始（= 第 1 夜）② 之后每一夜入夜 ③ 说书人夜里打上「是恶魔（小怪宝）134」那一刻。
//   成员：游戏正式开始时就属于邪恶阵营的玩家；提线木偶仍排除。
//         后续转成邪恶的善良玩家、以及后来才拿到小怪宝标记的人都不自动补进频道。
//   ⚠ 名单里存的是**客户端号**（会话那套一律按客户端走）。
//   ⚠ 说书人就在会话里 → 夜里「公聊时段不许私聊」那条**现成的破例**就够用（跟他同一条私聊的人照样能说话）；
//     会话列表那边也用现成的规则（夜里含说书人的私聊对别人隐藏），另外还加了一条：非成员看不到这条。
void BOTC_LmCollect () {
    int q;
    g_lmMemN = 0;
    // 【说书人也在群里】（用户 2026-10-11 更正）：他要跟爪牙一起待在这条私聊里
    g_lmMem[0] = g_teller;
    g_lmMemN = 1;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) { continue; }
        if (!g_startEvil[q]) { continue; }                               // 只收开局时的邪恶玩家
        if (BOTC_IsMarionette(q)) { continue; }                          // 提线木偶不算（跟互认同一口径）
        if (g_who[q] < 1) { continue; }
        g_lmMem[g_lmMemN] = g_who[q];
        g_lmMemN = g_lmMemN + 1;
    }
}

bool BOTC_LmHasMem (int who) {
    int i;
    for (i = 0; i < g_lmMemN; i += 1) {
        if (g_lmMem[i] == who) {
            return true;
        }
    }
    return false;
}

// 【现在场上有没有恶魔】：真身是恶魔（team 3）/ 或者带着「是恶魔（小怪宝）」的那个人
bool BOTC_LmHasDemon () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) { continue; }
        if (BOTC_IsDemonSeat(q)) {
            return true;
        }
    }
    return false;
}

// 【小怪宝开局检测】（用户 2026-10-22）：
//   正式开始后按**真实身份**扫描。场上没有任何恶魔、但至少有一名爪牙 → 默认这是小怪宝局。
//   不能看玩家眼前的认知身份（酒鬼 / 疯子 / 提线木偶），所以必须统一走 BOTC_SeatTrueRole。
//   检测只负责设局，不会在这里拉私聊；第 1 夜由说书人按正常流程指定照看者。
void BOTC_LmDetectNoDemon () {
    int q;
    int r;
    int demonN;
    int minionN;
    demonN = 0;
    minionN = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 3) {
            demonN = demonN + 1;
        }
        else {
            if (BOTC_RoleTeam(r) == 2) {
                minionN = minionN + 1;
            }
        }
    }
    g_lmOn = false;
    if (demonN == 0 && minionN > 0) {
        g_lmOn = true;
        BOTC_PmStore(g_teller, "【小怪宝】开局检测：场上没有恶魔、共有 " + IntToString(minionN) + " 名爪牙 → 本局按小怪宝局处理。第 1 夜不会自动打开恶人频道。");
    }
}

// 【开 / 刷新恶人频道】：把说书人和开局时的邪恶玩家拉进同一条会话
void BOTC_LmGroupChat () {
    int s;
    int i;
    int mag;
    if (!g_lmOn) {
        return;                          // 不是小怪宝局：这条频道根本不开
    }
    // 相克：魔术师在场时，不让爪牙自行拉群商量，改由说书人决定照看者。
    mag = BOTC_MagicianSeatNow();
    if (mag >= 2) {
        BOTC_PmStore(g_teller, "【小怪宝×魔术师相克】魔术师 " + BOTC_NameStr(mag) + " 在场 → 跳过小怪宝私聊频道，请由你直接指定照看者。");
        return;
    }
    BOTC_LmCollect();
    if (g_lmMemN < 2) {
        if (g_lmMemN == 1) {
            BOTC_PmStore(g_teller, "【小怪宝】恶人频道：场上没有其他初始邪恶玩家（只有说书人），不用开群聊。");
        }
        return;
    }
    BOTC_SessRepair();
    s = 0;
    if (g_lmSess >= 1 && g_lmSess <= 13 && g_sessAlive[g_lmSess]) {
        s = g_lmSess;
    }
    if (s == 0) {
        BOTC_CreateSess(g_lmMem[0], g_lmMem[1]);
        s = g_mySess[g_lmMem[0]];
        if (s < 1 || s > 13 || !g_sessAlive[s]) {
            BOTC_PmStore(g_teller, "【小怪宝】恶人频道开不出来（私聊条数已达上限）。");
            return;
        }
        g_lmSess = s;
    }
    for (i = 0; i < g_lmMemN; i += 1) {
        if (g_mySess[g_lmMem[i]] == s) { continue; }
        BOTC_JoinSess(g_lmMem[i], s);
    }
    // 群里留一句「这是今晚的频道」（发给除当前说书人外的所有成员；玩家号 1 可能已经是普通玩家）
    for (i = 1; i <= 13; i += 1) {
        if (i == g_teller) { continue; }
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, "【小怪宝】这是你们今晚的频道：商量好由谁照看小怪宝，再告诉说书人。");
        }
    }
    BOTC_RefreshSessListAll();
}

//--------------------------------------------------------------------------------------------------
// 【帽匠（120）· 恶人频道】（用户 2026-10-16）：他**死了之后**，当晚轮到他行动时，把
//   「说书人 + 恶魔 + 爪牙」拉进同一条私聊 ---- 跟小怪宝那条一样（复用同一套会话变量 g_lmSess），
//   提线木偶不进来。
//   茶会换角色本身由说书人在魔典上自己改，脚本只负责把人拉进群。
//--------------------------------------------------------------------------------------------------
void BOTC_HatCollect () {
    int q;
    g_lmMemN = 0;
    g_lmMem[0] = g_teller;
    g_lmMemN = 1;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) { continue; }
        if (g_who[q] < 1) { continue; }
        if (BOTC_IsMarionette(q)) { continue; }
        if (BOTC_IsDemonSeat(q)) {
            g_lmMem[g_lmMemN] = g_who[q];
            g_lmMemN = g_lmMemN + 1;
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) { continue; }
        g_lmMem[g_lmMemN] = g_who[q];
        g_lmMemN = g_lmMemN + 1;
    }
}

void BOTC_HatGroupChat () {
    int s;
    int i;
    bool fresh;
    BOTC_HatCollect();
    if (g_lmMemN < 2) {
        BOTC_PmStore(g_teller, "【帽匠】场上没有恶魔 / 爪牙，不用开群聊。");
        return;
    }
    BOTC_SessRepair();
    s = 0;
    fresh = false;
    if (g_lmSess >= 1 && g_lmSess <= 13 && g_sessAlive[g_lmSess]) {
        s = g_lmSess;
    }
    if (s == 0) {
        BOTC_CreateSess(g_lmMem[0], g_lmMem[1]);
        s = g_mySess[g_lmMem[0]];
        if (s < 1 || s > 13 || !g_sessAlive[s]) {
            BOTC_PmStore(g_teller, "【帽匠】群聊开不出来（私聊条数已达上限）。");
            return;
        }
        g_lmSess = s;
        fresh = true;
    }
    for (i = 0; i < g_lmMemN; i += 1) {
        if (g_mySess[g_lmMem[i]] == s) { continue; }
        BOTC_JoinSess(g_lmMem[i], s);
    }
    if (fresh) {
        for (i = 1; i <= 13; i += 1) {
            if (i == g_teller) { continue; }
            if (g_member[(s * 14) + i]) {
                BOTC_AppendPm(i, "【帽匠】这是你们今晚的频道：商量好各自要换成什么角色，再告诉说书人。");
            }
        }
    }
    BOTC_RefreshSessListAll();
    BOTC_PmStore(g_teller, "【帽匠】已把恶魔和爪牙拉进同一条私聊（提线木偶不进）。");
}

void BOTC_HatDayPrompt () {
    int i;
    int pos;
    BOTC_HatCollect();
    if (g_lmMemN <= 1) {
        BOTC_Notice(g_teller, "【帽匠】场上没有需要询问的邪恶玩家。");
        return;
    }
    BOTC_Notice(g_teller, "【帽匠】请分别私聊邪恶玩家，询问是否改变身份。");
    for (i = 1; i < g_lmMemN; i += 1) {
        pos = BOTC_PosOf(g_lmMem[i]);
        BOTC_PmStore(g_teller, "【帽匠】请私聊 " + BOTC_NameStr(pos) + "：是否改变身份。");
    }
}

void BOTC_HatDeath (int q) {
    if (q < 2 || q > 13 || !g_started || g_hatDone[q]) {
        return;
    }
    if (!BOTC_HasAbility(q, 120)) {
        return;
    }
    if (g_isNight) {
        if (g_wakeCurrentOrd > 0) {
            BOTC_QueueWakeInsert(q, g_wakeCurrentOrd, BOTC_NightOrderOf(q));
        }
        else {
            g_insertWake[q] = true;
            g_autoWoke[q] = false;
        }
        BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 夜间死亡 → 当前玩家行动结束后立即开茶会。");
    }
    else {
        BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 白天死亡 → 到帽匠夜序时提示你逐个私聊邪恶玩家。");
    }
}

// 【唱诗男孩的触发】（用户 2026-10-10）：恶魔夜里杀死国王时，从 BOTC_MarkDeathRowTok 里调
void BOTC_ChoirboyHook (int victim, int row) {
    if (row < 0 || row >= g_deathN) { return; }
    if (g_deathKind[row] != 1) { return; }
    if (g_deathByDemon[row] != 1) { return; }
    BOTC_ChoirboyCheck(victim);
}
void BOTC_GameStartGo () {
    bool first;
    int i;
    g_startPending = false;
    first = false;
    if (g_nightNum <= 0 && g_dayNum <= 0) {
        first = true;
        for (i = 2; i <= 13; i += 1) {
            g_startEvil[i] = g_seatOn[i] && BOTC_SeatAlign(i) == 1;
        }
        g_nightNum = 1;
        BOTC_WudSetupCheck();       // 【悟道者（118）】（用户 2026-10-16）：首夜让说书人点他「以为」的那张外来者卡
        g_dayNum = 0;
    }
    g_started = true;
    g_isNight = true;
    BOTC_LeviathanSpecialSync();
    BOTC_AutoWakeReset();
    // 正式开始：先放弃「准备阶段那首」的最高优先级，夜晚那首才播得进来
    BOTC_MusicDropPrio(2);
    BOTC_MusicPlay(g_musicNightName, 3, 4.0);   // 正式开始 = 第 1 夜：换成夜晚那首（昼夜切换，留 4 秒）
    BOTC_NightBanner();                          // 一声 ping + 大字「夜晚 1」
    libNtve_gf_SetDialogItemText(g_nightBtn, StringToText("进入白天"), PlayerGroupSingle(g_teller));
    BOTC_NightApply();
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21 报「诺的毒没有实现」的根因）：
    //   游戏正式开始 = 第 1 夜，走的是这条路，**不经过 BOTC_DuskResolve** ----
    //   所以常驻效果必须在这里自己算一次。百科：诺-达鲺的两份毒就是「为首个夜晚做准备时」放的。
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    libNtve_gf_SetDialogItemText(g_grimStart, StringToText("取消正式开始"), PlayerGroupSingle(g_teller));
    if (first) {
        BOTC_PeriodRecord("---- 第1夜（游戏正式开始）----");
    }
    else {
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "（游戏正式开始重新锁定身份）----");
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("游戏正式开始"));
    // 【伪装身份按钮已删除】（用户 2026-10-06 要求「直接删了吧」）：不再显示那颗按钮。
    //   （原来这里调 BOTC_ClaimBtnRender()；相关面板/逻辑保留在脚本里没删，只是不出现入口，
    //     以免误删影响其它引用。）
    // 智能说书：干扰项就此锁定，本局不再变动
    BOTC_WakeRender();
    BOTC_SkillBtnRender();
    BOTC_DeclareRender();
    // 首夜暴露信息不再在开局抢跑：落难少女 / 疯子的爪牙信息都交给
    // BOTC_AutoWakeEvilStep()，严格按官网当前夜序，在对应位次逐次发出。
    BOTC_DamselPoisonSync();       // 只先结算落难少女相克中毒，不提前告诉爪牙
    BOTC_HfSetupFirstNight();      // 【何方教众（板子 9）】：村夫醉酒 / 暴风捕手
    // 【小怪宝】（用户 2026-10-22）：正式开始只做「无恶魔、有爪牙」检测；
    //   第 1 夜不自动拉私聊，恶人频道从第 2 夜起由入夜流程打开。
    BOTC_LmDetectNoDemon();
    // 智能说书：占卜师要是开局就中毒 / 是酒鬼，先把「假干扰项」打上（日志里有【诊断占卜师】那行）
    BOTC_FtFakeSync();
    BOTC_BootleggerAnnounce();     // 【私货商人】自定义规则：正式开局公屏播报
    BOTC_LegacyAnnounce();         // 【传奇角色】正式开局把这一局板上带的传奇角色播一句
    BOTC_NomUI();
}

// 取消正式开始：解开身份编辑 + **昼夜编号归零** + **清空所有日志**（重新开始就等于新的一局）
// 清空所有日志（说书人点【取消正式开始】时用）
//   公屏记录 / 每个人的私聊记录 / 聊天窗 / 投票统计 ---- 全清，然后把界面刷一遍
void BOTC_ClearAllLogs () {
    int p;
    int i;
    for (i = 0; i < 2400; i += 1) {
        g_pubLog[i] = "";
        g_pubWho[i] = 0;
    }
    // 私聊记录每人 600 条（14 人 = 8400）；聊天窗那两份还是每人 300 个坑（4200）
    for (i = 0; i < 8400; i += 1) {
        g_pmLog[i] = "";
        g_pmWho[i] = 0;
        g_pmWith[i] = 0;
    }
    for (i = 0; i < 4200; i += 1) {
        g_chatLines[i] = "";
        g_chatWho[i] = 0;
    }
    for (i = 0; i < 600; i += 1) {
        g_voteLog[i] = "";
    }
    g_pubLogCount = 0;
    g_voteLogCount = 0;
    for (p = 1; p <= 13; p += 1) {
        g_pmLogCount[p] = 0;
        g_chatCount[p] = 0;
        BOTC_LogRender(p);
        BOTC_ChatRender(p);
        BOTC_PmBoxRender(p);
    }
}

//==================================================================================================
// 【换局重置】开新的一局之前，把「只属于上一局」的记录清干净（用户 2026-09-20）
//   ⚠ 这些变量以前只在 BOTC_GrimInitData()（= 地图初始化那一次）里清，
//     所以上一局的主谋加时 / 和平主义者概率 / 僵怖假死 / 普卡的毒 ... 会原样带到下一局。
//     最典型的症状：这一局场上根本没有主谋，却在第一天处决一个人之后跳出
//     「主谋加时：X（善良）被处决」→ 邪恶胜（就是上一局主谋留下的 g_mmExtra / g_mmArmed）。
//   调用点：随机发牌 BOTC_Deal / 手动配板 BOTC_RsApply / 取消正式开始 BOTC_GameStartCancel
//==================================================================================================
void BOTC_ResetGameVars () {
