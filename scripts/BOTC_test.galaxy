    g_tipLine[728] = StringToText("姑获鸟");
    g_tipLine[729] = StringToText("：如果姑获鸟死亡，获得") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("能力的姑获鸟保留") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipRoleAt[42] = 701;    // 主谋
    g_tipRoleN[42] = 29;
    g_tipLine[730] = StringToText("【角色能力】");
    g_tipLine[731] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。");
    g_tipLine[732] = StringToText("当你首次死亡后，你仍存活，但会被当作死亡。");
    g_tipLine[733] = StringToText("【角色简介】");
    g_tipLine[734] = TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("能秘密地在墓地中保持存活。");
    g_tipLine[735] = StringToText("当") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("因任何原因死亡后，他会保持存活状态，但说书人会表现得如同") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("死亡了一样");
    g_tipLine[736] = StringToText("。") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("第二次死亡时，才会真正地死亡，且") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipLine[737] = StringToText("看似死亡的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("在绝大多数情况下都算作已死亡。该玩家在城镇广场的生命标记会翻面");
    g_tipLine[738] = StringToText("以标识死亡。下一次该玩家投票时，会失去投票标记。该玩家不能发起提名，该玩家可");
    g_tipLine[739] = StringToText("以在有巫毒师的情况下投票，该玩家不算作") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的存活邻近玩家，等等。不同之处是");
    g_tipLine[740] = StringToText("游戏还会继续，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("仍然能发起攻击，且游戏会在只剩两名其他存活玩家的情况下继续");
    g_tipLine[741] = StringToText("进行。");
    g_tipLine[742] = StringToText("如果无人在白天死亡，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("才会在夜晚被唤醒并发起攻击。如果一名已死亡的玩家被处");
    g_tipLine[743] = StringToText("决，该玩家无法再次死亡，因此") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("仍然会被唤醒。");
    g_tipLine[744] = StringToText("如果一个") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("死亡，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。如果一个「死亡」的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128));
    g_tipLine[745] = StringToText("，不要宣布该玩家存活。");
    g_tipLine[746] = StringToText("【规则细节】");
    g_tipLine[747] = StringToText("相克规则：");
    g_tipLine[748] = StringToText("召唤师");
    g_tipLine[749] = StringToText("：如果召唤师将一名已死亡的玩家变成了") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("，该玩家会变成「已经死过一次」的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0));
    g_tipLine[750] = StringToText("。");
    g_tipLine[751] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[752] = StringToText("戏子");
    g_tipLine[753] = StringToText("：在戏子存在于剧本中时，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要死亡」");
    g_tipLine[754] = StringToText("。无论") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("是否触发过「假死」，当晚") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("会变为死亡状态。");
    g_tipLine[755] = StringToText("戏子（改）");
    g_tipLine[756] = StringToText("：在戏子（改）存在于剧本中时，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要");
    g_tipLine[757] = StringToText("死亡」。无论") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("是否触发过「假死」，当晚") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("会变为死亡状态。");
