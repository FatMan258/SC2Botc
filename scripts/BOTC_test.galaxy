            return;
        }
        if (!g_seatOn[t] || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 不是存活玩家，无事发生。");
            return;
        }
        // 【说书人拍板】（用户 2026-10-10）：半兽人的「善良即死」要判**登记层**，陌客 / 间谍这种会干扰登记，
        //   所以这里不自动结算 ---- 弹一个框问说书人：是 = 他死、今晚恶魔不造成死亡；否 = 恶魔正常出刀。
        g_lycanTgt = t;
        if (BOTC_SeatRegAlign(t) == 1) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 登记成邪恶（按规则不生效），你也可以自己裁定。");
        }
        BOTC_ManInfoOpen(p, 805, "");
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉（跟村夫同一个做法）
        return;
    }
    // ■ 解谜大师（109）：每局限一次，猜「谁是那个醉酒的人」→ 猜对给真恶魔，猜错弹框让说书人给假信息
    if (r == 109) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 中毒/酒鬼：这次不生效。");
            return;
        }
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 130]) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 这一局已经猜过了。");
            return;
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 130] = true;      // 「已猜测」：放他自己身上
        n = 0;                                                   // 那个醉酒的人在哪一格
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 129]) {
                n = i;
            }
        }
        BOTC_GrimRender(g_teller);
        if (n == t) {
            n2 = 0;                                              // 找一个活着的恶魔
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
                if (BOTC_SeatTeam(i) == 3) { n2 = i; }
            }
            if (n2 >= 2) {
                BOTC_PmInfo(g_who[p], "【信息】你得知" + BOTC_NameStr(n2) + "是恶魔。");
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜中：已告诉他 " + BOTC_NameStr(n2) + " 是恶魔。");
            }
            else {
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜对，但没有活着的恶魔。");
            }
        }
        else {
            BOTC_ManInfoOpen(p, 109, "他猜的是 " + BOTC_NameStr(t) + "（猜错了）→ 填一条**错误**的「谁是恶魔」给他");
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉
        }
        return;
    }
    // ■ 堤丰之首（111）/ 小怪宝（112）：恶魔刀（走通用的恶魔那一套：保护 / 士兵 / 免死都算）
    if (r == 111 || r == 112) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
