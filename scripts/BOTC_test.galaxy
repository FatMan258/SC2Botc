        if (g_wokeTonight[g_skillT2[p]]) {
            n = n + 1;
        }
        BOTC_PmStore(g_teller, "【侍女】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + " 和 " + BOTC_NameStr(g_skillT2[p]) + " → 正确答案：" + IntToString(n) + " 人。");
        BOTC_ManInfoOpen(p, 24, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
    // ■ 梦殒春宵（板子 3）：选完人之后要用答题框给信息的角色（用户 2026-09-21）
//   筑梦师（48）→ 自动配一对角色；女裁缝（55）→ 问「是不是同一阵营」
if (r == 48) {
    BOTC_ManInfoDreamer(p, g_skillT1[p]);
}
if (r == 116) {
    BOTC_PmStore(g_teller, "【郎中】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + "：给他一个跟那个角色能力相关的词语（2~4 个字）。");
    BOTC_ManInfoOpen(p, 806, BOTC_NameStr(g_skillT1[p]));
}
if (r == 55) {
    if (BOTC_ProtectTokOn(p, 68)) {
        BOTC_PmStore(g_teller, "【女裁缝】" + BOTC_NameStr(p) + " 这一局已经用过了。");
    }
    else {
        g_tokOn[(((g_teller * 14) + p) * 256) + 68] = true;      // 失去能力（女裁缝）：用过就记上
        BOTC_GrimRender(g_teller);
        BOTC_ManInfoOpen(p, 55, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
}
// ■ 舞蛇人（49）：选到真恶魔 → 两人交换角色与阵营，原恶魔永久中毒（用户 2026-09-21）
if (r == 49) {
    t = g_skillT1[p];
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次能力失效，没有交换。");
    }
    else {
        if (t < 2 || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选的目标无效（死了或没座位）。");
        }
        else {
            rt = BOTC_SeatTrueRole(t);
            // 【带小怪宝的人：交换的是他**那只爪牙**的身份，不是小怪宝本身】（用户 2026-10-14 两次更正）----
            //   · 小怪宝不是「会被发到座位上的角色」（除非疯子以为自己是它），所以绝不能把 112 写进座位；
            //   · 带着「是恶魔（小怪宝）134」的那一格，真身被 SeatTrueRole 读成 112，可交换要换的是他**原本那只爪牙**
            //     （魔典上写的那只）→ 这里改读 g_mark；
            //   · 换完之后由新恶魔（原舞蛇人）接手照看小怪宝：134 挪过去、g_lmSeat 也跟着改。
            nr = rt;
            snakeOk = true;
            snakeLm = false;
            if (g_lmOn && g_tokOn[(((g_teller * 14) + t) * 256) + 134]) {
                nr = g_mark[(g_teller * 14) + t] - 1;
                snakeLm = true;
                if (nr < 0 || nr > 148 || nr == 112) {
                    snakeOk = false;
                    BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "（他在照看小怪宝）：魔典上读不出他本来的爪牙身份 → 这一次没有交换。");
                }
            }
            // 【带宝的那位就是「恶魔」，不用再看他的角色队】（用户 2026-10-14 报「不是恶魔，无事发生」）----
            //   他的真身份是本来的**爪牙**（team 2），恶魔身份是靠 134 来的；所以这里必须跳过队判。
            if (snakeOk && !snakeLm && (nr < 0 || nr > 148 || BOTC_RoleTeam(nr) != 3)) {
                snakeOk = false;
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "：不是恶魔，无事发生。");
            }
            if (snakeOk) {
                // 【认知覆盖整包】（用户 2026-10-19）：两人「以为的身份 / 那枚 token」先记下来
                cogP = BOTC_CogTokOf(BOTC_SeatTrueRole(p));
                cogT = BOTC_CogTokOf(rt);
                cardP = g_mark[(g_teller * 14) + p] - 1;
                cardT = g_mark[(g_teller * 14) + t] - 1;
                // 【换给恶魔的角色 = 选人这位的真身】（用户 2026-10-12 修）：
                //   原来这里写死 49（舞蛇人）---- 可是这个能力可能是**哲学家(56) 借来的**
                //   （g_mark 显示成舞蛇人、真身仍是哲学家，BOTC_SeatTrueRole 会按"是哲学家"token 回 56），
                //   那种情况下原恶魔该变成**中毒的哲学家**，不该变成舞蛇人。
                nrP = BOTC_SeatTrueRole(p);
                if (nrP == 112) {
                    nrP = g_mark[(g_teller * 14) + p] - 1;     // 【舞蛇人自己带着小怪宝】（用户 2026-10-14）：同样忽略 134 那层
                }
                if (nrP < 0 || nrP > 148 || nrP == rt) {
                    nrP = 49;             // 兜底：真身读不出来（或跟恶魔同一个角色）时，退回原来的舞蛇人
                }
                // 【阵营检测】（用户 2026-10-02）：舞蛇人换恶魔 = 两人**交换阵营**。
                //   先记下交换前各自的阵营，换完按「对方原来的阵营」钉回来；
                //   两人阵营一样时（比如邪恶的舞蛇人换邪恶的恶魔）等于没换，谁都不动。
                alP = BOTC_SeatAlign(p);
                alT = BOTC_SeatAlign(t);
                BOTC_SetSeatRole(g_teller, p, nr);
                BOTC_SetSeatRole(g_who[p], p, nr);
                BOTC_SetSeatRole(g_teller, t, nrP);
                BOTC_SetSeatRole(g_who[t], t, nrP);
                // 【认知覆盖整包跟着换】（用户 2026-10-19）
                if (cogT >= 0) {
                    BOTC_PutCogCover(p, cardT, cogT);
                }
                if (cogP >= 0) {
                    BOTC_PutCogCover(t, cardP, cogP);
                }
                // 先把两人身上旧的「善良(14) / 邪恶(15)」标记撤掉，再按交换后的结果重新钉
                g_tokOn[(((g_teller * 14) + p) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + p) * 256) + 15] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 15] = false;
                // 新恶魔（原舞蛇人）拿原恶魔的阵营；新舞蛇人（原恶魔）拿原舞蛇人的阵营。
                //   只有「新身份自带的阵营」跟要钉的不一样时才打 token（一样就不用打）
                if (BOTC_RoleAlign(nr) != alT) {
                    g_tokOn[(((g_teller * 14) + p) * 256) + (14 + alT)] = true;
                }
                if (BOTC_RoleAlign(nrP) != alP) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + (14 + alP)] = true;
                }
                BOTC_PairClearSeat(p);         // 阵营刚变 → 登记层缓存作废
                BOTC_PairClearSeat(t);
                g_tokOn[(((g_teller * 14) + t) * 256) + 85] = true;
                g_tokOn[(((g_teller * 14) + p) * 256) + 13] = true;
                // 【小怪宝跟着「现在的恶魔」走】（用户 2026-10-14）：换的是身份，照看权也跟着换 ----
                //   134 挪到新恶魔（原舞蛇人）身上、g_lmSeat 指向他；不然那一格还带着 134，会被继续当成恶魔（阵营 / 胜负都会错）。
                if (snakeLm) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + 134] = false;
                    g_tokOn[(((g_teller * 14) + p) * 256) + 134] = true;
                    g_lmSeat = p;
                }
                g_autoWoke[p] = false;         // 新恶魔：当晚还要按恶魔那一格被唤醒
                g_testWoke[p] = false;
                g_autoWoke[t] = true;          // 原恶魔（现在换到的那个角色）：当晚到此为止，不再行动
                g_testWoke[t] = true;
                BOTC_GrimRender(g_teller);
                BOTC_GrimRender(g_who[p]);
                BOTC_GrimRender(g_who[t]);
                // 【统一身份转变提示】（用户 2026-10-01）：两人都走同一个函数（顺带写说书人日志）
                //   【认知覆盖】（用户 2026-10-19）：对方只说「他以为的身份」，不说酒鬼 / 提线木偶本体
                if (cogT >= 0) {
                    BOTC_ChangeRoleMsg(p, cardT);
                }
                else {
                    BOTC_ChangeRoleMsg(p, nr);
                }
                if (cogP >= 0) {
                    BOTC_ChangeRoleMsg(t, cardP);
                }
                else {
                    BOTC_ChangeRoleMsg(t, nrP);
                }
                if (cogP >= 0) {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[cardP] + "（永久中毒）。");
                }
                else {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[nrP] + "（永久中毒）。");
                }
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 和 " + BOTC_NameStr(t) + " 交换了角色与阵营：" + BOTC_NameStr(p) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(p)) + g_roleName[nr] + "，" + BOTC_NameStr(t) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(t)) + g_roleName[nrP] + "并永久中毒。");
            }
        }
    }
}
// ■ 驱魔人（25）：点名一名玩家。点中恶魔 → 恶魔当晚不会因其自身能力被唤醒，并得知点名他的是驱魔人。
    //   判定**只认真身**（用户 2026-09-20）；点名不能与上一夜重复。
    if (r == 25) {
        t = g_skillT1[p];
        g_exoLast = t;
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】驱魔人（" + BOTC_NameStr(p) + "）中毒/酒鬼，这一次点名无效。");
        }
        else {
            // 相克记录：驱魔人昨晚实际选择的玩家，不论他是不是恶魔。
            g_exoJinxSeat = t;
            g_exoJinxNight = g_nightNum;
            if (BOTC_RegIsDemon(t)) {                 // 按「互动干扰」后的登记算（用户 2026-09-20）
                for (i = 2; i <= 13; i += 1) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 31] = false;     // 旧的「被点名」先全清掉
                }
                g_tokOn[(((g_teller * 14) + t) * 256) + 31] = true;
                g_exoBlock = t;
                g_exoNight = g_nightNum;
                g_exoFrom = p;
                BOTC_GrimRender(g_teller);
                BOTC_PmInfo(g_who[t], "【信息】你被驱魔人选中了。");
            }
            else {
                BOTC_PmStore(g_teller, "【驱魔人】" + BOTC_NameStr(p) + " 点名了 " + BOTC_NameStr(t) + "（" + BOTC_RoleNameSafe(BOTC_RegRoleOf(t)) + "）---- 不是恶魔，没有效果。");
            }
        }
    }
    // ■ 旅店老板（26）：两名目标今晚不会死亡；其中一人醉酒到下一个黄昏。
    //   谁醉由说书人点（【二选一醉酒】面板，用户 2026-10-16）；原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
    if (r == 26) {
        if (BOTC_SkillWorks(p)) {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 25] = true;
            g_tokOn[(((g_teller * 14) + g_skillT2[p]) * 256) + 25] = true;
            g_innA = g_skillT1[p];
            g_innB = g_skillT2[p];
            g_innNight = g_nightNum;
            g_drunkFrom = p;
            BOTC_GrimRender(g_teller);
        }
        BOTC_DrunkPickOpen(1, p, g_skillT1[p], g_skillT2[p]);
    }
    // ■ 混沌（121）（用户 2026-10-16）：跟其它恶魔一样刀人；杀了「离他最近的两名镇民之一」→ 除旅行者外的全体善良中毒到下个黄昏。
    if (r == 121) {
        BOTC_DemonStrike(p, 121, g_skillT1[p], false);
        BOTC_HunDunCheck(p, g_skillT1[p]);
    }
    // ■ 逆臣（119）（用户 2026-10-16）：首夜选一名其他玩家 → 打「不共戴天」；谁先死于处决，另一方当晚转邪恶。
    if (r == 119) {
        t = g_skillT1[p];
        if (t >= 2 && t <= 13) {
            g_tcSeat = p;
            g_tokOn[(((g_teller * 14) + t) * 256) + 139] = true;
            BOTC_GrimRender(g_teller);
        }
    }
    // 玩家 + 角色组合技能：角色已经在同一面板中预选，确认后才结算。
    if (BOTC_ComboRole(r)) {
        BOTC_ComboResolve(p);
        return;
    }
    // ■ 教授（30）：复活一名已死亡的镇民（走现成的「复活」通道，复活后恢复一次性能力）。
    if (r == 30) {
        BOTC_ProfessorResolve(p, g_skillT1[p]);
    }
    // ■ 教父（39）：今天有外来者死亡时，当晚可以杀一个人（死因打「死亡（教父）」，不算恶魔杀）
    if (r == 39) {
        t = g_skillT1[p];
        // 【教父也吃这一条】（用户 2026-10-13）：中毒 / 酒鬼 / 提线木偶 → 这一刀不生效
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效，没有记死亡。");
        }
        else {
            if (BOTC_GodfatherCanKill()) {
                BOTC_PmStore(g_teller, "【教父】今天有外来者死亡 → " + BOTC_NameStr(p) + " 可以动手。");
            }
            else {
                BOTC_PmStore(g_teller, "【提示】今天没有外来者死亡，按规则教父今晚不能杀人 ---- 你仍可以照记。");
            }
            BOTC_MarkDeathQuietSrc(t, 1, 0, 39);
        }
    }
    // ■ 魔鬼代言人（40）：选一名活人（不能连续两夜点同一个）→ 打「处决不死（魔鬼代言人）」token(27)，
    //   他明天被处决不会死（处决那边只提示、不硬拦 ---- 说书人是最终裁定者）。本人不被告知。
    if (r == 40) {
        t = g_skillT1[p];
        if (t == g_devAdvLast) {
            BOTC_Notice(g_who[p], "魔鬼代言人不能连续两夜点同一个人，换一个吧。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】魔鬼代言人（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次没有打「处决不死」标记。");
        }
        else {
            for (i = 2; i <= 13; i += 1) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 27] = false;      // 只保一个人：旧的先全清
            }
            g_tokOn[(((g_teller * 14) + t) * 256) + 27] = true;
            BOTC_GrimRender(g_teller);
        }
        g_devAdvLast = t;
    }
    // ■ 刺客（41）：每局限一次，选一名活人 → **直接死，无视一切保护**（用户 2026-09-20 定）。
    //   死因「死亡（刺客）」且**不算恶魔杀**（不触发祖母联动、不触发小恶魔传位）。
    if (r == 41) {
        t = g_skillT1[p];
        if (g_assiUsed[p]) {
            BOTC_Notice(g_who[p], "刺客的刺杀一局只能用一次，你已经用过了。");
            return;
        }
        g_assiUsed[p] = true;
        g_tokOn[(((g_teller * 14) + p) * 256) + 45] = true;             // 失去能力（刺客）
        BOTC_SkillBtnRender();
        // 【刺客 × 莽夫】（用户 2026-09-20）：刺客今夜第一个选中莽夫时，莽夫的醉酒**不挡这一刀** ----
        //   莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营就固定在邪恶。
        goonHit = (BOTC_HasAbility(t, 37) && g_goonBy == p);
        if (!BOTC_SkillWorks(p) && !goonHit) {
        }
        else {
            s = "";
            if (BOTC_ProtectTokOn(t, 9)) { s = s + "保护（僧侣） "; }
            if (BOTC_ProtectTokOn(t, 25)) { s = s + "不会死亡（旅店老板） "; }
            if (BOTC_ProtectTokOn(t, 26)) { s = s + "不会死亡（水手） "; }
            if (BOTC_ProtectTokOn(t, 27)) { s = s + "处决不死（魔鬼代言人） "; }
            if (BOTC_ProtectTokOn(t, 28)) { s = s + "处决不死（和平主义者） "; }
            if (BOTC_ProtectTokOn(t, 29)) { s = s + "首次未死（弄臣） "; }
            if (BOTC_ProtectTokOn(t, 51)) { s = s + "不会死亡（茶艺师） "; }
            if (BOTC_AbilityWorks(t, 23)) { s = s + "水手·清醒 "; }
            if (BOTC_AbilityWorks(t, 11)) { s = s + "士兵 "; }
            if (BOTC_AbilityWorks(t, 12)) { s = s + "镇长 "; }
            if (BOTC_AbilityWorks(t, 34)) { s = s + "弄臣 "; }
            if (s == "") {
                s = "（他身上本来没有保护）";
            }
            BOTC_PmStore(g_teller, "【刺客】" + BOTC_NameStr(p) + " 刺杀了 " + BOTC_NameStr(t) + " → 直接死亡，**无视一切保护**：" + s + "。");
            BOTC_MarkDeathQuietSrc(t, 1, 0, 41);
            if (goonHit) {
                BOTC_PmStore(g_teller, "【刺客 × 莽夫】刺客是今夜第一个选中莽夫的人 → 莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营**固定为邪恶**。");
            }
        }
    }
    // ■ 卡扎力（135）：除首夜外，每个夜晚选择一名玩家死亡
    if (r == 135) {
        BOTC_DemonStrike(p, 135, g_skillT1[p], false);
    }
    // ■ 僵怖（43）：今天没人死的夜晚才能动手（能不能唤醒已经在 BOTC_CanWakeAt 拦过了）
    if (r == 43) {
        BOTC_DemonStrike(p, 43, g_skillT1[p], false);
    }
    // ■ 普卡（44）：先把上一次的毒结算掉，再毒新的人
    if (r == 44) {
        BOTC_PukkaResolve(p, g_skillT1[p]);
    }
    // ■ 沙巴洛斯（45）：先反刍，再吃两个人
    if (r == 45) {
        BOTC_SabalosResolve(p, g_skillT1[p], g_skillT2[p]);
    }
    // ■ 珀（46）：平时 1 个目标；带「攻击三次（珀）」时 3 个
    if (r == 46) {
        BOTC_PoResolve(p, g_skillT1[p], g_skillT2[p], g_skillT3[p]);
    }
    // ■ 方古（68）：这一刀 + 「第一次杀死外来者 → 转化」
    if (r == 68) {
        BOTC_FangGuResolve(p, g_skillT1[p]);
    }
    // ■ 亡骨魔（69）：这一刀 + 「被杀爪牙保留能力 + 邻近镇民中毒（说书人挑）」
    if (r == 69) {
        BOTC_VigResolve(p, g_skillT1[p]);
    }
    // ■ 诺-达鲺（70）：这一刀（他的两份毒是常驻效果，黄昏统一重算）
    if (r == 70) {
        BOTC_DemonStrike(p, 70, g_skillT1[p], false);
        BOTC_NoDashiiSync();
    }
    // ■ 涡流（71）：这一刀（镇民信息必错 + 没人被处决就赢，都是常驻效果）
    if (r == 71) {
        BOTC_DemonStrike(p, 71, g_skillT1[p], false);
        BOTC_VortoxSync();
    }
    if (r == 21) {
        // 小恶魔：这里只记下今晚刀谁，等说书人点【进入白天】时再死人（见 BOTC_DawnResolve）
        g_nightImp = g_skillT1[p];
        g_nightImpFrom = p;
        if (g_demonTar < 2) {          // 【疯子 × 数学家】相克规则：小恶魔这一刀也算「真恶魔的目标」
            g_demonTar = g_skillT1[p];
            BOTC_MalfLunCheck();
        }
        if (g_skillT1[p] == p) {
            BOTC_PmStore(g_teller, "【夜间】小恶魔自刀了（" + BOTC_NameStr(p) + "）。");
        }
        // 当场结算这一刀（只记录，天亮再公开）：这样排在后面的守鸦人醒来时能读到死亡 token
        BOTC_ImpKillResolve(p, g_skillT1[p]);
    }
    if (r == 5) {
        BOTC_FtAnswer(g_who[p], g_skillT1[p], g_skillT2[p]);
    }
    if (g_hagKill && g_who[p] == g_teller) {
        // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：说书人定了谁死（0~2 个）
        BOTC_HagKill(1, g_skillT1[1], g_skillT2[1]);
        return;
    }
    if (g_twinPick && g_who[p] == g_teller) {
        // 镜像双子（64）：说书人在自己面板上点了谁当对立双子
        BOTC_TwinPickAt(g_skillT1[p]);
        return;
    }
    if (r == 65) {
        // 女巫（65）：确认 = 诅咒他
        BOTC_WitchApply(p, g_skillT1[p]);
    }
    if (r == 63) {
        // 呆瓜（63）：确认 = 公开选一名存活玩家（选到邪恶 → 他的阵营落败，用户 2026-09-21）
        BOTC_KlutzPick(p, g_skillT1[p]);
    }
    if (r == 36) {
        // 月之子（36）：确认 = 公开选择一名存活玩家（天亮结算他死不死）
        BOTC_MoonChildDeclare(p, g_skillT1[p]);
    }
    // 【守鸦人（8）的「自动发信息」仍然不发】（用户 2026-10-05）：答案由说书人自己看魔典给。
    // 【但「他选了谁」要提示说书人】（用户 2026-10-07）：确认这一刻把这句写进说书人私聊。
    if (r == 8 && g_skillT1[p] >= 2) {
        BOTC_PmStore(g_teller, "【守鸦人】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(g_skillT1[p]) + "。");
        if (g_levJinxWake[p]) {
            g_levJinxWake[p] = false;
            g_levJinxLost[p] = true;
            BOTC_PmStore(g_teller, "【利维坦×守鸦人相克】守鸦人的能力已经触发 → 他本局失去能力。");
            BOTC_LeviathanSpecialSync();
        }
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

void BOTC_KillSeat (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 9]) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被小恶魔选中，但他有「保护」，没有死。");
        return;
    }
    BOTC_MarkDeath(q, 1, 1);      // 夜间死亡 + 被恶魔击杀
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(q) + StringToText(" 死亡"));
    BOTC_BansheeAnnounce(q);
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
}

//==================================================================================================
// 夜间刀口结算（小恶魔 / 僧侣）
//   技能确认时只记下目标，等说书人点【进入白天】（天亮）才真的死人并播报昨晚的死亡信息：
//     僧侣保护的人 = 小恶魔今晚选的同一个人 → 不死，私人告诉说书人；
//     小恶魔把自己刀了 → 死；场上还有活着的爪牙就传位（智能说书随机，手动说书解锁身份编辑）；
//   僧侣的「保护」只算昨晚，天亮时标记一起清掉。
//==================================================================================================

// 这个座位在场、而且还没死
bool BOTC_SeatAliveQ (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    return !BOTC_SeatDead(q);
}

// 这个座位（按说书人那份魔典上的身份）是不是爪牙
bool BOTC_SeatIsMinion (int q) {
    int r;
    if (q < 2 || q > 13) {
        return false;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 148) {
        return false;
    }
    return (BOTC_RoleTeam(r) == 2);
}

// 活着的爪牙名单（传位时给说书人看）
string BOTC_MinionListStr () {
    int i;
    int q;
    int n;
    string s;
    BOTC_BuildSeatList();
    s = "";
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                if (n > 0) {
                    s = s + ",";
                }
                s = s + BOTC_NameStr(q);
                n = n + 1;
            }
        }
    }
    if (n == 0) {
        s = "（没有）";
    }
    return s;
}

// 清掉这一夜的记录（新局、天亮结算完都调用）
void BOTC_NightSkillReset () {
    int i;
    g_hagNoDemonKill = false;          // 【麻脸巫婆】恶魔刀无效只算造出恶魔的那一晚（用户 2026-09-21）
    g_lycanNoDemon = false;            // 【半兽人（107）】「今晚恶魔不造成死亡」只算今晚（用户 2026-10-10 补）
    g_kingAnnounced = 0;               // 【国王（104）】「谁是国王」发过的标记：每夜重新放开
    g_nightImp = 0;
    g_nightImpFrom = 0;
    g_nightMonk = 0;
    g_nightMonkFrom = 0;
    for (i = 2; i <= 13; i += 1) { g_levJinxWake[i] = false; }
    // 【疯子 × 数学家】相克规则的记录：一夜用完就清（用户 2026-09-21）
    g_lunTar = 0;
    g_lunSeat = 0;
    g_lunActed = false;
    g_demonTar = 0;
}

//==================================================================================================
// 恶魔击杀统一通道：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
//==================================================================================================
void BOTC_DemonStrike (int src, int srcRole, int q, bool selfPromote) {
    bool demonHandled;
    string blk;
    string who;
    // 【麻脸巫婆（67）】（用户 2026-09-21）：她今晚造出了恶魔 → 恶魔自己的刀一律无效，死亡改由说书人定
    if (g_hagNoDemonKill) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚恶魔自己的刀无效（她已经造出了一只恶魔）。");
        return;
    }
    // 【半兽人（107）】（用户 2026-10-10）：今晚他杀死了善良玩家 → 恶魔今晚不造成死亡
    if (g_lycanNoDemon) {
        BOTC_PmStore(g_teller, "【半兽人】今晚他杀死了善良玩家 → 恶魔这一刀不造成死亡。");
        return;
    }
    // 【相克规则：疯子 × 数学家】（用户 2026-09-21）：记下真恶魔今晚的第一个目标
    if (g_demonTar < 2 && srcRole >= 0 && srcRole <= 148 && BOTC_RoleTeam(srcRole) == 3) {
        g_demonTar = q;
        BOTC_MalfLunCheck();
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    who = BOTC_RoleNameSafe(BOTC_SeatTrueRole(src));
    if (BOTC_SeatDead(q)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）选的 " + BOTC_NameStr(q) + " 本来就死了，没再动他。");
        return;
    }
    // 【莽夫那一份醉酒】（用户 2026-09-20）：施术者的醉酒如果完全来自「今夜第一个选莽夫」这一下，
    //   那它只挡「打莽夫自己」的那一刀；打别的目标照旧生效（沙巴洛斯的另一个目标还死就是这个道理）。
    if (BOTC_SeatImpaired(src) && !(BOTC_GoonDrunkOnly(src) && q != g_goonSeat)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）中毒/酒鬼，这一次的能力无效。");
        return;
    }
    // 僧侣按顺序排在他前面：这里能直接读到他的保护
    if (g_nightMonk == q) {
        if (!BOTC_SeatImpaired(g_nightMonkFrom)) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被僧侣保护住了，这一次没有生效。");
            return;
        }
        BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(g_nightMonkFrom) + "）中毒/酒鬼，保护无效。");
    }
    // 【旅店老板 / 水手 / 弄臣 那些免死】统一走 BOTC_DeathBlocker（智能说书硬判）
    blk = BOTC_DeathBlocker(q, 1, 1, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 带着【" + blk + "】，这一次没有生效。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(q);
        }
        return;
    }
    // 士兵：免疫恶魔的刀（中毒 / 酒鬼时失效）
    if (BOTC_AbilityWorks(q, 11)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 是士兵，免疫恶魔的刀。");
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 1, 1, srcRole);
    if (g_mayorHold) {
        // 镇长（12）那一刀被挂起：等说书人在弹窗里拍板之后再继续（日志 / 祖母 / 传位 / 胜负）
        g_mayorHold = false;
        g_mayorAskSrc = src;
        g_mayorAskSrcRole = srcRole;
        return;
    }
    BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(src) + "（" + who + "）击杀。");
    BOTC_NanaLinkCheck(q);             // 祖母（22）：孙子被恶魔杀死，她也一起死
    // 恶魔死了：
    //   ① **自刀**（小恶魔自己那一刀）→ **红唇女郎优先**（她在、活着、清醒、恶魔死后活人 ≥4
    //      就必须是她顶上，不给说书人挑）；没有她才让说书人挑一名活着的爪牙接位（智能说书随机挑）
    //   ② 别的死法 / 别的恶魔杀的 → 同样是红唇女郎优先，没有她就交回调用方判胜负
    demonHandled = false;
    if (selfPromote) {
        demonHandled = BOTC_ScarletCheck();
        if (!demonHandled) {
            demonHandled = BOTC_ImpPromote();
        }
    }
    else {
        demonHandled = BOTC_ScarletCheck();
    }
    if (!demonHandled) {
        BOTC_CheckWin();
    }
}

// 小恶魔这一刀：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
void BOTC_ImpKillResolve (int imp, int q) {
    BOTC_DemonStrike(imp, 21, q, (q == imp));
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 8 批】（用户 2026-09-20）：43 僵怖 / 44 普卡 / 45 沙巴洛斯 / 46 珀
//   四个恶魔都走上面那条 BOTC_DemonStrike（保护 / 免死 / 士兵 / 镇长弹刀 / 祖母联动 / 传位 / 胜负）
//==================================================================================================

// 「今天有人死」：按**死亡发生的时间**算（用户 2026-09-20）----
//   白天死的都算（处决 / 白天技能杀 / 说书人手动标的，不管打的是哪种死因 token）；
//   夜里死的不算（记死亡时是夜里 → g_deadDay 记 0）。
//   教父（39）的「今天有外来者死亡」和僵怖（43）的「今天有人死」共用这一条。
bool BOTC_ExecutedDeathToday () {
    int q;
    if (g_dayNum <= 0 || !g_execUsedToday) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_exec[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum || g_deadKind[q] != 3) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            return true;
        }
    }
    return false;
}

bool BOTC_SomeoneDiedToday () {
    int q;
    if (g_dayNum <= 0) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_deadDay[q] == g_dayNum) {
            return true;                    // 白天死的都算（处决 / 技能杀 / 说书人手动标，任何死因 token 都行）
        }
    }
    return false;
}

// ■ 僵怖（43）：「第一次死亡时，你不会死」。
//   全桌照常看到「死亡」（天亮公播 + 红叉），但他其实还活着（内部一切按活人算，见 BOTC_SeatDead）。
//   返回值：true = 这次死亡被这一条吃掉了（调用方不要再记死亡）。
bool BOTC_ZombuulFake (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_HasAbility(q, 43)) {
        return false;                       // 只有拥有僵怖能力才有这一条
    }
    // 中毒 / 酒鬼的僵怖：他的能力失效 ---- **这一次的死亡就是真死**，不消耗「第一次不会死」（用户 2026-09-20）
    if (!BOTC_AbilityWorks(q, 43)) {
        BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 「第一次不会死」这一条失效：这次照常真死。");
        return false;
    }
    if (g_zombUsed[q]) {
        // 那一次假死已经用掉：**这次的死亡是真死** ---- 顺手把「看起来死了其实活着」的状态撤掉
        //   （用户 2026-09-20：不撤的话他一直算活着，胜负和主谋的加时都判不出来）
        if (g_zombFake[q]) {
            g_zombFake[q] = false;
        }
        return false;
    }
    if (g_zombFake[q]) {
        return false;
    }
    g_zombUsed[q] = true;
    g_zombFake[q] = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 58] = true;   // 已假死（僵怖）
    if (g_isNight) {
        g_deadPending[q] = true;            // 夜里：等天亮统一公开「X 死亡」（全桌都当他死了）
    }
    else {
        g_deadShown[q] = true;              // 白天：当场公开红叉（播报由调用方负责）
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
        g_deadPending[q] = false;
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 第一次死亡 → 不会真的死：全桌照常看到「死亡」，但他其实还活着。");
    BOTC_PmStore(g_teller, "【僵怖】要真正杀死他：再记一次死亡就行。");
    BOTC_PmInfo(g_who[q], "【僵怖】你其实没有死，继续正常行动。");
    return true;
}

// ■ 普卡（44）的毒：来源离场（他死了）就把毒收回来（用户 2026-09-20 的通用规则：
//   「任何角色离场 / 死亡，除非有特别说明，能力失效、它造成的 token 一起消失」）。
// 【恐惧之灵(102) 收「恐惧」】（用户 2026-10-03）：换目标 / 他死亡或离场时，把「恐惧」121 全部撤掉
void BOTC_FearClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 121]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 121] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【恐惧之灵】" + why + " → 已撤掉「恐惧」标记（" + IntToString(n) + " 人）。");
    }
}
// 【痢蛭(100) 收毒】（用户 2026-10-03）：痢蛭死亡 / 离场时，把所有人身上的「中毒（痢蛭）120」撤掉
void BOTC_LleechPoisonClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 120]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 120] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【痢蛭】" + why + " → 已撤掉「中毒（痢蛭）」（" + IntToString(n) + " 人）。");
    }
}
void BOTC_PukkaPoisonClear (string why) {
    int q;
    q = g_pukkaSeat;
    g_pukkaSeat = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 63]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 63] = false;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【中毒】" + BOTC_NameStr(q) + " 身上的普卡之毒已清掉。");
    }
}

// ■ 普卡（44）：「每个夜晚选择一名玩家：他中毒。上一个被选中的玩家会死亡，然后恢复健康。」
//   · 首夜也会行动（首夜顺序 5）；毒**不跟黄昏清**，一直挂到普卡下一次行动
//   · 他自己中毒 / 酒鬼 → 整条能力失效：不毒新人、上一次那个也不会死
void BOTC_PukkaResolve (int p, int t) {
    int old;
    old = g_pukkaSeat;
    if (BOTC_SeatImpaired(p)) {
        BOTC_PmStore(g_teller, "【普卡】" + BOTC_NameStr(p) + " 中毒/酒鬼，这一次能力失效。");
        return;
    }
    // ① 先给新目标挂毒（用户 2026-09-20：普卡的刀是**先挂毒，然后再结算死亡**）
    g_tokOn[(((g_teller * 14) + t) * 256) + 63] = true;      // 中毒（普卡）（用户 2026-09-20）
    g_pukkaSeat = t;
    BOTC_GrimRender(g_teller);
    // ② 再结算「上一次被毒的人」：他毒发身亡，然后恢复健康（这一份毒收掉）
    if (old >= 2) {
        // 【顺序】（用户 2026-09-20 确认）：**先结算死亡，再恢复健康** ----
        //   死亡这一刻他身上的「中毒」标记还在（所以「清醒才免死」那类保护，比如水手 / 弄臣，这时候是不生效的），
        //   死完之后才把中毒 token 撤掉。
        if (!BOTC_SeatDead(old)) {
            BOTC_DemonStrike(p, 44, old, false);
        }
        if (g_tokOn[(((g_teller * 14) + old) * 256) + 63]) {
            g_tokOn[(((g_teller * 14) + old) * 256) + 63] = false;
            BOTC_GrimRender(g_teller);
        }
        if (old == t) {
            // 同一个目标：老的毒已经结算掉（恢复健康），不再挂账
            g_pukkaSeat = 0;
        }
    }
}

// ■ 沙巴洛斯（45）：反刍（复活一名上一夜吃掉、现在还死着的玩家）
void BOTC_SabalosRevive (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    // 【复活也等天亮统一结算】（用户 2026-09-20）：公开死亡的那种只在夜里记「复活（沙巴洛斯）」标记，
    //   红叉留到天亮再统一清掉 + 公布「【复活】」；还没公开的（同一夜刚死）照旧静默取消。
    if (BOTC_PublicDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = true;   // 复活（沙巴洛斯）：天亮统一结算
    }
    else {
        BOTC_ClearDeath(q);                     // 还没公开（比如同一夜刚死）：静默取消，不播报
        BOTC_RestoreOneShot(q);                 // 静默复活同样是「重新进场」
    }
    g_sabChosen[q] = false;                 // 这一个候选用掉了（以后不再反刍他）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 " + BOTC_NameStr(q) + "：红叉留到天亮统一公布「【复活】」。");
}

// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · 候选 = 上一夜吃掉、现在还死着的两个人
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 善良角色尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · **候选 = 他以前选过的所有人里、现在还死着的**（用户 2026-09-20）----
//     不一定是被他杀的：例如他选了莽夫、自己醉了什么都没发生，莽夫第二天被处决，之后一样可以反刍
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · **概率按「双刀次数」算**（用户 2026-09-20）：每当有 2 个人在同一天死于沙巴洛斯的刀就记一次，
//     初始 0%，**第一次双刀也是 0%**，从第二次双刀起每多一次 +25%（0 / 25 / 50 / 75 / 100），封顶 100%
//   · 一局限一次（`g_sabRegurgDone`）
//   · **决赛圈（场上活着 ≤ 4 人）必复活** ---- 但前提是概率不是 0（也就是至少开过 2 次双刀）
//   · **自称是「教授」时**：第一次有机会复活（第 3 夜起、已经有死掉的候选人）→ 必定复活（演得像教授）
//   · 候选 = 他以前选过的所有人里、现在还死着的；挑人优先级：决胜轮复活落后一方 / 平时邪恶优先 /
//     想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
int BOTC_SabalosRegurgPick (int p) {
    int q;
    int i;
    int n;
    int k;
    int pick;
    int chance;
    int evilAlive;
    int goodAlive;
    int alive;
    bool wantEvil;
    bool force;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (g_sabRegurgDone[p]) {
        return 0;                       // 一局只能发动一次
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return 0;                       // 没有候选：没有什么可反刍的
    }
    chance = (g_sabDouble - 1) * 25;
    if (chance > 100) {
        chance = 100;
    }
    // 场上活着的人数（按公开死亡 / 红叉算，跟判胜负一个口径）
    alive = 0;
    evilAlive = 0;
    goodAlive = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_SettledDead(q)) {
            continue;
        }
        alive = alive + 1;
        if (BOTC_SeatAlign(q) == 0) {
            goodAlive = goodAlive + 1;
        }
        else {
            evilAlive = evilAlive + 1;
        }
    }
    force = false;
    if (alive <= 4 && chance > 0) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】决赛圈 → 这一次必定反刍。");
    }
    if (g_claim[p] == 30 && g_nightNum >= 3) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】他自称是「教授」→ 第一次有机会复活时必定反刍。");
    }
    if (!force) {
        if (chance <= 0) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次不反刍。");
            return 0;
        }
        if (RandomInt(1, 100) > chance) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次没反刍。");
            return 0;
        }
    }
    wantEvil = true;
    if (alive <= 4) {
        if (evilAlive > goodAlive) {
            wantEvil = false;              // 决胜轮：邪恶已经占优 → 改帮善良那一方
        }
    }
    pick = 0;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        if (wantEvil) {
            if (BOTC_SeatAlign(q) != 1) {
                continue;
            }
        }
        else {
            if (BOTC_SeatAlign(q) != 0) {
                continue;
            }
            if (BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                continue;
            }
        }
        n = n + 1;
    }
    if (n > 0) {
        k = RandomInt(1, n);
        i = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (wantEvil) {
                if (BOTC_SeatAlign(q) != 1) {
                    continue;
                }
            }
            else {
                if (BOTC_SeatAlign(q) != 0) {
                    continue;
                }
                if (BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                    continue;
                }
            }
            i = i + 1;
            if (i == k) {
                pick = q;
                break;
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        return 0;
    }
    g_sabRegurgDone[p] = true;
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 → 复活 " + BOTC_NameStr(pick) + "（" + BOTC_AlignName(BOTC_SeatAlign(pick)) + "）。");
    return pick;
}

// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，他上一夜吃掉的一名玩家可能被反刍。」
//   ---- 先反刍，再吃两个人。
//   反刍谁定：真人说书只提示（他自己用【死亡标记】/ 复活处理）；智能说书按概率自动掷。
// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，一名他选过的玩家可能被反刍。」
//   ---- 先反刍，再吃两个人；**反刍要在「选目标 / 杀人」之前判定**（用户 2026-09-20）。
void BOTC_SabalosResolve (int p, int t1, int t2) {
    int pick;
    int goonPos;
    int i;
    int diedN;
    bool wasA;
    bool wasB;
    string s;
    s = "";
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || !g_sabChosen[i]) {
            continue;
        }
        if (!BOTC_SeatDead(i)) {
            continue;
        }
        if (StringLength(s) > 0) {
            s = s + " ";
        }
        s = s + BOTC_NameStr(i);
    }
    if (StringLength(s) <= 0) {
        s = "无";
    }
    BOTC_PmStore(g_teller, "待复活玩家：" + s);
    BOTC_PmStore(g_teller, "放置复活（沙巴洛斯）token以反刍。");
    if (t1 >= 2) {
        g_sabChosen[t1] = true;         // 先记进候选池：以后一样可以被反刍（用户 2026-09-20）
    }
    if (t2 >= 2) {
        g_sabChosen[t2] = true;
    }
    g_sabA = t1;
    g_sabB = t2;
    if (BOTC_SeatImpaired(p) && !BOTC_GoonDrunkOnly(p)) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 今晚吃人无效：这两个人都不死。");
        return;
    }
    // 【按目标顺序结算】（用户 2026-09-20）：莽夫是「被他选中的那一刻」才让施术者醉酒的 ----
    //   · 目标1 = 莽夫 → 当场醉酒：莽夫自己那一口不算，**排在他后面的目标2 也不再结算**
    //   · 目标2 = 莽夫 → 目标1 排在前面、早就结算完了，照常死（莽夫自己那一口照旧不算）
    goonPos = 0;
    if (BOTC_GoonDrunkOnly(p)) {
        if (t1 == g_goonSeat) {
            goonPos = 1;
        }
        else {
            if (t2 == g_goonSeat) {
                goonPos = 2;
            }
        }
    }
    if (goonPos == 1) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】目标1 是莽夫（" + BOTC_NameStr(g_goonSeat) + "）→ 他当场醉酒：莽夫自己那一口不算，排在他后面的目标2 也不再结算。");
        BOTC_GrimRender(g_teller);
        return;
    }
    BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 今晚吃了 " + BOTC_NameStr(t1) + " 和 " + BOTC_NameStr(t2) + "。");
    wasA = BOTC_SeatDead(t1);
    wasB = false;
    if (t2 >= 2) {
        wasB = BOTC_SeatDead(t2);
    }
    BOTC_DemonStrike(p, 45, t1, false);
    if (t2 >= 2) {
        BOTC_DemonStrike(p, 45, t2, false);
    }
    // 【累计一次「双刀」】（用户 2026-09-20）：这一夜真的有 2 个人死于他的刀
    diedN = 0;
    if (!wasA && BOTC_SeatDead(t1)) {
        diedN = diedN + 1;
    }
    if (t2 >= 2 && !wasB && BOTC_SeatDead(t2)) {
        diedN = diedN + 1;
    }
    if (diedN >= 2) {
        g_sabDouble = g_sabDouble + 1;
    }
}

// ■ 珀（46）：「每个夜晚选择一名玩家：他死亡。如果你选择不杀人，下一个夜晚你必须选择三名玩家。」
//   计数完全由 token 52「攻击三次（珀）」驱动（说书人也能自己打 / 撤）。
void BOTC_PoResolve (int p, int t1, int t2, int t3) {
    int goonPos;
    if (BOTC_ProtectTokOn(p, 52)) {
        BOTC_PmStore(g_teller, "【珀】今晚是「攻击三次」：三个人一起死。");
        // 【按目标顺序结算】（用户 2026-09-20）：排到莽夫之后的目标不再结算（莽夫自己那一口也不算）
        goonPos = 0;
        if (BOTC_GoonDrunkOnly(p)) {
            if (t1 == g_goonSeat) {
                goonPos = 1;
            }
            else {
                if (t2 == g_goonSeat) {
                    goonPos = 2;
                }
                else {
                    if (t3 == g_goonSeat) {
                        goonPos = 3;
                    }
                }
            }
        }
        if (goonPos != 0) {
            BOTC_PmStore(g_teller, "【珀】莽夫（" + BOTC_NameStr(g_goonSeat) + "）排在他选的第 " + IntToString(goonPos) + " 个 → 从莽夫开始（含他自己）都不结算，排在后面的目标也不再死。");
        }
        if (goonPos == 0 || goonPos > 1) {
            BOTC_DemonStrike(p, 46, t1, false);
        }
        if (t2 >= 2) {
            if (goonPos == 0 || goonPos > 2) {
                BOTC_DemonStrike(p, 46, t2, false);
            }
        }
        if (t3 >= 2) {
            if (goonPos == 0) {
                BOTC_DemonStrike(p, 46, t3, false);
            }
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 52] = false;      // 打完了，标记撤掉
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【珀】「攻击三次」已经用掉，标记撤掉。");
    }
    else {
        BOTC_DemonStrike(p, 46, t1, false);
    }
}

// 技能面板用的「这个角色这次要选几个目标」：珀带「攻击三次」时是 3，其余照角色表
// ■ 镜像双子（64）：「你与一名对立阵营的玩家互相知道对方是什么角色。如果其中善良玩家被处决，邪恶阵营获胜。
//   如果你们都存活，善良阵营无法获胜。」配对由**说书人**点，身份由脚本**自动**告诉两人（用户 2026-09-21）。
// 【双子 · 一切以 token 为准】（用户 2026-09-22）：76 = 镜像双子本人、77 = 对立双子
int BOTC_TwinSeatOf (int tok) {
    int i;
    for (i = 13; i >= 1; i -= 1) {
        if (i > 1 && !g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + tok]) {
            return i;
        }
    }
    return 0;
}

// 【双子能力有没有生效】（用户 2026-09-22）：镜像双子活着（或带「保留能力」）且不醉酒、不中毒 ----
//   失效时：没有特胜、也不发「你的对立双子是谁」的信息（等他清醒再补）
bool BOTC_TwinActive () {
    int a;
    a = BOTC_TwinSeatOf(76);
    if (a < 2) {
        return false;
    }
    if (BOTC_SeatImpaired(a)) {
        return false;
    }
    if (BOTC_SeatDead(a) && !BOTC_KeepsAbilityAlive(a)) {
        return false;
    }
    return true;
}

bool BOTC_TwinBlocksGood () {
    if (!BOTC_TwinActive()) {
        return false;                       // 【以 token 为准 + 醉酒/中毒即失效】（用户 2026-09-22）
    }
    if (BOTC_SeatTrueRole(g_twinA) != 64) {
        return false;                       // 那只镜像双子被改了身份 / 离场 → 能力没了
    }
    // 【亡骨魔的「保留能力」】（用户 2026-09-21）：被亡骨魔杀死的双子死后能力还在 →
    //   这一对照样算「都在」，处决善良那只一样是邪恶胜（百科就是这么写的）。
    if (BOTC_TwinSeatOf(77) < 2) {
        return false;
    }
    if (BOTC_SeatDead(BOTC_TwinSeatOf(77)) && !BOTC_KeepsAbilityAlive(BOTC_TwinSeatOf(77))) {
        return false;                       // 对立双子死了、而且没保留能力 → 能力没了
    }
    return true;
}

// 【镜像双子这一格现在算不算「中毒 / 酒鬼 / 带信息错误（涡流）」】（用户 2026-10-14）----
//   ⚠ 只看**镜像双子本人那一格**（含后来借到这个能力的人：炼金 123 / 哲学家 70 / 食人族 97 都读得到）；
//     **对立双子身上有没有标记一概不管**（用户 2026-10-14 明确）。
//   命中时：配对 token 76 / 77 脚本不代打，身份信息**只发镜像双子本人**，对立双子那边不说。
bool BOTC_TwinBadInfo (int a) {
    if (a < 2) {
        return true;
    }
    if (!BOTC_SkillWorks(a)) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + a) * 256) + 84]) {
        return true;
    }
    return false;
}
// 【把两人的身份互相告诉对方】（用户 2026-09-21；2026-10-14 恢复「清醒就照旧发两边」）----
//   ⚠ 带「中毒 / 酒鬼 / 信息错误（涡流）」的镜像双子**不走这里**：那种只发给镜像双子本人（见 BOTC_TwinBadInfo 那两支）。
void BOTC_TwinNightInfo () {
    int ra;
    int rb;
    if (g_twinA < 2 || g_twinB < 2) {
        return;
    }
    ra = BOTC_SeatTrueRole(g_twinA);
    rb = BOTC_SeatTrueRole(g_twinB);
    if (ra < 0 || rb < 0) {
        return;
    }
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(g_twinB) + "是" + g_roleName[rb] + "。");
    BOTC_PmInfo(g_who[g_twinB], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[ra] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(g_twinB) + "）。");
}

void BOTC_TwinPickAt (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return;
    }
    if (g_twinA < 2) {
        BOTC_Notice(g_teller, "场上还没有镜像双子。");
        return;
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinPick = false;
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）：token 不代打，信息只发他本人。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(q)) + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_TwinNightInfo();
}
// ■ 女巫（65）：「每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。」
//   提示标记「被诅咒」：夜晚行动后放置（她醉/中毒时不放）；黄昏、或女巫死亡/离场时移除（官方时机）。
void BOTC_WitchCurseClear (string why) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 73]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 73] = false;
        }
    }
    g_witchCurse = 0;
    BOTC_GrimRender(g_teller);
}

void BOTC_WitchApply (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13 || !g_seatOn[q]) {     // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_witchFrom = p;
    if (!BOTC_WitchCanAct(p)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次没有下咒。");
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次不放置「被诅咒」标记。");
        return;
    }
    BOTC_WitchCurseClear("女巫换了目标");
    g_witchCurse = q;
    g_tokOn[(((g_teller * 14) + q) * 256) + 73] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【女巫】诅咒了 " + BOTC_NameStr(q) + "：他明天白天一旦发起提名就会死亡。");
}

// 被诅咒的人发起提名 → 立刻死（提名照常继续；不算恶魔杀）
void BOTC_WitchNomCheck (int by) {
    int ob;
    string blk;
    if (by < 2 || by > 13 || g_witchCurse != by) {
        return;
    }
    if (g_witchFrom >= 2 && !BOTC_WitchCanAct(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次诅咒不触发。");
        return;
    }
    if (g_witchFrom >= 2 && BOTC_SeatImpaired(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】女巫中毒/酒鬼 → 这次诅咒不生效。");
        return;
    }
    // 【免死 / 保护】（用户 2026-09-21）：他免疫死亡 → 什么都不发生（不打红叉、公屏一个字都不播）
    blk = BOTC_DeathBlocker(by, 2, 0, false);
    if (blk != "") {
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(by);
        }
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 带着【" + blk + "】→ 这一次没有死（公屏什么都不会播）。");
        return;
    }
    // 【当场死 = 当场盖红叉】（用户 2026-09-21）：走「白天死亡 + 非恶魔杀」那一格，死因是「死亡（女巫）」
    BOTC_MarkDeathQuietSrc(by, 2, 0, 65);
    g_deadShown[by] = true;
    if (!BOTC_DeathSfxMute(by)) {
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
    }
    g_deadPending[by] = false;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 公屏只播「X 死亡」（不提女巫，谁都不知道是他干的，用户 2026-09-21）
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(by) + StringToText(" 死亡"));
    BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 因诅咒死亡（他的提名照常继续）。");
    BOTC_DiagStore(g_teller, "【诊断】" + BOTC_NameStr(by) + " 被女巫诅咒致死（公屏只播了「死亡」）。");
    BOTC_CheckWin();
}

// 只剩三名存活玩家 → 女巫失去能力、诅咒立刻解除（用户 2026-09-21：自动）
bool BOTC_WitchCanAct (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_witchLost) {
        return false;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只有 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只有 3 人 → 女巫能力永久失效，诅咒已解除。");
        return false;
    }
    return true;
}

void BOTC_WitchSync () {
    int i;
    int n;
    if (g_witchFrom < 2 && g_witchCurse < 2) {
        return;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SeatDead(g_seatList[i])) {
            n = n + 1;
        }
    }
    if (n <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只剩 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只剩 3 人 → 她从现在起失去能力（之后不用再唤醒她）。");
    }
}
// ■ 洗脑师（66）：「每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，
//   不然他可能被处决。」疯狂本身不做判定（纯 token，用户 2026-09-21）---- 脚本只打标记 + 自动告诉目标。
// 【相克 · 洗脑师（66）× 哥布林（99）】（用户 2026-10-14）：洗脑师只能选 **善良角色 + 哥布林** ----
//   百科口径：「洗脑师与哥布林：洗脑师可以选择将玩家洗脑成哥布林。」（脚本相克表 g_jinxText[49] 那条）
//   所以先按「只列善良」筛一遍，再把哥布林那一格单独放出来；其它爪牙 / 恶魔仍然点不到。
void BOTC_CerenShowGoblin (int p) {
    int q;
    for (q = 0; q < g_gridN; q += 1) {
        if (g_gridSlot[q] != 99) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), true);
    }
}
void BOTC_CerenOpen (int p) {
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_cerenPick = true;
    g_pickMode[g_who[p]] = 14;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], true);          // 先只列善良角色
    BOTC_CerenShowGoblin(g_who[p]);           // 【相克】再把哥布林单独放出来（别的爪牙 / 恶魔仍然点不到）
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

void BOTC_CerenApply (int who, int role) {
    if (who < 1 || who > 13 || role < 0 || role > 148) {    // 允许 1（用户 2026-09-21）
        return;
    }
    g_cerenWho = who;
    g_cerenRole = role;
    g_cerenPick = false;
    g_tokOn[(((g_teller * 14) + who) * 256) + 71] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【洗脑师】你明天白天和夜晚都要「疯狂」地证明自己是" + g_roleName[role] + "，不然可能被处决。");
    BOTC_PmStore(g_teller, "【洗脑师】已让 " + BOTC_NameStr(who) + " 疯狂证明自己是" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【洗脑师】他没做到的话，你可以处决他（占用当天处决名额）。");
}
// ■ 麻脸巫婆（67）：「每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。
//   如果因此创造了一个恶魔，当晚的死亡由说书人决定。」
//   用户 2026-09-21 的口径：阵营不变；转变当晚算他的「首个夜晚」；只提示**目标**（麻脸巫婆与说书人都不告知她结果）；
//   造出恶魔 → 当晚恶魔自己的刀无效，改由说书人在「生死无常」面板里决定 0~2 个人死（死因算她造成的）。
void BOTC_ChangeRoleMsg (int q, int role) {
    string s;
    if (q < 2 || q > 13 || role < 0 || role > 148) {
        return;
    }
    // 【阵营没变就省略】（用户 2026-10-21）：比较改身份前 / 后的有效阵营。
    s = BOTC_TransitionRoleName(g_seatPrevAlign[q], BOTC_SeatAlign(q), role);
    // 【全员追忆】首次发牌才用「失忆的X」；真实转变后本人魔典与帮助页也切到新身份。
    if (g_board == 13) {
        BOTC_AmnesiaRevealSeat(q, role);
        BOTC_GrimRender(g_who[q]);
    }
    BOTC_PmInfo(g_who[q], "【身份转变】你的身份转变：" + s + "。");
    BOTC_PmStore(g_teller, "【身份转变】" + BOTC_NameStr(q) + " → " + s + "。");
}

void BOTC_HagOpen (int p) {
    int k;
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    // 官方移除时机：麻脸巫婆下一次夜晚行动时，把上一次的「角色变化（麻脸巫婆）」标记收掉（用户 2026-09-21）
    for (k = 2; k <= 13; k += 1) {
        g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
    }
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_hagPick = true;
    g_pickMode[g_who[p]] = 15;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], false);   // 整张板子的角色都能选
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

// 真的把人变成那个角色（阵营不变；转变当晚算他的「首个夜晚」）
void BOTC_HagApply (int who, int role) {
    int oldR;
    int oldA;
    if (who < 1 || who > 13 || role < 0 || role > 148) {    // 允许 1（用户 2026-09-21）
        return;
    }
    oldR = BOTC_SeatTrueRole(who);
    // 【相克 · 麻脸巫婆 × 落难少女】（用户 2026-10-03）：她选落难少女时**不自动改人**，
    //   改由说书人手动指定谁变成落难少女（点魔典座位 → 身份网格 → 选【落难少女】）。
    if (role == 82 && oldR != 82) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】创造了落难少女：请手动选择一名玩家成为落难少女。");
        return;
    }
    // 官方：那个角色已经在场 → 无事发生（她本人不会知道结果）
    // 【用户 2026-10-16 报的 BUG】：原来还挂了个「&& oldR != role」的例外，结果「熬在场的恶魔 / 熬他本人那一格」
    //   会绕过这一条，一路走到「造出恶魔 → 生死无常面板」那支 ✗。按官方口径，只要那个角色在场就什么都不发生。
    if (BOTC_RoleInPlay(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】她选的角色（" + g_roleName[role] + "）已经在场 → 无事发生。");
        return;
    }
    // 【利维坦×麻脸巫婆】第五天之后不能把利维坦加入游戏（用户 2026-10-20：本板子启用这条相克）。
    if (role == 127 && g_levAfterFifth) {
        BOTC_PmStore(g_teller, "【利维坦×麻脸巫婆】第五个白天已经结束 → 这次创造利维坦无效。");
        BOTC_Notice(g_teller, "第五个白天之后不能再创造利维坦。");
        return;
    }
    oldA = BOTC_SeatAlign(who);
    g_hagOldRole = oldR;
    // 【认知覆盖先不落地】（用户 2026-10-19）：酒鬼 / 疯子 / 悟道者只是麻脸巫婆这次能力的「认知外壳」。
    //   第一层选完后先不要改真身、不要给目标发身份提示，只打开第二层让他「以为是谁」的面板。
    //   等 BOTC_HagBelieve() 选完再一次性提交，避免目标先看到酒鬼 / 疯子本身。
    if (role == 14 || role == 38 || role == 118) {
        BOTC_HagBelieveOpen(who, role);
        return;
    }
    BOTC_SetSeatRole(g_teller, who, role);
    // 阵营不变：只有当「转变后的身份自带阵营」跟「他原来的阵营」不一样时，才需要打「善良(14) / 邪恶(15)」
    //   token 去把它钉住（用户 2026-09-21：转变后的身份跟原来同阵营就不用打）。
    //   认知覆盖已经在上面提前转交第二层，不会走到这里。
    if (BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    // 转变当晚算他的「首个夜晚」：排在麻脸巫婆之后的「你的首个夜晚」角色当晚就能行动（用户 2026-09-21）
    g_seatFirstNight[who] = g_nightNum;
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;        // 角色变化（麻脸巫婆）：官方提示标记
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
    BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + "（原 " + BOTC_RoleNameSafe(oldR) + "）变成 " + g_roleName[role] + "，阵营不变（" + BOTC_AlignName(BOTC_SeatAlign(who)) + "）。");
    if (BOTC_SeatAlign(who) != BOTC_RoleAlign(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】注意：他的阵营跟这张身份自带的阵营不一样，因为他身上带着「" + BOTC_AlignName(BOTC_SeatAlign(who)) + "」标记（更早的转变 / 莽夫那类能力 / 你手动打的）。要改就先把那个标记撤掉。");
    }
    // 认知覆盖角色已在函数开头转交第二层；选完后由 BOTC_HagBelieve() 一次性提交。
    BOTC_ChangeRoleMsg(who, role);
    // 【数学家】（用户 2026-09-21）：改造完之后他的真身应该就是面板上那个身份；不是 → 记一格「未正常生效」
    if (BOTC_SeatTrueRole(who) != role) {
        BOTC_MalfNote(who, "麻脸巫婆改造后的真身和面板选的身份不符");
    }
    // 【洗脑师那条不用核】：她的效果是「疯狂」，脚本没法判定他到底疯没疯（纯 token + 说书人裁定，用户 2026-09-21）
    if (role == 64) {
        // 【新的镜像双子登场】（用户 2026-09-21）：旧配对已经作废，这时候直接把配对面板弹给说书人
        g_twinA = who;
        g_twinB = 0;
        g_twinPick = false;
        BOTC_PmStore(g_teller, "【镜像双子】现在场上有镜像双子（" + BOTC_NameStr(who) + "）：请你给他配一名对立双子（身份都能选）。");
        BOTC_MiFnOpen(who, 23);
    }
    if (BOTC_RoleTeam(role) == 3) {
        g_autoWoke[who] = false;           // 造出来的恶魔：当晚还要按恶魔那一格被唤醒
        g_testWoke[who] = false;
    }
    BOTC_HagDemonCheck(role);
}

// 造出恶魔 → 当晚死亡由说书人定：恶魔自己的刀无效 + 开「生死无常」面板
void BOTC_HagDemonCheck (int role) {
    if (role < 0 || role > 148) {
        return;
    }
    if (BOTC_RoleTeam(role) != 3) {
        return;
    }
    g_hagNoDemonKill = true;
    BOTC_PmStore(g_teller, "【麻脸巫婆】她造出了一只恶魔（" + g_roleName[role] + "）→ 今晚恶魔自己的刀无效，改由你在「生死无常」面板里决定 0~2 个人死。");
    BOTC_HagKillOpen();
}

void BOTC_HagKillOpen () {
    g_hagKill = true;
    BOTC_SkillOpen(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择两名玩家"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【麻脸巫婆】请在你的面板里决定今晚死谁：最多 2 个，也可以点【取消】一个都不杀。");
}

// 说书人定了谁死（0~2 个）：死因是「死亡（麻脸巫婆）」---- 不算恶魔杀，不触发被恶魔杀死的技能
void BOTC_HagKill (int p, int a, int b) {
    int n;
    n = 0;
    if (a >= 2 && a <= 13 && !BOTC_SeatDead(a)) {
        BOTC_MarkDeathByTok(a, 93);
        // 【不公聊】（用户 2026-09-21）：生死无常造成的死亡**不在公屏单独播「【麻脸巫婆】X 死亡」**----
        //   那样等于把她说出来了。天亮统一按普通死亡播报「昨晚 X 死亡」就行（上面那句 MarkDeathByTok 已经排进队列）。
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(a) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    if (b >= 2 && b <= 13 && b != a && !BOTC_SeatDead(b)) {
        BOTC_MarkDeathByTok(b, 93);
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(b) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    g_hagKill = false;
    // 【收面板】（用户 2026-09-21）：生死无常结算完把面板关掉、停止继续选目标，不然会一直挂在说书人脸上
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (n == 0) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚没有让任何人死。");
    }
    BOTC_CheckWin();
}

// 酒鬼 / 疯子：由说书人再选一次他「以为自己是哪个角色」（跟哲学家那套一样）
void BOTC_HagBelieveOpen (int who, int kind) {
    int q;
    g_hagWho = who;
    g_cerenRole = kind;                 // 借用这个全局记一下：14 = 酒鬼 / 38 = 疯子 / 118 = 悟道者
    g_pickMode[g_teller] = 16;
    g_pickWho[g_teller] = who;
    g_pickTeam = 0;                     // 酒鬼只列镇民
    if (kind == 38) {
        g_pickTeam = 3;                 // 疯子只列恶魔
    }
    if (kind == 118) {
        g_pickTeam = 1;                 // 【悟道者（118）】（用户 2026-10-16）：只列外来者
    }
    BOTC_PickFilter(g_teller, false);
    if (kind == 14) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个镇民？"), PlayerGroupSingle(g_teller));
    }
    else {
        if (kind == 118) {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪只恶魔？"), PlayerGroupSingle(g_teller));
        }
    }
    // 【认知覆盖类不能当那张卡】（用户 2026-10-16）：酒鬼(14) / 疯子(38) 从网格里藏起来
    if (kind == 118) {
        for (q = 0; q < 64; q += 1) {
            if (g_gridSlot[q] == 14 || g_gridSlot[q] == 38) {
                DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
            }
        }
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_HagBelieve (int role) {
    int who;
    int kind;
    int oldA;
    who = g_hagWho;
    kind = g_cerenRole;
    if (who < 2 || who > 13 || role < 0 || role > 148) {
        return;
    }
    oldA = BOTC_SeatAlign(who);
    // 【认知身份与原身份相同也要让旧身份离场】（用户 2026-10-19）：表面上不改格子里的卡，
    //   但真身已经从原来的角色变成酒鬼 / 疯子 / 悟道者。先走一次旧角色离场，再写回说书人选中的认知身份；
    //   中间不刷新玩家魔典，所以目标不会看到认知覆盖角色本身。
    if (role == g_hagOldRole) {
        BOTC_SetSeatRole(g_teller, who, kind);
    }
    g_pickMode[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    if (kind == 38) {
        // 疯子：真身是疯子，但魔典上按「他以为自己是的那只恶魔」显示（跟原本的疯子一样，用户 2026-09-21）
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 49] = true;
        if (role == g_hagOldRole) {
            BOTC_PmStore(g_teller, "【麻脸巫婆】说书人选的角色跟他原本的身份一样 → 不发身份转变提示（但他依然是疯子）。");
        }
        else {
            // 【按目标原阵营显示】（用户 2026-10-19）：麻脸巫婆改变阵营不变，
            //   善良玩家熬成疯子并认知某只恶魔时，要显示「善良的恶魔」，不能固定写成邪恶。
            BOTC_AmnesiaRevealSeat(who, role);
            BOTC_PmInfo(g_who[who], "【身份转变】你的身份转变：" + g_roleName[role] + "。");
            BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成疯子（认知自己是" + g_roleName[role] + "）。");
        }
    }
    else if (kind == 118) {
        // 【悟道者（118）】（用户 2026-10-16）：跟酒鬼同一套 ---- 真身是悟道者，魔典上按「他以为自己是那个外来者」显示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 140] = true;
        if (role != g_hagOldRole) {
            BOTC_AmnesiaRevealSeat(who, role);
            BOTC_PmInfo(g_who[who], "【身份转变】你的身份转变：" + g_roleName[role] + "。");
            BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成悟道者（认知自己是" + g_roleName[role] + "）。");
        }
        else {
            BOTC_PmStore(g_teller, "【麻脸巫婆】说书人选的角色跟他原本的身份一样 → 不发身份转变提示（但他依然是悟道者）。");
        }
    }
    else {
        // 酒鬼：真身是酒鬼，魔典上按「他以为自己是那个镇民」显示；跟他原本身份一样就不发提示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 8] = true;
        if (role != g_hagOldRole) {
            BOTC_AmnesiaRevealSeat(who, role);
            BOTC_PmInfo(g_who[who], "【身份转变】你的身份转变：" + g_roleName[role] + "。");
            BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成酒鬼（认知自己是" + g_roleName[role] + "）。");
        }
        else {
            BOTC_PmStore(g_teller, "【麻脸巫婆】说书人选的角色跟他原本的身份一样 → 不发身份转变提示（但他依然是酒鬼）。");
        }
    }
    // 【选完才提交身份变化的配套状态】（用户 2026-10-19）：阵营固定、首个夜晚、官方角色变化标记，
    //   原来在 BOTC_HagApply() 第一层就提前写了；现在只能在第二层选完后补上。
    if (kind == 14 || kind == 38 || BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    g_seatFirstNight[who] = g_nightNum;
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
}
//==================================================================================================
// 【食人族（74）】（用户 2026-09-23）：吃到疯子的能力
//==================================================================================================
int BOTC_CannSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            return i;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_mark[(g_teller * 14) + i] - 1 == 74) {
            return i;
        }
    }
    return 0;
}

void BOTC_CannAfterExec (int q) {
    int cs;
    int kind;
    BOTC_CannRevert();
    cs = BOTC_CannSeat();
    if (cs < 2 || cs == q) {
        return;
    }
    kind = 0;
    if (BOTC_SeatTrueRole(q) == 38) {
        kind = 38;
    }
    if (kind == 0) {
        return;
    }
    g_cannSeat = cs;
    g_cannKind = kind;
    g_cannSrc = q;
    BOTC_CannOpen(kind);
}

void BOTC_CannRevert () {
    int cs;
    cs = g_cannSeat;
    if (cs < 2) {
        cs = BOTC_CannSeat();
    }
    if (cs < 2) {
        return;
    }
    if (BOTC_SeatDead(cs)) {
        return;                  // 食人族死了：不还原，他始终是带着那两个标记的那个角色
    }
    if (g_cannKind > 0 || g_tokOn[(((g_teller * 14) + cs) * 256) + 97]) {
        BOTC_SetSeatRole(g_teller, cs, 74);
        g_tokOn[(((g_teller * 14) + cs) * 256) + 49] = false;
        g_tokOn[(((g_teller * 14) + cs) * 256) + 97] = false;
        if (g_cannKind > 0) {
            BOTC_ChangeRoleMsg(cs, 74);
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 变回食人族。");
        }
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[cs]);
    }
    g_cannRole = 0;
    g_cannKind = 0;
    g_cannSeat = 0;
    g_cannSrc = 0;
}

void BOTC_CannOpen (int kind) {
    if (g_cannSeat < 2) {
        return;
    }
    g_pickMode[g_teller] = 17;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 3;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("食人族：选一只恶魔（疯子）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_CannPick (int role) {
    int cs;
    if (g_cannSeat < 2 || role < 0 || role > 148) {
        return;
    }
    cs = g_cannSeat;
    if (BOTC_RoleTeam(role) != 3) {
        BOTC_Notice(g_teller, "疯子只能选恶魔。");
        return;
    }
    BOTC_SetSeatRole(g_teller, cs, role);
    g_cannRole = role;
    g_seatFirstNight[cs] = g_nightNum;
    g_tokOn[(((g_teller * 14) + cs) * 256) + 97] = true;
    g_tokOn[(((g_teller * 14) + cs) * 256) + 49] = true;
    BOTC_SeatStateSync();      // 【打完「是食人族 / 是疯子」之后再算一次】（用户 2026-10-14）
    BOTC_ChangeRoleMsg(cs, role);
    BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 吃到了疯子的能力 → " + g_roleName[role] + "。");
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[cs]);
}

void BOTC_BluffSendToCannibal () {
    int i;
    int ca;
    ca = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            ca = i;
        }
    }
    if (ca < 2) {
        BOTC_NoticeBox(g_teller, "没找到「是食人族」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    if (g_bluffTargetC >= 2 && g_bluffTargetC != ca) {
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[g_bluffTargetC]), false);
    }
    g_bluffTargetC = ca;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[ca]));
        libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[ca]));
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[ca]), true);
    g_bluffGot[g_who[ca]] = true;
    BOTC_NoticeBox(g_teller, "3 个不在场身份已发送给食人族 " + BOTC_NameStr(ca) + "。");
    BOTC_Notice(g_who[ca], "说书人给了你 3 个不在场身份，看右下角面板。");
}

//==================================================================================================
// 【梦殒春宵 · 四个恶魔】（用户 2026-09-21）：68 方古 / 69 亡骨魔 / 70 诺-达鲺 / 71 涡流
//   四个都走统一恶魔击杀通道 BOTC_DemonStrike，死因各自打 64 / 65 / 66 / 67。
//   常驻效果：诺-达鲺两侧最近镇民中毒；涡流让镇民信息必错 + 没人被处决就邪恶胜；
//             亡骨魔让被杀爪牙保留能力、并让邻近镇民中毒（说书人挑一侧）。
//==================================================================================================

// 环形走位：从 from 出发沿 dir（+1 顺时针 / -1 逆时针）走到座位表里的下一个座位
int BOTC_RingNext (int from, int dir) {
    int i;
    int idx;
    int n;
    BOTC_BuildSeatList();
    n = g_seatN;
    if (n <= 0) {
        return 0;
    }
    idx = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == from) {
            idx = i;
        }
    }
    if (idx < 0) {
        return 0;
    }
    idx = idx + dir;
    if (idx < 0) {
        idx = n - 1;
    }
    if (idx >= n) {
        idx = 0;
    }
    return g_seatList[idx];
}

// 从 from 沿 dir 找下一个「真身镇民」（跳过节肢 / 外来者 / 爪牙 / 恶魔；死亡也算；skip 跳过某一格）
int BOTC_NextTownsfolk (int from, int dir, int skip) {
    int i;
    int q;
    BOTC_BuildSeatList();
    q = from;
    for (i = 0; i < g_seatN; i += 1) {
        q = BOTC_RingNext(q, dir);
        if (q < 2) {
            return 0;
        }
        if (q == skip) {
            continue;
        }
        if (BOTC_SeatTeam(q) == 0) {
            return q;
        }
    }
    return 0;
}

// 场上「活着、并且当前有这个恶魔能力」的座位在哪（0 = 没有 → 他的常驻效果也就没有了）
int BOTC_LiveDemonSeat (int role) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!BOTC_AbilityWorks(q, role)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        return q;
    }
    return 0;
}

// 【诺-达鲺（70）】两侧最近的镇民中毒（死亡也算）。
//   用户 2026-09-21 口径：毒钉在最近那个镇民身上，**他死了不蔓延**；
//   只有「他不再是镇民」（角色被换 / 换了位置）时才沿同一方向往外延到**下一个镇民**。
void BOTC_NoDashiiSync () {
    int q;
    int d;
    int keep;
    int oldA;
    int oldB;
    oldA = g_nodA;
    oldB = g_nodB;
    d = BOTC_LiveDemonSeat(70);
    if (d < 2) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
        }
        g_nodA = 0;
        g_nodB = 0;
        g_nodDemon = 0;
        g_nodManual = false;
        if (oldA >= 2 || oldB >= 2) {
            BOTC_PmStore(g_teller, "【诺-达鲺】场上没有活着的诺-达鲺 → 两份「中毒（诺-达鲺）」都撤掉。");
            BOTC_GrimRender(g_teller);
        }
        return;
    }
    // 【换了一个诺-达鲺 / 换座位 / 身份变化】（用户 2026-10-19）：旧毒口只对「同一个诺-达鲺」有效；
    //   红唇女郎在另一个位置继位后，必须从新诺-达鲺的位置重新向两侧找最近镇民。
    if (g_nodDemon != d) {
        g_nodA = 0;
        g_nodB = 0;
        g_nodManual = false;
    }
    g_nodDemon = d;
    // 【手动优先】（用户 2026-10-19）：说书人在 token 面板改过诺-达鲺的毒口后，
    //   自动同步只记录实际标记，不再清掉重打；直到身份 / 座位再次变化才恢复自动重算。
    if (g_nodManual) {
        g_nodA = 0;
        g_nodB = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_tokOn[(((g_teller * 14) + q) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = q;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = q;
                }
            }
        }
        return;
    }
    // 顺时针那侧
    keep = 0;
    if (g_nodA >= 2 && g_seatOn[g_nodA] && BOTC_SeatTeam(g_nodA) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodA >= 2 && g_seatOn[g_nodA]) {
            g_nodA = BOTC_NextTownsfolk(g_nodA, 1, g_nodB);       // 他不再是镇民 → 沿这一侧再往外找一个
        }
        else {
            g_nodA = BOTC_NextTownsfolk(d, 1, g_nodB);
        }
    }
    // 逆时针那侧
    keep = 0;
    if (g_nodB >= 2 && g_seatOn[g_nodB] && BOTC_SeatTeam(g_nodB) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodB >= 2 && g_seatOn[g_nodB]) {
            g_nodB = BOTC_NextTownsfolk(g_nodB, -1, g_nodA);
        }
        else {
            g_nodB = BOTC_NextTownsfolk(d, -1, g_nodA);
        }
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
    }
    if (g_nodA >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodA) * 256) + 80] = true;
    }
    if (g_nodB >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodB) * 256) + 80] = true;
    }
    if (oldA != g_nodA || oldB != g_nodB) {
        BOTC_PmStore(g_teller, "【诺-达鲺】与他相邻的两名镇民中毒：" + BOTC_NameStr(g_nodA) + "（顺时针）/ " + BOTC_NameStr(g_nodB) + "（逆时针）。");
        BOTC_GrimRender(g_teller);
    }
}

// 【涡流（71）】：只要他活着并且清醒，镇民玩家通过能力拿到的信息一定错 → 给镇民打提醒标记
void BOTC_VortoxSync () {
    int q;
    int on;
    on = 0;
    if (BOTC_LiveDemonSeat(71) >= 2) {
        on = 1;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (on == 1 && BOTC_SeatTeam(q) == 0) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = false;
        }
    }
    BOTC_GrimRender(g_teller);
}

// 【涡流（71）】每个黄昏：今天白天没有人被处决 → 邪恶阵营获胜
//   （处决了但没死也算「有人被处决」；流放旅行者不算 ---- 我们还没做旅行者）
void BOTC_VortoxDuskCheck () {
    int d;
    if (!g_started || g_gameOver) {
        return;
    }
    // 【第 1 夜之前不算】（用户 2026-09-21 救火）：入夜 1 时天号还是 0（准备阶段），
    //   那时候还没「白天」可谈 ---- 不加这一句，涡流第一晚就会直接判邪恶胜。
    if (g_dayNum < 1) {
        return;
    }
    d = BOTC_LiveDemonSeat(71);
    if (d < 2) {
        return;
    }
    if (g_execUsedToday) {
        BOTC_PmStore(g_teller, "【涡流】今天白天有人被处决 → 这条胜利条件不触发。");
        return;
    }
    BOTC_PmStore(g_teller, "【涡流】今天白天没有人被处决 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "*黑白颠倒，对错不再，左右变换，长短无猜。", "万物紊乱无可寻，短视死亡把命栽，何处寻答？随我来。*");
}

// 【亡骨魔（69）】被亡骨魔杀死的爪牙「保留能力」：带着 79 标记的爪牙，即使死了也照常行动
//   （百科：只要亡骨魔还活着就行；他不再是爪牙 / 死爪牙自己中毒醉酒时作废）
bool BOTC_KeepsAbilityAlive (int q) {
    int v;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 79]) {
        return false;
    }
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) {
        return false;
    }
    if (BOTC_SeatImpaired(q)) {
        return false;
    }
    v = BOTC_AbilitySeat(69);
    if (v < 2 || v > 13 || BOTC_SeatDead(v)) {
        return false;
    }
    return true;
}

// 亡骨魔杀了爪牙之后：弹面板让说书人从「顺时针 / 逆时针各取最近的一个镇民」里挑一个中毒
void BOTC_VigPickOpen (int minion, int a, int b) {
    string ta;
    string tb;
    BOTC_MiSeatFieldsReset();
    g_vigFrom = minion;
    g_vigA = a;
    g_vigB = b;
    ta = "（这一侧没有镇民）";
    tb = "（这一侧没有镇民）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    g_miSeat = 0;
    g_miRole = 79;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【亡骨魔】" + BOTC_NameStr(minion) + "（被杀死的爪牙）邻近的镇民：让哪一侧中毒？")), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText("左 = " + ta + "（顺时针）　右 = " + tb + "（逆时针）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【亡骨魔】点左边或右边，让那名镇民中毒。");
}

// 真的给这名镇民打上「中毒（亡骨魔）」；两个候选都没人时什么也不做
void BOTC_VigPoison (int who) {
    int m;
    m = g_vigFrom;
    g_vigFrom = 0;
    if (who < 2 || who > 13) {
        BOTC_PmStore(g_teller, "【亡骨魔】这一侧没有合格的镇民 → 这一次不中毒。");
        return;
    }
    g_tokOn[(((g_teller * 14) + who) * 256) + 81] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【亡骨魔】" + BOTC_NameStr(m) + "（被杀的爪牙）→ " + BOTC_NameStr(who) + " 中毒。");
}

//--------------------------------------------------------------------------------------------------
// 【二选一醉酒】（用户 2026-10-16）：水手（23）/ 旅店老板（26）/ 店小二（115）共用亡骨魔那套二选一面板。
//   kind：0 = 水手（左 = 他自己、右 = 他选的人）　1 = 旅店老板（他选的两名玩家）　2 = 店小二（说书人填的那两个号）
//   ⚠ 谁醉由说书人点 ---- 原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
//--------------------------------------------------------------------------------------------------
void BOTC_DrunkPickOpen (int kind, int who, int a, int b) {
    string ta;
    string tb;
    string ttl;
    string note;
    BOTC_MiSeatFieldsReset();
    g_dkKind = kind;
    g_dkFrom = who;
    g_dkA = a;
    g_dkB = b;
    ta = "（没有人）";
    tb = "（没有人）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    ttl = "【水手】" + BOTC_NameStr(who) + "：他自己 / 他选的玩家，谁醉酒？";
    note = "左 = " + ta + "　右 = " + tb;
    if (kind == 1) {
        ttl = "【旅店老板】" + BOTC_NameStr(who) + " 选的两名玩家：谁醉酒？";
    }
    if (kind == 2) {
        ttl = "【店小二】" + BOTC_NameStr(who) + " 得知的两个人：谁醉酒？";
    }
    if (BOTC_SeatImpaired(who)) {
        note = note + "　（他中毒/酒鬼：点【取消】= 这次谁也不醉）";
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    g_miSeat = 0;
    g_miRole = 807;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(ttl)), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// side：1 = 点了左边（候选 A）/ 0 = 点了右边（候选 B）
void BOTC_DrunkPickApply (int side) {
    int k;
    int who;
    int pick;
    k = g_dkKind;
    who = g_dkFrom;
    pick = g_dkB;
    if (side != 0) {
        pick = g_dkA;
    }
    g_dkKind = 0;
    g_dkFrom = 0;
    g_dkA = 0;
    g_dkB = 0;
    if (pick < 2 || pick > 13) {
        return;
    }
    if (k == 0) {
        if (g_sailorDrunk >= 2 && g_sailorDrunk != pick) {
            BOTC_SailorDrunkClear("水手换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 59] = true;      // 醉酒（水手）
        g_sailorDrunk = pick;
        BOTC_SailorSync();
    }
    if (k == 1) {
        if (g_nightDrunk >= 2 && g_nightDrunk != pick) {
            BOTC_DrunkClear("旅店老板换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 60] = true;      // 醉酒（旅店老板）
        g_nightDrunk = pick;
    }
    if (k == 2) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 136] = true;     // 醉酒（店小二）
    }
    BOTC_GrimRender(g_teller);
}

//--------------------------------------------------------------------------------------------------
// 【混沌（121）】（用户 2026-10-16）：每夜*刀一个人；如果这一刀杀死了「离他最近的两名镇民之一」
//   → 除旅行者外的所有善良玩家中毒，直到下一个黄昏（转成邪恶自动失效、转回善良自动生效）。
//--------------------------------------------------------------------------------------------------
void BOTC_HunDunPoisonAll () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatAlign(i) != 0) {
            continue;                                   // 只毒善良（旅行者本图没有）
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = true;
    }
    BOTC_GrimRender(g_teller);
}

// 到黄昏把那一份「善良中毒」全清掉（混沌死亡 / 离场的那一份由 BOTC_TokGoneWithSource 负责）
void BOTC_HunDunClear () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = false;
    }
    BOTC_GrimRender(g_teller);
}

// 这一刀要不要触发：目标是镇民 + 已经死了 + 他是「离混沌最近的两名镇民」之一
void BOTC_HunDunCheck (int demon, int target) {
    int a;
    int b;
    if (demon < 2 || demon > 13 || target < 2 || target > 13) {
        return;
    }
    // 【这一刀直接分出胜负 → 不触发中毒】（百科口径；用户 2026-10-16 要求严格照做）
    //   最典型的影响是异端分子：他要是被这枚「中毒」打上，对调胜负就失效了 ----
    //   而百科说这种「一刀结束游戏」的场合根本不该给任何人上毒。
    //   （BOTC_DemonStrike 里面已经调过 BOTC_CheckWin，所以这里能直接读到 g_gameOver）
    if (g_gameOver) {
        return;
    }
    if (!(BOTC_SeatDead(target) || g_deadPending[target])) {
        return;                                     // 没造成死亡（被免死 / 被拦下）→ 不触发
    }
    if (BOTC_SeatTeam(target) != 0) {
        return;                                     // 不是镇民 → 不触发
    }
    a = BOTC_NextTownsfolk(demon, 1, 0);
    b = BOTC_NextTownsfolk(demon, -1, 0);
    if (target != a && target != b) {
        return;
    }
    BOTC_HunDunPoisonAll();
    BOTC_PmStore(g_teller, "【混沌】这一刀杀死了邻近的镇民 " + BOTC_NameStr(target) + " → 除旅行者外的所有善良玩家中毒到下个黄昏。");
}

//--------------------------------------------------------------------------------------------------
// 【逆臣（119）】（用户 2026-10-16）：谁先死于处决，另一方当晚转邪恶（处决那一侧见 BOTC_ExecToggleAt）
//--------------------------------------------------------------------------------------------------
void BOTC_TurncoatApply (int who) {
    if (who < 2 || who > 13) {
        return;
    }
    if (BOTC_SeatAlign(who) == 1) {
        return;                                     // 本来就是邪恶 → 不变成善良（百科）
    }
    g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;      // 「邪恶」token：真身也算邪恶
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【逆臣】你转变为邪恶阵营。");
    BOTC_PmStore(g_teller, "【逆臣】" + BOTC_NameStr(who) + " 转变为邪恶阵营。");
}

// 【方古（68）】先正常结算这一刀；如果这一刀**真的杀死了外来者**、而且「限一次」还没用 → 转化
void BOTC_FangGuResolve (int p, int q) {
    int wasDead;
    int isOut;
    wasDead = 0;
    isOut = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_SeatTeam(q) == 1) {
            isOut = 1;
        }
    }
    BOTC_DemonStrike(p, 68, q, false);
    if (wasDead == 1 || isOut == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        return;                       // 被保护 / 免死 / 士兵挡下 → 他没死就不转化（百科明写）
    }
    // 【「限一次」的判定】（用户 2026-09-21 问原理）：光看「现在这只方古那一格」不够 ----
    //   转化之后新方古在**另一个座位**上，他去杀外来者时读自己那格是空的，会再转化一次。
    //   所以：① 全局 g_fangUsed 记账（整局一次，跨座位）；② 第 78 格 token 只当说书人提醒，
    //   顺带也留着「手动给当前方古打上这枚 token = 这一局已经用掉」的口子。
    if (g_fangUsed || g_tokOn[(((g_teller * 14) + p) * 256) + 78]) {
        BOTC_PmStore(g_teller, "【方古】「限一次」已经用过了 → 这一刀按普通击杀结算（外来者正常死亡）。");
        return;
    }
    g_fangUsed = true;
    g_tokOn[(((g_teller * 14) + p) * 256) + 78] = true;           // 「限一次」：整局留着，方古死了也不撤
    // 【修 BUG】（用户 2026-09-23）：他不是死，是「当场变成方古」----
    //   上面 BOTC_DemonStrike 已经按「击杀」记了死亡 token / 待天亮公布，这里整条收掉，
    //   否则天一亮还会公屏播「X 死亡」，看起来就是「既变成方古又死了」。
    //   （BOTC_ClearDeath 只清死亡记录 / 红叉 / 待公布 + 一次性能力复位，不发任何公屏。）
    BOTC_ClearDeath(q);
    BOTC_SetSeatRole(g_teller, q, 68);
    BOTC_SetSeatRole(g_who[q], q, 68);
    g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;          // 转邪恶
    g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
    BOTC_ChangeRoleMsg(q, 68);                      // 【统一身份转变提示】（用户 2026-10-01）：方古转化也走这一套
    BOTC_PmStore(g_teller, "【方古】" + BOTC_NameStr(q) + "（外来者）变成邪恶的方古；老方古（" + BOTC_NameStr(p) + "）代替他死亡。");
    BOTC_MarkDeathByTok(p, 64);                     // 老方古死亡（死因照打「死亡（方古）」）
    g_autoWoke[q] = true;
    BOTC_GrimRender(g_teller);
    BOTC_CheckWin();
}

// 【亡骨魔（69）】先正常结算这一刀；杀死的是**真身爪牙** → 给他打「保留能力」，
//   再让说书人从他两侧最近的镇民里挑一个中毒
void BOTC_VigResolve (int p, int q) {
    int wasDead;
    int isMinion;
    int a;
    int b;
    wasDead = 0;
    isMinion = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 2) {
            isMinion = 1;
        }
    }
    // 【先打「保留能力」再结算这一刀】（用户 2026-09-21）：他死的那一刻「离场清理」会跑 ----
    //   标记先挂着，清理才知道「这个人保留能力、别收他的 token」；没死的话再把标记撤掉。
    if (wasDead == 0 && isMinion == 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = true;
    }
    BOTC_DemonStrike(p, 69, q, false);
    if (wasDead == 1 || isMinion == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = false;      // 没死（被保护 / 免死 / 士兵）→ 不保留，撤掉
        return;
    }
    a = BOTC_NextTownsfolk(q, 1, 0);
    b = BOTC_NextTownsfolk(q, -1, 0);
    BOTC_GrimRender(g_teller);
    BOTC_VigPickOpen(q, a, b);
}

// 【测试】把座位 2（游戏里的「玩家1」）按麻脸巫婆的能力变成某个角色（用户 2026-09-21）
//   role < 0 = 用当前板子上的第一只恶魔（测试「造出恶魔」那一套：恶魔刀无效 + 生死无常面板）
void BOTC_TestHag (int role) {
    int i;
    int b;
    int r;
    int pick;
    pick = role;
    if (pick < 0) {
        pick = 21;
        b = g_board;
        if (b < 1 || b > 13) {
            b = 1;
        }
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            r = g_boardRole[(b * 256) + i];
            if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == 3) {
                pick = r;
                break;
            }
        }
    }
    BOTC_Notice(g_teller, "【麻脸巫婆·测试】把 " + BOTC_NameStr(2) + " 熬成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_PmStore(g_teller, "【麻脸巫婆·测试】-熬 指令：把 " + BOTC_NameStr(2) + " 变成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_HagApply(2, pick);
}

// 【查看某个座位】（用户 2026-09-21）：把那个座位现在的身份 / 阵营 / 标记写进说书人日志
void BOTC_SeatDump (int q) {
    int t;
    string tk;
    string st;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    tk = "";
    for (t = 0; t < 256; t += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
            continue;
        }
        if (BOTC_IsHiddenTok(t)) {
            continue;
        }
        if (g_tokShort[t] == "") {
            continue;
        }
        if (tk != "") {
            tk = tk + "、";
        }
        tk = tk + g_tokShort[t];
    }
    if (tk == "") {
        tk = "（没有）";
    }
    if (BOTC_SeatAlign(q) == 1) {
        st = "邪恶";
    }
    else {
        st = "善良";
    }
    if (BOTC_SeatDead(q)) {
        s = "已死亡";
    }
    else {
        s = "活着";
    }
    BOTC_Notice(g_teller, "【查看】" + BOTC_NameStr(q) + "：" + BOTC_SeatRoleStr(q));
    BOTC_PmStore(g_teller, "【查看】座位 " + IntToString(q - 1) + "（" + BOTC_NameStr(q) + "）：魔典身份 = " + BOTC_SeatRoleStr(q) + "，真身索引 = " + IntToString(BOTC_SeatTrueRole(q)));
    BOTC_PmStore(g_teller, "【查看】阵营 = " + st + "；状态 = " + s);
    BOTC_PmStore(g_teller, "【查看】身上的标记：" + tk);
}
// 【镜像双子 · 配对】（用户 2026-09-21）：说书人在「祖母那种面板」里填座位号 + 选身份（所有角色都能选）。
//   他中毒 / 酒鬼时按规则两人不该知道对方身份 → 只记下来、不发信息，让说书人自己决定。
void BOTC_TwinPair (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 148) {
        return;
    }
    if (g_twinA < 2) {
        // 【-t 测试 / 说书人自己那一格】（用户 2026-09-21）：他自己就是镜像双子时也能配对
        if (BOTC_SeatTrueRole(1) == 64) {
            g_twinA = 1;
        }
        else {
            BOTC_Notice(g_teller, "场上还没有镜像双子。");
            return;
        }
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）----
        //   配对 token 76 / 77 脚本不代打；「你的对立双子是谁」只发给镜像双子本人（说书人填的那个身份），对立双子那边一个字都不发。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子（身份：" + g_roleName[role] + "）；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
    BOTC_PmInfo(g_who[q], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[64] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(q) + "）。");
    // 【数学家】（用户 2026-09-21）：说书人填的身份跟那个人的真身 / 登记层都对不上 → 记一格「未正常生效」
    //   （挂在镜像双子那一格：是他这条能力给出去的信息不对）
    if (BOTC_SeatTrueRole(q) != role && BOTC_RegRoleOf(q) != role) {
        BOTC_MalfNote(g_twinA, "镜像双子配对时填的身份和真身（含登记层）都不符");
    }
}
bool BOTC_TargetMustBeLiving (int p) {
    int r;
    r = BOTC_ActRoleOf(p);
    if (r == 23 || r == 24 || r == 40 || r == 49 || r == 77 || r == 107) {
        return true;
    }
    // 痢蛭只有首夜选宿主时要求存活；之后每夜的杀人目标可以是任意玩家。
    if (r == 100 && BOTC_ActingIsFirstNight(p)) {
        return true;
    }
    return false;
}

bool BOTC_TargetIsLiving (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    if (g_zombFake[q] || BOTC_PublicDead(q) || BOTC_SeatDead(q)) {
        return false;
    }
    return true;
}

int BOTC_TargetsOf (int p) {
    int r;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (p == 1 && g_boomKeepPick) {
        return 3;
    }
    r = BOTC_ActRoleOf(p);
    // 【说书人那一格】（用户 2026-09-21 报「目标2 不见了」）：生死无常 / 镜像双子配对 / 心上人
    //   这几块面板开在**玩家 1** 身上，他魔典上没有身份（r = -1）----
    //   这几个特例必须放在「没身份就 return 0」**前面**，否则它们永远只拿到 1 个目标槽。
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：两个目标槽（最多杀 2 个）
    if (g_who[p] == g_teller && g_hagKill) {
        return 2;
    }
    // 【镜像双子配对】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_twinPick) {
        return 1;
    }
    // 【心上人】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_sweetBySt) {
        return 1;
    }
    // 奥赫选到不在场 / 重复角色时，说书人那一格弹一次单目标选择
    if (p == 1 && g_ojoAskSt) {
        return 1;
    }
    if (p == 1 && g_boffinRecipientPick) {
        return 1;
    }
    if (r < 0 || r > 148) {
        return 0;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔被再次唤醒时也要两个目标槽
    if (p == g_barberFrom) {
        return 2;
    }
    if (r == 46 && BOTC_ProtectTokOn(p, 52)) {
        return 3;
    }
    // 哈迪寂亚（87）：固定三个目标
    if (r == 87) {
        return 3;
    }
    return g_roleTargets[r];
}

// 「每局限一次」的角色（智能说书反刍时尽量避开）：猎手 10 / 侍臣 29 / 教授 30 / 刺客 41
bool BOTC_OneShotRole (int r) {
    if (r == 10 || r == 29 || r == 30 || r == 41) {
        return true;
    }
    return false;
}

// 技能面板的【取消】：普通角色就是关掉面板；珀的发动 / 憋刀由前置询问处理。
void BOTC_SkillCancel (int p) {
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_boomKeepPick && p == 1) {
        BOTC_Notice(g_teller, "炸弹人必须选满三名保留玩家。");
        return;
    }
    if (g_limitedAsk[p]) {
        BOTC_LimitedDecline(p);
        return;
    }
    if (g_poAsk[p]) {
        BOTC_PoAskAnswer(p, false);
        return;
    }
    if (g_boffinRecipientPick) {
        g_boffinRecipientPick = false;
        if (g_boffinEditSource >= 2 && g_boffinEditSource <= 13) {
            g_boffinPendingBy[g_boffinEditSource] = 0;
        }
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_PmStore(g_teller, "【科学怪人】取消了这次能力接收者选择。");
        return;
    }
    r = BOTC_ActRoleOf(p);
    // 奥赫（134）由说书人选择补杀目标时，取消 = 这次不杀
    if (g_ojoAskSt && p == 1) {
        g_ojoAskSt = false;
        g_ojoFrom = 0;
        g_ojoRole = -1;
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【奥赫】说书人取消了这次补杀。");
        return;
    }
    // 每局限一次的角色：点【取消】就是「今晚不发动」，说书人那边要看得到（机会还在）
    //   【巡山人（77）】（用户 2026-10-04）：他也有这个按钮（BOTC_SkillRender 里 30/41/77 都显示【取消】），
    //   这里把他的那行也补上 —— 不然点取消时脚本什么都不写，说书人会以为机会用掉了。
    if (g_awake[p] && g_isNight) {
        if (r == 30 || r == 41 || r == 77) {
            BOTC_Notice(g_teller, "【" + BOTC_SeatRoleStr(p) + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
            BOTC_PmStore(g_teller, "【" + g_roleName[r] + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
        }
    }
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：点【取消】= 今晚一个都不杀
    if (g_hagKill && g_who[p] == g_teller) {
        g_hagKill = false;
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚一个都不杀。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔点【取消】= 放弃交换 → 撤掉「今晚理发」标记
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        BOTC_BarberDecline(p);
    }
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

// 天亮结算：只做「公开」----把昨晚记下的死亡亮出来（红叉 + 播报），再清掉只算一晚的状态
void BOTC_DawnResolve () {
    int q;
    int ob;
    // 【「死于今日」的移除时机】（用户 2026-09-20）：昨天留下的「死于今日 / 死于今日（僵怖）/ 死于今日（教父）」标记，
    //   一到第二天白天就清掉 ---- 放在整个天亮流程的**最前面**，免得后面处理夜间死亡时又混进新标记。
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 11]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 57]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 56]) {
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 11] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 57] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = false;     // 「死于今日（教父）」也一起清掉
    }
    // 天亮：间谍「看说书人魔典」的临时权限一起收掉
    BOTC_SpyPeekEnd();
    if (g_tokOn[(((g_teller * 14) + 62) * 256) + 92] || g_barberWait) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 92] = false;
        }
        if (g_barberSeat >= 2) {
            BOTC_PmStore(g_teller, "【理发师】昨晚没结算交换 → 这次机会作废，「今晚理发」标记收掉。");
        }
        g_barberSeat = 0;
        g_barberFrom = 0;
        g_barberWait = false;
    }
    // 【梦殒春宵】数学家 / 卖花女孩 / 城镇公告员 的当日标记：天亮清掉（用户 2026-09-21）
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 86] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 87] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 88] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 89] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 91] = false;      // 杂耍艺人的「干扰」标记也是当天的（用户 2026-09-21）
    }
    BOTC_GrimRender(g_teller);
    BOTC_PhiloDrunkSync();        // 天亮再同步一次（哲学家中毒/清醒的醉酒来回切）
    // 【哲学家】今天死了 → 他给的「醉酒（哲学家）」收掉（用户 2026-09-21：死亡那天在死亡结算前判不出来，所以天亮再兜一次）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        for (ob = 2; ob <= 13; ob += 1) {
            if (g_tokOn[(((g_teller * 14) + ob) * 256) + 90]) {
                g_tokOn[(((g_teller * 14) + ob) * 256) + 90] = false;
                BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(q) + " 已经死亡 → " + BOTC_NameStr(ob) + " 不再醉酒。");
            }
        }
    }
    // 僧侣的保护只维持一晚：天亮先把「保护」标记清掉
    if (g_nightMonk >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9]) {
            g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9] = false;
            BOTC_GrimRender(g_teller);
        }
    }
    // 旅店老板的「不会死亡」与驱魔人的「被点名」也只算昨晚（用户 2026-09-20）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 25]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 25] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 31]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 31] = false;
        }
    }
    g_exoBlock = 0;
    g_exoNight = 0;
    BOTC_GrimRender(g_teller);
    // 疯子（38）的「被选择」标记：天亮撤掉（跟百科一致）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 48]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 48] = false;
        }
    }
    // 【天亮：死亡 / 复活排队播报】（用户 2026-09-26）
    //   顺序：先复活（按座位号），再死亡（按座位号）；进白天 4 秒后播第一条，之后每 4 秒一条。
    //   每一条 = 红叉 + 左下角公屏 + 记录，都在同一瞬间（不再一次性全放出来）。
    g_dawnQN = 0;
    g_dawnQI = 0;
    // ① 挂着复活标记、但他本来就没死：只把标记悄悄撤掉（不播报）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
            BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 身上有「复活」标记但他没死，标记先撤掉。");
        }
    }
    // ② 排队：先复活（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 1;
        g_dawnQN = g_dawnQN + 1;
    }
    // ③ 再排队：昨晚的死亡（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_deadPending[q]) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 2;
        g_dawnQN = g_dawnQN + 1;
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：天亮重新算一次
    // 主谋（42）：加时那一天到了 ---- 这一天的处决决定胜负
    if (g_mmExtra && !g_mmArmed) {
        g_mmArmed = true;
        BOTC_PmStore(g_teller, "【主谋】加时的这一天开始了：今天被处决的人，他的阵营立刻落败。");
    }
    BOTC_FoolSync();              // 弄臣（34）：维护「首次未死 / 失去能力」标记
    // 月之子（36）：昨天那个「可以公开选人」的窗口到期（他今天要是又死了会重新开）
    for (q = 1; q <= 13; q += 1) {      // q 从 1 开始：说书人那一格也能声称（用户 2026-09-26）
        g_moonOpen[q] = false;
        g_moonDeclare[g_who[q]] = false;
        g_klutzDeclare[g_who[q]] = false;     // 呆瓜（63）：新的一天，死后声称的点头像阶段也清掉
    }
    // 造谣者（28）：新的一天，声明次数与内容都清掉（每天一次）
    g_gossipBy = 0;
    g_miSeat = 0;                  // 信息位答题框：换局把待发的那句清掉
    g_miRole = -1;
    g_gossipText = "";
    for (q = 1; q <= 13; q += 1) {      // 同上：说书人（q = 1）的每日声称次数也要跟着刷
        g_gossipDone[q] = false;
        g_gossipTextBy[q] = "";
        g_juggDone[q] = false;         // 杂耍艺人（58）：新的一天，又能公开猜一次（用户 2026-09-21）
        g_psyDone[q] = false;          // 精神病患者（84）：新的一天，又能声称一次
        g_cultDeclDone[q] = false;     // 异教领袖（106）：新的一天，又能声称一次（用户 2026-10-11）
    }

    BOTC_HdHide();

    // 【天亮播报队列】（用户 2026-09-26）：4 秒后播第一条；没东西要播就照旧立刻判胜负
    if (g_dawnQN > 0) {
        TimerStart(g_tDawn, 4.0, false, c_timeGame);
    }
    else {
        BOTC_CheckWin();
    }
    if (g_nightImp >= 2 && !BOTC_SeatDead(g_nightImp)) {
        BOTC_PmStore(g_teller, "【天亮】昨晚小恶魔那一刀没有造成死亡。");
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：昨晚死的人在这里被公开 → 他们的格子立刻换成【死后声称】
    BOTC_DeclareRender();
    // 新的一天：今天被处决过谁重新计数（送葬者问的就是「今天」被处决的人）
    for (q = 2; q <= 13; q += 1) {
        g_exec[q] = false;
    }
    BOTC_NightSkillReset();

}

// 天亮播报一条（kind：1 = 复活 / 2 = 死亡）---- 红叉 + 左下角公屏 + 记录，同一瞬间
void BOTC_DawnReveal (int q, int kind) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (kind == 1) {
        if (!BOTC_SeatDead(q)) {
            return;
        }
        BOTC_ClearDeath(q);
        // 【复活不再延迟】（用户 2026-09-26）：红叉当场撤（BOTC_ClearDeath 已经撤了）、fuhuo 当场响，不挂复活动画
        g_revFxCt[q] = 0;
        g_revFxSnd[q] = 0;
        BOTC_PlaySfx("fuhuo");
        BOTC_RestoreOneShot(q);
        g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
        for (ob = 1; ob <= 13; ob += 1) {
            BOTC_GrimRender(ob);
        }
        BOTC_PubAnnounce("【复活】" + BOTC_NameStr(q) + " 复活");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 复活 ----");
        BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 带着「复活」标记 → 自动复活。");
        BOTC_SailorSync();
        BOTC_TeaLadySync();
        return;
    }
    if (!g_deadPending[q]) {
        return;
    }
    g_deadPending[q] = false;
    if (BOTC_PublicDead(q)) {
        // 僵怖第一次假死已经公开过红叉；第二次真死仍要在天亮补一次死亡播报。
        if (!(BOTC_HasAbility(q, 43) && g_zombUsed[q] && !g_zombFake[q])) {
            return;
        }
    }
    g_deadShown[q] = true;
    BOTC_PlaySfx("Marine_Death");
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【死亡】昨晚，" + BOTC_NameStr(q) + " 死亡");
    BOTC_BansheeAnnounce(q);
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：昨晚 " + BOTC_NameStr(q) + " 死亡 ----");
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    if (g_zombFake[q]) {
        BOTC_PmStore(g_teller, "【僵怖】他其实没有死：全桌都看到他「死亡」，但他照常行动。");
    }
    BOTC_DeclareRender();
    BOTC_MoonChildCheck(q);
}

// 天亮队列：每 4 秒播一条；播完最后一条再判胜负
bool BOTC_DawnFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_dawnQN <= 0) {
        return true;
    }
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    BOTC_DawnReveal(g_dawnQ[g_dawnQI], g_dawnKind[g_dawnQI]);
    g_dawnQI = g_dawnQI + 1;
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    TimerStart(g_tDawn, 4.0, false, c_timeGame);
    return true;
}

// 黄昏（进入夜晚）时到期的状态：投毒者的毒只算一个夜晚 + 一个白天
// 把「当前这次投毒」收回来：中毒 token 去掉、记录清空。why 只用来写给说书人看的日志。
//   触发点：① 投毒者换目标（他自己点新目标时）② 黄昏到期 ③ 投毒者死亡 ④ 投毒者换了身份
void BOTC_PoisonClear (string why) {
    if (g_nightPoison >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightPoison) * 256) + 7]) {
            // 这里只管投毒者那份（7）；普卡的毒是 63 那一格，一直挂到普卡下一次行动，不跟黄昏清
            g_tokOn[(((g_teller * 14) + g_nightPoison) * 256) + 7] = false;
            BOTC_GrimRender(g_teller);
            BOTC_SailorSync();         // 中毒状态变了：水手的「不会死亡」标记跟着刷新
        }
    }
    g_nightPoison = 0;
    g_poisonFrom = 0;
    g_poisonDay = 0;
}

void BOTC_DuskResolve () {
    int q;
    BOTC_XaanPoisonClear("黄昏到期");
    // 首夜设置的毒必须完整保留一个白天；只有跨过一天后的黄昏才到期。
    if (g_nightPoison >= 2) {
        if (g_poisonDay < g_dayNum) {
            BOTC_PoisonClear("黄昏到期");
        }
        else {
            BOTC_PmStore(g_teller, "【投毒者】首夜的中毒仍在本日生效，等到下一个黄昏再清除。");
        }
    }
    BOTC_DrunkClear("黄昏到期");           // 醉酒也只算一个夜晚 + 一个白天（暂时）
    BOTC_HunDunClear();                    // 【混沌（121）】「全体善良中毒」只到下一个黄昏（用户 2026-10-16）
    // 吟游诗人（31）的全员醉酒：触发那一天**不清**，要撑到明天黄昏（用户 2026-09-20）
    if (g_minstrelDay > 0 && g_dayNum <= g_minstrelDay) {
        BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒要撑到明天黄昏 → 这一轮黄昏先不清。");
    }
    else {
        if (g_minstrelDay > 0) {
            BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒到点了 → 这一轮清掉。");
        }
        for (q = 2; q <= 13; q += 1) {
            g_minstrelDrunk[q] = false;
        }
        g_minstrelDay = 0;
    }
    // 处决免死（魔鬼代言人 / 和平主义者）只保「今天白天」那一次处决：到黄昏就清掉
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 24] || g_tokOn[(((g_teller * 14) + q) * 256) + 59] || g_tokOn[(((g_teller * 14) + q) * 256) + 60] || g_tokOn[(((g_teller * 14) + q) * 256) + 61] || g_tokOn[(((g_teller * 14) + q) * 256) + 62]) {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 53] || g_tokOn[(((g_teller * 14) + q) * 256) + 54] || g_tokOn[(((g_teller * 14) + q) * 256) + 55]) {
                // 侍臣的「三个夜晚 + 三个白天」还没到点：跳过（用户 2026-09-20）
            }
            else {
                if (g_minstrelDrunk[q]) {
                    // 这一份醉酒是吟游诗人的，还没到点：跳过（用户 2026-09-20）
                }
                else {
                    if (!BOTC_PhiloDrunkSelf(q)) {      // 【哲学家×酒鬼】（用户 2026-10-13）：他这份醉酒是他自己的身份，到黄昏也不清
                        g_tokOn[(((g_teller * 14) + q) * 256) + 24] = false;
                    }
                    g_tokOn[(((g_teller * 14) + q) * 256) + 59] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 60] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 61] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 62] = false;
                }
            }
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 27]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 27] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 28]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 28] = false;
        }
    }
    g_sailorDrunk = 0;            // 水手（23）那一份醉酒也是「到黄昏为止」，记录一起清
    BOTC_CourtierTick();          // 侍臣（29）：每个黄昏把醉酒 1 → 2 → 3 → 失去能力
    // 吟游诗人（31）的「全员醉酒」标记：到点才撤（还没到点的那些由上面的 g_minstrelDrunk 挡住）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 50]) {
            if (g_minstrelDrunk[q]) {
                // 还没到点：留着
            }
            else {
                g_tokOn[(((g_teller * 14) + q) * 256) + 50] = false;
            }
        }
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：黄昏重新算一次
    // 主谋（42）：加时这一天没人被处决 → 解除武装，按原本规则判（恶魔已死 → 善良胜）
    if (g_mmArmed && !g_gameOver) {
        g_mmArmed = false;
        g_mmDone = true;                 // 加时走完了（g_mmExtra 留着，免得又被判成「刚开始加时」）
        BOTC_PmStore(g_teller, "【主谋】加时这一天没人被处决 → 加时结束，按原本规则结算。");
        BOTC_CheckWin();
    }
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21）：黄昏重算常驻效果；涡流还要查「今天有没有人被处决」
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_VortoxDuskCheck();
    // 【利维坦（127）】放在所有黄昏标记清理 / 重算之后：第五天中毒 / 醉酒解除的那一刻才能正确判定。
    BOTC_LeviathanDuskCheck();
}

// 传位：把某个座位改成「死掉的那只恶魔」（说书人那份和他自己那份魔典一起改），并告诉他
// 【传位目标 q 是格子】（用户 2026-10-07）：给谁刷魔典要走 g_who[q]。
void BOTC_PromoteTo (int q) {
    int i;
    int idx;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    // 【变成同一只恶魔】（用户 2026-09-21）：以前固定改成小恶魔，现在看死掉的是哪一只
    if (g_demonKind < 21 || g_demonKind > 148 || BOTC_RoleTeam(g_demonKind) != 3) {
        g_demonKind = 21;
    }
    BOTC_SetSeatRole(g_teller, q, g_demonKind);
    BOTC_SetSeatRole(g_who[q], q, g_demonKind);
    // 【重要】这里**故意不清** g_pair* / g_pairV* 那套「观察者 × 座位」缓存：
    //   ① 还没看过他的中毒 / 酒鬼（共情者、占卜师等），之后第一次看他时按新身份算 ----
    //      「恶魔一定被看成善良」这条会照常生效；
    //   ② 已经把他看成邪恶的（中毒 / 酒鬼时判过），之后保持不变，不会被这次传位洗白。
    // 【诊断】把「传位前已经把他看成邪恶的中毒 / 酒鬼观察者」写一行，方便测试时核对
    s = "";
    for (i = 2; i <= 13; i += 1) {
        idx = (i * 14) + q;
        if (g_pairImp[idx] == 1) {
            if (g_pairVAlign[idx] == 1) {
                s = s + BOTC_NameStr(i) + " ";
            }
        }
    }
    if (s != "") {
        BOTC_DiagStore(g_teller, "【诊断传位】" + BOTC_NameStr(q) + " 变成恶魔，但这些人中毒 / 酒鬼时已经把他看成邪恶，之后不变：" + s);
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[q]);
    // 被改成小恶魔的玩家一定要收到通知：私聊一行 + 屏幕字幕 + 提示条，三种都给
    BOTC_ChangeRoleMsg(q, g_demonKind);
    // 智能说书：新恶魔诞生，重新抽 3 个不在场身份发给他
    BOTC_SkillBtnRender();
}

// 真正活着的人数（按说书人那份的死亡记录算：token 记的隐蔽死亡也算死）
int BOTC_AliveCountTrue () {
    int i;
    int q;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!BOTC_SeatDead(q)) {
            n = n + 1;
        }
    }
    return n;
}

// 红唇女郎（索引 19）被动：场上没有活着的恶魔时，如果**恶魔死之后还有 ≥4 人活着**，她直接变成新的恶魔
//   （官方原话是「恶魔死前有 5 人以上活着」，两种说法等价；用户 2026-09-19 明确按 ≥4 算）
//   谁杀的、怎么死的都不看，只看「恶魔身上有没有死亡 token」---- token 里记了恶魔死了就算数
//   （哪怕还没公开红叉给别的玩家看）；她自己也必须是「token 里还活着」的那个人；
//   她中毒 / 酒鬼时能力失效（本人不当场知道）；变身是悄悄进行的（只私聊新恶魔 + 写说书人日志）。
//   变身后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）。
//   返回值：true = 已经变身（调用方不要再走「说书人传位 / 智能随机」那套）。
//==================================================================================================
bool BOTC_ScarletCheck () {
    int i;
    int q;
    int sw;
    int alive;
    sw = 0;
    BOTC_BuildSeatList();
    // 【小怪宝局】（用户 2026-10-11）：这一局的「恶魔」是**照看小怪宝的那个人**（token 134 / g_lmSeat），
    //   他的真身其实是爪牙（只是被 token 当成 112）---- 所以：
    //   ① 照看人还活着 → 轮不到红唇（原来这里只扫真身 team 3，小怪宝局里永远扫不到，
    //      于是随便死个人她都可能变身）；
    //   ② 还没指定谁照看（g_lmSeat = 0）→ 也当「没有死掉的恶魔」，她不该变身。
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;
        }
        if (!BOTC_SeatDead(g_lmSeat)) {
            return false;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            return false;                 // 场上还有活着的恶魔：还轮不到红唇女郎
        }
        // 【按能力认人】（用户 2026-10-13）：原来写死「真身 = 19」----
        //   可这个能力可能是**借来的**（炼金术士 95 / 哲学家 56 / 食人族 74），他们的真身不是 19，
        //   于是「炼金术士借到红唇」永远顶不上位。BOTC_HasAbility 把这四种都算上。
        if (BOTC_AbilityWorks(q, 19)) {
            sw = q;
        }
    }
    if (sw < 2) {
        return false;                     // 场上没有活着的红唇女郎
    }
    // 人数门槛（用户 2026-09-19）：按「恶魔**死了之后**还活着几个人」算，≥4 就能顶
    alive = BOTC_AliveCountTrue();
    if (alive < 4) {
        BOTC_PmStore(g_teller, "【红唇女郎】恶魔已经死了，但场上只有 " + IntToString(alive) + " 人活着，她不能变身。");
        return false;
    }
    // 【相克 · 小怪宝 × 红唇女郎】（用户 2026-10-13 更正）：她**身份不变**，只是接手照看小怪宝 ----
    //   规则上她还是红唇女郎（魔典上那张牌该写「红唇女郎」），只是「**是恶魔（小怪宝）**」----
    //   所以这里**不动真身**，只把 token 134 挪到她身上、并把 g_lmSeat 指向她（照看人 = 现在的恶魔）。
    //   胜负那边靠 token 134 / g_lmSeat 判定，所以照样是「活着的新恶魔」，不会立刻判善良胜。
    //   （原来那版把她的真身改成了 112 小怪宝 ---- 牌面会写成「小怪宝」，跟规则不符。）
    if (g_lmOn) {
        for (i = 1; i <= 13; i += 1) {
            if (i == sw) { continue; }
            g_tokOn[(((g_teller * 14) + i) * 256) + 134] = false;
        }
        g_tokOn[(((g_teller * 14) + sw) * 256) + 134] = true;
        g_lmSeat = sw;
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[sw]);
        BOTC_PmInfo(g_who[sw], "【小怪宝】照看它的人已经死了 → 现在由你照看小怪宝（你的身份没变，还是红唇女郎）。");
        BOTC_PmStore(g_teller, "【红唇女郎】照看小怪宝的人已经死了、场上还有 " + IntToString(alive) + " 人活着 → 改由 " + BOTC_NameStr(sw) + " 照看小怪宝（她身份不变，牌面仍是红唇女郎，只是「是恶魔」）。");
        return true;
    }
    BOTC_PromoteTo(sw);
    // 【借能力上位的人要把「借用」痕迹清掉】（用户 2026-10-13）：炼金术士(95) 靠 token 123 + g_alcBorrow 记账，
    //   BOTC_SeatTrueRole 会按它读回 95（镇民）→ 胜负那边就看不到「活着的恶魔」了。
    //   （哲学家 70 / 食人族 97 的两枚由 BOTC_SetSeatRole 的离场清理收掉，这里只管炼金那两笔。）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 123] = false;
    g_alcBorrow = 0;
    // 继位之后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 13] = true;
    BOTC_GrimRender(g_teller);
    BOTC_Notice(g_teller, "红唇女郎规则：恶魔已死、场上还有 " + IntToString(alive) + " 人活着 ---- " + BOTC_NameStr(sw) + " 直接变成了新的恶魔。");
    return true;
}

//==================================================================================================
// 镇长（索引 12）：被恶魔攻击时可能由别人替他死（一次性被动）+ 特殊胜利；以及通用胜负检查
//==================================================================================================
// 该弹谁：善良方只比邪恶方多 0~2 人（邪恶方快追平）→ 弹活着的邪恶；否则弹善良，优先顺序：
//   ① 已经用掉限次技能（打了「失去能力」token）② 首夜信息位 / 外来者 ③ 其他镇民
int BOTC_MayorPick (int mayor) {
    int i;
    int q;
    int r;
    int good;
    int evil;
    int n;
    int pick;
    int n1;
    int n2;
    int n3;
    int p1;
    int p2;
    int p3;
    good = 0;
    evil = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            evil = evil + 1;
        }
        else {
            good = good + 1;
        }
    }
    // 邪恶方快追平：弹一个活着的邪恶
    if (good - evil <= 2) {
        n = 0;
        pick = 0;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == mayor || BOTC_SeatDead(q)) {
                continue;
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_RoleAlign(r) == 1) {
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = q;
                }
            }
        }
        return pick;
    }
    // 善良方领先：弹善良方（三个优先级各挑一个，最后按优先级取）
    n1 = 0;
    n2 = 0;
    n3 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 12] || g_tokOn[(((g_teller * 14) + q) * 256) + 17]) {
            n1 = n1 + 1;
            if (RandomInt(1, n1) == 1) {
                p1 = q;
            }
        }
        else {
            if (g_roleAct[r] == 5 || BOTC_RoleTeam(r) == 1) {
                n2 = n2 + 1;
                if (RandomInt(1, n2) == 1) {
                    p2 = q;
                }
            }
            else {
                n3 = n3 + 1;
                if (RandomInt(1, n3) == 1) {
                    p3 = q;
                }
            }
        }
    }
    if (p1 >= 2) {
        return p1;
    }
    if (p2 >= 2) {
        return p2;
    }
    return p3;
}

// 镇长被恶魔攻击：返回 true = 这次不按正常流程打死镇长（替死的人写在 g_mayorVictim，0 = 没人死）
//   智能说书：按 g_mayorBounceChance% 判定，成功就替死并给镇长打「失去能力」token（之后不再弹）；
//   手动说书：不自动弹，只把建议写给说书人，镇长这次不死，由他自己处理。
bool BOTC_MayorBounce (int mayor) {
    int pick;
    g_mayorVictim = 0;
    if (!g_started) {
        return false;
    }
    pick = BOTC_MayorPick(mayor);
    if (pick >= 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    else {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    return true;
    if (RandomInt(1, 100) > g_mayorBounceChance) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定没弹成，镇长自己死。");
        return false;
    }
    if (pick < 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，但场上没有能替他的人，镇长自己死。");
        return false;
    }
    g_mayorVictim = pick;
    g_tokOn[(((g_teller * 14) + mayor) * 256) + 18] = true;   // 一次性被动：内部记账（这一格不显示在面板 / 圆桌上）
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，" + BOTC_NameStr(pick) + " 替他死了。");
    return true;
}

//==================================================================================================
// 【镇长（12）手动拍板】（用户 2026-09-21）：恶魔那一刀现在是脚本自己打 token 的，
//   所以改成 ---- 一旦**即将**给镇长打上「夜间」死亡 token，就弹窗问说书人：
//     【是】→ 说书人在魔典上点一个座位，那个人替他死（镇长不死）；
//     【否】→ 镇长自己死（把挂起来的那次死亡补上）。
//   智能说书还是老样子：按 g_mayorBounceChance% 自动判定。
//==================================================================================================
bool BOTC_MayorCanAsk (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_started || g_gameOver) {
        return false;
    }
    if (g_mayorBusy || g_mayorAskOn || g_mayorPick) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 12)) {
        return false;                       // 中毒 / 酒鬼 → 能力失效
    }
    return true;
}

// 记下「等一下要补的那次死亡」，并决定是弹窗还是自动判定；返回 true = 这次死亡先别记
bool BOTC_MayorTakeOver (int q, int row, int byDemon, int srcRole, int src, bool tokPath, int tok) {
    if (!BOTC_MayorCanAsk(q)) {
        return false;
    }
    g_mayorAskQ = q;
    g_mayorAskRow = row;
    g_mayorAskByDemon = byDemon;
    g_mayorAskSrcRole = srcRole;
    g_mayorAskSrc = src;
    g_mayorUseTokPath = tokPath;
    g_mayorAskTok = tok;
    BOTC_MayorAskShow(q);
    g_mayorHold = true;
    return true;
}

// 记死亡那条通道（死亡 token 一打上就走这里）
bool BOTC_MayorInterceptRow (int q, int row, int tok) {
    if (row < 0 || row >= g_deathN) {
        return false;
    }
    if (g_deathKind[row] != 1) {
        return false;                       // 只拦「夜间」死因：处决 / 白天死的不算
    }
    return BOTC_MayorTakeOver(q, row, g_deathByDemon[row], -1, 0, false, tok);
}

// 说书人在 token 面板手动打死亡 token 那条通道
bool BOTC_MayorInterceptTok (int q, int t) {
    int k;
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            if (g_deathKind[k] != 1) {
                return false;
            }
            return BOTC_MayorTakeOver(q, k, g_deathByDemon[k], -1, 0, true, t);
        }
    }
    return false;
}

void BOTC_BuildMayorAsk () {
    // 【技能框往右挪 200】（用户 2026-09-23）：镇长弹刀那个框
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_mayorDlg = DialogLastCreated();
    DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    g_mayorTitle = BOTC_NewLabel(g_mayorDlg, 666, 44, 18, 13, StringToText("镇长夜里要死了：要不要让别人替他死？"));
    libNtve_gf_SetDialogItemStyle(g_mayorTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mayorTitle, false, PlayerGroupAll());
    g_mayorYes = BOTC_NewButton(g_mayorDlg, 306, 50, 27, 81, "是：我选一个人替他死");
    g_mayorNo = BOTC_NewButton(g_mayorDlg, 306, 50, 351, 81, "否：镇长自己死");
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
}

void BOTC_MayorAskShow (int q) {
    g_mayorAskOn = true;
    libNtve_gf_SetDialogItemText(g_mayorTitle, BOTC_PlayerNameText(q) + StringToText(" 夜里要死了：要不要让别人替他死？"), PlayerGroupSingle(g_teller));
    // 【换座位后的说书人也要有按钮】（用户 2026-10-18）
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_mayorDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "镇长夜里要死了：选【是】= 你点一个人替他死，选【否】= 镇长自己死。");
}

void BOTC_MayorAskHide () {
    g_mayorAskOn = false;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 换局 / 收摊：这一套状态清干净
void BOTC_MayorClear () {
    g_mayorAskOn = false;
    g_mayorPick = false;
    g_mayorBusy = false;
    g_mayorHold = false;
    g_mayorAskQ = 0;
    g_mayorAskRow = 0;
    g_mayorAskSrc = 0;
    g_mayorAskSrcRole = -1;
    g_mayorAskByDemon = 0;
    g_mayorUseTokPath = false;
    g_mayorAskTok = 0;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 把挂起来的那次死亡补上（回答【否】/ 放弃替死都走这里）
void BOTC_MayorResolveSelf () {
    int q;
    q = g_mayorAskQ;
    if (q < 2 || q > 13) {
        BOTC_MayorClear();
        return;
    }
    g_mayorBusy = true;
    if (g_mayorUseTokPath) {
        BOTC_SyncDeathFromTok(q, g_mayorAskTok);
    }
    else {
        BOTC_MarkDeathRowTok(q, g_mayorAskRow, g_mayorAskTok, false);
        if (g_mayorAskSrc >= 2) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(g_mayorAskSrc) + "（" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(g_mayorAskSrc)) + "）击杀。");
        }
        if (g_mayorAskByDemon != 0) {
            BOTC_NanaLinkCheck(q);
        }
    }
    g_mayorBusy = false;
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 说书人点了【是】/【否】
void BOTC_MayorAnswer (int ans) {
    if (!g_mayorAskOn) {
        return;
    }
    BOTC_MayorAskHide();
    if (ans == 0) {
        BOTC_MayorResolveSelf();
        return;
    }
    g_mayorPick = true;
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    if (g_deadPick) {
        g_deadPick = false;
        libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "选择一个玩家");
    BOTC_BigHintShow(1, "点一个座位：这个人替镇长死。");
}

// 说书人在魔典上点了座位：这个人替死
void BOTC_MayorVictimAt (int v) {
    int q;
    q = g_mayorAskQ;
    if (v < 2 || v > 13 || v == q || BOTC_SeatDead(v)) {
        BOTC_Notice(g_teller, "这个人不能替他死，换一个。");
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    g_mayorBusy = true;
    BOTC_MarkDeathRowTok(v, g_mayorAskRow, g_mayorAskTok, false);   // 替死：把**同一个**死亡 token 原样转移过去
    g_mayorBusy = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 18] = true;      // 一次性被动：用掉了
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(v) + " 替 " + BOTC_NameStr(q) + " 死了。");
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 点座位之前反悔（按【死亡标记】= 放弃这次替死，镇长照常死）
void BOTC_MayorCancel () {
    if (!g_mayorPick) {
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    BOTC_MayorResolveSelf();
}

// 通用胜负检查：每次有人死之后都可以调
//   善良胜：场上没有活着的恶魔；邪恶胜：场上只剩 2 人活着；
//   两条同时满足（比如剩 3 人时恶魔被处决）时判善良胜。
bool BOTC_AtheistOn () {
    return BOTC_AbilityInPlay(83);
}

void BOTC_CheckWin () {
    int i;
    int q;
    int r;
    int alive;
    int demonAlive;
    int demonSeat;                 // 已经死掉的那只恶魔坐在哪（0 = 没有）
    bool mmAlive;                  // 主谋是不是活着且清醒
    if (g_gameOver || !g_started) {
        return;
    }
    // 【哥布林(99) 兜底判胜】（用户 2026-10-23 更正）：
    //   必须明确记录为「处决」（g_deadKind == 3）才能触发。
    //   用【死亡标记】打红叉，或其它死亡 token，都不算处决，不得触发哥布林胜利。
    if (g_goblinDecl >= 2 && g_goblinDeclDay == g_nightNum && BOTC_SeatDead(g_goblinDecl) && g_deadKind[g_goblinDecl] == 3) {
        if (BOTC_AbilityWorks(g_goblinDecl, 99)) {
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(g_goblinDecl)) == 3) {
                BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
                return;
            }
            BOTC_ShowWin(BOTC_SeatAlign(g_goblinDecl), "哥布林" + BOTC_NameStr(g_goblinDecl) + "亮出了他的真身，", "他的阵营就此得逞。");
            return;
        }
    }
    // 【天亮排队播报还没走完】（用户 2026-09-26）：先不判胜负，等最后一条播完再判
    if (g_dawnQN > 0) {
        return;
    }
    // 【主谋加时期间不判胜负】（用户 2026-09-20）：恶魔被处决之后要打完「加时的一夜 + 一天」，
    //   这段时间唯一的胜负来源是：
    //     ① 加时那一天的处决（`BOTC_ExecToggleAt` 里按真身阵营立刻判负）；
    //     ② 加时那一天没人被处决 → 那个黄昏由 `BOTC_DuskResolve` 收掉加时、再来判（恶魔已死 → 善良胜）。
    //   所以这里直接返回，免得「天一亮」就按「没有活着的恶魔」把善良判胜了。
    if (g_mmExtra && !g_mmDone) {
        return;
    }
    // 【镜像双子（64）】（用户 2026-09-21）：两个双子都活着 → 善良阵营此刻不能获胜（先把双子解决掉）
    if (BOTC_TwinBlocksGood()) {
        BOTC_PmStore(g_teller, "【镜像双子】两只双子都还活着 → 善良阵营现在不能获胜。");
        return;
    }
    demonAlive = 0;
    demonSeat = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        // 【判胜负看「确定死亡」= 红叉 + 真的死了】（用户 2026-09-20）----
        //   夜里刚记下的死亡（只有 token、还没到天亮盖红叉）**不算**：等天亮统一结算
        //   （死亡 token 自动打红叉 / 复活 token 自动复活）之后再来判胜负；
        //   僵怖那种「盖了红叉但其实还活着」的座位也不算死。
        if (BOTC_SettledDead(q)) {
            if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == 3) {
                demonSeat = q;          // 已经公开死亡的恶魔（用来判断「是不是死于处决」）
            }
            continue;
        }
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 3) {
            demonAlive = demonAlive + 1;
        }
    }
    // ⓪ 主谋（42）：**恶魔死于处决**、而且主谋还活着且清醒 → 不结算胜负，改打「加时一夜 + 一天」。
    //   ⚠ 用户 2026-09-20 的口径：只有「死于处决」才给加时 ---- 夜里被刀 / 造谣者 / 月之子 / 赌徒
    //     这类死法照常结算（善良胜），主谋不管用。
    if (demonAlive == 0 && !g_mmExtra) {
        mmAlive = false;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (!BOTC_AbilityWorks(q, 42)) {
                continue;
            }
            if (BOTC_SeatDead(q)) {
                continue;
            }
            mmAlive = true;
        }
        if (demonSeat >= 2 && g_deadKind[demonSeat] == 3 && mmAlive) {
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                if (!BOTC_AbilityWorks(q, 42)) {
                    continue;
                }
                if (BOTC_SeatDead(q)) {
                    continue;
                }
                g_mmExtra = true;
                g_mmArmed = false;
                BOTC_PmStore(g_teller, "【主谋】恶魔（" + BOTC_NameStr(demonSeat) + "）死于处决，而主谋（" + BOTC_NameStr(q) + "）还活着 → 进入加时：再打一夜 + 一天；这一天的处决决定胜负。");
                return;
            }
        }
    }
    // 【小怪宝（112）】（用户 2026-10-10）：抽到他的那一局**没有**「真身是恶魔」的角色 ----
    //   恶魔 = 被说书人打上「是恶魔（小怪宝）」的那个人（g_lmSeat）。他一旦「确定死亡」→ 善良胜。
    //   还没指定谁照看（开局那一会儿 g_lmSeat = 0）就先不判，免得一开局就判善良胜。
    if (g_lmOn) {
        // 小怪宝局：照看人（= 现在的恶魔）一死就判善良胜；没别的「恶魔」可杀
        if (g_lmSeat >= 2 && BOTC_SettledDead(g_lmSeat)) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    else {
        // ① 场上没有活着的恶魔 → 善良胜（哪怕这时也只剩 2 人，两条同时满足还是判善良）
        if (demonAlive == 0 && !BOTC_AtheistOn()) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    // ③ 场上只剩 2 人活着（恶魔还活着）→ 邪恶胜
    //   ⚠ 人数也按**公开死亡（红叉）**算：夜里刚死、还没到天亮的先不算 ----
    //     这样「今晚杀人 + 反刍复活」会在天亮一起结算完再判，不会因为说书人还没来得及复活就先判负。
    alive = 0;
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SettledDead(g_seatList[i])) {
            alive = alive + 1;
        }
    }
    if (alive <= 2) {
        // 【无神论者的特殊胜利】（用户 2026-09-26）：真身无神论者在场 + 只剩 2 人活着（说书人没被处决）→ 说书人胜
        if (BOTC_AtheistOn()) {
            BOTC_ShowWin(2, "只剩 " + IntToString(alive) + " 名玩家存活，说书人没有被处决", "");
            return;
        }
        BOTC_ShowWin(1, "恶魔骗过了镇民，", "屠戮了整个小镇。");
    }
}

// 镇长的特殊胜利：黄昏（进夜晚）时只剩 3 个人活着、且今天没有处决过人 → 他的阵营获胜
void BOTC_CheckMayorWin () {
    int i;
    int q;
    int mayor;
    if (g_gameOver || !g_started) {
        return;
    }
    mayor = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_AbilityWorks(q, 12)) {
            mayor = q;
        }
    }
    if (mayor < 2) {
        return;
    }
    if (g_execUsedToday) {
        return;                        // 今天处决过人
    }
    if (BOTC_AliveCountTrue() == 3) {
        BOTC_ShowWin(BOTC_SeatAlign(mayor), "伟大的镇长" + BOTC_NameStr(mayor) + "建了一堵高墙，", "将所有恶魔驱逐出境！");
    }
}

// 胜负横幅：只弹自定义画面（不动游戏自带结束按钮），说书人点【继续】收掉，然后可以开下一把
//   以后想换成图片：把 g_winBg 的贴图按 g_winSide 设成 botc_win_good.dds / botc_win_evil.dds 即可
// 【异端分子(101)】（用户 2026-10-04）：场上有没有**生效的**异端分子。
//   口径（用户两次强调）：**醉酒 / 中毒 → 失去能力、不对调**；**死亡 → 不会失去能力、照样对调**。
//   BOTC_SeatImpaired = 醉酒 OR 中毒（包含了「哲学家让人醉」「心上人醉酒」那几份），
//   里面**没有任何**「死了就算失能」的判断 —— 所以这里直接用它就是对的口径。
//   ⚠ 以后别往这里加 BOTC_SeatDead：那会把「死后仍然生效」这条弄没（用户明确要求保留）。
//   （用 BOTC_HasAbility 判，所以「哲学家借到异端分子 / 食人族吃掉异端分子 / 炼金术士借到」也算。）
bool BOTC_HereticOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_AbilityWorks(i, 101)) {
            return true;
        }
    }
    return false;
}

// 【善良的胜利条件现在成立吗】（用户 2026-10-10）：场上没有活着的恶魔
//   小怪宝那一局：恶魔恒等于「照看他的那个人」→ 看他死没死
//   判定口径跟 BOTC_CheckWin 一致：用 BOTC_SettledDead（红叉 + 真的死了），夜里刚记的死亡不算
// 【这一格现在算不算「恶魔」】（用户 2026-10-11）：处决 / 死亡结算里判「一个事件同时达成两边」用
//   · 真身阵营是恶魔（team 3）→ 算；
//   · 小怪宝那一局：照看他的人就是恶魔 —— 他死后那枚 token 会被离场清理收掉，
//     真身会变回他原来的爪牙角色，所以这里用 g_lmSeat 兜住。
bool BOTC_IsDemonSeat (int q) {
    int r;
    if (q < 1 || q > 13) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == 3) {
        return true;
    }
    if (g_lmOn && q == g_lmSeat) {
        return true;
    }
    return false;
}
bool BOTC_GoodWinNow () {
    int i;
    int q;
    int r;
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;              // 还没指定谁照看 → 先不算善良达成
        }
        return BOTC_SettledDead(g_lmSeat);
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SettledDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == 3) {
            return false;
        }
    }
    return true;
}

void BOTC_WinAdminRender () {
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupAll(), false);
    if (!g_started || g_isNight || g_gameOver) {
        g_winPanelOn = false;
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupSingle(g_teller), true);
    if (!g_winPanelOn) {
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    if (g_winLocked) {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("√ 锁定"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("锁定"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_winAdminDlg, PlayerGroupSingle(g_teller), true);
}

bool BOTC_WinAdminClick (int p, int c) {
    if (p != g_teller) {
        return false;
    }
    if (c == g_winAdminBtn) {
        g_winPanelOn = !g_winPanelOn;
        BOTC_WinAdminRender();
        return true;
    }
    if (!g_winPanelOn) {
        return false;
    }
    if (c == g_winAdminClose) {
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    if (c == g_winAdminLockBtn) {
        g_winLocked = !g_winLocked;
        BOTC_WinAdminRender();
        if (g_winLocked) {
            BOTC_NoticeKeep(g_teller, "【胜负】已锁定：所有玩家暂时无法获胜。");
        }
        else {
            BOTC_NoticeKeep(g_teller, "【胜负】已解除锁定。");
        }
        return true;
    }
    if (c == g_winAdminGoodBtn || c == g_winAdminEvilBtn) {
        if (g_winLocked) {
            BOTC_Notice(g_teller, "胜负状态已锁定：先点【解锁】才能结算。");
            return true;
        }
        g_manualWin = true;
        if (c == g_winAdminGoodBtn) {
            BOTC_ShowWin(0, "说书人手动宣布善良阵营胜利。", "");
        }
        else {
            BOTC_ShowWin(1, "说书人手动宣布邪恶阵营胜利。", "");
        }
        g_manualWin = false;
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    return false;
}

void BOTC_ShowWin (int side, string why1, string why2) {
    if (g_gameOver) {
        return;
    }
    if (!g_started) {
        return;
    }
    if (g_winLocked) {
        BOTC_PmStore(g_teller, "【胜负】当前处于锁定状态，本次胜利被阻止。");
        return;
    }
    // 【双方同时达成胜利条件 → 优先善良胜】（用户 2026-10-10）：全图胜负只有这一个出口，所以规则挂在这里 ——
    //   只要这一次判的不是善良胜，而此刻**善良的胜利条件也成立**（场上没有活着的恶魔；
    //   小怪宝那局 = 照看他的人已死），一律改判**善良胜**。
    //   例：善良的圣徒正带着小怪宝被处决（圣徒规则说善良落败 + 恶魔死亡说善良获胜）→ 判善良胜。
    //   ⚠ **只认「最近一次死亡正好是恶魔」**（`g_lastDeadSeat` + `BOTC_IsDemonSeat`）：
    //     只有「这一下死的是恶魔」才叫同时达成；跟死亡无关的胜利（教派投票 / 只剩 2 人 / 镇长 / 主谋…）
    //     一律不许被这条改写。
    //     （原来用「处决结算中」那个标记会被处决函数里的早退 `return` 漏掉，标记一直留着，
    //       把后面的教派投票也抢成善良胜 —— 用户 2026-10-11 报的就是这个。）
    //   ⚠ 无神论者那局（本来就没有恶魔）不套这条，免得把「说书人胜」也盖掉。
    //   ⚠ **还要再确认「场上真的没有别的恶魔活着」**（用户 2026-10-13 报的方古 BUG）：
    //     方古那一刀是「老方古死 + 外来者当场变成新方古」，最近死的确实是恶魔，可新方古还活着
    //     → 这时候判邪恶胜（只剩 2 人）是对的，**不能**被这条改写成善良胜。
    //     所以再加一道 `BOTC_GoodWinNow()`（= 场上没有活着的恶魔；小怪宝那局 = 照看人已死）。
    if (!g_manualWin && side != 0 && !BOTC_AtheistOn() && BOTC_GoodWinNow() && g_lastDeadSeat >= 2 && g_lastDeadSeat <= 13 && BOTC_SeatDead(g_lastDeadSeat) && BOTC_IsDemonSeat(g_lastDeadSeat)) {
        side = 0;
        why1 = "镇民们找出并处决了所有恶魔！";
        why2 = "";
        BOTC_PmStore(g_teller, "【胜负】双方同时达成胜利条件 → 按规则优先判**善良胜**。");
    }
    // 【异端分子(101)】（用户 2026-10-04）：官方口径 —— 有生效的异端分子 → **胜负对调**（死后仍然生效）。
    //   放在 BOTC_ShowWin 里 = **所有阵营胜负自动全覆盖**（用户 2026-10-04 明确要求「特殊胜利也要」）：
    //     恶魔全灭 / 只剩 2 人 / 镇长 / 圣徒 / 镜像双子 / 哥布林 / 恐惧之灵 / 主谋加时两个分支 /
    //     无神论者被处决 / 处决说书人 …… 全图只有这一个出口，所以都是在同一处对调。
    //   ⚠ 没有例外（用户 2026-10-04 定稿「异端分子会反转所有胜负」）：
    //     连「说书人胜」（side 2 = 无神论者那条「只剩两人存活且说书人没被处决」）也一起反转，
    //     说书人那一侧是对局里的「邪恶」方 → 反转后记成**善良胜**（side 0）。
    //   ⚠ 多个异端分子能力不做叠加（对调一次就是最终结果）。
    if (!g_manualWin && BOTC_HereticOn()) {
        if (side == 0) {
            side = 1;
        }
        else {
            side = 0;
        }
        // 结局文案要**明说**被改写过：不然原来那句（例如「哥布林…他的阵营就此得逞」、
        // 「神之使徒…」这类按「谁赢」写死的话）会跟真实结果自相矛盾。
        why1 = "【异端分子】在场，结局已被改写——" + why1;
        why2 = why2 + "（异端分子在场：胜负结果已被对调）";
        BOTC_PmStore(g_teller, "【异端分子】能力生效 → 这次胜负对调。");
    }

    g_gameOver = true;
    // 【场次统计】（用户 2026-10-20）：唯一胜负出口只记一次；此时阵营 / 说书人座位都已经确定。
    BOTC_StatsRecord();
    // 【胜负那一刻也清投票状态】（用户 2026-10-10）：白天可能正停在提名 / 投票中间就分出了胜负 ——
    //   跟入夜用的是同一个 BOTC_NomReset()：已投 / 弃权 / 票数 / 待处决 / 提名记录全清，
    //   并退出提名阶段（免得胜负面板后面还挂着上一轮的投票标记）。
    BOTC_NomReset();
    g_cultOn = false;          // 【教派投票】：胜负已定就把这一轮投票收掉
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    g_winSide = side;
    g_winChat1 = why1;
    g_winChat2 = why2;
    if (StringLength(why2) > 0) {
        g_winReason = why1 + "\n" + why2;
    }
    else {
        g_winReason = why1;
    }
    g_winStage = true;
    BOTC_MusicStop();
    BOTC_PlaySfxTimed(g_sfxJieSuanName, 2.0);
    BOTC_EndNoticeShow();
    TimerStart(g_tWinStage, 5.0, false, c_timeGame);
}

// 胜利该放哪一首（善良胜 + 存活 ≤ 3 → 第二首；邪恶胜 → 那首邪恶曲）
string BOTC_WinTrackName () {
    if (g_winSide == 1) {
        return g_musicEvilName;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        return g_musicGood2Name;
    }
    return g_musicGood1Name;
}

// 2 秒过场结束：弹胜利面板 + 播胜利曲
bool BOTC_WinStageFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_winStage) {
        return true;
    }
    g_winStage = false;
    BOTC_EndNoticeHide();          // 字幕收掉，换成胜利面板
    BOTC_ShowWinNow();
    BOTC_MusicPlay(BOTC_WinTrackName(), 6, 0.0);   // 优先级 6：比准备阶段（4）还高，谁都盖不掉
    return true;
}

//--------------------------------------------------------------------------------------------------
// 结算过场：屏幕正中那句「游戏结束，我们得到的结果是：」
//   放 jiesuan 音效的时候弹出来，一直留到胜利面板弹出 ---- 所以它有自己的一套显隐，
//   不走 BOTC_BigNotice 那个「3.5 秒自动收起」。
//--------------------------------------------------------------------------------------------------

// 跟 BOTC_NewLabelC 一样，但创建标签最后那个固定值（2.0）能自己给 ---- 用聊天指令 wbig 试它是不是字号倍率
int BOTC_NewLabelCY (int d, int w, int h, int x, int y, text t, fixed f) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, f);
    return DialogControlLastCreated();
}

void BOTC_EndNoticeMake () {
    if (g_endDlg != 0) {
        DialogDestroy(g_endDlg);       // 用 wbig 调参数时重建：先把旧的拆掉，免得叠层
        g_endDlg = 0;
    }
    DialogCreate(900, 120, c_anchorCenter, 0, 0, false);
    g_endDlg = DialogLastCreated();
    DialogSetImageVisible(g_endDlg, false);
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
    // 文字在标签里是**左对齐**的，居中得靠自己补偏移：这句 13 个字大概 390 宽，
    //   所以左边缘放在「中间往左 195」= 对话框内 x 255。嫌偏左偏右就改这个 255。
    g_endLbl = BOTC_NewLabelCY(g_endDlg, 880, 120, 255, 0, TextWithColor(StringToText("游戏结束，我们得到的结果是："), Color(255, 215, 60)), g_endSize);
    libNtve_gf_SetDialogItemStyle(g_endLbl, g_endStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_endLbl, false, PlayerGroupAll());
}

void BOTC_BuildEndNotice () {
    BOTC_EndNoticeMake();
}

void BOTC_EndNoticeShow () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), true);
}

void BOTC_EndNoticeHide () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
}

// 真正弹面板（原来的 BOTC_ShowWin 内容）
void BOTC_ShowWinNow () {
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_winLabel, StringToText("特殊胜利"), PlayerGroupAll());
        BOTC_PubAnnounce("【胜负】特殊胜利 ---- 说书人获胜：" + g_winChat1);
        if (StringLength(g_winChat2) > 0) {
            BOTC_PubAnnounce(g_winChat2);
        }
    }
    else {
        if (g_winSide == 1) {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("邪恶阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】邪恶阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
        else {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("善良阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】善良阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
    }
    // 分胜负了：邪恶小窗也一起关掉（免得盖在结算面板上）
    BOTC_EvilClose();
    libNtve_gf_SetDialogItemText(g_winSub, BOTC_NameSubst(g_winReason), PlayerGroupAll());   // 结算面板的正文：名字换成真名
    DialogSetVisible(g_winDlg, PlayerGroupAll(), true);
    // 【换座位后的说书人也要能点】（用户 2026-10-18）：继续 / 复盘按钮按「现在的」说书人露出来
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_winBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_replayBtn, PlayerGroupSingle(g_teller), true);
    // 胜利面板上面那条「恭喜...获胜」（名字带各自的颜色）
    //   【2026-09-16 用户要求】要的是「去掉对话框（黑框）、信息留住」---- 所以这里照常显示，
    //   黑底在 BOTC_BuildWinCongrats() 里已经关掉了（那两行注释）。
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsStText(), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsText(), PlayerGroupAll());
    }
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), true);
    // 【智能说书】游戏一结束就把真魔典摊给全场（= 用户说的「智能说书会自动发送魔典」）：
    //   这样首夜信息位那些 token（洗衣妇 / 图管 / 调查员）在复盘里也看得到。
    //   真人说书的模式不自动摊 ---- 那边由说书人自己点【复盘（公开魔典）】。
}

void BOTC_BuildWin () {
    DialogCreate(660, 250, c_anchorCenter, 150, 0, false);
    g_winDlg = DialogLastCreated();
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】胜利面板不要底图：对话框自带的那层默认面板图也关掉，
    //   只留文字 + 复盘 / 继续两个按钮（黑图那层早就在下面 g_winBg 处隐藏了）
    DialogSetImageVisible(g_winDlg, false);
    libNtve_gf_CreateDialogItemImage(g_winDlg, 660, 250, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_winBg = DialogControlLastCreated();
    DialogControlSetPosition(g_winBg, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    libNtve_gf_SetDialogItemAcceptMouse(g_winBg, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_winBg, "botc_black.dds", PlayerGroupAll());
    // 【2026-09-16 用户要求】胜利面板先不要黑底：底图控件直接藏掉
    //   ⚠ 不能只是「不设贴图」---- 没贴图的图片控件会被星际画成占位蓝块，所以是「设了贴图再隐藏」
    DialogControlSetVisible(g_winBg, PlayerGroupAll(), false);
    g_winLabel = BOTC_NewLabelC(g_winDlg, 640, 60, 85, 55, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_winLabel, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winLabel, false, PlayerGroupAll());
g_winSub = BOTC_NewLabelC(g_winDlg, 1160, 64, 10, 118, StringToText(""));
libNtve_gf_SetDialogItemStyle(g_winSub, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winSub, false, PlayerGroupAll());
    g_winBtn = BOTC_NewButton(g_winDlg, 260, 40, 200, 180, "继续");
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    // 【复盘】说书人专用：把自己的魔典（含 token）替换给全场
    g_replayBtn = BOTC_NewButton(g_winDlg, 240, 40, 80, 180, "复盘（公开魔典）");
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetPosition(g_winBtn, PlayerGroupAll(), c_anchorTopLeft, 340, 180);
}

// 胜利面板上面那条「恭喜...获胜」：单独一个对话框，放在胜利面板正上方
//   名字用每个玩家自己的颜色，字体跟「提名开始」那 4 个字一样大
void BOTC_BuildWinCongrats () {
    DialogCreate(1100, 76, c_anchorCenter, 150, -186, false);
    g_congratsDlg = DialogLastCreated();
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条也不要底图（对话框自带的默认面板图）
    DialogSetImageVisible(g_congratsDlg, false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条先不要黑底（想恢复就把下面两行放开）
    //   原来注释：给这条恭喜也铺一块黑底（跟胜利面板同款），不然文字直接压在草地上看不清
    // DialogSetImage(g_congratsDlg, "botc_black.dds");
    // DialogSetImageVisible(g_congratsDlg, true);
    g_congratsLbl = BOTC_NewLabelC(g_congratsDlg, 1080, 76, 10, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_congratsLbl, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_congratsLbl, false, PlayerGroupAll());
}

// 拼「恭喜 玩家1、玩家2 获胜」----赢的那一方（g_winSide：0 = 善良 / 1 = 邪恶）
//   每个名字用他自己的玩家颜色
text BOTC_CongratsText () {
    int i;
    int q;
    text t;
    bool first;
    t = StringToText("恭喜 ");
    first = true;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        // 【按阵营算，不按身份】（用户 2026-09-20）：默认镇民 / 外来 = 善良、爪牙 / 恶魔 = 邪恶，
        //   但身上打了「善良(14) / 邪恶(15)」token 的座位按那个 token 算（莽夫转阵营就靠这个）。
        if (BOTC_WinAlignOf(q) != g_winSide) {
            continue;
        }
        if (!first) {
            t = t + StringToText("、");
        }
        t = t + BOTC_PlayerNameText(q);
        first = false;
    }
    if (first) {
        return StringToText("本局结束");
    }
    return t + StringToText(" 获胜");
}

// 【特殊胜利】（无神论者在场 + 只剩 2 人活着）：「恭喜…」那行只写说书人的名字
text BOTC_CongratsStText () {
    return StringToText("恭喜 ") + BOTC_PlayerNameText(1) + StringToText(" 获胜");
}

// 复盘：把说书人那份魔典（身份 + 全部 token）复制给每个玩家自己那份，并摊开给全场看
void BOTC_ReplayReveal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        ob = g_who[q];
        for (t = 2; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = g_mark[(g_teller * 14) + t];
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = g_tokOn[(((g_teller * 14) + t) * 256) + k];
            }
        }
    }
    g_replayOn = true;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    BOTC_PubAnnounce("【复盘】说书人把真实魔典（身份 + token）公开给全场。");
}

// 把每个玩家的魔典恢复成「只看得到自己座位身份、没有任何 token」的正常状态
//   （说书人点【取消正式开始】时用，把复盘清掉）
void BOTC_GrimResetPerPlayer () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        ob = g_who[q];
        for (t = 2; t <= 13; t += 1) {
            if (t == q) {
                g_mark[(ob * 14) + t] = BOTC_PlayerRoleView(t, g_mark[(g_teller * 14) + t] - 1) + 1;   // 自己那份只留可见身份
            }
            else {
                g_mark[(ob * 14) + t] = 0;
            }
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
    }
    g_replayOn = false;
    for (ob = 1; ob <= 13; ob += 1) {
        g_grimSnapOn[ob] = false;
        BOTC_GrimRender(ob);
    }
}

void BOTC_WinClose () {
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);   // 上面那条「恭喜...」一起收掉
    g_gameOver = false;
    // ⚠ 这里**不**停胜利曲：面板收掉之后胜利 BGM 还要一直放着，
    //   直到说书人点【取消正式开始】（那一步会 BOTC_MusicStop）。
}

//==================================================================================================
// 传位面板：恶魔死了之后，说书人点一名活着的爪牙，让他变成新的小恶魔
//   （智能说书模式不弹这个面板，直接随机挑一名；面板是纯自定义界面，跟游戏自带结束按钮无关）
//==================================================================================================
void BOTC_BuildPromote () {
    int i;
    DialogCreate(378, 288, c_anchorRight, 338, -70, false);
    g_promDlg = DialogLastCreated();
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
    g_promTitle = BOTC_NewLabelC(g_promDlg, 360, 30, 9, 7, StringToText("恶魔死了：点一名爪牙接位"));
    libNtve_gf_SetDialogItemStyle(g_promTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_promTitle, false, PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        g_promBtn[i] = BOTC_NewButton(g_promDlg, 162, 31, 18 + ((i % 2) * 180), 41 + ((i / 2) * 34), "");
        DialogControlSetVisible(g_promBtn[i], PlayerGroupAll(), false);
        g_promSeat[i] = 0;
    }
    g_promClose = BOTC_NewButton(g_promDlg, 198, 31, 90, 248, "取消（我自己处理）");
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
}

void BOTC_PromoteOpen () {
    int i;
    int q;
    int n;
    if (g_gameOver || !g_started) {
        return;
    }
    for (i = 0; i < 12; i += 1) {
        DialogControlSetVisible(g_promBtn[i], PlayerGroupSingle(g_teller), false);
        g_promSeat[i] = 0;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!BOTC_SeatIsMinion(q)) {
            continue;
        }
        libNtve_gf_SetDialogItemText(g_promBtn[n], BOTC_PlayerNameText(q) + StringToText("（" + BOTC_SeatRoleStr(q) + "）"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_promBtn[n], PlayerGroupSingle(g_teller), true);
        g_promSeat[n] = q;
        n = n + 1;
        if (n >= 12) {
            break;
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "场上没有活着的爪牙，没人能接位。");
        return;
    }
    // 【换座位后的说书人也要有关闭键】（用户 2026-10-18）
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
    DialogControlSetVisible(g_promClose, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_promDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_PromoteHide () {
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
}

// 小恶魔自刀之后的传位：智能说书随机挑一名活着的爪牙；手动说书只解锁身份编辑，说书人自己点
// 小恶魔自刀之后的传位：返回 true = 有人接了位子（游戏继续，不算善良胜）
bool BOTC_ImpPromote () {
    int i;
    int q;
    int n;
    int pick;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                n = n + 1;
            }
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "小恶魔自刀死了，场上没有活着的爪牙，邪恶方没人可传。");
        BOTC_PmStore(g_teller, "【天亮】小恶魔自刀死了，场上没有活着的爪牙。");
        return false;         // 没人接位：交给调用方按胜负条件判（没有恶魔 → 善良胜）
    }
    // 手动说书：弹传位面板，说书人点一名爪牙接位（身份面板也顺手解锁，兜底用）
    g_promoteOpen = true;
    BOTC_PromoteOpen();
    BOTC_PmStore(g_teller, "【传位】等说书人传位。活着的爪牙：" + BOTC_MinionListStr());
    return true;              // 等说书人接位，这局先不算结束
}

//==================================================================================================
// 占卜师（Fortune Teller）：每晚选两名玩家，说书人回答「有 / 没有」恶魔
//   干扰项也算恶魔；间谍 / 陌客按各自的登记算；中毒 / 酒鬼的占卜师会收到相反答案（大概率）
//   信息统一由 1 号（智能说书）通过私聊发给本人
//==================================================================================================

// 占卜师点了座位：选满两个人就出结果
void BOTC_FtPick (int p, int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_ftPick[p]) {
        return;
    }
    if (g_ftFirst[p] == 0) {
        g_ftFirst[p] = q;
        BOTC_Notice(p, "已选 " + BOTC_NameStr(q) + "，再点第二位玩家。");
        return;
    }
    if (q == g_ftFirst[p]) {
        BOTC_Notice(p, "两个人不能是同一个，换一个。");
        return;
    }
    BOTC_FtAnswer(p, g_ftFirst[p], q);
    g_ftPick[p] = false;
    g_ftFirst[p] = 0;
}

//==================================================================================================
// 【酒鬼 / 中毒的占卜师专用】看不见的「假干扰项」
//   占卜师中毒 → 1 个假干扰项；占卜师是酒鬼 → 2 个（放在 2 个非恶魔玩家身上，其中一个也可能是爪牙）。
//   持有者大概率是「被动触发 / 大信息位」（守鸦人、士兵、共情者、镇长、圣徒），
//   极小概率落在首夜信息位（洗衣妇 / 图管 / 调查员 / 厨师），其余角色是中概率。
//   占卜师验到假干扰项的持有者，一律报「有恶魔」，不吃那 70% 的看反概率。
//   只给智能说书判定用：没有界面、不占 g_tokOn；占卜师死了或者中毒解除就移除。
//==================================================================================================

// 这个身份当假干扰项「有多合适」（权重；<= 0 = 不给这个身份）
int BOTC_FtFakeWeight (int r) {
    if (r < 0 || r > 148) {
        return 0;
    }
    if (r == 8 || r == 11 || r == 4 || r == 12 || r == 15) {
        return 12;                     // 共情者 / 守鸦人 / 士兵 / 镇长 / 陌客：最适合
    }
    if (r == 0 || r == 1 || r == 2 || r == 3) {
        return 1;                      // 首夜信息位：极小概率
    }
    return 4;                          // 其他角色：中概率
}

// 在「可以当假干扰项」的座位里按权重抽一个
//   mode：0 = 只要善良 / 1 = 只要爪牙 / 2 = 善良或爪牙都行
//   allowChecked = false 时跳过占卜师已经验过的座位（免得他验过「没恶魔」之后又变成有恶魔）
int BOTC_FtFakePickSeat (int ft, int mode, bool allowChecked) {
    int i;
    int q;
    int r;
    int w;
    int wsum;
    int pick;
    pick = 0;
    wsum = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ft) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!allowChecked) {
            if (g_ftChkSeat[q]) {
                continue;
            }
        }
        if (BOTC_SeatTeam(q) == 3) {
            continue;                  // 恶魔永远不上这个假干扰项
        }
        if (q == g_herring) {
            continue;                  // 真干扰项那个座位不重复占
        }
        if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0) {
            continue;
        }
        if (mode == 0) {
            if (BOTC_RoleAlign(r) != 0) {
                continue;
            }
        }
        if (mode == 1) {
            if (BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        if (mode == 2) {
            if (BOTC_RoleAlign(r) != 0 && BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        w = BOTC_FtFakeWeight(g_mark[(g_teller * 14) + q] - 1);
        if (w <= 0) {
            continue;
        }
        wsum = wsum + w;
        if (RandomInt(1, wsum) <= w) {
            pick = q;
        }
    }
    return pick;
}

// 每次占卜师要验人之前调一次：把假干扰项同步到「当前该有的样子」----
//   占卜师清醒 / 已死 → 全部移除；酒鬼 → 2 个；中毒 → 1 个。状态没变就沿用，不重抽。
void BOTC_FtFakeSync () {
    int i;
    int q;
    int ft;
    int w;
    int mode;
    int pick;
    int n;
    string s;
    ft = 0;
    w = 0;
    if (w <= 0) {
        if (g_ftFakeOwner != 0) {
            BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项已移除（占卜师清醒 / 已死亡）。");
        }
        g_ftFakeSeat[0] = 0;
        g_ftFakeSeat[1] = 0;
        g_ftFakeOwner = 0;
        g_ftFakeWant = 0;
        return;
    }
    if (g_ftFakeOwner == ft && g_ftFakeWant == w) {
        // 状态没变：基本沿用已经打好的假干扰项，但有两种例外要处理 ----
        //   持有者「还没被验过就死了」→ 把 token 转给别的玩家（优先级 / 权重跟原来一样）；
        //   已经验过的持有者不动（信息已经发出去了，再换人就自相矛盾了）。
        for (i = 0; i < 2; i += 1) {
            q = g_ftFakeSeat[i];
            if (q < 2) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (g_ftChkSeat[q]) {
                continue;              // 已经验过：不转移
            }
            g_ftFakeSeat[i] = 0;       // 先空出来，免得抽到自己
            mode = 0;
            if (i == 1) {
                if (RandomInt(1, 100) <= 30) {
                    mode = 1;
                }
            }
            pick = BOTC_FtFakePickSeat(ft, mode, false);
            if (pick <= 0 && mode == 1) {
                pick = BOTC_FtFakePickSeat(ft, 0, false);
            }
            if (pick <= 0) {
                pick = BOTC_FtFakePickSeat(ft, 2, false);
            }
            if (pick <= 0) {
                // 实在没得挑（比如只剩验过的人）才允许放到验过的座位上
                pick = BOTC_FtFakePickSeat(ft, 2, true);
            }
            g_ftFakeSeat[i] = pick;
            if (pick >= 2) {
                BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项转移： " + BOTC_NameStr(q) + " 还没被验过就死了 → 转到 " + BOTC_NameStr(pick) + "。");
            }
        }
        return;
    }
    g_ftFakeOwner = ft;
    g_ftFakeWant = w;
    g_ftFakeSeat[0] = 0;
    g_ftFakeSeat[1] = 0;
    for (i = 0; i < w; i += 1) {
        mode = 0;                      // 默认给善良角色
        if (i == 1) {
            // 第 2 个假干扰项：小概率落在爪牙身上（酒鬼占卜师两个，其中一个可以是爪牙）
            if (RandomInt(1, 100) <= 30) {
                mode = 1;
            }
        }
        pick = BOTC_FtFakePickSeat(ft, mode, false);
        if (pick <= 0 && mode == 1) {
            pick = BOTC_FtFakePickSeat(ft, 0, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, true);
        }
        g_ftFakeSeat[i] = pick;
    }
    // 【诊断】写清楚打给了谁（不占 token、玩家看不到）
    s = "【诊断占卜师】假干扰项（他是" + BOTC_DiagStateStr(ft) + "）：";
    n = 0;
    for (i = 0; i < 2; i += 1) {
        if (g_ftFakeSeat[i] >= 2) {
            if (n > 0) {
                s = s + "、";
            }
            s = s + BOTC_NameStr(g_ftFakeSeat[i]);
            n = n + 1;
        }
    }
    if (n <= 0) {
        s = s + "没找到合适的人";
    }
    BOTC_PmStore(g_teller, s + " ---- 验到他们会报「有恶魔」");
}

// 给出答案：有 / 没有 恶魔（信息只给本人）
void BOTC_FtAnswer (int ob, int a, int b) {
    bool demon;
    bool realDemon;
    bool lie;
    // 先记下「这两个座位已经被验过了」再同步：这样正在验的这个座位不会被当成
    //   「没验过就死了」而把假干扰项转走（他这一验就是验它）。
    if (a >= 2 && a <= 13) {
        g_ftChkSeat[a] = true;
    }
    if (b >= 2 && b <= 13) {
        g_ftChkSeat[b] = true;
    }
    BOTC_FtFakeSync();                 // 再按当前状态把「假干扰项」同步好（酒鬼 2 个 / 中毒 1 个 / 清醒清掉；
                                       // 持有者没被验过就死了会在这里转给别人）
    // 真值：按「登记」那一层算（干扰项也算恶魔）
    realDemon = false;
    if (a == g_herring || b == g_herring) {
        realDemon = true;
    }
    if (BOTC_RegAsDemon(ob, a) || BOTC_RegAsDemon(ob, b)) {
        realDemon = true;
    }
    // 他实际被告知的答案：清醒 = 真值；中毒 / 酒鬼 = 他自己那一层（一个座位只判一次）
    demon = false;
    if (BOTC_RegistersAsDemonToFT(ob, a)) {
        demon = true;
    }
    if (BOTC_RegistersAsDemonToFT(ob, b)) {
        demon = true;
    }
    lie = (demon != realDemon);
    // 【真人说书 · 信息位答题框】（用户 2026-09-20）：弹一个填数字的小窗给说书人，填完自动发给占卜师本人。
    //   要不要骗他（酒鬼 / 中毒）由你在框里填什么数字决定。
    BOTC_ManInfoOpen(BOTC_PosOf(ob), 5, BOTC_NameStr(a) + " / " + BOTC_NameStr(b));
    BOTC_PmStore(g_teller, BOTC_NameStr(BOTC_PosOf(ob)) + " 选择了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b));
    if (BOTC_SeatImpaired(BOTC_PosOf(ob))) {
        // 中毒 / 酒鬼：单独一行写清楚（报的什么 / 真值 / 两个座位各自是不是干扰项）
        BOTC_DiagFtLine(BOTC_PosOf(ob), a, b, demon, realDemon);
    }
    else {
        BOTC_DiagSeatLine("占卜师", BOTC_PosOf(ob), lie, a, b);
    }
}

// 给一个「不一样的身份」（中毒 / 酒鬼说假话时用；只在 0..16 的善良身份里挑，免得答案太离谱）
int BOTC_WrongRole (int r) {
    int k;
    int i;
    for (i = 0; i < 40; i += 1) {
        k = RandomInt(0, 16);
        if (k != r) {
            return k;
        }
    }
    if (r == 0) {
        return 1;
    }
    return 0;
}

//==================================================================================================
// 【守鸦人（索引 8）的自动发信息已删除】（用户 2026-10-05 要求「都删了」）
//   原 `BOTC_RkAnswer()` 会算一次「查到的身份」（走登记层 / 中毒看错层）然后：
//     · 智能说书模式 → 私聊发给守鸦人本人；
//     · 手动说书模式 → 写进说书人私聊日志（连同一行诊断）。
//   现在原型 / 定义 / 调用三处全部删除：守鸦人夜里被唤醒、选完人、按【确认】，
//   **不再自动发任何信息**，答案由说书人自己看魔典处理。
//==================================================================================================

// 智能说书：给每个邪恶座位自动分配一个「不在场的好身份」当伪装口供
// （以后送葬者/调查员这类被中毒的人来查他，给的就是这份口供，不会露馅）
// 【伪装】不再由 AI 说书人自动安排：给每个邪恶玩家一句提示，让他自己挑自称的身份
//   （正式开局后右上角会长出【伪装身份】按钮；手动说书也走同一句提示）
void BOTC_ClaimHint () {
    // 【伪装】那条私聊提示删掉了（用户要求）---- 邪恶玩家自己看右上角的【伪装身份】按钮就行。
    //   函数保留成空壳，调用点（随机发牌 / 智能说书开局）不用动；以后想恢复提示在这里加回来即可。
}


//==================================================================================================
// 板子（剧本）系统
//   开局先黑屏选板子：手动说书由说书人点选；玩家1是电脑时改成玩家投票、票高者采用
//   黑屏：星际的对话图片按原尺寸画（不拉伸），所以用 256x216 的黑块拼满 1920x1080
//   渐变：用 4 档不同透明度的黑图（botc_black64/128/192 + botc_black）逐帧切换
//==================================================================================================
int BOTC_BoardCount () {
    return 12;  // 【板子**张数**】（不含板子 7 自定义剧本）：板子 13 = 全员追忆
}

string BOTC_BoardName (int b) {
    if (b == 1) {
        return "暗流涌动";
    }
    if (b == 2) {
        return "黯月初升";
    }
    if (b == 3) {
        return "梦殒春宵";
    }
    if (b == 4) {
        return "瓦釜雷鸣";
    }
    if (b == 5) {
        return "夜半狂欢";
    }
    if (b == 6) {
        return "罂粟花开";
    }
    if (b == 7) {
        return "自定义剧本";         // 玩家自己拼的（用户 2026-10-03）
    }
    if (b == 8) {
        return "横行霸道";
    }
    if (b == 9) {
        return "何方教众";          // 用户 2026-10-10：Whose Cult Is It Anyway
    }
    if (b == 10) {
        return "风雅集";           // 用户 2026-10-16：玩家自制剧本（剧本作者 苏通染；华灯初上 + 实验性角色）
    }
    if (b == 11) {
        return "心理博弈 XI";
    }
    if (b == 12) {
        return "信口雌黄";
    }
    if (b == 13) {
        return "全员追忆";
    }
    return "未定";                 // ⚠ 兜底 return 必须是这个非 void 函数的**最后一句**，新板子往上面加
}

string BOTC_BoardPic (int b) {
    if (b == 1) {
        return "botc_board_tb.dds";
    }
    if (b == 2) {
        return "botc_board_bmr.dds";
    }
    if (b == 3) {
        return "botc_board_sv.dds";
    }
    if (b == 4) {
        return "botc_board_wf.dds";
    }
    if (b == 5) {
        return "botc_board_ybkh.dds";
    }
    if (b == 6) {
        return "botc_board_pg.dds";
    }
    if (b == 7) {
        return "botc_board_custom.dds";  // 自定义剧本自己的封面（用户 2026-10-04 给的图：256x256 透明底，要导入）
    }
    if (b == 8) {
        return "botc_board_oe.dds";      // 横行霸道 Outted Evil
    }
    if (b == 9) {
        return "botc_board_cult.dds";    // 何方教众（封面图待导入）
    }
    if (b == 10) {
        return "botc_board_fengya.dds";  // 风雅集（用户 2026-10-16 给的题字 logo，256x256 透明底）
    }
    if (b == 11) {
        return "botc_board_rochambeau.dds";
    }
    if (b == 12) {
        return "botc_board_xinkou.dds";
    }
    if (b == 13) {
        return "botc_board_quanyuan.dds";
    }
    return "botc_blank.dds";       // ⚠ 同上：兜底 return 放最后
}


// 【智能说书支持的板子】（用户 2026-09-20）：黯月初升（2）那些角色的自动判定还没做完，
//   智能说书跑这张板子会发错身份 / 中途卡住 ---- 先只让智能说书用暗流涌动（1）。
//   真人说书完全不受影响：说书人自己点板子，照样能开黯月初升。

// 这张板子智能说书能不能跑（true = 暂不支持自动说书）

// 智能说书模式下点了【暂不支持自动说书】的板子：提示投票的人 + 全屏一行字幕

// 选板子期间变黑用的光照名字 ---- 就是你自己在数据编辑器里做的那套纯黑光照（black）。
//   名字必须跟数据编辑器里显示的完全一致（大小写也算）；如果变黑没反应/是硬切，
//   先确认这里写的是不是数据里那个名字。
string BOTC_BoardLightName () {
    return "black";
}

// 【私聊可见性】选板子页右上角的开关：只改非说书人看到的会话列表，不影响已有私聊内容。
void BOTC_PmVisRender () {
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    if (!g_boardOpen || g_cOpen) {
        return;
    }
    if (g_pmVisOn) {
        libNtve_gf_SetDialogItemText(g_pmVisBtn, StringToText("私聊可见性：开启"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pmVisBtn, StringToText("私聊可见性：关闭"), PlayerGroupSingle(g_teller));
    }
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupSingle(g_teller), true);
}

void BOTC_PmVisToggle () {
    g_pmVisOn = !g_pmVisOn;
    BOTC_PmVisRender();
    BOTC_RefreshSessListAll();
    if (g_pmVisOn) {
        BOTC_NoticeKeep(g_teller, "【私聊可见性】已开启：恢复显示所有进行中的私聊。");
    }
    else {
        BOTC_NoticeKeep(g_teller, "【私聊可见性】已关闭：非说书人只保留自己所在的私聊。");
    }
}

// 建选板子的页面（含黑屏遮罩）
// 【黑布独立一层】（用户 2026-10-04）：开局那块黑幕原来建在选板子页（g_boardDlg）里，而 g_boardDlg
//   建得比聊天窗**晚** → 黑布压在聊天框上面，选板子阶段根本看不到聊天。
//   现在把黑布拆成**自己一个对话框**，并且**全图最先创建 = 最低图层**：
//     黑布（最低）→ 汉字预热 → 聊天窗（公聊 / 私聊）→ …其它面板… → 选板子页 / 自定义剧本面板（最高）
//   于是选板子阶段：聊天框显示在黑布上面；选板子按钮 / 自定义剧本按钮仍然压在聊天框上面，照样能点。
void BOTC_BuildBlack () {
    int i;
    int x;
    int y;
    // 黑屏遮罩：11 列 x 7 行 = 77 块（2640 x 1512），块之间留 16px 重叠，免得交界处有缝
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_blackDlg = DialogLastCreated();
    DialogSetVisible(g_blackDlg, PlayerGroupAll(), false);
    for (i = 0; i < 77; i += 1) {
        x = (i % 11) * 240;
        y = (i / 11) * 216;
        libNtve_gf_CreateDialogItemImage(g_blackDlg, 256, 216, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_blackTile[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_blackTile[i], PlayerGroupAll(), c_anchorTopLeft, x, y);
        libNtve_gf_SetDialogItemAcceptMouse(g_blackTile[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_blackTile[i], "botc_black.dds", PlayerGroupAll());
        DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), false);
    }
}

void BOTC_BuildBoard () {
    int i;
    int x;
    int y;
    string s;
    // 对话框开得比屏幕大，保证各种分辨率都能盖满
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_boardDlg = DialogLastCreated();
    // 【关掉对话框自己的底图】（用户 2026-10-04 报「整个选板子页的对话框显形了」）：
    //   对话框创建时自带一张底图/边框；以前 77 块黑布就在这个对话框里、正好把它盖住，
    //   现在黑布搬成独立对话框了 → 底图整块露出来。关掉它，页面就只剩封面 / 按钮 / 设置。
    DialogSetImageVisible(g_boardDlg, false);
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), false);
    // 【黑屏遮罩搬走了】（用户 2026-10-04）：77 块黑布现在建在 BOTC_BuildBlack() 里（最早创建 = 最低图层）。
    //   这个页面本体只留标题 / 封面 / 板子按钮 / 本局设置；它自己建得最晚，所以压在聊天框上面。
    g_boardTitle = BOTC_NewLabelC(g_boardDlg, 900, 64, 510, 150, StringToText("选择板子"));
    libNtve_gf_SetDialogItemStyle(g_boardTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardTitle, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);
    g_boardHint = BOTC_NewLabelC(g_boardDlg, 1400, 36, 260, 222, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_boardHint, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardHint, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    // 倒计时单独一个标签，而且必须用「左对齐」的（居中标签每次更新会重新居中、整串左右跳，看着像闪）
    g_boardTime = BOTC_NewLabel(g_boardDlg, 800, 36, 700, 266, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_boardTime, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardTime, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);
    // 说书人专用：手动修正参与人数（编辑器测试地图会把空槽位补成电脑，自动检测会偏多）
    g_fixLbl = BOTC_NewLabelC(g_boardDlg, 600, 36, 660, 740, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_fixLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_fixLbl, false, PlayerGroupAll());
    DialogControlSetVisible(g_fixLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_fixLbl, PlayerGroupSingle(g_teller), false);
    g_fixMinus = BOTC_NewButton(g_boardDlg, 160, 50, 660, 780, "人数 -1");
    DialogControlSetVisible(g_fixMinus, PlayerGroupAll(), false);
    g_fixPlus = BOTC_NewButton(g_boardDlg, 160, 50, 1100, 780, "人数 +1");
    DialogControlSetVisible(g_fixPlus, PlayerGroupAll(), false);
    // 【私聊可见性】选板子页右上角，仅说书人可见；状态不随切换板子重置。
    g_pmVisBtn = BOTC_NewButton(g_boardDlg, 360, 48, 1520, 20, "私聊可见性：关闭");
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    for (i = 0; i < 13; i += 1) {
        x = 40 + (i * 310);
                                  //   5 张时 x = 80 / 440 / 800 / 1160 / 1520（夜半狂欢在最右）
        libNtve_gf_CreateDialogItemImage(g_boardDlg, 256, 256, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_boardPic[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, x + 32, 330);
        libNtve_gf_SetDialogItemAcceptMouse(g_boardPic[i], true, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_boardPic[i], "botc_blank.dds", PlayerGroupAll());
        DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
        g_boardBtn[i] = BOTC_NewButton(g_boardDlg, 320, 80, x, 630, "板子");
        DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
    }
    //--------------------------------------------------------------------------------------------
    // 右边那块「本局设置（投票）」（用户 2026-09-17）：只有智能说书模式才显示
    //   私聊时间（1~4 分钟 / 换成自由发言）· 公聊时间（1~4 分钟）·
    //   提名时间（10 / 20 / 30 秒）· 第一天白天要不要开邪恶小窗
    //--------------------------------------------------------------------------------------------
    g_bvDlg = g_boardDlg;              // 直接挂在选板子页面上：跟着它一起显隐
    g_bvTitle = BOTC_NewLabelC(g_boardDlg, 430, 34, 1470, 150, StringToText("本局设置（投票）"));
    libNtve_gf_SetDialogItemStyle(g_bvTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvTitle, false, PlayerGroupAll());
    DialogControlSetVisible(g_bvTitle, PlayerGroupAll(), false);
    // 行 1：私聊时间（1 / 2 / 3 / 4 分钟 + 自由发言）
    g_bvHead[0] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 190, StringToText("私聊时间（自由 = 把私聊时间换成自由发言）"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[0], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[0], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[0], PlayerGroupAll(), false);
    for (i = 0; i < 5; i += 1) {
        if (i == 4) {
            s = "自由";
        }
        else {
            s = IntToString(i + 1) + "分";
        }
        g_bvPmBtn[i] = BOTC_NewButton(g_boardDlg, 80, 38, 1470 + (i * 86), 216, s);
        DialogControlSetVisible(g_bvPmBtn[i], PlayerGroupAll(), false);
    }
    // 行 2：公聊时间（1 / 2 / 3 / 4 分钟）
    g_bvHead[1] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 262, StringToText("公聊时间"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[1], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[1], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[1], PlayerGroupAll(), false);
    for (i = 0; i < 4; i += 1) {
        s = IntToString(i + 1) + "分";
        g_bvPubBtn[i] = BOTC_NewButton(g_boardDlg, 100, 38, 1470 + (i * 107), 288, s);
        DialogControlSetVisible(g_bvPubBtn[i], PlayerGroupAll(), false);
    }
    // 行 3：提名时间（自由提名阶段的秒数：10 / 20 / 30 秒）
    g_bvHead[2] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 334, StringToText("提名时间（自由提名）"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[2], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[2], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[2], PlayerGroupAll(), false);
    for (i = 0; i < 3; i += 1) {
        if (i == 0) {
            s = "10秒";
        }
        else {
            if (i == 1) {
                s = "20秒";
            }
            else {
                s = "30秒";
            }
        }
        g_bvNomBtn[i] = BOTC_NewButton(g_boardDlg, 133, 38, 1470 + (i * 143), 360, s);
        DialogControlSetVisible(g_bvNomBtn[i], PlayerGroupAll(), false);
    }
    // 行 4：第一天白天要不要开邪恶小窗（点一下循环：未投 → 要 → 不要）
    g_bvHead[3] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 406, StringToText("第一天白天开邪恶小窗？"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[3], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[3], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[3], PlayerGroupAll(), false);
    g_bvEvilBtn = BOTC_NewButton(g_boardDlg, 220, 38, 1470, 432, "第一天小窗：未投");
    DialogControlSetVisible(g_bvEvilBtn, PlayerGroupAll(), false);
    // 票数 + 每人自己的「你已选」
    for (i = 0; i < 5; i += 1) {
        g_bvLine[i] = BOTC_NewLabel(g_boardDlg, 430, 22, 1470, 486 + (i * 24), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_bvLine[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_bvLine[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_bvLine[i], PlayerGroupAll(), false);
    }
    // 选板子的提示里补一句：现在不用等所有人都投
    BOTC_BvRender();
}

// 黑布：等光照全黑之后再铺上去（所以看不出跳变），保证 UI 背后是纯黑、也是兜底
void BOTC_BoardFadeRender () {
    int i;
    if (g_boardFade < 4) {
        DialogSetVisible(g_blackDlg, PlayerGroupAll(), false);
        for (i = 0; i < 77; i += 1) {
            DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), false);
        }
        return;
    }
    // 【黑布是独立对话框】（用户 2026-10-04）：整块一起显隐（它建得最早 = 最低图层）
    DialogSetVisible(g_blackDlg, PlayerGroupAll(), true);
    for (i = 0; i < 77; i += 1) {
        libNtve_gf_SetDialogItemImage(g_blackTile[i], "botc_black.dds", PlayerGroupAll());
        DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), true);
    }
}

// 选板子期间把玩家界面全藏起来（游戏原生 UI 藏不了）
void BOTC_HideAllUI () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmPickEnd(p);         // 选板子时界面全收：顺手把「发起私聊」模式也退掉
        // 【黑布降层后新增】（用户 2026-10-04）：这个按钮原来是「建完就一直挂着」、靠黑布盖住的，
        //   现在黑布降到最低层了，所以要显式收掉；选完板子由 BOTC_ShowAllUI 放回来。
        DialogSetVisible(g_sayBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_panelDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_miniDlg[p], PlayerGroupAll(), false);
        // 选板子时公聊窗**不藏**：它压在板子那块黑布上面（用户 2026-09-19）
        DialogSetVisible(g_pmDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_pmBgDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_logBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_grimBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_abBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_noBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_tipBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_noteBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_claimBtnDlg[p], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_nightBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_chatBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), false);

    DialogSetVisible(g_logDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_logPickDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_abDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_noDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tipDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_pickDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);   // 【发送特定信息】（用户 2026-10-10）
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);   // 【教派投票】（用户 2026-10-10）
    // 【计时器】（用户 2026-10-04 截图：选板子时露出一个「展开计时」）：它原来是建完就挂给说书人、
    //   靠黑布盖住的；黑布降到最低层之后就露出来了 → 选板子期间显式收掉，选完由 BOTC_ShowAllUI 放回初始状态。
    DialogSetVisible(g_tmDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_noteDlg[p], PlayerGroupAll(), false);   // 【笔记】记事板一起收掉
    }
    // 【测试·换座位】发布版隐藏（用户 2026-10-09）：这里也保持收着，别让"界面全开"把它放出来
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);
}

// 选完板子把界面放回来（之前收起面板的人保持收起）
void BOTC_ShowAllUI () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_chatDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_sayBtnDlg[p], PlayerGroupSingle(p), true);   // 【聊天：公聊/私聊】按钮放回来（用户 2026-10-04）
        DialogSetVisible(g_pmDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_pmBgDlg[p], PlayerGroupSingle(p), true);
        if (g_hidden[p]) {
            DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), false);
            DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), true);
        }
        else {
            DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), true);
            DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), false);
        }
    }
    // 右上角三个按钮、发牌按钮的显隐交给 NomUI 统一处理
    BOTC_NomUI();
    BOTC_ClaimBtnRender();
    BOTC_WakeRender();
    BOTC_SkillBtnRender();
    // 这三条也在 NomUI 里管：正式开始之前不出现（用户 2026-09-17）
    DialogSetVisible(g_nightBtnDlg, PlayerGroupSingle(g_teller), g_started);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    DialogSetVisible(g_chatBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    BOTC_ChatBtnRender();

    // 【计时器】（用户 2026-10-04）：选板子期间被 HideAllUI 收掉了，这里恢复成**建完时的初始状态**
    //   —— 小按钮给说书人、面板收着（跟 BOTC_BuildTimer 结尾那两句一致）。
    DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_tmDlg, PlayerGroupSingle(g_teller), false);
    BOTC_BluffRender();
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
}

// 开局：黑屏淡入 -> 选板子
//==================================================================================================
// 背景音乐：选板子 → 正式开始之前，循环播 LostViking_MusicGameLoop
//   ⚠ 声音相关的原生函数名我是按标准 Galaxy 写法写的（SoundlinkAsset / SoundPlay / SoundStop）。
//      如果编辑器报「语法错误」说不认识这几个名字，用这个办法拿到准确写法：
//      在触发器列表里找「音效 → 播放音效」，随便拖一个动作出来、音效选
//      LostViking_MusicGameLoop，切到「查看脚本」看一眼生成的代码，把那行发我，
//      我照着换掉下面这两句就行（别处都不用动）。
//   另外：星际自带的那套音乐（按种族播的）**用触发器关不掉**，要彻底盖掉得在数据编辑器里
//   动地图音效（数据 → 音效，把 Music 类那几条的音量改 0，或者把地图音乐换成这一段）。
//==================================================================================================
// 音轨名（数据编辑器里的 ID）在文件开头的全局区声明，想换曲子改 BOTC_GrimInitData() 里的赋值
// 播放指定音轨（用的是编辑器「播放音轨」动作生成的写法；音轨会盖掉游戏自带音乐）
//   prio = 优先级：3 夜晚（最高，任何切换都盖不掉）/ 2 提名阶段 / 1 白天时段
//   delay = 上一首淡出后隔多少秒再放新的
//           2.5 秒 = 白天里的「时段切换」（私聊 / 公聊 / 自由）
//           4.0 秒 = 昼夜切换（天黑 / 天亮）与提名阶段，留给那几条大提示
void BOTC_MusicPlay (string name, int prio, fixed delay) {
    if (name == "") {
        return;
    }
    if (g_musicPrio > prio) {
        return;                        // 现在放的是更高优先级的音乐（夜晚 / 提名阶段）→ 不许覆盖
    }
    if (g_musicNow == name) {
        g_musicPrio = prio;            // 已经在放这一首了，只刷新一下优先级
        return;
    }
    if (g_musicPending == name) {
        // 已经排上这一首了（天亮时「时段切换」会先排一次、昼夜切换再排一次）：
        //   把计时器按这次给的延迟重来一遍，保证要 4 秒的那次不会被 2.5 秒顶掉
        g_musicPendPrio = prio;
        g_musicPrio = prio;
        TimerStart(g_tMusic, delay, false, c_timeGame);
        return;
    }
    if (g_musicNow != "") {
        // 上一首还在放：先淡出停掉，等 delay 秒让淡出走完，再由计时器放新的
        BOTC_MusicStop();
        g_musicPending = name;
        g_musicPendPrio = prio;
        g_musicPrio = prio;            // 待播放的这首也占住优先级，免得这 delay 秒里被别的曲子插队
        TimerStart(g_tMusic, delay, false, c_timeGame);
        return;
    }
    g_musicPending = "";
    g_musicNow = name;
    g_musicPrio = prio;
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, name, c_soundtrackCueAny, c_soundtrackIndexAny, false);
}

// 离开某个高优先级场景（比如提名结束）时把优先级降下来，好让白天的曲子能放进来
void BOTC_MusicDropPrio (int prio) {
    if (g_musicPrio > prio) {
        g_musicPrio = prio;
    }
    if (g_musicPendPrio > prio) {
        g_musicPendPrio = prio;
    }
}

void BOTC_MusicStop () {
    g_musicPending = "";               // 有等着要放的也一起取消
    g_musicPendPrio = 0;
    g_musicPrio = 0;
    if (g_musicNow == "") {
        return;
    }
    g_musicNow = "";
    // 编辑器「停止音轨」动作生成的写法：true = 淡出之后再停
    SoundtrackStopCurrent(PlayerGroupAll(), c_soundtrackCategoryMusic, true);
}

// 换曲子用的 1.5 秒计时器：到点了就把等着的那首放出来
bool BOTC_MusicTimer_Func (bool testConds, bool runActions) {
    string nm;
    int pr;
    if (!runActions) {
        return true;
    }
    if (g_musicPending != "") {
        nm = g_musicPending;
        pr = g_musicPendPrio;
        g_musicPending = "";
        BOTC_MusicPlay(nm, pr, 0.0);     // 到点直接放，不用再等
    }
    return true;
}

// 兼容旧名字：选板子 / 准备阶段放的那首
void BOTC_MusicStart () {
    // 准备阶段（选板子 / 等待正式开始）的 BGM 优先级最高（4）：这期间任何切换都不许盖掉它
    BOTC_MusicPlay(g_musicBoardName, 4, 2.5);
}

// 白天该放哪一首：
//   **存活玩家 ≤ 4**（小局）→ 不管公聊 / 私聊 / 自由，统一放 gongliao2
//   人多的局 → 公聊一首（gongliao1）、私聊与自由一首（siliao）
//   ⚠ 判据是「还活着的人数」（BOTC_AliveCountTrue：按死亡记录算，隐蔽死亡也算死），
//     不是在场座位数 ---- 人没退局但已经死了，也要按小局算。
string BOTC_DayTrackName () {
    if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
        return g_musicPubSmallName;
    }
    if (g_chatMode == 2) {
        return g_musicPubName;
    }
    return g_musicPmName;
}

// 按当前发言时段放白天的曲子（天亮、以及切时段都用它，保证一定放得出来）
//   delay：昼夜切换（天亮）传 4.0；白天里的时段切换传 2.5
void BOTC_DayMusicRefresh (fixed delay) {
    if (!g_started) {
        return;
    }
    if (g_isNight) {
        return;
    }
    BOTC_MusicPlay(BOTC_DayTrackName(), 1, delay);
}

//--------------------------------------------------------------------------------------------------
// 音效 + 「大提示」横幅
//   入夜那一下：先响一声 ping（音效，不是音轨），屏幕中上方弹出蓝色大字「夜晚 X」
//   大字显示 3.5 秒自动收起，刚好把音乐那 4 秒的空白填满
//--------------------------------------------------------------------------------------------------

// 播一个音效（原生 SoundLink + SoundPlayForPlayer，参数表照 TriggerLibs/natives.galaxy 抄的）
//   id = 数据编辑器「音效」那一栏的 ID（不是音轨）；空字符串 = 不播
//   参数写法照编辑器「播放音效」动作生成的代码抄：
//     SoundPlayForPlayer(SoundLink("Ping", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
//   ---- 名字大小写敏感（"ping" 会报「请求的声音文件未知」），所属玩家用 c_maxPlayers，
//      音量 100.0（百分比），最后一个 0.0 = 从头播（c_soundOffsetStart）
void BOTC_PlaySfx (string id) {
    if (id == "") {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
}

// 只放给**某一个玩家**听的音效（私聊请求 / 私聊建立这类 UI 提示用）
//   ⚠ 别用 g_sfxTimed 那套句柄的写法：同一时刻只会记一个句柄，这里的音效都是短音、不用手动停
void BOTC_PlaySfxTo (string id, int p) {
    if (id == "") {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), p, PlayerGroupSingle(p), 100.0, 0.0);
}

//--------------------------------------------------------------------------------------------------
// 【游戏正式开始】的 10 秒倒计时（用户 2026-09-16 要求）
//   画面跟提名投票那个 10 秒倒计时**完全一样**：同一个 g_cdDlg / g_cdLbl，图用 BOTC_CdImg()
//   的 botc_cd10.dds ... botc_cd1.dds。数字 10→1 各停 1 秒，走完就收起来。
//   说书人点【游戏正式开始】那一下同时放 UI 音效 g_sfxStartName（UI_ObjectiveComplete）。
//--------------------------------------------------------------------------------------------------
void BOTC_StartCdRender () {
    int sec;
    if (!g_startCdOn) {
        return;
    }
    sec = g_startCdSec;
    if (sec < 1) {
        sec = 1;
    }
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(sec), PlayerGroupAll());
}

void BOTC_StartCdBegin () {
    g_startCdOn = true;
    g_startCdSec = 10;
    BOTC_StartCdRender();
    TimerStart(g_tStartCd, 1.0, true, c_timeGame);
}

void BOTC_StartCdStop () {
    g_startCdOn = false;
    g_startCdSec = 0;
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
}

// 倒计时每秒一拍：10 → 9 → ... → 1 → 收起
bool BOTC_StartCdFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_startCdOn) {
        return true;
    }
    g_startCdSec = g_startCdSec - 1;
    if (g_startCdSec <= 0) {
        BOTC_StartCdStop();
        // 【倒计时走完才真正开始】用户 2026-09-16 要求：这一刻才执行「进入第 1 夜」那一套
        if (g_startPending) {
            BOTC_GameStartGo();
        }
        return true;
    }
    BOTC_StartCdRender();
    return true;
}

// 播一个「限时音效」：放出来，过 secs 秒后**淡出**停掉（天亮那声 baitian 就是用这个）
//   句柄从 SoundLastPlayed() 拿（SoundPlayForPlayer 本身不返回东西），到点由计时器 SoundStop(句柄, true)
void BOTC_PlaySfxTimed (string id, fixed secs) {
    if (id == "") {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    g_sfxTimed = SoundLastPlayed();
    TimerStart(g_tSfxStop, secs, false, c_timeGame);
}

bool BOTC_SfxStopFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    SoundStop(g_sfxTimed, true);       // true = 先淡出再停
    return true;
}

void BOTC_BuildBigNotice () {
    // 位置对齐「魔典正中央那张板子图」：
    //   魔典对话框是 1170x1040 居中的（屏幕 1920x1080 的坐标系），所以它的左上角在 (375, 20)；
    //   板子图的图块在魔典内 (444, 392) 起、256x256，也就是屏幕坐标 y 412~668 ---- 这里把大字放在
    //   图块上方一点（屏幕 y 445）。
    //   锚点用 c_anchorTop（水平居中），所以大字天然跟板子图在同一条中线上。
    //   用户 2026-09-19：整块（对话框 + 里面的文字）再往右挪 100（锚点是 c_anchorTop，X 偏移就是左右挪）
    DialogCreate(600, 200, c_anchorTop, 100, 295, false);
    g_bigDlg = DialogLastCreated();
    DialogSetImageVisible(g_bigDlg, false);
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
    // ⚠ 实测：标签里的文字是**左对齐**的（那个「居中」参数不管用），所以左边缘要自己往右挪：
    //   对话框左边缘 = 屏幕中心 - 300，标签 x = 234 → 文字起点 ≈ 中心 - 66，
    //   而「夜晚 X」大概 96 宽 → 正好骑在中心线上。以后嫌偏左/偏右就改这个 234。
    g_bigLbl = BOTC_NewLabelC(g_bigDlg, 600, 40, 234, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bigLbl, false, PlayerGroupAll());   // 别挡住下面的点击
    // 【常驻提示的独立框】（用户 2026-09-22）：跟大字框同一个 X 锚点 / 偏移，只是往下 400 ----
    //   （大字框在 y=295，它就在 y=695；里面的标签还是 (214, 150)，落点 = 大字原来的位置 + 400）
    //   （用户 2026-09-30 起这个框不再显示文字：提示挪到魔典里了，见下面 g_hintLbl 那几行）
    DialogCreate(600, 200, c_anchorTop, 100, 595, false);
    g_hintDlg = DialogLastCreated();
    DialogSetImageVisible(g_hintDlg, false);
    DialogSetVisible(g_hintDlg, PlayerGroupAll(), false);
    // ⚠ 用户 2026-09-30：这一行从「独立提示框 g_hintDlg」改成挂在魔典 g_grimDlg 上（魔典关掉它跟着藏）
    //   位置 (425,725) 是魔典内部坐标：x 按圆桌中心 515 减去估宽一半（9 个全角字 × 20 号 ≈ 180）凑的居中；
    //   想左右挪就改 425、上下挪就改 725。字号用 ModLeftSize20Bold（比大字那档 ObjectiveDisplay 小一号）。
    g_hintLbl = BOTC_NewLabelC(g_grimDlg, 700, 40, 425, 725, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_hintLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_hintLbl, false, PlayerGroupAll());  // 别挡住下面的点击
    DialogControlSetVisible(g_hintLbl, PlayerGroupAll(), false);
    g_tBig = TimerCreate();
    g_tBigTrig = TriggerCreate("BOTC_BigTimer_Func");
    TriggerAddEventTimer(g_tBigTrig, g_tBig);
}

// 弹一条大提示（全场可见）；连着调用会刷新文字并重新计时
//   这个带颜色参数：c = 文字颜色
void BOTC_BigNoticeC (string s, color c) {
    int i;
    libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());          // 正常大字（长驻提示会改成小一号）
    DialogControlSetPosition(g_bigLbl, PlayerGroupAll(), c_anchorTopLeft, 234, 150);
    libNtve_gf_SetDialogItemText(g_bigLbl, TextWithColor(StringToText(s), c), PlayerGroupAll());
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), true);
    for (i = 1; i <= 13; i += 1) {
        g_bigHintOn[i] = false;    // 正常播报顶掉了长驻提示（每人一份，逐个清）
    }
    TimerStart(g_tBig, 3.5, false, c_timeGame);
}

// 「长驻提示」（用户 2026-09-19）：跟白天/夜晚大字共用同一块地方，但**不自动消失** ----
//   唤醒 / 提名选人的操作提示就挂在这儿；一律用小一号字（20）保证整句放得下
void BOTC_BigHintShow (int p, string s) {
    if (p < 1 || p > 13) {
        return;
    }
    libNtve_gf_SetDialogItemStyle(g_bigLbl, "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_bigLbl, PlayerGroupSingle(p), c_anchorTopLeft, 110, 8);
    libNtve_gf_SetDialogItemText(g_bigLbl, TextWithColor(StringToText(s), Color(120, 230, 255)), PlayerGroupSingle(p));
    DialogSetVisible(g_bigDlg, PlayerGroupSingle(p), true);
    g_bigHintOn[p] = true;
}

// 【常驻提示】（用户 2026-09-30 改）：提名环节那种「一直挂着的操作提示」现在挂在**魔典 g_grimDlg** 上 ----
//   位置：x=425 / y=725，都是魔典内部坐标（x 是按圆桌中心 515 估宽凑的居中；y 沿用原来那个独立框的高度）。
//   想调位置就改下面 DialogControlSetPosition 的 425 / 725；想调字号就把 "ModLeftSize20Bold" 换个样式名。
//   显示时间：不自动消失，靠 BOTC_BigHintHide 收（进选人 / 结束提名 / 入夜 / 换局都会收）。
void BOTC_BigHintShowMid (int p, string s) {
    if (p < 1 || p > 13) {
        return;
    }
    libNtve_gf_SetDialogItemStyle(g_hintLbl, "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_hintLbl, PlayerGroupSingle(p), c_anchorTopLeft, 425, 725);
    libNtve_gf_SetDialogItemText(g_hintLbl, TextWithColor(StringToText(s), Color(120, 230, 255)), PlayerGroupSingle(p));
    DialogControlSetVisible(g_hintLbl, PlayerGroupSingle(p), true);
}

// p 传 0（越界同义）= 全场一起收掉（换局 / 重开那种收尾用）
void BOTC_BigHintHide (int p) {
    int i;
    if (g_bigDlg == 0 || g_hintLbl == 0) {
        return;                       // UI 尚未建好时由初始化流程调用，不能操作空句柄
    }
    if (p < 1 || p > 13) {
        for (i = 1; i <= 13; i += 1) {
            g_bigHintOn[i] = false;
        }
        DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_hintLbl, PlayerGroupAll(), false);
        return;
    }
    if (g_bigHintOn[p]) {
        g_bigHintOn[p] = false;
        DialogSetVisible(g_bigDlg, PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_hintLbl, PlayerGroupSingle(p), false);
}

// 默认颜色 = 亮蓝（夜晚用）
void BOTC_BigNotice (string s) {
    BOTC_BigNoticeC(s, Color(90, 170, 255));
}

// 大提示到点自动收起
bool BOTC_BigTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
    return true;
}

// 入夜那一下：一声 ping + 大字「夜晚 X」（第 1 夜 = 夜晚 1）
//   号码取 g_nightNum；准备阶段（还没正式开始）那一夜号码是 0，
//   这时只响 ping、不弹大字，免得出现「夜晚 0」
void BOTC_NightBanner () {
    BOTC_PlaySfx(g_sfxPingName);
    if (g_nightNum >= 1) {
        BOTC_BigNotice("夜晚 " + IntToString(g_nightNum));
    }
}

//--------------------------------------------------------------------------------------------------
// 提名开始：「提名开始」4 个褐色大字在屏幕正中一个一个浮现，最后一起消失
//   节奏：第 1 个字立刻出现 → 每 0.75 秒冒一个（第 4 个在 3.0 秒时出现）→ 3.75 秒时 4 个字一起收掉，
//   刚好赶上 4.0 秒提名阶段正式开始（魔典弹出 + timing 那首音乐进来）
//   同时给全场播一声 g_sfxNomName（timingkaishi）
//--------------------------------------------------------------------------------------------------

// 跟 BOTC_NewLabelC 一样，但最后那个固定值（2.0）可以自己给 ---- 用来试它到底是不是「字体大小」
int BOTC_NewLabelCX (int d, int w, int h, int x, int y, text t, fixed f) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, f);
    return DialogControlLastCreated();
}

// 造（或重建）这 4 个字。重建时先把旧对话框拆掉，免得用 nbig 调参数时叠出好几层
void BOTC_NomBigMake () {
    int i;
    int base;
    int step;
    if (g_nomBigDlg != 0) {
        DialogDestroy(g_nomBigDlg);
        g_nomBigDlg = 0;
    }
    DialogCreate(600, 140, c_anchorCenter, 0, 0, false);
    g_nomBigDlg = DialogLastCreated();
    DialogSetImageVisible(g_nomBigDlg, false);
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), false);
    // 4 个字各一个标签。**标签里的文字是左对齐的**，所以「字的左边缘」就是标签的 x
    //   ---- 想让整组居中，就调 base / step 这两个数：
    //   base = 第一个字的左边缘（对话框 600 宽 → 中线在 300），step = 字间距
    base = 224;
    step = 40;
    for (i = 0; i < 4; i += 1) {
        // 褐色（150,90,40）用文字颜色标记写进去 ---- 标签没有单独的「设置文字颜色」动作，
        //   但颜色标记（TextWithColor）在标签里是好用的（人数配置那行就是这么上色的）
        g_nomBigLbl[i] = BOTC_NewLabelCX(g_nomBigDlg, 110, 140, base + (i * step), 0, TextWithColor(StringToText(g_nomBigCh[i]), Color(150, 90, 40)), g_nomBigSize);
        libNtve_gf_SetDialogItemStyle(g_nomBigLbl[i], g_nomBigStyle, PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_nomBigLbl[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
}

void BOTC_BuildNomBig () {
    g_nomBigCh[0] = "提";
    g_nomBigCh[1] = "名";
    g_nomBigCh[2] = "开";
    g_nomBigCh[3] = "始";
    BOTC_NomBigMake();
    g_tNomBig = TimerCreate();
    g_tNomBigTrig = TriggerCreate("BOTC_NomBigTimer_Func");
    TriggerAddEventTimer(g_tNomBigTrig, g_tNomBig);
}

// 开始演：先把 4 个字全藏起来 → 放音效 → 第 1 个字立刻出现 → 之后每 0.75 秒冒一个
void BOTC_NomBigShow () {
    int i;
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), true);
    BOTC_PlaySfx(g_sfxNomName);
    g_nomBigOn = true;
    g_nomBigIdx = 1;
    g_nomBigHold = 0;
    DialogControlSetVisible(g_nomBigLbl[0], PlayerGroupAll(), true);
    // 每 0.8 秒冒一个字：4 个字分别在 0 / 0.8 / 1.6 / 2.4 秒出现，之后再多留 2 拍（约 1.6 秒）
    //   到 4.0 秒才一起收掉 ---- 「略微延长」就是靠这两个数：0.8（间隔）和下面的 >= 2（多留几拍）
    TimerStart(g_tNomBig, 0.8, true, c_timeGame);
}

// 一起收掉
void BOTC_NomBigHide () {
    int i;
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), false);
    g_nomBigOn = false;
    g_nomBigIdx = 0;
    g_nomBigHold = 0;
}

bool BOTC_NomBigTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_nomBigOn) {
        return true;                   // 没在演（或者早收掉了）：这一拍什么都不做
    }
    if (g_nomBigIdx < 4) {
        DialogControlSetVisible(g_nomBigLbl[g_nomBigIdx], PlayerGroupAll(), true);
        g_nomBigIdx = g_nomBigIdx + 1;
        return true;
    }
    g_nomBigHold = g_nomBigHold + 1;
    if (g_nomBigHold >= 2) {
        BOTC_NomBigHide();
        // 【4 个字收掉之后再挂常驻提示】（用户 2026-09-22）：正在提名环节里才挂 ----
        //   提前结束提名（BOTC_NomClose）也会调 BOTC_NomBigHide，那时不该再挂提示，所以加 g_phase 判断。
        if (g_phase == 1) {
            BOTC_BigHintShowMid(1, "点【发起提名】选人");
            // 【发起提名】跟这行提示同拍开放（用户 2026-09-30）：别再让玩家在「提名开始」那段动画里就抢提名
            g_nomStartOn = true;
            BOTC_NomUI();
        }
    }
    return true;
}

// 【切换板子】：正式开始之前说书人能在顶部换一次板子（重新走选板子页面）
void BOTC_BsBtnRender () {
    DialogSetVisible(g_bsBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tsBtnDlg, PlayerGroupAll(), false);              // 【换座位】一起收起来
    DialogSetVisible(g_legBtnDlg, PlayerGroupAll(), false);
    BOTC_LegacyPanelHide();
    DialogSetVisible(g_legPanel, PlayerGroupAll(), false);
    // 【测试·换座位】发布版始终隐藏；正式【换座位】仍由下面的 g_tsBtnDlg 提供。
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);
    if (g_started || g_boardOpen) {
        return;
    }
    DialogSetVisible(g_bsBtnDlg, PlayerGroupSingle(g_teller), true);
    // 【发完牌就收掉"换座位"】（用户 2026-10-07）：说书人点过【确认发放】之后不许再换座位；
    //   【取消正式开始】会把 g_dealConfirmed 清掉（BOTC_ResetGameVars 里），这里就又会放回来。
    if (!g_dealConfirmed || g_swapUnlocked) {
        DialogSetVisible(g_tsBtnDlg, PlayerGroupAll(), true);   // 【换座位】正式开始前所有玩家都能用
    }
    DialogSetVisible(g_legBtnDlg, PlayerGroupSingle(g_teller), true);
}

// 【换说书人 · 方案 A 第 3 步】（用户 2026-10-06）：说书人点【换说书人】→ 点一个座位 → 交接。
//   第 3+4 步合在一起：换人的同时，把两个座位的**观察者行与列整体对调**（魔典/标记/token），
//   这样：新说书人拿到"真值那一行"（看得到真魔典），老说书人拿到对方原来那份玩家视角。
// 【-pos】把"位置(格子) ↔ 坐的人(物理座位)"整张表打进自己的私聊（用户 2026-10-07，换位排查用）
void BOTC_PosOfDump (int p) {
    int i;
    string s;
    BOTC_AppendPm(p, "【座位表】你 = 座位 " + IntToString(p) + "、位置 " + IntToString(BOTC_PosOf(p))
        + "；说书人 = 座位 " + IntToString(g_teller) + "、位置 " + IntToString(BOTC_PosOf(g_teller)));
    s = "格子 → 坐的人（= 物理座位号）：";
    for (i = 1; i <= 13; i += 1) {
        if (i == 1) {
            s = s + "  [说书人格]=" + IntToString(g_who[i]);
        }
        else {
            s = s + "  [" + IntToString(g_lab[i] + g_nameNumShift) + "]=" + IntToString(g_who[i]);
        }
    }
    BOTC_AppendPm(p, s);
    // 【每格会渲染成什么名字】（用户 2026-10-07）：这里写的就是"占位名"，渲染时会被换成真名 →
    //   你看到的这行应该和魔典上的显示完全一致，对不上就说明是面板没刷新。
    s = "格子 → 显示：";
    for (i = 1; i <= 13; i += 1) {
        s = s + "  " + BOTC_NameStr(i);
    }
    BOTC_AppendPm(p, s);
}

// 【顺位找"在座的真人"】（用户 2026-10-07）：第一个进房间的人（说书人）走了之后，
//   由"下一个进房间的玩家"接手 —— SC2 里进房间越早、玩家号越小（房主 = 1、之后 2、3…），
//   所以这里就是"从 2 往 13 找第一个还在座的真人"。
int BOTC_FirstPresentSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (PlayerType(i) == 1 && PlayerStatus(i) != 2) {
            return i;
        }
    }
    return 0;
}

// 【开局随机分配座位号】（用户 2026-10-07）：物理座位（SC2 玩家号）动不了 —— 引擎不让人换槽，
//   所以"随机"动的是 `g_who`（格子 → 人）：**说书人以外的在场玩家**在玩家格上整体洗一次。
//   说书人固定坐"说书人格"（格子 1），他原来那个玩家号不进圈（BOTC_BuildSeatList 会把 g_teller 排除）。
//   时机：BOTC_Init 里（还没发牌，格子上的身份 / token / 死亡都还是空的，只要洗 g_who 就够了）。
void BOTC_ShuffleSeats () {
    int i;
    int n;
    int j;
    int t;
    int[14] pool;
    playergroup ag;
    ag = PlayerGroupActive();
    // 收集"在场、且不是说书人"的玩家号
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (PlayerGroupHasPlayer(ag, i) && i != g_hideSeat) {
            pool[n] = i;
            n = n + 1;
        }
    }
    // Fisher-Yates：从后往前，每位跟前面随机一位交换
    if (n >= 2) {
        for (i = n - 1; i >= 1; i -= 1) {
            j = RandomInt(0, i);
            t = pool[i];
            pool[i] = pool[j];
            pool[j] = t;
        }
    }
    // 每个格子先默认坐自己（不在场的格保持原样，反正不显示）
    for (i = 2; i <= 13; i += 1) {
        g_who[i] = i;
    }
    // 再把洗好的"人"依次放进"在场、且不是说书人"的格子里
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (PlayerGroupHasPlayer(ag, i) && i != g_hideSeat) {
            g_who[i] = pool[n];
            n = n + 1;
        }
    }
    // 说书人格 = 说书人本人
    g_who[1] = g_teller;
}

// 【不在场身份面板的说书人专属控件：重发给"现在的说书人"】（用户 2026-10-07 报「换说书人之后，
//   不在场身份那里不显示 3 个格子选身份，也没有【随机 3 个】和【发送】这两个按钮」）：
//   那 3 个坑位按钮 + 3 颗功能键是在 **BOTC_BuildBluff / BOTC_BuildLBluff 建面板的那一刻**
//   用 `PlayerGroupSingle(g_teller)` 发下去的 —— 那时候 g_teller 还是老说书人 ✗。
//   换说书人 / 换座位之后只重开了对话框，没重发这些控件 → 新说书人看到的就是空面板。
//   这里统一"先全场收掉、再单独发给现在的说书人"，并把 3 格的内容按数据重画一遍。
void BOTC_BluffTellerUI () {
    int i;
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupAll(), false);
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupSingle(g_teller), true);
    }
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupSingle(g_teller), true);
    BOTC_BluffRender();            // 恶魔那 3 格：按现在选的内容重画给新说书人
    BOTC_LBluffRender();           // 疯子那 3 格：同上
}

// 【换位 / 换说书人之后的统一重刷】（用户 2026-10-07 报「换完有时候渲染不对、第二遍才对」）：
//   换位会改动"谁坐哪格"，牵动的地方不止魔典一处 —— 魔典文字、整圈显隐、说书人专属按钮、
//   私聊名单、每人的聊天窗…… 之前两个入口各刷一部分，才会"有时候对、有时候不对"。
//   现在两个入口换完都只调这一个函数，一次刷全（who = 发起换位的人，给他一句确认）。
void BOTC_AfterSeatChange (int who) {
    int p;
    BOTC_BuildSeatList();
    // 说书人格是唯一真相：任何换位收尾都从 g_who[1] 反推当前说书人的物理座位。
    //   两个入口本来都会写 g_teller；这里再兜底一次，防止连续换人后事件仍按旧行
    //   处理 token（尤其死亡 token 看起来能点亮、却没有写进死亡结算）。
    if (g_who[1] >= 1 && g_who[1] <= 13) {
        g_teller = g_who[1];
    }
    BOTC_GrimRelayout();                    // 整圈位置 + 显隐（g_seatOn 没换）
    if (g_started) {
        BOTC_SeatStateSync();               // 换位后按新真值行重新校正常驻标记
    }
    // 【token 面板跟随新说书人】（用户 2026-10-21）：换位前打开的 token 面板可能还在显示旧观察者行，
    // 先全部关掉并清掉「正在看哪个座位」的缓存；说书人自己那个＋只给新的 g_teller。
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        g_tokWho[p] = 0;
        g_tokPage[p] = 1;
    }
    // 【正在选目标的技能面板重新绑定】（用户 2026-10-24）：
    //   技能面板控件按逻辑格建；只搬 g_skillPicking / g_skillT1 而不重发窗体，
    //   玩家会继续看到旧格的面板，但点击检测已经换到新格 → 点座位和【确认】都没反应。
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_skillBtnDlg[p], PlayerGroupAll(), false);
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_skillPicking[p]) {
            BOTC_SkillRender(p);
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
        }
        else {
            if (g_limitedAsk[p] || g_poAsk[p]) {
                BOTC_SkillOpen(p);
            }
        }
    }
    BOTC_SkillBtnRender();
    DialogControlSetVisible(g_sayTokBtn, PlayerGroupAll(), false);
    if (!g_pmPick[g_teller]) {
        DialogControlSetVisible(g_sayTokBtn, PlayerGroupSingle(g_teller), true);
    }
    BOTC_NomUI();                           // 说书人专属按钮（发牌 / 手动配板 / 确认发放 / 正式开始）
    BOTC_ClaimBtnRender();                  // 【伪装身份】按钮
    BOTC_WakeRender();                      // 【唤醒 / 手动唤醒 / 互认】按钮
    // 说书人那三块"先全收、再给新说书人开"
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);
    // 【收到过不在场身份的那几份要放回来】（用户 2026-10-09 报「发了不在场身份之后，切到那个座位看不到」）：
    //   上面那两句是"先全收、再给说书人开"——但那份面板是**按玩家**渲染的，换位时不能连玩家手上那份一起收掉，
    //   否则恶魔 / 疯子 / 食人族那 3 格就"看不见了"（内容还在，只是被藏了）。这里按 g_bluffGot 放回来。
    for (p = 1; p <= 13; p += 1) {
        if (g_bluffGot[p]) {
            DialogSetVisible(g_bluffDlg, PlayerGroupSingle(p), true);
        }
    }
    BOTC_BluffTellerUI();                   // 【不在场身份那两块面板：3 个坑位 + 【随机 3 个】/【发送】重发给新说书人】（用户 2026-10-07）
    // 【换位之后，把"每个人自己那一格"的身份重刷一遍】（用户 2026-10-07）：
    //   发过牌之后换座位的话，各人自己那份魔典里"自己的身份"要按**他现在坐的格子**重新填一次
    //   （说书人没有玩家身份格，跳过）。
    if (g_dealConfirmed) {
        for (p = 1; p <= 13; p += 1) {
            if (p != g_teller && g_seatOn[BOTC_PosOf(p)]) {
                g_mark[(p * 14) + BOTC_PosOf(p)] = BOTC_PlayerRoleView(BOTC_PosOf(p), g_mark[(g_teller * 14) + BOTC_PosOf(p)] - 1) + 1;
            }
        }
    }
    // 魔典 + 左边聊天窗（名字 / 编号都要按新的映射重画）
    for (p = 1; p <= 13; p += 1) {
        BOTC_GrimRender(p);
        BOTC_ChatRender(p);
        if (g_logOpen[p]) {
            BOTC_LogRender(p);
        }
    }
    BOTC_DeclareRender();
    BOTC_RefreshSessListAll();              // 私聊名单
    if (who >= 1 && who <= 13) {
        BOTC_Notice(who, "【换位完成】界面已全部重刷。");
    }
}

// 【测试·换座位】（用户 2026-10-07）：说书人点按钮 → 点两个玩家格 → 互换这两格。
//   用途：验证"座位换过之后，私聊 / 技能 / 提名投票 / 面板"是不是都还跟着人走。
// 【撤回所有人在选的「换座位」】（用户 2026-10-11）：按钮收掉之后，**已经点下按钮、还没点第二个座位**的人
//   原来还能接着换（点击流程只看 g_swapPickBy，不看锁没锁）→ 这里把他这一按也撤掉。
//   说书人【确认发放】和点【游戏正式开始】时都调它。
void BOTC_SwapCancelAll () {
    if (g_swapPickBy >= 2) {
        BOTC_Notice(g_swapPickBy, "换座位已经关闭了（说书人确认发放 / 正式开始）：这一按取消。");
    }
    g_swapPickBy = 0;
    g_swapFirst = 0;
}

void BOTC_SwapSeatStart (int p) {
    if (!BOTC_DevPlayer(p)) {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }

    if (g_swapPickBy == p) {
        g_swapPickBy = 0;
        g_swapFirst = 0;
        BOTC_Notice(p, "取消【测试·换座位】。");
        return;
    }
    g_swapPickBy = p;
    g_swapFirst = 0;
    BOTC_PanelOpen(p, 2);                       // 摊开魔典（跟【发起私聊】同一套）
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "【测试·换座位】点两个座位（可以点「说书人」那一格）：第一格 → 第二格；再点一次按钮可取消。");
}

// 【换座位 · 请求框】（用户 2026-10-07）：魔典 Y 轴**底部下方**，无背景（跟投票踢人那个框同一套做法）。
void BOTC_BuildSeatAsk () {
    DialogCreate(700, 56, c_anchorRight, -176, 430, false);
    g_askDlg = DialogLastCreated();
    DialogSetVisible(g_askDlg, PlayerGroupAll(), false);
    DialogSetImageVisible(g_askDlg, false);            // 隐藏背景
    g_askLbl = BOTC_NewLabelC(g_askDlg, 700, 26, 0, 4, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_askLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_askLbl, false, PlayerGroupAll());
    g_askYes = BOTC_NewButton(g_askDlg, 140, 26, 210, 28, "同意");
    g_askNo = BOTC_NewButton(g_askDlg, 140, 26, 360, 28, "拒绝");
    DialogControlSetVisible(g_askLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_askYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_askNo, PlayerGroupAll(), false);
}

// 【点【换座位】】（用户 2026-10-07）：正式开始前，任何玩家（含说书人）都能用。
void BOTC_SeatAskStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_started || g_boardOpen) {
        BOTC_Notice(p, "正式开始之后不能换座位。");
        return;
    }
    if (g_askPick[p]) {
        g_askPick[p] = false;
        BOTC_Notice(p, "取消【换座位】。");
        return;
    }
    g_askPick[p] = true;
    BOTC_PanelOpen(p, 2);                          // 摊开魔典
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "【换座位】点一个座位（可以点「说书人」那一格）；再点一次按钮可取消。");
}

// 【点中某一格 → 发请求】（用户 2026-10-07）：cell = 点中的格子（1 = 说书人格）
void BOTC_SeatAskSend (int p, int cell) {
    int to;
    if (p < 1 || p > 13 || cell < 1 || cell > 13) {
        return;
    }
    g_askPick[p] = false;
    to = g_who[cell];                              // 那一格现在坐的**人**（物理座位）
    if (to == p) {
        BOTC_Notice(p, "那是你自己那一格，换一个吧。");
        return;
    }
    if (g_askFrom[to] != 0) {
        BOTC_Notice(p, BOTC_NameStr(BOTC_PosOf(to)) + " 已经收到一个换座位请求了，等他先处理。");
        return;
    }
    g_askFrom[to] = p;
    libNtve_gf_SetDialogItemText(g_askLbl, BOTC_NameSubst(BOTC_NameStr(BOTC_PosOf(p)) + " 想与你交换座位"), PlayerGroupSingle(to));
    DialogControlSetVisible(g_askLbl, PlayerGroupSingle(to), true);
    DialogControlSetVisible(g_askYes, PlayerGroupSingle(to), true);
    DialogControlSetVisible(g_askNo, PlayerGroupSingle(to), true);
    DialogSetVisible(g_askDlg, PlayerGroupSingle(to), true);
    BOTC_PlaySfxTo(g_sfxReqName, to);              // 跟私聊请求同一个提示音
    BOTC_Notice(p, "已向 " + BOTC_NameStr(BOTC_PosOf(to)) + " 发出换座位请求，等对方同意。");
}

// 【对方点同意 / 拒绝】（用户 2026-10-07）
void BOTC_SeatAskAnswer (int p, bool yes) {
    int from;
    int a;
    int b;
    if (p < 1 || p > 13) {
        return;
    }
    from = g_askFrom[p];
    if (from == 0) {
        return;
    }
    g_askFrom[p] = 0;
    libNtve_gf_SetDialogItemText(g_askLbl, StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_askLbl, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_askYes, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_askNo, PlayerGroupSingle(p), false);
    DialogSetVisible(g_askDlg, PlayerGroupSingle(p), false);
    if (g_started) {
        BOTC_Notice(p, "已经正式开始了，这次换座位作废。");
        return;
    }
    if (!yes) {
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了和你换座位。");
        return;
    }
    a = BOTC_PosOf(from);                          // 发起人现在占的格子
    b = BOTC_PosOf(p);                             // 我（同意方）现在占的格子
    if (a < 1 || a > 13 || b < 1 || b > 13 || a == b) {
        return;
    }
    BOTC_SeatSwap(a, b);                           // 整体对调（含说书人格：换到格子 1 的人当说书人）
    BOTC_PubAnnounce("【换座位】" + BOTC_NameStr(a) + " ↔ " + BOTC_NameStr(b) + "（双方同意）");
}

// 【换位时跟着角色/玩家走的逐格运行状态】
//   g_mark / g_tokOn 与死亡记录已经由两个换位入口单独搬运；这里再补首夜、
//   当前技能选择、赋予能力、每日声称等按逻辑格保存的数组。漏搬时最典型的
//   现象是：换说书人后卡扎力面板仍开着却点不动，或者新玩家继承另一格
//   “今天已经造谣过”的状态。
void BOTC_SwapPerSeatRuntime (int x, int y) {
    int t;
    bool b;
    string s;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {
        return;
    }
    t = g_seatFirstNight[x]; g_seatFirstNight[x] = g_seatFirstNight[y]; g_seatFirstNight[y] = t;
    b = g_awake[x];          g_awake[x] = g_awake[y];          g_awake[y] = b;
    b = g_autoWoke[x];       g_autoWoke[x] = g_autoWoke[y];    g_autoWoke[y] = b;
    b = g_insertWake[x];     g_insertWake[x] = g_insertWake[y]; g_insertWake[y] = b;
    b = g_wokeTonight[x];    g_wokeTonight[x] = g_wokeTonight[y]; g_wokeTonight[y] = b;

    b = g_skillPicking[x];   g_skillPicking[x] = g_skillPicking[y]; g_skillPicking[y] = b;
    b = g_limitedAsk[x];     g_limitedAsk[x] = g_limitedAsk[y]; g_limitedAsk[y] = b;
    b = g_poAsk[x];          g_poAsk[x] = g_poAsk[y];          g_poAsk[y] = b;
    t = g_skillT1[x];        g_skillT1[x] = g_skillT1[y];      g_skillT1[y] = t;
    t = g_skillT2[x];        g_skillT2[x] = g_skillT2[y];      g_skillT2[y] = t;
    t = g_skillT3[x];        g_skillT3[x] = g_skillT3[y];      g_skillT3[y] = t;
    t = g_skillRoleSel[x];   g_skillRoleSel[x] = g_skillRoleSel[y]; g_skillRoleSel[y] = t;

    t = g_grantRoleBy[x];    g_grantRoleBy[x] = g_grantRoleBy[y]; g_grantRoleBy[y] = t;
    b = g_grantDrunkBy[x];   g_grantDrunkBy[x] = g_grantDrunkBy[y]; g_grantDrunkBy[y] = b;
    b = g_grantActing[x];    g_grantActing[x] = g_grantActing[y]; g_grantActing[y] = b;
    b = g_grantDoneNight[x]; g_grantDoneNight[x] = g_grantDoneNight[y]; g_grantDoneNight[y] = b;
    t = g_grantFirstNight[x]; g_grantFirstNight[x] = g_grantFirstNight[y]; g_grantFirstNight[y] = t;

    b = g_profUsed[x];       g_profUsed[x] = g_profUsed[y];    g_profUsed[y] = b;
    b = g_foolUsed[x];       g_foolUsed[x] = g_foolUsed[y];    g_foolUsed[y] = b;
    b = g_assiUsed[x];       g_assiUsed[x] = g_assiUsed[y];    g_assiUsed[y] = b;
    b = g_courtUsed[x];      g_courtUsed[x] = g_courtUsed[y];  g_courtUsed[y] = b;

    b = g_gossipDone[x];     g_gossipDone[x] = g_gossipDone[y]; g_gossipDone[y] = b;
    t = g_gossipDay[x];      g_gossipDay[x] = g_gossipDay[y];   g_gossipDay[y] = t;
    s = g_gossipTextBy[x];   g_gossipTextBy[x] = g_gossipTextBy[y]; g_gossipTextBy[y] = s;
    b = g_juggDone[x];       g_juggDone[x] = g_juggDone[y];    g_juggDone[y] = b;
    b = g_juggUsed[x];       g_juggUsed[x] = g_juggUsed[y];    g_juggUsed[y] = b;
    b = g_psyDone[x];        g_psyDone[x] = g_psyDone[y];      g_psyDone[y] = b;
    t = g_psyDay[x];         g_psyDay[x] = g_psyDay[y];        g_psyDay[y] = t;
    b = g_cultDeclDone[x];   g_cultDeclDone[x] = g_cultDeclDone[y]; g_cultDeclDone[y] = b;
    b = g_damselPick[x];     g_damselPick[x] = g_damselPick[y]; g_damselPick[y] = b;
    b = g_damselDone[x];     g_damselDone[x] = g_damselDone[y]; g_damselDone[y] = b;
    b = g_moonDone[x];       g_moonDone[x] = g_moonDone[y];    g_moonDone[y] = b;
    t = g_moonPick[x];       g_moonPick[x] = g_moonPick[y];    g_moonPick[y] = t;
    b = g_moonOpen[x];       g_moonOpen[x] = g_moonOpen[y];    g_moonOpen[y] = b;
    b = g_klutzDone[x];      g_klutzDone[x] = g_klutzDone[y];  g_klutzDone[y] = b;
    t = g_klutzPick[x];      g_klutzPick[x] = g_klutzPick[y];  g_klutzPick[y] = t;

    // 只保存单一格号的光标也要跟着那一格搬家，不能留下旧格号。
    if (g_lastDeadSeat == x) { g_lastDeadSeat = y; }
    else { if (g_lastDeadSeat == y) { g_lastDeadSeat = x; } }
    if (g_gossipBy == x) { g_gossipBy = y; }
    else { if (g_gossipBy == y) { g_gossipBy = x; } }
    if (g_autoLast == x) { g_autoLast = y; }
    else { if (g_autoLast == y) { g_autoLast = x; } }
}

// 真换：第 x 格 与 第 y 格 互换（x / y 都是格子 2..13；说书人格不参与）
//   ① 列 = 被看的人（身份 / token）两格对调   ② 行 = 观察者（谁知道什么）两个人对调
//   ③ 每格自己的数组（在场 / 死亡）对调       ④ g_who（谁坐哪格）对调
//   ⚠ g_mySess / 私聊成员**不动**（人没有换，会话跟着人）
void BOTC_SeatSwap (int x, int y) {
    int q;
    int t;
    int ob;
    int a;
    int b;
    int ib;
    bool bb;
    string s;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {   // 【测试·换座位】允许格子 1（说书人格）
        return;
    }
    a = g_who[x];                               // 第 x 格现在坐的人（物理座位）
    b = g_who[y];
    // ① 列：两格的身份 / token 对调
    for (ob = 1; ob <= 13; ob += 1) {
        ib = g_mark[(ob * 14) + x];
        g_mark[(ob * 14) + x] = g_mark[(ob * 14) + y];
        g_mark[(ob * 14) + y] = ib;
        for (t = 0; t < 256; t += 1) {
            bb = g_tokOn[(((ob * 14) + x) * 256) + t];
            g_tokOn[(((ob * 14) + x) * 256) + t] = g_tokOn[(((ob * 14) + y) * 256) + t];
            g_tokOn[(((ob * 14) + y) * 256) + t] = bb;
        }
    }
    // 【保存旧说书人的真值行】（列已经先换过，所以这份快照就是换位后的完整真值 token 行）。
    if (x == 1 || y == 1) {
        for (q = 1; q <= 13; q += 1) {
            g_swapTruthMark[q] = g_mark[(g_teller * 14) + q];
            for (t = 0; t < 256; t += 1) {
                g_swapTruthTok[(q * 256) + t] = g_tokOn[(((g_teller * 14) + q) * 256) + t];
            }
        }
    }
    // ② 行：两个人"知道什么"对调（间谍那份备份 / 说书人真值行也跟着人走）
    for (q = 1; q <= 13; q += 1) {
        ib = g_mark[(a * 14) + q];
        g_mark[(a * 14) + q] = g_mark[(b * 14) + q];
        g_mark[(b * 14) + q] = ib;
        for (t = 0; t < 256; t += 1) {
            bb = g_tokOn[(((a * 14) + q) * 256) + t];
            g_tokOn[(((a * 14) + q) * 256) + t] = g_tokOn[(((b * 14) + q) * 256) + t];
            g_tokOn[(((b * 14) + q) * 256) + t] = bb;
        }
    }
    // ③ 每格自己的数组（死亡）—— ⚠ `g_seatOn` 不换（同【换说书人】：那是"槽位有没有真人"，跟着槽位走）
    bb = g_deadShown[x];   g_deadShown[x] = g_deadShown[y];   g_deadShown[y] = bb;
    bb = g_deadPending[x]; g_deadPending[x] = g_deadPending[y]; g_deadPending[y] = bb;
    bb = g_leftShown[x];   g_leftShown[x] = g_leftShown[y];   g_leftShown[y] = bb;
    t = g_deadKind[x];     g_deadKind[x] = g_deadKind[y];     g_deadKind[y] = t;
    t = g_deadByDemon[x];  g_deadByDemon[x] = g_deadByDemon[y];  g_deadByDemon[y] = t;
    t = g_deadType[x];     g_deadType[x] = g_deadType[y];     g_deadType[y] = t;
    t = g_deadNightNum[x]; g_deadNightNum[x] = g_deadNightNum[y]; g_deadNightNum[y] = t;
    t = g_deadDay[x];      g_deadDay[x] = g_deadDay[y];       g_deadDay[y] = t;
    bb = g_bansheeSaid[x]; g_bansheeSaid[x] = g_bansheeSaid[y]; g_bansheeSaid[y] = bb;
    bb = g_bansheePower[x]; g_bansheePower[x] = g_bansheePower[y]; g_bansheePower[y] = bb;
    bb = g_bansheeSecondNom[x]; g_bansheeSecondNom[x] = g_bansheeSecondNom[y]; g_bansheeSecondNom[y] = bb;
    t = g_bnestRoleBy[x]; g_bnestRoleBy[x] = g_bnestRoleBy[y]; g_bnestRoleBy[y] = t;
    bb = g_bnestChosenBy[x]; g_bnestChosenBy[x] = g_bnestChosenBy[y]; g_bnestChosenBy[y] = bb;
    bb = g_bnestActing[x]; g_bnestActing[x] = g_bnestActing[y]; g_bnestActing[y] = bb;
    t = g_bnestSource[x]; g_bnestSource[x] = g_bnestSource[y]; g_bnestSource[y] = t;
    t = g_harpyFirstBy[x]; g_harpyFirstBy[x] = g_harpyFirstBy[y]; g_harpyFirstBy[y] = t;
    t = g_harpySecondBy[x]; g_harpySecondBy[x] = g_harpySecondBy[y]; g_harpySecondBy[y] = t;
    t = g_harpyDay[x]; g_harpyDay[x] = g_harpyDay[y]; g_harpyDay[y] = t;
    bb = g_organDrunkBy[x]; g_organDrunkBy[x] = g_organDrunkBy[y]; g_organDrunkBy[y] = bb;
    // 【僵怖的两个标记也要跟着人走】（用户 2026-10-07 报「换完之后僵怖死亡没有死亡音效」）：
    //   `g_zombUsed`（「第一次不会死」用过没有）/ `g_zombFake`（现在算不算活着）记的是**人**的状态，
    //   上面这一串漏了它们 → 换位之后僵怖的假死 / 真死判定、以及死亡音效的静音判定
    //   （`BOTC_DeathSfxMute` 读的就是 `g_zombUsed`）都会落到错的格子上。
    bb = g_zombUsed[x];    g_zombUsed[x] = g_zombUsed[y];     g_zombUsed[y] = bb;
    bb = g_zombFake[x];    g_zombFake[x] = g_zombFake[y];     g_zombFake[y] = bb;
    BOTC_SwapPerSeatRuntime(x, y);
    // ④ 谁坐哪格
    t = g_who[x];          g_who[x] = g_who[y];               g_who[y] = t;
    // ⑤ 动到了「说书人格」（格子 1）→ 坐进去的人就是**新说书人**（跟【换说书人】同一套收尾）
    if (x == 1 || y == 1) {
        g_teller = g_who[1];
        // 【强制回写真值行】（用户 2026-10-21）：不依赖前面的行列置换顺序，
        // 新说书人的观察者行必须拿到旧说书人那一行的完整身份 + token。
        for (q = 1; q <= 13; q += 1) {
            g_mark[(g_teller * 14) + q] = g_swapTruthMark[q];
            for (t = 0; t < 256; t += 1) {
                g_tokOn[(((g_teller * 14) + q) * 256) + t] = g_swapTruthTok[(q * 256) + t];
            }
        }
        // ⚠ g_hideSeat 不动（同上：换说书人不改玩家人数）
        BOTC_PubAnnounce("【换座位】" + BOTC_NameStr(x) + " ↔ " + BOTC_NameStr(y) + "：说书人格换人了");
        BOTC_PmStore(g_teller, "【换座位】你现在是新的说书人。");
        BOTC_BsBtnRender();
        DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
        DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
        DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);
    }
    // ⑥ 留档 + 重刷全场魔典（两格的名字都变了）
    if (!g_arrangeQuiet) {
        s = "【换座位】" + BOTC_NameStr(x) + " ↔ " + BOTC_NameStr(y);
        BOTC_PmStore(g_teller, s);
        if (g_swapPickBy >= 1) {
            BOTC_Notice(g_swapPickBy, s);
        }
    }
    // 换位会改动诺-达鲺的相邻关系：丢掉旧毒口并按新座位立刻重算一次。
    g_nodA = 0;
    g_nodB = 0;
    g_nodDemon = 0;
    g_nodManual = false;
    if (g_started) {
        BOTC_NoDashiiSync();
    }
    BOTC_AfterSeatChange(g_swapPickBy);    // 【统一重刷】（用户 2026-10-07）
}

void BOTC_TellerPickStart (int p) {
    if (p != g_teller) {
        return;
    }
    if (g_tellerPick == p) {
        g_tellerPick = 0;
        BOTC_Notice(g_teller, "取消【换说书人】。");
        return;
    }
    g_tellerPick = p;
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "点一个座位：让他成为新的说书人（你会坐到他原来的位置）。再点一次按钮可取消。");
}

void BOTC_TellerHandover (int p, int seat) {
    int old;          // 老说书人的**物理座位**（行 = 谁知道什么，按物理座位存）
    int posOld;       // 老说书人占的**位置/格子**（说书人格永远是 1）
    int newSeat;      // 新说书人的**物理座位**（点的那一格现在坐的人）
    int q;
    int t;
    int ob;
    bool b;
    int ib;
    string nOld;
    string nNew;
    g_tellerPick = 0;
    if (seat < 2 || seat > 13) {
        BOTC_Notice(g_teller, "这个格子不能换说书人。");
        return;
    }
    old = g_teller;                // 老说书人的物理座位
    posOld = BOTC_PosOf(old);      // 老说书人占的格子（第一次换位时 = 1）
    newSeat = g_who[seat];         // 点的那一格现在坐的人 —— 必须在 g_who 对调**之前**取
    if (seat == posOld || newSeat == old) {
        BOTC_Notice(g_teller, "这个格子不能换说书人。");
        return;
    }
    // 【先拼名字再换人】（用户 2026-10-06 报「播报里写成 玩家0 → 说书人」）：
    //   `BOTC_NameStr()` 判断"是不是说书人"用的是 `g_teller`，所以必须在**换之前**把名字取好。
    nOld = BOTC_NameStr(posOld);
    nNew = BOTC_NameStr(seat);
    // ① 魔典「谁看到什么」的矩阵。⚠【行列是两套坐标系】（用户 2026-10-07 报「第二次换位就乱」）：
    //    · **行 = 观察者 = 物理座位**（谁知道什么）→ 老说书人 old 与 新说书人 newSeat 两行对调，
    //      真值行跟着"说书人这个身份"走，新说书人才看得到真魔典。
    //    · **列 = 被看的人 = 位置/格子** → 「说书人格 posOld」与「点的那个格子 seat」两列对调。
    //    （原来两处都用 old = g_teller：第一次换位两者恰好都是 1 所以看不出问题，换第二次就错行。）
    // 【先快照原始真值行】（用户 2026-10-24）：后续行列交换即使有一步出错，
    //   最终也必须能从这份原始快照恢复新说书人的身份与全部 token。
    for (q = 1; q <= 13; q += 1) {
        g_swapTruthMark[q] = g_mark[(old * 14) + q];
        for (t = 0; t < 256; t += 1) {
            g_swapTruthTok[(q * 256) + t] = g_tokOn[(((old * 14) + q) * 256) + t];
        }
    }
    for (q = 1; q <= 13; q += 1) {
        ib = g_mark[(old * 14) + q];
        g_mark[(old * 14) + q] = g_mark[(newSeat * 14) + q];
        g_mark[(newSeat * 14) + q] = ib;
    }
    for (ob = 1; ob <= 13; ob += 1) {
        ib = g_mark[(ob * 14) + posOld];
        g_mark[(ob * 14) + posOld] = g_mark[(ob * 14) + seat];
        g_mark[(ob * 14) + seat] = ib;
    }
    for (q = 1; q <= 13; q += 1) {
        for (t = 0; t < 256; t += 1) {
            b = g_tokOn[(((old * 14) + q) * 256) + t];
            g_tokOn[(((old * 14) + q) * 256) + t] = g_tokOn[(((newSeat * 14) + q) * 256) + t];
            g_tokOn[(((newSeat * 14) + q) * 256) + t] = b;
        }
    }
    for (ob = 1; ob <= 13; ob += 1) {
        for (t = 0; t < 256; t += 1) {
            b = g_tokOn[(((ob * 14) + posOld) * 256) + t];
            g_tokOn[(((ob * 14) + posOld) * 256) + t] = g_tokOn[(((ob * 14) + seat) * 256) + t];
            g_tokOn[(((ob * 14) + seat) * 256) + t] = b;
        }
    }
    // ② 每个**格子（位置）**自己的那些数组（在场 / 死亡）→ 按 posOld ↔ seat 对调
    //   ⚠ `g_mySess`（我在哪条私聊）**不换**：它和 `g_member` 一样按**物理座位**存（私聊投递用的是
    //     PlayerGroupSingle(座位)），换位时人没动、会话当然不用换 —— 原来跟着对调，换完两边会串会话。
    // ⚠【g_seatOn 不换】（用户 2026-10-07 报「换说书人之后被点那一格的座位图/编号/名字整列不见了」）：
    //   它记的是"这个槽位有没有真人"（2..13 的引擎事实），换位时人并没有换槽 ----
    //   一对调，被点那一格就变成"不在场"，BOTC_GrimRelayout 会把整列控件都藏掉。
    b = g_deadShown[posOld];
    g_deadShown[posOld] = g_deadShown[seat];
    g_deadShown[seat] = b;
    b = g_deadPending[posOld];
    g_deadPending[posOld] = g_deadPending[seat];
    g_deadPending[seat] = b;
    b = g_leftShown[posOld];
    g_leftShown[posOld] = g_leftShown[seat];
    g_leftShown[seat] = b;
    t = g_deadKind[posOld];
    g_deadKind[posOld] = g_deadKind[seat];
    g_deadKind[seat] = t;
    t = g_deadByDemon[posOld];
    g_deadByDemon[posOld] = g_deadByDemon[seat];
    g_deadByDemon[seat] = t;
    t = g_deadType[posOld];
    g_deadType[posOld] = g_deadType[seat];
    g_deadType[seat] = t;
    t = g_deadNightNum[posOld];
    g_deadNightNum[posOld] = g_deadNightNum[seat];
    g_deadNightNum[seat] = t;
    t = g_deadDay[posOld];
    g_deadDay[posOld] = g_deadDay[seat];
    g_deadDay[seat] = t;
    b = g_bansheeSaid[posOld];
    g_bansheeSaid[posOld] = g_bansheeSaid[seat];
    g_bansheeSaid[seat] = b;
    b = g_bansheePower[posOld];
    g_bansheePower[posOld] = g_bansheePower[seat];
    g_bansheePower[seat] = b;
    b = g_bansheeSecondNom[posOld];
    g_bansheeSecondNom[posOld] = g_bansheeSecondNom[seat];
    g_bansheeSecondNom[seat] = b;
    t = g_bnestRoleBy[posOld];
    g_bnestRoleBy[posOld] = g_bnestRoleBy[seat];
    g_bnestRoleBy[seat] = t;
    b = g_bnestChosenBy[posOld];
    g_bnestChosenBy[posOld] = g_bnestChosenBy[seat];
    g_bnestChosenBy[seat] = b;
    b = g_bnestActing[posOld];
    g_bnestActing[posOld] = g_bnestActing[seat];
    g_bnestActing[seat] = b;
    t = g_bnestSource[posOld];
    g_bnestSource[posOld] = g_bnestSource[seat];
    g_bnestSource[seat] = t;
    t = g_harpyFirstBy[posOld];
    g_harpyFirstBy[posOld] = g_harpyFirstBy[seat];
    g_harpyFirstBy[seat] = t;
    t = g_harpySecondBy[posOld];
    g_harpySecondBy[posOld] = g_harpySecondBy[seat];
    g_harpySecondBy[seat] = t;
    t = g_harpyDay[posOld];
    g_harpyDay[posOld] = g_harpyDay[seat];
    g_harpyDay[seat] = t;
    b = g_organDrunkBy[posOld];
    g_organDrunkBy[posOld] = g_organDrunkBy[seat];
    g_organDrunkBy[seat] = b;
    // 【僵怖的两个标记也要跟着人走】（同【换座位】）：漏了它们，换说书人之后
    //   `BOTC_SeatDead` / `BOTC_DeathSfxMute` 会按错的格子判 → 僵怖的死亡音效（惨叫）出不来。
    b = g_zombUsed[posOld];
    g_zombUsed[posOld] = g_zombUsed[seat];
    g_zombUsed[seat] = b;
    b = g_zombFake[posOld];
    g_zombFake[posOld] = g_zombFake[seat];
    g_zombFake[seat] = b;
    BOTC_SwapPerSeatRuntime(posOld, seat);
    // 【编号不跟着人走】（用户 2026-10-06 报「换完显示 0 [玩家2]」的根因）：
    //   编号属于**位置**（格子 2 永远叫 [1]），换说书人时**只搬人**、不动 g_lab。
    //   而"人"由 g_who 记录 —— 这里把两个人的格子对调，名字/颜色就跟着人走了。
    t = g_who[posOld];
    g_who[posOld] = g_who[seat];
    g_who[seat] = t;
    // ③ 换说书人本人：新说书人的**物理座位** = newSeat（PlayerGroupSingle / 各种权限判定都要它）
    g_teller = newSeat;
    // 【从原始真值快照强制重建新说书人行】（用户 2026-10-24）：
    //   不依赖上方行列置换的中间结果。列随人换位：posOld ↔ seat。
    for (q = 1; q <= 13; q += 1) {
        ib = q;
        if (q == posOld) { ib = seat; }
        else { if (q == seat) { ib = posOld; } }
        g_mark[(g_teller * 14) + q] = g_swapTruthMark[ib];
        for (t = 0; t < 256; t += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + t] = g_swapTruthTok[(ib * 256) + t];
        }
    }
    // ⚠【这里不要动 g_hideSeat】（用户 2026-10-07 实测：一动就"点换说书人会掉一格"）：
    //   换说书人只是"谁当说书人"换人 —— 玩家人数没变，圈里该有的格子数也没变。
    //   g_hideSeat 只在"刚进游戏顺位接手"那一次设置（BOTC_InitMode），之后整局不再改。
    BOTC_PubAnnounce("【换说书人】" + nOld + " → " + nNew + "（接下来的说书人操作请找他）");
    BOTC_PmStore(g_teller, "【换说书人】你现在是新的说书人（原说书人在 " + BOTC_NameStr(posOld) + " 那一格）。");
    BOTC_BsBtnRender();
    BOTC_AfterSeatChange(p);       // 【统一重刷】（用户 2026-10-07）：魔典 / 整圈 / 按钮 / 私聊名单 / 聊天窗 一次刷全
}

void BOTC_BoardSwitch () {
    if (g_started) {
        BOTC_Notice(g_teller, "已经开始游戏了，不能换板子。");
        return;
    }
    g_dealConfirmed = false;
    BOTC_PmStore(g_teller, "【板子】说书人点了【切换板子】→ 重新打开选板子页面。");
    BOTC_BoardOpen();
}

void BOTC_BoardOpen () {
    int i;
    BOTC_BvReset();                // 本局设置投票：每局重新来（顺便把默认值填上）
    g_seatFix = 0;                 // 人数修正只属于本次选板页；不能把上一局的手动人数带进下一局
    for (i = 1; i <= 13; i += 1) {
        g_boardVote[i] = 0;
    }
    g_boardOpen = true;
    g_cOpen = false;                                  // 自定义剧本面板：每次开选板子页都先收起来
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    // 开局第 0 秒就全黑：立刻铺黑布，同时把光照切成纯黑（藏在黑布后面完成）。
    // 之后撤掉黑布时背景仍是黑的，再由光照渐变回白天。
    g_boardFade = 4;
    g_boardLastSec = -1;
    BOTC_HideAllUI();
    BOTC_BoardFadeRender();
    GameSetLighting(BOTC_BoardLightName(), 2.0);
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), true);
    BOTC_BoardRender();
    // 【选板子计时】（用户 2026-09-25）：这 30 秒现在只剩「智能说书自己按票数定板子」用；
    //   真人说书不限时间、也不显示倒计时（见 BOTC_BoardTick），到点什么都不做。
    TimerStart(g_tBoard, 30.0, false, c_timeGame);
    BOTC_MusicStart();             // 选板子时就开始循环放背景音乐（一直到正式开始才停）
    BOTC_BsBtnRender();            // 选板子页面打开时把【切换板子】收起来
}

// 刷新选板子页面：标题、说明、板子按钮和票数（倒计时单独走 BoardTick，避免整块重刷导致闪）
// 【选板子界面显示顺序】（用户 2026-09-22）：梦殒春宵 / 暗流涌动 / 黯月初升（内部编号不变）
int BOTC_BoardAtSlot (int slot) {
    if (slot == 11) {
        return 13;           // 第 12 格 = 全员追忆（板子号 13）
    }
    if (slot == 8) {
        return 10;           // 第 9 格 = 风雅集（板子号 10）
    }
    if (slot == 9) {
        return 11;           // 第 10 格 = 心理博弈 XI（板子号 11）
    }
    if (slot == 10) {
        return 12;           // 第 11 格 = 信口雌黄（板子号 12）
    }
    if (slot == 0) {
        return 3;
    }
    if (slot == 1) {
        return 1;
    }
    if (slot == 2) {
        return 2;
    }
    if (slot == 6) {
        return 8;            // 第 7 格 = 横行霸道（板子号 8）
    }
    if (slot == 7) {
        return 9;            // 第 8 格 = 何方教众（板子号 9）
    }
    return slot + 1;
}

void BOTC_BoardRender () {
    int i;
    int k;
    int v;
    string s;
    BOTC_BuildSeatList();
    libNtve_gf_SetDialogItemText(g_boardTitle, StringToText("选择板子"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_boardHint, StringToText("由说书人点一个板子开始本局，不限时间。（检测到 " + IntToString(g_seatN) + " 位玩家）"), PlayerGroupAll());
    for (i = 0; i < 13; i += 1) {
        if (i >= g_boardCount) {
            DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
        }
        else {
            v = 0;
            for (k = 2; k <= 13; k += 1) {
                if (g_boardVote[k] == BOTC_BoardAtSlot(i)) {
                    v = v + 1;
                }
            }
            s = BOTC_BoardName(BOTC_BoardAtSlot(i));
            libNtve_gf_SetDialogItemText(g_boardBtn[i], StringToText(s), PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_boardPic[i], BOTC_BoardPic(BOTC_BoardAtSlot(i)), PlayerGroupAll());
            DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), true);
            DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), true);
        }
    }
    // 【选板子页重排】（用户 2026-10-03）：老板子往上挪、第 7 张另起一行、自定义剧本去屏幕最下方
    // 【何方教众 · 选板子页排位】（用户 2026-10-10）：第 1 行 6 张，第 2 行左边 = 横行霸道 / 右边 = 何方教众
    for (i = 0; i < 13; i += 1) {
        if (i < 6) {
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 72 + (i * 310), 90);   // 【整排上移】（用户 2026-10-16）
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 40 + (i * 310), 370);   // 【整排上移】（用户 2026-10-16）
        }
        if (i == 6) {
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 72, 500);   // 【上移】（用户 2026-10-16）
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 40, 780);   // 【上移】（用户 2026-10-16）
        }
        if (i == 7) {
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 382, 500);   // 【上移】（用户 2026-10-16）
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 350, 780);   // 【上移】（用户 2026-10-16）
        }
        if (i == 8) {   // 风雅集
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 692, 500);
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 660, 780);
        }
        if (i == 10) {  // 【信口雌黄】第二排第 5 张
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 1312, 500);
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 1280, 780);
        }
        if (i == 11) {  // 【全员追忆】放在第二排信口雌黄的右侧
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 1622, 500);
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 1590, 780);
        }
    }
    // 【心理博弈 XI】第二排第 4 张板子。
    DialogControlSetPosition(g_boardPic[9], PlayerGroupAll(), c_anchorTopLeft, 1002, 500);
    DialogControlSetPosition(g_boardBtn[9], PlayerGroupAll(), c_anchorTopLeft, 970, 780);
    // 【自定义剧本】入口：选板页先显示封面和一颗入口按钮，进入编辑器后再选槽位。
    libNtve_gf_SetDialogItemImage(g_boardPic[12], "botc_board_custom.dds", PlayerGroupAll());
    DialogControlSetPosition(g_boardPic[12], PlayerGroupAll(), c_anchorTopLeft, 1572, 848);
    DialogControlSetVisible(g_boardPic[12], PlayerGroupAll(), true);
    DialogControlSetPosition(g_fixLbl, PlayerGroupSingle(g_teller), c_anchorTopLeft, 660, 1120);   // 【挪到最下方】（用户 2026-10-16，X 不变）
    DialogControlSetPosition(g_fixMinus, PlayerGroupSingle(g_teller), c_anchorTopLeft, 660, 1160);   // 【挪到最下方】（用户 2026-10-16，X 不变）
    DialogControlSetPosition(g_fixPlus, PlayerGroupSingle(g_teller), c_anchorTopLeft, 1100, 1160);   // 【挪到最下方】（用户 2026-10-16，X 不变）
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);   // 标题不显示（用户 2026-10-03）
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);   // 【本局设置投票】只有智能说书才显示（2026-10-16 清死代码）
    // 人数修正：只有说书人看得见（智能模式没人按，也不影响，检测值一般是对的）
    libNtve_gf_SetDialogItemText(g_fixLbl, StringToText("参与人数：" + IntToString(g_seatN) + "（点两侧按钮修正）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_fixLbl, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_fixMinus, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_fixPlus, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_cOpenBtn, PlayerGroupAll(), true);
    BOTC_PmVisRender();
    // 逼下一次 tick 把倒计时补上
    g_boardLastSec = -1;
    BOTC_BoardTick();
    BOTC_BvRender();              // 右边那块「本局设置（投票）」跟着一起刷新
}

// 每半秒只更新倒计时那一行，而且只在秒数变化时才写（写太勤会闪）
void BOTC_BoardTick () {
    int sec;
    return;                        // 真人说书：不限时间，不写倒计时（用户 2026-09-21）
    sec = FixedToInt(TimerGetRemaining(g_tBoard));
    if (sec < 0) {
        sec = 0;
    }
    if (sec != g_boardLastSec) {
        g_boardLastSec = sec;
        libNtve_gf_SetDialogItemText(g_boardTime, StringToText("剩余 " + IntToString(sec) + " 秒"), PlayerGroupAll());
    }
}

// 有人点了板子：手动说书只有说书人能点、点了即定；投票模式记票
// 说书人手动修正参与人数（第一次按会从自动检测值开始算）
void BOTC_BoardFixSeats (int delta) {
    BOTC_BuildSeatList();
    if (g_seatFix <= 0) {
        g_seatFix = g_seatN;
    }
    g_seatFix = g_seatFix + delta;
    if (g_seatFix < 2) {
        g_seatFix = 2;
    }
    BOTC_BuildSeatList();
    if (g_seatFix > g_seatN) {
        g_seatFix = g_seatN;
    }
    BOTC_BoardRender();
}

void BOTC_BoardPick (int p, int b) {
    int k;
    int all;
    if (!g_boardOpen || g_boardFade < 4) {
        return;
    }
    if (b < 1 || b > 13) {         // 横行霸道 = 8 / 何方教众 = 9 / 风雅集 = 10（编号不连续，不能再用 g_boardCount 当上限）
        return;
    }
    if (p == g_teller) {
        // 说书人自己点：手动说书，点了就定
        BOTC_BoardFinish(b);
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    // 【玩家 2 帮玩家 1 选板的测试旁路已关闭】（用户 2026-10-21）：
    //   非说书人点板子不再参与定板；正式说书人自己点板不受影响。
    // 真人说书：其他玩家点板子一律不算（用户 2026-09-25：删掉「没人点板子就自动切【智能说书】」那段）
    return;
    // 【智能说书不支持的板子】（用户 2026-09-20）：点了不算票、不计入，直接提示他改投暗流涌动。
    //   否则智能说书会拿着黯月初升的板子跑：身份抽错 / 中途卡住。
    if (false) {
        BOTC_BoardRender();
        return;
    }
    g_boardVote[p] = b;
    BOTC_BoardRender();
    // 用户 2026-09-17：不用等所有玩家都投 ---- **票最多的板子票数超过本局玩家的一半**就直接进入；
    //   没超过就继续等，30 秒到点由 BOTC_BoardTimeout 按票数最高的定。
    BOTC_BuildSeatList();
    all = BOTC_BoardTopVotes();
    k = g_seatN / 2;
    if (all > k) {
        BOTC_BoardFinish(BOTC_BoardWinner());
    }
}

// 票数最高的板子（平票取编号小的）
int BOTC_BoardWinner () {
    int i;
    int k;
    int v;
    int best;
    int bestN;
    best = 1;
    bestN = -1;
    for (i = 1; i <= 12; i += 1) {  // 板子号最大到 12（7 = 自定义剧本，没人能投票）
        v = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_boardVote[k] == i) {
                v = v + 1;
            }
        }
        if (v > bestN) {
            bestN = v;
            best = i;
        }
    }
    return best;
}

// 倒计时结束：投票模式按票数定，手动模式没人选就默认第一个板子
void BOTC_BoardTimeout () {
    int b;
    if (!g_boardOpen) {
        return;
    }
    // ⚠ 这里**不再**因为「玩家1 一直没点」就自动切智能说书 ---- 真人说书人临时走开、
    //   或只是想多看两眼板子，就会被误判成电脑，然后整局被 AI 接管（很难发现原因）。
    //   现在判定智能说书只有两个来源（用户 2026-09-25：选板子时「别人点了」那条也删了）：
    //     ① g_p1ForceComputer（BOTC_Init 里的手动开关 / 说书人在聊天里输入 -AI）；
    //     ② 真身判定：玩家1 是大厅里的电脑（见 BOTC_P1IsComputer）。
    // 【真人说书 · 不限时间】（用户 2026-09-21）：时间到了什么都不做，
    //   等说书人自己点一个板子；原来的「到点默认用第一个板子」已经删掉。
    return;
}

// 定下板子：收掉选项、黑屏淡出、播报、刷新魔典中央
void BOTC_BoardFinish (int b) {
    // 【智能说书不支持的板子】（用户 2026-09-20）：最后一道保险。
    g_board = b;
    // 【暴风捕手（113）】（用户 2026-10-10）：内置板子一律保护异教领袖；自定义剧本（b == 7）用做板子时选的那个
    if (b != 7) {
        g_stormRole = 106;
        g_cStormRole = 106;
    }
    BOTC_LegacyApply(b);
    g_boardOpen = false;
    g_bootSavePending = false;
    g_bootSaveSlot = 0;
    g_boardFade = 0;
    // 撤掉黑布：此时光照已经是纯黑，所以撤掉看不出跳变
    BOTC_BoardFadeRender();
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_warmDlg, PlayerGroupAll(), false);   // 汉字预热标签：黑布撤了就别再挂着了
    BOTC_ShowAllUI();
    BOTC_BluffTellerUI();
    BOTC_BoardInfoRender();
    // 纯黑光照平滑渐变回白天 / 夜晚（2 秒）
    BOTC_NightApply();
    // 诊断：把引擎检测到的参与座位写给说书人（人数不对时看这一行）
    BOTC_BuildSeatList();
    BOTC_DiagStore(g_teller, "【诊断】本局参与座位：" + BOTC_SeatListStr() + "（共 " + IntToString(g_seatN) + " 人）");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局板子：" + BOTC_BoardName(b)));
    BOTC_PeriodRecord("---- 本局板子：" + BOTC_BoardName(b) + " ----");
    // 智能说书：结算本局设置投票（私聊 / 公聊 / 提名时间 / 第一天邪恶小窗）
    BOTC_BvApply();
    BOTC_PickLayout();             // 板子定了：两个图标网格按这个板子的角色重排
    BOTC_RsLayout();
    BOTC_BsBtnRender();
}
//==================================================================================================
// 【自定义剧本】（用户 2026-10-03）
//   选板子页最下方那颗【自定义剧本】点进去 → 黑布不撤，上面盖一层：
//   · 正上方 6 个分类按钮：镇民 / 外来者 / 爪牙 / 恶魔 / 传奇角色 / 奇遇角色
//   · 左盘块 = 该分类**目前有的全部角色**（点图标 = 选中 / 取消），左盘块右下角【上一页】【下一页】
//   · 右盘块 = 已选角色（紧凑版，中号图标 + 名字，不带技能；点一下 = 取消）
//   · 最右下角【保存】（写进本机 bank）/【开始游戏】（当成第 7 张板子直接开局）
//   上限：镇民 14 / 外来者 5 / 爪牙 5 / 恶魔 5 / 传奇 2 / 奇遇 2，右侧一共摆得下 33 格
//==================================================================================================
// 【私货商人（130）】自定义文本。默认值用官网能力；输入后可覆盖。
string BOTC_BootleggerDefaultText () {
    return "这个剧本包含有自制角色或自制规则。";
}

string BOTC_BootleggerEffectiveText () {
    // 全员追忆（板子 13）：本图私货商人写的是整套失忆规则。
    if (g_board == 13 && g_legacyOn[130]) {
        return "全员追忆规则：1. 游戏开始时，玩家只会得知自己的角色类型（镇民、外来者、爪牙或恶魔），不会得知具体角色名；真实角色只有说书人知道。2. 玩家仍可正常获取信息，恶魔正常得知爪牙是谁，爪牙正常互认，夜间仍按真实角色被唤醒并发动能力。3. 恶魔不会自动获得三个不在场身份，但说书人仍可按需发送。4. 每个白天，玩家可以私下向说书人猜测一个关于自己技能的问题；回答为「无关 / 有关 / 接近 / 完美」，只有完全答对才是「完美」。问题只能与自己的技能有关，不能直接询问角色名、字数或所属剧本。5. 遇到认知覆盖时，玩家只获得自己所认知角色的信息，猜测也只指向这名认知角色。6. 每天黄昏时，说书人公布目前已有多少名玩家猜中并获得「完美」。7. 说书人在夜间唤醒时的话术与行动，是玩家推断真实角色的重要线索。";
    }
    // 心理博弈 XI 的板载私货商人规则：不采用麻脸巫婆×利维坦相克，第五天后仍可由麻脸巫婆创造利维坦。
    if (g_board == 11 && g_legacyOn[130]) {
        return "本剧本不采用麻脸巫婆与利维坦的相克规则。第五个白天之后，麻脸巫婆可以创造利维坦。";
    }
    if (StringLength(g_bootText) > 0) {
        return g_bootText;
    }
    return BOTC_BootleggerDefaultText();
}

// 全员追忆是固定规则文本：预先把每一行写好，避免运行时按 UTF-8 字节截断产生问号。
string BOTC_BootleggerAmnesiaLine (int i) {
    if (i == 0)  { return "全员追忆规则："; }
    if (i == 1)  { return "1. 游戏开始时，玩家只会得知自己的角色类型（镇民、外来者、爪牙或恶魔），"; }
    if (i == 2)  { return "不会得知具体角色名；真实角色只有说书人知道。"; }
    if (i == 3)  { return "2. 玩家仍可正常获取信息，恶魔正常得知爪牙是谁，爪牙正常互认，"; }
    if (i == 4)  { return "夜间仍按真实角色被唤醒并发动能力。"; }
    if (i == 5)  { return "3. 恶魔不会自动获得三个不在场身份，但说书人仍可按需发送。"; }
    if (i == 6)  { return "4. 每个白天，玩家可以私下向说书人猜测一个关于自己技能的问题；"; }
    if (i == 7)  { return "回答为「无关 / 有关 / 接近 / 完美」，只有完全答对才是「完美」。"; }
    if (i == 8)  { return "问题只能与自己的技能有关，不能直接询问角色名、字数或所属剧本。"; }
    if (i == 9)  { return "5. 遇到认知覆盖时，玩家只获得自己所认知角色的信息，猜测也只指向这名认知角色。"; }
    if (i == 10) { return "6. 每天黄昏时，说书人公布目前已有多少名玩家猜中并获得「完美」。"; }
    if (i == 11) { return "7. 说书人在夜间唤醒时的话术与行动，是玩家推断真实角色的重要线索。"; }
    return "";
}

// 把自定义规则同步到角色能力表和角色详情。
void BOTC_BootleggerSyncText () {
    int i;
    int pos;
    int end;
    int n;
    int len;
    string s;
    string s2;
    s = BOTC_BootleggerEffectiveText();
    len = StringLength(s);
    // 能力表标签自己会按 460 像素宽度折行；不要预先插换行，避免把 UTF-8 汉字切坏。
    g_tipAbility[130] = StringToText(s);
    g_tipLine[3045] = StringToText("【角色能力】");
    for (i = 3046; i <= 3099; i += 1) {
        g_tipLine[i] = StringToText("");
    }
    n = 0;
    if (g_board == 13 && g_legacyOn[130]) {
        while (n < 54 && BOTC_BootleggerAmnesiaLine(n) != "") {
            g_tipLine[3046 + n] = StringToText(BOTC_BootleggerAmnesiaLine(n));
            n = n + 1;
        }
        g_tipRoleN[130] = 1 + n;
        return;
    }
    pos = 1;
    while (pos <= len && n < 54) {
        // 角色详情列表约 29 个汉字一行；提前换行，避免长规则被面板右侧截断。
        end = pos + 89;
        if (end > len) { end = len; }
        s2 = StringSub(s, pos, end);
        while (end > pos && StringLength(s2) > 0 && StringSub(s2, StringLength(s2), StringLength(s2)) == "?") {
            end = end - 1;
            s2 = StringSub(s, pos, end);
        }
        g_tipLine[3046 + n] = StringToText(s2);
        n = n + 1;
        pos = end + 1;
    }
    g_tipRoleN[130] = 1 + n;
}

void BOTC_BootleggerCapture () {
    string s;
    if (g_cBootEdit >= 1) {
        s = libNtve_gf_DialogItemEditValue(g_cBootEdit, g_teller);
        // 点击其他控件时，EditBox 可能短暂返回空串；不能用它覆盖已经读到的规则。
        if (StringLength(s) > 0 || StringLength(g_bootText) == 0) {
            g_bootText = s;
        }
    }
}

void BOTC_BootleggerEditRefresh () {
    if (g_cBootEdit >= 1) {
        libNtve_gf_SetDialogItemText(g_cBootEdit, StringToText(g_bootText), PlayerGroupAll());
    }
}

void BOTC_BootleggerAnnounce () {
    int len;
    int pos;
    int end;
    string s;
    string b;
    if (!g_legacyOn[130]) {
        return;
    }
    BOTC_BootleggerSyncText();
    s = BOTC_BootleggerEffectiveText();
    len = StringLength(s);
    BOTC_PubAnnounce("【私货商人】本局自定义规则：");
    if (g_board == 13 && g_legacyOn[130]) {
        len = 0;
        while (len < 54 && BOTC_BootleggerAmnesiaLine(len) != "") {
            BOTC_PubAnnounce(BOTC_BootleggerAmnesiaLine(len));
            len = len + 1;
        }
        return;
    }
    pos = 1;
    while (pos <= len) {
        // 公聊约 33 个汉字一行（按 UTF-8 字节额度），提前换行避免显示不全。
        end = pos + 99;
        if (end > len) { end = len; }
        b = StringSub(s, pos, end);
        while (end > pos && StringLength(b) > 0 && StringSub(b, StringLength(b), StringLength(b)) == "?") {
            end = end - 1;
            b = StringSub(s, pos, end);
        }
        BOTC_PubAnnounce(b);
        pos = end + 1;
    }
}

// 【自定义剧本可选项】骑士、杂技演员已恢复显示；其余旧《赎罪小镇》隐藏角色保持原状。
bool BOTC_CustomRoleVisible (int r) {
    if (r >= 143 && r <= 146) {
        return false;                 // 全员追忆的玩家视角占位身份不进入自定义角色池
    }
    if (r == 123 || r == 124 || r == 126) {
        return false;
    }
    return true;
}

int BOTC_CustomSlotRow (int s) {
    if (s < 8) { return 176; }
    if (s < 16) { return 266; }
    if (s < 21) { return 396; }
    if (s < 26) { return 516; }
    if (s < 31) { return 636; }
    if (s < 33) { return 756; }
    return 876;
}

int BOTC_CustomSlotCol (int s) {
    if (s < 8) { return s; }
    if (s < 16) { return s - 8; }
    if (s < 21) { return s - 16; }
    if (s < 26) { return s - 21; }
    if (s < 31) { return s - 26; }
    if (s < 33) { return s - 31; }
    return s - 33;
}

int BOTC_CustomSlotBase (int team) {
    if (team == 0) { return 0; }
    if (team == 1) { return 16; }
    if (team == 2) { return 21; }
    if (team == 3) { return 26; }
    if (team == 4) { return 31; }
    return 33;
}

int BOTC_CustomSlotMax (int team) {
    if (team == 0) { return 16; }
    if (team == 4 || team == 5) { return 2; }
    return 5;
}

int BOTC_CustomGrpY (int i) {
    if (i == 0) { return 148; }
    if (i == 1) { return 368; }
    if (i == 2) { return 488; }
    if (i == 3) { return 608; }
    if (i == 4) { return 728; }
    return 848;
}

string BOTC_CustomCatName (int cat) {
    if (cat == 0) {
        return "镇民";
    }
    if (cat == 1) {
        return "外来者";
    }
    if (cat == 2) {
        return "爪牙";
    }
    if (cat == 3) {
        return "恶魔";
    }
    if (cat == 4) {
        return "传奇角色";
    }
    return "奇遇角色";
}

int BOTC_CatCap (int cat) {
    if (cat == 0) {
        return 14;
    }
    if (cat == 4 || cat == 5) {
        return 2;               // 与右侧传奇 / 奇遇各两格保持一致
    }
    return 5;
}

// 这个分类目前有几个角色（分类号 = 阵营号：0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔 / 4 传奇 / 5 奇遇）
int BOTC_CatRoleN (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        n = n + 1;
    }
    return n;
}

// 第 i 个该分类的角色（-1 = 没有）
int BOTC_CatRoleAt (int cat, int i) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        if (n == i) {
            return r;
        }
        n = n + 1;
    }
    return -1;
}

int BOTC_CatPicked (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_CatPickedAll () {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

void BOTC_CustomRender () {
    int i;
    int r;
    int n;
    int pages;
    int used;
    int cc;
    int hn;
    int lty;
    int cx;
    int cy;
    string s;
    // 6 个分类按钮 + 计数，当前分类前面加 ▶
    for (i = 0; i < 6; i += 1) {
        s = BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i)) + "/" + IntToString(BOTC_CatCap(i));
        if (i == g_cat) {
            s = "▶ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cCatBtn[i], StringToText(s), PlayerGroupAll());
    }
    // 左盘块
    n = BOTC_CatRoleN(g_cat);
    pages = (n + 53) / 54;
    if (pages < 1) {
        pages = 1;
    }
    if (g_cpage < 0) {
        g_cpage = 0;
    }
    if (g_cpage > pages - 1) {
        g_cpage = pages - 1;
    }
    for (i = 0; i < 54; i += 1) {
        if (i >= 54) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        cx = 18 + ((i % 9) * 120);
        cy = 166 + ((i / 9) * 100);
        DialogControlSetPosition(g_cIcon[i], PlayerGroupAll(), c_anchorTopLeft, cx + 29, cy);
        DialogControlSetPosition(g_cIconImg[i], PlayerGroupAll(), c_anchorTopLeft, cx + 18, cy - 8);   // 【图标偏移】（用户 2026-10-04 定稿：X=18 / Y=-8）
        DialogControlSetPosition(g_cName[i], PlayerGroupAll(), c_anchorTopLeft, cx + 2, cy + 66);
        r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
        if (r < 0) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cName[i], PlayerGroupAll(), true);
        libNtve_gf_SetDialogItemImage(g_cIconImg[i], BOTC_NightIconName(r), PlayerGroupAll());
        s = g_roleName[r];
        if (g_csel[r]) {
            s = "√ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cName[i], TextWithColor(StringToText(s), BOTC_RoleTeamColor(r)), PlayerGroupAll());
    }
    // 【暴风捕手（113）】（用户 2026-10-10）：选了他就显示他保护谁；正在等他选就提示点一个角色
    if (g_cStormPick) {
        libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("【暴风捕手】点一个角色 = 保护他（当前：" + g_roleName[g_cStormRole] + "）"), PlayerGroupAll());
    }
    else {
        if (g_csel[113]) {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消   【暴风捕手】保护：" + g_roleName[g_cStormRole]), PlayerGroupAll());
        }
        else {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消"), PlayerGroupAll());
        }
    }
    libNtve_gf_SetDialogItemText(g_cPageLbl, StringToText(BOTC_CustomCatName(g_cat) + "：第 " + IntToString(g_cpage + 1) + " / " + IntToString(pages) + " 页（共 " + IntToString(n) + " 个）"), PlayerGroupAll());
    // 右盘块：按阵营分组往下排（每组一行彩色标题 + 图标，名字在图标下面）
    used = 0;
    cc = 0;
    hn = 0;
    lty = -1;
    cy = 150;
    for (i = 0; i < 35; i += 1) {
        DialogControlSetVisible(g_cSelIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cSelIconImg[i], PlayerGroupAll(), false);
        libNtve_gf_SetDialogItemText(g_cSelName[i], StringToText(""), PlayerGroupAll());
    }
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_cGrpLbl[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < 6; i += 1) {
        r = BOTC_CatRoleAt(i, 0);
        if (r < 0) {
            r = 88;
        }
        libNtve_gf_SetDialogItemText(g_cGrpLbl[i], TextWithColor(StringToText(BOTC_CustomCatName(i)), BOTC_RoleTeamColor(r)), PlayerGroupAll());
        used = BOTC_CustomSlotBase(i);
        for (r = 0; r <= 148; r += 1) {
            if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
                continue;
            }
            if (g_roleTeam[r] != i) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i)) {
                break;
            }
            libNtve_gf_SetDialogItemImage(g_cSelIconImg[used], BOTC_NightIconName(r), PlayerGroupAll());
            libNtve_gf_SetDialogItemText(g_cSelName[used], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupAll());
            DialogControlSetVisible(g_cSelIcon[used], PlayerGroupAll(), true);
            DialogControlSetVisible(g_cSelIconImg[used], PlayerGroupAll(), true);
            used = used + 1;
        }
        for (r = used; r < BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i); r += 1) {
            DialogControlSetVisible(g_cSelIcon[r], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cSelIconImg[r], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cSelName[r], StringToText(""), PlayerGroupAll());
        }
    }
    if (g_customSlot >= 1 && g_customSlot <= 6) {
        s = "自定义板 " + IntToString(g_customSlot) + "　已选 " + IntToString(used) + " / 35　";
    }
    else {
        s = "请选择下方自定义板 1..6　已选 0 / 35　";
    }
    for (i = 0; i < 6; i += 1) {
        if (i > 0) {
            s = s + " · ";
        }
        s = s + BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i));
    }
    libNtve_gf_SetDialogItemText(g_cSelTitle, StringToText(s), PlayerGroupAll());
    if (g_csel[130]) {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), true);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), false);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), false);
    }
}

void BOTC_AlchemistGuess (int p, int role) {
    if (p < 1 || p > 13) {
        return;
    }
    if (role != 18 && role != 75) {
        return;
    }
    if (g_alcSeat < 2 || g_alcSeat > 13) {
        return;
    }
    g_alcBy = p;
    BOTC_PubAnnounce("【炼金术士】" + BOTC_NameStr(p) + " 公开猜测 " + BOTC_NameStr(g_alcSeat) + " 是" + g_roleName[role] + "。");
    // 谁都可以公开声称炼金术士；只有真正拥有这项能力且当前清醒的人产生效果。
    // 伪造声称不能覆盖真炼金术士已经记下的结果。
    if (BOTC_SeatDead(p) || !BOTC_AbilityWorks(p, 95)) {
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 声称猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：这只是声称，不结算。");
        return;
    }
    if (BOTC_SeatTrueRole(g_alcSeat) == role) {
        g_alcGuess = g_alcSeat;
        g_alcDay = g_dayNum + 1;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜对了。");
    }
    else {
        g_alcGuess = 0;
        g_alcDay = 0;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜错了。");
    }
}
void BOTC_AlcBorrowOpen (int p) {
    int q;
    if (p < 2 || p > 13) {
        return;
    }
    // 【炼金术士(95)】（用户 2026-10-03）：这一格是**说书人**替他选借到哪只爪牙，
    //   所以面板开在**说书人**身上；被借能力的座位（p）记在 g_pickWho[g_teller]，点完由 BOTC_PickChoose 的模式 21 应用。
    g_pickMode[g_teller] = 21;
    g_pickWho[g_teller] = p;
    g_pickTeam = 2;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 2) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}
void BOTC_AlchemistAsk (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    g_alcChoice[p] = true;
    g_alcPick[p] = false;
    g_alcRolePick[p] = 0;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    // 复用已经稳定的通用身份面板，避免独立小窗在某些客户端层级下不显示。
    g_pickMode[p] = 20;
    g_pickWho[p] = p;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
    }
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    BOTC_DeclareSlot(p, 57, 18, 0, g_roleName[18]);
    BOTC_DeclareSlot(p, 58, 75, 1, g_roleName[75]);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("猜间谍还是寡妇？"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}
void BOTC_AlchemistPickRole (int p, int role) {
    if (p < 1 || p > 13 || !g_alcChoice[p]) {
        return;
    }
    g_alcChoice[p] = false;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    if (role != 18 && role != 75) {
        g_alcPick[p] = false;
        g_alcRolePick[p] = 0;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消炼金术士声称。");
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_alcRolePick[p] = role;
    g_alcPick[p] = true;
    BOTC_DeclareRender();
    BOTC_Notice(p, "你选择猜【" + g_roleName[role] + "】。现在点一名存活玩家。");
}
