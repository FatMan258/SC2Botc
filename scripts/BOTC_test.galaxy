// ⚠ Galaxy 的数组写法：维度要写在**类型后面**（int[4] 名字;），写成 int 名字[4]; 会编译报错
int[4]      g_nomBigLbl;
string[4]   g_nomBigCh;         // 提 / 名 / 开 / 始
string      g_nomBigStyle;      // 这 4 个字的字体样式（聊天指令 nstyle <名字> 能现场换）
// 魔典上「座位名」那一行（比如「6 图书管理员」）的字体样式
//   ⚠ 原来那个 mod 里自带 UI/FontStyles.SC2Style（定义过 UnitWireframeVitalLarge 等 28 个样式）；
//     新 mod 没带这张字体表 → 那个样式名失效、退回游戏默认字体，字明显偏大、长名字会被框截断。
//     所以这里改用基础游戏里确定有的「ModLeftSize16Bold」；嫌大嫌小用聊天指令 gstyle <样式名> 现场换。
string      g_grimNameStyle;
// 【汉字字形预热】（用户 2026-09-19）：魔典座位上的身份名 / 「分配身份」面板里的角色名，
//   第一次显示时星际要现场把汉字栅格化进字体图集，看起来就像「一个字一个字往外蹦」。
//   这两个控件是开局那张黑布底下的预热标签（黑布盖得住，玩家看不见），把字形先焐热。
int         g_warmDlg;
int         g_warmLbl;
// 名字前面那个方括号序号 = 游戏内号 + 这个偏移（玩家 2026-09-16 反馈默认差一位 → 默认 -1）
//   聊天指令 nameoff <数字> 能现场调（0 = 跟游戏内号一致，越负越小）
int         g_nameNumShift;
bool        g_nomBigOn;         // 现在是不是在演这个动画
int         g_nomBigIdx;        // 已经亮到第几个字
int         g_nomBigHold;       // 4 个字都出来之后的「多留几拍」计数
// 创建这 4 个标签时传给「创建对话框项（标签）」最后那个固定值（原来是 2.0）----
//   怀疑它跟字体大小有关，用聊天指令 nbig <数字> 现场重建试（不用重粘脚本）
fixed       g_nomBigSize;
timer       g_tNomBig;
trigger     g_tNomBigTrig;
