    g_tipLine[759] = StringToText("每个夜晚，你要选择一名玩家：他") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[760] = StringToText("上个因你的能力") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的玩家会死亡并恢复健康。");
    g_tipLine[761] = StringToText("【角色简介】");
    g_tipLine[762] = TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("能让他的受害者") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，并在之后毒发身亡。");
    g_tipLine[763] = StringToText("当") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("攻击时，他的受害者会立即") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。在下一个夜晚，该名玩家会在") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("发起下一次");
    g_tipLine[764] = StringToText("攻击之后的时间点死亡。");
    g_tipLine[765] = StringToText("不同于其他") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("在首个夜晚就会行动。");
    g_tipLine[766] = TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("能防止") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("被唤醒来使玩家") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("能防止") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("杀死已经") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的玩家，随");
    g_tipLine[767] = StringToText("后该玩家会恢复健康。");
    g_tipLine[768] = StringToText("如果") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("状态的") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("选择了一名玩家，该玩家不会") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，也不会在下一个夜晚死亡。");
    g_tipLine[769] = StringToText("如果") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("在上一个夜晚选择玩家时是清醒的，但是当晚") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("了，该玩家不会死亡。但是");
    g_tipLine[770] = StringToText("当") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("恢复清醒，") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("效果会恢复，且会在随后的夜晚杀死该玩家。");
    g_tipLine[771] = StringToText("【规则细节】");
    g_tipLine[772] = StringToText("相克规则：");
    g_tipLine[773] = StringToText("召唤师");
    g_tipLine[774] = StringToText("：召唤师可以在第二个夜晚召唤") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("来替代第三个夜晚的召唤。");
    g_tipLine[775] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[776] = StringToText("戏子");
