void BOTC_BuildManInfo () {
    // 【技能框往右挪 200】（用户 2026-09-23）：信息位答题框（共情者 / 厨师 / 占卜师 / 气球驾驶员…）
    DialogCreate(684, 216, c_anchorRight, 185, -70, false);
    g_miDlg = DialogLastCreated();
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    g_miTitle = BOTC_NewLabel(g_miDlg, 648, 56, 18, 14, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_miTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_miTitle, false, PlayerGroupAll());
    g_miEdit = BOTC_NewEdit(g_miDlg, 180, 41, 252, 83);
    g_miEdit2 = BOTC_NewEdit(g_miDlg, 162, 41, 360, 83);
    g_miEdit3 = BOTC_NewEdit(g_miDlg, 150, 41, 360, 83);
    g_miEdit4 = BOTC_NewEdit(g_miDlg, 150, 41, 477, 83);
    DialogControlSetVisible(g_miEdit3, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupAll(), false);
    g_miOk = BOTC_NewButton(g_miDlg, 216, 40, 126, 155, "确定（发给他）");
    g_miCancel = BOTC_NewButton(g_miDlg, 144, 40, 396, 155, "取消");
    g_miNote = BOTC_NewLabel(g_miDlg, 648, 26, 18, 131, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_miNote, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_miNote, false, PlayerGroupAll());
