        //   （用户 2026-09-19）顺手把「主人」token 挪到新主人身上：先清掉上一次那位
        if (g_butlerMaster >= 2) {
            g_tokOn[(((g_teller * 14) + g_butlerMaster) * 256) + 20] = false;
        }
        g_butlerSeat = p;
        g_butlerMaster = g_skillT1[p];
        if (!BOTC_SkillWorks(p)) {
