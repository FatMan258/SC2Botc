    g_winAdminBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 54, "胜负");
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupAll(), false);
}

// 身份选择面板
// 选身份面板（用户 2026-09-19 重做）：改成图标网格 ----
//   85×85 中图（botc_nightNN）+ 下面一行角色名，按 镇民 / 外来者 / 爪牙 / 恶魔 分块，
//   每块正上方一行**彩色类别标题**（方便新玩家认）；对话框从 1170×330 放大到 1170×860。
//   给某个座位指定身份、伪装身份、不在场身份、声称身份都用这个面板。
// 【网格计划】按当前板子的角色清单（g_boardRole）算「第几格摆哪个身份」
//   每类一块，块内每行 7 个；块的纵向起点见 BOTC_GridBlockY
void BOTC_GridPlan () {
    int t;
    int i;
    int r;
    int n;
    int slot;
    int b;
    // 还没选出板子（g_board = 0）时按 1 号板子算，免得整个网格是空的（用户 2026-09-19）
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    for (i = 0; i < 64; i += 1) {
        g_gridSlot[i] = -1;
        g_gridTeam[i] = 0;
        g_gridIdx[i] = 0;
    }
    for (t = 0; t < 4; t += 1) {
        g_gridTeamN[t] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        n = 0;
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            r = g_boardRole[(b * 256) + i];
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (slot > 63) {
                break;
            }
            g_gridSlot[slot] = r;
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = n;
            slot = slot + 1;
            n = n + 1;
        }
        g_gridTeamN[t] = n;
    }
    g_gridN = slot;
}

int BOTC_GridCatCap (int t) {
    if (t == 0) {
        return 14;
    }
    return 7;
}

int BOTC_AbCatCap (int t) {
    if (t == 0) {
        return 14;
    }
    return 6;
}

int BOTC_GridCatPages (int t, int cap) {
    int pages;
    if (t < 0 || t > 3 || cap <= 0) {
        return 1;
    }
    pages = (g_gridCatN[t] + cap - 1) / cap;
    if (pages < 1) {
        pages = 1;
    }
    return pages;
}

void BOTC_GridBuildCat () {
    int b;
    int i;
    int r;
    int t;
    for (i = 0; i < 512; i += 1) {
        g_gridCatRole[i] = -1;
    }
    for (t = 0; t < 4; t += 1) {
        g_gridCatN[t] = 0;
    }
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 148) {
            continue;
        }
        t = BOTC_RoleTeam(r);
        if (t < 0 || t > 3) {
            continue;
        }
        if (g_gridCatN[t] >= 128) {
            continue;
        }
        g_gridCatRole[(t * 128) + g_gridCatN[t]] = r;
        g_gridCatN[t] = g_gridCatN[t] + 1;
    }
}

// 每一类的纵向起点（跟以前手调的那几个数一样：76 / 366 / 526 / 686）
int BOTC_GridBlockY (int t) {
    if (t == 1) {
        return 366;
    }
    if (t == 2) {
        return 526;
    }
    if (t == 3) {
        return 686;
    }
    return 76;
}

// 选身份面板的布局：只渲染指定玩家的那一份，页码和格子映射也按玩家独立保存。
void BOTC_PickLayoutFor (int p) {
    int j;
    int t;
    int k;
    int cap;
    int page;
    int pages;
    int shown;
    int slot;
    int x;
    int y;
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_GridBuildCat();
    for (j = 0; j < 64; j += 1) {
        g_gridSlot[j] = -1;
        g_gridTeam[j] = 0;
        g_gridIdx[j] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        cap = BOTC_GridCatCap(t);
        pages = BOTC_GridCatPages(t, cap);
        page = g_pickCatPageBy[(p * 4) + t];
        if (page < 1) {
            page = 1;
        }
        if (page > pages) {
            page = pages;
        }
        g_pickCatPageBy[(p * 4) + t] = page;
        k = (page - 1) * cap;
        shown = 0;
        while (k < g_gridCatN[t] && shown < cap && slot < 64) {
            g_gridSlot[slot] = g_gridCatRole[(t * 128) + k];
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = shown;
            x = 60 + ((shown % 7) * 120);
            y = BOTC_GridBlockY(t) + ((shown / 7) * 130);
            DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
            libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(g_gridSlot[slot]), PlayerGroupSingle(p));
            libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(g_roleName[g_gridSlot[slot]]), BOTC_RoleTeamColor(g_gridSlot[slot])), PlayerGroupSingle(p));
            DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
            DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
            DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
            slot = slot + 1;
            k = k + 1;
            shown = shown + 1;
        }
        g_gridTeamN[t] = shown;
    }
    g_gridN = slot;
    for (j = slot; j < 64; j += 1) {
        DialogControlSetVisible(g_pickBtn[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[j], PlayerGroupSingle(p), false);
    }
    for (j = 0; j < 64; j += 1) {
        g_pickSlotRole[(p * 64) + j] = g_gridSlot[j];
    }
    for (j = 0; j < 4; j += 1) {
        DialogControlSetPosition(g_pickSec[j], PlayerGroupSingle(p), c_anchorTopLeft, 30, BOTC_GridBlockY(j) - 30);
        DialogControlSetVisible(g_pickSec[j], PlayerGroupSingle(p), (g_gridCatN[j] > 0));
        pages = BOTC_GridCatPages(j, BOTC_GridCatCap(j));
        if (pages > 1) {
            libNtve_gf_SetDialogItemText(g_pickCatPrev[j], StringToText("<"), PlayerGroupSingle(p));
            libNtve_gf_SetDialogItemText(g_pickCatNext[j], StringToText(">"), PlayerGroupSingle(p));
        }
        DialogControlSetVisible(g_pickCatPrev[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[j], PlayerGroupSingle(p), false);
    }
}

// 刷新全部玩家各自的一份；首次建面板 / 换板时使用。
void BOTC_PickLayout () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        BOTC_PickLayoutFor(p);
    }
}

void BOTC_BuildPick () {
    int j;
    int p;
    int x;
    int y;
    DialogCreate(1170, 860, c_anchorCenter, 375, -70, false);
