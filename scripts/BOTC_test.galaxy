        BOTC_SweetPickAt(g_skillT1[p]);
        // 【收面板】（用户 2026-09-21 报「点了确认关不掉」）：这些说书人专用分支提前 return，
        //   走不到函数结尾那句关闭 ---- 每条分支自己关一次
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
