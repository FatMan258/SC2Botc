    g_jinxA[97] = 71;  g_jinxB[97] = 131;
    g_jinxText[97] = "涡流与报丧女妖：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的『通用简化原则』已涵盖包括多角色互动下";
