        //   被保护的人不会收到任何提示（规则如此）：标记只有说书人那份魔典上看得到
        if (!BOTC_SkillWorks(p)) {
            // 僧侣自己中毒 / 酒鬼：技能失效 ---- 连「保护」标记都不打，被保护的人也就没有。
            //   本人不当场知道（他以为自己保护成功了），只私聊告诉说书人
            BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次保护无效，没有打标记。");
        }
        else {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 9] = true;
