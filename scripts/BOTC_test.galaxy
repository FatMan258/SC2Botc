    g_tipLine[476] = StringToText("：一名已获得过") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("能力的姑获鸟被") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选中，他能够因为") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("的能力被唤醒。");
