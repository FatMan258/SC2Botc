    t = BOTC_PutWord(t, "杂技演员", Color(0, 191, 255)); // 镇民
    t = BOTC_PutWord(t, "赶尸人", Color(255, 69, 0));    // 爪牙
    t = BOTC_PutWord(t, "利维坦", Color(255, 0, 0));     // 恶魔
    t = BOTC_PutWord(t, "私货商人", Color(255, 215, 0)); // 奇遇角色
    // 【信口雌黄（板子 12）】
    t = BOTC_PutWord(t, "报丧女妖", Color(0, 191, 255));
    t = BOTC_PutWord(t, "科学怪人", Color(255, 69, 0));
    t = BOTC_PutWord(t, "牙噶巴卜", Color(255, 0, 0));
    t = BOTC_PutWord(t, "奥赫", Color(255, 0, 0));
    t = BOTC_PutWord(t, "卡扎力", Color(255, 0, 0));
    // 【自定义剧本·保存成功】（用户 2026-10-04）：要绿字。系统行（who == 0）整行刷的是 BDB76B，
    //   而关键词是「内层颜色」→ 把「保存成功」标成绿色，这一行就会显示成绿的。
    t = BOTC_PutWord(t, "保存成功", Color(120, 255, 120));
    return t;
}

// BOTC_NameSubst 的 text 版本（原来那个只吃 string，这里给系统提示拼色用）
text BOTC_NameSubstText (text t) {
    int p;
    int q;
    int seat;
    // 【两段式替换】（用户 2026-10-06 报「玩家10 以上名字串位」）：
    //   单段式替换时，**换进去的真名里可能又含「玩家N」**（电脑的名字就叫"玩家10"），
    //   后面的短编号（玩家1）就会把它再替一次 → 剩下个尾巴 `0`（就是那个 `[9] [1] 玩家2` + `0`）。
    //   所以先全部换成不会互相匹配的标记 `@@N@@`，第二段再把标记换成真名 —— 谁也不会被替第二遍。
    // 【第一段：把「玩家N」换成按**位置**编号的标记 @@位置@@】（用户 2026-10-07 重写）：
    //   写侧现在写的是 `BOTC_NameStr(位置)` = "玩家" + g_lab[位置]（= 编号）；这里按位置 p 循环，
    //   两种写法都收（"玩家p" = 有人按位置写、也兼容旧文本；"玩家p-1" = 有人按编号写），
    //   统一变成 @@p@@ —— 第二段直接拿 p 当**位置**用，不再查 g_lab。
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p - 1)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("说书人："), StringToText("@@0@@"), c_stringReplaceAll, true);
    // 【第二段：@@位置@@ → 那个格子现在坐的人】（用户 2026-10-07）：写侧和第一段都用**位置**，
    //   所以这里直接用 p，不需要再拿 g_lab 反查（旧代码那一步会把位置又当成编号、错开一位）。
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("@@" + IntToString(p) + "@@"), BOTC_PlayerNameText(p), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("@@0@@"), BOTC_PlayerNameText(1) + StringToText("："), c_stringReplaceAll, true);
    // 【说话人标记 → 那个人现在的显示】（用户 2026-10-07）：按"人"查他现在坐哪一格
    for (p = 1; p <= 13; p += 1) {
        t = TextReplaceWord(t, StringToText(BOTC_SayToken(p)), BOTC_PlayerNameText(BOTC_PosOf(p)), c_stringReplaceAll, true);
    }
    return t;
}

// 聊天窗 / 私聊窗 / 日志页渲染时统一走它。
//   用户 2026-09-19：**系统提示**（who == 0，不是玩家发的）整行刷成 BDB76B，
//   关键词（镇民 / 外来者 / 爪牙 / 恶魔 / 中毒 / 善良 / 邪恶 + 22 个角色名）和玩家名是「内层」，
//   保留各自的颜色；玩家自己发的行（who != 0）完全不动。
//   ⚠ 顺序很关键：整行刷色必须放在**所有 TextReplaceWord 之后** ----
//     先刷色再替换的话，整词替换会把外层颜色重建掉（实测整行会变回白色）。
text BOTC_LineText (string line, int who) {
    text t;
    t = StringToText(line);
    if (who == 0) {
        t = BOTC_KeyColor(t);                          // 1) 关键词先上色
    }
    t = BOTC_NameSubstText(t);                         // 2) 「玩家N」「说书人：」换彩色名字
    if (who == 0) {
        t = TextWithColor(t, Color(189, 183, 107));    // 3) 最后整行刷 BDB76B（内层颜色保留）
    }
    return t;
}

// 身份图标文件名（打包在依赖的 Mod 里）
string BOTC_IconName (int idx) {
    if (idx == 148) {
        return "botc_role148.dds";
    }
    if (idx < 10) {
        return "botc_role0" + IntToString(idx) + ".dds";
    }
    return "botc_role" + IntToString(idx) + ".dds";
}

// 夜序表面板用的 85×85 小图（跟身份图同一套编号规则）
string BOTC_NightIconName (int idx) {
    if (idx == 148) {
        return "botc_night148.dds";
    }
    if (idx < 10) {
        return "botc_night0" + IntToString(idx) + ".dds";
    }
    return "botc_night" + IntToString(idx) + ".dds";
}
// 身份名按阵营上色（跟提示文案里的关键词一个色系）
color BOTC_RoleTeamColor (int r) {
    if (g_roleTeam[r] == 1) {
        return Color(0, 191, 255);      // 外来者
    }
    if (g_roleTeam[r] == 2) {
        return Color(255, 69, 0);       // 爪牙
    }
    if (g_roleTeam[r] == 3) {
        return Color(255, 0, 0);        // 恶魔
    }
    if (g_roleTeam[r] == 4) {
        return Color(255, 215, 0);      // 传奇角色
    }
    if (g_roleTeam[r] == 5) {
        return Color(255, 215, 0);      // 奇遇角色
    }
    return Color(0, 191, 255);            // 镇民
}

