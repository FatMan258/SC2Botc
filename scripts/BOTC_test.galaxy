    g_nomHead = BOTC_NewLabel(g_grimDlg, 540, 34, 473, 221, StringToText("提名环节"));
    libNtve_gf_SetDialogItemStyle(g_nomHead, "ModLeftSize20Bold", PlayerGroupAll());
