    g_tipLine[665] = StringToText("【角色简介】");
    g_tipLine[666] = TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("会在小镇杀害") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("时进行报复。");
    g_tipLine[667] = StringToText("每当一名") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("死于处决，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("会在当晚选择一名玩家，使其死亡。");
    g_tipLine[668] = StringToText("只有") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("在白天死去时，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("才能杀死玩家。夜晚死亡的") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("不算在内。");
    g_tipLine[669] = StringToText("如果") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("在场，会在场上增加或减少一个") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("。");
    g_tipLine[670] = StringToText("在游戏开始时，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("会得知哪些") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("在场。");
    g_tipLine[671] = StringToText("如果今天白天有两名") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("玩家死亡，当晚") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("仍然只能杀死一名玩家。");
    g_tipLine[672] = StringToText("【规则细节】");
