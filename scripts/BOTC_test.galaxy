        g_pickSec[j] = BOTC_NewLabel(g_pickDlg, 260, 26, 30, 46, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_pickSec[j], "ModLeftSize20Bold", PlayerGroupAll());
