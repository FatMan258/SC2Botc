    g_tipLine[455] = StringToText("【角色能力】");
    g_tipLine[456] = StringToText("每个夜晚*，你要选择一名玩家（与上个夜晚不同）：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，他会得知你");
    g_tipLine[457] = StringToText("是") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("，但他当晚不会因其自身能力而被唤醒。");
    g_tipLine[458] = StringToText("【角色简介】");
    g_tipLine[459] = TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("能阻止") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("被唤醒来发动攻击。");
    g_tipLine[460] = StringToText("除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("都需要选择一名玩家。如果所选玩家不是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，恶");
    g_tipLine[461] = StringToText("魔仍然可以发动攻击。如果选中了") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("当晚不会被唤醒，因而当晚不会选择玩家");
    g_tipLine[462] = StringToText("进行攻击。") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("会得知他不能发动攻击，且得知谁是") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[463] = StringToText("任何其他") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("能力仍然会生效----例如") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("被杀后依然保持存活，") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("会杀死他在上一");
    g_tipLine[464] = StringToText("个夜晚攻击的玩家，或是") + TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("反刍一名玩家。");
    g_tipLine[465] = TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("不能连续两个夜晚选择同一名玩家。");
    g_tipLine[466] = StringToText("【规则细节】");
    g_tipLine[467] = StringToText("相克规则：");
    g_tipLine[468] = StringToText("利维坦");
