    g_jinxA[16] = 94;  g_jinxB[16] = 31;
    g_jinxText[16] = "军团 × 吟游诗人：如果军团死于处决，所有军团保留能力，";
    g_jinxText2[16] = "但吟游诗人可能会在当晚得知今天白天死于处决的玩家是军团。";
    g_jinxText3[16] = "";
    g_jinxA[17] = 90;  g_jinxB[17] = 56;
    g_jinxText[17] = "赏金猎人 × 哲学家：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。";
    g_jinxText2[17] = "";
    g_jinxText3[17] = "";
    g_jinxA[18] = 86;  g_jinxB[18] = 94;
    g_jinxText[18] = "罂粟种植者 × 军团：军团玩家不会知道其他军团玩家是谁，";
    g_jinxText2[18] = "但需要单独唤醒他们以提供他们的三个不在场角色。";
    g_jinxText3[18] = "";
    g_jinxA[19] = 86;  g_jinxB[19] = 92;
    g_jinxText[19] = "罂粟种植者 × 告密者：即使罂粟种植者在场，爪牙也会被单独唤醒并被展示三个不在场角色。";
    g_jinxText2[19] = "";
    g_jinxText3[19] = "";
    g_jinxA[20] = 86;  g_jinxB[20] = 91;
    g_jinxText[20] = "罂粟种植者 × 小精灵：如果罂粟种植者被处决，且足够疯狂的小精灵知晓了他，";
    g_jinxText2[20] = "那么小精灵在获得罂粟种植者能力的同时也会阻止恶魔与爪牙互认。";
    g_jinxText3[20] = "";
    g_jinxA[21] = 87;  g_jinxB[21] = 42;
    g_jinxText[21] = "哈迪寂亚与主谋：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：";
    g_jinxText2[21] = "如果他们都选择存活，邪恶阵营获胜。否则，善良阵营获胜。";
    g_jinxText3[21] = "";
    g_jinxA[22] = 42;  g_jinxB[22] = 69;
    g_jinxText[22] = "主谋与亡骨魔：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。";
    g_jinxText2[22] = "";
    g_jinxText3[22] = "";
    g_jinxA[23] = 50;  g_jinxB[23] = 38;
    g_jinxText[23] = "数学家与疯子：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。";
    g_jinxText2[23] = "";
    g_jinxText3[23] = "";
    g_jinxA[24] = 50;  g_jinxB[24] = 14;
    g_jinxText[24] = "数学家与酒鬼：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。";
    g_jinxText2[24] = "";
    g_jinxText3[24] = "";
    g_jinxA[25] = 15;  g_jinxB[25] = 59;
    g_jinxText[25] = "陌客与贤者：陌客可能会被贤者当作杀死他的恶魔。";
    g_jinxText2[25] = "";
    g_jinxText3[25] = "";
    g_jinxA[26] = 19;  g_jinxB[26] = 87;
    g_jinxText[26] = "红唇女郎与哈迪寂亚：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，";
    g_jinxText2[26] = "则红唇女郎变成的恶魔会变回红唇女郎。";
    g_jinxText3[26] = "";
    g_jinxA[27] = 19;  g_jinxB[27] = 68;
    g_jinxText[27] = "红唇女郎与方古：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，";
    g_jinxText2[27] = "红唇女郎不会变成恶魔。";
    g_jinxText3[27] = "";
    g_jinxA[28] = 18;  g_jinxB[28] = 86;
    g_jinxText[28] = "间谍与罂粟种植者：如果罂粟种植者拥有能力，间谍无法查看魔典。";
    g_jinxText2[28] = "";
    g_jinxText3[28] = "";
    g_jinxA[29] = 18;  g_jinxB[29] = 82;
    g_jinxText[29] = "间谍与落难少女：如果间谍正在场或曾经在场，落难少女中毒。";
    g_jinxText2[29] = "";
    g_jinxText3[29] = "";
    g_jinxA[30] = 75;  g_jinxB[30] = 86;
    g_jinxText[30] = "寡妇与罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。";
    g_jinxText2[30] = "";
    g_jinxText3[30] = "";
    g_jinxA[31] = 75;  g_jinxB[31] = 82;
    g_jinxText[31] = "寡妇与落难少女：如果寡妇正在场或曾经在场，落难少女中毒。";
    g_jinxText2[31] = "";
    g_jinxText3[31] = "";
    g_jinxA[32] = 24;  g_jinxB[32] = 50;
    g_jinxText[32] = "侍女与数学家：侍女会得知数学家是否醒来，即使她是在数学家之前醒来。";
    g_jinxText2[32] = "";
    g_jinxText3[32] = "";
    g_jinxA[33] = 74;  g_jinxB[33] = 58;
    g_jinxText[33] = "食人族与杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，";
    g_jinxText2[33] = "当晚食人族会替杂耍艺人得知对应的信息。";
    g_jinxText3[33] = "";
    g_jinxA[34] = 74;  g_jinxB[34] = 13;
    g_jinxText[34] = "食人族与管家：如果食人族获得了管家的能力，他会得知这一信息。";
    g_jinxText2[34] = "";
    g_jinxText3[34] = "";
    g_jinxA[35] = 67;  g_jinxB[35] = 37;
    g_jinxText[35] = "麻脸巫婆与莽夫：被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。";
    g_jinxText2[35] = "";
    g_jinxText3[35] = "";
    g_jinxA[36] = 62;  g_jinxB[36] = 82;
    g_jinxText[36] = "理发师与落难少女：参考麻脸巫婆。建议「如果恶魔选择交换落难少女的角色，";
    g_jinxText2[36] = "参与角色交换的另一名玩家改为由说书人来决定」。";
    g_jinxText3[36] = "";
    g_jinxA[37] = 95;  g_jinxB[37] = 18;
    g_jinxText[37] = "炼金术士与间谍：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。";
    g_jinxText2[37] = "每次处决后，存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，";
    g_jinxText3[37] = "恶魔当晚必须选择间谍。";
    g_jinxA[38] = 95;  g_jinxB[38] = 75;
    g_jinxText[38] = "炼金术士与寡妇：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。";
    g_jinxText2[38] = "每次处决后，存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，";
    g_jinxText3[38] = "恶魔当晚必须选择寡妇。";
    g_jinxA[39] = 101;  g_jinxB[39] = 20;
    g_jinxText[39] = "异端分子与男爵：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[39] = "";
    g_jinxText3[39] = "";
    g_jinxA[40] = 101;  g_jinxB[40] = 100;
    g_jinxText[40] = "异端分子与痢蛭：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[40] = "";
    g_jinxText3[40] = "";
    g_jinxA[41] = 101;  g_jinxB[41] = 67;
    g_jinxText[41] = "异端分子与麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[41] = "";
    g_jinxText3[41] = "";
    g_jinxA[42] = 101;  g_jinxB[42] = 39;
    g_jinxText[42] = "异端分子与教父：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[42] = "";
    g_jinxText3[42] = "";
    g_jinxA[43] = 101;  g_jinxB[43] = 18;
    g_jinxText[43] = "异端分子与间谍：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[43] = "";
    g_jinxText3[43] = "";
    g_jinxA[44] = 101;  g_jinxB[44] = 75;
    g_jinxText[44] = "异端分子与寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[44] = "";
    g_jinxText3[44] = "";
    g_jinxA[45] = 94;  g_jinxB[45] = 97;
    g_jinxText[45] = "军团与政客：政客可能会被军团当作邪恶玩家。";
    g_jinxText2[45] = "";
    g_jinxText3[45] = "";
    g_jinxA[46] = 93;  g_jinxB[46] = 95;
    g_jinxText[46] = "提线木偶与炼金术士：如果炼金术士本应获得提线木偶的能力，";
    g_jinxText2[46] = "那么他不会拥有该能力并改为提线木偶一定在场。";
    g_jinxText3[46] = "";
    g_jinxA[47] = 42;  g_jinxB[47] = 95;
    g_jinxText[47] = "主谋与炼金术士：如果炼金术士本应获得主谋的能力，";
    g_jinxText2[47] = "那么他不会拥有该能力并改为主谋一定不在场。";
    g_jinxText3[47] = "";
    g_jinxA[48] = 67;  g_jinxB[48] = 97;
    g_jinxText[48] = "麻脸巫婆与政客：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。";
    g_jinxText2[48] = "";
    g_jinxText3[48] = "";
    g_jinxA[49] = 66;  g_jinxB[49] = 99;
    g_jinxText[49] = "洗脑师与哥布林：洗脑师可以选择将玩家洗脑成哥布林。";
    g_jinxText2[49] = "";
    g_jinxText3[49] = "";
    g_jinxA[50] = 100;  g_jinxB[50] = 42;
    g_jinxText[50] = "痢蛭与主谋：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。";
    g_jinxText2[50] = "";
    g_jinxText3[50] = "";
    g_jinxA[51] = 100;  g_jinxB[51] = 10;
    g_jinxText[51] = "痢蛭与猎手：如果猎手选择了痢蛭的宿主，则宿主会死亡。";
    g_jinxText2[51] = "";
    g_jinxText3[51] = "";
    g_jinxA[52] = 127;  g_jinxB[52] = 26;
    g_jinxText[52] = "利维坦与旅店老板：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，";
    g_jinxText2[52] = "善良阵营获胜。";
    g_jinxText3[52] = "";
    g_jinxA[53] = 127;  g_jinxB[53] = 12;
    g_jinxText[53] = "利维坦与镇长：如果利维坦和镇长在第五天存活，且第五天没有处决发生，";
    g_jinxText2[53] = "善良阵营获胜（即使镇长是邪恶阵营也是如此）。";
    g_jinxText3[53] = "";
    g_jinxA[54] = 127;  g_jinxB[54] = 11;
    g_jinxText[54] = "利维坦与士兵：如果利维坦提名并处决了士兵，善良阵营获胜。";
    g_jinxText2[54] = "";
    g_jinxText3[54] = "";
    g_jinxA[55] = 127;  g_jinxB[55] = 7;
    g_jinxText[55] = "利维坦与僧侣：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，";
    g_jinxText2[55] = "善良阵营获胜。";
    g_jinxText3[55] = "";
    g_jinxA[56] = 127;  g_jinxB[56] = 8;
    g_jinxText[56] = "利维坦与守鸦人：每个夜晚*，利维坦要选择一名存活善良玩家（不能与上一夜相同）：";
    g_jinxText2[56] = "如果选中守鸦人，他的能力生效但不会死亡；触发后他失去能力。";
    g_jinxText3[56] = "";
    g_jinxA[57] = 127;  g_jinxB[57] = 59;
    g_jinxText[57] = "利维坦与贤者：每个夜晚*，利维坦要选择一名存活善良玩家（不能与上一夜相同）：";
    g_jinxText2[57] = "如果选中贤者，他的能力生效但不会死亡；触发后他失去能力。";
    g_jinxText3[57] = "";
    g_jinxA[58] = 127;  g_jinxB[58] = 80;
    g_jinxText[58] = "利维坦与农夫：每个夜晚*，利维坦要选择一名存活善良玩家（不能与上一夜相同）：";
    g_jinxText2[58] = "如果选中农夫，他的能力生效但不会死亡；触发后他失去能力。";
    g_jinxText3[58] = "";
    g_jinxA[59] = 127;  g_jinxB[59] = 25;
    g_jinxText[59] = "利维坦与驱魔人：如果利维坦提名并处决了驱魔人上个夜晚选择的那名玩家，";
    g_jinxText2[59] = "善良阵营获胜。";
    g_jinxText3[59] = "";
    g_jinxA[60] = 127;  g_jinxB[60] = 22;
    g_jinxText[60] = "利维坦与祖母：如果利维坦在场，孙子死于处决，邪恶阵营获胜。";
    g_jinxText2[60] = "";
    g_jinxText3[60] = "";
    g_jinxA[61] = 127;  g_jinxB[61] = 104;
    g_jinxText[61] = "利维坦与国王：如果利维坦在场，当至少一名玩家死亡时，";
    g_jinxText2[61] = "国王每晚就会得知一个存活的角色。";
    g_jinxText3[61] = "";
    g_jinxA[62] = 127;  g_jinxB[62] = 67;
    g_jinxText[62] = "利维坦与麻脸巫婆：第五个白天之后，利维坦不能加入游戏。";
    g_jinxText2[62] = "";
    g_jinxText3[62] = "";
    g_jinxA[63] = 127;  g_jinxB[63] = 120;
    g_jinxText[63] = "利维坦与帽匠：第五个白天之后，利维坦不能加入游戏。";
    g_jinxText2[63] = "";
    g_jinxText3[63] = "";
    // ---- 《信口雌黄》科学怪人相克规则 ----
    g_jinxA[64] = 132;  g_jinxB[64] = 106;
    g_jinxText[64] = "科学怪人 × 异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。";
    g_jinxText2[64] = "";
    g_jinxText3[64] = "";
    g_jinxA[65] = 132;  g_jinxB[65] = 37;
    g_jinxText[65] = "科学怪人 × 莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。";
    g_jinxText2[65] = "";
    g_jinxText3[65] = "";
    g_jinxA[66] = 132;  g_jinxB[66] = 101;
    g_jinxText[66] = "科学怪人 × 异端分子：恶魔无法拥有异端分子的能力。";
    g_jinxText2[66] = "";
    g_jinxText3[66] = "";
    g_jinxA[67] = 132;  g_jinxB[67] = 97;
    g_jinxText[67] = "科学怪人 × 政客：恶魔无法拥有政客的能力。";
    g_jinxText2[67] = "";
    g_jinxText3[67] = "";
    g_jinxA[68] = 132;  g_jinxB[68] = 14;
    g_jinxText[68] = "科学怪人 × 酒鬼：恶魔不能获得酒鬼的能力。";
    g_jinxText2[68] = "";
    g_jinxText3[68] = "";
    g_jinxA[69] = 132;  g_jinxB[69] = 95;
    g_jinxText[69] = "科学怪人与炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。";
    g_jinxText2[69] = "";
    g_jinxText3[69] = "";
    g_jinxA[70] = 132;  g_jinxB[70] = 105;
    g_jinxText[70] = "科学怪人 × 村夫：如果村夫在场数量不足 3 人，科学怪人可以让恶魔拥有村夫的能力。";
    g_jinxText2[70] = "";
    g_jinxText3[70] = "";
    g_jinxA[71] = 132;  g_jinxB[71] = 118;
    g_jinxText[71] = "科学怪人 × 悟道者：恶魔无法拥有悟道者的能力。";
    g_jinxText2[71] = "";
    g_jinxText3[71] = "";
    // 现有角色之间的补充相克（2026-10-22）。
    g_jinxA[72] = 90;  g_jinxB[72] = 135;
    g_jinxText[72] = "赏金猎人与卡扎力：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。";
    g_jinxText2[72] = "";
    g_jinxText3[72] = "";
    g_jinxA[73] = 94;  g_jinxB[73] = 120;
    g_jinxText[73] = "军团与帽匠：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。";
    g_jinxText2[73] = "";
    g_jinxText3[73] = "";
    g_jinxA[74] = 127;  g_jinxB[74] = 131;
    g_jinxText[74] = "利维坦与报丧女妖：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果报丧女妖被选择，他死亡并";
    g_jinxText2[74] = "能力生效。";
    g_jinxText3[74] = "";
    g_jinxA[75] = 112;  g_jinxB[75] = 120;
    g_jinxText[75] = "小怪宝与帽匠：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。";
    g_jinxText2[75] = "";
    g_jinxText3[75] = "";
    g_jinxA[76] = 112;  g_jinxB[76] = 141;
    g_jinxText[76] = "小怪宝与维齐尔：如果维齐尔正照看小怪宝，他会在被处决时死亡。";
    g_jinxText2[76] = "";
    g_jinxText3[76] = "";
    g_jinxA[77] = 112;  g_jinxB[77] = 136;
    g_jinxText[77] = "小怪宝与魔术师：如果魔术师存活，由说书人决定谁照看小怪宝。";
    g_jinxText2[77] = "";
    g_jinxText3[77] = "";
    g_jinxA[78] = 136;  g_jinxB[78] = 94;
    g_jinxText[78] = "魔术师与军团：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。";
    g_jinxText2[78] = "";
    g_jinxText3[78] = "";
    g_jinxA[79] = 136;  g_jinxB[79] = 93;
    g_jinxText[79] = "魔术师与提线木偶：如果魔术师存活，恶魔不会得知谁是提线木偶。";
    g_jinxText2[79] = "";
    g_jinxText3[79] = "";
    g_jinxA[80] = 136;  g_jinxB[80] = 141;
