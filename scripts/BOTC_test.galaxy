        libNtve_gf_SetDialogItemAcceptMouse(g_pickIcon[j], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_pickIcon[j], "botc_blank.dds", PlayerGroupAll());
        g_pickName[j] = BOTC_NewLabelC(g_pickDlg, 105, 20, 50, 162, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_pickName[j], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_pickName[j], false, PlayerGroupAll());
    }
    for (p = 1; p <= 13; p += 1) {
        for (j = 0; j < 4; j += 1) {
            g_pickCatPageBy[(p * 4) + j] = 1;
        }
    }
    for (j = 0; j < 4; j += 1) {
        g_pickCatPage[j] = 1;          // 旧字段保留兼容
        y = BOTC_GridBlockY(j) + 86;
        if (j == 0) {
            y = 292;
        }
        g_pickCatPrev[j] = BOTC_NewButton(g_pickDlg, 38, 22, 865, y, "<");
        g_pickCatNext[j] = BOTC_NewButton(g_pickDlg, 38, 22, 909, y, ">");
        DialogControlSetVisible(g_pickCatPrev[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_pickCatNext[j], PlayerGroupAll(), false);
    }
    for (j = 1; j <= 13; j += 1) {
        g_pickFilterGood[j] = false;
        g_pickFilterTeam[j] = -1;
        g_pickFilterAlign[j] = -1;
    }
    BOTC_PickLayout();
    // 【强制阵营】（用户 2026-10-21）：放在身份网格右侧，善良 / 邪恶互斥勾选。
    g_pickAlignLbl = BOTC_NewLabel(g_pickDlg, 220, 28, 930, 40, StringToText("身份阵营"));
