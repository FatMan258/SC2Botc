    g_jinxText3[95] = "";
    g_jinxA[96] = 141;  g_jinxB[96] = 110;
    g_jinxText[96] = "维齐尔与狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。";
    g_jinxText2[96] = "";
