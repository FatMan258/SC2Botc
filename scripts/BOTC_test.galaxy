    g_tipLine[489] = StringToText("利维坦");
    g_tipLine[490] = StringToText("：如果利维坦提名并处决了") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("上个夜晚保护的其中一名玩家，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipLine[491] = StringToText("暴乱");
    g_tipLine[492] = StringToText("：如果暴乱提名并处决了") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("上个夜晚保护的其中一名玩家，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipRoleAt[26] = 477;    // 旅店老板
    g_tipRoleN[26] = 16;
    g_tipLine[493] = StringToText("【角色能力】");
    g_tipLine[494] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[495] = StringToText("【角色简介】");
    g_tipLine[496] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("能够猜测玩家的角色......但是猜错的代价是相当巨大的。");
    g_tipLine[497] = StringToText("除了首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，并在角色列表上指向一个角色");
    g_tipLine[498] = StringToText("图标来猜测其角色。如果猜测正确，无事发生。如果猜测错误，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("死亡。");
    g_tipLine[499] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[500] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("可以选择任何玩家，无论是已死亡还是存活，甚至可以是") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipRoleAt[27] = 493;    // 赌徒
    g_tipRoleN[27] = 8;
    g_tipLine[501] = StringToText("【角色能力】");
    g_tipLine[502] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[503] = StringToText("【角色简介】");
    g_tipLine[504] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[505] = StringToText("每个白天，") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("可以公开发表一个声明。如果该声明是正确的，说书人会在当晚杀死");
    g_tipLine[506] = StringToText("一名玩家。如果声明是错误的，那就没有玩家会因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("而死。");
    g_tipLine[507] = StringToText("含糊不清的词语、低声细语、说书人无法判断对错的声明、或是发表声明时有人没听到");
    g_tipLine[508] = StringToText("等情况下，声明都不作数。如同猎手的能力，说书人和每一名玩家都必须要听到并明确");
    g_tipLine[509] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表的声明，明白") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("正在使用自己的能力，以此来让说书人判定接下来会发");
    g_tipLine[510] = StringToText("生什么。");
    g_tipLine[511] = StringToText("如果") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("在白天处于") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("时发表了一个正确的声明，但当晚") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("能力触发时");
    g_tipLine[512] = StringToText("他恢复了清醒和健康，那么说书人仍然会杀死一名玩家。（点击魔典左上方的【声称】发动技能）");
    g_tipRoleAt[28] = 501;    // 造谣者
    g_tipRoleN[28] = 12;
    g_tipLine[513] = StringToText("【角色能力】");
    g_tipLine[514] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个角色：如果该角色在场，该角色之一从当");
    g_tipLine[515] = StringToText("晚开始") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("三天三夜。");
    g_tipLine[516] = StringToText("【角色简介】");
    g_tipLine[517] = TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("能使一个角色") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，且不需要知道该角色是哪名玩家。");
    g_tipLine[518] = StringToText("每局游戏限一次，") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("可以选择一个角色，使其") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("三个夜晚和三个白天，立即生效。");
    g_tipLine[519] = TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("不会得知自己成功或失败，因此") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("可能会选到不在场的角色。");
    g_tipLine[520] = TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选择的是一个角色，而不是一名玩家。说书人可能需要提醒") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("玩家注意这一点。");
    g_tipLine[521] = StringToText("也需要提醒试图伪装成") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩家注意这一点。");
    g_tipLine[522] = StringToText("如果") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选择了一个角色，该角色不会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，即使") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("于之后恢复了清醒");
    g_tipLine[523] = StringToText("和健康。如果") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("使一个角色") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，但是") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("变得") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，那名") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("的玩家会重新");
    g_tipLine[524] = StringToText("恢复清醒。如果") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("在三个夜晚和三个白天结束前又恢复了清醒和健康，那名被") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选");
    g_tipLine[525] = StringToText("中角色的玩家还是会继续") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[526] = StringToText("【规则细节】");
    g_tipLine[527] = StringToText("相克规则：");
    g_tipLine[528] = StringToText("维齐尔");
    g_tipLine[529] = StringToText("：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[530] = StringToText("召唤师");
    g_tipLine[531] = StringToText("：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipRoleAt[29] = 513;    // 侍臣
    g_tipRoleN[29] = 19;
    g_tipLine[532] = StringToText("【角色能力】");
    g_tipLine[533] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名死亡的玩家：如果他是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，你会将他");
    g_tipLine[534] = StringToText("起死回生。");
    g_tipLine[535] = StringToText("【角色简介】");
    g_tipLine[536] = TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("能让死者重获新生。");
    g_tipLine[537] = StringToText("每局游戏限一次，") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("可以选择一名已死亡的玩家。如果该玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他将被复活，");
    g_tipLine[538] = StringToText("再次变成存活状态。");
    g_tipLine[539] = StringToText("如果") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，则无事发生，并且") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("失去自己的能力。");
    g_tipLine[540] = StringToText("复活的玩家会重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的能力也");
    g_tipLine[541] = StringToText("会重新获得。");
    g_tipLine[542] = StringToText("复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能不能在自己复活的当晚进行行动，取决于复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("本该在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("之前还是");
    g_tipLine[543] = StringToText("之后行动。如果复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("有「在你的首个夜晚」的能力，则会在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("重新入睡后立即");
    g_tipLine[544] = StringToText("被唤醒来使用这类能力。");
    g_tipLine[545] = StringToText("【规则细节】");
    g_tipLine[546] = StringToText("如果在城镇广场上没有死亡玩家，则无需唤醒") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("（即使可能已经有人死亡，但还未被");
    g_tipLine[547] = StringToText("说书人告知）。");
    g_tipLine[548] = TextWithColor(StringToText("侍女"), Color(0, 191, 255));
    g_tipLine[549] = StringToText("也不会因此检测到") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("因为自身能力被唤醒。");
    g_tipLine[550] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[551] = StringToText("狸猫");
    g_tipLine[552] = StringToText("：如果狸猫与使用过能力的") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("交换角色，新") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("仍然失去能力。");
    g_tipRoleAt[30] = 532;    // 教授
    g_tipRoleN[30] = 21;
    g_tipLine[553] = StringToText("【角色能力】");
    g_tipLine[554] = StringToText("当一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("死于处决时，除了你和旅行者以外的所有其他玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到明天黄昏。");
    g_tipLine[555] = StringToText("【角色简介】");
    g_tipLine[556] = StringToText("如果有") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("因为处决而死去，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("会让所有人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[557] = StringToText("如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决且死亡，所有玩家（除了") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("）会立即变得") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，并在整");
    g_tipLine[558] = StringToText("个夜晚和下一个白天都保持") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("状态。") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("、甚至是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("都会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，但");
    g_tipLine[559] = StringToText("是旅行者不会。如果") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("在夜晚死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("不会使人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[560] = StringToText("如果一名已死亡的") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发----已死亡的角色不会再");
    g_tipLine[561] = StringToText("次死亡！如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决但没有死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。如果一名爪");
    g_tipLine[562] = StringToText("牙玩家在") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("期间死于处决时，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。");
    g_tipLine[563] = StringToText("【规则细节】");
    g_tipLine[564] = StringToText("相克规则：");
    g_tipLine[565] = StringToText("军团");
    g_tipLine[566] = StringToText("：如果军团死于处决，所有军团保留能力，但") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("可能会在当晚得知今天白天死于");
    g_tipLine[567] = StringToText("处决的玩家是军团。");
    g_tipRoleAt[31] = 553;    // 吟游诗人
    g_tipRoleN[31] = 15;
    g_tipLine[568] = StringToText("【角色能力】");
    g_tipLine[569] = StringToText("如果与你邻近的两名存活的玩家是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，他们不会死亡。");
    g_tipLine[570] = StringToText("【角色简介】");
    g_tipLine[571] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("保护着她邻近的玩家免于死亡......只要他们都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的。");
    g_tipLine[572] = StringToText("如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家当前都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，这两名玩家就都不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("不能");
    g_tipLine[573] = StringToText("杀死他们，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("也不行。如果他们被处决，也不会死亡。唯一的例外是") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("，");
    g_tipLine[574] = StringToText("他能杀死受到保护而免于死亡的人。");
    g_tipLine[575] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的邻近的存活玩家是最靠近") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("两名存活玩家----一名为顺时针方向最近的存");
    g_tipLine[576] = StringToText("活玩家，一名为逆时针方向上最近的存活玩家。已死亡的邻近玩家会被跳过。");
    g_tipLine[577] = StringToText("然而，如果邻近的存活玩家其中之一是") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("的，或者两个都是") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("的，那么") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("就无");
    g_tipLine[578] = StringToText("法保护她的邻近存活玩家。如果一名") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩家死亡，使得") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("现在的两个邻近玩家都");
    g_tipLine[579] = StringToText("是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，那么他们就又都不会死亡了。");
    g_tipRoleAt[32] = 568;    // 茶艺师
    g_tipRoleN[32] = 12;
    g_tipLine[580] = StringToText("【角色能力】");
    g_tipLine[581] = StringToText("被处决的") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家可能不会死亡。");
    g_tipLine[582] = StringToText("【角色简介】");
    g_tipLine[583] = TextWithColor(StringToText("和平主义者"), Color(0, 191, 255)) + StringToText("防止") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家因处决而死亡。");
    g_tipLine[584] = StringToText("当一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家被处决时，说书人选择该玩家是死亡还是存活。");
    g_tipLine[585] = StringToText("一如既往，当这类能力以如此直白的方式生效时，只需要告知大家发生了什么事，不要");
    g_tipLine[586] = StringToText("告知为什么发生。大家得知处决成功了，但被处决的玩家没有死亡----这就够了。");
    g_tipLine[587] = StringToText("如果一名玩家被处决但依然存活，也仍然算作今天白天的处决。今天不能再发起其他的");
    g_tipLine[588] = StringToText("提名了。");
    g_tipLine[589] = StringToText("【规则细节】");
    g_tipLine[590] = StringToText("无");
    g_tipRoleAt[33] = 580;    // 和平主义者
    g_tipRoleN[33] = 11;
    g_tipLine[591] = StringToText("【角色能力】");
    g_tipLine[592] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipLine[593] = StringToText("【角色简介】");
    g_tipLine[594] = TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("能够死里逃生......但仅限一次。");
    g_tipLine[595] = TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("首次因任何理由死亡时，他依然存活。") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会得知是他自己的能力救了自己的命");
    g_tipLine[596] = StringToText("。");
    g_tipLine[597] = StringToText("如果其他角色的能力保护") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("免于死亡，") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会使用掉自己的能力。只有当") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("将要");
    g_tipLine[598] = StringToText("真正的死去时，他的能力才会触发。");
    g_tipRoleAt[34] = 591;    // 弄臣
    g_tipRoleN[34] = 8;
    g_tipLine[599] = StringToText("【角色能力】");
    g_tipLine[600] = StringToText("你随时可能死亡。");
    g_tipLine[601] = StringToText("【角色简介】");
    g_tipLine[602] = TextWithColor(StringToText("修补匠"), Color(0, 191, 255)) + StringToText("随时可能会死亡，不需要任何理由。");
    g_tipLine[603] = StringToText("说书人随时可以杀死") + TextWithColor(StringToText("修补匠"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[604] = TextWithColor(StringToText("修补匠"), Color(0, 191, 255)) + StringToText("在受到免于死亡的能力保护时，不能因自己的能力而死亡。");
    g_tipRoleAt[35] = 599;    // 修补匠
    g_tipRoleN[35] = 6;
    g_tipLine[605] = StringToText("【角色能力】");
    g_tipLine[606] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，在当晚他会死亡");
    g_tipLine[607] = StringToText("。");
    g_tipLine[608] = StringToText("【角色简介】");
    g_tipLine[609] = TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("会在死亡时诅咒他人，将其杀死。");
    g_tipLine[610] = TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("必须在得知自己死亡后的一到两分钟内选择一名玩家，无论是被处决后，还是在");
    g_tipLine[611] = StringToText("黎明说书人宣布夜晚的死亡玩家后。") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("可以在作出决定前花点时间听取大家的建议");
    g_tipLine[612] = StringToText("。");
    g_tipLine[613] = StringToText("如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("选择了一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家，该玩家会在当晚死亡。如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("选择了一名") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩");
    g_tipLine[614] = StringToText("家，无事发生。");
    g_tipLine[615] = StringToText("一如既往地，如果一名") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩家伪装成") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("假装使用能力，说书人应当配合他。");
    g_tipLine[616] = StringToText("说书人并没有义务提醒") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("来选择玩家。") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("必须在得知自己死亡后的短时间内使");
    g_tipLine[617] = StringToText("用自己的能力。故意不使用能力将被认定为作弊。");
    g_tipLine[618] = StringToText("如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在夜晚是清醒且健康的，但在今天白天选择玩家时是") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的，所选的");
    g_tipLine[619] = StringToText("玩家会死亡。如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在夜晚是") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的，但在今天白天选择玩家时是清醒且健");
    g_tipLine[620] = StringToText("康的，所选的玩家不会死亡。");
    g_tipLine[621] = StringToText("如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("时，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，则无论") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的阵营在夜晚如何变化，") + TextWithColor(StringToText("月之子"), Color(0, 191, 255));
    g_tipLine[622] = StringToText("都会杀死") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipRoleAt[36] = 605;    // 月之子
