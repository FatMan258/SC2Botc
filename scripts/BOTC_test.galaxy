    DialogControlSetVisible(g_fixMinus, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_fixPlus, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_cOpenBtn, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_customSlotBtn[i], PlayerGroupAll(), true);
    }
    for (i = 0; i < 13; i += 1) {
        DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_cDlg, PlayerGroupAll(), true);
}

void BOTC_CustomOpenSlot (int slot) {
    int i;
    if (!g_boardOpen || slot < 1 || slot > 6) {
        return;
    }
    if (g_cOpen && g_customSlot == slot) {
        return;                       // 点当前槽位不重载，避免丢掉未保存改动。
    }
    g_customSlot = slot;
    for (i = 0; i <= 148; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = false;
    g_bankTry = 0;
    BOTC_CustomLoadBank(true);
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomOpen () {
    int i;
    if (!g_boardOpen) {
        return;
    }
    g_customSlot = 0;
    for (i = 0; i <= 148; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = true;           // 未选槽位前不做 bank 重试。
    g_bankTry = 0;
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomClose () {
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_BoardRender();             // 还原标题 / 板子 / 人数修正
}

void BOTC_CustomClear () {
    int r;
    g_cStormPick = false;
    g_bootText = "";
    g_bootSavePending = false;
    g_bootSaveSlot = 0;
    BOTC_BootleggerEditRefresh();
    for (r = 0; r <= 148; r += 1) {
        g_csel[r] = false;
    }
    BOTC_CustomRender();
    BOTC_Notice(g_teller, "自定义剧本已清空。");
}

// 点左盘块第 i 格：选中 / 取消（受各分类上限限制）
void BOTC_CustomToggle (int i) {
    int r;
    int cat;
    if (i < 0 || i > 53) {
        return;
    }
    r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
    if (r < 0) {
        return;
    }
    cat = g_roleTeam[r];
    if (g_csel[130]) { BOTC_BootleggerCapture(); }
    if (g_csel[r]) {
        g_csel[r] = false;
        BOTC_CustomRender();
        return;
    }
    if (BOTC_CatPickedAll() >= 33) {
        BOTC_Notice(g_teller, "右侧一共只能摆 33 个角色（14 镇民 + 5 外来者 + 5 爪牙 + 5 恶魔 + 2 传奇 + 2 奇遇）。");
        return;
    }
    if (BOTC_CatPicked(cat) >= BOTC_CatCap(cat)) {
        BOTC_Notice(g_teller, BOTC_CustomCatName(cat) + "最多只能选 " + IntToString(BOTC_CatCap(cat)) + " 个。");
        return;
    }
    g_csel[r] = true;
    if (r == 130) { BOTC_BootleggerEditRefresh(); }
    BOTC_CustomRender();
    // 【暴风捕手（113）】（用户 2026-10-10）：加他的时候直接进「点一个角色」模式 —— 那一个角色就是他保护的对象
    if (r == 113) {
        g_cStormPick = true;
        BOTC_Notice(g_teller, "【暴风捕手】点左边一个角色：他保护那个角色（夜间不会死，邪恶首夜得知）。");
        BOTC_CustomRender();
    }
}

// 点右盘块第 k 格 = 取消那个角色
void BOTC_CustomUnpick (int k) {
    int t;
    int r;
    int used;
    if (k < 0 || k > 34) {
        return;
    }
    // 【槽号 → 角色】（用户 2026-10-04 报「只有镇民点得掉、还会删错人」）：
    //   右边那块的排法是**按阵营分组**（镇民 0..15 / 外来者 16..20 / 爪牙 21..25 / 恶魔 26..30 /
    //   传奇 31..32 / 奇遇 33..34），每组按角色号升序填。
    //   老写法是按「全部已选角色按角色号升序数第 k 个」，跟这个排法对不上 ——
    //   只有镇民那一段碰巧吻合，别的阵营槽号早超出已选数量 → 点了没反应，偶尔还会删到别人。
    //   现在照 BOTC_CustomRender 的排法逐组扫一遍，槽号对上才删。（两组循环必须保持一致）
    for (t = 0; t < 6; t += 1) {
        used = BOTC_CustomSlotBase(t);
        for (r = 0; r <= 148; r += 1) {
            if (!g_csel[r]) {
                continue;
            }
            if (g_roleTeam[r] != t) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(t) + BOTC_CustomSlotMax(t)) {
                break;
            }
            if (used == k) {
                if (r == 130) {
                    BOTC_BootleggerCapture();
                }
                g_csel[r] = false;
                BOTC_CustomRender();
                return;
            }
            used = used + 1;
        }
    }
}

// 【存档小工具】（用户 2026-10-04）：读之前先统一问一句「这个章节里到底有几个角色」。
//   bak = false → 主档（n / r0..）； bak = true → 备份（pn / pr0..）。
//   章节名两种都会试（新名 "custom" 全 ASCII；旧名「自定义剧本」留着兼容老存档）。
int BOTC_CustomBankCount (bank bk, string sec, bool bak) {
    if (bak) {
        if (!BankKeyExists(bk, sec, "pn")) {
            return 0;
        }
        return BankValueGetAsInt(bk, sec, "pn");
    }
    if (!BankKeyExists(bk, sec, "n")) {
        return 0;
    }
    return BankValueGetAsInt(bk, sec, "n");
}

int BOTC_CustomBankApply (bank bk, string sec, bool bak) {
    int i;
    int n;
    int r;
    string k;
    g_bootText = "";
    n = BOTC_CustomBankCount(bk, sec, bak);
    if (n <= 0) {
        return 0;
    }
    if (n > 148) {
        n = 128;
    }
    for (i = 0; i < n; i += 1) {
        if (bak) {
            k = "pr" + IntToString(i);
        }
        else {
            k = "r" + IntToString(i);
        }
        if (!BankKeyExists(bk, sec, k)) {
            continue;
        }
        r = BankValueGetAsInt(bk, sec, k);
        if (r >= 0 && r <= 148 && BOTC_CustomRoleVisible(r)) {
            g_csel[r] = true;
        }
    }
    // 【暴风捕手保护的角色】（用户 2026-10-10）：老存档没有这个键 → 保持默认（异教领袖）
    if (BankKeyExists(bk, sec, "storm")) {
        r = BankValueGetAsInt(bk, sec, "storm");
        if (r >= 0 && r <= 148) {
            g_cStormRole = r;
        }
    }
    // 【私货商人规则文本】：主档 boot / 备份 pboot
    if (bak) { k = "pboot"; } else { k = "boot"; }
    if (BankKeyExists(bk, sec, k)) {
        g_bootText = BankValueGetAsString(bk, sec, k);
    }
    else {
        // 老档 / 迁移档可能只把规则写进了另一种章节名；仅在当前章节完全没有该键时兼容读取。
        if (sec == "custom" && BankKeyExists(bk, "自定义剧本", k)) {
            g_bootText = BankValueGetAsString(bk, "自定义剧本", k);
        }
        if (sec == "自定义剧本" && BankKeyExists(bk, "custom", k)) {
            g_bootText = BankValueGetAsString(bk, "custom", k);
        }
    }
    BOTC_BootleggerSyncText();
    return n;
}

// 【抓每个座位的银行句柄】（用户 2026-10-04 拿到的参考实现 —— 另一张做存档测试的图就是这么写的）：
//   ```galaxy
//   BankLoad(名字, 玩家);
//   gv_bank[玩家] = BankLastCreated();     // ← 关键：Load 完**立刻**用 BankLastCreated() 抓句柄
//   ```
//   之后读/写都用这个句柄数组（参考图是每个真人玩家都抓一份）。
//   · 这里照抄：1 号位（说书人）**一定**抓，另外每个真人座位也各抓一份（以后做"每人各存各的"直接用 `g_bank[p]`）。
//   · ⚠ 地图触发器里必须有「数据存档 - **预加载存档** "BOTCSave"」这条**声明**：
//     没有它，引擎不认这个银行文件 → `BankLastCreated()` 拿到空壳、`BankSave` 也不会真的落盘（踩过）。
//   · ⚠ 不要再用「打开数据存档」那条动作：它在地图初始化里会让**联机卡加载**（用户 2026-10-04 实测）。
void BOTC_BankInit () {
    int p;
    if (g_bankInit) {
        return;
    }
    g_bankInit = true;
    for (p = 1; p <= 13; p += 1) {
        if (p == g_teller || PlayerType(p) == 1) {          // 1 号位一定抓；其它真人座位也抓
            // 直接用 `BankLoad` 的返回值当句柄（我们实测：这样写出来的文件确实落盘了）。
            //   参考图用的是「BankLoad 之后紧跟 BankLastCreated()」，两种写法等价；
            //   但 `BankLastCreated()` 在某些上下文会拿到空句柄，所以这里用更稳的返回值。
            g_bank[p] = BankLoad("BOTCSave2", p);
            BankWait(g_bank[p]);                     // 【等待数据存档】读取是异步的，等它读完
        }
    }
}

// 【取「当前说书人的账号」银行】（用户 2026-10-20）：换座位后必须读取新说书人自己的 bank。
//   `g_teller` 是物理玩家号；`BOTC_BankInit()` 开局已经给每个真人座位加载过 `g_bank[p]`，
//   所以这里不需要再 BankLoad，也绝对不能用 0 冒充「本机玩家」。
//   【为什么叫 BOTCSave2】（用户 2026-10-04）：老的 `BOTCSave` 那份文件里带着**中文章节名**（自定义剧本），
//   而参考图（另一张联机能正常跑起来的测试图）的存档是**纯 ASCII**。怀疑联机同步时卡在中文名上，
//   所以换一个全新的纯 ASCII 名字重开一份干净的存档（老文件不动，数据已经搬过去了）。
bank BOTC_MyBank () {
    BOTC_BankInit();
    if (g_teller >= 1 && g_teller <= 13) {
        return g_bank[g_teller];
    }
    return g_bank[1];
}

// 【统计前重新加载指定玩家的 bank】（用户 2026-10-26）：
//   开局 BankInit 只缓存一次句柄；读写时机较晚或异步加载未完成时，
//   BankKeyExists 会暂时返回 false。旧实现把它当成 0，统计保存时就可能写回 1。
void BOTC_BankReloadFor (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (p != g_teller && PlayerType(p) != 1) {
        return;
    }
    g_bank[p] = BankLoad("BOTCSave2", p);
    BankWait(g_bank[p]);
}

// 【场次统计】bank 章节 = "stats"；键前缀 t/g/e/s + 物理玩家号。
//   t = 总场次；g = 善良场次；e = 邪恶场次；s = 说书人场次。
int BOTC_StatsGet (bank bk, int pid, string pre) {
    string k;
    if (pid < 1 || pid > 13) {
        return 0;
    }
    k = pre + IntToString(pid);
    if (!BankKeyExists(bk, "stats", k)) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", k);
}

int BOTC_StatsBankTotal (bank bk) {
    int pid;
    int n;
    n = 0;
    if (BankKeyExists(bk, "stats", "t")) {
        n = n + BankValueGetAsInt(bk, "stats", "t");
        if (BankKeyExists(bk, "stats", "g")) { n = n + BankValueGetAsInt(bk, "stats", "g"); }
        if (BankKeyExists(bk, "stats", "e")) { n = n + BankValueGetAsInt(bk, "stats", "e"); }
        if (BankKeyExists(bk, "stats", "s")) { n = n + BankValueGetAsInt(bk, "stats", "s"); }
        return n;
    }
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, "t");
        n = n + BOTC_StatsGet(bk, pid, "g");
        n = n + BOTC_StatsGet(bk, pid, "e");
        n = n + BOTC_StatsGet(bk, pid, "s");
    }
    return n;
}

// 【账号级累计】（用户 2026-10-26）：键不再带物理玩家号，直接使用 t/g/e/s。
//   同一个人这次坐玩家 1、下次坐玩家 5，仍然累计到同一个账号总场次。
//   旧档的 t1..t13 / g1..g13 / e1..e13 / s1..s13 在首次读取时求和迁移。
int BOTC_StatsOwnGet (bank bk, string pre) {
    int pid;
    int n;
    if (BankKeyExists(bk, "stats", pre)) {
        return BankValueGetAsInt(bk, "stats", pre);
    }
    n = 0;
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, pre);
    }
    return n;
}

void BOTC_StatsOwnBump (bank bk, string pre) {
    int v;
    v = BOTC_StatsOwnGet(bk, pre);
    BankValueSetFromInt(bk, "stats", pre, v + 1);
}

void BOTC_StatsRecord () {
    bank bk;
    bank oldBk;
    int oldTotal;
    int q;
    int pid;
    // 【场次统计按玩家自己的 bank 保存】（用户 2026-10-20）：
    //   以前统一写当前说书人的 bank，导致「只有自己换到说书人座位时才会累计」。
    //   现在每名真人只把自己的场次写进 `g_bank[物理玩家号]`，统计页也逐人读取自己的 bank。
    BOTC_BankInit();
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        pid = g_who[q];
        if (pid < 1 || pid > 13 || PlayerType(pid) != 1) {
            continue;
        }
        oldBk = g_bank[pid];
        oldTotal = BOTC_StatsBankTotal(oldBk);
        BOTC_BankReloadFor(pid);
        if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
            g_bank[pid] = oldBk;               // 异步空档不能覆盖掉已经缓存到的高值
        }
        bk = g_bank[pid];
        BOTC_StatsOwnBump(bk, "t");
        if (BOTC_SeatAlign(q) == 0) {
            BOTC_StatsOwnBump(bk, "g");
        }
        else {
            BOTC_StatsOwnBump(bk, "e");
        }
        BankSave(bk);
    }
    // 说书人：座位 1 当前坐的那个人；只写他自己的 bank。
    pid = g_who[1];
    if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1) {
        oldBk = g_bank[pid];
        oldTotal = BOTC_StatsBankTotal(oldBk);
        BOTC_BankReloadFor(pid);
        if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
            g_bank[pid] = oldBk;
        }
        bk = g_bank[pid];
        BOTC_StatsOwnBump(bk, "t");
        BOTC_StatsOwnBump(bk, "s");
        BankSave(bk);
    }
    BOTC_PmStore(g_teller, "【场次统计】本局已按每名玩家的本地 bank 记录。");
}

void BOTC_StatsRender (int p) {
    bank bk;
    bank oldBk;
    int oldTotal;
    int pid;
    int t;
    int g;
    int e;
    int s;
    text line;
    text rowName;
    BOTC_BankInit();
    DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
    libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("场次统计（本地账号累计）"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
    // 【本地账号累计】（用户 2026-10-26）：直接读账号键 t/g/e/s；旧档自动汇总 t1..t13。
    oldBk = g_bank[p];
    oldTotal = BOTC_StatsBankTotal(oldBk);
    BOTC_BankReloadFor(p);
    if (BOTC_StatsBankTotal(g_bank[p]) < oldTotal) {
        g_bank[p] = oldBk;
    }
    // 每个查看者显示自己账号的总计；其他玩家仍显示各自 bank 里的账号总计。
    for (pid = 1; pid <= 13; pid += 1) {
        t = 0;
        g = 0;
        e = 0;
        s = 0;
        if (pid == p) {
            t = BOTC_StatsOwnGet(g_bank[p], "t");
            g = BOTC_StatsOwnGet(g_bank[p], "g");
            e = BOTC_StatsOwnGet(g_bank[p], "e");
            s = BOTC_StatsOwnGet(g_bank[p], "s");
        }
        else {
            if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1) {
                bk = g_bank[pid];
                t = BOTC_StatsOwnGet(bk, "t");
                g = BOTC_StatsOwnGet(bk, "g");
                e = BOTC_StatsOwnGet(bk, "e");
                s = BOTC_StatsOwnGet(bk, "s");
            }
        }
        // 【玩家 ID + 大厅自选色】（用户 2026-10-20）：不写「玩家N」，直接用实际玩家名。
        rowName = TextWithColor(PlayerName(pid), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(pid, false)));
        line = rowName;
        line = line + StringToText("    ");
        line = line + TextWithColor(StringToText("总场次 " + IntToString(t)), Color(0, 255, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("善良 " + IntToString(g)), Color(0, 191, 255));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("邪恶 " + IntToString(e)), Color(255, 0, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("说书人 " + IntToString(s)), Color(255, 215, 0));
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), line);
        // 每名玩家之间多留一行空白。
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("    "));
    }
}

string BOTC_CustomSection (int slot) {
    if (slot == 1) {
        return "custom";                 // 槽位 1 兼容旧版单槽存档。
    }
    return "custom" + IntToString(slot);
}

void BOTC_CustomSaveBootOnly (int slot, string s) {
    bank bk;
    string sec;
    if (slot < 1 || slot > 6) {
        return;
    }
    bk = BOTC_MyBank();
    sec = BOTC_CustomSection(slot);
    BankValueSetFromString(bk, sec, "boot", s);
    BankSave(bk);
}

// 【保存】把当前槽位写进 bank（BOTCSave.SC2Bank —— 名字里别带下划线）。
void BOTC_CustomSaveBank () {
    bank bk;
    int r;
    int n;
    int whoBak;
    int oldN;
    int i;
    string k;
    string k2;
    string sec;
    // 【bank 名去下划线】（用户 2026-10-04 实测）：磁盘上那份文件叫 `BOTCSave.SC2Bank`（下划线没了），
    //   而诊断显示「同一个 bank 对象写→读是好的、却看不到文件里已有的 n」→ 说明**写的时候去掉下划线、读的时候按原名找**。
    //   干脆名字里不带下划线，读写就一定是同一个文件。
    // 【保存时重新取一次当前说书人的 bank】（用户 2026-10-20）：
    //   不缓存旧说书人的句柄，避免换座位后写回旧账号。
    bk = BOTC_MyBank();              // 当前谁当说书人，就写谁自己的 bank
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再保存。");
        return;
    }
    sec = BOTC_CustomSection(g_customSlot);
    BOTC_BootleggerCapture();
    BOTC_BootleggerSyncText();
    // 保存前把当前槽位的主档复制成一层备份：pn / pr0.. / pboot。
    if (BankKeyExists(bk, sec, "boot")) {
        BankValueSetFromString(bk, sec, "pboot", BankValueGetAsString(bk, sec, "boot"));
    }
    oldN = BOTC_CustomBankCount(bk, sec, false);
    if (oldN > 0) {
        if (oldN > 148) {
            oldN = 128;
        }
        for (i = 0; i < oldN; i += 1) {
            k = "r" + IntToString(i);
            if (!BankKeyExists(bk, sec, k)) {
                continue;
            }
            k2 = "pr" + IntToString(i);
            BankValueSetFromInt(bk, sec, k2, BankValueGetAsInt(bk, sec, k));
        }
        BankValueSetFromInt(bk, sec, "pn", oldN);
    }
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        k = "r" + IntToString(n);
        BankValueSetFromInt(bk, sec, k, r);
        n = n + 1;
    }
    BankValueSetFromInt(bk, sec, "n", n);
    // 【暴风捕手保护的角色】（用户 2026-10-10）：跟板子一起存
    BankValueSetFromInt(bk, sec, "storm", g_cStormRole);
    BankValueSetFromString(bk, sec, "boot", g_bootText);
    BankSave(bk);
    g_customBankOk = true;          // 这一局已经有存档了，不用再重试读档
    // 【保存反馈】（用户 2026-10-04）：私聊那边显示绿字「保存成功」；另给说书人一条提示条 + 明细行。
    //   日志里带上「当前说书人的 bank」是因为换座位后 bank 会跟着当前说书人的账号走。
    //   ⚠ 绿字靠的是 BOTC_LineText 里「who == 0 的系统行才走 BOTC_KeyColor」这条 ——
    //     点按钮时不一定是 0（会跟着上一次聊天残留），所以这里**强制按系统行存**这一句。
    whoBak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_PmStore(g_teller, "保存成功");
    g_chatWhoNow = whoBak;
    if (g_csel[130]) {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色，私货商人规则已一并保存。");
    }
    else {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色。");
    }
}

// 【打开面板时自动读档】没存过就保持空白
//   【读档要看对地方】（用户 2026-10-04 报「联机存了、重进右边一个角色都没有」）：
//   `BankLoad(名字, 玩家号)` 的 bank 是**按那个玩家的账号**存的 ——
//     · 联机（真人对局）：`Documents\StarCraft II\Accounts\<账号>\<角色>\Banks\<地图>\BOTCSave.SC2Bank`
//     · 编辑器 / 离线测试：`Documents\StarCraft II\Banks\BOTCSave.SC2Bank`
//   两边是不同文件；bank 跟着账号走，不跟着逻辑座位格走。
//   【换说书人】（用户 2026-10-20）：主读 `g_bank[g_teller]`，换座位后自动跟随新说书人的账号。
//   `BOTC_BankInit()` 只给真人座位各加载一次；这里不额外扫描 2~13，避免线上重复走网络。
//   当前说书人的 bank 为空时，才回退玩家 1 的旧 bank 做一次性迁移。
void BOTC_CustomLoadBank (bool talk) {
    bank bk;
    int i;
    int n;
    int sp;
    bool got;
    bool sawEmpty;
    bool useBak;
    string sec;
    string secMain;
    got = false;
    sawEmpty = false;
    useBak = false;
    sp = 0;
    n = 0;
    if (g_customSlot < 1 || g_customSlot > 6) {
        return;
    }
    secMain = BOTC_CustomSection(g_customSlot);
    sec = secMain;
    // 【先读当前说书人的账号，再回退玩家 1 的旧档】(用户 2026-10-20)：
    //   · 主份 = `g_bank[g_teller]`，换说书人后自动跟随新说书人，不再固定玩家 1。
    //   · 新说书人的 bank 里没有配置时，才读玩家 1 的旧 bank 做迁移；保存仍写回新说书人自己的 bank。
    //   · 开局 BankInit 已给每个真人座位加载过 bank，这里不额外扫描 2~13，避免联机反复走网络。
    //   · 章节名先用新的全 ASCII "custom"，再退回旧名「自定义剧本」（老存档是旧名）。
    //   · 主档空时用备份（pn / pr0..）自动恢复。
    //   · talk = false（定时重试那一路）：没读到就**静默返回**，而且**不动 g_csel**，
    //     免得把说书人手动选的东西冲掉；只有真读到了才清空再套用。
    for (i = 1; i <= 2; i += 1) {
        if (i == 1) {
            bk = BOTC_MyBank();          // 当前说书人的 bank（g_bank[g_teller]）
        }
        else {
            if (g_teller == 1) {
                break;                   // 本来就是玩家 1：没有旧主档可回退
            }
            bk = g_bank[1];              // 玩家 1 的老存档：只用于首次迁移
        }
        n = BOTC_CustomBankCount(bk, secMain, false);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = false;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", false);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = false;
                sec = "自定义剧本";
                break;
            }
        }
        if (BankKeyExists(bk, secMain, "n") || (g_customSlot == 1 && BankKeyExists(bk, "自定义剧本", "n"))) {
            sawEmpty = true;                 // 存过，但是 0 个角色（上次大概存了空面板）
        }
        n = BOTC_CustomBankCount(bk, secMain, true);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = true;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", true);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = true;
                sec = "自定义剧本";
                break;
            }
        }
    }
    if (!got) {
        g_customBankOk = false;
        if (!talk) {
            return;                          // 定时重试：没读到就静默走人，等下一拍再试
        }
        if (sawEmpty) {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】存档是空的（0 个角色）→ 面板留空。");
        }
        else {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】没找到存档 → 这次是空面板。");
        }
        return;
    }
    g_customBankOk = true;
    if (sp == 2) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】当前说书人的 bank 没有配置 → 已临时读取玩家 1 的旧存档；下次保存会写入当前说书人的 bank。");
    }
    if (n > 148) {
        n = 128;
    }
    for (i = 0; i <= 148; i += 1) {
        g_csel[i] = false;                   // 真读到了才清空 + 套用
    }
    BOTC_CustomBankApply(bk, sec, useBak);
    if (useBak) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】主存档是空的 → 已用上一份备份恢复：" + IntToString(n) + " 个角色。");
    }
    else {
            // 【存档·诊断】那两条调试提示已删（用户 2026-10-07）：只留下面这一行。
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已读回存档：" + IntToString(n) + " 个角色。");
    }
}

// 【开始游戏】把选好的角色写成第 7 张板子，然后直接按它开局
void BOTC_CustomStart () {
    int r;
    int n;
    int lg;
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再开始游戏。");
        return;
    }
    if (BOTC_CatPicked(3) < 1) {
        BOTC_Notice(g_teller, "自定义剧本里至少要有一个恶魔。");
        return;
    }
    // 【点【开始游戏】= 顺手把这份配置也存进 bank】（用户 2026-10-04：他点的是【开始游戏】没点【保存】，
    //   结果下一局面板里没存档可读）—— 配置合法就先存一份，再开局。省得"配置好了却没存上"。
    BOTC_CustomSaveBank();
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] == 4 || g_roleTeam[r] == 5) {
            continue;                    // 传奇 / 奇遇不算板子角色，走 g_boardLegacy
        }
        if (n >= 128) {
            break;
        }
        g_boardRole[(7 * 256) + n] = r;
        n = n + 1;
    }
    if (n < 3) {
        BOTC_Notice(g_teller, "自定义剧本至少要有 3 个角色才能开局。");
        return;
    }
    g_boardRoleN[7] = n;
    lg = 0;
    // 【只收真正是「传奇 / 奇遇」的角色】（用户 2026-10-10 报「提线木偶 / 痢蛭 跑到传奇角色页里」）：
    //   原来扫 88..113 只看「选没选中」---- 那个区间里混着 93 提线木偶（爪牙）/ 100 痢蛭（恶魔）这些，
    //   一选中就把它们也塞进传奇列表了。改成**按阵营过滤**（4 传奇 / 5 奇遇），跟上面板子角色那段同一个口径。
    for (r = 0; r <= 148; r += 1) {
        if (!g_csel[r]) { continue; }
        if (g_roleTeam[r] != 4 && g_roleTeam[r] != 5) { continue; }
        if (lg >= 4) { break; }
        g_boardLegacy[(7 * 4) + lg] = r;
        lg = lg + 1;
    }
    g_boardLegacyN[7] = lg;
    // 【自定义剧本 → 本局用他自己选的暴风捕手保护对象】（用户 2026-10-10）
    if (g_cStormRole < 0 || g_cStormRole > 148) {
        g_cStormRole = 106;
    }
    g_stormRole = g_cStormRole;
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】开始游戏：共 " + IntToString(n) + " 个角色（传奇角色 " + IntToString(lg) + " 个）。");
    BOTC_BoardFinish(7);
}

// 【自定义剧本】那一层收到的所有点击（吃掉 = 返回 true）
bool BOTC_CustomClick (int p, int c) {
    int i;
    int r;
    if (!g_cOpen) {
        if (c == g_cOpenBtn) {
            if (p == g_teller) {
                BOTC_CustomOpen();
            }
            return true;
        }
        return false;
    }
    if (p != g_teller) {
        return true;                 // 面板开着的时候只有说书人能操作
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_customSlotBtn[i]) {
            BOTC_CustomOpenSlot(i + 1);
            return true;
        }
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_cCatBtn[i]) {
            g_cat = i;
            g_cpage = 0;
            BOTC_CustomRender();
            return true;
        }
    }
    for (i = 0; i < 54; i += 1) {
        if (c == g_cIcon[i]) {
            // 【暴风捕手选保护对象】（用户 2026-10-10）：这一模式下点图标 = 指定保护角色，**不改**这个角色选没选中
            if (g_cStormPick) {
                r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
                if (r >= 0) {
                    g_cStormRole = r;
                    g_stormRole = r;
                    g_cStormPick = false;
                    BOTC_PmStore(g_teller, "【暴风捕手】保护的角色：" + g_roleName[r] + "。");
                    BOTC_Notice(g_teller, "【暴风捕手】保护的角色已设为：" + g_roleName[r] + "。");
                    BOTC_CustomRender();
                }
                return true;
            }
            BOTC_CustomToggle(i);
            return true;
        }
    }
    for (i = 0; i < 35; i += 1) {
        if (c == g_cSelIcon[i]) {
            BOTC_CustomUnpick(i);
            return true;
        }
    }
    if (c == g_cPrevBtn) {
        g_cpage = g_cpage - 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cNextBtn) {
        g_cpage = g_cpage + 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cClearBtn) {
        BOTC_CustomClear();
        return true;
    }
    if (c == g_cBackBtn) {
        BOTC_CustomClose();
        return true;
    }
    if (c == g_cSaveBtn) {
        BOTC_CustomSaveBank();
        if (g_csel[130] && g_customSlot >= 1 && g_customSlot <= 6) {
            g_bootSavePending = true;
            g_bootSaveSlot = g_customSlot;
        }
        return true;
    }
    if (c == g_cStartBtn) {
        BOTC_CustomStart();
        return true;
    }
    return true;
}

bool BOTC_BoardTimer_Func (bool testConds, bool runActions) {
    if (!g_boardOpen) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    BOTC_BoardTimeout();
    return true;
}

//--------------------------------------------------------------------------------------------------
// 本局设置投票（用户 2026-09-17）
//   智能说书模式下，选板子页面右边多出一块：私聊时间 / 公聊时间 / 提名时间 / 第一天开不开邪恶小窗
//   · 每位玩家（2..13）每一项都能投一票，再点一次同一项 = 取消那一票
//   · 选板子结束那一刻结算（BOTC_BvApply）：票多的赢；平票取「离默认值最近」的，再平取小的
//   · 没人投的那一项 = 用默认值（私聊 3 分钟 / 公聊 3 分钟 / 提名 20 秒 / 不开小窗）
//--------------------------------------------------------------------------------------------------
void BOTC_BvReset () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        g_bvPm[i] = 0;
        g_bvPub[i] = 0;
        g_bvNom[i] = 0;
        g_bvEvil[i] = 0;
    }
    g_setPmMin = 3;                // 私聊 3 分钟（0 = 换成自由发言）
    g_setPubMin = 3;               // 公聊 3 分钟
    g_setNomSec = 30;              // 提名阶段的自由提名时间 30 秒（用户 2026-09-19 要求，原来 20）
    g_setEvilDay1 = false;         // 第一天不开邪恶小窗
}

// 某一项、某个选项拿了几票（kind：0 私聊 / 1 公聊 / 2 提名 / 3 小窗）
int BOTC_BvCount (int kind, int val) {
    int k;
    int n;
    n = 0;
    for (k = 2; k <= 13; k += 1) {
        if (kind == 0) {
            if (g_bvPm[k] == val) {
                n = n + 1;
            }
        }
        else {
            if (kind == 1) {
                if (g_bvPub[k] == val) {
                    n = n + 1;
                }
            }
            else {
                if (kind == 2) {
                    if (g_bvNom[k] == val) {
                        n = n + 1;
                    }
                }
                else {
                    if (g_bvEvil[k] == val) {
                        n = n + 1;
                    }
                }
            }
        }
    }
    return n;
}

// 某一项谁赢：票多的赢；平票取离默认值（def）最近的，再平取小的；一票都没有 = 默认值本身
int BOTC_BvWinner (int kind, int cnt, int def) {
    int v;
    int n;
    int d;
    int best;
    int bestN;
    int bestD;
    best = def;
    bestN = 0;
    bestD = 0;
    for (v = 1; v <= cnt; v += 1) {
        n = BOTC_BvCount(kind, v);
        if (v >= def) {
            d = v - def;
        }
        else {
            d = def - v;
        }
        if (n > bestN) {
            best = v;
            bestN = n;
            bestD = d;
        }
        else {
            if (n == bestN) {
                if (d < bestD) {
                    best = v;
                    bestD = d;
                }
            }
        }
    }
    return best;
}

// 选项的短名字（显示「你已选」用）
string BOTC_BvStr (int kind, int v) {
    if (kind == 0) {
        if (v == 0) {
            return "未选";
        }
        if (v == 5) {
            return "自由";
        }
        return IntToString(v) + "分";
    }
    if (kind == 1) {
        if (v == 0) {
            return "未选";
        }
        return IntToString(v) + "分";
    }
    if (kind == 2) {
        if (v == 0) {
            return "未选";
        }
        if (v == 1) {
            return "10秒";
        }
        if (v == 3) {
            return "30秒";
        }
        return "20秒";
    }
    if (v == 0) {
        return "未投";
    }
    if (v == 1) {
        return "要";
    }
    return "不要";
}

// 刷新右边那一块：票数 + 每个人自己的「你已选」
void BOTC_BvRender () {
    int k;
    string s;
    string mine;
    if (g_bvTitle == 0) {
        return;
    }
    // 只有智能说书模式才显示（手动说书由说书人自己控场，不需要投票）
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvPmBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvPubBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 3; k += 1) {
        DialogControlSetVisible(g_bvNomBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvHead[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvLine[k], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_bvEvilBtn, PlayerGroupAll(), (false));
    // 邪恶小窗功能关掉时：这一项的小标题、结果行、选项按钮全都不给看（用户 2026-09-19「开局投票也不用投了」）
    DialogControlSetVisible(g_bvHead[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvLine[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvTitle, PlayerGroupAll(), false);
    return;
    s = "私聊：1分" + IntToString(BOTC_BvCount(0, 1)) + "  2分" + IntToString(BOTC_BvCount(0, 2)) + "  3分" + IntToString(BOTC_BvCount(0, 3)) + "  4分" + IntToString(BOTC_BvCount(0, 4)) + "  自由" + IntToString(BOTC_BvCount(0, 5));
    libNtve_gf_SetDialogItemText(g_bvLine[0], StringToText(s), PlayerGroupAll());
    s = "公聊：1分" + IntToString(BOTC_BvCount(1, 1)) + "  2分" + IntToString(BOTC_BvCount(1, 2)) + "  3分" + IntToString(BOTC_BvCount(1, 3)) + "  4分" + IntToString(BOTC_BvCount(1, 4));
    libNtve_gf_SetDialogItemText(g_bvLine[1], StringToText(s), PlayerGroupAll());
    s = "提名：10秒" + IntToString(BOTC_BvCount(2, 1)) + "  20秒" + IntToString(BOTC_BvCount(2, 2)) + "  30秒" + IntToString(BOTC_BvCount(2, 3));
    libNtve_gf_SetDialogItemText(g_bvLine[2], StringToText(s), PlayerGroupAll());
    if (g_evilEnable) {
        s = "第一天开邪恶小窗：要" + IntToString(BOTC_BvCount(3, 1)) + "  不要" + IntToString(BOTC_BvCount(3, 2));
        libNtve_gf_SetDialogItemText(g_bvLine[3], StringToText(s), PlayerGroupAll());
    }
    // 「你已选」是**每人一份**的：同一个控件对不同玩家写不同的字（跟私聊输入框一个道理）
    for (k = 2; k <= 13; k += 1) {
        mine = "你已选：私聊" + BOTC_BvStr(0, g_bvPm[k]) + " / 公聊" + BOTC_BvStr(1, g_bvPub[k]) + " / 提名" + BOTC_BvStr(2, g_bvNom[k]);
        if (g_evilEnable) {
            mine = mine + " / 小窗" + BOTC_BvStr(3, g_bvEvil[k]);
        }
        libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText(mine), PlayerGroupSingle(k));
        libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：" + BOTC_BvStr(3, g_bvEvil[k])), PlayerGroupSingle(k));
    }
    // 说书人那边那一行给个说明（玩家 2..13 各自看到的是自己的「你已选」）
    libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText("（玩家 2..13 各投一票；再点一次同一项 = 取消）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：未投"), PlayerGroupSingle(g_teller));
}

// 投票：kind 0 私聊 / 1 公聊 / 2 提名 / 3 小窗；再点同一个选项 = 取消
void BOTC_BvVote (int p, int kind, int val) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_boardOpen) {
        return;
    }
    if (kind == 3 && !g_evilEnable) {
        return;                        // 邪恶小窗关着：这一项不接受投票
    }
    if (kind == 0) {
        if (g_bvPm[p] == val) {
            g_bvPm[p] = 0;
        }
        else {
            g_bvPm[p] = val;
        }
    }
    else {
        if (kind == 1) {
            if (g_bvPub[p] == val) {
                g_bvPub[p] = 0;
            }
            else {
                g_bvPub[p] = val;
            }
        }
        else {
            if (kind == 2) {
                if (g_bvNom[p] == val) {
                    g_bvNom[p] = 0;
                }
                else {
                    g_bvNom[p] = val;
                }
            }
            else {
                // 小窗那一项：未投 → 要 → 不要 → 未投 循环
                if (g_bvEvil[p] == 0) {
                    g_bvEvil[p] = 1;
                }
                else {
                    if (g_bvEvil[p] == 1) {
                        g_bvEvil[p] = 2;
                    }
                    else {
                        g_bvEvil[p] = 0;
                    }
                }
            }
        }
    }
    BOTC_BvRender();
}

// 结算（选板子结束那一刻）：把投票结果写成「本局设置」，智能说书人的白天节奏照它走
void BOTC_BvApply () {
    int w;
    string s;
    return;
    w = BOTC_BvWinner(0, 5, 3);
    if (w == 5) {
        g_setPmMin = 0;            // 5 = 自由发言：把私聊时间换成自由发言（3 分钟）
    }
    else {
        g_setPmMin = w;
    }
    g_setPubMin = BOTC_BvWinner(1, 4, 3);
    w = BOTC_BvWinner(2, 3, 3);        // 默认 / 平票锚点 = 3（30 秒）；玩家照样可以投 10 / 20 秒
    if (w == 1) {
        g_setNomSec = 10;
    }
    else {
        if (w == 3) {
            g_setNomSec = 30;
        }
        else {
            g_setNomSec = 20;
        }
    }
    if (BOTC_BvWinner(3, 2, 2) == 1 && g_evilEnable) {
        g_setEvilDay1 = true;
    }
    else {
        g_setEvilDay1 = false;         // 功能关掉时（g_evilEnable = false）这一项一律作废
    }
    // 播报一句：大家知道本局按什么时间走
    if (g_setPmMin <= 0) {
        s = "私聊时间：" + "自由发言 3 分钟";
    }
    else {
        s = "私聊时间：" + IntToString(g_setPmMin) + " 分钟";
    }
    s = s + " / 公聊时间：" + IntToString(g_setPubMin) + " 分钟 / 提名时间：" + IntToString(g_setNomSec) + " 秒";
    if (g_evilEnable) {
        s = s + " / 第一天邪恶小窗：";
        if (g_setEvilDay1) {
            s = s + "开";
        }
        else {
            s = s + "不开";
        }
    }
    BOTC_PubAnnounce("【本局设置】" + s);
}

// 得票最多的板子拿了几票（提前结束用：超过本局玩家的一半就直接进入）
int BOTC_BoardTopVotes () {
    int i;
    int k;
    int v;
    int best;
    best = 0;
    for (i = 1; i <= 12; i += 1) {  // 板子号最大到 12（7 = 自定义剧本，没人能投票）
        v = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_boardVote[k] == i) {
                v = v + 1;
            }
        }
        if (v > best) {
            best = v;
        }
    }
    return best;
}

void BOTC_BoardInfoRender () {
    int n;
    if (g_board <= 0) {
        DialogControlSetVisible(g_boardImg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), false);
        return;
    }
    libNtve_gf_SetDialogItemImage(g_boardImg, BOTC_BoardPic(g_board), PlayerGroupAll());
    BOTC_BuildSeatList();
    n = g_seatN;
    // 上色：镇民蓝、外来者天蓝、爪牙橙、恶魔红
    libNtve_gf_SetDialogItemText(g_boardInfo, TextWithColor(StringToText("镇" + IntToString(g_tcTab[n])), Color(70, 120, 255)) + TextWithColor(StringToText("  外" + IntToString(g_ocTab[n])), Color(130, 205, 255)) + TextWithColor(StringToText("  爪" + IntToString(g_mcTab[n])), Color(255, 150, 40)) + TextWithColor(StringToText("  恶1"), Color(235, 60, 60)), PlayerGroupAll());
    DialogControlSetVisible(g_boardImg, PlayerGroupAll(), true);
    DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), true);
}

// 画某个玩家的 token 面板：一格 = 图 + 小字
//   死亡类 token 现在所有人可见、可点；隐形槽（18）不占格子，后面的 token 自动往前排
void BOTC_TokRender (int ob) {
    int t;
    int n;
    int k;
    int pages;
    int page;
    int w;
    int x;
    int y;
    string s;
    // 先数一遍「这个板子里能看到的 token」有几个，算出总页数（每页 35 个）
    k = 0;
    for (t = 0; t < 256; t += 1) {
        if (!BOTC_TokHidden(t, ob)) {
            k = k + 1;
        }
    }
    pages = ((k + 34) / 35);
    if (pages < 1) {
        pages = 1;
    }
    page = g_tokPage[ob];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_tokPage[ob] = page;
    n = 0;                    // 这一页里已经画了几格
    k = 0;                    // 全表里第几个可见 token（从 0 开始）
    for (t = 0; t < 256; t += 1) {
        if (BOTC_TokHidden(t, ob)) {
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            continue;
        }
        if (((k / 35) + 1) != page) {
            // 不在当前这一页：收起来（但页码还是要往后数）
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            k = k + 1;
            continue;
        }
        x = 11 + ((n % 7) * 148);
        y = 40 + ((n / 7) * 86);
        DialogControlSetPosition(g_tokBtn[t], PlayerGroupSingle(ob), c_anchorTopLeft, x, y);
        if (g_tokIcon[t] == "") {
            // 还没有图的 token（处决 / 善良 / 邪恶）：整格只显示名字
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            if (g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t]) {
                s = "√ " + g_tokName[t];       // 打上了就给个勾（用户 2026-09-20：没勾以为打不上去）
            }
            else {
                s = g_tokName[t];
            }
            w = StringLength(s) * 16;
            if (w > 144) {
                w = 144;
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + ((144 - w) / 2), y + 32);
            libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
        }
        else {
            if (g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t]) {
                s = "√ " + g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], TextWithColor(StringToText(s), Color(120, 255, 120)), PlayerGroupSingle(ob));
            }
            else {
                s = g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
            }
            libNtve_gf_SetDialogItemImage(g_tokIconCtl[t], g_tokIcon[t], PlayerGroupSingle(ob));
            DialogControlSetPosition(g_tokIconCtl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + 18, y + 7);   // 图标 X 偏移：56 → 20（用户 2026-09-19）
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), true);
            w = StringLength(s) * 16;
            if (w > 43) {
                w = (144 - w) / 2;
                if (w < 0) {
                    w = 0;
                }
            }
            else {
                w = 18 + ((43 - w) / 2);      // 小字跟着图标居中（图标 X 偏移改成 20）
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + w, y + 52);
        }
        DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), true);
        n = n + 1;
        k = k + 1;
    }
    // 页码 + 翻页按钮（只有一页就不显示）
    libNtve_gf_SetDialogItemText(g_tokPageLbl, StringToText("第 " + IntToString(page) + " / " + IntToString(pages) + " 页（每页 35 个）"), PlayerGroupSingle(ob));
    if (pages > 1) {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), true);
    }
    else {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), false);
    }
}

// 打开某个座位的 token 面板：说书人和玩家都能开，各记各的（别人的标记自己看不到）
void BOTC_TokOpen (int ob, int who) {
    g_tokWho[ob] = who;
    g_tokPage[ob] = 1;             // 每次打开都从第 1 页开始（用户 2026-09-20）
    libNtve_gf_SetDialogItemText(g_tokTitle, BOTC_PlayerNameText(who) + StringToText(" 的 token"), PlayerGroupSingle(ob));
    BOTC_TokRender(ob);
    DialogSetVisible(g_tokDlg, PlayerGroupSingle(ob), true);
}

void BOTC_TokToggle (int ob, int idx) {
    BOTC_TokToggleAt(ob, g_tokWho[ob], idx);
    BOTC_TokRender(ob);
}

// 直接点圆桌上的 token 就把它去掉 / 加上
void BOTC_TokToggleAt (int ob, int seat, int t) {
    int i;
    // 隐形槽（18 = 镇长记账）不给点
    if (BOTC_TokHidden(t, ob)) {
        return;
    }
    g_tokOn[(((ob * 14) + seat) * 256) + t] = !g_tokOn[(((ob * 14) + seat) * 256) + t];
    // 【诺-达鲺手改优先】（用户 2026-10-19）：手动把「中毒（诺-达鲺）」移到别处后，
    //   不再让下一次黄昏 / 身份同步按旧记录复原。这里同步记录实际有标记的座位。
    if (ob == g_teller && t == 80) {
        g_nodManual = true;
        g_nodDemon = BOTC_LiveDemonSeat(70);
        g_nodA = 0;
        g_nodB = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = i;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = i;
                }
            }
        }
    }
    // 【哲学家醉酒同步】token 一打/一撤就同步一次（说书人手动给哲学家下毒也能立刻见效）
    //   ⚠ 但「醉酒（哲学家）90」本身要留给说书人手动纠正（用户 2026-10-12）----
    //     自动同步是「先清掉所有 90、再按算出来的目标重打」，手动打的那一枚会当场被抹掉。
    if (ob == g_teller && t != 90) {
        BOTC_PhiloDrunkSync();
    }
    if (ob == g_teller && t == 90) {
        // 【手动优先】（用户 2026-10-12）：说书人自己打上这枚 → 自动同步不再插手；
        //   他自己撤掉（这一格没 token 了）→ 交还给自动同步。
        g_philoDrunkManual = g_tokOn[(((g_teller * 14) + seat) * 256) + 90];
    }
    // 【是恶魔（小怪宝）134】（用户 2026-10-10）：谁被打上这枚 token，谁就是「现在的恶魔」---- 记住座位。
    //   ⚠ 撤掉 token 时**不清** g_lmSeat：照看人死了 token 会被离场清理自动收掉，那时候还要靠它判胜负。
    if (ob == g_teller && t == 134 && g_tokOn[((((g_teller * 14) + seat) * 256) + t)]) {
        g_lmSeat = seat;
        // 【告诉他今晚照看小怪宝】（用户 2026-10-10）：打上这枚 token 的那一刻私聊他
        BOTC_PmInfo(g_who[seat], "【小怪宝】今晚由你来照看小怪宝。");
        BOTC_PmStore(g_teller, "【小怪宝】已告诉 " + BOTC_NameStr(seat) + "：今晚由他照看小怪宝。");
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
    }
    // 【善良(14) / 邪恶(15)】手动打 / 撤：真身阵营跟着变 → 登记层缓存作废（用户 2026-09-20）
    if (t == 14 || t == 15) {
        BOTC_PairClearSeat(seat);
        // 【阵营改变的提示】（用户 2026-09-26）：说书人给他打上这个 token → 当场私聊告诉他阵营变了
        if (ob == g_teller && g_tokOn[(((g_teller * 14) + seat) * 256) + t]) {
            if (t == 15) {
                BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是邪恶阵营。");
                BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是邪恶阵营。");
            }
            else {
                BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是善良阵营。");
                BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是善良阵营。");
            }
        }
    }
    // 【复活（哈迪寂亚）113】不是普通死亡 token：打上它 = 把该座位的死亡记录清掉并恢复一次性能力。
    if (ob == g_teller && t == 113 && g_tokOn[(((g_teller * 14) + seat) * 256) + 113]) {
        g_tokOn[(((g_teller * 14) + seat) * 256) + 112] = false;
        if (BOTC_PublicDead(seat)) {
            BOTC_DeathToggle(seat, 0, 0);
        }
        else {
            BOTC_ClearDeath(seat);
            BOTC_RestoreOneShot(seat);
            BOTC_PmInfo(g_who[seat], "【哈迪寂亚】你复活了。");
            BOTC_PmStore(g_teller, "【哈迪寂亚】已让 " + BOTC_NameStr(seat) + " 复活（死亡记录和一次性能力已恢复）。");
        }
    }
    // 说书人手动点「死亡」那一格：只留一个死亡 token，并把死亡类型同步过来（关掉就等于复活）
    if (ob == g_teller) {
        // 【角色专属死因 token（32~41）也要走这条】（用户 2026-09-22）：以前这里只认死亡类型表里的那几格，
        //   所以「死亡（造谣者）」点上之后只亮个 token ---- 死亡记录 / 红叉 / 播报全都没有。
        if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
            if (g_tokOn[(((g_teller * 14) + seat) * 256) + t]) {
                BOTC_SyncDeathFromTok(seat, t);
                // 标的是恶魔的话：红唇女郎顶上 / 没人顶就走传位（智能随机 / 手动弹面板）；
                //   没人能接位时才判胜负（没有活着的恶魔 → 善良胜）
                if (!BOTC_DemonGoneCheck()) {
                    BOTC_CheckWin();
                }
            }
            else {
                BOTC_ClearDeath(seat);
            }
        }
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：手动打了死亡 token（或撤掉）之后，
    //   那个座位的玩家该看到【死后声称】了（撤掉就换回【声称】）。
    if (ob == g_teller) {
        BOTC_DeclareRender();
    }
    // 【疯子（38）】手动给某个座位打「被选择（疯子）」= 模拟疯子今晚的选择：
    //   写一行「疯子选择了谁」+ 智能说书时私聊告诉真恶魔（用户 2026-09-20）
    if (ob == g_teller && t == 48 && g_tokOn[(((g_teller * 14) + seat) * 256) + 48]) {
        BOTC_LunaticPickNotify(seat);
    }
    if (ob == g_teller) {
        BOTC_VizierSync();          // 中毒 / 醉酒 / 死亡 / 复活 / 换身份后立即校正维齐尔免死 token
    }
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

void BOTC_TokClearAll (int ob) {
    int t;
    for (t = 0; t < 256; t += 1) {
        g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t] = false;
    }
    if (ob == g_teller) {
        BOTC_ClearDeath(g_tokWho[ob]);
    }
    BOTC_TokRender(ob);
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

// 【按板子抽角色】（用户 2026-09-19）：从**当前板子的角色清单**（g_boardRole）里，
//   随机挑一个「这一局还没用过、且属于某个阵营」的身份；t = 阵营（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）
//   返回 -1 = 这个板子里没有这类角色（调用方退回旧的范围抽法）
bool BOTC_IsMarionette (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    return (BOTC_SeatTrueRole(q) == 93);
}

int BOTC_MarionetteFakeRole (int self) {
    int i;
    int r;
    int n;
    int pick;
    pick = -1;
    n = 0;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 148 || r == self) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0) {
            continue;
        }
        if (r == 118) {
            continue;                                   // 【认知覆盖互斥】（用户 2026-10-16）：提线木偶不能以为自己是悟道者
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    if (pick >= 0) {
        return pick;
    }
    n = 0;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 148 || r == self) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0) {
            continue;
        }
        if (r == 118) {
            continue;                                   // 【认知覆盖互斥】（用户 2026-10-16）：同上
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    return pick;
}

bool BOTC_MarionetteCanSwap (int q) {
    int rt;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    rt = BOTC_SeatTrueRole(q);
    if (BOTC_RoleTeam(rt) != 0 && BOTC_RoleTeam(rt) != 1) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 118]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：已经是提线木偶的不换
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：悟道者（真身 118）不换 —— 换了会留下「是悟道者」140 又挂上「是提线木偶」118
    }
    return true;
}

void BOTC_MarionetteSwap (int a, int b) {
    int i;
    int ra;
    int rb;
    ra = g_mark[(g_teller * 14) + a] - 1;
    rb = g_mark[(g_teller * 14) + b] - 1;
    g_tokOn[(((g_teller * 14) + a) * 256) + 118] = false;
    BOTC_SetSeatRole(g_teller, a, rb);
    BOTC_SetSeatRole(g_who[a], a, rb);
    BOTC_SetSeatRole(g_teller, b, ra);
    BOTC_SetSeatRole(g_who[b], b, ra);
    g_tokOn[(((g_teller * 14) + b) * 256) + 118] = true;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 6] = false;
    }
    BOTC_PickRedHerring();
    BOTC_GrimRender(g_teller);
}

void BOTC_MarionetteSync () {
    int i;
    int r;
    int dm;
    int mq;
    int nb;
    int cand;
    dm = BOTC_FindDemon();
    mq = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsMarionette(i)) {
            continue;
        }
        if (mq == 0) {
            mq = i;
        }
        r = BOTC_MarionetteFakeRole(i);
        if (r < 0) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
            BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(i) + " 找不到能当他「以为的身份」的镇民，请手动在魔典上给他选一个善良身份。");
            continue;
        }
        BOTC_SetSeatRole(g_teller, i, r);
        BOTC_SetSeatRole(g_who[i], i, r);
        g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
    }
    if (mq < 2) {
        return;
    }
    cand = 0;
    if (dm >= 2 && BOTC_RingDist(mq, dm) > 1) {
        nb = BOTC_RingNext(dm, 1);
        if (BOTC_MarionetteCanSwap(nb)) {
            cand = nb;
        }
        if (cand < 2) {
            nb = BOTC_RingNext(dm, -1);
            if (BOTC_MarionetteCanSwap(nb)) {
                cand = nb;
            }
        }
        if (cand >= 2) {
            BOTC_MarionetteSwap(mq, cand);
            mq = cand;
        }
    }
    BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(mq) + " 以为自己是「" + g_roleName[g_mark[(g_teller * 14) + mq] - 1] + "」。");
}

int BOTC_PickBoardRole (int t) {
    int i;
    int r;
    int n;
    int pick;
    n = 0;
    pick = -1;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) != t) {
            continue;
        }
        if (g_scrUsed[r]) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    if (pick >= 0) {
        g_scrUsed[pick] = true;
    }
    return pick;
}

// 【堤丰之首（111）】（用户 2026-10-10）：发牌时的设置
//   ① 把一个善良玩家变成爪牙（配比跟着变：善良 -1 / 爪牙 +1）；
//   ② 把所有邪恶排成**邻座**，他自己坐中间（4 个邪恶时中间有两个位，他坐偏左那个）。
//   ⚠ 座位靠 BOTC_SeatSwap 整体对调（身份 / token / 死亡 / 谁坐哪格）；排座位期间把
//     「【换座位】x ↔ y」那几条播报静音（g_arrangeQuiet），最后由这里写一行总结。
void BOTC_HfTyphonSetup () {
    int i;
    int j;
    int q;
    int s;
    int tp;
    int tpPhys;
    int n;
    int hit;
    int bestS;
    int bestHit;
    int mid;
    int r;
    int pick;
    int phys;
    int otherN;
    int[14] oth;
    int[14] othPhys;
    int[14] tg;
    tp = BOTC_SeatOfRole(111);
    if (tp < 2 || tp > 13) {
        return;
    }
    // ① 一个善良玩家 → 爪牙
    pick = 0;
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == tp) { continue; }
        if (BOTC_SeatAlign(q) != 0) { continue; }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) { continue; }     // 酒鬼不换（真身跟魔典上写的不一样）
        n = n + 1;
        if (RandomInt(1, n) == 1) { pick = q; }
    }
    if (pick >= 2) {
        r = BOTC_PickBoardRole(2);
        if (r < 0) {
            r = BOTC_PickUnused(17, 20);
        }
        BOTC_SetSeatRole(g_teller, pick, r);
        BOTC_SetSeatRole(g_who[pick], pick, r);
        BOTC_PmStore(g_teller, "【堤丰之首】发牌：把 " + BOTC_NameStr(pick) + " 变成了爪牙（" + g_roleName[r] + "）。");
    }
    // ② 邪恶邻座 + 他坐中间
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
            n = n + 1;
        }
    }
    if (n < 2) {
        return;
    }
    bestS = 0;
    bestHit = -1;
    for (s = 0; s < g_seatN; s += 1) {
        hit = 0;
        for (j = 0; j < n; j += 1) {
            q = g_seatList[(s + j) % g_seatN];
            if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
                hit = hit + 1;
            }
        }
        if (hit > bestHit) {
            bestHit = hit;
            bestS = s;
        }
    }
    for (j = 0; j < n; j += 1) {
        tg[j] = g_seatList[(bestS + j) % g_seatN];
    }
    mid = (n - 1) / 2;                 // 4 个邪恶 → 1（中间偏左那个位）；3 / 5 个 → 正中间
    // 除他以外的邪恶：按圆桌上的先后排队。⚠ 先把"人"记下来 —— 换位过程中格子会变
    otherN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == tp) { continue; }
        if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
            oth[otherN] = q;
            otherN = otherN + 1;
        }
    }
    tpPhys = g_who[tp];
    for (i = 0; i < otherN; i += 1) {
        othPhys[i] = g_who[oth[i]];
    }
    g_arrangeQuiet = true;
    j = 0;
    for (i = 0; i < n; i += 1) {
        if (i == mid) {
            phys = tpPhys;
        }
        else {
            phys = othPhys[j];
            j = j + 1;
        }
        q = BOTC_PosOf(phys);
        if (q != tg[i]) {
            BOTC_SeatSwap(tg[i], q);
        }
    }
    g_arrangeQuiet = false;
    BOTC_PmStore(g_teller, "【堤丰之首】邪恶已排成邻座（" + BOTC_NameStr(tg[0]) + " → " + BOTC_NameStr(tg[n - 1]) + "），他坐 " + BOTC_NameStr(tg[mid]) + "。");
}
// 随机发牌（说书人用）：按人数配比抽身份；抽到酒鬼时多抽一个镇民当他看到的身份，并打上"是酒鬼"
void BOTC_Deal () {
    int n;
    int tc;
    int oc;
    int mc;
    int i;
    int k;
    int pos;
    int s;
    int pick;
    int drunkSeat;
    int extra;
    int baron;
    int godfather;
    int demonPick;                 // 【方古（68）/ 亡骨魔（69）】：这两只恶魔要改配比
    int balloon;                   // 【气球驾驶员（72）】：这局掷到「+1」就要把他钉进场
    int balFound;                  // 【气球驾驶员（72）】：他有没有被抽进镇民池
    int lg;
    int gd;
    int rb;
    int ocG;
    int r;
    int wudSeat;                   // 【悟道者（118）】他坐在哪个格子（用户 2026-10-16）
    int wudRole;                   // 【悟道者（118）】发给他「以为」的那张外来者卡

    BOTC_ResetGameVars();          // 换局：先把上一局的记录（主谋加时 / 概率 / 假死...）清干净
    g_dealConfirmed = false;       // 重新发牌：之前那次【确认发放】作废
    BOTC_GrimShareRender();        // 重新发牌时先收起上一轮的测试发送按钮
    BOTC_KickEnd();                // 【投票踢人】换局收尾：清状态 + 收起那个对话框（用户 2026-10-02）
    // 【不在场身份也要清空】（用户 2026-10-02）：上一把恶魔 / 疯子那 3 个不在场身份会留到下一把 ----
    //   注意：玩家（恶魔 / 疯子 / 食人族）手上那份**是同一个对话框按玩家渲染的**，所以除了清数据，
    //   还要把「收到过」的那几个玩家那份**刷空 + 收掉**，否则下一把还挂着旧的三格（用户报的就是这个）。
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
        g_bluffOut[i] = 0;
        g_lbluffPick[i] = 0;
        g_lbluffOut[i] = 0;
    }
    // ⚠【发送给所有恶魔】会一次发给好几个玩家、不记 g_bluffTarget，所以这里干脆把 2..13 全刷一遍：
    //   先把他们那份刷成空的 3 格（数据已经清了），再把面板收掉。
    for (i = 2; i <= 13; i += 1) {
        BOTC_BluffRowRender(i);
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(i), false);
        g_bluffGot[i] = false;
    }
    g_bluffSent = false;
    g_bluffTarget = 0;
    g_bluffTargetL = 0;
    g_bluffTargetC = 0;
    g_bluffTargetP = 0;
    g_lbluffSent = false;
    g_lbluffTarget = 0;
    g_availN = 0;
    BOTC_BluffRender();                                        // 说书人自己那份：刷成空的 3 格
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);  // 说书人那份保持显示（跟建面板时一致）
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟教父一样每局掷一次 50/50（+0 / +1 外来者）
    if (g_balPlusSeeded == false) {
        g_balPlus = (RandomInt(1, 2) == 1);
        g_balPlusSeeded = true;
    }
    if (g_gfPlusSeeded == false) {
        g_gfPlus = (RandomInt(1, 2) == 1);
        g_gfPlusSeeded = true;
    }
    // 【村夫（105）】（用户 2026-10-10）：剧本卡 [+0~2 村夫] —— 每局摇一次骰子
    if (g_villRollSeeded == false) {
        g_villRoll = RandomInt(0, 2);
        g_villRollSeeded = true;
    }
    // 先按在场人数把圆桌摆好，顺便算出参与座位表（空位不会被算进来）
    BOTC_GrimRelayout();
    n = g_seatN;
    tc = g_tcTab[n];
    oc = g_ocTab[n];
    mc = g_mcTab[n];
    g_boomKeepPick = false;
    g_boomVoteOn = false;
    g_boomSeat = 0;
    g_boomResult = false;

    for (i = 2; i <= 13; i += 1) {
        g_mark[(g_teller * 14) + i] = 0;
        // 【玩家离开游戏】那条公聊提示：新一局重新记账（用户 2026-10-02）
        g_leftShown[i] = false;
        g_kickVote[i] = 0;             // 【投票踢人】的票也一起清（用户 2026-10-02）
        g_exec[i] = false;
        g_regTeam[i] = -1;
        g_regAlign[i] = -1;
        g_seatPrevAlign[i] = -1;
        g_claim[i] = -1;
        g_herring = 0;
        g_ftPick[i] = false;
        g_ftFirst[i] = 0;
        g_awake[i] = false;
        g_skillPicking[i] = false;
        g_limitedAsk[i] = false;
        g_poAsk[i] = false;
        g_skillRoleSel[i] = 0;
        g_boomKeep[i] = false;
        g_boomVote[i] = 0;
        g_boomCount[i] = 0;
        g_skillT1[i] = 0;
        g_skillT2[i] = 0;
        BOTC_ClearDeath(i);      // 死亡类型（夜间 / 白天 / 处决 / 恶魔杀）一起清掉
        for (k = 0; k < 256; k += 1) {          // 表已经扩到 256：新加的 token 也要清
            g_tokOn[(((g_teller * 14) + i) * 256) + k] = false;
        }
    }
    // 重新发牌 = 新的一局：隔夜技能记录和「传位解锁」一起清掉
    BOTC_NightSkillReset();
    g_promoteOpen = false;
    g_nightPoison = 0;
    g_poisonFrom = 0;
    BOTC_SpyPeekEnd();      // 间谍的魔典要是还摊在看说书人那份，先换回他自己那份
    BOTC_GrimResetPerPlayer();
    g_butlerSeat = 0;
    g_butlerMaster = 0;
    BOTC_WinClose();          // 上一把的胜负横幅收掉
    g_gameOver = false;
    BOTC_MusicDropPrio(0);    // 重新发牌＝新的一局：把胜利曲那层最高优先级放开，好让选板子的音乐进来
    BOTC_PromoteHide();       // 上一把的传位面板也收掉
    BOTC_SlayAskHide();       // 上一把没答完的【猎手请求】也收掉
    BOTC_MayorClear();        // 镇长那条挂起的死亡也收掉
    for (i = 0; i <= 13; i += 1) {
        g_declarePick[i] = false;
        g_declareUsed[i] = false;      // 新一局：声称次数重新给
        g_deadVoteUsed[i] = false;     // 新一局：死人票重新给
        g_voteWasDead[i] = false;
        g_bansheePower[i] = false;
        g_bansheeSecondNom[i] = false;
        g_psyDone[i] = false;
        g_psyDay[i] = -1;
        g_gossipDay[i] = -1;
        g_psyDeclare[i] = false;
        g_cultDeclDone[i] = false;     // 异教领袖（106）：新一局，声称次数重新给（用户 2026-10-11）
        g_damselPick[i] = false;
        g_damselDone[i] = false;
    }
    g_damselFailed = false;
    g_slayAskPsy = false;

    BOTC_HdHide();
    BOTC_DeclareRender();
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    g_deadPick = false;
    g_execUsedToday = false;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    BOTC_BigHintHide(0);       // 新一局：顺手收掉长驻提示（全场）
    for (i = 0; i < 149; i += 1) {
        g_scrUsed[i] = false;
    }

    // 参与座位洗牌（用的是真实座位号，中间有空位也不会错位）
    for (i = 0; i < n; i += 1) {
        g_scrSeat[i] = g_seatList[i];
    }
    for (i = 0; i < n; i += 1) {
        k = RandomInt(i, n - 1);
        s = g_scrSeat[i];
        g_scrSeat[i] = g_scrSeat[k];
        g_scrSeat[k] = s;
    }

    pos = 0;
    // 恶魔：从当前板子的角色清单里抽（暗流涌动 = 小恶魔；黯月初升 = 僵怖 / 普卡 / 沙巴洛斯 / 珀）
    pick = BOTC_PickBoardRole(3);
    demonPick = pick;              // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：配比要跟着改
    if (pick < 0) {
        pick = BOTC_PickUnused(21, 21);
    }
    g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
    pos = pos + 1;
    if (demonPick == 94) {
        g_scrUsed[93] = true;
        rb = RandomInt(0, 2);
        gd = mc + 1 + rb;
        lg = tc + oc - rb;
        if (lg < 1) {
            lg = 1;
        }
        ocG = oc;
        if (ocG > mc) {
            ocG = mc;
        }
        for (i = 0; i < rb; i += 1) {
            if (ocG < oc && RandomInt(1, 2) == 1) {
                ocG = ocG + 1;
            }
        }
        mc = 0;
        tc = gd - ocG;
        oc = ocG;
        for (i = 1; i < lg; i += 1) {
            g_mark[(g_teller * 14) + g_scrSeat[pos]] = 95;
            pos = pos + 1;
        }
        BOTC_PmStore(g_teller, "【配比】军团在场 → 人数对调后随机多 " + IntToString(rb) + " 名善良角色：军团 " + IntToString(lg) + " 名、善良 " + IntToString(gd) + " 名（镇民 " + IntToString(tc) + " / 外来者 " + IntToString(oc) + "）。");
    }
    // 爪牙：同样按板子抽（男爵 = 20，只有暗流涌动有他）
    baron = 0;
    godfather = 0;
    for (i = 0; i < mc; i += 1) {
        pick = BOTC_PickBoardRole(2);
        if (pick < 0) {
            pick = BOTC_PickUnused(17, 20);
        }
        if (pick == 20) {
            baron = 1;
        }
        if (pick == 39) {
            godfather = 1;                   // 教父（39）：配比要 ±1 外来者
        }
        g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
        pos = pos + 1;
    }
    // 男爵能力：两名镇民替换为两名外来者
    if (baron == 1) {
        tc = tc - 2;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 2;
    }
    // 教父（39）：[-1 或 +1 外来者]（用户 2026-09-20：50/50，照男爵这套写）
    if (godfather == 1) {
        if (g_gfPlus) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
        else {
            if (oc > 1) {
                oc = oc - 1;
                tc = tc + 1;
            }
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
    }
    // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：方古 让外来者 +1、镇民 -1；亡骨魔 让外来者 -1、镇民 +1
    if (demonPick == 68) {
        tc = tc - 1;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 1;
        BOTC_PmStore(g_teller, "【配比】方古在场 → 外来者 +1、镇民 -1。");
    }
    if (demonPick == 69) {
        if (oc > 1) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】亡骨魔在场 → 外来者 -1、镇民 +1。");
    }
    // 【赶尸人（126）】：[-1 外来者]
    if (BOTC_RoleInPlay(126)) {
        if (oc > 0) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】赶尸人在场 → 外来者 -1、镇民 +1。");
    }
    // 【小怪宝（112）】（用户 2026-10-10）：随机发牌抽到小怪宝 → **把他移除**，那一格（恶魔位）改发一个爪牙；
    //   小怪宝本人不会发到任何玩家手里（只有疯子「以为自己是小怪宝」时才可能出现在魔典上）。
    //   于是这一局没有「真身是恶魔」的玩家 —— 恶魔身份完全靠「是恶魔（小怪宝）」那枚 token（说书人自己挪）。
    if (demonPick == 112) {
        r = BOTC_PickBoardRole(2);
        if (r < 0) {
            r = BOTC_PickUnused(17, 20);
        }
        g_mark[(g_teller * 14) + g_scrSeat[0]] = r + 1;      // 恶魔那一格（第 0 个座位）改成爪牙
        demonPick = r;
        g_lmOn = true;
        BOTC_PmStore(g_teller, "【小怪宝】发牌抽到他 → 已移除：恶魔那一格改发爪牙（" + g_roleName[r] + "）。");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：他是镇民，抽牌之前定不了他会不会在场，
    //   而这局掷到「+1」就必须外来者 +1、镇民 -1（不然提示写着 +1，牌面却只有一个外来者）。
    //   所以掷到 +1 就直接把他钉进场：配比先改，抽镇民的时候再把他塞进池子。
    balloon = 0;
    if (g_balPlus) {
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            if (g_boardRole[(g_board * 256) + i] == 72) {
                balloon = 1;
            }
        }
        if (balloon == 1) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
            BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 外来者 +1、镇民 -1。");
        }
    }
    // 【哨兵（88）】（用户 2026-09-26）：被加进本局时，外来者按他选的 -1 / 0 / +1 调整
    if (g_legacyOn[88] && g_sentAdjust != 0) {
        tc = tc - g_sentAdjust;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + g_sentAdjust;
        if (oc < 0) {
            oc = 0;
        }
        if (g_sentAdjust > 0) {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 +1、镇民 -1。");
        }
        else {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 -1、镇民 +1。");
        }
    }
    // 外来者：按板子抽（酒鬼 = 14）
    drunkSeat = 0;
    for (i = 0; i < oc; i += 1) {
        pick = BOTC_PickBoardRole(1);
        if (pick < 0) {
            pick = BOTC_PickUnused(13, 16);
        }
        g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
        if (pick == 14) {
            drunkSeat = g_scrSeat[pos];
        }
        pos = pos + 1;
    }
    // 镇民（索引0..12）
    extra = 0;
    if (drunkSeat > 0) {
        extra = 1;
    }
    for (i = 0; i < tc + extra; i += 1) {
        g_scrRole[i] = BOTC_PickBoardRole(0);
        if (g_scrRole[i] < 0) {
            g_scrRole[i] = BOTC_PickUnused(0, 12);
        }
    }
    // 【认知覆盖互斥】（用户 2026-10-16）：酒鬼多抽的那张镇民卡不能是「悟道者」(118) ---- 是的话换一张
    if (extra == 1 && g_scrRole[tc] == 118) {
        pick = BOTC_PickBoardRole(0);
        if (pick >= 0 && pick != 118) {
            g_scrRole[tc] = pick;
        }
        else {
            g_scrRole[tc] = BOTC_PickUnused(0, 12);
            if (g_scrRole[tc] == 118 || g_scrRole[tc] < 0) {
                g_scrRole[tc] = 0;                    // 兜底：洗衣妇
            }
        }
        BOTC_PmStore(g_teller, "【认知覆盖】酒鬼多抽到「悟道者」→ 换成 " + g_roleName[g_scrRole[tc]] + "。");
    }
    // 【气球驾驶员（72）】：掷到 +1 的时候他已经被钉进场了，这里把他塞进镇民池（随机顶掉一个，
    //   酒鬼那份额外身份在 g_scrRole[tc]，不动它）
    if (balloon == 1) {
        balFound = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 72) {
                balFound = 1;
            }
        }
        if (balFound == 0 && tc > 0) {
            k = RandomInt(0, tc - 1);
            if (g_scrRole[k] >= 0) {
                g_scrUsed[g_scrRole[k]] = false;
            }
            g_scrRole[k] = 72;
            g_scrUsed[72] = true;
        }
    }
    // 【村夫（105）】（用户 2026-10-10）：[+0~2 村夫] —— 本局的村夫总数 = 1 + 摇到的数（摇到 0 就只靠随机抽）。
    //   多出来的村夫顶掉一个别的镇民（跟气球驾驶员那条「钉进场」同一个做法）。
    if (BOTC_BoardHasRole(105) && g_villRoll > 0 && tc > 0) {
        k = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 105) {
                k = k + 1;
            }
        }
        k = 1 + g_villRoll - k;              // 还差几个才够
        for (i = 0; i < k; i += 1) {
            pick = RandomInt(0, tc - 1);
            if (g_scrRole[pick] == 105) {
                continue;                   // 这一格本来就是村夫
            }
            if (g_scrRole[pick] >= 0) {
                g_scrUsed[g_scrRole[pick]] = false;
            }
            g_scrRole[pick] = 105;
            g_scrUsed[105] = true;
        }
        BOTC_PmStore(g_teller, "【配比】村夫摇骰子 → +" + IntToString(g_villRoll) + " 名村夫（本局村夫共 " + IntToString(1 + g_villRoll) + " 名）。");
    }
    if (extra == 1) {
        g_mark[(g_teller * 14) + drunkSeat] = g_scrRole[tc] + 1;
        g_tokOn[(((g_teller * 14) + drunkSeat) * 256) + 8] = true;
        // 【酒鬼也来一条】（用户 2026-10-16）：认知覆盖那几个里只有酒鬼没有这行提示，写法跟提线木偶 / 悟道者一致
        BOTC_PmStore(g_teller, "【酒鬼】" + BOTC_NameStr(drunkSeat) + " 以为自己是「" + g_roleName[g_scrRole[tc]] + "」。");
    }
    for (i = 0; i < tc; i += 1) {
        g_mark[(g_teller * 14) + g_scrSeat[pos]] = g_scrRole[i] + 1;
        pos = pos + 1;
    }
    // 【悟道者（118）】（用户 2026-10-16 第二次修）：跟酒鬼**镜像** ----
    //   酒鬼 = 外来者 + 多抽一张镇民；悟道者 = 镇民 + 多抽一张**外来者**卡。
    //   ⚠ 必须在**上面那圈「把镇民写进魔典」的循环之后**才跑 ---- 上一版插在它前面，
    //     被那圈循环（把 g_scrRole[i] = 118 写回那一格）覆盖掉了，魔典上还是「悟道者」+ 一枚「是悟道者」token。
    //   ⚠ 那张外来者卡**不能是认知覆盖类**（酒鬼 14 / 疯子 38）---- 用户 2026-10-16 + 百科。
    wudSeat = 0;
    wudRole = -1;
    for (i = 0; i < tc; i += 1) {
        if (g_scrRole[i] == 118) {
            wudSeat = g_scrSeat[pos - tc + i];                // pos 这时候已经走过 tc 个镇民了
        }
    }
    if (wudSeat >= 2) {
        for (k = 0; k < 64; k += 1) {
            pick = BOTC_PickBoardRole(1);
            if (pick < 0) {
                break;
            }
            if (pick == 14 || pick == 38) {
                continue;                                     // 认知覆盖类不能当（换下一个）
            }
            wudRole = pick;
            break;
        }
        if (wudRole < 0) {
            wudRole = BOTC_PickUnused(13, 16);
            if (wudRole == 14 || wudRole == 38) {
                wudRole = 15;                                 // 兜底：陌客
            }
        }
        if (wudRole < 0) {
            wudRole = 15;
        }
        g_mark[(g_teller * 14) + wudSeat] = wudRole + 1;
        g_tokOn[(((g_teller * 14) + wudSeat) * 256) + 140] = true;
        BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(wudSeat) + " 以为自己是「" + g_roleName[wudRole] + "」。");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：掷到 +0 那次，他真在场就说明一句（+1 那次上面改配比时已经提示过）
    if (g_balPlus == false && BOTC_RoleInPlay(72)) {
        BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 镇民不变。");
    }
    // 疯子（38）：延续酒鬼那套写法 ---- 魔典上写「他以为自己是」的那只恶魔（本局真恶魔那只），
    //   真相靠「是疯子」token(49)；他每夜要选几个人按那只恶魔的选人数算。
    for (i = 2; i <= 13; i += 1) {
        if (g_mark[(g_teller * 14) + i] - 1 != 38) {
            continue;
        }
        r = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_mark[(g_teller * 14) + k] - 1 >= 0 && BOTC_RoleTeam(g_mark[(g_teller * 14) + k] - 1) == 3) {
                r = g_mark[(g_teller * 14) + k] - 1;
            }
        }
        if (r > 0) {
            g_mark[(g_teller * 14) + i] = r + 1;                   // 让他以为自己是那只恶魔
            if (g_roleTargets[r] > 0) {
                g_roleTargets[38] = g_roleTargets[r];
            }
            else {
                g_roleTargets[38] = 1;
            }
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(i) + " 以为自己是「" + g_roleName[r] + "」。");
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 49] = true;        // 是疯子
    }
    // 【卡扎力（135）】随机发牌设置：把原有爪牙牌换成不在场的善良角色；首夜自动唤醒后只私聊。
    BOTC_KazaliCompositionApply();
    // 随机配板收尾：占卜师在场就自动指定干扰项
    BOTC_PickRedHerring();
    // 茶艺师（32）：角色一写进魔典就把「不会死亡（茶艺师）」刷出来（用户 2026-09-20：随机发放时也要有）
    BOTC_SailorSync();
    BOTC_TeaLadySync();
    BOTC_FoolSync();
    // 伪装口供：**不自动安排**（用户要求），只提醒邪恶玩家自己挑
    BOTC_ClaimHint();
    // 无神论者（83）在场：本局没有邪恶角色（爪牙 / 恶魔的座位换成不在场的善良角色）
    if (BOTC_AtheistOn()) {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            r = BOTC_SeatTrueRole(i);
            if (BOTC_RoleTeam(r) == 2 || BOTC_RoleTeam(r) == 3) {
                r = BOTC_PickBoardGood();
                if (r > 0) {
                    BOTC_SetSeatRole(g_teller, i, r);
                    BOTC_SetSeatRole(g_who[i], i, r);
                }
            }
        }
        BOTC_PmStore(g_teller, "【无神论者】在场：爪牙和恶魔的座位已换成不在场的善良角色（本局没有邪恶）。");
    }
    // 巡山人（77）在场：必定有一个外来者是落难少女（82）
    if (BOTC_RoleInPlay(77) && !BOTC_RoleInPlay(82)) {
        r = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 1) {
                r = i;
                break;
            }
        }
        if (r >= 2) {
            BOTC_SetSeatRole(g_teller, r, 82);
            BOTC_SetSeatRole(g_who[r], r, 82);
            BOTC_PmStore(g_teller, "【巡山人】在场：外来者的座位（" + BOTC_NameStr(r) + "）已换成落难少女。");
        }
    }
    // 【半兽人（107）· 失足】/【解谜大师（109）· 醉酒】（用户 2026-10-10）：**随机发身份**时就打上，
    //   而且是在候选座位里**随机抽一个**（用户 2026-10-10 报「总是落在最前面那两格」→ 原来的写法是"挑第一个"）。
    if (BOTC_RoleInPlay(107)) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_SeatTrueRole(i) == 107) { continue; }
            n = n + 1;
        }
        pick = 0;
        if (n > 0) {
            k = RandomInt(1, n);
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatAlign(i) != 0) { continue; }
                if (BOTC_SeatTrueRole(i) == 107) { continue; }
                k = k - 1;
                if (k <= 0) { pick = i; break; }
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 127] = true;
            BOTC_PmStore(g_teller, "【半兽人】失足标记：" + BOTC_NameStr(pick));
        }
    }
    if (BOTC_RoleInPlay(109)) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_SeatTeam(i) != 0) { continue; }
            n = n + 1;
        }
        pick = 0;
        if (n > 0) {
            k = RandomInt(1, n);
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatTeam(i) != 0) { continue; }
                k = k - 1;
                if (k <= 0) { pick = i; break; }
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 129] = true;
            BOTC_PmStore(g_teller, "【解谜大师】醉酒标记：" + BOTC_NameStr(pick));
        }
    }
    // 唱诗男孩（108）在场：一个镇民换成国王（104）—— 照上面「巡山人 → 落难少女」那条写法
    if (BOTC_RoleInPlay(108) && !BOTC_RoleInPlay(104)) {
        r = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_HasAbility(i, 108)) { continue; }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 0) { r = i; break; }
        }
        if (r >= 2) {
            BOTC_SetSeatRole(g_teller, r, 104);
            BOTC_SetSeatRole(g_who[r], r, 104);
            BOTC_PmStore(g_teller, "【唱诗男孩】在场：镇民的座位（" + BOTC_NameStr(r) + "）已换成国王。");
        }
    }
    // 【堤丰之首（111）】（用户 2026-10-10）：发牌设置 —— 一个善良变爪牙 + 邪恶排成邻座、他坐中间
    if (BOTC_RoleInPlay(111)) {
        BOTC_HfTyphonSetup();
    }
    BOTC_MarionetteSync();
    // 【暴风捕手（113）】（用户 2026-10-11）：发完牌就给「保护的身份」打上免死标记 + 播报一次
    BOTC_StormSync();
    // 重新发牌后清掉旧的死亡红叉，所有人的魔典都刷新一遍
    for (i = 1; i <= 13; i += 1) {
        BOTC_GrimRender(g_who[i]);
    }
}

// 确认发放：其他玩家自己的魔典里，只会自动填上"自己座位"的身份（token 不发）
void BOTC_ConfirmDeal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    BOTC_XaanSetupSync();          // 【限】初始外来者数量在确认发放的这一刻锁定
    for (q = 2; q <= 13; q += 1) {
        g_amnesiaRevealed[q] = false;        // 首次发放始终只发「失忆的X」
    }
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        // 【按「格子」发，不按玩家号】（用户 2026-10-18 报「换说书人之后老说书人没收到身份」）：
        //   老说书人现在是玩家 1、坐在别的格子；原来从玩家 2 开始循环，永远轮不到他。
        // 【每个人那份只留自己那一格】（用户 2026-10-18 报「座位4的玩家能看到座位3的身份」）：
        //   以前只写「自己那一格」，别的格子里上一把 / 复盘留下的字不清 → 会露出别人的身份。
        ob = g_who[q];
        for (t = 0; t <= 13; t += 1) {
            if (t == q) {
                g_mark[(ob * 14) + t] = BOTC_AmnesiaMaskRole(g_mark[(g_teller * 14) + t] - 1) + 1;
            }
            else {
                g_mark[(ob * 14) + t] = 0;
            }
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
        BOTC_GrimRender(ob);
    }
    // 身份发下去之后，邪恶角色那边才会出现【伪装身份】按钮
    BOTC_ClaimBtnRender();
    BOTC_FoolSync();               // 弄臣（34）：发完牌就先把「首次未死」标记打上（用户 2026-09-20）
    BOTC_SailorSync();
    BOTC_TeaLadySync();            // 茶艺师（32）：发完牌也刷一次「不会死亡（茶艺师）」标记
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21）：跟茶艺师一样 ---- 身份一发下去（入场）就把常驻效果打上，
    //   不等天亮 / 入夜。诺-达鲺：与他相邻的两名镇民中毒；涡流：镇民身上「信息错误（涡流）」。
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_StormSync();              // 【暴风捕手】发放身份时再同步一次免死标记（用户 2026-10-11）
    g_dealConfirmed = true;        // 记下「这一轮发牌确认过了」：正式开始时要用它校验
    g_swapUnlocked = false;        // 重新确认发放 → 再次锁上【换座位】（用户 2026-10-07）
    BOTC_SwapCancelAll();          // 【撤回所有人在选的换座位】（用户 2026-10-11）
    BOTC_BsBtnRender();            // 【发完牌立刻收掉【换座位】按钮】（用户 2026-10-07）
    BOTC_NoticeBox(g_teller, "已确认发放身份");
    // 【发放之后自动弹「游戏帮助」】（用户 2026-09-20）：让每个玩家立刻看到自己的角色能力
    //   【按坐的格子找人】（用户 2026-10-18）：换说书人之后玩家 1 也是玩家，别漏掉他
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        g_tipForce[g_who[q]] = -1;       // 发牌自动弹的这一份必须显示「你自己的角色」，别被谁在能力表点过的详情锁住（用户 2026-09-30）
        BOTC_TipOpen(g_who[q]);
    }
    BOTC_GrimShareRender();        // 确认发放后立即刷新说书人的测试发送按钮
}

//--------------------------------------------------------------------------------------------------
// 不在场身份（右下角面板）
//--------------------------------------------------------------------------------------------------
// 找被发了恶魔（小恶魔 = 索引21，存 22）的座位
//   小恶魔自刀传位之后会有两个座位都写着小恶魔：优先返回还活着的那一个
int BOTC_FindDemon () {
    int q;
    int fallback;
    fallback = 0;
    for (q = 2; q <= 13; q += 1) {
        // 【按阵营找恶魔】（用户 2026-09-19）：以前写死「小恶魔」，现在任何恶魔身份都算
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            if (fallback == 0) {
                fallback = q;
            }
            if (!BOTC_PublicDead(q)) {
                return q;
            }
        }
    }
    return fallback;
}

// who = 给谁刷新面板（说书人=1 / 恶魔玩家）
void BOTC_BluffRowRender (int who) {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_bluffPick[i];
        if (v > 0) {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
        else {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], "botc_blank.dds", PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(""), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
    }
}

void BOTC_BluffRender () {
    BOTC_BluffRowRender(g_teller);
}

//==================================================================================================
// 【疯子（38）的第二套不在场身份】（用户 2026-09-20）：
//   跟恶魔那套同一个右下角锚点、往上一格（y=252），按钮叫【随机 3 个（疯子）】【发送给疯子】；
//   抽的池子 = **当前板子里的镇民 / 外来者**且本局不在场；**有 25% 概率掺一个假的**（其实在场）。
//==================================================================================================
bool BOTC_BoardHasRole (int r) {
    int i;
    int b;
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        if (g_boardRole[(b * 256) + i] == r) {
            return true;
        }
    }
    return false;
}

void BOTC_LBluffRowRender (int who) {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_lbluffPick[i];
        if (v > 0) {
            libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
        else {
            libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], "botc_blank.dds", PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(""), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
    }
}

void BOTC_LBluffRender () {
    if (g_lbluffSent && g_lbluffTarget >= 2) {
        BOTC_LBluffRowRender(g_who[g_lbluffTarget]);
    }
    BOTC_LBluffRowRender(g_teller);
}

void BOTC_LBluffOpenPick (int ob, int slot) {
    g_pickMode[ob] = 1;
    g_pickBluffSlot[ob] = slot;
    g_pickBluffL = true;
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("不在场身份（疯子）" + IntToString(slot + 1) + " / 3"), PlayerGroupSingle(ob));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_LBluffRoll () {
    int i;
    int r;
    int n;
    int pick;
    int nPool;
    int[64] pool;
    for (i = 0; i < 3; i += 1) {
        g_lbluffPick[i] = 0;
    }
    nPool = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!BOTC_BoardHasRole(r)) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            continue;
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        pool[nPool] = r;
        nPool = nPool + 1;
    }
    for (i = 0; i < 3; i += 1) {
        if (nPool <= 0) {
            break;
        }
        pick = RandomInt(0, nPool - 1);
        g_lbluffPick[i] = pool[pick] + 1;
        pool[pick] = pool[nPool - 1];
        nPool = nPool - 1;
    }
    // 25% 概率掺一个「假的」（其实在场的身份）
    if (RandomInt(1, 100) <= 25) {
        n = 0;
        pick = 0;
        for (r = 0; r <= 148; r += 1) {
            if (!BOTC_BoardHasRole(r)) {
                continue;
            }
            if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
                continue;
            }
            if (!BOTC_RoleInPlay(r)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick > 0) {
            g_lbluffPick[RandomInt(0, 2)] = pick + 1;
            BOTC_PmStore(g_teller, "【疯子】给他的不在场身份里掺了一个假的（其实在场：" + g_roleName[pick] + "）。");
        }
    }
    BOTC_LBluffRender();
}

void BOTC_LBluffSend () {
    int i;
    int lu;
    lu = BOTC_RealLunaticSeat();
    if (lu < 2) {
        BOTC_Notice(g_teller, "场上没有疯子（38）：先发牌或手动把某个座位摆成疯子。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_lbluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个（疯子）】）。");
            return;
        }
    }
    if (g_lbluffSent && g_lbluffTarget >= 2 && g_lbluffTarget != lu) {
        DialogSetVisible(g_lbluffDlg, PlayerGroupSingle(g_who[g_lbluffTarget]), false);
    }
    g_lbluffTarget = lu;
    for (i = 0; i < 3; i += 1) {
        g_lbluffOut[i] = g_lbluffPick[i];
    }
    g_lbluffSent = true;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], BOTC_IconName(g_lbluffOut[i] - 1), PlayerGroupSingle(g_who[lu]));
        libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(g_roleName[g_lbluffOut[i] - 1]), PlayerGroupSingle(g_who[lu]));
    }
    DialogSetVisible(g_lbluffDlg, PlayerGroupSingle(g_who[lu]), true);
    BOTC_Notice(g_teller, "3 个不在场身份（疯子）已发送给 " + BOTC_NameStr(lu) + "。");
    BOTC_Notice(g_who[lu], "说书人给了你 3 个不在场身份（你是恶魔嘛），看右下角面板。");
}

void BOTC_BuildLBluff () {
    int i;
    int x;
    DialogCreate(396, 209, c_anchorBottomRight, 0, 332, false);   // 上面那块加高了，这套跟着往上挪
    g_lbluffDlg = DialogLastCreated();
    DialogSetVisible(g_lbluffDlg, PlayerGroupAll(), false);
    BOTC_NewLabel(g_lbluffDlg, 378, 26, 9, 4, StringToText("不在场身份（疯子）"));
    for (i = 0; i < 3; i += 1) {
        x = 14 + (i * 126);
        g_lbluffSeat[i] = BOTC_NewButton(g_lbluffDlg, 112, 112, x, 32, "");
        libNtve_gf_CreateDialogItemImage(g_lbluffDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_lbluffIcon[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_lbluffIcon[i], PlayerGroupAll(), c_anchorTopLeft, x - 7, 27);
        libNtve_gf_SetDialogItemAcceptMouse(g_lbluffIcon[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], "botc_blank.dds", PlayerGroupAll());
        g_lbluffName[i] = BOTC_NewLabel(g_lbluffDlg, 112, 26, x, 119, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_lbluffName[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupSingle(g_teller), true);
    }
    g_lbluffRollBtn = BOTC_NewButton(g_lbluffDlg, 175, 36, 14, 151, "随机 3 个（疯子）");
    g_lbluffSendBtn = BOTC_NewButton(g_lbluffDlg, 175, 36, 207, 151, "发送给疯子");
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupSingle(g_teller), true);
    g_lbluffSent = false;
    g_lbluffTarget = 0;
    for (i = 0; i < 3; i += 1) {
        g_lbluffPick[i] = 0;
        g_lbluffOut[i] = 0;
    }
    BOTC_LBluffRender();
}

// 随机抽 3 个不在场身份：只从好身份（镇民 + 外来者）里抽，并避开魔典里已经选过的
// 这个身份算不算「受限的伪装」：**首夜信息位**（洗衣妇 / 图书管理员 / 调查员 / 厨师）
//   或者**外来者**（管家 / 酒鬼 / 陌客 / 圣徒）。
//   给恶魔的 3 个伪装里，这一类**最多只出现 1 个**（两个池都够抽的时候）。
//   ⚠ 共情者 / 占卜师是**持续信息位**，**不算**在首夜信息位里 ---- 它们不受这条限制。
bool BOTC_BluffRestricted (int idx) {
    if (idx < 0 || idx > 148) {
        return false;
    }
    if (BOTC_RoleTeam(idx) == 1) {
        return true;                   // 外来者（黯月初升也一样：修补匠 / 月之子 / 莽夫 / 疯子）
    }
    if (g_roleAct[idx] == 5 && BOTC_RoleAlign(idx) == 0) {
        return true;                   // 首夜信息位：只有首夜能拿信息的善良角色（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母...）
    }
    return false;
}

void BOTC_BluffRoll () {
    int b;
    int r;
    int i;
    int idx;
    int k;          // 这次要放几个「受限」身份（正常只有 0 或 1）
    int nA;
    int nB;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
    }
    // 候选池：不在场的镇民 / 外来者（BOTC_RoleInPlay 里已经处理了酒鬼：魔典上是他
    // 「以为自己是」的身份，酒鬼本身也不会被当成不在场身份），分成两堆
    nA = 0;
    nB = 0;
    // 【按当前板子取】（用户 2026-09-20）：以前写死 0..16，黯月初升会抽到暗流涌动的身份 ----
    //   现在从当前板子的角色清单里挑「不在场的镇民 / 外来者」，分成两堆。
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            continue;                  // 只从镇民 / 外来者里抽
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        if (BOTC_BluffRestricted(r)) {
            g_bfA[nA] = r + 1;
            nA = nA + 1;
        }
        else {
            g_bfB[nB] = r + 1;
            nB = nB + 1;
        }
    }
    // 受限的那一个：两个池都够抽的时候像掷硬币（一半有、一半没有）；
    //   普通池凑不满 3 个就补上（补到 3 个为止），实在不够才会出现两个以上受限的
    k = 0;
    if (nA > 0) {
        if (nB >= 3) {
            if (RandomInt(1, 2) == 1) {
                k = 1;
            }
        }
        else {
            k = 3 - nB;
            if (k > nA) {
                k = nA;
            }
        }
    }
    for (i = 0; i < 3; i += 1) {
        if (k > 0 && nA > 0) {
            // 先抽那 1 个受限身份；抽完 k 归 0，后面的位子全走普通池
            idx = RandomInt(0, nA - 1);
            g_bluffPick[i] = g_bfA[idx];
            nA = nA - 1;
            g_bfA[idx] = g_bfA[nA];
            k = k - 1;
        }
        else {
            if (nB > 0) {
                idx = RandomInt(0, nB - 1);
                g_bluffPick[i] = g_bfB[idx];
                nB = nB - 1;
                g_bfB[idx] = g_bfB[nB];
            }
            else {
                if (nA > 0) {
                    // 普通池抽干了（小局里镇民大多在场）：只能用受限身份补位
                    idx = RandomInt(0, nA - 1);
                    g_bluffPick[i] = g_bfA[idx];
                    nA = nA - 1;
                    g_bfA[idx] = g_bfA[nA];
                }
                else {
                    g_bluffPick[i] = 0;
                }
            }
        }
    }
    BOTC_BluffRender();
}

void BOTC_BluffOpenPick (int ob, int slot) {
    g_pickMode[ob] = 1;
    g_pickBluffSlot[ob] = slot;
    g_pickBluffL = false;         // 这一套是「给恶魔」的
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("不在场身份 " + IntToString(slot + 1) + " / 3"), PlayerGroupSingle(ob));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_BluffSend () {
    int dm;
    int i;
    dm = BOTC_FindDemon();
    if (dm == 0) {
        BOTC_Notice(g_teller, "还没确定恶魔：先在魔典里随机发牌，或手动把某个座位选成小恶魔。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    // 换了发送对象：把上一个恶魔的面板收掉
    if (g_bluffSent && g_bluffTarget != dm && g_bluffTarget > 0) {
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[g_bluffTarget]), false);
    }
    g_bluffTarget = dm;
    for (i = 0; i < 3; i += 1) {
        g_bluffOut[i] = g_bluffPick[i];
    }
    g_bluffSent = true;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffOut[i] - 1), PlayerGroupSingle(g_who[dm]));
        libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffOut[i] - 1]), PlayerGroupSingle(g_who[dm]));
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[dm]), true);
    g_bluffGot[g_who[dm]] = true;
    BOTC_NoticeBox(g_teller, "3 个不在场身份已发送给 " + BOTC_NameStr(dm) + "。");
    BOTC_Notice(g_who[dm], "说书人给了你 3 个不在场身份，看右下角面板。");
}

// 【发送给疯子】（用户 2026-09-20）：把这次挑好的 3 个「不在场身份」发给**带着「是疯子」token（49）**的那个座位 ----
//   ⚠ 判据是 token，不是真身：手动摆两个恶魔、再给其中一个打「是疯子」的玩法也照样能用。
//   面板用的是同一块（图标 / 文字本来就是「每个玩家各看各的」），所以直接给他设一份就行。
void BOTC_BluffSendToLunatic () {
    int i;
    int lu;
    lu = BOTC_RealLunaticSeat();         // 带「是疯子」但不是哲学家的那一个（用户 2026-09-21）
    if (lu < 2) {
        BOTC_NoticeBox(g_teller, "没找到「疯子」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    if (g_bluffTargetL >= 2 && g_bluffTargetL != lu) {
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[g_bluffTargetL]), false);
    }
    g_bluffTargetL = lu;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[lu]));
        libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[lu]));
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[lu]), true);
    g_bluffGot[g_who[lu]] = true;
    BOTC_NoticeBox(g_teller, "3 个不在场身份已发送给疯子 " + BOTC_NameStr(lu) + "。");
    BOTC_Notice(g_who[lu], "说书人给了你 3 个不在场身份，看右下角面板。");
}

// 【发送给疯子（哲学家）】（用户 2026-09-21）：发给身上同时带「是哲学家(70)」+「是疯子(49)」的那个座位。
//   只发这 3 个不在场身份，**不发爪牙**（新恶魔本来就不知道场上的爪牙有谁）。
void BOTC_BluffSendToPhiloLunatic () {
    int i;
    int lu;
    lu = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] && g_tokOn[(((g_teller * 14) + i) * 256) + 49]) {
            lu = i;
        }
    }
    if (lu < 2) {
        BOTC_Notice(g_teller, "没找到[哲学家疯子]。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    if (g_bluffTargetP >= 2 && g_bluffTargetP != lu) {
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[g_bluffTargetP]), false);
    }
    g_bluffTargetP = lu;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[lu]));
        libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[lu]));
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[lu]), true);
    g_bluffGot[g_who[lu]] = true;
    BOTC_NoticeBox(g_teller, "3 个不在场身份已发送给「哲学家疯子」" + BOTC_NameStr(lu) + "。");
    BOTC_Notice(g_who[lu], "说书人给了你 3 个不在场身份，看右下角面板。");
}

bool BOTC_BountyTrigger () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!g_tokOn[(((g_teller * 14) + i) * 256) + 114]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            return true;
        }
    }
    return false;
}

bool BOTC_LegionOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == 94) {
            return true;
        }
    }
    return false;
}
bool BOTC_LegionLunatic () {
    int q;
    q = BOTC_RealLunaticSeat();
    if (q < 2) {
        return false;
    }
    return (g_mark[(g_teller * 14) + q] - 1 == 94);
}

// 【军团 · 首夜互认】（用户 2026-09-30）：军团在场时不再整段跳过，改成**直接把队友位置写进各人自己那份魔典**。
//   · 真身是军团的玩家：看见其他真身军团的座位（那个「以为是军团」的疯子不标给他；疯子是谁照旧走首夜那条私聊）
//   · 疯子（他以为自己是军团）：照旧把军团标给他，但说书人能在弹窗里填两个座位号把这两人**屏蔽**掉；
//     什么都不填就点确定 = 不屏蔽；点取消 = 不屏蔽（疯子看到所有队友）。
//   只写每个玩家自己那一行 g_mark[p*14 + q]（= 他自己魔典上显示的），不动说书人那份、也不改任何技能判定。
int BOTC_LegionMarkFor (int who, int hide1, int hide2) {
    int i;
    int mag;
    int q;
    int n;
    int w;
    n = 0;
    if (who < 2 || who > 13) {
        return 0;
    }
    w = who * 14;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == BOTC_PosOf(who)) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) != 94) {
            continue;
        }
        if (q == hide1 || q == hide2) {
            continue;
        }
        g_mark[w + q] = 95;                 // 95 = 军团（94）+ 1
        n = n + 1;
    }
    // 相克：军团互认时把魔术师也标成军团，并私聊告知军团玩家「魔术师在场」。
    mag = BOTC_MagicianSeatNow();
    if (mag >= 2 && mag != BOTC_PosOf(who)) {
        if (g_mark[w + mag] != 95) {
            g_mark[w + mag] = 95;
            n = n + 1;
        }
        BOTC_PmInfo(who, "【信息】魔术师在场，他也被标成军团。");
        BOTC_PmStore(g_teller, "【军团×魔术师相克】已在 " + BOTC_NameStr(BOTC_PosOf(who)) + " 的魔典上把 " + BOTC_NameStr(mag) + " 标成军团，并私聊告知魔术师在场。");
    }
    BOTC_GrimRender(who);
    // 私聊跟魔典同一时刻（用户 2026-09-30）：只说「标好了」，不列名字
    if (n > 0) {
        BOTC_PmStore(who, "【军团】已在魔典上标记所有军团。");
    }
    else {
        BOTC_PmStore(who, "【军团】你的魔典上没有标出其他军团。");
    }
    return n;
}

// 假军团（疯子）那一份：按说书人填的两个座位屏蔽（0 = 不屏蔽）
void BOTC_LegionLunaticApply (int hide1, int hide2) {
    int i;
    int q;
    int lu;
    string s;
    g_lgPend = false;             // 框已经答完了（确定 / 取消都走这里）
    lu = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) == 94) {
            continue;
        }
        if (g_mark[(g_teller * 14) + q] - 1 != 94) {
            continue;
        }
        lu = q;
    }
    if (lu < 2) {
        return;
    }
    BOTC_LegionMarkFor(g_who[lu], hide1, hide2);
    s = "";
    if (hide1 >= 2) {
        s = BOTC_NameStr(hide1);
    }
    if (hide2 >= 2) {
        if (StringLength(s) > 0) {
            s = s + "、";
        }
        s = s + BOTC_NameStr(hide2);
    }
    if (StringLength(s) <= 0) {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上标了全部军团（没有屏蔽）。");
    }
    else {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上屏蔽了：" + s + "。");
    }
    // 那个答题框是共用的：军团这步把按钮文字改成了「确认」，用完必须还原
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
}

// 首夜互认主入口：真军团互相标出来；有假军团（疯子）就弹框问说书人要屏蔽哪两个
bool BOTC_LegionRecognize () {
    int i;
    int q;
    int n;
    int nLu;
    int lu;
    n = 0;
    nLu = 0;
    lu = 0;
    if (!BOTC_LegionOn()) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) == 94) {
            BOTC_LegionMarkFor(g_who[q], 0, 0);
            n = n + 1;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) == 94) {
            continue;
        }
        if (g_mark[(g_teller * 14) + q] - 1 != 94) {
            continue;
        }
        lu = q;
        nLu = nLu + 1;
    }
    if (n <= 0) {
        return false;
    }
    if (nLu <= 0) {
        BOTC_PmStore(g_teller, "【军团】首夜互认：队友位置已直接标在各自魔典上（真军团 " + IntToString(n) + " 名，场上没有假军团）。");
        return false;
    }
    BOTC_PmStore(g_teller, "【军团】首夜互认：真军团位置已经直接标进各自魔典；疯子是 " + BOTC_NameStr(lu) + "，接着填两个要屏蔽的座位号（空着或取消 = 全给他看）。");
    g_lgPend = true;        // 这个框答完之前，【开始唤醒】不许往下走（否则会顺带唤醒别人 / 把框顶掉）
    BOTC_ManInfoOpenSeats(lu, "【军团】填两个不给疯子看的座位号（空着或点取消 = 全给他看）", 9);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);        // 这一步要能取消
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("确认"), PlayerGroupSingle(g_teller));
    return true;
}

// 【发送互认】按钮（用户 2026-09-30）：说书人按一下，当场把首夜互认发出去 ----
//   ① 有军团 → 走军团那一套：队友位置直接写进各自魔典；假军团「疯子」弹框屏蔽两个
//   ② 普通恶魔 / 爪牙 → 恶魔知道爪牙、爪牙知道恶魔和其他爪牙（提线木偶不算，跳过）
//   ③ 疯子（38）：带「是哲学家」token 的不参与互认；以为自己是军团 → 已由 ① 处理；
//      以为是普通恶魔 → 弹「填两个爪牙」那个框（kind = 0）
void BOTC_SendRecognize () {
    int i;
    int j;
    int q;
    int r;
    int dm;
    int mag;
    int dn;
    int n;
    int lu;
    string s;
    string s2;
    string sd;
    if (g_lgPend) {
        BOTC_Notice(g_teller, "先把正在弹的那个「疯子屏蔽」框处理掉（点【确认】或【取消】），再按【发送互认】。");
        return;
    }
    BOTC_BuildSeatList();
    // 【暴风捕手】（用户 2026-10-11）：手动发互认时也顺手把「你得知 A 是 B」补一次（一局只发一次）
    BOTC_StormEvilStep();
    // 【罂粟种植者】不管是原生、科怪赋予还是手工赋予，只要能力正在生效，
    // 普通爪牙 / 恶魔互认就必须跳过；恶魔得知疯子是谁不占这一步，仍然补发。
    if (BOTC_PoppyActive()) {
        BOTC_PmStore(g_teller, "【罂粟种植者】能力正在生效 → 已跳过普通爪牙 / 恶魔互认。");
        BOTC_NotifyDemonsLunatic();
        return;
    }
    // ---- ① 军团：魔典那一套（含疯子屏蔽框）----
    if (BOTC_LegionOn()) {
        if (BOTC_LegionRecognize()) {
            return;                        // 弹了疯子的屏蔽框：等他答完再管别的
        }
        BOTC_NotifyDemonsLunatic();
        return;
    }
    // ---- ② 恶魔 / 爪牙互认（军团局没有爪牙，整段跳过）----
    dm = 0;
    mag = BOTC_MagicianSeatNow();
    if (!BOTC_LegionOn()) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
                dm = q;
            }
        }
        if (dm >= 2) {
            // 恶魔 → 爪牙名单
            s = "";
            n = 0;
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                r = BOTC_SeatTrueRole(q);
                if (BOTC_RoleTeam(r) != 2 && q != mag) {
                    continue;
                }
                if (BOTC_IsMarionette(q) && q != mag) {
                    continue;
                }
                if (n > 0) {
                    s = s + ",";
                }
                s = s + BOTC_NameStr(q);
                n = n + 1;
            }
            if (n > 0) {
                s2 = "【信息】你得知你的爪牙是：" + s + "。";
                BOTC_PmInfo(g_who[dm], s2);
                BOTC_PmStore(g_teller, "【邪恶信息】恶魔(" + BOTC_NameStr(dm) + ") 的爪牙：" + s);
            }
            else {
                BOTC_PmInfo(g_who[dm], "【信息】你得知没有爪牙。");
            }
            // 爪牙 → 恶魔 + 其他爪牙
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                r = BOTC_SeatTrueRole(q);
                if (BOTC_RoleTeam(r) != 2) {
                    continue;
                }
                if (BOTC_IsMarionette(q)) {
                    continue;
                }
                sd = "";
                dn = 0;
                s = "";
                n = 0;
                for (j = 0; j < g_seatN; j += 1) {
                    if (g_seatList[j] == q) {
                        continue;
                    }
                    if (g_seatList[j] == dm || g_seatList[j] == mag) {
                        if (dn > 0) {
                            sd = sd + ",";
                        }
                        sd = sd + BOTC_NameStr(g_seatList[j]);
                        dn = dn + 1;
                    }
                }
                for (j = 0; j < g_seatN; j += 1) {
                    if (g_seatList[j] == q) {
                        continue;
                    }
                    if (g_seatList[j] == dm || g_seatList[j] == mag) {
                        continue;
                    }
                    r = BOTC_SeatTrueRole(g_seatList[j]);
                    if (BOTC_RoleTeam(r) != 2) {
                        continue;
                    }
                    if (BOTC_IsMarionette(g_seatList[j])) {
                        continue;
                    }
                    if (n > 0) {
                        s = s + ",";
                    }
                    s = s + BOTC_NameStr(g_seatList[j]);
                    n = n + 1;
                }
                s2 = "【信息】你得知" + sd + "是恶魔。";
                if (n > 0) {
                    s2 = s2 + "爪牙：" + s + "。";
                }
                else {
                    s2 = s2 + "本局没有其他爪牙。";
                }
                BOTC_PmInfo(g_who[q], s2);
                BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「" + s2 + "」");
            }
        }
    }
    // 普通恶魔 / 爪牙互认已经全部发完，再告诉恶魔谁是疯子。
    BOTC_NotifyDemonsLunatic();
    // ---- ③ 疯子 ----
    lu = BOTC_RealLunaticSeat();
    if (lu < 2) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + lu) * 256) + 70]) {
        BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(lu) + " 是哲学家假装的 → 不参与互认。");
        return;
    }
    if (BOTC_LegionOn()) {
        return;                            // 军团局：他以为自己是军团，① 那一步已经处理
    }
    BOTC_ManInfoOpenSeats(lu, "【疯子】填爪牙1~4；点【取消】= 不发送（可用于罂粟局）", 0);
}

// 【军团】疯子屏蔽框还没答完 → true = 这次唤醒先别走（框已经不在了就当成「不屏蔽」自愈收尾）
bool BOTC_LegionPendBlock () {
    if (!g_lgPend) {
        return false;
    }
    if (g_miRole == 41 && g_miKind == 9) {
        BOTC_Notice(g_teller, "先把军团那个「疯子屏蔽」框处理掉：点【确认】或【取消】。");
        return true;
    }
    g_lgPend = false;
    BOTC_LegionLunaticApply(0, 0);
    BOTC_NotifyDemonsLunatic();
    return false;
}

// 真人说书答题框点「取消」：只有军团那一步需要收尾（不屏蔽，疯子看到所有队友）
void BOTC_MiCancelApply () {
    // 【疯子假爪牙】点取消 = 这次什么都不发，可用于罂粟种植者局手动控制疯子是否知情。
    if (g_miRole == 41 && g_miKind == 0) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_PmStore(g_teller, "【疯子】已取消本次爪牙信息，不向疯子发送任何内容。");
        return;
    }
    // 【二选一醉酒】（用户 2026-10-16）：点取消 = 这次谁也不醉（只有中毒/酒鬼那次才给取消键）
    if (g_miRole == 807) {
        g_miRole = -1;
        g_dkKind = 0;
        g_dkFrom = 0;
        g_dkA = 0;
        g_dkB = 0;
        return;
    }
    // 【发送特定信息】（用户 2026-10-10）：取消 = 退出「点收件人」模式（不然下一次点座位又会弹框）
    if (g_miRole == 801 || g_miRole == 802 || g_miRole == 803 || g_miRole == 808) {
        g_specMode = 0;
        g_specTo = 0;
        g_miSeat = 0;
        g_miRole = -1;
    }
    if (g_miRole == 41 && g_miKind == 9) {
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(0, 0);
        BOTC_NotifyDemonsLunatic();
    }
    // 【半兽人（107）】那个「让不让他杀」的框点取消 = 不杀（恶魔正常出刀）
    if (g_miRole == 805) {
        g_lycanTgt = 0;
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmStore(g_teller, "【半兽人】这次不杀 → 恶魔正常出刀。");
    }
}

bool BOTC_LegionVoteVoid () {
    int i;
    int n;
    if (!BOTC_LegionOn()) {
        return false;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_vote[i] != 1) {
            continue;
        }
        if (BOTC_WinAlignOf(i) == 0) {
            return false;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return false;
    }
    return true;
}

// 【发送给所有恶魔】（用户 2026-09-30）：一键把 3 个不在场身份发给**所有恶魔**（军团局省事）。
//   跳过身上带「是疯子(49)」或「是哲学家(70)」token 的座位（认知覆盖的假恶魔，不该收），
//   也跳过真身是提线木偶的座位。
void BOTC_BluffSendToDemons () {
    int i;
    int q;
    int r;
    int n;
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 3) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 49] || g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        for (i = 0; i < 3; i += 1) {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[q]));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[q]));
        }
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[q]), true);
        g_bluffGot[g_who[q]] = true;
        BOTC_Notice(g_who[q], "说书人给了你 3 个不在场身份，看右下角面板。");
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "没有符合条件的恶魔（带「是疯子」或「是哲学家」的会跳过）。");
    }
    else {
        BOTC_NoticeBox(g_teller, "3 个不在场身份已发送给 " + IntToString(n) + " 名恶魔。");
    }
}

void BOTC_BluffSendToMinions () {
    int i;
    int q;
    int r;
    int n;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 2) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffRoll();
        for (i = 0; i < 3; i += 1) {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[q]));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[q]));
        }
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[q]), true);
        g_bluffGot[g_who[q]] = true;
        BOTC_Notice(g_who[q], "说书人给了你 3 个不在场身份，看右下角面板。");
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "场上没有爪牙（提线木偶不算）。");
        return;
    }
    BOTC_NoticeBox(g_teller, "3 个不在场身份已分别发给 " + IntToString(n) + " 名爪牙。");
}

void BOTC_BluffSendStart () {
    int i;
    if (g_bluffPickSeat) {
        g_bluffPickSeat = false;
        BOTC_Notice(g_teller, "已取消发送不在场身份。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffPickSeat = true;
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    BOTC_GrimRender(g_teller);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个座位：把这 3 个不在场身份发给他。");
}

void BOTC_BluffSendAt (int q) {
    int i;
    g_bluffPickSeat = false;
    if (q < 2 || q > 13) {
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_who[q]));
        libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[g_bluffPick[i] - 1]), PlayerGroupSingle(g_who[q]));
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[q]), true);
    g_bluffGot[g_who[q]] = true;
    BOTC_NoticeBox(g_teller, "3 个不在场身份已发给 " + BOTC_NameStr(q) + "。");
    BOTC_Notice(g_who[q], "说书人给了你 3 个不在场身份，看右下角面板。");
}

void BOTC_BuildBluff () {
    int i;
    int x;
    DialogCreate(396, 198, c_anchorBottomRight, 0, 0, false);
    g_bluffDlg = DialogLastCreated();
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);

    g_bluffTitle = BOTC_NewLabel(g_bluffDlg, 378, 26, 9, 4, StringToText("不在场身份"));
    libNtve_gf_SetDialogItemStyle(g_bluffTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bluffTitle, false, PlayerGroupAll());

    for (i = 0; i < 3; i += 1) {
        x = 14 + (i * 126);
        g_bluffSeat[i] = BOTC_NewButton(g_bluffDlg, 112, 112, x, 32, "");
        libNtve_gf_CreateDialogItemImage(g_bluffDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_bluffIcon[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_bluffIcon[i], PlayerGroupAll(), c_anchorTopLeft, x - 7, 27);
        libNtve_gf_SetDialogItemAcceptMouse(g_bluffIcon[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], "botc_blank.dds", PlayerGroupAll());
        g_bluffName[i] = BOTC_NewLabel(g_bluffDlg, 112, 26, x, 119, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_bluffName[i], false, PlayerGroupAll());
        // 3 个坑位只有说书人能点（恶魔那边只显示图，不给点）
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupSingle(g_teller), true);
    }

    g_bluffRollBtn = BOTC_NewButton(g_bluffDlg, 175, 36, 14, 151, "随机 3 个");
    g_bluffSendBtn = BOTC_NewButton(g_bluffDlg, 175, 36, 207, 151, "发送");
    // 【发送给所有恶魔】（用户 2026-09-30）：面板右上角，一键发给所有恶魔（军团局省事）
    g_bluffSendAllBtn = BOTC_NewButton(g_bluffDlg, 150, 26, 237, 2, "发送给所有恶魔");
    // 【字体小一号】（用户 2026-09-30）：默认按钮字体太大，150 宽的按钮里「发送给所有恶魔」挤得慌；
    //   项目里能用的最小档就是 ModLeftSize16Bold（14 那档当前依赖里没有，见记忆里那次乱码事故）
    libNtve_gf_SetDialogItemStyle(g_bluffSendAllBtn, "ModLeftSize16Bold", PlayerGroupAll());
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);

    g_bluffSent = false;
    g_bluffTarget = 0;
    g_availN = 0;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
        g_bluffOut[i] = 0;
    }
    BOTC_BluffRender();
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
}

//--------------------------------------------------------------------------------------------------
// 提名 / 投票
//--------------------------------------------------------------------------------------------------
string BOTC_CdImg (int sec) {
    if (sec < 0) {
        sec = 0;
    }
    if (sec > 10) {
        sec = 10;
    }
    if (sec == 10) {
        return "botc_cd10.dds";
    }
    return "botc_cd" + IntToString(sec) + ".dds";
}

string BOTC_NomHeadStr () {
    if (g_nomFrom > 0 && g_nomTo > 0) {
        return BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo);
    }
    return "提名环节";
}

string BOTC_NomHintStr () {
    // 【教派投票】（用户 2026-10-10）：这一行不写固定文案 —— 由 BOTC_CdRender 每半秒写成「倒计时：X 秒」
    if (g_phase == 0) {
        return "";
    }
    if (g_phase == 1) {
        return "";                      // 小字提示删掉（用户 2026-09-22）：改成屏幕正中那条大字提示
    }
    if (g_phase == 2) {
        return BOTC_NameStr(g_nomPickBy) + " 正在选择提名对象。";
    }
    if (g_phase == 3) {
        if (g_nomFrom == g_nomTo) {
            return BOTC_NameStr(g_nomFrom) + " 提名自己（只需发言一次，最多 60 秒），说完点右下角【结束发言】。";
        }
        return BOTC_NameStr(g_nomFrom) + " 陈述提名理由（最多 60 秒），说完点右下角【结束发言】。";
    }
    if (g_phase == 4) {
        return BOTC_NameStr(g_nomTo) + " 反驳（最多 60 秒），说完点右下角【结束发言】。";
    }
    if (g_phase == 5) {
        return "投票中：点【投票】或【弃权】，倒计时结束前都可以改（死者一人只有一张票，弃权不用掉）。";
    }
    return "投票已结束，不能再改票。说书人确认后点【结束本次提名】。";
}

// 倒计时显示的唯一出处：界面重建（BOTC_NomUI）和每半秒的刷新（BOTC_Tick_Func）都调这里，
// 这样重建界面时不会把倒计时图片打回默认的"10"。
//   阶段 3 / 4：把"（剩余 N 秒）"拼在提示行后面
//   阶段 5   ：按计时器真实剩余秒数画倒计时图片
void BOTC_CdRender () {
    int sec;
    fixed rem;
    // 炸弹人的 10 秒指向投票复用提名倒计时素材。
    if (g_boomVoteOn) {
        rem = TimerGetRemaining(g_tVote);
        sec = FixedToInt(rem);
        if (sec < 1) {
            sec = 1;
        }
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
        libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(sec), PlayerGroupAll());
        return;
    }
    if (g_phase == 3 || g_phase == 4) {
        rem = TimerGetRemaining(g_tSpeech);
        sec = FixedToInt(rem);
        if (sec < 0) {
            sec = 0;
        }
        libNtve_gf_SetDialogItemText(g_nomHint, BOTC_NameSubst(BOTC_NomHintStr() + "（剩余 " + IntToString(sec) + " 秒）"), PlayerGroupAll());
    }
    // 【教派投票】（用户 2026-10-10）：提示行写成活动倒计时（写法照抄上面提名"反驳"那一支）
    if (g_cultOn) {
        rem = TimerGetRemaining(g_tVote);
        sec = FixedToInt(rem);
        if (sec < 0) {
            sec = 0;
        }
        libNtve_gf_SetDialogItemText(g_nomHint, StringToText("倒计时：" + IntToString(sec) + " 秒"), PlayerGroupAll());
    }
    if (g_phase == 5 && !g_cultOn) {       // 【教派投票】不画那个倒计时图
        rem = TimerGetRemaining(g_tVote);
        sec = FixedToInt(rem);
        if (sec < 0) {
            sec = 0;
        }
        libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(sec), PlayerGroupAll());
    }
    // 【教派投票】倒计时走的是原生那一支（g_phase == 5 读 g_tVote）—— 见 BOTC_CultStart 里那句 20 秒
    //   ⚠ 原来这里单独读 g_tCult 的一段已经撤掉（改成原生之后两个计时器会打架，用户 2026-10-10）
}

void BOTC_NomTally () {
    int yes;
    int no;
    int none;
    int k;
    int t;
    int q;
    int alive;
    int need;
    int w;
    string s;
    yes = 0;
    no = 0;
    none = 0;
    // 只统计在场的座位：空位不算「未投」
    BOTC_BuildSeatList();
    for (t = 0; t < g_seatN; t += 1) {
        q = g_seatList[t];
        if (g_vote[q] == 1) {
            if (BOTC_ButlerVoteCounts(q)) {
                w = BOTC_BansheeVoteWeight(q);
                yes = yes + w;
                if (g_voteWasDead[q] && w < 2) {
                    g_deadVoteUsed[q] = true;      // 这一票是「死后投的」而且真的记进票数了 → 他的死人票就此用掉
                }
            }
            else {
                no = no + 1;       // 街头风琴手局：主人没投赞成，管家这一票按弃权统计
            }
        }
        if (g_vote[q] == 2) {
            no = no + 1;
        }
        if (g_vote[q] == 0) {
            none = none + 1;
        }
    }
    alive = BOTC_AliveCount();
    need = (alive + 1) / 2;
    if (need < 1) {
        need = 1;
    }
    // 投票统计日志：一条完整记录（屏幕字幕和说书人私聊日志都不再弹统计）
    s = BOTC_PeriodStr() + " · " + BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo) + "：赞成 " + IntToString(yes) + "（";
    k = 0;
    for (t = 0; t < g_seatN; t += 1) {
        q = g_seatList[t];
        if (g_vote[q] == 1 && BOTC_ButlerVoteCounts(q)) {
            if (k > 0) {
                s = s + ",";
            }
            s = s + IntToString(q - 1);
            if (BOTC_BansheeVoteWeight(q) > 1) {
                s = s + "（2票）";
            }
            k = k + 1;
        }
    }
    if (k == 0) {
        s = s + "无";
    }
    s = s + " 号）／弃权 " + IntToString(no) + "／未投 " + IntToString(none) + "｜需 " + IntToString(need) + " 票，";
    if (yes >= need) {
        if (g_todoNew) {
            s = s + "达标并标记为待处决";
        }
        else {
            s = s + "达标但未超过当前待处决票数";
        }
    }
    else {
        s = s + "未达门槛";
    }
    if (BOTC_OrganActive()) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
        }
        if (g_todoSeat >= 2) {
            g_tokOn[((((g_teller * 14) + g_todoSeat) * 256) + 165)] = true;
        }
        BOTC_PmStore(g_teller, "【街头风琴手·秘密票数】" + s);
        BOTC_GrimRender(g_teller);
        // 官网口径：不公开票数、门槛和投票人名单；完整记录只给说书人。
        s = BOTC_PeriodStr() + " · " + BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo) + "：投票已秘密统计（票数与投票人保密）";
        BOTC_VoteLogAdd(s);
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
    }
    BOTC_VoteLogAdd(s);
}

// 存活人数 = 在场的参与者 - 说书人标了「死亡」token 的座位
int BOTC_AliveCount () {
    int q;
    int n;
    playergroup ag;
    ag = PlayerGroupActive();
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (PlayerGroupHasPlayer(ag, g_who[q])) {      // 【座位机制】q 是格子 → 问"坐这格的人"在不在
            if (!BOTC_PublicDead(q)) {
                n = n + 1;
            }
        }
    }
    return n;
}

void BOTC_NomUI () {
    int i;
    int ob;
    int pb;
    int ps;
    bool organBlind;
    string s;
    organBlind = BOTC_OrganActive();
    BOTC_BsBtnRender();
    // 阶段锁：只有发牌 / 开始按钮按阶段和开局状态显隐；
    // 日志、魔典、角色能力表在提名阶段也能看（魔典始终能关）
    DialogControlSetVisible(g_grimClose, PlayerGroupAll(), true);
    DialogControlSetVisible(g_grimDeal, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimConfirm, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rsOpenBtn, PlayerGroupAll(), false);
    // 开局前提示：点了【游戏正式开始】（含 10 秒倒数）就收掉
    DialogSetVisible(g_preDlg, PlayerGroupAll(), false);
    if (!g_started && !g_startPending) {
        DialogSetVisible(g_preDlg, PlayerGroupAll(), true);
    }
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupAll(), false);
    if (g_phase == 0) {
        // 发牌 / 确认发放：只要点了【游戏正式开始】（g_startPending）就**立刻**收掉（用户 2026-09-17）
        if (!g_started && !g_startPending) {
            DialogControlSetVisible(g_grimDeal, PlayerGroupSingle(g_teller), true);
            DialogControlSetVisible(g_grimConfirm, PlayerGroupSingle(g_teller), true);
            DialogControlSetVisible(g_rsOpenBtn, PlayerGroupSingle(g_teller), true);
        }
        DialogControlSetVisible(g_grimStart, PlayerGroupSingle(g_teller), true);
    }
    // 处决 / 死亡标记按钮：说书人任何阶段都能按（刚投完票就要标记处决）
    DialogControlSetVisible(g_execBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(g_teller), true);
    for (ob = 1; ob <= 13; ob += 1) {
        DialogSetVisible(g_logBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_grimBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_abBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_noBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_tipBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_noteBtnDlg[ob], PlayerGroupSingle(ob), true);
    }
    // 发起提名：阶段 1，且今天还没发起过
    DialogControlSetVisible(g_nomStart, PlayerGroupAll(), false);
    // 【进入夜晚】【进入提名环节】【聊天：...】这三个：**正式开局（10 秒倒数走完）之前一律藏起来**（用户 2026-09-17）
    DialogSetVisible(g_nightBtnDlg, PlayerGroupSingle(g_teller), g_started);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    DialogSetVisible(g_chatBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    // 【邪恶小窗】：只有「正式开局之后的白天」给说书人看（入夜会自动关、按钮也收起来）
    DialogSetVisible(g_evilBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight && g_evilEnable));
    BOTC_EvilBtnRender();
    // 顶部那条「提名阶段 / 谁提名谁」只在提名阶段显示，自由阶段藏掉
    DialogControlSetVisible(g_nomHead, PlayerGroupAll(), (g_phase != 0));
    if (g_phase == 1 && g_nomStartOn) {
        // 【换过说书人也要给】（用户 2026-10-09）：原来写死"2..13"，而 1 号位换过之后可能是普通玩家 ----
        //   说书人不管坐在哪个物理座位都不发起提名（按 g_teller 判），g_nomUsed 是**格子**表（要 BOTC_PosOf）。
        for (pb = 1; pb <= 13; pb += 1) {
            ps = BOTC_PosOf(pb);
            if (pb != g_teller && ((!BOTC_SeatDead(ps) && !g_nomUsed[ps]) || BOTC_BansheeCanNominate(ps))) {
                DialogControlSetVisible(g_nomStart, PlayerGroupSingle(pb), true);
            }
        }
    }
    // 结束发言
    DialogControlSetVisible(g_nomEnd, PlayerGroupAll(), false);
    if (g_phase == 3) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupSingle(g_who[g_nomFrom]), true);
    }
    if (g_phase == 4) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupSingle(g_who[g_nomTo]), true);
    }
    if (g_phase >= 3 && g_phase <= 5) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupSingle(g_teller), true);
    }
    // 强制下一阶段（说书人）
    DialogControlSetVisible(g_nomForce, PlayerGroupAll(), false);
    if (g_phase >= 2) {
        DialogControlSetVisible(g_nomForce, PlayerGroupSingle(g_teller), true);
    }
    if (g_phase == 6) {
        libNtve_gf_SetDialogItemText(g_nomForce, StringToText("结束本次提名"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_nomForce, StringToText("强制下一阶段"), PlayerGroupSingle(g_teller));
    }
    // 【教派投票】（用户 2026-10-10）：这一轮不该出现【结束发言 / 强制下一阶段】，收掉
    if (g_cultOn) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupAll(), false);
        DialogControlSetVisible(g_nomForce, PlayerGroupAll(), false);
    }
    // 投票 / 弃权
    DialogControlSetVisible(g_voteYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteNo, PlayerGroupAll(), false);
    if (g_phase >= 3 && g_phase <= 5) {       // 用户 2026-09-19：选目标（阶段 2）时先不显示投票
        DialogControlSetVisible(g_voteYes, PlayerGroupAll(), true);
        DialogControlSetVisible(g_voteNo, PlayerGroupAll(), true);
        // 说书人不投票
        DialogControlSetVisible(g_voteYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_voteNo, PlayerGroupSingle(g_teller), false);
        // 【教派投票】（用户 2026-10-10）：这两颗按钮走的就是这一支 —— 对**除说书人以外**的所有玩家显示
        //   （教派投票也在 phase 5，所以其他玩家同样看得到）
    }
    // 文案与投票标记
    libNtve_gf_SetDialogItemText(g_nomHead, BOTC_NameSubst(BOTC_NomHeadStr()), PlayerGroupAll());   // 提名标题：名字换成真名
    // 【教派投票】（用户 2026-10-10）：标题走自己那个标签（左移 80），提名标题与【进入提名环节】按钮这一轮都收起来
    if (g_cultOn) {
        libNtve_gf_SetDialogItemText(g_cultHead, BOTC_PlayerNameText(g_cultWho) + StringToText(" 邀请所有人加入他的教派"), PlayerGroupAll());
        DialogControlSetVisible(g_cultHead, PlayerGroupAll(), true);
        DialogControlSetVisible(g_nomHead, PlayerGroupAll(), false);
        DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), false);
    }
    else {
        DialogControlSetVisible(g_cultHead, PlayerGroupAll(), false);
    }
    libNtve_gf_SetDialogItemText(g_nomHint, BOTC_NameSubst(BOTC_NomHintStr()), PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        ob = i + 2;
        if (g_vote[ob] == 1) {
            s = "botc_voted.dds";
        }
        else {
            if (g_vote[ob] == 2) {
                s = "botc_abstain.dds";
            }
            else {
                s = "botc_blank.dds";
            }
        }
        if (organBlind) {
            s = "botc_blank.dds";          // 街头风琴手：投票标记也隐藏
        }
        libNtve_gf_SetDialogItemImage(g_voteTag[ob], s, PlayerGroupAll());
        DialogControlSetVisible(g_voteTag[ob], PlayerGroupAll(), !organBlind);
        // 图片是裁剪显示的，所以控件尺寸必须和图片一致（110x34），只调整位置
        DialogControlSetSize(g_voteTag[ob], PlayerGroupAll(), 99, 31);
        DialogControlSetPosition(g_voteTag[ob], PlayerGroupAll(), c_anchorTopLeft, g_seatX[ob - 2] - 50, g_seatY[ob - 2] - 54);
        // 票数与待处决标记（所有人可见）
        if (g_boomResult) {
            libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(IntToString(g_boomCount[ob]) + "票"), PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
        }
        else {
            if (g_nomVotes[ob] > 0 && !organBlind) {
                libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(IntToString(g_nomVotes[ob]) + "票"), PlayerGroupAll());
                if (g_nomPass[ob]) {
                    libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_todo.dds", PlayerGroupAll());
                }
                else {
                    libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
                }
            }
            else {
                libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(""), PlayerGroupAll());
                libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
            }
        }
        DialogControlSetSize(g_todoTag[ob], PlayerGroupAll(), 108, 31);
        DialogControlSetPosition(g_todoTag[ob], PlayerGroupAll(), c_anchorTopLeft, g_seatX[ob - 2] - 54, g_seatY[ob - 2] + 79);
        // ★ 提名阶段也显示 ＋（用户 2026-09-17：提名时也能在魔典上打 token）
        if (g_seatOn[ob]) {
            DialogControlSetVisible(g_grimTokBtn[ob], PlayerGroupAll(), true);
        }
        else {
            DialogControlSetVisible(g_grimTokBtn[ob], PlayerGroupAll(), false);
        }
    }
    // 倒计时面板：这里只管显不显示，图片内容统一交给 BOTC_CdRender 按真实剩余秒数画
    if ((g_phase == 5 && !g_cultOn) || g_boomVoteOn) {       // 炸弹人复用提名投票倒计时
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    }
    else {
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    }
    // 必须放在最后：秒数要写在上面那句 BOTC_NomHintStr() 赋值之后，否则会被覆盖
    if (g_phase >= 3 && g_phase <= 5) {
        BOTC_CdRender();
    }
    // 【快进到提名】按钮：提名阶段 / 夜晚 / 没开局一律收起（每次切阶段都刷一次）
    BOTC_SkipRender();
    BOTC_GrimShareRender();       // 玩家魔典右下角：一键发送魔典
}

// 【把所有人开着的「声称」收掉】（用户 2026-10-12）：进提名环节那一刻调 ----
//   ① 声称面板还开着的（g_pickMode == 3）→ 关掉；
//   ② 已经点了【声称】、正在点头像选目标的（猎手 / 炼金术士 / 精神病患者 / 月之子）→ 标记一起复位；
//   被取消的人各提示一句（不然他以为自己还点着）。
void BOTC_DeclareCancelAll () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (g_pickMode[p] == 3) {
            g_pickMode[p] = 0;
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：声称自动取消。");
            }
        }
        if (g_declarePick[p]) {
            g_declarePick[p] = false;
            g_psyDeclare[p] = false;
            g_moonDeclare[p] = false;
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：你这次声称自动取消了。");
            }
        }
        if (g_alcChoice[p] || g_alcPick[p]) {
            g_alcChoice[p] = false;
            g_alcPick[p] = false;
            g_alcRolePick[p] = 0;
            DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：你这次炼金术士声称自动取消了。");
            }
        }
    }
    BOTC_DeclareRender();
}

void BOTC_PhaseSet (int ph) {
    g_phase = ph;
    // 【进提名环节 → 把大家开着的声称收掉】（用户 2026-10-12）
    if (ph >= 1) {
        BOTC_DeclareCancelAll();
    }
    BOTC_NomUI();
    // 选人提示（用户 2026-09-19）：用白天/夜晚大字那块地方，选人期间一直挂着
    if (ph == 2) {
        BOTC_BigHintShowMid(1, "选择一个玩家。");
    }
    else {
        // 【一次提名结束后提示要回来】（用户 2026-09-22）----
        //   只有「刚开环节」（g_nomJustOpen，4 个大字还在演）时不挂；
        //   其余任何回到自由提名（phase 1）的时候都把「点【发起提名】选人」重新挂上。
        if (ph == 1 && !g_nomJustOpen) {
            BOTC_BigHintShowMid(1, "点【发起提名】选人");
        }
        else {
            BOTC_BigHintHide(g_teller);
        }
    }
}

// 【公开还活着的人数】（用户 2026-10-03）：按打红叉的人数倒推（不含说书人）---- 僵怖假死时也算「公开已死」，
//   这样提名 BGM 的小局判定不会因为僵怖露馅（原来用 BOTC_AliveCountTrue 会把他算成活人）。
int BOTC_AliveCountPublic () {
    int i;
    int total;
    int dead;
    total = 0;
    dead = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        total = total + 1;
        if (BOTC_PublicDead(i)) {
            dead = dead + 1;
        }
    }
    return total - dead;
}
void BOTC_NomOpen () {
    int ob;
    // 开环节前按在场人数把圆桌摆成圈（没人的座位不会占位）
    BOTC_GrimRelayout();
    // 【快进到提名】进入提名阶段：上面的票数清空（按钮本身也会被 BOTC_SkipRender 收起来）
    BOTC_SkipReset();
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    g_boomResult = false;
    for (ob = 2; ob <= 13; ob += 1) {
        g_vote[ob] = 0;
        g_boomCount[ob] = 0;
    }
    libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("结束提名环节"), PlayerGroupSingle(g_teller));
    g_nomJustOpen = true;              // 刚开环节：提示等「提名开始」那 4 个字收掉再挂（见 NomBigTimer）
    g_nomStartOn = false;              // 【发起提名】先锁上：等「提名开始」4 个大字收掉、提示挂上那一刻再开（见 BOTC_NomBigTimer_Func）
    BOTC_PhaseSet(1);
    g_nomJustOpen = false;
    BOTC_ChatModeSet(2);
    BOTC_PullAllToPublic();
    // 【提名提示改到动画之后出现】（用户 2026-09-22）：以前在这里就挂上「点【发起提名】选人」，
    //   会跟屏幕正中那 4 个「提名开始」大字撞在一起 ---- 现在改到那 4 个字收掉时再挂。
    //   （挂的位置 / 时机看 BOTC_NomBigTimer_Func 里那条 g_nomBigHold >= 2 的分支。）
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 魔典不马上弹：延迟 4 秒再弹（中间留给"现在是提名阶段"的大提示；
    //   这 4 秒里要是提名已经结束/入夜了，BOTC_NomPop_Func 就不会弹）
    TimerStart(g_tNomPop, 4.0, false, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("提名环节开始"));
    // 屏幕正中演「提名开始」4 个大字（一个一个浮现 → 3.75 秒一起收掉），同时放 timingkaishi
    BOTC_NomBigShow();
    // 提名阶段换一首音乐（白天才会换；夜里由 NightToggle 统一放夜晚那首）
    if (g_started && !g_isNight) {
        if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
            // 小局（**存活 ≤ 4 人**）：提名阶段用 timing2
            BOTC_MusicPlay(g_musicNomSmallName, 2, 4.0);
        }
        else {
            BOTC_MusicPlay(g_musicNomName, 2, 4.0);   // 优先级 2；也留 4 秒，等提示播完再进音乐
        }
    }
    // 【自由提名时间】（默认 30 秒，按开局「本局设置」投票）只有智能说书模式才倒数：有人提名（阶段 2..6）时暂停，
    //   这轮提名结束回到阶段 1 再接着倒数；倒数到 0 由 BOTC_NomFreeFunc 收掉环节。
    //   真人说书：不倒数，想开多久开多久（自己点【结束提名环节】收）。
    g_nomFreeOn = false;
}

// 提名开始 4 秒后：把魔典弹给全场（已经开着日志 / 能力表的人不弹，别盖住他们的面板）
bool BOTC_NomPop_Func (bool testConds, bool runActions) {
    int ob;
    if (!runActions) {
        return true;
    }
    if (g_phase == 0) {
        return true;                   // 提名已经结束了（甚至已经入夜）：不弹
    }
    // 兜底：万一提名 BGM 没放起来（比如那首已经在放、被 BOTC_MusicPlay 提前 return 了），
    //   这 4 秒的魔典弹出计时器到了也把【发起提名】开出来，免得玩家被锁死。
    if (g_phase == 1 && !g_nomStartOn) {
        g_nomStartOn = true;
        BOTC_NomUI();
    }
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    for (ob = 1; ob <= 13; ob += 1) {
        if (g_logOpen[ob] || g_abOpen[ob] || g_tipOpen[ob] || g_noOpen[ob]) {
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(ob), false);
        }
    }
    return true;
}

void BOTC_NomCloseEx (bool toNight) {
    g_nomFreeOn = false;           // 环节收掉了：自由提名时间的倒数也停
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    BOTC_NomBigHide();             // 提名提前结束的话，那 4 个字也一起收掉
    libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("进入提名环节"), PlayerGroupSingle(g_teller));
    BOTC_PhaseSet(0);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("提名环节结束"));
    // 提名结束：回到公聊那首（如果紧接着就入夜，NightToggle 会再换成夜晚那首）
    if (g_started && !g_isNight) {
        BOTC_MusicDropPrio(1);               // 先放弃提名那一层的优先级
        BOTC_MusicPlay(BOTC_DayTrackName(), 1, 2.5);   // 小局会自动换成 gongliao2
    }
    // 【什么情况下自动入夜】（用户 2026-09-20 起，2026-09-26 再改）：
    //   现在只剩「智能说书自己的自动流程」（自由提名时间到点那条 BOTC_NomFreeFunc）还用「收环节 + 自动入夜」；
    //   真人说书点【结束提名环节】走的是 BOTC_NomCloseEx(false) ---- 只收环节，留在白天，入夜自己点【进入夜晚】。
    if (toNight) {
        if (g_started && !g_isNight) {
            BOTC_NightToggle();
        }
    }
}

// 收掉提名环节 + 自动入夜（只给智能说书的自动流程用；真人说书请调 BOTC_NomCloseEx(false)）
void BOTC_NomClose () {
    BOTC_NomCloseEx(true);
}

// 【提名环节】自由提名时间的倒数（每秒一拍）
//   阶段 1（没人正在提名）= 倒数；阶段 2..6（有提名在进行）= 暂停
//   倒数到 0：智能说书模式下有人过票就先按票数处决，然后收掉环节（收环节会自动入夜）
bool BOTC_NomFreeFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_nomFreeOn) {
        return true;                   // 没在倒数（环节没开 / 已经收掉）
    }
    if (g_gameOver || g_isNight) {
        g_nomFreeOn = false;           // 已经分出胜负或已经入夜：停
        return true;
    }
    if (g_phase != 1) {
        return true;                   // 有提名正在进行：**暂停计时**（提名结束后回到阶段 1 继续）
    }
    g_nomFreeSec = g_nomFreeSec - 1;
    if (g_nomFreeSec <= 0) {
        g_nomFreeOn = false;
        BOTC_Ann("【提名】自由提名时间结束：本轮提名环节关闭");
        BOTC_NomClose();
        return true;
    }
    BOTC_NomUI();                      // 刷新提示行里的剩余秒数
    return true;
}

// 【音轨恢复】过场（猎手射杀 / 胜利结算）之后，按当前状态把该放的那首接回来
void BOTC_MusicResume () {
    BOTC_MusicStop();                      // 先把「静音轨」那层停掉（不然它优先级高、盖着不让新曲子进来）
    if (!g_started) {
        BOTC_MusicStart();                 // 还没正式开始：准备阶段那首
        return;
    }
    if (g_isNight) {
        BOTC_MusicPlay(g_musicNightName, 3, 2.5);
        return;
    }
    if (g_phase != 0) {
        // 提名环节还在：接回提名那首
        if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
            BOTC_MusicPlay(g_musicNomSmallName, 2, 2.5);
        }
        else {
            BOTC_MusicPlay(g_musicNomName, 2, 2.5);
        }
        return;
    }
    BOTC_MusicPlay(BOTC_DayTrackName(), 1, 2.5);   // 白天：按时段那首
}

// 【猎手射中恶魔】的过场计时器：
//   一拍（2 秒后）= 放充能音 Raynor_PenetratorRoundChargeUp，并把下一拍设成 2.5 秒
//   二拍（再 2.5 秒后）= 放枪声 RaynorSnipeSound → 结算死亡（死亡（白天/其他）token + 红叉）
//                        → 然后马上恢复音轨
bool BOTC_SnipeFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_snipeStage == 1) {
        BOTC_PlaySfx(g_sfxChargeName);
        g_snipeStage = 2;
        TimerStart(g_tSnipe, 2.5, false, c_timeGame);
        return true;
    }
    if (g_snipeStage == 2) {
        g_snipeStage = 0;
        BOTC_PlaySfx(g_sfxSnipeName);
        // 枪声这一刻才播「命中了恶魔」，紧跟着才是死亡播报（顺序：命中 → 死亡）
        if (g_snipeHunter >= 2 && g_snipeHunter <= 13) {
            BOTC_PubAnnounce(BOTC_NameStr(g_snipeHunter) + " 的猎杀命中了恶魔！");
        }
        if (g_snipeTarget >= 2 && g_snipeTarget <= 13) {
            // 白天死亡（其他）：红叉 + 公开播报 + 恶魔死亡后的传位 / 红唇女郎 / 胜负判定都走它
            BOTC_DeathToggle(g_snipeTarget, 2, 0);
        }
        g_snipeTarget = 0;
        // 【枪声命中后 2 秒再恢复音轨】
        g_snipeStage = 3;
        TimerStart(g_tSnipe, 2.0, false, c_timeGame);
        return true;
    }
    if (g_snipeStage == 3) {
        g_snipeStage = 0;
        g_snipeHunter = 0;
        BOTC_MusicResume();            // 恶魔死了 2 秒之后，把音轨接回来
    }
    return true;
}

void BOTC_NomWant (int p) {
    int i;
    if (g_phase != 1) {
        return;
    }
    // 【死人不能提名】（用户 2026-09-22）：普通死者不能发起提名；已获得能力的报丧女妖例外。
    if (BOTC_SeatDead(p) && !BOTC_BansheeDeadPower(p)) {
        BOTC_Notice(g_who[p], "你已经死了：普通死者不能发起提名。只有已获得能力且当前能力生效的报丧女妖可以提名。");
        return;
    }
    if (g_nomUsed[p] && !BOTC_BansheeCanNominate(p)) {
        if (BOTC_BansheeDeadPower(p)) {
            BOTC_Notice(g_who[p], "你的两次提名都已经用完了。");
        }
        else {
            BOTC_Notice(g_who[p], "你今天已经发起过提名了。");
        }
        return;
    }
    if (BOTC_ProtectTokOn(p, 101)) {
        BOTC_Notice(g_who[p], "魔像这一局只能发起一次提名（已经用过了）。");
        return;
    }
    // 新一轮提名：清掉上一轮的投票
    g_boomResult = false;
    for (i = 2; i <= 13; i += 1) {
        g_vote[i] = 0;
        g_boomCount[i] = 0;
    }
    g_nomPickBy = p;
    BOTC_PhaseSet(2);
    BOTC_Notice(g_who[p], "点你要提名的玩家座位。");
}

void BOTC_NomPick (int p, int q) {
    int i;
    if (g_phase != 2) {
        return;
    }
    if (p != g_nomPickBy) {
        return;
    }
    if (q < 2 || q > 13) {
        if (q != 1) {
            return;
        }
    }
    if (g_nomTargeted[q]) {
        BOTC_Notice(g_who[p], BOTC_NameStr(q) + " 今天已经被提名过了，换一个。");
        return;
    }
    g_nomFrom = p;
    BOTC_WitchNomCheck(p);      // 【女巫（65）】（用户 2026-09-21）：被诅咒的人发起提名 → 当场死亡
    g_nomTo = q;
    g_vizierSeat = q;
    g_vizierGood = 0;
    for (i = 1; i <= 13; i += 1) {
        g_vizierClaimed[i] = false;
    }
    g_nomFromOf[q] = p;         // 【恐惧之灵(102)】（用户 2026-10-04）：处决时要查「是不是恐惧之灵本人提的名」
    g_nomPickBy = 0;
    if (g_nomUsed[p]) {
        g_bansheeSecondNom[p] = true;
    }
    g_nomUsed[p] = true;
    g_nomTargeted[q] = true;
    // 【梦殒春宵】城镇公告员（52）：爪牙发起提名 → 在他身上打「爪牙已提名」（用户 2026-09-21）
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(p)) == 2 || BOTC_SeatTrueRole(p) == 94) {
        BOTC_TokMarkRole(52, 88, BOTC_NameStr(p) + " 是爪牙，今天提名过");
    }
    BOTC_PubLine("【提名】" + BOTC_NameStr(p) + " 提名 " + BOTC_NameStr(q));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(p) + StringToText(" 提名 ") + BOTC_PlayerNameText(q));
    if (BOTC_HasAbility(p, 81)) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 101] = true;
        BOTC_GrimRender(g_teller);
        BOTC_GolemAsk(p, q);
    }

    // 贞洁者：被提名的是贞洁者时，可能立刻处决提名者并直接进夜晚（处理完就不再走发言流程）
    if (BOTC_VirginCheck(g_nomFrom, g_nomTo)) {
        return;
    }
    // 先启动计时器再切阶段：切阶段会立刻刷新倒计时，必须先有新计时器的值
    TimerStart(g_tSpeech, 60.0, false, c_timeGame);
    BOTC_PhaseSet(3);
}

void BOTC_SpeechAdvance () {
    if (g_phase == 5) {
        // 说书人可以在 10 秒走完前直接结束投票，结算方式与倒计时到点完全一致
        BOTC_VoteDone();
        return;
    }
    if (g_phase == 3) {
        // 自己提名自己：只需要发言一次，直接进入投票倒计时
        if (g_nomFrom == g_nomTo) {
            TimerStart(g_tVote, 10.0, false, c_timeGame);       // 提名阶段的投票倒计时：10 秒（用户 2026-09-19 明确要保持 10）
            if (BOTC_OrganActive()) { BOTC_PubAnnounce("【街头风琴手】请所有玩家闭眼投票，票数秘密统计。"); }
            BOTC_PhaseSet(5);
            return;
        }
    TimerStart(g_tSpeech, 60.0, false, c_timeGame);
        BOTC_PhaseSet(4);
        return;
    }
    if (g_phase == 4) {
        TimerStart(g_tVote, 10.0, false, c_timeGame);       // 提名阶段的投票倒计时：10 秒（用户 2026-09-19 明确要保持 10）
        if (BOTC_OrganActive()) { BOTC_PubAnnounce("【街头风琴手】请所有玩家闭眼投票，票数秘密统计。"); }
        BOTC_PhaseSet(5);
        return;
    }
    if (g_phase == 2) {
        g_nomPickBy = 0;
        BOTC_PhaseSet(1);
        return;
    }
    if (g_phase == 6) {
        // 本轮提名结束（处决与否由说书人之后单独操作）
        g_nomFrom = 0;
        g_nomTo = 0;
        g_nomPickBy = 0;
        BOTC_PhaseSet(1);
        return;
    }
}

void BOTC_VoteSet (int p, int v) {
    bool bansheeVote;
    // 【投票为什么没算】（用户 2026-10-03）：不在投票时段点投票原来一句话都不说 -> 玩家完全不知道为什么无效
    if (g_phase < 2 || g_phase > 5) {
        BOTC_Notice(g_who[p], "现在不是投票时间：等说书人喊投票、倒计时出来的时候再点。");
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    // 【异教领袖的教派投票】（用户 2026-10-10）：这一轮**死人也能投，而且不消耗死人票** ——
    //   死人票「一局一次」那套限制、以及管家规则，在教派投票里全部不适用，点【投票】/【弃权】直接记下就行。
    if (g_cultOn) {
        g_vote[p] = v;
        g_voteWasDead[p] = false;
        BOTC_NomUI();
        return;
    }
    bansheeVote = BOTC_BansheeDeadPower(p);
    if (bansheeVote && v == 1) {
        BOTC_Notice(g_who[p], "报丧女妖能力：这一票计 2 票，并且不消耗死人票。");
    }
    // 【死人票】官方规则：死掉的人这一局**只能再投一次**。
    //   「用掉」= 这一票真的被**记进票数**（统计那一步，BOTC_NomTally）---- 在那之前改成弃权可以收回来。
    if (BOTC_SeatDead(p) && !bansheeVote) {
        if (v == 1) {
            if (g_deadVoteUsed[p]) {
                BOTC_Notice(g_who[p], "你已经用掉你那张死人票了：死者一局只能投一次（弃权不受限制）。");
                return;
            }
            BOTC_Notice(g_who[p], "这是你那张死人票：它被记进票数之后就用掉了（在那之前改弃权还能拿回来）。");
        }
        else {
            if (g_vote[p] == 1) {
                BOTC_Notice(g_who[p], "你改成弃权：那张死人票还没记进票数，这一局还能再投一次。");
            }
        }
    }
    // 管家规则：只有他昨晚选的主人先投了「有罪票」，他才能投有罪票；
    //   主人没投（或者弃权）时，管家这一票只能算弃权。管家自己中毒 / 酒鬼时不受这条限制。
    //   【管家已经死了就不管这条】（用户 2026-10-13）：死了的人是「死人票」，不该再被生前的主人卡住。
    if (v == 1 && !BOTC_OrganActive() && p == g_butlerSeat && g_butlerSeat >= 2 && !BOTC_SeatDead(p)) {
        if (!BOTC_SeatImpaired(p)) {
            if (g_butlerMaster >= 2) {
                if (g_vote[g_butlerMaster] != 1) {
                    g_vote[p] = 2;
                    BOTC_Notice(g_who[p], "管家规则：你的主人（" + BOTC_NameStr(g_butlerMaster) + "）还没投有罪票，你这一票只能算弃权。");
                    BOTC_NomUI();
                    return;
                }
            }
        }
    }
    // 【狂热者（110）】（用户 2026-10-10）：存活 ≥ 5 人时他必须在所有提名中投票 → 不给弃权
    if (v == 2 && BOTC_ZealotMustVote(p)) {
        BOTC_Notice(g_who[p], "狂热者规则：存活 ≥ 5，必须投票。");
        return;
    }
    g_vote[p] = v;
    // 【主人撤票 → 管家那一票跟着作废】（用户 2026-10-13）：管家是「主人先投有罪票，他才能投」，
    //   主人后来改成弃权时，管家已经举着的那一票要一起收掉（不然他会一直举着一张无效票）。
    if (v != 1 && !BOTC_OrganActive() && p == g_butlerMaster && g_butlerSeat >= 2) {
        if (g_vote[g_butlerSeat] == 1 && !BOTC_SeatImpaired(g_butlerSeat) && !BOTC_SeatDead(g_butlerSeat)) {
            g_vote[g_butlerSeat] = 2;      // 【不提示】（用户 2026-10-13）：直接把那一票收成弃权
        }
    }
    // 【记下这一票投出时他死没死】（用户 2026-10-02）：统计那一步只吃「投的时候就已经死了」的死人票；
    //   否则白天被猎手打死的玩家，会因为他活着时投过的票在统计时被判成「死人票已用掉」。
    if (v == 1) {
        g_voteWasDead[p] = BOTC_SeatDead(p);
    }
    else {
        g_voteWasDead[p] = false;
    }
    // 【梦殒春宵】卖花女孩（51）：恶魔投过票 → 在她身上打「恶魔已投票」（用户 2026-09-21）
    if (v == 1 && BOTC_RoleTeam(BOTC_SeatTrueRole(p)) == 3) {
        BOTC_TokMarkRole(51, 87, BOTC_NameStr(p) + " 是恶魔，今天投过票");
    }
    BOTC_NomUI();
}

void BOTC_VoteDone () {
    int i;
    int yes;
    int alive;
    int need;
    int nom;
    int good;
    yes = 0;
    good = 0;
    nom = g_nomTo;
    for (i = 2; i <= 13; i += 1) {
        if (g_vote[i] == 1) {
            if (BOTC_ButlerVoteCounts(i)) {
                yes = yes + BOTC_BansheeVoteWeight(i);
                if (BOTC_SeatRegAlign(i) == 0) {
                    good = good + 1;
                }
            }
        }
    }
    alive = BOTC_AliveCount();
    need = (alive + 1) / 2;
    if (need < 1) {
        need = 1;
    }
    if (g_nomTo > 0) {
        g_nomVotes[g_nomTo] = yes;
        // 唯一最高票：只有票数比当前最高的更高，才把待处决标记换过去
        if (yes >= need && yes > g_todoVotes) {
            g_todoSeat = g_nomTo;
            g_todoVotes = yes;
            g_todoNew = true;
        }
        else {
            g_todoNew = false;
        }
        for (i = 2; i <= 13; i += 1) {
            g_nomPass[i] = false;
            if (!BOTC_OrganActive() && i == g_todoSeat) {
                g_nomPass[i] = true;
            }
        }
    }
    BOTC_NomTally();
    if (BOTC_OrganActive()) {
        BOTC_PubAnnounce("【街头风琴手】投票结束，请所有玩家睁开眼睛。");
    }
    // 本轮结束：直接回到"可以继续发起提名"的状态，不需要说书人再点确认
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    BOTC_PhaseSet(1);
    BOTC_VizierAfterVote(nom, good);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("投票结束"));
}

void BOTC_NomReset () {
    int i;
    for (i = 1; i <= 13; i += 1) {        // 【含说书人】（用户 2026-10-03）：他每天也能被提名一次（原来从 2 开始，导致他头一次被提名后就再也不能被提名）
        g_nomUsed[i] = false;
        g_bansheeSecondNom[i] = false;
        g_nomTargeted[i] = false;
        g_nomFromOf[i] = 0;
        g_vote[i] = 0;
        g_voteWasDead[i] = false;
        g_nomVotes[i] = 0;
        g_nomPass[i] = false;
        g_vizierClaimed[i] = false;
        g_boomCount[i] = 0;
    }
    g_boomResult = false;
    g_vizierSeat = 0;
    g_vizierGood = 0;
    g_todoSeat = 0;
    g_todoVotes = 0;
    g_todoNew = false;
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    if (g_phase != 0) {
        libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("进入提名环节"), PlayerGroupSingle(g_teller));
        BOTC_PhaseSet(0);
    }
    else {
        BOTC_NomUI();
    }
}

bool BOTC_SpeechTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    BOTC_SpeechAdvance();
    return true;
}

bool BOTC_VoteTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_boomVoteOn) {
        BOTC_BoomVoteEnd();
        return true;
    }
    // 说书人提前结束过投票时，这个计时器仍在后台跑；到点时若已经不是投票阶段就忽略，
    // 免得把之后发起的新一轮提名打断
    if (g_phase != 5) {
        return true;
    }
    // 【教派投票】（用户 2026-10-10）：到点了不走"提名统计"，走教派的判定
    if (g_cultOn) {
        BOTC_CultEnd(true);
        return true;
    }
    BOTC_VoteDone();
    return true;
}

// 【-laugh】（用户 2026-09-22）：所有玩家可用；公聊大字体 + laugh 音效；全桌公用 30 秒冷却，冷却中完全静默
void BOTC_Laugh (int p) {
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_laughCd > 0) {
        return;
    }
    g_laughCd = 60;
    s = BOTC_NameTag(BOTC_PosOf(p)) + "爽朗的大笑！";
    g_chatWhoNow = BOTC_PosOf(p);
    BOTC_PubLine(s);
    g_chatWhoNow = 0;
    BOTC_PlaySfx("laugh");
}

// 【-laugh 冷却 + 复活动画】（用户 2026-09-22）：挂在 0.5 秒的 tick 上
void BOTC_LaughTick () {
    int q;
    if (g_laughCd > 0) {
        g_laughCd = g_laughCd - 1;
    }
    for (q = 2; q <= 13; q += 1) {
        if (g_revFxCt[q] <= 0) {
            continue;
        }
        g_revFxCt[q] = g_revFxCt[q] - 1;              // 红叉计数（12 拍 = 6 秒）
        if (g_revFxSnd[q] > 0) {
            g_revFxSnd[q] = g_revFxSnd[q] - 1;
            if (g_revFxSnd[q] <= 0) {
                g_revFxSnd[q] = 0;
                BOTC_PlaySfx("fuhuo");          // 音效第 4 秒播（用户 2026-09-22）
            }
        }
        if (g_revFxCt[q] <= 0) {
            g_revFxCt[q] = 0;
            g_deadShown[q] = false;             // 红叉第 6 秒才撤（用户 2026-09-22）
            BOTC_GrimRender(g_teller);
        }
    }
}

// 【玩家离开游戏】（用户 2026-10-02）：每半秒查一次 PlayerStatus，谁第一次变成「已离开」就在**公聊**播一句
//   「玩家N 离开了小镇」（2 = c_playerStatusLeft，直接写数字免得依赖常量名）；
//   「离开了小镇」四个字的红字由 BOTC_KeyColor 那张关键词表负责。
void BOTC_LeftCheck () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_leftShown[q]) {
            continue;
        }
        if (!g_seatOn[q]) {
            continue;
        }
        if (PlayerStatus(g_who[q]) != 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"在不在
            continue;
        }
        g_leftShown[q] = true;
        BOTC_PubAnnounce(BOTC_NameStr(q) + " 离开了小镇");
    }
    // 【说书人走了？】（用户 2026-10-07 口径）：**局内不检测** —— 只在"刚进游戏"那一次（BOTC_InitMode）决定谁当说书人。
}

//==================================================================================================
// 【投票踢人】（用户 2026-10-02）
//   发 -kick → 弹魔典点座位 → 发起投票；公聊播报 + 屏幕中间无背景对话框（是 / 否 + 底部票数）；
//   赞成票到「在场人数的 2/3（向上取整）」就 KickFromGame；60 秒没投完作废。被踢的人不能投自己。
//==================================================================================================
void BOTC_BuildKick () {
    DialogCreate(700, 240, c_anchorCenter, 0, 0, false);
    g_kickDlg = DialogLastCreated();
    DialogSetImageVisible(g_kickDlg, false);              // 隐藏背景（用户要求）
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), false);
    g_kickTitle = BOTC_NewLabel(g_kickDlg, 700, 34, 150, 20, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_kickTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_kickTitle, false, PlayerGroupAll());
    g_kickYes = BOTC_NewButton(g_kickDlg, 160, 40, 60, 140, "是");
    g_kickNo = BOTC_NewButton(g_kickDlg, 160, 40, 480, 140, "否");
    g_kickCnt = BOTC_NewLabel(g_kickDlg, 700, 26, 250, 195, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_kickCnt, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_kickCnt, false, PlayerGroupAll());
}

// 场上人数（在座、还没走的）
int BOTC_KickPresentN () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2) {
            continue;
        }
        if (PlayerStatus(g_who[q]) == 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"
            continue;
        }
        n = n + 1;
    }
    return n;
}


// 门槛（用户 2026-10-02 改成 2/3）：在场人数的 2/3，**向上取整**（票必须是整数）
//   例：6 人 = 4 票、5 人 = 4 票、10 人 = 7 票、12 人 = 8 票
int BOTC_KickNeed () {
    int n;
    n = BOTC_KickPresentN();
    return ((n * 2) + 2) / 3;
}

// 这一轮「能投票的人」有几个（用户 2026-10-02）：场上的人（被踢的那个除外）；
//   说书人在「不是他发起、也不是被踢的那个」时不能投，所以只有他发起时才 +1。
int BOTC_KickVoterN () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2) {
            continue;
        }
        if (q == g_kickTar) {
            continue;
        }
        if (PlayerStatus(g_who[q]) == 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"
            continue;
        }
        n = n + 1;
    }
    if (g_kickBy == g_teller && g_kickTar != 1) {
        n = n + 1;                 // 说书人发起的：他自己也投
    }
    if (n < 1) {
        n = 1;
    }
    return n;
}

int BOTC_KickCountYes () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_kickVote[i] == 1) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_KickCountVoted () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_kickVote[i] != 0) {
            n = n + 1;
        }
    }
    return n;
}

// 标题 + 票数那行（每投一票 / 每秒刷一次）
void BOTC_KickRender () {
    int yes;
    int no;
    if (g_kickTar < 1) {
        return;
    }
    yes = BOTC_KickCountYes();
    no = BOTC_KickCountVoted() - yes;
    libNtve_gf_SetDialogItemText(g_kickTitle, BOTC_NameSubstText(StringToText("是否踢出 " + BOTC_NameStr(g_kickTar))), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_kickCnt, StringToText("目前票数：是 " + IntToString(yes) + " / 否 " + IntToString(no) + "（需要 " + IntToString(BOTC_KickNeed()) + " 票 · 剩 " + IntToString(g_kickSec) + " 秒）"), PlayerGroupAll());
}


// 进入 / 退出「-kick 选人」模式（用户 2026-10-02 回到点击座位这版）
void BOTC_KickPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_kickMode == p) {
        g_kickMode = 0;
        BOTC_Notice(p, "已取消踢人投票。");
        return;
    }
    if (g_kickTar >= 1) {
        BOTC_Notice(p, "已经有一个踢出投票在进行中了。");
        return;
    }
    if (g_kickMode >= 1) {
        BOTC_Notice(p, "现在有别人正在选踢人对象，等他用完。");
        return;
    }
    g_kickMode = p;
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "点一个座位：对他发起踢出投票（点「说书人」那一格 = 对说书人发起；再发一次 -kick 取消）。");
}

// 发起投票
void BOTC_KickStart (int by, int q) {
    int i;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_kickTar >= 1) {
        BOTC_Notice(by, "已经有一个踢出投票在进行中了。");
        return;
    }
    if (PlayerStatus(g_who[q]) == 2) {    // q 是格子 → 查"那格现在坐的人"在不在
        BOTC_Notice(by, "那个人已经离开游戏了。");
        return;
    }
    g_kickTar = q;
    g_kickBy = by;
    for (i = 0; i <= 13; i += 1) {
        g_kickVote[i] = 0;
    }
    g_kickSec = 60;
    g_kickHalf = 0;
    BOTC_PubAnnounce(BOTC_NameStr(BOTC_PosOf(by)) + " 对 " + BOTC_NameStr(q) + " 发起了踢出投票");
    BOTC_KickRender();
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), true);
    DialogControlSetVisible(g_kickYes, PlayerGroupAll(), true);
    DialogControlSetVisible(g_kickNo, PlayerGroupAll(), true);
    if (g_kickBy != g_teller) {
        DialogControlSetVisible(g_kickYes, PlayerGroupSingle(g_teller), false);   // 说书人不投 ---- 除非这个投票就是他发起的
        DialogControlSetVisible(g_kickNo, PlayerGroupSingle(g_teller), false);
    }
    DialogControlSetVisible(g_kickYes, PlayerGroupSingle(g_who[q]), false);   // 被踢的人不能投自己
    DialogControlSetVisible(g_kickNo, PlayerGroupSingle(g_who[q]), false);
    BOTC_PmStore(g_teller, "【踢人投票】" + BOTC_NameStr(BOTC_PosOf(by)) + " 发起：是否踢出 " + BOTC_NameStr(q) + "（门槛 " + IntToString(BOTC_KickNeed()) + " 票，60 秒）。");
}

// 投一票：yes = 1（是）/ 0（否）
void BOTC_KickCast (int p, int yes) {
    if (g_kickTar < 1) {
        return;
    }
    if (p < 1 || p > 13 || p == g_who[g_kickTar]) {   // g_kickTar 是格子：被踢的人不投自己
        return;                       // 被踢的人不投自己
    }
    if (p == g_teller && g_kickBy != g_teller) {
        return;                       // 说书人不投 ---- 除非这个投票就是他发起的（用户 2026-10-02）
    }
    if (PlayerStatus(p) == 2) {
        return;
    }
    if (yes == 1) {
        g_kickVote[p] = 1;
    }
    else {
        g_kickVote[p] = 2;
    }
    BOTC_KickRender();
    // 【投完就把框收掉】（用户 2026-10-02）：这一票不改了 ---- 只收他自己那份，别人那份还在，可以继续投
    DialogSetVisible(g_kickDlg, PlayerGroupSingle(p), false);
    if (BOTC_KickCountYes() >= BOTC_KickNeed()) {
        BOTC_KickPass();
        return;
    }
    if (BOTC_KickCountVoted() >= BOTC_KickVoterN()) {
        BOTC_KickFail("能投的人都投完了，没到门槛。");
    }
}

// 通过：踢人
void BOTC_KickPass () {
    int q;
    q = g_kickTar;
    BOTC_PubAnnounce("【踢出】" + BOTC_NameStr(q) + " 已被投票踢出游戏。");
    BOTC_PmStore(g_teller, "【踢人投票】通过 → 把 " + BOTC_NameStr(q) + " 踢出。");
    BOTC_KickEnd();
    KickFromGame(PlayerGroupSingle(g_who[q]));
}

// 没通过 / 超时
void BOTC_KickFail (string why) {
    BOTC_PubAnnounce("【踢人投票】没通过：" + why);
    BOTC_KickEnd();
}

// 收尾：清状态 + 收起对话框
void BOTC_KickEnd () {
    int i;
    g_kickTar = 0;
    g_kickBy = 0;
    g_kickSec = 0;
    g_kickHalf = 0;
    g_kickMode = 0;
    for (i = 0; i <= 13; i += 1) {
        g_kickVote[i] = 0;
    }
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), false);
}

// 挂在 0.5 秒 tick 里：倒计时（两拍一秒）+ 每秒刷票数
void BOTC_KickTick () {
    if (g_kickTar < 1) {
        return;
    }
    if (PlayerStatus(g_who[g_kickTar]) == 2) {     // 【座位机制】g_kickTar 是格子
        BOTC_PubAnnounce("【踢人投票】被投票的人已经离开了，投票作废。");
        BOTC_KickEnd();
        return;
    }
    g_kickHalf = g_kickHalf + 1;
    if (g_kickHalf >= 2) {
        g_kickHalf = 0;
        g_kickSec = g_kickSec - 1;
        if (g_kickSec <= 0) {
            BOTC_KickFail("时间到了（60 秒）。");
            return;
        }
        BOTC_KickRender();
    }
}

bool BOTC_Tick_Func (bool testConds, bool runActions) {
    int p;
    int i;
    int sec;
    int ch;
    if (!runActions) {
        return true;
    }
    // 选板子页面：黑屏渐变 + 倒计时刷新
    if (g_boardOpen) {
        BOTC_BoardTick();
        if (g_cOpen && g_csel[130]) {
            BOTC_BootleggerCapture();
        }
        // 保存按钮触发的这一拍，编辑框往往还没提交新文本；下一拍失焦后再补写规则。
        if (g_bootSavePending) {
            BOTC_BootleggerCapture();
            BOTC_CustomSaveBootOnly(g_bootSaveSlot, g_bootText);
            g_bootSavePending = false;
            BOTC_NoticeKeep(g_teller, "【私货商人】规则已补存：" + IntToString(StringLength(g_bootText)) + " 个字符。");
        }
        // 【自定义剧本 · 读档重试】（用户 2026-10-04）：进图头一两秒读 bank 可能还没就绪
        //   （写是几十秒后点的【保存】，所以写得进、读不回来）。选板子阶段每 0.5 秒重试一次，读到就停。
        //   面板已经开着时不再重试 —— 免得把说书人刚刚手动选好的东西冲掉。
        if (g_customSlot >= 1 && g_customSlot <= 6 && !g_customBankOk && g_bankTry < 60) {
            // 【读档重试】每 0.5 秒试一次，最多试 60 次（≈30 秒）—— **有上限**，
            //   免得万一读不到就一直去碰 bank（线上每次碰 bank 都可能要跟 Battle.net 同步，反复碰会拖慢游戏）。
            //   ⚠ `BOTCSave` 这个名字必须在地图触发器里挂过「数据存档 - 为玩家1打开数据存档」，
            //     引擎才会真的去读它（用户 2026-10-04 实测：不挂永远读到空壳）。
            //   ⚠ 那条动作**必须放在"加载结束之后"执行**（例如：另一个触发器「地图初始化 → 等待 5 秒 → 打开数据存档」）。
            //     放在地图初始化里直接开档，**线上会卡在加载进度条**（跟开几个玩家无关，用户 2026-10-04 实测）。
            g_bankTry = g_bankTry + 1;
            BOTC_CustomLoadBank(false);
            if (g_customBankOk && g_cOpen) {
                BOTC_BootleggerEditRefresh();
                BOTC_CustomRender();         // 面板已经开着时读到了 → 补一次重画
            }
        }
    }
    BOTC_CdRender();
    // 【狂热者（110）】（用户 2026-10-10）：投票阶段里**每秒掷一次**，中了就替他点【投票】
    //   （不是一进投票阶段就投）：剩 > 10 秒每秒 10%；剩 10..4 秒从 30% 起、每秒 +8%；剩 ≤ 3 秒 100%。
    //   中毒 / 酒鬼 / 已死 / 教派投票 都不算（BOTC_ZealotMustVote 里已经排掉）。
    if (g_phase == 5 && !g_cultOn) {
        sec = FixedToInt(TimerGetRemaining(g_tVote));
        if (sec < 0) { sec = 0; }
        if (sec != g_zealotSec) {
            g_zealotSec = sec;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (g_vote[i] == 1) { continue; }
                if (!BOTC_ZealotMustVote(i)) { continue; }
                ch = 10;
                if (sec <= 10) { ch = 30 + ((10 - sec) * 8); }
                if (sec <= 3) { ch = 100; }
                if (RandomInt(1, 100) <= ch) {
                    g_vote[i] = 1;
                    g_voteWasDead[i] = BOTC_SeatDead(i);
                    BOTC_NomUI();
                }
            }
        }
    }
    if (g_cultOn) {
        BOTC_CultRender();             // 【教派投票】倒计时 + 还没投的人（用户 2026-10-10）
    }
    BOTC_TimerAiInit();            // 只负责「入夜把倒计时收掉」（2026-10-16 起不再自动开表、不再自动换类型）
    BOTC_TimerTick();              // 时段倒计时走表
    BOTC_LaughTick();              // -laugh 公用冷却 + 复活动画（用户 2026-09-22）
    BOTC_GrimShareCdTick();        // 一键发送魔典：每个玩家独立的 15 秒冷却
    BOTC_DeadPickTimeout();        // 月之子 / 呆瓜 的 60 秒兜底（用户 2026-09-21）
    BOTC_LeftCheck();              // 【玩家离开游戏】检测 → 公聊播一句（用户 2026-10-02）
    BOTC_VizierSync();             // 维齐尔免死 token 跟随中毒 / 醉酒 / 死亡 / 离场状态
    // 【界面自愈】（用户 2026-10-07 报「换位之后有时候渲染不对、第二遍才对」）：每 0.5 秒重画一次
    //   说书人那份魔典（只 1 个客户端）—— 哪怕哪一步漏刷，最多半个 tick 就自己补上。
    BOTC_GrimRender(g_teller);
    BOTC_KickTick();               // 【投票踢人】倒计时 + 每秒刷票数（用户 2026-10-02）
    // 【请求加入】按私聊列表的选中状态冒出来：
    //   列表点选不一定触发控件事件，所以借这个 0.5 秒的 tick 每拍对一次状态（用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmJoinRender(p);
        BOTC_InviteRender(p);          // 【邀请加入】（用户 2026-10-10）：说书人在私聊里时才冒出来
        BOTC_DissolveRender(p);        // 【解散私聊】（用户 2026-10-10）：同上
        BOTC_LogMenuTick(p);           // 【看某玩家 · 菜单】选中哪一行就切到那个人的视图
    }
    return true;
}

//==================================================================================================
// 【临时测试】开局 3 秒后自动跑一遍提名，方便用玩家2的视角看流程。
//   想改谁提名谁：把下面 NomWant / NomPick 的两个数字换掉即可（例如 3 提名 2 就写成 NomWant(3) + NomPick(3, 2)）
//   想只自动开环节、自己去点"发起提名"：把 NomWant 和 NomPick 两行删掉
//   测试完：把这整个函数 + BOTC_Init 里带"临时测试"注释的三行一起删掉
//==================================================================================================

//==================================================================================================
// 【临时测试】智能说书两天流程测试（正式版把这整段删掉）
//   开局：随机发牌 → 玩家1（座位 2）改成猎手 → 强制智能说书 → 跳过选板子 → 游戏正式开始（第 1 夜）
//   夜里：按「今晚该醒的角色」逐个自动唤醒；每个先醒一拍（2 秒），没自己选目标的由脚本随便选一个再收回
//   流程：第 1 夜 → 天亮（第 1 天，40 秒自由时间）→ 第 2 夜 → 天亮（第 2 天）
//         → 第 2 天 20 秒后自动处决 玩家3（座位 4）→ 入夜（测试到这里结束，之后你自己玩）
//   另外：玩家1 那份魔典会同步成「说书人的真魔典」，随时可以对照场上信息
//==================================================================================================

// 【测试】把说书人那份真魔典（身份 + token）整行复制给玩家1（不强制打开面板）

// 【测试】同步完再摊开给玩家1看

// 【测试】把玩家1（座位 2）弄成送葬者：场上本来有送葬者就和他对调（身份 + token），没有就直接改

// 【测试】把玩家1（座位 2）弄成「酒鬼送葬者」：魔典上写着送葬者，身上带「是酒鬼」token
//   ---- 也就是他以为自己是送葬者（收信息 / 唤醒都按送葬者走，但信息是假的）。
//   场上本来有送葬者就跟他换身份 + token（配板人数不变）；酒鬼 token 只留座位 2 这一个。

// 【测试】把玩家1（座位 2）弄成「酒鬼占卜师」：魔典上写着占卜师，身上带「是酒鬼」token
//   ---- 他以为自己是占卜师，验人走 BOTC_FtAnswer（所以会吃到 2 个「假干扰项」）。
//   跟酒鬼送葬者那套一样：优先跟场上原本的占卜师对调身份 + token，其次跟原本的酒鬼，
//   都没有就跟一个镇民对调（免得座位 2 正好是恶魔 / 爪牙，一改就把配板弄坏）。

// 【测试】把玩家1（座位 2）弄成贞洁者（索引 9）：场上本来有贞洁者就跟他换身份 + token，
//   没有就跟一个镇民换（免得座位 2 正好是恶魔 / 爪牙，一改就把配板弄坏），
//   最后再确认座位 2 身上没有「是酒鬼」token（这样测的才是真的贞洁者）。
// 【测试】"给你那个座位"：玩家1 是电脑（= AI 说书人）时你在玩家2（座位 3），
//   否则你在玩家1（座位 2）。测试给的角色、保护、提名都针对这个座位。


// 【电脑哲学家】从当前板子的角色池里随机挑一个候选。
// mode = -1 善良角色 / -2 善良角色但排除食人魔 / 0 镇民 / 1 外来者 / 3 恶魔。
int BOTC_AIPhiloRandomRole (int mode) {
    int i;
    int r;
    int n;
    int pick;
    n = 0;
    pick = -1;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 148 || r == 56) {
            continue;
        }
        if (mode < 0) {
            if (BOTC_RoleAlign(r) != 0) {
                continue;
            }
            if (mode == -2 && r == 148) {
                continue;
            }
        }
        else {
            if (BOTC_RoleTeam(r) != mode) {
                continue;
            }
            if (mode == 1 && (r == 14 || r == 38)) {
                continue;
            }
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    return pick;
}

// 【测试】帮没自己选目标的玩家随便选一个合法目标并确认（占卜师会选两个）
void BOTC_TestAutoSkill (int p) {
    int i;
    int q;
    int n;
    int need;
    int r;
    int cp;
    int kind;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_awake[p] && p != g_barberFrom) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (r < 0 || r > 148) {
        return;
    }
    // 卡扎力首夜只与说书人私聊；电脑玩家也不能由兜底逻辑替他选刀人目标。
    if (r == 135 && BOTC_ActingIsFirstNight(p)) {
        return;
    }
    // 赌徒（27）：人已经选好了，在等他自己在身份网格里点角色 ---- 等到这一拍还没点，智能说书兜底代猜一个
    //   （跟别的角色「没自己选就帮他选」一个道理；纯随机，不往「猜中」偏）
    if (r == 27 && g_gambleWait[p]) {
        n = BOTC_RandomBoardRole();
        if (n >= 0 && n <= 148) {
            BOTC_GambleGuess(p, n);
        }
        return;
    }
    // 哲学家（56）：电脑玩家直接完成善良角色选择和必要的第二次认知选择。
    if (r == 56 && !g_boffinActing[p] && !g_bnestActing[p]) {
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 70]) {
            return;
        }
        cp = g_who[p];
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), false);
        g_pickMode[cp] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        n = BOTC_AIPhiloRandomRole(-1);
        if (n < 0) {
            BOTC_PmStore(g_teller, "【电脑·哲学家】当前板子没有可自动选择的善良角色。");
            return;
        }
        BOTC_PhiloPick(p, n);
        kind = n;
        if (kind == 14 || kind == 38 || kind == 118) {
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
            g_pickMode[g_teller] = 0;
            g_pickTeam = -1;
            g_pickAlign = -1;
            if (kind == 14) {
                q = BOTC_AIPhiloRandomRole(0);
            }
            else if (kind == 38) {
                q = BOTC_AIPhiloRandomRole(3);
            }
            else {
                q = BOTC_AIPhiloRandomRole(1);
            }
            if (q >= 0) {
                BOTC_PhiloBelieve(p, q);
                BOTC_PmStore(g_teller, BOTC_NameStr(p) + " 选择了 " + g_roleName[n]);
            }
            else {
                BOTC_PmStore(g_teller, "【电脑·哲学家】选择了「" + g_roleName[n] + "」，但当前板子没有可用于第二次认知选择的角色。");
            }
        }
        else {
            BOTC_PmStore(g_teller, BOTC_NameStr(p) + " 选择了 " + g_roleName[n]);
        }
        return;
    }
    // 侍臣（29）：他选的是**角色**不是座位 ---- 先开门让玩家自己点，等不到就兜底随便选一个
    //   （跟赌徒一样：玩家自己点才算，智能说书只兜底）
    if (r == 29) {
        if (g_courtUsed[p]) {
            return;
        }
        if (g_pickMode[g_who[p]] != 5) {
            BOTC_CourtierOpen(p);
            return;
        }
        n = BOTC_RandomBoardRole();
        if (n >= 0 && n <= 148) {
            BOTC_CourtierPick(p, n);
        }
        return;
    }
    need = BOTC_TargetsOf(p);
    if (need <= 0) {
        return;
    }
    if (g_skillT1[p] > 0) {
        return;                        // 他自己已经选好了
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    n = 0;
    BOTC_BuildSeatList();
    // 【测试】占卜师（含酒鬼占卜师）：先让他验「假干扰项」那个座位 ---- 这样日志里一定看得到
    //   「验到假干扰项 → 有恶魔」这条；第二个目标随便挑一个不是假干扰项的人。
    if (r == 5) {
        BOTC_FtFakeSync();
        s = "【测试】占卜师的假干扰项：";
        n = 0;
        for (i = 0; i < 2; i += 1) {
            q = g_ftFakeSeat[i];
            if (q >= 2 && q != p) {
                if (!BOTC_SeatDead(q)) {
                    if (n > 0) {
                        s = s + "、";
                    }
                    s = s + BOTC_NameStr(q);
                    n = n + 1;
                    if (g_skillT1[p] <= 0) {
                        g_skillT1[p] = q;
                    }
                    else {
                        g_skillT2[p] = q;
                    }
                }
            }
        }
        if (n <= 0) {
            s = s + "（现在没有）";
        }
        // ⚠ 测试播报一律走 BOTC_Ann（debug 关了就不出声），别用 BOTC_PubAnnounce 直接播
        BOTC_Ann(s + " ---- 验到他们会报有恶魔");
        n = 0;
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == p) {
            continue;
        }
        if (r == 30) {                               // 教授（30）：只看「打了红叉（公开死亡）」的人
            if (!BOTC_PublicDead(q)) {
                continue;
            }
        }
        else {
            if (BOTC_SeatDead(q)) {
                continue;
            }
        }
        if (q == g_skillT1[p] || q == g_skillT2[p]) {
            continue;                  // 已经在上面当假干扰项排进去了
        }
        n = n + 1;
        if (g_skillT1[p] <= 0) {
            g_skillT1[p] = q;
        }
        else {
            if (need >= 2 && g_skillT2[p] <= 0) {
                g_skillT2[p] = q;
            }
            else {
                if (need >= 3 && g_skillT3[p] <= 0) {
                    g_skillT3[p] = q;
                }
            }
        }
    }
    if (g_skillT1[p] <= 0) {
        if (r == 30) {
            BOTC_PmStore(g_teller, "【教授】场上没有已经死了的玩家：这一次没有目标可选。");
        }
        return;
    }
    // 【寡妇（75）】（用户 2026-09-23）：她要手动按【确认】才下毒 ----
    //   这条「自动选目标」的路径（电脑玩家 / 自动测试）原来会顺手替她确认，
    //   表现就是「面板刚显示 目标：X，人就中毒了」。这里跳过她。
    if (r != 75) {
        BOTC_SkillConfirm(p);
    }
}

// 【测试】被唤醒的角色这次给几秒行动时间：
//   要自己选目标的（g_roleTargets > 0：占卜师 / 守鸦人 / 僧侣 / 投毒者 / 管家 / 小恶魔...）→ 20 秒
//   **间谍也 20 秒**（用户 2026-09-19）：他虽然不用选目标，但要整张魔典翻着看，5 秒不够；
//   只听说书人报一句话的那些（洗衣妇 / 图管 / 调查员 / 厨师 / 共情者 / 送葬者）才是 5 秒。
int BOTC_WakeSeconds (int r) {
    if (r == 18) {
        return 20;                 // 间谍：看魔典，给足 20 秒
    }
    if (r >= 0 && r <= 148) {
        if (g_roleTargets[r] > 0) {
            return 20;
        }
    }
    return 5;
}

// 【测试】每晚的一拍：先把「已经醒了一拍」的人处理掉（自动选目标 + 收回），再唤醒下一个该醒的角色
//   返回 true = 今晚还没处理完；false = 今晚该醒的都处理完了

// 【测试】清空这一夜的唤醒记录

// 【测试】让一个随机活着的玩家提名 target（用来验证贞洁者 / 提名流程）
// 【测试】随便挑一个还活着的人（智能说书人自动提名时用；以前固定挑「你」那个座位）


// 【测试】白天推进（每秒调一次）。第 1~2 天 = 私聊 4 分钟 → 公聊 3 分钟；第 3 天起 = 全程公聊 4 分钟，
//   然后智能说书人开提名环节（玩家投满 80% 的【快进到提名】也会提前开）。
//   提名 1 分钟后由智能说书人结束环节（有够票的待处决人就先处决），然后进入夜晚。
// 返回 true = 今天还没跑完

// 【测试】今天随机处决一个还活着的人（不会选玩家1）
//   ⚠ 现在测试流程已经改成「智能说书人按投票结果处决」，这个函数留着备用、不再调用。

// 【测试】4 天流程：奇数阶段 = 夜晚（按顺序自动唤醒 → 天亮），偶数阶段 = 白天（16 秒后随机处决一人 → 入夜）

//==================================================================================================
// 【按句柄踢人 / 黑名单】（用户 2026-10-02）
//   · 名单**写在这份脚本里**（BOTC_BanListInit 里那几行）---- 不依赖任何本地存档，
//     被封的人删自己的 Banks / 缓存也没用；要加人就是改脚本 + 重新发布地图。
//   · 开局跑一遍 BOTC_BanCheck()：扫每个真人座位的 Battle.net 句柄，命中就 KickFromGame 踢出去。
//   · 说书人 / 开发位在聊天里发 -handles 可以列出所有人的句柄（方便抄进名单）。
//   ⚠ PlayerHandle 对「电脑座位」会直接报错（2026-09-16 那次把 BOTC_Init 整条打断的教训）----
//     所以**任何取句柄的地方都要先判 PlayerType(p) == 1**（1 = 真人）。
//==================================================================================================

// 【名单在这里填】（用户 2026-10-02）：一行一个句柄，可以只写「名字」那一截。
//   加完记得把 g_banHandleN 改成实际条数；没填就是 0 条（谁都不踢）。
void BOTC_BanListInit () {
    g_banHandleN = 0;
    // g_banHandle[0] = "捣乱的人#12345";
    // g_banHandleN = 1;
}

// 这个句柄在不在名单里
bool BOTC_HandleIsBanned (string h) {
    int i;
    for (i = 0; i < g_banHandleN; i += 1) {
        if (i > 31) {
            break;
        }
        if (StringLength(g_banHandle[i]) <= 0) {
            continue;
        }
        if (StringFind(h, g_banHandle[i], false) >= 0) {
            return true;
        }
    }
    return false;
}

// 开局检查：命中名单的真人玩家直接踢出这局
void BOTC_BanCheck () {
    int p;
    string h;
    BOTC_BanListInit();
    if (g_banHandleN <= 0) {
        return;
    }
    for (p = 2; p <= 13; p += 1) {
        if (PlayerType(p) != 1) {
            continue;                       // 电脑座位：不取句柄（会报错）
        }
        h = PlayerHandle(p);
        if (StringLength(h) <= 0) {
            continue;
        }
        if (!BOTC_HandleIsBanned(h)) {
            continue;
        }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("【黑名单】") + PlayerName(p) + StringToText(" 已被移出游戏。"));
        KickFromGame(PlayerGroupSingle(p));
    }
}

// 聊天指令 -handles：把每个座位的句柄写进说书人私聊（方便抄进名单）
void BOTC_HandleListToPm () {
    int p;
    string h;
    for (p = 1; p <= 13; p += 1) {
        if (PlayerType(p) != 1) {
            BOTC_PmStore(g_teller, "【句柄】" + IntToString(p) + " 号 = ");
            continue;
        }
        h = PlayerHandle(p);
        BOTC_PmStore(g_teller, "【句柄】" + IntToString(p) + " 号 = " + h);
    }
}


void BOTC_Init () {
    int p;
    int i;
    g_teller = 1;                 // 【换说书人】每局开始：说书人默认坐 1 号位（用户 2026-10-06）
    g_pmVisOn = true;             // 默认保持旧行为：所有进行中的私聊可见
    for (i = 1; i <= 13; i += 1) {
        g_lab[i] = i - 1;         // 【编号表】格子 i 的显示编号 = i - 1（玩家1 = 格子 2）；换说书人时**不动**
        // 【座位颜色】用户 2026-10-06：**玩家1（= 物理座位 2）从红色开始**，往后 蓝/青/紫/黄/橙/绿/粉…
        //   （物理座位 1 是说书人那一格，固定白色，这里给个占位值就行）
        g_seatColor[i] = i - 1;
        g_who[i] = i;             // 【座位→人】开局：位置 i 就是物理座位 i
        if (g_seatColor[i] < 1) {
            g_seatColor[i] = 1;
        }
    }
    // 【说书人那一格固定用「深粉」】（用户 2026-10-14）：**色号 15 = 深粉**（用户实测：8 是淡粉、太淡）----
    //   下面所有按位置取色的地方（魔典名字行、座位面板…）都会跟着走，换成别色只改这一行。
    g_seatColor[1] = 15;
    for (p = 0; p <= 13; p += 1) {
        g_mySess[p] = 0;
        g_sessOwner[p] = 0;
        g_sessAlive[p] = false;
        g_reqFrom[p] = 0;
        g_reqJoinSess[p] = 0;
        g_reqJoinWho[p] = 0;
        g_joinWho[p] = 0;
        g_joinPending[p] = false;
        g_hidden[p] = false;
        g_logMode[p] = 0;
        g_logTarget[p] = 0;
        g_logMenuSel[p] = 0;
        g_logViewWho[p] = 0;
        g_logPickOn[p] = false;
        g_logPick[p] = false;
        g_logOpen[p] = false;
        g_abOpen[p] = false;
        g_pmLogCount[p] = 0;
        g_chatCount[p] = 0;
        g_pickMode[p] = 0;
        g_pickBluffSlot[p] = 0;
        g_nomUsed[p] = false;
        g_bansheeSecondNom[p] = false;
        g_nomTargeted[p] = false;
        g_nomFromOf[p] = 0;
        g_vote[p] = 0;
    }
    for (i = 0; i < 196; i += 1) {
        g_member[i] = false;
        g_joinVote[i] = false;
        g_listSess[i] = 0;
    }
    for (i = 0; i < 2400; i += 1) {
        g_pubLog[i] = "";
    }
    for (i = 0; i < 8400; i += 1) {
        g_pmLog[i] = "";
    }
    for (i = 0; i < 4200; i += 1) {
        g_chatLines[i] = "";
    }
    for (i = 0; i < 600; i += 1) {
        g_voteLog[i] = "";
    }
    g_pubLogCount = 0;
    g_voteLogCount = 0;
    g_started = false;
    g_dayNum = 0;
    g_nightNum = 0;

    // 【图层 + 顺序】（用户 2026-10-04 定稿）：
    //   数据 → 汉字预热（被黑布盖住）→ 黑布 → 公聊/私聊窗 → …其余面板… → 选板子页 / 自定义剧本面板
    //   · BOTC_GrimInitData() 必须最先跑：它是**纯数据**（角色名 / 阵营 / token / 字体样式 / 曲子名…），
    //     后面的界面全要用它；提前到这儿，也让下面的「汉字预热」能拿到真正的角色名。
    //   · 黑布单独一个对话框、建得比所有游戏内面板都早 → 选板子阶段聊天框压在黑布上面，能看见聊天；
    //   · 汉字预热建在黑布**之前**（＝比黑布更低）→ 被黑布盖住，玩家看不见（它就是个字形缓存）；
    //   · 选板子页 / 自定义剧本面板建得最晚 → 它们的按钮压在聊天框上面，照样能点。
    BOTC_GrimInitData();
    BOTC_BuildGlyphWarm();         // 汉字字形预热（建在黑布之前才会被盖住；这时角色名/字体样式已就位）
    BOTC_BuildBlack();             // 黑布（建得比预热晚 = 压在预热上面；比聊天早 = 聊天压在它上面）
    // ⚠ 公聊 / 私聊的黑底必须建在这两个窗口**之前**（对话框按创建先后分层，建晚了会盖住文字）
    //   聊天窗（连黑底）建在黑布之上：所有面板 / 魔典 / 弹框都压在它上面
    BOTC_BuildChatBackdrop();
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildChat(p);
        BOTC_BuildPmBox(p);
    }

    BOTC_BuildNight();
    BOTC_RevealAll();

    BOTC_BuildLog();
    BOTC_BuildLogPick();       // 【看某玩家】的下拉列表
    BOTC_BuildAbility();       // 旧面板照样建出来（只是不显示）---- 不建的话它的控件 id 是 0，HideAllUI 等处会报错
    BOTC_BuildNightOrder();
    BOTC_BuildRoleList();     // 新版自绘能力表：第一步（只建面板 + 图标 + 文字，先验证不崩）
    BOTC_BuildAbNew();        // 重做第 1 步：空面板
    BOTC_BuildTip();
    // 左侧那个面板：留在魔典**下面**（跟以前一样，免得挡住圆桌上的点击）
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildPanel(p);
    }
    // 【数据初始化已提前】（用户 2026-10-04）：BOTC_GrimInitData() 现在在 BOTC_Init 开头（黑布之前）调用，
    //   因为上面的「汉字预热」要用它填的 g_roleName / g_grimNameStyle
    BOTC_BuildGrim();              // 魔典
    BOTC_BuildExperimentalRoles();
    // 【汉字预热搬走了】（用户 2026-10-04）：它现在建在最前面（黑布之后、聊天之前），见 BOTC_Init 开头
    BOTC_BuildRoleSet();
    BOTC_BuildPreNotice();     // 开局前那行提示（用户 2026-09-19）
    BOTC_BuildTimer();         // 时段计时：说书人面板 + 全屏倒计时条（用户 2026-09-19）           // 【手动配板】按钮 + 面板（用户 2026-09-19）
    BOTC_BuildEvil();              // 邪恶小窗（建在魔典之后：压在魔典上面）
    BOTC_BuildPick();
    BOTC_BuildWakeChoice();        // 多重能力专用选择框（和身份网格完全分离）
    BOTC_BuildTok();
    BOTC_BuildGossip();        // 造谣者（28）的公开声明输入框
    BOTC_BuildJuggler();       // 杂耍艺人（58）：5 组「座位号 + 身份」的公开猜测面板（用户 2026-09-21）
    BOTC_BuildBluff();
    BOTC_BuildBoard();
    BOTC_BuildCustom();            // 【自定义剧本】面板（用户 2026-10-03）
    BOTC_ChatBgApply();            // 黑底透明度（默认值在 GrimInitData 里设，这里应用一次）
    BOTC_BuildWin();
    BOTC_BuildWinCongrats();
    BOTC_BuildPromote();
    BOTC_BuildBigNotice();
    BOTC_BuildNomBig();
    BOTC_BuildEndNotice();
    BOTC_BuildSlayAsk();
    BOTC_BuildShugenja();       // 【修行者（114）】说书人两选一面板（用户 2026-10-16）
    BOTC_BuildMayorAsk();
    BOTC_BuildManInfo();        // 【真人说书】信息位答题框（共情者 / 厨师 / 占卜师）
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildSkill(p);

        BOTC_BuildHd(p);
    }
    BOTC_BuildKick();           // 【投票踢人】那个中间的对话框（用户 2026-10-02）
    BOTC_BuildSeatAsk();        // 【换座位 · 请求框】（用户 2026-10-07）：魔典底部下方的无背景框
    BOTC_BuildSpec();           // 【发送特定信息】面板（用户 2026-10-10）
    BOTC_BuildGrant();          // 【赋予能力】说书人测试面板
    BOTC_BuildCult();           // 【教派投票】面板（用户 2026-10-10）
    BOTC_BuildWinAdmin();       // 【胜负控制】独立面板最后创建，保证压在魔典和其他面板之上

    // 开局定模式：玩家1是电脑就走智能说书
    //   ⚠ 想「强制」按智能说书跑（测试时懒得去大厅把玩家1 改成电脑）：把下面这行改成 true
    g_p1ForceComputer = false;
    BOTC_InitMode();
    // 【开局随机分配座位号】（用户 2026-10-07）：说书人已定（BOTC_InitMode 里顺位过），
    //   把"说书人以外的在场玩家"在玩家格上洗一次；还没发牌，只动 g_who 就够。
    BOTC_ShuffleSeats();
    BOTC_NomUI();
    BOTC_WakeRender();

    BOTC_RefreshSessListAll();

    g_tClick = TriggerCreate("BOTC_Click_Func");
    TriggerAddEventDialogControl(g_tClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    // 回车发送先不挂：c_triggerControlEventTypeEditCompleted 这个版本里不存在
    g_tChat = TriggerCreate("BOTC_Chat_Func");
    TriggerAddEventChatMessage(g_tChat, c_playerAny, "", false);
    // 【一键切换公聊 / 私聊】按 Tab ＝ 触发「选择英雄 1」这个槽（用户 2026-09-30）
    g_tHotKey = TriggerCreate("BOTC_HotKey_Func");
    TriggerAddEventHotkeyPressed(g_tHotKey, c_playerAny, c_hotkeySubgroupNext, true);
    // 【一键切换公聊 / 私聊】（用户 2026-09-30）：按 Tab 切"自己那份"（说书人也一样）。
    //   事件放在编辑器里的那个触发器里（事件"单位使用技能"、技能 qiehuan），
    //   动作写：BOTC_HotSwitch(EventPlayer());

    // 提名系统：阶段的计时器
    g_phase = 0;
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    g_tSpeech = TimerCreate();
    g_tVote = TimerCreate();
    g_tTick = TimerCreate();
    g_tSpeechTrig = TriggerCreate("BOTC_SpeechTimer_Func");
    TriggerAddEventTimer(g_tSpeechTrig, g_tSpeech);
    g_tVoteTrig = TriggerCreate("BOTC_VoteTimer_Func");
    TriggerAddEventTimer(g_tVoteTrig, g_tVote);
    // 【教派投票】（用户 2026-10-10）：20 秒倒计时
    g_tCult = TimerCreate();
    g_tCultTrig = TriggerCreate("BOTC_CultTimer_Func");
    TriggerAddEventTimer(g_tCultTrig, g_tCult);
    g_tTickTrig = TriggerCreate("BOTC_Tick_Func");
    TriggerAddEventTimer(g_tTickTrig, g_tTick);
    g_tDawn = TimerCreate();
    g_tDawnTrig = TriggerCreate("BOTC_DawnFunc");
    TriggerAddEventTimer(g_tDawnTrig, g_tDawn);
    TimerStart(g_tTick, 0.5, true, c_timeGame);


    // 板子：30 秒没选完就按票数（或默认第一个）收尾
    g_tBoard = TimerCreate();
    g_tBoardTrig = TriggerCreate("BOTC_BoardTimer_Func");
    TriggerAddEventTimer(g_tBoardTrig, g_tBoard);

    // 背景音乐：换曲子时等上一首淡出完（1.5 秒）再放新的
    g_tMusic = TimerCreate();
    g_tMusicTrig = TriggerCreate("BOTC_MusicTimer_Func");
    TriggerAddEventTimer(g_tMusicTrig, g_tMusic);

    // 限时音效（天亮那声 baitian）：到点淡出停掉
    g_tSfxStop = TimerCreate();
    g_tSfxStopTrig = TriggerCreate("BOTC_SfxStopFunc");
    TriggerAddEventTimer(g_tSfxStopTrig, g_tSfxStop);

    // 入夜倒计时（白天 → 黑夜要等 5 秒）
    g_tNightPend = TimerCreate();
    g_tNightPendTrig = TriggerCreate("BOTC_NightPendFunc");
    TriggerAddEventTimer(g_tNightPendTrig, g_tNightPend);

    // 胜利过场（结算音效放 2 秒 → 弹面板 + 播胜利曲）
    g_tWinStage = TimerCreate();
    g_tWinStageTrig = TriggerCreate("BOTC_WinStageFunc");
    TriggerAddEventTimer(g_tWinStageTrig, g_tWinStage);

    // 提名环节的「20 秒自由提名时间」倒数
    g_tNomFree = TimerCreate();
    g_tNomFreeTrig = TriggerCreate("BOTC_NomFreeFunc");
    TriggerAddEventTimer(g_tNomFreeTrig, g_tNomFree);

    // 猎手射中恶魔的两段过场（2 秒充能 → 2.5 秒枪声）
    g_tSnipe = TimerCreate();
    g_tSnipeTrig = TriggerCreate("BOTC_SnipeFunc");
    TriggerAddEventTimer(g_tSnipeTrig, g_tSnipe);
    // 哈迪寂亚：电脑座位自动替他选生 / 死
    g_tHdAuto = TimerCreate();
    g_tHdAutoTrig = TriggerCreate("BOTC_HdAutoFunc");
    TriggerAddEventTimer(g_tHdAutoTrig, g_tHdAuto);

    // 提名环节：延迟 4 秒弹魔典（给"现在是提名阶段"的大提示留时间）
    g_tNomPop = TimerCreate();
    g_tNomPopTrig = TriggerCreate("BOTC_NomPop_Func");
    TriggerAddEventTimer(g_tNomPopTrig, g_tNomPop);

    // 【游戏正式开始】的 10 秒倒计时（每秒一拍）
    g_tStartCd = TimerCreate();
    g_tStartCdTrig = TriggerCreate("BOTC_StartCdFunc");
    TriggerAddEventTimer(g_tStartCdTrig, g_tStartCd);

    // 开局先黑屏选板子（前 1 分钟）
    BOTC_BoardOpen();


    // 【按句柄踢人】（用户 2026-10-02）：开局检查一遍黑名单（名单在脚本里，删本地存档没用）
    BOTC_BanCheck();
}
