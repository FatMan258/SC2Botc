        DialogControlSetVisible(g_abCatPrev[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_abCatNext[i], PlayerGroupAll(), false);
    }

    // 【第 3 页：名词解释】（用户 2026-09-20）：6 条，每条 = 标题 1 行 + 正文 3 行
