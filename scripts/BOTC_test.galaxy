//--------------------------------------------------------------------------------------------------
// 记录区
//--------------------------------------------------------------------------------------------------
void BOTC_PubAnnounce (string s) {
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 【调试总开关】测试播报：只有 g_debugOn 为真才播（关掉之后公聊就是干净的正式局样子）
void BOTC_Ann (string s) {
    if (!g_debugOn) {
        return;
    }
    BOTC_PubAnnounce(s);
}

// 【调试总开关】诊断日志：只有 g_debugOn 为真才往私聊日志写
void BOTC_DiagStore (int p, string s) {
    if (!g_debugOn) {
        return;
    }
    BOTC_PmStore(p, s);
}

// 只往公聊日志里存一行：不写常驻聊天窗、不播字幕（时段分隔标记用这个）
void BOTC_PubLogStore (string s) {
    int i;
    int p;
    bool rolled;
    rolled = false;
    if (g_pubLogCount >= 2400) {
        rolled = true;
        for (i = 0; i < 2399; i += 1) {
            g_pubLog[i] = g_pubLog[i + 1];
            g_pubWho[i] = g_pubWho[i + 1];
        }
        g_pubLog[2399] = s;
        g_pubWho[2399] = g_chatWhoNow;
    }
    else {
        g_pubLog[g_pubLogCount] = s;
        g_pubWho[g_pubLogCount] = g_chatWhoNow;
        g_pubLogCount = g_pubLogCount + 1;
    }
    // 正开着【日志 → 公聊记录】的人：立刻把这一行接上去（**不自动滚到最新**，用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        if (g_logLiveUpdate && g_logOpen[p] && (g_logMode[p] == 0 || g_logMode[p] == 3)) {
            if (g_logMode[p] == 3) {
                // 【系统消息】页签（用户 2026-09-30）：只接系统行，而且**追加**、不整段重画
                //   （以前走 BOTC_LogRender 整段重画，列表会跳回最上面；跟公聊记录一样只追加就好）
                if (g_chatWhoNow == 0) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, 0));
                }
            }
            else if (g_logViewWho[p] > 0) {
                // 【看某玩家】（用户 2026-10-04 报「带滚轮的聊天框经常间歇性自己消失」）：
                //   以前这里一有新消息就 BOTC_LogRender 整段重画（RemoveAllItems + 全部重新加一遍），
                //   列表会瞬间空一下再填回来 —— 看起来就是聊天框自己消失。现在改成**只判断这一行要不要接**：
                //   他说的 / 天数时段分隔标记 → 追加；别人说的 → 这一行本来也不该显示，直接不动。
                if (BOTC_IsPeriodMark(s) || g_chatWhoNow == g_logViewWho[p]) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, g_chatWhoNow));
                }
            }
            else {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, g_chatWhoNow));
            }
        }
    }
}

// 这一行是不是「时段分隔标记」（---- 第1天 ---- / ---- 本局板子：XXX ---- 这种）
bool BOTC_IsPeriodMark (string s) {
    return StringFind(s, "----", false) >= 0;
}

void BOTC_PubLine (string s) {
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
}

// 当前时段的文字：第N夜 / 第N天 / 准备阶段
string BOTC_PeriodStr () {
    if (g_nightNum <= 0 && g_dayNum <= 0) {
        return "准备阶段";
    }
    if (g_isNight) {
        return "第" + IntToString(g_nightNum) + "夜";
    }
    return "第" + IntToString(g_dayNum) + "天";
}

// 时段分隔标记：公聊日志 + 每个玩家的私聊日志 + 投票统计日志各写一行
void BOTC_PeriodRecord (string s) {
    int p;
    g_chatWhoNow = 0;              // 分隔标记不属于任何人：不加名字前缀，也不会被当成某个人的发言
    BOTC_PubLogStore(s);
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmStore(p, s);
    }
    BOTC_VoteLogAdd(s);
}

// 投票统计日志：每条提名一行（时段分隔标记也走这里）
void BOTC_VoteLogAdd (string s) {
    int i;
    int p;
    bool rolled;
    rolled = false;
    if (g_voteLogCount >= 600) {
        rolled = true;
        for (i = 0; i < 599; i += 1) {
            g_voteLog[i] = g_voteLog[i + 1];
        }
        g_voteLog[599] = s;
    }
    else {
        g_voteLog[g_voteLogCount] = s;
        g_voteLogCount = g_voteLogCount + 1;
    }
    // 正开着【日志 → 投票统计】的人：立刻接上这一行（用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        if (g_logLiveUpdate && g_logOpen[p] && g_logMode[p] == 2) {
            if (rolled) {
                DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, 0));   // 投票统计：名字也换成真名
        }
    }
}

// 我现在这条私聊里的"对面那位"：忽略说书人（1）——
//   2 人私聊 = 对方；说书人介入的 3 人私聊 = 那名玩家；不在私聊里 = 0
int BOTC_PmWithMe (int p) {
    int s;
    int i;
    int who;
    who = 0;
    s = g_mySess[p];
    if (s < 1 || s > 13) {
        return 0;
    }
    for (i = 2; i <= 13; i += 1) {
        if (i != p && g_member[(s * 14) + i]) {
            who = i;
        }
    }
    return who;
}

void BOTC_PmStore (int p, string s) {
    int i;
    int w;
    bool rolled;
    rolled = false;
    // 【坐标统一】（用户 2026-10-07）：g_pmWith 要跟 g_pmWho / g_logViewWho 一样存**格子**，
    //   而 BOTC_PmWithMe 返回的是【对面那位】的**物理座位**（g_member / g_mySess 都按座位存）→ 这里先转成格子。
    w = BOTC_PosOf(BOTC_PmWithMe(p));
    if (g_pmLogCount[p] >= 600) {
        rolled = true;
        for (i = 0; i < 599; i += 1) {
            g_pmLog[(p * 600) + i] = g_pmLog[(p * 600) + i + 1];
            g_pmWho[(p * 600) + i] = g_pmWho[(p * 600) + i + 1];
            g_pmWith[(p * 600) + i] = g_pmWith[(p * 600) + i + 1];
            g_pmBoxOnly[(p * 600) + i] = g_pmBoxOnly[(p * 600) + i + 1];
        }
        g_pmLog[(p * 600) + 599] = s;
        g_pmWho[(p * 600) + 599] = g_chatWhoNow;
        g_pmWith[(p * 600) + 599] = w;
        g_pmBoxOnly[(p * 600) + 599] = g_pmBoxOnlyNow;
    }
    else {
        g_pmLog[(p * 600) + g_pmLogCount[p]] = s;
        g_pmWho[(p * 600) + g_pmLogCount[p]] = g_chatWhoNow;
        g_pmWith[(p * 600) + g_pmLogCount[p]] = w;
        g_pmBoxOnly[(p * 600) + g_pmLogCount[p]] = g_pmBoxOnlyNow;
        g_pmLogCount[p] = g_pmLogCount[p] + 1;
    }
    // 他正开着【日志 → 我的私聊】：立刻把这一行接上去（**不自动滚到最新**，用户 2026-09-19）
    if (g_logLiveUpdate && g_logOpen[p] && (g_logMode[p] == 1 || g_logMode[p] == 3)) {
        if (g_logMode[p] == 3) {
            // 【系统消息】页签（用户 2026-09-30）：只接系统行，而且是**追加**、不整段重画
            if (g_chatWhoNow == 0 && !g_pmBoxOnlyNow) {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, 0));
            }
        }
        else if (g_logViewWho[p] > 0) {
            // 【看某玩家】（用户 2026-10-04）：同公聊那一路，别再整段重画（会让聊天框闪一下）。
            //   只接「跟他这段对话有关的行」：他说的 / 我说的且这行是跟他聊的 / 天数时段分隔标记；
            //   另外「只进私聊框、不进日志」的行照旧不接（用户 2026-09-30）。
            if (!g_pmBoxOnlyNow) {
                if (BOTC_IsPeriodMark(s) || g_chatWhoNow == g_logViewWho[p] || (g_chatWhoNow == BOTC_PosOf(p) && w == g_logViewWho[p])) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, g_chatWhoNow));
                }
            }
        }
        else {
            // 【只进私聊框、不进日志】的行（用户 2026-09-30）：日志正开着也不接上去
            if (!g_pmBoxOnlyNow) {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(s, g_chatWhoNow));
            }
        }
    }
    BOTC_PmBoxRender(p);
}

void BOTC_ChatRender (int p) {
    int i;
    int start;
    int blank;
    start = g_chatCount[p] - 26;
    if (start < 0) {
        start = 0;
    }
    // 最近的一条永远在最下面，上面空着的行留白（这样不会有多余的滚动条）
    blank = 26 - (g_chatCount[p] - start);
    for (i = 0; i < 26; i += 1) {
        if (i < blank) {
            libNtve_gf_SetDialogItemText(g_chatRow[(p * 26) + i], StringToText(""), PlayerGroupSingle(p));
        }
        else {
            // 名字按说话人的游戏内颜色显示
            libNtve_gf_SetDialogItemText(g_chatRow[(p * 26) + i], BOTC_LineText(g_chatLines[(p * 300) + start + (i - blank)], g_chatWho[(p * 300) + start + (i - blank)]), PlayerGroupSingle(p));
        }
    }
}

void BOTC_ChatShow (int p, string s) {
    int i;
    if (g_chatCount[p] >= 50) {
        for (i = 0; i < 49; i += 1) {
            g_chatLines[(p * 300) + i] = g_chatLines[(p * 300) + i + 1];
            g_chatWho[(p * 300) + i] = g_chatWho[(p * 300) + i + 1];
        }
        g_chatLines[(p * 300) + 49] = s;
        g_chatWho[(p * 300) + 49] = g_chatWhoNow;
    }
    else {
        g_chatLines[(p * 300) + g_chatCount[p]] = s;
        g_chatWho[(p * 300) + g_chatCount[p]] = g_chatWhoNow;
        g_chatCount[p] = g_chatCount[p] + 1;
    }
    BOTC_ChatRender(p);
}

void BOTC_ChatShowAll (string s) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        BOTC_ChatShow(i, s);
    }
}

// 私聊窗：只显示"自己看到的私聊内容 + 和自己的私聊有关的提示"，显示最近 10 行
void BOTC_PmBoxRender (int p) {
    int i;
    int start;
    int blank;
    start = g_pmLogCount[p] - 14;
    if (start < 0) {
        start = 0;
    }
    blank = 14 - (g_pmLogCount[p] - start);
    for (i = 0; i < 14; i += 1) {
        if (i < blank) {
            libNtve_gf_SetDialogItemText(g_pmRow[(p * 14) + i], StringToText(""), PlayerGroupSingle(p));
        }
        else {
            // 名字按说话人的游戏内颜色显示
            libNtve_gf_SetDialogItemText(g_pmRow[(p * 14) + i], BOTC_LineText(g_pmLog[(p * 600) + start + (i - blank)], g_pmWho[(p * 600) + start + (i - blank)]), PlayerGroupSingle(p));
        }
    }
}

void BOTC_LogRender (int p) {
    int i;
    int t;
    DialogControlRemoveAllItems(g_logList, PlayerGroupSingle(p));
    // 用户 2026-09-19：以前这里只画「最近 30 条」，所以日志看着只有一小部分。
    //   现在**把存着的全部画进去**（列表本身能滚动 / 能拖滚动条），三种页签都一样。
    if (g_logMode[p] == 0) {
        for (i = 0; i < g_pubLogCount; i += 1) {
            // 【看某玩家】筛选（用户 2026-09-30）：只留那个人的发言 + 天数/时段分隔标记；
            //   其它系统提示（【配比】【巡山人】这些）在这个视图里过滤掉
            if (g_logViewWho[p] > 0) {
                if (!BOTC_IsPeriodMark(g_pubLog[i])) {
                    if (g_pubWho[i] != g_logViewWho[p]) {
                        continue;
                    }
                }
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(g_pubLog[i], g_pubWho[i]));
        }
    }
    else {
        if (g_logMode[p] == 2) {
            for (i = 0; i < g_voteLogCount; i += 1) {
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(g_voteLog[i], 0));   // 投票统计：名字换成真名
            }
            return;
        }
        // 【系统消息】页签（用户 2026-09-30）：不管「看某玩家」选了谁，都只显示**我自己**收到的系统消息
        //   （公聊 / 私聊里被过滤掉的那些 + 天数/时段分隔标记，标记不过滤）
        if (g_logMode[p] == 3) {
            for (i = 0; i < g_pubLogCount; i += 1) {
                if (g_pubWho[i] == 0) {
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(g_pubLog[i], 0));
                }
            }
            for (i = 0; i < g_pmLogCount[p]; i += 1) {
                if (g_pmBoxOnly[(p * 600) + i]) {
                    continue;
                }
                if (g_pmWho[(p * 600) + i] == 0) {
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(g_pmLog[(p * 600) + i], 0));
                }
            }
            return;
        }
        for (i = 0; i < g_pmLogCount[p]; i += 1) {
            // 【只进聊天框、不进日志】的行（用户 2026-09-30：按 Tab 那些提示）
            if (g_pmBoxOnly[(p * 600) + i]) {
                continue;
            }
            // 【看某玩家】筛选（用户 2026-09-30）：私聊页签只留「跟他这段对话」——
            //   ① 他说的（他的发言都在我这份日志里，必是我参与的会话）
            //   ② 我自己说的，且这一行属于跟他那段对话（g_pmWith 记着"这行是跟谁聊的"）
            //   这样看玩家3 时，就不会把我和玩家2 的私聊也带出来。
            if (g_logViewWho[p] > 0) {
                // 天数/时段分隔标记永远留；其它系统提示过滤掉（用户 2026-09-30）
                if (!BOTC_IsPeriodMark(g_pmLog[(p * 600) + i])) {
                    // 【坐标统一】（用户 2026-10-07）：g_pmWho 存的是**格子**、p 是**物理座位** ——
                    //   换过座位之后两者不等，自己说的那几行会被当成【别人说的】滤掉（我的私聊 → 看某玩家 里自己的话整段不见）。
                    if (g_pmWho[(p * 600) + i] == BOTC_PosOf(p)) {
                        if (g_pmWith[(p * 600) + i] != g_logViewWho[p]) {
                            continue;
                        }
                    }
                    else {
                        if (g_pmWho[(p * 600) + i] != g_logViewWho[p]) {
                            continue;
                        }
                    }
                }
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LineText(g_pmLog[(p * 600) + i], g_pmWho[(p * 600) + i]));
        }
    }
}

// 【看某玩家】（用户 2026-09-30 重做）：点一下就在按钮那儿弹出下拉列表（自带滚轮），
//   第 1 行【所有玩家】= 切回正常日志；点某一行 = 只看那个人。
//
// 【为什么敢改回列表框】（用户 2026-10-07 问「滚轮式解决不了自动消失吗」）：老毛病不在列表框本身，
//   在**"每 0.5 秒读一次选中项"**这个读法 —— 只要列表被（重）填一次，控件就会**自己选中第一行**，
//   轮询把这也当成"你点了一行"→ 下拉自己关掉。现在三道保险：
//     ① 列表**只在每个玩家第一次打开时填一次**（g_logPickFilled），之后永不重填 —— 新消息再多也不动它；
//     ② 轮询先看 g_logPickOn[p]：没开着根本不对；
//     ③ 打开后的**第一拍只记基线**（g_logMenuSel[p] = -1 → 下一拍把当时的选中项记下来），
//        之后只有**选中项真的变了**才算你点了那一行。
void BOTC_LogPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_logPickOn[p]) {
        g_logPickOn[p] = false;
        DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
        return;
    }
    if (!g_logPickFilled[p]) {
        BOTC_LogPickRender(p);
        g_logPickFilled[p] = true;
    }
    g_logMenuSel[p] = -1;          // -1 = 这一拍只记基线、不动作
    g_logPickOn[p] = true;
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), true);
}

// 把下拉列表填满（**只填一次**）：第 1 行 = 所有玩家，第 2 行 = 说书人，之后按座位号列出在场的人
void BOTC_LogPickRender (int p) {
    int i;
    DialogControlRemoveAllItems(g_logPickList, PlayerGroupSingle(p));
    DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LineText("所有玩家", 0));
    DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LineText("说书人", 1));
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i]) {
            DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LineText(BOTC_NameStr(i), i));
        }
    }
}

// 把"当前选中的那一行"应用成视图：第 1 行 = 所有玩家、第 2 行 = 说书人、之后按在场顺序数
void BOTC_LogPickTake (int p) {
    int sel;
    int i;
    int n;
    if (p < 1 || p > 13) {
        return;
    }
    sel = DialogControlGetSelectedItem(g_logPickList, p);
    if (sel < 1) {
        return;
    }
    g_logMenuSel[p] = sel;
    g_logViewWho[p] = 0;
    if (sel >= 2) {
        g_logViewWho[p] = 1;           // 第 2 行 = 说书人（游戏里的玩家 1）
    }
    n = 2;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        n = n + 1;
        if (n == sel) {
            g_logViewWho[p] = i;
        }
    }
    g_logPickOn[p] = false;
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
    BOTC_LogRender(p);
}

// 【看某玩家 · 下拉】每 0.5 秒对一次选中项（列表点选不一定触发控件事件，跟【请求加入】同一个套路）
void BOTC_LogMenuTick (int p) {
    int sel;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_logPickDlg == 0) {
        return;
    }
    if (!g_logPickOn[p]) {
        return;
    }
    sel = DialogControlGetSelectedItem(g_logPickList, p);
    if (g_logMenuSel[p] < 0) {
        g_logMenuSel[p] = sel;         // 第一拍：把"控件自己选中的那一行"记成基线
        return;
    }
    if (sel < 1 || sel == g_logMenuSel[p]) {
        return;
    }
    BOTC_LogPickTake(p);
}

// 打开日志：提名阶段先把该玩家的魔典收起来，保证日志不会被魔典盖住
void BOTC_LogOpen (int p) {
    // 每次打开日志都回到「所有玩家」（用户 2026-09-30）
    g_logViewWho[p] = 0;
    g_logPickOn[p] = false;
    BOTC_LogRender(p);
    g_logOpen[p] = true;
    if (g_phase != 0) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
    }
    DialogSetVisible(g_logDlg, PlayerGroupSingle(p), true);
}

// 关闭日志：提名阶段若能力表也没开，就把魔典放回来
void BOTC_LogClose (int p) {
    g_logOpen[p] = false;
    g_logPickOn[p] = false;
    DialogSetVisible(g_logDlg, PlayerGroupSingle(p), false);
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
    if (g_phase != 0 && !g_abOpen[p]) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    }
}

// 关闭角色能力表：提名阶段若日志也没开，就把魔典放回来
void BOTC_AbClose (int p) {
    g_abOpen[p] = false;
    DialogSetVisible(g_abNewDlg, PlayerGroupSingle(p), false);
    if (g_phase != 0 && !g_logOpen[p]) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    }
}

void BOTC_LogSetMode (int p, int mode) {
    g_logMode[p] = mode;
    BOTC_LogRender(p);
}

void BOTC_AppendPm (int p, string s) {
    BOTC_PmStore(p, s);
}

void BOTC_Notice (int p, string s) {
    bool onlyBak;
    if (!g_inClick) {
        BOTC_PmStore(p, s);
    }
    else {
        // 【日志屏蔽、私聊框不屏蔽】（用户 2026-09-30）：点按钮冒出来的提示原来连左边私聊框都不进；
        //   现在改成照旧进私聊框，只是在【日志 → 我的私聊 / 系统消息】那一页里被滤掉 ----
        //   用的就是原来「只进聊天框、不进日志」那个 g_pmBoxOnly 标记（按 Tab 切时段也是这一套）。
        onlyBak = g_pmBoxOnlyNow;
        g_pmBoxOnlyNow = true;
        BOTC_PmStore(p, s);
        g_pmBoxOnlyNow = onlyBak;
    }
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));   // 提示条换成真名（用户 2026-09-19）
}

// 跟 Notice 一样，但**不管是不是在点界面，都写进私聊日志**
//   （用户 2026-09-30：「已与 X 建立私聊」这种要留档）
void BOTC_NoticeKeep (int p, string s) {
    BOTC_PmStore(p, s);
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 【跟 Notice 一样，但只进私聊框、不进日志】（用户 2026-09-30）：点按钮那类即时反馈用它 ----
//   不管在不在点击里都打上 g_pmBoxOnly 标记 →【日志 → 我的私聊 / 系统消息】里不出现，左边私聊框照常显示。
void BOTC_NoticeBox (int p, string s) {
    bool onlyBak;
    onlyBak = g_pmBoxOnlyNow;
    g_pmBoxOnlyNow = true;
    BOTC_PmStore(p, s);
    g_pmBoxOnlyNow = onlyBak;
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 只弹一句屏幕提示，**不写进私聊记录**（邪恶小窗用：用户 2026-09-17 要求小窗的东西别跑到左边的私聊框里）
void BOTC_SubMsg (int p, string s) {
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));   // 提示条换成真名（用户 2026-09-19）
}

void BOTC_ShowReq (int p, string msg) {
    libNtve_gf_SetDialogItemText(g_reqLabel[p], BOTC_NameSubst(msg), PlayerGroupSingle(p));   // 请求框里的名字换成真名
    DialogControlSetVisible(g_reqLabel[p], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_reqYes[p], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_reqNo[p], PlayerGroupSingle(p), true);
}

void BOTC_ClearReq (int p) {
    libNtve_gf_SetDialogItemText(g_reqLabel[p], StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_reqLabel[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_reqYes[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_reqNo[p], PlayerGroupSingle(p), false);
}

void BOTC_RefreshSessList (int p) {
    int s;
    int i;
    int k;
    string desc;
    int n;
    DialogControlRemoveAllItems(g_sessList[p], PlayerGroupSingle(p));
    k = 0;
    for (s = 1; s <= 13; s += 1) {
        if (g_sessAlive[s]) {
            n = 0;
            for (i = 1; i <= 13; i += 1) {
                if (g_member[(s * 14) + i]) {
                    n = n + 1;
                }
            }
            if (n < 2) {
                continue;
            }
            // 【私聊可见性】关闭后，非说书人只隐藏其他会话；自己当前所在的会话始终保留。
            if (!g_pmVisOn && p != g_teller && !g_member[(s * 14) + p]) {
                continue;
            }
            // 【夜里别暴露说书人】夜里说书人是在私聊里给被唤醒的人发信息的 ----
            //   有说书人参与的私聊一旦出现在这份列表里，等于告诉大家「刚才谁被叫去说话了」。
            //   所以**夜里对别的玩家**隐藏这些会话（说书人自己那份照旧看得见，他要用来发信息）。
            if (g_isNight && p != g_teller && g_member[(s * 14) + g_teller] && !g_member[(s * 14) + p]) {
                continue;                       // 【自己就在这条私聊里就别藏】（用户 2026-10-19 报「在私聊里但显示不在」）
            }
            // 【小怪宝 · 恶人频道】（用户 2026-10-11）：这条群聊只给**里面的人 + 说书人**看 ----
            //   不然全场都会在「进行中的私聊」里看到「哪几个玩家在一起私聊」= 直接暴露恶人。
            if (s == g_lmSess && p != g_teller && !g_member[(s * 14) + p]) {
                continue;
            }
            k = k + 1;
            desc = "私聊" + IntToString(s) + "：";
            n = 0;
            for (i = 1; i <= 13; i += 1) {
                if (g_member[(s * 14) + i]) {
                    if (n > 0) {
                        desc = desc + "、";
                    }
                    desc = desc + BOTC_NameStr(BOTC_PosOf(i));      // 【按位置取名字】（用户 2026-10-07）
                    n = n + 1;
                }
            }
            DialogControlAddItem(g_sessList[p], PlayerGroupSingle(p), BOTC_NameSubst(desc));   // 私聊列表里的名字换成真名
            g_listSess[(p * 14) + k] = s;
        }
    }
    if (k == 0) {
        g_listSess[(p * 14) + 1] = 0;
        libNtve_gf_SetDialogItemText(g_sessTitle[p], StringToText("当前没有进行中的私聊"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_sessTitle[p], StringToText("进行中的私聊（选中后点「请求加入」）"), PlayerGroupSingle(p));
    }
}

void BOTC_RefreshSessListAll () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        BOTC_RefreshSessList(i);
    }
}
// 私聊列表里选中了某条 → 【请求加入】冒出来；没选中就藏起来。
//   ⚠ 只动【请求加入】自己：【发起私聊】一直留着（用户 2026-09-19 明确）
void BOTC_PmJoinRender (int p) {
    int sel;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_joinPopBtn[p] == 0) {
        return;
    }
    sel = 0;
    if (!g_hidden[p] && DialogControlGetSelectedItem(g_sessList[p], p) >= 1) {
        sel = 1;
    }
    if (sel == g_joinPopOn[p]) {
        return;                    // 状态没变就别反复设置控件（免得闪）
    }
    g_joinPopOn[p] = sel;
    if (sel == 1) {
        DialogControlSetVisible(g_joinPopBtn[p], PlayerGroupSingle(p), true);
    }
    else {
        DialogControlSetVisible(g_joinPopBtn[p], PlayerGroupSingle(p), false);
    }
}
//--------------------------------------------------------------------------------------------------
// 「发起私聊」（用户 2026-09-19 重做）：点面板上的按钮 → 开自己那份魔典 → 点座位选人
//   选人模式里魔典上只留【关闭魔典】和「说书人」那一格，座位旁的 ＋ 也一起收起来；
//   点座位 = BOTC_RequestChat，点完不论成败都退出模式并关掉魔典。
//--------------------------------------------------------------------------------------------------


// 选人模式里「魔典上只留关闭」的那一套收尾（进模式、以及从右上角重新开魔典时都要重做一遍）
void BOTC_PmPickApply (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    DialogControlSetVisible(g_grimStart, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_wakeBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_declareBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_grimDeal, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_grimConfirm, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_grimShare, PlayerGroupSingle(p), false);
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        DialogControlSetVisible(g_grimTokBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_sayTokBtn, PlayerGroupSingle(p), false);
    }
    BOTC_BigHintShow(p, "点一个座位，向他发起私聊。");
}

// 进入「发起私聊」选人：先把别的选人状态挡掉，再开魔典
void BOTC_PmPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_SessRepair();
    if (g_pmPick[p]) {
        BOTC_PmPickEnd(p);        // 已经开着：再点一下 = 取消「发起私聊」
        return;
    }
    // 【卡私聊 · 自愈】（用户 2026-10-03）：这些「选人中」标记如果已经不该在（他没被唤醒 / 面板早关了），
    //   先替他清掉 ---- 否则会被这句话永久卡住：点谁都没用，也点不了人。
    if (!g_awake[BOTC_PosOf(p)]) {      // g_awake 是格子口径：他本人有没有被唤醒
        if (g_skillPicking[BOTC_PosOf(p)]) {
            g_skillPicking[BOTC_PosOf(p)] = false;
            DialogSetVisible(g_skillDlg[BOTC_PosOf(p)], PlayerGroupSingle(p), false);
        }
        if (g_ftPick[p]) {
            g_ftPick[p] = false;
        }
        if (g_declarePick[p]) {
            g_declarePick[p] = false;
            BOTC_DeclareRender();
        }
    }
    // 处决 / 死亡标记模式是**说书人**的东西，别拿来挡玩家的私聊（用户 2026-10-03）
    if ((g_execPick || g_deadPick) && p == g_teller) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【发起私聊】。");
        return;
    }
    if (g_declarePick[p] || g_skillPicking[BOTC_PosOf(p)] || g_ftPick[p]) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【发起私聊】。");
        return;
    }
    g_pmPick[p] = true;
    BOTC_PanelOpen(p, 2);          // 关掉别的大面板 + 摊开自己那份魔典
    BOTC_PmPickApply(p);           // 魔典上只留【关闭魔典】（想找说书人就点「说书人」那一格）
    BOTC_Notice(p, "发起私聊：点魔典上的座位选人。");
}

// 退出「发起私聊」：还原魔典上的按钮和 ＋，把长驻提示收掉
void BOTC_PmPickEnd (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_pmPick[p]) {
        return;
    }
    g_pmPick[p] = false;
    BOTC_BigHintHide(p);
    BOTC_NomUI();                  // 发牌 / 开始 / 处决 / 死亡 那几个按钮按当前阶段还原
    BOTC_WakeRender();             // 【唤醒】按昼夜还原
    BOTC_DeclareRender();          // 【声称】还原
    BOTC_GrimRelayout();           // 座位旁的 ＋ 还原
    DialogControlSetVisible(g_sayTokBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_sayTokBtn, PlayerGroupSingle(g_teller), true);
    BOTC_GrimRender(p);
}

//--------------------------------------------------------------------------------------------------
// 私聊
//--------------------------------------------------------------------------------------------------
void BOTC_PubSay (int p, string tag, string msg) {
    string line;
    // 【说话人过映射】（用户 2026-10-07）：p 是 EventPlayer() 给的**物理座位**，而日志 / 私聊
    //   渲染时按**位置**取名字和编号 —— 先换算成位置，换说书人之后才不会把"我说的话"记到对方头上。
    line = tag + BOTC_SayToken(p) + "：" + msg;
    g_chatWhoNow = BOTC_PosOf(p);  // 这一行是谁说的（渲染时名字按他的颜色显示）
    BOTC_PubLine(line);
    g_chatWhoNow = 0;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText(tag) + TextWithColor(PlayerName(p), BOTC_SayColor(p)) + StringToText(": " + msg));
    // UI 音效：公屏每说一句都放一声（用户 2026-09-16 要求；只对公屏消息，私聊不响）
    BOTC_PlaySfx(g_sfxChatName);
}

// 回车发送（用户 2026-09-19）：私聊输入框 / 邪恶小窗输入框里按回车，等于点自己的发送按钮
bool BOTC_EditDo (bool testConds, bool runActions) {
    int p;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13) {
        return true;
    }
    if (EventDialogControl() == g_pmEdit[p]) {
        BOTC_SendPm(p);
        return true;
    }
    if (EventDialogControl() == g_evilEdit) {
        BOTC_EvilSend(p);
        return true;
    }
    return true;
}

// 回车发送（输入框）这条路径也打标记：这期间冒出来的提示不写进私聊日志
bool BOTC_EditDone_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_EditDo(testConds, runActions);
    g_inClick = false;
    return r;
}

void BOTC_SendPm (int p) {
    string msg;
    string line;
    string tag;
    int s;
    int i;
    playergroup pg;
    // 白天时段：公聊时间不许私聊（说书人例外，他要用私聊做提示）；
    //   **跟说书人在同一条私聊里的人也是破例允许的**（用户 2026-09-16 明确）----
    //   只要这条私聊里含玩家1，公聊时间照样能收发。
    if (g_chatMode == 2 && !g_cultOn && p != g_teller) {
        s = g_mySess[p];
        if (s == 0 || !g_member[(s * 14) + g_teller]) {
            BOTC_Notice(p, "现在是公聊时间，先别私聊；等私聊时间再单独找人聊（跟说书人的私聊可以）。");
            return;
        }
    }
    // 提名环节：说书人照样能私聊；异教领袖的教派投票不属于提名，私聊也照常开放。
    if (g_phase != 0 && !g_cultOn && p != g_teller) {
        s = g_mySess[p];
        if (s == 0 || !g_member[(s * 14) + g_teller]) {
            BOTC_Notice(p, "提名环节进行中，暂时不能私聊（跟说书人的私聊可以）。");
            return;
        }
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你还没有在进行私聊。点面板上的玩家名字可以发起私聊。");
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_pmEdit[p], p);
    if (StringLength(msg) == 0) {
        return;
    }
    if (p == g_teller) {
        tag = "[私聊] ";               // 说书人那格由 BOTC_LineText 渲染成「[说书人] 他的玩家ID」
    }
    else {
        tag = "[私聊] ";               // 玩家：真实号已经写在名字里了（[2]玩家1）
    }
    line = tag + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);      // 这一行是谁说的（私聊窗 / 私聊记录里名字按他的颜色显示）
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, line);
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText(tag) + TextWithColor(PlayerName(p), BOTC_SayColor(p)) + StringToText(": " + msg));
    libNtve_gf_SetDialogItemText(g_pmEdit[p], StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_pmEdit[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pmEdit[p], PlayerGroupSingle(p), true);
}

// 【私聊模式】回车发送（用户 2026-09-19）：把玩家自己打字的内容发进他当前那条私聊
//   ⚠ 没在私聊里 / 时段或阶段不允许时，只提示、不发送（避免私聊内容漏进公屏）
void BOTC_SayPmText (int p, string msg) {
    string line;
    string tag;
    int s;
    int i;
    playergroup pg;
    if (p < 1 || p > 13) {
        return;
    }
    if (StringLength(msg) == 0) {
        return;
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你现在不在私聊里：先【发起私聊】或【请求加入】，再切到私聊模式。");
        return;
    }
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，先别私聊（跟说书人的私聊除外）。");
        return;
    }
    if (g_phase != 0 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "提名环节进行中，暂时不能私聊（跟说书人的私聊可以）。");
        return;
    }
    tag = "[私聊] ";
    line = tag + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, line);
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText(tag) + TextWithColor(PlayerName(p), BOTC_SayColor(p)) + StringToText(": " + msg));
}

// 【一键发送魔典 · 单条标注】只读玩家自己那一行，不读说书人真值。
string BOTC_GrimShareRoleText (int ob, int q) {
    int role;
    int team;
    int rown;
    string roleName;
    string id;
    string label;
    bool hasPhil;
    bool hasDrunk;
    bool hasLunatic;
    bool hasCannibal;
    bool hasAlchemist;
    bool hasMarionette;
    bool hasWudao;
    bool hasLm;
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return "";
    }
    role = g_mark[(ob * 14) + q] - 1;
    if (role < 0 || role > 148) {
        role = -1;
        roleName = "";
    }
    else {
        roleName = g_roleName[role];
    }
    rown = (((ob * 14) + q) * 256);
    hasPhil = g_tokOn[rown + 70];
    hasDrunk = g_tokOn[rown + 8];
    hasLunatic = g_tokOn[rown + 49];
    hasCannibal = g_tokOn[rown + 97];
    hasAlchemist = g_tokOn[rown + 123];
    hasMarionette = g_tokOn[rown + 118];
    hasWudao = g_tokOn[rown + 140];
    hasLm = g_tokOn[rown + 134];
    id = "";
    if (hasDrunk) { id = "酒鬼"; }
    else if (hasLunatic) { id = "疯子"; }
    else if (hasCannibal) { id = "食人族"; }
    else if (hasAlchemist) { id = "炼金术士"; }
    else if (hasMarionette) { id = "提线木偶"; }
    else if (hasWudao) { id = "悟道者"; }
    else if (hasLm) { id = "小怪宝"; }
    if (id != "") {
        if (hasPhil) {
            label = "哲学家" + id;
        }
        else {
            label = id;
        }
        if (roleName != "" && roleName != id) {
            if (hasPhil) {
                label = label + "（" + roleName + "）";
            }
            else {
                label = label + "（" + roleName + "）";
            }
        }
    }
    else {
        if (hasPhil) {
            label = "哲学家";
            if (roleName != "" && roleName != "哲学家") {
                label = label + "（" + roleName + "）";
            }
        }
        else {
            label = roleName;
        }
    }
    if (label == "") {
        return "";
    }
    if (role >= 0) {
        team = BOTC_RoleTeam(role);
        if (g_tokOn[rown + 15] && (team == 0 || team == 1)) {
            label = "（邪恶）" + label;
        }
        else {
            if (g_tokOn[rown + 14] && (team == 2 || team == 3)) {
                label = "（善良）" + label;
            }
        }
    }
    return label;
}

void BOTC_GrimShareRender () {
    int p;
    DialogControlSetVisible(g_grimShare, PlayerGroupAll(), false);
    if (g_phase != 0) {
        return;
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_pmPick[p]) {
            continue;
        }
        if (p == g_teller) {
            if (g_started || g_dealConfirmed) {
                DialogControlSetVisible(g_grimShare, PlayerGroupSingle(p), true);
            }
            continue;
        }
        if (g_started && g_seatOn[BOTC_PosOf(p)]) {
            DialogControlSetVisible(g_grimShare, PlayerGroupSingle(p), true);
        }
    }
}

// 一键把自己那份魔典的标注发到当前私聊。
// 【只能私聊】（用户 2026-10-22）：公聊状态下直接拒绝，绝不把魔典内容发到公屏。
void BOTC_ShareGrim (int p) {
    int q;
    int s;
    int n;
    int batch;
    int sec;
    string roleText;
    string line;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_grimShareCd[p] > 0) {
        sec = (g_grimShareCd[p] + 1) / 2;
        BOTC_Notice(p, "【一键发送魔典】冷却中：还需" + IntToString(sec) + " 秒。");
        return;
    }
    if (g_chatSay[p] != 1) {
        BOTC_Notice(p, "【一键发送魔典】只能在私聊中发送：先切到【聊天：私聊】并进入一条私聊。");
        return;
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你现在不在私聊里：先发起或加入私聊，再发送魔典。");
        return;
    }
    if (g_chatMode == 2 && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，当前私聊不能发送；跟说书人的私聊除外。");
        return;
    }
    n = 0;
    batch = 0;
    line = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        roleText = BOTC_GrimShareRoleText(p, q);
        if (roleText == "") {
            continue;
        }
        roleText = IntToString(g_lab[q] + g_nameNumShift) + "：" + roleText;
        if (line == "") {
            line = roleText;
        }
        else {
            line = line + "；" + roleText;
        }
        n = n + 1;
        batch = batch + 1;
        if (batch == 4) {
            BOTC_SayPmText(p, line);
            line = "";
            batch = 0;
        }
    }
    if (batch > 0) {
        BOTC_SayPmText(p, line);
    }
    if (n > 0) {
        g_grimShareCd[p] = 30;
    }
    else {
        BOTC_Notice(p, "你的魔典上还没有可发送的身份或标注。");
    }
}

// 【一键发送魔典 · 独立冷却】每拍 0.5 秒，每个物理玩家单独计时。
void BOTC_GrimShareCdTick () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (g_grimShareCd[p] > 0) {
            g_grimShareCd[p] = g_grimShareCd[p] - 1;
        }
    }
}
void BOTC_RequestChat (int p, int q) {
    BOTC_SessRepair();
    // 【夜晚】（用户 2026-09-20）：玩家不能主动找人私聊 ---- 会打断说书人正在进行的私聊；
    //   夜里要聊，一律由说书人自己发起。
    if (g_isNight && p != g_teller) {
        BOTC_Notice(p, "现在是夜晚：不能主动找人私聊，等说书人来找你。");
        return;
    }
    // 发言时段限制（跟 BOTC_SendPm 同一套）：
    //   ① 公聊时间不许发起私聊 ---- 但**跟说书人（玩家1）的私聊是破例允许的**（用户 2026-09-16 明确）；
    //   ② 提名环节进行中不发新的私聊请求（跟「提名时不能私聊」保持一致）。
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && q != g_teller) {
        BOTC_Notice(p, "现在是公聊时间，先别私聊；等私聊时间再单独找人聊（找说书人是可以的）。");
        return;
    }
    if (g_phase != 0 && !g_cultOn && p != g_teller && q != g_teller) {
        BOTC_Notice(p, "提名环节进行中，暂时不能和别人发起私聊（找说书人可以）。");
        return;
    }
    if (q == p) {
        BOTC_Notice(p, "不能和自己私聊。");
        return;
    }
    if (p == g_teller) {
        if (g_mySess[q] != 0) {
            BOTC_JoinSess(g_teller, g_mySess[q]);
            return;
        }
        BOTC_CreateSess(g_teller, q);
        return;
    }
    if (q == g_teller) {
        if (g_mySess[g_teller] != 0) {
            // 说书人正在私聊：走统一加入请求，不再让发起者停在无按钮的提示上。
            BOTC_Notice(g_teller, BOTC_NameStr(BOTC_PosOf(p)) + " 想与你私聊。");
            BOTC_RequestJoinSess(p, g_mySess[g_teller]);
            return;
        }
        BOTC_CreateSess(p, g_teller);
        return;
    }
    if (g_mySess[q] != 0) {
        // 对方已经在私聊里：向他当前所在会话发出加入请求（与私聊可见性开关无关）。
        BOTC_RequestJoinSess(p, g_mySess[q]);
        return;
    }
    g_reqFrom[q] = p;
    BOTC_ShowReq(q, BOTC_NameStr(BOTC_PosOf(p)) + " 请求与你私聊，是否同意？");
    BOTC_Notice(p, "已向 " + BOTC_NameStr(BOTC_PosOf(q)) + " 发出私聊请求，等待对方同意。");
    BOTC_PlaySfxTo(g_sfxReqName, q);   // UI 音效：有人向你发私聊请求（只给收件人听）
}

void BOTC_CreateSess (int a, int b) {
    int s;
    int i;
    BOTC_SessRepair();
    BOTC_ForceLeave(a);
    BOTC_ForceLeave(b);
    s = 0;
    for (i = 1; i <= 13; i += 1) {
        if (!g_sessAlive[i]) {
            s = i;
            break;
        }
    }
    if (s == 0) {
        BOTC_Notice(a, "当前私聊数量已达上限。");
        return;
    }
    g_sessAlive[s] = true;
    g_sessOwner[s] = a;
    g_member[(s * 14) + a] = true;
    g_member[(s * 14) + b] = true;
    g_mySess[a] = s;
    g_mySess[b] = s;
    g_joinPending[s] = false;
    // 建立私聊：两边都自动进入私聊模式（说书人也一样，用户 2026-09-30）
    g_chatSay[a] = 1;
    BOTC_SayRender(a);
    g_chatSay[b] = 1;
    BOTC_SayRender(b);

    BOTC_NoticeKeep(a, "已与 " + BOTC_NameStr(BOTC_PosOf(b)) + " 建立私聊。");
    BOTC_NoticeKeep(b, "已与 " + BOTC_NameStr(BOTC_PosOf(a)) + " 建立私聊。");
    // UI 音效：私聊建立（两边各听一声）
    BOTC_PlaySfxTo(g_sfxPmOnName, a);
    BOTC_PlaySfxTo(g_sfxPmOnName, b);
    BOTC_RefreshSessListAll();
}

void BOTC_JoinSess (int who, int s) {
    int i;
    if (who < 1 || who > 13) {
        return;
    }
    if (s < 1 || s > 13) {
        return;
    }
    if (!g_sessAlive[s]) {
        BOTC_Notice(who, "该私聊已经结束了。");
        return;
    }
    if (g_member[(s * 14) + who]) {
        BOTC_Notice(who, "你已经在这个私聊里。");
        return;
    }
    BOTC_ForceLeave(who);
    g_member[(s * 14) + who] = true;
    g_mySess[who] = s;
    // 加入私聊：自动进入私聊模式（说书人也一样，用户 2026-09-30）
    g_chatSay[who] = 1;
    BOTC_SayRender(who);
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(who)) + " 加入了私聊。");
            BOTC_PlaySfxTo(g_sfxPmOnName, i);      // 有人加入私聊：会话里所有人各听一声
        }
    }
    BOTC_RefreshSessListAll();
}

// 【邀请加入私聊】（用户 2026-10-10）：说书人加入某条私聊之后，私聊面板右下角出现【邀请加入】；
//   点它 → 再点一个玩家的座位 = **直接把他拉进这条私聊**（不用对方同意，跟【请求加入】那套不一样）。
void BOTC_InviteRender (int p) {
    bool on;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_inviteBtn[p] == 0) {
        return;
    }
    on = false;
    if (p == g_teller && g_mySess[g_teller] >= 1 && g_mySess[g_teller] <= 13 && g_sessAlive[g_mySess[g_teller]]) {
        on = true;
    }
    if (on == g_inviteOn[p]) {
        return;                    // 状态没变就别反复设置控件（免得闪）
    }
    g_inviteOn[p] = on;
    DialogControlSetVisible(g_inviteBtn[p], PlayerGroupSingle(p), on);
}

void BOTC_InviteStart (int p) {
    if (p != g_teller) {
        return;
    }
    if (g_mySess[g_teller] < 1 || g_mySess[g_teller] > 13 || !g_sessAlive[g_mySess[g_teller]]) {
        BOTC_Notice(g_teller, "你现在不在私聊里：先加入一条私聊，再点【邀请加入】。");
        return;
    }
    if (g_invitePick) {
        g_invitePick = false;
        BOTC_BigHintHide(g_teller);
        BOTC_Notice(g_teller, "取消【邀请加入】。");
        return;
    }
    g_invitePick = true;
    BOTC_Notice(g_teller, "【邀请加入】：点一个玩家的座位，把他拉进现在的私聊。");
    BOTC_BigHintShow(1, "点一个玩家的座位 → 把他拉进现在的私聊。");
}

void BOTC_InviteAt (int q) {
    int s;
    g_invitePick = false;
    BOTC_BigHintHide(g_teller);
    if (q < 2 || q > 13) {
        return;
    }
    s = g_mySess[g_teller];
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        BOTC_Notice(g_teller, "这条私聊已经结束了。");
        return;
    }
    BOTC_JoinSess(g_who[q], s);
}
// 【解散私聊】（用户 2026-10-10）：说书人把**他当前所在的**这条私聊整个收掉 —— 会话里所有人都被请出去。
void BOTC_SessDissolve (int s) {
    int i;
    if (s < 1 || s > 13) {
        return;
    }
    if (!g_sessAlive[s]) {
        return;
    }
    for (i = 1; i <= 13; i += 1) {
        if (!g_member[(s * 14) + i]) {
            continue;
        }
        g_member[(s * 14) + i] = false;
        g_mySess[i] = 0;
        // 【解散也不自动切回公聊】（用户 2026-10-10）：跟【退出私聊】同一条口径
        BOTC_SayRender(i);
        BOTC_Notice(i, "这条私聊已被说书人解散。");
    }
    g_sessAlive[s] = false;
    g_joinPending[s] = false;
    g_joinWho[s] = 0;
    g_sessOwner[s] = 0;
    if (s == g_lmSess) {
        g_lmSess = 0;              // 【小怪宝恶人频道】解散了：号清掉，免得被下一条私聊复用（用户 2026-10-12）
    }
    BOTC_PmStore(g_teller, "【私聊】你解散了当前这条私聊。");
    BOTC_RefreshSessListAll();
}

void BOTC_DissolveStart (int p) {
    int s;
    if (p != g_teller) {
        return;
    }
    s = g_mySess[g_teller];
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        BOTC_Notice(g_teller, "你现在不在私聊里。");
        return;
    }
    g_invitePick = false;                 // 顺手退出「邀请加入」的选人模式
    BOTC_BigHintHide(g_teller);
    BOTC_SessDissolve(s);
}

void BOTC_DissolveRender (int p) {
    bool on;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_dissolveBtn[p] == 0) {
        return;
    }
    on = false;
    if (p == g_teller && g_mySess[g_teller] >= 1 && g_mySess[g_teller] <= 13 && g_sessAlive[g_mySess[g_teller]]) {
        on = true;
    }
    if (on == g_dissolveOn[p]) {
        return;
    }
    g_dissolveOn[p] = on;
    DialogControlSetVisible(g_dissolveBtn[p], PlayerGroupSingle(p), on);
}
void BOTC_CloseSessIfAlone (int s) {
    int i;
    int cnt;
    if (s < 1 || s > 13) {
        return;
    }
    cnt = 0;
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            cnt = cnt + 1;
        }
    }
    if (cnt <= 1) {
        for (i = 1; i <= 13; i += 1) {
            if (g_member[(s * 14) + i]) {
                g_member[(s * 14) + i] = false;
                g_mySess[i] = 0;
                // 【私聊结束也不切公聊】（用户 2026-10-16）：保持每个人当前那个模式，按钮文案也保持「聊天：私聊」
                libNtve_gf_SetDialogItemText(g_sayBtnP[i], StringToText("聊天：私聊"), PlayerGroupSingle(i));
                BOTC_Notice(i, "私聊已结束。");
            }
        }
        g_sessAlive[s] = false;
        g_joinPending[s] = false;
        g_joinWho[s] = 0;
        if (s == g_lmSess) {
            g_lmSess = 0;          // 【小怪宝恶人频道】没人了自动关：号清掉（用户 2026-10-12）
        }
    }
}

void BOTC_SessRepair () {
    int s;
    int p;
    bool any;
    for (s = 0; s <= 13; s += 1) {
        any = false;
        for (p = 0; p <= 13; p += 1) {
            if (g_member[(s * 14) + p]) {
                if (p < 1 || p > 13 || g_mySess[p] != s) {
                    g_member[(s * 14) + p] = false;
                }
                else {
                    any = true;
                }
            }
        }
        if (!any && g_sessAlive[s]) {
            g_sessAlive[s] = false;
            g_joinPending[s] = false;
            g_joinWho[s] = 0;
        }
    }
    for (p = 1; p <= 13; p += 1) {
        s = g_mySess[p];
        if (s < 1 || s > 13 || !g_sessAlive[s]) {
            g_mySess[p] = 0;
        }
    }
    for (s = 1; s <= 13; s += 1) {
        if (!g_sessAlive[s]) {
            continue;
        }
        for (p = 1; p <= 13; p += 1) {
            if (g_mySess[p] == s) {
                g_member[(s * 14) + p] = true;
            }
        }
    }
    for (s = 1; s <= 13; s += 1) {
        if (g_sessAlive[s]) {
            BOTC_CloseSessIfAlone(s);
        }
    }
    BOTC_RefreshSessListAll();
}

void BOTC_Leave (int p) {
    int s;
    int i;
    s = g_mySess[p];
    if (s == 0) {
        for (i = 1; i <= 13; i += 1) {
            if (g_member[(i * 14) + p]) {
                g_member[(i * 14) + p] = false;
                BOTC_CloseSessIfAlone(i);
            }
        }
        // 【退出私聊不再自动切回公聊】（用户 2026-10-10）：聊天模式是玩家自己选的，脚本不替他切
        BOTC_SayRender(p);
        BOTC_Notice(p, "你当前不在私聊中（已帮你清掉残留状态）。");
        if (!g_bulkLeave) {
            BOTC_RefreshSessListAll();
        }
        return;
    }
    g_member[(s * 14) + p] = false;
    g_mySess[p] = 0;
    // 【退出私聊不再自动切回公聊】（用户 2026-10-10）：保持他当前选的那个模式
    BOTC_SayRender(p);
    BOTC_Notice(p, "你退出了私聊。");

    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(p)) + " 退出了私聊。");
        }
    }
    BOTC_CloseSessIfAlone(s);
    if (!g_bulkLeave) {                  // 【批量退出时先别刷，外面统一刷一次】（用户 2026-10-19：进提名/入夜会卡一下）
        BOTC_RefreshSessListAll();
    }
}

void BOTC_ForceLeave (int p) {
    if (g_mySess[p] != 0) {
        BOTC_Leave(p);
    }
}

//--------------------------------------------------------------------------------------------------
// 请求应答
//--------------------------------------------------------------------------------------------------
void BOTC_OnYes (int p) {
    int from;
    if (g_reqJoinSess[p] != 0) {
        BOTC_VoteJoin(p, true);
        return;
    }
    from = g_reqFrom[p];
    if (from == 0) {
        return;
    }
    g_reqFrom[p] = 0;
    BOTC_ClearReq(p);
    if (g_mySess[from] != 0) {
        BOTC_AppendPm(p, BOTC_NameStr(BOTC_PosOf(from)) + " 已经进入其他私聊。");
        return;
    }
    BOTC_CreateSess(from, p);
}

void BOTC_OnNo (int p) {
    int from;
    if (g_reqJoinSess[p] != 0) {
        BOTC_VoteJoin(p, false);
        return;
    }
    from = g_reqFrom[p];
    if (from == 0) {
        return;
    }
    g_reqFrom[p] = 0;
    BOTC_ClearReq(p);
    BOTC_AppendPm(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了你的私聊请求。");
}

//--------------------------------------------------------------------------------------------------
// 加入私聊（全体成员同意 / 说书人单独私聊时由说书人一个人拍板）
//--------------------------------------------------------------------------------------------------
// 这条私聊是不是「说书人跟某一名玩家单独私聊」：成员正好两个、其中一个是说书人。
//   用户 2026-09-17：这种私聊里别人要加入，**只需要说书人本人同意**；
//   说书人「介入」玩家之间的私聊（3 人以上）不算，那种还是走原来的「全体成员同意」。
bool BOTC_SessStSolo (int s) {
    int i;
    int cnt;
    if (s < 1 || s > 13) {
        return false;
    }
    if (!g_sessAlive[s]) {
        return false;
    }
    if (!g_member[(s * 14) + g_teller]) {
        return false;
    }
    cnt = 0;
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            cnt = cnt + 1;
        }
    }
    if (cnt != 2) {
        return false;
    }
    return true;
}

void BOTC_RequestJoin (int p) {
    int sel;
    int s;
    BOTC_SessRepair();
    sel = DialogControlGetSelectedItem(g_sessList[p], p);
    if (sel < 1) {
        BOTC_Notice(p, "请先在列表里选择一个进行中的私聊。");
        return;
    }
    s = g_listSess[(p * 14) + sel];
    if (s < 1 || s > 13) {
        BOTC_Notice(p, "请重新选择列表里的私聊。");
        BOTC_RefreshSessList(p);
        return;
    }
    BOTC_RequestJoinSess(p, s);
}

// 发起者 p 请求加入会话 s。列表按钮和「点一个正在私聊的人发起私聊」共用这一条路径。
void BOTC_RequestJoinSess (int p, int s) {
    int i;
    int who2;
    BOTC_SessRepair();
    if (p < 1 || p > 13) {
        return;
    }
    if (g_mySess[p] != 0) {
        BOTC_Notice(p, "你正在私聊中，请先退出。");
        return;
    }
    if (s < 1 || s > 13) {
        BOTC_Notice(p, "请重新选择要加入的私聊。");
        return;
    }
    if (!g_sessAlive[s]) {
        BOTC_Notice(p, "该私聊已经结束。");
        BOTC_RefreshSessList(p);
        return;
    }
    // 发言时段限制：公聊时间不能加入私聊（说书人本人、以及**含说书人的私聊**除外 ---- 跟发起私聊同一套破例）
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，不能加入私聊（跟说书人的私聊除外）。");
        return;
    }
    if (g_member[(s * 14) + p]) {
        BOTC_Notice(p, "你已经在这个私聊里。");
        return;
    }
    // 【说书人介入私聊】（用户 2026-09-22）：说书人进任何私聊都不用成员同意，直接进去 ----
    //   以前走的是下面那套「全体成员同意」，玩家不点【是】就永远进不去。
    if (p == g_teller) {
        BOTC_ForceLeave(g_teller);
        g_joinPending[s] = true;
        g_joinWho[s] = g_teller;
        BOTC_FinishJoin(s);
        return;
    }
    if (g_joinPending[s]) {
        BOTC_Notice(p, "该私聊正在处理另一个加入请求，请稍后再试。");
        return;
    }
    // 【说书人跟某名玩家单独私聊】时，别人要加入**只问说书人一个人**（用户 2026-09-17 要求）：
    //   说书人「介入」别人私聊（3 人以上）不算，那种还是走下面的「全体成员同意」
    if (p != g_teller && BOTC_SessStSolo(s)) {
        who2 = 0;
        for (i = 2; i <= 13; i += 1) {
            if (g_member[(s * 14) + i]) {
                who2 = i;
            }
        }
        g_joinPending[s] = true;
        g_joinWho[s] = p;
        for (i = 1; i <= 13; i += 1) {
            g_joinVote[(s * 14) + i] = false;
        }
        g_reqJoinSess[g_teller] = s;
        g_reqJoinWho[g_teller] = p;
        BOTC_ShowReq(g_teller, BOTC_NameStr(BOTC_PosOf(p)) + " 请求加入你和 " + BOTC_NameStr(BOTC_PosOf(who2)) + " 的私聊，是否同意？");
        BOTC_PlaySfxTo(g_sfxReqName, g_teller);
        BOTC_Notice(who2, BOTC_NameStr(BOTC_PosOf(p)) + " 想与你私聊，已向说书人发出加入你们私聊的请求。");
        BOTC_Notice(p, "已向说书人发出加入请求，等说书人同意。");
        return;
    }
    g_joinPending[s] = true;
    g_joinWho[s] = p;
    for (i = 1; i <= 13; i += 1) {
        g_joinVote[(s * 14) + i] = false;
    }
    for (i = 1; i <= 13; i += 1) {
        // 【说书人不参与"同意/拒绝"】（用户 2026-09-30）：说书人介入的私聊里，别人要进只由**玩家**表决
        if (g_member[(s * 14) + i] && i != 1) {
            g_reqJoinSess[i] = s;
            g_reqJoinWho[i] = p;
            BOTC_ShowReq(i, BOTC_NameStr(BOTC_PosOf(p)) + " 请求加入你们的私聊，是否同意？");
            BOTC_PlaySfxTo(g_sfxReqName, i);       // UI 音效：有人向你发（加入）私聊请求
        }
    }
    BOTC_Notice(p, "已向私聊成员发出加入请求。");
}

void BOTC_VoteJoin (int p, bool yes) {
    int s;
    int i;
    int need;
    bool all;
    s = g_reqJoinSess[p];
    g_reqJoinSess[p] = 0;
    BOTC_ClearReq(p);
    if (s == 0 || !g_joinPending[s]) {
        return;
    }
    if (!yes) {
        BOTC_RejectJoin(s);
        return;
    }
    // 【说书人跟某名玩家单独私聊】：说书人一个人点【是】就算数（用户 2026-09-17）
    if (p == g_teller && BOTC_SessStSolo(s)) {
        BOTC_FinishJoin(s);
        return;
    }
    g_joinVote[(s * 14) + p] = true;
    need = 0;
    all = true;
    // 从 2 起数：说书人不参与表决（用户 2026-09-30）—— 他在私聊里也不用点同意/拒绝
    for (i = 2; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            need = need + 1;
            if (!g_joinVote[(s * 14) + i]) {
                all = false;
            }
        }
    }
    if (all && need >= 1) {
        BOTC_FinishJoin(s);
    }
}

void BOTC_FinishJoin (int s) {
    int who;
    int i;
    who = g_joinWho[s];
    g_joinPending[s] = false;
    if (who < 1 || who > 13) {
        return;
    }
    if (g_mySess[who] != 0) {
        BOTC_Notice(who, "你已经在其他私聊里，加入请求已取消。");
        return;
    }
    g_member[(s * 14) + who] = true;
    g_mySess[who] = s;
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(who)) + " 加入了私聊。");
            g_reqJoinSess[i] = 0;
            BOTC_ClearReq(i);
        }
    }
    BOTC_RefreshSessListAll();
}

void BOTC_RejectJoin (int s) {
    int who;
    int i;
    who = g_joinWho[s];
    g_joinPending[s] = false;
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            g_reqJoinSess[i] = 0;
            BOTC_ClearReq(i);
        }
    }
    if (who >= 1 && who <= 13) {
        BOTC_Notice(who, "加入私聊的请求被拒绝了。");
    }
}

//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// 邪恶小窗（用户 2026-09-17）
//   · 说书人点右上角的【邪恶小窗：关】→ 开，再点一下（或入夜）自动关
//   · 开的时候把所有**邪恶阵营**（真身是爪牙 / 恶魔）拉进来；他们右边会多出一个框
//   · 在里面打字 = 一条小窗记录：只显示在小窗自己的记录里
//   · 只能在「正式开局之后的白天」开；夜里自动关
//--------------------------------------------------------------------------------------------------
// 这个座位是不是邪恶阵营（真身是爪牙 / 恶魔；酒鬼 / 陌客 / 圣徒都是善良）
bool BOTC_SeatIsEvil (int q) {
    int r;
    if (q < 2 || q > 13) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return false;
    }
    if (BOTC_RoleTeam(r) >= 2) {
        return true;
    }
    return false;
}

// 往小窗记录里追加一行（只留最后 200 条）
void BOTC_EvilAppend (string s) {
    int i;
    if (g_evilCount >= 200) {
        for (i = 0; i < 199; i += 1) {
            g_evilLog[i] = g_evilLog[i + 1];
        }
        g_evilLog[199] = s;
    }
    else {
        g_evilLog[g_evilCount] = s;
        g_evilCount = g_evilCount + 1;
    }
    if (g_evilOn) {
        BOTC_EvilRender();
    }
}

// 刷新小窗：谁看得到 + 列表内容（自动滚到最下面那条）
void BOTC_EvilRender () {
    int i;
    int k;
    if (g_evilDlg == 0) {
        return;
    }
    for (k = 1; k <= 13; k += 1) {
        if (g_evilOn && g_evilIn[k] && !g_isNight) {
            DialogSetVisible(g_evilDlg, PlayerGroupSingle(k), true);
        }
        else {
            DialogSetVisible(g_evilDlg, PlayerGroupSingle(k), false);
        }
    }
    if (!g_evilOn) {
        return;
    }
    // 可滚动列表：把存着的记录全铺进去（名字换成真名），再滚到最下面那条
    DialogControlRemoveAllItems(g_evilList, PlayerGroupAll());
    for (i = 0; i < g_evilCount; i += 1) {
        DialogControlAddItem(g_evilList, PlayerGroupAll(), BOTC_LineText(g_evilLog[i], 0));
    }
    if (g_evilCount > 0) {
        DialogControlSelectItem(g_evilList, PlayerGroupAll(), g_evilCount - 1);
    }
}

// 说书人那个按钮上的字
void BOTC_EvilBtnRender () {
    if (g_evilBtn == 0) {
        return;
    }
    if (g_evilOn) {
        libNtve_gf_SetDialogItemText(g_evilBtn, StringToText("邪恶小窗：开"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_evilBtn, StringToText("邪恶小窗：关"), PlayerGroupSingle(g_teller));
    }
}

// 开小窗：把所有邪恶阵营拉进来
void BOTC_EvilOpen () {
    int k;
    if (!g_evilEnable) {
        return;                        // 【邪恶小窗已彻底关闭】用户 2026-09-19
    }
    if (g_evilOn) {
        return;
    }
    g_evilOn = true;
    g_evilCount = 0;
    for (k = 1; k <= 13; k += 1) {
        g_evilIn[k] = false;
    }
    g_evilIn[g_teller] = true;                // 说书人自己也在小窗里（用户 2026-09-17）
    for (k = 2; k <= 13; k += 1) {
        if (BOTC_SeatIsEvil(k)) {
            g_evilIn[g_who[k]] = true;
        }
    }
    BOTC_EvilAppend("[私聊] 邪恶小窗：开启");
    BOTC_EvilRender();
    BOTC_SubMsg(g_teller, "【邪恶小窗】已开：你和邪恶阵营都能在右边那个框里说话。");
    for (k = 2; k <= 13; k += 1) {
        if (g_evilIn[k]) {
            BOTC_SubMsg(k, "说书人开了【邪恶小窗】：在右边那个框里打字，只有邪恶阵营（和说书人）看得到。");
        }
    }
    // ⚠ 这里**不写普通私聊记录**：小窗内容只留在邪恶小窗自己的记录里。
    BOTC_EvilBtnRender();
    BOTC_EvilBtnRender();
}

// 关小窗（说书人手动关 / 入夜自动关）
void BOTC_EvilClose () {
    int k;
    if (!g_evilOn) {
        return;
    }
    g_evilOn = false;
    BOTC_EvilRender();               // 先把每个人那边的框收掉
    for (k = 1; k <= 13; k += 1) {
        if (g_evilIn[k]) {
            if (k != 1) {
                BOTC_SubMsg(k, "【邪恶小窗】已关闭。");
            }
            g_evilIn[k] = false;
        }
    }
    // ⚠ 同样不写普通私聊记录。
    BOTC_EvilBtnRender();
}

// 说书人点【邪恶小窗】那个按钮
void BOTC_EvilToggle () {
    if (g_evilOn) {
        BOTC_EvilClose();
        return;
    }
    if (!g_started) {
        BOTC_Notice(g_teller, "还没正式开始：邪恶小窗要等游戏正式开始之后的白天才能开。");
        return;
    }
    if (g_isNight) {
        BOTC_Notice(g_teller, "现在是夜晚：邪恶小窗只能在白天开（夜里会自动关）。");
        return;
    }
    BOTC_EvilOpen();
}

// 在小窗里说一句话：只发给小窗里的人，日志里按「私聊」记
void BOTC_EvilSend (int p) {
    string msg;
    string line;
    int i;
    playergroup pg;
    if (!g_evilOn || !g_evilIn[p]) {
        BOTC_Notice(p, "你现在不在邪恶小窗里。");
        return;
    }
    if (g_isNight) {
        BOTC_Notice(p, "邪恶小窗夜里是关着的。");
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_evilEdit, p);
    if (StringLength(msg) == 0) {
        return;
    }
    line = "[私聊] " + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);    // 这一行是谁说的（渲染时名字按他的颜色显示）
    for (i = 1; i <= 13; i += 1) {
        if (g_evilIn[i]) {
            // ⚠ **不写进私聊记录**（用户 2026-09-17：小窗内容别出现在左边的私聊框里），只弹一下提示
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText("[私聊] ") + TextWithColor(PlayerName(p), BOTC_SayColor(p)) + StringToText(": " + msg));

    BOTC_EvilAppend(line);
    libNtve_gf_SetDialogItemText(g_evilEdit, StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_evilEdit, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_evilEdit, PlayerGroupSingle(p), true);
}

// 建小窗本体（挂在屏幕右侧，只给邪恶阵营看）
void BOTC_BuildEvil () {
    // 贴在**屏幕最右边**（用右上角锚点，跟右上角那几个按钮排在同一列），输入框压在窗口**最下面**
    //   2026-09-19：记录改成跟日志一样的**可滚动列表框**；高度减半（560 -> 280）、整体再往下挪 200
    DialogCreate(400, 280, c_anchorTopRight, 10, 600, false);
    g_evilDlg = DialogLastCreated();
    DialogSetVisible(g_evilDlg, PlayerGroupAll(), false);
    g_evilTitle = BOTC_NewLabel(g_evilDlg, 400, 26, 4, 2, StringToText("邪恶小窗（只有邪恶阵营看得到）"));
    libNtve_gf_SetDialogItemStyle(g_evilTitle, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_evilTitle, false, PlayerGroupAll());
    g_evilList = BOTC_NewList(g_evilDlg, 392, 206, 4, 30);
    // 邪恶小窗的输入框 + 发送按钮撤掉（用户 2026-09-19）：改用顶部那个聊天开关 + 回车
    g_evilEdit = BOTC_NewEdit(g_evilDlg, 300, 34, 4, 240);
    DialogControlSetVisible(g_evilEdit, PlayerGroupAll(), false);
    g_evilSend = BOTC_NewButton(g_evilDlg, 88, 34, 308, 240, "发送");
    g_evilCount = 0;
    g_evilOn = false;
}

//--------------------------------------------------------------------------------------------------
void BOTC_ToggleHide (int p) {
    g_hidden[p] = !g_hidden[p];
    if (g_hidden[p]) {
        DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), false);
        DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), true);
    }
    else {
        DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), false);
        DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), true);
    }
}

//--------------------------------------------------------------------------------------------------
// 打 token 的点击（＋ 开面板 / 面板里 20 个按钮 / 清除全部 / 关闭）
//   用户 2026-09-17：这一套在**提名阶段也要能用**（玩家也能在魔典上打 token），所以抽成函数两处共用。
//--------------------------------------------------------------------------------------------------
bool BOTC_TokClick (int p, int c) {
    int q;
    if (c == g_tokClose) {
        DialogSetVisible(g_tokDlg, PlayerGroupSingle(p), false);
        return true;
    }
    if (c == g_tokClear) {
        BOTC_TokClearAll(p);
        return true;
    }
    if (c == g_tokPrev) {
        if (g_tokPage[p] > 1) {
            g_tokPage[p] = g_tokPage[p] - 1;
        }
        BOTC_TokRender(p);
        return true;
    }
    if (c == g_tokNext) {
        g_tokPage[p] = g_tokPage[p] + 1;      // 越界由 BOTC_TokRender 夹回来
        BOTC_TokRender(p);
        return true;
    }
    for (q = 0; q < 256; q += 1) {             // 表扩到 256：新加的 token 也要能手动打
        if (c == g_tokBtn[q]) {
            BOTC_TokToggle(p, q);
            return true;
        }
    }
    // 【说书人给自己打 token】（用户 2026-09-26）：说书人那一格右边的 ＋
    if (p == g_teller && c == g_sayTokBtn) {
        BOTC_TokOpen(g_teller, 1);     // 【面板开给说书人】（用户 2026-10-11：原来写死 1）
        return true;
    }
    for (q = 2; q <= 13; q += 1) {
        if (c == g_grimTokBtn[q]) {
            BOTC_TokOpen(p, q);
            return true;
        }
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// 事件
//--------------------------------------------------------------------------------------------------
bool BOTC_ClickDo (bool testConds, bool runActions) {
    int p;
    int c;
    int q;
    p = EventPlayer();
    c = EventDialogControl();
    if (!runActions) {
        return true;
    }
    if (p < 1 || p > 13) {
        return true;
    }
    // 【多重能力】只属于手动唤醒界面的独立按钮，和魔典身份网格完全分离。
    for (q = 0; q < 6; q += 1) {
        if (c == g_wakeChoiceBtn[q]) {
            if (p == g_teller) {
                BOTC_WakeAbilityChoicePick(q);
            }
            return true;
        }
    }
    if (c == g_wakeChoiceCancel) {
        if (p == g_teller) {
            BOTC_WakeAbilityChoiceCancel();
        }
        return true;
    }
    // 玩家1 真的在点界面 → 他百分之百是真人（电脑不会点）。
    //   万一「玩家类型」那个原生函数判错了、把真人说书当成电脑，这里立刻纠回手动说书；
    //   用聊天里的「AI」强制开启智能说书时不走这一步（那条由 g_p1ForceComputer 顶着）。
    // 胜负横幅上的【继续】：说书人点一下收掉（不收游戏自带结束画面，收完就能开下一把）
    if (c == g_winBtn) {
        if (p == g_teller) {
            BOTC_WinClose();
        }
        return true;
    }
    // 胜负面板上的【复盘】：说书人把自己的魔典（含 token）公开给全场
    if (c == g_replayBtn) {
        if (p == g_teller) {
            BOTC_ReplayReveal();
        }
        return true;
    }
    // 传位面板：说书人点一名爪牙 → 他变成新的恶魔（跟死掉的那只同一种）
    for (q = 0; q < 12; q += 1) {
        if (c == g_promBtn[q]) {
            if (p == g_teller) {
                if (g_promSeat[q] >= 2) {
                    BOTC_PromoteTo(g_promSeat[q]);
                    BOTC_PromoteHide();
                    g_promoteOpen = false;
                    BOTC_Notice(g_teller, "已传位：" + BOTC_NameStr(g_promSeat[q]) + " 变成了新的" + g_roleName[g_demonKind] + "。");
                }
            }
            return true;
        }
    }
    if (c == g_promClose) {
        if (p == g_teller) {
            BOTC_PromoteHide();
            BOTC_Notice(g_teller, "已收起传位面板（也可以用【魔典】点座位自己改身份）。");
        }
        return true;
    }
    if (p == g_teller && g_wakeMode) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_WakeManualAt(q);
                return true;
            }
        }
    }
    if (p == g_teller && g_bluffPickSeat) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_BluffSendAt(q);
                return true;
            }
        }
    }
    // 【投票踢人】（用户 2026-10-02）：正在 -kick 选人 → 点座位 = 对他发起踢出投票
    //   （点「说书人」那一格 = 对说书人本人发起）
    // 【换座位 · 正式版】（用户 2026-10-07）：点了按钮之后点一格 = 向那一格的人发请求
    if (g_askPick[p]) {
        for (q = 1; q <= 13; q += 1) {
            if (q == 1) {
                if (c != g_saySeatBtn && c != g_saySeatLbl) {
                    continue;
                }
            }
            else {
                if (c != g_grimSeat[q]) {
                    continue;
                }
            }
            BOTC_SeatAskSend(p, q);
            return true;
        }
    }
    // 请求框上的【同意】/【拒绝】
    if (c == g_askYes) {
        BOTC_SeatAskAnswer(p, true);
        return true;
    }
    if (c == g_askNo) {
        BOTC_SeatAskAnswer(p, false);
        return true;
    }
    // 【测试·换座位】（用户 2026-10-07）：点两格 = 互换这两个座位（**可以点「说书人」那一格**）
    if (g_swapPickBy == p) {
        // 【确认发放之后不许再换】（用户 2026-10-11）：按钮虽然收掉了，已经进入选人状态的还能点 →
        //   这里再兜一道：说书人确认发放过（而且没解锁）就直接取消这一按。
        if (g_dealConfirmed && !g_swapUnlocked) {
            g_swapPickBy = 0;
            g_swapFirst = 0;
            BOTC_Notice(p, "说书人已经【确认发放】身份了：换座位已关闭，这一按取消了。");
            return true;
        }
        for (q = 1; q <= 13; q += 1) {
            if (q == 1) {
                if (c != g_saySeatBtn && c != g_saySeatLbl) {
                    continue;
                }
            }
            else {
                if (c != g_grimSeat[q]) {
                    continue;
                }
            }
            if (g_swapFirst == 0) {
                g_swapFirst = q;
                BOTC_Notice(p, "已选 " + BOTC_NameStr(q) + "（" + BOTC_SeatRoleStr(q) + "），再点第二个座位。");
            }
            else if (g_swapFirst == q) {
                BOTC_Notice(p, "不能选同一个，换一个。");
            }
            else {
                BOTC_SeatSwap(g_swapFirst, q);
                g_swapFirst = 0;
                g_swapPickBy = 0;
            }
            return true;
        }
    }
    // 【换说书人】（用户 2026-10-06）：正在选新说书人 → 点一个座位 = 他成为新说书人
    if (g_tellerPick == p) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_TellerHandover(p, q);
                return true;
            }
        }
    }
    if (g_kickMode == p) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_KickStart(p, q);
                return true;
            }
        }
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            BOTC_KickStart(p, 1);
            return true;
        }
    }
    // 【投票踢人】的两个按钮：谁都能点，但说书人 / 被踢的人那份本来就是隐藏的（点了也不生效）
    if (c == g_kickYes) {
        BOTC_KickCast(p, 1);
        return true;
    }
    if (c == g_kickNo) {
        BOTC_KickCast(p, 0);
        return true;
    }
    // 炸弹人 10 秒指向投票：所有在座参与者点一个座位，倒计时结束前可随时改选。
    if (g_boomVoteOn) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_BoomVotePick(p, q);
                return true;
            }
        }
    }
    // 占卜师正在验人：点座位优先当成选人
    if (p >= 2 && p <= 13) {
        if (g_ftPick[p]) {
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_FtPick(p, q);
                    return true;
                }
            }
        }
    }
    // 玩家正在为技能选目标：点座位优先当成选目标
    if (p >= 2 && p <= 13) {
        if (g_skillPicking[BOTC_PosOf(p)]) {
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_SkillPickSeat(BOTC_PosOf(p), q);
                    return true;
                }
            }
        }
    }
    // 【测试】说书人自己拿了身份、正在选技能目标：点魔典上的座位 = 选目标（用户 2026-09-20）
    if (p == g_teller && g_skillPicking[1]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_SkillPickSeat(1, q);
                return true;
            }
        }
    }
    // 【炼金术士 × 间谍/寡妇】：已经先选好间谍/寡妇，再点一名存活玩家 → 立即结算
    if (p >= 1 && p <= 13 && g_alcPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                if (!BOTC_TargetIsLiving(q)) {
                    BOTC_Notice(p, "目标已死亡，请重新选择。");
                }
                else {
                    g_alcPick[p] = false;
                    g_alcSeat = q;
                    g_alcBy = BOTC_PosOf(p);
                    BOTC_AlchemistGuess(g_alcBy, g_alcRolePick[p]);
                    g_alcRolePick[p] = 0;
                    BOTC_DeclareRender();
                }
                return true;
            }
        }
    }
    // 【猜落难】（82）：点头像 = 公开猜他是落难少女
    if (p >= 1 && p <= 13 && g_damselPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_DamselGuess(BOTC_PosOf(p), q);
                return true;
            }
        }
    }
    // 有人正在用【声称】选人（猎手那种）：点头像 = 发动
    if (p >= 1 && p <= 13) {
        if (g_declarePick[p]) {
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_DeclareSlay(BOTC_PosOf(p), q);
                    return true;
                }
            }
        }
    }
    // 有人正在用【发起私聊】选人：点魔典上的座位 = 向他发起私聊（点完就退出选人、魔典回正常状态）
    //   玩家还能点「说书人」那一格（说书人没有座位号）
    if (g_pmPick[p]) {
        // 【按格子点、按物理座位发起】（用户 2026-10-07）：魔典格子给的是**位置**，
        //   而私聊要按**物理座位**建会话 / 投递 → 统一换成 g_who[格子]（说书人格 = 现在的说书人 g_teller）。
        //   ⚠ 原来写死 `p >= 2`：换位之后"坐在物理座位 1 的老说书人"是普通玩家，点说书人格子点不动 ——
        //     现在改成"只要你不是当前说书人"就能点。
        if (p != g_teller && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_PmPickEnd(p);
            BOTC_RequestChat(p, g_teller);
            return true;
        }
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_PmPickEnd(p);
                BOTC_RequestChat(p, g_who[q]);
                return true;
            }
        }
    }
    // 【看某玩家】（用户 2026-09-22）：日志面板点了【看某玩家】之后，点魔典上的座位 = 切到这个人的视图
    if (g_logPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                g_logPick[p] = false;
                g_logMode[p] = 0;
                g_logViewWho[p] = q;
                BOTC_LogOpen(p);
                return true;
            }
        }
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            g_logPick[p] = false;
            BOTC_Notice(p, "看自己那一格不用切视图：直接点【我的私聊】就行。");
            return true;
        }
    }
    // 选板子期间：只认板子按钮和「本局设置」那几个按钮，其它点击一律忽略
    if (g_boardOpen) {
        if (p == g_teller) {
            if (c == g_fixMinus) {
                BOTC_BoardFixSeats(-1);
                return true;
            }
            if (c == g_fixPlus) {
                BOTC_BoardFixSeats(1);
                return true;
            }
            if (c == g_pmVisBtn) {
                BOTC_PmVisToggle();
                return true;
            }
        }
        // 【本局设置（投票）】智能说书模式才开：私聊时间 / 公聊时间 / 提名时间 / 第一天邪恶小窗
        for (q = 0; q < 12; q += 1) {
            if (c == g_boardBtn[q] || c == g_boardPic[q]) {
            BOTC_BoardPick(p, BOTC_BoardAtSlot(q));
                return true;
            }
        }
        // 【自定义剧本】那一层（用户 2026-10-03）：入口 / 分类 / 翻页 / 选人 / 保存 / 开始游戏都在这
        if (BOTC_CustomClick(p, c)) {
            return true;
        }
        return true;
    }
    // 镇长替死：说书人正在点座位选「替他死的人」（用户 2026-09-21）
    if (p == g_teller && g_mayorPick) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_MayorVictimAt(q);
                return true;
            }
        }
    }
    // 说书人正在标记处决 / 死亡：座位点击优先当作标记，不触发身份选择 / 提名
    if (p == g_teller && (g_execPick || g_deadPick)) {
        // 「说书人」那一格：处决标记 / 死亡标记模式下点它 = 标他自己（无神论者那条路）
        if (g_execPick && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_ExecToggleAt(1);
            return true;
        }
        if (g_deadPick && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_DeadToggleAt(1);
            return true;
        }
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                if (g_execPick) {
                    BOTC_ExecToggleAt(q);
                }
                else {
                    BOTC_DeadToggleAt(q);
                }
                return true;
            }
        }
    }
    // 【发送特定信息】（用户 2026-10-10）：正在等「收件人」时，点一个座位就选中他
    if (p == g_teller && (g_specMode == 1 || g_specMode == 2)) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_SpecPickSeat(q);
                return true;
            }
        }
    }
    // （心上人已改成「说书人面板 + 确认」的统一模板 ---- 用户 2026-09-21，这里不再走点头像模式）
    // 【死后选人超时兜底】（用户 2026-09-21）：月之子 / 呆瓜 60 秒没选 → 说书人点头像替他选
    //   ⚠ 走「代替他选」的专用路径，不会当成说书人自己声称那个角色
    if (p == g_teller && g_moonAskSt) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_MoonChildForce(q);
                return true;
            }
        }
    }
    if (p == g_teller && g_klutzAskSt) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_KlutzForce(q);
                return true;
            }
        }
    }
    // 提名阶段锁：除了提名相关的控件，其它操作一律不响应
    if (g_phase != 0) {
        if (BOTC_TokClick(p, c)) {
            return true;
        }
        if (c == g_nomBtn) {
            if (p == g_teller) {
                BOTC_NomCloseEx(false);      // 点【结束提名环节】只收环节，不入夜（入夜由说书人自己点，用户 2026-09-26）
            }
            return true;
        }
        if (c == g_chatBtn) {
            if (p == g_teller) {
                BOTC_ChatBtnClick();       // 说书人：切"时段"（公聊时间 / 私聊时间）
            }
            return true;
        }
        if (c == g_nightBtn) {
            if (p == g_teller) {
                BOTC_NightToggle();
            }
            return true;
        }
        if (c == g_nomStart) {
            BOTC_NomWant(BOTC_PosOf(p));
            return true;
        }
        if (c == g_nomEnd) {
            if (g_phase == 3 || g_phase == 4) {
                if (BOTC_PosOf(p) == g_nomFrom || BOTC_PosOf(p) == g_nomTo || p == g_teller) {
                    BOTC_SpeechAdvance();
                }
            }
            else {
                // 投票阶段：这个按钮对说书人可见，点它就直接结束投票
                if (g_phase == 5 && p == g_teller) {
                    BOTC_SpeechAdvance();
                }
            }
            return true;
        }
        if (c == g_nomForce) {
            if (p == g_teller) {
                BOTC_SpeechAdvance();
            }
            return true;
        }
        if (c == g_voteYes) {
            BOTC_VoteSet(BOTC_PosOf(p), 1);
            return true;
        }
        if (c == g_voteNo) {
            BOTC_VoteSet(BOTC_PosOf(p), 2);
            return true;
        }
        // 【提名阶段也能点身份】（用户 2026-10-02 / 2026-10-03「解除魔典的点击限制」）：
        //   只有「正在等他说目标的那个提名者」（阶段 2 且就是他本人）才把点座位当成选目标；
        //   其余任何人点座位都**不再被提名环节吞掉** ---- 跟非提名阶段一样弹身份网格
        //   （说书人改身份 / 传位；玩家给自己那份魔典标身份）。
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                // 【邀请加入】（用户 2026-10-10）：说书人在选人 → 点谁就把谁拉进当前私聊
                if (p == g_teller && g_invitePick) {
                    BOTC_InviteAt(q);
                    return true;
                }
                if (g_phase == 2 && BOTC_PosOf(p) == g_nomPickBy) {
                    BOTC_NomPick(BOTC_PosOf(p), q);
                    return true;
                }
                BOTC_PickOpen(p, q);
                return true;
            }
        }
        // 【提名说书人】（用户 2026-09-26）：发起提名后点「说书人」那一格 = 提名他
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            if (g_phase == 2 && BOTC_PosOf(p) == g_nomPickBy) {
                BOTC_NomPick(BOTC_PosOf(p), 1);
                return true;
            }
            if (p == g_teller) {
                BOTC_PickOpen(g_teller, 1);        // 说书人点自己那一格：弹他那一格的身份网格
                return true;
            }
        }
        // 提名阶段依然允许看：日志 / 角色能力表 / 自己的魔典（魔典也能关掉再打开）
        if (c == g_logDlgBtn[p]) {
            BOTC_PanelOpen(p, 1);
            return true;
        }
        if (c == g_logPubBtn) {
            BOTC_LogSetMode(p, 0);
            return true;
        }
        if (c == g_logPmBtn) {
            BOTC_LogSetMode(p, 1);
            return true;
        }
        if (c == g_logVoteBtn) {
            BOTC_LogSetMode(p, 2);
            return true;
        }
        if (c == g_logSysBtn) {
            BOTC_LogSetMode(p, 3);
            return true;
        }
        // 【下拉里的行】（用户 2026-10-07）：列表框又改回轮询判定（BOTC_LogMenuTick），这里不用管
        if (c == g_logViewBtn) {
            BOTC_LogPickStart(p);
            return true;
        }
        if (c == g_logClose) {
            BOTC_LogClose(p);
            return true;
        }
        if (c == g_abOpenBtn[p]) {
            BOTC_PanelOpen(p, 3);
            return true;
        }
        if (c == g_noBtn[p]) {
            BOTC_PanelOpen(p, 4);
            return true;
        }
        if (c == g_tipBtn[p]) {
            BOTC_PanelOpen(p, 6);
            return true;
        }
        if (c == g_noteOpenBtn[p]) {
            BOTC_PanelOpen(p, 5);
            return true;
        }
        if (c == g_noteClose[p]) {
            BOTC_NoteClose(p);
            return true;
        }
        if (c == g_abPrev) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            BOTC_AbilityRender(p);
            return true;
        }
        if (c == g_abNext) {
            if (g_abPage[p] < 2) {
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_AbilityRender(p);
            return true;
        }
        if (c == g_abListPrev2 || c == g_abPrev) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            BOTC_RoleListRender(p);
            return true;
        }
        if (c == g_abListNext2 || c == g_abNext) {
            if (g_abPage[p] < 2) {
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_RoleListRender(p);
            return true;
        }
        if (c == g_abNewClose) {             BOTC_AbClose(p);             return true;         }
        for (q = 0; q < 4; q += 1) {
            if (c == g_abCatPrev[q]) {
                if (g_abCatPage[(p * 4) + q] > 1) {
                    g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] - 1;
                }
                BOTC_AbNewRender(p);
                return true;
            }
            if (c == g_abCatNext[q]) {
                if (g_abCatPage[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_AbCatCap(q))) {
                    g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] + 1;
                }
                BOTC_AbNewRender(p);
                return true;
            }
        }
        if (c == g_abSubPrev) {
            if (g_abPage[p] == 3 && g_glossPage[p] > 1) {
                g_glossPage[p] = g_glossPage[p] - 1;
            }
            if (g_abPage[p] == 4 && g_jinxPage[p] > 1) {
                g_jinxPage[p] = g_jinxPage[p] - 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abSubNext) {
            if (g_abPage[p] == 3 && g_glossPage[p] < ((g_glossCount + 5) / 6)) {
                g_glossPage[p] = g_glossPage[p] + 1;
            }
            if (g_abPage[p] == 4 && g_jinxPage[p] < BOTC_JinxPageCount(p)) {
                g_jinxPage[p] = g_jinxPage[p] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abNewPrev) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            if (g_abPage[p] == 5) { g_jinxPage[p] = 1; }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abNewNext) {
            if (g_abPage[p] < 5) {
                if (g_abPage[p] == 3) { g_jinxPage[p] = 1; }
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        for (q = 0; q < 22; q += 1) {
            if (c == g_abNewHit[q]) {
                BOTC_AbClose(p);                                            // 先收起能力表
                DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);   // 详情面板建得比魔典早，把魔典也收掉才看得见
                g_tipForce[p] = g_abNewRole[q];
                BOTC_TipOpen(p);                                            // 详情面板（左下角有【返回能力表】）
                return true;
            }
        }
        if (c == g_abListClose2) {
            BOTC_AbClose(p);
            return true;
        }
        if (c == g_abClose) {
            BOTC_AbClose(p);
            return true;
        }
        for (q = 0; q < 22; q += 1) {
            if (c == g_abListIcon[q]) {
                BOTC_AbClose(p);
                g_tipForce[p] = g_abListRole[q];
                BOTC_TipOpen(p);
                return true;
            }
        }
        if (c == g_noUp) {
            BOTC_NightOrderScroll(p, -6);
            return true;
        }
        if (c == g_noDown) {
            BOTC_NightOrderScroll(p, 6);
            return true;
        }
        if (c == g_noClose) {
            BOTC_NightOrderClose(p);
            return true;
        }

        if (c == g_tipBtnDetail) {
            g_tipMode[p] = 1;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_tipBtnRules) {
            g_tipMode[p] = 2;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_tipBtnStats) {
            g_tipMode[p] = 3;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_tipClose) {
            BOTC_TipClose(p);
            return true;
        }
        if (c == g_tipBack) {
            BOTC_TipClose(p);
            BOTC_AbilityOpen(p);
            return true;
        }
        if (c == g_grimOpenBtn[p]) {
            BOTC_PanelOpen(p, 2);
            return true;
        }
        if (c == g_rsOpenBtn) {
            if (p == g_teller) {
                BOTC_RsOpen(g_teller);
            }
            return true;
        }
        if (c == g_rsCloseBtn) {
            BOTC_RsClose(p);
            return true;
        }
        for (q = 0; q < 4; q += 1) {
            if (c == g_rsCatPrev[q]) {
                BOTC_RsPageTurn(q, -1);
                return true;
            }
            if (c == g_rsCatNext[q]) {
                BOTC_RsPageTurn(q, 1);
                return true;
            }
        }
        if (c == g_rsRandomBtn) {
            BOTC_RsRandom(p);
            return true;
        }
        if (c == g_rsDealBtn) {
            BOTC_RsApply(p);
            return true;
        }
        for (q = 0; q < g_gridN; q += 1) {
            if (c == g_rsBtn[q]) {
                BOTC_RsToggle(p, q);
                return true;
            }
        }
        if (c == g_grimShare) {
            BOTC_ShareGrim(p);
            return true;
        }
        if (c == g_grimClose) {
            if (g_awake[BOTC_PosOf(p)]) {
                BOTC_Notice(p, "你先完成这次行动（或等说书人收回唤醒）。");
                return true;
            }
            g_winPanelOn = false;
            BOTC_WinAdminRender();
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
            return true;
        }
        if (c == g_claimBtnP[p]) {
            BOTC_ClaimOpen(p, BOTC_PosOf(p));
            return true;
        }

        if (c == g_wakeBtn) {
            if (p == g_teller) {
                BOTC_AutoWakeNext();
            }
            return true;
        }
        if (c == g_wakeManualBtn) {
            if (p == g_teller) {
                BOTC_WakeManualToggle();
            }
            return true;
        }
        if (c == g_pdBtn) {
            if (p == g_teller) {
                BOTC_PlagueDoctorAct();
            }
            return true;
        }
        if (c == g_organYes || c == g_organNo) {
            if (g_organSeat >= 1 && p == g_who[g_organSeat]) {
                if (c == g_organYes) {
                    BOTC_OrganChoose(1);
                }
                else {
                    BOTC_OrganChoose(0);
                }
            }
            return true;
        }
        if (c == g_alcSpyBtn || c == g_alcWidowBtn || c == g_alcCancelBtn) {
            if (g_alcChoice[p]) {
                if (c == g_alcSpyBtn) {
                    BOTC_AlchemistPickRole(p, 18);
                }
                else if (c == g_alcWidowBtn) {
                    BOTC_AlchemistPickRole(p, 75);
                }
                else {
                    BOTC_AlchemistPickRole(p, 0);
                }
            }
            return true;
        }
        if (c == g_recogBtn) {
            if (p == g_teller) {
                BOTC_GrantOpen();
            }
            return true;
        }
        if (c == g_grantRoleBtn) {
            if (p == g_teller) {
                BOTC_GrantRoleOpen();
            }
            return true;
        }
        if (c == g_grantDrunkBtn) {
            if (p == g_teller) {
                BOTC_GrantDrunkToggle();
            }
            return true;
        }
        if (c == g_grantOk) {
            if (p == g_teller) {
                BOTC_GrantApply();
            }
            return true;
        }
        if (c == g_grantRecycleBtn) {
            if (p == g_teller) {
                BOTC_GrantRecycle();
            }
            return true;
        }
        if (c == g_grantClose) {
            if (p == g_teller) {
                BOTC_GrantClose();
            }
            return true;
        }
        // 【发送特定信息】（用户 2026-10-10）：按钮 → 打开小面板；面板里的两条 → 进入「点收件人」模式
        if (c == g_specBtn) {
            if (p == g_teller) {
                BOTC_SpecOpen();
            }
            return true;
        }
        if (c == g_specBtn1) {
            if (p == g_teller) {
                g_specMode = 1;
                DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
                BOTC_Notice(g_teller, "【自定义文本】点一个玩家的座位 = 收件人 → 输入文本后自动加「你得知」发送。");
            }
            return true;
        }
        if (c == g_specBtn2) {
            if (p == g_teller) {
                g_specMode = 2;
                DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
                BOTC_Notice(g_teller, "【玩家号 + 身份】点一个玩家的座位 = 收件人 → 填最多 6 个玩家号，并可选择最多 6 个身份。");
            }
            return true;
        }
        if (c == g_specRecogBtn) {
            if (p == g_teller) {
                BOTC_SpecClose();
                BOTC_SendRecognize();
            }
            return true;
        }
        for (q = 0; q < 6; q += 1) {
            if (c == g_specRoleBtn[q]) {
                if (p == g_teller) {
                    BOTC_SpecRoleOpen(q);
                }
                return true;
            }
        }
        if (c == g_specInfoClear) {
            if (p == g_teller) {
                BOTC_SpecSeatClear();
            }
            return true;
        }
        if (c == g_specInfoOk) {
            if (p == g_teller) {
                BOTC_SpecSeatSend();
            }
            return true;
        }
        if (c == g_specClose) {
            if (p == g_teller) {
                BOTC_SpecClose();
            }
            return true;
        }
        // 【异教领袖（106）· 教派投票】（用户 2026-10-10）：全员 20 秒投票 / 弃权
        if (c == g_cultYes) {
            BOTC_CultVoteAt(BOTC_PosOf(p), 1);
            return true;
        }
        if (c == g_cultNo) {
            BOTC_CultVoteAt(BOTC_PosOf(p), 2);
            return true;
        }

        // 【控件按格子索引】（用户 2026-10-07「确认按钮无效」）：面板是按格子建/发的，点击事件给的是物理座位 → 一律转成 BOTC_PosOf(p)
        if (c == g_skillBtn[BOTC_PosOf(p)]) {
            // 间谍没有目标可选：点技能直接把说书人那份魔典摊给他看
            if (g_mark[(g_teller * 14) + BOTC_PosOf(p)] - 1 == 18) {
                BOTC_SpyPeek(BOTC_PosOf(p));
            }
            else {
                // 【寡妇（75）】（用户 2026-09-23）：首个夜晚点技能 = 看一眼魔典，再点一个人下毒
                if (g_mark[(g_teller * 14) + BOTC_PosOf(p)] - 1 == 75) {
                BOTC_WidowPeek(BOTC_PosOf(p));
                BOTC_SkillOpen(BOTC_PosOf(p));      // 【寡妇】（用户 2026-09-23）：摊开魔典之后进标准选目标面板（目标：X + 确认）
                }
                else {
                    BOTC_SkillOpen(BOTC_PosOf(p));
                }
            }
            return true;
        }
        if (c == g_skillSlotA[BOTC_PosOf(p)]) {
            g_skillT1[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillSlotB[BOTC_PosOf(p)]) {
            if (BOTC_ComboRole(BOTC_ActRoleOf(BOTC_PosOf(p)))) {
                BOTC_ComboRoleOpen(BOTC_PosOf(p));
                return true;
            }
            g_skillT2[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillSlotC[BOTC_PosOf(p)]) {
            g_skillT3[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillNoPick[BOTC_PosOf(p)]) {
            BOTC_SkillCancel(BOTC_PosOf(p));       // 旧按钮兼容；珀改用前置询问后不会再显示
            return true;
        }

        if (c == g_skillOk[BOTC_PosOf(p)]) {
            BOTC_SkillConfirm(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillCancel[BOTC_PosOf(p)]) {
            BOTC_SkillCancel(BOTC_PosOf(p));
            return true;
        }
        if (c == g_execBtn) {
            if (p == g_teller) {
                BOTC_ExecMode();
            }
            return true;
        }
        if (c == g_deadBtn) {
            if (p == g_teller) {
                BOTC_DeadMode();
            }
            return true;
        }
        if (BOTC_WinAdminClick(p, c)) {
            return true;
        }
        if (c == g_declareBtn) {
            BOTC_DeclareClick(p);
            return true;
        }
        if (c == g_dclaimBtn) {
            BOTC_DClaimClick(p);
            return true;
        }


        // 【风雅集（板子 10）· 修行者（114）】（用户 2026-10-16）：两选一面板
        if (g_sgSeat >= 2) {
            if (c == g_sgB1) { BOTC_SgPick(p, 1); return true; }
            if (c == g_sgB2) { BOTC_SgPick(p, 2); return true; }
        }
        // 哈迪寂亚（87）：当前目标点「活着 / 死亡」（说书人也能替他点）
        if (g_hdActive && g_hdNow >= 0 && g_hdNow <= 2) {
            if (c == g_hdBtnLive[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 1); return true; }
            if (c == g_hdBtnDie[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 2); return true; }
        }
        // 【造谣者】公开声明输入框：确定 / 取消（用户 2026-09-20）
        if (c == g_gossipOk) {
            BOTC_GossipSubmit(p);
            return true;
        }
        if (c == g_gossipCancel) {
            DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
            return true;
        }
        // 【杂耍艺人】5 组「座位号 + 身份」面板：确定 / 取消 / 5 个小按钮（用户 2026-09-21）
        if (c == g_juggOk) {
            BOTC_JugglerOk(p);
            return true;
        }
        if (c == g_juggCancel) {
            BOTC_JugglerCancel(p);
            return true;
        }
        if (c == g_juggRoleBtn[0]) { BOTC_JugglerPickRow(p, 1); return true; }
        if (c == g_juggRoleBtn[1]) { BOTC_JugglerPickRow(p, 2); return true; }
        if (c == g_juggRoleBtn[2]) { BOTC_JugglerPickRow(p, 3); return true; }
        if (c == g_juggRoleBtn[3]) { BOTC_JugglerPickRow(p, 4); return true; }
        if (c == g_juggRoleBtn[4]) { BOTC_JugglerPickRow(p, 5); return true; }
        // 【真人说书 · 信息位答题框】（用户 2026-09-20）：确定 / 取消
        if (c == g_miOk) {
            if (p == g_teller) {
                BOTC_ManInfoOk();
            }
            return true;
        }
        if (c == g_miCancel) {
            if (p == g_teller) {
                DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
                BOTC_MiCancelApply();       // 军团那步点取消 = 不屏蔽（疯子看到所有队友）
            }
            return true;
        }
        if (c == g_miYes) {
            if (p == g_teller) {
                BOTC_ManInfoYesNo(1);
            }
            return true;
        }
        if (c == g_miNo) {
            if (p == g_teller) {
                BOTC_ManInfoYesNo(0);
            }
            return true;
        }
        // 【猎手请求】真人说书：是 / 否（说书人拍板）
        if (c == g_slayYes) {
            if (p == g_teller) {
                BOTC_SlayAnswer(1);
            }
            return true;
        }
        if (c == g_slayNo) {
            if (p == g_teller) {
                BOTC_SlayAnswer(0);
            }
            return true;
        }
        if (c == g_slayNo2) {
            if (p == g_teller) {
                BOTC_SlayAnswer(0);
            }
            return true;
        }
        // 【镇长请求】真人说书：是 / 否（说书人拍板）
        if (c == g_mayorYes) {
            if (p == g_teller) {
                BOTC_MayorAnswer(1);
            }
            return true;
        }
        if (c == g_mayorNo) {
            if (p == g_teller) {
                BOTC_MayorAnswer(0);
            }
            return true;
        }
        // 【身份阵营勾选】（用户 2026-10-21）：只有说书人改玩家身份时显示，两个按钮互斥。
        if (c == g_pickGoodBtn) {
            if (p == g_teller) {
                BOTC_PickAlignToggle(0);
            }
            return true;
        }
        if (c == g_pickEvilBtn) {
            if (p == g_teller) {
                BOTC_PickAlignToggle(1);
            }
            return true;
        }
        if (c == g_pickClose) {
            BOTC_GambleCancel(BOTC_PosOf(p));      // 赌徒猜角色模式下：算「取消猜测」（别的模式里这个函数什么都不做）
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
            return true;
        }
        for (q = 0; q < 4; q += 1) {
            if (c == g_pickCatPrev[q]) {
                if (g_pickCatPageBy[(p * 4) + q] > 1) {
                    g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] - 1;
                }
                g_pickTeam = g_pickFilterTeam[p];
                g_pickAlign = g_pickFilterAlign[p];
                BOTC_PickFilter(p, g_pickFilterGood[p]);
                return true;
            }
            if (c == g_pickCatNext[q]) {
                if (g_pickCatPageBy[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_GridCatCap(q))) {
                    g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] + 1;
                }
                g_pickTeam = g_pickFilterTeam[p];
                g_pickAlign = g_pickFilterAlign[p];
                BOTC_PickFilter(p, g_pickFilterGood[p]);
                return true;
            }
        }
        // 【提名阶段也允许标记身份】（用户 2026-09-30）：伪装身份 / 标身份那一格的点选与清除
        if (c == g_pickClear) {
            BOTC_PickChoose(p, -1);
            return true;
        }
        for (q = 0; q < 64; q += 1) {
            if (c == g_pickBtn[q]) {
                BOTC_PickChoose(p, q);
                return true;
            }
        }
        // 用户 2026-09-17：**说书人在提名阶段自由操作** ---- 这里不 return，继续往下走正常处理
        //   （关小窗 / 处决标记 / 死亡标记 / 切换时段 / 私聊 ...... 都能用）；
        //   玩家这边，除了上面处理过的（提名 / 看日志 / 能力表 / 魔典 / **打 token**），别的点击一律不响应。
        if (c == g_sayBtnP[p]) {
            BOTC_SayToggle(p);
            return true;
        }
        if (c == g_leaveBtn[p]) {
            // 【夜晚不能主动退私聊】（用户 2026-10-04）：夜里除说书人外，点【退出私聊】不生效；
            //   公聊 / 私聊的切换（g_sayBtnP → BOTC_SayToggle）不受这条限制。
            if (g_isNight && p != g_teller && g_mySess[p] != 0) {
                BOTC_Notice(p, "现在是夜晚：不能主动退出私聊，等说书人来结束这次私聊。（公聊 / 私聊切换不受影响）");
                return true;
            }
            BOTC_Leave(p);
            return true;
        }
        if (c == g_joinBtn[p]) {
            BOTC_PmPickStart(p);
            return true;
        }
        if (c == g_joinPopBtn[p]) {
            BOTC_RequestJoin(p);
            return true;
        }
        if (c == g_inviteBtn[p]) {
            BOTC_InviteStart(p);
            return true;
        }
        if (c == g_dissolveBtn[p]) {
            BOTC_DissolveStart(p);
            return true;
        }
        if (c == g_reqYes[p]) {
            BOTC_OnYes(p);
            return true;
        }
        if (c == g_reqNo[p]) {
            BOTC_OnNo(p);
            return true;
        }
        if (c == g_hideBtn[p]) {
            BOTC_ToggleHide(p);
            return true;
        }
        if (c == g_expandBtn[p]) {
            BOTC_ToggleHide(p);
            return true;
        }
        if (p != g_teller) {
            return true;
        }
    }
    // 提名环节开关（自由阶段：说书人开启）
    if (c == g_nomBtn) {
        if (p == g_teller) {
            if (g_isNight) {
                BOTC_Notice(g_teller, "现在是夜晚，提名环节只能在白天开。");
            }
            else {
                BOTC_NomOpen();
            }
        }
        return true;
    }
    // 【切换板子】（正式开始之前）
            // 【换座位】（用户 2026-10-07）：点它进"点座位"模式 → 给那一格的人发换座位请求
            if (c == g_tsBtn) {
                BOTC_SeatAskStart(p);
                return true;
            }
            // 【测试·换座位】（用户 2026-10-07）
            if (c == g_swapBtn) {
                BOTC_SwapSeatStart(p);
                return true;
            }
    if (c == g_bsBtn) {
        if (p == g_teller) {
            BOTC_BoardSwitch();
        }
        return true;
    }
    if (c == g_legBtn) {
        if (p == g_teller) {
            BOTC_LegacyPanelRender();
        }
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (c == g_legRowBtn[q]) {
            BOTC_LegacyRowToggle(q);
            return true;
        }
    }
    if (c == g_legClose) {
        BOTC_LegacyPanelHide();
        return true;
    }
    // 聊天时段切换（说书人：公聊时间 / 私聊时间）
    if (c == g_chatBtn) {
        if (p == g_teller) {
            BOTC_ChatBtnClick();
        }
        return true;
    }
    // 说书人：【邪恶小窗】开关（正式开局后的白天才能开）
    if (c == g_evilBtn) {
        if (p == g_teller) {
            BOTC_EvilToggle();
        }
        return true;
    }
    if (c == g_hideBtn[p]) {
        BOTC_ToggleHide(p);
        return true;
    }
    if (c == g_expandBtn[p]) {
        BOTC_ToggleHide(p);
        return true;
    }
    if (c == g_logDlgBtn[p]) {
        BOTC_PanelOpen(p, 1);
        return true;
    }
    // 角色能力表
    if (c == g_abOpenBtn[p]) {
        BOTC_PanelOpen(p, 3);
        return true;
    }
    // 夜间顺序表
    if (c == g_noBtn[p]) {
        BOTC_PanelOpen(p, 4);
        return true;
    }
    if (c == g_tipBtn[p]) {
        BOTC_PanelOpen(p, 6);
        return true;
    }
    if (c == g_noteOpenBtn[p]) {
        BOTC_PanelOpen(p, 5);
        return true;
    }
    if (c == g_noteClose[p]) {
        BOTC_NoteClose(p);
        return true;
    }
    if (c == g_abPrev) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        BOTC_AbilityRender(p);
        return true;
    }
    if (c == g_abNext) {
        if (g_abPage[p] < 2) {
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_AbilityRender(p);
        return true;
    }
    if (c == g_abListPrev2 || c == g_abPrev) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        BOTC_RoleListRender(p);
        return true;
    }
    if (c == g_abListNext2 || c == g_abNext) {
        if (g_abPage[p] < 2) {
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_RoleListRender(p);
        return true;
    }
    if (c == g_abNewClose) {         BOTC_AbClose(p);         return true;     }
    for (q = 0; q < 4; q += 1) {
        if (c == g_abCatPrev[q]) {
            if (g_abCatPage[(p * 4) + q] > 1) {
                g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] - 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abCatNext[q]) {
            if (g_abCatPage[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_AbCatCap(q))) {
                g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
    }
    if (c == g_abSubPrev) {
        if (g_abPage[p] == 3 && g_glossPage[p] > 1) {
            g_glossPage[p] = g_glossPage[p] - 1;
        }
        if (g_abPage[p] == 4 && g_jinxPage[p] > 1) {
            g_jinxPage[p] = g_jinxPage[p] - 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abSubNext) {
        if (g_abPage[p] == 3 && g_glossPage[p] < ((g_glossCount + 5) / 6)) {
            g_glossPage[p] = g_glossPage[p] + 1;
        }
        if (g_abPage[p] == 4 && g_jinxPage[p] < BOTC_JinxPageCount(p)) {
            g_jinxPage[p] = g_jinxPage[p] + 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abNewPrev) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        if (g_abPage[p] == 5) { g_jinxPage[p] = 1; }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abNewNext) {
        if (g_abPage[p] < 5) {
            if (g_abPage[p] == 3) { g_jinxPage[p] = 1; }
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    for (q = 0; q < 22; q += 1) {
        if (c == g_abNewHit[q]) {
            BOTC_AbClose(p);                                            // 先收起能力表
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);   // 详情面板建得比魔典早，把魔典也收掉才看得见
            g_tipForce[p] = g_abNewRole[q];
            BOTC_TipOpen(p);                                            // 详情面板（左下角有【返回能力表】）
            return true;
        }
    }
    if (c == g_abListClose2) {
        BOTC_AbClose(p);
        return true;
    }
    if (c == g_abClose) {
        BOTC_AbClose(p);
        return true;
    }
    for (q = 0; q < 22; q += 1) {
        if (c == g_abListIcon[q]) {
            BOTC_AbClose(p);                  // 先收起能力表（它建得晚，会盖住详情面板）
            g_tipForce[p] = g_abListRole[q];
            BOTC_TipOpen(p);
            return true;
        }
    }
    if (c == g_noUp) {
        BOTC_NightOrderScroll(p, -6);
        return true;
    }
    if (c == g_noDown) {
        BOTC_NightOrderScroll(p, 6);
        return true;
    }
    if (c == g_noClose) {
        BOTC_NightOrderClose(p);
        return true;
    }

    if (c == g_tipBtnDetail) {
        g_tipMode[p] = 1;
        BOTC_TipRender(p);
        return true;
    }
    if (c == g_tipBtnRules) {
        g_tipMode[p] = 2;
        BOTC_TipRender(p);
        return true;
    }
    if (c == g_tipBtnStats) {
        g_tipMode[p] = 3;
        BOTC_TipRender(p);
        return true;
    }
    if (c == g_tipClose) {
        BOTC_TipClose(p);
        return true;
    }
    if (c == g_tipBack) {
        BOTC_TipClose(p);
        BOTC_AbilityOpen(p);
        return true;
    }
    // 昼夜切换（只有说书人能按）
    if (c == g_nightBtn) {
        if (p == g_teller) {
            BOTC_NightToggle();
        }
        return true;
    }
    // 魔典相关（每个玩家一份，各自标记）
    if (c == g_grimOpenBtn[p]) {
        BOTC_PanelOpen(p, 2);
        return true;
    }
    if (c == g_rsOpenBtn) {
        if (p == g_teller) {
            BOTC_RsOpen(g_teller);
        }
        return true;
    }
    if (c == g_rsCloseBtn) {
        BOTC_RsClose(p);
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (c == g_rsCatPrev[q]) {
            BOTC_RsPageTurn(q, -1);
            return true;
        }
        if (c == g_rsCatNext[q]) {
            BOTC_RsPageTurn(q, 1);
            return true;
        }
    }
    if (c == g_rsRandomBtn) {
        BOTC_RsRandom(p);
        return true;
    }
    if (c == g_rsDealBtn) {
        BOTC_RsApply(p);
        return true;
    }
    for (q = 0; q < g_gridN; q += 1) {
        if (c == g_rsBtn[q]) {
            BOTC_RsToggle(p, q);
            return true;
        }
    }
    if (c == g_grimShare) {
        BOTC_ShareGrim(p);
        return true;
    }
    if (c == g_grimClose) {
        if (g_awake[BOTC_PosOf(p)]) {
            BOTC_Notice(p, "你先完成这次行动（或等说书人收回唤醒）。");
            return true;
        }
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
        return true;
    }
    if (c == g_grimDeal) {
        if (p == g_teller) {
            BOTC_Deal();
        }
        return true;
    }
    if (c == g_grimConfirm) {
        if (p == g_teller) {
            BOTC_ConfirmDeal();
        }
        return true;
    }
    // 游戏正式开始 / 取消正式开始（只有说书人）
    if (c == g_grimStart) {
        if (p == g_teller) {
            if (g_started) {
                BOTC_GameStartCancel();
            }
            else {
                if (g_startPending) {
                    BOTC_GameStartCancel();      // 还在 10 秒倒数里：再点一下 = 把倒数撤掉
                }
                else {
                    BOTC_GameStart();
                }
            }
        }
        return true;
    }
    // 处决标记：按一下进入标记模式，再点座位盖上红叉
    if (c == g_execBtn) {
        if (p == g_teller) {
            BOTC_ExecMode();
        }
        return true;
    }
    // 死亡标记：按一下进入标记模式，再点座位盖上红叉
    if (c == g_deadBtn) {
        if (p == g_teller) {
            BOTC_DeadMode();
        }
        return true;
    }
    if (BOTC_WinAdminClick(p, c)) {
        return true;
    }
    if (c == g_declareBtn) {
        BOTC_DeclareClick(p);
        return true;
    }
    if (c == g_dclaimBtn) {
        BOTC_DClaimClick(p);
        return true;
    }


    // 【风雅集（板子 10）· 修行者（114）】（用户 2026-10-16）：两选一面板
    if (g_sgSeat >= 2) {
        if (c == g_sgB1) { BOTC_SgPick(p, 1); return true; }
        if (c == g_sgB2) { BOTC_SgPick(p, 2); return true; }
    }
    // 哈迪寂亚（87）：当前目标点「活着 / 死亡」（说书人也能替他点）
    if (g_hdActive && g_hdNow >= 0 && g_hdNow <= 2) {
        if (c == g_hdBtnLive[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 1); return true; }
        if (c == g_hdBtnDie[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 2); return true; }
    }
    // 【造谣者】公开声明输入框：确定 / 取消（用户 2026-09-20）
    if (c == g_gossipOk) {
        BOTC_GossipSubmit(p);
        return true;
    }
    if (c == g_gossipCancel) {
        DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
        return true;
    }
    // 【杂耍艺人】5 组「座位号 + 身份」面板：确定 / 取消 / 5 个小按钮（用户 2026-09-21）
    if (c == g_juggOk) {
        BOTC_JugglerOk(p);
        return true;
    }
    if (c == g_juggCancel) {
        BOTC_JugglerCancel(p);
        return true;
    }
    if (c == g_juggRoleBtn[0]) { BOTC_JugglerPickRow(p, 1); return true; }
    if (c == g_juggRoleBtn[1]) { BOTC_JugglerPickRow(p, 2); return true; }
    if (c == g_juggRoleBtn[2]) { BOTC_JugglerPickRow(p, 3); return true; }
    if (c == g_juggRoleBtn[3]) { BOTC_JugglerPickRow(p, 4); return true; }
    if (c == g_juggRoleBtn[4]) { BOTC_JugglerPickRow(p, 5); return true; }
    // 【真人说书 · 信息位答题框】（用户 2026-09-20）：确定 / 取消
    if (c == g_nobleOk) {
        BOTC_NobleSend();
        return true;
    }
    if (c == g_engBtn1) {
        BOTC_EngGrid(1, 3);
        return true;
    }
    if (c == g_engBtn2) {
        BOTC_EngGrid(1, 2);
        return true;
    }
    if (c == g_engBtn3) {
        BOTC_EngGrid(1, 2);
        return true;
    }
    if (c == g_engClose) {
        DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
        return true;
    }
    if (c == g_farmOk) {
        BOTC_FarmerSend();
        return true;
    }
    if (c == g_miOk) {
        if (p == g_teller) {
            BOTC_ManInfoOk();
        }
        return true;
    }
    if (c == g_miCancel) {
        if (p == g_teller) {
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            BOTC_MiCancelApply();       // 军团那步点取消 = 不屏蔽（疯子看到所有队友）
        }
        return true;
    }
    if (c == g_miYes) {
        if (p == g_teller) {
            BOTC_ManInfoYesNo(1);
        }
        return true;
    }
    if (c == g_miNo) {
        if (p == g_teller) {
            BOTC_ManInfoYesNo(0);
        }
        return true;
    }
    // 【猎手请求】真人说书：是 / 否（说书人拍板）
    if (c == g_slayYes) {
        if (p == g_teller) {
            BOTC_SlayAnswer(1);
        }
        return true;
    }
    if (c == g_slayNo) {
        if (p == g_teller) {
            BOTC_SlayAnswer(0);
        }
        return true;
    }
    if (c == g_slayNo2) {
        if (p == g_teller) {
            BOTC_SlayAnswer(0);
        }
        return true;
    }
    // 【镇长请求】真人说书：是 / 否（说书人拍板）
    if (c == g_mayorYes) {
        if (p == g_teller) {
            BOTC_MayorAnswer(1);
        }
        return true;
    }
    if (c == g_mayorNo) {
        if (p == g_teller) {
            BOTC_MayorAnswer(0);
        }
        return true;
    }
    // 【快进到提名】投票（只有玩家 2..13 有这个按钮；说书人那边是只读票数）
    if (c == g_skipBtn) {
        BOTC_SkipClick(BOTC_PosOf(p));
        return true;
    }
    // 邪恶玩家自己的【伪装身份】：给自己选一个善良身份当掩护
    if (c == g_claimBtnP[p]) {
        BOTC_ClaimOpen(p, BOTC_PosOf(p));
        return true;
    }

    // 说书人：【唤醒】按钮（自由阶段也能用 ---- 晚上就在这个阶段）
    if (c == g_wakeBtn) {
        if (p == g_teller) {
            BOTC_AutoWakeNext();
        }
        return true;
    }
    if (c == g_wakeManualBtn) {
        if (p == g_teller) {
            BOTC_WakeManualToggle();
        }
        return true;
    }
    if (c == g_pdBtn) {
        if (p == g_teller) {
            BOTC_PlagueDoctorAct();
        }
        return true;
    }
    if (c == g_organYes || c == g_organNo) {
        if (g_organSeat >= 1 && p == g_who[g_organSeat]) {
            if (c == g_organYes) {
                BOTC_OrganChoose(1);
            }
            else {
                BOTC_OrganChoose(0);
            }
        }
        return true;
    }
    if (c == g_alcSpyBtn || c == g_alcWidowBtn || c == g_alcCancelBtn) {
        if (g_alcChoice[p]) {
            if (c == g_alcSpyBtn) {
                BOTC_AlchemistPickRole(p, 18);
            }
            else if (c == g_alcWidowBtn) {
                BOTC_AlchemistPickRole(p, 75);
            }
            else {
                BOTC_AlchemistPickRole(p, 0);
            }
        }
        return true;
    }
    if (c == g_recogBtn) {
        if (p == g_teller) {
            BOTC_GrantOpen();
        }
        return true;
    }
    if (c == g_grantRoleBtn) {
        if (p == g_teller) {
            BOTC_GrantRoleOpen();
        }
        return true;
    }
    if (c == g_grantDrunkBtn) {
        if (p == g_teller) {
            BOTC_GrantDrunkToggle();
        }
        return true;
    }
    if (c == g_grantOk) {
        if (p == g_teller) {
            BOTC_GrantApply();
        }
        return true;
    }
    if (c == g_grantRecycleBtn) {
        if (p == g_teller) {
            BOTC_GrantRecycle();
        }
        return true;
    }
    if (c == g_grantClose) {
        if (p == g_teller) {
            BOTC_GrantClose();
        }
        return true;
    }
    // 【发送特定信息】（用户 2026-10-10）：按钮 → 打开小面板；面板里的两条 → 进入「点收件人」模式
    if (c == g_specBtn) {
        if (p == g_teller) {
            BOTC_SpecOpen();
        }
        return true;
    }
    if (c == g_specBtn1) {
        if (p == g_teller) {
            g_specMode = 1;
            DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
            BOTC_Notice(g_teller, "【自定义文本】点一个玩家的座位 = 收件人 → 输入文本后自动加「你得知」发送。");
        }
        return true;
    }
    if (c == g_specBtn2) {
        if (p == g_teller) {
            g_specMode = 2;
            DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
            BOTC_Notice(g_teller, "【玩家号 + 身份】点一个玩家的座位 = 收件人 → 填最多 6 个玩家号，并可选择最多 6 个身份。");
        }
        return true;
    }
    if (c == g_specRecogBtn) {
        if (p == g_teller) {
            BOTC_SpecClose();
            BOTC_SendRecognize();
        }
        return true;
    }
    for (q = 0; q < 6; q += 1) {
        if (c == g_specRoleBtn[q]) {
            if (p == g_teller) {
                BOTC_SpecRoleOpen(q);
            }
            return true;
        }
    }
    if (c == g_specInfoClear) {
        if (p == g_teller) {
            BOTC_SpecSeatClear();
        }
        return true;
    }
    if (c == g_specInfoOk) {
        if (p == g_teller) {
            BOTC_SpecSeatSend();
        }
        return true;
    }
    if (c == g_specClose) {
        if (p == g_teller) {
            BOTC_SpecClose();
        }
        return true;
    }
    // 【异教领袖（106）· 教派投票】（用户 2026-10-10）：全员 20 秒投票 / 弃权
    if (c == g_cultYes) {
        BOTC_CultVoteAt(BOTC_PosOf(p), 1);
        return true;
    }
    if (c == g_cultNo) {
        BOTC_CultVoteAt(BOTC_PosOf(p), 2);
        return true;
    }
    // 被唤醒玩家的【使用技能】与目标面板

    // 【控件按格子索引】（用户 2026-10-07「确认按钮无效」）：面板是按格子建/发的，点击事件给的是物理座位 → 一律转成 BOTC_PosOf(p)
    if (c == g_skillBtn[BOTC_PosOf(p)]) {
        // 间谍没有目标可选：点技能直接把说书人那份魔典摊给他看
        if (g_mark[(g_teller * 14) + BOTC_PosOf(p)] - 1 == 18) {
            BOTC_SpyPeek(BOTC_PosOf(p));
        }
        else {
            // 【寡妇（75）】（用户 2026-09-23）：首个夜晚点技能 = 看一眼魔典，再点一个人下毒
            if (g_mark[(g_teller * 14) + BOTC_PosOf(p)] - 1 == 75) {
            BOTC_WidowPeek(BOTC_PosOf(p));
            BOTC_SkillOpen(BOTC_PosOf(p));          // 【寡妇】（用户 2026-09-23）：摊开魔典之后进标准选目标面板（目标：X + 确认）
            }
            else {
                BOTC_SkillOpen(BOTC_PosOf(p));
            }
        }
        return true;
    }
    if (c == g_skillSlotA[BOTC_PosOf(p)]) {
        g_skillT1[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillSlotB[BOTC_PosOf(p)]) {
        if (BOTC_ComboRole(BOTC_ActRoleOf(BOTC_PosOf(p)))) {
            BOTC_ComboRoleOpen(BOTC_PosOf(p));
            return true;
        }
        g_skillT2[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillSlotC[BOTC_PosOf(p)]) {
        g_skillT3[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillNoPick[BOTC_PosOf(p)]) {
        BOTC_SkillCancel(BOTC_PosOf(p));           // 旧按钮兼容；珀改用前置询问后不会再显示
        return true;
    }

    if (c == g_skillOk[BOTC_PosOf(p)]) {
        BOTC_SkillConfirm(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillCancel[BOTC_PosOf(p)]) {
        BOTC_SkillCancel(BOTC_PosOf(p));
        return true;
    }
    // 【身份阵营勾选】（用户 2026-10-21）：只有说书人改玩家身份时显示，两个按钮互斥。
    if (c == g_pickGoodBtn) {
        if (p == g_teller) {
            BOTC_PickAlignToggle(0);
        }
        return true;
    }
    if (c == g_pickEvilBtn) {
        if (p == g_teller) {
            BOTC_PickAlignToggle(1);
        }
        return true;
    }
    if (c == g_pickClose) {
        BOTC_GambleCancel(BOTC_PosOf(p));          // 赌徒猜角色模式下：算「取消猜测」
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (c == g_pickCatPrev[q]) {
            if (g_pickCatPageBy[(p * 4) + q] > 1) {
                g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] - 1;
            }
            g_pickTeam = g_pickFilterTeam[p];
            g_pickAlign = g_pickFilterAlign[p];
            BOTC_PickFilter(p, g_pickFilterGood[p]);
            return true;
        }
        if (c == g_pickCatNext[q]) {
            if (g_pickCatPageBy[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_GridCatCap(q))) {
                g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] + 1;
            }
            g_pickTeam = g_pickFilterTeam[p];
            g_pickAlign = g_pickFilterAlign[p];
            BOTC_PickFilter(p, g_pickFilterGood[p]);
            return true;
        }
    }
    if (c == g_pickClear) {
        BOTC_PickChoose(p, -1);
        return true;
    }
    for (q = 0; q < 64; q += 1) {
        if (c == g_pickBtn[q]) {
            BOTC_PickChoose(p, q);
            return true;
        }
    }
    // 打 token（＋ 开面板 / 面板里的 20 个按钮 / 清除全部 / 关闭）：抽成函数，提名阶段那边也调它
    if (BOTC_TokClick(p, c)) {
        return true;
    }
    // 【说书人点自己那一格】（用户 2026-09-26）：弹身份网格；选完只有他自己看得见
    if (p == g_teller && (c == g_saySeatBtn || c == g_saySeatLbl)) {
        BOTC_PickOpen(g_teller, 1);
        return true;
    }
    for (q = 2; q <= 13; q += 1) {
        if (c == g_grimSeat[q]) {
            // 【邀请加入】（用户 2026-10-10）：说书人在选人 → 点谁就把谁拉进当前私聊
            if (p == g_teller && g_invitePick) {
                BOTC_InviteAt(q);
                return true;
            }
            // （寡妇改成走标准选目标面板了，这里不再「一点就中毒」：用户 2026-09-23）
            BOTC_PickOpen(p, q);
            return true;
        }
    }

    if (c == g_logPubBtn) {
        BOTC_LogSetMode(p, 0);
        return true;
    }
    if (c == g_logPmBtn) {
        BOTC_LogSetMode(p, 1);
        return true;
    }
    if (c == g_logVoteBtn) {
        BOTC_LogSetMode(p, 2);
        return true;
    }
    if (c == g_logSysBtn) {
        BOTC_LogSetMode(p, 3);
        return true;
    }
    // 【下拉里的行】（用户 2026-10-07）：列表框又改回轮询判定（BOTC_LogMenuTick），这里不用管
    if (c == g_logViewBtn) {
        BOTC_LogPickStart(p);
        return true;
    }
    if (c == g_logClose) {
        BOTC_LogClose(p);
        return true;
    }
    if (c == g_pmSend[p]) {
        BOTC_SendPm(p);
        return true;
    }
    // 邪恶小窗：发消息
    if (c == g_evilSend) {
        BOTC_EvilSend(p);
        return true;
    }
    if (c == g_tmHideBtn || c == g_tmExpandBtn) {
        if (p == g_teller) {
            BOTC_TimerToggle();
        }
        return true;
    }
    if (c == g_tmBtnType) {
        if (p == g_teller) {
            BOTC_TimerTypeNext();
        }
        return true;
    }
    if (c == g_tmBtnGo) {
        if (p == g_teller) {
            BOTC_TimerStart();
        }
        return true;
    }
    if (c == g_tmBtnStop) {
        if (p == g_teller) {
            BOTC_TimerStop();
        }
        return true;
    }
    if (c == g_sayBtnP[p]) {
        BOTC_SayToggle(p);
        return true;
    }
    if (c == g_leaveBtn[p]) {
        // 【夜晚不能主动退私聊】（用户 2026-10-04）：夜里除说书人外，点【退出私聊】不生效
        if (g_isNight && p != g_teller && g_mySess[p] != 0) {
            BOTC_Notice(p, "现在是夜晚：不能主动退出私聊，等说书人来结束这次私聊。（公聊 / 私聊切换不受影响）");
            return true;
        }
        BOTC_Leave(p);
        return true;
    }
    if (c == g_joinBtn[p]) {
        BOTC_PmPickStart(p);       // 用户 2026-09-19：改成开魔典上点座位选人
        return true;
    }
    if (c == g_joinPopBtn[p]) {
        BOTC_RequestJoin(p);       // 用列表里选中的那条私聊去申请加入
        return true;
    }
    if (c == g_inviteBtn[p]) {
        BOTC_InviteStart(p);
        return true;
    }
    if (c == g_dissolveBtn[p]) {
        BOTC_DissolveStart(p);
        return true;
    }
    if (c == g_reqYes[p]) {
        BOTC_OnYes(p);
        return true;
    }
    if (c == g_reqNo[p]) {
        BOTC_OnNo(p);
        return true;
    }
    // 不在场身份面板
    for (q = 0; q < 3; q += 1) {
        if (c == g_bluffSeat[q]) {
            if (p == g_teller) {
                BOTC_BluffOpenPick(p, q);
            }
            return true;
        }
    }
    if (c == g_bluffRollBtn) {
        if (p == g_teller) {
            BOTC_BluffRoll();
        }
        return true;
    }
    if (c == g_bluffSendBtn) {
        if (p == g_teller) {
            BOTC_BluffSendStart();
        }
        return true;
    }
    if (c == g_bluffSendAllBtn) {
        if (p == g_teller) {
            BOTC_BluffSendToDemons();
        }
        return true;
    }
    return true;
}

// 【点界面】的入口：包一层只是为了打着 g_inClick 标记 ——
//   处理点击期间冒出来的提示只走提示条、不写进私聊日志（用户 2026-09-30：点按钮刷屏太多）。
bool BOTC_Click_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_ClickDo(testConds, runActions);
    g_inClick = false;
    return r;
}

// 【开发/测试指令】谁能用聊天里的那些调试指令：
//   说书人位（玩家1）、玩家2，以及**智能说书模式下的玩家3** ---- 因为「玩家1 是电脑」那种测试局里，
//   坐在玩家2 的那位，原生座位号其实是 3（界面标签才是「玩家2」）。
//==================================================================================================
// 【测试】说书人自己拿身份试技能（用户 2026-09-20）
//   玩家1 没有座位，所以这里用「观察者 1 的座位 1」（g_mark[(g_teller * 14) + 1]）当说书人自己的身份格：
//   技能按钮 / 技能面板初始化时本来就给 p = 1..13 都建过，所以只要显示给玩家1 自己就行；
//   点了【使用技能】之后的流程跟普通玩家完全一样（点魔典上的座位选目标 → 确认）。
//   这一格不参与配板 / 胜负 / 座位表（那些只扫 2..13），换局会一起清掉。
//   指令：-t（弹身份网格点一个身份）／ -t off（关掉、清空）
//==================================================================================================
void BOTC_TestSelfRole (int r) {
    if (r < 0 || r > 148) {
        // 关掉
        g_testSelfOn = false;
        g_mark[(g_teller * 14) + 1] = 0;
        g_awake[1] = false;
        g_skillPicking[1] = false;
        g_limitedAsk[1] = false;
        g_poAsk[1] = false;
        g_skillRoleSel[1] = 0;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_GrimRender(g_teller);
        return;
    }
    g_testSelfOn = true;
    g_mark[(g_teller * 14) + 1] = r + 1;
    g_awake[1] = true;                  // 直接算「被唤醒」（不走唤醒判定，方便随便试）
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillPicking[1] = false;
    BOTC_GrimRender(g_teller);
    // 【新角色一律同时接「说书人自己那一格」】（用户 2026-09-21 定的规矩；2026-09-26 起这是常规功能，不再是测试）：
    //   拿到的角色如果用「祖母式面板」，选完就直接把那块面板弹出来，跟真人唤醒流程完全一致，不用再点【使用技能】。
    if (r == 56) {
        DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), true);
        BOTC_PhiloOpen(BOTC_PosOf(g_teller));
    }
    else {
        // 【镜像双子（64）】：配对只有说书人知道 → 直接弹「座位号 + 身份」面板
        if (r == 64) {
            DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
            BOTC_MiFnOpen(1, 23);
        }
        else {
            // 【洗脑师（66）/ 麻脸巫婆（67）】：两个都是玩家自己填 ----
            //   他们照常点【使用技能】选目标、再自己从身份网格里选身份，这里只把技能按钮露出来。
            DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
            if ((g_roleTargets[r] > 0 || r == 18) && !(r == 119 && g_nightNum >= 2)) { DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), true); }   // 逆臣：只有首夜
        }
    }
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
}

// 【测试】弹身份网格：点一个图标 = 说书人自己拿那个身份（复用现成的身份面板，模式 6）
void BOTC_TestSelfOpen () {
    g_pickMode[g_teller] = 6;
    BOTC_GridPlan();               // 保险：先按当前板子把格子重算一遍（跟选身份面板一致）
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("说书人自己拿一个身份（点一个图标）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个身份图标：说书人自己就拿这个身份，之后点【使用技能】试技能。");
}

bool BOTC_DevPlayer (int p) {
    // 【正式版】全部测试指令与测试按钮关闭，包括玩家 2 的选板旁路。
    //   【发送特定信息】【赋予能力】已单独解耦，只保留给说书人，不受这里影响。
    return false;
}

// 【私聊测试】（用户 2026-09-22）：把「-pm 2 3」里那一对玩家号拆出来，直接让他们开一个私聊。
//   参数 = 星际里的玩家号（2..13）；玩家 1 是说书人，不参与。
//   字符串下标口径拿不准（历史上 StringSub 按字符认数字翻过车），所以两个位置都试一下，读得出来的才算。
void BOTC_TestPmPair (string arg) {
    int sp;
    int a;
    int b;
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-pm 2 3（两个星际玩家号，2~13）");
        return;
    }
    a = StringToInt(StringSub(arg, 0, sp));
    if (a < 2 || a > 13) {
        a = StringToInt(StringSub(arg, 0, sp - 1));
    }
    b = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    if (b < 2 || b > 13) {
        b = StringToInt(StringSub(arg, sp + 2, StringLength(arg)));
    }
    if (a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-pm 2 3（两个星际玩家号，2~13，且不能相同）");
        return;
    }
    BOTC_CreateSess(a, b);
    BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(BOTC_PosOf(a)) + " 和 " + BOTC_NameStr(BOTC_PosOf(b)) + " 的私聊已建立。");
}

// 【提名测试】（用户 2026-09-22）：直接让「玩家 a」提名「玩家 b」----
//   没在提名环节里会先把环节开起来；发起人死了 / 今天已经提名过 / 目标今天已被提名过，
//   都会把原因报给说书人（BOTC_NomWant / BOTC_NomPick 自己会发提示）。
void BOTC_TestNominate (int a, int b) {
    if (g_phase != 1 && g_phase != 2) {
        BOTC_NomOpen();
        BOTC_Notice(g_teller, "【测试】先把提名环节开起来了。");
    }
    BOTC_NomWant(a);
    if (g_nomPickBy != a) {
        BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(a) + " 现在不能发起提名（原因看上面那条提示）。");
        return;
    }
    BOTC_NomPick(a, b);
    if (g_nomFrom == a && g_nomTo == b) {
        BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(a) + " 提名 " + BOTC_NameStr(b) + " 已发起。");
    }
    else {
        BOTC_Notice(g_teller, "【测试】这次提名没成立（目标可能今天已经被提名过）。");
    }
}

// 【提名测试】把「-nom 2 3」里那一对玩家号拆出来（跟 -pm 一样的解析口径）
void BOTC_TestNomPair (string arg) {
    int sp;
    int a;
    int b;
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-nom 2 3（发起人 目标，星际玩家号 2~13）");
        return;
    }
    a = StringToInt(StringSub(arg, 0, sp));
    if (a < 2 || a > 13) {
        a = StringToInt(StringSub(arg, 0, sp - 1));
    }
    b = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    if (b < 2 || b > 13) {
        b = StringToInt(StringSub(arg, sp + 2, StringLength(arg)));
    }
    if (a < 2 || a > 13 || b < 2 || b > 13) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-nom 2 3（发起人 目标，星际玩家号 2~13）");
        return;
    }
    BOTC_TestNominate(a, b);
}

// 【测试·唤醒某个座位】（用户 2026-10-09）：`-wake 3` = 模拟"手动唤醒模式里点了魔典上的座位 3"。
//   直接调点击分发里同一支用的 BOTC_WakeManualAt（不必先点【手动唤醒】），
//   所以唤醒 / 弹技能面板 / 发系统私聊 走的是**完全相同**的一条路；再发一次同一条 = 收回。
//   ⚠ 座位号用**魔典上的编号**（1~12）；内部格子 = 编号 + 1。
void BOTC_TestWakeAt (int p, string arg) {
    int i;
    int n;
    int v;
    int q;
    bool was;
    // 【容错解析】（用户 2026-10-09 反馈「指令无效」）：不看空格 ---- 从第 2~9 个字符挨个试读，
    //   第一个能读成 1~12 的就当座位号。这样 "-wake3" / "-wake 3" / 全角空格的 "-wake　3" /
    //   "/wake 3" / "-唤醒 3" 全都认。
    n = 0;
    for (i = 2; i <= 9; i += 1) {
        if (n > 0 || i > StringLength(arg)) {
            continue;
        }
        v = StringToInt(StringSub(arg, i, StringLength(arg)));
        if (v >= 1 && v <= 12) {
            n = v;
        }
    }
    if (n < 1) {
        BOTC_Notice(p, "读到的是「" + arg + "」。用法：-wake 1 ~ -wake 12（魔典上的座位编号；再发一次同一条 = 收回）。");
        return;
    }
    q = n + 1;                       // 座位号 n → 格子 n+1
    if (!g_seatOn[q]) {
        BOTC_Notice(p, "座位 " + IntToString(n) + " 上没有真人。");
        return;
    }
    was = g_awake[q];
    BOTC_PmStore(p, "【测试·唤醒】-wake " + IntToString(n) + " → 座位 " + IntToString(n)
        + "（" + BOTC_NameStr(q) + "，物理座位 " + IntToString(g_who[q])
        + "，身份 " + BOTC_SeatRoleStr(q) + "）");
    if (was) {
        BOTC_PmStore(p, "【测试·唤醒】他此刻**是醒的** → 这一下走「收回」：面板收掉 + 私聊「说书人收回了你的技能」发给他。");
    }
    else {
        if (BOTC_SeatIsComputer(q)) {
            BOTC_PmStore(p, "【测试·唤醒】这一格是**电脑**：屏幕上看不到面板（脚本会替他自动选目标）。");
        }
        else {
            BOTC_PmStore(p, "【测试·唤醒】这一下应该：① 技能面板弹给他 ② 系统私聊「【夜晚】你被唤醒了。」也发给他（物理座位 " + IntToString(g_who[q]) + "）；别人那儿不该出现。");
        }
    }
    BOTC_WakeManualAt(q);            // ← 跟"手动唤醒模式里点这个座位"完全同一条路
    if (g_awake[q]) {
        BOTC_PmStore(p, "【测试·唤醒】调用完成：awake = true。");
    }
    else {
        BOTC_PmStore(p, "【测试·唤醒】调用完成：awake = false（没唤醒 / 刚被收回）。");
    }
    if (g_skillPicking[q]) {
        BOTC_PmStore(p, "【测试·唤醒】他现在是「选目标」状态：技能面板已打开，等他点座位再点【确认】。");
    }
}
// 【测试·替玩家 1 电脑选板】（用户 2026-10-20）：玩家 1 是电脑时不会自己点板子，
// 开发 / 测试位发 `-board 1` ～ `-board 10` 即可走正常选板流程；也认 `-板子 / -选板`。
void BOTC_TestBoardAt (int p, string arg) {
    int i;
    int n;
    int v;
    n = 0;
    for (i = 2; i <= 14; i += 1) {
        if (n > 0 || i > StringLength(arg)) {
            continue;
        }
        v = StringToInt(StringSub(arg, i, StringLength(arg)));
        if (v >= 1 && v <= 13) {
            n = v;
        }
    }
    if (n < 1) {
        BOTC_Notice(p, "读到的是「" + arg + "」。用法：-board 1 ～ -board 13（板子号 7 = 自定义剧本，13 = 全员追忆）。");
        return;
    }
    if (!g_boardOpen || g_boardFade < 4) {
        // 【AI 测试兜底】（用户 2026-10-20）：玩家 1 是电脑时选板页可能没正常撑开；
        //   测试位发指令就按正常入口重新打开一次，再立即选板。
        if (!g_started) {
            BOTC_BoardOpen();
        }
    }
    if (!g_boardOpen || g_boardFade < 4) {
        BOTC_Notice(p, "选板页没有准备好；游戏开始前再发一次 -board 1。");
        return;
    }
    BOTC_PmStore(p, "【测试·选板】替当前说书人选板子 " + IntToString(n) + "（" + BOTC_BoardName(n) + "）。");
    BOTC_BoardPick(g_teller, n);
    if (g_boardOpen) {
        BOTC_Notice(p, "选板没有生效：检查选板页面是否已经准备好。");
    }
    else {
        BOTC_Notice(p, "【测试】已替玩家 1 选择板子 " + IntToString(n) + "。");
    }
}

bool BOTC_ChatDo (bool testConds, bool runActions) {
    int p;
    int i;
    int q;
    int n;
    string msg;
    string tag;
    string s;
    p = EventPlayer();
    msg = EventChatMessage(false);
    if (!runActions) {
        return true;
    }
    if (p < 1 || p > 13) {
        return true;
    }
    if (StringLength(msg) == 0) {
        return true;
    }
    // 切换说书模式：「AI」开智能说书、「手动」关掉。
    //   玩家1（说书人位）和 玩家2 都能发 ---- 因为「玩家1 是电脑」时他不会打字，
    //   而坐在玩家2 的那位（开发/测试的人）需要能把它打开。
    //   这两条是「强制」开关，会盖过按玩家类型自动判断的结果（见 BOTC_P1IsComputer）。
    // 【查看句柄】（用户 2026-10-02）：-handles = 列出每个人的 Battle.net 句柄（抄进脚本里的封禁名单用）。
    //   永久封禁的名单写在脚本里（BOTC_BanListInit），删本地存档没用；**发布版只给开发位**（用户 2026-10-09）。
    if (BOTC_DevPlayer(p) && msg == "-handles") {
        BOTC_HandleListToPm();
        return true;
    }
    // 【-pmirror / -私聊镜像】（用户 2026-10-21）：测试开关。开启后所有 BOTC_PmInfo 角色结果同步显示在说书人私聊窗。
    if (BOTC_DevPlayer(p) && (msg == "-pmirror" || msg == "/pmirror" || msg == "-私聊镜像" || msg == "/私聊镜像" || msg == "-镜像私聊")) {
        g_pmInfoMirrorOn = !g_pmInfoMirrorOn;
        if (g_pmInfoMirrorOn) {
            s = "【私聊镜像】已开启：之后发给玩家的角色结果会同步写到说书人私聊窗；再发一次关闭。";
        }
        else {
            s = "【私聊镜像】已关闭。";
        }
        BOTC_Notice(p, s);
        if (p != g_teller) {
            BOTC_Notice(g_teller, s);
        }
        return true;
    }
    // 【-swap】（用户 2026-10-20）：测试用「换两格」，现在对所有真人座位开放。
    if (BOTC_DevPlayer(p) && msg == "-swap") {
        BOTC_SwapSeatStart(p);
        return true;
    }
    // 【-pos】（用户 2026-10-07；2026-10-09 发布版关闭）：打印自己那张身位表（排查用），只给开发位
    if (BOTC_DevPlayer(p) && msg == "-pos") {
        BOTC_PosOfDump(p);
        return true;
    }
    // 【-grim n】（用户 2026-10-07；2026-10-09 发布版关闭）：开发 / 测试用 —— 把自己的魔典切去"看 座位 n（1..12）自己那份"；
    //   -grim 0（或不带数字）＝ 看回自己那份。只改"渲染读哪一行"，不动任何数据。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-grim", false) == 0 || StringFind(msg, "/grim", false) == 0)) {
        BOTC_GrimViewMsg(p, StringSub(msg, 5, StringLength(msg)));
        return true;
    }
    // 【-board n】（用户 2026-10-20）：替玩家 1 电脑选板，供测试换座位 / bank 使用。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-board", false) == 0 || StringFind(msg, "/board", false) == 0 || StringFind(msg, "board", false) == 0 || StringFind(msg, "-板子", false) == 0 || StringFind(msg, "/板子", false) == 0 || StringFind(msg, "板子", false) == 0 || StringFind(msg, "-选板", false) == 0 || StringFind(msg, "/选板", false) == 0 || StringFind(msg, "选板", false) == 0)) {
        BOTC_TestBoardAt(p, msg);
        return true;
    }
    // 【-wake n】（用户 2026-10-09；发布版关闭）：模拟"手动唤醒模式下点了座位 n"----
    //   走的就是点击那一支用的 BOTC_WakeManualAt，所以唤醒 / 弹面板 / 私聊全是真实路径；
    //   再发一次同一条 = 收回。数字由 BOTC_TestWakeAt 自己解析（-wake 3 / -wake3 / /wake 3 / -唤醒 3 都认）。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-wake", false) == 0 || StringFind(msg, "/wake", false) == 0 || StringFind(msg, "-唤醒", false) == 0)) {
        BOTC_TestWakeAt(p, msg);
        return true;
    }
    // 【投票踢人】（用户 2026-10-02）：发 -kick → 弹魔典 → 点一个座位 = 对他发起踢出投票
    //   （点「说书人」那一格 = 对说书人发起；再发一次 -kick 取消）
    if (msg == "-kick") {
        BOTC_KickPickStart(p);
        return true;
    }
    // 玩家1 自己打字了 → 他百分之百是真人（电脑不会打字）。
    //   万一「玩家类型」那个原生函数判错了、把真人说书当成电脑，这里立刻纠回来。
    //   用聊天里的「AI」强制开启时不走这一步（那条由 g_p1ForceComputer 顶着）。
    // 【调试】三条现场调试指令（只有玩家1 / 玩家2 能用）：
    //   style <样式名>  → 换「大提示」的字体样式并立刻弹一条「夜晚 1」试看
    //   big <文字>      → 直接用大提示弹一行字（试位置 / 试大小）
    //   sfx <音效ID>    → 试播一个音效（顺便把它记成入夜那声）
    //   参数都是英文，所以用 StringSub 直接取（中文会牵扯字节下标，这里不碰）
    // 【-laugh】（用户 2026-09-22）：所有玩家都能用；全桌公用 30 秒冷却，冷却中完全静默 ----
    //   ⚠ 直接内联在这里，不再调外部函数（外面那次「调用」在某些贴法下进不去）
    if (StringFind(msg, "-laugh", false) >= 0) {
        if (g_laughCd <= 0) {
            g_laughCd = 60;
            s = BOTC_SayToken(p) + "：<s val=\"ModLeftSize20Bold\">爽朗的大笑！</s>";     // 【名字要渲染】（用户 2026-09-22）：用「玩家N」占位符，渲染时才带名字和颜色
            g_chatWhoNow = BOTC_PosOf(p);
            BOTC_PubLine(s);
            g_chatWhoNow = 0;
            BOTC_PlaySfx("laugh");
        }
        return true;
    }
    // 【测试·教派投票全流程】（用户 2026-10-11）：说书人自己起一次教派投票，并把**除他以外所有人**自动投成【投票】
    //   —— 用来一次性看完整流程（20 秒到点自动结算；想当场看结果就再发 `-教派胜`）。
    if (BOTC_DevPlayer(p) && msg == "-教派") {
        if (p != g_teller) {
            BOTC_Notice(p, "这条只有说书人能用。");
            return true;
        }
        if (g_cultOn) {
            BOTC_Notice(g_teller, "已经有一次教派投票在走了（要当场看结果发 -教派胜）。");
            return true;
        }
        BOTC_CultStart(1);                    // 以「说书人」那一格当提议人（纯测试；身份会不会结算由你自己 -t 决定）
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q]) { continue; }
            g_vote[q] = 1;                    // 全部投【投票】= 同意加入
        }
        BOTC_NomUI();
        BOTC_PmStore(g_teller, "【教派·测试】已起投票，并把所有人自动投成【投票】（20 秒到点结算；-教派胜 可当场结算）。");
        return true;
    }
    // 【异教领袖（106）· 白天提议入教】（用户 2026-10-10）：只有本尊能发；公开播报，胜负由说书人裁定
    if (msg == "-入教") {
        if (BOTC_AbilityWorks(BOTC_PosOf(p), 106) && !BOTC_SeatDead(BOTC_PosOf(p))) {
            g_cultAsked = true;
            BOTC_PubAnnounce("【教派】" + BOTC_NameStr(BOTC_PosOf(p)) + " 提议所有人加入他的教派！");
            BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(BOTC_PosOf(p)) + " 提议所有人入教 → 逐个问善良玩家同不同意；全部同意就用 -教派胜 裁定。");
        }
        else {
            BOTC_Notice(p, "你不是异教领袖，不能提议入教。");
        }
        return true;
    }
    // 【教派胜利】说书人裁定：异教领袖提议入教且所有善良玩家都同意 → 他的阵营获胜
    if (msg == "-教派胜") {
        if (p == g_teller) {
            if (g_cultOn) {
                BOTC_CultEnd(true);            // 【测试】（用户 2026-10-11）：正在投票就直接结算掉
                return true;
            }
            if (BOTC_SeatOfRole(106) >= 2) {
                BOTC_ShowWin(BOTC_SeatAlign(BOTC_SeatOfRole(106)), "所有善良玩家都加入了异教领袖的教派，", "小镇从此只有一种声音。");
            }
            else {
                if (BOTC_BoffinTargetWithRole(106) >= 2) {
                    BOTC_ShowWin(BOTC_SeatAlign(BOTC_BoffinTargetWithRole(106)), "所有善良玩家都加入了恶魔借来的异教领袖教派，", "小镇从此只有一种声音。");
                }
                else {
                    BOTC_Notice(p, "本局没有异教领袖能力，不能判教派胜利。");
                }
            }
        }
        return true;
    }
    if (BOTC_DevPlayer(p)) {
        if (StringFind(msg, "-style ", false) == 0 && StringLength(msg) > 6) {
            g_bigStyle = StringSub(msg, 6, StringLength(msg));
            libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());
            BOTC_BigNotice("夜晚 1");
            BOTC_Notice(p, "大提示样式改成：" + g_bigStyle);
            return true;
        }
        if (StringFind(msg, "-big ", false) == 0 && StringLength(msg) > 4) {
            BOTC_BigNotice(StringSub(msg, 4, StringLength(msg)));
            return true;
        }
        if (StringFind(msg, "-sfx ", false) == 0 && StringLength(msg) > 4) {
            g_sfxPingName = StringSub(msg, 4, StringLength(msg));
            BOTC_PlaySfx(g_sfxPingName);
            BOTC_Notice(p, "试播音效：" + g_sfxPingName);
            return true;
        }
        // reqsfx <音效ID> / pmsfx <音效ID> → 试播并记下「收到私聊请求 / 私聊建立」这两声 UI 音效
        if (StringFind(msg, "-reqsfx ", false) == 0 && StringLength(msg) > 7) {
            g_sfxReqName = StringSub(msg, 7, StringLength(msg));
            BOTC_PlaySfxTo(g_sfxReqName, p);
            BOTC_Notice(p, "私聊请求音效改成：" + g_sfxReqName);
            return true;
        }
        if (StringFind(msg, "-pmsfx ", false) == 0 && StringLength(msg) > 6) {
            g_sfxPmOnName = StringSub(msg, 6, StringLength(msg));
            BOTC_PlaySfxTo(g_sfxPmOnName, p);
            BOTC_Notice(p, "私聊建立音效改成：" + g_sfxPmOnName);
            return true;
        }
        // startsfx <音效ID> → 试播并记下「游戏正式开始」那声
        if (StringFind(msg, "-startsfx ", false) == 0 && StringLength(msg) > 9) {
            g_sfxStartName = StringSub(msg, 9, StringLength(msg));
            BOTC_PlaySfx(g_sfxStartName);
            BOTC_Notice(p, "正式开始音效改成：" + g_sfxStartName);
            return true;
        }
        // chatsfx <音效ID> → 试播并记下「公屏有人说话」那声
        if (StringFind(msg, "-chatsfx ", false) == 0 && StringLength(msg) > 8) {
            g_sfxChatName = StringSub(msg, 8, StringLength(msg));
            BOTC_PlaySfx(g_sfxChatName);
            BOTC_Notice(p, "公屏说话音效改成：" + g_sfxChatName);
            return true;
        }
        // gstyle <样式名> → 换魔典座位名那一行的字体（试大小用），换完把全场魔典重刷一遍
        //   例子：gstyle ModLeftSize14Bold  /  gstyle ModLeftSize18  /  gstyle ObjectiveDisplay（很大）
        if (StringFind(msg, "-gstyle ", false) == 0 && StringLength(msg) > 7) {
            g_grimNameStyle = StringSub(msg, 7, StringLength(msg));
            for (i = 1; i <= 13; i += 1) {
                BOTC_GrimRender(i);
            }
            BOTC_Notice(p, "魔典座位名字体改成：" + g_grimNameStyle);
            return true;
        }
        // nameoff <数字> → 名字前面方括号里的序号偏移（序号 = 游戏内号 + 这个值）。
        //   默认 -1；如果序号还是差一位，就发 nameoff 0 或 nameoff -2 试，改完聊天窗/日志会重刷。
        if (StringFind(msg, "-nameoff ", false) == 0 && StringLength(msg) > 8) {
            g_nameNumShift = StringToInt(StringSub(msg, 8, StringLength(msg)));
            for (i = 1; i <= 13; i += 1) {
                BOTC_ChatRender(i);
                BOTC_PmBoxRender(i);
                BOTC_LogRender(i);
            }
            BOTC_Notice(p, "名字序号偏移改成：" + IntToString(g_nameNumShift) + "（序号 = 游戏内号 + " + IntToString(g_nameNumShift) + "）");
            return true;
        }
        // nstyle <样式名> → 换「提名开始」那 4 个字的样式，并立刻演一遍看效果
        if (StringFind(msg, "-nstyle ", false) == 0 && StringLength(msg) > 7) {
            g_nomBigStyle = StringSub(msg, 7, StringLength(msg));
            for (i = 0; i < 4; i += 1) {
                libNtve_gf_SetDialogItemStyle(g_nomBigLbl[i], g_nomBigStyle, PlayerGroupAll());
            }
            BOTC_NomBigShow();
            BOTC_Notice(p, "提名大字样式改成：" + g_nomBigStyle);
            return true;
        }
        // nbig <数字> → 用不同的「创建标签最后一个参数」重建那 4 个字（试它是不是字号倍率）
        //   用法举例：nbig 4   或   nbig 8（原来的值是 2）
        if (StringFind(msg, "-nbig ", false) == 0 && StringLength(msg) > 5) {
            g_nomBigSize = StringToFixed(StringSub(msg, 5, StringLength(msg)));
            BOTC_NomBigMake();
            BOTC_NomBigShow();
            BOTC_Notice(p, "提名大字已按新参数重建（原来是 2）");
            return true;
        }
        // wstyle <样式名> → 换结算那句话（游戏结束，我们得到的结果是：）的字体样式并弹出来看
        if (StringFind(msg, "-wstyle ", false) == 0 && StringLength(msg) > 7) {
            g_endStyle = StringSub(msg, 7, StringLength(msg));
            BOTC_EndNoticeMake();
            BOTC_EndNoticeShow();
            BOTC_Notice(p, "结算字幕样式改成：" + g_endStyle);
            return true;
        }
        // wbig <数字> → 用不同的「创建标签最后一个参数」重建结算字幕（试字号倍率）
        if (StringFind(msg, "-wbig ", false) == 0 && StringLength(msg) > 5) {
            g_endSize = StringToFixed(StringSub(msg, 5, StringLength(msg)));
            BOTC_EndNoticeMake();
            BOTC_EndNoticeShow();
            BOTC_Notice(p, "结算字幕已按新参数重建（原来是 2）");
            return true;
        }
        // nametest → 把一行「带名字」的样例同时发到【提示条 / 公聊窗 / 公聊记录 / 私聊记录】，
        //   用来现场看是哪一处显示不全（用户 2026-09-19 排查「只剩两个名字」用）
        if (msg == "-nametest") {
            s = "【名字测试】玩家10 和 玩家11 里，有恶魔（玩家12 说的）---- 结尾这几个字也要在。";
            BOTC_Notice(p, s);          // 提示条 + 他的私聊记录
            BOTC_ChatShowAll(s);        // 公聊窗
            BOTC_PubLogStore(s);        // 公聊记录（点【日志】→ 公聊记录 看）
            return true;
        }
        // /tip <身份索引> → 【调试】让【角色提示】面板强制显示某个角色的文案（开发位可用）；
        //   只发 /tip = 恢复成「显示自己的身份」
        if (StringFind(msg, "-tip", false) == 0) {
            if (StringLength(msg) > 5) {
                g_tipForce[p] = StringToInt(StringSub(msg, 5, StringLength(msg)));
            }
            else {
                g_tipForce[p] = -1;
            }
            BOTC_TipOpen(p);
            if (g_tipForce[p] >= 0 && g_tipForce[p] <= 148) {
                BOTC_Notice(p, "【测试】角色提示面板强制显示：" + g_roleName[g_tipForce[p]]);
            }
            else {
                BOTC_Notice(p, "【测试】角色提示面板恢复成「显示自己的身份」。");
            }
            return true;
        }
        // slay / slayd / slayp / slayf → 【测试猎手弹窗】第 1 个白天让 玩家2 自动声称【猎手】猎杀 玩家3
        //   slay = 真猎手；slayd = 酒鬼猎手（魔典写猎手、其实是酒鬼）；slayp = 中毒的猎手；
        //   slayf = 假声称（身份不动，看座位 2 真身是什么）
        //   再发一次同样的指令 = 关掉
        if (msg == "-slay" || msg == "-slayd" || msg == "-slayp" || msg == "-slayf") {
            i = 0;
            if (msg == "-slayd") {
                i = 1;
            }
            if (msg == "-slayp") {
                i = 2;
            }
            if (msg == "-slayf") {
                i = 3;
            }
            if (g_testSlayOn && g_testSlayMode == i) {
                g_testSlayOn = false;
                BOTC_Notice(p, "【测试】已关掉「玩家2 第 1 个白天自动声称猎手」。");
            }
            else {
                g_testSlayOn = true;
                g_testSlayMode = i;
                g_testSlayDone = false;
                if (i == 1) {
                    BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「酒鬼猎手」自动声称猎杀 玩家3。");
                }
                else {
                    if (i == 2) {
                        BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「中毒的猎手」自动声称猎杀 玩家3。");
                    }
                    else {
                        if (i == 3) {
                            BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「假声称」自动声称猎杀 玩家3（身份不动，看真身是谁）。");
                        }
                        else {
                            BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「真猎手」自动声称猎杀 玩家3。");
                        }
                    }
                }
            }
            return true;
        }
        // -tk → 【测试】打开「说书人自己」的 token 面板（配合 -t 用：给自己打中毒 / 醉酒 / 死亡...
        //   普通玩家的 token 还是老规矩：点座位旁边的【＋】）
        if (msg == "-tk") {
            BOTC_TokOpen(p, 1);        // 【开给打字的人】（用户 2026-10-11：原来写死 1）
    BOTC_PmStore(g_teller, "这是「说书人自己」的 token 面板：点一格就是给自己打/去掉那个 token。");
            return true;
        }
        // -t → 【测试】说书人自己拿一个身份（弹身份网格点一个图标）；-t off / -toff = 关掉
        //   拿到身份之后说书人直接算「被唤醒」：屏幕中间会出现【使用技能】，点魔典上的座位选目标
        if (msg == "-t") {
            BOTC_TestSelfOpen();
            return true;
        }
        if (msg == "-t off" || msg == "-toff") {
            BOTC_TestSelfRole(-1);
            return true;
        }
        // 【私聊测试指令】（用户 2026-09-22）：直接让两名玩家开一个私聊 ----
        //   `/pm23`（简写，玩家2 和玩家3）或 `/pm 2 3`（任意两名，星际玩家号 2..13；1 = 说书人）。
        //   用来验证：说书人在【进行中的私聊】里选中那一条 → 点【请求加入】能不能直接进去。
        //   `-pm` 和 `/pm` 两种前缀都认。
        if (msg == "-pm23" || msg == "/pm23") {
            BOTC_CreateSess(2, 3);
            BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(2) + " 和 " + BOTC_NameStr(3) + " 的私聊已建立。");
            return true;
        }
        if (StringFind(msg, "-pm ", false) == 0 || StringFind(msg, "/pm ", false) == 0) {
            BOTC_TestPmPair(StringSub(msg, 4, StringLength(msg)));
            return true;
        }
        // 【提名测试指令】（用户 2026-09-22）：直接让某名玩家提名某名玩家 ----
        //   `/nom23` = 玩家2 提名 玩家3；`/nom 2 3` = 任意两名（发起人 目标，星际玩家号 2~13）。
        //   `-nom` 和 `/nom` 两种前缀都认。
        if (msg == "-nom23" || msg == "/nom23") {
            BOTC_TestNominate(2, 3);
            return true;
        }
        if (StringFind(msg, "-nom ", false) == 0 || StringFind(msg, "/nom ", false) == 0) {
            BOTC_TestNomPair(StringSub(msg, 5, StringLength(msg)));
            return true;
        }
        // 【处决说书人·测试指令】（用户 2026-09-26）：`-execst` = 直接按「说书人被处决」结算一次
        if (msg == "-execst" || msg == "/execst") {
            BOTC_ExecToggleAt(1);
            return true;
        }
        // -哲酒鬼 / -哲疯子（座位 2 = 游戏里的「玩家1」）：【测试】让那个座位变成「哲学家 + 选了酒鬼 / 疯子」
        //   用户 2026-09-21：跟猎手那套测试指令一个思路，直接跳到第二个网格（他自己没有能力）
    // 【女巫（65）· 测试指令】（用户 2026-09-21）：-诅咒 = 让「被诅咒的那个人」现在发起提名，按诅咒结算一次
    //   （正常玩法里不用它：被诅咒的人自己发起提名时脚本会自动结算）
    if (msg == "-诅咒" || msg == "-女巫") {
        if (g_witchCurse >= 2) {
            BOTC_Notice(g_teller, "【女巫·测试】让 " + BOTC_NameStr(g_witchCurse) + " 发起提名，按诅咒结算。");
            BOTC_WitchNomCheck(g_witchCurse);
        }
        else {
            BOTC_Notice(g_teller, "【女巫·测试】现在没有被诅咒的人。");
        }
    }
        // 【查看某个座位】（用户 2026-09-21）：-看1 ~ -看12 = 把那个座位的身份 / 阵营 / 标记写进你的日志
        if (msg == "-看1") { BOTC_SeatDump(2); }
        if (msg == "-看2") { BOTC_SeatDump(3); }
        if (msg == "-看3") { BOTC_SeatDump(4); }
        if (msg == "-看4") { BOTC_SeatDump(5); }
        if (msg == "-看5") { BOTC_SeatDump(6); }
        if (msg == "-看6") { BOTC_SeatDump(7); }
        if (msg == "-看7") { BOTC_SeatDump(8); }
        if (msg == "-看8") { BOTC_SeatDump(9); }
        if (msg == "-看9") { BOTC_SeatDump(10); }
        if (msg == "-看10") { BOTC_SeatDump(11); }
        if (msg == "-看11") { BOTC_SeatDump(12); }
        if (msg == "-看12") { BOTC_SeatDump(13); }
        // 【麻脸巫婆 / 洗脑师 · 测试指令】（用户 2026-09-21）：直接对**座位 2（游戏里的「玩家1」）**生效，
        //   跟「-哲酒鬼 / -哲疯子」那套一个思路 ---- 不用点技能面板也能验证逻辑。
        //   -熬恶魔 = 把他熬成当前板子上的第一只恶魔（还会开「生死无常」面板）
        if (msg == "-熬恶魔") {
            BOTC_TestHag(-1);
        }
        if (msg == "-熬疯子") {
            BOTC_TestHag(38);
        }
        if (msg == "-熬酒鬼") {
            BOTC_TestHag(14);
        }
        if (msg == "-熬双子" || msg == "-熬镜像双子") {
            BOTC_TestHag(64);
        }
        if (msg == "-熬钟表匠") {
            BOTC_TestHag(47);
        }
        // -疯狂 = 给座位 2 打「疯狂（洗脑师）」并对他说「疯狂证明自己是钟表匠」
        if (msg == "-疯狂") {
            BOTC_CerenApply(2, 47);
        }
        if (msg == "-哲酒鬼" || msg == "-philo14") {
            BOTC_TestPhilo(14);
            return true;
        }
        if (msg == "-哲疯子" || msg == "-philo38") {
            BOTC_TestPhilo(38);
            return true;
        }
        // debug → 【调试总开关】开 / 关：诊断日志、测试播报、真魔典同步一起切换
        if (msg == "-debug") {
            g_debugOn = !g_debugOn;
            if (g_debugOn) {
                BOTC_Notice(p, "【调试】已打开：诊断日志 / 测试播报 / 真魔典同步都会出现。");
            }
            else {
                BOTC_Notice(p, "【调试】已关闭：界面恢复成正式局的样子。");
            }
            return true;
        }
        // bg <数字> → 调公聊 / 私聊那层黑底的不透明度（现场对比，不用重粘脚本）
        if (StringFind(msg, "-bg ", false) == 0 && StringLength(msg) > 3) {
            g_chatAlpha = StringToInt(StringSub(msg, 3, StringLength(msg)));
            BOTC_ChatBgApply();
            BOTC_Notice(p, "聊天黑底透明度改成：" + IntToString(g_chatAlpha) + "（越大越透明）");
            return true;
        }
    }
// 说书人的时段指令：输入「-私聊」/「-公聊」切换发言时段（自由发言已删，用户 2026-09-30）
if (p == g_teller) {
    if (msg == "-私聊") {
        BOTC_ChatModeSet(1);
        return true;
    }
    if (msg == "-公聊") {
        BOTC_ChatModeSet(2);
        return true;
    }
}
    // ⚠ 顺序要紧（用户 2026-09-19 报的 bug）：【聊天：私聊】模式下回车必须**先**走这条，
    //   不能让它落到下面「私聊时段不许公聊」那一关 ---- 那一关会直接把这次输入吞掉，
    //   只弹一句「现在是私聊时间，先在面板上跟人单独聊」，打出去的私聊永远发不出去。
    //   这里只负责转交；能不能发由 BOTC_SayPmText 自己判（不在私聊里 / 时段或阶段不允许时它只提示、不发）。
    if (g_chatSay[p] == 1) {
        BOTC_SayPmText(p, msg);
        return true;
    }
    // 白天时段限制：私聊时间不许公聊（说书人例外，他要用公聊播报）
    if (g_chatMode == 1 && !g_cultOn) {
        if (p != g_teller) {
            BOTC_Notice(p, "现在是私聊时间，先在面板上跟人单独聊；公聊要等公聊时间。");
            return true;
        }
    }
    // 提名阶段的发言限制：只有当前发言者（以及说书人）能说话
    if (g_phase == 1) {
        if (p != g_teller) {
            BOTC_Notice(p, "提名环节请保持安静，等有人发起提名。");
            return true;
        }
    }
    if (g_phase == 2) {
        if (p != g_teller) {
            BOTC_Notice(p, "正在选择提名对象，请保持安静。");
            return true;
        }
    }
    if (g_phase == 3) {
        if (p != g_teller && BOTC_PosOf(p) != g_nomFrom) {
            BOTC_Notice(p, "现在是 " + BOTC_NameStr(g_nomFrom) + " 的发言时间，请等他结束。");
            return true;
        }
    }
    if (g_phase == 4) {
        if (p != g_teller && BOTC_PosOf(p) != g_nomTo) {
            BOTC_Notice(p, "现在是 " + BOTC_NameStr(g_nomTo) + " 的反驳时间，请等他结束。");
            return true;
        }
    }
    if ((g_phase == 5 || g_phase == 6) && !g_cultOn) {
        if (p != g_teller) {
            BOTC_Notice(p, "投票 / 统计阶段请保持安静。");
            return true;
        }
    }
    if (p == g_teller) {
        tag = "";                      // 说书人那格由 BOTC_LineText 渲染成「[说书人] 他的玩家ID」
    }
    else {
        tag = "";                      // 玩家：真实号已经写在名字里了（[2]玩家1），这里不再重复
    }
    BOTC_PubSay(p, tag, msg);
    return true;
}

// 聊天/打字这条输入路径也打标记（跟点界面一样：这期间冒出来的提示别写进私聊日志）
bool BOTC_Chat_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_ChatDo(testConds, runActions);
    g_inClick = false;
    return r;
}

//--------------------------------------------------------------------------------------------------
// 初始化
//--------------------------------------------------------------------------------------------------
// 切换白天的发言时段：0 = 自由 / 1 = 只能私聊 / 2 = 只能公聊。全场播报一句，并在日志留痕。
void BOTC_PullAllToPublic () {
    int p;
    // 【换说书人之后玩家 1 也是玩家】（用户 2026-10-19 报「在私聊里但显示不在」）：
    //   原来只踢 2..13，玩家 1 的私聊会话会留着 → 人还在私聊里、聊天按钮却切回公聊，状态对不上。
    // 【批量踢】（用户 2026-10-19）：原来每踢一个人都重刷 13 份会话列表 → 进提名 / 入夜会卡一下、第一次点击像没反应。
    g_bulkLeave = true;
    for (p = 1; p <= 13; p += 1) {
        if (p == g_teller) {
            continue;
        }
        BOTC_ForceLeave(p);
    }
    g_bulkLeave = false;
    BOTC_RefreshSessListAll();
    for (p = 1; p <= 13; p += 1) {
        g_chatSay[p] = 0;
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：公聊"), PlayerGroupSingle(p));
    }
}

void BOTC_ChatModeSet (int m) {
    int i;
    // 夜里固定公聊：**不能切成私聊 / 自由**（用户 2026-09-17 要求）。
    //   夜里说书人的【聊天：...】按钮已经收起来了，这里再兜一层，防止聊天指令绕过去。
    if (g_isNight && m != 2) {
        BOTC_Notice(g_teller, "现在是夜晚：发言固定为公聊，等天亮再切时段。");
        return;
    }
    if (g_chatMode == m) {
        return;
    }
    g_chatMode = m;
    if (m == 1) {
        BOTC_PubAnnounce("【时段】私聊时间：现在只能私聊，公聊暂时关闭。");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("私聊时间（只能私聊）"));
    }
    else {
        if (m == 2) {
            BOTC_PubAnnounce("【时段】公聊时间：现在只能公聊，私聊暂时关闭。");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("公聊时间（只能公聊）"));
        }
        else {
            BOTC_PubAnnounce("【时段】自由发言：公聊和私聊都可以。");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("自由发言时间"));
        }
    }
    BOTC_ChatBtnRender();
    // 私聊阶段：非说书人锁定成私聊；进入公聊阶段解除（用户 2026-09-30）
    //   解除时：不在私聊里的自动切回公聊，还在私聊里的保持私聊
    //   【换说书人之后玩家 1 也是玩家】（用户 2026-10-19）：别再写死 2..13
    for (i = 1; i <= 13; i += 1) {
        if (i == g_teller) {
            continue;
        }
        if (m == 1) {
            g_chatSay[i] = 1;
        }
        else {
            if (g_mySess[i] == 0) {
                g_chatSay[i] = 0;
            }
        }
        BOTC_SayRender(i);
    }
    // 白天（正式开局之后）按时段放背景音乐：自由 / 私聊一首，公聊一首
    //   优先级 1：提名阶段（2）和夜晚（3）放的音乐不会被这里盖掉
    BOTC_DayMusicRefresh(2.5);        // 白天里的「时段切换」用 2.5 秒（昼夜切换才是 4 秒）
}

// 说书人按【聊天：...】按钮：公聊 ↔ 私聊（用户 2026-09-30：自由发言已删）
void BOTC_ChatBtnClick () {
    if (g_chatMode == 1) {
        BOTC_ChatModeSet(2);           // 私聊 → 公聊
    }
    else {
        BOTC_ChatModeSet(1);           // 公聊 → 私聊
    }
}

// 【聊天：公聊/私聊】开关：所有玩家都用这一套（用户 2026-09-30：说书人也跟其他玩家一样，切自己的）
// 按自己那份状态刷新按钮文字
void BOTC_SayRender (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_chatSay[p] == 1) {
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：私聊"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：公聊"), PlayerGroupSingle(p));
    }
}

void BOTC_SayToggle (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 私聊阶段：非说书人被锁定成私聊，点按钮也切不回公聊（用户 2026-09-30）
    if (g_chatMode == 1 && !g_cultOn && p != g_teller) {
        g_chatSay[p] = 1;
        BOTC_SayRender(p);
        BOTC_Notice(p, "现在是私聊时间：自动保持【私聊】，到了公聊时间才会解除。");
        return;
    }
    if (g_chatSay[p] == 1) {
        g_chatSay[p] = 0;
        BOTC_SayRender(p);
        BOTC_Notice(p, "已切回【公聊】：回车打的内容全桌可见。");
    }
    else {
        g_chatSay[p] = 1;
        BOTC_SayRender(p);
        BOTC_Notice(p, "已切到【私聊】：回车打的内容只进你当前的私聊（没在私聊里会提示）。");
    }
}

void BOTC_HotSwitch (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_SayToggle(p);
}

// 【一键切换公聊 / 私聊】（用户 2026-09-30）：按 Tab（＝"选择英雄 1"那个槽）切自己那份，含说书人
bool BOTC_HotKey_Func (bool testConds, bool runActions) {
    if (runActions) {
        g_pmBoxOnlyNow = true;      // 只进聊天框、不进日志（用户 2026-09-30）
        BOTC_HotSwitch(EventPlayer());
        g_pmBoxOnlyNow = false;
    }
    return true;
}

// 刷新说书人那个按钮的文字：显示当前"时段"（公聊时间 / 私聊时间）
void BOTC_ChatBtnRender () {
    if (g_chatBtn == 0) {
        return;
    }
    if (g_chatMode == 1) {
        libNtve_gf_SetDialogItemText(g_chatBtn, StringToText("聊天：私聊"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_chatBtn, StringToText("聊天：公聊"), PlayerGroupSingle(g_teller));
    }
}

//--------------------------------------------------------------------------------------------------
// 【快进到提名】全体玩家投票（用户 2026-09-16 要求）
//   · 屏幕最上方一个按钮（**只有玩家 2..13 有**；说书人没有这个投票），文字里带票数「快进到提名 3/6」
//   · 投满 80%：智能说书人**直接强制**开提名环节；真人说书那边只显示票数，快不快进由他自己决定
//   · 只有「正式开局后的白天、自由活动阶段（g_phase == 0）」能投票 ----
//     提名阶段和夜晚按钮直接收起，点了也会被拒
//   · 进入提名阶段（以及新的一天 / 换局）会把票数清空
//--------------------------------------------------------------------------------------------------

// 需要几票：在场且活着的玩家（不含说书人）的 80%，向上取整（5 人 = 4 票、10 人 = 8 票）
int BOTC_SkipNeed () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return 0;
    }
    return ((n * 8) + 9) / 10;
}

// 现在几票（只算在场、还活着的人）
int BOTC_SkipCount () {
    int p;
    int n;
    n = 0;
    for (p = 2; p <= 13; p += 1) {
        if (g_seatOn[p] && !BOTC_SeatDead(p)) {
            if (g_skipVote[p]) {
                n = n + 1;
            }
        }
    }
    return n;
}

void BOTC_SkipRender () {
    int n;
    int need;
    string s;
    if (g_skipBtn == 0) {
        return;
    }
    // 提名阶段 / 夜晚 / 还没正式开始：收起（= 不能投票）
    if (!g_started || g_isNight || g_phase != 0) {
        DialogSetVisible(g_skipDlg, PlayerGroupAll(), false);
        return;
    }
    n = BOTC_SkipCount();
    need = BOTC_SkipNeed();
    s = "快进到提名 " + IntToString(n) + "/" + IntToString(need);
    DialogSetVisible(g_skipDlg, PlayerGroupAll(), true);
    // 玩家 2..13：按钮（能按）；说书人：同一位置只有一行字（无边框，跟聊天框一样）
    libNtve_gf_SetDialogItemText(g_skipBtn, StringToText(s), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_skipLbl, StringToText("快进提名票数 " + IntToString(n) + "/" + IntToString(need)), PlayerGroupSingle(g_teller));
    // 【按说书人判，不写死玩家号】（用户 2026-10-09）：换过说书人之后 1 号位就是普通玩家，他也要能投快进票。
    DialogControlSetVisible(g_skipBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_skipBtn, PlayerGroupSingle(g_teller), false);   // 说书人只读票数
    DialogControlSetVisible(g_skipLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_skipLbl, PlayerGroupSingle(g_teller), true);
}

// 清空票数（进提名阶段 / 新的一天 / 换局）
void BOTC_SkipReset () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        g_skipVote[p] = false;
    }
    BOTC_SkipRender();
}

// 点【快进到提名】：投票 / 再点一次取消；投满 80% 时智能说书人强制执行
void BOTC_SkipClick (int p) {
    int n;
    int need;
    if (g_who[p] == g_teller) {
        return;                        // 说书人没有这个投票（他那边是只读的票数）
    }
    if (!g_started || g_isNight || g_phase != 0) {
        BOTC_Notice(g_who[p], "现在不能投票：只有白天自由活动的时候能投（提名阶段和夜晚都不行）。");
        return;
    }
    if (!g_seatOn[p] || BOTC_SeatDead(p)) {
        return;
    }
    g_skipVote[p] = !g_skipVote[p];
    n = BOTC_SkipCount();
    need = BOTC_SkipNeed();
    BOTC_SkipRender();
    if (g_skipVote[p]) {
        BOTC_PubAnnounce("【快进】" + BOTC_NameStr(p) + " 投票快进到提名阶段（" + IntToString(n) + "/" + IntToString(need) + "）。");
    }
    else {
        BOTC_PubAnnounce("【快进】" + BOTC_NameStr(p) + " 取消了快进票（" + IntToString(n) + "/" + IntToString(need) + "）。");
    }
    if (need <= 0 || n < need) {
        return;
    }
    // 真人说书人：只提示他票数够了，开不开由他自己决定
    BOTC_Notice(g_teller, "【快进】票数到 " + IntToString(n) + "/" + IntToString(need) + " 了：要不要开提名由你决定（点【进入提名环节】）。");
}

