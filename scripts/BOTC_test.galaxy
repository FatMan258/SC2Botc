//==================================================================================================
//  血染钟楼（Blood on the Clocktower）- 说书人地图
//  玩家1 = 说书人，玩家2..13 = 参与者
//  公屏：直接用星际自带聊天（回车键）打字，脚本监听后同步到面板记录区
//  私聊：请求式；加入需全体成员同意；可随时退出；说书人免请求。
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// 【按句柄踢人 · 黑名单】（用户 2026-10-02）
//   名单**写在这份脚本里**（不依赖本地存档 ---- 被封的人删自己的 Banks / 缓存也没用），
//   开局时按每个真人座位的 Battle.net 句柄检查，命中就 KickFromGame 踢出去。
//   怎么填、怎么用见文件靠下的「按句柄踢人」那一段（BOTC_BanListInit / BOTC_BanCheck）。
//--------------------------------------------------------------------------------------------------
string[32]  g_banHandle;       // 黑名单：一行一个句柄（子串匹配、大小写不敏感）
int         g_banHandleN;      // 名单实际条数（BOTC_BanListInit 里改）

//--------------------------------------------------------------------------------------------------
// 【玩家离开游戏】（用户 2026-10-02）：**在公聊里播**一句「玩家N 离开了小镇」（「离开了小镇」四个字走 BOTC_KeyColor 的红字）。
//   · 一个人只播一次（g_leftShown 记账，换局清零）；检测走 0.5 秒 tick 里的 BOTC_LeftCheck()。
//--------------------------------------------------------------------------------------------------
bool[14]    g_leftShown;      // 这一局已经为他播过了

//--------------------------------------------------------------------------------------------------
// 【投票踢人】（用户 2026-10-02）：聊天里发 -kick → 弹魔典点一个座位 → 对他发起踢出投票；
//   公聊播「A 对 B 发起了踢出投票」；屏幕中间弹一个**没有背景**的对话框（左下【是】/ 右下【否】/ 底部居中票数）；
//   赞成票严格过半（场上人数 / 2 向下取整 + 1）就把他 KickFromGame 踢出去；60 秒没投完作废。
//--------------------------------------------------------------------------------------------------

int         g_kickTar;        // 被投票踢的人（0 = 没有投票在跑）
int         g_kickMode;       // 谁正在用 -kick 选人（0 = 没人在选）
int         g_kickBy;         // 这次投票是谁发起的（发起人一定能投，说书人发起时也能投）
int[14]     g_kickVote;       // 每人投的：0 没投 / 1 是 / 2 否
int         g_kickSec;        // 剩余秒数（超时作废）
int         g_kickHalf;       // 0.5 秒 tick 里数到 2 才算 1 秒
int         g_kickDlg;
int         g_kickTitle;
int         g_kickYes;
int         g_kickNo;
int         g_kickCnt;

//--------------------------------------------------------------------------------------------------
// 界面控件
//--------------------------------------------------------------------------------------------------
int[14]     g_title;
int[14]     g_pmEdit;
int[14]     g_pmSend;
int[14]     g_tip;
int[14]     g_leaveBtn;
int[14]     g_joinBtn;
bool[14]    g_pmPick;             // 「发起私聊」选人模式：正在魔典上选私聊对象（每个玩家各自记）
int[14]     g_joinPopBtn;         // 【请求加入】按钮（在说书人面板里、【发起私聊】正右方；列表里选中私聊时才冒出来）
int[14]     g_joinPopOn;          // 【请求加入】当前是不是显示着（缓存一下，免得每 0.5 秒反复设置控件）
int[14]     g_inviteBtn;          // 【邀请加入】按钮（私聊面板右下角；只有说书人在某条私聊里时才冒出来）
bool[14]    g_inviteOn;           // 【邀请加入】当前是不是显示着（缓存）
bool        g_invitePick;         // 说书人正在「点一个玩家 → 拉进当前私聊」
int[14]     g_dissolveBtn;        // 【解散私聊】按钮（私聊面板右下角，紧挨着【邀请加入】；只有说书人在某条私聊里时才冒出来）
bool[14]    g_dissolveOn;         // 【解散私聊】当前是不是显示着（缓存）
int         g_saySeatBtn;         // 魔典上的「说书人」格子（透明按钮：平时不可点，只在「发起私聊」选人模式里能点）
int         g_saySeatLbl;         // 「说书人」格子里的那行字（只有三个字，没有座位号、没有图标）

int[14]     g_sessTitle;
int[14]     g_sessList;
int[196]    g_listSess;
int[14]     g_reqLabel;
int[14]     g_reqYes;
int[14]     g_reqNo;
int[14]     g_hideBtn;
int[14]     g_panelDlg;
int[14]     g_miniDlg;
int[14]     g_expandBtn;
int[14]     g_logBtnDlg;
int[14]     g_logDlgBtn;

