    libNtve_gf_SetDialogItemAcceptMouse(g_pickAlignLbl, false, PlayerGroupAll());
    g_pickGoodBtn = BOTC_NewButton(g_pickDlg, 220, 64, 930, 76, "善良");
    libNtve_gf_CreateDialogItemImage(g_pickDlg, 48, 48, c_anchorTopLeft, 936, 84, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_pickGoodIcon = DialogControlLastCreated();
    libNtve_gf_SetDialogItemAcceptMouse(g_pickGoodIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_pickGoodIcon, "botc_tk_good.dds", PlayerGroupAll());
    g_pickEvilBtn = BOTC_NewButton(g_pickDlg, 220, 64, 930, 148, "邪恶");
    libNtve_gf_CreateDialogItemImage(g_pickDlg, 48, 48, c_anchorTopLeft, 936, 156, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_pickEvilIcon = DialogControlLastCreated();
    libNtve_gf_SetDialogItemAcceptMouse(g_pickEvilIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_pickEvilIcon, "botc_tk_evil.dds", PlayerGroupAll());
    DialogControlSetVisible(g_pickAlignLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickGoodBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickGoodIcon, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickEvilBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickEvilIcon, PlayerGroupAll(), false);
    g_pickClear = BOTC_NewButton(g_pickDlg, 220, 40, 320, 812, "清除身份");
    g_pickClose = BOTC_NewButton(g_pickDlg, 220, 40, 630, 812, "取消");
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
}

// token 面板
// token 面板：一格 = 透明按钮 + 图标 + 下面一行小字
//   图标 = 由身份图缩出来的 48×48 小图（botc_tkNN.dds）---- 星际的图片控件不缩放、只裁剪，
//   所以控件尺寸必须和图片尺寸对齐（拿 128×128 的身份图塞小格子只会显示一小块）
void BOTC_BuildTok () {
    int t;
    DialogCreate(1053, 594, c_anchorRight, 150, -70, false);      // token 面板：一页 5 行（35 格），多的翻页（用户 2026-09-20）
    g_tokDlg = DialogLastCreated();
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    g_tokTitle = BOTC_NewLabel(g_tokDlg, 990, 30, 14, 7, StringToText("添加 token"));
    // 一格 160×92：上半 48×48 的图、下半一行小字；7 列 × 3 行
    //   隐形槽（18）不占格子，位置由 BOTC_TokRender 按「他实际能看到的第几个」重排
    for (t = 0; t < 256; t += 1) {
        g_tokBtn[t] = BOTC_NewButton(g_tokDlg, 83, 83, 11 + ((t % 7) * 148), 40 + ((t / 7) * 86), "");
        libNtve_gf_CreateDialogItemImage(g_tokDlg, 43, 43, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_tokIconCtl[t] = DialogControlLastCreated();
        DialogControlSetSize(g_tokIconCtl[t], PlayerGroupAll(), 43, 43);
        libNtve_gf_SetDialogItemAcceptMouse(g_tokIconCtl[t], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_tokIconCtl[t], "botc_blank.dds", PlayerGroupAll());
        DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupAll(), false);
        g_tokLbl[t] = BOTC_NewLabel(g_tokDlg, 144, 18, 11 + ((t % 7) * 148), 88 + ((t / 7) * 86), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_tokLbl[t], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_tokLbl[t], false, PlayerGroupAll());
        DialogControlSetVisible(g_tokLbl[t], PlayerGroupAll(), false);
    }
    // 翻页那一行（上下页 + 页码）
    g_tokPrev = BOTC_NewButton(g_tokDlg, 180, 27, 11, 491, "上一页");
    g_tokNext = BOTC_NewButton(g_tokDlg, 180, 27, 862, 491, "下一页");
    g_tokPageLbl = BOTC_NewLabel(g_tokDlg, 630, 30, 212, 491, StringToText("第 1 / 1 页"));
    libNtve_gf_SetDialogItemStyle(g_tokPageLbl, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_tokPageLbl, false, PlayerGroupAll());
    g_tokClear = BOTC_NewButton(g_tokDlg, 250, 34, 11, 536, "清除全部");
    g_tokClose = BOTC_NewButton(g_tokDlg, 250, 34, 268, 536, "关闭");
}

int BOTC_Lerp (int a, int b, int num, int den) {
    return a + (((b - a) * num) / den);
}

// 在 r0..r1 里随机挑一个还没用过的身份
int BOTC_PickUnused (int r0, int r1) {
    int k;
    int i;
    for (i = 0; i < 300; i += 1) {
        k = RandomInt(r0, r1);
        if (!g_scrUsed[k]) {
            g_scrUsed[k] = true;
            return k;
        }
    }
    return r0;
}

// ob = 正在看魔典的玩家（每个人的标记只有自己看得到）
// 圆桌上每个座位 4 个小格：迷你图 + 小字；隐形槽（18 = 镇长记账）不画。
//   死亡 token 现在所有人（含玩家）都能打：10 = 处决，16 = 小恶魔，19 = 猎手。

// 【间谍 / 寡妇偷看说书人魔典时，哪些 token 还给看】（用户 2026-09-30）：
//   只留「真身类」8 = 是酒鬼 / 49 = 是疯子 / 70 = 是哲学家，和「阵营类」14 = 善良 / 15 = 邪恶；
//   其余（中毒 / 醉酒 / 保护 / 死亡 / 是恶魔 / 各种记账）一律看不到。
bool BOTC_PeekTokVisible (int t) {
    if (t == 8 || t == 49 || t == 70) {
        return true;
    }
    if (t == 14 || t == 15) {
        return true;
    }
    return false;
}

void BOTC_GrimRender (int ob) {
    int i;
    int q;
    int t;
    int n;
    int k;
    int markVal;
    bool isD;
    bool snap;
    int src;                 // 【-grim n】这一份魔典要读哪一行（默认 = 自己那一行 ob）
    // 【-grim n】（用户 2026-10-07）：这个玩家正在"看别人那份魔典"时，下面所有"读我自己那一行"的地方
    //   改成读**对方那一行**；数据一个字都不改，所以随时能切回、也不会串到别人身上。
    src = ob;
    snap = false;
    if (g_grimViewOn[ob]) {
        src = g_grimView[ob];
    }
    else if (g_grimSnapOn[ob]) {
        snap = true;
    }
    // 【自愈】（用户 2026-09-30）：偷看早就结束了（g_spyP 已经清掉）却还留着「不给 token」的标记 → 立刻清掉。
    //   正常路径（收回唤醒 / 天亮 / 重新发牌 / 寡妇点完座位）都会走 BOTC_SpyPeekEnd() 清它，这里只是兜底。
    if (g_peekNoTok >= 2 && g_spyP != g_peekNoTok) {
        g_peekNoTok = 0;
    }
    // 【哲学家的「醉酒（哲学家）」每次重画魔典都同步一次】（用户 2026-09-21）：
    //   哲学家一中毒 / 酒鬼 / 死亡，那份醉酒立刻从他选的那个角色身上摘掉；他恢复清醒再自动加回来。
    if (ob == g_teller) {
        BOTC_PhiloDrunkSync();
    }
    // 【换座位后的说书人也要看得见自己那格的头像】（用户 2026-10-18）：按「现在的」说书人设一次
    DialogControlSetVisible(g_saySeatIcon, PlayerGroupAll(), false);
    DialogControlSetVisible(g_saySeatIcon, PlayerGroupSingle(g_teller), true);
    // 「说书人」那一格的名字行：只有「说书人 [战网名]」---- 身份只体现在头像上（用户 2026-09-26：括号里的去掉）
    libNtve_gf_SetDialogItemText(g_saySeatLbl, StringToText("说书人 [") + TextWithColor(PlayerName(g_teller), libNtve_gf_ConvertPlayerColorToColor(g_seatColor[1])) + StringToText("]"), PlayerGroupSingle(ob));   // 【说书人 = 游戏原生粉】（用户 2026-10-14）
    if (snap) {
        markVal = g_grimSnapMark[(ob * 14) + 1];
    }
    else {
        markVal = g_mark[(src * 14) + 1];
    }
    if (markVal > 0) {
        if (ob == g_teller) {
            libNtve_gf_SetDialogItemImage(g_saySeatIcon, BOTC_IconName(markVal - 1), PlayerGroupSingle(g_teller));
        }
    }
    else {
        if (ob == g_teller) {
            libNtve_gf_SetDialogItemImage(g_saySeatIcon, "botc_blank.dds", PlayerGroupSingle(g_teller));
        }
    }
    // 说书人自己那一格的红叉（跟座位那边一样：只有「公开死亡」才画）
    DialogControlSetVisible(g_saySeatDead, PlayerGroupSingle(ob), BOTC_PublicDead(1));
    for (i = 0; i < 12; i += 1) {
        q = i + 2;
        // 身份那一行在**头像正上方**：有身份才写；没发牌就留空（用户 2026-09-19：删掉「未定」两个字）
        if (snap) {
            markVal = g_grimSnapMark[(ob * 14) + q];
        }
        else {
            markVal = g_mark[(src * 14) + q];
        }
        if (markVal > 0) {
            libNtve_gf_SetDialogItemText(g_grimRole[q], TextWithColor(StringToText(g_roleName[markVal - 1]), BOTC_RoleTeamColor(markVal - 1)), PlayerGroupSingle(ob));
            libNtve_gf_SetDialogItemImage(g_grimIcon[q], BOTC_IconName(markVal - 1), PlayerGroupSingle(ob));
        }
        else {
            libNtve_gf_SetDialogItemText(g_grimRole[q], StringToText(""), PlayerGroupSingle(ob));
            libNtve_gf_SetDialogItemImage(g_grimIcon[q], "botc_blank.dds", PlayerGroupSingle(ob));
        }
        libNtve_gf_SetDialogItemStyle(g_grimRole[q], g_grimNameStyle, PlayerGroupSingle(ob));
        // 名字那一行在**头像下方、居中**：编号（白字）+ [玩家名]。
        //   【换位 BUG】（用户 2026-10-07 报「换完我坐的那格不显示我的战网名」）：名字必须取
        //   `g_who[q]`（这个位置现在坐的**人**），不能写 `PlayerName(q)`（那是物理座位 q 上的人，
        //   换说书人时人对调了、物理座位没动 → 会显示成对方的名字）。颜色仍按位置 g_seatColor[q]。
        libNtve_gf_SetDialogItemText(g_grimName[q], StringToText(IntToString(g_lab[q] + g_nameNumShift) + " [") + TextWithColor(PlayerName(g_who[q]), libNtve_gf_ConvertPlayerColorToColor(g_seatColor[q])) + StringToText("]"), PlayerGroupSingle(ob));
        libNtve_gf_SetDialogItemStyle(g_grimName[q], g_grimNameStyle, PlayerGroupSingle(ob));
        // 死亡红叉：只有「公开死亡」（处决 / 死亡标记 / 小恶魔天亮刀 / 猎手射中）才给全桌显示；
        //   单纯用死亡 token 记的（只给技能检测用）别人看不到红叉
        DialogControlSetVisible(g_grimDead[q], PlayerGroupSingle(ob), (BOTC_PublicDead(q) && g_seatOn[q]));
        // 把这个座位上亮着的 token 依次填进 4 个小格（迷你图 + 小字；隐形槽不画）
        //   【分两轮画】（用户 2026-09-20）：第一轮先画「死亡类」token（死亡标记永远优先显示，
        //   不会被中毒 / 醉酒 / 免死这些挤掉），第二轮再画其它。
        n = 0;
        for (k = 0; k < 2; k += 1) {
            for (t = 0; t < 256; t += 1) {
                // 【间谍 / 寡妇偷看：现在 token 全都能看】（用户 2026-10-04 要求解除旧限制）：
                //   这里原来有一层过滤（`ob == g_peekNoTok` + `BOTC_PeekTokVisible`）——
                //   只放行「真身 / 阵营」两类标记，其余 token 一律不显示。现在整段拿掉，
                //   偷看时和说书人自己看到的完全一样（身份 + 所有 token + 红叉照旧规则）。
                if (snap) {
                    if (!g_grimSnapTok[(((ob * 14) + q) * 256) + t]) {
                        continue;
                    }
                }
                else {
                    if (!g_tokOn[(((src * 14) + q) * 256) + t]) {
                        continue;
                    }
                }
                if (BOTC_TokHidden(t, ob)) {
                    // 【间谍 / 寡妇偷看：token 全给看】（用户 2026-10-07）：偷看的是**真魔典**，
                    //   不再按"板子上有没有这个角色"过滤；只有"空槽 / 内部记账槽(18)"照旧不给。
                    if (!((g_spyP >= 2 && ob == g_who[g_spyP] && t != 18 && g_tokName[t] != "") || (snap && t != 18 && g_tokName[t] != ""))) {
                        continue;
                    }
                }
                isD = false;
                if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
                    isD = true;
                }
                if (k == 0) {
                    if (!isD) {
                        continue;
                    }
                }
                else {
                    if (isD) {
                        continue;
                    }
                }
                if (n >= 4) {
                    continue;
                }
                libNtve_gf_SetDialogItemText(g_chip[(i * 4) + n], StringToText(g_tokShort[t]), PlayerGroupSingle(ob));
                DialogControlSetVisible(g_chip[(i * 4) + n], PlayerGroupSingle(ob), true);
                if (g_tokIcon[t] == "") {
                    DialogControlSetVisible(g_chipImg[(i * 4) + n], PlayerGroupSingle(ob), false);
                }
                else {
                    libNtve_gf_SetDialogItemImage(g_chipImg[(i * 4) + n], g_tokIcon[t], PlayerGroupSingle(ob));
                    DialogControlSetVisible(g_chipImg[(i * 4) + n], PlayerGroupSingle(ob), true);
                }
                n = n + 1;
            }
        }
        for (t = n; t < 4; t += 1) {
            DialogControlSetVisible(g_chip[(i * 4) + t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_chipImg[(i * 4) + t], PlayerGroupSingle(ob), false);
        }
    }
}

void BOTC_PickAlignRender (int p) {
    bool show;
    if (p < 1 || p > 13) {
        return;
    }
    show = (p == g_teller && g_pickMode[p] == 0 && g_pickWho[p] >= 2 && g_pickWho[p] <= 13);
    DialogControlSetVisible(g_pickAlignLbl, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickGoodBtn, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickGoodIcon, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickEvilBtn, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickEvilIcon, PlayerGroupSingle(p), show);
    if (!show) {
        return;
    }
    if (g_pickForceAlign == 0) {
        libNtve_gf_SetDialogItemText(g_pickGoodBtn, TextWithColor(StringToText("√ 善良"), Color(120, 255, 120)), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickGoodBtn, StringToText("善良"), PlayerGroupSingle(p));
    }
    if (g_pickForceAlign == 1) {
        libNtve_gf_SetDialogItemText(g_pickEvilBtn, TextWithColor(StringToText("√ 邪恶"), Color(255, 69, 0)), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickEvilBtn, StringToText("邪恶"), PlayerGroupSingle(p));
    }
}

void BOTC_PickAlignToggle (int which) {
    if (g_pickMode[g_teller] != 0 || g_pickWho[g_teller] < 2 || g_pickWho[g_teller] > 13) {
        return;
    }
    if (which == 0) {
        if (g_pickForceAlign == 0) {
            g_pickForceAlign = -1;
        }
        else {
            g_pickForceAlign = 0;
        }
    }
    else {
        if (g_pickForceAlign == 1) {
            g_pickForceAlign = -1;
        }
        else {
            g_pickForceAlign = 1;
        }
    }
    BOTC_PickAlignRender(g_teller);
}

// 选角色后调用：先撤掉两种强制阵营 token，再按当前勾选写回。
void BOTC_PickApplyAlign (int seat) {
    int base;
    if (seat < 2 || seat > 13) {
        return;
    }
    if (g_pickMode[g_teller] != 0) {
        return;
    }
    base = (((g_teller * 14) + seat) * 256);
    g_tokOn[base + 14] = false;
    g_tokOn[base + 15] = false;
    if (g_pickForceAlign == 0) {
        g_tokOn[base + 14] = true;
    }
    else {
        if (g_pickForceAlign == 1) {
            g_tokOn[base + 15] = true;
        }
    }
    BOTC_PairClearSeat(seat);
    BOTC_SeatStateSync();
}

void BOTC_PickOpen (int ob, int who) {
    g_pickMode[ob] = 0;
    g_pickWho[ob] = who;
    g_pickForceAlign = -1;
    if (ob == g_teller && who >= 2 && who <= 13) {
        if (g_tokOn[((((g_teller * 14) + who) * 256) + 15)]) {
            g_pickForceAlign = 1;
        }
        else {
            if (g_tokOn[((((g_teller * 14) + who) * 256) + 14)]) {
                g_pickForceAlign = 0;
            }
        }
    }
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_PlayerNameText(who) + StringToText(" 的身份"), PlayerGroupSingle(ob));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));   // 赌徒猜角色模式改过它，这里恢复
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

//--------------------------------------------------------------------------------------------------
// 【手动配板】（用户 2026-09-19）：魔典底部右边（和【确认发放】轴对称）的入口按钮 + 面板
//   面板和「选身份面板」同一套图标网格：85 中图标 + 角色名 + 四个彩色类别标题；
//   左边多一列名额（如 5/5），选中打 √ 变绿；底部【随机发放】【发给座位】【关闭】。
//   名额按人数配比表算；选了男爵 → 外来者 +2、镇民 -2；镇民占满时选不了男爵。
//--------------------------------------------------------------------------------------------------
void BOTC_RsQuotaUpdate () {
    int n;
    n = g_seatN;
    if (n < 2) {
        n = 2;
    }
    if (n > 13) {
        n = 13;
    }
    g_rsQuota[0] = g_tcTab[n];
    g_rsQuota[1] = g_ocTab[n];
    g_rsQuota[2] = g_mcTab[n];
    g_rsQuota[3] = 1;
    if (g_rsPick[20]) {              // 男爵：外来者 +2、镇民 -2
        g_rsQuota[1] = g_rsQuota[1] + 2;
        g_rsQuota[0] = g_rsQuota[0] - 2;
        if (g_rsQuota[0] < 0) {
            g_rsQuota[0] = 0;
        }
    }
    // 【哨兵（88）】（用户 2026-09-26）：被加进本局时，外来者按他选的 -1 / 0 / +1 调整
    if (g_legacyOn[88] && g_sentAdjust != 0) {
        g_rsQuota[1] = g_rsQuota[1] + g_sentAdjust;
        g_rsQuota[0] = g_rsQuota[0] - g_sentAdjust;
        if (g_rsQuota[0] < 0) {
            g_rsQuota[0] = 0;
        }
        if (g_rsQuota[1] < 0) {
            g_rsQuota[1] = 0;
        }
    }
    if (g_rsPick[68]) {
        g_rsQuota[1] = g_rsQuota[1] + 1;
        g_rsQuota[0] = g_rsQuota[0] - 1;
        if (g_rsQuota[0] < 0) {
            g_rsQuota[0] = 0;
        }
    }
    if (g_rsPick[69]) {
        if (g_rsQuota[1] > 1) {
            g_rsQuota[1] = g_rsQuota[1] - 1;
            g_rsQuota[0] = g_rsQuota[0] + 1;
        }
    }
}

int BOTC_RsPickedCount (int team) {
    int i;
    int b;
    int c;
    int r;
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    c = 0;
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == team && g_rsPick[r]) {
            c = c + 1;
        }
    }
    return c;
}

// 刷一遍：图标名字的 √ / 绿色 + 四个名额文字
void BOTC_RsRender (int p) {
    int r;
    int t;
    int n;
    int pages;
    int rows;
    int shownRows;
    string s;
    BOTC_RsQuotaUpdate();
    for (r = 0; r < g_gridN; r += 1) {
        if (g_rsPick[g_gridSlot[r]]) {
            libNtve_gf_SetDialogItemText(g_rsName[r], TextWithColor(StringToText("√"), Color(120, 255, 120)) + StringToText(" ") + TextWithColor(StringToText(g_roleName[g_gridSlot[r]]), BOTC_RoleTeamColor(g_gridSlot[r])), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_rsName[r], TextWithColor(StringToText(g_roleName[g_gridSlot[r]]), BOTC_RoleTeamColor(g_gridSlot[r])), PlayerGroupSingle(p));
        }
    }
    for (t = 0; t < 4; t += 1) {
        s = "已选 " + IntToString(BOTC_RsPickedCount(t));
        pages = BOTC_GridCatPages(t, BOTC_GridCatCap(t));
        rows = (g_gridCatN[t] + 6) / 7;
        shownRows = (g_gridTeamN[t] + 6) / 7;
        if (g_gridCatN[t] > 0) {
            s = s + " · 第" + IntToString(g_rsCatPage[t]) + "/" + IntToString(pages) + "页";
            s = s + " · 本页" + IntToString(shownRows) + "行/共" + IntToString(rows) + "行";
        }
        libNtve_gf_SetDialogItemText(g_rsQuotaLbl[t], StringToText(s), PlayerGroupSingle(p));
        DialogControlSetVisible(g_rsCatPrev[t], PlayerGroupSingle(p), (pages > 1));
        DialogControlSetVisible(g_rsCatNext[t], PlayerGroupSingle(p), (pages > 1));
    }
    n = BOTC_RsPickedCount(0) + BOTC_RsPickedCount(1) + BOTC_RsPickedCount(2) + BOTC_RsPickedCount(3);
    s = "手动配板：已选 " + IntToString(n) + " / " + IntToString(g_seatN) + "（点角色打勾，选够人数再点【发给座位】）";
    if (n == g_seatN) {
        libNtve_gf_SetDialogItemText(g_rsTitle, TextWithColor(StringToText(s), Color(120, 255, 120)), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_rsTitle, StringToText(s), PlayerGroupSingle(p));
    }
}

void BOTC_RsOpen (int p) {
    int q;
    int r;
    if (p != g_teller) {
        return;
    }
    // 教父（39）的配比 50/50：打开手动配板时先掷好（整局固定）
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟教父一样每局掷一次 50/50（+0 / +1 外来者）
    if (g_balPlusSeeded == false) {
        g_balPlus = (RandomInt(1, 2) == 1);
        g_balPlusSeeded = true;
    }
    if (g_gfPlusSeeded == false) {
        g_gfPlus = (RandomInt(1, 2) == 1);
        g_gfPlusSeeded = true;
        if (g_gfPlus) {
            BOTC_PmStore(g_teller, "【教父】这一局的配比方向：**外来者 +1、镇民 -1**。");
        }
        else {
            BOTC_PmStore(g_teller, "【教父】这一局的配比方向：**外来者 -1、镇民 +1**。");
        }
    }
    BOTC_GrimRelayout();
    // 先把「场上已经有的身份」勾上（先随机发牌过的话，这里就是 √ 的状态）
    for (r = 0; r < 149; r += 1) {
        g_rsPick[r] = false;
    }
    for (q = 0; q < 4; q += 1) {
        g_rsCatPage[q] = 1;
    }
    for (q = 2; q <= 13; q += 1) {
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r >= 0 && r <= 148) {
            g_rsPick[r] = true;
        }
    }
    BOTC_RsLayout();               // 打开时按当前板子摆一遍格子
    BOTC_RsRender(p);
    DialogSetVisible(g_rsDlg, PlayerGroupSingle(p), true);
}

void BOTC_RsClose (int p) {
    DialogSetVisible(g_rsDlg, PlayerGroupSingle(p), false);
}

void BOTC_RsPageTurn (int t, int delta) {
    int page;
    int pages;
    if (t < 0 || t > 3) {
        return;
    }
    BOTC_RsLayout();
    pages = BOTC_GridCatPages(t, BOTC_GridCatCap(t));
    page = g_rsCatPage[t] + delta;
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_rsCatPage[t] = page;
    BOTC_RsLayout();
    BOTC_RsRender(g_teller);
}

void BOTC_RsToggle (int p, int slot) {
    int team;
    int r;
    BOTC_RsLayout();
    if (p != g_teller || slot < 0 || slot >= g_gridN) {
        return;
    }
    r = g_gridSlot[slot];          // 格子序号 → 身份（网格按板子动态排）
    if (g_rsPick[r]) {
        g_rsPick[r] = false;
        BOTC_RsRender(p);
        return;
    }
    g_rsPick[r] = true;
    BOTC_RsRender(p);
}

// 随机配一套（爪牙那一栏可能抽出男爵，名额会跟着变）
void BOTC_RsRandom (int p) {
    int t;
    int j;
    int i;
    int k;
    int n;
    int pick;
    int[64] pool;
    if (p != g_teller) {
        return;
    }
    BOTC_RsLayout();
    for (i = 0; i < 149; i += 1) {
        g_rsPick[i] = false;
    }
    BOTC_RsQuotaUpdate();
    // 顺序：恶魔 → 爪牙 → 外来者 → 镇民（男爵会在爪牙阶段改名额，所以要放在镇民前面算）
    for (i = 0; i < 4; i += 1) {
        if (i == 0) {
            t = 3;
        }
        else {
            if (i == 1) {
                t = 2;
            }
            else {
                if (i == 2) {
                    t = 1;
                }
                else {
                    t = 0;
                }
            }
        }
        BOTC_RsQuotaUpdate();
        for (j = 0; j < g_rsQuota[t]; j += 1) {
            n = 0;
            pick = -1;
            for (k = 0; k < g_gridCatN[t]; k += 1) {      // 从这一类的完整角色池抽，不受当前页限制
                if (g_gridCatRole[(t * 128) + k] < 0 || g_gridCatRole[(t * 128) + k] > 148) {
                    continue;
                }
                if (g_rsPick[g_gridCatRole[(t * 128) + k]]) {
                    continue;
                }
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = g_gridCatRole[(t * 128) + k];
                }
            }
            if (pick >= 0) {
                g_rsPick[pick] = true;
            }
        }
    }
    BOTC_RsRender(p);
    BOTC_Notice(g_teller, "已随机配好一套（按当前板子的角色）；不满意的可以点掉重选。");
}

// 把选中的角色随机分给场上每个座位（之后照旧点魔典上的【确认发放】）
void BOTC_RsApply (int p) {
    int cnt;
    int r;
    int i;
    int k;
    int s;
    int pos;
    int[64] roles;

    if (p != g_teller) {
        return;
    }
    BOTC_ResetGameVars();          // 换局：先把上一局的记录清干净
    BOTC_GrimRelayout();
    BOTC_GrimResetPerPlayer();     // 【玩家自己那份也清空】（用户 2026-10-18）：不然会留着上一把别人的身份
    cnt = 0;
    for (r = 0; r < 149; r += 1) {
        if (g_rsPick[r]) {
            roles[cnt] = r;
            cnt = cnt + 1;
        }
    }
    if (cnt != g_seatN) {
        BOTC_Notice(g_teller, "现在选了 " + IntToString(cnt) + " 个角色，场上却有 " + IntToString(g_seatN) + " 个座位：数量要一样才能发。");
        return;
    }
    for (i = 0; i < g_seatN; i += 1) {
        g_scrSeat[i] = g_seatList[i];
    }
    for (i = 0; i < g_seatN; i += 1) {
        k = RandomInt(i, g_seatN - 1);
        s = g_scrSeat[i];
        g_scrSeat[i] = g_scrSeat[k];
        g_scrSeat[k] = s;
    }
    for (i = 0; i < cnt; i += 1) {
        BOTC_SetSeatRole(g_teller, g_scrSeat[i], roles[i]);
    }
    // 手动配板后同样执行卡扎力的设置调整
    BOTC_KazaliCompositionApply();
    g_dealConfirmed = false;
    BOTC_SailorSync();
    BOTC_TeaLadySync();        // 茶艺师（32）：角色分完立刻刷「不会死亡（茶艺师）」
    BOTC_FoolSync();           // 弄臣（34）：顺便把「首次未死」也打上
    BOTC_MarionetteSync();
    // 【随机配板最后统一清空】（用户 2026-10-20）：SetSeatRole / 提线木偶同步都不能提前下发玩家副本。
    BOTC_GrimResetPerPlayer();
    for (i = 1; i <= 13; i += 1) {
        BOTC_GrimRender(i);
    }
    BOTC_RsClose(p);
}

//--------------------------------------------------------------------------------------------------
// 【时段计时】（用户 2026-09-19 大改）
//   说书人面板（在说书人面板右侧、Y 再往下 150）：右上角一个按钮切换【公聊 / 私聊 / 自由发言】，
//   下面**只有一行**输入框填秒数，最下面【开始计时】【停止】（这两个按钮尺寸不变）。
//   面板整体（含字号）比原来放大 1/3；聊天框 400×235。
//   所有玩家屏幕上方只显示当前选的那一种：如「私聊时间：3:00」（00FFFF）。
//   AI 说书模式：跟着时段自动换类型（0 自由 / 1 私聊 / 2 公聊）并按投票填秒数。
//--------------------------------------------------------------------------------------------------
// （上面这几个计时用的变量已经挪到文件最前面的全局区，见 g_tmType 等）

string BOTC_TmName (int t) {
    if (t == 0) {
        return "公聊";
    }
    if (t == 1) {
        return "私聊";
    }
    return "自由发言";
}

string BOTC_MSS (int sec) {
    int m;
    int s;
    if (sec < 0) {
        sec = 0;
    }
    m = sec / 60;
    s = sec % 60;
    if (s < 10) {
        return IntToString(m) + ":0" + IntToString(s);
    }
    return IntToString(m) + ":" + IntToString(s);
}

void BOTC_TimerRender () {
    string s;
    s = BOTC_TmName(g_tmType) + "时间：" + BOTC_MSS(g_tmLeft);
    libNtve_gf_SetDialogItemText(g_tmLbl, TextWithColor(StringToText(s), Color(0, 255, 255)), PlayerGroupAll());
    DialogSetVisible(g_tmShowDlg, PlayerGroupAll(), g_tmOn);
    libNtve_gf_SetDialogItemText(g_tmBtnType, StringToText("计时类型：" + BOTC_TmName(g_tmType)), PlayerGroupSingle(g_teller));
}

void BOTC_TimerTick () {
    if (!g_tmOn) {
        return;
    }
    // ⚠ 这个函数挂在 g_tick 上，而 g_tick 是 **0.5 秒一拍**（TimerStart(g_tTick, 0.5, true, ...)）。
    //   以前每拍都减 1 秒，所以倒计时跑成了两倍速（用户 2026-09-19 报的 bug）----
    //   改成「凑满两拍（= 1 秒）才减 1 秒」。以后要改 g_tick 的拍子，这里跟着改。
    g_tmHalf = g_tmHalf + 1;
    if (g_tmHalf >= 2) {
        g_tmHalf = 0;
        if (g_tmLeft > 0) {
            g_tmLeft = g_tmLeft - 1;
        }
    }
    BOTC_TimerRender();
}

void BOTC_TimerStart () {
    string s;
    g_tmOn = false;                 // 有新的计时出现 -> 旧的先关掉
    BOTC_TimerRender();
    // ⚠ 输入框空着的时候 DialogItemEditValue 返回的是**空字符串**，直接 StringToInt("") 会当场报错
    //   （2026-09-19 实机报错就是这一行）→ 空的一律当 0
    s = libNtve_gf_DialogItemEditValue(g_tmEditPub, g_teller);
    if (StringLength(s) == 0) {
        g_tmSet = 0;
    }
    else {
        g_tmSet = StringToInt(s);
    }
    if (g_tmSet < 0) {
        g_tmSet = 0;
    }
    g_tmLeft = g_tmSet;
    g_tmHalf = 0;                  // 拍子从零数起（下一拍 = 0.5 秒后算第 1 拍）
    g_tmOn = true;
    BOTC_TimerRender();
    BOTC_Notice(g_teller, BOTC_TmName(g_tmType) + "计时开始：" + BOTC_MSS(g_tmSet) + "。");
}

void BOTC_TimerStop () {
    g_tmOn = false;
    BOTC_TimerRender();
}

void BOTC_TimerTypeNext () {
    g_tmOn = false;                 // 换类型也把旧计时关掉
    g_tmLeft = 0;
    g_tmType = g_tmType + 1;
    if (g_tmType > 2) {
        g_tmType = 0;
    }
    BOTC_TimerRender();
}

// 【计时表不再自动开】（用户 2026-10-16）：「一进白天就自己冒出『私聊时间：3:00』」----
//   这一段原来是「AI 说书模式」用的：跟着发言时段换类型 + 按开局投票的分钟数自动开表。
//   智能说书删掉之后它还在 0.5 秒那拍里一直跑，于是变成「一进白天自动显示倒计时」。
//   现在这里**只剩一件事**：入夜自动把条收掉。开表 / 停表一律由说书人点【开始计时】/【停】。
void BOTC_TimerAiInit () {
    if (!g_started) {
        return;
    }
    if (g_isNight) {
        if (g_tmOn) {
            g_tmOn = false;
            g_tmLeft = 0;
            BOTC_TimerRender();
        }
        g_tmAiMode = -1;
    }
}

// 计时面板收起 / 展开（参考私聊面板那套）
// 【开局前提示】：游戏正式开始之前挂在中上方，说书人 / 玩家看到的话不一样
void BOTC_BuildPreNotice () {
    DialogCreate(1500, 50, c_anchorTop, 0, 40, false);
    g_preDlg = DialogLastCreated();
    DialogSetImageVisible(g_preDlg, false);            // 不要底框，只留字
    DialogSetVisible(g_preDlg, PlayerGroupAll(), false);
    g_preLbl = BOTC_NewLabel(g_preDlg, 1500, 50, 150, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_preLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_preLbl, false, PlayerGroupAll());
    // 先给所有人写玩家版，再单独把说书人那份改成主持版
    libNtve_gf_SetDialogItemText(g_preLbl, TextWithColor(StringToText("游戏尚未开始，请耐心等待说书人分配角色开始游戏，点击右侧游戏规则按钮翻看游戏规则。"), Color(255, 0, 0)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_preLbl, TextWithColor(StringToText("你是游戏的主持人。点击右侧游戏帮助查看说书人手册，点击魔典为玩家发放身份并开始游戏。"), Color(255, 0, 0)), PlayerGroupSingle(g_teller));
}

void BOTC_TimerToggle () {
    g_tmHidden = !g_tmHidden;
    if (g_tmHidden) {
        DialogSetVisible(g_tmDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_tmDlg, PlayerGroupSingle(g_teller), true);
    }
}

