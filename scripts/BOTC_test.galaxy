// 画一行：col 0 = 首夜 / 1 = 第二夜起，row 0..11，r = 身份索引
void BOTC_NightOrderRow (int p, int col, int row, int r) {
    int idx;
    int x;
    int y;
    idx = (col * 12) + row;
    x = 40 + (col * 490);
    y = 60 + (row * 84);
    libNtve_gf_SetDialogItemImage(g_noIcon[idx], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_noIcon[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetVisible(g_noIcon[idx], PlayerGroupSingle(p), true);
    libNtve_gf_SetDialogItemText(g_noName[idx], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[idx], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 97, y + 30);
    DialogControlSetVisible(g_noName[idx], PlayerGroupSingle(p), true);
}

// 铺内容：左栏「首夜」（第 0 行固定写爪牙与恶魔互相得知）、右栏「第二夜起」
void BOTC_NightOrderRender (int p) {
    int i;
    int r;
    int o;
    int row;
    int b;
    bool[149] showRole;
    for (i = 0; i < 24; i += 1) {
        DialogControlSetVisible(g_noIcon[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_noName[i], PlayerGroupSingle(p), false);
    }
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    for (r = 0; r <= 148; r += 1) {
        showRole[r] = false;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r >= 0 && r <= 148) {
            showRole[r] = true;
        }
    }
    // 实际发到玩家身上的角色也显示，避免手工改身份 / 自定义板漏角色。
    for (i = 2; i <= 13; i += 1) {
        r = g_mark[(g_teller * 14) + i] - 1;
        if (r >= 0 && r <= 148) {
            showRole[r] = true;
        }
    }
    for (r = 0; r <= 148; r += 1) {
        if (g_legacyOn[r]) {
            showRole[r] = true;
        }
    }
    g_noMaxRows = 0;
    // 左栏第 0 行：固定（跟着翻页平移，翻下去就藏起来）
    libNtve_gf_SetDialogItemText(g_noName[0], StringToText("爪牙与恶魔互相得知"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[0], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[0], PlayerGroupSingle(p), c_anchorTopLeft, 44, 90 - (g_noShift * 84));
    DialogControlSetVisible(g_noName[0], PlayerGroupSingle(p), (g_noShift == 0));
    // 左栏：按首夜顺序
    row = 1;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 148; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllFirst[r] != o) {
                continue;
            }
            if ((row - g_noShift) >= 0 && (row - g_noShift) < 11) {
                BOTC_NightOrderRow(p, 0, row - g_noShift, r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows) {
        g_noMaxRows = row;
    }
    // 右栏：第二夜起
    row = 0;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 148; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllOther[r] != o) {
                continue;
            }
            if ((row - g_noShift) >= 0 && (row - g_noShift) < 11) {
                BOTC_NightOrderRow(p, 1, row - g_noShift, r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows) {
        g_noMaxRows = row;
    }
    libNtve_gf_SetDialogItemText(g_noPageLbl, StringToText("显示第 " + IntToString(g_noShift + 1) + " - " + IntToString(g_noShift + 11) + " 行（最长一栏 " + IntToString(g_noMaxRows) + " 行）"), PlayerGroupSingle(p));
    if (g_noShift + 11 >= g_noMaxRows) {
        libNtve_gf_SetDialogItemText(g_noPageLbl, StringToText("显示第 " + IntToString(g_noShift + 1) + " - " + IntToString(g_noMaxRows) + " 行（共 " + IntToString(g_noMaxRows) + " 行）"), PlayerGroupSingle(p));
    }
    if (g_noMaxRows <= 11) {
        libNtve_gf_SetDialogItemText(g_noPageLbl, StringToText("共 " + IntToString(g_noMaxRows) + " 行"), PlayerGroupSingle(p));
    }
}

// 翻页：delta = +6 / -6；越界自动夹住（最长一栏 - 12 = 最后一页）
void BOTC_NightOrderScroll (int p, int delta) {
    int maxShift;
    maxShift = g_noMaxRows - 11;
    if (maxShift < 0) {
        maxShift = 0;
    }
    g_noShift = g_noShift + delta;
    if (g_noShift < 0) {
        g_noShift = 0;
    }
    if (g_noShift > maxShift) {
        g_noShift = maxShift;
    }
    BOTC_NightOrderRender(p);
}

void BOTC_NightOrderOpen (int p) {
    g_noShift = 0;              // 每次打开都从最上面开始
    BOTC_NightOrderRender(p);
    g_noOpen[p] = true;
    DialogSetVisible(g_noDlg, PlayerGroupSingle(p), true);
}

void BOTC_NightOrderClose (int p) {
    g_noOpen[p] = false;
    DialogSetVisible(g_noDlg, PlayerGroupSingle(p), false);
}

// 右上角四个面板互斥：1 日志 / 2 魔典 / 3 角色能力表 / 4 夜间顺序
//   （用户 2026-09-19：不能同时开两个）
void BOTC_PanelOpen (int p, int which) {
    // 正在「发起私聊」选人时又从右上角开了别的面板 → 先退出选人模式（不然魔典按钮一直锁着）
    if (g_pmPick[p] && which != 2) {
        BOTC_PmPickEnd(p);
    }
    if (which != 1) {
        BOTC_LogClose(p);
    }
    if (which != 2) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
    }
    if (which != 3) {
        BOTC_AbClose(p);
    }
    if (which != 4) {
        BOTC_NightOrderClose(p);
    }
    if (which != 5) {
        BOTC_NoteClose(p);          // 【笔记】（用户 2026-09-20）：跟其它面板互斥
    }
    if (which != 6) {
        BOTC_TipClose(p);           // 帮助面板也跟其它面板互斥
    }
    if (which == 1) {
        BOTC_LogOpen(p);
    }
    if (which == 2) {
        BOTC_GrimRelayout();
        BOTC_GrimRender(p);
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
        if (g_pmPick[p]) {
            BOTC_PmPickApply(p);       // 选人模式里又把魔典点开：按钮和 ＋ 再收一次
        }
    }
    if (which == 3) {
        BOTC_AbilityOpen(p);
    }
    if (which == 4) {
        BOTC_NightOrderOpen(p);
    }
    if (which == 5) {
        BOTC_NoteOpen(p);
    }
    if (which == 6) {
        g_tipForce[p] = -1;        // 点【游戏帮助】= 看自己的角色，别被之前在能力表点过的详情锁住（用户 2026-09-30）
        BOTC_TipOpen(p);
    }
}

