    g_voteNo  = BOTC_NewButton(g_grimDlg, 162, 54, 581, 421, "弃权");

    g_nomStart = BOTC_NewButton(g_grimDlg, 180, 42, 774, 878, "发起提名");
    g_nomEnd   = BOTC_NewButton(g_grimDlg, 180, 42, 774, 878, "结束发言");
