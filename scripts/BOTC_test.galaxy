    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), false, 2.0);
    return DialogControlLastCreated();
}

// 居中对齐的标签（第 9 个参数 true = 文字居中）
int BOTC_NewLabelC (int d, int w, int h, int x, int y, text t) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, 2.0);
    return DialogControlLastCreated();
}

