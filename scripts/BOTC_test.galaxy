// 【汉字字形预热】（用户 2026-09-19）：把 22 个角色名的汉字先渲染一遍，让星际把字形栅格化进字体图集。
//   它建在**选板子那张黑布之前**，所以整个选板子阶段它都被黑布盖着（玩家看不到）；
//   黑布一撤（BOTC_BoardFinish）就把它藏起来。样式用魔典座位名字那一套（g_grimNameStyle）。
void BOTC_BuildGlyphWarm () {
    int i;
    string s;
    s = "";
    for (i = 0; i <= 21; i += 1) {
        s = s + g_roleName[i] + " ";
    }
    s = s + "1 [本地玩家]";                 // 座位名字那一行的写法也热一下
    DialogCreate(1400, 30, c_anchorTopLeft, 0, 300, false);
    g_warmDlg = DialogLastCreated();
    DialogSetImageVisible(g_warmDlg, false);          // 不要底框，只要字被画出来
    g_warmLbl = BOTC_NewLabel(g_warmDlg, 1400, 30, 0, 0, StringToText(s));
    // 【汉字预热】（用户 2026-10-04）：它建在黑布之后、聊天之前 —— BOTC_GrimInitData() 已经先跑过，
    //   所以这里拿到的是真正的角色名和字体样式（跟魔典座位名字同一套）。
    libNtve_gf_SetDialogItemStyle(g_warmLbl, g_grimNameStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_warmLbl, false, PlayerGroupAll());
    DialogSetVisible(g_warmDlg, PlayerGroupAll(), true);
}

// 手动配板的布局：跟选身份网格同一套格子，只是横向起点 / 行距不同（原来手调的那几个数）
void BOTC_RsLayout () {
    int j;
    int t;
    int k;
    int cap;
    int page;
    int pages;
    int shown;
    int slot;
    int x;
    int y;
    BOTC_GridBuildCat();
    for (j = 0; j < 64; j += 1) {
        g_gridSlot[j] = -1;
        g_gridTeam[j] = 0;
        g_gridIdx[j] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        cap = BOTC_GridCatCap(t);
        pages = BOTC_GridCatPages(t, cap);
        page = g_rsCatPage[t];
        if (page < 1) {
            page = 1;
        }
        if (page > pages) {
            page = pages;
        }
        g_rsCatPage[t] = page;
        k = (page - 1) * cap;
        shown = 0;
        while (k < g_gridCatN[t] && shown < cap && slot < 64) {
            g_gridSlot[slot] = g_gridCatRole[(t * 128) + k];
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = shown;
            x = 300 + ((shown % 7) * 95);
            y = BOTC_GridBlockY(t) + ((shown / 7) * 110);
            DialogControlSetPosition(g_rsBtn[slot], PlayerGroupAll(), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_rsIcon[slot], PlayerGroupAll(), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_rsName[slot], PlayerGroupAll(), c_anchorTopLeft, x, y + 86);
            libNtve_gf_SetDialogItemImage(g_rsIcon[slot], BOTC_NightIconName(g_gridSlot[slot]), PlayerGroupAll());
            libNtve_gf_SetDialogItemText(g_rsName[slot], TextWithColor(StringToText(g_roleName[g_gridSlot[slot]]), BOTC_RoleTeamColor(g_gridSlot[slot])), PlayerGroupAll());
            DialogControlSetVisible(g_rsBtn[slot], PlayerGroupAll(), true);
            DialogControlSetVisible(g_rsIcon[slot], PlayerGroupAll(), true);
            DialogControlSetVisible(g_rsName[slot], PlayerGroupAll(), true);
            slot = slot + 1;
            k = k + 1;
            shown = shown + 1;
        }
        g_gridTeamN[t] = shown;
    }
    g_gridN = slot;
    for (j = slot; j < 64; j += 1) {
        DialogControlSetVisible(g_rsBtn[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_rsIcon[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_rsName[j], PlayerGroupAll(), false);
    }
    for (j = 0; j < 4; j += 1) {
        DialogControlSetPosition(g_rsSec[j], PlayerGroupAll(), c_anchorTopLeft, 30, BOTC_GridBlockY(j) - 30);
        DialogControlSetPosition(g_rsQuotaLbl[j], PlayerGroupAll(), c_anchorTopLeft, 150, BOTC_GridBlockY(j) - 30);
        DialogControlSetVisible(g_rsSec[j], PlayerGroupAll(), (g_gridTeamN[j] > 0));
        DialogControlSetVisible(g_rsQuotaLbl[j], PlayerGroupAll(), (g_gridTeamN[j] > 0));
        DialogControlSetPosition(g_rsCatPrev[j], PlayerGroupAll(), c_anchorTopLeft, 1032, BOTC_GridBlockY(j) - 31);
        DialogControlSetPosition(g_rsCatNext[j], PlayerGroupAll(), c_anchorTopLeft, 1076, BOTC_GridBlockY(j) - 31);
    }
}

void BOTC_BuildRoleSet () {
    int j;
