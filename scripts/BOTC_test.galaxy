    }
    // 按当前在场人数把圆桌摆成圈（没人的座位收起）
    BOTC_GrimRelayout();
g_grimClose = BOTC_NewButton(g_grimDlg, 164, 42, 83, 880, "关闭魔典");

    // 提名系统：顶部信息 / 中央提示 / 投票与判定按钮 / 发起提名与结束发言
