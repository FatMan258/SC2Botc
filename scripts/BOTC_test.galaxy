    g_tipLine[715] = StringToText("相克规则：");
    g_tipLine[716] = StringToText("哈迪寂亚");
    g_tipLine[717] = StringToText("：如果哈迪寂亚死于处决，且") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("存活，当晚哈迪寂亚要选择三名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家：如果他们");
    g_tipLine[718] = StringToText("都选择存活，") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营获胜。否则，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipLine[719] = StringToText("痢蛭");
    g_tipLine[720] = StringToText("：如果") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[721] = StringToText("炼金术士");
    g_tipLine[722] = StringToText("：如果炼金术士本应获得") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("一定不在场。");
    g_tipLine[723] = StringToText("亡骨魔");
