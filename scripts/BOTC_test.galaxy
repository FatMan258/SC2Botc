// ---- 【换说书人 · 方案 A 地基】（用户 2026-10-06）----
//   `g_teller` = **当前说书人的座位**（默认 1）。以前脚本里到处写死「1 号位 = 说书人」，
//   现在所有"给说书人的日志 / 提示"都改成发给 `g_teller` —— 以后换人说书时，直接改这个变量就行。
int         g_teller;
int         g_hideSeat;        // 【不进圈的那个玩家号】（用户 2026-10-07）：说书人要是从玩家格顺位接手的，
                               //   他原来那个玩家号不进圆桌（0 = 不排除；换说书人时跟着更新）
int[14]     g_lab;             // 【编号表】g_lab[位置/格子] = 显示编号（默认 = 位置-1：玩家1 = 格子2；换说书人时不动）
int         g_bankTry;           // 【存档】读档已经试了几次（每 0.5 秒一次，有上限，免得一直去碰 bank）
