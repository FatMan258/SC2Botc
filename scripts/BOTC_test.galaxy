    g_tipLine[478] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("到下个黄昏。");
    g_tipLine[479] = StringToText("【角色简介】");
    g_tipLine[480] = TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("在夜晚保护玩家们免于死亡，但是某些人在此过程中会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[481] = StringToText("与僧侣类似，") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("能让玩家们不被") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("杀死。受保护的玩家也不会因为") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、爪");
    g_tipLine[482] = StringToText("牙、") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("和旅行者的能力而死亡。");
    g_tipLine[483] = TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("只在夜晚保护玩家，并不包括白天。");
    g_tipLine[484] = TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("选择的两名玩家其中之一将在当晚和下一个白天") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。该玩家可以是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的或");
    g_tipLine[485] = TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("的，但几乎总会是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，这取决于你的游戏走向。选择了自己的") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("可能会");
    g_tipLine[486] = TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，这意味着他会失去能力并且当晚可以死亡，而他保护的另一个人也不再安全。");
    g_tipLine[487] = StringToText("【规则细节】");
