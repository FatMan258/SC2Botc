// 首夜：如果本局发了悟道者，让他挑「以为的外来者」（只挑一次）
void BOTC_WudSetupCheck () {
    int q;
    int r;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) { continue; }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r != 118) { continue; }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) { continue; }
        BOTC_WudOutsiderOpen(q);
        return;
    }
}

//==================================================================================================
// 【旧《赎罪小镇》保留角色实现】
//==================================================================================================
// 鸩（124）：每局一次，选择一个镇民角色；该角色若真在场，则醉酒并在夜里死亡。
void BOTC_DrossOpen (int p) {
    int q;
    if (p < 2 || p > 13) {
        return;
    }
    if (!BOTC_HasAbility(p, 124)) {
        return;
    }
    if (BOTC_ProtectTokOn(p, 145)) {
        BOTC_PmStore(g_teller, "【鸩】这一局的一次性能力已经用过了。");
        return;
    }
    g_pickMode[g_teller] = 28;
    g_pickWho[g_teller] = p;
    g_pickTeam = 0;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 0) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_DrossPick (int role) {
    int p;
    int t;
    p = g_pickWho[g_teller];
    g_pickMode[g_teller] = 0;
    g_pickWho[g_teller] = 0;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
    if (p < 2 || p > 13 || role < 0 || role > 148) {
        return;
    }
    if (BOTC_RoleTeam(role) != 0) {
        BOTC_Notice(g_teller, "鸩只能选择一个镇民角色。");
        return;
    }
    g_tokOn[(((g_teller * 14) + p) * 256) + 145] = true;
    BOTC_GrimRender(g_teller);
    if (BOTC_SeatImpaired(p)) {
        BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 中毒/酒鬼：这次能力失效，但一次性机会已消耗。");
        return;
    }
    t = BOTC_SeatOfRole(role);
    if (t < 2 || BOTC_SeatDead(t)) {
        BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」，但他不在场（或已经死亡），无事发生。");
        return;
    }
    g_tokOn[(((g_teller * 14) + t) * 256) + 144] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 选中在场的「" + g_roleName[role] + "」：" + BOTC_NameStr(t) + " 醉酒并死亡。");
    BOTC_MarkDeathQuietSrc(t, 1, 0, 124);
}


// 赶尸人（126）：找出离他最近的两名存活镇民；这两人各自的第一次死亡会被挡下。
bool BOTC_CorpseFirstDeath (int q) {
    int i;
    int c;
    int d;
    int best1;
    int best2;
    int s1;
    int s2;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    if (BOTC_SeatDead(q)) {
        return false;
    }
    if (g_corpseSpent[q]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 148]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 148] = false;
        g_corpseSpent[q] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【赶尸人】" + BOTC_NameStr(q) + " 的首次死亡保护已经用掉，这一次会正常死亡。");
        return false;
    }
    c = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatImpaired(i)) {
            continue;
        }
        if (BOTC_SeatDead(i) && !BOTC_KeepsAbilityAlive(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 126)) {
            c = i;
        }
    }
    if (c < 2) {
        return false;
    }
    best1 = 999;
    best2 = 999;
    s1 = 0;
    s2 = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == c) {
            continue;
        }
        if (BOTC_SeatTeam(i) != 0) {
            continue;
        }
        d = BOTC_RingDist(c, i);
        if (d < best1) {
            best2 = best1;
            s2 = s1;
            best1 = d;
            s1 = i;
        }
        else {
            if (d < best2) {
                best2 = d;
                s2 = i;
            }
        }
    }
    if (q != s1 && q != s2) {
        return false;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 148] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【赶尸人】" + BOTC_NameStr(q) + " 是赶尸人邻近的镇民，首次死亡被当作仍然存活（已打「活尸」）。");
    return true;
}

// 利维坦（127）：白天公开；第二名善良玩家被处决时邪恶胜；持有第五天 token 且能力生效时，进入夜晚即邪恶胜。
// 公开通知只在进入白天之后检查，不向任何玩家私聊；中毒 / 醉酒 / 已死亡时当天不播报。
bool BOTC_LeviathanSeatActive (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || BOTC_SeatImpaired(q)) {
        return false;
    }
    return BOTC_HasAbility(q, 127);
}

// 活着且真正具有利维坦能力的座位（不含酒鬼 / 提线木偶 / 悟道者的认知覆盖）。
bool BOTC_LeviathanAlive () {
    return BOTC_LeviathanRoleHolder() >= 2;
}

int BOTC_LeviathanRoleHolder () {
    int i;
    int c;
    c = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 127)) {
            c = i;
        }
    }
    return c;
}

// 相克：第五天结束时利维坦和镇长都存活，且当天没有任何处决 → 善良胜。
// 这里是相克规则，不要求镇长清醒；镇长即使是邪恶阵营也照样成立。
bool BOTC_LeviathanMayorJinx () {
    int i;
    int mayor;
    mayor = 0;
    if (g_gameOver || g_dayNum != 5 || g_execUsedToday) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 12)) {
            mayor = i;
        }
    }
    if (!BOTC_LeviathanAlive() || mayor < 2) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×镇长相克】第五天结束时利维坦和镇长都存活，且当天没有处决 → 善良阵营获胜。");
    BOTC_ShowWin(0, "利维坦与镇长一起熬过了第五个白天，", "没有处决的小镇迎来了真正的和平。");
    return true;
}

// 相克：利维坦本人提名并处决了旅店老板上个夜晚保护的一名玩家 → 善良胜。
// 这里看的是提名者身份，中毒 / 醉酒不改变他仍然是利维坦。
bool BOTC_LeviathanInnkeeperJinx (int q) {
    int n;
    if (g_gameOver || q < 2 || q > 13) {
        return false;
    }
    if (g_innNight != g_dayNum || (q != g_innA && q != g_innB)) {
        return false;
    }
    n = g_nomFromOf[q];
    if (n < 2 || n > 13 || BOTC_SeatDead(n) || !BOTC_HasAbility(n, 127)) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×旅店老板相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了上个夜晚被旅店老板保护的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
    BOTC_ShowWin(0, "利维坦亲手处决了旅店老板昨夜保护的人，", "镇民抓住了这个致命破绽。");
    return true;
}

// 处决型相克：利维坦本人提名并处决对应角色 / 对应记录目标时，善良胜。
bool BOTC_LeviathanNominationJinx (int q) {
    int n;
    n = g_nomFromOf[q];
    if (BOTC_LeviathanInnkeeperJinx(q)) {
        return true;
    }
    if (n < 2 || n > 13 || BOTC_SeatDead(n) || !BOTC_HasAbility(n, 127)) {
        return false;
    }
    if (BOTC_HasAbility(q, 11)) {
        BOTC_PmStore(g_teller, "【利维坦×士兵相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了士兵 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦亲手处决了士兵，", "镇民抓住了这个致命破绽。");
        return true;
    }
    if (g_monkNight == g_dayNum && g_monkA == q) {
        BOTC_PmStore(g_teller, "【利维坦×僧侣相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了僧侣上一夜保护的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦处决了僧侣昨夜保护的人，", "镇民抓住了这个致命破绽。");
        return true;
    }
    if (g_exoJinxNight == g_dayNum && g_exoJinxSeat == q) {
        BOTC_PmStore(g_teller, "【利维坦×驱魔人相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了驱魔人上一夜点中的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦处决了驱魔人昨夜点中的玩家，", "镇民抓住了这个致命破绽。");
        return true;
    }
    return false;
}

// 相克：利维坦在场时，孙子死于处决 → 邪恶胜。
bool BOTC_LeviathanGrandchildJinx (int q) {
    if (q < 2 || q > 13 || !g_tokOn[(((g_teller * 14) + q) * 256) + 30]) {
        return false;
    }
    if (!BOTC_LeviathanAlive()) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×祖母相克】利维坦在场，孙子 " + BOTC_NameStr(q) + " 死于处决 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "利维坦看着祖母的孙子被处决，", "祖母的哭声回荡在空荡的小镇。");
    return true;
}

// 相克夜间选人只在守鸦人 / 贤者 / 农夫中至少一位真实、存活且尚未失去能力时启用。
bool BOTC_LeviathanJinxTargetOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i) || g_levJinxLost[i]) {
            continue;
        }
        if (BOTC_HasAbility(i, 8) || BOTC_HasAbility(i, 59) || BOTC_HasAbility(i, 80) || BOTC_HasAbility(i, 131)) {
            return true;
        }
    }
    return false;
}

// 动态启用 / 关闭利维坦的夜间「相克选人」。普通板子仍然是纯被动恶魔。
void BOTC_LeviathanSpecialSync () {
    g_roleTargets[127] = 0;
    g_roleAct[127] = 0;
    // 普通对局保留官网末尾提示位；相克特殊行动启用时才改到前面。
    g_noAllFirst[127] = 87;
    g_noAllOther[127] = 123;
    if (BOTC_LeviathanRoleHolder() < 2 || !BOTC_LeviathanJinxTargetOn()) {
        return;
    }
    g_roleTargets[127] = 1;
    g_roleAct[127] = 2;
    g_noAllOther[127] = 8;
}

// 利维坦选中守鸦人 / 贤者 / 农夫：能力生效但目标不死亡。
void BOTC_LeviathanJinxTrigger (int q) {
    if (q < 2 || q > 13 || g_levJinxLost[q]) {
        return;
    }
    // 相克：利维坦选中报丧女妖 → 她死亡，随后按正常「被恶魔杀死」触发死亡后能力。
    if (BOTC_HasAbility(q, 131)) {
        BOTC_PmStore(g_teller, "【利维坦×报丧女妖相克】" + BOTC_NameStr(q) + " 被利维坦选中：报丧女妖死亡，死亡后能力按正常流程触发。");
        BOTC_MarkDeathQuiet(q, 1, 1);
        return;
    }
    if (BOTC_SeatImpaired(q)) {
        return;
    }
    if (BOTC_HasAbility(q, 8)) {
        g_levJinxWake[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×守鸦人相克】" + BOTC_NameStr(q) + " 被利维坦选中：守鸦人能力生效，但不会死亡。他今晚仍会按夜序醒来选一名玩家。");
        BOTC_WakeRender();
        return;
    }
    if (BOTC_HasAbility(q, 59)) {
        g_levJinxLost[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×贤者相克】" + BOTC_NameStr(q) + " 被利维坦选中：贤者能力生效，但不会死亡；触发后失去能力。");
        BOTC_SageOpen(q, true);
        BOTC_LeviathanSpecialSync();
        return;
    }
    if (BOTC_HasAbility(q, 80)) {
        g_levJinxLost[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×农夫相克】" + BOTC_NameStr(q) + " 被利维坦选中：农夫能力生效，但不会死亡；触发后失去能力。");
        BOTC_FarmerOpen(q, true);
        BOTC_LeviathanSpecialSync();
        return;
    }
}

// 天数 token：始终按当前已经到达的白天编号，夜晚不提前使用下一天的 token。
// 例：第四天结束后的第五夜仍挂第四天；进入第五个白天后才更新为第五天。
void BOTC_LeviathanTokenSync () {
    int i;
    int c;
    int day;
    int tok;
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    day = g_dayNum;
    if (day < 1) {
        day = 1;
    }
    if (day > 5) {
        day = 5;
    }
    tok = 149 + day - 1;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 149] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 150] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 151] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 152] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 153] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 154] = false;
    }
    g_tokOn[(((g_teller * 14) + c) * 256) + tok] = true;
    if (g_execGoodCount > 0) {
        g_tokOn[(((g_teller * 14) + c) * 256) + 154] = true;
    }
    BOTC_GrimRender(g_teller);
    BOTC_LeviathanSpecialSync();
}

// 天亮后公开：只有真实、存活、未中毒 / 未醉酒且能力生效的利维坦才播报。
// 同一个生效阶段只播一次；如果某天黎明时被压制，下一个健康黎明会重新公开。
void BOTC_LeviathanDayCheck () {
    int c;
    if (g_gameOver || !g_started || g_dayNum < 1) {
        return;
    }
    BOTC_LeviathanTokenSync();
    c = BOTC_LeviathanRoleHolder();
    if (c < 2 || !BOTC_LeviathanSeatActive(c)) {
        g_levAnnouncedSeat = 0;
        return;
    }
    if (g_levAnnouncedSeat != c) {
        g_levAnnouncedSeat = c;
        BOTC_PubAnnounce("利维坦在场");
    }
    // 第五天白天只更新 token，不结算；第五天之后进入任何白天时都立刻检查胜利。
    if (g_dayNum > 5) {
        BOTC_LeviathanTokenWin();
    }
}

void BOTC_LeviathanExecution (int q) {
    int c;
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    // 相克优先于「第二名善良玩家」的胜利。
    if (BOTC_LeviathanNominationJinx(q)) {
        return;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    if (!BOTC_LeviathanSeatActive(c)) {
        BOTC_PmStore(g_teller, "【利维坦】这次处决时利维坦中毒 / 醉酒 / 失去能力 → 不计入处决数。");
        return;
    }
    if (BOTC_WinAlignOf(q) != 0) {
        return;
    }
    if (g_levGoodExec[q]) {
        BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 之前已经被计入过一次，本次不重复计数。");
        return;
    }
    g_levGoodExec[q] = true;
    g_execGoodCount = g_execGoodCount + 1;
    g_tokOn[(((g_teller * 14) + c) * 256) + 154] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【利维坦】善良玩家被处决：" + IntToString(g_execGoodCount) + " 名。");
    if (g_execGoodCount > 1) {
        BOTC_ShowWin(1, "利维坦看着第二名善良玩家被处决，", "小镇已经无可挽回。");
    }
}

// 第五天 token 的统一胜利入口：天亮、进入夜晚、解毒 / 恢复能力时都会调用。
void BOTC_LeviathanTokenWin () {
    int c;
    if (g_gameOver || !g_started) {
        return;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2 || !g_tokOn[(((g_teller * 14) + c) * 256) + 153]) {
        return;
    }
    if (!BOTC_LeviathanSeatActive(c)) {
        return;
    }
    BOTC_PmStore(g_teller, "【利维坦】持有第五天 token，且利维坦存活、能力生效 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "利维坦跨过了第五天，", "小镇再也没有明天。");
}

// 按下【进入夜晚】后的黄昏结算：镇长相克优先，随后检查第五天 token。
// 中毒 / 醉酒 / 失去能力时本轮不结算，token 继续保留；恢复能力时会由统一入口立刻判胜。
void BOTC_LeviathanDuskCheck () {
    int c;
    if (g_gameOver) {
        return;
    }
    BOTC_LeviathanSpecialSync();
    if (g_dayNum >= 5) {
        g_levAfterFifth = true;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    if (BOTC_LeviathanMayorJinx()) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + c) * 256) + 153] && !BOTC_LeviathanSeatActive(c)) {
        BOTC_PmStore(g_teller, "【利维坦】已经有第五天 token，但这次进入夜晚时他中毒 / 醉酒 / 失去能力 → 暂不结算。");
    }
    BOTC_LeviathanTokenWin();
}

void BOTC_SkillConfirm (int p) {
    int r;
    string s;
    int n;
    int n2;
    int t;
    int rt;
    int dk;
    int i;
    int w1;
    int w2;
    bool goonHit;
    int nr;                       // 舞蛇人（49）交换角色时用：新恶魔拿到的角色
    int nrP;                      // 【交换时"换给恶魔"的那个角色】（用户 2026-10-12）：= 选人这位的真身
    int alP;                      // 舞蛇人（交换前）的阵营（用户 2026-10-02）
    int alT;                      // 原恶魔（交换前）的阵营（用户 2026-10-02）
    bool snakeOk;                 // 【舞蛇人】这一支：这一次到底换不换（用户 2026-10-14）
    bool snakeLm;                 // 【舞蛇人】这一支：目标是不是「带着小怪宝」（要一起把 134 挪到新恶魔身上）
    string lus;                   // 疯子报给恶魔时的身份说明（哲学疯子用，用户 2026-10-03）
    int cogP;                     // 【认知覆盖】（用户 2026-10-19）：选人这位的认知 token（-1 = 不是）
    int cogT;                     // 【认知覆盖】：目标那一格的认知 token
    int cardP;                    // 【认知覆盖】：选人这位「以为的身份」
    int cardT;                    // 【认知覆盖】：目标「以为的身份」
    if (g_boomKeepPick && p == 1) {
        BOTC_BoomKeepConfirm();
        return;
    }
    if (g_limitedAsk[p]) {
        BOTC_LimitedAccept(p);
        return;
    }
    if (g_poAsk[p]) {
        BOTC_PoAskAnswer(p, true);
        return;
    }
    if (g_boffinRecipientPick && p == 1) {
        t = g_skillT1[1];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_teller, "先点一名存活恶魔，再按【确认】。");
            return;
        }
        BOTC_BoffinSetRecipient(t);
        return;
    }
    if (g_boffinActing[p] && !BOTC_BoffinWorksAt(g_boffinActingSource[p])) {
        BOTC_PmStore(g_teller, "【科学怪人】来源已经失效，这次借用能力的确认作废。");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_bnestActing[p] && !BOTC_BoffinNestedWorksAt(g_bnestSource[p], p)) {
        BOTC_PmStore(g_teller, "来源已经失效，这次能力的确认作废。");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_grantActing[p] && (g_grantRoleBy[p] <= 0 || g_grantRoleBy[p] > 148)) {
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【奥赫（134）】角色不在场 / 有多个持有者：由说书人在这里确认最终死亡玩家
    if (g_ojoAskSt && p == 1) {
        i = g_ojoFrom;
        t = g_skillT1[p];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_teller, "先点一名玩家再确认。");
            return;
        }
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_OjoResolveTarget(i, t);
        return;
    }

    r = BOTC_ActRoleOf(p);
    // 【理发师交换】必须先于被唤醒恶魔的原能力结算，否则哈迪寂亚会进入自己的三目标面板。
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        BOTC_TellSkillChoice(p, -1);
        BOTC_BarberSwap(p, g_skillT1[p], g_skillT2[p]);
        return;
    }
    // 【莽夫（37）】（用户 2026-10-16 修 BUG）：**先把莽夫那一份算掉** ----
    //   只要是「用夜间技能选择了一名玩家」的角色，都要先过这一关。原来这两句写在函数很后面，
    //   而寡妇（75）那一支在它们之前就 return 了 → 寡妇毒莽夫时莽夫的能力根本没被记上，
    //   结果变成「莽夫中毒」，而不是「寡妇醉酒」。挪到这里，所有选人类的角色一次覆盖。
    if (g_skillT1[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT1[p]);
    }
    if (g_skillT2[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT2[p]);
    }
    // 食人魔（148）：选择朋友并静默加入其阵营；毒醉也照常生效。
    if (r == 148) {
        t = g_skillT1[p];
        if (t < 2 || t > 13 || t == p || !g_seatOn[t]) {
            BOTC_Notice(g_who[p], "请选择一名其他玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_OgreResolve(p, t);
        return;
    }
    // 【悟道者（118）】（用户 2026-10-16）：**邪恶玩家**的能力选择 / 影响了他 → 他立刻变成一个不在场的镇民
    //   （只挂「主动选人」这一类；被动型能力不自动检测 ---- 用户说的）
