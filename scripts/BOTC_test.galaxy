    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemText(g_specTitle, BOTC_NameSubstText(StringToText("玩家号 + 身份：发给 " + BOTC_NameStr(q))), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("玩家号最多 6 个（1~12）；身份按钮可选 0~6 个。只填玩家号 → 发玩家号；1 个玩家号 + 1 个身份 → A是B；有多个结果 → 自动拼成列表。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("取消"), PlayerGroupAll());
    BOTC_SpecSeatClear();
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecRoleOpen (int i) {
    if (i < 0 || i > 5) {
        return;
    }
    if (g_specMode != 3 || g_specTo < 2 || g_specTo > 13) {
        return;
    }
    g_specPickSlot = i;
    g_specMode = 4;
    g_pickMode[g_teller] = 29;
    g_pickWho[g_teller] = g_specTo;
    g_pickTeam = -1;
    g_pickAlign = -1;
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(i + 1) + " 个身份（点空白处不选）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecSeatSend () {
    int i;
    int n;
    int r;
    int seatN;
    int roleN;
    string one;
    string seats;
    string roles;
    string msg;
    if (g_specTo < 2 || g_specTo > 13) {
        return;
    }
    seats = "";
    roles = "";
    seatN = 0;
    roleN = 0;
    for (i = 0; i < 6; i += 1) {
        one = libNtve_gf_DialogItemEditValue(g_specSeatEdit[i], g_teller);
        if (StringLength(one) > 0) {
            n = BOTC_TextNum(one);
            if (n < 1 || n > 12) {
                BOTC_Notice(g_teller, "第 " + IntToString(i + 1) + " 个玩家号不对：只能填 1~12，留空表示不用这一格。");
                return;
            }
            if (seatN > 0) {
                seats = seats + ",";
            }
            seats = seats + BOTC_NameStr(n + 1);
            seatN = seatN + 1;
        }
        if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 148) {
            r = g_specRoleSel[i] - 1;
            if (roleN > 0) {
                roles = roles + ",";
            }
            roles = roles + g_roleName[r];
            roleN = roleN + 1;
        }
    }
    if (seatN <= 0 && roleN <= 0) {
        BOTC_Notice(g_teller, "至少填一个玩家号，或选择一个身份。");
        return;
    }
    if (seatN > 0 && roleN <= 0) {
        msg = "【信息】你得知" + seats + "。";
    }
    else {
        if (seatN <= 0) {
            msg = "【信息】你得知" + roles + "。";
        }
        else {
            if (seatN == 1 && roleN == 1) {
                msg = "【信息】你得知" + seats + "是" + roles + "。";
            }
            else {
                msg = "【信息】你得知" + seats + "中有" + roles + "。";
            }
        }
    }
    BOTC_PmInfo(g_who[g_specTo], msg);
    BOTC_PmStore(g_teller, "【发送特定信息】已发给 " + BOTC_NameStr(g_specTo) + "：" + msg);
    BOTC_SpecClose();
}

// 选好收件人（q = 格子）：自定义文本走共用答题框；玩家号 + 身份走新面板
void BOTC_SpecPickSeat (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (g_specMode == 1) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_ManInfoOpen(q, 808, "输入自定义文本（发送时自动加「你得知」）");
        return;
    }
    if (g_specMode == 2) {
        BOTC_SpecSeatShow(q);
    }
}
