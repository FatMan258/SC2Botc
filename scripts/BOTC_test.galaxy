bool BOTC_BoomHasImmuneToken (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    // 保护 / 不会死亡 / 处决不死 / 首次未死 / 维齐尔白天免死。
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 9] || g_tokOn[(((g_teller * 14) + q) * 256) + 25] || g_tokOn[(((g_teller * 14) + q) * 256) + 26] || g_tokOn[(((g_teller * 14) + q) * 256) + 27] || g_tokOn[(((g_teller * 14) + q) * 256) + 28] || g_tokOn[(((g_teller * 14) + q) * 256) + 29] || g_tokOn[(((g_teller * 14) + q) * 256) + 51] || g_tokOn[(((g_teller * 14) + q) * 256) + 122] || g_tokOn[(((g_teller * 14) + q) * 256) + 133] || g_tokOn[(((g_teller * 14) + q) * 256) + 166]);
}

void BOTC_BoomKeepOpen () {
    g_boomKeepPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择三名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_skillNoPick[1], PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "炸弹人：请选择三名保留玩家，其余无免死 token 的玩家将死亡。");
}

void BOTC_BoomVoteStart () {
    int i;
    g_boomKeepPick = false;
    g_boomVoteOn = true;
    g_boomResult = false;
    g_skillPicking[1] = false;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    for (i = 1; i <= 13; i += 1) {
        g_boomVote[i] = 0;
        g_boomCount[i] = 0;
    }
    BOTC_PlaySfx(g_sfxCountName);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(10), PlayerGroupAll());
    BOTC_BigNotice("选择一名玩家");
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i]) {
            BOTC_Notice(g_who[i], "炸弹人指向投票：点一个在座玩家座位，倒计时结束前可以随时更改。");
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[i]), true);
        }
    }
    TimerStart(g_tVote, 10.0, false, c_timeGame);
}

void BOTC_BoomVotePick (int p, int q) {
    int seat;
    if (!g_boomVoteOn || p < 2 || p > 13 || q < 2 || q > 13) {
        return;
    }
    seat = BOTC_PosOf(p);
    if (seat < 2 || seat > 13 || !g_seatOn[seat]) {
        BOTC_Notice(p, "你已经不能参与这次指向投票。");
        return;
    }
    if (!g_seatOn[q]) {
        BOTC_Notice(p, "只能选择一名在座的玩家。");
        return;
    }
    g_boomVote[seat] = q;
    BOTC_Notice(p, "已指向 " + BOTC_NameStr(q) + "；倒计时结束前可以继续改选。");
}

void BOTC_BoomVoteEnd () {
    int i;
    int q;
    if (!g_boomVoteOn) {
        return;
    }
    g_boomVoteOn = false;
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    for (i = 1; i <= 13; i += 1) {
        g_boomCount[i] = 0;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || g_boomVote[i] <= 0) {
            continue;
        }
        q = g_boomVote[i];
        if (q >= 2 && q <= 13) {
            g_boomCount[q] = g_boomCount[q] + 1;
        }
    }
    g_boomResult = true;
    BOTC_NomUI();                  // 复用提名票数区：在各座位名下方显示最终得票
    BOTC_PmStore(g_teller, "【炸弹人】10 秒指向投票结束，完整票数已显示在各座位下方。最高票不自动处决，请按规则手工裁定。");
    g_boomPending = false;
    BOTC_CheckWin();
}

void BOTC_BoomKeepConfirm () {
    int i;
    int q;
    int a;
    int b;
    int c;
    string killed;
    if (!g_boomKeepPick) {
        return;
    }
    a = g_skillT1[1];
    b = g_skillT2[1];
    c = g_skillT3[1];
    if (a < 2 || a > 13 || b < 2 || b > 13 || c < 2 || c > 13 || a == b || a == c || b == c) {
        BOTC_Notice(g_teller, "炸弹人必须选择三名不同的存活玩家。");
        return;
    }
    if (!g_seatOn[a] || !g_seatOn[b] || !g_seatOn[c] || BOTC_SeatDead(a) || BOTC_SeatDead(b) || BOTC_SeatDead(c)) {
        BOTC_Notice(g_teller, "三名保留者必须都是存活玩家。");
        return;
    }
    g_boomKeepPick = false;
    for (i = 1; i <= 13; i += 1) {
        g_boomKeep[i] = false;
    }
    g_boomKeep[a] = true;
    g_boomKeep[b] = true;
    g_boomKeep[c] = true;
    // 先快照所有免死 token，再同时结算死亡，避免来源先死导致后续 token 被提前清掉。
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_boomKeep[q]) {
            continue;
        }
        if (BOTC_BoomHasImmuneToken(q)) {
            g_boomKeep[q] = true;
            BOTC_PmStore(g_teller, "【炸弹人】" + BOTC_NameStr(q) + " 带免死 / 保护 token，爆炸未杀死他。");
        }
    }
    g_skillPicking[1] = false;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    BOTC_PubAnnounce("炸弹人引爆，除保留者外的玩家死亡。");
    killed = "";
    BOTC_PlaySfx("Marine_Death");
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_boomKeep[q]) {
            continue;
        }
        BOTC_MarkDeathRowTok(q, BOTC_DeathRowOf(2, 0), -1, true);
        g_deadShown[q] = true;
        g_deadPending[q] = false;
        BOTC_MoonChildCheck(q);
        BOTC_KlutzCheck(q);
        BOTC_DeclareRender();
        BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡（炸弹人）----");
        BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
        if (StringLength(killed) > 0) {
            killed = killed + "、";
        }
        killed = killed + BOTC_NameStr(q);
    }
    for (q = 1; q <= 13; q += 1) {
        BOTC_GrimRender(q);
    }
    if (StringLength(killed) > 0) {
        BOTC_PmStore(g_teller, "【炸弹人】保留：" + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "、" + BOTC_NameStr(c) + "；爆炸死亡：" + killed + "。");
    }
    BOTC_BoomVoteStart();
}

bool BOTC_BoomdandyTrigger (int q) {
    if (g_boomPending || q < 2 || q > 13 || !BOTC_HasAbility(q, 138) || !BOTC_AbilityWorks(q, 138)) {
        return false;
    }
    g_boomPending = true;
    g_boomSeat = q;
    if (g_phase != 0) {
        BOTC_NomCloseEx(false);
    }
    BOTC_PubAnnounce("【炸弹人】" + BOTC_NameStr(q) + " 引爆了炸弹！");
    BOTC_BigNotice("炸弹人引爆");
    BOTC_PmStore(g_teller, "【炸弹人】" + BOTC_NameStr(q) + " 已被处决。请先选择三名保留玩家，其余玩家会死亡；免死 / 保护 token 会阻止爆炸死亡。");
    BOTC_BoomKeepOpen();
    return true;
}

void BOTC_HarpyApplyPair (int src, int a, int b) {
    int j;
    int base;
    if (src < 1 || src > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    for (j = 1; j <= 13; j += 1) {
        base = (g_teller * 14) + j;
        g_tokOn[(base * 256) + 162] = false;
        g_tokOn[(base * 256) + 163] = false;
        g_harpyFirstBy[j] = 0;
        g_harpySecondBy[j] = 0;
        g_harpyDay[j] = 0;
    }
    if (!BOTC_AbilityWorks(src, 139)) {
        BOTC_PmStore(g_teller, "【鹰身女妖】能力失效 → 这次不放置疯狂 / 第二名标记，也不发送信息。");
        return;
    }
    g_harpyFirstBy[src] = a;
    g_harpySecondBy[src] = b;
    g_harpyDay[src] = g_nightNum;
    g_tokOn[((((g_teller * 14) + a) * 256) + 162)] = true;
    g_tokOn[((((g_teller * 14) + b) * 256) + 163)] = true;
    BOTC_PmInfo(g_who[a], "【信息】你得知鹰身女妖选择了你：明天你需要疯狂地证明" + BOTC_NameStr(b) + "是邪恶的，否则你们之中可能有人死亡。");
    BOTC_PmStore(g_teller, "【鹰身女妖】" + BOTC_NameStr(src) + " 选择了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "；次日疯狂与死亡由你手工处理。");
    BOTC_GrimRender(g_teller);
}

void BOTC_OrganOpen (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    g_organSeat = q;
    if (q >= 2 && BOTC_SeatIsComputer(q)) {
        BOTC_OrganChoose(0);
        return;
    }
    libNtve_gf_SetDialogItemText(g_organTitle, StringToText("是否发动技能？"), PlayerGroupSingle(g_who[q]));
    DialogControlSetVisible(g_organYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organYes, PlayerGroupSingle(g_who[q]), true);
    DialogControlSetVisible(g_organNo, PlayerGroupSingle(g_who[q]), true);
    DialogSetVisible(g_organDlg, PlayerGroupSingle(g_who[q]), true);
}

void BOTC_OrganChoose (int yes) {
    int q;
    string s;
    q = g_organSeat;
    if (q < 1 || q > 13) {
        return;
    }
    g_organSeat = 0;
    g_organDrunkBy[q] = (yes != 0);
    g_tokOn[((((g_teller * 14) + q) * 256) + 164)] = (yes != 0);
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    s = "保持清醒。";
    if (yes != 0) {
        s = "醉酒到下一个黄昏。";
    }
    BOTC_PmInfo(g_who[q], "【信息】你得知自己" + s);
    if (yes != 0) {
        s = "醉酒。";
    }
    else {
        s = "清醒。";
    }
    BOTC_PmStore(g_teller, "【街头风琴手】" + BOTC_NameStr(q) + " 选择了" + s);
    BOTC_GrimRender(g_teller);
    BOTC_SeatStateSync();
}

bool BOTC_OrganActive () {
    int q;
    q = BOTC_AbilitySeat(140);
    if (q == 1) {
        return !g_tokOn[((((g_teller * 14) + q) * 256) + 164)];
    }
    return (q >= 2 && q <= 13 && !BOTC_SeatDead(q));
}

bool BOTC_ButlerVoteCounts (int q) {
    if (!BOTC_OrganActive() || q != g_butlerSeat) {
        return true;
    }
    if (q < 2 || q > 13 || BOTC_SeatImpaired(q)) {
        return true;               // 管家自己醉酒 / 中毒时不看主人
    }
    if (g_butlerMaster < 2 || g_butlerMaster > 13) {
        return false;
    }
    return (g_vote[g_butlerMaster] == 1);
}

void BOTC_OrganDuskClear () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        g_tokOn[((((g_teller * 14) + q) * 256) + 164)] = false;
        g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
        g_organDrunkBy[q] = false;
    }
    g_organSeat = 0;
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
}

bool BOTC_VizierClaimReady () {
    if (!g_started || g_phase < 1 || g_phase > 6) {
        return false;
    }
    if (g_vizierSeat < 2 || g_vizierSeat > 13) {
        return false;
    }
    return !g_execUsedToday;
}

// 统一按能力层找维齐尔：原生、炼金术士借用、哲学家 / 食人族 /
// 科学怪人 / 说书人赋予都算，不依赖真身是否恰好是 141。
void BOTC_VizierAnnounce () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_vizierAnnounced[q]) {
            continue;
        }
        if (!BOTC_HasAbility(q, 141)) {
            continue;
        }
        g_vizierAnnounced[q] = true;
        BOTC_PubAnnounce("【维齐尔】" + BOTC_NameStr(q) + " 是维齐尔。");
        BOTC_PmStore(g_teller, "【维齐尔】已向全场公开：" + BOTC_NameStr(q) + " 具有维齐尔能力。");
    }
}

void BOTC_VizierAfterVote (int nominee, int goodVotes) {
    int i;
    bool relevant;
    if (nominee < 2 || nominee > 13) {
        return;
    }
    g_vizierSeat = nominee;
    g_vizierGood = goodVotes;
    // 只有场上存在生效的维齐尔能力，或本轮有人声称维齐尔时才提示。
    relevant = BOTC_AbilityInPlay(141);
    for (i = 1; i <= 13; i += 1) {
        if (g_vizierClaimed[i]) {
            relevant = true;
        }
    }
    if (!relevant) {
        return;
    }
    if (goodVotes > 0) {
        BOTC_PmStore(g_teller, "【维齐尔】有善良玩家投票");
    }
    else {
        BOTC_PmStore(g_teller, "【维齐尔】无善良玩家投票");
    }
}

void BOTC_VizierClaim (int p) {
    int seat;
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_VizierClaimReady()) {
        BOTC_Notice(p, "当前不能声称维齐尔：现在不在提名阶段，或今天已经处决过。");
        return;
    }
    if (g_vizierClaimed[p]) {
        BOTC_Notice(p, "你本轮已经声称过维齐尔了。");
        return;
    }
    g_vizierClaimed[p] = true;
    seat = BOTC_PosOf(p);
    BOTC_PubAnnounce(BOTC_NameStr(seat) + " 宣布使用维齐尔能力");
    if (g_vizierSeat >= 2 && g_vizierSeat <= 13) {
        if (g_vizierGood > 0) {
            BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat) + "：有善良玩家投票");
        }
        else {
            BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat) + "：无善良玩家投票");
        }
    }
    else {
        BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat));
    }
    BOTC_Notice(p, "你已公开声称维齐尔。技能为白板，由说书人手工结算。");
}

bool BOTC_VizierMissionaryProtected (int q) {
    if (q < 2 || q > 13 || !BOTC_HasAbility(q, 141)) {
        return false;
    }
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive());
}

void BOTC_VizierSync () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 166] = false;
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_SeatDead(i) && (BOTC_AbilityWorks(i, 141) || BOTC_VizierMissionaryProtected(i))) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 166] = true;
        }
    }
    // 第一夜之后才出现的新维齐尔立即公开；初始维齐尔由第一个白天统一公开。
    if (g_started && g_dayNum >= 1) {
        BOTC_VizierAnnounce();
    }
}

bool BOTC_VizierDayImmune (int q) {
    if (g_isNight || q < 1 || q > 13) {
        return false;
    }
    if (BOTC_SeatDead(q)) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 166]) {
        return false;
    }
    if (BOTC_VizierMissionaryProtected(q)) {
        return true;               // 相克：被布道失去能力，但白天仍然不会死
    }
    return BOTC_AbilityWorks(q, 141);
}

// 相克：恐惧之灵被唤醒时，把仍具有维齐尔角色的玩家拉进同一条私聊。
void BOTC_VizierFearChat (int fearSeat) {
    int i;
    int s;
    int viz;
    if (fearSeat < 2 || fearSeat > 13) {
        return;
    }
    viz = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && !BOTC_SeatDead(i) && BOTC_HasAbility(i, 141)) {
            viz = i;
        }
    }
    if (viz < 2 || viz == fearSeat) {
        return;
    }
    BOTC_TellerPmTo(fearSeat);
    s = g_mySess[g_teller];
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】私聊建立失败：没有可用会话位。");
        return;
    }
    if (!g_member[(s * 14) + g_who[viz]]) {
        BOTC_JoinSess(g_who[viz], s);
    }
    if (g_member[(s * 14) + g_who[viz]]) {
        BOTC_AppendPm(g_who[fearSeat], "【相克】维齐尔也在本私聊中：他得知了恐惧之灵本轮选择的目标。");
        BOTC_AppendPm(g_who[viz], "【相克】恐惧之灵被唤醒，你被拉入本私聊。");
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】已把维齐尔 " + BOTC_NameStr(viz) + " 拉入与恐惧之灵 " + BOTC_NameStr(fearSeat) + " 的私聊。");
        BOTC_RefreshSessListAll();
    }
    else {
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】维齐尔加入私聊失败，请手工拉入。");
    }
}

int BOTC_PoppySeat () {
    return BOTC_AbilitySeat(86);
}

//   原生身份、科怪赋予、说书人手工赋予都算；酒鬼认知里的罂粟不算。
//   能力来源中毒 / 醉酒 / 失效时不算。
bool BOTC_PoppyActive () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        if (q >= 2 && !g_seatOn[q]) {
            continue;
        }
        if (q >= 2 && BOTC_SeatDead(q)) {
            continue;                    // 罂粟死亡后不再阻止邪恶互认
        }
        if (BOTC_AbilityWorks(q, 86)) {
            return true;
        }
    }
    return false;
}

// 在真正写入死亡状态之前调用：此时能力状态还是死亡前的真实状态。
// 若罂粟能力正在生效，给他打「唤醒邪恶」token；中毒 / 醉酒死亡时不打。
void BOTC_PoppyDeathMark (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 86)) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 105] = true;
    BOTC_PmStore(g_teller, "【罂粟种植者】" + BOTC_NameStr(q) + " 死亡 → 今晚请唤醒爪牙和恶魔，让他们互相认识。");
}

// 登记成某个阵营时「看起来是什么身份」：优先挑这个阵营里**不在场**的身份
//   （这样报出来的身份不会跟真实的配板打架），实在没有就随便挑一个同阵营的。
//   陌客被看成爪牙 / 恶魔、间谍被看成镇民 / 外来者，都靠它给出那张脸。
int BOTC_RoleForTeamNotInPlay (int t) {
    int i;
    int n;
    int pick;
    pick = -1;
    n = 0;
    for (i = 0; i <= 148; i += 1) {
        if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = i;
            }
        }
    }
    if (pick >= 0) {
        return pick;
    }
    n = 0;
    for (i = 0; i <= 148; i += 1) {
        if (BOTC_RoleTeam(i) == t) {
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = i;
            }
        }
    }
    return pick;
}

// 某个座位「自称的身份」（伪装口供）：-1 = 没设。
// 智能说书判定用的就是它：中毒 / 酒鬼的人来查这个座位时，给的是这份口供而不是真身。
int BOTC_SeatClaim (int q) {
    if (q < 2 || q > 13) {
        return -1;
    }
    return g_claim[q];
}

// 参与座位列表的文本（诊断用），形如 "3 4 5 6 7 8 9 10 11"
string BOTC_SeatListStr () {
    int i;
    string s;
    BOTC_BuildSeatList();
    s = "";
    for (i = 0; i < g_seatN; i += 1) {
        if (i > 0) {
            s = s + " ";
        }
        s = s + IntToString(g_seatList[i] - 1);
    }
    return s;
}

//==================================================================================================
// 调查 / 信息类角色的判定（智能说书用；手动模式这些函数也照样能调）
//   核心原则：技能一律看「登记」那一层（间谍/陌客可能被看成别的），不要直接看真实身份。
//==================================================================================================

// 角色标签查询：tag 传单个位（1 / 2 / 4 / 8）
bool BOTC_RoleHasTag (int idx, int tag) {
    if (idx < 0 || idx > 148 || tag <= 0) {
        return false;
    }
    return ((g_roleTag[idx] / tag) % 2) == 1;
}

// 这个座位「现在算不算」某个阵营的人（t：0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）
//   陌客：登记成邪恶（爪牙/恶魔）时就不再算外来者 ---- 图管因此会得到「本局没有外来者」
//   间谍：登记成镇民/外来者时就算那个阵营，否则算爪牙
bool BOTC_SeatCountsAsTeam (int ob, int q, int t) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return false;
    }
    if (r == 15 || r == 18) {
        return (BOTC_PairTeam(ob, q) == t);
    }
    return (BOTC_RoleTeam(r) == t);
}

// 占卜师专用：这个座位在他眼里算不算恶魔。
//   ⚠ 这里**不吃**「中毒 / 酒鬼看反」那一层（BOTC_ViewTeam）：那一层会让每个好人有约 35%
//      的概率被看成恶魔，酒鬼占卜师验谁都是「有恶魔」，假干扰项反而没了意义。
//   所以占卜师这条改成：
//     ① 假干扰项（g_ftFakeSeat，只有智能说书有、玩家看不见）→ 一律算恶魔；
//     ② 真干扰项（g_herring）→ 算恶魔（酒鬼占卜师没有真干扰项）；
//     ③ 中毒 / 酒鬼时**真恶魔永远被看成善良**（包庇恶魔）；
//     ④ 其余按「登记」那一层算（陌客 / 间谍自己的伪装照样会让他看起来像恶魔）。
bool BOTC_RegistersAsDemonToFT (int ob, int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (ob == g_ftFakeOwner) {
        if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
            return true;
        }
    }
    if (q == g_herring) {
        if (!BOTC_SeatIsDrunk(ob)) {
            return true;
        }
    }
    if (BOTC_SeatImpaired(ob)) {
        if (BOTC_SeatTeam(q) == 3) {
            return false;              // 包庇恶魔：真恶魔在他眼里一定是善良
        }
    }
    return (BOTC_PairTeam(ob, q) == 3);
}

// 智能说书通过私聊给某个玩家发信息：进他的私聊日志，同时只对他弹一行字幕
//    ⚠ 第一参数必须是**物理座位**（客户端号）：手里是格子的话要写 g_who[格子]（开局随机座位后两者不同）。
// 【信息】统一标签：同一段文字重复调用时不会叠第二个前缀。
string BOTC_InfoText (string s) {
    if (StringFind(s, "【信息】", false) == 0) {
        return s;
    }
    return "【信息】" + s;
}

// 【测试·私聊镜像】（用户 2026-10-21）：只镜像 BOTC_PmInfo 的角色结果，不镜像普通玩家聊天。
//   镜像只写入说书人的私聊窗 / 日志，不弹全桌字幕，也不会把原信息误发给其他玩家。
void BOTC_PmMirrorInfo (int p, string s) {
    int whoBak;
    bool boxBak;
    if (!g_pmInfoMirrorOn || p == g_teller || p < 1 || p > 13) {
        return;
    }
    if (StringLength(s) <= 0) {
        return;
    }
    whoBak = g_chatWhoNow;
    boxBak = g_pmBoxOnlyNow;
    g_chatWhoNow = 0;
    g_pmBoxOnlyNow = false;
    BOTC_PmStore(g_teller, "【私聊镜像·" + BOTC_NameStr(BOTC_PosOf(p)) + "】" + s);
    g_chatWhoNow = whoBak;
    g_pmBoxOnlyNow = boxBak;
}

void BOTC_PmInfo (int p, string s) {
    int whoBak;
    if (p < 1 || p > 13) {
        return;
    }
    // 所有统一写作「你得知…」的角色结果自动加绿色【信息】标签；操作提示不强行套标签。
    if (StringFind(s, "你得知", false) == 0) {
        s = BOTC_InfoText(s);
    }
    // 信息是系统行：保存时把说话人清 0，聊天窗才会走绿色关键词渲染。
    whoBak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_AppendPm(p, s);
    g_chatWhoNow = whoBak;
    BOTC_PmMirrorInfo(p, s);
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_KeyColor(BOTC_NameSubst(s)));   // 提示条也保留【信息】绿色渲染
}

// 玩家确认技能后，在私聊框回显本人实际选择的目标。
void BOTC_TellRoleChoice (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 148) {
        return;
    }
    BOTC_PmInfo(g_who[p], "你选择了" + g_roleName[role] + "。");
}

void BOTC_TellSkillChoice (int p, int role) {
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    s = "";
    if (g_skillT1[p] >= 2) {
        s = BOTC_NameStr(g_skillT1[p]);
    }
    if (g_skillT2[p] >= 2) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(g_skillT2[p]);
    }
    if (g_skillT3[p] >= 2) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(g_skillT3[p]);
    }
    if (role >= 0 && role <= 148) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + g_roleName[role];
    }
    if (StringLength(s) <= 0) {
        return;
    }
    BOTC_PmInfo(g_who[p], "你选择了" + s + "。");
}

// 这次信息要不要说假话：中毒 / 酒鬼的人大概率（g_claimChance%）得到假信息，小概率得到真信息
bool BOTC_InfoIsLie (int ob) {
    if (!BOTC_SeatImpaired(ob)) {
        return false;
    }
    return (RandomInt(1, 100) <= g_claimChance);
}

// 给一个「错的」数字：在 0..3 里挑一个不等于真值的。
//   注意：厨师 / 共情者的假数字已经不靠「另掷一次骰」了 ---- 他们走「中毒 / 酒鬼看到的那一层」
//   （`g_pairVAlign`，一个座位只判一次），厨师再用 BOTC_ChefNear 压回「最多差 1 对」。
//   这条通用的「0..3 乱数」现在没人用，留着给别的数字类判定兜底。
int BOTC_WrongCount (int n) {
    int k;
    int i;
    for (i = 0; i < 32; i += 1) {
        k = RandomInt(0, 3);
        if (k != n) {
            return k;
        }
    }
    if (n == 0) {
        return 1;
    }
    return 0;
}

//==================================================================================================
// 酒鬼 / 中毒的送葬者：专门的概率与算法
//   ① 被处决的人「按登记算」是善良时：第 1 天大概率报他的真身，越往后报真身的概率越低，
//      而且假身份越来越往恶魔那边偏（第 1~2 天偏爪牙、第 3 天爪牙 / 恶魔五五、第 4 天起偏恶魔）；
//   ② 被处决的人「按登记算」是邪恶时：一律藏起来报一张善良身份（恶魔当然也藏），有口供先用口供；
//   ③ 目标如果是陌客 / 间谍，「真身」也是登记那一层的那张脸（干扰先生效）；
//   ④ 一个身份最多只报一次（`g_idUsed`；真身不受这条限制 ---- 他是真的，不能因为重复就改口）。
//==================================================================================================

// 第 day 天「报真身」的概率（百分比）
int BOTC_UtRealChance (int day) {
    if (day <= 1) {
        return 80;
    }
    if (day == 2) {
        return 55;
    }
    if (day == 3) {
        return 35;
    }
    return 25;
}

// 假身份里给「恶魔」的概率（百分比），其余给爪牙 ---- 越往后越容易甩恶魔
int BOTC_UtDemonChance (int day) {
    if (day <= 2) {
        return 20;
    }
    if (day == 3) {
        return 50;
    }
    return 70;
}

// 记住这个身份已经用过了（一个身份最多只报一次）
void BOTC_MarkIdUsed (int r) {
    if (r >= 0 && r <= 148) {
        g_idUsed[r] = true;
    }
}

// 挑一个「还没用过」的假身份：阵营 t（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）。
//   优先挑不在场的，其次随便挑；酒鬼（14）不当假身份用。都没有就返回 -1。
int BOTC_PickFreshFakeRole (int t) {
    int i;
    int n;
    int pick;
    pick = -1;
    n = 0;
    for (i = 0; i <= 148; i += 1) {
        if (i == 14) {
            continue;
        }
        if (BOTC_RoleTeam(i) != t) {
            continue;
        }
        if (g_idUsed[i]) {
            continue;
        }
        if (BOTC_RoleInPlay(i)) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = i;
        }
    }
    if (pick >= 0) {
        return pick;
    }
    n = 0;
    for (i = 0; i <= 148; i += 1) {
        if (i == 14) {
            continue;
        }
        if (BOTC_RoleTeam(i) != t) {
            continue;
        }
        if (g_idUsed[i]) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = i;
        }
    }
    return pick;
}

// 厨师报的数字：中毒 / 酒鬼看错之后可能跟真值差很远，压回「最多差 1 对」，别给太离谱的
int BOTC_ChefNear (int n, int nt) {
    if (n < nt - 1) {
        if (nt <= 0) {
            return 0;
        }
        return nt - 1;
    }
    if (n > nt + 1) {
        return nt + 1;
    }
    return n;
}

// 挑一个「现在场上没有的善良身份」（镇民 / 外来者）：优先用恶魔手上那 3 个不在场身份。
//   假信息报一个根本不在场的身份，怎么都不会跟真实的配板对上，最不容易穿帮。
//   （现在没人调用了 ---- 送葬者 / 守鸦人改成走「他看错的那一层」，留着备用。）
int BOTC_PickOutOfPlayGood () {
    int i;
    int r;
    g_hintN = 0;
    for (i = 0; i < 3; i += 1) {
        r = g_bluffPick[i] - 1;
        if (r >= 0 && r <= 16) {
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN > 0) {
        return g_fakePool[RandomInt(0, g_hintN - 1)];
    }
    g_hintN = 0;
    for (i = 0; i <= 16; i += 1) {
        if (BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
            g_fakePool[g_hintN] = i;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN > 0) {
        return g_fakePool[RandomInt(0, g_hintN - 1)];
    }
    return BOTC_WrongRole(0);
}

// 假信息里「就是 X」的那一位：优先挑真邪恶的座位（把好人的注意力往邪恶身上引）
//   注意：**恶魔也在候选里** ---- 调查员的假线索点到恶魔是合理的（这游戏本来就是在找恶魔）
//   ob = 提问题的人：他自己不能出现在这条信息里
// 假信息里「就是 X」的那个人。
//   wantGood = false（洗衣妇那类）：优先挑**真邪恶**的座位，把好人往邪恶身上引；
//   wantGood = true （调查员中毒 / 酒鬼）：优先挑**真身善良**的座位 ---- 这样配上后面的陪衬，
//     给出的就是「两个好人」里有一位是爪牙（陌客也算好人，不排除）。
int BOTC_PickFakeSubject (int ob, bool wantGood) {
    int i;
    int q;
    int k;
    int r;
    BOTC_BuildSeatList();
    g_hintN = 0;
    // 【认知覆盖角色优先】（用户 2026-09-20）：酒鬼 / 疯子自己就是「假信息」的好素材 ----
    //   中毒的洗衣妇可以说「酒鬼（以为自己是共情者）和占卜师里有一个是共情者」这种。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (BOTC_CogSeenRole(q) >= 0) {
            g_fakePool[g_hintN] = q;
            g_hintN = g_hintN + 1;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (wantGood) {
            if (BOTC_SeatAlign(q) == 0) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        else {
            if (BOTC_SeatAlign(q) == 1) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i < g_seatN; i += 1) {
            if (g_seatList[i] == ob) {
                continue;
            }
            g_fakePool[g_hintN] = g_seatList[i];
            g_hintN = g_hintN + 1;
        }
    }
    // 没掷中「互动干扰」时，把陌客 / 间谍的座位从池子里剔掉（剔完空了就保持原样）
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            q = g_fakePool[i];
            r = BOTC_SeatTrueRole(q);
            if (r != 15 && r != 18) {
                g_fakePool[k] = q;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0) {
        return 0;
    }
    return g_fakePool[RandomInt(0, g_hintN - 1)];
}

// 假信息里的「陪衬」：另挑一个座位（优先善良的，这一对看起来更像真的）
int BOTC_PickFakePartner (int subj, int ob) {
    int i;
    int q;
    int k;
    int r;
    BOTC_BuildSeatList();
    g_hintN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (q != subj && BOTC_SeatAlign(q) == 0) {
            g_fakePool[g_hintN] = q;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (q != subj) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    // 陪衬也一样：没掷中「互动干扰」就不拿陌客 / 间谍当陪衬
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            q = g_fakePool[i];
            r = BOTC_SeatTrueRole(q);
            if (r != 15 && r != 18) {
                g_fakePool[k] = q;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0) {
        return 0;
    }
    return g_fakePool[RandomInt(0, g_hintN - 1)];
}

// 假信息（洗衣妇 / 调查员 中毒或酒鬼时）：把好人往邪恶身上引 ----
//   ① 「就是 X」的那个人优先挑真邪恶的座位；
//   ② 报的身份优先用恶魔手上那 3 个不在场身份（挑同阵营的），没有就用别的「不在场的同阵营身份」。

//==================================================================================================
// 【认知覆盖角色的「他们以为的身份」】（用户 2026-09-20）：
//   酒鬼（14）和疯子（38）魔典上写的是**他们以为自己是**的那个身份（g_mark），
//   中毒 / 酒鬼的信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母...）可以拿这一份当假信息，
//   也可以把「这个认知覆盖的人」当成被点到的对象（例如中毒的洗衣妇会说「酒鬼（以为自己是共情者）
//   和占卜师里有一个是共情者」）。
//   疯子另外一条：他收到的那 3 个「不在场身份」里，**真正不在场**的那些优先拿来当假信息。
//==================================================================================================
int BOTC_CogSeenRole (int q) {
    int r;
    if (q < 2 || q > 13) {
        return -1;
    }
    r = BOTC_SeatTrueRole(q);
    if (r != 14 && r != 38) {
        return -1;                                  // 只有酒鬼 / 疯子是「认知覆盖」
    }
    r = g_mark[(g_teller * 14) + q] - 1;                         // 他「以为自己是」的那个身份
    if (r < 0 || r > 148) {
        return -1;
    }
    return r;
}

// 疯子（38）收到 / 选好的那 3 个不在场身份里，**真正不在场**的那些（用户要求优先）
void BOTC_PushLunaticBluffs (int t) {
    int i;
    int k;
    int r;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatTrueRole(i) != 38) {
            continue;
        }
        for (k = 0; k < 3; k += 1) {
            r = g_bluffOut[k] - 1;
            if (r < 0) {
                r = g_bluffPick[k] - 1;
            }
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;                           // 只要「真正不在场」的那几个
            }
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
}

void BOTC_PushCogSeenRoles (int t) {
    int i;
    int r;
    for (i = 2; i <= 13; i += 1) {
        r = BOTC_CogSeenRole(i);
        if (r < 0) {
            continue;
        }
        if (BOTC_RoleTeam(r) != t) {
            continue;
        }
        g_fakePool[g_hintN] = r;
        g_hintN = g_hintN + 1;
    }
}

bool BOTC_MakeFakeHint (int ob, int t) {
    int i;
    int r;
    int k;
    if (ob < 1 || ob > 13) {
        return false;
    }
    BOTC_BuildSeatList();
    // 【角色互动干扰概率】中毒 / 酒鬼的信息位报的**身份和点的人**也要过这一关（用户 2026-09-19）：
    //   这次掷中（g_fakeBias = true）才允许出现「互动干扰类」（陌客 15 / 间谍 18），
    //   没掷中就把它们从候选里剔掉 ---- 免得中毒的调查员老是「得知间谍」。
    g_fakeBias = (RandomInt(1, 100) <= g_infoBias);
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    // ① 「就是 X」的人：
    //     调查员（t == 2，找爪牙）→ 优先挑**真身善良**的，凑成「两个好人」给中毒 / 酒鬼的他
    //     其他（洗衣妇那种找镇民的）→ 还是优先挑真邪恶，把好人往邪恶身上引
    g_infoA = BOTC_PickFakeSubject(ob, (t == 2));
    // ② 报什么身份：**先**用「疯子收到的真正不在场身份」+「酒鬼 / 疯子以为的身份」（用户 2026-09-20），
    //   再用原来的「3 个不在场身份 → 不在场身份 → 同阵营随便」那三级兜底
    g_hintN = 0;
    BOTC_PushLunaticBluffs(t);
    BOTC_PushCogSeenRoles(t);
    for (i = 0; i < 3; i += 1) {
        r = g_bluffPick[i] - 1;
        if (r >= 0 && r <= 148 && BOTC_RoleTeam(r) == t) {
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i <= 148; i += 1) {
            if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
                g_fakePool[g_hintN] = i;
                g_hintN = g_hintN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i <= 148; i += 1) {
            if (BOTC_RoleTeam(i) == t) {
                g_fakePool[g_hintN] = i;
                g_hintN = g_hintN + 1;
            }
        }
    }
    // 报的身份也一样：没掷中「互动干扰」就不报陌客 / 间谍（剔完空了就保持原样）
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            r = g_fakePool[i];
            if (r != 15 && r != 18) {
                g_fakePool[k] = r;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0 || g_infoA <= 0) {
        return false;
    }
    g_infoRole = g_fakePool[RandomInt(0, g_hintN - 1)];
    // ③ 陪衬
    g_infoB = BOTC_PickFakePartner(g_infoA, ob);
    return (g_infoA > 0 && g_infoB > 0);
}

// 图书管理员（中毒 / 酒鬼）专用的假信息：
//   ① 场上有酒鬼：报「酒鬼」，而且「酒鬼」这个身份优先安在邪恶玩家的座位上
//      （真外来者的座位不算 ---- 免得跟真实的配板打架；酒鬼自己那个座位可以，
//        他在魔典上显示成镇民）。
//   ② 场上没酒鬼：跟别的假信息一样，报一个不在场的外来者、指向邪恶玩家。
bool BOTC_MakeFakeOutsiderHint (int ob) {
    int i;
    int q;
    int r;
    BOTC_BuildSeatList();
    g_fakeBias = (RandomInt(1, 100) <= g_infoBias);   // 同上：这次允不允许出现互动干扰
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    if (BOTC_RoleInPlay(14)) {
        g_hintN = 0;
        // 认知覆盖的人（酒鬼 / 疯子）先放进来（用户 2026-09-20）
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (BOTC_CogSeenRole(q) >= 0) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;                  // 别把「酒鬼」安在他自己头上
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0) {
                continue;
            }
            // 真外来者（管家 / 陌客 / 圣徒）不算
            if (r == 13 || r == 15 || r == 16) {
                continue;
            }
            if (BOTC_SeatAlign(q) == 1) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        if (g_hintN <= 0) {
            // 一个邪恶都没有（很少见）：镇民 / 酒鬼也算进来
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                if (q == ob) {
                    continue;
                }
                r = BOTC_SeatTrueRole(q);
                if (r < 0) {
                    continue;
                }
                if (r == 13 || r == 15 || r == 16) {
                    continue;
                }
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        if (g_hintN > 0) {
            g_infoRole = 14;
            g_infoA = g_fakePool[RandomInt(0, g_hintN - 1)];
            g_infoB = BOTC_PickFakePartner(g_infoA, ob);
            return (g_infoA > 0 && g_infoB > 0);
        }
    }
    return BOTC_MakeFakeHint(ob, 1);
}

// 生成「这两个人里有一位是 <某阵营的某个身份>」，结果放在 g_infoRole / g_infoA / g_infoB
//   t = 阵营（0 镇民 / 1 外来者 / 2 爪牙）
//   lie = true（中毒 / 酒鬼）：走「假信息」那一套（指向邪恶 + 用不在场身份），不再套用伪装口供
//   场上有干扰身份（陌客 / 间谍）时，有 g_infoBias% 的额外概率让那个「就是 X」的人是他
// 返回 false = 现在给不出这种信息（场上没人登记成这个阵营）
bool BOTC_MakeTeamHint (int ob, int t, bool lie) {
    int i;
    int q;
    int r;
    int r2;
    int subj;
    BOTC_BuildSeatList();
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    if (lie) {
        // 假信息（中毒 / 酒鬼的情报位）：伪装口供不再参与，改成「指向邪恶 + 用不在场身份」。
        //   图书管理员（外来者）有自己的一套（会优先报「酒鬼」）。
        if (t == 1) {
            return BOTC_MakeFakeOutsiderHint(ob);
        }
        return BOTC_MakeFakeHint(ob, t);
    }
    // 第一步：找出算这个阵营的人，顺便记下其中的干扰身份
    g_hintN = 0;
    g_hintBiasN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;                  // 「其中一位是 X」不能把提问题的人自己算进去
        }
        if (BOTC_SeatCountsAsTeam(ob, q, t)) {
            g_hintPool[g_hintN] = q;
            g_hintN = g_hintN + 1;
            r = BOTC_SeatTrueRole(q);
            if (r == 15 || r == 18) {
                g_hintBiasPool[g_hintBiasN] = q;
                g_hintBiasN = g_hintBiasN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        return false;
    }
    // 第二步：挑「就是 X」的那个人（有干扰身份时按概率优先指向他）
    subj = g_hintPool[RandomInt(0, g_hintN - 1)];
    if (g_hintBiasN > 0) {
        if (RandomInt(1, 100) <= g_infoBias) {
            subj = g_hintBiasPool[RandomInt(0, g_hintBiasN - 1)];
        }
    }
    // 第三步：报什么身份 ---- 真身就是这阵营就用真身；是登记成别的阵营（陌客 / 间谍），
    //   就用「他在这个观察者眼里是什么身份」（跟送葬者 / 守鸦人报的保持一致）；
    //   再不行才挑一个不在场的同阵营身份
    r = BOTC_SeatTrueRole(subj);
    if (BOTC_RoleTeam(r) == t) {
        g_infoRole = r;
    }
    else {
        r2 = BOTC_PairSeenRole(ob, subj);
        if (r2 >= 0 && r2 <= 148 && r2 != r && BOTC_RoleTeam(r2) == t) {
            g_infoRole = r2;
        }
        else {
            g_hintN = 0;
            for (i = 0; i <= 148; i += 1) {
                if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
                    g_hintPool[g_hintN] = i;
                    g_hintN = g_hintN + 1;
                }
            }
            if (g_hintN > 0) {
                g_infoRole = g_hintPool[RandomInt(0, g_hintN - 1)];
            }
            else {
                g_infoRole = r;
            }
        }
    }
    // 第四步：另一个陪衬 ---- 优先挑「不算这个阵营」的人，让这条信息更像真的
    g_hintN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (q != subj) {
            if (!BOTC_SeatCountsAsTeam(ob, q, t)) {
                g_hintPool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    g_infoA = subj;
    if (g_hintN > 0) {
        g_infoB = g_hintPool[RandomInt(0, g_hintN - 1)];
    }
    else {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (q != subj) {
                g_infoB = q;
            }
        }
    }
    return (g_infoA > 0 && g_infoB > 0);
}

// 厨师：相邻两个都算邪恶的「对数」
//   useView = true 时用「中毒 / 酒鬼看到的那一层」（按观察者算，只在把某个人看错的座位上不同）
int BOTC_ChefCount (int ob, bool useView) {
    int i;
    int a;
    int b;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (BOTC_SeeAlign(ob, a, useView) == 1 && BOTC_SeeAlign(ob, b, useView) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 厨师：**真身口径**的「相邻邪恶对数」----不看登记 / 干扰那一层。
//   专门给说书人自己对账用：真身 3 连坐（例如 10、11、12 全邪恶）这里就是 2 对，
//   而厨师实际听到的数字走登记层（间谍被洗白就少一对），两个数不一样是正常的。
int BOTC_ChefCountTrue () {
    int i;
    int a;
    int b;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (BOTC_SeatAlign(a) == 1 && BOTC_SeatAlign(b) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 把「相邻邪恶」的那几对写成文字： (玩家10+玩家11) (玩家11+玩家12)
//   trueLayer = true 按真身算；false 按「观察者 ob 眼里的登记」算
string BOTC_ChefPairStr (int ob, bool trueLayer) {
    int i;
    int a;
    int b;
    int ea;
    int eb;
    string s;
    bool first;
    BOTC_BuildSeatList();
    s = "";
    first = true;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (trueLayer) {
            ea = BOTC_SeatAlign(a);
            eb = BOTC_SeatAlign(b);
        }
        else {
            ea = BOTC_PairAlign(ob, a);
            eb = BOTC_PairAlign(ob, b);
        }
        if (ea == 1 && eb == 1) {
            if (first) {
                s = "(" + BOTC_NameStr(a) + "+" + BOTC_NameStr(b) + ")";
                first = false;
            }
            else {
                s = s + " (" + BOTC_NameStr(a) + "+" + BOTC_NameStr(b) + ")";
            }
        }
    }
    if (first) {
        return "没有";
    }
    return s;
}

// 厨师诊断用：列出「真身和登记不一样」的座位（间谍被洗白 / 陌客被抹黑那种）
string BOTC_ChefOddStr (int ob) {
    int i;
    int q;
    int r;
    int sr;
    string s;
    bool first;
    BOTC_BuildSeatList();
    s = "";
    first = true;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        if (r < 0) {
            continue;                      // 这个座位还没发身份：跳过，别让 g_roleName 越界
        }
        sr = BOTC_PairSeenRole(ob, q);
        if (sr >= 0 && sr != r) {
            if (first) {
                s = BOTC_NameStr(q) + "＝" + g_roleName[r] + "→被看成 " + g_roleName[sr] + "（" + BOTC_RoleTagStr(sr) + "）";
                first = false;
            }
            else {
                s = s + "｜" + BOTC_NameStr(q) + "＝" + g_roleName[r] + "→被看成 " + g_roleName[sr] + "（" + BOTC_RoleTagStr(sr) + "）";
            }
        }
    }
    if (first) {
        return "没有";
    }
    return s;
}

// 共情者：左右两边最近的两个「活着的」玩家里，有几个算邪恶（自己死了返回 -1）
// 本局真正邪恶的人数（爪牙 + 恶魔）---- 共情者的「邪恶名额」上限就用它
int BOTC_EvilCountTrue () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAlign(q) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 酒鬼 / 中毒的共情者已经用掉几个「邪恶名额」
int BOTC_EmpMarkCount () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_empMark[i]) {
            n = n + 1;
        }
    }
    return n;
}

// 这个座位在酒鬼 / 中毒的共情者眼里算不算邪恶（带名额限制）。
//   **只有「正常的善良身份被他看错成邪恶」才占名额**：
//     ① 真身是邪恶 → 照报邪恶，但不占名额（那不是"看错"，本来就有这么多邪恶）；
//     ② 真身善良、但登记层是邪恶（陌客那种自己的干扰）→ 照报邪恶，也不占名额；
//     ③ 真身善良、登记层也善良 → 那就是他被中毒 / 酒鬼影响看错了，**占名额**；
//        名额用完（= 本局邪恶人数）以后再遇到这种座位，一律当善良报。
//   之前已经占过名额的座位会一直沿用。
bool BOTC_EmpSeatEvil (int me, int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (BOTC_ViewAlign(me, q) != 1) {
        return false;                  // 他眼里这个是善良，不用讨论
    }
    if (BOTC_SeatAlign(q) != 0) {
        return true;                   // 真身就是邪恶：照报，不占名额
    }
    if (BOTC_PairAlign(me, q) != 0) {
        return true;                   // 陌客 / 间谍自己造成的「邪恶」：照报，不占名额
    }
    if (g_empMark[q]) {
        return true;
    }
    if (BOTC_EmpMarkCount() >= BOTC_EvilCountTrue()) {
        return false;                  // 名额用完了：看错成邪恶也只能当善良
    }
    g_empMark[q] = true;
    return true;
}

// 酒鬼 / 中毒共情者最终报出来的数「几个邪恶」（带名额限制）
int BOTC_EmpathCountCapped (int me) {
    int l;
    int r;
    int n;
    n = 0;
    l = BOTC_EmpathNeighbor(me, -1);
    r = BOTC_EmpathNeighbor(me, 1);
    if (l > 0) {
        if (BOTC_EmpSeatEvil(me, l)) {
            n = n + 1;
        }
    }
    if (r > 0) {
        if (BOTC_EmpSeatEvil(me, r)) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_EmpathCount (int ob, int me, bool useView) {
    int i;
    int k;
    int q;
    int n;
    int left;
    int right;
    BOTC_BuildSeatList();
    if (BOTC_SeatDead(me)) {
        return -1;
    }
    k = -1;
    for (i = 0; i < g_seatN; i += 1) {
        if (g_seatList[i] == me) {
            k = i;
        }
    }
    if (k < 0 || g_seatN < 2) {
        return 0;
    }
    left = 0;
    right = 0;
    i = (k + g_seatN - 1) % g_seatN;
    for (q = 0; q < g_seatN; q += 1) {
        if (left > 0) {
            q = g_seatN;
        }
        else {
            if (BOTC_SeatDead(g_seatList[i])) {
                i = (i + g_seatN - 1) % g_seatN;
            }
            else {
                left = g_seatList[i];
            }
        }
    }
    i = (k + 1) % g_seatN;
    for (q = 0; q < g_seatN; q += 1) {
        if (right > 0) {
            q = g_seatN;
        }
        else {
            if (BOTC_SeatDead(g_seatList[i])) {
                i = (i + 1) % g_seatN;
            }
            else {
                right = g_seatList[i];
            }
        }
    }
    n = 0;
    if (left > 0) {
        if (BOTC_SeeAlign(ob, left, useView) == 1) {
            n = n + 1;
        }
    }
    if (right > 0) {
        if (BOTC_SeeAlign(ob, right, useView) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 共情者的一个邻居：dir = -1 左边 / +1 右边，返回座位号（没有就 0）。
//   跳过死人 ---- 和 BOTC_EmpathCount 的「最近的两个活人」保持一致。
int BOTC_EmpathNeighbor (int me, int dir) {
    int i;
    int k;
    int q;
    BOTC_BuildSeatList();
    if (me < 2 || me > 13 || g_seatN < 2) {
        return 0;
    }
    k = -1;
    for (i = 0; i < g_seatN; i += 1) {
        if (g_seatList[i] == me) {
            k = i;
        }
    }
    if (k < 0) {
        return 0;
    }
    i = (k + dir + g_seatN) % g_seatN;
    for (q = 1; q < g_seatN; q += 1) {
        if (!BOTC_SeatDead(g_seatList[i])) {
            return g_seatList[i];
        }
        i = (i + dir + g_seatN) % g_seatN;
    }
    return 0;
}

// 共情者身边的邻居里有没有陌客（索引 15）：
//   有陌客在场时才允许把假信息说成「2 个邪恶」---- 陌客本来就可能被看成邪恶，说得通；
//   没有陌客还给 2，那这条信息基本就是明摆着告诉他自己是酒鬼。
bool BOTC_EmpathNeighborIsRecluse (int me) {
    int a;
    int b;
    a = BOTC_EmpathNeighbor(me, -1);
    b = BOTC_EmpathNeighbor(me, 1);
    if (a > 0 && BOTC_SeatTrueRole(a) == 15) {
        return true;
    }
    if (b > 0 && BOTC_SeatTrueRole(b) == 15) {
        return true;
    }
    return false;
}

//==================================================================================================
// 【诊断】往说书人私聊日志里写细节，方便测试时核对「陌客 / 间谍的干扰有没有生效」。
//   只写说书人日志（玩家看不到），所以可以放心把真身写出来。
//==================================================================================================

// 这个座位现在是清醒 / 中毒 / 酒鬼（诊断文案用）
string BOTC_DiagStateStr (int q) {
    if (!g_debugOn) {
        return "";
    }
    if (BOTC_SeatIsDrunk(q)) {
        return "酒鬼";
    }
    if (BOTC_SeatIsPoisoned(q)) {
        return "中毒";
    }
    return "清醒";
}

// 这次信息是真话还是假话（lie 传「这条答案跟登记层不一样」）
string BOTC_DiagLie (int ob, bool lie) {
    string who;
    if (!BOTC_SeatImpaired(ob)) {
        return "真信息（他清醒）";
    }
    who = BOTC_DiagStateStr(ob);
    if (lie) {
        return "假信息（他是" + who + "）";
    }
    return "真信息（他是" + who + "，这次掷到真话）";
}

// 这个座位在「观察者 ob」眼里是什么样（简短版，一行放得下）：
//   普通座位 =「玩家3＝共情者」；陌客 / 间谍额外写这次有没有被当成别的身份
string BOTC_DiagSeat (int ob, int q) {
    int r;
    int t;
    int sr;
    string s;
    if (q < 2 || q > 13) {
        return "（无）";
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return BOTC_NameStr(q) + "＝未定";
    }
    s = BOTC_NameStr(q) + "＝" + g_roleName[r];
    if (BOTC_SeatImpaired(ob)) {
        // 中毒 / 酒鬼：他「看错」的座位是固定下来的，这里写的就是他眼里的样子
        t = BOTC_ViewTeam(g_who[ob], q);
        sr = BOTC_ViewSeenRole(g_who[ob], q);
        if (t == BOTC_RoleTeam(r) && sr == r) {
            return s + "（没看错）";
        }
        if (sr >= 0 && sr <= 148) {
            return s + "→他看成 " + g_roleName[sr] + "（" + BOTC_TeamName(t) + "·" + BOTC_AlignName(BOTC_ViewAlign(ob, q)) + "）";
        }
        return s + "→看成别的身份";
    }
    if (r == 15 || r == 18) {
        t = BOTC_PairTeam(g_who[ob], q);
        if (t == BOTC_RoleTeam(r)) {
            s = s + "（没被当成别的）";
        }
        else {
            sr = BOTC_PairSeenRole(g_who[ob], q);
            if (sr >= 0 && sr <= 148) {
                s = s + "→看成 " + g_roleName[sr] + "（" + BOTC_TeamName(t) + "·" + BOTC_AlignName(BOTC_PairAlign(ob, q)) + "）";
            }
            else {
                s = s + "→被当成别的身份";
            }
        }
    }
    return s;
}

// 【诊断】单独一行写进说书人私聊日志。为了不让日志变长、也不要一行太长被界面截掉，
//   只有「本人中毒 / 酒鬼」「涉及陌客 / 间谍」「涉及占卜师干扰项」时才写。
//   a / b 是这条信息涉及的座位（没有就传 0）。
void BOTC_DiagSeatLine (string tag, int ob, bool lie, int a, int b) {
    int ra;
    int rb;
    bool hasHerring;
    string s;
    ra = -1;
    rb = -1;
    hasHerring = false;
    if (a >= 2 && a <= 13) {
        ra = BOTC_SeatTrueRole(a);
    }
    if (b >= 2 && b <= 13) {
        rb = BOTC_SeatTrueRole(b);
    }
    if (g_herring >= 2) {
        // 酒鬼占卜师没有真干扰项（只有那 2 个假干扰项），诊断里也不用提
        if (!BOTC_SeatIsDrunk(ob)) {
            if (a == g_herring || b == g_herring) {
                hasHerring = true;
            }
        }
    }
    if (!BOTC_SeatImpaired(ob) && ra != 15 && ra != 18 && rb != 15 && rb != 18 && !hasHerring) {
        return;
    }
    s = "【诊断·" + tag + "】" + BOTC_DiagLie(ob, lie);
    if (a >= 2 && a <= 13) {
        s = s + "｜" + BOTC_DiagSeat(ob, a);
    }
    if (b >= 2 && b <= 13) {
        s = s + "｜" + BOTC_DiagSeat(ob, b);
    }
    if (hasHerring) {
        s = s + "｜干扰项 " + BOTC_HerringStr();
    }
    BOTC_DiagStore(g_teller, s);
}

// 厨师专用诊断（写说书人私聊日志）：说书人问得最多的一句就是
//   「为什么厨师报的对数跟我数的真身对数不一样」---- 因为厨师走的是**登记层**，
//   间谍被当成善良就会少一对、陌客被当成邪恶就会多一对。
//   这里把「真身几对 / 登记后几对 / 两个数字各自是哪几对 / 谁被当成别的身份」全写清楚。
//   没有干扰（登记 = 真身）而且他没中毒 / 酒鬼 时不写，免得刷屏。
void BOTC_DiagChefLine (int ob, int nRep, int ntReg) {
    int t;
    string s;
    t = BOTC_ChefCountTrue();
    if (t == ntReg && nRep == ntReg && !BOTC_SeatImpaired(ob)) {
        return;
    }
    s = "【诊断厨师】" + BOTC_DiagLie(ob, nRep != ntReg) + "｜真身相邻邪恶 " + IntToString(t) + " 对：" + BOTC_ChefPairStr(ob, true);
    BOTC_DiagStore(g_teller, s);
    s = "【诊断厨师】登记后 " + IntToString(ntReg) + " 对：" + BOTC_ChefPairStr(ob, false) + "｜他实际被告知 " + IntToString(nRep) + " 对";
    BOTC_DiagStore(g_teller, s);
    s = "【诊断厨师】登记与真身不一致：" + BOTC_ChefOddStr(ob);
    BOTC_DiagStore(g_teller, s);
}

// 占卜师诊断里对一个座位的描述：真身 + 登记阵营 + 是不是（假 / 真）干扰项
string BOTC_DiagFtSeat (int ob, int q) {
    int r;
    string s;
    if (q < 2 || q > 13) {
        return "（无）";
    }
    r = BOTC_SeatTrueRole(q);
    s = BOTC_NameStr(q) + "＝" + BOTC_RoleNameSafe(r) + "（" + BOTC_TeamName(BOTC_PairTeam(ob, q)) + "）";
    if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
        s = s + "·假干扰项";
    }
    else {
        if (q == g_herring) {
            if (!BOTC_SeatIsDrunk(ob)) {
                s = s + "·真干扰项";
            }
        }
    }
    return s;
}

// 占卜师专用诊断行：写清楚「他是什么状态、报了什么、两个座位各是什么」
void BOTC_DiagFtLine (int ob, int a, int b, bool demon, bool realDemon) {
    string s;
    s = "【诊断占卜师】" + BOTC_DiagStateStr(ob) + "｜报 " + BOTC_YesNoStr(demon) + "（真值 " + BOTC_YesNoStr(realDemon) + "）";
    s = s + "｜" + BOTC_DiagFtSeat(ob, a) + "｜" + BOTC_DiagFtSeat(ob, b);
    BOTC_DiagStore(g_teller, s);
}

// 诊断用：占卜师那条「有 / 没」的真值
string BOTC_YesNoStr (bool b) {
    if (b) {
        return "有恶魔";
    }
    return "没恶魔";
}

// 把一个身份索引渲染成给玩家看的文案（送葬者 / 守鸦人的答案走这里）：
// 身份索引 -> 名字（越界给「未定」，诊断文案用）
string BOTC_RoleNameSafe (int r) {
    if (r < 0 || r > 148) {
        return "未定";
    }
    return g_roleName[r];
}

// 送葬者专用诊断行：把「真身 / 登记层看到什么 / 实际报的是什么」都写清楚 ----
//   普通那行【诊断】写的是「他看错的那一层」，那是给占卜师 / 共情者 / 厨师用的，
//   送葬者（尤其是酒鬼 / 中毒的）不吃那一层，所以单独写。
void BOTC_DiagUtLine (int q, bool lie, int t, int r2, int rp, int day) {
    string s;
    if (!BOTC_SeatImpaired(q)) {
        s = "【诊断送葬者】清醒";
    }
    else {
        if (lie) {
            s = "【诊断送葬者】假信息（他是" + BOTC_DiagStateStr(q) + "）";
        }
        else {
            s = "【诊断送葬者】真信息（他是" + BOTC_DiagStateStr(q) + "）";
        }
    }
    s = s + "｜第" + IntToString(day) + "天｜" + BOTC_NameStr(t) + " 真身 " + BOTC_RoleNameSafe(BOTC_SeatTrueRole(t));
    if (r2 != BOTC_SeatTrueRole(t)) {
        s = s + "，登记层看到 " + BOTC_RoleNameSafe(r2);   // 陌客 / 间谍被当成别的身份
    }
    else {
        s = s + "，登记层没被伪装";
    }
    s = s + "｜报的是 " + BOTC_RoleNameSafe(rp);
    BOTC_DiagStore(g_teller, s);
}

// 把一个身份索引渲染成给玩家看的文案（送葬者 / 守鸦人的答案走这里）：
//   跟这个座位的真身一致时沿用 BOTC_SeatRoleStr（说书人提示里会给酒鬼带「（酒鬼）」后缀），
//   是伪装 / 看错的身份就直接报那个名字；
//   例外：报出来的就是这个座位**真的是酒鬼**时，只写「酒鬼」，不带他以为自己是的那张皮
string BOTC_RoleTextStr (int q, int r) {
    if (r < 0 || r > 148) {
        return "未定";
    }
    if (r == 14) {
        return g_roleName[14];         // 酒鬼：只报「酒鬼」，不带他以为自己是的那张皮
    }
    if (r == 38) {
        return g_roleName[38];         // 疯子：同理，只报「疯子」（用户 2026-09-20）
    }
    if (r == BOTC_SeatTrueRole(q)) {
        return BOTC_SeatRoleStr(q);
    }
    return g_roleName[r];
}

// 诊断用：干扰项（占卜师）现在挂在谁头上
string BOTC_HerringStr () {
    if (g_herring >= 2 && g_herring <= 13) {
        return BOTC_NameStr(g_herring);
    }
    return "无";
}

// 【中毒 / 酒鬼也留真信息 token】（用户 2026-09-19）：先算一遍「他本来应该得知的」那条信息，
//   在**说书人那份魔典**上打上命中 / 错误的 token；打完之后 g_infoA / g_infoB / g_infoRole
//   会被调用方随后的「假信息」重算覆盖掉，所以这里只是顺手留个底。
//   lie = false（本来就该说真话）时什么都不做 ---- 正常流程自己会打；
//   **酒鬼不补**（酒鬼本身不是镇民，见 BOTC_MarkInfoTokens 里的说明）。
void BOTC_MarkTrueInfoTokens (int who, int t, bool lie) {
    if (!lie) {
        return;
    }
    if (who < 2 || who > 13) {
        return;
    }
    if (BOTC_SeatIsDrunk(who)) {
        return;                        // 酒鬼：不补真信息 token
    }
    if (BOTC_MakeTeamHint(who, t, false)) {
        BOTC_MarkInfoTokens(who, t, false);
    }
}

// 「其中一位是 X」这类信息：算好后私聊发给本人，同时给说书人记一行（带诊断）

// 【智能说书】「其中一位是 X」这类信息报完之后，在**说书人那份魔典**上补 token ----
//   这样结算 / 复盘（公开魔典）时能一眼看出当时这条信息是怎么给的（用户 2026-09-16 要求）：
//     洗衣妇（t = 0）：命中那位打 token 0「镇民（洗衣妇）」、陪衬那位打 token 1「错误（洗衣妇）」
//     图书管理员（t = 1）：token 2 / 3        调查员（t = 2）：token 4 / 5
//   ⚠ 命中那位 = g_infoA（就是「就是 X」的那个人）；g_infoB 是陪衬。
//   ⚠ 传 lie = true（这是**假信息**）时直接不打；传 lie = false 就照打 ----
//     用户 2026-09-19 改的：**中毒的人**也要在魔典上留下「他本来应该得知的」那条 token
//     （由 BOTC_MarkTrueInfoTokens 先把真信息算一遍再调这里）。
//   ⚠ **酒鬼不一样**（用户 2026-09-19）：酒鬼本身就不是镇民（魔典上写的是他「以为」的身份），
//     所以酒鬼一律不打 token。厨师（t = 3）是数字信息，本来就没有 token，不打。
void BOTC_MarkInfoTokens (int ob, int t, bool lie) {
    int tok;
    if (lie) {
        return;                        // 假信息：不打（真信息由 BOTC_MarkTrueInfoTokens 那边补）
    }
    if (ob < 2 || ob > 13) {
        return;
    }
    if (BOTC_SeatIsDrunk(ob)) {
        return;                        // 酒鬼：本来就不是镇民，不打 token（用户 2026-09-19）
    }
    if (g_infoA < 2 || g_infoA > 13 || g_infoB < 2 || g_infoB > 13) {
        return;
    }
    if (t == 0) {
        tok = 0;                       // 镇民（洗衣妇）
    }
    else {
        if (t == 1) {
            tok = 2;                   // 外来者（图管）
        }
        else {
            if (t == 2) {
                tok = 4;               // 爪牙（调查员）
            }
            else {
                return;                // 厨师那种数字信息：不打
            }
        }
    }
    g_tokOn[(((g_teller * 14) + g_infoA) * 256) + tok] = true;        // 命中那位：镇民 / 外来者 / 爪牙（对应角色）
    g_tokOn[(((g_teller * 14) + g_infoB) * 256) + tok + 1] = true;    // 陪衬那位：错误（同角色）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "已按这条信息在魔典打上 token：" + BOTC_NameStr(g_infoA) + "＝" + g_tokName[tok] + "；" + BOTC_NameStr(g_infoB) + "＝" + g_tokName[tok + 1] + "。");
}

// 第一夜：智能说书把被动信息类角色的信息私聊发给他们
// 【智能说书】轮到他被唤醒时，把他该知道的信息私聊给他（先唤醒 → 再给信息 → 再选目标/收回）
//   洗衣服 / 图书管理员 / 调查员 / 厨师 / 共情者 = 首夜信息；送葬者 = 今天被处决的人；间谍 = 看魔典

//==================================================================================================
// 【智能说书】邪恶阵营互通信息（这不是唤醒，不记作唤醒）：恶魔知道爪牙是谁（不说他们的具体角色），
//   爪牙知道恶魔和其他爪牙是谁；顺便把 3 个「不在场身份」发给恶魔（新恶魔诞生时再抽一次）。
//==================================================================================================


// 打开「自称身份」面板：ob = 谁来选（说书人 1 或邪恶玩家自己），who = 给哪个座位设
// 邪恶玩家自己设的时候，面板里只留善良身份（镇民 / 外来者），因为他们要伪装成好人。
void BOTC_ClaimOpen (int ob, int who) {
    if (who < 2 || who > 13) {
        return;
    }
    // 【真人说书不开放伪装身份】（用户 2026-09-20）：那个按钮本来只给邪恶玩家，但真人说书时伪装由说书人自己安排
    BOTC_Notice(ob, "真人说书：伪装身份由说书人自己安排，不需要你选。");
    return;
    g_pickMode[ob] = 2;
    g_pickWho[ob] = who;
    if (ob == g_teller) {
    libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_PlayerNameText(who) + StringToText(" 自称的身份（伪装）"), PlayerGroupSingle(ob));
        BOTC_PickFilter(ob, false);
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("我自称的身份（只能挑善良身份）"), PlayerGroupSingle(ob));
        BOTC_PickFilter(ob, true);
    }
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

// 身份面板里哪些按钮可见：goodOnly = 只留善良身份（镇民 / 外来者）
// 教父（39）的配比方向：+1 = 外来者 +1 / 镇民 -1；-1 = 反过来（用户 2026-09-20 手动指定）
// 銆愭皵鐞冮┚椹跺憳锛?2锛夌殑閰嶆瘮鏂瑰悜銆戯紙鐢ㄦ埛 2026-09-23锛夛細璺熸暀鐖堕偅濂椾竴涓€瀵瑰簲锛屽彧鏄礋鏂瑰悜鏄€?0銆嶄笉鏄€?1銆?---
//   （这一行是上一次写入时的乱码注释，已清理：用户 2026-09-23）
// 【气球驾驶员（72）的配比方向】（用户 2026-09-23）：跟教父那套一一对应，只是负方向是「+0」不是「-1」----
//   plus = true  → 外来者 +1、镇民 -1
//   plus = false → 什么都不动（+0）
void BOTC_BalPickSet (int p, bool plus) {
    if (p != g_teller) {
        return;
    }
    g_balPlus = plus;
    g_balPlusSeeded = true;        // 手动指定过就不再让发牌那边掷 50/50
    if (plus) {
        BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
        BOTC_Notice(g_teller, "气球驾驶员配比：外来者 +1、镇民 -1。");
    }
    else {
        BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
        BOTC_Notice(g_teller, "气球驾驶员配比：镇民不变。");
    }
}
// 【哨兵（88）的配比】（用户 2026-09-26）---- 传奇角色：v = -1 / 0 / +1
//   +1：外来者 +1、镇民 -1；-1：外来者 -1、镇民 +1；0：不变
void BOTC_SentPickSet (int v) {
    g_sentAdjust = v;
    if (v > 0) {
        BOTC_Notice(g_teller, "哨兵配比：外来者 +1、镇民 -1。");
    }
    else {
        if (v < 0) {
            BOTC_Notice(g_teller, "哨兵配比：外来者 -1、镇民 +1。");
        }
        else {
            BOTC_Notice(g_teller, "哨兵配比：不变。");
        }
    }
    BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);
}

void BOTC_GfPickSet (int p, bool plus) {
    if (p != g_teller) {
        return;
    }
    g_gfPlus = plus;
    g_gfPlusSeeded = true;                       // 手动指定过就不再让发牌那边掷 50/50
    BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
    if (plus) {
        BOTC_Notice(g_teller, "教父配比：外来者 +1、镇民 -1。");
        // （这行「【教父】说书人手动指定配比方向：…」已按用户 2026-09-23 要求删掉）
    }
    else {
        BOTC_Notice(g_teller, "教父配比：外来者 -1、镇民 +1。");
        // （这行「【教父】说书人手动指定配比方向：…」已按用户 2026-09-23 要求删掉）
    }
}

// 技能专用角色网格的限制：翻页后也必须继续生效。
bool BOTC_PickModeRoleAllowed (int p, int r) {
    int mode;
    int seat;
    if (p < 1 || p > 13 || r < 0 || r > 148) {
        return false;
    }
    mode = g_pickMode[p];
    if (mode == 3) {
        return BOTC_CanDeathClaimRole(r, BOTC_PosOf(p));
    }
    if (mode == 9 && g_philoKind == 118) {
        return (r != 14 && r != 38);
    }
    if (mode == 16 && g_cerenRole == 118) {
        return (r != 14 && r != 38);
    }
    if (mode == 20) {
        return (r == 18 || r == 75);
    }
    if (mode == 22) {
        seat = BOTC_SeatOfRole(r);
        return (seat >= 2 && seat <= 13 && !BOTC_SeatDead(seat));
    }
    if (mode == 23) {
        seat = BOTC_SeatOfRole(r);
        return ((seat >= 2 && seat <= 13) || BOTC_SeatTrueRole(1) == r);
    }
    if (mode == 32) {
        return BOTC_BoffinRoleAllowed(r);
    }
    if (mode == 35) {
        return (BOTC_RoleAlign(r) == 0 && r != 56 && r != 95);
    }
    return true;
}

// 相克规则允许在「只列善良」里额外露出哥布林。generic 过滤之后单独补回。
bool BOTC_PickModeShowsGoblin (int p) {
    int mode;
    int act;
    if (p < 1 || p > 13) {
        return false;
    }
    mode = g_pickMode[p];
    if (mode == 14) {
        return true;
    }
    if (mode == 12 && g_miRole >= 60 && (g_miRole - 60) == 25) {
        return true;
    }
    if (mode == 41) {
        act = BOTC_ActRoleOf(g_pickWho[p]);
        return (act == 66);
    }
    return false;
}

void BOTC_PickCatCtrlRender (int p) {
    int t;
    int pages;
    bool show;
    if (p < 1 || p > 13) {
        return;
    }
    for (t = 0; t < 4; t += 1) {
        pages = BOTC_GridCatPages(t, BOTC_GridCatCap(t));
        show = (pages > 1);
        DialogControlSetVisible(g_pickCatPrev[t], PlayerGroupSingle(p), show);
        DialogControlSetVisible(g_pickCatNext[t], PlayerGroupSingle(p), show);
    }
}

void BOTC_PickFilter (int p, bool goodOnly) {
    int q;
    bool show;
    g_pickFilterGood[p] = goodOnly;
    g_pickFilterTeam[p] = g_pickTeam;
    g_pickFilterAlign[p] = g_pickAlign;
    BOTC_PickLayoutFor(p);
    // 【点击快照】面板显示完成后，立刻保存这一位玩家眼前的 64 格角色。
    //   全追角色很多，其它功能调用 BOTC_GridPlan() 会重排公共 g_gridSlot；
    //   普通发身份点击时必须读这里，避免显示的「僵怖」被重排后的「数学家」槽位覆盖。
    for (q = 0; q < 64; q += 1) {
        g_pickSlotRole[(p * 64) + q] = g_gridSlot[q];
    }
    // 【末尾那几个固定槽（g_gridN..63）默认全部藏起来】（用户 2026-10-04 报「炼金术士面板多出一只哥布林」）：
    //   声称面板（BOTC_DeclareOpen）和炼金术士借能力面板（BOTC_AlcBorrowOpen）都会把角色摆到这几个槽里，
    //   而它们**共用同一个对话框** —— 不先清一遍，上一面用过的格子（比如 61 号槽那只白字「哥布林」）
    //   就会留在这一面；炼金面板只按「团队」过滤，哥布林本来就是爪牙，所以它躲过了过滤、留在屏幕上。
    for (q = g_gridN; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    for (q = 0; q < g_gridN; q += 1) {
        // 图标网格版：按钮和它的图标、名字要一起显隐（格子的身份见 g_gridSlot）
        show = true;
        if (goodOnly && BOTC_RoleAlign(g_gridSlot[q]) == 1) {
            show = false;
        }
        if (g_pickTeam >= 0 && BOTC_RoleTeam(g_gridSlot[q]) != g_pickTeam) {
            show = false;
        }
        if (g_pickAlign >= 0 && BOTC_RoleAlign(g_gridSlot[q]) != g_pickAlign) {
            show = false;
        }
        if (!BOTC_PickModeRoleAllowed(p, g_gridSlot[q])) {
            show = false;
        }
        if (g_gridSlot[q] == 99 && BOTC_PickModeShowsGoblin(p)) {
            show = true;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), show);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), show);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), show);
    }
    g_pickTeam = -1;          // 过滤是一次性的：用完立刻还原成「不过滤」（用户 2026-09-21）
    g_pickAlign = -1;
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给「取消」----
    //   筑梦师 / 首夜信息位 / 洗脑师 / 麻脸巫婆（含认知覆盖）/ 赌徒猜身份都必须选完，不给取消；
    //   侍臣（不发动技能）/ 哲学家（这夜先不选）/ 说书人改身份 / 测试 / 杂耍艺人那一行保留。
    show = true;
    if (g_pickMode[p] == 4 || g_pickMode[p] == 10 || g_pickMode[p] == 11 || g_pickMode[p] == 12) {
        show = false;
    }
    if (g_pickMode[p] == 14 || g_pickMode[p] == 15 || g_pickMode[p] == 16) {
        show = false;
    }
    // 限次角色的角色选择：侍臣 / 哲学家 / 工程师 / 鸩。
    if (g_pickMode[p] == 5 || g_pickMode[p] == 8 || g_pickMode[p] == 19 || g_pickMode[p] == 28) {
        show = false;
    }
    // 其余由角色技能或技能后续步骤调度的身份网格：同样不给底部取消 / 返回。
    if (g_pickMode[p] == 9 || g_pickMode[p] == 13 || g_pickMode[p] == 17 || g_pickMode[p] == 20 || g_pickMode[p] == 21 || g_pickMode[p] == 22 || g_pickMode[p] == 23 || g_pickMode[p] == 26 || g_pickMode[p] == 27 || g_pickMode[p] == 30 || g_pickMode[p] == 35 || g_pickMode[p] == 36 || g_pickMode[p] == 41 || g_pickMode[p] == 42) {
        show = false;
    }
    // 【科学怪人（132）首夜】：必须选择一份能力，不给取消
    if (g_pickMode[p] == 32) {
        show = false;
    }
    if (g_pickMode[p] == 39) {
        show = false;                  // 瘟疫医生死亡时必须选择一个爪牙能力
    }

    // 【巡山人（77）· 说书人给落难少女定新身份】（用户 2026-10-04）：这一步必须选完 —— 不给【取消】。
    //   理由：巡山人一局只有一次机会，他选中的那一刻 token 98 就打上了，点错取消没法重来。
    if (g_pickMode[p] == 18) {
        show = false;
    }
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(p), show);
    // 声称面板是独立入口行，不显示普通身份网格的四栏分类标题；正常选角时恢复。
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickSec[q], PlayerGroupSingle(p), (g_pickMode[p] != 3 && g_gridTeamN[q] > 0));
    }
    BOTC_PickCatCtrlRender(p);
    BOTC_PickAlignRender(p);
}

// 邪恶玩家（爪牙 / 恶魔）自己的【伪装身份】按钮：只有他们是邪恶、且身份已经发下去之后才显示。
//   按钮文字直接显示现在自称的身份（「伪装：镇长」），一眼就能看出自己有没有设过。
void BOTC_ClaimBtnRender () {
    int p;
    for (p = 2; p <= 13; p += 1) {
        DialogSetVisible(g_claimBtnDlg[p], PlayerGroupSingle(p), false);   // 【AI 已废弃】声称按钮原来只有智能说书才露（2026-10-16 清死代码）
        if (g_claim[BOTC_PosOf(p)] >= 0) {
            libNtve_gf_SetDialogItemText(g_claimBtnP[p], StringToText("伪装：" + g_roleName[g_claim[BOTC_PosOf(p)]]), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_claimBtnP[p], StringToText("伪装身份"), PlayerGroupSingle(p));
        }
    }
}

// 【诊断】把「玩家1 是不是电脑」是怎么判出来的写进私聊日志
//   同时写给 玩家1 和 玩家2：玩家1 是电脑时，读日志的是坐在玩家2 的那个人
void BOTC_P1LogMode () {
    string s;
    string ai;
    string verdict;
    if (g_p1RawAI) {
        ai = "是";
    }
    else {
        ai = "否";
    }
    if (g_p1IsComp) {
        verdict = "【诊断说书模式】判定：电脑说书 → 智能说书已启用";
    }
    else {
        verdict = "【诊断说书模式】判定：真人说书 → 手动说书";
    }
    s = "【诊断说书模式】PlayerType(1)=" + IntToString(g_p1RawType) + "（实测：电脑=2 / 真人=1）｜被AI接管=" + ai + "｜难度=" + IntToString(g_p1RawDiff) + "｜句柄=" + g_p1RawHandle;
    BOTC_DiagStore(g_teller, s);
    BOTC_DiagStore(2, s);
    BOTC_DiagStore(g_teller, verdict);
    BOTC_DiagStore(2, verdict);
}

// 【临时测试】把「你」那个座位弄成猎手（索引 10）：
//   场上本来有猎手就跟他整行对调（身份 + token），没有就跟一个镇民对调（不动配板）

// 同上，但指定座位（给「玩家2 自动声称猎手」那个测试用）

// 【测试猎手弹窗】把指定座位弄成「酒鬼猎手」：魔典上写着猎手、身上带「是酒鬼」token
//   ---- 他以为自己是猎手，声称之后走「猎手请求」弹窗（说书人那边会看到真身是酒鬼）。
//   优先跟场上原本的猎手对调，其次跟原本的酒鬼，都没有就跟一个镇民对调（配板人数不变）。

// 【测试猎手弹窗】把指定座位弄成「中毒的猎手」：真猎手 + 打「中毒」token（索引 7）
//   ---- 说书人弹窗里那行参考会写「他是真的【猎手】，但现在中毒」，让他自己决定怎么演。

// 【测试猎手弹窗】第 1 个白天：玩家2（座位 2）自动声称【猎手】、猎杀 玩家3（座位 3）
//   开关是聊天指令 slay（真猎手）/ slayd（酒鬼猎手）/ slayp（中毒的猎手），只在第 1 个白天跑一次。

// 玩家1（说书人位）是不是电脑控制？
//   查的是原生函数（都在 TriggerLibs/natives.galaxy 里，参见桌面那份原生函数清单）：
//     PlayerType(玩家)  → 玩家类型编号
//     PlayerHandle(玩家) → Battle.net 句柄。**别调它**：对「没有 gameUser 的电脑座位」会直接报错，
//       而且报错是在 BOTC_Init 里发生的 ---- 会把整条初始化打断（事件 / 计时器全不注册）。
//     PlayerDifficulty(玩家) → AI 难度，只写进诊断日志
//   【2026-09-16 实机实测】大厅里把玩家1 放成电脑时：PlayerType(1) = 2、句柄为空、难度 = 2。
//     注意 `PlayerIsUnderAIControl(1)` 在这种大厅电脑上返回的是**否**（那个函数只反映
//     「玩家被 AI 接管」这条开关，跟大厅里的电脑座位不是一回事），所以不能拿它当判据。
//   ⚠ 不要用玩家名去猜（PlayerGetName 那类函数在编辑器里根本不存在，会直接编译不过）。
//   三个来源，按优先级：
//     ① g_p1ForceManual：强制当人（聊天里输入「手动」，或玩家1 自己动手了）
//     ② g_p1ForceComputer：强制当电脑（聊天里输入「AI」，测试时懒得改大厅就用它）
//     ③ 真身判定（缓存一次）：
//          PlayerType = 1 → 真人（人类玩家的编号，待机房实测确认）
//          PlayerType = 2 → 电脑（实测值）
//          其它值 → 一律先当电脑（智能说书）；真人被误判时聊天里发「-手动」切回来
bool BOTC_P1IsComputer () {
    if (g_p1ForceManual) {
        return false;
    }
    if (g_p1ForceComputer) {
        return true;
    }
    if (!g_p1ChkDone) {
        g_p1ChkDone = true;
        g_p1RawType = PlayerType(1);
        g_p1RawAI = PlayerIsUnderAIControl(1);
        g_p1RawDiff = PlayerDifficulty(1);
        g_p1RawHandle = "";
        g_p1IsComp = false;
        if (g_p1RawType == 1) {
            g_p1IsComp = false;                    // 明确是真人
        }
        else {
            if (g_p1RawType == 2) {
                g_p1IsComp = true;                 // 实测：大厅里的电脑
            }
            else {
                // 类型既不是 1 也不是 2 的少见情况：**绝不调 PlayerHandle** ----
                //   PlayerHandle(1) 对「没有 gameUser 的电脑座位」会直接报错，而这一句是在
                //   BOTC_Init 里跑的，报错会把整条初始化打断（后面所有事件 / 计时器都不注册），
                //   表现就是「进游戏什么都不响应、AI 说书人像宕机」。
                //   改成：这种说不清的情况一律先当**电脑**（= 智能说书），除非它已经被别的 AI 接管标志否定。
                //   万一真人说书人被误判成电脑：聊天里发「-手动」就能切回来（见 BOTC_Chat_Func）。
                g_p1IsComp = true;
            }
        }
        BOTC_P1LogMode();
    }
    return g_p1IsComp;
}

// 设置说书模式：false = 手动说书，true = 智能说书
//   （模式不由按钮切换，而是开局自动判定 + 选板子环节推断，见 BOTC_P1IsComputer / BOTC_BoardPick）

// 开局定模式（判断方式见 BOTC_P1IsComputer 的说明）
void BOTC_InitMode () {
    int p;
    // 【玩家1 不在 → 顺位让"下一个进房间的人"当说书人】（用户 2026-10-07）：
    //   以前"第一个进房间的人走了"会直接掉进【智能说书】那条老路（第 2 个人顶不上来）。
    //   现在：只要场上还有真人，就由玩家号最小的那位（= 下一个进房间的）接手，模式走手动说书。
    //   （玩家1 是**真电脑**时不算这种情况 —— 那是你自己要的智能说书。）
    if (!(PlayerType(1) == 1 && PlayerStatus(1) != 2) && PlayerType(1) != 2) {
        p = BOTC_FirstPresentSeat();
        if (p >= 2) {
            g_teller = p;
            g_hideSeat = p;               // 他原来那个玩家号不进圈（用户 2026-10-07）
            g_who[1] = p;                 // "说书人格"上坐的人
            g_who[p] = p;                 // 玩家1 那一格本来就没人，保持原样
            BOTC_Notice(g_teller, "玩家1 不在场：按进房间顺序，本局由你当说书人。");
            BOTC_DiagStore(2, "【诊断说书模式】玩家1 不在场 → 顺位由座位 " + IntToString(p) + " 当说书人（手动说书）");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：手动说书（玩家1 不在，顺位接手）"));
            return;
        }
    }
    if (BOTC_P1IsComputer()) {
        BOTC_Notice(g_teller, "检测到玩家1 是电脑：本局由系统自动推进。");
        BOTC_DiagStore(2, "【诊断说书模式】检测到玩家1 是电脑：本局由系统自动推进。");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：智能说书"));
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：手动说书"));
    }
}

//==================================================================================================
// 夜晚唤醒机制
//==================================================================================================

// 行动类别的中文名（说书人的提示里用）
string BOTC_ActName (int act) {
    if (act == 1) {
        return "夜晚主动";
    }
    if (act == 2) {
        return "夜晚主动*";
    }
    if (act == 3) {
        return "公开触发";
    }
    if (act == 4) {
        return "触发式被动";
    }
    if (act == 5) {
        return "首夜被动";
    }
    if (act == 6) {
        return "条件性行动";
    }
    return "被动";
}

// 自动唤醒今晚能不能叫醒这个座位（说书人手动唤醒与「收回唤醒」不走这里）
//   被动（0）永远不能唤醒；带星号（2）第 2 夜起；公开触发（3）和触发式被动（4）放行但会提醒；
//   首夜被动（5）只有第 1 夜；游戏正式开始之前不限制，方便说书人自己演示。
//   中毒 / 酒鬼不影响唤醒：夜里照常把他叫起来，只是他的技能会失效、查到的东西是错的。
bool BOTC_CanWakeAt (int q) {
    int r;
    int act;
    if (q < 2 || q > 13) {
        return false;
    }
    // 驱魔人（25）点名的恶魔：当晚**不能因其自身能力被唤醒**（用户 2026-09-20）
    if (g_exoBlock >= 2 && q == g_exoBlock && g_nightNum == g_exoNight) {
        return false;
    }
    if (!g_started) {
        return true;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 148) {
        return false;
    }
    if (BOTC_NightLimitUsed(q, r)) {
        return false;
    }
    // 【女巫（65）】只剩 3 名存活后永久失去能力，不能继续被唤醒。
    if (r == 65 && BOTC_HasAbility(q, 65) && !BOTC_WitchCanAct(q)) {
        return false;
    }
    // 【借来的间谍(18) / 寡妇(75)：不能唤醒】（用户 2026-10-14，第二次收窄）----
    //   只有「借来的那一份」才算：炼金术士 123 / 哲学家 70 / 食人族 97 ----
    //   **真间谍 / 真寡妇 / 麻脸巫婆造出来的 / 说书人换上去的，一律照旧能唤醒**
    //   （上一版写成「真身不是 18/75 就拦」，把这些正常情况一起误伤了。）
    if (BOTC_BorrowedSpyWidow(q, r)) {
        return false;
    }
    // 【巡山人（77）】（用户 2026-10-04 报「每晚都能用」）：官方是一局**只有一次**猜测和选择的机会 ——
    //   用过一次就会在身上打「失去能力（巡山人）98」，之后再唤醒一律拦掉。
    if (r == 77 && BOTC_HasAbility(q, 77) && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) {
        return false;
    }
    // 【传教士（103）】（用户 2026-10-10）：被他选中的爪牙在他**存活且清醒**期间失去能力
    //   → 不能因自身能力被唤醒（标记 125 由 BOTC_SourceGoneCleanup 在他死亡 / 离场时统一收掉）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive()) {
        return false;
    }
    // 【鸩（124）】一局限一次：用过后不再唤醒。
    if (r == 124 && BOTC_HasAbility(q, 124) && g_tokOn[(((g_teller * 14) + q) * 256) + 145]) {
        return false;
    }
    if (r == 128 && BOTC_HasAbility(q, 128) && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) {
        return false;
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：宿主死于处决 + 主谋存活 → 痢蛭失去能力，之后不再唤醒他
    if (r == 100 && BOTC_HasAbility(q, 100) && g_tokOn[(((g_teller * 14) + q) * 256) + 18]) {
        return false;
    }
    // 僵怖（43）：今天有人死（任何类型的白天死亡）→ 今晚不唤醒他（用户 2026-09-20）
    //   ⚠ 判「有没有僵怖这个能力」：疯子（38）魔典上也写着僵怖，但他没有这个能力（真身 38），不受这条限制
    if (r == 43 && BOTC_HasAbility(q, 43) && BOTC_SomeoneDiedToday()) {
        return false;
    }
    act = g_roleAct[r];
    // 死了的人不再唤醒（例外：守鸦人这类触发式被动 act == 4 ---- 他就是「今晚死了」才被唤醒的，
    //   下面那一段会单独放行）
    if (act != 4) {
        if (BOTC_SeatDead(q)) {
            // 【亡骨魔（69）的「保留能力」】（用户 2026-09-21）：被他杀死的爪牙保留能力
            //   → 即使死了也照样被唤醒、照样行动（百科：只要亡骨魔还活着）
            if (BOTC_KeepsAbilityAlive(q)) {
                return true;
            }
            return false;
        }
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：平时不唤醒；国王身上带着「死亡（恶魔）」token 时才允许唤醒
    if (r == 108 && BOTC_HasAbility(q, 108)) {
        return BOTC_ChoirboyKingDead();
    }
    if (act == 1) {
        return true;
    }
    if (act == 2) {
        return (g_nightNum >= 2);
    }
    if (act == 4) {
        // 【帽匠（120）】（用户 2026-10-16）：死后的那一个夜晚（还没开过茶会）才轮到他这一步 ----
        //   死法不限（处决 / 白天被杀 / 夜里被恶魔杀）；他本人什么都不做，只是把恶魔 + 爪牙拉进群聊。
        if (BOTC_HasAbility(q, 120)) {
            if (!BOTC_SeatDead(q)) {
                return false;
            }
            return !g_hatDone[q];
        }
        // 【守鸦人×利维坦】相克触发时，不需要真的死亡也能在今晚醒来。
        if (BOTC_HasAbility(q, 8) && g_levJinxWake[q]) {
            return true;
        }
        if (BOTC_HasAbility(q, 8) && g_levJinxLost[q]) {
            return false;
        }
        // 【贤者（59）】（用户 2026-09-21）：只有「被恶魔杀死」的那一晚才醒（死于处决 / 其他死法不醒）
        if (BOTC_HasAbility(q, 59)) {
            if (g_levJinxLost[q]) {
                return false;
            }
            if (g_deadByDemon[q] != 1) {
                return false;
            }
            return (g_deadNightNum[q] == g_nightNum);
        }
        // 【理发师（62）】（用户 2026-09-21）：他死的那一晚要唤起恶魔交换角色（「今晚理发」标记亮着就算）
        if (BOTC_HasAbility(q, 62)) {
            return g_tokOn[(((g_teller * 14) + q) * 256) + 92];
        }
        // 【农夫（80）】（用户 2026-09-26）：他的能力是「死后换一名农夫」，本人不需要被唤醒
        //   （换成了农夫的那个人，也由说书人自己私聊告诉他，不进夜序）
        if (BOTC_HasAbility(q, 80)) {
            return false;
        }
        // 触发式被动（守鸦人这类）：只有他「这一夜」真的死了，才允许唤醒
        if (g_deadKind[q] != 1) {
            return false;
        }
        return (g_deadNightNum[q] == g_nightNum);
    }
    // act == 3 = 公开触发（猎手）：**夜里不能被唤醒**（用户 2026-09-19）。
    //   黯月初升的「侍女」会去查某个人当晚能不能被唤醒，所以说书人不能随便叫醒一个
    //   夜里本来没有行动的人 ---- 这里直接落到最后的 return false。
    if (act == 5) {
        return (g_nightNum <= g_seatFirstNight[q]);   // 【复活后首夜重算】（用户 2026-09-20）
    }
    // act == 6 = 条件性行动（教父 / 教授 / 刺客...）：能不能唤醒由说书人自己判断，这里一律放行
    if (act == 6) {
        return true;
    }
    return false;
}

// 不能唤醒时给说书人的理由
string BOTC_WakeBlockStr (int q) {
    int r;
    int act;
    if (g_exoBlock >= 2 && q == g_exoBlock && g_nightNum == g_exoNight) {
        return BOTC_NameStr(q) + " 今晚被驱魔人点名了，不能因其自身能力被唤醒（这是驱魔人的能力效果）。";
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 148) {
        return BOTC_NameStr(q) + " 还没定身份，先在说书人那份魔典上给他定个身份。";
    }
    // 【女巫（65）】只剩 3 名存活后永久失去能力
    if (r == 65 && BOTC_HasAbility(q, 65) && (g_witchLost || BOTC_AliveCountTrue() <= 3)) {
        return BOTC_NameStr(q) + "（女巫）只剩 3 名存活玩家，能力已经永久失效，不再唤醒她。";
    }
    // 【借来的间谍(18) / 寡妇(75)：不能唤醒】（用户 2026-10-14，第二次收窄）：只认借来的那一份
    if (BOTC_BorrowedSpyWidow(q, r)) {
        return BOTC_NameStr(q) + " 是**借来的**" + g_roleName[r] + "→ 这个能力不能把他叫醒；要看魔典 / 下毒你自己私下处理。";
    }
    // 【巡山人（77）】（用户 2026-10-04）：一局只有一次机会，用过了就不能再唤醒
    if (r == 77 && BOTC_HasAbility(q, 77) && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) {
        return BOTC_NameStr(q) + "（巡山人）这一局的机会已经用掉了（他带着「失去能力（巡山人）」标记），不用再唤醒他。";
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：失去了能力的痢蛭不用再唤醒
    if (r == 100 && BOTC_HasAbility(q, 100) && g_tokOn[(((g_teller * 14) + q) * 256) + 18]) {
        return BOTC_NameStr(q) + "（痢蛭）因为「宿主死于处决 · 主谋存活」已经失去能力，不用再唤醒他。";
    }
    // 僵怖（43）：今天有人死（任何类型的白天死亡）→ 今晚不唤醒他（用户 2026-09-20）
    if (r == 43 && BOTC_HasAbility(q, 43) && BOTC_SomeoneDiedToday()) {
        return "今天已经有人死了，僵怖（" + BOTC_NameStr(q) + "）今晚不会被唤醒。";
    }
    act = g_roleAct[r];
    if (act != 4) {
        if (BOTC_SeatDead(q)) {
            return BOTC_NameStr(q) + " 已经死了，今晚不唤醒他。";
        }
    }
    // 【传教士（103）】（用户 2026-10-10）：被布道的爪牙（传教士还活着且清醒）不能因自身能力被唤醒
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive()) {
        return BOTC_NameStr(q) + " 被传教士布道了：只要那名传教士存活且清醒，他就不能因自身能力被唤醒。";
    }
    if (r == 124 && BOTC_HasAbility(q, 124) && g_tokOn[(((g_teller * 14) + q) * 256) + 145]) {
        return BOTC_NameStr(q) + "（鸩）这一局的一次性能力已经用过了。";
    }
    if (r == 128 && BOTC_HasAbility(q, 128) && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) {
        return BOTC_NameStr(q) + "（守夜人）这一局的一次性能力已经用过了。";
    }
    if (BOTC_NightLimitUsed(q, r)) {
        return BOTC_NameStr(q) + " 这一局的限次能力已经用过了，今晚不再唤醒。";
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：平时不唤醒
    if (r == 108 && BOTC_HasAbility(q, 108)) {
        return BOTC_NameStr(q) + "（唱诗男孩）只有国王被恶魔杀死之后才会被唤醒。";
    }
    if (act == 0) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·被动）没有夜间行动，不能被唤醒。";
    }
    if (act == 2) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·夜晚主动*）带星号，第 2 夜起才能行动，首夜不能唤醒。";
    }
    if (act == 3) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·公开触发）没有夜间行动，不能被唤醒。";
    }
    if (act == 5) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·首夜被动）只有他的「首夜」（第 " + IntToString(g_seatFirstNight[q]) + " 夜）能唤醒，现在是第 " + IntToString(g_nightNum) + " 夜。";
    }
    if (act == 4) {
        if (r == 59) {
            return BOTC_NameStr(q) + "（贤者）只有「被恶魔杀死」的那一晚才会被唤醒（现在没记到他今晚被恶魔杀过）。";
        }
        if (r == 62) {
            return BOTC_NameStr(q) + "（理发师）只有他死的那一晚才要唤起恶魔交换角色（现在没有「今晚理发」标记）。";
        }
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·触发式被动）只有他「今晚」死了才会被唤醒（现在没记到他今晚死过）。";
    }
    return BOTC_NameStr(q) + "（" + g_roleName[r] + "·" + BOTC_ActName(act) + "）今晚不能唤醒。";
}

// 进唤醒模式时把「今晚该醒的角色」私聊写给说书人
// 这个身份今晚的行动顺序（0 = 今晚不醒；首夜和其他夜用不同的表）
// 【官方全角色夜序表】（用户 2026-09-23）：直接读表；表里没有（0）就是这一夜不唤醒
int BOTC_NoFirstOf (int r) {
    if (r < 0 || r > 148) {
        return 0;
    }
    return g_noAllFirst[r];
}

int BOTC_NoOtherOf (int r) {
    if (r < 0 || r > 148) {
        return 0;
    }
    return g_noAllOther[r];
}

int BOTC_NightOrder (int r) {
    if (r < 0 || r > 148) {
        return 0;
    }
    if (g_nightNum <= 1) {
        return g_noAllFirst[r];
    }
    return g_noAllOther[r];
}

// 这个座位**今晚**的夜间顺序：
//   如果今晚正好是他的「首夜」（g_seatFirstNight，复活之后会往后挪），就按首夜顺序算；
//   否则按平常的夜间顺序。首夜信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母...）平常只有第 1 夜有顺序，
//   复活之后这里会重新给出首夜顺序，于是又能被唤醒一次。
int BOTC_NightOrderOf (int q) {
    int r;
    if (q < 2 || q > 13) {
        return 0;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    // 【疯子（含「哲学疯子」/ 食人族吃到的疯子）】（用户 2026-10-14 报「哲学疯子会在恶魔之后行动」）----
    //   真疯子 / 哲学家借到疯子能力（token 49）/ 食人族吃到疯子，都算：一律按**疯子(38)**那一格的夜序走
    //   （疯子在恶魔**之前**行动，这样恶魔当晚就能知道他选的是谁）。
    //   原来只认「真身 == 38」，而哲学疯子的真身是 56 → 按他「以为自己是的那只恶魔」排，就排到恶魔后面去了。
    if (BOTC_IsLunatic(q)) {
        r = 38;
    }
    if (BOTC_SeatTrueRole(q) == 112 && g_tokOn[(((g_teller * 14) + q) * 256) + 134]) {
        r = 112;                                // 照看小怪宝的爪牙：按「小怪宝」那一格行动
    }
    if (r < 0 || r > 148) {
        return 0;
    }
    if (g_nightNum <= g_seatFirstNight[q] && BOTC_NoFirstOf(r) > 0) {
        return BOTC_NoFirstOf(r);
    }
    return BOTC_NightOrder(r);
}

// 发一段唤醒提示：第一段走 Notice（会弹一下字幕），后面的段只写私聊记录（免得字幕连着闪）
void BOTC_WakeHintSend (string s, int idx) {
    if (idx <= 0) {
        BOTC_Notice(g_teller, s);
    }
    else {
        BOTC_PmStore(g_teller, s);
    }
}

// 唤醒提示：太长会被私聊窗那行截掉，所以**自动换行**（用户 2026-09-19 要求）
//   · 一行大概放 32 个字，放不下就把当前这行发出去、另起一行（续行缩进两格）
//   · ⚠ 以前这里既 BOTC_PmStore 又 BOTC_Notice（而 Notice 内部又会存一次），同一行会记两遍
void BOTC_WakeListHint () {
    int i;
    int q;
    int r;
    int n;
    int o;
    int sent;
    string s;
    string item;
    BOTC_BuildSeatList();
    s = "【唤醒】" + BOTC_PeriodStr() + " 可以唤醒（按夜间顺序）：";
    n = 0;                         // 当前这一行已经放了几个
    sent = 0;                      // 已经发出去几行（0 = 第一行还没发）
    // 先按顺序表 1..9 排
    for (o = 1; o <= 127; o += 1) {       // 官方全角色夜序表最长 124 行，别只扫到 20
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            r = g_mark[(g_teller * 14) + q] - 1;
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_NightOrderOf(q) != o) {
                continue;
            }
            if (BOTC_WakeSkipNow(q)) {
                continue;
            }
            item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
            if (n > 0) {
                item = "、" + item;
            }
            if (n > 0 && StringLength(s) + StringLength(item) > 32) {
                BOTC_WakeHintSend(s, sent);
                sent = sent + 1;
                s = "  ";
                n = 0;
                item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
            }
            s = s + item;
            n = n + 1;
        }
    }
    // 手工赋予的能力也有自己的夜序；获得能力的当夜按该角色的首夜列排队。
    for (o = 1; o <= 127; o += 1) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (BOTC_GrantWakeOrder(q) != o) {
                continue;
            }
            item = IntToString(q - 1) + " " + g_roleName[g_grantRoleBy[q] - 1] + "（附加）";
            if (n > 0) {
                item = "、" + item;
            }
            if (n > 0 && StringLength(s) + StringLength(item) > 32) {
                BOTC_WakeHintSend(s, sent);
                sent = sent + 1;
                s = "  ";
                n = 0;
                item = IntToString(q - 1) + " " + g_roleName[g_grantRoleBy[q] - 1] + "（附加）";
            }
            s = s + item;
            n = n + 1;
        }
    }
    // 再把「不在顺序表里但今晚真的能醒」的补上（只有触发式被动，比如守鸦人今晚被刀了）
    //   ⚠ 公开触发的角色（猎手那种）夜里**不会被唤醒**，不能列进来误导说书人
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 148) {
            continue;
        }
        if (g_roleAct[r] == 3) {
            continue;                  // 公开触发：不在夜里唤醒
        }
        if (BOTC_NightOrder(r) > 0) {
            continue;
        }
        if (BOTC_WakeSkipNow(q)) {
            continue;
        }
        item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
        if (n > 0) {
            item = "、" + item;
        }
        if (n > 0 && StringLength(s) + StringLength(item) > 32) {
            BOTC_WakeHintSend(s, sent);
            sent = sent + 1;
            s = "  ";
            n = 0;
            item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
        }
        s = s + item;
        n = n + 1;
    }
    if (sent == 0 && n == 0) {
        s = s + "今晚没有该醒的角色";
    }
    BOTC_WakeHintSend(s, sent);
    // 僵怖（43）：今天有人死 → 今晚不唤醒他，单独说一句（免得说书人以为漏了）
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!BOTC_HasAbility(q, 43)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_SomeoneDiedToday()) {
            BOTC_WakeHintSend("【僵怖】" + IntToString(q - 1) + " " + BOTC_SeatRoleStr(q) + "：今天已经有人死了 → 今晚不唤醒他（他要「今天没人死」才能发动）。", 1);
        }
    }
    // 教父（39）：今天有没有外来者死亡（决定他今晚能不能动）
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_HasAbility(q, 39)) {
            if (BOTC_GodfatherCanKill()) {
                BOTC_WakeHintSend("【教父】" + IntToString(q - 1) + " 今晚**可以**动手（今天有外来者死亡）。", 1);
            }
            else {
                BOTC_WakeHintSend("【教父】" + IntToString(q - 1) + " 今晚**不能**动手（今天没有外来者死亡）。", 1);
            }
        }
    }
    // 驱魔人（25）点名的那一位：今晚不会被唤醒，单独提醒一行（只写私聊记录，不再弹字幕）
    if (g_exoBlock >= 2 && g_exoNight == g_nightNum) {
        BOTC_WakeHintSend("【驱魔人】" + IntToString(g_exoBlock - 1) + " " + BOTC_SeatRoleStr(g_exoBlock) + " 今晚被点名，不会因其自身能力被唤醒。", 1);
    }
}

//==================================================================================================
// 间谍（Spy）：技能 = 把说书人当前魔典（身份 + token）保存成只读快照给本人
//   看完后切回自己的魔典界面，但渲染内容继续使用这份当时的快照；不修改真实魔典数据
//==================================================================================================

void BOTC_SpyCopyTruth (int p) {
    int q;
    int t;
    int sp;
    int m;
    int d;
    if (p < 1 || p > 13) {
        return;
    }
    sp = g_who[p];
    for (q = 1; q <= 13; q += 1) {
        g_grimSnapMark[(sp * 14) + q] = g_mark[(g_teller * 14) + q];
        for (t = 0; t < 256; t += 1) {
            g_grimSnapTok[(((sp * 14) + q) * 256) + t] = g_tokOn[(((g_teller * 14) + q) * 256) + t];
        }
    }
    // 相克：间谍 / 寡妇查看魔典时，魔术师与恶魔的身份标记被拿掉。
    m = BOTC_MagicianSeatNow();
    if (m >= 2) {
        g_grimSnapMark[(sp * 14) + m] = 0;
        d = BOTC_FindDemon();
        if (d >= 2) {
            g_grimSnapMark[(sp * 14) + d] = 0;
        }
    }
    g_grimViewOn[sp] = false;
    g_grimView[sp] = 0;
    g_grimSnapOn[sp] = true;
}

// 【这一格是不是「借来的」间谍(18) / 寡妇(75)】（用户 2026-10-14）----
//   只有借能力那三枚才算：炼金术士 123 / 哲学家 70 / 食人族 97；
//   **真间谍 / 真寡妇 / 麻脸巫婆造出来的 / 说书人换身份换上去的，一律不算**（他们照旧能看魔典、照旧能被唤醒）。
//   ⚠ 上一版写成「真身不是 18 / 75 就算」，把上面这些正常情况一起拦了 ---- 这版收窄到只认那三枚 token。
bool BOTC_BorrowedSpyWidow (int q, int r) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (r != 18 && r != 75) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 123]) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97]) {
        return true;
    }
    return false;
}
void BOTC_SpyPeek (int p) {
    int sp;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_awake[p]) {
        BOTC_Notice(g_who[p], "只有被唤醒的时候才能看说书人的魔典。");
        return;
    }
    // 中毒 / 酒鬼的间谍：功能技能失效 ---- 说书人那份魔典打不开（不给看，也不改任何数据）
    //   本人只说「打不开」，不提中毒；真实原因只私聊告诉说书人
    if (!BOTC_SkillWorks(p)) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【夜间】间谍 " + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶，没给他开魔典。");
        return;
    }
    // 【借来的间谍不给他看真魔典】（用户 2026-10-14 报；第二次收窄）----
    //   只有炼金术士（123）/ 哲学家（70）/ 食人族（97）借来的这一份拦；**真间谍照旧能看**。
    if (BOTC_BorrowedSpyWidow(p, 18)) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        return;
    }
    if (g_spyP >= 2) {
        BOTC_SpyPeekEnd();      // 上一次没还原先还原，避免串数据
    }
    g_spyP = p;
    g_peekNoTok = p;        // （旧的"只看身份"标记；渲染层早就不认它了，留着兼容）
    sp = g_who[p];
    BOTC_SpyCopyTruth(p);
    BOTC_GrimRender(g_who[p]);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), true);
    BOTC_PmStore(g_teller, "【夜间】间谍 " + BOTC_NameStr(p) + " 看了说书人的魔典。");
}

// 结束正在看真魔典的状态：切回自己的魔典界面，但保留当时的只读快照
void BOTC_SpyPeekEnd () {
    int sp;
    if (g_spyP < 2) {
        return;
    }
    sp = g_who[g_spyP];
    g_spyP = 0;
    g_peekNoTok = 0;        // 还原：不再是「只看身份」模式（要在下面那次 GrimRender 之前清掉）
    g_grimViewOn[sp] = false;
    g_grimView[sp] = 0;
    BOTC_GrimRender(sp);
}

// 【-grim n】（用户 2026-10-07）：开发 / 测试用 —— 把自己的魔典切去"看 座位 n 自己那份"（n = 1..12）。
//   · 座位 n = 魔典上的**格子 n+1**（编号 [n]），那一格坐着的人由 g_who 查；
//   · 只改"渲染读哪一行"（g_grimView），**不动任何数据** —— 随时能切回，也不会污染别人的魔典；
//   · -grim 0（或者只发 -grim）＝ 看回自己那份。
void BOTC_GrimViewMsg (int p, string arg) {
    int sp;
    int n;
    if (p < 1 || p > 13) {
        return;
    }
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        n = StringToInt(arg);          // 【容错】-grim3（不加空格）也认
    }
    else {
        n = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    }
    if (n < 1 || n > 12) {
        g_grimViewOn[p] = false;
        g_grimView[p] = 0;
        libNtve_gf_SetDialogItemText(g_grimTitle, StringToText("魔典"), PlayerGroupSingle(p));
        BOTC_GrimRender(p);
        BOTC_PmInfo(p, "【-grim】已看回你自己那份魔典。用法：-grim 1 ~ -grim 12 = 看那个座位自己那份；-grim 0 = 看回自己。");
        return;
    }
    g_grimView[p] = g_who[n + 1];      // 座位 n = 格子 n+1 上坐着的人 → 看的就是他那份
    g_grimViewOn[p] = true;
    BOTC_PanelOpen(p, 2);              // 摊开自己的魔典（跟【发起私聊】同一套）
    // 【看得见】（用户 2026-10-07 报「-grim 貌似没用」）：标题写成"正在看谁"，免得以为没生效
    libNtve_gf_SetDialogItemText(g_grimTitle, StringToText("魔典 · 正在看 座位 " + IntToString(n) + "（" + BOTC_NameStr(n + 1) + "）自己那份"), PlayerGroupSingle(p));
    BOTC_GrimRender(p);
    if (!g_seatOn[n + 1]) {
        BOTC_PmInfo(p, "【-grim】注意：座位 " + IntToString(n) + " 现在没有真人（看到的会是空魔典）。");
    }
    BOTC_PmInfo(p, "【-grim】现在看的是 座位 " + IntToString(n) + "（" + BOTC_NameStr(n + 1) + "）自己那份魔典：只有他自己的身份、和他自己打过的标记。发 -grim 0 看回自己。");
}

//==================================================================================================
// 寡妇（75）【用户 2026-09-23】：首个夜晚看一眼说书人的魔典，然后点一个座位让那个人中毒。
//   魔典那套直接复用间谍的 BOTC_SpyPeek / BOTC_SpyPeekEnd（看的是说书人那份真魔典）；
//   区别是：她还在「看魔典」状态时点座位 = 下毒（见 BOTC_GrimClick 里那段）。
//   中毒：照官方口径**一直挂到她死亡 / 离场**才解除（不是投毒者那种黄昏到期）。
//   另外「会有一名善良玩家知道寡妇在场」这条按用户要求由说书人自己私聊通知，脚本不管。
//==================================================================================================
void BOTC_WidowPeek (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【寡妇（75）】（用户 2026-09-26）：按**魔典上写的身份**判断就行（哲学家 / 麻脸造出来的寡妇也能看；酒鬼假扮的会被下面的中毒/酒鬼检查挡住）
    if (g_mark[(g_teller * 14) + p] - 1 != 75) {
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【夜间】寡妇 " + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶，没给她开魔典，也没下毒。");
        return;
    }
    // 【借来的寡妇不给她看真魔典】（用户 2026-10-14 报；第二次收窄）----
    //   只有借来的那一份拦；**真寡妇照旧能看**；她下毒照旧 → 直接进标准选目标面板。
    if (BOTC_BorrowedSpyWidow(p, 75)) {
        g_widowP = p;
        BOTC_SkillOpen(p);
        return;
    }
    g_widowP = p;
    BOTC_SpyPeek(p);            // 把说书人那份魔典摊给她看
    if (g_spyP == p) {
        BOTC_PmInfo(g_who[p], "【寡妇】这是说书人的魔典（身份 + 所有 token 都能看）。看完之后点一个座位：那个人中毒（一直到他死）。");
        BOTC_PmStore(g_teller, "【夜间】寡妇 " + BOTC_NameStr(p) + " 正在看魔典：等她在魔典上点一个座位（= 下毒）。");
        BOTC_Notice(g_teller, "【寡妇】她在魔典上点一个座位当目标，然后按【确认】—— 那个人中毒。");
        BOTC_SkillOpen(p);      // 标准选目标面板（用户 2026-09-23）
    }
}

// 寡妇点座位：下毒（同一时刻只留一个毒：她只能行动一次，所以直接覆盖）
void BOTC_WidowPoison (int q) {
    int p;
    if (q < 2 || q > 13) {
        return;
    }
    p = g_spyP;
    if (p < 2) {
        p = g_widowP;                 // 【借来的寡妇】（用户 2026-10-14）：她没摊开魔典，座位记在 g_widowP
    }
    // 【寡妇自己没能力就不下毒】（用户 2026-10-13）：中毒 / 酒鬼 / 提线木偶 → 这一下不下毒
    if (p >= 2 && !BOTC_SkillWorks(p)) {
        BOTC_SpyPeekEnd();
        BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次没有下毒。");
        return;
    }
    BOTC_WidowPoisonClear("寡妇换了目标");
    g_widowP = p;
    g_widowPoison = q;
    // 【用户 2026-10-21】寡妇只写自己的「中毒（寡妇）」96，
    // 不再同时写投毒者的通用中毒 7；两份毒可以独立存在、独立解除。
    g_tokOn[(((g_teller * 14) + q) * 256) + 96] = true;
    BOTC_SpyPeekEnd();                            // 看完这一眼就把魔典收回去
    BOTC_GrimRender(g_teller);
    BOTC_SailorSync();                            // 中毒状态变了：水手那条免死跟着刷新
    BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(p) + " 让 " + BOTC_NameStr(q) + " 中毒（一直挂到寡妇死亡/离场）。");
    BOTC_PmStore(g_teller, "【寡妇】记得按规则私聊告诉一名善良玩家「寡妇在场」");
}

// 解除寡妇的毒（她死了 / 离场 / 换局）
void BOTC_WidowPoisonClear (string why) {
    if (g_widowPoison >= 2) {
        // 只撤寡妇自己的 96；如果目标同时被投毒者打上了 7，那一份保持独立。
        g_tokOn[(((g_teller * 14) + g_widowPoison) * 256) + 96] = false;
        BOTC_GrimRender(g_teller);
        BOTC_SailorSync();
        BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(g_widowPoison) + " 的中毒解除（" + why + "）。");
    }
    g_widowPoison = 0;
}
//==================================================================================================
// 【声称】（白天发动；目前只有猎手）
//   规则：所有人都能声称自己是猎手（谁都能声称），但只有「真的猎手 + 没中毒/酒鬼 + 能力没用掉」
//   才可能真的杀死恶魔；其它情况一律只播报「无事发生」。
//   猎手放空一次之后打「失去能力」token，之后无论怎么声称都只是无事发生。晚上不能声称。
//==================================================================================================
void BOTC_DeclareRender () {
    int p;
    DialogControlSetVisible(g_declareBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_dclaimBtn, PlayerGroupAll(), false);
    BOTC_WinAdminRender();

    if (!g_started || g_isNight) {
        return;
    }
    // 【p 是格子】（用户 2026-10-07 报「声称显示还是按物理玩家」）：这一圈按**格子**走（g_seatOn / BOTC_PublicDead），
    //   所以"发给谁"要用 g_who[p]、"谁在选目标"要用 g_declarePick[g_who[p]]（那两个都是客户端口径）。
    for (p = 1; p <= 13; p += 1) {
        // 【说书人也能用】（用户 2026-09-26）：p = 1 是「说书人」那一格，不在座位表里，所以跳过 g_seatOn 判定
        if (p >= 2 && !g_seatOn[p]) {
            continue;
        }
        if (BOTC_PublicDead(p)) {
            DialogControlSetVisible(g_dclaimBtn, PlayerGroupSingle(g_who[p]), true);
            if (g_declarePick[g_who[p]] || g_alcChoice[g_who[p]] || g_alcPick[g_who[p]]) {
                libNtve_gf_SetDialogItemText(g_dclaimBtn, StringToText("声称中：点头像"), PlayerGroupSingle(g_who[p]));
            }
            else {
                libNtve_gf_SetDialogItemText(g_dclaimBtn, StringToText("声称"), PlayerGroupSingle(g_who[p]));
            }
        }
        else {
            DialogControlSetVisible(g_declareBtn, PlayerGroupSingle(g_who[p]), true);
            if (g_declarePick[g_who[p]] || g_alcChoice[g_who[p]] || g_alcPick[g_who[p]]) {
                libNtve_gf_SetDialogItemText(g_declareBtn, StringToText("声称中：点头像"), PlayerGroupSingle(g_who[p]));
            }
            else {
                libNtve_gf_SetDialogItemText(g_declareBtn, StringToText("声称"), PlayerGroupSingle(g_who[p]));
            }
        }

    }
}

// 【死后声称】能选的角色（用户 2026-09-20）：现在只有月之子（36）；以后加新角色往这里加一个就行
bool BOTC_IsDeathClaimRole (int r) {
    return (r == 36 || r == 63);      // 月之子 / 呆瓜（用户 2026-09-21）
}

// 这个座位死后能不能声称这个身份：通用那份（月之子 / 呆瓜），外加
// 【带「保留能力（亡骨魔）」标记的精神病患者】（用户 2026-09-26）---- 他的能力被亡骨魔保住了，死后照样能声称
bool BOTC_CanDeathClaimRole (int r, int p) {
    if (BOTC_IsDeathClaimRole(r)) {
        return true;
    }
    if (r == 84 && p >= 1 && p <= 13 && g_tokOn[(((g_teller * 14) + p) * 256) + 79]) {
        return true;
    }
    return false;
}

// 打开「死后声称」面板：跟白天【声称】一样使用标题下方的固定入口行，只列死亡后可声称的身份。
void BOTC_DClaimOpen (int p) {
    int q;
    int k;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    g_pickMode[p] = 3;
    g_pickWho[p] = 0;
    BOTC_PickFilter(p, false);
    // 跟白天【声称】一致：不使用普通分类网格，只把死亡后可声称的身份排成一行。
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
    }
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    k = 0;
    s = "";
    if (BOTC_BoardHasRole(36) && BOTC_CanDeathClaimRole(36, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 57, 36, k, g_roleName[36]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[36];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(63) && BOTC_CanDeathClaimRole(63, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 58, 63, k, g_roleName[63]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[63];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(84) && BOTC_CanDeathClaimRole(84, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 59, 84, k, g_roleName[84]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[84];
        k = k + 1;
    }
    if (StringLength(s) <= 0) {
        s = "本局没有可以公开声称的角色";
    }
    else {
        s = "声称一个身份（" + s + "）";
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(s), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 点【死后声称】：白天 + 必须是死人（任何玩家都能点；真月之子才会真结算）
void BOTC_DClaimClick (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "声称是白天才能用的（晚上不能声称）。");
        return;
    }
    if (!BOTC_PublicDead(BOTC_PosOf(p))) {
        BOTC_Notice(p, "这是「死后声称」：你还没被公开宣布死亡（红叉），用旁边那个【声称】。");
        return;
    }
    if (g_declarePick[p]) {
        g_declarePick[p] = false;
        g_moonDeclare[p] = false;
        g_klutzDeclare[p] = false;
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    BOTC_DClaimOpen(p);
}

// 打开「声称一个身份」面板：复用身份面板，现在只留猎手
// 【声称面板 · 摆一格】（用户 2026-10-03）：把第 slot 格摆到第 k 位（0 起算，从左往右），
//   图标用 role 的夜间图、名字用 lbl（按阵营上色）。声称面板只显示这 7 格，所以统一排一行，
//   不会再出现「哥布林跑到落难那一栏 / 精神病跑到最左边」这种位置错乱。
void BOTC_DeclareSlot (int p, int slot, int role, int k, string lbl) {
    int x;
    int y;
    x = 55 + (k * 105);       // 最多 9 个固定入口也能完整放进面板
    y = 126;
    g_gridSlot[slot] = role;
    g_pickSlotRole[(p * 64) + slot] = role;
    DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
    libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(role), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(lbl), BOTC_RoleTeamColor(role)), PlayerGroupSingle(p));
    DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
}

void BOTC_DeclareOpen (int p) {
    int q;
    int k;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    g_pickMode[p] = 3;
    g_pickWho[p] = 0;
    BOTC_PickFilter(p, false);
    // 声称面板用的是网格末尾的固定槽，不是可翻页的四类网格。
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
    }
    // 【声称面板】（用户 2026-10-03）：先把整个网格藏掉（含上次用过的固定槽），只留可声称身份。
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    // 固定入口、**按角色号从左往右**排：
    //   猎手10 / 造谣者28 / 杂耍艺人58 / 猜落难82 / 精神病患者84 / 炼金术士95 / 哥布林99
    //   槽位用网格末尾那几个板子用不到的格（57..63），位置全由 BOTC_DeclareSlot 里的 k 统一算。
    k = 0;
    s = "";
    if (BOTC_BoardHasRole(10)) {
        BOTC_DeclareSlot(p, 57, 10, k, g_roleName[10]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[10];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(28)) {
        BOTC_DeclareSlot(p, 58, 28, k, g_roleName[28]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[28];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(58)) {
        BOTC_DeclareSlot(p, 59, 58, k, g_roleName[58]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[58];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(82)) {
        BOTC_DeclareSlot(p, 60, 82, k, "猜落难");
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + "猜落难";
        k = k + 1;
    }
    if (BOTC_BoardHasRole(84)) {
        BOTC_DeclareSlot(p, 61, 84, k, g_roleName[84]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[84];
        k = k + 1;
    }
    // 【炼金术士(95) × 间谍/寡妇】：板子同时提供炼金术士与间谍 / 寡妇时保留公开声称入口。
    if (BOTC_BoardHasRole(95) && (BOTC_BoardHasRole(18) || BOTC_BoardHasRole(75))) {
        BOTC_DeclareSlot(p, 62, 95, k, g_roleName[95]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[95];
        k = k + 1;
    }
    if (BOTC_BoardHasRole(99)) {
        BOTC_DeclareSlot(p, 63, 99, k, g_roleName[99]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[99];
        k = k + 1;
    }
    // 【异教领袖（106）】（用户 2026-10-10）：**任何人都可以声称**自己是异教领袖 → 开 20 秒全员投票
    if (BOTC_BoardHasRole(106)) {
        BOTC_DeclareSlot(p, 56, 106, k, g_roleName[106]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[106];
        k = k + 1;
    }
    // 维齐尔：本轮有人被提名后开放，整个提名阶段都可声称；每个玩家本轮只能点一次。
    if (BOTC_BoardHasRole(141) && g_phase >= 1 && g_phase <= 6 && g_vizierSeat >= 2 && !g_vizierClaimed[p]) {
        BOTC_DeclareSlot(p, 55, 141, k, g_roleName[141]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[141];
        k = k + 1;
    }
    if (StringLength(s) <= 0) {
        s = "本局没有可以公开声称的角色";
    }
    else {
        s = "声称一个身份（" + s + "）";
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(s), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 点【声称】按钮：白天才能用；已经在选目标时再点一次 = 取消
void BOTC_DeclareClick (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "声称是白天才能用的（晚上不能声称）。");
        return;
    }
    if (BOTC_PublicDead(BOTC_PosOf(p))) {
        BOTC_Notice(p, "你已经死了（红叉已经盖上），不能声称。（月之子是「死后选人」，用他自己的按钮）");
        return;
    }
    if (g_declarePick[p]) {
        g_declarePick[p] = false;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    if (g_alcChoice[p] || g_alcPick[p]) {
        g_alcChoice[p] = false;
        g_alcPick[p] = false;
        g_alcRolePick[p] = 0;
        DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    BOTC_DeclareOpen(p);
}

// 声称之后点头像：判决这次声称
void BOTC_DeclareSlay (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    // 月之子（36）专用按钮进入的「点头像」阶段：点头像 = 公开选一名存活玩家（不是猎杀）
    if (g_moonDeclare[g_who[p]]) {
        BOTC_MoonChildDeclare(p, q);
        return;
    }
    // 呆瓜（63）专用按钮进入的「点头像」阶段：点头像 = 公开选一名存活玩家（用户 2026-09-21）
    if (g_klutzDeclare[g_who[p]]) {
        BOTC_KlutzPick(p, q);
        return;
    }
    // 精神病患者（84）：点头像 = 公开选一名玩家（说书人拍板生死）
    if (g_psyDeclare[g_who[p]]) {
        BOTC_PsyPick(p, q);
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    if (!g_started || g_isNight) {
        return;
    }
    if (BOTC_SeatDead(p) || g_declareUsed[g_who[p]]) {
        g_declarePick[g_who[p]] = false;
        BOTC_DeclareRender();
        if (g_declareUsed[g_who[p]]) {
            BOTC_Notice(g_who[p], "你已经声称过【猎手】了：猎手一局只能声称一次。");
        }
        return;                        // 死了 / 已经声称过：这次点头像不算
    }
    g_declarePick[g_who[p]] = false;
    BOTC_DeclareRender();
    g_declareUsed[g_who[p]] = true;           // 猎手这次声称用掉（不管后面判成什么样，一局只有这一次）
    // 所有人都看得到：谁声称自己是猎手、要猎杀谁
    BOTC_PubAnnounce(BOTC_NameStr(p) + " 声称自己是【猎手】，并选择猎杀 " + BOTC_NameStr(q) + "。");
    // 【真人说书】**所有人声称都弹这个提示**（用户 2026-09-16 定稿：统一处理，方便恶魔伪装）----
    //   不管他是真猎手、中毒的猎手、以为自己是猎手的酒鬼，还是纯粹的假声称，看到的都是
    //   「等说书人拍板」这一套；真正的答案只写给说书人（弹窗上的按钮组合 + 他私聊日志里那行
    //   BOTC_SlayHintStr 文案 ---- 弹窗正文 2026-09-16 按要求精简成「标题 + 按钮」）。
    //   这样「当场就出无事发生」这条信息渠道就没了，谁都没法靠节奏猜自己失效、也没法靠节奏分辨自称真假。
    //   （点【是】= 走击杀那套过场，点【否】= 无事发生）
    BOTC_SlayAsk(p, q);
    return;
    // 以下都是【智能说书】的自动判定（电脑说书人一律当场判，不存在「被酒鬼看出破绽」的问题）
    // 不是真猎手（含酒鬼）：只是声称，无事发生
    if (BOTC_SeatTrueRole(p) != 10) {
        BOTC_PubAnnounce("无事发生。");
        return;
    }
    // 中毒 / 酒鬼：能力失效（本人不当场知道），这一次也算用掉了
    if (BOTC_SeatImpaired(p)) {
        BOTC_PubAnnounce("无事发生。");
        BOTC_LoseAbility(p, 12);
        return;
    }
    // 已经放过一次了
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 12]) {
        BOTC_PubAnnounce("无事发生。");
        return;
    }
    // 真的在射：目标是恶魔就死，其它人无事发生（能力都用掉）
    //   ⚠ 这里看的是**猎手眼里的登记**，不是真身：陌客有概率被登记成「恶魔」（`g_pairTeam == 3`），
    //     那时猎手打他也会真的打死他（陌客的能力就是「可能被看成恶魔」）。
    //     占卜师专用的那条「假干扰项」不算进来（那是占卜师的东西，猎手不吃）。
    if (BOTC_PairTeam(p, q) == 3) {
        // 「命中了恶魔」这句**不在这里播** ---- 要等枪声响起、恶魔真的死了再播（见 BOTC_SnipeFunc）
        BOTC_SlayKill(p, q);
        return;
    }
    BOTC_PubAnnounce("无事发生。");
    BOTC_LoseAbility(p, 12);
}

//--------------------------------------------------------------------------------------------------
// 【猎手请求】：猎手声称 + 点头像之后，由说书人决定「是否让他击杀」
//   智能说书（g_aiMode）不弹窗，直接按规则自动判（见上面 BOTC_DeclareSlay）；
//   真人说书时无论他点的是谁，都弹给说书人：点【是】= 执行击杀那套过场，点【否】= 播「无事发生」。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildSlayAsk () {
    // 【2026-09-16】去掉黑底、去掉正文与参考两行：只留标题（谁猎杀谁 + 是否击杀）和按钮
    // 【技能框往右挪 200】（用户 2026-09-23）：猎手「是否让他击杀」那个框
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_slayDlg = DialogLastCreated();
    DialogSetVisible(g_slayDlg, PlayerGroupAll(), false);
    g_slayTitle = BOTC_NewLabel(g_slayDlg, 666, 44, 18, 13, StringToText("猎手声称：是否让他击杀？"));
    libNtve_gf_SetDialogItemStyle(g_slayTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_slayTitle, false, PlayerGroupAll());
    g_slayYes = BOTC_NewButton(g_slayDlg, 306, 50, 27, 81, "是：让他击杀");
    g_slayNo = BOTC_NewButton(g_slayDlg, 306, 50, 351, 81, "否：无事发生");
    // 【静默的否】（用户 2026-09-26）：贞洁者 / 魔像这些「不是声称」的技能用它 ---- 点了公屏一个字都不播
    g_slayNo2 = BOTC_NewButton(g_slayDlg, 306, 50, 351, 81, "否：不发动");
    DialogControlSetVisible(g_slayNo2, PlayerGroupAll(), false);
    // 弹窗只有说书人（玩家1）看得到、点得到 ---- 其它玩家连按钮都没有
    DialogControlSetVisible(g_slayYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_slayNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), true);
}

// 把这个请求弹给说书人（真人说书专用；智能说书根本不会调到这里）
void BOTC_GolemAsk (int p, int q) {
    if (!g_started || g_isNight) {
        return;
    }
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    g_slayAskOn = true;
    g_slayAskGolem = true;
    g_slayAskP = p;
    g_slayAskQ = q;
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：只有真身是魔像、而且没中毒/酒鬼，才给【是】
    g_slayCanYes = (BOTC_AbilityWorks(p, 81));
    libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(p) + StringToText(" 提名 ") + BOTC_PlayerNameText(q) + StringToText("：是否让他死亡？（魔像）"), PlayerGroupSingle(g_teller));
    g_slaySilentNo = true;
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), true);
    if (g_slayCanYes) {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
        DialogControlSetPosition(g_slayNo2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
    }
    else {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetPosition(g_slayNo2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 189, 81);
        BOTC_PmStore(g_teller, "【魔像】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 按规则这一刀不生效（【是】已收起，只能点【否】）。");
    }
    DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【魔像】" + BOTC_NameStr(p) + " 提名了 " + BOTC_NameStr(q) + "：由你决定他死不死。");
}

void BOTC_GolemKill (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 2, 0, 81);
    g_deadShown[q] = true;
    g_deadPending[q] = false;
    if (!BOTC_DeathSfxMute(q)) {
        BOTC_PlaySfx("Marine_Death");
    }
    // 公屏只播「X 死亡」（不提魔像，用户 2026-09-26）
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(q) + StringToText(" 死亡"));
    BOTC_PmStore(g_teller, "【魔像】" + BOTC_NameStr(q) + " 因魔像的能力死亡。");
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_CheckWin();
}

//--------------------------------------------------------------------------------------------------
// 【84 精神病患者 / 82 落难少女】（用户 2026-09-26）
//--------------------------------------------------------------------------------------------------
void BOTC_PsyPick (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q] || !g_started || g_isNight) {
        return;
    }
    // 【带「保留能力（亡骨魔）」标记的精神病患者】（用户 2026-09-26）：死后仍然能声称（能力被亡骨魔保住了）
    if (BOTC_SeatDead(p) && !g_tokOn[(((g_teller * 14) + p) * 256) + 79]) {
        g_declarePick[g_who[p]] = false;
        g_psyDeclare[g_who[p]] = false;
        BOTC_DeclareRender();
        return;
    }
    // 【精神病患者的声称只能在提名阶段之前】（用户 2026-09-26）：提名环节开了就用不了
    if (g_phase != 0) {
        g_declarePick[g_who[p]] = false;
        g_psyDeclare[g_who[p]] = false;
        BOTC_DeclareRender();
        BOTC_Notice(g_who[p], "【精神病患者】的声称只能在提名阶段之前用：现在提名环节已经开始了。");
        return;
    }
    g_declarePick[g_who[p]] = false;
    g_psyDeclare[g_who[p]] = false;
    g_psyDone[p] = true;
    g_psyDay[p] = g_dayNum;
    BOTC_DeclareRender();
    BOTC_PubAnnounce(BOTC_NameStr(p) + " 声称自己是【精神病患者】，并公开选择 " + BOTC_NameStr(q) + "。");
    BOTC_PsyAsk(p, q);
    return;
    if (BOTC_AbilityWorks(p, 84)) {
        BOTC_PsyKill(q);
        return;
    }
    BOTC_PubAnnounce("无事发生。");
}

void BOTC_PsyAsk (int p, int q) {
    if (!g_started || g_isNight) {
        return;
    }
    g_slayAskOn = true;
    g_slayAskPsy = true;
    g_slayAskGolem = false;
    g_slaySilentNo = false;
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), true);
    g_slayAskP = p;
    g_slayAskQ = q;
    g_slayCanYes = true;      // 【用户 2026-10-03】始终给说书人「杀死 / 不杀死」两个选项（借到该能力的角色也算）
    libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(p) + StringToText(" 声称【精神病患者】要杀 ") + BOTC_PlayerNameText(q) + StringToText("：他死不死？"), PlayerGroupSingle(g_teller));
    if (g_slayCanYes) {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
        DialogControlSetPosition(g_slayNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
    }
    else {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetPosition(g_slayNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 189, 81);
    }
    DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【精神病患者】" + BOTC_NameStr(p) + " 声称要杀 " + BOTC_NameStr(q) + "，由你决定他死不死。");
}

void BOTC_PsyKill (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    // 公开白天、非恶魔击杀：完全复用普通死亡链。
    BOTC_DeathToggle(q, 2, 0);
}


int BOTC_DamselSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_HasAbility(i, 82)) {
            return i;
        }
    }
    return 0;
}

void BOTC_DamselClick (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_BoardHasRole(82)) {
        BOTC_Notice(p, "本局板子上没有落难少女，不能猜落难。");
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "猜落难只能白天用。");
        return;
    }
    if (g_damselDone[p]) {
        BOTC_Notice(p, "你已经公开猜过一次了。");
        return;
    }
    if (g_damselPick[p]) {
        g_damselPick[p] = false;
        BOTC_Notice(p, "已取消。");
        return;
    }
    g_damselPick[p] = true;
    BOTC_Notice(p, "点一个玩家头像：你公开猜测他是【落难少女】。想取消就在【声称】面板里再点一次「猜落难」。");
}

void BOTC_DamselGuess (int p, int q) {
    int ds;
    int ob;
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    g_damselPick[g_who[p]] = false;
    g_damselDone[g_who[p]] = true;
    BOTC_DeclareRender();
    BOTC_PubAnnounce("【落难少女】" + BOTC_NameStr(p) + " 公开猜测 " + BOTC_NameStr(q) + " 是落难少女。");
    if (g_damselFailed) {
        BOTC_PmStore(g_teller, "【落难少女】已经有爪牙猜错过 → 这一次猜测按规则无效。");
        return;
    }
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(p)) != 2 || BOTC_SeatImpaired(p)) {
        BOTC_PmStore(g_teller, "【落难少女】" + BOTC_NameStr(p) + " 不是清醒的爪牙 → 这只是声称，你自己裁定。");
        return;
    }
    if (BOTC_HasAbility(q, 82) && !BOTC_SeatDead(q)) {
        // 【中毒 / 醉酒适配】（用户 2026-09-26）：她中毒 / 酒鬼时能力失效 → 猜中也不判邪恶胜（这次猜测算用掉了）
        if (!BOTC_AbilityWorks(q, 82)) {
            BOTC_PmStore(g_teller, "【落难少女】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效：这次猜中不判邪恶胜。");
            return;
        }
        BOTC_ShowWin(1 - BOTC_SeatAlign(q), "镇民们没能保护好" + BOTC_NameStr(q) + "，", "真是可悲！");
        return;
    }
    g_damselFailed = true;
    ds = BOTC_DamselSeat();
    if (ds >= 2) {
        g_tokOn[(((g_teller * 14) + ds) * 256) + 102] = true;
    }
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PmStore(g_teller, "【落难少女】" + BOTC_NameStr(p) + " 猜错了（他猜 " + BOTC_NameStr(q) + "）：之后爪牙再猜也不能赢。");
}

void BOTC_DamselPoisonSync () {
    int i;
    // 【相克 · 落难少女 × 间谍/寡妇】（用户 2026-10-03）：间谍或寡妇在场（或在板子上）→ 落难少女中毒（通用中毒 token 7）
    if (BOTC_RoleInPlay(18) || BOTC_RoleOnBoard(18) || BOTC_RoleInPlay(75) || BOTC_RoleOnBoard(75)) {
        for (i = 2; i <= 13; i += 1) {
            if (g_seatOn[i] && BOTC_HasAbility(i, 82)) {
                if (!g_tokOn[(((g_teller * 14) + i) * 256) + 7]) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 7] = true;
                    BOTC_PmStore(g_teller, "【相克】间谍/寡妇在场 → " + BOTC_NameStr(i) + "（落难少女）中毒。");
                }
            }
        }
        BOTC_GrimRender(g_teller);
    }
}

void BOTC_DamselDealInfo () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && BOTC_HasAbility(i, 82)) {
            n = n + 1;
        }
    }
    if (n == 0) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2 && !BOTC_IsMarionette(i)) {
            BOTC_PmInfo(g_who[i], "【信息】你得知落难少女在场。");
        }
    }
    BOTC_DamselPoisonSync();
}

//--------------------------------------------------------------------------------------------------
// 【87 哈迪寂亚】（用户 2026-09-26）：三个目标按顺序各自选「活着 / 死亡」
//--------------------------------------------------------------------------------------------------
void BOTC_BuildHd (int p) {
    DialogCreate(414, 180, c_anchorRight, 320, -70, false);
    g_hdDlg[p] = DialogLastCreated();
    DialogSetVisible(g_hdDlg[p], PlayerGroupAll(), false);
    g_hdTitle[p] = BOTC_NewLabelC(g_hdDlg[p], 396, 30, 9, 7, StringToText("哈迪寂亚"));
    libNtve_gf_SetDialogItemStyle(g_hdTitle[p], "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_hdTitle[p], false, PlayerGroupAll());
    g_hdBtnLive[p] = BOTC_NewButton(g_hdDlg[p], 144, 54, 36, 63, "活着");
    g_hdBtnDie[p] = BOTC_NewButton(g_hdDlg[p], 144, 54, 225, 63, "死亡");
    DialogSetVisible(g_hdDlg[p], PlayerGroupSingle(p), false);
}

//--------------------------------------------------------------------------------------------------
// 【风雅集（板子 10）· 修行者（114）】说书人两选一面板（用户 2026-10-16）
//   唤醒他 → 弹出这个面板：顺时针 / 逆时针。
//   ⚠ 面板**不显示脚本算好的答案**（口径照 2026-10-03「正确答案不显示」）---- 说书人自己看魔典判。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildShugenja () {
    DialogCreate(560, 200, c_anchorRight, 320, -70, false);
    g_sgDlg = DialogLastCreated();
    g_sgTitle = BOTC_NewLabelC(g_sgDlg, 540, 52, 10, 8, StringToText("【修行者】距离最近的邪恶玩家在哪一侧？"));
    libNtve_gf_SetDialogItemStyle(g_sgTitle, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_sgTitle, false, PlayerGroupAll());
    g_sgB1 = BOTC_NewButton(g_sgDlg, 168, 54, 14, 78, "顺时针");
    g_sgB2 = BOTC_NewButton(g_sgDlg, 168, 54, 378, 78, "逆时针");
    DialogSetVisible(g_sgDlg, PlayerGroupSingle(g_teller), false);
}

void BOTC_SgOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    g_sgSeat = seat;
    libNtve_gf_SetDialogItemText(g_sgTitle, StringToText("【修行者】" + BOTC_NameStr(seat) + "：距离他最近的邪恶玩家在哪一侧？"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_sgB1, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_sgB2, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_sgDlg, PlayerGroupSingle(g_teller), true);
}

// v = 1 顺时针 / 2 逆时针
void BOTC_SgPick (int p, int v) {
    string dir;
    if (p != g_teller || g_sgSeat < 2 || g_sgSeat > 13) {
        return;
    }
    if (v != 1 && v != 2) {
        return;
    }
    dir = "顺时针";
    if (v == 2) {
        dir = "逆时针";
    }
    BOTC_PmInfo(g_who[g_sgSeat], "【信息】你得知" + dir + "。");
    BOTC_PmStore(g_teller, "【修行者】已告诉 " + BOTC_NameStr(g_sgSeat) + "：距离最近的邪恶玩家在他的" + dir + "方向。");
    BOTC_SgClose();
}

// 【修行者（114）】把这个面板收掉（点完方向 / 说书人取消唤醒 / 天亮自动收回技能）
void BOTC_SgClose () {
    DialogSetVisible(g_sgDlg, PlayerGroupSingle(g_teller), false);
    g_sgSeat = 0;
}

string BOTC_HdPickStr (int v) {
    if (v == 1) {
        return "活着";
    }
    if (v == 2) {
        return "死亡";
    }
    return "？";
}

void BOTC_HdHide () {
    int ob;
    for (ob = 1; ob <= 13; ob += 1) {
        DialogSetVisible(g_hdDlg[ob], PlayerGroupAll(), false);
        g_hdPick[ob] = 0;
        g_hdBySt[ob] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 108] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 109] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 110] = false;
    }
    BOTC_GrimRender(g_teller);
    g_hdActive = false;
    g_hdNow = -1;
    g_hdAutoSeat = 0;
}

void BOTC_HdStart (int p, int a, int b, int c) {
    if (p < 1 || p > 13) {
        return;
    }
    if (a < 2 || a > 13 || b < 2 || b > 13 || c < 2 || c > 13) {
        return;
    }
    BOTC_HdHide();
    g_hdTar[0] = a;
    g_hdTar[1] = b;
    g_hdTar[2] = c;
    // 【官方标记 1 / 2 / 3】（用户 2026-09-26）：按哈迪寂亚选人的顺序打在那三名玩家身上
    g_tokOn[(((g_teller * 14) + a) * 256) + 108] = true;
    g_tokOn[(((g_teller * 14) + b) * 256) + 109] = true;
    g_tokOn[(((g_teller * 14) + c) * 256) + 110] = true;
    BOTC_GrimRender(g_teller);
    g_hdActive = true;
    g_hdNow = 0;
    BOTC_PmStore(g_teller, "【哈迪寂亚】今晚按顺序选了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "、" + BOTC_NameStr(c) + "。");
    BOTC_HdStep();
}

void BOTC_HdStep () {
    int t;
    if (!g_hdActive) {
        return;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        BOTC_HdResolve();
        return;
    }
    t = g_hdTar[g_hdNow];
    if (t < 2 || t > 13) {
        g_hdNow = g_hdNow + 1;
        BOTC_HdStep();
        return;
    }
    libNtve_gf_SetDialogItemText(g_hdTitle[t], StringToText("哈迪寂亚：你选择活着还是死亡？"), PlayerGroupSingle(g_who[t]));
    DialogSetVisible(g_hdDlg[t], PlayerGroupSingle(g_who[t]), true);
    // 【氛围播报】（用户 2026-09-26）：轮到谁选，左下角公屏就播一句（名字会被换成真名）
    BOTC_PubAnnounce(BOTC_NameStr(t) + "，<c val=\"FF0000\">选择生，亦或是死。</c>");
    BOTC_Notice(g_who[t], "哈迪寂亚选择了你：点【活着】或【死亡】。");
    // 【电脑座位：脚本自动替他选生 / 死】（用户 2026-09-26）
    if (BOTC_SeatIsComputer(t)) {
        g_hdAutoSeat = t;
        TimerStart(g_tHdAuto, 2.0, false, c_timeGame);
    }
    else {
        g_hdAutoSeat = 0;
    }
}

void BOTC_HdPick (int p, int v) {
    int t;
    if (!g_hdActive) {
        return;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        return;
    }
    t = g_hdTar[g_hdNow];
    if (t < 2 || t > 13) {
        return;
    }
    if (p != g_who[t] && p != g_teller) {
        return;
    }
    g_hdPick[t] = v;
    g_hdBySt[t] = false;
    if (p == g_teller && p != g_who[t]) {
        g_hdBySt[t] = true;
    }
    // 【官方标记：死亡 / 复活】（用户 2026-09-26）：选完就把对应的标记打在目标身上
    if (v == 2) {
        g_tokOn[(((g_teller * 14) + t) * 256) + 112] = true;
        g_tokOn[(((g_teller * 14) + t) * 256) + 113] = false;
    }
    else {
        if (v == 1) {
            g_tokOn[(((g_teller * 14) + t) * 256) + 112] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 113] = true;
        }
    }
    BOTC_GrimRender(g_teller);
    DialogSetVisible(g_hdDlg[t], PlayerGroupAll(), false);
    // 【哈迪寂亚：切目标前把别的目标那份小窗收掉】（用户 2026-10-03）
//   ⚠ 必须判座位号有效：活人不够时 g_hdTar[1]/[2] 会是 0，直接拿去当对话框 ID 会让整个函数中断（生死都不判了）
if (g_hdTar[0] >= 2 && g_hdTar[0] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[0]], PlayerGroupAll(), false);
}
if (g_hdTar[1] >= 2 && g_hdTar[1] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[1]], PlayerGroupAll(), false);
}
if (g_hdTar[2] >= 2 && g_hdTar[2] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[2]], PlayerGroupAll(), false);
}if (g_hdBySt[t]) {
        BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 由你说书人代选：" + BOTC_HdPickStr(v) + "。");
    }
    else {
        BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 选了" + BOTC_HdPickStr(v) + "。");
    }
    g_hdNow = g_hdNow + 1;
    BOTC_HdStep();
}

// 电脑座位到点自动替它选一个（活着 / 死亡各 50%）；人选过了就不再补
bool BOTC_HdAutoFunc (bool testConds, bool runActions) {
    int t;
    int v;
    if (!g_hdActive) {
        return true;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        return true;
    }
    t = g_hdTar[g_hdNow];
    if (t != g_hdAutoSeat || t < 2 || t > 13) {
        return true;
    }
    if (g_hdPick[t] != 0) {
        return true;
    }
    if (RandomInt(1, 2) == 1) {
        v = 1;
    }
    else {
        v = 2;
    }
    BOTC_PmStore(g_teller, "【电脑】" + BOTC_NameStr(t) + " 是电脑：脚本自动替他选了「" + BOTC_HdPickStr(v) + "」。");
    BOTC_HdPick(t, v);
    return true;
}

void BOTC_HdResolve () {
    int i;
    int t;
    int nLive;
    if (!g_hdActive) {
        return;
    }
    if (!g_isNight) {
        BOTC_HdHide();
        return;
    }
    // 【1 / 2 / 3 三个数字标记：选完就撤】（用户 2026-09-26）
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t >= 2 && t <= 13) {
            g_tokOn[(((g_teller * 14) + t) * 256) + 108] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 109] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 110] = false;
        }
    }
    // 三个人都选「活着」→ 三个人全算「死亡」（先把「复活」撤掉，再统一打「死亡」）
    nLive = 0;
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t >= 2 && t <= 13 && g_tokOn[(((g_teller * 14) + t) * 256) + 113]) {
            nLive = nLive + 1;
        }
    }
    if (nLive >= 3) {
        for (i = 0; i < 3; i += 1) {
            t = g_hdTar[i];
            if (t >= 2 && t <= 13) {
                g_tokOn[(((g_teller * 14) + t) * 256) + 113] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 112] = true;
            }
        }
        BOTC_PmStore(g_teller, "【哈迪寂亚】三个人都选了「活着」→ 三个人全部死亡。");
    }
    // 按标记落生死：「死亡（哈迪寂亚）」→ 死；「复活（哈迪寂亚）」→ 存活（原本已死的复活）
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t < 2 || t > 13) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + t) * 256) + 112]) {
            BOTC_HdKill(t);
        }
        else {
            if (g_tokOn[(((g_teller * 14) + t) * 256) + 113]) {
                if (BOTC_PublicDead(t)) {
                    BOTC_DeathToggle(t, 0, 0);
                }
                else {
                    BOTC_ClearDeath(t);
                    BOTC_RestoreOneShot(t);
                }
            }
        }
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【哈迪寂亚】结算完成：带「死亡（哈迪寂亚）」的死亡，带「复活（哈迪寂亚）」的存活（原本已死的复活）。");
    BOTC_HdHide();
}

void BOTC_HdKill (int t) {
    if (t < 2 || t > 13) {
        return;
    }
    // 此时「死亡（哈迪寂亚）」刚点亮，SeatDead 已为真，不能因此跳过真正的死亡记录。
    if (BOTC_PublicDead(t)) {
        return;
    }
    BOTC_MarkDeathQuietSrc(t, 1, 1, 87);
    BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 因哈迪寂亚死亡（天亮统一公布）。");
}

void BOTC_SlayAsk (int p, int q) {
    if (!g_started || g_isNight) {
        return;
    }
    g_slayAskOn = true;
    g_slaySilentNo = false;
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), true);
    g_slayAskP = p;
    g_slayAskQ = q;
    // 标题带上「谁猎杀谁」（替掉原来那两行说明；正文与参考行 2026-09-16 按要求删掉）
    libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(p) + StringToText(" 猎杀 ") + BOTC_PlayerNameText(q) + StringToText("：是否让他击杀？"), PlayerGroupSingle(g_teller));
    // 【检测真身】只有「清醒的真猎手」才给【是】按钮；其余一律只留【否】（挪到正中间）
    g_slayCanYes = BOTC_SlayCanKill(p);
    if (g_slayCanYes) {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
        DialogControlSetPosition(g_slayNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
    }
    else {
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetPosition(g_slayNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 189, 81);
    }
    DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
    // 发起人那边给个提示：让他知道球在说书人手里
    BOTC_Notice(g_who[p], "已把猎杀请求发给说书人：" + BOTC_NameStr(q) + "。等他说书人决定。");
    // 弹窗上不再写那行参考（用户要求只留标题 + 按钮），真身 / 状态改写成说书人的私聊日志 ----
    //   想核对就翻「我的私聊」那一页；以后想把参考行放回弹窗，把这句的文案再 SetDialogItemText 一次即可
    BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "。" + BOTC_SlayHintStr(p));
}

// 说书人的回答：ans = 1 → 执行击杀；ans = 0 → 无事发生
void BOTC_SlayAnswer (int ans) {
    int p;
    int q;
    if (!g_slayAskOn) {
        return;
    }
    p = g_slayAskP;
    q = g_slayAskQ;
    // 【检测真身】不是清醒的真猎手 → 这一枪按规则不生效：说书人只能点【否】
    //   （按钮本来就藏了，这里再兜一层，免得误点）
    //   ⚠ Galaxy 的 && 只吃 bool，ans 是 int，必须写成 ans != 0
    if (ans != 0 && !g_slayCanYes) {
        if (g_slayAskPsy) {
            BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【精神病患者】。");
        }
        else {
            if (g_slayAskGolem) {
                BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【魔像】。");
            }
            else {
                BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【猎手】（真身 / 状态见弹窗那一行参考）。");
            }
        }
        return;
    }
    if (g_slayAskGolem) {
        if (ans != 0 && g_started && !g_isNight && q >= 2 && q <= 13 && !BOTC_SeatDead(q)) {
            BOTC_GolemKill(q);
        }
        else {
            if (!g_slaySilentNo) {
                BOTC_PubAnnounce("无事发生。");
            }
        }
        BOTC_SlayAskHide();
        return;
    }
    if (g_slayAskPsy) {
        if (ans != 0 && g_started && !g_isNight && q >= 2 && q <= 13 && !BOTC_SeatDead(q)) {
            BOTC_PsyKill(q);
        }
        else {
            BOTC_PubAnnounce("无事发生。");
        }
        BOTC_SlayAskHide();
        return;
    }

    if (g_slayAskVirgin) {
        if (ans != 0) {
            BOTC_VirginKill(p, q);
        }
        else {
            BOTC_PmStore(g_teller, "【贞洁者】你点了【否】：这次不处决提名者，提名流程照常进行。");
            if (!g_slaySilentNo) {
                BOTC_PubAnnounce("无事发生。");
            }
        }
        BOTC_SlayAskHide();
        // 处决没把提名环节收掉（说书人点了【否】/ 今天已经处决过）→ 这次提名照常往下走
        if (g_phase == 2) {
            TimerStart(g_tSpeech, 60.0, false, c_timeGame);
            BOTC_PhaseSet(3);
        }
        return;
    }
    BOTC_SlayAskHide();
    if (ans == 0) {
        BOTC_PubAnnounce("无事发生。");
        return;
    }
    // 拍板之后局势可能已经变了（比如他又死了 / 入夜了）：那就当无事发生
    if (!g_started || g_isNight || p < 1 || p > 13 || q < 2 || q > 13 || BOTC_SeatDead(q)) {
        BOTC_PubAnnounce("无事发生。");
        return;
    }
    BOTC_SlayKill(p, q);
}

void BOTC_SlayAskHide () {
    g_slayAskOn = false;
    g_slayAskP = 0;
    g_slayAskQ = 0;
    g_slayCanYes = false;
    g_slayAskGolem = false;
    g_slayAskPsy = false;
    g_slayAskVirgin = false;
    g_slaySilentNo = false;
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_slayYes, StringToText("是：让他击杀"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_slayNo, StringToText("否：无事发生"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_slayDlg, PlayerGroupAll(), false);
}

// 【检测真身】这个人现在到底能不能杀：只有「真猎手 + 没中毒 / 没酒鬼 + 能力没用掉」才为真。
//   说书人的弹窗里，只有这种人才给【是】按钮，其余一律只能点【否】。
bool BOTC_SlayCanKill (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (!BOTC_AbilityWorks(p, 10)) {
        return false;                  // 没有猎手能力，或科学怪人来源失效
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 12]) {
        return false;                  // 已经失去能力
    }
    return true;
}

// 【只给说书人看的参考】他到底是不是真猎手、现在能不能杀（玩家看不到这一段）
//   能杀 → 两个按钮都能点；不能杀 → 弹窗里只有【否】能点（文案里写清楚）
string BOTC_SlayHintStr (int p) {
    if (p < 1 || p > 13) {
        return "供参考：这个人不在场。";
    }
    if (BOTC_SlayCanKill(p)) {
        return "供参考：他是真的【猎手】，能力还在 ---- 两个按钮都能点（按规则只有打到恶魔才会死）。";
    }
    // 以下都是「按规则这一枪不生效」的人 ---- 弹窗里只有【否】能点
    if (BOTC_SeatTrueRole(p) == 14) {
        return "供参考：他以为自己是【猎手】，其实是酒鬼 ---- 这一枪不算（只有【否】能点）。";
    }
    if (BOTC_SeatTrueRole(p) != 10) {
        return "供参考：他并不是真的【猎手】（真身：" + g_roleName[BOTC_SeatTrueRole(p)] + "）---- 这一枪不算（只有【否】能点）。";
    }
    if (BOTC_SeatIsPoisoned(p)) {
        return "供参考：他是真的【猎手】，但现在中毒 ---- 这一枪不算（只有【否】能点）。";
    }
    return "供参考：他是真的【猎手】，但已经失去能力 ---- 这一枪不算（只有【否】能点）。";
}

// 【执行击杀】真正的击杀代码（智能说书判定命中、或真人说书点【是】时都走这里）：
//   停掉所有音轨 → 2 秒后充能音 → 再 2.5 秒后枪声 → 枪声那一刻才结算死亡（白天死亡 token + 红叉，
//   恶魔死了之后的传位 / 红唇女郎 / 胜负判定跟着走）→ 再 2 秒恢复音轨
//   「停音轨」用自己做的静音音轨 moren 顶住（不然星际自带的种族音乐会冒出来）
void BOTC_SlayKill (int p, int q) {
    BOTC_LoseAbility(p, 12);
    BOTC_MusicStop();
    BOTC_MusicPlay(g_musicSilentName, 8, 0.5);
    g_snipeTarget = q;
    g_snipeHunter = p;
    g_snipeStage = 1;
    TimerStart(g_tSnipe, 2.0, false, c_timeGame);
}

// 失去能力：猎手用 12 号槽、贞洁者用 17 号槽（都打在说书人那份魔典上）
void BOTC_LoseAbility (int q, int slot) {
    if (q < 2 || q > 13) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + slot] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【失去能力】" + BOTC_NameStr(q) + " 失去了能力。");
}

//==================================================================================================
// 贞洁者（索引 9）：第一次被提名时反应
//   提名者算镇民（按登记，间谍/陌客被看成镇民也算）→ 弹面板让说书人决定处不处决提名者（用户 2026-09-26 改）；
//   说书人选【是】才处决：占掉今天的处决名额、死亡类型＝处决，然后收掉提名环节；选【否】就照常走发言 / 投票。
//   提名者不算镇民，或贞洁者自己中毒/酒鬼 → 无事发生（不公开播报，免得暴露贞洁者），贞洁者失去能力。
//==================================================================================================
bool BOTC_VirginCheck (int nomFrom, int nomTo) {
    if (nomFrom < 2 || nomFrom > 13 || nomTo < 2 || nomTo > 13) {
        return false;
    }
    if (!BOTC_HasAbility(nomTo, 9)) {
        return false;                       // 没有贞洁者能力
    }
    if (g_tokOn[(((g_teller * 14) + nomTo) * 256) + 17]) {
        return false;                       // 已经触发过 / 已经失去能力
    }
    // 中毒 / 酒鬼 / 科学怪人来源失效：能力失效（本人不当场知道），这一次也算用掉
    if (!BOTC_AbilityWorks(nomTo, 9)) {
        BOTC_LoseAbility(nomTo, 17);
        BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 中毒/酒鬼，这次触发无效。");
        return false;
    }
    if (BOTC_SeatRegTeam(nomFrom) == 0) {
        // 【改成说书人拍板】（用户 2026-09-26）：提名者是镇民 → 不自动处决，弹面板让说书人决定
        BOTC_LoseAbility(nomTo, 17);
        if (!g_started) {
            BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 被 " + BOTC_NameStr(nomFrom) + " 提名，但游戏还没正式开始 → 这次不处理。");
            return true;
        }
        BOTC_VirginAsk(nomFrom, nomTo);
        return true;
    }
    // 提名者不算镇民：无事发生（不公开播报），贞洁者失去能力
    BOTC_LoseAbility(nomTo, 17);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 被 " + BOTC_NameStr(nomFrom) + " 提名，但提名者不算镇民：无事发生。");
    return false;
}

// 开贞洁者的拍板面板（真人说书专用）
void BOTC_VirginAsk (int nomFrom, int nomTo) {
    if (!g_started) {
        return;
    }
    if (nomFrom < 2 || nomFrom > 13 || nomTo < 2 || nomTo > 13) {
        return;
    }
    g_slayAskOn = true;
    g_slayAskVirgin = true;
    g_slayAskGolem = false;
    g_slayAskPsy = false;
    g_slayAskP = nomFrom;
    g_slayAskQ = nomTo;
    g_slayCanYes = true;
    libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(nomTo) + StringToText("（贞洁者）被 ") + BOTC_PlayerNameText(nomFrom) + StringToText(" 提名：是否处决他？"), PlayerGroupSingle(g_teller));
    g_slaySilentNo = true;
    DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), true);
    DialogControlSetPosition(g_slayNo2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
    libNtve_gf_SetDialogItemText(g_slayYes, StringToText("是：处决提名者"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 第一次被提名，提名者 " + BOTC_NameStr(nomFrom) + " 是镇民。");
}

// 处决提名者（占掉今天的处决名额），并收掉提名环节
void BOTC_VirginKill (int nomFrom, int nomTo) {
    if (nomFrom < 2 || nomFrom > 13) {
        return;
    }
    // 走普通处决那一套：公屏只播「【处决】X 被处决」，免死（弄臣 / 水手 / 魔鬼代言人…）也照样生效
    BOTC_ExecToggleAt(nomFrom);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 的能力触发：提名者 " + BOTC_NameStr(nomFrom) + " 按普通处决结算。");
}

//==================================================================================================
// 【黯月初升 · 角色实现】（用户 2026-09-19 起：按索引顺序一个个做）
//   22 祖母 / 23 水手 / 24 侍女
//==================================================================================================

// ■ 祖母（22）：首夜被动。
//   【方案 B（用户 2026-09-20 定）】真孙子 = 说书人秘密指定的那一位，用 **token 30「孙子」** 标在他身上：
//     · 判定「孙子被恶魔杀 → 祖母一起死」**只看 token 30**；说书人把 token 挪到谁身上，谁就是真孙子。
//     · 祖母中毒 / 酒鬼时，她**被告知的是错的孙子**（智能说书随便报另一个善良玩家 + 他的真角色），
//       真孙子不变 ---- 所以「我被告知的孙子活得好好的，我却死了」是正常的。
//     · 首夜定下来后不再重挑（要换人就自己挪 token 30）。
//     · 她自己中毒 / 酒鬼时，孙子被恶魔杀**不会**带走她（能力当时是关着的），只写日志。

// 带着「孙子」token（30）的座位 = 真孙子；没有就返回 0
int BOTC_NanaKidSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 30]) {
            return i;
        }
    }
    return 0;
}

// 场上的祖母坐在哪（按真身找，死活都算）；没有就返回 0
int BOTC_NanaSeatNow () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_HasAbility(i, 22)) {
            return i;
        }
    }
    return 0;
}
void BOTC_NanaPick (int q) {
    int i;
    int r;
    int n;
    int want;
    int pick;
    int told;
    int rTold;
    bool fake;
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 22)) {
        return;
    }
    g_nanaSeat = q;
    if (BOTC_NanaKidSeat() >= 2 && g_nightNum != g_seatFirstNight[q]) {
        return;                                  // 真孙子（token 30）已经定了、而且今晚不是他的「首夜」→ 不重挑
    }
    // ① 先把真孙子定下来：在场 + 活着 + 善良的人里随机挑一个
    pick = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == q) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_RegRoleOf(i);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_SeatRegAlign(i) != 0) {
            continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
        }
        n = n + 1;
    }
    if (n <= 0) {
        BOTC_PmStore(g_teller, "【祖母】场上没有符合条件的善良玩家，这一次没有指定孙子。");
        return;
    }
    want = RandomInt(1, n);
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == q) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_RegRoleOf(i);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_SeatRegAlign(i) != 0) {
            continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
        }
        n = n + 1;
        if (n == want) {
            pick = i;
        }
    }
    if (pick < 2) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 30] = false;   // 旧的「孙子」token 先全清掉
    }
    g_tokOn[(((g_teller * 14) + pick) * 256) + 30] = true;     // 真孙子带 token 30
    g_nanaKid = pick;
    BOTC_GrimRender(g_teller);
    // ② 再决定告诉她什么：她自己中毒 / 酒鬼 → 报一个**错的孙子**（另一个善良玩家，角色照他的真身报）
    told = pick;
    rTold = BOTC_RegRoleOf(pick);       // 报给她的角色按「互动干扰」那一层（间谍可能被看成镇民）
    fake = false;
    if (BOTC_SeatImpaired(q)) {
        told = 0;
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (i == q || i == pick) {
                continue;
            }
            if (BOTC_SeatDead(i)) {
                continue;
            }
            r = BOTC_RegRoleOf(i);
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_SeatRegAlign(i) != 0) {
                continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
            }
            n = n + 1;
        }
        if (n > 0) {
            want = RandomInt(1, n);
            n = 0;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) {
                    continue;
                }
                if (i == q || i == pick) {
                    continue;
                }
                if (BOTC_SeatDead(i)) {
                    continue;
                }
                r = BOTC_RegRoleOf(i);
                if (r < 0 || r > 148) {
                    continue;
                }
                if (BOTC_SeatRegAlign(i) != 0) {
                    continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
                }
                n = n + 1;
                if (n == want) {
                    told = i;
                }
            }
            rTold = BOTC_RegRoleOf(told);
            fake = true;
        }
        else {
            rTold = BOTC_WrongRole(rTold);       // 场上没有别的善良玩家可报：玩家照报，角色名报错的
            fake = true;
        }
        // 【认知覆盖 / 疯子不在场身份】用户 2026-09-20：一半概率改用这两类身份当那条假身份 ----
        //   例：得知「疯子是某个他以为不在场的身份」，或「酒鬼（以为自己是共情者）是共情者」。
        if (RandomInt(1, 2) == 1) {
            g_hintN = 0;
            BOTC_PushLunaticBluffs(0);
            BOTC_PushCogSeenRoles(0);
            BOTC_PushLunaticBluffs(1);
            BOTC_PushCogSeenRoles(1);
            if (g_hintN > 0) {
                rTold = g_fakePool[RandomInt(0, g_hintN - 1)];
                BOTC_PmStore(g_teller, "【祖母】她中毒/酒鬼 → 这条假身份取自「疯子的不在场身份 / 认知覆盖角色以为的身份」：" + g_roleName[rTold] + "。");
            }
        }
    }
    // ③ 说书人日志：真话写在前面，要报的话写在后面
    BOTC_PmStore(g_teller, "【祖母】真孙子 = " + BOTC_NameStr(pick) + "（" + BOTC_RoleNameSafe(BOTC_RegRoleOf(pick)) + "）。他要是被恶魔杀死，祖母会跟着一起死。");
    if (fake) {
        BOTC_PmStore(g_teller, "【祖母】她当时中毒/酒鬼 → 按规则要给她错的：告诉她「" + BOTC_NameStr(told) + " 是一名善良玩家，他的角色是 " + BOTC_RoleNameSafe(rTold) + "」。");
    }
    else {
        BOTC_PmStore(g_teller, "【祖母】告诉她：「" + BOTC_NameStr(told) + " 是一名善良玩家，他的角色是 " + BOTC_RoleNameSafe(rTold) + "」。");
    }
    BOTC_PmStore(g_teller, "【祖母】不满意可以自己把「孙子」token 挪给别人，再按你的说法告诉她。");
}

// 孙子被恶魔杀死 → 祖母一起死。由「恶魔杀人」的入口调用（现在是小恶魔那一刀）。
void BOTC_NanaLinkCheck (int victim) {
    int kid;
    int gm;
    kid = BOTC_NanaKidSeat();                    // 真孙子 = 带着「孙子」token 的那位
    gm = BOTC_NanaSeatNow();
    if (kid < 2 || gm < 2) {
        return;
    }
    if (victim != kid) {
        return;
    }
    if (gm == kid) {
        return;
    }
    if (BOTC_SeatDead(gm)) {
        return;
    }
    if (BOTC_SeatImpaired(gm)) {
        BOTC_PmStore(g_teller, "【祖母】孙子 " + BOTC_NameStr(victim) + " 被恶魔杀死，但祖母 " + BOTC_NameStr(gm) + " 此刻中毒/酒鬼 → 联动没有生效。");
        return;
    }
    BOTC_MarkDeathQuietSrc(gm, 1, 0, 22);      // 祖母：孙子被恶魔杀 → 打「死亡（祖母·孙子）」
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【祖母】孙子 " + BOTC_NameStr(victim) + " 被恶魔杀死 → 祖母 " + BOTC_NameStr(gm) + " 一起死亡。");
    BOTC_PmInfo(g_who[gm], "【信息】你的孙子死了，你也跟着一起死。");
}

//==================================================================================================
// 【「可能」类能力的概率表】（用户 2026-09-20 定）：只给智能说书 / 自动建议用，
//   真人说书人随时可以把 token 挪走，以他为准。想调数字只改这一张表。
//
//   水手（23）「你或他之一会醉酒」：返回**水手自己**醉酒的概率（%），剩下的概率给对方醉酒。
//     普通镇民 20 / 首夜信息位 35 / 外来者 35 / 爪牙 75 / 恶魔 90
//   （「首夜信息位」按用户 2026-09-20 的口径 = **只有首夜能拿到信息的善良角色**：
//     洗衣妇 / 图书管理员 / 调查员 / 厨师 / 祖母 ---- 共情者、占卜师这种每夜都给信息的，
//     以及教父、侍女这种不是首夜一次性信息的，都**不算**）
//==================================================================================================
// 【旅店老板（26）用】「两个目标里该醉哪一个」的档位分（越大越容易醉）：
//   首夜信息位镇民 60 / 普通镇民 50 / 外来者 40 / 爪牙 25 / 恶魔 15（用户 2026-09-20 定的）

// 赌徒（智能说书）：从当前板子的角色清单里随机挑一个（含本局没发的身份）
int BOTC_RandomBoardRole () {
    int k;
    BOTC_GridPlan();
    if (g_gridN <= 0) {
        return -1;
    }
    k = RandomInt(0, g_gridN - 1);
    return g_gridSlot[k];
}

// 赌徒（27）结算：跟**真身**比（用户 2026-09-20：干扰身份不算）。猜错当晚死亡；
//   他自己中毒 / 酒鬼时结果**反过来**（说书人骗他）。死亡走「夜间·其他」，天亮才公开。
void BOTC_GambleGuess (int p, int guess) {
    int real;
    bool right;
    string blk;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_gambleTarget[p] < 2) {
        return;
    }
    g_gambleWait[p] = false;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), false);      // 智能说书兜底代猜时它不是被点击关的，这里统一关
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_who[p]));
    if (guess < 0 || guess > 148) {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 这次没有猜，没有结算。");
        return;
    }
    real = BOTC_RegRoleOf(g_gambleTarget[p]);      // 猜的是「这个世界看到的他」（互动干扰算在内）
    right = (real == guess);
    if (!BOTC_SkillWorks(p)) {
        // 中毒 / 酒鬼的赌徒：能力失效 → 这一晚不会死（不是「结果反转」，用户 2026-09-21 明确）
        //   （他猜错却活了下来，就会以为自己猜对了 = 这条假信息）
        //   【数学家】只有「猜错了本来该死却没死」才算未正常生效；猜对了本来就不死 → 不记
        if (real != guess) {
            BOTC_MalfNote(p, "赌徒中毒/酒鬼：本来猜错会死，这一次没死");
        }
        right = true;
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 按百科不放死亡标记，这一晚不会死。");
    }
    if (real >= 0 && real <= 148) {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(g_gambleTarget[p]) + " 是「" + g_roleName[guess] + "」，登记的是「" + BOTC_RoleNameSafe(real) + "」。");
    }
    else {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(g_gambleTarget[p]) + " 是「" + g_roleName[guess] + "」。");
    }
    if (right) {
        BOTC_PmStore(g_teller, "【赌徒】猜对了：他今晚不会死。");
        return;
    }
    blk = BOTC_DeathBlocker(p, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【赌徒】猜错了，但他身上带着【" + blk + "】，这一次没有死。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(p);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(p, 1, 0, 27);   // 赌徒：打「死亡（赌徒）」（大类仍是夜间·其他）
    BOTC_PmStore(g_teller, "【赌徒】猜错了：他在今晚死亡。");
}

// 赌徒取消这次猜测：不结算（他还能再用【使用技能】重来）
void BOTC_GambleCancel (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_gambleWait[p]) {
        return;
    }
    g_gambleWait[p] = false;
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_who[p]));
    BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 取消了这次猜测，没有结算。");
}


//==================================================================================================
// 【黯月初升 · 角色实现 第 3 批】（用户 2026-09-20）：28 造谣者 / 29 侍臣 / 30 教授
//==================================================================================================

// ■ 造谣者（28）：白天公开声明一句话，当晚如果它是真的，一名玩家死亡。
//   ⚠ 这个版本的星际**没有**「输入框输入完成（回车）」事件（见 Init 里那行注释），所以只能点【确定】提交。
void BOTC_BuildGossip () {
    DialogCreate(684, 198, c_anchorRight, 185, -70, false);
    g_gossipDlg = DialogLastCreated();
    DialogSetVisible(g_gossipDlg, PlayerGroupAll(), false);
    g_gossipTitle = BOTC_NewLabel(g_gossipDlg, 648, 30, 18, 13, StringToText("公开声明一句话（今晚如果它是真的，一名玩家会死亡）"));
    libNtve_gf_SetDialogItemStyle(g_gossipTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_gossipTitle, false, PlayerGroupAll());
    g_gossipEdit = BOTC_NewEdit(g_gossipDlg, 630, 41, 27, 50);
    g_gossipOk = BOTC_NewButton(g_gossipDlg, 216, 40, 126, 135, "确定（公开声明）");
    g_gossipCancel = BOTC_NewButton(g_gossipDlg, 144, 40, 378, 135, "取消");
}

void BOTC_GossipOpen (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "造谣者只能在白天公开声明。");
        return;
    }
    if (g_gossipDay[BOTC_PosOf(p)] != g_dayNum) {
        g_gossipDone[BOTC_PosOf(p)] = false;     // 日切兜底：当天没有声明记录
    }
    if (g_gossipDone[BOTC_PosOf(p)]) {
        BOTC_Notice(p, "你今天已经声明过了：造谣者一天只能声明一次。");
        return;
    }
    g_gossipRole = 28;
    libNtve_gf_SetDialogItemText(g_gossipTitle, StringToText("公开声明一句话（今晚如果它是真的，一名玩家会死亡）"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_gossipOk, StringToText("确定（公开声明）"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_gossipEdit, StringToText(""), PlayerGroupSingle(p));
    DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "在输入框里写下你要公开声明的话，然后点【确定】。（这个版本没有回车提交，请用按钮）");
}

// 【杂耍艺人】（58）的公开猜测面板（用户 2026-09-21）：5 组「座位号 + 选身份」，按钮做小才放得下。
//   白天一次；内容只有播报和说书人日志，晚上用「猜对几个」的数字框给他数字（脚本不核对，猜的内容算不了）。
void BOTC_BuildJuggler () {
    int i;
    int y;
    DialogCreate(684, 297, c_anchorRight, 185, -70, false);
    g_juggDlg = DialogLastCreated();
    DialogSetVisible(g_juggDlg, PlayerGroupAll(), false);
    g_juggTitle = BOTC_NewLabel(g_juggDlg, 648, 30, 18, 11, StringToText("公开猜测：填座位号（1~12 = 玩家 1~12），再点右边的小按钮选身份"));
    libNtve_gf_SetDialogItemStyle(g_juggTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_juggTitle, false, PlayerGroupAll());
    for (i = 0; i < 5; i += 1) {
        y = 43 + (i * 38);
        g_juggSeatEdit[i] = BOTC_NewEdit(g_juggDlg, 86, 32, 27, y);
        g_juggRoleBtn[i] = BOTC_NewButton(g_juggDlg, 378, 32, 126, y, "选身份");
        libNtve_gf_SetDialogItemStyle(g_juggRoleBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
        g_juggRole[i] = 0;
    }
    g_juggRow = 0;
    g_juggOk = BOTC_NewButton(g_juggDlg, 216, 40, 126, 241, "确定（公开猜测）");
    g_juggCancel = BOTC_NewButton(g_juggDlg, 144, 40, 378, 241, "取消");
}

// 5 个小按钮的文字：选过就写「第N个：角色名」，没选写「第N个：选身份」
void BOTC_JugglerRowRender (int p) {
    int i;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    for (i = 0; i < 5; i += 1) {
        s = "第 " + IntToString(i + 1) + " 个：";
        if (g_juggRole[i] > 0) {
            s = s + g_roleName[g_juggRole[i]];
        }
        else {
            s = s + "选身份";
        }
        libNtve_gf_SetDialogItemText(g_juggRoleBtn[i], StringToText(s), PlayerGroupSingle(p));
    }
}

// 打开面板（白天一次）
void BOTC_JugglerOpen (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "杂耍艺人只能白天公开猜。");
        return;
    }
    if (g_juggDone[BOTC_PosOf(p)]) {
        BOTC_Notice(p, "你今天已经猜过了：杂耍艺人一天只能公开猜一次。");
        return;
    }
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
        libNtve_gf_SetDialogItemText(g_juggSeatEdit[i], StringToText(""), PlayerGroupSingle(p));
    }
    BOTC_JugglerRowRender(p);
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "填座位号（1~12），再点右边的小按钮给这一格选身份；填几组就是猜几个人。");
}

// 点第 row 格的「选身份」：弹身份网格（模式 13），选完回到这个面板
void BOTC_JugglerPickRow (int p, int row) {
    if (p < 1 || p > 13 || row < 1 || row > 5) {
        return;
    }
    g_juggRow = row;
    g_pickMode[p] = 13;
    g_pickWho[p] = p;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("第 " + IntToString(row) + " 个猜的身份"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(p));
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);      // 先收起来，别跟身份网格叠一起
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 【确定（公开猜测）】：把填好的几组拼成一句话播报出去
void BOTC_JugglerOk (int p) {
    int i;
    int n;
    int ln;
    int seat;
    int num;
    bool works;
    string s;
    string one;
    string line;
    if (p < 1 || p > 13) {
        return;
    }
    s = "";
    n = 0;
    ln = 0;
    line = "";
    works = BOTC_AbilityWorks(BOTC_PosOf(p), 58);
    for (i = 0; i < 5; i += 1) {
        if (g_juggRole[i] <= 0) {
            continue;
        }
        seat = 0;
        num = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_juggSeatEdit[i], p));
        if (num >= 1 && num <= 12) {
            seat = num + 1;
        }
        if (seat < 2) {
            continue;                     // 身份选了但座位号没填 / 填错：这一组不算
        }
        one = BOTC_NameStr(seat) + " 是 " + g_roleName[g_juggRole[i]];
        // 【猜测正确 / 干扰】（用户 2026-09-21）：真身就是他猜的那个身份 → 打「猜测正确」(89)；
        //   猜到的是陌客 / 间谍（互动干扰）→ 打「干扰」(91)，算不算对由说书人自己判。
        // 假声称只公聊播报，不记「猜测正确 / 干扰」，免得污染真杂耍艺人当晚的数字。
        if (works) {
            if (BOTC_SeatTrueRole(seat) == g_juggRole[i]) {
                g_tokOn[(((g_teller * 14) + seat) * 256) + 89] = true;
            }
            else {
                if (BOTC_RoleDisguiseStr(BOTC_SeatTrueRole(seat)) != "") {
                    g_tokOn[(((g_teller * 14) + seat) * 256) + 91] = true;
                    BOTC_PmStore(g_teller, "【杂耍艺人】" + BOTC_NameStr(seat) + " 其实是" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(seat)) + "（互动干扰）：他猜的是" + g_roleName[g_juggRole[i]] + "，算不算对你自己判。");
                    if (BOTC_RegRoleOf(seat) == g_juggRole[i]) {
                        BOTC_PmStore(g_teller, "【杂耍艺人】按登记层看，" + BOTC_NameStr(seat) + " 正好被看成" + g_roleName[g_juggRole[i]] + "（这种情况一般算猜对）。");
                    }
                }
            }
        }
        if (s == "") {
            s = one;
        }
        else {
            s = s + "，" + one;
        }
        // 【公屏分行】（用户 2026-09-21）：太长会被聊天框截掉，所以每行最多放 2 组；
        //   第一行带前缀，之后的行写「继续：」。
        if (ln == 0) {
            if (n == 0) {
                line = "【杂耍艺人】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开猜测：" + one;
            }
            else {
                line = "　　继续：" + one;
            }
        }
        else {
            line = line + "，" + one;
        }
        ln = ln + 1;
        if (ln >= 2) {
            BOTC_PubAnnounce(line);
            line = "";
            ln = 0;
        }
        n = n + 1;
    }
    if (n <= 0) {
        BOTC_Notice(p, "至少要有一组：座位号（1~12）+ 你猜的身份。");
        return;
    }
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);
    g_juggDone[BOTC_PosOf(p)] = true;
    if (ln > 0) {
        BOTC_PubAnnounce(line);          // 最后一行没凑满 2 组也要发出去（用户 2026-09-21）
    }
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【杂耍艺人】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开猜测：" + s);
    if (works) {
        BOTC_PmStore(g_teller, "【杂耍艺人】今晚给他「猜对几个」的数字：唤醒他时脚本会弹数字框，自己数就行。");
    }
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
    }
}

void BOTC_JugglerCancel (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
    }
}

void BOTC_GossipSubmit (int p) {
    string msg;
    if (p < 1 || p > 13) {
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_gossipEdit, p);
    if (StringLength(msg) <= 0) {
        BOTC_Notice(p, "输入框是空的：先写下内容，再点【确定】。");
        return;
    }
    DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
    g_gossipText = msg;
    g_gossipBy = BOTC_PosOf(p);
    g_gossipTextBy[BOTC_PosOf(p)] = msg;
    g_gossipDone[BOTC_PosOf(p)] = true;
    g_gossipDay[BOTC_PosOf(p)] = g_dayNum;
    BOTC_PubAnnounce("【造谣者】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开声明：" + msg);
    BOTC_PmStore(g_teller, "【造谣者】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开声明：" + msg);
    if (BOTC_AbilityWorks(BOTC_PosOf(p), 28)) {
        BOTC_PmStore(g_teller, "【造谣者】这条声明只算今晚：如果它是真的，今晚一名玩家死亡。");
    }
}

