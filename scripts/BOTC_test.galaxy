// 【共用答题框布局复位】疯子假爪牙模式会临时启用第 3、4 个输入框并缩短前两个框。
// 其它角色打开前统一恢复普通宽度并隐藏后两个框，避免残留控件叠在身份按钮上。
void BOTC_MiSeatFieldsReset () {
    DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 180, 41);
    DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 162, 41);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
}

// 把答题框弹给说书人：seat = 发给谁，role = 3 / 4 / 5，extra = 标题里补的信息（占卜师填他验的两个座位）
void BOTC_ManInfoOpen (int seat, int role, string extra) {
    string t;
    string s2;
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    t = "";
    if (role == 3) {
        t = "【厨师】" + BOTC_NameStr(seat) + " 的相邻邪恶对数";
    }
    if (role == 4) {
        t = "【共情者】" + BOTC_NameStr(seat) + " 身边的邪恶玩家数";
    }
    if (role == 5) {
        t = "【占卜师】" + BOTC_NameStr(seat) + " 验的 " + extra + "：里面有恶魔吗？";
    }
    if (role == 24) {
        t = "【侍女】" + BOTC_NameStr(seat) + " 选的是 " + extra + "：其中几个被唤醒？";
    }
    if (role == 47) {
        t = "【钟表匠】" + BOTC_NameStr(seat) + " 得知的距离（填数字：紧挨着是 1）";
    }
    if (role == 50) {
        t = "【数学家】" + BOTC_NameStr(seat) + "：有几个人的能力没正常生效？（填数字）";
    }
    if (role == 51) {
        t = "【卖花女孩】" + BOTC_NameStr(seat) + "：今天白天有恶魔投过票吗？";
    }
    if (role == 52) {
        t = "【城镇公告员】" + BOTC_NameStr(seat) + "：今天白天有爪牙发起过提名吗？";
    }
    if (role == 53) {
        t = "【神谕者】" + BOTC_NameStr(seat) + "：死去的玩家里有几个是邪恶的？（填数字）";
    }
    if (role == 125) {
        t = "【女祭司】" + BOTC_NameStr(seat) + "：说书人认为他最应该交流的玩家座位号（1~12）";
    }
    if (role == 55) {
        t = "【女裁缝】" + BOTC_NameStr(seat) + " 选的 " + extra + "：他们是不是同一阵营？";
    }
    if (role == 58) {
        t = "【杂耍艺人】" + BOTC_NameStr(seat) + "：他今天猜对了几个？（填数字）";
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟共情者一样是数字题，说书人填「要给他看的座位号」
    if (role == 72) {
        t = "【气球驾驶员】" + BOTC_NameStr(seat) + "：要给他看的玩家座位号（1~12）";
    }
    // 【将军(96)】（用户 2026-10-03）：每夜说书人填「善良 / 邪恶 / 均势」，原样私聊发给他
    if (role == 96) {
        t = "【将军】" + BOTC_NameStr(seat) + "：今晚哪个阵营更有优势？（填：善良 / 邪恶 / 均势）";
    }
    if (role == 90) {
        t = "【赏金猎人】" + BOTC_NameStr(seat) + "：你告诉他的那名邪恶玩家的座位号（1~12）";
    }
    // 【何方教众 · 国王(104) / 村夫(105) / 解谜大师(109)】（用户 2026-10-10）
    if (role == 105) {
        t = "【村夫】" + BOTC_NameStr(seat) + " 选的 " + extra + "：他是善良还是邪恶？（左 = 善良 / 右 = 邪恶）";
    }
    if (role == 109) {
        t = "【解谜大师】" + BOTC_NameStr(seat) + "：" + extra;
    }
    // 【数学家】框里下面加一行：口头给的（拜访说书人拿到的）信息脚本核对不了
    // 【发送特定信息】（用户 2026-10-10）：假疯子 801 / 疯子刀人 802
    if (role == 801) {
        t = "【假疯子】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 802) {
        t = "【疯子刀人】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 803) {
        t = "【国王】发给 " + BOTC_NameStr(seat) + "：「" + extra + "」";
    }
    // 【唱诗男孩（108）】：唤醒他时只填写一名玩家的座位号
    if (role == 804) {
        t = "【唱诗男孩】" + BOTC_NameStr(seat) + "：填一个座位号（1~12）";
    }
    // 【半兽人（107）】（用户 2026-10-10）：他说完目标之后弹的「让不让他杀」框
    if (role == 805) {
        t = "【半兽人】" + BOTC_NameStr(seat) + " 选中了 " + BOTC_NameStr(g_lycanTgt) + "：让他杀吗？";
    }
    // 【风雅集（板子 10）· 郎中（116）】（用户 2026-10-16）
    if (role == 806) {
        t = "【郎中】" + BOTC_NameStr(seat) + " 选的是 " + extra + "：填一个跟他能力相关的词语（2~4 个字）";
    }
    // 【牙噶巴卜（133）】（用户 2026-10-21）：首夜由说书人输入秘密短语并私聊发给他。
    if (role == 809) {
        t = "【牙噶巴卜】" + BOTC_NameStr(seat) + "：输入本局秘密短语（建议 2~5 个字，可任意长度）";
    }
    // 【发送特定信息 · 自定义文本】（用户 2026-10-21）：发送时自动加「你得知」。
    if (role == 808) {
        t = "【自定义文本】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 801 || role == 802 || role == 803 || role == 804 || role == 805 || role == 806 || role == 808) {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);   // 这一步要能取消
    }
    if (role == 47 || role == 50 || role == 53) {
        s2 = "";      // 【正确答案不显示】（用户 2026-10-03：每题都算太复杂，改成说书人自己判）
        if (role == 50) {
            s2 = s2 + "　拜访说书人获得信息是否异常需要你手动判定。";
        }
        if (seat >= 2 && g_tokOn[(((g_teller * 14) + seat) * 256) + 84]) {
            s2 = s2 + "　【涡流】他是镇民：这一条要给他错的那份。";
        }
        libNtve_gf_SetDialogItemText(g_miNote, StringToText(s2), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    }
    else {
        // 【杂耍艺人】框里把脚本数出来的标记数写出来（用户 2026-09-21：干扰的自己判）
        if (role == 58) {
            libNtve_gf_SetDialogItemText(g_miNote, StringToText("脚本数出来：猜测正确 " + IntToString(BOTC_CountTok(89)) + " 个、干扰 " + IntToString(BOTC_CountTok(91)) + " 个（带「干扰」的算不算对你自己判）"), PlayerGroupSingle(g_teller));
            DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
        }
        else {
            // 【涡流（71）】（用户 2026-09-21）：他带着「信息错误（涡流）」→ 这一条得给错的
            if (seat >= 2 && g_tokOn[(((g_teller * 14) + seat) * 256) + 84]) {
                libNtve_gf_SetDialogItemText(g_miNote, StringToText("【涡流】他是镇民：这一条信息要给错的那份，别照正确答案发。"), PlayerGroupSingle(g_teller));
                DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
            }
            else {
                DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
            }
        }
    }
    if (role == 808) {
        libNtve_gf_SetDialogItemText(g_miNote, StringToText("玩家X=座位号"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    }
    if (t == "") {
        return;
    }
    g_miSeat = seat;
    g_miRole = role;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(t)), PlayerGroupSingle(g_teller));
    g_miExtra = extra;
    DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 252, 83);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(g_miPre), PlayerGroupSingle(g_teller));
    g_miPre = "";
    if (role == 5 || role == 51 || role == 52 || role == 55 || role == 105 || role == 805) {
        // 是非题：只留两个按钮（占卜师 = 有/没有恶魔，村夫 = 善良/邪恶，其余 = 是/不是）
        DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
        DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
        if (role == 5) {
            libNtve_gf_SetDialogItemText(g_miYes, StringToText("有恶魔"), PlayerGroupSingle(g_teller));
            libNtve_gf_SetDialogItemText(g_miNo, StringToText("没有恶魔"), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 105) {
                libNtve_gf_SetDialogItemText(g_miYes, StringToText("善良"), PlayerGroupSingle(g_teller));
                libNtve_gf_SetDialogItemText(g_miNo, StringToText("邪恶"), PlayerGroupSingle(g_teller));
            }
            else {
                libNtve_gf_SetDialogItemText(g_miYes, StringToText("是"), PlayerGroupSingle(g_teller));
                libNtve_gf_SetDialogItemText(g_miNo, StringToText("不是"), PlayerGroupSingle(g_teller));
            }
        }
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 筑梦师（48）：脚本按规则自动配好「真身 + 一个对立大类的陪衬」，弹框让说书人过目再发（用户 2026-09-21）
//   规则：两个角色里一个是他的真身；另一个必须与他同一大类（镇民/外来者对爪牙/恶魔）。
//   优先挑**不在场**的角色当陪衬，实在没有再用在场的。
void BOTC_ManInfoDreamer (int seat, int target) {
    int r;
    int team;
    bool wantEvil;
    int i;
    int b;
    int n;
    int pick;
    int rr;
    int rt;
    string msg;
    if (seat < 2 || seat > 13 || target < 2 || target > 13) {
        return;
    }
    r = BOTC_SeatTrueRole(target);
    if (r < 0 || r > 148) {
        return;
    }
    team = BOTC_RoleTeam(r);
    wantEvil = true;
    if (team == 2 || team == 3) {
        wantEvil = false;                      // 他本身是邪恶 → 陪衬用善良角色
    }
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;
    }
    pick = 0;
    n = 0;
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        rr = g_boardRole[(b * 256) + i];
        if (rr == r) {
            continue;
        }
        rt = BOTC_RoleTeam(rr);
        if (wantEvil) {
            if (rt != 2 && rt != 3) {
                continue;
            }
        }
        else {
            if (rt != 0 && rt != 1) {
                continue;
            }
        }
        if (BOTC_RoleInPlay(rr)) {
            continue;                          // 第一轮只要不在场的
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = rr;
        }
    }
    if (pick == 0) {
        n = 0;
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            rr = g_boardRole[(b * 256) + i];
            if (rr == r) {
                continue;
            }
            rt = BOTC_RoleTeam(rr);
            if (wantEvil) {
                if (rt != 2 && rt != 3) {
                    continue;
                }
            }
            else {
                if (rt != 0 && rt != 1) {
                    continue;
                }
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = rr;
            }
        }
    }
    if (pick == 0) {
        BOTC_PmStore(g_teller, "【筑梦师】板子里找不到可以当陪衬的角色，这次请你自己告诉他两个角色。");
        return;
    }
    BOTC_ManInfoOpenDreamer(seat, target);
}
// 【答题框 · 重新显示】（用户 2026-09-21）：唤醒流程走完（开了私聊 / 魔典 / 技能面板）之后，
//   再把答题框显示一次，保证它不会被那些窗口盖住。
void BOTC_ManInfoReShow () {
    if (g_miRole < 0 || g_miSeat < 2 || g_miSeat > 13) {
        return;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}
// 【首夜信息位面板】（用户 2026-09-21）：座位号（洗衣妇/图管/调查员 2 个、祖母 1 个）+ 选身份 + 发送
void BOTC_MiFnRefresh () {
    string s;
    s = "已选身份：";
    if (g_miFnRole > 0) {
        s = s + g_roleName[g_miFnRole];
    }
    else {
        s = s + "（还没选）";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiFnOpen (int seat, int role) {
    if (seat < 1 || seat > 13) {      // 允许 1：说书人自己那一格（-t 试技能用，用户 2026-09-21）
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 60 + role;
    g_miFnRole = 0;
    if (role == 26) {
        libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【小精灵】" + BOTC_NameStr(seat) + "：选一个在场的镇民角色")), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 3000, 3000);
        libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选镇民"), PlayerGroupSingle(g_teller));
        DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 450, 79);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
        BOTC_MiFnRefresh();
        return;
    }
    // 【选身份】按钮无条件摆到最右边（用户 2026-09-21：它原来压在左边那个输入框上；祖母 / 洗衣妇两条路都要走这一句）
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 450, 79);
    if (role == 22 || role == 23 || role == 24 || role == 25) {
        // 1 个座位号 + 选身份：祖母 / 镜像双子配对 / 麻脸巫婆 / 洗脑师（用户 2026-09-21）
        if (role == 23) {
            libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【镜像双子】填对立双子的座位号，再选他的身份")), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 24) {
                libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【麻脸巫婆】填要改造的座位号，再选身份")), PlayerGroupSingle(g_teller));
            }
            else {
                if (role == 25) {
                    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【洗脑师】填要洗脑的座位号，再选善良角色")), PlayerGroupSingle(g_teller));
                }
                else {
                    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【祖母】" + BOTC_NameStr(seat) + "：填孙子的座位号，再选他的身份")), PlayerGroupSingle(g_teller));
                }
            }
        }
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    }
    else {
        libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【" + g_roleName[role] + "】" + BOTC_NameStr(seat) + "：填两个座位号，再选一个身份")), PlayerGroupSingle(g_teller));
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 221, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
    }
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
    if (role == 0) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选镇民"), PlayerGroupSingle(g_teller));
    }
    if (role == 1) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选外来者"), PlayerGroupSingle(g_teller));
    }
    if (role == 2) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选爪牙"), PlayerGroupSingle(g_teller));
    }
    if (role == 22 || role == 25) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选善良角色"), PlayerGroupSingle(g_teller));
    }
    if (role == 23 || role == 24) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选身份"), PlayerGroupSingle(g_teller));
    }
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    BOTC_MiFnRefresh();
}

// 点【选镇民 / 选外来者 / 选爪牙 / 选善良角色】：弹过滤好的身份网格（模式 12）
void BOTC_MiFnPickRole () {
    int role;
    role = g_miRole - 60;
    g_pickMode[g_teller] = 12;
    g_pickWho[g_teller] = g_miSeat;
    g_pickTeam = -1;
    g_pickAlign = -1;
    // 【镜像双子配对 / 麻脸巫婆】：身份都能选（善良的镜像双子也存在）
    if (role == 23 || role == 24) {
        g_pickTeam = -1;
        g_pickAlign = -1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个身份（谁的身份都可以）"), PlayerGroupSingle(g_teller));
    }
    // 【洗脑师】：只能选善良角色（+哥布林，相克，用户 2026-10-14）
    if (role == 25) {
        g_pickAlign = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色（或哥布林）"), PlayerGroupSingle(g_teller));
    }
    if (role == 0) {
        g_pickTeam = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个镇民"), PlayerGroupSingle(g_teller));
    }
    if (role == 26) {
        g_pickTeam = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个在场的镇民角色"), PlayerGroupSingle(g_teller));
    }
    if (role == 1) {
        g_pickTeam = 1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个外来者"), PlayerGroupSingle(g_teller));
    }
    if (role == 2) {
        g_pickTeam = 2;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个爪牙"), PlayerGroupSingle(g_teller));
    }
    if (role == 22) {
        g_pickAlign = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    if (role == 25) { BOTC_CerenShowGoblin(g_teller); }   // 【相克】洗脑师多放一格「哥布林」（用户 2026-10-14）
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiFnSend () {
    int role;
    int seat;
    int a;
    int b;
    int tOk;
    int tBad;
    int okSeat;
    int n;
    int i;
    int k;
    string s;
    if (g_miRole < 60) {
        return;
    }
    role = g_miRole - 60;
    seat = g_miSeat;
    a = 0;
    b = 0;
    s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n >= 1 && n <= 12) {
        a = n + 1;
    }
    s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
    n = BOTC_TextNum(s);
    if (n >= 1 && n <= 12) {
        b = n + 1;
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：只填一个座位号 ---- 发「你得知X。」+ 自动打 95 号 token，
    //   不需要选身份、也不走「两个座位」那套校验。
    if (role == 26) {
        if (g_miFnRole <= 0) {
            BOTC_Notice(g_teller, "先点【选镇民】挑一个角色。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知一个在场的镇民角色：" + g_roleName[g_miFnRole] + "。");
        BOTC_PmStore(g_teller, "【小精灵】已发给 " + BOTC_NameStr(seat) + "：一个在场的镇民角色 " + g_roleName[g_miFnRole] + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (role == 90) {
        a = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_miEdit, g_teller));
        if (a < 1 || a > 12) {
            BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
            return;
        }
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 114] = false;
        }
        g_tokOn[(((g_teller * 14) + (a + 1)) * 256) + 114] = true;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a + 1) + "。");
        BOTC_PmStore(g_teller, "【赏金猎人】已发给 " + BOTC_NameStr(seat) + "：你得知 " + BOTC_NameStr(a + 1) + " 是邪恶的。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_GrimRender(g_teller);
        return;
    }
    if (role == 72) {
        a = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_miEdit, g_teller));   // 只读**第一个**框（第二个框是隐藏的、可能留着上一次的旧值）
        if (a >= 1 && a <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a + 1) + "。");
            g_tokOn[(((g_teller * 14) + (a + 1)) * 256) + 95] = true;
            BOTC_PmStore(g_teller, "【气球驾驶员】已发给 " + BOTC_NameStr(seat) + "：你得知 " + BOTC_NameStr(a + 1) + "。");
        }
        else {
            BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
            return;
        }
        g_miSeat = 0;
        g_miRole = -1;
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        return;
    }
    if (role != 22 && role != 23 && role != 24 && role != 25 && role != 72 && (a < 2 || b < 2 || a == b)) {
        BOTC_Notice(g_teller, "要填两个不同的座位号（1~12 = 玩家 1~12）。");
        return;
    }
    if ((role == 22 || role == 23 || role == 24 || role == 25) && a < 2) {
        BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
        return;
    }
    if (g_miFnRole <= 0) {
        BOTC_Notice(g_teller, "先点【选...】挑一个身份。");
        return;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    // 【祖母】只报孙子：打「孙子（祖母）」token + 一句话
    // 【镜像双子配对】（用户 2026-09-21）：填的是对立双子的座位号 + 他的身份
    if (role == 23) {
        BOTC_TwinPair(a, g_miFnRole);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【麻脸巫婆】（用户 2026-09-21）：填要改造的座位号 + 目标身份
    if (role == 24) {
        // 官方移除时机：她这一次行动时，先把上一夜留下的「角色变化（麻脸巫婆）」收掉
        for (k = 2; k <= 13; k += 1) {
            g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
        }
        BOTC_HagApply(a, g_miFnRole);
        BOTC_GrimRender(g_teller);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【洗脑师】（用户 2026-09-21）：填要洗脑的座位号 + 让他疯狂证明的善良角色
    if (role == 25) {
        BOTC_CerenApply(a, g_miFnRole);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (role == 22) {
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 30] = false;
        }
        g_tokOn[(((g_teller * 14) + a) * 256) + 30] = true;
        if (BOTC_SeatImpaired(seat)) {
            BOTC_PmStore(g_teller, "（" + BOTC_NameStr(seat) + " 处于醉酒/中毒状态：按规则该报一个假孙子，脚本不自动改，你自己决定报谁。）");
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a) + "是" + g_roleName[g_miFnRole] + "。");
        BOTC_PmStore(g_teller, "【祖母】已把孙子发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(a) + "（" + g_roleName[g_miFnRole] + "），token 也打好了。");
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【洗衣妇 / 图书管理员 / 调查员】正确 / 错误 token
    tOk = 0;
    tBad = 1;
    if (role == 1) {
        tOk = 2;
        tBad = 3;
    }
    if (role == 2) {
        tOk = 4;
        tBad = 5;
    }
    for (i = 2; i <= 13; i += 1) {
        for (k = 0; k <= 5; k += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + k] = false;
        }
    }
    okSeat = 0;
    if (BOTC_SeatTrueRole(a) == g_miFnRole) {
        okSeat = a;
    }
    if (BOTC_SeatTrueRole(b) == g_miFnRole) {
        okSeat = b;
    }
    if (okSeat == 0) {
        if (BOTC_SeatTrueRole(a) == 15 || BOTC_SeatTrueRole(a) == 18) {
            okSeat = a;
        }
        if (BOTC_SeatTrueRole(b) == 15 || BOTC_SeatTrueRole(b) == 18) {
            okSeat = b;
        }
    }
    if (BOTC_SeatImpaired(seat)) {
        if (RandomInt(1, 2) == 1) {
            okSeat = a;
        }
        else {
            okSeat = b;
        }
        BOTC_PmStore(g_teller, BOTC_NameStr(seat) + " 处于醉酒/中毒状态，已为其随机获得真信息。");
        BOTC_PmStore(g_teller, "若不满意可以手动更改token。");
    }
    if (okSeat != 0) {
        g_tokOn[(((g_teller * 14) + okSeat) * 256) + tOk] = true;
    }
    if (a != okSeat) {
        g_tokOn[(((g_teller * 14) + a) * 256) + tBad] = true;
    }
    if (b != okSeat) {
        g_tokOn[(((g_teller * 14) + b) * 256) + tBad] = true;
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a) + "," + BOTC_NameStr(b) + " 中有" + g_roleName[g_miFnRole] + "。");
    BOTC_PmStore(g_teller, "【" + g_roleName[role] + "】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(a) + " 和 " + BOTC_NameStr(b) + " 中有" + g_roleName[g_miFnRole] + "。");
    // 【数学家】核对：两个座位的真身都不等于你选的身份 → 记一格「未正常生效」
    if (BOTC_SeatTrueRole(a) != g_miFnRole && BOTC_SeatTrueRole(b) != g_miFnRole) {
        BOTC_MalfNote(seat, "首夜信息位报的身份和真身都不符");
    }
    g_miSeat = 0;
    g_miRole = -1;
}
// 筑梦师（48）的新面板（用户 2026-09-21）：两个按钮【选善良角色】【选邪恶角色】+ 发送
void BOTC_MiDreamerRefresh () {
    string s;
    s = "已选：";
    if (g_miRoleA > 0) {
        s = s + g_roleName[g_miRoleA];
    }
    else {
        s = s + "（善良角色未选）";
    }
    s = s + "　";
    if (g_miRoleB > 0) {
        s = s + g_roleName[g_miRoleB];
    }
    else {
        s = s + "（邪恶角色未选）";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);        // 网格关掉以后再把框显示回来（用户 2026-09-21）
}

void BOTC_ManInfoOpenDreamer (int seat, int target) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 42;
    g_miRoleA = 0;
    g_miRoleB = 0;
    g_miExtra = BOTC_NameStr(target);
    g_dreamerTarget = target;          // 数学家核对用（用户 2026-09-21）
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【筑梦师】给 " + BOTC_NameStr(seat) + " 选两个角色：一个是 " + BOTC_NameStr(target) + " 的真身")), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText("选善良角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText("选邪恶角色"), PlayerGroupSingle(g_teller));
    // 这两个按钮的位置每次自己摆（首夜信息位那边会把「选身份」按钮挪到最右边，这里要摆回来）
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_MiDreamerRefresh();
}

// 点【选善良角色】/【选邪恶角色】：弹对应的身份网格（模式 10 / 11）
void BOTC_MiRoleBtn (int which) {
    if (g_miRole != 42) {
        return;
    }
    g_pickMode[g_teller] = 10;
    g_pickAlign = 0;
    if (which == 0) {
        g_pickMode[g_teller] = 11;
        g_pickAlign = 1;
    }
    g_pickWho[g_teller] = g_miSeat;
    if (which == 0) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个邪恶角色"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);       // 先把这个框收起来，别跟身份网格叠在一起（用户 2026-09-21）
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiDreamerSend () {
    int seat;
    int target;
    string msg;
    if (g_miRole != 42) {
        return;
    }
    seat = g_miSeat;
    if (g_miRoleA <= 0 || g_miRoleB <= 0) {
        BOTC_Notice(g_teller, "两个角色都选好再发送。");
        return;
    }
    msg = "【信息】你得知" + g_roleName[g_miRoleA] + "," + g_roleName[g_miRoleB] + "。";
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    BOTC_PmInfo(g_who[seat], msg);
    BOTC_PmStore(g_teller, "已发给 " + BOTC_NameStr(seat) + "：「" + msg + "」");
    // 【数学家】（用户 2026-09-21）：说书人给的两个身份里**一个都不是**那个人的真身 → 记一格「未正常生效」
    //   （身份索引口径：只看真身；两个里有一个对得上就不记）
    target = g_dreamerTarget;
    if (target >= 2 && target <= 13) {
        if (BOTC_SeatTrueRole(target) != g_miRoleA && BOTC_SeatTrueRole(target) != g_miRoleB) {
            BOTC_MalfNote(target, "筑梦师给的两个身份都不是他的真身");
        }
    }
    g_miSeat = 0;
    g_miRole = -1;
}
// 【真人说书 · 预填】把脚本算好的答案先填进答题框（说书人可以直接确定，也可以改掉）
void BOTC_ManInfoOpenPre (int seat, int role, string extra, string pre) {
    g_miPre = pre;
    BOTC_ManInfoOpen(seat, role, extra);
    g_miPre = "";
}

// 圆桌上两个座位之间隔着几个玩家（顺时针 / 逆时针取近的那边），紧挨着 = 1
int BOTC_RingDist (int a, int b) {
    int i;
    int n;
    int ka;
    int kb;
    int k;
    BOTC_BuildSeatList();
    n = g_seatN;
    if (a < 2 || b < 2 || n < 2) {
        return 0;
    }
    ka = -1;
    kb = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == a) { ka = i; }
        if (g_seatList[i] == b) { kb = i; }
    }
    if (ka < 0 || kb < 0) {
        return 0;
    }
    k = ka - kb;
    if (k < 0) { k = -k; }
    if (k > (n - k)) { k = n - k; }
    return k;
}

// 钟表匠（47）：恶魔与最近的爪牙之间最近的距离（只看真身；脚本只给建议值，说书人可以改）
int BOTC_ClockmakerDist () {
    int i;
    int d;
    int best;
    int dm;
    dm = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) { dm = i; }
    }
    if (dm < 2) {
        return 0;
    }
    best = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) { continue; }
        d = BOTC_RingDist(dm, i);
        if (best == 0 || d < best) { best = d; }
    }
    return best;
}

// 某个身份坐在哪（真身 = r 的第一个座位；没有 = 0）
int BOTC_SeatOfRole (int r) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatTrueRole(i) == r) { return i; }
    }
    return 0;
}

    // 同一个身份、但排除某个座位（用户 2026-09-21：哲学家选了疯子时，别把「刚被打上『是疯子』的他自己」当成在场的真疯子）
int BOTC_SeatOfRoleNot (int r, int skip) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == skip) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == r) {
            return i;
        }
    }
    return 0;
}
// 给「某个身份」身上打一格 token（卖花女孩 / 城镇公告员的提示标记走它）
void BOTC_TokMarkRole (int r, int t, string why) {
    int q;
    if (r < 0 || r > 148 || t < 0 || t > 255) {
        return;
    }
    q = BOTC_SeatOfRole(r);
    if (q < 2) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + t] = true;
    BOTC_GrimRender(g_teller);
}

// 数学家（50）：「未正常生效」标记（一个玩家一天最多一格）
void BOTC_MalfMark (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_RoleInPlay(50)) {
        return;          // 没有数学家就别记、也别写日志（用户 2026-09-21）
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 86]) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 86] = true;
}

// 数学家要报的数字 = 身上有「未正常生效」标记的人数（不算他自己）
int BOTC_MalfCount (int me) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (i == me) { continue; }
        if (!g_seatOn[i]) { continue; }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 86]) { n = n + 1; }
    }
    return n;
}

// 数一下场上有几个人带着某个标记（杂耍艺人报「猜对几个」时看它，用户 2026-09-21）
int BOTC_CountTok (int t) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + t]) { n = n + 1; }
    }
    return n;
}
void BOTC_MalfLunCheck () {
    if (!g_lunActed || g_lunSeat < 2 || g_demonTar < 2) {
        return;
    }
    if (g_lunTar == g_demonTar) {
        return;                        // 打得一样：没有异常，不记
    }
    if (g_tokOn[(((g_teller * 14) + g_lunSeat) * 256) + 86]) {
        return;                        // 已经记过了
    }
    BOTC_MalfNote(g_lunSeat, "疯子今晚「杀」的目标和真恶魔不一样");
}

// 【数学家】记一格「未正常生效」（用户 2026-09-21）：只在「说书人实际给的信息和真身不符」时记
//   例外：酒鬼（自带醉酒，不算别人害的）不记
void BOTC_MalfNote (int seat, string why) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!BOTC_RoleInPlay(50)) {
        return;          // 这一局场上没有数学家：一条都不记（用户 2026-09-21）
    }
    if (BOTC_SeatTrueRole(seat) == 14) {
        return;
    }
    BOTC_MalfMark(seat);
    BOTC_PmStore(g_teller, "【数学家】" + BOTC_NameStr(seat) + " 这次拿到的信息和真身不符（" + why + "）→ 记一格「未正常生效」。");
}

// ⚠【以后加新信息角色看这里】这个函数只是「数学家」用的正确答案对照表，不是角色逻辑本体：
//   · 新角色是「填数字」的信息类 → 在这里加一段 if (role == 新编号) { n = 正确数字; }
//   · 新角色是「是 / 不是」的信息类 → 加到下面 BOTC_TrueYesNoAns 里
//   · 新角色是自由问答（像博学者 / 艺术家）或答案核不了（像杂耍艺人）→ **什么都不用加**，
//     返回 -1 就是「不自动记」，留给说书人自己判定（数学家的框里已经写了那行提示）。
//   · 效果类角色（要选人的）也不用加：走唤醒时那条「中毒/酒鬼还用了能力 = 记一格」的通用规则。
// 填数字那几位的「正确答案」（真身口径）；返回 -1 = 这个角色没有能自动核对的答案
int BOTC_TrueNumAns (int role, int seat) {
    int i;
    int a;
    int b;
    int n;
    n = -1;
    if (role == 3) {
        // 厨师：相邻的邪恶对数（真身）
        n = 0;
        BOTC_BuildSeatList();
        for (i = 0; i < g_seatN; i += 1) {
            a = g_seatList[i];
            b = g_seatList[(i + 1) % g_seatN];
            if (a == b) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(a)) >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) >= 2) {
                n = n + 1;
            }
        }
    }
    if (role == 4) {
        // 共情者：身边活着的邻居里真身邪恶的人数
        n = 0;
        a = BOTC_EmpathNeighbor(seat, -1);
        b = BOTC_EmpathNeighbor(seat, 1);
        if (a >= 2 && !BOTC_SeatDead(a) && BOTC_RoleTeam(BOTC_SeatTrueRole(a)) >= 2) {
            n = n + 1;
        }
        if (b >= 2 && !BOTC_SeatDead(b) && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) >= 2) {
            n = n + 1;
        }
    }
    if (role == 24) {
        // 侍女：选中的两人里当晚被唤醒的人数
        n = 0;
        if (g_wokeTonight[g_skillT1[seat]]) {
            n = n + 1;
        }
        if (g_wokeTonight[g_skillT2[seat]]) {
            n = n + 1;
        }
        // 【相克规则：侍女 × 数学家】（用户 2026-09-21）：侍女排在数学家前面醒来时，
        //   只要选中的是「活着的数学家」，也要算他今晚会被唤醒（数学家每夜都会被唤醒）。
        if (g_skillT1[seat] >= 2 && !g_wokeTonight[g_skillT1[seat]] && BOTC_HasAbility(g_skillT1[seat], 50) && !BOTC_SeatDead(g_skillT1[seat])) {
            n = n + 1;
        }
        if (g_skillT2[seat] >= 2 && !g_wokeTonight[g_skillT2[seat]] && BOTC_HasAbility(g_skillT2[seat], 50) && !BOTC_SeatDead(g_skillT2[seat])) {
            n = n + 1;
        }
    }
    if (role == 47) {
        n = BOTC_ClockmakerDist();
    }
    if (role == 50) {
        // 数学家：他自己要报的数字 = 除他以外，场上有几个人带着「未正常生效」标记
        n = BOTC_MalfCount(seat);
    }
    if (role == 53) {
        // 神谕者：死去的邪恶玩家数（真身）
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (!BOTC_SeatDead(i)) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) >= 2) {
                n = n + 1;
            }
        }
    }
    return n;
}

// ⚠【以后加新信息角色看这里】同 BOTC_TrueNumAns：只有「你能确定正确答案」的是非题才需要加一段；
//   返回 -1 = 不自动记（交给说书人）。占卜师那一段里返回 -1 的写法就是「这个偏差不算异常」的例子。
// 是非题那几位的「正确答案」：1 = 是 / 0 = 不是 / -1 = 没法自动核对
int BOTC_TrueYesNoAns (int role, int seat) {
    int a;
    int b;
    int t;
    t = -1;
    if (role == 5) {
        t = 0;
        a = g_skillT1[seat];
        b = g_skillT2[seat];
        if (a >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(a)) == 3) {
            t = 1;
        }
        if (b >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) == 3) {
            t = 1;
        }
        // 他自己的「干扰项」是他自己能力的设定，不算别人害的：这种情况不记
        if (t == 0) {
            if (a >= 2 && g_tokOn[(((g_teller * 14) + a) * 256) + 6]) {
                t = -1;
            }
            if (b >= 2 && g_tokOn[(((g_teller * 14) + b) * 256) + 6]) {
                t = -1;
            }
        }
    }
    if (role == 51) {
        t = 0;
        if (g_tokOn[(((g_teller * 14) + seat) * 256) + 87]) {
            t = 1;
        }
    }
    if (role == 52) {
        t = 0;
        if (g_tokOn[(((g_teller * 14) + seat) * 256) + 88]) {
            t = 1;
        }
    }
    if (role == 55) {
        a = g_skillT1[seat];
        b = g_skillT2[seat];
        if (a >= 2 && b >= 2) {
            t = 0;
            if (BOTC_SeatAlign(a) == BOTC_SeatAlign(b)) {
                t = 1;
            }
        }
    }
    return t;
}
// 【测试·用户 2026-09-21】把座位 2（游戏里的「玩家1」）设成哲学家 + 直接按「他选了酒鬼 / 疯子」往下走：
//   会弹「只列镇民 / 只列恶魔」的网格给说书人，点一个就定下他的认知
void BOTC_TestPhilo (int role) {
    if (BOTC_RoleAlign(role) != 0) {
        return;
    }
    BOTC_SetSeatRole(g_teller, 2, 56);
    BOTC_SetSeatRole(g_who[2], 2, 56);
    BOTC_PhiloPick(2, role);
    BOTC_PmStore(g_teller, "【测试】座位 2 现在是哲学家，并且选了「" + g_roleName[role] + "」：请在弹出来的网格里点他以为自己是哪个角色。");
}
// 哲学家（56）：弹身份网格（只列善良角色）---- 复用侍臣那套网格，模式 8（用户 2026-09-21）
void BOTC_PhiloOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    // 【座位机制】（用户 2026-10-07 报「点唤醒之后面板弹给了错的玩家」）：
    //   p 是**格子**，而 g_pick*（身份网格那套）和一切投递都按**客户端（物理座位）** ——先换算成 cp。
    cp = g_who[p];
    g_pickMode[cp] = 8;
    g_pickWho[cp] = p;             // 网格里要挑的是"哪一格的身份" → 这里存格子
    BOTC_PickFilter(cp, true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消选择"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

// 哲学家选完角色：拿能力 / 认知覆盖 / 让在场的那个人醉酒（用户 2026-09-21）
void BOTC_PhiloPick (int p, int role) {
    int i;
    int n;
    int rr;
    int pick;
    int dm;
    if (p < 1 || p > 13) {
        return;
    }
    if (role < 0 || role > 148) {
        return;
    }
    if (BOTC_RoleAlign(role) != 0) {
        BOTC_Notice(g_who[p], "哲学家只能选善良角色。");
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_philoRole = role;                           // 记住他选的是哪个角色（同步醉酒时要用，用户 2026-09-21）
    pick = BOTC_SeatOfRoleNot(role, p);           // 那个角色在不在场：看真身，并排除他自己
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;        // 是哲学家
    if (pick >= 2 && pick != p) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 90] = true;
    }
    // ② 认知覆盖类（酒鬼 / 疯子 / 悟道者）：由**说书人**再选一次「他以为自己是哪个角色」（用户 2026-09-21 / 2026-10-16）
    if (role == 14 || role == 38 || role == 118) {
        g_philoSeat = p;
        g_philoKind = role;
        g_pickMode[g_teller] = 9;
        g_pickWho[g_teller] = p;
        g_pickTeam = 0;
        if (role == 38) { g_pickTeam = 3; }
        if (role == 118) { g_pickTeam = 1; }
        BOTC_PickFilter(g_teller, false);
        if (role == 14) {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪个镇民？"), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 118) {
                libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
            }
            else {
                libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪只恶魔？"), PlayerGroupSingle(g_teller));
            }
        }
        // 【认知覆盖类不能当那张卡】（用户 2026-10-16）：酒鬼(14) / 疯子(38) 从网格里藏起来
        if (role == 118) {
            for (i = 0; i < 64; i += 1) {
                if (g_gridSlot[i] == 14 || g_gridSlot[i] == 38) {
                    DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(g_teller), false);
                    DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(g_teller), false);
                    DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(g_teller), false);
                }
            }
        }
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（这次不算他选过）"), PlayerGroupSingle(g_teller));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    // 获得的新角色从当前夜算首夜，并允许它按自己的夜序再次进入今晚队列。
    if (g_nightNum > 0) {
        g_seatFirstNight[p] = g_nightNum;
        g_autoWoke[p] = false;
    }
    // ③ 其它角色：他直接获得那个能力
    BOTC_SetSeatRole(g_teller, p, role);
    BOTC_SetSeatRole(g_who[p], p, role);
    g_philoRole = role;                         // 换身份会把这份记录清掉，这里补回（用户 2026-09-21）
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;      // 换身份会清掉认知标记，这里补回「是哲学家」（用户 2026-09-21）
    BOTC_SeatStateSync();      // 【打完「是哲学家」之后再算一次】（用户 2026-10-14）
    if (g_who[p] == g_teller) { g_mark[(g_teller * 14) + 1] = role + 1; }
    BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 获得了 " + g_roleName[role] + " 的能力。");
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[p]);
}
// 【哲学家让人醉：谁该带「醉酒（哲学家）」】（用户 2026-09-21）
//   哲学家活着 + 清醒 + 已经选过角色 → 他选的那个角色真正的持有者醉酒
//   （真身口径；哲学家自己不算，因为他的真身被判定成「是哲学家(56)」）。
//   返回 0 = 现在没人该醉（哲学家中毒 / 酒鬼 / 死亡，或者那个角色不在场）。
int BOTC_PhiloDrunkSeat () {
    int i;
    int ph;
    int t;
    if (g_philoRole <= 0) {
        return 0;
    }
    ph = 0;
    for (i = 1; i <= 13; i += 1) {
        if (i >= 2 && !g_seatOn[i]) {
            continue;
        }
        if (!g_tokOn[(((g_teller * 14) + i) * 256) + 70]) {
            continue;
        }
        ph = i;
    }
    if (ph < 1) {
        return 0;
    }
    if (BOTC_SeatDead(ph) || BOTC_SeatImpairedRaw(ph)) {
        return 0;
    }
    t = BOTC_SeatOfRoleNot(g_philoRole, ph);
    if (t < 2) {
        return 0;
    }
    return t;
}

// 【哲学家的醉酒同步】（用户 2026-09-21）：把「醉酒（哲学家）」token(90) 撒到该带的那个座位上。
//   触发点：每次重画魔典、token 面板打 / 撤的那一刻、天亮。
void BOTC_PhiloDrunkSync () {
    int i;
    int src;
    int tgt;
    // 【说书人手动打过这枚 → 自动同步让位】（用户 2026-10-12）：
    //   不然他刚手动补上的醉酒，会被下一次同步（点别的 token / 天亮）抹掉。
    if (g_philoDrunkManual) {
        return;
    }
    tgt = BOTC_PhiloDrunkSeat();
    for (i = 1; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 90]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 90] = false;
        }
    }
    if (tgt >= 2) {
        g_tokOn[(((g_teller * 14) + tgt) * 256) + 90] = true;
    }
    for (src = 2; src <= 13; src += 1) {
        tgt = BOTC_BoffinNestedPhiloDrunkTarget(src);
        if (tgt >= 2) {
            g_tokOn[(((g_teller * 14) + tgt) * 256) + 90] = true;
        }
    }
}

// 【是不是疯子】（用户 2026-09-21）：真身是疯子(38)，或者身上带「是疯子」(49) 也算 ----
//   这样「哲学家选了疯子」的那位也能走疯子那套（假恶魔行为 / 给恶魔报目标）：
//   他现在的真身被判定成「是哲学家(56)」，光看真身会漏掉。
bool BOTC_IsLunatic (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return true;
    }
    return (BOTC_SeatTrueRole(q) == 38);
}

// 【真疯子是哪个座位】（用户 2026-09-21）：带「是疯子」但**不是**哲学家的那一个。
//   哲学家假装疯子时两个座位都像疯子；凡是「场上那个疯子是谁」的地方都走这里，
//   免得把哲学家当成疯子、把真疯子漏掉。场上没有真疯子时才退回任意一个。
int BOTC_RealLunaticSeat () {
    int i;
    int any;
    int anyDead;
    any = 0;
    anyDead = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsLunatic(i)) {
            continue;
        }
        // 【食人族（74）】吃疯子能力的那个也算「假装的那个」；真疯子死了要让位
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] || g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            if (!BOTC_SeatDead(i)) {
                any = i;
            }
            continue;
        }
        if (!BOTC_SeatDead(i)) {
            return i;
        }
        if (anyDead == 0) {
            anyDead = i;
        }
    }
    if (any >= 2) {
        return any;
    }
    return anyDead;
}

// 【今晚真的动手的那个疯子】（用户 2026-09-21）：真疯子优先、并且要清醒；
//   真疯子被哲学家弄醉时，返回的是还能行动的那个哲学疯子。
int BOTC_LunaticActingSeat () {
    int i;
    int real;
    int any;
    int realOk;
    int anyOk;
    real = 0;
    any = 0;
    realOk = 0;
    anyOk = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsLunatic(i)) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;                  // 死人不行动
        }
        // 【食人族（74）】吃疯子能力的那个也算「假装的那个」
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] || g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            any = i;
            if (!BOTC_SeatImpaired(i)) {
                anyOk = i;
            }
        }
        else {
            real = i;
            if (!BOTC_SeatImpaired(i)) {
                realOk = i;
            }
        }
    }
    if (realOk >= 2) {
        return realOk;
    }
    if (anyOk >= 2) {
        return anyOk;
    }
    if (real >= 2) {
        return real;
    }
    return any;
}
void BOTC_PhiloBelieve (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 148) {
        return;
    }
    if (g_nightNum > 0) {
        g_seatFirstNight[p] = g_nightNum;
        g_autoWoke[p] = false;
    }
    BOTC_SetSeatRole(g_teller, p, role);
    BOTC_SetSeatRole(g_who[p], p, role);
    g_philoRole = g_philoKind;                  // 他选的是酒鬼 / 疯子：换身份会把这份记录清掉，这里补回
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;      // 换身份会清掉认知标记，这里补回「是哲学家」（用户 2026-09-21）
    BOTC_SeatStateSync();      // 【同上】（用户 2026-10-14）
    if (g_philoKind == 38) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 49] = true;
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（疯子）：记得给他发 3 个不在场身份（他不会得知场上的爪牙）。");
    }
    else if (g_philoKind == 118) {
        // 【哲学家借到悟道者的能力】（用户 2026-10-16）：跟酒鬼那套一个道理 ----
        //   不能打「是悟道者」140（那会让他的真身被读成 118）；真身还是哲学家(56)，只是他以为自己是个外来者。
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（悟道者）：他只是以为自己是个外来者，没有实际能力。");
    }
    else {
        // 【哲学家借到酒鬼的能力】（用户 2026-10-13）：他本人就是「酒鬼」→ 给他打通用的「醉酒」token(24)。
        //   不能打「是酒鬼」8（8 只属于真酒鬼，而且会让他的真身被读成酒鬼）；
        //   打了 24 之后 BOTC_SeatIsDrunk 认这一格，他再借来的能力（例如炼金术士 123 那一份）就不生效。
        g_tokOn[(((g_teller * 14) + p) * 256) + 24] = true;
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（酒鬼）→ 给他打上「醉酒」token（他自己就是酒鬼，能力不生效）。");
    }
    // 【身份转变提示】（用户 2026-09-21）：哲学家选了酒鬼 / 疯子同样要发（认知覆盖造成的）
    BOTC_ChangeRoleMsg(p, role);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[p]);
}
void BOTC_NobleOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    g_nobleSeat = seat;
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：他中毒/酒鬼时能力失效 → 提醒说书人这条信息可以随便给
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【贵族】" + BOTC_NameStr(seat) + " 中毒/酒鬼 → 按规则能力失效，这三个人里有没有邪恶你可以随便给。");
    }
    libNtve_gf_SetDialogItemText(g_nobleTitle, StringToText("【贵族】" + BOTC_NameStr(seat) + "：填 3 个座位号（1~12）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE1, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE2, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE3, StringToText(""), PlayerGroupSingle(g_teller));
    // 【换座位出来的说书人也要有确认键】（用户 2026-10-18）：按「现在的」说书人重新设一次可见性
    DialogControlSetVisible(g_nobleOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_nobleOk, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_NobleSend () {
    int n;
    string s;
    string s2;
    if (g_nobleSeat < 2 || g_nobleSeat > 13) {
        return;
    }
    s2 = "【信息】你得知";
    s = libNtve_gf_DialogItemEditValue(g_nobleE1, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1) + ",";
    s = libNtve_gf_DialogItemEditValue(g_nobleE2, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1) + ",";
    s = libNtve_gf_DialogItemEditValue(g_nobleE3, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1);
    BOTC_PmInfo(g_who[g_nobleSeat], s2);
    BOTC_PmStore(g_teller, "【贵族】已发给 " + BOTC_NameStr(g_nobleSeat) + "：「" + s2 + "」");
    DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), false);
    g_nobleSeat = 0;
}

void BOTC_MezeOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 85;
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText("【灵言师】打一段短语发给他（别人说出这段短语时他会转阵营）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 252, 83);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_EngOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    // 工程师是每局限一次的主动能力：任何入口都先询问是否发动。
    // 只有从【是】按钮进入时 token 99 已写入，才会继续打开专用角色选择面板。
    if (!BOTC_NightLimitUsed(seat, 78)) {
        BOTC_LimitedAskOpen(seat);
        return;
    }
    g_engSeat = seat;
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_EngGrid (int p, int team) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    g_pickMode[p] = 19;
    g_pickWho[p] = p;
    g_pickTeam = team;
    BOTC_PickFilter(p, false);
    for (q = 0; q < g_gridN; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != team) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
        }
    }
    if (team == 3) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(p));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("关闭"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

void BOTC_FarmerOpen (int seat, bool viaLevi) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!viaLevi) {
        g_farmPending[seat] = false;
    }
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：农夫死的时候中毒/酒鬼 → 能力失效，不挑人
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(seat) + " 死的时候中毒/酒鬼 → 能力失效，没人变成农夫。");
        return;
    }
    g_farmSeat = seat;
    g_farmViaLevi = viaLevi;
    if (viaLevi) {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫×利维坦】" + BOTC_NameStr(seat) + " 的能力被触发：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫】" + BOTC_NameStr(seat) + " 夜里死了：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_farmEdit, StringToText(""), PlayerGroupSingle(g_teller));
    // 【换座位出来的说书人也要有确认键】（用户 2026-10-18）：同上
    DialogControlSetVisible(g_farmOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_farmOk, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_FarmerSend () {
    int n;
    int t;
    string s;
    if (g_farmSeat < 2 || g_farmSeat > 13) {
        return;
    }
    s = libNtve_gf_DialogItemEditValue(g_farmEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "填 1~12 的座位号。");
        return;
    }
    t = n + 1;
    if (!g_seatOn[t]) {
        BOTC_Notice(g_teller, "这个座位没有玩家。");
        return;
    }
    if (!BOTC_TargetIsLiving(t)) {
        BOTC_Notice(g_teller, "要挑一个还活着的玩家。");
        return;
    }
    if (BOTC_SeatAlign(t) != 0) {
        BOTC_Notice(g_teller, "要挑一个善良阵营的玩家。");
        return;
    }
    BOTC_SetSeatRole(g_teller, t, 80);
    BOTC_SetSeatRole(g_who[t], t, 80);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, 80);
    if (g_farmViaLevi) {
        BOTC_PmStore(g_teller, "【农夫×利维坦】相克触发 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    else {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(g_farmSeat) + " 夜里死亡 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), false);
    g_farmSeat = 0;
    g_farmViaLevi = false;
}

void BOTC_ManInfoOk () {
    string s2;
    string s;
    int n;
    int seat;
    int kind;
    int role;
    int tru;                      // 数学家核对用的正确答案
    int c89;                      // 杂耍艺人：脚本数的「猜测正确」个数（用户 2026-09-21）
    int c91;                      // 杂耍艺人：脚本数的「干扰」个数

    // 【科学怪人状态面板】只用于查看，点关闭即可，不发送任何信息。
    if (g_miRole == 810) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_miText = "";
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
        return;
    }

    // 【牙噶巴卜（133）】首夜秘密短语：只私聊发给本人；之后杀谁由说书人手动打死亡 token。
    if (g_miRole == 809) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先输入一段秘密短语再点【确定】。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        BOTC_PmStore(g_teller, "【牙噶巴卜】秘密短语已发给 " + BOTC_NameStr(seat) + "：" + s + "。之后是否造成死亡由你手动打死亡 token。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }

    // 【发送特定信息 · 自定义文本】（用户 2026-10-21）：自动在输入内容前加「你得知」。
    if (g_miRole == 808) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "自定义文本是空的：先输入内容再发送。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], BOTC_InfoText("你得知" + s));
        BOTC_PmStore(g_teller, "【发送特定信息】自定义文本已发给 " + BOTC_NameStr(seat) + "：" + BOTC_InfoText("你得知" + s));
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        g_specTo = 0;
        return;
    }

    // 【事务官（142）】：一个框 = 一名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 14) {
        seat = g_miSeat;
        g_evilA = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        if (g_evilA < 2) {
            BOTC_Notice(g_teller, "请填写一个玩家座位号（1~12）。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 167] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【事务官】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + "。");
        return;
    }
    // 【骑士（122）】：两个框 = 两名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 13) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA) + "," + BOTC_NameStr(g_evilB));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 141] = true;
        g_tokOn[(((g_teller * 14) + g_evilB) * 256) + 141] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【骑士】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "。");
        return;
    }
    // 【风雅集（板子 10）· 店小二（115）】（用户 2026-10-16）：两个框 = 他要得知的两名善良玩家 → 私聊告诉他
    if (g_miRole == 41 && g_miKind == 12) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知[" + IntToString(g_lab[g_evilA] + g_nameNumShift) + "],[" + IntToString(g_lab[g_evilB] + g_nameNumShift) + "]。");
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 135] = true;
        g_tokOn[(((g_teller * 14) + g_evilB) * 256) + 135] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【店小二】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + " 是善良玩家（两人已打「熟客」）。");
        BOTC_DrunkPickOpen(2, seat, g_evilA, g_evilB);   // 【二选一醉酒】（用户 2026-10-16）：说书人再点谁醉
        return;
    }

    // 【风雅集（板子 10）· 郎中（116）】（用户 2026-10-16）：框里那个词原样私聊发给他
    if (g_miRole == 806) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一个词再点【确定】。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        BOTC_PmStore(g_teller, "【郎中】已告诉 " + BOTC_NameStr(seat) + "：" + s);
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【军团 · 假军团（疯子）】（用户 2026-09-30）：说书人填的两个座位号 = 这两个军团不给疯子看
    //   两个框都空 / 点取消 = 不屏蔽（疯子看到所有队友）
    if (g_miRole == 41 && g_miKind == 9) {
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(g_evilA, g_evilB);
        BOTC_NotifyDemonsLunatic();
        return;
    }
    if (g_miRole == 85) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一段短语再点【确定】。");
            return;
        }
        s2 = "【信息】你得知" + s;
        BOTC_PmInfo(g_who[seat], s2);
        BOTC_PmStore(g_teller, "【灵言师】关键词已发给 " + BOTC_NameStr(seat) + "：「" + s + "」");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【将军(96)】（用户 2026-10-03）：把框里的字（善良 / 邪恶 / 均势）原样私聊发给他
    if (g_miRole == 96) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s2) <= 0) {
            s2 = "（说书人没填内容）";
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s2);
        BOTC_PmStore(g_teller, "【将军】已告诉 " + BOTC_NameStr(seat) + "：" + s2 + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【何方教众 · 国王(104) / 村夫(105) / 解谜大师(109)】（用户 2026-10-10）：框里的字原样发给他
    if (g_miRole == 109) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s2) <= 0) {
            s2 = "（说书人没填内容）";
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知的「谁是恶魔」：" + s2);
        BOTC_PmStore(g_teller, "【解谜大师】已告诉 " + BOTC_NameStr(seat) + "（错误信息）：" + s2 + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【发送特定信息】（用户 2026-10-10）：假疯子 / 疯子刀人（文案跟以前智能说书那套一字不差）
    if (g_miRole == 801) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的编号（那个被说成「疯子」的人）。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "是疯子。");
        BOTC_PmStore(g_teller, "【假疯子】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是疯子。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    if (g_miRole == 802) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n >= 1 && n <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1));
            BOTC_PmStore(g_teller, "【疯子刀人】已发给 " + BOTC_NameStr(seat) + "：他今晚「杀」的是 " + BOTC_NameStr(n + 1) + "。");
        }
        else {
            BOTC_PmInfo(g_who[seat], "【信息】你得知没有目标。");
            BOTC_PmStore(g_teller, "【疯子刀人】已发给 " + BOTC_NameStr(seat) + "：疯子今晚没有选择目标。");
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    // 【发送特定信息 · 国王】（用户 2026-10-10）：填一个编号 → 告诉他「谁是国王」
    if (g_miRole == 803) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的编号（谁是国王）。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "是国王。");
        BOTC_PmStore(g_teller, "【国王】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是国王。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    // 【唱诗男孩（108）】：只发送得知的座位号，不附加阵营结论
    if (g_miRole == 804) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的座位号。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "。");
        BOTC_PmStore(g_teller, "【唱诗男孩】已告诉 " + BOTC_NameStr(seat) + "：你得知" + BOTC_NameStr(n + 1) + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole == 41) {
        seat = g_miSeat;
        kind = g_miKind;
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        else {
            if (StringLength(s) > 0) {
                BOTC_PmStore(g_teller, "【调试】第一个框读到：「" + s + "」");
            }
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        else {
            if (StringLength(s) > 0) {
                BOTC_PmStore(g_teller, "【调试】第二个框读到：「" + s + "」");
            }
        }
        // 疯子假爪牙可填第 3、4 个；其它两种格式仍只用前两个框。
        if (kind == 0) {
            s = libNtve_gf_DialogItemEditValue(g_miEdit3, g_teller);
            n = BOTC_TextNum(s);
            if (n >= 1 && n <= 12) {
                g_evilC = n + 1;
            }
            s = libNtve_gf_DialogItemEditValue(g_miEdit4, g_teller);
            n = BOTC_TextNum(s);
            if (n >= 1 && n <= 12) {
                g_evilD = n + 1;
            }
        }
        if (g_evilA < 2 && g_evilB < 2 && g_evilC < 2 && g_evilD < 2) {
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        s2 = "";
        if (kind == 2) {
            // 贤者（59）：两个玩家，其中一个是杀死他的那只恶魔（用户 2026-09-21）
            if (g_evilA >= 2 && g_evilB >= 2) {
                s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + "," + BOTC_NameStr(g_evilB) + "。";
            }
            else {
                if (g_evilA >= 2) {
                    s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + "。";
                }
                else {
                    s2 = "【信息】你得知" + BOTC_NameStr(g_evilB) + "。";
                }
            }
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【贤者】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            // 【数学家】核对（用户 2026-09-21）：说书人填的这两个座位里**真身**都没有恶魔 → 记一格「未正常生效」
            //   （按说书人填的座位判，不看 token）
            if (BOTC_RoleInPlay(50) && g_evilA >= 2 && g_evilB >= 2) {
                if (BOTC_RoleTeam(BOTC_SeatTrueRole(g_evilA)) != 3 && BOTC_RoleTeam(BOTC_SeatTrueRole(g_evilB)) != 3) {
                    BOTC_MalfNote(seat, "贤者指的两个人都不是恶魔（按说书人填的座位判）");
                }
            }
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        if (kind == 0) {
            s2 = "";
            if (g_evilA >= 2) { s2 = BOTC_NameStr(g_evilA); }
            if (g_evilB >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilB);
            }
            if (g_evilC >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilC);
            }
            if (g_evilD >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilD);
            }
            s2 = "【信息】你得知" + s2 + " 是爪牙。";
        }
        else {
            s2 = "【信息】你得知";
            if (g_evilA >= 2) {
                s2 = s2 + BOTC_NameStr(g_evilA) + " 是恶魔。";
            }
            if (g_evilB >= 2) {
                s2 = s2 + "爪牙：" + BOTC_NameStr(g_evilB) + "。";
            }
        }
        BOTC_PmInfo(g_who[seat], s2);
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole == 40) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        if (StringLength(g_miText) > 0) {
            BOTC_PmInfo(g_who[g_miSeat], BOTC_InfoText(g_miText));
            BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(g_miSeat) + "：「" + BOTC_InfoText(g_miText) + "」");
        }
        g_miSeat = 0;
        g_miRole = -1;
        g_miText = "";
        return;
    }
    if (g_miRole != 3 && g_miRole != 4 && g_miRole != 24 && g_miRole != 47 && g_miRole != 50 && g_miRole != 53 && g_miRole != 58 && g_miRole != 125) {
    if (g_miRole == 42) {
        BOTC_MiDreamerSend();
        return;
    }
    if (g_miRole >= 60) {
        BOTC_MiFnSend();
        return;
    }
        return;
    }
    if (g_miSeat < 2 || g_miSeat > 13) {
        return;
    }
    seat = g_miSeat;
    role = g_miRole;
    // ⚠ 空框读出来是空字符串：先拦掉，再交给 BOTC_TextNum 认数字
    s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
    if (StringLength(s) == 0) {
        return;
    }
    n = BOTC_TextNum(s);
    if (n < 0) {
        return;
    }
    if (n > 12) {
        n = 9;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    // 【数学家】核对（用户 2026-09-21）：说书人填的数字和真身不符 → 记一格「未正常生效」
    //   ⚠ 以前这段被塞进了 if (role == 3) 里面，所以只有厨师会核；现在挪到所有数字题的前面：
    //     厨师 3 / 共情者 4 / 侍女 24 / 钟表匠 47 / 数学家 50 / 神谕者 53 都会核（杂耍艺人 58 单独判区间）
    tru = BOTC_TrueNumAns(role, seat);
    if (tru >= 0 && tru != n) {
        BOTC_MalfNote(seat, "填的数字和真身不符");
    }
    if (role == 3) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 4) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：填的数字 = 要给他看的座位号（1~12 → 玩家 2~13）
    if (role == 72) {
        if (n >= 1 && n <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "。");
            g_tokOn[(((g_teller * 14) + (n + 1)) * 256) + 95] = true;      // Learned (Balloonist)
        }
        else {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
        }
    }
    if (role == 24) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 47) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 50) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 53) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 125) {
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "女祭司要给一个 1~12 的玩家座位号。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + " 是说书人认为你最应该与其交流的玩家。");
        BOTC_PmStore(g_teller, "【女祭司】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是最应该交流的玩家。");
    }
    if (role == 58) {
        // 【数学家】核对（用户 2026-09-21）：脚本数的「猜测正确」是下限、「猜测正确 + 干扰」是上限
        //   （带上「干扰」标记的那几条算不算对由说书人自己判，所以只判「超出区间」才算没正常生效）
        c89 = BOTC_CountTok(89);
        c91 = BOTC_CountTok(91);
        if (tru < 0 && (n < c89 || n > (c89 + c91))) {
            BOTC_MalfNote(seat, "杂耍艺人报的猜对数不在脚本数的区间里");
            BOTC_PmStore(g_teller, "【数学家】核对：他报 " + IntToString(n) + " 个，脚本数出来是「猜测正确 " + IntToString(c89) + " 个 + 干扰 " + IntToString(c91) + " 个」→ 记一格「未正常生效」。");
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
        g_juggUsed[seat] = true;       // 得过信息了：这一局不再唤醒他
    }
    BOTC_PmStore(g_teller, "已把「" + IntToString(n) + "」发给 " + BOTC_NameStr(seat) + "（" + BOTC_SeatRoleStr(seat) + "）。");
    g_miSeat = 0;
    g_miRole = -1;
}

// 输入框里那行字 → 数字（认不出来返回 -1）
//   ⚠ 先拿**整串**去认（不用 StringFind / StringToInt：实测输入框取回来的字串
//     取子串 / 转数字都可能读歪），整串认不出再退回去试第 1、第 2 个字符。
int BOTC_TextNum (string s) {
    if (StringLength(s) <= 0) {
        return -1;
    }
    return StringToInt(s);
}

// 占卜师：说书人点【有恶魔】/【没有恶魔】，点完立刻私聊发给占卜师本人
void BOTC_ManInfoYesNo (int yes) {
    int seat;
    int t2;
    string ans;
    string who;
    int tru;
    // 【筑梦师】（42）：那两个按钮其实是「选善良角色 / 选邪恶角色」（用户 2026-09-21）
    if (g_miRole == 42) {
        BOTC_MiRoleBtn(yes);
        return;
    }
    // 【亡骨魔（69）】（用户 2026-09-21）：这两个按钮 = 「左 / 右两名候选镇民」，点哪个哪个中毒
    if (g_miRole == 79) {
        if (yes != 0) {
            BOTC_VigPoison(g_vigA);
        }
        else {
            BOTC_VigPoison(g_vigB);
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miRole = -1;
        return;
    }
    // 【二选一醉酒】（用户 2026-10-16）：左边 = 候选 A，右边 = 候选 B，点谁谁醉
    if (g_miRole == 807) {
        BOTC_DrunkPickApply(yes);
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miRole = -1;
        return;
    }
    // 【村夫（105）】（用户 2026-10-10）：左边 = 善良、右边 = 邪恶
    if (g_miRole == 105) {
        seat = g_miSeat;
        ans = "【信息】你得知邪恶。";
        if (yes != 0) {
            ans = "【信息】你得知善良。";
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], ans);
        BOTC_PmStore(g_teller, "【村夫】已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【半兽人（107）】（用户 2026-10-10）：说书人拍板「让不让他杀」---- 是 = 他死且今晚恶魔不杀人；否 = 恶魔正常出刀
    if (g_miRole == 805) {
        seat = g_miSeat;
        t2 = g_lycanTgt;
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_lycanTgt = 0;
        if (yes == 0) {
            BOTC_PmStore(g_teller, "【半兽人】这次不杀 → 恶魔正常出刀。");
            return;
        }
        if (t2 < 2 || t2 > 13) {
            return;
        }
        BOTC_MarkDeathQuietSrc(t2, 1, 0, 107);
        g_lycanNoDemon = true;
        BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(seat) + " 杀死了 " + BOTC_NameStr(t2) + " → 今晚恶魔不造成死亡。");
        return;
    }
    // 【首夜信息位】（60+角色编号）：那个按钮是「选身份」（用户 2026-09-21）
    if (g_miRole >= 60) {
        BOTC_MiFnPickRole();
        return;
    }
    if (g_miSeat < 2 || g_miSeat > 13) {
        return;
    }
    // 【梦殒春宵】是非题：卖花女孩（51）/ 城镇公告员（52）/ 女裁缝（55）（用户 2026-09-21）
    if (g_miRole == 51 || g_miRole == 52 || g_miRole == 55) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        if (g_miRole == 51 || g_miRole == 52 || g_miRole == 55) {
            ans = "【信息】你得知否";
            if (yes != 0) {
                ans = "【信息】你得知是";
            }
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], ans);
        tru = BOTC_TrueYesNoAns(g_miRole, seat);
        if (tru >= 0 && tru != yes) {
            BOTC_MalfNote(seat, "答的和真身不符");
        }
        BOTC_PmStore(g_teller, "已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole != 5) {
        return;
    }
    seat = g_miSeat;
    ans = "否";
    if (yes != 0) {
        ans = "是";
    }
    who = g_miExtra;
    // 【数学家】核对（占卜师）：说书人点的答案和真身不符 → 记一格「未正常生效」
    tru = BOTC_TrueYesNoAns(5, seat);
    if (tru >= 0 && tru != yes) {
        BOTC_MalfNote(seat, "占卜师的答案和真身不符");
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    BOTC_PmInfo(g_who[seat], "【信息】你得知" + ans);
    BOTC_PmStore(g_teller, "占卜师：已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
    g_miSeat = 0;
    g_miRole = -1;
}

// 造谣者的死者：跟镇长弹刀同一套口径（先数场上善良/邪恶存活数，邪恶快追平时挑邪恶，
//   否则挑善良并按「已失去能力 > 首夜被动 / 外来者 > 其它」三级优先）。排除造谣者自己。
int BOTC_GossipVictim (int by) {
    int i;
    int q;
    int r;
    int good;
    int evil;
    int n;
    int pick;
    int n1;
    int n2;
    int n3;
    int p1;
    int p2;
    int p3;
    good = 0;
    evil = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == by || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            evil = evil + 1;
        }
        else {
            good = good + 1;
        }
    }
    if (good - evil <= 2) {
        n = 0;
        pick = 0;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == by || BOTC_SeatDead(q)) {
                continue;
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_RoleAlign(r) == 1) {
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = q;
                }
            }
        }
        return pick;
    }
    n1 = 0;
    n2 = 0;
    n3 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == by || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 148) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 12] || g_tokOn[(((g_teller * 14) + q) * 256) + 17]) {
            n1 = n1 + 1;
            if (RandomInt(1, n1) == 1) {
                p1 = q;
            }
        }
        else {
            if (g_roleAct[r] == 5 || BOTC_RoleTeam(r) == 1) {
                n2 = n2 + 1;
                if (RandomInt(1, n2) == 1) {
                    p2 = q;
                }
            }
            else {
                n3 = n3 + 1;
                if (RandomInt(1, n3) == 1) {
                    p3 = q;
                }
            }
        }
    }
    if (p1 >= 2) {
        return p1;
    }
    if (p2 >= 2) {
        return p2;
    }
    return p3;
}

// 智能说书：夜间该醒的都处理完之后结算造谣者的声明（真人说书由他自己判）
void BOTC_GossipNightResolve () {
    int by;
    int victim;
    string blk;
    by = g_gossipBy;
    if (by < 2 || by > 13) {
        return;
    }
    if (StringLength(g_gossipText) <= 0) {
        return;
    }
    if (!BOTC_AbilityWorks(by, 28)) {
        BOTC_PmStore(g_teller, "【造谣者】" + BOTC_NameStr(by) + " 没有可用的造谣者能力（来源失效 / 中毒 / 不是该能力）→ 今晚不结算。");
        return;
    }
    if (RandomInt(1, 100) > 50) {
        BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 声明「" + g_gossipText + "」→ 判定为假，今晚没有死亡。");
        return;
    }
    victim = BOTC_GossipVictim(by);
    if (victim < 2) {
        BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 的声明判真，但场上没有可以死的人。");
        return;
    }
    blk = BOTC_DeathBlocker(victim, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "造谣者声明判真，本来会死的是 " + BOTC_NameStr(victim) + "，但他带着【" + blk + "】，没有死。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(victim);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(victim, 1, 0, 28);     // 造谣者：打「死亡（造谣者）」
    BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 声明「" + g_gossipText + "」→ 判定为真：今晚 " + BOTC_NameStr(victim) + " 死亡。");
}

// ■ 侍臣（29）：每局限一次，选一个**角色**，让带有这个角色的人醉酒三个夜晚和三个白天。
void BOTC_CourtierOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    // 【座位机制】（用户 2026-10-07）：p 是格子；g_courtUsed 按格子存，g_pick* / 投递按客户端
    cp = g_who[p];
    if (g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]) {
        BOTC_Notice(cp, "你这一局的侍臣能力已经用过了或已失去能力。");
        return;
    }
    g_pickMode[cp] = 5;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("不发动技能"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_CourtierPick (int p, int role) {
    int i;
    int q;
    int seat;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]) {
        return;                                  // 已经用过了或已失去能力：重复调用直接忽略
    }
    BOTC_TellRoleChoice(p, role);
    g_courtUsed[p] = true;                       // 不管成不成，这一次机会都用掉
    g_courtRole = role;
    if (!BOTC_SkillWorks(p)) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 47] = true;      // 自己中毒/酒鬼时用掉 → 直接打「失去能力（侍臣）」
        BOTC_GrimRender(g_teller);
        BOTC_SkillBtnRender();
        return;
    }
    seat = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RegRoleOf(i) == role) {         // 谁「被看成」这个角色就算谁（间谍可能被看成镇民）
            seat = i;
        }
    }
    if (seat < 2) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 47] = true;      // 发动过了 → 立刻在自己身上打「失去能力（侍臣）」（用户 2026-09-20）
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选了「" + BOTC_RoleNameSafe(role) + "」，但本局没有这个角色 → 什么也没发生。");
        BOTC_SkillBtnRender();
        return;
    }
    g_courtSeat = seat;
    g_courtLeft = 3;                             // 醉酒1 / 2 / 3：每个黄昏换一张（跟百科一致）
    g_tokOn[(((g_teller * 14) + seat) * 256) + 53] = true;     // 醉酒1
    g_tokOn[(((g_teller * 14) + p) * 256) + 47] = true;        // 发动过了 → 立刻在自己身上打「失去能力（侍臣）」（用户 2026-09-20）
    if (role == 141) {
        BOTC_PmInfo(g_who[seat], "【维齐尔×侍臣相克】你被侍臣选中，失去能力并醉酒；白天免死不再生效。");
        BOTC_PmStore(g_teller, "【维齐尔×侍臣相克】" + BOTC_NameStr(seat) + " 失去能力并醉酒，已撤销白天免死。");
        BOTC_VizierSync();
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选了「" + BOTC_RoleNameSafe(role) + "」→ " + BOTC_NameStr(seat) + " 醉酒三个夜晚和三个白天。");
    BOTC_SkillBtnRender();
}

// 侍臣的时长（跟百科一致）：每个**黄昏**把醉酒1换成醉酒2、醉酒2换成醉酒3，
//   第三次黄昏把醉酒3换掉，并在侍臣自己身上打「失去能力（侍臣）」。
void BOTC_CourtierTick () {
    int s;
    if (g_courtSeat < 2) {
        return;
    }
    s = g_courtSeat;
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 53]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 53] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 54] = true;
        g_courtLeft = 2;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(s) + " 的醉酒：醉酒1 → 醉酒2。");
        return;
    }
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 54]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 54] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 55] = true;
        g_courtLeft = 1;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(s) + " 的醉酒：醉酒2 → 醉酒3。");
        return;
    }
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 55]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 55] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 47] = true;     // 失去能力（侍臣）打在他自己身上
        g_courtLeft = 0;
        BOTC_GrimRender(g_teller);
    }
}

// ■ 奥赫（134）：每个夜晚*选择一个角色；角色在场则持有者死亡，不在场时由说书人选择死亡玩家。
void BOTC_OjoOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    if (BOTC_SeatImpaired(p)) {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼：这次选角色不产生死亡。");
        BOTC_MalfMark(p);
        return;
    }
    cp = g_who[p];
    g_ojoFrom = p;
    g_ojoRole = -1;
    g_ojoAskSt = false;
    g_pickMode[cp] = 30;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("今晚不发动技能"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_OjoDecline (int p) {
    g_ojoFrom = 0;
    g_ojoRole = -1;
    g_ojoAskSt = false;
    BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 今晚不发动技能。");
}

void BOTC_OjoOpenStTarget (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 148) {
        return;
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_ojoFrom = p;
    g_ojoRole = role;
    g_ojoAskSt = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【奥赫】点一名合法的存活的玩家，再按【确认】。");
}

void BOTC_OjoResolveTarget (int p, int target) {
    if (p < 1 || p > 13 || target < 2 || target > 13) {
        return;
    }
    if (!g_ojoAllow[target]) {
        BOTC_Notice(g_teller, "这个座位不在奥赫这次可选的范围内。");
        return;
    }
    g_ojoAskSt = false;
    g_ojoFrom = 0;
    g_ojoRole = -1;
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼 / 失去能力：这次没有死亡。");
        return;
    }
    BOTC_GoonTouch(p, target);
    if (BOTC_ProtectTokOn(target, 140)) {
        BOTC_WudChangeOpen(target, p);
    }
    BOTC_DemonStrike(p, 134, target, false);
}

void BOTC_OjoPick (int p, int role) {
    int q;
    int matches;
    int alive;
    int last;
    int sent;
    if (p < 1 || p > 13 || role < 0 || role > 148) {
        return;
    }
    if (p != g_ojoFrom) {
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_ojoRole = role;
    // 【奥赫疯子】：疯子的奥赫能力不产生死亡，只把自己选择的角色报给所有真恶魔。
    if (BOTC_IsLunatic(p)) {
        g_ojoFrom = 0;
        g_ojoAskSt = false;
        if (BOTC_SkillWorks(p)) {
            sent = BOTC_PmInfoDemons("【信息】疯子选择了" + g_roleName[role] + "。");
            if (sent > 0) {
                BOTC_PmStore(g_teller, "【疯子】已直接私聊告诉 " + IntToString(sent) + " 只恶魔：奥赫疯子选择了「" + g_roleName[role] + "」。");
            }
            else {
                BOTC_PmStore(g_teller, "【疯子】场上没有可接收信息的真恶魔；奥赫疯子实际选择了「" + g_roleName[role] + "」。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这次没有发送给恶魔；他实际选择了「" + g_roleName[role] + "」，这条别外传。");
        }
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼 / 失去能力：选择了「" + g_roleName[role] + "」，但这次没有死亡。");
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_ojoAllow[q] = false;
    }
    matches = 0;
    alive = 0;
    last = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatTrueRole(q) != role) {
            continue;
        }
        matches = matches + 1;
        if (!BOTC_SeatDead(q)) {
            g_ojoAllow[q] = true;
            alive = alive + 1;
            last = q;
        }
    }
    if (matches == 0) {
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || BOTC_SeatDead(q)) {
                continue;
            }
            g_ojoAllow[q] = true;
            alive = alive + 1;
            last = q;
        }
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了不在场的「" + g_roleName[role] + "」→ 改由说书人选择死亡玩家。");
    }
    else if (alive == 0) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」，但持有者已经死亡，没有新的死亡。");
        return;
    }
    else {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」：场上有 " + IntToString(alive) + " 名存活持有者。");
    }
    if (alive == 0) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】场上没有可被杀死的玩家。");
        return;
    }
    if (alive == 1) {
        BOTC_OjoResolveTarget(p, last);
        return;
    }
    BOTC_OjoOpenStTarget(p, role);
}

// ■ 卡扎力（135）：随机发牌时把原有爪牙位置替换成不在场的善良角色；首夜自动唤醒后只与说书人私聊安排。
void BOTC_KazaliCompositionApply () {
    int i;
    int q;
    int n;
    int pick;
    int r;
    int oldR;
    int made;
    if (g_kazCompositionDone) {
        return;
    }
    g_kazCompositionDone = true;
    if (!BOTC_RoleInPlay(135)) {
        return;
    }
    made = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) {
            continue;
        }
        n = 0;
        pick = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick < 0) {
            BOTC_PmStore(g_teller, "【卡扎力】配板时没有足够的不在场善良角色，无法替换 " + BOTC_NameStr(q) + " 的爪牙身份。");
            continue;
        }
        oldR = BOTC_SeatTrueRole(q);
        BOTC_SetSeatRole(g_teller, q, pick);
        g_scrUsed[oldR] = false;
        g_scrUsed[pick] = true;
        made = made + 1;
        BOTC_PmStore(g_teller, "【卡扎力】配板：" + BOTC_NameStr(q) + " 的 " + g_roleName[oldR] + " 已替换为不在场的善良角色「" + g_roleName[pick] + "」。");
    }
}

// ■ 科学怪人（132）：每个能力来源座位独立保存一份善良角色 → 接收者。
bool BOTC_BoffinSourceIs (int b) {
    if (b < 2 || b > 13 || !g_seatOn[b]) {
        return false;
    }
    if (BOTC_SeatTrueRole(b) == 132) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + b) * 256) + 123] && g_alcBorrow == 132) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + b) * 256) + 97] && g_cannRole == 132) {
        return true;
    }
    if (g_grantRoleBy[b] == 133) {       // 手工赋予科学怪人能力
        return true;
    }
    // 【性能】只有这个座位自己确实从科怪那里获得了「科怪」能力，
    // 才需要继续找它的科怪来源；普通对局和普通科怪来源在这里直接返回。
    if (!g_bnestChosenBy[b] || g_bnestRoleBy[b] != 133) {
        return false;
    }
    if (BOTC_BoffinNestedSourceIs(b)) {
        return true;
    }
    return false;
}

// 科怪把哲学家 / 炼金术士给恶魔后，由恶魔选择并获得的嵌套能力。
// 这里只附加能力：不改 g_mark，不打「是哲学家」70 / 「是炼金术士」123。
bool BOTC_BoffinNestedSourceIs (int q) {
    int src;
    int outerRole;
    if (q < 2 || q > 13) {
        return false;
    }
    for (src = 2; src <= 13; src += 1) {
        if (src == q || !g_bnestChosenBy[src] || g_boffinTargetBy[src] != q) {
            continue;
        }
        outerRole = g_boffinRoleBy[src] - 1;
        if (outerRole != 56 && outerRole != 95) {
            continue;
        }
        if (g_bnestRoleBy[src] != 133) {
            continue;
        }
        if (BOTC_BoffinSourceIs(src)) {
            return true;
        }
    }
    return false;
}

bool BOTC_BoffinNestedWorksAt (int src, int q) {
    int outerRole;
    if (src < 2 || src > 13 || q < 2 || q > 13) {
        return false;
    }
    if (!g_bnestChosenBy[src] || g_boffinTargetBy[src] != q) {
        return false;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    if (outerRole != 56 && outerRole != 95) {
        return false;
    }
    return BOTC_BoffinWorksAt(src);
}

int BOTC_BoffinNestedSourceFor (int q, int role) {
    int src;
    if (q < 2 || q > 13 || role < 0 || role > 148) {
        return 0;
    }
    for (src = 2; src <= 13; src += 1) {
        if (BOTC_BoffinNestedWorksAt(src, q) && g_bnestRoleBy[src] == role + 1) {
            return src;
        }
    }
    return 0;
}

bool BOTC_BoffinNestedHasRole (int q, int role) {
    return (BOTC_BoffinNestedSourceFor(q, role) >= 2);
}

int BOTC_BoffinNestedPhiloDrunkTarget (int src) {
    int q;
    int role;
    if (src < 2 || src > 13 || !g_bnestChosenBy[src] || g_boffinRoleBy[src] - 1 != 56) {
        return 0;
    }
    if (!BOTC_BoffinSourceIs(src)) {
        return 0;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13 || BOTC_SeatDead(src) || BOTC_SeatImpairedRaw(src)) {
        return 0;
    }
    if (BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
        return 0;
    }
    role = g_bnestRoleBy[src] - 1;
    if (role < 0 || role > 148) {
        return 0;
    }
    return BOTC_SeatOfRoleNot(role, q);
}

bool BOTC_BoffinNestedPhiloDrunkAt (int seat) {
    int src;
    if (seat < 2 || seat > 13) {
        return false;
    }
    for (src = 2; src <= 13; src += 1) {
        if (BOTC_BoffinNestedPhiloDrunkTarget(src) == seat) {
            return true;
        }
    }
    return false;
}

void BOTC_BoffinNestedClearSource (int src) {
    int i;
    if (src < 2 || src > 13) {
        return;
    }
    g_bnestRoleBy[src] = 0;
    g_bnestChosenBy[src] = false;
    for (i = 0; i <= 13; i += 1) {
        g_bnestDoneBy[(src * 14) + i] = false;
        if (g_bnestSource[i] == src) {
            g_bnestActing[i] = false;
            g_bnestSource[i] = 0;
        }
    }
}

void BOTC_BoffinNestedOpen (int src) {
    int cp;
    int i;
    int pick;
    int q;
    int outerRole;
    if (src < 2 || src > 13 || !BOTC_BoffinWorksAt(src)) {
        return;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13) {
        return;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    g_boffinEditSource = src;
    // 哲学家能力由恶魔玩家自己选择；电脑恶魔由脚本替他选。
    if (outerRole == 56 && BOTC_SeatIsComputer(q)) {
        pick = BOTC_AIPhiloRandomRole(-2);
        if (pick >= 0) {
            BOTC_BoffinNestedPick(src, pick);
        }
        else {
            BOTC_PmStore(g_teller, "当前板子没有可自动选择的角色。");
        }
        return;
    }
    // 炼金术士能力仍由说书人选择；哲学家能力显示给恶魔本人。
    if (outerRole == 95) {
        cp = g_teller;
    }
    else {
        cp = g_who[q];
    }
    g_pickWho[cp] = src;
    if (outerRole == 56) {
        g_pickMode[cp] = 35;
        BOTC_PickFilter(cp, true);
        for (i = 0; i < 64; i += 1) {
            if (g_gridSlot[i] != 56 && g_gridSlot[i] != 95 && g_gridSlot[i] != 148) {
                continue;
            }
            DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(cp), false);
        }
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    }
    else if (outerRole == 95) {
        g_pickMode[cp] = 36;
        g_pickTeam = 2;
        BOTC_PickFilter(cp, false);
        for (i = 0; i < 64; i += 1) {
            if (BOTC_RoleTeam(g_gridSlot[i]) == 2) {
                continue;
            }
            DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(cp), false);
        }
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    }
    else {
        return;
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_BoffinNestedPick (int src, int role) {
    int q;
    int outerRole;
    if (src < 2 || src > 13 || role < 0 || role > 148 || !BOTC_BoffinWorksAt(src)) {
        return;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13) {
        return;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    if (outerRole == 56 && role == 148) {
        BOTC_Notice(g_teller, "科学怪人×食人魔：恶魔无法获得食人魔的能力。");
        return;
    }
    if (outerRole == 56 && BOTC_RoleAlign(role) != 0) {
        BOTC_Notice(g_teller, "这里只能选择善良角色。");
        return;
    }
    if (outerRole == 95 && BOTC_RoleTeam(role) != 2) {
        BOTC_Notice(g_teller, "这里只能选择爪牙角色。");
        return;
    }
    g_bnestRoleBy[src] = role + 1;
    g_bnestChosenBy[src] = true;
    g_bnestDoneBy[(src * 14) + q] = false;
    g_boffinDoneBy[(src * 14) + q] = true;     // 外层哲学家 / 炼金术士选择已经在这一步完成
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[q]);
    BOTC_PmInfo(g_who[q], "【信息】你得知" + g_roleName[role]);
    BOTC_PmStore(g_teller, BOTC_NameStr(q) + " 选择了 " + g_roleName[role]);
    if (role == 132) {
        g_bnestDoneBy[(src * 14) + q] = true;
        BOTC_BoffinOpenRole(q);
    }
}

int BOTC_BoffinNestedRoleOrderFor (int src, int q) {
    int role;
    int act;
    if (!BOTC_BoffinNestedWorksAt(src, q)) {
        return 0;
    }
    role = g_bnestRoleBy[src] - 1;
    if (role < 0 || role > 148) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    act = g_roleAct[role];
    if (act == 2 && g_nightNum < 2) { return 0; }
    if (act == 5 && g_nightNum > g_seatFirstNight[q]) { return 0; }
    if (act != 1 && act != 2 && act != 5 && act != 6) { return 0; }
    return BOTC_NightOrder(role);
}

int BOTC_BoffinNestedWakeSource (int q) {
    int src;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (src = 2; src <= 13; src += 1) {
        if (g_bnestDoneBy[(src * 14) + q]) {
            continue;
        }
        o = BOTC_BoffinNestedRoleOrderFor(src, q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = src;
            bestOrd = o;
        }
    }
    return best;
}

int BOTC_BoffinNestedWakeOrder (int q) {
    int src;
    src = BOTC_BoffinNestedWakeSource(q);
    if (src < 2) {
        return 0;
    }
    return BOTC_BoffinNestedRoleOrderFor(src, q);
}

int BOTC_BoffinNestedWakeSeat () {
    int src;
    int q;
    int o;
    int bestQ;
    int bestOrd;
    bestQ = 0;
    bestOrd = 0;
    for (src = 2; src <= 13; src += 1) {
        q = g_boffinTargetBy[src];
        if (g_bnestDoneBy[(src * 14) + q]) {
            continue;
        }
        o = BOTC_BoffinNestedRoleOrderFor(src, q);
        if (o > 0 && (bestQ < 2 || o < bestOrd)) {
            bestQ = q;
            bestOrd = o;
        }
    }
    return bestQ;
}

void BOTC_BoffinClearSource (int b) {
    int j;
    if (b < 2 || b > 13) {
        return;
    }
    BOTC_BoffinNestedClearSource(b);
    g_boffinRoleBy[b] = 0;
    g_boffinChosenBy[b] = false;
    g_boffinTargetBy[b] = 0;
    g_boffinAnnouncedBy[b] = 0;
    g_boffinPendingBy[b] = 0;
    for (j = 0; j <= 13; j += 1) {
        g_boffinDoneBy[(b * 14) + j] = false;
        if (g_boffinActingSource[j] == b) {
            g_boffinActing[j] = false;
            g_boffinActingSource[j] = 0;
        }
    }
    if (g_boffinEditSource == b) {
        g_boffinEditSource = 0;
        g_boffinRecipientPick = false;
    }
}

int BOTC_BoffinSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (BOTC_BoffinSourceIs(q)) {
            return q;
        }
    }
    return 0;
}

int BOTC_BoffinDemonSeat () {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinSourceIs(b) && g_boffinChosenBy[b]) {
            return g_boffinTargetBy[b];
        }
    }
    return 0;
}

bool BOTC_BoffinWorksAt (int b) {
    int q;
    if (!BOTC_BoffinSourceIs(b) || !g_boffinChosenBy[b]) {
        return false;
    }
    if (g_boffinRoleBy[b] < 1 || g_boffinRoleBy[b] > 148) {
        return false;
    }
    q = g_boffinTargetBy[b];
    if (q < 2 || q > 13 || !g_seatOn[q] || !BOTC_IsDemonSeat(q)) {
        return false;
    }
    if (BOTC_SeatDead(b) || BOTC_SeatImpaired(b)) {
        return false;
    }
    if (g_grantRoleBy[b] == 133 && g_grantDrunkBy[b]) {
        if (BOTC_SeatTrueRole(b) != 132) {
            if (!(g_tokOn[(((g_teller * 14) + b) * 256) + 123] && g_alcBorrow == 132)) {
                if (!(g_tokOn[(((g_teller * 14) + b) * 256) + 97] && g_cannRole == 132)) {
                    return false;
                }
            }
        }
    }
    return true;
}

bool BOTC_BoffinSourceWorks () {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinWorksAt(b)) {
            return true;
        }
    }
    return false;
}

bool BOTC_BoffinActiveFrom (int b, int q, int role) {
    if (!BOTC_BoffinWorksAt(b) || q < 2 || q > 13 || g_boffinTargetBy[b] != q) {
        return false;
    }
    return (g_boffinRoleBy[b] == role + 1);
}

bool BOTC_BoffinActiveFor (int q, int role) {
    int b;
    if (q < 2 || q > 13 || role < 0 || role > 148) {
        return false;
    }
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinActiveFrom(b, q, role)) {
            return true;
        }
    }
    return false;
}

int BOTC_BoffinTargetWithRole (int role) {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinActiveFrom(b, g_boffinTargetBy[b], role)) {
            return g_boffinTargetBy[b];
        }
    }
    return 0;
}

bool BOTC_BoffinMustStayEvil (int q) {
    // 官方相克：异教领袖 / 莽夫的能力不能把科学怪人局的恶魔变成善良。
    return (BOTC_BoffinActiveFor(q, 106) || BOTC_BoffinActiveFor(q, 37));
}

bool BOTC_BoffinRoleAllowed (int role) {
    int i;
    int n;
    if (role < 0 || role > 148) {
        return false;
    }
    if (BOTC_RoleTeam(role) != 0 && BOTC_RoleTeam(role) != 1) {
        return false;
    }
    if (BOTC_RoleAlign(role) != 0) {
        return false;
    }
    // 【科学怪人 × 村夫】：角色列表最多三张村夫，因此场上有 0~2 名村夫时仍可授予。
    if (role == 105) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (g_seatOn[i] && BOTC_SeatTrueRole(i) == 105) {
                n = n + 1;
            }
        }
        return (n < 3);
    }
    if (BOTC_RoleTrueInPlay(role)) {
        return false;
    }
    // 认知覆盖、会再次改身份、或官方明确不允许恶魔获得的能力不在候选里。
    // 哲学家 / 炼金术士例外：走专用嵌套附加能力，不修改恶魔牌面。
    if (role == 14 || role == 38 || role == 62 || role == 74 || role == 80) {
        return false;
    }
    if (role == 91 || role == 97 || role == 101 || role == 117 || role == 118 || role == 124 || role == 148) {
        return false;
    }
    return true;
}

void BOTC_BoffinOpenRole (int source) {
    int q;
    if (!BOTC_BoffinSourceIs(source)) {
        return;
    }
    g_boffinEditSource = source;
    g_boffinPendingBy[source] = 0;
    g_boffinRecipientPick = false;
    g_pickMode[g_teller] = 32;
    g_pickWho[g_teller] = 1;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_BoffinRoleAllowed(g_gridSlot[q])) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BoffinOpenStatus (int q) {
    string note;
    if (q < 2 || q > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    if (g_boffinChosenBy[q] && g_boffinTargetBy[q] >= 2 && g_boffinRoleBy[q] >= 1 && g_boffinRoleBy[q] <= 148) {
        note = "已赋予" + BOTC_NameStr(g_boffinTargetBy[q]) + "：" + g_roleName[g_boffinRoleBy[q] - 1] + "。";
        if (g_bnestChosenBy[q] && g_bnestRoleBy[q] >= 1 && g_bnestRoleBy[q] <= 148) {
            note = note + " 嵌套能力：" + g_roleName[g_bnestRoleBy[q] - 1] + "。";
        }
    }
    else {
        note = "这个来源尚未选择要赋予恶魔的能力。";
    }
    g_miSeat = 0;
    g_miRole = 810;
    g_miText = "";
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText("【科学怪人】能力状态"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("关闭"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BoffinSyncKnowledge () {
    int b;
    int d;
    int role;
    for (b = 2; b <= 13; b += 1) {
        if (!BOTC_BoffinWorksAt(b)) {
            continue;
        }
        d = g_boffinTargetBy[b];
        role = g_boffinRoleBy[b] - 1;
        if (d == g_boffinAnnouncedBy[b]) {
            continue;
        }
        BOTC_PmInfo(g_who[d], "【信息】你得知" + g_roleName[role]);
        if (BOTC_SeatTrueRole(b) == 95) {
            BOTC_PmStore(g_teller, "【炼金科怪】只通知恶魔 " + BOTC_NameStr(d) + "：" + BOTC_NameStr(b) + " 给予「" + g_roleName[role] + "」能力。");
        }
        else {
            BOTC_PmInfo(g_who[b], "【信息】你得知" + g_roleName[role]);
            BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(b) + " 赋予恶魔 " + BOTC_NameStr(d) + "「" + g_roleName[role] + "」能力。");
        }
        g_boffinAnnouncedBy[b] = d;
    }
}

void BOTC_BoffinPick (int role) {
    int src;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src) || !BOTC_BoffinRoleAllowed(role)) {
        BOTC_Notice(g_teller, "科学怪人只能把不在场的善良角色能力赋给恶魔。");
        return;
    }
    g_boffinPendingBy[src] = role + 1;
    BOTC_BoffinRecipientOpen();
}

void BOTC_BoffinRecipientOpen () {
    int i;
    int role;
    int src;
    bool hasDemon;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src)) {
        return;
    }
    role = g_boffinPendingBy[src];
    if (role <= 0) {
        role = g_boffinRoleBy[src];
    }
    if (role < 1 || role > 148) {
        BOTC_Notice(g_teller, "先选择科学怪人要赋予的能力。");
        return;
    }
    hasDemon = false;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && !BOTC_SeatDead(i) && BOTC_IsDemonSeat(i)) {
            hasDemon = true;
        }
    }
    if (!hasDemon) {
        BOTC_PmStore(g_teller, "【科学怪人】场上没有存活恶魔，暂时不能选择能力接收者。");
        BOTC_Notice(g_teller, "场上没有存活恶魔：无法指定科怪能力接收者。");
        return;
    }
    g_boffinRecipientPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一名存活恶魔，再按【确认】。");
}

void BOTC_BoffinSetRecipient (int q) {
    int old;
    int oldRole;
    int role;
    int src;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src) || q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
        BOTC_Notice(g_teller, "只能选择一名存活的恶魔。");
        return;
    }
    role = g_boffinPendingBy[src];
    if (role <= 0) {
        role = g_boffinRoleBy[src];
    }
    if (role < 1 || role > 148) {
        return;
    }
    old = g_boffinTargetBy[src];
    oldRole = g_boffinRoleBy[src] - 1;
    if (oldRole == 56 || oldRole == 95) {
        BOTC_BoffinNestedClearSource(src);
    }
    if (old >= 2 && old <= 13 && old != q && g_boffinActingSource[old] == src) {
        g_boffinActing[old] = false;
        g_boffinActingSource[old] = 0;
    }
    if (old >= 2 && old <= 13 && old != q) {
        BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(src) + " 更换接收者：旧接收者 " + BOTC_NameStr(old) + " 失去这份能力。");
    }
    g_boffinRoleBy[src] = role;
    g_boffinChosenBy[src] = true;
    g_boffinTargetBy[src] = q;
    g_boffinAnnouncedBy[src] = 0;
    g_boffinPendingBy[src] = 0;
    g_boffinDoneBy[(src * 14) + q] = false;
    g_boffinRecipientPick = false;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(src) + " 选择「" + g_roleName[role - 1] + "」，接收者 " + BOTC_NameStr(q) + "。");
}

bool BOTC_BoffinFirstWakeStep () {
    int b;
    int src;
    src = 0;
    if (g_nightNum != 1) {
        return false;
    }
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinSourceIs(b) && !g_boffinChosenBy[b]) {
            src = b;
            break;
        }
    }
    if (src < 2) {
        return false;
    }
    g_boffinEditSource = src;
    if (!g_awake[src]) {
        BOTC_WakeToggle(src);
    }
    if (!g_awake[src]) {
        return false;
    }
    if (!g_boffinChosenBy[src] && g_pickMode[g_teller] != 32) {
        BOTC_BoffinOpenRole(src);
    }
    g_insertWake[src] = false;
    g_autoWoke[src] = true;
    g_autoLast = src;
    BOTC_TellerPmTo(src);
    BOTC_WakeRender();
    return true;
}

int BOTC_ActRoleOf (int p) {
    int src;
    if (p < 1 || p > 13) {
        return -1;
    }
    if (p == 1 && g_pdRole > 0 && g_pdRole <= 148) {
        return g_pdRole - 1;
    }
    if (g_boffinActing[p]) {
        src = g_boffinActingSource[p];
        if (BOTC_BoffinWorksAt(src)) {
            return g_boffinRoleBy[src] - 1;
        }
        return -1;
    }
    if (g_bnestActing[p]) {
        src = g_bnestSource[p];
        if (BOTC_BoffinNestedWorksAt(src, p) && g_bnestRoleBy[src] > 0 && g_bnestRoleBy[src] <= 148) {
            return g_bnestRoleBy[src] - 1;
        }
        return -1;
    }
    if (g_grantActing[p] && g_grantRoleBy[p] > 0 && g_grantRoleBy[p] <= 148) {
        return g_grantRoleBy[p] - 1;
    }
    return g_mark[(g_teller * 14) + p] - 1;
}

int BOTC_BoffinRoleOrderForSource (int src, int q) {
    int role;
    int act;
    if (q < 2 || q > 13 || BOTC_SeatDead(q) || g_boffinTargetBy[src] != q) {
        return 0;
    }
    if (!BOTC_BoffinWorksAt(src)) {
        return 0;
    }
    role = g_boffinRoleBy[src] - 1;
    if (role < 0 || role > 148) {
        return 0;
    }
    // 哲学家 / 炼金术士是一次性选择：完成选择后不再自动唤醒这两种能力本身。
    if ((role == 56 || role == 95) && g_bnestChosenBy[src]) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    act = g_roleAct[role];
    if (act == 2 && g_nightNum < 2) { return 0; }
    if (act == 5 && g_nightNum > 1) { return 0; }
    if (act != 1 && act != 2 && act != 5 && act != 6) { return 0; }
    return BOTC_NightOrder(role);
}

int BOTC_BoffinSourceActionOrder (int src, int q) {
    if (g_boffinDoneBy[(src * 14) + q]) {
        return 0;
    }
    return BOTC_BoffinRoleOrderForSource(src, q);
}

int BOTC_BoffinWakeSource (int q) {
    int b;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (b = 2; b <= 13; b += 1) {
        o = BOTC_BoffinSourceActionOrder(b, q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = b;
            bestOrd = o;
        }
    }
    return best;
}

int BOTC_BoffinWakeOrder (int q) {
    int src;
    src = BOTC_BoffinWakeSource(q);
    if (src < 2) {
        return 0;
    }
    return BOTC_BoffinSourceActionOrder(src, q);
}

int BOTC_BoffinWakeSeat () {
    int b;
    int q;
    int o;
    int bestQ;
    int bestOrd;
    bestQ = 0;
    bestOrd = 0;
    for (b = 2; b <= 13; b += 1) {
        q = g_boffinTargetBy[b];
        o = BOTC_BoffinSourceActionOrder(b, q);
        if (o > 0 && (bestQ < 2 || o < bestOrd)) {
            bestQ = q;
            bestOrd = o;
        }
    }
    return bestQ;
}

// 手工赋予能力的夜序：获得能力的那一夜视为这项能力的「首个夜晚」。
int BOTC_GrantNightOrder (int q) {
    int role;
    int act;
    int first;
    if (q < 2 || q > 13 || !g_seatOn[q] || g_grantRoleBy[q] <= 0) {
        return 0;
    }
    role = g_grantRoleBy[q] - 1;
    first = g_grantFirstNight[q];
    if (role < 0 || role > 148 || first < 1 || g_nightNum < first) {
        return 0;
    }
    act = g_roleAct[role];
    if (act == 2 && g_nightNum == first) {
        return 0;                         // 带星号角色本身没有首夜行动
    }
    if (act == 5 && g_nightNum != first) {
        return 0;                         // 首夜信息只在它的首个夜晚出现
    }
    if (act != 1 && act != 2 && act != 5 && act != 6) {
        return 0;
    }
    if (g_nightNum == first) {
        return BOTC_NoFirstOf(role);
    }
    return BOTC_NoOtherOf(role);
}

bool BOTC_ActingIsFirstNight (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (g_grantActing[q]) {
        return (g_grantFirstNight[q] >= 1 && g_nightNum == g_grantFirstNight[q]);
    }
    return (g_nightNum <= g_seatFirstNight[q]);
}

int BOTC_GrantWakeOrder (int q) {
    int role;
    int own;
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || g_grantDoneNight[q]) {
        return 0;
    }
    role = g_grantRoleBy[q] - 1;
    own = g_mark[(g_teller * 14) + q] - 1;
    if (role < 0 || role > 148 || role == own) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    return BOTC_GrantNightOrder(q);
}

int BOTC_GrantWakeSeat () {
    int q;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (q = 2; q <= 13; q += 1) {
        o = BOTC_GrantWakeOrder(q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = q;
            bestOrd = o;
        }
    }
    return best;
}

bool BOTC_AbilityWorks (int q, int role) {
    int tr;
    if (!BOTC_HasAbility(q, role)) {
        return false;
    }
    if (q == 1 && g_pdRole == role + 1) {
        return true;                       // 获得后不再受瘟疫医生之后的醉酒 / 中毒影响
    }
    tr = BOTC_SeatTrueRole(q);
    if (tr == role) {
        return !BOTC_SeatImpaired(q);
    }
    if (BOTC_BoffinActiveFor(q, role)) {
        return true;                       // 恶魔自身中毒/醉酒不影响来自科学怪人的能力
    }
    if (BOTC_BoffinNestedHasRole(q, role)) {
        return true;
    }
    if (g_grantRoleBy[q] == role + 1) {
        return (!g_grantDrunkBy[q] && !BOTC_SeatImpaired(q));
    }
    return !BOTC_SeatImpaired(q);
}

// 【找当前可用的某项能力】---- 原生身份、哲学家 / 食人族 / 炼金术士借来的、
// 科怪赋予的、说书人手工赋予的都算；能力处于醉酒 / 中毒或来源失效时不算。
// 只用于被动能力的全局查询，不用于【真身是什么】的身份登记。
int BOTC_AbilitySeat (int role) {
    int q;
    if (role < 0 || role > 148) {
        return 0;
    }
    for (q = 1; q <= 13; q += 1) {
        if (q >= 2 && !g_seatOn[q]) {
            continue;
        }
        if (BOTC_AbilityWorks(q, role)) {
            return q;
        }
    }
    return 0;
}

bool BOTC_AbilityInPlay (int role) {
    return (BOTC_AbilitySeat(role) >= 1);
}

// ■ 教授（30）：每局限一次，选一名已死亡的玩家；如果他是镇民就复活他（并恢复一次性能力）。
void BOTC_ProfessorResolve (int p, int seat) {
    int real;
    if (p < 1 || p > 13 || seat < 2 || seat > 13) {
        return;
    }
    g_profUsed[p] = true;
    g_tokOn[(((g_teller * 14) + p) * 256) + 44] = true;          // 失去能力（教授）：只要用了能力就打（百科明确写）
    BOTC_GrimRender(g_teller);
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次复活无效。");
        BOTC_SkillBtnRender();
        return;
    }
    real = BOTC_RegRoleOf(seat);          // 是不是镇民按「互动干扰」那一层算
    if (real < 0 || real > 148) {
        return;
    }
    if (!BOTC_RegIsTownsfolk(seat)) {
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(seat) + "（" + BOTC_RoleNameSafe(real) + "）---- 不是镇民，没有复活。");
        BOTC_SkillBtnRender();
        return;
    }
    if (BOTC_PublicDead(seat)) {
        // 【复活也等天亮统一结算】（用户 2026-09-20）：以前这里直接 BOTC_DeathToggle 就把红叉去掉了，
        //   全桌当场看见「复活」；现在只在夜里记一个「复活（教授）」标记 ----
        //   红叉先留着，天亮才统一公布「【复活】X 复活」并清掉死亡 token / 红叉。
        g_tokOn[(((g_teller * 14) + seat) * 256) + 42] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【教授】已记下复活 " + BOTC_NameStr(seat) + "：红叉先留着，天亮统一公布「复活」并清掉死亡标记。");
    }
    else {
        // 【只有「公开死亡（红叉）」才算有效目标】（用户 2026-09-20）：选到没红叉的人 → 告知目标无效、什么都不做
        BOTC_Notice(g_who[p], "要选一个已经死了的人。");
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(seat) + "，但对方没有红叉 → 目标无效、没有复活。");
        BOTC_SkillBtnRender();
        return;
    }
    BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 复活了 " + BOTC_NameStr(seat) + "（" + BOTC_RoleNameSafe(real) + "）。");
    BOTC_SkillBtnRender();
}

// 复活之后恢复这个座位的一次性能力（百科明确写：连用过的「每局限一次」也恢复）
void BOTC_RestoreOneShot (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    g_limitedAsk[q] = false;
    g_poAsk[q] = false;
    g_skillRoleSel[q] = 0;
    g_declareUsed[g_who[q]] = false;           // 猎手：又能声称了（客户端口径 → 换成那个人的客户端号）
    g_tokOn[(((g_teller * 14) + q) * 256) + 12] = false;         // 失去能力（猎手）
    g_tokOn[(((g_teller * 14) + q) * 256) + 17] = false;         // 失去能力（贞洁者）
    g_courtUsed[q] = false;                        // 侍臣：又能用一次
    g_profUsed[q] = false;                         // 教授自己（保险）
    // 【其余「一局一次」的能力也一起恢复】（用户 2026-10-14 报：刺客复活后刺杀没刷新）----
    //   以前这里只有猎手 / 贞洁者 / 侍臣 / 教授；刺客 / 弄臣 / 巡山人 / 解谜大师 / 女裁缝 / 僵怖 /
    //   沙巴洛斯 这一批都漏了，现在一并补上（口径：复活 = 重新进场，一次性能力全部恢复）。
    g_assiUsed[q] = false;                         // 刺客（41）：又能刺杀一次
    g_tokOn[(((g_teller * 14) + q) * 256) + 44] = false;         // 失去能力（教授）
    g_tokOn[(((g_teller * 14) + q) * 256) + 45] = false;         // 失去能力（刺客）
    g_tokOn[(((g_teller * 14) + q) * 256) + 47] = false;         // 失去能力（侍臣）
    g_foolUsed[q] = false;                         // 弄臣（34）：第一次免死恢复
    g_tokOn[(((g_teller * 14) + q) * 256) + 46] = false;         // 失去能力（弄臣）
    g_tokOn[(((g_teller * 14) + q) * 256) + 98] = false;         // 失去能力（巡山人 77）
    g_tokOn[(((g_teller * 14) + q) * 256) + 99] = false;         // 失去能力（工程师 78）
    g_tokOn[(((g_teller * 14) + q) * 256) + 130] = false;        // 已猜测（解谜大师 109）
    g_tokOn[(((g_teller * 14) + q) * 256) + 68] = false;         // 失去能力（女裁缝 55）
    g_tokOn[(((g_teller * 14) + q) * 256) + 145] = false;        // 已使用（鸩 124）：复活后重新获得一次机会
    g_tokOn[(((g_teller * 14) + q) * 256) + 147] = false;        // 已使用（守夜人 128）：复活后恢复一次机会
    g_zombUsed[q] = false;                         // 僵怖（43）：第一次不会死恢复
    g_sabRegurgDone[q] = false;                    // 沙巴洛斯（45）：一局一次的反刍恢复
    g_tokOn[(((g_teller * 14) + q) * 256) + 101] = false;        // 无法提名（魔像 81）：一局一次的提名恢复
    // 【方古（68）**不**在这里恢复】（用户 2026-10-14）：它的「限一次转化」是**整局全局**的效果 ----
    //   连之后上位的新方古也一样不能传刀，所以复活时不清 g_fangUsed / token 78。
    // ==========================================================================================
    // 【★ 登记处】（用户 2026-10-14 定的规矩）：以后凡是要新增「一局一次 / 限一次」的角色，
    //   一律在本函数（BOTC_RestoreOneShot）里把「用掉」的标记清掉 ----
    //   一般要清两样：① 那个角色自己的 bool 记账（例如 g_assiUsed / g_foolUsed）；
    //   ② 它用掉之后打在自己身上的那枚 token（例如 45 失去能力（刺客））。
    //   另一半（可声称 / 死亡触发那一批：猎手 / 造谣者 / 月之子 / 杂耍艺人 / 呆瓜）在
    //   BOTC_ClearDeath() 里，两处都要登记、都别漏。
    //   ⚠ 例外：**整局全局**的效果不刷（例如方古 68 的「限一次转化」，新方古也不能传刀）。
    // ==========================================================================================
    BOTC_FoolSync();                               // 弄臣：把「首次未死」标记重新点亮（46 已经在上面收掉了）
    BOTC_GrimRender(g_teller);
    // 【重新进场：首夜重新算】（用户 2026-09-20）：复活之后的下一个夜晚又算他的「首夜」----
    //   首夜信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母 / 教父...）可以再被唤醒一次、信息再给一次；
    //   祖母那种「你的首个夜晚」的能力也会重新挑一次孙子（旧 token 由 BOTC_NanaPick 清掉）。
    if (g_dayNum <= 0) {
        g_seatFirstNight[q] = 1;
    }
    else {
        g_seatFirstNight[q] = g_dayNum + 1;        // 下一个夜晚 = 他的新首夜
    }
    BOTC_PmStore(g_teller, "【复活】" + BOTC_NameStr(q) + " 重新进场：第 " + IntToString(g_seatFirstNight[q]) + " 夜又算他的「首夜」，首夜信息位可以再被唤醒一次。");
    BOTC_PmStore(g_teller, "【复活】" + BOTC_NameStr(q) + " 的一次性能力已恢复。");
    BOTC_DeclareRender();
    BOTC_SkillBtnRender();
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 4 批】（用户 2026-09-20）：31 吟游诗人 / 32 茶艺师 / 33 和平主义者
//==================================================================================================

// ■ 吟游诗人（31）：「当一名爪牙死于处决时，除了你和旅行者以外的所有其他玩家醉酒直到明天黄昏。」
//   被动角色，不唤醒；只挂在「处决」这一步上（处决尸体不算，因为那不是真的死）。
void BOTC_MinstrelCheck (int executed) {
    int i;
    int m;
    if (executed < 2 || executed > 13) {
        return;
    }
    if (!BOTC_RegIsMinion(executed)) {
        return;                                  // 必须是爪牙（按「互动干扰」那一层算）
    }
    m = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_AbilityWorks(i, 31)) {
            m = i;
        }
    }
    if (m < 2) {
        return;
    }
    if (BOTC_SeatDead(m)) {
        return;
    }
    for (i = 0; i <= 13; i += 1) {
        g_minstrelDrunk[i] = false;
    }
    g_minstrelDay = g_dayNum;                     // 记住触发的那一天：要撑到「明天黄昏」
    for (i = 2; i <= 13; i += 1) {
        if (i == m || !g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 62] = true;     // 醉酒（吟游诗人）：到明天黄昏（用户 2026-09-20）
        g_minstrelDrunk[i] = true;                // 记号：这一份醉酒是吟游诗人的（当天黄昏不清）
    }
    g_tokOn[(((g_teller * 14) + m) * 256) + 50] = true;         // 全员醉酒（吟游诗人）标记
    g_minstrelDrunk[m] = true;                    // 吟游诗人自己也记一份（他那格是 50）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【吟游诗人】爪牙 " + BOTC_NameStr(executed) + " 被处决 → 除了吟游诗人以外的所有其他玩家醉酒到明天黄昏。");
}

// ■ 茶艺师（32）：「与你邻近的两名存活的玩家是善良的 → 他们不会死亡。」（动态判定，只认真身）
bool BOTC_TeaLadyProtects (int q) {
    int i;
    int n1;
    int n2;
    if (q < 2 || q > 13) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 32)) {
            continue;
        }
        if (BOTC_SeatDead(i) || BOTC_SeatImpaired(i)) {
            continue;
        }
        n1 = BOTC_EmpathNeighbor(i, -1);
        n2 = BOTC_EmpathNeighbor(i, 1);
        if (n1 < 2 || n2 < 2 || n1 == n2) {
            continue;
        }
        if (q != n1 && q != n2) {
            continue;
        }
        if (BOTC_SeatRegAlign(n1) == 0 && BOTC_SeatRegAlign(n2) == 0) {   // 善良按「互动干扰」那一层
            return true;                         // 两个邻居都是善良 → 这两个人都不会死
        }
    }
    return false;
}

// 把「不会死亡（茶艺师）」标记刷新到该保护的人身上（天亮 / 黄昏 / 有人死之后各刷一次）
void BOTC_TeaLadySync () {
    int i;
    int k;
    int n1;
    int n2;
    int tl;
    int[14] on;
    for (i = 0; i <= 13; i += 1) {
        on[i] = 0;
    }
    for (k = 2; k <= 13; k += 1) {
        if (!BOTC_AbilityWorks(k, 32)) {
            continue;
        }
        if (BOTC_SeatDead(k) || BOTC_SeatImpaired(k)) {
            continue;
        }
        n1 = BOTC_EmpathNeighbor(k, -1);
        n2 = BOTC_EmpathNeighbor(k, 1);
        if (n1 < 2 || n2 < 2 || n1 == n2) {
            continue;
        }
        if (BOTC_SeatRegAlign(n1) == 0 && BOTC_SeatRegAlign(n2) == 0) {   // 善良按「互动干扰」那一层
            on[n1] = 1;
            on[n2] = 1;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (on[i] != 0) {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 51]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 51] = true;
            }
        }
        else {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 51]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 51] = false;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

// ■ 和平主义者（33）：「被处决的善良玩家可能不会死亡。」
//   **只有智能说书**才会自动掷（用户 2026-09-20）：掷中就在目标身上打「处决不死（和平主义者）」token(28)，
//   紧接着那条「处决不死」分支会把这次处决挡掉（公屏只播中性那句，原因写说书人私聊）。
//   真人说书**不掷**：想保谁就自己在他身上打「处决不死（和平主义者）」token，再点处决。
bool BOTC_PacifistSave (int q) {
    int i;
    int pf;
    int chance;
    int nextChance;
    if (q < 2 || q > 13) {
        return false;
    }
    return false;                            // 真人说书：不掷（自己打 token）
    pf = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_AbilityWorks(i, 33)) {
            pf = i;
        }
    }
    if (pf < 2) {
        return false;
    }
    if (BOTC_SeatDead(pf) || BOTC_SeatImpaired(pf)) {
        return false;
    }
    if (BOTC_SeatRegAlign(q) != 0) {
        BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(q) + " 按互动干扰算不是善良 → 这一次不判定。");
        return false;
    }
    // 概率（用户 2026-09-20）：**30% 起，每成功发动一次就 -10%，最低 5%**（30 → 20 → 10 → 5 → 5 ...）
    chance = 30 - (g_pacifistUsed * 10);
    if (chance < 5) {
        chance = 5;                              // 最低 5%：不会再往下掉（用户 2026-09-20）
    }
    if (RandomInt(1, 100) <= chance) {
        g_pacifistUsed = g_pacifistUsed + 1;
        nextChance = 30 - (g_pacifistUsed * 10);
        if (nextChance < 5) {
            nextChance = 5;
        }
        // 判定成功：自动给他打「处决不死（和平主义者）」标记（用户 2026-09-20）
        g_tokOn[(((g_teller * 14) + q) * 256) + 28] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(pf) + " 让被处决的 " + BOTC_NameStr(q) + " 活了下来。");
        return true;
    }
    BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(pf) + " 这次没有保住 " + BOTC_NameStr(q) + "，照常处决。");
    return false;
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 5 批】（用户 2026-09-20）：34 弄臣 / 35 修补匠 / 36 月之子
//==================================================================================================

// ■ 弄臣（34）：「你第一次死亡时，你不会死。」（自动生效；用掉之后打「失去能力（弄臣）」）
bool BOTC_FoolSave (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 34)) {
        return false;
    }
    if (g_foolUsed[q]) {
        return false;
    }
    g_foolUsed[q] = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 29] = false;       // 撤掉「首次未死」
    g_tokOn[(((g_teller * 14) + q) * 256) + 46] = true;        // 打上「失去能力（弄臣）」
    BOTC_GrimRender(g_teller);
    return true;
}

// 维护弄臣的两个标记：还留着第一次 → 「首次未死」亮着；用掉了 → 只留「失去能力（弄臣）」
void BOTC_FoolSync () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 34)) {
            continue;
        }
        if (g_foolUsed[i]) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 29]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 29] = false;
            }
        }
        else {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 29]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 29] = true;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

// ■ 修补匠（35）：「你可能随时死亡。」---- 智能说书每晚掷一次（真人说书自己决定）
//   用户 2026-09-20 定的默认：第 1 夜不掷，之后每晚 8%。
void BOTC_TinkerRoll () {
    int i;
    if (g_nightNum <= 1) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 35) || BOTC_SeatDead(i)) {
            continue;
        }
        if (RandomInt(1, 100) <= 8) {
            BOTC_MarkDeathQuietSrc(i, 1, 0, 35);
            BOTC_PmStore(g_teller, "修补匠（" + BOTC_NameStr(i) + "）今晚「随时死亡」掷中了 → 记成死亡（修补匠），天亮公布。");
        }
        else {
            BOTC_PmStore(g_teller, "修补匠（" + BOTC_NameStr(i) + "）今晚没死。");
        }
    }
}

// ■ 月之子（36）：「当你得知自己死亡时，公开选择一名存活玩家：如果他是善良的，他会在今晚死亡。」
//   触发点 = 他的死亡被公开的那一刻（天亮公布 / 白天被处决）。
//   智能说书直接随机挑一名存活玩家并按登记判善良；真人说书只私聊提醒，让他自己点【死亡标记】记那个人。
// 月之子死了（死亡公开）→ 提醒他自己去声称（用户 2026-09-20：改成玩家自己点，不再由智能说书替他选）
void BOTC_MoonChildCheck (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 36)) {
        return;
    }
    if (g_moonDone[q]) {
        return;
    }
    g_moonOpen[q] = true;
    g_moonWaitSeat = q;                // 【60 秒兜底】（用户 2026-09-21）
    g_moonWaitTick = 1;
    g_moonAskSt = false;
    // 【改成技能面板】（用户 2026-09-20）：公开死亡之后直接弹「选择技能目标（月之子）」，顺便把他的魔典摊开，
    //   他点一个座位 → 【确认】= 公开选人（跟以前「点头像」的效果一样：公屏播报 + 天亮结算）
    BOTC_SkillOpen(q);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
    BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(q) + " 死了 → 已打开他的技能面板。");
    BOTC_PmInfo(g_who[q], "【月之子】你已经死了：点一个存活玩家的座位（魔典上），再点【确认】---- 如果他是善良的，他会在今晚死亡。");
}

// 月之子（死后）声称 + 公开选人：点头像落在谁身上（用户 2026-09-20）
void BOTC_MoonChildDeclare (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(g_who[p], "现在是夜晚：月之子的公开选择等天亮再做，天亮了再点头像。");
        return;
    }
    if (!BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    g_moonDeclare[g_who[p]] = false;
    g_declarePick[g_who[p]] = false;
    BOTC_BigHintHide(g_who[p]);
    BOTC_DeclareRender();
    BOTC_PubAnnounce("【月之子】" + BOTC_NameStr(p) + " 公开声明自己是【月之子】，并选择 " + BOTC_NameStr(q) + "。");
    if (!BOTC_HasAbility(p, 36)) {
        BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(p) + " 只是声称 → 不结算。");
        return;
    }
    if (!BOTC_AbilityWorks(p, 36)) {
        g_moonDone[p] = true;
        BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次选择无效。");
        return;
    }
    if (g_moonDone[p]) {
        BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(p) + " 已经声明过一次了，这次不算。");
        return;
    }
    g_moonDone[p] = true;
    g_moonPick[p] = q;
    g_moonWaitSeat = 0;                // 他选完了，60 秒兜底停掉（用户 2026-09-21）
    g_moonWaitTick = 0;
    g_moonAskSt = false;
    g_moonBy = p;
    BOTC_PmStore(g_teller, "【月之子】已记下：" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(q) + "---- 今晚结算。");
}

void BOTC_MoonChildResolve () {
    int q;
    int v;
    q = g_moonBy;
    if (q < 1 || q > 13) {                // 允许 1：说书人自己那一格（-t 试技能）
        return;
    }
    v = g_moonPick[q];
    g_moonBy = 0;
    g_moonPick[q] = 0;
    if (v < 2 || v > 13) {
        return;
    }
    if (!BOTC_TargetIsLiving(v)) {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）已经死了，这次没有效果。");
        return;
    }
    if (!BOTC_RegIsGood(v)) {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）按互动干扰不是善良 → 不会死。");
        return;
    }
    if (BOTC_DeathBlocker(v, 1, 0, false) != "") {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）带着【" + BOTC_DeathBlocker(v, 1, 0, false) + "】，没有死。");
        return;
    }
    BOTC_MarkDeathQuietSrc(v, 1, 0, 36);
    BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(v) + " 是善良的 → 今晚死亡。");
}

//==================================================================================================
//==================================================================================================
// 【梦殒春宵 · 第 2 批】（用户 2026-09-21）：59 贤者的触发 / 61 心上人 / 62 理发师 / 63 呆瓜
//   放置与移除时机一律按官方（用户 2026-09-21 特意交代）：
//     心上人 → 醉酒标记「他死时放、离场时撤」；理发师 → 「今晚理发」死时放、恶魔交换或放弃后撤；贤者 → 无标记。
//==================================================================================================

// ■ 贤者（59）：「如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。」
//   面板复用「填两个座位号」（kind = 2）；脚本把「真恶魔 + 一个陪衬」先填进去，说书人可以直接确定或改掉。
//   他中毒 / 酒鬼时官方该给假情报（一名已死玩家 + 一名存活善良玩家）---- 脚本只把真话写进提示行，填什么由说书人决定。
void BOTC_SageOpen (int q, bool viaLevi) {
    int i;
    int dm;
    int filler;
    string s;
    dm = 0;
    filler = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (viaLevi) {
        dm = BOTC_LeviathanRoleHolder();       // 相克触发时，正确答案必须指向利维坦本人
    }
    else {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                dm = i;                          // 杀死他的那只恶魔（真身是恶魔的座位）
            }
        }
    }
    // 陪衬：优先挑一个活着的善良玩家；没有就随便挑一个别的座位
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == q || i == dm) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatAlign(i) != 0) { continue; }
        filler = i;
    }
    if (filler < 2) {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i] || i == q || i == dm) { continue; }
            filler = i;
        }
    }
    if (viaLevi) {
        BOTC_ManInfoOpenSeats(q, "【贤者×利维坦】左边填一个人，右边填另一个人（其中一个是利维坦）", 2);
    }
    else {
        BOTC_ManInfoOpenSeats(q, "【贤者】左边填一个人，右边填另一个人（其中一个是杀死他的恶魔）", 2);
    }
    if (dm >= 2) {
        libNtve_gf_SetDialogItemText(g_miEdit, StringToText(IntToString(dm - 1)), PlayerGroupSingle(g_teller));
    }
    if (filler >= 2) {
        libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(IntToString(filler - 1)), PlayerGroupSingle(g_teller));
    }
    s = "正确答案→（";
    if (dm >= 2) {
        s = s + BOTC_NameStr(dm) + " 是恶魔";
    }
    else {
        s = s + "场上没有恶魔";
    }
    s = s + "）";
    if (BOTC_SeatImpaired(q)) {
        s = s + "　他处于醉酒/中毒：官方的假情报是「一名已死玩家 + 一名存活善良玩家」，脚本不替你改，自己填。";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    if (viaLevi) {
        BOTC_PmStore(g_teller, "【贤者×利维坦】" + BOTC_NameStr(q) + " 的能力被利维坦相克触发 → 已打开「填两个玩家」的框。");
    }
    else {
        BOTC_PmStore(g_teller, "【贤者】" + BOTC_NameStr(q) + " 被恶魔杀死 → 已打开「填两个玩家」的框（左边默认填了真恶魔）。");
    }
}

// ■ 心上人（61）：「当你死亡时，会有一名玩家开始醉酒。」
//   官方提示标记 = 醉酒：放置时机「他死时」、移除时机「他离场时」→ 普通死亡不撤，换身份（离场）才撤。
void BOTC_SweetDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 61)) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 61)) {
        BOTC_PmStore(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了，但他中毒/酒鬼 → 这一次能力失效，谁都不会醉酒。");
        return;
    }
    g_sweetSeat = q;
    g_sweetPick = true;
    // 【统一模板】（用户 2026-09-21）：跟月之子 / 呆瓜 一样，走「技能面板 + 点座位 + 确认」那一套。
    //   这一步由**说书人**操作（官方：由说书人选择哪名玩家醉酒），所以面板开在说书人自己那一格。
    g_sweetBySt = true;
    BOTC_SkillOpen(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了：在下面对话框里点一个座位，再点【确定】。");
    BOTC_PmStore(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了 → 等你选那个要醉酒的人（选完自动打「醉酒（心上人）」标记）。");
}

// 心上人：说书人点头像选中谁（跟处决标记同一套点头像流程）
void BOTC_SweetPickAt (int q) {
    int i;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return;
    }
    g_sweetPick = false;
    BOTC_BigHintHide(g_teller);
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 82] = false;      // 一局只有一次，保险起见先收掉旧的
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 82] = true;
    g_sweetDrunk = q;
    BOTC_GrimRender(g_teller);
}

// ■ 呆瓜（63）：「当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。」
void BOTC_KlutzCheck (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 63)) {
        return;
    }
    if (g_klutzDone[q]) {
        return;
    }
    if (q == g_klutzWaitSeat) {           // 【别重复弹】（用户 2026-10-17）：同一次死亡会被「死亡 token / 红叉 / 死亡公开」连着调好几次
        return;                           //   原来每调一次都重开面板 → 玩家被要求点第二次人、已选的目标也被清掉
    }
    if (g_klutzDeclare[g_who[q]]) {       // 已经走「声称呆瓜 → 点头像」那条了：别再弹技能面板
        return;
    }
    if (!BOTC_AbilityWorks(q, 63)) {
        g_klutzDone[q] = true;
        BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 这次公开选择不结算。");
        return;
    }
    g_klutzWaitSeat = q;
    g_klutzWaitTick = 1;
    g_klutzAskSt = false;
    BOTC_SkillOpen(q);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
    BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(q) + " 公开死亡 → 已打开他的技能面板（跟月之子同一套）。");
    BOTC_PmInfo(g_who[q], "【呆瓜】你已经死了：点一名存活玩家的座位（魔典上），再点【确认】---- 如果他是邪恶的，你的阵营落败。");
}

// 呆瓜：确认选人（他自己点的；说书人超时代选的也走这里）
void BOTC_KlutzPick (int p, int q) {
    int align;
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_HasAbility(p, 63)) {
        if (q >= 2 && q <= 13 && g_seatOn[q] && !BOTC_SeatDead(q) && !g_klutzDone[p]) {
            g_klutzDone[p] = true;
            g_klutzDeclare[g_who[p]] = false;
            g_declarePick[g_who[p]] = false;
            BOTC_DeclareRender();
            BOTC_PubAnnounce("【呆瓜】" + BOTC_NameStr(p) + " 声称自己是呆瓜，并公开选择 " + BOTC_NameStr(q) + "。");
            BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(p) + " 声称呆瓜并公开选择 " + BOTC_NameStr(q) + "（他不是真呆瓜，胜负你自己判）。");
        }
        return;
    }
    if (!BOTC_AbilityWorks(p, 63)) {
        g_klutzDone[p] = true;
        BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(p) + " 的能力失效 → 这次公开选择不结算。");
        return;
    }
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_PmStore(g_teller, "【呆瓜】没有选到有效玩家，这一次不结算。");
        return;
    }
    if (!BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    if (g_klutzDone[p]) {
        return;
    }
    g_klutzDone[p] = true;
    g_klutzPick[p] = q;
    g_klutzWaitSeat = 0;
    g_klutzWaitTick = 0;
    g_klutzAskSt = false;
    // 【选完就收】（用户 2026-10-17）：技能面板 / 声称后的「点头像」阶段一起收掉，不会再冒出第二次点人
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_klutzDeclare[g_who[p]] = false;
    g_declarePick[g_who[p]] = false;
    BOTC_DeclareRender();
    BOTC_PubAnnounce("【呆瓜】" + BOTC_NameStr(p) + " 公开选择 " + BOTC_NameStr(q) + "。");
    BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(q) + "（按真身阵营判）。");
    if (BOTC_SeatAlign(q) == 1) {
        align = BOTC_SeatAlign(p);
        if (align == 0) {
            BOTC_ShowWin(1, "人们会一直相信智者" + BOTC_NameStr(p) + "的担保的，", "恶魔什么的不过是愚者的臆想罢了......吗？");
        }
        else {
            BOTC_ShowWin(0, "人们会一直相信智者" + BOTC_NameStr(p) + "的担保的，", "恶魔什么的不过是愚者的臆想罢了......吗？");
        }
        return;
    }
}

// 呆瓜：60 秒没选 → 说书人替他选（⚠ 代替那个玩家选，不是「说书人自己声称呆瓜」）
void BOTC_KlutzForce (int q) {
    int p;
    p = g_klutzWaitSeat;
    if (p < 2 || p > 13 || q < 2 || q > 13) {
        return;
    }
    g_klutzAskSt = false;
    BOTC_PmStore(g_teller, "【呆瓜】超时：说书人替 " + BOTC_NameStr(p) + " 选择 " + BOTC_NameStr(q) + "（按他自己的选择处理）。");
    BOTC_KlutzPick(p, q);
}

// 【认知覆盖：换身份时整包跟着走】（用户 2026-10-19）：
//   4 个认知覆盖 ---- 酒鬼(14) token 8 / 疯子(38) token 49 / 提线木偶(93) token 118 / 悟道者(118) token 140。
//   被「换身份」时，要把他「以为的身份」（魔典上那张卡）+ 那枚认知 token 一起换给对面；
//   对面拿到的是「他以为的那张卡」（比如哲学家），不是「酒鬼 / 提线木偶」本体。
int BOTC_CogTokOf (int tr) {
    if (tr == 14) { return 8; }
    if (tr == 38) { return 49; }
    if (tr == 93) { return 118; }
    if (tr == 118) { return 140; }
    return -1;
}

void BOTC_PutCogCover (int q, int card, int tok) {
    if (q < 2 || q > 13 || card < 0 || card > 148 || tok < 0) {
        return;
    }
    g_mark[(g_teller * 14) + q] = card + 1;
    g_mark[(g_who[q] * 14) + q] = BOTC_PlayerRoleView(q, card) + 1;
    g_tokOn[(((g_teller * 14) + q) * 256) + tok] = true;
}

// ■ 理发师（62）：「如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。」
//   官方提示标记「今晚理发」：放置时机 = 他死时（未醉/中毒）；移除时机 = 恶魔交换或放弃之后。
void BOTC_BarberDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 62)) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 62)) {
        BOTC_PmStore(g_teller, "【理发师】" + BOTC_NameStr(q) + " 死了，但他中毒/酒鬼 → 这一次不交换角色。");
        return;
    }
    g_barberSeat = q;
    g_barberWait = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 92] = true;
    BOTC_GrimRender(g_teller);
}

// 理发师：轮到他那一格 ---- 【用户 2026-09-21】这一步实际是「再次唤醒恶魔」，理发师本人不醒
void BOTC_BarberOpen (int q) {
    int dm;
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 92]) {
        return;
    }
    dm = BOTC_FindDemon();
    if (dm < 2) {
        BOTC_PmStore(g_teller, "【理发师】场上没有活着的恶魔 → 这一步跳过（没人交换）。");
        return;
    }
    g_barberFrom = dm;
    BOTC_SkillOpen(dm);
    libNtve_gf_SetDialogItemText(g_skillTitle[dm], StringToText("选择两名玩家"), PlayerGroupSingle(g_who[dm]));
    BOTC_Notice(g_teller, "【理发师】已再次唤醒 " + BOTC_NameStr(dm) + " 恶魔：选两名玩家交换角色（【取消】= 放弃交换）。");
    BOTC_PmStore(g_teller, "【理发师】已打开 " + BOTC_NameStr(dm) + " 的交换面板：选两名玩家（不能选其他恶魔，选自己可以），【确认】交换、【取消】放弃。");
    if (BOTC_SeatIsComputer(dm)) {
        BOTC_TestAutoSkill(dm);
    }
}

// 理发师：真的交换两个人的角色（阵营不变 → 用「善良 / 邪恶」token 保住）
//   p = 那只被再次唤醒的恶魔（不是理发师）；「今晚理发」标记打在理发师自己那一格
void BOTC_BarberSwap (int p, int a, int b) {
    int ra;
    int rb;
    int aa;
    int ab;
    int cogA;
    int cogB;
    int cardA;
    int cardB;
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        BOTC_Notice(g_teller, "理发师：要选两个不同的玩家。");
        return;
    }
    if (!g_seatOn[a] || !g_seatOn[b]) {
        BOTC_Notice(g_teller, "理发师：这两个座位里有人不在场。");
        return;
    }
    ra = BOTC_SeatTrueRole(a);
    rb = BOTC_SeatTrueRole(b);
    if (ra < 0 || rb < 0) {
        BOTC_Notice(g_teller, "理发师：这两个座位里有人还没定身份。");
        return;
    }
    // 【相克 · 理发师 × 落难少女】（用户 2026-10-03）：交换到落难少女 → 不自动换，改由说书人指定谁变落难少女
    if (ra == 82 || rb == 82) {
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【相克】理发师交换到落难少女：请手动决定谁变成落难少女（点魔典座位 → 身份网格 → 选【落难少女】）。");
        return;
    }
    aa = BOTC_SeatAlign(a);
    ab = BOTC_SeatAlign(b);
    // 【认知覆盖整包跟着换】（用户 2026-10-19）：先记下两人「以为的身份 / 那枚 token」
    cogA = BOTC_CogTokOf(ra);
    cogB = BOTC_CogTokOf(rb);
    cardA = g_mark[(g_teller * 14) + a] - 1;
    cardB = g_mark[(g_teller * 14) + b] - 1;
    BOTC_SetSeatRole(g_teller, a, rb);
    BOTC_SetSeatRole(g_teller, b, ra);
    if (cogB >= 0) {
        BOTC_PutCogCover(a, cardB, cogB);
    }
    if (cogA >= 0) {
        BOTC_PutCogCover(b, cardA, cogA);
    }
    BOTC_SeatStateSync();
    // 阵营不变：只有当「换过来的那张身份自带阵营」跟原来的阵营不一样时，才需要打「善良(14) / 邪恶(15)」
    //   token 去把它钉住（跟麻脸巫婆改造同一套口径，用户 2026-09-21：同阵营就不用打）
    if (BOTC_RoleAlign(rb) != aa) {
        if (aa == 1) { g_tokOn[(((g_teller * 14) + a) * 256) + 15] = true; }
        else { g_tokOn[(((g_teller * 14) + a) * 256) + 14] = true; }
    }
    if (BOTC_RoleAlign(ra) != ab) {
        if (ab == 1) { g_tokOn[(((g_teller * 14) + b) * 256) + 15] = true; }
        else { g_tokOn[(((g_teller * 14) + b) * 256) + 14] = true; }
    }
    if (g_barberSeat >= 2) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;      // 官方：能力结算完撤掉「今晚理发」
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[a]);
    BOTC_GrimRender(g_who[b]);
    BOTC_SkillBtnRender();
    if (g_skillPicking[a]) {
        BOTC_SkillRender(a);
    }
    if (g_skillPicking[b]) {
        BOTC_SkillRender(b);
    }
    BOTC_PmStore(g_teller, "【理发师】恶魔（" + BOTC_NameStr(p) + "）交换了 " + BOTC_NameStr(a) + "（原 " + BOTC_RoleNameSafe(ra) + "）和 " + BOTC_NameStr(b) + "（原 " + BOTC_RoleNameSafe(rb) + "）的角色，阵营不变。");
    if (cogB >= 0) {
        BOTC_ChangeRoleMsg(a, cardB);       // 拿到认知覆盖：只说「他以为的身份」
    }
    else {
        BOTC_ChangeRoleMsg(a, rb);
    }
    if (cogA >= 0) {
        BOTC_ChangeRoleMsg(b, cardA);
    }
    else {
        BOTC_ChangeRoleMsg(b, ra);
    }
    // 【收面板】（用户 2026-09-21）：交换完把恶魔那块技能面板关掉，不然它一直挂在屏幕上
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

// 理发师：恶魔放弃交换（p = 那只恶魔）
void BOTC_BarberDecline (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_barberSeat >= 2) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【理发师】恶魔（" + BOTC_NameStr(p) + "）放弃交换 → 撤掉「今晚理发」标记。");
}

// ■ 月之子（36）超时兜底：说书人替他选
//   ⚠ 这是「代替那个玩家选」，**不是**说书人自己声称月之子：不播声称那句、也不走 BOTC_MoonChildDeclare
void BOTC_MoonChildForce (int v) {
    int p;
    p = g_moonWaitSeat;
    if (p < 2 || p > 13 || v < 2 || v > 13) {
        return;
    }
    if (g_moonDone[p]) {
        return;
    }
    g_moonAskSt = false;
    g_moonWaitSeat = 0;
    g_moonWaitTick = 0;
    g_moonDone[p] = true;
    g_moonPick[p] = v;
    g_moonBy = p;
    BOTC_PmStore(g_teller, "【月之子】超时：说书人替 " + BOTC_NameStr(p) + " 选择 " + BOTC_NameStr(v) + "（按他自己选的处理，不是说书人声称月之子）。");
}

// 【死后选人 60 秒兜底】（用户 2026-09-21）：挂在 0.5 秒一拍的 BOTC_Tick_Func 上，计数 >= 120 就是 60 秒
void BOTC_DeadPickTimeout () {
    if (g_moonWaitTick > 0) {
        g_moonWaitTick = g_moonWaitTick + 1;
        if (g_moonWaitTick >= 120) {
            g_moonWaitTick = 0;
            if (g_moonWaitSeat >= 2 && !g_moonDone[g_moonWaitSeat] && !g_moonAskSt) {
                g_moonAskSt = true;
                BOTC_Notice(g_teller, "【月之子】60 秒没有选 → 点魔典上的一个座位替他选（选完按他自己选的处理）。");
                BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(g_moonWaitSeat) + " 超时未选 → 已切成「说书人点头像替他选」。");
            }
        }
    }
    if (g_klutzWaitTick > 0) {
        g_klutzWaitTick = g_klutzWaitTick + 1;
        if (g_klutzWaitTick >= 120) {
            g_klutzWaitTick = 0;
            if (g_klutzWaitSeat >= 2 && !g_klutzDone[g_klutzWaitSeat] && !g_klutzAskSt) {
                g_klutzAskSt = true;
                BOTC_Notice(g_teller, "【呆瓜】60 秒没有选 → 点魔典上的一个座位替他选（选完按他自己选的处理）。");
                BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(g_klutzWaitSeat) + " 超时未选 → 已切成「说书人点头像替他选」。");
            }
        }
    }
}
//==================================================================================================

// ■ 莽夫（37）：「每个夜晚，首个使用其自身能力选择了你的玩家会醉酒直到下个黄昏。你会转变为他的阵营。」
//   只算**夜间技能**（用户 2026-09-20 定）；同一个夜晚只有第一个算。阵营转变走**登记层**（互动干扰那一层）。
// 【莽夫的「选他的人」算哪个阵营】（用户 2026-09-20）：
//   普通玩家走登记层（间谍 / 陌客这种被看成别的阵营时就算那个）；
//   说书人自己那一格（-t 试技能，座位 1）登记层没有他的位置，就用他真身的阵营。
int BOTC_GoonChooserAlign (int p) {
    int a;
    if (p < 1 || p > 13) {
        return 0;
    }
    a = -1;
    if (p >= 2) {
        a = BOTC_SeatRegAlign(p);
    }
    if (a < 0) {
        a = BOTC_SeatAlign(p);
    }
    if (a < 0) {
        a = 0;
    }
    return a;
}

// 【「这一下」的醉酒是不是只有莽夫那一份】（用户 2026-09-20）：
//   p 是今夜第一个选中莽夫的人（g_goonBy == p），而且他身上除了「醉酒（莽夫）」没有别的中毒 / 醉酒来源。
//   这种情况下，莽夫那一下只挡「打莽夫自己」的那一部分，打别的目标照旧生效 ----
//   例：沙巴洛斯选「目标1 = 别人、目标2 = 莽夫」→ 莽夫不会被吃，目标1 照常死。
bool BOTC_GoonDrunkOnly (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_goonBy != p) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + p) * 256) + 61]) {
        return false;                      // 连「醉酒（莽夫）」都没有：不是这一下
    }
    if (BOTC_SeatIsPoisoned(p)) {
        return false;                      // 还中着毒
    }
    if (BOTC_SeatTrueRole(p) == 14) {
        return false;                      // 真身是酒鬼
    }
    // 【除了「醉酒（莽夫）61」以外的任何醉酒来源 → 都算「不止莽夫那一份」】（用户 2026-10-14 补全）----
    //   这份清单必须跟 BOTC_SeatIsDrunk() 对齐：之前漏了 82 心上人 / 90 哲学家 / 126 村夫 / 129 解谜大师，
    //   以及「哲学家选中的那个人」（BOTC_PhiloDrunkSeat）；漏了就会把「61 + 别的一份」误判成「只有莽夫那一份」。
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 24]) {
        return false;                      // 通用「醉酒」那一格
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 59] || g_tokOn[(((g_teller * 14) + p) * 256) + 60] || g_tokOn[(((g_teller * 14) + p) * 256) + 62]) {
        return false;                      // 水手 / 旅店老板 / 吟游诗人 也醉了他
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 53] || g_tokOn[(((g_teller * 14) + p) * 256) + 54] || g_tokOn[(((g_teller * 14) + p) * 256) + 55]) {
        return false;                      // 侍臣的三天三夜
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 82] || g_tokOn[(((g_teller * 14) + p) * 256) + 90]) {
        return false;                      // 醉酒（心上人 82）/ 醉酒（哲学家 90）
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 126] || g_tokOn[(((g_teller * 14) + p) * 256) + 129]) {
        return false;                      // 醉酒（村夫 126 / 解谜大师 129）
    }
    if (p == BOTC_PhiloDrunkSeat()) {
        return false;                      // 哲学家选中的那个角色的持有者（token 还没同步过来也算，跟 BOTC_SeatIsDrunk 一致）
    }
    return true;
}

void BOTC_GoonTouch (int chooser, int target) {
    int g;
    int ca;
    if (chooser < 1 || chooser > 13 || target < 2 || target > 13) {
        return;
    }
    if (!BOTC_HasAbility(target, 37)) {
        return;
    }
    if (BOTC_SeatDead(target)) {
        return;
    }
    if (g_goonBy != 0) {
        return;                                  // 今夜已经有人触发过了：只有第一个算
    }
    g = target;
    g_goonSeat = g;
    g_goonBy = chooser;
    g_tokOn[(((g_teller * 14) + chooser) * 256) + 61] = true;  // 醉酒（莽夫）：选他的人醉酒（到明天黄昏，黄昏自动清）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【莽夫】今夜第一个用夜间技能选中莽夫（" + BOTC_NameStr(g) + "）的是 " + BOTC_NameStr(chooser) + " → 他醉酒到明天黄昏。");
    BOTC_PmStore(g_teller, "【莽夫】这一下是**当场结算**的：他这一夜的能力立刻失效，所以别再把他的技能效果算进去。");
    // 【莽夫记的是「今夜第一个选他那个人的阵营」】（用户 2026-09-20）：
    //   这里直接按那个人的阵营算（不再回头读登记层缓存 ---- 之前读缓存会拿到旧值，
    //   所以「自动打邪恶 token」永远走不到，反而把 token 撤掉）。
    ca = BOTC_GoonChooserAlign(chooser);
    if (ca == 0 && BOTC_BoffinMustStayEvil(g)) {
        ca = 1;
        BOTC_PmStore(g_teller, "【科学怪人 × 莽夫】恶魔借到的是莽夫能力：即使被善良玩家选中，也不能转为善良阵营，保留邪恶。");
    }
    if (BOTC_SeatRegAlign(g) == ca) {
        BOTC_PmStore(g_teller, "【莽夫】" + BOTC_NameStr(g) + " 本来就是 " + BOTC_AlignName(ca) + " 阵营 → 阵营没变，不提示他。");
    }
    else {
        BOTC_SetReg(g, -1, ca);
        BOTC_PmStore(g_teller, "【莽夫】" + BOTC_NameStr(g) + " 的阵营随之变成 " + BOTC_AlignName(ca) + "。");
        if (ca == 1) {
            BOTC_PmInfo(g_who[g], "【莽夫】你转变为邪恶阵营。");
        }
        else {
            BOTC_PmInfo(g_who[g], "【莽夫】你转变为善良阵营。");
        }
    }
    // 【善良 / 邪恶 token】：转邪恶 → 打「邪恶」；变回善良 → 把「邪恶」撤掉。
    if (ca == 1) {
        g_tokOn[(((g_teller * 14) + g) * 256) + 15] = true;         // 邪恶
        g_tokOn[(((g_teller * 14) + g) * 256) + 14] = false;        // 别两个都挂着
        BOTC_ClaimBtnRender();        // 真身变邪恶了：邪恶那个【伪装身份】按钮跟着刷出来
    }
    else {
        g_tokOn[(((g_teller * 14) + g) * 256) + 15] = false;
        BOTC_PmStore(g_teller, "【莽夫】已把 " + BOTC_NameStr(g) + " 身上的「邪恶」token 撤掉。");
    }
    BOTC_PairClearSeat(g);            // 真身阵营刚变 → 登记层缓存作废，技能立刻按新的算
    BOTC_GrimRender(g_teller);
}

// ■ 教父（39）：「今天有外来者死亡」才能在当晚杀人（按互动干扰算外来者）
bool BOTC_GodfatherCanKill () {
    int q;
    if (g_dayNum <= 0) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum) {
            continue;
        }
        if (BOTC_SeatRegTeam(q) == 1) {
            return true;                         // 今天死的这个人（按互动干扰）算外来者
        }
    }
    return false;
}

// ■ 疯子（38）的假爪牙名单（首夜给）：大概率是真的邪恶玩家，小概率掺一个假的；教父在场时优先出现
int BOTC_PmInfoDemons (string s) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 3) {
            continue;
        }
        BOTC_PmInfo(g_who[i], s);
        n = n + 1;
    }
    return n;
}

void BOTC_LunaticInfo () {
    int lu;
    lu = BOTC_RealLunaticSeat();       // 哲学家假装的疯子不参与真疯子首夜信息
    if (lu < 2) {
        return;
    }
    // 【官网夜序第 15 位】先给疯子假的「爪牙」信息；说书人可填 1~4 个座位，
    // 也可以留空 / 掺假。真正的恶魔要到第 17 位恶魔信息完成之后才得知谁是疯子。
    BOTC_ManInfoOpenSeats(lu, "【疯子】填爪牙1~4；点【取消】= 不发送（可用于罂粟局）", 0);
    BOTC_PmStore(g_teller, "【疯子】给他最多四个「爪牙」，可以掺假，也可以留空。");
}

// 【邪恶互认完成后】告诉所有真恶魔谁是疯子；一局只发一次。
void BOTC_NotifyDemonsLunatic () {
    int lu;
    int n;
    if (g_lunaticIdentitySent) {
        return;
    }
    lu = BOTC_RealLunaticSeat();
    if (lu < 2) {
        return;
    }
    n = BOTC_PmInfoDemons("【信息】你得知" + BOTC_NameStr(lu) + "是疯子。");
    if (n > 0) {
        g_lunaticIdentitySent = true;
        BOTC_PmStore(g_teller, "【疯子】邪恶互认完成：已告诉所有恶魔，本局疯子是 " + BOTC_NameStr(lu) + "。");
    }
}

// ■ 疯子（38）今晚「杀」了谁：写给说书人 + 告诉真恶魔
//   疯子真的行动（BOTC_SkillConfirm 那一支）、说书人手动打「被选择（疯子）」token 都会调它。
void BOTC_LunaticPickNotify (int q) {
    int i;
    int lu;
    int dm;
    if (q < 2 || q > 13) {
        return;
    }
    lu = BOTC_LunaticActingSeat();       // 今晚真动手的那个疯子（真疯子优先、要清醒），用户 2026-09-21
    dm = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
            dm = i;
        }
    }
    if (lu >= 2) {
        BOTC_PmStore(g_teller, "【疯子】疯子选择了" + BOTC_NameStr(q) + "，不产生死亡。");
    }
    else {
        BOTC_PmStore(g_teller, "【疯子】本局没有疯子，但 " + BOTC_NameStr(q) + " 身上被打了「被选择（疯子）」标记。");
    }
    if (dm >= 2) {
        // 用户 2026-09-20 二次修改：不管智能还是真人说书，都由脚本**直接私聊恶魔**；
        //   疯子中毒 / 酒鬼时**什么都不发**（用户 2026-09-21 的最终口径），只给说书人记一行。
        if (lu >= 2 && BOTC_SeatImpaired(lu)) {
            // 【疯子没做出选择就不提示】（用户 2026-09-21）：恶魔什么都不会收到
            BOTC_PmStore(g_teller, "【疯子】疯子（" + BOTC_NameStr(lu) + "）中毒/酒鬼 → 这一次没有发送给恶魔；他实际选择了 " + BOTC_NameStr(q) + "，这条别外传。");
        }
        else {
            BOTC_PmInfoDemons("【信息】疯子选择了" + BOTC_NameStr(q) + "。");
            BOTC_PmStore(g_teller, "【疯子】已直接私聊告诉所有恶魔：疯子选择了" + BOTC_NameStr(q) + "。");
        }
    }
}

// 【唤醒之后「跟他进私聊」统一走这一个函数】（用户 2026-10-16）：
//   这套动作（建 1:1 + 把说书人的聊天切成私聊 + 刷新会话列表）原来在【唤醒下一个】、
//   【手动唤醒】、教父首夜信息 三个地方各抄了一份，漏一处就是「某个角色被唤醒却不进私聊」。
//   · 已经在跟他同一条私聊里 → 不重建（省掉「退出 / 重新建立」那串播报），只把说书人的聊天切到私聊；
//   · 不在 → 建一条 1:1；
//   · 兜底：13 条私聊位子全被占着、建不出来时，先拆一条「说书人不在里面」的腾位子，再建一次。
void BOTC_TellerPmTo (int seat) {
    int other;
    int s;
    int i;
    int j;
    if (seat < 2 || seat > 13) {
        return;
    }
    other = g_who[seat];
    if (other < 1 || other > 13) {
        return;
    }
    s = g_mySess[g_teller];
    if (!(s >= 1 && s <= 13 && g_sessAlive[s] && g_member[(s * 14) + other])) {
        BOTC_CreateSess(g_teller, other);
    }
    if (g_mySess[g_teller] == 0) {                 // 建不出来（位子满了）→ 拆一条腾位子再建一次
        for (i = 1; i <= 13; i += 1) {
            if (!g_sessAlive[i]) {
                continue;
            }
            if (g_member[(i * 14) + g_teller]) {
                continue;
            }
            for (j = 1; j <= 13; j += 1) {
                if (g_member[(i * 14) + j]) {
                    g_member[(i * 14) + j] = false;
                    if (g_mySess[j] == i) {
                        g_mySess[j] = 0;
                    }
                }
            }
            g_sessAlive[i] = false;
            g_joinPending[i] = false;
            g_joinWho[i] = 0;
            if (i == g_lmSess) {
                g_lmSess = 0;
            }
            break;
        }
        BOTC_CreateSess(g_teller, other);
    }
    g_chatSay[g_teller] = 1;
    BOTC_SayRender(g_teller);
    BOTC_RefreshSessListAll();
    BOTC_ManInfoReShow();
}

void BOTC_WakeRender () {
    DialogControlSetVisible(g_wakeBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_recogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn, PlayerGroupAll(), false);
    if (g_pdBtn > 0) {
        DialogControlSetVisible(g_pdBtn, PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_wakeBtn, PlayerGroupSingle(g_teller), g_isNight);
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupSingle(g_teller), g_isNight);
    // 【说书人工具】与测试总开关解耦：正式开局后昼夜都给说书人保留。
    DialogControlSetVisible(g_recogBtn, PlayerGroupSingle(g_teller), g_started || g_isNight);
    DialogControlSetVisible(g_specBtn, PlayerGroupSingle(g_teller), g_started || g_isNight);
    if (g_pdBtn > 0) {
        DialogControlSetVisible(g_pdBtn, PlayerGroupSingle(g_teller), g_isNight && g_pdRole > 0);
        if (g_pdRole > 0 && g_pdRole <= 148) {
            libNtve_gf_SetDialogItemText(g_pdBtn, StringToText("说书人：" + g_roleName[g_pdRole - 1]), PlayerGroupSingle(g_teller));
        }
    }
    if (!g_isNight) {
        g_wakeMode = false;
        g_wakeChoiceSeat = 0;
        DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    }
    if (g_wakeMode) {
        libNtve_gf_SetDialogItemText(g_wakeManualBtn, StringToText("手动唤醒：点座位"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_wakeManualBtn, StringToText("手动唤醒"), PlayerGroupSingle(g_teller));
    }
    BOTC_BuildSeatList();
    if (g_autoOn) {
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("唤醒下一个"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("开始唤醒"), PlayerGroupSingle(g_teller));
    }
    BOTC_BigHintHide(g_teller);
}

void BOTC_WakeManualToggle () {
    if (!g_isNight) {
        BOTC_Notice(g_teller, "白天不能唤醒：先点【进入夜晚】，夜里才唤醒。");
        return;
    }
    // 【军团】疯子屏蔽框还没答完：先处理那个框（用户 2026-09-30）
    if (BOTC_LegionPendBlock()) {
        return;
    }
    if (g_wakeMode) {
        g_wakeMode = false;
        g_wakeChoiceSeat = 0;
        DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
        BOTC_Notice(g_teller, "已退出【手动唤醒】：点座位不再唤醒 / 收回。");
    }
    else {
        g_wakeMode = true;
        BOTC_Notice(g_teller, "【手动唤醒】：点一个座位唤醒他，再点一次收回；再按一次这个按钮退出。");
    }
    BOTC_WakeRender();
}

int BOTC_WakeAbilityChoiceBuild (int q) {
    int own;
    int grant;
    int b;
    int n;
    n = 0;
    g_wakeChoiceSeat = q;
    if (q < 2 || q > 13) {
        return 0;
    }
    own = g_mark[(g_teller * 14) + q] - 1;
    // 手动唤醒不受自动夜序 / 行动类别限制：本体与手工赋予的能力都应可选。
    if (own >= 0 && own <= 148) {
        g_wakeChoiceSource[0] = 0;
        g_wakeChoiceRole[0] = own;
        n = 1;
    }
    // 说书人手工赋予的附加能力：即使标记为醉酒，也仍然列入选择，只是执行时无效。
    if (n < 6 && g_grantRoleBy[q] > 0 && g_grantRoleBy[q] <= 148) {
        grant = g_grantRoleBy[q] - 1;
        if (grant != own) {
            g_wakeChoiceSource[n] = -1;
            g_wakeChoiceRole[n] = grant;
            n = n + 1;
        }
    }
    if (n < 6 && BOTC_BoffinNestedWakeSource(q) >= 2) {
        g_wakeChoiceSource[n] = -3;
        g_wakeChoiceRole[n] = g_bnestRoleBy[BOTC_BoffinNestedWakeSource(q)] - 1;
        n = n + 1;
    }
    for (b = 2; b <= 13 && n < 6; b += 1) {
        if (BOTC_BoffinRoleOrderForSource(b, q) <= 0) {
            continue;
        }
        g_wakeChoiceSource[n] = b;
        g_wakeChoiceRole[n] = g_boffinRoleBy[b] - 1;
        n = n + 1;
    }
    return n;
}

void BOTC_BuildWakeChoice () {
    int i;
    int x;
    DialogCreate(1360, 300, c_anchorCenter, 0, -70, false);
    g_wakeChoiceDlg = DialogLastCreated();
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    g_wakeChoiceTitle = BOTC_NewLabelC(g_wakeChoiceDlg, 1320, 34, 20, 10, StringToText("选择能力"));
    libNtve_gf_SetDialogItemStyle(g_wakeChoiceTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceTitle, false, PlayerGroupAll());
    for (i = 0; i < 6; i += 1) {
        x = 20 + (i * 215);
        g_wakeChoiceBtn[i] = BOTC_NewButton(g_wakeChoiceDlg, 200, 180, x, 52, "");
        libNtve_gf_CreateDialogItemImage(g_wakeChoiceDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_wakeChoiceIcon[i] = DialogControlLastCreated();
        DialogControlSetSize(g_wakeChoiceIcon[i], PlayerGroupAll(), 112, 112);
        DialogControlSetPosition(g_wakeChoiceIcon[i], PlayerGroupAll(), c_anchorTopLeft, x + 44, 62);
        libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceIcon[i], false, PlayerGroupAll());
        g_wakeChoiceName[i] = BOTC_NewLabelC(g_wakeChoiceDlg, 200, 26, x + 2, 182, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_wakeChoiceName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceName[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupAll(), false);
    }
    g_wakeChoiceCancel = BOTC_NewButton(g_wakeChoiceDlg, 200, 40, 580, 240, "取消");
    DialogControlSetVisible(g_wakeChoiceCancel, PlayerGroupAll(), true);
}

void BOTC_WakeAbilityChoicePick (int idx) {
    int seat;
    int src;
    seat = g_wakeChoiceSeat;
    if (idx < 0 || idx > 5 || seat < 2 || seat > 13) {
        return;
    }
    src = g_wakeChoiceSource[idx];
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), false);
    g_wakeChoiceSeat = 0;
    if (src >= 2) {
        g_boffinActing[seat] = true;
        g_boffinActingSource[seat] = src;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    else if (src == -1) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = true;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    else if (src == -3) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = true;
        g_bnestSource[seat] = BOTC_BoffinNestedWakeSource(seat);
    }
    else {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    BOTC_WakeManualApply(seat);
}

void BOTC_WakeAbilityChoiceCancel () {
    int seat;
    seat = g_wakeChoiceSeat;
    if (seat >= 2 && seat <= 13) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    g_wakeChoiceSeat = 0;
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), false);
    BOTC_Notice(g_teller, "已取消这次能力选择。");
}

void BOTC_WakeAbilityChoiceOpen (int q) {
    int i;
    int n;
    int role;
    if (q < 2 || q > 13) {
        return;
    }
    n = BOTC_WakeAbilityChoiceBuild(q);
    if (n <= 1) {
        return;
    }
    if (g_wakeChoiceDlg == 0) {
        BOTC_BuildWakeChoice();
    }
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < n; i += 1) {
        role = g_wakeChoiceRole[i];
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupSingle(g_teller), true);
        libNtve_gf_SetDialogItemImage(g_wakeChoiceIcon[i], BOTC_IconName(role), PlayerGroupSingle(g_teller));
        if (g_wakeChoiceSource[i] == 0) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("本体：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else if (g_wakeChoiceSource[i] == -1) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("赋予：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else if (g_wakeChoiceSource[i] == -3) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText(g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("科怪" + IntToString(g_wakeChoiceSource[i] - 1) + "：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
    }
    libNtve_gf_SetDialogItemText(g_wakeChoiceTitle, StringToText("【多重能力】" + BOTC_NameStr(q) + "：选择本次唤醒的能力"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个能力图标：只执行选中的这一项。");
}

void BOTC_WakeManualApply (int q) {
    bool was;
    if (q < 2 || q > 13) {
        return;
    }
    was = g_awake[q];
    BOTC_WakeApply(q, true);
    if (!was && g_awake[q]) {
        if (g_boffinActing[q] && g_boffinActingSource[q] >= 2) {
            g_boffinDoneBy[(g_boffinActingSource[q] * 14) + q] = true;
        }
        if (g_grantActing[q]) {
            g_grantDoneNight[q] = true;
        }
        if (g_bnestActing[q]) {
            g_bnestDoneBy[(g_bnestSource[q] * 14) + q] = true;
        }
        g_insertWake[q] = false;
        g_autoWoke[q] = true;
        // 【手动唤醒也要自动跟他进私聊】（用户 2026-10-16）：统一走 BOTC_TellerPmTo
        BOTC_TellerPmTo(q);
    }
    if (was && !g_awake[q]) {
        g_autoWoke[q] = false;
    }
    BOTC_WakeRender();
}

void BOTC_WakeManualAt (int q) {
    bool was;
    int n;
    if (q < 2 || q > 13) {
        return;
    }
    was = g_awake[q];
    if (!was) {
        // 手工赋予科学怪人时，该座位也成为科怪来源；手动唤醒直接进入选能力网格。
        if (g_grantRoleBy[q] == 133 && g_mark[(g_teller * 14) + q] - 1 != 132) {
            g_awake[q] = true;
            g_autoWoke[q] = true;
            g_autoLast = q;
            g_boffinEditSource = q;
            BOTC_BoffinOpenRole(q);
            BOTC_TellerPmTo(q);
            BOTC_WakeRender();
            return;
        }
        n = BOTC_WakeAbilityChoiceBuild(q);
        if (n > 1) {
            BOTC_WakeAbilityChoiceOpen(q);
            return;
        }
        if (n == 1) {
            if (g_wakeChoiceSource[0] >= 2) {
                g_boffinActing[q] = true;
                g_boffinActingSource[q] = g_wakeChoiceSource[0];
                g_grantActing[q] = false;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
            else if (g_wakeChoiceSource[0] == -1) {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = true;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
            else if (g_wakeChoiceSource[0] == -3) {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = false;
                g_bnestActing[q] = true;
                g_bnestSource[q] = BOTC_BoffinNestedWakeSource(q);
            }
            else {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = false;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
        }
        else {
            g_boffinActing[q] = false;
            g_boffinActingSource[q] = 0;
            g_grantActing[q] = false;
            g_bnestActing[q] = false;
            g_bnestSource[q] = 0;
        }
    }
    BOTC_WakeManualApply(q);
}

// 首夜邪恶情报用：idx 0 = 疯子（没有就 0）、1 = 恶魔、2 / 3 = 第 1 / 第 2 个爪牙
int BOTC_EvilSeatAt (int idx) {
    int i;
    int n;
    if (idx == 0) {
        return BOTC_RealLunaticSeat();       // 真疯子优先（哲学家假装的那个不算，用户 2026-09-21）
    }
    if (idx == 1) {
        for (i = 2; i <= 13; i += 1) {
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                return i;
            }
        }
        return 0;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2 && !BOTC_IsMarionette(i)) {
            n = n + 1;
            if (n == (idx - 1)) {
                return i;
            }
        }
    }
    return 0;
}

// 「脚本已经写好话」的弹窗：只留【确定（发给他）】和【取消】
void BOTC_ManInfoOpenText (int seat, string title, string msg) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：他中毒/酒鬼时能力失效 → 提醒说书人这段信息可以随便给
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(seat) + " 中毒/酒鬼 → 按规则能力失效，这段信息（或要发给他的那句话）可以随便给。");
    }
    g_miRole = 40;
    g_miText = msg;
    // 把「将要发出去的那句话」显示出来给说书人过目（用户 2026-09-21：以前只有确定/取消，看不到内容）
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(msg), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(title)), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 「填座位号」的弹窗：普通格式两个框；疯子最多四个框
void BOTC_ManInfoOpenSeats (int seat, string title, int kind) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 41;
    g_miKind = kind;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(title)), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit3, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit4, StringToText(""), PlayerGroupSingle(g_teller));
    if (kind == 14) {
        // 事务官：只需要填一名善良玩家的座位号。
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 220, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 232, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    else if (kind == 0) {
        // 疯子假爪牙最多填 4 个。
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit3, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit4, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 20, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 180, 83);
        DialogControlSetPosition(g_miEdit3, PlayerGroupSingle(g_teller), c_anchorTopLeft, 340, 83);
        DialogControlSetPosition(g_miEdit4, PlayerGroupSingle(g_teller), c_anchorTopLeft, 500, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 180, 41);
        DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 162, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 153, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 369, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】疯子假爪牙：允许说书人选择完全不发送，例如罂粟种植者局。
    libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
    if (kind == 0) {
        libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 自动唤醒 + 首夜邪恶情报的进度全部清零（换夜、重新正式开始、取消正式开始都用它）
void BOTC_AutoWakeReset () {
    int i;
    int j;
    for (i = 0; i <= 13; i += 1) {
        g_autoWoke[i] = false;
        g_insertWake[i] = false;
        g_boffinActing[i] = false;
        g_boffinActingSource[i] = 0;
        g_grantActing[i] = false;
        g_grantDoneNight[i] = false;
        g_bnestActing[i] = false;
        g_bnestSource[i] = 0;
        for (j = 0; j <= 13; j += 1) {
            g_boffinDoneBy[(i * 14) + j] = false;
            g_bnestDoneBy[(i * 14) + j] = false;
        }
    }
    g_autoOn = false;
    g_autoLast = 0;
    g_wakeCurrentOrd = 0;
    g_nightCursorOrd = 0;
    g_evilStep = 0;
    g_lgPend = false;
}

// 【首夜固定信息是否应该让位给更早的角色行动】
//   官网当前顺序：爪牙信息 11 → 告密者 12 → 落难少女 13 → 疯子 15 → 恶魔信息 17。
//   例如哲学家 6 / 炼金术士 7 / 科学怪人赋予的早期能力，必须先于爪牙信息行动。
bool BOTC_FirstNightInfoHasEarlierWake (int ord) {
    int i;
    int q;
    int r;
    int o;
    int bo;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (g_autoWoke[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r == 136 || r == 141) {
            continue;                       // 只作为夜序提示，不占唤醒位
        }
        o = BOTC_NightOrderOf(q);
        if (o > 0 && o < ord && !BOTC_WakeSkipNow(q)) {
            return true;
        }
    }
    // 科学怪人借给恶魔的能力也要按该能力自己的夜序先行动。
    bo = BOTC_BoffinWakeSeat();
    if (bo >= 2 && !g_autoWoke[bo]) {
        o = BOTC_BoffinWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    bo = BOTC_GrantWakeSeat();
    if (bo >= 2) {
        o = BOTC_GrantWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    bo = BOTC_BoffinNestedWakeSeat();
    if (bo >= 2) {
        o = BOTC_BoffinNestedWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    return false;
}

int BOTC_MagicianSeatNow () {
    int m;
    m = BOTC_AbilitySeat(136);
    if (m < 2 || m > 13) {
        return 0;
    }
    if (BOTC_SeatDead(m)) {
        return 0;
    }
    // 相克：维齐尔在场时，魔术师没有能力。
    if (BOTC_AbilityInPlay(141)) {
        return 0;
    }
    return m;
}

// 全角色技能面板只用目标类型作标题，不显示角色名、效果说明或括号注释。
string BOTC_SkillPickText (int n) {
    if (n >= 3) {
        return "选择三名玩家";
    }
    if (n == 2) {
        return "选择两名玩家";
    }
    return "选择一名玩家";
}

string BOTC_SkillPickTextFor (int p) {
    int n;
    n = BOTC_TargetsOf(p);
    if (BOTC_TargetMustBeLiving(p)) {
        if (n >= 3) {
            return "选择三名存活玩家";
        }
        if (n == 2) {
            return "选择两名存活玩家";
        }
        return "选择一名存活玩家";
    }
    return BOTC_SkillPickText(n);
}

// 夜间唤醒时采用「先确认是否发动」的限次角色。
bool BOTC_NightLimitRole (int r) {
    return (r == 29 || r == 30 || r == 41 || r == 55 || r == 56 || r == 77 || r == 78 || r == 109 || r == 124 || r == 128);
}

bool BOTC_NightLimitUsed (int p, int r) {
    if (r == 29) { return g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]; }
    if (r == 30) { return g_profUsed[p]; }
    if (r == 41) { return g_assiUsed[p]; }
    if (r == 55) { return g_tokOn[(((g_teller * 14) + p) * 256) + 68]; }
    if (r == 56) { return g_tokOn[(((g_teller * 14) + p) * 256) + 70]; }
    if (r == 77) { return g_tokOn[(((g_teller * 14) + p) * 256) + 98]; }
    if (r == 78) { return g_tokOn[(((g_teller * 14) + p) * 256) + 99]; }
    if (r == 109) { return g_tokOn[(((g_teller * 14) + p) * 256) + 130]; }
    if (r == 124) { return g_tokOn[(((g_teller * 14) + p) * 256) + 145]; }
    if (r == 128) { return g_tokOn[(((g_teller * 14) + p) * 256) + 147]; }
    return false;
}

bool BOTC_LimitedAskOpen (int p) {
    int r;
    if (p < 1 || p > 13) {
        return false;
    }
    r = BOTC_ActRoleOf(p);
    if (!BOTC_NightLimitRole(r)) {
        return false;
    }
    if (BOTC_NightLimitUsed(p, r)) {
        return false;
    }
    // 先只显示是 / 否，不显示任何目标槽或角色信息。
    g_limitedAsk[p] = true;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("是否发动技能？"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
    DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("是"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("否"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    return true;
}

void BOTC_LimitedAccept (int p) {
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (!g_limitedAsk[p] || !BOTC_NightLimitRole(r)) {
        return;
    }
    g_limitedAsk[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
    if (r == 29) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_CourtierOpen(p);
        return;
    }
    if (r == 56) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PhiloOpen(p);
        return;
    }
    if (r == 78) {
        // 工程师一次性机会在这里消耗；它的专用面板同样没有取消。
        g_tokOn[(((g_teller * 14) + p) * 256) + 99] = true;
        BOTC_GrimRender(g_teller);
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_EngOpen(p);
        DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), false);
        return;
    }
    if (r == 124) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_DrossOpen(p);
        return;
    }
    // 其余限次角色进入通用座位面板；确认发动后只保留【确认】。
    g_skillPicking[p] = true;
    BOTC_SkillRender(p);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_Notice(g_who[p], BOTC_SkillPickTextFor(p));
}

void BOTC_LimitedDecline (int p) {
    if (!g_limitedAsk[p]) {
        return;
    }
    g_limitedAsk[p] = false;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    BOTC_Notice(g_who[p], "这次不发动技能。");
    BOTC_PmStore(g_teller, "【限次技能】" + BOTC_NameStr(p) + " 选择这次不发动，本局机会仍然保留。");
}

bool BOTC_PoAskOpen (int p) {
    if (p < 1 || p > 13 || BOTC_ActRoleOf(p) != 46) {
        return false;
    }
    if (BOTC_ProtectTokOn(p, 52)) {
        return false;                 // 已经憋刀：这一夜直接强制三目标
    }
    g_poAsk[p] = true;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("是否发动技能？"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
    DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("是"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("否"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    return true;
}

void BOTC_PoAskAnswer (int p, bool use) {
    if (p < 1 || p > 13 || !g_poAsk[p] || BOTC_ActRoleOf(p) != 46) {
        return;
    }
    g_poAsk[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
    if (!use) {
        g_skillPicking[p] = false;
        g_tokOn[(((g_teller * 14) + p) * 256) + 52] = true;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_Notice(g_who[p], "你选择了不发动技能。");
        BOTC_PmStore(g_teller, "【珀】" + BOTC_NameStr(p) + " 选择憋刀：下一夜必须选择三名玩家，再下一夜重新询问。");
        BOTC_GrimRender(g_teller);
        return;
    }
    g_skillPicking[p] = true;
    BOTC_SkillRender(p);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_Notice(g_who[p], "选择一名玩家");
}

bool BOTC_ComboRole (int r) {
    return (r == 27 || r == 66 || r == 67);
}

void BOTC_ComboRoleOpen (int p) {
    int cp;
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    cp = g_who[p];
    g_pickMode[cp] = 41;
    g_pickWho[cp] = p;
    if (r == 66) {
        BOTC_PickFilter(cp, true);
        BOTC_CerenShowGoblin(cp);
    }
    else {
        BOTC_PickFilter(cp, false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("返回"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_ComboResolve (int p) {
    int r;
    int t;
    int role;
    int k;
    r = BOTC_ActRoleOf(p);
    if (!BOTC_ComboRole(r)) {
        return;
    }
    t = g_skillT1[p];
    role = g_skillRoleSel[p] - 1;
    if (t < 2 || t > 13) {
        BOTC_Notice(g_who[p], "先选择目标1。");
        return;
    }
    if (role < 0 || role > 148) {
        BOTC_Notice(g_who[p], "请先选择一个角色。");
        return;
    }
    if (r == 27 && BOTC_SeatDead(t)) {
        BOTC_Notice(g_who[p], "要选择一名存活玩家。");
        return;
    }
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (r == 27) {
        g_gambleTarget[p] = t;
        g_gambleWait[p] = false;
        BOTC_GambleGuess(p, role);
    }
    else if (r == 66) {
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【洗脑师】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效（没有让他疯狂）。");
        }
        else {
            BOTC_CerenApply(t, role);
        }
    }
    else if (r == 67) {
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效（没有改造任何人）。");
        }
        else {
            for (k = 2; k <= 13; k += 1) {
                g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
            }
            g_hagPick = false;
            g_hagWho = t;
            BOTC_HagApply(t, role);
        }
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    g_skillRoleSel[p] = 0;
}

// 食人魔（148）：首夜选择朋友后静默加入其当时阵营。
// 自身中毒 / 醉酒不影响；只有陌客相克例外会让他得知自己变成了邪恶。
void BOTC_OgreResolve (int p, int target) {
    int targetRole;
    int targetAlign;
    bool learnEvil;
    bool hagCreated;
    if (p < 2 || p > 13 || target < 2 || target > 13 || p == target || !g_seatOn[target]) {
        return;
    }
    targetRole = BOTC_SeatTrueRole(target);
    // 能力在自身中毒 / 醉酒时仍生效，因此读取客观登记层，不叠加“看错阵营”的观察者滤镜。
    targetAlign = BOTC_SeatRegAlign(target);
    if (targetAlign < 0) {
        targetAlign = BOTC_SeatAlign(target);
    }
    // 相克：间谍必定被食人魔当作邪恶。
    if (targetRole == 18) {
        targetAlign = 1;
    }
    learnEvil = (targetRole == 15 && targetAlign == 1);
    // 相克：麻脸巫婆创造的邪恶食人魔不能通过自身能力变回善良。
    hagCreated = g_tokOn[(((g_teller * 14) + p) * 256) + 74];
    if (hagCreated && BOTC_SeatAlign(p) == 1 && targetAlign == 0) {
        targetAlign = 1;
        BOTC_PmStore(g_teller, "【食人魔×麻脸巫婆】" + BOTC_NameStr(p) + " 是被创造的邪恶食人魔，不能因自身能力变成善良。");
    }
    g_tokOn[(((g_teller * 14) + p) * 256) + 14] = false;
    g_tokOn[(((g_teller * 14) + p) * 256) + 15] = false;
    if (targetAlign == 1) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 15] = true;
    }
    else {
        g_tokOn[(((g_teller * 14) + p) * 256) + 14] = true;
    }
    BOTC_PairClearSeat(p);
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【食人魔】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(target) + "，现在是" + BOTC_AlignName(BOTC_SeatAlign(p)) + "阵营。");
    if (learnEvil) {
        BOTC_PmInfo(g_who[p], "【阵营转变】你现在是邪恶阵营。");
        BOTC_PmStore(g_teller, "【食人魔×陌客】已告诉 " + BOTC_NameStr(p) + "：他现在是邪恶阵营。");
    }
}

void BOTC_SendFirstNightMinionInfo () {
    int i;
    int q;
    int dm;
    int mag;
    int dn;
    int n;
    string s;
    string s2;
    string sd;
    dm = BOTC_EvilSeatAt(1);
    if (dm < 2) {
        BOTC_PmStore(g_teller, "【邪恶信息】场上没有真恶魔：首夜爪牙信息跳过。");
        return;
    }
    mag = BOTC_MagicianSeatNow();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2 || BOTC_IsMarionette(q)) {
            continue;
        }
        sd = "";
        s2 = "";
        dn = 0;
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (i == q) {
                continue;
            }
            if (g_seatOn[i] && (i == dm || i == mag)) {
                if (dn > 0) {
                    sd = sd + ",";
                }
                sd = sd + BOTC_NameStr(i);
                dn = dn + 1;
            }
            if (g_seatOn[i] && BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2 && !BOTC_IsMarionette(i)) {
                if (n > 0) {
                    s2 = s2 + ",";
                }
                s2 = s2 + BOTC_NameStr(i);
                n = n + 1;
            }
        }
        // 魔术师与真恶魔合并成一列，并按座位号自然排列，不能把魔术师固定追加在末尾。
        s = "【信息】你得知" + sd + "是恶魔。";
        if (n > 0) {
            s = s + "爪牙：" + s2 + "。";
        }
        else {
            s = s + "本局没有其他爪牙。";
        }
        BOTC_PmInfo(g_who[q], s);
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「" + s + "」");
    }
}

void BOTC_SendFirstNightDemonInfo () {
    int i;
    int q;
    int n;
    int mag;
    string s;
    string s2;
    mag = BOTC_MagicianSeatNow();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 3) {
            continue;
        }
        s2 = "";
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (BOTC_IsMarionette(i) && i != mag) {
                continue;
            }
            // 魔术师和真爪牙在同一轮按座位号排列，避免总被追加到末尾而暴露。
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2 && i != mag) {
                continue;
            }
            if (n > 0) {
                s2 = s2 + ",";
            }
            s2 = s2 + BOTC_NameStr(i);
            n = n + 1;
        }
        if (n > 0) {
            s = "【信息】你得知" + s2 + " 是爪牙。";
        }
        else {
            s = "【信息】你得知没有爪牙。";
        }
        BOTC_PmInfo(g_who[q], s);
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「" + s + "」");
    }
}

// 【首夜固定信息 · 官网最新顺序】（用户 2026-10-21）
//   g_evilStep：0 = 爪牙信息（第 11 位）、1 = 落难少女（第 13 位）、
//               2 = 疯子假爪牙（第 15 位）、3 = 恶魔信息（第 17 位）。
//   每一步先看有没有更早的角色该行动，没有才执行本步；所以不会再把整套邪恶信息抢到开局。
bool BOTC_AutoWakeEvilStep () {
    int ord;
    int q;
    if (g_nightNum != 1) {
        return false;
    }
    while (g_evilStep < 4) {
    if (g_evilStep == 0) {
        ord = 11;
    }
    else if (g_evilStep == 1) {
        ord = 13;
    }
    else if (g_evilStep == 2) {
        ord = 15;
    }
    else {
        ord = 17;
    }
    if (BOTC_FirstNightInfoHasEarlierWake(ord)) {
        return false;
    }
    g_autoOn = true;
    if (g_evilStep == 0) {
        g_evilStep = g_evilStep + 1;
        if (BOTC_PoppyActive()) {
            BOTC_PmStore(g_teller, "【罂粟种植者】跳过他造成的爪牙互认。");
        }
        else if (BOTC_LegionOn()) {
            BOTC_PmStore(g_teller, "【军团】普通爪牙信息由【发送互认】按钮处理。");
        }
        else if (g_lmOn && !BOTC_LmHasDemon()) {
            BOTC_PmStore(g_teller, "【小怪宝】场上没有恶魔：爪牙互认跳过。");
        }
        else {
            BOTC_SendFirstNightMinionInfo();
        }
        BOTC_WakeRender();
        return true;
    }
    if (g_evilStep == 1) {
        g_evilStep = g_evilStep + 1;
        if (BOTC_DamselSeat() >= 2) {
            BOTC_DamselDealInfo();
            BOTC_PmStore(g_teller, "【落难少女】已通知所有爪牙「落难少女在场」。");
            BOTC_WakeRender();
            return true;
        }
        // 本局没有落难少女：不占唤醒位，继续判断下一个固定信息。
        continue;
    }
    if (g_evilStep == 2) {
        g_evilStep = g_evilStep + 1;
        q = BOTC_RealLunaticSeat();
        if (q < 2) {
            // 本局没有真疯子：不占唤醒位，继续判断恶魔信息或更早的角色。
            continue;
        }
        else if (BOTC_LegionLunatic()) {
            BOTC_PmStore(g_teller, "【疯子】他以为自己是「军团」→ 不自动弹假爪牙框。");
        }
        else {
            BOTC_LunaticInfo();
        }
        BOTC_WakeRender();
        return true;
    }
    // g_evilStep == 3：第 17 位恶魔信息。疯子若还没按第 15 位被正常唤醒，
    // 上面的「更早角色」检查会先放他去行动，等他回来后才会走到这里。
    g_evilStep = g_evilStep + 1;
    if (BOTC_PoppyActive()) {
        BOTC_PmStore(g_teller, "【罂粟种植者】跳过他造成的恶魔互认。");
    }
    else if (BOTC_LegionOn()) {
        BOTC_PmStore(g_teller, "【军团】普通恶魔信息由【发送互认】按钮处理。");
    }
    else if (g_lmOn && !BOTC_LmHasDemon()) {
        BOTC_PmStore(g_teller, "【小怪宝】场上没有恶魔：恶魔信息跳过。");
    }
    else {
        BOTC_SendFirstNightDemonInfo();
    }
    if (!BOTC_LegionOn()) {
        BOTC_NotifyDemonsLunatic();
    }
    BOTC_WakeRender();
    return true;
    }
    return false;
}

// 自动唤醒用：这个座位今晚要不要跳过（规则上不能醒 + 说书人打的 token 说他今晚不能动）
//   僵怖：带着「死于今日（僵怖）」= 今天有人死 → 不唤醒；
//   教父：没有「死于今日（教父）」= 今天没有外来者死 → 不能动手，不唤醒；
//   被驱魔人点名的恶魔：带着「被选择（驱魔人）」→ 不唤醒。
bool BOTC_WakeSkipNow (int q) {
    int r;
    int r2;
    if (q < 2 || q > 13) {
        return true;
    }
    if (!BOTC_CanWakeAt(q)) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 31)) {
        return true;
    }
    r = BOTC_SeatTrueRole(q);
    // 【小怪宝（112）】（用户 2026-10-10）：小怪宝本人不行动 —— 只有身上带着「是恶魔（小怪宝）」的那个人才行动
    if (r == 112 && !g_tokOn[(((g_teller * 14) + q) * 256) + 134]) {
        return true;
    }
    if (r == 43 && BOTC_ProtectTokOn(q, 57)) {
        return true;
    }
    if (r == 39 && !BOTC_ProtectTokOn(q, 56) && !BOTC_GodfatherCanKill() && g_nightNum > g_seatFirstNight[q]) {
        return true;                            // 教父：今天没有外来者死（也不是他的首夜）→ 今晚不唤醒
    }
    r2 = g_mark[(g_teller * 14) + q] - 1;
    if (r2 == 43 && BOTC_SomeoneDiedToday()) {
        return true;                            // 僵怖：今天有人死 → 不唤醒（疯子以为自己是僵怖也一样）
    }
    // 送葬者：今天没人被处决，或处决对象没有真的死亡 → 不进入自动唤醒队列。
    //   这里只拦自动流程；说书人手动唤醒仍可强制打开。
    if (r2 == 7 && !BOTC_ExecutedDeathToday()) {
        return true;
    }
    if (r2 == 147) {
        return true;
    }
    if (r2 == 36) {
        return true;                            // 月之子（36）：夜里不唤醒，他的选择在「死亡公开」那一下走
    }
    if (r2 == 29 && g_courtUsed[q]) {
        return true;
    }
    if (r2 == 30 && g_profUsed[q]) {
        return true;
    }
    if (r2 == 41 && g_assiUsed[q]) {
        return true;
    }
    if (r2 == 55 && BOTC_ProtectTokOn(q, 68)) {
        return true;                            // 女裁缝：一局一次，用过了就不再唤醒
    }
    if (r2 == 58 && g_juggUsed[q]) {
        return true;                            // 杂耍艺人：只在首个白天猜完之后的那一晚醒一次
    }
    if (r2 == 90 && g_nightNum > g_seatFirstNight[q] && !BOTC_BountyTrigger()) {
        return true;
    }
    // 【国王（104）】首夜那一步 = 「告诉恶魔谁是国王」（开局自动发），**不唤醒国王本人**
    if (r == 104 && g_nightNum <= g_seatFirstNight[q]) {
        return true;
    }
    // 【国王（104）】其它夜：只有「死亡数 ≥ 存活数」才进唤醒队列（否则按规则今晚不给信息）
    if (r == 104 && !BOTC_KingConditionOK()) {
        return true;
    }
    return false;
}

// 这些角色在夜序中不是被唤醒，而是由说书人按结果手动打死亡 token。
bool BOTC_ManualDeathTokenRole (int r) {
    return (r == 94 || r == 112 || r == 133 || r == 28 || r == 36 || r == 22 || r == 35);
}

// 在普通行动之间插入“非唤醒夜序节点”：手动死亡 token 提示 / 农夫延迟选人。
bool BOTC_NonWakeOrderStep (int beforeOrd) {
    int i;
    int q;
    int r;
    int ord;
    int score;
    int best;
    int bestOrd;
    int bestRole;
    bool bestFarm;
    best = 0;
    bestOrd = 0;
    bestRole = -1;
    bestFarm = false;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 148 || !BOTC_ManualDeathTokenRole(r) || g_manualDeathDone[q]) {
            continue;
        }
        if (!BOTC_HasAbility(q, r)) {
            continue;
        }
        ord = BOTC_NightOrderOf(q);
        if (ord <= 0) {
            continue;
        }
        score = (ord * 10) + 6;
        if (beforeOrd > 0 && score > beforeOrd) {
            continue;
        }
        if (best < 2 || score < bestOrd) {
            best = q;
            bestOrd = score;
            bestRole = r;
            bestFarm = false;
        }
    }
    // 农夫死亡触发不再当场弹框，而是在农夫自己的夜序节点打开选人面板。
    for (q = 2; q <= 13; q += 1) {
        if (!g_farmPending[q]) {
            continue;
        }
        ord = BOTC_NightOrder(80);
        if (ord <= 0) {
            continue;
        }
        score = (ord * 10) + 7;
        if (beforeOrd > 0 && score > beforeOrd) {
            continue;
        }
        if (best < 2 || score < bestOrd) {
            best = q;
            bestOrd = score;
            bestRole = 80;
            bestFarm = true;
        }
    }
    if (best < 2) {
        return false;
    }
    if ((bestOrd / 10) > g_nightCursorOrd) {
        g_nightCursorOrd = bestOrd / 10;
    }
    if (bestFarm) {
        g_farmPending[best] = false;
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(best) + " 的死亡触发到达夜序节点：请选择一名存活善良玩家变成农夫（不唤醒农夫本人）。");
        BOTC_FarmerOpen(best, false);
    }
    else {
        g_manualDeathDone[best] = true;
        BOTC_Notice(g_teller, "【" + g_roleName[bestRole] + "】座位 " + IntToString(best - 1) + "：请手动打上死亡token。");
        BOTC_PmStore(g_teller, "【夜序·非唤醒】" + BOTC_NameStr(best) + "（" + g_roleName[bestRole] + "）到达行动位次，请按规则手动打上死亡 token。");
    }
    return true;
}

// 【自动唤醒】（用户 2026-09-20）：按一下 → 唤醒夜间顺序里下一个该行动的人，并自动跟他进私聊；
//   再按一下 = 收掉上一个、唤醒下一个。全都轮完弹一句「所有玩家均已行动完毕。」
void BOTC_AutoWakeNext () {
    int chatTo;
    int i;
    int q;
    int r;
    int best;
    int bestOrd;
    int bestOrd2;
    int ks;
    int ko;
    int xs;
    int xo;
    int boffinSeat;
    int boffinSource;
    int boffinOrd;
    int boffinBestOrd;
    bool boffinWake;
    int grantSeat;
    int grantOrd;
    int grantBestOrd;
    bool grantWake;
    int bnestSeat;
    int bnestSource;
    int bnestOrd;
    int bnestBestOrd;
    bool bnestWake;
    if (!g_isNight) {
        BOTC_Notice(g_teller, "白天不能唤醒：先点【进入夜晚】，夜里才唤醒。");
        return;
    }
    // 【军团】疯子的「屏蔽两个」框还没答完：先别往下唤醒别人（用户 2026-09-30 实测会被顺带唤醒）
    if (BOTC_LegionPendBlock()) {
        return;
    }
    if (!g_autoOn) {
        BOTC_WakeListHint();
    }
    g_autoOn = true;
    // 上一个：先在进入下一项（角色或首夜固定信息）之前退出私聊并收回技能。
    // 这样疯子第 15 位行动结束后，下一次点击会先收回他，再发第 17 位恶魔信息。
    if (g_autoLast >= 2) {
        BOTC_ForceLeave(g_teller);
        if (g_awake[g_autoLast]) {
            BOTC_WakeToggle(g_autoLast);
        }
        g_autoLast = 0;
    }
    // 【科学怪人（132）】首夜先按正常唤醒流程唤醒他并选择赐予恶魔的能力
    if (BOTC_BoffinFirstWakeStep()) {
        return;
    }

    // 【暴风捕手】（用户 2026-10-11）：在「邪恶互认」之前先走他这一步（你得知 A 是 B）
    if (BOTC_StormEvilStep()) {
        return;
    }
    if (BOTC_AutoWakeEvilStep()) {
        return;
    }
    // 下一个：今晚还没轮到过、在夜间顺序表里、而且允许唤醒的人里面，顺序最靠前的那个
    best = 0;
    bestOrd = 0;
    boffinSeat = 0;
    boffinSource = 0;
    boffinOrd = 0;
    boffinBestOrd = 0;
    boffinWake = false;
    grantSeat = 0;
    grantOrd = 0;
    grantBestOrd = 0;
    grantWake = false;
    bnestSeat = 0;
    bnestSource = 0;
    bnestOrd = 0;
    bnestBestOrd = 0;
    bnestWake = false;
    BOTC_BuildSeatList();
    // 先处理刚获得更早夜序能力或身份的插入队列；它优先于正常扫描。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!g_insertWake[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r == 136 || r == 141) {
            g_insertWake[q] = false;
            continue;                       // 只作为夜序提示，不占唤醒位
        }
        if (r < 0 || r > 148 || BOTC_NightOrderOf(q) <= 0 || BOTC_WakeSkipNow(q)) {
            g_insertWake[q] = false;
            continue;
        }
        bestOrd2 = BOTC_NightOrderOf(q) * 10;
        if (!BOTC_IsLunatic(q)) {
            bestOrd2 = bestOrd2 + 5;
        }
        if (best == 0 || bestOrd2 < bestOrd) {
            best = q;
            bestOrd = bestOrd2;
        }
    }
    if (best >= 2) {
        g_insertWake[best] = false;
        bestOrd = 0;
    }
    else {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (g_autoWoke[q]) {
                continue;
            }
            r = g_mark[(g_teller * 14) + q] - 1;
            if (r == 136 || r == 141) {
                continue;                   // 魔术师由邪恶信息直接处理；维齐尔在白天公开
            }
            if (r < 0 || r > 148) {
                continue;
            }
            if (BOTC_NightOrderOf(q) <= 0) {
                continue;
            }
            if (BOTC_WakeSkipNow(q)) {
                continue;
            }
            bestOrd2 = BOTC_NightOrderOf(q) * 10;
            if (!BOTC_IsLunatic(q)) {      // 【哲学疯子也算疯子那一档】（用户 2026-10-14 报「在恶魔之后行动」）
                bestOrd2 = bestOrd2 + 5;
            }
            if (best == 0 || bestOrd2 < bestOrd) {
                best = q;
                bestOrd = bestOrd2;
            }
        }
    }
    // 【科学怪人（132）】同一名恶魔还有一次「借来能力」的夜间时机，单独占用一次唤醒
    boffinSeat = BOTC_BoffinWakeSeat();
    if (boffinSeat >= 2) {
        boffinOrd = BOTC_BoffinWakeOrder(boffinSeat);
        boffinSource = BOTC_BoffinWakeSource(boffinSeat);
        if (boffinOrd > 0) {
            boffinBestOrd = (boffinOrd * 10) + 1;
            if (best < 2 || boffinBestOrd < bestOrd) {
                best = boffinSeat;
                bestOrd = boffinBestOrd;
                boffinWake = true;
                grantWake = false;
                bnestWake = false;
            }
        }
    }
    // 【科怪 × 哲学家 / 炼金术士】嵌套能力按所选角色自己的夜序额外行动。
    bnestSeat = BOTC_BoffinNestedWakeSeat();
    if (bnestSeat >= 2) {
        bnestOrd = BOTC_BoffinNestedWakeOrder(bnestSeat);
        bnestSource = BOTC_BoffinNestedWakeSource(bnestSeat);
        if (bnestOrd > 0) {
            bnestBestOrd = (bnestOrd * 10) + 2;
            if (best < 2 || bnestBestOrd < bestOrd) {
                best = bnestSeat;
                bestOrd = bnestBestOrd;
                bnestWake = true;
                boffinWake = false;
                grantWake = false;
            }
        }
    }
    // 【赋予能力】附加能力按它自己的夜序额外行动一次。
    grantSeat = BOTC_GrantWakeSeat();
    if (grantSeat >= 2) {
        grantOrd = BOTC_GrantWakeOrder(grantSeat);
        if (grantOrd > 0) {
            grantBestOrd = (grantOrd * 10) + 3;
            if (best < 2 || grantBestOrd < bestOrd) {
                best = grantSeat;
                bestOrd = grantBestOrd;
                grantWake = true;
                boffinWake = false;
                bnestWake = false;
            }
        }
    }
    // 【国王（104）· 首夜那一步】（用户 2026-10-10）：**不唤醒国王本人** ——
    //   在他的夜序位次上把「谁是国王」告诉恶魔（真恶魔 + 疯子）。疯子以为自己是恶魔，
    //   不告诉他，他一看自己没有这条信息就知道自己是假的了。
    ks = BOTC_SeatOfRole(104);
    if (ks >= 2 && ks <= 13 && g_kingAnnounced != g_nightNum && g_nightNum <= g_seatFirstNight[ks]) {
        ko = BOTC_NightOrderOf(ks);
        if (ko > 0) {
            if (best < 2 || (ko * 10) <= bestOrd) {
                g_kingAnnounced = g_nightNum;
                BOTC_KingAnnounce();
                BOTC_WakeRender();
                return;
            }
        }
    }
    // 【限（147）】被动结算：不唤醒本人、不进私聊；到夜序位置时直接给所有镇民上毒。
    xs = BOTC_XaanAutoSeat();
    if (xs >= 2) {
        xo = BOTC_NightOrder(147);
        if (xo > 0 && (best < 2 || (xo * 10) <= bestOrd)) {
            BOTC_XaanApply(xs);
            BOTC_WakeRender();
            return;
        }
    }
    // 非唤醒夜序节点：到点提示说书人打死亡 token；农夫到点才弹选人面板。
    if (BOTC_NonWakeOrderStep(bestOrd)) {
        BOTC_WakeRender();
        return;
    }
    if (best < 2) {
        BOTC_Notice(g_teller, "所有玩家均已行动完毕。");
        BOTC_WakeRender();
        return;
    }
    if (grantWake) {
        g_boffinActing[best] = false;
        g_boffinActingSource[best] = 0;
        g_grantActing[best] = true;
        g_bnestActing[best] = false;
        g_bnestSource[best] = 0;
        g_grantDoneNight[best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (boffinWake) {
        g_boffinActing[best] = true;
        g_boffinActingSource[best] = boffinSource;
        g_grantActing[best] = false;
        g_bnestActing[best] = false;
        g_bnestSource[best] = 0;
        g_boffinDoneBy[(boffinSource * 14) + best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (bnestWake) {
        g_boffinActing[best] = false;
        g_boffinActingSource[best] = 0;
        g_grantActing[best] = false;
        g_bnestActing[best] = true;
        g_bnestSource[best] = bnestSource;
        g_bnestDoneBy[(bnestSource * 14) + best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    g_boffinActing[best] = false;
    g_boffinActingSource[best] = 0;
    g_grantActing[best] = false;
    g_bnestActing[best] = false;
    g_bnestSource[best] = 0;
    g_autoWoke[best] = true;
    // 【逆臣（119）】（用户 2026-10-16）：第二晚起不唤醒他 → 也不跟他进私聊（这一步只告知阵营有没有转变）
    if (g_nightNum >= 2 && g_mark[(g_teller * 14) + best] - 1 == 119) {
        BOTC_WakeToggle(best);
        BOTC_WakeRender();
        return;
    }
    // 【帽匠（120）】（用户 2026-10-16）：他的夜序位只是开茶会 ---- 不唤醒他本人、也不跟他进私聊
    if (g_mark[(g_teller * 14) + best] - 1 == 120) {
        BOTC_WakeToggle(best);
        BOTC_WakeRender();
        return;
    }
    g_autoLast = best;
    if (!g_awake[best]) {
        BOTC_WakeToggle(best);
    }
    if (!g_awake[best]) {
        BOTC_WakeRender();
        return;
    }
    // 跟他进私聊：说书人那边回车直接进这条私聊（统一走 BOTC_TellerPmTo）
    // 【理发师（62）】（用户 2026-09-21）：这一格实际是「再次唤醒恶魔」，所以私聊开给那只恶魔
    chatTo = best;
    if (BOTC_HasAbility(best, 62) && g_barberFrom >= 2) {
        chatTo = g_barberFrom;
    }
    BOTC_TellerPmTo(chatTo);
    BOTC_WakeRender();
}

// 【这个座位是不是电脑】（用户 2026-09-20）：电脑玩家没人操作技能面板 ---- 脚本替他选目标，
//   这样说书人能看到后面的流程（侍女 / 占卜师被唤醒后弹的答题框等）。
bool BOTC_SeatIsComputer (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    return (PlayerType(g_who[q]) != 1);   // 1 = 真人；q 是格子 → 问"这格现在坐的人"（物理座位）
}

void BOTC_WakeApply (int q, bool manual) {
    int r;
    int dm;
    if (q < 2 || q > 13) {
        return;
    }
    if (g_awake[q]) {
        // 收回唤醒时，如果这个人正在看说书人魔典（间谍），先把魔典换回他自己那份
        BOTC_SpyPeekEnd();
        g_awake[q] = false;
        g_skillPicking[q] = false;
        g_limitedAsk[q] = false;
        g_poAsk[q] = false;
        g_skillRoleSel[q] = 0;
        g_skillT1[q] = 0;
        g_skillT2[q] = 0;
        g_skillT3[q] = 0;
        DialogSetVisible(g_skillDlg[q], PlayerGroupSingle(g_who[q]), false);
        BOTC_SkillBtnRender();
        BOTC_PmInfo(g_who[q], "【夜晚】说书人收回了你的技能。");
        BOTC_Notice(g_teller, "取消唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
        BOTC_PmStore(g_teller, "【夜间】收回 " + BOTC_NameStr(q) + "（" + BOTC_SeatRoleStr(q) + "）的技能。");
        if (g_sgSeat == q) {                   // 【修行者（114）】收回他的唤醒 = 把那个面板一起收掉
            BOTC_SgClose();
        }
        g_boffinActing[q] = false;
        g_boffinActingSource[q] = 0;
        g_grantActing[q] = false;
        g_bnestActing[q] = false;
        g_bnestSource[q] = 0;
        g_wakeCurrentOrd = 0;
        return;
    }
    if (!g_seatOn[q]) {
        BOTC_Notice(g_teller, "这个座位现在没有人，不能唤醒。");
        return;
    }
    r = BOTC_ActRoleOf(q);
    if (r < 0 || r > 148) {
        BOTC_Notice(g_teller, "这个座位还没有身份，不能唤醒。");
        return;
    }
    // 送葬者的最终自动拦截：本体、手工赋予、科学怪人借用都走这里。
    //   当天没有「被处决并死亡」的玩家时，不唤醒本人，也不继续打开私聊。
    if (!manual && r == 7 && !BOTC_ExecutedDeathToday()) {
        BOTC_PmStore(g_teller, "【送葬者】今天没有因处决而死亡的玩家，本次自动唤醒跳过。");
        return;
    }
    // 【逆臣（119）】（用户 2026-10-16）：第二晚起**不唤醒他** ---- 他的夜序位只做一件事：
    //   告诉他阵营有没有转变（没转变就什么都不发，人也不醒、不弹面板、不进私聊）。
    //   ⚠ 按「魔典上写的身份」判 ---- 酒鬼 / 悟道者那些以为自己是他的人也会轮到这个位次，
    //     但他们没有实际能力，所以什么都不做（用户 2026-10-16）。
    if (!manual && !g_boffinActing[q] && g_nightNum >= 2 && g_mark[(g_teller * 14) + q] - 1 == 119) {
        if (BOTC_HasAbility(q, 119)) {
            if (g_tcPending >= 2 && g_tcPending <= 13) {
                BOTC_TurncoatApply(g_tcPending);
                g_tcPending = 0;
            }
            else {
                BOTC_PmStore(g_teller, "【逆臣】轮到他这一步：阵营没有转变，什么都不发。");
            }
        }
        return;
    }
    // 【帽匠（120）】（用户 2026-10-16）：他**死后**的那一个夜晚，轮到他这一步就把「恶魔 + 爪牙」拉进群聊
    //   （跟小怪宝一样的恶人频道，提线木偶不进）。他自己已经死了 ---- 不唤醒、也不跟他进私聊。
    if (!manual && !g_boffinActing[q] && g_mark[(g_teller * 14) + q] - 1 == 120) {
        if (BOTC_HasAbility(q, 120) && BOTC_SeatDead(q) && !g_hatDone[q]) {
            g_hatDone[q] = true;
            if (g_deadDay[q] > 0) {
                BOTC_HatDayPrompt();
            }
            else {
                BOTC_HatGroupChat();
            }
        }
        return;
    }
    // 【女巫（65）· 自动唤醒前再拦一次】（用户 2026-10-21）：公共判定之后仍有个别特殊分支，
    // 这里放在自动流程入口的第一层；说书人手动强制唤醒不受这条限制。
    if (!manual && r == 65 && BOTC_HasAbility(q, 65) && !BOTC_WitchCanAct(q)) {
        BOTC_Notice(g_teller, "女巫只剩 3 名存活玩家，能力已失效，不再唤醒她。");
        return;
    }

    // 自动唤醒按角色的行动类别判断今晚能不能唤醒；手动唤醒只看座位、身份和借用能力来源。
    if (g_boffinActing[q]) {
        if (!BOTC_BoffinWorksAt(g_boffinActingSource[q]) || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "【科学怪人】来源失效或恶魔已经死亡，这次借用能力不能唤醒。");
            g_boffinActing[q] = false;
            g_boffinActingSource[q] = 0;
            return;
        }
    }
    else if (g_grantActing[q]) {
        if (g_grantRoleBy[q] <= 0 || g_grantRoleBy[q] > 148 || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "【赋予能力】附加能力已经不存在或玩家死亡，这次唤醒取消。");
            g_grantActing[q] = false;
            return;
        }
        if (g_grantDrunkBy[q]) {
            BOTC_PmStore(g_teller, "【赋予能力】这份附加能力处于醉酒状态：面板可以照常打开，但能力效果无效。");
        }
    }
    else if (g_bnestActing[q]) {
        if (!BOTC_BoffinNestedWorksAt(g_bnestSource[q], q) || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "来源失效或恶魔已经死亡，这次能力不能唤醒。");
            g_bnestActing[q] = false;
            g_bnestSource[q] = 0;
            return;
        }
    }
    else {
        if (!manual && !BOTC_CanWakeAt(q)) {
            BOTC_Notice(g_teller, BOTC_WakeBlockStr(q));
            return;
        }
    }
    // （猎手那种「公开触发」的角色现在连唤都唤不醒，见 BOTC_CanWakeAt；所以这里不用再提醒）
    g_awake[q] = true;
    if (g_boffinActing[q]) {
        g_wakeCurrentOrd = BOTC_NightOrder(g_boffinRoleBy[g_boffinActingSource[q]] - 1);
    }
    else if (g_grantActing[q]) {
        g_wakeCurrentOrd = BOTC_GrantNightOrder(q);
    }
    else if (g_bnestActing[q]) {
        g_wakeCurrentOrd = BOTC_NightOrder(g_bnestRoleBy[g_bnestSource[q]] - 1);
    }
    else {
        g_wakeCurrentOrd = BOTC_NightOrderOf(q);
    }
    if (g_wakeCurrentOrd > g_nightCursorOrd) {
        g_nightCursorOrd = g_wakeCurrentOrd;
    }
    g_wokeTonight[q] = true;      // 侍女（24）查的就是这一条：今晚因为自己的技能被唤醒过
    g_skillT1[q] = 0;
    g_skillT2[q] = 0;
    g_skillT3[q] = 0;
    g_skillPicking[q] = false;
    BOTC_SkillBtnRender();
    // 【理发师（62）】（用户 2026-09-21）：这一步**不是**唤醒理发师，而是再唤醒一次恶魔（让他交换角色）。
    //   所以私聊 / 提示都写给恶魔，理发师本人（已经死了）什么都不发、面板也不给他开。
    if (r == 62) {
        dm = BOTC_FindDemon();
        if (dm >= 2) {
            BOTC_PmInfo(g_who[dm], "【夜晚】你被唤醒了（理发师：选两名玩家交换他们的角色）。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(dm) + " 恶魔（理发师交换）。");
            BOTC_PmStore(g_teller, "【夜间】唤醒 " + BOTC_NameStr(dm) + "（恶魔）---- 理发师 " + BOTC_NameStr(q) + " 的能力：交换两名玩家的角色。");
        }
        else {
            BOTC_PmStore(g_teller, "【理发师】场上没有活着的恶魔，这一步跳过。");
        }
    }
    else {
        if (g_boffinActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了：现在使用科学怪人赋予你的「" + g_roleName[r] + "」能力。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "（恶魔借用「" + g_roleName[r] + "」能力）。");
        }
        else if (g_grantActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "（附加能力「" + g_roleName[r] + "」）。");
        }
        else if (g_bnestActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了：现在使用科学怪人经哲学家 / 炼金术士赋予你的「" + g_roleName[r] + "」能力。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "：" + g_roleName[r]);
        }
        else {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
        }
    }
    // 【教父必须进私聊】（用户 2026-10-16 第三次报：「不管自动还是手动唤醒都不会自动进，只有教父」）：
    //   不再限制「只首夜」---- 只要教父被唤醒就跟别的角色一个待遇，走统一的 BOTC_TellerPmTo。
    if (r == 39 && g_who[q] >= 2) {
        BOTC_TellerPmTo(q);
    }
    // 【横行霸道 · 炼金术士(95)】（用户 2026-10-03）：首夜唤醒他时，给说书人弹"只列爪牙"的网格
    // 【酒鬼 / 提线木偶 版本也要弹】（用户 2026-10-13）：这里原来判**真身** 95 ----
    //   可酒鬼(14) / 提线木偶(93) 的魔典上写的是「炼金术士」，真身并不是 95 → 他们永远拿不到这个面板。
    //   本函数里 r 就是「魔典上写的身份」（他以为自己是的那只），按 r 判才对。
    if (r == 95 && !g_boffinActing[q] && !g_bnestActing[q] && BOTC_ActingIsFirstNight(q)) {
        BOTC_AlcBorrowOpen(q);
    }
    // 【横行霸道 · 将军(96)】（用户 2026-10-03）：**每夜**唤醒他时都弹面板（说书人填 善良 / 邪恶 / 均势）
    if (r == 96) {  // 【按魔典上写的身份判】（用户 2026-10-13，酒鬼 / 提线木偶 版本也要弹）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【将军】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，答案随你给。");
        }
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 96, "");
    }
    // 被唤醒时把魔典给他打开（行动完成前关不掉）
    // 【理发师（62）】（用户 2026-09-21）：他不算被唤醒，魔典 / 面板都不给他开
    if (r != 62) {
        BOTC_GrimRender(g_who[q]);
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
    // 【魔典会盖住面板】（用户 2026-10-03）：说书人面板(将军) / 只列爪牙的网格(炼金术士) 都建得比魔典**早**，
    //   光"重新显示"压不上去 -> 这两个角色被唤醒时直接把魔典收掉（跟麻脸巫婆开面板前先收魔典是同一套做法）
    if ((r == 96 || r == 95 || r == 104 || r == 109 || r == 108)) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), false);
    }
    }
    // 【寡妇（75）】（用户 2026-09-26）：唤醒她就把**说书人那份魔典**直接摊开（不用再点【使用技能】），
    //   同时把选目标面板开出来 —— 她看完点一个座位、按【确认】才下毒
    if (r == 75) {
        BOTC_WidowPeek(q);
    }
    // 【顺序】先唤醒（上面几句），再给信息，最后才是他选目标 / 被收回（收在 BOTC_SkillConfirm 或说书人手里）
    BOTC_PmStore(g_teller, "【夜间】唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
    if (r == 102) {
        BOTC_VizierFearChat(q);
    }
    // 【科怪嵌套哲学家 / 炼金术士】只在尚未发动时再次弹选择；发动后自动唤醒会跳过。
    if (g_boffinActing[q] && (r == 56 || r == 95) && !g_bnestChosenBy[g_boffinActingSource[q]]) {
        BOTC_BoffinNestedOpen(g_boffinActingSource[q]);
    }
    // ===== 【横行霸道 · 新角色的唤醒动作】=====（用户 2026-10-03）
    //   挂在这行后面 = 每次唤醒（自动/手动）都一定会跑到，跟教父首夜那条不同（那条只在首夜跑）。
    //   ① 炼金术士(95)：首夜弹「只列爪牙」的网格，让说书人替他挑借到哪一只
    if (r == 95 && !g_boffinActing[q] && !g_bnestActing[q] && BOTC_ActingIsFirstNight(q)) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        BOTC_AlcBorrowOpen(q);
    }
    // 【科学怪人（132）】每夜手动重新唤醒都从身份网格重新选能力，再选接收者。
    if (r == 132) {
        if (BOTC_BoffinSourceIs(q)) {
            BOTC_BoffinOpenRole(q);
        }
        else {
            BOTC_BoffinOpenStatus(q);
        }
    }
    // 【送葬者 / 守鸦人】唤醒后由说书人从身份网格中选择本夜要告知的角色。
    if (r == 6 || r == 8) {
        g_pickMode[g_teller] = 42;
        g_pickWho[g_teller] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(g_teller, false);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
        if (r == 6) {
            libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
            DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), true);
        }
        else {
            DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), false);
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
    }
    // 【保留角色】骑士首次夜晚填两名非恶魔；鸩弹「只列镇民」的角色网格。
    if (r == 122) {
        BOTC_ManInfoOpenSeats(q, "【骑士】填两名玩家（左 / 右各一个座位号 1~12）", 13);
    }
    if (r == 142) {
        BOTC_ManInfoOpenSeats(q, "【事务官】填一名玩家（座位号 1~12）", 14);
    }
    if (r == 124) {
        BOTC_LimitedAskOpen(q);
    }
    if (r == 78) {
        BOTC_LimitedAskOpen(q);
    }
    if (r == 125) {
        BOTC_ManInfoOpen(q, 125, "");
    }
    //   ② 将军(96)：每夜都弹真人说书面板（说书人填 善良 / 邪恶 / 均势）
    if (r == 96) {  // 【同上】（用户 2026-10-13）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【将军】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，答案随你给。");
        }
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 96, "");
    }
    // 【何方教众（板子 9）】（用户 2026-10-10）：这 11 个角色唤醒时的附加动作（面板 / 信息 / 提醒）
    BOTC_HfWakeAction(q);
    // 【牙噶巴卜（133）】（用户 2026-10-21）：他的第一个夜晚只输入并发送秘密短语；不自动监听白天发言。
    if (r == 133 && BOTC_ActingIsFirstNight(q)) {
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【牙噶巴卜】" + BOTC_NameStr(q) + " 中毒/酒鬼：短语仍可按规则给他，但能力是否生效由你判断。");
        }
        BOTC_ManInfoOpen(q, 809, "");
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：国王身上带着「死亡（恶魔）」token 时唤醒他 → 弹填数字框
    if (r == 108 && BOTC_ChoirboyKingDead()) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【唱诗男孩】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，随便给。");
        }
        BOTC_ManInfoOpen(q, 804, "");
    }
    // 【首夜信息位 · 新面板】（用户 2026-09-21）：洗衣妇（0）/ 图书管理员（1）/ 调查员（2）填两个座位号 + 选一个身份，
    //   祖母（22）填一个孙子 + 选他的身份；点【确定】由脚本私聊给他，并自动打「正确 / 错误」token。
    //   唤醒时自动挑人那套已经删掉，全由说书人自己填。
    if ((r == 0 || r == 1 || r == 2 || r == 22)) {
        BOTC_MiFnOpen(q, r);
    }
    // 【贤者（59）】（用户 2026-09-21）：被恶魔杀死的那一晚，弹「填两个玩家」的框（脚本预填真恶魔 + 一个陪衬）
    // 【镜像双子（64）】（用户 2026-09-21）：他和首夜信息位是同一类判定 ----
    //   · 行动类别和洗衣妇 / 图管 / 调查员 / 祖母一样是「首夜信息位」（g_roleAct = 5）：
    //     只有他的「首夜」那一晚会被唤醒；复活 / 被麻脸巫婆造出来会重新算首夜（g_seatFirstNight）。
    //   · 唤醒时同样弹一块「填座位号 + 选身份」的面板（这一块是配对面板，角色代号 23）。
    //   · 配对还算数就不重复配：他本人没变、对立双子还在场、对方身上「对立双子(77)」标记还在。
    if (r == 64) {
        if (g_twinA != q) {
            g_twinB = 0;                 // 换局残留 / 上一只双子留下的记录，一律作废
        }
        g_twinA = q;
        if (g_twinB >= 2) {
            if (!g_seatOn[g_twinB] || !g_tokOn[(((g_teller * 14) + g_twinB) * 256) + 77]) {
                g_twinB = 0;             // 对立双子不在场了 / 身上标记没了 → 这一对不算数
            }
        }
        if (g_twinB >= 2) {
            BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(q) + " 这一对还算数（对立双子是 " + BOTC_NameStr(g_twinB) + "），这次不用再配。");
            // 【不在这里补发信息】（用户 2026-10-14）：中毒 / 酒鬼那一次的信息脚本不补 ----
            //   要补你自己私下告诉他们；配对 token 也可以在 token 面板上手动点 76 / 77。
        }
        else {
            BOTC_Notice(g_teller, "【镜像双子】填对立双子的座位号，再选他的身份（身份都能选）。");
            BOTC_MiFnOpen(q, 23);
            return;
        }
    }
    // 【洗脑师（66）/ 麻脸巫婆（67）】（用户 2026-09-21）：**两个都是玩家自己填** → 唤醒后不弹说书人面板，
    //   由下面那条通用规则把技能面板开出来（先选目标 → 再自己从身份网格里选身份）。
    if (r == 59) {
        BOTC_SageOpen(q, false);
    }
    // 街头风琴手：玩家自己选择是否主动醉酒到下一个黄昏。
    if (r == 140) {
        BOTC_OrganOpen(q);
    }
    // 【理发师（62）】（用户 2026-09-21）：他死的那一晚，这个槽位实际是唤起恶魔交换两名玩家
    if (r == 62) {
        BOTC_BarberOpen(q);
    }
    // 厨师（3）/ 共情者（4）：老的数字框（脚本把正确答案显示在框下面，说书人自己填）
    if ((r == 3 || r == 4)) {
        BOTC_ManInfoOpen(q, r, "");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟共情者 / 厨师一样 ---- 被唤醒时弹数字框，
    //   说书人填「要给他看的座位号」（1~12 → 玩家 2~13），他收到「你得知X。」
    if (r == 72) {
        BOTC_ManInfoOpen(q, 72, "");
        // 【路由】（用户 2026-09-23）：【确定】按钮是按 g_miRole >= 60 派发的，
        //   而那个发送函数的编号惯例是 60 + 角色 → 这里补成 132（= 60 + 72），
        //   它里面的 role == 72 分支才会命中（否则会被算成 72-60 = 12 = 镇长）。
        g_miRole = 132;
    }
    // 【梦殒春宵 · 用户 2026-09-21】钟表匠 / 数学家 的答案由脚本先算好填进框里，你可以直接确定或改掉
    if (r == 47) {
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 47, "");
    }
    if (r == 50) {
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 50, "");
    }
    if (r == 53) {
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 53, "");
    }
    // 【哲学家】（56）：还没选过角色就弹身份网格（只列善良角色，用户 2026-09-21）
    if (r == 56 && !BOTC_ProtectTokOn(q, 70)) {
        BOTC_LimitedAskOpen(q);
    }
    if ((r == 51 || r == 52 || r == 53 || r == 58)) {
        BOTC_ManInfoOpen(q, r, "");
    }
    if (r == 76) {
        BOTC_NobleOpen(q);
    }
    if (r == 90) {
        BOTC_ManInfoOpen(q, 90, "");
        g_miRole = 150;
    }
    if (r == 91) {
        BOTC_MiFnOpen(q, 26);
    }
    if (r == 85 && BOTC_ActingIsFirstNight(q)) {   // 【只有首夜】（用户 2026-10-18）
        BOTC_MezeOpen(q);
    }
    // 【风雅集（板子 10）】（用户 2026-10-16）：修行者（114）两选一 / 店小二（115）填两名玩家
    if (r == 114) {
        BOTC_SgOpen(q);
    }
    if (r == 115) {
        BOTC_ManInfoOpenSeats(q, "【店小二】填他要得知的两名善良玩家（左 / 右各一个座位号 1~12）", 12);
    }
    // 【数学家】效果类角色（要选人那种）：中毒 / 酒鬼还用了能力 = 能力被挡下 → 记一格「未正常生效」
    //   信息类的几位改成「说书人给的答案和真身对不上才记」，见 BOTC_MalfNote（用户 2026-09-21）
    if (!BOTC_SkillWorks(q) && g_roleTargets[r] > 0 && r != 24 && r != 50 && r != 55 && r != 27) {
        BOTC_MalfMark(q);
    }
    // 【被唤醒就直接弹技能面板】（用户 2026-09-20）：教父（39）只在「今天有外来者死」那晚才弹（首夜只听信息）
    // 【理发师（62）】（用户 2026-09-21）：他的面板由 BOTC_BarberOpen 自己开（要换成交换用的标题），这里跳过
    if (g_started && r >= 0 && r <= 148 && g_roleTargets[r] > 0 && r != 36 && r != 62 && r != 64 && !(r == 119 && g_nightNum >= 2) && (r != 39 || BOTC_GodfatherCanKill())) {   // 逆臣：只有首夜选人
        BOTC_SkillOpen(q);
    }
    // 【电脑玩家：唤醒之后自动替他选目标】（用户 2026-09-20）
    if (BOTC_SeatIsComputer(q) && (r != 39 || BOTC_GodfatherCanKill()) && !(r == 135 && BOTC_ActingIsFirstNight(q))) {  // 教父不能动 / 卡扎力首夜只私聊
        BOTC_TestAutoSkill(q);
        if (g_gambleWait[q]) {
            BOTC_TestAutoSkill(q);    // 赌徒：第一次是选人，第二次才是猜角色
        }
        if (g_skillT1[q] > 0) {
            BOTC_PmStore(g_teller, "【电脑】" + BOTC_NameStr(q) + " 是电脑：脚本自动替他选了目标。");
        }
    }
}

// 兼容所有自动唤醒调用：自动流程仍完整使用行动类别、限次和夜间顺序判定。
void BOTC_WakeToggle (int q) {
    BOTC_WakeApply(q, false);
}

void BOTC_SkillBtnRender () {
    int p;
    int r;
    bool useBtn;
    for (p = 2; p <= 13; p += 1) {
        r = g_mark[(g_teller * 14) + p] - 1;
        // 18 = 间谍：技能不用选目标（直接看说书人的魔典），所以也算「有技能按钮」的角色
        useBtn = false;
        if (g_started && g_awake[p] && r >= 0 && r <= 148 && (g_roleTargets[r] > 0 || r == 18) && !(r == 119 && g_nightNum >= 2)) {   // 逆臣：只有首夜
            useBtn = true;
        }
        // 每局限一次的角色：用掉了就不再给按钮（用户 2026-09-20）
        if (r == 29 && g_courtUsed[p]) {
            useBtn = false;
        }
        if (r == 30 && g_profUsed[p]) {
            useBtn = false;
        }
        if (r == 41 && g_assiUsed[p]) {
            useBtn = false;
        }
        // 技能面板已经改成「被唤醒就自动弹」，所以按钮不再需要了 ----
        //   只有间谍（18）还留着：他没有目标可选，点一下直接看说书人那份魔典
        if (useBtn && r == 18) {
            DialogSetVisible(g_skillBtnDlg[p], PlayerGroupSingle(g_who[p]), true);
        }
        else {
            DialogSetVisible(g_skillBtnDlg[p], PlayerGroupSingle(g_who[p]), false);
            if (!g_awake[p]) {
                DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            }
        }
    }
}

void BOTC_SkillOpen (int p) {
    int r;
    r = BOTC_ActRoleOf(p);
    // 理发师交换优先于被唤醒恶魔的原能力：统一显示两个目标槽。
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        g_skillPicking[p] = true;
        DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
        libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("选择两名玩家"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
        return;
    }
    // 珀：未憋刀时每夜先询问；憋刀后的下一夜直接进入强制三目标。
    if (r == 46 && !BOTC_ProtectTokOn(p, 52)) {
        BOTC_PoAskOpen(p);
        return;
    }
    // 限次角色先问是否发动；选「否」不消耗机会，选「是」后才进入技能面板。
    if (BOTC_NightLimitRole(r) && !BOTC_NightLimitUsed(p, r)) {
        BOTC_LimitedAskOpen(p);
        return;
    }
    if (g_boffinActing[p] && !BOTC_BoffinWorksAt(g_boffinActingSource[p])) {
        BOTC_PmStore(g_teller, "【科学怪人】来源已经失效，这次借用能力不能打开面板。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_bnestActing[p] && !BOTC_BoffinNestedWorksAt(g_bnestSource[p], p)) {
        BOTC_PmStore(g_teller, "来源已经失效，这次能力不能打开面板。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_grantActing[p] && (g_grantRoleBy[p] <= 0 || g_grantRoleBy[p] > 148)) {
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【逆臣（119）】（用户 2026-10-16）：他**只有首夜**能选人 ---- 第二晚起不弹这个面板
    //   （他第二晚起只在「不共戴天的人被处决」那一夜被告知转阵营，见 BOTC_WakeToggle 的 119 分支）
    if (r == 119 && g_nightNum >= 2) {
        return;
    }
    // 侍臣（29）：他选的是**角色**不是座位 ---- 直接弹身份网格（用户 2026-09-20）
    if (r == 29) {
        BOTC_CourtierOpen(p);
        return;
    }
    // 奥赫（134）：他选的也是**角色**不是座位 ---- 直接弹身份网格
    if (r == 134) {
        BOTC_OjoOpen(p);
        return;
    }
    // 卡扎力（135）：首夜自动唤醒后只与说书人私聊，不打开刀人面板；之后正常选人。
    if (!g_boffinActing[p] && r == 135 && BOTC_ActingIsFirstNight(p)) {
        return;
    }
    // 哲学家（56）：他选的也是**角色**不是座位 ---- 直接弹身份网格（只列善良角色，用户 2026-09-21）
    if (r == 56 && !g_boffinActing[p] && !g_bnestActing[p]) {
        BOTC_PhiloOpen(p);
        return;
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    g_skillRoleSel[p] = 0;
    g_skillPicking[p] = true;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_SkillRender(p);      // 先显示面板再刷槽位：免得显示动作把子控件的显隐覆盖掉
    if (BOTC_ComboRole(r)) {
        BOTC_Notice(g_who[p], "请选择目标1和角色");
    }
    else {
        BOTC_Notice(g_who[p], BOTC_SkillPickTextFor(p));
    }
}

void BOTC_SkillRender (int p) {
    int r;
    r = BOTC_ActRoleOf(p);

    // 【说书人那一格】（用户 2026-09-21 报「生死无常面板点不动」的根因）：
    //   麻脸巫婆的「生死无常」这类面板开在**玩家 1** 身上，他在魔典上没有身份（r = -1）----
    //   原来这里直接 return，于是槽位文字永远不刷新：说书人点座位看着像没反应。
    //   现在 p == g_teller 放行（标题留给调用方自己写，别覆盖）。
    if (r < 0 || r > 148) {
        if (g_who[p] != g_teller) {
            return;
        }
    }
    else {
        // 限次角色确认发动后不给取消；理发师交换仍可在开始前放弃。
        if (!BOTC_NightLimitRole(r) && p == g_barberFrom) {
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
        }
        else {
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
        }
        libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText(BOTC_SkillPickTextFor(p)), PlayerGroupSingle(g_who[p]));
    }
    // 一名玩家 + 一个角色：左侧目标、右侧角色按钮、右下确认。
    if (BOTC_ComboRole(r)) {
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
        libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("选择一名玩家和一个角色"), PlayerGroupSingle(g_who[p]));
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT1[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：") + BOTC_PlayerNameText(g_skillT1[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillRoleSel[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("选择角色：" + g_roleName[g_skillRoleSel[p] - 1]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("选择角色"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
        DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
        libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
        return;
    }
    // 【生死无常】（用户 2026-09-21）：这块面板自己写着「【取消】= 今晚不杀」，所以照旧给取消键
    if (g_who[p] == g_teller && g_hagKill) {
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_teller), true);
    }
    // 前置「是否发动技能」会隐藏全部目标槽；进入真正技能面板时必须把目标1恢复显示。
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
    if (g_skillT1[p] > 0) {
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：") + BOTC_PlayerNameText(g_skillT1[p]), PlayerGroupSingle(g_who[p]));
    }
    else {
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
    }
    // ■ 珀（46）的「攻击三次」：三个目标（1/2 横排 + 3 在下面中间）---- 用户 2026-09-20
    if (BOTC_TargetsOf(p) >= 3) {
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 41);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 41);
        DialogControlSetPosition(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 144, 99);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT2[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：") + BOTC_PlayerNameText(g_skillT2[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        }
        if (g_skillT3[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotC[p], StringToText("目标3：") + BOTC_PlayerNameText(g_skillT3[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotC[p], StringToText("目标3：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 169);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 169);
        // 【攻击三次（珀）】那一夜必须选满 3 个目标：连【不选】都不给（用户 2026-09-20）
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
        return;
    }
    // 不是三目标：第三个槽收起来（藏到画面外）
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
    // 珀的「不发动」已经移到唤醒后的前置询问，目标面板里不再显示「不选」。
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
    if (BOTC_TargetsOf(p) >= 2) {      // 理发师交换时恶魔也要选两个目标（用户 2026-09-21）
        // 占卜师：两个目标槽并排摆
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT2[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：") + BOTC_PlayerNameText(g_skillT2[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
    }
    else {
        // 其它夜间角色（僧侣 / 守鸦人 / 投毒者 / 管家 / 小恶魔）：只要一个目标，槽位居中、第二个槽收起来
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 144, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);   // 兜底：藏到画面外
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    }
}

bool BOTC_SelfForbidden (int r) {
    return (r == 7 || r == 13 || r == 24 || r == 48 || r == 55 || r == 148);
}

void BOTC_SkillPickSeat (int p, int q) {
    int need;
    if (!g_skillPicking[p]) {
        return;
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_TargetMustBeLiving(p) && !BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    if (p == 1 && g_boffinRecipientPick) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
            BOTC_Notice(g_teller, "科学怪人能力只能交给一名存活的恶魔。");
            return;
        }
    }
    if (g_ojoAskSt && p == 1 && !g_ojoAllow[q]) {
        BOTC_Notice(g_teller, "这个座位不在奥赫这次可选的范围内。");
        return;
    }

    if (p == q) {
        if (BOTC_SelfForbidden(BOTC_ActRoleOf(p))) {
            BOTC_Notice(g_who[p], "这个角色的技能表写了「除你以外」，不能选自己。");
            return;
        }
    }
    need = BOTC_TargetsOf(p);
    if (g_skillT1[p] == q) {
        g_skillT1[p] = 0;
    }
    else {
        if (g_skillT2[p] == q) {
            g_skillT2[p] = 0;
        }
        else {
            if (g_skillT3[p] == q) {
                g_skillT3[p] = 0;
            }
            else {
                if (g_skillT1[p] == 0) {
                    g_skillT1[p] = q;
                }
                else {
                    if (need >= 2 && g_skillT2[p] == 0) {
                        g_skillT2[p] = q;
                    }
                    else {
                        if (need >= 3 && g_skillT3[p] == 0) {
                            g_skillT3[p] = q;
                        }
                        else {
                            g_skillT1[p] = q;
                        }
                    }
                }
            }
        }
    }
    BOTC_SkillRender(p);
}

int BOTC_PickBoardGood () {
    int i;
    int r;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (BOTC_RoleTeam(r) == 0 && !BOTC_RoleInPlay(r)) {
            return r;
        }
    }
    return 0;
}

void BOTC_RangerOpen (int p, int target) {
    int q;
    if (p < 1 || p > 13 || target < 2 || target > 13) {
        return;
    }
    // 【给说书人弹，不是给巡山人自己弹】（用户 2026-10-04 报）：
    //   选「落难少女变成哪个镇民」是**说书人**的事（跟他平时给玩家改身份一样），
    //   所以面板固定开在玩家 1 身上；p 仍然是巡山人本人（g_rangerBy 记他，日志也写他）。
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);   // 巡山人自己那份技能面板收掉
    g_skillPicking[p] = false;
    g_rangerWho = target;
    g_rangerBy = p;
    g_pickMode[g_teller] = 18;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 0;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 0) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_RangerPick (int role) {
    int t;
    t = g_rangerWho;
    if (t < 2 || t > 13 || role < 0 || role > 148) {
        return;
    }
    BOTC_SetSeatRole(g_teller, t, role);
    BOTC_SetSeatRole(g_who[t], t, role);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, role);
    BOTC_PmStore(g_teller, "【巡山人】落难少女（" + BOTC_NameStr(t) + "）变成了 " + g_roleName[role] + "。");
}

//--------------------------------------------------------------------------------------------------
// 【悟道者（118）】（用户 2026-10-16）
//   ① 首夜：说书人点他「以为」的那张外来者卡（**认知覆盖类不能选**：酒鬼 14 / 疯子 38）----
//      点完脚本把这一格（说书人那份 + 他自己那份）都写成那张外来者卡，并打「是悟道者」140（真身读回 118）。
//   ② 被**邪恶玩家**的能力选择 / 影响 → 他立刻变成一个「不在场的镇民」（说书人从身份网格里点，参考巡山人）。
//      不做白天 / 晚上的区分（用户 2026-10-16）：点完当场就私聊告诉他。
//--------------------------------------------------------------------------------------------------
void BOTC_WudOutsiderOpen (int seat) {
    int q;
    if (seat < 2 || seat > 13) {
        return;
    }
    g_wudSeat = seat;
    g_pickMode[g_teller] = 26;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 1;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 1) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
            continue;
        }
        if (g_gridSlot[q] == 14 || g_gridSlot[q] == 38) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【悟道者】" + BOTC_NameStr(seat) + "：他「以为」自己是哪一个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_WudOutsiderPick (int role) {
    int t;
    t = g_wudSeat;
    if (t < 2 || t > 13 || role < 0 || role > 148) {
        return;
    }
    BOTC_SetSeatRole(g_teller, t, role);
    BOTC_SetSeatRole(g_who[t], t, role);
    g_tokOn[(((g_teller * 14) + t) * 256) + 140] = true;
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(t) + " 以为自己是「" + g_roleName[role] + "」。");
}

// 【悟道者判定「邪恶玩家」】（用户 2026-10-19）：不能只看真身是不是爪牙 / 恶魔。
//   统一按「这个人当前的实际阵营」判：
//     · BOTC_SeatAlign 会读角色自带阵营 + 善良(14) / 邪恶(15) token；初始爪牙 / 恶魔、提线木偶、逆臣转变等都在这里。
//     · 半兽人的「失足」127 按互动登记当作邪恶（它不一定改真身阵营）。
//     · 灵言师手动使用的「转为邪恶」103 也按邪恶算。
bool BOTC_WudPickerEvil (int q) {
    if (q < 1 || q > 13) {      // 允许 1：说书人用 -t 测试时也能认真身 / 阵营 token
        return false;
    }
    if (BOTC_SeatAlign(q) == 1) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 127)) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 103)) {
        return true;
    }
    return false;
}

