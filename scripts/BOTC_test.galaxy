    // ---- 【心理博弈 XI】官网角色详情文案与范围覆盖 ----
    g_tipRoleAt[90] = 2501;   g_tipRoleN[90] = 34;
    g_tipRoleAt[76] = 2535;   g_tipRoleN[76] = 17;
    g_tipRoleAt[125] = 2552;   g_tipRoleN[125] = 16;
    g_tipRoleAt[26] = 2568;   g_tipRoleN[26] = 15;
