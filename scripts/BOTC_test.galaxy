}

// 每条摆到 (col,row)：图标按钮 + 名字 + 能力（位置/大小 = 旧版排版，一模一样）
void BOTC_AbNewEntry (int p, int slot, int r, int x, int y, int w) {
    g_abNewRole[slot] = r;
    DialogControlSetPosition(g_abNewHit[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_abNewIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    libNtve_gf_SetDialogItemImage(g_abNewIcon[slot], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_abNewName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 4);
    DialogControlSetPosition(g_abNewAb[slot], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 34);
    // 【条目宽度 w】（用户 2026-10-04）：爪牙 / 恶魔 那两段改成**三列**，文字框必须跟着变窄，
    //   否则会压到右边那一列的图标上。镇民 / 外来者 / 传奇仍然用 460（两列）。
    DialogControlSetSize(g_abNewName[slot], PlayerGroupSingle(p), w, 26);
    DialogControlSetSize(g_abNewAb[slot], PlayerGroupSingle(p), w, 78);
    libNtve_gf_SetDialogItemText(g_abNewName[slot], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abNewAb[slot], BOTC_KeyColor(g_tipAbility[r]), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abNewHit[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewIcon[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewName[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewAb[slot], PlayerGroupSingle(p), true);
}

void BOTC_AbCatCtrlRender (int p, int t) {
    int cap;
    int page;
    int pages;
    int y;
    if (p < 1 || p > 13 || t < 0 || t > 3) {
        return;
    }
    cap = BOTC_AbCatCap(t);
    pages = BOTC_GridCatPages(t, cap);
    page = g_abCatPage[(p * 4) + t];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_abCatPage[(p * 4) + t] = page;
    if (pages <= 1) {
        DialogControlSetVisible(g_abCatPrev[t], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abCatNext[t], PlayerGroupSingle(p), false);
        return;
    }
    // 镇民有两列，底部最后一行结束于 y=822；翻页按钮放到它右下方的空行。
    y = 834;
    if (t == 1) { y = 46; }
    if (t == 2) { y = 416; }
    if (t == 3) { y = 686; }
    DialogControlSetPosition(g_abCatPrev[t], PlayerGroupSingle(p), c_anchorTopLeft, 865, y);
    DialogControlSetPosition(g_abCatNext[t], PlayerGroupSingle(p), c_anchorTopLeft, 909, y);
    libNtve_gf_SetDialogItemText(g_abCatPrev[t], StringToText("<"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abCatNext[t], StringToText(">"), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abCatPrev[t], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abCatNext[t], PlayerGroupSingle(p), true);
}

//==================================================================================================
// 【角色能力表 · 第 3 页：名词解释】（用户 2026-09-20）
//   每个词条带 1~3 个关键词；只要**当前板子里有角色带这个关键词**（g_roleKey），就显示这一条。
//   所以换板子会自动跟着变：没有「可能」类角色的板子就不会出现「可能」这条。
//==================================================================================================
void BOTC_InitGloss () {
    int i;
    for (i = 0; i < 149; i += 1) {
        g_roleKey[i] = "";
    }
    // ---- 每个角色身上带的关键词（多个用 | 隔开）----
    g_roleKey[0] = "首个夜晚";      g_roleKey[1] = "首个夜晚";      g_roleKey[2] = "首个夜晚";
    g_roleKey[3] = "首个夜晚";      g_roleKey[9] = "失去能力";
    g_roleKey[6] = "每个夜晚*";     g_roleKey[7] = "每个夜晚*";     g_roleKey[21] = "每个夜晚*";
    g_roleKey[10] = "每局限一次|失去能力";
    g_roleKey[12] = "可能";         g_roleKey[14] = "中毒|醉酒";
    g_roleKey[17] = "中毒";         g_roleKey[22] = "首个夜晚";
    g_roleKey[23] = "醉酒|可能";    g_roleKey[26] = "醉酒|可能";
    g_roleKey[28] = "可能";         g_roleKey[29] = "每局限一次|醉酒|失去能力";
    g_roleKey[30] = "每局限一次|复活|起死回生|失去能力";
    g_roleKey[31] = "醉酒";         g_roleKey[33] = "可能";
    g_roleKey[34] = "失去能力";     g_roleKey[35] = "可能";
    g_roleKey[37] = "醉酒";         g_roleKey[39] = "首个夜晚";
    g_roleKey[41] = "每局限一次|失去能力";
    g_roleKey[43] = "起死回生";     g_roleKey[44] = "中毒";
    g_roleKey[45] = "复活|反刍";
    // ---- 梦殒春宵（板子 3）----
    g_roleKey[47] = "首个夜晚";      g_roleKey[48] = "每个夜晚";
    g_roleKey[49] = "每个夜晚";      g_roleKey[50] = "每个夜晚*|首个夜晚";
    g_roleKey[51] = "每个夜晚*";     g_roleKey[52] = "每个夜晚*";
    g_roleKey[53] = "每个夜晚*";     g_roleKey[55] = "每局限一次|每个夜晚";
    g_roleKey[56] = "每局限一次|首个夜晚";  g_roleKey[57] = "每局限一次";
    g_roleKey[58] = "每个夜晚*";     g_roleKey[59] = "每个夜晚*";
    g_roleKey[60] = "疯狂|可能";     g_roleKey[61] = "中毒|醉酒";
    g_roleKey[62] = "角色变化";      g_roleKey[63] = "失去能力";
    g_roleKey[64] = "首个夜晚";      g_roleKey[65] = "每个夜晚";
    g_roleKey[66] = "疯狂";          g_roleKey[67] = "角色变化";
    g_roleKey[68] = "角色变化|可能";  g_roleKey[69] = "中毒";
    g_roleKey[70] = "中毒";          g_roleKey[71] = "信息错误";
    g_roleKey[76] = "首个夜晚";      g_roleKey[77] = "每局限一次|角色变化";
    g_roleKey[78] = "每局限一次|角色变化";  g_roleKey[79] = "每局限一次";
    g_roleKey[80] = "角色变化";      g_roleKey[81] = "每局限一次";
    g_roleKey[82] = "每局限一次";    g_roleKey[83] = "可能";
    g_roleKey[85] = "首个夜晚|角色变化";    g_roleKey[86] = "首个夜晚";
    g_roleKey[87] = "每个夜晚*";
    // ---- 风雅集（板子 10）----
    g_roleKey[115] = "首个夜晚|醉酒";   g_roleKey[116] = "每个夜晚";
    g_roleKey[117] = "疯狂|可能|角色变化";  g_roleKey[118] = "角色变化";
    g_roleKey[119] = "首个夜晚|可能";   g_roleKey[120] = "角色变化";
    g_roleKey[121] = "中毒";
    // ---- 赎罪小镇（板子 11）----
    g_roleKey[122] = "首个夜晚";   g_roleKey[123] = "每个夜晚*";
    g_roleKey[124] = "每局限一次|每个夜晚*|醉酒";
    g_roleKey[125] = "每个夜晚";   g_roleKey[126] = "可能";
    g_roleKey[127] = "首个夜晚|可能";   g_roleKey[128] = "每局限一次|每个夜晚";
    g_roleKey[129] = "每个夜晚*|可能";
    g_roleKey[130] = "";
    // ---- 信口雌黄（板子 12）----
    g_roleKey[131] = "恶魔|可能|每个白天";
    g_roleKey[132] = "首个夜晚|醉酒|中毒";
    g_roleKey[133] = "首个夜晚|每个白天|可能";
    g_roleKey[134] = "每个夜晚*|可能";
    g_roleKey[135] = "每个夜晚*|可能";
    g_roleKey[136] = "首个夜晚|认知覆盖";
    g_roleKey[137] = "白板";
    g_roleKey[138] = "处决|额外死亡";
    g_roleKey[139] = "每个夜晚|疯狂|额外死亡|暴露角色";
    g_roleKey[140] = "每个夜晚|投票|醉酒|暴露角色";
    g_roleKey[141] = "投票|处决|免死|暴露角色";
    g_roleKey[142] = "首个夜晚";
    g_roleKey[147] = "中毒|设置调整|回溯型能力";
    g_roleKey[148] = "首个夜晚";


    // ---- 词条（按官方 Wiki Glossary / Vortox 词条整理为中文）----
    // 来源：https://wiki.bloodontheclocktower.com/Glossary
    g_glossCount = 7;      // 可能 / 中毒·醉酒 / 反刍·起死回生 / 每个夜晚（*）/ 疯狂 / 角色变化 / 信息错误

    // 【颜色】（用户 2026-09-20）：处决 #800000 / 复活·反刍·起死回生 #7CFC00 / 不会死亡 #1E90FF；中毒·醉酒沿用 #800080
    g_glossTitle[0] = TextWithColor(StringToText("可能"), Color(235, 90, 60));
    g_glossK1[0] = "可能";               g_glossK2[0] = "";                 g_glossK3[0] = "";
    g_glossBody1[0] = StringToText("「可能」表示：该情况是否发生，由说书人最终裁定。");
    g_glossBody2[0] = StringToText("说书人主持游戏、保管魔典并遵循游戏规则，在需要裁定时决定最终结果。");
    g_glossBody3[0] = StringToText("");
    // 【中毒 / 醉酒】
    g_glossTitle[1] = TextWithColor(StringToText("中毒 / 醉酒"), Color(128, 0, 128));
    g_glossK1[1] = "中毒";               g_glossK2[1] = "醉酒";             g_glossK3[1] = "";
    g_glossBody1[1] = StringToText("中毒或醉酒的玩家没有能力，但会认为自己仍有能力，说书人也会表现得像他们仍有能力。");
    g_glossBody2[1] = StringToText("如果其能力会使玩家获得信息，说书人可以提供错误信息；中毒或醉酒的玩家不知道自己的状态。");
    g_glossBody3[1] = StringToText("中毒与醉酒遵循相同规则。");
    // 【起死回生 / 反刍】
    g_glossTitle[2] = TextWithColor(StringToText("反刍 / 起死回生"), Color(124, 252, 0));
    g_glossK1[2] = "复活";               g_glossK2[2] = "反刍";             g_glossK3[2] = "起死回生";
    g_glossBody1[2] = StringToText("死去的玩家再次变为存活玩家。");
    g_glossBody2[2] = StringToText("此时玩家重新获得自己的能力，即使该「每局游戏限一次」能力已经使用过。");
    g_glossBody3[2] = StringToText("如果该能力只在首个夜晚生效，则玩家会在当晚获得该能力。");
    // 【每个夜晚（*）】
    g_glossTitle[3] = TextWithColor(StringToText("每个夜晚（*）"), Color(235, 90, 60));
    g_glossK1[3] = "每个夜晚*";          g_glossK2[3] = "";                 g_glossK3[3] = "";
    g_glossBody1[3] = StringToText("「每个夜晚*」是角色表和角色标记上的简写，表示「除首个夜晚以外的每个夜晚」。");
    g_glossBody2[3] = StringToText("没有星号的「每个夜晚」表示每一个夜晚阶段。");
    g_glossBody3[3] = StringToText("");
    // 【疯狂】
    g_glossTitle[4] = TextWithColor(StringToText("疯狂"), Color(255, 0, 255));
    g_glossK1[4] = "疯狂";               g_glossK2[4] = "";                 g_glossK3[4] = "";
    g_glossBody1[4] = StringToText("「疯狂」是指玩家正试图让团队相信某件事是真的。");
    g_glossBody2[4] = StringToText("若被要求对某事疯狂，而说书人认为玩家没有努力让团队相信该事，则可能受到惩罚。");
    g_glossBody3[4] = StringToText("若被要求不要对某事疯狂，而说书人认为玩家试图让团队相信该事，则也可能受到惩罚。");
    // 【角色变化】
    g_glossTitle[5] = TextWithColor(StringToText("角色变化"), Color(0, 206, 209));
    g_glossK1[5] = "角色变化";           g_glossK2[5] = "";                 g_glossK3[5] = "";
    g_glossBody1[5] = StringToText("角色是玩家所扮演的身份；角色可以在场，也可以不在场。");
    g_glossBody2[5] = StringToText("阵营是玩家当前所属的团队，只能是善良或邪恶。");
    g_glossBody3[5] = StringToText("玩家改变角色时，阵营保持不变；玩家改变阵营时，角色保持不变。");
    // 【信息错误 / 涡流】
    g_glossTitle[6] = TextWithColor(StringToText("信息错误"), Color(255, 140, 0));
    g_glossK1[6] = "信息错误";           g_glossK2[6] = "";                 g_glossK3[6] = "";
    g_glossBody1[6] = StringToText("涡流在场时，镇民通过自身能力获得的所有信息都是错误信息，即使该玩家中毒或醉酒。");
    g_glossBody2[6] = StringToText("涡流不影响通过其他方式获得的信息，例如说书人解释规则，或角色的身份、阵营发生变化时提供的信息。");
    g_glossBody3[6] = StringToText("错误信息可以是错误陈述、手势或角色标记；说书人给出的规则信息必须始终正确。");

}

// 本板子里有没有角色带这个关键词（空的角色关键词会被跳过）
bool BOTC_KeyInPlay (string key) {
    int i;
    int r;
    int b;
    if (StringLength(key) <= 0) {
        return false;
    }
    b = g_board;
    if (b < 1 || b > 13) {
        b = 1;                     // 还没选板子：按第 1 张板子算
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 148) {
            continue;
        }
        if (StringLength(g_roleKey[r]) <= 0) {
            continue;
        }
        if (StringFind(g_roleKey[r], key, false) >= 0) {
            return true;
        }
    }
    return false;
}

// 画第 3 页：把「本板子真的有」的词条自上而下铺出来
void BOTC_GlossRender (int p) {
    int i;
    int n;
    int page;
    int pages;
    int seen;
    int skip;
    int tot;
    bool show;
    libNtve_gf_SetDialogItemText(g_abNewLbl, StringToText("角色能力表  3 / 5 ---- 名词解释"), PlayerGroupSingle(p));
    tot = 0;
    for (i = 0; i < g_glossCount; i += 1) {
        show = false;
        if (BOTC_KeyInPlay(g_glossK1[i])) {
            show = true;
        }
        if (BOTC_KeyInPlay(g_glossK2[i])) {
            show = true;
        }
        if (BOTC_KeyInPlay(g_glossK3[i])) {
            show = true;
        }
        if (show) {
            tot = tot + 1;
        }
    }
    pages = (tot + 5) / 6;
    if (pages < 1) {
        pages = 1;
    }
    page = g_glossPage[p];
    if (page < 1) { page = 1; }
    if (page > pages) { page = pages; }
    g_glossPage[p] = page;
    seen = 0;
    skip = (page - 1) * 6;
    n = 0;
    for (i = 0; i < g_glossCount; i += 1) {
        show = false;
        if (BOTC_KeyInPlay(g_glossK1[i])) {
            show = true;
        }
        if (BOTC_KeyInPlay(g_glossK2[i])) {
            show = true;
        }
        if (BOTC_KeyInPlay(g_glossK3[i])) {
            show = true;
        }
        if (!show) {
            continue;
        }
        if (seen < skip) {
            seen = seen + 1;
            continue;
        }
        if (n >= 6) {
            break;
        }
        libNtve_gf_SetDialogItemText(g_glossTitleCtl[n], BOTC_KeyColor(g_glossTitle[i]), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossTitleCtl[n], PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + 0], BOTC_KeyColor(g_glossBody1[i]), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossBodyCtl[(n * 3) + 0], PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + 1], BOTC_KeyColor(g_glossBody2[i]), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossBodyCtl[(n * 3) + 1], PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + 2], BOTC_KeyColor(g_glossBody3[i]), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossBodyCtl[(n * 3) + 2], PlayerGroupSingle(p), true);
        n = n + 1;
        seen = seen + 1;
    }
    DialogControlSetVisible(g_abSubPrev, PlayerGroupSingle(p), (pages > 1));
    DialogControlSetVisible(g_abSubNext, PlayerGroupSingle(p), (pages > 1));
}

void BOTC_LegacyApply (int b) {
    int i;
    for (i = 0; i < 149; i += 1) {
        g_legacyOn[i] = false;
    }
    if (b < 1 || b > 13) {
        return;
    }
    for (i = 0; i < g_boardLegacyN[b]; i += 1) {
        g_legacyOn[g_boardLegacy[(b * 4) + i]] = true;
    }
}

// 【传奇角色播报】（用户 2026-10-16）：游戏正式开始的时候，把「本局板上带的传奇角色」在左下角公聊播一条。
//   判定 = 这块板的传奇清单（`g_boardLegacy`，进游戏时由 BOTC_LegacyApply 写进 `g_legacyOn`）---- 板子上有就播；
//   说书人在「添加传奇角色」面板里手动开 / 关的也算数。一个传奇都没有就一个字都不播。
void BOTC_LegacyAnnounce () {
    int r;
    int n;
    string s;
    s = "";
    n = 0;
    for (r = 0; r <= 148; r += 1) {
        if (!g_legacyOn[r]) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 5) {
            continue;              // 奇遇角色由私货商人单独播报，不混进传奇角色清单
        }
        if (n > 0) {
            s = s + "、";
        }
        s = s + g_roleName[r];
        n = n + 1;
    }
    if (n <= 0) {
        return;
    }
    BOTC_PubAnnounce("【传奇角色】本局有：" + s + "。");
}


int BOTC_JinxPageCount (int p) {
    int i;
    int tot;
    tot = 0;
    for (i = 0; i < g_jinxCount; i += 1) {
        if (!BOTC_RoleInPlay(g_jinxA[i]) && !BOTC_RoleOnBoard(g_jinxA[i])) {
            continue;
        }
        if (!BOTC_RoleInPlay(g_jinxB[i]) && !BOTC_RoleOnBoard(g_jinxB[i])) {
            continue;
        }

        tot = tot + 1;
    }
    if (tot <= 0) {
        return 1;
    }
    return ((tot + 5) / 6);
}

void BOTC_JinxRender (int p) {
    int i;
    int n;
    int f;
    int pages;
    int page;
    int seen;
    int skip;
    string jx;
    libNtve_gf_SetDialogItemText(g_abNewLbl, StringToText("角色能力表  4 / 5 ---- 相克规则"), PlayerGroupSingle(p));
    pages = BOTC_JinxPageCount(p);
    page = g_jinxPage[p];
    if (page < 1) { page = 1; }
    if (page > pages) { page = pages; }
    g_jinxPage[p] = page;
    n = 0;
    seen = 0;
    skip = (page - 1) * 6;
    for (i = 0; i < g_jinxCount; i += 1) {
        if (!BOTC_RoleInPlay(g_jinxA[i]) && !BOTC_RoleOnBoard(g_jinxA[i])) {
            continue;
        }
        if (!BOTC_RoleInPlay(g_jinxB[i]) && !BOTC_RoleOnBoard(g_jinxB[i])) {
            continue;
        }

        if (seen < skip) {
            seen = seen + 1;
            continue;
        }
        if (n >= 6) {
            break;
        }
        libNtve_gf_SetDialogItemText(g_glossTitleCtl[n], BOTC_KeyColor(StringToText(g_roleName[g_jinxA[i]] + " × " + g_roleName[g_jinxB[i]])), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossTitleCtl[n], PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + 0], BOTC_KeyColor(StringToText(g_jinxText[i])), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossBodyCtl[(n * 3) + 0], PlayerGroupSingle(p), true);
        for (f = 1; f < 3; f += 1) {
            jx = g_jinxText2[i];
            if (f == 2) {
                jx = g_jinxText3[i];
            }
            if (StringLength(jx) > 0) {
                libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + f], BOTC_KeyColor(StringToText(jx)), PlayerGroupSingle(p));
                DialogControlSetVisible(g_glossBodyCtl[(n * 3) + f], PlayerGroupSingle(p), true);
            }
            else {
                libNtve_gf_SetDialogItemText(g_glossBodyCtl[(n * 3) + f], StringToText(""), PlayerGroupSingle(p));
                DialogControlSetVisible(g_glossBodyCtl[(n * 3) + f], PlayerGroupSingle(p), false);
            }
        }
        n = n + 1;
        seen = seen + 1;
    }
    if (n == 0) {
        libNtve_gf_SetDialogItemText(g_glossTitleCtl[0], StringToText("本局没有相克规则。"), PlayerGroupSingle(p));
        DialogControlSetVisible(g_glossTitleCtl[0], PlayerGroupSingle(p), true);
    }
    DialogControlSetVisible(g_abSubPrev, PlayerGroupSingle(p), (pages > 1));
    DialogControlSetVisible(g_abSubNext, PlayerGroupSingle(p), (pages > 1));
}

void BOTC_LegacyRender (int p) {
    int i;
    int n;
    libNtve_gf_SetDialogItemText(g_abNewLbl, StringToText("角色能力表  5 / 5 ---- 传奇 / 奇遇角色"), PlayerGroupSingle(p));
    n = 0;
    for (i = 0; i < 149; i += 1) {
        if (!g_legacyOn[i]) {
            continue;
        }
        BOTC_AbNewEntry(p, n, i, 20 + ((n / 3) * 580), 50 + ((n % 3) * 110), 460);
        n = n + 1;
    }
}

void BOTC_LegacyPanelHide () {
    int i;
    DialogSetVisible(g_legPanel, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_legTitle, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_legClose, PlayerGroupSingle(g_teller), false);
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_legRowName[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_legRowBtn[i], PlayerGroupSingle(g_teller), false);
    }
}

void BOTC_LegacyPanelRender () {
    int i;
    int r;
    DialogSetVisible(g_legPanel, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_legTitle, StringToText("添加传奇 / 奇遇角色（本板子带的）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_legTitle, StringToText("添加传奇 / 奇遇角色（本板子带的）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_legTitle, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_legClose, PlayerGroupSingle(g_teller), true);
    g_legRowN = 0;
    for (i = 0; i < 4; i += 1) {
        if (i >= g_boardLegacyN[g_board]) {
            break;
        }
        r = g_boardLegacy[(g_board * 4) + i];
        g_legRowRole[i] = r;
        libNtve_gf_SetDialogItemText(g_legRowName[i], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(g_teller));
        if (g_legacyOn[r]) {
            libNtve_gf_SetDialogItemText(g_legRowBtn[i], StringToText("已添加（点一下移除）"), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_legRowBtn[i], StringToText("添加"), PlayerGroupSingle(g_teller));
        }
        DialogControlSetVisible(g_legRowName[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_legRowBtn[i], PlayerGroupSingle(g_teller), true);
        g_legRowN = g_legRowN + 1;
    }
    for (i = g_legRowN; i < 4; i += 1) {
        g_legRowRole[i] = -1;
        DialogControlSetVisible(g_legRowName[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_legRowBtn[i], PlayerGroupSingle(g_teller), false);
    }
}

void BOTC_LegacyRowToggle (int i) {
    int r;
    if (i < 0 || i > 3) {
        return;
    }
    r = g_legRowRole[i];
    if (r < 0) {
        return;
    }
    g_legacyOn[r] = !g_legacyOn[r];
    BOTC_LegacyPanelRender();
    // 【暴风捕手（113）】（用户 2026-10-11）：在「添加传奇角色」里点开/关掉他时，立刻同步一次 ----
    //   开 → 公聊播报「暴风捕手保护X」+ 给保护身份打免死；关 → 撤掉标记
    if (r == 113) {
        BOTC_StormSync();             // 开/关暴风捕手就同步 token（播报本身要等游戏正式开始）
    }
}

void BOTC_AbNewRender (int p) {
    int f;
    int i;
    int t;
    int cap;
    int page;
    int pages;
    int start;
    int shown;
    int base;
    BOTC_GridPlan();           // 【保险】每次渲染都按当前板子重算一遍格子（用户 2026-09-19）
    BOTC_GridBuildCat();
    for (i = 0; i < 26; i += 1) {
        DialogControlSetVisible(g_abNewHit[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abNewIcon[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abNewName[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abNewAb[i], PlayerGroupSingle(p), false);
    }
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_abNewSec[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abCatPrev[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abCatNext[i], PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_abNewStarNote, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_abSubPrev, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_abSubNext, PlayerGroupSingle(p), false);
    // 名词页的控件先全部藏起来（不是第 3 页的时候就保持藏着的状态）
    DialogControlSetVisible(g_glossNote, PlayerGroupSingle(p), false);
    for (f = 0; f < 6; f += 1) {
        DialogControlSetVisible(g_glossTitleCtl[f], PlayerGroupSingle(p), false);
    }
    for (f = 0; f < 24; f += 1) {
        DialogControlSetVisible(g_glossBodyCtl[f], PlayerGroupSingle(p), false);
    }
    if (g_abPage[p] == 3) {
        BOTC_GlossRender(p);
        return;
    }
    if (g_abPage[p] == 4) {
        BOTC_JinxRender(p);
        return;
    }
    if (g_abPage[p] == 5) {
        BOTC_LegacyRender(p);
        return;
    }
    // 第 1、2 页（角色能力表）正下方那条注释
    DialogControlSetVisible(g_abNewStarNote, PlayerGroupSingle(p), true);
    if (g_abPage[p] <= 1) {
        libNtve_gf_SetDialogItemText(g_abNewLbl, StringToText("角色能力表  1 / 5 ---- ") + TextWithColor(StringToText("善良阵营·镇民"), BOTC_RoleTeamColor(0)), PlayerGroupSingle(p));
        t = 0;
        cap = BOTC_AbCatCap(t);
        pages = BOTC_GridCatPages(t, cap);
        page = g_abCatPage[(p * 4) + t];
        if (page < 1) { page = 1; }
        if (page > pages) { page = pages; }
        g_abCatPage[(p * 4) + t] = page;
        start = (page - 1) * cap;
        shown = g_gridCatN[t] - start;
        if (shown > cap) { shown = cap; }
        for (i = 0; i < shown; i += 1) {
            BOTC_AbNewEntry(p, i, g_gridCatRole[(t * 128) + start + i], 20 + ((i / 7) * 580), 50 + ((i % 7) * 110), 460);
        }
        BOTC_AbCatCtrlRender(p, 0);
    }
    else {
        libNtve_gf_SetDialogItemText(g_abNewLbl, StringToText("角色能力表  2 / 5 ---- 外来者 / 爪牙 / 恶魔"), PlayerGroupSingle(p));
        for (t = 1; t <= 3; t += 1) {
            cap = BOTC_AbCatCap(t);
            pages = BOTC_GridCatPages(t, cap);
            page = g_abCatPage[(p * 4) + t];
            if (page < 1) { page = 1; }
            if (page > pages) { page = pages; }
            g_abCatPage[(p * 4) + t] = page;
            start = (page - 1) * cap;
            shown = g_gridCatN[t] - start;
            if (shown > cap) { shown = cap; }
            base = 0;
            if (t == 2) { base = 6; }
            if (t == 3) { base = 12; }
            if (t == 1) {
                libNtve_gf_SetDialogItemText(g_abNewSec[t - 1], TextWithColor(StringToText("善良阵营·外来者"), BOTC_RoleTeamColor(t)), PlayerGroupSingle(p));
                DialogControlSetPosition(g_abNewSec[t - 1], PlayerGroupSingle(p), c_anchorTopLeft, 20, 46);
            }
            if (t == 2) {
                libNtve_gf_SetDialogItemText(g_abNewSec[t - 1], TextWithColor(StringToText("邪恶阵营·爪牙"), BOTC_RoleTeamColor(t)), PlayerGroupSingle(p));
                DialogControlSetPosition(g_abNewSec[t - 1], PlayerGroupSingle(p), c_anchorTopLeft, 20, 416);
            }
            if (t == 3) {
                libNtve_gf_SetDialogItemText(g_abNewSec[t - 1], TextWithColor(StringToText("邪恶阵营·恶魔"), BOTC_RoleTeamColor(t)), PlayerGroupSingle(p));
                DialogControlSetPosition(g_abNewSec[t - 1], PlayerGroupSingle(p), c_anchorTopLeft, 20, 686);
            }
            DialogControlSetVisible(g_abNewSec[t - 1], PlayerGroupSingle(p), (g_gridCatN[t] > 0));
            for (i = 0; i < shown; i += 1) {
                if (t == 1) {
                    BOTC_AbNewEntry(p, base + i, g_gridCatRole[(t * 128) + start + i], 20 + ((i / 3) * 580), 76 + ((i % 3) * 110), 460);
                }
                else {
                    if (t == 2) {
                        BOTC_AbNewEntry(p, base + i, g_gridCatRole[(t * 128) + start + i], 20 + ((i % 3) * 385), 446 + ((i / 3) * 110), 250);
                    }
                    else {
                        BOTC_AbNewEntry(p, base + i, g_gridCatRole[(t * 128) + start + i], 20 + ((i % 3) * 385), 716 + ((i / 3) * 110), 250);
                    }
                }
            }
            BOTC_AbCatCtrlRender(p, t);
        }
    }
}
