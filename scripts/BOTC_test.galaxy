    g_tipLine[698] = StringToText("如果") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("攻击了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("会死去并转变为") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营。");
    g_tipLine[699] = StringToText("如果") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("攻击了尚未触发能力的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("（不论因为什么理由），") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("会死去，但在死后触");
