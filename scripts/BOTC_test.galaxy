    g_tipLine[452] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[453] = StringToText("引路人");
    g_tipLine[454] = StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知引路人是否醒来，即使她是在引路人之前醒来。");
