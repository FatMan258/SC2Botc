    g_jinxText3[126] = "";
    g_jinxA[127] = 118;  g_jinxB[127] = 105;
    g_jinxText[127] = "悟道者与村夫：如果村夫不足 3 人，悟道者可以变成新的村夫；超过 1 名村夫时有一名村夫醉酒。";
