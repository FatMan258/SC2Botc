    libNtve_gf_SetDialogItemAcceptMouse(g_alcTitle, false, PlayerGroupAll());
    g_alcSpyBtn = BOTC_NewButton(g_alcDlg, 150, 52, 35, 85, "猜间谍");
    g_alcWidowBtn = BOTC_NewButton(g_alcDlg, 150, 52, 205, 85, "猜寡妇");
    g_alcCancelBtn = BOTC_NewButton(g_alcDlg, 150, 52, 375, 85, "取消");
    DialogControlSetVisible(g_alcSpyBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_alcWidowBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_alcCancelBtn, PlayerGroupAll(), false);

}

