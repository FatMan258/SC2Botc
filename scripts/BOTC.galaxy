    g_execBtn = BOTC_NewButton(g_grimDlg, 162, 36, 468, 9, "处决标记");
    DialogControlSetVisible(g_execBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupSingle(g_teller), true);
    // 说书人专用的「死亡标记」按钮（夜杀 / 诅咒致死等，不占处决名额）
    g_deadBtn = BOTC_NewButton(g_grimDlg, 162, 36, 635, 9, "死亡标记");
    DialogControlSetVisible(g_deadBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(g_teller), true);
    // 【强制玩家发起提名】（用户 2026-11-03）：放在处决标记左边；按钮够宽，不能出现省略号
    g_fnBtn = BOTC_NewButton(g_grimDlg, 240, 36, 222, 9, "强制玩家发起提名");
    DialogControlSetVisible(g_fnBtn, PlayerGroupAll(), false);
    // 弹窗：目标1 / 目标2 各一个列表，选好后点【发起提名】或【取消】
    DialogCreate(700, 380, c_anchorCenter, 0, 0, false);
