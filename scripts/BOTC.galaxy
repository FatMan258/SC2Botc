    g_musicPubName = "gongliao1";                  // 白天公聊时间
    g_musicNomName = "timing";                     // 白天提名阶段
    g_musicSilentName = "moren";                   // 自己做的「静音」音轨（停音乐时用它顶住）
    // 把这条静音音轨设成**默认**音轨：这样一旦当前音轨被停掉，引擎回落到的是它（安静），
    //   而不是星际自带的种族音乐（就是「暂停音轨之后还会冒出星际原生音乐」那个现象）
    SoundtrackDefault(PlayerGroupAll(), c_soundtrackCategoryMusic, g_musicSilentName, c_soundtrackCueAny, c_soundtrackIndexAny);
    g_musicPubSmallName = "gongliao2";             // 在场 ≤ 4 人：白天的曲子（公聊 / 私聊 / 自由都用它）
    g_musicNomSmallName = "timing2";               // 在场 ≤ 4 人：提名阶段的曲子
    g_sfxDayName = "baitian";                      // 天亮那声（音效；放 4 秒后淡出）
    // 入夜那声提示音（数据编辑器「音效」里的 ID）。
    //   ⚠ 大小写敏感：要写 "Ping"（小写 ping 会报「请求的声音文件未知」）。
    //     想换成自己的提示音：数据编辑器 → 音效 → 新建一个指向你导入的音频，把 ID 填这里；
    //     或者在游戏里用聊天指令 sfx <名字> 现场试。
    g_sfxPingName = "Ping";
    // 大提示的字体样式（聊天里 style <名字> 能现场换）。
    //   ObjectiveDisplay = 星际剧情里那种「任务目标」大字，比原来的 UnitWireframeVitalLarge 大得多
    g_bigStyle = "ObjectiveDisplay";
    // 提名开始那 4 个字：先跟夜晚大字用同一个样式（聊天里 nstyle <名字> 能现场换成更大的）
    g_nomBigStyle = "ObjectiveDisplay";
    // 魔典座位名的字体（原来靠 mod 里的字体表才有 UnitWireframeVitalLarge，新 mod 没带 → 用基础游戏里
    //   确定有的小字号；聊天里 gstyle <名字> 能现场换着看）
    g_grimNameStyle = "ModLeftSize16Bold";
    g_nameNumShift = 0;            // 名字前的序号 = 游戏内号 + 0（= 跟游戏里一致；差一位就用 nameoff -1 / nameoff 1 现场调）
    g_sfxNomName = "timingkaishi";                 // 提名开始那声（数据编辑器「音效」里的 ID）
    g_sfxChargeName = "Raynor_PenetratorRoundChargeUp";   // 猎手射中恶魔：充能音
    g_sfxSnipeName = "RaynorSnipeSound";                  // 猎手射中恶魔：枪声（死亡在这一刻结算）
    g_snipeStage = 0;
    g_snipeTarget = 0;
    g_snipeHunter = 0;
    g_sfxJieSuanName = "jiesuan";                  // 某方胜利时的结算过场音效（放 2 秒后淡出）
    g_sfxCountName = "daojishi";                   // 入夜 5 秒倒计时那声
    // UI 音效（只放给当事人）：收到私聊请求 / 私聊建立（用户 2026-09-16 指定）
    g_sfxReqName = "UI_ReplayDropdownSelect";
    g_sfxPmOnName = "UI_PTTStart";
    g_sfxStartName = "UI_ObjectiveComplete";      // 说书人点【游戏正式开始】
    g_sfxChatName = "UI_ObjectiveUpdate";         // 有人往公屏说话（每一句）
    // 正式开始那个 10 秒倒计时：换局先复位（计时器本身在 BOTC_Init 里建）
    g_startCdOn = false;
    g_startCdSec = 0;
    g_startPending = false;
    g_musicGood1Name = "shanliangshengli1";        // 善良胜
    g_musicGood2Name = "shanliangshengli2";        // 善良胜 + 存活 ≤ 3
    g_musicEvilName = "xieeshengli";               // 邪恶胜
    g_winStage = false;
    g_winReason = "";
    g_endStyle = "ObjectiveDisplay";               // 结算那句话的字体样式（聊天里 wstyle <名字> 能换）
    g_endSize = 2.0;                               // 创建标签最后那个参数的原值（wbig 能改）
    g_chatAlpha = 60;                              // 公聊 / 私聊那层黑底的不透明度（bg <数字> 现场调）
    // 【调试总开关】默认关闭：诊断日志（【诊断·...】）、测试播报（【测试】...）、真魔典同步都不再出现，
    //   玩正式局时界面干净。想再调试：聊天里发 debug（玩家1 / 玩家2），或把这里改成 true。
    g_debugOn = false;
    g_logLiveUpdate = false;
    g_pmInfoMirrorOn = false;       // 私聊镜像测试开关默认关闭，换局复位
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_nightPend = false;
    g_nightPendSec = 0;
    g_nomBigOn = false;
    g_nomBigIdx = 0;
    g_nomBigHold = 0;
    g_nomBigSize = 2.0;                            // 创建标签最后一个参数的原值（试 nbig 时可以改）
    g_musicNow = "";
    g_musicPrio = 0;
    g_musicPendPrio = 0;
    g_musicPending = "";                           // 换局时把「等着要放的那首」也清掉
    g_dealConfirmed = false;
    for (i = 0; i < 14; i += 1) {
        g_ftChkSeat[i] = false;
        g_deadType[i] = -1;            // 死因一律先清成「没记」（不然 0 会被当成表里第 1 条 = 小恶魔那一刀）
        g_grimShareCd[i] = 0;           // 换局清空一键发送魔典冷却
        g_declareCd[i] = 0;             // 换局清空声称冷却
        g_skipCd[i] = 0;                // 换局清空快进按钮冷却
        g_blockCd[i] = 0;               // 换局清空屏蔽冷却
        g_spamMute[i] = 0;              // 换局清空公聊禁言
        g_spamWin[i] = 0;
        g_spamCnt[i] = 0;
    }
    // 「查身份」用过的身份（酒鬼 / 中毒的送葬者）：换局清空（表已扩到 128）
    for (i = 0; i < 164; i += 1) {
        g_idUsed[i] = false;
    }
    // 共情者的「邪恶名额」记录：换局清空
    for (i = 0; i < 14; i += 1) {
        g_empMark[i] = false;
    }
    // 中毒 / 酒鬼的人来查有伪装口供的人时，看到「自称身份」的概率（百分比）
    g_claimChance = 85;
    // 持续信息位「看反某个座位」的概率（百分比）；恶魔不受影响
    g_viewFlipChance = 70;
    g_mayorBounceChance = 80;     // 镇长替死判定的概率（百分比）
    for (i = 0; i < 14; i += 1) {     // 【哥布林】换局清空：上一局的声明不留到这一局
        g_goblinClaimDay[i] = 0;
        g_goblinClaim[i] = false;
    }
    g_winSide = 0;
    g_winLocked = false;
    g_winPanelOn = false;
    g_manualWin = false;
    g_gameOver = false;
}

// 参与座位表：玩家 2..13 里真正在游戏中的座位，写进 g_seatList[0..g_seatN-1]。
// 发牌、开始校验、圆桌摆位都用这一套，避免「空位」和「在场玩家」对不上。
void BOTC_BuildSeatList () {
    int i;
    int n;
    playergroup ag;

    ag = PlayerGroupActive();
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        // 【顺位接手的说书人，他原来那个玩家号不进圈】（用户 2026-10-07）：
        //   正常情况（说书人就是 1 号位）时 g_hideSeat = 0，等于没排除；
        //   只有"玩家1 不在、由 2..13 里的某位顺位接手"时才排除他那一格。
        //   ⚠ 不能用 `i != g_teller` —— 换说书人之后 g_teller 会变成玩家号，
        //     那样别人接手时会把新说书人原来那一格也剔掉（用户实测：点【换说书人】会掉一格）。
        // 【座位机制】（用户 2026-10-07 报「走了个人，被移除的却是"编号11"那一格」）：
        //   i 是**格子**，在场要问"坐这一格的人" g_who[i]；原来拿格子号当玩家号问 PlayerGroupHasPlayer
        //   → 谁走了就移除"编号 = 他物理号"的那一格，而不是他自己坐的那一格。
        // 【中途退出的玩家保留座位】（用户 2026-11-01）：游戏已开始时退出 → 座位不删，
        //   一直留到胜利结算后由 BOTC_ClearLeftSeats() 统一移除；未开始时照旧直接掉座。
        if ((PlayerGroupHasPlayer(ag, g_who[i]) || g_leftKeepP[g_who[i]]) && g_who[i] != g_hideSeat) {
            g_seatList[n] = i;
            n = n + 1;
        }
    }
    if (n < 2) {
        // 单人测试（只有说书人在场）：按满桌 12 席处理，方便调试
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            g_seatList[n] = i;
            n = n + 1;
        }
    }
    for (i = n; i < 12; i += 1) {
        g_seatList[i] = 0;
    }
    g_seatN = n;
}


// 天亮自动收回所有还开着的技能（用户 2026-09-19）：
//   说书人点【进入白天】和智能说书自动天亮走的是同一个分支，所以两种模式都会收回
void BOTC_SkillRetractAll () {
    int q;
    int n;
    string s;
    n = 0;
    s = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_awake[q]) {
            continue;
        }
        BOTC_SpyPeekEnd();             // 间谍正看着说书人那份魔典：先换回他自己那份
        g_awake[q] = false;
        g_skillPicking[q] = false;
        g_limitedAsk[q] = false;
        g_poAsk[q] = false;
        g_skillRoleSel[q] = 0;
        g_skillT1[q] = 0;
        g_skillT2[q] = 0;
        g_skillT3[q] = 0;
        DialogSetVisible(g_skillDlg[q], PlayerGroupSingle(g_who[q]), false);
        DialogControlSetVisible(g_skillNoPick[q], PlayerGroupSingle(g_who[q]), false);
        BOTC_SubMsg(g_who[q], "天亮了，说书人已经收回你的技能。");
        g_gambleWait[q] = false;                   // 赌徒（27）：天亮一律取消「猜角色」等待
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_who[q]));
        if (n > 0) {
            s = s + "、";
        }
        s = s + IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
        n = n + 1;
    }
    if (n > 0) {
        BOTC_SkillBtnRender();
        BOTC_PmStore(g_teller, "【天亮】自动收回技能：" + s + "。");
    }
    // 【测试】说书人自己那份试技能的状态也一起收（身份留着，只收唤醒 / 面板）
    g_tellCastRole = 0;                        // 【使用技能】天亮清掉临时扮演的角色
    if (g_awake[1]) {
        g_awake[1] = false;
        g_skillPicking[1] = false;
        g_limitedAsk[1] = false;
        g_poAsk[1] = false;
        g_skillRoleSel[1] = 0;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
    }
    if (g_sgSeat >= 2) {                       // 【修行者（114）】天亮收技能：那个面板也一起收
        BOTC_SgClose();
    }
    if (g_gblSeat >= 2) {                      // 【赌徒 · 判定面板】天亮也一起收
        BOTC_GblClose();
    }
}

// 【一键收起夜间唤醒弹窗】（用户 2026-11-07）：切换板子 / 取消正式开始前调用。
//   「全部关闭」= 静默收起，不结算、不发消息、不执行还没提交的能力：
//   玩家侧收技能面板和身份网格，说书人侧收信息答题框 / 贵族 / 工程师 / 农夫 /
//   多重能力 / 街头风琴手 / 修行者 / 赌徒 / 饕餮等夜间弹窗，并清掉唤醒状态。
void BOTC_WakePopupsCloseAll () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        g_awake[q] = false;
        g_skillPicking[q] = false;
        g_limitedAsk[q] = false;
        g_poAsk[q] = false;
        g_skillRoleSel[q] = 0;
        g_skillT1[q] = 0;
        g_skillT2[q] = 0;
        g_skillT3[q] = 0;
        g_gambleWait[q] = false;
        g_pickMode[q] = 0;
        g_pickWho[q] = 0;
        DialogSetVisible(g_skillDlg[q], PlayerGroupAll(), false);
        DialogControlSetVisible(g_skillNoPick[q], PlayerGroupAll(), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(q), false);
    }
    g_pickTeam = -1;
    g_pickAlign = -1;
    g_wakeCurrentOrd = 0;
    g_tellCastRole = 0;
    // 说书人侧：信息位答题框
    g_miSeat = 0;
    g_miRole = -1;
    DialogControlSetVisible(g_miYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNote, PlayerGroupAll(), false);
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    g_nobleSeat = 0;
    DialogSetVisible(g_nobleDlg, PlayerGroupAll(), false);
    g_engSeat = 0;
    g_engSeatA = 0;
    g_engSeatB = 0;
    g_engStage = 0;
    DialogSetVisible(g_engDlg, PlayerGroupAll(), false);
    g_farmSeat = 0;
    DialogSetVisible(g_farmDlg, PlayerGroupAll(), false);
    g_wakeChoiceSeat = 0;
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    g_organSeat = 0;
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    g_sgSeat = 0;
    DialogSetVisible(g_sgDlg, PlayerGroupAll(), false);
    g_gblSeat = 0;
    DialogSetVisible(g_gblDlg, PlayerGroupAll(), false);
    BOTC_TaotieClear();
}

// 不参与游戏的位置会被挪到画面外并隐藏。
void BOTC_GrimRelayout () {
    int i;
    int t;
    int q;
    int f;
    int x;
    int y;

    BOTC_BuildSeatList();

    for (i = 0; i < 12; i += 1) {
        g_seatX[i] = -900;
        g_seatY[i] = -900;
    }
    for (i = 2; i <= 13; i += 1) {
        g_seatOn[i] = false;
    }
    // 在座的玩家按顺序摆到圈上
    for (t = 0; t < g_seatN; t += 1) {
        q = g_seatList[t];
        g_seatX[q - 2] = (g_ringX[(g_seatN * 12) + t] * 9) / 10;
        // （用户 2026-09-19）圆桌上下翻过来：1 号位在最上面、座位号顺时针递增。
        //   原来那张表是「从最下面开始、逆时针 1..12」，看着反直觉；
        //   这里把 y 以圆桌中线 520 翻一次（圆桌 1040 高，圆心就是 y=520），
        //   翻完 1 号就在**原来 7 号**那个正上方的位置上，顺时针数 2..12。
        g_seatY[q - 2] = 936 - ((g_ringY[(g_seatN * 12) + t] * 9) / 10);
        g_seatOn[q] = true;
    }
    // 每个座位的控件都跟着走；不在场的座位全部藏起来
    for (i = 0; i < 12; i += 1) {
        q = i + 2;
        x = g_seatX[i];
        y = g_seatY[i];
        DialogControlSetPosition(g_grimSeat[q], PlayerGroupAll(), c_anchorTopLeft, x - 56, y - 56);
        DialogControlSetPosition(g_grimIcon[q], PlayerGroupAll(), c_anchorTopLeft, x - 63, y - 61);
        DialogControlSetPosition(g_grimDead[q], PlayerGroupAll(), c_anchorTopLeft, x - 58, y - 61);
        DialogControlSetPosition(g_grimName[q], PlayerGroupAll(), c_anchorTopLeft, x - 56, y + 31);
        DialogControlSetPosition(g_grimRole[q], PlayerGroupAll(), c_anchorTopLeft, x - 56, y - 50);
        DialogControlSetPosition(g_grimTokBtn[q], PlayerGroupAll(), c_anchorTopLeft, x + 59, y - 27);
        DialogControlSetPosition(g_voteTag[q], PlayerGroupAll(), c_anchorTopLeft, x - 50, y - 54);
        DialogControlSetPosition(g_markTag[q], PlayerGroupAll(), c_anchorTopLeft, x - 56, y + 54);
        DialogControlSetPosition(g_todoTag[q], PlayerGroupAll(), c_anchorTopLeft, x - 54, y + 79);
        if ((i == 3) || (i == 9)) {
            f = 27;
        }
        else {
            f = 18;
        }
        for (t = 0; t < 4; t += 1) {
            DialogControlSetPosition(g_chipImg[(i * 4) + t], PlayerGroupAll(), c_anchorTopLeft, BOTC_Lerp(x, 515, f + (t * 20), 100) - 22, BOTC_Lerp(y, 468, f + (t * 20), 100) - 29);
            DialogControlSetPosition(g_chip[(i * 4) + t], PlayerGroupAll(), c_anchorTopLeft, BOTC_Lerp(x, 515, f + (t * 20), 100) - 34, BOTC_Lerp(y, 468, f + (t * 20), 100) + 14);
        }
        if (g_seatOn[q]) {
            DialogControlSetVisible(g_grimSeat[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_grimIcon[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_grimDead[q], PlayerGroupAll(), BOTC_PublicDead(q));
            // 【退出导致的死亡画蓝叉】（用户 2026-11-01）：按物理座位记，换位后仍跟着人；
            //   正常死亡的座位继续用红叉。图片控件是全局共享的，这里按座位重新贴一次。
            if (g_leftDeadP[g_who[q]]) {
                libNtve_gf_SetDialogItemImage(g_grimDead[q], "botc_exec_blue.dds", PlayerGroupAll());
            }
            else {
                libNtve_gf_SetDialogItemImage(g_grimDead[q], "botc_exec.dds", PlayerGroupAll());
            }
            DialogControlSetVisible(g_grimName[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_grimRole[q], PlayerGroupAll(), true);
    // ＋（token 面板）所有玩家都能用：各记各的（别人看不到自己的标记）
    //   ★ 提名阶段也显示（用户 2026-09-17：提名时玩家也能在魔典上打 token）
    DialogControlSetVisible(g_grimTokBtn[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_voteTag[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_markTag[q], PlayerGroupAll(), true);
            DialogControlSetVisible(g_todoTag[q], PlayerGroupAll(), true);
        }
        else {
            DialogControlSetVisible(g_grimSeat[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_grimIcon[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_grimDead[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_grimName[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_grimRole[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_grimTokBtn[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_voteTag[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_markTag[q], PlayerGroupAll(), false);
            DialogControlSetVisible(g_todoTag[q], PlayerGroupAll(), false);
            for (t = 0; t < 4; t += 1) {
                DialogControlSetVisible(g_chip[(i * 4) + t], PlayerGroupAll(), false);
                DialogControlSetVisible(g_chipImg[(i * 4) + t], PlayerGroupAll(), false);
            }
        }
    }
}

//==================================================================================================
// 【伪造魔典】（用户 2026-11-07）
//   说书人专用：板子里有间谍(18) / 寡妇(75) 时，魔典按钮上方多一个【伪造魔典】。
//   点开是 12 名在场玩家的空白魔典，身份和 token 都能随便标；
//   数据单独存在 g_fakeMark / g_fakeTok，不读也不写真实魔典与对局。
//   中毒 / 醉酒的间谍或寡妇要看魔典时，说书人弹窗选择给他看真实还是伪造。
//==================================================================================================
void BOTC_FakeRender () {
    int i;
    int q;
    int t;
    int n;
    int k;
    int f;
    int x;
    int y;
    int markVal;
    bool isD;
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    for (i = 0; i < 12; i += 1) {
        q = i + 2;
        x = g_seatX[i];
        y = g_seatY[i];
        if (!g_seatOn[q]) {
            DialogControlSetVisible(g_fakeSeat[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_fakeIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_fakeRole[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_fakeName[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_fakeTokBtn[q], PlayerGroupSingle(g_teller), false);
            for (t = 0; t < 4; t += 1) {
                DialogControlSetVisible(g_fakeChip[(i * 4) + t], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_fakeChipImg[(i * 4) + t], PlayerGroupSingle(g_teller), false);
            }
            continue;
        }
        DialogControlSetPosition(g_fakeSeat[q], PlayerGroupSingle(g_teller), c_anchorTopLeft, x - 56, y - 56);
        DialogControlSetPosition(g_fakeIcon[q], PlayerGroupSingle(g_teller), c_anchorTopLeft, x - 63, y - 61);
        DialogControlSetPosition(g_fakeName[q], PlayerGroupSingle(g_teller), c_anchorTopLeft, x - 56, y + 31);
        DialogControlSetPosition(g_fakeRole[q], PlayerGroupSingle(g_teller), c_anchorTopLeft, x - 56, y - 50);
        DialogControlSetPosition(g_fakeTokBtn[q], PlayerGroupSingle(g_teller), c_anchorTopLeft, x + 59, y - 27);
        if ((i == 3) || (i == 9)) {
            f = 27;
        }
        else {
            f = 18;
        }
        for (t = 0; t < 4; t += 1) {
            DialogControlSetPosition(g_fakeChipImg[(i * 4) + t], PlayerGroupSingle(g_teller), c_anchorTopLeft, BOTC_Lerp(x, 515, f + (t * 20), 100) - 22, BOTC_Lerp(y, 468, f + (t * 20), 100) - 29);
            DialogControlSetPosition(g_fakeChip[(i * 4) + t], PlayerGroupSingle(g_teller), c_anchorTopLeft, BOTC_Lerp(x, 515, f + (t * 20), 100) - 34, BOTC_Lerp(y, 468, f + (t * 20), 100) + 14);
        }
        DialogControlSetVisible(g_fakeSeat[q], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_fakeIcon[q], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_fakeRole[q], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_fakeName[q], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_fakeTokBtn[q], PlayerGroupSingle(g_teller), true);
        markVal = g_fakeMark[q];
        if (markVal > 0) {
            libNtve_gf_SetDialogItemText(g_fakeRole[q], TextWithColor(StringToText(g_roleName[markVal - 1]), BOTC_RoleTeamColor(markVal - 1)), PlayerGroupSingle(g_teller));
            libNtve_gf_SetDialogItemImage(g_fakeIcon[q], BOTC_IconName(markVal - 1), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_fakeRole[q], StringToText(""), PlayerGroupSingle(g_teller));
            libNtve_gf_SetDialogItemImage(g_fakeIcon[q], "botc_blank.dds", PlayerGroupSingle(g_teller));
        }
        libNtve_gf_SetDialogItemStyle(g_fakeRole[q], g_grimNameStyle, PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_fakeName[q], StringToText(IntToString(g_lab[q] + g_nameNumShift) + " [") + TextWithColor(BOTC_SeatNameText(q), libNtve_gf_ConvertPlayerColorToColor(g_seatColor[q])) + StringToText("]"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemStyle(g_fakeName[q], g_grimNameStyle, PlayerGroupSingle(g_teller));
        n = 0;
        for (k = 0; k < 2; k += 1) {
            for (t = 0; t < 256; t += 1) {
                if (!g_fakeTok[((q * 256) + t)]) {
                    continue;
                }
                if (t == 18 || g_tokName[t] == "") {
                    continue;
                }
                isD = false;
                if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
                    isD = true;
                }
                if (k == 0) {
                    if (!isD) {
                        continue;
                    }
                }
                else {
                    if (isD) {
                        continue;
                    }
                }
                if (n >= 4) {
                    continue;
                }
                libNtve_gf_SetDialogItemText(g_fakeChip[(i * 4) + n], StringToText(g_tokShort[t]), PlayerGroupSingle(g_teller));
                DialogControlSetVisible(g_fakeChip[(i * 4) + n], PlayerGroupSingle(g_teller), true);
                if (g_tokIcon[t] == "") {
                    DialogControlSetVisible(g_fakeChipImg[(i * 4) + n], PlayerGroupSingle(g_teller), false);
                }
                else {
                    libNtve_gf_SetDialogItemImage(g_fakeChipImg[(i * 4) + n], g_tokIcon[t], PlayerGroupSingle(g_teller));
                    DialogControlSetVisible(g_fakeChipImg[(i * 4) + n], PlayerGroupSingle(g_teller), true);
                }
                n = n + 1;
            }
        }
        for (t = n; t < 4; t += 1) {
            DialogControlSetVisible(g_fakeChip[(i * 4) + t], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_fakeChipImg[(i * 4) + t], PlayerGroupSingle(g_teller), false);
        }
    }
}

void BOTC_BuildFakeGrim () {
    int i;
    int q;
    int t;
    int f;
    DialogCreate(1053, 936, c_anchorCenter, 0, 0, false);
    g_fakeDlg = DialogLastCreated();
    DialogSetVisible(g_fakeDlg, PlayerGroupAll(), false);
    g_fakeTitle = BOTC_NewLabel(g_fakeDlg, 420, 34, 14, 12, StringToText("伪造魔典"));
    libNtve_gf_SetDialogItemStyle(g_fakeTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_fakeTitle, false, PlayerGroupAll());
    g_fakeHint = BOTC_NewLabel(g_fakeDlg, 760, 28, 14, 48, StringToText("只有说书人能看到；这里改的身份和标记不会影响真实魔典与对局。"));
    libNtve_gf_SetDialogItemStyle(g_fakeHint, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_fakeHint, false, PlayerGroupAll());
    g_fakeCloseBtn = BOTC_NewButton(g_fakeDlg, 220, 42, 83, 880, "关闭伪造魔典");
    for (i = 0; i < 12; i += 1) {
        q = i + 2;
        g_fakeSeat[q] = BOTC_NewButton(g_fakeDlg, 112, 112, g_seatX[i] - 56, g_seatY[i] - 56, "");
        libNtve_gf_CreateDialogItemImage(g_fakeDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_fakeIcon[q] = DialogControlLastCreated();
        DialogControlSetPosition(g_fakeIcon[q], PlayerGroupAll(), c_anchorTopLeft, g_seatX[i] - 63, g_seatY[i] - 61);
        libNtve_gf_SetDialogItemAcceptMouse(g_fakeIcon[q], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_fakeIcon[q], "botc_blank.dds", PlayerGroupAll());
        g_fakeName[q] = BOTC_NewLabelC(g_fakeDlg, 112, 26, g_seatX[i] - 56, g_seatY[i] + 31, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_fakeName[q], g_grimNameStyle, PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_fakeName[q], false, PlayerGroupAll());
        g_fakeRole[q] = BOTC_NewLabelC(g_fakeDlg, 112, 22, g_seatX[i] - 56, g_seatY[i] - 50, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_fakeRole[q], g_grimNameStyle, PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_fakeRole[q], false, PlayerGroupAll());
        g_fakeTokBtn[q] = BOTC_NewButton(g_fakeDlg, 51, 54, g_seatX[i] + 59, g_seatY[i] - 27, "＋");
        if ((i == 3) || (i == 9)) {
            f = 27;
        }
        else {
            f = 18;
        }
        for (t = 0; t < 4; t += 1) {
            libNtve_gf_CreateDialogItemImage(g_fakeDlg, 43, 43, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
            g_fakeChipImg[(i * 4) + t] = DialogControlLastCreated();
            DialogControlSetSize(g_fakeChipImg[(i * 4) + t], PlayerGroupAll(), 43, 43);
            libNtve_gf_SetDialogItemAcceptMouse(g_fakeChipImg[(i * 4) + t], false, PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_fakeChipImg[(i * 4) + t], "botc_blank.dds", PlayerGroupAll());
            DialogControlSetVisible(g_fakeChipImg[(i * 4) + t], PlayerGroupAll(), false);
            g_fakeChip[(i * 4) + t] = BOTC_NewLabel(g_fakeDlg, 68, 18, BOTC_Lerp(g_seatX[i], 515, f + (t * 20), 100) - 34, BOTC_Lerp(g_seatY[i], 468, f + (t * 20), 100) + 14, StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_fakeChip[(i * 4) + t], "ModLeftSize16Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_fakeChip[(i * 4) + t], false, PlayerGroupAll());
            DialogControlSetVisible(g_fakeChip[(i * 4) + t], PlayerGroupAll(), false);
            DialogControlSetVisible(g_fakeChipImg[(i * 4) + t], PlayerGroupAll(), false);
        }
    }
    BOTC_FakeRender();
    // 说书人入口按钮：放在【魔典】按钮正上方（魔典按钮在 1046,18）
    DialogCreate(120, 26, c_anchorBottomLeft, 1046, 48, false);
    g_fakeBtnDlg = DialogLastCreated();
    DialogSetVisible(g_fakeBtnDlg, PlayerGroupAll(), false);
    g_fakeOpenBtn = BOTC_NewButton(g_fakeBtnDlg, 120, 26, 0, 0, "伪造魔典");
}

void BOTC_FakeBtnRender () {
    bool show;
    show = false;
    if (g_teller >= 1 && g_teller <= 13) {
        if (BOTC_BoardHasRole(18) || BOTC_BoardHasRole(75)) {
            show = true;
        }
    }
    DialogSetVisible(g_fakeBtnDlg, PlayerGroupAll(), false);
    if (show) {
        DialogSetVisible(g_fakeBtnDlg, PlayerGroupSingle(g_teller), true);
    }
}

void BOTC_FakeOpen () {
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (!(BOTC_BoardHasRole(18) || BOTC_BoardHasRole(75))) {
        return;
    }
    BOTC_FakeRender();
    DialogSetVisible(g_fakeDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_FakePickOpen (int q) {
    int ob;
    ob = g_teller;
    if (ob < 1 || ob > 13) {
        return;
    }
    if (q < 2 || q > 13) {
        return;
    }
    g_pickMode[ob] = 53;
    g_pickWho[ob] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    g_pickForceAlign = -1;
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_PlayerNameText(q) + StringToText(" 的伪造身份"), PlayerGroupSingle(ob));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除伪造身份"), PlayerGroupSingle(ob));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(ob), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_FakeTokOpen (int q) {
    int ob;
    ob = g_teller;
    if (ob < 1 || ob > 13) {
        return;
    }
    if (q < 2 || q > 13) {
        return;
    }
    g_tokFake = true;
    g_tokWho[ob] = q;
    g_tokPage[ob] = 1;
    libNtve_gf_SetDialogItemText(g_tokTitle, BOTC_PlayerNameText(q) + StringToText(" 的伪造 token"), PlayerGroupSingle(ob));
    BOTC_TokRender(ob);
    DialogSetVisible(g_tokDlg, PlayerGroupSingle(ob), true);
}

bool BOTC_FakeClick (int p, int c) {
    int q;
    if (c <= 0) {
        return false;
    }
    if (p != g_teller) {
        return false;
    }
    if (c == g_fakeOpenBtn) {
        BOTC_FakeOpen();
        return true;
    }
    if (c == g_fakeCloseBtn) {
        DialogSetVisible(g_fakeDlg, PlayerGroupAll(), false);
        return true;
    }
    for (q = 2; q <= 13; q += 1) {
        if (c == g_fakeSeat[q]) {
            BOTC_FakePickOpen(q);
            return true;
        }
        if (c == g_fakeTokBtn[q]) {
            BOTC_FakeTokOpen(q);
            return true;
        }
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// 【中毒 / 醉酒间谍或寡妇看魔典】：说书人选择给他看真实魔典还是伪造魔典
//--------------------------------------------------------------------------------------------------
void BOTC_BuildFakeAsk () {
    DialogCreate(600, 230, c_anchorCenter, 0, -80, false);
    g_fakeAskDlg = DialogLastCreated();
    DialogSetVisible(g_fakeAskDlg, PlayerGroupAll(), false);
    g_fakeAskLbl = BOTC_NewLabelC(g_fakeAskDlg, 540, 60, 30, 42, StringToText("这名间谍 / 寡妇处于中毒或醉酒，能力不生效。要给他看哪一份魔典？"));
    libNtve_gf_SetDialogItemStyle(g_fakeAskLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_fakeAskLbl, false, PlayerGroupAll());
    g_fakeAskReal = BOTC_NewButton(g_fakeAskDlg, 200, 44, 70, 140, "真实魔典");
    g_fakeAskFake = BOTC_NewButton(g_fakeAskDlg, 200, 44, 330, 140, "伪造魔典");
    g_fakeAskX = BOTC_NewButton(g_fakeAskDlg, 34, 30, 556, 8, "X");
}

void BOTC_FakeAskOpen (int p, bool widow) {
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (p < 2 || p > 13) {
        return;
    }
    g_fakeAskP = p;
    g_fakeAskWidow = widow;
    DialogSetVisible(g_fakeAskDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_fakeAskDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_FakeAskAnswer (int which) {
    int p;
    bool wid;
    p = g_fakeAskP;
    wid = g_fakeAskWidow;
    g_fakeAskP = 0;
    g_fakeAskWidow = false;
    if (g_fakeAskDlg > 0) {
        DialogSetVisible(g_fakeAskDlg, PlayerGroupAll(), false);
    }
    if (p < 2 || p > 13) {
        return;
    }
    if (which < 0) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_SeatRoleStr(p) + " " + BOTC_NameStr(p) + " 中毒/醉酒，说书人选择不展示魔典。");
        return;
    }
    BOTC_SpyPeekShow(p, (which == 1), wid, false);
}

// 把魔典摊给间谍 / 寡妇看；fake = 看伪造那份，否则看说书人那份实时真魔典
void BOTC_SpyPeekShow (int p, bool fake, bool widow, bool askCopy) {
    int sp;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_spyP >= 2) {
        BOTC_SpyPeekEnd();
    }
    g_spyP = p;
    g_peekNoTok = p;
    sp = g_who[p];
    if (fake) {
        g_grimViewOn[sp] = false;
        g_grimView[sp] = 0;
        g_grimFakeOn[sp] = true;
    }
    else {
        g_grimFakeOn[sp] = false;
        g_grimViewOn[sp] = true;
        g_grimView[sp] = g_teller;
    }
    BOTC_GrimRender(sp);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(sp), true);
    if (fake) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_SeatRoleStr(p) + " " + BOTC_NameStr(p) + " 看了伪造魔典。");
    }
    else {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_SeatRoleStr(p) + " " + BOTC_NameStr(p) + " 看了说书人的魔典。");
    }
    if (askCopy) {
        BOTC_CopyAskOpen(p, widow);
    }
}

// 圆桌（按在场人数自动围圈，位置由 BOTC_GrimRelayout 决定）
// ==================================================================================================
// 【发送特定信息】：四种入口。
//   ① 自定义文本：发送时自动在前面加「你得知」。
//   ② 玩家号 + 身份：最多 6 个玩家号 + 6 个身份按钮，按填写/选择情况自动生成文案。
//   ③ 发送互认：先点收件人，再手动填写 2 个恶魔和 5 个爪牙的座位号。
//   ④ 快捷发送互认：自动发送给全场恶魔和爪牙。
//   操作：点一种信息类型 → 点魔典上的玩家 = 收件人 → 填写 / 选择 → 发送。
// ==================================================================================================
void BOTC_BuildSpec () {
    int i;
    int x;
    DialogCreate(1170, 860, c_anchorCenter, 0, 0, false);
    g_specDlg = DialogLastCreated();
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    g_specTitle = BOTC_NewLabel(g_specDlg, 1100, 36, 30, 14, StringToText("说书人工具"));
    libNtve_gf_SetDialogItemStyle(g_specTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_specTitle, false, PlayerGroupAll());
    g_specHint = BOTC_NewLabel(g_specDlg, 1100, 64, 30, 54, StringToText("前三种方式需要先点一名玩家作为收件人；快捷发送互认直接自动发给全场恶魔和爪牙。"));
    libNtve_gf_SetDialogItemStyle(g_specHint, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_specHint, false, PlayerGroupAll());
    g_specBtn1 = BOTC_NewButton(g_specDlg, 360, 56, 30, 126, "自定义文本");
    g_specBtn2 = BOTC_NewButton(g_specDlg, 360, 56, 410, 126, "玩家号 + 身份");
    g_specRecogBtn = BOTC_NewButton(g_specDlg, 340, 56, 790, 126, "发送互认");
    g_specQuickBtn = BOTC_NewButton(g_specDlg, 340, 56, 790, 196, "快捷发送互认");
    // 【使用技能】（用户 2026-11-06）：说书人先选一个本剧本角色，再像玩家一样正常发动其夜间能力。
    g_specCastBtn = BOTC_NewButton(g_specDlg, 360, 56, 410, 196, "使用技能");
    for (i = 0; i < 6; i += 1) {
        x = 30 + (i * 180);
        g_specSeatEdit[i] = BOTC_NewEdit(g_specDlg, 160, 41, x, 112);
        // 【身份卡】（用户 2026-11-04）：改成玩家座位那种正方形，中间头像、左下角角色名。
        //   普通「玩家号 + 身份」模式仍由 BOTC_SpecSeatRender 还原成 160x44 的横条按钮。
        g_specRoleBtn[i] = BOTC_NewButton(g_specDlg, 100, 100, x, 126, "");
        g_specRoleIcon[i] = BOTC_NewImageItem(g_specDlg, 100, 100, x, 126, "botc_blank.dds");
        g_specRoleName[i] = BOTC_NewLabel(g_specDlg, 92, 20, x + 4, 202, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_specRoleName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_specRoleName[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_specRoleIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_specRoleName[i], PlayerGroupAll(), false);
    }
    g_specInfoClear = BOTC_NewButton(g_specDlg, 180, 42, 30, 226, "清空全部");
    g_specInfoOk = BOTC_NewButton(g_specDlg, 200, 44, 740, 790, "发送给他");
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), false);
    g_specClose = BOTC_NewButton(g_specDlg, 200, 44, 940, 790, "关闭");
}

