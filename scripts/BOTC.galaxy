// 【共用答题框布局复位】疯子假爪牙模式会临时启用第 3、4 个输入框并缩短前两个框。
// 其它角色打开前统一恢复普通宽度并隐藏后两个框，避免残留控件叠在身份按钮上。
void BOTC_MiSeatFieldsReset () {
    DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 180, 41);
    DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 162, 41);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
}

// 把答题框弹给说书人：seat = 发给谁，role = 3 / 4 / 5，extra = 标题里补的信息（占卜师填他验的两个座位）
void BOTC_ManInfoOpen (int seat, int role, string extra) {
    string t;
    string s2;
    if (seat < 1 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    t = "";
    if (role == 3) {
        t = "【厨师】" + BOTC_NameStr(seat) + " 的相邻邪恶对数";
    }
    if (role == 4) {
        t = "【共情者】" + BOTC_NameStr(seat) + " 身边的邪恶玩家数";
    }
    if (role == 5) {
        t = "【占卜师】" + BOTC_NameStr(seat) + " 验的 " + extra + "：里面有恶魔吗？";
    }
    if (role == 24) {
        t = "【侍女】" + BOTC_NameStr(seat) + " 选的是 " + extra + "：其中几个被唤醒？";
    }
    if (role == 47) {
        t = "【钟表匠】" + BOTC_NameStr(seat) + " 得知的距离（填数字：紧挨着是 1）";
    }
    if (role == 50) {
        t = "【数学家】" + BOTC_NameStr(seat) + "：有几个人的能力没正常生效？（填数字）";
    }
    if (role == 51) {
        t = "【卖花女孩】" + BOTC_NameStr(seat) + "：今天白天有恶魔投过票吗？";
    }
    if (role == 52) {
        t = "【城镇公告员】" + BOTC_NameStr(seat) + "：今天白天有爪牙发起过提名吗？";
    }
    if (role == 53) {
        t = "【神谕者】" + BOTC_NameStr(seat) + "：死去的玩家里有几个是邪恶的？（填数字）";
    }
    if (role == 125) {
        t = "【女祭司】" + BOTC_NameStr(seat) + "：说书人认为他最应该交流的玩家座位号（1~12）";
    }
    if (role == 55) {
        t = "【女裁缝】" + BOTC_NameStr(seat) + " 选的 " + extra + "：他们是不是同一阵营？";
    }
    if (role == 58) {
        t = "【杂耍艺人】" + BOTC_NameStr(seat) + "：他今天猜对了几个？（填数字）";
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟共情者一样是数字题，说书人填「要给他看的座位号」
    if (role == 72) {
        t = "【气球驾驶员】" + BOTC_NameStr(seat) + "：要给他看的玩家座位号（1~12）";
    }
    // 【将军(96)】（用户 2026-10-03）：每夜说书人填「善良 / 邪恶 / 均势」，原样私聊发给他
    if (role == 96) {
        t = "【将军】" + BOTC_NameStr(seat) + "：今晚哪个阵营更有优势？（填：善良 / 邪恶 / 均势）";
    }
    if (role == 90) {
        t = "【赏金猎人】" + BOTC_NameStr(seat) + "：你告诉他的那名邪恶玩家的座位号（1~12）";
    }
    // 【何方教众 · 国王(104) / 村夫(105) / 解谜大师(109)】（用户 2026-10-10）
    if (role == 105) {
        t = "【村夫】" + BOTC_NameStr(seat) + " 选的 " + extra + "：他是善良还是邪恶？（左 = 善良 / 右 = 邪恶）";
    }
    if (role == 109) {
        t = "【解谜大师】" + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 156) {
        t = "【引路人】" + BOTC_NameStr(seat) + " 选择的目标：" + extra + "；今晚其中是否有人被邪恶能力选择或影响？";
    }
    if (role == 811) {
        t = "【使节】本次选择包含邪恶玩家。是否改为选中使节？";
    }
    if (role == 812) {
        t = "【掮客】本次选择为 " + extra + "，其中包含陌客 / 间谍等干扰身份。是否发动掮客？";
    }
    // 【数学家】框里下面加一行：口头给的（拜访说书人拿到的）信息脚本核对不了
    // 【发送特定信息】（用户 2026-10-10）：假疯子 801 / 疯子刀人 802
    if (role == 801) {
        t = "【假疯子】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 802) {
        t = "【疯子刀人】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 803) {
        t = "【国王】发给 " + BOTC_NameStr(seat) + "：「" + extra + "」";
    }
    // 【唱诗男孩（108）】：唤醒他时只填写一名玩家的座位号
    if (role == 804) {
        t = "【唱诗男孩】" + BOTC_NameStr(seat) + "：填一个座位号（1~12）";
    }
    // 【半兽人（107）】（用户 2026-10-10）：他说完目标之后弹的「让不让他杀」框
    if (role == 805) {
        t = "【半兽人】" + BOTC_NameStr(seat) + " 选中了 " + BOTC_NameStr(g_lycanTgt) + "：让他杀吗？";
    }
    // 【风雅集（板子 10）· 郎中（116）】（用户 2026-10-16）
    if (role == 806) {
        t = "【郎中】" + BOTC_NameStr(seat) + " 选的是 " + extra + "：填一个跟他能力相关的词语（2~4 个字）";
    }
    // 【牙噶巴卜（133）】（用户 2026-10-21）：首夜由说书人输入秘密短语并私聊发给他。
    if (role == 809) {
        t = "【牙噶巴卜】" + BOTC_NameStr(seat) + "：输入本局秘密短语（建议 2~5 个字，可任意长度）";
    }
    // 【发送特定信息 · 自定义文本】（用户 2026-10-21）：发送时自动加「你得知」。
    if (role == 808) {
        t = "【自定义文本】发给 " + BOTC_NameStr(seat) + "：" + extra;
    }
    if (role == 801 || role == 802 || role == 803 || role == 804 || role == 805 || role == 806 || role == 808) {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);   // 这一步要能取消
    }
    if (role == 47 || role == 50 || role == 53) {
        s2 = "";      // 【正确答案不显示】（用户 2026-10-03：每题都算太复杂，改成说书人自己判）
        if (role == 50) {
            s2 = s2 + "　正确答案已按脚本（他身上带「未正常生效」标记的人数）预填，可直接确定或改掉。";
        }
        if (seat >= 2 && BOTC_InfoErrorOn(seat)) {
            s2 = s2 + "　【信息错误】他带有涡流、熊孩子或活尸效果：这一条要给他错的那份。";
        }
        libNtve_gf_SetDialogItemText(g_miNote, StringToText(s2), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    }
    else {
        // 【杂耍艺人】（用户 2026-11-04）：不再自动数猜对几个，由说书人自行判断；
        //   只有「干扰」(91) 仍作为提醒，带干扰的算不算对同样由说书人判。
        if (role == 58) {
            libNtve_gf_SetDialogItemText(g_miNote, StringToText("猜对几个已按他白天提交的猜测算好并预填在框里（带「干扰」的 " + IntToString(BOTC_CountTok(91)) + " 个按登记层算过，你也可以改掉）。"), PlayerGroupSingle(g_teller));
            DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
        }
        else {
            // 【涡流（71）】（用户 2026-09-21）：他带着「信息错误（涡流）」→ 这一条得给错的
            if (seat >= 2 && BOTC_InfoErrorOn(seat)) {
                libNtve_gf_SetDialogItemText(g_miNote, StringToText("【信息错误】他带有涡流、熊孩子或活尸效果：这一条信息要给错的那份，别照正确答案发。"), PlayerGroupSingle(g_teller));
                DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
            }
            else {
                DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
            }
        }
    }
    if (role == 808) {
        libNtve_gf_SetDialogItemText(g_miNote, StringToText("玩家X=座位号"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    }
    if (t == "") {
        return;
    }
    g_miSeat = seat;
    g_miRole = role;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(t)), PlayerGroupSingle(g_teller));
    g_miExtra = extra;
    DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 252, 83);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(g_miPre), PlayerGroupSingle(g_teller));
    g_miPre = "";
    if (role == 5 || role == 51 || role == 52 || role == 55 || role == 105 || role == 156 || role == 811 || role == 812 || role == 805) {
        // 是非题：只留两个按钮（占卜师 = 有/没有恶魔，村夫 = 善良/邪恶，其余 = 是/不是）
        DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
        DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
        if (role == 5) {
            libNtve_gf_SetDialogItemText(g_miYes, StringToText("有恶魔"), PlayerGroupSingle(g_teller));
            libNtve_gf_SetDialogItemText(g_miNo, StringToText("没有恶魔"), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 105) {
                libNtve_gf_SetDialogItemText(g_miYes, StringToText("善良"), PlayerGroupSingle(g_teller));
                libNtve_gf_SetDialogItemText(g_miNo, StringToText("邪恶"), PlayerGroupSingle(g_teller));
            }
            else {
                libNtve_gf_SetDialogItemText(g_miYes, StringToText("是"), PlayerGroupSingle(g_teller));
                if (role == 156) {
                    libNtve_gf_SetDialogItemText(g_miNo, StringToText("否"), PlayerGroupSingle(g_teller));
                }
                else if (role == 811) {
                    libNtve_gf_SetDialogItemText(g_miYes, StringToText("改为使节"), PlayerGroupSingle(g_teller));
                    libNtve_gf_SetDialogItemText(g_miNo, StringToText("保持原选择"), PlayerGroupSingle(g_teller));
                }
                else if (role == 812) {
                    libNtve_gf_SetDialogItemText(g_miYes, StringToText("发动掮客"), PlayerGroupSingle(g_teller));
                    libNtve_gf_SetDialogItemText(g_miNo, StringToText("不发动"), PlayerGroupSingle(g_teller));
                }
                else {
                    libNtve_gf_SetDialogItemText(g_miNo, StringToText("不是"), PlayerGroupSingle(g_teller));
                }
            }
        }
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 【引路人（156）】独立初始化回答面板。不能只依赖通用答题框的上一次状态：
// 数学家、蛊雕等共用同一块对话框，残留的输入框或旧标题会让这里看似没有弹出。
void BOTC_GuideOpen (int seat, string extra) {
    if (seat < 1 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    g_miSeat = seat;
    g_miRole = 156;
    g_miExtra = extra;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【引路人】" + BOTC_NameStr(seat) + " 选择的目标：" + extra + "；今晚其中是否有人被邪恶能力选择或影响？")), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miYes, StringToText("是"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText("否"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 筑梦师（48）：脚本按规则自动配好「真身 + 一个对立大类的陪衬」，弹框让说书人过目再发（用户 2026-09-21）
//   规则：两个角色里一个是他的真身；另一个必须与他同一大类（镇民/外来者对爪牙/恶魔）。
//   优先挑**不在场**的角色当陪衬，实在没有再用在场的。
void BOTC_ManInfoDreamer (int seat, int target) {
    int r;
    int team;
    bool wantEvil;
    int i;
    int b;
    int n;
    int pick;
    int rr;
    int rt;
    string msg;
    if (seat < 2 || seat > 13 || target < 2 || target > 13) {
        return;
    }
    r = BOTC_SeatTrueRole(target);
    if (r < 0 || r > 163) {
        return;
    }
    team = BOTC_RoleTeam(r);
    wantEvil = true;
    if (team == 2 || team == 3) {
        wantEvil = false;                      // 他本身是邪恶 → 陪衬用善良角色
    }
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    pick = 0;
    n = 0;
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        rr = g_boardRole[(b * 256) + i];
        if (rr == r) {
            continue;
        }
        rt = BOTC_RoleTeam(rr);
        if (wantEvil) {
            if (rt != 2 && rt != 3) {
                continue;
            }
        }
        else {
            if (rt != 0 && rt != 1) {
                continue;
            }
        }
        if (BOTC_RoleInPlay(rr)) {
            continue;                          // 第一轮只要不在场的
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = rr;
        }
    }
    if (pick == 0) {
        n = 0;
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            rr = g_boardRole[(b * 256) + i];
            if (rr == r) {
                continue;
            }
            rt = BOTC_RoleTeam(rr);
            if (wantEvil) {
                if (rt != 2 && rt != 3) {
                    continue;
                }
            }
            else {
                if (rt != 0 && rt != 1) {
                    continue;
                }
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = rr;
            }
        }
    }
    if (pick == 0) {
        BOTC_PmStore(g_teller, "【筑梦师】板子里找不到可以当陪衬的角色，这次请你自己告诉他两个角色。");
        return;
    }
    BOTC_ManInfoOpenDreamer(seat, target);
}
// 【答题框 · 重新显示】（用户 2026-09-21）：唤醒流程走完（开了私聊 / 魔典 / 技能面板）之后，
//   再把答题框显示一次，保证它不会被那些窗口盖住。
void BOTC_ManInfoReShow () {
    if (g_miRole < 0 || g_miSeat < 1 || g_miSeat > 13) {
        return;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}
// 【首夜信息位面板】（用户 2026-09-21）：座位号（洗衣妇/图管/调查员 2 个、祖母 1 个）+ 选身份 + 发送
void BOTC_MiFnRefresh () {
    string s;
    s = "已选身份：";
    if (g_miFnRole > 0) {
        s = s + g_roleName[g_miFnRole];
    }
    else {
        s = s + "（还没选）";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiFnOpen (int seat, int role) {
    if (seat < 1 || seat > 13) {      // 允许 1：说书人自己那一格（-t 试技能用，用户 2026-09-21）
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 60 + role;
    g_miFnRole = 0;
    if (role == 26) {
        libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【小精灵】" + BOTC_NameStr(seat) + "：选一个在场的镇民角色")), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 3000, 3000);
        libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选镇民"), PlayerGroupSingle(g_teller));
        DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 450, 79);
        DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
        BOTC_MiFnRefresh();
        return;
    }
    // 【选身份】按钮无条件摆到最右边（用户 2026-09-21：它原来压在左边那个输入框上；祖母 / 洗衣妇两条路都要走这一句）
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 450, 79);
    if (role == 22 || role == 23 || role == 24 || role == 25) {
        // 1 个座位号 + 选身份：祖母 / 镜像双子配对 / 麻脸巫婆 / 洗脑师（用户 2026-09-21）
        if (role == 23) {
            libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【镜像双子】填对立双子的座位号，再选他的身份")), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 24) {
                libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【麻脸巫婆】填要改造的座位号，再选身份")), PlayerGroupSingle(g_teller));
            }
            else {
                if (role == 25) {
                    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【洗脑师】填要洗脑的座位号，再选善良角色")), PlayerGroupSingle(g_teller));
                }
                else {
                    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【祖母】" + BOTC_NameStr(seat) + "：填孙子的座位号，再选他的身份")), PlayerGroupSingle(g_teller));
                }
            }
        }
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    }
    else {
        libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【" + g_roleName[role] + "】" + BOTC_NameStr(seat) + "：填两个座位号，再选一个身份")), PlayerGroupSingle(g_teller));
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 221, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
    }
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
    if (role == 0) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选镇民"), PlayerGroupSingle(g_teller));
    }
    if (role == 1) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选外来者"), PlayerGroupSingle(g_teller));
    }
    if (role == 2) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选爪牙"), PlayerGroupSingle(g_teller));
    }
    if (role == 22 || role == 25) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选善良角色"), PlayerGroupSingle(g_teller));
    }
    if (role == 23 || role == 24) {
        libNtve_gf_SetDialogItemText(g_miYes, StringToText("选身份"), PlayerGroupSingle(g_teller));
    }
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    BOTC_MiFnRefresh();
}

// 点【选镇民 / 选外来者 / 选爪牙 / 选善良角色】：弹过滤好的身份网格（模式 12）
void BOTC_MiFnPickRole () {
    int role;
    role = g_miRole - 60;
    g_pickMode[g_teller] = 12;
    g_pickWho[g_teller] = g_miSeat;
    g_pickTeam = -1;
    g_pickAlign = -1;
    // 【镜像双子配对 / 麻脸巫婆】：身份都能选（善良的镜像双子也存在）
    if (role == 23 || role == 24) {
        g_pickTeam = -1;
        g_pickAlign = -1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个身份（谁的身份都可以）"), PlayerGroupSingle(g_teller));
    }
    // 【洗脑师】：只能选善良角色（+哥布林，相克，用户 2026-10-14）
    if (role == 25) {
        g_pickAlign = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色（或哥布林）"), PlayerGroupSingle(g_teller));
    }
    if (role == 0) {
        g_pickTeam = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个镇民"), PlayerGroupSingle(g_teller));
    }
    if (role == 26) {
        g_pickTeam = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个在场的镇民角色"), PlayerGroupSingle(g_teller));
    }
    if (role == 1) {
        g_pickTeam = 1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个外来者"), PlayerGroupSingle(g_teller));
    }
    if (role == 2) {
        g_pickTeam = 2;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个爪牙"), PlayerGroupSingle(g_teller));
    }
    if (role == 22) {
        g_pickAlign = 0;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    if (role == 25) { BOTC_CerenShowGoblin(g_teller); }   // 【相克】洗脑师多放一格「哥布林」（用户 2026-10-14）
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiFnSend () {
    int role;
    int seat;
    int a;
    int b;
    int tOk;
    int tBad;
    int okSeat;
    int n;
    int i;
    int k;
    string s;
    if (g_miRole < 60) {
        return;
    }
    role = g_miRole - 60;
    seat = g_miSeat;
    a = 0;
    b = 0;
    s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n >= 1 && n <= 12) {
        a = n + 1;
    }
    s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
    n = BOTC_TextNum(s);
    if (n >= 1 && n <= 12) {
        b = n + 1;
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：只填一个座位号 ---- 发「你得知X。」+ 自动打 95 号 token，
    //   不需要选身份、也不走「两个座位」那套校验。
    if (role == 26) {
        if (g_miFnRole <= 0) {
            BOTC_Notice(g_teller, "先点【选镇民】挑一个角色。");
            return;
        }
        // 【小精灵获得能力】（用户 2026-11-03）：记住他得知的角色，等对应玩家死亡后由说书人确认是否获得。
        g_pixieRoleBy[seat] = g_miFnRole + 1;
        g_pixieSeatBy[seat] = BOTC_SeatOfRole(g_miFnRole);
        g_pixieDone[seat] = false;
        BOTC_PmInfo(g_who[seat], "【信息】你得知一个在场的镇民角色：" + g_roleName[g_miFnRole] + "。");
        BOTC_PmStore(g_teller, "【小精灵】已发给 " + BOTC_NameStr(seat) + "：一个在场的镇民角色 " + g_roleName[g_miFnRole] + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (role == 90) {
        a = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_miEdit, g_teller));
        if (a < 1 || a > 12) {
            BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
            return;
        }
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 114] = false;
        }
        g_tokOn[(((g_teller * 14) + (a + 1)) * 256) + 114] = true;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a + 1) + "。");
        BOTC_PmStore(g_teller, "【赏金猎人】已发给 " + BOTC_NameStr(seat) + "：你得知 " + BOTC_NameStr(a + 1) + " 是邪恶的。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_GrimRender(g_teller);
        return;
    }
    if (role == 72) {
        a = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_miEdit, g_teller));   // 只读**第一个**框（第二个框是隐藏的、可能留着上一次的旧值）
        if (a >= 1 && a <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a + 1) + "。");
            g_tokOn[(((g_teller * 14) + (a + 1)) * 256) + 95] = true;
            BOTC_PmStore(g_teller, "【气球驾驶员】已发给 " + BOTC_NameStr(seat) + "：你得知 " + BOTC_NameStr(a + 1) + "。");
        }
        else {
            BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
            return;
        }
        g_miSeat = 0;
        g_miRole = -1;
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        return;
    }
    if (role != 22 && role != 23 && role != 24 && role != 25 && role != 72 && (a < 2 || b < 2 || a == b)) {
        BOTC_Notice(g_teller, "要填两个不同的座位号（1~12 = 玩家 1~12）。");
        return;
    }
    if ((role == 22 || role == 23 || role == 24 || role == 25) && a < 2) {
        BOTC_Notice(g_teller, "要填一个座位号（1~12 = 玩家 1~12）。");
        return;
    }
    if (g_miFnRole <= 0) {
        BOTC_Notice(g_teller, "先点【选...】挑一个身份。");
        return;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    // 【祖母】只报孙子：打「孙子（祖母）」token + 一句话
    // 【镜像双子配对】（用户 2026-09-21）：填的是对立双子的座位号 + 他的身份
    if (role == 23) {
        BOTC_TwinPair(a, g_miFnRole);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【麻脸巫婆】（用户 2026-09-21）：填要改造的座位号 + 目标身份
    if (role == 24) {
        // 官方移除时机：她这一次行动时，先把上一夜留下的「角色变化（麻脸巫婆）」收掉
        for (k = 2; k <= 13; k += 1) {
            g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
        }
        BOTC_HagApply(a, g_miFnRole);
        BOTC_GrimRender(g_teller);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【洗脑师】（用户 2026-09-21）：填要洗脑的座位号 + 让他疯狂证明的善良角色
    if (role == 25) {
        BOTC_CerenApply(a, g_miFnRole);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (role == 22) {
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 30] = false;
        }
        g_tokOn[(((g_teller * 14) + a) * 256) + 30] = true;
        if (BOTC_SeatImpaired(seat)) {
            BOTC_PmStore(g_teller, "（" + BOTC_NameStr(seat) + " 处于醉酒/中毒状态：按规则该报一个假孙子，脚本不自动改，你自己决定报谁。）");
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a) + "是" + g_roleName[g_miFnRole] + "。");
        BOTC_PmStore(g_teller, "【祖母】已把孙子发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(a) + "（" + g_roleName[g_miFnRole] + "），token 也打好了。");
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【洗衣妇 / 图书管理员 / 调查员】正确 / 错误 token
    tOk = 0;
    tBad = 1;
    if (role == 1) {
        tOk = 2;
        tBad = 3;
    }
    if (role == 2) {
        tOk = 4;
        tBad = 5;
    }
    for (i = 2; i <= 13; i += 1) {
        for (k = 0; k <= 5; k += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + k] = false;
        }
    }
    okSeat = 0;
    if (BOTC_SeatTrueRole(a) == g_miFnRole) {
        okSeat = a;
    }
    if (BOTC_SeatTrueRole(b) == g_miFnRole) {
        okSeat = b;
    }
    if (okSeat == 0) {
        if (BOTC_SeatTrueRole(a) == 15 || BOTC_SeatTrueRole(a) == 18) {
            okSeat = a;
        }
        if (BOTC_SeatTrueRole(b) == 15 || BOTC_SeatTrueRole(b) == 18) {
            okSeat = b;
        }
    }
    if (BOTC_SeatImpaired(seat)) {
        if (RandomInt(1, 2) == 1) {
            okSeat = a;
        }
        else {
            okSeat = b;
        }
        BOTC_PmStore(g_teller, BOTC_NameStr(seat) + " 处于醉酒/中毒状态，已为其随机获得真信息。");
        BOTC_PmStore(g_teller, "若不满意可以手动更改token。");
    }
    if (okSeat != 0) {
        g_tokOn[(((g_teller * 14) + okSeat) * 256) + tOk] = true;
    }
    if (a != okSeat) {
        g_tokOn[(((g_teller * 14) + a) * 256) + tBad] = true;
    }
    if (b != okSeat) {
        g_tokOn[(((g_teller * 14) + b) * 256) + tBad] = true;
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(a) + "," + BOTC_NameStr(b) + " 中有" + g_roleName[g_miFnRole] + "。");
    BOTC_PmStore(g_teller, "【" + g_roleName[role] + "】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(a) + " 和 " + BOTC_NameStr(b) + " 中有" + g_roleName[g_miFnRole] + "。");
    // 【数学家】核对：两个座位的真身都不等于你选的身份 → 记一格「未正常生效」
    if (BOTC_SeatTrueRole(a) != g_miFnRole && BOTC_SeatTrueRole(b) != g_miFnRole) {
        BOTC_MalfNote(seat, "首夜信息位报的身份和真身都不符");
    }
    g_miSeat = 0;
    g_miRole = -1;
}
// 筑梦师（48）的新面板（用户 2026-09-21）：两个按钮【选善良角色】【选邪恶角色】+ 发送
void BOTC_MiDreamerRefresh () {
    string s;
    s = "已选：";
    if (g_miRoleA > 0) {
        s = s + g_roleName[g_miRoleA];
    }
    else {
        s = s + "（善良角色未选）";
    }
    s = s + "　";
    if (g_miRoleB > 0) {
        s = s + g_roleName[g_miRoleB];
    }
    else {
        s = s + "（邪恶角色未选）";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);        // 网格关掉以后再把框显示回来（用户 2026-09-21）
}

void BOTC_ManInfoOpenDreamer (int seat, int target) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 42;
    g_miRoleA = 0;
    g_miRoleB = 0;
    g_miExtra = BOTC_NameStr(target);
    g_dreamerTarget = target;          // 数学家核对用（用户 2026-09-21）
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【筑梦师】给 " + BOTC_NameStr(seat) + " 选两个角色：一个是 " + BOTC_NameStr(target) + " 的真身")), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText("选善良角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText("选邪恶角色"), PlayerGroupSingle(g_teller));
    // 这两个按钮的位置每次自己摆（首夜信息位那边会把「选身份」按钮挪到最右边，这里要摆回来）
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_MiDreamerRefresh();
}

// 点【选善良角色】/【选邪恶角色】：弹对应的身份网格（模式 10 / 11）
void BOTC_MiRoleBtn (int which) {
    if (g_miRole != 42) {
        return;
    }
    g_pickMode[g_teller] = 10;
    g_pickAlign = 0;
    if (which == 0) {
        g_pickMode[g_teller] = 11;
        g_pickAlign = 1;
    }
    g_pickWho[g_teller] = g_miSeat;
    if (which == 0) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个邪恶角色"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选一个善良角色"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);       // 先把这个框收起来，别跟身份网格叠在一起（用户 2026-09-21）
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MiDreamerSend () {
    int seat;
    int target;
    string msg;
    if (g_miRole != 42) {
        return;
    }
    seat = g_miSeat;
    if (g_miRoleA <= 0 || g_miRoleB <= 0) {
        BOTC_Notice(g_teller, "两个角色都选好再发送。");
        return;
    }
    msg = "【信息】你得知" + g_roleName[g_miRoleA] + "," + g_roleName[g_miRoleB] + "。";
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    BOTC_PmInfo(g_who[seat], msg);
    BOTC_PmStore(g_teller, "已发给 " + BOTC_NameStr(seat) + "：「" + msg + "」");
    // 【数学家】（用户 2026-09-21）：说书人给的两个身份里**一个都不是**那个人的真身 → 记一格「未正常生效」
    //   （身份索引口径：只看真身；两个里有一个对得上就不记）
    target = g_dreamerTarget;
    if (target >= 2 && target <= 13) {
        if (BOTC_SeatTrueRole(target) != g_miRoleA && BOTC_SeatTrueRole(target) != g_miRoleB) {
            BOTC_MalfNote(target, "筑梦师给的两个身份都不是他的真身");
        }
    }
    g_miSeat = 0;
    g_miRole = -1;
}
// 【真人说书 · 预填】把脚本算好的答案先填进答题框（说书人可以直接确定，也可以改掉）
void BOTC_ManInfoOpenPre (int seat, int role, string extra, string pre) {
    g_miPre = pre;
    BOTC_ManInfoOpen(seat, role, extra);
    g_miPre = "";
}

// 圆桌上两个座位之间隔着几个玩家（顺时针 / 逆时针取近的那边），紧挨着 = 1
int BOTC_RingDist (int a, int b) {
    int i;
    int n;
    int ka;
    int kb;
    int k;
    BOTC_BuildSeatList();
    n = g_seatN;
    if (a < 2 || b < 2 || n < 2) {
        return 0;
    }
    ka = -1;
    kb = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == a) { ka = i; }
        if (g_seatList[i] == b) { kb = i; }
    }
    if (ka < 0 || kb < 0) {
        return 0;
    }
    k = ka - kb;
    if (k < 0) { k = -k; }
    if (k > (n - k)) { k = n - k; }
    return k;
}

// 钟表匠（47）：恶魔与最近的爪牙之间最近的距离（只看真身；脚本只给建议值，说书人可以改）
int BOTC_ClockmakerDist () {
    int i;
    int d;
    int best;
    int dm;
    dm = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) { dm = i; }
    }
    if (dm < 2) {
        return 0;
    }
    best = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) { continue; }
        d = BOTC_RingDist(dm, i);
        if (best == 0 || d < best) { best = d; }
    }
    return best;
}

// 某个身份坐在哪（真身 = r 的第一个座位；没有 = 0）
int BOTC_SeatOfRole (int r) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatTrueRole(i) == r) { return i; }
    }
    return 0;
}

    // 同一个身份、但排除某个座位（用户 2026-09-21：哲学家选了疯子时，别把「刚被打上『是疯子』的他自己」当成在场的真疯子）
int BOTC_SeatOfRoleNot (int r, int skip) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == skip) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == r) {
            return i;
        }
    }
    return 0;
}
// 给「某个身份」身上打一格 token（卖花女孩 / 城镇公告员的提示标记走它）
void BOTC_TokMarkRole (int r, int t, string why) {
    int q;
    if (r < 0 || r > 163 || t < 0 || t > 255) {
        return;
    }
    q = BOTC_SeatOfRole(r);
    if (q < 2) {
        // 【失忆者 / 借用能力者】（用户 2026-11-06）：能力在谁身上，标记就打到谁身上。
        q = BOTC_AbilitySeat(r);
    }
    if (q < 2) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + t] = true;
    BOTC_GrimRender(g_teller);
}

// 数学家（50）：「未正常生效」标记（一个玩家一天最多一格）
void BOTC_MalfMark (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_RoleEffInPlay(50)) {
        return;          // 没有数学家就别记、也别写日志（用户 2026-09-21）
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 86]) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 86] = true;
}

// 数学家要报的数字 = 身上有「未正常生效」标记的人数（不算他自己）
int BOTC_MalfCount (int me) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (i == me) { continue; }
        if (!g_seatOn[i]) { continue; }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 86]) { n = n + 1; }
    }
    return n;
}

// 数一下场上有几个人带着某个标记（杂耍艺人报「猜对几个」时看它，用户 2026-09-21）
int BOTC_CountTok (int t) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + t]) { n = n + 1; }
    }
    return n;
}
void BOTC_MalfLunCheck () {
    if (!g_lunActed || g_lunSeat < 2 || g_demonTar < 2) {
        return;
    }
    if (g_lunTar == g_demonTar) {
        return;                        // 打得一样：没有异常，不记
    }
    if (g_tokOn[(((g_teller * 14) + g_lunSeat) * 256) + 86]) {
        return;                        // 已经记过了
    }
    BOTC_MalfNote(g_lunSeat, "疯子今晚「杀」的目标和真恶魔不一样");
}

// 【数学家】记一格「未正常生效」（用户 2026-09-21）：只在「说书人实际给的信息和真身不符」时记
//   例外：酒鬼（自带醉酒，不算别人害的）不记
void BOTC_MalfNote (int seat, string why) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!BOTC_RoleEffInPlay(50)) {
        return;          // 这一局场上没有数学家：一条都不记（用户 2026-09-21）
    }
    if (BOTC_SeatTrueRole(seat) == 14) {
        return;
    }
    BOTC_MalfMark(seat);
    BOTC_PmStore(g_teller, "【数学家】" + BOTC_NameStr(seat) + " 这次拿到的信息和真身不符（" + why + "）→ 记一格「未正常生效」。");
}

// ⚠【以后加新信息角色看这里】这个函数只是「数学家」用的正确答案对照表，不是角色逻辑本体：
//   · 新角色是「填数字」的信息类 → 在这里加一段 if (role == 新编号) { n = 正确数字; }
//   · 新角色是「是 / 不是」的信息类 → 加到下面 BOTC_TrueYesNoAns 里
//   · 新角色是自由问答（像博学者 / 艺术家）或答案核不了（像杂耍艺人）→ **什么都不用加**，
//     返回 -1 就是「不自动记」，留给说书人自己判定（数学家的框里已经写了那行提示）。
//   · 效果类角色（要选人的）也不用加：走唤醒时那条「中毒/酒鬼还用了能力 = 记一格」的通用规则。
// 填数字那几位的「正确答案」（真身口径）；返回 -1 = 这个角色没有能自动核对的答案
int BOTC_TrueNumAns (int role, int seat) {
    int i;
    int a;
    int b;
    int n;
    n = -1;
    if (role == 3) {
        // 厨师：相邻的邪恶对数（真身）
        n = 0;
        BOTC_BuildSeatList();
        for (i = 0; i < g_seatN; i += 1) {
            a = g_seatList[i];
            b = g_seatList[(i + 1) % g_seatN];
            if (a == b) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(a)) >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) >= 2) {
                n = n + 1;
            }
        }
    }
    if (role == 4) {
        // 共情者：身边活着的邻居里真身邪恶的人数
        n = 0;
        a = BOTC_EmpathNeighbor(seat, -1);
        b = BOTC_EmpathNeighbor(seat, 1);
        if (a >= 2 && !BOTC_SeatDead(a) && BOTC_RoleTeam(BOTC_SeatTrueRole(a)) >= 2) {
            n = n + 1;
        }
        if (b >= 2 && !BOTC_SeatDead(b) && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) >= 2) {
            n = n + 1;
        }
    }
    if (role == 24) {
        // 侍女：选中的两人里当晚被唤醒的人数
        n = 0;
        if (g_wokeTonight[g_skillT1[seat]]) {
            n = n + 1;
        }
        if (g_wokeTonight[g_skillT2[seat]]) {
            n = n + 1;
        }
        // 【相克规则：侍女 × 数学家】（用户 2026-09-21）：侍女排在数学家前面醒来时，
        //   只要选中的是「活着的数学家」，也要算他今晚会被唤醒（数学家每夜都会被唤醒）。
        if (g_skillT1[seat] >= 2 && !g_wokeTonight[g_skillT1[seat]] && BOTC_HasAbility(g_skillT1[seat], 50) && !BOTC_SeatDead(g_skillT1[seat])) {
            n = n + 1;
        }
        if (g_skillT2[seat] >= 2 && !g_wokeTonight[g_skillT2[seat]] && BOTC_HasAbility(g_skillT2[seat], 50) && !BOTC_SeatDead(g_skillT2[seat])) {
            n = n + 1;
        }
        // 【相克：侍女 × 引路人】：引路人每晚都会醒来；即使侍女先行动，也要计入。
        if (g_skillT1[seat] >= 2 && !g_wokeTonight[g_skillT1[seat]] && BOTC_HasAbility(g_skillT1[seat], 156) && !BOTC_SeatDead(g_skillT1[seat])) {
            n = n + 1;
        }
        if (g_skillT2[seat] >= 2 && !g_wokeTonight[g_skillT2[seat]] && BOTC_HasAbility(g_skillT2[seat], 156) && !BOTC_SeatDead(g_skillT2[seat])) {
            n = n + 1;
        }
    }
    if (role == 47) {
        n = BOTC_ClockmakerDist();
    }
    if (role == 50) {
        // 数学家：他自己要报的数字 = 除他以外，场上有几个人带着「未正常生效」标记
        n = BOTC_MalfCount(seat);
    }
    if (role == 53) {
        // 神谕者：死去的邪恶玩家数（真身）
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (!BOTC_SeatDead(i)) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) >= 2) {
                n = n + 1;
            }
        }
    }
    return n;
}

// ⚠【以后加新信息角色看这里】同 BOTC_TrueNumAns：只有「你能确定正确答案」的是非题才需要加一段；
//   返回 -1 = 不自动记（交给说书人）。占卜师那一段里返回 -1 的写法就是「这个偏差不算异常」的例子。
// 是非题那几位的「正确答案」：1 = 是 / 0 = 不是 / -1 = 没法自动核对
int BOTC_TrueYesNoAns (int role, int seat) {
    int a;
    int b;
    int t;
    t = -1;
    if (role == 5) {
        t = 0;
        a = g_skillT1[seat];
        b = g_skillT2[seat];
        if (a >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(a)) == 3) {
            t = 1;
        }
        if (b >= 2 && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) == 3) {
            t = 1;
        }
        // 他自己的「干扰项」是他自己能力的设定，不算别人害的：这种情况不记
        if (t == 0) {
            if (a >= 2 && g_tokOn[(((g_teller * 14) + a) * 256) + 6]) {
                t = -1;
            }
            if (b >= 2 && g_tokOn[(((g_teller * 14) + b) * 256) + 6]) {
                t = -1;
            }
        }
    }
    if (role == 51) {
        t = 0;
        if (g_tokOn[(((g_teller * 14) + seat) * 256) + 87]) {
            t = 1;
        }
    }
    if (role == 52) {
        t = 0;
        if (g_tokOn[(((g_teller * 14) + seat) * 256) + 88]) {
            t = 1;
        }
    }
    if (role == 55) {
        a = g_skillT1[seat];
        b = g_skillT2[seat];
        if (a >= 2 && b >= 2) {
            t = 0;
            if (BOTC_SeatAlign(a) == BOTC_SeatAlign(b)) {
                t = 1;
            }
        }
    }
    return t;
}
// 【测试·用户 2026-09-21】把座位 2（游戏里的「玩家1」）设成哲学家 + 直接按「他选了酒鬼 / 疯子」往下走：
//   会弹「只列镇民 / 只列恶魔」的网格给说书人，点一个就定下他的认知
void BOTC_TestPhilo (int role) {
    if (BOTC_RoleAlign(role) != 0) {
        return;
    }
    BOTC_SetSeatRole(g_teller, 2, 56);
    BOTC_SetSeatRole(g_who[2], 2, 56);
    BOTC_PhiloPick(2, role);
    BOTC_PmStore(g_teller, "【测试】座位 2 现在是哲学家，并且选了「" + g_roleName[role] + "」：请在弹出来的网格里点他以为自己是哪个角色。");
}
// 哲学家（56）：弹身份网格（只列善良角色）---- 复用侍臣那套网格，模式 8（用户 2026-09-21）
// 【熊孩子（151）】选择镇民角色；只标记真实拥有该角色的人，不标记借用能力者。
void BOTC_RascalOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    cp = g_who[p];
    g_pickMode[cp] = 43;
    g_pickWho[cp] = p;
    g_pickTeam = 0;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个镇民角色"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

bool BOTC_PedantInPlay () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_seatOn[q] && BOTC_HasAbility(q, 152)) {
            return true;
        }
    }
    return false;
}

void BOTC_PedantDealInfo () {
    int q;
    int lu;
    if (!BOTC_PedantInPlay()) {
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !BOTC_IsDemonSeat(q)) {
            continue;
        }
        BOTC_PmInfo(g_who[q], "【信息】你得知书生在场。");
        BOTC_PmStore(g_teller, "【书生】首夜已告诉 " + BOTC_NameStr(q) + "：「你得知书生在场。」");
    }
    // 【书生 × 疯子】（用户 2026-11-01）：恶魔得知「书生在场」之后，由说书人决定是否也告诉疯子。
    lu = BOTC_RealLunaticSeat();
    if (lu >= 2) {
        BOTC_ManInfoOpenSeats(lu, "【书生】要不要也告诉疯子「书生在场」？【确认】= 告诉，【取消】= 不告诉", 16);
    }
}

// 【剧本里有书生但不在场】（用户 2026-11-04）：说书人可选择给所有恶魔发假信息「书生在场」。
void BOTC_FakePedantAsk () {
    BOTC_ManInfoOpenSeats(2, "【书生·假信息】本局剧本里有书生但不在场：是否告诉所有恶魔「书生在场」？【确认】= 告诉，【取消】= 不说", 20);
}

// 【剧本里有国王但不在场】（用户 2026-11-04）：说书人可选择给所有恶魔发假信息「某玩家是国王」。
void BOTC_FakeKingAsk () {
    BOTC_ManInfoOpenSeats(2, "【国王·假信息】本局剧本里有国王但不在场：输入座位号，确认后告诉所有恶魔「该玩家是国王」；【取消】= 不说", 21);
}

// 【书生（152）】已猜测 token 在书生夜序触发一次普通单目标刀人。
void BOTC_PedantOpen (int p) {
    if (p < 2 || p > 13 || !g_pedantActing[p]) {
        return;
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    g_skillRoleSel[p] = 0;
    g_skillPicking[p] = true;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_SkillRender(p);
    BOTC_Notice(g_who[p], "选择一名玩家");
}

void BOTC_PedantResolve (int p, int target) {
    if (p < 2 || p > 13 || target < 2 || target > 13) {
        return;
    }
    if (g_pedantDoneNight == g_nightNum) {
        BOTC_Notice(g_teller, "书生本晚的额外行动已经结算。");
        return;
    }
    if (!g_tokOn[(((g_teller * 14) + p) * 256) + 171]) {
        BOTC_Notice(g_teller, "书生本次行动需要先给该玩家放置「已猜测」token。");
        return;
    }
    g_pedantDoneNight = g_nightNum;
    BOTC_MarkDeathQuietSrc(target, 1, 0, 152);
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【书生】" + BOTC_NameStr(p) + " 已结算已猜测 token：选择 " + BOTC_NameStr(target) + "，死亡类型为夜间·非恶魔攻击。");
}

void BOTC_PedantDawnClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        g_pedantActing[q] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 171] = false;
    }
    g_pedantDoneNight = 0;
    BOTC_GrimRender(g_teller);
}

// 【狐媚娘（153）】首夜选择与失能恢复后的补发告知。
void BOTC_VixenSync () {
    int q;
    int desired;
    if (g_vixenExecPending) {
        return;
    }
    if (g_vixenSeat < 1 || g_vixenTarget < 2) {
        return;
    }
    if (BOTC_SeatDead(g_vixenSeat) || !BOTC_HasAbility(g_vixenSeat, 153)) {
        return;
    }
    desired = 1;
    if (!g_vixenInfoSent && BOTC_AbilityWorks(g_vixenSeat, 153)) {
        g_vixenInfoSent = true;
        BOTC_PmInfo(g_who[g_vixenTarget], "【信息】你得知狐媚娘在场。");
        BOTC_PmStore(g_teller, "【狐媚娘】已告诉 " + BOTC_NameStr(g_vixenTarget) + "：狐媚娘在场。");
    }
    if (!g_vixenInfoSent) {
        desired = 2;
    }
    if (desired != g_vixenMarkerState) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 173] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 174] = false;
        }
        g_tokOn[(((g_teller * 14) + g_vixenTarget) * 256) + (172 + desired)] = true;
        g_vixenMarkerState = desired;
        BOTC_GrimRender(g_teller);
    }
}

void BOTC_VixenChoose (int p, int target) {
    int q;
    if (p < 1 || p > 13 || target < 2 || target > 13) {
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 173] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 174] = false;
    }
    g_vixenSeat = p;
    g_vixenTarget = target;
    g_vixenInfoSent = false;
    g_vixenExecPending = false;
    g_vixenExecNight = 0;
    g_vixenDoneNight = 0;
    g_vixenMarkerState = 0;
    BOTC_VixenSync();
    if (!g_vixenInfoSent) {
        BOTC_PmStore(g_teller, "【狐媚娘】首夜选择了 " + BOTC_NameStr(target) + "，但能力当前失效；受选者暂不知道狐媚娘在场。恢复能力后会自动补发。");
    }
    else {
        BOTC_PmStore(g_teller, "【狐媚娘】首夜选择了 " + BOTC_NameStr(target) + "，并已告知其狐媚娘在场。");
    }
}

void BOTC_VixenExecPending (int p) {
    if (p < 2 || p > 13 || p != g_vixenSeat || g_vixenTarget < 2) {
        return;
    }
    if (!BOTC_AbilityWorks(p, 153)) {
        BOTC_PmStore(g_teller, "【狐媚娘】" + BOTC_NameStr(p) + " 被处决时能力失效，受选者不会改变阵营。");
        return;
    }
    g_vixenExecPending = true;
    g_vixenExecNight = g_nightNum;
    BOTC_PmStore(g_teller, "【狐媚娘】" + BOTC_NameStr(p) + " 因处决死亡；下一夜第 35 位将处理 " + BOTC_NameStr(g_vixenTarget) + " 的阵营变化。");
}

bool BOTC_VixenNightStep (int beforeOrd) {
    int ord;
    int target;
    if (!g_vixenExecPending || g_vixenDoneNight == g_nightNum) {
        return false;
    }
    if (g_nightNum <= g_vixenExecNight) {
        return false;
    }
    ord = BOTC_NightOrder(153);
    if (ord <= 0) {
        return false;
    }
    if (beforeOrd > 0 && (ord * 10) > beforeOrd) {
        return false;
    }
    target = g_vixenTarget;
    g_vixenDoneNight = g_nightNum;
    if (target >= 2 && target <= 13 && g_seatOn[target]) {
        if (BOTC_SeatAlign(target) == 0) {
            g_tokOn[(((g_teller * 14) + target) * 256) + 15] = true;
            g_tokOn[(((g_teller * 14) + target) * 256) + 14] = false;
            BOTC_PairClearSeat(target);
            BOTC_PmInfo(g_who[target], "【阵营变化】你转变为邪恶阵营。");
            BOTC_PmStore(g_teller, "【狐媚娘】" + BOTC_NameStr(target) + " 在狐媚娘被处决后的当晚转变为邪恶阵营。");
            BOTC_ClaimBtnRender();
            BOTC_SeatStateSync();
        }
        else {
            BOTC_PmStore(g_teller, "【狐媚娘】" + BOTC_NameStr(target) + " 本来就是邪恶阵营，无需转变。");
        }
    }
    BOTC_VixenClear();
    return true;
}

void BOTC_VixenClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 173] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 174] = false;
    }
    g_vixenSeat = 0;
    g_vixenTarget = 0;
    g_vixenInfoSent = false;
    g_vixenExecPending = false;
    g_vixenExecNight = 0;
    g_vixenDoneNight = 0;
    g_vixenMarkerState = 0;
    BOTC_GrimRender(g_teller);
}

void BOTC_RascalPick (int p, int role) {
    int q;
    int n;
    string s;
    if (p < 1 || p > 13 || role < 0 || role > 163) {
        return;
    }
    if (BOTC_RoleTeam(role) != 0) {
        BOTC_Notice(g_who[p], "请选择一个镇民角色。");
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_rascalRole[p] = role;
    g_rascalActive[p] = BOTC_AbilityWorks(p, 151);
    BOTC_RascalSync();
    // 【必须让说书人得知结果】（用户 2026-11-02）：选中的角色可能不在场 →
    //   原来只说「真实拥有该角色的玩家获得捣蛋」，场上没这个人时魔典上不会出现任何「捣蛋」，
    //   说书人既不知道到底落给了谁、也不知道其实没人拿到。这里按实际 token 反查座位并明说。
    n = 0;
    s = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 170]) {
            continue;
        }
        if (n > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(q);
        n = n + 1;
    }
    if (!g_rascalActive[p]) {
        BOTC_PmStore(g_teller, "【熊孩子】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」，但能力未生效：没有人获得「捣蛋」。");
        BOTC_SubMsg(g_teller, "【熊孩子】" + BOTC_NameStr(p) + " 能力未生效（选择了「" + g_roleName[role] + "」）。");
        return;
    }
    if (n == 0) {
        BOTC_PmStore(g_teller, "【熊孩子】" + BOTC_NameStr(p) + " 选择了镇民角色「" + g_roleName[role] + "」，但场上没有真正持有该角色的玩家：这次没有人获得「捣蛋」（之后有人变成该角色时仍会生效，直到下个黄昏）。");
        BOTC_SubMsg(g_teller, "【熊孩子】选了「" + g_roleName[role] + "」，场上没有持牌者：暂无人获得「捣蛋」。");
        return;
    }
    BOTC_PmStore(g_teller, "【熊孩子】" + BOTC_NameStr(p) + " 选择了镇民角色「" + g_roleName[role] + "」：获得「捣蛋」的是 " + s + "，直到下个黄昏。");
}

void BOTC_PhiloOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    // 【一次性能力已经用掉】（用户 2026-11-03）：包括被中毒 / 醉酒浪费掉的那一次，不再重复弹出。
    if (p >= 2 && g_philoUsed[p]) {
        return;
    }
    // 【座位机制】（用户 2026-10-07 报「点唤醒之后面板弹给了错的玩家」）：
    //   p 是**格子**，而 g_pick*（身份网格那套）和一切投递都按**客户端（物理座位）** ——先换算成 cp。
    cp = g_who[p];
    g_pickMode[cp] = 8;
    g_pickWho[cp] = p;             // 网格里要挑的是"哪一格的身份" → 这里存格子
    // 【借来的哲学家能力】（用户 2026-11-03）：食人族 / 失忆者 / 变脸师获得哲学家能力后，
    //   再选一次能力只把能力挂到本座位，不改变身份、不打「是哲学家」token。
    if (g_grantActing[p]) {
        g_pickAttachSeat[cp] = p;
    }
    BOTC_PickFilter(cp, true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消选择"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

// 哲学家选完角色：拿能力 / 认知覆盖 / 让在场的那个人醉酒（用户 2026-09-21）
void BOTC_PhiloPick (int p, int role) {
    int i;
    int n;
    int rr;
    int pick;
    int dm;
    if (p < 1 || p > 13) {
        return;
    }
    if (role < 0 || role > 163) {
        return;
    }
    if (BOTC_RoleAlign(role) != 0) {
        BOTC_Notice(g_who[p], "哲学家只能选善良角色。");
        return;
    }
    // 【哲学家在获得能力之前中毒 / 醉酒】（用户 2026-11-03）：这一次不获得能力，
    //   全局仅限一次的机会照样用掉，也不会让那名在场角色醉酒。
    if (p >= 2 && BOTC_SeatImpaired(p)) {
        g_philoUsed[p] = true;
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 在获得能力前中毒/醉酒 → 这次不获得能力，一次性机会已浪费。");
        BOTC_GrimRender(g_teller);
        return;
    }
    if (p >= 2) {
        g_philoUsed[p] = true;
    }
    BOTC_TellRoleChoice(p, role);
    g_philoRole = role;                           // 记住他选的是哪个角色（同步醉酒时要用，用户 2026-09-21）
    pick = BOTC_SeatOfRoleNot(role, p);           // 那个角色在不在场：看真身，并排除他自己
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;        // 是哲学家
    if (pick >= 2 && pick != p) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 90] = true;
    }
    // ② 认知覆盖类（酒鬼 / 疯子 / 悟道者）：由**说书人**再选一次「他以为自己是哪个角色」（用户 2026-09-21 / 2026-10-16）
    if (role == 14 || role == 38 || role == 118) {
        g_philoSeat = p;
        g_philoKind = role;
        g_pickMode[g_teller] = 9;
        g_pickWho[g_teller] = p;
        g_pickTeam = 0;
        if (role == 38) { g_pickTeam = 3; }
        if (role == 118) { g_pickTeam = 1; }
        BOTC_PickFilter(g_teller, false);
        if (role == 14) {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪个镇民？"), PlayerGroupSingle(g_teller));
        }
        else {
            if (role == 118) {
                libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
            }
            else {
                libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家以为自己是哪只恶魔？"), PlayerGroupSingle(g_teller));
            }
        }
        // 【认知覆盖类不能当那张卡】（用户 2026-10-16）：酒鬼(14) / 疯子(38) 从网格里藏起来
        if (role == 118) {
            for (i = 0; i < 64; i += 1) {
                if (g_gridSlot[i] == 14 || g_gridSlot[i] == 38) {
                    DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(g_teller), false);
                    DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(g_teller), false);
                    DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(g_teller), false);
                }
            }
        }
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（这次不算他选过）"), PlayerGroupSingle(g_teller));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    // 获得的新角色从当前夜算首夜，并允许它按自己的夜序再次进入今晚队列。
    if (g_nightNum > 0) {
        g_seatFirstNight[p] = g_nightNum;
        g_autoWoke[p] = false;
    }
    // ③ 其它角色：他直接获得那个能力
    BOTC_SetSeatRole(g_teller, p, role);
    BOTC_SetSeatRole(g_who[p], p, role);
    g_philoRole = role;                         // 换身份会把这份记录清掉，这里补回（用户 2026-09-21）
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;      // 换身份会清掉认知标记，这里补回「是哲学家」（用户 2026-09-21）
    BOTC_SeatStateSync();      // 【打完「是哲学家」之后再算一次】（用户 2026-10-14）
    if (g_who[p] == g_teller) { g_mark[(g_teller * 14) + 1] = role + 1; }
    BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 获得了 " + g_roleName[role] + " 的能力。");
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[p]);
}
// 【哲学家让人醉：谁该带「醉酒（哲学家）」】（用户 2026-09-21）
//   哲学家活着 + 清醒 + 已经选过角色 → 他选的那个角色真正的持有者醉酒
//   （真身口径；哲学家自己不算，因为他的真身被判定成「是哲学家(56)」）。
//   返回 0 = 现在没人该醉（哲学家中毒 / 酒鬼 / 死亡，或者那个角色不在场）。
int BOTC_PhiloDrunkSeat () {
    int i;
    int ph;
    int t;
    if (g_philoRole <= 0) {
        return 0;
    }
    ph = 0;
    for (i = 1; i <= 13; i += 1) {
        if (i >= 2 && !g_seatOn[i]) {
            continue;
        }
        if (!g_tokOn[(((g_teller * 14) + i) * 256) + 70]) {
            continue;
        }
        ph = i;
    }
    if (ph < 1) {
        return 0;
    }
    if (BOTC_SeatDead(ph) || BOTC_SeatImpairedRaw(ph)) {
        return 0;
    }
    t = BOTC_SeatOfRoleNot(g_philoRole, ph);
    if (t < 2) {
        return 0;
    }
    return t;
}

// 【哲学家的醉酒同步】（用户 2026-09-21）：把「醉酒（哲学家）」token(90) 撒到该带的那个座位上。
//   触发点：每次重画魔典、token 面板打 / 撤的那一刻、天亮。
void BOTC_PhiloDrunkSync () {
    int i;
    int src;
    int tgt;
    // 【说书人手动打过这枚 → 自动同步让位】（用户 2026-10-12）：
    //   不然他刚手动补上的醉酒，会被下一次同步（点别的 token / 天亮）抹掉。
    if (g_philoDrunkManual) {
        return;
    }
    tgt = BOTC_PhiloDrunkSeat();
    for (i = 1; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 90]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 90] = false;
        }
    }
    if (tgt >= 2) {
        g_tokOn[(((g_teller * 14) + tgt) * 256) + 90] = true;
    }
    for (src = 2; src <= 13; src += 1) {
        tgt = BOTC_BoffinNestedPhiloDrunkTarget(src);
        if (tgt >= 2) {
            g_tokOn[(((g_teller * 14) + tgt) * 256) + 90] = true;
        }
    }
}

// 【是不是疯子】（用户 2026-09-21）：真身是疯子(38)，或者身上带「是疯子」(49) 也算 ----
//   这样「哲学家选了疯子」的那位也能走疯子那套（假恶魔行为 / 给恶魔报目标）：
//   他现在的真身被判定成「是哲学家(56)」，光看真身会漏掉。
bool BOTC_IsLunatic (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return true;
    }
    return (BOTC_SeatTrueRole(q) == 38);
}

// 【真疯子是哪个座位】（用户 2026-09-21）：带「是疯子」但**不是**哲学家的那一个。
//   哲学家假装疯子时两个座位都像疯子；凡是「场上那个疯子是谁」的地方都走这里，
//   免得把哲学家当成疯子、把真疯子漏掉。场上没有真疯子时才退回任意一个。
int BOTC_RealLunaticSeat () {
    int i;
    int any;
    int anyDead;
    any = 0;
    anyDead = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsLunatic(i)) {
            continue;
        }
        // 【食人族（74）】吃疯子能力的那个也算「假装的那个」；真疯子死了要让位
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] || g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            if (!BOTC_SeatDead(i)) {
                any = i;
            }
            continue;
        }
        if (!BOTC_SeatDead(i)) {
            return i;
        }
        if (anyDead == 0) {
            anyDead = i;
        }
    }
    if (any >= 2) {
        return any;
    }
    return anyDead;
}

// 【今晚真的动手的那个疯子】（用户 2026-09-21）：真疯子优先、并且要清醒；
//   真疯子被哲学家弄醉时，返回的是还能行动的那个哲学疯子。
int BOTC_LunaticActingSeat () {
    int i;
    int real;
    int any;
    int realOk;
    int anyOk;
    real = 0;
    any = 0;
    realOk = 0;
    anyOk = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsLunatic(i)) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;                  // 死人不行动
        }
        // 【食人族（74）】吃疯子能力的那个也算「假装的那个」
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] || g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            any = i;
            if (!BOTC_SeatImpaired(i)) {
                anyOk = i;
            }
        }
        else {
            real = i;
            if (!BOTC_SeatImpaired(i)) {
                realOk = i;
            }
        }
    }
    if (realOk >= 2) {
        return realOk;
    }
    if (anyOk >= 2) {
        return anyOk;
    }
    if (real >= 2) {
        return real;
    }
    return any;
}
void BOTC_PhiloBelieve (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 163) {
        return;
    }
    if (g_nightNum > 0) {
        g_seatFirstNight[p] = g_nightNum;
        g_autoWoke[p] = false;
    }
    BOTC_SetSeatRole(g_teller, p, role);
    BOTC_SetSeatRole(g_who[p], p, role);
    g_philoRole = g_philoKind;                  // 他选的是酒鬼 / 疯子：换身份会把这份记录清掉，这里补回
    g_tokOn[(((g_teller * 14) + p) * 256) + 70] = true;      // 换身份会清掉认知标记，这里补回「是哲学家」（用户 2026-09-21）
    BOTC_SeatStateSync();      // 【同上】（用户 2026-10-14）
    if (g_philoKind == 38) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 49] = true;
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（疯子）：记得给他发 3 个不在场身份（他不会得知场上的爪牙）。");
    }
    else if (g_philoKind == 118) {
        // 【哲学家借到悟道者的能力】（用户 2026-10-16）：跟酒鬼那套一个道理 ----
        //   不能打「是悟道者」140（那会让他的真身被读成 118）；真身还是哲学家(56)，只是他以为自己是个外来者。
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（悟道者）：他只是以为自己是个外来者，没有实际能力。");
    }
    else {
        // 【哲学家借到酒鬼的能力】（用户 2026-10-13）：他本人就是「酒鬼」→ 给他打通用的「醉酒」token(24)。
        //   不能打「是酒鬼」8（8 只属于真酒鬼，而且会让他的真身被读成酒鬼）；
        //   打了 24 之后 BOTC_SeatIsDrunk 认这一格，他再借来的能力（例如炼金术士 123 那一份）就不生效。
        g_tokOn[(((g_teller * 14) + p) * 256) + 24] = true;
        BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(p) + " 以为自己是" + g_roleName[role] + "（酒鬼）→ 给他打上「醉酒」token（他自己就是酒鬼，能力不生效）。");
    }
    // 【身份转变提示】（用户 2026-09-21）：哲学家选了酒鬼 / 疯子同样要发（认知覆盖造成的）
    BOTC_ChangeRoleMsg(p, role);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[p]);
}
void BOTC_NobleOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    g_nobleSeat = seat;
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：他中毒/酒鬼时能力失效 → 提醒说书人这条信息可以随便给
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【贵族】" + BOTC_NameStr(seat) + " 中毒/酒鬼 → 按规则能力失效，这三个人里有没有邪恶你可以随便给。");
    }
    libNtve_gf_SetDialogItemText(g_nobleTitle, StringToText("【贵族】" + BOTC_NameStr(seat) + "：填 3 个座位号（1~12）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE1, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE2, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_nobleE3, StringToText(""), PlayerGroupSingle(g_teller));
    // 【换座位出来的说书人也要有确认键】（用户 2026-10-18）：按「现在的」说书人重新设一次可见性
    DialogControlSetVisible(g_nobleOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_nobleOk, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_NobleSend () {
    int n;
    string s;
    string s2;
    if (g_nobleSeat < 2 || g_nobleSeat > 13) {
        return;
    }
    s2 = "【信息】你得知";
    s = libNtve_gf_DialogItemEditValue(g_nobleE1, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1) + ",";
    s = libNtve_gf_DialogItemEditValue(g_nobleE2, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1) + ",";
    s = libNtve_gf_DialogItemEditValue(g_nobleE3, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "三个框都要填 1~12 的座位号。");
        return;
    }
    s2 = s2 + BOTC_NameStr(n + 1);
    BOTC_PmInfo(g_who[g_nobleSeat], s2);
    BOTC_PmStore(g_teller, "【贵族】已发给 " + BOTC_NameStr(g_nobleSeat) + "：「" + s2 + "」");
    DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), false);
    g_nobleSeat = 0;
}

void BOTC_MezeOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 85;
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText("【灵言师】打一段短语发给他（别人说出这段短语时他会转阵营）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
