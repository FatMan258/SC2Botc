// 【魔典收起】（用户 2026-11-07）：魔典按钮再按一次 / 魔典面板【关闭】共用
void BOTC_GrimClose (int p) {
    if (g_awake[BOTC_PosOf(p)]) {
        BOTC_Notice(p, "你先完成这次行动（或等说书人收回唤醒）。");
        return;
    }
    g_winPanelOn = false;
    BOTC_WinAdminRender();
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
    g_grimOn[p] = false;
}

// 全场魔典一起显隐时同步标记（天亮自动弹 / 复盘 / 隐藏全部界面）
void BOTC_GrimFlagAll (bool on) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        g_grimOn[i] = on;
    }
}

// 【右上角按钮切换】（用户 2026-11-07）：面板已经开着 → 再点同一个按钮就收起；
//   否则按原来的方式打开（含互斥处理）。
void BOTC_PanelToggle (int p, int which) {
    if (which == 1 && g_logOpen[p]) {
        BOTC_LogClose(p);
        return;
    }
    if (which == 2 && g_grimOn[p]) {
        BOTC_GrimClose(p);
        return;
    }
    if (which == 3 && g_abOpen[p]) {
        BOTC_AbClose(p);
        return;
    }
    if (which == 5 && g_noteOn[p]) {
        BOTC_NoteClose(p);
        return;
    }
    if (which == 6 && g_tipOpen[p]) {
        BOTC_TipClose(p);
        return;
    }
    BOTC_PanelOpen(p, which);
}

// 右上角四个面板互斥：1 日志 / 2 魔典 / 3 角色能力表 / 4 夜间顺序
//   （用户 2026-09-19：不能同时开两个）
void BOTC_PanelOpen (int p, int which) {
    // 正在「发起私聊」选人时又从右上角开了别的面板 → 先退出选人模式（不然魔典按钮一直锁着）
    if (g_pmPick[p] && which != 2) {
        BOTC_PmPickEnd(p);
    }
    // 【剧本角色表可与日志 / 魔典共存】（用户 2026-11-04）：日志与魔典仍然互斥，
    //   剧本角色表（含夜序视图）不再被日志 / 魔典 / 帮助 / 笔记收起。
    //   【帮助 / 剧本角色表共存】：点剧本角色表不收起帮助，点帮助也不收起剧本角色表。
    //   【笔记】与所有页面共存：打开别的页面不收笔记，打开笔记也不收别的页面。
    if (which == 2) {
        BOTC_LogClose(p);           // 魔典与日志互斥
    }
    if (which == 1) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);   // 日志与魔典互斥
        g_grimOn[p] = false;
    }
    if (which == 1 || which == 2) {
        BOTC_TipClose(p);           // 帮助面板跟日志 / 魔典互斥
    }
    if (which == 1) {
        BOTC_LogOpen(p);
    }
    if (which == 2) {
        BOTC_GrimRelayout();
        BOTC_GrimRender(p);
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
        g_grimOn[p] = true;
        if (g_pmPick[p]) {
            BOTC_PmPickApply(p);       // 选人模式里又把魔典点开：按钮和 ＋ 再收一次
        }
    }
    if (which == 3) {
        BOTC_AbilityOpen(p);
    }
    if (which == 4) {
        BOTC_NightOrderOpen(p);
    }
    if (which == 5) {
        BOTC_NoteOpen(p);
    }
    if (which == 6) {
        g_tipForce[p] = -1;        // 点【游戏帮助】= 看自己的角色，别被之前在能力表点过的详情锁住（用户 2026-09-30）
        g_tipMode[p] = 1;          // 默认打开【我的角色】页（角色能力详情），用户 2026-11-04
        BOTC_TipOpen(p);
    }
}

// ---- 角色能力表（新版：自绘两页列表）----
// ---- 角色能力表（重做）----
//   第 1 页 = 镇民；第 2 页 = 外来者 / 爪牙 / 恶魔
//   每条 = 85 图标（点它看详情）+ 名字 + 能力；翻页 / 关闭在最下面一行
//   图标图叠在按钮上面、且不接鼠标，点下去穿到按钮（跟魔典座位一个做法）
void BOTC_BuildAbNew () {
    int f;
    int i;
    int p;
    int base;
    int gbase;
    for (p = 1; p <= 13; p += 1) {
        base = p * 26;
        gbase = p * 8;
        DialogCreate(1180, 1080, c_anchorCenter, 0, 0, false);
        g_abNewDlg[p] = DialogLastCreated();
        DialogSetVisible(g_abNewDlg[p], PlayerGroupAll(), false);
        g_abViewBtn[p] = BOTC_NewButton(g_abNewDlg[p], 200, 30, 20, 4, "夜间行动顺序");
        g_abNewLbl[p] = BOTC_NewLabel(g_abNewDlg[p], 920, 30, 240, 6, StringToText("剧本角色表"));
        libNtve_gf_SetDialogItemStyle(g_abNewLbl[p], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_abNewLbl[p], false, PlayerGroupAll());
        for (i = 0; i < 4; i += 1) {
            g_abNewSec[(p * 4) + i] = BOTC_NewLabel(g_abNewDlg[p], 560, 26, 20, 44, StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_abNewSec[(p * 4) + i], "ModLeftSize20Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_abNewSec[(p * 4) + i], false, PlayerGroupAll());
            DialogControlSetVisible(g_abNewSec[(p * 4) + i], PlayerGroupAll(), false);
        }
        for (i = 0; i < 26; i += 1) {
            g_abNewHit[base + i] = BOTC_NewButton(g_abNewDlg[p], 85, 85, 20, 60, "");
            libNtve_gf_CreateDialogItemImage(g_abNewDlg[p], 85, 85, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
            g_abNewIcon[base + i] = DialogControlLastCreated();
            DialogControlSetSize(g_abNewIcon[base + i], PlayerGroupAll(), 85, 85);
            libNtve_gf_SetDialogItemAcceptMouse(g_abNewIcon[base + i], false, PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_abNewIcon[base + i], BOTC_NightIconName(i), PlayerGroupAll());
            DialogControlSetPosition(g_abNewIcon[base + i], PlayerGroupAll(), c_anchorTopLeft, 20, 60);
            DialogControlSetVisible(g_abNewIcon[base + i], PlayerGroupAll(), false);
            g_abNewName[base + i] = BOTC_NewLabel(g_abNewDlg[p], 340, 26, 110, 64, StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_abNewName[base + i], "ModLeftSize20Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_abNewName[base + i], false, PlayerGroupAll());
            g_abNewAb[base + i] = BOTC_NewLabel(g_abNewDlg[p], 460, 96, 110, 92, StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_abNewAb[base + i], "ModLeftSize16Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_abNewAb[base + i], false, PlayerGroupAll());
            DialogControlSetVisible(g_abNewHit[base + i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_abNewName[base + i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_abNewAb[base + i], PlayerGroupAll(), false);
        }
        for (i = 0; i < 4; i += 1) {
            g_abCatPrev[(p * 4) + i] = BOTC_NewButton(g_abNewDlg[p], 38, 22, 865, 44, "<");
            g_abCatNext[(p * 4) + i] = BOTC_NewButton(g_abNewDlg[p], 38, 22, 909, 44, ">");
            DialogControlSetVisible(g_abCatPrev[(p * 4) + i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_abCatNext[(p * 4) + i], PlayerGroupAll(), false);
        }
        g_glossNote[p] = BOTC_NewLabel(g_abNewDlg[p], 1140, 24, 20, 44, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_glossNote[p], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_glossNote[p], false, PlayerGroupAll());
        DialogControlSetVisible(g_glossNote[p], PlayerGroupAll(), false);
        for (i = 0; i < 6; i += 1) {
            g_glossTitleCtl[gbase + i] = BOTC_NewLabel(g_abNewDlg[p], 1140, 26, 20, 74 + (i * 130), StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_glossTitleCtl[gbase + i], "ModLeftSize20Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_glossTitleCtl[gbase + i], false, PlayerGroupAll());
            DialogControlSetVisible(g_glossTitleCtl[gbase + i], PlayerGroupAll(), false);
            for (f = 0; f < 3; f += 1) {
                g_glossBodyCtl[(p * 24) + (i * 3) + f] = BOTC_NewLabel(g_abNewDlg[p], 1140, 26, 20, 104 + (i * 130) + (f * 30), StringToText(""));
                libNtve_gf_SetDialogItemStyle(g_glossBodyCtl[(p * 24) + (i * 3) + f], "ModLeftSize16Bold", PlayerGroupAll());
                libNtve_gf_SetDialogItemAcceptMouse(g_glossBodyCtl[(p * 24) + (i * 3) + f], false, PlayerGroupAll());
                DialogControlSetVisible(g_glossBodyCtl[(p * 24) + (i * 3) + f], PlayerGroupAll(), false);
            }
        }
        g_abNewPrev[p] = BOTC_NewButton(g_abNewDlg[p], 200, 40, 20, 1012, "上一页");
        g_abNewNext[p] = BOTC_NewButton(g_abNewDlg[p], 200, 40, 240, 1012, "下一页");
        g_abNewClose[p] = BOTC_NewButton(g_abNewDlg[p], 160, 40, 460, 1012, "关闭");
        g_abNewStarNote[p] = BOTC_NewLabelC(g_abNewDlg[p], 1140, 26, 20, 978, StringToText("每个夜晚* 代表从第二夜开始"));
        libNtve_gf_SetDialogItemStyle(g_abNewStarNote[p], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_abNewStarNote[p], false, PlayerGroupAll());
        DialogControlSetVisible(g_abNewStarNote[p], PlayerGroupAll(), false);
        g_abSubPrev[p] = BOTC_NewButton(g_abNewDlg[p], 38, 22, 865, 44, "<");
        g_abSubNext[p] = BOTC_NewButton(g_abNewDlg[p], 38, 22, 909, 44, ">");
        DialogControlSetVisible(g_abSubPrev[p], PlayerGroupAll(), false);
        DialogControlSetVisible(g_abSubNext[p], PlayerGroupAll(), false);
        g_glossPage[p] = 1;
        for (i = 0; i < 4; i += 1) {
            g_abCatPage[(p * 4) + i] = 1;
        }
        DialogSetVisible(g_abNewDlg[p], PlayerGroupSingle(p), false);
    }
}

// 每条摆到 (col,row)：图标按钮 + 名字 + 能力（位置/大小 = 旧版排版，一模一样）
void BOTC_AbNewEntry (int p, int slot, int r, int x, int y, int w) {
    int idx;
    idx = (p * 26) + slot;
    g_abNewRole[idx] = r;
    DialogControlSetPosition(g_abNewHit[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_abNewIcon[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    libNtve_gf_SetDialogItemImage(g_abNewIcon[idx], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_abNewName[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y);
    DialogControlSetPosition(g_abNewAb[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 26);
    // 【条目宽度 w】（用户 2026-10-04）：爪牙 / 恶魔 那两段改成**三列**，文字框必须跟着变窄，
    //   否则会压到右边那一列的图标上。镇民 / 外来者 / 传奇仍然用 460（两列）。
    DialogControlSetSize(g_abNewName[idx], PlayerGroupSingle(p), w, 26);
    DialogControlSetSize(g_abNewAb[idx], PlayerGroupSingle(p), w, 96);
    libNtve_gf_SetDialogItemText(g_abNewName[idx], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abNewAb[idx], BOTC_KeyColor(g_tipAbility[r]), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abNewHit[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewIcon[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewName[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewAb[idx], PlayerGroupSingle(p), true);
}

void BOTC_AbCatCtrlRender (int p, int t) {
    int cap;
    int page;
    int pages;
    int y;
    if (p < 1 || p > 13 || t < 0 || t > 3) {
        return;
    }
    cap = BOTC_AbCatCap(t);
    pages = BOTC_GridCatPages(t, cap);
    page = g_abCatPage[(p * 4) + t];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_abCatPage[(p * 4) + t] = page;
    if (pages <= 1) {
        DialogControlSetVisible(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), false);
        return;
    }
    // 镇民有两列，底部最后一行结束于 y=822；翻页按钮放到它右下方的空行。
    y = 834;
    if (t == 1) { y = 46; }
    if (t == 2) { y = 416; }
    if (t == 3) { y = 686; }
    DialogControlSetPosition(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), c_anchorTopLeft, 865, y);
    DialogControlSetPosition(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), c_anchorTopLeft, 909, y);
    libNtve_gf_SetDialogItemText(g_abCatPrev[(p * 4) + t], StringToText("<"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abCatNext[(p * 4) + t], StringToText(">"), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), true);
}

