    int r;
    int n;
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 2) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "场上没有爪牙（提线木偶不算）。");
        return;
    }
    BOTC_PmStore(g_teller, "【不在场身份】已发给 " + IntToString(n) + " 名爪牙（逐条记录见上）。");
}

// 【发送给所有疯子】（用户 2026-11-06）：真疯子 + 带「是疯子」的哲学家都算，统一发当前 3 个身份。
void BOTC_BluffSendToAllLunatics () {
    int i;
