// 【赌徒 · 说书人判定】（用户 2026-11-01）：猜「陌客」/「间谍」，
//   目标登记成陌客 / 爪牙 / 恶魔（或间谍 / 镇民 / 外来者）时，对错由说书人自己判。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildGambleDecide () {
    DialogCreate(720, 210, c_anchorRight, 320, -70, false);
    g_gblDlg = DialogLastCreated();
    DialogSetVisible(g_gblDlg, PlayerGroupAll(), false);
    g_gblLbl = BOTC_NewLabel(g_gblDlg, 640, 30, 14, 10, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_gblLbl, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_gblLbl, false, PlayerGroupAll());
    g_gblAsk = BOTC_NewLabel(g_gblDlg, 640, 30, 14, 44, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_gblAsk, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_gblAsk, false, PlayerGroupAll());
    g_gblLive = BOTC_NewButton(g_gblDlg, 168, 54, 66, 122, "存活");
    g_gblDie = BOTC_NewButton(g_gblDlg, 168, 54, 386, 122, "死亡");
    // 【右上角 X】（用户 2026-11-01）：关掉弹窗 = 判定「不死亡」
    g_gblX = BOTC_NewButton(g_gblDlg, 30, 26, 678, 6, "X");
    DialogSetVisible(g_gblDlg, PlayerGroupSingle(g_teller), false);
}

void BOTC_GblOpen (int p, int guess) {
    int real;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    real = BOTC_RegRoleOf(g_gambleTarget[p]);
    g_gblSeat = p;
    s = "【赌徒】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(g_gambleTarget[p]) + " 是「" + g_roleName[guess] + "」。";
    libNtve_gf_SetDialogItemText(g_gblLbl, StringToText(s), PlayerGroupSingle(g_teller));
    s = "登记的是「" + BOTC_RoleNameSafe(real) + "」。判定他是否死亡？";
    libNtve_gf_SetDialogItemText(g_gblAsk, StringToText(s), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_gblDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, s + "（已在面板上让你选）");
}

void BOTC_GblPick (int p, int dead) {
    int q;
    string blk;
    if (p != g_teller || g_gblSeat < 2 || g_gblSeat > 13) {
        return;
    }
    q = g_gblSeat;
    g_gblSeat = 0;
    DialogSetVisible(g_gblDlg, PlayerGroupSingle(g_teller), false);
    if (dead == 0) {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(q) + "：说书人判定他这一次没有死。");
        return;
    }
    blk = BOTC_DeathBlocker(q, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【赌徒】猜错了，但他身上带着【" + blk + "】，这一次没有死。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(q);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 1, 0, 27);
    BOTC_PmStore(g_teller, "【赌徒】猜错了：他在今晚死亡。");
}

// 面板被收掉（天亮收技能 / 说书人收回唤醒）时：没选就按「不死亡」处理
void BOTC_GblClose () {
    if (g_gblSeat < 2) {
        return;
    }
    BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(g_gblSeat) + "：判定面板被收掉，按不死亡处理。");
    DialogSetVisible(g_gblDlg, PlayerGroupSingle(g_teller), false);
    g_gblSeat = 0;
}

string BOTC_HdPickStr (int v) {
    if (v == 1) {
        return "活着";
    }
    if (v == 2) {
        return "死亡";
    }
    return "？";
}

void BOTC_HdHide () {
    int ob;
    for (ob = 1; ob <= 13; ob += 1) {
        DialogSetVisible(g_hdDlg[ob], PlayerGroupAll(), false);
        g_hdPick[ob] = 0;
        g_hdBySt[ob] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 108] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 109] = false;
        g_tokOn[(((g_teller * 14) + ob) * 256) + 110] = false;
    }
    BOTC_GrimRender(g_teller);
    g_hdActive = false;
    g_hdNow = -1;
    g_hdAutoSeat = 0;
}

void BOTC_HdStart (int p, int a, int b, int c) {
    if (p < 1 || p > 13) {
        return;
    }
    if (a < 2 || a > 13 || b < 2 || b > 13 || c < 2 || c > 13) {
        return;
    }
    BOTC_HdHide();
    g_hdTar[0] = a;
    g_hdTar[1] = b;
    g_hdTar[2] = c;
    // 【官方标记 1 / 2 / 3】（用户 2026-09-26）：按哈迪寂亚选人的顺序打在那三名玩家身上
    g_tokOn[(((g_teller * 14) + a) * 256) + 108] = true;
    g_tokOn[(((g_teller * 14) + b) * 256) + 109] = true;
    g_tokOn[(((g_teller * 14) + c) * 256) + 110] = true;
    BOTC_GrimRender(g_teller);
    g_hdActive = true;
    g_hdNow = 0;
    BOTC_PmStore(g_teller, "【哈迪寂亚】今晚按顺序选了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "、" + BOTC_NameStr(c) + "。");
    BOTC_HdStep();
}

void BOTC_HdStep () {
    int t;
    if (!g_hdActive) {
        return;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        BOTC_HdResolve();
        return;
    }
    t = g_hdTar[g_hdNow];
    if (t < 2 || t > 13) {
        g_hdNow = g_hdNow + 1;
        BOTC_HdStep();
        return;
    }
    libNtve_gf_SetDialogItemText(g_hdTitle[t], StringToText("哈迪寂亚：你选择活着还是死亡？"), PlayerGroupSingle(g_who[t]));
    DialogSetVisible(g_hdDlg[t], PlayerGroupSingle(g_who[t]), true);
    // 【氛围播报】（用户 2026-09-26）：轮到谁选，左下角公屏就播一句（名字会被换成真名）
    BOTC_PubAnnounce(BOTC_NameStr(t) + "，<c val=\"FF0000\">选择生，亦或是死。</c>");
    BOTC_Notice(g_who[t], "哈迪寂亚选择了你：点【活着】或【死亡】。");
    // 【电脑座位：脚本自动替他选生 / 死】（用户 2026-09-26）
    if (BOTC_SeatIsComputer(t)) {
        g_hdAutoSeat = t;
        TimerStart(g_tHdAuto, 2.0, false, c_timeGame);
    }
    else {
        g_hdAutoSeat = 0;
    }
}

void BOTC_HdPick (int p, int v) {
    int t;
    if (!g_hdActive) {
        return;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        return;
    }
    t = g_hdTar[g_hdNow];
    if (t < 2 || t > 13) {
        return;
    }
    if (p != g_who[t] && p != g_teller) {
        return;
    }
    g_hdPick[t] = v;
    g_hdBySt[t] = false;
    if (p == g_teller && p != g_who[t]) {
        g_hdBySt[t] = true;
    }
    // 【官方标记：死亡 / 复活】（用户 2026-09-26）：选完就把对应的标记打在目标身上
    if (v == 2) {
        g_tokOn[(((g_teller * 14) + t) * 256) + 112] = true;
        g_tokOn[(((g_teller * 14) + t) * 256) + 113] = false;
    }
    else {
        if (v == 1) {
            g_tokOn[(((g_teller * 14) + t) * 256) + 112] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 113] = true;
        }
    }
    BOTC_GrimRender(g_teller);
    DialogSetVisible(g_hdDlg[t], PlayerGroupAll(), false);
    // 【哈迪寂亚：切目标前把别的目标那份小窗收掉】（用户 2026-10-03）
//   ⚠ 必须判座位号有效：活人不够时 g_hdTar[1]/[2] 会是 0，直接拿去当对话框 ID 会让整个函数中断（生死都不判了）
if (g_hdTar[0] >= 2 && g_hdTar[0] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[0]], PlayerGroupAll(), false);
}
if (g_hdTar[1] >= 2 && g_hdTar[1] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[1]], PlayerGroupAll(), false);
}
if (g_hdTar[2] >= 2 && g_hdTar[2] <= 13) {
    DialogSetVisible(g_hdDlg[g_hdTar[2]], PlayerGroupAll(), false);
}if (g_hdBySt[t]) {
        BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 由你说书人代选：" + BOTC_HdPickStr(v) + "。");
    }
    else {
        BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 选了" + BOTC_HdPickStr(v) + "。");
    }
    g_hdNow = g_hdNow + 1;
    BOTC_HdStep();
}

// 电脑座位到点自动替它选一个（活着 / 死亡各 50%）；人选过了就不再补
bool BOTC_HdAutoFunc (bool testConds, bool runActions) {
    int t;
    int v;
    if (!g_hdActive) {
        return true;
    }
    if (g_hdNow < 0 || g_hdNow > 2) {
        return true;
    }
    t = g_hdTar[g_hdNow];
    if (t != g_hdAutoSeat || t < 2 || t > 13) {
        return true;
    }
    if (g_hdPick[t] != 0) {
        return true;
    }
    if (RandomInt(1, 2) == 1) {
        v = 1;
    }
    else {
        v = 2;
    }
    BOTC_PmStore(g_teller, "【电脑】" + BOTC_NameStr(t) + " 是电脑：脚本自动替他选了「" + BOTC_HdPickStr(v) + "」。");
    BOTC_HdPick(t, v);
    return true;
}

void BOTC_HdResolve () {
    int i;
    int t;
    int nLive;
    if (!g_hdActive) {
        return;
    }
    if (!g_isNight) {
        BOTC_HdHide();
        return;
    }
    // 【1 / 2 / 3 三个数字标记：选完就撤】（用户 2026-09-26）
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t >= 2 && t <= 13) {
            g_tokOn[(((g_teller * 14) + t) * 256) + 108] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 109] = false;
            g_tokOn[(((g_teller * 14) + t) * 256) + 110] = false;
        }
    }
    // 三个人都选「活着」→ 三个人全算「死亡」（先把「复活」撤掉，再统一打「死亡」）
    nLive = 0;
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t >= 2 && t <= 13 && g_tokOn[(((g_teller * 14) + t) * 256) + 113]) {
            nLive = nLive + 1;
        }
    }
    if (nLive >= 3) {
        for (i = 0; i < 3; i += 1) {
            t = g_hdTar[i];
            if (t >= 2 && t <= 13) {
                g_tokOn[(((g_teller * 14) + t) * 256) + 113] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 112] = true;
            }
        }
        BOTC_PmStore(g_teller, "【哈迪寂亚】三个人都选了「活着」→ 三个人全部死亡。");
    }
    // 按标记落生死：「死亡（哈迪寂亚）」→ 死；「复活（哈迪寂亚）」→ 存活（原本已死的复活）
    for (i = 0; i < 3; i += 1) {
        t = g_hdTar[i];
        if (t < 2 || t > 13) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + t) * 256) + 112]) {
            BOTC_HdKill(t);
        }
        else {
            if (g_tokOn[(((g_teller * 14) + t) * 256) + 113]) {
                if (BOTC_PublicDead(t)) {
                    // 【复活等天亮】（用户 2026-11-02）：已经公开死亡的玩家保留
                    // 「复活（哈迪寂亚）」标记，由天亮播报队列统一清红叉并宣布复活。
                    BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 选择了活着：保留复活标记，天亮统一公布。");
                }
                else {
                    // 【活着的人选「生」不重置能力】（用户 2026-11-04）：只有真正死亡后被复活的玩家
                    //   才在天亮复活流程里重置一次性能力；这里原本对活人也调用 RestoreOneShot，属于错误回复。
                    BOTC_ClearDeath(t);
                    g_tokOn[(((g_teller * 14) + t) * 256) + 113] = false;
                }
            }
        }
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【哈迪寂亚】结算完成：本夜死亡已记录，复活标记保留到天亮统一公布。");
    BOTC_HdHide();
}

void BOTC_HdKill (int t) {
    if (t < 2 || t > 13) {
        return;
    }
    // 此时「死亡（哈迪寂亚）」刚点亮，SeatDead 已为真，不能因此跳过真正的死亡记录。
    if (BOTC_PublicDead(t)) {
        return;
    }
    BOTC_MarkDeathQuietSrc(t, 1, 1, 87);
    BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(t) + " 因哈迪寂亚死亡（天亮统一公布）。");
}

void BOTC_SlayAsk (int p, int q) {
    bool manual;
    if (!g_started || g_isNight) {
        return;
    }
    manual = BOTC_SlayAskManual();
    g_slayAskOn = true;
    g_slayAskGolem = false;
    g_slayAskPsy = false;
    g_slayAskVirgin = false;
    g_slaySilentNo = false;
    g_slayAskP = p;
    g_slayAskQ = q;
    // 标题带上「谁猎杀谁」（替掉原来那两行说明；正文与参考行 2026-09-16 按要求删掉）
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), false);
    if (manual) {
        // 【说书人拍板】牙噶巴卜 / 无神论者局：不管他是不是真猎手，两个按钮都能点
        g_slayAuto = false;
        g_slayAskSec = 30;             // 30 拍 = 15 秒，没选自动按【否】
        g_slayCanYes = true;
        DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), true);
        libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(p) + StringToText(" 猎杀 ") + BOTC_PlayerNameText(q) + StringToText("：是否让他击杀？"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
        DialogControlSetPosition(g_slayNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
        DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
        // 发起人那边给个提示：让他知道球在说书人手里
        BOTC_Notice(g_who[p], "已把猎杀请求发给说书人：" + BOTC_NameStr(q) + "。等他说书人决定。");
        // 【只有有能力的人才提醒】（用户 2026-11-04）：假声称不写私聊；中毒 / 醉酒 / 已失去能力额外提醒
        if (BOTC_HasAbility(p, 10)) {
            if (BOTC_SlayCanKill(p)) {
                BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "。供参考：他的猎手能力可用。");
            }
            else {
                BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "。供参考：他中毒 / 醉酒 / 已经失去能力。");
            }
        }
        return;
    }
    // 【其他板子】不弹窗：1..15 秒内自动判定（有能力 = 是；没能力 / 中毒醉酒 = 否 + 无事发生）
    g_slayAuto = true;
    g_slayAskSec = RandomInt(2, 30);   // 0.5 秒一拍：1..15 秒
    // 自动判定看的是「能力可用 + 目标在猎手眼里登记为恶魔」；登记不是恶魔时按规则也是无事发生
    g_slayCanYes = BOTC_SlayCanKill(p) && (BOTC_PairTeam(p, q) == 3);
    DialogSetVisible(g_slayDlg, PlayerGroupAll(), false);
    BOTC_Notice(g_who[p], "你的猎杀声称已提交，结果稍后公布。");
    if (BOTC_HasAbility(p, 10)) {
        if (!BOTC_SlayCanKill(p)) {
            BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "，但他中毒 / 醉酒 / 已经失去能力 → 自动按无事发生。");
        }
        else {
            if (BOTC_PairTeam(p, q) != 3) {
                BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "，能力可用，但目标不是恶魔 → 自动按无事发生。");
            }
            else {
                BOTC_PmStore(g_teller, "【猎手请求】" + BOTC_NameStr(p) + " 声称【猎手】要杀 " + BOTC_NameStr(q) + "，能力可用，将自动结算。");
            }
        }
    }
}

// 说书人的回答：ans = 1 → 执行击杀；ans = 0 → 无事发生
void BOTC_SlayAnswer (int ans) {
    int p;
    int q;
    if (!g_slayAskOn) {
        return;
    }
    p = g_slayAskP;
    q = g_slayAskQ;
    // 【检测真身】不是清醒的真猎手 → 这一枪按规则不生效：说书人只能点【否】
    //   （按钮本来就藏了，这里再兜一层，免得误点）
    //   ⚠ Galaxy 的 && 只吃 bool，ans 是 int，必须写成 ans != 0
    if (ans != 0 && !g_slayCanYes) {
        if (g_slayAskPsy) {
            BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【精神病患者】。");
        }
        else {
            if (g_slayAskGolem) {
                BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【魔像】。");
            }
            else {
                BOTC_Notice(g_teller, "这次只能选【否】：他不是清醒的【猎手】（真身 / 状态见弹窗那一行参考）。");
            }
        }
        return;
    }
    if (g_slayAskGolem) {
        if (ans != 0 && g_started && !g_isNight && q >= 2 && q <= 13 && !BOTC_SeatDead(q)) {
            BOTC_GolemKill(q);
        }
        else {
            if (!g_slaySilentNo) {
                BOTC_PubAnnounce("【说书人】：无事发生。");
            }
        }
        BOTC_SlayAskHide();
        return;
    }
    if (g_slayAskPsy) {
        if (ans != 0 && g_started && !g_isNight && q >= 2 && q <= 13 && !BOTC_SeatDead(q)) {
            BOTC_PsyKill(q);
        }
        else {
            BOTC_PubAnnounce("【说书人】：无事发生。");
        }
        BOTC_SlayAskHide();
        return;
    }

    if (g_slayAskVirgin) {
        if (ans != 0) {
            BOTC_VirginKill(p, q);
        }
        else {
            BOTC_PmStore(g_teller, "【贞洁者】你点了【否】：这次不处决提名者，提名流程照常进行。");
            if (!g_slaySilentNo) {
                BOTC_PubAnnounce("【说书人】：无事发生。");
            }
        }
        BOTC_SlayAskHide();
        // 处决没把提名环节收掉（说书人点了【否】/ 今天已经处决过）→ 这次提名照常往下走
        if (g_phase == 2) {
            libNtve_gf_StopTimer(g_tSpeech);
            TimerStart(g_tSpeech, 60.0, false, c_timeGame);
            BOTC_PhaseSet(3);
        }
        return;
    }
    BOTC_SlayAskHide();
    if (ans == 0) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        return;
    }
    // 拍板之后局势可能已经变了（比如他又死了 / 入夜了）：那就当无事发生
    if (!g_started || g_isNight || p < 1 || p > 13 || q < 2 || q > 13 || BOTC_SeatDead(q)) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        return;
    }
    BOTC_SlayKill(p, q);
}

void BOTC_SlayAskHide () {
    g_slayAskOn = false;
    g_slayAuto = false;                // 自动判定也一并收掉
    g_slayAskSec = 0;                  // 【15 秒兜底】（用户 2026-11-01）：拍板了就停表
    g_slayAskP = 0;
    g_slayAskQ = 0;
    g_slayCanYes = false;
    g_slayAskGolem = false;
    g_slayAskPsy = false;
    g_slayAskVirgin = false;
    g_slaySilentNo = false;
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_slayYes, StringToText("是：让他击杀"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_slayNo, StringToText("否：无事发生"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_slayDlg, PlayerGroupAll(), false);
}

// 【检测真身】这个人现在到底能不能杀：只有「真猎手 + 没中毒 / 没酒鬼 + 能力没用掉」才为真。
//   说书人的弹窗里，只有这种人才给【是】按钮，其余一律只能点【否】。
bool BOTC_SlayCanKill (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (!BOTC_AbilityWorks(p, 10)) {
        return false;                  // 没有猎手能力，或科学怪人来源失效
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 12]) {
        return false;                  // 已经失去能力
    }
    return true;
}

// 【只给说书人看的参考】他到底是不是真猎手、现在能不能杀（玩家看不到这一段）
//   能杀 → 两个按钮都能点；不能杀 → 弹窗里只有【否】能点（文案里写清楚）
string BOTC_SlayHintStr (int p) {
    if (p < 1 || p > 13) {
        return "供参考：这个人不在场。";
    }
    if (BOTC_SlayCanKill(p)) {
        return "供参考：他是真的【猎手】，能力还在 ---- 两个按钮都能点（按规则只有打到恶魔才会死）。";
    }
    // 以下都是「按规则这一枪不生效」的人 ---- 弹窗里只有【否】能点
    if (BOTC_SeatTrueRole(p) == 14) {
        return "供参考：他以为自己是【猎手】，其实是酒鬼 ---- 这一枪不算（只有【否】能点）。";
    }
    if (BOTC_SeatTrueRole(p) != 10) {
        return "供参考：他并不是真的【猎手】（真身：" + g_roleName[BOTC_SeatTrueRole(p)] + "）---- 这一枪不算（只有【否】能点）。";
    }
    if (BOTC_SeatIsPoisoned(p)) {
        return "供参考：他是真的【猎手】，但现在中毒 ---- 这一枪不算（只有【否】能点）。";
    }
    return "供参考：他是真的【猎手】，但已经失去能力 ---- 这一枪不算（只有【否】能点）。";
}

// 【执行击杀】真正的击杀代码（智能说书判定命中、或真人说书点【是】时都走这里）：
//   停掉所有音轨 → 2 秒后充能音 → 再 2.5 秒后枪声 → 枪声那一刻才结算死亡（白天死亡 token + 红叉，
//   恶魔死了之后的传位 / 红唇女郎 / 胜负判定跟着走）→ 再 2 秒恢复音轨
//   「停音轨」用自己做的静音音轨 moren 顶住（不然星际自带的种族音乐会冒出来）
void BOTC_SlayKill (int p, int q) {
    BOTC_LoseAbility(p, 12);
    // 【无敌 token 176】（用户 2026-11-04）：带着「无敌」的人白天也打不死 → 公屏无事发生
    if (BOTC_ProtectTokOn(q, 176)) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        BOTC_PmStore(g_teller, "【猎手】" + BOTC_NameStr(p) + " 猎杀 " + BOTC_NameStr(q) + "，但对方带着【无敌】→ 没有死亡。");
        BOTC_GrimRender(g_teller);
        return;
    }
    BOTC_MusicStop();
    BOTC_MusicPlay(g_musicSilentName, 8, 0.5);
    g_snipeTarget = q;
    g_snipeHunter = p;
    g_snipeStage = 1;
    TimerStart(g_tSnipe, 2.0, false, c_timeGame);
}

// 失去能力：猎手用 12 号槽、贞洁者用 17 号槽（都打在说书人那份魔典上）
void BOTC_LoseAbility (int q, int slot) {
    if (q < 2 || q > 13) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + slot] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【失去能力】" + BOTC_NameStr(q) + " 失去了能力。");
}

//==================================================================================================
// 贞洁者（索引 9）：第一次被提名时反应
//   提名者算镇民（按登记，间谍/陌客被看成镇民也算）→ 弹面板让说书人决定处不处决提名者（用户 2026-09-26 改）；
//   说书人选【是】才处决：占掉今天的处决名额、死亡类型＝处决，然后收掉提名环节；选【否】就照常走发言 / 投票。
//   提名者不算镇民，或贞洁者自己中毒/酒鬼 → 无事发生（不公开播报，免得暴露贞洁者），贞洁者失去能力。
//==================================================================================================
bool BOTC_VirginCheck (int nomFrom, int nomTo) {
    if (nomFrom < 2 || nomFrom > 13 || nomTo < 2 || nomTo > 13) {
        return false;
    }
    if (!BOTC_HasAbility(nomTo, 9)) {
        return false;                       // 没有贞洁者能力
    }
    if (g_tokOn[(((g_teller * 14) + nomTo) * 256) + 17]) {
        return false;                       // 已经触发过 / 已经失去能力
    }
    // 中毒 / 酒鬼 / 科学怪人来源失效：能力失效（本人不当场知道），这一次也算用掉
    if (!BOTC_AbilityWorks(nomTo, 9)) {
        BOTC_LoseAbility(nomTo, 17);
        BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 中毒/酒鬼，这次触发无效。");
        return false;
    }
    if (BOTC_SeatRegTeam(nomFrom) == 0) {
        // 【改成说书人拍板】（用户 2026-09-26）：提名者是镇民 → 不自动处决，弹面板让说书人决定
        BOTC_LoseAbility(nomTo, 17);
        if (!g_started) {
            BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 被 " + BOTC_NameStr(nomFrom) + " 提名，但游戏还没正式开始 → 这次不处理。");
            return true;
        }
        BOTC_VirginAsk(nomFrom, nomTo);
        return true;
    }
    // 提名者不算镇民：无事发生（不公开播报），贞洁者失去能力
    BOTC_LoseAbility(nomTo, 17);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 被 " + BOTC_NameStr(nomFrom) + " 提名，但提名者不算镇民：无事发生。");
    return false;
}

// 开贞洁者的拍板面板（真人说书专用）
void BOTC_VirginAsk (int nomFrom, int nomTo) {
    if (!g_started) {
        return;
    }
    if (nomFrom < 2 || nomFrom > 13 || nomTo < 2 || nomTo > 13) {
        return;
    }
    g_slayAskOn = true;
    g_slayAskSec = 0;                  // 贞洁者不参与 15 秒兜底
    g_slayAskVirgin = true;
    g_slayAskGolem = false;
    g_slayAskPsy = false;
    g_slayAskP = nomFrom;
    g_slayAskQ = nomTo;
    g_slayCanYes = true;
    libNtve_gf_SetDialogItemText(g_slayTitle, BOTC_PlayerNameText(nomTo) + StringToText("（贞洁者）被 ") + BOTC_PlayerNameText(nomFrom) + StringToText(" 提名：是否处决他？"), PlayerGroupSingle(g_teller));
    g_slaySilentNo = true;
    DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetPosition(g_slayYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 27, 81);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_slayNo2, PlayerGroupSingle(g_teller), true);
    DialogControlSetPosition(g_slayNo2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 81);
    libNtve_gf_SetDialogItemText(g_slayYes, StringToText("是：处决提名者"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_slayDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 第一次被提名，提名者 " + BOTC_NameStr(nomFrom) + " 是镇民。");
}

// 处决提名者（占掉今天的处决名额），并收掉提名环节
void BOTC_VirginKill (int nomFrom, int nomTo) {
    if (nomFrom < 2 || nomFrom > 13) {
        return;
    }
    // 走普通处决那一套：公屏只播「【处决】X 被处决」，免死（弄臣 / 水手 / 魔鬼代言人…）也照样生效
    BOTC_ExecToggleAt(nomFrom);
    BOTC_PmStore(g_teller, "【贞洁者】" + BOTC_NameStr(nomTo) + " 的能力触发：提名者 " + BOTC_NameStr(nomFrom) + " 按普通处决结算。");
}

//==================================================================================================
// 【黯月初升 · 角色实现】（用户 2026-09-19 起：按索引顺序一个个做）
//   22 祖母 / 23 水手 / 24 侍女
//==================================================================================================

// ■ 祖母（22）：首夜被动。
//   【方案 B（用户 2026-09-20 定）】真孙子 = 说书人秘密指定的那一位，用 **token 30「孙子」** 标在他身上：
//     · 判定「孙子被恶魔杀 → 祖母一起死」**只看 token 30**；说书人把 token 挪到谁身上，谁就是真孙子。
//     · 祖母中毒 / 酒鬼时，她**被告知的是错的孙子**（智能说书随便报另一个善良玩家 + 他的真角色），
//       真孙子不变 ---- 所以「我被告知的孙子活得好好的，我却死了」是正常的。
//     · 首夜定下来后不再重挑（要换人就自己挪 token 30）。
//     · 她自己中毒 / 酒鬼时，孙子被恶魔杀**不会**带走她（能力当时是关着的），只写日志。

// 带着「孙子」token（30）的座位 = 真孙子；没有就返回 0
int BOTC_NanaKidSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 30]) {
            return i;
        }
    }
    return 0;
}

// 场上的祖母坐在哪（按真身找，死活都算）；没有就返回 0
int BOTC_NanaSeatNow () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_HasAbility(i, 22)) {
            return i;
        }
    }
    return 0;
}
void BOTC_NanaPick (int q) {
    int i;
    int r;
    int n;
    int want;
    int pick;
    int told;
    int rTold;
    bool fake;
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 22)) {
        return;
    }
    g_nanaSeat = q;
    if (BOTC_NanaKidSeat() >= 2 && g_nightNum != g_seatFirstNight[q]) {
        return;                                  // 真孙子（token 30）已经定了、而且今晚不是他的「首夜」→ 不重挑
    }
    // ① 先把真孙子定下来：在场 + 活着 + 善良的人里随机挑一个
    pick = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == q) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_RegRoleOf(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_SeatRegAlign(i) != 0) {
            continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
        }
        n = n + 1;
    }
    if (n <= 0) {
        BOTC_PmStore(g_teller, "【祖母】场上没有符合条件的善良玩家，这一次没有指定孙子。");
        return;
    }
    want = RandomInt(1, n);
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (i == q) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_RegRoleOf(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_SeatRegAlign(i) != 0) {
            continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
        }
        n = n + 1;
        if (n == want) {
            pick = i;
        }
    }
    if (pick < 2) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 30] = false;   // 旧的「孙子」token 先全清掉
    }
    g_tokOn[(((g_teller * 14) + pick) * 256) + 30] = true;     // 真孙子带 token 30
    g_nanaKid = pick;
    BOTC_GrimRender(g_teller);
    // ② 再决定告诉她什么：她自己中毒 / 酒鬼 → 报一个**错的孙子**（另一个善良玩家，角色照他的真身报）
    told = pick;
    rTold = BOTC_RegRoleOf(pick);       // 报给她的角色按「互动干扰」那一层（间谍可能被看成镇民）
    fake = false;
    if (BOTC_SeatImpaired(q)) {
        told = 0;
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (i == q || i == pick) {
                continue;
            }
            if (BOTC_SeatDead(i)) {
                continue;
            }
            r = BOTC_RegRoleOf(i);
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_SeatRegAlign(i) != 0) {
                continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
            }
            n = n + 1;
        }
        if (n > 0) {
            want = RandomInt(1, n);
            n = 0;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) {
                    continue;
                }
                if (i == q || i == pick) {
                    continue;
                }
                if (BOTC_SeatDead(i)) {
                    continue;
                }
                r = BOTC_RegRoleOf(i);
                if (r < 0 || r > 163) {
                    continue;
                }
                if (BOTC_SeatRegAlign(i) != 0) {
                    continue;                    // 善良与否按「互动干扰」那一层算（用户 2026-09-20）
                }
                n = n + 1;
                if (n == want) {
                    told = i;
                }
            }
            rTold = BOTC_RegRoleOf(told);
            fake = true;
        }
        else {
            rTold = BOTC_WrongRole(rTold);       // 场上没有别的善良玩家可报：玩家照报，角色名报错的
            fake = true;
        }
        // 【认知覆盖 / 疯子不在场身份】用户 2026-09-20：一半概率改用这两类身份当那条假身份 ----
        //   例：得知「疯子是某个他以为不在场的身份」，或「酒鬼（以为自己是共情者）是共情者」。
        if (RandomInt(1, 2) == 1) {
            g_hintN = 0;
            BOTC_PushLunaticBluffs(0);
            BOTC_PushCogSeenRoles(0);
            BOTC_PushLunaticBluffs(1);
            BOTC_PushCogSeenRoles(1);
            if (g_hintN > 0) {
                rTold = g_fakePool[RandomInt(0, g_hintN - 1)];
                BOTC_PmStore(g_teller, "【祖母】她中毒/酒鬼 → 这条假身份取自「疯子的不在场身份 / 认知覆盖角色以为的身份」：" + g_roleName[rTold] + "。");
            }
        }
    }
    // ③ 说书人日志：真话写在前面，要报的话写在后面
    BOTC_PmStore(g_teller, "【祖母】真孙子 = " + BOTC_NameStr(pick) + "（" + BOTC_RoleNameSafe(BOTC_RegRoleOf(pick)) + "）。他要是被恶魔杀死，祖母会跟着一起死。");
    if (fake) {
        BOTC_PmStore(g_teller, "【祖母】她当时中毒/酒鬼 → 按规则要给她错的：告诉她「" + BOTC_NameStr(told) + " 是一名善良玩家，他的角色是 " + BOTC_RoleNameSafe(rTold) + "」。");
    }
    else {
        BOTC_PmStore(g_teller, "【祖母】告诉她：「" + BOTC_NameStr(told) + " 是一名善良玩家，他的角色是 " + BOTC_RoleNameSafe(rTold) + "」。");
    }
    BOTC_PmStore(g_teller, "【祖母】不满意可以自己把「孙子」token 挪给别人，再按你的说法告诉她。");
}

// 孙子被恶魔杀死 → 祖母一起死。由「恶魔杀人」的入口调用（现在是小恶魔那一刀）。
void BOTC_NanaLinkCheck (int victim) {
    int kid;
    int gm;
    kid = BOTC_NanaKidSeat();                    // 真孙子 = 带着「孙子」token 的那位
    gm = BOTC_NanaSeatNow();
    if (kid < 2 || gm < 2) {
        return;
    }
    if (victim != kid) {
        return;
    }
    if (gm == kid) {
        return;
    }
    if (BOTC_SeatDead(gm)) {
        return;
    }
    if (BOTC_SeatImpaired(gm)) {
        BOTC_PmStore(g_teller, "【祖母】孙子 " + BOTC_NameStr(victim) + " 被恶魔杀死，但祖母 " + BOTC_NameStr(gm) + " 此刻中毒/酒鬼 → 联动没有生效。");
        return;
    }
    BOTC_MarkDeathQuietSrc(gm, 1, 0, 22);      // 祖母：孙子被恶魔杀 → 打「死亡（祖母·孙子）」
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【祖母】孙子 " + BOTC_NameStr(victim) + " 被恶魔杀死 → 祖母 " + BOTC_NameStr(gm) + " 一起死亡。");
    BOTC_PmInfo(g_who[gm], "【信息】你的孙子死了，你也跟着一起死。");
}

//==================================================================================================
// 【「可能」类能力的概率表】（用户 2026-09-20 定）：只给智能说书 / 自动建议用，
//   真人说书人随时可以把 token 挪走，以他为准。想调数字只改这一张表。
//
//   水手（23）「你或他之一会醉酒」：返回**水手自己**醉酒的概率（%），剩下的概率给对方醉酒。
//     普通镇民 20 / 首夜信息位 35 / 外来者 35 / 爪牙 75 / 恶魔 90
//   （「首夜信息位」按用户 2026-09-20 的口径 = **只有首夜能拿到信息的善良角色**：
//     洗衣妇 / 图书管理员 / 调查员 / 厨师 / 祖母 ---- 共情者、占卜师这种每夜都给信息的，
//     以及教父、侍女这种不是首夜一次性信息的，都**不算**）
//==================================================================================================
// 【旅店老板（26）用】「两个目标里该醉哪一个」的档位分（越大越容易醉）：
//   首夜信息位镇民 60 / 普通镇民 50 / 外来者 40 / 爪牙 25 / 恶魔 15（用户 2026-09-20 定的）

// 赌徒（智能说书）：从当前板子的角色清单里随机挑一个（含本局没发的身份）
int BOTC_RandomBoardRole () {
    int k;
    BOTC_GridPlan();
    if (g_gridN <= 0) {
        return -1;
    }
    k = RandomInt(0, g_gridN - 1);
    return g_gridSlot[k];
}

// 赌徒（27）结算：跟**真身**比（用户 2026-09-20：干扰身份不算）。猜错当晚死亡；
//   他自己中毒 / 酒鬼时结果**反过来**（说书人骗他）。死亡走「夜间·其他」，天亮才公开。
void BOTC_GambleGuess (int p, int guess) {
    int real;
    bool right;
    bool works;
    string blk;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_gambleTarget[p] < 2) {
        return;
    }
    g_gambleWait[p] = false;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), false);      // 智能说书兜底代猜时它不是被点击关的，这里统一关
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_who[p]));
    if (guess < 0 || guess > 163) {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 这次没有猜，没有结算。");
        return;
    }
    real = BOTC_RegRoleOf(g_gambleTarget[p]);      // 猜的是「这个世界看到的他」（互动干扰算在内）
    right = (real == guess);
    works = BOTC_SkillWorks(p);
    if (!works) {
        // 中毒 / 酒鬼的赌徒：能力失效 → 这一晚不会死（不是「结果反转」，用户 2026-09-21 明确）
        //   （他猜错却活了下来，就会以为自己猜对了 = 这条假信息）
        //   【数学家】只有「猜错了本来该死却没死」才算未正常生效；猜对了本来就不死 → 不记
        if (real != guess) {
            BOTC_MalfNote(p, "赌徒中毒/酒鬼：本来猜错会死，这一次没死");
        }
        right = true;
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 按百科不放死亡标记，这一晚不会死。");
    }
    if (real >= 0 && real <= 163) {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(g_gambleTarget[p]) + " 是「" + g_roleName[guess] + "」，登记的是「" + BOTC_RoleNameSafe(real) + "」。");
    }
    else {
        BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(g_gambleTarget[p]) + " 是「" + g_roleName[guess] + "」。");
    }
    // 【陌客 / 间谍 · 说书人拍板】（用户 2026-11-01）：这两种身份登记成什么由说书人自己挑，
    //   所以猜它们时脚本不能自己算对错 → 弹面板让说书人决定他死不死。
    if (works && real >= 0 && real <= 163) {
        if (guess == 15 && (real == 15 || BOTC_RoleTeam(real) == 2 || BOTC_RoleTeam(real) == 3)) {
            BOTC_GblOpen(p, guess);
            return;
        }
        if (guess == 18 && (real == 18 || BOTC_RoleTeam(real) == 0 || BOTC_RoleTeam(real) == 1)) {
            BOTC_GblOpen(p, guess);
            return;
        }
    }
    if (right) {
        BOTC_PmStore(g_teller, "【赌徒】猜对了：他今晚不会死。");
        return;
    }
    blk = BOTC_DeathBlocker(p, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【赌徒】猜错了，但他身上带着【" + blk + "】，这一次没有死。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(p);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(p, 1, 0, 27);   // 赌徒：打「死亡（赌徒）」（大类仍是夜间·其他）
    BOTC_PmStore(g_teller, "【赌徒】猜错了：他在今晚死亡。");
}

// 赌徒取消这次猜测：不结算（他还能再用【使用技能】重来）
void BOTC_GambleCancel (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_gambleWait[p]) {
        return;
    }
    g_gambleWait[p] = false;
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_who[p]));
    BOTC_PmStore(g_teller, "【赌徒】" + BOTC_NameStr(p) + " 取消了这次猜测，没有结算。");
}


//==================================================================================================
// 【黯月初升 · 角色实现 第 3 批】（用户 2026-09-20）：28 造谣者 / 29 侍臣 / 30 教授
//==================================================================================================

// ■ 造谣者（28）：白天公开声明一句话，当晚如果它是真的，一名玩家死亡。
//   ⚠ 这个版本的星际**没有**「输入框输入完成（回车）」事件（见 Init 里那行注释），所以只能点【确定】提交。
void BOTC_BuildGossip () {
    DialogCreate(684, 198, c_anchorRight, 185, -70, false);
    g_gossipDlg = DialogLastCreated();
    DialogSetVisible(g_gossipDlg, PlayerGroupAll(), false);
    g_gossipTitle = BOTC_NewLabel(g_gossipDlg, 648, 30, 18, 13, StringToText("公开声明一句话（最多约 40 个汉字；今晚如果它是真的，一名玩家会死亡）"));
    libNtve_gf_SetDialogItemStyle(g_gossipTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_gossipTitle, false, PlayerGroupAll());
    g_gossipEdit = BOTC_NewEdit(g_gossipDlg, 630, 41, 27, 50);
    g_gossipOk = BOTC_NewButton(g_gossipDlg, 216, 40, 126, 135, "确定（公开声明）");
    g_gossipCancel = BOTC_NewButton(g_gossipDlg, 144, 40, 378, 135, "取消");
}

void BOTC_GossipOpen (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "造谣者只能在白天公开声明。");
        return;
    }
    if (g_gossipDay[BOTC_PosOf(p)] != g_dayNum) {
        g_gossipDone[BOTC_PosOf(p)] = false;     // 日切兜底：当天没有声明记录
    }
    if (g_gossipDone[BOTC_PosOf(p)]) {
        BOTC_Notice(p, "你今天已经声明过了：造谣者一天只能声明一次。");
        return;
    }
    g_gossipRole = 28;
    libNtve_gf_SetDialogItemText(g_gossipTitle, StringToText("公开声明一句话（最多约 40 个汉字；今晚如果它是真的，一名玩家会死亡）"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_gossipOk, StringToText("确定（公开声明）"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_gossipEdit, StringToText(""), PlayerGroupSingle(p));
    DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "在输入框里写下你要公开声明的话（最多约 40 个汉字），然后点【确定】。（这个版本没有回车提交，请用按钮）");
}

// 【杂耍艺人】（58）的公开猜测面板（用户 2026-09-21）：5 组「座位号 + 选身份」，按钮做小才放得下。
//   白天一次；内容只有播报和说书人日志，晚上用「猜对几个」的数字框给他数字（脚本不核对，猜的内容算不了）。
void BOTC_BuildJuggler () {
    int i;
    int y;
    DialogCreate(684, 297, c_anchorRight, 185, -70, false);
    g_juggDlg = DialogLastCreated();
    DialogSetVisible(g_juggDlg, PlayerGroupAll(), false);
    g_juggTitle = BOTC_NewLabel(g_juggDlg, 648, 30, 18, 11, StringToText("公开猜测：填座位号（1~12 = 玩家 1~12），再点右边的小按钮选身份"));
    libNtve_gf_SetDialogItemStyle(g_juggTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_juggTitle, false, PlayerGroupAll());
    for (i = 0; i < 5; i += 1) {
        y = 43 + (i * 38);
        g_juggSeatEdit[i] = BOTC_NewEdit(g_juggDlg, 86, 32, 27, y);
        g_juggRoleBtn[i] = BOTC_NewButton(g_juggDlg, 378, 32, 126, y, "选身份");
        libNtve_gf_SetDialogItemStyle(g_juggRoleBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
        g_juggRole[i] = 0;
    }
    g_juggRow = 0;
    g_juggOk = BOTC_NewButton(g_juggDlg, 216, 40, 126, 241, "确定（公开猜测）");
    g_juggCancel = BOTC_NewButton(g_juggDlg, 144, 40, 378, 241, "取消");
}

// 5 个小按钮的文字：选过就写「第N个：角色名」，没选写「第N个：选身份」
void BOTC_JugglerRowRender (int p) {
    int i;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    for (i = 0; i < 5; i += 1) {
        s = "第 " + IntToString(i + 1) + " 个：";
        if (g_juggRole[i] > 0) {
            s = s + g_roleName[g_juggRole[i]];
        }
        else {
            s = s + "选身份";
        }
        libNtve_gf_SetDialogItemText(g_juggRoleBtn[i], StringToText(s), PlayerGroupSingle(p));
    }
}

// 打开面板（白天一次）
void BOTC_JugglerOpen (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "杂耍艺人只能白天公开猜。");
        return;
    }
    if (g_juggDone[BOTC_PosOf(p)]) {
        BOTC_Notice(p, "你今天已经猜过了：杂耍艺人一天只能公开猜一次。");
        return;
    }
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
        libNtve_gf_SetDialogItemText(g_juggSeatEdit[i], StringToText(""), PlayerGroupSingle(p));
    }
    BOTC_JugglerRowRender(p);
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "填座位号（1~12），再点右边的小按钮给这一格选身份；填几组就是猜几个人。");
}

// 点第 row 格的「选身份」：弹身份网格（模式 13），选完回到这个面板
void BOTC_JugglerPickRow (int p, int row) {
    if (p < 1 || p > 13 || row < 1 || row > 5) {
        return;
    }
    g_juggRow = row;
    g_pickMode[p] = 13;
    g_pickWho[p] = p;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("第 " + IntToString(row) + " 个猜的身份"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(p));
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);      // 先收起来，别跟身份网格叠一起
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 【确定（公开猜测）】：把填好的几组拼成一句话播报出去
void BOTC_JugglerOk (int p) {
    int i;
    int n;
    int ln;
    int seat;
    int num;
    int bi;
    bool works;
    string s;
    string one;
    string line;
    if (p < 1 || p > 13) {
        return;
    }
    s = "";
    n = 0;
    ln = 0;
    bi = 0;
    line = "";
    works = BOTC_AbilityWorks(BOTC_PosOf(p), 58);
    // 【记账】（用户 2026-11-04）：先用这一轮提交的猜测覆盖该玩家之前的记录。
    if (works) {
        g_juggBookN[p] = 0;
    }
    for (i = 0; i < 5; i += 1) {
        if (g_juggRole[i] <= 0) {
            continue;
        }
        seat = 0;
        num = BOTC_TextNum(libNtve_gf_DialogItemEditValue(g_juggSeatEdit[i], p));
        if (num >= 1 && num <= 12) {
            seat = num + 1;
        }
        if (seat < 2) {
            continue;                     // 身份选了但座位号没填 / 填错：这一组不算
        }
        one = BOTC_NameStr(seat) + " 是 " + g_roleName[g_juggRole[i]];
        // 【记账】（用户 2026-11-04）：真能力生效的公开猜测记下来，夜间脚本据此算「猜对几个」。
        if (works && bi < 5) {
            g_juggBookSeat[(p * 5) + bi] = g_who[seat];
            g_juggBookRole[(p * 5) + bi] = g_juggRole[i];
            g_juggBookN[p] = g_juggBookN[p] + 1;
            bi = bi + 1;
        }
        // 【干扰提示】（用户 2026-09-21）：猜到的是陌客 / 间谍（互动干扰）→ 打「干扰」(91)；
        //   猜对几个已改由说书人自行判断（用户 2026-11-04），不再自动计数或打「猜测正确」。
        // 假声称只公聊播报，不记「干扰」，免得污染真杂耍艺人当晚的提示。
        if (works) {
            if (BOTC_SeatTrueRole(seat) != g_juggRole[i] && BOTC_RoleDisguiseStr(BOTC_SeatTrueRole(seat)) != "") {
                g_tokOn[(((g_teller * 14) + seat) * 256) + 91] = true;
                BOTC_PmStore(g_teller, "【杂耍艺人】" + BOTC_NameStr(seat) + " 其实是" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(seat)) + "（互动干扰）：他猜的是" + g_roleName[g_juggRole[i]] + "，算不算对你自己判。");
                if (BOTC_RegRoleOf(seat) == g_juggRole[i]) {
                    BOTC_PmStore(g_teller, "【杂耍艺人】按登记层看，" + BOTC_NameStr(seat) + " 正好被看成" + g_roleName[g_juggRole[i]] + "（这种情况一般算猜对）。");
                }
            }
        }
        if (s == "") {
            s = one;
        }
        else {
            s = s + "，" + one;
        }
        // 【公屏分行】（用户 2026-09-21）：太长会被聊天框截掉，所以每行最多放 2 组；
        //   第一行带前缀，之后的行写「继续：」。
        if (ln == 0) {
            if (n == 0) {
                line = "【杂耍艺人】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开猜测：" + one;
            }
            else {
                line = "　　继续：" + one;
            }
        }
        else {
            line = line + "，" + one;
        }
        ln = ln + 1;
        if (ln >= 2) {
            BOTC_PubAnnounce(line);
            line = "";
            ln = 0;
        }
        n = n + 1;
    }
    if (n <= 0) {
        BOTC_Notice(p, "至少要有一组：座位号（1~12）+ 你猜的身份。");
        return;
    }
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);
    g_juggDone[BOTC_PosOf(p)] = true;
    if (ln > 0) {
        BOTC_PubAnnounce(line);          // 最后一行没凑满 2 组也要发出去（用户 2026-09-21）
        BOTC_DeclareCdSet(p);
    }
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【杂耍艺人】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开猜测：" + s);
    if (works) {
        BOTC_PmStore(g_teller, "【杂耍艺人】唤醒他时脚本已按白天的猜测把「猜对几个」预填在数字框里，可直接确定或改掉。");
    }
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
    }
}

// 【杂耍艺人记账·查主人】（用户 2026-11-04）：优先用当前座位玩家自己的记录；
//   食人族吃了杂耍艺人时没有自己的记录，就退回找真实身份还是杂耍艺人那份。
int BOTC_JugglerBookOwner (int seat) {
    int i;
    int p;
    if (seat < 2 || seat > 13) {
        return 0;
    }
    p = g_who[seat];
    if (p >= 1 && p <= 13 && g_juggBookN[p] > 0) {
        return p;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == 58 && g_juggBookN[g_who[i]] > 0) {
            return g_who[i];
        }
    }
    return 0;
}

// 【杂耍艺人·猜对几个】（用户 2026-11-04）：按白天记账逐条比对，给说书人一个可直接使用的数字。
int BOTC_JugglerCorrect (int seat) {
    int i;
    int owner;
    int t;
    int role;
    int ok;
    owner = BOTC_JugglerBookOwner(seat);
    ok = 0;
    if (owner <= 0) {
        return 0;
    }
    for (i = 0; i < g_juggBookN[owner]; i += 1) {
        t = BOTC_PosOf(g_juggBookSeat[(owner * 5) + i]);
        role = g_juggBookRole[(owner * 5) + i];
        if (t < 2 || t > 13) {
            continue;
        }
        if (BOTC_SeatTrueRole(t) == role || BOTC_RegRoleOf(t) == role) {
            ok = ok + 1;
        }
    }
    return ok;
}

void BOTC_JugglerCancel (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    DialogSetVisible(g_juggDlg, PlayerGroupSingle(p), false);
    for (i = 0; i < 5; i += 1) {
        g_juggRole[i] = 0;
    }
}

// 【戏法师（149）】白天公开猜测：输入座位号，再选择该玩家是爪牙或恶魔。
void BOTC_BuildAlsaahir () {
    int i;
    int y;
    DialogCreate(710, 520, c_anchorRight, 185, -70, false);
    g_alsaDlg = DialogLastCreated();
    DialogSetVisible(g_alsaDlg, PlayerGroupAll(), false);
    g_alsaTitle = BOTC_NewLabel(g_alsaDlg, 674, 34, 18, 8, StringToText("公开猜测：填座位号（1~12），再选他是爪牙还是恶魔"));
    libNtve_gf_SetDialogItemStyle(g_alsaTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_alsaTitle, false, PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        y = 44 + (i * 33);
        g_alsaSeatEdit[i] = BOTC_NewEdit(g_alsaDlg, 86, 28, 27, y);
        g_alsaTypeBtn[i] = BOTC_NewButton(g_alsaDlg, 378, 28, 126, y, "未选");
        libNtve_gf_SetDialogItemStyle(g_alsaTypeBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
    }
    g_alsaOk = BOTC_NewButton(g_alsaDlg, 216, 40, 126, 446, "确定（公开猜测）");
    g_alsaCancel = BOTC_NewButton(g_alsaDlg, 144, 40, 378, 446, "取消");
}

void BOTC_AlsaahirRender (int p) {
    int i;
    int st;
    string s;
    if (p < 1 || p > 13 || !g_alsaOpen[p]) {
        return;
    }
    for (i = 0; i < 12; i += 1) {
        st = g_alsaRowType[(p * 12) + i];
        s = "第 " + IntToString(i + 1) + " 个：";
        if (st == 1) {
            s = s + "爪牙";
        }
        else {
            if (st == 2) {
                s = s + "恶魔";
            }
            else {
                s = s + "未选";
            }
        }
        libNtve_gf_SetDialogItemText(g_alsaTypeBtn[i], StringToText(s), PlayerGroupSingle(p));
    }
}

void BOTC_AlsaahirOpen (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "戏法师只能在白天公开猜测。");
        return;
    }
    if (BOTC_PublicDead(BOTC_PosOf(p))) {
        BOTC_Notice(p, "死亡玩家不能使用戏法师的白天能力。");
        return;
    }
    if (g_alsaDay[p] != g_dayNum) {
        g_alsaDay[p] = -1;
    }
    if (g_alsaDay[p] == g_dayNum) {
        BOTC_Notice(p, "你今天已经提交过戏法师猜测了：每个白天只能猜一次。");
        return;
    }
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
    g_pickMode[p] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    g_pickWho[p] = 0;
    for (q = 0; q <= 13; q += 1) {
        g_alsaChoice[(p * 14) + q] = 0;
        if (q < 12) {
            g_alsaRowType[(p * 12) + q] = 0;
            libNtve_gf_SetDialogItemText(g_alsaSeatEdit[q], StringToText(""), PlayerGroupSingle(p));
        }
    }
    g_alsaOpen[p] = true;
    BOTC_AlsaahirRender(p);
    DialogSetVisible(g_alsaDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "每一行先填座位号（1~12），再点右侧按钮循环选择爪牙 / 恶魔；填几行就是猜几名玩家。");
}

void BOTC_AlsaahirTypeClick (int p, int row) {
    int st;
    if (p < 1 || p > 13 || row < 0 || row >= 12 || !g_alsaOpen[p]) {
        return;
    }
    st = g_alsaRowType[(p * 12) + row] + 1;
    if (st > 2) {
        st = 0;
    }
    g_alsaRowType[(p * 12) + row] = st;
    BOTC_AlsaahirRender(p);
}

int BOTC_AlsaahirTruthKind (int q) {
    int r;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return 0;
    }
    r = BOTC_SeatTrueRole(q);
    if (r == 94) {
        return 2;                         // 军团同时具有爪牙 / 恶魔性质时按恶魔判断
    }
    if (BOTC_RoleTeam(r) == 3) {
        return 2;
    }
    if (BOTC_RoleTeam(r) == 2) {
        return 1;
    }
    return 0;
}

bool BOTC_AlsaahirCorrect (int p) {
    int q;
    if (p < 1 || p > 13) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_alsaChoice[(p * 14) + q] != BOTC_AlsaahirTruthKind(q)) {
            return false;
        }
    }
    return true;
}

void BOTC_AlsaahirSubmit (int p) {
    int i;
    int q;
    int seat;
    int st;
    int n;
    int num;
    string raw;
    bool works;
    string sm;
    string sd;
    if (p < 1 || p > 13 || !g_alsaOpen[p]) {
        return;
    }
    seat = BOTC_PosOf(p);
    for (q = 0; q <= 13; q += 1) {
        g_alsaChoice[(p * 14) + q] = 0;
    }
    n = 0;
    for (i = 0; i < 12; i += 1) {
        st = g_alsaRowType[(p * 12) + i];
        raw = libNtve_gf_DialogItemEditValue(g_alsaSeatEdit[i], p);
        if (StringLength(raw) <= 0) {
            if (st > 0) {
                BOTC_Notice(p, "第 " + IntToString(i + 1) + " 行选了爪牙 / 恶魔，但没有填座位号。");
                return;
            }
            continue;
        }
        num = BOTC_TextNum(raw);
        if (num < 1 || num > 12) {
            BOTC_Notice(p, "第 " + IntToString(i + 1) + " 行座位号无效：请填 1~12。");
            return;
        }
        if (st <= 0) {
            BOTC_Notice(p, "第 " + IntToString(i + 1) + " 行填了座位号，但右侧还没有选择爪牙 / 恶魔。");
            return;
        }
        q = num + 1;
        if (!g_seatOn[q]) {
            BOTC_Notice(p, "第 " + IntToString(i + 1) + " 行座位 " + IntToString(num) + " 上没有玩家。");
            return;
        }
        if (g_alsaChoice[(p * 14) + q] > 0) {
            BOTC_Notice(p, "座位 " + IntToString(num) + " 重复出现，请把重复的那一行删掉或留空。");
            return;
        }
        g_alsaChoice[(p * 14) + q] = st;
        n = n + 1;
    }
    if (n <= 0) {
        BOTC_Notice(p, "至少输入一组座位号和爪牙 / 恶魔分类。");
        return;
    }
    sm = "";
    sd = "";
    for (q = 2; q <= 13; q += 1) {
        st = g_alsaChoice[(p * 14) + q];
        if (st == 1) {
            if (StringLength(sm) > 0) {
                sm = sm + ",";
            }
            sm = sm + BOTC_NameStr(q);
        }
        else {
            if (st == 2) {
                if (StringLength(sd) > 0) {
                    sd = sd + ",";
                }
                sd = sd + BOTC_NameStr(q);
            }
        }
    }
    if (StringLength(sm) <= 0) {
        sm = "无";
    }
    if (StringLength(sd) <= 0) {
        sd = "无";
    }
    DialogSetVisible(g_alsaDlg, PlayerGroupSingle(p), false);
    g_alsaOpen[p] = false;
    g_alsaDay[p] = g_dayNum;
    BOTC_PubAnnounce("【戏法师】" + BOTC_NameStr(seat) + " 公开猜测。爪牙：" + sm + "。");
    BOTC_PubAnnounce("恶魔：" + sd + "。");
    BOTC_DeclareCdSet(g_who[seat]);
    if (!BOTC_HasAbility(seat, 149)) {
        return;                        // 假声称：不给说书人私聊提醒（用户 2026-11-04）
    }
    BOTC_PmStore(g_teller, "【戏法师】" + BOTC_NameStr(seat) + " 公开猜测：爪牙=" + sm + "；恶魔=" + sd + "。");
    works = BOTC_AbilityWorks(seat, 149);
    if (!works) {
        BOTC_PmStore(g_teller, "【戏法师】" + BOTC_NameStr(seat) + " 中毒/醉酒或来源失效，本次不判胜。");
        return;
    }
    if (!BOTC_AlsaahirCorrect(p)) {
        BOTC_PmStore(g_teller, "【戏法师】猜测错误，游戏继续。");
        return;
    }
    BOTC_PmStore(g_teller, "【戏法师】全部爪牙和恶魔均已猜中 → 善良阵营获胜。");
    BOTC_ShowWin(0, "戏法师" + BOTC_NameStr(seat) + "准确指出了所有爪牙和恶魔。", "善良阵营立即获胜。");
}

void BOTC_AlsaahirCancel (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    g_alsaOpen[p] = false;
    DialogSetVisible(g_alsaDlg, PlayerGroupSingle(p), false);
    for (q = 0; q <= 13; q += 1) {
        g_alsaChoice[(p * 14) + q] = 0;
        if (q < 12) {
            g_alsaRowType[(p * 12) + q] = 0;
            libNtve_gf_SetDialogItemText(g_alsaSeatEdit[q], StringToText(""), PlayerGroupSingle(p));
        }
    }
}

// 【饕餮（154）】专用多选面板：12 名参与者均可选，也允许一个都不选。
// 【饕餮（154）】紧凑确认框：正常点击圆桌座位选择 0..12 名玩家，不再用十二行长按钮。
void BOTC_BuildTaotie () {
    DialogCreate(504, 220, c_anchorRight, 275, -70, false);
    g_taotieDlg = DialogLastCreated();
    if (g_taotieDlg > 0) { DialogSetVisible(g_taotieDlg, PlayerGroupAll(), false); }
    g_taotieTitle = BOTC_NewLabel(g_taotieDlg, 486, 30, 9, 7, StringToText("选择任意数量玩家（已选 0 人）"));
    libNtve_gf_SetDialogItemStyle(g_taotieTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_taotieTitle, false, PlayerGroupAll());
    g_taotieList = BOTC_NewList(g_taotieDlg, 486, 128, 9, 43);
    libNtve_gf_SetDialogItemStyle(g_taotieList, "ModLeftSize16Bold", PlayerGroupAll());
    g_taotieOk = BOTC_NewButton(g_taotieDlg, 180, 34, 40, 178, "确认选择");
    g_taotieCancel = BOTC_NewButton(g_taotieDlg, 180, 34, 284, 178, "一个也不选");
}

void BOTC_TaotieRender (int cp) {
    int i;
    int seat;
    text row;
    if (cp < 1 || cp > 13 || !g_taotieOpen[cp]) {
        return;
    }
    libNtve_gf_SetDialogItemText(g_taotieTitle, StringToText("选择任意数量玩家（已选 " + IntToString(g_taotieN[cp]) + " 人）"), PlayerGroupSingle(cp));
    DialogControlRemoveAllItems(g_taotieList, PlayerGroupSingle(cp));
    if (g_taotieN[cp] <= 0) {
        DialogControlAddItem(g_taotieList, PlayerGroupSingle(cp), StringToText("尚未选择任何玩家。"));
        return;
    }
    for (i = 0; i < g_taotieN[cp]; i += 1) {
        seat = g_taotieOrder[(cp * 12) + i];
        row = StringToText(IntToString(i + 1) + ". ") + BOTC_PlayerNameText(seat);
        DialogControlAddItem(g_taotieList, PlayerGroupSingle(cp), row);
    }
}

void BOTC_TaotieOpen (int p) {
    int i;
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    cp = g_who[p];
    if (cp < 1 || cp > 13) {
        return;
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(cp), false);
    g_skillPicking[p] = true;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    for (i = 0; i <= 13; i += 1) {
        g_taotiePick[(cp * 14) + i] = false;
    }
    for (i = 0; i < 12; i += 1) {
        g_taotieOrder[(cp * 12) + i] = 0;
    }
    g_taotieN[cp] = 0;
    g_taotieActor[cp] = p;
    g_taotieOpen[cp] = true;
    BOTC_TaotieRender(cp);
    if (g_taotieDlg > 0) { DialogSetVisible(g_taotieDlg, PlayerGroupSingle(cp), true); }
    BOTC_Notice(cp, "点圆桌上的玩家头像选择目标；再次点击取消。选完后按【确认选择】。");
}

void BOTC_TaotieToggle (int cp, int seat) {
    int i;
    int j;
    int n;
    if (cp < 1 || cp > 13 || seat < 2 || seat > 13 || !g_taotieOpen[cp]) {
        return;
    }
    if (!g_seatOn[seat]) {
        BOTC_Notice(cp, "这个座位没有玩家。");
        return;
    }
    n = g_taotieN[cp];
    if (g_taotiePick[(cp * 14) + seat]) {
        g_taotiePick[(cp * 14) + seat] = false;
        for (i = 0; i < n; i += 1) {
            if (g_taotieOrder[(cp * 12) + i] == seat) {
                for (j = i; j < n - 1; j += 1) {
                    g_taotieOrder[(cp * 12) + j] = g_taotieOrder[(cp * 12) + j + 1];
                }
                g_taotieOrder[(cp * 12) + n - 1] = 0;
                g_taotieN[cp] = n - 1;
                break;
            }
        }
    }
    else {
        g_taotiePick[(cp * 14) + seat] = true;
        if (n < 12) {
            g_taotieOrder[(cp * 12) + n] = seat;
            g_taotieN[cp] = n + 1;
        }
    }
    BOTC_TaotieRender(cp);
}

void BOTC_TaotieSubmit (int cp) {
    int i;
    int p;
    int q;
    int team;
    int n;
    bool duplicate;
    bool[6] seen;
    int[12] chosen;
    string picked;
    string typed;
    if (cp < 1 || cp > 13 || !g_taotieOpen[cp]) {
        return;
    }
    p = g_taotieActor[cp];
    if (p < 1 || p > 13) {
        g_taotieOpen[cp] = false;
        if (g_taotieDlg > 0) { DialogSetVisible(g_taotieDlg, PlayerGroupSingle(cp), false); }
        return;
    }
    n = g_taotieN[cp];
    for (i = 0; i < 12; i += 1) {
        chosen[i] = g_taotieOrder[(cp * 12) + i];
    }
    picked = "";
    for (i = 0; i < n; i += 1) {
        if (StringLength(picked) > 0) {
            picked = picked + ",";
        }
        picked = picked + BOTC_NameStr(chosen[i]);
    }
    g_taotieOpen[cp] = false;
    g_skillPicking[p] = false;
    if (g_taotieDlg > 0) { DialogSetVisible(g_taotieDlg, PlayerGroupSingle(cp), false); }
    if (n <= 0) {
        BOTC_PmInfo(cp, "【信息】你选择了不选择任何玩家。");
        BOTC_PmStore(g_teller, "【饕餮】" + BOTC_NameStr(p) + " 没有选择玩家，本夜无人死亡。");
        return;
    }
    BOTC_PmInfo(cp, "【信息】你选择了" + picked + "。");
    BOTC_PmStore(g_teller, "【饕餮】" + BOTC_NameStr(p) + " 选择了" + picked + "。");
    // 正常技能选择的联动：先按选择顺序触发莽夫，再触发被邪恶能力选中的悟道者。
    for (i = 0; i < n; i += 1) {
        BOTC_GoonTouch(p, chosen[i]);
    }
    for (i = 0; i < n; i += 1) {
        if (BOTC_WudTryTrigger(chosen[i], p)) {
            break;
        }
    }
    // 疯子以为自己是饕餮：照常完成一次选择，但不造成真实死亡。
    if (BOTC_IsLunatic(p)) {
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 48] = false;
        }
        for (i = 0; i < n; i += 1) {
            g_tokOn[(((g_teller * 14) + chosen[i]) * 256) + 48] = true;
        }
        if (BOTC_SkillWorks(p)) {
            BOTC_PmInfoDemons("【信息】疯子选择了" + picked + "。");
            BOTC_PmStore(g_teller, "【饕餮·疯子】已告诉恶魔：疯子选择了" + picked + "。");
        }
        else {
            BOTC_PmStore(g_teller, "【饕餮·疯子】" + BOTC_NameStr(p) + " 中毒/醉酒 → 本次选择不发送给恶魔。");
        }
        BOTC_GrimRender(g_teller);
        return;
    }    if (!BOTC_AbilityWorks(p, 154)) {
        BOTC_PmStore(g_teller, "【饕餮】" + BOTC_NameStr(p) + " 当前中毒、醉酒或失去能力 → 本次选择不造成死亡。");
        return;
    }
    for (i = 0; i < 6; i += 1) {
        seen[i] = false;
    }
    duplicate = false;
    typed = "";
    for (i = 0; i < n; i += 1) {
        q = chosen[i];
        team = BOTC_RoleTeam(BOTC_SeatTrueRole(q));
        if (team >= 0 && team <= 5) {
            if (seen[team]) {
                duplicate = true;
            }
            seen[team] = true;
            if (StringLength(typed) > 0) {
                typed = typed + ",";
            }
            typed = typed + BOTC_NameStr(q) + "=" + BOTC_TeamName(team);
        }
    }
    BOTC_PmStore(g_teller, "【饕餮】角色类型检查：" + typed + "。");
    if (duplicate) {
        BOTC_PmStore(g_teller, "【饕餮】所选目标存在重复角色类型 → 本夜无人死亡。");
        return;
    }
    BOTC_PmStore(g_teller, "【饕餮】所有目标角色类型均不相同 → 放置「死亡（饕餮）」并进入正常死亡结算。");
    for (i = 0; i < n; i += 1) {
        if (g_gameOver) {
            break;
        }
        BOTC_DemonStrike(p, 154, chosen[i], false);
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_TaotieNone (int cp) {
    int i;
    if (cp < 1 || cp > 13 || !g_taotieOpen[cp]) {
        return;
    }
    for (i = 0; i <= 13; i += 1) {
        g_taotiePick[(cp * 14) + i] = false;
    }
    for (i = 0; i < 12; i += 1) {
        g_taotieOrder[(cp * 12) + i] = 0;
    }
    g_taotieN[cp] = 0;
    BOTC_TaotieSubmit(cp);
}

void BOTC_TaotieClear () {
    int i;
    int j;
    int taotieOwner;
    for (i = 0; i <= 13; i += 1) {
        taotieOwner = g_taotieActor[i];
        if (g_taotieOpen[i] && taotieOwner >= 1 && taotieOwner <= 13) {
            g_skillPicking[taotieOwner] = false;
        }
        g_taotieOpen[i] = false;
        g_taotieActor[i] = 0;
        g_taotieN[i] = 0;
        for (j = 0; j <= 13; j += 1) {
            g_taotiePick[(i * 14) + j] = false;
        }
        for (j = 0; j < 12; j += 1) {
            g_taotieOrder[(i * 12) + j] = 0;
        }
    }
    if (g_taotieDlg > 0) { DialogSetVisible(g_taotieDlg, PlayerGroupAll(), false); }
}
void BOTC_GossipSubmit (int p) {
    string msg;
    if (p < 1 || p > 13) {
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_gossipEdit, p);
    if (StringLength(msg) <= 0) {
        BOTC_Notice(p, "输入框是空的：先写下内容，再点【确定】。");
        return;
    }
    // 【声明长度限制】（用户 2026-11-03）：避免有人借造谣者声明夹带只有少数人看得懂的暗号。
    //   最多约 40 个汉字（120 字节）；超长直接退回去让他缩短，不静默截断（截断可能切在半个汉字上）。
    if (StringLength(msg) > 120) {
        BOTC_Notice(p, "声明太长：最多约 40 个汉字（120 字节），请缩短后再点【确定】。");
        return;
    }
    DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
    g_gossipText = msg;
    g_gossipBy = BOTC_PosOf(p);
    g_gossipTextBy[BOTC_PosOf(p)] = msg;
    g_gossipDone[BOTC_PosOf(p)] = true;
    g_gossipDay[BOTC_PosOf(p)] = g_dayNum;
    // 【公聊换行】（用户 2026-11-03）：文字较长时按标点断成多行，避免固定行高裁成省略号。
    BOTC_PubAnnounceWrap("【造谣者】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开声明：", msg);
    BOTC_DeclareCdSet(p);
    BOTC_PmStore(g_teller, "【造谣者】" + BOTC_NameStr(BOTC_PosOf(p)) + " 公开声明：" + msg);
    if (BOTC_AbilityWorks(BOTC_PosOf(p), 28)) {
        BOTC_PmStore(g_teller, "【造谣者】这条声明只算今晚：如果它是真的，今晚一名玩家死亡。");
    }
}

// ■【真人说书 · 信息位答题框】（用户 2026-09-20）：共情者（4）/ 厨师（3）/ 占卜师（5）
//   真人说书时这三位的答案由说书人在小窗里填一个数字；点【确定】之后，这句话自动私聊发给
//   「以为自己是那个角色」的玩家（酒鬼、认知覆盖也照发，因为发的是他眼前那个身份）。
void BOTC_BuildExperimentalRoles () {
    // 说书人获得瘟疫医生的能力后，在魔典左侧出现这个入口。
    g_pdBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 176, "说书人能力");
    DialogControlSetVisible(g_pdBtn, PlayerGroupAll(), false);

    DialogCreate(560, 180, c_anchorRight, 320, -70, false);
    g_organDlg = DialogLastCreated();
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    g_organTitle = BOTC_NewLabelC(g_organDlg, 530, 42, 15, 12, StringToText("是否发动技能？"));
    libNtve_gf_SetDialogItemStyle(g_organTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_organTitle, false, PlayerGroupAll());
    g_organYes = BOTC_NewButton(g_organDlg, 220, 52, 35, 85, "是");
    g_organNo = BOTC_NewButton(g_organDlg, 220, 52, 295, 85, "否");
    DialogControlSetVisible(g_organYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organNo, PlayerGroupAll(), false);

    // 炼金术士声称第一步：先明确要猜间谍还是寡妇。
    DialogCreate(560, 180, c_anchorRight, 320, -70, false);
    g_alcDlg = DialogLastCreated();
    DialogSetVisible(g_alcDlg, PlayerGroupAll(), false);
    g_alcTitle = BOTC_NewLabelC(g_alcDlg, 530, 42, 15, 12, StringToText("炼金术士：猜哪一名爪牙？"));
    libNtve_gf_SetDialogItemStyle(g_alcTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_alcTitle, false, PlayerGroupAll());
    g_alcSpyBtn = BOTC_NewButton(g_alcDlg, 150, 52, 35, 85, "猜间谍");
    g_alcWidowBtn = BOTC_NewButton(g_alcDlg, 150, 52, 205, 85, "猜寡妇");
    g_alcCancelBtn = BOTC_NewButton(g_alcDlg, 150, 52, 375, 85, "取消");
    DialogControlSetVisible(g_alcSpyBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_alcWidowBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_alcCancelBtn, PlayerGroupAll(), false);

}

