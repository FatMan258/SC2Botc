    g_tipRoleN[117] = 23;
    g_tipAbility[117] = StringToText("每个白天，如果你「疯狂」地证明自己是一个善良角色（与之前不同），你可能会在当晚获得那个角色的能力，直到下个黄昏。");
    // 【华灯初上/山雨欲来】悟道者：按钟楼百科原文重建详情
    g_tipLine[6780] = StringToText("【角色能力】");
    g_tipLine[6781] = StringToText("你以为你是一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，但你实际上不是。如果有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了你，你会立即变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[6782] = StringToText("【角色简介】");
    g_tipLine[6783] = TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("误以为自己置身事外，然而当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("睥睨时，他才终于醒悟：没有任何人可以置身事外。");
    g_tipLine[6784] = StringToText("· 在游戏设置时，如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("作为出场角色，则将") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("角色标记移除，并增加一个未出场的任意") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，然后再让玩家随机抽取角色。");
    g_tipLine[6785] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("不具有自己以为的那个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的角色能力。");
    g_tipLine[6786] = StringToText("· 当") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响时，在相关的效果生效前，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会先改变角色，变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6787] = StringToText("· 如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化发生在白天，那么说书人会在当晚所有玩家闭眼后，第一时间唤醒") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("并告知他相关的角色变化。");
    g_tipLine[6788] = StringToText("· 在") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化后，如果他随即受到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的此次能力效果影响，使得他再次变化角色，那么说书人只会告知他最终的变化结果。");
    g_tipLine[6789] = StringToText("【规则细节】");
    g_tipLine[6790] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力需要让他认为自己是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，因此") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("无法认为自己是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("，因为这两个角色不会作为角色标记发给玩家。（即使") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的规则允许让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("角色标记，那也仅代表玩家在作为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记，而非在作为") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记。）");
    g_tipLine[6791] = StringToText("· 特定角色互动：");
    g_tipLine[6792] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为邻座，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会直接") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，不会发生角色变化。如果在游戏过程中有玩家变成了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("且") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为与他邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会正常发生角色变化。");
    g_tipLine[6793] = StringToText("· 相克规则：");
    g_tipLine[6794] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("产生了错误信息或「能力未正常生效」。");
    g_tipLine[6795] = StringToText("· ") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("可以变成新的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。如果因此使得") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量超过1人，会有一名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6796] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("无法拥有") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipRoleAt[118] = 7902;
    g_tipRoleN[118] = 27;
    g_tipAbility[118] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，你会立即变成一个不在场的镇民角色。");
    // 【华灯初上/山雨欲来】逆臣：按钟楼百科原文重建详情
    g_tipLine[6797] = StringToText("【角色能力】");
    g_tipLine[6798] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("；如果你先死于处决，他会在当晚转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[6799] = StringToText("【角色简介】");
    g_tipLine[6800] = TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("与一名其他玩家势不两立。");
    g_tipLine[6801] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("需要选择一名其他玩家。") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("和这名玩家之间，谁先死于处决，另一名玩家就会在当晚转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[6802] = StringToText("· 两名玩家之间任何一方以其他方式死亡，不会使得另一方转为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。然而，即使") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("选择的玩家因为其他原因已经死亡，") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("死于处决也会导致他的阵营变化。");
    g_tipLine[6803] = StringToText("· 如果") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("因为其他原因死亡，他的能力会失效。因此如果他的能力还未导致玩家转变阵营，即使在此之后他选择的玩家死于处决，也不会使得") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("转变阵营。");
    g_tipLine[6804] = StringToText("· 如果") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("选择的是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，他不会因为") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("死于处决而转为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。同理，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("逆臣"), Color(0, 191, 255)) + StringToText("也不会因为他的目标死于处决而转为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。");
    g_tipLine[6805] = StringToText("【规则细节】");
    g_tipLine[6806] = StringToText("无");
    g_tipRoleAt[119] = 6797;
    g_tipRoleN[119] = 10;
    g_tipAbility[119] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为邪恶；如果你先死于处决，他会在当晚转变为邪恶。");
    // 【华灯初上/山雨欲来】混沌：按钟楼百科原文重建详情
    g_tipLine[6807] = StringToText("【角色能力】");
    g_tipLine[6808] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家，除") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("外的所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("直到下个黄昏。");
    g_tipLine[6809] = StringToText("【角色简介】");
    g_tipLine[6810] = TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("伺机而动，能够让") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家集体") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6811] = StringToText("· 当") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的攻击杀死一名玩家时，如果该玩家的角色是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，并且是与") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("最邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家，") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果就会被触发，并持续到下个黄昏时。");
    g_tipLine[6812] = StringToText("· 即使杀死的是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，只要该玩家是") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("最邻近的两名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家之一，") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果就会被触发。");
    g_tipLine[6813] = StringToText("· 如果") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("杀死的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("会使得「死亡时触发的能力」被触发，那么") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果会在这些能力结算完毕后再触发。");
    g_tipLine[6814] = StringToText("· 如果") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("杀死") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("后导致游戏结束，那么") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果不会触发。");
    g_tipLine[6815] = StringToText("· 攻击已经死亡的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，或攻击但没有导致") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("的死亡，不会触发") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果。");
    g_tipLine[6816] = StringToText("· 在") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果的生效期间，只要玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营（") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("除外），就会受到") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果的影响，包括") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6817] = StringToText("· 在") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果的生效期间，如果玩家转变为了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营，就会立即") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。反之，如果玩家转变为了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，就会立即解除") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果对他的影响。");
    g_tipRoleAt[121] = 6807;
    g_tipRoleN[121] = 11;
    g_tipAbility[121] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    // 【华灯初上/山雨欲来】道士：按钟楼百科原文重建详情
    g_tipLine[6818] = StringToText("【角色能力】");
    g_tipLine[6819] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，你死亡，然后他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到下个黎明。");
    g_tipLine[6820] = StringToText("【角色简介】");
    g_tipLine[6821] = TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会不断地寻找") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，令其短暂失去能力，并以自身死亡作为代价。");
    g_tipLine[6822] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，如果那名玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("依然存活。当选中一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家时，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("死亡，然后那名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家在当晚") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6823] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("只会维持到天亮前，天亮后") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家不再") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6824] = StringToText("· 如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("的死亡由于某些原因被阻止，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家当晚不会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6825] = StringToText("【规则细节】");
    g_tipLine[6826] = StringToText("· 特定角色互动：");
    g_tipLine[6827] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了照顾") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的玩家，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会死亡，该玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的能力不会受到任何影响。");
    g_tipRoleAt[123] = 7929;
    g_tipRoleN[123] = 12;
    g_tipAbility[123] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    // 【华灯初上/山雨欲来】鸩：按钟楼百科原文重建详情
    g_tipLine[6828] = StringToText("【角色能力】");
    g_tipLine[6829] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：如果他在场，他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6830] = StringToText("【角色简介】");
    g_tipLine[6831] = StringToText("鸩可以冒着某个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("死亡的风险来确认该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("是否在场。");
    g_tipLine[6832] = StringToText("· 每局游戏限一次，除首个夜晚以外的其他夜晚，鸩可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，如果那个角色在场，该角色对应的玩家会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6833] = StringToText("· 如果鸩选择了一个不在场的角色，不会有任何玩家受到鸩的影响，即使之后被选择的角色在场了，他也不会受到鸩的影响。");
    g_tipLine[6834] = StringToText("· 如果某个角色有多名玩家在场，且鸩选择了这个角色，只会有一名玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6835] = StringToText("【规则细节】");
    g_tipLine[6836] = StringToText("· 如果鸩选择了自己，他会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("但不会死亡。因为鸩先让自己") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("失去了能力，所以通常情况下鸩不会死于自己的能力。（特殊情况下，鸩可以死于自己的能力，比如咖啡师的效果1对鸩生效。）");
    g_tipLine[6837] = StringToText("· 相克规则：");
    g_tipLine[6838] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("不会因为鸩的能力") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6839] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6840] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipRoleAt[124] = 7941;
    g_tipRoleN[124] = 17;
    g_tipAbility[124] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他中毒并死亡。");
    // 【华灯初上/山雨欲来】赶尸人：按钟楼百科原文重建详情
    g_tipLine[6841] = StringToText("【角色能力】");
    g_tipLine[6842] = StringToText("与你邻近的两名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家会在其首次死亡时被当作仍然存活。[-1") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[6843] = StringToText("【角色简介】");
    g_tipLine[6844] = TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("能将相邻的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("变成活尸，让人们误以为他们还存活。");
    g_tipLine[6845] = StringToText("· 在设置阶段，如果") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("在场，则用一个未出场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色标记替换一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("标记，然后再让玩家随机抽取角色。");
    g_tipLine[6846] = StringToText("· 与") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("在首次死亡时，会进入「活尸」状态。与穷奇的能力相似，该玩家在城镇广场上会表现出「存活」，然而实际上已经死亡。在这种情况下再次死亡，玩家在城镇广场上的状态也就会变成死亡状态。");
    g_tipLine[6847] = StringToText("· 只有能够死亡的玩家才能因为") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的能力而进入「活尸」状态。如果玩家的死亡由于某些原因被阻止，他就不会进入「活尸」状态，而是正常存活（也不会因此算作他的「首次死亡」，") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的能力能在他真正死亡的时候如常触发）。");
    g_tipLine[6848] = StringToText("· 「活尸」状态下的玩家死亡时，相关的「死亡时触发的能力」不会触发，因为玩家在此之前已经进入了死亡状态（且之前进入死亡状态时，自身被当作存活而没有触发「死亡时触发的能力」）。而「得知自己死亡」的能力会正常触发，因为这些能力会持续保留到玩家「得知自己死亡」时。");
    g_tipLine[6849] = StringToText("· 「活尸」状态与") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("相似：玩家会失去自身的能力，如果玩家的能力会让他自己获得信息，则有可能获得错误信息。");
    g_tipLine[6850] = StringToText("· 「活尸」状态是一次性变化。即使之后") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或是死亡，又或者是「活尸」玩家的角色发生了变化且不再是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，「活尸」玩家在城镇广场上的状态依旧不会发生变化。但此时「活尸」玩家在参与能力互动时，不再被当作存活状态，而是处于死亡状态。");
    g_tipLine[6851] = StringToText("· 如果已经进入「活尸」状态的玩家变成了非") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("所能影响的玩家也会发生变化。此时会计算分别与他顺时针和逆时针两个方向上最近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家，") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的能力会对这些玩家生效。");
    g_tipLine[6852] = StringToText("【规则细节】");
    g_tipLine[6853] = StringToText("· 如果玩家因为某些效果「不会死亡」，如") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("的效果，则在他将要死亡时，不会受到") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的效果影响。同样的，也不会因此被算作「首次死亡」。");
    g_tipLine[6854] = StringToText("· 特定角色互动：");
    g_tipLine[6855] = StringToText("· 守鸦人/") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("：「活尸」状态的守鸦人在夜晚转为死亡状态时，同样会被说书人唤醒并假装触发他的能力。这是因为守鸦人在玩家自身看来是在夜晚死亡的，满足守鸦人的能力的触发条件。如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("导致了") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("从活尸转为死亡状态，同样也会触发") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("的唤醒。然而因为他们实际已经死亡，说书人可以提供错误信息。");
    g_tipLine[6856] = StringToText("· ") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("：与") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("相邻，且未触发能力的") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("在首次死亡时，会触发") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("的能力，从而使得") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会死亡。在") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("再次死亡时，会正常受到") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的能力影响，进入「活尸」状态。");
    g_tipLine[6857] = StringToText("· 相克规则：");
    g_tipLine[6858] = StringToText("· ") + TextWithColor(StringToText("瘟疫医生"), Color(0, 191, 255)) + StringToText("：如果说书人本应获得") + TextWithColor(StringToText("赶尸人"), Color(0, 191, 255)) + StringToText("的能力，改为一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家获得此能力，且他会得知此事。");
    g_tipRoleAt[126] = 6841;
    g_tipRoleN[126] = 18;
    g_tipAbility[126] = StringToText("与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1外来者]");
    // 【华灯初上/山雨欲来】熊孩子：按钟楼百科原文重建详情
    g_tipLine[6859] = StringToText("【角色能力】");
    g_tipLine[6860] = StringToText("每个夜晚，你要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[6861] = StringToText("【角色简介】");
    g_tipLine[6862] = TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("顽皮捣蛋，会让特定的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色产生错误信息。");
    g_tipLine[6863] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("需要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。如果这个角色在场，对应玩家会被") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响，在下个黄昏之前均会产生错误信息。");
    g_tipLine[6864] = StringToText("· 受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力影响的玩家如果") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，仍然不会让其他玩家获得信息，因为他已经失去能力。然而他在获得因自己的能力而得知的信息时，也会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响而必定获得错误信息。");
    g_tipLine[6865] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("不会影响这名玩家通过其他方式获得的信息，例如说书人的规则解释，他自身的角色/阵营，或是由其他玩家的能力使他得知的信息。");
    g_tipLine[6866] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响的是具体角色所对应的玩家。仅仅是拥有这个角色能力，但实际角色并非") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色的玩家，不会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力的影响。");
    g_tipLine[6867] = StringToText("· 如果") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色当前不在场，但随后在场了，这个角色所对应的玩家仍然要受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipRoleAt[151] = 7336;
    g_tipRoleN[151] = 18;
    g_tipAbility[151] = StringToText("每个夜晚，你要选择一个镇民角色：他的能力会产生错误信息，直到下个黄昏。");
    // 【华灯初上/山雨欲来】书生：按钟楼百科原文重建详情
    g_tipLine[6868] = StringToText("【角色能力】");
    g_tipLine[6869] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("知道") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场。每局游戏限一次，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以拜访说书人并猜测你是") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("。如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("猜测正确，即使你已死亡，当晚该") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以选择一名玩家：他死亡。");
    g_tipLine[6870] = StringToText("【角色简介】");
    g_tipLine[6871] = TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("需要避免被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("发现。");
    g_tipLine[6872] = StringToText("· ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会在自己的首个夜晚得知") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场。");
    g_tipLine[6873] = StringToText("· 如果") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，或有任何玩家获得了") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力，尚未得知「") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场」的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会在当晚得知") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场。");
    g_tipLine[6874] = StringToText("· 只要") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("得知过") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场，便能在白天拜访说书人并进行猜测。在这种情况即使") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("已经死亡，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也能进行猜测，并在猜测正确时触发") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力效果。");
    g_tipLine[6875] = StringToText("· 如果一名已死亡的玩家变成了") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会因此得知") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("在场，也无法进行猜测或触发") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力效果。");
    g_tipLine[6876] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("猜测正确，做出正确猜测的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("便能在当晚自己的行动结束后，额外导致一名玩家死亡。这一选择的时机最晚不能超过夜晚的「信息类角色行动开始」时机，详情参考夜晚行动顺序一览。");
    g_tipLine[6877] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("猜测正确，即使该") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("随后被变成了非") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色，依然能够使用") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力造成死亡。");
    g_tipLine[6878] = StringToText("· ") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力导致的死亡，不算作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的攻击。那名玩家是由") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("的能力导致的死亡，因此如果以这种方式杀死了一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("亡骨魔"), Color(0, 191, 255)) + StringToText("无法使得那名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("保留能力。如果执行") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("能力的玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，那么仍然算作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力。");
    g_tipLine[6879] = StringToText("· 如果场上有多名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家，这些玩家共享一次猜测机会。任何") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("使用了这次机会后，其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家的猜测都不会触发任何效果。他们不会知道自己的猜测是否正确，也不会知道是否有其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家在他之前进行了猜测并耗用了猜测的机会。");
    g_tipLine[6880] = StringToText("· 如果场上有多名") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("或具有") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("能力的角色，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也只会有一次猜测机会。");
    g_tipLine[6881] = StringToText("【规则细节】");
    g_tipLine[6882] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6883] = StringToText("· 戏子（改）：") + TextWithColor(StringToText("书生"), Color(0, 191, 255)) + StringToText("不会因为戏子（改）的能力") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipRoleAt[152] = 6868;
    g_tipRoleN[152] = 16;
    g_tipAbility[152] = StringToText("恶魔知道书生在场。每局游戏限一次，恶魔可以拜访说书人并猜测你是书生。如果恶魔猜测正确，即使你已死亡，当晚该恶魔可以选择一名玩家：他死亡。");
    // 【华灯初上/山雨欲来】狐媚娘：按钟楼百科原文重建详情
    g_tipLine[6884] = StringToText("【角色能力】");
    g_tipLine[6885] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("在场。如果你死于处决，当晚他转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[6886] = StringToText("【角色简介】");
    g_tipLine[6887] = TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("会魅惑她中意的玩家使其加入") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营……以自身死亡为代价。");
    g_tipLine[6888] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，该玩家会知道") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("在场。");
    g_tipLine[6889] = StringToText("· 即使") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("在选择玩家的时候") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，一旦") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("恢复清醒健康，她选择的玩家也会立即知道") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("在场。（这个行为会发生在夜晚阶段，并且需要尽可能快地结算。）");
    g_tipLine[6890] = StringToText("· 如果") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("死于处决（不论是因为常规的处决或是角色能力造成的处决），当晚，被") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("选择的玩家会转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[6891] = StringToText("· 如果") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("选择的玩家在") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("死于处决时已经是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，则无事发生。");
    g_tipLine[6892] = StringToText("【规则细节】");
    g_tipLine[6893] = StringToText("· 相克规则：");
    g_tipLine[6894] = StringToText("· ") + TextWithColor(StringToText("异端分子"), Color(0, 191, 255)) + StringToText("：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[6895] = StringToText("· ") + TextWithColor(StringToText("瘟疫医生"), Color(0, 191, 255)) + StringToText("：如果说书人本应获得") + TextWithColor(StringToText("狐媚娘"), Color(0, 191, 255)) + StringToText("的能力，改为一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家获得此能力，且他会得知此事。");
    g_tipRoleAt[153] = 6884;
    g_tipRoleN[153] = 12;
    g_tipAbility[153] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道狐媚娘在场。如果你死于处决，当晚他转变为邪恶阵营。");
    // 【华灯初上/山雨欲来】饕餮：按钟楼百科原文重建详情
    g_tipLine[6896] = StringToText("【角色能力】");
    g_tipLine[6897] = StringToText("每个夜晚*，你要选择任意数量的非") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("玩家或一名") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("玩家：如果他们的角色类型均不相同，他们死亡。[+1") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[6898] = StringToText("【角色简介】");
    g_tipLine[6899] = TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("食量惊人，有的时候它会在夜里大肆杀戮来满足自己无尽的饥饿。");
    g_tipLine[6900] = StringToText("· ") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("每个夜晚可以选择任意数量的非") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("玩家。如果这些玩家之中没有任何两名玩家有相同的角色类型，那么这些玩家都会死亡。");
    g_tipLine[6901] = StringToText("· ") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("可以不进行选择，这也视作选择了任意数量的玩家。");
    g_tipLine[6902] = StringToText("· ") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("与其他非") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("不属于同一角色类型。但是他们是无辜的！如果") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("选择攻击一名") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("，那么他当晚就不能再攻击其他玩家了。");
    g_tipLine[6903] = StringToText("· 在设置阶段，如果") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("在场，则用一个未出场的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色标记替换一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("标记，然后再让玩家随机抽取角色。");
    g_tipLine[6904] = StringToText("【规则细节】");
    g_tipLine[6905] = StringToText("· 被") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("攻击而死亡的玩家，其死亡顺序依照") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("的选择顺序进行。如果") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("导致了多名玩家死亡，且其中一名玩家的能力使得") + TextWithColor(StringToText("饕餮"), Color(0, 191, 255)) + StringToText("在死亡结算中途") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("（比如") + TextWithColor(StringToText("心上人"), Color(0, 191, 255)) + StringToText("），那么后续的其他玩家就不会再死亡。（但这种情况极为少见，此处仅做举例说明，不意味着鼓励说书人这么做）");
    g_tipRoleAt[154] = 6896;
    g_tipRoleN[154] = 10;
    g_tipAbility[154] = StringToText("每个夜晚*，你要选择任意数量的非旅行者玩家或一名旅行者玩家：如果他们的角色类型均不相同，他们死亡。[+1外来者]");
    // 【华灯初上/山雨欲来】画皮：按钟楼百科原文重建详情
    g_tipLine[6906] = StringToText("【角色能力】");
    g_tipLine[6907] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。");
    g_tipLine[6908] = StringToText("当他下一次即将死亡时，他重生，随后你重获能力。");
    g_tipLine[6909] = StringToText("【角色简介】");
    g_tipLine[6910] = TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("迅速并秘密地进行攻击，神不知鬼不觉，时刻觊觎着下一个目标。");
    g_tipLine[6911] = StringToText("· ") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("在首个夜晚就会攻击一名玩家，但天亮后所有玩家都不会知道这件事，除了") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipLine[6912] = StringToText("· ") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("的攻击会让玩家进入「活尸」状态，该玩家在城镇广场上会表现出「存活」，然而实际上已经死亡。");
    g_tipLine[6913] = StringToText("· 因") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("能力而进入「活尸」状态下的玩家下一次即将死亡时，") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("会阻止这次死亡，并将他复活。") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("会重获能力，在当晚进行下一次秘密的攻击。");
    g_tipLine[6914] = StringToText("· 只有能够被") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("杀死的玩家才能因为") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("的攻击而进入「活尸」状态。如果玩家的死亡由于某些原因被阻止，他就不会进入「活尸」状态，而是正常存活。");
    g_tipLine[6915] = StringToText("· 如果被") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("选择的玩家因为任何原因仍然存活，当那名玩家下一次即将死亡时，") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("也能阻止这次死亡并试图复活那名玩家（尽管复活存活的玩家会导致无事发生），随后重获能力。");
    g_tipLine[6916] = StringToText("【规则细节】");
    g_tipLine[6917] = StringToText("· 「活尸」状态下的玩家下一次即将死亡时，如果") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("由于任何原因无法阻止这次死亡，那么") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("无法将他复活，也不会重获能力。通常情况下，这意味着") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("在接下来的游戏中将会毫无作用。");
    g_tipLine[6918] = StringToText("· 如果一名玩家在「活尸」状态已经使用过「每局游戏限一次」的能力，或者已经使用过「每局游戏限一次」的能力之后再进入「活尸」状态，即使") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("将他复活，该玩家也无法再次使用「每局游戏限一次」的能力。");
    g_tipLine[6919] = StringToText("· 特定角色互动：");
    g_tipLine[6920] = StringToText("· ") + TextWithColor(StringToText("红唇女郎"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("画皮"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，通常情况下，游戏会因为场上没有存活") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("而立即结束。即使场上有") + TextWithColor(StringToText("红唇女郎"), Color(0, 191, 255)) + StringToText("，也会把") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当作存活玩家从而不触发") + TextWithColor(StringToText("红唇女郎"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipRoleAt[155] = 6906;
    g_tipRoleN[155] = 15;
    g_tipAbility[155] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。 当他下一次即将死亡时，他重生，随后你重获能力。");
    // 【华灯初上/山雨欲来】引路人：按钟楼百科原文重建详情
    g_tipLine[6921] = StringToText("【角色能力】");
    g_tipLine[6922] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了他们之中的玩家。");
    g_tipLine[6923] = StringToText("【角色简介】");
    g_tipLine[6924] = TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("能够得知夜晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("作祟，侵扰玩家。");
    g_tipLine[6925] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("都可以选择一至三名玩家，但不能不进行选择，也不能选择自己。");
    g_tipLine[6926] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中没有在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知「否」。");
    g_tipLine[6927] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知「是」。如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择了超过一名玩家，他不会得知是具体哪名玩家被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响了。");
    g_tipLine[6928] = StringToText("· 不仅") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("、") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("能力会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("能力也会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[6929] = StringToText("【规则细节】");
    g_tipLine[6930] = StringToText("「影响」的范围包括：改变该玩家的状态（角色、阵营等），对该玩家的能力造成了妨害效果（互动干扰、能力效果干扰、阻止能力生效等），等等。暴露角色、让他人获取信息等能力不在「影响」的范围内。");
    g_tipLine[6931] = StringToText("与「保护」类似，如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家执行了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的能力产生选择或影响，同样会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[6932] = StringToText("· 特定角色互动：");
    g_tipLine[6933] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家照顾了") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("，当晚因") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("能力死亡的玩家算作被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力影响了。");
    g_tipLine[6934] = StringToText("· 相克规则：");
    g_tipLine[6935] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[6936] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否被影响，即使他是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipRoleAt[156] = 7958;
    g_tipRoleN[156] = 19;
    g_tipAbility[156] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有邪恶玩家的能力选择或影响了他们之中的玩家。");
    // 【华灯初上/山雨欲来】使节：按钟楼百科原文重建详情
    g_tipLine[6937] = StringToText("【角色能力】");
    g_tipLine[6938] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家时会改为选中你，即使你已死亡。");
    g_tipLine[6939] = StringToText("【角色简介】");
    g_tipLine[6940] = TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("远离家乡来到陌生的地方，因此容易成为他人欺凌的对象。");
    g_tipLine[6941] = StringToText("· 在每个夜晚，") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力能够触发最多一次。") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力可以连续在多个夜晚都触发，也可能会连续几个夜晚都不触发。由说书人来决定") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力触发与否。");
    g_tipLine[6942] = StringToText("· 只要有玩家在使用自身能力选择了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，且") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力当晚还未触发，说书人就可以决定触发") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力让该玩家的选择目标改为") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6943] = StringToText("· 如果") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的能力在当晚已经被触发过一次了，那么之后有其他玩家使用能力进行选择时，就无法再被") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("影响。");
    g_tipLine[6944] = StringToText("【规则细节】");
    g_tipLine[6945] = StringToText("· 相克规则：");
    g_tipLine[6946] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipRoleAt[157] = 6937;
    g_tipRoleN[157] = 10;
    g_tipAbility[157] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择邪恶玩家时会改为选中你，即使你已死亡。");
    // 【华灯初上/山雨欲来】半仙：按钟楼百科原文重建详情
    g_tipLine[6947] = StringToText("【角色能力】");
    g_tipLine[6948] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为替代。");
    g_tipLine[6949] = StringToText("【角色简介】");
    g_tipLine[6950] = TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("精通各种怪力乱神之术，能够将对他潜在的威胁转移到邪祟之人的身上。");
    g_tipLine[6951] = StringToText("· 在夜晚时，任何使用自身能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家，在其能力生效前，选择的目标会暗中转移到一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的身上。随后，这项能力效果会以那名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为新的目标来进行结算。");
    g_tipLine[6952] = StringToText("· 使用能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家不会得知自己的选择目标被更改，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力被触发。");
    g_tipLine[6953] = StringToText("· 只有需要做出选择的能力才能被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[6954] = StringToText("· 在一项能力更换目标后，无需重新进行选择限制条件的判断。") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("的选择目标可能会因此改为已经死亡的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("的选择目标可能会改为选中自己。");
    g_tipLine[6955] = StringToText("· 在一项能力更换目标后，需要重新进行能力效果中触发条件的判断。") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("因为") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("而改为选中") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时，不会让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("失去能力，因为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("是不同的角色类型。");
    g_tipLine[6956] = StringToText("· 一项能力在更换选择目标后，能力自身与选择相关的内容不会因此发生变更，依然以玩家自身做出的选择作为判断基准。") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("在选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("后导致目标转移，他在第二晚无法选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，而不是无法选择转移后的目标。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在选择主人时目标被变更，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在下个白天投票时仍然需要参考他昨晚选择的那名玩家的投票意见，不会受到影响。");
    g_tipLine[6957] = StringToText("· 如果一项能力需要玩家选择多个目标，而") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("成为了目标之一，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("只会将自己更改为一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，不会使得玩家的其他目标发生变化。") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会让一项能力的多个目标中重复选择同一名玩家。如果此时没有其他合法的目标可以转移选择，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("仍然会受到原本能力效果的影响。");
    g_tipLine[6958] = StringToText("· 一项能力中的某个选择目标至多只能被转移一次。也就是说，被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后的目标，无法受到") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的影响使得目标再次转移。");
    g_tipLine[6959] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚被触发。在白天时，他的能力不会产生任何效果。");
    g_tipLine[6960] = StringToText("【规则细节】");
    g_tipLine[6961] = StringToText("· 特定角色互动：");
    g_tipLine[6962] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会直接死亡，并且不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家身上。");
    g_tipLine[6963] = StringToText("· ") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，是否播报能力取决于") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移结果的玩家是否与") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("之前的选择发生了变化。被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后，") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("的能力只会对转移后的目标生效（从某种意义上来说，也算是无效了，因为") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("的能力此时只能让") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营落败）。") + TextWithColor(StringToText("恐惧之灵"), Color(0, 191, 255)) + StringToText("需要通过播报与否来判断自己是否选中了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6964] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("为邻座，且有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，在") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力生效前，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会先将选择目标转移，从而使得") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家既不会选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("为目标，也不会影响") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，因此不会触发") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力。反之，如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("将") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的选择转移到与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力就会因此被触发。");
    g_tipLine[6965] = StringToText("· 相克规则：");
    g_tipLine[6966] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipLine[6967] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6968] = StringToText("· 鸩：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipRoleAt[158] = 7977;
    g_tipRoleN[158] = 37;
    g_tipAbility[158] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名邪恶玩家作为替代。");
    // 【华灯初上/山雨欲来】掮客：按钟楼百科原文重建详情
    g_tipLine[6969] = StringToText("【角色能力】");
    g_tipLine[6970] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    g_tipLine[6971] = StringToText("【角色简介】");
    g_tipLine[6972] = TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("促成两名阵营相同的玩家的合作，使得其他玩家的选择被转换。");
    g_tipLine[6973] = StringToText("· 在夜晚时，") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家如果阵营相同，任何玩家使用自身能力选择他们之一时，在其能力生效前，选择的目标会转移到另一名玩家的身上。随后，这项能力效果会以另一名玩家作为新的目标来结算。");
    g_tipLine[6974] = StringToText("· 如果") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家阵营不相同，那么，任何玩家使用自身能力选择他们之一作为目标时，不会发生转移。");
    g_tipLine[6975] = StringToText("· 使用能力被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标的玩家不会得知自己的选择目标被更换。") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("也不会得知是否有玩家因此被转移了选择的目标。");
    g_tipLine[6976] = StringToText("· 只有需要玩家做出选择的能力才能被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[6977] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚生效。在白天时，他的能力不会产生任何效果。");
    g_tipLine[6978] = StringToText("【规则细节】");
    g_tipLine[6979] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会持续检测被选择的玩家的阵营，一旦他们当中出现了阵营变化导致这两名玩家阵营不同，") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会立即失去对这两名玩家更换选择目标的能力。");
    g_tipLine[6980] = StringToText("· 更多规则与细节详情请查看更换选择目标。");
    g_tipLine[6981] = StringToText("· 特定角色互动：");
    g_tipLine[6982] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的玩家，那名玩家会直接死亡，并不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到另一名玩家身上。");
    g_tipLine[6983] = StringToText("· 相克规则：");
    g_tipLine[6984] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(0, 191, 255)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipRoleAt[159] = 8014;
    g_tipRoleN[159] = 23;
    g_tipAbility[159] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    // 【华灯初上/山雨欲来】酒保：按钟楼百科原文重建详情
    g_tipLine[6985] = StringToText("【角色能力】");
    g_tipLine[6986] = StringToText("与你邻近的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("除外）之一") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使你死于处决。");
    g_tipLine[6987] = StringToText("【角色简介】");
    g_tipLine[6988] = TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("会使邻近的一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6989] = StringToText("· 由说书人选择哪名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，无论这名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家是存活还是死亡。");
    g_tipLine[6990] = StringToText("· ") + TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("效果会跳过与他相邻的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。") + TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("效果不会对") + TextWithColor(StringToText("旅行者"), Color(255, 69, 0)) + StringToText("生效。");
    g_tipLine[6991] = StringToText("· 这项能力当") + TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("死于处决时仍会保留。如果") + TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("因为非处决的原因而死亡时，") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("将会解除。");
    g_tipLine[6992] = StringToText("· 如果有玩家成为新的") + TextWithColor(StringToText("酒保"), Color(0, 191, 255)) + StringToText("，或一个") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家转为了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("，都会根据新的位置关系立刻改变") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家。");
    g_tipRoleAt[160] = 6985;
    g_tipRoleN[160] = 8;
    g_tipAbility[160] = StringToText("与你邻近的善良玩家（旅行者除外）之一醉酒，即使你死于处决。");
    // 【华灯初上/山雨欲来】和尚：按钟楼百科原文重建详情
    g_tipLine[6993] = StringToText("【角色能力】");
    g_tipLine[6994] = StringToText("每个夜晚，当有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，且你会得知你的能力被触发。");
    g_tipLine[6995] = StringToText("【角色简介】");
    g_tipLine[6996] = TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("慈悲为怀，一视同仁地庇护着他周围的人。");
    g_tipLine[6997] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在每个夜晚都能且仅能触发一次。");
    g_tipLine[6998] = StringToText("· 当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家，或者一项无需选择的能力在满足了条件而被触发，且会对与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家生效时，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家此次的能力不生效。这一效果跟使这名玩家「") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("/") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("」相似。然而，如果某名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家在同一个夜晚可以多次行动，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能使其中一次效果无效，而除此以外的其他效果仍然会正常生效。");
    g_tipLine[6999] = StringToText("· 如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力是一项持续生效的能力，而非选择式或触发式的能力，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使这项能力失效直至下个黎明。在下一个白天时，这项能力会再次生效。");
    g_tipLine[7000] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能在一项能力开始生效前阻止这项能力。他无法阻止已经生效的能力。");
    g_tipLine[7001] = StringToText("· 一旦") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力被成功触发，他会被唤醒，并得知自己的能力刚刚被触发了。") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("不会得知是哪名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力被他阻止了，也不会得知这项能力影响的是与他邻近的哪一名玩家。他只是单纯知道自己的能力被触发了。");
    g_tipLine[7002] = StringToText("· 如果一项") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力无法被阻止，那么") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力不会因此被触发，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力触发了。");
    g_tipLine[7003] = StringToText("【规则细节】");
    g_tipLine[7004] = StringToText("· 如果") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力使得一项「玩家让自身获得信息」的能力失效，其处理方式与") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("相似，该玩家仍然会获得信息，但信息可对可错。");
    g_tipLine[7005] = StringToText("· 特定角色互动：");
    g_tipLine[7006] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("影响了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在首个夜晚不会触发。如果") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("在游戏中途的某个夜晚被创造并将要影响与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力会被触发，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("能力（包括让另一侧的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("）会在下个黎明才开始生效。");
    g_tipLine[7007] = StringToText("· 限：如果限的能力让所有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[7008] = StringToText("· ") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("混沌"), Color(0, 191, 255)) + StringToText("的能力让所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，（") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的）") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[7009] = StringToText("· 相克规则：");
    g_tipLine[7010] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(0, 191, 255)) + StringToText("提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[7011] = StringToText("· 暴乱：如果暴乱提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipRoleAt[161] = 8037;
    g_tipRoleN[161] = 31;
    g_tipAbility[161] = StringToText("每个夜晚，当有邪恶玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，且你会得知你的能力被触发。");
    // 【华灯初上/山雨欲来】蛊雕：按钟楼百科原文重建详情
    g_tipLine[7012] = StringToText("【角色能力】");
    g_tipLine[7013] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家的角色，他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("且可能被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("，直到下个黄昏。");
    g_tipLine[7014] = StringToText("每局游戏限一次，在夜晚时，你可以改变方向。");
    g_tipLine[7015] = StringToText("【角色简介】");
    g_tipLine[7016] = TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("停留在") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("之中。");
    g_tipLine[7017] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("都会得知顺时针方向上的下一名存活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家的角色。其他角色类型的玩家，或是已经死亡的玩家，都会被") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("跳过。");
    g_tipLine[7018] = StringToText("· 被") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("得知的玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("且可能被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("，直到下个黄昏。这代表着其他玩家可能当作他是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("，也可能会是原本的阵营和角色，这取决于说书人。");
    g_tipLine[7019] = StringToText("· ") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("可以改变方向一次。如果") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("这么做了，代表") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("得知的玩家不再是顺时针方向上的下一名玩家，而是逆时针方向上的。") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("会因此得知曾得知过的角色。");
    g_tipLine[7020] = StringToText("【规则细节】");
    g_tipLine[7021] = StringToText("· 被「蛊毒」的玩家在同时判定角色和阵营的时候，如果决定让") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("的能力产生干扰，那么这名玩家只能被当作「") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("」。");
    g_tipLine[7022] = StringToText("· 如果被「蛊毒」的玩家不再是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或死亡了，这名玩家依然受到「蛊毒」的影响。");
    g_tipLine[7023] = StringToText("· 部分角色的能力中，把「蛊毒」玩家当作是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("属于「可以但不建议」，例如") + TextWithColor(StringToText("小恶魔"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("帽匠"), Color(0, 191, 255)) + StringToText("等。说书人应当结合实际经验来进行判断，给玩家带来良好的游戏体验。");
    g_tipLine[7024] = StringToText("· 相克规则：");
    g_tipLine[7025] = StringToText("· ") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("一定在场。每次处决后，存活的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("：如果猜对了，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7026] = StringToText("· ") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("会跳过") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7027] = StringToText("· ") + TextWithColor(StringToText("食人魔"), Color(0, 191, 255)) + StringToText("：如果「蛊毒」玩家被") + TextWithColor(StringToText("食人魔"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("食人魔"), Color(0, 191, 255)) + StringToText("会得知自己转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[7028] = StringToText("· ") + TextWithColor(StringToText("瘟疫医生"), Color(0, 191, 255)) + StringToText("：如果说书人本应获得") + TextWithColor(StringToText("蛊雕"), Color(0, 191, 255)) + StringToText("的能力，改为一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家获得此能力，且他会得知此事。");
    g_tipLine[7029] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7030] = StringToText("· 戏子/戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[162] = 7012;
    g_tipRoleN[162] = 19;
    g_tipAbility[162] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的镇民玩家的角色，他中毒且可能被当作邪恶的蛊雕，直到下个黄昏。 每局游戏限一次，在夜晚时，你可以改变方向。");
    // 【华灯初上/山雨欲来】典狱长：按钟楼百科原文重建详情
    g_tipLine[7031] = StringToText("【角色能力】");
    g_tipLine[7032] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，当晚他们之中会有一名玩家死亡。");
    g_tipLine[7033] = StringToText("【角色简介】");
    g_tipLine[7034] = TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("对「有罪之人」做出判罚，以连坐或择其一的方式。");
    g_tipLine[7035] = StringToText("· ") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("在首个夜晚就会行动，他可以选择一至三名玩家，但不能不进行选择。");
    g_tipLine[7036] = StringToText("· 如果下个白天，被") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("选中的玩家之一死于处决，那么所有其他被") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("选中的玩家都会在下个夜晚死亡；否则，被") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("选中的玩家中会有一名玩家在下个夜晚死亡。");
    g_tipLine[7037] = StringToText("【规则细节】");
    g_tipLine[7038] = StringToText("· 特定角色互动：");
    g_tipLine[7039] = StringToText("· ") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("造成死亡在他选择玩家之后。例如：") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("第二个夜晚选择了未被选择过的") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，第一个夜晚他选择的玩家都不会死亡。但第三个夜晚，只要") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("健康清醒，那么") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("在第二个夜晚选择的玩家（包括") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("在内），都会正常结算死亡。");
    g_tipLine[7040] = StringToText("· 相克规则：");
    g_tipLine[7041] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("召唤师"), Color(0, 191, 255)) + StringToText("可以在第二个夜晚召唤") + TextWithColor(StringToText("典狱长"), Color(0, 191, 255)) + StringToText("来替代第三个夜晚的召唤。");
    g_tipRoleAt[163] = 7031;
    g_tipRoleN[163] = 11;
    g_tipAbility[163] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，当晚他们之中会有一名玩家死亡。");
    }
    n = 0;
    if (g_board == 13 && g_legacyOn[130]) {
        while (n < 54 && BOTC_BootleggerAmnesiaLine(n) != "") {
            g_tipLine[3046 + n] = StringToText(BOTC_BootleggerAmnesiaLine(n));
            n = n + 1;
        }
        g_tipRoleN[130] = 1 + n;
        return;
    }
    pos = 1;
    while (pos <= len && n < 54) {
        // 角色详情列表约 29 个汉字一行；按标点断行，避免切在半个汉字上出现「?」。
        end = BOTC_LineCut(s, pos, 90, 12, len);
        s2 = StringSub(s, pos, end);
        g_tipLine[3046 + n] = StringToText(s2);
        n = n + 1;
        pos = end + 1;
    }
    // 角色简介（用户 2026-11-06）：按 wiki「私货商人」原文补齐；
    // 自定义规则超过 41 行时不再追加，保证本局规则文本完整优先。
    if (n + 13 <= 54) {
        g_tipLine[3046 + n] = StringToText("【角色简介】");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人允许说书人使用自己或他人创造的非官方角色，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("或允许他在游戏中使用非标准规则。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("如果剧本列表上有自定义角色，或游戏中包含自定义规则，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("说书人需要在游戏开始前讲这些内容介绍给所有玩家。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人允许剧本中夹杂复数数量的自定义角色或规则。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("只要当前剧本中包含有至少一个自定义角色，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("这个奇遇角色就会生效，且只能通过切换到一个");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("不包含任何自定义角色的剧本来将其移除。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人是仅能在官方app（国内为在线魔典）上使用的奇遇角色。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("尽管这个角色的名字之前有很多备选方案，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("但在决定它名字的一次激烈投票中，「私货商人」成功击败了");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("「私酿世家的霍姆布鲁菲斯蜀黍」。");
        n = n + 1;
    }
    g_tipRoleN[130] = 1 + n;
}

void BOTC_BootleggerCapture () {
    string s;
    if (g_cBootEdit >= 1) {
        s = libNtve_gf_DialogItemEditValue(g_cBootEdit, g_teller);
        // 点击其他控件时，EditBox 可能短暂返回空串；不能用它覆盖已经读到的规则。
        if (StringLength(s) > 0 || StringLength(g_bootText) == 0) {
            g_bootText = s;
        }
    }
}

void BOTC_BootleggerEditRefresh () {
    if (g_cBootEdit >= 1) {
        libNtve_gf_SetDialogItemText(g_cBootEdit, StringToText(g_bootText), PlayerGroupAll());
    }
}

void BOTC_BootleggerAnnounce () {
    int len;
    int pos;
    int end;
    string s;
    string b;
    if (!g_legacyOn[130]) {
        return;
    }
    BOTC_BootleggerSyncText();
    s = BOTC_BootleggerEffectiveText();
    len = StringLength(s);
    BOTC_PubAnnounce("【私货商人】本局自定义规则：");
    if (g_board == 13 && g_legacyOn[130]) {
        len = 0;
        while (len < 54 && BOTC_BootleggerAmnesiaLine(len) != "") {
            BOTC_PubAnnounce(BOTC_BootleggerAmnesiaLine(len));
            len = len + 1;
        }
        return;
    }
    pos = 1;
    while (pos <= len) {
        // 公聊约 33 个汉字一行（按 UTF-8 字节额度）；按标点断行，避免切在半个汉字上出现「?」。
        end = BOTC_LineCut(s, pos, 100, 30, len);
        b = StringSub(s, pos, end);
        BOTC_PubAnnounce(b);
        pos = end + 1;
    }
}

// 【自定义剧本可选项】骑士、杂技演员已恢复显示；其余旧《赎罪小镇》隐藏角色保持原状。
bool BOTC_CustomRoleVisible (int r) {
    if (r >= 143 && r <= 146) {
        return false;                 // 全员追忆的玩家视角占位身份不进入自定义角色池
    }
    if (r == 123 || r == 124 || r == 126) {
        return false;
    }
    return true;
}

int BOTC_CustomSlotRow (int s) {
    if (s < 8) { return 176; }
    if (s < 16) { return 266; }
    if (s < 21) { return 396; }
    if (s < 26) { return 516; }
    if (s < 31) { return 636; }
    if (s < 33) { return 756; }
    return 876;
}

int BOTC_CustomSlotCol (int s) {
    if (s < 8) { return s; }
    if (s < 16) { return s - 8; }
    if (s < 21) { return s - 16; }
    if (s < 26) { return s - 21; }
    if (s < 31) { return s - 26; }
    if (s < 33) { return s - 31; }
    return s - 33;
}

int BOTC_CustomSlotBase (int team) {
    if (team == 0) { return 0; }
    if (team == 1) { return 16; }
    if (team == 2) { return 21; }
    if (team == 3) { return 26; }
    if (team == 4) { return 31; }
    return 33;
}

int BOTC_CustomSlotMax (int team) {
    if (team == 0) { return 16; }
    if (team == 4 || team == 5) { return 2; }
    return 5;
}

int BOTC_CustomGrpY (int i) {
    if (i == 0) { return 148; }
    if (i == 1) { return 368; }
    if (i == 2) { return 488; }
    if (i == 3) { return 608; }
    if (i == 4) { return 728; }
    return 848;
}

string BOTC_CustomCatName (int cat) {
    if (cat == 0) {
        return "镇民";
    }
    if (cat == 1) {
        return "外来者";
    }
    if (cat == 2) {
        return "爪牙";
    }
    if (cat == 3) {
        return "恶魔";
    }
    if (cat == 4) {
        return "传奇角色";
    }
    return "奇遇角色";
}

int BOTC_CatCap (int cat) {
    if (cat == 0) {
        return 14;
    }
    if (cat == 4 || cat == 5) {
        return 2;               // 与右侧传奇 / 奇遇各两格保持一致
    }
    return 5;
}

// 这个分类目前有几个角色（分类号 = 阵营号：0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔 / 4 传奇 / 5 奇遇）
int BOTC_CatRoleN (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        n = n + 1;
    }
    return n;
}

// 第 i 个该分类的角色（-1 = 没有）
int BOTC_CatRoleAt (int cat, int i) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        if (n == i) {
            return r;
        }
        n = n + 1;
    }
    return -1;
}

int BOTC_CatPicked (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_CatPickedAll () {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

void BOTC_CustomRender () {
    int i;
    int r;
    int n;
    int pages;
    int used;
    int cc;
    int hn;
    int lty;
    int cx;
    int cy;
    string s;
    // 6 个分类按钮 + 计数，当前分类前面加 ▶
    for (i = 0; i < 6; i += 1) {
        s = BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i)) + "/" + IntToString(BOTC_CatCap(i));
        if (i == g_cat) {
            s = "▶ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cCatBtn[i], StringToText(s), PlayerGroupAll());
    }
    // 左盘块
    n = BOTC_CatRoleN(g_cat);
    pages = (n + 53) / 54;
    if (pages < 1) {
        pages = 1;
    }
    if (g_cpage < 0) {
        g_cpage = 0;
    }
    if (g_cpage > pages - 1) {
        g_cpage = pages - 1;
    }
    for (i = 0; i < 54; i += 1) {
        if (i >= 54) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        cx = 18 + ((i % 9) * 120);
        cy = 166 + ((i / 9) * 100);
        DialogControlSetPosition(g_cIcon[i], PlayerGroupAll(), c_anchorTopLeft, cx + 29, cy);
        DialogControlSetPosition(g_cIconImg[i], PlayerGroupAll(), c_anchorTopLeft, cx + 18, cy - 8);   // 【图标偏移】（用户 2026-10-04 定稿：X=18 / Y=-8）
        DialogControlSetPosition(g_cName[i], PlayerGroupAll(), c_anchorTopLeft, cx + 2, cy + 66);
        r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
        if (r < 0) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cName[i], PlayerGroupAll(), true);
        libNtve_gf_SetDialogItemImage(g_cIconImg[i], BOTC_NightIconName(r), PlayerGroupAll());
        s = g_roleName[r];
        if (g_csel[r]) {
            s = "√ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cName[i], TextWithColor(StringToText(s), BOTC_RoleTeamColor(r)), PlayerGroupAll());
    }
    // 【暴风捕手（113）】（用户 2026-10-10）：选了他就显示他保护谁；正在等他选就提示点一个角色
    if (g_cStormPick) {
        libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("【暴风捕手】点一个角色 = 保护他（当前：" + g_roleName[g_cStormRole] + "）"), PlayerGroupAll());
    }
    else {
        if (g_csel[113]) {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消   【暴风捕手】保护：" + g_roleName[g_cStormRole]), PlayerGroupAll());
        }
        else {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消"), PlayerGroupAll());
        }
    }
    libNtve_gf_SetDialogItemText(g_cPageLbl, StringToText(BOTC_CustomCatName(g_cat) + "：第 " + IntToString(g_cpage + 1) + " / " + IntToString(pages) + " 页（共 " + IntToString(n) + " 个）"), PlayerGroupAll());
    // 右盘块：按阵营分组往下排（每组一行彩色标题 + 图标，名字在图标下面）
    used = 0;
    cc = 0;
    hn = 0;
    lty = -1;
    cy = 150;
    for (i = 0; i < 35; i += 1) {
        DialogControlSetVisible(g_cSelIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cSelIconImg[i], PlayerGroupAll(), false);
        libNtve_gf_SetDialogItemText(g_cSelName[i], StringToText(""), PlayerGroupAll());
    }
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_cGrpLbl[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < 6; i += 1) {
        r = BOTC_CatRoleAt(i, 0);
        if (r < 0) {
            r = 88;
        }
        libNtve_gf_SetDialogItemText(g_cGrpLbl[i], TextWithColor(StringToText(BOTC_CustomCatName(i)), BOTC_RoleTeamColor(r)), PlayerGroupAll());
        used = BOTC_CustomSlotBase(i);
        for (r = 0; r <= 163; r += 1) {
            if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
                continue;
            }
            if (g_roleTeam[r] != i) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i)) {
                break;
            }
            libNtve_gf_SetDialogItemImage(g_cSelIconImg[used], BOTC_NightIconName(r), PlayerGroupAll());
            libNtve_gf_SetDialogItemText(g_cSelName[used], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupAll());
            DialogControlSetVisible(g_cSelIcon[used], PlayerGroupAll(), true);
            DialogControlSetVisible(g_cSelIconImg[used], PlayerGroupAll(), true);
            used = used + 1;
        }
        for (r = used; r < BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i); r += 1) {
            DialogControlSetVisible(g_cSelIcon[r], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cSelIconImg[r], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cSelName[r], StringToText(""), PlayerGroupAll());
        }
    }
    if (g_customSlot >= 1 && g_customSlot <= 6) {
        s = "自定义板 " + IntToString(g_customSlot) + "　已选 " + IntToString(used) + " / 35　";
    }
    else {
        s = "请选择下方自定义板 1..6　已选 0 / 35　";
    }
    for (i = 0; i < 6; i += 1) {
        if (i > 0) {
            s = s + " · ";
        }
        s = s + BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i));
    }
    libNtve_gf_SetDialogItemText(g_cSelTitle, StringToText(s), PlayerGroupAll());
    if (g_csel[130]) {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), true);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), false);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), false);
    }
}

void BOTC_AlchemistGuess (int p, int role) {
    if (p < 1 || p > 13) {
        return;
    }
    if (role != 18 && role != 75) {
        return;
    }
    if (g_alcSeat < 2 || g_alcSeat > 13) {
        return;
    }
    g_alcBy = p;
    g_alcClaimDay[p] = g_nightNum;   // 公开说出猜测即算声称用掉（真身/假声称都一样，每人每天一次）
    BOTC_PubAnnounce("【炼金术士】" + BOTC_NameStr(p) + " 公开猜测 " + BOTC_NameStr(g_alcSeat) + " 是" + g_roleName[role] + "。");
    BOTC_DeclareCdSet(p);
    // 谁都可以公开声称炼金术士；只有真正拥有这项能力且当前清醒的人产生效果。
    // 伪造声称不能覆盖真炼金术士已经记下的结果。
    if (!BOTC_HasAbility(p, 95)) {
        return;                        // 假声称：不给说书人私聊提醒（用户 2026-11-04）
    }
    if (BOTC_SeatDead(p) || !BOTC_AbilityWorks(p, 95)) {
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 声称猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：中毒/醉酒或已死亡 → 能力失效，不结算。");
        return;
    }
    if (BOTC_SeatTrueRole(g_alcSeat) == role) {
        g_alcGuess = g_alcSeat;
        g_alcDay = g_dayNum + 1;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜对了。");
    }
    else {
        g_alcGuess = 0;
        g_alcDay = 0;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜错了。");
    }
}
void BOTC_AlcBorrowOpen (int p) {
    int q;
    if (p < 2 || p > 13) {
        return;
    }
    // 【炼金术士(95)】（用户 2026-10-03）：这一格是**说书人**替他选借到哪只爪牙，
    //   所以面板开在**说书人**身上；被借能力的座位（p）记在 g_pickWho[g_teller]，点完由 BOTC_PickChoose 的模式 21 应用。
    g_pickMode[g_teller] = 21;
    g_pickWho[g_teller] = p;
    // 【借来的炼金术士能力】（用户 2026-11-03）：只把借到的爪牙能力挂到本座位，
    //   不改变身份、不打「是炼金术士」token。
    if (g_grantActing[p]) {
        g_pickAttachSeat[g_teller] = p;
    }
    g_pickTeam = 2;
    BOTC_PickFilter(g_teller, false);
    // 【炼金术士 × 间谍/寡妇相克】（用户 2026-11-06）：这两只不能被借用 ----
    //   按相克规则，本应获得间谍/寡妇能力时改为该角色一定在场，炼金术士不获得该能力。
    //   这里直接把两个按钮藏掉；若本局确实没有该角色，提醒说书人按「一定在场」处理。
    if (!BOTC_RoleInPlay(18) || !BOTC_RoleInPlay(75)) {
        BOTC_PmStore(g_teller, "【炼金术士×间谍/寡妇】按相克规则，炼金术士不能借用间谍或寡妇的能力；若本应获得该能力，改为该角色一定在场（可手工调整魔典）。");
    }
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 2 || g_gridSlot[q] == 18 || g_gridSlot[q] == 75) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}
void BOTC_AlchemistAsk (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    // 【炼金术士声称窗口】（用户 2026-11-04）：只能在提名处决之后、进入夜晚之前公开声称；
    //   每人每天一次，任何人都能声称，但只有真正的炼金术士猜对才有效果。
    if (!g_started || g_isNight || !g_execUsedToday) {
        BOTC_Notice(p, "【炼金术士】只能在今天的提名处决结束后、进入夜晚之前声称。");
        return;
    }
    if (g_alcClaimDay[p] == g_nightNum) {
        BOTC_Notice(p, "【炼金术士】你今天已经声称过了，每人每天只能声称一次。");
        return;
    }
    g_alcChoice[p] = true;
    g_alcPick[p] = false;
    g_alcRolePick[p] = 0;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    // 复用已经稳定的通用身份面板，避免独立小窗在某些客户端层级下不显示。
    g_pickMode[p] = 20;
    g_pickWho[p] = p;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatBtn[q], PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), false);
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    BOTC_DeclareSlot(p, 57, 18, 0, g_roleName[18]);
    BOTC_DeclareSlot(p, 58, 75, 1, g_roleName[75]);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("猜间谍还是寡妇？"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}
void BOTC_AlchemistPickRole (int p, int role) {
    if (p < 1 || p > 13 || !g_alcChoice[p]) {
        return;
    }
    g_alcChoice[p] = false;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    if (role != 18 && role != 75) {
        g_alcPick[p] = false;
        g_alcRolePick[p] = 0;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消炼金术士声称。");
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_alcRolePick[p] = role;
    g_alcPick[p] = true;
    BOTC_DeclareRender();
    BOTC_Notice(p, "你选择猜【" + g_roleName[role] + "】。现在点一名存活玩家。");
}
void BOTC_BuildCustom () {
    int i;
    int c;
    int rw;
    int x;
    int y;
    // 选板页入口改成「更多剧本」第一格（用户 2026-11-01），不再单独建按钮。
    g_customSlot = 0;
    // 面板本体（铺满整屏、不要底框，黑布透出来；用户 2026-10-03）
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_cDlg = DialogLastCreated();
    DialogSetImageVisible(g_cDlg, false);
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    // 自定义编辑器最底部：6 个窄槽位按钮。
    for (i = 0; i < 6; i += 1) {
        g_customSlotBtn[i] = BOTC_NewButton(g_cDlg, 64, 44, 1260 + (i * 76), 1120, IntToString(i + 1));
        DialogControlSetVisible(g_customSlotBtn[i], PlayerGroupAll(), false);
    }
    // 顶部 6 个分类按钮
    for (i = 0; i < 6; i += 1) {
        g_cCatBtn[i] = BOTC_NewButton(g_cDlg, 190, 50, 25 + (i * 240), 70, BOTC_CustomCatName(i));
    }
    // 左盘块：标题 + 4 x 4 角色格（每页 16 个）
    g_cInfoLbl = BOTC_NewLabelC(g_cDlg, 500, 30, 30, 140, StringToText("左：点图标 = 选中 / 取消"));
    libNtve_gf_SetDialogItemStyle(g_cInfoLbl, "ModLeftSize20Bold", PlayerGroupAll());
    for (i = 0; i < 54; i += 1) {
        g_cIcon[i] = BOTC_NewButton(g_cDlg, 62, 62, 0, 0, "");
        libNtve_gf_CreateDialogItemImage(g_cDlg, 62, 62, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_cIconImg[i] = DialogControlLastCreated();
        DialogControlSetSize(g_cIconImg[i], PlayerGroupAll(), 62, 62);
        DialogControlSetPosition(g_cIconImg[i], PlayerGroupAll(), c_anchorTopLeft, 0, 0);
        libNtve_gf_SetDialogItemAcceptMouse(g_cIconImg[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_cIconImg[i], "botc_blank.dds", PlayerGroupAll());
        g_cName[i] = BOTC_NewLabelC(g_cDlg, 116, 20, 0, 0, StringToText(""));
        DialogControlSetVisible(g_cName[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
    }
    // 左盘块下面：上一页 / 下一页 + 页码
    g_cPrevBtn = BOTC_NewButton(g_cDlg, 130, 44, 450, 1120, "上一页");
    g_cNextBtn = BOTC_NewButton(g_cDlg, 130, 44, 600, 1120, "下一页");
    g_cPageLbl = BOTC_NewLabelC(g_cDlg, 460, 26, 760, 1126, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_cPageLbl, "ModLeftSize16Bold", PlayerGroupAll());
    // 右盘块：像身份网格那样「阵营标题 + 图标（名字在图下面）」，位置在渲染时按分组动态排
    g_cSelTitle = BOTC_NewLabelC(g_cDlg, 1120, 30, 1140, 108, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_cSelTitle, "ModLeftSize16Bold", PlayerGroupAll());
    for (i = 0; i < 6; i += 1) {
        g_cGrpLbl[i] = BOTC_NewLabel(g_cDlg, 800, 30, 1140, BOTC_CustomGrpY(i), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_cGrpLbl[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_cGrpLbl[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_cGrpLbl[i], PlayerGroupAll(), true);
    }
    for (i = 0; i < 35; i += 1) {
        x = 1138 + (BOTC_CustomSlotCol(i) * 120);
        y = BOTC_CustomSlotRow(i);
        g_cSelIcon[i] = BOTC_NewButton(g_cDlg, 62, 62, x + 29, y, "");
        libNtve_gf_CreateDialogItemImage(g_cDlg, 62, 62, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_cSelIconImg[i] = DialogControlLastCreated();
        DialogControlSetSize(g_cSelIconImg[i], PlayerGroupAll(), 62, 62);
        DialogControlSetPosition(g_cSelIconImg[i], PlayerGroupAll(), c_anchorTopLeft, x + 18, y - 8);   // 【图标偏移】（用户 2026-10-04 定稿：X=18 / Y=-8）
        libNtve_gf_SetDialogItemAcceptMouse(g_cSelIconImg[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_cSelIconImg[i], "botc_blank.dds", PlayerGroupAll());
        g_cSelName[i] = BOTC_NewLabelC(g_cDlg, 116, 20, x + 2, y + 66, StringToText(""));
        DialogControlSetVisible(g_cSelIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cSelIconImg[i], PlayerGroupAll(), false);
    }
    // 【私货商人】自定义规则输入（选中 130 时才显示；宽度按自定义面板底部可用空间）
    g_cBootLbl = BOTC_NewLabel(g_cDlg, 1500, 28, 20, 998, StringToText("【私货商人】自定义规则（游戏开始时公屏播报，并同步到角色能力表）"));
    libNtve_gf_SetDialogItemStyle(g_cBootLbl, "ModLeftSize16Bold", PlayerGroupAll());
    g_cBootEdit = BOTC_NewEdit(g_cDlg, 1500, 52, 20, 1032);
    DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), false);
    // 左下：清空 / 返回；右下：保存 / 开始游戏
    g_cClearBtn = BOTC_NewButton(g_cDlg, 150, 44, 20, 1120, "清空");
    g_cBackBtn = BOTC_NewButton(g_cDlg, 170, 44, 180, 1120, "返回选板子");
    g_cSaveBtn = BOTC_NewButton(g_cDlg, 150, 48, 1760, 1116, "保存");
    g_cStartBtn = BOTC_NewButton(g_cDlg, 170, 48, 1920, 1116, "开始游戏");
}

void BOTC_CustomShowEditor () {
    int i;
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTabOfficial, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTabMore, PlayerGroupAll(), false);
    DialogControlSetVisible(g_seatInfoLbl, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_customSlotBtn[i], PlayerGroupAll(), true);
    }
    for (i = 0; i < 13; i += 1) {
        DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_cDlg, PlayerGroupAll(), true);
}

void BOTC_CustomOpenSlot (int slot) {
    int i;
    if (!g_boardOpen || slot < 1 || slot > 6) {
        return;
    }
    if (g_cOpen && g_customSlot == slot) {
        return;                       // 点当前槽位不重载，避免丢掉未保存改动。
    }
    g_customSlot = slot;
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = false;
    g_bankTry = 0;
    BOTC_CustomLoadBank(true);
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomOpen () {
    int i;
    if (!g_boardOpen) {
        return;
    }
    g_customSlot = 0;
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = true;           // 未选槽位前不做 bank 重试。
    g_bankTry = 0;
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomClose () {
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_BoardRender();             // 还原标题 / 板子 / 人数修正
}

void BOTC_CustomClear () {
    int r;
    g_cStormPick = false;
    g_bootText = "";
    g_bootSavePending = false;
    g_bootSaveSlot = 0;
    BOTC_BootleggerEditRefresh();
    for (r = 0; r <= 163; r += 1) {
        g_csel[r] = false;
    }
    BOTC_CustomRender();
    BOTC_Notice(g_teller, "自定义剧本已清空。");
}

// 点左盘块第 i 格：选中 / 取消（受各分类上限限制）
void BOTC_CustomToggle (int i) {
    int r;
    int cat;
    if (i < 0 || i > 53) {
        return;
    }
    r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
    if (r < 0) {
        return;
    }
    cat = g_roleTeam[r];
    if (g_csel[130]) { BOTC_BootleggerCapture(); }
    if (g_csel[r]) {
        g_csel[r] = false;
        BOTC_CustomRender();
        return;
    }
    if ((r == 101 && g_csel[153]) || (r == 153 && g_csel[101])) {
        BOTC_Notice(g_teller, "【相克】异端分子与狐媚娘不能同时出现在同一局中。");
        return;
    }
    if (BOTC_CatPickedAll() >= 33) {
        BOTC_Notice(g_teller, "右侧一共只能摆 33 个角色（14 镇民 + 5 外来者 + 5 爪牙 + 5 恶魔 + 2 传奇 + 2 奇遇）。");
        return;
    }
    if (BOTC_CatPicked(cat) >= BOTC_CatCap(cat)) {
        BOTC_Notice(g_teller, BOTC_CustomCatName(cat) + "最多只能选 " + IntToString(BOTC_CatCap(cat)) + " 个。");
        return;
    }
    g_csel[r] = true;
    if (r == 130) { BOTC_BootleggerEditRefresh(); }
    BOTC_CustomRender();
    // 【暴风捕手（113）】（用户 2026-10-10）：加他的时候直接进「点一个角色」模式 —— 那一个角色就是他保护的对象
    if (r == 113) {
        g_cStormPick = true;
        BOTC_Notice(g_teller, "【暴风捕手】点左边一个角色：他保护那个角色（夜间不会死，邪恶首夜得知）。");
        BOTC_CustomRender();
    }
}

// 点右盘块第 k 格 = 取消那个角色
void BOTC_CustomUnpick (int k) {
    int t;
    int r;
    int used;
    if (k < 0 || k > 34) {
        return;
    }
    // 【槽号 → 角色】（用户 2026-10-04 报「只有镇民点得掉、还会删错人」）：
    //   右边那块的排法是**按阵营分组**（镇民 0..15 / 外来者 16..20 / 爪牙 21..25 / 恶魔 26..30 /
    //   传奇 31..32 / 奇遇 33..34），每组按角色号升序填。
    //   老写法是按「全部已选角色按角色号升序数第 k 个」，跟这个排法对不上 ——
    //   只有镇民那一段碰巧吻合，别的阵营槽号早超出已选数量 → 点了没反应，偶尔还会删到别人。
    //   现在照 BOTC_CustomRender 的排法逐组扫一遍，槽号对上才删。（两组循环必须保持一致）
    for (t = 0; t < 6; t += 1) {
        used = BOTC_CustomSlotBase(t);
        for (r = 0; r <= 163; r += 1) {
            if (!g_csel[r]) {
                continue;
            }
            if (g_roleTeam[r] != t) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(t) + BOTC_CustomSlotMax(t)) {
                break;
            }
            if (used == k) {
                if (r == 130) {
                    BOTC_BootleggerCapture();
                }
                g_csel[r] = false;
                BOTC_CustomRender();
                return;
            }
            used = used + 1;
        }
    }
}

// 【存档小工具】（用户 2026-10-04）：读之前先统一问一句「这个章节里到底有几个角色」。
//   bak = false → 主档（n / r0..）； bak = true → 备份（pn / pr0..）。
//   章节名两种都会试（新名 "custom" 全 ASCII；旧名「自定义剧本」留着兼容老存档）。
int BOTC_CustomBankCount (bank bk, string sec, bool bak) {
    if (bak) {
        if (!BankKeyExists(bk, sec, "pn")) {
            return 0;
        }
        return BankValueGetAsInt(bk, sec, "pn");
    }
    if (!BankKeyExists(bk, sec, "n")) {
        return 0;
    }
    return BankValueGetAsInt(bk, sec, "n");
}

int BOTC_CustomBankApply (bank bk, string sec, bool bak) {
    int i;
    int n;
    int r;
    string k;
    g_bootText = "";
    n = BOTC_CustomBankCount(bk, sec, bak);
    if (n <= 0) {
        return 0;
    }
    if (n > 163) {
        n = 128;
    }
    for (i = 0; i < n; i += 1) {
        if (bak) {
            k = "pr" + IntToString(i);
        }
        else {
            k = "r" + IntToString(i);
        }
        if (!BankKeyExists(bk, sec, k)) {
            continue;
        }
        r = BankValueGetAsInt(bk, sec, k);
        if (r >= 0 && r <= 163 && BOTC_CustomRoleVisible(r)) {
            g_csel[r] = true;
        }
    }
    // 【暴风捕手保护的角色】（用户 2026-10-10）：老存档没有这个键 → 保持默认（异教领袖）
    if (BankKeyExists(bk, sec, "storm")) {
        r = BankValueGetAsInt(bk, sec, "storm");
        if (r >= 0 && r <= 163) {
            g_cStormRole = r;
        }
    }
    // 【私货商人规则文本】：主档 boot / 备份 pboot
    if (bak) { k = "pboot"; } else { k = "boot"; }
    if (BankKeyExists(bk, sec, k)) {
        g_bootText = BankValueGetAsString(bk, sec, k);
    }
    else {
        // 老档 / 迁移档可能只把规则写进了另一种章节名；仅在当前章节完全没有该键时兼容读取。
        if (sec == "custom" && BankKeyExists(bk, "自定义剧本", k)) {
            g_bootText = BankValueGetAsString(bk, "自定义剧本", k);
        }
        if (sec == "自定义剧本" && BankKeyExists(bk, "custom", k)) {
            g_bootText = BankValueGetAsString(bk, "custom", k);
        }
    }
    BOTC_BootleggerSyncText();
    return n;
}

// 【抓每个座位的银行句柄】（用户 2026-10-04 拿到的参考实现 —— 另一张做存档测试的图就是这么写的）：
//   ```galaxy
//   BankLoad(名字, 玩家);
//   gv_bank[玩家] = BankLastCreated();     // ← 关键：Load 完**立刻**用 BankLastCreated() 抓句柄
//   ```
//   之后读/写都用这个句柄数组（参考图是每个真人玩家都抓一份）。
//   · 这里照抄：1 号位（说书人）**一定**抓，另外每个真人座位也各抓一份（以后做"每人各存各的"直接用 `g_bank[p]`）。
//   · ⚠ 地图触发器里必须有「数据存档 - **预加载存档** "BOTCSave"」这条**声明**：
//     没有它，引擎不认这个银行文件 → `BankLastCreated()` 拿到空壳、`BankSave` 也不会真的落盘（踩过）。
//   · ⚠ 不要再用「打开数据存档」那条动作：它在地图初始化里会让**联机卡加载**（用户 2026-10-04 实测）。
void BOTC_BankInit () {
    int p;
    if (g_bankInit) {
        return;
    }
    g_bankInit = true;
    for (p = 1; p <= 13; p += 1) {
        if (p == g_teller || PlayerType(p) == 1) {          // 1 号位一定抓；其它真人座位也抓
            // 直接用 `BankLoad` 的返回值当句柄（我们实测：这样写出来的文件确实落盘了）。
            //   参考图用的是「BankLoad 之后紧跟 BankLastCreated()」，两种写法等价；
            //   但 `BankLastCreated()` 在某些上下文会拿到空句柄，所以这里用更稳的返回值。
            g_bank[p] = BankLoad("BOTCSave2", p);
            BankWait(g_bank[p]);                     // 【等待数据存档】读取是异步的，等它读完
        }
    }
}

// 【取「当前说书人的账号」银行】（用户 2026-10-20）：换座位后必须读取新说书人自己的 bank。
//   `g_teller` 是物理玩家号；`BOTC_BankInit()` 开局已经给每个真人座位加载过 `g_bank[p]`，
//   所以这里不需要再 BankLoad，也绝对不能用 0 冒充「本机玩家」。
//   【为什么叫 BOTCSave2】（用户 2026-10-04）：老的 `BOTCSave` 那份文件里带着**中文章节名**（自定义剧本），
//   而参考图（另一张联机能正常跑起来的测试图）的存档是**纯 ASCII**。怀疑联机同步时卡在中文名上，
//   所以换一个全新的纯 ASCII 名字重开一份干净的存档（老文件不动，数据已经搬过去了）。
bank BOTC_MyBank () {
    BOTC_BankInit();
    if (g_teller >= 1 && g_teller <= 13) {
        return g_bank[g_teller];
    }
    return g_bank[1];
}

// 【统计前重新加载指定玩家的 bank】（用户 2026-10-26）：
//   开局 BankInit 只缓存一次句柄；读写时机较晚或异步加载未完成时，
//   BankKeyExists 会暂时返回 false。旧实现把它当成 0，统计保存时就可能写回 1。
void BOTC_BankReloadFor (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (p != g_teller && PlayerType(p) != 1) {
        return;
    }
    g_bank[p] = BankLoad("BOTCSave2", p);
    BankWait(g_bank[p]);
}

// 【场次统计】bank 章节 = "stats"；键前缀 t/g/e/s + 物理玩家号。
//   t = 总场次；g = 善良场次；e = 邪恶场次；s = 说书人场次。
int BOTC_StatsGet (bank bk, int pid, string pre) {
    string k;
    if (pid < 1 || pid > 13) {
        return 0;
    }
    k = pre + IntToString(pid);
    if (!BankKeyExists(bk, "stats", k)) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", k);
}

int BOTC_StatsBankTotal (bank bk) {
    int pid;
    int n;
    n = 0;
    if (BankKeyExists(bk, "stats", "t")) {
        n = n + BankValueGetAsInt(bk, "stats", "t");
        if (BankKeyExists(bk, "stats", "g")) { n = n + BankValueGetAsInt(bk, "stats", "g"); }
        if (BankKeyExists(bk, "stats", "e")) { n = n + BankValueGetAsInt(bk, "stats", "e"); }
        if (BankKeyExists(bk, "stats", "s")) { n = n + BankValueGetAsInt(bk, "stats", "s"); }
        return n;
    }
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, "t");
        n = n + BOTC_StatsGet(bk, pid, "g");
        n = n + BOTC_StatsGet(bk, pid, "e");
        n = n + BOTC_StatsGet(bk, pid, "s");
    }
    return n;
}

// 【账号级累计】（用户 2026-10-26）：键不再带物理玩家号，直接使用 t/g/e/s。
//   同一个人这次坐玩家 1、下次坐玩家 5，仍然累计到同一个账号总场次。
//   旧档的 t1..t13 / g1..g13 / e1..e13 / s1..s13 在首次读取时求和迁移。
int BOTC_StatsOwnGet (bank bk, string pre) {
    int pid;
    int n;
    if (BankKeyExists(bk, "stats", pre)) {
        return BankValueGetAsInt(bk, "stats", pre);
    }
    n = 0;
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, pre);
    }
    return n;
}

void BOTC_StatsOwnBump (bank bk, string pre) {
    int v;
    v = BOTC_StatsOwnGet(bk, pre);
    BankValueSetFromInt(bk, "stats", pre, v + 1);
}

// 【声望值】（用户 2026-11-03）：结算时每名玩家给说书人打分，按分数累计进
//   说书人账号 bank 的 stats/rep：1 分 -5、2 分 +0、3 分 +5、4 分 +10、5 分 +15，最低 0。
int BOTC_TellerRepGet (bank bk) {
    if (!BankKeyExists(bk, "stats", "rep")) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", "rep");
}

// 【决赛圈声望】（用户 2026-11-05）：进入白天后场上只剩 4 / 3 人时给说书人 +50 声望。
//   单独写成「重新加载 → 累加 → 保存」，避免久未读档时把旧值写回去。
void BOTC_TellerRepAdd (int add) {
    bank bk;
    bank oldBk;
    int oldTotal;
    int pid;
    int rep;
    pid = g_teller;
    if (pid < 1 || pid > 13 || PlayerType(pid) != 1 || PlayerStatus(pid) == 2) {
        return;
    }
    BOTC_BankInit();
    oldBk = g_bank[pid];
    oldTotal = BOTC_StatsBankTotal(oldBk);
    BOTC_BankReloadFor(pid);
    if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
        g_bank[pid] = oldBk;               // 异步空档不能覆盖掉已经缓存到的高值
    }
    bk = g_bank[pid];
    rep = BOTC_TellerRepGet(bk) + add;
    if (rep < 0) {
        rep = 0;
    }
    BankValueSetFromInt(bk, "stats", "rep", rep);
    BankSave(bk);
}

int BOTC_RepDelta (int v) {
    if (v <= 1) {
        return -5;
    }
    if (v == 2) {
        return 0;
    }
    if (v == 3) {
        return 5;
    }
    if (v == 4) {
        return 10;
    }
    return 15;
}

// 【积分】（用户 2026-11-06）：每名玩家的账号积分累计在 stats/pt。
//   正常完成一局：胜方阵营 +100、败方阵营 +50（见 BOTC_StatsRecord）。
//   说书人按每名玩家打的分累计：1/2/3/4/5 星 = +10/+15/+20/+25/+30，每名玩家一局只计一次。
int BOTC_StatsPointGet (bank bk) {
    if (!BankKeyExists(bk, "stats", "pt")) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", "pt");
}

void BOTC_StatsPointAdd (bank bk, int add) {
    BankValueSetFromInt(bk, "stats", "pt", BOTC_StatsPointGet(bk) + add);
}

int BOTC_RatePointDelta (int v) {
    if (v <= 1) {
        return 10;
    }
    if (v == 2) {
        return 15;
    }
    if (v == 3) {
        return 20;
    }
    if (v == 4) {
        return 25;
    }
    return 30;
}

// 【说书人称号】（用户 2026-11-03）：按声望值与说书人场次判定，从高到低优先取最高等级。
string BOTC_TellerTitleBy (int s, int rep) {
    if (rep >= 20000 && s >= 1000) { return "首席说书人"; }
    if (rep >= 12000 && s >= 800) { return "宗师说书人"; }
    if (rep >= 8000 && s >= 500) { return "大师说书人"; }
    if (rep >= 5000 && s >= 300) { return "精英说书人"; }
    if (rep >= 3000 && s >= 200) { return "卓越说书人"; }
    if (rep >= 1000 && s >= 100) { return "资深说书人"; }
    if (rep >= 300 && s >= 30) { return "熟练说书人"; }
    if (rep >= 100 && s >= 10) { return "进阶说书人"; }
    if (rep >= 0 && s >= 3) { return "新锐说书人"; }
    return "见习说书人";
}

string BOTC_TellerTitle () {
    int pid;
    BOTC_BankInit();
    pid = g_who[1];
    if (pid < 1 || pid > 13) {
        return "见习说书人";
    }
    return BOTC_TellerTitleBy(BOTC_StatsOwnGet(g_bank[pid], "s"), BOTC_TellerRepGet(g_bank[pid]));
}

void BOTC_StatsRecord (int winSide) {
    bank bk;
    bank oldBk;
    int oldTotal;
    int q;
    int pid;
    // 【只在结算时累计一次】（用户 2026-11-04）：总场次 +1 只在胜负封盘时发生；
    //   同一次结算重复进入直接跳过，避免同一局被记两次。
    if (!g_gameOver || g_statsDone) {
        return;
    }
    g_statsDone = true;
    // 【场次统计按玩家自己的 bank 保存】（用户 2026-10-20）：
    //   以前统一写当前说书人的 bank，导致「只有自己换到说书人座位时才会累计」。
    //   现在每名真人只把自己的场次写进 `g_bank[物理玩家号]`，统计页也逐人读取自己的 bank。
    BOTC_BankInit();
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        pid = g_who[q];
        if (pid < 1 || pid > 13 || PlayerType(pid) != 1) {
            continue;
        }
        // 【中途退出的人不再写统计】（用户 2026-11-01）：他的座位会因为保留而仍在座位表里，
        //   但玩家已经离开、bank 句柄不可靠，跳过，避免读到空档或写坏存档。
        if (PlayerStatus(pid) == 2) {
            continue;
        }
        oldBk = g_bank[pid];
        oldTotal = BOTC_StatsBankTotal(oldBk);
        BOTC_BankReloadFor(pid);
        if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
            g_bank[pid] = oldBk;               // 异步空档不能覆盖掉已经缓存到的高值
        }
        bk = g_bank[pid];
        BOTC_StatsOwnBump(bk, "t");
        if (BOTC_SeatAlign(q) == 0) {
            BOTC_StatsOwnBump(bk, "g");
            BankValueSetFromInt(bk, "stats", "la", 0);   // 上一场阵营（随机发牌换边用）
        }
        else {
            BOTC_StatsOwnBump(bk, "e");
            BankValueSetFromInt(bk, "stats", "la", 1);   // 上一场阵营（随机发牌换边用）
        }
        // 【积分】（用户 2026-11-06）：正常结算一局，胜方阵营 +100、败方阵营 +50。
        if (BOTC_SeatAlign(q) == winSide) {
            BOTC_StatsPointAdd(bk, 100);
        }
        else {
            BOTC_StatsPointAdd(bk, 50);
        }
        BankSave(bk);
    }
    // 说书人：座位 1 当前坐的那个人；只写他自己的 bank。
    pid = g_who[1];
    if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1 && PlayerStatus(pid) != 2) {
        oldBk = g_bank[pid];
        oldTotal = BOTC_StatsBankTotal(oldBk);
        BOTC_BankReloadFor(pid);
        if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
            g_bank[pid] = oldBk;
        }
        bk = g_bank[pid];
        BOTC_StatsOwnBump(bk, "t");
        BOTC_StatsOwnBump(bk, "s");
        BankValueSetFromInt(bk, "stats", "la", 0);       // 说书人不算邪恶，下一局按善良处理
        BankSave(bk);
    }
    BOTC_PmStore(g_teller, "【场次统计】本局已按每名玩家的本地 bank 记录。");
}

void BOTC_StatsRender (int p) {
    bank bk;
    bank oldBk;
    int oldTotal;
    int pid;
    int avg10;
    int i;
    int j;
    int cur;
    int[14] stT;
    int[14] stG;
    int[14] stE;
    int[14] stS;
    int[14] stPt;
    int[14] stRs;
    int[14] stRc;
    int[14] stRep;
    int[14] stIdx;
    text line;
    text rowName;
    BOTC_BankInit();
    DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
    libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("场次统计"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
    // 【本地账号累计】（用户 2026-10-26）：直接读账号键 t/g/e/s；旧档自动汇总 t1..t13。
    oldBk = g_bank[p];
    oldTotal = BOTC_StatsBankTotal(oldBk);
    BOTC_BankReloadFor(p);
    if (BOTC_StatsBankTotal(g_bank[p]) < oldTotal) {
        g_bank[p] = oldBk;
    }
    // 【先收集再排序】（用户 2026-11-06）：统计页从上往下按总场次从高到低排列。
    //   每个查看者显示自己账号的总计；其他玩家仍显示各自 bank 里的账号总计。
    for (pid = 1; pid <= 13; pid += 1) {
        stT[pid] = 0;
        stG[pid] = 0;
        stE[pid] = 0;
        stS[pid] = 0;
        stPt[pid] = 0;
        stRs[pid] = 0;
        stRc[pid] = 0;
        stRep[pid] = 0;
        stIdx[pid] = pid;
        if (pid == p) {
            bk = g_bank[p];
        }
        else if (PlayerType(pid) == 1) {
            bk = g_bank[pid];
        }
        else {
            continue;                      // 空座位仍占一行（全 0），排到列表末尾
        }
        stT[pid] = BOTC_StatsOwnGet(bk, "t");
        stG[pid] = BOTC_StatsOwnGet(bk, "g");
        stE[pid] = BOTC_StatsOwnGet(bk, "e");
        stS[pid] = BOTC_StatsOwnGet(bk, "s");
        stPt[pid] = BOTC_StatsPointGet(bk);
        // 【说书人平均分】（用户 2026-11-02）：历史累计 rs / rc，显示一位小数。
        if (BankKeyExists(bk, "stats", "rs")) {
            stRs[pid] = BankValueGetAsInt(bk, "stats", "rs");
        }
        if (BankKeyExists(bk, "stats", "rc")) {
            stRc[pid] = BankValueGetAsInt(bk, "stats", "rc");
        }
        // 【声望值】（用户 2026-11-03）：显示在说书人平均分后面。
        stRep[pid] = BOTC_TellerRepGet(bk);
    }
    // 插入排序：总场次从高到低；场次相同按玩家号从小到大（稳定）。
    for (i = 2; i <= 13; i += 1) {
        cur = stIdx[i];
        j = i - 1;
        while (j >= 1 && stT[stIdx[j]] < stT[cur]) {
            stIdx[j + 1] = stIdx[j];
            j = j - 1;
        }
        stIdx[j + 1] = cur;
    }
    for (i = 1; i <= 13; i += 1) {
        pid = stIdx[i];
        // 【玩家 ID + 大厅自选色】（用户 2026-10-20）：不写「玩家N」，直接用实际玩家名。
        rowName = TextWithColor(PlayerName(pid), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(pid, false)));
        line = rowName;
        line = line + StringToText("    ");
        line = line + TextWithColor(StringToText("总场次 " + IntToString(stT[pid])), Color(0, 255, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("积分 " + IntToString(stPt[pid])), Color(255, 255, 160));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("善良 " + IntToString(stG[pid])), Color(0, 191, 255));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("邪恶 " + IntToString(stE[pid])), Color(255, 0, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("说书人 " + IntToString(stS[pid])), Color(255, 215, 0));
        if (stRc[pid] > 0) {
            avg10 = ((stRs[pid] * 10) + (stRc[pid] / 2)) / stRc[pid];
            line = line + StringToText("        ");
            line = line + TextWithColor(StringToText("平均分 " + IntToString(avg10 / 10) + "." + IntToString(avg10 - ((avg10 / 10) * 10)) + "（" + IntToString(stRc[pid]) + " 次）"), Color(255, 150, 0));
            line = line + StringToText("        ");
            line = line + TextWithColor(StringToText("声望 " + IntToString(stRep[pid])), Color(200, 180, 255));
        }
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), line);
        // 每名玩家之间多留一行空白。
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("    "));
    }
}

string BOTC_CustomSection (int slot) {
    if (slot == 1) {
        return "custom";                 // 槽位 1 兼容旧版单槽存档。
    }
    return "custom" + IntToString(slot);
}

void BOTC_CustomSaveBootOnly (int slot, string s) {
    bank bk;
    string sec;
    if (slot < 1 || slot > 6) {
        return;
    }
    bk = BOTC_MyBank();
    sec = BOTC_CustomSection(slot);
    BankValueSetFromString(bk, sec, "boot", s);
    BankSave(bk);
}

// 【保存】把当前槽位写进 bank（BOTCSave.SC2Bank —— 名字里别带下划线）。
void BOTC_CustomSaveBank () {
    bank bk;
    int r;
    int n;
    int whoBak;
    int oldN;
    int i;
    string k;
    string k2;
    string sec;
    // 【bank 名去下划线】（用户 2026-10-04 实测）：磁盘上那份文件叫 `BOTCSave.SC2Bank`（下划线没了），
    //   而诊断显示「同一个 bank 对象写→读是好的、却看不到文件里已有的 n」→ 说明**写的时候去掉下划线、读的时候按原名找**。
    //   干脆名字里不带下划线，读写就一定是同一个文件。
    // 【保存时重新取一次当前说书人的 bank】（用户 2026-10-20）：
    //   不缓存旧说书人的句柄，避免换座位后写回旧账号。
    bk = BOTC_MyBank();              // 当前谁当说书人，就写谁自己的 bank
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再保存。");
        return;
    }
    sec = BOTC_CustomSection(g_customSlot);
    BOTC_BootleggerCapture();
    BOTC_BootleggerSyncText();
    // 保存前把当前槽位的主档复制成一层备份：pn / pr0.. / pboot。
    if (BankKeyExists(bk, sec, "boot")) {
        BankValueSetFromString(bk, sec, "pboot", BankValueGetAsString(bk, sec, "boot"));
    }
    oldN = BOTC_CustomBankCount(bk, sec, false);
    if (oldN > 0) {
        if (oldN > 163) {
            oldN = 128;
        }
        for (i = 0; i < oldN; i += 1) {
            k = "r" + IntToString(i);
            if (!BankKeyExists(bk, sec, k)) {
                continue;
            }
            k2 = "pr" + IntToString(i);
            BankValueSetFromInt(bk, sec, k2, BankValueGetAsInt(bk, sec, k));
        }
        BankValueSetFromInt(bk, sec, "pn", oldN);
    }
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        k = "r" + IntToString(n);
        BankValueSetFromInt(bk, sec, k, r);
        n = n + 1;
    }
    BankValueSetFromInt(bk, sec, "n", n);
    // 【暴风捕手保护的角色】（用户 2026-10-10）：跟板子一起存
    BankValueSetFromInt(bk, sec, "storm", g_cStormRole);
    BankValueSetFromString(bk, sec, "boot", g_bootText);
    BankSave(bk);
    g_customBankOk = true;          // 这一局已经有存档了，不用再重试读档
    // 【保存反馈】（用户 2026-10-04）：私聊那边显示绿字「保存成功」；另给说书人一条提示条 + 明细行。
    //   日志里带上「当前说书人的 bank」是因为换座位后 bank 会跟着当前说书人的账号走。
    //   ⚠ 绿字靠的是 BOTC_LineText 里「who == 0 的系统行才走 BOTC_KeyColor」这条 ——
    //     点按钮时不一定是 0（会跟着上一次聊天残留），所以这里**强制按系统行存**这一句。
    whoBak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_PmStore(g_teller, "保存成功");
    g_chatWhoNow = whoBak;
    if (g_csel[130]) {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色，私货商人规则已一并保存。");
    }
    else {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色。");
    }
}

// 【打开面板时自动读档】没存过就保持空白
//   【读档要看对地方】（用户 2026-10-04 报「联机存了、重进右边一个角色都没有」）：
//   `BankLoad(名字, 玩家号)` 的 bank 是**按那个玩家的账号**存的 ——
//     · 联机（真人对局）：`Documents\StarCraft II\Accounts\<账号>\<角色>\Banks\<地图>\BOTCSave.SC2Bank`
//     · 编辑器 / 离线测试：`Documents\StarCraft II\Banks\BOTCSave.SC2Bank`
//   两边是不同文件；bank 跟着账号走，不跟着逻辑座位格走。
//   【换说书人】（用户 2026-10-20）：主读 `g_bank[g_teller]`，换座位后自动跟随新说书人的账号。
//   `BOTC_BankInit()` 只给真人座位各加载一次；这里不额外扫描 2~13，避免线上重复走网络。
//   当前说书人的 bank 为空时，才回退玩家 1 的旧 bank 做一次性迁移。
void BOTC_CustomLoadBank (bool talk) {
    bank bk;
    int i;
    int n;
    int sp;
    bool got;
    bool sawEmpty;
    bool useBak;
    string sec;
    string secMain;
    got = false;
    sawEmpty = false;
    useBak = false;
    sp = 0;
    n = 0;
    if (g_customSlot < 1 || g_customSlot > 6) {
        return;
    }
    secMain = BOTC_CustomSection(g_customSlot);
    sec = secMain;
    // 【先读当前说书人的账号，再回退玩家 1 的旧档】(用户 2026-10-20)：
    //   · 主份 = `g_bank[g_teller]`，换说书人后自动跟随新说书人，不再固定玩家 1。
    //   · 新说书人的 bank 里没有配置时，才读玩家 1 的旧 bank 做迁移；保存仍写回新说书人自己的 bank。
    //   · 开局 BankInit 已给每个真人座位加载过 bank，这里不额外扫描 2~13，避免联机反复走网络。
    //   · 章节名先用新的全 ASCII "custom"，再退回旧名「自定义剧本」（老存档是旧名）。
    //   · 主档空时用备份（pn / pr0..）自动恢复。
    //   · talk = false（定时重试那一路）：没读到就**静默返回**，而且**不动 g_csel**，
    //     免得把说书人手动选的东西冲掉；只有真读到了才清空再套用。
    for (i = 1; i <= 2; i += 1) {
        if (i == 1) {
            bk = BOTC_MyBank();          // 当前说书人的 bank（g_bank[g_teller]）
        }
        else {
            if (g_teller == 1) {
                break;                   // 本来就是玩家 1：没有旧主档可回退
            }
            bk = g_bank[1];              // 玩家 1 的老存档：只用于首次迁移
        }
        n = BOTC_CustomBankCount(bk, secMain, false);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = false;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", false);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = false;
                sec = "自定义剧本";
                break;
            }
        }
        if (BankKeyExists(bk, secMain, "n") || (g_customSlot == 1 && BankKeyExists(bk, "自定义剧本", "n"))) {
            sawEmpty = true;                 // 存过，但是 0 个角色（上次大概存了空面板）
        }
        n = BOTC_CustomBankCount(bk, secMain, true);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = true;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", true);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = true;
                sec = "自定义剧本";
                break;
            }
        }
    }
    if (!got) {
        g_customBankOk = false;
        if (!talk) {
            return;                          // 定时重试：没读到就静默走人，等下一拍再试
        }
        if (sawEmpty) {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】存档是空的（0 个角色）→ 面板留空。");
        }
        else {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】没找到存档 → 这次是空面板。");
        }
        return;
    }
    g_customBankOk = true;
    if (sp == 2) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】当前说书人的 bank 没有配置 → 已临时读取玩家 1 的旧存档；下次保存会写入当前说书人的 bank。");
    }
    if (n > 163) {
        n = 128;
    }
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;                   // 真读到了才清空 + 套用
    }
    BOTC_CustomBankApply(bk, sec, useBak);
    if (useBak) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】主存档是空的 → 已用上一份备份恢复：" + IntToString(n) + " 个角色。");
    }
    else {
            // 【存档·诊断】那两条调试提示已删（用户 2026-10-07）：只留下面这一行。
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已读回存档：" + IntToString(n) + " 个角色。");
    }
}

// 【开始游戏】把选好的角色写成第 7 张板子，然后直接按它开局
void BOTC_CustomStart () {
    int r;
    int n;
    int lg;
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再开始游戏。");
        return;
    }
    if (BOTC_CatPicked(3) < 1) {
        BOTC_Notice(g_teller, "自定义剧本里至少要有一个恶魔。");
        return;
    }
    if (g_csel[101] && g_csel[153]) {
        BOTC_Notice(g_teller, "【相克】异端分子与狐媚娘不能同时出场，删除其中一个后再开始。");
        return;
    }
    // 【点【开始游戏】= 顺手把这份配置也存进 bank】（用户 2026-10-04：他点的是【开始游戏】没点【保存】，
    //   结果下一局面板里没存档可读）—— 配置合法就先存一份，再开局。省得"配置好了却没存上"。
    BOTC_CustomSaveBank();
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] == 4 || g_roleTeam[r] == 5) {
            continue;                    // 传奇 / 奇遇不算板子角色，走 g_boardLegacy
        }
        if (n >= 128) {
            break;
        }
        g_boardRole[(7 * 256) + n] = r;
        n = n + 1;
    }
    if (n < 3) {
        BOTC_Notice(g_teller, "自定义剧本至少要有 3 个角色才能开局。");
        return;
    }
    g_boardRoleN[7] = n;
    lg = 0;
    // 【只收真正是「传奇 / 奇遇」的角色】（用户 2026-10-10 报「提线木偶 / 痢蛭 跑到传奇角色页里」）：
    //   原来扫 88..113 只看「选没选中」---- 那个区间里混着 93 提线木偶（爪牙）/ 100 痢蛭（恶魔）这些，
    //   一选中就把它们也塞进传奇列表了。改成**按阵营过滤**（4 传奇 / 5 奇遇），跟上面板子角色那段同一个口径。
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r]) { continue; }
        if (g_roleTeam[r] != 4 && g_roleTeam[r] != 5) { continue; }
        if (lg >= 4) { break; }
        g_boardLegacy[(7 * 4) + lg] = r;
        lg = lg + 1;
    }
    g_boardLegacyN[7] = lg;
    // 【自定义剧本 → 本局用他自己选的暴风捕手保护对象】（用户 2026-10-10）
    if (g_cStormRole < 0 || g_cStormRole > 163) {
        g_cStormRole = 106;
    }
    g_stormRole = g_cStormRole;
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】开始游戏：共 " + IntToString(n) + " 个角色（传奇角色 " + IntToString(lg) + " 个）。");
    BOTC_BoardFinish(7);
}

// 【自定义剧本】那一层收到的所有点击（吃掉 = 返回 true）
bool BOTC_CustomClick (int p, int c) {
    int i;
    int r;
    if (!g_cOpen) {
        return false;
    }
    if (p != g_teller) {
        return true;                 // 面板开着的时候只有说书人能操作
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_customSlotBtn[i]) {
            BOTC_CustomOpenSlot(i + 1);
            return true;
        }
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_cCatBtn[i]) {
            g_cat = i;
            g_cpage = 0;
            BOTC_CustomRender();
            return true;
        }
    }
    for (i = 0; i < 54; i += 1) {
        if (c == g_cIcon[i]) {
            // 【暴风捕手选保护对象】（用户 2026-10-10）：这一模式下点图标 = 指定保护角色，**不改**这个角色选没选中
            if (g_cStormPick) {
                r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
                if (r >= 0) {
                    g_cStormRole = r;
                    g_stormRole = r;
                    g_cStormPick = false;
                    BOTC_PmStore(g_teller, "【暴风捕手】保护的角色：" + g_roleName[r] + "。");
                    BOTC_Notice(g_teller, "【暴风捕手】保护的角色已设为：" + g_roleName[r] + "。");
                    BOTC_CustomRender();
                }
                return true;
            }
            BOTC_CustomToggle(i);
            return true;
        }
    }
    for (i = 0; i < 35; i += 1) {
        if (c == g_cSelIcon[i]) {
            BOTC_CustomUnpick(i);
            return true;
        }
    }
    if (c == g_cPrevBtn) {
        g_cpage = g_cpage - 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cNextBtn) {
        g_cpage = g_cpage + 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cClearBtn) {
        BOTC_CustomClear();
        return true;
    }
    if (c == g_cBackBtn) {
        BOTC_CustomClose();
        return true;
    }
    if (c == g_cSaveBtn) {
        BOTC_CustomSaveBank();
        if (g_csel[130] && g_customSlot >= 1 && g_customSlot <= 6) {
            g_bootSavePending = true;
            g_bootSaveSlot = g_customSlot;
        }
        return true;
    }
    if (c == g_cStartBtn) {
        BOTC_CustomStart();
        return true;
    }
    return true;
}

bool BOTC_BoardTimer_Func (bool testConds, bool runActions) {
    if (!g_boardOpen) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    BOTC_BoardTimeout();
    return true;
}

//--------------------------------------------------------------------------------------------------
// 本局设置投票（用户 2026-09-17）
//   智能说书模式下，选板子页面右边多出一块：私聊时间 / 公聊时间 / 提名时间 / 第一天开不开邪恶小窗
//   · 每位玩家（2..13）每一项都能投一票，再点一次同一项 = 取消那一票
//   · 选板子结束那一刻结算（BOTC_BvApply）：票多的赢；平票取「离默认值最近」的，再平取小的
//   · 没人投的那一项 = 用默认值（私聊 3 分钟 / 公聊 3 分钟 / 提名 20 秒 / 不开小窗）
//--------------------------------------------------------------------------------------------------
void BOTC_BvReset () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        g_bvPm[i] = 0;
        g_bvPub[i] = 0;
        g_bvNom[i] = 0;
        g_bvEvil[i] = 0;
    }
    g_setPmMin = 3;                // 私聊 3 分钟（0 = 换成自由发言）
    g_setPubMin = 3;               // 公聊 3 分钟
    g_setNomSec = 30;              // 提名阶段的自由提名时间 30 秒（用户 2026-09-19 要求，原来 20）
    g_setEvilDay1 = false;         // 第一天不开邪恶小窗
}

// 某一项、某个选项拿了几票（kind：0 私聊 / 1 公聊 / 2 提名 / 3 小窗）
int BOTC_BvCount (int kind, int val) {
    int k;
    int n;
    n = 0;
    for (k = 2; k <= 13; k += 1) {
        if (kind == 0) {
            if (g_bvPm[k] == val) {
                n = n + 1;
            }
        }
        else {
            if (kind == 1) {
                if (g_bvPub[k] == val) {
                    n = n + 1;
                }
            }
            else {
                if (kind == 2) {
                    if (g_bvNom[k] == val) {
                        n = n + 1;
                    }
                }
                else {
                    if (g_bvEvil[k] == val) {
                        n = n + 1;
                    }
                }
            }
        }
    }
    return n;
}

// 某一项谁赢：票多的赢；平票取离默认值（def）最近的，再平取小的；一票都没有 = 默认值本身
int BOTC_BvWinner (int kind, int cnt, int def) {
    int v;
    int n;
    int d;
    int best;
    int bestN;
    int bestD;
    best = def;
    bestN = 0;
    bestD = 0;
    for (v = 1; v <= cnt; v += 1) {
        n = BOTC_BvCount(kind, v);
        if (v >= def) {
            d = v - def;
        }
        else {
            d = def - v;
        }
        if (n > bestN) {
            best = v;
            bestN = n;
            bestD = d;
        }
        else {
            if (n == bestN) {
                if (d < bestD) {
                    best = v;
                    bestD = d;
                }
            }
        }
    }
    return best;
}

// 选项的短名字（显示「你已选」用）
string BOTC_BvStr (int kind, int v) {
    if (kind == 0) {
        if (v == 0) {
            return "未选";
        }
        if (v == 5) {
            return "自由";
        }
        return IntToString(v) + "分";
    }
    if (kind == 1) {
        if (v == 0) {
            return "未选";
        }
        return IntToString(v) + "分";
    }
    if (kind == 2) {
        if (v == 0) {
            return "未选";
        }
        if (v == 1) {
            return "10秒";
        }
        if (v == 3) {
            return "30秒";
        }
        return "20秒";
    }
    if (v == 0) {
        return "未投";
    }
    if (v == 1) {
        return "要";
    }
    return "不要";
}

// 刷新右边那一块：票数 + 每个人自己的「你已选」
void BOTC_BvRender () {
    int k;
    string s;
    string mine;
    if (g_bvTitle == 0) {
        return;
    }
    // 只有智能说书模式才显示（手动说书由说书人自己控场，不需要投票）
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvPmBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvPubBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 3; k += 1) {
        DialogControlSetVisible(g_bvNomBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvHead[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvLine[k], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_bvEvilBtn, PlayerGroupAll(), (false));
    // 邪恶小窗功能关掉时：这一项的小标题、结果行、选项按钮全都不给看（用户 2026-09-19「开局投票也不用投了」）
    DialogControlSetVisible(g_bvHead[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvLine[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvTitle, PlayerGroupAll(), false);
    return;
    s = "私聊：1分" + IntToString(BOTC_BvCount(0, 1)) + "  2分" + IntToString(BOTC_BvCount(0, 2)) + "  3分" + IntToString(BOTC_BvCount(0, 3)) + "  4分" + IntToString(BOTC_BvCount(0, 4)) + "  自由" + IntToString(BOTC_BvCount(0, 5));
    libNtve_gf_SetDialogItemText(g_bvLine[0], StringToText(s), PlayerGroupAll());
    s = "公聊：1分" + IntToString(BOTC_BvCount(1, 1)) + "  2分" + IntToString(BOTC_BvCount(1, 2)) + "  3分" + IntToString(BOTC_BvCount(1, 3)) + "  4分" + IntToString(BOTC_BvCount(1, 4));
    libNtve_gf_SetDialogItemText(g_bvLine[1], StringToText(s), PlayerGroupAll());
    s = "提名：10秒" + IntToString(BOTC_BvCount(2, 1)) + "  20秒" + IntToString(BOTC_BvCount(2, 2)) + "  30秒" + IntToString(BOTC_BvCount(2, 3));
    libNtve_gf_SetDialogItemText(g_bvLine[2], StringToText(s), PlayerGroupAll());
    if (g_evilEnable) {
        s = "第一天开邪恶小窗：要" + IntToString(BOTC_BvCount(3, 1)) + "  不要" + IntToString(BOTC_BvCount(3, 2));
        libNtve_gf_SetDialogItemText(g_bvLine[3], StringToText(s), PlayerGroupAll());
    }
    // 「你已选」是**每人一份**的：同一个控件对不同玩家写不同的字（跟私聊输入框一个道理）
    for (k = 2; k <= 13; k += 1) {
        mine = "你已选：私聊" + BOTC_BvStr(0, g_bvPm[k]) + " / 公聊" + BOTC_BvStr(1, g_bvPub[k]) + " / 提名" + BOTC_BvStr(2, g_bvNom[k]);
        if (g_evilEnable) {
            mine = mine + " / 小窗" + BOTC_BvStr(3, g_bvEvil[k]);
        }
        libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText(mine), PlayerGroupSingle(k));
        libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：" + BOTC_BvStr(3, g_bvEvil[k])), PlayerGroupSingle(k));
    }
    // 说书人那边那一行给个说明（玩家 2..13 各自看到的是自己的「你已选」）
    libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText("（玩家 2..13 各投一票；再点一次同一项 = 取消）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：未投"), PlayerGroupSingle(g_teller));
}

// 投票：kind 0 私聊 / 1 公聊 / 2 提名 / 3 小窗；再点同一个选项 = 取消
void BOTC_BvVote (int p, int kind, int val) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_boardOpen) {
        return;
    }
    if (kind == 3 && !g_evilEnable) {
        return;                        // 邪恶小窗关着：这一项不接受投票
    }
    if (kind == 0) {
        if (g_bvPm[p] == val) {
            g_bvPm[p] = 0;
        }
        else {
            g_bvPm[p] = val;
        }
    }
    else {
        if (kind == 1) {
            if (g_bvPub[p] == val) {
                g_bvPub[p] = 0;
            }
            else {
                g_bvPub[p] = val;
            }
        }
        else {
            if (kind == 2) {
                if (g_bvNom[p] == val) {
                    g_bvNom[p] = 0;
                }
                else {
                    g_bvNom[p] = val;
                }
            }
            else {
                // 小窗那一项：未投 → 要 → 不要 → 未投 循环
                if (g_bvEvil[p] == 0) {
                    g_bvEvil[p] = 1;
                }
                else {
                    if (g_bvEvil[p] == 1) {
                        g_bvEvil[p] = 2;
                    }
                    else {
                        g_bvEvil[p] = 0;
                    }
                }
            }
        }
    }
    BOTC_BvRender();
}

// 结算（选板子结束那一刻）：把投票结果写成「本局设置」，智能说书人的白天节奏照它走
void BOTC_BvApply () {
    int w;
    string s;
    return;
    w = BOTC_BvWinner(0, 5, 3);
    if (w == 5) {
        g_setPmMin = 0;            // 5 = 自由发言：把私聊时间换成自由发言（3 分钟）
    }
    else {
        g_setPmMin = w;
    }
    g_setPubMin = BOTC_BvWinner(1, 4, 3);
    w = BOTC_BvWinner(2, 3, 3);        // 默认 / 平票锚点 = 3（30 秒）；玩家照样可以投 10 / 20 秒
    if (w == 1) {
        g_setNomSec = 10;
    }
    else {
        if (w == 3) {
            g_setNomSec = 30;
        }
        else {
            g_setNomSec = 20;
        }
    }
    if (BOTC_BvWinner(3, 2, 2) == 1 && g_evilEnable) {
        g_setEvilDay1 = true;
    }
    else {
        g_setEvilDay1 = false;         // 功能关掉时（g_evilEnable = false）这一项一律作废
    }
    // 播报一句：大家知道本局按什么时间走
    if (g_setPmMin <= 0) {
        s = "私聊时间：" + "自由发言 3 分钟";
    }
    else {
        s = "私聊时间：" + IntToString(g_setPmMin) + " 分钟";
    }
    s = s + " / 公聊时间：" + IntToString(g_setPubMin) + " 分钟 / 提名时间：" + IntToString(g_setNomSec) + " 秒";
    if (g_evilEnable) {
        s = s + " / 第一天邪恶小窗：";
        if (g_setEvilDay1) {
            s = s + "开";
        }
        else {
            s = s + "不开";
        }
    }
    BOTC_PubAnnounce("【本局设置】" + s);
}

// 得票最多的板子拿了几票（提前结束用：超过本局玩家的一半就直接进入）
int BOTC_BoardTopVotes () {
    int i;
    int k;
    int v;
    int best;
    best = 0;
    for (i = 1; i <= 12; i += 1) {  // 板子号最大到 12（7 = 自定义剧本，没人能投票）
        v = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_boardVote[k] == i) {
                v = v + 1;
            }
        }
        if (v > best) {
            best = v;
        }
    }
    return best;
}

void BOTC_BoardInfoRender () {
    int n;
    if (g_board <= 0) {
        DialogControlSetVisible(g_boardImg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), false);
        return;
    }
    libNtve_gf_SetDialogItemImage(g_boardImg, BOTC_BoardPic(g_board), PlayerGroupAll());
    BOTC_BuildSeatList();
    n = g_seatN;
    // 上色：镇民蓝、外来者天蓝、爪牙橙、恶魔红
    libNtve_gf_SetDialogItemText(g_boardInfo, TextWithColor(StringToText("镇" + IntToString(g_tcTab[n])), Color(70, 120, 255)) + TextWithColor(StringToText("  外" + IntToString(g_ocTab[n])), Color(130, 205, 255)) + TextWithColor(StringToText("  爪" + IntToString(g_mcTab[n])), Color(255, 150, 40)) + TextWithColor(StringToText("  恶1"), Color(235, 60, 60)), PlayerGroupAll());
    DialogControlSetVisible(g_boardImg, PlayerGroupAll(), true);
    DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), true);
}

// 画某个玩家的 token 面板：一格 = 图 + 小字
//   死亡类 token 现在所有人可见、可点；隐形槽（18）不占格子，后面的 token 自动往前排
bool BOTC_TokVisibleFor (int ob, int t) {
    // 【伪造魔典 token 面板】（用户 2026-11-07）：伪造面板列全部具名 token，不按板子过滤。
    if (g_tokFake) {
        return (t != 18 && g_tokName[t] != "");
    }
    return !BOTC_TokHidden(t, ob);
}

bool BOTC_TokMarkedFor (int ob, int t) {
    if (g_tokFake) {
        return g_fakeTok[((g_tokWho[ob] * 256) + t)];
    }
    return g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t];
}

void BOTC_TokRender (int ob) {
    int t;
    int n;
    int k;
    int pages;
    int page;
    int w;
    int x;
    int y;
    string s;
    // 先数一遍「这个板子里能看到的 token」有几个，算出总页数（每页 35 个）
    k = 0;
    for (t = 0; t < 256; t += 1) {
        if (BOTC_TokVisibleFor(ob, t)) {
            k = k + 1;
        }
    }
    pages = ((k + 34) / 35);
    if (pages < 1) {
        pages = 1;
    }
    page = g_tokPage[ob];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_tokPage[ob] = page;
    n = 0;                    // 这一页里已经画了几格
    k = 0;                    // 全表里第几个可见 token（从 0 开始）
    for (t = 0; t < 256; t += 1) {
        if (!BOTC_TokVisibleFor(ob, t)) {
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            continue;
        }
        if (((k / 35) + 1) != page) {
            // 不在当前这一页：收起来（但页码还是要往后数）
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            k = k + 1;
            continue;
        }
        x = 11 + ((n % 7) * 148);
        y = 40 + ((n / 7) * 86);
        DialogControlSetPosition(g_tokBtn[t], PlayerGroupSingle(ob), c_anchorTopLeft, x, y);
        if (g_tokIcon[t] == "") {
            // 还没有图的 token（处决 / 善良 / 邪恶）：整格只显示名字
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            if (BOTC_TokMarkedFor(ob, t)) {
                s = "√ " + g_tokName[t];       // 打上了就给个勾（用户 2026-09-20：没勾以为打不上去）
            }
            else {
                s = g_tokName[t];
            }
            w = StringLength(s) * 16;
            if (w > 144) {
                w = 144;
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + ((144 - w) / 2), y + 32);
            libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
        }
        else {
            if (BOTC_TokMarkedFor(ob, t)) {
                s = "√ " + g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], TextWithColor(StringToText(s), Color(120, 255, 120)), PlayerGroupSingle(ob));
            }
            else {
                s = g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
            }
            libNtve_gf_SetDialogItemImage(g_tokIconCtl[t], g_tokIcon[t], PlayerGroupSingle(ob));
            DialogControlSetPosition(g_tokIconCtl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + 18, y + 7);   // 图标 X 偏移：56 → 20（用户 2026-09-19）
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), true);
            w = StringLength(s) * 16;
            if (w > 43) {
                w = (144 - w) / 2;
                if (w < 0) {
                    w = 0;
                }
            }
            else {
                w = 18 + ((43 - w) / 2);      // 小字跟着图标居中（图标 X 偏移改成 20）
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + w, y + 52);
        }
        DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), true);
        n = n + 1;
        k = k + 1;
    }
    // 页码 + 翻页按钮（只有一页就不显示）
    libNtve_gf_SetDialogItemText(g_tokPageLbl, StringToText("第 " + IntToString(page) + " / " + IntToString(pages) + " 页（每页 35 个）"), PlayerGroupSingle(ob));
    if (pages > 1) {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), true);
    }
    else {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), false);
    }
}

// 打开某个座位的 token 面板：说书人和玩家都能开，各记各的（别人的标记自己看不到）
void BOTC_TokOpen (int ob, int who) {
    int q;
    // 【选目标期间禁止标记】（用户 2026-11-02）：正在点座位选目标时点圆桌是在选人，
    //   别顺手打开标记面板；点【确认】/【取消】后立即恢复。
    if (ob != g_teller) {
        // 【正式开始前禁止标记】（用户 2026-11-06）：开局前玩家不能改任何座位的 token
        if (!g_started) {
            BOTC_Notice(ob, "游戏正式开始前不能修改标记。");
            return;
        }
        q = BOTC_PosOf(ob);
        if (q >= 2 && q <= 13 && g_skillPicking[q]) {
            BOTC_Notice(ob, "选目标期间不能修改标记，请先完成技能选择。");
            return;
        }
    }
    g_tokFake = false;              // 正常打开的 token 面板操作真实魔典
    g_tokWho[ob] = who;
    g_tokPage[ob] = 1;             // 每次打开都从第 1 页开始（用户 2026-09-20）
    libNtve_gf_SetDialogItemText(g_tokTitle, BOTC_PlayerNameText(who) + StringToText(" 的 token"), PlayerGroupSingle(ob));
    BOTC_TokRender(ob);
    DialogSetVisible(g_tokDlg, PlayerGroupSingle(ob), true);
}

void BOTC_TokToggle (int ob, int idx) {
    BOTC_TokToggleAt(ob, g_tokWho[ob], idx);
    BOTC_TokRender(ob);
}

// 直接点圆桌上的 token 就把它去掉 / 加上
void BOTC_TokToggleAt (int ob, int seat, int t) {
    int i;
    int q;
    int prevPerc;
    int newA;
    // 【伪造魔典 token】（用户 2026-11-07）：只改伪造数据，不触发任何真实对局结算。
    if (g_tokFake) {
        if (ob != g_teller) {
            return;
        }
        if (seat < 2 || seat > 13 || t < 0 || t > 255) {
            return;
        }
        if (t == 18 || g_tokName[t] == "") {
            return;
        }
        g_fakeTok[((seat * 256) + t)] = !g_fakeTok[((seat * 256) + t)];
        BOTC_FakeRender();
        return;
    }
    // 【禁止给自己标记 token】限制已取消（用户 2026-11-03）：玩家可以给自己标记 token，
    //   但仍不能改自己的角色标记（拦在 BOTC_PickOpen）。
    if (ob != g_teller) {
        // 【正式开始前禁止标记】（用户 2026-11-06）：开局前玩家不能改任何座位的 token
        if (!g_started) {
            BOTC_Notice(ob, "游戏正式开始前不能修改标记。");
            return;
        }
        q = BOTC_PosOf(ob);
        if (q >= 2 && q <= 13) {
            // 【选目标期间禁止标记】（用户 2026-11-02）：正在点座位选目标时误触 token
            //   会被当成放置标记 → 先拦住；点【确认】/【取消】后立即恢复。
            if (g_skillPicking[q]) {
                BOTC_Notice(ob, "选目标期间不能修改标记，请先完成技能选择。");
                return;
            }
        }
    }
    // 隐形槽（18 = 镇长记账）不给点
    if (BOTC_TokHidden(t, ob)) {
        return;
    }
    // 【屏蔽 token】（用户 2026-11-06）：说书人不能手动 toggle 屏蔽 token 182，它只由屏蔽/解除屏蔽自动管理。
    if (t == 182 && ob == g_teller) {
        BOTC_Notice(ob, "屏蔽标记只能由玩家自己在身份面板里操作。");
        return;
    }
    // 【记录转变前的认知阵营】（用户 2026-11-06）：手动打善良 / 邪恶 token 前先记住
    //   他「以为自己是什么阵营」，认知没变时不再私聊打扰（疯子被灵言师转邪恶等）。
    prevPerc = -1;
    if (ob == g_teller && seat >= 2 && seat <= 13 && (t == 14 || t == 15)) {
        prevPerc = BOTC_PerceivedAlign(seat);
    }
    g_tokOn[(((ob * 14) + seat) * 256) + t] = !g_tokOn[(((ob * 14) + seat) * 256) + t];
    // 【诺-达鲺手改优先】（用户 2026-10-19）：手动把「中毒（诺-达鲺）」移到别处后，
    //   不再让下一次黄昏 / 身份同步按旧记录复原。这里同步记录实际有标记的座位。
    if (ob == g_teller && t == 80) {
        g_nodManual = true;
        g_nodDemon = BOTC_LiveDemonSeat(70);
        g_nodA = 0;
        g_nodB = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = i;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = i;
                }
            }
        }
    }
    // 【哲学家醉酒同步】token 一打/一撤就同步一次（说书人手动给哲学家下毒也能立刻见效）
    //   ⚠ 但「醉酒（哲学家）90」本身要留给说书人手动纠正（用户 2026-10-12）----
    //     自动同步是「先清掉所有 90、再按算出来的目标重打」，手动打的那一枚会当场被抹掉。
    if (ob == g_teller && t != 90) {
        BOTC_PhiloDrunkSync();
    }
    if (ob == g_teller && t == 90) {
        // 【手动优先】（用户 2026-10-12）：说书人自己打上这枚 → 自动同步不再插手；
        //   他自己撤掉（这一格没 token 了）→ 交还给自动同步。
        g_philoDrunkManual = g_tokOn[(((g_teller * 14) + seat) * 256) + 90];
    }
    // 【是恶魔（小怪宝）134】（用户 2026-10-10）：谁被打上这枚 token，谁就是「现在的恶魔」---- 记住座位。
    //   ⚠ 撤掉 token 时**不清** g_lmSeat：照看人死了 token 会被离场清理自动收掉，那时候还要靠它判胜负。
    if (ob == g_teller && t == 134 && g_tokOn[((((g_teller * 14) + seat) * 256) + t)]) {
        g_lmSeat = seat;
        // 【告诉他今晚照看小怪宝】（用户 2026-10-10）：打上这枚 token 的那一刻私聊他
        BOTC_PmInfo(g_who[seat], "【小怪宝】今晚由你来照看小怪宝。");
        BOTC_PmStore(g_teller, "【小怪宝】已告诉 " + BOTC_NameStr(seat) + "：今晚由他照看小怪宝。");
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
    }
    // 【善良(14) / 邪恶(15)】手动打 / 撤：真身阵营跟着变 → 登记层缓存作废（用户 2026-09-20）
    if (t == 14 || t == 15) {
        BOTC_PairClearSeat(seat);
        // 【阵营改变的提示】（用户 2026-09-26）：说书人给他打上这个 token → 当场私聊告诉他阵营变了
        if (ob == g_teller && g_tokOn[(((g_teller * 14) + seat) * 256) + t]) {
            newA = BOTC_SeatAlign(seat);
            // 【认知没变就不通知】（用户 2026-11-06）：疯子被灵言师 / 方古转成邪恶时，
            //   他本来就以为自己是邪恶的，不必再私聊告诉他一遍。
            if (seat >= 2 && seat <= 13 && prevPerc == newA) {
                BOTC_PmStore(g_teller, "【阵营转变】" + BOTC_NameStr(seat) + " 本来就认为自己是" + BOTC_AlignName(newA) + "阵营 → 不通知他。");
            }
            else {
                if (t == 15) {
                    BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是邪恶阵营。");
                    BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是邪恶阵营。");
                }
                else {
                    BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是善良阵营。");
                    BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是善良阵营。");
                }
            }
        }
    }
    // 【蛊毒（蛊雕）】：说书人手动放置 / 移除蛊毒时，身份与阵营登记缓存立即重掷。
    if (t == 198) {
        BOTC_PairClearSeat(seat);
    }
    // 【复活（哈迪寂亚）113】不是普通死亡 token：打上它 = 把该座位的死亡记录清掉并恢复一次性能力。
    if (ob == g_teller && t == 113 && g_tokOn[(((g_teller * 14) + seat) * 256) + 113]) {
        g_tokOn[(((g_teller * 14) + seat) * 256) + 112] = false;
        if (BOTC_PublicDead(seat)) {
            if (g_isNight) {
                BOTC_PmStore(g_teller, "【哈迪寂亚】已为 " + BOTC_NameStr(seat) + " 标记复活：当晚按存活处理，天亮统一公布。");
            }
            else {
                BOTC_DeathToggle(seat, 0, 0);
            }
        }
        else {
            BOTC_ClearDeath(seat);
            BOTC_RestoreOneShot(seat);
            BOTC_PmInfo(g_who[seat], "【哈迪寂亚】你复活了。");
            BOTC_PmStore(g_teller, "【哈迪寂亚】已让 " + BOTC_NameStr(seat) + " 复活（死亡记录和一次性能力已恢复）。");
        }
    }
    // 说书人手动点「死亡」那一格：只留一个死亡 token，并把死亡类型同步过来（关掉就等于复活）
    if (ob == g_teller) {
        // 【角色专属死因 token（32~41）也要走这条】（用户 2026-09-22）：以前这里只认死亡类型表里的那几格，
        //   所以「死亡（造谣者）」点上之后只亮个 token ---- 死亡记录 / 红叉 / 播报全都没有。
        if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
            if (g_tokOn[(((g_teller * 14) + seat) * 256) + t]) {
                BOTC_SyncDeathFromTok(seat, t);
                // 标的是恶魔的话：红唇女郎顶上 / 没人顶就走传位（智能随机 / 手动弹面板）；
                //   没人能接位时才判胜负（没有活着的恶魔 → 善良胜）
                if (!BOTC_DemonGoneCheck()) {
                    BOTC_CheckWin();
                }
            }
            else {
                BOTC_ClearDeath(seat);
            }
        }
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：手动打了死亡 token（或撤掉）之后，
    //   那个座位的玩家该看到【死后声称】了（撤掉就换回【声称】）。
    if (ob == g_teller) {
        BOTC_DeclareRender();
    }
    // 【疯子（38）】手动给某个座位打「被选择（疯子）」= 模拟疯子今晚的选择：
    //   写一行「疯子选择了谁」+ 智能说书时私聊告诉真恶魔（用户 2026-09-20）
    if (ob == g_teller && t == 48 && g_tokOn[(((g_teller * 14) + seat) * 256) + 48]) {
        BOTC_LunaticPickNotify(seat);
    }
    if (ob == g_teller) {
        BOTC_VizierSync();          // 中毒 / 醉酒 / 死亡 / 复活 / 换身份后立即校正维齐尔免死 token
        BOTC_SkinSourceCheck();     // 画皮来源中毒 / 醉酒 / 死亡后按昼夜处理仍在场的活尸
        BOTC_BartenderSync();       // 酒保自身失能或目标改变阵营时立即撤掉酒保醉酒
    }
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

void BOTC_TokClearAll (int ob) {
    int t;
    // 【伪造魔典】（用户 2026-11-07）：只清伪造数据。
    if (g_tokFake) {
        for (t = 0; t < 256; t += 1) {
            g_fakeTok[((g_tokWho[ob] * 256) + t)] = false;
        }
        BOTC_TokRender(ob);
        BOTC_FakeRender();
        return;
    }
    for (t = 0; t < 256; t += 1) {
        g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t] = false;
    }
    if (ob == g_teller) {
        BOTC_ClearDeath(g_tokWho[ob]);
    }
    BOTC_TokRender(ob);
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

// 【按板子抽角色】（用户 2026-09-19）：从**当前板子的角色清单**（g_boardRole）里，
//   随机挑一个「这一局还没用过、且属于某个阵营」的身份；t = 阵营（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）
//   返回 -1 = 这个板子里没有这类角色（调用方退回旧的范围抽法）
bool BOTC_IsMarionette (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    return (BOTC_SeatTrueRole(q) == 93);
}

// 【酒鬼 / 提线木偶的认知偏差角色】（用户 2026-11-03；2026-11-06 改读分类表）
//   分层：0 = 首夜信息位 / 只能发动一次技能 → g_roleInfoClass 1（一次性信息者）
//         1 = 持续信息位（小概率，且不参与「持续信息角色保底」）→ g_roleInfoClass 2
//         2 = 有夜间行动或白天能力 → g_roleInfoClass 3 / 5
//         3 = 死亡能力 / 无主动能力 / 其他镇民（最后才选）→ g_roleInfoClass 4 / 6 / 7
//         98 = 无神论者（只有小概率被选中）
//         99 = 不选（失忆者、悟道者、非镇民）
int BOTC_BiasRoleTier (int r) {
    if (r < 0 || r > 163) {
        return 99;
    }
    if (r == 73 || r == 118) {
        return 99;                                     // 失忆者、悟道者不选
    }
    if (BOTC_RoleTeam(r) != 0) {
        return 99;                                     // 认知偏差尽量是镇民，不用外来者
    }
    if (r == 83) {
        return 98;                                     // 无神论者：只有小概率出现
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;                                      // 一次性信息者
    }
    if (g_roleInfoClass[r] == 2) {
        return 1;                                      // 持续信息位（小概率）
    }
    if (g_roleInfoClass[r] == 3 || g_roleInfoClass[r] == 5) {
        return 2;                                      // 夜间行动 / 白天能力
    }
    return 3;                                          // 死亡能力 / 纯被动 / 其他镇民
}

// mode 0 = 只从本局还没用过的角色里选（酒鬼的额外身份牌）
// mode 1 = 只从本局不在场的角色里选（提线木偶的假身份）
//   认知偏差身份不得与在场角色重复（用户 2026-11-03），因此不再提供「允许重复」模式。
int BOTC_BiasRolePick (int mode, int self) {
    int i;
    int r;
    int tier;
    int pick;
    int n;
    int want;
    int ath;
    int cn;
    int[4] cnt;

    for (i = 0; i < 4; i += 1) {
        cnt[i] = 0;
    }
    ath = -1;
    cn = 0;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163 || r == self) {
            continue;
        }
        if (mode == 0 && g_scrUsed[r]) {
            continue;
        }
        if (mode == 1 && BOTC_RoleInPlay(r)) {
            continue;
        }
        tier = BOTC_BiasRoleTier(r);
        if (tier <= 3) {
            cnt[tier] = cnt[tier] + 1;
        }
        else {
            if (tier == 98) {
                cn = cn + 1;
                if (RandomInt(1, cn) == 1) {
                    ath = r;
                }
            }
        }
    }
    if (ath >= 0 && RandomInt(1, 100) <= 5) {
        return ath;                                    // 剧本里有无神论者 → 小概率作为认知偏差
    }
    want = -1;
    if (cnt[0] > 0) {
        if (cnt[1] > 0 && RandomInt(1, 100) <= 20) {
            want = 1;                                  // 有小概率改成持续信息位
        }
        else {
            want = 0;
        }
    }
    else if (cnt[1] > 0) {
        want = 1;
    }
    else if (cnt[2] > 0) {
        want = 2;
    }
    else if (cnt[3] > 0) {
        want = 3;
    }
    if (want < 0) {
        return -1;
    }
    n = 0;
    pick = -1;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163 || r == self) {
            continue;
        }
        if (mode == 0 && g_scrUsed[r]) {
            continue;
        }
        if (mode == 1 && BOTC_RoleInPlay(r)) {
            continue;
        }
        if (BOTC_BiasRoleTier(r) != want) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    return pick;
}

int BOTC_MarionetteFakeRole (int self) {
    int i;
    int r;
    int n;
    int team;
    int pick;
    pick = BOTC_BiasRolePick(1, self);                 // 先找本局不在场的镇民
    if (pick >= 0) {
        return pick;
    }
    // 【认知偏差不与在场角色重复】（用户 2026-11-03）：镇民都已在场时放宽到外来者，
    //   但依然只从「本局不在场」的角色里选；实在找不到就返回 -1，由说书人手选。
    for (team = 0; team <= 1; team += 1) {
        n = 0;
        pick = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163 || r == self) {
                continue;
            }
            if (BOTC_RoleTeam(r) != team) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick >= 0) {
            return pick;
        }
    }
    return -1;
}

bool BOTC_MarionetteCanSwap (int q) {
    int rt;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    rt = BOTC_SeatTrueRole(q);
    if (BOTC_RoleTeam(rt) != 0 && BOTC_RoleTeam(rt) != 1) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 118]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：已经是提线木偶的不换
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：悟道者（真身 118）不换 —— 换了会留下「是悟道者」140 又挂上「是提线木偶」118
    }
    return true;
}

void BOTC_MarionetteSwap (int a, int b) {
    int i;
    int ra;
    int rb;
    ra = g_mark[(g_teller * 14) + a] - 1;
    rb = g_mark[(g_teller * 14) + b] - 1;
    g_tokOn[(((g_teller * 14) + a) * 256) + 118] = false;
    BOTC_SetSeatRole(g_teller, a, rb);
    BOTC_SetSeatRole(g_who[a], a, rb);
    BOTC_SetSeatRole(g_teller, b, ra);
    BOTC_SetSeatRole(g_who[b], b, ra);
    g_tokOn[(((g_teller * 14) + b) * 256) + 118] = true;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 6] = false;
    }
    BOTC_PickRedHerring();
    BOTC_GrimRender(g_teller);
    // 【本人魔典同步】（用户 2026-11-05）：提线木偶换身份发生在游戏中途时，
    //   两个被交换的玩家也要刷新自己那份魔典，不能只刷说书人那一份。
    if (g_started) {
        BOTC_GrimRender(g_who[a]);
        BOTC_GrimRender(g_who[b]);
    }
}

void BOTC_MarionetteSync () {
    int i;
    int r;
    int dm;
    int mq;
    int nb;
    int cand;
    dm = BOTC_FindDemon();
    mq = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsMarionette(i)) {
            continue;
        }
        if (mq == 0) {
            mq = i;
        }
        r = BOTC_MarionetteFakeRole(i);
        if (r < 0) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
            BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(i) + " 找不到能当他「以为的身份」的镇民，请手动在魔典上给他选一个善良身份。");
            continue;
        }
        BOTC_SetSeatRole(g_teller, i, r);
        BOTC_SetSeatRole(g_who[i], i, r);
        g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
    }
    if (mq < 2) {
        return;
    }
    cand = 0;
    if (dm >= 2 && BOTC_RingDist(mq, dm) > 1) {
        nb = BOTC_RingNext(dm, 1);
        if (BOTC_MarionetteCanSwap(nb)) {
            cand = nb;
        }
        if (cand < 2) {
            nb = BOTC_RingNext(dm, -1);
            if (BOTC_MarionetteCanSwap(nb)) {
                cand = nb;
            }
        }
        if (cand >= 2) {
            BOTC_MarionetteSwap(mq, cand);
            mq = cand;
        }
    }
    BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(mq) + " 以为自己是「" + g_roleName[g_mark[(g_teller * 14) + mq] - 1] + "」。");
}

int BOTC_PickBoardRole (int t) {
    int i;
    int r;
    int n;
    int pick;
    bool avoid;
    n = 0;
    pick = -1;
    // 【军团局降低特定善良角色的出现概率】（用户 2026-11-06）：随机发牌抽到军团（94）时，
    //   赏金猎人（90）、酒鬼（14）、疯子（38）只有约 1/4 的概率被抽中。
    avoid = false;
    if (g_lgDealGood && (t == 0 || t == 1)) {
        avoid = true;
    }
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != t) {
            continue;
        }
        if (g_scrUsed[r]) {
            continue;
        }
        if (avoid && (r == 90 || r == 14 || r == 38)) {
            if (RandomInt(1, 4) != 1) {
                continue;
            }
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    // 候选全被跳过（剧本里只剩这几个）→ 退回正常抽法，保证一定能发牌。
    if (pick < 0 && avoid) {
        n = 0;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (g_scrUsed[r]) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
    }
    if (pick >= 0) {
        g_scrUsed[pick] = true;
    }
    return pick;
}

void BOTC_SummonerInitialSetup () {
    int i;
    int s;
    int d;
    int r;
    g_summonerPending = false;
    g_summonerDone = false;
    s = BOTC_SummonerSeat();
    if (s < 2) {
        return;
    }
    d = BOTC_FindDemon();
    if (d >= 2) {
        r = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            if (BOTC_RoleTeam(g_boardRole[(g_board * 256) + i]) == 0 && !BOTC_RoleInPlay(g_boardRole[(g_board * 256) + i])) {
                r = g_boardRole[(g_board * 256) + i];
                break;
            }
        }
        if (r >= 0 && BOTC_RoleTeam(r) == 0) {
            BOTC_SetSeatRole(g_teller, d, r);
            BOTC_SetSeatRole(g_who[d], d, r);
            BOTC_PmStore(g_teller, "【召唤师】配置调整：移除初始恶魔（" + BOTC_NameStr(d) + "），替换为镇民「" + g_roleName[r] + "」。");
        }
        else {
            BOTC_PmStore(g_teller, "【召唤师】配置调整：找不到可替换的镇民，请手动把恶魔位改成镇民。");
        }
    }
    g_summonerPending = true;
    BOTC_PmStore(g_teller, "【召唤师】当前没有初始恶魔；在第三夜成功创造恶魔之前，不会因为无恶魔直接判善良胜。");
}

// 【堤丰之首（111）】（用户 2026-10-10）：发牌时的设置
//   ① 把一个善良玩家变成爪牙（配比跟着变：善良 -1 / 爪牙 +1）；
//   ② 把所有邪恶排成**邻座**，他自己坐中间（4 个邪恶时中间有两个位，他坐偏左那个）。
//   ⚠ 座位靠 BOTC_SeatSwap 整体对调（身份 / token / 死亡 / 谁坐哪格）；排座位期间把
//     「【换座位】x ↔ y」那几条播报静音（g_arrangeQuiet），最后由这里写一行总结。
void BOTC_HfTyphonSetup () {
    int i;
    int j;
    int q;
    int s;
    int tp;
    int tpPhys;
    int n;
    int hit;
    int bestS;
    int bestHit;
    int mid;
    int r;
    int pick;
    int phys;
    int otherN;
    int[14] oth;
    int[14] othPhys;
    int[14] tg;
    tp = BOTC_SeatOfRole(111);
    if (tp < 2 || tp > 13) {
        return;
    }
    // ① 一个善良玩家 → 爪牙
    pick = 0;
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == tp) { continue; }
        if (BOTC_SeatAlign(q) != 0) { continue; }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) { continue; }     // 酒鬼不换（真身跟魔典上写的不一样）
        n = n + 1;
        if (RandomInt(1, n) == 1) { pick = q; }
    }
    if (pick >= 2) {
        r = BOTC_PickBoardRole(2);
        if (r < 0) {
            r = BOTC_PickUnused(17, 20);
        }
        BOTC_SetSeatRole(g_teller, pick, r);
        BOTC_SetSeatRole(g_who[pick], pick, r);
        BOTC_PmStore(g_teller, "【堤丰之首】发牌：把 " + BOTC_NameStr(pick) + " 变成了爪牙（" + g_roleName[r] + "）。");
    }
    // ② 邪恶邻座 + 他坐中间
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
            n = n + 1;
        }
    }
    if (n < 2) {
        return;
    }
    bestS = 0;
    bestHit = -1;
    for (s = 0; s < g_seatN; s += 1) {
        hit = 0;
        for (j = 0; j < n; j += 1) {
            q = g_seatList[(s + j) % g_seatN];
            if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
                hit = hit + 1;
            }
        }
        if (hit > bestHit) {
            bestHit = hit;
            bestS = s;
        }
    }
    for (j = 0; j < n; j += 1) {
        tg[j] = g_seatList[(bestS + j) % g_seatN];
    }
    mid = (n - 1) / 2;                 // 4 个邪恶 → 1（中间偏左那个位）；3 / 5 个 → 正中间
    // 除他以外的邪恶：按圆桌上的先后排队。⚠ 先把"人"记下来 —— 换位过程中格子会变
    otherN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == tp) { continue; }
        if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
            oth[otherN] = q;
            otherN = otherN + 1;
        }
    }
    tpPhys = g_who[tp];
    for (i = 0; i < otherN; i += 1) {
        othPhys[i] = g_who[oth[i]];
    }
    g_arrangeQuiet = true;
    j = 0;
    for (i = 0; i < n; i += 1) {
        if (i == mid) {
            phys = tpPhys;
        }
        else {
            phys = othPhys[j];
            j = j + 1;
        }
        q = BOTC_PosOf(phys);
        if (q != tg[i]) {
            BOTC_SeatSwap(tg[i], q);
        }
    }
    g_arrangeQuiet = false;
    BOTC_PmStore(g_teller, "【堤丰之首】邪恶已排成邻座（" + BOTC_NameStr(tg[0]) + " → " + BOTC_NameStr(tg[n - 1]) + "），他坐 " + BOTC_NameStr(tg[mid]) + "。");
}
// 【随机发牌 · 萌新友好角色】（用户 2026-11-03；2026-11-06 改读分类表）：
//   总场数少于 5 场的玩家优先拿到「无主动能力 / 只有首夜信息 / 只能被动触发」的善良角色。
//   镇民改读 g_roleInfoClass：1=一次性信息者、6=无主动能力者 算萌新友好
//   （死亡能力者 4 要死了才出信息、夜间/白天能力者 3/5 要主动操作，均不算）。
//   外来者维持原规则：无主动能力 / 只被动触发，且避开认知覆盖类（酒鬼 / 疯子）。
bool BOTC_RoleNewbieSafe (int r) {
    if (r < 0 || r > 163) {
        return false;
    }
    if (BOTC_RoleTeam(r) == 0) {
        return (g_roleInfoClass[r] == 1 || g_roleInfoClass[r] == 6);
    }
    if (BOTC_RoleTeam(r) != 1) {
        return false;
    }
    if (g_roleAct[r] != 0 && g_roleAct[r] != 4 && g_roleAct[r] != 5) {
        return false;
    }
    if (r == 14 || r == 38) {
        return false;
    }
    return true;
}

// 【随机发牌 · 持续信息角色】（用户 2026-11-03；2026-11-06 改读分类表）：
//   每个夜晚或每个白天都能获得一次信息的善良角色，随机发牌时尽量保证本局有 1~2 个。
//   直接读 g_roleInfoClass == 2（持续信息位），认知偏差 / 不在场身份 / 解谜大师分层同步跟随。
bool BOTC_RoleRecurringInfo (int r) {
    if (r < 0 || r > 163) {
        return false;
    }
    return (g_roleInfoClass[r] == 2);
}

// 【解谜大师（109）· 醉酒目标的优先级】（用户 2026-11-03；2026-11-06 改读分类表）：
//   0 = 一次性信息者（g_roleInfoClass == 1，含首夜信息位）
//   1 = 夜间或白天能发动技能的角色（g_roleAct 1 / 2 / 3，另外 6 = 条件性也算）
//   2 = 持续信息位（g_roleInfoClass == 2，即使它同时是每夜行动位）
//   3 = 其余（兜底）
int BOTC_DrunkTargetTier (int q) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return 3;
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;                                      // 一次性信息者优先
    }
    if (g_roleAct[r] == 1 || g_roleAct[r] == 2 || g_roleAct[r] == 3 || g_roleAct[r] == 6) {
        return 1;                                      // 夜间 / 白天能发动技能
    }
    if (g_roleInfoClass[r] == 2) {
        return 2;                                      // 持续信息位排在主动技能之后
    }
    return 3;
}

// 【随机发牌的座位权重】（用户 2026-11-06）：以前按分数取最大值，多人同时满足场次条件时
//   恶魔 / 爪牙永远落在总场数最高的那几个人身上，反复点【随机发牌】也不换人。
//   改成按场次加权随机：达到条件的玩家权重相同、随机轮换，萌新权重极低；
//   上一场不是邪恶的玩家权重 ×1.5（整数按 (w*3)/2 计算）作为软换边。
//   kind = 1 恶魔位（>=10 最高 / >=5 其次），kind = 2 爪牙位（>=5 最高）。
int BOTC_DealSeatWeight (int tot, int lastEvil, int kind) {
    int w;
    w = 1;
    if (kind == 1) {
        if (tot >= 5) {
            w = 5;
        }
        if (tot >= 10) {
            w = 20;
        }
    }
    else {
        if (tot >= 5) {
            w = 10;
        }
    }
    if (lastEvil == 0) {
        w = (w * 3) / 2;
    }
    return w;
}

// 【随机发牌的座位优先序】（用户 2026-11-03 / 2026-11-04）：
//   恶魔位优先给总场数 >= 10 的玩家，爪牙位优先给 >= 5 的玩家；上一场已经扮演邪恶的玩家尽量换边。
//   军团（94）没有单独的恶魔位，卡扎力（135）的爪牙位会被换成善良角色，这两种情况跳过对应偏好；
//   小怪宝（112）的恶魔位实际会改成爪牙，所以按爪牙偏好挑人。
void BOTC_DealSeatOrder (int demonRole) {
    int n;
    int i;
    int j;
    int best;
    int bestScore;
    int sc;
    int tmp;
    int q;
    int pid;
    int t;
    int pe;
    int take;
    int minionN;
    bank oldBk;
    int oldTotal;
    int[16] tot;
    int[16] lastEvil;

    n = g_seatN;
    for (q = 1; q <= 13; q += 1) {
        g_dealStatT[q] = 0;
    }
    if (n <= 1) {
        return;
    }
    BOTC_BankInit();
    for (i = 0; i < n; i += 1) {
        q = g_scrSeat[i];
        pid = g_who[q];
        t = 0;
        pe = 0;
        if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1) {
            oldBk = g_bank[pid];
            oldTotal = BOTC_StatsBankTotal(oldBk);
            BOTC_BankReloadFor(pid);
            if (BOTC_StatsBankTotal(g_bank[pid]) < oldTotal) {
                g_bank[pid] = oldBk;
            }
            t = BOTC_StatsOwnGet(g_bank[pid], "t");
            if (BankKeyExists(g_bank[pid], "stats", "la")) {
                if (BankValueGetAsInt(g_bank[pid], "stats", "la") != 0) {
                    pe = 1;
                }
            }
        }
        tot[i] = t;
        lastEvil[i] = pe;
        g_dealStatT[q] = t;
    }
    // 恶魔位（军团 / 小怪宝跳过）
    if (demonRole != 94 && demonRole != 112 && BOTC_RoleTeam(demonRole) == 3) {
        // 【加权随机，而不是取最高分】（用户 2026-11-06）：多人同为 10 场以上时轮流当恶魔
        bestScore = 0;
        for (i = 0; i < n; i += 1) {
            bestScore = bestScore + BOTC_DealSeatWeight(tot[i], lastEvil[i], 1);
        }
        best = 0;
        sc = RandomInt(1, bestScore);
        for (i = 0; i < n; i += 1) {
            sc = sc - BOTC_DealSeatWeight(tot[i], lastEvil[i], 1);
            if (sc <= 0) {
                best = i;
                break;
            }
        }
        tmp = g_scrSeat[0]; g_scrSeat[0] = g_scrSeat[best]; g_scrSeat[best] = tmp;
        tmp = tot[0]; tot[0] = tot[best]; tot[best] = tmp;
        tmp = lastEvil[0]; lastEvil[0] = lastEvil[best]; lastEvil[best] = tmp;
    }
    if (demonRole == 94 || demonRole == 135) {
        return;
    }
    take = 1;
    minionN = g_mcTab[n];
    if (demonRole == 112) {
        take = 0;                  // 恶魔那一格也会变成爪牙，一起参与爪牙偏好
        minionN = minionN + 1;
    }
    for (j = 0; j < minionN; j += 1) {
        // 【加权随机，而不是取最高分】（用户 2026-11-06）：多个 5 场以上的玩家轮流当爪牙
        bestScore = 0;
        for (i = take; i < n; i += 1) {
            bestScore = bestScore + BOTC_DealSeatWeight(tot[i], lastEvil[i], 2);
        }
        best = take;
        sc = RandomInt(1, bestScore);
        for (i = take; i < n; i += 1) {
            sc = sc - BOTC_DealSeatWeight(tot[i], lastEvil[i], 2);
            if (sc <= 0) {
                best = i;
                break;
            }
        }
        tmp = g_scrSeat[take]; g_scrSeat[take] = g_scrSeat[best]; g_scrSeat[best] = tmp;
        tmp = tot[take]; tot[take] = tot[best]; tot[best] = tmp;
        tmp = lastEvil[take]; lastEvil[take] = lastEvil[best]; lastEvil[best] = tmp;
        take = take + 1;
    }
}

// 随机发牌（说书人用）：按人数配比抽身份；抽到酒鬼时多抽一个镇民当他看到的身份，并打上"是酒鬼"
void BOTC_Deal () {
    int n;
    int tc;
    int oc;
    int mc;
    int i;
    int k;
    int pos;
    int s;
    int pick;
    int drunkSeat;
    int extra;
    int baron;
    int godfather;
    int demonPick;                 // 【方古（68）/ 亡骨魔（69）】：这两只恶魔要改配比
    int balloon;                   // 【气球驾驶员（72）】：这局掷到「+1」就要把他钉进场
    int balFound;                  // 【气球驾驶员（72）】：他有没有被抽进镇民池
    int lg;
    int gd;
    int rb;
    int ocG;
    int r;
    int wudSeat;                   // 【悟道者（118）】他坐在哪个格子（用户 2026-10-16）
    int wudRole;                   // 【悟道者（118）】发给他「以为」的那张外来者卡
    int q;
    int candN;
    int modOut;                    // 【外来者极端数量】有配置阶段改数量的角色
    int infCount;                  // 【持续信息角色】本局已选到的个数
    int infTarget;                 // 【持续信息角色】目标个数
    int tier;                      // 【解谜大师醉酒】目标优先级档位（用户 2026-11-03）
    int slot;
    int goodN;
    int goodSeatN;
    bool wantNew;
    bool seatNew;
    int psy;                       // 【精神病患者联动】本局是否分到了精神病患者（84）
    int hasPair;                   // 【精神病患者联动】本局是否已经有魔像（81）或罂粟种植者（86）
    int pairPick;                  // 【精神病患者联动】这次决定补哪个角色
    int[16] outR;
    int[16] goodR;
    int[16] goodSeat;

    BOTC_ResetGameVars();          // 换局：先把上一局的记录（主谋加时 / 概率 / 假死...）清干净
    g_lgDealGood = false;          // 重新发牌：上一次军团局的善良角色过滤标记先清掉
    // 【随机发牌 · 清空上一次的提示】（用户 2026-11-04 / 2026-11-06）：反复随机发牌不把说书人私聊窗刷满
    BOTC_PmDealClear(g_teller);
    g_dealConfirmed = false;       // 重新发牌：之前那次【确认发放】作废
    BOTC_GrimShareRender();        // 重新发牌时先收起上一轮的测试发送按钮
    BOTC_KickEnd();                // 【投票踢人】换局收尾：清状态 + 收起那个对话框（用户 2026-10-02）
    // 【不在场身份也要清空】（用户 2026-10-02）：上一把恶魔 / 疯子那 3 个不在场身份会留到下一把 ----
    //   注意：玩家（恶魔 / 疯子 / 食人族）手上那份**是同一个对话框按玩家渲染的**，所以除了清数据，
    //   还要把「收到过」的那几个玩家那份**刷空 + 收掉**，否则下一把还挂着旧的三格（用户报的就是这个）。
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
        g_bluffOut[i] = 0;
        g_lbluffPick[i] = 0;
        g_lbluffOut[i] = 0;
    }
    // 【最新一份也要清】（用户 2026-11-04）：上一局按玩家记下的 3 个身份不能带进下一局
    for (i = 1; i <= 13; i += 1) {
        g_bluffGiveRole[(i * 3)] = 0;
        g_bluffGiveRole[(i * 3) + 1] = 0;
        g_bluffGiveRole[(i * 3) + 2] = 0;
    }
    // ⚠【发送给所有恶魔】会一次发给好几个玩家、不记 g_bluffTarget，所以这里干脆把 2..13 全刷一遍：
    //   先把他们那份刷成空的 3 格（数据已经清了），再把面板收掉。
    for (i = 2; i <= 13; i += 1) {
        BOTC_BluffRowRender(i);
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(i), false);
        g_bluffGot[i] = false;
    }
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    g_bluffSent = false;
    g_bluffTarget = 0;
    g_bluffTargetL = 0;
    g_bluffTargetC = 0;
    g_bluffTargetP = 0;
    g_lbluffSent = false;
    g_lbluffTarget = 0;
    g_availN = 0;
    BOTC_BluffRender();                                        // 收到过不在场身份的玩家那份：刷成空的 3 格
    // 【保留右下角不在场身份面板】（用户 2026-11-05）：手动发送入口继续使用这块面板。
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟教父一样每局掷一次 50/50（+0 / +1 外来者）
    if (g_balPlusSeeded == false) {
        g_balPlus = (RandomInt(1, 2) == 1);
        g_balPlusSeeded = true;
    }
    if (g_gfPlusSeeded == false) {
        g_gfPlus = (RandomInt(1, 2) == 1);
        g_gfPlusSeeded = true;
    }
    // 【村夫（105）】（用户 2026-10-10 / 2026-11-03）：剧本卡 [+0~2 村夫] —— 每局摇一次骰子。
    //   用户 2026-11-03：尽量不要同时出现 3 名村夫 → 1 名 40% / 2 名 40% / 3 名 20%。
    if (g_villRollSeeded == false) {
        k = RandomInt(1, 100);
        if (k <= 40) {
            g_villRoll = 0;                    // 本局 1 名村夫
        }
        else if (k <= 80) {
            g_villRoll = 1;                    // 本局 2 名村夫
        }
        else {
            g_villRoll = 2;                    // 本局 3 名村夫（小概率）
        }
        g_villRollSeeded = true;
    }
    // 先按在场人数把圆桌摆好，顺便算出参与座位表（空位不会被算进来）
    BOTC_GrimRelayout();
    n = g_seatN;
    tc = g_tcTab[n];
    oc = g_ocTab[n];
    mc = g_mcTab[n];
    g_boomKeepPick = false;
    g_boomVoteOn = false;
    g_boomSeat = 0;
    g_boomResult = false;

    for (i = 2; i <= 13; i += 1) {
        g_mark[(g_teller * 14) + i] = 0;
        // 【玩家离开游戏】那条公聊提示：新一局重新记账（用户 2026-10-02）
        g_leftShown[i] = false;
        g_kickVote[i] = 0;             // 【投票踢人】的票也一起清（用户 2026-10-02）
        g_exec[i] = false;
        g_regTeam[i] = -1;
        g_regAlign[i] = -1;
        g_seatPrevAlign[i] = -1;
        g_seatPrevRole[i] = -1;
        g_claim[i] = -1;
        g_herring = 0;
        g_ftPick[i] = false;
        g_ftFirst[i] = 0;
        g_awake[i] = false;
        g_skillPicking[i] = false;
        g_limitedAsk[i] = false;
        g_poAsk[i] = false;
        g_skillRoleSel[i] = 0;
        g_boomKeep[i] = false;
        g_boomVote[i] = 0;
        g_boomCount[i] = 0;
        g_skillT1[i] = 0;
        g_skillT2[i] = 0;
        BOTC_ClearDeath(i);      // 死亡类型（夜间 / 白天 / 处决 / 恶魔杀）一起清掉
        for (k = 0; k < 256; k += 1) {          // 表已经扩到 256：新加的 token 也要清
            g_tokOn[(((g_teller * 14) + i) * 256) + k] = false;
        }
    }
    // 【说书人格的离开提示也归零】（用户 2026-11-01）：座位保留标志已在本函数开头清过
    g_leftShown[1] = false;
    // 重新发牌 = 新的一局：隔夜技能记录和「传位解锁」一起清掉
    BOTC_NightSkillReset();
    g_promoteOpen = false;
    g_nightPoison = 0;
    g_poisonFrom = 0;
    BOTC_SpyPeekEnd();      // 间谍的魔典要是还摊在看说书人那份，先换回他自己那份
    BOTC_GrimResetPerPlayer();
    g_butlerSeat = 0;
    g_butlerMaster = 0;
    BOTC_WinClose();          // 上一把的胜负横幅收掉
    g_gameOver = false;
    BOTC_MusicDropPrio(0);    // 重新发牌＝新的一局：把胜利曲那层最高优先级放开，好让选板子的音乐进来
    BOTC_PromoteHide();       // 上一把的传位面板也收掉
    BOTC_SlayAskHide();       // 上一把没答完的【猎手请求】也收掉
    BOTC_MayorClear();        // 镇长那条挂起的死亡也收掉
    for (i = 0; i <= 13; i += 1) {
        g_declarePick[i] = false;
        g_declareUsed[i] = false;      // 新一局：声称次数重新给
        g_guessKind[i] = 0;
        g_pedantGuessUsed[i] = false;
        g_puzzleGuessUsed[i] = false;
        g_guessRoleDay[i] = -1;          // 全员追忆 · 猜角色：新局重置日期戳
        g_guessRoleDone[i] = false;      // 全员追忆 · 猜角色：新局重置"已猜对"标记
        g_juggBookN[i] = 0;
        g_deadVoteUsed[i] = false;     // 新一局：死人票重新给
        g_voteWasDead[i] = false;
        g_bansheePower[i] = false;
        g_bansheeSecondNom[i] = false;
        g_psyDone[i] = false;
        g_psyDay[i] = -1;
        g_alsaOpen[i] = false;
        g_alsaDay[i] = -1;
        g_alcClaimDay[i] = 0;          // 炼金术士：新一局重新统计每日声称
        g_rascalActive[i] = false;
        g_rascalRole[i] = 0;
        g_pedantActing[i] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 171] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 173] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 174] = false;
        g_pedantDoneNight = 0;
        g_pedantInfoNight = 0;
        g_vixenSeat = 0;
        g_vixenTarget = 0;
        g_vixenInfoSent = false;
        g_vixenExecPending = false;
        g_vixenExecNight = 0;
        g_vixenDoneNight = 0;
        g_vixenMarkerState = 0;
        g_gossipDay[i] = -1;
        g_psyDeclare[i] = false;
        g_cultDeclDone[i] = false;     // 异教领袖（106）：新一局，声称次数重新给（用户 2026-10-11）
        g_damselPick[i] = false;
        g_damselDone[i] = false;
    }
    g_damselFailed = false;
    g_damselUsed = false;
    g_finalPushDone = 0;
    g_finalRepDone = false;
    g_damselSpySeen = false;
    g_damselWidowSeen = false;
    g_slayAskPsy = false;

    BOTC_HdHide();
    BOTC_DeclareRender();
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    g_deadPick = false;
    g_execUsedToday = false;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    BOTC_BigHintHide(0);       // 新一局：顺手收掉长驻提示（全场）
    for (i = 0; i < 164; i += 1) {
        g_scrUsed[i] = false;
    }

    // 参与座位洗牌（用的是真实座位号，中间有空位也不会错位）
    for (i = 0; i < n; i += 1) {
        g_scrSeat[i] = g_seatList[i];
    }
    for (i = 0; i < n; i += 1) {
        k = RandomInt(i, n - 1);
        s = g_scrSeat[i];
        g_scrSeat[i] = g_scrSeat[k];
        g_scrSeat[k] = s;
    }

    pos = 0;
    // 恶魔：从当前板子的角色清单里抽（暗流涌动 = 小恶魔；黯月初升 = 僵怖 / 普卡 / 沙巴洛斯 / 珀）
    pick = BOTC_PickBoardRole(3);
    demonPick = pick;              // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：配比要跟着改
    if (pick < 0) {
        pick = BOTC_PickUnused(21, 21);
    }
    // 【座位优先序】（用户 2026-11-03）：恶魔 / 爪牙座位按总场数和上一场阵营重新排位
    BOTC_DealSeatOrder(pick);
    g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
    pos = pos + 1;
    if (demonPick == 94) {
        g_scrUsed[93] = true;
        rb = RandomInt(0, 2);
        lg = tc + oc - rb;
        // 【军团数量上限 7】（用户 2026-11-06）：军团最多 7 名，善良角色 = 人数 - 军团数；
        //   12 人局固定 7 名军团 + 5 名善良，避免出现 8~9 名军团的极端情况。
        if (lg > 7) {
            lg = 7;
        }
        if (lg < 1) {
            lg = 1;
        }
        gd = n - lg;
        // 【善良角色里至多 1 名外来者】（用户 2026-11-06）：外来者数量只能是 0 或 1，
        //   可以整场没有外来者；gd > 1 时抽到 1 名外来者也保证至少保留 1 名镇民。
        ocG = 0;
        if (oc > 0 && gd > 1) {
            ocG = RandomInt(0, 1);
        }
        mc = 0;
        tc = gd - ocG;
        oc = ocG;
        // 【军团局降低特定善良角色出现概率】（用户 2026-11-06）：从下面两个抽取循环开始生效。
        g_lgDealGood = true;
        for (i = 1; i < lg; i += 1) {
            g_mark[(g_teller * 14) + g_scrSeat[pos]] = 95;
            pos = pos + 1;
        }
        BOTC_PmStore(g_teller, "【配比】军团在场 → 军团 " + IntToString(lg) + " 名、善良 " + IntToString(gd) + " 名（镇民 " + IntToString(tc) + " / 外来者 " + IntToString(oc) + "）。");
    }
    // 爪牙：同样按板子抽（男爵 = 20，只有暗流涌动有他）
    baron = 0;
    godfather = 0;
    for (i = 0; i < mc; i += 1) {
        pick = BOTC_PickBoardRole(2);
        if (pick < 0) {
            pick = BOTC_PickUnused(17, 20);
        }
        if (pick == 20) {
            baron = 1;
        }
        if (pick == 39) {
            godfather = 1;                   // 教父（39）：配比要 ±1 外来者
        }
        g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
        pos = pos + 1;
    }
    // 男爵能力：两名镇民替换为两名外来者
    if (baron == 1) {
        tc = tc - 2;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 2;
    }
    // 教父（39）：[-1 或 +1 外来者]（用户 2026-09-20：50/50，照男爵这套写）
    if (godfather == 1) {
        if (g_gfPlus) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
        else {
            if (oc > 1) {
                oc = oc - 1;
                tc = tc + 1;
            }
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
    }
    // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：方古 让外来者 +1、镇民 -1；亡骨魔 让外来者 -1、镇民 +1
    if (demonPick == 68) {
        tc = tc - 1;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 1;
        BOTC_PmStore(g_teller, "【配比】方古在场 → 外来者 +1、镇民 -1。");
    }
    if (demonPick == 69) {
        if (oc > 1) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】亡骨魔在场 → 外来者 -1、镇民 +1。");
    }
    if (demonPick == 154) {
        tc = tc - 1;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 1;
        BOTC_PmStore(g_teller, "【配比】饕餮在场 → 外来者 +1、镇民 -1。");
    }
    // 【赶尸人（126）】：[-1 外来者]
    if (BOTC_RoleInPlay(126)) {
        if (oc > 0) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】赶尸人在场 → 外来者 -1、镇民 +1。");
    }
    // 【小怪宝（112）】（用户 2026-10-10）：随机发牌抽到小怪宝 → **把他移除**，那一格（恶魔位）改发一个爪牙；
    //   小怪宝本人不会发到任何玩家手里（只有疯子「以为自己是小怪宝」时才可能出现在魔典上）。
    //   于是这一局没有「真身是恶魔」的玩家 —— 恶魔身份完全靠「是恶魔（小怪宝）」那枚 token（说书人自己挪）。
    if (demonPick == 112) {
        r = BOTC_PickBoardRole(2);
        if (r < 0) {
            r = BOTC_PickUnused(17, 20);
        }
        g_mark[(g_teller * 14) + g_scrSeat[0]] = r + 1;      // 恶魔那一格（第 0 个座位）改成爪牙
        demonPick = r;
        g_lmOn = true;
        BOTC_PmStore(g_teller, "【小怪宝】发牌抽到他 → 已移除：恶魔那一格改发爪牙（" + g_roleName[r] + "）。");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：他是镇民，抽牌之前定不了他会不会在场，
    //   而这局掷到「+1」就必须外来者 +1、镇民 -1（不然提示写着 +1，牌面却只有一个外来者）。
    //   所以掷到 +1 就直接把他钉进场：配比先改，抽镇民的时候再把他塞进池子。
    balloon = 0;
    if (g_balPlus) {
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            if (g_boardRole[(g_board * 256) + i] == 72) {
                balloon = 1;
            }
        }
        if (balloon == 1) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
            BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 外来者 +1、镇民 -1。");
        }
    }
    // 【哨兵（88）】（用户 2026-09-26）：被加进本局时，外来者按他选的 -1 / 0 / +1 调整
    if (g_legacyOn[88] && g_sentAdjust != 0) {
        tc = tc - g_sentAdjust;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + g_sentAdjust;
        if (oc < 0) {
            oc = 0;
        }
        if (g_sentAdjust > 0) {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 +1、镇民 -1。");
        }
        else {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 -1、镇民 +1。");
        }
    }
    // 【外来者极端数量修正】（用户 2026-11-03）：有配置阶段修改外来者数量的角色时，
    //   尽量不要出现 5 个外来者或者 0 个外来者。
    modOut = 0;
    if (baron == 1 || godfather == 1) {
        modOut = 1;
    }
    if (demonPick == 68 || demonPick == 69 || demonPick == 154) {
        modOut = 1;
    }
    if (BOTC_RoleInPlay(126)) {
        modOut = 1;
    }
    if (g_legacyOn[88] && g_sentAdjust != 0) {
        modOut = 1;
    }
    if (balloon == 1) {
        modOut = 1;
    }
    if (modOut != 0 && demonPick != 94) {
        if (oc > 4) {
            tc = tc + (oc - 4);
            oc = 4;
            BOTC_PmStore(g_teller, "【配比】外来者数量过多 → 已调整为 4 名（多出的名额改发镇民）。");
        }
        if (oc < 1 && tc > 1) {
            oc = 1;
            tc = tc - 1;
            BOTC_PmStore(g_teller, "【配比】外来者数量过少 → 已调整为 1 名（少发的镇民改为外来者）。");
        }
    }
    // 外来者：按板子抽（酒鬼 = 14）；先记进 outR，最后和镇民一起按「萌新优先」发到座位
    drunkSeat = 0;
    for (i = 0; i < oc; i += 1) {
        pick = BOTC_PickBoardRole(1);
        if (pick < 0) {
            pick = BOTC_PickUnused(13, 16);
        }
        outR[i] = pick;
    }
    // 镇民（索引0..12）
    extra = 0;
    for (i = 0; i < oc; i += 1) {
        if (outR[i] == 14) {
            extra = 1;                 // 抽到酒鬼 → 多抽一张他看到身份的镇民
        }
    }
    for (i = 0; i < tc; i += 1) {
        g_scrRole[i] = BOTC_PickBoardRole(0);
        if (g_scrRole[i] < 0) {
            g_scrRole[i] = BOTC_PickUnused(0, 12);
        }
    }
    // 军团局的善良角色已经抽完，后面的额外身份 / 配比调整不再做概率过滤。
    g_lgDealGood = false;
    // 【酒鬼的额外身份牌】（用户 2026-11-03）：优先一次性信息者 / 只能发动一次技能的角色；
    //   小概率持续信息位（不算进持续信息角色保底）；尽量避开无法试探自己的纯被动角色。
    if (extra == 1) {
        pick = BOTC_BiasRolePick(0, -1);
        if (pick >= 0) {
            g_scrRole[tc] = pick;
            g_scrUsed[pick] = true;
        }
        else {
            // 【认知偏差不与在场角色重复】（用户 2026-11-03）：从板子里挑一张本局还没用过的镇民，
            //   不能再退回「随机 0..12」而抽到已经在场的身份。
            candN = 0;
            pick = -1;
            for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
                r = g_boardRole[(g_board * 256) + i];
                if (r < 0 || r > 163) {
                    continue;
                }
                if (BOTC_RoleTeam(r) != 0) {
                    continue;
                }
                if (g_scrUsed[r]) {
                    continue;
                }
                candN = candN + 1;
                if (RandomInt(1, candN) == 1) {
                    pick = r;
                }
            }
            if (pick >= 0) {
                g_scrRole[tc] = pick;
                g_scrUsed[pick] = true;
            }
            else {
                g_scrRole[tc] = 0;
            }
        }
        if (g_scrRole[tc] == 118 || g_scrRole[tc] < 0) {
            g_scrRole[tc] = 0;                         // 认知覆盖互斥：兜底洗衣妇
            BOTC_PmStore(g_teller, "【认知覆盖】酒鬼的额外身份找不到合适的卡 → 兜底「洗衣妇」。");
        }
    }
    // 【气球驾驶员（72）】：掷到 +1 的时候他已经被钉进场了，这里把他塞进镇民池（随机顶掉一个，
    //   酒鬼那份额外身份在 g_scrRole[tc]，不动它）
    if (balloon == 1) {
        balFound = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 72) {
                balFound = 1;
            }
        }
        if (balFound == 0 && tc > 0) {
            k = RandomInt(0, tc - 1);
            if (g_scrRole[k] >= 0) {
                g_scrUsed[g_scrRole[k]] = false;
            }
            g_scrRole[k] = 72;
            g_scrUsed[72] = true;
        }
    }
    // 【村夫（105）】（用户 2026-10-10）：[+0~2 村夫] —— 本局的村夫总数 = 1 + 摇到的数（摇到 0 就只靠随机抽）。
    //   多出来的村夫顶掉一个别的镇民（跟气球驾驶员那条「钉进场」同一个做法）。
    if (BOTC_BoardHasRole(105) && g_villRoll > 0 && tc > 0) {
        k = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 105) {
                k = k + 1;
            }
        }
        k = 1 + g_villRoll - k;              // 还差几个才够
        for (i = 0; i < k; i += 1) {
            pick = RandomInt(0, tc - 1);
            if (g_scrRole[pick] == 105) {
                continue;                   // 这一格本来就是村夫
            }
            if (g_scrRole[pick] >= 0) {
                g_scrUsed[g_scrRole[pick]] = false;
            }
            g_scrRole[pick] = 105;
            g_scrUsed[105] = true;
        }
        BOTC_PmStore(g_teller, "【配比】村夫摇骰子 → +" + IntToString(g_villRoll) + " 名村夫（本局村夫共 " + IntToString(1 + g_villRoll) + " 名）。");
    }
    // 【持续信息角色保障】（用户 2026-11-03）：随机发牌时尽量保证善良阵营有 1~2 个
    //   每个夜晚 / 每个白天都能获得信息的角色；剧本里没有这类角色时自动跳过。
    infTarget = 2;
    if (tc < 2) {
        infTarget = tc;
    }
    infCount = 0;
    for (i = 0; i < tc; i += 1) {
        if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
            infCount = infCount + 1;
        }
    }
    while (infCount < infTarget) {
        pick = -1;
        candN = 0;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (!BOTC_RoleRecurringInfo(r)) {
                continue;
            }
            if (g_scrUsed[r]) {
                continue;
            }
            candN = candN + 1;
            if (RandomInt(1, candN) == 1) {
                pick = r;
            }
        }
        if (pick < 0) {
            break;                       // 剧本里没有更多能持续获得信息的角色
        }
        slot = -1;
        for (i = 0; i < tc; i += 1) {
            if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                continue;
            }
            if (g_scrRole[i] == 118) {
                continue;                // 保留悟道者，不拿它换
            }
            if (slot < 0) {
                slot = i;
            }
            else {
                if (RandomInt(1, 2) == 1) {
                    slot = i;
                }
            }
        }
        if (slot < 0) {
            break;
        }
        if (g_scrRole[slot] >= 0) {
            g_scrUsed[g_scrRole[slot]] = false;
        }
        g_scrRole[slot] = pick;
        g_scrUsed[pick] = true;
        infCount = infCount + 1;
    }
    // 【精神病患者联动】（用户 2026-11-03）：剧本里有精神病患者（84）、魔像（81）、罂粟种植者（86），
    //   且本局确实分到了精神病患者时，极大概率再补一名魔像或罂粟种植者。
    //   用户 2026-11-04：改为优先补魔像，补不进再改罂粟种植者。
    //   卡扎力（135）会把爪牙换成善良角色，这种情况跳过。
    psy = 0;
    if (g_scrUsed[84]) {
        psy = 1;
    }
    if (psy == 1 && demonPick != 135) {
        hasPair = 0;
        for (i = 0; i < oc; i += 1) {
            if (outR[i] == 81) {
                hasPair = 1;
            }
        }
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 86) {
                hasPair = 1;
            }
        }
        if (hasPair == 0 && RandomInt(1, 100) <= 85) {
            pairPick = -1;
            slot = -1;
            // 先试魔像：有外来者位就顶外来者（尽量避开酒鬼 14）；没有外来者位就把一个镇民改成魔像
            if (BOTC_BoardHasRole(81) && !g_scrUsed[81]) {
                slot = -1;
                if (oc > 0) {
                    for (i = 0; i < oc; i += 1) {
                        if (outR[i] == 14) {
                            continue;
                        }
                        if (slot < 0) {
                            slot = i;
                        }
                        else {
                            if (RandomInt(1, 2) == 1) {
                                slot = i;
                            }
                        }
                    }
                    if (slot < 0) {
                        slot = RandomInt(0, oc - 1);
                    }
                    pairPick = 81;
                }
                else {
                    for (i = 0; i < tc; i += 1) {
                        if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                            continue;
                        }
                        if (g_scrRole[i] == 118) {
                            continue;
                        }
                        if (slot < 0) {
                            slot = i;
                        }
                        else {
                            if (RandomInt(1, 2) == 1) {
                                slot = i;
                            }
                        }
                    }
                    if (slot >= 0) {
                        pairPick = 81;
                    }
                }
            }
            // 再试罂粟种植者：顶掉一个非「持续信息」镇民（不动悟道者 118）
            if (pairPick < 0 && BOTC_BoardHasRole(86) && !g_scrUsed[86] && tc > 0) {
                slot = -1;
                for (i = 0; i < tc; i += 1) {
                    if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                        continue;
                    }
                    if (g_scrRole[i] == 118) {
                        continue;
                    }
                    if (slot < 0) {
                        slot = i;
                    }
                    else {
                        if (RandomInt(1, 2) == 1) {
                            slot = i;
                        }
                    }
                }
                if (slot >= 0) {
                    pairPick = 86;
                }
            }
            if (pairPick == 86) {
                if (g_scrRole[slot] >= 0) {
                    g_scrUsed[g_scrRole[slot]] = false;
                }
                g_scrRole[slot] = 86;
                g_scrUsed[86] = true;
                BOTC_PmStore(g_teller, "【配比】有精神病患者 → 同时加入「罂粟种植者」。");
            }
            else {
                if (pairPick == 81) {
                    if (oc > 0) {
                        if (outR[slot] >= 0 && outR[slot] != 14) {
                            g_scrUsed[outR[slot]] = false;
                        }
                        outR[slot] = 81;
                    }
                    else {
                        if (g_scrRole[slot] >= 0) {
                            g_scrUsed[g_scrRole[slot]] = false;
                        }
                        g_scrRole[slot] = 81;
                    }
                    g_scrUsed[81] = true;
                    BOTC_PmStore(g_teller, "【配比】有精神病患者 → 同时加入「魔像」。");
                }
            }
        }
    }
    // ---- 把善良角色发到座位上（用户 2026-11-03）----
    //   总场数 < 5 的玩家优先拿「无主动能力 / 只有首夜信息 / 被动触发」的安全角色；
    //   其余角色随机分配，不改变剧本配比。
    goodN = 0;
    for (i = 0; i < oc; i += 1) {
        goodR[goodN] = outR[i];
        goodN = goodN + 1;
    }
    for (i = 0; i < tc; i += 1) {
        goodR[goodN] = g_scrRole[i];
        goodN = goodN + 1;
    }
    goodSeatN = 0;
    for (i = pos; i < n; i += 1) {
        goodSeat[goodSeatN] = g_scrSeat[i];
        goodSeatN = goodSeatN + 1;
    }
    for (i = goodN - 1; i > 0; i -= 1) {
        k = RandomInt(0, i);
        pick = goodR[i]; goodR[i] = goodR[k]; goodR[k] = pick;
    }
    for (i = goodSeatN - 1; i > 0; i -= 1) {
        k = RandomInt(0, i);
        pick = goodSeat[i]; goodSeat[i] = goodSeat[k]; goodSeat[k] = pick;
    }
    drunkSeat = 0;
    for (i = 0; i < goodN; i += 1) {
        pick = -1;
        candN = 0;
        wantNew = BOTC_RoleNewbieSafe(goodR[i]);
        for (k = 0; k < goodSeatN; k += 1) {
            q = goodSeat[k];
            if (q < 2) {
                continue;
            }
            seatNew = (g_dealStatT[q] < 5);
            if ((wantNew && seatNew) || ((!wantNew) && (!seatNew))) {
                candN = candN + 1;
                if (RandomInt(1, candN) == 1) {
                    pick = k;
                }
            }
        }
        if (pick < 0) {
            candN = 0;
            for (k = 0; k < goodSeatN; k += 1) {
                q = goodSeat[k];
                if (q < 2) {
                    continue;
                }
                candN = candN + 1;
                if (RandomInt(1, candN) == 1) {
                    pick = k;
                }
            }
        }
        if (pick < 0) {
            break;
        }
        q = goodSeat[pick];
        g_mark[(g_teller * 14) + q] = goodR[i] + 1;
        if (goodR[i] == 14) {
            drunkSeat = q;
        }
        goodSeat[pick] = 0;
    }
    if (extra == 1 && drunkSeat >= 2) {
        g_mark[(g_teller * 14) + drunkSeat] = g_scrRole[tc] + 1;
        g_tokOn[(((g_teller * 14) + drunkSeat) * 256) + 8] = true;
        // 【酒鬼也来一条】（用户 2026-10-16）：认知覆盖那几个里只有酒鬼没有这行提示，写法跟提线木偶 / 悟道者一致
        BOTC_PmStore(g_teller, "【酒鬼】" + BOTC_NameStr(drunkSeat) + " 以为自己是「" + g_roleName[g_scrRole[tc]] + "」。");
    }
    // 【悟道者（118）】（用户 2026-10-16 第二次修）：跟酒鬼**镜像** ----
    //   酒鬼 = 外来者 + 多抽一张镇民；悟道者 = 镇民 + 多抽一张**外来者**卡。
    //   ⚠ 必须在**上面那圈「把镇民写进魔典」的循环之后**才跑 ---- 上一版插在它前面，
    //     被那圈循环（把 g_scrRole[i] = 118 写回那一格）覆盖掉了，魔典上还是「悟道者」+ 一枚「是悟道者」token。
    //   ⚠ 那张外来者卡**不能是认知覆盖类**（酒鬼 14 / 疯子 38）---- 用户 2026-10-16 + 百科。
    wudSeat = 0;
    wudRole = -1;
    for (i = pos; i < n; i += 1) {
        q = g_scrSeat[i];
        if (g_mark[(g_teller * 14) + q] == 119) {
            wudSeat = q;                                      // 已经发到座位上的悟道者（118 + 1）
        }
    }
    if (wudSeat >= 2) {
        for (k = 0; k < 64; k += 1) {
            pick = BOTC_PickBoardRole(1);
            if (pick < 0) {
                break;
            }
            if (pick == 14 || pick == 38) {
                continue;                                     // 认知覆盖类不能当（换下一个）
            }
            wudRole = pick;
            break;
        }
        if (wudRole < 0) {
            wudRole = BOTC_PickUnused(13, 16);
            if (wudRole == 14 || wudRole == 38) {
                wudRole = 15;                                 // 兜底：陌客
            }
        }
        if (wudRole < 0) {
            wudRole = 15;
        }
        g_mark[(g_teller * 14) + wudSeat] = wudRole + 1;
        g_tokOn[(((g_teller * 14) + wudSeat) * 256) + 140] = true;
        BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(wudSeat) + " 以为自己是「" + g_roleName[wudRole] + "」。");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：掷到 +0 那次，他真在场就说明一句（+1 那次上面改配比时已经提示过）
    if (g_balPlus == false && BOTC_RoleInPlay(72)) {
        BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 镇民不变。");
    }
    // 疯子（38）：延续酒鬼那套写法 ---- 魔典上写「他以为自己是」的那只恶魔（本局真恶魔那只），
    //   真相靠「是疯子」token(49)；他每夜要选几个人按那只恶魔的选人数算。
    for (i = 2; i <= 13; i += 1) {
        if (g_mark[(g_teller * 14) + i] - 1 != 38) {
            continue;
        }
        r = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_mark[(g_teller * 14) + k] - 1 >= 0 && BOTC_RoleTeam(g_mark[(g_teller * 14) + k] - 1) == 3) {
                r = g_mark[(g_teller * 14) + k] - 1;
            }
        }
        if (r > 0) {
            g_mark[(g_teller * 14) + i] = r + 1;                   // 让他以为自己是那只恶魔
            if (g_roleTargets[r] > 0) {
                g_roleTargets[38] = g_roleTargets[r];
            }
            else {
                g_roleTargets[38] = 1;
            }
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(i) + " 以为自己是「" + g_roleName[r] + "」。");
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 49] = true;        // 是疯子
    }
    // 【卡扎力（135）】随机发牌设置：把原有爪牙牌换成不在场的善良角色；首夜自动唤醒后只私聊。
    BOTC_KazaliCompositionApply();
    BOTC_SummonerInitialSetup();
    // 随机配板收尾：占卜师在场就自动指定干扰项
    BOTC_PickRedHerring();
    // 茶艺师（32）：角色一写进魔典就把「不会死亡（茶艺师）」刷出来（用户 2026-09-20：随机发放时也要有）
    BOTC_SailorSync();
    BOTC_TeaLadySync();
    BOTC_FoolSync();
    // 伪装口供：**不自动安排**（用户要求），只提醒邪恶玩家自己挑
    BOTC_ClaimHint();
    // 无神论者（83）在场：本局没有邪恶角色（爪牙 / 恶魔的座位换成不在场的善良角色）
    if (BOTC_AtheistOn()) {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            r = BOTC_SeatTrueRole(i);
            if (BOTC_RoleTeam(r) == 2 || BOTC_RoleTeam(r) == 3) {
                r = BOTC_PickBoardGood();
                if (r > 0) {
                    BOTC_SetSeatRole(g_teller, i, r);
                    BOTC_SetSeatRole(g_who[i], i, r);
                }
            }
        }
        BOTC_PmStore(g_teller, "【无神论者】在场：爪牙和恶魔的座位已换成不在场的善良角色（本局没有邪恶）。");
    }
    // 巡山人（77）在场：必定有一个外来者是落难少女（82）
    if (BOTC_RoleInPlay(77) && !BOTC_RoleInPlay(82)) {
        r = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 1) {
                // 【酒鬼例外】（用户 2026-11-01）：酒鬼的席位不能变成落难少女，
                //   否则会同时留下「酒鬼」token 和多抽的镇民卡 → 出现「酒鬼落难少女」。
                // 【疯子例外】（用户 2026-11-06）：疯子同理。发牌还没正式开始，BOTC_SetSeatRole
                //   不会收掉旧身份 token，换完会留下「是疯子」token → 出现「落难少女带疯子 token」。
                if (BOTC_SeatTrueRole(i) == 14 || BOTC_SeatTrueRole(i) == 38 || BOTC_ProtectTokOn(i, 8) || BOTC_ProtectTokOn(i, 49)) {
                    continue;
                }
                r = i;
                break;
            }
        }
        if (r >= 2) {
            BOTC_SetSeatRole(g_teller, r, 82);
            BOTC_SetSeatRole(g_who[r], r, 82);
            BOTC_PmStore(g_teller, "【巡山人】在场：外来者的座位（" + BOTC_NameStr(r) + "）已换成落难少女。");
        }
        else {
            BOTC_PmStore(g_teller, "【巡山人】在场：外来者里只有酒鬼 / 疯子，本局不加入落难少女。");
        }
    }
    // 【半兽人（107）· 失足】/【解谜大师（109）· 醉酒】（用户 2026-10-10）：**随机发身份**时就打上，
    //   而且是在候选座位里**随机抽一个**（用户 2026-10-10 报「总是落在最前面那两格」→ 原来的写法是"挑第一个"）。
    if (BOTC_RoleInPlay(107)) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_SeatTrueRole(i) == 107) { continue; }
            n = n + 1;
        }
        pick = 0;
        if (n > 0) {
            k = RandomInt(1, n);
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatAlign(i) != 0) { continue; }
                if (BOTC_SeatTrueRole(i) == 107) { continue; }
                k = k - 1;
                if (k <= 0) { pick = i; break; }
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 127] = true;
            BOTC_PmStore(g_teller, "【半兽人】失足标记：" + BOTC_NameStr(pick));
        }
    }
    if (BOTC_RoleInPlay(109)) {
        // 【醉酒目标按优先级挑】（用户 2026-11-03）：首夜信息位 → 夜间 / 白天能发动技能 →
        //   持续信息位 → 其余善良玩家兜底；每一档内部仍然随机。
        pick = 0;
        for (tier = 0; tier <= 3; tier += 1) {
            n = 0;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatTeam(i) != 0) { continue; }
                if (BOTC_DrunkTargetTier(i) != tier) { continue; }
                n = n + 1;
            }
            if (n > 0) {
                k = RandomInt(1, n);
                for (i = 2; i <= 13; i += 1) {
                    if (!g_seatOn[i]) { continue; }
                    if (BOTC_SeatTeam(i) != 0) { continue; }
                    if (BOTC_DrunkTargetTier(i) != tier) { continue; }
                    k = k - 1;
                    if (k <= 0) { pick = i; break; }
                }
            }
            if (pick >= 2) {
                break;                         // 这一档已经选到，不再往下一档降级
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 129] = true;
            BOTC_PmStore(g_teller, "【解谜大师】醉酒标记：" + BOTC_NameStr(pick));
        }
    }
    // 唱诗男孩（108）在场：一个镇民换成国王（104）—— 照上面「巡山人 → 落难少女」那条写法
    if (BOTC_RoleInPlay(108) && !BOTC_RoleInPlay(104)) {
        r = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_HasAbility(i, 108)) { continue; }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 0) { r = i; break; }
        }
        if (r >= 2) {
            BOTC_SetSeatRole(g_teller, r, 104);
            BOTC_SetSeatRole(g_who[r], r, 104);
            BOTC_PmStore(g_teller, "【唱诗男孩】在场：镇民的座位（" + BOTC_NameStr(r) + "）已换成国王。");
        }
    }
    // 【堤丰之首（111）】（用户 2026-10-10）：发牌设置 —— 一个善良变爪牙 + 邪恶排成邻座、他坐中间
    if (BOTC_RoleInPlay(111)) {
        BOTC_HfTyphonSetup();
    }
    BOTC_MarionetteSync();
    // 【暴风捕手（113）】（用户 2026-10-11）：发完牌就给「保护的身份」打上免死标记 + 播报一次
    BOTC_StormSync();
    BOTC_BartenderSetup();         // 酒保：配板完成后随机指定一名合法的邻近善良玩家醉酒
    BOTC_DxeSetup();               // 店小二（115）：随机发牌后放好熟客 / 醉酒（用户 2026-11-06）
    // 重新发牌后清掉旧的死亡红叉，所有人的魔典都刷新一遍
    for (i = 1; i <= 13; i += 1) {
        BOTC_GrimRender(g_who[i]);
    }
}

// 确认发放：其他玩家自己的魔典里，只会自动填上"自己座位"的身份（token 不发）
void BOTC_ConfirmDeal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    BOTC_SummonerInitialSetup();
    BOTC_XaanSetupSync();          // 【限】初始外来者数量在确认发放的这一刻锁定
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        // 【按「格子」发，不按玩家号】（用户 2026-10-18 报「换说书人之后老说书人没收到身份」）：
        //   老说书人现在是玩家 1、坐在别的格子；原来从玩家 2 开始循环，永远轮不到他。
        // 【每个人那份只留自己那一格】（用户 2026-10-18 报「座位4的玩家能看到座位3的身份」）：
        //   以前只写「自己那一格」，别的格子里上一把 / 复盘留下的字不清 → 会露出别人的身份。
        ob = g_who[q];
        for (t = 0; t <= 13; t += 1) {
            if (t == q) {
                g_mark[(ob * 14) + t] = BOTC_AmnesiaMaskRole(g_mark[(g_teller * 14) + t] - 1) + 1;
            }
            else {
                g_mark[(ob * 14) + t] = 0;
            }
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
        BOTC_GrimRender(ob);
    }
    // 【精神病患者（84）的猜拳标记】（用户 2026-11-03）：发牌后默认打在场上精神病患者身上。
    //   必须在上面按玩家清 token 之后调用，避免被那一轮清空覆盖。
    BOTC_PsyRpsSync();
    // 身份发下去之后，邪恶角色那边才会出现【伪装身份】按钮
    BOTC_ClaimBtnRender();
    BOTC_FoolSync();               // 弄臣（34）：发完牌就先把「首次未死」标记打上（用户 2026-09-20）
    BOTC_SailorSync();
    BOTC_TeaLadySync();            // 茶艺师（32）：发完牌也刷一次「不会死亡（茶艺师）」标记
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21）：跟茶艺师一样 ---- 身份一发下去（入场）就把常驻效果打上，
    //   不等天亮 / 入夜。诺-达鲺：与他相邻的两名镇民中毒；涡流：镇民身上「信息错误（涡流）」。
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_StormSync();              // 【暴风捕手】发放身份时再同步一次免死标记（用户 2026-10-11）
    g_dealConfirmed = true;        // 记下「这一轮发牌确认过了」：正式开始时要用它校验
    g_swapUnlocked = false;        // 重新确认发放 → 再次锁上【换座位】（用户 2026-10-07）
    BOTC_SwapCancelAll();          // 【撤回所有人在选的换座位】（用户 2026-10-11）
    BOTC_BsBtnRender();            // 【发完牌立刻收掉【换座位】按钮】（用户 2026-10-07）
    BOTC_NoticeBox(g_teller, "已确认发放身份");
    // 【发放之后自动弹「游戏帮助」】（用户 2026-09-20）：让每个玩家立刻看到自己的角色能力
    //   【按坐的格子找人】（用户 2026-10-18）：换说书人之后玩家 1 也是玩家，别漏掉他
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        g_tipForce[g_who[q]] = -1;       // 发牌自动弹的这一份必须显示「你自己的角色」，别被谁在能力表点过的详情锁住（用户 2026-09-30）
        BOTC_TipOpen(g_who[q]);
    }
    BOTC_GrimShareRender();        // 确认发放后立即刷新说书人的测试发送按钮
}

//--------------------------------------------------------------------------------------------------
// 不在场身份（右下角面板）
//--------------------------------------------------------------------------------------------------
// 找被发了恶魔（小恶魔 = 索引21，存 22）的座位
//   小恶魔自刀传位之后会有两个座位都写着小恶魔：优先返回还活着的那一个
int BOTC_FindDemon () {
    int q;
    int fallback;
    fallback = 0;
    for (q = 2; q <= 13; q += 1) {
        // 【按阵营找恶魔】（用户 2026-09-19）：以前写死「小恶魔」，现在任何恶魔身份都算
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            if (fallback == 0) {
                fallback = q;
            }
            if (!BOTC_PublicDead(q)) {
                return q;
            }
        }
    }
    return fallback;
}

// who = 给谁刷新面板（说书人=1 / 恶魔玩家）
void BOTC_BluffRowRender (int who) {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_bluffPick[i];
        if (v > 0) {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
        else {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], "botc_blank.dds", PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(""), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
    }
}

void BOTC_BluffRender () {
    BOTC_BluffRowRender(g_teller);
    // 【发送目标按钮文案】（用户 2026-11-06）：剧本含告密者(92) 或 疯子(38) 时，按钮改为打开目标选择弹窗；
    //   两者都没有时仍是原来的一键【发送给所有恶魔】。
    if (BOTC_BoardHasRole(92) || BOTC_BoardHasRole(38)) {
        libNtve_gf_SetDialogItemText(g_bluffSendAllBtn, StringToText("发送给特定玩家"), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_bluffSendAllBtn, StringToText("发送给所有恶魔"), PlayerGroupAll());
    }
}

//==================================================================================================
// 【疯子（38）的第二套不在场身份】（用户 2026-09-20）：
//   跟恶魔那套同一个右下角锚点、往上一格（y=252），按钮叫【随机 3 个（疯子）】【发送给疯子】；
//   抽的池子 = **当前板子里的镇民 / 外来者**且本局不在场；**有 25% 概率掺一个假的**（其实在场）。
//==================================================================================================
bool BOTC_BoardHasRole (int r) {
    int i;
    int b;
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        if (g_boardRole[(b * 256) + i] == r) {
            return true;
        }
    }
    return false;
}

void BOTC_LBluffRowRender (int who) {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_lbluffPick[i];
        if (v > 0) {
            libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
        else {
            libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], "botc_blank.dds", PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(""), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
    }
}

void BOTC_LBluffRender () {
    if (g_lbluffSent && g_lbluffTarget >= 2) {
        BOTC_LBluffRowRender(g_who[g_lbluffTarget]);
    }
    BOTC_LBluffRowRender(g_teller);
}

void BOTC_LBluffOpenPick (int ob, int slot) {
    g_pickMode[ob] = 1;
    g_pickBluffSlot[ob] = slot;
    g_pickBluffL = true;
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("不在场身份（疯子）" + IntToString(slot + 1) + " / 3"), PlayerGroupSingle(ob));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(ob), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_LBluffRoll () {
    int i;
    int r;
    int n;
    int pick;
    int nPool;
    int[64] pool;
    for (i = 0; i < 3; i += 1) {
        g_lbluffPick[i] = 0;
    }
    nPool = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_BoardHasRole(r)) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            continue;
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        pool[nPool] = r;
        nPool = nPool + 1;
    }
    for (i = 0; i < 3; i += 1) {
        if (nPool <= 0) {
            break;
        }
        pick = RandomInt(0, nPool - 1);
        g_lbluffPick[i] = pool[pick] + 1;
        pool[pick] = pool[nPool - 1];
        nPool = nPool - 1;
    }
    // 25% 概率掺一个「假的」（其实在场的身份）
    if (RandomInt(1, 100) <= 25) {
        n = 0;
        pick = 0;
        for (r = 0; r <= 163; r += 1) {
            if (!BOTC_BoardHasRole(r)) {
                continue;
            }
            if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
                continue;
            }
            if (!BOTC_RoleInPlay(r)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick > 0) {
            g_lbluffPick[RandomInt(0, 2)] = pick + 1;
            BOTC_PmStore(g_teller, "【疯子】给他的不在场身份里掺了一个假的（其实在场：" + g_roleName[pick] + "）。");
        }
    }
    BOTC_LBluffRender();
}

void BOTC_LBluffSend () {
    int i;
    int lu;
    lu = BOTC_RealLunaticSeat();
    if (lu < 2) {
        BOTC_Notice(g_teller, "场上没有疯子（38）：先发牌或手动把某个座位摆成疯子。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_lbluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个（疯子）】）。");
            return;
        }
    }
    if (g_lbluffSent && g_lbluffTarget >= 2 && g_lbluffTarget != lu) {
        DialogSetVisible(g_lbluffDlg, PlayerGroupSingle(g_who[g_lbluffTarget]), false);
    }
    g_lbluffTarget = lu;
    for (i = 0; i < 3; i += 1) {
        g_lbluffOut[i] = g_lbluffPick[i];
        g_bluffGiveRole[(g_who[lu] * 3) + i] = g_lbluffPick[i];
    }
    g_lbluffSent = true;
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], BOTC_IconName(g_lbluffOut[i] - 1), PlayerGroupSingle(g_who[lu]));
        libNtve_gf_SetDialogItemText(g_lbluffName[i], StringToText(g_roleName[g_lbluffOut[i] - 1]), PlayerGroupSingle(g_who[lu]));
    }
    // 【最新一份覆盖旧的】（用户 2026-11-04）：收起恶魔那份，并清掉换位后的恢复标记
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_who[lu]), false);
    g_bluffGot[g_who[lu]] = false;
    DialogSetVisible(g_lbluffDlg, PlayerGroupSingle(g_who[lu]), true);
    BOTC_PmStore(g_teller, "【不在场身份】已发给 " + BOTC_NameStr(lu) + "：" + BOTC_BluffRoleNames(g_lbluffPick[0], g_lbluffPick[1], g_lbluffPick[2]) + "（疯子面板）。");
    BOTC_Notice(g_who[lu], "说书人给了你 3 个不在场身份（你是恶魔嘛），看右下角面板。");
}

void BOTC_BuildLBluff () {
    int i;
    int x;
    DialogCreate(396, 209, c_anchorBottomRight, 0, 332, false);   // 上面那块加高了，这套跟着往上挪
    g_lbluffDlg = DialogLastCreated();
    DialogSetVisible(g_lbluffDlg, PlayerGroupAll(), false);
    BOTC_NewLabel(g_lbluffDlg, 378, 26, 9, 4, StringToText("不在场身份（疯子）"));
    for (i = 0; i < 3; i += 1) {
        x = 14 + (i * 126);
        g_lbluffSeat[i] = BOTC_NewButton(g_lbluffDlg, 112, 112, x, 32, "");
        libNtve_gf_CreateDialogItemImage(g_lbluffDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_lbluffIcon[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_lbluffIcon[i], PlayerGroupAll(), c_anchorTopLeft, x - 7, 27);
        libNtve_gf_SetDialogItemAcceptMouse(g_lbluffIcon[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_lbluffIcon[i], "botc_blank.dds", PlayerGroupAll());
        g_lbluffName[i] = BOTC_NewLabel(g_lbluffDlg, 112, 26, x, 119, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_lbluffName[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_lbluffName[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_lbluffSeat[i], PlayerGroupSingle(g_teller), true);
    }
    g_lbluffRollBtn = BOTC_NewButton(g_lbluffDlg, 175, 36, 14, 151, "随机 3 个（疯子）");
    g_lbluffSendBtn = BOTC_NewButton(g_lbluffDlg, 175, 36, 207, 151, "发送给疯子");
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_lbluffSendBtn, PlayerGroupSingle(g_teller), true);
    g_lbluffSent = false;
    g_lbluffTarget = 0;
    for (i = 0; i < 3; i += 1) {
        g_lbluffPick[i] = 0;
        g_lbluffOut[i] = 0;
    }
    BOTC_LBluffRender();
}

// 随机抽 3 个不在场身份：只从好身份（镇民 + 外来者）里抽，并避开魔典里已经选过的
// 这个身份算不算「受限的伪装」：**一次性信息者**（洗衣妇 / 图书管理员 / 调查员 / 厨师 / 祖母...）
//   或者**外来者**（管家 / 酒鬼 / 陌客 / 圣徒）。
//   给恶魔的 3 个伪装里，这一类**最多只出现 1 个**（两个池都够抽的时候）。
//   ⚠ 分类按随机发牌同款 g_roleInfoClass == 1；共情者 / 占卜师是**持续信息位**，不算在内。
bool BOTC_BluffRestricted (int idx) {
    if (idx < 0 || idx > 163) {
        return false;
    }
    if (BOTC_RoleTeam(idx) == 1) {
        return true;                   // 外来者（黯月初升也一样：修补匠 / 月之子 / 莽夫 / 疯子）
    }
    if (g_roleInfoClass[idx] == 1 && BOTC_RoleAlign(idx) == 0) {
        return true;                   // 一次性信息者：只有一次信息产出的善良角色
    }
    return false;
}

void BOTC_BluffRoll () {
    int b;
    int r;
    int i;
    int n;
    int k;
    int t;
    int idx;
    int best;
    int bestTier;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
    }
    // 【随机不在场身份的分层规则】（用户 2026-11-06）：镇民改读游戏内镇民分类 g_roleInfoClass，
    //   与随机发牌 / 认知偏差共用同一张表，不再按 g_roleAct 硬编码：
    //   0 = 持续信息位（最优先）；1 = 夜间能力 / 白天能力；
    //   2 = 一次性信息 / 死亡能力 / 无主动能力 / 其他镇民；3 = 外来者（最后兜底，尽量少选）。
    n = 0;
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            continue;                  // 只从镇民 / 外来者里抽
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 1) {
            t = 3;                     // 外来者：最后兜底
        }
        else {
            if (g_roleInfoClass[r] == 2) {
                t = 0;                 // 持续信息位
            }
            else {
                if (g_roleInfoClass[r] == 3 || g_roleInfoClass[r] == 5) {
                    t = 1;             // 夜间能力 / 白天能力
                }
                else {
                    t = 2;             // 一次性信息 / 死亡能力 / 无主动能力 / 其他镇民
                }
            }
        }
        g_bfA[n] = r + 1;
        g_bfB[n] = t;
        n = n + 1;
    }
    // 同一优先级内部随机：先整体洗牌，再按优先级从低到高取满 3 个
    for (k = n - 1; k > 0; k -= 1) {
        idx = RandomInt(0, k);
        t = g_bfA[k];
        g_bfA[k] = g_bfA[idx];
        g_bfA[idx] = t;
        t = g_bfB[k];
        g_bfB[k] = g_bfB[idx];
        g_bfB[idx] = t;
    }
    for (i = 0; i < 3; i += 1) {
        best = -1;
        bestTier = 9;
        for (k = 0; k < n; k += 1) {
            if (g_bfA[k] <= 0) {
                continue;
            }
            if (g_bfB[k] < bestTier) {
                bestTier = g_bfB[k];
                best = k;
            }
        }
        if (best < 0) {
            break;
        }
        g_bluffPick[i] = g_bfA[best];
        g_bfA[best] = 0;               // 取走，不再重复
    }
    BOTC_BluffRender();
}

void BOTC_BluffOpenPick (int ob, int slot) {
    g_pickMode[ob] = 1;
    g_pickBluffSlot[ob] = slot;
    g_pickBluffL = false;         // 这一套是「给恶魔」的
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("不在场身份 " + IntToString(slot + 1) + " / 3"), PlayerGroupSingle(ob));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(ob), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_BluffSend () {
    int dm;
    int i;
    dm = BOTC_FindDemon();
    if (dm == 0) {
        BOTC_Notice(g_teller, "还没确定恶魔：先在魔典里随机发牌，或手动把某个座位选成小恶魔。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTarget = dm;
    for (i = 0; i < 3; i += 1) {
        g_bluffOut[i] = g_bluffPick[i];
    }
    g_bluffSent = true;
    BOTC_BluffGiveTo(dm, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

// 【发送给疯子】（用户 2026-09-20）：把这次挑好的 3 个「不在场身份」发给**带着「是疯子」token（49）**的那个座位 ----
//   ⚠ 判据是 token，不是真身：手动摆两个恶魔、再给其中一个打「是疯子」的玩法也照样能用。
//   面板用的是同一块（图标 / 文字本来就是「每个玩家各看各的」），所以直接给他设一份就行。
void BOTC_BluffSendToLunatic () {
    int i;
    int lu;
    lu = BOTC_RealLunaticSeat();         // 带「是疯子」但不是哲学家的那一个（用户 2026-09-21）
    if (lu < 2) {
        BOTC_NoticeBox(g_teller, "没找到「疯子」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTargetL = lu;
    BOTC_BluffGiveTo(lu, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

// 【发送给疯子（哲学家）】（用户 2026-09-21）：发给身上同时带「是哲学家(70)」+「是疯子(49)」的那个座位。
//   只发这 3 个不在场身份，**不发爪牙**（新恶魔本来就不知道场上的爪牙有谁）。
void BOTC_BluffSendToPhiloLunatic () {
    int i;
    int lu;
    lu = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] && g_tokOn[(((g_teller * 14) + i) * 256) + 49]) {
            lu = i;
        }
    }
    if (lu < 2) {
        BOTC_Notice(g_teller, "没找到[哲学家疯子]。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTargetP = lu;
    BOTC_BluffGiveTo(lu, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

bool BOTC_BountyTrigger () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!g_tokOn[(((g_teller * 14) + i) * 256) + 114]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            return true;
        }
    }
    return false;
}

bool BOTC_LegionOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == 94) {
            return true;
        }
    }
    return false;
}
bool BOTC_LegionLunatic () {
    int q;
    q = BOTC_RealLunaticSeat();
    if (q < 2) {
        return false;
    }
    return (g_mark[(g_teller * 14) + q] - 1 == 94);
}

// 【军团 · 首夜互认】（用户 2026-11-02）：不再标队友，改为向每名真军团私聊
//   本局所有善良玩家的座位号。若场上同时有魔术师，按相克规则从名单中排除魔术师。
//   「以为自己是军团」的疯子不自动发送，改由说书人手动填写善良玩家。
int BOTC_LegionMarkFor (int who, int hide1, int hide2) {
    int i;
    int mag;
    int q;
    int n;
    int w;
    n = 0;
    if (who < 2 || who > 13) {
        return 0;
    }
    w = who * 14;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == BOTC_PosOf(who)) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) != 94) {
            continue;
        }
        if (q == hide1 || q == hide2) {
            continue;
        }
        g_mark[w + q] = 95;                 // 95 = 军团（94）+ 1
        n = n + 1;
    }
    // 相克：军团互认时把魔术师也标成军团，并私聊告知军团玩家「魔术师在场」。
    mag = BOTC_MagicianSeatNow();
    if (mag >= 2 && mag != BOTC_PosOf(who)) {
        if (g_mark[w + mag] != 95) {
            g_mark[w + mag] = 95;
            n = n + 1;
        }
        BOTC_PmInfo(who, "【信息】魔术师在场，他也被标成军团。");
        BOTC_PmStore(g_teller, "【军团×魔术师相克】已在 " + BOTC_NameStr(BOTC_PosOf(who)) + " 的魔典上把 " + BOTC_NameStr(mag) + " 标成军团，并私聊告知魔术师在场。");
    }
    BOTC_GrimRender(who);
    // 私聊跟魔典同一时刻（用户 2026-09-30）：只说「标好了」，不列名字
    if (n > 0) {
        BOTC_PmStore(who, "【军团】已在魔典上标记所有军团。");
    }
    else {
        BOTC_PmStore(who, "【军团】你的魔典上没有标出其他军团。");
    }
    return n;
}

// 假军团（疯子）那一份：按说书人填的两个座位屏蔽（0 = 不屏蔽）
void BOTC_LegionLunaticApply (int hide1, int hide2) {
    int i;
    int q;
    int lu;
    string s;
    g_lgPend = false;             // 框已经答完了（确定 / 取消都走这里）
    lu = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) == 94) {
            continue;
        }
        if (g_mark[(g_teller * 14) + q] - 1 != 94) {
            continue;
        }
        lu = q;
    }
    if (lu < 2) {
        return;
    }
    BOTC_LegionMarkFor(g_who[lu], hide1, hide2);
    s = "";
    if (hide1 >= 2) {
        s = BOTC_NameStr(hide1);
    }
    if (hide2 >= 2) {
        if (StringLength(s) > 0) {
            s = s + "、";
        }
        s = s + BOTC_NameStr(hide2);
    }
    if (StringLength(s) <= 0) {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上标了全部军团（没有屏蔽）。");
    }
    else {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上屏蔽了：" + s + "。");
    }
    // 那个答题框是共用的：军团这步把按钮文字改成了「确认」，用完必须还原
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
}

// 首夜互认主入口：向所有军团发送善良玩家座位号。
bool BOTC_LegionRecognize () {
    int i;
    int q;
    int n;
    int mag;
    int goodN;
    string s;
    string msg;
    bool fakeLegion;
    n = 0;
    goodN = 0;
    s = "";
    mag = BOTC_MagicianSeatNow();
    if (!BOTC_LegionOn()) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || BOTC_SeatAlign(q) != 0) {
            continue;
        }
        if (mag >= 2 && q == mag) {
            continue;                       // 军团 × 魔术师：军团得知的是非魔术师的善良玩家
        }
        if (goodN > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(q);
        goodN = goodN + 1;
    }
    if (goodN > 0) {
        msg = "【信息】你得知所有善良玩家：" + s + "。";
    }
    else {
        msg = "【信息】你得知没有善良玩家。";
    }
    fakeLegion = BOTC_LegionLunatic();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) != 94) {
            continue;
        }
        BOTC_PmInfo(g_who[q], msg);
        BOTC_PmStore(g_teller, "【军团】已发给 " + BOTC_NameStr(q) + "：" + msg);
        n = n + 1;
    }
    if (n <= 0) {
        return false;
    }
    if (mag >= 2) {
        BOTC_PmStore(g_teller, "【军团×魔术师】军团名单已排除 " + BOTC_NameStr(mag) + "。");
    }
    BOTC_PmStore(g_teller, "【军团】首夜互认完成：已向 " + IntToString(n) + " 名军团发送全部善良玩家座位。");
    if (fakeLegion) {
        g_lgPend = true;
        BOTC_ManInfoOpenSeats(BOTC_RealLunaticSeat(), "【军团】疯子以为自己是军团：手动填 1~4 名善良玩家；点【取消】= 不发送", 19);
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定"), PlayerGroupSingle(g_teller));
        return true;
    }
    return false;
}

// 【快捷发送互认】（用户 2026-11-04）：一键让除了提线木偶以外的恶魔和爪牙互认。
//   军团局：在每名军团的魔典上标出其他军团，并私聊提醒。
//   普通局：逐人私聊「谁是恶魔 / 谁是其他爪牙」；魔术师按原有相克口径混入敌方名单。
void BOTC_QuickRecognize () {
    int i;
    int j;
    int q;
    int r;
    int rteam;
    int team;
    int mag;
    int dn;
    int mn;
    int evilN;
    int trueDemonN;
    int marks;
    int demonN;
    int minionN;
    bool legion;
    string sd;
    string sm;
    string msg;
    string mm;
    int mN;
    BOTC_BuildSeatList();
    mag = BOTC_MagicianSeatNow();
    legion = BOTC_LegionOn();
    evilN = 0;
    // 【提线木偶】（93）：恶魔需要额外得知哪名玩家是提线木偶（魔术师在场时按相克口径不泄露）。
    mm = "";
    mN = 0;
    if (mag == 0) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q < 2 || q > 13 || !g_seatOn[q]) {
                continue;
            }
            if (!BOTC_IsMarionette(q)) {
                continue;
            }
            if (mN > 0) {
                mm = mm + ",";
            }
            mm = mm + BOTC_NameStr(q);
            mN = mN + 1;
        }
    }
    // 【军团】（94）：不发送善良玩家名单，只在每名军团自己的魔典上标出其他军团。
    if (legion) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q < 2 || q > 13 || !g_seatOn[q]) {
                continue;
            }
            if (BOTC_SeatTrueRole(q) != 94) {
                continue;
            }
            marks = BOTC_LegionMarkFor(g_who[q], 0, 0);
            if (marks > 0) {
                BOTC_PmInfo(g_who[q], "【信息】快捷互认：已在你的魔典上标出所有军团。");
            }
            evilN = evilN + 1;
        }
        if (evilN > 0) {
            BOTC_PmStore(g_teller, "【快捷互认】军团局：已在 " + IntToString(evilN) + " 名军团的魔典上标出其他军团，并私聊提醒。");
        }
        else {
            BOTC_PmStore(g_teller, "【快捷互认】军团局：场上没有可标记的军团。");
        }
    }
    demonN = 0;
    minionN = 0;
    // 【没有真恶魔时不要泄露】（与首夜邪恶信息同口径）：召唤师待召唤 / 小怪宝等场合直接跳过。
    trueDemonN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || !g_seatOn[q]) {
            continue;
        }
        if (BOTC_IsMarionette(q)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            trueDemonN = trueDemonN + 1;
        }
    }
    if (!legion && trueDemonN <= 0) {
        BOTC_PmStore(g_teller, "【快捷互认】场上没有真恶魔：已跳过，避免泄露「无恶魔」信息。");
        return;
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || !g_seatOn[q]) {
            continue;
        }
        if (BOTC_IsMarionette(q)) {
            continue;                       // 提线木偶不参与互认
        }
        if (legion && BOTC_SeatTrueRole(q) == 94) {
            continue;                       // 军团已在上面单独处理
        }
        team = BOTC_RoleTeam(BOTC_SeatTrueRole(q));
        if (team != 2 && team != 3) {
            continue;
        }
        sd = "";
        sm = "";
        dn = 0;
        mn = 0;
        for (j = 0; j < g_seatN; j += 1) {
            r = g_seatList[j];
            if (r < 2 || r > 13 || r == q || !g_seatOn[r]) {
                continue;
            }
            if (BOTC_IsMarionette(r)) {
                continue;                   // 提线木偶不写进任何人的互认名单
            }
            if (r == mag) {
                // 魔术师按相克口径混在敌方名单：恶魔看他是爪牙，爪牙看他是恶魔。
                if (team == 3) {
                    if (mn > 0) { sm = sm + ","; }
                    sm = sm + BOTC_NameStr(r);
                    mn = mn + 1;
                }
                else {
                    if (dn > 0) { sd = sd + ","; }
                    sd = sd + BOTC_NameStr(r);
                    dn = dn + 1;
                }
                continue;
            }
            rteam = BOTC_RoleTeam(BOTC_SeatTrueRole(r));
            if (rteam == 3) {
                if (dn > 0) { sd = sd + ","; }
                sd = sd + BOTC_NameStr(r);
                dn = dn + 1;
            }
            else if (rteam == 2) {
                if (mn > 0) { sm = sm + ","; }
                sm = sm + BOTC_NameStr(r);
                mn = mn + 1;
            }
        }
        if (team == 3) {
            if (mn > 0) {
                msg = "【信息】你得知" + sm + "是爪牙。";
            }
            else {
                msg = "【信息】你得知本局没有其他爪牙。";
            }
            if (dn > 0) {
                msg = msg + "其他恶魔：" + sd + "。";
            }
            if (mN > 0) {
                msg = msg + "提线木偶：" + mm + "。";
            }
            demonN = demonN + 1;
        }
        else {
            if (dn > 0) {
                msg = "【信息】你得知" + sd + "是恶魔。";
            }
            else {
                msg = "【信息】你得知场上没有其他恶魔。";
            }
            if (mn > 0) {
                msg = msg + "爪牙：" + sm + "。";
            }
            else {
                msg = msg + "本局没有其他爪牙。";
            }
            minionN = minionN + 1;
        }
        BOTC_PmInfo(g_who[q], msg);
        BOTC_PmStore(g_teller, "【快捷互认】已发给 " + BOTC_NameStr(q) + "：" + msg);
    }
    if (demonN + minionN <= 0) {
        if (legion && evilN > 0) {
            BOTC_PmStore(g_teller, "【快捷互认】完成：军团标记已完成（提线木偶已排除）。");
        }
        else {
            BOTC_PmStore(g_teller, "【快捷互认】场上没有可互认的恶魔或爪牙。");
        }
        return;
    }
    BOTC_PmStore(g_teller, "【快捷互认】完成：已向 " + IntToString(demonN) + " 名恶魔、" + IntToString(minionN) + " 名爪牙发送互认信息（提线木偶已排除）。");
}

// 【发送互认】入口：先让说书人点收件人，随后打开手动填写面板。
// 互认内容只使用面板中填写的 2 个恶魔 / 5 个爪牙，不再自动识别或弹出疯子互认框。
void BOTC_SendRecognize () {
    g_specMode = 5;
    g_specTo = 0;
    g_recogTo = 0;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_Notice(g_teller, "【发送互认】点一名玩家的座位作为收件人。");
}

// 【军团】疯子填写善良玩家框还没答完 → true = 这次唤醒先别走
bool BOTC_LegionPendBlock () {
    if (!g_lgPend) {
        return false;
    }
    if (g_miRole == 41 && (g_miKind == 9 || g_miKind == 19)) {
        BOTC_Notice(g_teller, "先把军团那个「疯子善良玩家」框处理掉：点【确定】或【取消】。");
        return true;
    }
    g_lgPend = false;
    BOTC_NotifyDemonsLunatic();
    return false;
}

// 真人说书答题框点「取消」：只有军团那一步需要收尾（不屏蔽，疯子看到所有队友）
void BOTC_MiCancelApply () {
    int seat;
    if (g_miRole == 156) {
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 815) {
        g_halfPick = false;
        g_halfBy = 0;
        g_halfSlot = 0;
        g_halfOriginal = 0;
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 814) {
        g_wardenAsk = false;
        g_wardenAskBy = 0;
        g_wardenCandN = 0;
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 813) {
        seat = g_miSeat;
        BOTC_GudiaoAnswer(seat, false);
        return;
    }
    if (g_miRole == 811) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_EnvoyAnswer(false);
        return;
    }
    if (g_miRole == 812) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_BrokerAnswer(false);
        return;
    }
    // 【店小二（115）】（用户 2026-11-06）：确认框点取消 = 不直接告知熟客 / 醉酒，改为手动填两名
    if (g_miRole == 41 && g_miKind == 22) {
        seat = g_miSeat;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_DxeManualOpen(seat);
        return;
    }
    // 【疯子附加信息 / 假军团填写】（15 / 16 / 17 / 18 / 19）：点取消 = 这次不发送。
    if (g_miRole == 41 && (g_miKind == 15 || g_miKind == 16 || g_miKind == 17 || g_miKind == 18 || g_miKind == 19)) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        g_lgPend = false;
        BOTC_PmStore(g_teller, "【信息】已取消本次附加信息，不向该玩家发送。");
        return;
    }
    // 【疯子假爪牙】点取消 = 这次什么都不发，可用于罂粟种植者局手动控制疯子是否知情。
    if (g_miRole == 41 && g_miKind == 0) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_PmStore(g_teller, "【疯子】已取消本次爪牙信息，不向疯子发送任何内容。");
        return;
    }
    // 【二选一醉酒】（用户 2026-10-16）：点取消 = 这次谁也不醉（只有中毒/酒鬼那次才给取消键）
    //   【店小二移醉酒】（用户 2026-11-06）：必须选两名玩家之一，点取消 / X 不生效，重新弹出面板。
    if (g_miRole == 807) {
        if (g_dkKind == 3) {
            BOTC_Notice(g_teller, "必须把「醉酒」标记移到这两名玩家之一。");
            BOTC_DrunkPickOpen(3, g_dkFrom, g_dkA, g_dkB);
            return;
        }
        g_miRole = -1;
        g_dkKind = 0;
        g_dkFrom = 0;
        g_dkA = 0;
        g_dkB = 0;
        return;
    }
    // 【发送特定信息】（用户 2026-10-10）：取消 = 退出「点收件人」模式（不然下一次点座位又会弹框）
    if (g_miRole == 801 || g_miRole == 802 || g_miRole == 803 || g_miRole == 808) {
        g_specMode = 0;
        g_specTo = 0;
        g_miSeat = 0;
        g_miRole = -1;
    }
    if (g_miRole == 41 && g_miKind == 9) {
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(0, 0);
        BOTC_NotifyDemonsLunatic();
    }
    // 【半兽人（107）】那个「让不让他杀」的框点取消 = 不杀（恶魔正常出刀）
    if (g_miRole == 805) {
        g_lycanTgt = 0;
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmStore(g_teller, "【半兽人】这次不杀 → 恶魔正常出刀。");
    }
}

bool BOTC_LegionVoteVoid () {
    int i;
    int n;
    if (!BOTC_LegionOn()) {
        return false;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_vote[i] != 1) {
            continue;
        }
        if (BOTC_WinAlignOf(i) == 0) {
            return false;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return false;
    }
    return true;
}

// 【发送给所有恶魔】（用户 2026-09-30）：一键把 3 个不在场身份发给**所有恶魔**（军团局省事）。
//   跳过身上带「是疯子(49)」或「是哲学家(70)」token 的座位（认知覆盖的假恶魔，不该收），
//   也跳过真身是提线木偶的座位。
void BOTC_BluffSendToDemons () {
    int i;
    int q;
    int r;
    int n;
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 3) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 49] || g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "没有符合条件的恶魔（带「是疯子」或「是哲学家」的会跳过）。");
    }
    else {
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + IntToString(n) + " 名恶魔（逐条记录见上）。");
    }
}

void BOTC_BluffSendToMinions () {
    int q;
    int r;
    int n;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 2) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffRoll();
        BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "场上没有爪牙（提线木偶不算）。");
        return;
    }
    BOTC_PmStore(g_teller, "【不在场身份】已分别发给 " + IntToString(n) + " 名爪牙（逐条记录见上）。");
}

// 【发送给所有爪牙】（用户 2026-11-06）：把面板上已选的 3 个身份统一发给所有爪牙，
//   不重新随机；提线木偶（真身 93）不算。
void BOTC_BluffSendToAllMinions () {
    int i;
