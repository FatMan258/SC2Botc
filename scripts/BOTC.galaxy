//--------------------------------------------------------------------------------------------------
// 记录区
//--------------------------------------------------------------------------------------------------
void BOTC_PubAnnounce (string s) {
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 【预着色系统公告】（用户 2026-11-11）：整行已经自带 <c val="..."> 颜色，
//   不再走 BOTC_KeyColor 的关键词自动上色（否则玩家战网名里碰巧有「邪恶」「善良」
//   这类词会被染成阵营色）。渲染仍按系统行整体刷 BDB76B，内层颜色保留。
//   who = -1 标记「系统行，但跳过关键词上色」。
void BOTC_PubAnnouncePlain (string s) {
    int bak;
    bak = g_chatWhoNow;
    g_chatWhoNow = -1;
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
    g_chatWhoNow = bak;
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 【长公告换行】（用户 2026-11-03；2026-11-07 改为按可见宽度）：公聊每行都是固定高度，
//   太长会被裁成省略号。跟 BOTC_PubSay 共用 BOTC_WrapCut：
//   首行容量 = 公聊内容区宽度 − head 的可见宽度，续行不重复 head、按 head 宽度缩进对齐。
void BOTC_PubAnnounceWrap (string head, string msg) {
    int n;
    int pos;
    int end;
    int prefW;
    int cap;
    bool first;
    string part;
    n = StringLength(msg);
    if (n <= 0) {
        BOTC_PubLine(head);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_NameSubst(head));
        return;
    }
    prefW = BOTC_TextWidth(head);
    cap = BOTC_ChatWrapWidthPub() - prefW;
    if (cap < 12) { cap = 12; }
    pos = 1;
    first = true;
    while (pos <= n) {
        pos = BOTC_WrapSkipSpace(msg, pos, n);
        if (pos > n) { break; }
        end = BOTC_WrapCut(msg, pos, cap, n);
        part = StringSub(msg, pos, end);
        if (first) {
            BOTC_PubLine(head + part);
            first = false;
        }
        else {
            BOTC_PubLine(BOTC_Spaces(prefW) + part);
        }
        pos = end + 1;
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_NameSubst(head + msg));
}

// 【调试总开关】测试播报：只有 g_debugOn 为真才播（关掉之后公聊就是干净的正式局样子）
void BOTC_Ann (string s) {
    if (!g_debugOn) {
        return;
    }
    BOTC_PubAnnounce(s);
}

// 【调试总开关】诊断日志：只有 g_debugOn 为真才往私聊日志写
void BOTC_DiagStore (int p, string s) {
    if (!g_debugOn) {
        return;
    }
    BOTC_PmStore(p, s);
}

// 只往公聊日志里存一行：不写常驻聊天窗、不播字幕（时段分隔标记用这个）
void BOTC_PubLogStore (string s) {
    int i;
    int p;
    int spk;
    bool rolled;
    rolled = false;
    spk = 0;
    // 【屏蔽】（用户 2026-11-06）：公聊行记住说话人，屏蔽他的玩家不再收到这一行。
    if (g_chatWhoNow >= 1 && g_chatWhoNow <= 13) {
        spk = g_who[g_chatWhoNow];
    }
    if (g_pubLogCount >= 2400) {
        rolled = true;
        for (i = 0; i < 2399; i += 1) {
            g_pubLog[i] = g_pubLog[i + 1];
            g_pubWho[i] = g_pubWho[i + 1];
            g_pubSeq[i] = g_pubSeq[i + 1];
        }
        g_pubLog[2399] = s;
        g_pubWho[2399] = g_chatWhoNow;
        g_pubSeq[2399] = g_pubSeqN;
    }
    else {
        g_pubLog[g_pubLogCount] = s;
        g_pubWho[g_pubLogCount] = g_chatWhoNow;
        g_pubSeq[g_pubLogCount] = g_pubSeqN;
        g_pubLogCount = g_pubLogCount + 1;
    }
    g_pubSeqN = g_pubSeqN + 1;
    // 正开着【日志 → 公聊记录】的人：立刻把这一行接上去（**不自动滚到最新**，用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        if (spk > 0 && BOTC_Blocked(p, spk)) {
            continue;
        }
        if (g_logLiveUpdate && g_logOpen[p] && (g_logMode[p] == 0 || g_logMode[p] == 3)) {
            if (g_logMode[p] == 3) {
                // 【系统消息】页签（用户 2026-09-30）：只接系统行，而且**追加**、不整段重画
                //   （以前走 BOTC_LogRender 整段重画，列表会跳回最上面；跟公聊记录一样只追加就好）
                if (g_chatWhoNow <= 0) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, g_chatWhoNow));
                }
            }
            else if (g_logViewWho[p] > 0) {
                // 【看某玩家】（用户 2026-10-04 报「带滚轮的聊天框经常间歇性自己消失」）：
                //   以前这里一有新消息就 BOTC_LogRender 整段重画（RemoveAllItems + 全部重新加一遍），
                //   列表会瞬间空一下再填回来 —— 看起来就是聊天框自己消失。现在改成**只判断这一行要不要接**：
                //   他说的 / 天数时段分隔标记 → 追加；别人说的 → 这一行本来也不该显示，直接不动。
                if (BOTC_IsPeriodMark(s) || g_chatWhoNow == g_logViewWho[p]) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, g_chatWhoNow));
                }
            }
            else {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, g_chatWhoNow));
            }
        }
    }
}

// 这一行是不是「时段分隔标记」（---- 第1天 ---- / ---- 本局板子：XXX ---- 这种）
bool BOTC_IsPeriodMark (string s) {
    return StringFind(s, "----", false) >= 0;
}

void BOTC_PubLine (string s) {
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
}

// 【起名播报不加座位号】（用户 2026-11-13）：整行就是玩家填写的名字，
//   不走「玩家N」占位替换、也不按说话人着色，避免播报里冒出座位号或换错名字。
void BOTC_PubLinePlain (string s) {
    int bak;
    bak = g_chatWhoNow;
    g_chatWhoNow = -1;
    BOTC_ChatShowAll(s);
    BOTC_PubLogStore(s);
    g_chatWhoNow = bak;
}

// 当前时段的文字：第N夜 / 第N天 / 准备阶段
string BOTC_PeriodStr () {
    if (g_nightNum <= 0 && g_dayNum <= 0) {
        return "准备阶段";
    }
    if (g_isNight) {
        return "第" + IntToString(g_nightNum) + "夜";
    }
    return "第" + IntToString(g_dayNum) + "天";
}

// 时段分隔标记：公聊日志 + 每个玩家的私聊日志 + 投票统计日志各写一行
void BOTC_PeriodRecord (string s) {
    int p;
    g_chatWhoNow = 0;              // 分隔标记不属于任何人：不加名字前缀，也不会被当成某个人的发言
    BOTC_AllPmStore(s, 0);         // 【全部私聊】（2026-11-09）：时段分隔标记也留一份
    BOTC_RpAdd(s);                 // 【复盘】（用户 2026-11-11）：过程记录按夜晚 / 白天分段
    BOTC_PubLogStore(s);
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmStore(p, s);
    }
    BOTC_VoteLogAdd(s);
}

// 投票统计日志：每条提名一行（时段分隔标记也走这里）
void BOTC_VoteLogAdd (string s) {
    int i;
    int p;
    bool rolled;
    rolled = false;
    if (g_voteLogCount >= 600) {
        rolled = true;
        for (i = 0; i < 599; i += 1) {
            g_voteLog[i] = g_voteLog[i + 1];
        }
        g_voteLog[599] = s;
    }
    else {
        g_voteLog[g_voteLogCount] = s;
        g_voteLogCount = g_voteLogCount + 1;
    }
    // 正开着【日志 → 投票统计】的人：立刻接上这一行（用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        if (g_logLiveUpdate && g_logOpen[p] && g_logMode[p] == 2) {
            if (rolled) {
                DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, 0));   // 投票统计：名字也换成真名
        }
    }
}

// 我现在这条私聊里的"对面那位"：忽略说书人（1）——
//   2 人私聊 = 对方；说书人介入的 3 人私聊 = 那名玩家；不在私聊里 = 0
int BOTC_PmWithMe (int p) {
    int s;
    int i;
    int who;
    who = 0;
    s = g_mySess[p];
    if (s < 1 || s > 13) {
        return 0;
    }
    for (i = 2; i <= 13; i += 1) {
        if (i != p && g_member[(s * 14) + i]) {
            who = i;
        }
    }
    return who;
}

// 【剧本以外禁用私聊】（用户 2026-11-13）：选剧本页 / 取名页 / 自定义剧本页没有可用的私聊界面，
//   这几个页面关闭私聊频道：不能切到私聊模式，原本发进私聊的系统信息统一改发公聊。
bool BOTC_PmOff () {
    if (g_boardOpen) {
        return true;
    }
    if (g_introOn) {
        return true;
    }
    return false;
}

void BOTC_PmStoreRaw (int p, string s) {
    int i;
    int w;
    bool rolled;
    rolled = false;
    // 【坐标统一】（用户 2026-10-07）：g_pmWith 要跟 g_pmWho / g_logViewWho 一样存**格子**，
    //   而 BOTC_PmWithMe 返回的是【对面那位】的**物理座位**（g_member / g_mySess 都按座位存）→ 这里先转成格子。
    w = BOTC_PosOf(BOTC_PmWithMe(p));
    if (g_pmLogCount[p] >= 600) {
        rolled = true;
        for (i = 0; i < 599; i += 1) {
            g_pmLog[(p * 600) + i] = g_pmLog[(p * 600) + i + 1];
            g_pmWho[(p * 600) + i] = g_pmWho[(p * 600) + i + 1];
            g_pmWith[(p * 600) + i] = g_pmWith[(p * 600) + i + 1];
            g_pmBoxOnly[(p * 600) + i] = g_pmBoxOnly[(p * 600) + i + 1];
        }
        g_pmLog[(p * 600) + 599] = s;
        g_pmWho[(p * 600) + 599] = g_chatWhoNow;
        g_pmWith[(p * 600) + 599] = w;
        g_pmBoxOnly[(p * 600) + 599] = g_pmBoxOnlyNow;
    }
    else {
        g_pmLog[(p * 600) + g_pmLogCount[p]] = s;
        g_pmWho[(p * 600) + g_pmLogCount[p]] = g_chatWhoNow;
        g_pmWith[(p * 600) + g_pmLogCount[p]] = w;
        g_pmBoxOnly[(p * 600) + g_pmLogCount[p]] = g_pmBoxOnlyNow;
        g_pmLogCount[p] = g_pmLogCount[p] + 1;
    }
    // 他正开着【日志 → 我的私聊】：立刻把这一行接上去（**不自动滚到最新**，用户 2026-09-19）
    if (g_logLiveUpdate && g_logOpen[p] && (g_logMode[p] == 1 || g_logMode[p] == 3)) {
        if (g_logMode[p] == 3) {
            // 【系统消息】页签（用户 2026-09-30）：只接系统行，而且是**追加**、不整段重画
            if (g_chatWhoNow == 0 && !g_pmBoxOnlyNow) {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, 0));
            }
        }
        else if (g_logViewWho[p] > 0) {
            // 【看某玩家】（用户 2026-10-04）：同公聊那一路，别再整段重画（会让聊天框闪一下）。
            //   只接「跟他这段对话有关的行」：他说的 / 我说的且这行是跟他聊的 / 天数时段分隔标记；
            //   另外「只进私聊框、不进日志」的行照旧不接（用户 2026-09-30）。
            if (!g_pmBoxOnlyNow) {
                if (BOTC_IsPeriodMark(s) || g_chatWhoNow == g_logViewWho[p] || (g_chatWhoNow == BOTC_PosOf(p) && w == g_logViewWho[p])) {
                    if (rolled) {
                        DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                    }
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, g_chatWhoNow));
                }
            }
        }
        else {
            // 【只进私聊框、不进日志】的行（用户 2026-09-30）：日志正开着也不接上去
            if (!g_pmBoxOnlyNow) {
                if (rolled) {
                    DialogControlRemoveItem(g_logList, PlayerGroupSingle(p), 0);
                }
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, g_chatWhoNow));
            }
        }
    }
    BOTC_PmBoxRender(p);
}

// 【私聊自动换行】（用户 2026-11-03；2026-11-07 改为按可见宽度）：私聊框和日志的每行都是固定高度
//   的标签，太长会被裁成省略号。跟公聊共用 BOTC_WrapCut：
//   · 有「[私聊] @@1NN@@：」说话人前缀时，首行容量 = 私聊内容区宽度 − 前缀宽度；
//   · 续行不重复前缀，按前缀宽度缩进对齐；没有前缀的系统消息按整行宽度切。
void BOTC_PmStore (int p, string s) {
    int n;
    int pos;
    int end;
    int pref;
    int prefW;
    int cap;
    string part;
    // 【剧本以外 · 系统信息走公聊】（用户 2026-11-13）：私聊频道在选板 / 取名 / 自定义剧本页面不开放
    if (BOTC_PmOff()) {
        BOTC_PubAnnounce(s);
        return;
    }
    n = StringLength(s);
    if (n <= 0) {
        BOTC_PmStoreRaw(p, s);
        return;
    }
    cap = BOTC_ChatWrapWidthPm();
    pref = BOTC_PrefixEnd(s, n);
    prefW = 0;
    if (pref > 0) {
        prefW = BOTC_TextWidth(StringSub(s, 1, pref));
        cap = BOTC_ChatWrapWidthPm() - prefW;
        if (cap < 12) { cap = 12; }
    }
    pos = BOTC_WrapSkipSpace(s, pref + 1, n);
    if (pos > n) {
        BOTC_PmStoreRaw(p, s);
        return;
    }
    end = BOTC_WrapCut(s, pos, cap, n);
    if (pref > 0) {
        if (pos == pref + 1) {
            BOTC_PmStoreRaw(p, StringSub(s, 1, end));
        }
        else {
            BOTC_PmStoreRaw(p, StringSub(s, 1, pref) + StringSub(s, pos, end));
        }
    }
    else {
        BOTC_PmStoreRaw(p, StringSub(s, pos, end));
    }
    pos = end + 1;
    while (pos <= n) {
        pos = BOTC_WrapSkipSpace(s, pos, n);
        if (pos > n) { break; }
        end = BOTC_WrapCut(s, pos, cap, n);
        part = StringSub(s, pos, end);
        BOTC_PmStoreRaw(p, BOTC_Spaces(prefW) + part);
        pos = end + 1;
    }
}

// 【全部私聊 · 存档】（2026-11-09）：每条私聊消息只在发送处调用一次，存的是没拆行的原文；
//   拆行留给 BOTC_LogWrapAdd 在渲染时按当前容器宽度做，避免同一句话被多个收件人重复存档。
void BOTC_AllPmStore (string s, int sess) {
    BOTC_AllPmStoreTo(s, sess, 0);
}

// 【全部私聊 · 带额外参与者】（2026-11-11）：申请 / 邀请事件发生时对方还没进房间，
//   把 extra 也标进这条事件的成员快照，【查看某玩家】时才看得到与自己相关的申请 / 邀请。
void BOTC_AllPmStoreTo (string s, int sess, int extra) {
    int i;
    int p;
    int idx;
    idx = 0;
    if (StringLength(s) <= 0) {
        return;
    }
    if (g_allPmCount >= 1000) {
        for (i = 0; i < 999; i += 1) {
            g_allPmLog[i] = g_allPmLog[i + 1];
            g_allPmWho[i] = g_allPmWho[i + 1];
            for (p = 1; p <= 13; p += 1) {
                g_allPmIn[(i * 14) + p] = g_allPmIn[((i + 1) * 14) + p];
            }
        }
        g_allPmLog[999] = s;
        g_allPmWho[999] = g_chatWhoNow;
        idx = 999;
        for (p = 1; p <= 13; p += 1) {
            g_allPmIn[(999 * 14) + p] = false;
        }
        if (sess >= 1) {
            for (p = 1; p <= 13; p += 1) {
                if (g_member[(sess * 14) + p]) {
                    // 【坐标统一】（2026-11-10）：跟【查看某玩家】的格子口径一致，存格子而不是物理座位，
                    //   换座位后也能正确过滤。
                    g_allPmIn[(999 * 14) + BOTC_PosOf(p)] = true;
                }
            }
        }
        if (extra >= 1 && extra <= 13) {
            g_allPmIn[(999 * 14) + BOTC_PosOf(extra)] = true;
        }
    }
    else {
        idx = g_allPmCount;
        g_allPmLog[g_allPmCount] = s;
        g_allPmWho[g_allPmCount] = g_chatWhoNow;
        for (p = 1; p <= 13; p += 1) {
            g_allPmIn[(g_allPmCount * 14) + p] = false;
        }
        if (sess >= 1) {
            for (p = 1; p <= 13; p += 1) {
                if (g_member[(sess * 14) + p]) {
                    g_allPmIn[(g_allPmCount * 14) + BOTC_PosOf(p)] = true;
                }
            }
        }
        if (extra >= 1 && extra <= 13) {
            g_allPmIn[(g_allPmCount * 14) + BOTC_PosOf(extra)] = true;
        }
        g_allPmCount = g_allPmCount + 1;
    }
    // 【实时更新】（用户 2026-11-10）：说书人正开着【日志 → 全部私聊】时立刻接上这一条；
    //   只追加、不整段重画，滚动条位置不会被拉回顶部。筛选口径与 BOTC_LogRender 的模式 4 一致。
    if (g_logLiveUpdate && g_logOpen[g_teller] && g_logMode[g_teller] == 4) {
        if (g_logViewWho[g_teller] <= 0 || BOTC_IsPeriodMark(s) || g_allPmIn[(idx * 14) + g_logViewWho[g_teller]]) {
            BOTC_LogWrapAdd(g_teller, s, g_chatWhoNow);
        }
    }
}

// 【全部私聊 · 房间事件】（2026-11-10）：把建立 / 加入 / 退出 / 房主变更 / 解散写成一条系统行，
//   只进说书人的【全部私聊】。成员快照决定【查看某玩家】时这条事件算不算“他在场”，
//   所以退出 / 解散事件必须在清掉 g_member 之前调用。
void BOTC_SessLogEvent (int s, string s2) {
    int bak;
    if (s < 1 || s > 13) {
        return;
    }
    bak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_AllPmStore(s2, s);
    g_chatWhoNow = bak;
}

// 【全部私聊 · 申请 / 邀请事件】（2026-11-11）：申请人 / 被邀请人还没进房间，
//   用 extra 把他一并算进这条事件的成员快照，说书人【查看某玩家】时也能看到。
void BOTC_SessLogEventTo (int s, string s2, int extra) {
    int bak;
    if (s < 1 || s > 13) {
        return;
    }
    bak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_AllPmStoreTo(s2, s, extra);
    g_chatWhoNow = bak;
}

// 房间成员名字（用格子占位名，渲染时换成真实座位名）；skipP = 排除某个物理座位。
string BOTC_SessMembersText (int s, int skipP) {
    string r;
    int i;
    bool first;
    r = "";
    first = true;
    for (i = 1; i <= 13; i += 1) {
        if (i == skipP) {
            continue;
        }
        if (g_member[(s * 14) + i]) {
            if (!first) {
                r = r + ", ";
            }
            r = r + BOTC_NameStr(BOTC_PosOf(i));
            first = false;
        }
    }
    if (r == "") {
        r = "无";
    }
    return r;
}

void BOTC_ChatRender (int p) {
    int i;
    int start;
    int blank;
    start = g_chatCount[p] - 26;
    if (start < 0) {
        start = 0;
    }
    // 最近的一条永远在最下面，上面空着的行留白（这样不会有多余的滚动条）
    blank = 26 - (g_chatCount[p] - start);
    for (i = 0; i < 26; i += 1) {
        if (i < blank) {
            libNtve_gf_SetDialogItemText(g_chatRow[(p * 26) + i], StringToText(""), PlayerGroupSingle(p));
        }
        else {
            // 名字按说话人的游戏内颜色显示
            libNtve_gf_SetDialogItemText(g_chatRow[(p * 26) + i], BOTC_LineText(g_chatLines[(p * 300) + start + (i - blank)], g_chatWho[(p * 300) + start + (i - blank)]), PlayerGroupSingle(p));
        }
    }
}

void BOTC_ChatShow (int p, string s) {
    int i;
    if (g_chatCount[p] >= 50) {
        for (i = 0; i < 49; i += 1) {
            g_chatLines[(p * 300) + i] = g_chatLines[(p * 300) + i + 1];
            g_chatWho[(p * 300) + i] = g_chatWho[(p * 300) + i + 1];
        }
        g_chatLines[(p * 300) + 49] = s;
        g_chatWho[(p * 300) + 49] = g_chatWhoNow;
    }
    else {
        g_chatLines[(p * 300) + g_chatCount[p]] = s;
        g_chatWho[(p * 300) + g_chatCount[p]] = g_chatWhoNow;
        g_chatCount[p] = g_chatCount[p] + 1;
    }
    BOTC_ChatRender(p);
}

void BOTC_ChatShowAll (string s) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        BOTC_ChatShow(i, s);
    }
}

// 私聊窗：只显示"自己看到的私聊内容 + 和自己的私聊有关的提示"，显示最近 10 行
void BOTC_PmBoxRender (int p) {
    int i;
    int start;
    int blank;
    start = g_pmLogCount[p] - 14;
    if (start < 0) {
        start = 0;
    }
    blank = 14 - (g_pmLogCount[p] - start);
    for (i = 0; i < 14; i += 1) {
        if (i < blank) {
            libNtve_gf_SetDialogItemText(g_pmRow[(p * 14) + i], StringToText(""), PlayerGroupSingle(p));
        }
        else {
            // 名字按说话人的游戏内颜色显示
            libNtve_gf_SetDialogItemText(g_pmRow[(p * 14) + i], BOTC_LineText(g_pmLog[(p * 600) + start + (i - blank)], g_pmWho[(p * 600) + start + (i - blank)]), PlayerGroupSingle(p));
        }
    }
}

// 【全部私聊 · 渲染拆行】（2026-11-09）：跟 BOTC_PmStore 同一套可见宽度口径，
//   把存档里的原始消息拆成能放进日志列表框的固定高度行。
void BOTC_LogWrapAdd (int p, string s, int who) {
    int n;
    int pos;
    int end;
    int pref;
    int prefW;
    int cap;
    string part;
    n = StringLength(s);
    if (n <= 0) {
        return;
    }
    cap = BOTC_ChatWrapWidthPm();
    pref = BOTC_PrefixEnd(s, n);
    prefW = 0;
    if (pref > 0) {
        prefW = BOTC_TextWidth(StringSub(s, 1, pref));
        cap = BOTC_ChatWrapWidthPm() - prefW;
        if (cap < 12) { cap = 12; }
    }
    pos = BOTC_WrapSkipSpace(s, pref + 1, n);
    if (pos > n) {
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, who));
        return;
    }
    end = BOTC_WrapCut(s, pos, cap, n);
    if (pref > 0) {
        if (pos == pref + 1) {
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, StringSub(s, 1, end), who));
        }
        else {
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, StringSub(s, 1, pref) + StringSub(s, pos, end), who));
        }
    }
    else {
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, StringSub(s, pos, end), who));
    }
    pos = end + 1;
    while (pos <= n) {
        pos = BOTC_WrapSkipSpace(s, pos, n);
        if (pos > n) { break; }
        end = BOTC_WrapCut(s, pos, cap, n);
        part = StringSub(s, pos, end);
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, BOTC_Spaces(prefW) + part, who));
        pos = end + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// 【复盘】（用户 2026-11-11）：结算后才能查看的本局完整记录
//   · 开局 / 结束各存一份「真实身份 + 他以为的身份 + 阵营」快照，认知偏差单独标注；
//   · 过程按夜晚 / 白天分段：每个玩家确认的技能目标、收到的全部信息、身份与阵营变化；
//   · 白天找说书人咨询的角色（渔夫 79 / 博学者 54 / 艺术家 57 / 失忆者 73）
//     另外把他的白天私聊整段列出来。
//   渲染时再经 BOTC_LineText，名字占位符会换成结算时那一格上的人。
//--------------------------------------------------------------------------------------------------
void BOTC_RpSaveLast () {
    int i;
    int q;
    if (!g_rpOn) {
        return;
    }
    g_rpHasLast = true;
    g_rpLCount = g_rpCount;
    for (i = 0; i <= 13; i += 1) {
        g_rpLOpenRole[i] = g_rpOpenRole[i];
        g_rpLOpenSeen[i] = g_rpOpenSeen[i];
        g_rpLOpenAlign[i] = g_rpOpenAlign[i];
        g_rpLEndRole[i] = g_rpEndRole[i];
        g_rpLEndSeen[i] = g_rpEndSeen[i];
        g_rpLEndAlign[i] = g_rpEndAlign[i];
    }
    for (i = 0; i < 1600; i += 1) {
        g_rpLLog[i] = g_rpLog[i];
    }
    // 私聊日志马上就会被清空，先把特殊角色的白天私聊拷出来（用户 2026-11-11）。
    g_rpLPmN = 0;
    for (q = 2; q <= 13; q += 1) {
        if (g_rpEndRole[q] < 0 && g_rpOpenRole[q] < 0) {
            continue;
        }
        if (!BOTC_RpDayRole(g_rpEndRole[q]) && !BOTC_RpDayRole(g_rpOpenRole[q])) {
            continue;
        }
        BOTC_RpDayPm(1, q, true);
    }
}

void BOTC_RpClear () {
    int i;
    g_rpOn = false;
    g_rpCount = 0;
    for (i = 0; i < 1600; i += 1) {
        g_rpLog[i] = "";
    }
    for (i = 0; i <= 13; i += 1) {
        g_rpOpenRole[i] = -1;
        g_rpOpenSeen[i] = -1;
        g_rpOpenAlign[i] = -1;
        g_rpEndRole[i] = -1;
        g_rpEndSeen[i] = -1;
        g_rpEndAlign[i] = -1;
    }
}

// 读取复盘数据：last = true 读上一局结算后的备份，false 读当前局。
//   kind：0 开局身份 / 1 开局自认 / 2 开局阵营 / 3 结束身份 / 4 结束自认 / 5 结束阵营
int BOTC_RpV (bool last, int kind, int q) {
    if (last) {
        if (kind == 0) {
            return g_rpLOpenRole[q];
        }
        if (kind == 1) {
            return g_rpLOpenSeen[q];
        }
        if (kind == 2) {
            return g_rpLOpenAlign[q];
        }
        if (kind == 3) {
            return g_rpLEndRole[q];
        }
        if (kind == 4) {
            return g_rpLEndSeen[q];
        }
        return g_rpLEndAlign[q];
    }
    if (kind == 0) {
        return g_rpOpenRole[q];
    }
    if (kind == 1) {
        return g_rpOpenSeen[q];
    }
    if (kind == 2) {
        return g_rpOpenAlign[q];
    }
    if (kind == 3) {
        return g_rpEndRole[q];
    }
    if (kind == 4) {
        return g_rpEndSeen[q];
    }
    return g_rpEndAlign[q];
}

string BOTC_RpL (bool last, int i) {
    if (last) {
        return g_rpLLog[i];
    }
    return g_rpLog[i];
}

int BOTC_RpN (bool last) {
    if (last) {
        return g_rpLCount;
    }
    return g_rpCount;
}

// 追加一条过程记录（只在正式开局后记录；超出容量时丢掉最早的一条）
void BOTC_RpAdd (string s) {
    int i;
    if (!g_started) {
        return;
    }
    if (StringLength(s) <= 0) {
        return;
    }
    if (g_rpCount >= 1600) {
        for (i = 0; i < 1599; i += 1) {
            g_rpLog[i] = g_rpLog[i + 1];
        }
        g_rpLog[1599] = s;
        return;
    }
    g_rpLog[g_rpCount] = s;
    g_rpCount = g_rpCount + 1;
}

// 身份快照：opening = true 记开局，false 记结算。
//   「他以为的身份」取说书人真值行上写的那张卡（酒鬼 / 疯子 / 提线木偶 / 悟道者等认知覆盖都走这里）；
//   跟真实身份相同就不单独标注。
void BOTC_RpCapture (bool opening) {
    int q;
    int r;
    int seen;
    for (q = 2; q <= 13; q += 1) {
        r = -1;
        seen = -1;
        if (g_who[q] >= 1 && g_who[q] <= 13) {
            r = BOTC_SeatTrueRole(q);
            if (r >= 0 && r <= 163) {
                seen = g_mark[(g_teller * 14) + q] - 1;
                if (seen < 0 || seen > 163 || seen == r) {
                    seen = -1;
                }
            }
            else {
                r = -1;
            }
        }
        if (opening) {
            g_rpOpenRole[q] = r;
            g_rpOpenSeen[q] = seen;
            if (r >= 0) {
                g_rpOpenAlign[q] = BOTC_SeatAlign(q);
            }
            else {
                g_rpOpenAlign[q] = -1;
            }
        }
        else {
            g_rpEndRole[q] = r;
            g_rpEndSeen[q] = seen;
            if (r >= 0) {
                g_rpEndAlign[q] = BOTC_SeatAlign(q);
            }
            else {
                g_rpEndAlign[q] = -1;
            }
        }
    }
}

// 白天咨询说书人的角色（渔夫 / 博学者 / 艺术家 / 失忆者）
bool BOTC_RpDayRole (int r) {
    if (r == 79 || r == 54 || r == 57 || r == 73) {
        return true;
    }
    return false;
}

void BOTC_RpPmPut (int p, bool save, string t, int who) {
    if (save) {
        if (g_rpLPmN < 1000) {
            g_rpLPm[g_rpLPmN] = t;
            g_rpLPmWho[g_rpLPmN] = who;
            g_rpLPmN = g_rpLPmN + 1;
        }
        return;
    }
    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, t, who));
}

// 把某个座位「每个白天与说书人的私聊」整段列出来。
//   玩家自己的私聊日志里，白天段（---- 第N天 ---- 之后、下一个时段标记之前）保留：
//   说书人说的话、他自己说的话（只在与说书人的会话里，g_pmWith = 0）、以及系统信息行。
//   save = true 时写入上一局备份 g_rpLPm，不直接显示（换局清日志前调用）。
void BOTC_RpDayPm (int p, int q, bool save) {
    int pi;
    int i;
    int who;
    int n;
    int start;
    bool day;
    string s;
    pi = g_who[q];
    if (pi < 1 || pi > 13) {
        pi = q;
    }
    if (g_rpEndRole[q] >= 0) {
        s = BOTC_RoleNameSafe(g_rpEndRole[q]);
    }
    else {
        s = BOTC_RoleNameSafe(g_rpOpenRole[q]);
    }
    start = g_rpLPmN;
    BOTC_RpPmPut(p, save, "---- " + BOTC_NameStr(q) + "（" + s + "）与说书人的白天私聊 ----", 0);
    day = false;
    n = 0;
    for (i = 0; i < g_pmLogCount[pi]; i += 1) {
        s = g_pmLog[(pi * 600) + i];
        if (BOTC_IsPeriodMark(s)) {
            // 「---- 第N天：X 被处决 / 第N夜：昨晚 X 死亡 ----」这类是事件标记，不切分白天段；
            // 只有「---- 第N天 ----」「---- 准备阶段（进入白天）----」才切换白天 / 夜晚。
            if (StringFind(s, "：", false) > 0) {
                continue;
            }
            day = (StringFind(s, "天", false) > 0);
            if (day) {
                BOTC_RpPmPut(p, save, s, 0);
            }
            continue;
        }
        if (!day) {
            continue;
        }
        if (g_pmBoxOnly[(pi * 600) + i]) {
            continue;
        }
        who = g_pmWho[(pi * 600) + i];
        if (who == 0 || who == 1) {
            BOTC_RpPmPut(p, save, s, who);
            n = n + 1;
        }
        else if (who == BOTC_PosOf(pi) && g_pmWith[(pi * 600) + i] == 0) {
            BOTC_RpPmPut(p, save, s, who);
            n = n + 1;
        }
    }
    if (n <= 0) {
        if (save) {
            g_rpLPmN = start;      // 白天没聊过：整段不要，别留一个空标题
        }
        else {
            BOTC_RpPmPut(p, save, "（白天没有与说书人的私聊）", 0);
        }
    }
}

void BOTC_RpRender (int p) {
    int q;
    int i;
    int r;
    int seen;
    int n;
    bool last;
    string s;
    DialogControlRemoveAllItems(g_logList, PlayerGroupSingle(p));
    // 结算后看本局；本局进行中则看上一局结算留下的复盘（用户 2026-11-11）。
    last = false;
    if (!g_rpOn) {
        if (g_rpHasLast) {
            last = true;
        }
        else {
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, "本局尚未结算，暂时没有复盘。", 0));
            return;
        }
    }
    // ① 开局真实身份
    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, "---- 开局真实身份 ----", 0));
    for (q = 2; q <= 13; q += 1) {
        r = BOTC_RpV(last, 0, q);
        if (r < 0 || r > 163) {
            continue;
        }
        // 认知偏差：前面写他以为的身份，括号里写真实身份，例如「食人族（酒鬼）」。
        seen = BOTC_RpV(last, 1, q);
        if (seen >= 0 && seen <= 163) {
            s = BOTC_NameStr(q) + "：" + g_roleName[seen] + "（" + g_roleName[r] + "）";
        }
        else {
            s = BOTC_NameStr(q) + "：" + g_roleName[r];
        }
        s = s + "（" + BOTC_TeamName(g_roleTeam[r]) + "·" + BOTC_AlignName(BOTC_RpV(last, 2, q)) + "）";
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, 0));
    }
    // ② 过程记录
    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, "---- 过程记录 ----", 0));
    n = BOTC_RpN(last);
    for (i = 0; i < n; i += 1) {
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, BOTC_RpL(last, i), 0));
    }
    // ③ 白天咨询说书人的角色：把每天与说书人的私聊整段列出来
    //   本局结算 → 直接读当前私聊日志；本局进行中 → 读换局时备份的上一局白天私聊。
    if (last) {
        for (i = 0; i < g_rpLPmN; i += 1) {
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_rpLPm[i], g_rpLPmWho[i]));
        }
    }
    else {
        for (q = 2; q <= 13; q += 1) {
            if (g_rpEndRole[q] < 0 && g_rpOpenRole[q] < 0) {
                continue;
            }
            if (!BOTC_RpDayRole(g_rpEndRole[q]) && !BOTC_RpDayRole(g_rpOpenRole[q])) {
                continue;
            }
            BOTC_RpDayPm(p, q, false);
        }
    }
    // ④ 结束真实身份
    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, "---- 结束真实身份 ----", 0));
    for (q = 2; q <= 13; q += 1) {
        r = BOTC_RpV(last, 3, q);
        if (r < 0 || r > 163) {
            continue;
        }
        seen = BOTC_RpV(last, 4, q);
        if (seen >= 0 && seen <= 163) {
            s = BOTC_NameStr(q) + "：" + g_roleName[seen] + "（" + g_roleName[r] + "）";
        }
        else {
            s = BOTC_NameStr(q) + "：" + g_roleName[r];
        }
        s = s + "（" + BOTC_TeamName(g_roleTeam[r]) + "·" + BOTC_AlignName(BOTC_RpV(last, 5, q)) + "）";
        if (BOTC_RpV(last, 0, q) >= 0 && BOTC_RpV(last, 0, q) != r) {
            s = s + "  【身份改变】开局：" + g_roleName[BOTC_RpV(last, 0, q)];
        }
        if (BOTC_RpV(last, 2, q) >= 0 && BOTC_RpV(last, 5, q) >= 0 && BOTC_RpV(last, 2, q) != BOTC_RpV(last, 5, q)) {
            s = s + "  【阵营改变】" + BOTC_AlignName(BOTC_RpV(last, 2, q)) + "→" + BOTC_AlignName(BOTC_RpV(last, 5, q));
        }
        DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, s, 0));
    }
}

void BOTC_LogRender (int p) {
    int i;
    int t;
    int vw;
    BOTC_LogViewBtnRender(p);      // 按钮文字始终显示当前查看目标（用户 2026-11-03）
    // 【全部私聊】入口只给说书人（2026-11-09）
    if (g_logAllPmBtn != 0) {
        if (p == g_teller) {
            DialogControlSetVisible(g_logAllPmBtn, PlayerGroupSingle(p), true);
        }
        else {
            DialogControlSetVisible(g_logAllPmBtn, PlayerGroupSingle(p), false);
        }
    }
    DialogControlRemoveAllItems(g_logList, PlayerGroupSingle(p));
    // 【复盘】按钮只在第一次结算后出现（用户 2026-11-11）：没结算且没有上一局复盘时对所有人隐藏。
    if (g_rpBtn != 0) {
        if (g_rpOn || g_rpHasLast) {
            DialogControlSetVisible(g_rpBtn, PlayerGroupAll(), true);
        }
        else {
            DialogControlSetVisible(g_rpBtn, PlayerGroupAll(), false);
        }
    }
    // 【复盘】页签（用户 2026-11-11）：本局没结算时显示上一局的复盘。
    if (g_logMode[p] == 5) {
        if (g_rpOn || g_rpHasLast) {
            BOTC_RpRender(p);
            return;
        }
        g_logMode[p] = 0;
    }
    // 【全部私聊】（2026-11-09）：说书人专用，按发送顺序显示所有私聊原文；
    //   「查看」选了某个玩家时，只留这个人当时在房间里的对话（含他说的和收到的）。
    if (g_logMode[p] == 4 && p == g_teller) {
        vw = g_logViewWho[p];
        for (i = 0; i < g_allPmCount; i += 1) {
            if (vw > 0) {
                if (!BOTC_IsPeriodMark(g_allPmLog[i])) {
                    if (!g_allPmIn[(i * 14) + vw]) {
                        continue;
                    }
                }
            }
            BOTC_LogWrapAdd(p, g_allPmLog[i], g_allPmWho[i]);
        }
        return;
    }
    // 用户 2026-09-19：以前这里只画「最近 30 条」，所以日志看着只有一小部分。
    //   现在**把存着的全部画进去**（列表本身能滚动 / 能拖滚动条），三种页签都一样。
    if (g_logMode[p] == 0) {
        for (i = 0; i < g_pubLogCount; i += 1) {
            // 【屏蔽只隐藏新发言】（用户 2026-11-08）：屏蔽之后对方说的话不显示，
            //   屏蔽之前的历史发言继续保留在日志里（分隔标记始终保留）。
            if (g_pubWho[i] >= 1 && g_pubWho[i] <= 13) {
                if (g_pubLog[i] != "" && BOTC_PubHideByBlock(p, g_who[g_pubWho[i]], g_pubSeq[i])) {
                    if (!BOTC_IsPeriodMark(g_pubLog[i])) {
                        continue;
                    }
                }
            }
            // 【看某玩家】筛选（用户 2026-09-30）：只留那个人的发言 + 天数/时段分隔标记；
            //   其它系统提示（【配比】【巡山人】这些）在这个视图里过滤掉
            if (g_logViewWho[p] > 0) {
                if (!BOTC_IsPeriodMark(g_pubLog[i])) {
                    if (g_pubWho[i] != g_logViewWho[p]) {
                        continue;
                    }
                }
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_pubLog[i], g_pubWho[i]));
        }
    }
    else {
        if (g_logMode[p] == 2) {
            for (i = 0; i < g_voteLogCount; i += 1) {
                DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_voteLog[i], 0));   // 投票统计：名字换成真名
            }
            return;
        }
        // 【系统消息】页签（用户 2026-09-30）：不管「看某玩家」选了谁，都只显示**我自己**收到的系统消息
        //   （公聊 / 私聊里被过滤掉的那些 + 天数/时段分隔标记，标记不过滤）
        if (g_logMode[p] == 3) {
            for (i = 0; i < g_pubLogCount; i += 1) {
                if (g_pubWho[i] <= 0) {
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_pubLog[i], g_pubWho[i]));
                }
            }
            for (i = 0; i < g_pmLogCount[p]; i += 1) {
                if (g_pmBoxOnly[(p * 600) + i]) {
                    continue;
                }
                if (g_pmWho[(p * 600) + i] == 0) {
                    DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_pmLog[(p * 600) + i], 0));
                }
            }
            return;
        }
        for (i = 0; i < g_pmLogCount[p]; i += 1) {
            // 【只进聊天框、不进日志】的行（用户 2026-09-30：按 Tab 那些提示）
            if (g_pmBoxOnly[(p * 600) + i]) {
                continue;
            }
            // 【看某玩家】筛选（用户 2026-09-30）：私聊页签只留「跟他这段对话」——
            //   ① 他说的（他的发言都在我这份日志里，必是我参与的会话）
            //   ② 我自己说的，且这一行属于跟他那段对话（g_pmWith 记着"这行是跟谁聊的"）
            //   这样看玩家3 时，就不会把我和玩家2 的私聊也带出来。
            if (g_logViewWho[p] > 0) {
                // 天数/时段分隔标记永远留；其它系统提示过滤掉（用户 2026-09-30）
                if (!BOTC_IsPeriodMark(g_pmLog[(p * 600) + i])) {
                    // 【坐标统一】（用户 2026-10-07）：g_pmWho 存的是**格子**、p 是**物理座位** ——
                    //   换过座位之后两者不等，自己说的那几行会被当成【别人说的】滤掉（我的私聊 → 看某玩家 里自己的话整段不见）。
                    if (g_pmWho[(p * 600) + i] == BOTC_PosOf(p)) {
                        if (g_pmWith[(p * 600) + i] != g_logViewWho[p]) {
                            continue;
                        }
                    }
                    else {
                        if (g_pmWho[(p * 600) + i] != g_logViewWho[p]) {
                            continue;
                        }
                    }
                }
            }
            DialogControlAddItem(g_logList, PlayerGroupSingle(p), BOTC_LogLineText(p, g_pmLog[(p * 600) + i], g_pmWho[(p * 600) + i]));
        }
    }
}

//--------------------------------------------------------------------------------------------------
// 【随机分配 · 清空旧提示】（用户 2026-11-04）：随机发牌 / 随机配板每次都会往说书人私聊窗写一批
//   提示（【配比】…），反复随机会堆成一大片。这里按前缀把上一次留下的整段（含自动换行的续行）删掉，
//   只保留与随机无关的私聊内容。
//--------------------------------------------------------------------------------------------------
void BOTC_PmDropPrefix (int p, string prefix) {
    int i;
    int keep;
    int pl;
    bool hit;
    bool dropCont;
    string line;
    if (p < 1 || p > 13) {
        return;
    }
    pl = StringLength(prefix);
    hit = false;
    dropCont = false;
    keep = 0;
    for (i = 0; i < g_pmLogCount[p]; i += 1) {
        line = g_pmLog[(p * 600) + i];
        if (StringLength(line) >= pl && StringSub(line, 1, pl) == prefix) {
            hit = true;
            dropCont = true;
            continue;
        }
        // 自动换行出来的续行以 6 个空格开头，紧跟在被删的那段后面一起删
        if (dropCont && StringLength(line) >= 6 && StringSub(line, 1, 6) == "      ") {
            continue;
        }
        dropCont = false;
        g_pmLog[(p * 600) + keep] = line;
        g_pmWho[(p * 600) + keep] = g_pmWho[(p * 600) + i];
        g_pmWith[(p * 600) + keep] = g_pmWith[(p * 600) + i];
        g_pmBoxOnly[(p * 600) + keep] = g_pmBoxOnly[(p * 600) + i];
        keep = keep + 1;
    }
    if (!hit) {
        return;
    }
    g_pmLogCount[p] = keep;
    BOTC_PmBoxRender(p);
    if (g_logOpen[p] && (g_logMode[p] == 1 || g_logMode[p] == 3)) {
        BOTC_LogRender(p);
    }
}

// 【随机发牌 · 清空上一次的发牌提示】（用户 2026-11-06）：反复点【随机发牌】时，说书人私聊窗只留
//   本次发牌写入的内容；上一次发牌留下的配比、认知覆盖和各角色设置提示整段删掉。
void BOTC_PmDealClear (int p) {
    BOTC_PmDropPrefix(p, "【配比】");
    BOTC_PmDropPrefix(p, "【随机配板】");
    BOTC_PmDropPrefix(p, "【小怪宝】");
    BOTC_PmDropPrefix(p, "【认知覆盖】");
    BOTC_PmDropPrefix(p, "【酒鬼】");
    BOTC_PmDropPrefix(p, "【悟道者】");
    BOTC_PmDropPrefix(p, "【疯子】");
    BOTC_PmDropPrefix(p, "【无神论者】");
    BOTC_PmDropPrefix(p, "【巡山人】");
    BOTC_PmDropPrefix(p, "【半兽人】");
    BOTC_PmDropPrefix(p, "【解谜大师】");
    BOTC_PmDropPrefix(p, "【唱诗男孩】");
    BOTC_PmDropPrefix(p, "【堤丰之首】");
    BOTC_PmDropPrefix(p, "【提线木偶】");
    BOTC_PmDropPrefix(p, "【召唤师】");
    BOTC_PmDropPrefix(p, "【暴风捕手】");
    BOTC_PmDropPrefix(p, "【酒保】");
    BOTC_PmDropPrefix(p, "【店小二】");
    BOTC_PmDropPrefix(p, "【限】");
    BOTC_PmDropPrefix(p, "【不在场身份】");
    BOTC_PmDropPrefix(p, "【军团");
}

// 【看某玩家】（用户 2026-09-30 重做）：点一下就在按钮那儿弹出下拉列表（自带滚轮），
//   第 1 行【所有玩家】= 切回正常日志；点某一行 = 只看那个人。
//
// 【为什么敢改回列表框】（用户 2026-10-07 问「滚轮式解决不了自动消失吗」）：老毛病不在列表框本身，
//   在**"每 0.5 秒读一次选中项"**这个读法 —— 只要列表被（重）填一次，控件就会**自己选中第一行**，
//   轮询把这也当成"你点了一行"→ 下拉自己关掉。现在每次打开都按当前座位重建列表，
//   再显式选中第一行；第一拍只记基线，所以重建不会误触，掉线后的座位号也不会错位。
// 【看某玩家 · 按钮文字】（用户 2026-11-03）：按钮本身就是选项框，显示当前查看目标，
//   右侧带下拉箭头；0 = 所有玩家，1 = 说书人，2..13 = 该逻辑格上的玩家（占位名在渲染时换成战网名）。
void BOTC_LogViewBtnRender (int p) {
    string lab;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_logViewWho[p] == 1) {
        lab = "查看：说书人 ▼";
    }
    else if (g_logViewWho[p] >= 2 && g_logViewWho[p] <= 13) {
        lab = "查看：" + BOTC_NameStr(g_logViewWho[p]) + " ▼";
    }
    else {
        lab = "查看：所有玩家 ▼";
    }
    libNtve_gf_SetDialogItemText(g_logViewBtn, BOTC_LogLineText(p, lab, 0), PlayerGroupSingle(p));
}

void BOTC_LogPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_logPickOn[p]) {
        g_logPickOn[p] = false;
        DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
        return;
    }
    // 每次打开都按当前 g_seatOn 重建：玩家掉线后座位会压缩，缓存旧列表会把行号映射到相邻座位。
    BOTC_LogPickRender(p);
    DialogControlSelectItem(g_logPickList, PlayerGroupSingle(p), 0);
    g_logMenuSel[p] = -1;          // -1 = 这一拍只记基线、不动作
    g_logPickOn[p] = true;
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), true);
}

// 把下拉列表填满：第 1 行 = 所有玩家，第 2 行 = 说书人，之后按当前在场座位列出玩家
void BOTC_LogPickRender (int p) {
    int i;
    DialogControlRemoveAllItems(g_logPickList, PlayerGroupSingle(p));
    DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LineText("所有玩家", 0));
    DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LineText("说书人", 1));
    for (i = 2; i <= 13; i += 1) {
        // 【换座后仍按格子判定】（2026-11-10 修正）：g_seatOn 由 BOTC_GrimRelayout 按**格子**写入
        //   （只覆盖 2..13），不是物理座位 —— 拿 g_who[i] 当下标会把玩家 1 等参与者的格判成不在场。
        if (g_who[i] >= 1 && g_who[i] <= 13 && g_seatOn[i]) {
            DialogControlAddItem(g_logPickList, PlayerGroupSingle(p), BOTC_LogLineText(p, BOTC_NameStr(i), i));
        }
    }
}

// 把"当前选中的那一行"应用成视图：第 1 行 = 所有玩家、第 2 行 = 说书人、之后按在场顺序数
void BOTC_LogPickTake (int p) {
    int sel;
    int i;
    int n;
    if (p < 1 || p > 13) {
        return;
    }
    sel = DialogControlGetSelectedItem(g_logPickList, p);
    if (sel < 1) {
        return;
    }
    g_logMenuSel[p] = sel;
    g_logViewWho[p] = 0;
    if (sel >= 2) {
        g_logViewWho[p] = 1;           // 第 2 行 = 说书人（游戏里的玩家 1）
    }
    n = 2;
    for (i = 2; i <= 13; i += 1) {
        if (!(g_who[i] >= 1 && g_who[i] <= 13 && g_seatOn[i])) {
            continue;
        }
        n = n + 1;
        if (n == sel) {
            g_logViewWho[p] = i;
        }
    }
    g_logPickOn[p] = false;
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
    BOTC_LogRender(p);
}

// 【看某玩家 · 下拉】每 0.5 秒对一次选中项（列表点选不一定触发控件事件，跟【请求加入】同一个套路）
void BOTC_LogMenuTick (int p) {
    int sel;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_logPickDlg == 0) {
        return;
    }
    if (!g_logPickOn[p]) {
        return;
    }
    sel = DialogControlGetSelectedItem(g_logPickList, p);
    if (g_logMenuSel[p] < 0) {
        g_logMenuSel[p] = sel;         // 第一拍：把"控件自己选中的那一行"记成基线
        return;
    }
    if (sel < 1 || sel == g_logMenuSel[p]) {
        return;
    }
    BOTC_LogPickTake(p);
}

// 打开日志：提名阶段先把该玩家的魔典收起来，保证日志不会被魔典盖住
void BOTC_LogOpen (int p) {
    // 【保留上次画面与所选玩家】（用户 2026-11-02）：不再每次打开都重置到「所有玩家」
    g_logPickOn[p] = false;
    BOTC_LogRender(p);
    g_logOpen[p] = true;
    if (g_phase != 0) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);
        g_grimOn[p] = false;
    }
    DialogSetVisible(g_logDlg, PlayerGroupSingle(p), true);
}

// 关闭日志：提名阶段若能力表也没开，就把魔典放回来
void BOTC_LogClose (int p) {
    g_logOpen[p] = false;
    g_logPickOn[p] = false;
    DialogSetVisible(g_logDlg, PlayerGroupSingle(p), false);
    DialogSetVisible(g_logPickDlg, PlayerGroupSingle(p), false);
    if (g_phase != 0 && !g_abOpen[p]) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
        g_grimOn[p] = true;
    }
}

// 关闭角色能力表：提名阶段若日志也没开，就把魔典放回来
void BOTC_AbClose (int p) {
    g_abOpen[p] = false;
    g_noOpen[p] = false;           // 夜序跟剧本角色表是同一个弹窗的两种视图（用户 2026-11-04）
    DialogSetVisible(g_abNewDlg[p], PlayerGroupSingle(p), false);
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), false);
    if (g_phase != 0 && !g_logOpen[p]) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
        g_grimOn[p] = true;
    }
}

void BOTC_LogSetMode (int p, int mode) {
    // 【全部私聊】（2026-11-09）：说书人专用页签，其他玩家一律拒绝
    if (mode == 4 && p != g_teller) {
        return;
    }
    // 【复盘】（用户 2026-11-11）：第一次结算之后一直可看；本局没结算时显示上一局
    if (mode == 5 && !g_rpOn && !g_rpHasLast) {
        return;
    }
    g_logMode[p] = mode;
    BOTC_LogRender(p);
}

void BOTC_AppendPm (int p, string s) {
    BOTC_PmStore(p, s);
}

void BOTC_Notice (int p, string s) {
    bool onlyBak;
    // 【剧本以外 · 系统信息走公聊】（用户 2026-11-13）：私聊频道在这几个页面关闭
    if (BOTC_PmOff()) {
        BOTC_PubAnnounce(s);
        return;
    }
    if (!g_inClick) {
        BOTC_PmStore(p, s);
    }
    else {
        // 【日志屏蔽、私聊框不屏蔽】（用户 2026-09-30）：点按钮冒出来的提示原来连左边私聊框都不进；
        //   现在改成照旧进私聊框，只是在【日志 → 我的私聊 / 系统消息】那一页里被滤掉 ----
        //   用的就是原来「只进聊天框、不进日志」那个 g_pmBoxOnly 标记（按 Tab 切时段也是这一套）。
        onlyBak = g_pmBoxOnlyNow;
        g_pmBoxOnlyNow = true;
        BOTC_PmStore(p, s);
        g_pmBoxOnlyNow = onlyBak;
    }
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));   // 提示条换成真名（用户 2026-09-19）
}

// 跟 Notice 一样，但**不管是不是在点界面，都写进私聊日志**
//   （用户 2026-09-30：「已与 X 建立私聊」这种要留档）
void BOTC_NoticeKeep (int p, string s) {
    // 【剧本以外 · 系统信息走公聊】（用户 2026-11-13）
    if (BOTC_PmOff()) {
        BOTC_PubAnnounce(s);
        return;
    }
    BOTC_PmStore(p, s);
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 【跟 Notice 一样，但只进私聊框、不进日志】（用户 2026-09-30）：点按钮那类即时反馈用它 ----
//   不管在不在点击里都打上 g_pmBoxOnly 标记 →【日志 → 我的私聊 / 系统消息】里不出现，左边私聊框照常显示。
void BOTC_NoticeBox (int p, string s) {
    bool onlyBak;
    // 【剧本以外 · 系统信息走公聊】（用户 2026-11-13）
    if (BOTC_PmOff()) {
        BOTC_PubAnnounce(s);
        return;
    }
    onlyBak = g_pmBoxOnlyNow;
    g_pmBoxOnlyNow = true;
    BOTC_PmStore(p, s);
    g_pmBoxOnlyNow = onlyBak;
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));
}

// 只弹一句屏幕提示，**不写进私聊记录**（邪恶小窗用：用户 2026-09-17 要求小窗的东西别跑到左边的私聊框里）
void BOTC_SubMsg (int p, string s) {
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_NameSubst(s));   // 提示条换成真名（用户 2026-09-19）
}

void BOTC_ShowReq (int p, string msg) {
    libNtve_gf_SetDialogItemText(g_reqLabel[p], BOTC_NameSubst(msg), PlayerGroupSingle(p));   // 请求框里的名字换成真名
    DialogControlSetVisible(g_reqLabel[p], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_reqYes[p], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_reqNo[p], PlayerGroupSingle(p), true);
    g_reqSec[p] = 30;                 // 【15 秒应答窗口】（用户 2026-11-02）：超时自动拒绝
}

void BOTC_ClearReq (int p) {
    libNtve_gf_SetDialogItemText(g_reqLabel[p], StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_reqLabel[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_reqYes[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_reqNo[p], PlayerGroupSingle(p), false);
    g_reqSec[p] = 0;
}

void BOTC_RefreshSessList (int p) {
    int s;
    int i;
    int k;
    string desc;
    string full;
    string nm;
    int n;
    int o;
    int[14] lv_ord;
    int idx;
    int tot;
    int skip;
    int maxSkip;
    int longB;
    bool first;
    bool blindEntry;
    DialogControlRemoveAllItems(g_sessList[p], PlayerGroupSingle(p));
    k = 0;
    maxSkip = 0;
    longB = 0;
    for (s = 1; s <= 13; s += 1) {
        if (g_sessAlive[s]) {
            n = 0;
            for (i = 1; i <= 13; i += 1) {
                if (g_member[(s * 14) + i]) {
                    n = n + 1;
                }
            }
            if (n < 2) {
                continue;
            }
            // 【私聊可见性】关闭后，非说书人只隐藏其他会话；自己当前所在的会话始终保留。
            //   【说书人的房间匿名可见】（用户 2026-11-05）：只要这条私聊里有说书人，对其他玩家
            //   一律只显示「说书人」，房主和其他成员都不可见 ---- 让全场知道说书人正在与人私聊。
            blindEntry = false;
            if (p != g_teller && !g_member[(s * 14) + p]) {
                if (!g_member[(s * 14) + g_teller]) {
                    if (!g_pmVisOn) {
                        continue;
                    }
                }
                else {
                    blindEntry = true;
                }
            }
            // 【夜里别暴露说书人】夜里说书人是在私聊里给被唤醒的人发信息的 ----
            //   有说书人参与的私聊一旦出现在这份列表里，等于告诉大家「刚才谁被叫去说话了」。
            //   所以**夜里对别的玩家**隐藏这些会话（说书人自己那份照旧看得见，他要用来发信息）。
            if (g_isNight && p != g_teller && g_member[(s * 14) + g_teller] && !g_member[(s * 14) + p]) {
                continue;                       // 【自己就在这条私聊里就别藏】（用户 2026-10-19 报「在私聊里但显示不在」）
            }
            // 【小怪宝 · 恶人频道】（用户 2026-10-11）：这条群聊只给**里面的人 + 说书人**看 ----
            //   不然全场都会在「进行中的私聊」里看到「哪几个玩家在一起私聊」= 直接暴露恶人。
            if (s == g_lmSess && p != g_teller && !g_member[(s * 14) + p]) {
                continue;
            }
            k = k + 1;
            // 【横向滚动】（用户 2026-11-03）：名字太多时一行放不下，按「跳过前几个成员」的方式
            //   用左右按钮 / 拖动滚动条查看；房主仍然排在最前。
            tot = 0;
            o = g_sessOwner[s];
            if (blindEntry) {
                // 匿名条目只列说书人，其他成员不进入名字行。
                lv_ord[0] = g_teller;
                tot = 1;
            }
            else {
                if (o >= 1 && o <= 13 && g_member[(s * 14) + o]) {
                    lv_ord[tot] = o;
                    tot = tot + 1;
                }
                for (i = 1; i <= 13; i += 1) {
                    if (i == o) {
                        continue;
                    }
                    if (g_member[(s * 14) + i]) {
                        lv_ord[tot] = i;
                        tot = tot + 1;
                    }
                }
            }
            if (tot - 1 > maxSkip) {
                maxSkip = tot - 1;
            }
            skip = g_sessXOff[p];
            if (skip > tot - 1) {
                skip = tot - 1;
            }
            if (skip < 0) {
                skip = 0;
            }
            desc = "私聊" + IntToString(s) + "：";
            full = "私聊" + IntToString(s) + "：";
            if (skip > 0) {
                desc = desc + "…";
            }
            first = true;
            for (idx = 0; idx < tot; idx += 1) {
                nm = BOTC_NameStr(BOTC_PosOf(lv_ord[idx]));      // 【按位置取名字】（用户 2026-10-07）
                // 【翻到最右边按钮会消失】（用户 2026-11-04）：宽度要按「不跳过任何成员」的全名算，
                //   否则滚到右边只剩短名字时判定失败，按钮就被收起来了，再也翻不回去。
                if (idx > 0) {
                    full = full + "、";
                }
                full = full + nm;
                if (idx < skip) {
                    continue;
                }
                if (!first) {
                    desc = desc + "、";
                }
                desc = desc + nm;
                first = false;
            }
            if (blindEntry) {
                desc = desc + "（成员不可见）";
                full = full + "（成员不可见）";
            }
            if (StringLength(full) > longB) {
                longB = StringLength(full);
            }
            DialogControlAddItem(g_sessList[p], PlayerGroupSingle(p), BOTC_NameSubst(desc));   // 私聊列表里的名字换成真名
            g_listSess[(p * 14) + k] = s;
        }
    }
    g_sessMaxSkip[p] = maxSkip;
    g_sessLong[p] = longB;
    if (longB <= 60) {
        g_sessXOff[p] = 0;             // 滚动条不显示时不要停在「…」状态
    }
    if (g_sessXOff[p] > maxSkip) {
        g_sessXOff[p] = maxSkip;
    }
    if (g_sessXOff[p] < 0) {
        g_sessXOff[p] = 0;
    }
    if (k == 0) {
        g_sessXOff[p] = 0;
        g_listSess[(p * 14) + 1] = 0;
        libNtve_gf_SetDialogItemText(g_sessTitle[p], StringToText("当前没有进行中的私聊"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_sessTitle[p], StringToText("进行中的私聊（< > 左右查看成员）"), PlayerGroupSingle(p));
    }
    BOTC_SessNavRender(p);
    BOTC_SessBarRender(p);
}

void BOTC_RefreshSessListAll () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        BOTC_RefreshSessList(i);
    }
}

// 【私聊列表横向查看】（用户 2026-11-04）：成员名字超出私聊框时，显示左右两个按钮翻看。
//   （用户 2026-11-04 反馈「横向滚动轴作用不大」）：去掉拖动滑块，改成按钮。
void BOTC_SessNavRender (int p) {
    bool need;
    if (p < 1 || p > 13) {
        return;
    }
    // 只要有一条私聊超过「房主 + 一名成员」，就保留左右翻看入口。
    // 不用整串名字的长度阈值判断，否则短名字或窄屏时按钮会整组消失。
    need = (g_sessMaxSkip[p] > 0);
    DialogControlSetVisible(g_sessPrevBtn[p], PlayerGroupSingle(p), need);
    DialogControlSetVisible(g_sessNextBtn[p], PlayerGroupSingle(p), need);
}

// 向左 / 向右各跳过一个成员，刷新后保持原来选中的私聊。
void BOTC_SessNavStep (int p, int d) {
    int maxSkip;
    int sel;
    if (p < 1 || p > 13) {
        return;
    }
    maxSkip = g_sessMaxSkip[p];
    if (maxSkip <= 0) {
        return;
    }
    g_sessXOff[p] = g_sessXOff[p] + d;
    if (g_sessXOff[p] < 0) {
        g_sessXOff[p] = 0;
    }
    if (g_sessXOff[p] > maxSkip) {
        g_sessXOff[p] = maxSkip;
    }
    sel = DialogControlGetSelectedItem(g_sessList[p], p);
    BOTC_RefreshSessList(p);
    if (sel >= 1) {
        DialogControlSelectItem(g_sessList[p], PlayerGroupSingle(p), sel);
    }
}

// 【私聊横向滚动条】成员多于房主 + 一人时显示，拖动滑块直接改变所有私聊行的成员起点。
void BOTC_SessBarRender (int p) {
    int knobX;
    int maxSkip;
    if (p < 1 || p > 13) {
        return;
    }
    maxSkip = g_sessMaxSkip[p];
    if (maxSkip <= 0) {
        DialogControlSetVisible(g_sessBar[p], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_sessKnob[p], PlayerGroupSingle(p), false);
        return;
    }
    DialogControlSetVisible(g_sessBar[p], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_sessKnob[p], PlayerGroupSingle(p), true);
    if (g_sessDrag[p]) {
        knobX = g_sessKnobX[p];
    }
    else {
        knobX = (440 * g_sessXOff[p]) / maxSkip;
    }
    g_sessKnobX[p] = knobX;
    DialogControlSetPosition(g_sessKnob[p], PlayerGroupSingle(p), c_anchorTopLeft, 10 + knobX, 81);
}

void BOTC_SessBarSetByMouse (int p, int mx) {
    int maxSkip;
    int v;
    int sel;
    maxSkip = g_sessMaxSkip[p];
    if (maxSkip <= 0) {
        return;
    }
    v = mx - 20;
    if (v < 0) {
        v = 0;
    }
    if (v > 440) {
        v = 440;
    }
    // 拖动时先实时移动滑块，再按成员边界刷新文字；不要等列表重绘后才移动。
    g_sessKnobX[p] = v;
    DialogControlSetPosition(g_sessKnob[p], PlayerGroupSingle(p), c_anchorTopLeft, 10 + v, 81);
    g_sessXOff[p] = (v * maxSkip) / 440;
    sel = DialogControlGetSelectedItem(g_sessList[p], p);
    BOTC_RefreshSessList(p);
    if (sel >= 1) {
        DialogControlSelectItem(g_sessList[p], PlayerGroupSingle(p), sel);
    }
}

bool BOTC_SessBarDown_Func (bool testConds, bool runActions) {
    int p;
    int mx;
    int my;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13 || g_hidden[p] || g_sessMaxSkip[p] <= 0) {
        return true;
    }
    mx = EventMouseClickedPosXUI();
    my = EventMouseClickedPosYUI();
    if (mx < 20 || mx > 500 || my < 98 || my > 116) {
        return true;
    }
    g_sessDrag[p] = true;
    BOTC_SessBarSetByMouse(p, mx);
    return true;
}

bool BOTC_SessBarUp_Func (bool testConds, bool runActions) {
    int p;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p >= 1 && p <= 13) {
        g_sessDrag[p] = false;
        BOTC_SessBarRender(p);
    }
    return true;
}

bool BOTC_SessBarMove_Func (bool testConds, bool runActions) {
    int p;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13 || !g_sessDrag[p]) {
        return true;
    }
    BOTC_SessBarSetByMouse(p, EventMouseMovedPosXUI());
    return true;
}

//--------------------------------------------------------------------------------------------------
// 【面板拖动 · 位置记忆】（用户 2026-11-04）：笔记 / 剧本角色表 / 夜间行动顺序按住顶部拖动。
//   ⚠ 星际弹窗坐标按「内部 UI 分辨率」算：高度固定 1200，宽度随画面比例变化
//      （16:9 = 2133、16:10 = 1920、4:3 = 1600）。之前按 1920×1080 写死，顶部判定区
//      比真实位置偏上 60 像素、偏左一百多像素 → 点标题栏永远打不中，拖动完全失效。
//   现在三种宽度都试，高度也同时兼容 1200 / 1080，命中任意一种即算按住顶部。
//   位置只记在本次游戏里（全局变量退出地图自然重置），首次打开是屏幕正中心。
//--------------------------------------------------------------------------------------------------
int BOTC_DlgDragLeft (int w, int offX, int cx) {
    return cx + offX - (w / 2);
}

bool BOTC_DlgTopHitAt (int w, int h, int offX, int offY, int mx, int my, int cx, int cy) {
    int lx;
    int ly;
    lx = BOTC_DlgDragLeft(w, offX, cx);
    ly = cy + offY - (h / 2);
    return mx >= lx && mx <= lx + w && my >= ly && my <= ly + 46;
}

// 左上角切换按钮那一小块不参与拖动（点它要能切视图）
bool BOTC_DlgTopBtnAt (int w, int h, int offX, int offY, int mx, int my, int cx, int cy) {
    int lx;
    int ly;
    lx = BOTC_DlgDragLeft(w, offX, cx);
    ly = cy + offY - (h / 2);
    return mx >= lx + 10 && mx <= lx + 250 && my >= ly && my <= ly + 40;
}

bool BOTC_DlgTopHit (int w, int h, int offX, int offY, int mx, int my) {
    if (BOTC_DlgTopHitAt(w, h, offX, offY, mx, my, 1066, 600)) { return true; }   // 16:9 / 1200
    if (BOTC_DlgTopHitAt(w, h, offX, offY, mx, my, 960, 600)) { return true; }    // 16:10 / 1200
    if (BOTC_DlgTopHitAt(w, h, offX, offY, mx, my, 800, 600)) { return true; }     // 4:3 / 1200
    if (BOTC_DlgTopHitAt(w, h, offX, offY, mx, my, 960, 540)) { return true; }     // 1920×1080
    return false;
}

bool BOTC_DlgTopBtnHit (int w, int h, int offX, int offY, int mx, int my) {
    if (BOTC_DlgTopBtnAt(w, h, offX, offY, mx, my, 1066, 600)) { return true; }
    if (BOTC_DlgTopBtnAt(w, h, offX, offY, mx, my, 960, 600)) { return true; }
    if (BOTC_DlgTopBtnAt(w, h, offX, offY, mx, my, 800, 600)) { return true; }
    if (BOTC_DlgTopBtnAt(w, h, offX, offY, mx, my, 960, 540)) { return true; }
    return false;
}

bool BOTC_DlgDragDown_Func (bool testConds, bool runActions) {
    int p;
    int mx;
    int my;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13) {
        return true;
    }
    mx = EventMouseClickedPosXUI();
    my = EventMouseClickedPosYUI();
    g_dlgDrag[p] = 0;
    // 1 = 笔记（最高层）：760×600，顶部 46 高
    if (g_noteOn[p] && BOTC_DlgTopHit(760, 600, g_noteOffX[p], g_noteOffY[p], mx, my)) {
        g_dlgDrag[p] = 1;
        g_dlgDragOX[p] = g_noteOffX[p];
        g_dlgDragOY[p] = g_noteOffY[p];
        g_dlgDragMX[p] = mx;
        g_dlgDragMY[p] = my;
        return true;
    }
    // 2 = 剧本角色表 / 夜间行动顺序：同一个窗口的两种视图，尺寸 1180×1080、位置完全一致
    if (g_abOpen[p] || g_noOpen[p]) {
        if (BOTC_DlgTopHit(1180, 1080, g_abOffX[p], g_abOffY[p], mx, my)) {
            if (BOTC_DlgTopBtnHit(1180, 1080, g_abOffX[p], g_abOffY[p], mx, my)) {
                return true;
            }
            g_dlgDrag[p] = 2;
            g_dlgDragOX[p] = g_abOffX[p];
            g_dlgDragOY[p] = g_abOffY[p];
            g_dlgDragMX[p] = mx;
            g_dlgDragMY[p] = my;
            return true;
        }
    }
    return true;
}

bool BOTC_DlgDragUp_Func (bool testConds, bool runActions) {
    int p;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13) {
        return true;
    }
    g_dlgDrag[p] = 0;
    return true;
}

bool BOTC_DlgDragMove_Func (bool testConds, bool runActions) {
    int p;
    int nx;
    int ny;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13 || g_dlgDrag[p] == 0) {
        return true;
    }
    nx = g_dlgDragOX[p] + (EventMouseMovedPosXUI() - g_dlgDragMX[p]);
    ny = g_dlgDragOY[p] + (EventMouseMovedPosYUI() - g_dlgDragMY[p]);
    if (g_dlgDrag[p] == 1) {
        if (nx < -580) { nx = -580; }
        if (nx > 580) { nx = 580; }
        if (ny < -240) { ny = -240; }
        if (ny > 240) { ny = 240; }
        g_noteOffX[p] = nx;
        g_noteOffY[p] = ny;
        DialogSetPosition(g_noteDlg[p], c_anchorCenter, nx, ny);
        return true;
    }
    // 2 = 剧本角色表 / 夜间行动顺序：两个视图同步移动，拖一个窗口就够了
    if (nx < -370) { nx = -370; }
    if (nx > 370) { nx = 370; }
    if (ny < -30) { ny = -30; }
    if (ny > 30) { ny = 30; }
    g_abOffX[p] = nx;
    g_abOffY[p] = ny;
    DialogSetPosition(g_abNewDlg[p], c_anchorCenter, nx, ny);
    DialogSetPosition(g_noDlg[p], c_anchorCenter, nx, ny);
    return true;
}
// 私聊列表里选中了某条 → 【请求加入】冒出来；没选中就藏起来。
//   ⚠ 只动【请求加入】自己：【发起私聊】一直留着（用户 2026-09-19 明确）
void BOTC_PmJoinRender (int p) {
    int sel;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_joinPopBtn[p] == 0) {
        return;
    }
    sel = 0;
    if (!g_hidden[p] && DialogControlGetSelectedItem(g_sessList[p], p) >= 1) {
        sel = 1;
    }
    if (sel == g_joinPopOn[p]) {
        return;                    // 状态没变就别反复设置控件（免得闪）
    }
    g_joinPopOn[p] = sel;
    if (sel == 1) {
        DialogControlSetVisible(g_joinPopBtn[p], PlayerGroupSingle(p), true);
    }
    else {
        DialogControlSetVisible(g_joinPopBtn[p], PlayerGroupSingle(p), false);
    }
}
//--------------------------------------------------------------------------------------------------
// 「发起私聊」（用户 2026-09-19 重做）：点面板上的按钮 → 开自己那份魔典 → 点座位选人
//   选人模式里魔典上只留【关闭魔典】和「说书人」那一格，座位旁的 ＋ 也一起收起来；
//   点座位 = BOTC_RequestChat，点完不论成败都退出模式并关掉魔典。
//--------------------------------------------------------------------------------------------------


// 选人模式里「魔典上只留关闭」的那一套收尾（进模式、以及从右上角重新开魔典时都要重做一遍）
void BOTC_PmPickApply (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    DialogControlSetVisible(g_grimStart, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_wakeBtn, PlayerGroupSingle(p), false);
    // 【屏蔽 / 踢人选座时保留声称按钮】（用户 2026-11-10）：从声称/猜测面板进入选座后，
    //   魔典上的【声称/猜测】继续留着；再点一次 = 取消这次选座，不必非得点一个座位才能退出。
    if ((g_blockPick[p] || g_kickMode == p) && g_started && !g_isNight && !BOTC_PublicDead(BOTC_PosOf(p))) {
        DialogControlSetVisible(g_declareBtn, PlayerGroupSingle(p), true);
    }
    else {
        DialogControlSetVisible(g_declareBtn, PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_grimDeal, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_grimConfirm, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_grimShare, PlayerGroupSingle(p), false);
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        DialogControlSetVisible(g_grimTokBtn[q], PlayerGroupSingle(p), false);
    }
    if (g_blockPick[p]) {
        BOTC_BigHintShow(p, "点一个座位屏蔽他；再点已被屏蔽的座位 = 解除屏蔽。");
    }
    else {
        BOTC_BigHintShow(p, "点一个座位，向他发起私聊。");
    }
}

// 进入「发起私聊」选人：先把别的选人状态挡掉，再开魔典
void BOTC_PmPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_SessRepair();
    if (g_pmPick[p]) {
        BOTC_PmPickEnd(p);        // 已经开着：再点一下 = 取消「发起私聊」
        return;
    }
    // 【卡私聊 · 自愈】（用户 2026-10-03）：这些「选人中」标记如果已经不该在（他没被唤醒 / 面板早关了），
    //   先替他清掉 ---- 否则会被这句话永久卡住：点谁都没用，也点不了人。
    if (!g_awake[BOTC_PosOf(p)]) {      // g_awake 是格子口径：他本人有没有被唤醒
        if (g_skillPicking[BOTC_PosOf(p)]) {
            g_skillPicking[BOTC_PosOf(p)] = false;
            DialogSetVisible(g_skillDlg[BOTC_PosOf(p)], PlayerGroupSingle(p), false);
        }
        if (g_ftPick[p]) {
            g_ftPick[p] = false;
        }
        if (g_declarePick[p]) {
            g_declarePick[p] = false;
            BOTC_DeclareRender();
        }
    }
    // 处决 / 死亡标记模式是**说书人**的东西，别拿来挡玩家的私聊（用户 2026-10-03）
    if ((g_execPick || g_deadPick) && p == g_teller) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【发起私聊】。");
        return;
    }
    if (g_declarePick[p] || g_skillPicking[BOTC_PosOf(p)] || g_ftPick[p]) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【发起私聊】。");
        return;
    }
    g_pmPick[p] = true;
    BOTC_PanelOpen(p, 2);          // 关掉别的大面板 + 摊开自己那份魔典
    BOTC_PmPickApply(p);           // 魔典上只留【关闭魔典】（想找说书人就点「说书人」那一格）
    BOTC_Notice(p, "发起私聊：点魔典上的座位选人。");
}

// 退出「发起私聊」：还原魔典上的按钮和 ＋，把长驻提示收掉
void BOTC_PmPickEnd (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_pmPick[p]) {
        g_blockPick[p] = false;
        return;
    }
    g_pmPick[p] = false;
    g_blockPick[p] = false;
    BOTC_BigHintHide(p);
    BOTC_NomUI();                  // 发牌 / 开始 / 处决 / 死亡 那几个按钮按当前阶段还原
    BOTC_WakeRender();             // 【唤醒】按昼夜还原
    BOTC_DeclareRender();          // 【声称】还原
    BOTC_GrimRelayout();           // 座位旁的 ＋ 还原
    BOTC_GrimRender(p);
}

// 【屏蔽】（用户 2026-11-06）：token / 身份标记面板里点【屏蔽】→ 魔典上点一个座位屏蔽 / 解除屏蔽。
void BOTC_BlockStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【说书人不参与屏蔽】（用户 2026-11-06）：说书人不能屏蔽任何玩家，玩家也不能屏蔽说书人。
    //   【按钮对说书人可见】（用户 2026-11-10）：按钮不隐藏，点进来这里只提示。
    if (p == g_teller) {
        BOTC_Notice(p, "说书人无法屏蔽玩家。");
        return;
    }
    BOTC_SessRepair();
    if (g_blockPick[p]) {
        BOTC_BlockEnd(p);
        return;
    }
    if (g_pmPick[p]) {
        BOTC_PmPickEnd(p);         // 正在「发起私聊」选人：先收掉那一套
    }
    if (!g_awake[BOTC_PosOf(p)]) {
        if (g_skillPicking[BOTC_PosOf(p)]) {
            g_skillPicking[BOTC_PosOf(p)] = false;
            DialogSetVisible(g_skillDlg[BOTC_PosOf(p)], PlayerGroupSingle(p), false);
        }
        if (g_ftPick[p]) {
            g_ftPick[p] = false;
        }
        if (g_declarePick[p]) {
            g_declarePick[p] = false;
            BOTC_DeclareRender();
        }
    }
    if ((g_execPick || g_deadPick) && p == g_teller) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【屏蔽】。");
        return;
    }
    if (g_declarePick[p] || g_skillPicking[BOTC_PosOf(p)] || g_ftPick[p]) {
        BOTC_Notice(p, "先把当前这次选择做完，再用【屏蔽】。");
        return;
    }
    g_blockPick[p] = true;
    g_pmPick[p] = true;
    BOTC_PanelOpen(p, 2);
    BOTC_PmPickApply(p);
    BOTC_Notice(p, "屏蔽：点魔典上的座位选择要屏蔽的玩家；再点一次已屏蔽的座位即可解除。");
}

void BOTC_BlockEnd (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    g_blockPick[p] = false;
    if (g_pmPick[p]) {
        BOTC_PmPickEnd(p);
    }
}

//--------------------------------------------------------------------------------------------------
// 私聊
//--------------------------------------------------------------------------------------------------
// 【玩家聊天禁用彩色文字】（用户 2026-11-03）：玩家输入的 `<c val="xxxxxx">…</c>` 会被当成
//   界面富文本解析，能伪造系统提示的配色。这里只删掉颜色标签本身，其余字符（包括普通 `<` / `>`）原样保留。
string BOTC_ChatNoColor (string s) {
    string out;
    string ch;
    string nx;
    string nx2;
    int i;
    int n;
    bool inTag;
    out = "";
    inTag = false;
    n = StringLength(s);
    for (i = 1; i <= n; i += 1) {
        ch = StringSub(s, i, i);
        if (ch == "<") {
            nx = "";
            nx2 = "";
            if (i + 1 <= n) {
                nx = StringSub(s, i + 1, i + 1);
            }
            if (i + 2 <= n) {
                nx2 = StringSub(s, i + 2, i + 2);
            }
            if ((nx == "c" || nx == "C") && nx2 == " ") {
                inTag = true;
                continue;
            }
            if (nx == "/" && (nx2 == "c" || nx2 == "C")) {
                inTag = true;
                continue;
            }
        }
        if (ch == ">") {
            if (inTag) {
                inTag = false;
                continue;
            }
        }
        if (!inTag) {
            out = out + ch;
        }
    }
    return out;
}

//--------------------------------------------------------------------------------------------------
// 公聊 / 私聊换行（用户 2026-11-07 重构）
//   · 宽度按显示效果算：中文 / 全角 = 2，英文 / 数字 / 半角 = 1，颜色码与样式标签不计宽。
//   · 首行容量 = 容器内容区宽度 − 说话人「[编号] 名字：」前缀宽度；续行不重复前缀，
//     按前缀宽度缩进对齐，所以每行可用的正文宽度相同。
//   · 能单行就不换行；需要换行时优先在不超过容量的最后一个中英文标点后断开（标点留在行尾），
//     没有标点时逐字符累加，在即将超限处断开，并尽量不拆开英文单词 / 数字。
//   ⚠ StringSub 仍按 UTF-8 字节位置算，所以扫描按完整字符/占位符前进，不能按字节直接切。
//--------------------------------------------------------------------------------------------------

bool BOTC_IsAsciiChar (string c) {
    if (StringLength(c) != 1) { return false; }
    if (StringFind("0123456789", c, false) >= 0) { return true; }
    if (StringFind("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c, false) >= 0) { return true; }
    if (StringFind(" !\"#$%&'()*+,-./:;<=>?@[]^_`{|}~", c, false) >= 0) { return true; }
    return false;
}

bool BOTC_IsDigitChar (string c) {
    return StringFind("0123456789", c, false) >= 0;
}

bool BOTC_AllDigits (string s, int a, int b) {
    int i;
    if (a > b) { return false; }
    for (i = a; i <= b; i += 1) {
        if (!BOTC_IsDigitChar(StringSub(s, i, i))) { return false; }
    }
    return true;
}

// 只处理颜色 / 样式标签和字符宽窄，不展开「玩家N」「@@N@@」占位符。
//   玩家名本身也可能包含这些字样，用这个函数避免姓名宽度计算递归。
int BOTC_PlainWidth (string s) {
    int i;
    int n;
    int gt;
    int w;
    n = StringLength(s);
    i = 1;
    w = 0;
    while (i <= n) {
        if (StringSub(s, i, i) == "<") {
            if (StringSub(s, i, i + 1) == "<c" || StringSub(s, i, i + 2) == "</c" ||
                StringSub(s, i, i + 1) == "<s" || StringSub(s, i, i + 2) == "</s") {
                gt = StringFind(StringSub(s, i, n), ">", false);
                if (gt >= 0) {
                    i = i + gt + 1;
                    continue;
                }
            }
            w = w + 1;
            i = i + 1;
            continue;
        }
        if (BOTC_IsAsciiChar(StringSub(s, i, i))) {
            w = w + 1;
            i = i + 1;
        }
        else {
            w = w + 2;
            i = i + 3;
        }
    }
    return w;
}

// 某个位置上「[编号] 名字」的显示宽度
int BOTC_NameWidth (int pos) {
    if (pos < 1 || pos > 13) { return 0; }
    return BOTC_PlainWidth(BOTC_NameTag(pos)) + BOTC_PlainWidth(TextToString(BOTC_SeatNameText(pos)));
}

// 从 i 开始的一个「不可拆分单元」的结束位置：颜色/样式标签、@@ 说话人标记、
//   「玩家N」占位符、「说书人：」占位符整体算一个单元，普通字符按 1 或 3 字节前进。
int BOTC_TextUnitEnd (string s, int i, int n) {
    int j;
    int gt;
    if (i > n) { return n; }
    if (StringSub(s, i, i) == "<") {
        if (StringSub(s, i, i + 1) == "<c" || StringSub(s, i, i + 2) == "</c" ||
            StringSub(s, i, i + 1) == "<s" || StringSub(s, i, i + 2) == "</s") {
            gt = StringFind(StringSub(s, i, n), ">", false);
            if (gt >= 0) { return i + gt; }
        }
        return i;
    }
    if (StringSub(s, i, i + 1) == "@@") {
        j = i + 2;
        while (j <= n && StringSub(s, j, j) != "@") { j = j + 1; }
        if (j + 1 <= n && StringSub(s, j + 1, j + 1) == "@" && BOTC_AllDigits(s, i + 2, j - 1)) {
            return j + 1;
        }
        return i;
    }
    if (StringSub(s, i, i + 5) == "玩家") {
        j = i + 6;
        while (j <= n && BOTC_IsDigitChar(StringSub(s, j, j))) { j = j + 1; }
        if (j > i + 6) { return j - 1; }
        return i + 5;
    }
    if (StringSub(s, i, i + 8) == "说书人" && StringSub(s, i + 9, i + 11) == "：") {
        return i + 11;
    }
    if (BOTC_IsAsciiChar(StringSub(s, i, i))) { return i; }
    if (i + 2 <= n) { return i + 2; }
    return n;
}

// 一个不可拆分单元的显示宽度
int BOTC_TextUnitWidth (string s, int i, int end) {
    int len;
    int v;
    int pos;
    if (end < i) { return 0; }
    len = end - i + 1;
    if (StringSub(s, i, i) == "<" && len > 1) { return 0; }
    if (len >= 4 && StringSub(s, i, i + 1) == "@@" && StringSub(s, end - 1, end) == "@@") {
        v = StringToInt(StringSub(s, i + 2, end - 2));
        if (v == 0) { return BOTC_NameWidth(1) + 2; }
        if (v >= 100 && v <= 113) { return BOTC_NameWidth(BOTC_PosOf(v - 100)); }
        if (v >= 1 && v <= 13) { return BOTC_NameWidth(v); }
        return len;
    }
    if (StringSub(s, i, i + 5) == "玩家") {
        if (end >= i + 6) {
            v = StringToInt(StringSub(s, i + 6, end));
            if (v >= 1 && v <= 13) {
                pos = v + 1;
                if (pos > 13) { pos = 13; }
                return BOTC_NameWidth(pos);
            }
        }
        return 4;
    }
    if (len == 12 && StringSub(s, i, i + 8) == "说书人") { return BOTC_NameWidth(1) + 2; }
    if (BOTC_IsAsciiChar(StringSub(s, i, i))) { return 1; }
    return 2;
}

// 整段文字的渲染可见宽度
int BOTC_TextWidth (string s) {
    int i;
    int n;
    int end;
    int w;
    n = StringLength(s);
    i = 1;
    w = 0;
    while (i <= n) {
        end = BOTC_TextUnitEnd(s, i, n);
        if (end < i) { end = i; }
        w = w + BOTC_TextUnitWidth(s, i, end);
        i = end + 1;
    }
    return w;
}

// 聊天窗每行标签宽 872 像素、20 号粗体：半角约 10.9 像素 → 80 个半角。
//   这里取 78，预留 2 个半角给行尾悬挂的标点（标点不留在下一行开头），
//   保证「一行满宽 + 句末标点」也不会超出标签宽度被裁掉。
//   公聊和私聊分别保留独立入口，后面任何一侧调宽/调窄只改这里。
int BOTC_ChatWrapWidthPub () { return 78; }
int BOTC_ChatWrapWidthPm () { return 78; }

string BOTC_Spaces (int n) {
    string s;
    int i;
    s = "";
    if (n < 0) { n = 0; }
    for (i = 1; i <= n; i += 1) {
        s = s + " ";
    }
    return s;
}

int BOTC_WrapSkipSpace (string s, int pos, int n) {
    while (pos <= n && StringSub(s, pos, pos) == " ") {
        pos = pos + 1;
    }
    return pos;
}

// 私聊行的「[私聊] @@1NN@@：」前缀结束位置；没有说话人前缀（系统消息）返回 0。
//   只认**行首**的说话人前缀，避免系统消息正文里提到别人时被误当成前缀。
//   「[私聊] 」= 2 个汉字 6 字节 + 3 个半角 = 9 字节；说话人标记固定 7 字节；冒号是全角 3 字节。
int BOTC_PrefixEnd (string s, int n) {
    int q;
    int p;
    if (StringSub(s, 1, 9) == "[私聊] ") {
        q = 10;
    }
    else if (StringSub(s, 1, 2) == "@@") {
        q = 1;
    }
    else {
        return 0;
    }
    if (q + 9 > n) { return 0; }
    for (p = 1; p <= 13; p += 1) {
        if (StringSub(s, q, q + 6) == BOTC_SayToken(p)) {
            if (StringSub(s, q + 7, q + 9) == "：") {
                return q + 9;
            }
        }
    }
    return 0;
}

bool BOTC_UnitIsWord (string s, int i, int end) {
    if (end != i) { return false; }
    return StringFind("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", StringSub(s, i, i), false) >= 0;
}

bool BOTC_UnitIsClosePunct (string s, int i, int end) {
    string u;
    u = StringSub(s, i, end);
    if (StringFind("，。！？；：、）》」』】”’…—", u, false) >= 0) { return true; }
    if (StringFind(",.!?;:)]}", u, false) >= 0) { return true; }
    return false;
}

bool BOTC_UnitIsOpenPunct (string s, int i, int end) {
    string u;
    u = StringSub(s, i, end);
    if (StringFind("（《「『【“‘", u, false) >= 0) { return true; }
    if (StringFind("([{", u, false) >= 0) { return true; }
    return false;
}

bool BOTC_UnitIsBreakAfter (string s, int i, int end) {
    if (StringSub(s, i, end) == " ") { return true; }
    return BOTC_UnitIsClosePunct(s, i, end);
}

// 从 pos（1 基）起算一行：cap = 这一行正文允许的可见宽度。返回结束位置（1 基、含端点）。
//   能整段放下就返回 n；需要断开时优先用不超过容量的最后一个标点，其次逐字符累加；
//   遇到英文单词/数字时尽量整词移到下一行，避免拆开。
int BOTC_WrapCut (string s, int pos, int cap, int n) {
    int i;
    int end;
    int cut;
    int cutStart;
    int lastPunct;
    int wordStart;
    int w;
    int uw;
    bool inWord;
    if (pos < 1) { pos = 1; }
    if (pos > n) { return n; }
    if (cap < 2) { cap = 2; }
    w = 0;
    cut = pos - 1;
    cutStart = pos;
    lastPunct = 0;
    wordStart = 0;
    inWord = false;
    i = pos;
    while (i <= n) {
        end = BOTC_TextUnitEnd(s, i, n);
        uw = BOTC_TextUnitWidth(s, i, end);
        if (w + uw > cap) {
            if (cut < pos) { return end; }
            // 行首禁则：收尾标点必须留在本行末尾，宁可稍微超一点也不能跑到下一行开头
            if (BOTC_UnitIsClosePunct(s, i, end)) {
                while (i <= n) {
                    if (!BOTC_UnitIsClosePunct(s, i, BOTC_TextUnitEnd(s, i, n))) { break; }
                    end = BOTC_TextUnitEnd(s, i, n);
                    i = end + 1;
                }
                return end;
            }
            if (lastPunct >= pos) { return lastPunct; }
            if (BOTC_UnitIsWord(s, i, end) && inWord && wordStart > pos) {
                return wordStart - 1;
            }
            if (cut >= pos && BOTC_UnitIsOpenPunct(s, cutStart, cut) && cutStart > pos) {
                return cutStart - 1;
            }
            return cut;
        }
        w = w + uw;
        cut = end;
        cutStart = i;
        if (BOTC_UnitIsBreakAfter(s, i, end)) { lastPunct = end; }
        if (BOTC_UnitIsWord(s, i, end)) {
            if (!inWord) {
                wordStart = i;
                inWord = true;
            }
        }
        else {
            inWord = false;
        }
        i = end + 1;
    }
    return n;
}

// 【断行扫描】（用户 2026-11-03）StringSub 按 UTF-8 字节位置算，中文一个汉字 3 字节，
//   直接按字节额度切会切在半个汉字上：前一行末尾丢掉那半个字，下一行开头就显示成「?」。
//   这里只在**完整标点之后**断行；只有整段读到标点才算命中，断点天然落在字符边界上。
//   返回断行后的结束位置（1 基、含端点），不是标点就返回 0。
int BOTC_LineSepAt (string s, int i) {
    if (StringSub(s, i, i + 2) == "，") { return i + 2; }
    if (StringSub(s, i, i + 2) == "。") { return i + 2; }
    if (StringSub(s, i, i + 2) == "！") { return i + 2; }
    if (StringSub(s, i, i + 2) == "？") { return i + 2; }
    if (StringSub(s, i, i + 2) == "；") { return i + 2; }
    if (StringSub(s, i, i + 2) == "：") { return i + 2; }
    if (StringSub(s, i, i + 2) == "、") { return i + 2; }
    if (StringSub(s, i, i + 2) == "）") { return i + 2; }
    if (StringSub(s, i, i + 2) == "」") { return i + 2; }
    if (StringSub(s, i, i) == " ") { return i; }
    if (StringSub(s, i, i) == ",") { return i; }
    if (StringSub(s, i, i) == ".") { return i; }
    if (StringSub(s, i, i) == "!") { return i; }
    if (StringSub(s, i, i) == "?") { return i; }
    if (StringSub(s, i, i) == ";") { return i; }
    return 0;
}

// 从 pos（1 基）起算一行：budget = 这一行允许的字节数（含端点），extra = 窗口里没标点时
//   最多往后多看几个字节，n = 整段长度。返回这一行的结束位置（1 基、含端点）。
//   找不到任何标点就返回 n（不切，交给界面裁剪），绝不切在半个汉字上。
int BOTC_LineCut (string s, int pos, int budget, int extra, int n) {
    int i;
    int lim;
    int cut;
    int keep;
    if (n - pos + 1 <= budget) {
        return n;
    }
    cut = 0;
    lim = pos + budget - 1;
    for (i = pos; i <= lim; i += 1) {
        keep = BOTC_LineSepAt(s, i);
        if (keep > pos && keep <= lim) {
            cut = keep;
        }
    }
    if (cut > 0) {
        return cut;
    }
    lim = pos + budget + extra;
    if (lim > n) { lim = n; }
    for (i = pos + budget; i <= lim; i += 1) {
        keep = BOTC_LineSepAt(s, i);
        if (keep > pos && keep <= lim) {
            return keep;
        }
    }
    return n;
}

// 【公聊按屏蔽过滤】（用户 2026-11-06）：只有没屏蔽说话人的玩家才收到这一行。
void BOTC_PubSayLine (int from, string s) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        if (BOTC_Blocked(i, from)) {
            continue;
        }
        BOTC_ChatShow(i, s);
    }
    BOTC_PubLogStore(s);
}

void BOTC_PubSay (int p, string tag, string msg) {
    string head;
    string part;
    int n;
    int pos;
    int end;
    int i;
    int prefW;
    int cap;
    bool first;
    playergroup pg;
    // 【取名阶段禁止聊天】（用户 2026-11-13）：公聊最后一道兜底，取名阶段任何来源都不许发公聊。
    if (g_introOn) {
        return;
    }
    msg = BOTC_ChatNoColor(msg);
    // 【说话人过映射】（用户 2026-10-07）：p 是 EventPlayer() 给的**物理座位**，而日志 / 私聊
    //   渲染时按**位置**取名字和编号 —— 先换算成位置，换说书人之后才不会把"我说的话"记到对方头上。
    head = tag + BOTC_SayToken(p) + "：";
    g_chatWhoNow = BOTC_PosOf(p);  // 这一行是谁说的（渲染时名字按他的颜色显示）
    // 【自动换行】（用户 2026-11-01；2026-11-07 改为按可见宽度断行）：一行放不下时结尾会出现省略号 →
    //   按渲染可见宽度（全角 2 / 半角 1，颜色标签不计）切成多行。首行容量 = 公聊内容区宽度 −
    //   「[编号] 名字：」前缀宽度；续行不重复前缀，按前缀宽度缩进对齐。
    //   能单行就不换行；需要换行时优先在不超过容量的最后一个中英文标点后断开，
    //   没有标点时逐字符累加，并尽量不拆开英文单词 / 数字。
    prefW = BOTC_TextWidth(head);
    cap = BOTC_ChatWrapWidthPub() - prefW;
    if (cap < 12) { cap = 12; }
    n = StringLength(msg);
    pos = 1;
    first = true;
    while (pos <= n) {
        pos = BOTC_WrapSkipSpace(msg, pos, n);
        if (pos > n) { break; }
        end = BOTC_WrapCut(msg, pos, cap, n);
        part = StringSub(msg, pos, end);
        if (first) {
            BOTC_PubSayLine(p, head + part);
            first = false;
        }
        else {
            BOTC_PubSayLine(p, BOTC_Spaces(prefW) + part);
        }
        pos = end + 1;
    }
    // 【字幕也按屏蔽过滤】（用户 2026-11-06）：屏蔽了说话人就不弹他的公聊字幕。
    pg = PlayerGroupEmpty();
    for (i = 1; i <= 13; i += 1) {
        if (!BOTC_Blocked(i, p)) {
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText(tag) + BOTC_SpeakerNameText(p) + StringToText(": " + msg));
    // UI 音效：公屏每说一句都放一声（用户 2026-09-16 要求；只对公屏消息，私聊不响）
    BOTC_PlaySfx(g_sfxChatName);
}

// 回车发送（用户 2026-09-19）：私聊输入框 / 邪恶小窗输入框里按回车，等于点自己的发送按钮
bool BOTC_EditDo (bool testConds, bool runActions) {
    int p;
    if (!runActions) {
        return true;
    }
    p = EventPlayer();
    if (p < 1 || p > 13) {
        return true;
    }
    if (EventDialogControl() == g_pmEdit[p]) {
        BOTC_SendPm(p);
        return true;
    }
    if (EventDialogControl() == g_evilEdit) {
        BOTC_EvilSend(p);
        return true;
    }
    return true;
}

// 回车发送（输入框）这条路径也打标记：这期间冒出来的提示不写进私聊日志
bool BOTC_EditDone_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_EditDo(testConds, runActions);
    g_inClick = false;
    return r;
}

void BOTC_SendPm (int p) {
    string msg;
    string line;
    string tag;
    int s;
    int i;
    playergroup pg;
    // 【取名阶段禁止聊天】（用户 2026-11-13）：私聊输入框也不许发言。
    if (g_introOn) {
        BOTC_Notice(p, "取名阶段禁止聊天，请在屏幕中央输入框取名。");
        return;
    }
    // 【剧本以外禁用私聊】（用户 2026-11-13）：选剧本 / 自定义剧本页面不接受私聊发言
    if (BOTC_PmOff()) {
        return;
    }
    // 白天时段：公聊时间不许私聊（说书人例外，他要用私聊做提示）；
    //   **跟说书人在同一条私聊里的人也是破例允许的**（用户 2026-09-16 明确）----
    //   只要这条私聊里含玩家1，公聊时间照样能收发。
    if (g_chatMode == 2 && !g_cultOn && p != g_teller) {
        s = g_mySess[p];
        if (s == 0 || !g_member[(s * 14) + g_teller]) {
            BOTC_Notice(p, "现在是公聊时间，先别私聊；等私聊时间再单独找人聊（跟说书人的私聊可以）。");
            return;
        }
    }
    // 提名环节：说书人照样能私聊；异教领袖的教派投票不属于提名，私聊也照常开放。
    if (g_phase != 0 && !g_cultOn && p != g_teller) {
        s = g_mySess[p];
        if (s == 0 || !g_member[(s * 14) + g_teller]) {
            BOTC_Notice(p, "提名环节进行中，暂时不能私聊（跟说书人的私聊可以）。");
            return;
        }
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你还没有在进行私聊。点面板上的玩家名字可以发起私聊。");
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_pmEdit[p], p);
    msg = BOTC_ChatNoColor(msg);
    if (StringLength(msg) == 0) {
        return;
    }
    if (p == g_teller) {
        tag = "[私聊] ";               // 说书人那格由 BOTC_LineText 渲染成「[说书人] 他的玩家ID」
    }
    else {
        tag = "[私聊] ";               // 玩家：真实号已经写在名字里了（[2]玩家1）
    }
    line = tag + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);      // 这一行是谁说的（私聊窗 / 私聊记录里名字按他的颜色显示）
    BOTC_AllPmStore(line, s);          // 【全部私聊】（2026-11-09）：整条消息只存一次，避免多收件人重复
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, line);
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText(tag) + BOTC_SpeakerNameText(p) + StringToText(": " + msg));
    libNtve_gf_SetDialogItemText(g_pmEdit[p], StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_pmEdit[p], PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pmEdit[p], PlayerGroupSingle(p), true);
}

// 【私聊模式】回车发送（用户 2026-09-19）：把玩家自己打字的内容发进他当前那条私聊
//   ⚠ 没在私聊里 / 时段或阶段不允许时，只提示、不发送（避免私聊内容漏进公屏）
void BOTC_SayPmText (int p, string msg) {
    string line;
    string tag;
    int s;
    int i;
    playergroup pg;
    if (p < 1 || p > 13) {
        return;
    }
    // 【取名阶段禁止聊天】（用户 2026-11-13）：私聊频道同样禁止发言。
    if (g_introOn) {
        BOTC_Notice(p, "取名阶段禁止聊天，请在屏幕中央输入框取名。");
        return;
    }
    msg = BOTC_ChatNoColor(msg);
    if (StringLength(msg) == 0) {
        return;
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你当前没有私聊对象：这条内容没有发出去（不会进公聊）。想公聊请按 Tab 或点【聊天：公聊】切换，想私聊请先发起或加入。");
        return;
    }
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，先别私聊（跟说书人的私聊除外）。");
        return;
    }
    if (g_phase != 0 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "提名环节进行中，暂时不能私聊（跟说书人的私聊可以）。");
        return;
    }
    tag = "[私聊] ";
    line = tag + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);
    BOTC_AllPmStore(line, s);          // 【全部私聊】（2026-11-09）：整条消息只存一次，避免多收件人重复
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, line);
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText(tag) + BOTC_SpeakerNameText(p) + StringToText(": " + msg));
}

// 【一键发送魔典 · 单条标注】只读玩家自己那一行，不读说书人真值。
// 间谍 / 寡妇看到的是自己的快照行，发送时也按快照读。
int BOTC_GrimShareMark (int ob, int q) {
    if (ob >= 1 && ob <= 13 && g_grimSnapOn[ob]) {
        return g_grimSnapMark[(ob * 14) + q];
    }
    return g_mark[(ob * 14) + q];
}

bool BOTC_GrimShareTok (int ob, int q, int t) {
    int rown;
    if (ob < 1 || ob > 13) {
        return false;
    }
    rown = (((ob * 14) + q) * 256);
    if (g_grimSnapOn[ob]) {
        return g_grimSnapTok[rown + t];
    }
    return g_tokOn[rown + t];
}

string BOTC_GrimShareRoleText (int ob, int q) {
    int role;
    int team;
    string roleName;
    string id;
    string label;
    bool hasPhil;
    bool hasDrunk;
    bool hasLunatic;
    bool hasCannibal;
    bool hasAlchemist;
    bool hasMarionette;
    bool hasWudao;
    bool hasLm;
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return "";
    }
    role = BOTC_GrimShareMark(ob, q) - 1;
    if (role < 0 || role > 163) {
        role = -1;
        roleName = "";
    }
    else {
        roleName = g_roleName[role];
    }
    hasPhil = BOTC_GrimShareTok(ob, q, 70);
    hasDrunk = BOTC_GrimShareTok(ob, q, 8);
    hasLunatic = BOTC_GrimShareTok(ob, q, 49);
    hasCannibal = BOTC_GrimShareTok(ob, q, 97);
    hasAlchemist = BOTC_GrimShareTok(ob, q, 123);
    hasMarionette = BOTC_GrimShareTok(ob, q, 118);
    hasWudao = BOTC_GrimShareTok(ob, q, 140);
    hasLm = BOTC_GrimShareTok(ob, q, 134);
    id = "";
    if (hasDrunk) { id = "酒鬼"; }
    else if (hasLunatic) { id = "疯子"; }
    else if (hasCannibal) { id = "食人族"; }
    else if (hasAlchemist) { id = "炼金术士"; }
    else if (hasMarionette) { id = "提线木偶"; }
    else if (hasWudao) { id = "悟道者"; }
    else if (hasLm) { id = "小怪宝"; }
    if (id != "") {
        if (hasPhil) {
            label = "哲学家" + id;
        }
        else {
            label = id;
        }
        if (roleName != "" && roleName != id) {
            if (hasPhil) {
                label = label + "（" + roleName + "）";
            }
            else {
                label = label + "（" + roleName + "）";
            }
        }
    }
    else {
        if (hasPhil) {
            label = "哲学家";
            if (roleName != "" && roleName != "哲学家") {
                label = label + "（" + roleName + "）";
            }
        }
        else {
            label = roleName;
        }
    }
    if (label == "") {
        return "";
    }
    if (role >= 0) {
        team = BOTC_RoleTeam(role);
        if (BOTC_GrimShareTok(ob, q, 15) && (team == 0 || team == 1)) {
            label = "（邪恶）" + label;
        }
        else {
            if (BOTC_GrimShareTok(ob, q, 14) && (team == 2 || team == 3)) {
                label = "（善良）" + label;
            }
        }
    }
    return label;
}

void BOTC_GrimShareRender () {
    int i;
    int q;
    // 【只有说书人的魔典才有【发送魔典】】（用户 2026-11-01）：其他玩家的魔典不显示这个按钮
    // 【间谍（18）/ 寡妇（75）也能发送】（用户 2026-11-04）：他们看到的是真魔典快照
    DialogControlSetVisible(g_grimShare, PlayerGroupAll(), false);
    if (g_phase != 0) {
        return;
    }
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (g_pmPick[g_teller]) {
        return;
    }
    if (!g_started && !g_dealConfirmed) {
        return;
    }
    DialogControlSetVisible(g_grimShare, PlayerGroupSingle(g_teller), true);
    for (i = 1; i <= 13; i += 1) {
        if (i == g_teller || !g_seatOn[i]) {
            continue;
        }
        if (!g_grimSnapOn[i]) {
            continue;
        }
        q = BOTC_PosOf(i);
        if (q < 2 || q > 13) {
            continue;
        }
        // 【按「拥有能力」判】（用户 2026-11-09）：真间谍 / 真寡妇，以及哲学家、食人族、
        //   科学怪人、赋予能力等借到这两个能力的人，都能把抄录的魔典发出去。
        if (BOTC_HasAbility(q, 18) || BOTC_HasAbility(q, 75)) {
            DialogControlSetVisible(g_grimShare, PlayerGroupSingle(i), true);
        }
    }
}

// 一键把自己那份魔典的标注发到当前私聊。
// 【只能私聊】（用户 2026-10-22）：公聊状态下直接拒绝，绝不把魔典内容发到公屏。
void BOTC_ShareGrim (int p) {
    int q;
    int s;
    int n;
    int batch;
    int sec;
    string roleText;
    string line;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_grimShareCd[p] > 0) {
        sec = (g_grimShareCd[p] + 1) / 2;
        BOTC_Notice(p, "【一键发送魔典】冷却中：还需" + IntToString(sec) + " 秒。");
        return;
    }
    if (g_chatSay[p] != 1) {
        BOTC_Notice(p, "【一键发送魔典】只能在私聊中发送：先切到【聊天：私聊】并进入一条私聊。");
        return;
    }
    s = g_mySess[p];
    if (s == 0) {
        BOTC_Notice(p, "你现在不在私聊里：先发起或加入私聊，再发送魔典。");
        return;
    }
    if (g_chatMode == 2 && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，当前私聊不能发送；跟说书人的私聊除外。");
        return;
    }
    n = 0;
    batch = 0;
    line = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        roleText = BOTC_GrimShareRoleText(p, q);
        if (roleText == "") {
            continue;
        }
        roleText = IntToString(g_lab[q] + g_nameNumShift) + "：" + roleText;
        if (line == "") {
            line = roleText;
        }
        else {
            line = line + "；" + roleText;
        }
        n = n + 1;
        batch = batch + 1;
        if (batch == 4) {
            BOTC_SayPmText(p, line);
            line = "";
            batch = 0;
        }
    }
    if (batch > 0) {
        BOTC_SayPmText(p, line);
    }
    if (n > 0) {
        g_grimShareCd[p] = 30;
    }
    else {
        BOTC_Notice(p, "你的魔典上还没有可发送的身份或标注。");
    }
}

// 【一键发送魔典 · 独立冷却】每拍 0.5 秒，每个物理玩家单独计时。
void BOTC_GrimShareCdTick () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (g_grimShareCd[p] > 0) {
            g_grimShareCd[p] = g_grimShareCd[p] - 1;
        }
    }
}
// 【点说书人所在房间 = 只想和说书人单独私聊】（用户 2026-11-05）：
//   玩家从私聊列表点「请求加入」、或直接点说书人的座位时，只要说书人正在别人的私聊里，
//   都不再走房主审批，也不会把玩家塞进那间房；只提醒说书人「谁想和你私聊」，
//   由说书人自己决定要不要离开当前私聊去找他。
//   要真正加入那间房，请点【发起私聊】后再点房间里的房主或其他成员。
void BOTC_PmTellWant (int p) {
    int q;
    q = g_teller;
    if (p < 1 || p > 13 || p == q) {
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：屏蔽关系下连「想与你私聊」的提醒也不发。
    if (BOTC_Blocked(p, q)) {
        BOTC_Notice(p, "你已屏蔽说书人，先解除屏蔽才能私聊。");
        return;
    }
    if (BOTC_Blocked(q, p)) {
        BOTC_Notice(p, "说书人已屏蔽你，无法向他发起私聊。");
        return;
    }
    if (g_mySess[p] != 0) {
        BOTC_Notice(p, "你正在私聊中，请先退出。");
        return;
    }
    if (g_pmCool[(p * 14) + q] > 0) {
        BOTC_Notice(p, "你已经提醒过说书人了，请稍后再试。");
        return;
    }
    g_pmCool[(p * 14) + q] = 30;      // 30 拍 = 15 秒，避免连续点击刷屏
    BOTC_NoticeKeep(q, BOTC_NameStr(BOTC_PosOf(p)) + " 想与你私聊，是否去找他由你决定。");
    BOTC_PlaySfxTo(g_sfxReqName, q);
    BOTC_Notice(p, "已提醒说书人：你想与他私聊；要加入现有房间，请发起私聊后点房主或其他成员。");
}


void BOTC_RequestChat (int p, int q) {
    BOTC_SessRepair();
    // 【屏蔽】（用户 2026-11-06）：任意一方屏蔽了对方，就不允许发起私聊 / 提醒说书人。
    if (BOTC_Blocked(p, q)) {
        BOTC_Notice(p, "你已屏蔽 " + BOTC_NameStr(BOTC_PosOf(q)) + "，先解除屏蔽才能私聊。");
        return;
    }
    if (BOTC_Blocked(q, p)) {
        BOTC_Notice(p, "对方已屏蔽你，无法向他发起私聊。");
        return;
    }
    // 【夜晚】（用户 2026-09-20）：玩家不能主动找人私聊 ---- 会打断说书人正在进行的私聊；
    //   夜里要聊，一律由说书人自己发起。
    //   【夜晚找说书人只提醒】（用户 2026-11-04）：玩家可以在夜里选说书人，但不建会话，
    //   只把「某人想与你私聊」提醒给说书人，由说书人自己决定什么时候去找他。
    if (g_isNight && p != g_teller) {
        if (q == g_teller) {
            if (g_mySess[p] != 0) {
                BOTC_Notice(p, "你正在私聊中，请先退出。");
                return;
            }
            if (g_pmCool[(p * 14) + q] > 0) {
                BOTC_Notice(p, "你已经提醒过说书人了，请稍后再试。");
                return;
            }
            g_pmCool[(p * 14) + q] = 30;      // 30 拍 = 15 秒，避免连续点击刷屏
            BOTC_NoticeKeep(g_teller, BOTC_NameStr(BOTC_PosOf(p)) + " 在夜晚请求与你私聊，是否去找他由你决定。");
            BOTC_PlaySfxTo(g_sfxReqName, g_teller);
            BOTC_Notice(p, "已提醒说书人：你想与他私聊，请等说书人来找你。");
            return;
        }
        BOTC_Notice(p, "现在是夜晚：不能主动找人私聊，等说书人来找你。");
        return;
    }
    // 发言时段限制（跟 BOTC_SendPm 同一套）：
    //   ① 公聊时间不许发起私聊 ---- 但**跟说书人（玩家1）的私聊是破例允许的**（用户 2026-09-16 明确）；
    //   ② 提名环节进行中不发新的私聊请求（跟「提名时不能私聊」保持一致）。
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && q != g_teller) {
        BOTC_Notice(p, "现在是公聊时间，先别私聊；等私聊时间再单独找人聊（找说书人是可以的）。");
        return;
    }
    if (g_phase != 0 && !g_cultOn && p != g_teller && q != g_teller) {
        BOTC_Notice(p, "提名环节进行中，暂时不能和别人发起私聊（找说书人可以）。");
        return;
    }
    if (q == p) {
        BOTC_Notice(p, "不能和自己私聊。");
        return;
    }
    if (p == g_teller) {
        if (g_mySess[q] != 0) {
            BOTC_JoinSess(g_teller, g_mySess[q]);
            return;
        }
        BOTC_CreateSess(g_teller, q);
        return;
    }
    if (q == g_teller) {
        if (g_mySess[g_teller] != 0) {
            // 【点说书人 = 只想和说书人私聊】（用户 2026-11-05）：说书人正在别人的私聊里时，
            //   不把发起者塞进那间房，也不惊动房主，只提醒说书人「有人想找你」。
            BOTC_PmTellWant(p);
            return;
        }
        BOTC_CreateSess(p, g_teller);
        return;
    }
    if (g_mySess[q] != 0) {
        // 对方已经在私聊里：向他当前所在会话发出加入请求（与私聊可见性开关无关）。
        // 【被点的人也要知道】（用户 2026-11-08）：审批仍然只发给房主，但对方本人
        //   会收到「谁想和你私聊」的提醒，避免他完全不知道有人在找他。
        BOTC_RequestJoinSessTo(p, g_mySess[q], q);
        return;
    }
    // 【15 秒应答窗口内不得被顶掉】（用户 2026-11-02）：对方正在处理别的请求时先别发。
    if (g_reqFrom[q] != 0 || g_reqJoinSess[q] != 0 || g_reqSec[q] > 0 || g_invSess[q] != 0) {
        BOTC_Notice(p, BOTC_NameStr(BOTC_PosOf(q)) + " 正在处理另一个请求，请稍后再试。");
        return;
    }
    // 【被拒绝后的 15 秒冷却】（用户 2026-11-02）：同一对玩家不能立刻重复发起。
    if (g_pmCool[(p * 14) + q] > 0) {
        BOTC_Notice(p, "对方刚拒绝过你的私聊请求，请 " + IntToString((g_pmCool[(p * 14) + q] + 1) / 2) + " 秒后再试。");
        return;
    }
    g_reqFrom[q] = p;
    BOTC_ShowReq(q, BOTC_NameStr(BOTC_PosOf(p)) + " 请求与你私聊，是否同意？");
    BOTC_Notice(p, "已向 " + BOTC_NameStr(BOTC_PosOf(q)) + " 发出私聊请求，等待对方同意。");
    BOTC_PlaySfxTo(g_sfxReqName, q);   // UI 音效：有人向你发私聊请求（只给收件人听）
}

void BOTC_CreateSess (int a, int b) {
    int s;
    int i;
    BOTC_SessRepair();
    BOTC_ForceLeave(a);
    BOTC_ForceLeave(b);
    s = 0;
    for (i = 1; i <= 13; i += 1) {
        if (!g_sessAlive[i]) {
            s = i;
            break;
        }
    }
    if (s == 0) {
        BOTC_Notice(a, "当前私聊数量已达上限。");
        return;
    }
    g_sessAlive[s] = true;
    // 【说书人固定房主】（用户 2026-11-02）：只要这条私聊里有说书人，房主就是说书人；
    //   其余情况才由发起人当房主。
    if (a == g_teller || b == g_teller) {
        g_sessOwner[s] = g_teller;
    }
    else {
        g_sessOwner[s] = a;
    }
    g_member[(s * 14) + a] = true;
    g_member[(s * 14) + b] = true;
    g_mySess[a] = s;
    g_mySess[b] = s;
    g_joinPending[s] = false;
    // 建立私聊：两边都自动进入私聊模式（说书人也一样，用户 2026-09-30）
    g_chatSay[a] = 1;
    BOTC_SayRender(a);
    g_chatSay[b] = 1;
    BOTC_SayRender(b);

    BOTC_NoticeKeep(a, "已与 " + BOTC_NameStr(BOTC_PosOf(b)) + " 建立私聊。");
    BOTC_NoticeKeep(b, "已与 " + BOTC_NameStr(BOTC_PosOf(a)) + " 建立私聊。");
    // UI 音效：私聊建立（两边各听一声）
    BOTC_PlaySfxTo(g_sfxPmOnName, a);
    BOTC_PlaySfxTo(g_sfxPmOnName, b);
    BOTC_RefreshSessListAll();
    // 【全部私聊 · 建立记录】（2026-11-10）：谁向谁发起、房主是谁一次说清。
    if (g_sessOwner[s] >= 1 && g_sessOwner[s] <= 13) {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(a)) + " 向 " + BOTC_NameStr(BOTC_PosOf(b)) + " 发起私聊（房主：" + BOTC_NameStr(BOTC_PosOf(g_sessOwner[s])) + "）。");
    }
    else {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(a)) + " 向 " + BOTC_NameStr(BOTC_PosOf(b)) + " 发起私聊。");
    }
}

// 【私聊房主补位】（用户 2026-11-05）：说书人永远不会被补成房主；
//   房间缺房主时，从其他成员里取玩家号最小的一位补位。
int BOTC_SessOwnerPick (int s) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        if (i == g_teller) {
            continue;
        }
        if (g_member[(s * 14) + i]) {
            return i;
        }
    }
    return 0;
}

// 【房间状态校验】（用户 2026-11-10）：p 是否仍在私聊 s 里（会话结束也算不在）。
//   加入申请和邀请只在双方房间状态不变时有效；状态一变就按默认拒绝处理。
bool BOTC_SessIn (int s, int p) {
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        return false;
    }
    if (p < 1 || p > 13) {
        return false;
    }
    if (!g_member[(s * 14) + p]) {
        return false;
    }
    return g_mySess[p] == s;
}

// p 是否仍是私聊 s 的房主（加入申请只认房主拍板）。
bool BOTC_SessApprover (int s, int p) {
    if (!BOTC_SessIn(s, p)) {
        return false;
    }
    return g_sessOwner[s] == p;
}

void BOTC_SessOwnerFix (int s) {
    int old;
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        return;
    }
    if (g_sessOwner[s] >= 1 && g_sessOwner[s] <= 13 && g_member[(s * 14) + g_sessOwner[s]]) {
        return;
    }
    old = g_sessOwner[s];
    g_sessOwner[s] = BOTC_SessOwnerPick(s);
    BOTC_InviteClearSess(s);
    if (g_sessOwner[s] >= 1 && g_sessOwner[s] != old) {
        // 【全部私聊 · 房主补位】（2026-11-10）
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(g_sessOwner[s])) + " 成为新房主。");
    }
}

void BOTC_JoinSess (int who, int s) {
    int i;
    if (who < 1 || who > 13) {
        return;
    }
    if (s < 1 || s > 13) {
        return;
    }
    if (!g_sessAlive[s]) {
        BOTC_Notice(who, "该私聊已经结束了。");
        return;
    }
    if (g_member[(s * 14) + who]) {
        BOTC_Notice(who, "你已经在这个私聊里。");
        return;
    }
    // 【说书人直入时先清掉还在排队的加入请求】（用户 2026-11-02）：不能让房主再点一个已经没意义的框。
    if (g_joinPending[s]) {
        BOTC_RejectJoin(s);
    }
    BOTC_ForceLeave(who);
    g_member[(s * 14) + who] = true;
    g_mySess[who] = s;
    // 【说书人不补位房主】（用户 2026-11-05）：缺房主时补其他玩家，说书人只当成员。
    BOTC_SessOwnerFix(s);
    // 加入私聊：自动进入私聊模式（说书人也一样，用户 2026-09-30）
    g_chatSay[who] = 1;
    BOTC_SayRender(who);
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(who)) + " 加入了私聊。");
            BOTC_PlaySfxTo(g_sfxPmOnName, i);      // 有人加入私聊：会话里所有人各听一声
        }
    }
    BOTC_RefreshSessListAll();
    // 【全部私聊 · 加入记录】（2026-11-10）：成员已经加进来，事件快照会包含他本人。
    if (g_sessOwner[s] >= 1 && g_sessOwner[s] <= 13 && g_sessOwner[s] != who) {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(who)) + " 加入了 " + BOTC_NameStr(BOTC_PosOf(g_sessOwner[s])) + " 的私聊房间。");
    }
    else {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(who)) + " 加入了私聊房间。");
    }
}

// 【邀请加入私聊】（用户 2026-11-04）：房主点【邀请加入】→ 再点一名玩家 = 向他发出邀请；
//   对方收到和【发起私聊】一样的 15 秒同意框，同意后才真正加入。
//   只能邀请不在其他私聊、也不在处理别的私聊请求 / 邀请的玩家；邀请说书人也走同一套规则。
// 【说书人邀请】（用户 2026-11-05）：说书人在私聊阶段以外（公聊 / 提名 / 夜晚 / 开局前）
//   邀请 = 强制加入，不需要对方同意；只有在私聊阶段才需要对方不在别的私聊并同意。
//   说书人即使只是当前私聊的普通成员，也能邀请。
bool BOTC_InviteCan (int p, int s) {
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        return false;
    }
    if (g_sessOwner[s] == p) {
        return true;
    }
    return p == g_teller && g_member[(s * 14) + p];
}

// 【说书人强制邀请】（用户 2026-11-05）：不在私聊阶段时，说书人的邀请直接生效。
bool BOTC_InviteForce (int p) {
    if (p != g_teller) {
        return false;
    }
    if (g_isNight || g_chatMode != 1 || g_phase != 0) {
        return true;
    }
    return false;
}

void BOTC_InviteRender (int p) {
    bool on;
    int s;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_inviteBtn[p] == 0) {
        return;
    }
    on = false;
    s = g_mySess[p];
    if (BOTC_InviteCan(p, s)) {
        on = true;
    }
    if (on == g_inviteOn[p]) {
        return;                    // 状态没变就别反复设置控件（免得闪）
    }
    g_inviteOn[p] = on;
    DialogControlSetVisible(g_inviteBtn[p], PlayerGroupSingle(p), on);
}

void BOTC_InviteStart (int p) {
    int s;
    bool force;
    if (p < 1 || p > 13) {
        return;
    }
    s = g_mySess[p];
    if (!BOTC_InviteCan(p, s)) {
        BOTC_Notice(p, "你现在不是私聊房主：不能邀请加入。");
        return;
    }
    if (g_invitePick) {
        g_invitePick = false;
        g_inviteBy = 0;
        BOTC_BigHintHide(p);
        BOTC_Notice(p, "取消【邀请加入】。");
        return;
    }
    g_invitePick = true;
    g_inviteBy = p;
    force = BOTC_InviteForce(p);
    if (force) {
        BOTC_Notice(p, "【邀请加入】：点一个玩家的座位，直接把他加入当前私聊。");
        BOTC_BigHintShow(p, "点一个玩家的座位 → 强制把他加入私聊（对方无需同意）。");
        return;
    }
    BOTC_Notice(p, "【邀请加入】：点一个玩家的座位，向他发出加入邀请。");
    BOTC_BigHintShow(p, "点一个玩家的座位 → 邀请他加入私聊（需要对方同意）。");
}

void BOTC_InviteAt (int q) {
    int p;
    int s;
    int who;
    bool force;
    int s2;
    p = g_inviteBy;
    g_invitePick = false;
    g_inviteBy = 0;
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_BigHintHide(p);
    s = g_mySess[p];
    if (!BOTC_InviteCan(p, s)) {
        BOTC_Notice(p, "这条私聊已经结束了。");
        return;
    }
    if (q < 2 || q > 13) {
        return;
    }
    who = g_who[q];
    if (who < 1 || who > 13 || who == p) {
        return;
    }
    if (g_member[(s * 14) + who]) {
        BOTC_Notice(p, BOTC_NameStr(BOTC_PosOf(who)) + " 已经在你们的私聊里。");
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：任意一方屏蔽了对方，邀请一律自动拒绝。
    if (BOTC_Blocked(p, who)) {
        BOTC_Notice(p, "你已屏蔽 " + BOTC_NameStr(BOTC_PosOf(who)) + "，先解除屏蔽才能邀请。");
        return;
    }
    if (BOTC_Blocked(who, p)) {
        BOTC_Notice(p, "对方已屏蔽你，无法邀请。");
        return;
    }
    if (BOTC_SessBlocks(s, who)) {
        BOTC_Notice(p, "对方与该私聊中的玩家存在屏蔽关系，无法邀请。");
        return;
    }
    force = BOTC_InviteForce(p);
    // 【说书人强制邀请】（用户 2026-11-05）：公聊 / 提名 / 夜晚 / 开局前直接拉进来，不等对方同意；
    //   先把对方身上还没处理的请求框 / 邀请框清掉，免得强制加入后留下失效弹窗。
    if (force) {
        if (g_reqJoinSess[who] != 0) {
            s2 = g_reqJoinSess[who];
            g_reqJoinSess[who] = 0;
            if (s2 >= 1 && s2 <= 13) {
                g_joinPending[s2] = false;
                g_joinWho[s2] = 0;
            }
        }
        g_reqFrom[who] = 0;
        BOTC_InviteClear(who);
        // 【全部私聊 · 强制邀请】（2026-11-11）：说书人直接拉人，先记一条，与普通加入区分开。
        BOTC_SessLogEventTo(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 把 " + BOTC_NameStr(BOTC_PosOf(who)) + " 直接拉进私聊房间。", who);
        BOTC_JoinSess(who, s);
        BOTC_Notice(p, "已把 " + BOTC_NameStr(BOTC_PosOf(who)) + " 加入私聊。");
        BOTC_Notice(who, "说书人把你加入了私聊。");
        return;
    }
    // 私聊阶段：只能邀请不在其他私聊里的玩家；失败时不暴露对方正在和谁私聊
    if (g_mySess[who] != 0) {
        BOTC_Notice(p, "邀请失败：" + BOTC_NameStr(BOTC_PosOf(who)) + " 现在无法加入私聊。");
        BOTC_Notice(who, BOTC_NameStr(BOTC_PosOf(p)) + " 邀请你加入私聊，但你已在其他私聊中，无法加入。");
        return;
    }
    // 对方正在处理别的私聊请求 / 邀请：不能顶掉他的弹窗
    if (g_reqFrom[who] != 0 || g_reqJoinSess[who] != 0 || g_reqSec[who] > 0 || g_invSess[who] != 0) {
        BOTC_Notice(p, "邀请失败：对方正在处理另一个请求，请稍后再试。");
        return;
    }
    if (g_joinPending[s]) {
        BOTC_Notice(p, "这条私聊正在处理另一个加入请求，请稍后再试。");
        return;
    }
    if (g_pmCool[(p * 14) + who] > 0) {
        BOTC_Notice(p, "对方刚拒绝过邀请，请 " + IntToString((g_pmCool[(p * 14) + who] + 1) / 2) + " 秒后再试。");
        return;
    }
    g_invSess[who] = s;
    g_invFrom[who] = p;
    BOTC_ShowReq(who, BOTC_NameStr(BOTC_PosOf(p)) + " 邀请你加入私聊，是否同意？");
    BOTC_Notice(p, "已邀请 " + BOTC_NameStr(BOTC_PosOf(who)) + " 加入私聊，等待对方同意。");
    BOTC_PlaySfxTo(g_sfxReqName, who);
    // 【全部私聊 · 邀请记录】（2026-11-11）：对方还没同意时先说清是谁邀请谁，
    //   说书人回看时不会只剩一条「加入了私聊」。
    if (g_sessOwner[s] >= 1 && g_sessOwner[s] <= 13) {
        BOTC_SessLogEventTo(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 邀请 " + BOTC_NameStr(BOTC_PosOf(who)) + " 加入 " + BOTC_NameStr(BOTC_PosOf(g_sessOwner[s])) + " 的私聊房间（等待对方同意）。", who);
    }
    else {
        BOTC_SessLogEventTo(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 邀请 " + BOTC_NameStr(BOTC_PosOf(who)) + " 加入私聊房间（等待对方同意）。", who);
    }
}

void BOTC_InviteClear (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    g_invSess[p] = 0;
    g_invFrom[p] = 0;
    BOTC_ClearReq(p);
}

// 接受邀请：入会走统一加入流程
void BOTC_AcceptInvite (int p) {
    int s;
    int from;
    s = g_invSess[p];
    from = g_invFrom[p];
    BOTC_InviteClear(p);
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        if (from >= 1 && from <= 13) {
            BOTC_Notice(from, "邀请失败：该私聊已经结束。");
        }
        BOTC_Notice(p, "该私聊已经结束，邀请已失效。");
        return;
    }
    if (g_mySess[p] != 0) {
        if (from >= 1 && from <= 13) {
            BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 已在其他私聊中，邀请失败。");
        }
        BOTC_Notice(p, "你正在其他私聊中，无法接受邀请。");
        return;
    }
    // 【邀请人已离开房间】（用户 2026-11-10）：邀请方不在这个私聊里了，接受也没有意义。
    if (from >= 1 && from <= 13 && !BOTC_SessIn(s, from)) {
        BOTC_Notice(p, "邀请方已离开该私聊，邀请已失效。");
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：邀请方与接受方存在屏蔽关系时自动拒绝。
    if (from >= 1 && from <= 13 && BOTC_BlockEither(p, from)) {
        BOTC_Notice(p, "你们之间存在屏蔽关系，邀请已自动拒绝。");
        BOTC_Notice(from, "邀请已自动拒绝。");
        return;
    }
    BOTC_JoinSess(p, s);
    if (from >= 1 && from <= 13) {
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 同意了你的邀请，已加入私聊。");
    }
}

// 拒绝邀请（手动点【否】或超时）
void BOTC_DeclineInvite (int p, bool timeout) {
    int from;
    from = g_invFrom[p];
    BOTC_InviteClear(p);
    if (from < 1 || from > 13) {
        return;
    }
    BOTC_PmCooldown(from, p);
    if (timeout) {
        BOTC_Notice(p, "邀请已超时，自动拒绝。");
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 没有在 15 秒内回应，邀请已自动取消。");
    }
    else {
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了你加入私聊的邀请。");
    }
}

// 会话结束时清掉指向它的全部邀请
void BOTC_InviteClearSess (int s) {
    int i;
    int s2;
    for (i = 1; i <= 13; i += 1) {
        if (g_invSess[i] == s) {
            if (!g_sessSilent) {
                BOTC_Notice(i, "私聊已结束，邀请已失效。");
                if (g_invFrom[i] >= 1 && g_invFrom[i] <= 13) {
                    BOTC_Notice(g_invFrom[i], "邀请失败：该私聊已经结束。");
                }
            }
            BOTC_InviteClear(i);
        }
    }
    if (g_invitePick) {
        s2 = 0;
        if (g_inviteBy >= 1 && g_inviteBy <= 13) {
            s2 = g_mySess[g_inviteBy];
        }
        if (s2 < 1 || s2 > 13 || !g_sessAlive[s2] || g_sessOwner[s2] != g_inviteBy) {
            g_invitePick = false;
            g_inviteBy = 0;
        }
    }
}
// 【解散私聊】（用户 2026-11-04）：当前私聊的房主把这间私聊整个收掉 —— 会话里所有人都被请出去。
void BOTC_SessDissolve (int s) {
    int i;
    int ow;
    if (s < 1 || s > 13) {
        return;
    }
    if (!g_sessAlive[s]) {
        return;
    }
    ow = g_sessOwner[s];
    // 【全部私聊 · 房间解散】（2026-11-10）：必须赶在清成员之前记，说书人按玩家过滤时才能看到。
    if (ow >= 1 && ow <= 13) {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(ow)) + " 解散了私聊房间（成员：" + BOTC_SessMembersText(s, 0) + "）。");
    }
    else {
        BOTC_SessLogEvent(s, "【私聊】私聊房间已解散（成员：" + BOTC_SessMembersText(s, 0) + "）。");
    }
    for (i = 1; i <= 13; i += 1) {
        if (!g_member[(s * 14) + i]) {
            continue;
        }
        g_member[(s * 14) + i] = false;
        g_mySess[i] = 0;
        // 【解散也不自动切回公聊】（用户 2026-10-10）：跟【退出私聊】同一条口径
        BOTC_SayRender(i);
        BOTC_Notice(i, "这条私聊已被房主解散。");
    }
    g_sessAlive[s] = false;
    g_joinPending[s] = false;
    g_joinWho[s] = 0;
    g_sessOwner[s] = 0;
    if (s == g_lmSess) {
        g_lmSess = 0;              // 【小怪宝恶人频道】解散了：号清掉，免得被下一条私聊复用（用户 2026-10-12）
    }
    BOTC_InviteClearSess(s);
    if (ow >= 1 && ow <= 13) {
        BOTC_PmStore(ow, "【私聊】你解散了当前这条私聊。");
    }
    BOTC_RefreshSessListAll();
}

void BOTC_DissolveStart (int p) {
    int s;
    if (p < 1 || p > 13) {
        return;
    }
    s = g_mySess[p];
    if (s < 1 || s > 13 || !g_sessAlive[s] || g_sessOwner[s] != p) {
        BOTC_Notice(p, "你现在不是私聊房主：不能解散私聊。");
        return;
    }
    g_invitePick = false;                 // 顺手退出「邀请加入」的选人模式
    g_inviteBy = 0;
    BOTC_BigHintHide(p);
    BOTC_SessDissolve(s);
}

void BOTC_DissolveRender (int p) {
    bool on;
    int s;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_dissolveBtn[p] == 0) {
        return;
    }
    on = false;
    s = g_mySess[p];
    if (s >= 1 && s <= 13 && g_sessAlive[s] && g_sessOwner[s] == p) {
        on = true;
    }
    if (on == g_dissolveOn[p]) {
        return;
    }
    g_dissolveOn[p] = on;
    DialogControlSetVisible(g_dissolveBtn[p], PlayerGroupSingle(p), on);
}
void BOTC_CloseSessIfAlone (int s) {
    int i;
    int cnt;
    if (s < 1 || s > 13) {
        return;
    }
    cnt = 0;
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            cnt = cnt + 1;
        }
    }
    if (cnt <= 1) {
        // 【全部私聊 · 房间自然结束】（2026-11-10）：先记事件再清成员。
        if (cnt == 1) {
            for (i = 1; i <= 13; i += 1) {
                if (g_member[(s * 14) + i]) {
                    BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(i)) + " 的私聊房间已结束（没有其他成员）。");
                    break;
                }
            }
        }
        else {
            BOTC_SessLogEvent(s, "【私聊】一个私聊房间已结束。");
        }
        for (i = 1; i <= 13; i += 1) {
            if (g_member[(s * 14) + i]) {
                g_member[(s * 14) + i] = false;
                g_mySess[i] = 0;
                // 【私聊结束也不切公聊】（用户 2026-10-16）：保持每个人当前那个模式，按钮文案也保持「聊天：私聊」
                libNtve_gf_SetDialogItemText(g_sayBtnP[i], StringToText("聊天：私聊（Tab切换）"), PlayerGroupSingle(i));
                if (!g_sessSilent) {
                    BOTC_Notice(i, "私聊已结束。");
                }
            }
        }
        g_sessAlive[s] = false;
        g_joinPending[s] = false;
        g_joinWho[s] = 0;
        g_sessOwner[s] = 0;        // 【房主随会话结束一起清】（用户 2026-11-02）
        BOTC_InviteClearSess(s);
        if (s == g_lmSess) {
            g_lmSess = 0;          // 【小怪宝恶人频道】没人了自动关：号清掉（用户 2026-10-12）
        }
    }
}

// 【按阶段解散私聊】（用户 2026-11-02）
//   keepTeller = false：全部解散（白天 ↔ 黑夜切换用，说书人的私聊也一起收）
//   keepTeller = true ：只保留说书人所在的那条私聊，其余全部解散（私聊阶段 → 公聊 / 提名阶段）
//   同时清掉所有残留的私聊请求框：夜里 / 公聊 / 提名阶段不能答应白天遗留的申请。
void BOTC_DissolveAllSess (bool keepTeller) {
    int s;
    int i;
    g_sessSilent = true;
    g_bulkLeave = true;
    for (s = 1; s <= 13; s += 1) {
        if (!g_sessAlive[s]) {
            continue;
        }
        if (keepTeller && g_sessOwner[s] == g_teller && g_member[(s * 14) + g_teller]) {
            // 【只保留说书人当房主的私聊】（用户 2026-11-05）：说书人只是成员时照样解散。
            g_joinPending[s] = false;
            g_joinWho[s] = 0;
            continue;
        }
        // 【全部私聊 · 阶段解散】（2026-11-10）：先记事件再清成员。
        BOTC_SessLogEvent(s, "【私聊】私聊房间已随阶段切换结束（成员：" + BOTC_SessMembersText(s, 0) + "）。");
        for (i = 1; i <= 13; i += 1) {
            if (!g_member[(s * 14) + i]) {
                continue;
            }
            g_member[(s * 14) + i] = false;
            g_mySess[i] = 0;
            BOTC_SayRender(i);
            BOTC_NoticeKeep(i, "私聊已随阶段切换结束。");
        }
        g_sessAlive[s] = false;
        g_joinPending[s] = false;
        g_joinWho[s] = 0;
        g_sessOwner[s] = 0;
        if (s == g_lmSess) {
            g_lmSess = 0;
        }
    }
    for (i = 1; i <= 13; i += 1) {
        g_reqFrom[i] = 0;
        g_reqJoinSess[i] = 0;
        g_reqJoinWho[i] = 0;
        g_reqSec[i] = 0;
        g_invSess[i] = 0;
        g_invFrom[i] = 0;
        BOTC_ClearReq(i);
    }
    g_sessSilent = false;
    g_bulkLeave = false;
    BOTC_RefreshSessListAll();
}

void BOTC_SessRepair () {
    int s;
    int p;
    bool any;
    for (s = 0; s <= 13; s += 1) {
        any = false;
        for (p = 0; p <= 13; p += 1) {
            if (g_member[(s * 14) + p]) {
                if (p < 1 || p > 13 || g_mySess[p] != s) {
                    g_member[(s * 14) + p] = false;
                }
                else {
                    any = true;
                }
            }
        }
        if (!any && g_sessAlive[s]) {
            g_sessAlive[s] = false;
            g_joinPending[s] = false;
            g_joinWho[s] = 0;
            g_sessOwner[s] = 0;
            BOTC_InviteClearSess(s);
        }
    }
    for (p = 1; p <= 13; p += 1) {
        s = g_mySess[p];
        if (s < 1 || s > 13 || !g_sessAlive[s]) {
            g_mySess[p] = 0;
        }
    }
    for (s = 1; s <= 13; s += 1) {
        if (!g_sessAlive[s]) {
            continue;
        }
        for (p = 1; p <= 13; p += 1) {
            if (g_mySess[p] == s) {
                g_member[(s * 14) + p] = true;
            }
        }
    }
    for (s = 1; s <= 13; s += 1) {
        if (g_sessAlive[s]) {
            BOTC_CloseSessIfAlone(s);
        }
    }
    BOTC_RefreshSessListAll();
}

// 【夜间说书人退出私聊 = 解散整个私聊】（用户 2026-11-03）：
//   夜晚的私聊都因夜间行动唤醒 / 说书人主动发起而产生，不允许留下没有说书人的房间；
//   说书人点【退出私聊】时直接清空这个会话的所有成员，而不是把房主转给其他人。
void BOTC_DissolveSessForNight (int s) {
    int i;
    if (s < 1 || s > 13) {
        return;
    }
    // 【全部私聊 · 夜间解散】（2026-11-10）：先记事件再清成员。
    BOTC_SessLogEvent(s, "【私聊】私聊房间已结束（成员：" + BOTC_SessMembersText(s, 0) + "）。");
    for (i = 1; i <= 13; i += 1) {
        if (!g_member[(s * 14) + i]) {
            continue;
        }
        g_member[(s * 14) + i] = false;
        g_mySess[i] = 0;
        BOTC_SayRender(i);
        if (!g_sessSilent) {
            BOTC_NoticeKeep(i, "私聊已结束。");
        }
    }
    g_sessAlive[s] = false;
    g_sessOwner[s] = 0;
    g_joinPending[s] = false;
    g_joinWho[s] = 0;
    BOTC_InviteClearSess(s);
}

void BOTC_Leave (int p) {
    int s;
    int i;
    int nb;
    s = g_mySess[p];
    if (s == 0) {
        for (i = 1; i <= 13; i += 1) {
            if (g_member[(i * 14) + p]) {
                g_member[(i * 14) + p] = false;
                BOTC_CloseSessIfAlone(i);
            }
        }
        // 【退出私聊不再自动切回公聊】（用户 2026-10-10）：聊天模式是玩家自己选的，脚本不替他切
        BOTC_SayRender(p);
        if (!g_sessSilent) {
            BOTC_Notice(p, "你当前不在私聊中（已帮你清掉残留状态）。");
        }
        if (!g_bulkLeave) {
            BOTC_RefreshSessListAll();
        }
        return;
    }
    // 【夜间说书人退出私聊 = 解散】（用户 2026-11-03）：无论房间里有几个人，
    //   说书人一退出就整个房间结束，不允许把房主转给玩家后留下无说书人的私聊。
    if (g_isNight && p == g_teller) {
        g_member[(s * 14) + p] = false;
        g_mySess[p] = 0;
        BOTC_SayRender(p);
        if (!g_sessSilent) {
            BOTC_Notice(p, "你退出了私聊，该私聊已解散。");
        }
        BOTC_DissolveSessForNight(s);
        if (!g_bulkLeave) {
            BOTC_RefreshSessListAll();
        }
        return;
    }
    // 【全部私聊 · 退出记录】（2026-11-10）：先记事件再清成员，退出的人自己也能在过滤里看到这一条。
    if (g_sessOwner[s] == p) {
        BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + "（房主）退出了私聊房间。");
    }
    else {
        if (g_sessOwner[s] >= 1 && g_sessOwner[s] <= 13) {
            BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 退出了 " + BOTC_NameStr(BOTC_PosOf(g_sessOwner[s])) + " 的私聊房间。");
        }
        else {
            BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 退出了私聊房间。");
        }
    }
    g_member[(s * 14) + p] = false;
    g_mySess[p] = 0;
    // 【退出私聊不再自动切回公聊】（用户 2026-10-10）：保持他当前选的那个模式
    BOTC_SayRender(p);
    if (!g_sessSilent) {
        BOTC_Notice(p, "你退出了私聊。");
    }
    // 【房主继承】（用户 2026-11-05）：房主退出后由剩余非说书人成员中玩家号最小者继承；
    //   说书人不再补位当房主。
    if (g_sessOwner[s] == p) {
        nb = 0;
        for (i = 1; i <= 13; i += 1) {
            if (i == p || i == g_teller) {
                continue;
            }
            if (g_member[(s * 14) + i]) {
                nb = i;
                break;
            }
        }
        g_sessOwner[s] = nb;
        if (nb >= 1) {
            // 【全部私聊 · 房主变更】（2026-11-10）
            BOTC_SessLogEvent(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(nb)) + " 成为新房主。");
        }
        BOTC_InviteClearSess(s);   // 旧房主还没完成的邀请一起作废
        if (nb >= 1 && !g_sessSilent) {
            for (i = 1; i <= 13; i += 1) {
                if (g_member[(s * 14) + i]) {
                    BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(nb)) + " 成为房主。");
                }
            }
        }
    }
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            if (!g_sessSilent) {
                BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(p)) + " 退出了私聊。");
            }
        }
    }
    BOTC_CloseSessIfAlone(s);
    if (!g_bulkLeave) {                  // 【批量退出时先别刷，外面统一刷一次】（用户 2026-10-19：进提名/入夜会卡一下）
        BOTC_RefreshSessListAll();
    }
}

void BOTC_ForceLeave (int p) {
    if (g_mySess[p] != 0) {
        BOTC_Leave(p);
    }
}

//--------------------------------------------------------------------------------------------------
// 请求应答
//--------------------------------------------------------------------------------------------------
// 【拒绝后的 15 秒冷却】（用户 2026-11-02）：同一名发起人对同一名玩家不能立刻重复发起。
void BOTC_PmCooldown (int from, int to) {
    if (from < 1 || from > 13 || to < 1 || to > 13) {
        return;
    }
    g_pmCool[(from * 14) + to] = 30;
}

// 【阶段拦截】（用户 2026-11-02）：夜晚 / 公聊 / 提名阶段不处理白天残留的私聊申请。
bool BOTC_PmStageBlocked () {
    if (g_isNight) {
        return true;
    }
    if (g_chatMode == 2 && !g_cultOn) {
        return true;
    }
    if (g_phase != 0 && !g_cultOn) {
        return true;
    }
    return false;
}

void BOTC_OnYes (int p) {
    int from;
    if (g_invSess[p] != 0) {
        BOTC_AcceptInvite(p);
        return;
    }
    if (g_reqJoinSess[p] != 0) {
        BOTC_VoteJoin(p, true);
        return;
    }
    from = g_reqFrom[p];
    if (from == 0) {
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：存在屏蔽关系时自动拒绝这条私聊请求。
    if (BOTC_BlockEither(p, from)) {
        g_reqFrom[p] = 0;
        BOTC_ClearReq(p);
        BOTC_PmCooldown(from, p);
        BOTC_Notice(p, "你们之间存在屏蔽关系，私聊请求已自动拒绝。");
        BOTC_Notice(from, "你的私聊请求已被自动拒绝。");
        return;
    }
    // 【阶段拦截】：白天遗留下来的请求在夜里 / 公聊 / 提名阶段一率不能同意。
    //   说书人例外：他要随时能给玩家发私聊（跟「说书人的私聊不清算」同一条口径）。
    if (p != g_teller && BOTC_PmStageBlocked()) {
        g_reqFrom[p] = 0;
        BOTC_ClearReq(p);
        BOTC_PmCooldown(from, p);
        BOTC_Notice(p, "当前时段不能接受私聊请求，已自动拒绝。");
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了你的私聊请求。");
        return;
    }
    g_reqFrom[p] = 0;
    BOTC_ClearReq(p);
    if (g_mySess[from] != 0) {
        BOTC_AppendPm(p, BOTC_NameStr(BOTC_PosOf(from)) + " 已经进入其他私聊。");
        return;
    }
    BOTC_CreateSess(from, p);
}

void BOTC_OnNo (int p) {
    int from;
    if (g_invSess[p] != 0) {
        BOTC_DeclineInvite(p, false);
        return;
    }
    if (g_reqJoinSess[p] != 0) {
        BOTC_VoteJoin(p, false);
        return;
    }
    from = g_reqFrom[p];
    if (from == 0) {
        return;
    }
    g_reqFrom[p] = 0;
    BOTC_ClearReq(p);
    BOTC_PmCooldown(from, p);
    BOTC_AppendPm(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了你的私聊请求。");
}

//--------------------------------------------------------------------------------------------------
// 加入私聊（用户 2026-11-02：只需房主同意）
//--------------------------------------------------------------------------------------------------
void BOTC_RequestJoin (int p) {
    int sel;
    int s;
    BOTC_SessRepair();
    sel = DialogControlGetSelectedItem(g_sessList[p], p);
    if (sel < 1) {
        BOTC_Notice(p, "请先在列表里选择一个进行中的私聊。");
        return;
    }
    s = g_listSess[(p * 14) + sel];
    if (s < 1 || s > 13) {
        BOTC_Notice(p, "请重新选择列表里的私聊。");
        BOTC_RefreshSessList(p);
        return;
    }
    // 【点说书人所在的房间 ≠ 加入房间】（用户 2026-11-05）：只视为想和说书人单独私聊，
    //   只提醒说书人，不给房主弹加入审批；要加入房间请发起私聊后点房主或其他成员。
    if (p != g_teller && !g_member[(s * 14) + p] && g_member[(s * 14) + g_teller]) {
        BOTC_PmTellWant(p);
        return;
    }
    BOTC_RequestJoinSess(p, s);
}

// 发起者 p 请求加入会话 s。「点一个正在私聊的人发起私聊」走这条路径；
//   列表按钮点到含说书人的房间已在 BOTC_RequestJoin 改走「只提醒说书人」。
//   【房主审批】（用户 2026-11-02）：只有房主收到请求框，房主点【是】就放行。
void BOTC_RequestJoinSess (int p, int s) {
    BOTC_RequestJoinSessTo(p, s, 0);
}

// tell = 被点的那位成员（0 表示没有具体对象，例如从列表里申请加入）。
//   【被点成员也要知道】（用户 2026-11-08）：审批仍然只发给房主，
//   但 tell 本人会收到「谁想和你私聊」的提醒；tell 就是房主时不重复提醒。
void BOTC_RequestJoinSessTo (int p, int s, int tell) {
    int i;
    int ow;
    BOTC_SessRepair();
    if (p < 1 || p > 13) {
        return;
    }
    if (g_mySess[p] != 0) {
        BOTC_Notice(p, "你正在私聊中，请先退出。");
        return;
    }
    if (s < 1 || s > 13) {
        BOTC_Notice(p, "请重新选择要加入的私聊。");
        return;
    }
    if (!g_sessAlive[s]) {
        BOTC_Notice(p, "该私聊已经结束。");
        BOTC_RefreshSessList(p);
        return;
    }
    // 发言时段限制：公聊时间不能加入私聊（说书人本人、以及**含说书人的私聊**除外 ---- 跟发起私聊同一套破例）
    if (g_chatMode == 2 && !g_cultOn && p != g_teller && !g_member[(s * 14) + g_teller]) {
        BOTC_Notice(p, "现在是公聊时间，不能加入私聊（跟说书人的私聊除外）。");
        return;
    }
    if (g_member[(s * 14) + p]) {
        BOTC_Notice(p, "你已经在这个私聊里。");
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：房间里任意成员与发起人存在屏蔽关系，直接拒绝加入。
    if (BOTC_SessBlocks(s, p)) {
        BOTC_Notice(p, "你与该私聊中的玩家存在屏蔽关系，无法加入。");
        return;
    }
    // 【说书人介入私聊】（用户 2026-09-22）：说书人进任何私聊都不用成员同意，直接进去 ----
    //   并且直接加入，但不再接管房主（用户 2026-11-05）。
    if (p == g_teller) {
        BOTC_JoinSess(g_teller, s);
        return;
    }
    if (g_joinPending[s]) {
        BOTC_Notice(p, "该私聊正在处理另一个加入请求，请稍后再试。");
        return;
    }
    // 找房主：房主不在了就由剩余非说书人成员里第一个顶上。
    BOTC_SessOwnerFix(s);
    ow = g_sessOwner[s];
    if (ow < 1) {
        BOTC_Notice(p, "该私聊已经没有可审批的房主。");
        return;
    }
    // 【15 秒应答窗口内不得被顶掉】：房主正在处理别的请求就等一等。
    if (g_reqFrom[ow] != 0 || g_reqJoinSess[ow] != 0 || g_reqSec[ow] > 0) {
        // 【不暴露房主】（用户 2026-11-03）：申请加入时不让发起人知道房主是谁。
        BOTC_Notice(p, "对方正在处理另一个请求，请稍后再试。");
        return;
    }
    // 【被拒绝后的 15 秒冷却】：同一名发起人不能立刻重复申请。
    //   【冷却归属被点的人】（用户 2026-11-09）：点某个成员发起私聊被房主拒绝后，
    //   冷却记在被点的成员身上，避免他被同一人反复骚扰；从列表加入时仍记房主。
    if (tell >= 1 && tell <= 13 && tell != ow && g_pmCool[(p * 14) + tell] > 0) {
        BOTC_Notice(p, "对方刚拒绝过你的私聊请求，请 " + IntToString((g_pmCool[(p * 14) + tell] + 1) / 2) + " 秒后再试。");
        return;
    }
    if (g_pmCool[(p * 14) + ow] > 0) {
        BOTC_Notice(p, "房主刚拒绝过你的请求，请 " + IntToString((g_pmCool[(p * 14) + ow] + 1) / 2) + " 秒后再试。");
        return;
    }
    g_joinPending[s] = true;
    g_joinWho[s] = p;
    g_joinTell[s] = tell;
    for (i = 1; i <= 13; i += 1) {
        g_joinVote[(s * 14) + i] = false;
    }
    g_reqJoinSess[ow] = s;
    g_reqJoinWho[ow] = p;
    BOTC_ShowReq(ow, BOTC_NameStr(BOTC_PosOf(p)) + " 请求加入你们的私聊，是否同意？");
    BOTC_PlaySfxTo(g_sfxReqName, ow);
    // 【全部私聊 · 申请记录】（2026-11-11）：申请还没获批时先记一条，说书人能看到谁在申请加入。
    BOTC_SessLogEventTo(s, "【私聊】" + BOTC_NameStr(BOTC_PosOf(p)) + " 申请加入 " + BOTC_NameStr(BOTC_PosOf(ow)) + " 的私聊房间（等待房主同意）。", p);
    // 【不暴露房主 / 只通知房主】（用户 2026-11-03）：申请只提示「已发出」，不写房主名字；
    //   房间里其他成员一律不弹提醒，只有房主知道自己收到了谁的加入申请。
    BOTC_Notice(p, "已发出加入请求，等待房主同意。");
    // 【被点成员本人也要收到提醒】（用户 2026-11-08）：加入审批只发给房主，
    //   被点的人同样要知道是谁想找他；他正好是房主时上面已经弹过请求框，不重复提醒。
    if (tell >= 1 && tell <= 13 && tell != p && tell != ow && g_member[(s * 14) + tell]) {
        BOTC_NoticeKeep(tell, BOTC_NameStr(BOTC_PosOf(p)) + " 想与你私聊，加入申请已发给房主。");
        BOTC_PlaySfxTo(g_sfxReqName, tell);
    }
}

void BOTC_VoteJoin (int p, bool yes) {
    int s;
    int i;
    int ow;
    s = g_reqJoinSess[p];
    g_reqJoinSess[p] = 0;
    BOTC_ClearReq(p);
    if (s == 0 || s < 1 || s > 13 || !g_joinPending[s]) {
        return;
    }
    BOTC_SessOwnerFix(s);
    ow = g_sessOwner[s];
    // 【只有房主能拍板】（用户 2026-11-02）：其他人收到的旧请求框不再算票。
    if (p != ow) {
        // 【房主已经换人】（用户 2026-11-10）：旧审批框直接作废，别让房间卡在「正在处理另一个加入请求」。
        BOTC_JoinVoid(s, p);
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：房主与申请人存在屏蔽关系时自动拒绝。
    if (BOTC_BlockEither(p, g_joinWho[s])) {
        BOTC_RejectJoin(s);
        BOTC_Notice(p, "你们之间存在屏蔽关系，加入请求已自动拒绝。");
        return;
    }
    if (p != g_teller && BOTC_PmStageBlocked()) {
        BOTC_RejectJoin(s);
        BOTC_Notice(p, "当前时段不能接受加入私聊的请求，已自动拒绝。");
        return;
    }
    if (!yes) {
        BOTC_RejectJoin(s);
        return;
    }
    BOTC_FinishJoin(s);
}

void BOTC_FinishJoin (int s) {
    int who;
    int i;
    who = g_joinWho[s];
    g_joinPending[s] = false;
    g_joinTell[s] = 0;
    if (who < 1 || who > 13) {
        return;
    }
    // 【屏蔽】（用户 2026-11-06）：最终入会前再查一次，防止期间新增屏蔽关系。
    if (BOTC_SessBlocks(s, who)) {
        BOTC_Notice(who, "你与该私聊中的玩家存在屏蔽关系，加入请求已取消。");
        return;
    }
    if (g_mySess[who] != 0) {
        BOTC_Notice(who, "你已经在其他私聊里，加入请求已取消。");
        return;
    }
    g_member[(s * 14) + who] = true;
    g_mySess[who] = s;
    // 【说书人不补位房主】（用户 2026-11-05）：缺房主时补其他玩家，说书人只当成员。
    BOTC_SessOwnerFix(s);
    for (i = 1; i <= 13; i += 1) {
        if (g_member[(s * 14) + i]) {
            BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(who)) + " 加入了私聊。");
        }
        // 【只收掉这条私聊的审批框】（用户 2026-11-02）：别把成员身上别的私聊请求框一起清掉。
        if (g_reqJoinSess[i] == s) {
            g_reqJoinSess[i] = 0;
            BOTC_ClearReq(i);
        }
    }
    BOTC_RefreshSessListAll();
}

void BOTC_RejectJoin (int s) {
    int who;
    int i;
    int ow;
    who = g_joinWho[s];
    ow = g_sessOwner[s];
    g_joinPending[s] = false;
    for (i = 1; i <= 13; i += 1) {
        // 【只收掉这条私聊的审批框】（用户 2026-11-02）：别把成员身上别的私聊请求框一起清掉。
        if (g_reqJoinSess[i] == s) {
            g_reqJoinSess[i] = 0;
            BOTC_ClearReq(i);
        }
    }
    if (who >= 1 && who <= 13) {
        // 【冷却归属被点的人】（用户 2026-11-09）：点成员发起私聊被房主拒绝时，
        //   15 秒冷却记在被点成员身上，而不是房主；从列表加入仍记房主。
        if (g_joinTell[s] >= 1 && g_joinTell[s] <= 13 && g_joinTell[s] != ow) {
            BOTC_PmCooldown(who, g_joinTell[s]);
        }
        else if (ow >= 1 && ow <= 13) {
            BOTC_PmCooldown(who, ow);      // 被拒绝后 15 秒内不能再申请同一间私聊
        }
        BOTC_Notice(who, "加入私聊的请求被拒绝了。");
    }
    g_joinTell[s] = 0;
}

// 【房间状态变化 → 默认拒绝·加入申请】（用户 2026-11-10）：房主离开房间、申请人
//   或被点成员进出别的私聊后，审批框里的【是 / 否】已经没有意义。直接作废请求框，
//   不给申请人记拒绝冷却（房间状态变化不是他造成的），两边各收一条提示。
void BOTC_JoinVoid (int s, int p) {
    int i;
    int who;
    who = 0;
    if (s >= 1 && s <= 13) {
        who = g_joinWho[s];
        g_joinPending[s] = false;
        g_joinWho[s] = 0;
        g_joinTell[s] = 0;
        for (i = 1; i <= 13; i += 1) {
            if (g_reqJoinSess[i] == s) {
                g_reqJoinSess[i] = 0;
                BOTC_ClearReq(i);
            }
        }
    }
    else {
        if (p >= 1 && p <= 13) {
            g_reqJoinSess[p] = 0;
            BOTC_ClearReq(p);
        }
    }
    if (who >= 1 && who <= 13) {
        BOTC_Notice(who, "私聊房间的状态已改变，加入请求已自动取消。");
    }
    if (p >= 1 && p <= 13 && p != who) {
        BOTC_Notice(p, "私聊房间的状态已改变，加入请求已自动取消。");
    }
}

// 【房间状态变化 → 默认拒绝·邀请】（用户 2026-11-10）：发出邀请的房主离开房间，
//   或被邀请人已经进了别的私聊，邀请直接失效，不等 15 秒超时，也不记拒绝冷却。
void BOTC_InviteVoid (int p) {
    int from;
    from = 0;
    if (p >= 1 && p <= 13) {
        from = g_invFrom[p];
        BOTC_InviteClear(p);
    }
    if (from >= 1 && from <= 13) {
        BOTC_Notice(from, "私聊房间的状态已改变，邀请已自动取消。");
    }
    if (p >= 1 && p <= 13) {
        BOTC_Notice(p, "私聊房间的状态已改变，邀请已失效。");
    }
}

// 【屏蔽时拆开共同私聊】（用户 2026-11-06）：a 屏蔽 b 之后，凡两人同时所在的私聊，
//   把两人一起移出（其余成员继续；只剩一人时按【退出私聊】同一口径自动结束）。
//   说书人不参与屏蔽（入口已经挡住），这里不必处理"夜间说书人退群 = 解散"。
void BOTC_BlockKickShared (int a, int b) {
    int s;
    int i;
    int nb;
    bool hit;
    hit = false;
    for (s = 1; s <= 13; s += 1) {
        if (!g_sessAlive[s]) {
            continue;
        }
        if (!g_member[(s * 14) + a]) {
            continue;
        }
        if (!g_member[(s * 14) + b]) {
            continue;
        }
        hit = true;
        g_member[(s * 14) + a] = false;
        g_mySess[a] = 0;
        BOTC_SayRender(a);
        g_member[(s * 14) + b] = false;
        g_mySess[b] = 0;
        BOTC_SayRender(b);
        // 房主被移出 → 剩余非说书人成员里玩家号最小者继承（和【退出私聊】同一口径）
        if (g_sessOwner[s] == a || g_sessOwner[s] == b) {
            nb = 0;
            for (i = 1; i <= 13; i += 1) {
                if (i == a || i == b || i == g_teller) {
                    continue;
                }
                if (g_member[(s * 14) + i]) {
                    nb = i;
                    break;
                }
            }
            g_sessOwner[s] = nb;
            BOTC_InviteClearSess(s);
            if (nb >= 1) {
                for (i = 1; i <= 13; i += 1) {
                    if (g_member[(s * 14) + i]) {
                        BOTC_AppendPm(i, BOTC_NameStr(BOTC_PosOf(nb)) + " 成为房主。");
                    }
                }
            }
        }
        for (i = 1; i <= 13; i += 1) {
            if (g_member[(s * 14) + i]) {
                BOTC_AppendPm(i, "因屏蔽关系，" + BOTC_NameStr(BOTC_PosOf(a)) + " 和 " + BOTC_NameStr(BOTC_PosOf(b)) + " 退出了这条私聊。");
            }
        }
        BOTC_CloseSessIfAlone(s);
    }
    if (!hit) {
        return;
    }
    // 【屏蔽不动已有私聊记录】（用户 2026-11-08）：拆开共同私聊只是结束会话，
    //   屏蔽之前双方发过的私聊全部保留；这条结束提示写进【日志 → 私聊记录】并告诉玩家去哪儿回看。
    BOTC_NoticeKeep(a, "因屏蔽关系，你与 " + BOTC_NameStr(BOTC_PosOf(b)) + " 的共同私聊已结束。之前的聊天记录仍可在【日志 → 私聊记录】查看。");
    BOTC_NoticeKeep(b, "因屏蔽关系，你与 " + BOTC_NameStr(BOTC_PosOf(a)) + " 的共同私聊已结束。之前的聊天记录仍可在【日志 → 私聊记录】查看。");
    BOTC_RefreshSessListAll();
}

// 【屏蔽 / 解除屏蔽】（用户 2026-11-06）：a 点魔典座位选中 b 后调用。
void BOTC_BlockToggle (int a, int b) {
    int s;
    if (a < 1 || a > 13 || b < 1 || b > 13 || a == b) {
        return;
    }
    // 【说书人不参与屏蔽】（用户 2026-11-06）：说书人既不能屏蔽，也不能被屏蔽。
    //   【按钮对说书人可见】（用户 2026-11-10）：按钮不再隐藏，点下去只给这句提示。
    if (a == g_teller) {
        BOTC_Notice(a, "说书人无法屏蔽玩家。");
        return;
    }
    if (b == g_teller) {
        BOTC_Notice(a, "说书人不能参与屏蔽。");
        return;
    }
    // 【防刷屏 · 屏蔽冷却】（用户 2026-11-06）：同一名玩家 5 秒内只能屏蔽 / 解除一次，
    //   换目标也算；先屏蔽再解除同样要等 5 秒。
    if (g_blockCd[a] > 0) {
        BOTC_Notice(a, "【屏蔽】冷却中：还需 " + IntToString((g_blockCd[a] + 1) / 2) + " 秒。");
        return;
    }
    g_blockCd[a] = 10;
    if (g_block[(a * 14) + b]) {
        g_block[(a * 14) + b] = false;
        // 【解除屏蔽不恢复旧发言】（用户 2026-11-08）：记下这次屏蔽的结束点，
        //   屏蔽期间的公聊行之后继续隐藏；屏蔽起点保留，供渲染时判定区间。
        g_blockHideTo[(a * 14) + b] = g_pubSeqN;
        BOTC_Notice(a, "已解除对 " + BOTC_NameStr(BOTC_PosOf(b)) + " 的屏蔽。");
        BOTC_Notice(b, BOTC_NameStr(BOTC_PosOf(a)) + " 已解除对你的屏蔽。");
        BOTC_PubAnnounce("【屏蔽】" + BOTC_NameStr(BOTC_PosOf(a)) + " 解除了对 " + BOTC_NameStr(BOTC_PosOf(b)) + " 的屏蔽。");
        return;
    }
    g_block[(a * 14) + b] = true;
    if (g_blockHideTo[(a * 14) + b] > 0) {
        // 【反复屏蔽】（用户 2026-11-08）：之前解除过 → 保留最早的屏蔽起点，
        //   避免上一段屏蔽期间的话被放出来；宁可多隐藏，不泄露屏蔽期内容。
        g_blockHideTo[(a * 14) + b] = 0;
    }
    else {
        // 【屏蔽起点】（用户 2026-11-08）：只隐藏此后新写的公聊行，之前的发言继续留在日志里可回看。
        g_blockSeq[(a * 14) + b] = g_pubSeqN;
    }
    // 【共同私聊当场拆开】（用户 2026-11-06）：两人还在同一条私聊里的话，立刻把两人都移出去。
    BOTC_BlockKickShared(a, b);
    // 双方之间还没处理完的请求立刻作废，不再等对方点确认。
    if (g_reqFrom[a] == b) {
        g_reqFrom[a] = 0;
        BOTC_ClearReq(a);
        BOTC_Notice(b, "你的私聊请求已被自动拒绝。");
    }
    if (g_reqFrom[b] == a) {
        g_reqFrom[b] = 0;
        BOTC_ClearReq(b);
        BOTC_Notice(a, "你对他的私聊请求已自动取消。");
    }
    if (g_invSess[a] != 0 && g_invFrom[a] == b) {
        BOTC_InviteClear(a);
        BOTC_Notice(b, "你的私聊邀请已被自动拒绝。");
    }
    if (g_invSess[b] != 0 && g_invFrom[b] == a) {
        BOTC_InviteClear(b);
        BOTC_Notice(b, "该私聊邀请已自动取消。");
    }
    if (g_reqJoinSess[a] != 0 && g_joinWho[g_reqJoinSess[a]] == b) {
        s = g_reqJoinSess[a];
        BOTC_RejectJoin(s);
    }
    if (g_reqJoinSess[b] != 0 && g_joinWho[g_reqJoinSess[b]] == a) {
        s = g_reqJoinSess[b];
        BOTC_RejectJoin(s);
    }
    BOTC_Notice(a, "已屏蔽 " + BOTC_NameStr(BOTC_PosOf(b)) + "。再点【屏蔽】并选中他即可解除屏蔽。");
    BOTC_Notice(b, "【屏蔽】" + BOTC_NameStr(BOTC_PosOf(a)) + " 屏蔽了你，之后你无法与他私聊。");
    BOTC_PubAnnounce("【屏蔽】" + BOTC_NameStr(BOTC_PosOf(a)) + " 屏蔽了 " + BOTC_NameStr(BOTC_PosOf(b)) + "。");
}

//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// 邪恶小窗（用户 2026-09-17）
//   · 说书人点右上角的【邪恶小窗：关】→ 开，再点一下（或入夜）自动关
//   · 开的时候把所有**邪恶阵营**（真身是爪牙 / 恶魔）拉进来；他们右边会多出一个框
//   · 在里面打字 = 一条小窗记录：只显示在小窗自己的记录里
//   · 只能在「正式开局之后的白天」开；夜里自动关
//--------------------------------------------------------------------------------------------------
// 这个座位是不是邪恶阵营（真身是爪牙 / 恶魔；酒鬼 / 陌客 / 圣徒都是善良）
bool BOTC_SeatIsEvil (int q) {
    int r;
    if (q < 2 || q > 13) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return false;
    }
    if (BOTC_RoleTeam(r) >= 2) {
        return true;
    }
    return false;
}

// 往小窗记录里追加一行（只留最后 200 条）
void BOTC_EvilAppend (string s) {
    int i;
    if (g_evilCount >= 200) {
        for (i = 0; i < 199; i += 1) {
            g_evilLog[i] = g_evilLog[i + 1];
        }
        g_evilLog[199] = s;
    }
    else {
        g_evilLog[g_evilCount] = s;
        g_evilCount = g_evilCount + 1;
    }
    if (g_evilOn) {
        BOTC_EvilRender();
    }
}

// 刷新小窗：谁看得到 + 列表内容（自动滚到最下面那条）
void BOTC_EvilRender () {
    int i;
    int k;
    if (g_evilDlg == 0) {
        return;
    }
    for (k = 1; k <= 13; k += 1) {
        if (g_evilOn && g_evilIn[k] && !g_isNight) {
            DialogSetVisible(g_evilDlg, PlayerGroupSingle(k), true);
        }
        else {
            DialogSetVisible(g_evilDlg, PlayerGroupSingle(k), false);
        }
    }
    if (!g_evilOn) {
        return;
    }
    // 可滚动列表：把存着的记录全铺进去（名字换成真名），再滚到最下面那条
    DialogControlRemoveAllItems(g_evilList, PlayerGroupAll());
    for (i = 0; i < g_evilCount; i += 1) {
        DialogControlAddItem(g_evilList, PlayerGroupAll(), BOTC_LineText(g_evilLog[i], 0));
    }
    if (g_evilCount > 0) {
        DialogControlSelectItem(g_evilList, PlayerGroupAll(), g_evilCount - 1);
    }
}

// 说书人那个按钮上的字
void BOTC_EvilBtnRender () {
    if (g_evilBtn == 0) {
        return;
    }
    if (g_evilOn) {
        libNtve_gf_SetDialogItemText(g_evilBtn, StringToText("邪恶小窗：开"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_evilBtn, StringToText("邪恶小窗：关"), PlayerGroupSingle(g_teller));
    }
}

// 开小窗：把所有邪恶阵营拉进来
void BOTC_EvilOpen () {
    int k;
    if (!g_evilEnable) {
        return;                        // 【邪恶小窗已彻底关闭】用户 2026-09-19
    }
    if (g_evilOn) {
        return;
    }
    g_evilOn = true;
    g_evilCount = 0;
    for (k = 1; k <= 13; k += 1) {
        g_evilIn[k] = false;
    }
    g_evilIn[g_teller] = true;                // 说书人自己也在小窗里（用户 2026-09-17）
    for (k = 2; k <= 13; k += 1) {
        if (BOTC_SeatIsEvil(k)) {
            g_evilIn[g_who[k]] = true;
        }
    }
    BOTC_EvilAppend("[私聊] 邪恶小窗：开启");
    BOTC_EvilRender();
    BOTC_SubMsg(g_teller, "【邪恶小窗】已开：你和邪恶阵营都能在右边那个框里说话。");
    for (k = 2; k <= 13; k += 1) {
        if (g_evilIn[k]) {
            BOTC_SubMsg(k, "说书人开了【邪恶小窗】：在右边那个框里打字，只有邪恶阵营（和说书人）看得到。");
        }
    }
    // ⚠ 这里**不写普通私聊记录**：小窗内容只留在邪恶小窗自己的记录里。
    BOTC_EvilBtnRender();
    BOTC_EvilBtnRender();
}

// 关小窗（说书人手动关 / 入夜自动关）
void BOTC_EvilClose () {
    int k;
    if (!g_evilOn) {
        return;
    }
    g_evilOn = false;
    BOTC_EvilRender();               // 先把每个人那边的框收掉
    for (k = 1; k <= 13; k += 1) {
        if (g_evilIn[k]) {
            if (k != 1) {
                BOTC_SubMsg(k, "【邪恶小窗】已关闭。");
            }
            g_evilIn[k] = false;
        }
    }
    // ⚠ 同样不写普通私聊记录。
    BOTC_EvilBtnRender();
}

// 说书人点【邪恶小窗】那个按钮
void BOTC_EvilToggle () {
    if (g_evilOn) {
        BOTC_EvilClose();
        return;
    }
    if (!g_started) {
        BOTC_Notice(g_teller, "还没正式开始：邪恶小窗要等游戏正式开始之后的白天才能开。");
        return;
    }
    if (g_isNight) {
        BOTC_Notice(g_teller, "现在是夜晚：邪恶小窗只能在白天开（夜里会自动关）。");
        return;
    }
    BOTC_EvilOpen();
}

// 在小窗里说一句话：只发给小窗里的人，日志里按「私聊」记
void BOTC_EvilSend (int p) {
    string msg;
    string line;
    int i;
    playergroup pg;
    // 【取名阶段禁止聊天】（用户 2026-11-13）：邪恶小窗也不许发言。
    if (g_introOn) {
        BOTC_Notice(p, "取名阶段禁止聊天，请在屏幕中央输入框取名。");
        return;
    }
    if (!g_evilOn || !g_evilIn[p]) {
        BOTC_Notice(p, "你现在不在邪恶小窗里。");
        return;
    }
    if (g_isNight) {
        BOTC_Notice(p, "邪恶小窗夜里是关着的。");
        return;
    }
    msg = libNtve_gf_DialogItemEditValue(g_evilEdit, p);
    msg = BOTC_ChatNoColor(msg);
    if (StringLength(msg) == 0) {
        return;
    }
    line = "[私聊] " + BOTC_SayToken(p) + "：" + msg;
    pg = PlayerGroupEmpty();
    g_chatWhoNow = BOTC_PosOf(p);    // 这一行是谁说的（渲染时名字按他的颜色显示）
    for (i = 1; i <= 13; i += 1) {
        if (g_evilIn[i]) {
            // ⚠ **不写进私聊记录**（用户 2026-09-17：小窗内容别出现在左边的私聊框里），只弹一下提示
            PlayerGroupAdd(pg, i);
        }
    }
    g_chatWhoNow = 0;
    UIDisplayMessage(pg, c_messageAreaSubtitle, StringToText("[私聊] ") + BOTC_SpeakerNameText(p) + StringToText(": " + msg));

    BOTC_EvilAppend(line);
    libNtve_gf_SetDialogItemText(g_evilEdit, StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_evilEdit, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_evilEdit, PlayerGroupSingle(p), true);
}

// 建小窗本体（挂在屏幕右侧，只给邪恶阵营看）
void BOTC_BuildEvil () {
    // 贴在**屏幕最右边**（用右上角锚点，跟右上角那几个按钮排在同一列），输入框压在窗口**最下面**
    //   2026-09-19：记录改成跟日志一样的**可滚动列表框**；高度减半（560 -> 280）、整体再往下挪 200
    DialogCreate(400, 280, c_anchorTopRight, 10, 600, false);
    g_evilDlg = DialogLastCreated();
    DialogSetVisible(g_evilDlg, PlayerGroupAll(), false);
    g_evilTitle = BOTC_NewLabel(g_evilDlg, 400, 26, 4, 2, StringToText("邪恶小窗（只有邪恶阵营看得到）"));
    libNtve_gf_SetDialogItemStyle(g_evilTitle, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_evilTitle, false, PlayerGroupAll());
    g_evilList = BOTC_NewList(g_evilDlg, 392, 206, 4, 30);
    // 邪恶小窗的输入框 + 发送按钮撤掉（用户 2026-09-19）：改用顶部那个聊天开关 + 回车
    g_evilEdit = BOTC_NewEdit(g_evilDlg, 300, 34, 4, 240);
    DialogControlSetVisible(g_evilEdit, PlayerGroupAll(), false);
    g_evilSend = BOTC_NewButton(g_evilDlg, 88, 34, 308, 240, "发送");
    g_evilCount = 0;
    g_evilOn = false;
}

//--------------------------------------------------------------------------------------------------
void BOTC_ToggleHide (int p) {
    g_hidden[p] = !g_hidden[p];
    if (g_hidden[p]) {
        DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), false);
        DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), true);
    }
    else {
        DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), false);
        DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), true);
    }
}

//--------------------------------------------------------------------------------------------------
// 打 token 的点击（＋ 开面板 / 面板里 20 个按钮 / 清除全部 / 关闭）
//   用户 2026-09-17：这一套在**提名阶段也要能用**（玩家也能在魔典上打 token），所以抽成函数两处共用。
//--------------------------------------------------------------------------------------------------
bool BOTC_TokClick (int p, int c) {
    int q;
    if (c == g_tokClose) {
        DialogSetVisible(g_tokDlg, PlayerGroupSingle(p), false);
        g_tokFake = false;
        return true;
    }
    if (c == g_tokClear) {
        BOTC_TokClearAll(p);
        return true;
    }
    if (c == g_tokPrev) {
        if (g_tokPage[p] > 1) {
            g_tokPage[p] = g_tokPage[p] - 1;
        }
        BOTC_TokRender(p);
        return true;
    }
    if (c == g_tokNext) {
        g_tokPage[p] = g_tokPage[p] + 1;      // 越界由 BOTC_TokRender 夹回来
        BOTC_TokRender(p);
        return true;
    }
    for (q = 0; q < 256; q += 1) {             // 表扩到 256：新加的 token 也要能手动打
        if (c == g_tokBtn[q]) {
            BOTC_TokToggle(p, q);
            return true;
        }
    }
    for (q = 2; q <= 13; q += 1) {
        if (c == g_grimTokBtn[q]) {
            BOTC_TokOpen(p, q);
            return true;
        }
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// 事件
//--------------------------------------------------------------------------------------------------
bool BOTC_ClickDo (bool testConds, bool runActions) {
    int p;
    int c;
    int q;
    int b;
    p = EventPlayer();
    c = EventDialogControl();
    if (!runActions) {
        return true;
    }
    if (p < 1 || p > 13) {
        return true;
    }
    // 【取名阶段 · 确认】（用户 2026-11-13）：输入框留空则随机取名。
    if (g_introOn && g_introBtn != 0 && c == g_introBtn) {
        BOTC_IntroConfirm(p);
        return true;
    }
    // 【菜单】（用户 2026-11-09）：右上角【菜单】按钮＝打开星际自带的 F10 菜单
    if (g_menuBtn != 0 && c == g_menuBtn) {
        UIShowStandardMenu(PlayerGroupSingle(p));
        return true;
    }
    // 【竞选角色类型】（用户 2026-11-11）：右上角入口 / 4 个类型开关 / 关闭（保存）
    if (g_jrOpenBtn[p] != 0 && c == g_jrOpenBtn[p]) {
        BOTC_JrToggle(p);
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (g_jrTypeBtn[(p * 4) + q] != 0 && c == g_jrTypeBtn[(p * 4) + q]) {
            BOTC_JrTypeClick(p, q);
            return true;
        }
    }
    if (g_jrCloseBtn[p] != 0 && c == g_jrCloseBtn[p]) {
        BOTC_JrClose(p);
        return true;
    }
    // 【伪造魔典】（用户 2026-11-07）：入口按钮 / 座位 / ＋ / 弹窗按钮
    if (c > 0) {
        if (c == g_fakeAskReal) {
            if (p == g_teller) {
                BOTC_FakeAskAnswer(0);
            }
            return true;
        }
        if (c == g_fakeAskFake) {
            if (p == g_teller) {
                BOTC_FakeAskAnswer(1);
            }
            return true;
        }
        if (c == g_fakeAskX) {
            if (p == g_teller) {
                BOTC_FakeAskAnswer(-1);
            }
            return true;
        }
        if (BOTC_FakeClick(p, c)) {
            return true;
        }
    }
    // 【多重能力】只属于手动唤醒界面的独立按钮，和魔典身份网格完全分离。
    for (q = 0; q < 6; q += 1) {
        if (c == g_wakeChoiceBtn[q]) {
            if (p == g_teller) {
                BOTC_WakeAbilityChoicePick(q);
            }
            return true;
        }
    }
    if (c == g_wakeChoiceCancel) {
        if (p == g_teller) {
            BOTC_WakeAbilityChoiceCancel();
        }
        return true;
    }
    // 【右上角 X】（用户 2026-11-01）：等同于【取消】
    if (c == g_wakeChoiceX) {
        if (p == g_teller) {
            BOTC_WakeAbilityChoiceCancel();
        }
        return true;
    }
    // 【强制玩家发起提名】（用户 2026-11-03）：按钮 / 弹窗的发起、取消与 X
    if (c == g_fnBtn) {
        if (p == g_teller) {
            BOTC_ForceNomOpen();
        }
        return true;
    }
    if (c == g_fnOk) {
        if (p == g_teller) {
            BOTC_ForceNomSubmit();
        }
        return true;
    }
    if (c == g_fnCancel || c == g_fnX) {
        if (p == g_teller) {
            BOTC_ForceNomClose();
            BOTC_Notice(g_teller, "【强制发起提名】已取消。");
        }
        return true;
    }
    // 玩家1 真的在点界面 → 他百分之百是真人（电脑不会点）。
    //   万一「玩家类型」那个原生函数判错了、把真人说书当成电脑，这里立刻纠回手动说书；
    //   用聊天里的「AI」强制开启智能说书时不走这一步（那条由 g_p1ForceComputer 顶着）。
    // 胜负横幅上的【重新开始】：说书人点一下 = 清掉上一局并回到剧本选择页面（用户 2026-11-01）
    if (c == g_winBtn) {
        if (p == g_teller) {
            BOTC_WinRestart();
        }
        return true;
    }
    // 胜负面板上的【复盘】：说书人把自己的魔典（含 token）公开给全场
    if (c == g_replayBtn) {
        if (p == g_teller) {
            BOTC_ReplayReveal();
        }
        return true;
    }
    // 【说书人评分】（用户 2026-11-02）：结算阶段点 1..5 分
    for (q = 0; q < 5; q += 1) {
        if (c == g_rateBtn[q]) {
            BOTC_RateSubmit(p, q + 1);
            return true;
        }
    }
    // 传位面板：说书人点一名爪牙 → 他变成新的恶魔（跟死掉的那只同一种）
    for (q = 0; q < 12; q += 1) {
        if (c == g_promBtn[q]) {
            if (p == g_teller) {
                if (g_promSeat[q] >= 2) {
                    BOTC_PromoteTo(g_promSeat[q]);
                    BOTC_PromoteHide();
                    g_promoteOpen = false;
                    BOTC_Notice(g_teller, "已传位：" + BOTC_NameStr(g_promSeat[q]) + " 变成了新的" + g_roleName[g_demonKind] + "。");
                }
            }
            return true;
        }
    }
    if (c == g_promClose) {
        if (p == g_teller) {
            BOTC_PromoteHide();
            BOTC_Notice(g_teller, "已收起传位面板（也可以用【魔典】点座位自己改身份）。");
        }
        return true;
    }
    if (p == g_teller && g_wakeMode) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_WakeManualPick(q);
                return true;
            }
        }
    }
    // 【标记能力使用】（用户 2026-11-11）：点完按钮再点一个圆桌座位，按真身切换「失去能力」token
    if (p == g_teller && g_markUseMode) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_MarkUseToggleSeat(q);
                return true;
            }
        }
    }
    if (p == g_teller && g_bluffPickSeat) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_BluffSendAt(q);
                return true;
            }
        }
    }
    // 【投票踢人】（用户 2026-10-02）：正在 -kick 选人 → 点座位 = 对他发起踢出投票
    //   （点「说书人」那一格 = 对说书人本人发起）
    // 【换座位 · 正式版】（用户 2026-10-07）：点了按钮之后点一格 = 向那一格的人发请求
    if (g_askPick[p]) {
        for (q = 1; q <= 13; q += 1) {
            if (q == 1) {
                if (c != g_saySeatBtn && c != g_saySeatLbl) {
                    continue;
                }
            }
            else {
                if (c != g_grimSeat[q]) {
                    continue;
                }
            }
            BOTC_SeatAskSend(p, q);
            return true;
        }
    }
    // 请求框上的【同意】/【拒绝】
    if (c == g_askYes) {
        BOTC_SeatAskAnswer(p, true);
        return true;
    }
    if (c == g_askNo) {
        BOTC_SeatAskAnswer(p, false);
        return true;
    }
    // 【是否抄录魔典】（用户 2026-11-06）：间谍 / 寡妇本人点【抄录】/【不抄录】
    if (c == g_copyYes) {
        BOTC_CopyAskAnswer(BOTC_PosOf(p), true);
        return true;
    }
    if (c == g_copyNo) {
        BOTC_CopyAskAnswer(BOTC_PosOf(p), false);
        return true;
    }
    // 【测试·换座位】（用户 2026-10-07）：点两格 = 互换这两个座位（**可以点「说书人」那一格**）
    if (g_swapPickBy == p) {
        // 【确认发放之后不许再换】（用户 2026-10-11）：按钮虽然收掉了，已经进入选人状态的还能点 →
        //   这里再兜一道：说书人确认发放过（而且没解锁）就直接取消这一按。
        if (g_dealConfirmed && !g_swapUnlocked) {
            g_swapPickBy = 0;
            g_swapFirst = 0;
            BOTC_Notice(p, "说书人已经【确认发放】身份了：换座位已关闭，这一按取消了。");
            return true;
        }
        for (q = 1; q <= 13; q += 1) {
            if (q == 1) {
                if (c != g_saySeatBtn && c != g_saySeatLbl) {
                    continue;
                }
            }
            else {
                if (c != g_grimSeat[q]) {
                    continue;
                }
            }
            if (g_swapFirst == 0) {
                g_swapFirst = q;
                BOTC_Notice(p, "已选 " + BOTC_NameStr(q) + "（" + BOTC_SeatRoleStr(q) + "），再点第二个座位。");
            }
            else if (g_swapFirst == q) {
                BOTC_Notice(p, "不能选同一个，换一个。");
            }
            else {
                BOTC_SeatSwap(g_swapFirst, q);
                g_swapFirst = 0;
                g_swapPickBy = 0;
            }
            return true;
        }
    }
    // 【换说书人】（用户 2026-10-06）：正在选新说书人 → 点一个座位 = 他成为新说书人
    if (g_tellerPick == p) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_TellerHandover(p, q);
                return true;
            }
        }
    }
    if (g_kickMode == p) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_KickStart(p, q);
                return true;
            }
        }
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            BOTC_KickStart(p, 1);
            return true;
        }
    }
    // 【投票踢人】的两个按钮：谁都能点，但说书人 / 被踢的人那份本来就是隐藏的（点了也不生效）
    if (c == g_kickYes) {
        BOTC_KickCast(p, 1);
        return true;
    }
    if (c == g_kickNo) {
        BOTC_KickCast(p, 0);
        return true;
    }
    // 炸弹人 10 秒指向投票：所有在座参与者点一个座位，倒计时结束前可随时改选。
    if (g_boomVoteOn) {
        if (c == g_boomTellerBtn) {
            BOTC_BoomVotePick(p, 1);
            return true;
        }
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_BoomVotePick(p, q);
                return true;
            }
        }
    }
    // 占卜师正在验人：点座位优先当成选人
    if (p >= 2 && p <= 13) {
        if (g_ftPick[p]) {
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_FtPick(p, q);
                    return true;
                }
            }
        }
    }
    // 技能面板的按钮和槽位优先按控件所属的逻辑格处理。
    if (BOTC_SkillClickControl(p, c)) {
        return true;
    }
    // 玩家正在为技能选目标：直接找他当前所在的逻辑格，不依赖旧的物理号映射。
    q = BOTC_SkillPickerForPlayer(p);
    if (q >= 1) {
        for (b = 2; b <= 13; b += 1) {
            if (c == g_grimSeat[b]) {
                BOTC_SkillPickSeat(q, b);
                return true;
            }
        }
    }
    // 【炼金术士 × 间谍/寡妇】：已经先选好间谍/寡妇，再点一名存活玩家 → 立即结算
    if (p >= 1 && p <= 13 && g_alcPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                if (!BOTC_TargetIsLiving(q)) {
                    BOTC_Notice(p, "目标已死亡，请重新选择。");
                }
                else {
                    g_alcPick[p] = false;
                    g_alcSeat = q;
                    g_alcBy = BOTC_PosOf(p);
                    BOTC_AlchemistGuess(g_alcBy, g_alcRolePick[p]);
                    g_alcRolePick[p] = 0;
                    BOTC_DeclareRender();
                }
                return true;
            }
        }
    }
    // 【猜落难】（82）：点头像 = 公开猜他是落难少女
    if (p >= 1 && p <= 13 && g_damselPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_DamselGuess(BOTC_PosOf(p), q);
                return true;
            }
        }
    }
    // 有人正在用【声称】选人（猎手那种）：点头像 = 发动
    if (p >= 1 && p <= 13) {
        if (g_declarePick[p]) {
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_DeclareSlay(BOTC_PosOf(p), q);
                    return true;
                }
            }
        }
    }
    // 有人正在用【发起私聊】选人：点魔典上的座位 = 向他发起私聊（点完就退出选人、魔典回正常状态）
    //   玩家还能点「说书人」那一格（说书人没有座位号）
    if (g_pmPick[p]) {
        // 【屏蔽】（用户 2026-11-06）：同一次点座位流程里，先按屏蔽模式处理。
        if (g_blockPick[p]) {
            if (p != g_teller && (c == g_saySeatBtn || c == g_saySeatLbl)) {
                BOTC_BlockEnd(p);
                BOTC_Notice(p, "不能屏蔽说书人。");
                return true;
            }
            for (q = 2; q <= 13; q += 1) {
                if (c == g_grimSeat[q]) {
                    BOTC_BlockEnd(p);
                    if (g_who[q] < 1) {
                        BOTC_Notice(p, "这个座位现在没有玩家。");
                    }
                    else {
                        BOTC_BlockToggle(p, g_who[q]);
                    }
                    return true;
                }
            }
        }
        // 【按格子点、按物理座位发起】（用户 2026-10-07）：魔典格子给的是**位置**，
        //   而私聊要按**物理座位**建会话 / 投递 → 统一换成 g_who[格子]（说书人格 = 现在的说书人 g_teller）。
        //   ⚠ 原来写死 `p >= 2`：换位之后"坐在物理座位 1 的老说书人"是普通玩家，点说书人格子点不动 ——
        //     现在改成"只要你不是当前说书人"就能点。
        if (p != g_teller && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_PmPickEnd(p);
            BOTC_RequestChat(p, g_teller);
            return true;
        }
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_PmPickEnd(p);
                BOTC_RequestChat(p, g_who[q]);
                return true;
            }
        }
    }
    // 【看某玩家】（用户 2026-09-22）：日志面板点了【看某玩家】之后，点魔典上的座位 = 切到这个人的视图
    if (g_logPick[p]) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                g_logPick[p] = false;
                g_logMode[p] = 0;
                g_logViewWho[p] = q;
                BOTC_LogOpen(p);
                return true;
            }
        }
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            g_logPick[p] = false;
            BOTC_Notice(p, "看自己那一格不用切视图：直接点【我的私聊】就行。");
            return true;
        }
    }
    // 选板子期间：只认分类按钮、板子按钮和「本局设置」那几个按钮，其它点击一律忽略
    if (g_boardOpen) {
        if (g_boardStarting) {
            if (p == g_teller && c == g_boardStartBtn) {
                BOTC_BoardStartCancel();
                return true;
            }
            // 【倒计时期间禁止修改剧本】（用户 2026-11-13）：点剧本 / 分类给明确反馈
            if (p == g_teller) {
                if (c == g_boardTabOfficial || c == g_boardTabMore) {
                    BOTC_PubAnnounce("【开始说书】正在进入剧本的倒计时中，说书人不能更换剧本；如需更换请先点【取消说书】。");
                    return true;
                }
                for (q = 0; q < 12; q += 1) {
                    if (c == g_boardBtn[q] || c == g_boardPic[q]) {
                        BOTC_PubAnnounce("【开始说书】正在进入剧本的倒计时中，说书人不能更换剧本；如需更换请先点【取消说书】。");
                        return true;
                    }
                }
            }
            return true;
        }
        if (p == g_teller && c == g_boardStartBtn) {
            BOTC_BoardStart();
            return true;
        }
        // 【分类页只有说书人能切换】（用户 2026-11-04）：其他玩家同步看说书人当前所在页
        if (p == g_teller && c == g_boardTabOfficial) {
            if (g_boardPage != 1) {
                g_boardPage = 1;
                BOTC_BoardRender();
            }
            return true;
        }
        if (p == g_teller && c == g_boardTabMore) {
            if (g_boardPage != 2) {
                g_boardPage = 2;
                BOTC_BoardRender();
            }
            return true;
        }
        if (p == g_teller) {
            if (c == g_pmVisBtn) {
                BOTC_PmVisToggle();
                return true;
            }
        }
        for (q = 0; q < 12; q += 1) {
            if (c == g_boardBtn[q] || c == g_boardPic[q]) {
                b = BOTC_BoardAtSlot(q);
                if (b < 0) {
                    if (p == g_teller) {
                        BOTC_CustomOpen();
                    }
                }
                else {
                    if (b > 0) {
                        BOTC_BoardPick(p, b);
                    }
                }
                return true;
            }
        }
        // 【自定义剧本】那一层（用户 2026-10-03）：入口 / 分类 / 翻页 / 选人 / 保存 / 开始游戏都在这
        if (BOTC_CustomClick(p, c)) {
            return true;
        }
        return true;
    }
    // 镇长替死：说书人正在点座位选「替他死的人」（用户 2026-09-21）
    if (p == g_teller && g_mayorPick) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_MayorVictimAt(q);
                return true;
            }
        }
    }
    // 【典狱长·技能目标】（用户 2026-11-07）：无人死于处决时，点场上一名判罚候选
    // 结算上一批死亡。该点击只读取 g_wardenCand，不会改写本夜新选择的 g_wardenPick。
    if (p == g_teller && g_wardenAsk) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_WardenKillChoice(q);
                return true;
            }
        }
    }
    // 【小怪宝 / 军团·技能目标】（用户 2026-11-07）：在各自非唤醒夜序节点点选死亡目标。
    if (p == g_teller && g_mdOpen) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_ManualDeathPick(q);
                return true;
            }
        }
    }
    // 说书人正在标记处决 / 死亡：座位点击优先当作标记，不触发身份选择 / 提名
    if (p == g_teller && (g_execPick || g_deadPick)) {
        // 「说书人」那一格：处决标记 / 死亡标记模式下点它 = 标他自己（无神论者那条路）
        if (g_execPick && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_ExecToggleAt(1);
            return true;
        }
        if (g_deadPick && (c == g_saySeatBtn || c == g_saySeatLbl)) {
            BOTC_DeadToggleAt(1);
            return true;
        }
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                if (g_execPick) {
                    BOTC_ExecToggleAt(q);
                }
                else {
                    BOTC_DeadToggleAt(q);
                }
                return true;
            }
        }
    }
    // 【发送特定信息】（用户 2026-10-10）：正在等「收件人」时，点一个座位就选中他
    if (p == g_teller && (g_specMode == 1 || g_specMode == 2 || g_specMode == 5 || g_specMode == 7)) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_SpecPickSeat(q);
                return true;
            }
        }
    }
    // （心上人已改成「说书人面板 + 确认」的统一模板 ---- 用户 2026-09-21，这里不再走点头像模式）
    // 【死后选人超时兜底】（用户 2026-09-21）：月之子 / 呆瓜 60 秒没选 → 说书人点头像替他选
    //   ⚠ 走「代替他选」的专用路径，不会当成说书人自己声称那个角色
    if (p == g_teller && g_moonAskSt) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_MoonChildForce(q);
                return true;
            }
        }
    }
    if (p == g_teller && g_klutzAskSt) {
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                BOTC_KlutzForce(q);
                return true;
            }
        }
    }
    // 提名阶段锁：除了提名相关的控件，其它操作一律不响应
    if (g_phase != 0) {
        if (BOTC_TokClick(p, c)) {
            return true;
        }
        if (c == g_nomBtn) {
            if (p == g_teller) {
                BOTC_NomCloseEx(false);      // 点【结束提名环节】只收环节，不入夜（入夜由说书人自己点，用户 2026-09-26）
            }
            return true;
        }
        if (c == g_chatBtn) {
            if (p == g_teller) {
                BOTC_ChatBtnClick();       // 说书人：切"时段"（公聊时间 / 私聊时间）
            }
            return true;
        }
        if (c == g_nightBtn) {
            if (p == g_teller) {
                BOTC_NightToggle();
            }
            return true;
        }
        if (c == g_nomStart) {
            BOTC_NomWant(BOTC_PosOf(p));
            return true;
        }
        if (c == g_nomEnd) {
            // 【只有当前发言人能结束自己这一段】（用户 2026-11-10 报「反驳会被自己跳过」）：
            //   阶段 3 只认提名者、阶段 4 只认被提名者；不能再让另一个人（尤其是刚点过
            //   【结束发言】的提名者）的重复点击把下一段发言直接跳掉。
            if (g_phase == 3 && BOTC_PosOf(p) == g_nomFrom) {
                BOTC_SpeechAdvance();
            }
            else if (g_phase == 4 && BOTC_PosOf(p) == g_nomTo) {
                BOTC_SpeechAdvance();
            }
            else if (g_phase == 5 && p == g_teller) {
                // 投票阶段：这个按钮对说书人可见，点它就直接结束投票
                BOTC_SpeechAdvance();
            }
            return true;
        }
        if (c == g_nomForce) {
            if (p == g_teller) {
                BOTC_SpeechAdvance();
            }
            return true;
        }
        if (c == g_voteYes) {
            BOTC_VoteSet(BOTC_PosOf(p), 1);
            return true;
        }
        if (c == g_voteNo) {
            BOTC_VoteSet(BOTC_PosOf(p), 2);
            return true;
        }
        // 【提名阶段也能点身份】（用户 2026-10-02 / 2026-10-03「解除魔典的点击限制」）：
        //   只有「正在等他说目标的那个提名者」（阶段 2 且就是他本人）才把点座位当成选目标；
        //   其余任何人点座位都**不再被提名环节吞掉** ---- 跟非提名阶段一样弹身份网格
        //   （说书人改身份 / 传位；玩家给自己那份魔典标身份）。
        for (q = 2; q <= 13; q += 1) {
            if (c == g_grimSeat[q]) {
                // 【邀请加入】（用户 2026-11-04）：当前私聊的房主在选人 → 点谁就向谁发出加入邀请
                if (g_invitePick && p == g_inviteBy) {
                    BOTC_InviteAt(q);
                    return true;
                }
                if (g_phase == 2 && BOTC_PosOf(p) == g_nomPickBy) {
                    BOTC_NomPick(BOTC_PosOf(p), q);
                    return true;
                }
                BOTC_PickOpen(p, q);
                return true;
            }
        }
        // 【提名说书人】（用户 2026-09-26）：发起提名后点「说书人」那一格 = 提名他
        if (c == g_saySeatBtn || c == g_saySeatLbl) {
            if (g_phase == 2 && BOTC_PosOf(p) == g_nomPickBy) {
                BOTC_NomPick(BOTC_PosOf(p), 1);
                return true;
            }
            if (p == g_teller) {
                // 【说书人格不能标记角色】（用户 2026-11-06）：改用【说书人工具 → 使用技能】。
                BOTC_Notice(p, "说书人的格子不能标记角色。请用【说书人工具 → 使用技能】。");
                return true;
            }
        }
        // 提名阶段依然允许看：日志 / 角色能力表 / 自己的魔典（魔典也能关掉再打开）
        if (c == g_logDlgBtn[p]) {
            BOTC_PanelToggle(p, 1);
            return true;
        }
        if (c == g_logPubBtn) {
            BOTC_LogSetMode(p, 0);
            return true;
        }
        if (c == g_logPmBtn) {
            BOTC_LogSetMode(p, 1);
            return true;
        }
        if (c == g_logVoteBtn) {
            BOTC_LogSetMode(p, 2);
            return true;
        }
        if (c == g_logSysBtn) {
            BOTC_LogSetMode(p, 3);
            return true;
        }
        // 【全部私聊】（2026-11-09）：说书人专用
        if (c == g_logAllPmBtn) {
            BOTC_LogSetMode(p, 4);
            return true;
        }
        // 【复盘】（用户 2026-11-11）：结算后查看本局完整记录
        if (c == g_rpBtn) {
            BOTC_LogSetMode(p, 5);
            return true;
        }
        // 【下拉里的行】（用户 2026-10-07）：列表框又改回轮询判定（BOTC_LogMenuTick），这里不用管
        if (c == g_logViewBtn) {
            BOTC_LogPickStart(p);
            return true;
        }
        if (c == g_logClose) {
            BOTC_LogClose(p);
            return true;
        }
        if (c == g_abOpenBtn[p]) {
            BOTC_PanelToggle(p, 3);
            return true;
        }
        if (c == g_tipBtn[p]) {
            BOTC_PanelToggle(p, 6);
            return true;
        }
        if (c == g_noteOpenBtn[p]) {
            BOTC_PanelToggle(p, 5);
            return true;
        }
        if (c == g_noteClose[p]) {
            BOTC_NoteClose(p);
            return true;
        }
        if (c == g_abPrev) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            BOTC_AbilityRender(p);
            return true;
        }
        if (c == g_abNext) {
            if (g_abPage[p] < 2) {
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_AbilityRender(p);
            return true;
        }
        if (c == g_abListPrev2 || c == g_abPrev) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            BOTC_RoleListRender(p);
            return true;
        }
        if (c == g_abListNext2 || c == g_abNext) {
            if (g_abPage[p] < 2) {
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_RoleListRender(p);
            return true;
        }
        if (c == g_abNewClose[p]) {          BOTC_AbClose(p);             return true;         }
        for (q = 0; q < 4; q += 1) {
            if (c == g_abCatPrev[(p * 4) + q]) {
                if (g_abCatPage[(p * 4) + q] > 1) {
                    g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] - 1;
                }
                BOTC_AbNewRender(p);
                return true;
            }
            if (c == g_abCatNext[(p * 4) + q]) {
                if (g_abCatPage[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_AbCatCap(q))) {
                    g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] + 1;
                }
                BOTC_AbNewRender(p);
                return true;
            }
        }
        if (c == g_abSubPrev[p]) {
            if (g_abPage[p] == 3 && g_glossPage[p] > 1) {
                g_glossPage[p] = g_glossPage[p] - 1;
            }
            if (g_abPage[p] == 4 && g_jinxPage[p] > 1) {
                g_jinxPage[p] = g_jinxPage[p] - 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abSubNext[p]) {
            if (g_abPage[p] == 3 && g_glossPage[p] < ((g_glossCount + 5) / 6)) {
                g_glossPage[p] = g_glossPage[p] + 1;
            }
            if (g_abPage[p] == 4 && g_jinxPage[p] < BOTC_JinxPageCount(p)) {
                g_jinxPage[p] = g_jinxPage[p] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abNewPrev[p]) {
            if (g_abPage[p] > 1) {
                g_abPage[p] = g_abPage[p] - 1;
            }
            if (g_abPage[p] == 5) { g_jinxPage[p] = 1; }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abNewNext[p]) {
            if (g_abPage[p] < 5) {
                if (g_abPage[p] == 3) { g_jinxPage[p] = 1; }
                g_abPage[p] = g_abPage[p] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        for (q = 0; q < 22; q += 1) {
            if (c == g_abNewHit[(p * 26) + q]) {
                // 【剧本角色表 → 帮助详情】（用户 2026-11-04）：剧本角色表保持打开，帮助面板直接显示该角色详情
                g_tipForce[p] = g_abNewRole[(p * 26) + q];
                g_tipMode[p] = 1;
                BOTC_TipOpen(p);
                return true;
            }
        }
        if (c == g_abListClose2) {
            BOTC_AbClose(p);
            return true;
        }
        if (c == g_abClose) {
            BOTC_AbClose(p);
            return true;
        }
        for (q = 0; q < 22; q += 1) {
            if (c == g_abListIcon[q]) {
                BOTC_AbClose(p);
                g_tipForce[p] = g_abListRole[q];
                g_tipMode[p] = 1;              // 【角色介绍】（用户 2026-11-04）：确保从场次统计/规则页点角色也能切回详情
                BOTC_TipOpen(p);
                return true;
            }
        }
        if (c == g_noUp[p]) {
            BOTC_NightOrderScroll(p, -6);
            return true;
        }
        if (c == g_noDown[p]) {
            BOTC_NightOrderScroll(p, 6);
            return true;
        }
        if (c == g_noClose[p]) {
            BOTC_AbClose(p);           // 统一关闭剧本角色表 / 夜间顺序两个视图
            return true;
        }
        if (c == g_abViewBtn[p]) {
            BOTC_AbViewNight(p);       // 左上角【夜间行动顺序】
            return true;
        }
        if (c == g_noViewBtn[p]) {
            BOTC_AbViewRole(p);        // 左上角【剧本角色】
            return true;
        }

        if (c == g_tipBtnRules) {
            g_tipMode[p] = 2;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_tipBtnStats) {
            g_tipMode[p] = 3;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_tipBtnWiki) {
            BOTC_WikiOpen(p);
            return true;
        }
        for (q = 0; q < 10; q += 1) {
            if (c == g_wikiCatBtn[q]) {
                g_wikiSel[p] = q;
                BOTC_WikiRender(p);
                return true;
            }
        }
        if (c == g_wikiClose) {
            g_wikiOpen[p] = false;
            DialogSetVisible(g_wikiDlg, PlayerGroupSingle(p), false);
            return true;
        }
        if (c == g_wikiArtBtn) {
            BOTC_ArtOpenPanel(p);
            return true;
        }
        for (q = 0; q < 10; q += 1) {
            if (c == g_artCatBtn[q]) {
                g_artSel[p] = q;
                BOTC_ArtRender(p);
                return true;
            }
        }
        if (c == g_artClose) {
            g_artOpen[p] = false;
            DialogSetVisible(g_artDlg, PlayerGroupSingle(p), false);
            return true;
        }
        if (c == g_artBack) {
            g_artOpen[p] = false;
            DialogSetVisible(g_artDlg, PlayerGroupSingle(p), false);
            BOTC_WikiOpen(p);
            return true;
        }
        if (c == g_tipClose) {
            BOTC_TipClose(p);
            return true;
        }
        if (c == g_tipBack) {
            // 【我的角色】（用户 2026-11-04）：回到自己的角色能力详情页，不再返回剧本角色表
            g_tipForce[p] = -1;
            g_tipMode[p] = 1;
            BOTC_TipRender(p);
            return true;
        }
        if (c == g_grimOpenBtn[p]) {
            BOTC_PanelToggle(p, 2);
            return true;
        }
        if (c == g_rsOpenBtn) {
            if (p == g_teller) {
                BOTC_RsOpen(g_teller);
            }
            return true;
        }
        if (c == g_rsCloseBtn) {
            BOTC_RsClose(p);
            return true;
        }
        for (q = 0; q < 4; q += 1) {
            if (c == g_rsCatPrev[q]) {
                BOTC_RsPageTurn(q, -1);
                return true;
            }
            if (c == g_rsCatNext[q]) {
                BOTC_RsPageTurn(q, 1);
                return true;
            }
        }
        if (c == g_rsRandomBtn) {
            BOTC_RsRandom(p);
            return true;
        }
        if (c == g_rsDealBtn) {
            BOTC_RsApply(p);
            return true;
        }
        for (q = 0; q < g_gridN; q += 1) {
            if (c == g_rsBtn[q]) {
                BOTC_RsToggle(p, q);
                return true;
            }
        }
        if (c == g_grimShare) {
            BOTC_ShareGrim(p);
            return true;
        }
        if (c == g_grimClose) {
            BOTC_GrimClose(p);
            return true;
        }
        if (c == g_claimBtnP[p]) {
            BOTC_ClaimOpen(p, BOTC_PosOf(p));
            return true;
        }

        if (c == g_wakeBtn) {
            if (p == g_teller) {
                BOTC_WakeBtnPress();
            }
            return true;
        }
        if (c == g_wakeManualBtn) {
            if (p == g_teller) {
                BOTC_WakeManualToggle();
            }
            return true;
        }
        if (c == g_pdBtn) {
            if (p == g_teller) {
                BOTC_PlagueDoctorAct();
            }
            return true;
        }
        if (c == g_organYes || c == g_organNo) {
            if (g_organSeat >= 1 && p == g_who[g_organSeat]) {
                if (c == g_organYes) {
                    BOTC_OrganChoose(1);
                }
                else {
                    BOTC_OrganChoose(0);
                }
            }
            return true;
        }
        if (c == g_alcSpyBtn || c == g_alcWidowBtn || c == g_alcCancelBtn) {
            if (g_alcChoice[p]) {
                if (c == g_alcSpyBtn) {
                    BOTC_AlchemistPickRole(p, 18);
                }
                else if (c == g_alcWidowBtn) {
                    BOTC_AlchemistPickRole(p, 75);
                }
                else {
                    BOTC_AlchemistPickRole(p, 0);
                }
            }
            return true;
        }
        if (c == g_specGrantBtn) {
            if (p == g_teller) {
                BOTC_SpecClose();
                BOTC_GrantOpen();
            }
            return true;
        }
        if (c == g_grantRoleBtn) {
            if (p == g_teller) {
                BOTC_GrantRoleOpen();
            }
            return true;
        }
        if (c == g_grantDrunkBtn) {
            if (p == g_teller) {
                BOTC_GrantDrunkToggle();
            }
            return true;
        }
        if (c == g_grantOk) {
            if (p == g_teller) {
                BOTC_GrantApply();
            }
            return true;
        }
        if (c == g_grantRecycleBtn) {
            if (p == g_teller) {
                BOTC_GrantRecycle();
            }
            return true;
        }
        if (c == g_grantClose) {
            if (p == g_teller) {
                BOTC_GrantClose();
            }
            return true;
        }
        // 【发送特定信息】（用户 2026-10-10）：按钮 → 打开小面板；面板里的两条 → 进入「点收件人」模式
        if (c == g_specBtn) {
            if (p == g_teller) {
                BOTC_SpecOpen();
            }
            return true;
        }
        if (c == g_specBtn1) {
            if (p == g_teller) {
                g_specMode = 1;
                DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
                BOTC_Notice(g_teller, "【自定义文本】点一个玩家的座位 = 收件人 → 输入文本后自动加「你得知」发送。");
            }
            return true;
        }
        if (c == g_specBtn2) {
            if (p == g_teller) {
                g_specMode = 2;
                DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
                BOTC_Notice(g_teller, "【玩家号 + 身份】点一个玩家的座位 = 收件人 → 填最多 6 个玩家号，并可选择最多 6 个身份。");
            }
            return true;
        }
        if (c == g_specRecogBtn) {
            if (p == g_teller) {
                BOTC_SpecClose();
                BOTC_SendRecognize();
            }
            return true;
        }
        if (c == g_specQuickBtn) {
            if (p == g_teller) {
                BOTC_SpecClose();
                BOTC_QuickRecognize();
            }
            return true;
        }
        if (c == g_specCastBtn) {
            if (p == g_teller) {
                BOTC_TellerCastOpen();
            }
            return true;
        }
        if (c == g_specMarkBtn) {
            if (p == g_teller) {
                BOTC_SpecClose();
                g_markUseMode = true;
                BOTC_NoticeKeep(g_teller, "【标记能力使用】点一个圆桌座位：该角色有对应的「失去能力」token 就自动打上，已经有则取消。");
            }
            return true;
        }
        if (c == g_recogOk) {
            if (p == g_teller) {
                BOTC_RecogSend();
            }
            return true;
        }
        if (c == g_recogCancel) {
            if (p == g_teller) {
                BOTC_RecogClose();
            }
            return true;
        }
        for (q = 0; q < 6; q += 1) {
            if (c == g_specRoleBtn[q]) {
                if (p == g_teller) {
                    BOTC_SpecRoleOpen(q);
                }
                return true;
            }
        }
        if (c == g_specInfoClear) {
            if (p == g_teller) {
                // 【发送不在场身份】（用户 2026-11-04）：模式 6 / 8 的这颗键改成【随机 3 个】
                if (g_specMode == 6 || g_specMode == 8) {
                    BOTC_SpecBluffRoll();
                }
                else {
                    BOTC_SpecSeatClear();
                }
            }
            return true;
        }
        if (c == g_specInfoOk) {
            if (p == g_teller) {
                BOTC_SpecSeatSend();
            }
            return true;
        }
        if (c == g_specClose) {
            if (p == g_teller) {
                BOTC_SpecClose();
            }
            return true;
        }
        // 【手动发送不在场身份 · 独立面板】（用户 2026-11-04）
        for (q = 0; q < 3; q += 1) {
            if (c == g_mbRoleBtn[q]) {
                if (p == g_teller) {
                    BOTC_SpecRoleOpen(q);
                }
                return true;
            }
        }
        if (c == g_mbRollBtn) {
            if (p == g_teller) {
                BOTC_MBluffRoll();
            }
            return true;
        }
        if (c == g_mbSendBtn) {
            if (p == g_teller) {
                BOTC_MBluffSend();
            }
            return true;
        }
        if (c == g_mbCancelBtn) {
            if (p == g_teller) {
                BOTC_MBluffCancel();
            }
            return true;
        }
        // 【首夜不在场身份弹窗】（用户 2026-11-04）：随机 / 发送 / 取消 / 手动选角色
        if (c == g_bluffAskRollBtn) {
            if (p == g_teller) {
                BOTC_BluffAskRoll();
            }
            return true;
        }
        if (c == g_bluffAskSendBtn) {
            if (p == g_teller) {
                BOTC_BluffAskSend();
            }
            return true;
        }
        if (c == g_bluffAskCancelBtn) {
            if (p == g_teller) {
                BOTC_BluffAskCancel();
            }
            return true;
        }
        for (q = 0; q < 3; q += 1) {
            if (c == g_bluffAskBtn[q]) {
                if (p == g_teller) {
                    BOTC_BluffAskPick(q);
                }
                return true;
            }
        }
        // 【异教领袖（106）· 教派投票】（用户 2026-10-10）：全员 20 秒投票 / 弃权
        if (c == g_cultYes) {
            BOTC_CultVoteAt(BOTC_PosOf(p), 1);
            return true;
        }
        if (c == g_cultNo) {
            BOTC_CultVoteAt(BOTC_PosOf(p), 2);
            return true;
        }

        // 【控件按格子索引】（用户 2026-10-07「确认按钮无效」）：面板是按格子建/发的，点击事件给的是物理座位 → 一律转成 BOTC_PosOf(p)
        if (c == g_skillBtn[BOTC_PosOf(p)]) {
            // 间谍没有目标可选：点技能直接把说书人那份魔典摊给他看
            // 【按「实际发动的能力」判】（用户 2026-11-09）：借到间谍能力的人也要能点开
            if (BOTC_ActRoleOf(BOTC_PosOf(p)) == 18) {
                BOTC_SpyPeek(BOTC_PosOf(p));
            }
            else {
                // 【寡妇（75）】（用户 2026-09-23）：首个夜晚点技能 = 看一眼魔典，再点一个人下毒
                if (BOTC_ActRoleOf(BOTC_PosOf(p)) == 75) {
                // 【寡妇顺序】（用户 2026-11-06）：先看魔典 → 选是否抄录 → 选完再进下毒面板
                if (!BOTC_WidowPeek(BOTC_PosOf(p))) {
                    BOTC_SkillOpen(BOTC_PosOf(p));
                }
                }
                else {
                    BOTC_SkillOpen(BOTC_PosOf(p));
                }
            }
            return true;
        }
        if (c == g_skillSlotA[BOTC_PosOf(p)]) {
            g_skillT1[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillSlotB[BOTC_PosOf(p)]) {
            if (BOTC_ComboRole(BOTC_ActRoleOf(BOTC_PosOf(p)))) {
                BOTC_ComboRoleOpen(BOTC_PosOf(p));
                return true;
            }
            g_skillT2[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillSlotC[BOTC_PosOf(p)]) {
            g_skillT3[BOTC_PosOf(p)] = 0;
            BOTC_SkillRender(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillNoPick[BOTC_PosOf(p)]) {
            BOTC_SkillCancel(BOTC_PosOf(p));       // 旧按钮兼容；珀改用前置询问后不会再显示
            return true;
        }

        if (c == g_skillOk[BOTC_PosOf(p)]) {
            BOTC_SkillConfirm(BOTC_PosOf(p));
            return true;
        }
        if (c == g_skillCancel[BOTC_PosOf(p)]) {
            BOTC_SkillCancel(BOTC_PosOf(p));
            return true;
        }
        if (c == g_execBtn) {
            if (p == g_teller) {
                BOTC_ExecMode();
            }
            return true;
        }
        if (c == g_deadBtn) {
            if (p == g_teller) {
                BOTC_DeadMode();
            }
            return true;
        }
        if (BOTC_WinAdminClick(p, c)) {
            return true;
        }
        if (c == g_declareBtn) {
            BOTC_DeclareClick(p);
            return true;
        }
        if (c == g_dclaimBtn) {
            BOTC_DClaimClick(p);
            return true;
        }


        // 【风雅集（板子 10）· 修行者（114）】（用户 2026-10-16）：两选一面板
        if (g_sgSeat >= 2) {
            if (c == g_sgB1) { BOTC_SgPick(p, 1); return true; }
            if (c == g_sgB2) { BOTC_SgPick(p, 2); return true; }
            if (c == g_sgX) { BOTC_SgClose(); return true; }
        }
        // 【说书人判定 · 是 / 否】（用户 2026-11-12）：侍臣 × 无神论者、吟游诗人 × 无神论者
        if (g_judgeKind != 0) {
            if (c == g_judgeYes) { BOTC_JudgeAnswer(1); return true; }
            if (c == g_judgeNo || c == g_judgeX) { BOTC_JudgeAnswer(0); return true; }
        }
        // 【赌徒 · 说书人判定】（用户 2026-11-01）：猜陌客 / 间谍时点「死亡 / 存活」
        if (g_gblSeat >= 2) {
            if (c == g_gblDie) { BOTC_GblPick(p, 1); return true; }
            if (c == g_gblLive) { BOTC_GblPick(p, 0); return true; }
            if (c == g_gblX) { BOTC_GblClose(); return true; }
        }
        // 哈迪寂亚（87）：当前目标点「活着 / 死亡」（说书人也能替他点）
        if (g_hdActive && g_hdNow >= 0 && g_hdNow <= 2) {
            if (c == g_hdBtnLive[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 1); return true; }
            if (c == g_hdBtnDie[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 2); return true; }
        }
        // 【造谣者】公开声明输入框：确定 / 取消（用户 2026-09-20）
        if (c == g_gossipOk) {
            BOTC_GossipSubmit(p);
            return true;
        }
        if (c == g_gossipCancel) {
            DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
            return true;
        }
        // 【杂耍艺人】5 组「座位号 + 身份」面板：确定 / 取消 / 5 个小按钮（用户 2026-09-21）
        if (c == g_juggOk) {
            BOTC_JugglerOk(p);
            return true;
        }
        if (c == g_juggCancel) {
            BOTC_JugglerCancel(p);
            return true;
        }
        if (c == g_juggRoleBtn[0]) { BOTC_JugglerPickRow(p, 1); return true; }
        if (c == g_juggRoleBtn[1]) { BOTC_JugglerPickRow(p, 2); return true; }
        if (c == g_juggRoleBtn[2]) { BOTC_JugglerPickRow(p, 3); return true; }
        if (c == g_juggRoleBtn[3]) { BOTC_JugglerPickRow(p, 4); return true; }
        if (c == g_juggRoleBtn[4]) { BOTC_JugglerPickRow(p, 5); return true; }
        // 【真人说书 · 信息位答题框】（用户 2026-09-20）：确定 / 取消
        if (c == g_miOk) {
            if (p == g_teller) {
                BOTC_ManInfoOk();
            }
            return true;
        }
        if (c == g_miCancel) {
            if (p == g_teller) {
                DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
                BOTC_MiCancelApply();       // 军团那步点取消 = 不屏蔽（疯子看到所有队友）
            }
            return true;
        }
        // 【右上角 X】（用户 2026-11-01）：夜间答题框直接关掉，等同【取消】
        if (c == g_miX) {
            if (p == g_teller) {
                DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
                BOTC_MiCancelApply();
            }
            return true;
        }
        if (c == g_miYes) {
            if (p == g_teller || (g_miRole == 813 && g_miSeat >= 2 && p == g_who[g_miSeat])) {
                BOTC_ManInfoYesNo(1);
            }
            return true;
        }
        if (c == g_miNo) {
            if (p == g_teller || (g_miRole == 813 && g_miSeat >= 2 && p == g_who[g_miSeat])) {
                BOTC_ManInfoYesNo(0);
            }
            return true;
        }
        // 【猎手请求】真人说书：是 / 否（说书人拍板）
        if (c == g_slayYes) {
