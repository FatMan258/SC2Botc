}

// 【教派投票面板】（用户 2026-10-10）：声称异教领袖之后开给**所有人**，20 秒【投票】/【弃权】
void BOTC_BuildCult () {
    DialogCreate(780, 300, c_anchorCenter, 0, -110, false);
    g_cultDlg = DialogLastCreated();
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    g_cultTitle = BOTC_NewLabelC(g_cultDlg, 740, 32, 20, 14, StringToText("教派提议"));
    libNtve_gf_SetDialogItemStyle(g_cultTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_cultTitle, false, PlayerGroupAll());
    g_cultCnt = BOTC_NewLabel(g_cultDlg, 740, 32, 20, 56, StringToText("剩余 20 秒"));
    libNtve_gf_SetDialogItemStyle(g_cultCnt, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_cultCnt, false, PlayerGroupAll());
    g_cultInfo = BOTC_NewLabelC(g_cultDlg, 740, 26, 20, 96, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_cultInfo, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_cultInfo, false, PlayerGroupAll());
    g_cultYes = BOTC_NewButton(g_cultDlg, 300, 52, 50, 140, "投票（同意加入）");
    g_cultNo = BOTC_NewButton(g_cultDlg, 300, 52, 430, 140, "弃权");
    g_cultNote = BOTC_NewLabelC(g_cultDlg, 740, 24, 20, 214, StringToText("所有存活善良玩家都投【投票】→ 按异教领袖当时的阵营判胜负"));
    libNtve_gf_SetDialogItemStyle(g_cultNote, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_cultNote, false, PlayerGroupAll());
}

// 开始教派投票（q = 提议人的格子）
void BOTC_CultStart (int q) {
    int i;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_cultOn) {
        BOTC_Notice(g_who[q], "已经有一次教派提议在投票了，等这一轮结束。");
        return;
    }
    g_cultOn = true;
    g_cultWho = q;                  // 【提议人（格子）】（用户 2026-10-11 修）：原来这行被漏掉了，结算里读到的永远是 0
    // 【用提名那套原生投票】（用户 2026-10-10）：没有提名人 / 被提名人，直接进"投票阶段"
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    for (i = 0; i <= 13; i += 1) {
        g_vote[i] = 0;                 // 原生那张投票表：这一轮重新投
        g_voteWasDead[i] = false;
        g_cultVote[i] = 0;
    }
    g_cultPhaseBak = g_phase;          // 【借代码不照搬】记下进来之前的阶段，结束以后原样还原
    //   ⚠ 不是"开提名环节"：投票期间那颗【进入提名环节】按钮由 NomUI 收着

    BOTC_PhaseSet(5);                  // 进投票阶段：投票 / 弃权按钮 + 座位上的投票标记都是原生那套
    libNtve_gf_StopTimer(g_tSpeech);
    libNtve_gf_StopTimer(g_tVote);
    TimerStart(g_tVote, 20.0, false, c_timeGame);   // 原生那个投票计时器：这次是 20 秒
    BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 公开提议入教 → 20 秒投票。");
    BOTC_NomUI();
}

// 投票 / 弃权（p = 格子）
void BOTC_CultVoteAt (int p, int v) {
    if (!g_cultOn) {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    g_cultVote[p] = v;
    BOTC_CultRender();
    // 【必须等满 20 秒】（用户 2026-10-10）：这里**不**提前结算，到点由 g_tCult 计时器统一结算
}

// 存活善良玩家是不是都投了【投票】
bool BOTC_CultAllAgreed () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        // 【死了的善良玩家也要投】（用户 2026-10-10）：教派投票里死人不算弃权，照样要点【投票】才算全员同意
        if (BOTC_SeatAlign(i) != 0) { continue; }
        if (g_vote[i] != 1) {           // 【原生那张表】（用户 2026-10-10）
            return false;
        }
    }
    return true;
}

// 刷新：倒计时 + 还没投的善良玩家
void BOTC_CultRender () {
    int i;
    int sec;
    string s;
    bool secret;
    if (!g_cultOn) {
        return;
    }
    libNtve_gf_SetDialogItemText(g_cultTitle, BOTC_NameSubstText(StringToText("教派提议：" + BOTC_NameStr(g_cultWho) + " 邀请所有人加入他的教派")), PlayerGroupAll());
    sec = FixedToInt(TimerGetRemaining(g_tCult));
    if (sec < 0) {
        sec = 0;
    }
    libNtve_gf_SetDialogItemText(g_cultCnt, StringToText("剩余 " + IntToString(sec) + " 秒"), PlayerGroupAll());
    s = "";
    secret = BOTC_OrganActive();
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        // 【死了的善良玩家也要投】（用户 2026-10-10）：这里跟 BOTC_CultAllAgreed 同一口径
        if (BOTC_SeatAlign(i) != 0) { continue; }
        if (g_vote[i] == 1) { continue; }
        if (secret) { continue; }
        if (StringLength(s) > 0) { s = s + ","; }
        s = s + BOTC_NameStr(i);
    }
    if (secret) {
        s = "街头风琴手能力生效：投票人与票数均保密";
    }
    else {
        if (StringLength(s) <= 0) {
            s = "（善良玩家都投完了）";
        }
        s = "还没投的善良玩家：" + s;
    }
    libNtve_gf_SetDialogItemText(g_cultInfo, BOTC_NameSubstText(StringToText(s)), PlayerGroupAll());
}

// 结算 + 清空（timeout = 是不是倒计时到点）
void BOTC_CultEnd (bool timeout) {
    int i;
    int side;
    bool ok;
    if (!g_cultOn) {
        return;
    }
    ok = BOTC_CultAllAgreed();
    // 【没能力 / 中毒酒鬼 → 不结算胜利】（用户 2026-10-11）：投票照走，但只有真有这个能力的人才判胜
    if (ok) {
        if (!BOTC_AbilityWorks(g_cultWho, 106)) {
            ok = false;
            BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(g_cultWho) + " 全员同意，但没有可用的异教领袖能力（科学怪人来源失效 / 中毒 / 无此能力）→ 不结算胜利。");
        }
    }
    side = BOTC_SeatAlign(g_cultWho);
    g_cultOn = false;
    for (i = 0; i <= 13; i += 1) {
        g_cultVote[i] = 0;               // 【倒计时一结束就清空】（用户 2026-10-10）
        g_vote[i] = 0;                   // 原生那张投票表也清掉（原生收尾口径）
        g_voteWasDead[i] = false;
    }
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);    // 我自己那块面板不再用了，顺手收掉
    // 【20 秒到点就把【投票】/【弃权】收回】（用户 2026-10-10）：这里显式收一次，
    //   不管还原成哪个阶段都保证这两颗按钮一定消失（座位上的投票标记由 g_vote 清空后 NomUI 重画成空白）
    DialogControlSetVisible(g_voteYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteNo, PlayerGroupAll(), false);
    BOTC_PhaseSet(g_cultPhaseBak);     // 【借代码不照搬】还原成进来之前的阶段（一般是 0 = 没在提名环节）
    BOTC_NomUI();
    if (ok) {
        BOTC_PubAnnounce("【教派】所有善良玩家都同意加入教派！");
        BOTC_PmStore(g_teller, "【异教领袖】全员同意 → 按异教领袖现在的阵营判胜负。");
        BOTC_ShowWin(side, "所有善良玩家都加入了异教领袖的教派，", "小镇从此只有一种声音。");
    }
    else {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(g_cultWho) + " 的教派提议没有全员同意 → 提议失败。");
    }
}

bool BOTC_CultTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    BOTC_CultEnd(true);
    return true;
}

void BOTC_SpecOpen () {
    int i;
    // 【再点【发送特定信息】= 取消等待发送】（用户 2026-11-04）：此时已经选好 3 个不在场身份、
    //   正等说书人点座位，再点按钮不再重新打开面板，而是取消本次发送并给出反馈。
    if (g_specMode == 7) {
        g_specMode = 0;
        g_specTo = 0;
        g_specPickSlot = 0;
        g_specBluffOn = false;
        g_mbOn = false;
        DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
        for (i = 0; i < 6; i += 1) {
            g_specRoleSel[i] = 0;
        }
        BOTC_NoticeKeep(g_teller, "【发送不在场身份】已取消，没有发给任何人。");
        return;
    }
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    // 【手动发送不在场身份】（用户 2026-11-04）：再点【发送特定信息】= 取消等待发送的独立面板
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), true);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), false);
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送给他"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, StringToText("说书人工具"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("前三种方式需要先点一名玩家作为收件人；快捷发送互认直接自动发给全场恶魔和爪牙；使用技能只能在夜间由说书人发动一个本剧本角色。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("关闭"), PlayerGroupAll());
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecClose () {
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
}

void BOTC_BuildGrant () {
    DialogCreate(780, 400, c_anchorCenter, 0, -80, false);
    g_grantDlg = DialogLastCreated();
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
    g_grantTitle = BOTC_NewLabelC(g_grantDlg, 740, 34, 20, 12, StringToText("赋予能力"));
    libNtve_gf_SetDialogItemStyle(g_grantTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_grantTitle, false, PlayerGroupAll());
    BOTC_NewLabel(g_grantDlg, 150, 30, 30, 66, StringToText("玩家号（1~12）"));
    g_grantSeatEdit = BOTC_NewEdit(g_grantDlg, 150, 42, 30, 100);
    g_grantRoleBtn = BOTC_NewButton(g_grantDlg, 260, 42, 210, 100, "选择能力");
    g_grantDrunkBtn = BOTC_NewButton(g_grantDlg, 160, 42, 500, 100, "醉酒");
    g_grantOk = BOTC_NewButton(g_grantDlg, 180, 44, 90, 250, "赋予");
    g_grantRecycleBtn = BOTC_NewButton(g_grantDlg, 180, 44, 300, 250, "回收");
    g_grantClose = BOTC_NewButton(g_grantDlg, 180, 44, 510, 250, "关闭");
    libNtve_gf_SetDialogItemText(g_grantSeatEdit, StringToText(""), PlayerGroupAll());
}

void BOTC_GrantOpen () {
    g_grantRoleSel = 0;
    g_grantDrunk = false;
    libNtve_gf_SetDialogItemText(g_grantSeatEdit, StringToText(""), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_grantRoleBtn, StringToText("选择能力"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_grantDrunkBtn, StringToText("醉酒"), PlayerGroupAll());
    DialogSetVisible(g_grantDlg, PlayerGroupSingle(g_teller), true);
}

// 自定义板 7 的 g_boardRole 可能来自开局缓存；打开赋予能力前按实际勾选重建，
// 防止新加到 g_csel 的角色没有进入当前板子角色池。
void BOTC_CustomSyncBoardRoles () {
    int r;
    int n;
    if (g_board != 7) {
        return;
    }
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] == 4 || g_roleTeam[r] == 5) {
            continue;
        }
        if (n >= 128) {
            break;
        }
        g_boardRole[(7 * 256) + n] = r;
        n = n + 1;
    }
    if (n > 0) {
        g_boardRoleN[7] = n;
    }
}

void BOTC_GrantRoleOpen () {
    BOTC_CustomSyncBoardRoles();
    g_pickMode[g_teller] = 34;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("赋予能力：选择一个任意角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_grantDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_GrantDrunkToggle () {
    g_grantDrunk = !g_grantDrunk;
    if (g_grantDrunk) {
        libNtve_gf_SetDialogItemText(g_grantDrunkBtn, TextWithColor(StringToText("√ 醉酒"), Color(255, 160, 60)), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_grantDrunkBtn, StringToText("醉酒"), PlayerGroupSingle(g_teller));
    }
}

// 替换 / 回收手工能力前，撤掉旧能力自己维护的游戏标记，避免旧被动继续残留。
void BOTC_GrantClearPassiveMarks (int q) {
    int old;
    if (q < 2 || q > 13) {
        return;
    }
    old = g_grantRoleBy[q];
    if (old == 24) {                       // 水手（23）+ 1：不会死亡（水手）26
        g_tokOn[(((g_teller * 14) + q) * 256) + 26] = false;
    }
    if (old == 35) {                       // 弄臣（34）+ 1：首次未死（弄臣）29
        g_tokOn[(((g_teller * 14) + q) * 256) + 29] = false;
    }
}

void BOTC_GrantApply () {
    int n;
    int q;
    string s;
    s = libNtve_gf_DialogItemEditValue(g_grantSeatEdit, g_teller);
    n = BOTC_TextNum(s);
    q = n + 1;
    if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_Notice(g_teller, "玩家号要填 1~12，并且那个座位有人。");
        return;
    }
    if (g_grantRoleSel <= 0 || g_grantRoleSel > 163) {
        BOTC_Notice(g_teller, "先选择一个要赋予的角色能力。");
        return;
    }
    BOTC_GrantClearPassiveMarks(q);
    g_grantRoleBy[q] = g_grantRoleSel;
    g_grantDrunkBy[q] = g_grantDrunk;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = g_nightNum;
    if (!g_isNight || g_grantFirstNight[q] < 1) {
        g_grantFirstNight[q] = g_nightNum + 1;
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    s = "（正常）";
    if (g_grantDrunk) {
        s = "（醉酒·无效）";
    }
    BOTC_PmStore(g_teller, "【赋予能力】" + BOTC_NameStr(q) + " 获得「" + g_roleName[g_grantRoleSel - 1] + "」能力" + s + "。第 " + IntToString(g_grantFirstNight[q]) + " 夜按这项能力的首个夜晚处理；未向玩家发送提示。");
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
}

void BOTC_GrantRecycle () {
    int b;
    int n;
    int q;
    string s;
    s = libNtve_gf_DialogItemEditValue(g_grantSeatEdit, g_teller);
    n = BOTC_TextNum(s);
    q = n + 1;
    if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_Notice(g_teller, "玩家号要填 1~12，并且那个座位有人。");
        return;
    }
    // 回收该玩家持有的手工附加能力，以及所有绑定到他的科怪借用能力。
    BOTC_GrantClearPassiveMarks(q);
    g_grantRoleBy[q] = 0;
    g_grantDrunkBy[q] = false;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = 0;
    g_boffinActing[q] = false;
    g_boffinActingSource[q] = 0;
    g_insertWake[q] = false;
    for (b = 2; b <= 13; b += 1) {
        if (b == q || g_boffinTargetBy[b] == q) {
            BOTC_BoffinClearSource(b);
        }
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【回收能力】已回收 " + BOTC_NameStr(q) + " 的所有附加能力。未向玩家发送提示。");
}

void BOTC_GrantClose () {
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
}

// ===== 【获得别人能力】（用户 2026-11-03）=====
// 失忆者 73 / 食人族 74 / 变脸师 117 / 小精灵 91 获得能力时，不再替换自身角色标记，
// 也不打「是哲学家 / 是炼金术士」token；统一走 g_grantRoleBy 这一层附加能力，能力真实生效。
void BOTC_AttachGrant (int q, int role, bool useNow) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    BOTC_GrantClearPassiveMarks(q);
    // 食人族得到新能力时失去旧能力：用 g_grantRoleBy 覆盖即可。被中毒 / 醉酒也照样记录（用户第 10 条）。
    g_grantRoleBy[q] = role + 1;
    g_grantDrunkBy[q] = false;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = g_nightNum;
    if (!g_isNight || g_grantFirstNight[q] < 1) {
        g_grantFirstNight[q] = g_nightNum + 1;
    }
    // 【失忆者】（用户第 4 条）：无论选到能力还是取消 DIY，都要打上「获得能力（失忆者）」
    if (BOTC_SeatTrueRole(q) == 73) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 177] = true;
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【获得能力】" + BOTC_NameStr(q) + " 获得「" + g_roleName[role] + "」能力（不改身份、不打哲学 / 炼金术士 token）。");
}

// 获得能力时若选到哲学家 / 炼金术士：继续选一层真正生效的能力（第 5 条）。
void BOTC_AttachGrantOrNest (int q, int role) {
    int cp;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (role == 56) {
        cp = g_teller;
        BOTC_PmStore(cp, "【获得能力】" + BOTC_NameStr(q) + " 获得的是哲学家能力：再选择一项善良能力。");
        g_pickMode[cp] = 35;
        g_pickAttachSeat[cp] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(cp, true);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家能力：再选择一项善良能力（" + BOTC_NameStr(q) + "）"), PlayerGroupSingle(cp));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
        return;
    }
    if (role == 95) {
        cp = g_teller;
        BOTC_PmStore(cp, "【获得能力】" + BOTC_NameStr(q) + " 获得的是炼金术士能力：再选择一项爪牙能力。");
        g_pickMode[cp] = 36;
        g_pickAttachSeat[cp] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(cp, false);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("炼金术士能力：再选择一项爪牙能力（" + BOTC_NameStr(q) + "）"), PlayerGroupSingle(cp));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
        return;
    }
    BOTC_AttachGrant(q, role, true);
}

// 放弃这次获得能力；失忆者即使取消（DIY）也要打「获得能力」token。
void BOTC_AttachCancel (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatTrueRole(q) == 73) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 177] = true;
        BOTC_PmStore(g_teller, "【失忆者】已按「DIY 能力」处理：" + BOTC_NameStr(q) + " 打上「获得能力（失忆者）」，能力由说书人自行裁定。");
        BOTC_GrimRender(g_teller);
    }
}

void BOTC_PickAbortAttach (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    q = g_pickAttachSeat[p];
    if (q <= 0) {
        return;
    }
    g_pickAttachSeat[p] = 0;
    BOTC_AttachCancel(q);
}

