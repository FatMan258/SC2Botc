                BOTC_SlayAnswer(1);
            }
            return true;
        }
        if (c == g_slayNo) {
            if (p == g_teller) {
                BOTC_SlayAnswer(0);
            }
            return true;
        }
        if (c == g_slayNo2) {
            if (p == g_teller) {
                BOTC_SlayAnswer(0);
            }
            return true;
        }
        // 【右上角 X】（用户 2026-11-01）：关掉判定弹窗 = 选【否】
        if (c == g_slayX) {
            if (p == g_teller) {
                BOTC_SlayAnswer(0);
            }
            return true;
        }
        // 【利维坦×陌客】（用户 2026-11-02）：是 = 按善良计入 / 否、X = 不计入
        if (c == g_levRecYes) {
            if (p == g_teller) {
                BOTC_LevRecluseAnswer(1);
            }
            return true;
        }
        if (c == g_levRecNo) {
            if (p == g_teller) {
                BOTC_LevRecluseAnswer(0);
            }
            return true;
        }
        if (c == g_levRecX) {
            if (p == g_teller) {
                BOTC_LevRecluseAnswer(0);
            }
            return true;
        }
        // 【理发师】恶魔与死者互换（用户 2026-11-10）：是 = 允许交换 / 否、X = 让他重新选
        if (c == g_barAskYes) {
            if (p == g_teller) {
                BOTC_BarberAskAnswer(1);
            }
            return true;
        }
        if (c == g_barAskNo) {
            if (p == g_teller) {
                BOTC_BarberAskAnswer(0);
            }
            return true;
        }
        if (c == g_barAskX) {
            if (p == g_teller) {
                BOTC_BarberAskAnswer(0);
            }
            return true;
        }
        // 【教父×陌客】（用户 2026-11-05）：是 = 算作外来者 / 否、X = 不算
        if (c == g_gfRecYes) {
