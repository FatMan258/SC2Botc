    g_tipRoleAt[26] = 5119;   g_tipRoleN[26] = 14;
    g_tipRoleAt[27] = 7058;   g_tipRoleN[27] = 12;
    g_tipRoleAt[107] = 7191;   g_tipRoleN[107] = 19;
    g_tipRoleAt[52] = 5301;   g_tipRoleN[52] = 8;
    g_tipRoleAt[28] = 7070;   g_tipRoleN[28] = 19;
    g_tipRoleAt[128] = 6104;   g_tipRoleN[128] = 19;
    g_tipRoleAt[55] = 7149;   g_tipRoleN[55] = 13;
    g_tipRoleAt[129] = 7309;   g_tipRoleN[129] = 17;
