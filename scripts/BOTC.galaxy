    BOTC_NewLabel(g_fnDlg, 310, 30, 370, 92, StringToText("目标2：被提名"));
    g_fnList1 = BOTC_NewList(g_fnDlg, 310, 180, 20, 124);
    g_fnList2 = BOTC_NewList(g_fnDlg, 310, 180, 370, 124);
    g_fnOk = BOTC_NewButton(g_fnDlg, 200, 44, 130, 322, "发起提名");
