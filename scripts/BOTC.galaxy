    g_jinxText[118] = "召唤师与普卡：召唤师可以在第二个夜晚召唤普卡，替代第三个夜晚的召唤。";
    g_jinxText2[118] = "";
    g_jinxText3[118] = "";
    g_jinxA[119] = 150;  g_jinxB[119] = 94;
    g_jinxText[119] = "召唤师与军团：召唤师召唤军团时，所有邪恶玩家会变成军团。";
    g_jinxText2[119] = "";
    g_jinxText3[119] = "";
    g_jinxA[120] = 150;  g_jinxB[120] = 111;
    g_jinxText[120] = "召唤师与堤丰之首：召唤堤丰之首时，他必须与爪牙邻座，另一侧玩家变成邪恶爪牙。";
