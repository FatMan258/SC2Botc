    g_jinxA[107] = 150;  g_jinxB[107] = 95;
    g_jinxText[107] = "炼金术士与召唤师：获得召唤师能力的炼金术士不会获得伪装；他选择恶魔角色，由说书人决定哪名玩家转化。";
    g_jinxText2[107] = "";
    g_jinxText3[107] = "";
    g_jinxA[108] = 150;  g_jinxB[108] = 47;
    g_jinxText[108] = "召唤师与钟表匠：召唤师会被钟表匠当作恶魔。";
    g_jinxText2[108] = "";
    g_jinxText3[108] = "";
    g_jinxA[109] = 150;  g_jinxB[109] = 86;
    g_jinxText[109] = "召唤师与罂粟种植者：罂粟种植者在第三夜存活时，召唤师选择恶魔角色，由说书人决定目标玩家。";
    g_jinxText2[109] = "";
    g_jinxText3[109] = "";
    g_jinxA[110] = 150;  g_jinxB[110] = 29;
    g_jinxText[110] = "召唤师与侍臣：存活的召唤师失去能力时，说书人获得召唤师能力。";
    g_jinxText2[110] = "";
    g_jinxText3[110] = "";
    g_jinxA[111] = 150;  g_jinxB[111] = 103;
