    }
    g_exoLast = 0;                 // 驱魔人（25）
    g_exoBlock = 0;
    g_exoNight = 0;
    g_exoFrom = 0;
    g_nanaSeat = 0;                // 祖母（22）
    g_nanaKid = 0;
    g_goonSeat = 0;                // 莽夫（37）
    g_goonBy = 0;
    g_gossipBy = 0;                // 造谣者（28）
    g_gossipText = "";
    for (i = 0; i <= 13; i += 1) {
        g_gossipTextBy[i] = "";
