    g_tipLine[537] = StringToText("每局游戏限一次，") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("可以选择一名已死亡的玩家。如果该玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他将被复活，");
    g_tipLine[538] = StringToText("再次变成存活状态。");
    g_tipLine[539] = StringToText("如果") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，则无事发生，并且") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("失去自己的能力。");
    g_tipLine[540] = StringToText("复活的玩家会重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的能力也");
    g_tipLine[541] = StringToText("会重新获得。");
    g_tipLine[542] = StringToText("复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能不能在自己复活的当晚进行行动，取决于复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("本该在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("之前还是");
    g_tipLine[543] = StringToText("之后行动。如果复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("有「在你的首个夜晚」的能力，则会在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("重新入睡后立即");
    g_tipLine[544] = StringToText("被唤醒来使用这类能力。");
    g_tipLine[545] = StringToText("【规则细节】");
    g_tipLine[546] = StringToText("如果在城镇广场上没有死亡玩家，则无需唤醒") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("（即使可能已经有人死亡，但还未被");
    g_tipLine[547] = StringToText("说书人告知）。");
    g_tipLine[548] = TextWithColor(StringToText("侍女"), Color(0, 191, 255));
    g_tipLine[549] = StringToText("也不会因此检测到") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("因为自身能力被唤醒。");
    g_tipLine[550] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[551] = StringToText("狸猫");
    g_tipLine[552] = StringToText("：如果狸猫与使用过能力的") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("交换角色，新") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("仍然失去能力。");
    g_tipRoleAt[30] = 5167;    // 教授
    g_tipRoleN[30] = 15;
    g_tipLine[553] = StringToText("【角色能力】");
    g_tipLine[554] = StringToText("当一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("死于处决时，除了你和旅行者以外的所有其他玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到明天黄昏。");
    g_tipLine[555] = StringToText("【角色简介】");
    g_tipLine[556] = StringToText("如果有") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("因为处决而死去，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("会让所有人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[557] = StringToText("如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决且死亡，所有玩家（除了") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("）会立即变得") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，并在整");
    g_tipLine[558] = StringToText("个夜晚和下一个白天都保持") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("状态。") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("、甚至是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("都会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，但");
    g_tipLine[559] = StringToText("是旅行者不会。如果") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("在夜晚死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("不会使人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[560] = StringToText("如果一名已死亡的") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发----已死亡的角色不会再");
    g_tipLine[561] = StringToText("次死亡！如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决但没有死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。如果一名爪");
    g_tipLine[562] = StringToText("牙玩家在") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("期间死于处决时，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。");
    g_tipLine[563] = StringToText("【规则细节】");
    g_tipLine[564] = StringToText("相克规则：");
    g_tipLine[565] = StringToText("军团");
    g_tipLine[566] = StringToText("：如果军团死于处决，所有军团保留能力，但") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("可能会在当晚得知今天白天死于");
    g_tipLine[567] = StringToText("处决的玩家是军团。");
    g_tipRoleAt[31] = 5182;    // 吟游诗人
    g_tipRoleN[31] = 14;
    g_tipLine[568] = StringToText("【角色能力】");
    g_tipLine[569] = StringToText("如果与你邻近的两名存活的玩家是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，他们不会死亡。");
    g_tipLine[570] = StringToText("【角色简介】");
    g_tipLine[571] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("保护着她邻近的玩家免于死亡......只要他们都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的。");
    g_tipLine[572] = StringToText("如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家当前都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，这两名玩家就都不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("不能");
    g_tipLine[573] = StringToText("杀死他们，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("也不行。如果他们被处决，也不会死亡。唯一的例外是") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("，");
    g_tipLine[574] = StringToText("他能杀死受到保护而免于死亡的人。");
    g_tipLine[575] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的邻近的存活玩家是最靠近") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("两名存活玩家----一名为顺时针方向最近的存");
    g_tipLine[576] = StringToText("活玩家，一名为逆时针方向上最近的存活玩家。已死亡的邻近玩家会被跳过。");
    g_tipLine[577] = StringToText("然而，如果邻近的存活玩家其中之一是") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("的，或者两个都是") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("的，那么") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("就无");
    g_tipLine[578] = StringToText("法保护她的邻近存活玩家。如果一名") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩家死亡，使得") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("现在的两个邻近玩家都");
