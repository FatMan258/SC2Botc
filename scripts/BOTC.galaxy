// 身份选择面板
// 选身份面板（用户 2026-09-19 重做）：改成图标网格 ----
//   85×85 中图（botc_nightNN）+ 下面一行角色名，按 镇民 / 外来者 / 爪牙 / 恶魔 分块，
//   每块正上方一行**彩色类别标题**（方便新玩家认）；对话框从 1170×330 放大到 1170×860。
//   给某个座位指定身份、伪装身份、不在场身份、声称身份都用这个面板。
// 【网格计划】按当前板子的角色清单（g_boardRole）算「第几格摆哪个身份」
//   每类一块，块内每行 7 个；块的纵向起点见 BOTC_GridBlockY
void BOTC_GridPlan () {
    int t;
    int i;
    int r;
    int n;
    int slot;
    int b;
    // 还没选出板子（g_board = 0）时按 1 号板子算，免得整个网格是空的（用户 2026-09-19）
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < 64; i += 1) {
        g_gridSlot[i] = -1;
        g_gridTeam[i] = 0;
        g_gridIdx[i] = 0;
    }
    for (t = 0; t < 4; t += 1) {
        g_gridTeamN[t] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        n = 0;
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            r = g_boardRole[(b * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (slot > 63) {
                break;
            }
            g_gridSlot[slot] = r;
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = n;
            slot = slot + 1;
            n = n + 1;
        }
        g_gridTeamN[t] = n;
    }
    g_gridN = slot;
}

int BOTC_GridCatCap (int t) {
    if (t == 0) {
        return 14;
    }
    return 7;
}

int BOTC_AbCatCap (int t) {
    if (t == 0) {
        return 14;
    }
    return 6;
}

int BOTC_GridCatPages (int t, int cap) {
    int pages;
    if (t < 0 || t > 3 || cap <= 0) {
        return 1;
    }
    pages = (g_gridCatN[t] + cap - 1) / cap;
    if (pages < 1) {
        pages = 1;
    }
    return pages;
}

void BOTC_GridCatalogClear () {
    int i;
    int t;
    for (i = 0; i < 512; i += 1) {
        g_gridCatRole[i] = -1;
    }
    for (t = 0; t < 4; t += 1) {
        g_gridCatN[t] = 0;
    }
}

// 【失忆者（73）首夜】列出全部善良角色 + 全部爪牙（含当前剧本不存在的）：
//   排除失忆占位 143..147、恶魔，以及本身没有任何能力的提线木偶（93）。
void BOTC_GridBuildAmne () {
    int r;
    int t;
    BOTC_GridCatalogClear();
    for (r = 0; r <= 163; r += 1) {
        if (r >= 143 && r <= 147) {
            continue;
        }
        if (r == 93) {
            continue;
        }
        t = BOTC_RoleTeam(r);
        if (t < 0 || t > 2) {
            continue;
        }
        // 镇民 / 外来者仍只取善良阵营；爪牙不套这条（他们天生邪恶）
        if (t <= 1 && BOTC_RoleAlign(r) != 0) {
            continue;
        }
        if (g_gridCatN[t] >= 128) {
            continue;
        }
        g_gridCatRole[(t * 128) + g_gridCatN[t]] = r;
        g_gridCatN[t] = g_gridCatN[t] + 1;
    }
}

// 【小精灵 / 单角色确认】只摆一个角色。
void BOTC_GridBuildOnlyRole (int role) {
    int t;
    BOTC_GridCatalogClear();
    if (role < 0 || role > 163) {
        return;
    }
    t = BOTC_RoleTeam(role);
    if (t < 0 || t > 3) {
        return;
    }
    g_gridCatRole[(t * 128) + 0] = role;
    g_gridCatN[t] = 1;
}

void BOTC_GridBuildCat () {
    int b;
    int i;
    int r;
    int t;
    BOTC_GridCatalogClear();
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        t = BOTC_RoleTeam(r);
        if (t < 0 || t > 3) {
            continue;
        }
        if (g_gridCatN[t] >= 128) {
            continue;
        }
        g_gridCatRole[(t * 128) + g_gridCatN[t]] = r;
        g_gridCatN[t] = g_gridCatN[t] + 1;
    }
}

// 每一类的纵向起点（跟以前手调的那几个数一样：76 / 366 / 526 / 686）
int BOTC_GridBlockY (int t) {
    if (t == 1) {
        return 366;
    }
    if (t == 2) {
        return 526;
    }
    if (t == 3) {
        return 686;
    }
    return 76;
}

// 【单个角色当前这一面是否显示】（用户 2026-11-03）：分类按钮 + 单类分页后，
//   排版和过滤必须用同一套判定，否则会出现「这一页全是过滤掉的空位」。
bool BOTC_PickRoleShowNow (int p, int r) {
    bool show;
    if (p < 1 || p > 13 || r < 0 || r > 163) {
        return false;
    }
    show = true;
    if (g_pickFilterGood[p] && BOTC_RoleAlign(r) == 1) {
        show = false;
    }
    if (g_pickFilterTeam[p] >= 0 && BOTC_RoleTeam(r) != g_pickFilterTeam[p]) {
        show = false;
    }
    if (g_pickFilterAlign[p] >= 0 && BOTC_RoleAlign(r) != g_pickFilterAlign[p]) {
        show = false;
    }
    if (!BOTC_PickModeRoleAllowed(p, r)) {
        show = false;
    }
    if (r == 99 && BOTC_PickModeShowsGoblin(p)) {
        show = true;
    }
    return show;
}

// 某一类里、对指定玩家可见的角色数量
int BOTC_PickCatShowN (int p, int t) {
    int i;
    int r;
    int n;
    n = 0;
    for (i = 0; i < g_gridCatN[t]; i += 1) {
        r = g_gridCatRole[(t * 128) + i];
        if (BOTC_PickRoleShowNow(p, r)) {
            n = n + 1;
        }
    }
    return n;
}

// 【哪种身份面板用分类样式】（用户 2026-11-04）：
//   全员追忆（板子 13）覆盖全部角色，所有选身份的技能都必须分类；
//   其他板子里只有「覆盖全游戏所有角色」的选择（首夜失忆者 mode 46）才用分类；
//   其余（哲学家、食人族、变脸师等）回到原来「所有剧本内角色同页」的四栏设计。
bool BOTC_PickUseCategory (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_board == 13) {
        return true;
    }
    if (g_pickMode[p] == 46) {
        return true;
    }
    return false;
}

// 某一类按当前过滤条件计算出的页数（旧的单类翻页按钮要用）
int BOTC_PickCatPagesNow (int p, int t, int cap) {
    int n;
    if (p < 1 || p > 13 || t < 0 || t > 3 || cap <= 0) {
        return 1;
    }
    n = BOTC_PickCatShowN(p, t);
    if (n <= 0) {
        return 1;
    }
    return ((n + cap - 1) / cap);
}

// 旧的四栏同页布局：镇民 / 外来者 / 爪牙 / 恶魔同时显示，各自独立翻页。
void BOTC_PickLayoutStacked (int p) {
    int j;
    int t;
    int i;
    int page;
    int pages;
    int shown;
    int seen;
    int skip;
    int slot;
    int n;
    int cap;
    int r;
    int x;
    int y;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_pickMode[p] == 46) {
        BOTC_GridBuildAmne();
    }
    else if (g_pickMode[p] == 49) {
        BOTC_GridBuildOnlyRole(g_pickOnlyRole);
    }
    else {
        BOTC_GridBuildCat();
    }
    if (g_pickMode[p] == 41 && BOTC_ActRoleOf(g_pickWho[p]) == 150) {
        BOTC_SummonerGridCatalog(p);
    }
    for (j = 0; j < 64; j += 1) {
        g_gridSlot[j] = -1;
        g_gridTeam[j] = 0;
        g_gridIdx[j] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        cap = BOTC_GridCatCap(t);
        n = BOTC_PickCatShowN(p, t);
        g_gridTeamN[t] = n;
        pages = BOTC_PickCatPagesNow(p, t, cap);
        page = g_pickCatPageBy[(p * 4) + t];
        if (page < 1) {
            page = 1;
        }
        if (page > pages) {
            page = pages;
        }
        g_pickCatPageBy[(p * 4) + t] = page;
        skip = (page - 1) * cap;
        shown = 0;
        seen = 0;
        y = BOTC_GridBlockY(t);
        for (i = 0; i < g_gridCatN[t] && shown < cap && slot < 64; i += 1) {
            r = g_gridCatRole[(t * 128) + i];
            if (!BOTC_PickRoleShowNow(p, r)) {
                continue;
            }
            if (seen < skip) {
                seen = seen + 1;
                continue;
            }
            seen = seen + 1;
            g_gridSlot[slot] = r;
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = shown;
            x = 60 + ((shown % 7) * 120);
            y = BOTC_GridBlockY(t) + ((shown / 7) * 130);
            DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
            libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(r), PlayerGroupSingle(p));
            libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
            DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
            DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
            DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
            slot = slot + 1;
            shown = shown + 1;
        }
        // 块标题：有内容才显示
        DialogControlSetVisible(g_pickSec[t], PlayerGroupSingle(p), (n > 0));
        // 旧的单类小翻页：页数 > 1 才显示
        DialogControlSetVisible(g_pickCatPrev[t], PlayerGroupSingle(p), (pages > 1));
        DialogControlSetVisible(g_pickCatNext[t], PlayerGroupSingle(p), (pages > 1));
    }
    g_gridN = slot;
    for (j = slot; j < 64; j += 1) {
        DialogControlSetVisible(g_pickBtn[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[j], PlayerGroupSingle(p), false);
    }
    for (j = 0; j < 64; j += 1) {
        g_pickSlotRole[(p * 64) + j] = g_gridSlot[j];
    }
}

// 选身份面板的布局：只渲染指定玩家的那一份，页码和格子映射也按玩家独立保存。
// 【2026-11-03 改版】不再同页铺四类：左上角 4 个分类按钮切换，只显示当前类别；
//   单类角色超过 35 个时用左下角上一页 / 下一页，取消和清除身份固定在右下角。
// 【2026-11-04】分类样式只用于全员追忆和全角色选择，其它回到四栏同页。
void BOTC_PickLayoutFor (int p) {
    int j;
    int t;
    int i;
    int page;
    int pages;
    int shown;
    int seen;
    int skip;
    int slot;
    int sel;
    int n;
    int cap;
    int r;
    int x;
    int y;
    if (p < 1 || p > 13) {
        return;
    }
    // 【非全员追忆 / 非全角色选择】用旧的四栏同页设计（用户 2026-11-04）
    if (!BOTC_PickUseCategory(p)) {
        BOTC_PickLayoutStacked(p);
        return;
    }
    if (g_pickMode[p] == 46) {
        BOTC_GridBuildAmne();           // 失忆者首夜：全部善良角色 + 全部爪牙（含当前剧本不存在的）
    }
    else if (g_pickMode[p] == 49) {
        BOTC_GridBuildOnlyRole(g_pickOnlyRole); // 小精灵：只确认被得知的那一个镇民
    }
    else {
        BOTC_GridBuildCat();
    }
    if (g_pickMode[p] == 41 && BOTC_ActRoleOf(g_pickWho[p]) == 150) {
        BOTC_SummonerGridCatalog(p);
    }
    for (j = 0; j < 64; j += 1) {
        g_gridSlot[j] = -1;
        g_gridTeam[j] = 0;
        g_gridIdx[j] = 0;
    }
    // 每一类当前可见数量（供分类按钮与分页判断）
    for (t = 0; t < 4; t += 1) {
        g_gridTeamN[t] = BOTC_PickCatShowN(p, t);
    }
    // 当前选中的类别：没选 / 该类别被过滤空 → 自动跳到第一个有内容的类别
    sel = g_pickCatSel[p];
    if (sel < 0 || sel > 3 || g_gridTeamN[sel] <= 0) {
        sel = 0;
        for (t = 0; t < 4; t += 1) {
            if (g_gridTeamN[t] > 0) {
                sel = t;
                break;
            }
        }
    }
    g_pickCatSel[p] = sel;
    cap = 35;                          // 7 列 × 5 行
    n = g_gridTeamN[sel];
    pages = ((n + cap - 1) / cap);
    if (pages < 1) {
        pages = 1;
    }
    page = g_pickCatPageBy[(p * 4) + sel];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_pickCatPageBy[(p * 4) + sel] = page;
    skip = (page - 1) * cap;
    shown = 0;
    seen = 0;
    slot = 0;
    for (i = 0; i < g_gridCatN[sel] && shown < cap; i += 1) {
        r = g_gridCatRole[(sel * 128) + i];
        if (!BOTC_PickRoleShowNow(p, r)) {
            continue;
        }
        if (seen < skip) {
            seen = seen + 1;
            continue;
        }
        seen = seen + 1;
        g_gridSlot[slot] = r;
        g_gridTeam[slot] = sel;
        g_gridIdx[slot] = shown;
        x = 60 + ((shown % 7) * 120);
        y = 90 + ((shown / 7) * 130);
        DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
        DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
        DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
        libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(r), PlayerGroupSingle(p));
        libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
        DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
        slot = slot + 1;
        shown = shown + 1;
    }
    g_gridN = slot;
    for (j = slot; j < 64; j += 1) {
        DialogControlSetVisible(g_pickBtn[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[j], PlayerGroupSingle(p), false);
    }
    for (j = 0; j < 64; j += 1) {
        g_pickSlotRole[(p * 64) + j] = g_gridSlot[j];
    }
    // 旧的四栏标题 / 四类小翻页全部退役，只保留新的分类按钮与单类分页。
    for (j = 0; j < 4; j += 1) {
        DialogControlSetVisible(g_pickSec[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatPrev[j], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[j], PlayerGroupSingle(p), false);
    }
}

// 刷新全部玩家各自的一份；首次建面板 / 换板时使用。
void BOTC_PickLayout () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        BOTC_PickLayoutFor(p);
    }
}

void BOTC_BuildPick () {
    int j;
