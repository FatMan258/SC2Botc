    g_tipLine[618] = StringToText("如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在夜晚是清醒且健康的，但在今天白天选择玩家时是") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的，所选的");
    g_tipLine[619] = StringToText("玩家会死亡。如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在夜晚是") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的，但在今天白天选择玩家时是清醒且健");
    g_tipLine[620] = StringToText("康的，所选的玩家不会死亡。");
    g_tipLine[621] = StringToText("如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("时，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，则无论") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的阵营在夜晚如何变化，") + TextWithColor(StringToText("月之子"), Color(0, 191, 255));
    g_tipLine[622] = StringToText("都会杀死") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipRoleAt[36] = 3892;    // 月之子
    g_tipRoleN[36] = 15;
    g_tipLine[623] = StringToText("【角色能力】");
    g_tipLine[624] = StringToText("每个夜晚，首个使用其自身能力选择了你的玩家会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到下个黄昏。你会转变为他的");
    g_tipLine[625] = StringToText("阵营。");
    g_tipLine[626] = StringToText("【角色简介】");
    g_tipLine[627] = TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("在夜晚对其他角色的能力免疫，但是会不断改变阵营。");
    g_tipLine[628] = StringToText("每个夜晚，被唤醒的玩家之中，首个使用自己的能力选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的玩家将会立即") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[629] = StringToText("该玩家的能力在当晚和下一个白天不会生效。");
    g_tipLine[630] = StringToText("之后在同一个夜晚，如果另一位玩家被唤醒且使用自己的能力选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，该能力会正");
    g_tipLine[631] = StringToText("常生效。");
    g_tipLine[632] = StringToText("除非玩家自己选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，否则") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("不能让玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。通过") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("之类的角色能力，而由");
    g_tipLine[633] = StringToText("说书人选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("不算在内。");
    g_tipLine[634] = StringToText("一旦") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("让一名玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的阵营改变为与该玩家一致。如果选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的玩家已经");
    g_tipLine[635] = TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("仍然会改变阵营并让该玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[636] = StringToText("如果被") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("选择，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("会死亡，但仍然会转变为") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营。");
    g_tipLine[637] = StringToText("【规则细节】");
    g_tipLine[638] = StringToText("相克规则：");
    g_tipLine[639] = StringToText("麻脸巫婆");
    g_tipLine[640] = StringToText("：被麻脸巫婆创造的") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("无法因为自身能力转变为") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营。");
    g_tipLine[641] = StringToText("科学怪人");
    g_tipLine[642] = StringToText("：如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("拥有") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的能力，他无法因为该能力转变为") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营。");
    g_tipRoleAt[37] = 3907;    // 莽夫
    g_tipRoleN[37] = 16;
    g_tipLine[643] = StringToText("【角色能力】");
    g_tipLine[644] = StringToText("你以为你是一个") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，但其实你不是。");
    g_tipLine[645] = TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("知道你是") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("以及你在每个夜晚选择了哪些玩家。");
    g_tipLine[646] = StringToText("【角色简介】");
    g_tipLine[647] = TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("以为自己是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("。");
    g_tipLine[648] = StringToText("和") + TextWithColor(StringToText("酒鬼"), Color(0,191,255)) + StringToText("很相似，") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("不知道自己的真实角色和真实阵营。") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("每个夜晚都会被唤醒来发");
    g_tipLine[649] = StringToText("动攻击，就如同他是场上真正的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，但是") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的选择没有效果，因为他没有") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("的能");
    g_tipLine[650] = StringToText("力。");
    g_tipLine[651] = TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("会在首个夜晚被唤醒来得知三个不在场的角色，以及与当前游戏数量符合的") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("，");
    g_tipLine[652] = StringToText("但是这些信息可能是错误的。");
    g_tipLine[653] = StringToText("真正的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("会知道") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("每个夜晚攻击了哪些玩家。");
    g_tipLine[654] = StringToText("【规则细节】");
    g_tipLine[655] = StringToText("相克规则：");
    g_tipLine[656] = StringToText("数学家");
