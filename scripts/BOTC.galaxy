//--------------------------------------------------------------------------------------------------
// 昼夜系统（仅说书人可切换）：夜晚上一层深蓝遮罩，只压暗地图，不影响面板可读性
//--------------------------------------------------------------------------------------------------
bool        g_isNight;
// 【调试总开关】诊断日志（【诊断·...】）与测试播报（【测试】...）、真魔典同步都看它。
//   关掉 = 玩正式局时的干净界面；想再调试就在聊天里发 debug（或在 BOTC_GrimInitData 里改默认值）。
bool        g_debugOn;
// 【测试·私聊镜像】开启后，BOTC_PmInfo 发给玩家的角色结果会同步写一行到说书人私聊窗。
bool        g_pmInfoMirrorOn;
// 【提名环节】20 秒「自由提名时间」：有人提名（阶段 2..6）时暂停，提名结束回到阶段 1 继续倒数；
//   倒数到 0 就收掉提名环节（智能说书模式下，有人过票就先按票数处决）
int         g_nomFreeSec;
bool        g_nomFreeOn;
timer       g_tNomFree;
trigger     g_tNomFreeTrig;
// 胜利面板上面那条「恭喜...获胜」（单独一个对话框）+ 复盘按钮
int         g_congratsDlg;
int         g_congratsLbl;
int         g_replayBtn;
bool        g_replayOn;        // 复盘已打开：全场魔典都被替换成说书人那份
// 【测试】说书人「自己拿一个身份试技能」（用户 2026-09-20）：指令 -t 弹身份网格 / -t off 关掉
//   身份存在 g_mark[(g_teller * 14) + 1]（观察者 1 的「座位 1」= 说书人自己那一格），不参与配板 / 胜负 / 座位表
bool        g_testSelfOn;
// 【猎手射中恶魔】的特殊音效过场：停音轨 → 2 秒后充能音 → 再 2.5 秒后枪声 → 那一刻才结算死亡 + 恢复音轨
string      g_sfxChargeName;   // Raynor_PenetratorRoundChargeUp
string      g_sfxSnipeName;    // RaynorSnipeSound
int         g_snipeStage;      // 0 = 没在过场 / 1 = 等充能 / 2 = 等枪声
int         g_snipeTarget;     // 被打中的恶魔座位
int         g_snipeHunter;     // 开枪的猎手座位（「命中了恶魔」那句要等他真的死才播）
timer       g_tSnipe;
trigger     g_tSnipeTrig;
timer       g_tHdAuto;        // 哈迪寂亚：电脑座位 2 秒后自动替他选生 / 死
trigger     g_tHdAutoTrig;
int         g_nightBtnDlg;
int         g_nightBtn;
// 时段编号：0 = 还没正式开始。进入白天 g_dayNum = g_nightNum；进入夜晚 g_nightNum = g_dayNum + 1
int         g_dayNum;
int         g_nightNum;
bool        g_started;

//--------------------------------------------------------------------------------------------------
// 提名 / 投票系统
//   g_phase: 0=自由活动  1=提名待发（说书人已开启提名环节）  2=等待提名者点座位
//            3=提名者陈述  4=被提名者反驳  5=投票倒计时  6=说书人判定
//--------------------------------------------------------------------------------------------------
int         g_phase;
int         g_nomFrom;
int         g_nomTo;
