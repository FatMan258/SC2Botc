// 把一段文字按每行 n 个字切开，铺进列表（星际的列表不自动换行）

// 往列表里铺一段已经切好的文案：从 g_tipLine[at] 开始，共 n 行
//   （中文不要用 StringSub 现场切，它按字节算位置，会把字切坏）
void BOTC_TipLines (int p, int at, int n) {
    int i;
    for (i = 0; i < n; i += 1) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), BOTC_KeyColor(g_tipLine[at + i]));
    }
}

// 说书人提示：只有玩家1 才铺这一份
void BOTC_TipStLines (int p) {
    int i;
    for (i = 0; i < g_tipStN; i += 1) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), BOTC_KeyColor(g_tipStLine[i]));
    }
}

void BOTC_TipRender (int p) {
    int r;
    int team;
    int pos;
    DialogControlRemoveAllItems(g_tipList, PlayerGroupSingle(p));
    // 【场次统计页】（用户 2026-10-20）：直接读当前说书人的 bank，按玩家号列 1～13。
    if (g_tipMode[p] == 3) {
        BOTC_StatsRender(p);
        return;
    }
    if (g_tipMode[p] == 2) {
        // 【游戏帮助】（用户 2026-11-04）：规则页左上角直接写「游戏帮助」
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("游戏帮助"), PlayerGroupSingle(p));
    }
    if (g_tipForce[p] >= 0) {
        r = g_tipForce[p];                  // 调试指令 /tip / 能力表详情强制指定的身份（每人一份）
    }
    else {
        pos = BOTC_PosOf(p);
        if (!g_dealConfirmed && !g_started) {
            // 【确认发放前不显示身份】（用户 2026-11-06）：说书人配板 / 手动改身份阶段，
            //   玩家不能通过【我的角色】提前看到自己的角色，必须等说书人点【确认发放】。
            //   游戏正式开始后不再拦截，避免中途改身份（会清 g_dealConfirmed）时误伤。
            r = -1;
        }
        else if (g_board == 13 && p != g_teller) {
            // 【全员追忆 · 我的角色看自己魔典】（用户 2026-11-05）：板子 13 的真身只在真值行，
            //   【我的角色】改读玩家自己那份魔典上给本人标记的身份，不再泄露真实角色。
            r = g_mark[(p * 14) + pos] - 1;
        }
        else {
            // 【我的角色始终显示真实身份】（用户 2026-11-04）：不读玩家自己那份可被说书人改写的镜像行，
            //   改读真值行；酒鬼 / 疯子 / 悟道者 / 提线木偶这类认知偏差角色仍显示他们以为的身份。
            r = BOTC_SeatTrueRole(pos);
            if (r == 14 || r == 38 || r == 118 || r == 93) {
                r = g_mark[(g_teller * 14) + pos] - 1;
            }
        }
    }
    // 帮助面板的两种子页面：2 = 只看游戏规则（跳过角色那段）
    if (g_tipMode[p] != 2) {
    if (p == g_teller && g_tipForce[p] < 0) {
        // 【说书人提示】只有玩家1 看得到：他没有自己的角色，这里给的是主持手册
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("说书人提示"), PlayerGroupSingle(p));
        libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
        BOTC_TipStLines(p);
    }
    else {
    // 【左上角标题】（用户 2026-11-04）：从剧本角色表点进来的写「角色介绍」，从【我的角色】进来的写「我的角色是」
    if (g_tipForce[p] >= 0) {
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("角色介绍"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("我的角色是"), PlayerGroupSingle(p));
    }
    if (r >= 0 && r <= 163 && g_roleName[r] != "") {
        libNtve_gf_SetDialogItemImage(g_tipIcon, BOTC_NightIconName(r), PlayerGroupSingle(p));
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_tipName, TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
        // 胜利条件先铺（在【角色能力】之前）：爪牙 / 恶魔看邪恶版，其余看善良版
        if (BOTC_RoleTeam(r) == 2 || BOTC_RoleTeam(r) == 3) {
            BOTC_TipLines(p, g_tipWinEvilAt, g_tipWinEvilN);
        }
        else {
            BOTC_TipLines(p, g_tipWinGoodAt, g_tipWinGoodN);
        }
        if (r == 130) { BOTC_BootleggerSyncText(); }
        BOTC_TipLines(p, g_tipRoleAt[r], g_tipRoleN[r]);
    }
    else {
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
        if (g_tipForce[p] < 0 && !g_dealConfirmed) {
            // 【未确认发放的提示】（用户 2026-11-06）：不发角色，但明确告诉玩家还没发牌
            libNtve_gf_SetDialogItemText(g_tipName, StringToText("（说书人尚未发放身份）"), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
        }
    }
    if ((p >= 2 || g_tipForce[p] >= 0) && r >= 0) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("--------------------------------------------------"));
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("我该做什么？"));
        if (g_board == 13) {
            team = BOTC_RoleTeam(r);       // 全员追忆按玩家眼前这张占位卡显示对应阵营说明
        }
        else {
            team = BOTC_SeatTeam(BOTC_PosOf(p));
        }
        if (g_tipForce[p] >= 0) {
            team = BOTC_RoleTeam(g_tipForce[p]);   // 按被强制那个角色的阵营显示
        }
        if (team == 3) {
            BOTC_TipLines(p, g_tipDemonAt, g_tipDemonN);
        }
        else if (team == 2) {
            BOTC_TipLines(p, g_tipMinionAt, g_tipMinionN);
        }
        else {
            BOTC_TipLines(p, g_tipGoodAt, g_tipGoodN);
        }
    }
    }
    }
    // 1 = 只看角色细节（跳过最后的规则概述）
    if (g_tipMode[p] != 1) {
    DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("--------------------------------------------------"));
    DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("规则概述"));
    BOTC_TipLines(p, g_tipCommonAt, g_tipCommonN);
    }
}

void BOTC_TipOpen (int p) {
    // 笔记与所有页面共存，打开帮助时不再收笔记（用户 2026-11-04）
    BOTC_TipRender(p);
    g_tipOpen[p] = true;
    DialogSetVisible(g_tipDlg, PlayerGroupSingle(p), true);
}

void BOTC_TipClose (int p) {
    g_tipOpen[p] = false;
    g_tipForce[p] = -1;            // 关掉提示面板就回到「显示自己的角色」
    DialogSetVisible(g_tipDlg, PlayerGroupSingle(p), false);
}

//==================================================================================================
// 【笔记】（用户 2026-09-20）：屏幕中央一块记事板，每个玩家一份 ----
//   8 行单行输入框（星际的输入框不支持多行），关闭 / 切到别的面板时自动保存，下次打开还在。
//==================================================================================================
void BOTC_BuildNotes (int p) {
    int i;
    int y;
    DialogCreate(760, 600, c_anchorCenter, 0, 0, false);   // 首次打开在屏幕正中心（用户 2026-11-04）
    g_noteDlg[p] = DialogLastCreated();
    DialogSetVisible(g_noteDlg[p], PlayerGroupAll(), false);
    DialogSetImageVisible(g_noteDlg[p], true);
    g_noteTitle[p] = BOTC_NewLabel(g_noteDlg[p], 720, 30, 20, 10, StringToText("笔记"));
    libNtve_gf_SetDialogItemStyle(g_noteTitle[p], "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_noteTitle[p], false, PlayerGroupAll());
    for (i = 0; i < 8; i += 1) {
        y = 50 + (i * 56);
        g_noteEdit[(p * 8) + i] = BOTC_NewEdit(g_noteDlg[p], 720, 46, 20, y);
    }
    g_noteClose[p] = BOTC_NewButton(g_noteDlg[p], 220, 40, 270, 540, "关闭（保存）");
    DialogSetVisible(g_noteDlg[p], PlayerGroupSingle(p), false);
}

// 打开：先把存过的内容填回输入框
void BOTC_NoteOpen (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    for (i = 0; i < 8; i += 1) {
        libNtve_gf_SetDialogItemText(g_noteEdit[(p * 8) + i], StringToText(g_noteText[(p * 8) + i]), PlayerGroupSingle(p));
    }
    // 回到上次关掉的位置（0,0 就是屏幕正中心；退出地图后全局变量重置）
    DialogSetPosition(g_noteDlg[p], c_anchorCenter, g_noteOffX[p], g_noteOffY[p]);
    g_noteOn[p] = true;
    DialogSetVisible(g_noteDlg[p], PlayerGroupSingle(p), true);
}

// 保存：把 8 个格子里的字读回来（空字符串也照存，等于清空）
void BOTC_NoteSave (int p) {
    int i;
    if (p < 1 || p > 13) {
        return;
    }
    for (i = 0; i < 8; i += 1) {
        g_noteText[(p * 8) + i] = libNtve_gf_DialogItemEditValue(g_noteEdit[(p * 8) + i], p);
    }
}

// 关闭：先保存再收起
void BOTC_NoteClose (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_NoteSave(p);
    g_noteOn[p] = false;
    DialogSetVisible(g_noteDlg[p], PlayerGroupSingle(p), false);
}

void BOTC_BuildNightOrder () {
    int i;
    int p;
    int base;
    for (p = 1; p <= 13; p += 1) {
        base = p * 24;
        DialogCreate(1180, 1080, c_anchorCenter, 0, 0, false);
        g_noDlg[p] = DialogLastCreated();
        DialogSetVisible(g_noDlg[p], PlayerGroupAll(), false);
        g_noViewBtn[p] = BOTC_NewButton(g_noDlg[p], 170, 28, 20, 4, "剧本角色");
        g_noTitleL[p] = BOTC_NewLabel(g_noDlg[p], 280, 36, 240, 8, StringToText("首夜"));
        libNtve_gf_SetDialogItemStyle(g_noTitleL[p], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_noTitleL[p], false, PlayerGroupAll());
        g_noTitleR[p] = BOTC_NewLabel(g_noDlg[p], 460, 36, 530, 8, StringToText("从第二个夜晚开始"));
        libNtve_gf_SetDialogItemStyle(g_noTitleR[p], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_noTitleR[p], false, PlayerGroupAll());
        g_noNote[p] = BOTC_NewLabel(g_noDlg[p], 460, 22, 530, 34, StringToText("（部分行动为能力在夜间造成死亡的顺序，不代表需要唤醒）"));
        libNtve_gf_SetDialogItemStyle(g_noNote[p], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_noNote[p], false, PlayerGroupAll());
        for (i = 0; i < 24; i += 1) {
            libNtve_gf_CreateDialogItemImage(g_noDlg[p], 85, 85, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
            g_noIcon[base + i] = DialogControlLastCreated();
            DialogControlSetSize(g_noIcon[base + i], PlayerGroupAll(), 85, 85);
            libNtve_gf_SetDialogItemAcceptMouse(g_noIcon[base + i], false, PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_noIcon[base + i], "botc_blank.dds", PlayerGroupAll());
            DialogControlSetVisible(g_noIcon[base + i], PlayerGroupAll(), false);
            g_noName[base + i] = BOTC_NewLabel(g_noDlg[p], 340, 30, 40, 60, StringToText(""));
            libNtve_gf_SetDialogItemStyle(g_noName[base + i], "ModLeftSize20Bold", PlayerGroupAll());
            libNtve_gf_SetDialogItemAcceptMouse(g_noName[base + i], false, PlayerGroupAll());
            DialogControlSetVisible(g_noName[base + i], PlayerGroupAll(), false);
        }
        g_noClose[p] = BOTC_NewButton(g_noDlg[p], 160, 40, 360, 1000, "关闭");
        g_noUp[p] = BOTC_NewButton(g_noDlg[p], 150, 40, 20, 1000, "▲ 上一页");
        g_noDown[p] = BOTC_NewButton(g_noDlg[p], 150, 40, 190, 1000, "▼ 下一页");
        g_noPageLbl[p] = BOTC_NewLabel(g_noDlg[p], 340, 30, 530, 1006, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_noPageLbl[p], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_noPageLbl[p], false, PlayerGroupAll());
        DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), false);
    }
}

// 画一行：col 0 = 首夜 / 1 = 第二夜起，row 0..11，r = 身份索引
void BOTC_NightOrderRow (int p, int col, int row, int r) {
    int idx;
    int x;
    int y;
    idx = (p * 24) + (col * 12) + row;
    x = 40 + (col * 490);
    y = 60 + (row * 84);
    libNtve_gf_SetDialogItemImage(g_noIcon[idx], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_noIcon[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetVisible(g_noIcon[idx], PlayerGroupSingle(p), true);
    libNtve_gf_SetDialogItemText(g_noName[idx], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[idx], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 97, y + 30);
    DialogControlSetVisible(g_noName[idx], PlayerGroupSingle(p), true);
}

// 铺内容：左栏「首夜」（第 0 行固定写爪牙与恶魔互相得知）、右栏「第二夜起」
void BOTC_NightOrderRender (int p) {
    int i;
    int r;
    int o;
    int row;
    int b;
    int base;
    bool[164] showRole;
    base = p * 24;
    for (i = 0; i < 24; i += 1) {
        DialogControlSetVisible(g_noIcon[base + i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_noName[base + i], PlayerGroupSingle(p), false);
    }
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (r = 0; r <= 163; r += 1) {
        showRole[r] = false;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r >= 0 && r <= 163) {
            showRole[r] = true;
        }
    }
    // 实际发到玩家身上的角色也显示，避免手工改身份 / 自定义板漏角色。
    for (i = 2; i <= 13; i += 1) {
        r = g_mark[(g_teller * 14) + i] - 1;
        if (r >= 0 && r <= 163) {
            showRole[r] = true;
        }
    }
    for (r = 0; r <= 163; r += 1) {
        if (g_legacyOn[r]) {
            showRole[r] = true;
        }
    }
    g_noMaxRows[p] = 0;
    // 左栏第 0 行：固定（跟着翻页平移，翻下去就藏起来）
    libNtve_gf_SetDialogItemText(g_noName[base], StringToText("爪牙与恶魔互相得知"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[base], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[base], PlayerGroupSingle(p), c_anchorTopLeft, 44, 90 - (g_noShift[p] * 84));
    DialogControlSetVisible(g_noName[base], PlayerGroupSingle(p), (g_noShift[p] == 0));
    // 左栏：按首夜顺序
    row = 1;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 163; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllFirst[r] != o) {
                continue;
            }
            if ((row - g_noShift[p]) >= 0 && (row - g_noShift[p]) < 11) {
                BOTC_NightOrderRow(p, 0, row - g_noShift[p], r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows[p]) {
        g_noMaxRows[p] = row;
    }
    // 右栏：第二夜起
    row = 0;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 163; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllOther[r] != o) {
                continue;
            }
            if ((row - g_noShift[p]) >= 0 && (row - g_noShift[p]) < 11) {
                BOTC_NightOrderRow(p, 1, row - g_noShift[p], r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows[p]) {
        g_noMaxRows[p] = row;
    }
    libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("显示第 " + IntToString(g_noShift[p] + 1) + " - " + IntToString(g_noShift[p] + 11) + " 行（最长一栏 " + IntToString(g_noMaxRows[p]) + " 行）"), PlayerGroupSingle(p));
    if (g_noShift[p] + 11 >= g_noMaxRows[p]) {
        libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("显示第 " + IntToString(g_noShift[p] + 1) + " - " + IntToString(g_noMaxRows[p]) + " 行（共 " + IntToString(g_noMaxRows[p]) + " 行）"), PlayerGroupSingle(p));
    }
    if (g_noMaxRows[p] <= 11) {
        libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("共 " + IntToString(g_noMaxRows[p]) + " 行"), PlayerGroupSingle(p));
    }
}

// 翻页：delta = +6 / -6；越界自动夹住（最长一栏 - 12 = 最后一页）
void BOTC_NightOrderScroll (int p, int delta) {
    int maxShift;
    maxShift = g_noMaxRows[p] - 11;
    if (maxShift < 0) {
        maxShift = 0;
    }
    g_noShift[p] = g_noShift[p] + delta;
    if (g_noShift[p] < 0) {
        g_noShift[p] = 0;
    }
    if (g_noShift[p] > maxShift) {
        g_noShift[p] = maxShift;
    }
    BOTC_NightOrderRender(p);
}

void BOTC_NightOrderOpen (int p) {
    int ox;
    int oy;
    g_noShift[p] = 0;              // 每次打开都从最上面开始
    BOTC_NightOrderRender(p);
    g_noOpen[p] = true;
    g_abOpen[p] = false;
    DialogSetVisible(g_abNewDlg[p], PlayerGroupSingle(p), false);
    // 与剧本角色表共用一个窗口：尺寸、位置完全一致，拖动其中一个两个视图一起走
    ox = g_abOffX[p];
    oy = g_abOffY[p];
    if (ox < -370) { ox = -370; }
    if (ox > 370) { ox = 370; }
    if (oy < -30) { oy = -30; }
    if (oy > 30) { oy = 30; }
    DialogSetPosition(g_noDlg[p], c_anchorCenter, ox, oy);
    DialogSetPosition(g_abNewDlg[p], c_anchorCenter, ox, oy);
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), true);
}

void BOTC_NightOrderClose (int p) {
    g_noOpen[p] = false;
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), false);
}

// 【剧本角色表 ↔ 夜间行动顺序】（用户 2026-11-04）：同一个弹窗，左上角按钮切换两个视图
void BOTC_AbViewNight (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_NightOrderOpen(p);
}

void BOTC_AbViewRole (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_AbilityOpen(p);
}

// 右上角四个面板互斥：1 日志 / 2 魔典 / 3 角色能力表 / 4 夜间顺序
//   （用户 2026-09-19：不能同时开两个）
void BOTC_PanelOpen (int p, int which) {
    // 正在「发起私聊」选人时又从右上角开了别的面板 → 先退出选人模式（不然魔典按钮一直锁着）
    if (g_pmPick[p] && which != 2) {
        BOTC_PmPickEnd(p);
    }
    // 【剧本角色表可与日志 / 魔典共存】（用户 2026-11-04）：日志与魔典仍然互斥，
    //   剧本角色表（含夜序视图）不再被日志 / 魔典 / 帮助 / 笔记收起。
    //   【帮助 / 剧本角色表共存】：点剧本角色表不收起帮助，点帮助也不收起剧本角色表。
    //   【笔记】与所有页面共存：打开别的页面不收笔记，打开笔记也不收别的页面。
    if (which == 2) {
        BOTC_LogClose(p);           // 魔典与日志互斥
    }
    if (which == 1) {
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), false);   // 日志与魔典互斥
    }
    if (which == 1 || which == 2) {
        BOTC_TipClose(p);           // 帮助面板跟日志 / 魔典互斥
    }
    if (which == 1) {
        BOTC_LogOpen(p);
    }
    if (which == 2) {
        BOTC_GrimRelayout();
        BOTC_GrimRender(p);
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
        if (g_pmPick[p]) {
            BOTC_PmPickApply(p);       // 选人模式里又把魔典点开：按钮和 ＋ 再收一次
        }
    }
    if (which == 3) {
        BOTC_AbilityOpen(p);
    }
    if (which == 4) {
        BOTC_NightOrderOpen(p);
    }
    if (which == 5) {
        BOTC_NoteOpen(p);
    }
    if (which == 6) {
        g_tipForce[p] = -1;        // 点【游戏帮助】= 看自己的角色，别被之前在能力表点过的详情锁住（用户 2026-09-30）
        g_tipMode[p] = 1;          // 默认打开【我的角色】页（角色能力详情），用户 2026-11-04
        BOTC_TipOpen(p);
    }
}

