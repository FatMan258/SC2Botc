    g_tipLine[660] = StringToText("：") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("不会因为戏子（改）能力参与互认，也不会因为戏子（改）的能力") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipRoleAt[38] = 3923;    // 疯子
