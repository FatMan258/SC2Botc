    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupSingle(g_teller), true);
    // 【赋予能力】：原发送互认按钮改为此功能；发送互认已移入【发送特定信息】面板。
    g_recogBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 96, "赋予能力");
    DialogControlSetVisible(g_recogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_recogBtn, PlayerGroupSingle(g_teller), false);
    // 【发送特定信息】：就在【赋予能力】正下方（18, 136）
    //   点开一个小面板，里面装着几条固定文案（假疯子 / 疯子刀人 …），都是「先点一条 → 再点收件人 → 填编号」
    g_specBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 136, "说书人工具");
    DialogControlSetVisible(g_specBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn, PlayerGroupSingle(g_teller), false);
    // 所有人共用的【声称】按钮（白天才有；目前只有猎手能声称）---- 放在【唤醒】右边
    g_declareBtn = BOTC_NewButton(g_grimDlg, 180, 36, 207, 54, "声称/猜测");
    DialogControlSetVisible(g_declareBtn, PlayerGroupAll(), false);
    // 【死后声称】（用户 2026-09-20）：**跟【声称】同一个位置**（两者永远不会同时出现：活着用上面那个，
    //   死了用这个）；面板复刻白天声称那一套，只是里面**只列「死后声称」的角色**（现在只有月之子 36）。
    //   任何玩家都能点（假声称照旧只是声明，真月之子才会真结算）。
    g_dclaimBtn = BOTC_NewButton(g_grimDlg, 180, 36, 207, 54, "声称/猜测");
    DialogControlSetVisible(g_dclaimBtn, PlayerGroupAll(), false);

    // 「说书人」那一格（用户 2026-09-19 晚）：**完全照搬普通玩家座位的样式** ----
    //   同样 124×124 的座位框；名字那一行也摆在框内偏下的同一个位置（座位中心 +34）、
    //   用座位名字那套样式，内容 = 「说书人 [玩家1的战网名]」---- 座位那边写「编号 [名字]」，
    //   这里用「说书人」顶掉编号，战网名按他自己的玩家颜色上色（在 BOTC_GrimRender 里刷）。
    //   没有身份图标、旁边也没有 ＋；所有玩家一直看得见。平时点它没有任何反应，
