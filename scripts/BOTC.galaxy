        return "botc_night152.dds";
    }
    if (idx == 153) {
        return "botc_night153.dds";
    }
    if (idx == 154) {
        return "botc_night154.dds";
    }
    if (idx < 10) {
        return "botc_night0" + IntToString(idx) + ".dds";
    }
    return "botc_night" + IntToString(idx) + ".dds";
}
// 身份名按阵营上色（跟提示文案里的关键词一个色系）
color BOTC_RoleTeamColor (int r) {
    if (g_roleTeam[r] == 1) {
        return Color(0, 191, 255);      // 外来者
    }
    if (g_roleTeam[r] == 2) {
        return Color(255, 69, 0);       // 爪牙
    }
    if (g_roleTeam[r] == 3) {
        return Color(255, 0, 0);        // 恶魔
    }
    if (g_roleTeam[r] == 4) {
        return Color(255, 215, 0);      // 传奇角色
    }
    if (g_roleTeam[r] == 5) {
        return Color(255, 215, 0);      // 奇遇角色
    }
    return Color(0, 191, 255);            // 镇民
}

