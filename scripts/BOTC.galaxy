//--------------------------------------------------------------------------------------------------
// 小工具
//--------------------------------------------------------------------------------------------------
// 【座位颜色表】（用户 2026-10-06）：**不吃大厅自选色**，按物理座位固定用 SC2 原生那套颜色；
//   说书人一律**白色**（谁是当前说书人谁就是白的，换说书人后自动跟着变）。
//   原生顺序：1 红 / 2 蓝 / 3 青 / 4 紫 / 5 黄 / 6 橙 / 7 绿 / 8 粉 /
//             9 紫罗兰 / 10 浅灰 / 11 深绿 / 12 棕 / 13 浅绿
int[14]     g_seatColor;
// 【座位→人】（用户 2026-10-06）：`g_who[逻辑位置] = 物理座位`——编号属于位置、名字属于人。
//   换说书人时对调的是 g_who 的两项；编号表 g_lab 不动（格子 2 永远叫 [1]）。
int[14]     g_who;

// 【屏蔽关系查询】（用户 2026-11-06）：a 是否屏蔽了 b。
bool BOTC_Blocked (int a, int b) {
    if (a < 1 || a > 13 || b < 1 || b > 13) {
        return false;
    }
    return g_block[(a * 14) + b];
}

// 【屏蔽只隐藏屏蔽期间的发言】（用户 2026-11-08）：屏蔽之前发过的公聊记录继续保留可回看；
//   屏蔽期间的发言即使用户后来解除屏蔽，也仍然不在日志里显示。
bool BOTC_PubHideByBlock (int p, int w, int seq) {
    int idx;
    if (p < 1 || p > 13 || w < 1 || w > 13) {
        return false;
    }
    idx = (p * 14) + w;
    // 仍在屏蔽中：屏蔽起点之后的新发言全部隐藏。
    if (g_block[idx]) {
        return seq >= g_blockSeq[idx];
    }
    // 已解除屏蔽：只隐藏「屏蔽起点 ~ 解除时点」这一段，解除之后的新发言照常显示。
    if (g_blockHideTo[idx] <= 0) {
        return false;
    }
    if (seq < g_blockSeq[idx]) {
        return false;
    }
    return seq < g_blockHideTo[idx];
}

// 【双向屏蔽】：任意一方屏蔽了另一方，都算不能私聊 / 邀请 / 加入。
bool BOTC_BlockEither (int a, int b) {
    if (BOTC_Blocked(a, b)) {
        return true;
    }
    return BOTC_Blocked(b, a);
}

// 【私聊里有屏蔽关系】：p 与这个私聊中任意成员的任意方向屏蔽都算。
bool BOTC_SessBlocks (int s, int p) {
    int i;
    if (s < 1 || s > 13) {
        return false;
    }
    for (i = 1; i <= 13; i += 1) {
        if (!g_member[(s * 14) + i]) {
            continue;
        }
        if (BOTC_BlockEither(p, i)) {
            return true;
        }
    }
    return false;
}

// 【解除全部屏蔽】（用户 2026-11-06）：进入新一局和游戏结算时，把所有玩家的屏蔽关系清掉。
void BOTC_BlockClearAll () {
    int i;
    int j;
    for (i = 1; i <= 13; i += 1) {
        for (j = 1; j <= 13; j += 1) {
            g_block[(i * 14) + j] = false;
            g_blockSeq[(i * 14) + j] = 0;
            g_blockHideTo[(i * 14) + j] = 0;
        }
    }
}
//   ❌ `Color` 不能当函数返回类型（编辑器报语法错误）→ 改成"返回颜色索引"的写法放在下一轮做。

// 【随机名字库】（用户 2026-11-12）：37 个星际争霸角色名。
//   只在游戏正式开始后启用；不放进板子数据，也不写 bank。
void BOTC_NamePoolInit () {
    g_namePool[0]  = "雷诺";       g_namePool[1]  = "凯瑞甘";   g_namePool[2]  = "阿塔尼斯"; g_namePool[3]  = "泽拉图";   g_namePool[4]  = "泰凯斯";
    g_namePool[5]  = "诺娃";       g_namePool[6]  = "阿克图尔斯"; g_namePool[7] = "瓦伦里安"; g_namePool[8]  = "马特";     g_namePool[9]  = "米拉";
    g_namePool[10] = "斯旺";       g_namePool[11] = "斯台特曼"; g_namePool[12] = "托什";     g_namePool[13] = "汉森";     g_namePool[14] = "斯托科夫";
    g_namePool[15] = "沃菲尔德";   g_namePool[16] = "塔萨达尔"; g_namePool[17] = "菲尼克斯"; g_namePool[18] = "塔兰达尔"; g_namePool[19] = "凯拉克斯";
    g_namePool[20] = "赛兰迪丝";   g_namePool[21] = "沃拉尊";   g_namePool[22] = "阿拉纳克"; g_namePool[23] = "吉娜拉";   g_namePool[24] = "玛拉什";
    g_namePool[25] = "亚顿";       g_namePool[26] = "洛哈娜";   g_namePool[27] = "阿尔达瑞斯"; g_namePool[28] = "扎加拉"; g_namePool[29] = "阿巴瑟";
    g_namePool[30] = "德哈卡";     g_namePool[31] = "伊兹莎";   g_namePool[32] = "尼亚德拉"; g_namePool[33] = "祖尔温";   g_namePool[34] = "主宰";
    g_namePool[35] = "埃蒙";       g_namePool[36] = "纳鲁德";
}

// 按**物理座位**取随机名；没分配过就返回空串（调用方回退到战网名）。
string BOTC_RandomNameOf (int pid) {
    if (pid < 1 || pid > 13) {
        return "";
    }
    return g_dispName[pid];
}

// 聊天 / 日志 / 统计里的显示名：非说书人优先用随机 / 自选名；
// 说书人只有自己输入过名字时才用该名字，否则继续显示战网名。
text BOTC_PlayerDisplayName (int pid) {
    string nm;
    // 【点开始说书之前只显示星际名称】（用户 2026-11-13）：选剧本页面一律显示战网名
    if (g_boardOpen) {
        return PlayerName(pid);
    }
    if (pid == g_teller && !g_introChosen[pid]) {
        return PlayerName(pid);
    }
    nm = BOTC_RandomNameOf(pid);
    if (StringLength(nm) > 0) {
        return StringToText(nm);
    }
    return PlayerName(pid);
}

// 【随机取名】（用户 2026-11-12）：地图一开始就把 37 个名字洗牌后固定分配给 13 个玩家号，
//   说书人拿一个隐藏占位名；其余 12 个名字本局一直沿用，换座位/换说书人都不变，
//   取消正式开始或重新开始也不恢复战网名。只有开局场数播报和场数统计仍读战网名。
void BOTC_AssignRandomNames () {
    int[37] pool;
    int i;
    int j;
    int k;
    int n;
    string nm;
    for (i = 1; i <= 13; i += 1) {
        g_dispName[i] = "";
    }
    BOTC_NamePoolInit();
    for (i = 0; i < 37; i += 1) {
        pool[i] = i;
    }
    // Fisher-Yates 洗牌，保证同一局不会出现重名
    for (i = 36; i > 0; i -= 1) {
        j = RandomInt(0, i);
        k = pool[i];
        pool[i] = pool[j];
        pool[j] = k;
    }
    // 已经通过输入框取名的人优先使用自选名。说书人仍显示战网名，但这里先保存自选名，
    // 方便测试；之后若说书人卸任，这个名字会随着该玩家进入普通座位。
    for (i = 1; i <= 13; i += 1) {
        if (g_introChosen[i] && StringLength(g_introName[i]) > 0) {
            g_dispName[i] = g_introName[i];
        }
    }
    n = 0;
    // 未取名的人从洗好的库里取；跳过自选名，仍然保证本局 13 个显示名不重复。
    for (i = 1; i <= 13; i += 1) {
        if (StringLength(g_dispName[i]) > 0) {
            continue;
        }
        if (i == g_teller) {
            continue;
        }
        while (n < 37) {
            nm = g_namePool[pool[n]];
            n = n + 1;
            j = 1;
            while (j <= 13 && g_dispName[j] != nm) {
                j = j + 1;
            }
            if (j > 13) {
                g_dispName[i] = nm;
                break;
            }
        }
    }
}

// 【清回战网名】：结算 / 取消开始 / 回到选板页时使用，同时丢掉下一次开局的自选名。
void BOTC_ResetPlayerNames () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        g_dispName[p] = "";
        g_introName[p] = "";
        g_introChosen[p] = false;
        g_introAnnounced[p] = false;
    }
    if (g_grimDlg == 0) {
        return;
    }
    if (g_teller >= 1 && g_teller <= 13) {
        BOTC_GrimRender(g_teller);
    }
    for (p = 1; p <= 13; p += 1) {
        if (p != g_teller && PlayerType(p) != 0 && PlayerStatus(p) != 2) {
            BOTC_GrimRender(p);
        }
    }
}

// 【补发随机名】（用户 2026-11-11）：换说书人 / 换座位 / 中途加入时兜底 ——
//   非说书人玩家如果没有名字（例如刚换下来的旧说书人），从名字库里找一个还没被用过的补上。
void BOTC_RandomNameEnsure (int pid) {
    int[37] freeIdx;
    int i;
    int j;
    int n;
    string nm;
    if (pid < 1 || pid > 13 || pid == g_teller) {
        return;
    }
    if (StringLength(g_dispName[pid]) > 0) {
        return;
    }
    if (StringLength(g_namePool[0]) <= 0) {
        BOTC_NamePoolInit();
    }
    n = 0;
    for (i = 0; i < 37; i += 1) {
        nm = g_namePool[i];
        j = 1;
        while (j <= 13 && g_dispName[j] != nm) {
            j = j + 1;
        }
        if (j > 13) {
            freeIdx[n] = i;
            n = n + 1;
        }
    }
    if (n <= 0) {
        return;
    }
    g_dispName[pid] = g_namePool[freeIdx[RandomInt(0, n - 1)]];
}

string BOTC_NameStr (int p) {
    // 【p 是"格子"不是"人"】（用户 2026-10-07 截图实锤）：判"是不是说书人格"必须用 `g_who[p]`，
    //   不能写 `p == g_teller` —— 换位后 g_teller 是**物理座位**（比如 5），而格子号 5 是别人坐的，
    //   结果那个人的名字被误写成"说书人"（玩家之间换不会撞上这种巧合，涉及说书人就撞上）。
    if (g_who[p] == g_teller || p == 1) {
        return "说书人";
    }
    // 日志里存的**占位名**：渲染时会被 BOTC_NameSubst() 换成「[序号] + 战网名」。
    //   保留「玩家N」是为了兼容那些只写字符串、没法塞 text 的地方（提示条之类）。
    // 【占位名按编号 = g_lab[位置]】（用户 2026-10-07）：编号属于**位置/格子**，玩家1 = 格子2、玩家12 = 格子13。
    //   写进去的「玩家N」里的 N 就是 g_lab[位置]（编号）；渲染时 BOTC_NameSubst 把「玩家N」换成"那格现在坐的人"。
    if (p == 1) {
        return "说书人";              // 【不出现"玩家0"】（用户 2026-10-06）：格子 1 永远是"说书人格"，不按编号算
    }
    return "玩家" + IntToString(g_lab[p]);                     // 【占位名 = g_lab[格子]】（用户 2026-10-07）：玩家1 = 格子 2
}

// 「名字前面的标记」----说书人是 [说书人]，玩家是 [序号]。
//   ⚠ 序号 = g_lab[位置] + g_nameNumShift（默认 0 = 玩家1 是格子2、玩家12 是格子13）；
//     要现场调就在聊天里发 nameoff <数字>（-1 就都往前挪一位）。
string BOTC_NameTag (int p) {
    // 【说书人格子按位置判】（用户 2026-10-07）：p 是**逻辑位置**；g_teller 是物理座位，
    //   换说书人之后坐进"说书人格"的是别人（位置 1 的 g_who[1] == g_teller）→ 不能只比 p == g_teller。
    if (g_who[p] == g_teller || p == 1) {
        return "[说书人] ";            // 【去掉 [0]】（用户 2026-10-06）：位置 1 永远是"说书人格"，不带编号
    }
    // 【点开始说书之前只显示星际名称】（用户 2026-11-13）：选剧本页面不显示座位号
    if (g_boardOpen) {
        return "";
    }
    return "[" + IntToString(g_lab[p] + g_nameNumShift) + "] ";  // 【编号 = g_lab[格子]】（用户 2026-10-07）：格子 2 显示 [1]
}

// 一个玩家显示出来长什么样：标记（默认颜色=白）+ **他的战网名**（按他自己的玩家颜色上色）。
// 【座位名字兜底】（用户 2026-11-04）：单人局里空位 / 电脑座位没有战网名，PlayerName() 返回空串，
//   魔典座位和聊天里的名字会整块空白；这里统一兜底成按编号的「玩家N」（编号仍取 g_lab[位置]）。
text BOTC_SeatNameText (int pos) {
    string nm;
    // 【显示名】：说书人主动取名时也显示自选名；未取名仍回退战网名。
    // 【点开始说书之前只显示星际名称】（用户 2026-11-13）：选剧本页面不显示起名阶段的自选名 / 随机名。
    nm = "";
    if (!g_boardOpen && (g_who[pos] != g_teller || g_introChosen[g_who[pos]])) {
        nm = BOTC_RandomNameOf(g_who[pos]);
    }
    if (StringLength(nm) <= 0) {
        nm = TextToString(PlayerName(g_who[pos]));
    }
    if (StringLength(nm) <= 0) {
        if (pos == 1) {
            return StringToText("说书人");
        }
        return StringToText("玩家" + IntToString(g_lab[pos]));
    }
    return StringToText(nm);
}

//   ⚠ PlayerName() 返回的是 text，所以整段用 text 拼（string + text 会报「不正确的类型」）。
text BOTC_PlayerNameText (int p) {
    text nt;
    if (p < 1 || p > 13) {
        return StringToText("");
    }
    // 【颜色统一】（用户 2026-10-06 / 2026-10-14）：**说书人 = 粉** Color(255,105,180)；其它按**物理座位的原生色**（g_seatColor），
    //   不再用大厅自选色。公聊 / 私聊 / 日志 / 提示条的名字都走这里，改一处就全跟上了。
    // 【名字取"这个位置现在的人"】（用户 2026-10-06）：位置 p 上现在坐的是物理座位 g_who[p] 那个人。
    // 【"说书人那一格"按位置判】（用户 2026-10-07）：g_teller 是**物理座位**，换说书人之后
    //   坐进这一格的是别人（g_who[1] == g_teller）→ 用 g_who[p] 判，否则这一格会被刷成红色。
    // 【不再标「已退出」】（用户 2026-11-03）：进行中退出只保留座位和名字，不额外加退出后缀。
    // 【彩色名字不再套座位色】（用户 2026-11-13）：玩家自选名字里的 <c> 标签已经决定颜色，
    //   外层再包一层座位色会形成嵌套标签，导致名字后面的聊天正文被染色；这里直接原样输出。
    nt = BOTC_SeatNameText(p);
    if (StringFind(TextToString(nt), "<c", false) >= 0) {
        return StringToText(BOTC_NameTag(p)) + nt;
    }
    if (g_who[p] == g_teller || p == 1) {
        return StringToText(BOTC_NameTag(p)) + TextWithColor(nt, libNtve_gf_ConvertPlayerColorToColor(g_seatColor[1]));   // 【说书人 = 游戏原生粉】（用户 2026-10-14）：色号 15
    }
    return StringToText(BOTC_NameTag(p)) + TextWithColor(nt, libNtve_gf_ConvertPlayerColorToColor(g_seatColor[p]));
}

// 【魔典座位名字那一行】（用户 2026-11-13）：点开始说书之前只显示战网名（说书人格额外加「说书人」前缀，
//   不带座位号）；进入剧本后（含取名 / 准备阶段）都显示「座位号 [名字]」。
text BOTC_SeatLabelText (int pos) {
    text nt;
    nt = BOTC_SeatNameText(pos);
    if (g_boardOpen) {
        if (g_who[pos] == g_teller || pos == 1) {
            return StringToText("说书人 [") + TextWithColor(nt, libNtve_gf_ConvertPlayerColorToColor(g_seatColor[pos])) + StringToText("]");
        }
        return TextWithColor(nt, libNtve_gf_ConvertPlayerColorToColor(g_seatColor[pos]));
    }
    return StringToText(IntToString(g_lab[pos] + g_nameNumShift) + " [") + TextWithColor(nt, libNtve_gf_ConvertPlayerColorToColor(g_seatColor[pos])) + StringToText("]");
}

// 【说话人占位符】（用户 2026-10-07）：公聊 / 私聊 / 邪恶小窗 / -laugh 的**说话人**不再按"格子"记，
//   而是按**人**（你的物理座位）记成 @@1NN@@。渲染时换成"这个人**现在**所在格子的编号 + 他自己的战网名
//   + 那个格子的颜色"—— 跟公屏弹幕那一行（BOTC_SayColor）完全同一套口径。
//   ⚠ 只有**说话人**用这个；正文里提到别人（"占卜师验了 玩家5"那种）还是按格子记（那是"第几号位"的意思）。
string BOTC_SayToken (int seat) {
    return "@@" + IntToString(100 + seat) + "@@";
}

// -handles 专用：渲染时换成该物理座位的 Battle.net 句柄，并按玩家原生颜色显示。
string BOTC_HandleToken (int seat) {
    return "@@H" + IntToString(seat) + "@@";
}

// 【物理座位 → 逻辑位置】（用户 2026-10-07）：换说书人之后"人"和"位置"不是一回事 ----
//   · 事件 / 点击 / 投递拿到的是**物理座位**（SC2 玩家号，人不会真的换坑）；
//   · 而日志 / 名字 / 编号 / 颜色都要按**位置**取（位置 i 现在坐的是 g_who[i]）。
//   反查：`g_who[i] == 这个物理座位` 的那个 i。没换过人的局 = 自己。
int BOTC_PosOf (int seat) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        if (g_who[i] == seat) {
            return i;
        }
    }
    return seat;
}

// 【说话人那一行的名字颜色】（用户 2026-10-07 报「换位后颜色不对」）：公聊 / 私聊 / 邪恶小窗
//   右上角弹的那一行按**位置**取色（不吃大厅自选色）；说书人那一格 = 粉 Color(255,105,180)（判据跟 BOTC_PlayerNameText
//   一致：位置 p 的 g_who[p] == g_teller）。原来这里用的是 PlayerGetColorIndex（大厅色）→ 现在 0 处。
color BOTC_SayColor (int seat) {
    int i;
    i = BOTC_PosOf(seat);
    if (g_who[i] == g_teller || i == 1) {
        return libNtve_gf_ConvertPlayerColorToColor(g_seatColor[1]);      // 【说书人 = 游戏原生粉】（用户 2026-10-14）：色号 15
    }
    return libNtve_gf_ConvertPlayerColorToColor(g_seatColor[i]);
}

// 把一行里出现的「玩家N」（以及「说书人：」这种说话人写法）全部换成上面那种显示 ----
//   聊天窗 / 私聊窗 / 日志页 / 投票统计 / 提示条都走这里，一行里提到几个人就都替掉。
//   ⚠ 用户 2026-09-19：原来是自己「找位置 + 切字符串」拼出来的，长提示里会把正文吃掉（只剩两个名字）；
//     现在改用原生 TextReplaceWord 做整词替换。
text BOTC_NameSubst (string line) {
    return BOTC_NameSubstText(StringToText(line));
}
text BOTC_PutWord (text t, string word, color c) {
    return TextReplaceWord(t, StringToText(word), TextWithColor(StringToText(word), c), c_stringReplaceAll, true);
}

// 关键词上色（用户 2026-09-19）：系统提示整行是灰的，但下面这些词保持自己的颜色。
//   ⚠【约定·用户 2026-09-21】新增任何文案（角色提示 / 角色能力表 / 名词页 / 公屏 / 私聊）都要走这一套：
//     · 面板文案走 BOTC_TipLines、角色能力表走显示时的 BOTC_KeyColor、聊天日志走 BOTC_LineText ---- 都是自动上色，
//       所以文案里直接写纯文本就行，不要自己手写 TextWithColor（除非要强调某个特殊词）。
//     · 但**新角色名 / 新关键词必须来这张表补一行**，否则那几行字不会上色（跟其它词一样是灰的）。
//   以后新加的系统提示只要走 BOTC_LineText，就会自动带上这套颜色，不用单独处理。
//   ⚠ 顺序有讲究：先长后短（「小恶魔」要在「恶魔」前面替），否则长词会被短词切坏。
//   ⚠【用户 2026-09-30】镇民身份与「镇民」关键词统一改成和外来者同款的天蓝 #00BFFF（原来是 #0000FF）。
text BOTC_KeyColor (text t) {
    // 【信息】统一标签：亮绿色（所有角色信息 / 说书人手动信息共用）
    t = BOTC_PutWord(t, "【信息】", Color(0, 255, 0));
    // 七个分类词
    t = BOTC_PutWord(t, "小恶魔", Color(255, 0, 0));
    t = BOTC_PutWord(t, "镇民", Color(0, 191, 255));
    t = BOTC_PutWord(t, "外来者", Color(0, 191, 255));
    t = BOTC_PutWord(t, "爪牙", Color(255, 69, 0));
    t = BOTC_PutWord(t, "恶魔", Color(255, 0, 0));
    t = BOTC_PutWord(t, "中毒", Color(128, 0, 128));
    t = BOTC_PutWord(t, "善良", Color(30, 144, 255));
    t = BOTC_PutWord(t, "邪恶", Color(139, 0, 0));
    // 镇民（天蓝）
    t = BOTC_PutWord(t, "图书管理员", Color(0, 191, 255));
