    libNtve_gf_SetDialogItemImage(g_saySeatDead, "botc_exec.dds", PlayerGroupAll());
    DialogControlSetVisible(g_saySeatDead, PlayerGroupAll(), false);
    // 【说书人那一格也显示被提名 / 票数 / 待处决】（用户 2026-11-04）
