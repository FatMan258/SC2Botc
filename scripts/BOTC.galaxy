    g_jinxA[121] = 101;  g_jinxB[121] = 153;
    g_jinxText[121] = "异端分子与狐媚娘：互为克星的角色在同一时间里只能有其中一个角色在场。";
    g_jinxText2[121] = "";
    g_jinxText3[121] = "";
    g_jinxA[122] = 137;  g_jinxB[122] = 153;
    g_jinxText[122] = "瘟疫医生与狐媚娘：如果说书人本应获得狐媚娘能力，改为一名爪牙获得，且他会得知此事。";
    g_jinxText2[122] = "";
    g_jinxText3[122] = "";
    g_jinxA[123] = 156;  g_jinxB[123] = 24;
    g_jinxText[123] = "引路人与侍女：侍女会得知引路人是否醒来，即使她是在引路人之前醒来。";
    g_jinxText2[123] = "";
    g_jinxText3[123] = "";
    g_jinxA[124] = 156;  g_jinxB[124] = 50;
    g_jinxText[124] = "引路人与数学家：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。";
    g_jinxText2[124] = "";
    g_jinxText3[124] = "";
    g_jinxA[125] = 124;  g_jinxB[125] = 86;
    g_jinxText[125] = "鸩与罂粟种植者：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。";
