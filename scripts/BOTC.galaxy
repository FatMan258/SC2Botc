void BOTC_BootleggerSyncText () {
    int i;
    int pos;
    int end;
    int n;
    int len;
    string s;
    string s2;
    s = BOTC_BootleggerEffectiveText();
    len = StringLength(s);
    // 能力表标签自己会按 460 像素宽度折行；不要预先插换行，避免把 UTF-8 汉字切坏。
    g_tipAbility[130] = StringToText(s);
    g_tipLine[3045] = StringToText("【角色能力】");
    for (i = 3046; i <= 3099; i += 1) {
        g_tipLine[i] = StringToText("");
    }
    n = 0;
    if (g_board == 13 && g_legacyOn[130]) {
        while (n < 54 && BOTC_BootleggerAmnesiaLine(n) != "") {
            g_tipLine[3046 + n] = StringToText(BOTC_BootleggerAmnesiaLine(n));
            n = n + 1;
        }
        g_tipRoleN[130] = 1 + n;
        return;
    }
    pos = 1;
    while (pos <= len && n < 54) {
        // 角色详情列表约 29 个汉字一行；按标点断行，避免切在半个汉字上出现「?」。
        end = BOTC_LineCut(s, pos, 90, 12, len);
        s2 = StringSub(s, pos, end);
        g_tipLine[3046 + n] = StringToText(s2);
        n = n + 1;
        pos = end + 1;
    }
    // 角色简介（用户 2026-11-06）：按 wiki「私货商人」原文补齐；
    // 自定义规则超过 41 行时不再追加，保证本局规则文本完整优先。
    if (n + 13 <= 54) {
        g_tipLine[3046 + n] = StringToText("【角色简介】");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人允许说书人使用自己或他人创造的非官方角色，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("或允许他在游戏中使用非标准规则。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("如果剧本列表上有自定义角色，或游戏中包含自定义规则，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("说书人需要在游戏开始前讲这些内容介绍给所有玩家。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人允许剧本中夹杂复数数量的自定义角色或规则。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("只要当前剧本中包含有至少一个自定义角色，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("这个奇遇角色就会生效，且只能通过切换到一个");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("不包含任何自定义角色的剧本来将其移除。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("私货商人是仅能在官方app（国内为在线魔典）上使用的奇遇角色。");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("尽管这个角色的名字之前有很多备选方案，");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("但在决定它名字的一次激烈投票中，「私货商人」成功击败了");
        n = n + 1;
        g_tipLine[3046 + n] = StringToText("「私酿世家的霍姆布鲁菲斯蜀黍」。");
        n = n + 1;
    }
    g_tipRoleN[130] = 1 + n;
}

void BOTC_BootleggerCapture () {
    string s;
    if (g_cBootEdit >= 1) {
        s = libNtve_gf_DialogItemEditValue(g_cBootEdit, g_teller);
        // 点击其他控件时，EditBox 可能短暂返回空串；不能用它覆盖已经读到的规则。
        if (StringLength(s) > 0 || StringLength(g_bootText) == 0) {
            g_bootText = s;
        }
    }
}

void BOTC_BootleggerEditRefresh () {
    if (g_cBootEdit >= 1) {
        libNtve_gf_SetDialogItemText(g_cBootEdit, StringToText(g_bootText), PlayerGroupAll());
    }
}

void BOTC_BootleggerAnnounce () {
    int len;
    int pos;
    int end;
    string s;
    string b;
    if (!g_legacyOn[130]) {
        return;
    }
    BOTC_BootleggerSyncText();
    s = BOTC_BootleggerEffectiveText();
    len = StringLength(s);
    BOTC_PubAnnounce("【私货商人】本局自定义规则：");
    if (g_board == 13 && g_legacyOn[130]) {
        len = 0;
        while (len < 54 && BOTC_BootleggerAmnesiaLine(len) != "") {
            BOTC_PubAnnounce(BOTC_BootleggerAmnesiaLine(len));
            len = len + 1;
        }
        return;
    }
    pos = 1;
    while (pos <= len) {
        // 公聊约 33 个汉字一行（按 UTF-8 字节额度）；按标点断行，避免切在半个汉字上出现「?」。
        end = BOTC_LineCut(s, pos, 100, 30, len);
        b = StringSub(s, pos, end);
        BOTC_PubAnnounce(b);
        pos = end + 1;
    }
}

// 【自定义剧本可选项】骑士、杂技演员已恢复显示；其余旧《赎罪小镇》隐藏角色保持原状。
bool BOTC_CustomRoleVisible (int r) {
    if (r >= 143 && r <= 146) {
        return false;                 // 全员追忆的玩家视角占位身份不进入自定义角色池
    }
    if (r == 123 || r == 124 || r == 126) {
        return false;
    }
    return true;
}

int BOTC_CustomSlotRow (int s) {
    if (s < 8) { return 176; }
    if (s < 16) { return 266; }
    if (s < 21) { return 396; }
    if (s < 26) { return 516; }
    if (s < 31) { return 636; }
    if (s < 33) { return 756; }
    return 876;
}

int BOTC_CustomSlotCol (int s) {
    if (s < 8) { return s; }
    if (s < 16) { return s - 8; }
    if (s < 21) { return s - 16; }
    if (s < 26) { return s - 21; }
    if (s < 31) { return s - 26; }
    if (s < 33) { return s - 31; }
    return s - 33;
}

int BOTC_CustomSlotBase (int team) {
    if (team == 0) { return 0; }
    if (team == 1) { return 16; }
    if (team == 2) { return 21; }
    if (team == 3) { return 26; }
    if (team == 4) { return 31; }
    return 33;
}

int BOTC_CustomSlotMax (int team) {
    if (team == 0) { return 16; }
    if (team == 4 || team == 5) { return 2; }
    return 5;
}

int BOTC_CustomGrpY (int i) {
    if (i == 0) { return 148; }
    if (i == 1) { return 368; }
    if (i == 2) { return 488; }
    if (i == 3) { return 608; }
    if (i == 4) { return 728; }
    return 848;
}

string BOTC_CustomCatName (int cat) {
    if (cat == 0) {
        return "镇民";
    }
    if (cat == 1) {
        return "外来者";
    }
    if (cat == 2) {
        return "爪牙";
    }
    if (cat == 3) {
        return "恶魔";
    }
    if (cat == 4) {
        return "传奇角色";
    }
    return "奇遇角色";
}

int BOTC_CatCap (int cat) {
    if (cat == 0) {
        return 14;
    }
    if (cat == 4 || cat == 5) {
        return 2;               // 与右侧传奇 / 奇遇各两格保持一致
    }
    return 5;
}

// 这个分类目前有几个角色（分类号 = 阵营号：0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔 / 4 传奇 / 5 奇遇）
int BOTC_CatRoleN (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        n = n + 1;
    }
    return n;
}

// 第 i 个该分类的角色（-1 = 没有）
int BOTC_CatRoleAt (int cat, int i) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (StringLength(g_roleName[r]) <= 0) {
            continue;
        }
        if (n == i) {
            return r;
        }
        n = n + 1;
    }
    return -1;
}

int BOTC_CatPicked (int cat) {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] != cat) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_CatPickedAll () {
    int r;
    int n;
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_csel[r]) {
            n = n + 1;
        }
    }
    return n;
}

void BOTC_CustomRender () {
    int i;
    int r;
    int n;
    int pages;
    int used;
    int cc;
    int hn;
    int lty;
    int cx;
    int cy;
    string s;
    // 6 个分类按钮 + 计数，当前分类前面加 ▶
    for (i = 0; i < 6; i += 1) {
        s = BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i)) + "/" + IntToString(BOTC_CatCap(i));
        if (i == g_cat) {
            s = "▶ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cCatBtn[i], StringToText(s), PlayerGroupAll());
    }
    // 左盘块
    n = BOTC_CatRoleN(g_cat);
    pages = (n + 53) / 54;
    if (pages < 1) {
        pages = 1;
    }
    if (g_cpage < 0) {
        g_cpage = 0;
    }
    if (g_cpage > pages - 1) {
        g_cpage = pages - 1;
    }
    for (i = 0; i < 54; i += 1) {
        if (i >= 54) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        cx = 18 + ((i % 9) * 120);
        cy = 166 + ((i / 9) * 100);
        DialogControlSetPosition(g_cIcon[i], PlayerGroupAll(), c_anchorTopLeft, cx + 29, cy);
        DialogControlSetPosition(g_cIconImg[i], PlayerGroupAll(), c_anchorTopLeft, cx + 18, cy - 8);   // 【图标偏移】（用户 2026-10-04 定稿：X=18 / Y=-8）
        DialogControlSetPosition(g_cName[i], PlayerGroupAll(), c_anchorTopLeft, cx + 2, cy + 66);
        r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
        if (r < 0) {
            DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cName[i], StringToText(""), PlayerGroupAll());
            continue;
        }
        DialogControlSetVisible(g_cIcon[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_cName[i], PlayerGroupAll(), true);
        libNtve_gf_SetDialogItemImage(g_cIconImg[i], BOTC_NightIconName(r), PlayerGroupAll());
        s = g_roleName[r];
        if (g_csel[r]) {
            s = "√ " + s;
        }
        libNtve_gf_SetDialogItemText(g_cName[i], TextWithColor(StringToText(s), BOTC_RoleTeamColor(r)), PlayerGroupAll());
    }
    // 【暴风捕手（113）】（用户 2026-10-10）：选了他就显示他保护谁；正在等他选就提示点一个角色
    if (g_cStormPick) {
        libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("【暴风捕手】点一个角色 = 保护他（当前：" + g_roleName[g_cStormRole] + "）"), PlayerGroupAll());
    }
    else {
        if (g_csel[113]) {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消   【暴风捕手】保护：" + g_roleName[g_cStormRole]), PlayerGroupAll());
        }
        else {
            libNtve_gf_SetDialogItemText(g_cInfoLbl, StringToText("左：点图标 = 选中 / 取消"), PlayerGroupAll());
        }
    }
    libNtve_gf_SetDialogItemText(g_cPageLbl, StringToText(BOTC_CustomCatName(g_cat) + "：第 " + IntToString(g_cpage + 1) + " / " + IntToString(pages) + " 页（共 " + IntToString(n) + " 个）"), PlayerGroupAll());
    // 右盘块：按阵营分组往下排（每组一行彩色标题 + 图标，名字在图标下面）
    used = 0;
    cc = 0;
    hn = 0;
    lty = -1;
    cy = 150;
    for (i = 0; i < 35; i += 1) {
        DialogControlSetVisible(g_cSelIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cSelIconImg[i], PlayerGroupAll(), false);
        libNtve_gf_SetDialogItemText(g_cSelName[i], StringToText(""), PlayerGroupAll());
    }
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_cGrpLbl[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < 6; i += 1) {
        r = BOTC_CatRoleAt(i, 0);
        if (r < 0) {
            r = 88;
        }
        libNtve_gf_SetDialogItemText(g_cGrpLbl[i], TextWithColor(StringToText(BOTC_CustomCatName(i)), BOTC_RoleTeamColor(r)), PlayerGroupAll());
        used = BOTC_CustomSlotBase(i);
        for (r = 0; r <= 163; r += 1) {
            if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
                continue;
            }
            if (g_roleTeam[r] != i) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i)) {
                break;
            }
            libNtve_gf_SetDialogItemImage(g_cSelIconImg[used], BOTC_NightIconName(r), PlayerGroupAll());
            libNtve_gf_SetDialogItemText(g_cSelName[used], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupAll());
            DialogControlSetVisible(g_cSelIcon[used], PlayerGroupAll(), true);
            DialogControlSetVisible(g_cSelIconImg[used], PlayerGroupAll(), true);
            used = used + 1;
        }
        for (r = used; r < BOTC_CustomSlotBase(i) + BOTC_CustomSlotMax(i); r += 1) {
            DialogControlSetVisible(g_cSelIcon[r], PlayerGroupAll(), false);
            DialogControlSetVisible(g_cSelIconImg[r], PlayerGroupAll(), false);
            libNtve_gf_SetDialogItemText(g_cSelName[r], StringToText(""), PlayerGroupAll());
        }
    }
    if (g_customSlot >= 1 && g_customSlot <= 6) {
        s = "自定义板 " + IntToString(g_customSlot) + "　已选 " + IntToString(used) + " / 35　";
    }
    else {
        s = "请选择下方自定义板 1..6　已选 0 / 35　";
    }
    for (i = 0; i < 6; i += 1) {
        if (i > 0) {
            s = s + " · ";
        }
        s = s + BOTC_CustomCatName(i) + " " + IntToString(BOTC_CatPicked(i));
    }
    libNtve_gf_SetDialogItemText(g_cSelTitle, StringToText(s), PlayerGroupAll());
    if (g_csel[130]) {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), true);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), false);
        DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), false);
    }
}

void BOTC_AlchemistGuess (int p, int role) {
    if (p < 1 || p > 13) {
        return;
    }
    if (role != 18 && role != 75) {
        return;
    }
    if (g_alcSeat < 2 || g_alcSeat > 13) {
        return;
    }
    g_alcBy = p;
    g_alcClaimDay[p] = g_nightNum;   // 公开说出猜测即算声称用掉（真身/假声称都一样，每人每天一次）
    BOTC_PubAnnounce("【炼金术士】" + BOTC_NameStr(p) + " 公开猜测 " + BOTC_NameStr(g_alcSeat) + " 是" + g_roleName[role] + "。");
    BOTC_DeclareCdSet(p);
    // 谁都可以公开声称炼金术士；只有真正拥有这项能力且当前清醒的人产生效果。
    // 伪造声称不能覆盖真炼金术士已经记下的结果。
    if (!BOTC_HasAbility(p, 95)) {
        return;                        // 假声称：不给说书人私聊提醒（用户 2026-11-04）
    }
    if (BOTC_SeatDead(p) || !BOTC_AbilityWorks(p, 95)) {
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 声称猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：中毒/醉酒或已死亡 → 能力失效，不结算。");
        return;
    }
    if (BOTC_SeatTrueRole(g_alcSeat) == role) {
        g_alcGuess = g_alcSeat;
        g_alcDay = g_dayNum + 1;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜对了。");
    }
    else {
        g_alcGuess = 0;
        g_alcDay = 0;
        BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(p) + " 猜测 " + BOTC_NameStr(g_alcSeat) + " 是【" + g_roleName[role] + "】：猜错了。");
    }
}
void BOTC_AlcBorrowOpen (int p) {
    int q;
    if (p < 2 || p > 13) {
        return;
    }
    // 【炼金术士(95)】（用户 2026-10-03）：这一格是**说书人**替他选借到哪只爪牙，
    //   所以面板开在**说书人**身上；被借能力的座位（p）记在 g_pickWho[g_teller]，点完由 BOTC_PickChoose 的模式 21 应用。
    g_pickMode[g_teller] = 21;
    g_pickWho[g_teller] = p;
    // 【借来的炼金术士能力】（用户 2026-11-03）：只把借到的爪牙能力挂到本座位，
    //   不改变身份、不打「是炼金术士」token。
    if (g_grantActing[p]) {
        g_pickAttachSeat[g_teller] = p;
    }
    g_pickTeam = 2;
    BOTC_PickFilter(g_teller, false);
    // 【炼金术士 × 间谍/寡妇相克】（用户 2026-11-06）：这两只不能被借用 ----
    //   按相克规则，本应获得间谍/寡妇能力时改为该角色一定在场，炼金术士不获得该能力。
    //   这里直接把两个按钮藏掉；若本局确实没有该角色，提醒说书人按「一定在场」处理。
    if (!BOTC_RoleInPlay(18) || !BOTC_RoleInPlay(75)) {
        BOTC_PmStore(g_teller, "【炼金术士×间谍/寡妇】按相克规则，炼金术士不能借用间谍或寡妇的能力；若本应获得该能力，改为该角色一定在场（可手工调整魔典）。");
    }
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 2 || g_gridSlot[q] == 18 || g_gridSlot[q] == 75) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}
void BOTC_AlchemistAsk (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    // 【炼金术士声称窗口】（用户 2026-11-04）：只能在提名处决之后、进入夜晚之前公开声称；
    //   每人每天一次，任何人都能声称，但只有真正的炼金术士猜对才有效果。
    if (!g_started || g_isNight || !g_execUsedToday) {
        BOTC_Notice(p, "【炼金术士】只能在今天的提名处决结束后、进入夜晚之前声称。");
        return;
    }
    if (g_alcClaimDay[p] == g_nightNum) {
        BOTC_Notice(p, "【炼金术士】你今天已经声称过了，每人每天只能声称一次。");
        return;
    }
    g_alcChoice[p] = true;
    g_alcPick[p] = false;
    g_alcRolePick[p] = 0;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    // 复用已经稳定的通用身份面板，避免独立小窗在某些客户端层级下不显示。
    g_pickMode[p] = 20;
    g_pickWho[p] = p;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatBtn[q], PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), false);
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    BOTC_DeclareSlot(p, 57, 18, 0, g_roleName[18]);
    BOTC_DeclareSlot(p, 58, 75, 1, g_roleName[75]);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("猜间谍还是寡妇？"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
    BOTC_DeclareRender();              // 按钮文字切到「声称中」
}
void BOTC_AlchemistPickRole (int p, int role) {
    if (p < 1 || p > 13 || !g_alcChoice[p]) {
        return;
    }
    g_alcChoice[p] = false;
    DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
    if (role != 18 && role != 75) {
        g_alcPick[p] = false;
        g_alcRolePick[p] = 0;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消炼金术士声称。");
        return;
    }
    BOTC_TellRoleChoice(p, role);
    BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(BOTC_PosOf(p)) + " 声称猜【" + g_roleName[role] + "】，正在选择要猜的玩家。");
    g_alcRolePick[p] = role;
    g_alcPick[p] = true;
    BOTC_DeclareRender();
    BOTC_Notice(p, "你选择猜【" + g_roleName[role] + "】。现在点一名存活玩家。");
}
void BOTC_BuildCustom () {
    int i;
    int c;
    int rw;
    int x;
    int y;
    // 选板页入口改成「更多剧本」第一格（用户 2026-11-01），不再单独建按钮。
    g_customSlot = 0;
    // 面板本体（铺满整屏、不要底框，黑布透出来；用户 2026-10-03）
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_cDlg = DialogLastCreated();
    DialogSetImageVisible(g_cDlg, false);
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    // 自定义编辑器最底部：6 个窄槽位按钮。
    for (i = 0; i < 6; i += 1) {
        g_customSlotBtn[i] = BOTC_NewButton(g_cDlg, 64, 44, 1260 + (i * 76), 1120, IntToString(i + 1));
        DialogControlSetVisible(g_customSlotBtn[i], PlayerGroupAll(), false);
    }
    // 顶部 6 个分类按钮
    for (i = 0; i < 6; i += 1) {
        g_cCatBtn[i] = BOTC_NewButton(g_cDlg, 190, 50, 25 + (i * 240), 70, BOTC_CustomCatName(i));
    }
    // 左盘块：标题 + 4 x 4 角色格（每页 16 个）
    g_cInfoLbl = BOTC_NewLabelC(g_cDlg, 500, 30, 30, 140, StringToText("左：点图标 = 选中 / 取消"));
    libNtve_gf_SetDialogItemStyle(g_cInfoLbl, "ModLeftSize16Bold", PlayerGroupAll());
    for (i = 0; i < 54; i += 1) {
        g_cIcon[i] = BOTC_NewButton(g_cDlg, 62, 62, 0, 0, "");
        libNtve_gf_CreateDialogItemImage(g_cDlg, 62, 62, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_cIconImg[i] = DialogControlLastCreated();
        DialogControlSetSize(g_cIconImg[i], PlayerGroupAll(), 62, 62);
        DialogControlSetPosition(g_cIconImg[i], PlayerGroupAll(), c_anchorTopLeft, 0, 0);
        libNtve_gf_SetDialogItemAcceptMouse(g_cIconImg[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_cIconImg[i], "botc_blank.dds", PlayerGroupAll());
        g_cName[i] = BOTC_NewLabelC(g_cDlg, 116, 20, 0, 0, StringToText(""));
        DialogControlSetVisible(g_cName[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cIconImg[i], PlayerGroupAll(), false);
    }
    // 左盘块下面：上一页 / 下一页 + 页码
    g_cPrevBtn = BOTC_NewButton(g_cDlg, 130, 44, 450, 1120, "上一页");
    g_cNextBtn = BOTC_NewButton(g_cDlg, 130, 44, 600, 1120, "下一页");
    g_cPageLbl = BOTC_NewLabelC(g_cDlg, 460, 26, 760, 1126, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_cPageLbl, "ModLeftSize16Bold", PlayerGroupAll());
    // 右盘块：像身份网格那样「阵营标题 + 图标（名字在图下面）」，位置在渲染时按分组动态排
    g_cSelTitle = BOTC_NewLabelC(g_cDlg, 1120, 30, 1140, 108, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_cSelTitle, "ModLeftSize16Bold", PlayerGroupAll());
    for (i = 0; i < 6; i += 1) {
        g_cGrpLbl[i] = BOTC_NewLabel(g_cDlg, 800, 30, 1140, BOTC_CustomGrpY(i), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_cGrpLbl[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_cGrpLbl[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_cGrpLbl[i], PlayerGroupAll(), true);
    }
    for (i = 0; i < 35; i += 1) {
        x = 1138 + (BOTC_CustomSlotCol(i) * 120);
        y = BOTC_CustomSlotRow(i);
        g_cSelIcon[i] = BOTC_NewButton(g_cDlg, 62, 62, x + 29, y, "");
        libNtve_gf_CreateDialogItemImage(g_cDlg, 62, 62, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_cSelIconImg[i] = DialogControlLastCreated();
        DialogControlSetSize(g_cSelIconImg[i], PlayerGroupAll(), 62, 62);
        DialogControlSetPosition(g_cSelIconImg[i], PlayerGroupAll(), c_anchorTopLeft, x + 18, y - 8);   // 【图标偏移】（用户 2026-10-04 定稿：X=18 / Y=-8）
        libNtve_gf_SetDialogItemAcceptMouse(g_cSelIconImg[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_cSelIconImg[i], "botc_blank.dds", PlayerGroupAll());
        g_cSelName[i] = BOTC_NewLabelC(g_cDlg, 116, 20, x + 2, y + 66, StringToText(""));
        DialogControlSetVisible(g_cSelIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_cSelIconImg[i], PlayerGroupAll(), false);
    }
    // 【私货商人】自定义规则输入（选中 130 时才显示；宽度按自定义面板底部可用空间）
    g_cBootLbl = BOTC_NewLabel(g_cDlg, 1500, 28, 20, 998, StringToText("【私货商人】自定义规则（游戏开始时公屏播报，并同步到角色能力表）"));
    libNtve_gf_SetDialogItemStyle(g_cBootLbl, "ModLeftSize16Bold", PlayerGroupAll());
    g_cBootEdit = BOTC_NewEdit(g_cDlg, 1500, 52, 20, 1032);
    DialogControlSetVisible(g_cBootLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_cBootEdit, PlayerGroupAll(), false);
    // 左下：清空 / 返回；右下：保存 / 选用此剧本
    g_cClearBtn = BOTC_NewButton(g_cDlg, 150, 44, 20, 1120, "清空");
    g_cBackBtn = BOTC_NewButton(g_cDlg, 170, 44, 180, 1120, "返回选板子");
    g_cSaveBtn = BOTC_NewButton(g_cDlg, 150, 48, 1760, 1116, "保存");
    g_cStartBtn = BOTC_NewButton(g_cDlg, 170, 48, 1920, 1116, "选用此剧本");
}

void BOTC_CustomShowEditor () {
    int i;
    DialogSetVisible(g_boardStartBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTabOfficial, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTabMore, PlayerGroupAll(), false);
    DialogControlSetVisible(g_seatInfoLbl, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_customSlotBtn[i], PlayerGroupAll(), true);
    }
    for (i = 0; i < 13; i += 1) {
        DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_cDlg, PlayerGroupAll(), true);
}

void BOTC_CustomOpenSlot (int slot) {
    int i;
    if (!g_boardOpen || slot < 1 || slot > 6) {
        return;
    }
    if (g_cOpen && g_customSlot == slot) {
        return;                       // 点当前槽位不重载，避免丢掉未保存改动。
    }
    g_customSlot = slot;
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = false;
    g_bankTry = 0;
    BOTC_CustomLoadBank(true);
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    BOTC_BoardStartBtnRender();
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomOpen () {
    int i;
    if (!g_boardOpen) {
        return;
    }
    g_customSlot = 0;
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;
    }
    g_bootText = "";
    g_cStormPick = false;
    g_cStormRole = 106;
    g_stormRole = 106;
    g_customBankOk = true;           // 未选槽位前不做 bank 重试。
    g_bankTry = 0;
    BOTC_BootleggerEditRefresh();
    g_cOpen = true;
    BOTC_BoardStartBtnRender();
    g_cat = 0;
    g_cpage = 0;
    BOTC_CustomShowEditor();
    BOTC_CustomRender();
}

void BOTC_CustomClose () {
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_BoardRender();             // 还原标题 / 板子 / 人数修正
}

void BOTC_CustomClear () {
    int r;
    g_cStormPick = false;
    g_bootText = "";
    g_bootSavePending = false;
    g_bootSaveSlot = 0;
    BOTC_BootleggerEditRefresh();
    for (r = 0; r <= 163; r += 1) {
        g_csel[r] = false;
    }
    BOTC_CustomRender();
    BOTC_Notice(g_teller, "自定义剧本已清空。");
}

// 点左盘块第 i 格：选中 / 取消（受各分类上限限制）
void BOTC_CustomToggle (int i) {
    int r;
    int cat;
    if (i < 0 || i > 53) {
        return;
    }
    r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
    if (r < 0) {
        return;
    }
    cat = g_roleTeam[r];
    if (g_csel[130]) { BOTC_BootleggerCapture(); }
    if (g_csel[r]) {
        g_csel[r] = false;
        BOTC_CustomRender();
        return;
    }
    if ((r == 101 && g_csel[153]) || (r == 153 && g_csel[101])) {
        BOTC_Notice(g_teller, "【相克】异端分子与狐媚娘不能同时出现在同一局中。");
        return;
    }
    if (BOTC_CatPickedAll() >= 33) {
        BOTC_Notice(g_teller, "右侧一共只能摆 33 个角色（14 镇民 + 5 外来者 + 5 爪牙 + 5 恶魔 + 2 传奇 + 2 奇遇）。");
        return;
    }
    if (BOTC_CatPicked(cat) >= BOTC_CatCap(cat)) {
        BOTC_Notice(g_teller, BOTC_CustomCatName(cat) + "最多只能选 " + IntToString(BOTC_CatCap(cat)) + " 个。");
        return;
    }
    g_csel[r] = true;
    if (r == 130) { BOTC_BootleggerEditRefresh(); }
    BOTC_CustomRender();
    // 【暴风捕手（113）】（用户 2026-10-10）：加他的时候直接进「点一个角色」模式 —— 那一个角色就是他保护的对象
    if (r == 113) {
        g_cStormPick = true;
        BOTC_Notice(g_teller, "【暴风捕手】点左边一个角色：他保护那个角色（夜间不会死，邪恶首夜得知）。");
        BOTC_CustomRender();
    }
}

// 点右盘块第 k 格 = 取消那个角色
void BOTC_CustomUnpick (int k) {
    int t;
    int r;
    int used;
    if (k < 0 || k > 34) {
        return;
    }
    // 【槽号 → 角色】（用户 2026-10-04 报「只有镇民点得掉、还会删错人」）：
    //   右边那块的排法是**按阵营分组**（镇民 0..15 / 外来者 16..20 / 爪牙 21..25 / 恶魔 26..30 /
    //   传奇 31..32 / 奇遇 33..34），每组按角色号升序填。
    //   老写法是按「全部已选角色按角色号升序数第 k 个」，跟这个排法对不上 ——
    //   只有镇民那一段碰巧吻合，别的阵营槽号早超出已选数量 → 点了没反应，偶尔还会删到别人。
    //   现在照 BOTC_CustomRender 的排法逐组扫一遍，槽号对上才删。（两组循环必须保持一致）
    for (t = 0; t < 6; t += 1) {
        used = BOTC_CustomSlotBase(t);
        for (r = 0; r <= 163; r += 1) {
            if (!g_csel[r]) {
                continue;
            }
            if (g_roleTeam[r] != t) {
                continue;
            }
            if (used >= BOTC_CustomSlotBase(t) + BOTC_CustomSlotMax(t)) {
                break;
            }
            if (used == k) {
                if (r == 130) {
                    BOTC_BootleggerCapture();
                }
                g_csel[r] = false;
                BOTC_CustomRender();
                return;
            }
            used = used + 1;
        }
    }
}

// 【存档小工具】（用户 2026-10-04）：读之前先统一问一句「这个章节里到底有几个角色」。
//   bak = false → 主档（n / r0..）； bak = true → 备份（pn / pr0..）。
//   章节名两种都会试（新名 "custom" 全 ASCII；旧名「自定义剧本」留着兼容老存档）。
int BOTC_CustomBankCount (bank bk, string sec, bool bak) {
    if (bak) {
        if (!BankKeyExists(bk, sec, "pn")) {
            return 0;
        }
        return BankValueGetAsInt(bk, sec, "pn");
    }
    if (!BankKeyExists(bk, sec, "n")) {
        return 0;
    }
    return BankValueGetAsInt(bk, sec, "n");
}

int BOTC_CustomBankApply (bank bk, string sec, bool bak) {
    int i;
    int n;
    int r;
    string k;
    g_bootText = "";
    n = BOTC_CustomBankCount(bk, sec, bak);
    if (n <= 0) {
        return 0;
    }
    if (n > 163) {
        n = 128;
    }
    for (i = 0; i < n; i += 1) {
        if (bak) {
            k = "pr" + IntToString(i);
        }
        else {
            k = "r" + IntToString(i);
        }
        if (!BankKeyExists(bk, sec, k)) {
            continue;
        }
        r = BankValueGetAsInt(bk, sec, k);
        if (r >= 0 && r <= 163 && BOTC_CustomRoleVisible(r)) {
            g_csel[r] = true;
        }
    }
    // 【暴风捕手保护的角色】（用户 2026-10-10）：老存档没有这个键 → 保持默认（异教领袖）
    if (BankKeyExists(bk, sec, "storm")) {
        r = BankValueGetAsInt(bk, sec, "storm");
        if (r >= 0 && r <= 163) {
            g_cStormRole = r;
        }
    }
    // 【私货商人规则文本】：主档 boot / 备份 pboot
    if (bak) { k = "pboot"; } else { k = "boot"; }
    if (BankKeyExists(bk, sec, k)) {
        g_bootText = BankValueGetAsString(bk, sec, k);
    }
    else {
        // 老档 / 迁移档可能只把规则写进了另一种章节名；仅在当前章节完全没有该键时兼容读取。
        if (sec == "custom" && BankKeyExists(bk, "自定义剧本", k)) {
            g_bootText = BankValueGetAsString(bk, "自定义剧本", k);
        }
        if (sec == "自定义剧本" && BankKeyExists(bk, "custom", k)) {
            g_bootText = BankValueGetAsString(bk, "custom", k);
        }
    }
    BOTC_BootleggerSyncText();
    return n;
}

// 【抓每个座位的银行句柄】（用户 2026-10-04 拿到的参考实现 —— 另一张做存档测试的图就是这么写的）：
//   ```galaxy
//   BankLoad(名字, 玩家);
//   gv_bank[玩家] = BankLastCreated();     // ← 关键：Load 完**立刻**用 BankLastCreated() 抓句柄
//   ```
//   之后读/写都用这个句柄数组（参考图是每个真人玩家都抓一份）。
//   · 这里照抄：1 号位（说书人）**一定**抓，另外每个真人座位也各抓一份（以后做"每人各存各的"直接用 `g_bank[p]`）。
//   · ⚠ 地图触发器里必须有「数据存档 - **预加载存档** "BOTCSave"」这条**声明**：
//     没有它，引擎不认这个银行文件 → `BankLastCreated()` 拿到空壳、`BankSave` 也不会真的落盘（踩过）。
//   · ⚠ 不要再用「打开数据存档」那条动作：它在地图初始化里会让**联机卡加载**（用户 2026-10-04 实测）。
void BOTC_BankInit () {
    int p;
    if (g_bankInit) {
        return;
    }
    for (p = 1; p <= 13; p += 1) {
        // 【防阻塞】（用户 2026-11-13）：`BankWait` 是阻塞等待，已经离开 / 掉线的座位
        //   存档同步可能永远不返回，会把整条脚本线程卡住（全场按钮和聊天一起无响应）
        //   → 普通座位直接跳过，等它重新进房时由 `BOTC_BankEnsure()` 补。
        //   说书人本人保持原逻辑：`BOTC_MyBank()` 直接返回 `g_bank[g_teller]`，
        //   这里跳过会让它拿到空句柄。
        if (p != g_teller && PlayerStatus(p) == 2) {
            continue;
        }
        if (p == g_teller || PlayerType(p) == 1) {          // 1 号位一定抓；其它真人座位也抓
            // 直接用 `BankLoad` 的返回值当句柄（我们实测：这样写出来的文件确实落盘了）。
            //   参考图用的是「BankLoad 之后紧跟 BankLastCreated()」，两种写法等价；
            //   但 `BankLastCreated()` 在某些上下文会拿到空句柄，所以这里用更稳的返回值。
            g_bank[p] = BankLoad("BOTCSave2", p);
            BankWait(g_bank[p]);                     // 【等待数据存档】读取是异步的，等它读完
            if (PlayerType(p) == 1) {
                g_bankOn[p] = true;                  // 空座位不算抓到，留给 BOTC_BankEnsure 补
            }
        }
    }
    // 【加载完成后才置真】（用户 2026-11-13）：中途 BankLoad 出问题时不会被当成「已加载」而永不重试。
    g_bankInit = true;
}

// 【存档兜底】（用户 2026-11-13）：`BOTC_BankInit()` 只在脚本启动那一刻给当时的真人座位抓句柄，
//   之后 `g_bankInit` 永远为真，不会再补。若某个座位开局是空的、之后才有人坐下（或那一次加载失败），
//   该座位的 `g_bank[p]` 就是空句柄，结算写入会静默丢数据。
//   这里只在真正要写盘前对单个座位补一次 BankLoad + BankWait；平时（句柄已抓到）直接返回，不碰网络。
void BOTC_BankEnsure (int p) {
    BOTC_BankInit();
    if (p < 1 || p > 13) {
        return;
    }
    if (g_bankOn[p]) {
        return;
    }
    if (PlayerType(p) != 1) {
        return;
    }
    // 【防阻塞】（用户 2026-11-13）：已经离开 / 掉线的座位不再补读档。
    //   `BankWait` 没有超时参数，掉线玩家的同步不返回就会卡死整条脚本线程；
    //   这类座位本来也不该再写统计（结算路径已经在 `PlayerStatus == 2` 时跳过）。
    if (PlayerStatus(p) == 2) {
        return;
    }
    g_bank[p] = BankLoad("BOTCSave2", p);
    BankWait(g_bank[p]);
    g_bankOn[p] = true;
}

// 【取「当前说书人的账号」银行】（用户 2026-10-20）：换座位后必须读取新说书人自己的 bank。
//   `g_teller` 是物理玩家号；`BOTC_BankInit()` 开局已经给每个真人座位加载过 `g_bank[p]`，
//   所以这里不需要再 BankLoad，也绝对不能用 0 冒充「本机玩家」。
//   【为什么叫 BOTCSave2】（用户 2026-10-04）：老的 `BOTCSave` 那份文件里带着**中文章节名**（自定义剧本），
//   而参考图（另一张联机能正常跑起来的测试图）的存档是**纯 ASCII**。怀疑联机同步时卡在中文名上，
//   所以换一个全新的纯 ASCII 名字重开一份干净的存档（老文件不动，数据已经搬过去了）。
bank BOTC_MyBank () {
    BOTC_BankInit();
    if (g_teller >= 1 && g_teller <= 13) {
        return g_bank[g_teller];
    }
    return g_bank[1];
}

// 【场次统计】bank 章节 = "stats"；键前缀 t/g/e/s + 物理玩家号。
//   t = 总场次；g = 善良场次；e = 邪恶场次；s = 说书人场次。
int BOTC_StatsGet (bank bk, int pid, string pre) {
    string k;
    if (pid < 1 || pid > 13) {
        return 0;
    }
    k = pre + IntToString(pid);
    if (!BankKeyExists(bk, "stats", k)) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", k);
}

int BOTC_StatsBankTotal (bank bk) {
    int pid;
    int n;
    n = 0;
    if (BankKeyExists(bk, "stats", "t")) {
        n = n + BankValueGetAsInt(bk, "stats", "t");
        if (BankKeyExists(bk, "stats", "g")) { n = n + BankValueGetAsInt(bk, "stats", "g"); }
        if (BankKeyExists(bk, "stats", "e")) { n = n + BankValueGetAsInt(bk, "stats", "e"); }
        if (BankKeyExists(bk, "stats", "s")) { n = n + BankValueGetAsInt(bk, "stats", "s"); }
        return n;
    }
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, "t");
        n = n + BOTC_StatsGet(bk, pid, "g");
        n = n + BOTC_StatsGet(bk, pid, "e");
        n = n + BOTC_StatsGet(bk, pid, "s");
    }
    return n;
}

// 【账号级累计】（用户 2026-10-26）：键不再带物理玩家号，直接使用 t/g/e/s。
//   同一个人这次坐玩家 1、下次坐玩家 5，仍然累计到同一个账号总场次。
//   旧档的 t1..t13 / g1..g13 / e1..e13 / s1..s13 在首次读取时求和迁移。
int BOTC_StatsOwnGet (bank bk, string pre) {
    int pid;
    int n;
    if (BankKeyExists(bk, "stats", pre)) {
        return BankValueGetAsInt(bk, "stats", pre);
    }
    n = 0;
    for (pid = 1; pid <= 13; pid += 1) {
        n = n + BOTC_StatsGet(bk, pid, pre);
    }
    return n;
}

void BOTC_StatsOwnBump (bank bk, string pre) {
    int v;
    v = BOTC_StatsOwnGet(bk, pre);
    BankValueSetFromInt(bk, "stats", pre, v + 1);
}

// 【声望值】（用户 2026-11-03）：结算时每名玩家给说书人打分，按分数累计进
//   说书人账号 bank 的 stats/rep：1 分 -5、2 分 +0、3 分 +5、4 分 +10、5 分 +15，最低 0。
int BOTC_TellerRepGet (bank bk) {
    if (!BankKeyExists(bk, "stats", "rep")) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", "rep");
}

// 【决赛圈声望】（用户 2026-11-05）：进入白天后场上只剩 4 / 3 人时给说书人 +50 声望。
//   只在开局缓存上累加并保存；不再结算时重新读档（避免掉线同步卡住全场）。
void BOTC_TellerRepAdd (int add) {
    bank bk;
    int pid;
    int rep;
    pid = g_teller;
    if (pid < 1 || pid > 13 || PlayerType(pid) != 1 || PlayerStatus(pid) == 2) {
        return;
    }
    // 【缓存优先 · 不阻塞读档】（用户 2026-11-11）：决赛圈声望只在开局缓存上累加，
    //   BankInit 之后是空操作；结算时不再 BankLoad + BankWait，掉线同步也不会卡住全场。
    //   声望照常写回并 BankSave，下一次进图刷新时生效。
    // 【兜底补加载】（用户 2026-11-13）：说书人座位开局是空的话句柄没抓到，写之前补一次。
    BOTC_BankEnsure(pid);
    bk = g_bank[pid];
    rep = BOTC_TellerRepGet(bk) + add;
    if (rep < 0) {
        rep = 0;
    }
    BankValueSetFromInt(bk, "stats", "rep", rep);
    BankSave(bk);
}

int BOTC_RepDelta (int v) {
    if (v <= 1) {
        return -5;
    }
    if (v == 2) {
        return 0;
    }
    if (v == 3) {
        return 5;
    }
    if (v == 4) {
        return 10;
    }
    return 15;
}

// 【积分】（用户 2026-11-06）：每名玩家的账号积分累计在 stats/pt。
//   正常完成一局：胜方阵营 +100、败方阵营 +50（见 BOTC_StatsRecord）。
//   说书人按每名玩家打的分累计：1/2/3/4/5 星 = +10/+15/+20/+25/+30，每名玩家一局只计一次。
int BOTC_StatsPointGet (bank bk) {
    if (!BankKeyExists(bk, "stats", "pt")) {
        return 0;
    }
    return BankValueGetAsInt(bk, "stats", "pt");
}

void BOTC_StatsPointAdd (bank bk, int add) {
    BankValueSetFromInt(bk, "stats", "pt", BOTC_StatsPointGet(bk) + add);
}

int BOTC_RatePointDelta (int v) {
    if (v <= 1) {
        return 10;
    }
    if (v == 2) {
        return 15;
    }
    if (v == 3) {
        return 20;
    }
    if (v == 4) {
        return 25;
    }
    return 30;
}

// 【说书人称号】（用户 2026-11-03）：按声望值与说书人场次判定，从高到低优先取最高等级。
string BOTC_TellerTitleBy (int s, int rep) {
    if (rep >= 20000 && s >= 1000) { return "首席说书人"; }
    if (rep >= 12000 && s >= 800) { return "宗师说书人"; }
    if (rep >= 8000 && s >= 500) { return "大师说书人"; }
    if (rep >= 5000 && s >= 300) { return "精英说书人"; }
    if (rep >= 3000 && s >= 200) { return "卓越说书人"; }
    if (rep >= 1000 && s >= 100) { return "资深说书人"; }
    if (rep >= 300 && s >= 30) { return "熟练说书人"; }
    if (rep >= 100 && s >= 10) { return "进阶说书人"; }
    if (rep >= 0 && s >= 3) { return "新锐说书人"; }
    return "见习说书人";
}

string BOTC_TellerTitle () {
    int pid;
    BOTC_BankInit();
    pid = g_who[1];
    if (pid < 1 || pid > 13) {
        return "见习说书人";
    }
    return BOTC_TellerTitleBy(BOTC_StatsOwnGet(g_bank[pid], "s"), BOTC_TellerRepGet(g_bank[pid]));
}

void BOTC_StatsRecord (int winSide) {
    bank bk;
    int q;
    int pid;
    int al;
    // 【只在结算时累计一次】（用户 2026-11-04）：总场次 +1 只在胜负封盘时发生；
    //   同一次结算重复进入直接跳过，避免同一局被记两次。
    if (!g_gameOver || g_statsDone) {
        return;
    }
    g_statsDone = true;
    // 【场次统计按玩家自己的 bank 保存】（用户 2026-10-20）：
    //   以前统一写当前说书人的 bank，导致「只有自己换到说书人座位时才会累计」。
    //   现在每名真人只把自己的场次写进 `g_bank[物理玩家号]`，统计页也逐人读取自己的 bank。
    BOTC_BankInit();
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        pid = g_who[q];
        if (pid < 1 || pid > 13 || PlayerType(pid) != 1) {
            continue;
        }
        // 【中途退出的人不再写统计】（用户 2026-11-01）：他的座位会因为保留而仍在座位表里，
        //   但玩家已经离开、bank 句柄不可靠，跳过，避免读到空档或写坏存档。
        if (PlayerStatus(pid) == 2) {
            continue;
        }
        // 【缓存优先】（用户 2026-11-11）：只在开局缓存上累加，结算时不再 BankLoad + BankWait；
        //   有玩家掉线 / Battle.net 同步没返回时不会把整条脚本线程卡住。
        // 【兜底补加载】（用户 2026-11-13）：这个座位开局时可能还是空的，句柄没抓到 → 写之前补一次。
        BOTC_BankEnsure(pid);
        bk = g_bank[pid];
        al = BOTC_SeatAlign(q);
        BOTC_StatsOwnBump(bk, "t");
        if (al == 0) {
            BOTC_StatsOwnBump(bk, "g");
            BankValueSetFromInt(bk, "stats", "la", 0);   // 上一场阵营（随机发牌换边用）
        }
        else {
            BOTC_StatsOwnBump(bk, "e");
            BankValueSetFromInt(bk, "stats", "la", 1);   // 上一场阵营（随机发牌换边用）
        }
        // 【积分】（用户 2026-11-06）：正常结算一局，胜方阵营 +100、败方阵营 +50。
        // 【说书人胜】（用户 2026-11-12）：无神论者对局中途转为邪恶阵营的玩家，跟说书人一起算胜方。
        if (al == winSide || (winSide == 2 && al == 1)) {
            BOTC_StatsPointAdd(bk, 100);
        }
        else {
            BOTC_StatsPointAdd(bk, 50);
        }
        // 【延后保存】（用户 2026-11-11）：结算这一拍不写盘，交给后续心跳逐人 BankSave，
        //   避免 13 个人同时落盘造成卡顿；数据已经在内存缓存里，发牌 / 统计页读到的都是最新值。
        g_statSavePend[pid] = true;
    }
    // 说书人：座位 1 当前坐的那个人；只写他自己的 bank。
    pid = g_who[1];
    if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1 && PlayerStatus(pid) != 2) {
        BOTC_BankEnsure(pid);                            // 【兜底补加载】说书人座位开局可能是空的
        bk = g_bank[pid];
        BOTC_StatsOwnBump(bk, "t");
        BOTC_StatsOwnBump(bk, "s");
        BankValueSetFromInt(bk, "stats", "la", 0);       // 说书人不算邪恶，下一局按善良处理
        g_statSavePend[pid] = true;                      // 【延后保存】与玩家一样交给心跳写盘
    }
    BOTC_PmStore(g_teller, "【场次统计】本局已按每名玩家的本地 bank 记录。");
}

// 【延后保存 · 心跳分批】（用户 2026-11-11）：每拍最多给 2 个账号 BankSave，
//   把结算瞬间的连续落盘摊开；数据只在内存里，不涉及 BankWait，掉线不会卡住脚本线程。
void BOTC_StatsSaveTick () {
    int p;
    int n;
    n = 0;
    for (p = 1; p <= 13; p += 1) {
        if (!g_statSavePend[p]) {
            continue;
        }
        if (PlayerType(p) != 1) {
            g_statSavePend[p] = false;
            continue;
        }
        BankSave(g_bank[p]);
        g_statSavePend[p] = false;
        n = n + 1;
        // 【每拍 4 个】（用户 2026-11-13）：原来 2 个，13 人要约 3.5 秒才写完；
        //   提到 4 个后约 2 秒写完，仍然避免 13 个人同一拍同时落盘。
        if (n >= 4) {
            return;
        }
    }
}

// 【延后保存 · 全部落盘】（用户 2026-11-11）：重新开始前把还没写盘的账号一次写完，避免漏存。
void BOTC_StatsSaveFlush () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (!g_statSavePend[p]) {
            continue;
        }
        g_statSavePend[p] = false;
        if (PlayerType(p) != 1) {
            continue;
        }
        BankSave(g_bank[p]);
    }
}

// 【局内场次统计 · 开局快照】（用户 2026-11-11）：整局只读这一份，本局的声望变化 /
//   结算写入都不会让页面上的数字跳变；【每局刷新】（用户 2026-11-13）：换局时由
//   BOTC_ResetGameVars() 清标记，下一局 BOTC_GameStartGo() 再重取一次。
void BOTC_StatsSnapTake () {
    int pid;
    bank bk;
    BOTC_BankInit();
    for (pid = 1; pid <= 13; pid += 1) {
        g_statSnapT[pid] = 0;
        g_statSnapG[pid] = 0;
        g_statSnapE[pid] = 0;
        g_statSnapS[pid] = 0;
        g_statSnapPt[pid] = 0;
        g_statSnapRs[pid] = 0;
        g_statSnapRc[pid] = 0;
        g_statSnapRep[pid] = 0;
        if (PlayerType(pid) != 1) {
            continue;
        }
        // 【兜底补加载】（用户 2026-11-13）：开局还是空座位、之后才坐人的，句柄没抓到 → 读之前补一次，
        //   否则这次快照会把他的场次 / 声望全读成 0。
        BOTC_BankEnsure(pid);
        bk = g_bank[pid];
        g_statSnapT[pid] = BOTC_StatsOwnGet(bk, "t");
        g_statSnapG[pid] = BOTC_StatsOwnGet(bk, "g");
        g_statSnapE[pid] = BOTC_StatsOwnGet(bk, "e");
        g_statSnapS[pid] = BOTC_StatsOwnGet(bk, "s");
        g_statSnapPt[pid] = BOTC_StatsPointGet(bk);
        if (BankKeyExists(bk, "stats", "rs")) {
            g_statSnapRs[pid] = BankValueGetAsInt(bk, "stats", "rs");
        }
        if (BankKeyExists(bk, "stats", "rc")) {
            g_statSnapRc[pid] = BankValueGetAsInt(bk, "stats", "rc");
        }
        g_statSnapRep[pid] = BOTC_TellerRepGet(bk);
    }
    g_statSnapOk = true;
}

void BOTC_StatsRender (int p) {
    int pid;
    int avg10;
    int i;
    int j;
    int cur;
    int[14] stT;
    int[14] stG;
    int[14] stE;
    int[14] stS;
    int[14] stPt;
    int[14] stRs;
    int[14] stRc;
    int[14] stRep;
    int[14] stIdx;
    text line;
    text rowName;
    // 【只读开局快照】（用户 2026-11-11）：不再每次打开统计页都重新读档。
    if (!g_statSnapOk) {
        BOTC_StatsSnapTake();          // 极早期兜底：开局播报还没跑过时先取一次
    }
    DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
    libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("场次统计"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
    // 【局内统计只读开局缓存】（用户 2026-11-11）：不再在这里逐人重新读档。
    //   场次 / 平均分 / 声望 / 积分在本局内固定为开局 BOTC_AnnounceGameCounts() 读到的值，
    //   不会因为本局中途保存、掉线同步而跳变；下一局重新开局 / 重进地图时才刷新。
    //   决赛圈声望（BOTC_TellerRepAdd）和结算存档（BOTC_StatsRecord）仍按原逻辑正常读档、保存。
    // 【先收集再排序】（用户 2026-11-06）：统计页从上往下按总场次从高到低排列。
    //   每个查看者显示自己账号的总计；其他玩家仍显示各自 bank 里的账号总计。
    for (pid = 1; pid <= 13; pid += 1) {
        stT[pid] = 0;
        stG[pid] = 0;
        stE[pid] = 0;
        stS[pid] = 0;
        stPt[pid] = 0;
        stRs[pid] = 0;
        stRc[pid] = 0;
        stRep[pid] = 0;
        stIdx[pid] = pid;
        if (PlayerType(pid) != 1) {
            continue;                      // 空座位 / 电脑仍占一行（全 0），排到列表末尾
        }
        // 【整局不变】（用户 2026-11-11）：只读开局快照，不再读 bank、也不再重新读档。
        stT[pid] = g_statSnapT[pid];
        stG[pid] = g_statSnapG[pid];
        stE[pid] = g_statSnapE[pid];
        stS[pid] = g_statSnapS[pid];
        stPt[pid] = g_statSnapPt[pid];
        stRs[pid] = g_statSnapRs[pid];
        stRc[pid] = g_statSnapRc[pid];
        stRep[pid] = g_statSnapRep[pid];
    }
    // 插入排序：总场次从高到低；场次相同按玩家号从小到大（稳定）。
    for (i = 2; i <= 13; i += 1) {
        cur = stIdx[i];
        j = i - 1;
        while (j >= 1 && stT[stIdx[j]] < stT[cur]) {
            stIdx[j + 1] = stIdx[j];
            j = j - 1;
        }
        stIdx[j + 1] = cur;
    }
    for (i = 1; i <= 13; i += 1) {
        pid = stIdx[i];
        // 【玩家 ID + 大厅自选色】（用户 2026-10-20）：不写「玩家N」，直接用实际玩家名。
        //   【随机名字】（用户 2026-11-11）：场数统计是账号数据，始终显示星际战网名。
        rowName = TextWithColor(PlayerName(pid), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(pid, false)));
        line = rowName;
        line = line + StringToText("    ");
        line = line + TextWithColor(StringToText("总场次 " + IntToString(stT[pid])), Color(0, 255, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("善良 " + IntToString(stG[pid])), Color(0, 191, 255));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("邪恶 " + IntToString(stE[pid])), Color(255, 0, 0));
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("说书人 " + IntToString(stS[pid])), Color(255, 215, 0));
        // 【说书人场数为 0 时不显示平均分与声望】（用户 2026-11-10）：即使平均分 / 声望有值也隐藏。
        if (stS[pid] > 0 && stRc[pid] > 0) {
            avg10 = ((stRs[pid] * 10) + (stRc[pid] / 2)) / stRc[pid];
            line = line + StringToText("        ");
            line = line + TextWithColor(StringToText("平均分 " + IntToString(avg10 / 10) + "." + IntToString(avg10 - ((avg10 / 10) * 10)) + "（" + IntToString(stRc[pid]) + " 次）"), Color(255, 150, 0));
            line = line + StringToText("        ");
            line = line + TextWithColor(StringToText("声望 " + IntToString(stRep[pid])), Color(200, 180, 255));
        }
        // 【积分】（用户 2026-11-10）：积分改到最末位，放在声望之后。
        line = line + StringToText("        ");
        line = line + TextWithColor(StringToText("积分 " + IntToString(stPt[pid])), Color(255, 255, 160));
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), line);
        // 每名玩家之间多留一行空白。
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("    "));
    }
}

string BOTC_CustomSection (int slot) {
    if (slot == 1) {
        return "custom";                 // 槽位 1 兼容旧版单槽存档。
    }
    return "custom" + IntToString(slot);
}

void BOTC_CustomSaveBootOnly (int slot, string s) {
    bank bk;
    string sec;
    if (slot < 1 || slot > 6) {
        return;
    }
    bk = BOTC_MyBank();
    sec = BOTC_CustomSection(slot);
    BankValueSetFromString(bk, sec, "boot", s);
    BankSave(bk);
}

// 【保存】把当前槽位写进 bank（BOTCSave.SC2Bank —— 名字里别带下划线）。
void BOTC_CustomSaveBank () {
    bank bk;
    int r;
    int n;
    int whoBak;
    int oldN;
    int i;
    string k;
    string k2;
    string sec;
    // 【bank 名去下划线】（用户 2026-10-04 实测）：磁盘上那份文件叫 `BOTCSave.SC2Bank`（下划线没了），
    //   而诊断显示「同一个 bank 对象写→读是好的、却看不到文件里已有的 n」→ 说明**写的时候去掉下划线、读的时候按原名找**。
    //   干脆名字里不带下划线，读写就一定是同一个文件。
    // 【保存时重新取一次当前说书人的 bank】（用户 2026-10-20）：
    //   不缓存旧说书人的句柄，避免换座位后写回旧账号。
    bk = BOTC_MyBank();              // 当前谁当说书人，就写谁自己的 bank
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再保存。");
        return;
    }
    sec = BOTC_CustomSection(g_customSlot);
    BOTC_BootleggerCapture();
    BOTC_BootleggerSyncText();
    // 保存前把当前槽位的主档复制成一层备份：pn / pr0.. / pboot。
    if (BankKeyExists(bk, sec, "boot")) {
        BankValueSetFromString(bk, sec, "pboot", BankValueGetAsString(bk, sec, "boot"));
    }
    oldN = BOTC_CustomBankCount(bk, sec, false);
    if (oldN > 0) {
        if (oldN > 163) {
            oldN = 128;
        }
        for (i = 0; i < oldN; i += 1) {
            k = "r" + IntToString(i);
            if (!BankKeyExists(bk, sec, k)) {
                continue;
            }
            k2 = "pr" + IntToString(i);
            BankValueSetFromInt(bk, sec, k2, BankValueGetAsInt(bk, sec, k));
        }
        BankValueSetFromInt(bk, sec, "pn", oldN);
    }
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        k = "r" + IntToString(n);
        BankValueSetFromInt(bk, sec, k, r);
        n = n + 1;
    }
    BankValueSetFromInt(bk, sec, "n", n);
    // 【暴风捕手保护的角色】（用户 2026-10-10）：跟板子一起存
    BankValueSetFromInt(bk, sec, "storm", g_cStormRole);
    BankValueSetFromString(bk, sec, "boot", g_bootText);
    BankSave(bk);
    g_customBankOk = true;          // 这一局已经有存档了，不用再重试读档
    // 【保存反馈】（用户 2026-10-04）：私聊那边显示绿字「保存成功」；另给说书人一条提示条 + 明细行。
    //   日志里带上「当前说书人的 bank」是因为换座位后 bank 会跟着当前说书人的账号走。
    //   ⚠ 绿字靠的是 BOTC_LineText 里「who == 0 的系统行才走 BOTC_KeyColor」这条 ——
    //     点按钮时不一定是 0（会跟着上一次聊天残留），所以这里**强制按系统行存**这一句。
    whoBak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_PmStore(g_teller, "保存成功");
    g_chatWhoNow = whoBak;
    if (g_csel[130]) {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色，私货商人规则已一并保存。");
    }
    else {
        BOTC_Notice(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已存入 bank：共 " + IntToString(n) + " 个角色。");
    }
}

// 【打开面板时自动读档】没存过就保持空白
//   【读档要看对地方】（用户 2026-10-04 报「联机存了、重进右边一个角色都没有」）：
//   `BankLoad(名字, 玩家号)` 的 bank 是**按那个玩家的账号**存的 ——
//     · 联机（真人对局）：`Documents\StarCraft II\Accounts\<账号>\<角色>\Banks\<地图>\BOTCSave.SC2Bank`
//     · 编辑器 / 离线测试：`Documents\StarCraft II\Banks\BOTCSave.SC2Bank`
//   两边是不同文件；bank 跟着账号走，不跟着逻辑座位格走。
//   【换说书人】（用户 2026-10-20）：主读 `g_bank[g_teller]`，换座位后自动跟随新说书人的账号。
//   `BOTC_BankInit()` 只给真人座位各加载一次；这里不额外扫描 2~13，避免线上重复走网络。
//   当前说书人的 bank 为空时，才回退玩家 1 的旧 bank 做一次性迁移。
void BOTC_CustomLoadBank (bool talk) {
    bank bk;
    int i;
    int n;
    int sp;
    bool got;
    bool sawEmpty;
    bool useBak;
    string sec;
    string secMain;
    got = false;
    sawEmpty = false;
    useBak = false;
    sp = 0;
    n = 0;
    if (g_customSlot < 1 || g_customSlot > 6) {
        return;
    }
    secMain = BOTC_CustomSection(g_customSlot);
    sec = secMain;
    // 【先读当前说书人的账号，再回退玩家 1 的旧档】(用户 2026-10-20)：
    //   · 主份 = `g_bank[g_teller]`，换说书人后自动跟随新说书人，不再固定玩家 1。
    //   · 新说书人的 bank 里没有配置时，才读玩家 1 的旧 bank 做迁移；保存仍写回新说书人自己的 bank。
    //   · 开局 BankInit 已给每个真人座位加载过 bank，这里不额外扫描 2~13，避免联机反复走网络。
    //   · 章节名先用新的全 ASCII "custom"，再退回旧名「自定义剧本」（老存档是旧名）。
    //   · 主档空时用备份（pn / pr0..）自动恢复。
    //   · talk = false（定时重试那一路）：没读到就**静默返回**，而且**不动 g_csel**，
    //     免得把说书人手动选的东西冲掉；只有真读到了才清空再套用。
    for (i = 1; i <= 2; i += 1) {
        if (i == 1) {
            bk = BOTC_MyBank();          // 当前说书人的 bank（g_bank[g_teller]）
        }
        else {
            if (g_teller == 1) {
                break;                   // 本来就是玩家 1：没有旧主档可回退
            }
            bk = g_bank[1];              // 玩家 1 的老存档：只用于首次迁移
        }
        n = BOTC_CustomBankCount(bk, secMain, false);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = false;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", false);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = false;
                sec = "自定义剧本";
                break;
            }
        }
        if (BankKeyExists(bk, secMain, "n") || (g_customSlot == 1 && BankKeyExists(bk, "自定义剧本", "n"))) {
            sawEmpty = true;                 // 存过，但是 0 个角色（上次大概存了空面板）
        }
        n = BOTC_CustomBankCount(bk, secMain, true);
        if (n > 0) {
            got = true;
            sp = i;
            useBak = true;
            sec = secMain;
            break;
        }
        if (g_customSlot == 1) {
            n = BOTC_CustomBankCount(bk, "自定义剧本", true);
            if (n > 0) {
                got = true;
                sp = i;
                useBak = true;
                sec = "自定义剧本";
                break;
            }
        }
    }
    if (!got) {
        g_customBankOk = false;
        if (!talk) {
            return;                          // 定时重试：没读到就静默走人，等下一拍再试
        }
        if (sawEmpty) {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】存档是空的（0 个角色）→ 面板留空。");
        }
        else {
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】没找到存档 → 这次是空面板。");
        }
        return;
    }
    g_customBankOk = true;
    if (sp == 2) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】当前说书人的 bank 没有配置 → 已临时读取玩家 1 的旧存档；下次保存会写入当前说书人的 bank。");
    }
    if (n > 163) {
        n = 128;
    }
    for (i = 0; i <= 163; i += 1) {
        g_csel[i] = false;                   // 真读到了才清空 + 套用
    }
    BOTC_CustomBankApply(bk, sec, useBak);
    if (useBak) {
        BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】主存档是空的 → 已用上一份备份恢复：" + IntToString(n) + " 个角色。");
    }
    else {
            // 【存档·诊断】那两条调试提示已删（用户 2026-10-07）：只留下面这一行。
            BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已读回存档：" + IntToString(n) + " 个角色。");
    }
}

// 【选用此剧本】把选好的角色写成第 7 张板子，然后回到选板页打钩
void BOTC_CustomStart () {
    int r;
    int n;
    int lg;
    if (g_customSlot < 1 || g_customSlot > 6) {
        BOTC_Notice(g_teller, "先在自定义编辑器底部选择槽位 1..6，再开始游戏。");
        return;
    }
    if (BOTC_CatPicked(3) < 1) {
        BOTC_Notice(g_teller, "自定义剧本里至少要有一个恶魔。");
        return;
    }
    if (g_csel[101] && g_csel[153]) {
        BOTC_Notice(g_teller, "【相克】异端分子与狐媚娘不能同时出场，删除其中一个后再开始。");
        return;
    }
    // 【点【开始游戏】= 顺手把这份配置也存进 bank】（用户 2026-10-04：他点的是【开始游戏】没点【保存】，
    //   结果下一局面板里没存档可读）—— 配置合法就先存一份，再开局。省得"配置好了却没存上"。
    BOTC_CustomSaveBank();
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] == 4 || g_roleTeam[r] == 5) {
            continue;                    // 传奇 / 奇遇不算板子角色，走 g_boardLegacy
        }
        if (n >= 128) {
            break;
        }
        g_boardRole[(7 * 256) + n] = r;
        n = n + 1;
    }
    if (n < 3) {
        BOTC_Notice(g_teller, "自定义剧本至少要有 3 个角色才能开局。");
        return;
    }
    g_boardRoleN[7] = n;
    lg = 0;
    // 【只收真正是「传奇 / 奇遇」的角色】（用户 2026-10-10 报「提线木偶 / 痢蛭 跑到传奇角色页里」）：
    //   原来扫 88..113 只看「选没选中」---- 那个区间里混着 93 提线木偶（爪牙）/ 100 痢蛭（恶魔）这些，
    //   一选中就把它们也塞进传奇列表了。改成**按阵营过滤**（4 传奇 / 5 奇遇），跟上面板子角色那段同一个口径。
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r]) { continue; }
        if (g_roleTeam[r] != 4 && g_roleTeam[r] != 5) { continue; }
        if (lg >= 4) { break; }
        g_boardLegacy[(7 * 4) + lg] = r;
        lg = lg + 1;
    }
    g_boardLegacyN[7] = lg;
    // 【自定义剧本 → 本局用他自己选的暴风捕手保护对象】（用户 2026-10-10）
    if (g_cStormRole < 0 || g_cStormRole > 163) {
        g_cStormRole = 106;
    }
    g_stormRole = g_cStormRole;
    g_cStormPick = false;
    g_cOpen = false;
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【自定义板 " + IntToString(g_customSlot) + "】已选用：共 " + IntToString(n) + " 个角色（传奇角色 " + IntToString(lg) + " 个）。");
    BOTC_BoardSelect(7);
}

// 【自定义剧本】那一层收到的所有点击（吃掉 = 返回 true）
bool BOTC_CustomClick (int p, int c) {
    int i;
    int r;
    if (!g_cOpen) {
        return false;
    }
    if (p != g_teller) {
        return true;                 // 面板开着的时候只有说书人能操作
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_customSlotBtn[i]) {
            BOTC_CustomOpenSlot(i + 1);
            return true;
        }
    }
    for (i = 0; i < 6; i += 1) {
        if (c == g_cCatBtn[i]) {
            g_cat = i;
            g_cpage = 0;
            BOTC_CustomRender();
            return true;
        }
    }
    for (i = 0; i < 54; i += 1) {
        if (c == g_cIcon[i]) {
            // 【暴风捕手选保护对象】（用户 2026-10-10）：这一模式下点图标 = 指定保护角色，**不改**这个角色选没选中
            if (g_cStormPick) {
                r = BOTC_CatRoleAt(g_cat, (g_cpage * 54) + i);
                if (r >= 0) {
                    g_cStormRole = r;
                    g_stormRole = r;
                    g_cStormPick = false;
                    BOTC_PmStore(g_teller, "【暴风捕手】保护的角色：" + g_roleName[r] + "。");
                    BOTC_Notice(g_teller, "【暴风捕手】保护的角色已设为：" + g_roleName[r] + "。");
                    BOTC_CustomRender();
                }
                return true;
            }
            BOTC_CustomToggle(i);
            return true;
        }
    }
    for (i = 0; i < 35; i += 1) {
        if (c == g_cSelIcon[i]) {
            BOTC_CustomUnpick(i);
            return true;
        }
    }
    if (c == g_cPrevBtn) {
        g_cpage = g_cpage - 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cNextBtn) {
        g_cpage = g_cpage + 1;
        BOTC_CustomRender();
        return true;
    }
    if (c == g_cClearBtn) {
        BOTC_CustomClear();
        return true;
    }
    if (c == g_cBackBtn) {
        BOTC_CustomClose();
        return true;
    }
    if (c == g_cSaveBtn) {
        BOTC_CustomSaveBank();
        if (g_csel[130] && g_customSlot >= 1 && g_customSlot <= 6) {
            g_bootSavePending = true;
            g_bootSaveSlot = g_customSlot;
        }
        return true;
    }
    if (c == g_cStartBtn) {
        BOTC_CustomStart();
        return true;
    }
    return true;
}

bool BOTC_BoardTimer_Func (bool testConds, bool runActions) {
    if (!g_boardOpen) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    BOTC_BoardTimeout();
    return true;
}

//--------------------------------------------------------------------------------------------------
// 本局设置投票（用户 2026-09-17）
//   智能说书模式下，选板子页面右边多出一块：私聊时间 / 公聊时间 / 提名时间 / 第一天开不开邪恶小窗
//   · 每位玩家（2..13）每一项都能投一票，再点一次同一项 = 取消那一票
//   · 选板子结束那一刻结算（BOTC_BvApply）：票多的赢；平票取「离默认值最近」的，再平取小的
//   · 没人投的那一项 = 用默认值（私聊 3 分钟 / 公聊 3 分钟 / 提名 20 秒 / 不开小窗）
//--------------------------------------------------------------------------------------------------
void BOTC_BvReset () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        g_bvPm[i] = 0;
        g_bvPub[i] = 0;
        g_bvNom[i] = 0;
        g_bvEvil[i] = 0;
    }
    g_setPmMin = 3;                // 私聊 3 分钟（0 = 换成自由发言）
    g_setPubMin = 3;               // 公聊 3 分钟
    g_setNomSec = 30;              // 提名阶段的自由提名时间 30 秒（用户 2026-09-19 要求，原来 20）
    g_setEvilDay1 = false;         // 第一天不开邪恶小窗
}

// 某一项、某个选项拿了几票（kind：0 私聊 / 1 公聊 / 2 提名 / 3 小窗）
int BOTC_BvCount (int kind, int val) {
    int k;
    int n;
    n = 0;
    for (k = 2; k <= 13; k += 1) {
        if (kind == 0) {
            if (g_bvPm[k] == val) {
                n = n + 1;
            }
        }
        else {
            if (kind == 1) {
                if (g_bvPub[k] == val) {
                    n = n + 1;
                }
            }
            else {
                if (kind == 2) {
                    if (g_bvNom[k] == val) {
                        n = n + 1;
                    }
                }
                else {
                    if (g_bvEvil[k] == val) {
                        n = n + 1;
                    }
                }
            }
        }
    }
    return n;
}

// 某一项谁赢：票多的赢；平票取离默认值（def）最近的，再平取小的；一票都没有 = 默认值本身
int BOTC_BvWinner (int kind, int cnt, int def) {
    int v;
    int n;
    int d;
    int best;
    int bestN;
    int bestD;
    best = def;
    bestN = 0;
    bestD = 0;
    for (v = 1; v <= cnt; v += 1) {
        n = BOTC_BvCount(kind, v);
        if (v >= def) {
            d = v - def;
        }
        else {
            d = def - v;
        }
        if (n > bestN) {
            best = v;
            bestN = n;
            bestD = d;
        }
        else {
            if (n == bestN) {
                if (d < bestD) {
                    best = v;
                    bestD = d;
                }
            }
        }
    }
    return best;
}

// 选项的短名字（显示「你已选」用）
string BOTC_BvStr (int kind, int v) {
    if (kind == 0) {
        if (v == 0) {
            return "未选";
        }
        if (v == 5) {
            return "自由";
        }
        return IntToString(v) + "分";
    }
    if (kind == 1) {
        if (v == 0) {
            return "未选";
        }
        return IntToString(v) + "分";
    }
    if (kind == 2) {
        if (v == 0) {
            return "未选";
        }
        if (v == 1) {
            return "10秒";
        }
        if (v == 3) {
            return "30秒";
        }
        return "20秒";
    }
    if (v == 0) {
        return "未投";
    }
    if (v == 1) {
        return "要";
    }
    return "不要";
}

// 刷新右边那一块：票数 + 每个人自己的「你已选」
void BOTC_BvRender () {
    int k;
    string s;
    string mine;
    if (g_bvTitle == 0) {
        return;
    }
    // 只有智能说书模式才显示（手动说书由说书人自己控场，不需要投票）
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvPmBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvPubBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 3; k += 1) {
        DialogControlSetVisible(g_bvNomBtn[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 4; k += 1) {
        DialogControlSetVisible(g_bvHead[k], PlayerGroupAll(), false);
    }
    for (k = 0; k < 5; k += 1) {
        DialogControlSetVisible(g_bvLine[k], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_bvEvilBtn, PlayerGroupAll(), (false));
    // 邪恶小窗功能关掉时：这一项的小标题、结果行、选项按钮全都不给看（用户 2026-09-19「开局投票也不用投了」）
    DialogControlSetVisible(g_bvHead[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvLine[3], PlayerGroupAll(), (false));
    DialogControlSetVisible(g_bvTitle, PlayerGroupAll(), false);
    return;
    s = "私聊：1分" + IntToString(BOTC_BvCount(0, 1)) + "  2分" + IntToString(BOTC_BvCount(0, 2)) + "  3分" + IntToString(BOTC_BvCount(0, 3)) + "  4分" + IntToString(BOTC_BvCount(0, 4)) + "  自由" + IntToString(BOTC_BvCount(0, 5));
    libNtve_gf_SetDialogItemText(g_bvLine[0], StringToText(s), PlayerGroupAll());
    s = "公聊：1分" + IntToString(BOTC_BvCount(1, 1)) + "  2分" + IntToString(BOTC_BvCount(1, 2)) + "  3分" + IntToString(BOTC_BvCount(1, 3)) + "  4分" + IntToString(BOTC_BvCount(1, 4));
    libNtve_gf_SetDialogItemText(g_bvLine[1], StringToText(s), PlayerGroupAll());
    s = "提名：10秒" + IntToString(BOTC_BvCount(2, 1)) + "  20秒" + IntToString(BOTC_BvCount(2, 2)) + "  30秒" + IntToString(BOTC_BvCount(2, 3));
    libNtve_gf_SetDialogItemText(g_bvLine[2], StringToText(s), PlayerGroupAll());
    if (g_evilEnable) {
        s = "第一天开邪恶小窗：要" + IntToString(BOTC_BvCount(3, 1)) + "  不要" + IntToString(BOTC_BvCount(3, 2));
        libNtve_gf_SetDialogItemText(g_bvLine[3], StringToText(s), PlayerGroupAll());
    }
    // 「你已选」是**每人一份**的：同一个控件对不同玩家写不同的字（跟私聊输入框一个道理）
    for (k = 2; k <= 13; k += 1) {
        mine = "你已选：私聊" + BOTC_BvStr(0, g_bvPm[k]) + " / 公聊" + BOTC_BvStr(1, g_bvPub[k]) + " / 提名" + BOTC_BvStr(2, g_bvNom[k]);
        if (g_evilEnable) {
            mine = mine + " / 小窗" + BOTC_BvStr(3, g_bvEvil[k]);
        }
        libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText(mine), PlayerGroupSingle(k));
        libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：" + BOTC_BvStr(3, g_bvEvil[k])), PlayerGroupSingle(k));
    }
    // 说书人那边那一行给个说明（玩家 2..13 各自看到的是自己的「你已选」）
    libNtve_gf_SetDialogItemText(g_bvLine[4], StringToText("（玩家 2..13 各投一票；再点一次同一项 = 取消）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_bvEvilBtn, StringToText("第一天小窗：未投"), PlayerGroupSingle(g_teller));
}

// 投票：kind 0 私聊 / 1 公聊 / 2 提名 / 3 小窗；再点同一个选项 = 取消
void BOTC_BvVote (int p, int kind, int val) {
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_boardOpen) {
        return;
    }
    if (kind == 3 && !g_evilEnable) {
        return;                        // 邪恶小窗关着：这一项不接受投票
    }
    if (kind == 0) {
        if (g_bvPm[p] == val) {
            g_bvPm[p] = 0;
        }
        else {
            g_bvPm[p] = val;
        }
    }
    else {
        if (kind == 1) {
            if (g_bvPub[p] == val) {
                g_bvPub[p] = 0;
            }
            else {
                g_bvPub[p] = val;
            }
        }
        else {
            if (kind == 2) {
                if (g_bvNom[p] == val) {
                    g_bvNom[p] = 0;
                }
                else {
                    g_bvNom[p] = val;
                }
            }
            else {
                // 小窗那一项：未投 → 要 → 不要 → 未投 循环
                if (g_bvEvil[p] == 0) {
                    g_bvEvil[p] = 1;
                }
                else {
                    if (g_bvEvil[p] == 1) {
                        g_bvEvil[p] = 2;
                    }
                    else {
                        g_bvEvil[p] = 0;
                    }
                }
            }
        }
    }
    BOTC_BvRender();
}

// 结算（选板子结束那一刻）：把投票结果写成「本局设置」，智能说书人的白天节奏照它走
void BOTC_BvApply () {
    int w;
    string s;
    return;
    w = BOTC_BvWinner(0, 5, 3);
    if (w == 5) {
        g_setPmMin = 0;            // 5 = 自由发言：把私聊时间换成自由发言（3 分钟）
    }
    else {
        g_setPmMin = w;
    }
    g_setPubMin = BOTC_BvWinner(1, 4, 3);
    w = BOTC_BvWinner(2, 3, 3);        // 默认 / 平票锚点 = 3（30 秒）；玩家照样可以投 10 / 20 秒
    if (w == 1) {
        g_setNomSec = 10;
    }
    else {
        if (w == 3) {
            g_setNomSec = 30;
        }
        else {
            g_setNomSec = 20;
        }
    }
    if (BOTC_BvWinner(3, 2, 2) == 1 && g_evilEnable) {
        g_setEvilDay1 = true;
    }
    else {
        g_setEvilDay1 = false;         // 功能关掉时（g_evilEnable = false）这一项一律作废
    }
    // 播报一句：大家知道本局按什么时间走
    if (g_setPmMin <= 0) {
        s = "私聊时间：" + "自由发言 3 分钟";
    }
    else {
        s = "私聊时间：" + IntToString(g_setPmMin) + " 分钟";
    }
    s = s + " / 公聊时间：" + IntToString(g_setPubMin) + " 分钟 / 提名时间：" + IntToString(g_setNomSec) + " 秒";
    if (g_evilEnable) {
        s = s + " / 第一天邪恶小窗：";
        if (g_setEvilDay1) {
            s = s + "开";
        }
        else {
            s = s + "不开";
        }
    }
    BOTC_PubAnnounce("【本局设置】" + s);
}

// 得票最多的板子拿了几票（提前结束用：超过本局玩家的一半就直接进入）
int BOTC_BoardTopVotes () {
    int i;
    int k;
    int v;
    int best;
    best = 0;
    for (i = 1; i <= 12; i += 1) {  // 板子号最大到 12（7 = 自定义剧本，没人能投票）
        v = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_boardVote[k] == i) {
                v = v + 1;
            }
        }
        if (v > best) {
            best = v;
        }
    }
    return best;
}

void BOTC_BoardInfoRender () {
    int n;
    if (g_board <= 0) {
        DialogControlSetVisible(g_boardImg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), false);
        return;
    }
    libNtve_gf_SetDialogItemImage(g_boardImg, BOTC_BoardPic(g_board), PlayerGroupAll());
    BOTC_BuildSeatList();
    n = g_seatN;
    // 上色：镇民蓝、外来者天蓝、爪牙橙、恶魔红
    libNtve_gf_SetDialogItemText(g_boardInfo, TextWithColor(StringToText("镇" + IntToString(g_tcTab[n])), Color(70, 120, 255)) + TextWithColor(StringToText("  外" + IntToString(g_ocTab[n])), Color(130, 205, 255)) + TextWithColor(StringToText("  爪" + IntToString(g_mcTab[n])), Color(255, 150, 40)) + TextWithColor(StringToText("  恶1"), Color(235, 60, 60)), PlayerGroupAll());
    DialogControlSetVisible(g_boardImg, PlayerGroupAll(), true);
    DialogControlSetVisible(g_boardInfo, PlayerGroupAll(), true);
}

// 画某个玩家的 token 面板：一格 = 图 + 小字
//   死亡类 token 现在所有人可见、可点；隐形槽（18）不占格子，后面的 token 自动往前排
bool BOTC_TokVisibleFor (int ob, int t) {
    // 【手动标记面板不再列出】（用户 2026-11-11）：处决 / 夜间·其他 死亡分类、通用醉酒、无敌
    //   只由系统或死亡流程自动使用，玩家与说书人都不再手动点选。
    if (t == 10 || t == 22 || t == 24 || t == 176) {
        return false;
    }
    // 【伪造魔典 token 面板】（用户 2026-11-07）：伪造面板列全部具名 token，不按板子过滤。
    if (g_tokFake) {
        return (t != 18 && g_tokName[t] != "");
    }
    return !BOTC_TokHidden(t, ob);
}

bool BOTC_TokMarkedFor (int ob, int t) {
    if (g_tokFake) {
        return g_fakeTok[((g_tokWho[ob] * 256) + t)];
    }
    return g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t];
}

void BOTC_TokRender (int ob) {
    int t;
    int n;
    int k;
    int pages;
    int page;
    int w;
    int x;
    int y;
    string s;
    // 先数一遍「这个板子里能看到的 token」有几个，算出总页数（每页 35 个）
    k = 0;
    for (t = 0; t < 256; t += 1) {
        if (BOTC_TokVisibleFor(ob, t)) {
            k = k + 1;
        }
    }
    pages = ((k + 34) / 35);
    if (pages < 1) {
        pages = 1;
    }
    page = g_tokPage[ob];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_tokPage[ob] = page;
    n = 0;                    // 这一页里已经画了几格
    k = 0;                    // 全表里第几个可见 token（从 0 开始）
    for (t = 0; t < 256; t += 1) {
        if (!BOTC_TokVisibleFor(ob, t)) {
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            continue;
        }
        if (((k / 35) + 1) != page) {
            // 不在当前这一页：收起来（但页码还是要往后数）
            DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), false);
            k = k + 1;
            continue;
        }
        x = 11 + ((n % 7) * 148);
        y = 40 + ((n / 7) * 86);
        DialogControlSetPosition(g_tokBtn[t], PlayerGroupSingle(ob), c_anchorTopLeft, x, y);
        if (g_tokIcon[t] == "") {
            // 还没有图的 token（处决 / 善良 / 邪恶）：整格只显示名字
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), false);
            if (BOTC_TokMarkedFor(ob, t)) {
                s = "√ " + g_tokName[t];       // 打上了就给个勾（用户 2026-09-20：没勾以为打不上去）
            }
            else {
                s = g_tokName[t];
            }
            w = StringLength(s) * 16;
            if (w > 144) {
                w = 144;
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + ((144 - w) / 2), y + 32);
            libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
        }
        else {
            if (BOTC_TokMarkedFor(ob, t)) {
                s = "√ " + g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], TextWithColor(StringToText(s), Color(120, 255, 120)), PlayerGroupSingle(ob));
            }
            else {
                s = g_tokShort[t];
                libNtve_gf_SetDialogItemText(g_tokLbl[t], StringToText(s), PlayerGroupSingle(ob));
            }
            libNtve_gf_SetDialogItemImage(g_tokIconCtl[t], g_tokIcon[t], PlayerGroupSingle(ob));
            DialogControlSetPosition(g_tokIconCtl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + 18, y + 7);   // 图标 X 偏移：56 → 20（用户 2026-09-19）
            DialogControlSetVisible(g_tokIconCtl[t], PlayerGroupSingle(ob), true);
            w = StringLength(s) * 16;
            if (w > 43) {
                w = (144 - w) / 2;
                if (w < 0) {
                    w = 0;
                }
            }
            else {
                w = 18 + ((43 - w) / 2);      // 小字跟着图标居中（图标 X 偏移改成 20）
            }
            DialogControlSetPosition(g_tokLbl[t], PlayerGroupSingle(ob), c_anchorTopLeft, x + w, y + 52);
        }
        DialogControlSetVisible(g_tokLbl[t], PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokBtn[t], PlayerGroupSingle(ob), true);
        n = n + 1;
        k = k + 1;
    }
    // 页码 + 翻页按钮（只有一页就不显示）
    libNtve_gf_SetDialogItemText(g_tokPageLbl, StringToText("第 " + IntToString(page) + " / " + IntToString(pages) + " 页（每页 35 个）"), PlayerGroupSingle(ob));
    if (pages > 1) {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), true);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), true);
    }
    else {
        DialogControlSetVisible(g_tokPrev, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokNext, PlayerGroupSingle(ob), false);
        DialogControlSetVisible(g_tokPageLbl, PlayerGroupSingle(ob), false);
    }
}

// 打开某个座位的 token 面板：说书人和玩家都能开，各记各的（别人的标记自己看不到）
void BOTC_TokOpen (int ob, int who) {
    int q;
    // 【说书人那一格不允许手动打 token】（用户 2026-11-12）：那一格只显示系统自动放的标记。
    if (who < 2 || who > 13) {
        return;
    }
    // 【选目标期间禁止标记】（用户 2026-11-02）：正在点座位选目标时点圆桌是在选人，
    //   别顺手打开标记面板；点【确认】/【取消】后立即恢复。
    if (ob != g_teller) {
        // 【正式开始前禁止标记】（用户 2026-11-06）：开局前玩家不能改任何座位的 token
        if (!g_started) {
            BOTC_Notice(ob, "游戏正式开始前不能修改标记。");
            return;
        }
        q = BOTC_PosOf(ob);
        if (q >= 2 && q <= 13 && g_skillPicking[q]) {
            BOTC_Notice(ob, "选目标期间不能修改标记，请先完成技能选择。");
            return;
        }
    }
    g_tokFake = false;              // 正常打开的 token 面板操作真实魔典
    g_tokWho[ob] = who;
    g_tokPage[ob] = 1;             // 每次打开都从第 1 页开始（用户 2026-09-20）
    libNtve_gf_SetDialogItemText(g_tokTitle, BOTC_PlayerNameText(who) + StringToText(" 的 token"), PlayerGroupSingle(ob));
    BOTC_TokRender(ob);
    DialogSetVisible(g_tokDlg, PlayerGroupSingle(ob), true);
}

void BOTC_TokToggle (int ob, int idx) {
    BOTC_TokToggleAt(ob, g_tokWho[ob], idx);
    BOTC_TokRender(ob);
}

// 直接点圆桌上的 token 就把它去掉 / 加上
void BOTC_TokToggleAt (int ob, int seat, int t) {
    int i;
    int q;
    int prevPerc;
    int newA;
    int cogK;
    int cogR;
    // 【伪造魔典 token】（用户 2026-11-07）：只改伪造数据，不触发任何真实对局结算。
    if (g_tokFake) {
        if (ob != g_teller) {
            return;
        }
        if (seat < 2 || seat > 13 || t < 0 || t > 255) {
            return;
        }
        if (t == 18 || g_tokName[t] == "") {
            return;
        }
        // 【善良 / 邪恶 相克】（用户 2026-11-08）：同一玩家身上不能同时存在这两枚，
        //   打其中一枚时把另一枚顶掉（伪造魔典同样按这条处理）。
        if ((t == 14 || t == 15) && !g_fakeTok[((seat * 256) + t)]) {
            if (t == 14) {
                g_fakeTok[((seat * 256) + 15)] = false;
            }
            else {
                g_fakeTok[((seat * 256) + 14)] = false;
            }
        }
        g_fakeTok[((seat * 256) + t)] = !g_fakeTok[((seat * 256) + t)];
        BOTC_FakeRender();
        return;
    }
    // 【说书人那一格不允许手动打 token】（用户 2026-11-12）：那一格只显示系统自动放的标记。
    if (seat < 2 || seat > 13) {
        return;
    }
    // 【禁止给自己标记 token】限制已取消（用户 2026-11-03）：玩家可以给自己标记 token，
    //   但仍不能改自己的角色标记（拦在 BOTC_PickOpen）。
    if (ob != g_teller) {
        // 【正式开始前禁止标记】（用户 2026-11-06）：开局前玩家不能改任何座位的 token
        if (!g_started) {
            BOTC_Notice(ob, "游戏正式开始前不能修改标记。");
            return;
        }
        q = BOTC_PosOf(ob);
        if (q >= 2 && q <= 13) {
            // 【选目标期间禁止标记】（用户 2026-11-02）：正在点座位选目标时误触 token
            //   会被当成放置标记 → 先拦住；点【确认】/【取消】后立即恢复。
            if (g_skillPicking[q]) {
                BOTC_Notice(ob, "选目标期间不能修改标记，请先完成技能选择。");
                return;
            }
        }
    }
    // 【正式开始前只允许认知偏差 token】（用户 2026-11-13）：游戏正式开始前，说书人只能给玩家
    //   打「是酒鬼 8 / 是疯子 49 / 是提线木偶 118 / 是悟道者 140」；中毒 / 醉酒 / 免死 / 干扰项
    //   这些常驻标记统一留到 BOTC_GameStartGo() 里的 BOTC_OpeningMarkSync() 结算。
    //   撤掉不受限制。
    if (!g_started && ob == g_teller && seat >= 2 && seat <= 13
            && !g_tokOn[(((ob * 14) + seat) * 256) + t]) {
        if (t != 8 && t != 49 && t != 118 && t != 140) {
            BOTC_Notice(ob, "游戏正式开始前只能标记「是酒鬼 / 是疯子 / 是悟道者 / 是提线木偶」。");
            return;
        }
    }
    // 隐形槽（18 = 镇长记账）不给点
    if (BOTC_TokHidden(t, ob)) {
        return;
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：说书人手动打「邪恶(15)」也受名额限制，
    //   全场邪恶总数超过「开局邪恶数 + 1」后不允许再新增邪恶玩家。
    if (ob == g_teller && t == 15 && seat >= 2 && seat <= 13
            && !g_tokOn[(((ob * 14) + seat) * 256) + 15]
            && BOTC_HolySoulBlocks(seat)) {
        BOTC_Notice(ob, "【圣洁之魂】邪恶玩家已达上限，不能再把玩家转为邪恶。");
        return;
    }
    // 【认知偏差 token 校验】（用户 2026-11-09）：说书人手动打 token 也遵守
    //   酒鬼=镇民 / 疯子=恶魔 / 悟道者=外来者 / 提线木偶=善良角色，只拦“打上”不拦“撤掉”。
    if (ob == g_teller && seat >= 2 && seat <= 13
            && !g_tokOn[(((ob * 14) + seat) * 256) + t]) {
        cogK = BOTC_PickCogKindOfTok(t);
        if (cogK >= 0) {
            cogR = g_mark[(ob * 14) + seat] - 1;
            if (cogR < 0) {
                BOTC_Notice(ob, "请先给这名玩家标记身份，再打认知偏差标记。");
                return;
            }
            if (!BOTC_PickCogAllowed(cogK, cogR)) {
                BOTC_PickCogDeny(cogK);
                return;
            }
        }
    }
    // 【记录转变前的认知阵营】（用户 2026-11-06）：手动打善良 / 邪恶 token 前先记住
    //   他「以为自己是什么阵营」，认知没变时不再私聊打扰（疯子被灵言师转邪恶等）。
    prevPerc = -1;
    if (ob == g_teller && seat >= 2 && seat <= 13 && (t == 14 || t == 15)) {
        prevPerc = BOTC_PerceivedAlign(seat);
    }
    // 【善良 / 邪恶 相克】（用户 2026-11-08）：同一个座位不能同时挂这两枚 token，
    //   点其中一枚打上时把另一枚顶掉；真值行和玩家各自那一行都按这条规则处理。
    if ((t == 14 || t == 15) && !g_tokOn[(((ob * 14) + seat) * 256) + t]) {
        if (t == 14) {
            g_tokOn[(((ob * 14) + seat) * 256) + 15] = false;
        }
        else {
            g_tokOn[(((ob * 14) + seat) * 256) + 14] = false;
        }
    }
    g_tokOn[(((ob * 14) + seat) * 256) + t] = !g_tokOn[(((ob * 14) + seat) * 256) + t];
    // 【诺-达鲺手改优先】（用户 2026-10-19）：手动把「中毒（诺-达鲺）」移到别处后，
    //   不再让下一次黄昏 / 身份同步按旧记录复原。这里同步记录实际有标记的座位。
    if (ob == g_teller && t == 80) {
        g_nodManual = true;
        g_nodDemon = BOTC_LiveDemonSeat(70);
        g_nodA = 0;
        g_nodB = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = i;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = i;
                }
            }
        }
    }
    // 【哲学家醉酒同步】token 一打/一撤就同步一次（说书人手动给哲学家下毒也能立刻见效）
    //   ⚠ 但「醉酒（哲学家）90」本身要留给说书人手动纠正（用户 2026-10-12）----
    //     自动同步是「先清掉所有 90、再按算出来的目标重打」，手动打的那一枚会当场被抹掉。
    if (ob == g_teller && t != 90) {
        BOTC_PhiloDrunkSync();
    }
    if (ob == g_teller && t == 90) {
        // 【手动优先】（用户 2026-10-12）：说书人自己打上这枚 → 自动同步不再插手；
        //   他自己撤掉（这一格没 token 了）→ 交还给自动同步。
        g_philoDrunkManual = g_tokOn[(((g_teller * 14) + seat) * 256) + 90];
    }
    // 【是恶魔（小怪宝）134】（用户 2026-10-10）：谁被打上这枚 token，谁就是「现在的恶魔」---- 记住座位。
    //   ⚠ 撤掉 token 时**不清** g_lmSeat：照看人死了 token 会被离场清理自动收掉，那时候还要靠它判胜负。
    if (ob == g_teller && t == 134 && g_tokOn[((((g_teller * 14) + seat) * 256) + t)]) {
        // 【全员追忆】（用户 2026-11-07）：全员追忆可能仍发了一张恶魔牌，无恶魔自动检测不会
        // 把小怪宝局标起来；说书人手动指定照看者时，以这枚 token 为准切入小怪宝夜序与结算。
        g_lmOn = true;
        g_lmSeat = seat;
        // 【告诉他今晚照看小怪宝】（用户 2026-10-10）：打上这枚 token 的那一刻私聊他
        BOTC_PmInfo(g_who[seat], "【小怪宝】今晚由你来照看小怪宝。");
        BOTC_PmStore(g_teller, "【小怪宝】已告诉 " + BOTC_NameStr(seat) + "：今晚由他照看小怪宝。");
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
    }
    // 【善良(14) / 邪恶(15)】手动打 / 撤：真身阵营跟着变 → 登记层缓存作废（用户 2026-09-20）
    if (t == 14 || t == 15) {
        BOTC_PairClearSeat(seat);
        // 【阵营改变的提示】（用户 2026-09-26 初版 / 2026-11-09 修正）：打上或撤掉
        //   「善良(14) / 邪恶(15)」都按“阵营实际有没有变”检查一次。旧写法只在打上时检查，
        //   说书人先撤掉旧 token 再打新 token 时，撤掉那一步已经变成新阵营，后面打 token
        //   就会被误判成“本来就认为自己是这个阵营”而不私聊玩家（异教领袖转回善良就是这种情况）。
        if (ob == g_teller) {
            newA = BOTC_SeatAlign(seat);
            // 【认知没变就不通知】（用户 2026-11-06）：疯子被灵言师 / 方古转成邪恶时，
            //   他本来就以为自己是邪恶的，不必再私聊告诉他一遍。
            if (seat >= 2 && seat <= 13 && prevPerc == newA) {
                BOTC_PmStore(g_teller, "【阵营转变】" + BOTC_NameStr(seat) + " 本来就认为自己是" + BOTC_AlignName(newA) + "阵营 → 不通知他。");
            }
            else {
                if (newA == 1) {
                    BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是邪恶阵营。");
                    BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是邪恶阵营。");
                }
                else {
                    BOTC_PmInfo(g_who[seat], "【阵营转变】你现在是善良阵营。");
                    BOTC_PmStore(g_teller, "【阵营转变】已告诉 " + BOTC_NameStr(seat) + "：他现在是善良阵营。");
                }
            }
        }
    }
    // 【蛊毒（蛊雕）】：说书人手动放置 / 移除蛊毒时，身份与阵营登记缓存立即重掷。
    if (t == 198) {
        BOTC_PairClearSeat(seat);
    }
    // 【复活（哈迪寂亚）113】不是普通死亡 token：打上它 = 把该座位的死亡记录清掉并恢复一次性能力。
    if (ob == g_teller && t == 113 && g_tokOn[(((g_teller * 14) + seat) * 256) + 113]) {
        g_tokOn[(((g_teller * 14) + seat) * 256) + 112] = false;
        if (BOTC_PublicDead(seat)) {
            if (g_isNight) {
                BOTC_PmStore(g_teller, "【哈迪寂亚】已为 " + BOTC_NameStr(seat) + " 标记复活：当晚按存活处理，天亮统一公布。");
            }
            else {
                BOTC_DeathToggle(seat, 0, 0, -1);
            }
        }
        else {
            BOTC_ClearDeath(seat);
            BOTC_RestoreOneShot(seat);
            BOTC_PmInfo(g_who[seat], "【哈迪寂亚】你复活了。");
            BOTC_PmStore(g_teller, "【哈迪寂亚】已让 " + BOTC_NameStr(seat) + " 复活（死亡记录和一次性能力已恢复）。");
        }
    }
    // 说书人手动点「死亡」那一格：只留一个死亡 token，并把死亡类型同步过来（关掉就等于复活）
    if (ob == g_teller) {
        // 【角色专属死因 token（32~41）也要走这条】（用户 2026-09-22）：以前这里只认死亡类型表里的那几格，
        //   所以「死亡（造谣者）」点上之后只亮个 token ---- 死亡记录 / 红叉 / 播报全都没有。
        if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
            if (g_tokOn[(((g_teller * 14) + seat) * 256) + t]) {
                BOTC_SyncDeathFromTok(seat, t);
                // 标的是恶魔的话：红唇女郎顶上 / 没人顶就走传位（智能随机 / 手动弹面板）；
                //   没人能接位时才判胜负（没有活着的恶魔 → 善良胜）
                if (!BOTC_DemonGoneCheck()) {
                    BOTC_CheckWin();
                }
            }
            else {
                BOTC_ClearDeath(seat);
            }
        }
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：手动打了死亡 token（或撤掉）之后，
    //   那个座位的玩家该看到【死后声称】了（撤掉就换回【声称】）。
    if (ob == g_teller) {
        BOTC_DeclareRender();
    }
    // 【疯子（38）】手动给某个座位打「被选择（疯子）」= 模拟疯子今晚的选择：
    //   写一行「疯子选择了谁」+ 智能说书时私聊告诉真恶魔（用户 2026-09-20）
    if (ob == g_teller && t == 48 && g_tokOn[(((g_teller * 14) + seat) * 256) + 48]) {
        BOTC_LunaticPickNotify(seat);
    }
    if (ob == g_teller) {
        BOTC_VizierSync();          // 中毒 / 醉酒 / 死亡 / 复活 / 换身份后立即校正维齐尔免死 token
        BOTC_SkinSourceCheck();     // 画皮来源中毒 / 醉酒 / 死亡后按昼夜处理仍在场的活尸
        BOTC_BartenderSync();       // 酒保自身失能或目标改变阵营时立即撤掉酒保醉酒
        BOTC_BrokerSync();          // 掮客：手动改阵营 token 后熟客立即失效并移除标记
    }
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

void BOTC_TokClearAll (int ob) {
    int t;
    // 【伪造魔典】（用户 2026-11-07）：只清伪造数据。
    if (g_tokFake) {
        for (t = 0; t < 256; t += 1) {
            g_fakeTok[((g_tokWho[ob] * 256) + t)] = false;
        }
        BOTC_TokRender(ob);
        BOTC_FakeRender();
        return;
    }
    for (t = 0; t < 256; t += 1) {
        g_tokOn[(((ob * 14) + g_tokWho[ob]) * 256) + t] = false;
    }
    if (ob == g_teller) {
        BOTC_ClearDeath(g_tokWho[ob]);
    }
    BOTC_TokRender(ob);
    BOTC_GrimRender(ob);
    BOTC_LeviathanTokenWin();
}

// 【按板子抽角色】（用户 2026-09-19）：从**当前板子的角色清单**（g_boardRole）里，
//   随机挑一个「这一局还没用过、且属于某个阵营」的身份；t = 阵营（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）
//   返回 -1 = 这个板子里没有这类角色（调用方退回旧的范围抽法）
bool BOTC_IsMarionette (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    return (BOTC_SeatTrueRole(q) == 93);
}

// 【酒鬼 / 提线木偶的认知偏差角色】（用户 2026-11-03；2026-11-06 改读分类表）
//   分层：0 = 首夜信息位 / 只能发动一次技能 → g_roleInfoClass 1（一次性信息者）
//         1 = 持续信息位（小概率，且不参与「持续信息角色保底」）→ g_roleInfoClass 2
//         2 = 有夜间行动或白天能力 → g_roleInfoClass 3 / 5
//         3 = 死亡能力 / 无主动能力 / 其他镇民（最后才选）→ g_roleInfoClass 4 / 6 / 7
//         98 = 无神论者（只有小概率被选中）
//         99 = 不选（失忆者、悟道者、非镇民）
// 【降低无神论者出现概率】（用户 2026-11-12）：剧本里有无神论者（83）时，随机配板抽到他的概率降低；
//   酒鬼 / 提线木偶的认知偏差同样适用。pct = 保留概率（百分比）。
bool BOTC_DealAtheistKeep (int pct) {
    return (RandomInt(1, 100) <= pct);
}

int BOTC_BiasRoleTier (int r) {
    if (r < 0 || r > 163) {
        return 99;
    }
    if (r == 73 || r == 118) {
        return 99;                                     // 失忆者、悟道者不选
    }
    if (BOTC_RoleTeam(r) != 0) {
        return 99;                                     // 认知偏差尽量是镇民，不用外来者
    }
    if (r == 83) {
        return 98;                                     // 无神论者：只有小概率出现
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;                                      // 一次性信息者
    }
    if (g_roleInfoClass[r] == 2) {
        return 1;                                      // 持续信息位（小概率）
    }
    if (g_roleInfoClass[r] == 3 || g_roleInfoClass[r] == 5) {
        return 2;                                      // 夜间行动 / 白天能力
    }
    return 3;                                          // 死亡能力 / 纯被动 / 其他镇民
}

// mode 0 = 只从本局还没用过的角色里选（酒鬼的额外身份牌）
// mode 1 = 只从本局不在场的角色里选（提线木偶的假身份）
//   认知偏差身份不得与在场角色重复（用户 2026-11-03），因此不再提供「允许重复」模式。
int BOTC_BiasRolePick (int mode, int self) {
    int i;
    int r;
    int tier;
    int pick;
    int n;
    int want;
    int ath;
    int cn;
    int[4] cnt;

    for (i = 0; i < 4; i += 1) {
        cnt[i] = 0;
    }
    ath = -1;
    cn = 0;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163 || r == self) {
            continue;
        }
        // 【无神论者局 · 认知偏差可以重复】（用户 2026-11-12）：多个酒鬼各自的假身份允许撞上在场角色。
        if (mode == 0 && g_scrUsed[r] && !g_athDeal) {
            continue;
        }
        if (mode == 1 && BOTC_RoleInPlay(r)) {
            continue;
        }
        tier = BOTC_BiasRoleTier(r);
        if (tier <= 3) {
            cnt[tier] = cnt[tier] + 1;
        }
        else {
            if (tier == 98) {
                cn = cn + 1;
                if (RandomInt(1, cn) == 1) {
                    ath = r;
                }
            }
        }
    }
    if (ath >= 0) {
        // 【酒鬼 / 提线木偶无神论概率 5%】（用户 2026-11-12）：两种认知偏差都按 5% 处理。
        if (mode == 0) {
            if (BOTC_DealAtheistKeep(5)) {
                return ath;                            // 剧本里有无神论者 → 酒鬼小概率以为自己是无神论者
            }
        }
        else if (BOTC_DealAtheistKeep(5)) {
            return ath;                                // 提线木偶：同样 5%
        }
    }
    want = -1;
    if (cnt[0] > 0) {
        if (cnt[1] > 0 && RandomInt(1, 100) <= 20) {
            want = 1;                                  // 有小概率改成持续信息位
        }
        else {
            want = 0;
        }
    }
    else if (cnt[1] > 0) {
        want = 1;
    }
    else if (cnt[2] > 0) {
        want = 2;
    }
    else if (cnt[3] > 0) {
        want = 3;
    }
    if (want < 0) {
        return -1;
    }
    n = 0;
    pick = -1;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163 || r == self) {
            continue;
        }
        // 【无神论者局 · 认知偏差可以重复】（用户 2026-11-12）
        if (mode == 0 && g_scrUsed[r] && !g_athDeal) {
            continue;
        }
        if (mode == 1 && BOTC_RoleInPlay(r)) {
            continue;
        }
        if (BOTC_BiasRoleTier(r) != want) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    return pick;
}

int BOTC_MarionetteFakeRole (int self) {
    int i;
    int r;
    int n;
    int team;
    int pick;
    pick = BOTC_BiasRolePick(1, self);                 // 先找本局不在场的镇民
    if (pick >= 0) {
        return pick;
    }
    // 【认知偏差不与在场角色重复】（用户 2026-11-03）：镇民都已在场时放宽到外来者，
    //   但依然只从「本局不在场」的角色里选；实在找不到就返回 -1，由说书人手选。
    for (team = 0; team <= 1; team += 1) {
        n = 0;
        pick = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163 || r == self) {
                continue;
            }
            if (BOTC_RoleTeam(r) != team) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;
            }
            // 【提线木偶无神论概率 5%】（用户 2026-11-12）：兜底候选池同样按 5% 保留。
            if (r == 83 && !BOTC_DealAtheistKeep(5)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick >= 0) {
            return pick;
        }
    }
    return -1;
}

bool BOTC_MarionetteCanSwap (int q) {
    int rt;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    rt = BOTC_SeatTrueRole(q);
    if (BOTC_RoleTeam(rt) != 0 && BOTC_RoleTeam(rt) != 1) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 118]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：已经是提线木偶的不换
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) {
        return false;                               // 【认知覆盖】（用户 2026-10-16）：悟道者（真身 118）不换 —— 换了会留下「是悟道者」140 又挂上「是提线木偶」118
    }
    return true;
}

void BOTC_MarionetteSwap (int a, int b) {
    int i;
    int ra;
    int rb;
    ra = g_mark[(g_teller * 14) + a] - 1;
    rb = g_mark[(g_teller * 14) + b] - 1;
    g_tokOn[(((g_teller * 14) + a) * 256) + 118] = false;
    BOTC_SetSeatRole(g_teller, a, rb);
    BOTC_SetSeatRole(g_who[a], a, rb);
    BOTC_SetSeatRole(g_teller, b, ra);
    BOTC_SetSeatRole(g_who[b], b, ra);
    g_tokOn[(((g_teller * 14) + b) * 256) + 118] = true;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 6] = false;
    }
    BOTC_PickRedHerring();
    BOTC_GrimRender(g_teller);
    // 【本人魔典同步】（用户 2026-11-05）：提线木偶换身份发生在游戏中途时，
    //   两个被交换的玩家也要刷新自己那份魔典，不能只刷说书人那一份。
    if (g_started) {
        BOTC_GrimRender(g_who[a]);
        BOTC_GrimRender(g_who[b]);
    }
}

// 【提线木偶假身份】（用户 2026-11-12）：只给真身 93 分配「以为自己是」的镇民 / 外来者。
//   幂等：已经带「是提线木偶」token 且魔典上仍是善良假身份时保留原身份，不重掷（配板会重复调用）。
void BOTC_MarionetteRoleSync () {
    int i;
    int r;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsMarionette(i)) {
            continue;
        }
        r = g_mark[(g_teller * 14) + i] - 1;
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 118] && r >= 0 && r <= 163 && BOTC_RoleTeam(r) <= 1) {
            continue;
        }
        r = BOTC_MarionetteFakeRole(i);
        if (r < 0) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
            BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(i) + " 找不到能当他「以为的身份」的镇民，请手动在魔典上给他选一个善良身份。");
            continue;
        }
        BOTC_SetSeatRole(g_teller, i, r);
        BOTC_SetSeatRole(g_who[i], i, r);
        g_tokOn[(((g_teller * 14) + i) * 256) + 118] = true;
    }
}

// 【提线木偶邻座】（用户 2026-11-12）：只做换座位，不改假身份。
//   普通局与恶魔邻座；小怪宝局没有真恶魔，把小怪宝本人当恶魔锚点。
void BOTC_MarionetteSeatAlign () {
    int i;
    int dm;
    int mq;
    int nb;
    int cand;
    mq = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsMarionette(i)) {
            continue;
        }
        if (mq == 0) {
            mq = i;
        }
    }
    if (mq < 2) {
        return;
    }
    dm = BOTC_FindDemon();
    if (dm < 2) {
        dm = BOTC_SeatOfRole(111);            // 小怪宝局：没有真恶魔，小怪宝就是恶魔锚点
    }
    cand = 0;
    if (dm >= 2 && BOTC_RingDist(mq, dm) > 1) {
        nb = BOTC_RingNext(dm, 1);
        if (BOTC_MarionetteCanSwap(nb)) {
            cand = nb;
        }
        if (cand < 2) {
            nb = BOTC_RingNext(dm, -1);
            if (BOTC_MarionetteCanSwap(nb)) {
                cand = nb;
            }
        }
        if (cand >= 2) {
            BOTC_MarionetteSwap(mq, cand);
            mq = cand;
        }
    }
    BOTC_PmStore(g_teller, "【提线木偶】" + BOTC_NameStr(mq) + " 以为自己是「" + g_roleName[g_mark[(g_teller * 14) + mq] - 1] + "」。");
}

void BOTC_MarionetteSync () {
    BOTC_MarionetteRoleSync();
    BOTC_MarionetteSeatAlign();
}

// 【提线木偶的假身份是不是某个角色】（用户 2026-11-12）：给巡山人 / 气球驾驶员这些
//   设置调整类相克用；只认真身 93 + 魔典上的假身份。
bool BOTC_MarionetteFakeIs (int role) {
    int i;
    int r;
    if (role < 0 || role > 163) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_IsMarionette(i)) {
            continue;
        }
        r = g_mark[(g_teller * 14) + i] - 1;
        if (r == role) {
            return true;
        }
    }
    return false;
}

// 【炼金术士 × 提线木偶】（用户 2026-11-12）：炼金术士在场时提线木偶有 25% 概率登场。
//   随机配板不会主动抽 93，触发时把一名普通爪牙的牌换成提线木偶（仍占爪牙名额）；
//   假身份与邻座由 BOTC_MarionetteRoleSync / BOTC_MarionetteSeatAlign 接着处理。
void BOTC_AlchemistMarionetteEnsure () {
    int i;
    int r;
    int pick;
    int n;
    if (BOTC_SeatOfRole(95) < 2) {
        return;
    }
    if (BOTC_SeatOfRole(93) >= 2) {
        return;
    }
    if (BOTC_AtheistOn()) {
        return;                                   // 无神论者局没有邪恶角色
    }
    if (RandomInt(1, 100) > 25) {
        BOTC_PmStore(g_teller, "【炼金术士×提线木偶】炼金术士在场，本次配板提线木偶没有登场（25% 概率）。");
        return;
    }
    pick = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (BOTC_RoleTeam(r) != 2) {
            continue;
        }
        if (r == 95 || r == 111 || r == 150) {
            continue;                             // 炼金术士自己 / 小怪宝 / 召唤师
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = i;
        }
    }
    if (pick < 2) {
        BOTC_PmStore(g_teller, "【炼金术士×提线木偶】场上没有可替换的普通爪牙，提线木偶无法保证在场。");
        return;
    }
    r = BOTC_SeatTrueRole(pick);
    if (r >= 0) {
        g_scrUsed[r] = false;
    }
    BOTC_SetSeatRole(g_teller, pick, 93);
    BOTC_SetSeatRole(g_who[pick], pick, 93);
    g_scrUsed[93] = true;
    BOTC_PmStore(g_teller, "【炼金术士×提线木偶】炼金术士在场：爪牙 " + BOTC_NameStr(pick) + " 的牌已换成提线木偶（提线木偶一定在场）。");
}

// 【气球驾驶员 × 提线木偶】（用户 2026-11-12）：提线木偶以为自己是气球驾驶员时，
//   设置调整阶段可能 +1 外来者。做法与落难少女一致：把一名镇民换成一名不在场的外来者。
void BOTC_BalloonMarionetteComposition () {
    int i;
    int r;
    int pick;
    int slot;
    int n;
    if (!BOTC_MarionetteFakeIs(72)) {
        return;
    }
    if (RandomInt(1, 2) != 1) {
        BOTC_PmStore(g_teller, "【气球驾驶员×提线木偶】提线木偶以为自己是气球驾驶员：本次设置调整不额外加入外来者。");
        return;
    }
    pick = -1;
    n = 0;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 1) {
            continue;
        }
        if (BOTC_RoleInPlay(r)) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    if (pick < 0) {
        BOTC_PmStore(g_teller, "【气球驾驶员×提线木偶】板子里没有不在场的外来者，本次 +1 外来者未生效。");
        return;
    }
    slot = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (BOTC_RoleTeam(r) != 0) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 8] || g_tokOn[(((g_teller * 14) + i) * 256) + 49] || g_tokOn[(((g_teller * 14) + i) * 256) + 140] || g_tokOn[(((g_teller * 14) + i) * 256) + 118]) {
            continue;                             // 认知偏差 / 提线木偶座位不换
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            slot = i;
        }
    }
    if (slot < 2) {
        BOTC_PmStore(g_teller, "【气球驾驶员×提线木偶】没有可替换的镇民，本次 +1 外来者未生效。");
        return;
    }
    r = BOTC_SeatTrueRole(slot);
    if (r >= 0) {
        g_scrUsed[r] = false;
    }
    BOTC_SetSeatRole(g_teller, slot, pick);
    BOTC_SetSeatRole(g_who[slot], slot, pick);
    g_scrUsed[pick] = true;
    BOTC_PmStore(g_teller, "【气球驾驶员×提线木偶】提线木偶以为自己是气球驾驶员：镇民 " + BOTC_NameStr(slot) + " 已换成外来者「" + g_roleName[pick] + "」（外来者 +1、镇民 -1）。");
}

// 【无神论者局 · 允许角色重复】（用户 2026-11-12）：无神论者在场时随机配板不再强制每个角色只发一次。
//   酒鬼（14）/ 疯子（38）/ 悟道者（118）也允许出现多名，各自的认知偏差同样可以重复；
//   失忆者、无神论者本人和带全局设置状态的提线木偶 / 气球驾驶员 / 卡扎力 / 召唤师 / 酒保仍保持唯一。
bool BOTC_DealRoleSingleton (int r) {
    if (r == 73 || r == 83 || r == 93) {
        return true;
    }
    if (r == 72 || r == 135 || r == 150 || r == 160) {
        return true;
    }
    return false;
}

int BOTC_PickBoardRole (int t) {
    int i;
    int r;
    int n;
    int pick;
    int athSkip;
    bool avoid;
    n = 0;
    pick = -1;
    athSkip = 0;
    // 【军团局降低特定善良角色的出现概率】（用户 2026-11-06）：随机发牌抽到军团（94）时，
    //   赏金猎人（90）、酒鬼（14）、疯子（38）只有约 1/4 的概率被抽中。
    avoid = false;
    if (g_lgDealGood && (t == 0 || t == 1)) {
        avoid = true;
    }
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != t) {
            continue;
        }
        if (g_scrUsed[r] && !(g_athDeal && !BOTC_DealRoleSingleton(r))) {
            continue;
        }
        // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：同一局只能有其中一个在场
        if (r == 101 && g_scrUsed[100]) {
            continue;
        }
        if (r == 100 && g_scrUsed[101]) {
            continue;
        }
        // 【无神论者】（用户 2026-11-12）：本局有没有无神论者由 BOTC_Deal 开头掷一次（g_athDeal），
        //   这里不再单独抽他，统一留给镇民抽完后钉进一个镇民位。
        if (t == 0 && r == 83) {
            athSkip = athSkip + 1;
            continue;
        }
        // 【无神论者局 · 收紧会改变阵营的角色】（用户 2026-11-12）：无神论者（83）在场时本局没有邪恶，
        //   赏金猎人（90）/ 莽夫（37）/ 政客（97）/ 异教领袖（106）/ 食人魔（148）只有 5% 概率被抽中。
        if (g_athDeal && (r == 37 || r == 90 || r == 97 || r == 106 || r == 148)) {
            athSkip = athSkip + 1;
            if (RandomInt(1, 100) > 5) {
                continue;
            }
        }
        if (avoid && (r == 90 || r == 14 || r == 38)) {
            if (RandomInt(1, 4) != 1) {
                continue;
            }
        }
        // 【军团 8 / 9 名：不抽入赏金猎人】（用户 2026-11-10）：酒鬼以为自己是赏金猎人的
        //   情况由 BOTC_Deal 单独按极低概率处理，这里不抽真牌。
        if (g_lgNoBounty && t == 0 && r == 90) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    // 候选全被跳过（剧本里只剩这几个）→ 退回正常抽法，保证一定能发牌。
    if (pick < 0 && avoid) {
        n = 0;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (g_scrUsed[r] && !(g_athDeal && !BOTC_DealRoleSingleton(r))) {
                continue;
            }
            // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：兜底也不让两个克星同场
            if (r == 101 && g_scrUsed[100]) {
                continue;
            }
            if (r == 100 && g_scrUsed[101]) {
                continue;
            }
            if (g_lgNoBounty && t == 0 && r == 90) {
                continue;                        // 军团 8 / 9 名：兜底也不抽赏金猎人
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
    }
    // 候选中只剩无神论者（其他镇民都已发完）→ 退回正常抽法，保证一定能发牌。
    if (pick < 0 && athSkip > 0) {
        n = 0;
        pick = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (g_scrUsed[r] && !(g_athDeal && !BOTC_DealRoleSingleton(r))) {
                continue;
            }
            // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：兜底也不让两个克星同场
            if (r == 101 && g_scrUsed[100]) {
                continue;
            }
            if (r == 100 && g_scrUsed[101]) {
                continue;
            }
            if (g_lgNoBounty && t == 0 && r == 90) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
    }
    if (pick >= 0) {
        g_scrUsed[pick] = true;
    }
    return pick;
}

void BOTC_SummonerInitialSetup () {
    int i;
    int s;
    int d;
    int r;
    g_summonerPending = false;
    g_summonerDone = false;
    s = BOTC_SummonerSeat();
    if (s < 2) {
        return;
    }
    d = BOTC_FindDemon();
    if (d >= 2) {
        r = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            if (BOTC_RoleTeam(g_boardRole[(g_board * 256) + i]) == 0 && !BOTC_RoleInPlay(g_boardRole[(g_board * 256) + i])) {
                r = g_boardRole[(g_board * 256) + i];
                break;
            }
        }
        if (r >= 0 && BOTC_RoleTeam(r) == 0) {
            BOTC_SetSeatRole(g_teller, d, r);
            BOTC_SetSeatRole(g_who[d], d, r);
            BOTC_PmStore(g_teller, "【召唤师】配置调整：移除初始恶魔（" + BOTC_NameStr(d) + "），替换为镇民「" + g_roleName[r] + "」。");
        }
        else {
            BOTC_PmStore(g_teller, "【召唤师】配置调整：找不到可替换的镇民，请手动把恶魔位改成镇民。");
        }
    }
    g_summonerPending = true;
    BOTC_PmStore(g_teller, "【召唤师】当前没有初始恶魔；在第三夜成功创造恶魔之前，不会因为无恶魔直接判善良胜。");
}

// 【堤丰之首（111）】（用户 2026-11-13 改）：不再真实换座 ----
//   发牌时 BOTC_Deal 已经把「恶魔 + 全部爪牙（含设置 +1 的那名）」发到圆桌上一段
//   **连续相邻**的座位，恶魔坐这一段的正中；这里只把结果播报给说书人，不动任何座位。
void BOTC_HfTyphonSetup () {
    int i;
    int n;
    int q;
    int tp;
    int first;
    int last;

    tp = BOTC_SeatOfRole(111);
    if (tp < 2 || tp > 13) {
        return;
    }
    n = 0;
    first = 0;
    last = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTeam(q) == 2 || BOTC_SeatTeam(q) == 3) {
            if (n == 0) {
                first = q;
            }
            last = q;
            n = n + 1;
        }
    }
    if (n < 2) {
        return;
    }
    BOTC_PmStore(g_teller, "【堤丰之首】邪恶已发到相邻座位（" + BOTC_NameStr(first) + " → " + BOTC_NameStr(last) + "，含设置 +1 爪牙），他坐 " + BOTC_NameStr(tp) + "。");
}
// 【随机发牌 · 萌新友好角色】（用户 2026-11-03；2026-11-06 改读分类表）：
//   总场数少于 5 场的玩家优先拿到「无主动能力 / 只有首夜信息 / 只能被动触发」的善良角色。
//   镇民改读 g_roleInfoClass：1=一次性信息者、6=无主动能力者 算萌新友好
//   （死亡能力者 4 要死了才出信息、夜间/白天能力者 3/5 要主动操作，均不算）。
//   外来者维持原规则：无主动能力 / 只被动触发，且避开认知覆盖类（酒鬼 / 疯子）。
bool BOTC_RoleNewbieSafe (int r) {
    if (r < 0 || r > 163) {
        return false;
    }
    if (BOTC_RoleTeam(r) == 0) {
        return (g_roleInfoClass[r] == 1 || g_roleInfoClass[r] == 6);
    }
    if (BOTC_RoleTeam(r) != 1) {
        return false;
    }
    if (g_roleAct[r] != 0 && g_roleAct[r] != 4 && g_roleAct[r] != 5) {
        return false;
    }
    if (r == 14 || r == 38) {
        return false;
    }
    return true;
}

// 【随机发牌 · 持续信息角色】（用户 2026-11-03；2026-11-06 改读分类表）：
//   每个夜晚或每个白天都能获得一次信息的善良角色，随机发牌时尽量保证本局有 1~2 个。
//   直接读 g_roleInfoClass == 2（持续信息位），认知偏差 / 不在场身份 / 解谜大师分层同步跟随。
bool BOTC_RoleRecurringInfo (int r) {
    if (r < 0 || r > 163) {
        return false;
    }
    return (g_roleInfoClass[r] == 2);
}

// 【解谜大师（109）· 醉酒目标的优先级】（用户 2026-11-03；2026-11-06 改读分类表）：
//   0 = 一次性信息者（g_roleInfoClass == 1，含首夜信息位）
//   1 = 夜间或白天能发动技能的角色（g_roleAct 1 / 2 / 3，另外 6 = 条件性也算）
//   2 = 持续信息位（g_roleInfoClass == 2，即使它同时是每夜行动位）
//   3 = 其余（兜底）
int BOTC_DrunkTargetTier (int q) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return 3;
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;                                      // 一次性信息者优先
    }
    if (g_roleAct[r] == 1 || g_roleAct[r] == 2 || g_roleAct[r] == 3 || g_roleAct[r] == 6) {
        return 1;                                      // 夜间 / 白天能发动技能
    }
    if (g_roleInfoClass[r] == 2) {
        return 2;                                      // 持续信息位排在主动技能之后
    }
    return 3;
}

// 【正式开局 · 首夜标记】（用户 2026-11-09）：占卜师干扰项 / 半兽人失足 / 解谜大师醉酒 /
//   水手 / 弄臣 / 茶艺师 / 酒保 / 暴风捕手 / 涡流，全部改为游戏正式开始、进入第一夜时立刻结算；
//   配板 / 随机发牌 / 确认发放阶段不再提前打这些标记。
//   酒鬼（8）/ 疯子（49）/ 悟道者（140）/ 提线木偶（118）的认知偏差 token 仍在配板阶段打。
void BOTC_OpeningMarkSync () {
    int i;
    int k;
    int n;
    int pick;
    int tier;
    // 占卜师（6）：干扰项
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 6] = false;
    }
    g_herring = 0;
    BOTC_PickRedHerring();
    // 半兽人（107）：失足（候选里随机抽一名善良玩家）
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 127] = false;
    }
    // 【酒鬼 / 提线木偶】（用户 2026-11-11）：魔典上写着半兽人的假半兽人不放「失足」127，只有真身是半兽人才放。
    if (BOTC_SeatOfRole(107) >= 2) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_SeatTrueRole(i) == 107) { continue; }
            n = n + 1;
        }
        pick = 0;
        if (n > 0) {
            k = RandomInt(1, n);
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatAlign(i) != 0) { continue; }
                if (BOTC_SeatTrueRole(i) == 107) { continue; }
                k = k - 1;
                if (k <= 0) { pick = i; break; }
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 127] = true;
            BOTC_PmStore(g_teller, "【半兽人】失足标记：" + BOTC_NameStr(pick));
        }
    }
    // 解谜大师（109）：醉酒（首夜信息位 → 夜间 / 白天技能 → 持续信息位 → 兜底）
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 129] = false;
    }
    // 【设置调整只认真身】（用户 2026-11-12）：酒鬼 / 提线木偶 / 疯子以为自己是解谜大师时不触发
    if (BOTC_SeatOfRole(109) >= 2) {
        pick = 0;
        for (tier = 0; tier <= 3; tier += 1) {
            n = 0;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (BOTC_SeatTeam(i) != 0) { continue; }
                // 【无神论者不会被解谜大师自动标记】（用户 2026-11-12）：随机醉酒目标排除无神论者。
                if (BOTC_SeatTrueRole(i) == 83) { continue; }
                if (BOTC_DrunkTargetTier(i) != tier) { continue; }
                n = n + 1;
            }
            if (n > 0) {
                k = RandomInt(1, n);
                for (i = 2; i <= 13; i += 1) {
                    if (!g_seatOn[i]) { continue; }
                    if (BOTC_SeatTeam(i) != 0) { continue; }
                    // 【无神论者不会被解谜大师自动标记】（用户 2026-11-12）
                    if (BOTC_SeatTrueRole(i) == 83) { continue; }
                    if (BOTC_DrunkTargetTier(i) != tier) { continue; }
                    k = k - 1;
                    if (k <= 0) { pick = i; break; }
                }
            }
            if (pick >= 2) {
                break;                         // 这一档已经选到，不再往下一档降级
            }
        }
        if (pick >= 2) {
            g_tokOn[(((g_teller * 14) + pick) * 256) + 129] = true;
            BOTC_PmStore(g_teller, "【解谜大师】醉酒标记：" + BOTC_NameStr(pick));
        }
    }
    // 水手 / 弄臣 / 茶艺师：常驻免死标记
    BOTC_SailorSync();
    BOTC_TeaLadySync();
    BOTC_FoolSync();
    // 酒保：正式开局这一刻指定邻近善良玩家醉酒
    BOTC_BartenderSetup();
    // 暴风捕手：打「免死（暴风捕手）」；正式开局的播报仍由 BOTC_HfSetupFirstNight 补
    BOTC_StormSync();
    // 涡流（71）：镇民的「信息错误」标记
    BOTC_VortoxSync();
}

// 【随机发牌的座位权重】（用户 2026-11-06 / 2026-11-07）：以前按分数取最大值，
//   多人同时满足场次条件时恶魔 / 爪牙永远落在总场数最高的那几个人身上，
//   反复点【随机发牌】也不换人。改成按场次加权随机，恶魔位和爪牙位共用同一张表：
//   <5 场 = 1；5..9 场 = 5；10..15 场 = 10；16..20 场 = 15；>20 场 = 20。
// 【随机发牌的座位基础权重】（用户 2026-11-10）：恶魔 / 爪牙 / 失忆者（73）共用的场次权重，
//   只按总场数给权重，不含上一场阵营的软换边。
int BOTC_DealSeatBaseWeight (int tot) {
    int w;
    w = 1;
    if (tot > 20) {
        w = 20;
    }
    else {
        if (tot > 15) {
            w = 15;
        }
        else {
            if (tot >= 10) {
                w = 10;
            }
            else {
                if (tot >= 5) {
                    w = 5;
                }
            }
        }
    }
    return w;
}

//   上一场不是邪恶的玩家权重 ×1.2（整数按 (w*6)/5 计算）作为软换边。
//   【竞选角色类型】（用户 2026-11-11）：参与该类型竞选的玩家再 ×1.5；为保留小数效果，
//   先把基础权重 ×2，参与时按 ×3 计算，比例仍是 1.5 倍。
int BOTC_DealSeatWeight (int tot, int lastEvil, int join) {
    int w;
    w = BOTC_DealSeatBaseWeight(tot) * 2;
    if (lastEvil == 0) {
        w = (w * 6) / 5;
    }
    if (join == 1) {
        w = (w * 3) / 2;
    }
    return w;
}

// 【随机发牌的座位优先序】（用户 2026-11-03 / 2026-11-04）：
//   恶魔位与爪牙位共用同一张场次权重表（见 BOTC_DealSeatWeight）；上一场已经扮演邪恶的玩家尽量换边。
//   军团（94）没有单独的恶魔位，卡扎力（135）的爪牙位会被换成善良角色，这两种情况跳过对应偏好；
//   小怪宝（112）的恶魔位实际会改成爪牙，所以按爪牙偏好挑人。
void BOTC_DealSeatOrder (int demonRole) {
    int n;
    int i;
    int j;
    int best;
    int bestScore;
    int sc;
    int tmp;
    int q;
    int pid;
    int t;
    int pe;
    int take;
    int minionN;
    int jm;
    int[16] tot;
    int[16] lastEvil;
    int[16] join;

    n = g_seatN;
    for (q = 1; q <= 13; q += 1) {
        g_dealStatT[q] = 0;
        g_dealJoin[q] = 15;                // 没有 bank 的座位按 4 类全参与，权重不受影响
    }
    if (n <= 1) {
        return;
    }
    BOTC_BankInit();
    for (i = 0; i < n; i += 1) {
        q = g_scrSeat[i];
        pid = g_who[q];
        t = 0;
        pe = 0;
        jm = 15;
        if (pid >= 1 && pid <= 13 && PlayerType(pid) == 1) {
            // 【缓存优先 · 不阻塞读档】（用户 2026-11-11）：随机发牌的场次权重只读开局缓存，
            //   BankInit 之后是空操作；发牌时不再 BankLoad + BankWait，掉线同步也不会卡住全场。
            // 【兜底补加载】（用户 2026-11-13）：句柄缺失时先补一次，否则按 0 场 / 默认偏好参与配板。
            BOTC_BankEnsure(pid);
            t = BOTC_StatsOwnGet(g_bank[pid], "t");
            if (BankKeyExists(g_bank[pid], "stats", "la")) {
                if (BankValueGetAsInt(g_bank[pid], "stats", "la") != 0) {
                    pe = 1;
                }
            }
            // 【竞选角色类型】（用户 2026-11-11）：读玩家本地保存的参与状态（默认 15 = 全参与）
            if (BankKeyExists(g_bank[pid], "opts", "jrw")) {
                jm = BankValueGetAsInt(g_bank[pid], "opts", "jrw");
                if (jm < 0 || jm > 15) {
                    jm = 15;
                }
            }
        }
        tot[i] = t;
        lastEvil[i] = pe;
        join[i] = jm;
        g_dealStatT[q] = t;
        g_dealJoin[q] = jm;
    }
    // 恶魔位（军团 / 小怪宝跳过）
    if (demonRole != 94 && demonRole != 112 && BOTC_RoleTeam(demonRole) == 3) {
        // 【加权随机，而不是取最高分】（用户 2026-11-06）：多人同为 10 场以上时轮流当恶魔
        bestScore = 0;
        for (i = 0; i < n; i += 1) {
            bestScore = bestScore + BOTC_DealSeatWeight(tot[i], lastEvil[i], BOTC_JrBit(join[i], 3));
        }
        best = 0;
        sc = RandomInt(1, bestScore);
        for (i = 0; i < n; i += 1) {
            sc = sc - BOTC_DealSeatWeight(tot[i], lastEvil[i], BOTC_JrBit(join[i], 3));
            if (sc <= 0) {
                best = i;
                break;
            }
        }
        tmp = g_scrSeat[0]; g_scrSeat[0] = g_scrSeat[best]; g_scrSeat[best] = tmp;
        tmp = tot[0]; tot[0] = tot[best]; tot[best] = tmp;
        tmp = lastEvil[0]; lastEvil[0] = lastEvil[best]; lastEvil[best] = tmp;
        tmp = join[0]; join[0] = join[best]; join[best] = tmp;
    }
    if (demonRole == 94 || demonRole == 135) {
        return;
    }
    take = 1;
    minionN = g_mcTab[n];
    if (demonRole == 112) {
        take = 0;                  // 恶魔那一格也会变成爪牙，一起参与爪牙偏好
        minionN = minionN + 1;
    }
    for (j = 0; j < minionN; j += 1) {
        // 【加权随机，而不是取最高分】（用户 2026-11-06）：多个 5 场以上的玩家轮流当爪牙
        bestScore = 0;
        for (i = take; i < n; i += 1) {
            bestScore = bestScore + BOTC_DealSeatWeight(tot[i], lastEvil[i], BOTC_JrBit(join[i], 2));
        }
        best = take;
        sc = RandomInt(1, bestScore);
        for (i = take; i < n; i += 1) {
            sc = sc - BOTC_DealSeatWeight(tot[i], lastEvil[i], BOTC_JrBit(join[i], 2));
            if (sc <= 0) {
                best = i;
                break;
            }
        }
        tmp = g_scrSeat[take]; g_scrSeat[take] = g_scrSeat[best]; g_scrSeat[best] = tmp;
        tmp = tot[take]; tot[take] = tot[best]; tot[best] = tmp;
        tmp = lastEvil[take]; lastEvil[take] = lastEvil[best]; lastEvil[best] = tmp;
        tmp = join[take]; join[take] = join[best]; join[best] = tmp;
        take = take + 1;
    }
}

// 随机发牌（说书人用）：按人数配比抽身份；抽到酒鬼时多抽一个镇民当他看到的身份，并打上"是酒鬼"
void BOTC_Deal () {
    int n;
    int tc;
    int oc;
    int mc;
    int i;
    int k;
    int pos;
    int s;
    int pick;
    int drunkSeat;
    int extra;
    int baron;
    int godfather;
    int demonPick;                 // 【方古（68）/ 亡骨魔（69）】：这两只恶魔要改配比
    int poppy;                     // 【军团局 · 罂粟种植者（86）】：本局是否按概率钉进善良角色
    int bounty;                    // 【军团局 · 赏金猎人（90）】：0 无 / 1 直接加入 / 2 酒鬼以为自己是赏金猎人
    int lunN;                      // 【疯子 · 认知恶魔】：剧本里除真恶魔外还有几种恶魔
    int lunAlt;                    // 【疯子 · 认知恶魔】：疯子改认知时挑到的恶魔
    int realDemon;                 // 【疯子 · 认知恶魔】：本局真恶魔，疯子以为的身份可以和它不同
    int balloon;                   // 【气球驾驶员（72）】：这局掷到「+1」就要把他钉进场
    int balFound;                  // 【气球驾驶员（72）】：他有没有被抽进镇民池
    int lg;
    int gd;
    int rb;
    int ocG;
    int r;
    int wudSeat;                   // 【悟道者（118）】他坐在哪个格子（用户 2026-10-16）
    int wudRole;                   // 【悟道者（118）】发给他「以为」的那张外来者卡
    int ei;                        // 【多个酒鬼 / 悟道者】逐个认知偏差的循环下标
    int drunkN;                    // 【多个酒鬼】本局实际发到座位的酒鬼人数
    int wudN;                      // 【多个悟道者】本局实际发到座位的悟道者人数
    int[16] drunkSeats;            // 【多个酒鬼】每个酒鬼的座位
    int[16] wudSeats;              // 【多个悟道者】每个悟道者的座位
    int q;
    int candN;
    int infCount;                  // 【持续信息角色】本局已选到的个数
    int infTarget;                 // 【持续信息角色】目标个数
    int tier;                      // 【解谜大师醉酒】目标优先级档位（用户 2026-11-03）
    int slot;
    int goodN;
    int goodSeatN;
    int amnScore;                  // 【失忆者（73）】按场次权重挑座位时的总权重（用户 2026-11-10）
    int amnBest;                   // 【失忆者（73）】加权抽到的座位下标
    int amnSc;                     // 【失忆者（73）】加权抽签的滚动值
    int candW;                     // 【竞选角色类型】加权抽善良角色时的累计权重
    int joinW;                     // 【竞选角色类型】单个候选座位的权重
    int wantOut;                   // 【竞选角色类型】当前角色按哪一类竞选加权（见 BOTC_JrRoleType）
    int mrLo;                      // 【提线木偶竞选归类】参与重新分配爪牙位的起始下标
    int mrSeat;                    // 【提线木偶竞选归类】提线木偶当前所在的座位
    int mrSlot;                    // 【提线木偶竞选归类】加权抽到的座位下标
    int mrW;                       // 【提线木偶竞选归类】单个候选座位的权重
    int mrTotal;                   // 【提线木偶竞选归类】候选座位的总权重
    int mrSc;                      // 【提线木偶竞选归类】加权抽签的滚动值
    int sentAdj;                   // 【哨兵（88）】：这一局实际生效的 -1 / 0 / +1
    bool wantNew;
    bool seatNew;
    int psy;                       // 【精神病患者联动】本局是否分到了精神病患者（84）
    int hasPair;                   // 【精神病患者联动】本局是否已经有魔像（81）或罂粟种植者（86）
    int pairPick;                  // 【精神病患者联动】这次决定补哪个角色
    int[16] outR;
    int[16] goodR;
    int[16] goodSeat;
    int hfK;                       // 【堤丰之首（111）】连续邪恶座位段长度
    int hfMid;                     // 【堤丰之首（111）】恶魔在这一段里的位置（正中）
    int hfDi;                      // 【堤丰之首（111）】恶魔座位在圆桌座位表里的下标
    int hfCnt;                     // 【堤丰之首（111）】回填座位序时的下标
    int hfRestN;                   // 【堤丰之首（111）】这一段之外的座位数
    int hfJ;                       // 【堤丰之首（111）】循环下标
    bool hfIn;                     // 【堤丰之首（111）】该座位是否已在邪恶段里
    int[16] hfBlock;               // 【堤丰之首（111）】邪恶段座位
    int[16] hfRest;                // 【堤丰之首（111）】邪恶段之外的座位

    // 【已下发状态点随机配板 → 先自动取消下发】（用户 2026-11-10）
    if (g_dealConfirmed) {
        BOTC_CancelDeal();
    }
    BOTC_ResetGameVars();          // 换局：先把上一局的记录（主谋加时 / 概率 / 假死...）清干净
    g_lgDealGood = false;          // 重新发牌：上一次军团局的善良角色过滤标记先清掉
    g_lgNoBounty = false;          // 重新发牌：上一次军团局「不抽赏金猎人」的标记先清掉
    // 【无神论者】（用户 2026-11-12）：配板前先掷一次，决定本局有没有无神论者（83）。
    //   有无神论者时本局没有邪恶，会改变阵营的角色只保留 5% 概率（见 BOTC_PickBoardRole）。
    g_athDeal = false;
    if (BOTC_BoardHasRole(83) && BOTC_DealAtheistKeep(25)) {
        g_athDeal = true;
    }
    poppy = 0;                     // 重新发牌：军团局的罂粟种植者标记先清掉
    bounty = 0;                    // 重新发牌：军团局的赏金猎人标记先清掉
    // 【随机发牌 · 清空上一次的提示】（用户 2026-11-04 / 2026-11-06）：反复随机发牌不把说书人私聊窗刷满
    BOTC_PmDealClear(g_teller);
    g_dealConfirmed = false;       // 重新发牌：之前那次【确认发放】作废
    BOTC_GrimShareRender();        // 重新发牌时先收起上一轮的测试发送按钮
    BOTC_KickEnd();                // 【投票踢人】换局收尾：清状态 + 收起那个对话框（用户 2026-10-02）
    // 【不在场身份也要清空】（用户 2026-10-02）：上一把恶魔 / 疯子那 3 个不在场身份会留到下一把 ----
    //   注意：玩家（恶魔 / 疯子 / 食人族）手上那份**是同一个对话框按玩家渲染的**，所以除了清数据，
    //   还要把「收到过」的那几个玩家那份**刷空 + 收掉**，否则下一把还挂着旧的三格（用户报的就是这个）。
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
        g_bluffOut[i] = 0;
    }
    // 【最新一份也要清】（用户 2026-11-04）：上一局按玩家记下的 3 个身份不能带进下一局
    for (i = 1; i <= 13; i += 1) {
        g_bluffGiveRole[(i * 3)] = 0;
        g_bluffGiveRole[(i * 3) + 1] = 0;
        g_bluffGiveRole[(i * 3) + 2] = 0;
    }
    // ⚠【发送给所有恶魔】会一次发给好几个玩家、不记 g_bluffTarget，所以这里干脆把 2..13 全刷一遍：
    //   先把他们那份刷成空的 3 格（数据已经清了），再把面板收掉。
    for (i = 2; i <= 13; i += 1) {
        BOTC_BluffRowRender(i);
        DialogSetVisible(g_bluffDlg, PlayerGroupSingle(i), false);
        g_bluffGot[i] = false;
    }
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    g_bluffSent = false;
    g_bluffTarget = 0;
    g_bluffTargetL = 0;
    g_bluffTargetC = 0;
    g_bluffTargetP = 0;
    g_availN = 0;
    BOTC_BluffRender();                                        // 收到过不在场身份的玩家那份：刷成空的 3 格
    // 【保留右下角不在场身份面板】（用户 2026-11-05）：手动发送入口继续使用这块面板。
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟教父一样每局掷一次 50/50（+0 / +1 外来者）
    if (g_balPlusSeeded == false) {
        g_balPlus = (RandomInt(1, 2) == 1);
        g_balPlusSeeded = true;
    }
    if (g_gfPlusSeeded == false) {
        g_gfPlus = (RandomInt(1, 2) == 1);
        g_gfPlusSeeded = true;
    }
    // 【村夫（105）】（用户 2026-10-10 / 2026-11-03）：剧本卡 [+0~2 村夫] —— 每局摇一次骰子。
    //   用户 2026-11-03：尽量不要同时出现 3 名村夫 → 1 名 40% / 2 名 40% / 3 名 20%。
    if (g_villRollSeeded == false) {
        k = RandomInt(1, 100);
        if (k <= 40) {
            g_villRoll = 0;                    // 本局 1 名村夫
        }
        else if (k <= 80) {
            g_villRoll = 1;                    // 本局 2 名村夫
        }
        else {
            g_villRoll = 2;                    // 本局 3 名村夫（小概率）
        }
        g_villRollSeeded = true;
    }
    // 先按在场人数把圆桌摆好，顺便算出参与座位表（空位不会被算进来）
    BOTC_GrimRelayout();
    n = g_seatN;
    tc = g_tcTab[n];
    oc = g_ocTab[n];
    mc = g_mcTab[n];
    g_boomKeepPick = false;
    g_boomVoteOn = false;
    if (g_boomTellerBtn != 0) {
        DialogControlSetVisible(g_boomTellerBtn, PlayerGroupAll(), false);
    }
    g_boomSeat = 0;
    g_boomResult = false;

    for (i = 2; i <= 13; i += 1) {
        g_mark[(g_teller * 14) + i] = 0;
        // 【玩家离开游戏】那条公聊提示：新一局重新记账（用户 2026-10-02）
        g_leftShown[i] = false;
        g_kickVote[i] = 0;             // 【投票踢人】的票也一起清（用户 2026-10-02）
        g_exec[i] = false;
        g_regTeam[i] = -1;
        g_regAlign[i] = -1;
        g_seatPrevAlign[i] = -1;
        g_seatPrevRole[i] = -1;
        g_claim[i] = -1;
        g_herring = 0;
        g_ftPick[i] = false;
        g_ftFirst[i] = 0;
        g_awake[i] = false;
        g_skillPicking[i] = false;
        g_limitedAsk[i] = false;
        g_poAsk[i] = false;
        g_skillRoleSel[i] = 0;
        g_boomKeep[i] = false;
        g_boomVote[i] = 0;
        g_boomCount[i] = 0;
        g_skillT1[i] = 0;
        g_skillT2[i] = 0;
        BOTC_ClearDeath(i);      // 死亡类型（夜间 / 白天 / 处决 / 恶魔杀）一起清掉
        for (k = 0; k < 256; k += 1) {          // 表已经扩到 256：新加的 token 也要清
            g_tokOn[(((g_teller * 14) + i) * 256) + k] = false;
        }
    }
    // 【说书人格的离开提示也归零】（用户 2026-11-01）：座位保留标志已在本函数开头清过
    g_leftShown[1] = false;
    // 重新发牌 = 新的一局：隔夜技能记录和「传位解锁」一起清掉
    BOTC_NightSkillReset();
    g_promoteOpen = false;
    for (i = 0; i <= 13; i += 1) {
        g_poisonAt[i] = 0;
        g_poisonDayBy[i] = 0;
    }
    BOTC_SpyPeekEnd();      // 间谍的魔典要是还摊在看说书人那份，先换回他自己那份
    BOTC_GrimResetPerPlayer();
    g_butlerSeat = 0;
    g_butlerMaster = 0;
    BOTC_WinClose();          // 上一把的胜负横幅收掉
    g_gameOver = false;
    BOTC_MusicDropPrio(0);    // 重新发牌＝新的一局：把胜利曲那层最高优先级放开，好让选板子的音乐进来
    BOTC_PromoteHide();       // 上一把的传位面板也收掉
    BOTC_SlayAskHide();       // 上一把没答完的【猎手请求】也收掉
    BOTC_MayorClear();        // 镇长那条挂起的死亡也收掉
    for (i = 0; i <= 13; i += 1) {
        g_declarePick[i] = false;
        g_declareUsed[i] = false;      // 新一局：声称次数重新给
        g_guessKind[i] = 0;
        g_pedantGuessUsed[i] = false;
        g_puzzleGuessUsed[i] = false;
        g_guessRoleDay[i] = -1;          // 全员追忆 · 猜角色：新局重置日期戳
        g_guessRoleDone[i] = false;      // 全员追忆 · 猜角色：新局重置"已猜对"标记
        g_guessRoleAllDone = false;      // 全员追忆 · 猜角色：新局重新开始播报
        g_juggBookN[i] = 0;
        g_deadVoteUsed[i] = false;     // 新一局：死人票重新给
        g_voteWasDead[i] = false;
        g_bansheePower[i] = false;
        g_bansheeSecondNom[i] = false;
        g_psyDone[i] = false;
        g_psyDay[i] = -1;
        g_moonClaimed[i] = false;         // 月之子：新一局重新获得声称机会
        g_klutzClaimed[i] = false;        // 呆瓜：新一局重新获得声称机会
        g_alsaOpen[i] = false;
        g_alsaDay[i] = -1;
        g_alcClaimDay[i] = 0;          // 炼金术士：新一局重新统计每日声称
        g_rascalActive[i] = false;
        g_rascalRole[i] = 0;
        g_pedantActing[i] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 171] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 173] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 174] = false;
        g_pedantDoneNight = 0;
        g_pedantInfoNight = 0;
        g_vixenSeat = 0;
        g_vixenTarget = 0;
        g_vixenInfoSent = false;
        g_vixenExecPending = false;
        g_vixenExecNight = 0;
        g_vixenDoneNight = 0;
        g_vixenMarkerState = 0;
        g_gossipDay[i] = -1;
        g_psyDeclare[i] = false;
        g_cultDeclDone[i] = false;     // 异教领袖（106）：新一局，声称次数重新给（用户 2026-10-11）
        g_damselPick[i] = false;
        g_damselDone[i] = false;
    }
    g_damselFailed = false;
    g_finalPushDone = 0;
    g_finalRepDone = false;
    g_damselSpySeen = false;
    g_damselWidowSeen = false;
    g_slayAskPsy = false;

    BOTC_HdHide();
    BOTC_DeclareRender();
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    g_deadPick = false;
    g_execUsedToday = false;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    BOTC_BigHintHide(0);       // 新一局：顺手收掉长驻提示（全场）
    for (i = 0; i < 164; i += 1) {
        g_scrUsed[i] = false;
    }

    // 参与座位洗牌（用的是真实座位号，中间有空位也不会错位）
    for (i = 0; i < n; i += 1) {
        g_scrSeat[i] = g_seatList[i];
    }
    for (i = 0; i < n; i += 1) {
        k = RandomInt(i, n - 1);
        s = g_scrSeat[i];
        g_scrSeat[i] = g_scrSeat[k];
        g_scrSeat[k] = s;
    }

    pos = 0;
    // 恶魔：从当前板子的角色清单里抽（暗流涌动 = 小恶魔；黯月初升 = 僵怖 / 普卡 / 沙巴洛斯 / 珀）
    pick = BOTC_PickBoardRole(3);
    demonPick = pick;              // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：配比要跟着改
    // 【无神论者 · 军团局不适用】（用户 2026-11-12）：军团局没有「本局没有邪恶」这套配比，直接取消。
    if (demonPick == 94) {
        g_athDeal = false;
    }
    if (pick < 0) {
        pick = BOTC_PickUnused(21, 21);
    }
    // 【堤丰之首（111）】（用户 2026-11-13）：设置 +1 爪牙 ----
    //   不再靠事后把一名善良玩家改成爪牙再换座位：这里直接在配比里多抽一名爪牙、
    //   少发一个善良角色，后面按「邪恶相邻、恶魔居中」的座位序发牌。
    if (pick == 111) {
        mc = mc + 1;
        if (tc > 0) {
            tc = tc - 1;
        }
        else if (oc > 0) {
            oc = oc - 1;
        }
    }
    // 【座位优先序】（用户 2026-11-03）：恶魔 / 爪牙座位按总场数和上一场阵营重新排位
    BOTC_DealSeatOrder(pick);
    // 【堤丰之首（111）】（用户 2026-11-13）：邪恶全部邻座、恶魔坐正中 ----
    //   不换座位：只重排「发牌座位序」，让恶魔 / 全部爪牙落在圆桌上一段连续的座位里，
    //   恶魔占这一段的正中（偶数名邪恶时取中间偏左那个位）。
    if (pick == 111) {
        hfK = mc + 1;
        if (hfK > n) {
            hfK = n;
        }
        hfMid = (hfK - 1) / 2;
        hfDi = -1;
        for (i = 0; i < n; i += 1) {
            if (g_seatList[i] == g_scrSeat[0]) {
                hfDi = i;
            }
        }
        if (hfDi >= 0 && hfK >= 1) {
            for (i = 0; i < hfK; i += 1) {
                hfBlock[i] = g_seatList[(hfDi - hfMid + i + n + n) % n];
            }
            hfRestN = 0;
            for (i = 0; i < n; i += 1) {
                q = g_seatList[i];
                hfIn = false;
                for (hfJ = 0; hfJ < hfK; hfJ += 1) {
                    if (hfBlock[hfJ] == q) {
                        hfIn = true;
                    }
                }
                if (!hfIn) {
                    hfRest[hfRestN] = q;
                    hfRestN = hfRestN + 1;
                }
            }
            g_scrSeat[0] = hfBlock[hfMid];
            hfCnt = 0;
            for (i = 0; i < hfK; i += 1) {
                if (i == hfMid) {
                    continue;
                }
                hfCnt = hfCnt + 1;
                g_scrSeat[hfCnt] = hfBlock[i];
            }
            for (i = 0; i < hfRestN; i += 1) {
                g_scrSeat[hfK + i] = hfRest[i];
            }
        }
    }
    g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
    pos = pos + 1;
    if (demonPick == 94) {
        g_scrUsed[93] = true;
        rb = RandomInt(0, 2);
        lg = tc + oc - rb;
        // 【军团数量 7~9】（用户 2026-11-10）：放开上限，12 人局可出 7~9 名军团；
        //   善良角色 = 人数 - 军团数，外来者仍然最多 1 名。
        if (lg > 9) {
            lg = 9;
        }
        if (lg < 1) {
            lg = 1;
        }
        gd = n - lg;
        // 【善良角色里至多 1 名外来者】（用户 2026-11-06）：外来者数量只能是 0 或 1，
        //   可以整场没有外来者；gd > 1 时抽到 1 名外来者也保证至少保留 1 名镇民。
        ocG = 0;
        if (oc > 0 && gd > 1) {
            ocG = RandomInt(0, 1);
        }
        mc = 0;
        tc = gd - ocG;
        oc = ocG;
        // 【军团局 · 罂粟种植者】（用户 2026-11-10）：初始军团越多，罂粟种植者出现概率越高。
        //   军团 7 / 8 / 9 名 → 25% / 50% / 75%；板子里没有罂粟或没有镇民位时跳过。
        poppy = 0;
        if (tc > 0 && g_scrUsed[86] == false && BOTC_BoardHasRole(86)) {
            k = RandomInt(1, 100);
            if (lg >= 9) {
                if (k <= 75) {
                    poppy = 1;
                }
            }
            else {
                if (lg == 8) {
                    if (k <= 50) {
                        poppy = 1;
                    }
                }
                else {
                    if (k <= 25) {
                        poppy = 1;
                    }
                }
            }
            if (poppy == 1) {
                BOTC_PmStore(g_teller, "【配比】军团 " + IntToString(lg) + " 名 → 罂粟种植者本局在场。");
            }
        }
        // 【军团局 · 赏金猎人】（用户 2026-11-10）：
        //   军团 7 名 → 小概率直接加入赏金猎人（镇民位）；
        //   军团 8 / 9 名 → 不抽真牌，极低概率改成「酒鬼以为自己是赏金猎人」。
        g_lgNoBounty = false;
        bounty = 0;
        if (lg >= 8) {
            g_lgNoBounty = true;
        }
        if (g_scrUsed[90] == false && BOTC_BoardHasRole(90)) {
            k = RandomInt(1, 100);
            if (lg == 7) {
                if (k <= 25 && tc > 0) {
                    bounty = 1;
                }
            }
            else {
                if (lg >= 8 && k <= 5 && gd > 1 && BOTC_BoardHasRole(14)) {
                    bounty = 2;
                }
            }
        }
        // 【军团局降低特定善良角色出现概率】（用户 2026-11-06）：从下面两个抽取循环开始生效。
        g_lgDealGood = true;
        for (i = 1; i < lg; i += 1) {
            g_mark[(g_teller * 14) + g_scrSeat[pos]] = 95;
            pos = pos + 1;
        }
        BOTC_PmStore(g_teller, "【配比】军团在场 → 军团 " + IntToString(lg) + " 名、善良 " + IntToString(gd) + " 名（镇民 " + IntToString(tc) + " / 外来者 " + IntToString(oc) + "）。");
    }
    // 爪牙：同样按板子抽（男爵 = 20，只有暗流涌动有他）
    baron = 0;
    godfather = 0;
    mrLo = 1;                      // 【提线木偶竞选归类】0 号格默认是恶魔，小怪宝局才一起参与
    for (i = 0; i < mc; i += 1) {
        pick = BOTC_PickBoardRole(2);
        if (pick < 0) {
            pick = BOTC_PickUnused(17, 20);
        }
        if (pick == 20) {
            baron = 1;
        }
        if (pick == 39) {
            godfather = 1;                   // 教父（39）：配比要 ±1 外来者
        }
        g_mark[(g_teller * 14) + g_scrSeat[pos]] = pick + 1;
        pos = pos + 1;
    }
    // 男爵能力：两名镇民替换为两名外来者
    if (baron == 1) {
        tc = tc - 2;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 2;
    }
    // 教父（39）：[-1 或 +1 外来者]（用户 2026-09-20：50/50，照男爵这套写）
    if (godfather == 1) {
        if (g_gfPlus) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
        else {
            if (oc > 1) {
                oc = oc - 1;
                tc = tc + 1;
            }
	// 【教父配比文本】（用户 2026-09-23）：改回跟方古同款，按这局实际掷到的方向写
	if (g_gfPlus) {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 +1、镇民 -1。");
	}
	else {
		BOTC_PmStore(g_teller, "【配比】教父在场 → 外来者 -1、镇民 +1。");
	}
        }
    }
    // 【方古（68）/ 亡骨魔（69）】（用户 2026-09-21）：方古 让外来者 +1、镇民 -1；亡骨魔 让外来者 -1、镇民 +1
    if (demonPick == 68) {
        tc = tc - 1;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 1;
        BOTC_PmStore(g_teller, "【配比】方古在场 → 外来者 +1、镇民 -1。");
    }
    if (demonPick == 69) {
        if (oc > 1) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】亡骨魔在场 → 外来者 -1、镇民 +1。");
    }
    if (demonPick == 154) {
        tc = tc - 1;
        if (tc < 0) {
            tc = 0;
        }
        oc = oc + 1;
        BOTC_PmStore(g_teller, "【配比】饕餮在场 → 外来者 +1、镇民 -1。");
    }
    // 【赶尸人（126）】：[-1 外来者]
    // 【设置调整只认真身】（用户 2026-11-12）：以为自己是赶尸人的不触发
    if (BOTC_SeatOfRole(126) >= 2) {
        if (oc > 0) {
            oc = oc - 1;
            tc = tc + 1;
        }
        BOTC_PmStore(g_teller, "【配比】赶尸人在场 → 外来者 -1、镇民 +1。");
    }
    // 【小怪宝（112）】（用户 2026-10-10）：随机发牌抽到小怪宝 → **把他移除**，那一格（恶魔位）改发一个爪牙；
    //   小怪宝本人不会发到任何玩家手里（只有疯子「以为自己是小怪宝」时才可能出现在魔典上）。
    //   于是这一局没有「真身是恶魔」的玩家 —— 恶魔身份完全靠「是恶魔（小怪宝）」那枚 token（说书人自己挪）。
    if (demonPick == 112) {
        r = BOTC_PickBoardRole(2);
        if (r < 0) {
            r = BOTC_PickUnused(17, 20);
        }
        g_mark[(g_teller * 14) + g_scrSeat[0]] = r + 1;      // 恶魔那一格（第 0 个座位）改成爪牙
        demonPick = r;
        g_lmOn = true;
        mrLo = 0;                  // 【提线木偶竞选归类】恶魔那一格也变成爪牙，一起参与重排
        BOTC_PmStore(g_teller, "【小怪宝】发牌抽到他 → 已移除：恶魔那一格改发爪牙（" + g_roleName[r] + "）。");
    }
    // 【提线木偶的竞选归类】（用户 2026-11-11）：提线木偶（93）以为自己抽到的是镇民或外来者，
    //   所以爪牙牌发下去之后，再在爪牙座位之间按「镇民 / 外来者竞选」加权重挑一格
    //   （参与镇民或外来者任一类即 ×1.5）；他仍然是爪牙，只是落在哪个座位换了。
    mrSeat = 0;
    mrSlot = -1;
    mrTotal = 0;
    for (i = mrLo; i <= mc; i += 1) {
        q = g_scrSeat[i];
        if (g_mark[(g_teller * 14) + q] == 94) {
            mrSeat = q;
        }
        mrW = 2;
        if (BOTC_JrBit(g_dealJoin[q], 0) == 1 || BOTC_JrBit(g_dealJoin[q], 1) == 1) {
            mrW = 3;
        }
        mrTotal = mrTotal + mrW;
    }
    if (mrSeat >= 2 && mrTotal > 0) {
        mrSc = RandomInt(1, mrTotal);
        for (i = mrLo; i <= mc; i += 1) {
            q = g_scrSeat[i];
            mrW = 2;
            if (BOTC_JrBit(g_dealJoin[q], 0) == 1 || BOTC_JrBit(g_dealJoin[q], 1) == 1) {
                mrW = 3;
            }
            mrSc = mrSc - mrW;
            if (mrSc <= 0) {
                mrSlot = i;
                break;
            }
        }
        if (mrSlot >= 0) {
            q = g_scrSeat[mrSlot];
            if (q != mrSeat) {
                mrW = g_mark[(g_teller * 14) + q];
                g_mark[(g_teller * 14) + q] = 94;
                g_mark[(g_teller * 14) + mrSeat] = mrW;
            }
        }
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：他是镇民，抽牌之前定不了他会不会在场，
    //   而这局掷到「+1」就必须外来者 +1、镇民 -1（不然提示写着 +1，牌面却只有一个外来者）。
    //   所以掷到 +1 就直接把他钉进场：配比先改，抽镇民的时候再把他塞进池子。
    balloon = 0;
    if (g_balPlus) {
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            if (g_boardRole[(g_board * 256) + i] == 72) {
                balloon = 1;
            }
        }
        if (balloon == 1) {
            tc = tc - 1;
            if (tc < 0) {
                tc = 0;
            }
            oc = oc + 1;
            BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 外来者 +1、镇民 -1。");
        }
    }
    // 【哨兵（88）】（用户 2026-09-26 / 2026-11-08）：被加进本局时，随机导致外来者 -1 / 不变 / +1 ----
    //   每次随机发牌重掷（跟教父 / 气球驾驶员一样，换局由 BOTC_ResetGameVars 放开骰子）。
    //   无论掷到哪一档，外来者数量都必须保持在 1..4 名、镇民至少留 1 名，放不下就按「不变」处理。
    sentAdj = 0;
    if (g_legacyOn[88]) {
        if (g_sentSeeded == false) {
            k = RandomInt(1, 3);           // 1 = -1，2 = 不变，3 = +1
            g_sentAdjust = 0;
            if (k == 1) {
                g_sentAdjust = -1;
            }
            if (k == 3) {
                g_sentAdjust = 1;
            }
            g_sentSeeded = true;
        }
        sentAdj = g_sentAdjust;
        if (sentAdj > 0 && (oc + sentAdj > 4 || tc - sentAdj < 1)) {
            sentAdj = 0;
        }
        if (sentAdj < 0 && oc + sentAdj < 1) {
            sentAdj = 0;
        }
        g_sentAdjust = sentAdj;
        tc = tc - sentAdj;
        oc = oc + sentAdj;
        if (sentAdj > 0) {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 +1、镇民 -1。");
        }
        else if (sentAdj < 0) {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者 -1、镇民 +1。");
        }
        else {
            BOTC_PmStore(g_teller, "【配比】哨兵在场 → 外来者数量不变。");
        }
    }
    // 【外来者数量收敛】（用户 2026-11-03 / 2026-11-11）：
    //   0 个 / 4 个只小概率出现（各 25%），大概率落在 1..3 个；
    //   5 个及以上一律不出现：先压回 4 名，再按 4 名的概率决定保留 4 还是改成 3。
    //   军团局（94）另有「外来者最多 1 名」的规则，跳过这一段。
    if (demonPick != 94) {
        if (oc > 4) {
            tc = tc + (oc - 4);
            oc = 4;
            BOTC_PmStore(g_teller, "【配比】外来者数量过多 → 已调整为 4 名（多出的名额改发镇民）。");
        }
        if (oc == 4) {
            if (RandomInt(1, 100) > 25) {
                oc = 3;
                tc = tc + 1;
                BOTC_PmStore(g_teller, "【配比】外来者数量偏多 → 已调整为 3 名（多出的名额改发镇民）。");
            }
        }
        if (oc < 1 && tc > 1) {
            if (RandomInt(1, 100) > 25) {
                oc = 1;
                tc = tc - 1;
                BOTC_PmStore(g_teller, "【配比】外来者数量过少 → 已调整为 1 名（少发的镇民改为外来者）。");
            }
        }
    }
    // 【外来者：按板子抽（酒鬼 = 14）；先记进 outR，最后和镇民一起按「萌新优先」发到座位】
    // 【军团局：外来者最多 1 名】（用户 2026-11-10）：气球驾驶员 / 哨兵等后续配比调整
    //   也不能把军团局的外来者顶到 2 名，多出来的名额改回镇民。
    if (demonPick == 94 && oc > 1) {
        tc = tc + (oc - 1);
        oc = 1;
    }
    // 【军团局 · 酒鬼赏金猎人】（用户 2026-11-10）：8 / 9 名军团时，极低概率保留 1 个外来者位给酒鬼
    if (demonPick == 94 && bounty == 2) {
        if (oc < 1) {
            if (tc > 1) {
                oc = 1;
                tc = tc - 1;
            }
            else {
                bounty = 0;            // 没有镇民位可换，放弃
            }
        }
    }
    drunkSeat = 0;
    for (i = 0; i < oc; i += 1) {
        if (bounty == 2 && i == 0) {
            outR[0] = 14;              // 酒鬼：以为自己是赏金猎人
            g_scrUsed[14] = true;
        }
        else {
            pick = BOTC_PickBoardRole(1);
            if (pick < 0) {
                pick = BOTC_PickUnused(13, 16);
            }
            outR[i] = pick;
        }
    }
    // 镇民（索引0..12）
    // 【无神论者局 · 多个酒鬼】（用户 2026-11-12）：每个酒鬼各补一张他看到身份的镇民；
    //   非无神论者局酒鬼仍唯一，最多只有 1 份。
    extra = 0;
    for (i = 0; i < oc; i += 1) {
        if (outR[i] == 14) {
            extra = extra + 1;
        }
    }
    if (extra > 15 - tc) {
        extra = 15 - tc;               // g_scrRole 只有 16 格，额外身份不能越界
    }
    for (i = 0; i < tc; i += 1) {
        if (poppy == 1 && i == 0) {
            g_scrRole[0] = 86;             // 【军团局】按概率钉进罂粟种植者
            g_scrUsed[86] = true;
        }
        else {
            g_scrRole[i] = BOTC_PickBoardRole(0);
            if (g_scrRole[i] < 0) {
                g_scrRole[i] = BOTC_PickUnused(0, 12);
            }
        }
    }
    // 军团局的善良角色已经抽完，后面的额外身份 / 配比调整不再做概率过滤。
    g_lgDealGood = false;
    // 【酒鬼的额外身份牌】（用户 2026-11-03）：优先一次性信息者 / 只能发动一次技能的角色；
    //   小概率持续信息位（不算进持续信息角色保底）；尽量避开无法试探自己的纯被动角色。
    // 【无神论者局 · 多个酒鬼】（用户 2026-11-12）：每名酒鬼各自抽一张「以为自己是」的镇民卡。
    for (ei = 0; ei < extra; ei += 1) {
        pick = BOTC_BiasRolePick(0, -1);
        if (pick >= 0) {
            g_scrRole[tc + ei] = pick;
            g_scrUsed[pick] = true;
        }
        else {
            // 【认知偏差不与在场角色重复】（用户 2026-11-03）：从板子里挑一张本局还没用过的镇民，
            //   不能再退回「随机 0..12」而抽到已经在场的身份。
            candN = 0;
            pick = -1;
            for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
                r = g_boardRole[(g_board * 256) + i];
                if (r < 0 || r > 163) {
                    continue;
                }
                if (BOTC_RoleTeam(r) != 0) {
                    continue;
                }
                // 【无神论者局 · 允许重复】（用户 2026-11-12）：无神论者局酒鬼的假身份也可以撞上在场镇民。
                if (g_scrUsed[r] && !(g_athDeal && !BOTC_DealRoleSingleton(r))) {
                    continue;
                }
                // 【酒鬼无神论概率提到 5%】（用户 2026-11-12）：酒鬼认知「无神论者」按 5% 保留。
                if (r == 83 && !BOTC_DealAtheistKeep(5)) {
                    continue;
                }
                candN = candN + 1;
                if (RandomInt(1, candN) == 1) {
                    pick = r;
                }
            }
            if (pick >= 0) {
                g_scrRole[tc + ei] = pick;
                g_scrUsed[pick] = true;
            }
            else {
                g_scrRole[tc + ei] = 0;
            }
        }
        if (g_scrRole[tc + ei] == 118 || g_scrRole[tc + ei] < 0) {
            g_scrRole[tc + ei] = 0;                    // 认知覆盖互斥：兜底洗衣妇
            BOTC_PmStore(g_teller, "【认知覆盖】酒鬼的额外身份找不到合适的卡 → 兜底「洗衣妇」。");
        }
    }
    // 【军团局 · 酒鬼赏金猎人】（用户 2026-11-10）：8 / 9 名军团时极低概率的酒鬼认知
    if (bounty == 2 && extra >= 1 && BOTC_BoardHasRole(90)) {
        if (g_scrRole[tc] != 90) {
            if (g_scrRole[tc] >= 0) {
                g_scrUsed[g_scrRole[tc]] = false;
            }
            g_scrRole[tc] = 90;
            g_scrUsed[90] = true;
        }
        BOTC_PmStore(g_teller, "【配比】军团 " + IntToString(lg) + " 名 → 加入「酒鬼·赏金猎人」（酒鬼以为自己是赏金猎人）。");
    }
    // 军团局「不抽赏金猎人」只限制真实牌，酒鬼的认知处理完就放开。
    g_lgNoBounty = false;
    // 【气球驾驶员（72）】：掷到 +1 的时候他已经被钉进场了，这里把他塞进镇民池（随机顶掉一个，
    //   酒鬼那份额外身份在 g_scrRole[tc]，不动它）
    if (balloon == 1) {
        balFound = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 72) {
                balFound = 1;
            }
        }
        if (balFound == 0 && tc > 0) {
            k = RandomInt(0, tc - 1);
            // 【军团局】罂粟种植者占着第 0 格时，气球驾驶员尽量顶掉别的镇民
            if (poppy == 1 && k == 0 && tc > 1) {
                k = RandomInt(1, tc - 1);
            }
            if (poppy == 1 && k == 0) {
                poppy = 0;               // 只有一格镇民位：气球驾驶员优先
            }
            if (g_scrRole[k] >= 0) {
                g_scrUsed[g_scrRole[k]] = false;
            }
            g_scrRole[k] = 72;
            g_scrUsed[72] = true;
        }
    }
    // 【村夫（105）】（用户 2026-10-10）：[+0~2 村夫] —— 本局的村夫总数 = 1 + 摇到的数（摇到 0 就只靠随机抽）。
    //   多出来的村夫顶掉一个别的镇民（跟气球驾驶员那条「钉进场」同一个做法）。
    if (BOTC_BoardHasRole(105) && g_villRoll > 0 && tc > 0) {
        k = 0;
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 105) {
                k = k + 1;
            }
        }
        k = 1 + g_villRoll - k;              // 还差几个才够
        for (i = 0; i < k; i += 1) {
            pick = RandomInt(0, tc - 1);
            // 【军团局】罂粟种植者占着第 0 格时，村夫尽量顶掉别的镇民
            if (poppy == 1 && pick == 0 && tc > 1) {
                pick = RandomInt(1, tc - 1);
            }
            if (poppy == 1 && pick == 0) {
                continue;                   // 只剩罂粟种植者那一格，村夫不再顶
            }
            if (g_scrRole[pick] == 105) {
                continue;                   // 这一格本来就是村夫
            }
            // 【设置调整只认真身】（用户 2026-11-12）：气球驾驶员掷到 +1 钉进场的那一格不顶掉
            if (g_balPlus && g_scrRole[pick] == 72) {
                continue;
            }
            if (g_scrRole[pick] >= 0) {
                g_scrUsed[g_scrRole[pick]] = false;
            }
            g_scrRole[pick] = 105;
            g_scrUsed[105] = true;
        }
        BOTC_PmStore(g_teller, "【配比】村夫摇骰子 → +" + IntToString(g_villRoll) + " 名村夫（本局村夫共 " + IntToString(1 + g_villRoll) + " 名）。");
    }
    // 【无神论者】（用户 2026-11-12）：本局掷到无神论者 → 钉进一个镇民位（顶掉随机一名镇民）。
    //   放在气球驾驶员 / 村夫这些「钉进场」之后，避免被它们顶掉；上面的抽取已经跳过 83。
    if (g_athDeal && tc > 0 && !g_scrUsed[83]) {
        k = RandomInt(0, tc - 1);
        if (g_scrRole[k] >= 0) {
            g_scrUsed[g_scrRole[k]] = false;
        }
        g_scrRole[k] = 83;
        g_scrUsed[83] = true;
        BOTC_PmStore(g_teller, "【配比】无神论者（83）本局在场。");
    }
    // 【持续信息角色保障】（用户 2026-11-03）：随机发牌时尽量保证善良阵营有 1~2 个
    //   每个夜晚 / 每个白天都能获得信息的角色；剧本里没有这类角色时自动跳过。
    infTarget = 2;
    if (tc < 2) {
        infTarget = tc;
    }
    infCount = 0;
    for (i = 0; i < tc; i += 1) {
        if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
            infCount = infCount + 1;
        }
    }
    while (infCount < infTarget) {
        pick = -1;
        candN = 0;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (!BOTC_RoleRecurringInfo(r)) {
                continue;
            }
            if (g_scrUsed[r] && !(g_athDeal && !BOTC_DealRoleSingleton(r))) {
                continue;
            }
            // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：兜底也不让两个克星同场
            if (r == 101 && g_scrUsed[100]) {
                continue;
            }
            if (r == 100 && g_scrUsed[101]) {
                continue;
            }
            candN = candN + 1;
            if (RandomInt(1, candN) == 1) {
                pick = r;
            }
        }
        if (pick < 0) {
            break;                       // 剧本里没有更多能持续获得信息的角色
        }
        slot = -1;
        for (i = 0; i < tc; i += 1) {
            if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                continue;
            }
            if (poppy == 1 && i == 0) {
                continue;                // 【军团局】罂粟种植者固定保留
            }
            if (g_scrRole[i] == 118) {
                continue;                // 保留悟道者，不拿它换
            }
            if (slot < 0) {
                slot = i;
            }
            else {
                if (RandomInt(1, 2) == 1) {
                    slot = i;
                }
            }
        }
        if (slot < 0) {
            break;
        }
        if (g_scrRole[slot] >= 0) {
            g_scrUsed[g_scrRole[slot]] = false;
        }
        g_scrRole[slot] = pick;
        g_scrUsed[pick] = true;
        infCount = infCount + 1;
    }
    // 【精神病患者联动】（用户 2026-11-03）：剧本里有精神病患者（84）、魔像（81）、罂粟种植者（86），
    //   且本局确实分到了精神病患者时，极大概率再补一名魔像或罂粟种植者。
    //   用户 2026-11-04：改为优先补魔像，补不进再改罂粟种植者。
    //   卡扎力（135）会把爪牙换成善良角色，这种情况跳过。
    psy = 0;
    if (g_scrUsed[84]) {
        psy = 1;
    }
    if (psy == 1 && demonPick != 135) {
        hasPair = 0;
        for (i = 0; i < oc; i += 1) {
            if (outR[i] == 81) {
                hasPair = 1;
            }
        }
        for (i = 0; i < tc; i += 1) {
            if (g_scrRole[i] == 86) {
                hasPair = 1;
            }
        }
        if (hasPair == 0 && RandomInt(1, 100) <= 85) {
            pairPick = -1;
            slot = -1;
            // 先试魔像：有外来者位就顶外来者（尽量避开酒鬼 14）；没有外来者位就把一个镇民改成魔像
            if (BOTC_BoardHasRole(81) && !g_scrUsed[81]) {
                slot = -1;
                if (oc > 0) {
                    for (i = 0; i < oc; i += 1) {
                        if (outR[i] == 14) {
                            continue;
                        }
                        if (slot < 0) {
                            slot = i;
                        }
                        else {
                            if (RandomInt(1, 2) == 1) {
                                slot = i;
                            }
                        }
                    }
                    if (slot < 0) {
                        slot = RandomInt(0, oc - 1);
                    }
                    pairPick = 81;
                }
                else {
                    for (i = 0; i < tc; i += 1) {
                        if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                            continue;
                        }
                        if (g_scrRole[i] == 118) {
                            continue;
                        }
                        if (slot < 0) {
                            slot = i;
                        }
                        else {
                            if (RandomInt(1, 2) == 1) {
                                slot = i;
                            }
                        }
                    }
                    if (slot >= 0) {
                        pairPick = 81;
                    }
                }
            }
            // 再试罂粟种植者：顶掉一个非「持续信息」镇民（不动悟道者 118）
            if (pairPick < 0 && BOTC_BoardHasRole(86) && !g_scrUsed[86] && tc > 0) {
                slot = -1;
                for (i = 0; i < tc; i += 1) {
                    if (BOTC_RoleRecurringInfo(g_scrRole[i])) {
                        continue;
                    }
                    if (g_scrRole[i] == 118) {
                        continue;
                    }
                    if (slot < 0) {
                        slot = i;
                    }
                    else {
                        if (RandomInt(1, 2) == 1) {
                            slot = i;
                        }
                    }
                }
                if (slot >= 0) {
                    pairPick = 86;
                }
            }
            if (pairPick == 86) {
                if (g_scrRole[slot] >= 0) {
                    g_scrUsed[g_scrRole[slot]] = false;
                }
                g_scrRole[slot] = 86;
                g_scrUsed[86] = true;
                BOTC_PmStore(g_teller, "【配比】有精神病患者 → 同时加入「罂粟种植者」。");
            }
            else {
                if (pairPick == 81) {
                    if (oc > 0) {
                        if (outR[slot] >= 0 && outR[slot] != 14) {
                            g_scrUsed[outR[slot]] = false;
                        }
                        outR[slot] = 81;
                    }
                    else {
                        if (g_scrRole[slot] >= 0) {
                            g_scrUsed[g_scrRole[slot]] = false;
                        }
                        g_scrRole[slot] = 81;
                    }
                    g_scrUsed[81] = true;
                    BOTC_PmStore(g_teller, "【配比】有精神病患者 → 同时加入「魔像」。");
                }
            }
        }
    }
    // 【军团局 · 赏金猎人】（用户 2026-11-10）：7 名军团时小概率把赏金猎人钉进镇民池
    if (bounty == 1 && g_scrUsed[90] == false && tc > 0) {
        slot = -1;
        for (i = 0; i < tc; i += 1) {
            if (poppy == 1 && i == 0) {
                continue;                // 不动罂粟种植者
            }
            if (g_scrRole[i] == 118) {
                continue;                // 不动悟道者
            }
            if (slot < 0) {
                slot = i;
            }
            else {
                if (RandomInt(1, 2) == 1) {
                    slot = i;
                }
            }
        }
        if (slot >= 0) {
            if (g_scrRole[slot] >= 0) {
                g_scrUsed[g_scrRole[slot]] = false;
            }
            g_scrRole[slot] = 90;
            g_scrUsed[90] = true;
            BOTC_PmStore(g_teller, "【配比】军团 7 名 → 加入「赏金猎人」。");
        }
    }
    // ---- 把善良角色发到座位上（用户 2026-11-03）----
    //   总场数 < 5 的玩家优先拿「无主动能力 / 只有首夜信息 / 被动触发」的安全角色；
    //   其余角色随机分配，不改变剧本配比。
    goodN = 0;
    for (i = 0; i < oc; i += 1) {
        goodR[goodN] = outR[i];
        goodN = goodN + 1;
    }
    for (i = 0; i < tc; i += 1) {
        goodR[goodN] = g_scrRole[i];
        goodN = goodN + 1;
    }
    goodSeatN = 0;
    for (i = pos; i < n; i += 1) {
        goodSeat[goodSeatN] = g_scrSeat[i];
        goodSeatN = goodSeatN + 1;
    }
    for (i = goodN - 1; i > 0; i -= 1) {
        k = RandomInt(0, i);
        pick = goodR[i]; goodR[i] = goodR[k]; goodR[k] = pick;
    }
    for (i = goodSeatN - 1; i > 0; i -= 1) {
        k = RandomInt(0, i);
        pick = goodSeat[i]; goodSeat[i] = goodSeat[k]; goodSeat[k] = pick;
    }
    // 【失忆者（73）】（用户 2026-11-10）：随机配板时跟恶魔 / 爪牙共用同一张场次权重表，
    //   优先落在总场数较多的玩家身上；不参与软换边（不读上一场阵营，不做 ×1.2），
    //   但参与【竞选角色类型】（用户 2026-11-11）的外来者竞选 ×1.5。
    for (i = goodN - 1; i >= 0; i -= 1) {
        if (goodR[i] != 73) {
            continue;
        }
        amnScore = 0;
        for (k = 0; k < goodSeatN; k += 1) {
            q = goodSeat[k];
            if (q < 2) {
                continue;
            }
            joinW = BOTC_DealSeatBaseWeight(g_dealStatT[q]) * 2;
            if (BOTC_JrBit(g_dealJoin[q], 1) == 1) {
                joinW = (joinW * 3) / 2;
            }
            amnScore = amnScore + joinW;
        }
        amnBest = -1;
        if (amnScore > 0) {
            amnSc = RandomInt(1, amnScore);
            for (k = 0; k < goodSeatN; k += 1) {
                q = goodSeat[k];
                if (q < 2) {
                    continue;
                }
                joinW = BOTC_DealSeatBaseWeight(g_dealStatT[q]) * 2;
                if (BOTC_JrBit(g_dealJoin[q], 1) == 1) {
                    joinW = (joinW * 3) / 2;
                }
                amnSc = amnSc - joinW;
                if (amnSc <= 0) {
                    amnBest = k;
                    break;
                }
            }
        }
        if (amnBest >= 0) {
            q = goodSeat[amnBest];
            g_mark[(g_teller * 14) + q] = 74;      // 失忆者 73 + 1
            goodSeat[amnBest] = 0;
            goodN = goodN - 1;
            goodR[i] = goodR[goodN];
        }
    }
    drunkSeat = 0;
    drunkN = 0;
    for (i = 0; i < goodN; i += 1) {
        pick = -1;
        candN = 0;
        wantNew = BOTC_RoleNewbieSafe(goodR[i]);
        // 【竞选角色类型】（用户 2026-11-11）：镇民 / 外来者各自独立加权，
        //   参与的座位按 3、未参与的按 2 参与加权抽签（等价 ×1.5）。
        // 【认知偏差角色的竞选归类】（用户 2026-11-11 追加）：疯子 / 悟道者 / 提线木偶 / 酒鬼
        //   按「玩家以为的身份」参与竞选（见 BOTC_JrRoleType）。
        wantOut = BOTC_JrRoleType(goodR[i]);
        candW = 0;
        for (k = 0; k < goodSeatN; k += 1) {
            q = goodSeat[k];
            if (q < 2) {
                continue;
            }
            seatNew = (g_dealStatT[q] < 5);
            if ((wantNew && seatNew) || ((!wantNew) && (!seatNew))) {
                candN = candN + 1;
                joinW = 2;
                if (BOTC_JrBit(g_dealJoin[q], wantOut) == 1) {
                    joinW = 3;
                }
                candW = candW + joinW;
                if (RandomInt(1, candW) <= joinW) {
                    pick = k;
                }
            }
        }
        if (pick < 0) {
            candN = 0;
            candW = 0;
            for (k = 0; k < goodSeatN; k += 1) {
                q = goodSeat[k];
                if (q < 2) {
                    continue;
                }
                candN = candN + 1;
                joinW = 2;
                if (BOTC_JrBit(g_dealJoin[q], wantOut) == 1) {
                    joinW = 3;
                }
                candW = candW + joinW;
                if (RandomInt(1, candW) <= joinW) {
                    pick = k;
                }
            }
        }
        if (pick < 0) {
            break;
        }
        q = goodSeat[pick];
        g_mark[(g_teller * 14) + q] = goodR[i] + 1;
        if (goodR[i] == 14) {
            // 【无神论者局 · 多个酒鬼】（用户 2026-11-12）：每个酒鬼都记下来，逐一给认知卡。
            if (drunkN < 16) {
                drunkSeats[drunkN] = q;
                drunkN = drunkN + 1;
            }
        }
        goodSeat[pick] = 0;
    }
    for (ei = 0; ei < extra && ei < drunkN; ei += 1) {
        q = drunkSeats[ei];
        if (q < 2 || tc + ei > 15) {
            continue;
        }
        g_mark[(g_teller * 14) + q] = g_scrRole[tc + ei] + 1;
        g_tokOn[(((g_teller * 14) + q) * 256) + 8] = true;
        // 【酒鬼也来一条】（用户 2026-10-16）：认知覆盖那几个里只有酒鬼没有这行提示，写法跟提线木偶 / 悟道者一致
        BOTC_PmStore(g_teller, "【酒鬼】" + BOTC_NameStr(q) + " 以为自己是「" + g_roleName[g_scrRole[tc + ei]] + "」。");
    }
    // 【悟道者（118）】（用户 2026-10-16 第二次修）：跟酒鬼**镜像** ----
    //   酒鬼 = 外来者 + 多抽一张镇民；悟道者 = 镇民 + 多抽一张**外来者**卡。
    //   ⚠ 必须在**上面那圈「把镇民写进魔典」的循环之后**才跑 ---- 上一版插在它前面，
    //     被那圈循环（把 g_scrRole[i] = 118 写回那一格）覆盖掉了，魔典上还是「悟道者」+ 一枚「是悟道者」token。
    //   ⚠ 那张外来者卡**不能是认知覆盖类**（酒鬼 14 / 疯子 38）---- 用户 2026-10-16 + 百科。
    // 【无神论者局 · 多个悟道者】（用户 2026-11-12）：每个悟道者各自抽一张假外来者，允许重复。
    wudN = 0;
    for (i = pos; i < n; i += 1) {
        q = g_scrSeat[i];
        if (g_mark[(g_teller * 14) + q] == 119) {
            if (wudN < 16) {
                wudSeats[wudN] = q;                           // 已经发到座位上的悟道者（118 + 1）
                wudN = wudN + 1;
            }
        }
    }
    for (ei = 0; ei < wudN; ei += 1) {
        wudSeat = wudSeats[ei];
        wudRole = -1;
        for (k = 0; k < 64; k += 1) {
            pick = BOTC_PickBoardRole(1);
            if (pick < 0) {
                break;
            }
            if (pick == 14 || pick == 38) {
                continue;                                     // 认知覆盖类不能当（换下一个）
            }
            wudRole = pick;
            break;
        }
        if (wudRole < 0) {
            wudRole = BOTC_PickUnused(13, 16);
            if (wudRole == 14 || wudRole == 38) {
                wudRole = 15;                                 // 兜底：陌客
            }
        }
        if (wudRole < 0) {
            wudRole = 15;
        }
        g_mark[(g_teller * 14) + wudSeat] = wudRole + 1;
        g_tokOn[(((g_teller * 14) + wudSeat) * 256) + 140] = true;
        BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(wudSeat) + " 以为自己是「" + g_roleName[wudRole] + "」。");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：掷到 +0 那次，他真在场就说明一句（+1 那次上面改配比时已经提示过）
    // 【设置调整只认真身】（用户 2026-11-12）：以为自己是气球驾驶员的不算
    if (g_balPlus == false && BOTC_SeatOfRole(72) >= 2) {
        BOTC_PmStore(g_teller, "【配比】气球驾驶员在场 → 镇民不变。");
    }
    // 疯子（38）：延续酒鬼那套写法 ---- 魔典上写「他以为自己是」的那只恶魔（本局真恶魔那只），
    //   真相靠「是疯子」token(49)；他每夜要选几个人按那只恶魔的选人数算。
    for (i = 2; i <= 13; i += 1) {
        if (g_mark[(g_teller * 14) + i] - 1 != 38) {
            continue;
        }
        r = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_mark[(g_teller * 14) + k] - 1 >= 0 && BOTC_RoleTeam(g_mark[(g_teller * 14) + k] - 1) == 3) {
                r = g_mark[(g_teller * 14) + k] - 1;
            }
        }
        if (r > 0) {
            realDemon = r;
            // 【军团 × 疯子】（用户 2026-11-10）：剧本里有军团（94）和疯子（38）时，
            //   即使真恶魔不是军团，也有概率让疯子以为自己是「军团」。
            if (r != 94 && BOTC_BoardHasRole(94) && BOTC_BoardHasRole(38)) {
                if (RandomInt(1, 4) == 1) {
                    r = 94;
                }
            }
            // 【无神论者局 · 疯子认知恶魔】（用户 2026-11-12）：无神论者局没有真恶魔，
            //   疯子可以以为自己是剧本里的任何一只恶魔（包括刚被清掉的恶魔）。
            if (BOTC_AtheistOn()) {
                lunN = 0;
                lunAlt = -1;
                for (k = 0; k < g_boardRoleN[g_board]; k += 1) {
                    pick = g_boardRole[(g_board * 256) + k];
                    if (pick < 0 || pick > 163) {
                        continue;
                    }
                    if (pick >= 143 && pick <= 146) {
                        continue;
                    }
                    if (BOTC_RoleTeam(pick) != 3) {
                        continue;
                    }
                    lunN = lunN + 1;
                    if (RandomInt(1, lunN) == 1) {
                        lunAlt = pick;
                    }
                }
                if (lunAlt >= 0) {
                    r = lunAlt;
                }
            }
            else {
                // 【疯子 · 认知恶魔】（用户 2026-11-11）：本剧本里还有别的恶魔时，有 25% 概率
                //   让疯子以为自己是另一只恶魔；只改他魔典上的认知卡，真恶魔和真身疯子都不变。
                //   候选只取当前板子的恶魔池，排除真恶魔和全员追忆占位身份 143..146。
                if (r == realDemon) {
                    lunN = 0;
                    lunAlt = -1;
                    for (k = 0; k < g_boardRoleN[g_board]; k += 1) {
                        pick = g_boardRole[(g_board * 256) + k];
                        if (pick < 0 || pick > 163) {
                            continue;
                        }
                        if (pick == realDemon || (pick >= 143 && pick <= 146)) {
                            continue;
                        }
                        if (BOTC_RoleTeam(pick) != 3) {
                            continue;
                        }
                        lunN = lunN + 1;
                        if (RandomInt(1, lunN) == 1) {
                            lunAlt = pick;
                        }
                    }
                    if (lunAlt >= 0 && RandomInt(1, 4) == 1) {
                        r = lunAlt;
                    }
                }
            }
            g_mark[(g_teller * 14) + i] = r + 1;                   // 让他以为自己是那只恶魔
            if (g_roleTargets[r] > 0) {
                g_roleTargets[38] = g_roleTargets[r];
            }
            else {
                g_roleTargets[38] = 1;
            }
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(i) + " 以为自己是「" + g_roleName[r] + "」。");
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 49] = true;        // 是疯子
    }
    // 【卡扎力（135）】随机发牌设置：把原有爪牙牌换成不在场的善良角色；首夜自动唤醒后只私聊。
    BOTC_KazaliCompositionApply();
    BOTC_SummonerInitialSetup();
    // 【正式开局 · 首夜标记】（用户 2026-11-09）：占卜师 / 半兽人 / 解谜大师 / 水手 / 弄臣 /
    //   茶艺师 / 酒保 / 暴风捕手 不再在随机发牌阶段打标记，
    //   改到游戏正式开始、进入首夜时由 BOTC_GameStartGo() 调用 BOTC_OpeningMarkSync() 统一结算。
    // 伪装口供：**不自动安排**（用户要求），只提醒邪恶玩家自己挑
    BOTC_ClaimHint();
    // 无神论者（83）在场：本局没有邪恶角色（爪牙 / 恶魔的座位换成不在场的善良角色）
    if (BOTC_AtheistOn()) {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            r = BOTC_SeatTrueRole(i);
            if (BOTC_RoleTeam(r) == 2 || BOTC_RoleTeam(r) == 3) {
                r = BOTC_PickBoardGood();
                if (r > 0) {
                    BOTC_SetSeatRole(g_teller, i, r);
                    BOTC_SetSeatRole(g_who[i], i, r);
                }
            }
        }
        BOTC_PmStore(g_teller, "【无神论者】在场：爪牙和恶魔的座位已换成不在场的善良角色（本局没有邪恶）。");
    }
    // 【炼金术士 × 提线木偶】（用户 2026-11-12）：炼金术士在场 → 提线木偶一定在场。
    //   先创建提线木偶并分配假身份，后面的巡山人 / 气球驾驶员设置调整才能读到他的假身份。
    BOTC_AlchemistMarionetteEnsure();
    BOTC_MarionetteRoleSync();
    // 【气球驾驶员 × 提线木偶】（用户 2026-11-12）：假身份为气球驾驶员时可能 +1 外来者。
    BOTC_BalloonMarionetteComposition();
    // 巡山人（77）在场：必定有一个外来者是落难少女（82）
    //   用户 2026-11-08：大概率把一名外来者换成落难少女；小概率改为把一名
    //   「无主动能力 / 一次性能力」的镇民转成外来者落难少女（外来者 +1、镇民 -1）。
    //   没有可换的外来者时必定走镇民那条路，保证巡山人在场必有落难少女。
    // 【设置调整只认真身】（用户 2026-11-12）：酒鬼不增加；
    //   提线木偶以为自己是巡山人时按相克规则增加落难少女。
    if ((BOTC_SeatOfRole(77) >= 2 || BOTC_MarionetteFakeIs(77)) && BOTC_SeatOfRole(82) < 2) {
        // 候选外来者（酒鬼 14 / 疯子 38 也可以换，换走时收掉认知 token）
        pick = 0;
        candN = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            r = BOTC_SeatTrueRole(i);
            if (BOTC_RoleTeam(r) != 1) {
                continue;
            }
            // 【酒鬼 / 疯子可以换】（用户 2026-11-08）：换走后会自动去掉「是酒鬼」/「是疯子」token
            //   （发牌还没正式开始，BOTC_SetSeatRole 不会帮忙收旧身份 token，必须在换之前手动清）。
            //   悟道者的认知覆盖座位仍然不换。
            if (BOTC_ProtectTokOn(i, 140)) {
                continue;
            }
            candN = candN + 1;
            if (RandomInt(1, candN) == 1) {
                pick = i;
            }
        }
        // 小概率（20%）改成换镇民；没有可换的外来者时必定走这条
        slot = 0;
        if (pick < 2 || RandomInt(1, 100) <= 20) {
            candN = 0;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) {
                    continue;
                }
                r = BOTC_SeatTrueRole(i);
                if (BOTC_RoleTeam(r) != 0) {
                    continue;
                }
                if (!BOTC_RoleNewbieSafe(r)) {
                    continue;                      // 只要无主动能力 / 一次性能力的镇民
                }
                if (BOTC_ProtectTokOn(i, 8) || BOTC_ProtectTokOn(i, 49) || BOTC_ProtectTokOn(i, 140)) {
                    continue;
                }
                candN = candN + 1;
                if (RandomInt(1, candN) == 1) {
                    slot = i;
                }
            }
        }
        if (slot >= 2) {
            r = BOTC_SeatTrueRole(slot);
            if (r >= 0) {
                g_scrUsed[r] = false;
            }
            BOTC_SetSeatRole(g_teller, slot, 82);
            BOTC_SetSeatRole(g_who[slot], slot, 82);
            g_scrUsed[82] = true;
            BOTC_PmStore(g_teller, "【巡山人】在场：镇民的座位（" + BOTC_NameStr(slot) + "）已换成落难少女（外来者 +1、镇民 -1）。");
        }
        else if (pick >= 2) {
            r = BOTC_SeatTrueRole(pick);
            // 【酒鬼 / 疯子换走就收掉认知 token】（用户 2026-11-08）：必须在 BOTC_SetSeatRole 之前清，
            //   否则写玩家自己那一份身份时还会套用「酒鬼 / 疯子」的认知覆盖，看到的不是落难少女。
            if (r == 14) {
                g_tokOn[(((g_teller * 14) + pick) * 256) + 8] = false;
            }
            if (r == 38) {
                g_tokOn[(((g_teller * 14) + pick) * 256) + 49] = false;
            }
            if (r >= 0) {
                g_scrUsed[r] = false;
            }
            BOTC_SetSeatRole(g_teller, pick, 82);
            BOTC_SetSeatRole(g_who[pick], pick, 82);
            g_scrUsed[82] = true;
            if (r == 14) {
                BOTC_PmStore(g_teller, "【巡山人】在场：酒鬼的座位（" + BOTC_NameStr(pick) + "）已换成落难少女，并去掉「是酒鬼」token。");
            }
            else if (r == 38) {
                BOTC_PmStore(g_teller, "【巡山人】在场：疯子的座位（" + BOTC_NameStr(pick) + "）已换成落难少女，并去掉「是疯子」token。");
            }
            else {
                BOTC_PmStore(g_teller, "【巡山人】在场：外来者的座位（" + BOTC_NameStr(pick) + "）已换成落难少女。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【巡山人】在场：没有可替换的外来者，也没有「无主动能力 / 一次性能力」的镇民，本局不加入落难少女。");
        }
    }
    // 【半兽人（107）· 失足】/【解谜大师（109）· 醉酒】（用户 2026-11-09）：
    //   不再在随机发身份时打标记，改到游戏正式开始、进入首夜时由 BOTC_OpeningMarkSync() 统一结算。
    // 唱诗男孩（108）在场：一个镇民换成国王（104）—— 照上面「巡山人 → 落难少女」那条写法
    // 【设置调整只认真身】（用户 2026-11-12）：以为自己是唱诗男孩的不触发
    if (BOTC_SeatOfRole(108) >= 2 && BOTC_SeatOfRole(104) < 2) {
        r = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_HasAbility(i, 108)) { continue; }
            if (g_balPlus && BOTC_SeatTrueRole(i) == 72) { continue; }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 0) { r = i; break; }
        }
        if (r >= 2) {
            BOTC_SetSeatRole(g_teller, r, 104);
            BOTC_SetSeatRole(g_who[r], r, 104);
            BOTC_PmStore(g_teller, "【唱诗男孩】在场：镇民的座位（" + BOTC_NameStr(r) + "）已换成国王。");
        }
    }
    // 【堤丰之首（111）】（用户 2026-10-10）：发牌设置 —— 一个善良变爪牙 + 邪恶排成邻座、他坐中间
    // 【设置调整只认真身】（用户 2026-11-12）：疯子以为自己是堤丰之首时不触发
    if (BOTC_SeatOfRole(111) >= 2) {
        BOTC_HfTyphonSetup();
    }
    BOTC_MarionetteSync();
    // 【暴风捕手（113）/ 酒保（160）】（用户 2026-11-09）：发牌阶段不再提前打标记，
    //   改到游戏正式开始、进入首夜时由 BOTC_OpeningMarkSync() 统一结算。
    // 【诺-达鲺（70）/ 店小二（115）】（用户 2026-11-09）：随机发牌期间不再提前打标记，
    //   改到游戏正式开始、进入首夜时由 BOTC_GameStartGo() 统一结算。
    // 重新发牌后清掉旧的死亡红叉，所有人的魔典都刷新一遍
    for (i = 1; i <= 13; i += 1) {
        BOTC_GrimRender(g_who[i]);
    }
}

// 确认发放：其他玩家自己的魔典里，只会自动填上"自己座位"的身份（token 不发）
void BOTC_ConfirmDeal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    BOTC_SummonerInitialSetup();
    BOTC_XaanSetupSync();          // 【限】初始外来者数量在确认发放的这一刻锁定
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        // 【按「格子」发，不按玩家号】（用户 2026-10-18 报「换说书人之后老说书人没收到身份」）：
        //   老说书人现在是玩家 1、坐在别的格子；原来从玩家 2 开始循环，永远轮不到他。
        // 【每个人那份只留自己那一格】（用户 2026-10-18 报「座位4的玩家能看到座位3的身份」）：
        //   以前只写「自己那一格」，别的格子里上一把 / 复盘留下的字不清 → 会露出别人的身份。
        ob = g_who[q];
        for (t = 0; t <= 13; t += 1) {
            if (t == q) {
                g_mark[(ob * 14) + t] = BOTC_AmnesiaMaskRole(g_mark[(g_teller * 14) + t] - 1) + 1;
            }
            else {
                g_mark[(ob * 14) + t] = 0;
            }
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
        BOTC_GrimRender(ob);
    }
    // 身份发下去之后，邪恶角色那边才会出现【伪装身份】按钮
    BOTC_ClaimBtnRender();
    // 【弄臣 / 水手 / 茶艺师 / 暴风捕手 / 涡流】（用户 2026-11-09）：确认发放阶段不再提前打标记，
    //   改到游戏正式开始、进入首夜时由 BOTC_OpeningMarkSync() 统一结算。
    g_dealConfirmed = true;        // 记下「这一轮发牌确认过了」：正式开始时要用它校验
    g_swapUnlocked = false;        // 重新确认发放 → 再次锁上【换座位】（用户 2026-10-07）
    BOTC_SwapCancelAll();          // 【撤回所有人在选的换座位】（用户 2026-10-11）
    BOTC_BsBtnRender();            // 【发完牌立刻收掉【换座位】按钮】（用户 2026-10-07）
    BOTC_NoticeBox(g_teller, "已确认发放身份");
    // 【发放之后自动弹「游戏帮助」】（用户 2026-09-20）：让每个玩家立刻看到自己的角色能力
    //   【按坐的格子找人】（用户 2026-10-18）：换说书人之后玩家 1 也是玩家，别漏掉他
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        g_tipForce[g_who[q]] = -1;       // 发牌自动弹的这一份必须显示「你自己的角色」，别被谁在能力表点过的详情锁住（用户 2026-09-30）
        BOTC_TipOpen(g_who[q]);
    }
    BOTC_GrimShareRender();        // 确认发放后立即刷新说书人的测试发送按钮
    // 【按钮变成取消下发】（用户 2026-11-10）：再点一次 = 收回所有玩家的身份标记
    libNtve_gf_SetDialogItemText(g_grimConfirm, StringToText("取消下发"), PlayerGroupSingle(g_teller));
}

// 【取消下发】（用户 2026-11-10）：把每位玩家自己那份魔典里的身份 / token 全部收回，
//   说书人的配板（真值行）原样保留，之后可以继续改标记或重新点【确认下发】。
void BOTC_CancelDeal () {
    int p;
    if (!g_dealConfirmed) {
        return;
    }
    g_dealConfirmed = false;
    BOTC_GrimResetPerPlayer();     // 只清玩家行，说书人真值行不动
    g_swapUnlocked = true;         // 收回身份 → 【换座位】按钮放回来
    BOTC_BsBtnRender();
    BOTC_ClaimBtnRender();         // 邪恶角色的【伪装身份】按钮收起
    BOTC_GrimShareRender();
    // 还开着「游戏帮助 / 我的角色」的玩家：角色那一栏立刻变回未发放状态
    for (p = 1; p <= 13; p += 1) {
        if (g_tipOpen[p]) {
            BOTC_TipRender(p);
        }
    }
    libNtve_gf_SetDialogItemText(g_grimConfirm, StringToText("确认发放"), PlayerGroupSingle(g_teller));
    BOTC_NoticeBox(g_teller, "已取消下发：所有玩家的身份标记已收回，配板保留。");
}

//--------------------------------------------------------------------------------------------------
// 不在场身份（右下角面板）
//--------------------------------------------------------------------------------------------------
// 找被发了恶魔（小恶魔 = 索引21，存 22）的座位
//   小恶魔自刀传位之后会有两个座位都写着小恶魔：优先返回还活着的那一个
int BOTC_FindDemon () {
    int q;
    int fallback;
    fallback = 0;
    for (q = 2; q <= 13; q += 1) {
        // 【按阵营找恶魔】（用户 2026-09-19）：以前写死「小恶魔」，现在任何恶魔身份都算
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            if (fallback == 0) {
                fallback = q;
            }
            if (!BOTC_PublicDead(q)) {
                return q;
            }
        }
    }
    return fallback;
}

// who = 给谁刷新面板（说书人=1 / 恶魔玩家）
void BOTC_BluffRowRender (int who) {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_bluffPick[i];
        if (v > 0) {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
        else {
            libNtve_gf_SetDialogItemImage(g_bluffIcon[i], "botc_blank.dds", PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemText(g_bluffName[i], StringToText(""), PlayerGroupSingle(who));
            libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupSingle(who));
        }
    }
}

// 【发送目标的在场判定】（用户 2026-11-08）：按钮文案和弹窗选项改看**场上实际存在**的角色，
//   不再看剧本可选池：没有疯子 / 告密者功效时只留一键【发送给所有恶魔】。
bool BOTC_BluffLunInPlay () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_IsLunatic(q)) {
            return true;
        }
    }
    return false;
}

// 【发送给所有爪牙】（用户 2026-11-10）：只看告密者本身，或能力层真的获得告密者能力的玩家
//   （失忆者 / 食人族 / 哲学家 / 炼金术士等）。失忆者空手或获得别的能力时不再连带露出这一项。
bool BOTC_BluffMinBtnOn () {
    return BOTC_RoleInPlay(92) || BOTC_AbilityInPlay(92);
}

// 【发送给疯子】只在场上真的有疯子时出现（用户 2026-11-09）：失忆者不再连带露出这一项。
bool BOTC_BluffLunBtnOn () {
    return BOTC_BluffLunInPlay();
}

bool BOTC_BluffTgtNeed () {
    return BOTC_BluffMinBtnOn() || BOTC_BluffLunBtnOn();
}

void BOTC_BluffRender () {
    bool need;
    BOTC_BluffRowRender(g_teller);
    // 【发送目标按钮】（用户 2026-11-08）：游戏正式开始后才对说书人显示这个按钮；
    //   场上有疯子 / 告密者功效时改为打开目标选择弹窗，否则仍是一键【发送给所有恶魔】。
    need = BOTC_BluffTgtNeed();
    if (need) {
        libNtve_gf_SetDialogItemText(g_bluffSendAllBtn, StringToText("发送给特定玩家"), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_bluffSendAllBtn, StringToText("发送给所有恶魔"), PlayerGroupAll());
    }
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    if (g_started) {
        DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);
    }
    // 【发送】（用户 2026-11-08）：游戏正式开始前不给说书人显示，准备阶段只能先抽 / 选 3 个身份
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupAll(), false);
    if (g_started) {
        DialogControlSetVisible(g_bluffSendBtn, PlayerGroupSingle(g_teller), true);
    }
}

//==================================================================================================
// 【疯子（38）的第二套不在场身份】（用户 2026-09-20）：
//   跟恶魔那套同一个右下角锚点、往上一格（y=252），按钮叫【随机 3 个（疯子）】【发送给疯子】；
//   抽的池子 = **当前板子里的镇民 / 外来者**且本局不在场；**有 25% 概率掺一个假的**（其实在场）。
//==================================================================================================
bool BOTC_BoardHasRole (int r) {
    int i;
    int b;
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        if (g_boardRole[(b * 256) + i] == r) {
            return true;
        }
    }
    return false;
}

// 这个身份算不算「受限的伪装」：**一次性信息者**（洗衣妇 / 图书管理员 / 调查员 / 厨师 / 祖母...）
//   或者**外来者**（管家 / 酒鬼 / 陌客 / 圣徒）。
//   给恶魔的 3 个伪装里，这一类**最多只出现 1 个**（两个池都够抽的时候）。
//   ⚠ 分类按随机发牌同款 g_roleInfoClass == 1；共情者 / 占卜师是**持续信息位**，不算在内。
bool BOTC_BluffRestricted (int idx) {
    if (idx < 0 || idx > 163) {
        return false;
    }
    if (BOTC_RoleTeam(idx) == 1) {
        return true;                   // 外来者（黯月初升也一样：修补匠 / 月之子 / 莽夫 / 疯子）
    }
    if (g_roleInfoClass[idx] == 1 && BOTC_RoleAlign(idx) == 0) {
        return true;                   // 一次性信息者：只有一次信息产出的善良角色
    }
    return false;
}

void BOTC_BluffRoll () {
    int b;
    int r;
    int i;
    int n;
    int k;
    int t;
    int idx;
    int best;
    int bestTier;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
    }
    // 【随机不在场身份的分层规则】（用户 2026-11-06）：镇民改读游戏内镇民分类 g_roleInfoClass，
    //   与随机发牌 / 认知偏差共用同一张表，不再按 g_roleAct 硬编码：
    //   0 = 持续信息位（最优先）；1 = 夜间能力 / 白天能力；
    //   2 = 一次性信息 / 死亡能力 / 无主动能力 / 其他镇民；3 = 外来者（最后兜底，尽量少选）。
    n = 0;
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            continue;                  // 只从镇民 / 外来者里抽
        }
        if (r == 83) {
            continue;                  // 无神论者不参与随机不在场身份发放（用户 2026-11-12）
        }
        if (r == 14 || r == 38 || r == 118) {
            continue;                  // 酒鬼 / 疯子 / 悟道者不参与随机不在场身份发放（用户 2026-11-12）
        }
        // 【认知偏差的假身份不参与随机不在场】（用户 2026-11-13）：场上有酒鬼 / 疯子 / 提线木偶 /
        //   悟道者以为自己是这个角色时，别再把它当成不在场身份发出去。
        if (BOTC_RoleCogSeenInPlay(r)) {
            continue;
        }
        // 【无神论者局 · 允许在场角色】（用户 2026-11-12）：无神论者在场时，随机不在场身份
        //   可以抽到本局已经在场的镇民 / 外来者。无神论者本人仍然不参与。
        if (!BOTC_AtheistOn() && BOTC_RoleInPlay(r)) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 1) {
            t = 3;                     // 外来者：最后兜底
        }
        else {
            if (g_roleInfoClass[r] == 2) {
                t = 0;                 // 持续信息位
            }
            else {
                if (g_roleInfoClass[r] == 3 || g_roleInfoClass[r] == 5) {
                    t = 1;             // 夜间能力 / 白天能力
                }
                else {
                    t = 2;             // 一次性信息 / 死亡能力 / 无主动能力 / 其他镇民
                }
            }
        }
        g_bfA[n] = r + 1;
        g_bfB[n] = t;
        n = n + 1;
    }
    // 同一优先级内部随机：先整体洗牌，再按优先级从低到高取满 3 个
    for (k = n - 1; k > 0; k -= 1) {
        idx = RandomInt(0, k);
        t = g_bfA[k];
        g_bfA[k] = g_bfA[idx];
        g_bfA[idx] = t;
        t = g_bfB[k];
        g_bfB[k] = g_bfB[idx];
        g_bfB[idx] = t;
    }
    for (i = 0; i < 3; i += 1) {
        best = -1;
        bestTier = 9;
        for (k = 0; k < n; k += 1) {
            if (g_bfA[k] <= 0) {
                continue;
            }
            if (g_bfB[k] < bestTier) {
                bestTier = g_bfB[k];
                best = k;
            }
        }
        if (best < 0) {
            break;
        }
        g_bluffPick[i] = g_bfA[best];
        g_bfA[best] = 0;               // 取走，不再重复
    }
    BOTC_BluffRender();
}

void BOTC_BluffOpenPick (int ob, int slot) {
    g_pickMode[ob] = 1;
    g_pickBluffSlot[ob] = slot;
    BOTC_PickFilter(ob, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("不在场身份 " + IntToString(slot + 1) + " / 3"), PlayerGroupSingle(ob));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(ob), false);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(ob), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

void BOTC_BluffSend () {
    int dm;
    int i;
    dm = BOTC_FindDemon();
    if (dm == 0) {
        BOTC_Notice(g_teller, "还没确定恶魔：先在魔典里随机发牌，或手动把某个座位选成小恶魔。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTarget = dm;
    for (i = 0; i < 3; i += 1) {
        g_bluffOut[i] = g_bluffPick[i];
    }
    g_bluffSent = true;
    BOTC_BluffGiveTo(dm, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

// 【发送给疯子】（用户 2026-09-20）：把这次挑好的 3 个「不在场身份」发给**带着「是疯子」token（49）**的那个座位 ----
//   ⚠ 判据是 token，不是真身：手动摆两个恶魔、再给其中一个打「是疯子」的玩法也照样能用。
//   面板用的是同一块（图标 / 文字本来就是「每个玩家各看各的」），所以直接给他设一份就行。
void BOTC_BluffSendToLunatic () {
    int i;
    int lu;
    lu = BOTC_RealLunaticSeat();         // 带「是疯子」但不是哲学家的那一个（用户 2026-09-21）
    if (lu < 2) {
        BOTC_NoticeBox(g_teller, "没找到「疯子」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTargetL = lu;
    BOTC_BluffGiveTo(lu, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

// 【发送给疯子（哲学家）】（用户 2026-09-21）：发给身上同时带「是哲学家(70)」+「是疯子(49)」的那个座位。
//   只发这 3 个不在场身份，**不发爪牙**（新恶魔本来就不知道场上的爪牙有谁）。
void BOTC_BluffSendToPhiloLunatic () {
    int i;
    int lu;
    lu = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 70] && g_tokOn[(((g_teller * 14) + i) * 256) + 49]) {
            lu = i;
        }
    }
    if (lu < 2) {
        BOTC_Notice(g_teller, "没找到[哲学家疯子]。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffTargetP = lu;
    BOTC_BluffGiveTo(lu, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

bool BOTC_BountyTrigger () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (!g_tokOn[(((g_teller * 14) + i) * 256) + 114]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            return true;
        }
    }
    return false;
}

bool BOTC_LegionOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == 94) {
            return true;
        }
    }
    return false;
}
bool BOTC_LegionLunatic () {
    int q;
    q = BOTC_RealLunaticSeat();
    if (q < 2) {
        return false;
    }
    return (g_mark[(g_teller * 14) + q] - 1 == 94);
}

// 【军团 · 首夜互认】（用户 2026-11-02）：不再标队友，改为向每名真军团私聊
//   本局所有善良玩家的座位号。若场上同时有魔术师，按相克规则从名单中排除魔术师。
//   「以为自己是军团」的疯子不自动发送，改由说书人手动填写善良玩家。
int BOTC_LegionMarkFor (int who, int hide1, int hide2) {
    int i;
    int mag;
    int q;
    int n;
    int w;
    n = 0;
    if (who < 2 || who > 13) {
        return 0;
    }
    w = who * 14;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == BOTC_PosOf(who)) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) != 94) {
            continue;
        }
        if (q == hide1 || q == hide2) {
            continue;
        }
        g_mark[w + q] = 95;                 // 95 = 军团（94）+ 1
        n = n + 1;
    }
    // 相克：军团互认时把魔术师也标成军团，并私聊告知军团玩家「魔术师在场」。
    mag = BOTC_MagicianSeatNow();
    if (mag >= 2 && mag != BOTC_PosOf(who)) {
        if (g_mark[w + mag] != 95) {
            g_mark[w + mag] = 95;
            n = n + 1;
        }
        BOTC_PmInfo(who, "【信息】魔术师在场，他也被标成军团。");
        BOTC_PmStore(g_teller, "【军团×魔术师相克】已在 " + BOTC_NameStr(BOTC_PosOf(who)) + " 的魔典上把 " + BOTC_NameStr(mag) + " 标成军团，并私聊告知魔术师在场。");
    }
    BOTC_GrimRender(who);
    // 私聊跟魔典同一时刻（用户 2026-09-30）：只说「标好了」，不列名字
    if (n > 0) {
        BOTC_PmStore(who, "【军团】已在魔典上标记所有军团。");
    }
    else {
        BOTC_PmStore(who, "【军团】你的魔典上没有标出其他军团。");
    }
    return n;
}

// 假军团（疯子）那一份：按说书人填的两个座位屏蔽（0 = 不屏蔽）
void BOTC_LegionLunaticApply (int hide1, int hide2) {
    int i;
    int q;
    int lu;
    string s;
    g_lgPend = false;             // 框已经答完了（确定 / 取消都走这里）
    lu = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) == 94) {
            continue;
        }
        if (g_mark[(g_teller * 14) + q] - 1 != 94) {
            continue;
        }
        lu = q;
    }
    if (lu < 2) {
        return;
    }
    BOTC_LegionMarkFor(g_who[lu], hide1, hide2);
    s = "";
    if (hide1 >= 2) {
        s = BOTC_NameStr(hide1);
    }
    if (hide2 >= 2) {
        if (StringLength(s) > 0) {
            s = s + "、";
        }
        s = s + BOTC_NameStr(hide2);
    }
    if (StringLength(s) <= 0) {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上标了全部军团（没有屏蔽）。");
    }
    else {
        BOTC_PmStore(g_teller, "【军团】疯子 " + BOTC_NameStr(lu) + " 的魔典上屏蔽了：" + s + "。");
    }
    // 那个答题框是共用的：军团这步把按钮文字改成了「确认」，用完必须还原
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
}

// 首夜互认主入口：向所有军团发送善良玩家座位号。
bool BOTC_LegionRecognize () {
    int i;
    int q;
    int n;
    int mag;
    int goodN;
    string s;
    string msg;
    bool fakeLegion;
    n = 0;
    goodN = 0;
    s = "";
    mag = BOTC_MagicianSeatNow();
    if (!BOTC_LegionOn()) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || BOTC_SeatAlign(q) != 0) {
            continue;
        }
        if (mag >= 2 && q == mag) {
            continue;                       // 军团 × 魔术师：军团得知的是非魔术师的善良玩家
        }
        if (goodN > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(q);
        goodN = goodN + 1;
    }
    if (goodN > 0) {
        msg = "【信息】你得知所有善良玩家：" + s + "。";
    }
    else {
        msg = "【信息】你得知没有善良玩家。";
    }
    fakeLegion = BOTC_LegionLunatic();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTrueRole(q) != 94) {
            continue;
        }
        BOTC_PmInfo(g_who[q], msg);
        BOTC_PmStore(g_teller, "【军团】已发给 " + BOTC_NameStr(q) + "：" + msg);
        n = n + 1;
    }
    if (n <= 0) {
        return false;
    }
    if (mag >= 2) {
        BOTC_PmStore(g_teller, "【军团×魔术师】军团名单已排除 " + BOTC_NameStr(mag) + "。");
    }
    BOTC_PmStore(g_teller, "【军团】首夜互认完成：已向 " + IntToString(n) + " 名军团发送全部善良玩家座位。");
    if (fakeLegion) {
        g_lgPend = true;
        BOTC_ManInfoOpenSeats(BOTC_RealLunaticSeat(), "【军团】疯子以为自己是军团：手动填 1~4 名善良玩家；点【取消】= 不发送", 19);
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定"), PlayerGroupSingle(g_teller));
        return true;
    }
    return false;
}

// 【快捷发送互认】（用户 2026-11-04）：一键让除了提线木偶以外的恶魔和爪牙互认。
//   军团局：在每名军团的魔典上标出其他军团，并私聊提醒。
//   普通局：逐人私聊「谁是恶魔 / 谁是其他爪牙」；魔术师按原有相克口径混入敌方名单。
void BOTC_QuickRecognize () {
    int i;
    int j;
    int q;
    int r;
    int rteam;
    int team;
    int mag;
    int dn;
    int mn;
    int evilN;
    int trueDemonN;
    int marks;
    int demonN;
    int minionN;
    bool legion;
    string sd;
    string sm;
    string msg;
    string mm;
    int mN;
    BOTC_BuildSeatList();
    mag = BOTC_MagicianSeatNow();
    legion = BOTC_LegionOn();
    evilN = 0;
    // 【提线木偶】（93）：恶魔需要额外得知哪名玩家是提线木偶（魔术师在场时按相克口径不泄露）。
    mm = "";
    mN = 0;
    if (mag == 0) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q < 2 || q > 13 || !g_seatOn[q]) {
                continue;
            }
            if (!BOTC_IsMarionette(q)) {
                continue;
            }
            if (mN > 0) {
                mm = mm + ",";
            }
            mm = mm + BOTC_NameStr(q);
            mN = mN + 1;
        }
    }
    // 【军团】（94）：不发送善良玩家名单，只在每名军团自己的魔典上标出其他军团。
    if (legion) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q < 2 || q > 13 || !g_seatOn[q]) {
                continue;
            }
            if (BOTC_SeatTrueRole(q) != 94) {
                continue;
            }
            marks = BOTC_LegionMarkFor(g_who[q], 0, 0);
            if (marks > 0) {
                BOTC_PmInfo(g_who[q], "【信息】快捷互认：已在你的魔典上标出所有军团。");
            }
            evilN = evilN + 1;
        }
        if (evilN > 0) {
            BOTC_PmStore(g_teller, "【快捷互认】军团局：已在 " + IntToString(evilN) + " 名军团的魔典上标出其他军团，并私聊提醒。");
        }
        else {
            BOTC_PmStore(g_teller, "【快捷互认】军团局：场上没有可标记的军团。");
        }
    }
    demonN = 0;
    minionN = 0;
    // 【没有真恶魔时不要泄露】（与首夜邪恶信息同口径）：召唤师待召唤 / 小怪宝等场合直接跳过。
    trueDemonN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || !g_seatOn[q]) {
            continue;
        }
        if (BOTC_IsMarionette(q)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            trueDemonN = trueDemonN + 1;
        }
    }
    if (!legion && trueDemonN <= 0) {
        BOTC_PmStore(g_teller, "【快捷互认】场上没有真恶魔：已跳过，避免泄露「无恶魔」信息。");
        return;
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13 || !g_seatOn[q]) {
            continue;
        }
        if (BOTC_IsMarionette(q)) {
            continue;                       // 提线木偶不参与互认
        }
        if (legion && BOTC_SeatTrueRole(q) == 94) {
            continue;                       // 军团已在上面单独处理
        }
        team = BOTC_RoleTeam(BOTC_SeatTrueRole(q));
        if (team != 2 && team != 3) {
            continue;
        }
        sd = "";
        sm = "";
        dn = 0;
        mn = 0;
        for (j = 0; j < g_seatN; j += 1) {
            r = g_seatList[j];
            if (r < 2 || r > 13 || r == q || !g_seatOn[r]) {
                continue;
            }
            if (BOTC_IsMarionette(r)) {
                continue;                   // 提线木偶不写进任何人的互认名单
            }
            if (r == mag) {
                // 魔术师按相克口径混在敌方名单：恶魔看他是爪牙，爪牙看他是恶魔。
                if (team == 3) {
                    if (mn > 0) { sm = sm + ","; }
                    sm = sm + BOTC_NameStr(r);
                    mn = mn + 1;
                }
                else {
                    if (dn > 0) { sd = sd + ","; }
                    sd = sd + BOTC_NameStr(r);
                    dn = dn + 1;
                }
                continue;
            }
            rteam = BOTC_RoleTeam(BOTC_SeatTrueRole(r));
            if (rteam == 3) {
                if (dn > 0) { sd = sd + ","; }
                sd = sd + BOTC_NameStr(r);
                dn = dn + 1;
            }
            else if (rteam == 2) {
                if (mn > 0) { sm = sm + ","; }
                sm = sm + BOTC_NameStr(r);
                mn = mn + 1;
            }
        }
        if (team == 3) {
            if (mn > 0) {
                msg = "【信息】你得知" + sm + "是爪牙。";
            }
            else {
                msg = "【信息】你得知本局没有其他爪牙。";
            }
            if (dn > 0) {
                msg = msg + "其他恶魔：" + sd + "。";
            }
            if (mN > 0) {
                msg = msg + "提线木偶：" + mm + "。";
            }
            demonN = demonN + 1;
        }
        else {
            if (dn > 0) {
                msg = "【信息】你得知" + sd + "是恶魔。";
            }
            else {
                msg = "【信息】你得知场上没有其他恶魔。";
            }
            if (mn > 0) {
                msg = msg + "爪牙：" + sm + "。";
            }
            else {
                msg = msg + "本局没有其他爪牙。";
            }
            minionN = minionN + 1;
        }
        BOTC_PmInfo(g_who[q], msg);
        BOTC_PmStore(g_teller, "【快捷互认】已发给 " + BOTC_NameStr(q) + "：" + msg);
    }
    if (demonN + minionN <= 0) {
        if (legion && evilN > 0) {
            BOTC_PmStore(g_teller, "【快捷互认】完成：军团标记已完成（提线木偶已排除）。");
        }
        else {
            BOTC_PmStore(g_teller, "【快捷互认】场上没有可互认的恶魔或爪牙。");
        }
        return;
    }
    // 快捷互认已经把提线木偶和恶魔消息一起发出：标记为已发送，避免罂粟互认重复。
    if (demonN > 0 && mN > 0) {
        g_marionetteSent = true;
    }
    BOTC_PmStore(g_teller, "【快捷互认】完成：已向 " + IntToString(demonN) + " 名恶魔、" + IntToString(minionN) + " 名爪牙发送互认信息（提线木偶已排除）。");
}

// 【发送互认】入口：先让说书人点收件人，随后打开手动填写面板。
// 互认内容只使用面板中填写的 2 个恶魔 / 5 个爪牙，不再自动识别或弹出疯子互认框。
void BOTC_SendRecognize () {
    g_specMode = 5;
    g_specTo = 0;
    g_recogTo = 0;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_Notice(g_teller, "【发送互认】点一名玩家的座位作为收件人。");
}

// 【军团】疯子填写善良玩家框还没答完 → true = 这次唤醒先别走
bool BOTC_LegionPendBlock () {
    if (!g_lgPend) {
        return false;
    }
    if (g_miRole == 41 && (g_miKind == 9 || g_miKind == 19)) {
        BOTC_Notice(g_teller, "先把军团那个「疯子善良玩家」框处理掉：点【确定】或【取消】。");
        return true;
    }
    g_lgPend = false;
    BOTC_NotifyDemonsLunatic();
    return false;
}

// 真人说书答题框点「取消」：只有军团那一步需要收尾（不屏蔽，疯子看到所有队友）
void BOTC_MiCancelApply () {
    int seat;
    if (g_miRole == 156) {
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 815) {
        g_halfPick = false;
        g_halfBy = 0;
        g_halfSlot = 0;
        g_halfOriginal = 0;
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 814) {
        g_wardenAsk = false;
        g_wardenAskBy = 0;
        g_wardenCandN = 0;
        g_miRole = -1;
        g_miSeat = 0;
        return;
    }
    if (g_miRole == 816) {
        BOTC_ManualDeathCancel();
        return;
    }
    // 【瘟疫医生相克】点【取消】/ X：停在这一步（男爵已转化的玩家保留）。
    if (g_miRole == 819) {
        g_miRole = -1;
        g_miSeat = 0;
        if (g_pdJinxKind == 1 && g_pdBarN > 0) {
            BOTC_PmStore(g_teller, "【瘟疫医生×男爵】已有 " + IntToString(g_pdBarN) + " 名玩家变成外来者。");
        }
        else {
            BOTC_PmStore(g_teller, "【瘟疫医生】说书人取消了这一步，瘟疫医生没有留下爪牙能力。");
        }
        BOTC_PlagueDoctorJinxClear();
        return;
    }
    // 【小精灵】阶段点取消 / X = 不发信息、不打 token，本局不再为这个座位询问。
    if (g_miRole == 86) {
        seat = g_miSeat;
        g_miSeat = 0;
        g_miRole = -1;
        g_pixiePickRole = 0;
        if (seat >= 2 && seat <= 13) {
            BOTC_PmStore(g_teller, "【小精灵】" + BOTC_NameStr(seat) + " 未选择镇民玩家，本局不再询问。");
        }
        return;
    }
    // 【帽匠 · 茶会换角色】（用户 2026-11-09）：点 X = 这一位不换。
    if (g_miRole == 818) {
        seat = g_miSeat;
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(seat) + " 保持不变。");
        BOTC_HatRoleNext();
        return;
    }
    if (g_miRole == 813) {
        seat = g_miSeat;
        BOTC_GudiaoAnswer(seat, false);
        return;
    }
    if (g_miRole == 811) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_EnvoyAnswer(false);
        return;
    }
    if (g_miRole == 812) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_BrokerAnswer(false);
        return;
    }
    // 【半兽人 × 陌客 / 间谍】（用户 2026-11-11）：点 X = 不击杀，恶魔正常出刀。
    if (g_miRole == 805) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_LycanAnswer(0);
        return;
    }
    // 【店小二（115）】（用户 2026-11-06）：确认框点取消 = 不直接告知熟客 / 醉酒，改为手动填两名
    if (g_miRole == 41 && g_miKind == 22) {
        seat = g_miSeat;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_DxeManualOpen(seat);
        return;
    }
    // 【疯子 · 提线木偶】（用户 2026-11-01）：点取消 = 这次不告知提线木偶。
    //   【提线木偶已独立到第 19 位】（用户 2026-11-13）：假疯子追问已在第 15 位
    //   假爪牙确认后问过，这里不能再串一次，否则会重复弹出「填一名假疯子」。
    if (g_miRole == 41 && g_miKind == 15) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_PmStore(g_teller, "【信息】已取消本次附加信息，不向该玩家发送。");
        // 兜底：正常情况下第 15 位已经发完；这里空队列时不会重复发送。
        BOTC_LunInfoFlush();
        return;
    }
    // 【疯子附加信息 / 假军团填写】（16 / 17 / 18 / 19）：点取消 = 这次不发送。
    if (g_miRole == 41 && (g_miKind == 16 || g_miKind == 17 || g_miKind == 18 || g_miKind == 19)) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        g_lgPend = false;
        BOTC_PmStore(g_teller, "【信息】已取消本次附加信息，不向该玩家发送。");
        return;
    }
    // 【疯子 · 假疯子座位】（23）：点取消 = 这次不告知。
    //   【疯子信息合批】（用户 2026-11-10）：这是整条链的最后一环，跳过也要把前面攒的
    //   爪牙 / 提线木偶信息一次性发出去，不能因为跳过就一条都不发。
    if (g_miRole == 41 && g_miKind == 23) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_PmStore(g_teller, "【疯子·假疯子】已跳过本条信息。");
        BOTC_LunInfoFlush();
        return;
    }
    // 【疯子 · 假疯子刀人 / 奥赫角色名】（24 / 25）：点取消 = 这次不告知。
    if (g_miRole == 41 && (g_miKind == 24 || g_miKind == 25)) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_PmStore(g_teller, "【疯子·假疯子】已跳过本条信息。");
        return;
    }
    // 【疯子假爪牙】点取消 = 这次什么都不发，可用于罂粟种植者局手动控制疯子是否知情。
    if (g_miRole == 41 && g_miKind == 0) {
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        BOTC_LunInfoClean();
        BOTC_PmStore(g_teller, "【疯子】已取消本次爪牙信息，不向疯子发送任何内容。");
        return;
    }
    // 【二选一醉酒】（用户 2026-10-16）：点取消 = 这次谁也不醉（只有中毒/酒鬼那次才给取消键）
    //   【店小二移醉酒】（用户 2026-11-06）：必须选两名玩家之一，点取消 / X 不生效，重新弹出面板。
    if (g_miRole == 807) {
        if (g_dkKind == 3) {
            BOTC_Notice(g_teller, "必须把「醉酒」标记移到这两名玩家之一。");
            BOTC_DrunkPickOpen(3, g_dkFrom, g_dkA, g_dkB);
            return;
        }
        g_miRole = -1;
        g_dkKind = 0;
        g_dkFrom = 0;
        g_dkA = 0;
        g_dkB = 0;
        return;
    }
    // 【发送特定信息】（用户 2026-10-10）：取消 = 退出「点收件人」模式（不然下一次点座位又会弹框）
    if (g_miRole == 801 || g_miRole == 802 || g_miRole == 803 || g_miRole == 808) {
        g_specMode = 0;
        g_specTo = 0;
        g_miSeat = 0;
        g_miRole = -1;
    }
    if (g_miRole == 41 && g_miKind == 9) {
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(0, 0);
        BOTC_NotifyDemonsLunatic();
    }
}

bool BOTC_LegionVoteVoid () {
    int i;
    int n;
    if (!BOTC_LegionOn()) {
        return false;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_vote[i] != 1) {
            continue;
        }
        if (BOTC_WinAlignOf(i) == 0) {
            // 【军团×狂热者 · 相克】（用户 2026-11-11）：狂热者可能被军团当作邪恶玩家，
            //   他的赞成票不算「善良玩家投票」，不阻止本次投票作废。
            if (!BOTC_HasAbility(i, 110)) {
                return false;
            }
        }
        n = n + 1;
    }
    if (n <= 0) {
        return false;
    }
    return true;
}

// 【发送给所有恶魔】（用户 2026-09-30）：一键把 3 个不在场身份发给**所有恶魔**（军团局省事）。
//   跳过身上带「是疯子(49)」或「是哲学家(70)」token 的座位（认知覆盖的假恶魔，不该收），
//   也跳过真身是提线木偶的座位。
void BOTC_BluffSendToDemons () {
    int i;
    int q;
    int r;
    int n;
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 3) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 49] || g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "没有符合条件的恶魔（带「是疯子」或「是哲学家」的会跳过）。");
    }
    else {
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + IntToString(n) + " 名恶魔（逐条记录见上）。");
    }
}

void BOTC_BluffSendToMinions () {
    int q;
    int r;
    int n;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 2) {
            continue;
        }
        if (BOTC_SeatTrueRole(q) == 93) {
            continue;
        }
        BOTC_BluffRoll();
        BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
        n = n + 1;
    }
    if (n == 0) {
        BOTC_NoticeBox(g_teller, "场上没有爪牙（提线木偶不算）。");
        return;
    }
    BOTC_PmStore(g_teller, "【不在场身份】已分别发给 " + IntToString(n) + " 名爪牙（逐条记录见上）。");
}

