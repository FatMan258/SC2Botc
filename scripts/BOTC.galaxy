    g_tipLine[718] = StringToText("都选择存活，") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营获胜。否则，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
