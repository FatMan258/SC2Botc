//--------------------------------------------------------------------------------------------------
// 昼夜系统（仅说书人可切换）：夜晚上一层深蓝遮罩，只压暗地图，不影响面板可读性
//--------------------------------------------------------------------------------------------------
bool        g_isNight;
// 【调试总开关】诊断日志（【诊断·...】）与测试播报（【测试】...）、真魔典同步都看它。
//   关掉 = 玩正式局时的干净界面；想再调试就在聊天里发 debug（或在 BOTC_GrimInitData 里改默认值）。
bool        g_debugOn;
// 【测试·私聊镜像】开启后，BOTC_PmInfo 发给玩家的角色结果会同步写一行到说书人私聊窗。
bool        g_pmInfoMirrorOn;
// 【提名环节】20 秒「自由提名时间」：有人提名（阶段 2..6）时暂停，提名结束回到阶段 1 继续倒数；
//   倒数到 0 就收掉提名环节（智能说书模式下，有人过票就先按票数处决）
int         g_nomFreeSec;
bool        g_nomFreeOn;
timer       g_tNomFree;
trigger     g_tNomFreeTrig;
// 胜利面板上面那条「恭喜...获胜」（单独一个对话框）+ 复盘按钮
