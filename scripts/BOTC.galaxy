        }
        if (c == g_pickEvilBtn) {
            if (p == g_teller) {
                BOTC_PickAlignToggle(1);
            }
            return true;
        }
        // 【认知偏差】（用户 2026-11-09）：酒鬼 / 疯子 / 悟道者 / 提线木偶，互斥。
        if (c == g_pickCogBtn[0]) {
            if (p == g_teller) {
                BOTC_PickCogToggle(0);
            }
            return true;
        }
        if (c == g_pickCogBtn[1]) {
            if (p == g_teller) {
                BOTC_PickCogToggle(1);
            }
