//==================================================================================================
//  血染钟楼（Blood on the Clocktower）- 说书人地图
//  玩家1 = 说书人，玩家2..13 = 参与者
//  公屏：直接用星际自带聊天（回车键）打字，脚本监听后同步到面板记录区
//  私聊：请求式；加入需全体成员同意；可随时退出；说书人免请求。
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// 【按句柄踢人 · 黑名单】（用户 2026-10-02）
//   名单与检查函数位于私有依赖 BOTC_Private.SC2Mod；主脚本只保留调用。
//   开局时按每个真人座位的 Battle.net 句柄检查，命中就 KickFromGame 踢出去。
//--------------------------------------------------------------------------------------------------
// 黑名单数据与检查逻辑由私有依赖 BOTC_Private.SC2Mod 提供。

//--------------------------------------------------------------------------------------------------
// 【玩家离开游戏】（用户 2026-10-02）：**在公聊里播**一句「玩家N 离开了小镇」（「离开了小镇」四个字走 BOTC_KeyColor 的红字）。
//   · 一个人只播一次（g_leftShown 记账，换局清零）；检测走 0.5 秒 tick 里的 BOTC_LeftCheck()。
//--------------------------------------------------------------------------------------------------
bool[14]    g_leftShown;      // 这一局已经为他播过了
// 【中途退出保留座位】（用户 2026-11-01）：游戏已开始后有人退出 → 座位留到结算再移除；
//   退出造成的死亡画**蓝叉**（正常死亡仍是红叉）。两张表都按**物理座位**索引，换位时不用搬。
bool[14]    g_leftKeepP;      // 物理座位：这一局退出后座位保留（胜利结算后统一清）
bool[14]    g_leftDeadP;      // 物理座位：退出导致的死亡（画蓝叉）

//--------------------------------------------------------------------------------------------------
// 【投票踢人】（用户 2026-10-02）：聊天里发 -kick → 弹魔典点一个座位 → 对他发起踢出投票；
//   公聊播「A 对 B 发起了踢出投票」；屏幕中间弹一个**没有背景**的对话框（左下【是】/ 右下【否】/ 底部居中票数）；
//   赞成票严格过半（场上人数 / 2 向下取整 + 1）就把他 KickFromGame 踢出去；60 秒没投完作废。
//--------------------------------------------------------------------------------------------------

int         g_kickTar;        // 被投票踢的人（0 = 没有投票在跑）
int         g_kickMode;       // 谁正在用 -kick 选人（0 = 没人在选）
int         g_kickBy;         // 这次投票是谁发起的（发起人一定能投，说书人发起时也能投）
int[14]     g_kickVote;       // 每人投的：0 没投 / 1 是 / 2 否
int         g_kickSec;        // 剩余秒数（超时作废）
int         g_kickHalf;       // 0.5 秒 tick 里数到 2 才算 1 秒
int         g_kickDlg;
int         g_kickTitle;
int         g_kickYes;
int         g_kickNo;
int         g_kickCnt;

