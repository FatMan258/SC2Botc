        g_levJinxWake[i] = false;
        g_levJinxLost[i] = false;
    }
    g_farmViaLevi = false;
    g_mmExtra = false;             // 主谋（42）：加时
    g_mmArmed = false;
    g_mmDone = false;
    g_devAdvLast = 0;              // 魔鬼代言人（40）
    g_pacifistUsed = 0;            // 和平主义者（33）：换局重新从 30% 起算
    // 【配比 50/50 换局重掷】（用户 2026-09-23：随机发牌抽到气球驾驶员永远显示「镇民不变」）----
    //   这两份 50/50 以前只在整张地图里掷一次，掷过（或者手动点过 0 / +1 按钮）之后就再也不重掷了，
    //   于是后面每一把看到的都是同一个方向。这里跟着换局一起放开，让它每局重掷。
    g_balPlusSeeded = false;
    g_gfPlusSeeded = false;
