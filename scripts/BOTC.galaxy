    g_tipLine[616] = StringToText("说书人并没有义务提醒") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("来选择玩家。") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("必须在得知自己死亡后的短时间内使");
