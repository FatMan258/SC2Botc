    g_tipLine[2501] = StringToText("赏金猎人（镇民）");
    g_tipLine[2502] = StringToText("【角色能力】");
    g_tipLine[2503] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。每当你得知的玩家死亡，");
    g_tipLine[2504] = StringToText("  你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipLine[2505] = StringToText("【角色简介】");
    g_tipLine[2506] = StringToText("赏金猎人会一个个地追踪邪恶玩家。");
    g_tipLine[2507] = StringToText("· 在赏金猎人的首个夜晚，他会得知一名邪恶玩家。当赏金猎人得知的那名玩家死亡后，");
    g_tipLine[2508] = StringToText("  他会再得知另一名邪恶玩家。");
    g_tipLine[2509] = StringToText("· 赏金猎人只会得知一名邪恶玩家，而不会得知他的具体角色。");
    g_tipLine[2510] = StringToText("· 如果赏金猎人在应当得知新玩家的时候醉酒或中毒了，");
    g_tipLine[2511] = StringToText("  说书人可以让赏金猎人得知一名善良玩家。当这名玩家死亡后，");
    g_tipLine[2512] = StringToText("  赏金猎人会在当晚得知一名新玩家。");
    g_tipLine[2513] = StringToText("· 赏金猎人不会重复得知同一个邪恶玩家两次。");
    g_tipLine[2514] = StringToText("· 如果赏金猎人初始就加入了本局游戏，在设置调整阶段，会有一名镇民加入邪恶阵营。");
    g_tipLine[2515] = StringToText("  赏金猎人可以得知这名邪恶的镇民玩家。");
    g_tipLine[2516] = StringToText("【规则细节】");
    g_tipLine[2517] = StringToText("· 请注意，赏金猎人在首个夜晚的行动顺序非常靠后。那是唤醒赏金猎人，");
    g_tipLine[2518] = StringToText("  向他展示他所得知的邪恶玩家的时机。然而，被赏金猎人转变的玩家从一开始就已经属于邪恶阵");
    g_tipLine[2519] = StringToText("  营，应该在首个夜晚立即告知他是邪恶的，并且你作为说书人应当在给出其他夜晚信息之前谨记");
    g_tipLine[2520] = StringToText("  这回事——那名玩家已经属于邪恶阵营，尽管赏金猎人还未被唤醒。");
    g_tipLine[2521] = StringToText("· 如果赏金猎人醉酒或中毒或处于涡流在场的游戏中，在他能够得到信息的时候，");
    g_tipLine[2522] = StringToText("  你可以（在涡流在场时必须）向他给出错误信息并展示一名善良玩家。");
    g_tipLine[2523] = StringToText("  如果赏金猎人在之后清醒，他不会因此得知新的信息，即使他仍然认为那名善良玩家是邪恶的。");
    g_tipLine[2524] = StringToText("  当赏金猎人得知的玩家死亡，他在当晚得知一名新的玩家。");
    g_tipLine[2525] = StringToText("· 如果「被得知」的邪恶玩家在之后转变为善良，这不会影响赏金猎人，");
    g_tipLine[2526] = StringToText("  赏金猎人为了获得进一步信息仍然需要那名玩家死亡。");
    g_tipLine[2527] = StringToText("· 值得注意的是，如果你觉得赏金猎人已经获得过很多信息了，");
    g_tipLine[2528] = StringToText("  可以向他指出一名死亡的邪恶玩家。死亡玩家不能再次死亡，所以赏金猎人不会获得新的信息，");
    g_tipLine[2529] = StringToText("  除非那名玩家被复活并再次被杀死。");
    g_tipLine[2530] = StringToText("· 对于旅行者，离开游戏和被流放都会导致他死亡——所以如果赏金猎人此前得知了一名旅行者，");
    g_tipLine[2531] = StringToText("  上述两种情况都会使得赏金猎人在当晚获得新的信息。");
    g_tipLine[2532] = StringToText("· 相克规则：");
    g_tipLine[2533] = StringToText("· 哲学家：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_tipLine[2534] = StringToText("· 卡扎力：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_tipLine[2535] = StringToText("贵族（镇民）");
    g_tipLine[2536] = StringToText("【角色能力】");
    g_tipLine[2537] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipLine[2538] = StringToText("【角色简介】");
    g_tipLine[2539] = StringToText("贵族能得知三名玩家中的一名是邪恶的。");
    g_tipLine[2540] = StringToText("· 贵族只会在第一个夜晚得知他的信息。");
    g_tipLine[2541] = StringToText("· 如果贵族在游戏中途被创造，他会在自己作为贵族时的第一个夜晚得知信息。");
    g_tipLine[2542] = StringToText("· 贵族得知的是两名善良玩家和一名邪恶玩家。他不会得知一名善良玩家和两名邪恶玩家，");
    g_tipLine[2543] = StringToText("  也不会得知三名邪恶玩家。");
    g_tipLine[2544] = StringToText("【规则细节】");
    g_tipLine[2545] = StringToText("· 特定角色互动：");
    g_tipLine[2546] = StringToText("· 异教领袖：就算在首夜因为自身能力就变为邪恶，也不会被贵族当做邪恶玩家得知。");
    g_tipLine[2547] = StringToText("  因为异教领袖的首夜行动顺序在贵族之后，他在贵族在被唤醒时始终都是善良的。");
    g_tipLine[2548] = StringToText("· 舞蛇人：可能在贵族醒来之前阵营发生交换，所以在贵族信息中需要展示新的阵营状态。");
    g_tipLine[2549] = StringToText("· 莽夫：在贵族醒来时，莽夫的阵营可能已经变为邪恶，所以可以将莽夫作为邪恶玩家展示。");
    g_tipLine[2550] = StringToText("  注意，贵族没有使用自身能力选择莽夫。");
    g_tipLine[2551] = StringToText("· 陌客/间谍：可以被贵族当作邪恶或善良。");
    g_tipLine[2552] = StringToText("女祭司（镇民）");
    g_tipLine[2553] = StringToText("【角色能力】");
    g_tipLine[2554] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[2555] = StringToText("【角色简介】");
    g_tipLine[2556] = StringToText("女祭司凭借直觉行事。");
    g_tipLine[2557] = StringToText("· 女祭司可以连续几个夜晚得知同一名玩家，也可以在每个夜晚都得知不同的玩家。");
    g_tipLine[2558] = StringToText("· 她得知的玩家可以是存活玩家，也可以是死亡玩家。");
    g_tipLine[2559] = StringToText("· 她得知的玩家可以是善良玩家，也可以是邪恶玩家。");
    g_tipLine[2560] = StringToText("· 没有绝对的标准用于决定说书人究竟要给女祭司什么样的信息。");
    g_tipLine[2561] = StringToText("  说书人通过自己的判断来决定给出女祭司的信息内容，");
    g_tipLine[2562] = StringToText("  这取决于他认为给出什么样的信息能够对女祭司和善良阵营更加有利。");
    g_tipLine[2563] = StringToText("  这可能是因为某些玩家有重要信息但尚未公布，或是邪恶玩家的伪装一戳即破，");
    g_tipLine[2564] = StringToText("  或是有值得被信赖的玩家需要建立更强的信任，或是有善良玩家的推理出现了谬误，");
    g_tipLine[2565] = StringToText("  急需被纠正，或是其他各种各样的原因。");
    g_tipLine[2566] = StringToText("【规则细节】");
    g_tipLine[2567] = StringToText("无额外规则。");
    g_tipLine[2568] = StringToText("旅店老板（镇民）");
    g_tipLine[2569] = StringToText("【角色能力】");
    g_tipLine[2570] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会醉酒到下个黄昏。");
    g_tipLine[2571] = StringToText("【角色简介】");
    g_tipLine[2572] = StringToText("旅店老板在夜晚保护玩家们免于死亡，但是某些人在此过程中会醉酒。");
    g_tipLine[2573] = StringToText("· 与僧侣类似，旅店老板能让玩家们不被恶魔杀死。受保护的玩家也不会因为外来者、爪牙、");
    g_tipLine[2574] = StringToText("  镇民和旅行者的能力而死亡。");
    g_tipLine[2575] = StringToText("· 旅店老板只在夜晚保护玩家，并不包括白天。");
    g_tipLine[2576] = StringToText("· 旅店老板选择的两名玩家其中之一将在当晚和下一个白天醉酒。该玩家可以是善良的或邪恶的，");
    g_tipLine[2577] = StringToText("  但几乎总会是善良的，这取决于你的游戏走向。选择了自己的旅店老板可能会醉酒，");
    g_tipLine[2578] = StringToText("  这意味着他会失去能力并且当晚可以死亡，而他保护的另一个人也不再安全。");
    g_tipLine[2579] = StringToText("【规则细节】");
    g_tipLine[2580] = StringToText("· 相克规则：");
    g_tipLine[2581] = StringToText("· 利维坦：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[2582] = StringToText("· 暴乱：如果暴乱提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[2583] = StringToText("赌徒（镇民）");
    g_tipLine[2584] = StringToText("【角色能力】");
    g_tipLine[2585] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[2586] = StringToText("【角色简介】");
    g_tipLine[2587] = StringToText("赌徒能够猜测玩家的角色……但是猜错的代价是相当巨大的。");
    g_tipLine[2588] = StringToText("· 除了首个夜晚以外的每个夜晚，赌徒需要选择一名玩家，");
    g_tipLine[2589] = StringToText("  并在角色列表上指向一个角色图标来猜测其角色。如果猜测正确，无事发生。如果猜测错误，");
    g_tipLine[2590] = StringToText("  赌徒死亡。");
    g_tipLine[2591] = StringToText("· 赌徒不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[2592] = StringToText("· 赌徒可以选择任何玩家，无论是已死亡还是存活，甚至可以是赌徒自己。");
    g_tipLine[2593] = StringToText("【规则细节】");
    g_tipLine[2594] = StringToText("无额外规则。");
    g_tipLine[2595] = StringToText("半兽人（镇民）");
    g_tipLine[2596] = StringToText("【角色能力】");
    g_tipLine[2597] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，并且当晚恶魔不会造成死亡。");
    g_tipLine[2598] = StringToText("  会有一名善良玩家始终被当作邪恶阵营。");
    g_tipLine[2599] = StringToText("【角色简介】");
    g_tipLine[2600] = StringToText("半兽人会在夜晚游荡，猎杀无辜，与此同时恶魔在自己的老巢里蛰伏。");
    g_tipLine[2601] = StringToText("· 半兽人必须在每个夜晚选择一名存活的玩家。如果半兽人选择了已死亡的玩家，");
    g_tipLine[2602] = StringToText("  说书人会摇头并让半兽人重新选择。");
    g_tipLine[2603] = StringToText("· 如果半兽人选择的玩家是善良玩家，那名玩家死亡，并且当晚恶魔不能造成死亡。");
    g_tipLine[2604] = StringToText("· 如果半兽人选择的玩家是邪恶玩家，那名玩家不会死亡，并且恶魔可以造成死亡。");
    g_tipLine[2605] = StringToText("· 如果半兽人攻击了善良的玩家但没有导致那名玩家死亡，恶魔可以造成死亡。");
    g_tipLine[2606] = StringToText("· 恶魔与造成死亡无关的能力仍然会正常运作，不会受到半兽人的能力影响。");
    g_tipLine[2607] = StringToText("· 一名善良玩家始终被当作邪恶阵营。他同样也被半兽人当作邪恶阵营，");
    g_tipLine[2608] = StringToText("  因此半兽人无法杀死这名玩家。");
    g_tipLine[2609] = StringToText("【规则细节】");
    g_tipLine[2610] = StringToText("无额外规则。");
    g_tipLine[2611] = StringToText("城镇公告员（镇民）");
    g_tipLine[2612] = StringToText("【角色能力】");
    g_tipLine[2613] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipLine[2614] = StringToText("【角色简介】");
    g_tipLine[2615] = StringToText("城镇公告员得知爪牙是否提名。");
    g_tipLine[2616] = StringToText("· 每个夜晚，城镇公告员都会得知「是」或「否」。");
    g_tipLine[2617] = StringToText("· 他不会得知哪些玩家是爪牙或有多少爪牙进行了提名，");
    g_tipLine[2618] = StringToText("  只会得知今天白天是否有爪牙发起了提名。");
    g_tipLine[2619] = StringToText("【规则细节】");
    g_tipLine[2620] = StringToText("无额外规则。");
    g_tipLine[2621] = StringToText("造谣者（镇民）");
    g_tipLine[2622] = StringToText("【角色能力】");
    g_tipLine[2623] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[2624] = StringToText("【角色简介】");
    g_tipLine[2625] = StringToText("造谣者会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[2626] = StringToText("· 每个白天，造谣者可以公开发表一个声明。如果该声明是正确的，");
    g_tipLine[2627] = StringToText("  说书人会在当晚杀死一名玩家。如果声明是错误的，那就没有玩家会因造谣者而死。");
    g_tipLine[2628] = StringToText("· 含糊不清的词语、低声细语、说书人无法判断对错的声明、");
    g_tipLine[2629] = StringToText("  或是发表声明时有人没听到等情况下，声明都不作数。如同猎手的能力，");
    g_tipLine[2630] = StringToText("  说书人和每一名玩家都必须要听到并明确造谣者发表的声明，明白造谣者正在使用自己的能力，");
    g_tipLine[2631] = StringToText("  以此来让说书人判定接下来会发生什么。");
    g_tipLine[2632] = StringToText("· 如果造谣者在白天处于醉酒或中毒时发表了一个正确的声明，");
    g_tipLine[2633] = StringToText("  但当晚造谣者能力触发时他恢复了清醒和健康，那么说书人仍然会杀死一名玩家。");
    g_tipLine[2634] = StringToText("【规则细节】");
    g_tipLine[2635] = StringToText("无额外规则。");
    g_tipLine[2636] = StringToText("守夜人（镇民）");
    g_tipLine[2637] = StringToText("【角色能力】");
    g_tipLine[2638] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipLine[2639] = StringToText("【角色简介】");
    g_tipLine[2640] = StringToText("守夜人会让一名玩家得知他是守夜人。");
    g_tipLine[2641] = StringToText("· 在夜晚，守夜人选择一名玩家。这名玩家被唤醒，然后得知谁是守夜人。");
    g_tipLine[2642] = StringToText("· 守夜人和他选择的玩家不会有眼神交流。他们分开被唤醒。");
    g_tipLine[2643] = StringToText("· 守夜人选择哪个夜晚使用自己的能力。");
    g_tipLine[2644] = StringToText("【规则细节】");
    g_tipLine[2645] = StringToText("· 处于醉酒或中毒状态下且使用了自己能力的守夜人，会和能力正常生效的守夜人一样在游戏的剩");
    g_tipLine[2646] = StringToText("  余时间里将不会再被唤醒。");
    g_tipLine[2647] = StringToText("· 特定角色互动：");
    g_tipLine[2648] = StringToText("· 学徒/食人族/哲学家/小精灵：仍然向被选择的玩家展示守夜人标记，");
    g_tipLine[2649] = StringToText("  即使是那名玩家是那些获得守夜人能力的角色。");
    g_tipLine[2650] = StringToText("· 咖啡师：如果还未使用能力的守夜人受到咖啡师行动两次的影响，他可以选择两名玩家，");
    g_tipLine[2651] = StringToText("  被选择的玩家都会被告知。被选择的玩家不会被告知两次。");
    g_tipLine[2652] = StringToText("· 侍女：守夜人在夜晚被唤醒可被侍女探查，即使当晚他选择不使用能力。然而，");
    g_tipLine[2653] = StringToText("  被守夜人选择的玩家不会被探查，因为他是由于守夜人的能力而被唤醒，而不是他自身的能力。");
    g_tipLine[2654] = StringToText("· 莽夫：如果守夜人是当晚首个使用其自身能力选择了莽夫的玩家，守夜人会被莽夫醉酒，");
    g_tipLine[2655] = StringToText("  而莽夫不会得知守夜人是谁。");
    g_tipLine[2656] = StringToText("女裁缝（镇民）");
    g_tipLine[2657] = StringToText("【角色能力】");
    g_tipLine[2658] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[2659] = StringToText("【角色简介】");
    g_tipLine[2660] = StringToText("女裁缝能得知两名玩家是否属于同一阵营。");
    g_tipLine[2661] = StringToText("· 女裁缝每场游戏只能得到一次信息，所以女裁缝最好是选择最佳时机来使用能力，");
    g_tipLine[2662] = StringToText("  还要选择最关键的玩家。");
    g_tipLine[2663] = StringToText("· 女裁缝可以选择除自己外的任何玩家，无论他是生是死，甚至可以选择旅行者。");
    g_tipLine[2664] = StringToText("【规则细节】");
    g_tipLine[2665] = StringToText("无额外规则。");
    g_tipLine[2666] = StringToText("杂技演员（镇民）");
    g_tipLine[2667] = StringToText("【角色能力】");
    g_tipLine[2668] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipLine[2669] = StringToText("【角色简介】");
    g_tipLine[2670] = StringToText("杂技演员会在找到醉酒或中毒的玩家时死亡。");
    g_tipLine[2671] = StringToText("· 除首个夜晚之外的每个夜晚，杂技演员要选择一名玩家。如果该玩家在当晚保持清醒健康，");
    g_tipLine[2672] = StringToText("  什么也不会发生；如果该玩家醉酒或中毒，杂技演员就会死亡。");
    g_tipLine[2673] = StringToText("· 如果杂技演员自己醉酒或中毒，则不会因自身能力而死亡。");
    g_tipLine[2674] = StringToText("· 杂技演员可以选择任何玩家——无论存活还是死亡的玩家，也可以选择自己。");
    g_tipLine[2675] = StringToText("· 如果杂技演员选择的玩家在被选择时是清醒健康的，但在夜晚稍后阶段醉酒或中毒了，");
    g_tipLine[2676] = StringToText("  杂技演员仍会死亡。");
    g_tipLine[2677] = StringToText("· 杂技演员不会得知所选玩家是醉酒、中毒，还是两者皆有。");
    g_tipLine[2678] = StringToText("· 酒鬼（Drunk）会被杂技演员当作醉酒（drunk）（双关）。");
    g_tipLine[2679] = StringToText("【规则细节】");
    g_tipLine[2680] = StringToText("无额外规则。");
    g_tipLine[2681] = StringToText("食人族（镇民）");
    g_tipLine[2682] = StringToText("【角色能力】");
    g_tipLine[2683] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipLine[2684] = StringToText("【角色简介】");
    g_tipLine[2685] = StringToText("食人族会吃下被处决的角色，并获得他们的能力。");
    g_tipLine[2686] = StringToText("· 如果一名善良玩家死于处决，食人族能获得他的能力。如果一名邪恶玩家死于处决，");
    g_tipLine[2687] = StringToText("  食人族也只会认为自己获得了能力，因为他中毒了，说书人可能会对他撒谎。");
    g_tipLine[2688] = StringToText("· 每当有一名玩家死于处决时，食人族会失去上一次获得的能力。");
    g_tipLine[2689] = StringToText("· 处决一名已经死亡的玩家不会让食人族获得能力。处决一名存活但并未导致死亡的玩家也不会让");
    g_tipLine[2690] = StringToText("  食人族获得能力。玩家必须要被处决并因此死亡，才会让食人族获得能力。");
    g_tipLine[2691] = StringToText("· 食人族不会被告知自己获得了什么能力。他必须自己弄明白。");
    g_tipLine[2692] = StringToText("· 如果食人族获得了「即使你已死亡」的能力，例如陌客，或在死亡后才会生效的能力，");
    g_tipLine[2693] = StringToText("  例如守鸦人或心上人，食人族会在死亡时仍然保留这些能力，");
    g_tipLine[2694] = StringToText("  但失去食人族自己角色本身的能力。");
    g_tipLine[2695] = StringToText("【规则细节】");
    g_tipLine[2696] = StringToText("· 如果死于处决的玩家在随后改变角色或转换阵营，同样会被食人族持续检测。");
    g_tipLine[2697] = StringToText("· 特定角色互动：");
    g_tipLine[2698] = StringToText("· 异教领袖/莽夫：获得这些能力将允许食人族转变阵营，");
    g_tipLine[2699] = StringToText("  如果有另一名无法转变阵营的玩家在食人族转变为原来阵营之前死于处决，");
    g_tipLine[2700] = StringToText("  食人族将被锁定为他当前的阵营。");
    g_tipLine[2701] = StringToText("· 杂耍艺人：如果杂耍艺人死于处决，食人族只能在第二天无人死于处决的情况下从杂耍艺人的能");
    g_tipLine[2702] = StringToText("  力获得信息。在杂耍艺人被处决的下一个白天是食人族杂耍艺人的「首个白天」，");
    g_tipLine[2703] = StringToText("  所以他必须在当天进行公开猜测，并且必须确保无人死于处决。");
    g_tipLine[2704] = StringToText("  以便食人族杂耍艺人保持他的能力，在当晚得到猜测的结果。");
    g_tipLine[2705] = StringToText("· 酒鬼：如果食人族获得酒鬼的能力，你可以欺骗食人族是任何镇民，");
    g_tipLine[2706] = StringToText("  包括酒鬼自以为的那个角色。");
    g_tipLine[2707] = StringToText("· 疯子：如果食人族获得疯子的能力，你应该告诉食人族，他现在是剧本上的某个恶魔，");
    g_tipLine[2708] = StringToText("  并在疯子的夜晚行动顺序时唤醒食人族进行攻击，之后唤醒恶魔，");
    g_tipLine[2709] = StringToText("  恶魔得知食人族玩家是疯子以及攻击目标。");
    g_tipLine[2710] = StringToText("· 畸形秀演员：如果食人族拥有畸形秀演员能力，他可以声称自己是一个拥有畸形秀演员能力的食");
    g_tipLine[2711] = StringToText("  人族，并且不会被处决，因为他没有声称自己是外来者。然而，如果他声称自己是畸形秀演员，");
    g_tipLine[2712] = StringToText("  他可能会被处决。");
    g_tipLine[2713] = StringToText("· 政客：如果食人族获得政客的能力，他将与已经死亡的政客发生竞争。");
    g_tipLine[2714] = StringToText("  因为只有一名玩家能够为自己阵营失败负最大责任，所以只有一名玩家可以转变阵营并获胜。");
    g_tipLine[2715] = StringToText("· 洗脑师：如果一名玩家被洗脑并对特定角色疯狂，他不能声称自己是拥有该角色能力的食人族，");
    g_tipLine[2716] = StringToText("  期望以此逃避违反洗脑疯狂的处决。因为他没有声称自己就是这个角色，这不符合疯狂的要求。");
    g_tipLine[2717] = StringToText("· 教授/沙巴洛斯：当食人族复活，他将获得最近死于处决的玩家能力。");
    g_tipLine[2718] = StringToText("· 呆瓜/月之子：参考管家的相克规则，如果食人族玩家在获得这些角色能力的时候死亡，");
    g_tipLine[2719] = StringToText("  且不知道自己是否获得了对应的能力的时候，说书人应该对他进行提醒。即使不进行提醒，");
    g_tipLine[2720] = StringToText("  也不应该算作是作弊。");
    g_tipLine[2721] = StringToText("· 相克规则：");
    g_tipLine[2722] = StringToText("· 杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，");
    g_tipLine[2723] = StringToText("  当晚食人族会替杂耍艺人得知对应的信息。");
    g_tipLine[2724] = StringToText("· 管家：如果食人族获得了管家的能力，他会得知这一信息。");
    g_tipLine[2725] = StringToText("· 狂热者：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[2726] = StringToText("· 公主：如果食人族提名并处决了公主且公主因此死亡，当晚恶魔不会造成死亡。");
    g_tipLine[2727] = StringToText("镇长（镇民）");
    g_tipLine[2728] = StringToText("【角色能力】");
    g_tipLine[2729] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。如果你在夜晚即将死亡，");
    g_tipLine[2730] = StringToText("  可能会有一名其他玩家代替你死亡。");
    g_tipLine[2731] = StringToText("【角色简介】");
    g_tipLine[2732] = StringToText("镇长可以在最后一天通过和平的方式获得胜利。");
    g_tipLine[2733] = StringToText("· 为了生存，镇长偶尔会让其他玩家「意外地」被杀死。如果镇长被攻击且即将死去时，");
    g_tipLine[2734] = StringToText("  说书人可以选择另一名玩家死亡。没有人会得知该玩家的死亡原因，");
    g_tipLine[2735] = StringToText("  仅仅只是得知该玩家死亡了。");
    g_tipLine[2736] = StringToText("· 如果在某个白天结束时只有三名玩家存活，并且那个白天没有人被处决，");
    g_tipLine[2737] = StringToText("  那么游戏结束且善良阵营获胜。");
    g_tipLine[2738] = StringToText("· 旅行者的数量也会被计入镇长的胜利条件中，因此他们必须先被流放。请记住流放并不是处决。");
    g_tipLine[2739] = StringToText("  （译注：如果场上有旅行者且包含旅行者在内的存活玩家只有三名，");
    g_tipLine[2740] = StringToText("  显然此时已经达成了邪恶阵营的胜利条件。因此如果游戏还未结束，");
    g_tipLine[2741] = StringToText("  说明场上至少还有三名非旅行者玩家，此时需要先对旅行者进行流放才能满足镇长的胜利条件。）");
    g_tipLine[2742] = StringToText("· 传奇角色的数量不会被计入镇长的胜利条件中，因为说书人不是一名玩家。");
    g_tipLine[2743] = StringToText("· 如果恶魔攻击了镇长，且说书人选择了一名已死亡玩家、士兵或被僧侣保护的玩家作为替代，");
    g_tipLine[2744] = StringToText("  则当晚不会有玩家死亡。（但这种情况不建议频繁发生）");
    g_tipLine[2745] = StringToText("【规则细节】");
    g_tipLine[2746] = StringToText("· 如果镇长的替死能力被触发，代替镇长死亡的角色，其死亡原因会与镇长保持一致。也就是说，");
    g_tipLine[2747] = StringToText("  如果恶魔攻击了镇长且贤者代替了镇长死亡，贤者能够触发他的能力。");
    g_tipLine[2748] = StringToText("  在判断那些死亡触发能力的角色的死亡原因时，这一点会显得比较重要。");
    g_tipLine[2749] = StringToText("· 同样地，在造成死亡的这个能力中，代替镇长死亡的角色会被当作选中为该能力的目标。");
    g_tipLine[2750] = StringToText("  原本这项能力是选择镇长并生效的，改为选择「代替镇长死亡的目标」并生效（不论这项选择是");
    g_tipLine[2751] = StringToText("  能力所属的玩家做出的还是说书人做出的）。也就是说，");
    g_tipLine[2752] = StringToText("  如果月之子选择了镇长而说书人想要通过镇长的能力改为「让一名邪恶玩家代替镇长死亡」，");
    g_tipLine[2753] = StringToText("  这会导致在能力实际生效时，被当作「月之子在白天选中了那名邪恶玩家」而导致不满足回溯条");
    g_tipLine[2754] = StringToText("  件，从而使得月之子无法通过能力杀死任何玩家。这虽然是可行的，");
    g_tipLine[2755] = StringToText("  但镇长能力的触发选择权在说书人，过于复杂的互动方式会让玩家难以理解，");
    g_tipLine[2756] = StringToText("  且结果并不一定会容易被所有玩家接受，不如参考镇长词条运作方式中的建议。");
    g_tipLine[2757] = StringToText("  此外镇长死在月之子手里和被大家当作邪恶玩家并死于处决其实结果并无区别，");
    g_tipLine[2758] = StringToText("  说书人应该考虑更为简单的处理方式。");
    g_tipLine[2759] = StringToText("· 虽然镇长的特殊胜利在黄昏时宣布，但镇长的特殊胜利能力触发是在白天，");
    g_tipLine[2760] = StringToText("  因此投毒者或者其他能让镇长醉酒或中毒的角色仍然会阻止镇长因为自己的能力而以特殊方式获");
    g_tipLine[2761] = StringToText("  胜。");
    g_tipLine[2762] = StringToText("· 特定角色互动：");
    g_tipLine[2763] = StringToText("· 数学家：在镇长因为失去能力或其他效果影响下无法触发「代替死亡」能力时，");
    g_tipLine[2764] = StringToText("  对于数学家获取的信息，可以+1或不变。这是由于镇长需要触发能力才能检测到能力未生效从");
    g_tipLine[2765] = StringToText("  而被数学家得知，而镇长的能力触发取决于说书人。通常来说，为了避免造成不必要的混乱，");
    g_tipLine[2766] = StringToText("  对于这类触发与否由说书人决定的能力，应该尽量以不变来告知数学家。但特殊情况下，");
    g_tipLine[2767] = StringToText("  如果这能避免玩家过早发现恶魔，那么可以视情况决定给出什么样的信息。");
    g_tipLine[2768] = StringToText("· 相克规则：");
    g_tipLine[2769] = StringToText("· 利维坦：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。");
    g_tipLine[2770] = StringToText("  （即使镇长是邪恶阵营也是如此。）");
    g_tipLine[2771] = StringToText("· 暴乱：镇长可以停止暴乱的提名链。如果他这样做了，并且场上只有一名暴乱存活，");
    g_tipLine[2772] = StringToText("  善良阵营获胜；否则，邪恶阵营获胜。");
    g_tipLine[2773] = StringToText("陌客（外来者）");
    g_tipLine[2774] = StringToText("【角色能力】");
    g_tipLine[2775] = StringToText("你可能会被当作邪恶阵营、爪牙角色或恶魔角色，即使你已死亡。");
    g_tipLine[2776] = StringToText("【角色简介】");
    g_tipLine[2777] = StringToText("陌客会看起来像是邪恶一员，但实际上是善良的。");
    g_tipLine[2778] = StringToText("· 任何时候要探查陌客的阵营时，由说书人来决定陌客被当作善良还是邪恶。");
    g_tipLine[2779] = StringToText("· 任何时候陌客被影响特定的爪牙或恶魔角色的能力选择时，");
    g_tipLine[2780] = StringToText("  由说书人来决定陌客是否会被当作某种特定的爪牙或是恶魔角色。");
    g_tipLine[2781] = StringToText("· 陌客能在同一个夜晚的不同能力中分别被当作善良或邪恶阵营，外来者、爪牙或恶魔角色。");
    g_tipLine[2782] = StringToText("  由说书人来选择最有趣的结果。");
    g_tipLine[2783] = StringToText("· 陌客在被当作特定的爪牙或恶魔角色时，不会获得这一角色的能力。例如，");
    g_tipLine[2784] = StringToText("  被当作投毒者的陌客无法在夜晚被唤醒，也无法让一名玩家中毒。");
    g_tipLine[2785] = StringToText("【规则细节】");
    g_tipLine[2786] = StringToText("· 陌客有很多「可以但不建议」的内容，希望各位说书人在有陌客在场的对局中为玩家提供良好的");
    g_tipLine[2787] = StringToText("  游戏体验而非寻求创意。");
    g_tipLine[2788] = StringToText("· 陌客的互动干扰能力中，阵营与角色是独立判断的。也就是说，");
    g_tipLine[2789] = StringToText("  如果有既能探查阵营也能探查角色的能力，那么陌客是有可能被当作「善良的恶魔」或者是「邪");
    g_tipLine[2790] = StringToText("  恶的陌客」的（如舞蛇人和食人族）。");
    g_tipLine[2791] = StringToText("· 相克规则：");
    g_tipLine[2792] = StringToText("· 贤者：陌客可能会被贤者当作杀死他的恶魔。");
    g_tipLine[2793] = StringToText("· 食人魔：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_tipLine[2794] = StringToText("月之子（外来者）");
    g_tipLine[2795] = StringToText("【角色能力】");
    g_tipLine[2796] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是善良的，在当晚他会死亡。");
    g_tipLine[2797] = StringToText("【角色简介】");
    g_tipLine[2798] = StringToText("月之子会在死亡时诅咒他人，将其杀死。");
    g_tipLine[2799] = StringToText("· 月之子必须在得知自己死亡后的一到两分钟内选择一名玩家，无论是被处决后，");
    g_tipLine[2800] = StringToText("  还是在黎明说书人宣布夜晚的死亡玩家后。月之子可以在作出决定前花点时间听取大家的建议。");
    g_tipLine[2801] = StringToText("· 如果月之子选择了一名善良玩家，该玩家会在当晚死亡。如果月之子选择了一名邪恶玩家，");
    g_tipLine[2802] = StringToText("  无事发生。");
    g_tipLine[2803] = StringToText("· 一如既往地，如果一名邪恶玩家伪装成月之子假装使用能力，说书人应当配合他。");
    g_tipLine[2804] = StringToText("· 说书人并没有义务提醒月之子来选择玩家。月之子必须在得知自己死亡后的短时间内使用自己的");
    g_tipLine[2805] = StringToText("  能力。故意不使用能力将被认定为作弊。");
    g_tipLine[2806] = StringToText("· 如果月之子在夜晚是清醒且健康的，但在今天白天选择玩家时是醉酒或中毒的，");
    g_tipLine[2807] = StringToText("  所选的玩家会死亡。如果月之子在夜晚是醉酒或中毒的，");
    g_tipLine[2808] = StringToText("  但在今天白天选择玩家时是清醒且健康的，所选的玩家不会死亡。");
    g_tipLine[2809] = StringToText("· 如果月之子在选择莽夫时，莽夫是善良的，则无论莽夫的阵营在夜晚如何变化，");
    g_tipLine[2810] = StringToText("  月之子都会杀死莽夫。");
    g_tipLine[2811] = StringToText("【规则细节】");
    g_tipLine[2812] = StringToText("无额外规则。");
    g_tipLine[2813] = StringToText("修补匠（外来者）");
    g_tipLine[2814] = StringToText("【角色能力】");
    g_tipLine[2815] = StringToText("你随时可能死亡。");
    g_tipLine[2816] = StringToText("【角色简介】");
    g_tipLine[2817] = StringToText("修补匠随时可能会死亡，不需要任何理由。");
    g_tipLine[2818] = StringToText("· 说书人随时可以杀死修补匠。");
    g_tipLine[2819] = StringToText("· 修补匠在受到免于死亡的能力保护时，不能因自己的能力而死亡。");
    g_tipLine[2820] = StringToText("【规则细节】");
    g_tipLine[2821] = StringToText("无额外规则。");
    g_tipLine[2822] = StringToText("帽匠（外来者）");
    g_tipLine[2823] = StringToText("【角色能力】");
    g_tipLine[2824] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipLine[2825] = StringToText("【角色简介】");
    g_tipLine[2826] = StringToText("帽匠允许邪恶角色的玩家改变自己的角色。");
    g_tipLine[2827] = StringToText("· 帽匠的能力使得所有邪恶角色的玩家可以选择变成与自己原本角色类型相同的角色。");
    g_tipLine[2828] = StringToText("· 这些玩家可以选择不改变自己的角色。");
    g_tipLine[2829] = StringToText("· 如果一名玩家变成了新的角色，他会获得新角色的能力，");
    g_tipLine[2830] = StringToText("  即使是一项「在你的首个夜晚」能力或是一项「每局游戏限一次」但此前已被其他玩家使用过的");
    g_tipLine[2831] = StringToText("  能力。");
    g_tipLine[2832] = StringToText("· 一旦玩家的角色变化，他此前的角色能力不再在本局游戏中生效。");
    g_tipLine[2833] = StringToText("· 如果一名玩家在死亡后再变成帽匠，邪恶角色的玩家无法在当晚因此改变自己的角色。");
    g_tipLine[2834] = StringToText("· 一旦某名玩家选择变成了某个角色后，其他玩家便无法选择变成同一角色。");
    g_tipLine[2835] = StringToText("  如果某名玩家选择变成了一个已在场的角色，那么那个角色对应的玩家必须选择变成一个新的角");
    g_tipLine[2836] = StringToText("  色。");
    g_tipLine[2837] = StringToText("【规则细节】");
    g_tipLine[2838] = StringToText("· 由说书人决定恶魔和爪牙在茶会中选择更换角色的先后顺序，且需要注意控制茶会的时间。");
    g_tipLine[2839] = StringToText("  如果认为同时睁眼会使得夜晚时间过长，或在容易出现善良爪牙/恶魔的剧本中导致邪恶阵营暴");
    g_tipLine[2840] = StringToText("  露，说书人也可以酌情分别独自唤醒这些玩家并执行角色变化的操作。");
    g_tipLine[2841] = StringToText("· 如果帽匠在夜晚时由于恶魔的攻击而死亡，在茶会中产生的新恶魔在当晚无法再次攻击。");
    g_tipLine[2842] = StringToText("· 相克规则：");
    g_tipLine[2843] = StringToText("· 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[2844] = StringToText("· 军团：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[2845] = StringToText("· 小怪宝：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[2846] = StringToText("· 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[2847] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[2848] = StringToText("· 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[2849] = StringToText("投毒者（爪牙）");
    g_tipLine[2850] = StringToText("【角色能力】");
    g_tipLine[2851] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipLine[2852] = StringToText("【角色简介】");
    g_tipLine[2853] = StringToText("投毒者能秘密地干扰其他角色的能力。");
    g_tipLine[2854] = StringToText("· 每个夜晚，投毒者会选择一名玩家在当晚的剩余时间和接下来的一整个白天阶段里中毒。");
    g_tipLine[2855] = StringToText("· 中毒的玩家会失去能力，但说书人会装作他仍具有能力。他的能力不会真实地影响游戏。");
    g_tipLine[2856] = StringToText("  为了保证中毒的玩家处于未中毒的幻象中，说书人会在正确的时间下唤醒他，");
    g_tipLine[2857] = StringToText("  并如同他未中毒一样走过场来执行他的能力。如果中毒玩家的角色能力能够获取信息，");
    g_tipLine[2858] = StringToText("  说书人可以给他提供错误信息。");
    g_tipLine[2859] = StringToText("· 如果一名中毒的玩家在他中毒的期间里使用了「每局游戏限一次」的能力，");
    g_tipLine[2860] = StringToText("  他无法再次使用这项能力。");
    g_tipLine[2861] = StringToText("【规则细节】");
    g_tipLine[2862] = StringToText("· 虽然投毒者的能力描述中，中毒的持续时间看似与水手和旅店老板等有所差别，");
    g_tipLine[2863] = StringToText("  但实际上这只是为了新手玩家便于理解，而不用特意引出「黄昏」这个概念。实际上，");
    g_tipLine[2864] = StringToText("  投毒者的能力描述同样可以写为：「每个夜晚，你要选择一名玩家：他会中毒到下个黄昏。」");
    g_tipLine[2865] = StringToText("教父（爪牙）");
    g_tipLine[2866] = StringToText("【角色能力】");
    g_tipLine[2867] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。如果有外来者在白天死亡，");
    g_tipLine[2868] = StringToText("  你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipLine[2869] = StringToText("【角色简介】");
    g_tipLine[2870] = StringToText("教父会在小镇杀害外来者时进行报复。");
    g_tipLine[2871] = StringToText("· 每当一名外来者死于处决，教父会在当晚选择一名玩家，使其死亡。");
    g_tipLine[2872] = StringToText("· 只有外来者在白天死去时，教父才能杀死玩家。夜晚死亡的外来者不算在内。");
    g_tipLine[2873] = StringToText("· 如果教父在场，会在场上增加或减少一个外来者。");
    g_tipLine[2874] = StringToText("· 在游戏开始时，教父会得知哪些外来者在场。");
    g_tipLine[2875] = StringToText("· 如果今天白天有两名外来者玩家死亡，当晚教父仍然只能杀死一名玩家。");
    g_tipLine[2876] = StringToText("【规则细节】");
    g_tipLine[2877] = StringToText("· 相克规则：");
    g_tipLine[2878] = StringToText("· 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2879] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[2880] = StringToText("· 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2881] = StringToText("刺客（爪牙）");
    g_tipLine[2882] = StringToText("【角色能力】");
    g_tipLine[2883] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipLine[2884] = StringToText("【角色简介】");
    g_tipLine[2885] = StringToText("刺客能杀死恶魔解决不掉的麻烦角色。");
    g_tipLine[2886] = StringToText("· 每局游戏限一次，在夜晚，刺客能杀死一名玩家。即使该玩家受到了包括角色能力在内的任何方");
    g_tipLine[2887] = StringToText("  式的保护而免于死亡，也依然会死亡。");
    g_tipLine[2888] = StringToText("· 刺客的能力如常受到醉酒和中毒的影响。");
    g_tipLine[2889] = StringToText("· 如果刺客攻击了莽夫，莽夫会死去并转变为邪恶阵营。");
    g_tipLine[2890] = StringToText("· 如果刺客攻击了尚未触发能力的僵怖（不论因为什么理由），僵怖会死去，");
    g_tipLine[2891] = StringToText("  但在死后触发能力且仍存活。");
    g_tipLine[2892] = StringToText("【规则细节】");
    g_tipLine[2893] = StringToText("无额外规则。");
    g_tipLine[2894] = StringToText("麻脸巫婆（爪牙）");
    g_tipLine[2895] = StringToText("【角色能力】");
    g_tipLine[2896] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。");
    g_tipLine[2897] = StringToText("  如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipLine[2898] = StringToText("【角色简介】");
    g_tipLine[2899] = StringToText("麻脸巫婆能将玩家变为不同的角色。");
    g_tipLine[2900] = StringToText("· 除首个夜晚以外的每个夜晚，麻脸巫婆需要选择一名玩家和一个角色，");
    g_tipLine[2901] = StringToText("  那名玩家变为她选择的角色。");
    g_tipLine[2902] = StringToText("· 她无法创造重复角色，如果那个角色已在场，则无事发生。");
    g_tipLine[2903] = StringToText("【规则细节】");
    g_tipLine[2904] = StringToText("· 说书人应该如何处理「因为麻脸巫婆创造了恶魔」而导致的死亡：");
    g_tipLine[2905] = StringToText("· 麻脸巫婆造成死亡的时间范围为当前剧本中首个能够造成死亡的恶魔行动开始前，");
    g_tipLine[2906] = StringToText("  到最后一个能够造成死亡的恶魔行动结束后。");
    g_tipLine[2907] = StringToText("· 在这个期间，说书人能够自由决定是否让某名玩家死亡，或让被恶魔攻击的某名玩家存活。");
    g_tipLine[2908] = StringToText("· 说书人在这个时间范围内，可以分别在不同的恶魔行动前或后多次执行造成或阻止死亡的效果。");
    g_tipLine[2909] = StringToText("· 一旦说书人决定杀死某个还未唤醒的恶魔，这名恶魔玩家当晚就不会被唤醒。否则，");
    g_tipLine[2910] = StringToText("  就需要唤醒这名玩家。这对于在创造出哈迪寂亚等带有特殊效果的恶魔时非常重要。");
    g_tipLine[2911] = StringToText("· 说书人只能造成更多的死亡或阻止原本要发生的死亡，其他类型的恶魔能力无法阻止，");
    g_tipLine[2912] = StringToText("  如普卡的中毒、哈迪寂亚的复活等。");
    g_tipLine[2913] = StringToText("· 不建议说书人阻止恶魔成功攻击的玩家的死亡，并再自己决定让这名玩家死亡，");
    g_tipLine[2914] = StringToText("  因为这会造成更多的混乱。恶魔攻击后无法杀死某名玩家再由说书人决定杀死，");
    g_tipLine[2915] = StringToText("  这种情况不算在内。");
    g_tipLine[2916] = StringToText("· 说书人造成的死亡视为麻脸巫婆造成，因此不会触发贤者、唱诗男孩等角色的能力，");
    g_tipLine[2917] = StringToText("  也能够成功杀死士兵（如果麻脸巫婆没有照看小怪宝的话）。");
    g_tipLine[2918] = StringToText("· 只要麻脸巫婆创造了恶魔，即使在那之后麻脸巫婆离场、失去能力或死亡，");
    g_tipLine[2919] = StringToText("  当晚说书人仍然可以决定造成或阻止死亡。");
    g_tipLine[2920] = StringToText("· 说书人只能阻止恶魔造成的死亡，由非恶魔玩家造成的死亡无法阻止。");
    g_tipLine[2921] = StringToText("· 相克规则：");
    g_tipLine[2922] = StringToText("· 村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，");
    g_tipLine[2923] = StringToText("  村夫的醉酒效果可能会更换目标。");
    g_tipLine[2924] = StringToText("· 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2925] = StringToText("· 落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[2926] = StringToText("· 异教领袖/政客/莽夫/食人魔：被麻脸巫婆创造的邪恶异教领袖/政客/莽夫/食人魔无法因");
    g_tipLine[2927] = StringToText("  为自身能力转变为善良阵营。");
    g_tipLine[2928] = StringToText("· 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[2929] = StringToText("· 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[2930] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[2931] = StringToText("· 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2932] = StringToText("· 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[2933] = StringToText("· 戏子（改）：麻脸巫婆无法创造戏子（改），麻脸巫婆创造的邪恶玩家无法获得戏子（改）");
    g_tipLine[2934] = StringToText("  的能力。");
    g_tipLine[2935] = StringToText("寡妇（爪牙）");
    g_tipLine[2936] = StringToText("【角色能力】");
    g_tipLine[2937] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，");
    g_tipLine[2938] = StringToText("  始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[2939] = StringToText("【角色简介】");
    g_tipLine[2940] = StringToText("寡妇查看魔典并毒害一名她选择的玩家。");
    g_tipLine[2941] = StringToText("· 寡妇仅在她的首个夜晚行动并使一名玩家中毒。");
    g_tipLine[2942] = StringToText("· 因寡妇中毒的玩家会一直保持中毒直到寡妇死亡。");
    g_tipLine[2943] = StringToText("· 在寡妇行动的那个夜晚，会有一名善良玩家知道寡妇在场，他不会得知谁是寡妇，");
    g_tipLine[2944] = StringToText("  也不会得知谁中毒了。");
    g_tipLine[2945] = StringToText("【规则细节】");
    g_tipLine[2946] = StringToText("· 相克规则：");
    g_tipLine[2947] = StringToText("· 魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_tipLine[2948] = StringToText("· 罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[2949] = StringToText("· 炼金术士：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。");
    g_tipLine[2950] = StringToText("  每次处决后，存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，");
    g_tipLine[2951] = StringToText("  恶魔当晚必须选择寡妇。");
    g_tipLine[2952] = StringToText("· 落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[2953] = StringToText("· 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2954] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[2955] = StringToText("· 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2956] = StringToText("· 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[2957] = StringToText("珀（恶魔）");
    g_tipLine[2958] = StringToText("【角色能力】");
    g_tipLine[2959] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。如果你上次选择时没有选择任何玩家，");
    g_tipLine[2960] = StringToText("  当晚你要选择三名玩家：他们死亡。");
    g_tipLine[2961] = StringToText("【角色简介】");
    g_tipLine[2962] = StringToText("珀能选择在夜晚不发起攻击，但会在下一夜疯狂杀戮。");
    g_tipLine[2963] = StringToText("· 如同其他的恶魔，珀可以在每晚攻击一名玩家。然而，如果珀不选择任何人，");
    g_tipLine[2964] = StringToText("  那么在下个夜晚珀可以攻击三名玩家。");
    g_tipLine[2965] = StringToText("· 如果珀在上一个夜晚不选择任何人时处于醉酒或中毒，当晚珀仍然能够选择三名玩家。");
    g_tipLine[2966] = StringToText("· 当要求珀选择三名玩家时，他必须要选择。珀不能再次不选择任何人。");
    g_tipLine[2967] = StringToText("· 只有当珀不选择任何人，才能得到三次攻击的机会。如果珀在上一次进行选择时攻击了某人但该");
    g_tipLine[2968] = StringToText("  玩家没有死亡，珀也不会获得三次攻击的机会。");
    g_tipLine[2969] = StringToText("· 珀在首个夜晚不行动，但这不算作珀「没有选择」。");
    g_tipLine[2970] = StringToText("· 如果驱魔人选择了珀，珀不会行动，但是这并不算作珀「没有选择任何人」。然而，");
    g_tipLine[2971] = StringToText("  如果珀在驱魔人选择他的前一夜就没有选择任何人，那么在驱魔人选择珀的下一夜，");
    g_tipLine[2972] = StringToText("  珀能够选择三名玩家，因为珀在上一次选择时没有选择任何人。");
    g_tipLine[2973] = StringToText("【规则细节】");
    g_tipLine[2974] = StringToText("无额外规则。");
    g_tipLine[2975] = StringToText("亡骨魔（恶魔）");
    g_tipLine[2976] = StringToText("【角色能力】");
    g_tipLine[2977] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被你杀死的爪牙保留他的能力，");
    g_tipLine[2978] = StringToText("  且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipLine[2979] = StringToText("【角色简介】");
    g_tipLine[2980] = StringToText("亡骨魔每当杀死自己的爪牙时，会使爪牙保留能力。");
    g_tipLine[2981] = StringToText("· 每当亡骨魔杀死一名爪牙时，虽然爪牙会死亡，但只要亡骨魔还存活，该爪牙就能保留能力，");
    g_tipLine[2982] = StringToText("  且仍能在夜晚行动。");
    g_tipLine[2983] = StringToText("· 类似于诺-达鲺，那个被亡骨魔杀死的爪牙顺时针或逆时针方向最近的镇民玩家会中毒，");
    g_tipLine[2984] = StringToText("  即使该镇民已经死亡。如果亡骨魔死亡或失去能力，受亡骨魔影响的中毒玩家恢复健康。");
    g_tipLine[2985] = StringToText("  亡骨魔在杀死爪牙时总是会使一名镇民玩家中毒，在说书人选择中毒玩家时会跳过与爪牙相邻的");
    g_tipLine[2986] = StringToText("  非镇民角色。由说书人选择该爪牙哪一侧的镇民中毒。");
    g_tipLine[2987] = StringToText("· 不仅是最后一个被亡骨魔杀死的爪牙，所有被亡骨魔杀死的爪牙都会保留能力并使一名镇民中毒。");
    g_tipLine[2988] = StringToText("· 如果死亡的爪牙变成非爪牙角色，便不再使相应的镇民中毒，且不再保留能力。");
    g_tipLine[2989] = StringToText("  如果死亡的爪牙醉酒或中毒，也会失去能力直到再次恢复清醒和健康。");
    g_tipLine[2990] = StringToText("【规则细节】");
    g_tipLine[2991] = StringToText("· 相克规则：");
    g_tipLine[2992] = StringToText("· 主谋：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipLine[2993] = StringToText("利维坦（恶魔）");
    g_tipLine[2994] = StringToText("【角色能力】");
    g_tipLine[2995] = StringToText("如果多于一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家被处决，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。所有玩家都知道") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("在场。");
    g_tipLine[2996] = StringToText("在第五个白天结束时，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[2997] = StringToText("【角色简介】");
    g_tipLine[2998] = StringToText("利维坦不进行任何杀戮。");
    g_tipLine[2999] = StringToText("· 所有玩家都会知道利维坦在场，即使利维坦在游戏过程中被创造也是如此。");
    g_tipLine[3000] = StringToText("· 可以有任意数量的邪恶玩家被处决，然而如果有多于一名善良玩家被处决，邪恶阵营获胜。");
    g_tipLine[3001] = StringToText("  被处决的角色是什么无关紧要，只看那名玩家在被处决的时候的阵营是什么。");
    g_tipLine[3002] = StringToText("· 利维坦会根据当前游戏天数获得第一至第五天提示；超过第五天时按第五天计算。");
    g_tipLine[3003] = StringToText("· 不论何种类型的处决均会计算在内，即使处决没有让玩家死亡也会正常计算。被贞洁者处决，");
    g_tipLine[3004] = StringToText("  或者畸形秀演员自爆处决，都会计算在内。善良玩家被处决但因为和平主义者的能力仍然存活也");
    g_tipLine[3005] = StringToText("  会计算在内。");
    g_tipLine[3006] = StringToText("【规则细节】");
    g_tipLine[3007] = StringToText("· 第五天提示按游戏总天数计算，不是按利维坦个人的行动次数计算。");
    g_tipLine[3008] = StringToText("  所以第五天之后出现的利维坦也会拿到第五天提示，并在进入夜晚、之后的白天或恢复能力时结算。");
    g_tipLine[3009] = StringToText("· 如果你选择每天播报利维坦在场的第几天，一旦利维坦醉酒/中毒，");
    g_tipLine[3010] = StringToText("  那么在当天不能宣布利维坦在场。当利维坦恢复清醒/健康时，");
    g_tipLine[3011] = StringToText("  可以再次宣布利维坦在场（如果还没有宣布过，则必须宣布）。");
    g_tipLine[3012] = StringToText("· 当利维坦中毒/醉酒时，处决不会计入利维坦获胜条件。第五天提示不会消失；");
    g_tipLine[3013] = StringToText("  但只有利维坦清醒、健康且存活时，进入夜晚、第五天之后的白天或恢复能力才会立即结算胜利。");
    g_tipLine[3014] = StringToText("  中毒/醉酒期间不会获胜；恢复健康后会立刻结算。");
    g_tipLine[3015] = StringToText("· 同一名善良玩家被处决多次只会计入一次利维坦的获胜条件。");
    g_tipLine[3016] = StringToText("· 相克规则：");
    g_tipLine[3017] = StringToText("· 士兵：如果利维坦提名并处决了士兵，善良阵营获胜。");
    g_tipLine[3018] = StringToText("· 僧侣：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_tipLine[3019] = StringToText("· 旅店老板：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[3020] = StringToText("· 守鸦人：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3021] = StringToText("  如果守鸦人被选择，他的能力生效但不会死亡。（建议在利维坦选择农夫/守鸦人/贤者并触发");
    g_tipLine[3022] = StringToText("  这些角色的能力后，这些角色失去能力）");
    g_tipLine[3023] = StringToText("· 贤者：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3024] = StringToText("  如果贤者被选择，他的能力生效但不会死亡。");
    g_tipLine[3025] = StringToText("· 农夫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3026] = StringToText("  如果农夫被选择，他的能力生效但不会死亡。");
    g_tipLine[3027] = StringToText("· 镇长：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。");
    g_tipLine[3028] = StringToText("· 报丧女妖：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3029] = StringToText("  如果报丧女妖被选择，他死亡并能力生效。");
    g_tipLine[3030] = StringToText("· 驱魔人：如果利维坦提名并处决了驱魔人上个夜晚选择的那名玩家，善良阵营获胜。");
    g_tipLine[3031] = StringToText("· 祖母：如果利维坦在场，孙子死于处决，邪恶阵营获胜。");
    g_tipLine[3032] = StringToText("· 国王：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[3033] = StringToText("· 帽匠：利维坦不能在第五天之后加入游戏。");
    g_tipLine[3034] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3035] = StringToText("· 戏子：在戏子存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[3036] = StringToText("  说书人会在当晚杀死这名玩家。");
    g_tipLine[3037] = StringToText("· 和尚：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[3038] = StringToText("· 打更人：如果利维坦提名并处决了打更人上个夜晚猜测的其中一名玩家，善良阵营获胜。");
    g_tipLine[3039] = StringToText("· 戏子（改）：在戏子（改）存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「");
    g_tipLine[3040] = StringToText("  想要死亡」。说书人会在当晚杀死这名玩家。");
    g_tipLine[3041] = StringToText("· 狸猫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3042] = StringToText("  如果「太子」被选择，他会与狸猫交换角色但不会死亡。");
    g_tipLine[3043] = StringToText("· 巡察：如果利维坦提名并处决了巡察上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[3044] = StringToText("· 麻脸巫婆与帽匠：第五个白天之后不能加入利维坦。");
    g_tipLine[3045] = StringToText("【角色能力】");
    g_tipLine[3046] = StringToText("这个剧本包含有自制角色或自制规则。");
    g_tipLine[3047] = StringToText("【角色简介】");
    g_tipLine[3048] = StringToText("私货商人允许说书人使用自己或他人创造的非官方角色，或使用非标准规则。");
    // 【角色能力表】专用：每个角色的「能力」整段（由 patch205 从上面的 g_tipLine 自动拼出来）

    //   能力多的角色（教父 3 行、多数 2 行）拼成一整段后交给标签自动折行，就不会只显示第一行了
    g_tipAbility[0] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色。");
    g_tipAbility[1] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场）。");
    g_tipAbility[2] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场）。");
    g_tipAbility[3] = StringToText("在你的首个夜晚，你会得知场上邻座的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家有多少对。");
    g_tipAbility[4] = StringToText("每个夜晚，你会得知与你邻近的两名存活的玩家中") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的数量。");
    g_tipAbility[5] = StringToText("每个夜晚，你要选择两名玩家：你会得知他们之中是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。 会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被你的能力当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipAbility[6] = StringToText("每个夜晚*，你会得知今天白天死于处决的玩家的角色。");
    g_tipAbility[7] = StringToText("每个夜晚*，你要选择除你以外的一名玩家：当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对他无效。");
    g_tipAbility[8] = StringToText("如果你在夜晚死亡，你会被唤醒，然后你要选择一名玩家：你会得知他的角色。");
    g_tipAbility[9] = StringToText("当你首次被提名时，如果提名你的玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他立刻被处决。");
    g_tipAbility[10] = StringToText("每局游戏限一次，你可以在白天时公开选择一名玩家：如果他是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他死亡。");
    g_tipAbility[11] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对你无效。");
    g_tipAbility[12] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。 如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipAbility[13] = StringToText("每个夜晚，你要选择除你以外的一名玩家：明天白天，只有他投票时你才能投票。");
    g_tipAbility[14] = StringToText("你不知道你是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("。你以为你是一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，但其实你不是。");
    g_tipAbility[15] = StringToText("你可能会被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色，即使你已死亡。");
    g_tipAbility[16] = StringToText("如果你死于处决，你的阵营落败。");
    g_tipAbility[17] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipAbility[18] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营、") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，即使你已死亡。");
    g_tipAbility[19] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("死亡，你变成那个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipAbility[20] = StringToText("会有额外的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场。[+2 ") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipAbility[21] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会变成") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipAbility[22] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家和他的角色。") + StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("杀死了他，你也会死亡。");
    g_tipAbility[23] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到下个黄昏。") + StringToText("你不会死亡。");
    g_tipAbility[24] = StringToText("每个夜晚，你要选择除你以外的两名存活的玩家：你会得知他们中有几人在当晚因其自") + StringToText("身能力而被唤醒。");
    g_tipAbility[25] = StringToText("每个夜晚*，你要选择一名玩家（与上个夜晚不同）：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，他会得知你") + StringToText("是") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("，但他当晚不会因其自身能力而被唤醒。");
    g_tipAbility[26] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("到下个黄昏。");
    g_tipAbility[27] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipAbility[28] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipAbility[29] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个角色：如果该角色在场，该角色之一从当") + StringToText("晚开始") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("三天三夜。");
    g_tipAbility[30] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名死亡的玩家：如果他是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，你会将他") + StringToText("起死回生。");
    g_tipAbility[31] = StringToText("当一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("死于处决时，除了你和旅行者以外的所有其他玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到明天黄昏。");
    g_tipAbility[32] = StringToText("如果与你邻近的两名存活的玩家是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，他们不会死亡。");
    g_tipAbility[33] = StringToText("被处决的") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家可能不会死亡。");
    g_tipAbility[34] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipAbility[35] = StringToText("你随时可能死亡。");
    g_tipAbility[36] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，在当晚他会死亡") + StringToText("。");
    g_tipAbility[37] = StringToText("每个夜晚，首个使用其自身能力选择了你的玩家会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到下个黄昏。你会转变为他的") + StringToText("阵营。");
    g_tipAbility[38] = StringToText("你以为你是一个") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，但其实你不是。") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("知道你是") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("以及你在每个夜晚选择了哪些玩家。");
    g_tipAbility[39] = StringToText("在你的首个夜晚，你会得知有哪些") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("角色在场。") + StringToText("如果有") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1") + StringToText("或+1") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("]");
    g_tipAbility[40] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他") + StringToText("不会死亡。");
    g_tipAbility[41] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他") + StringToText("不会死亡。");
    g_tipAbility[42] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那") + StringToText("个白天如果有玩家被处决，他的阵营落败。");
    g_tipAbility[43] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。") + StringToText("当你首次死亡后，你仍存活，但会被当作死亡。");
    g_tipAbility[44] = StringToText("每个夜晚，你要选择一名玩家：他") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。") + StringToText("上个因你的能力") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的玩家会死亡并恢复健康。");
    g_tipAbility[45] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。") + StringToText("你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipAbility[46] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。") + StringToText("如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");


    // ---- 【说书人提示】只给玩家1 看（他是主持人，没有自己的角色）----
    //   【】里的界面名用亮黄，角色名用跟别处同一套颜色
    // ---- 梦殒春宵（板子 3）：角色能力表里那一行能力（纯文本，颜色由 BOTC_KeyColor 自动加）----
    g_tipAbility[47] = StringToText("在你的首个夜晚，你会得知恶魔与爪牙之间最近的距离。（邻座的玩家距离为1）");
    g_tipAbility[48] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个善良角色和一个邪恶角色，该玩家是其中一个角色。");
    g_tipAbility[49] = StringToText("每个夜晚，你要选择一名存活的玩家：如果你选中了恶魔，你和他交换角色和阵营，然后他中毒。");
    g_tipAbility[50] = StringToText("每个夜晚，你会得知有多少名玩家的能力因为其他角色的能力而未正常生效。（从上个黎明到你被唤醒时）");
    g_tipAbility[51] = StringToText("每个夜晚*，你会得知在今天白天时是否有恶魔投过票。");
    g_tipAbility[52] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipAbility[53] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是邪恶的。");
    g_tipAbility[54] = StringToText("每个白天，你可以私下询问说书人以得知两条信息：一个是正确的，一个是错误的。");
    g_tipAbility[55] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipAbility[56] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个善良角色：你获得该角色的能力。如果这个角色在场，他醉酒。");
    g_tipAbility[57] = StringToText("每局游戏限一次，在白天时，你可以私下询问说书人一个是非问题，你会得知该问题的答案。");
    g_tipAbility[58] = StringToText("在你的首个白天，你可以公开猜测任意玩家的角色最多五次。在当晚，你会得知猜测正确的角色数量。");
    g_tipAbility[59] = StringToText("如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。");
    g_tipAbility[60] = StringToText("如果你「疯狂」地证明自己是外来者，你可能被处决。");
    g_tipAbility[61] = StringToText("当你死亡时，会有一名玩家开始醉酒。");
    g_tipAbility[62] = StringToText("如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。");
    g_tipAbility[63] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。");
    g_tipAbility[64] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。如果其中善良玩家被处决，邪恶阵营获胜。如果你们都存活，善良阵营无法获胜。");
    g_tipAbility[65] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipAbility[66] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipAbility[67] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipAbility[68] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipAbility[69] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipAbility[70] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。与你邻近的两名镇民中毒。");
    g_tipAbility[71] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。镇民玩家的能力都会产生错误信息。如果白天没人被处决，邪恶阵营获胜。");
    g_tipAbility[72] = StringToText("每个夜晚，你会得知一名与上个夜晚得知的玩家角色类型不同的玩家。[+0~1外来者]");
    g_tipAbility[73] = StringToText("你不知道你的能力是什么。每个白天你可以找说书人猜测一次，你会得知你的猜测有多准确。");
    g_tipAbility[74] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipAbility[75] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipAbility[76] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipAbility[77] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名存活的玩家：如果你选中了落难少女，她会变成一个不在场的镇民角色。[+落难少女]");
    g_tipAbility[78] = StringToText("每局游戏限一次，在夜晚时，你可以选择让恶魔变成你选择的恶魔角色，或让所有爪牙变成你选择的爪牙角色。");
    g_tipAbility[79] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipAbility[80] = StringToText("当你在夜晚死亡时，一名存活的善良玩家会变成农夫。");
    g_tipAbility[81] = StringToText("每局游戏你只能发起提名一次。当你发起提名时，如果被你提名的玩家不是恶魔，他死亡。");
    g_tipAbility[82] = StringToText("所有爪牙都知道落难少女在场。每局游戏限一次，任意爪牙可以公开猜测你是落难少女，如果猜对，你的阵营落败。");
    g_tipAbility[83] = StringToText("说书人可以打破游戏规则，如果说书人被处决，善良阵营获胜，即使你已死亡。[无邪恶角色在场]");
    g_tipAbility[84] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipAbility[95] = StringToText("你拥有一个爪牙角色的能力。当你使用能力时，说书人可能会要求你更换选择。");
    g_tipAbility[96] = StringToText("每个夜晚，你会得知说书人认为哪个阵营更有优势（善良 / 邪恶 / 均势）。");
    g_tipAbility[97] = StringToText("如果你是对你的阵营落败最负责任的人，你转变阵营并获胜，即使你已死亡。");
    g_tipAbility[98] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipAbility[99] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipAbility[100] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活玩家：他中毒，只有他死亡时你才会一同死亡。");
    g_tipAbility[101] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipAbility[102] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，所有玩家都会得知你选择了新的玩家。");
    g_tipAbility[103] = StringToText("每个夜晚，你要选择一名玩家：如果你选中了") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，他会得知被传教士选中。所有被你选中的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("失去能力。");
    g_tipAbility[104] = StringToText("每个夜晚，如果死亡的玩家数量大于或等于存活的玩家数量，你会得知一个存活的角色。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("知道你是国王。");
    g_tipAbility[105] = StringToText("每个夜晚，你要选择一名玩家：你会得知他的阵营。[+0~2村夫，复数村夫中有一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("]");
    g_tipAbility[106] = StringToText("每个夜晚，你会转变为与你邻近的一名存活的玩家的阵营。每个白天，你可以提议所有玩家加入你的教派，如果所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家同意加入，你的阵营获胜。");
    g_tipAbility[107] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，他死亡，并且当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会造成死亡。会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipAbility[108] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了国王，你会得知哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。[+国王]");
    g_tipAbility[109] = StringToText("一名玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使你已死亡。每局游戏限一次，你可以猜测谁是那个") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家，如果猜对了，你会得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但如果猜错了，你会得知错误的「谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("」信息。");
    g_tipAbility[110] = StringToText("如果有大于等于五名玩家存活，你必须在所有提名中投票。");
    g_tipAbility[111] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色全部邻座，你靠近正中，+1") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，-或+任意数量") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipAbility[112] = StringToText("每个夜晚，所有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("要秘密决定由哪名玩家来照看小怪宝并且「是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("」。每个夜晚*，可能会有一名玩家死亡。[+1") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("]");
    g_tipAbility[113] = StringToText("游戏开始时，你要宣布一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色。如果该角色在场，他只能死于处决，但所有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家会在首个夜晚得知他是哪一名玩家。");
    g_tipAbility[85] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipAbility[86] = StringToText("爪牙和恶魔互相不认识。如果你死亡，当晚他们会互相认识。");
    g_tipAbility[87] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，然后如果他们都存活则都死亡。");
    g_tipAbility[88] = StringToText("在初始设置时，可能会额外增加或减少一个外来者。");
    g_tipAbility[89] = StringToText("游戏过程中邪恶玩家的总数最多能比初始设置多一名。");
    g_tipAbility[90] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。每当你得知的玩家死亡，你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipAbility[91] = StringToText("在你的首个夜晚，你会得知一个在场的镇民角色。如果你「疯狂」地证明你是该角色，当他死亡时你获得该角色的能力。");
    g_tipAbility[92] = StringToText("爪牙会在其首个夜晚得知三个伪装。");
    g_tipAbility[93] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipAbility[94] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。[多数玩家为军团]");
    // ---- 【风雅集（板子 10）】8 个新角色的能力整段（用户 2026-10-16）----
    g_tipAbility[114] = StringToText("在你的首个夜晚，你会得知距离最近的邪恶玩家位于你的顺时针还是逆时针方向。如果两侧的邪恶玩家与你距离相等，你得知的信息由说书人决定。");
    g_tipAbility[115] = StringToText("在你的首个夜晚，你会得知两名善良玩家。他们之中会有一人醉酒，即使你已死亡。");
    g_tipAbility[116] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipAbility[117] = StringToText("每个白天，如果你「疯狂」地证明自己是一个善良角色（与之前不同），你可能会在当晚获得那个角色的能力，直到下个黄昏。");
    g_tipAbility[118] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，你会立即变成一个不在场的镇民角色。");
    g_tipAbility[119] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为邪恶；如果你先死于处决，他会在当晚转变为邪恶。");
    g_tipAbility[120] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipAbility[121] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    // ---- 【赎罪小镇（板子 11）】新角色帮助文本与能力整段 ----
    g_tipLine[2400] = StringToText("【能力】在你的首个夜晚，你会得知两名非恶魔玩家。");
    g_tipLine[2401] = StringToText("【提示】两名玩家都必须不是恶魔；可以包含你自己。");
    g_tipLine[2402] = StringToText("【提示】中毒或醉酒时，说书人可以给错误信息。");
    g_tipLine[2403] = StringToText("【能力】每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    g_tipLine[2404] = StringToText("【提示】选中非恶魔时道士存活；选中恶魔时先结算道士死亡，再让恶魔醉酒。");
    g_tipLine[2405] = StringToText("【提示】道士中毒或醉酒时，这次能力失效。");
    g_tipLine[2406] = StringToText("【能力】每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他醉酒并死亡。");
    g_tipLine[2407] = StringToText("【提示】第二夜起才能使用；本卡面写的是醉酒并死亡。");
    g_tipLine[2408] = StringToText("【提示】选择不在场的镇民角色时，只消耗本局唯一一次机会。");
    g_tipLine[2409] = StringToText("【能力】每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[2410] = StringToText("【提示】由说书人根据场上局势选择一名玩家；不是你自己选择目标。");
    g_tipLine[2411] = StringToText("【提示】中毒或醉酒时，说书人可以给出错误信息。");
    g_tipLine[2412] = StringToText("【能力】与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1 外来者]");
    g_tipLine[2413] = StringToText("【设置】赶尸人在场时，外来者数量 -1、镇民数量 +1。");
    g_tipLine[2414] = StringToText("【提示】相邻镇民首次死亡进入活尸状态，不公开死亡；再次死亡才真正离场。");
    g_tipLine[2415] = StringToText("【能力】如果多于一名善良玩家被处决，邪恶阵营获胜。所有玩家都知道利维坦在场。持有第五天提示时，进入夜晚、第五天之后的白天或恢复能力时能力生效则邪恶阵营获胜。");
    g_tipLine[2416] = StringToText("【提示】利维坦不在夜晚杀人，但被处决的善良玩家会照常计算。");
    g_tipLine[2417] = StringToText("【提示】中途创造时按当前游戏天数打第一至第五天提示；进入下一个白天时再公开其在场。");
    g_tipLine[2418] = StringToText("【能力】每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipLine[2419] = StringToText("【提示】只说你的身份是守夜人，不提供额外信息。");
    g_tipLine[2420] = StringToText("【提示】用过一次后不能再使用；复活时恢复一次机会。");
    g_tipLine[2421] = StringToText("【能力】每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipLine[2422] = StringToText("【提示】检查的是目标是否醉酒或中毒，不是杂技演员自己。");
    g_tipLine[2423] = StringToText("【提示】第 2 夜起才能发动。");
    // 能力整段（角色能力表）
    g_tipAbility[122] = StringToText("在你的首个夜晚，你会得知两名非恶魔玩家。");
    g_tipAbility[123] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    g_tipAbility[124] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他醉酒并死亡。");
    g_tipAbility[125] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipAbility[128] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipAbility[129] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipAbility[130] = StringToText("这个剧本包含有自制角色或自制规则。");
    g_tipAbility[131] = StringToText("如果恶魔杀死了你，所有玩家都会得知此事。从现在开始，你每天可以发起两次提名，每次投票时可以投两票。");
    g_tipLine[3100] = StringToText("【角色能力】");
    g_tipLine[3101] = StringToText("如果恶魔杀死了你，所有玩家都会得知此事。从现在开始，你每天可以发起两次提名，");
    g_tipLine[3102] = StringToText("  每次投票时可以投两票。");
    g_tipLine[3103] = StringToText("【角色简介】");
    g_tipLine[3104] = StringToText("报丧女妖在死亡后获得力量，提名和投票次数变为原本的两倍。");
    g_tipLine[3105] = StringToText("· 报丧女妖在存活时，如常进行提名和投票。");
    g_tipLine[3106] = StringToText("· 如果恶魔杀死了报丧女妖，她每天可以发起两次提名，即使通常情况下来说已死亡的玩");
    g_tipLine[3107] = StringToText("  家无法发起提名。");
    g_tipLine[3108] = StringToText("· 如果恶魔杀死了报丧女妖，她可以自由地在提名中投票，无需消耗投票标记。她可以在");
    g_tipLine[3109] = StringToText("  同一次提名中投两票。");
    g_tipLine[3110] = StringToText("· 报丧女妖死亡后的能力只会在被恶魔杀死之后获得。死于处决或是死于非恶魔的能力不");
    g_tipLine[3111] = StringToText("  会让她获得这些能力。");
    g_tipLine[3112] = StringToText("· 如果要在一次提名中投出两票，报丧女妖需要在计票时同时举起两只手。如果玩家因为");
    g_tipLine[3113] = StringToText("  某些生理障碍无法做到这样的行为，说书人可以默认将他的常规票数翻倍。");
    g_tipLine[3114] = StringToText("【规则细节】");
    g_tipLine[3115] = StringToText("· 如果报丧女妖在获得死亡能力时清醒健康，但在随后醉酒中毒，她无法发起提名，且投");
    g_tipLine[3116] = StringToText("  票需要消耗投票标记。");
    g_tipLine[3117] = StringToText("· 特定角色互动：");
    g_tipLine[3118] = StringToText("· 官员：官员会让报丧女妖的每一票都算作三票。");
    g_tipLine[3119] = StringToText("· 窃贼：窃贼会让报丧女妖的每一票都算作负票。与官员效果结合后，每一票都算作负三");
    g_tipLine[3120] = StringToText("  票。");
    g_tipLine[3121] = StringToText("· 相克规则：");
    g_tipLine[3122] = StringToText("· 利维坦：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[3123] = StringToText("  如果报丧女妖被选择，他死亡并能力生效。");
    g_tipLine[3124] = StringToText("· 暴乱：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果");
    g_tipLine[3125] = StringToText("  报丧女妖被选择，他死亡并能力生效。");
    g_tipLine[3126] = StringToText("· 涡流：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的「通用简");
    g_tipLine[3127] = StringToText("  化原则」已涵盖包括多角色互动下的涡流信息的简化处理方式，此条仅作说明。）");
    g_tipLine[3128] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3129] = StringToText("· 狸猫：如果狸猫与报丧女妖交换角色，不会触发报丧女妖的能力。");
    g_tipRoleAt[131] = 6135; g_tipRoleN[131] = 28;
    g_tipAbility[132] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipLine[3130] = StringToText("【角色能力】");
    g_tipLine[3131] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什");
    g_tipLine[3132] = StringToText("  么能力。");
    g_tipLine[3133] = StringToText("【角色简介】");
    g_tipLine[3134] = StringToText("科学怪人能够复制善良角色的能力。");
    g_tipLine[3135] = StringToText("· 只要科学怪人存活且清醒健康，恶魔就会拥有一个不在场的镇民或外来者角色的能力。");
    g_tipLine[3136] = StringToText("· 如果恶魔醉酒中毒，恶魔仍然保留自己获得的这个善良角色的能力。然而如果科学怪人");
    g_tipLine[3137] = StringToText("  醉酒中毒，恶魔就会暂时失去这个善良角色的能力。");
    g_tipLine[3138] = StringToText("· 如果恶魔拥有的能力是死亡后触发或保留的能力，且恶魔死亡，那么恶魔会保留获得的");
    g_tipLine[3139] = StringToText("  这项能力，例如心上人。");
    g_tipLine[3140] = StringToText("· 如果有新恶魔被创造，例如红唇女郎或理发师，那么新恶魔也能从科学怪人处获得能力。");
    g_tipLine[3141] = StringToText("  新恶魔获得的能力可以与旧恶魔获得的能力不同。");
    g_tipLine[3142] = StringToText("· 如果有多名恶魔同时在场且存活，只会有其中一名存活恶魔能够从科学怪人处获得能力。");
    g_tipLine[3143] = StringToText("· 如果在游戏设置时恶魔因此获得的能力能够影响初始设置，例如唱诗男孩，那么就会对");
    g_tipLine[3144] = StringToText("  游戏设置产生影响。");
    g_tipLine[3145] = StringToText("· 获得善良角色能力的恶魔与科学怪人都能得知恶魔获得了哪个角色的能力。说书人可以");
    g_tipLine[3146] = StringToText("  分别或同时唤醒这两名玩家通知他们相关信息。");
    g_tipLine[3147] = StringToText("· 恶魔因此获得的不在场角色能力可以来自于恶魔的伪装之一。");
    g_tipLine[3148] = StringToText("· 在夜晚时，恶魔会额外在这个善良角色被唤醒的时机下被唤醒。");
    g_tipLine[3149] = StringToText("【规则细节】");
    g_tipLine[3150] = StringToText("· 如果科学怪人让恶魔拥有「能够让自己醉酒中毒」的能力（比如水手、食人族等），当");
    g_tipLine[3151] = StringToText("  这些能力导致自身醉酒或中毒时，仅影响恶魔因科学怪人拥有的能力，不会影响恶");
    g_tipLine[3152] = StringToText("  魔玩家原本的能力。");
    g_tipLine[3153] = StringToText("· 相克规则：");
    g_tipLine[3154] = StringToText("· 异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[3155] = StringToText("· 莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[3156] = StringToText("· 异端分子：恶魔无法拥有异端分子的能力。");
    g_tipLine[3157] = StringToText("· 食人魔：恶魔无法拥有食人魔的能力。");
    g_tipLine[3158] = StringToText("· 政客：恶魔无法拥有政客的能力。");
    g_tipLine[3159] = StringToText("· 酒鬼：恶魔不能获得酒鬼的能力。");
    g_tipLine[3160] = StringToText("· 炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个");
    g_tipLine[3161] = StringToText("  角色的能力。");
    g_tipLine[3162] = StringToText("· 村夫：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[3163] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3164] = StringToText("· 悟道者：恶魔无法拥有悟道者的能力。");
    g_tipLine[3165] = StringToText("· 狸猫：如果因科学怪人获得狸猫能力的恶魔与「太子」交换角色，改为「太子」变成狸");
    g_tipLine[3166] = StringToText("  猫且恶魔获得「太子」原本角色的能力。");
    g_tipRoleAt[132] = 3130; g_tipRoleN[132] = 37;
    g_tipAbility[133] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可能会有一名玩家在这之后死亡。");
    g_tipLine[3167] = StringToText("【角色能力】");
    g_tipLine[3168] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可");
    g_tipLine[3169] = StringToText("  能会有一名玩家在这之后死亡。");
    g_tipLine[3170] = StringToText("【角色简介】");
    g_tipLine[3171] = StringToText("牙噶巴卜通过言语杀人。");
    g_tipLine[3172] = StringToText("· 说书人提供给牙噶巴卜的短语可以是任意长度，但建议是2到5个字左右。");
    g_tipLine[3173] = StringToText("· 如果牙噶巴卜说出了这段短语，说书人便可以在这之后，在下个黎明前的任意时机杀死");
    g_tipLine[3174] = StringToText("  一名玩家。");
    g_tipLine[3175] = StringToText("· 牙噶巴卜无论是通过单独说出这段短语，或将它混杂在整句话里说出，都可以触发效果。");
    g_tipLine[3176] = StringToText("· 牙噶巴卜可以在同一天多次说出这段短语。说书人可以因此杀死多名玩家。");
    g_tipLine[3177] = StringToText("· 由说书人来决定牙噶巴卜的能力会让哪名玩家死亡。");
    g_tipLine[3178] = StringToText("· 说书人可以选择只杀死少于牙噶巴卜说出短语的次数这一数量的玩家。");
    g_tipLine[3179] = StringToText("· 在牙噶巴卜醉酒或中毒期间，玩家不会因为他的能力死亡，即使牙噶巴卜在说出短语时");
    g_tipLine[3180] = StringToText("  清醒健康。在牙噶巴卜清醒健康期间，玩家会因为他的能力死亡，即使在牙噶巴卜");
    g_tipLine[3181] = StringToText("  在说出短语时醉酒或中毒。");
    g_tipLine[3182] = StringToText("· 只有极少数情况下，牙噶巴卜的能力才会让玩家在白天死亡。");
    g_tipLine[3183] = StringToText("【规则细节】");
    g_tipLine[3184] = StringToText("提示标记：");
    g_tipLine[3185] = StringToText("· 死亡");
    g_tipLine[3186] = StringToText("放置时机：在牙噶巴卜说出他的秘密短语时。");
    g_tipLine[3187] = StringToText("放置条件：不论牙噶巴卜是否醉酒中毒，都会将一枚标记放入魔典正中央。");
    g_tipLine[3188] = StringToText("移动时机：在放置了标记之后，到下个黎明之前的任意时机，如果牙噶巴卜清醒健康，");
    g_tipLine[3189] = StringToText("  将这个标记移除或移动到任意一名存活玩家旁（如果该玩家能够被杀死）。");
    g_tipLine[3190] = StringToText("移除时机：在放置标记的当天白天说书人决定使用牙噶巴卜的能力杀死一名玩家时，或");
    g_tipLine[3191] = StringToText("  在黎明时说书人宣布死亡玩家后，或牙噶巴卜死亡或离场时。");
    g_tipLine[3192] = StringToText("· 相克规则：");
    g_tipLine[3193] = StringToText("· 驱魔人：如果驱魔人选中了牙噶巴卜，那么牙噶巴卜在当晚无法造成死亡。");
    g_tipLine[3194] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3195] = StringToText("· 戏子：在戏子存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想");
    g_tipLine[3196] = StringToText("  要死亡」。不论他是否说过秘密短语，说书人都会在当晚杀死这名玩家。");
    g_tipLine[3197] = StringToText("· 戏子（改）：在戏子（改）存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人");
    g_tipLine[3198] = StringToText("  示意自己「想要死亡」。不论他是否说过秘密短语，说书人都会在当晚杀死这名玩");
    g_tipLine[3199] = StringToText("  家。");
    g_tipRoleAt[133] = 3167; g_tipRoleN[133] = 33;
    g_tipAbility[134] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会被你杀死。");
    g_tipLine[3200] = StringToText("【角色能力】");
    g_tipLine[3201] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会");
    g_tipLine[3202] = StringToText("  被你杀死。");
    g_tipLine[3203] = StringToText("【角色简介】");
    g_tipLine[3204] = StringToText("奥赫能够杀死特定的角色。");
    g_tipLine[3205] = StringToText("· 与其他恶魔不同，奥赫在攻击时选择的是角色，而不是玩家。说书人可能需要提醒玩家");
    g_tipLine[3206] = StringToText("  奥赫能力的特殊之处。建议在游戏进入到夜晚阶段时，让所有玩家将角色列表放在");
    g_tipLine[3207] = StringToText("  手边。");
    g_tipLine[3208] = StringToText("· 如果奥赫愿意，他可以杀死邪恶角色。");
    g_tipLine[3209] = StringToText("· 如果某个角色有多名玩家在场，且奥赫选择了这个角色，只会有一名玩家死亡。");
    g_tipLine[3210] = StringToText("· 如果奥赫选择了不在场的角色，说书人大多数情况下都会杀死一名存活的善良玩家。说");
    g_tipLine[3211] = StringToText("  书人杀死死亡玩家或邪恶玩家虽然可行，但这种情况会非常少见。");
    g_tipLine[3212] = StringToText("【规则细节】");
    g_tipRoleAt[134] = 3200; g_tipRoleN[134] = 13;
    g_tipAbility[135] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量外来者]");
    g_tipLine[3213] = StringToText("【角色能力】");
    g_tipLine[3214] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量");
    g_tipLine[3215] = StringToText("  外来者]");
    g_tipLine[3216] = StringToText("【角色简介】");
    g_tipLine[3217] = StringToText("卡扎力能自由选择自己的爪牙。");
    g_tipLine[3218] = StringToText("· 如果卡扎力在游戏中途被创造，他不会选择玩家成为新的爪牙。");
    g_tipLine[3219] = StringToText("· 说书人可以将这些变成爪牙的玩家的原本善良角色作为恶魔的伪装提供，因为这些角色");
    g_tipLine[3220] = StringToText("  都已不在场。");
    g_tipLine[3221] = StringToText("· 卡扎力对设置调整的效果在设置阶段和游戏的首个夜晚均会生效。");
    g_tipLine[3222] = StringToText("· 在唤醒这些爪牙，告诉他们自己的新角色的过程中，说书人可以让卡扎力见证这一过程，");
    g_tipLine[3223] = StringToText("  也可以让他先行入睡。");
    g_tipLine[3224] = StringToText("· 卡扎力只能选择位于角色列表上的爪牙。他不能选择让多名玩家变成同一个爪牙角色。");
    g_tipLine[3225] = StringToText("· 卡扎力能够将他想要的任意玩家变成爪牙，无论该名玩家的角色能力如何，例如：士兵，");
    g_tipLine[3226] = StringToText("  莽夫，落难少女，国王等。");
    g_tipLine[3227] = StringToText("【规则细节】");
    g_tipLine[3228] = StringToText("· 在不考虑与其他角色交互时的运作，卡扎力对于爪牙的转化可以按照「重复这个流程，");
    g_tipLine[3229] = StringToText("  直到场上有与初始设置时同等数量的爪牙」来理解。然而实际上卡扎力的转化的更");
    g_tipLine[3230] = StringToText("  标准的描述形式应该是「重复这个流程，直到卡扎力进行了等同于初始设置爪牙数");
    g_tipLine[3231] = StringToText("  量次数的选择」。");
    g_tipLine[3232] = StringToText("· 虽然在运作方式中没有提到，然而卡扎力在设置时也可以移除一部分原有的外来者，并");
    g_tipLine[3233] = StringToText("  用对应数量的镇民进行替换。");
    g_tipLine[3234] = StringToText("· 特定角色互动：");
    g_tipLine[3235] = StringToText("· 村夫：如果有复数个村夫在场，卡扎力的设置调整优先生效，其他的村夫因卡扎力的能");
    g_tipLine[3236] = StringToText("  力变成了爪牙，剩下的那名村夫一定是清醒的，因为这时村夫已经只有一个了。");
    g_tipLine[3237] = StringToText("· 相克规则：");
    g_tipLine[3238] = StringToText("· 赏金猎人：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_tipLine[3239] = StringToText("· 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[3240] = StringToText("· 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[3241] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3242] = StringToText("· 戏子：卡扎力和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一");
    g_tipLine[3243] = StringToText("  个夜晚变成戏子，卡扎力会在这一效果生效之前先进行转变爪牙的行动。");
    g_tipRoleAt[135] = 3213; g_tipRoleN[135] = 31;
    // ---- 【官网详情照录】94..102 / 136..142 / 147 ----
    g_tipLine[3250] = StringToText("【角色能力】");
    g_tipLine[3251] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。");
    g_tipLine[3252] = StringToText("  [多数玩家为军团]");
    g_tipLine[3253] = StringToText("【角色简介】");
    g_tipLine[3254] = StringToText("军团由多个恶魔组成。");
    g_tipLine[3255] = StringToText("· 如果军团在场，推荐将在场善良和邪恶玩家的数量在通常的数量上进行反转。例如，在一局十人游戏中，");
    g_tipLine[3256] = StringToText("  你可以采取近似七名军团和三名善良玩家的设置。");
    g_tipLine[3257] = StringToText("· 非军团的玩家可以是镇民也可以是外来者，由说书人来决定这些善良玩家的角色类型组合方式。");
    g_tipLine[3258] = StringToText("· 如果一项提名中至少有一名善良玩家参与投票，并且被提名的玩家「即将被处决」，");
    g_tipLine[3259] = StringToText("  那么在处决阶段时处决会正常发生。如果一项提名中只有邪恶玩家参与了投票，");
    g_tipLine[3260] = StringToText("  那么在统计票数的时候会记为零票。");
    g_tipLine[3261] = StringToText("· 每名军团在互动时被当作恶魔，同时也被当作爪牙。");
    g_tipLine[3262] = StringToText("· 由说书人来决定哪一名玩家会在夜晚死亡。");
    g_tipLine[3263] = StringToText("· 如果游戏中只剩一名善良玩家存活，说书人可以宣布邪恶阵营获胜，因为在这种条件下善良阵营无法获胜。");
    g_tipLine[3264] = StringToText("· 说书人可以不向军团提供恶魔的伪装。");
    g_tipLine[3265] = StringToText("【规则细节】");
    g_tipLine[3266] = StringToText("· 相克规则：");
    g_tipLine[3267] = StringToText("· 工程师：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，");
    g_tipLine[3268] = StringToText("  工程师失去能力并改为得知这一信息。");
    g_tipLine[3269] = StringToText("· 传教士：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_tipLine[3270] = StringToText("· 吟游诗人：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处决的玩家是军团");
    g_tipLine[3271] = StringToText("  。");
    g_tipLine[3272] = StringToText("· 帽匠：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[3273] = StringToText("· 狂热者：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[3274] = StringToText("· 召唤师：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[3275] = StringToText("· 政客：政客可能会被军团当作邪恶玩家。");
    g_tipLine[3276] = StringToText("· 魔术师：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_tipLine[3277] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3278] = StringToText("· 戏子：在戏子存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[3279] = StringToText("  说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipLine[3280] = StringToText("· 戏子（改）：在戏子（改）存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[3281] = StringToText("  说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipRoleAt[94] = 3250; g_tipRoleN[94] = 32;
    g_tipLine[3282] = StringToText("【角色能力】");
    g_tipLine[3283] = StringToText("你拥有一个爪牙角色的能力。当你使用能力时，说书人可能会要求你更换选择。");
    g_tipLine[3284] = StringToText("【角色简介】");
    g_tipLine[3285] = StringToText("炼金术士具有爪牙的能力。");
    g_tipLine[3286] = StringToText("· 炼金术士通常会获得一个不在场爪牙的能力，但可以获得一个在场爪牙的能力。");
    g_tipLine[3287] = StringToText("· 炼金术士会在自己的首个夜晚得知自己获得了哪一项爪牙的能力。");
    g_tipLine[3288] = StringToText("· 炼金术士仍然是善良的镇民。他会在善良阵营获胜时一同获胜，也会在善良阵营落败时一同落败。");
    g_tipLine[3289] = StringToText("  他被当作善良阵营的炼金术士。");
    g_tipLine[3290] = StringToText("· 不同于一般的爪牙，炼金术士不会被唤醒以得知其他爪牙以及恶魔分别是哪些玩家。");
    g_tipLine[3291] = StringToText("· 如果炼金术士获得的爪牙能力会导致在设置阶段添加或移除角色，这一能力也会在设置阶段生效。");
    g_tipLine[3292] = StringToText("· 如果炼金术士获得了一个可以选择的能力，比如投毒者或维齐尔，说书人可以让炼金术士换个选择，");
    g_tipLine[3293] = StringToText("  炼金术士就必须更换自己的选择。");
    g_tipLine[3294] = StringToText("【规则细节】");
    g_tipLine[3295] = StringToText("· 特定角色互动：");
    g_tipLine[3296] = StringToText("· 学徒：善良学徒可以获得炼金术士的能力，进而获得一个爪牙的能力。");
    g_tipLine[3297] = StringToText("· 赏金猎人：赏金猎人可以让炼金术士转变为邪恶，让爪牙能力回归邪恶阵营。");
    g_tipLine[3298] = StringToText("· 洗脑师：无论洗脑师或炼金洗脑师，告知目标玩家「疯狂」的流程都一样，");
    g_tipLine[3299] = StringToText("  对该玩家展示洗脑师角色标记和需要「疯狂」的角色标记。");
    g_tipLine[3300] = StringToText("· 侍女：炼金术士会在第一夜被唤醒得知他获得了什么爪牙能力，之后是否被唤醒取决于他获得的爪牙能力。");
    g_tipLine[3301] = StringToText("· 镜像双子：如果炼金术士获得镜像双子能力，则将一名邪恶玩家设置为他的「对立双子」。");
    g_tipLine[3302] = StringToText("  如果这名善良的炼金双子被处决，邪恶阵营获胜。");
    g_tipLine[3303] = StringToText("· 恐惧之灵：获得恐惧之灵能力的炼金术士在夜晚触发的公开宣布与恐惧之灵相同：「恐惧之灵选择了一名玩家」。");
    g_tipLine[3304] = StringToText("· 哥布林：炼金哥布林触发哥布林能力需要声明自己是哥布林，而不是炼金哥布林。实际上，");
    g_tipLine[3305] = StringToText("  如果不允许将这两种情况当作同样处理，也太过于为难玩家了。");
    g_tipLine[3306] = StringToText("· 军团：炼金术士无法获得军团的能力。");
    g_tipLine[3307] = StringToText("· 小怪宝：炼金术士不是爪牙，所以不会在为秘密决定由哪名玩家照看小怪宝时醒来。");
    g_tipLine[3308] = StringToText("· 精神病患者：当炼金精神病患者发动能力选择一名玩家时，说书人可以公开要求他重新选择一名玩家，");
    g_tipLine[3309] = StringToText("  他必须更换选择。（说书人也可以要求精神病患者重新选择一名玩家，他可以不更换选择）");
    g_tipLine[3310] = StringToText("· 相克规则：");
    g_tipLine[3311] = StringToText("· 寡妇：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。每次处决后，");
    g_tipLine[3312] = StringToText("  存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[3313] = StringToText("· 间谍：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。每次处决后，");
    g_tipLine[3314] = StringToText("  存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[3315] = StringToText("· 召唤师：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_tipLine[3316] = StringToText("  由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[3317] = StringToText("· 科学怪人：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。");
    g_tipLine[3318] = StringToText("· 亡魂：如果炼金术士本应获得亡魂的能力，那么他不会拥有该能力并改为亡魂一定在场。每次处决后，");
    g_tipLine[3319] = StringToText("  存活的炼金术士可以公开猜测一名存活玩家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_tipLine[3320] = StringToText("· 提线木偶：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一定在场。");
    g_tipLine[3321] = StringToText("· 主谋：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_tipLine[3322] = StringToText("· 街头风琴手：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。");
    g_tipLine[3323] = StringToText("  如果炼金术士和街头风琴手都是清醒的，改为他们都醉酒。");
    g_tipLine[3324] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3325] = StringToText("· 蛊雕：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改为蛊雕一定在场。每次处决后，");
    g_tipLine[3326] = StringToText("  存活的炼金术士可以公开猜测一名存活玩家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_tipRoleAt[95] = 5752; g_tipRoleN[95] = 46;
    g_tipLine[3327] = StringToText("【角色能力】");
    g_tipLine[3328] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（善良/邪恶/均势）。");
    g_tipLine[3329] = StringToText("【角色简介】");
    g_tipLine[3330] = StringToText("将军清楚哪个阵营更具有优势。");
    g_tipLine[3331] = StringToText("· 如果善良阵营更具优势，说书人会给出大拇指朝上的手势。如果邪恶阵营更具优势，");
    g_tipLine[3332] = StringToText("  说书人会给出大拇指朝下的手势。如果双方阵营势均力敌，或说书人并不确信哪一方更具优势，");
    g_tipLine[3333] = StringToText("  说书人会给出大拇指水平指向一侧的手势。");
    g_tipLine[3334] = StringToText("· 说书人需要对阵营的优势做出判断。很多因素都会作为考量，例如每个阵营有多少存活的玩家，");
    g_tipLine[3335] = StringToText("  善良阵营获取的信息程度如何，邪恶阵营的伪装的取信程度如何，玩家们即将打算处决谁，");
    g_tipLine[3336] = StringToText("  或是恶魔玩家的游戏经验是否丰富。上述所有内容以及一些其他因素都会影响说书人的判断。");
    g_tipLine[3337] = StringToText("· 说书人判断的是将军被唤醒的那一刻更具有优势的阵营。当晚较早时段里发生的事情也可能会影响判断。");
    g_tipRoleAt[96] = 7177; g_tipRoleN[96] = 14;
    g_tipLine[3338] = StringToText("【角色能力】");
    g_tipLine[3339] = StringToText("如果你是对你的阵营落败负最大责任的人，你转变阵营并获胜，即使你已死亡。");
    g_tipLine[3340] = StringToText("【角色简介】");
    g_tipLine[3341] = StringToText("如果政客落败，政客可以转变他的阵营。");
    g_tipLine[3342] = StringToText("· 当游戏结束时，如果政客是善良阵营落败负最大责任的人，政客会加入邪恶阵营并一起获胜。");
    g_tipLine[3343] = StringToText("· 当决定谁获胜的关键时候，政客玩家应当非常有影响力。");
    g_tipLine[3344] = StringToText("  简单的散布错误信息或投票善良玩家通常是不够的——他需要比任何一个其他的善良玩家起到让善良阵营落败的关");
    g_tipLine[3345] = StringToText("  键作用，同时最好也是比任何一个邪恶玩家的作用大。由说书人决定政客是否符合条件。");
    g_tipLine[3346] = StringToText("· 政客也可以和其他角色一样，以善良阵营获胜。");
    g_tipLine[3347] = StringToText("· 中毒或醉酒的政客不能转变阵营。");
    g_tipLine[3348] = StringToText("· 如果邪恶玩家的总数已经比初始设置多了一名，即使政客是对善良阵营落败负最大责任的人，");
    g_tipLine[3349] = StringToText("  由于圣洁之魂的存在，也不能转变阵营获胜。");
    g_tipLine[3350] = StringToText("【规则细节】");
    g_tipLine[3351] = StringToText("· 相克规则：");
    g_tipLine[3352] = StringToText("· 麻脸巫婆：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。");
    g_tipLine[3353] = StringToText("· 维齐尔：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[3354] = StringToText("· 科学怪人：恶魔无法拥有政客的能力。");
    g_tipLine[3355] = StringToText("· 军团：政客可能会被军团当作邪恶玩家。");
    g_tipRoleAt[97] = 4063; g_tipRoleN[97] = 18;
    g_tipLine[3356] = StringToText("【角色能力】");
    g_tipLine[3357] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipLine[3358] = StringToText("【角色简介】");
    g_tipLine[3359] = StringToText("巫师许下愿望。");
    g_tipLine[3360] = StringToText("· 这个愿望只受限于玩家的想象力，它可以是任何事。巫师可以在夜晚用手机屏幕展示愿望内容给说书人，");
    g_tipLine[3361] = StringToText("  也可以在白天私下告诉说书人。如果巫师有些鲁莽，他也可以公开许愿。");
    g_tipLine[3362] = StringToText("· 说书人不必立刻公开宣布巫师许下了愿望，而是可以稍后再宣布。");
    g_tipLine[3363] = StringToText("· 许多愿望都伴随着代价。代价可能会以某种方式影响游戏，或是影响这个愿望本身。它也可以是任何事，");
    g_tipLine[3364] = StringToText("  由说书人认真思考后决定。说书人可以决定是否告诉巫师愿望的代价。");
    g_tipLine[3365] = StringToText("  代价的目的是为了从能力的效果上平衡这个愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[3366] = StringToText("· 许多愿望会留下线索。线索可以是任何事，由说书人认真思考后决定，然后再公开宣布。");
    g_tipLine[3367] = StringToText("  线索的目的是为了从信息上平衡这个愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[3368] = StringToText("· 当巫师死亡，愿望可能会继续生效，也可能会失效，取决于愿望和代价具体是什么。");
    g_tipLine[3369] = StringToText("· 如果巫师许了一个说书人不理解的愿望，或者说书人认为他无法实现，说书人可以让巫师重新许愿，");
    g_tipLine[3370] = StringToText("  或者告诉巫师，他的愿望被消耗了。");
    g_tipRoleAt[98] = 3356; g_tipRoleN[98] = 15;
    g_tipLine[3371] = StringToText("【角色能力】");
    g_tipLine[3372] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipLine[3373] = StringToText("【角色简介】");
    g_tipLine[3374] = StringToText("哥布林会在小镇明知他是哥布林却要处决他时采取报复。");
    g_tipLine[3375] = StringToText("· 如果哥布林被处决，邪恶阵营获胜。");
    g_tipLine[3376] = StringToText("· 为了让这种情况发生，哥布林需要在被提名后，开始投票前告知其他玩家他是哥布林。");
    g_tipLine[3377] = StringToText("  他的公开宣言需要让所有人都听见，因为善良玩家必须清楚自己接下来的行为所带来的风险。");
    g_tipLine[3378] = StringToText("· 如果哥布林没有公布自己的角色就被处决了，那么哥布林死亡，游戏如常进行。");
    g_tipLine[3379] = StringToText("· 哥布林必须在被处决的当天宣布自己的角色，只有这样他的能力才会生效。");
    g_tipLine[3380] = StringToText("  在前一天或更早的时间里宣布不会产生效果。");
    g_tipLine[3381] = StringToText("· 任何玩家都可以在被提名时声称自己是哥布林。");
    g_tipLine[3382] = StringToText("【规则细节】");
    g_tipLine[3383] = StringToText("· 相克规则：");
    g_tipLine[3384] = StringToText("· 瘟疫医生：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[3385] = StringToText("· 洗脑师：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[3386] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3387] = StringToText("· 戏子：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[3388] = StringToText("· 戏子（改）：戏子（改）无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[3389] = StringToText("· 姑获鸟：姑获鸟无法获得哥布林的能力。");
    g_tipRoleAt[99] = 3371; g_tipRoleN[99] = 19;
    g_tipLine[3390] = StringToText("【角色能力】");
    g_tipLine[3391] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，");
    g_tipLine[3392] = StringToText("  只有当他处于死亡状态时你才会立即死亡。");
    g_tipLine[3393] = StringToText("【角色简介】");
    g_tipLine[3394] = StringToText("痢蛭在宿主存活时存活，在宿主死亡时死亡。");
    g_tipLine[3395] = StringToText("· 在首个夜晚，痢蛭会选择一名玩家，被选择的玩家会在游戏的剩余时间内都处于中毒状态。");
    g_tipLine[3396] = StringToText("· 如果这名玩家存活，痢蛭就不会死亡。如果痢蛭被处决，说书人会告诉大家这名玩家仍然存活，但不会说明原因。");
    g_tipLine[3397] = StringToText("· 如果这名首夜被痢蛭选择的玩家死亡，痢蛭也会死亡。如果此时只剩一名或两名玩家存活，");
    g_tipLine[3398] = StringToText("  那么善良阵营还是会获胜，因为恶魔死亡了。");
    g_tipLine[3399] = StringToText("· 从第二个夜晚开始，痢蛭会攻击并杀死玩家，但不会让他中毒。");
    g_tipLine[3400] = StringToText("· 如果痢蛭在游戏过程中被创造，他会在当晚令一名玩家中毒。他必须要选择一名存活的玩家。");
    g_tipLine[3401] = StringToText("【规则细节】");
    g_tipLine[3402] = StringToText("· 当痢蛭醉酒或中毒时，宿主恢复健康。如果宿主在这个期间死亡，痢蛭不会受到影响，");
    g_tipLine[3403] = StringToText("  当痢蛭恢复清醒/健康后会立即死亡。如果痢蛭在醉酒或中毒时死亡，他死亡，");
    g_tipLine[3404] = StringToText("  因为他的能力在醉酒/中毒时无法阻止死亡。如果痢蛭的宿主醉酒/中毒，对痢蛭没有影响。");
    g_tipLine[3405] = StringToText("· 痢蛭仍然是恶魔，宿主仍然是他相应的角色类型，痢蛭对宿主的选择不会对他的角色产生任何改变。注意，");
    g_tipLine[3406] = StringToText("  宿主可以是任何存活玩家，不管是什么角色类型。");
    g_tipLine[3407] = StringToText("· 特定角色互动：");
    g_tipLine[3408] = StringToText("· 驱魔人：如果痢蛭在他的首个夜晚之后被驱魔，他不会醒来，但宿主仍然中毒，并且除非宿主死亡，痢蛭不会死。");
    g_tipLine[3409] = StringToText("  如果痢蛭在游戏过程中被创造，因为痢蛭的「选择玩家让他中毒」的能力属于进场能力且不属于信息类能力，");
    g_tipLine[3410] = StringToText("  所以该能力会尽可能快地进行结算，从而使得在轮到驱魔人行动时，如果驱魔人选中了痢蛭，");
    g_tipLine[3411] = StringToText("  也不会因为「痢蛭无法因为自己的能力被唤醒」而导致「痢蛭没有宿主」的情况出现。");
    g_tipLine[3412] = StringToText("· 士兵：如果士兵被痢蛭选为宿主，他不会中毒。然而，如果他因为任何原因死亡（被处决，半兽人等等），");
    g_tipLine[3413] = StringToText("  痢蛭也会死亡。");
    g_tipLine[3414] = StringToText("· 莽夫：如果莽夫在首个夜晚被选为宿主，这会使得痢蛭醉酒直到下个黄昏，并且莽夫变为邪恶。");
    g_tipLine[3415] = StringToText("  如果莽夫在首个白天被处决，痢蛭仍然会死亡，因为莽夫的醉酒效果由于莽夫的死亡而消失了。");
    g_tipLine[3416] = StringToText("  莽夫在整局游戏中都不会因为痢蛭的能力中毒（可以将痢蛭的中毒标记倒转放置在莽夫的角色标记旁，");
    g_tipLine[3417] = StringToText("  仅做寄生的提示用），但如果他死亡，痢蛭也会死亡。");
    g_tipLine[3418] = StringToText("· 疯子：如果疯子自认为是痢蛭，真正的恶魔会被告知疯子在首个夜晚选择谁作为宿主，但是，举例来说，");
    g_tipLine[3419] = StringToText("  这与疯子自认为是普卡并在首个夜晚做出选择没有什么区别——真正的恶魔不会知道这里面的区别。");
    g_tipLine[3420] = StringToText("· 麻脸巫婆：如果创造出新的恶魔，仍然需要杀死宿主才能杀死痢蛭，麻脸巫婆不能无视痢蛭免死的能力。");
    g_tipLine[3421] = StringToText("· 旅行者：可以被选为宿主，但不建议。因为如果旅行者离开，他死亡，并且痢蛭因此死亡。");
    g_tipLine[3422] = StringToText("· 咖啡师：如果咖啡2不是在首个夜晚，痢蛭可以杀害两次。如果咖啡2在首个夜晚，痢蛭选择两名玩家，");
    g_tipLine[3423] = StringToText("  从现在开始他们两个都中毒。无论如何，必须这两名玩家都死亡，痢蛭才会死亡。");
    g_tipLine[3424] = StringToText("· 相克规则：");
    g_tipLine[3425] = StringToText("· 猎手：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_tipLine[3426] = StringToText("· 主谋：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[3427] = StringToText("· 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3428] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3429] = StringToText("· 半仙：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[3430] = StringToText("· 使节：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[3431] = StringToText("· 掮客：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipRoleAt[100] = 3390; g_tipRoleN[100] = 42;
    g_tipLine[3432] = StringToText("【角色能力】");
    g_tipLine[3433] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipLine[3434] = StringToText("【角色简介】");
    g_tipLine[3435] = StringToText("异端分子能够转换胜负结果。");
    g_tipLine[3436] = StringToText("· 如果一局游戏会使得善良阵营获胜，异端分子会导致所有善良玩家落败，且邪恶玩家获胜。");
    g_tipLine[3437] = StringToText("· 如果一局游戏将由邪恶阵营获胜而结束，邪恶玩家落败，善良玩家获胜。");
    g_tipLine[3438] = StringToText("· 异端分子的能力会应用于所有的胜利条件，包括只剩两名非旅行者玩家存活，所有恶魔死亡，");
    g_tipLine[3439] = StringToText("  或一项能力导致的游戏结束。");
    g_tipLine[3440] = StringToText("· 异端分子的能力在他死亡时仍然正常生效，但在他醉酒中毒时不会生效。");
    g_tipLine[3441] = StringToText("【规则细节】");
    g_tipLine[3442] = StringToText("· 特定角色互动：");
    g_tipLine[3443] = StringToText("· 食人族：（参考最新的处决流程整理）如果异端分子被处决并导致游戏结束，食人族不会获得异端分子的能力。");
    g_tipLine[3444] = StringToText("· 将军：将军的信息应该将异端分子考虑在内。如果善良阵营已经非常接近找出并处决恶魔，但异端分子在场，");
    g_tipLine[3445] = StringToText("  因为处决恶魔会导致邪恶阵营获胜，所以应该展示邪恶更有优势。");
    g_tipLine[3446] = StringToText("· 哲学家：如果哲学家选择异端分子，随后死亡，哲学家仍然保留这个能力，因为那是「死后能力保留」的能力。");
    g_tipLine[3447] = StringToText("  然而，原始异端分子也会在哲学家死亡时恢复清醒，这意味着游戏中有两个正常生效的异端分子能力。");
    g_tipLine[3448] = StringToText("· 镜像双子：异端分子的能力只有在游戏因为满足某个胜利条件而结束的时候才会生效。");
    g_tipLine[3449] = StringToText("  所以镜像双子将会阻止因善良阵营获胜而结束游戏，但如果游戏因邪恶阵营获胜而结束，");
    g_tipLine[3450] = StringToText("  异端分子能力会生效并转为让善良阵营获胜。");
    g_tipLine[3451] = StringToText("· 相克规则：");
    g_tipLine[3452] = StringToText("· 教父：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3453] = StringToText("· 间谍：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3454] = StringToText("· 寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3455] = StringToText("· 麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3456] = StringToText("· 痢蛭：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3457] = StringToText("· 男爵：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[3458] = StringToText("· 科学怪人：恶魔无法拥有异端分子的能力。");
    g_tipLine[3459] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3460] = StringToText("· 狐媚娘：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[101] = 4081; g_tipRoleN[101] = 29;
    g_tipLine[3461] = StringToText("【角色能力】");
    g_tipLine[3462] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，");
    g_tipLine[3463] = StringToText("  所有玩家都会得知你选择了新的玩家。");
    g_tipLine[3464] = StringToText("【角色简介】");
    g_tipLine[3465] = StringToText("恐惧之灵在提名中掺入猜疑。");
    g_tipLine[3466] = StringToText("· 在游戏的首个夜晚，恐惧之灵选择了一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[3467] = StringToText("· 在其他夜晚，每当恐惧之灵选择了与上次选择不同的一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[3468] = StringToText("  如果恐惧之灵选择的玩家与上一次选择的相同，玩家不会得知任何内容。");
    g_tipLine[3469] = StringToText("· 玩家只会得知恐惧之灵是否采取了行动，但不会得知恐惧之灵具体选择了哪一名玩家。");
    g_tipLine[3470] = StringToText("· 如果恐惧之灵提名了他当前选择的玩家，且该玩家因此被处决时，该玩家的阵营落败，游戏结束。");
    g_tipLine[3471] = StringToText("· 只有恐惧之灵当前选择的玩家会受到恐惧之灵的能力影响。他此前选择的玩家不会受到影响。");
    g_tipLine[3472] = StringToText("· 如果被选择的玩家被恐惧之灵提名并处决后没有死亡，他的阵营仍然会落败。");
    g_tipLine[3473] = StringToText("【规则细节】");
    g_tipLine[3474] = StringToText("· 相克规则：");
    g_tipLine[3475] = StringToText("· 瘟疫医生：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[3476] = StringToText("· 维齐尔：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[3477] = StringToText("  并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[3478] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3479] = StringToText("· 戏子：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[3480] = StringToText("· 戏子（改）：戏子（改）无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipRoleAt[102] = 3461; g_tipRoleN[102] = 20;
    g_tipLine[3481] = StringToText("【角色能力】");
    g_tipLine[3482] = StringToText("恶魔会以为你是爪牙。爪牙会以为你是恶魔。");
    g_tipLine[3483] = StringToText("【角色简介】");
    g_tipLine[3484] = StringToText("魔术师能够迷惑邪恶玩家，让他们分不清究竟谁才是邪恶。");
    g_tipLine[3485] = StringToText("· 在游戏的首个夜晚，不是告诉所有爪牙哪名玩家是恶魔，而是改为告诉爪牙魔术师和恶魔都是恶魔。");
    g_tipLine[3486] = StringToText("· 在游戏的首个夜晚，恶魔会得知所有爪牙和魔术师都是爪牙。");
    g_tipLine[3487] = StringToText("· 魔术师不会因此被唤醒，也不会得知任何有关恶魔和爪牙的信息。");
    g_tipLine[3488] = StringToText("· 说书人在告知时可以以任意顺序指向魔术师和其他邪恶玩家，");
    g_tipLine[3489] = StringToText("  这样邪恶玩家就不会知道究竟哪一名玩家是魔术师了。");
    g_tipLine[3490] = StringToText("· 如果罂粟种植者死亡，导致恶魔和爪牙在游戏中途互认，魔术师的能力也会在那个夜晚生效，");
    g_tipLine[3491] = StringToText("  就如同常规情况下在首个夜晚时一样。");
    g_tipLine[3492] = StringToText("【规则细节】");
    g_tipLine[3493] = StringToText("· 特定角色互动：");
    g_tipLine[3494] = StringToText("· 赏金猎人：被赏金猎人转变为邪恶阵营的镇民不是爪牙或恶魔，因此魔术师不会因自身能力与该玩家发生互动。");
    g_tipLine[3495] = StringToText("· 罂粟种植者：如果罂粟种植者死亡时魔术师还活着，他会影响爪牙/恶魔信息环节，就像他在首夜运作的那样。");
    g_tipLine[3496] = StringToText("· 疯子：如果角色列表上有魔术师，你可以假装让疯子以为场上有魔术师，并且向他展示额外一名「爪牙」，");
    g_tipLine[3497] = StringToText("  无论场上是否真的有魔术师。");
    g_tipLine[3498] = StringToText("· 主谋：不与魔术师的能力发生互动。尽管主谋以为魔术师是恶魔，但主谋能力不会将魔术师当作恶魔，");
    g_tipLine[3499] = StringToText("  所以魔术师被处决时不会触发主谋能力。");
    g_tipLine[3500] = StringToText("· 灵言师：可以将魔术师转变为邪恶阵营。同样，当灵言师以为魔术师是恶魔，但灵言师能力将魔术师当作善良，");
    g_tipLine[3501] = StringToText("  因此如果魔术师首个说出关键词，当晚会转变为邪恶阵营。");
    g_tipLine[3502] = StringToText("· 红唇女郎：参考主谋/灵言师。");
    g_tipLine[3503] = StringToText("· 小恶魔：小恶魔选择在夜里自杀，不能将魔术师的角色改变为小恶魔。");
    g_tipLine[3504] = StringToText("· 诺-达鲺：如果魔术师是与诺-达鲺邻近的镇民玩家，他无法影响恶魔/爪牙信息环节。");
    g_tipLine[3505] = StringToText("· 涡流：不与魔术师发生互动。");
    g_tipLine[3506] = StringToText("· 旅行者/传奇角色：既不是爪牙也不是恶魔（即使是拥有爪牙能力的学徒），所以不会被魔术师能力影响，");
    g_tipLine[3507] = StringToText("  只能得知正确的恶魔玩家。");
    g_tipLine[3508] = StringToText("· 咖啡师：如果恶魔/爪牙在首夜因为咖啡师变得清醒且健康，恶魔/爪牙信息环节魔术师将不会向他展示。");
    g_tipLine[3509] = StringToText("· 相克规则：");
    g_tipLine[3510] = StringToText("· 间谍/寡妇：当间谍/寡妇查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_tipLine[3511] = StringToText("  （请同样移除任何相关提示标记以便在缺少角色标记的情况下让其不是那么明显。）");
    g_tipLine[3512] = StringToText("· 小怪宝：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_tipLine[3513] = StringToText("· 维齐尔：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[3514] = StringToText("· 亡魂：每次处决后，存活的魔术师可以公开猜测一名存活玩家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_tipLine[3515] = StringToText("· 军团：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_tipLine[3516] = StringToText("· 提线木偶：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_tipLine[3517] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3518] = StringToText("· 蛊雕：蛊雕会跳过魔术师。");
    g_tipRoleAt[136] = 6163; g_tipRoleN[136] = 41;
    g_tipLine[3519] = StringToText("【角色能力】");
    g_tipLine[3520] = StringToText("当你死亡时，说书人会获得一个爪牙能力。");
    g_tipLine[3521] = StringToText("【角色简介】");
    g_tipLine[3522] = StringToText("瘟疫医生会将额外的爪牙能力带入游戏中。");
    g_tipLine[3523] = StringToText("· 由说书人来选择获得哪一个爪牙的能力。");
    g_tipLine[3524] = StringToText("· 瘟疫医生的能力效果会在剩余的游戏时间里持续生效。");
    g_tipLine[3525] = StringToText("· 说书人不会有其他变化——他不会转为邪恶阵营，不会成为玩家，不会成为其他能力的合法目标，不能参与投票，");
    g_tipLine[3526] = StringToText("  也不能发起提名。");
    g_tipLine[3527] = StringToText("· 如果瘟疫医生在死亡时醉酒中毒，说书人不会获得爪牙能力，即使瘟疫医生在之后恢复清醒健康。");
    g_tipLine[3528] = StringToText("【规则细节】");
    g_tipLine[3529] = StringToText("· 相克规则：");
    g_tipLine[3530] = StringToText("· 男爵：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[3531] = StringToText("· 炸弹人：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipLine[3532] = StringToText("· 镜像双子：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[3533] = StringToText("· 提线木偶：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[3534] = StringToText("· 恐惧之灵/哥布林/红唇女郎/间谍/亡魂：如果说书人本应获得这些爪牙之一的能力，");
    g_tipLine[3535] = StringToText("  改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[3536] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3537] = StringToText("· 赶尸人/狐媚娘/养蛊人/蛊雕：如果说书人本应获得这些爪牙之一的能力，改为一名爪牙玩家获得此能力，");
    g_tipLine[3538] = StringToText("  且他会得知此事。");
    g_tipRoleAt[137] = 4171; g_tipRoleN[137] = 20;
    g_tipLine[3539] = StringToText("【角色能力】");
    g_tipLine[3540] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipLine[3541] = StringToText("【角色简介】");
    g_tipLine[3542] = StringToText("炸弹人会在被处决后引爆炸弹，消灭在场的绝大多数玩家。");
    g_tipLine[3543] = StringToText("· 如果炸弹人被处决，由说书人来选择会有哪些玩家被杀死，每次一名玩家，直到只剩三名玩家存活。");
    g_tipLine[3544] = StringToText("· 恶魔一定会是这三名存活的玩家之一（在绝大多数情况下都应该是这种结果，否则游戏就会立刻结束）。");
    g_tipLine[3545] = StringToText("· 玩家们要在十声倒数内决定下一个死亡的是谁。今天白天不会有其他的提名和处决，取而代之的是，");
    g_tipLine[3546] = StringToText("  所有玩家会用手指指向自己想要杀死的玩家。在倒数结束后，说书人会统计每名玩家被指向的次数。");
    g_tipLine[3547] = StringToText("  如果这种情况下出现了平局，那么游戏会进入夜晚阶段（邪恶阵营极有可能会因为恶魔在当晚的杀戮而获胜）。");
    g_tipLine[3548] = StringToText("· 即使是失去了投票标记的已死亡玩家，也能够用手指指向自己想要杀死的玩家。");
    g_tipLine[3549] = StringToText("· 玩家在倒数时间内可以随意更换手指指向的目标，在倒数结束后指向的结果才会作为最终结果。");
    g_tipLine[3550] = StringToText("· 炸弹人只会因为处决而触发能力。通过其他方式死亡，例如魔像或者精神病患者，不会触发能力。");
    g_tipLine[3551] = StringToText("  如果炸弹人被处决但没有死亡（由于魔鬼代言人等的能力），他的能力仍然会触发。");
    g_tipLine[3552] = StringToText("· 如果有不会死亡的角色在场，例如弄臣或水手，那么在炸弹人触发能力之后，可能会有多于三名玩家存活。");
    g_tipLine[3553] = StringToText("【规则细节】");
    g_tipLine[3554] = StringToText("· 相克规则：");
    g_tipLine[3555] = StringToText("· 瘟疫医生：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipRoleAt[138] = 3539; g_tipRoleN[138] = 17;
    g_tipLine[3556] = StringToText("【角色能力】");
    g_tipLine[3557] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，");
    g_tipLine[3558] = StringToText("  否则他们之中可能会有人死亡。");
    g_tipLine[3559] = StringToText("【角色简介】");
    g_tipLine[3560] = StringToText("鹰身女妖在善良玩家之间制造争论与怀疑。");
    g_tipLine[3561] = StringToText("· 在夜晚时，鹰身女妖选择玩家时是一次选择一名玩家，而不是同时选择两名玩家。");
    g_tipLine[3562] = StringToText("· 被鹰身女妖选择的玩家会在鹰身女妖下一次进行选择之前持续被影响。");
    g_tipLine[3563] = StringToText("· 如果说书人决定通过鹰身女妖的能力杀死玩家，那么他必须决定是杀死其中一名玩家还是全部杀死。");
    g_tipLine[3564] = StringToText("· 鹰身女妖可以选择已死亡的玩家。如果她这么做，那么说书人只能杀死当前仍存活的目标玩家，");
    g_tipLine[3565] = StringToText("  因为已死亡的玩家不能再次死亡。");
    g_tipLine[3566] = StringToText("· 被鹰身女妖的能力杀死的玩家的死亡顺序由说书人决定，这一点非常重要。");
    g_tipRoleAt[139] = 3556; g_tipRoleN[139] = 11;
    g_tipLine[3567] = StringToText("【角色能力】");
    g_tipLine[3568] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。");
    g_tipLine[3569] = StringToText("每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipLine[3570] = StringToText("【角色简介】");
    g_tipLine[3571] = StringToText("街头风琴手会让投票秘密进行。");
    g_tipLine[3572] = StringToText("· 当一名玩家被提名后，在投票时所有玩家都需要闭上眼睛。");
    g_tipLine[3573] = StringToText("· 说书人在计票时不会大声唱票，也不会在一次投票结束时告诉大家有多少玩家投了票。");
    g_tipLine[3574] = StringToText("· 说书人不会告诉大家某次提名是否导致了一名玩家「即将被处决」。");
    g_tipLine[3575] = StringToText("· 在提名阶段结束后，说书人宣布了哪名玩家被处决，和正常一样。");
    g_tipLine[3576] = StringToText("· 已死亡的玩家在有投票标记时能够如常投票，但仅限一次。");
    g_tipLine[3577] = StringToText("  他们的投票标记会在当天白天结束时被移除而不是在单次投票后立即被移除。");
    g_tipLine[3578] = StringToText("· 如果街头风琴手醉酒，和正常情况一样，所有玩家睁眼投票。说书人无需对此进行额外说明，");
    g_tipLine[3579] = StringToText("  比如街头风琴手是否死亡或存活。当天夜晚，街头风琴手要再次选择自己醉酒或清醒。");
    g_tipLine[3580] = StringToText("【规则细节】");
    g_tipLine[3581] = StringToText("· 特定角色互动：");
    g_tipLine[3582] = StringToText("· 枪手：因为说书人能够决定在游戏中有哪些旅行者可以出场并被玩家选择作为自己的旅行者角色，");
    g_tipLine[3583] = StringToText("  因此避免枪手在有街头风琴手的剧本中出场是应对这两个角色的奇怪互动的最好方式。");
    g_tipLine[3584] = StringToText("· 相克规则：");
    g_tipLine[3585] = StringToText("· 管家：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，");
    g_tipLine[3586] = StringToText("  但只在他的主人投票时他的票才会被统计。");
    g_tipLine[3587] = StringToText("· 炼金术士：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。如果炼金术士和街头风琴手都是清醒的，");
    g_tipLine[3588] = StringToText("  改为他们都醉酒。");
    g_tipLine[3589] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3590] = StringToText("· 梼杌：当梼杌被处决时，如果街头风琴手具有能力，说书人会宣布「无人被处决」。");
    g_tipRoleAt[140] = 3567; g_tipRoleN[140] = 24;
    g_tipLine[3591] = StringToText("【角色能力】");
    g_tipLine[3592] = StringToText("所有玩家都知道你是维齐尔。");
    g_tipLine[3593] = StringToText("你在白天时不会死亡。");
    g_tipLine[3594] = StringToText("如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipLine[3595] = StringToText("【角色简介】");
    g_tipLine[3596] = StringToText("维齐尔能够处决玩家，无需经过镇子的同意。");
    g_tipLine[3597] = StringToText("· 在第一个白天，所有玩家都会得知维齐尔在场，并且知道是哪一名玩家。");
    g_tipLine[3598] = StringToText("· 在白天时，维齐尔不会因为任何原因死亡。");
    g_tipLine[3599] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且至少有一名善良玩家参与投票），");
    g_tipLine[3600] = StringToText("  那么被提名者会立即被处决。这算在每个白天的一次处决之内。");
    g_tipLine[3601] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且没有任何善良玩家参与投票），那么无事发生。");
    g_tipLine[3602] = StringToText("· 即使被提名者得票在存活玩家的半数以下，维齐尔仍然能够执行处决。即使有其他玩家得票比此次被提名者多，");
    g_tipLine[3603] = StringToText("  维齐尔仍然能够执行处决。");
    g_tipLine[3604] = StringToText("· 维齐尔无需在每个白天都使用自己的能力来造成强制处决。");
    g_tipLine[3605] = StringToText("【规则细节】");
    g_tipLine[3606] = StringToText("· 如果维齐尔受到非相克规则的角色带来的醉酒或中毒的效果影响，那么他能够在白天死亡，");
    g_tipLine[3607] = StringToText("  并且无法选择立即执行处决，但玩家不会知道这一点，直到维齐尔尝试这么做为止。");
    g_tipLine[3608] = StringToText("· 如果维齐尔在游戏中途被创造，所有玩家都会立即得知谁是维齐尔。然而如果维齐尔的角色中途发生了变化，");
    g_tipLine[3609] = StringToText("  玩家不会立即得知这一消息（因为暴露角色的能力来源消失了）。");
    g_tipLine[3610] = StringToText("· 相克规则：");
    g_tipLine[3611] = StringToText("· 调查员：说书人不会宣布维齐尔在场。");
    g_tipLine[3612] = StringToText("· 传教士：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[3613] = StringToText("· 侍臣：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[3614] = StringToText("· 魔术师：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[3615] = StringToText("· 戏法师：说书人不会宣布维齐尔在场。");
    g_tipLine[3616] = StringToText("· 政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[3617] = StringToText("· 狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[3618] = StringToText("· 恐惧之灵：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[3619] = StringToText("  并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[3620] = StringToText("· 小怪宝：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[3621] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3622] = StringToText("· 姑获鸟：姑获鸟无法获得维齐尔的能力。");
    g_tipRoleAt[141] = 3591; g_tipRoleN[141] = 32;
    g_tipLine[3623] = StringToText("【角色能力】");
    g_tipLine[3624] = StringToText("在你的首个夜晚，你会得知一名善良玩家。");
    g_tipLine[3625] = StringToText("【角色简介】");
    g_tipLine[3626] = StringToText("事务官会得知一名善良玩家。");
    g_tipLine[3627] = StringToText("· 事务官得知的是玩家，但不会得知他的具体角色。");
    g_tipLine[3628] = StringToText("· 事务官会在首个夜晚得知他的信息。");
    g_tipLine[3629] = StringToText("· 如果事务官在游戏中途被创造，事务官会在当晚得知信息。");
    g_tipRoleAt[142] = 7326; g_tipRoleN[142] = 10;
    // 【全员追忆】玩家视角占位身份：只说明可见类别，不泄露真实角色。
    g_tipLine[3630] = StringToText("失忆的镇民（镇民）");
    g_tipLine[3631] = StringToText("【角色能力】");
    g_tipLine[3632] = StringToText("你只知道自己的角色类型是镇民。真实角色名只有说书人知道。");
    g_tipLine[3633] = StringToText("【角色简介】");
    g_tipLine[3634] = StringToText("你的真实角色可能是全员追忆角色池中的任意一名镇民。");
    g_tipLine[3635] = StringToText("· 说书人仍会按你的真实角色正常唤醒你、处理能力和信息。");
    g_tipLine[3636] = StringToText("· 角色能力表中仍可查看所有角色；你自己的真实身份不会显示在个人信息里。");
    g_tipRoleAt[143] = 3630; g_tipRoleN[143] = 7;
    g_tipLine[3637] = StringToText("失忆的外来者（外来者）");
    g_tipLine[3638] = StringToText("【角色能力】");
    g_tipLine[3639] = StringToText("你只知道自己的角色类型是外来者。真实角色名只有说书人知道。");
    g_tipLine[3640] = StringToText("【角色简介】");
    g_tipLine[3641] = StringToText("你的真实角色可能是全员追忆角色池中的任意一名外来者。");
    g_tipLine[3642] = StringToText("· 说书人仍会按你的真实角色正常唤醒你、处理能力和信息。");
    g_tipLine[3643] = StringToText("· 角色能力表中仍可查看所有角色；你自己的真实身份不会显示在个人信息里。");
    g_tipRoleAt[144] = 3637; g_tipRoleN[144] = 7;
    g_tipLine[3644] = StringToText("失忆的爪牙（爪牙）");
    g_tipLine[3645] = StringToText("【角色能力】");
    g_tipLine[3646] = StringToText("你只知道自己的角色类型是爪牙。真实角色名只有说书人知道。");
    g_tipLine[3647] = StringToText("【角色简介】");
    g_tipLine[3648] = StringToText("你的真实角色可能是全员追忆角色池中的任意一名爪牙。");
    g_tipLine[3649] = StringToText("· 说书人仍会按你的真实角色正常唤醒你、处理能力和信息。");
    g_tipLine[3650] = StringToText("· 角色能力表中仍可查看所有角色；你自己的真实身份不会显示在个人信息里。");
    g_tipRoleAt[145] = 3644; g_tipRoleN[145] = 7;
    g_tipLine[3651] = StringToText("失忆的恶魔（恶魔）");
    g_tipLine[3652] = StringToText("【角色能力】");
    g_tipLine[3653] = StringToText("你只知道自己的角色类型是恶魔。真实角色名只有说书人知道。");
    g_tipLine[3654] = StringToText("【角色简介】");
    g_tipLine[3655] = StringToText("你的真实角色可能是全员追忆角色池中的任意一名恶魔。");
    g_tipLine[3656] = StringToText("· 说书人仍会按你的真实角色正常唤醒你、处理能力和信息。");
    g_tipLine[3657] = StringToText("· 角色能力表中仍可查看所有角色；你自己的真实身份不会显示在个人信息里。");
    g_tipRoleAt[146] = 3651; g_tipRoleN[146] = 7;
    g_tipLine[3658] = StringToText("限（爪牙）");
    g_tipLine[3659] = StringToText("【角色能力】");
    g_tipLine[3660] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipLine[3661] = StringToText("【角色简介】");
    g_tipLine[3662] = StringToText("限会让镇民玩家集体中毒。");
    g_tipLine[3663] = StringToText("· 限会让所有镇民玩家中毒一个夜晚和一个白天。能力生效夜晚和初始加入游戏的外来者数量相同。");
    g_tipLine[3664] = StringToText("· 限可以让任意数量的外来者加入游戏。如果游戏过程中外来者数量发生变化，生效夜晚仍按初始数量计算。");
    g_tipLine[3665] = StringToText("· 限需要存活，能力才能生效。");
    g_tipLine[3666] = StringToText("【规则细节】");
    g_tipLine[3667] = StringToText("· 在和初始外来者数量相同的夜晚，在魔典中央放置「大限将至」，所有镇民玩家中毒。");
    g_tipLine[3668] = StringToText("· 设置时，可以加入或移除任意数量的外来者角色，确认角色标记总数与玩家数量匹配。");
    g_tipLine[3669] = StringToText("· 「大限将至」在下一个黄昏移除，届时钟民玩家恢复健康。");
    g_tipRoleAt[147] = 3658; g_tipRoleN[147] = 12;
    g_tipLine[3670] = StringToText("【角色能力】");
    g_tipLine[3671] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：你转变为他的阵营，即使你已醉酒或中毒，但你不知道你转变后的阵营。");
    g_tipLine[3672] = StringToText("【角色简介】");
    g_tipLine[3673] = StringToText("食人魔是某人最好的朋友。选定朋友后，食人魔会立即加入朋友当时的阵营，即使他在选择时醉酒或中毒也是如此。");
    g_tipLine[3674] = StringToText("【规则细节】");
    g_tipLine[3675] = StringToText("· 说书人不会主动告知食人魔转变后的阵营。食人魔始终与被「挚友」标记的玩家同阵营，朋友阵营变化时会跟着变化。");
    g_tipLine[3676] = StringToText("· 如果食人魔中途被创造，他在当晚完成选择。「挚友」标记会自动放在被选择的玩家旁。");
    g_tipRoleAt[148] = 4191; g_tipRoleN[148] = 18;
    g_tipLine[3677] = StringToText("【角色能力】");
    g_tipLine[3678] = StringToText("每个白天，你可以公开进行一次谁是爪牙，谁是恶魔的猜测。如果你猜对，善良阵营获胜。");
    g_tipLine[3679] = StringToText("【角色简介】");
    g_tipLine[3680] = StringToText("戏法师希望一次性指出所有爪牙和恶魔。猜测必须公开，可以包含多名爪牙和多只恶魔。");
    g_tipLine[3681] = StringToText("【规则细节】");
    g_tipLine[3682] = StringToText("· 每个白天最多提交一次猜测，可以放弃当天机会；提交后不能修改或再次猜测。");
    g_tipLine[3683] = StringToText("· 死亡角色仍参与判断；军团按恶魔判断，邪恶旅行者不参与判断。中毒或醉酒的戏法师即使猜对也不会获胜。");
    g_tipRoleAt[149] = 6211; g_tipRoleN[149] = 18;
    g_tipLine[3684] = StringToText("【角色能力】");
    g_tipLine[3685] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");
    g_tipLine[3686] = StringToText("【角色简介】");
    g_tipLine[3687] = StringToText("召唤师在开局时占用恶魔的位置，但场上没有恶魔；第三个夜晚他会创造一只新的恶魔。");
    g_tipLine[3688] = StringToText("【规则细节】");
    g_tipLine[3689] = StringToText("· 配板时移除初始恶魔并用一名镇民替换，不把恶魔转化成爪牙。前两夜没有恶魔也不会因此结束游戏。");
    g_tipLine[3690] = StringToText("· 新恶魔在召唤当晚即可行动。召唤师在成功创造恶魔前死亡，或第三夜无法创造恶魔时，善良阵营获胜。");
    g_tipRoleAt[150] = 3684; g_tipRoleN[150] = 7;
    g_tipLine[3691] = StringToText("【角色能力】");
    g_tipLine[3692] = StringToText("每个夜晚，你要选择一个镇民角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[3693] = StringToText("【角色简介】");
    g_tipLine[3694] = StringToText("熊孩子会指定一个镇民角色，让该角色对应的玩家直到下个黄昏前都只能产生错误信息。");
    g_tipLine[3695] = StringToText("【规则细节】");
    g_tipLine[3696] = StringToText("· 选择的是角色而不是玩家；只影响真实拥有该角色的玩家，不影响仅借用该能力的玩家。");
    g_tipLine[3697] = StringToText("· 选中角色后来才进场时仍会获得捣蛋效果；下个黄昏、熊孩子死亡或离场时移除。");
    g_tipRoleAt[151] = 7336; g_tipRoleN[151] = 18;
    g_tipLine[3698] = StringToText("【角色能力】");
    g_tipLine[3699] = StringToText("恶魔知道书生在场。每局游戏限一次，恶魔可以拜访说书人并猜测你是书生。如果恶魔猜测正确，即使你已死亡，当晚该恶魔可以选择一名玩家：他死亡。");
    g_tipLine[3700] = StringToText("【角色简介】");
    g_tipLine[3701] = StringToText("本图由说书人手动处理拜访和猜测；正确的恶魔获得「已猜测」token，并在书生夜序获得一次额外攻击。");
    g_tipLine[3702] = StringToText("【规则细节】");
    g_tipLine[3703] = StringToText("· 说书人把已猜测 token 放在正确猜测的玩家身上；当晚该玩家在书生夜序选择一名玩家死亡。");
    g_tipLine[3704] = StringToText("· 该死亡不算恶魔攻击；点击进入白天时移除已猜测 token。");
    g_tipLine[3705] = StringToText("· 首夜到达书生顺位时，所有恶魔都会得知书生在场；不会唤醒书生本人。");
    g_tipRoleAt[152] = 3698; g_tipRoleN[152] = 8;
    g_tipLine[3706] = StringToText("狐媚娘（爪牙）");
    g_tipLine[3707] = StringToText("【角色能力】");
    g_tipLine[3708] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道狐媚娘在场。如果你死于处决，当晚他转变为邪恶阵营。");
    g_tipLine[3709] = StringToText("【角色简介】");
    g_tipLine[3710] = StringToText("狐媚娘会魅惑她中意的玩家使其加入邪恶阵营……以自身死亡为代价。");
    g_tipLine[3711] = StringToText("【规则细节】");
    g_tipLine[3712] = StringToText("· 狐媚娘恢复清醒健康后，受选者会立即得知狐媚娘在场；若狐媚娘死因是处决，受选者当晚转为邪恶，已经是邪恶时无事发生。");
    g_tipRoleAt[153] = 3706; g_tipRoleN[153] = 7;
    g_tipLine[3713] = StringToText("饕餮（恶魔）");
    g_tipLine[3714] = StringToText("【角色能力】");
    g_tipLine[3715] = StringToText("每个夜晚*，你要选择任意数量的非旅行者玩家或一名旅行者玩家：如果他们的角色类型均不相同，他们死亡。[+1外来者]");
    g_tipLine[3716] = StringToText("【角色简介】");
    g_tipLine[3717] = StringToText("饕餮食量惊人，有的时候它会在夜里大肆杀戮来满足自己无尽的饥饿。");
    g_tipLine[3718] = StringToText("【规则细节】");
    g_tipLine[3719] = StringToText("· 可以不选择任何玩家；所有目标的角色类型均不相同时才全部死亡，哪怕只有两名目标类型相同也会无人死亡。");
    g_tipLine[3720] = StringToText("· 死亡按选择顺序结算；若中途饕餮醉酒或中毒，后续目标不再死亡。选择旅行者时不能再选择其他玩家。");
    g_tipRoleAt[154] = 3713; g_tipRoleN[154] = 8;
    g_tipLine[3721] = StringToText("画皮（爪牙）");
    g_tipLine[3722] = StringToText("【角色能力】");
    g_tipLine[3723] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。当他下一次即将死亡时，他重生，随后你重获能力。");
    g_tipLine[3724] = StringToText("【角色简介】");
    g_tipLine[3725] = StringToText("画皮迅速并秘密地进行攻击，神不知鬼不觉，时刻觊觎着下一个目标。");
    g_tipLine[3726] = StringToText("【规则细节】");
    g_tipLine[3727] = StringToText("· 被画皮攻击者进入活尸状态：广场显示存活，实际上已死亡。攻击被保护完全阻止时不会形成活尸，而是保持存活。");
    g_tipLine[3728] = StringToText("· 目标下一次即将死亡时，画皮阻止死亡并复活他，随后重获能力。若画皮因任何原因无法阻止这次死亡，则不能复活，也不会重获能力。");
    g_tipRoleAt[155] = 3721; g_tipRoleN[155] = 8;
    g_tipLine[3729] = StringToText("【角色能力】");
    g_tipLine[3730] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有邪恶玩家的能力选择或影响了他们之中的玩家。");
    g_tipLine[3731] = StringToText("【角色简介】");
    g_tipLine[3732] = StringToText("引路人能够判断，今晚自己关注的人是否卷入了邪恶能力的行动。");
    g_tipLine[3733] = StringToText("【规则细节】");
    g_tipLine[3734] = StringToText("· 可以选择零至三名不同的玩家，但不能选择自己；选择零名玩家时说书人通常回答「否」。");
    g_tipLine[3735] = StringToText("· 任一所选玩家被邪恶玩家的能力选择或实际影响，答案就是「是」；单纯向他展示角色或公开信息不算影响。");
    g_tipLine[3736] = StringToText("· 即使邪恶玩家使用的是从善良角色获得的能力，也按邪恶玩家造成的影响判断。");
    g_tipRoleAt[156] = 7958; g_tipRoleN[156] = 19;
    g_tipLine[3737] = StringToText("【角色能力】");
    g_tipLine[3738] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择邪恶玩家时会改为选中你，即使你已死亡。");
    g_tipLine[3739] = StringToText("【角色简介】");
    g_tipLine[3740] = StringToText("使节容易成为邪恶能力的目标；他的能力可以把一次指向邪恶玩家的选择改写为指向自己。");
    g_tipLine[3741] = StringToText("【规则细节】");
    g_tipLine[3742] = StringToText("· 由说书人决定是否触发；如果本次不触发，同一晚后续仍可能再次询问。");
    g_tipLine[3743] = StringToText("· 每晚最多触发一次；实际触发后，直到天亮都不会再次改写选择。");
    g_tipLine[3744] = StringToText("· 使节即使已经死亡，仍可成为被改写后的目标；使节中毒或醉酒时能力失效。");
    g_tipRoleAt[157] = 3737; g_tipRoleN[157] = 8;
    g_tipLine[3745] = StringToText("【角色能力】");
    g_tipLine[3746] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名邪恶玩家作为替代。");
    g_tipLine[3747] = StringToText("【角色简介】");
    g_tipLine[3748] = StringToText("半仙会把针对自己的选择暗中转移到一名邪恶玩家身上。");
    g_tipLine[3749] = StringToText("【规则细节】");
    g_tipLine[3750] = StringToText("· 只有夜晚、并且能力本身需要选择目标时触发；无需选择的被动能力不会改变目标。");
    g_tipLine[3751] = StringToText("· 只把选中半仙的那一个目标槽改为说书人选择的邪恶玩家，其他目标不变，也不能造成重复目标。");
    g_tipLine[3752] = StringToText("· 新的目标可以是已经死亡的邪恶玩家，也可以是原能力使用者本人；若没有其他合法邪恶目标，原选择保持不变。");
    g_tipRoleAt[158] = 7977; g_tipRoleN[158] = 37;
    g_tipLine[3753] = StringToText("【角色能力】");
    g_tipLine[3754] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    g_tipLine[3755] = StringToText("【角色简介】");
    g_tipLine[3756] = StringToText("掮客促成两名同阵营玩家合作，让其他玩家在夜间做出的选择在两人之间转移。");
    g_tipLine[3757] = StringToText("【规则细节】");
    g_tipLine[3758] = StringToText("· 只有夜晚、并且能力本身需要选择目标时才会转移；无需选择的被动能力不受影响。");
    g_tipLine[3759] = StringToText("· 如果选择中包含陌客、间谍等干扰身份，由说书人决定这次掮客是否发动。");
    g_tipLine[3760] = StringToText("· 掮客选中两名同阵营玩家后，当晚每次选择其中一人的能力都会转到另一人；换目标不会通知原玩家。");
    g_tipRoleAt[159] = 8014; g_tipRoleN[159] = 23;
    g_tipLine[3761] = StringToText("【角色能力】");
    g_tipLine[3762] = StringToText("与你邻近的善良玩家（旅行者除外）之一醉酒，即使你死于处决。");
    g_tipLine[3763] = StringToText("【角色简介】");
    g_tipLine[3764] = StringToText("酒保会让一名邻近的善良玩家持续醉酒。");
    g_tipLine[3765] = StringToText("【规则细节】");
    g_tipLine[3766] = StringToText("· 开局配板时从酒保两侧的善良玩家中随机选定一名；目标可以已经死亡，地图不会弹出选择面板。");
    g_tipLine[3767] = StringToText("· 酒保死亡不会移除这份醉酒；酒保中毒、醉酒或失去能力时移除。");
    g_tipLine[3768] = StringToText("· 醉酒的玩家转为邪恶后会移除醉酒；出现新的酒保时，按新的相邻关系重新选择。");
    g_tipRoleAt[160] = 3761; g_tipRoleN[160] = 8;
    g_tipLine[3769] = StringToText("【角色能力】");
    g_tipLine[3770] = StringToText("每个夜晚，当有邪恶玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，且你会得知你的能力被触发。");
    g_tipLine[3771] = StringToText("【角色简介】");
    g_tipLine[3772] = StringToText("和尚庇护邻座玩家，使第一次威胁到他们的邪恶能力失效。");
    g_tipLine[3773] = StringToText("【规则细节】");
    g_tipLine[3774] = StringToText("· 每个夜晚只能触发一次；只能阻止即将开始生效的能力，不能撤销已经生效的效果。");
    g_tipLine[3775] = StringToText("· 持续型能力会被压制到下一个黎明；刺客等明确无法被阻止的效果不会触发和尚。");
    g_tipLine[3776] = StringToText("· 和尚只会得知自己的能力被触发，不会得知来源或受影响的具体玩家。");
    g_tipRoleAt[161] = 8037; g_tipRoleN[161] = 31;
    g_tipLine[3777] = StringToText("【角色能力】");
    g_tipLine[3778] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的镇民玩家的角色，他中毒且可能被当作邪恶的蛊雕，直到下个黄昏。每局游戏限一次，在夜晚时，你可以改变方向。");
    g_tipLine[3779] = StringToText("【角色简介】");
    g_tipLine[3780] = StringToText("蛊雕停留在镇民之中，沿座位顺序散布蛊毒并扰乱目标的身份登记。");
    g_tipLine[3781] = StringToText("【规则细节】");
    g_tipLine[3782] = StringToText("· 只按当前真实角色类型寻找存活镇民；目标阵营变为邪恶仍算镇民，角色类型改变或死亡则跳过。");
    g_tipLine[3783] = StringToText("· 蛊毒持续到下个黄昏；目标死亡或不再是镇民时标记不会自动转移。");
    g_tipLine[3784] = StringToText("· 蛊毒包含互动干扰：查验时可被当作邪恶的蛊雕，但蛊雕不会因此真正获得蛊雕角色或邪恶阵营。");
    g_tipLine[3785] = StringToText("· 每局可成功改变一次方向；从逆时针方向寻找下一名存活镇民，之后持续使用该方向。");
    g_tipLine[3786] = StringToText("· 相克：蛊雕会跳过魔术师；食人魔把蛊毒目标当作邪恶的蛊雕时会得知自己转变为邪恶。");
    g_tipRoleAt[162] = 3777; g_tipRoleN[162] = 10;
    g_tipLine[3787] = StringToText("典狱长（恶魔）");
    g_tipLine[3788] = StringToText("【角色能力】");
    g_tipLine[3789] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，当晚他们之中会有一名玩家死亡。");
    g_tipLine[3790] = StringToText("【角色简介】");
    g_tipLine[3791] = StringToText("典狱长对“有罪之人”做出判罚，以连坐或择其一的方式。");
    g_tipLine[3792] = StringToText("【规则细节】");
    g_tipLine[3793] = StringToText("· 上一批中有人白天死于处决时，除该死者外的其他上一批玩家当晚死亡。");
    g_tipLine[3794] = StringToText("· 若上一批无人死于处决，说书人在技能目标面板中选择一名上一批仍能死亡的玩家；该玩家死亡并打上「死亡（典狱长）」，这不是本夜新选择的判罚目标。");
    g_tipLine[3795] = StringToText("· 相克：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipRoleAt[163] = 3787; g_tipRoleN[163] = 9;
    g_tipAbility[126] = StringToText("与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1 外来者]");
    g_tipAbility[127] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。所有玩家都知道利维坦在场。持有第五天提示时，进入夜晚、第五天之后的白天或恢复能力时能力生效则邪恶阵营获胜。");
    // ---- 【心理博弈 XI】官网角色能力文本覆盖 ----
    g_tipAbility[90] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。 每当你得知的玩家死亡，你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipAbility[76] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipAbility[125] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipAbility[26] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会醉酒到下个黄昏。");
    g_tipAbility[27] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipAbility[107] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，并且当晚恶魔不会造成死亡。 会有一名善良玩家始终被当作邪恶阵营。");
    g_tipAbility[52] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipAbility[28] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipAbility[128] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipAbility[55] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipAbility[129] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipAbility[130] = StringToText("这个剧本包含有自制角色或自制规则。");
    g_tipAbility[74] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipAbility[147] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipAbility[12] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。 如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipAbility[15] = StringToText("你可能会被当作邪恶阵营、爪牙角色或恶魔角色，即使你已死亡。");
    g_tipAbility[36] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是善良的，在当晚他会死亡。");
    g_tipAbility[35] = StringToText("你随时可能死亡。");
    g_tipAbility[120] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipAbility[17] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipAbility[39] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。 如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipAbility[41] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipAbility[67] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipAbility[75] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipAbility[46] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。 如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipAbility[69] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。 被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipAbility[127] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。 所有玩家都知道利维坦在场。在第五个白天结束时，邪恶阵营获胜。");
    g_tipStN = 18;
    g_tipStLine[0] = StringToText("·作为说书人，你需要主持本局比赛：在右上角") + TextWithColor(StringToText("【魔典】"), Color(255, 215, 60)) + StringToText("可以为玩家发放身份。");
    g_tipStLine[1] = StringToText("·按照夜间顺序表，依次用") + TextWithColor(StringToText("【唤醒】"), Color(255, 215, 60)) + StringToText("按钮唤醒玩家，让他们发动技能，");
    g_tipStLine[2] = StringToText("  再通过私聊把信息告诉他们。");
    g_tipStLine[3] = StringToText("·对于一些互不影响的角色，你可以同时唤醒他们、一起给出信息，");
    g_tipStLine[4] = StringToText("  免得他们靠行动时长去揣测别人的身份。");
    g_tipStLine[5] = StringToText("·在游戏的首个夜晚，记得告知") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("他们的队友是谁，");
    g_tipStLine[6] = StringToText("  并在右下角给恶魔 3 个不在场身份。");
    g_tipStLine[7] = StringToText("·在游戏的白天控制好聊天时长，并通过左上角的计时器提醒所有玩家。");
    g_tipStLine[8] = StringToText("·一些角色行动后会产生 token，记得为他们打上。");
    g_tipStLine[9] = StringToText("·在夜晚死亡的玩家，要在白天用") + TextWithColor(StringToText("【死亡标记】"), Color(255, 215, 60)) + StringToText("公布他的死亡；");
    g_tipStLine[10] = StringToText("  公布之前，先为他打上") + TextWithColor(StringToText("【死亡类型】"), Color(255, 215, 60)) + StringToText("的 token。");
    g_tipStLine[11] = StringToText("·") + TextWithColor(StringToText("【死亡类型】"), Color(255, 215, 60)) + StringToText("的 token 非常重要 ---- 角色的技能判定要读它。");
    g_tipStLine[12] = StringToText("·例：") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("被打上") + TextWithColor(StringToText("【死亡（处决）】"), Color(255, 215, 60)) + StringToText("的 token 不会触发传位；");
    g_tipStLine[13] = StringToText("  被打上") + TextWithColor(StringToText("【死亡（小恶魔）】"), Color(255, 215, 60)) + StringToText("的 token 才会触发。");
    g_tipStLine[14] = StringToText("·白天得票最多、被标记待处决的玩家，请用") + TextWithColor(StringToText("【处决标记】"), Color(255, 215, 60)) + StringToText("处决他；");
    g_tipStLine[15] = StringToText("  这个按钮会自动打上") + TextWithColor(StringToText("【死亡（处决）】"), Color(255, 215, 60)) + StringToText("的 token。");
    g_tipStLine[16] = StringToText("·作为一个合格的说书人，要合理地给予恰当的信息、平衡当前局势，");
    g_tipStLine[17] = StringToText("  主持一场精彩的对局。");

    g_tipLine[7354] = StringToText("【角色能力】");
    g_tipLine[7355] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipLine[7356] = StringToText("【角色简介】");
    g_tipLine[7357] = StringToText("投毒者能秘密地干扰其他角色的能力。");
    g_tipLine[7358] = StringToText("· 每个夜晚，投毒者会选择一名玩家在当晚的剩余时间和接下来的一整个白天阶段里中毒。");
    g_tipLine[7359] = StringToText("· 中毒的玩家会失去能力，但说书人会装作他仍具有能力。他的能力不会真实地影响游戏。");
    g_tipLine[7360] = StringToText("  为了保证中毒的玩家处于未中毒的幻象中，说书人会在正确的时间下唤醒他，并如同他未中毒一样走过场来执行他的能力。");
    g_tipLine[7361] = StringToText("  如果中毒玩家的角色能力能够获取信息，说书人可以给他提供错误信息。");
    g_tipLine[7362] = StringToText("· 如果一名中毒的玩家在他中毒的期间里使用了「每局游戏限一次」的能力，他无法再次使用这项能力。");
    g_tipLine[7363] = StringToText("【规则细节】");
    g_tipLine[7364] = StringToText("· 虽然投毒者的能力描述中，中毒的持续时间看似与水手和旅店老板等有所差别，但实际上这只是为了新手玩家便于理解，");
    g_tipLine[7365] = StringToText("  而不用特意引出「黄昏」这个概念。实际上，投毒者的能力描述同样可以写为：「每个夜晚，你要选择一名玩家：");
    g_tipLine[7366] = StringToText("  他会中毒到下个黄昏。」");
    g_tipRoleAt[17] = 7354; g_tipRoleN[17] = 13;
    g_tipLine[7367] = StringToText("【角色能力】");
    g_tipLine[7368] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipLine[7369] = StringToText("【角色简介】");
    g_tipLine[7370] = StringToText("间谍知道所有人的具体角色。间谍看起来像是善良一员，但实际上是邪恶的。");
    g_tipLine[7371] = StringToText("· 如果任何角色的能力会探查或影响善良玩家，间谍可能会被那名角色当作善良阵营。");
    g_tipLine[7372] = StringToText("  如果任何角色的能力会探查或影响镇民角色或外来者角色，间谍可能会被那名角色当作是一个特定的镇民或外来者角色。");
    g_tipLine[7373] = StringToText("  由说书人来决定间谍被当作什么，在同一个夜晚间谍能被多次当作不同阵营或不同的角色。");
    g_tipLine[7374] = StringToText("· 间谍在被当作特定的镇民或外来者角色时，不会获得这一角色的能力。例如，被当作猎手的间谍无法猎杀恶魔。");
    g_tipLine[7375] = StringToText("【规则细节】");
    g_tipLine[7376] = StringToText("· 间谍有很多「可以但不建议」的内容，希望各位说书人在有间谍在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[7377] = StringToText("· 说书人不应该利用间谍能够被当作任意角色或阵营这一点，来将间谍在魔典中的角色标记替换成其他角色标记，");
    g_tipLine[7378] = StringToText("  以此向能够查看魔典的角色传递额外的信息。邪恶玩家之间的交流需要玩家自己自发进行，而且需要让善良玩家有迹可循。");
    g_tipLine[7379] = StringToText("· 间谍的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，");
    g_tipLine[7380] = StringToText("  那么间谍是有可能被当作「善良的间谍」或者是「邪恶的镇民」的（如食人族）。");
    g_tipLine[7381] = StringToText("· 养成良好的魔典使用习惯非常重要。这不仅仅是在有间谍或是寡妇的时候能确保他们获得正确的信息，");
    g_tipLine[7382] = StringToText("  也是对说书人记录繁杂的游戏信息并确保各项处理结算无误的重要支撑。必要时，");
    g_tipLine[7383] = StringToText("  说书人还应该利用提示标记以外的其他方式去记录信息，但这些信息不会被间谍得知。在线上游戏中，");
    g_tipLine[7384] = StringToText("  间谍不应该也无法看到说书人做的任何自定义笔记。");
    g_tipLine[7385] = StringToText("· 如果说书人觉得自己的某些提示标记处理可能与常规处理方式不同，想办法在白天时私下与间谍沟通（例如夜晚拍醒他并用手机");
    g_tipLine[7386] = StringToText("  打字示意让他白天来私聊你）来确保间谍正确理解了你魔典里的提示标记的位置和放置逻辑。");
    g_tipLine[7387] = StringToText("· 恶魔的三个不在场善良角色（即伪装）是否出现在魔典中，取决于说书人是否将伪装在展示给恶魔之后放在魔典中或放回剧本盒");
    g_tipLine[7388] = StringToText("  （剧本盒也位于魔典内的左侧下方，用于收纳不在场的角色和提示标记，但这些标记不会平铺在魔典左侧）。");
    g_tipLine[7389] = StringToText("  如果说书人选择在展示完后放回剧本盒，则间谍无法看到这一信息。");
    g_tipLine[7390] = StringToText("· 间谍查看魔典时，除去角色标记和提示标记之外，还能查看玩家的阵营。对于非旅行者角色标记，");
    g_tipLine[7391] = StringToText("  正面放置代表该玩家阵营与其角色初始阵营相同，倒转放置代表该玩家阵营与其角色初始阵营不同。对于旅行者角色标记，");
    g_tipLine[7392] = StringToText("  正面放置代表该玩家为善良阵营，倒转放置代表该玩家为邪恶阵营。");
    g_tipLine[7393] = StringToText("· 仅在暗流涌动这一剧本的实体版本中，间谍的夜晚顺序位于投毒者（首夜）和僧侣（非首夜）之后（与常规顺序的区别在于，");
    g_tipLine[7394] = StringToText("  不会看到小恶魔的「死亡」标记和管家的「主人」标记，且在小恶魔自杀的那个夜晚，自己变成小恶魔之前仍能查看魔典）。");
    g_tipLine[7395] = StringToText("  这是为了避免新人玩家在一开始接触到间谍这一需要处理大量信息的角色显得棘手，而避免了冗杂信息的发生。");
    g_tipLine[7396] = StringToText("  同时也给出了足够的时间允许间谍在入睡后继续进行思考。（如果间谍在管家之后被唤醒，");
    g_tipLine[7397] = StringToText("  则有可能会因为查看魔典的时间太长而被管家玩家意识到场上可能有间谍。）当玩家熟悉游戏之后，");
    g_tipLine[7398] = StringToText("  间谍还是应当参考线上魔典的顺序，在将近黎明的时候被唤醒。");
    g_tipLine[7399] = StringToText("· 查看魔典也属于「获取信息」。如果间谍醉酒或中毒，说书人对他展示的魔典内容可能会是错误的。");
    g_tipLine[7400] = StringToText("· 相克规则：");
    g_tipLine[7401] = StringToText("  · 魔术师：当间谍查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_tipLine[7402] = StringToText("  · 炼金术士：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。每次处决后，");
    g_tipLine[7403] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[7404] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_tipLine[7405] = StringToText("  · 落难少女：如果间谍正在场或曾经在场，落难少女中毒。");
    g_tipLine[7406] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7407] = StringToText("  · 瘟疫医生：如果说书人本应获得间谍的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[7408] = StringToText("  · 食人魔：间谍必定被食人魔当作邪恶阵营。");
    g_tipLine[7409] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7410] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7411] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[18] = 7367; g_tipRoleN[18] = 45;
    g_tipLine[7412] = StringToText("【角色能力】");
    g_tipLine[7413] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipLine[7414] = StringToText("【角色简介】");
    g_tipLine[7415] = StringToText("红唇女郎会在恶魔死亡时变成恶魔。");
    g_tipLine[7416] = StringToText("· 如果在恶魔死前有五名或更多的玩家存活；或者说，如果在恶魔死后有四名或更多的玩家存活，那么红唇女郎会立刻变成恶魔，");
    g_tipLine[7417] = StringToText("  游戏会如同恶魔尚未死亡一样继续进行。");
    g_tipLine[7418] = StringToText("· 当红唇女郎的能力触发时，旅行者的数量不会计算在内。");
    g_tipLine[7419] = StringToText("· 如果在恶魔被处决时少于五名玩家存活，游戏会结束，并且善良阵营获胜。");
    g_tipLine[7420] = StringToText("· 如果在小恶魔选择自杀时，有五名或更多的玩家存活，必须是由红唇女郎来变成新的小恶魔。（前提是，");
    g_tipLine[7421] = StringToText("  红唇女郎此时能力正常生效）");
    g_tipLine[7422] = StringToText("· 如果红唇女郎变成了恶魔，她在各种意义上都会成为恶魔。如果她被处决，善良阵营会获胜。她会在每个晚上攻击玩家。");
    g_tipLine[7423] = StringToText("  她被当作恶魔。");
    g_tipLine[7424] = StringToText("【规则细节】");
    g_tipLine[7425] = StringToText("· 特定角色互动：");
    g_tipLine[7426] = StringToText("  · 痢蛭：当宿主死亡时，如果在宿主死亡之前，场上除旅行者外存活玩家人数为5人，红唇女郎不会因此变成痢蛭。");
    g_tipLine[7427] = StringToText("    因为在痢蛭死亡时，场上的存活玩家的人数已经不足5人。（宿主与痢蛭的死亡并非同时进行的）");
    g_tipLine[7428] = StringToText("· 相克规则：");
    g_tipLine[7429] = StringToText("  · 瘟疫医生：如果说书人本应获得红唇女郎的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[7430] = StringToText("  · 哈迪寂亚：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[7431] = StringToText("  · 小怪宝：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[7432] = StringToText("  · 方古：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[7433] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7434] = StringToText("  · 梼杌：红唇女郎在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[7435] = StringToText("  · 入殓师：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[7436] = StringToText("  · 孟婆：如果恶魔选择死亡且红唇女郎即将变成恶魔，改为恶魔与红唇女郎交换角色，随后原恶魔死亡。");
    g_tipRoleAt[19] = 7412; g_tipRoleN[19] = 25;
    g_tipLine[7437] = StringToText("【角色能力】");
    g_tipLine[7438] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipLine[7439] = StringToText("【角色简介】");
    g_tipLine[7440] = StringToText("男爵会改变在场的外来者数量。");
    g_tipLine[7441] = StringToText("· 外来者的数量变化会发生在初始设置时，且不会因为男爵死亡而恢复成原本的数量。对角色在初始设置时的更改，");
    g_tipLine[7442] = StringToText("  而在游戏过程中不产生影响的能力，都会在角色列表和角色标记上以方括号标注在角色描述的末尾——就像[这样]。");
    g_tipLine[7443] = StringToText("· 增加的外来者角色总是会替换掉原本的镇民角色，而不是其他角色类型。");
    g_tipLine[7444] = StringToText("【规则细节】");
    g_tipLine[7445] = StringToText("· 相克规则：");
    g_tipLine[7446] = StringToText("  · 瘟疫医生：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[7447] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[20] = 7437; g_tipRoleN[20] = 11;
    g_tipLine[7448] = StringToText("【角色能力】");
    g_tipLine[7449] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。 如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：");
    g_tipLine[7450] = StringToText("  他死亡。[-1或+1外来者]");
    g_tipLine[7451] = StringToText("【角色简介】");
    g_tipLine[7452] = StringToText("教父会在小镇杀害外来者时进行报复。");
    g_tipLine[7453] = StringToText("· 每当一名外来者死于处决，教父会在当晚选择一名玩家，使其死亡。");
    g_tipLine[7454] = StringToText("· 只有外来者在白天死去时，教父才能杀死玩家。夜晚死亡的外来者不算在内。");
    g_tipLine[7455] = StringToText("· 如果教父在场，会在场上增加或减少一个外来者。");
    g_tipLine[7456] = StringToText("· 在游戏开始时，教父会得知哪些外来者在场。");
    g_tipLine[7457] = StringToText("· 如果今天白天有两名外来者玩家死亡，当晚教父仍然只能杀死一名玩家。");
    g_tipLine[7458] = StringToText("【规则细节】");
    g_tipLine[7459] = StringToText("· 相克规则：");
    g_tipLine[7460] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7461] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7462] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[39] = 7448; g_tipRoleN[39] = 15;
    g_tipLine[7463] = StringToText("【角色能力】");
    g_tipLine[7464] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipLine[7465] = StringToText("【角色简介】");
    g_tipLine[7466] = StringToText("魔鬼代言人能在处决中拯救玩家。");
    g_tipLine[7467] = StringToText("· 每个夜晚，魔鬼代言人需要选择一名存活的玩家，保护他不会因处决而死亡。在下一个白天，如果该玩家被处决，");
    g_tipLine[7468] = StringToText("  处决会成功但该玩家依然存活。");
    g_tipLine[7469] = StringToText("· 魔鬼代言人不能连续两个夜晚选择同一名玩家，无论该玩家是否从处决中被救出，");
    g_tipLine[7470] = StringToText("  并且魔鬼代言人也不能选择被当作死亡的僵怖。");
    g_tipLine[7471] = StringToText("【规则细节】");
    g_tipLine[7472] = StringToText("无");
    g_tipRoleAt[40] = 7463; g_tipRoleN[40] = 10;
    g_tipLine[7473] = StringToText("【角色能力】");
    g_tipLine[7474] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipLine[7475] = StringToText("【角色简介】");
    g_tipLine[7476] = StringToText("刺客能杀死恶魔解决不掉的麻烦角色。");
    g_tipLine[7477] = StringToText("· 每局游戏限一次，在夜晚，刺客能杀死一名玩家。即使该玩家受到了包括角色能力在内的任何方式的保护而免于死亡，");
    g_tipLine[7478] = StringToText("  也依然会死亡。");
    g_tipLine[7479] = StringToText("· 刺客的能力如常受到醉酒和中毒的影响。");
    g_tipLine[7480] = StringToText("· 如果刺客攻击了莽夫，莽夫会死去并转变为邪恶阵营。");
    g_tipLine[7481] = StringToText("· 如果刺客攻击了尚未触发能力的僵怖（不论因为什么理由），僵怖会死去，但在死后触发能力且仍存活。");
    g_tipLine[7482] = StringToText("【规则细节】");
    g_tipLine[7483] = StringToText("无额外规则。");
    g_tipRoleAt[41] = 7473; g_tipRoleN[41] = 11;
    g_tipLine[7484] = StringToText("【角色能力】");
    g_tipLine[7485] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，");
    g_tipLine[7486] = StringToText("  他的阵营落败。");
    g_tipLine[7487] = StringToText("【角色简介】");
    g_tipLine[7488] = StringToText("主谋在恶魔死亡后仍然有方法获胜。");
    g_tipLine[7489] = StringToText("· 如果最后一名存活的恶魔死于处决，游戏继续。玩家们不会得知刚死去的是恶魔。在下一个白天，");
    g_tipLine[7490] = StringToText("  如果一名善良玩家被处决——无论该玩家是否死于处决——邪恶阵营获胜。如果一名邪恶玩家被处决，或者没有人被处决，");
    g_tipLine[7491] = StringToText("  则善良阵营获胜。");
    g_tipLine[7492] = StringToText("· 已死亡的恶魔无法进行攻击，如常失去自己的能力。在这个额外的夜晚和白天，其他角色的能力会正常生效。");
    g_tipLine[7493] = StringToText("· 如果恶魔死亡且只剩余两名存活玩家，游戏仍然会额外进行一天——邪恶阵营不会因为只剩两名存活玩家而获胜，");
    g_tipLine[7494] = StringToText("  而善良阵营也不会因为杀死了恶魔而获胜。主谋的能力为「额外进行一天一夜」，此能力会覆盖游戏常规规则。");
    g_tipLine[7495] = StringToText("【规则细节】");
    g_tipLine[7496] = StringToText("· 相克规则：");
    g_tipLine[7497] = StringToText("  · 哈迪寂亚：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：如果他们都选择存活，邪恶阵营获胜。");
    g_tipLine[7498] = StringToText("    否则，善良阵营获胜。");
    g_tipLine[7499] = StringToText("  · 痢蛭：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[7500] = StringToText("  · 炼金术士：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_tipLine[7501] = StringToText("  · 亡骨魔：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipLine[7502] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7503] = StringToText("  · 梼杌：主谋在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[7504] = StringToText("  · 姑获鸟：如果姑获鸟死亡，获得主谋能力的姑获鸟保留主谋的能力。");
    g_tipRoleAt[42] = 7484; g_tipRoleN[42] = 21;
    g_tipLine[7505] = StringToText("【角色能力】");
    g_tipLine[7506] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。 如果其中善良玩家被处决，邪恶阵营获胜。 如果你们都存活，");
    g_tipLine[7507] = StringToText("  善良阵营无法获胜。");
    g_tipLine[7508] = StringToText("【角色简介】");
    g_tipLine[7509] = StringToText("镜像双子会与对立阵营一人互为镜像，其他玩家不知道双子的正邪。");
    g_tipLine[7510] = StringToText("· 由说书人来选择镜像双子与一名对立阵营玩家配对，被选择的玩家是对立双子。");
    g_tipLine[7511] = StringToText("· 在首个夜晚，双子两人会被一同唤醒，并得知对方的角色。");
    g_tipLine[7512] = StringToText("· 如果双子中善良一方被处决，邪恶阵营获胜。如果邪恶一方被处决，游戏继续。死去的镜像双子会失去能力，");
    g_tipLine[7513] = StringToText("  如果在他死后处决善良双子，邪恶阵营不会获胜。");
    g_tipLine[7514] = StringToText("· 两个双子都存活时善良阵营无法获胜。此时即使恶魔死亡，游戏也会继续。善良阵营要杀死镜像双子以取得胜利。");
    g_tipLine[7515] = StringToText("· 如果一名善良玩家变成了镜像双子，他仍然是善良玩家，此时一名邪恶玩家成为他的对立双子。");
    g_tipLine[7516] = StringToText("  另一个双子是什么角色并不重要，真正重要的是他们的阵营，好人可以安全处决邪恶的双子，但如果处决的是善良的双子，");
    g_tipLine[7517] = StringToText("  邪恶阵营获胜。");
    g_tipLine[7518] = StringToText("· 如果两个双子都是相同阵营，则由说书人为镜像双子重新选择一名玩家成为对立双子。");
    g_tipLine[7519] = StringToText("【规则细节】");
    g_tipLine[7520] = StringToText("· 在游玩梦殒春宵剧本时，以上述运作方式来唤醒镜像双子与对立双子是没有任何问题的，");
    g_tipLine[7521] = StringToText("  但是这一方式在扩展到其他混合剧本的时候可能会出现问题。（例如镜像双子被传教士影响，");
    g_tipLine[7522] = StringToText("  或有涡流在场时炼金术士获得了镜像双子的能力，等等。）我们建议说书人在熟悉镜像双子的角色能力逻辑之后，");
    g_tipLine[7523] = StringToText("  分别单独唤醒镜像双子和其对立双子，并用原本的提示方式对两名玩家单独进行提示，而不是让他们进行眼神接触来确认。");
    g_tipLine[7524] = StringToText("· 相克规则：");
    g_tipLine[7525] = StringToText("  · 瘟疫医生：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[7526] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7527] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7528] = StringToText("  · 梼杌：镜像双子在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[7529] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7530] = StringToText("  · 姑获鸟：如果姑获鸟获得了镜像双子的能力，新对立双子会知道「姑获鸟在场」，但不会知道姑获鸟是谁。");
    g_tipRoleAt[64] = 7505; g_tipRoleN[64] = 26;
    g_tipLine[7531] = StringToText("【角色能力】");
    g_tipLine[7532] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipLine[7533] = StringToText("【角色简介】");
    g_tipLine[7534] = StringToText("女巫能诅咒玩家，被诅咒的玩家如果发起提名，就会被咒杀。");
    g_tipLine[7535] = StringToText("· 每个夜晚，女巫会选择一名玩家诅咒。那名玩家如果在下个白天提名了任何玩家，就会死亡。尽管如此，他的提名仍然生效。");
    g_tipLine[7536] = StringToText("· 女巫的诅咒只持续一个白天，但女巫可以每晚一次又一次地诅咒同一名玩家。");
    g_tipLine[7537] = StringToText("· 只剩三名玩家存活时，女巫的诅咒立即解除，女巫也无法再进行夜晚行动。");
    g_tipLine[7538] = StringToText("【规则细节】");
    g_tipLine[7539] = StringToText("无额外规则。");
    g_tipRoleAt[65] = 7531; g_tipRoleN[65] = 9;
    g_tipLine[7540] = StringToText("【角色能力】");
    g_tipLine[7541] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipLine[7542] = StringToText("【角色简介】");
    g_tipLine[7543] = StringToText("洗脑师促使玩家假装成与自己实际角色不同的角色。");
    g_tipLine[7544] = StringToText("· 洗脑师会选择让一名玩家「疯狂」地证明自己是某个镇民或外来者角色。被选择的玩家明天必须试图说服其他玩家相信他是这个");
    g_tipLine[7545] = StringToText("  角色，否则就会死亡。");
    g_tipLine[7546] = StringToText("· 简短的暗示不足以避免死亡。玩家必须付出努力说服其他玩家。虽然疯狂的玩家不会被强迫一定要说出他不想说的东西，");
    g_tipLine[7547] = StringToText("  但是如果说书人感受不到他的努力，他就会付出代价。");
    g_tipLine[7548] = StringToText("· 疯狂的邪恶玩家可能会以这种方式被处决，但「可能」意味着你可以选择不这么做，以防止邪恶玩家通过这种策略获胜。");
    g_tipLine[7549] = StringToText("· 像畸形秀演员一样，执行处决惩罚计入每天的处决限制。");
    g_tipLine[7550] = StringToText("【规则细节】");
    g_tipLine[7551] = StringToText("· 相克规则：");
    g_tipLine[7552] = StringToText("  · 哥布林：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipRoleAt[66] = 7540; g_tipRoleN[66] = 13;
    g_tipLine[7553] = StringToText("【角色能力】");
    g_tipLine[7554] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，");
    g_tipLine[7555] = StringToText("  当晚的死亡由说书人决定。");
    g_tipLine[7556] = StringToText("【角色简介】");
    g_tipLine[7557] = StringToText("麻脸巫婆能将玩家变为不同的角色。");
    g_tipLine[7558] = StringToText("· 除首个夜晚以外的每个夜晚，麻脸巫婆需要选择一名玩家和一个角色，那名玩家变为她选择的角色。");
    g_tipLine[7559] = StringToText("· 她无法创造重复角色，如果那个角色已在场，则无事发生。");
    g_tipLine[7560] = StringToText("【规则细节】");
    g_tipLine[7561] = StringToText("· 说书人应该如何处理「因为麻脸巫婆创造了恶魔」而导致的死亡：");
    g_tipLine[7562] = StringToText("  · 麻脸巫婆造成死亡的时间范围为当前剧本中首个能够造成死亡的恶魔行动开始前，到最后一个能够造成死亡的恶魔行动结束后。");
    g_tipLine[7563] = StringToText("  · 在这个期间，说书人能够自由决定是否让某名玩家死亡，或让被恶魔攻击的某名玩家存活。");
    g_tipLine[7564] = StringToText("  · 说书人在这个时间范围内，可以分别在不同的恶魔行动前或后多次执行造成或阻止死亡的效果。");
    g_tipLine[7565] = StringToText("  · 一旦说书人决定杀死某个还未唤醒的恶魔，这名恶魔玩家当晚就不会被唤醒。否则，就需要唤醒这名玩家。");
    g_tipLine[7566] = StringToText("    这对于在创造出哈迪寂亚等带有特殊效果的恶魔时非常重要。");
    g_tipLine[7567] = StringToText("  · 说书人只能造成更多的死亡或阻止原本要发生的死亡，其他类型的恶魔能力无法阻止，如普卡的中毒、哈迪寂亚的复活等。");
    g_tipLine[7568] = StringToText("  · 不建议说书人阻止恶魔成功攻击的玩家的死亡，并再自己决定让这名玩家死亡，因为这会造成更多的混乱。");
    g_tipLine[7569] = StringToText("    恶魔攻击后无法杀死某名玩家再由说书人决定杀死，这种情况不算在内。");
    g_tipLine[7570] = StringToText("  · 说书人造成的死亡视为麻脸巫婆造成，因此不会触发贤者、唱诗男孩等角色的能力，");
    g_tipLine[7571] = StringToText("    也能够成功杀死士兵（如果麻脸巫婆没有照看小怪宝的话）。");
    g_tipLine[7572] = StringToText("  · 只要麻脸巫婆创造了恶魔，即使在那之后麻脸巫婆离场、失去能力或死亡，当晚说书人仍然可以决定造成或阻止死亡。");
    g_tipLine[7573] = StringToText("  · 说书人只能阻止恶魔造成的死亡，由非恶魔玩家造成的死亡无法阻止。");
    g_tipLine[7574] = StringToText("· 相克规则：");
    g_tipLine[7575] = StringToText("  · 村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，村夫的醉酒效果可能会更换目标。");
    g_tipLine[7576] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7577] = StringToText("  · 落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[7578] = StringToText("  · 异教领袖/政客/莽夫/食人魔：被麻脸巫婆创造的邪恶异教领袖/政客/莽夫/食人魔无法因为自身能力转变为善良阵营。");
    g_tipLine[7579] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[7580] = StringToText("  · 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[7581] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7582] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7583] = StringToText("  · 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[7584] = StringToText("  · 戏子（改）：麻脸巫婆无法创造戏子（改），麻脸巫婆创造的邪恶玩家无法获得戏子（改）的能力。");
    g_tipRoleAt[67] = 7553; g_tipRoleN[67] = 32;
    g_tipLine[7585] = StringToText("【角色能力】");
    g_tipLine[7586] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[7587] = StringToText("【角色简介】");
    g_tipLine[7588] = StringToText("寡妇查看魔典并毒害一名她选择的玩家。");
    g_tipLine[7589] = StringToText("· 寡妇仅在她的首个夜晚行动并使一名玩家中毒。");
    g_tipLine[7590] = StringToText("· 因寡妇中毒的玩家会一直保持中毒直到寡妇死亡。");
    g_tipLine[7591] = StringToText("· 在寡妇行动的那个夜晚，会有一名善良玩家知道寡妇在场，他不会得知谁是寡妇，也不会得知谁中毒了。");
    g_tipLine[7592] = StringToText("【规则细节】");
    g_tipLine[7593] = StringToText("· 相克规则：");
    g_tipLine[7594] = StringToText("  · 魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_tipLine[7595] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[7596] = StringToText("  · 炼金术士：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。每次处决后，");
    g_tipLine[7597] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[7598] = StringToText("  · 落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[7599] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7600] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7601] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7602] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[75] = 7585; g_tipRoleN[75] = 18;
    g_tipLine[7603] = StringToText("【角色能力】");
    g_tipLine[7604] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。 如果你被处决，提名你的玩家需要和你猜拳，");
    g_tipLine[7605] = StringToText("  只有你输了你才会死亡。");
    g_tipLine[7606] = StringToText("【角色简介】");
    g_tipLine[7607] = StringToText("精神病患者在光天化日之下展开杀戮。");
    g_tipLine[7608] = StringToText("· 在白天时，如果精神病患者宣布自己是精神病患者并公开选择一名玩家，那名玩家死亡。这个能力每个白天只能使用一次，");
    g_tipLine[7609] = StringToText("  且只能在说书人要求开始提名前进行。");
    g_tipLine[7610] = StringToText("· 精神病患者的能力并非强制使用，他可以在自己不想要使用能力时不这么做。");
    g_tipLine[7611] = StringToText("· 精神病患者能够正常被提名和投票。如果精神病患者被处决，他可能不会死亡。");
    g_tipLine[7612] = StringToText("  他会和提名他的玩家进行一次猜拳（石头剪刀布）。提名他的玩家需要赢得猜拳才能让这次处决成功杀死精神病患者。");
    g_tipLine[7613] = StringToText("  如果平局或者猜拳失败，精神病患者会仍然存活。");
    g_tipLine[7614] = StringToText("· 对精神病患者的处决同样计入每个白天限制一次的次数里。如果精神病患者被处决，");
    g_tipLine[7615] = StringToText("  那么今天白天不会再有其他提名和处决发生了。");
    g_tipLine[7616] = StringToText("· 如果精神病患者因为其他原因死亡，例如恶魔的攻击，那么他不会进行猜拳，而是直接死亡。");
    g_tipLine[7617] = StringToText("【规则细节】");
    g_tipLine[7618] = StringToText("· 特定角色互动：");
    g_tipLine[7619] = StringToText("  · 炼金术士：如果炼金术士获得精神病患者的能力并提名贞洁者而因此被处决，他将会和说书人猜拳。");
    g_tipLine[7620] = StringToText("  · 咖啡师：「行动两次」的效果将允许精神病患者在白天杀死2人（咖啡师可能会被立即流放），");
    g_tipLine[7621] = StringToText("    但如果在接下来的这个白天精神病患者被处决，仍然只会进行一次猜拳。");
    g_tipLine[7622] = StringToText("  · 屠夫：每天都可以重新提名精神病患者来进行第二次处决并尝试杀死他。");
    g_tipLine[7623] = StringToText("  · 魔鬼代言人 ：即使受到魔鬼代言人的保护，精神病患者仍然应该进行猜拳，只有当他输了时，");
    g_tipLine[7624] = StringToText("    善良阵营才会发现精神病患者受到了魔鬼代言人的保护，因为精神病患者没有死于一次「猜拳胜利」的处决。");
    g_tipLine[7625] = StringToText("  · 弄臣/水手/茶艺师：如果精神病患者的目标不能死亡，目标不会死亡。这会被数学家记录。");
    g_tipLine[7626] = StringToText("  · 法官：如果法官强制使对精神病患者的提名通过，这只能确保精神病患者被处决，并且将需要进行猜拳来确定他是否会死亡。");
    g_tipLine[7627] = StringToText("  · 呆瓜/月之子：如果精神病患者杀死他，他会在白天得知他的死亡，因此必须在同一天做出选择。");
    g_tipLine[7628] = StringToText("  · 亡骨魔：如果精神病患者被亡骨魔杀死并因此在死亡状态保留了他的能力，如果他在死亡状态被处决，");
    g_tipLine[7629] = StringToText("    则没有必要进行猜拳——他已经死亡，因此无论猜拳的结果如何都不会再次死亡。");
    g_tipLine[7630] = StringToText("· 相克规则：");
    g_tipLine[7631] = StringToText("  · 小怪宝：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[7632] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7633] = StringToText("  · 姑获鸟：如果姑获鸟获得了精神病患者的能力，他会在被处决时死亡。");
    g_tipRoleAt[84] = 7603; g_tipRoleN[84] = 31;
    g_tipLine[7634] = StringToText("【角色能力】");
    g_tipLine[7635] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipLine[7636] = StringToText("【角色简介】");
    g_tipLine[7637] = StringToText("灵言师向善良玩家提出一笔交易：是否要转为邪恶。");
    g_tipLine[7638] = StringToText("· 在首个夜晚，灵言师从说书人处得知一个关键词。");
    g_tipLine[7639] = StringToText("· 如果善良玩家说出了关键词，不论是公开说出或是私下对说书人说出，他就会在当晚转为邪恶阵营。");
    g_tipLine[7640] = StringToText("  前提条件是说书人需要实际听到那名玩家确切地说出了这个关键词。");
    g_tipLine[7641] = StringToText("· 灵言师不会得知是否有玩家转为了邪恶。说出关键词的善良玩家直到当晚才会得知他是否转为了邪恶。");
    g_tipLine[7642] = StringToText("· 如果灵言师在夜晚是清醒且健康的，那么即使他在白天善良玩家说出关键词时醉酒或中毒，仍然会让这名善良玩家转为邪恶。");
    g_tipLine[7643] = StringToText("  但如果一名玩家即将在夜里转为邪恶时灵言师醉酒中毒了，那么那名玩家会仍然保持善良阵营不变——灵言师会因此消耗他的能力");
    g_tipLine[7644] = StringToText("  的使用次数，并且无法在随后再让其他玩家转为邪恶阵营。");
    g_tipLine[7645] = StringToText("【规则细节】");
    g_tipLine[7646] = StringToText("无额外规则。");
    g_tipRoleAt[85] = 7634; g_tipRoleN[85] = 13;
    g_tipLine[7647] = StringToText("【角色能力】");
    g_tipLine[7648] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipLine[7649] = StringToText("【角色简介】");
    g_tipLine[7650] = StringToText("提线木偶对自己是爪牙一事全然不知。");
    g_tipLine[7651] = StringToText("· 提线木偶会从盲抽袋中抽取到一个镇民或外来者角色，但是他实际上是提线木偶。");
    g_tipLine[7652] = StringToText("· 提线木偶与恶魔是邻座。他们之间不会有其他的玩家。");
    g_tipLine[7653] = StringToText("· 恶魔会知道哪一名玩家是提线木偶。");
    g_tipLine[7654] = StringToText("· 提线木偶不会在游戏的首个夜晚被唤醒以得知其他邪恶玩家都有谁，其他爪牙也不会得知谁是提线木偶。");
    g_tipLine[7655] = StringToText("· 认为自己是提线木偶的玩家所抽取到的善良角色对应的能力不会产生任何效果，但说书人会假装这些效果生效了。");
    g_tipLine[7656] = StringToText("  这与酒鬼的运作方式相似。");
    g_tipLine[7657] = StringToText("· 提线木偶在互动时被当作邪恶阵营以及爪牙角色。");
    g_tipLine[7658] = StringToText("· 提线木偶不会因其他角色能力导致他确认自己是爪牙而被唤醒。例如：告密者，传教士，小怪宝，罂粟种植者，帽匠，");
    g_tipLine[7659] = StringToText("  落难少女等。");
    g_tipLine[7660] = StringToText("【规则细节】");
    g_tipLine[7661] = StringToText("· 相克规则：");
    g_tipLine[7662] = StringToText("  · 瘟疫医生：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[7663] = StringToText("  · 小怪宝：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[7664] = StringToText("  · 气球驾驶员：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_tipLine[7665] = StringToText("  · 巡山人：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_tipLine[7666] = StringToText("  · 召唤师：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[7667] = StringToText("  · 卡扎力：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[7668] = StringToText("  · 炼金术士：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一定在场。");
    g_tipLine[7669] = StringToText("  · 魔术师：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_tipLine[7670] = StringToText("  · 数学家：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_tipLine[7671] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7672] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7673] = StringToText("  · 梼杌：梼杌不会得知谁是提线木偶。在梼杌使得提线木偶失去能力后，梼杌会得知对应的那一名提线木偶是谁，");
    g_tipLine[7674] = StringToText("    但提线木偶会仍然以为自己是一个善良角色。");
    g_tipLine[7675] = StringToText("  · 姑获鸟：姑获鸟无法获得提线木偶的能力。");
    g_tipRoleAt[93] = 7647; g_tipRoleN[93] = 29;
    g_tipLine[7676] = StringToText("【角色能力】");
    g_tipLine[7677] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipLine[7678] = StringToText("【角色简介】");
    g_tipLine[7679] = StringToText("巫师许下愿望。");
    g_tipLine[7680] = StringToText("· 这个愿望只受限于玩家的想象力，它可以是任何事。巫师可以在夜晚用手机屏幕展示愿望内容给说书人，");
    g_tipLine[7681] = StringToText("  也可以在白天私下告诉说书人。如果巫师有些鲁莽，他也可以公开许愿。");
    g_tipLine[7682] = StringToText("· 说书人不必立刻公开宣布巫师许下了愿望，而是可以稍后再宣布。");
    g_tipLine[7683] = StringToText("· 许多愿望都伴随着代价。代价可能会以某种方式影响游戏，或是影响这个愿望本身。它也可以是任何事，");
    g_tipLine[7684] = StringToText("  由说书人认真思考后决定。说书人可以决定是否告诉巫师愿望的代价。代价的目的是为了从能力的效果上平衡这个愿望，");
    g_tipLine[7685] = StringToText("  以免它对善良阵营造成不公平的影响。");
    g_tipLine[7686] = StringToText("· 许多愿望会留下线索。线索可以是任何事，由说书人认真思考后决定，然后再公开宣布。");
    g_tipLine[7687] = StringToText("  线索的目的是为了从信息上平衡这个愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[7688] = StringToText("· 当巫师死亡，愿望可能会继续生效，也可能会失效，取决于愿望和代价具体是什么。");
    g_tipLine[7689] = StringToText("· 如果巫师许了一个说书人不理解的愿望，或者说书人认为他无法实现，说书人可以让巫师重新许愿，或者告诉巫师，");
    g_tipLine[7690] = StringToText("  他的愿望被消耗了。");
    g_tipLine[7691] = StringToText("【规则细节】");
    g_tipLine[7692] = StringToText("无额外规则。");
    g_tipRoleAt[98] = 7676; g_tipRoleN[98] = 17;
    g_tipLine[7693] = StringToText("【角色能力】");
    g_tipLine[7694] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipLine[7695] = StringToText("【角色简介】");
    g_tipLine[7696] = StringToText("哥布林会在小镇明知他是哥布林却要处决他时采取报复。");
    g_tipLine[7697] = StringToText("· 如果哥布林被处决，邪恶阵营获胜。");
    g_tipLine[7698] = StringToText("· 为了让这种情况发生，哥布林需要在被提名后，开始投票前告知其他玩家他是哥布林。他的公开宣言需要让所有人都听见，");
    g_tipLine[7699] = StringToText("  因为善良玩家必须清楚自己接下来的行为所带来的风险。");
    g_tipLine[7700] = StringToText("· 如果哥布林没有公布自己的角色就被处决了，那么哥布林死亡，游戏如常进行。");
    g_tipLine[7701] = StringToText("· 哥布林必须在被处决的当天宣布自己的角色，只有这样他的能力才会生效。在前一天或更早的时间里宣布不会产生效果。");
    g_tipLine[7702] = StringToText("· 任何玩家都可以在被提名时声称自己是哥布林。");
    g_tipLine[7703] = StringToText("【规则细节】");
    g_tipLine[7704] = StringToText("· 相克规则：");
    g_tipLine[7705] = StringToText("  · 瘟疫医生：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[7706] = StringToText("  · 洗脑师：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[7707] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7708] = StringToText("  · 戏子：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[7709] = StringToText("  · 戏子（改）：戏子（改）无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[7710] = StringToText("  · 姑获鸟：姑获鸟无法获得哥布林的能力。");
    g_tipRoleAt[99] = 7693; g_tipRoleN[99] = 18;
    g_tipLine[7711] = StringToText("【角色能力】");
    g_tipLine[7712] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，");
    g_tipLine[7713] = StringToText("  所有玩家都会得知你选择了新的玩家。");
    g_tipLine[7714] = StringToText("【角色简介】");
    g_tipLine[7715] = StringToText("恐惧之灵在提名中掺入猜疑。");
    g_tipLine[7716] = StringToText("· 在游戏的首个夜晚，恐惧之灵选择了一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[7717] = StringToText("· 在其他夜晚，每当恐惧之灵选择了与上次选择不同的一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[7718] = StringToText("  如果恐惧之灵选择的玩家与上一次选择的相同，玩家不会得知任何内容。");
    g_tipLine[7719] = StringToText("· 玩家只会得知恐惧之灵是否采取了行动，但不会得知恐惧之灵具体选择了哪一名玩家。");
    g_tipLine[7720] = StringToText("· 如果恐惧之灵提名了他当前选择的玩家，且该玩家因此被处决时，该玩家的阵营落败，游戏结束。");
    g_tipLine[7721] = StringToText("· 只有恐惧之灵当前选择的玩家会受到恐惧之灵的能力影响。他此前选择的玩家不会受到影响。");
    g_tipLine[7722] = StringToText("· 如果被选择的玩家被恐惧之灵提名并处决后没有死亡，他的阵营仍然会落败。");
    g_tipLine[7723] = StringToText("【规则细节】");
    g_tipLine[7724] = StringToText("· 相克规则：");
    g_tipLine[7725] = StringToText("  · 瘟疫医生：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[7726] = StringToText("  · 维齐尔：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[7727] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[7728] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7729] = StringToText("  · 戏子：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[7730] = StringToText("  · 戏子（改）：戏子（改）无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipRoleAt[102] = 7711; g_tipRoleN[102] = 20;
    g_tipLine[7731] = StringToText("【角色能力】");
    g_tipLine[7732] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipLine[7733] = StringToText("【角色简介】");
    g_tipLine[7734] = StringToText("科学怪人能够复制善良角色的能力。");
    g_tipLine[7735] = StringToText("· 只要科学怪人存活且清醒健康，恶魔就会拥有一个不在场的镇民或外来者角色的能力。");
    g_tipLine[7736] = StringToText("· 如果恶魔醉酒中毒，恶魔仍然保留自己获得的这个善良角色的能力。然而如果科学怪人醉酒中毒，");
    g_tipLine[7737] = StringToText("  恶魔就会暂时失去这个善良角色的能力。");
    g_tipLine[7738] = StringToText("· 如果恶魔拥有的能力是死亡后触发或保留的能力，且恶魔死亡，那么恶魔会保留获得的这项能力，例如心上人。");
    g_tipLine[7739] = StringToText("· 如果有新恶魔被创造，例如红唇女郎或理发师，那么新恶魔也能从科学怪人处获得能力。");
    g_tipLine[7740] = StringToText("  新恶魔获得的能力可以与旧恶魔获得的能力不同。");
    g_tipLine[7741] = StringToText("· 如果有多名恶魔同时在场且存活，只会有其中一名存活恶魔能够从科学怪人处获得能力。");
    g_tipLine[7742] = StringToText("· 如果在游戏设置时恶魔因此获得的能力能够影响初始设置，例如唱诗男孩，那么就会对游戏设置产生影响。");
    g_tipLine[7743] = StringToText("· 获得善良角色能力的恶魔与科学怪人都能得知恶魔获得了哪个角色的能力。");
    g_tipLine[7744] = StringToText("  说书人可以分别或同时唤醒这两名玩家通知他们相关信息。");
    g_tipLine[7745] = StringToText("· 恶魔因此获得的不在场角色能力可以来自于恶魔的伪装之一。");
    g_tipLine[7746] = StringToText("· 在夜晚时，恶魔会额外在这个善良角色被唤醒的时机下被唤醒。");
    g_tipLine[7747] = StringToText("【规则细节】");
    g_tipLine[7748] = StringToText("· 如果科学怪人让恶魔拥有「能够让自己醉酒中毒」的能力（比如水手、食人族等），当这些能力导致自身醉酒或中毒时，");
    g_tipLine[7749] = StringToText("  仅影响恶魔因科学怪人拥有的能力，不会影响恶魔玩家原本的能力。");
    g_tipLine[7750] = StringToText("· 相克规则：");
    g_tipLine[7751] = StringToText("  · 异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[7752] = StringToText("  · 莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[7753] = StringToText("  · 异端分子：恶魔无法拥有异端分子的能力。");
    g_tipLine[7754] = StringToText("  · 食人魔：恶魔无法拥有食人魔的能力。");
    g_tipLine[7755] = StringToText("  · 政客：恶魔无法拥有政客的能力。");
    g_tipLine[7756] = StringToText("  · 酒鬼：恶魔无法拥有酒鬼的能力。");
    g_tipLine[7757] = StringToText("  · 炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。");
    g_tipLine[7758] = StringToText("  · 村夫：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[7759] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7760] = StringToText("  · 悟道者：恶魔无法拥有悟道者的能力。");
    g_tipLine[7761] = StringToText("  · 狸猫：如果因科学怪人获得狸猫能力的恶魔与「太子」交换角色，改为「太子」变成狸猫且恶魔获得「太子」原本角色的能力。");
    g_tipRoleAt[132] = 7731; g_tipRoleN[132] = 31;
    g_tipLine[7762] = StringToText("【角色能力】");
    g_tipLine[7763] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipLine[7764] = StringToText("【角色简介】");
    g_tipLine[7765] = StringToText("炸弹人会在被处决后引爆炸弹，消灭在场的绝大多数玩家。");
    g_tipLine[7766] = StringToText("· 如果炸弹人被处决，由说书人来选择会有哪些玩家被杀死，每次一名玩家，直到只剩三名玩家存活。");
    g_tipLine[7767] = StringToText("· 恶魔一定会是这三名存活的玩家之一（在绝大多数情况下都应该是这种结果，否则游戏就会立刻结束）。");
    g_tipLine[7768] = StringToText("· 玩家们要在十声倒数内决定下一个死亡的是谁。今天白天不会有其他的提名和处决，取而代之的是，");
    g_tipLine[7769] = StringToText("  所有玩家会用手指指向自己想要杀死的玩家。在倒数结束后，说书人会统计每名玩家被指向的次数。");
    g_tipLine[7770] = StringToText("  如果这种情况下出现了平局，那么游戏会进入夜晚阶段（邪恶阵营极有可能会因为恶魔在当晚的杀戮而获胜）。");
    g_tipLine[7771] = StringToText("· 即使是失去了投票标记的已死亡玩家，也能够用手指指向自己想要杀死的玩家。");
    g_tipLine[7772] = StringToText("· 玩家在倒数时间内可以随意更换手指指向的目标，在倒数结束后指向的结果才会作为最终结果。");
    g_tipLine[7773] = StringToText("· 炸弹人只会因为处决而触发能力。通过其他方式死亡，例如魔像或者精神病患者，不会触发能力。");
    g_tipLine[7774] = StringToText("  如果炸弹人被处决但没有死亡（由于魔鬼代言人等的能力），他的能力仍然会触发。");
    g_tipLine[7775] = StringToText("· 如果有不会死亡的角色在场，例如弄臣或水手，那么在炸弹人触发能力之后，可能会有多于三名玩家存活。");
    g_tipLine[7776] = StringToText("【规则细节】");
    g_tipLine[7777] = StringToText("· 相克规则：");
    g_tipLine[7778] = StringToText("  · 瘟疫医生：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipRoleAt[138] = 7762; g_tipRoleN[138] = 17;
    g_tipLine[7779] = StringToText("【角色能力】");
    g_tipLine[7780] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipLine[7781] = StringToText("【角色简介】");
    g_tipLine[7782] = StringToText("鹰身女妖在善良玩家之间制造争论与怀疑。");
    g_tipLine[7783] = StringToText("· 在夜晚时，鹰身女妖选择玩家时是一次选择一名玩家，而不是同时选择两名玩家。");
    g_tipLine[7784] = StringToText("· 被鹰身女妖选择的玩家会在鹰身女妖下一次进行选择之前持续被影响。");
    g_tipLine[7785] = StringToText("· 如果说书人决定通过鹰身女妖的能力杀死玩家，那么他必须决定是杀死其中一名玩家还是全部杀死。");
    g_tipLine[7786] = StringToText("· 鹰身女妖可以选择已死亡的玩家。如果她这么做，那么说书人只能杀死当前仍存活的目标玩家，");
    g_tipLine[7787] = StringToText("  因为已死亡的玩家不能再次死亡。");
    g_tipLine[7788] = StringToText("· 被鹰身女妖的能力杀死的玩家的死亡顺序由说书人决定，这一点非常重要。");
    g_tipLine[7789] = StringToText("【规则细节】");
    g_tipLine[7790] = StringToText("无额外规则。");
    g_tipRoleAt[139] = 7779; g_tipRoleN[139] = 12;
    g_tipLine[7791] = StringToText("【角色能力】");
    g_tipLine[7792] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。 每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipLine[7793] = StringToText("【角色简介】");
    g_tipLine[7794] = StringToText("街头风琴手会让投票秘密进行。");
    g_tipLine[7795] = StringToText("· 当一名玩家被提名后，在投票时所有玩家都需要闭上眼睛。");
    g_tipLine[7796] = StringToText("· 说书人在计票时不会大声唱票，也不会在一次投票结束时告诉大家有多少玩家投了票。");
    g_tipLine[7797] = StringToText("· 说书人不会告诉大家某次提名是否导致了一名玩家「即将被处决」。");
    g_tipLine[7798] = StringToText("· 在提名阶段结束后，说书人宣布了哪名玩家被处决，和正常一样。");
    g_tipLine[7799] = StringToText("· 已死亡的玩家在有投票标记时能够如常投票，但仅限一次。他们的投票标记会在当天白天结束时被移除而不是在单次投票后立即");
    g_tipLine[7800] = StringToText("  被移除。");
    g_tipLine[7801] = StringToText("· 如果街头风琴手醉酒，和正常情况一样，所有玩家睁眼投票。说书人无需对此进行额外说明，比如街头风琴手是否死亡或存活。");
    g_tipLine[7802] = StringToText("  当天夜晚，街头风琴手要再次选择自己醉酒或清醒。");
    g_tipLine[7803] = StringToText("【规则细节】");
    g_tipLine[7804] = StringToText("· 特定角色互动：");
    g_tipLine[7805] = StringToText("  · 枪手：因为说书人能够决定在游戏中有哪些旅行者可以出场并被玩家选择作为自己的旅行者角色，");
    g_tipLine[7806] = StringToText("    因此避免枪手在有街头风琴手的剧本中出场是应对这两个角色的奇怪互动的最好方式。");
    g_tipLine[7807] = StringToText("· 相克规则：");
    g_tipLine[7808] = StringToText("  · 管家：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，但只在他的主人投票时他的票才会被统计。");
    g_tipLine[7809] = StringToText("  · 炼金术士：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。如果炼金术士和街头风琴手都是清醒的，");
    g_tipLine[7810] = StringToText("    改为他们都醉酒。");
    g_tipLine[7811] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7812] = StringToText("  · 梼杌：当梼杌被处决时，如果街头风琴手具有能力，说书人会宣布「无人被处决」。");
    g_tipRoleAt[140] = 7791; g_tipRoleN[140] = 22;
    g_tipLine[7813] = StringToText("【角色能力】");
    g_tipLine[7814] = StringToText("所有玩家都知道你是维齐尔。 你在白天时不会死亡。 如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipLine[7815] = StringToText("【角色简介】");
    g_tipLine[7816] = StringToText("维齐尔能够处决玩家，无需经过镇子的同意。");
    g_tipLine[7817] = StringToText("· 在第一个白天，所有玩家都会得知维齐尔在场，并且知道是哪一名玩家。");
    g_tipLine[7818] = StringToText("· 在白天时，维齐尔不会因为任何原因死亡。");
    g_tipLine[7819] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且至少有一名善良玩家参与投票），那么被提名者会立即被处决。");
    g_tipLine[7820] = StringToText("  这算在每个白天的一次处决之内。");
    g_tipLine[7821] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且没有任何善良玩家参与投票），那么无事发生。");
    g_tipLine[7822] = StringToText("· 即使被提名者得票在存活玩家的半数以下，维齐尔仍然能够执行处决。即使有其他玩家得票比此次被提名者多，");
    g_tipLine[7823] = StringToText("  维齐尔仍然能够执行处决。");
    g_tipLine[7824] = StringToText("· 维齐尔无需在每个白天都使用自己的能力来造成强制处决。");
    g_tipLine[7825] = StringToText("【规则细节】");
    g_tipLine[7826] = StringToText("· 如果维齐尔受到非相克规则的角色带来的醉酒或中毒的效果影响，那么他能够在白天死亡，并且无法选择立即执行处决，");
    g_tipLine[7827] = StringToText("  但玩家不会知道这一点，直到维齐尔尝试这么做为止。");
    g_tipLine[7828] = StringToText("· 如果维齐尔在游戏中途被创造，所有玩家都会立即得知谁是维齐尔。然而如果维齐尔的角色中途发生了变化，");
    g_tipLine[7829] = StringToText("  玩家不会立即得知这一消息（因为暴露角色的能力来源消失了）。");
    g_tipLine[7830] = StringToText("· 相克规则：");
    g_tipLine[7831] = StringToText("  · 调查员：说书人不会宣布维齐尔在场。");
    g_tipLine[7832] = StringToText("  · 传教士：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[7833] = StringToText("  · 侍臣：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[7834] = StringToText("  · 魔术师：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[7835] = StringToText("  · 戏法师：说书人不会宣布维齐尔在场。");
    g_tipLine[7836] = StringToText("  · 政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[7837] = StringToText("  · 狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[7838] = StringToText("  · 恐惧之灵：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[7839] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[7840] = StringToText("  · 小怪宝：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[7841] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7842] = StringToText("  · 姑获鸟：姑获鸟无法获得维齐尔的能力。");
    g_tipRoleAt[141] = 7813; g_tipRoleN[141] = 30;
    g_tipLine[7843] = StringToText("【角色能力】");
    g_tipLine[7844] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipLine[7845] = StringToText("【角色简介】");
    g_tipLine[7846] = StringToText("限会让镇民玩家集体中毒。");
    g_tipLine[7847] = StringToText("· 限会让所有镇民玩家中毒一个夜晚和一个白天。限的能力生效夜晚和初始加入游戏的外来者数量相同。比如，游戏开始时，");
    g_tipLine[7848] = StringToText("  有两名外来者，限的能力就会在第二个夜晚生效。");
    g_tipLine[7849] = StringToText("· 限可以让任意数量的外来者加入游戏，但通常是一名到四名外来者。外来者的数量可以和限不在场时的数量一致，");
    g_tipLine[7850] = StringToText("  也可以有所差距。限的能力会覆盖其他设置调整类型的能力，例如男爵等角色。");
    g_tipLine[7851] = StringToText("· 如果在游戏过程中外来者数量发生变化，大限将至的夜晚也仍然取决于初始设置的外来者数量。");
    g_tipLine[7852] = StringToText("· 限需要存活，能力才能生效。");
    g_tipLine[7853] = StringToText("【规则细节】");
    g_tipLine[7854] = StringToText("无额外规则。");
    g_tipRoleAt[147] = 7843; g_tipRoleN[147] = 12;
    g_tipLine[7855] = StringToText("【角色能力】");
    g_tipLine[7856] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");
    g_tipLine[7857] = StringToText("【角色简介】");
    g_tipLine[7858] = StringToText("召唤师能够创造恶魔。");
    g_tipLine[7859] = StringToText("· 召唤师能够选择任意一名玩家变成恶魔，他甚至可以选择自己。");
    g_tipLine[7860] = StringToText("· 被创造的新恶魔不会得知谁是爪牙，爪牙也不会得知他是恶魔。邪恶玩家之间需要通过交流来互认。");
    g_tipLine[7861] = StringToText("· 即使在游戏的前两天没有恶魔在场，游戏也不会因此结束。然而，如果召唤师因为某些原因无法创造新的恶魔（死亡或在第三个");
    g_tipLine[7862] = StringToText("  夜晚中毒等），善良阵营获胜。");
    g_tipLine[7863] = StringToText("· 新恶魔在被创造的当晚就能行动。");
    g_tipLine[7864] = StringToText("【规则细节】");
    g_tipLine[7865] = StringToText("· 特定角色互动：");
    g_tipLine[7866] = StringToText("  · 理发师：如果理发师死亡但无恶魔在场，无事发生。");
    g_tipLine[7867] = StringToText("  · 莽夫：如果召唤师在创造恶魔时选择了莽夫，莽夫转为邪恶，且会与邪恶阵营一同落败，因为场上没有恶魔且召唤师醉酒了。");
    g_tipLine[7868] = StringToText("· 相克规则：");
    g_tipLine[7869] = StringToText("  · 炼金术士：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_tipLine[7870] = StringToText("    由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[7871] = StringToText("  · 钟表匠：召唤师会被钟表匠当作恶魔。");
    g_tipLine[7872] = StringToText("  · 罂粟种植者：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，由说书人来决定哪名玩家发生转变。");
    g_tipLine[7873] = StringToText("  · 侍臣：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[7874] = StringToText("  · 传教士：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[7875] = StringToText("  · 工程师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_tipLine[7876] = StringToText("  · 帽匠/麻脸巫婆/卡扎力：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[7877] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[7878] = StringToText("  · 僵怖：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_tipLine[7879] = StringToText("  · 普卡：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_tipLine[7880] = StringToText("  · 军团：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[7881] = StringToText("  · 堤丰之首：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[7882] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7883] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7884] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[7885] = StringToText("  · 姑获鸟：如果召唤师成功召唤了姑获鸟，召唤师会变成一个不在场的爪牙。");
    g_tipLine[7886] = StringToText("  · 典狱长：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipRoleAt[150] = 7855; g_tipRoleN[150] = 32;
    g_tipAbility[17] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipAbility[18] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipAbility[19] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipAbility[20] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipAbility[39] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。 如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipAbility[40] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipAbility[41] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipAbility[42] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，他的阵营落败。");
    g_tipAbility[64] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。 如果其中善良玩家被处决，邪恶阵营获胜。 如果你们都存活，善良阵营无法获胜。");
    g_tipAbility[65] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipAbility[66] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipAbility[67] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipAbility[75] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipAbility[84] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。 如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipAbility[85] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipAbility[93] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipAbility[98] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipAbility[99] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipAbility[102] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，所有玩家都会得知你选择了新的玩家。");
    g_tipAbility[132] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipAbility[138] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipAbility[139] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipAbility[140] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。 每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipAbility[141] = StringToText("所有玩家都知道你是维齐尔。 你在白天时不会死亡。 如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipAbility[147] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipAbility[150] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");

    g_tipLine[6352] = StringToText("【角色能力】");
    g_tipLine[6353] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名爪牙会变成小恶魔。");
    g_tipLine[6354] = StringToText("【角色简介】");
    g_tipLine[6355] = StringToText("小恶魔会在夜晚杀戮，且能创造自己的分身……以可怕的代价。");
    g_tipLine[6356] = StringToText("· 除首个夜晚以外的每个夜晚，小恶魔会选择一名玩家进行杀戮。因为夜间大多数角色都在恶魔之后行动，");
    g_tipLine[6357] = StringToText("  被恶魔杀死的玩家可能在当晚无法使用他的能力。");
    g_tipLine[6358] = StringToText("· 小恶魔作为恶魔，能够得知哪些玩家是他的爪牙，也能得知三个不在场的善良角色，他能较为安全地伪装成这些角色。");
    g_tipLine[6359] = StringToText("· 如果小恶魔死亡，游戏结束且善良阵营获胜。然而，如果小恶魔选择在夜晚杀死自己，");
    g_tipLine[6360] = StringToText("  他会死亡并且会有一名存活的爪牙变成小恶魔。新的小恶魔在当晚无法进行行动，");
    g_tipLine[6361] = StringToText("  但现在那名爪牙现在在各种意义上都会成为恶魔——他会在此后的每个夜晚杀戮，且会在死亡时让邪恶阵营落败。");
    g_tipLine[6362] = StringToText("【规则细节】");
    g_tipLine[6363] = StringToText("无额外规则。");
    g_tipRoleAt[21] = 6352; g_tipRoleN[21] = 12;
    g_tipLine[6364] = StringToText("【角色能力】");
    g_tipLine[6365] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。当你首次死亡后，你仍存活，");
    g_tipLine[6366] = StringToText("  但会被当作死亡。");
    g_tipLine[6367] = StringToText("【角色简介】");
    g_tipLine[6368] = StringToText("僵怖能秘密地在墓地中保持存活。");
    g_tipLine[6369] = StringToText("· 当僵怖因任何原因死亡后，他会保持存活状态，但说书人会表现得如同僵怖死亡了一样。僵怖第二次死亡时，才会真正地死亡，");
    g_tipLine[6370] = StringToText("  且善良阵营获胜。");
    g_tipLine[6371] = StringToText("· 看似死亡的僵怖在绝大多数情况下都算作已死亡。该玩家在城镇广场的生命标记会翻面以标识死亡。下一次该玩家投票时，");
    g_tipLine[6372] = StringToText("  会失去投票标记。该玩家不能发起提名，该玩家可以在有巫毒师的情况下投票，该玩家不算作茶艺师的存活邻近玩家，等等。");
    g_tipLine[6373] = StringToText("  不同之处是游戏还会继续，僵怖仍然能发起攻击，且游戏会在只剩两名其他存活玩家的情况下继续进行。");
    g_tipLine[6374] = StringToText("· 如果无人在白天死亡，僵怖才会在夜晚被唤醒并发起攻击。如果一名已死亡的玩家被处决，该玩家无法再次死亡，");
    g_tipLine[6375] = StringToText("  因此僵怖仍然会被唤醒。");
    g_tipLine[6376] = StringToText("· 如果一个醉酒或中毒的僵怖死亡，善良阵营获胜。如果一个「死亡」的僵怖醉酒或中毒，不要宣布该玩家存活。");
    g_tipLine[6377] = StringToText("【规则细节】");
    g_tipLine[6378] = StringToText("· 相克规则：");
    g_tipLine[6379] = StringToText("  · 召唤师：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_tipLine[6380] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6381] = StringToText("  · 戏子：在戏子存在于剧本中时，僵怖可以在游戏中任意时候向说书人示意自己「想要死亡」。无论僵怖是否触发过「假死」，");
    g_tipLine[6382] = StringToText("    当晚僵怖会变为死亡状态。");
    g_tipLine[6383] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，僵怖可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6384] = StringToText("    无论僵怖是否触发过「假死」，当晚僵怖会变为死亡状态。");
    g_tipRoleAt[43] = 6364; g_tipRoleN[43] = 21;
    g_tipLine[6385] = StringToText("【角色能力】");
    g_tipLine[6386] = StringToText("每个夜晚，你要选择一名玩家：他中毒。上个因你的能力中毒的玩家会死亡并恢复健康。");
    g_tipLine[6387] = StringToText("【角色简介】");
    g_tipLine[6388] = StringToText("普卡能让他的受害者中毒，并在之后毒发身亡。");
    g_tipLine[6389] = StringToText("· 当普卡攻击时，他的受害者会立即中毒。在下一个夜晚，该名玩家会在普卡发起下一次攻击之后的时间点死亡。");
    g_tipLine[6390] = StringToText("· 不同于其他恶魔，普卡在首个夜晚就会行动。");
    g_tipLine[6391] = StringToText("· 驱魔人能防止普卡被唤醒来使玩家中毒。旅店老板能防止普卡杀死已经中毒的玩家，随后该玩家会恢复健康。");
    g_tipLine[6392] = StringToText("· 如果醉酒状态的普卡选择了一名玩家，该玩家不会中毒，也不会在下一个夜晚死亡。");
    g_tipLine[6393] = StringToText("· 如果普卡在上一个夜晚选择玩家时是清醒的，但是当晚醉酒了，该玩家不会死亡。但是当普卡恢复清醒，中毒效果会恢复，");
    g_tipLine[6394] = StringToText("  且会在随后的夜晚杀死该玩家。");
    g_tipLine[6395] = StringToText("【规则细节】");
    g_tipLine[6396] = StringToText("· 相克规则：");
    g_tipLine[6397] = StringToText("  · 召唤师：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_tipLine[6398] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6399] = StringToText("  · 戏子：在戏子存在于剧本中时，普卡可以在游戏中任意时候向说书人示意自己「想要死亡」。说书人会在当晚杀死这名玩家。");
    g_tipLine[6400] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，普卡可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6401] = StringToText("    说书人会在当晚杀死这名玩家。");
    g_tipRoleAt[44] = 6385; g_tipRoleN[44] = 17;
    g_tipLine[6402] = StringToText("【角色能力】");
    g_tipLine[6403] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipLine[6404] = StringToText("【角色简介】");
    g_tipLine[6405] = StringToText("沙巴洛斯每个夜晚能够吞食两名玩家，但是可能会在下一个夜晚将其中一名吐出来。");
    g_tipLine[6406] = StringToText("· 不同于其他恶魔，沙巴洛斯每个夜晚会攻击两次。在攻击后的下一个夜晚，");
    g_tipLine[6407] = StringToText("  说书人可以决定让沙巴洛斯攻击过的两名玩家其中之一重获新生。");
    g_tipLine[6408] = StringToText("· 被复活的玩家可以是在存活状态下被沙巴洛斯攻击的玩家，也可以是在死亡状态下被沙巴洛斯攻击的玩家。");
    g_tipLine[6409] = StringToText("· 因反刍而复活的玩家重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的能力也会重新获得。");
    g_tipLine[6410] = StringToText("  如果有「在你的首个夜晚」的能力，玩家可以再次使用该能力。");
    g_tipLine[6411] = StringToText("【规则细节】");
    g_tipLine[6412] = StringToText("· 关于沙巴洛斯造成的反刍所带来的首夜能力使用时机的疑问：在这三个官方剧本中，");
    g_tipLine[6413] = StringToText("  角色详解通常只用于解决剧本内的一些互动方式，如果将角色互动拉到全角色和混合剧本的维度，则需要使用到统一的规则。");
    g_tipLine[6414] = StringToText("  在黯月初升中，因为只会至多有一名恶魔在场，并且爪牙发起攻击的情形不太常见，所以在大部分情况下，");
    g_tipLine[6415] = StringToText("  你可以让反刍的角色在沙巴洛斯的行动结束后立即行动。然而如果是混合剧本，则需要综合考虑，选择更准确的，");
    g_tipLine[6416] = StringToText("  不会出错的处理方式进行游戏的主持。");
    g_tipRoleAt[45] = 6402; g_tipRoleN[45] = 15;
    g_tipLine[6417] = StringToText("【角色能力】");
    g_tipLine[6418] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipLine[6419] = StringToText("【角色简介】");
    g_tipLine[6420] = StringToText("珀能选择在夜晚不发起攻击，但会在下一夜疯狂杀戮。");
    g_tipLine[6421] = StringToText("· 如同其他的恶魔，珀可以在每晚攻击一名玩家。然而，如果珀不选择任何人，那么在下个夜晚珀可以攻击三名玩家。");
    g_tipLine[6422] = StringToText("· 如果珀在上一个夜晚不选择任何人时处于醉酒或中毒，当晚珀仍然能够选择三名玩家。");
    g_tipLine[6423] = StringToText("· 当要求珀选择三名玩家时，他必须要选择。珀不能再次不选择任何人。");
    g_tipLine[6424] = StringToText("· 只有当珀不选择任何人，才能得到三次攻击的机会。如果珀在上一次进行选择时攻击了某人但该玩家没有死亡，");
    g_tipLine[6425] = StringToText("  珀也不会获得三次攻击的机会。");
    g_tipLine[6426] = StringToText("· 珀在首个夜晚不行动，但这不算作珀「没有选择」。");
    g_tipLine[6427] = StringToText("· 如果驱魔人选择了珀，珀不会行动，但是这并不算作珀「没有选择任何人」。然而，");
    g_tipLine[6428] = StringToText("  如果珀在驱魔人选择他的前一夜就没有选择任何人，那么在驱魔人选择珀的下一夜，珀能够选择三名玩家，");
    g_tipLine[6429] = StringToText("  因为珀在上一次选择时没有选择任何人。");
    g_tipLine[6430] = StringToText("【规则细节】");
    g_tipLine[6431] = StringToText("无额外规则。");
    g_tipRoleAt[46] = 6417; g_tipRoleN[46] = 15;
    g_tipLine[6432] = StringToText("【角色能力】");
    g_tipLine[6433] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，");
    g_tipLine[6434] = StringToText("  但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipLine[6435] = StringToText("【角色简介】");
    g_tipLine[6436] = StringToText("方古会侵染外来者。");
    g_tipLine[6437] = StringToText("· 方古首次攻击并成功杀死外来者时，改为方古死亡，外来者变成邪恶的方古。");
    g_tipLine[6438] = StringToText("· 这种情况在整局游戏仅能出现一次。如果新的方古攻击外来者，外来者正常死亡。");
    g_tipLine[6439] = StringToText("· 新的方古也是恶魔，如果他死亡，善良阵营获胜。但他不会得知哪些玩家是爪牙。");
    g_tipLine[6440] = StringToText("· 方古会使得在初始设置时增加一名外来者。");
    g_tipLine[6441] = StringToText("· 如果方古攻击外来者，但外来者没有因此死亡，则外来者不会成为邪恶的方古，方古也不会死。");
    g_tipLine[6442] = StringToText("【规则细节】");
    g_tipLine[6443] = StringToText("· 相克规则：");
    g_tipLine[6444] = StringToText("  · 红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipRoleAt[68] = 6432; g_tipRoleN[68] = 13;
    g_tipLine[6445] = StringToText("【角色能力】");
    g_tipLine[6446] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipLine[6447] = StringToText("【角色简介】");
    g_tipLine[6448] = StringToText("亡骨魔每当杀死自己的爪牙时，会使爪牙保留能力。");
    g_tipLine[6449] = StringToText("· 每当亡骨魔杀死一名爪牙时，虽然爪牙会死亡，但只要亡骨魔还存活，该爪牙就能保留能力，且仍能在夜晚行动。");
    g_tipLine[6450] = StringToText("· 类似于诺-达鲺，那个被亡骨魔杀死的爪牙顺时针或逆时针方向最近的镇民玩家会中毒，即使该镇民已经死亡。");
    g_tipLine[6451] = StringToText("  如果亡骨魔死亡或失去能力，受亡骨魔影响的中毒玩家恢复健康。亡骨魔在杀死爪牙时总是会使一名镇民玩家中毒，");
    g_tipLine[6452] = StringToText("  在说书人选择中毒玩家时会跳过与爪牙相邻的非镇民角色。由说书人选择该爪牙哪一侧的镇民中毒。");
    g_tipLine[6453] = StringToText("· 不仅是最后一个被亡骨魔杀死的爪牙，所有被亡骨魔杀死的爪牙都会保留能力并使一名镇民中毒。");
    g_tipLine[6454] = StringToText("· 如果死亡的爪牙变成非爪牙角色，便不再使相应的镇民中毒，且不再保留能力。如果死亡的爪牙醉酒或中毒，");
    g_tipLine[6455] = StringToText("  也会失去能力直到再次恢复清醒和健康。");
    g_tipLine[6456] = StringToText("【规则细节】");
    g_tipLine[6457] = StringToText("· 相克规则：");
    g_tipLine[6458] = StringToText("  · 主谋：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipRoleAt[69] = 6445; g_tipRoleN[69] = 14;
    g_tipLine[6459] = StringToText("【角色能力】");
    g_tipLine[6460] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。与你邻近的两名镇民中毒。");
    g_tipLine[6461] = StringToText("【角色简介】");
    g_tipLine[6462] = StringToText("诺-达鲺会使与它邻近的镇民中毒。");
    g_tipLine[6463] = StringToText("· 在诺-达鲺顺时针和逆时针方向上最近的镇民中毒，无论这些镇民是存活还是死亡。");
    g_tipLine[6464] = StringToText("  如果诺-达鲺死亡或者因为其他原因失去能力，那么这两名镇民玩家恢复健康。总是会有两名镇民玩家因此中毒，");
    g_tipLine[6465] = StringToText("  诺-达鲺的效果会跳过与他相邻的非镇民角色。");
    g_tipLine[6466] = StringToText("· 如果有玩家成为新的诺-达鲺，或一个中毒的镇民变成了一个非镇民角色，都会根据新位置关系立刻改变中毒的玩家。");
    g_tipLine[6467] = StringToText("【规则细节】");
    g_tipLine[6468] = StringToText("无额外规则。");
    g_tipRoleAt[70] = 6459; g_tipRoleN[70] = 10;
    g_tipLine[6469] = StringToText("【角色能力】");
    g_tipLine[6470] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。镇民玩家的能力都会产生错误信息。如果白天没人被处决，邪恶阵营获胜。");
    g_tipLine[6471] = StringToText("【角色简介】");
    g_tipLine[6472] = StringToText("涡流使所有信息变得错误。");
    g_tipLine[6473] = StringToText("· 任何时候角色是镇民的玩家通过能力获取信息时，他们会得知错误信息。哪怕他们醉酒或中毒，信息也一定是错误的。");
    g_tipLine[6474] = StringToText("· 涡流不会影响其他人通过其他方式获得的信息，例如说书人解释的规则或玩家的角色或阵营的变化。");
    g_tipLine[6475] = StringToText("· 当夜晚降临时，如果今天白天没有人被处决，邪恶阵营胜利。流放旅行者不算在内。");
    g_tipLine[6476] = StringToText("【规则细节】");
    g_tipLine[6477] = StringToText("· 相克规则：");
    g_tipLine[6478] = StringToText("  · 报丧女妖：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的‘通用简化原则’已涵盖包括多角色互动下的");
    g_tipLine[6479] = StringToText("    涡流信息的简化处理方式，此条仅作说明。）");
    g_tipRoleAt[71] = 6469; g_tipRoleN[71] = 11;
    g_tipLine[6480] = StringToText("【角色能力】");
    g_tipLine[6481] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，");
    g_tipLine[6482] = StringToText("  然后如果他们都存活则都死亡。");
    g_tipLine[6483] = StringToText("【角色简介】");
    g_tipLine[6484] = StringToText("哈迪寂亚会让三名玩家一同陷入囚徒困境——究竟谁会选择死亡，来让其他人得以存活？");
    g_tipLine[6485] = StringToText("· 哈迪寂亚可以在除首个夜晚以外的每个夜晚选择三名玩家。所有玩家都会得知哈迪寂亚选择了哪些玩家。");
    g_tipLine[6486] = StringToText("  在前一名被选择的玩家秘密做出自己的选择之后，才会公布下一名被选择的玩家。");
    g_tipLine[6487] = StringToText("· 在夜晚哈迪寂亚的能力生效期间，所有玩家必须保持沉默。从说书人首次宣布一名玩家被选择开始，");
    g_tipLine[6488] = StringToText("  直至说书人宣布哈迪寂亚的能力结算完毕。");
    g_tipLine[6489] = StringToText("· 如果哈迪寂亚没有进行选择，说书人不会发出声明，当晚不会有玩家因哈迪寂亚的能力死亡。");
    g_tipLine[6490] = StringToText("· 在能力结算期间，说书人会大声询问被选择的玩家如何决定自己的生死。如果该玩家点头，那么他存活。如果他摇头，");
    g_tipLine[6491] = StringToText("  那么他死亡。通过这个方式，可以让已经死亡的玩家复活。");
    g_tipLine[6492] = StringToText("· 如果在结算完毕这些玩家的选择之后他们都存活，那么他们会死亡。选择了死亡，");
    g_tipLine[6493] = StringToText("  但因为某些效果使得仍然存活的玩家也会因此再次死亡。");
    g_tipLine[6494] = StringToText("· 哈迪寂亚可以不进行选择，当这种情况发生时，说书人不会宣布哈迪寂亚在场并选择玩家的播报，夜晚继续进行，");
    g_tipLine[6495] = StringToText("  没有任何迹象表明恶魔还活着。");
    g_tipLine[6496] = StringToText("【规则细节】");
    g_tipLine[6497] = StringToText("· 已死亡的玩家如果选择「活着」，会被复活。");
    g_tipLine[6498] = StringToText("· 「如果他们都存活」判断条件不会关注这些玩家是如何做出选择的，而只看在这些选择结算后玩家是否存活。选择「死去」");
    g_tipLine[6499] = StringToText("  的存活玩家如果受到免死能力的保护，会因此存活并计入「如果他们都存活」的判断条件。");
    g_tipLine[6500] = StringToText("· 如果哈迪寂亚醉酒或中毒，他在使用自己的能力时不会产生任何效果：玩家们不会被告知哈迪寂亚的效果生效，");
    g_tipLine[6501] = StringToText("  哈迪寂亚的选择不会被宣布，被他选择的玩家不会被唤醒，不会有玩家因此被杀死或被复活，等等。");
    g_tipLine[6502] = StringToText("· 当哈迪寂亚死亡时，他如常失去自己的能力。此前被他杀死或复活的玩家依然保持当前的生死状态。");
    g_tipLine[6503] = StringToText("  哈迪寂亚的能力不会再继续产生效果。在黎明时，如常宣布玩家生死状态的改变情况。");
    g_tipLine[6504] = StringToText("· 相克规则：");
    g_tipLine[6505] = StringToText("  · 红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[6506] = StringToText("  · 主谋：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：如果他们都选择存活，邪恶阵营获胜。否则，");
    g_tipLine[6507] = StringToText("    善良阵营获胜。");
    g_tipLine[6508] = StringToText("  · 公主：如果公主在首个白天提名并处决了一名玩家，没有人会因为哈迪寂亚而死亡。(公主与哈迪寂亚角色互动结果本应如此，");
    g_tipLine[6509] = StringToText("    此条仅做说明)");
    g_tipRoleAt[87] = 6480; g_tipRoleN[87] = 30;
    g_tipLine[6510] = StringToText("【角色能力】");
    g_tipLine[6511] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。[多数玩家为军团]");
    g_tipLine[6512] = StringToText("【角色简介】");
    g_tipLine[6513] = StringToText("军团由多个恶魔组成。");
    g_tipLine[6514] = StringToText("· 如果军团在场，推荐将在场善良和邪恶玩家的数量在通常的数量上进行反转。例如，在一局十人游戏中，");
    g_tipLine[6515] = StringToText("  你可以采取近似七名军团和三名善良玩家的设置。");
    g_tipLine[6516] = StringToText("· 非军团的玩家可以是镇民也可以是外来者，由说书人来决定这些善良玩家的角色类型组合方式。");
    g_tipLine[6517] = StringToText("· 如果一项提名中至少有一名善良玩家参与投票，并且被提名的玩家「即将被处决」，那么在处决阶段时处决会正常发生。");
    g_tipLine[6518] = StringToText("  如果一项提名中只有邪恶玩家参与了投票，那么在统计票数的时候会记为零票。");
    g_tipLine[6519] = StringToText("· 每名军团在互动时被当作恶魔，同时也被当作爪牙。");
    g_tipLine[6520] = StringToText("· 由说书人来决定哪一名玩家会在夜晚死亡。");
    g_tipLine[6521] = StringToText("· 如果游戏中只剩一名善良玩家存活，说书人可以宣布邪恶阵营获胜，因为在这种条件下善良阵营无法获胜。");
    g_tipLine[6522] = StringToText("· 说书人可以不向军团提供恶魔的伪装。");
    g_tipLine[6523] = StringToText("【规则细节】");
    g_tipLine[6524] = StringToText("· 相克规则：");
    g_tipLine[6525] = StringToText("  · 工程师：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，工程师失去能力并改为得知这一信息。");
    g_tipLine[6526] = StringToText("  · 传教士：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_tipLine[6527] = StringToText("  · 吟游诗人：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处决的玩家是军团。");
    g_tipLine[6528] = StringToText("  · 帽匠：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[6529] = StringToText("  · 狂热者：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[6530] = StringToText("  · 召唤师：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[6531] = StringToText("  · 政客：政客可能会被军团当作邪恶玩家。");
    g_tipLine[6532] = StringToText("  · 魔术师：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_tipLine[6533] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6534] = StringToText("  · 戏子：在戏子存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6535] = StringToText("    说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipLine[6536] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6537] = StringToText("    说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipRoleAt[94] = 6510; g_tipRoleN[94] = 28;
    g_tipLine[6538] = StringToText("【角色能力】");
    g_tipLine[6539] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，");
    g_tipLine[6540] = StringToText("  只有当他处于死亡状态时你才会立即死亡。");
    g_tipLine[6541] = StringToText("【角色简介】");
    g_tipLine[6542] = StringToText("痢蛭在宿主存活时存活，在宿主死亡时死亡。");
    g_tipLine[6543] = StringToText("· 在首个夜晚，痢蛭会选择一名玩家，被选择的玩家会在游戏的剩余时间内都处于中毒状态。");
    g_tipLine[6544] = StringToText("· 如果这名玩家存活，痢蛭就不会死亡。如果痢蛭被处决，说书人会告诉大家这名玩家仍然存活，但不会说明原因。");
    g_tipLine[6545] = StringToText("· 如果这名首夜被痢蛭选择的玩家死亡，痢蛭也会死亡。如果此时只剩一名或两名玩家存活，那么善良阵营还是会获胜，");
    g_tipLine[6546] = StringToText("  因为恶魔死亡了。");
    g_tipLine[6547] = StringToText("· 从第二个夜晚开始，痢蛭会攻击并杀死玩家，但不会让他中毒。");
    g_tipLine[6548] = StringToText("· 如果痢蛭在游戏过程中被创造，他会在当晚令一名玩家中毒。他必须要选择一名存活的玩家。");
    g_tipLine[6549] = StringToText("【规则细节】");
    g_tipLine[6550] = StringToText("· 当痢蛭醉酒或中毒时，宿主恢复健康。如果宿主在这个期间死亡，痢蛭不会受到影响，当痢蛭恢复清醒/健康后会立即死亡。");
    g_tipLine[6551] = StringToText("  如果痢蛭在醉酒或中毒时死亡，他死亡，因为他的能力在醉酒/中毒时无法阻止死亡。如果痢蛭的宿主醉酒/中毒，");
    g_tipLine[6552] = StringToText("  对痢蛭没有影响。");
    g_tipLine[6553] = StringToText("· 痢蛭仍然是恶魔，宿主仍然是他相应的角色类型，痢蛭对宿主的选择不会对他的角色产生任何改变。注意，");
    g_tipLine[6554] = StringToText("  宿主可以是任何存活玩家，不管是什么角色类型。");
    g_tipLine[6555] = StringToText("· 特定角色互动：");
    g_tipLine[6556] = StringToText("  · 驱魔人：如果痢蛭在他的首个夜晚之后被驱魔，他不会醒来，但宿主仍然中毒，并且除非宿主死亡，痢蛭不会死。");
    g_tipLine[6557] = StringToText("    如果痢蛭在游戏过程中被创造，因为痢蛭的「选择玩家让他中毒」的能力属于进场能力且不属于信息类能力，");
    g_tipLine[6558] = StringToText("    所以该能力会尽可能快地进行结算，从而使得在轮到驱魔人行动时，如果驱魔人选中了痢蛭，");
    g_tipLine[6559] = StringToText("    也不会因为「痢蛭无法因为自己的能力被唤醒」而导致「痢蛭没有宿主」的情况出现。");
    g_tipLine[6560] = StringToText("  · 士兵：如果士兵被痢蛭选为宿主，他不会中毒。然而，如果他因为任何原因死亡（被处决，半兽人等等），痢蛭也会死亡。");
    g_tipLine[6561] = StringToText("  · 莽夫：如果莽夫在首个夜晚被选为宿主，这会使得痢蛭醉酒直到下个黄昏，并且莽夫变为邪恶。如果莽夫在首个白天被处决，");
    g_tipLine[6562] = StringToText("    痢蛭仍然会死亡，因为莽夫的醉酒效果由于莽夫的死亡而消失了。莽夫在整局游戏中都不会因为痢蛭的能力中毒（可以将痢蛭的");
    g_tipLine[6563] = StringToText("    中毒标记倒转放置在莽夫的角色标记旁，仅做寄生的提示用），但如果他死亡，痢蛭也会死亡。");
    g_tipLine[6564] = StringToText("  · 疯子：如果疯子自认为是痢蛭，真正的恶魔会被告知疯子在首个夜晚选择谁作为宿主，但是，举例来说，");
    g_tipLine[6565] = StringToText("    这与疯子自认为是普卡并在首个夜晚做出选择没有什么区别——真正的恶魔不会知道这里面的区别。");
    g_tipLine[6566] = StringToText("  · 麻脸巫婆：如果创造出新的恶魔，仍然需要杀死宿主才能杀死痢蛭，麻脸巫婆不能无视痢蛭免死的能力。");
    g_tipLine[6567] = StringToText("  · 旅行者：可以被选为宿主，但不建议。因为如果旅行者离开，他死亡，并且痢蛭因此死亡。");
    g_tipLine[6568] = StringToText("  · 咖啡师：如果咖啡2不是在首个夜晚，痢蛭可以杀害两次。如果咖啡2在首个夜晚，痢蛭选择两名玩家，");
    g_tipLine[6569] = StringToText("    从现在开始他们两个都中毒。无论如何，必须这两名玩家都死亡，痢蛭才会死亡。");
    g_tipLine[6570] = StringToText("· 相克规则：");
    g_tipLine[6571] = StringToText("  · 猎手：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_tipLine[6572] = StringToText("  · 主谋：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[6573] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[6574] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6575] = StringToText("  · 半仙：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[6576] = StringToText("  · 使节：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[6577] = StringToText("  · 掮客：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipRoleAt[100] = 6538; g_tipRoleN[100] = 40;
    g_tipLine[6578] = StringToText("【角色能力】");
    g_tipLine[6579] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[邪恶角色全部邻座，你靠近正中，+1爪牙，-或+任意数量外来者]");
    g_tipLine[6580] = StringToText("【角色简介】");
    g_tipLine[6581] = StringToText("堤丰之首被爪牙围绕。");
    g_tipLine[6582] = StringToText("· 所有邪恶角色玩家全都连续相邻而坐。");
    g_tipLine[6583] = StringToText("· 在游戏开始时，堤丰之首的左右两侧必须都要有邪恶角色玩家。他不能位于一连串邪恶角色玩家队列的两侧。");
    g_tipLine[6584] = StringToText("· 邪恶阵营在游戏开始时有一名额外的爪牙。");
    g_tipLine[6585] = StringToText("· 可能会有任意数量的外来者在场。");
    g_tipLine[6586] = StringToText("· 与提线木偶相似，由说书人来决定哪名玩家在初始设置时成为爪牙。此外说书人还会决定爪牙的具体角色。");
    g_tipLine[6587] = StringToText("· 如果堤丰之首在游戏中途被创造，则他无需与其他邪恶角色玩家的位置相邻。");
    g_tipLine[6588] = StringToText("【规则细节】");
    g_tipLine[6589] = StringToText("· 虽然在运作方式中没有提到，然而堤丰之首在设置时也可以移除一部分原有的外来者，并用对应数量的镇民进行替换。");
    g_tipLine[6590] = StringToText("· 如果游戏因堤丰之首而导致有4名邪恶爪牙在场，那么堤丰之首可以不在这5名邪恶玩家的正中间（但不能位于一连串邪恶角色");
    g_tipLine[6591] = StringToText("  玩家队列的两侧）。");
    g_tipLine[6592] = StringToText("· 相克规则：");
    g_tipLine[6593] = StringToText("  · 召唤师：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[6594] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6595] = StringToText("  · 戏子：堤丰之首和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变成戏子，");
    g_tipLine[6596] = StringToText("    说书人会在这一效果生效之前先告知堤丰之首两侧的玩家是邪恶的爪牙。");
    g_tipRoleAt[111] = 6578; g_tipRoleN[111] = 19;
    g_tipLine[6597] = StringToText("【角色能力】");
    g_tipLine[6598] = StringToText("每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，可能会有一名玩家死亡。[+1爪牙]");
    g_tipLine[6599] = StringToText("【角色简介】");
    g_tipLine[6600] = StringToText("小怪宝不是玩家，而是被一名爪牙照顾的宝宝。");
    g_tipLine[6601] = StringToText("· 每个夜晚，所有爪牙玩家一起睁眼，他们秘密决定谁照顾小怪宝。爪牙们通过指向一名玩家或以其他明显的方式达成一致意见。");
    g_tipLine[6602] = StringToText("  如果他们不能达成一致，由说书人决定谁照顾小怪宝。");
    g_tipLine[6603] = StringToText("· 如果说书人觉得有趣，可以把小怪宝的角色标记交给正照顾小怪宝的玩家。他需要把小怪宝藏进他的口袋，放在他的帽子里，");
    g_tipLine[6604] = StringToText("  或其他合适的地方。玩家不能要求其他人清空他们的口袋。");
    g_tipLine[6605] = StringToText("· 正照顾小怪宝的玩家「是恶魔」。如果他死亡了，善良阵营获胜。他会被其他角色能力检测到「是恶魔」，例如占卜师。");
    g_tipLine[6606] = StringToText("· 如果一个善良玩家正照顾小怪宝，他「是恶魔」，但依旧是善良的。一个死亡玩家照顾小怪宝会让游戏结束，");
    g_tipLine[6607] = StringToText("  因为恶魔已经死亡了。");
    g_tipLine[6608] = StringToText("· 照顾小怪宝的玩家保留他原有的能力。");
    g_tipLine[6609] = StringToText("· 小怪宝不是玩家，所以不会醉酒或中毒。");
    g_tipLine[6610] = StringToText("【规则细节】");
    g_tipLine[6611] = StringToText("· 小怪宝这个角色也会被视作是「在场角色」，但它不属于任何一名玩家，也无法被常规的「选择一名玩家」的能力选中。");
    g_tipLine[6612] = StringToText("· 「非指向性」的死亡效果可以杀死小怪宝，例如麻脸巫婆、小怪宝等角色的能力。在这种情况下，小怪宝死亡，");
    g_tipLine[6613] = StringToText("  并会因此移除小怪宝的角色标记与所有提示标记。从现在起，小怪宝会被视作是「不在场」来处理。");
    g_tipLine[6614] = StringToText("· 如果某个能力让一名玩家变成小怪宝，该玩家的角色不会发生变化，而是改为正在照看小怪宝。");
    g_tipLine[6615] = StringToText("  但如果是工程师选择让小怪宝在场，会让一名恶魔因此变成一个正在照看小怪宝的不在场爪牙。");
    g_tipLine[6616] = StringToText("  反之如果工程师选择了其他的恶魔而导致小怪宝需要发生角色变化，当前照看小怪宝的玩家会变成工程师所选择的恶魔，");
    g_tipLine[6617] = StringToText("  同时小怪宝会离场。");
    g_tipLine[6618] = StringToText("· 相克规则：");
    g_tipLine[6619] = StringToText("  · 红唇女郎：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[6620] = StringToText("  · 魔术师：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_tipLine[6621] = StringToText("  · 罂粟种植者：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，直到其中一名玩家选择照看小怪宝。");
    g_tipLine[6622] = StringToText("  · 帽匠：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[6623] = StringToText("  · 精神病患者：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[6624] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[6625] = StringToText("  · 维齐尔：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipRoleAt[112] = 6597; g_tipRoleN[112] = 29;
    g_tipLine[6626] = StringToText("【角色能力】");
    g_tipLine[6627] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，");
    g_tipLine[6628] = StringToText("  除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    g_tipLine[6629] = StringToText("【角色简介】");
    g_tipLine[6630] = StringToText("混沌伺机而动，能够让善良玩家集体中毒。");
    g_tipLine[6631] = StringToText("· 当混沌的攻击杀死一名玩家时，如果该玩家的角色是镇民，并且是与混沌最邻近的镇民玩家，混沌的中毒效果就会被触发，");
    g_tipLine[6632] = StringToText("  并持续到下个黄昏时。");
    g_tipLine[6633] = StringToText("· 即使杀死的是邪恶的镇民，只要该玩家是混沌最邻近的两名镇民玩家之一，混沌的中毒效果就会被触发。");
    g_tipLine[6634] = StringToText("· 如果混沌杀死的镇民会使得「死亡时触发的能力」被触发，那么混沌的中毒效果会在这些能力结算完毕后再触发。");
    g_tipLine[6635] = StringToText("· 如果混沌杀死镇民后导致游戏结束，那么混沌的中毒效果不会触发。");
    g_tipLine[6636] = StringToText("· 攻击已经死亡的镇民，或攻击但没有导致镇民的死亡，不会触发混沌的中毒效果。");
    g_tipLine[6637] = StringToText("· 在混沌的中毒效果的生效期间，只要玩家是善良阵营（旅行者除外），就会受到中毒效果的影响，包括善良的爪牙和恶魔。");
    g_tipLine[6638] = StringToText("· 在混沌的中毒效果的生效期间，如果玩家转变为了善良阵营，就会立即中毒。反之，如果玩家转变为了邪恶阵营，");
    g_tipLine[6639] = StringToText("  就会立即解除混沌的中毒效果对他的影响。");
    g_tipLine[6640] = StringToText("【规则细节】");
    g_tipLine[6641] = StringToText("无额外规则。");
    g_tipRoleAt[121] = 6626; g_tipRoleN[121] = 16;
    g_tipLine[6642] = StringToText("【角色能力】");
    g_tipLine[6643] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。所有玩家都知道利维坦在场。在第五个白天结束时，邪恶阵营获胜。");
    g_tipLine[6644] = StringToText("【角色简介】");
    g_tipLine[6645] = StringToText("利维坦不进行任何杀戮。");
    g_tipLine[6646] = StringToText("· 所有玩家都会知道利维坦在场，即使利维坦在游戏过程中被创造也是如此。");
    g_tipLine[6647] = StringToText("· 可以有任意数量的邪恶玩家被处决，然而如果有多于一名善良玩家被处决，邪恶阵营获胜。被处决的角色是什么无关紧要，");
    g_tipLine[6648] = StringToText("  只看那名玩家在被处决的时候的阵营是什么。");
    g_tipLine[6649] = StringToText("· 当第五个白天结束时，如果利维坦仍然存活，邪恶阵营获胜。");
    g_tipLine[6650] = StringToText("· 不论何种类型的处决均会计算在内，即使处决没有让玩家死亡也会正常计算。被贞洁者处决，或者畸形秀演员自爆处决，");
    g_tipLine[6651] = StringToText("  都会计算在内。善良玩家被处决但因为和平主义者的能力仍然存活也会计算在内。");
    g_tipLine[6652] = StringToText("【规则细节】");
    g_tipLine[6653] = StringToText("· 不是利维坦的第五天触发邪恶阵营获胜的条件，而是游戏总天数。所以如果利维坦在第五天之后出现在游戏中，");
    g_tipLine[6654] = StringToText("  邪恶阵营立即获胜。");
    g_tipLine[6655] = StringToText("· 如果你选择每天播报利维坦在场的第几天，一旦利维坦醉酒/中毒，那么在当天不能宣布利维坦在场。");
    g_tipLine[6656] = StringToText("  当利维坦恢复清醒/健康时，可以再次宣布利维坦在场（如果还没有宣布过，则必须宣布）。");
    g_tipLine[6657] = StringToText("· 当利维坦中毒/醉酒时，处决不会算入利维坦获胜条件。如果利维坦在第五天是中毒/醉酒的，");
    g_tipLine[6658] = StringToText("  他在恢复清醒/健康之前不会获胜，但只要利维坦在第五天结束后的任意时候是清醒/健康的，游戏结束，邪恶阵营获胜。");
    g_tipLine[6659] = StringToText("· 同一名善良玩家被处决多次只会计入一次利维坦的获胜条件。");
    g_tipLine[6660] = StringToText("· 相克规则：");
    g_tipLine[6661] = StringToText("  · 士兵：如果利维坦提名并处决了士兵，善良阵营获胜。");
    g_tipLine[6662] = StringToText("  · 僧侣：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_tipLine[6663] = StringToText("  · 旅店老板：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[6664] = StringToText("  · 守鸦人：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果守鸦人被选择，");
    g_tipLine[6665] = StringToText("    他的能力生效但不会死亡。（建议在利维坦选择农夫/守鸦人/贤者并触发这些角色的能力后，这些角色失去能力）");
    g_tipLine[6666] = StringToText("  · 贤者：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果贤者被选择，");
    g_tipLine[6667] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[6668] = StringToText("  · 农夫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果农夫被选择，");
    g_tipLine[6669] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[6670] = StringToText("  · 镇长：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。");
    g_tipLine[6671] = StringToText("  · 报丧女妖：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果报丧女妖被选择，");
    g_tipLine[6672] = StringToText("    他死亡并能力生效。");
    g_tipLine[6673] = StringToText("  · 驱魔人：如果利维坦提名并处决了驱魔人上个夜晚选择的那名玩家，善良阵营获胜。");
    g_tipLine[6674] = StringToText("  · 祖母：如果利维坦在场，孙子死于处决，邪恶阵营获胜。");
    g_tipLine[6675] = StringToText("  · 国王：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[6676] = StringToText("  · 麻脸巫婆：利维坦不能在第五天之后加入游戏。");
    g_tipLine[6677] = StringToText("  · 帽匠：利维坦不能在第五天之后加入游戏。");
    g_tipLine[6678] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6679] = StringToText("  · 戏子：在戏子存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。说书人会在当晚杀死这名玩家。");
    g_tipLine[6680] = StringToText("  · 和尚：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[6681] = StringToText("  · 打更人：如果利维坦提名并处决了打更人上个夜晚猜测的其中一名玩家，善良阵营获胜。");
    g_tipLine[6682] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6683] = StringToText("    说书人会在当晚杀死这名玩家。");
    g_tipLine[6684] = StringToText("  · 狸猫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果「太子」被选择，");
    g_tipLine[6685] = StringToText("    他会与狸猫交换角色但不会死亡。");
    g_tipLine[6686] = StringToText("  · 巡察：如果利维坦提名并处决了巡察上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipRoleAt[127] = 6642; g_tipRoleN[127] = 45;
    g_tipLine[6687] = StringToText("【角色能力】");
    g_tipLine[6688] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可能会有一名玩家在这之后死亡。");
    g_tipLine[6689] = StringToText("【角色简介】");
    g_tipLine[6690] = StringToText("牙噶巴卜通过言语杀人。");
    g_tipLine[6691] = StringToText("· 说书人提供给牙噶巴卜的短语可以是任意长度，但建议是2到5个字左右。");
    g_tipLine[6692] = StringToText("· 如果牙噶巴卜说出了这段短语，说书人便可以在这之后，在下个黎明前的任意时机杀死一名玩家。");
    g_tipLine[6693] = StringToText("· 牙噶巴卜无论是通过单独说出这段短语，或将它混杂在整句话里说出，都可以触发效果。");
    g_tipLine[6694] = StringToText("· 牙噶巴卜可以在同一天多次说出这段短语。说书人可以因此杀死多名玩家。");
    g_tipLine[6695] = StringToText("· 由说书人来决定牙噶巴卜的能力会让哪名玩家死亡。");
    g_tipLine[6696] = StringToText("· 说书人可以选择只杀死少于牙噶巴卜说出短语的次数这一数量的玩家。");
    g_tipLine[6697] = StringToText("· 在牙噶巴卜醉酒或中毒期间，玩家不会因为他的能力死亡，即使牙噶巴卜在说出短语时清醒健康。在牙噶巴卜清醒健康期间，");
    g_tipLine[6698] = StringToText("  玩家会因为他的能力死亡，即使在牙噶巴卜在说出短语时醉酒或中毒。");
    g_tipLine[6699] = StringToText("· 只有极少数情况下，牙噶巴卜的能力才会让玩家在白天死亡。");
    g_tipLine[6700] = StringToText("【规则细节】");
    g_tipLine[6701] = StringToText("· 相克规则：");
    g_tipLine[6702] = StringToText("  · 驱魔人：如果驱魔人选中了牙噶巴卜，那么牙噶巴卜在当晚无法造成死亡。");
    g_tipLine[6703] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6704] = StringToText("  · 戏子：在戏子存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想要死亡」。不论他是否说过秘密短语，");
    g_tipLine[6705] = StringToText("    说书人都会在当晚杀死这名玩家。");
    g_tipLine[6706] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[6707] = StringToText("    不论他是否说过秘密短语，说书人都会在当晚杀死这名玩家。");
    g_tipRoleAt[133] = 6687; g_tipRoleN[133] = 21;
    g_tipLine[6708] = StringToText("【角色能力】");
    g_tipLine[6709] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会被你杀死。");
    g_tipLine[6710] = StringToText("【角色简介】");
    g_tipLine[6711] = StringToText("奥赫能够杀死特定的角色。");
    g_tipLine[6712] = StringToText("· 与其他恶魔不同，奥赫在攻击时选择的是角色，而不是玩家。说书人可能需要提醒玩家奥赫能力的特殊之处。");
    g_tipLine[6713] = StringToText("  建议在游戏进入到夜晚阶段时，让所有玩家将角色列表放在手边。");
    g_tipLine[6714] = StringToText("· 如果奥赫愿意，他可以杀死邪恶角色。");
    g_tipLine[6715] = StringToText("· 如果某个角色有多名玩家在场，且奥赫选择了这个角色，只会有一名玩家死亡。");
    g_tipLine[6716] = StringToText("· 如果奥赫选择了不在场的角色，说书人大多数情况下都会杀死一名存活的善良玩家。说书人杀死死亡玩家或邪恶玩家虽然可行，");
    g_tipLine[6717] = StringToText("  但这种情况会非常少见。");
    g_tipLine[6718] = StringToText("【规则细节】");
    g_tipLine[6719] = StringToText("无额外规则。");
    g_tipRoleAt[134] = 6708; g_tipRoleN[134] = 12;
    g_tipLine[6720] = StringToText("【角色能力】");
    g_tipLine[6721] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量外来者]");
    g_tipLine[6722] = StringToText("【角色简介】");
    g_tipLine[6723] = StringToText("卡扎力能自由选择自己的爪牙。");
    g_tipLine[6724] = StringToText("· 如果卡扎力在游戏中途被创造，他不会选择玩家成为新的爪牙。");
    g_tipLine[6725] = StringToText("· 说书人可以将这些变成爪牙的玩家的原本善良角色作为恶魔的伪装提供，因为这些角色都已不在场。");
    g_tipLine[6726] = StringToText("· 卡扎力对设置调整的效果在设置阶段和游戏的首个夜晚均会生效。");
    g_tipLine[6727] = StringToText("· 在唤醒这些爪牙，告诉他们自己的新角色的过程中，说书人可以让卡扎力见证这一过程，也可以让他先行入睡。");
    g_tipLine[6728] = StringToText("· 卡扎力只能选择位于角色列表上的爪牙。他不能选择让多名玩家变成同一个爪牙角色。");
    g_tipLine[6729] = StringToText("· 卡扎力能够将他想要的任意玩家变成爪牙，无论该名玩家的角色能力如何，例如：士兵，莽夫，落难少女，国王等。");
    g_tipLine[6730] = StringToText("【规则细节】");
    g_tipLine[6731] = StringToText("· 在不考虑与其他角色交互时的运作，卡扎力对于爪牙的转化可以按照「重复这个流程，");
    g_tipLine[6732] = StringToText("  直到场上有与初始设置时同等数量的爪牙」来理解。然而实际上卡扎力的转化的更标准的描述形式应该是「重复这个流程，");
    g_tipLine[6733] = StringToText("  直到卡扎力进行了等同于初始设置爪牙数量次数的选择」。");
    g_tipLine[6734] = StringToText("· 虽然在运作方式中没有提到，然而卡扎力在设置时也可以移除一部分原有的外来者，并用对应数量的镇民进行替换。");
    g_tipLine[6735] = StringToText("· 特定角色互动：");
    g_tipLine[6736] = StringToText("  · 村夫：如果有复数个村夫在场，卡扎力的设置调整优先生效，其他的村夫因卡扎力的能力变成了爪牙，");
    g_tipLine[6737] = StringToText("    剩下的那名村夫一定是清醒的，因为这时村夫已经只有一个了。");
    g_tipLine[6738] = StringToText("· 相克规则：");
    g_tipLine[6739] = StringToText("  · 赏金猎人：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_tipLine[6740] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[6741] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[6742] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6743] = StringToText("  · 戏子：卡扎力和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变成戏子，");
    g_tipLine[6744] = StringToText("    卡扎力会在这一效果生效之前先进行转变爪牙的行动。");
    g_tipRoleAt[135] = 6720; g_tipRoleN[135] = 25;
    g_tipAbility[21] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名爪牙会变成小恶魔。");
    g_tipAbility[43] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。当你首次死亡后，你仍存活，但会被当作死亡。");
    g_tipAbility[44] = StringToText("每个夜晚，你要选择一名玩家：他中毒。上个因你的能力中毒的玩家会死亡并恢复健康。");
    g_tipAbility[45] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipAbility[46] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipAbility[68] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipAbility[69] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipAbility[70] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。与你邻近的两名镇民中毒。");
    g_tipAbility[71] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。镇民玩家的能力都会产生错误信息。如果白天没人被处决，邪恶阵营获胜。");
    g_tipAbility[87] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，然后如果他们都存活则都死亡。");
    g_tipAbility[94] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。[多数玩家为军团]");
    g_tipAbility[100] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，只有当他处于死亡状态时你才会立即死亡。");
    g_tipAbility[111] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[邪恶角色全部邻座，你靠近正中，+1爪牙，-或+任意数量外来者]");
    g_tipAbility[112] = StringToText("每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，可能会有一名玩家死亡。[+1爪牙]");
    g_tipAbility[121] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    g_tipAbility[127] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。所有玩家都知道利维坦在场。在第五个白天结束时，邪恶阵营获胜。");
    g_tipAbility[133] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可能会有一名玩家在这之后死亡。");
    g_tipAbility[134] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会被你杀死。");
    g_tipAbility[135] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量外来者]");

    g_tipLine[4209] = StringToText("【角色能力】");
    g_tipLine[4210] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipLine[4211] = StringToText("【角色简介】");
    g_tipLine[4212] = StringToText("投毒者能秘密地干扰其他角色的能力。");
    g_tipLine[4213] = StringToText("· 每个夜晚，投毒者会选择一名玩家在当晚的剩余时间和接下来的一整个白天阶段里中毒。");
    g_tipLine[4214] = StringToText("· 中毒的玩家会失去能力，但说书人会装作他仍具有能力。他的能力不会真实地影响游戏。");
    g_tipLine[4215] = StringToText("  为了保证中毒的玩家处于未中毒的幻象中，说书人会在正确的时间下唤醒他，并如同他未中毒一样走过场来执行他的能力。");
    g_tipLine[4216] = StringToText("  如果中毒玩家的角色能力能够获取信息，说书人可以给他提供错误信息。");
    g_tipLine[4217] = StringToText("· 如果一名中毒的玩家在他中毒的期间里使用了「每局游戏限一次」的能力，他无法再次使用这项能力。");
    g_tipLine[4218] = StringToText("【规则细节】");
    g_tipLine[4219] = StringToText("· 虽然投毒者的能力描述中，中毒的持续时间看似与水手和旅店老板等有所差别，但实际上这只是为了新手玩家便于理解，");
    g_tipLine[4220] = StringToText("  而不用特意引出「黄昏」这个概念。实际上，投毒者的能力描述同样可以写为：「每个夜晚，你要选择一名玩家：");
    g_tipLine[4221] = StringToText("  他会中毒到下个黄昏。」");
    g_tipRoleAt[17] = 4209; g_tipRoleN[17] = 13;
    g_tipLine[4222] = StringToText("【角色能力】");
    g_tipLine[4223] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipLine[4224] = StringToText("【角色简介】");
    g_tipLine[4225] = StringToText("间谍知道所有人的具体角色。间谍看起来像是善良一员，但实际上是邪恶的。");
    g_tipLine[4226] = StringToText("· 如果任何角色的能力会探查或影响善良玩家，间谍可能会被那名角色当作善良阵营。");
    g_tipLine[4227] = StringToText("  如果任何角色的能力会探查或影响镇民角色或外来者角色，间谍可能会被那名角色当作是一个特定的镇民或外来者角色。");
    g_tipLine[4228] = StringToText("  由说书人来决定间谍被当作什么，在同一个夜晚间谍能被多次当作不同阵营或不同的角色。");
    g_tipLine[4229] = StringToText("· 间谍在被当作特定的镇民或外来者角色时，不会获得这一角色的能力。例如，被当作猎手的间谍无法猎杀恶魔。");
    g_tipLine[4230] = StringToText("【规则细节】");
    g_tipLine[4231] = StringToText("· 间谍有很多「可以但不建议」的内容，希望各位说书人在有间谍在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[4232] = StringToText("· 说书人不应该利用间谍能够被当作任意角色或阵营这一点，来将间谍在魔典中的角色标记替换成其他角色标记，");
    g_tipLine[4233] = StringToText("  以此向能够查看魔典的角色传递额外的信息。邪恶玩家之间的交流需要玩家自己自发进行，而且需要让善良玩家有迹可循。");
    g_tipLine[4234] = StringToText("· 间谍的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，");
    g_tipLine[4235] = StringToText("  那么间谍是有可能被当作「善良的间谍」或者是「邪恶的镇民」的（如食人族）。");
    g_tipLine[4236] = StringToText("· 养成良好的魔典使用习惯非常重要。这不仅仅是在有间谍或是寡妇的时候能确保他们获得正确的信息，");
    g_tipLine[4237] = StringToText("  也是对说书人记录繁杂的游戏信息并确保各项处理结算无误的重要支撑。必要时，");
    g_tipLine[4238] = StringToText("  说书人还应该利用提示标记以外的其他方式去记录信息，但这些信息不会被间谍得知。在线上游戏中，");
    g_tipLine[4239] = StringToText("  间谍不应该也无法看到说书人做的任何自定义笔记。");
    g_tipLine[4240] = StringToText("· 如果说书人觉得自己的某些提示标记处理可能与常规处理方式不同，想办法在白天时私下与间谍沟通（例如夜晚拍醒他并用手机");
    g_tipLine[4241] = StringToText("  打字示意让他白天来私聊你）来确保间谍正确理解了你魔典里的提示标记的位置和放置逻辑。");
    g_tipLine[4242] = StringToText("· 恶魔的三个不在场善良角色（即伪装）是否出现在魔典中，取决于说书人是否将伪装在展示给恶魔之后放在魔典中或放回剧本盒");
    g_tipLine[4243] = StringToText("  （剧本盒也位于魔典内的左侧下方，用于收纳不在场的角色和提示标记，但这些标记不会平铺在魔典左侧）。");
    g_tipLine[4244] = StringToText("  如果说书人选择在展示完后放回剧本盒，则间谍无法看到这一信息。");
    g_tipLine[4245] = StringToText("· 间谍查看魔典时，除去角色标记和提示标记之外，还能查看玩家的阵营。对于非旅行者角色标记，");
    g_tipLine[4246] = StringToText("  正面放置代表该玩家阵营与其角色初始阵营相同，倒转放置代表该玩家阵营与其角色初始阵营不同。对于旅行者角色标记，");
    g_tipLine[4247] = StringToText("  正面放置代表该玩家为善良阵营，倒转放置代表该玩家为邪恶阵营。");
    g_tipLine[4248] = StringToText("· 仅在暗流涌动这一剧本的实体版本中，间谍的夜晚顺序位于投毒者（首夜）和僧侣（非首夜）之后（与常规顺序的区别在于，");
    g_tipLine[4249] = StringToText("  不会看到小恶魔的「死亡」标记和管家的「主人」标记，且在小恶魔自杀的那个夜晚，自己变成小恶魔之前仍能查看魔典）。");
    g_tipLine[4250] = StringToText("  这是为了避免新人玩家在一开始接触到间谍这一需要处理大量信息的角色显得棘手，而避免了冗杂信息的发生。");
    g_tipLine[4251] = StringToText("  同时也给出了足够的时间允许间谍在入睡后继续进行思考。（如果间谍在管家之后被唤醒，");
    g_tipLine[4252] = StringToText("  则有可能会因为查看魔典的时间太长而被管家玩家意识到场上可能有间谍。）当玩家熟悉游戏之后，");
    g_tipLine[4253] = StringToText("  间谍还是应当参考线上魔典的顺序，在将近黎明的时候被唤醒。");
    g_tipLine[4254] = StringToText("· 查看魔典也属于「获取信息」。如果间谍醉酒或中毒，说书人对他展示的魔典内容可能会是错误的。");
    g_tipLine[4255] = StringToText("· 相克规则：");
    g_tipLine[4256] = StringToText("  · 魔术师：当间谍查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_tipLine[4257] = StringToText("  · 炼金术士：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。每次处决后，");
    g_tipLine[4258] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[4259] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_tipLine[4260] = StringToText("  · 落难少女：如果间谍正在场或曾经在场，落难少女中毒。");
    g_tipLine[4261] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4262] = StringToText("  · 瘟疫医生：如果说书人本应获得间谍的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[4263] = StringToText("  · 食人魔：间谍必定被食人魔当作邪恶阵营。");
    g_tipLine[4264] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4265] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4266] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[18] = 4222; g_tipRoleN[18] = 45;
    g_tipLine[4267] = StringToText("【角色能力】");
    g_tipLine[4268] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipLine[4269] = StringToText("【角色简介】");
    g_tipLine[4270] = StringToText("红唇女郎会在恶魔死亡时变成恶魔。");
    g_tipLine[4271] = StringToText("· 如果在恶魔死前有五名或更多的玩家存活；或者说，如果在恶魔死后有四名或更多的玩家存活，那么红唇女郎会立刻变成恶魔，");
    g_tipLine[4272] = StringToText("  游戏会如同恶魔尚未死亡一样继续进行。");
    g_tipLine[4273] = StringToText("· 当红唇女郎的能力触发时，旅行者的数量不会计算在内。");
    g_tipLine[4274] = StringToText("· 如果在恶魔被处决时少于五名玩家存活，游戏会结束，并且善良阵营获胜。");
    g_tipLine[4275] = StringToText("· 如果在小恶魔选择自杀时，有五名或更多的玩家存活，必须是由红唇女郎来变成新的小恶魔。（前提是，");
    g_tipLine[4276] = StringToText("  红唇女郎此时能力正常生效）");
    g_tipLine[4277] = StringToText("· 如果红唇女郎变成了恶魔，她在各种意义上都会成为恶魔。如果她被处决，善良阵营会获胜。她会在每个晚上攻击玩家。");
    g_tipLine[4278] = StringToText("  她被当作恶魔。");
    g_tipLine[4279] = StringToText("【规则细节】");
    g_tipLine[4280] = StringToText("· 特定角色互动：");
    g_tipLine[4281] = StringToText("  · 痢蛭：当宿主死亡时，如果在宿主死亡之前，场上除旅行者外存活玩家人数为5人，红唇女郎不会因此变成痢蛭。");
    g_tipLine[4282] = StringToText("    因为在痢蛭死亡时，场上的存活玩家的人数已经不足5人。（宿主与痢蛭的死亡并非同时进行的）");
    g_tipLine[4283] = StringToText("· 相克规则：");
    g_tipLine[4284] = StringToText("  · 瘟疫医生：如果说书人本应获得红唇女郎的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[4285] = StringToText("  · 哈迪寂亚：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[4286] = StringToText("  · 小怪宝：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[4287] = StringToText("  · 方古：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[4288] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4289] = StringToText("  · 梼杌：红唇女郎在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[4290] = StringToText("  · 入殓师：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[4291] = StringToText("  · 孟婆：如果恶魔选择死亡且红唇女郎即将变成恶魔，改为恶魔与红唇女郎交换角色，随后原恶魔死亡。");
    g_tipRoleAt[19] = 4267; g_tipRoleN[19] = 25;
    g_tipLine[4292] = StringToText("【角色能力】");
    g_tipLine[4293] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipLine[4294] = StringToText("【角色简介】");
    g_tipLine[4295] = StringToText("男爵会改变在场的外来者数量。");
    g_tipLine[4296] = StringToText("· 外来者的数量变化会发生在初始设置时，且不会因为男爵死亡而恢复成原本的数量。对角色在初始设置时的更改，");
    g_tipLine[4297] = StringToText("  而在游戏过程中不产生影响的能力，都会在角色列表和角色标记上以方括号标注在角色描述的末尾——就像[这样]。");
    g_tipLine[4298] = StringToText("· 增加的外来者角色总是会替换掉原本的镇民角色，而不是其他角色类型。");
    g_tipLine[4299] = StringToText("【规则细节】");
    g_tipLine[4300] = StringToText("· 相克规则：");
    g_tipLine[4301] = StringToText("  · 瘟疫医生：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[4302] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[20] = 4292; g_tipRoleN[20] = 11;
    g_tipLine[4303] = StringToText("【角色能力】");
    g_tipLine[4304] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。 如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：");
    g_tipLine[4305] = StringToText("  他死亡。[-1或+1外来者]");
    g_tipLine[4306] = StringToText("【角色简介】");
    g_tipLine[4307] = StringToText("教父会在小镇杀害外来者时进行报复。");
    g_tipLine[4308] = StringToText("· 每当一名外来者死于处决，教父会在当晚选择一名玩家，使其死亡。");
    g_tipLine[4309] = StringToText("· 只有外来者在白天死去时，教父才能杀死玩家。夜晚死亡的外来者不算在内。");
    g_tipLine[4310] = StringToText("· 如果教父在场，会在场上增加或减少一个外来者。");
    g_tipLine[4311] = StringToText("· 在游戏开始时，教父会得知哪些外来者在场。");
    g_tipLine[4312] = StringToText("· 如果今天白天有两名外来者玩家死亡，当晚教父仍然只能杀死一名玩家。");
    g_tipLine[4313] = StringToText("【规则细节】");
    g_tipLine[4314] = StringToText("· 相克规则：");
    g_tipLine[4315] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4316] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4317] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[39] = 4303; g_tipRoleN[39] = 15;
    g_tipLine[4318] = StringToText("【角色能力】");
    g_tipLine[4319] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipLine[4320] = StringToText("【角色简介】");
    g_tipLine[4321] = StringToText("魔鬼代言人能在处决中拯救玩家。");
    g_tipLine[4322] = StringToText("· 每个夜晚，魔鬼代言人需要选择一名存活的玩家，保护他不会因处决而死亡。在下一个白天，如果该玩家被处决，");
    g_tipLine[4323] = StringToText("  处决会成功但该玩家依然存活。");
    g_tipLine[4324] = StringToText("· 魔鬼代言人不能连续两个夜晚选择同一名玩家，无论该玩家是否从处决中被救出，");
    g_tipLine[4325] = StringToText("  并且魔鬼代言人也不能选择被当作死亡的僵怖。");
    g_tipLine[4326] = StringToText("【规则细节】");
    g_tipLine[4327] = StringToText("无");
    g_tipRoleAt[40] = 4318; g_tipRoleN[40] = 10;
    g_tipLine[4328] = StringToText("【角色能力】");
    g_tipLine[4329] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipLine[4330] = StringToText("【角色简介】");
    g_tipLine[4331] = StringToText("刺客能杀死恶魔解决不掉的麻烦角色。");
    g_tipLine[4332] = StringToText("· 每局游戏限一次，在夜晚，刺客能杀死一名玩家。即使该玩家受到了包括角色能力在内的任何方式的保护而免于死亡，");
    g_tipLine[4333] = StringToText("  也依然会死亡。");
    g_tipLine[4334] = StringToText("· 刺客的能力如常受到醉酒和中毒的影响。");
    g_tipLine[4335] = StringToText("· 如果刺客攻击了莽夫，莽夫会死去并转变为邪恶阵营。");
    g_tipLine[4336] = StringToText("· 如果刺客攻击了尚未触发能力的僵怖（不论因为什么理由），僵怖会死去，但在死后触发能力且仍存活。");
    g_tipRoleAt[41] = 4328; g_tipRoleN[41] = 9;
    g_tipLine[4337] = StringToText("【角色能力】");
    g_tipLine[4338] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，");
    g_tipLine[4339] = StringToText("  他的阵营落败。");
    g_tipLine[4340] = StringToText("【角色简介】");
    g_tipLine[4341] = StringToText("主谋在恶魔死亡后仍然有方法获胜。");
    g_tipLine[4342] = StringToText("· 如果最后一名存活的恶魔死于处决，游戏继续。玩家们不会得知刚死去的是恶魔。在下一个白天，");
    g_tipLine[4343] = StringToText("  如果一名善良玩家被处决——无论该玩家是否死于处决——邪恶阵营获胜。如果一名邪恶玩家被处决，或者没有人被处决，");
    g_tipLine[4344] = StringToText("  则善良阵营获胜。");
    g_tipLine[4345] = StringToText("· 已死亡的恶魔无法进行攻击，如常失去自己的能力。在这个额外的夜晚和白天，其他角色的能力会正常生效。");
    g_tipLine[4346] = StringToText("· 如果恶魔死亡且只剩余两名存活玩家，游戏仍然会额外进行一天——邪恶阵营不会因为只剩两名存活玩家而获胜，");
    g_tipLine[4347] = StringToText("  而善良阵营也不会因为杀死了恶魔而获胜。主谋的能力为「额外进行一天一夜」，此能力会覆盖游戏常规规则。");
    g_tipLine[4348] = StringToText("【规则细节】");
    g_tipLine[4349] = StringToText("· 相克规则：");
    g_tipLine[4350] = StringToText("  · 哈迪寂亚：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：如果他们都选择存活，邪恶阵营获胜。");
    g_tipLine[4351] = StringToText("    否则，善良阵营获胜。");
    g_tipLine[4352] = StringToText("  · 痢蛭：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[4353] = StringToText("  · 炼金术士：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_tipLine[4354] = StringToText("  · 亡骨魔：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipLine[4355] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4356] = StringToText("  · 梼杌：主谋在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[4357] = StringToText("  · 姑获鸟：如果姑获鸟死亡，获得主谋能力的姑获鸟保留主谋的能力。");
    g_tipRoleAt[42] = 4337; g_tipRoleN[42] = 21;
    g_tipLine[4358] = StringToText("【角色能力】");
    g_tipLine[4359] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。 如果其中善良玩家被处决，邪恶阵营获胜。 如果你们都存活，");
    g_tipLine[4360] = StringToText("  善良阵营无法获胜。");
    g_tipLine[4361] = StringToText("【角色简介】");
    g_tipLine[4362] = StringToText("镜像双子会与对立阵营一人互为镜像，其他玩家不知道双子的正邪。");
    g_tipLine[4363] = StringToText("· 由说书人来选择镜像双子与一名对立阵营玩家配对，被选择的玩家是对立双子。");
    g_tipLine[4364] = StringToText("· 在首个夜晚，双子两人会被一同唤醒，并得知对方的角色。");
    g_tipLine[4365] = StringToText("· 如果双子中善良一方被处决，邪恶阵营获胜。如果邪恶一方被处决，游戏继续。死去的镜像双子会失去能力，");
    g_tipLine[4366] = StringToText("  如果在他死后处决善良双子，邪恶阵营不会获胜。");
    g_tipLine[4367] = StringToText("· 两个双子都存活时善良阵营无法获胜。此时即使恶魔死亡，游戏也会继续。善良阵营要杀死镜像双子以取得胜利。");
    g_tipLine[4368] = StringToText("· 如果一名善良玩家变成了镜像双子，他仍然是善良玩家，此时一名邪恶玩家成为他的对立双子。");
    g_tipLine[4369] = StringToText("  另一个双子是什么角色并不重要，真正重要的是他们的阵营，好人可以安全处决邪恶的双子，但如果处决的是善良的双子，");
    g_tipLine[4370] = StringToText("  邪恶阵营获胜。");
    g_tipLine[4371] = StringToText("· 如果两个双子都是相同阵营，则由说书人为镜像双子重新选择一名玩家成为对立双子。");
    g_tipLine[4372] = StringToText("【规则细节】");
    g_tipLine[4373] = StringToText("· 在游玩梦殒春宵剧本时，以上述运作方式来唤醒镜像双子与对立双子是没有任何问题的，");
    g_tipLine[4374] = StringToText("  但是这一方式在扩展到其他混合剧本的时候可能会出现问题。（例如镜像双子被传教士影响，");
    g_tipLine[4375] = StringToText("  或有涡流在场时炼金术士获得了镜像双子的能力，等等。）我们建议说书人在熟悉镜像双子的角色能力逻辑之后，");
    g_tipLine[4376] = StringToText("  分别单独唤醒镜像双子和其对立双子，并用原本的提示方式对两名玩家单独进行提示，而不是让他们进行眼神接触来确认。");
    g_tipLine[4377] = StringToText("· 相克规则：");
    g_tipLine[4378] = StringToText("  · 瘟疫医生：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[4379] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4380] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4381] = StringToText("  · 梼杌：镜像双子在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[4382] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4383] = StringToText("  · 姑获鸟：如果姑获鸟获得了镜像双子的能力，新对立双子会知道「姑获鸟在场」，但不会知道姑获鸟是谁。");
    g_tipRoleAt[64] = 4358; g_tipRoleN[64] = 26;
    g_tipLine[4384] = StringToText("【角色能力】");
    g_tipLine[4385] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipLine[4386] = StringToText("【角色简介】");
    g_tipLine[4387] = StringToText("女巫能诅咒玩家，被诅咒的玩家如果发起提名，就会被咒杀。");
    g_tipLine[4388] = StringToText("· 每个夜晚，女巫会选择一名玩家诅咒。那名玩家如果在下个白天提名了任何玩家，就会死亡。尽管如此，他的提名仍然生效。");
    g_tipLine[4389] = StringToText("· 女巫的诅咒只持续一个白天，但女巫可以每晚一次又一次地诅咒同一名玩家。");
    g_tipLine[4390] = StringToText("· 只剩三名玩家存活时，女巫的诅咒立即解除，女巫也无法再进行夜晚行动。");
    g_tipRoleAt[65] = 4384; g_tipRoleN[65] = 7;
    g_tipLine[4391] = StringToText("【角色能力】");
    g_tipLine[4392] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipLine[4393] = StringToText("【角色简介】");
    g_tipLine[4394] = StringToText("洗脑师促使玩家假装成与自己实际角色不同的角色。");
    g_tipLine[4395] = StringToText("· 洗脑师会选择让一名玩家「疯狂」地证明自己是某个镇民或外来者角色。被选择的玩家明天必须试图说服其他玩家相信他是这个");
    g_tipLine[4396] = StringToText("  角色，否则就会死亡。");
    g_tipLine[4397] = StringToText("· 简短的暗示不足以避免死亡。玩家必须付出努力说服其他玩家。虽然疯狂的玩家不会被强迫一定要说出他不想说的东西，");
    g_tipLine[4398] = StringToText("  但是如果说书人感受不到他的努力，他就会付出代价。");
    g_tipLine[4399] = StringToText("· 疯狂的邪恶玩家可能会以这种方式被处决，但「可能」意味着你可以选择不这么做，以防止邪恶玩家通过这种策略获胜。");
    g_tipLine[4400] = StringToText("· 像畸形秀演员一样，执行处决惩罚计入每天的处决限制。");
    g_tipLine[4401] = StringToText("【规则细节】");
    g_tipLine[4402] = StringToText("· 相克规则：");
    g_tipLine[4403] = StringToText("  · 哥布林：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipRoleAt[66] = 4391; g_tipRoleN[66] = 13;
    g_tipLine[4404] = StringToText("【角色能力】");
    g_tipLine[4405] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，");
    g_tipLine[4406] = StringToText("  当晚的死亡由说书人决定。");
    g_tipLine[4407] = StringToText("【角色简介】");
    g_tipLine[4408] = StringToText("麻脸巫婆能将玩家变为不同的角色。");
    g_tipLine[4409] = StringToText("· 除首个夜晚以外的每个夜晚，麻脸巫婆需要选择一名玩家和一个角色，那名玩家变为她选择的角色。");
    g_tipLine[4410] = StringToText("· 她无法创造重复角色，如果那个角色已在场，则无事发生。");
    g_tipLine[4411] = StringToText("【规则细节】");
    g_tipLine[4412] = StringToText("· 说书人应该如何处理「因为麻脸巫婆创造了恶魔」而导致的死亡：");
    g_tipLine[4413] = StringToText("  · 麻脸巫婆造成死亡的时间范围为当前剧本中首个能够造成死亡的恶魔行动开始前，到最后一个能够造成死亡的恶魔行动结束后。");
    g_tipLine[4414] = StringToText("  · 在这个期间，说书人能够自由决定是否让某名玩家死亡，或让被恶魔攻击的某名玩家存活。");
    g_tipLine[4415] = StringToText("  · 说书人在这个时间范围内，可以分别在不同的恶魔行动前或后多次执行造成或阻止死亡的效果。");
    g_tipLine[4416] = StringToText("  · 一旦说书人决定杀死某个还未唤醒的恶魔，这名恶魔玩家当晚就不会被唤醒。否则，就需要唤醒这名玩家。");
    g_tipLine[4417] = StringToText("    这对于在创造出哈迪寂亚等带有特殊效果的恶魔时非常重要。");
    g_tipLine[4418] = StringToText("  · 说书人只能造成更多的死亡或阻止原本要发生的死亡，其他类型的恶魔能力无法阻止，如普卡的中毒、哈迪寂亚的复活等。");
    g_tipLine[4419] = StringToText("  · 不建议说书人阻止恶魔成功攻击的玩家的死亡，并再自己决定让这名玩家死亡，因为这会造成更多的混乱。");
    g_tipLine[4420] = StringToText("    恶魔攻击后无法杀死某名玩家再由说书人决定杀死，这种情况不算在内。");
    g_tipLine[4421] = StringToText("  · 说书人造成的死亡视为麻脸巫婆造成，因此不会触发贤者、唱诗男孩等角色的能力，");
    g_tipLine[4422] = StringToText("    也能够成功杀死士兵（如果麻脸巫婆没有照看小怪宝的话）。");
    g_tipLine[4423] = StringToText("  · 只要麻脸巫婆创造了恶魔，即使在那之后麻脸巫婆离场、失去能力或死亡，当晚说书人仍然可以决定造成或阻止死亡。");
    g_tipLine[4424] = StringToText("  · 说书人只能阻止恶魔造成的死亡，由非恶魔玩家造成的死亡无法阻止。");
    g_tipLine[4425] = StringToText("· 相克规则：");
    g_tipLine[4426] = StringToText("  · 村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，村夫的醉酒效果可能会更换目标。");
    g_tipLine[4427] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4428] = StringToText("  · 落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[4429] = StringToText("  · 异教领袖/政客/莽夫/食人魔：被麻脸巫婆创造的邪恶异教领袖/政客/莽夫/食人魔无法因为自身能力转变为善良阵营。");
    g_tipLine[4430] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[4431] = StringToText("  · 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[4432] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4433] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4434] = StringToText("  · 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[4435] = StringToText("  · 戏子（改）：麻脸巫婆无法创造戏子（改），麻脸巫婆创造的邪恶玩家无法获得戏子（改）的能力。");
    g_tipRoleAt[67] = 4404; g_tipRoleN[67] = 32;
    g_tipLine[4436] = StringToText("【角色能力】");
    g_tipLine[4437] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[4438] = StringToText("【角色简介】");
    g_tipLine[4439] = StringToText("寡妇查看魔典并毒害一名她选择的玩家。");
    g_tipLine[4440] = StringToText("· 寡妇仅在她的首个夜晚行动并使一名玩家中毒。");
    g_tipLine[4441] = StringToText("· 因寡妇中毒的玩家会一直保持中毒直到寡妇死亡。");
    g_tipLine[4442] = StringToText("· 在寡妇行动的那个夜晚，会有一名善良玩家知道寡妇在场，他不会得知谁是寡妇，也不会得知谁中毒了。");
    g_tipLine[4443] = StringToText("【规则细节】");
    g_tipLine[4444] = StringToText("· 相克规则：");
    g_tipLine[4445] = StringToText("  · 魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_tipLine[4446] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[4447] = StringToText("  · 炼金术士：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。每次处决后，");
    g_tipLine[4448] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[4449] = StringToText("  · 落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[4450] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4451] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4452] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4453] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[75] = 4436; g_tipRoleN[75] = 18;
    g_tipLine[4454] = StringToText("【角色能力】");
    g_tipLine[4455] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。 如果你被处决，提名你的玩家需要和你猜拳，");
    g_tipLine[4456] = StringToText("  只有你输了你才会死亡。");
    g_tipLine[4457] = StringToText("【角色简介】");
    g_tipLine[4458] = StringToText("精神病患者在光天化日之下展开杀戮。");
    g_tipLine[4459] = StringToText("· 在白天时，如果精神病患者宣布自己是精神病患者并公开选择一名玩家，那名玩家死亡。这个能力每个白天只能使用一次，");
    g_tipLine[4460] = StringToText("  且只能在说书人要求开始提名前进行。");
    g_tipLine[4461] = StringToText("· 精神病患者的能力并非强制使用，他可以在自己不想要使用能力时不这么做。");
    g_tipLine[4462] = StringToText("· 精神病患者能够正常被提名和投票。如果精神病患者被处决，他可能不会死亡。");
    g_tipLine[4463] = StringToText("  他会和提名他的玩家进行一次猜拳（石头剪刀布）。提名他的玩家需要赢得猜拳才能让这次处决成功杀死精神病患者。");
    g_tipLine[4464] = StringToText("  如果平局或者猜拳失败，精神病患者会仍然存活。");
    g_tipLine[4465] = StringToText("· 对精神病患者的处决同样计入每个白天限制一次的次数里。如果精神病患者被处决，");
    g_tipLine[4466] = StringToText("  那么今天白天不会再有其他提名和处决发生了。");
    g_tipLine[4467] = StringToText("· 如果精神病患者因为其他原因死亡，例如恶魔的攻击，那么他不会进行猜拳，而是直接死亡。");
    g_tipLine[4468] = StringToText("【规则细节】");
    g_tipLine[4469] = StringToText("· 特定角色互动：");
    g_tipLine[4470] = StringToText("  · 炼金术士：如果炼金术士获得精神病患者的能力并提名贞洁者而因此被处决，他将会和说书人猜拳。");
    g_tipLine[4471] = StringToText("  · 咖啡师：「行动两次」的效果将允许精神病患者在白天杀死2人（咖啡师可能会被立即流放），");
    g_tipLine[4472] = StringToText("    但如果在接下来的这个白天精神病患者被处决，仍然只会进行一次猜拳。");
    g_tipLine[4473] = StringToText("  · 屠夫：每天都可以重新提名精神病患者来进行第二次处决并尝试杀死他。");
    g_tipLine[4474] = StringToText("  · 魔鬼代言人 ：即使受到魔鬼代言人的保护，精神病患者仍然应该进行猜拳，只有当他输了时，");
    g_tipLine[4475] = StringToText("    善良阵营才会发现精神病患者受到了魔鬼代言人的保护，因为精神病患者没有死于一次「猜拳胜利」的处决。");
    g_tipLine[4476] = StringToText("  · 弄臣/水手/茶艺师：如果精神病患者的目标不能死亡，目标不会死亡。这会被数学家记录。");
    g_tipLine[4477] = StringToText("  · 法官：如果法官强制使对精神病患者的提名通过，这只能确保精神病患者被处决，并且将需要进行猜拳来确定他是否会死亡。");
    g_tipLine[4478] = StringToText("  · 呆瓜/月之子：如果精神病患者杀死他，他会在白天得知他的死亡，因此必须在同一天做出选择。");
    g_tipLine[4479] = StringToText("  · 亡骨魔：如果精神病患者被亡骨魔杀死并因此在死亡状态保留了他的能力，如果他在死亡状态被处决，");
    g_tipLine[4480] = StringToText("    则没有必要进行猜拳——他已经死亡，因此无论猜拳的结果如何都不会再次死亡。");
    g_tipLine[4481] = StringToText("· 相克规则：");
    g_tipLine[4482] = StringToText("  · 小怪宝：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[4483] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4484] = StringToText("  · 姑获鸟：如果姑获鸟获得了精神病患者的能力，他会在被处决时死亡。");
    g_tipRoleAt[84] = 4454; g_tipRoleN[84] = 31;
    g_tipLine[4485] = StringToText("【角色能力】");
    g_tipLine[4486] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipLine[4487] = StringToText("【角色简介】");
    g_tipLine[4488] = StringToText("灵言师向善良玩家提出一笔交易：是否要转为邪恶。");
    g_tipLine[4489] = StringToText("· 在首个夜晚，灵言师从说书人处得知一个关键词。");
    g_tipLine[4490] = StringToText("· 如果善良玩家说出了关键词，不论是公开说出或是私下对说书人说出，他就会在当晚转为邪恶阵营。");
    g_tipLine[4491] = StringToText("  前提条件是说书人需要实际听到那名玩家确切地说出了这个关键词。");
    g_tipLine[4492] = StringToText("· 灵言师不会得知是否有玩家转为了邪恶。说出关键词的善良玩家直到当晚才会得知他是否转为了邪恶。");
    g_tipLine[4493] = StringToText("· 如果灵言师在夜晚是清醒且健康的，那么即使他在白天善良玩家说出关键词时醉酒或中毒，仍然会让这名善良玩家转为邪恶。");
    g_tipLine[4494] = StringToText("  但如果一名玩家即将在夜里转为邪恶时灵言师醉酒中毒了，那么那名玩家会仍然保持善良阵营不变——灵言师会因此消耗他的能力");
    g_tipLine[4495] = StringToText("  的使用次数，并且无法在随后再让其他玩家转为邪恶阵营。");
    g_tipRoleAt[85] = 4485; g_tipRoleN[85] = 11;
    g_tipLine[4496] = StringToText("【角色能力】");
    g_tipLine[4497] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipLine[4498] = StringToText("【角色简介】");
    g_tipLine[4499] = StringToText("提线木偶对自己是爪牙一事全然不知。");
    g_tipLine[4500] = StringToText("· 提线木偶会从盲抽袋中抽取到一个镇民或外来者角色，但是他实际上是提线木偶。");
    g_tipLine[4501] = StringToText("· 提线木偶与恶魔是邻座。他们之间不会有其他的玩家。");
    g_tipLine[4502] = StringToText("· 恶魔会知道哪一名玩家是提线木偶。");
    g_tipLine[4503] = StringToText("· 提线木偶不会在游戏的首个夜晚被唤醒以得知其他邪恶玩家都有谁，其他爪牙也不会得知谁是提线木偶。");
    g_tipLine[4504] = StringToText("· 认为自己是提线木偶的玩家所抽取到的善良角色对应的能力不会产生任何效果，但说书人会假装这些效果生效了。");
    g_tipLine[4505] = StringToText("  这与酒鬼的运作方式相似。");
    g_tipLine[4506] = StringToText("· 提线木偶在互动时被当作邪恶阵营以及爪牙角色。");
    g_tipLine[4507] = StringToText("· 提线木偶不会因其他角色能力导致他确认自己是爪牙而被唤醒。例如：告密者，传教士，小怪宝，罂粟种植者，帽匠，");
    g_tipLine[4508] = StringToText("  落难少女等。");
    g_tipLine[4509] = StringToText("【规则细节】");
    g_tipLine[4510] = StringToText("· 相克规则：");
    g_tipLine[4511] = StringToText("  · 瘟疫医生：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[4512] = StringToText("  · 小怪宝：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[4513] = StringToText("  · 气球驾驶员：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_tipLine[4514] = StringToText("  · 巡山人：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_tipLine[4515] = StringToText("  · 召唤师：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[4516] = StringToText("  · 卡扎力：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[4517] = StringToText("  · 炼金术士：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一定在场。");
    g_tipLine[4518] = StringToText("  · 魔术师：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_tipLine[4519] = StringToText("  · 数学家：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_tipLine[4520] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4521] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4522] = StringToText("  · 梼杌：梼杌不会得知谁是提线木偶。在梼杌使得提线木偶失去能力后，梼杌会得知对应的那一名提线木偶是谁，");
    g_tipLine[4523] = StringToText("    但提线木偶会仍然以为自己是一个善良角色。");
    g_tipLine[4524] = StringToText("  · 姑获鸟：姑获鸟无法获得提线木偶的能力。");
    g_tipRoleAt[93] = 4496; g_tipRoleN[93] = 29;
    g_tipLine[4525] = StringToText("【角色能力】");
    g_tipLine[4526] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipLine[4527] = StringToText("【角色简介】");
    g_tipLine[4528] = StringToText("巫师许下愿望。");
    g_tipLine[4529] = StringToText("· 这个愿望只受限于玩家的想象力，它可以是任何事。巫师可以在夜晚用手机屏幕展示愿望内容给说书人，");
    g_tipLine[4530] = StringToText("  也可以在白天私下告诉说书人。如果巫师有些鲁莽，他也可以公开许愿。");
    g_tipLine[4531] = StringToText("· 说书人不必立刻公开宣布巫师许下了愿望，而是可以稍后再宣布。");
    g_tipLine[4532] = StringToText("· 许多愿望都伴随着代价。代价可能会以某种方式影响游戏，或是影响这个愿望本身。它也可以是任何事，");
    g_tipLine[4533] = StringToText("  由说书人认真思考后决定。说书人可以决定是否告诉巫师愿望的代价。代价的目的是为了从能力的效果上平衡这个愿望，");
    g_tipLine[4534] = StringToText("  以免它对善良阵营造成不公平的影响。");
    g_tipLine[4535] = StringToText("· 许多愿望会留下线索。线索可以是任何事，由说书人认真思考后决定，然后再公开宣布。");
    g_tipLine[4536] = StringToText("  线索的目的是为了从信息上平衡这个愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[4537] = StringToText("· 当巫师死亡，愿望可能会继续生效，也可能会失效，取决于愿望和代价具体是什么。");
    g_tipLine[4538] = StringToText("· 如果巫师许了一个说书人不理解的愿望，或者说书人认为他无法实现，说书人可以让巫师重新许愿，或者告诉巫师，");
    g_tipLine[4539] = StringToText("  他的愿望被消耗了。");
    g_tipRoleAt[98] = 4525; g_tipRoleN[98] = 15;
    g_tipLine[4540] = StringToText("【角色能力】");
    g_tipLine[4541] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipLine[4542] = StringToText("【角色简介】");
    g_tipLine[4543] = StringToText("哥布林会在小镇明知他是哥布林却要处决他时采取报复。");
    g_tipLine[4544] = StringToText("· 如果哥布林被处决，邪恶阵营获胜。");
    g_tipLine[4545] = StringToText("· 为了让这种情况发生，哥布林需要在被提名后，开始投票前告知其他玩家他是哥布林。他的公开宣言需要让所有人都听见，");
    g_tipLine[4546] = StringToText("  因为善良玩家必须清楚自己接下来的行为所带来的风险。");
    g_tipLine[4547] = StringToText("· 如果哥布林没有公布自己的角色就被处决了，那么哥布林死亡，游戏如常进行。");
    g_tipLine[4548] = StringToText("· 哥布林必须在被处决的当天宣布自己的角色，只有这样他的能力才会生效。在前一天或更早的时间里宣布不会产生效果。");
    g_tipLine[4549] = StringToText("· 任何玩家都可以在被提名时声称自己是哥布林。");
    g_tipLine[4550] = StringToText("【规则细节】");
    g_tipLine[4551] = StringToText("· 相克规则：");
    g_tipLine[4552] = StringToText("  · 瘟疫医生：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[4553] = StringToText("  · 洗脑师：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[4554] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4555] = StringToText("  · 戏子：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[4556] = StringToText("  · 戏子（改）：戏子（改）无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[4557] = StringToText("  · 姑获鸟：姑获鸟无法获得哥布林的能力。");
    g_tipRoleAt[99] = 4540; g_tipRoleN[99] = 18;
    g_tipLine[4558] = StringToText("【角色能力】");
    g_tipLine[4559] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，");
    g_tipLine[4560] = StringToText("  所有玩家都会得知你选择了新的玩家。");
    g_tipLine[4561] = StringToText("【角色简介】");
    g_tipLine[4562] = StringToText("恐惧之灵在提名中掺入猜疑。");
    g_tipLine[4563] = StringToText("· 在游戏的首个夜晚，恐惧之灵选择了一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[4564] = StringToText("· 在其他夜晚，每当恐惧之灵选择了与上次选择不同的一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[4565] = StringToText("  如果恐惧之灵选择的玩家与上一次选择的相同，玩家不会得知任何内容。");
    g_tipLine[4566] = StringToText("· 玩家只会得知恐惧之灵是否采取了行动，但不会得知恐惧之灵具体选择了哪一名玩家。");
    g_tipLine[4567] = StringToText("· 如果恐惧之灵提名了他当前选择的玩家，且该玩家因此被处决时，该玩家的阵营落败，游戏结束。");
    g_tipLine[4568] = StringToText("· 只有恐惧之灵当前选择的玩家会受到恐惧之灵的能力影响。他此前选择的玩家不会受到影响。");
    g_tipLine[4569] = StringToText("· 如果被选择的玩家被恐惧之灵提名并处决后没有死亡，他的阵营仍然会落败。");
    g_tipLine[4570] = StringToText("【规则细节】");
    g_tipLine[4571] = StringToText("· 相克规则：");
    g_tipLine[4572] = StringToText("  · 瘟疫医生：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[4573] = StringToText("  · 维齐尔：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[4574] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[4575] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4576] = StringToText("  · 戏子：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[4577] = StringToText("  · 戏子（改）：戏子（改）无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipRoleAt[102] = 4558; g_tipRoleN[102] = 20;
    g_tipLine[4578] = StringToText("【角色能力】");
    g_tipLine[4579] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipLine[4580] = StringToText("【角色简介】");
    g_tipLine[4581] = StringToText("科学怪人能够复制善良角色的能力。");
    g_tipLine[4582] = StringToText("· 只要科学怪人存活且清醒健康，恶魔就会拥有一个不在场的镇民或外来者角色的能力。");
    g_tipLine[4583] = StringToText("· 如果恶魔醉酒中毒，恶魔仍然保留自己获得的这个善良角色的能力。然而如果科学怪人醉酒中毒，");
    g_tipLine[4584] = StringToText("  恶魔就会暂时失去这个善良角色的能力。");
    g_tipLine[4585] = StringToText("· 如果恶魔拥有的能力是死亡后触发或保留的能力，且恶魔死亡，那么恶魔会保留获得的这项能力，例如心上人。");
    g_tipLine[4586] = StringToText("· 如果有新恶魔被创造，例如红唇女郎或理发师，那么新恶魔也能从科学怪人处获得能力。");
    g_tipLine[4587] = StringToText("  新恶魔获得的能力可以与旧恶魔获得的能力不同。");
    g_tipLine[4588] = StringToText("· 如果有多名恶魔同时在场且存活，只会有其中一名存活恶魔能够从科学怪人处获得能力。");
    g_tipLine[4589] = StringToText("· 如果在游戏设置时恶魔因此获得的能力能够影响初始设置，例如唱诗男孩，那么就会对游戏设置产生影响。");
    g_tipLine[4590] = StringToText("· 获得善良角色能力的恶魔与科学怪人都能得知恶魔获得了哪个角色的能力。");
    g_tipLine[4591] = StringToText("  说书人可以分别或同时唤醒这两名玩家通知他们相关信息。");
    g_tipLine[4592] = StringToText("· 恶魔因此获得的不在场角色能力可以来自于恶魔的伪装之一。");
    g_tipLine[4593] = StringToText("· 在夜晚时，恶魔会额外在这个善良角色被唤醒的时机下被唤醒。");
    g_tipLine[4594] = StringToText("【规则细节】");
    g_tipLine[4595] = StringToText("· 如果科学怪人让恶魔拥有「能够让自己醉酒中毒」的能力（比如水手、食人族等），当这些能力导致自身醉酒或中毒时，");
    g_tipLine[4596] = StringToText("  仅影响恶魔因科学怪人拥有的能力，不会影响恶魔玩家原本的能力。");
    g_tipLine[4597] = StringToText("· 相克规则：");
    g_tipLine[4598] = StringToText("  · 异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[4599] = StringToText("  · 莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[4600] = StringToText("  · 异端分子：恶魔无法拥有异端分子的能力。");
    g_tipLine[4601] = StringToText("  · 食人魔：恶魔无法拥有食人魔的能力。");
    g_tipLine[4602] = StringToText("  · 政客：恶魔无法拥有政客的能力。");
    g_tipLine[4603] = StringToText("  · 酒鬼：恶魔无法拥有酒鬼的能力。");
    g_tipLine[4604] = StringToText("  · 炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。");
    g_tipLine[4605] = StringToText("  · 村夫：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[4606] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4607] = StringToText("  · 悟道者：恶魔无法拥有悟道者的能力。");
    g_tipLine[4608] = StringToText("  · 狸猫：如果因科学怪人获得狸猫能力的恶魔与「太子」交换角色，改为「太子」变成狸猫且恶魔获得「太子」原本角色的能力。");
    g_tipRoleAt[132] = 4578; g_tipRoleN[132] = 31;
    g_tipLine[4609] = StringToText("【角色能力】");
    g_tipLine[4610] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipLine[4611] = StringToText("【角色简介】");
    g_tipLine[4612] = StringToText("炸弹人会在被处决后引爆炸弹，消灭在场的绝大多数玩家。");
    g_tipLine[4613] = StringToText("· 如果炸弹人被处决，由说书人来选择会有哪些玩家被杀死，每次一名玩家，直到只剩三名玩家存活。");
    g_tipLine[4614] = StringToText("· 恶魔一定会是这三名存活的玩家之一（在绝大多数情况下都应该是这种结果，否则游戏就会立刻结束）。");
    g_tipLine[4615] = StringToText("· 玩家们要在十声倒数内决定下一个死亡的是谁。今天白天不会有其他的提名和处决，取而代之的是，");
    g_tipLine[4616] = StringToText("  所有玩家会用手指指向自己想要杀死的玩家。在倒数结束后，说书人会统计每名玩家被指向的次数。");
    g_tipLine[4617] = StringToText("  如果这种情况下出现了平局，那么游戏会进入夜晚阶段（邪恶阵营极有可能会因为恶魔在当晚的杀戮而获胜）。");
    g_tipLine[4618] = StringToText("· 即使是失去了投票标记的已死亡玩家，也能够用手指指向自己想要杀死的玩家。");
    g_tipLine[4619] = StringToText("· 玩家在倒数时间内可以随意更换手指指向的目标，在倒数结束后指向的结果才会作为最终结果。");
    g_tipLine[4620] = StringToText("· 炸弹人只会因为处决而触发能力。通过其他方式死亡，例如魔像或者精神病患者，不会触发能力。");
    g_tipLine[4621] = StringToText("  如果炸弹人被处决但没有死亡（由于魔鬼代言人等的能力），他的能力仍然会触发。");
    g_tipLine[4622] = StringToText("· 如果有不会死亡的角色在场，例如弄臣或水手，那么在炸弹人触发能力之后，可能会有多于三名玩家存活。");
    g_tipLine[4623] = StringToText("【规则细节】");
    g_tipLine[4624] = StringToText("· 相克规则：");
    g_tipLine[4625] = StringToText("  · 瘟疫医生：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipRoleAt[138] = 4609; g_tipRoleN[138] = 17;
    g_tipLine[4626] = StringToText("【角色能力】");
    g_tipLine[4627] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipLine[4628] = StringToText("【角色简介】");
    g_tipLine[4629] = StringToText("鹰身女妖在善良玩家之间制造争论与怀疑。");
    g_tipLine[4630] = StringToText("· 在夜晚时，鹰身女妖选择玩家时是一次选择一名玩家，而不是同时选择两名玩家。");
    g_tipLine[4631] = StringToText("· 被鹰身女妖选择的玩家会在鹰身女妖下一次进行选择之前持续被影响。");
    g_tipLine[4632] = StringToText("· 如果说书人决定通过鹰身女妖的能力杀死玩家，那么他必须决定是杀死其中一名玩家还是全部杀死。");
    g_tipLine[4633] = StringToText("· 鹰身女妖可以选择已死亡的玩家。如果她这么做，那么说书人只能杀死当前仍存活的目标玩家，");
    g_tipLine[4634] = StringToText("  因为已死亡的玩家不能再次死亡。");
    g_tipLine[4635] = StringToText("· 被鹰身女妖的能力杀死的玩家的死亡顺序由说书人决定，这一点非常重要。");
    g_tipRoleAt[139] = 4626; g_tipRoleN[139] = 10;
    g_tipLine[4636] = StringToText("【角色能力】");
    g_tipLine[4637] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。 每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipLine[4638] = StringToText("【角色简介】");
    g_tipLine[4639] = StringToText("街头风琴手会让投票秘密进行。");
    g_tipLine[4640] = StringToText("· 当一名玩家被提名后，在投票时所有玩家都需要闭上眼睛。");
    g_tipLine[4641] = StringToText("· 说书人在计票时不会大声唱票，也不会在一次投票结束时告诉大家有多少玩家投了票。");
    g_tipLine[4642] = StringToText("· 说书人不会告诉大家某次提名是否导致了一名玩家「即将被处决」。");
    g_tipLine[4643] = StringToText("· 在提名阶段结束后，说书人宣布了哪名玩家被处决，和正常一样。");
    g_tipLine[4644] = StringToText("· 已死亡的玩家在有投票标记时能够如常投票，但仅限一次。他们的投票标记会在当天白天结束时被移除而不是在单次投票后立即");
    g_tipLine[4645] = StringToText("  被移除。");
    g_tipLine[4646] = StringToText("· 如果街头风琴手醉酒，和正常情况一样，所有玩家睁眼投票。说书人无需对此进行额外说明，比如街头风琴手是否死亡或存活。");
    g_tipLine[4647] = StringToText("  当天夜晚，街头风琴手要再次选择自己醉酒或清醒。");
    g_tipLine[4648] = StringToText("【规则细节】");
    g_tipLine[4649] = StringToText("· 特定角色互动：");
    g_tipLine[4650] = StringToText("  · 枪手：因为说书人能够决定在游戏中有哪些旅行者可以出场并被玩家选择作为自己的旅行者角色，");
    g_tipLine[4651] = StringToText("    因此避免枪手在有街头风琴手的剧本中出场是应对这两个角色的奇怪互动的最好方式。");
    g_tipLine[4652] = StringToText("· 相克规则：");
    g_tipLine[4653] = StringToText("  · 管家：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，但只在他的主人投票时他的票才会被统计。");
    g_tipLine[4654] = StringToText("  · 炼金术士：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。如果炼金术士和街头风琴手都是清醒的，");
    g_tipLine[4655] = StringToText("    改为他们都醉酒。");
    g_tipLine[4656] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4657] = StringToText("  · 梼杌：当梼杌被处决时，如果街头风琴手具有能力，说书人会宣布「无人被处决」。");
    g_tipRoleAt[140] = 4636; g_tipRoleN[140] = 22;
    g_tipLine[4658] = StringToText("【角色能力】");
    g_tipLine[4659] = StringToText("所有玩家都知道你是维齐尔。 你在白天时不会死亡。 如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipLine[4660] = StringToText("【角色简介】");
    g_tipLine[4661] = StringToText("维齐尔能够处决玩家，无需经过镇子的同意。");
    g_tipLine[4662] = StringToText("· 在第一个白天，所有玩家都会得知维齐尔在场，并且知道是哪一名玩家。");
    g_tipLine[4663] = StringToText("· 在白天时，维齐尔不会因为任何原因死亡。");
    g_tipLine[4664] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且至少有一名善良玩家参与投票），那么被提名者会立即被处决。");
    g_tipLine[4665] = StringToText("  这算在每个白天的一次处决之内。");
    g_tipLine[4666] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且没有任何善良玩家参与投票），那么无事发生。");
    g_tipLine[4667] = StringToText("· 即使被提名者得票在存活玩家的半数以下，维齐尔仍然能够执行处决。即使有其他玩家得票比此次被提名者多，");
    g_tipLine[4668] = StringToText("  维齐尔仍然能够执行处决。");
    g_tipLine[4669] = StringToText("· 维齐尔无需在每个白天都使用自己的能力来造成强制处决。");
    g_tipLine[4670] = StringToText("【规则细节】");
    g_tipLine[4671] = StringToText("· 如果维齐尔受到非相克规则的角色带来的醉酒或中毒的效果影响，那么他能够在白天死亡，并且无法选择立即执行处决，");
    g_tipLine[4672] = StringToText("  但玩家不会知道这一点，直到维齐尔尝试这么做为止。");
    g_tipLine[4673] = StringToText("· 如果维齐尔在游戏中途被创造，所有玩家都会立即得知谁是维齐尔。然而如果维齐尔的角色中途发生了变化，");
    g_tipLine[4674] = StringToText("  玩家不会立即得知这一消息（因为暴露角色的能力来源消失了）。");
    g_tipLine[4675] = StringToText("· 相克规则：");
    g_tipLine[4676] = StringToText("  · 调查员：说书人不会宣布维齐尔在场。");
    g_tipLine[4677] = StringToText("  · 传教士：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[4678] = StringToText("  · 侍臣：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[4679] = StringToText("  · 魔术师：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[4680] = StringToText("  · 戏法师：说书人不会宣布维齐尔在场。");
    g_tipLine[4681] = StringToText("  · 政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[4682] = StringToText("  · 狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[4683] = StringToText("  · 恐惧之灵：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[4684] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[4685] = StringToText("  · 小怪宝：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[4686] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4687] = StringToText("  · 姑获鸟：姑获鸟无法获得维齐尔的能力。");
    g_tipRoleAt[141] = 4658; g_tipRoleN[141] = 30;
    g_tipLine[4688] = StringToText("【角色能力】");
    g_tipLine[4689] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipLine[4690] = StringToText("【角色简介】");
    g_tipLine[4691] = StringToText("限会让镇民玩家集体中毒。");
    g_tipLine[4692] = StringToText("· 限会让所有镇民玩家中毒一个夜晚和一个白天。限的能力生效夜晚和初始加入游戏的外来者数量相同。比如，游戏开始时，");
    g_tipLine[4693] = StringToText("  有两名外来者，限的能力就会在第二个夜晚生效。");
    g_tipLine[4694] = StringToText("· 限可以让任意数量的外来者加入游戏，但通常是一名到四名外来者。外来者的数量可以和限不在场时的数量一致，");
    g_tipLine[4695] = StringToText("  也可以有所差距。限的能力会覆盖其他设置调整类型的能力，例如男爵等角色。");
    g_tipLine[4696] = StringToText("· 如果在游戏过程中外来者数量发生变化，大限将至的夜晚也仍然取决于初始设置的外来者数量。");
    g_tipLine[4697] = StringToText("· 限需要存活，能力才能生效。");
    g_tipRoleAt[147] = 4688; g_tipRoleN[147] = 10;
    g_tipLine[4698] = StringToText("【角色能力】");
    g_tipLine[4699] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");
    g_tipLine[4700] = StringToText("【角色简介】");
    g_tipLine[4701] = StringToText("召唤师能够创造恶魔。");
    g_tipLine[4702] = StringToText("· 召唤师能够选择任意一名玩家变成恶魔，他甚至可以选择自己。");
    g_tipLine[4703] = StringToText("· 被创造的新恶魔不会得知谁是爪牙，爪牙也不会得知他是恶魔。邪恶玩家之间需要通过交流来互认。");
    g_tipLine[4704] = StringToText("· 即使在游戏的前两天没有恶魔在场，游戏也不会因此结束。然而，如果召唤师因为某些原因无法创造新的恶魔（死亡或在第三个");
    g_tipLine[4705] = StringToText("  夜晚中毒等），善良阵营获胜。");
    g_tipLine[4706] = StringToText("· 新恶魔在被创造的当晚就能行动。");
    g_tipLine[4707] = StringToText("【规则细节】");
    g_tipLine[4708] = StringToText("· 特定角色互动：");
    g_tipLine[4709] = StringToText("  · 理发师：如果理发师死亡但无恶魔在场，无事发生。");
    g_tipLine[4710] = StringToText("  · 莽夫：如果召唤师在创造恶魔时选择了莽夫，莽夫转为邪恶，且会与邪恶阵营一同落败，因为场上没有恶魔且召唤师醉酒了。");
    g_tipLine[4711] = StringToText("· 相克规则：");
    g_tipLine[4712] = StringToText("  · 炼金术士：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_tipLine[4713] = StringToText("    由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[4714] = StringToText("  · 钟表匠：召唤师会被钟表匠当作恶魔。");
    g_tipLine[4715] = StringToText("  · 罂粟种植者：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，由说书人来决定哪名玩家发生转变。");
    g_tipLine[4716] = StringToText("  · 侍臣：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[4717] = StringToText("  · 传教士：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[4718] = StringToText("  · 工程师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_tipLine[4719] = StringToText("  · 帽匠/麻脸巫婆/卡扎力：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[4720] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[4721] = StringToText("  · 僵怖：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_tipLine[4722] = StringToText("  · 普卡：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_tipLine[4723] = StringToText("  · 军团：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[4724] = StringToText("  · 堤丰之首：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[4725] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4726] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4727] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4728] = StringToText("  · 姑获鸟：如果召唤师成功召唤了姑获鸟，召唤师会变成一个不在场的爪牙。");
    g_tipLine[4729] = StringToText("  · 典狱长：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipRoleAt[150] = 4698; g_tipRoleN[150] = 32;
    g_tipAbility[17] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipAbility[18] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipAbility[19] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipAbility[20] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipAbility[39] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。 如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipAbility[40] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipAbility[41] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipAbility[42] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，他的阵营落败。");
    g_tipAbility[64] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。 如果其中善良玩家被处决，邪恶阵营获胜。 如果你们都存活，善良阵营无法获胜。");
    g_tipAbility[65] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipAbility[66] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipAbility[67] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipAbility[75] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipAbility[84] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。 如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipAbility[85] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipAbility[93] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipAbility[98] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipAbility[99] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipAbility[102] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，所有玩家都会得知你选择了新的玩家。");
    g_tipAbility[132] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipAbility[138] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipAbility[139] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipAbility[140] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。 每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipAbility[141] = StringToText("所有玩家都知道你是维齐尔。 你在白天时不会死亡。 如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipAbility[147] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipAbility[150] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");

    g_tipLine[3800] = StringToText("【角色能力】");
    g_tipLine[3801] = StringToText("每个夜晚，你要选择除你以外的一名玩家：明天白天，只有他投票时你才能投票。");
    g_tipLine[3802] = StringToText("【角色简介】");
    g_tipLine[3803] = StringToText("管家只能在他的主人投票时才能投票。");
    g_tipLine[3804] = StringToText("· 每个夜晚，管家需要选择一名玩家来成为自己的主人。这名玩家可以是与前一夜相同的，");
    g_tipLine[3805] = StringToText("  也可以是与前一夜不同的。");
    g_tipLine[3806] = StringToText("· 如果主人在投票时举手，或主人的投票已经被统计时，管家可以举手参与投票。");
    g_tipLine[3807] = StringToText("· 如果主人放下了他的手，表明他不参与投票，或在投票被统计前将手放下，管家也必须将自己的手放下。");
    g_tipLine[3808] = StringToText("· 说书人没有监视管家的责任。管家需要为自己的投票负责。管家在不应该投票的场合下故意投票会被视为作弊。");
    g_tipLine[3809] = StringToText("· 因为角色能力不能以任何形式影响流放流程，管家可以在流放表决中自由参与表决。");
    g_tipLine[3810] = StringToText("· 已死亡的玩家只能在拥有投票标记时才能举手投票。如果管家选择了一名已死亡玩家作为主人，");
    g_tipLine[3811] = StringToText("  这种情况仍然适用。");
    g_tipLine[3812] = StringToText("· 管家的能力从不会被强制必须投票。");
    g_tipLine[3813] = StringToText("· 管家的投票可以在他主人之前或之后被说书人计票。座次顺序并不重要。");
    g_tipLine[3814] = StringToText("【规则细节】");
    g_tipLine[3815] = StringToText("· 即使管家作弊投票，他的票也仍然会被统计并且有效。管家不应该，也无法用这种方式来证明自己是管家。");
    g_tipLine[3816] = StringToText("· 对于管家的作弊行为，不要以「不好的事」来进行处罚，因为这样会导致游戏产生相对于正常情况的额外信息，");
    g_tipLine[3817] = StringToText("  这不利于玩家进行推理分析。「被视为作弊」其实更多地是一种基于社交上的措辞，");
    g_tipLine[3818] = StringToText("  是对于玩家不遵守游戏规则的一种客观的表达，但并不意味着作弊的玩家需要在游戏中受到处罚。");
    g_tipLine[3819] = StringToText("  如果真的有作弊的现象发生，那么跟这位玩家在游戏结束后私下好好谈谈吧。");
    g_tipLine[3820] = StringToText("· 对于轮盘计票方式中，主人坐在管家下家的情况而导致管家可能无法参与投票的情况，有以下几种建议：");
    g_tipLine[3821] = StringToText("  · 提倡玩家养成提前举手的习惯。因为即使提前举手，也会在说书人的手指向某个玩家时，才会计算该玩家的票，");
    g_tipLine[3822] = StringToText("    提前举手也会成为一些谈判和背叛的策略。在这种情况下，如果主人提前举手了，");
    g_tipLine[3823] = StringToText("    管家自然就能正常举手且不算做作弊。即使管家的投票被说书人统计后主人在自己的票被统计之前又把手放下，");
    g_tipLine[3824] = StringToText("    管家的票依然会被计算且不算作弊。");
    g_tipLine[3825] = StringToText("  · 对于线上游戏，很难在短时间内观察主人的举手情况并做出反馈时，建议以以下方式进行互动：");
    g_tipLine[3826] = StringToText("    管家玩家可以在交流阶段公开声明自己是管家，并询问主人自己可以参与针对哪些玩家的提名投票，");
    g_tipLine[3827] = StringToText("    向主人寻求建议。");
    g_tipLine[3828] = StringToText("· 相克规则：");
    g_tipLine[3829] = StringToText("  · 食人族：如果食人族获得了管家的能力，他会得知这一信息。");
    g_tipLine[3830] = StringToText("  · 街头风琴手：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，");
    g_tipLine[3831] = StringToText("    但只在他的主人投票时他的票才会被统计。");
    g_tipLine[3832] = StringToText("【角色能力】");
    g_tipLine[3833] = StringToText("你不知道你是酒鬼。你以为你是一个镇民角色，但其实你不是。");
    g_tipLine[3834] = StringToText("【角色简介】");
    g_tipLine[3835] = StringToText("酒鬼以为自己是镇民，且对自己实际上是酒鬼一事毫不知情。");
    g_tipLine[3836] = StringToText("· 在初始设置时，不会将酒鬼的角色标记放进盲抽袋中。作为替代，会有一个镇民的角色标记放进盲抽袋中，");
    g_tipLine[3837] = StringToText("  且抽到该角色标记的玩家会在整场游戏中秘密地成为酒鬼。说书人知道哪位镇民实际上是酒鬼，");
    g_tipLine[3838] = StringToText("  而酒鬼玩家无从得知。");
    g_tipLine[3839] = StringToText("· 酒鬼没有任何能力。不论他获得的镇民标记是否会以某些方式影响游戏，酒鬼却无法使用这一镇民能力。然而，");
    g_tipLine[3840] = StringToText("  说书人会装作酒鬼玩家是他以为的那种镇民。如果那个镇民会在夜晚醒来，");
    g_tipLine[3841] = StringToText("  酒鬼同样会被唤醒并如同那个镇民的方式进行行动。如果那个镇民能够获取信息，");
    g_tipLine[3842] = StringToText("  说书人可以对酒鬼给出错误的信息作为替代——我们也建议说书人这样去做。");
    g_tipLine[3843] = StringToText("【规则细节】");
    g_tipLine[3844] = StringToText("· 如果酒鬼醉酒或中毒，他不会有任何变化。属于认知覆盖类的能力不会因为醉酒或中毒失效。");
    g_tipLine[3845] = StringToText("  一旦玩家成为了酒鬼这个角色，玩家会始终认为自己是镇民（除非玩家通过推理分析得出自己实际上是酒鬼）。");
    g_tipLine[3846] = StringToText("· 认知覆盖类能力的角色只要还是这个角色，说书人就能对其进行合理的欺骗，");
    g_tipLine[3847] = StringToText("  但前提条件是需要让他持续认为自己是满足自己当前角色「认知范围」内的角色，且无法对「认知范围」");
    g_tipLine[3848] = StringToText("  以外的内容进行欺骗。例如，说书人无法欺骗一个未转变阵营的酒鬼说他的阵营发生了变化。但是，");
    g_tipLine[3849] = StringToText("  如果有邪恶玩家声称自己是农夫且在夜晚死亡，说书人能够欺骗酒鬼并告诉他他变成了农夫，");
    g_tipLine[3850] = StringToText("  因为农夫仍然是一个镇民角色，这满足酒鬼的「认知范围」。");
    g_tipLine[3851] = StringToText("· 特定角色互动：");
    g_tipLine[3852] = StringToText("  · 咖啡师：咖啡师的「清醒且健康」效果能够让能获取信息的酒鬼在生效期间内获得正确信息。");
    g_tipLine[3853] = StringToText("· 相克规则：");
    g_tipLine[3854] = StringToText("  · 数学家：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_tipLine[3855] = StringToText("  · 科学怪人：恶魔无法拥有酒鬼的能力。");
    g_tipLine[3856] = StringToText("【角色能力】");
    g_tipLine[3857] = StringToText("你可能会被当作邪恶阵营、爪牙角色或恶魔角色，即使你已死亡。");
    g_tipLine[3858] = StringToText("【角色简介】");
    g_tipLine[3859] = StringToText("陌客会看起来像是邪恶一员，但实际上是善良的。");
    g_tipLine[3860] = StringToText("· 任何时候要探查陌客的阵营时，由说书人来决定陌客被当作善良还是邪恶。");
    g_tipLine[3861] = StringToText("· 任何时候陌客被影响特定的爪牙或恶魔角色的能力选择时，");
    g_tipLine[3862] = StringToText("  由说书人来决定陌客是否会被当作某种特定的爪牙或是恶魔角色。");
    g_tipLine[3863] = StringToText("· 陌客能在同一个夜晚的不同能力中分别被当作善良或邪恶阵营，外来者、爪牙或恶魔角色。");
    g_tipLine[3864] = StringToText("  由说书人来选择最有趣的结果。");
    g_tipLine[3865] = StringToText("· 陌客在被当作特定的爪牙或恶魔角色时，不会获得这一角色的能力。例如，");
    g_tipLine[3866] = StringToText("  被当作投毒者的陌客无法在夜晚被唤醒，也无法让一名玩家中毒。");
    g_tipLine[3867] = StringToText("【规则细节】");
    g_tipLine[3868] = StringToText("· 陌客有很多「可以但不建议」的内容，");
    g_tipLine[3869] = StringToText("  希望各位说书人在有陌客在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[3870] = StringToText("· 陌客的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，");
    g_tipLine[3871] = StringToText("  那么陌客是有可能被当作「善良的恶魔」或者是「邪恶的陌客」的（如舞蛇人和食人族）。");
    g_tipLine[3872] = StringToText("· 相克规则：");
    g_tipLine[3873] = StringToText("  · 贤者：陌客可能会被贤者当作杀死他的恶魔。");
    g_tipLine[3874] = StringToText("  · 食人魔：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_tipLine[3875] = StringToText("【角色能力】");
    g_tipLine[3876] = StringToText("如果你死于处决，你的阵营落败。");
    g_tipLine[3877] = StringToText("【角色简介】");
    g_tipLine[3878] = StringToText("圣徒在被处决时会导致游戏结束。");
    g_tipLine[3879] = StringToText("· 如果圣徒因处决而死亡，游戏结束。善良阵营落败，邪恶阵营获胜。");
    g_tipLine[3880] = StringToText("· 如果圣徒因处决以外的任何方式死亡——例如被恶魔杀死——游戏仍会继续。");
    g_tipLine[3881] = StringToText("【规则细节】");
    g_tipLine[3882] = StringToText("· 特定角色互动：");
    g_tipLine[3883] = StringToText("  · 小怪宝：照看小怪宝的圣徒如果作为场上最后一名存活的恶魔被处决，善良阵营会获胜。");
    g_tipLine[3884] = StringToText("【角色能力】");
    g_tipLine[3885] = StringToText("你随时可能死亡。");
    g_tipLine[3886] = StringToText("【角色简介】");
    g_tipLine[3887] = StringToText("修补匠随时可能会死亡，不需要任何理由。");
    g_tipLine[3888] = StringToText("· 说书人随时可以杀死修补匠。");
    g_tipLine[3889] = StringToText("· 修补匠在受到免于死亡的能力保护时，不能因自己的能力而死亡。");
    g_tipLine[3890] = StringToText("【规则细节】");
    g_tipLine[3891] = StringToText("无额外规则。");
    g_tipLine[3892] = StringToText("【角色能力】");
    g_tipLine[3893] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是善良的，在当晚他会死亡。");
    g_tipLine[3894] = StringToText("【角色简介】");
    g_tipLine[3895] = StringToText("月之子会在死亡时诅咒他人，将其杀死。");
    g_tipLine[3896] = StringToText("· 月之子必须在得知自己死亡后的一到两分钟内选择一名玩家，无论是被处决后，");
    g_tipLine[3897] = StringToText("  还是在黎明说书人宣布夜晚的死亡玩家后。月之子可以在作出决定前花点时间听取大家的建议。");
    g_tipLine[3898] = StringToText("· 如果月之子选择了一名善良玩家，该玩家会在当晚死亡。如果月之子选择了一名邪恶玩家，无事发生。");
    g_tipLine[3899] = StringToText("· 一如既往地，如果一名邪恶玩家伪装成月之子假装使用能力，说书人应当配合他。");
    g_tipLine[3900] = StringToText("· 说书人并没有义务提醒月之子来选择玩家。月之子必须在得知自己死亡后的短时间内使用自己的能力。");
    g_tipLine[3901] = StringToText("  故意不使用能力将被认定为作弊。");
    g_tipLine[3902] = StringToText("· 如果月之子在夜晚是清醒且健康的，但在今天白天选择玩家时是醉酒或中毒的，所选的玩家会死亡。");
    g_tipLine[3903] = StringToText("  如果月之子在夜晚是醉酒或中毒的，但在今天白天选择玩家时是清醒且健康的，所选的玩家不会死亡。");
    g_tipLine[3904] = StringToText("· 如果月之子在选择莽夫时，莽夫是善良的，则无论莽夫的阵营在夜晚如何变化，月之子都会杀死莽夫。");
    g_tipLine[3905] = StringToText("【规则细节】");
    g_tipLine[3906] = StringToText("无额外规则。");
    g_tipLine[3907] = StringToText("【角色能力】");
    g_tipLine[3908] = StringToText("每个夜晚，首个使用其自身能力选择了你的玩家会醉酒直到下个黄昏。你会转变为他的阵营。");
    g_tipLine[3909] = StringToText("【角色简介】");
    g_tipLine[3910] = StringToText("莽夫在夜晚对其他角色的能力免疫，但是会不断改变阵营。");
    g_tipLine[3911] = StringToText("· 每个夜晚，被唤醒的玩家之中，首个使用自己的能力选择了莽夫的玩家将会立即醉酒。");
    g_tipLine[3912] = StringToText("  该玩家的能力在当晚和下一个白天不会生效。");
    g_tipLine[3913] = StringToText("· 之后在同一个夜晚，如果另一位玩家被唤醒且使用自己的能力选择了莽夫，该能力会正常生效。");
    g_tipLine[3914] = StringToText("· 除非玩家自己选择了莽夫，否则莽夫不能让玩家醉酒。通过祖母之类的角色能力，");
    g_tipLine[3915] = StringToText("  而由说书人选择了莽夫不算在内。");
    g_tipLine[3916] = StringToText("· 一旦莽夫让一名玩家醉酒，莽夫的阵营改变为与该玩家一致。如果选择莽夫的玩家已经醉酒或中毒，");
    g_tipLine[3917] = StringToText("  莽夫仍然会改变阵营并让该玩家醉酒。");
    g_tipLine[3918] = StringToText("· 如果被刺客选择，莽夫会死亡，但仍然会转变为邪恶阵营。");
    g_tipLine[3919] = StringToText("【规则细节】");
    g_tipLine[3920] = StringToText("· 相克规则：");
    g_tipLine[3921] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。");
    g_tipLine[3922] = StringToText("  · 科学怪人：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[3923] = StringToText("【角色能力】");
    g_tipLine[3924] = StringToText("你以为你是一个恶魔，但其实你不是。");
    g_tipLine[3925] = StringToText("恶魔知道你是疯子以及你在每个夜晚选择了哪些玩家。");
    g_tipLine[3926] = StringToText("【角色简介】");
    g_tipLine[3927] = StringToText("疯子以为自己是恶魔。");
    g_tipLine[3928] = StringToText("· 和酒鬼很相似，疯子不知道自己的真实角色和真实阵营。疯子每个夜晚都会被唤醒来发动攻击，");
    g_tipLine[3929] = StringToText("  就如同他是场上真正的恶魔，但是疯子的选择没有效果，因为他没有恶魔的能力。");
    g_tipLine[3930] = StringToText("· 疯子会在首个夜晚被唤醒来得知三个不在场的角色，以及与当前游戏数量符合的爪牙，");
    g_tipLine[3931] = StringToText("  但是这些信息可能是错误的。");
    g_tipLine[3932] = StringToText("· 真正的恶魔会知道疯子每个夜晚攻击了哪些玩家。");
    g_tipLine[3933] = StringToText("【规则细节】");
    g_tipLine[3934] = StringToText("· 相克规则：");
    g_tipLine[3935] = StringToText("  · 数学家：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。");
    g_tipLine[3936] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3937] = StringToText("  · 戏子（改）：疯子不会因为戏子（改）能力参与互认，也不会因为戏子（改）的能力醉酒。");
    g_tipLine[3938] = StringToText("【角色能力】");
    g_tipLine[3939] = StringToText("如果你「疯狂」地证明自己是外来者，你可能被处决。");
    g_tipLine[3940] = StringToText("【角色简介】");
    g_tipLine[3941] = StringToText("畸形秀演员如果试图揭露自己是谁，他就会被处决。");
    g_tipLine[3942] = StringToText("· 「疯狂」是一个术语，意思是「你正在尝试说服他人相信某件事情」。所以，");
    g_tipLine[3943] = StringToText("  「畸形秀演员『疯狂』地证明自己是畸形秀演员」，这意味着他正在试图说服他人相信他是畸形秀演员。");
    g_tipLine[3944] = StringToText("  「他『疯狂』地证明他是外来者」，这意味着他正在试图说服他人相信他是外来者。");
    g_tipLine[3945] = StringToText("· 说服的形式包含口头暗示自己的角色，也包含在自己的角色被质疑时的保持沉默。畸形秀演员是否「疯狂」");
    g_tipLine[3946] = StringToText("  由说书人来决定。如果你认为他正在以任何方式证明自己是一名外来者，你就可以处决他，即使在提名阶段之外，");
    g_tipLine[3947] = StringToText("  甚至是在晚上都可以处决他。如果你这样做，正常情况下这意味今天白天不会再有其他人被处决，");
    g_tipLine[3948] = StringToText("  因为每个白天只有一次处决。");
    g_tipLine[3949] = StringToText("· 如果畸形秀演员晚上暗示他是畸形秀演员，那么你在当晚可以处决他，即使今天白天已经有人被处决。");
    g_tipLine[3950] = StringToText("  宣布他的死亡，并正常进行夜晚。明天仍然可能发生一场处决。");
    g_tipLine[3951] = StringToText("【规则细节】");
    g_tipLine[3952] = StringToText("无额外规则。");
    g_tipLine[3953] = StringToText("【角色能力】");
    g_tipLine[3954] = StringToText("当你死亡时，会有一名玩家开始醉酒。");
    g_tipLine[3955] = StringToText("【角色简介】");
    g_tipLine[3956] = StringToText("心上人死亡的时候，一名玩家会在剩余的游戏时间里醉酒。");
    g_tipLine[3957] = StringToText("· 由说书人选择哪名玩家醉酒。");
    g_tipLine[3958] = StringToText("· 这项能力当心上人死亡时才会被触发。");
    g_tipLine[3959] = StringToText("【规则细节】");
    g_tipLine[3960] = StringToText("无额外规则。");
    g_tipLine[3961] = StringToText("【角色能力】");
    g_tipLine[3962] = StringToText("如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。");
    g_tipLine[3963] = StringToText("【角色简介】");
    g_tipLine[3964] = StringToText("理发师能允许恶魔交换两名玩家的角色。");
    g_tipLine[3965] = StringToText("· 玩家阵营在交换角色时保持不变。每名玩家都会得知他们变成了什么角色。");
    g_tipLine[3966] = StringToText("· 恶魔可以选择不进行角色交换。");
    g_tipLine[3967] = StringToText("· 如果玩家变成了一个新的角色，他们会获得新角色的能力，包括「在你的首个夜晚」");
    g_tipLine[3968] = StringToText("  的能力或已经被使用的「每局游戏限一次」的能力。");
    g_tipLine[3969] = StringToText("· 如果有两名或者更多的存活恶魔，由说书人选择哪个恶魔来操作交换。");
    g_tipLine[3970] = StringToText("· 恶魔可以选择自己进行角色交换。");
    g_tipLine[3971] = StringToText("· 恶魔不能选择另一名恶魔玩家进行角色交换。");
    g_tipLine[3972] = StringToText("· 如果一名玩家在死亡之后变成了理发师，恶魔不能在当晚交换两个玩家的角色。");
    g_tipLine[3973] = StringToText("【规则细节】");
    g_tipLine[3974] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[3975] = StringToText("  · 梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_tipLine[3976] = StringToText("【角色能力】");
    g_tipLine[3977] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。");
    g_tipLine[3978] = StringToText("【角色简介】");
    g_tipLine[3979] = StringToText("呆瓜可能会导致他的阵营突然落败，除非他很聪明。");
    g_tipLine[3980] = StringToText("· 当呆瓜死亡时，他必须公开选择一名玩家。他可能需要花几分钟来做决定——毕竟，这是一个大决定，");
    g_tipLine[3981] = StringToText("  而且其他玩家可以向他提供建议，但最终决定始终由呆瓜来做出。如果他选择了一名邪恶玩家，");
    g_tipLine[3982] = StringToText("  那游戏就立即结束，善良阵营落败。如果他选择了一名善良玩家，无事发生，游戏继续。");
    g_tipLine[3983] = StringToText("· 说书人没有义务提醒呆瓜公开表明自己的角色并选择一名玩家。呆瓜必须在他得知自己死亡后，尽快去这样做。");
    g_tipLine[3984] = StringToText("  故意不这样做会被认为是作弊。");
    g_tipLine[3985] = StringToText("【规则细节】");
    g_tipLine[3986] = StringToText("无额外规则。");
    g_tipLine[3987] = StringToText("【角色能力】");
    g_tipLine[3988] = StringToText("每局游戏你只能发起提名一次。当你发起提名时，如果被你提名的玩家不是恶魔，他死亡。");
    g_tipLine[3989] = StringToText("【角色简介】");
    g_tipLine[3990] = StringToText("魔像会杀死他提名的玩家。");
    g_tipLine[3991] = StringToText("· 当魔像提名了一名玩家后，那名玩家会立即死亡。提名流程会继续正常进行。");
    g_tipLine[3992] = StringToText("· 如果魔像提名了恶魔，无事发生。说书人无需对魔像的提名进行确认或否决，而是继续如常进行投票流程。");
    g_tipLine[3993] = StringToText("  如果玩家有需要，说书人也可以说「无事发生」。");
    g_tipLine[3994] = StringToText("· 当魔像进行了一次提名之后，不论被他提名的人是否死亡，魔像在这局游戏中都不能再进行提名。");
    g_tipLine[3995] = StringToText("  不再进行提名是玩家的责任而非说书人的责任，故意在不应该提名的情况下进行提名会被当作是作弊。");
    g_tipLine[3996] = StringToText("【规则细节】");
    g_tipLine[3997] = StringToText("· 特定角色互动：");
    g_tipLine[3998] = StringToText("  · 弄臣/水手/茶艺师/暴风捕手：在满足能力要求的情况下都可以阻止魔像造成的死亡。");
    g_tipLine[3999] = StringToText("  · 陌客：可以被当作恶魔，从而免于因魔像的能力而死。");
    g_tipLine[4000] = StringToText("  · 修补匠：可以令修补匠在适当时刻死亡以（让对方）模拟魔像。");
    g_tipLine[4001] = StringToText("  · 女巫：如果健康清醒且被女巫诅咒的魔像提名非恶魔玩家，说书人来决定谁的能力优先触发。");
    g_tipLine[4002] = StringToText("    但通常是让魔像先触发，这样可以保证两个角色的能力都能正常生效。如果魔像提名的是女巫，");
    g_tipLine[4003] = StringToText("    那么说书人就只能从其中选择一个能力来进行触发了（因为一个效果触发后导致一名玩家死亡，");
    g_tipLine[4004] = StringToText("    另一个效果就无法被触发了）。");
    g_tipLine[4005] = StringToText("  · 咖啡师：即使受到咖啡能力生效两次效果的影响，魔像仍被限制为每局游戏只能提名一次。但当魔像提名时，");
    g_tipLine[4006] = StringToText("    被提名玩家会死亡两次。所以受咖啡行动两次效果影响的魔像可以在一次提名中直接杀死一个未使用能力的弄臣。");
    g_tipLine[4007] = StringToText("    如果魔像已经使用了他唯一的一次提名机会，那么咖啡师对他没有任何效果。");
    g_tipLine[4008] = StringToText("【角色能力】");
    g_tipLine[4009] = StringToText("所有爪牙都知道落难少女在场。每局游戏限一次，任意爪牙可以公开猜测你是落难少女，如果猜对，你的阵营落败。");
    g_tipLine[4010] = StringToText("【角色简介】");
    g_tipLine[4011] = StringToText("落难少女需要避免被爪牙发现。");
    g_tipLine[4012] = StringToText("· 如果一名爪牙公开猜中了落难少女（因此所有玩家都知道他是爪牙），邪恶阵营获胜。");
    g_tipLine[4013] = StringToText("· 不论有多少爪牙在场，他们都仅仅只有一次猜测的机会。如果有爪牙做出了猜测但答案错误，");
    g_tipLine[4014] = StringToText("  后续做出的任何猜测都不会再生效。");
    g_tipLine[4015] = StringToText("· 如果恶魔假装自己是爪牙并做出了猜测，这次猜测不会计算在内。爪牙仍然能够进行猜测并在猜中后获胜。");
    g_tipLine[4016] = StringToText("· 爪牙可以在任何时候做出猜测。");
    g_tipLine[4017] = StringToText("· 如果落难少女死亡，她将不再承担被爪牙猜中的风险，因为她在死亡时已经失去了能力。");
    g_tipLine[4018] = StringToText("· 巡山人并非一定会与落难少女一同出场。但如果巡山人在场，且在夜晚时选中了落难少女，");
    g_tipLine[4019] = StringToText("  那么落难少女就会变成一个不在场的镇民，且不再是落难少女。落难少女会得知自己变成了哪一镇民，");
    g_tipLine[4020] = StringToText("  且从那一刻起具有这一镇民的能力。");
    g_tipLine[4021] = StringToText("【规则细节】");
    g_tipLine[4022] = StringToText("· 如果落难少女玩家因巡山人变为具有设置调整能力的镇民，设置调整能力不会生效。");
    g_tipLine[4023] = StringToText("· 特定角色互动：");
    g_tipLine[4024] = StringToText("  · 食人族：如果食人族获得落难少女的能力，爪牙可以通过猜测该玩家「是落难少女」让食人族玩家的阵营落败。");
    g_tipLine[4025] = StringToText("  · 僧侣：僧侣只能在夜晚保护，并且针对的是恶魔而不是爪牙，");
    g_tipLine[4026] = StringToText("    所以僧侣的保护不会阻止爪牙正确猜测落难少女并结束游戏。除了，一个正在照顾小怪宝的爪牙在夜晚进行猜测，");
    g_tipLine[4027] = StringToText("    此时落难少女被僧侣保护，我将裁定在这种情况下游戏不会结束。");
    g_tipLine[4028] = StringToText("    （僧侣的保护能力能阻止恶魔通过触发落难少女的能力来获胜，即使这个能力来自于落难少女而不是恶魔。）");
    g_tipLine[4029] = StringToText("  · 理发师：如果落难少女被交换，你不需要重新告知爪牙落难少女在场，尽管落难少女的能力已经重新进场，");
    g_tipLine[4030] = StringToText("    爪牙们会从之前的告知中继续知道落难少女在场。如果一名玩家之前不是爪牙，然后被交换为爪牙角色，");
    g_tipLine[4031] = StringToText("    他会被告知落难少女在场。");
    g_tipLine[4032] = StringToText("  · 莽夫：爪牙猜测莽夫是落难少女不会触发莽夫的阵营转换——爪牙没有使用自身能力选择莽夫。");
    g_tipLine[4033] = StringToText("  · 陌客：可以被当作爪牙并猜测落难少女，并结束游戏。如果你是陌客，也许不去猜测是最好的！");
    g_tipLine[4034] = StringToText("    理论上你可以在对应时刻将陌客当作爪牙并告诉他有落难少女在场，但请不要这样做。");
    g_tipLine[4035] = StringToText("  · 红唇女郎/小恶魔：如果恶魔死亡，并且红唇女郎/某个爪牙变为恶魔，他不能猜测落难少女。");
    g_tipLine[4036] = StringToText("  · 女巫：即使只有三名玩家存活，女巫失去能力，他仍然可以猜测落难少女");
    g_tipLine[4037] = StringToText("  · 军团：军团由于被当作爪牙而能够猜测落难少女。");
    g_tipLine[4038] = StringToText("  · 小怪宝：所有爪牙，包括那名正在照看宝宝而因此还被当作恶魔的爪牙，都会得知落难少女在场并能够进行猜测。");
    g_tipLine[4039] = StringToText("  · 沙巴洛斯：如果落难少女被复活，爪牙同样不会被重新告知有落难少女在场，他们在游戏开始时被告知就足够了。");
    g_tipLine[4040] = StringToText("    如果场上出现之前没有被告知过的新爪牙，他会被告知。因此，最好不要让沙巴洛斯复活落难少女。");
    g_tipLine[4041] = StringToText("    如果在落难少女之前猜测机会已经使用过，在落难少女复活的新场合中，猜测次数重置，");
    g_tipLine[4042] = StringToText("    因此爪牙还有一次猜测机会。");
    g_tipLine[4043] = StringToText("  · 侍女：如果落难少女玩家因巡山人变成镇民角色的当晚被侍女选择，");
    g_tipLine[4044] = StringToText("    只有该玩家因为自身新能力醒来才会被侍女算入已唤醒。");
    g_tipLine[4045] = StringToText("    落难少女玩家不是因为自身能力而醒来得知自己的新角色，所以不会被侍女探查。");
    g_tipLine[4046] = StringToText("  · 水手：如果落难少女因巡山人变为成水手，他在当晚不能选择与其他玩家喝酒，因为水手的夜晚顺序已经过去了。");
    g_tipLine[4047] = StringToText("    因此这名（原落难少女）水手玩家在当晚和下一个白天都不会死亡。");
    g_tipLine[4048] = StringToText("· 相克规则：");
    g_tipLine[4049] = StringToText("  · 麻脸巫婆：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[4050] = StringToText("  · 间谍/寡妇：如果间谍/寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[4051] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4052] = StringToText("  · 戏子（改）：落难少女不会因为戏子（改）的能力醉酒。");
    g_tipLine[4053] = StringToText("【角色能力】");
    g_tipLine[4054] = StringToText("爪牙会在其首个夜晚得知三个伪装。");
    g_tipLine[4055] = StringToText("【角色简介】");
    g_tipLine[4056] = StringToText("告密者能够使邪恶阵营获得额外的信息。");
    g_tipLine[4057] = StringToText("· 告密者使得爪牙能够在游戏的首个夜晚得知三个不在场的角色，如同恶魔一样。");
    g_tipLine[4058] = StringToText("· 爪牙得知的三个不在场角色可能与恶魔得知的相同，也可能不同。");
    g_tipLine[4059] = StringToText("· 多名爪牙可能会得知不同的角色，也可能得知相同的角色。");
    g_tipLine[4060] = StringToText("【规则细节】");
    g_tipLine[4061] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4062] = StringToText("  · 戏子（改）：告密者不会因为戏子（改）的能力醉酒。");
    g_tipLine[4063] = StringToText("【角色能力】");
    g_tipLine[4064] = StringToText("如果你是对你的阵营落败负最大责任的人，你转变阵营并获胜，即使你已死亡。");
    g_tipLine[4065] = StringToText("【角色简介】");
    g_tipLine[4066] = StringToText("如果政客落败，政客可以转变他的阵营。");
    g_tipLine[4067] = StringToText("· 当游戏结束时，如果政客是善良阵营落败负最大责任的人，政客会加入邪恶阵营并一起获胜。");
    g_tipLine[4068] = StringToText("· 当决定谁获胜的关键时候，政客玩家应当非常有影响力。");
    g_tipLine[4069] = StringToText("  简单的散布错误信息或投票善良玩家通常是不够的——他需要比任何一个其他的善良玩家起到让善良阵营落败的关");
    g_tipLine[4070] = StringToText("  键作用，同时最好也是比任何一个邪恶玩家的作用大。由说书人决定政客是否符合条件。");
    g_tipLine[4071] = StringToText("· 政客也可以和其他角色一样，以善良阵营获胜。");
    g_tipLine[4072] = StringToText("· 中毒或醉酒的政客不能转变阵营。");
    g_tipLine[4073] = StringToText("· 如果邪恶玩家的总数已经比初始设置多了一名，即使政客是对善良阵营落败负最大责任的人，");
    g_tipLine[4074] = StringToText("  由于圣洁之魂的存在，也不能转变阵营获胜。");
    g_tipLine[4075] = StringToText("【规则细节】");
    g_tipLine[4076] = StringToText("· 相克规则：");
    g_tipLine[4077] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。");
    g_tipLine[4078] = StringToText("  · 维齐尔：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[4079] = StringToText("  · 科学怪人：恶魔无法拥有政客的能力。");
    g_tipLine[4080] = StringToText("  · 军团：政客可能会被军团当作邪恶玩家。");
    g_tipLine[4081] = StringToText("【角色能力】");
    g_tipLine[4082] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipLine[4083] = StringToText("【角色简介】");
    g_tipLine[4084] = StringToText("异端分子能够转换胜负结果。");
    g_tipLine[4085] = StringToText("· 如果一局游戏会使得善良阵营获胜，异端分子会导致所有善良玩家落败，且邪恶玩家获胜。");
    g_tipLine[4086] = StringToText("· 如果一局游戏将由邪恶阵营获胜而结束，邪恶玩家落败，善良玩家获胜。");
    g_tipLine[4087] = StringToText("· 异端分子的能力会应用于所有的胜利条件，包括只剩两名非旅行者玩家存活，所有恶魔死亡，");
    g_tipLine[4088] = StringToText("  或一项能力导致的游戏结束。");
    g_tipLine[4089] = StringToText("· 异端分子的能力在他死亡时仍然正常生效，但在他醉酒中毒时不会生效。");
    g_tipLine[4090] = StringToText("【规则细节】");
    g_tipLine[4091] = StringToText("· 特定角色互动：");
    g_tipLine[4092] = StringToText("  · 食人族：（参考最新的处决流程整理）如果异端分子被处决并导致游戏结束，食人族不会获得异端分子的能力。");
    g_tipLine[4093] = StringToText("  · 将军：将军的信息应该将异端分子考虑在内。如果善良阵营已经非常接近找出并处决恶魔，但异端分子在场，");
    g_tipLine[4094] = StringToText("    因为处决恶魔会导致邪恶阵营获胜，所以应该展示邪恶更有优势。");
    g_tipLine[4095] = StringToText("  · 哲学家：如果哲学家选择异端分子，随后死亡，哲学家仍然保留这个能力，因为那是「死后能力保留」的能力。");
    g_tipLine[4096] = StringToText("    然而，原始异端分子也会在哲学家死亡时恢复清醒，这意味着游戏中有两个正常生效的异端分子能力。");
    g_tipLine[4097] = StringToText("  · 镜像双子：异端分子的能力只有在游戏因为满足某个胜利条件而结束的时候才会生效。");
    g_tipLine[4098] = StringToText("    所以镜像双子将会阻止因善良阵营获胜而结束游戏，但如果游戏因邪恶阵营获胜而结束，");
    g_tipLine[4099] = StringToText("    异端分子能力会生效并转为让善良阵营获胜。");
    g_tipLine[4100] = StringToText("· 相克规则：");
    g_tipLine[4101] = StringToText("  · 教父：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4102] = StringToText("  · 间谍：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4103] = StringToText("  · 寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4104] = StringToText("  · 麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4105] = StringToText("  · 痢蛭：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4106] = StringToText("  · 男爵：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4107] = StringToText("  · 科学怪人：恶魔无法拥有异端分子的能力。");
    g_tipLine[4108] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4109] = StringToText("  · 狐媚娘：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[4110] = StringToText("【角色能力】");
    g_tipLine[4111] = StringToText("一名玩家醉酒，即使你已死亡。每局游戏限一次，你可以猜测谁是那个醉酒的玩家，如果猜对了，你会得知谁是恶魔，");
    g_tipLine[4112] = StringToText("但如果猜错了，你会得知错误的「谁是恶魔」信息。");
    g_tipLine[4113] = StringToText("【角色简介】");
    g_tipLine[4114] = StringToText("解谜大师需要尝试找出谁醉酒了。");
    g_tipLine[4115] = StringToText("· 会有一名玩家因为解谜大师的能力在整局游戏中醉酒。通常来说会是镇民，也有可能会是外来者。");
    g_tipLine[4116] = StringToText("  该玩家不会知道自己醉酒了。");
    g_tipLine[4117] = StringToText("· 每局游戏限一次，解谜大师可以猜测谁是那名醉酒的玩家。可以进行公开猜测，也可以私下找说书人猜测。");
    g_tipLine[4118] = StringToText("  不论他猜了什么，说书人都会私下告诉解谜大师一名玩家的名字。如果解谜大师猜测正确，");
    g_tipLine[4119] = StringToText("  他得知的会是恶魔玩家。如果解谜大师猜测错误，他得知的则是非恶魔玩家。");
    g_tipLine[4120] = StringToText("· 解谜大师不会得知自己的猜测正确与否。");
    g_tipLine[4121] = StringToText("· 只有猜中因解谜大师的能力醉酒的玩家才算作猜测正确。猜测因为其他原因醉酒的玩家不算猜测正确。");
    g_tipLine[4122] = StringToText("· 在解谜大师死亡后，他的能力造成的醉酒玩家会依然醉酒。已经死亡的解谜大师不能猜测，");
    g_tipLine[4123] = StringToText("  他这一部分的能力因为死亡而失去了。");
    g_tipLine[4124] = StringToText("【规则细节】");
    g_tipLine[4125] = StringToText("· 如果场上存在多名恶魔，只告诉解谜大师一名恶魔。优先告诉解谜大师当前存活的邪恶的恶魔。");
    g_tipLine[4126] = StringToText("· 特定角色互动：");
    g_tipLine[4127] = StringToText("  · 哈迪寂亚/沙巴洛斯：如果解谜大师复活，因解谜大师而醉酒的玩家可以改变，解谜大师也会刷新猜测能力。");
    g_tipLine[4128] = StringToText("  · 食人族：如果食人族获得解谜大师的能力，会有某名玩家因此开始醉酒，直到其他玩家被处决并死亡。在此期间，");
    g_tipLine[4129] = StringToText("    食人族解谜大师可以猜测因其被醉酒的玩家并被告知恶魔。如果食人解谜大师在获得新的能力前就死亡，");
    g_tipLine[4130] = StringToText("    他会继续使那名玩家醉酒直到游戏结束。");
    g_tipLine[4131] = StringToText("【角色能力】");
    g_tipLine[4132] = StringToText("如果有大于等于五名玩家存活，你必须在所有提名中投票。");
    g_tipLine[4133] = StringToText("【角色简介】");
    g_tipLine[4134] = StringToText("狂热者热衷于所有投票。");
    g_tipLine[4135] = StringToText("· 如果存活玩家数量为五人或更多，狂热者必须在所有提名中投票。如果只有四名或更少的玩家存活，");
    g_tipLine[4136] = StringToText("  狂热者可以自由选择是否参与投票。");
    g_tipLine[4137] = StringToText("· 在狂热者的能力中，旅行者的数量也计入存活玩家的数量内。");
    g_tipLine[4138] = StringToText("· 如果狂热者死亡，他可以像其他死亡玩家一样正常选择是否投票。");
    g_tipLine[4139] = StringToText("· 狂热者在流放中不是必须要举手赞成的。");
    g_tipLine[4140] = StringToText("· 即使狂热者认定自己醉酒或中毒，他也必须强制参与投票。");
    g_tipLine[4141] = StringToText("· 说书人没有义务提醒狂热者。狂热者必须为自己的投票行为负责。故意不参与投票将被认定为作弊。");
    g_tipLine[4142] = StringToText("【规则细节】");
    g_tipLine[4143] = StringToText("· 相克规则：");
    g_tipLine[4144] = StringToText("  · 食人族：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[4145] = StringToText("  · 维齐尔：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[4146] = StringToText("  · 军团：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[4147] = StringToText("【角色能力】");
    g_tipLine[4148] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipLine[4149] = StringToText("【角色简介】");
    g_tipLine[4150] = StringToText("帽匠允许邪恶角色的玩家改变自己的角色。");
    g_tipLine[4151] = StringToText("· 帽匠的能力使得所有邪恶角色的玩家可以选择变成与自己原本角色类型相同的角色。");
    g_tipLine[4152] = StringToText("· 这些玩家可以选择不改变自己的角色。");
    g_tipLine[4153] = StringToText("· 如果一名玩家变成了新的角色，他会获得新角色的能力，即使是一项「在你的首个夜晚」");
    g_tipLine[4154] = StringToText("  能力或是一项「每局游戏限一次」但此前已被其他玩家使用过的能力。");
    g_tipLine[4155] = StringToText("· 一旦玩家的角色变化，他此前的角色能力不再在本局游戏中生效。");
    g_tipLine[4156] = StringToText("· 如果一名玩家在死亡后再变成帽匠，邪恶角色的玩家无法在当晚因此改变自己的角色。");
    g_tipLine[4157] = StringToText("· 一旦某名玩家选择变成了某个角色后，其他玩家便无法选择变成同一角色。");
    g_tipLine[4158] = StringToText("  如果某名玩家选择变成了一个已在场的角色，那么那个角色对应的玩家必须选择变成一个新的角色。");
    g_tipLine[4159] = StringToText("【规则细节】");
    g_tipLine[4160] = StringToText("· 由说书人决定恶魔和爪牙在茶会中选择更换角色的先后顺序，且需要注意控制茶会的时间。");
    g_tipLine[4161] = StringToText("  如果认为同时睁眼会使得夜晚时间过长，或在容易出现善良爪牙/恶魔的剧本中导致邪恶阵营暴露，");
    g_tipLine[4162] = StringToText("  说书人也可以酌情分别独自唤醒这些玩家并执行角色变化的操作。");
    g_tipLine[4163] = StringToText("· 如果帽匠在夜晚时由于恶魔的攻击而死亡，在茶会中产生的新恶魔在当晚无法再次攻击。");
    g_tipLine[4164] = StringToText("· 相克规则：");
    g_tipLine[4165] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[4166] = StringToText("  · 军团：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[4167] = StringToText("  · 小怪宝：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[4168] = StringToText("  · 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[4169] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4170] = StringToText("  · 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[4171] = StringToText("【角色能力】");
    g_tipLine[4172] = StringToText("当你死亡时，说书人会获得一个爪牙能力。");
    g_tipLine[4173] = StringToText("【角色简介】");
    g_tipLine[4174] = StringToText("瘟疫医生会将额外的爪牙能力带入游戏中。");
    g_tipLine[4175] = StringToText("· 由说书人来选择获得哪一个爪牙的能力。");
    g_tipLine[4176] = StringToText("· 瘟疫医生的能力效果会在剩余的游戏时间里持续生效。");
    g_tipLine[4177] = StringToText("· 说书人不会有其他变化——他不会转为邪恶阵营，不会成为玩家，不会成为其他能力的合法目标，不能参与投票，");
    g_tipLine[4178] = StringToText("  也不能发起提名。");
    g_tipLine[4179] = StringToText("· 如果瘟疫医生在死亡时醉酒中毒，说书人不会获得爪牙能力，即使瘟疫医生在之后恢复清醒健康。");
    g_tipLine[4180] = StringToText("【规则细节】");
    g_tipLine[4181] = StringToText("· 相克规则：");
    g_tipLine[4182] = StringToText("  · 男爵：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[4183] = StringToText("  · 炸弹人：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipLine[4184] = StringToText("  · 镜像双子：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[4185] = StringToText("  · 提线木偶：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[4186] = StringToText("  · 恐惧之灵/哥布林/红唇女郎/间谍/亡魂：如果说书人本应获得这些爪牙之一的能力，");
    g_tipLine[4187] = StringToText("    改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[4188] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4189] = StringToText("  · 赶尸人/狐媚娘/养蛊人/蛊雕：如果说书人本应获得这些爪牙之一的能力，改为一名爪牙玩家获得此能力，");
    g_tipLine[4190] = StringToText("    且他会得知此事。");
    g_tipLine[4191] = StringToText("【角色能力】");
    g_tipLine[4192] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：你转变为他的阵营，即使你已醉酒或中毒，");
    g_tipLine[4193] = StringToText("但你不知道你转变后的阵营。");
    g_tipLine[4194] = StringToText("【角色简介】");
    g_tipLine[4195] = StringToText("食人魔是某人最好的朋友！");
    g_tipLine[4196] = StringToText("· 食人魔选定了玩家之后，目标不会变化；「挚友」标记会放在该玩家旁，且食人魔始终与他同阵营。");
    g_tipLine[4197] = StringToText("· 食人魔会在他的首个夜晚选择玩家后立即转变为那名玩家的阵营，即使他在选择时醉酒或中毒也是如此。");
    g_tipLine[4198] = StringToText("· 说书人不会主动告知食人魔转变后的阵营；朋友阵营变化时，食人魔会跟着改变。");
    g_tipLine[4199] = StringToText("· 如果随后食人魔的阵营因为其他方式发生变化，食人魔会如常得知他转变后的阵营。");
    g_tipLine[4200] = StringToText("· 如果食人魔在游戏中途被创造，他需要在当晚选择一名玩家，并转变为那名玩家的阵营。");
    g_tipLine[4201] = StringToText("【规则细节】");
    g_tipLine[4202] = StringToText("· 相克规则：");
    g_tipLine[4203] = StringToText("  · 陌客：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_tipLine[4204] = StringToText("  · 间谍：间谍必定被食人魔当作邪恶阵营。");
    g_tipLine[4205] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶食人魔无法因为自身能力转变为善良阵营。");
    g_tipLine[4206] = StringToText("  · 科学怪人：恶魔无法拥有食人魔的能力。");
    g_tipLine[4207] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[4208] = StringToText("  · 蛊雕：如果「蛊毒」玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。");









    g_tipLine[4800] = StringToText("【角色能力】");
    g_tipLine[4801] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色。");
    g_tipLine[4802] = StringToText("【角色简介】");
    g_tipLine[4803] = TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[4804] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会被唤醒，得知两名玩家，并得知其中一人的角色。");
    g_tipLine[4805] = StringToText("· ") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[4806] = StringToText("【规则细节】");
    g_tipLine[4807] = StringToText("· 不同于") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("永远不可能得知没有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("在场。在极端情况下（如5人局且有") + TextWithColor(StringToText("男爵"), Color(0, 191, 255)) + StringToText("在");
    g_tipLine[4808] = StringToText("  场时），") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会得知自己与任意一名玩家之中有") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("，但这在大部分情况下也等同于明示") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("有");
    g_tipLine[4809] = StringToText("  ") + TextWithColor(StringToText("男爵"), Color(0, 191, 255)) + StringToText("在场了。因此如果这种情形可能发生，说书人也应该调整角色配置让本局游戏更加有趣一些。");
    g_tipLine[4810] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("标记的玩家），");
    g_tipLine[4811] = StringToText("  或得知错误的角色，或两者兼而有之。但即使如此，说书人也应该让") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，");
    g_tipLine[4812] = StringToText("  否则等同于在明示") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("她自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，且给出的信息也不符合") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("应该获取的信息内容。");
    g_tipLine[4813] = StringToText("· 特定角色互动：");
    g_tipLine[4814] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，并得知") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[4815] = StringToText("【角色能力】");
    g_tipLine[4816] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255));
    g_tipLine[4817] = StringToText("  在场）。");
    g_tipLine[4818] = StringToText("【角色简介】");
    g_tipLine[4819] = TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[4820] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("会得知两名玩家其中一人的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[4821] = StringToText("· ") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[4822] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。如果") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("得知两名玩家中有") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("，他不会得知") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩家以为的那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[4823] = StringToText("【规则细节】");
    g_tipLine[4824] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置他的提示标记的玩家），");
    g_tipLine[4825] = StringToText("  或得知错误的角色，或两者兼而有之。但即使如此，说书人也应该让") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，");
    g_tipLine[4826] = StringToText("  否则等同于在明示") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("他自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，且给出的信息也不符合") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("应该获取的信息内容。");
    g_tipLine[4827] = StringToText("· 因为给出“0”这样的信息也在") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("的合理信息范围内，因此") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("在某些情况");
    g_tipLine[4828] = StringToText("  下，说书人也可以给出“0”这样的信息以进行信息混淆。（如场上有") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[4829] = StringToText("  但本剧本中还含有") + TextWithColor(StringToText("哨兵"), Color(255, 215, 0)) + StringToText("的时候，玩家将无法确信场上是否有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("）但大部分时候，");
    g_tipLine[4830] = StringToText("  在很容易能确定场上有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的场合下给出“0”这样的信息，基本上等同于明示") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("了。");
    g_tipLine[4831] = StringToText("· 特定角色互动：");
    g_tipLine[4832] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：在仅有一名") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("且为") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("的情况下，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("可能会将") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("当作非") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，");
    g_tipLine[4833] = StringToText("  从而得知没有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场。");
    g_tipLine[4834] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，并得知") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[4835] = StringToText("【角色能力】");
    g_tipLine[4836] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场）。");
    g_tipLine[4837] = StringToText("【角色简介】");
    g_tipLine[4838] = TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[4839] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("会得知两名玩家其中一人的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[4840] = StringToText("· ") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[4841] = StringToText("【规则细节】");
    g_tipLine[4842] = StringToText("· 在仅有一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("且为") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("的情况下，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("可能会将") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("当作非") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，从而得知没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场。");
    g_tipLine[4843] = StringToText("  这种情况下，实际上也与“得知两名玩家其中之一是") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("”相似（因为基本上不可能存在初始没有任何");
    g_tipLine[4844] = StringToText("  ") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场的情况），但相对来说") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("在得知“0”的时候会对谁是") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("这一事实毫无头绪。");
    g_tipLine[4845] = StringToText("· 由于") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("这样的角色存在，很有可能出现某局游戏进行到一半时没有任何") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色在场，");
    g_tipLine[4846] = StringToText("  此时有新的") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("产生时，也会因此得知“0”。");
    g_tipLine[4847] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置他的提示标记的玩家），");
    g_tipLine[4848] = StringToText("  或得知错误的角色，或两者兼而有之。但即使如此，说书人也应该让") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，");
    g_tipLine[4849] = StringToText("  否则等同于在明示") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("他自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，且给出的信息也不符合") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("应该获取的信息内容。");
    g_tipLine[4850] = StringToText("· 特定角色互动：");
    g_tipLine[4851] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，并得知") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[4852] = StringToText("· 相克规则：");
    g_tipLine[4853] = StringToText("· ") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("：说书人不会宣布") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("在场。");
    g_tipLine[4854] = StringToText("【角色能力】");
    g_tipLine[4855] = StringToText("在你的首个夜晚，你会得知场上邻座的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家有多少对。");
    g_tipLine[4856] = StringToText("【角色简介】");
    g_tipLine[4857] = TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会得知是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家相邻而坐。");
    g_tipLine[4858] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会得知有多少对") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家相邻而坐。两名相邻而坐的玩家为一对，");
    g_tipLine[4859] = StringToText("  然而每名玩家都能分别与两侧的玩家各组成一对。因此，两名相邻而坐的玩家是一对，");
    g_tipLine[4860] = StringToText("  三名相邻而坐的玩家是两对，四名相邻而坐的玩家是三对，以此类推。");
    g_tipLine[4861] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会像探查其他角色类型一样探查") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("旅行者，但仅仅只会关注那些在") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("行动前加入游戏的旅行者。");
    g_tipLine[4862] = StringToText("【规则细节】");
    g_tipLine[4863] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的单次能力会为玩家进行多次检测判断。因此具有互动干扰类能力的角色可能会在与其左右相邻的玩");
    g_tipLine[4864] = StringToText("  家组合中被当作不同的阵营。但通常来说，我们建议按照在") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的单次能力探查中始终保持同一阵营来进");
    g_tipLine[4865] = StringToText("  行判断，以提升") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("玩家的游戏体验。毕竟，不仅互动干扰能力会影响") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的结果，") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("和") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("也会。");
    g_tipLine[4866] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的能力探查的是相邻玩家，且并未加“存活”这一附加条件。在游戏中途产生的") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[4867] = StringToText("  获取到的信息仍然会考虑仍然在游戏中的所有玩家（已经提前离开游戏的旅行者则不算在内）。");
    g_tipLine[4868] = StringToText("【角色能力】");
    g_tipLine[4869] = StringToText("每个夜晚，你会得知与你邻近的两名存活的玩家中") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的数量。");
    g_tipLine[4870] = StringToText("【角色简介】");
    g_tipLine[4871] = TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("会持续得知与自己邻近的玩家是否为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[4872] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("只会得知与自己邻近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家数量，但不会得知具体哪一名玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[4873] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("不会探查已死亡的玩家。因此，如果") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("与一位已死亡玩家相邻，");
    g_tipLine[4874] = StringToText("  他不会获取到有关死亡玩家的任何信息。取而代之的是，他会获取与那位死亡玩家同一方向上最近的存活");
    g_tipLine[4875] = StringToText("  玩家的信息。");
    g_tipLine[4876] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后行动，因此如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("邻近玩家之一，") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("不会得知有关那位现在已死的");
    g_tipLine[4877] = StringToText("  玩家的信息。") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("的信息以当晚黎明时的状态为基准，而非黄昏。");
    g_tipLine[4878] = StringToText("【规则细节】");
    g_tipLine[4879] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("得知的信息是当晚黎明时的状况，而非黄昏时的，因此在当晚复活的角色（通常会是在") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("行动");
    g_tipLine[4880] = StringToText("  之前复活），也可能会因为成为与") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("邻近的存活玩家，从而影响") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("获取的信息。");
    g_tipLine[4881] = StringToText("【角色能力】");
    g_tipLine[4882] = StringToText("每个夜晚，你要选择两名玩家：你会得知他们之中是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[4883] = StringToText("会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被你的能力当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[4884] = StringToText("【角色简介】");
    g_tipLine[4885] = TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("能探查谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但某些时候也会误以为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[4886] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("需要选择两名玩家，得知其中是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。他不会得知具体哪一名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[4887] = StringToText("  只知道两名玩家之中有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果两名玩家均不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他会得知“否”。");
    g_tipLine[4888] = StringToText("· 不幸的是，会有一名被称作“干扰项”的玩家，会被") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("在选中时当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[4889] = StringToText("  “干扰项”在一整场游戏中只会是同一名玩家。这名玩家可以是任何") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，甚至是") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipLine[4890] = StringToText("  ") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("不会知道哪一名玩家是他的“干扰项”。");
    g_tipLine[4891] = StringToText("· ") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("可以选择任意两名玩家——无论他们存活与否，甚至可以选择自己。");
    g_tipLine[4892] = StringToText("  如果") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("选中了已死亡的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，仍然会得知“是”。");
    g_tipLine[4893] = StringToText("【规则细节】");
    g_tipLine[4894] = StringToText("· 虽然在") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的角色详解中提及了“‘干扰项’在一整场游戏中只会是同一名玩家”，");
    g_tipLine[4895] = StringToText("  但这是由于在暗流涌动中不会出现阵营转变效果而导致的。不去介绍更深层次的规则仅仅只是不希望玩家");
    g_tipLine[4896] = StringToText("  在一开始就因为接收到过于复杂的规则而变得迷惑（正常来说，玩家需要进入到梦殒春宵后才会接触到阵");
    g_tipLine[4897] = StringToText("  营转变的效果）。实际上，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的能力包含了动态检测效果，一旦被他标记为“干扰项”的那名玩家变");
    g_tipLine[4898] = StringToText("  为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，说书人就需要重新选择另一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家并放置“干扰项”标记。");
    g_tipLine[4899] = StringToText("  但只要被标记为“干扰项”的玩家阵营没有发生变化，那么他就始终都会是“干扰项”。");
    g_tipLine[4900] = StringToText("  这种情况其实与得知") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("在场的玩家变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营后，会重新有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家得知") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("在场是类似的。");
    g_tipLine[4901] = StringToText("· 虽然在绝大部分情况下这并没有什么用，但是以为自己是") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("因为不具有") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的能力，");
    g_tipLine[4902] = StringToText("  也就因此不会有“干扰项”这个标记。") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("同理。");
    g_tipLine[4903] = StringToText("· 特定角色互动：");
    g_tipLine[4904] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("因为选择“干扰项”而得知“是”不会计入到") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("的能力检测中，");
    g_tipLine[4905] = StringToText("  因为这是他自身能力让自己获取的信息出错。") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("情况下，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("选择了“干扰项”玩家而得知了“");
    g_tipLine[4906] = StringToText("  否”时（因为在未") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("情况下会得知“是”，“看错干扰项”这一能力因为") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而未正常生效），");
    g_tipLine[4907] = StringToText("  会计入到") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("的能力检测中。");
    g_tipLine[4908] = StringToText("· ") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("仅仅选中了“干扰项”会得知“是”，这是因为") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的获取信息只判断“");
    g_tipLine[4909] = StringToText("  是否选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("”，而这次选择他没有选中") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，因此得知“是”。");
    g_tipLine[4910] = StringToText("· 咖啡师：咖啡师的“获取正确信息”效果对") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("生效的期间里，会让") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("不再把“干扰项”错认成");
    g_tipLine[4911] = StringToText("  ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[4912] = StringToText("【角色能力】");
    g_tipLine[4913] = StringToText("每个夜晚*，你会得知今天白天死于处决的玩家的角色。");
    g_tipLine[4914] = StringToText("【角色简介】");
    g_tipLine[4915] = TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会得知当天因处决而死亡的角色。");
    g_tipLine[4916] = StringToText("· 只有死于处决的玩家才会被") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("得知是哪一种角色。在白天因为其他原因造成的死亡，");
    g_tipLine[4917] = StringToText("  例如枪手杀死的玩家，或对旅行者的流放，不算在内。");
    g_tipLine[4918] = StringToText("· ") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会在除首个夜晚以外的每晚醒来，因为在首个夜晚之前不会有任何处决发生。");
    g_tipLine[4919] = StringToText("· 如果当天没有玩家死亡，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("不会得知任何消息。说书人在夜晚时要么不唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[4920] = StringToText("  要么唤醒他但并不对他展示角色标记。");
    g_tipLine[4921] = StringToText("· 如果") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("被处决，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会被展示") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("标记，而非那名") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩家以为自己是的那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("标记。");
    g_tipLine[4922] = StringToText("【规则细节】");
    g_tipLine[4923] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("可能不会被唤醒，");
    g_tipLine[4924] = StringToText("  也可能会被唤醒但不得知任何消息。说书人可以自行决定并提前告知玩家本场游戏将以何种方式运作。");
    g_tipLine[4925] = StringToText("  然而，不论是否唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，都不应该对") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("获得的消息产生影响。（即：");
    g_tipLine[4926] = StringToText("  如果说书人决定不唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，那么无论实际操作中是否唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("都不应探查到") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("被唤醒，");
    g_tipLine[4927] = StringToText("  反之亦然。）");
    g_tipLine[4928] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，但") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("不会因此得知错误的信息。");
    g_tipLine[4929] = StringToText("  因为无人因处决而死，所以") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("不会因此获得信息，也就不会受到") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("的影响。");
    g_tipLine[4930] = StringToText("· 在夜晚因处决而死亡的玩家其角色不会被") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("得知。");
    g_tipLine[4931] = StringToText("【角色能力】");
    g_tipLine[4932] = StringToText("每个夜晚*，你要选择除你以外的一名玩家：当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对他无效。");
    g_tipLine[4933] = StringToText("【角色简介】");
    g_tipLine[4934] = TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("会保护他人免受") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("侵害。");
    g_tipLine[4935] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("可以保护除自己以外的任意玩家。");
    g_tipLine[4936] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了被") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("保护的玩家，那名玩家不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也不能再去攻击另一名玩家——当晚会没有");
    g_tipLine[4937] = StringToText("  任何人死亡。");
    g_tipLine[4938] = StringToText("· ") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("无法保护被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名并处决的玩家。");
    g_tipLine[4939] = StringToText("【规则细节】");
    g_tipLine[4940] = StringToText("· ") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("能够保护的有害效果包括：死亡，") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，疯狂，阵营变化，来自与该玩家（保护目标）");
    g_tipLine[4941] = StringToText("  阵营不同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角色变化，") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("的错误信息，等等。");
    g_tipLine[4942] = StringToText("· ") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("无法保护的效果包括：复活（") + TextWithColor(StringToText("沙巴洛斯"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("哈迪寂亚"), Color(255, 0, 0)) + StringToText("），来自与该玩家（保护目标）");
    g_tipLine[4943] = StringToText("  阵营相同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角色变化，照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("，成为") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的寄生对象（只会让该玩家免疫") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[4944] = StringToText("  但") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的免死能力还是会与该玩家绑定），等等。");
    g_tipLine[4945] = StringToText("· 相克规则：");
    g_tipLine[4946] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("上个夜晚保护的那名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[4947] = StringToText("· 暴乱：如果暴乱提名并处决了") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("上个夜晚保护的那名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[4948] = StringToText("【角色能力】");
    g_tipLine[4949] = StringToText("如果你在夜晚死亡，你会被唤醒，然后你要选择一名玩家：你会得知他的角色。");
    g_tipLine[4950] = StringToText("【角色简介】");
    g_tipLine[4951] = TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("仅当在夜晚死去时，才能得知任意玩家的角色。");
    g_tipLine[4952] = StringToText("· ") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("会在他死去的那个夜晚被唤醒，然后立刻选择一名玩家。");
    g_tipLine[4953] = StringToText("· 如果") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("愿意，他可以选择一名已死亡的玩家。");
    g_tipLine[4954] = StringToText("【规则细节】");
    g_tipLine[4955] = StringToText("· 只要") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("死在夜晚，不论因什么原因而死，他都能被唤醒并使用能力。");
    g_tipLine[4956] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("，或是以为自己是") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("如果在夜晚死亡，");
    g_tipLine[4957] = StringToText("  仍然会被唤醒并使用能力。");
    g_tipLine[4958] = StringToText("· ") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("只会得知玩家的角色，不会得知玩家的阵营。") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("在得知信息时会受到互动干扰类能力的影响而");
    g_tipLine[4959] = StringToText("  可能得知错误的角色。");
    g_tipLine[4960] = StringToText("· 相克规则：");
    g_tipLine[4961] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：每个夜晚*，") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：");
    g_tipLine[4962] = StringToText("  如果") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("被选择，他的能力生效但不会死亡。");
    g_tipLine[4963] = StringToText("· 暴乱：每个夜晚*，暴乱要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[4964] = StringToText("  他的能力生效但不会死亡。");
    g_tipLine[4965] = StringToText("【角色能力】");
    g_tipLine[4966] = StringToText("当你首次被提名时，如果提名你的玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他立刻被处决。");
    g_tipLine[4967] = StringToText("【角色简介】");
    g_tipLine[4968] = TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("不会被处决……也许吧。提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的玩家通常会死亡。");
    g_tipLine[4969] = StringToText("· 如果一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("，那名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("会立即被处决。因为每天只能有最多一次处决，");
    g_tipLine[4970] = StringToText("  提名的流程会立即结束，即使有其他玩家被提名且即将被处决。");
    g_tipLine[4971] = StringToText("· 只有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("才会被") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的能力处决。如果") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("，无事发生，");
    g_tipLine[4972] = StringToText("  并且提名流程会继续。");
    g_tipLine[4973] = StringToText("· ") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的能力非常强大，因为如果有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("并死亡，那么几乎可以确定这两名角色一定都是");
    g_tipLine[4974] = StringToText("  ") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[4975] = StringToText("· 当第一次被提名后，") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("会失去能力，即使发起提名者没有死亡，或者") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("状态。");
    g_tipLine[4976] = StringToText("【规则细节】");
    g_tipLine[4977] = StringToText("· 如果提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的玩家其") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色不会因为处决而死亡（如") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("或被") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("保护的玩家），");
    g_tipLine[4978] = StringToText("  则说书人会宣布该玩家被处决但没有死亡（不会说明具体原因），然后因为有处决发生，");
    g_tipLine[4979] = StringToText("  所以白天阶段依然会立即结束。");
    g_tipLine[4980] = StringToText("· 如果提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家同时被") + TextWithColor(StringToText("女巫"), Color(0, 191, 255)) + StringToText("诅咒，则") + TextWithColor(StringToText("女巫"), Color(0, 191, 255)) + StringToText("的诅咒与") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的处决在同一时间被触发。");
    g_tipLine[4981] = StringToText("  在这种情况下，由说书人来对以何种顺序结算这两个效果做出决定，但应该倾向于产生更多信息的结果（");
    g_tipLine[4982] = StringToText("  参考隐性规则第1条，同时触发）。因此，在大部分情况下，即使该玩家的角色是还未触发能力的") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[4983] = StringToText("  也建议当晚") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("依然能够得知该玩家的角色。");
    g_tipLine[4984] = StringToText("【角色能力】");
    g_tipLine[4985] = StringToText("每局游戏限一次，你可以在白天时公开选择一名玩家：如果他是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他死亡。");
    g_tipLine[4986] = StringToText("【角色简介】");
    g_tipLine[4987] = TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("可以通过猜测谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("来杀死他。");
    g_tipLine[4988] = StringToText("· ") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("可以在白天里的任何时间选择使用他的能力，且必须在使用能力时对所有人进行宣布。");
    g_tipLine[4989] = StringToText("  如果") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会立刻死亡。否则，无事发生。");
    g_tipLine[4990] = StringToText("· 玩家无法得知死去玩家的真实角色。毕竟，他有可能是") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("！");
    g_tipLine[4991] = StringToText("· 处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("状态下且使用了自己能力的") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("将无法再次使用他的能力。");
    g_tipLine[4992] = StringToText("· ") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("通常会选择一名存活玩家。即使") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("选中了一个已死亡的") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("，也会无事发生，");
    g_tipLine[4993] = StringToText("  因为已死亡的玩家无法再次死亡。");
    g_tipLine[4994] = StringToText("· 玩家可以在任何时间发表任何言论，因此假装是") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的玩家可以假装使用了") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[4995] = StringToText("【规则细节】");
    g_tipLine[4996] = StringToText("· 相克规则：");
    g_tipLine[4997] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的宿主，则宿主会死亡。");
    g_tipLine[4998] = StringToText("【角色能力】");
    g_tipLine[4999] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对你无效。");
    g_tipLine[5000] = StringToText("【角色简介】");
    g_tipLine[5001] = TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("无法被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死。");
    g_tipLine[5002] = StringToText("· ") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("无法因为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力而死去。因此，如果") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("在夜晚攻击") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("，无事发生。没有任何人会死亡。");
    g_tipLine[5003] = StringToText("  ") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("也不能再去选择攻击另外一名玩家。");
    g_tipLine[5004] = StringToText("· 即使发起提名的玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("仍然会因为处决而死亡。") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("的能力会保护自己不被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力杀死，");
    g_tipLine[5005] = StringToText("  但无法保护自己被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家的其他行为杀死。");
    g_tipLine[5006] = StringToText("【规则细节】");
    g_tipLine[5007] = StringToText("· 与") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("的能力相似，") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("能够免疫的有害效果包括：死亡，") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，疯狂，阵营变化，");
    g_tipLine[5008] = StringToText("  来自与自身阵营不同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角色变化，等等。");
    g_tipLine[5009] = StringToText("· ") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("无法免疫的效果包括：来自与该玩家（保护目标）阵营相同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角色变化，");
    g_tipLine[5010] = StringToText("  照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("，成为") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的寄生对象（只会让") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("免疫") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，但") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的免死能力还是会与") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("绑定），");
    g_tipLine[5011] = StringToText("  等等。");
    g_tipLine[5012] = StringToText("· 相克规则：");
    g_tipLine[5013] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5014] = StringToText("· 暴乱：如果暴乱提名并处决了") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5015] = StringToText("【角色能力】");
    g_tipLine[5016] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。");
    g_tipLine[5017] = StringToText("如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipLine[5018] = StringToText("【角色简介】");
    g_tipLine[5019] = TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("可以在最后一天通过和平的方式获得胜利。");
    g_tipLine[5020] = StringToText("· 为了生存，") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("偶尔会让其他玩家“意外地”被杀死。如果") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("被攻击且即将死去时，");
    g_tipLine[5021] = StringToText("  说书人可以选择另一名玩家死亡。没有人会得知该玩家的死亡原因，仅仅只是得知该玩家死亡了。");
    g_tipLine[5022] = StringToText("· 如果在某个白天结束时只有三名玩家存活，并且那个白天没有人被处决，那么游戏结束且") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5023] = StringToText("· 旅行者的数量也会被计入") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件中，因此他们必须先被流放。请记住流放并不是处决。（译注：");
    g_tipLine[5024] = StringToText("  如果场上有旅行者且包含旅行者在内的存活玩家只有三名，显然此时已经达成了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的胜利条件。");
    g_tipLine[5025] = StringToText("  因此如果游戏还未结束，说明场上至少还有三名非旅行者玩家，此时需要先对旅行者进行流放才能满足");
    g_tipLine[5026] = StringToText("  ") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件。）");
    g_tipLine[5027] = StringToText("· 传奇角色的数量不会被计入") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件中，因为说书人不是一名玩家。");
    g_tipLine[5028] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("，且说书人选择了一名已死亡玩家、") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("或被") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("保护的玩家作为替代，");
    g_tipLine[5029] = StringToText("  则当晚不会有玩家死亡。（但这种情况不建议频繁发生）");
    g_tipLine[5030] = StringToText("【规则细节】");
    g_tipLine[5031] = StringToText("· 如果") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的替死能力被触发，代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的角色，其死亡原因会与") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("保持一致。也就是说，");
    g_tipLine[5032] = StringToText("  如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("且") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("代替了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡，") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("能够触发他的能力。");
    g_tipLine[5033] = StringToText("  在判断那些死亡触发能力的角色的死亡原因时，这一点会显得比较重要。");
    g_tipLine[5034] = StringToText("· 同样地，在造成死亡的这个能力中，代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的角色会被当作选中为该能力的目标。");
    g_tipLine[5035] = StringToText("  原本这项能力是选择") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("并生效的，改为选择“代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的目标”并生效（不论这项选择是能力所属");
    g_tipLine[5036] = StringToText("  的玩家做出的还是说书人做出的）。也就是说，如果") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("而说书人想要通过") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的能力改为");
    g_tipLine[5037] = StringToText("  “让一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡”，这会导致在能力实际生效时，被当作“") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("在白天选中了那名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0));
    g_tipLine[5038] = StringToText("  玩家”而导致不满足回溯条件，从而使得") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("无法通过能力杀死任何玩家。这虽然是可行的，");
    g_tipLine[5039] = StringToText("  但") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("能力的触发选择权在说书人，过于复杂的互动方式会让玩家难以理解，");
    g_tipLine[5040] = StringToText("  且结果并不一定会容易被所有玩家接受，不如参考") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("词条运作方式中的建议。");
    g_tipLine[5041] = StringToText("  此外") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死在") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("手里和被大家当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家并死于处决其实结果并无区别，");
    g_tipLine[5042] = StringToText("  说书人应该考虑更为简单的处理方式。");
    g_tipLine[5043] = StringToText("· 虽然") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的特殊胜利在黄昏时宣布，但") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的特殊胜利能力触发是在白天，");
    g_tipLine[5044] = StringToText("  因此") + TextWithColor(StringToText("投毒者"), Color(0, 191, 255)) + StringToText("或者其他能让") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的角色仍然会阻止") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("因为自己的能力而以特殊方式获胜。");
    g_tipLine[5045] = StringToText("· 特定角色互动：");
    g_tipLine[5046] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：在") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("因为失去能力或其他效果影响下无法触发“代替死亡”能力时，对于") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("获取的信息，");
    g_tipLine[5047] = StringToText("  可以+1或不变。这是由于") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("需要触发能力才能检测到能力未生效从而被") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("得知，");
    g_tipLine[5048] = StringToText("  而") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的能力触发取决于说书人。通常来说，为了避免造成不必要的混乱，");
    g_tipLine[5049] = StringToText("  对于这类触发与否由说书人决定的能力，应该尽量以不变来告知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("。但特殊情况下，");
    g_tipLine[5050] = StringToText("  如果这能避免玩家过早发现") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，那么可以视情况决定给出什么样的信息。");
    g_tipLine[5051] = StringToText("· 相克规则：");
    g_tipLine[5052] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("在第五天存活且没有处决发生，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5053] = StringToText("  （即使") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营也是如此。）");
    g_tipLine[5054] = StringToText("· 暴乱：") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("可以停止暴乱的提名链。如果他这样做了，并且场上只有一名暴乱存活，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜；");
    g_tipLine[5055] = StringToText("  否则，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5056] = StringToText("【角色能力】");
    g_tipLine[5057] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家和他的角色。");
    g_tipLine[5058] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了他，你也会死亡。");
    g_tipLine[5059] = StringToText("【角色简介】");
    g_tipLine[5060] = TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("知道自己的孙子是谁，但是如果孙子被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("也会死亡。");
    g_tipLine[5061] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("会得知自己的孙子——一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色信息。");
    g_tipLine[5062] = StringToText("  孙子不会得知自己有位") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5063] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了孙子，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("也会死亡。如果孙子通过任何其他方式死亡——例如处决，");
    g_tipLine[5064] = StringToText("  或在夜晚因其他原因死亡——") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("不会因此死亡。");
    g_tipLine[5065] = StringToText("【规则细节】");
    g_tipLine[5066] = StringToText("· 在绝大多数情况下，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("得知的角色都应该是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色。因为如果") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("得知了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，");
    g_tipLine[5067] = StringToText("  这会带来") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("能力之外的额外信息（有处于") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，又或者在剧本条件不允许的情况下作为");
    g_tipLine[5068] = StringToText("  了") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的明确提示）。");
    g_tipLine[5069] = StringToText("· 相克规则：");
    g_tipLine[5070] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("在场，孙子死于处决，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5071] = StringToText("· 暴乱：如果暴乱在场，孙子死于处决，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5072] = StringToText("【角色能力】");
    g_tipLine[5073] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到下个黄昏。");
    g_tipLine[5074] = StringToText("你不会死亡。");
    g_tipLine[5075] = StringToText("【角色简介】");
    g_tipLine[5076] = TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("要么自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，要么让别人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。只要") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("是清醒状态，就不会死亡。");
    g_tipLine[5077] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，该玩家可能会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5078] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了自己，他失去自己的“不会死亡”能力，直到恢复清醒为止。");
    g_tipLine[5079] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("不小心选择了已死亡的玩家，说书人应提醒他重新选择。");
    g_tipLine[5080] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了其他玩家，由说书人来选择哪名玩家将会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5081] = StringToText("  说书人通常会让该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，但如果选择了") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，那么说书人通常会让") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5082] = StringToText("· 在") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("清醒时，他不会死亡，即使") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("还没在夜晚被唤醒。");
    g_tipLine[5083] = StringToText("【角色能力】");
    g_tipLine[5084] = StringToText("每个夜晚，你要选择除你以外的两名存活的玩家：你会得知他们中有几人在当晚因其自身能力而被唤醒。");
    g_tipLine[5085] = StringToText("【角色简介】");
    g_tipLine[5086] = TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("能得知谁在夜晚被唤醒过。");
    g_tipLine[5087] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("需要选择两名玩家，并得知他们是否在当晚被唤醒过。") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("必须选择存活的玩家，");
    g_tipLine[5088] = StringToText("  且不能选择自己。这个能力不会探查出这些玩家中谁被唤醒过，仅仅是告知数量。");
    g_tipLine[5089] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("的能力只会探查到为了使用自己的能力而被唤醒的角色。该能力不会探查因任何其他原因被唤醒的角");
    g_tipLine[5090] = StringToText("  色——例如说书人唤醒") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("让他们得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，唤醒") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("给与他在首个夜晚会获得的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("信息，");
    g_tipLine[5091] = StringToText("  因另一个角色的能力而唤醒一位玩家，或是不小心唤醒了某个人。");
    g_tipLine[5092] = StringToText("· 如果一名角色在之前的夜晚被唤醒，但在这个夜晚没有，就不会被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("探查到。");
    g_tipLine[5093] = StringToText("· ") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家当晚因自己的能力被唤醒，仍然会计算在内。");
    g_tipLine[5094] = StringToText("· 如果") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("不小心选择了已死亡的玩家或是自己，说书人应提醒她重新选择。（该条规则的细节，");
    g_tipLine[5095] = StringToText("  可以参考互动干扰页面。）");
    g_tipLine[5096] = StringToText("【规则细节】");
    g_tipLine[5097] = StringToText("· 相克规则：");
    g_tipLine[5098] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[5099] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5100] = StringToText("· ") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[5101] = StringToText("【角色能力】");
    g_tipLine[5102] = StringToText("每个夜晚*，你要选择一名玩家（与上个夜晚不同）：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他会得知你是") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5103] = StringToText("  但他当晚不会因其自身能力而被唤醒。");
    g_tipLine[5104] = StringToText("【角色简介】");
    g_tipLine[5105] = TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("能阻止") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("被唤醒来发动攻击。");
    g_tipLine[5106] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("都需要选择一名玩家。如果所选玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5107] = StringToText("  ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("仍然可以发动攻击。如果选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚不会被唤醒，因而当晚不会选择玩家进行攻击。");
    g_tipLine[5108] = StringToText("  ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会得知他不能发动攻击，且得知谁是") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5109] = StringToText("· 任何其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("能力仍然会生效——例如") + TextWithColor(StringToText("僵怖"), Color(0, 191, 255)) + StringToText("被杀后依然保持存活，") + TextWithColor(StringToText("普卡"), Color(0, 191, 255)) + StringToText("会杀死他在上一个夜晚攻击的玩家，");
    g_tipLine[5110] = StringToText("  或是") + TextWithColor(StringToText("沙巴洛斯"), Color(0, 191, 255)) + StringToText("反刍一名玩家。");
    g_tipLine[5111] = StringToText("· ") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("不能连续两个夜晚选择同一名玩家。");
    g_tipLine[5112] = StringToText("【规则细节】");
    g_tipLine[5113] = StringToText("· 相克规则：");
    g_tipLine[5114] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择的那名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5115] = StringToText("· 暴乱：如果暴乱提名并处决了") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择的那名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5116] = StringToText("· ") + TextWithColor(StringToText("牙噶巴卜"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("牙噶巴卜"), Color(255, 0, 0)) + StringToText("，那么") + TextWithColor(StringToText("牙噶巴卜"), Color(255, 0, 0)) + StringToText("在当晚无法造成死亡。");
    g_tipLine[5117] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5118] = StringToText("· 姑获鸟：一名已获得过") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力的姑获鸟被") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选中，他能够因为") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力被唤醒。");
    g_tipLine[5119] = StringToText("【角色能力】");
    g_tipLine[5120] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("到下个黄昏。");
    g_tipLine[5121] = StringToText("【角色简介】");
    g_tipLine[5122] = TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("在夜晚保护玩家们免于死亡，但是某些人在此过程中会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5123] = StringToText("· 与") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("类似，") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("能让玩家们不被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死。受保护的玩家也不会因为") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("、");
    g_tipLine[5124] = StringToText("  ") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("和旅行者的能力而死亡。");
    g_tipLine[5125] = StringToText("· ") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("只在夜晚保护玩家，并不包括白天。");
    g_tipLine[5126] = StringToText("· ") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("选择的两名玩家其中之一将在当晚和下一个白天") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。该玩家可以是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的或") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，");
    g_tipLine[5127] = StringToText("  但几乎总会是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，这取决于你的游戏走向。选择了自己的") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("可能会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5128] = StringToText("  这意味着他会失去能力并且当晚可以死亡，而他保护的另一个人也不再安全。");
    g_tipLine[5129] = StringToText("【规则细节】");
    g_tipLine[5130] = StringToText("· 相克规则：");
    g_tipLine[5131] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("上个夜晚保护的其中一名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5132] = StringToText("· 暴乱：如果暴乱提名并处决了") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("上个夜晚保护的其中一名玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[5133] = StringToText("【角色能力】");
    g_tipLine[5134] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[5135] = StringToText("【角色简介】");
    g_tipLine[5136] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("能够猜测玩家的角色……但是猜错的代价是相当巨大的。");
    g_tipLine[5137] = StringToText("· 除了首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，并在角色列表上指向一个角色图标来猜测其角色。");
    g_tipLine[5138] = StringToText("  如果猜测正确，无事发生。如果猜测错误，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("死亡。");
    g_tipLine[5139] = StringToText("· ") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[5140] = StringToText("· ") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("可以选择任何玩家，无论是已死亡还是存活，甚至可以是") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipLine[5141] = StringToText("【角色能力】");
    g_tipLine[5142] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[5143] = StringToText("【角色简介】");
    g_tipLine[5144] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[5145] = StringToText("· 每个白天，") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("可以公开发表一个声明。如果该声明是正确的，说书人会在当晚杀死一名玩家。");
    g_tipLine[5146] = StringToText("  如果声明是错误的，那就没有玩家会因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("而死。");
    g_tipLine[5147] = StringToText("· 含糊不清的词语、低声细语、说书人无法判断对错的声明、或是发表声明时有人没听到等情况下，");
    g_tipLine[5148] = StringToText("  声明都不作数。如同") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的能力，说书人和每一名玩家都必须要听到并明确") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表的声明，");
    g_tipLine[5149] = StringToText("  明白") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("正在使用自己的能力，以此来让说书人判定接下来会发生什么。");
    g_tipLine[5150] = StringToText("· 如果") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("在白天处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("时发表了一个正确的声明，但当晚") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("能力触发时他恢复了清醒和健");
    g_tipLine[5151] = StringToText("  康，那么说书人仍然会杀死一名玩家。");
    g_tipLine[5152] = StringToText("【角色能力】");
    g_tipLine[5153] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个角色：如果该角色在场，该角色之一从当晚开始") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("三天三夜。");
    g_tipLine[5154] = StringToText("【角色简介】");
    g_tipLine[5155] = TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("能使一个角色") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，且不需要知道该角色是哪名玩家。");
    g_tipLine[5156] = StringToText("· 每局游戏限一次，") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("可以选择一个角色，使其") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("三个夜晚和三个白天，立即生效。");
    g_tipLine[5157] = StringToText("· ") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("不会得知自己成功或失败，因此") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("可能会选到不在场的角色。");
    g_tipLine[5158] = StringToText("· ") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选择的是一个角色，而不是一名玩家。说书人可能需要提醒") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("玩家注意这一点。");
    g_tipLine[5159] = StringToText("  也需要提醒试图伪装成") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家注意这一点。");
    g_tipLine[5160] = StringToText("· 如果") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选择了一个角色，该角色不会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("于之后恢复了清醒和健康。");
    g_tipLine[5161] = StringToText("  如果") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("使一个角色") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，但是") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("变得") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，那名") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家会重新恢复清醒。");
    g_tipLine[5162] = StringToText("  如果") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("在三个夜晚和三个白天结束前又恢复了清醒和健康，那名被") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("选中角色的玩家还是会继续") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5163] = StringToText("【规则细节】");
    g_tipLine[5164] = StringToText("· 相克规则：");
    g_tipLine[5165] = StringToText("· ") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[5166] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：如果存活的") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("失去能力，说书人会获得") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("能力。");
    g_tipLine[5167] = StringToText("【角色能力】");
    g_tipLine[5168] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名死亡的玩家：如果他是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，你会将他起死回生。");
    g_tipLine[5169] = StringToText("【角色简介】");
    g_tipLine[5170] = TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("能让死者重获新生。");
    g_tipLine[5171] = StringToText("· 每局游戏限一次，") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("可以选择一名已死亡的玩家。如果该玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他将被复活，");
    g_tipLine[5172] = StringToText("  再次变成存活状态。");
    g_tipLine[5173] = StringToText("· 如果") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，则无事发生，并且") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("失去自己的能力。");
    g_tipLine[5174] = StringToText("· 复活的玩家会重新获得自己的能力，即使是已经使用过的“每局游戏限一次”的能力也会重新获得。");
    g_tipLine[5175] = StringToText("· 复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能不能在自己复活的当晚进行行动，取决于复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("本该在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("之前还是之后行动。");
    g_tipLine[5176] = StringToText("  如果复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("有“在你的首个夜晚”的能力，则会在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("重新入睡后立即被唤醒来使用这类能力。");
    g_tipLine[5177] = StringToText("【规则细节】");
    g_tipLine[5178] = StringToText("· 如果在城镇广场上没有死亡玩家，则无需唤醒") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("（即使可能已经有人死亡，但还未被说书人告知）。");
    g_tipLine[5179] = StringToText("  ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("也不会因此检测到") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("因为自身能力被唤醒。");
    g_tipLine[5180] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5181] = StringToText("· 狸猫：如果狸猫与使用过能力的") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("交换角色，新") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("仍然失去能力。");
    g_tipLine[5182] = StringToText("【角色能力】");
    g_tipLine[5183] = StringToText("当一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("死于处决时，除了你和旅行者以外的所有其他玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到明天黄昏。");
    g_tipLine[5184] = StringToText("【角色简介】");
    g_tipLine[5185] = StringToText("如果有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("因为处决而死去，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("会让所有人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5186] = StringToText("· 如果一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家被处决且死亡，所有玩家（除了") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("）会立即变得") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5187] = StringToText("  并在整个夜晚和下一个白天都保持") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态。") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("、甚至是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("都会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5188] = StringToText("  但是旅行者不会。如果") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在夜晚死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("不会使人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5189] = StringToText("· 如果一名已死亡的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家被处决，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发——已死亡的角色不会再次死亡！");
    g_tipLine[5190] = StringToText("  如果一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家被处决但没有死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。如果一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家在") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或");
    g_tipLine[5191] = StringToText("  ") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("期间死于处决时，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。");
    g_tipLine[5192] = StringToText("【规则细节】");
    g_tipLine[5193] = StringToText("· 相克规则：");
    g_tipLine[5194] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("死于处决，所有") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("保留能力，但") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("可能会在当晚得知今天白天死于处决的玩家是");
    g_tipLine[5195] = StringToText("  ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5196] = StringToText("【角色能力】");
    g_tipLine[5197] = StringToText("如果与你邻近的两名存活的玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，他们不会死亡。");
    g_tipLine[5198] = StringToText("【角色简介】");
    g_tipLine[5199] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("保护着她邻近的玩家免于死亡……只要他们都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的。");
    g_tipLine[5200] = StringToText("· 如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家当前都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，这两名玩家就都不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不能杀死他们，");
    g_tipLine[5201] = StringToText("  ") + TextWithColor(StringToText("教父"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("也不行。如果他们被处决，也不会死亡。唯一的例外是") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5202] = StringToText("  他能杀死受到保护而免于死亡的人。");
    g_tipLine[5203] = StringToText("· ") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的邻近的存活玩家是最靠近") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("两名存活玩家——一名为顺时针方向最近的存活玩家，");
    g_tipLine[5204] = StringToText("  一名为逆时针方向上最近的存活玩家。已死亡的邻近玩家会被跳过。");
    g_tipLine[5205] = StringToText("· 然而，如果邻近的存活玩家其中之一是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，或者两个都是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，");
    g_tipLine[5206] = StringToText("  那么") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("就无法保护她的邻近存活玩家。如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家死亡，使得") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("现在的两个邻近玩家都是");
    g_tipLine[5207] = StringToText("  ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，那么他们就又都不会死亡了。");
    g_tipLine[5208] = StringToText("【角色能力】");
    g_tipLine[5209] = StringToText("被处决的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家可能不会死亡。");
    g_tipLine[5210] = StringToText("【角色简介】");
    g_tipLine[5211] = TextWithColor(StringToText("和平主义者"), Color(0, 191, 255)) + StringToText("防止") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家因处决而死亡。");
    g_tipLine[5212] = StringToText("· 当一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家被处决时，说书人选择该玩家是死亡还是存活。");
    g_tipLine[5213] = StringToText("· 一如既往，当这类能力以如此直白的方式生效时，只需要告知大家发生了什么事，不要告知为什么发生。");
    g_tipLine[5214] = StringToText("  大家得知处决成功了，但被处决的玩家没有死亡——这就够了。");
    g_tipLine[5215] = StringToText("· 如果一名玩家被处决但依然存活，也仍然算作今天白天的处决。今天不能再发起其他的提名了。");
    g_tipLine[5216] = StringToText("【规则细节】");
    g_tipLine[5217] = StringToText("无");
    g_tipLine[5218] = StringToText("【角色能力】");
    g_tipLine[5219] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipLine[5220] = StringToText("【角色简介】");
    g_tipLine[5221] = TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("能够死里逃生……但仅限一次。");
    g_tipLine[5222] = StringToText("· ") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("首次因任何理由死亡时，他依然存活。") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会得知是他自己的能力救了自己的命。");
    g_tipLine[5223] = StringToText("· 如果其他角色的能力保护") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("免于死亡，") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会使用掉自己的能力。只有当") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("将要真正的死去时，");
    g_tipLine[5224] = StringToText("  他的能力才会触发。");
    g_tipLine[5225] = StringToText("【角色能力】");
    g_tipLine[5226] = StringToText("在你的首个夜晚，你会得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("之间最近的距离。（邻座的玩家距离为1）");
    g_tipLine[5227] = StringToText("【角色简介】");
    g_tipLine[5228] = TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("能得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("之间最近的距离。");
    g_tipLine[5229] = StringToText("· ") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("只在第一个夜晚得知该信息。");
    g_tipLine[5230] = StringToText("· 距离指代") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("之间坐着的玩家数量，从") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("旁边的玩家开始，到最近的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("结束，");
    g_tipLine[5231] = StringToText("  顺时针或逆时针均可。");
    g_tipLine[5232] = StringToText("【规则细节】");
    g_tipLine[5233] = StringToText("· 当") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("即将被唤醒之前，说书人会根据当前场上的情况给出实时的信息。");
    g_tipLine[5234] = StringToText("  这意味着") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("得知的信息可能会与游戏初始时的情况有所不同，因为有一些角色的能力能够在游戏的过");
    g_tipLine[5235] = StringToText("  程中改变玩家的角色（如") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("理发师"), Color(0, 191, 255)) + StringToText("等）。");
    g_tipLine[5236] = StringToText("· ") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("在获得信息时，说书人需要每次抽取两名玩家（其中一名为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，另一名为") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，");
    g_tipLine[5237] = StringToText("  必须是两名不同的玩家）进行距离计算，直到将场上所有的“") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("-") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("”组合遍历完毕。");
    g_tipLine[5238] = StringToText("  这一过程类似于") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("，会进行多次判断，因此某些角色可能会在不同的玩家组合中被当作为不同的结果（");
    g_tipLine[5239] = StringToText("  如") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("、照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("等）。最后，说书人会将这些距离值中的最小值作为信息提供给") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5240] = StringToText("· 在计算距离时，距离值等同于：") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("这两名玩家之间的玩家数量+1。因此，");
    g_tipLine[5241] = StringToText("  ") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("能得知的最小数字为“1”。（然而，在极端情况下，如果场上缺乏某种类型的角色，");
    g_tipLine[5242] = StringToText("  如无") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("或无") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的时候，") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("会得知“0”。）");
    g_tipLine[5243] = StringToText("· 在抽取两名玩家的组合时，即使是已死亡的玩家也依然会被") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("进行探查。");
    g_tipLine[5244] = StringToText("· 相克规则：");
    g_tipLine[5245] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("会被") + TextWithColor(StringToText("钟表匠"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5246] = StringToText("【角色能力】");
    g_tipLine[5247] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色和一个") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，");
    g_tipLine[5248] = StringToText("  该玩家是其中一个角色。");
    g_tipLine[5249] = StringToText("【角色简介】");
    g_tipLine[5250] = TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("能得知一名玩家可能对应的角色，但不能确认哪个是正确的。");
    g_tipLine[5251] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("需要选择一名其他玩家，并得知一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色与一个") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，");
    g_tipLine[5252] = StringToText("  其中一个是那名玩家的真实角色。");
    g_tipLine[5253] = StringToText("· ") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("得知的错误角色标记取决于所选玩家的真正的角色类型。如果") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5254] = StringToText("  对应的错误的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色可以是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5255] = StringToText("  对应的错误的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色可以是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5256] = StringToText("· ") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("不能选择自己和旅行者作为目标。");
    g_tipLine[5257] = StringToText("【角色能力】");
    g_tipLine[5258] = StringToText("每个夜晚，你要选择一名存活的玩家：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，你和他交换角色和阵营，然后他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5259] = StringToText("【角色简介】");
    g_tipLine[5260] = TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("会得知哪些玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("……但是如果") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("太过于冒失或贪婪，自己就会成为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5261] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("需要选择一名存活玩家。如果那名玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，无事发生。当选中一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时，");
    g_tipLine[5262] = StringToText("  ") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("变成那个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("并转为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("，那名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("则转为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("并永久") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5263] = StringToText("· 如果具有") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("能力的") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家并变成了新的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，原本的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会变成") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5264] = StringToText("【规则细节】");
    g_tipLine[5265] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5266] = StringToText("· 梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("依然失去能力。");
    g_tipLine[5267] = StringToText("【角色能力】");
    g_tipLine[5268] = StringToText("每个夜晚，你会得知有多少名玩家的能力因为其他角色的能力而未正常生效。（从上个黎明到你被唤醒时）");
    g_tipLine[5269] = StringToText("【角色简介】");
    g_tipLine[5270] = TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知从黎明开始，有多少事情“出错了”。");
    g_tipLine[5271] = StringToText("· 当一个角色的能力受到其他角色的影响而无法按预期方式发挥作用时，") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知这些异常的发生。");
    g_tipLine[5272] = StringToText("  如果由于其他角色的影响使得一名玩家获得一条本应正确，实则错误的信息时，");
    g_tipLine[5273] = StringToText("  或者本应产生效果的角色能力没有生效时，") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("就会得知这些情况。");
    g_tipLine[5274] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("不会得知异常发生在哪名玩家身上，只会得知异常在多少名玩家身上发生了。");
    g_tipLine[5275] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("的能力不会检测") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("自身是否未正常生效。");
    g_tipLine[5276] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("不会检测") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("和") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("这些状态本身，而是检测因为") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("和") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("而导致的没有按照预期发挥作用的能");
    g_tipLine[5277] = StringToText("  力。") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("当作了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("杀死，此类情况会被") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("检测到。");
    g_tipLine[5278] = StringToText("  ") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("获取了正确信息则不会被检测到。");
    g_tipLine[5279] = StringToText("【规则细节】");
    g_tipLine[5280] = StringToText("· 相克规则：");
    g_tipLine[5281] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[5282] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("是否攻击了与真正的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不同的目标。");
    g_tipLine[5283] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("产生了错误信息或“能力未正常生效”。");
    g_tipLine[5284] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("产生了错误信息或“能力未正常生效”。");
    g_tipLine[5285] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5286] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("产生了错误信息或“能力未正常生效”。");
    g_tipLine[5287] = StringToText("· ") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否被影响，即使他是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[5288] = StringToText("【角色能力】");
    g_tipLine[5289] = StringToText("每个夜晚*，你会得知在今天白天时是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("投过票。");
    g_tipLine[5290] = StringToText("【角色简介】");
    g_tipLine[5291] = TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是否参与了投票。");
    g_tipLine[5292] = StringToText("· 无论被提名的玩家是否被处决，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的投票都会被") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("计算在内。");
    g_tipLine[5293] = StringToText("· ") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("的能力不会检测到") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家因为其他的原因而举手表决。例如") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家举手“投票”选择晚餐吃");
    g_tipLine[5294] = StringToText("  什么，或者") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家举手赞成流放旅行者，都不会被") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("的能力检测到。");
    g_tipLine[5295] = StringToText("· 如果在原") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("投票之后，") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("得知该信息之前，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家发生了改变，");
    g_tipLine[5296] = StringToText("  ") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("的能力还是会检测到原") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是否投票。");
    g_tipLine[5297] = StringToText("· 如果有两名或更多的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家在场，") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("的能力都会检测他们当中是否有任一") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("投票，");
    g_tipLine[5298] = StringToText("  即使那些死去的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也能检测到。哪怕只有一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家投票，") + TextWithColor(StringToText("卖花女孩"), Color(0, 191, 255)) + StringToText("得知的信息都是“是”。");
    g_tipLine[5299] = StringToText("【规则细节】");
    g_tipLine[5300] = StringToText("无");
    g_tipLine[5301] = StringToText("【角色能力】");
    g_tipLine[5302] = StringToText("每个夜晚*，你会得知在今天白天时是否有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("发起过提名。");
    g_tipLine[5303] = StringToText("【角色简介】");
    g_tipLine[5304] = TextWithColor(StringToText("城镇公告员"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("是否提名。");
    g_tipLine[5305] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("城镇公告员"), Color(0, 191, 255)) + StringToText("都会得知“是”或“否”。");
    g_tipLine[5306] = StringToText("· 他不会得知哪些玩家是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或有多少") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("进行了提名，只会得知今天白天是否有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("发起了提名。");
    g_tipLine[5307] = StringToText("【规则细节】");
    g_tipLine[5308] = StringToText("无");
    g_tipLine[5309] = StringToText("【角色能力】");
    g_tipLine[5310] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[5311] = StringToText("【角色简介】");
    g_tipLine[5312] = TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("会得知有多少死亡玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[5313] = StringToText("· 由于") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("每晚在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后行动，所以") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("的信息以当晚黎明时的状态为基准，");
    g_tipLine[5314] = StringToText("  他得知的是在所有玩家都睁开眼睛时，死亡的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家数量。");
    g_tipLine[5315] = StringToText("· ") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("能力能检测死去的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，以及任何属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的玩家。例如") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的旅行者，");
    g_tipLine[5316] = StringToText("  或者变得") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5317] = StringToText("· 在计算死亡玩家的数量时，请记住计算在魔典中倒置的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色标记，");
    g_tipLine[5318] = StringToText("  因为这意味着他们现在属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[5319] = StringToText("【角色能力】");
    g_tipLine[5320] = StringToText("每个白天，你可以私下询问说书人以得知两条信息：一个是正确的，一个是错误的。");
    g_tipLine[5321] = StringToText("【角色简介】");
    g_tipLine[5322] = TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("能得知惊人的信息，每一个白天，甚至每一局游戏里他能得到的信息都不会相同，");
    g_tipLine[5323] = StringToText("  但其中一半是错误的。");
    g_tipLine[5324] = StringToText("· 每个白天，说书人选择两条信息提供给") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("……发挥创造力！一条必须是正确的，一条必须是错误的，");
    g_tipLine[5325] = StringToText("  ") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("不知道哪条对哪条错。");
    g_tipLine[5326] = StringToText("· 是否与说书人交谈取决于") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("而非说书人。") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("从说书人处获取信息不是公开交流，");
    g_tipLine[5327] = StringToText("  因此其他玩家不能旁听。") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("会秘密地获取信息。");
    g_tipLine[5328] = StringToText("· ") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("可以选择不从说书人那里获取信息，如果他愿意的话。");
    g_tipLine[5329] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("可能会得到两条正确信息或两条错误信息。");
    g_tipLine[5330] = StringToText("【规则细节】");
    g_tipLine[5331] = StringToText("· ") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("在中文社区内的“谜题”式信息方式引起了设计师的兴趣，对于“是否应该给") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("提供谜题类信");
    g_tipLine[5332] = StringToText("  息”，设计师的回复如下（原文翻译）：“从规则上来讲，给出这样的信息是不允许的，");
    g_tipLine[5333] = StringToText("  因为这种含糊不清的内容并不能算是‘正确’或是‘错误’的信息。然而，");
    g_tipLine[5334] = StringToText("  如果说书人愿意以这样的方式给出信息，也没有任何问题。因为这允许了新人玩家在伪装自己是") + TextWithColor(StringToText("博学者"), Color(0, 191, 255)) + StringToText("时");
    g_tipLine[5335] = StringToText("  有更为宽松的要求——他们不需要编造明显正确或是错误的信息便能成功地伪装。");
    g_tipLine[5336] = StringToText("  说书人能够在一定限度内去‘犯一些错’，而这会使得玩家们也因此在伪装上更为容易。");
    g_tipLine[5337] = StringToText("  编造谜题也会让游戏变得更加有趣。”");
    g_tipLine[5338] = StringToText("· 如果你在作为说书人时想要给出谜题类的信息，那么你需要注意适时给出更为严肃的信息来“以假乱真”，");
    g_tipLine[5339] = StringToText("  或是适当协助") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家进行一些谜题的伪造，来帮助他们显得更像是真正从你这里获得了谜题类信息一样。");
    g_tipLine[5340] = StringToText("【角色能力】");
    g_tipLine[5341] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[5342] = StringToText("【角色简介】");
    g_tipLine[5343] = TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("能得知两名玩家是否属于同一阵营。");
    g_tipLine[5344] = StringToText("· ") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("每场游戏只能得到一次信息，所以") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("最好是选择最佳时机来使用能力，");
    g_tipLine[5345] = StringToText("  还要选择最关键的玩家。");
    g_tipLine[5346] = StringToText("· ") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("可以选择除自己外的任何玩家，无论他是生是死，甚至可以选择旅行者。");
    g_tipLine[5347] = StringToText("【角色能力】");
    g_tipLine[5348] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色：你获得该角色的能力。");
    g_tipLine[5349] = StringToText("如果这个角色在场，他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5350] = StringToText("【角色简介】");
    g_tipLine[5351] = TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("能够决定自己的能力是什么。");
    g_tipLine[5352] = StringToText("· 他可以选择获得其他角色的能力，但每局仅限一次。当他这么做时，他获得那个角色的能力，");
    g_tipLine[5353] = StringToText("  但不会变成那个角色。");
    g_tipLine[5354] = StringToText("· 他在选择获得谁的能力时可能会想要思考一小会儿。如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("选择了一个已经在游戏中的角色，");
    g_tipLine[5355] = StringToText("  该角色对应的玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("死亡，") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，那么那名") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家会再次恢复清醒。");
    g_tipLine[5356] = StringToText("· 如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("之前选择了不在场的角色，但之后被选择的角色在场了，被选择的角色对应的玩家也会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5357] = StringToText("· 如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("获得了一种在夜晚使用的能力，他将在该角色应该被唤醒的时候被唤醒。");
    g_tipLine[5358] = StringToText("  如果这个角色能力是“首个夜晚”能力，他会在当晚使用该能力。");
    g_tipLine[5359] = StringToText("· 如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("通过集骨者重新获得了他的能力，或由于咖啡师使用了两次他的能力，");
    g_tipLine[5360] = StringToText("  ") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("可以选择一个新的能力，或者和以前一样的能力。");
    g_tipLine[5361] = StringToText("· 如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("获取的能力在死亡时生效，例如") + TextWithColor(StringToText("呆瓜"), Color(0, 191, 255)) + StringToText("的能力，那么当") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("死亡后，");
    g_tipLine[5362] = StringToText("  他选择的角色能力就会生效。");
    g_tipLine[5363] = StringToText("【规则细节】");
    g_tipLine[5364] = StringToText("· 与") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("相似的是，如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("所选择的角色的在场数量超过1人，那么") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("的能力只会使得其中一名玩");
    g_tipLine[5365] = StringToText("  家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。但通常来说，说书人应该倾向于优先让存活的玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5366] = StringToText("· 相克规则：");
    g_tipLine[5367] = StringToText("· ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("获得了") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("的能力，可能会有一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[5368] = StringToText("【角色能力】");
    g_tipLine[5369] = StringToText("每局游戏限一次，在白天时，你可以私下询问说书人一个是非问题，你会得知该问题的答案。");
    g_tipLine[5370] = StringToText("【角色简介】");
    g_tipLine[5371] = TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("可以向说书人提出任一是非问题。");
    g_tipLine[5372] = StringToText("· ") + TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("可以询问有关任何内容的问题，也可以随心所欲的遣词造句来提问。");
    g_tipLine[5373] = StringToText("  说书人需要诚实地回答“是”、“不是”，或“我不知道。”");
    g_tipLine[5374] = StringToText("· 是否提问由") + TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("决定，而非说书人。") + TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("向说书人询问不是公开交流，因此其他玩家不能旁听。");
    g_tipLine[5375] = StringToText("  ") + TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("会秘密地询问并获取问题的答案。");
    g_tipLine[5376] = StringToText("【规则细节】");
    g_tipLine[5377] = StringToText("· 请注意说书人有权回答“我不知道”，且这样会使得") + TextWithColor(StringToText("艺术家"), Color(0, 191, 255)) + StringToText("的能力被浪费掉。针对含糊不清的问题，");
    g_tipLine[5378] = StringToText("  或者玩家尝试用多个问题嵌套成一个问题，或是如果说书人认为让玩家“重新再问一个问题”会导致对现");
    g_tipLine[5379] = StringToText("  在的问题有一定程度的暗示作用，那么这种时候，说书人都可以回答“我不知道”。");
    g_tipLine[5380] = StringToText("【角色能力】");
    g_tipLine[5381] = StringToText("在你的首个白天，你可以公开猜测任意玩家的角色最多五次。在当晚，你会得知猜测正确的角色数量。");
    g_tipLine[5382] = StringToText("【角色简介】");
    g_tipLine[5383] = TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("会冒着风险说服别人在第一天就透露他们的角色，希望尽可能多地猜测说实话的人。");
    g_tipLine[5384] = StringToText("· 在第一个白天，") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("可以对任意玩家的角色进行猜测。当晚，他会得知他猜对的次数……如果他没有");
    g_tipLine[5385] = StringToText("  被杀害的话。");
    g_tipLine[5386] = StringToText("· 他必须公开猜测，以使所有玩家听到他猜测的内容。他可以猜测零个角色，或者最多猜测五个角色，");
    g_tipLine[5387] = StringToText("  他所猜测的玩家和角色可以相同也可以不同。");
    g_tipLine[5388] = StringToText("· 如果") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("在") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("时做出了猜测，但当晚他的能力触发时却清醒且健康，");
    g_tipLine[5389] = StringToText("  那么说书人仍然会给他真实的信息。");
    g_tipLine[5390] = StringToText("【规则细节】");
    g_tipLine[5391] = StringToText("· 不建议") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("在进行猜测时，多次进行所选玩家与角色的猜测组合完全相同的猜测。");
    g_tipLine[5392] = StringToText("  （如猜测小明是") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("三次。）但") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("仍然可以猜测同一名玩家为不同的角色多次，");
    g_tipLine[5393] = StringToText("  或猜测多名玩家为同一角色多次。");
    g_tipLine[5394] = StringToText("· 如果") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("的玩家是新人玩家，说书人可以对他进行宽容处理：在他忘记使用自己的能力的当晚唤醒他，");
    g_tipLine[5395] = StringToText("  并正常告知他信息。此时“0”为正确信息。然而如果是老手玩家，说书人则需要严格进行要求，");
    g_tipLine[5396] = StringToText("  那名玩家必须要公开声明自己是") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("之后，才能够在夜晚获得信息（即使他公开声明之后不进行任何");
    g_tipLine[5397] = StringToText("  猜测，也一样能够获得信息）。");
    g_tipLine[5398] = StringToText("· 相克规则：");
    g_tipLine[5399] = StringToText("· ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("在自己的首个白天猜测后在当天死于处决，当晚") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("会替") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("得知对应的信");
    g_tipLine[5400] = StringToText("  息。");
    g_tipLine[5401] = StringToText("【角色能力】");
    g_tipLine[5402] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5403] = StringToText("【角色简介】");
    g_tipLine[5404] = TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("在活着的时候什么也不知道，但当") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死时，他会得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5405] = StringToText("· ") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("只有在被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死时才会获取信息，死于处决时不会。");
    g_tipLine[5406] = StringToText("【规则细节】");
    g_tipLine[5407] = StringToText("· 相克规则：");
    g_tipLine[5408] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("可能会被") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("当作杀死他的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5409] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：每个夜晚*，") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[5410] = StringToText("  他的能力生效但不会死亡。");
    g_tipLine[5411] = StringToText("· 暴乱：每个夜晚*，暴乱要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[5412] = StringToText("  他的能力生效但不会死亡。");
    g_tipLine[5413] = StringToText("【角色能力】");
    g_tipLine[5414] = StringToText("每个夜晚，你会得知一名与上个夜晚得知的玩家角色类型不同的玩家。[+0~1") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[5415] = StringToText("【角色简介】");
    g_tipLine[5416] = TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("能得知不同角色类型的玩家。");
    g_tipLine[5417] = StringToText("· ") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("每次必须得知不同于上一次得知玩家的角色类型的玩家。");
    g_tipLine[5418] = StringToText("· ") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("不会得知玩家的角色类型。");
    g_tipLine[5419] = StringToText("· 向") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("展示的玩家可以存活或死亡。");
    g_tipLine[5420] = StringToText("· 向") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("展示的玩家可以") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("或") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[5421] = StringToText("· 如果") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，他可以得知与上一次得知玩家的角色类型相同的玩家。");
    g_tipLine[5422] = StringToText("  如果之后") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("恢复了健康清醒，他们必须得知与上一次得知玩家的角色类型不同的玩家。");
    g_tipLine[5423] = StringToText("· 设置调整阶段，说书人可以决定是否让") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("添加一名额外的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5424] = StringToText("【规则细节】");
    g_tipLine[5425] = StringToText("· 相克规则：");
    g_tipLine[5426] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("抽到了") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("，在设置调整阶段可能会+1") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5427] = StringToText("【角色能力】");
    g_tipLine[5428] = StringToText("你不知道你的能力是什么。每个白天你可以找说书人猜测一次，你会得知你的猜测有多准确。");
    g_tipLine[5429] = StringToText("【角色简介】");
    g_tipLine[5430] = TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("不会知道他的能力是什么。");
    g_tipLine[5431] = StringToText("· 由说书人来决定") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的具体能力。这可以是来自《染·钟楼谜团》中现有角色的能力，");
    g_tipLine[5432] = StringToText("  也可以是与之相似的能力，或是完全原创的能力。");
    g_tipLine[5433] = StringToText("· ") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("可能会在夜晚的任意时刻被唤醒，以得知信息或者选择玩家。他的能力也可以是被动效果，");
    g_tipLine[5434] = StringToText("  无需") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("玩家主动做出任何行动。");
    g_tipLine[5435] = StringToText("· 每个白天，") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("都可以私下拜访说书人，并猜测自己的能力是什么。");
    g_tipLine[5436] = StringToText("  说书人用以下方式回答") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的猜测：“无关”代表猜测与实际差距较大，");
    g_tipLine[5437] = StringToText("  “有关”代表猜测的方向正确，“接近”代表猜测的结果与实际能力较为接近，");
    g_tipLine[5438] = StringToText("  而“完美”代表猜测的结果与实际能力完全相符。");
    g_tipLine[5439] = StringToText("· ") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的猜测可以是具体的，例如“我是否是在每个夜晚得知两名阵营相同的玩家？”，");
    g_tipLine[5440] = StringToText("  也可以是较为模糊的，例如“我的能力是否与已死亡的玩家有关？”。");
    g_tipLine[5441] = StringToText("【规则细节】");
    g_tipLine[5442] = StringToText("· ") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的夜晚行动顺序并非要完全依照在线魔典的原定顺序。说书人应该根据自己为") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("设定的能力的");
    g_tipLine[5443] = StringToText("  具体情况，来决定") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("应该在什么顺序被唤醒。通常来说，如果") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的能力会造成") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("/") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5444] = StringToText("  或是具有一些保护效果，或是在较早行动才能获得更多的收益时，应该让") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("在夜晚靠前的顺序中被唤");
    g_tipLine[5445] = StringToText("  醒。如果") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的能力会得知一些信息，或是需要基于一些其他行动来被唤醒，");
    g_tipLine[5446] = StringToText("  或是在较晚行动才能获得更多的收益时，应该让") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("在夜晚靠后的顺序中被唤醒。但需要注意的是，");
    g_tipLine[5447] = StringToText("  一旦你决定好") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("的能力在夜晚的唤醒顺序时，就不应该再擅自改动，");
    g_tipLine[5448] = StringToText("  而是在每个夜晚都以这个顺序来将") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("唤醒（当然，由于能力的不同，");
    g_tipLine[5449] = StringToText("  且同一剧本中其他角色首夜和非首夜的顺序差异，") + TextWithColor(StringToText("失忆者"), Color(0, 191, 255)) + StringToText("在首个夜晚的顺序可能会与其他夜晚有所不同）。");
    g_tipLine[5450] = StringToText("【角色能力】");
    g_tipLine[5451] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，你") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("直到下个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家死于处决。");
    g_tipLine[5452] = StringToText("【角色简介】");
    g_tipLine[5453] = TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("会吃下被处决的角色，并获得他们的能力。");
    g_tipLine[5454] = StringToText("· 如果一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家死于处决，") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("能获得他的能力。如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家死于处决，");
    g_tipLine[5455] = StringToText("  ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("也只会认为自己获得了能力，因为他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，说书人可能会对他撒谎。");
    g_tipLine[5456] = StringToText("· 每当有一名玩家死于处决时，") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("会失去上一次获得的能力。");
    g_tipLine[5457] = StringToText("· 处决一名已经死亡的玩家不会让") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得能力。处决一名存活但并未导致死亡的玩家也不会让") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获");
    g_tipLine[5458] = StringToText("  得能力。玩家必须要被处决并因此死亡，才会让") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得能力。");
    g_tipLine[5459] = StringToText("· ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("不会被告知自己获得了什么能力。他必须自己弄明白。");
    g_tipLine[5460] = StringToText("· 如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得了“即使你已死亡”的能力，例如") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("，或在死亡后才会生效的能力，");
    g_tipLine[5461] = StringToText("  例如") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("心上人"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("会在死亡时仍然保留这些能力，但失去") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("自己角色本身的能力。");
    g_tipLine[5462] = StringToText("【规则细节】");
    g_tipLine[5463] = StringToText("· 如果死于处决的玩家在随后改变角色或转换阵营，同样会被") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("持续检测。");
    g_tipLine[5464] = StringToText("· 特定角色互动：");
    g_tipLine[5465] = StringToText("· ") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：获得这些能力将允许") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("转变阵营，如果有另一名无法转变阵营的玩家在") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("转变");
    g_tipLine[5466] = StringToText("  为原来阵营之前死于处决，") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("将被锁定为他当前的阵营。");
    g_tipLine[5467] = StringToText("· ") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("死于处决，") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("只能在第二天无人死于处决的情况下从") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("的能力获得信");
    g_tipLine[5468] = StringToText("  息。在") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("被处决的下一个白天是") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("的“首个白天”，");
    g_tipLine[5469] = StringToText("  所以他必须在当天进行公开猜测，并且必须确保无人死于处决。以便") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("保持他的能力，");
    g_tipLine[5470] = StringToText("  在当晚得到猜测的结果。");
    g_tipLine[5471] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("的能力，你可以欺骗") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("是任何") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，包括") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("自以为的那个角色。");
    g_tipLine[5472] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的能力，你应该告诉") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("，他现在是剧本上的某个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5473] = StringToText("  并在") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的夜晚行动顺序时唤醒") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("进行攻击，之后唤醒") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("得知") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("玩家是") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("以及攻击目");
    g_tipLine[5474] = StringToText("  标。");
    g_tipLine[5475] = StringToText("· ") + TextWithColor(StringToText("畸形秀演员"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("拥有") + TextWithColor(StringToText("畸形秀演员"), Color(0, 191, 255)) + StringToText("能力，他可以声称自己是一个拥有") + TextWithColor(StringToText("畸形秀演员"), Color(0, 191, 255)) + StringToText("能力的") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5476] = StringToText("  并且不会被处决，因为他没有声称自己是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。然而，如果他声称自己是") + TextWithColor(StringToText("畸形秀演员"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5477] = StringToText("  他可能会被处决。");
    g_tipLine[5478] = StringToText("· ") + TextWithColor(StringToText("政客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得") + TextWithColor(StringToText("政客"), Color(0, 191, 255)) + StringToText("的能力，他将与已经死亡的") + TextWithColor(StringToText("政客"), Color(0, 191, 255)) + StringToText("发生竞争。");
    g_tipLine[5479] = StringToText("  因为只有一名玩家能够为自己阵营失败负最大责任，所以只有一名玩家可以转变阵营并获胜。");
    g_tipLine[5480] = StringToText("· ") + TextWithColor(StringToText("洗脑师"), Color(0, 191, 255)) + StringToText("：如果一名玩家被洗脑并对特定角色疯狂，他不能声称自己是拥有该角色能力的") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5481] = StringToText("  期望以此逃避违反洗脑疯狂的处决。因为他没有声称自己就是这个角色，这不符合疯狂的要求。");
    g_tipLine[5482] = StringToText("· ") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("沙巴洛斯"), Color(0, 191, 255)) + StringToText("：当") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("复活，他将获得最近死于处决的玩家能力。");
    g_tipLine[5483] = StringToText("· ") + TextWithColor(StringToText("呆瓜"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("月之子"), Color(0, 191, 255)) + StringToText("：参考") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的相克规则，如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("玩家在获得这些角色能力的时候死亡，");
    g_tipLine[5484] = StringToText("  且不知道自己是否获得了对应的能力的时候，说书人应该对他进行提醒。即使不进行提醒，");
    g_tipLine[5485] = StringToText("  也不应该算作是作弊。");
    g_tipLine[5486] = StringToText("· 相克规则：");
    g_tipLine[5487] = StringToText("· ") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("在自己的首个白天猜测后在当天死于处决，当晚") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("会替") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("得知对应的");
    g_tipLine[5488] = StringToText("  信息。");
    g_tipLine[5489] = StringToText("· ") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得了") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的能力，他会得知这一信息。");
    g_tipLine[5490] = StringToText("· ") + TextWithColor(StringToText("狂热者"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("获得了") + TextWithColor(StringToText("狂热者"), Color(0, 191, 255)) + StringToText("的能力，他会得知这一信息。");
    g_tipLine[5491] = StringToText("· 公主：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("提名并处决了公主且公主因此死亡，当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会造成死亡。");
    g_tipLine[5492] = StringToText("【角色能力】");
    g_tipLine[5493] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[5494] = StringToText("【角色简介】");
    g_tipLine[5495] = TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("能得知三名玩家中的一名是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[5496] = StringToText("· ") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("只会在第一个夜晚得知他的信息。");
    g_tipLine[5497] = StringToText("· 如果") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，他会在自己作为") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("时的第一个夜晚得知信息。");
    g_tipLine[5498] = StringToText("· ") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("得知的是两名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家和一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。他不会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家和两名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，");
    g_tipLine[5499] = StringToText("  也不会得知三名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5500] = StringToText("【规则细节】");
    g_tipLine[5501] = StringToText("· 特定角色互动：");
    g_tipLine[5502] = StringToText("· ") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("：就算在首夜因为自身能力就变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("，也不会被") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("当做") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家得知。");
    g_tipLine[5503] = StringToText("  因为") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("的首夜行动顺序在") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("之后，他在") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("在被唤醒时始终都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的。");
    g_tipLine[5504] = StringToText("· ") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("：可能在") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("醒来之前阵营发生交换，所以在") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("信息中需要展示新的阵营状态。");
    g_tipLine[5505] = StringToText("· ") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：在") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("醒来时，") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的阵营可能已经变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("，所以可以将") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("作为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家展示。注意，");
    g_tipLine[5506] = StringToText("  ") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("没有使用自身能力选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5507] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：可以被") + TextWithColor(StringToText("贵族"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("或") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("。");
    g_tipLine[5508] = StringToText("【角色能力】");
    g_tipLine[5509] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名存活的玩家：如果你选中了") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5510] = StringToText("  她会变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。[+") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[5511] = StringToText("【角色简介】");
    g_tipLine[5512] = TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("能够在") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("找到") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("之前拯救她……至少说希望如此。");
    g_tipLine[5513] = StringToText("· ") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("可以在") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("不在场时出现在游戏中。在游戏设置阶段，如果") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("在场而") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("不在场，");
    g_tipLine[5514] = StringToText("  那么") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("就会被添加进来并替换掉一个其他") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。而如果") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("已经在场，");
    g_tipLine[5515] = StringToText("  ") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("不会因此再将另外一名") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("添加进场。");
    g_tipLine[5516] = StringToText("· 如果") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("在夜晚时正确地选中了") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，那么") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("就会立即变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[5517] = StringToText("  由说书人来决定会变成哪一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，且") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("会得知自己变成了什么角色。");
    g_tipLine[5518] = StringToText("· 如果") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("变成了") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，她会获得那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("的能力并失去") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[5519] = StringToText("· ") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("只有一次猜测和选择的机会，并且会在夜晚进行。");
    g_tipLine[5520] = StringToText("· 在白天，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("们一共有一次公开猜测的机会。如果") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("猜对了谁是") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5521] = StringToText("  如果") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("猜错了谁是") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，其他") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("就不能通过猜对") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("是谁获胜了。");
    g_tipLine[5522] = StringToText("· 如果") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("在被") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("选择时") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，只要") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("清醒且健康，那么") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("就能够变成") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5523] = StringToText("【规则细节】");
    g_tipLine[5524] = StringToText("· ") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("被选中后角色变为不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，玩家的角色类型也会跟着改变，");
    g_tipLine[5525] = StringToText("  而不仅仅只是获得") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[5526] = StringToText("· 拥有") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("能力的其他角色被") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("选择，该玩家并不会变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[5527] = StringToText("· 特定角色互动：");
    g_tipLine[5528] = StringToText("· ") + TextWithColor(StringToText("气球驾驶员"), Color(0, 191, 255)) + StringToText("：如果时机合适，可以得知") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("两次——一次作为") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5529] = StringToText("  一次作为被") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("改变后的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5530] = StringToText("· ") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("让") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，然后") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("选中") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，他变为一个新的角色，");
    g_tipLine[5531] = StringToText("  这名原") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("玩家仍然会继续") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5532] = StringToText("· ") + TextWithColor(StringToText("教父"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("方古"), Color(0, 191, 255)) + StringToText("：如果被") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("选中的") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("玩家改变的角色后在白天死亡，") + TextWithColor(StringToText("教父"), Color(0, 191, 255)) + StringToText("无法在晚上被唤醒杀人；");
    g_tipLine[5533] = StringToText("  ") + TextWithColor(StringToText("方古"), Color(0, 191, 255)) + StringToText("不能转化到该玩家身上。该玩家不再是") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("，所以不再是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5534] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("不会是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("。不过，") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("可能是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5535] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：即使") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("是宿主，他仍然能被") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("改变，但仍然继续") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5536] = StringToText("· 咖啡师：如果受到咖啡师行动两次的效果影响，如果") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("还没进行选择，");
    g_tipLine[5537] = StringToText("  他可以在一晚内选择两名玩家；或者如果") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("已经在之前选择过一次，他会被唤醒并再次选择。");
    g_tipLine[5538] = StringToText("  如果") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("被选中，他仍然只会改变角色一次。");
    g_tipLine[5539] = StringToText("· 相克规则：");
    g_tipLine[5540] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("抽到了") + TextWithColor(StringToText("巡山人"), Color(0, 191, 255)) + StringToText("，在设置调整阶段会增加") + TextWithColor(StringToText("落难少女"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5541] = StringToText("【角色能力】");
    g_tipLine[5542] = StringToText("每局游戏限一次，在夜晚时，你可以选择让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("变成你选择的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色，或让所有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("变成你选择的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[5543] = StringToText("【角色简介】");
    g_tipLine[5544] = TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("能够决定镇子即将面临何种威胁。");
    g_tipLine[5545] = StringToText("· ") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("能够决定在场的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("种类，或在场的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("种类，但无法同时决定这两者。");
    g_tipLine[5546] = StringToText("· 当") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("创造新的角色时，原本的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家会仍然是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，原本的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家会仍然是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5547] = StringToText("  ") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的总数量不会因此发生改变。");
    g_tipLine[5548] = StringToText("· 如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("尝试创造一个已经在场的角色时，那个角色所属的玩家不会发生变化。");
    g_tipLine[5549] = StringToText("  ") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("不会得知这一消息，也不能再次使用自己的能力了。");
    g_tipLine[5550] = StringToText("· 如果要创造") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("需要根据本局游戏的玩家总数，选择等同于原本应该在场的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("数量的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[5551] = StringToText("  （参考旅行者列表或设置列表）");
    g_tipLine[5552] = StringToText("· 如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("无意中选择了数量不符的角色时，说书人应该以较为公平且可行的方式来改变一定数量的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0));
    g_tipLine[5553] = StringToText("  玩家的角色。");
    g_tipLine[5554] = StringToText("· ") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("只能选择来自于当前剧本列表中的角色。");
    g_tipLine[5555] = StringToText("【规则细节】");
    g_tipLine[5556] = StringToText("· 特定角色互动：");
    g_tipLine[5557] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("/") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("因为得知他们的新角色而被唤醒，不会被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("探查，");
    g_tipLine[5558] = StringToText("  除非他们因为自身获得的新能力醒来。");
    g_tipLine[5559] = StringToText("· ") + TextWithColor(StringToText("方古"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("选择的时候，场上有复数的相同角色") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5560] = StringToText("  这些相同角色的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家都会改变角色。");
    g_tipLine[5561] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("在场的时候，") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("选择其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，当前照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的玩家会变成那个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5562] = StringToText("  不管他之前是什么角色。如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("选择让") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("进入游戏，之前的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会变成一个不在场的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色并");
    g_tipLine[5563] = StringToText("  且正在照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5564] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("带入游戏，") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("不需要与") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("相邻。");
    g_tipLine[5565] = StringToText("  变为") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("的玩家不会被展示他是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("，而是改为展示“你是”，");
    g_tipLine[5566] = StringToText("  然后展示任何一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色标记。如果") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("变为其他") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，他将被展示“你是”，");
    g_tipLine[5567] = StringToText("  并且展示新的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色标记。");
    g_tipLine[5568] = StringToText("· 珀：如果一个没被唤醒的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("变为珀，珀在当晚不能三杀。");
    g_tipLine[5569] = StringToText("· ") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("已经被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("布道，然后被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("转变，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("得知他的角色改变但仍然会被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("影响，");
    g_tipLine[5570] = StringToText("  所以他的新角色仍然失去能力。");
    g_tipLine[5571] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：理论上可以被当作") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("/") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，然后被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("转变或者影响其他发生转变的角色……不要这样做，");
    g_tipLine[5572] = StringToText("  ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5573] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：可以不被当作") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，同时无视") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("的转换，保持他的能力。");
    g_tipLine[5574] = StringToText("· ") + TextWithColor(StringToText("亡骨魔"), Color(0, 191, 255)) + StringToText("：如果被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("变为其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，被") + TextWithColor(StringToText("亡骨魔"), Color(0, 191, 255)) + StringToText("杀死的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("失去能力，");
    g_tipLine[5575] = StringToText("  与这些") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("相邻的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("玩家会立即解除") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5576] = StringToText("· ") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：如果被") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("带入游戏，当晚一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家得知场上有") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5577] = StringToText("· ") + TextWithColor(StringToText("僵怖"), Color(0, 191, 255)) + StringToText("：如果把假死的") + TextWithColor(StringToText("僵怖"), Color(0, 191, 255)) + StringToText("变为其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他在城镇广场上将继续表现为死亡，");
    g_tipLine[5578] = StringToText("  但在其他所有情况下都当作存活。");
    g_tipLine[5579] = StringToText("· 相克规则：");
    g_tipLine[5580] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：如果存活的") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("从游戏中离场，说书人会获得") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5581] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("创造了") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("，所有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家会变成") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("。如果") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("在场，");
    g_tipLine[5582] = StringToText("  ") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("失去能力并改为得知这一信息。");
    g_tipLine[5583] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5584] = StringToText("· 梼杌：如果梼杌变成了其他") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，因为梼杌而失去能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会立即死亡。");
    g_tipLine[5585] = StringToText("【角色能力】");
    g_tipLine[5586] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipLine[5587] = StringToText("【角色简介】");
    g_tipLine[5588] = TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("知道其他人不知道的事情：接下来该做什么。");
    g_tipLine[5589] = StringToText("· ") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("自由选择什么时候使用他的能力。");
    g_tipLine[5590] = StringToText("· 当") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("拜访说书人时，说书人会给他一条建议。");
    g_tipLine[5591] = StringToText("· 说书人的建议不需要是事实。他是说书人觉得能帮助") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("获胜的策略指示，如果他这样做的话。");
    g_tipLine[5592] = StringToText("· 如果") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，说书人可以给") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("一条糟糕的建议。");
    g_tipLine[5593] = StringToText("【角色能力】");
    g_tipLine[5594] = StringToText("当你在夜晚死亡时，一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家会变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5595] = StringToText("【角色简介】");
    g_tipLine[5596] = TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("能够创造更多的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5597] = StringToText("· 如果一名") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("在夜晚死亡，会有另一名玩家变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5598] = StringToText("· 只有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家能够通过这种方式变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5599] = StringToText("· 如果这名新的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("也在夜晚死亡了，会再次有另一名") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("被创造出来。");
    g_tipLine[5600] = StringToText("· 在白天死亡的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，例如因处决而死亡，无法创造新的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5601] = StringToText("· 已经转为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，例如受到") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("的能力所影响，仍然可以创造新的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5602] = StringToText("  然而已经转为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("无法因为这种方式被变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5603] = StringToText("· ") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("们之间不会互相认识，但是每名变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("的玩家都会得知他现在是") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("了。");
    g_tipLine[5604] = StringToText("· 当一名玩家变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("后，他不再是原本的角色，也不再拥有那个角色的能力。");
    g_tipLine[5605] = StringToText("  所有与他原本能力相关的持续性效果都会立即终止。");
    g_tipLine[5606] = StringToText("【规则细节】");
    g_tipLine[5607] = StringToText("· 存活且") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的玩家才会因") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("的能力变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，所以在") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("行动顺序之前已经死亡的玩家或已经转变为");
    g_tipLine[5608] = StringToText("  ") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的玩家不会因") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("的能力变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5609] = StringToText("· 特定角色互动：");
    g_tipLine[5610] = StringToText("· ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("：如果获得") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("能力的玩家在夜晚死亡，他会让一个存活") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5611] = StringToText("  而不是变成他原本实际的角色。");
    g_tipLine[5612] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：当晚如果一名玩家仅被唤醒告知角色变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，他是因为之前") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("的能力被唤醒，");
    g_tipLine[5613] = StringToText("  所以不会被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("探查。然而，如果当晚该玩家在变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("之前因自身能力醒来，");
    g_tipLine[5614] = StringToText("  尽管他现在拥有的是不同的能力，") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("仍会探查。");
    g_tipLine[5615] = StringToText("· ") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("已经赌错并死亡，他不能在当晚的晚些时候变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，因为他已经死亡。");
    g_tipLine[5616] = StringToText("· ") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("：如果当晚") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("在行动顺序之前变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，没有玩家会因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("而死，");
    g_tipLine[5617] = StringToText("  因为") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("这个角色离场了。然而，") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("可以因为") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("的能力死亡后让") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("自己变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5618] = StringToText("· ") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("杀死") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，然后变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("能够造成死亡，");
    g_tipLine[5619] = StringToText("  因为场上不再有") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("能力阻止") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的杀戮。");
    g_tipLine[5620] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：玩家变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("并且不再能够使用他之前的能力，") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("不会检测。");
    g_tipLine[5621] = StringToText("· ") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("可以代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡，之后") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("也可以变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5622] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营无法互认。");
    g_tipLine[5623] = StringToText("· ") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：可以变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。先前的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("玩家没有使用自身能力选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，是说书人选择，");
    g_tipLine[5624] = StringToText("  所以") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("不会导致之前的") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5625] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：可以被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5626] = StringToText("· 旅行者：根据标准钟楼规则，旅行者不能改变角色，因此存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("旅行者无法变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5627] = StringToText("· 咖啡师：如果当晚因为咖啡师导致") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("能力生效两次，") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("的死亡会导致两名存活") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家变成") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5628] = StringToText("· 相克规则：");
    g_tipLine[5629] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：每个夜晚*，") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("要选择一名存活玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[5630] = StringToText("  他的能力生效但不会死亡。");
    g_tipLine[5631] = StringToText("· 暴乱：每个夜晚*，暴乱要选择一名存活玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("农夫"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[5632] = StringToText("  他的能力生效但不会死亡。");
    g_tipLine[5633] = StringToText("【角色能力】");
    g_tipLine[5634] = StringToText("说书人可以打破游戏规则，如果说书人被处决，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜，即使你已死亡。[无") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色在场]");
    g_tipLine[5635] = StringToText("【角色简介】");
    g_tipLine[5636] = TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("会知道所有玩家均为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("，不存在任何") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5637] = StringToText("· 如果") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("会在游戏中出场，那么这局游戏就不会有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家——没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，也没有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5638] = StringToText("· ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家会在说书人被处决时获胜。任何存活玩家都可以提名说书人，");
    g_tipLine[5639] = StringToText("  并且如果存活玩家数量一半或以上的玩家都参与投票，说书人就会被处决。（注：");
    g_tipLine[5640] = StringToText("  与常规的处决方式相同，所以仍然需要满足其他处决条件）");
    g_tipLine[5641] = StringToText("· 如果") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("不在场，但说书人被处决了，那么") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5642] = StringToText("· ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营会在仅剩两名玩家存活时落败。");
    g_tipLine[5643] = StringToText("· 说书人可以打破游戏中的任何规则。他可以在一名玩家提名时杀死该玩家来模拟") + TextWithColor(StringToText("女巫"), Color(0, 191, 255)) + StringToText("的诅咒，");
    g_tipLine[5644] = StringToText("  在夜晚杀死一名玩家来模拟") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的攻击，给出玩家错误的信息来模拟") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5645] = StringToText("  在夜晚改变玩家的角色来模拟") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("的能力，甚至设置不符合常规数量的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场。");
    g_tipLine[5646] = StringToText("【规则细节】");
    g_tipLine[5647] = StringToText("· 特定角色互动：");
    g_tipLine[5648] = StringToText("· ") + TextWithColor(StringToText("炸弹人"), Color(255, 69, 0)) + StringToText("：在") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("对局中，说书人有可能决定一名特定玩家将拥有") + TextWithColor(StringToText("炸弹人"), Color(255, 69, 0)) + StringToText("的能力，如果他被处决，");
    g_tipLine[5649] = StringToText("  将杀死除三名玩家外的所有玩家。如果你想这样做的话，你应该向玩家确认：");
    g_tipLine[5650] = StringToText("  如果他们认为这是") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("的对局，他们可以指向说书人，并且作为") + TextWithColor(StringToText("炸弹人"), Color(255, 69, 0)) + StringToText("能力的一部分，");
    g_tipLine[5651] = StringToText("  会导致说书人“被杀”，并让玩家赢得游戏。");
    g_tipLine[5652] = StringToText("· ") + TextWithColor(StringToText("侍臣"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("解谜大师"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("心上人"), Color(0, 191, 255)) + StringToText("：（通常来说）");
    g_tipLine[5653] = StringToText("  ") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("成功") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("将立即结束游戏，因为没有存活") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，并且说书人不能再通过打破规则来阻止游");
    g_tipLine[5654] = StringToText("  戏结束。建议打破规则来阻止这种事情的发生，因为这可能会导致一个不愉快的结局。");
    g_tipLine[5655] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：如果你让") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("在场，你需要将一个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色标记放入盲抽袋。然而，他只能是") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("而不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5656] = StringToText("  尽管他抽到的是红色标记。");
    g_tipLine[5657] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果你希望") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("，你将需要使用") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("设置规则的方法2（参考") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("页");
    g_tipLine[5658] = StringToText("  面），并且将") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("设置为") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("的邻座，以便让") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("成为") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5659] = StringToText("· ") + TextWithColor(StringToText("政客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("政客"), Color(0, 191, 255)) + StringToText("对他的阵营在") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("对局中落败负最大责任，他可以转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营并获胜。");
    g_tipLine[5660] = StringToText("· 相克规则：");
    g_tipLine[5661] = StringToText("· 暴乱：在暴乱的提名链中，如果说书人被提名，玩家要进行投票。如果说书人“即将被处决”，");
    g_tipLine[5662] = StringToText("  游戏结束；否则，说书人要重新发起提名。");
    g_tipLine[5663] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5664] = StringToText("· 戏子：戏子无法反转处决说书人导致的胜负结果。");
    g_tipLine[5665] = StringToText("· 戏子（改）：戏子（改）无法反转处决说书人导致的胜负结果，") + TextWithColor(StringToText("无神论者"), Color(0, 191, 255)) + StringToText("不会因为戏子（改）");
    g_tipLine[5666] = StringToText("  的能力") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5667] = StringToText("【角色能力】");
    g_tipLine[5668] = TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("互相不认识。如果你死亡，当晚他们会互相认识。");
    g_tipLine[5669] = StringToText("【角色简介】");
    g_tipLine[5670] = TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("能够阻止") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家互相认识。");
    g_tipLine[5671] = StringToText("· ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("仍然能够得知三个不在场的角色进行伪装。");
    g_tipLine[5672] = StringToText("· 如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会如同是首个夜晚一样互相认识。");
    g_tipLine[5673] = StringToText("· 如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在游戏中途") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，不会立即使得") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("互相认识。");
    g_tipLine[5674] = StringToText("  如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在死亡时") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，因为他此时没有任何能力，因此") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("也不会互相认识。");
    g_tipLine[5675] = StringToText("· ") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的旅行者在加入游戏时仍然能够得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5676] = StringToText("【规则细节】");
    g_tipLine[5677] = StringToText("· 拥有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色的玩家在") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡时相互认识，无论阵营和生/死状态。");
    g_tipLine[5678] = StringToText("· 将") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("变成另一个角色，或") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡时处于") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态，将不会导致") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("/") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("互认。");
    g_tipLine[5679] = StringToText("· 特定角色互动：");
    g_tipLine[5680] = StringToText("· 学徒：如果学徒是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，仍然会知道") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是谁。 学徒") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死或被流放后，");
    g_tipLine[5681] = StringToText("  导致") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营互相认识，因为流放也会导致死亡。");
    g_tipLine[5682] = StringToText("· ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("被处决并被") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("吃掉或已经被足够疯狂的") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("知晓，");
    g_tipLine[5683] = StringToText("  ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("将在") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡的同时获得的") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("能力并阻止") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("互认。");
    g_tipLine[5684] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("玩家不会知道其他") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("玩家是谁，但需要单独唤醒他们以提供他们的三个不在场角色。");
    g_tipLine[5685] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：剧本里同时有") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("时，可以向") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("假装有") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在场，从而在首夜不告诉") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5686] = StringToText("  他的“") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("”是谁。");
    g_tipLine[5687] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：首夜不会检测") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("没有互认，因为他们不是通过自身能力获得这些信息，");
    g_tipLine[5688] = StringToText("  而是通过他们的角色类型。 然而，") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会检测到") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在死亡时") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("/") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("并因此不允许") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/");
    g_tipLine[5689] = StringToText("  ") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("互认。");
    g_tipLine[5690] = StringToText("· ") + TextWithColor(StringToText("告密者"), Color(0, 191, 255)) + StringToText("：即使") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("也会被单独唤醒并被展示三个不在场角色。");
    g_tipLine[5691] = StringToText("· 相克规则：");
    g_tipLine[5692] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("拥有能力，") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("无法查看魔典。");
    g_tipLine[5693] = StringToText("· ") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("拥有能力，") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("无法查看魔典。");
    g_tipLine[5694] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("在第三个夜晚存活，由") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("来选择创造哪种") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[5695] = StringToText("  由说书人来决定哪名玩家发生转变。");
    g_tipLine[5696] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("都存活，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("们会依次单独被唤醒，");
    g_tipLine[5697] = StringToText("  直到其中一名玩家选择照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5698] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5699] = StringToText("· 鸩：如果鸩选择了") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("不会因为鸩的能力") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5700] = StringToText("· 孟婆：如果孟婆选中了") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("会得知自己被孟婆选中并死亡。");
    g_tipLine[5701] = StringToText("【角色能力】");
    g_tipLine[5702] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5703] = StringToText("每当你得知的玩家死亡，你会在当晚得知另一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。[会有一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营]");
    g_tipLine[5704] = StringToText("【角色简介】");
    g_tipLine[5705] = TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("会一个个地追踪") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5706] = StringToText("· 在") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("的首个夜晚，他会得知一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。当") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("得知的那名玩家死亡后，");
    g_tipLine[5707] = StringToText("  他会再得知另一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5708] = StringToText("· ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("只会得知一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，而不会得知他的具体角色。");
    g_tipLine[5709] = StringToText("· 如果") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("在应当得知新玩家的时候") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，说书人可以让") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[5710] = StringToText("  当这名玩家死亡后，") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("会在当晚得知一名新玩家。");
    g_tipLine[5711] = StringToText("· ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("不会重复得知同一个") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家两次。");
    g_tipLine[5712] = StringToText("· 如果") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("初始就加入了本局游戏，在设置调整阶段，会有一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("加入") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[5713] = StringToText("  ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("可以得知这名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家。");
    g_tipLine[5714] = StringToText("【规则细节】");
    g_tipLine[5715] = StringToText("· 请注意，") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("在首个夜晚的行动顺序非常靠后。那是唤醒") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5716] = StringToText("  向他展示他所得知的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的时机。然而，被") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("转变的玩家从一开始就已经属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，");
    g_tipLine[5717] = StringToText("  应该在首个夜晚立即告知他是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，并且你作为说书人应当在给出其他夜晚信息之前谨记这回事——那");
    g_tipLine[5718] = StringToText("  名玩家已经属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，尽管") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("还未被唤醒。");
    g_tipLine[5719] = StringToText("· 如果") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或处于") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("在场的游戏中，在他能够得到信息的时候，");
    g_tipLine[5720] = StringToText("  你可以（在") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("在场时必须）向他给出错误信息并展示一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。如果") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("在之后清醒，");
    g_tipLine[5721] = StringToText("  他不会因此得知新的信息，即使他仍然认为那名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。当") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("得知的玩家死亡，");
    g_tipLine[5722] = StringToText("  他在当晚得知一名新的玩家。");
    g_tipLine[5723] = StringToText("· 如果“被得知”的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家在之后转变为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("，这不会影响") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[5724] = StringToText("  ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("为了获得进一步信息仍然需要那名玩家死亡。");
    g_tipLine[5725] = StringToText("· 值得注意的是，如果你觉得") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("已经获得过很多信息了，可以向他指出一名死亡的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5726] = StringToText("  死亡玩家不能再次死亡，所以") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("不会获得新的信息，除非那名玩家被复活并再次被杀死。");
    g_tipLine[5727] = StringToText("· 对于旅行者，离开游戏和被流放都会导致他死亡——所以如果") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("此前得知了一名旅行者，");
    g_tipLine[5728] = StringToText("  上述两种情况都会使得") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("在当晚获得新的信息。");
    g_tipLine[5729] = StringToText("· 相克规则：");
    g_tipLine[5730] = StringToText("· ") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("获得了") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("的能力，可能会有一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[5731] = StringToText("· ") + TextWithColor(StringToText("卡扎力"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("卡扎力"), Color(255, 0, 0)) + StringToText("把") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("变成了") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("不会带来") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5732] = StringToText("【角色能力】");
    g_tipLine[5733] = StringToText("在你的首个夜晚，你会得知一个在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。如果你“疯狂”地证明你是该角色，");
    g_tipLine[5734] = StringToText("  当他死亡时你获得该角色的能力。");
    g_tipLine[5735] = StringToText("【角色简介】");
    g_tipLine[5736] = TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("会假装成与别人相同的角色。");
    g_tipLine[5737] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("会得知一个在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。由说书人来决定他得知的是哪个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[5738] = StringToText("  ") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("不会知道哪名玩家是这个角色。");
    g_tipLine[5739] = StringToText("· 如果") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("假装他是这个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他会在对应的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家死亡时获得这个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色的能力。");
    g_tipLine[5740] = StringToText("  他可以只在某天里声称自己是这个角色，也可以每天都假装自己是这个角色，");
    g_tipLine[5741] = StringToText("  或者指责那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家说他是骗子——由说书人来判断") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("是否有尝试在“疯狂”地证明自己是这个角");
    g_tipLine[5742] = StringToText("  色。");
    g_tipLine[5743] = StringToText("· 当那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家死亡时，") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("不会得知这一信息，也不会被告知自己获得了新的能力。");
    g_tipLine[5744] = StringToText("  他可能会由于自己在夜晚被唤醒并获得信息或是被要求选择玩家，从而间接得知自己获得了能力。");
    g_tipLine[5745] = StringToText("· 如果") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("得知的角色所对应的玩家他的角色发生了变化，并随后死亡，");
    g_tipLine[5746] = StringToText("  ") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("会获得他得知的那个角色的能力，而非那名玩家死亡时的角色的能力。");
    g_tipLine[5747] = StringToText("【规则细节】");
    g_tipLine[5748] = StringToText("· 如果") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("在得知信息时，因为") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("等原因导致得知了错误信息时，");
    g_tipLine[5749] = StringToText("  仍然会正常将他的“疯狂”标记放置在一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家的角色标记旁。只要") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("在那名玩家死亡时清醒健");
    g_tipLine[5750] = StringToText("  康，且说书人判断他足够疯狂，便能获得他所得知的那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色的能力（不一定是标记了“疯狂”的那");
    g_tipLine[5751] = StringToText("  名玩家的角色能力，") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("可以以此获得一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色能力）。");
    g_tipLine[5752] = StringToText("【角色能力】");
    g_tipLine[5753] = StringToText("你拥有一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色的能力。当你使用能力时，说书人可能会要求你更换选择。");
    g_tipLine[5754] = StringToText("【角色简介】");
    g_tipLine[5755] = TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("具有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5756] = StringToText("· ") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("通常会获得一个不在场") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力，但可以获得一个在场") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5757] = StringToText("· ") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("会在自己的首个夜晚得知自己获得了哪一项") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5758] = StringToText("· ") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("仍然是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。他会在") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜时一同获胜，也会在") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营落败时一同落败。");
    g_tipLine[5759] = StringToText("  他被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5760] = StringToText("· 不同于一般的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("不会被唤醒以得知其他") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("以及") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("分别是哪些玩家。");
    g_tipLine[5761] = StringToText("· 如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("获得的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力会导致在设置阶段添加或移除角色，这一能力也会在设置阶段生效。");
    g_tipLine[5762] = StringToText("· 如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("获得了一个可以选择的能力，比如") + TextWithColor(StringToText("投毒者"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("，说书人可以让") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("换个选择，");
    g_tipLine[5763] = StringToText("  ") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("就必须更换自己的选择。");
    g_tipLine[5764] = StringToText("【规则细节】");
    g_tipLine[5765] = StringToText("· 特定角色互动：");
    g_tipLine[5766] = StringToText("· 学徒：") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("学徒可以获得") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("的能力，进而获得一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5767] = StringToText("· ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("可以让") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("，让") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力回归") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[5768] = StringToText("· ") + TextWithColor(StringToText("洗脑师"), Color(0, 191, 255)) + StringToText("：无论") + TextWithColor(StringToText("洗脑师"), Color(0, 191, 255)) + StringToText("或炼金") + TextWithColor(StringToText("洗脑师"), Color(0, 191, 255)) + StringToText("，告知目标玩家“疯狂”的流程都一样，");
    g_tipLine[5769] = StringToText("  对该玩家展示") + TextWithColor(StringToText("洗脑师"), Color(0, 191, 255)) + StringToText("角色标记和需要“疯狂”的角色标记。");
    g_tipLine[5770] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("会在第一夜被唤醒得知他获得了什么") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力，之后是否被唤醒取决于他获得的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力。");
    g_tipLine[5771] = StringToText("· ") + TextWithColor(StringToText("镜像双子"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("获得") + TextWithColor(StringToText("镜像双子"), Color(0, 191, 255)) + StringToText("能力，则将一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家设置为他的“对立双子”。");
    g_tipLine[5772] = StringToText("  如果这名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的炼金双子被处决，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[5773] = StringToText("· ") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("：获得") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("能力的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("在夜晚触发的公开宣布与") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("相同：");
    g_tipLine[5774] = StringToText("  “") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("选择了一名玩家”。");
    g_tipLine[5775] = StringToText("· ") + TextWithColor(StringToText("哥布林"), Color(255, 69, 0)) + StringToText("：炼金") + TextWithColor(StringToText("哥布林"), Color(255, 69, 0)) + StringToText("触发") + TextWithColor(StringToText("哥布林"), Color(255, 69, 0)) + StringToText("能力需要声明自己是") + TextWithColor(StringToText("哥布林"), Color(255, 69, 0)) + StringToText("，而不是炼金") + TextWithColor(StringToText("哥布林"), Color(255, 69, 0)) + StringToText("。实际上，");
    g_tipLine[5776] = StringToText("  如果不允许将这两种情况当作同样处理，也太过于为难玩家了。");
    g_tipLine[5777] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("无法获得") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("的能力。");
    g_tipLine[5778] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("不是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，所以不会在为秘密决定由哪名玩家照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("时醒来。");
    g_tipLine[5779] = StringToText("· ") + TextWithColor(StringToText("精神病患者"), Color(255, 69, 0)) + StringToText("：当炼金") + TextWithColor(StringToText("精神病患者"), Color(255, 69, 0)) + StringToText("发动能力选择一名玩家时，说书人可以公开要求他重新选择一名玩家，");
    g_tipLine[5780] = StringToText("  他必须更换选择。（说书人也可以要求") + TextWithColor(StringToText("精神病患者"), Color(255, 69, 0)) + StringToText("重新选择一名玩家，他可以不更换选择）");
    g_tipLine[5781] = StringToText("· 相克规则：");
    g_tipLine[5782] = StringToText("· ") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("一定在场。每次处决后，");
    g_tipLine[5783] = StringToText("  存活的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：如果猜对了，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5784] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("一定在场。每次处决后，");
    g_tipLine[5785] = StringToText("  存活的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：如果猜对了，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5786] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：获得") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("能力的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("不会获得伪装。他要选择一个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色，但不选择玩家，");
    g_tipLine[5787] = StringToText("  由说书人决定哪一名玩家变成") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果他在选择之前死亡，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。[无") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("在场]");
    g_tipLine[5788] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("拥有") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("的能力，") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("不会得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("因此获得了哪个角色的能力。");
    g_tipLine[5789] = StringToText("· 亡魂：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得亡魂的能力，那么他不会拥有该能力并改为亡魂一定在场。每次处决后，");
    g_tipLine[5790] = StringToText("  存活的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是亡魂：如果猜对了，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择亡魂。");
    g_tipLine[5791] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("一定在场。");
    g_tipLine[5792] = StringToText("· ") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("一定不在场。");
    g_tipLine[5793] = StringToText("· ") + TextWithColor(StringToText("街头风琴手"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("获得") + TextWithColor(StringToText("街头风琴手"), Color(255, 69, 0)) + StringToText("的能力，") + TextWithColor(StringToText("街头风琴手"), Color(255, 69, 0)) + StringToText("一定在场。");
    g_tipLine[5794] = StringToText("  如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("街头风琴手"), Color(255, 69, 0)) + StringToText("都是清醒的，改为他们都") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5795] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5796] = StringToText("· ") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("本应获得") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("的能力，那么他不会拥有该能力并改为") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("一定在场。每次处决后，");
    g_tipLine[5797] = StringToText("  存活的") + TextWithColor(StringToText("炼金术士"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("：如果猜对了，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[5798] = StringToText("【角色能力】");
    g_tipLine[5799] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("/") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("/均势）。");
    g_tipLine[5800] = StringToText("【角色简介】");
    g_tipLine[5801] = TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("清楚哪个阵营更具有优势。");
    g_tipLine[5802] = StringToText("· 如果") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更具优势，说书人会给出大拇指朝上的手势。如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营更具优势，");
    g_tipLine[5803] = StringToText("  说书人会给出大拇指朝下的手势。如果双方阵营势均力敌，或说书人并不确信哪一方更具优势，");
    g_tipLine[5804] = StringToText("  说书人会给出大拇指水平指向一侧的手势。");
    g_tipLine[5805] = StringToText("· 说书人需要对阵营的优势做出判断。很多因素都会作为考量，例如每个阵营有多少存活的玩家，");
    g_tipLine[5806] = StringToText("  ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获取的信息程度如何，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的伪装的取信程度如何，玩家们即将打算处决谁，");
    g_tipLine[5807] = StringToText("  或是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家的游戏经验是否丰富。上述所有内容以及一些其他因素都会影响说书人的判断。");
    g_tipLine[5808] = StringToText("· 说书人判断的是") + TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("被唤醒的那一刻更具有优势的阵营。当晚较早时段里发生的事情也可能会影响判断。");
    g_tipLine[5809] = StringToText("【角色能力】");
    g_tipLine[5810] = StringToText("每个夜晚，你要选择一名玩家：如果你选中了") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，他会得知被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中。");
    g_tipLine[5811] = StringToText("所有被你选中的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("失去能力。");
    g_tipLine[5812] = StringToText("【角色简介】");
    g_tipLine[5813] = TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("会净化") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[5814] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选择了一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会被唤醒得知他被布道了，并且他在") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("存活清醒健康的时候无法行");
    g_tipLine[5815] = StringToText("  动。");
    g_tipLine[5816] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选择了不是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的玩家，无事发生。");
    g_tipLine[5817] = StringToText("· ") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("可以选择死亡玩家。");
    g_tipLine[5818] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("在") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的时候选择了一名玩家，那名玩家不会被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipLine[5819] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，被布道的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会重新获得能力，直到") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("恢复清醒健康。");
    g_tipLine[5820] = StringToText("【规则细节】");
    g_tipLine[5821] = StringToText("· 关于") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("的“失去能力”与其他角色的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果会有所不同，暂且作为“特例”进行处理。");
    g_tipLine[5822] = StringToText("  如果想要了解与其他情况下失去能力的效果的详细差别，请参考这里。");
    g_tipLine[5823] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("死亡，这些") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("恢复能力。已经使用了“每局游戏限一次”的能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("无法再次使用能力。");
    g_tipLine[5824] = StringToText("  受") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("影响的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("不会被告知") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("已经死亡，但他们可能会在再次被唤醒时意识到这一点。");
    g_tipLine[5825] = StringToText("· 如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，因") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("失去能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("恢复能力，但会在") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("恢复健康清醒后再次失去能力。");
    g_tipLine[5826] = StringToText("· 如果被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在之后变成其他角色类型的角色(也就是不再是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText(")，");
    g_tipLine[5827] = StringToText("  那么他不再受到") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("能力的影响。此外，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家不会仅仅因为属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营就受到") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("能力的影响，");
    g_tipLine[5828] = StringToText("  他需要明确地作为") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色才能受到影响。");
    g_tipLine[5829] = StringToText("· 同理，一名后来变成") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的非") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("玩家不会因为在变成") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("之前被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选择而受到其能力影响。");
    g_tipLine[5830] = StringToText("  如果他在变成") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("后被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中，") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("能力正常生效。");
    g_tipLine[5831] = StringToText("· 如果因") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("而失去能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在死亡后复活，他不会恢复能力，只要") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("仍然存活，");
    g_tipLine[5832] = StringToText("  他仍然失去能力。");
    g_tipLine[5833] = StringToText("· 特定角色互动：");
    g_tipLine[5834] = StringToText("· 咖啡师：被布道的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("获得咖啡师能力1不会恢复能力。");
    g_tipLine[5835] = StringToText("· ") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("工程师"), Color(0, 191, 255)) + StringToText("做出行动，被布道的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会被告知他的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色发生改变，");
    g_tipLine[5836] = StringToText("  但他会继续受到") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("影响，并且不会恢复能力。");
    g_tipLine[5837] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：正在持有") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("角色标记的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中，会失去他的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力，");
    g_tipLine[5838] = StringToText("  但保留") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力。");
    g_tipLine[5839] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：那些原本该醒来或使用能力的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，因为被布道而无法这样做时，");
    g_tipLine[5840] = StringToText("  会被") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("当作是他的能力未正常生效。");
    g_tipLine[5841] = StringToText("· ") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("在首个夜晚被布道，他不会得知关键词。然而，如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("死亡或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5842] = StringToText("  ") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("会在那个时候得知他的关键词。如果") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("在其他夜晚被布道，");
    g_tipLine[5843] = StringToText("  在这之后说出关键词的玩家不会转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("但仍然消耗") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("的能力，");
    g_tipLine[5844] = StringToText("  同样的情况适用于如果玩家在白天说出关键词，接着") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("在夜晚被布道。");
    g_tipLine[5845] = StringToText("  玩家不能在") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("得知关键词之前说出关键词，在") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("被告知关键词之前，关键词实际上并不存在，");
    g_tipLine[5846] = StringToText("  所以提前使用相关词语不算作") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("能力的一次使用，既没有消耗能力，也没有让玩家转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[5847] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("可以被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("当作是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，并得知被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中。通常来说你应该避免这样做——请注意，");
    g_tipLine[5848] = StringToText("  如果你这样做，") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("仍然保留能力——如果") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("失去能力，他会停止被当作") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，");
    g_tipLine[5849] = StringToText("  这意味着“布道”提示标记应该被移除并且因此") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("不再被布道，所以") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("重新恢复能力。");
    g_tipLine[5850] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("可以在被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中时被当作非") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，并且避免受到") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("能力影响。");
    g_tipLine[5851] = StringToText("· ") + TextWithColor(StringToText("亡骨魔"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("可以选中在") + TextWithColor(StringToText("亡骨魔"), Color(0, 191, 255)) + StringToText("的保留能力效果下的死亡") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。在这种情况下，");
    g_tipLine[5852] = StringToText("  ") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("的能力会更胜一筹，意味着") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会像被正常选中那样失去能力。在此之后，如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("死亡，");
    g_tipLine[5853] = StringToText("  受到影响的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("将恢复能力。");
    g_tipLine[5854] = StringToText("· ") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("在首个夜晚被") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中，那么他不能查看魔典并选择一名玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5855] = StringToText("  也不会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家知道") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("在场。然而，如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("死亡或") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[5856] = StringToText("  ") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("会在那个时候查看魔典并选择一名玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，随后会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家知道") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("在场。");
    g_tipLine[5857] = StringToText("· 相克规则：");
    g_tipLine[5858] = StringToText("· ") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[5859] = StringToText("· ") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("：如果存活的") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("失去能力，说书人会获得") + TextWithColor(StringToText("召唤师"), Color(255, 69, 0)) + StringToText("能力。");
    g_tipLine[5860] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("仍然保留能力，但") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("可能会得知自己选中了") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5861] = StringToText("【角色能力】");
    g_tipLine[5862] = StringToText("每个夜晚，如果死亡的玩家数量大于或等于存活的玩家数量，你会得知一个存活的角色。");
    g_tipLine[5863] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("知道你是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5864] = StringToText("【角色简介】");
    g_tipLine[5865] = TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("能得知仍然存活的角色。");
    g_tipLine[5866] = StringToText("· ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("会在游戏的数个夜晚之后获得能力——只要死亡玩家的数量大于或等于存活玩家的数量。");
    g_tipLine[5867] = StringToText("· 在游戏开始时的第一个夜晚，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会得知谁是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，");
    g_tipLine[5868] = StringToText("  ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会在当晚得知谁是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5869] = StringToText("· ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("未必能幸存到能够使用自己的能力。然而一旦死亡玩家的数量大于或等于存活玩家的数量，");
    g_tipLine[5870] = StringToText("  ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("就能在此后的每个夜晚得知一个存活角色。");
    g_tipLine[5871] = StringToText("· ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("既有可能得知") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色，也有可能得知") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，甚至还有可能多次得知同一个角色。");
    g_tipLine[5872] = StringToText("· ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("并非一定在场。但如果") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("在场，且在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("时仍然存活，");
    g_tipLine[5873] = StringToText("  ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("就能够得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5874] = StringToText("【规则细节】");
    g_tipLine[5875] = StringToText("· 特定角色互动：");
    g_tipLine[5876] = StringToText("· ") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("在场时") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("死于处决，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会在当晚被唤醒并告知这名") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("玩家是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5877] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：直到死亡的玩家数量大于或等于存活的玩家数量，") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("才会被唤醒，因此在此之前，");
    g_tipLine[5878] = StringToText("  ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("不会探查到") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，然后从") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("被唤醒开始，才会被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("的探查。");
    g_tipLine[5879] = StringToText("· ") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("：其获得能力当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("应该被展示") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("的角色标记，而不是") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5880] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("不会干扰") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("知道谁是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5881] = StringToText("· ") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("沙巴洛斯"), Color(0, 191, 255)) + StringToText("/集骨者：复活/反刍/重获能力角色选择") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("将导致") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("再次被告知") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("是谁。");
    g_tipLine[5882] = StringToText("· ") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("理发师"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("红唇女郎"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("方古"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("更换了玩家，");
    g_tipLine[5883] = StringToText("  此时") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("仍存活且清醒和健康，新的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家会知道") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("是谁。");
    g_tipLine[5884] = StringToText("· ") + TextWithColor(StringToText("理发师"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("被交换到另外一名玩家，或者被重新创造，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会被告知新") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("玩家。");
    g_tipLine[5885] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("被选为") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会被告知哪名玩家是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5886] = StringToText("· ") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("没有使用自己的能力主动选择") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("，所以") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("时不会因为") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的能力而") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5887] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("可以被告知") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("在场，无论正确与否。");
    g_tipLine[5888] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：理论上你可以向") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("展示") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("是谁，但这并不有趣。");
    g_tipLine[5889] = StringToText("· ") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会被告知除该") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("玩家以外的任意玩家是") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("得知错误信息：");
    g_tipLine[5890] = StringToText("  不在场或者已经死亡的角色。");
    g_tipLine[5891] = StringToText("· ") + TextWithColor(StringToText("僵怖"), Color(0, 191, 255)) + StringToText("：假死的") + TextWithColor(StringToText("僵怖"), Color(0, 191, 255)) + StringToText("在") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("“死亡玩家数量大于或等于存活玩家数量”的能力里，被算作死亡。");
    g_tipLine[5892] = StringToText("· 学徒：如果获得") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("能力，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会被告知。");
    g_tipLine[5893] = StringToText("· 咖啡师：只有当死亡玩家数量大于或等于存活玩家数量时，其才会在") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("获得信息时产生效果。1）");
    g_tipLine[5894] = StringToText("  ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("获得正确信息，2）") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("得知两个角色标记。");
    g_tipLine[5895] = StringToText("· 相克规则：");
    g_tipLine[5896] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("在场，当至少一名玩家死亡时，") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("每晚就会得知一个存活的角色。");
    g_tipLine[5897] = StringToText("· 暴乱：如果暴乱在场，当至少一名玩家死亡时，") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("每晚就会得知一个存活的角色。");
    g_tipLine[5898] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5899] = StringToText("· 戏子（改）：") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("不会因为戏子（改）的能力") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5900] = StringToText("【角色能力】");
    g_tipLine[5901] = StringToText("每个夜晚，你要选择一名玩家：你会得知他的阵营。[+0~2") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("，复数") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("中有一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("]");
    g_tipLine[5902] = StringToText("【角色简介】");
    g_tipLine[5903] = TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("结伴而行，他们能得知玩家的阵营。");
    g_tipLine[5904] = StringToText("· 由说书人在进行游戏设置时决定哪一名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5905] = StringToText("· 在场") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的数量可能是1、2或3，这与一局游戏的玩家人数无关。");
    g_tipLine[5906] = StringToText("· 如果在场") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的数量为1，他会是清醒的。");
    g_tipLine[5907] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("仍然可能会得知正确信息。");
    g_tipLine[5908] = StringToText("· 在游戏设置时如果添加了额外的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("，他们会替换其他的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色标记。");
    g_tipLine[5909] = StringToText("· 如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在游戏过程中被创造，只有被创造的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("会发生角色变化。不会有其他玩家因此变成") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5910] = StringToText("· 多名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在夜晚会分别独自行动，而不是一同被唤醒。");
    g_tipLine[5911] = StringToText("· 如果所有清醒的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("都离场，剩余的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("仍然保持") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态。");
    g_tipLine[5912] = StringToText("· 如果一名清醒的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("因为其他效果") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("仍然保持") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态。");
    g_tipLine[5913] = StringToText("【规则细节】");
    g_tipLine[5914] = StringToText("· “复数") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("中有一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("”这一项能力既是设置调整能力（需要在为首夜准备时进行调整），");
    g_tipLine[5915] = StringToText("  又是持续检测型能力。在游戏过程中，只要") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量超过1人，");
    g_tipLine[5916] = StringToText("  且") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("提示标记尚未被放置，就需要立即放置该标记。");
    g_tipLine[5917] = StringToText("· 只要") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场，即使") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量不足3人，说书人都无法将") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("作为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的伪装提供给") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5918] = StringToText("  然而如果有") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("以为自己是") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("，将") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("作为伪装提供给") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不算是“YBD”。");
    g_tipLine[5919] = StringToText("· 根据角色标记的实物限制原则，当") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("数量为3人时，不建议再为学徒等角色提供") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的角色能力。");
    g_tipLine[5920] = StringToText("  同时，如果有任何") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场，也不建议让") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("认为自己是") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[5921] = StringToText("· ") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("、学徒等角色的获得能力效果，不会参与到“") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量”的计算之中。也就是说，");
    g_tipLine[5922] = StringToText("  如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量为1人，那么即使有其他具有") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("能力的角色，这些角色包括") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在内就都不会因为");
    g_tipLine[5923] = StringToText("  ") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的能力而") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。（在统计相克规则中的在场数量时，仍然会参与计算，");
    g_tipLine[5924] = StringToText("  这是由于受到角色标记的实物数量限制导致的。）");
    g_tipLine[5925] = StringToText("· 特定角色互动：");
    g_tipLine[5926] = StringToText("· ") + TextWithColor(StringToText("卡扎力"), Color(255, 0, 0)) + StringToText("：如果有复数个") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("卡扎力"), Color(255, 0, 0)) + StringToText("的设置调整优先生效，其他的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("因") + TextWithColor(StringToText("卡扎力"), Color(255, 0, 0)) + StringToText("的能力变成了") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，");
    g_tipLine[5927] = StringToText("  剩下的那名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("一定是清醒的，因为这时") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("已经只有一个了。");
    g_tipLine[5928] = StringToText("· 相克规则：");
    g_tipLine[5929] = StringToText("· ") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("可以创造新的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。如果她这么做，");
    g_tipLine[5930] = StringToText("  ") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("效果可能会更换目标。");
    g_tipLine[5931] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("可以让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("拥有") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[5932] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[5933] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("可以变成新的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。如果因此使得") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量超过1人，");
    g_tipLine[5934] = StringToText("  会有一名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5935] = StringToText("【角色能力】");
    g_tipLine[5936] = StringToText("每个夜晚，你会转变为与你邻近的一名存活的玩家的阵营。");
    g_tipLine[5937] = StringToText("每个白天，你可以提议所有玩家加入你的教派，如果所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家同意加入，你的阵营获胜。");
    g_tipLine[5938] = StringToText("【角色简介】");
    g_tipLine[5939] = TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("会在所有人加入他的教派时获胜。");
    g_tipLine[5940] = StringToText("· 在每个夜晚结束时，") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("会转变为一名邻近存活玩家的阵营。");
    g_tipLine[5941] = StringToText("· 每个白天限一次，") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("可以公开创立一个教派。如果所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家投票加入教派，游戏立刻结束，");
    g_tipLine[5942] = StringToText("  ") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("的阵营获胜。");
    g_tipLine[5943] = StringToText("· ") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("可以在一天的任何时候创立教派。");
    g_tipLine[5944] = StringToText("· 投票加入教派不需要消耗投票标记。");
    g_tipLine[5945] = StringToText("· 玩家可以在任何时候说任何事情，所以当玩家要伪装") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("的时候，他可以假装要创立一个教派。");
    g_tipLine[5946] = StringToText("【规则细节】");
    g_tipLine[5947] = StringToText("· 相克规则：");
    g_tipLine[5948] = StringToText("· ") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("：被") + TextWithColor(StringToText("麻脸巫婆"), Color(0, 191, 255)) + StringToText("创造的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("无法因为自身能力转变为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。");
    g_tipLine[5949] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("拥有") + TextWithColor(StringToText("异教领袖"), Color(0, 191, 255)) + StringToText("的能力，他无法因为该能力转变为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。");
    g_tipLine[5950] = StringToText("【角色能力】");
    g_tipLine[5951] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，他死亡，并且当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会造成死亡。");
    g_tipLine[5952] = StringToText("会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[5953] = StringToText("【角色简介】");
    g_tipLine[5954] = TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("会在夜晚游荡，猎杀无辜，与此同时") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("在自己的老巢里蛰伏。");
    g_tipLine[5955] = StringToText("· ") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("必须在每个夜晚选择一名存活的玩家。如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择了已死亡的玩家，");
    g_tipLine[5956] = StringToText("  说书人会摇头并让") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("重新选择。");
    g_tipLine[5957] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，那名玩家死亡，并且当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不能造成死亡。");
    g_tipLine[5958] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，那名玩家不会死亡，并且") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以造成死亡。");
    g_tipLine[5959] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的玩家但没有导致那名玩家死亡，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以造成死亡。");
    g_tipLine[5960] = StringToText("· ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与造成死亡无关的能力仍然会正常运作，不会受到") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipLine[5961] = StringToText("· 一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。他同样也被") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，因此") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("无法杀死这名玩家。");
    g_tipLine[5962] = StringToText("【角色能力】");
    g_tipLine[5963] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，你会得知哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。[+") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[5964] = StringToText("【角色简介】");
    g_tipLine[5965] = TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("会在") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("被戕害时得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[5966] = StringToText("· ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("可以在") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不在场时出现在游戏中。在游戏设置阶段，如果") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("在场而") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("不在场，");
    g_tipLine[5967] = StringToText("  那么") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("就会被添加进来并替换掉一个其他") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。而如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("已经在场，");
    g_tipLine[5968] = StringToText("  ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不会因此再将另外一名") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("添加进场。");
    g_tipLine[5969] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("使用自己的能力杀死了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("会得知哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名并处决") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("时，");
    g_tipLine[5970] = StringToText("  不算做使用自己的能力杀死") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("使用能力杀死") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，例如") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("，也不会计算在内。");
    g_tipLine[5971] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("但未能将其杀死，") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不会得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是谁。");
    g_tipLine[5972] = StringToText("· ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("得知的是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的具体玩家，但不得知具体角色。");
    g_tipLine[5973] = StringToText("【角色能力】");
    g_tipLine[5974] = StringToText("在你的首个夜晚，你会得知距离最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家位于你的顺时针还是逆时针方向。");
    g_tipLine[5975] = StringToText("  如果两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与你距离相等，你得知的信息由说书人决定。");
    g_tipLine[5976] = StringToText("【角色简介】");
    g_tipLine[5977] = TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("会倾向于信任位于他某一侧的玩家。");
    g_tipLine[5978] = StringToText("· 距离最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，就是与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间坐着的玩家数量最少的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[5979] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("顺时针方向上最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间的玩家数量，等同于") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("逆时针方向上最近的");
    g_tipLine[5980] = StringToText("  ") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间的玩家数量，那么就是“") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与他的距离相等”。");
    g_tipLine[5981] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与他的距离相等，由说书人来决定向") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("给出什么样的信息。");
    g_tipLine[5982] = StringToText("  说书人可以决定") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("会得知的信息是顺时针还是逆时针。");
    g_tipLine[5983] = StringToText("· ") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("不会知道他所得知的信息是真实结果，还是由说书人决定的结果。");
    g_tipLine[5984] = StringToText("· ") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("不会得知他与最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家之间的具体距离。");
    g_tipLine[5985] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，那么他会在当晚被唤醒并获得信息。");
    g_tipLine[5986] = StringToText("· 说书人与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("关于信息的交流方式可以是用手指指向与他信息相符的方向，");
    g_tipLine[5987] = StringToText("  或是其他提前商定一致的信息方式。");
    g_tipLine[5988] = StringToText("【角色能力】");
    g_tipLine[5989] = StringToText("在你的首个夜晚，你会得知两名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。他们之中会有一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使你已死亡。");
    g_tipLine[5990] = StringToText("【角色简介】");
    g_tipLine[5991] = TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("对他店里的顾客非常熟悉，但也为某些酒量不高的顾客感到焦虑。");
    g_tipLine[5992] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("会得知两名玩家，这两名玩家都属于") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。");
    g_tipLine[5993] = StringToText("· ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("所得知的两名玩家之中，会有一名玩家始终") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("已经死亡。");
    g_tipLine[5994] = StringToText("· 如果") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，他会在当晚得知两名玩家，且他得知的这两名玩家之中会有一名玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5995] = StringToText("· 如果已经死亡的玩家变成了") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("，他不会得知任何信息，但仍然会让一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[5996] = StringToText("【规则细节】");
    g_tipLine[5997] = StringToText("· 如果") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("因为其他角色的能力") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，或受到") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("效果影响，使得") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("得知了错误信息，");
    g_tipLine[5998] = StringToText("  ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("仍然会让他所得知的两名玩家之中的一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("（如果是") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("导致的错误信息则需要");
    g_tipLine[5999] = StringToText("  ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("恢复健康清醒后）。这可能会因此导致") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。然而，如果他得知的玩家中存在") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，");
    g_tipLine[6000] = StringToText("  说书人都应该倾向于让") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6001] = StringToText("· 在") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("后，他所得知的玩家可能会发生变化。为了避免他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的目标进行改变，");
    g_tipLine[6002] = StringToText("  说书人应该只调整") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("所得知的消息中，没有") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的那一名玩家。");
    g_tipLine[6003] = StringToText("【角色能力】");
    g_tipLine[6004] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[6005] = StringToText("【角色简介】");
    g_tipLine[6006] = TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("精通望闻问切，能够通过他人的面相进行初步的推测。");
    g_tipLine[6007] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("都需要选择一名除自己以外的玩家。他会得知一个与该玩家能力相关的词语。");
    g_tipLine[6008] = StringToText("  说书人会将词语写在纸上，或通过能够记录词语的电子设备，向") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("提供这个词语信息。");
    g_tipLine[6009] = StringToText("  （就像") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("得知关键词一样。）");
    g_tipLine[6010] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("得知的词语可能来自于那个玩家角色能力描述中的某个词，如“夜晚”、“死亡”、“公开”等；");
    g_tipLine[6011] = StringToText("  也可以是说书人对该玩家能力的某种概括性描述，如“勇敢”、“牺牲”等。");
    g_tipLine[6012] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("每次只会得知一个词语。通常来说这是一个2-4字的词语（或是一个英文单词），");
    g_tipLine[6013] = StringToText("  这个词是有明确含义的，不能是无法组成词语的字拼接在一起。");
    g_tipLine[6014] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("可以连续多个夜晚选择同一名玩家。") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("可以选择已死亡的玩家。") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("不能选择自己。");
    g_tipLine[6015] = StringToText("【角色能力】");
    g_tipLine[6016] = StringToText("每个白天，如果你“疯狂”地证明自己是一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色（与之前不同），你可能会在当晚获得那个角色的能力，");
    g_tipLine[6017] = StringToText("  直到下个黄昏。");
    g_tipLine[6018] = StringToText("【角色简介】");
    g_tipLine[6019] = TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("擅长在万千样貌中变化自如。");
    g_tipLine[6020] = StringToText("· 如果") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("疯狂证明自己是一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色，他就可能会在当晚获得那个角色的能力。");
    g_tipLine[6021] = StringToText("· 每当") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("获得一项能力时，那项能力会持续到下个黄昏。");
    g_tipLine[6022] = StringToText("· ") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("无法多次获得同一个角色的能力。");
    g_tipLine[6023] = StringToText("· ") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("可以连续多天疯狂证明自己是同一个角色，随后在接下来的一天证明自己是其他角色。");
    g_tipLine[6024] = StringToText("  每次在决定") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("是否能够获得能力时，只会参考") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("当天白天的言论。");
    g_tipLine[6025] = StringToText("  只要他这一天疯狂证明的角色与他之前曾经证明过且获得能力的角色不同，");
    g_tipLine[6026] = StringToText("  他就可能会获得这个角色的能力。");
    g_tipLine[6027] = StringToText("· 部分角色能力跨度时间与") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("获得能力的时间可能会不匹配。（如") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("、歌伶等。）");
    g_tipLine[6028] = StringToText("  这些角色的能力在") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("疯狂证明时便可立即获得，无需等到夜晚。");
    g_tipLine[6029] = StringToText("【角色能力】");
    g_tipLine[6030] = StringToText("你以为你是一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，但你实际上不是。如果有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了你，");
    g_tipLine[6031] = StringToText("  你会立即变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[6032] = StringToText("【角色简介】");
    g_tipLine[6033] = TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("误以为自己置身事外，然而当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("睥睨时，他才终于醒悟：没有任何人可以置身事外。");
    g_tipLine[6034] = StringToText("· 在游戏设置时，如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("作为出场角色，则将") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("角色标记移除，");
    g_tipLine[6035] = StringToText("  并增加一个未出场的任意") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，然后再让玩家随机抽取角色。");
    g_tipLine[6036] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("不具有自己以为的那个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的角色能力。");
    g_tipLine[6037] = StringToText("· 当") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响时，在相关的效果生效前，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会先改变角色，");
    g_tipLine[6038] = StringToText("  变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6039] = StringToText("· 如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化发生在白天，那么说书人会在当晚所有玩家闭眼后，");
    g_tipLine[6040] = StringToText("  第一时间唤醒") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("并告知他相关的角色变化。");
    g_tipLine[6041] = StringToText("· 在") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化后，如果他随即受到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的此次能力效果影响，使得他再次变化角色，");
    g_tipLine[6042] = StringToText("  那么说书人只会告知他最终的变化结果。");
    g_tipLine[6043] = StringToText("【规则细节】");
    g_tipLine[6044] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力需要让他认为自己是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，因此") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("无法认为自己是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6045] = StringToText("  因为这两个角色不会作为角色标记发给玩家。（即使") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的规则允许让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("角色标记，");
    g_tipLine[6046] = StringToText("  那也仅代表玩家在作为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记，而非在作为") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记。）");
    g_tipLine[6047] = StringToText("· 特定角色互动：");
    g_tipLine[6048] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为邻座，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会直接") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，不会发生角色变化。");
    g_tipLine[6049] = StringToText("  如果在游戏过程中有玩家变成了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("且") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为与他邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6050] = StringToText("  ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会正常发生角色变化。");
    g_tipLine[6051] = StringToText("· 相克规则：");
    g_tipLine[6052] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("产生了错误信息或“能力未正常生效”。");
    g_tipLine[6053] = StringToText("· ") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("可以变成新的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。如果因此使得") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量超过1人，");
    g_tipLine[6054] = StringToText("  会有一名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6055] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("无法拥有") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[6056] = StringToText("【角色能力】");
    g_tipLine[6057] = StringToText("在你的首个夜晚，你会得知两名非") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家。");
    g_tipLine[6058] = StringToText("【角色简介】");
    g_tipLine[6059] = TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("会得知角色不为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的玩家。");
    g_tipLine[6060] = StringToText("· 在") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("的首个夜晚，他会得知两名玩家，这两名玩家的角色都不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6061] = StringToText("· 在随后的夜晚，") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("不会得知更多的信息。");
    g_tipLine[6062] = StringToText("· ") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("得知的玩家可以是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("甚至") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，但") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("不会知道他所得知的玩家的具体角色类型。");
    g_tipLine[6063] = StringToText("【角色能力】");
    g_tipLine[6064] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，你死亡，然后他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到下个黎明。");
    g_tipLine[6065] = StringToText("【角色简介】");
    g_tipLine[6066] = TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会不断地寻找") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，令其短暂失去能力，并以自身死亡作为代价。");
    g_tipLine[6067] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，如果那名玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("依然存活。");
    g_tipLine[6068] = StringToText("  当选中一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家时，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("死亡，然后那名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家在当晚") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6069] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("只会维持到天亮前，天亮后") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家不再") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6070] = StringToText("· 如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("的死亡由于某些原因被阻止，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家当晚不会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6071] = StringToText("【规则细节】");
    g_tipLine[6072] = StringToText("· 特定角色互动：");
    g_tipLine[6073] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了照顾") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的玩家，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会死亡，该玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6074] = StringToText("  ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的能力不会受到任何影响。");
    g_tipLine[6075] = StringToText("【角色能力】");
    g_tipLine[6076] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：如果他在场，他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6077] = StringToText("【角色简介】");
    g_tipLine[6078] = StringToText("鸩可以冒着某个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("死亡的风险来确认该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("是否在场。");
    g_tipLine[6079] = StringToText("· 每局游戏限一次，除首个夜晚以外的其他夜晚，鸩可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，如果那个角色在场，");
    g_tipLine[6080] = StringToText("  该角色对应的玩家会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6081] = StringToText("· 如果鸩选择了一个不在场的角色，不会有任何玩家受到鸩的影响，即使之后被选择的角色在场了，");
    g_tipLine[6082] = StringToText("  他也不会受到鸩的影响。");
    g_tipLine[6083] = StringToText("· 如果某个角色有多名玩家在场，且鸩选择了这个角色，只会有一名玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6084] = StringToText("【规则细节】");
    g_tipLine[6085] = StringToText("· 如果鸩选择了自己，他会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("但不会死亡。因为鸩先让自己") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("失去了能力，");
    g_tipLine[6086] = StringToText("  所以通常情况下鸩不会死于自己的能力。（特殊情况下，鸩可以死于自己的能力，");
    g_tipLine[6087] = StringToText("  比如咖啡师的效果1对鸩生效。）");
    g_tipLine[6088] = StringToText("· 相克规则：");
    g_tipLine[6089] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("不会因为鸩的能力") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[6090] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6091] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6092] = StringToText("【角色能力】");
    g_tipLine[6093] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[6094] = StringToText("【角色简介】");
    g_tipLine[6095] = TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("凭借直觉行事。");
    g_tipLine[6096] = StringToText("· ") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("可以连续几个夜晚得知同一名玩家，也可以在每个夜晚都得知不同的玩家。");
    g_tipLine[6097] = StringToText("· 她得知的玩家可以是存活玩家，也可以是死亡玩家。");
    g_tipLine[6098] = StringToText("· 她得知的玩家可以是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，也可以是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[6099] = StringToText("· 没有绝对的标准用于决定说书人究竟要给") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("什么样的信息。说书人通过自己的判断来决定给出") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255));
    g_tipLine[6100] = StringToText("  的信息内容，这取决于他认为给出什么样的信息能够对") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更加有利。");
    g_tipLine[6101] = StringToText("  这可能是因为某些玩家有重要信息但尚未公布，或是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的伪装一戳即破，");
    g_tipLine[6102] = StringToText("  或是有值得被信赖的玩家需要建立更强的信任，或是有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的推理出现了谬误，急需被纠正，");
    g_tipLine[6103] = StringToText("  或是其他各种各样的原因。");
    g_tipLine[6104] = StringToText("【角色能力】");
    g_tipLine[6105] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6106] = StringToText("【角色简介】");
    g_tipLine[6107] = TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("会让一名玩家得知他是") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6108] = StringToText("· 在夜晚，") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("选择一名玩家。这名玩家被唤醒，然后得知谁是") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6109] = StringToText("· ") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("和他选择的玩家不会有眼神交流。他们分开被唤醒。");
    g_tipLine[6110] = StringToText("· ") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("选择哪个夜晚使用自己的能力。");
    g_tipLine[6111] = StringToText("【规则细节】");
    g_tipLine[6112] = StringToText("· 处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("状态下且使用了自己能力的") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("，会和能力正常生效的") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("一样在游戏的剩余时间里");
    g_tipLine[6113] = StringToText("  将不会再被唤醒。");
    g_tipLine[6114] = StringToText("· 特定角色互动：");
    g_tipLine[6115] = StringToText("· 学徒/") + TextWithColor(StringToText("食人族"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("哲学家"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("小精灵"), Color(0, 191, 255)) + StringToText("：仍然向被选择的玩家展示") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("标记，");
    g_tipLine[6116] = StringToText("  即使是那名玩家是那些获得") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("能力的角色。");
    g_tipLine[6117] = StringToText("· 咖啡师：如果还未使用能力的") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("受到咖啡师行动两次的影响，他可以选择两名玩家，");
    g_tipLine[6118] = StringToText("  被选择的玩家都会被告知。被选择的玩家不会被告知两次。");
    g_tipLine[6119] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("在夜晚被唤醒可被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("探查，即使当晚他选择不使用能力。然而，");
    g_tipLine[6120] = StringToText("  被") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("选择的玩家不会被探查，因为他是由于") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("的能力而被唤醒，而不是他自身的能力。");
    g_tipLine[6121] = StringToText("· ") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("是当晚首个使用其自身能力选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的玩家，") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("会被") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，");
    g_tipLine[6122] = StringToText("  而") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("不会得知") + TextWithColor(StringToText("守夜人"), Color(0, 191, 255)) + StringToText("是谁。");
    g_tipLine[6123] = StringToText("【角色能力】");
    g_tipLine[6124] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，你死亡。");
    g_tipLine[6125] = StringToText("【角色简介】");
    g_tipLine[6126] = TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("会在找到") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的玩家时死亡。");
    g_tipLine[6127] = StringToText("· 除首个夜晚之外的每个夜晚，") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("要选择一名玩家。如果该玩家在当晚保持清醒健康，");
    g_tipLine[6128] = StringToText("  什么也不会发生；如果该玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("就会死亡。");
    g_tipLine[6129] = StringToText("· 如果") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，则不会因自身能力而死亡。");
    g_tipLine[6130] = StringToText("· ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("可以选择任何玩家——无论存活还是死亡的玩家，也可以选择自己。");
    g_tipLine[6131] = StringToText("· 如果") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("选择的玩家在被选择时是清醒健康的，但在夜晚稍后阶段") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，");
    g_tipLine[6132] = StringToText("  ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("仍会死亡。");
    g_tipLine[6133] = StringToText("· ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("不会得知所选玩家是") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("、") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，还是两者皆有。");
    g_tipLine[6134] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("（Drunk）会被") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("（drunk）（双关）。");
    g_tipLine[6135] = StringToText("【角色能力】");
    g_tipLine[6136] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了你，所有玩家都会得知此事。从现在开始，你每天可以发起两次提名，");
    g_tipLine[6137] = StringToText("  每次投票时可以投两票。");
    g_tipLine[6138] = StringToText("【角色简介】");
    g_tipLine[6139] = TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("在死亡后获得力量，提名和投票次数变为原本的两倍。");
    g_tipLine[6140] = StringToText("· ") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("在存活时，如常进行提名和投票。");
    g_tipLine[6141] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("，她每天可以发起两次提名，即使通常情况下来说已死亡的玩家无法发起提名。");
    g_tipLine[6142] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("，她可以自由地在提名中投票，无需消耗投票标记。");
    g_tipLine[6143] = StringToText("  她可以在同一次提名中投两票。");
    g_tipLine[6144] = StringToText("· ") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("死亡后的能力只会在被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死之后获得。死于处决或是死于非") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力不会让她获得这些能");
    g_tipLine[6145] = StringToText("  力。");
    g_tipLine[6146] = StringToText("· 如果要在一次提名中投出两票，") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("需要在计票时同时举起两只手。");
    g_tipLine[6147] = StringToText("  如果玩家因为某些生理障碍无法做到这样的行为，说书人可以默认将他的常规票数翻倍。");
    g_tipLine[6148] = StringToText("【规则细节】");
    g_tipLine[6149] = StringToText("· 如果") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("在获得死亡能力时清醒健康，但在随后") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，她无法发起提名，");
    g_tipLine[6150] = StringToText("  且投票需要消耗投票标记。");
    g_tipLine[6151] = StringToText("· 特定角色互动：");
    g_tipLine[6152] = StringToText("· 官员：官员会让") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("的每一票都算作三票。");
    g_tipLine[6153] = StringToText("· 窃贼：窃贼会让") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("的每一票都算作负票。与官员效果结合后，每一票都算作负三票。");
    g_tipLine[6154] = StringToText("· 相克规则：");
    g_tipLine[6155] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：每个夜晚*，") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：");
    g_tipLine[6156] = StringToText("  如果") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("被选择，他死亡并能力生效。");
    g_tipLine[6157] = StringToText("· 暴乱：每个夜晚*，暴乱要选择一名存活的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家（与之前的每个夜晚不同）：如果") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("被选择，");
    g_tipLine[6158] = StringToText("  他死亡并能力生效。");
    g_tipLine[6159] = StringToText("· ") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("杀死了") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("，玩家仍然会得知正确信息。（中文百科上的‘通用简化原则’已涵盖包");
    g_tipLine[6160] = StringToText("  括多角色互动下的") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("信息的简化处理方式，此条仅作说明。）");
    g_tipLine[6161] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6162] = StringToText("· 狸猫：如果狸猫与") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("交换角色，不会触发") + TextWithColor(StringToText("报丧女妖"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[6163] = StringToText("【角色能力】");
    g_tipLine[6164] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会以为你是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会以为你是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6165] = StringToText("【角色简介】");
    g_tipLine[6166] = TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("能够迷惑") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，让他们分不清究竟谁才是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[6167] = StringToText("· 在游戏的首个夜晚，不是告诉所有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，而是改为告诉") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("都是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6168] = StringToText("· 在游戏的首个夜晚，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会得知所有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("都是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[6169] = StringToText("· ") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("不会因此被唤醒，也不会得知任何有关") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的信息。");
    g_tipLine[6170] = StringToText("· 说书人在告知时可以以任意顺序指向") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("和其他") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，这样") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家就不会知道究竟哪一名玩家是");
    g_tipLine[6171] = StringToText("  ") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("了。");
    g_tipLine[6172] = StringToText("· 如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡，导致") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在游戏中途互认，") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("的能力也会在那个夜晚生效，");
    g_tipLine[6173] = StringToText("  就如同常规情况下在首个夜晚时一样。");
    g_tipLine[6174] = StringToText("【规则细节】");
    g_tipLine[6175] = StringToText("· 特定角色互动：");
    g_tipLine[6176] = StringToText("· ") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("：被") + TextWithColor(StringToText("赏金猎人"), Color(0, 191, 255)) + StringToText("转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("不是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，因此") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("不会因自身能力与该玩家发生");
    g_tipLine[6177] = StringToText("  互动。");
    g_tipLine[6178] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("死亡时") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("还活着，他会影响") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("/") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("信息环节，");
    g_tipLine[6179] = StringToText("  就像他在首夜运作的那样。");
    g_tipLine[6180] = StringToText("· ") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("：如果角色列表上有") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("，你可以假装让") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("以为场上有") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6181] = StringToText("  并且向他展示额外一名“") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("”，无论场上是否真的有") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6182] = StringToText("· ") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("：不与") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("的能力发生互动。尽管") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("以为") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("能力不会将") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[6183] = StringToText("  所以") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("被处决时不会触发") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("能力。");
    g_tipLine[6184] = StringToText("· ") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("：可以将") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。同样，当") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("以为") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[6185] = StringToText("  但") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("能力将") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("，因此如果") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("首个说出关键词，当晚会转变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[6186] = StringToText("· ") + TextWithColor(StringToText("红唇女郎"), Color(0, 191, 255)) + StringToText("：参考") + TextWithColor(StringToText("主谋"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[6187] = StringToText("· ") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("选择在夜里自杀，不能将") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("的角色改变为") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6188] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("是与") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家，他无法影响") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("信息环节。");
    g_tipLine[6189] = StringToText("· ") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("：不与") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("发生互动。");
    g_tipLine[6190] = StringToText("· 旅行者/传奇角色：既不是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("也不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("（即使是拥有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("能力的学徒），");
    g_tipLine[6191] = StringToText("  所以不会被") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("能力影响，只能得知正确的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家。");
    g_tipLine[6192] = StringToText("· 咖啡师：如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在首夜因为咖啡师变得清醒且健康，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("/") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("信息环节") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("将不会向他展示。");
    g_tipLine[6193] = StringToText("· 相克规则：");
    g_tipLine[6194] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("：当") + TextWithColor(StringToText("间谍"), Color(0, 191, 255)) + StringToText("/") + TextWithColor(StringToText("寡妇"), Color(255, 69, 0)) + StringToText("查看魔典时，") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的角色标记会被说书人移除。");
    g_tipLine[6195] = StringToText("  （请同样移除任何相关提示标记以便在缺少角色标记的情况下让其不是那么明显。）");
    g_tipLine[6196] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("存活，由说书人决定谁照看") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6197] = StringToText("· ") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("在场，") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("不会拥有能力，但他会免疫") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("的能力。");
    g_tipLine[6198] = StringToText("· 亡魂：每次处决后，存活的") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("可以公开猜测一名存活玩家是亡魂：如果猜对了，");
    g_tipLine[6199] = StringToText("  ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("当晚必须选择亡魂。");
    g_tipLine[6200] = StringToText("· ") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("在场，") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("将被分组唤醒并得知非") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[6201] = StringToText("· ") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("存活，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会得知谁是") + TextWithColor(StringToText("提线木偶"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[6202] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6203] = StringToText("· ") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("蛊雕"), Color(255, 69, 0)) + StringToText("会跳过") + TextWithColor(StringToText("魔术师"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6204] = StringToText("【角色能力】");
    g_tipLine[6205] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[6206] = StringToText("【角色简介】");
    g_tipLine[6207] = TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[6208] = StringToText("· ") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("得知的是玩家，但不得知他的具体角色。");
    g_tipLine[6209] = StringToText("· ") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会在首个夜晚得知他的信息。");
    g_tipLine[6210] = StringToText("· 如果") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会在当晚得知信息。");
    g_tipLine[6211] = StringToText("【角色能力】");
    g_tipLine[6212] = StringToText("每个白天，你可以公开进行一次谁是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的猜测。如果你猜对，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[6213] = StringToText("【角色简介】");
    g_tipLine[6214] = TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("想要尝试猜出所有的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营玩家。");
    g_tipLine[6215] = StringToText("· ") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("的猜测需要在白天且公开进行。他不需要每个白天都进行猜测。");
    g_tipLine[6216] = StringToText("· 其他玩家也可以假装自己是") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("来进行猜测。如同") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6217] = StringToText("  说书人也需要配合假装那名玩家是") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6218] = StringToText("· 如果") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("猜对了谁是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，游戏会立刻结束。这需要") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("一次性猜中所有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[6219] = StringToText("· ") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("不需要猜测") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("的具体角色是什么。");
    g_tipLine[6220] = StringToText("· 如果有多于一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("在场，") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("也需要猜中全部的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[6221] = StringToText("· 如果一名玩家既是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，例如") + TextWithColor(StringToText("军团"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("需要猜测这名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("才算猜对。");
    g_tipLine[6222] = StringToText("· 一旦") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("猜测完毕，他在当天就不能更改自己的猜测结果或是再次进行猜测。");
    g_tipLine[6223] = StringToText("· ") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("也需要猜出所有属于") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("和") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，但他不需要猜中") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的旅行者。");
    g_tipLine[6224] = StringToText("· 如果在游戏中玩家的阵营发生了变化，") + TextWithColor(StringToText("戏法师"), Color(0, 191, 255)) + StringToText("需要猜测的是当前的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色所属玩家，");
    g_tipLine[6225] = StringToText("  而非游戏开始时的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色所属玩家。");
    g_tipLine[6226] = StringToText("【规则细节】");
    g_tipLine[6227] = StringToText("· 相克规则：");
    g_tipLine[6228] = StringToText("· ") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("：说书人不会宣布") + TextWithColor(StringToText("维齐尔"), Color(255, 69, 0)) + StringToText("在场。");
    g_tipLine[6229] = StringToText("【角色能力】");
    g_tipLine[6230] = StringToText("每个夜晚，你要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[6231] = StringToText("【角色简介】");
    g_tipLine[6232] = TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("顽皮捣蛋，会让特定的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色产生错误信息。");
    g_tipLine[6233] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("需要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。如果这个角色在场，对应玩家会被") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响，");
    g_tipLine[6234] = StringToText("  在下个黄昏之前均会产生错误信息。");
    g_tipLine[6235] = StringToText("· 受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力影响的玩家如果") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，仍然不会让其他玩家获得信息，因为他已经失去能力。");
    g_tipLine[6236] = StringToText("  然而他在获得因自己的能力而得知的信息时，也会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响而必定获得错误信息。");
    g_tipLine[6237] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("不会影响这名玩家通过其他方式获得的信息，例如说书人的规则解释，他自身的角色/阵营，");
    g_tipLine[6238] = StringToText("  或是由其他玩家的能力使他得知的信息。");
    g_tipLine[6239] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响的是具体角色所对应的玩家。仅仅是拥有这个角色能力，但实际角色并非") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色的");
    g_tipLine[6240] = StringToText("  玩家，不会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力的影响。");
    g_tipLine[6241] = StringToText("· 如果") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色当前不在场，但随后在场了，这个角色所对应的玩家仍然要受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipLine[6242] = StringToText("【角色能力】");
    g_tipLine[6243] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了他们之中的");
    g_tipLine[6244] = StringToText("  玩家。");
    g_tipLine[6245] = StringToText("【角色简介】");
    g_tipLine[6246] = TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("能够得知夜晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("作祟，侵扰玩家。");
    g_tipLine[6247] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("都可以选择一至三名玩家，但不能不进行选择，也不能选择自己。");
    g_tipLine[6248] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中没有在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知“否”。");
    g_tipLine[6249] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知“是”。");
    g_tipLine[6250] = StringToText("  如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择了超过一名玩家，他不会得知是具体哪名玩家被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响了。");
    g_tipLine[6251] = StringToText("· 不仅") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("、") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("能力会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("能力也会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[6252] = StringToText("【规则细节】");
    g_tipLine[6253] = StringToText("“影响”的范围包括：改变该玩家的状态（角色、阵营等），对该玩家的能力造成了妨害效果（互动干扰、");
    g_tipLine[6254] = StringToText("  能力效果干扰、阻止能力生效等），等等。暴露角色、让他人获取信息等能力不在“影响”的范围内。");
    g_tipLine[6255] = StringToText("与“保护”类似，如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家执行了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的能力产生选择或影响，同样会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[6256] = StringToText("· 特定角色互动：");
    g_tipLine[6257] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家照顾了") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("，当晚因") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("能力死亡的玩家算作被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力影响了。");
    g_tipLine[6258] = StringToText("· 相克规则：");
    g_tipLine[6259] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[6260] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否被影响，即使他是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[6261] = StringToText("【角色能力】");
    g_tipLine[6262] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为替代。");
    g_tipLine[6263] = StringToText("【角色简介】");
    g_tipLine[6264] = TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("精通各种怪力乱神之术，能够将对他潜在的威胁转移到邪祟之人的身上。");
    g_tipLine[6265] = StringToText("· 在夜晚时，任何使用自身能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家，在其能力生效前，选择的目标会暗中转移到一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家");
    g_tipLine[6266] = StringToText("  的身上。随后，这项能力效果会以那名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为新的目标来进行结算。");
    g_tipLine[6267] = StringToText("· 使用能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家不会得知自己的选择目标被更改，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力被触发。");
    g_tipLine[6268] = StringToText("· 只有需要做出选择的能力才能被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[6269] = StringToText("· 在一项能力更换目标后，无需重新进行选择限制条件的判断。") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("的选择目标可能会因此改为已经死亡");
    g_tipLine[6270] = StringToText("  的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("的选择目标可能会改为选中自己。");
    g_tipLine[6271] = StringToText("· 在一项能力更换目标后，需要重新进行能力效果中触发条件的判断。") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("因为") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("而改为选中") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时，");
    g_tipLine[6272] = StringToText("  不会让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("失去能力，因为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("是不同的角色类型。");
    g_tipLine[6273] = StringToText("· 一项能力在更换选择目标后，能力自身与选择相关的内容不会因此发生变更，");
    g_tipLine[6274] = StringToText("  依然以玩家自身做出的选择作为判断基准。") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("在选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("后导致目标转移，");
    g_tipLine[6275] = StringToText("  他在第二晚无法选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，而不是无法选择转移后的目标。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在选择主人时目标被变更，");
    g_tipLine[6276] = StringToText("  ") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在下个白天投票时仍然需要参考他昨晚选择的那名玩家的投票意见，不会受到影响。");
    g_tipLine[6277] = StringToText("· 如果一项能力需要玩家选择多个目标，而") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("成为了目标之一，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("只会将自己更改为一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，");
    g_tipLine[6278] = StringToText("  不会使得玩家的其他目标发生变化。") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会让一项能力的多个目标中重复选择同一名玩家。");
    g_tipLine[6279] = StringToText("  如果此时没有其他合法的目标可以转移选择，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("仍然会受到原本能力效果的影响。");
    g_tipLine[6280] = StringToText("· 一项能力中的某个选择目标至多只能被转移一次。也就是说，被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后的目标，");
    g_tipLine[6281] = StringToText("  无法受到") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的影响使得目标再次转移。");
    g_tipLine[6282] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚被触发。在白天时，他的能力不会产生任何效果。");
    g_tipLine[6283] = StringToText("【规则细节】");
    g_tipLine[6284] = StringToText("· 特定角色互动：");
    g_tipLine[6285] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会直接死亡，并且不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家身上。");
    g_tipLine[6286] = StringToText("· ") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，是否播报能力取决于") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移结果的玩家是否与") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("之前的选");
    g_tipLine[6287] = StringToText("  择发生了变化。被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后，") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("的能力只会对转移后的目标生效（从某种意义上来说，");
    g_tipLine[6288] = StringToText("  也算是无效了，因为") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("的能力此时只能让") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营落败）。") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("需要通过播报与否来判断自己");
    g_tipLine[6289] = StringToText("  是否选中了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[6290] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("为邻座，且有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，在") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力生效前，");
    g_tipLine[6291] = StringToText("  ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会先将选择目标转移，从而使得") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家既不会选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("为目标，也不会影响") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6292] = StringToText("  因此不会触发") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力。反之，如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("将") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的选择转移到与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，");
    g_tipLine[6293] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力就会因此被触发。");
    g_tipLine[6294] = StringToText("· 相克规则：");
    g_tipLine[6295] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipLine[6296] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[6297] = StringToText("· 鸩：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[6298] = StringToText("【角色能力】");
    g_tipLine[6299] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[6300] = StringToText("  改为选中另一名玩家。");
    g_tipLine[6301] = StringToText("【角色简介】");
    g_tipLine[6302] = TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("促成两名阵营相同的玩家的合作，使得其他玩家的选择被转换。");
    g_tipLine[6303] = StringToText("· 在夜晚时，") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家如果阵营相同，任何玩家使用自身能力选择他们之一时，");
    g_tipLine[6304] = StringToText("  在其能力生效前，选择的目标会转移到另一名玩家的身上。随后，这项能力效果会以另一名玩家作为新的");
    g_tipLine[6305] = StringToText("  目标来结算。");
    g_tipLine[6306] = StringToText("· 如果") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家阵营不相同，那么，任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[6307] = StringToText("  不会发生转移。");
    g_tipLine[6308] = StringToText("· 使用能力被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标的玩家不会得知自己的选择目标被更换。") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("也不会得知是否有玩家因此被转移");
    g_tipLine[6309] = StringToText("  了选择的目标。");
    g_tipLine[6310] = StringToText("· 只有需要玩家做出选择的能力才能被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[6311] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚生效。在白天时，他的能力不会产生任何效果。");
    g_tipLine[6312] = StringToText("【规则细节】");
    g_tipLine[6313] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会持续检测被选择的玩家的阵营，一旦他们当中出现了阵营变化导致这两名玩家阵营不同，");
    g_tipLine[6314] = StringToText("  ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会立即失去对这两名玩家更换选择目标的能力。");
    g_tipLine[6315] = StringToText("· 更多规则与细节详情请查看更换选择目标。");
    g_tipLine[6316] = StringToText("· 特定角色互动：");
    g_tipLine[6317] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的玩家，那名玩家会直接死亡，并不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到另一名玩家身");
    g_tipLine[6318] = StringToText("  上。");
    g_tipLine[6319] = StringToText("· 相克规则：");
    g_tipLine[6320] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipLine[6321] = StringToText("【角色能力】");
    g_tipLine[6322] = StringToText("每个夜晚，当有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎");
    g_tipLine[6323] = StringToText("  明，且你会得知你的能力被触发。");
    g_tipLine[6324] = StringToText("【角色简介】");
    g_tipLine[6325] = TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("慈悲为怀，一视同仁地庇护着他周围的人。");
    g_tipLine[6326] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在每个夜晚都能且仅能触发一次。");
    g_tipLine[6327] = StringToText("· 当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家，或者一项无需选择的能力在满足了条件而被触发，");
    g_tipLine[6328] = StringToText("  且会对与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家生效时，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家此次的能力不生效。");
    g_tipLine[6329] = StringToText("  这一效果跟使这名玩家“") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("/") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("”相似。然而，如果某名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家在同一个夜晚可以多次行动，");
    g_tipLine[6330] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能使其中一次效果无效，而除此以外的其他效果仍然会正常生效。");
    g_tipLine[6331] = StringToText("· 如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力是一项持续生效的能力，而非选择式或触发式的能力，");
    g_tipLine[6332] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使这项能力失效直至下个黎明。在下一个白天时，这项能力会再次生效。");
    g_tipLine[6333] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能在一项能力开始生效前阻止这项能力。他无法阻止已经生效的能力。");
    g_tipLine[6334] = StringToText("· 一旦") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力被成功触发，他会被唤醒，并得知自己的能力刚刚被触发了。");
    g_tipLine[6335] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("不会得知是哪名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力被他阻止了，也不会得知这项能力影响的是与他邻近的哪一名玩家。");
    g_tipLine[6336] = StringToText("  他只是单纯知道自己的能力被触发了。");
    g_tipLine[6337] = StringToText("· 如果一项") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力无法被阻止，那么") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力不会因此被触发，");
    g_tipLine[6338] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力触发了。");
    g_tipLine[6339] = StringToText("【规则细节】");
    g_tipLine[6340] = StringToText("· 如果") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力使得一项“玩家让自身获得信息”的能力失效，其处理方式与") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("相似，");
    g_tipLine[6341] = StringToText("  该玩家仍然会获得信息，但信息可对可错。");
    g_tipLine[6342] = StringToText("· 特定角色互动：");
    g_tipLine[6343] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("影响了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[6344] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在首个夜晚不会触发。如果") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("在游戏中途的某个夜晚被创造并将要影响与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的");
    g_tipLine[6345] = StringToText("  ") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力会被触发，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("能力（包括让另一侧的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("）");
    g_tipLine[6346] = StringToText("  会在下个黎明才开始生效。");
    g_tipLine[6347] = StringToText("· 限：如果限的能力让所有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[6348] = StringToText("· ") + TextWithColor(StringToText("混沌"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("混沌"), Color(255, 0, 0)) + StringToText("的能力让所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，（") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的）") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[6349] = StringToText("· 相克规则：");
    g_tipLine[6350] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[6351] = StringToText("· 暴乱：如果暴乱提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[7042] = StringToText("【角色能力】");
    g_tipLine[7043] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到下个黄昏。");
    g_tipLine[7044] = StringToText("你不会死亡。");
    g_tipLine[7045] = StringToText("【角色简介】");
    g_tipLine[7046] = TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("要么自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，要么让别人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。只要") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("是清醒状态，就不会死亡。");
    g_tipLine[7047] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，该玩家可能会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7048] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了自己，他失去自己的“不会死亡”能力，直到恢复清醒为止。");
    g_tipLine[7049] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("不小心选择了已死亡的玩家，说书人应提醒他重新选择。");
    g_tipLine[7050] = StringToText("· 如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了其他玩家，由说书人来选择哪名玩家将会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[7051] = StringToText("  说书人通常会让该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，但如果选择了") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，那么说书人通常会让") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7052] = StringToText("· 在") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("清醒时，他不会死亡，即使") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("还没在夜晚被唤醒。");
    g_tipLine[7053] = StringToText("【规则细节】");
    g_tipLine[7054] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("。让") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("指向任意一名存活玩家。让") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("重新入睡。") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("或他选择的玩家两者之一会进入");
    g_tipLine[7055] = StringToText("  ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("状态——将“") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("”提示标记放置到该玩家的角色标记旁。");
    g_tipLine[7056] = StringToText("如果清醒的") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("将要死亡，他会依然存活。如果清醒的") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("被处决，宣布该玩家被处决但依然存活。");
    g_tipLine[7057] = StringToText("  （不要说明原因。）");
    g_tipLine[7058] = StringToText("【角色能力】");
    g_tipLine[7059] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[7060] = StringToText("【角色简介】");
    g_tipLine[7061] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("能够猜测玩家的角色……但是猜错的代价是相当巨大的。");
    g_tipLine[7062] = StringToText("· 除了首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，并在角色列表上指向一个角色图标来猜测其角色。");
    g_tipLine[7063] = StringToText("  如果猜测正确，无事发生。如果猜测错误，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("死亡。");
    g_tipLine[7064] = StringToText("· ") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[7065] = StringToText("· ") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("可以选择任何玩家，无论是已死亡还是存活，甚至可以是") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipLine[7066] = StringToText("【规则细节】");
    g_tipLine[7067] = StringToText("除了首个夜晚以外的每个夜晚，唤醒") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("。让") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("指向任意一名玩家，然后指向角色列表上的任意一个角色图");
    g_tipLine[7068] = StringToText("  标。让") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("重新入睡。如果所选的玩家的角色和所选角色图标不同，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("死亡——将“死亡”提示标记放");
    g_tipLine[7069] = StringToText("  置到") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("的角色标记旁。");
    g_tipLine[7070] = StringToText("【角色能力】");
    g_tipLine[7071] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[7072] = StringToText("【角色简介】");
    g_tipLine[7073] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[7074] = StringToText("· 每个白天，") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("可以公开发表一个声明。如果该声明是正确的，说书人会在当晚杀死一名玩家。");
    g_tipLine[7075] = StringToText("  如果声明是错误的，那就没有玩家会因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("而死。");
    g_tipLine[7076] = StringToText("· 含糊不清的词语、低声细语、说书人无法判断对错的声明、或是发表声明时有人没听到等情况下，");
    g_tipLine[7077] = StringToText("  声明都不作数。如同") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的能力，说书人和每一名玩家都必须要听到并明确") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表的声明，");
    g_tipLine[7078] = StringToText("  明白") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("正在使用自己的能力，以此来让说书人判定接下来会发生什么。");
    g_tipLine[7079] = StringToText("· 如果") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("在白天处于") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("时发表了一个正确的声明，但当晚") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("能力触发时他恢复了清醒和健");
    g_tipLine[7080] = StringToText("  康，那么说书人仍然会杀死一名玩家。");
    g_tipLine[7081] = StringToText("【规则细节】");
    g_tipLine[7082] = StringToText("每个白天，如果") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表了一个明确且正确的公开声明，将") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("的“死亡”提示标记放置到魔典左侧的中");
    g_tipLine[7083] = StringToText("  央，来提醒自己当晚需要放置该标记。");
    g_tipLine[7084] = StringToText("除了首个夜晚以外的每个夜晚，如果今天白天") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表了一个明确且正确的公开声明，");
    g_tipLine[7085] = StringToText("  你选择任意一名玩家死亡——将“死亡”提示标记放置到该玩家的角色标记旁。");
    g_tipLine[7086] = StringToText("在选择因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("能力而死亡的玩家时，我们推荐你选择能够死亡的角色，不要选择那些受到能力保护而无法死");
    g_tipLine[7087] = StringToText("  亡的角色（例如") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的能力）。当声明造成死亡时，") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("才能得到更多信息。");
    g_tipLine[7088] = StringToText("  这对") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更有帮助，也会让游戏更加有趣。");
    g_tipLine[7089] = StringToText("【角色能力】");
    g_tipLine[7090] = StringToText("如果与你邻近的两名存活的玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，他们不会死亡。");
    g_tipLine[7091] = StringToText("【角色简介】");
    g_tipLine[7092] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("保护着她邻近的玩家免于死亡……只要他们都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的。");
    g_tipLine[7093] = StringToText("· 如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家当前都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，这两名玩家就都不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不能杀死他们，");
    g_tipLine[7094] = StringToText("  ") + TextWithColor(StringToText("教父"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("也不行。如果他们被处决，也不会死亡。唯一的例外是") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[7095] = StringToText("  他能杀死受到保护而免于死亡的人。");
    g_tipLine[7096] = StringToText("· ") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的邻近的存活玩家是最靠近") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("两名存活玩家——一名为顺时针方向最近的存活玩家，");
    g_tipLine[7097] = StringToText("  一名为逆时针方向上最近的存活玩家。已死亡的邻近玩家会被跳过。");
    g_tipLine[7098] = StringToText("· 然而，如果邻近的存活玩家其中之一是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，或者两个都是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，");
    g_tipLine[7099] = StringToText("  那么") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("就无法保护她的邻近存活玩家。如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家死亡，使得") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("现在的两个邻近玩家都是");
    g_tipLine[7100] = StringToText("  ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，那么他们就又都不会死亡了。");
    g_tipLine[7101] = StringToText("【规则细节】");
    g_tipLine[7102] = StringToText("如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家都是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，将") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的“不会死亡”提示标记放置到这两名玩家的角色标记");
    g_tipLine[7103] = StringToText("  旁。如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家中有任何一个是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，移除这些提示标记。");
    g_tipLine[7104] = StringToText("  根据这个条件在整局游戏中随时更新这些提示标记（例如一名玩家的阵营改变了）。");
    g_tipLine[7105] = StringToText("如果一名标有“不会死亡”的玩家将要死去，该玩家依然存活。如果一名标有“不会死亡”的玩家被处决，");
    g_tipLine[7106] = StringToText("  宣布该玩家被处决但依然存活。（不要说明原因。）");
    g_tipLine[7107] = StringToText("【角色能力】");
    g_tipLine[7108] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipLine[7109] = StringToText("【角色简介】");
    g_tipLine[7110] = TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("能够死里逃生……但仅限一次。");
    g_tipLine[7111] = StringToText("· ") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("首次因任何理由死亡时，他依然存活。") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会得知是他自己的能力救了自己的命。");
    g_tipLine[7112] = StringToText("· 如果其他角色的能力保护") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("免于死亡，") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("不会使用掉自己的能力。只有当") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("将要真正的死去时，");
    g_tipLine[7113] = StringToText("  他的能力才会触发。");
    g_tipLine[7114] = StringToText("【规则细节】");
    g_tipLine[7115] = StringToText("如果") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("将要死亡，他依然存活。（但是如果此时") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("就会死亡。）如果") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("被处决，");
    g_tipLine[7116] = StringToText("  宣布该玩家被处决但依然存活。（不要说明原因。）");
    g_tipLine[7117] = StringToText("无论哪种情况，") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("都失去自己的能力——将“失去能力”提示标记放置到") + TextWithColor(StringToText("弄臣"), Color(0, 191, 255)) + StringToText("的角色标记旁。");
    g_tipLine[7118] = StringToText("【角色能力】");
    g_tipLine[7119] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色和一个") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，");
    g_tipLine[7120] = StringToText("  该玩家是其中一个角色。");
    g_tipLine[7121] = StringToText("【角色简介】");
    g_tipLine[7122] = TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("能得知一名玩家可能对应的角色，但不能确认哪个是正确的。");
    g_tipLine[7123] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("需要选择一名其他玩家，并得知一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色与一个") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色，");
    g_tipLine[7124] = StringToText("  其中一个是那名玩家的真实角色。");
    g_tipLine[7125] = StringToText("· ") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("得知的错误角色标记取决于所选玩家的真正的角色类型。如果") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[7126] = StringToText("  对应的错误的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("角色可以是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，");
    g_tipLine[7127] = StringToText("  对应的错误的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色可以是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7128] = StringToText("· ") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("不能选择自己和旅行者作为目标。");
    g_tipLine[7129] = StringToText("【规则细节】");
    g_tipLine[7130] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("。让他指向除自己和旅行者外的任意一名玩家。如果被选择的玩家的真实角色是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或");
    g_tipLine[7131] = StringToText("  ") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，向") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("展示他的真实角色和任意一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色标记。");
    g_tipLine[7132] = StringToText("  如果被选择的玩家的真实角色是") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，则给") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("展示他的真实角色和任意一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色");
    g_tipLine[7133] = StringToText("  标记。让") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7134] = StringToText("如果") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("选择了一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，你能通过这种方式来帮助") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营：你可以给") + TextWithColor(StringToText("筑梦师"), Color(0, 191, 255)) + StringToText("展示") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家正在伪装");
    g_tipLine[7135] = StringToText("  的虚假角色，或者展示一些需要隐藏自己的角色，例如") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("贤者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("畸形秀演员"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("呆瓜"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7136] = StringToText("【角色能力】");
    g_tipLine[7137] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[7138] = StringToText("【角色简介】");
    g_tipLine[7139] = TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("会得知有多少死亡玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[7140] = StringToText("· 由于") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("每晚在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后行动，所以") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("的信息以当晚黎明时的状态为基准，");
    g_tipLine[7141] = StringToText("  他得知的是在所有玩家都睁开眼睛时，死亡的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家数量。");
    g_tipLine[7142] = StringToText("· ") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("能力能检测死去的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，以及任何属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的玩家。例如") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的旅行者，");
    g_tipLine[7143] = StringToText("  或者变得") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7144] = StringToText("· 在计算死亡玩家的数量时，请记住计算在魔典中倒置的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色标记，");
    g_tipLine[7145] = StringToText("  因为这意味着他们现在属于") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[7146] = StringToText("【规则细节】");
    g_tipLine[7147] = StringToText("除了第一个夜晚的每个夜晚，唤醒") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("。对他用手势比划已死亡的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的数量 (0，1，2等）。");
    g_tipLine[7148] = StringToText("  让") + TextWithColor(StringToText("神谕者"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7149] = StringToText("【角色能力】");
    g_tipLine[7150] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[7151] = StringToText("【角色简介】");
    g_tipLine[7152] = TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("能得知两名玩家是否属于同一阵营。");
    g_tipLine[7153] = StringToText("· ") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("每场游戏只能得到一次信息，所以") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("最好是选择最佳时机来使用能力，");
    g_tipLine[7154] = StringToText("  还要选择最关键的玩家。");
    g_tipLine[7155] = StringToText("· ") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("可以选择除自己外的任何玩家，无论他是生是死，甚至可以选择旅行者。");
    g_tipLine[7156] = StringToText("【规则细节】");
    g_tipLine[7157] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("。她要么摇头不使用能力，要么指向另两名玩家。");
    g_tipLine[7158] = StringToText("如果她摇头，无事发生。让") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7159] = StringToText("如果她指向两名玩家，要么点头代表是（表示这些玩家是同一阵营），要么摇头代表否（表示这些玩家不是同");
    g_tipLine[7160] = StringToText("  一阵营）。让") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("重新入睡。在") + TextWithColor(StringToText("女裁缝"), Color(0, 191, 255)) + StringToText("使用能力后，为她放置“失去能力”提示标记，");
    g_tipLine[7161] = StringToText("  并从夜晚顺序表上移除她的夜晚标记。");
    g_tipLine[7162] = StringToText("【角色能力】");
    g_tipLine[7163] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipLine[7164] = StringToText("【角色简介】");
    g_tipLine[7165] = TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("知道其他人不知道的事情：接下来该做什么。");
    g_tipLine[7166] = StringToText("· ") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("自由选择什么时候使用他的能力。");
    g_tipLine[7167] = StringToText("· 当") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("拜访说书人时，说书人会给他一条建议。");
    g_tipLine[7168] = StringToText("· 说书人的建议不需要是事实。他是说书人觉得能帮助") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("获胜的策略指示，如果他这样做的话。");
    g_tipLine[7169] = StringToText("· 如果") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，说书人可以给") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("一条糟糕的建议。");
    g_tipLine[7170] = StringToText("【规则细节】");
    g_tipLine[7171] = StringToText("每局游戏限一次，") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("可以使用他的能力。私下里，给他一条能帮助他获胜的建议。然后，");
    g_tipLine[7172] = StringToText("  把“失去能力”的提示标记放置在") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("的角色标记旁边。");
    g_tipLine[7173] = StringToText("给") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("建议的最好方式是让他做什么，而不是“是什么”信息。这让") + TextWithColor(StringToText("渔夫"), Color(0, 191, 255)) + StringToText("这个角色更有趣也更与众不同。");
    g_tipLine[7174] = StringToText("  例如，建议“你应该处决那个玩家”，或者“保护那名玩家”，或者“找到") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的玩家”，");
    g_tipLine[7175] = StringToText("  或者“颠覆你之前的想法”，或者“忽略") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("们的存在”，或者“相信哪名玩家”。");
    g_tipLine[7176] = StringToText("  这些建议会比“这名玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的”或者“") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("”更有趣。");
    g_tipLine[7177] = StringToText("【角色能力】");
    g_tipLine[7178] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("/") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("/均势）。");
    g_tipLine[7179] = StringToText("【角色简介】");
    g_tipLine[7180] = TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("清楚哪个阵营更具有优势。");
    g_tipLine[7181] = StringToText("· 如果") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更具优势，说书人会给出大拇指朝上的手势。如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营更具优势，");
    g_tipLine[7182] = StringToText("  说书人会给出大拇指朝下的手势。如果双方阵营势均力敌，或说书人并不确信哪一方更具优势，");
    g_tipLine[7183] = StringToText("  说书人会给出大拇指水平指向一侧的手势。");
    g_tipLine[7184] = StringToText("· 说书人需要对阵营的优势做出判断。很多因素都会作为考量，例如每个阵营有多少存活的玩家，");
    g_tipLine[7185] = StringToText("  ") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获取的信息程度如何，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的伪装的取信程度如何，玩家们即将打算处决谁，");
    g_tipLine[7186] = StringToText("  或是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家的游戏经验是否丰富。上述所有内容以及一些其他因素都会影响说书人的判断。");
    g_tipLine[7187] = StringToText("· 说书人判断的是") + TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("被唤醒的那一刻更具有优势的阵营。当晚较早时段里发生的事情也可能会影响判断。");
    g_tipLine[7188] = StringToText("【规则细节】");
    g_tipLine[7189] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("。如果你认为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更具优势，给出拇指朝上的手势。如果你认为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营更具优势，");
    g_tipLine[7190] = StringToText("  给出拇指朝下的手势。如果你不清楚哪一方更具优势，给出拇指水平指向一侧的手势。让") + TextWithColor(StringToText("将军"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7191] = StringToText("【角色能力】");
    g_tipLine[7192] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，他死亡，并且当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不会造成死亡。");
    g_tipLine[7193] = StringToText("会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[7194] = StringToText("【角色简介】");
    g_tipLine[7195] = TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("会在夜晚游荡，猎杀无辜，与此同时") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("在自己的老巢里蛰伏。");
    g_tipLine[7196] = StringToText("· ") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("必须在每个夜晚选择一名存活的玩家。如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择了已死亡的玩家，");
    g_tipLine[7197] = StringToText("  说书人会摇头并让") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("重新选择。");
    g_tipLine[7198] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，那名玩家死亡，并且当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("不能造成死亡。");
    g_tipLine[7199] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("选择的玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，那名玩家不会死亡，并且") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以造成死亡。");
    g_tipLine[7200] = StringToText("· 如果") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的玩家但没有导致那名玩家死亡，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("可以造成死亡。");
    g_tipLine[7201] = StringToText("· ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与造成死亡无关的能力仍然会正常运作，不会受到") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipLine[7202] = StringToText("· 一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。他同样也被") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，因此") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("无法杀死这名玩家。");
    g_tipLine[7203] = StringToText("【规则细节】");
    g_tipLine[7204] = StringToText("在为首个夜晚进行准备时，将") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("的“失足”提示标记放置在任意") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色标记旁，");
    g_tipLine[7205] = StringToText("  标记那名玩家为“失足”。");
    g_tipLine[7206] = StringToText("除首个夜晚之外的每个夜晚，唤醒") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("。让他指向任意一名存活的玩家。让") + TextWithColor(StringToText("半兽人"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7207] = StringToText("  如果被选择的玩家是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的，那名玩家死亡——在那名玩家的角色标记旁放置“死亡”标记。当晚，");
    g_tipLine[7208] = StringToText("  和平常一样唤醒") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("进行选择，但是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("无法造成死亡。如果被选择的玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的，");
    g_tipLine[7209] = StringToText("  什么事都不会发生。");
    g_tipLine[7210] = StringToText("【角色能力】");
    g_tipLine[7211] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，你会得知哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。[+") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[7212] = StringToText("【角色简介】");
    g_tipLine[7213] = TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("会在") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("被戕害时得知谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[7214] = StringToText("· ") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("可以在") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不在场时出现在游戏中。在游戏设置阶段，如果") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("在场而") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("不在场，");
    g_tipLine[7215] = StringToText("  那么") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("就会被添加进来并替换掉一个其他") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。而如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("已经在场，");
    g_tipLine[7216] = StringToText("  ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不会因此再将另外一名") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("添加进场。");
    g_tipLine[7217] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("使用自己的能力杀死了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("会得知哪名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名并处决") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("时，");
    g_tipLine[7218] = StringToText("  不算做使用自己的能力杀死") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("使用能力杀死") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，例如") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("，也不会计算在内。");
    g_tipLine[7219] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("但未能将其杀死，") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("不会得知") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("是谁。");
    g_tipLine[7220] = StringToText("· ") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("得知的是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的具体玩家，但不得知具体角色。");
    g_tipLine[7221] = StringToText("【规则细节】");
    g_tipLine[7222] = StringToText("在进行游戏设置，将角色标记放进盲抽袋之前，如果") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("不在即将要放入盲抽袋的这些角色之中，");
    g_tipLine[7223] = StringToText("  那么移除一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色标记，并加入") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7224] = StringToText("除首个夜晚之外的每个夜晚，如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("国王"), Color(0, 191, 255)) + StringToText("，在让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("重新入睡后唤醒") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7225] = StringToText("  对他指向一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家。然后让") + TextWithColor(StringToText("唱诗男孩"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7226] = StringToText("【角色能力】");
    g_tipLine[7227] = StringToText("在你的首个夜晚，你会得知距离最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家位于你的顺时针还是逆时针方向。");
    g_tipLine[7228] = StringToText("  如果两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与你距离相等，你得知的信息由说书人决定。");
    g_tipLine[7229] = StringToText("【角色简介】");
    g_tipLine[7230] = TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("会倾向于信任位于他某一侧的玩家。");
    g_tipLine[7231] = StringToText("· 距离最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，就是与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间坐着的玩家数量最少的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[7232] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("顺时针方向上最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间的玩家数量，等同于") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("逆时针方向上最近的");
    g_tipLine[7233] = StringToText("  ") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("之间的玩家数量，那么就是“") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与他的距离相等”。");
    g_tipLine[7234] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("两侧的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与他的距离相等，由说书人来决定向") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("给出什么样的信息。");
    g_tipLine[7235] = StringToText("  说书人可以决定") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("会得知的信息是顺时针还是逆时针。");
    g_tipLine[7236] = StringToText("· ") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("不会知道他所得知的信息是真实结果，还是由说书人决定的结果。");
    g_tipLine[7237] = StringToText("· ") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("不会得知他与最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家之间的具体距离。");
    g_tipLine[7238] = StringToText("· 如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，那么他会在当晚被唤醒并获得信息。");
    g_tipLine[7239] = StringToText("· 说书人与") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("关于信息的交流方式可以是用手指指向与他信息相符的方向，");
    g_tipLine[7240] = StringToText("  或是其他提前商定一致的信息方式。");
    g_tipLine[7241] = StringToText("【规则细节】");
    g_tipLine[7242] = StringToText("在首个夜晚，唤醒") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("。用手指水平指向") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("的某一侧，告诉他与他距离最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家位于这一侧。");
    g_tipLine[7243] = StringToText("  如果") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("两侧最近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家与他的距离相等，由你来决定告诉他什么样的信息，");
    g_tipLine[7244] = StringToText("  并用手指指向对应的一侧。让") + TextWithColor(StringToText("修行者"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7245] = StringToText("【角色能力】");
    g_tipLine[7246] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[7247] = StringToText("【角色简介】");
    g_tipLine[7248] = TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("精通望闻问切，能够通过他人的面相进行初步的推测。");
    g_tipLine[7249] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("都需要选择一名除自己以外的玩家。他会得知一个与该玩家能力相关的词语。");
    g_tipLine[7250] = StringToText("  说书人会将词语写在纸上，或通过能够记录词语的电子设备，向") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("提供这个词语信息。");
    g_tipLine[7251] = StringToText("  （就像") + TextWithColor(StringToText("灵言师"), Color(255, 69, 0)) + StringToText("得知关键词一样。）");
    g_tipLine[7252] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("得知的词语可能来自于那个玩家角色能力描述中的某个词，如“夜晚”、“死亡”、“公开”等；");
    g_tipLine[7253] = StringToText("  也可以是说书人对该玩家能力的某种概括性描述，如“勇敢”、“牺牲”等。");
    g_tipLine[7254] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("每次只会得知一个词语。通常来说这是一个2-4字的词语（或是一个英文单词），");
    g_tipLine[7255] = StringToText("  这个词是有明确含义的，不能是无法组成词语的字拼接在一起。");
    g_tipLine[7256] = StringToText("· ") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("可以连续多个夜晚选择同一名玩家。") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("可以选择已死亡的玩家。") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("不能选择自己。");
    g_tipLine[7257] = StringToText("【规则细节】");
    g_tipLine[7258] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("。让他指向任意一名除自己以外的玩家。将该玩家的能力相关的一个词语以纸条或电子设");
    g_tipLine[7259] = StringToText("  备等形式告知给") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("。然后让") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7260] = StringToText("建议在游戏早期时尽量向") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("提供模糊的词语，避免") + TextWithColor(StringToText("郎中"), Color(0, 191, 255)) + StringToText("迅速确定对方的具体角色，");
    g_tipLine[7261] = StringToText("  从而为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营积累大量的优势。");
    g_tipLine[7262] = StringToText("【角色能力】");
    g_tipLine[7263] = StringToText("每个白天，如果你“疯狂”地证明自己是一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色（与之前不同），你可能会在当晚获得那个角色的能力，");
    g_tipLine[7264] = StringToText("  直到下个黄昏。");
    g_tipLine[7265] = StringToText("【角色简介】");
    g_tipLine[7266] = TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("擅长在万千样貌中变化自如。");
    g_tipLine[7267] = StringToText("· 如果") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("疯狂证明自己是一个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色，他就可能会在当晚获得那个角色的能力。");
    g_tipLine[7268] = StringToText("· 每当") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("获得一项能力时，那项能力会持续到下个黄昏。");
    g_tipLine[7269] = StringToText("· ") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("无法多次获得同一个角色的能力。");
    g_tipLine[7270] = StringToText("· ") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("可以连续多天疯狂证明自己是同一个角色，随后在接下来的一天证明自己是其他角色。");
    g_tipLine[7271] = StringToText("  每次在决定") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("是否能够获得能力时，只会参考") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("当天白天的言论。");
    g_tipLine[7272] = StringToText("  只要他这一天疯狂证明的角色与他之前曾经证明过且获得能力的角色不同，");
    g_tipLine[7273] = StringToText("  他就可能会获得这个角色的能力。");
    g_tipLine[7274] = StringToText("· 部分角色能力跨度时间与") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("获得能力的时间可能会不匹配。（如") + TextWithColor(StringToText("杂耍艺人"), Color(0, 191, 255)) + StringToText("、歌伶等。）");
    g_tipLine[7275] = StringToText("  这些角色的能力在") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("疯狂证明时便可立即获得，无需等到夜晚。");
    g_tipLine[7276] = StringToText("【规则细节】");
    g_tipLine[7277] = StringToText("如果") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("在某个白天“疯狂”地证明了自己是某个角色列表上的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色，");
    g_tipLine[7278] = StringToText("  且他此前未曾获得过这个") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色的能力，那么从当晚起到下一个黄昏结束，");
    g_tipLine[7279] = StringToText("  ") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("可能会获得那个角色的能力。");
    g_tipLine[7280] = StringToText("如果说书人决定让") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("获得能力，在当晚将") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("角色标记更换为他获得能力的角色标记，");
    g_tipLine[7281] = StringToText("  并放置“是") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("”提示标记。");
    g_tipLine[7282] = StringToText("对") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("来说，合理的证明需要否定此前自己曾疯狂证明过的角色，并给出充足的“为什么伪装成之前的那个");
    g_tipLine[7283] = StringToText("  角色”的理由。因此通常来说，让") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("在一局游戏中获得1-2次能力是比较合适的。当然，");
    g_tipLine[7284] = StringToText("  如果形势特殊，说书人也可以让") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("多次获得能力，作为对") + TextWithColor(StringToText("变脸师"), Color(0, 191, 255)) + StringToText("卖力“表演”的奖励。");
    g_tipLine[7285] = StringToText("【角色能力】");
    g_tipLine[7286] = StringToText("在你的首个夜晚，你会得知两名非") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家。");
    g_tipLine[7287] = StringToText("【角色简介】");
    g_tipLine[7288] = TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("会得知角色不为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的玩家。");
    g_tipLine[7289] = StringToText("· 在") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("的首个夜晚，他会得知两名玩家，这两名玩家的角色都不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[7290] = StringToText("· 在随后的夜晚，") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("不会得知更多的信息。");
    g_tipLine[7291] = StringToText("· ") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("得知的玩家可以是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("甚至") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，但") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("不会知道他所得知的玩家的具体角色类型。");
    g_tipLine[7292] = StringToText("【规则细节】");
    g_tipLine[7293] = StringToText("在为首个夜晚进行准备时，将") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("的“得知”提示标记放置在任意两名非") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家的角色标记旁。");
    g_tipLine[7294] = StringToText("在首个夜晚，唤醒") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("，并指向标记有“得知”的两名玩家。让") + TextWithColor(StringToText("骑士"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7295] = StringToText("【角色能力】");
    g_tipLine[7296] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[7297] = StringToText("【角色简介】");
    g_tipLine[7298] = TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("凭借直觉行事。");
    g_tipLine[7299] = StringToText("· ") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("可以连续几个夜晚得知同一名玩家，也可以在每个夜晚都得知不同的玩家。");
    g_tipLine[7300] = StringToText("· 她得知的玩家可以是存活玩家，也可以是死亡玩家。");
    g_tipLine[7301] = StringToText("· 她得知的玩家可以是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，也可以是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家。");
    g_tipLine[7302] = StringToText("· 没有绝对的标准用于决定说书人究竟要给") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("什么样的信息。说书人通过自己的判断来决定给出") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255));
    g_tipLine[7303] = StringToText("  的信息内容，这取决于他认为给出什么样的信息能够对") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营更加有利。");
    g_tipLine[7304] = StringToText("  这可能是因为某些玩家有重要信息但尚未公布，或是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的伪装一戳即破，");
    g_tipLine[7305] = StringToText("  或是有值得被信赖的玩家需要建立更强的信任，或是有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的推理出现了谬误，急需被纠正，");
    g_tipLine[7306] = StringToText("  或是其他各种各样的原因。");
    g_tipLine[7307] = StringToText("【规则细节】");
    g_tipLine[7308] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("。指向一名玩家。随后让") + TextWithColor(StringToText("女祭司"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7309] = StringToText("【角色能力】");
    g_tipLine[7310] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，你死亡。");
    g_tipLine[7311] = StringToText("【角色简介】");
    g_tipLine[7312] = TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("会在找到") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的玩家时死亡。");
    g_tipLine[7313] = StringToText("· 除首个夜晚之外的每个夜晚，") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("要选择一名玩家。如果该玩家在当晚保持清醒健康，");
    g_tipLine[7314] = StringToText("  什么也不会发生；如果该玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("就会死亡。");
    g_tipLine[7315] = StringToText("· 如果") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("自己") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，则不会因自身能力而死亡。");
    g_tipLine[7316] = StringToText("· ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("可以选择任何玩家——无论存活还是死亡的玩家，也可以选择自己。");
    g_tipLine[7317] = StringToText("· 如果") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("选择的玩家在被选择时是清醒健康的，但在夜晚稍后阶段") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，");
    g_tipLine[7318] = StringToText("  ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("仍会死亡。");
    g_tipLine[7319] = StringToText("· ") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("不会得知所选玩家是") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("、") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，还是两者皆有。");
    g_tipLine[7320] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("（Drunk）会被") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("（drunk）（双关）。");
    g_tipLine[7321] = StringToText("【规则细节】");
    g_tipLine[7322] = StringToText("除首个夜晚以外的每个夜晚，唤醒") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("。让") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("指向一名玩家。将“被选择”提示标记放置到所选玩");
    g_tipLine[7323] = StringToText("  家的角色标记旁。让") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7324] = StringToText("如果被选择的玩家在当晚任何时刻") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("死亡——在") + TextWithColor(StringToText("杂技演员"), Color(0, 191, 255)) + StringToText("的角色标记旁放置“死亡”提示");
    g_tipLine[7325] = StringToText("  标记并放置帷幕标记。");
    g_tipLine[7326] = StringToText("【角色能力】");
    g_tipLine[7327] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[7328] = StringToText("【角色简介】");
    g_tipLine[7329] = TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会得知一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。");
    g_tipLine[7330] = StringToText("· ") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("得知的是玩家，但不得知他的具体角色。");
    g_tipLine[7331] = StringToText("· ") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会在首个夜晚得知他的信息。");
    g_tipLine[7332] = StringToText("· 如果") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("会在当晚得知信息。");
    g_tipLine[7333] = StringToText("【规则细节】");
    g_tipLine[7334] = StringToText("在为首个夜晚进行准备时，将") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("的“得知”提示标记放置在任意一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的角色标记旁。");
    g_tipLine[7335] = StringToText("在首个夜晚，唤醒") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("，并指向标记有“得知”的那名玩家。让") + TextWithColor(StringToText("事务官"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7336] = StringToText("【角色能力】");
    g_tipLine[7337] = StringToText("每个夜晚，你要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[7338] = StringToText("【角色简介】");
    g_tipLine[7339] = TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("顽皮捣蛋，会让特定的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色产生错误信息。");
    g_tipLine[7340] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("需要选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。如果这个角色在场，对应玩家会被") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响，");
    g_tipLine[7341] = StringToText("  在下个黄昏之前均会产生错误信息。");
    g_tipLine[7342] = StringToText("· 受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力影响的玩家如果") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，仍然不会让其他玩家获得信息，因为他已经失去能力。");
    g_tipLine[7343] = StringToText("  然而他在获得因自己的能力而得知的信息时，也会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响而必定获得错误信息。");
    g_tipLine[7344] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("不会影响这名玩家通过其他方式获得的信息，例如说书人的规则解释，他自身的角色/阵营，");
    g_tipLine[7345] = StringToText("  或是由其他玩家的能力使他得知的信息。");
    g_tipLine[7346] = StringToText("· ") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("影响的是具体角色所对应的玩家。仅仅是拥有这个角色能力，但实际角色并非") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色的");
    g_tipLine[7347] = StringToText("  玩家，不会受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("能力的影响。");
    g_tipLine[7348] = StringToText("· 如果") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("选择的角色当前不在场，但随后在场了，这个角色所对应的玩家仍然要受到") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("的能力影响。");
    g_tipLine[7349] = StringToText("【规则细节】");
    g_tipLine[7350] = StringToText("每个夜晚，唤醒") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("，让他指向角色列表上的一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色图标。让") + TextWithColor(StringToText("熊孩子"), Color(0, 191, 255)) + StringToText("重新入睡。");
    g_tipLine[7351] = StringToText("如果他指向的角色在场，在对应的角色标记旁放置“捣蛋”提示标记。");
    g_tipLine[7352] = StringToText("如果放置了“捣蛋”提示标记的玩家，其自身角色能力将要产生信息时，改为产生错误信息。");
    g_tipLine[7353] = StringToText("在下个黄昏时，移除“捣蛋”提示标记。");
    g_tipLine[7887] = StringToText("【角色能力】");
    g_tipLine[7888] = StringToText("在你的首个夜晚，你会得知两名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家。他们之中会有一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使你已死亡。");
    g_tipLine[7889] = StringToText("【角色简介】");
    g_tipLine[7890] = TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("对他店里的顾客非常熟悉，但也为某些酒量不高的顾客感到焦虑。");
    g_tipLine[7891] = StringToText("· 在首个夜晚，") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("会得知两名玩家，这两名玩家都属于") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。");
    g_tipLine[7892] = StringToText("· ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("所得知的两名玩家之中，会有一名玩家始终") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("，即使") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("已经死亡。");
    g_tipLine[7893] = StringToText("· 如果") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("在游戏中途被创造，他会在当晚得知两名玩家，且他得知的这两名玩家之中会有一名玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7894] = StringToText("· 如果已经死亡的玩家变成了") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("，他不会得知任何信息，但仍然会让一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7895] = StringToText("【规则细节】");
    g_tipLine[7896] = StringToText("· 如果") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("因为其他角色的能力") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，或受到") + TextWithColor(StringToText("涡流"), Color(0, 191, 255)) + StringToText("效果影响，使得") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("得知了错误信息，");
    g_tipLine[7897] = StringToText("  ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("仍然会让他所得知的两名玩家之中的一人") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("（如果是") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("导致的错误信息则需要");
    g_tipLine[7898] = StringToText("  ") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("恢复健康清醒后）。这可能会因此导致") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。然而，如果他得知的玩家中存在") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，");
    g_tipLine[7899] = StringToText("  说书人都应该倾向于让") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7900] = StringToText("· 在") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("后，他所得知的玩家可能会发生变化。为了避免他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的目标进行改变，");
    g_tipLine[7901] = StringToText("  说书人应该只调整") + TextWithColor(StringToText("店小二"), Color(0, 191, 255)) + StringToText("所得知的消息中，没有") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("的那一名玩家。");
    g_tipLine[7902] = StringToText("【角色能力】");
    g_tipLine[7903] = StringToText("你以为你是一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，但你实际上不是。如果有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了你，");
    g_tipLine[7904] = StringToText("  你会立即变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[7905] = StringToText("【角色简介】");
    g_tipLine[7906] = TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("误以为自己置身事外，然而当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("睥睨时，他才终于醒悟：没有任何人可以置身事外。");
    g_tipLine[7907] = StringToText("· 在游戏设置时，如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("作为出场角色，则将") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("角色标记移除，");
    g_tipLine[7908] = StringToText("  并增加一个未出场的任意") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，然后再让玩家随机抽取角色。");
    g_tipLine[7909] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("不具有自己以为的那个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的角色能力。");
    g_tipLine[7910] = StringToText("· 当") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响时，在相关的效果生效前，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会先改变角色，");
    g_tipLine[7911] = StringToText("  变成一个不在场的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[7912] = StringToText("· 如果") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化发生在白天，那么说书人会在当晚所有玩家闭眼后，");
    g_tipLine[7913] = StringToText("  第一时间唤醒") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("并告知他相关的角色变化。");
    g_tipLine[7914] = StringToText("· 在") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的角色变化后，如果他随即受到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的此次能力效果影响，使得他再次变化角色，");
    g_tipLine[7915] = StringToText("  那么说书人只会告知他最终的变化结果。");
    g_tipLine[7916] = StringToText("【规则细节】");
    g_tipLine[7917] = StringToText("· ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力需要让他认为自己是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，因此") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("无法认为自己是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[7918] = StringToText("  因为这两个角色不会作为角色标记发给玩家。（即使") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("的规则允许让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("角色标记，");
    g_tipLine[7919] = StringToText("  那也仅代表玩家在作为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记，而非在作为") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("时可以抽取到") + TextWithColor(StringToText("疯子"), Color(0, 191, 255)) + StringToText("标记。）");
    g_tipLine[7920] = StringToText("· 特定角色互动：");
    g_tipLine[7921] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为邻座，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会直接") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，不会发生角色变化。");
    g_tipLine[7922] = StringToText("  如果在游戏过程中有玩家变成了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("且") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("为与他邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[7923] = StringToText("  ") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("会正常发生角色变化。");
    g_tipLine[7924] = StringToText("· 相克规则：");
    g_tipLine[7925] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("产生了错误信息或“能力未正常生效”。");
    g_tipLine[7926] = StringToText("· ") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("在场数量不足3人，") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("可以变成新的") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("。如果因此使得") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + StringToText("的在场数量超过1人，");
    g_tipLine[7927] = StringToText("  会有一名") + TextWithColor(StringToText("村夫"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7928] = StringToText("· ") + TextWithColor(StringToText("科学怪人"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("无法拥有") + TextWithColor(StringToText("悟道者"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[7929] = StringToText("【角色能力】");
    g_tipLine[7930] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，你死亡，然后他") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("直到下个黎明。");
    g_tipLine[7931] = StringToText("【角色简介】");
    g_tipLine[7932] = TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会不断地寻找") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，令其短暂失去能力，并以自身死亡作为代价。");
    g_tipLine[7933] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，如果那名玩家不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("依然存活。");
    g_tipLine[7934] = StringToText("  当选中一名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家时，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("死亡，然后那名") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家在当晚") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7935] = StringToText("· ") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("只会维持到天亮前，天亮后") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家不再") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7936] = StringToText("· 如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("的死亡由于某些原因被阻止，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家当晚不会") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7937] = StringToText("【规则细节】");
    g_tipLine[7938] = StringToText("· 特定角色互动：");
    g_tipLine[7939] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("选中了照顾") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的玩家，") + TextWithColor(StringToText("道士"), Color(0, 191, 255)) + StringToText("会死亡，该玩家") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7940] = StringToText("  ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("的能力不会受到任何影响。");
    g_tipLine[7941] = StringToText("【角色能力】");
    g_tipLine[7942] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：如果他在场，他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[7943] = StringToText("【角色简介】");
    g_tipLine[7944] = StringToText("鸩可以冒着某个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("死亡的风险来确认该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("是否在场。");
    g_tipLine[7945] = StringToText("· 每局游戏限一次，除首个夜晚以外的其他夜晚，鸩可以选择一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，如果那个角色在场，");
    g_tipLine[7946] = StringToText("  该角色对应的玩家会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[7947] = StringToText("· 如果鸩选择了一个不在场的角色，不会有任何玩家受到鸩的影响，即使之后被选择的角色在场了，");
    g_tipLine[7948] = StringToText("  他也不会受到鸩的影响。");
    g_tipLine[7949] = StringToText("· 如果某个角色有多名玩家在场，且鸩选择了这个角色，只会有一名玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[7950] = StringToText("【规则细节】");
    g_tipLine[7951] = StringToText("· 如果鸩选择了自己，他会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("但不会死亡。因为鸩先让自己") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("失去了能力，");
    g_tipLine[7952] = StringToText("  所以通常情况下鸩不会死于自己的能力。（特殊情况下，鸩可以死于自己的能力，");
    g_tipLine[7953] = StringToText("  比如咖啡师的效果1对鸩生效。）");
    g_tipLine[7954] = StringToText("· 相克规则：");
    g_tipLine[7955] = StringToText("· ") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("罂粟种植者"), Color(0, 191, 255)) + StringToText("不会因为鸩的能力") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[7956] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[7957] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[7958] = StringToText("【角色能力】");
    g_tipLine[7959] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响了他们之中的");
    g_tipLine[7960] = StringToText("  玩家。");
    g_tipLine[7961] = StringToText("【角色简介】");
    g_tipLine[7962] = TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("能够得知夜晚是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("作祟，侵扰玩家。");
    g_tipLine[7963] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("都可以选择一至三名玩家，但不能不进行选择，也不能选择自己。");
    g_tipLine[7964] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中没有在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择或影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知“否”。");
    g_tipLine[7965] = StringToText("· 如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择的玩家中在当晚被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响，") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知“是”。");
    g_tipLine[7966] = StringToText("  如果") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("选择了超过一名玩家，他不会得知是具体哪名玩家被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家能力选择或者影响了。");
    g_tipLine[7967] = StringToText("· 不仅") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("、") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("能力会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("能力也会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[7968] = StringToText("【规则细节】");
    g_tipLine[7969] = StringToText("“影响”的范围包括：改变该玩家的状态（角色、阵营等），对该玩家的能力造成了妨害效果（互动干扰、");
    g_tipLine[7970] = StringToText("  能力效果干扰、阻止能力生效等），等等。暴露角色、让他人获取信息等能力不在“影响”的范围内。");
    g_tipLine[7971] = StringToText("与“保护”类似，如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家执行了") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家的能力产生选择或影响，同样会被") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("探查。");
    g_tipLine[7972] = StringToText("· 特定角色互动：");
    g_tipLine[7973] = StringToText("· ") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("：如果一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家照顾了") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("，当晚因") + TextWithColor(StringToText("小怪宝"), Color(0, 191, 255)) + StringToText("能力死亡的玩家算作被") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力影响了。");
    g_tipLine[7974] = StringToText("· 相克规则：");
    g_tipLine[7975] = StringToText("· ") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("是否醒来，即使她是在") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[7976] = StringToText("· ") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("引路人"), Color(0, 191, 255)) + StringToText("会得知") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("是否被影响，即使他是在") + TextWithColor(StringToText("数学家"), Color(0, 191, 255)) + StringToText("之前醒来。");
    g_tipLine[7977] = StringToText("【角色能力】");
    g_tipLine[7978] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为替代。");
    g_tipLine[7979] = StringToText("【角色简介】");
    g_tipLine[7980] = TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("精通各种怪力乱神之术，能够将对他潜在的威胁转移到邪祟之人的身上。");
    g_tipLine[7981] = StringToText("· 在夜晚时，任何使用自身能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家，在其能力生效前，选择的目标会暗中转移到一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家");
    g_tipLine[7982] = StringToText("  的身上。随后，这项能力效果会以那名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家作为新的目标来进行结算。");
    g_tipLine[7983] = StringToText("· 使用能力选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的玩家不会得知自己的选择目标被更改，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力被触发。");
    g_tipLine[7984] = StringToText("· 只有需要做出选择的能力才能被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[7985] = StringToText("· 在一项能力更换目标后，无需重新进行选择限制条件的判断。") + TextWithColor(StringToText("舞蛇人"), Color(0, 191, 255)) + StringToText("的选择目标可能会因此改为已经死亡");
    g_tipLine[7986] = StringToText("  的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("的选择目标可能会改为选中自己。");
    g_tipLine[7987] = StringToText("· 在一项能力更换目标后，需要重新进行能力效果中触发条件的判断。") + TextWithColor(StringToText("传教士"), Color(0, 191, 255)) + StringToText("因为") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("而改为选中") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("时，");
    g_tipLine[7988] = StringToText("  不会让") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("失去能力，因为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("是不同的角色类型。");
    g_tipLine[7989] = StringToText("· 一项能力在更换选择目标后，能力自身与选择相关的内容不会因此发生变更，");
    g_tipLine[7990] = StringToText("  依然以玩家自身做出的选择作为判断基准。") + TextWithColor(StringToText("魔鬼代言人"), Color(0, 191, 255)) + StringToText("在选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("后导致目标转移，");
    g_tipLine[7991] = StringToText("  他在第二晚无法选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，而不是无法选择转移后的目标。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在选择主人时目标被变更，");
    g_tipLine[7992] = StringToText("  ") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在下个白天投票时仍然需要参考他昨晚选择的那名玩家的投票意见，不会受到影响。");
    g_tipLine[7993] = StringToText("· 如果一项能力需要玩家选择多个目标，而") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("成为了目标之一，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("只会将自己更改为一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，");
    g_tipLine[7994] = StringToText("  不会使得玩家的其他目标发生变化。") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("也不会让一项能力的多个目标中重复选择同一名玩家。");
    g_tipLine[7995] = StringToText("  如果此时没有其他合法的目标可以转移选择，那么") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("仍然会受到原本能力效果的影响。");
    g_tipLine[7996] = StringToText("· 一项能力中的某个选择目标至多只能被转移一次。也就是说，被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后的目标，");
    g_tipLine[7997] = StringToText("  无法受到") + TextWithColor(StringToText("使节"), Color(0, 191, 255)) + StringToText("的影响使得目标再次转移。");
    g_tipLine[7998] = StringToText("· ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚被触发。在白天时，他的能力不会产生任何效果。");
    g_tipLine[7999] = StringToText("【规则细节】");
    g_tipLine[8000] = StringToText("· 特定角色互动：");
    g_tipLine[8001] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会直接死亡，并且不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家身上。");
    g_tipLine[8002] = StringToText("· ") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("：如果") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，是否播报能力取决于") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移结果的玩家是否与") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("之前的选");
    g_tipLine[8003] = StringToText("  择发生了变化。被") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("转移后，") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("的能力只会对转移后的目标生效（从某种意义上来说，");
    g_tipLine[8004] = StringToText("  也算是无效了，因为") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("的能力此时只能让") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营落败）。") + TextWithColor(StringToText("恐惧之灵"), Color(255, 69, 0)) + StringToText("需要通过播报与否来判断自己");
    g_tipLine[8005] = StringToText("  是否选中了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[8006] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("为邻座，且有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，在") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力生效前，");
    g_tipLine[8007] = StringToText("  ") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会先将选择目标转移，从而使得") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家既不会选择") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("为目标，也不会影响") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[8008] = StringToText("  因此不会触发") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力。反之，如果") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("将") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的选择转移到与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，");
    g_tipLine[8009] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力就会因此被触发。");
    g_tipLine[8010] = StringToText("· 相克规则：");
    g_tipLine[8011] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipLine[8012] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[8013] = StringToText("· 鸩：如果鸩选择了") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("半仙"), Color(0, 191, 255)) + StringToText("会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("并死亡。");
    g_tipLine[8014] = StringToText("【角色能力】");
    g_tipLine[8015] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[8016] = StringToText("  改为选中另一名玩家。");
    g_tipLine[8017] = StringToText("【角色简介】");
    g_tipLine[8018] = TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("促成两名阵营相同的玩家的合作，使得其他玩家的选择被转换。");
    g_tipLine[8019] = StringToText("· 在夜晚时，") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家如果阵营相同，任何玩家使用自身能力选择他们之一时，");
    g_tipLine[8020] = StringToText("  在其能力生效前，选择的目标会转移到另一名玩家的身上。随后，这项能力效果会以另一名玩家作为新的");
    g_tipLine[8021] = StringToText("  目标来结算。");
    g_tipLine[8022] = StringToText("· 如果") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的两名存活玩家阵营不相同，那么，任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[8023] = StringToText("  不会发生转移。");
    g_tipLine[8024] = StringToText("· 使用能力被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标的玩家不会得知自己的选择目标被更换。") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("也不会得知是否有玩家因此被转移");
    g_tipLine[8025] = StringToText("  了选择的目标。");
    g_tipLine[8026] = StringToText("· 只有需要玩家做出选择的能力才能被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。无需进行选择的能力，无法被") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("转移目标。");
    g_tipLine[8027] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("的能力只会在夜晚生效。在白天时，他的能力不会产生任何效果。");
    g_tipLine[8028] = StringToText("【规则细节】");
    g_tipLine[8029] = StringToText("· ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会持续检测被选择的玩家的阵营，一旦他们当中出现了阵营变化导致这两名玩家阵营不同，");
    g_tipLine[8030] = StringToText("  ") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("会立即失去对这两名玩家更换选择目标的能力。");
    g_tipLine[8031] = StringToText("· 更多规则与细节详情请查看更换选择目标。");
    g_tipLine[8032] = StringToText("· 特定角色互动：");
    g_tipLine[8033] = StringToText("· ") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("：如果") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("攻击了") + TextWithColor(StringToText("掮客"), Color(0, 191, 255)) + StringToText("选择的玩家，那名玩家会直接死亡，并不会将") + TextWithColor(StringToText("刺客"), Color(0, 191, 255)) + StringToText("的效果转移到另一名玩家身");
    g_tipLine[8034] = StringToText("  上。");
    g_tipLine[8035] = StringToText("· 相克规则：");
    g_tipLine[8036] = StringToText("· ") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("：") + TextWithColor(StringToText("痢蛭"), Color(255, 0, 0)) + StringToText("的宿主及其") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("效果无法被转移。");
    g_tipLine[8037] = StringToText("【角色能力】");
    g_tipLine[8038] = StringToText("每个夜晚，当有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎");
    g_tipLine[8039] = StringToText("  明，且你会得知你的能力被触发。");
    g_tipLine[8040] = StringToText("【角色简介】");
    g_tipLine[8041] = TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("慈悲为怀，一视同仁地庇护着他周围的人。");
    g_tipLine[8042] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在每个夜晚都能且仅能触发一次。");
    g_tipLine[8043] = StringToText("· 当") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力选择了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家，或者一项无需选择的能力在满足了条件而被触发，");
    g_tipLine[8044] = StringToText("  且会对与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的存活玩家生效时，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家此次的能力不生效。");
    g_tipLine[8045] = StringToText("  这一效果跟使这名玩家“") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("/") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + StringToText("”相似。然而，如果某名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家在同一个夜晚可以多次行动，");
    g_tipLine[8046] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能使其中一次效果无效，而除此以外的其他效果仍然会正常生效。");
    g_tipLine[8047] = StringToText("· 如果") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力是一项持续生效的能力，而非选择式或触发式的能力，");
    g_tipLine[8048] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会使这项能力失效直至下个黎明。在下一个白天时，这项能力会再次生效。");
    g_tipLine[8049] = StringToText("· ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("只能在一项能力开始生效前阻止这项能力。他无法阻止已经生效的能力。");
    g_tipLine[8050] = StringToText("· 一旦") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力被成功触发，他会被唤醒，并得知自己的能力刚刚被触发了。");
    g_tipLine[8051] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("不会得知是哪名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力被他阻止了，也不会得知这项能力影响的是与他邻近的哪一名玩家。");
    g_tipLine[8052] = StringToText("  他只是单纯知道自己的能力被触发了。");
    g_tipLine[8053] = StringToText("· 如果一项") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的能力无法被阻止，那么") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力不会因此被触发，");
    g_tipLine[8054] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("也不会得知自己的能力触发了。");
    g_tipLine[8055] = StringToText("【规则细节】");
    g_tipLine[8056] = StringToText("· 如果") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力使得一项“玩家让自身获得信息”的能力失效，其处理方式与") + TextWithColor(StringToText("醉酒"), Color(128, 0, 128)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("相似，");
    g_tipLine[8057] = StringToText("  该玩家仍然会获得信息，但信息可对可错。");
    g_tipLine[8058] = StringToText("· 特定角色互动：");
    g_tipLine[8059] = StringToText("· ") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("：如果在游戏开始时，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("影响了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，");
    g_tipLine[8060] = StringToText("  ") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力在首个夜晚不会触发。如果") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("在游戏中途的某个夜晚被创造并将要影响与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的");
    g_tipLine[8061] = StringToText("  ") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("的能力会被触发，") + TextWithColor(StringToText("诺-达鲺"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("能力（包括让另一侧的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("）");
    g_tipLine[8062] = StringToText("  会在下个黎明才开始生效。");
    g_tipLine[8063] = StringToText("· 限：如果限的能力让所有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[8064] = StringToText("· ") + TextWithColor(StringToText("混沌"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("混沌"), Color(255, 0, 0)) + StringToText("的能力让所有") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，（") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的）") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("会因") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("而无法触发能力。");
    g_tipLine[8065] = StringToText("· 相克规则：");
    g_tipLine[8066] = StringToText("· ") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("利维坦"), Color(255, 0, 0)) + StringToText("提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[8067] = StringToText("· 暴乱：如果暴乱提名并处决了与") + TextWithColor(StringToText("和尚"), Color(0, 191, 255)) + StringToText("邻近的其中一名存活玩家，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    BOTC_ApplyRoleTipsAll();
}

//--------------------------------------------------------------------------------------------------
// 【角色能力类别 · 查询层】（用户 2026-11-06）
//   数据来自钟楼百科「角色能力类别总览」，在 BOTC_GrimInitData() 里初始化；
//   只供后续功能按标签查询，不参与任何既有阵营 / 信息分类判定。
//--------------------------------------------------------------------------------------------------
void BOTC_AbilCatMark (int r, int c) {
    if (r < 0 || r > 163) { return; }
    if (c < 0 || c >= 31) { return; }
    g_roleAbilCat[(r * 31) + c] = true;
}

bool BOTC_RoleHasAbilCat (int r, int c) {
    if (r < 0 || r > 163) { return false; }
    if (c < 0 || c >= g_abilCatN) { return false; }
    return g_roleAbilCat[(r * 31) + c];
}

int BOTC_RoleAbilCatN (int r) {
    int i;
    int n;

    n = 0;
    if (r < 0 || r > 163) { return 0; }
    for (i = 0; i < g_abilCatN; i += 1) {
        if (g_roleAbilCat[(r * 31) + i]) {
            n += 1;
        }
    }
    return n;
}

int BOTC_AbilCatRoleN (int c) {
    int i;
    int n;

    n = 0;
    if (c < 0 || c >= g_abilCatN) { return 0; }
    for (i = 0; i <= 163; i += 1) {
        if (g_roleAbilCat[(i * 31) + c]) {
            n += 1;
        }
    }
    return n;
}

string BOTC_RoleAbilCatText (int r) {
    int i;
    string s;

    s = "";
    if (r < 0 || r > 163) { return s; }
    for (i = 0; i < g_abilCatN; i += 1) {
        if (g_roleAbilCat[(r * 31) + i]) {
            if (s != "") {
                s = s + ",";
            }
            s = s + g_abilCatName[i];
        }
    }
    return s;
}

