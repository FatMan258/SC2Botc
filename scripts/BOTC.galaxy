        libNtve_gf_SetDialogItemImage(g_grimIcon[q], "botc_blank.dds", PlayerGroupAll());
        // 死亡红叉层：压在身份图上面（默认隐藏，位置随圆桌摆位一起走）
        libNtve_gf_CreateDialogItemImage(g_grimDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_grimDead[q] = DialogControlLastCreated();
        DialogControlSetPosition(g_grimDead[q], PlayerGroupAll(), c_anchorTopLeft, g_seatX[i] - 58, g_seatY[i] - 61);
        libNtve_gf_SetDialogItemAcceptMouse(g_grimDead[q], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_grimDead[q], "botc_exec.dds", PlayerGroupAll());
        DialogControlSetVisible(g_grimDead[q], PlayerGroupAll(), false);
        // 名字那一行（头像下方、居中）：编号 + [玩家名]
        g_grimName[q] = BOTC_NewLabelC(g_grimDlg, 112, 26, g_seatX[i] - 56, g_seatY[i] + 31, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_grimName[q], g_grimNameStyle, PlayerGroupAll());
