    libNtve_gf_SetDialogItemStyle(g_tmHideBtn, "ModLeftSize16Bold", PlayerGroupAll());
    // 说明文字挪到「秒数」下面
    g_tmTitle = BOTC_NewLabel(g_tmDlg, 224, 24, 10, 78, StringToText("时段计时（填秒数）"));
    libNtve_gf_SetDialogItemStyle(g_tmTitle, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_tmTitle, false, PlayerGroupAll());
    // 【取消手动切换时段】（用户 2026-11-01）：计时器自动跟着当前公聊 / 私聊阶段
