    }
    cp = g_who[p];
    g_pickMode[cp] = 43;
    g_pickWho[cp] = p;
    g_pickTeam = 0;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个镇民角色"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

bool BOTC_PedantInPlay () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_seatOn[q] && BOTC_HasAbility(q, 152)) {
            return true;
        }
    }
    return false;
}

void BOTC_PedantDealInfo () {
    int q;
    int lu;
    if (!BOTC_PedantInPlay()) {
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !BOTC_IsDemonSeat(q)) {
            continue;
        }
        BOTC_PmInfo(g_who[q], "【信息】你得知书生在场。");
        BOTC_PmStore(g_teller, "【书生】首夜已告诉 " + BOTC_NameStr(q) + "：「你得知书生在场。」");
    }
    // 【书生 × 疯子】（用户 2026-11-01）：恶魔得知「书生在场」之后，由说书人决定是否也告诉疯子。
    lu = BOTC_RealLunaticSeat();
    if (lu >= 2) {
        BOTC_ManInfoOpenSeats(lu, "【书生】要不要也告诉疯子「书生在场」？【确认】= 告诉，【取消】= 不告诉", 16);
    }
}

// 【剧本里有书生但不在场 + 场上有疯子】（用户 2026-11-08）：只问要不要把「书生在场」告诉疯子，不发真恶魔。
