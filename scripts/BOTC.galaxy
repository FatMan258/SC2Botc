int         g_startEvilN;
// 每个「观察者 × 座位」的判定只做一次，之后一直沿用：
//   一个人对另一个人的看法一旦定下来（比如第一天把陌客看成邪恶），后面所有技能看到的都一样
//   下标 = 观察者 * 14 + 座位；  g_pairTeam/g_pairAlign：-1 = 还没判定
//   g_pairSeen：-2 = 还没判定；否则是「登记」那一层看到的身份索引（-1 = 这个座位没身份）
int[196]    g_pairTeam;
int[196]    g_pairAlign;
int[196]    g_pairSeen;
int[196]    g_pairImp;       // 判定时「观察者」是否处于中毒/酒鬼状态：状态变了就重掷
int[196]    g_pairRole;      // 判定时「这个座位」的真身：身份一变（重新发牌 / 传位 / 酒鬼·疯子标记）就重掷
int[196]    g_pairSubImp;   // 判定时「这个座位」是不是中毒 / 酒鬼：间谍 / 陌客的干扰身份一旦失去能力就重掷（用户 2026-09-21）
// 中毒 / 酒鬼「看到的」阵营和身份：在登记之上再叠一层「这次有没有把这个人看错」，
//   同样是「观察者 × 座位」只掷一次 ---- 只对【新查验的座位】掷；
//   已经看错的座位，后面一直按看错的那个样子算（不会下一晚又翻回来）
int[196]    g_pairVTeam;
int[196]    g_pairVAlign;
int[196]    g_pairVSeen;
