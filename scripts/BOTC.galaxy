    g_todoTag[1] = DialogControlLastCreated();
    DialogControlSetSize(g_todoTag[1], PlayerGroupAll(), 108, 31);
    DialogControlSetPosition(g_todoTag[1], PlayerGroupAll(), c_anchorTopLeft, 843, 202);
    libNtve_gf_SetDialogItemAcceptMouse(g_todoTag[1], false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_blank.dds", PlayerGroupAll());
    DialogControlSetVisible(g_todoTag[1], PlayerGroupAll(), true);
    // 【说书人那一格的 token 显示】（用户 2026-11-12）：只显示系统自动放置的标记（如圣洁之魂的
    //   「禁止邪恶」），这一格没有【＋】入口，任何玩家都不能手动给说书人格打 / 撤 token。
    //   摆在说书人格左上方的空白带（y 46~107），避开圆桌右上角的座位和顶部的按钮。
