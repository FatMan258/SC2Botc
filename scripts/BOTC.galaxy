    g_wikiLine[2047] = StringToText("【混沌】：");
    g_wikiLine[2048] = StringToText("调整前：每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，");
