    libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_blank.dds", PlayerGroupAll());
    DialogControlSetVisible(g_todoTag[1], PlayerGroupAll(), true);
    // 魔典正中央：本局板子图（建在座位之前，当作背景层）+ 人数配置文字
    libNtve_gf_CreateDialogItemImage(g_grimDlg, 230, 230, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_boardImg = DialogControlLastCreated();
