    g_jinxText3[128] = "";
    g_jinxA[129] = 137;  g_jinxB[129] = 126;
    g_jinxText[129] = "瘟疫医生与赶尸人：如果说书人本应获得赶尸人的能力，改为一名爪牙获得，且他会得知此事。";
    g_jinxText2[129] = "";
    g_jinxText3[129] = "";
    g_jinxA[130] = 162;  g_jinxB[130] = 95;
    g_jinxText[130] = "蛊雕与炼金术士：炼金术士不能获得蛊雕能力；蛊雕必定在场，并可按炼金术士规则公开猜测蛊雕。";
