// 【黯月初升 · 角色实现 第 5 批】（用户 2026-09-20）：34 弄臣 / 35 修补匠 / 36 月之子
//==================================================================================================

// ■ 弄臣（34）：「你第一次死亡时，你不会死。」（自动生效；用掉之后打「失去能力（弄臣）」）
bool BOTC_FoolSave (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 34)) {
        return false;
    }
    if (g_foolUsed[q]) {
        return false;
    }
    g_foolUsed[q] = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 29] = false;       // 撤掉「首次未死」
    g_tokOn[(((g_teller * 14) + q) * 256) + 46] = true;        // 打上「失去能力（弄臣）」
    BOTC_GrimRender(g_teller);
    return true;
}

// 维护弄臣的两个标记：还留着第一次 → 「首次未死」亮着；用掉了 → 只留「失去能力（弄臣）」
void BOTC_FoolSync () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 34)) {
            continue;
        }
        if (g_foolUsed[i]) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 29]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 29] = false;
            }
        }
        else {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 29]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 29] = true;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

// ■ 修补匠（35）：「你可能随时死亡。」---- 智能说书每晚掷一次（真人说书自己决定）
//   用户 2026-09-20 定的默认：第 1 夜不掷，之后每晚 8%。
void BOTC_TinkerRoll () {
    int i;
    if (g_nightNum <= 1) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 35) || BOTC_SeatDead(i)) {
            continue;
        }
        if (RandomInt(1, 100) <= 8) {
            BOTC_MarkDeathQuietSrc(i, 1, 0, 35);
            BOTC_PmStore(g_teller, "修补匠（" + BOTC_NameStr(i) + "）今晚「随时死亡」掷中了 → 记成死亡（修补匠），天亮公布。");
        }
        else {
            BOTC_PmStore(g_teller, "修补匠（" + BOTC_NameStr(i) + "）今晚没死。");
        }
    }
}

// ■ 月之子（36）：「当你得知自己死亡时，公开选择一名存活玩家：如果他是善良的，他会在今晚死亡。」
//   触发点 = 他的死亡被公开的那一刻（天亮公布 / 白天被处决）。
//   他公开选到的玩家登记为非邪恶（善良）时，天亮由 BOTC_MoonChildResolve() 自动打「死亡（月之子）」token，不再给夜序手动提醒。
// 月之子死了（死亡公开）→ 提醒他自己去声称（用户 2026-09-20：改成玩家自己点，不再由智能说书替他选）
// 【死后声称的当天窗口】（用户 2026-11-11）：月之子 / 呆瓜 只能在自己死亡公开的那一个白天声称 ----
//   白天死亡（处决 / 白天其他死因）：当天、入夜前；夜间死亡：天亮公布死讯后的那个白天。
//   过了这一天，后续白天一律不再允许。
bool BOTC_DeadClaimDayOK (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (!g_started || g_isNight) {
        return false;
    }
    if (!BOTC_SeatDead(q) || !BOTC_PublicDead(q)) {
        return false;
    }
    if (g_deadClaimDay[q] < 0) {
        return false;
    }
    return (g_deadClaimDay[q] == g_dayNum);
}

void BOTC_MoonChildCheck (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 36)) {
        return;
    }
    if (g_moonDone[q]) {
        return;
    }
    g_moonOpen[q] = true;
    g_moonWaitSeat = q;                // 【60 秒兜底】（用户 2026-09-21）
    g_moonWaitTick = 1;
    g_moonAskSt = false;
    // 【改成技能面板】（用户 2026-09-20）：公开死亡之后直接弹「选择技能目标（月之子）」，顺便把他的魔典摊开，
    //   他点一个座位 → 【确认】= 公开选人（跟以前「点头像」的效果一样：公屏播报 + 天亮结算）
    BOTC_SkillOpen(q);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
    g_grimOn[g_who[q]] = true;
    BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(q) + " 死了 → 已打开他的技能面板。");
    BOTC_PmInfo(g_who[q], "【月之子】你已经死了：点一个存活玩家的座位（魔典上），再点【确认】---- 如果他是善良的，他会在今晚死亡。");
}

// 月之子（死后）声称 + 公开选人：点头像落在谁身上（用户 2026-09-20）
void BOTC_MoonChildDeclare (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(g_who[p], "现在是夜晚：月之子的公开选择等天亮再做，天亮了再点头像。");
        return;
    }
    if (!BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    g_moonDeclare[g_who[p]] = false;
    g_declarePick[g_who[p]] = false;
    BOTC_BigHintHide(g_who[p]);
    BOTC_DeclareRender();
    BOTC_PubAnnounce("【月之子】" + BOTC_NameStr(p) + " 公开声明自己是【月之子】，并选择 " + BOTC_NameStr(q) + "。");
    BOTC_DeclareCdSet(g_who[p]);
    g_moonClaimed[p] = true;
    if (!BOTC_HasAbility(p, 36)) {
        return;                        // 假声称：不给说书人私聊提醒（用户 2026-11-04）
    }
    if (!BOTC_AbilityWorks(p, 36)) {
        g_moonDone[p] = true;
        BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次选择无效。");
        return;
    }
    if (g_moonDone[p]) {
        BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(p) + " 已经声明过一次了，这次不算。");
        return;
    }
    g_moonDone[p] = true;
    g_moonPick[p] = q;
    g_moonWaitSeat = 0;                // 他选完了，60 秒兜底停掉（用户 2026-09-21）
    g_moonWaitTick = 0;
    g_moonAskSt = false;
    g_moonBy = p;
    BOTC_PmStore(g_teller, "【月之子】已记下：" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(q) + "---- 今晚结算。");
}

void BOTC_MoonChildResolve () {
    int q;
    int v;
    string blk;
    q = g_moonBy;
    if (q < 1 || q > 13) {                // 允许 1：说书人自己那一格（-t 试技能）
        return;
    }
    v = g_moonPick[q];
    g_moonBy = 0;
    g_moonPick[q] = 0;
    if (v < 2 || v > 13) {
        return;
    }
    if (!BOTC_TargetIsLiving(v)) {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）已经死了，这次没有效果。");
        return;
    }
    // 【月之子 × 间谍 / 陌客能力者】（用户 2026-11-12）：不再按伪装自动判定，改弹说书人。
    if (BOTC_IsDisguiseAbility(v)) {
        BOTC_JudgeAsk(12, "【月之子】" + BOTC_NameStr(q) + " 选择了间谍 / 陌客能力者 " + BOTC_NameStr(v) + "：是否按善良结算并让他死亡？", q, v, 0);
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）是间谍 / 陌客能力者 → 请选择是否按善良结算。");
        return;
    }
    if (!BOTC_RegIsGood(v)) {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）按互动干扰不是善良 → 不会死。");
        return;
    }
    blk = BOTC_DeathBlocker(v, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【月之子】他选的人（" + BOTC_NameStr(v) + "）带着【" + blk + "】，没有死。");
        // 弄臣（34）的一次免死照正常流程用掉：撤掉「首次未死」、打上「失去能力（弄臣）」。
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(v);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(v, 1, 0, 36);
    BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(v) + " 是善良的 → 今晚死亡。");
}

//==================================================================================================
//==================================================================================================
// 【梦殒春宵 · 第 2 批】（用户 2026-09-21）：59 贤者的触发 / 61 心上人 / 62 理发师 / 63 呆瓜
//   放置与移除时机一律按官方（用户 2026-09-21 特意交代）：
//     心上人 → 醉酒标记「他死时放、离场时撤」；理发师 → 「今晚理发」死时放、恶魔交换或放弃后撤；贤者 → 无标记。
//==================================================================================================

// ■ 贤者（59）：「如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。」
//   面板复用「填两个座位号」（kind = 2）；脚本把「真恶魔 + 一个陪衬」先填进去，说书人可以直接确定或改掉。
//   他中毒 / 酒鬼时官方该给假情报（一名已死玩家 + 一名存活善良玩家）---- 脚本只把真话写进提示行，填什么由说书人决定。
void BOTC_SageOpen (int q, bool viaLevi) {
    int i;
    int dm;
    int filler;
    string s;
    dm = 0;
    filler = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (viaLevi) {
        dm = BOTC_LeviathanRoleHolder();       // 相克触发时，正确答案必须指向利维坦本人
    }
    else {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) { continue; }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                dm = i;                          // 杀死他的那只恶魔（真身是恶魔的座位）
            }
        }
    }
    // 陪衬：优先挑一个活着的善良玩家；没有就随便挑一个别的座位
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == q || i == dm) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatAlign(i) != 0) { continue; }
        filler = i;
    }
    if (filler < 2) {
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i] || i == q || i == dm) { continue; }
            filler = i;
        }
    }
    if (viaLevi) {
        BOTC_ManInfoOpenSeats(q, "【贤者×利维坦】左边填一个人，右边填另一个人（其中一个是利维坦）", 2);
    }
    else {
        BOTC_ManInfoOpenSeats(q, "【贤者】左边填一个人，右边填另一个人（其中一个是杀死他的恶魔）", 2);
    }
    if (dm >= 2) {
        libNtve_gf_SetDialogItemText(g_miEdit, StringToText(IntToString(dm - 1)), PlayerGroupSingle(g_teller));
    }
    if (filler >= 2) {
        libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(IntToString(filler - 1)), PlayerGroupSingle(g_teller));
    }
    s = "正确答案→（";
    if (dm >= 2) {
        s = s + BOTC_NameStr(dm) + " 是恶魔";
    }
    else {
        s = s + "场上没有恶魔";
    }
    s = s + "）";
    if (BOTC_SeatImpaired(q)) {
        s = s + "　他处于醉酒/中毒：官方的假情报是「一名已死玩家 + 一名存活善良玩家」，脚本不替你改，自己填。";
    }
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(s), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    if (viaLevi) {
        BOTC_PmStore(g_teller, "【贤者×利维坦】" + BOTC_NameStr(q) + " 的能力被利维坦相克触发 → 已打开「填两个玩家」的框。");
    }
    else {
        BOTC_PmStore(g_teller, "【贤者】" + BOTC_NameStr(q) + " 被恶魔杀死 → 已打开「填两个玩家」的框（左边默认填了真恶魔）。");
    }
}

// ■ 心上人（61）：「当你死亡时，会有一名玩家开始醉酒。」
//   官方提示标记 = 醉酒：放置时机「他死时」、移除时机「他离场时」→ 普通死亡不撤，换身份（离场）才撤。
void BOTC_SweetDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 61)) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 61)) {
        BOTC_PmStore(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了，但他中毒/酒鬼 → 这一次能力失效，谁都不会醉酒。");
        return;
    }
    g_sweetSeat = q;
    g_sweetPick = true;
    // 【统一模板】（用户 2026-09-21）：跟月之子 / 呆瓜 一样，走「技能面板 + 点座位 + 确认」那一套。
    //   这一步由**说书人**操作（官方：由说书人选择哪名玩家醉酒），所以面板开在说书人自己那一格。
    g_sweetBySt = true;
    BOTC_SkillOpen(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了：在下面对话框里点一个座位，再点【确定】。");
    BOTC_PmStore(g_teller, "【心上人】" + BOTC_NameStr(q) + " 死了 → 等你选那个要醉酒的人（选完自动打「醉酒（心上人）」标记）。");
}

// 心上人：说书人点头像选中谁（跟处决标记同一套点头像流程）
void BOTC_SweetPickAt (int q) {
    int i;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return;
    }
    g_sweetPick = false;
    BOTC_BigHintHide(g_teller);
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 82] = false;      // 一局只有一次，保险起见先收掉旧的
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 82] = true;
    g_sweetDrunk = q;
    BOTC_GrimRender(g_teller);
}

// ■ 呆瓜（63）：「当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。」
void BOTC_KlutzCheck (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 63)) {
        return;
    }
    if (g_klutzDone[q]) {
        return;
    }
    if (q == g_klutzWaitSeat) {           // 【别重复弹】（用户 2026-10-17）：同一次死亡会被「死亡 token / 红叉 / 死亡公开」连着调好几次
        return;                           //   原来每调一次都重开面板 → 玩家被要求点第二次人、已选的目标也被清掉
    }
    if (g_klutzDeclare[g_who[q]]) {       // 已经走「声称呆瓜 → 点头像」那条了：别再弹技能面板
        return;
    }
    if (!BOTC_AbilityWorks(q, 63)) {
        g_klutzDone[q] = true;
        BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 这次公开选择不结算。");
        return;
    }
    g_klutzWaitSeat = q;
    g_klutzWaitTick = 1;
    g_klutzAskSt = false;
    BOTC_SkillOpen(q);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
    g_grimOn[g_who[q]] = true;
    BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(q) + " 公开死亡 → 已打开他的技能面板（跟月之子同一套）。");
    BOTC_PmInfo(g_who[q], "【呆瓜】你已经死了：点一名存活玩家的座位（魔典上），再点【确认】---- 如果他是邪恶的，你的阵营落败。");
}

// 呆瓜：确认选人（他自己点的；说书人超时代选的也走这里）
void BOTC_KlutzPick (int p, int q) {
    int align;
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_HasAbility(p, 63)) {
        if (q >= 2 && q <= 13 && g_seatOn[q] && !BOTC_SeatDead(q) && !g_klutzDone[p]) {
            g_klutzDone[p] = true;
            g_klutzClaimed[p] = true;        // 假声称同样占掉全局这一次（复活后重置）
            g_klutzDeclare[g_who[p]] = false;
            g_declarePick[g_who[p]] = false;
            BOTC_DeclareRender();
            BOTC_PubAnnounce("【呆瓜】" + BOTC_NameStr(p) + " 声称自己是呆瓜，并公开选择 " + BOTC_NameStr(q) + "。");
            BOTC_DeclareCdSet(g_who[p]);
            // 假声称：不给说书人私聊提醒（用户 2026-11-04）
        }
        return;
    }
    if (!BOTC_AbilityWorks(p, 63)) {
        g_klutzDone[p] = true;
        g_klutzClaimed[p] = true;
        BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(p) + " 的能力失效 → 这次公开选择不结算。");
        return;
    }
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_PmStore(g_teller, "【呆瓜】没有选到有效玩家，这一次不结算。");
        return;
    }
    if (!BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    if (g_klutzDone[p]) {
        return;
    }
    g_klutzDone[p] = true;
    g_klutzClaimed[p] = true;            // 本局这一次声称已用掉（复活后重置）
    g_klutzPick[p] = q;
    g_klutzWaitSeat = 0;
    g_klutzWaitTick = 0;
    g_klutzAskSt = false;
    // 【选完就收】（用户 2026-10-17）：技能面板 / 声称后的「点头像」阶段一起收掉，不会再冒出第二次点人
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_klutzDeclare[g_who[p]] = false;
    g_declarePick[g_who[p]] = false;
    BOTC_DeclareRender();
    BOTC_PubAnnounce("【呆瓜】" + BOTC_NameStr(p) + " 公开选择 " + BOTC_NameStr(q) + "。");
    BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(q) + "（按真身阵营判）。");
    if (BOTC_SeatAlign(q) == 1) {
        align = BOTC_SeatAlign(p);
        if (align == 0) {
            BOTC_ShowWin(1, "人们会一直相信智者" + BOTC_NameStr(p) + "的担保的，", "恶魔什么的不过是愚者的臆想罢了......吗？");
        }
        else {
            BOTC_ShowWin(0, "人们会一直相信智者" + BOTC_NameStr(p) + "的担保的，", "恶魔什么的不过是愚者的臆想罢了......吗？");
        }
        return;
    }
}

// 呆瓜：60 秒没选 → 说书人替他选（⚠ 代替那个玩家选，不是「说书人自己声称呆瓜」）
void BOTC_KlutzForce (int q) {
    int p;
    p = g_klutzWaitSeat;
    if (p < 2 || p > 13 || q < 2 || q > 13) {
        return;
    }
    g_klutzAskSt = false;
    BOTC_PmStore(g_teller, "【呆瓜】超时：说书人替 " + BOTC_NameStr(p) + " 选择 " + BOTC_NameStr(q) + "（按他自己的选择处理）。");
    BOTC_KlutzPick(p, q);
}

// 【认知覆盖：换身份时整包跟着走】（用户 2026-10-19）：
//   4 个认知覆盖 ---- 酒鬼(14) token 8 / 疯子(38) token 49 / 提线木偶(93) token 118 / 悟道者(118) token 140。
//   被「换身份」时，要把他「以为的身份」（魔典上那张卡）+ 那枚认知 token 一起换给对面；
//   对面拿到的是「他以为的那张卡」（比如哲学家），不是「酒鬼 / 提线木偶」本体。
int BOTC_CogTokOf (int tr) {
    if (tr == 14) { return 8; }
    if (tr == 38) { return 49; }
    if (tr == 93) { return 118; }
    if (tr == 118) { return 140; }
    return -1;
}

void BOTC_PutCogCover (int q, int card, int tok) {
    if (q < 2 || q > 13 || card < 0 || card > 163 || tok < 0) {
        return;
    }
    g_mark[(g_teller * 14) + q] = card + 1;
    g_mark[(g_who[q] * 14) + q] = BOTC_PlayerRoleView(q, card) + 1;
    g_tokOn[(((g_teller * 14) + q) * 256) + tok] = true;
}

// ■ 理发师（62）：「如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。」
//   官方提示标记「今晚理发」：放置时机 = 他死时（未醉/中毒）；移除时机 = 恶魔交换或放弃之后。
void BOTC_BarberDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_HasAbility(q, 62)) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 62)) {
        BOTC_PmStore(g_teller, "【理发师】" + BOTC_NameStr(q) + " 死了，但他中毒/酒鬼 → 这一次不交换角色。");
        return;
    }
    g_barberSeat = q;
    g_barberWait = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 92] = true;
    BOTC_GrimRender(g_teller);
}

// 理发师：轮到他那一格 ---- 【用户 2026-09-21】这一步实际是「再次唤醒恶魔」，理发师本人不醒
void BOTC_BarberOpen (int q) {
    int dm;
    if (q < 2 || q > 13) {
        return;
    }
    // 【理发指令兜底】标记可能没打上（说书人手动唤醒 / 结算顺序提前），只要当晚还有待处理的
    //   理发师交换就照常打开交换面板，不再直接吞掉这一步。
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 92] && !g_barberWait) {
        return;
    }
    dm = BOTC_FindDemon();
    if (dm < 2) {
        BOTC_PmStore(g_teller, "【理发师】场上没有活着的恶魔 → 这一步跳过（没人交换）。");
        return;
    }
    g_barberFrom = dm;
    BOTC_SkillOpen(dm);
    libNtve_gf_SetDialogItemText(g_skillTitle[dm], StringToText("选择两名玩家"), PlayerGroupSingle(g_who[dm]));
    BOTC_Notice(g_teller, "【理发师】已再次唤醒 " + BOTC_NameStr(dm) + " 恶魔：选两名玩家交换角色（【取消】= 放弃交换）。");
    BOTC_PmStore(g_teller, "【理发师】已打开 " + BOTC_NameStr(dm) + " 的交换面板：选两名玩家（不能选其他恶魔，选自己可以），【确认】交换、【取消】放弃。");
    if (BOTC_SeatIsComputer(dm)) {
        BOTC_TestAutoSkill(dm);
    }
}

// 理发师：真的交换两个人的角色（阵营不变 → 用「善良 / 邪恶」token 保住）
//   p = 那只被再次唤醒的恶魔（不是理发师）；「今晚理发」标记打在理发师自己那一格
void BOTC_BarberSwap (int p, int a, int b) {
    int ra;
    int rb;
    int aa;
    int ab;
    int cogA;
    int cogB;
    int cardA;
    int cardB;
    int other;
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        BOTC_Notice(g_teller, "理发师：要选两个不同的玩家。");
        return;
    }
    if (!g_seatOn[a] || !g_seatOn[b]) {
        BOTC_Notice(g_teller, "理发师：这两个座位里有人不在场。");
        return;
    }
    ra = BOTC_SeatTrueRole(a);
    rb = BOTC_SeatTrueRole(b);
    if (ra < 0 || rb < 0) {
        BOTC_Notice(g_teller, "理发师：这两个座位里有人还没定身份。");
        return;
    }
    // 【恶魔与死者互换 · 先问说书人】（用户 2026-11-10）：恶魔把自己和已死亡的玩家互换会让恶魔
    //   落到尸体上 → 弹窗让说书人决定；点【否】/ X 就把面板还给他重新选。
    //   ⚠ 只看「被换的那一方」是不是真死：恶魔本身是僵怖（43，含公开红叉的假死状态）也照样弹窗；
    //     只有另一方是假死僵怖（内部还活着，BOTC_SeatDead 返回假）时才按普通交换、不弹窗。
    if (!g_barAskBypass && (a == p || b == p)) {
        other = a;
        if (a == p) {
            other = b;
        }
        if (BOTC_SeatDead(other)) {
            BOTC_BarberAskOpen(p, a, b);
            return;
        }
    }
    // 【相克 · 理发师 × 落难少女】（用户 2026-11-03）：交换到落难少女 → 由说书人指定谁当落难少女
    if (!g_damselBarberBypass && (ra == 82 || rb == 82)) {
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_DamselAskOpenBarber(p, a, b);
        return;
    }
    aa = BOTC_SeatAlign(a);
    ab = BOTC_SeatAlign(b);
    // 【认知覆盖整包跟着换】（用户 2026-10-19）：先记下两人「以为的身份 / 那枚 token」
    cogA = BOTC_CogTokOf(ra);
    cogB = BOTC_CogTokOf(rb);
    cardA = g_mark[(g_teller * 14) + a] - 1;
    cardB = g_mark[(g_teller * 14) + b] - 1;
    BOTC_SetSeatRole(g_teller, a, rb);
    BOTC_SetSeatRole(g_teller, b, ra);
    if (cogB >= 0) {
        BOTC_PutCogCover(a, cardB, cogB);
    }
    if (cogA >= 0) {
        BOTC_PutCogCover(b, cardA, cogA);
    }
    BOTC_SeatStateSync();
    // 阵营不变：只有当「换过来的那张身份自带阵营」跟原来的阵营不一样时，才需要打「善良(14) / 邪恶(15)」
    //   token 去把它钉住（跟麻脸巫婆改造同一套口径，用户 2026-09-21：同阵营就不用打）
    if (BOTC_RoleAlign(rb) != aa) {
        if (aa == 1) { g_tokOn[(((g_teller * 14) + a) * 256) + 15] = true; }
        else { g_tokOn[(((g_teller * 14) + a) * 256) + 14] = true; }
    }
    if (BOTC_RoleAlign(ra) != ab) {
        if (ab == 1) { g_tokOn[(((g_teller * 14) + b) * 256) + 15] = true; }
        else { g_tokOn[(((g_teller * 14) + b) * 256) + 14] = true; }
    }
    if (g_barberSeat >= 2) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;      // 官方：能力结算完撤掉「今晚理发」
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[a]);
    BOTC_GrimRender(g_who[b]);
    BOTC_SkillBtnRender();
    if (g_skillPicking[a]) {
        BOTC_SkillRender(a);
    }
    if (g_skillPicking[b]) {
        BOTC_SkillRender(b);
    }
    BOTC_PmStore(g_teller, "【理发师】恶魔（" + BOTC_NameStr(p) + "）交换了 " + BOTC_NameStr(a) + "（原 " + BOTC_RoleNameSafe(ra) + "）和 " + BOTC_NameStr(b) + "（原 " + BOTC_RoleNameSafe(rb) + "）的角色，阵营不变。");
    if (cogB >= 0) {
        BOTC_ChangeRoleMsg(a, cardB);       // 拿到认知覆盖：只说「他以为的身份」
    }
    else {
        BOTC_ChangeRoleMsg(a, rb);
    }
    if (cogA >= 0) {
        BOTC_ChangeRoleMsg(b, cardA);
    }
    else {
        BOTC_ChangeRoleMsg(b, ra);
    }
    // 【收面板】（用户 2026-09-21）：交换完把恶魔那块技能面板关掉，不然它一直挂在屏幕上
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

// 理发师：恶魔放弃交换（p = 那只恶魔）
void BOTC_BarberDecline (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_barberSeat >= 2) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【理发师】恶魔（" + BOTC_NameStr(p) + "）放弃交换 → 撤掉「今晚理发」标记。");
}

// 【理发师 · 恶魔与死者互换】（用户 2026-11-10）：恶魔把自己和已死亡的玩家互换时，
//   先弹窗让说书人决定；【是】= 照常交换，【否】/ X = 拒绝，把交换面板还给恶魔重新选。
//   恶魔本身是僵怖（含公开红叉的假死状态）也照样走到这里 —— 判的是「被换的那一方」是否真死。
void BOTC_BarberAskOpen (int p, int a, int b) {
    int other;
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13) {
        return;
    }
    other = a;
    if (a == p) {
        other = b;
    }
    // 电脑说书人不会点弹窗：直接按允许处理，保持旧行为。
    if (PlayerType(g_teller) != 1) {
        g_barAskBypass = true;
        BOTC_BarberSwap(p, a, b);
        g_barAskBypass = false;
        return;
    }
    if (g_barAskDlg != 0) {
        DialogSetVisible(g_barAskDlg, PlayerGroupAll(), false);
    }
    g_barAskOn = true;
    g_barAskP = p;
    g_barAskA = a;
    g_barAskB = b;
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    libNtve_gf_SetDialogItemText(g_barAskTitle, StringToText("【理发师】" + BOTC_NameStr(p) + " 要与已死亡的 " + BOTC_NameStr(other) + " 互换：互换后恶魔会是死的（天亮可能判善良胜），是否允许？"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_barAskDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【理发师】" + BOTC_NameStr(p) + " 要把自己和已死亡的 " + BOTC_NameStr(other) + " 互换 → 允许后恶魔会处于死亡状态（僵怖也一样，不会在尸体上活着），之后可能判善良胜；请选择【是：允许】或【否：让他重新选】。");
}

void BOTC_BarberAskAnswer (int ans) {
    int p;
    int a;
    int b;
    p = g_barAskP;
    a = g_barAskA;
    b = g_barAskB;
    g_barAskOn = false;
    g_barAskP = 0;
    g_barAskA = 0;
    g_barAskB = 0;
    if (g_barAskDlg != 0) {
        DialogSetVisible(g_barAskDlg, PlayerGroupAll(), false);
    }
    if (p < 2 || p > 13) {
        return;
    }
    if (ans != 0) {
        g_barAskBypass = true;
        BOTC_BarberSwap(p, a, b);
        g_barAskBypass = false;
        return;
    }
    // 拒绝：把交换面板还给这只恶魔，让他重新选两名玩家。
    g_barberFrom = p;
    BOTC_SkillOpen(p);
    BOTC_PmStore(g_teller, "【理发师】已拒绝 " + BOTC_NameStr(p) + " 把自己和死者互换 → 让他重新选择两名玩家。");
}

// ■ 月之子（36）超时兜底：说书人替他选
//   ⚠ 这是「代替那个玩家选」，**不是**说书人自己声称月之子：不播声称那句、也不走 BOTC_MoonChildDeclare
void BOTC_MoonChildForce (int v) {
    int p;
    p = g_moonWaitSeat;
    if (p < 2 || p > 13 || v < 2 || v > 13) {
        return;
    }
    if (g_moonDone[p]) {
        return;
    }
    g_moonAskSt = false;
    g_moonWaitSeat = 0;
    g_moonWaitTick = 0;
    g_moonDone[p] = true;
    g_moonPick[p] = v;
    g_moonBy = p;
    BOTC_PmStore(g_teller, "【月之子】超时：说书人替 " + BOTC_NameStr(p) + " 选择 " + BOTC_NameStr(v) + "（按他自己选的处理，不是说书人声称月之子）。");
}

// 【死后选人 60 秒兜底】（用户 2026-09-21）：挂在 0.5 秒一拍的 BOTC_Tick_Func 上，计数 >= 120 就是 60 秒
void BOTC_DeadPickTimeout () {
    if (g_moonWaitTick > 0) {
        g_moonWaitTick = g_moonWaitTick + 1;
        if (g_moonWaitTick >= 120) {
            g_moonWaitTick = 0;
            if (g_moonWaitSeat >= 2 && !g_moonDone[g_moonWaitSeat] && !g_moonAskSt) {
                g_moonAskSt = true;
                BOTC_Notice(g_teller, "【月之子】60 秒没有选 → 点魔典上的一个座位替他选（选完按他自己选的处理）。");
                BOTC_PmStore(g_teller, "【月之子】" + BOTC_NameStr(g_moonWaitSeat) + " 超时未选 → 已切成「说书人点头像替他选」。");
            }
        }
    }
    if (g_klutzWaitTick > 0) {
        g_klutzWaitTick = g_klutzWaitTick + 1;
        if (g_klutzWaitTick >= 120) {
            g_klutzWaitTick = 0;
            if (g_klutzWaitSeat >= 2 && !g_klutzDone[g_klutzWaitSeat] && !g_klutzAskSt) {
                g_klutzAskSt = true;
                BOTC_Notice(g_teller, "【呆瓜】60 秒没有选 → 点魔典上的一个座位替他选（选完按他自己选的处理）。");
                BOTC_PmStore(g_teller, "【呆瓜】" + BOTC_NameStr(g_klutzWaitSeat) + " 超时未选 → 已切成「说书人点头像替他选」。");
            }
        }
    }
}
//==================================================================================================

// ■ 莽夫（37）：「每个夜晚，首个使用其自身能力选择了你的玩家会醉酒直到下个黄昏。你会转变为他的阵营。」
//   只算**夜间技能**（用户 2026-09-20 定）；同一个夜晚只有第一个算。阵营转变走**登记层**（互动干扰那一层）。
// 【莽夫的「选他的人」算哪个阵营】（用户 2026-09-20）：
//   普通玩家走登记层（间谍 / 陌客这种被看成别的阵营时就算那个）；
//   说书人自己那一格（-t 试技能，座位 1）登记层没有他的位置，就用他真身的阵营。
int BOTC_GoonChooserAlign (int p) {
    int a;
    if (p < 1 || p > 13) {
        return 0;
    }
    // 【莽夫按真实阵营】（用户 2026-11-12）：不再读伪装 / 登记层。
    a = BOTC_SeatAlign(p);
    if (a < 0) {
        a = 0;
    }
    return a;
}

// 【「这一下」的醉酒是不是只有莽夫那一份】（用户 2026-09-20）：
//   p 是今夜第一个选中莽夫的人（g_goonBy == p），而且他身上除了「醉酒（莽夫）」没有别的中毒 / 醉酒来源。
//   这种情况下，莽夫那一下只挡「打莽夫自己」的那一部分，打别的目标照旧生效 ----
//   例：沙巴洛斯选「目标1 = 别人、目标2 = 莽夫」→ 莽夫不会被吃，目标1 照常死。
bool BOTC_GoonDrunkOnly (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_goonBy != p) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + p) * 256) + 61]) {
        return false;                      // 连「醉酒（莽夫）」都没有：不是这一下
    }
    if (BOTC_SeatIsPoisoned(p)) {
        return false;                      // 还中着毒
    }
    if (BOTC_SeatTrueRole(p) == 14) {
        return false;                      // 真身是酒鬼
    }
    // 【除了「醉酒（莽夫）61」以外的任何醉酒来源 → 都算「不止莽夫那一份」】（用户 2026-10-14 补全）----
    //   这份清单必须跟 BOTC_SeatIsDrunk() 对齐：之前漏了 82 心上人 / 90 哲学家 / 126 村夫 / 129 解谜大师，
    //   以及「哲学家选中的那个人」（BOTC_PhiloDrunkSeat）；漏了就会把「61 + 别的一份」误判成「只有莽夫那一份」。
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 24]) {
        return false;                      // 通用「醉酒」那一格
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 59] || g_tokOn[(((g_teller * 14) + p) * 256) + 60] || g_tokOn[(((g_teller * 14) + p) * 256) + 62]) {
        return false;                      // 水手 / 旅店老板 / 吟游诗人 也醉了他
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 53] || g_tokOn[(((g_teller * 14) + p) * 256) + 54] || g_tokOn[(((g_teller * 14) + p) * 256) + 55]) {
        return false;                      // 侍臣的三天三夜
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 82] || g_tokOn[(((g_teller * 14) + p) * 256) + 90]) {
        return false;                      // 醉酒（心上人 82）/ 醉酒（哲学家 90）
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 126] || g_tokOn[(((g_teller * 14) + p) * 256) + 129]) {
        return false;                      // 醉酒（村夫 126 / 解谜大师 129）
    }
    // 【漏判补全】（用户 2026-11-13）：店小二 136 / 道士 142 / 鸩 144 / 街头风琴手 164 / 酒保 196
    //   之前这五份醉酒没有列进来，被莽夫那一下的刺客 / 沙巴洛斯等会被误判成「只有莽夫那一份」，照常生效。
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 136] || g_tokOn[(((g_teller * 14) + p) * 256) + 142] || g_tokOn[(((g_teller * 14) + p) * 256) + 144]) {
        return false;                      // 醉酒（店小二 136 / 道士 142 / 鸩 144）
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 164] || g_tokOn[(((g_teller * 14) + p) * 256) + 196]) {
        return false;                      // 醉酒（街头风琴手 164 / 酒保 196）
    }
    if (p == BOTC_PhiloDrunkSeat()) {
        return false;                      // 哲学家选中的那个角色的持有者（token 还没同步过来也算，跟 BOTC_SeatIsDrunk 一致）
    }
    return true;
}

void BOTC_GoonTouch (int chooser, int target) {
    int g;
    int ca;
    if (chooser < 1 || chooser > 13 || target < 2 || target > 13) {
        return;
    }
    if (!BOTC_HasAbility(target, 37)) {
        return;
    }
    if (BOTC_SeatDead(target)) {
        return;
    }
    if (g_goonBy != 0) {
        return;                                  // 今夜已经有人触发过了：只有第一个算
    }
    g = target;
    g_goonSeat = g;
    g_goonBy = chooser;
    g_tokOn[(((g_teller * 14) + chooser) * 256) + 61] = true;  // 醉酒（莽夫）：选他的人醉酒（到明天黄昏，黄昏自动清）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【莽夫】今夜第一个用夜间技能选中莽夫（" + BOTC_NameStr(g) + "）的是 " + BOTC_NameStr(chooser) + " → 他醉酒到明天黄昏。");
    BOTC_PmStore(g_teller, "【莽夫】这一下是**当场结算**的：他这一夜的能力立刻失效（刺客的「刺杀莽夫」那一刀除外，仍会杀死莽夫并让他转邪恶），别再把他的技能效果算进去。");
    // 【莽夫记的是「今夜第一个选他那个人的阵营」】（用户 2026-09-20）：
    //   这里直接按那个人的阵营算（不再回头读登记层缓存 ---- 之前读缓存会拿到旧值，
    //   所以「自动打邪恶 token」永远走不到，反而把 token 撤掉）。
    ca = BOTC_GoonChooserAlign(chooser);
    if (ca == 0 && BOTC_BoffinMustStayEvil(g)) {
        ca = 1;
        BOTC_PmStore(g_teller, "【科学怪人 × 莽夫】恶魔借到的是莽夫能力：即使被善良玩家选中，也不能转为善良阵营，保留邪恶。");
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时不能再新增邪恶，保持善良。
    if (ca == 1 && BOTC_HolySoulBlocks(g)) {
        ca = 0;
        BOTC_PmStore(g_teller, "【莽夫×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(g) + " 保持善良阵营。");
    }
    // 【食人族 × 莽夫 · 阵营锁定】（用户 2026-11-10）：已锁定时保持当前阵营；
    //   第一次因莽夫改变阵营前，记住他的原阵营。
    if (BOTC_SeatRegAlign(g) != ca) {
        if (g_cannLocked[g]) {
            ca = BOTC_SeatRegAlign(g);
            BOTC_PmStore(g_teller, "【食人族×莽夫】" + BOTC_NameStr(g) + " 的阵营已锁定为 " + BOTC_AlignName(ca) + "，本次不改变。");
        }
        else {
            if (BOTC_HasAbility(g, 74) && g_cannOrigAlign[g] < 0) {
                g_cannOrigAlign[g] = BOTC_SeatRegAlign(g);
            }
        }
    }
    if (BOTC_SeatRegAlign(g) == ca) {
        BOTC_PmStore(g_teller, "【莽夫】" + BOTC_NameStr(g) + " 本来就是 " + BOTC_AlignName(ca) + " 阵营 → 阵营没变，不提示他。");
    }
    else {
        BOTC_SetReg(g, -1, ca);
        BOTC_PmStore(g_teller, "【莽夫】" + BOTC_NameStr(g) + " 的阵营随之变成 " + BOTC_AlignName(ca) + "。");
        if (ca == 1) {
            BOTC_PmInfo(g_who[g], "【莽夫】你转变为邪恶阵营。");
        }
        else {
            BOTC_PmInfo(g_who[g], "【莽夫】你转变为善良阵营。");
        }
    }
    // 【善良 / 邪恶 token】：转邪恶 → 打「邪恶」；变回善良 → 把「邪恶」撤掉。
    if (ca == 1) {
        g_tokOn[(((g_teller * 14) + g) * 256) + 15] = true;         // 邪恶
        g_tokOn[(((g_teller * 14) + g) * 256) + 14] = false;        // 别两个都挂着
        BOTC_ClaimBtnRender();        // 真身变邪恶了：邪恶那个【伪装身份】按钮跟着刷出来
    }
    else {
        g_tokOn[(((g_teller * 14) + g) * 256) + 15] = false;
        BOTC_PmStore(g_teller, "【莽夫】已把 " + BOTC_NameStr(g) + " 身上的「邪恶」token 撤掉。");
    }
    BOTC_PairClearSeat(g);            // 真身阵营刚变 → 登记层缓存作废，技能立刻按新的算
    BOTC_GrimRender(g_teller);
}

// ■ 教父（39）：「今天有外来者死亡」才能在当晚杀人（按互动干扰算外来者）
bool BOTC_GodfatherCanKill () {
    int q;
    if (g_dayNum <= 0) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum) {
            continue;
        }
        // 【教父×陌客】（用户 2026-11-05）：陌客白天死亡时由说书人弹窗裁定，
        //   判定结果优先于登记层；未判定（已进夜晚）按不算处理。
        if (BOTC_IsRecluseAbility(q)) {
            if (g_gfRecAnsSet[q]) {
                if (g_gfRecAns[q]) {
                    return true;
                }
                continue;
            }
        }
        if (BOTC_SeatRegTeam(q) == 1) {
            return true;                         // 今天死的这个人（按互动干扰）算外来者
        }
    }
    return false;
}

// ■ 疯子（38）的假爪牙名单（首夜给）：大概率是真的邪恶玩家，小概率掺一个假的；教父在场时优先出现
int BOTC_PmInfoDemons (string s) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 3) {
            continue;
        }
        BOTC_PmInfo(g_who[i], s);
        n = n + 1;
    }
    return n;
}

void BOTC_LunaticInfo () {
    int lu;
    int n;
    int cnt;
    int i;
    // 【多个疯子】（用户 2026-11-12）：先数一数场上有几名真疯子，填表窗只弹一次、
    //   内容对所有人一致，填完由 BOTC_LunInfoFlush 一次性发给全部真疯子。
    cnt = 0;
    lu = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_LunaticRealSeat(i)) {
            continue;
        }
        cnt = cnt + 1;
        if (lu == 0) {
            lu = i;
        }
    }
    if (lu < 2) {
        return;
    }
    // 【官网夜序第 15 位】先给疯子假的「爪牙」信息；可填的框数由 BOTC_LunaticMinionMax()
    // 按剧本决定（默认 2，堤丰之首 / 魔术师各 +1，最多 4），也可以留空 / 掺假。
    // 真正的恶魔要到第 17 位恶魔信息完成之后才得知谁是疯子。
    n = BOTC_LunaticMinionMax();
    // 【疯子信息合批】（用户 2026-11-10）：开新一条情报链前先清空上次没发完的残留。
    BOTC_LunInfoClean();
    BOTC_ManInfoOpenSeats(lu, "【疯子】填爪牙1~" + IntToString(n) + "；点【取消】= 不发送（可用于罂粟局）", 0);
    if (cnt > 1) {
        BOTC_PmStore(g_teller, "【疯子】本局有" + IntToString(cnt) + "名疯子，这一份信息会同时发给他们所有人。给他最多" + IntToString(n) + "个「爪牙」，可以掺假，也可以留空。");
    }
    else {
        BOTC_PmStore(g_teller, "【疯子】给他最多" + IntToString(n) + "个「爪牙」，可以掺假，也可以留空。");
    }
}

// 【邪恶互认完成后】告诉所有真恶魔谁是疯子；一局只发一次。
void BOTC_NotifyDemonsLunatic () {
    int lu;
    int n;
    if (g_lunaticIdentitySent) {
        return;
    }
    lu = BOTC_RealLunaticSeat();
    if (lu < 2) {
        return;
    }
    n = BOTC_PmInfoDemons("【信息】你得知" + BOTC_NameStr(lu) + "是疯子。");
    if (n > 0) {
        g_lunaticIdentitySent = true;
        BOTC_PmStore(g_teller, "【疯子】邪恶互认完成：已告诉所有恶魔，本局疯子是 " + BOTC_NameStr(lu) + "。");
    }
}

// ■ 疯子（38）今晚「杀」了谁：写给说书人 + 告诉真恶魔
//   疯子真的行动（BOTC_SkillConfirm 那一支）、说书人手动打「被选择（疯子）」token 都会调它。
void BOTC_LunaticPickNotify (int q) {
    int i;
    int lu;
    int dm;
    if (q < 2 || q > 13) {
        return;
    }
    lu = BOTC_LunaticActingSeat();       // 今晚真动手的那个疯子（真疯子优先、要清醒），用户 2026-09-21
    dm = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
            dm = i;
        }
    }
    if (lu >= 2) {
        BOTC_PmStore(g_teller, "【疯子】疯子选择了" + BOTC_NameStr(q) + "，不产生死亡。");
    }
    else {
        BOTC_PmStore(g_teller, "【疯子】本局没有疯子，但 " + BOTC_NameStr(q) + " 身上被打了「被选择（疯子）」标记。");
    }
    if (dm >= 2) {
        // 用户 2026-09-20 二次修改：不管智能还是真人说书，都由脚本**直接私聊恶魔**；
        //   疯子中毒 / 酒鬼时**什么都不发**（用户 2026-09-21 的最终口径），只给说书人记一行。
        if (lu >= 2 && BOTC_SeatImpaired(lu)) {
            // 【疯子没做出选择就不提示】（用户 2026-09-21）：恶魔什么都不会收到
            BOTC_PmStore(g_teller, "【疯子】疯子（" + BOTC_NameStr(lu) + "）中毒/酒鬼 → 这一次没有发送给恶魔；他实际选择了 " + BOTC_NameStr(q) + "，这条别外传。");
        }
        else {
            // 【直接告知恶魔】（用户 2026-11-13）：选完立即私聊所有真恶魔；
            //   食人族吃到的疯子要带上「某玩家是疯子」。
            BOTC_LunPickQueue(BOTC_NameStr(q), lu, lu >= 2 && g_cannLun[lu]);
            BOTC_PmStore(g_teller, "【疯子】已记录疯子选择了" + BOTC_NameStr(q) + "，并直接私聊告知了恶魔。");
        }
    }
}

// 给一只真恶魔私聊「疯子选择了谁」；已经发过的、不是恶魔的、不在夜里的一律跳过。
void BOTC_LunPickSend (int q) {
    string msg;
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_lunPickPend || g_lunPickSent[q]) {
        return;
    }
    if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 3) {
        return;
    }
    if (!g_started || !g_isNight) {
        return;
    }
    msg = "【信息】疯子选择了" + g_lunPickText + "。";
    if (g_lunPickCann) {
        msg = "【信息】" + BOTC_NameStr(g_lunPickLu) + " 是疯子，他选择了" + g_lunPickText + "。";
    }
    BOTC_PmInfo(g_who[q], msg);
    g_lunPickSent[q] = true;
    BOTC_PmStore(g_teller, "【疯子】已告诉 " + BOTC_NameStr(q) + "（恶魔）：疯子选择了" + g_lunPickText + "。");
}

// 【疯子·直接告知恶魔】（用户 2026-11-13）：疯子确认假刀后立即私聊所有真恶魔，不再延迟。
void BOTC_LunPickQueue (string body, int lu, bool cann) {
    int q;
    g_lunPickPend = true;
    g_lunPickText = body;
    g_lunPickLu = lu;
    g_lunPickCann = cann;
    for (q = 2; q <= 13; q += 1) {
        g_lunPickSent[q] = false;
    }
    // 立即发送：疯子确认目标 → 所有真恶魔马上收到
    for (q = 2; q <= 13; q += 1) {
        BOTC_LunPickSend(q);
    }
}

// 【唤醒之后「跟他进私聊」统一走这一个函数】（用户 2026-10-16）：
//   这套动作（建 1:1 + 把说书人的聊天切成私聊 + 刷新会话列表）原来在【唤醒下一个】、
//   【手动唤醒】、教父首夜信息 三个地方各抄了一份，漏一处就是「某个角色被唤醒却不进私聊」。
//   · 已经在跟他同一条私聊里 → 不重建（省掉「退出 / 重新建立」那串播报），只把说书人的聊天切到私聊；
//   · 不在 → 建一条 1:1；
//   · 兜底：13 条私聊位子全被占着、建不出来时，先拆一条「说书人不在里面」的腾位子，再建一次。
void BOTC_TellerPmTo (int seat) {
    int other;
    int s;
    int i;
    int j;
    if (seat < 2 || seat > 13) {
        return;
    }
    other = g_who[seat];
    if (other < 1 || other > 13) {
        return;
    }
    s = g_mySess[g_teller];
    if (!(s >= 1 && s <= 13 && g_sessAlive[s] && g_member[(s * 14) + other])) {
        BOTC_CreateSess(g_teller, other);
    }
    if (g_mySess[g_teller] == 0) {                 // 建不出来（位子满了）→ 拆一条腾位子再建一次
        for (i = 1; i <= 13; i += 1) {
            if (!g_sessAlive[i]) {
                continue;
            }
            if (g_member[(i * 14) + g_teller]) {
                continue;
            }
            for (j = 1; j <= 13; j += 1) {
                if (g_member[(i * 14) + j]) {
                    g_member[(i * 14) + j] = false;
                    if (g_mySess[j] == i) {
                        g_mySess[j] = 0;
                    }
                }
            }
            g_sessAlive[i] = false;
            g_joinPending[i] = false;
            g_joinWho[i] = 0;
            if (i == g_lmSess) {
                g_lmSess = 0;
            }
            break;
        }
        BOTC_CreateSess(g_teller, other);
    }
    g_chatSay[g_teller] = 1;
    BOTC_SayRender(g_teller);
    BOTC_RefreshSessListAll();
    BOTC_ManInfoReShow();
}

void BOTC_WakeRender () {
    DialogControlSetVisible(g_wakeBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn, PlayerGroupAll(), false);
    if (g_pdBtn > 0) {
        DialogControlSetVisible(g_pdBtn, PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_wakeBtn, PlayerGroupSingle(g_teller), g_isNight);
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupSingle(g_teller), g_isNight);
    // 【说书人工具】与测试总开关解耦：正式开局后昼夜都给说书人保留。
    DialogControlSetVisible(g_specBtn, PlayerGroupSingle(g_teller), g_started || g_isNight);
    if (g_pdBtn > 0) {
        // 【精神病患者（84）】是白天公开声称，不占夜间入口
        DialogControlSetVisible(g_pdBtn, PlayerGroupSingle(g_teller), g_isNight && g_pdRole > 0 && g_pdRole != 85);
        if (g_pdRole > 0 && g_pdRole <= 163) {
            libNtve_gf_SetDialogItemText(g_pdBtn, StringToText("说书人：" + g_roleName[g_pdRole - 1]), PlayerGroupSingle(g_teller));
        }
    }
    if (!g_isNight) {
        g_wakeMode = false;
        g_manualWakeSeat = 0;
        g_manualWakeQueue = 0;
        g_manualWakeInsert = false;
        g_wakeDone = false;
        g_manualWakeDoneBefore = false;
        g_wakeChoiceSeat = 0;
        DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    }
    if (g_wakeManualBtn > 0) {
        // 【手动唤醒】不再持续显示「唤醒中」：点一次座位就释放。
        libNtve_gf_SetDialogItemText(g_wakeManualBtn, StringToText("手动唤醒"), PlayerGroupSingle(g_teller));
    }
    if (g_manualWakeSeat > 0 && !g_awake[g_manualWakeSeat]) {
        g_manualWakeSeat = 0;
    }
    BOTC_BuildSeatList();
    if (g_manualWakeSeat >= 2 && g_manualWakeSeat <= 13 && g_awake[g_manualWakeSeat]) {
        // 【结束手动唤醒】：手动唤醒的人还醒着时，这个按钮改为结束这次手动唤醒。
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("结束手动唤醒"), PlayerGroupSingle(g_teller));
    }
    else if (g_wakeDone) {
        // 【已行动完毕】（用户 2026-11-08）：本夜所有人都已轮完，按钮文字固定下来。
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("已行动完毕"), PlayerGroupSingle(g_teller));
    }
    else if (g_autoOn) {
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("唤醒下一个"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_wakeBtn, StringToText("开始唤醒"), PlayerGroupSingle(g_teller));
    }
    BOTC_BigHintHide(g_teller);
}

void BOTC_WakeManualToggle () {
    if (!g_isNight) {
        BOTC_Notice(g_teller, "白天不能唤醒：先点【进入夜晚】，夜里才唤醒。");
        return;
    }
    // 【军团】疯子屏蔽框还没答完：先处理那个框（用户 2026-09-30）
    if (BOTC_LegionPendBlock()) {
        return;
    }
    if (g_wakeMode) {
        g_wakeMode = false;
        g_wakeChoiceSeat = 0;
        DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
        BOTC_Notice(g_teller, "已退出【手动唤醒】：点座位不再唤醒。");
    }
    else {
        g_wakeMode = true;
        BOTC_Notice(g_teller, "【手动唤醒】：点一个座位唤醒他一次；有人正在行动时会先排到下一个唤醒顺序。");
    }
    BOTC_WakeRender();
}

int BOTC_WakeAbilityChoiceBuild (int q) {
    int own;
    int grant;
    int b;
    int n;
    n = 0;
    g_wakeChoiceSeat = q;
    if (q < 2 || q > 13) {
        return 0;
    }
    own = g_mark[(g_teller * 14) + q] - 1;
    // 手动唤醒不受自动夜序 / 行动类别限制：本体与手工赋予的能力都应可选。
    if (own >= 0 && own <= 163) {
        g_wakeChoiceSource[0] = 0;
        g_wakeChoiceRole[0] = own;
        n = 1;
    }
    // 说书人手工赋予的附加能力：即使标记为醉酒，也仍然列入选择，只是执行时无效。
    if (n < 6 && g_grantRoleBy[q] > 0 && g_grantRoleBy[q] <= 163) {
        grant = g_grantRoleBy[q] - 1;
        if (grant != own) {
            g_wakeChoiceSource[n] = -1;
            g_wakeChoiceRole[n] = grant;
            n = n + 1;
        }
    }
    if (n < 6 && BOTC_BoffinNestedWakeSource(q) >= 2) {
        g_wakeChoiceSource[n] = -3;
        g_wakeChoiceRole[n] = g_bnestRoleBy[BOTC_BoffinNestedWakeSource(q)] - 1;
        n = n + 1;
    }
    for (b = 2; b <= 13 && n < 6; b += 1) {
        if (BOTC_BoffinRoleOrderForSource(b, q) <= 0) {
            continue;
        }
        g_wakeChoiceSource[n] = b;
        g_wakeChoiceRole[n] = g_boffinRoleBy[b] - 1;
        n = n + 1;
    }
    return n;
}

void BOTC_BuildWakeChoice () {
    int i;
    int x;
    DialogCreate(1360, 300, c_anchorCenter, 0, -70, false);
    g_wakeChoiceDlg = DialogLastCreated();
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    g_wakeChoiceTitle = BOTC_NewLabelC(g_wakeChoiceDlg, 1320, 34, 20, 10, StringToText("选择能力"));
    libNtve_gf_SetDialogItemStyle(g_wakeChoiceTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceTitle, false, PlayerGroupAll());
    for (i = 0; i < 6; i += 1) {
        x = 20 + (i * 215);
        g_wakeChoiceBtn[i] = BOTC_NewButton(g_wakeChoiceDlg, 200, 180, x, 52, "");
        libNtve_gf_CreateDialogItemImage(g_wakeChoiceDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_wakeChoiceIcon[i] = DialogControlLastCreated();
        DialogControlSetSize(g_wakeChoiceIcon[i], PlayerGroupAll(), 112, 112);
        DialogControlSetPosition(g_wakeChoiceIcon[i], PlayerGroupAll(), c_anchorTopLeft, x + 44, 62);
        libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceIcon[i], false, PlayerGroupAll());
        g_wakeChoiceName[i] = BOTC_NewLabelC(g_wakeChoiceDlg, 200, 26, x + 2, 182, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_wakeChoiceName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_wakeChoiceName[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupAll(), false);
    }
    g_wakeChoiceCancel = BOTC_NewButton(g_wakeChoiceDlg, 200, 40, 580, 240, "取消");
    DialogControlSetVisible(g_wakeChoiceCancel, PlayerGroupAll(), true);
    // 【右上角 X】（用户 2026-11-01）：等同点【取消】
    g_wakeChoiceX = BOTC_NewButton(g_wakeChoiceDlg, 30, 26, 1316, 6, "X");
    DialogControlSetVisible(g_wakeChoiceX, PlayerGroupAll(), false);
    DialogControlSetVisible(g_wakeChoiceX, PlayerGroupSingle(g_teller), true);
}

void BOTC_WakeAbilityChoicePick (int idx) {
    int seat;
    int src;
    seat = g_wakeChoiceSeat;
    if (idx < 0 || idx > 5 || seat < 2 || seat > 13) {
        return;
    }
    src = g_wakeChoiceSource[idx];
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), false);
    g_wakeChoiceSeat = 0;
    if (src >= 2) {
        g_boffinActing[seat] = true;
        g_boffinActingSource[seat] = src;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    else if (src == -1) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = true;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    else if (src == -3) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = true;
        g_bnestSource[seat] = BOTC_BoffinNestedWakeSource(seat);
    }
    else {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    BOTC_WakeManualApply(seat);
}

void BOTC_WakeAbilityChoiceCancel () {
    int seat;
    seat = g_wakeChoiceSeat;
    if (seat >= 2 && seat <= 13) {
        g_boffinActing[seat] = false;
        g_boffinActingSource[seat] = 0;
        g_grantActing[seat] = false;
        g_bnestActing[seat] = false;
        g_bnestSource[seat] = 0;
    }
    g_wakeChoiceSeat = 0;
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), false);
    BOTC_Notice(g_teller, "已取消这次能力选择。");
}

void BOTC_WakeAbilityChoiceOpen (int q) {
    int i;
    int n;
    int role;
    if (q < 2 || q > 13) {
        return;
    }
    n = BOTC_WakeAbilityChoiceBuild(q);
    if (n <= 1) {
        return;
    }
    if (g_wakeChoiceDlg == 0) {
        BOTC_BuildWakeChoice();
    }
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < n; i += 1) {
        role = g_wakeChoiceRole[i];
        DialogControlSetVisible(g_wakeChoiceBtn[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_wakeChoiceIcon[i], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_wakeChoiceName[i], PlayerGroupSingle(g_teller), true);
        libNtve_gf_SetDialogItemImage(g_wakeChoiceIcon[i], BOTC_IconName(role), PlayerGroupSingle(g_teller));
        if (g_wakeChoiceSource[i] == 0) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("本体：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else if (g_wakeChoiceSource[i] == -1) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("赋予：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else if (g_wakeChoiceSource[i] == -3) {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText(g_roleName[role]), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_wakeChoiceName[i], StringToText("科怪" + IntToString(g_wakeChoiceSource[i] - 1) + "：" + g_roleName[role]), PlayerGroupSingle(g_teller));
        }
    }
    libNtve_gf_SetDialogItemText(g_wakeChoiceTitle, StringToText("【多重能力】" + BOTC_NameStr(q) + "：选择本次唤醒的能力"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个能力图标：只执行选中的这一项。");
}

void BOTC_WakeManualApply (int q) {
    bool was;
    int s;
    int other;
    if (q < 2 || q > 13) {
        return;
    }
    was = g_awake[q];
    BOTC_WakeApply(q, true);
    if (!was && g_awake[q]) {
        if (g_boffinActing[q] && g_boffinActingSource[q] >= 2) {
            g_boffinDoneBy[(g_boffinActingSource[q] * 14) + q] = true;
        }
        if (g_grantActing[q]) {
            g_grantDoneNight[q] = true;
        }
        if (g_bnestActing[q]) {
            g_bnestDoneBy[(g_bnestSource[q] * 14) + q] = true;
        }
        g_insertWake[q] = false;
        g_autoWoke[q] = true;
        // 【手动唤醒沿用自动唤醒的生命周期】（用户 2026-11-08）：插入结算不占用
        //   【结束手动唤醒】，只能靠 g_autoLast 在下一次【唤醒下一个】开头被收回；
        //   不记的话这个人会一直保持唤醒状态，之后手动唤醒他反而变成「取消唤醒」。
        g_autoLast = q;
        if (g_manualWakeInsert) {
            // 【插入结算】（用户 2026-11-08）：只插进这一夜的唤醒顺序，不占用【结束手动唤醒】。
            g_manualWakeInsert = false;
        }
        else {
            g_manualWakeSeat = q;      // 记录这次手动唤醒：主按钮改为【结束手动唤醒】
        }
        g_manualWakeDoneBefore = g_wakeDone;
        g_wakeDone = false;
        // 【手动唤醒也要自动跟他进私聊】（用户 2026-10-16）：统一走 BOTC_TellerPmTo
        BOTC_TellerPmTo(q);
    }
    if (was && !g_awake[q]) {
        g_autoWoke[q] = false;
        g_manualWakeInsert = false;
        // 【结束手动唤醒后还原完成状态】（用户 2026-11-08）：原本已是【已行动完毕】的夜里
        //   手动唤醒再收回，不能让主按钮退回【唤醒下一个】。
        g_wakeDone = g_manualWakeDoneBefore;
        if (g_manualWakeSeat == q) {
            g_manualWakeSeat = 0;
        }
        // 【收回唤醒同步解散本次发起的私聊】（用户 2026-11-04）
        other = g_who[q];
        s = g_mySess[g_teller];
        if (other > 0 && s > 0 && g_sessAlive[s] && g_member[(s * 14) + other]) {
            BOTC_DissolveSessForNight(s);
        }
    }
    BOTC_WakeRender();
}

// 【标记能力使用】（用户 2026-11-11）：说书人工具里的手动开关。
//   点一下按钮，再点圆桌座位；按该座位的**真实身份**找对应的「失去能力」token：
//   没有就打上，已经有就取消。借来的能力（哲学家 / 食人族 / 赋予）不改标记，仍按真身判断。
int BOTC_LoseTokOfRole (int role) {
    if (role == 10) { return 12; }     // 猎手
    if (role == 9) { return 17; }      // 贞洁者
    if (role == 29) { return 47; }     // 侍臣
    if (role == 30) { return 44; }     // 教授
    if (role == 34) { return 46; }     // 弄臣
    if (role == 41) { return 45; }     // 刺客
    if (role == 55) { return 68; }     // 女裁缝
    if (role == 57) { return 69; }     // 艺术家
    if (role == 77) { return 98; }     // 巡山人
    if (role == 78) { return 99; }     // 工程师
    if (role == 79) { return 100; }    // 渔夫
    if (role == 85) { return 104; }    // 灵言师
    if (role == 103) { return 125; }   // 传教士
    if (role == 128) { return 147; }   // 守夜人
    return -1;
}

void BOTC_MarkUseToggleSeat (int q) {
    int role;
    int t;
    int base;
    if (q < 2 || q > 13) {
        return;
    }
    // 一次只处理一个座位（和【手动唤醒】一致），处理完自动退出选座位模式。
    g_markUseMode = false;
    role = BOTC_SeatTrueRole(q);
    if (role < 0) {
        BOTC_NoticeKeep(g_teller, "【标记能力使用】" + BOTC_NameStr(q) + " 还没有身份标记。");
        return;
    }
    t = BOTC_LoseTokOfRole(role);
    if (t < 0) {
        BOTC_NoticeKeep(g_teller, "【标记能力使用】" + BOTC_NameStr(q) + " 是" + BOTC_RoleNameSafe(role) + "，没有对应的「失去能力」标记。");
        return;
    }
    base = (g_teller * 14) + q;
    if (g_tokOn[(base * 256) + t]) {
        g_tokOn[(base * 256) + t] = false;
        BOTC_NoticeKeep(g_teller, "【标记能力使用】已取消 " + BOTC_NameStr(q) + " 的「" + g_tokName[t] + "」。");
    }
    else {
        g_tokOn[(base * 256) + t] = true;
        BOTC_NoticeKeep(g_teller, "【标记能力使用】已给 " + BOTC_NameStr(q) + " 打上「" + g_tokName[t] + "」。");
    }
    BOTC_GrimRender(g_teller);
}

// 【手动唤醒 · 一次点击】（用户 2026-11-08）：点完【手动唤醒】只需再点一个座位：
//   点已醒着的座位 = 收回；有人正醒着 = 把这次唤醒排到下一个唤醒顺序；
//   没人醒着 = 立刻唤醒，并把【唤醒下一个】改成【结束手动唤醒】。
void BOTC_WakeManualPick (int q) {
    int i;
    bool busy;
    if (q < 2 || q > 13) {
        return;
    }
    g_wakeMode = false;
    if (g_awake[q]) {
        BOTC_WakeManualAt(q);
        BOTC_WakeRender();
        return;
    }
    busy = false;
    for (i = 1; i <= 13; i += 1) {
        if (i != q && g_awake[i]) {
            busy = true;
            break;
        }
    }
    if (busy) {
        g_manualWakeQueue = q;
        g_wakeDone = false;
        BOTC_Notice(g_teller, "【手动唤醒】" + BOTC_NameStr(q) + " 已排入下一个唤醒顺序。");
        BOTC_WakeRender();
        return;
    }
    BOTC_WakeManualAt(q);
    BOTC_WakeRender();
}

void BOTC_WakeManualAt (int q) {
    bool was;
    int n;
    if (q < 2 || q > 13) {
        return;
    }
    was = g_awake[q];
    if (!was) {
        // 【首夜固定信息弹窗】（用户 2026-11-09）：手动唤醒离开上一步时同样先按取消收掉。
        BOTC_InfoPopupClosePending();
        // 手工赋予科学怪人时，该座位也成为科怪来源；手动唤醒直接进入选能力网格。
        if (g_grantRoleBy[q] == 133 && g_mark[(g_teller * 14) + q] - 1 != 132) {
            g_awake[q] = true;
            g_autoWoke[q] = true;
            g_autoLast = q;
            if (g_manualWakeInsert) {
                g_manualWakeInsert = false;
            }
            else {
                g_manualWakeSeat = q;
            }
            g_wakeDone = false;
            g_boffinEditSource = q;
            BOTC_BoffinOpenRole(q);
            BOTC_TellerPmTo(q);
            BOTC_WakeRender();
            return;
        }
        n = BOTC_WakeAbilityChoiceBuild(q);
        if (n > 1) {
            BOTC_WakeAbilityChoiceOpen(q);
            return;
        }
        if (n == 1) {
            if (g_wakeChoiceSource[0] >= 2) {
                g_boffinActing[q] = true;
                g_boffinActingSource[q] = g_wakeChoiceSource[0];
                g_grantActing[q] = false;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
            else if (g_wakeChoiceSource[0] == -1) {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = true;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
            else if (g_wakeChoiceSource[0] == -3) {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = false;
                g_bnestActing[q] = true;
                g_bnestSource[q] = BOTC_BoffinNestedWakeSource(q);
            }
            else {
                g_boffinActing[q] = false;
                g_boffinActingSource[q] = 0;
                g_grantActing[q] = false;
                g_bnestActing[q] = false;
                g_bnestSource[q] = 0;
            }
        }
        else {
            g_boffinActing[q] = false;
            g_boffinActingSource[q] = 0;
            g_grantActing[q] = false;
            g_bnestActing[q] = false;
            g_bnestSource[q] = 0;
        }
    }
    BOTC_WakeManualApply(q);
}

// 首夜邪恶情报用：idx 0 = 疯子（没有就 0）、1 = 恶魔、2 / 3 = 第 1 / 第 2 个爪牙
int BOTC_EvilSeatAt (int idx) {
    int i;
    int n;
    if (idx == 0) {
        return BOTC_RealLunaticSeat();       // 真疯子优先（哲学家假装的那个不算，用户 2026-09-21）
    }
    if (idx == 1) {
        for (i = 2; i <= 13; i += 1) {
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                return i;
            }
        }
        return 0;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2 && !BOTC_IsMarionette(i)) {
            n = n + 1;
            if (n == (idx - 1)) {
                return i;
            }
        }
    }
    return 0;
}

// 「脚本已经写好话」的弹窗：只留【确定（发给他）】和【取消】
void BOTC_ManInfoOpenText (int seat, string title, string msg) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：他中毒/酒鬼时能力失效 → 提醒说书人这段信息可以随便给
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(seat) + " 中毒/酒鬼 → 按规则能力失效，这段信息（或要发给他的那句话）可以随便给。");
    }
    g_miRole = 40;
    g_miText = msg;
    // 把「将要发出去的那句话」显示出来给说书人过目（用户 2026-09-21：以前只有确定/取消，看不到内容）
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(msg), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(title)), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给取消
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 【疯子假爪牙的填写上限】（用户 2026-11-06）：默认最多 2 个；当前剧本的板子包含
//   堤丰之首（111）或魔术师（136）时各 +1，最多 4 个。只看剧本，不看在不在场。
int BOTC_LunaticMinionMax () {
    int m;
    m = 2;
    if (BOTC_RoleOnBoard(111)) {
        m += 1;
    }
    if (BOTC_RoleOnBoard(136)) {
        m += 1;
    }
    return m;
}

// 已经填进「疯子假爪牙」弹窗的爪牙数（g_evilA..D 在点【确认】时逐框读入）。
int BOTC_LunaticMinionFilled () {
    int c;
    c = 0;
    if (g_evilA >= 2) { c += 1; }
    if (g_evilB >= 2) { c += 1; }
    if (g_evilC >= 2) { c += 1; }
    if (g_evilD >= 2) { c += 1; }
    return c;
}

// 「填座位号」的弹窗：普通格式两个框；疯子按剧本上限显示 2~4 个框
void BOTC_ManInfoOpenSeats (int seat, string title, int kind) {
    int i;
    int n;
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = seat;
    g_miRole = 41;
    g_miKind = kind;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(title)), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit2, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit3, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miEdit4, StringToText(""), PlayerGroupSingle(g_teller));
    if (kind == 14 || kind == 15 || kind == 17 || kind == 21 || kind == 23 || kind == 24 || kind == 26) {
        // 事务官（14）/ 疯子提线木偶追问（15）/ 寡妇在场告知（17）/ 国王假信息（21）/
        // 疯子假疯子（23）/ 疯子假疯子刀人（24）/ 瘟疫医生相克选座位（26）：只需要填一名玩家的座位号。
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 220, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 232, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    else if (kind == 25) {
        // 疯子以为是奥赫（134）：这里填的是一个角色名，给一个宽一点的输入框。
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 380, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 152, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    else if (kind == 0) {
        // 疯子假爪牙：按当前剧本的填写上限显示 2~4 个框（堤丰之首 / 魔术师各 +1）。
        n = BOTC_LunaticMinionMax();
        i = (648 - ((n * 160) - 20)) / 2;
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit3, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit4, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, i, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, i + 160, 83);
        DialogControlSetPosition(g_miEdit3, PlayerGroupSingle(g_teller), c_anchorTopLeft, i + 320, 83);
        DialogControlSetPosition(g_miEdit4, PlayerGroupSingle(g_teller), c_anchorTopLeft, i + 480, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), n >= 3);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), n >= 4);
    }
    else if (kind == 19) {
        // 疯子假军团：固定最多 4 个。
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit3, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetSize(g_miEdit4, PlayerGroupSingle(g_teller), 140, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 20, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 180, 83);
        DialogControlSetPosition(g_miEdit3, PlayerGroupSingle(g_teller), c_anchorTopLeft, 340, 83);
        DialogControlSetPosition(g_miEdit4, PlayerGroupSingle(g_teller), c_anchorTopLeft, 500, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), true);
    }
    else if (kind == 16 || kind == 18 || kind == 22) {
        // 书生 × 疯子（16）/ 疯子 × 国王（18）/ 店小二告知确认（22）：没有输入框，只让说书人按【确认】/【取消】。
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    else {
        DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 180, 41);
        DialogControlSetSize(g_miEdit2, PlayerGroupSingle(g_teller), 162, 41);
        DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 153, 83);
        DialogControlSetPosition(g_miEdit2, PlayerGroupSingle(g_teller), c_anchorTopLeft, 369, 83);
        DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    }
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    // 【取消键】疯子假爪牙：允许说书人选择完全不发送，例如罂粟种植者局。
    //   疯子提线木偶（15）/ 书生 × 疯子（16）/ 寡妇在场告知（17）/ 疯子 × 国王（18）/
    //   假军团手动善良名单（19）同样允许跳过。
    libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
    if (kind == 0 || kind == 15 || kind == 16 || kind == 17 || kind == 18 || kind == 19 || kind == 21 || kind == 22 || kind == 23 || kind == 24 || kind == 25 || kind == 26) {
        libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 【疯子信息合批】（用户 2026-11-10）：真恶魔在首夜是同一拍一次性收到「爪牙 / 提线木偶 /
//   恶魔」等多条私聊的。疯子这边分三个弹窗依次填写，如果每填完一个就立刻发，疯子能从
//   消息到达的间隔看出这几条不是一起给的。所以先攒进 g_lunInfoLine，整条链填完再一起发。
void BOTC_LunInfoClean () {
    int i;
    for (i = 0; i < 4; i += 1) {
        g_lunInfoLine[i] = "";
    }
    g_lunInfoN = 0;
    g_lunInfoTo = 0;
}

void BOTC_LunInfoAdd (int seat, string line) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (g_lunInfoTo != seat) {
        BOTC_LunInfoClean();
        g_lunInfoTo = seat;
    }
    if (g_lunInfoN >= 0 && g_lunInfoN < 4) {
        g_lunInfoLine[g_lunInfoN] = line;
        g_lunInfoN = g_lunInfoN + 1;
    }
}

void BOTC_LunInfoFlush () {
    int i;
    int j;
    int sent;
    sent = 0;
    if (g_lunInfoTo >= 2 && g_lunInfoTo <= 13) {
        // 【多个疯子】（用户 2026-11-12）：首夜假爪牙 / 提线木偶 / 假疯子这些信息
        //   发给场上所有真疯子，而不是只发给填表时用的那一个座位。
        for (i = 2; i <= 13; i += 1) {
            if (!BOTC_LunaticRealSeat(i)) {
                continue;
            }
            for (j = 0; j < g_lunInfoN; j += 1) {
                BOTC_PmInfo(g_who[i], g_lunInfoLine[j]);
            }
            sent = sent + 1;
        }
        if (sent == 0) {
            // 场上没有真疯子（例如只有哲学家借来的疯子）：沿用原来的单座位发送。
            for (j = 0; j < g_lunInfoN; j += 1) {
                BOTC_PmInfo(g_who[g_lunInfoTo], g_lunInfoLine[j]);
            }
        }
    }
    BOTC_LunInfoClean();
}

// 【疯子 · 提线木偶】（用户 2026-11-01）：假爪牙信息发完后，再问一次说书人
//   要不要额外告诉疯子「某玩家是提线木偶」。点【取消】= 不加这条信息。
//   【场上没有真提线也弹】（用户 2026-11-02）：疯子认知里的提线木偶可能并不在场上，
//   是否告知完全由说书人决定，所以不再按场上是否真有提线木偶提前跳过。
//   【剧本里没有提线就不弹】（用户 2026-11-06）：只在当前剧本的板子包含提线木偶（93）时
//   才追问，否则直接跳过，不再多弹一次空选择窗。
bool BOTC_LunaticMarionetteAsk (int seat) {
    if (seat < 2 || seat > 13) {
        return false;
    }
    if (!BOTC_IsLunatic(seat)) {
        return false;
    }
    if (!BOTC_RoleOnBoard(93)) {
        return false;
    }
    BOTC_ManInfoOpenSeats(seat, "【疯子】可选：填一名假提线木偶的座位号（1~12）；点【取消】跳过", 15);
    return true;
}

// 【疯子 · 假疯子】（用户 2026-11-10）：告诉完疯子爪牙以后，可选再告诉疯子一名「疯子」的座位。
//   和真恶魔会得知「谁是疯子」一样，用来维持疯子以为自己是恶魔的认知。
bool BOTC_LunaticFakeAsk (int seat) {
    if (seat < 2 || seat > 13) {
        return false;
    }
    if (!BOTC_IsLunatic(seat)) {
        return false;
    }
    BOTC_ManInfoOpenSeats(seat, "【疯子】可选：填一名「疯子」的座位号（1~12），让他以为那是疯子；点【取消】跳过", 23);
    return true;
}

// 疯子以为自己是什么恶魔：他魔典上写的就是那只恶魔（真身仍是疯子 38）。
int BOTC_LunFakeBelievedRole (int q) {
    int r;
    if (q < 1 || q > 13) {
        return -1;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return -1;
    }
    return r;
}

// 【疯子 · 假疯子刀人】（用户 2026-11-10）：只要疯子活着，每晚都可选择是否告诉他
//   「（那名假）疯子今晚杀了谁」。他以为自己是奥赫（134）时改填并告知一个角色名。
void BOTC_LunaticFakeKillAsk () {
    int lu;
    lu = g_lunFakeTo;
    if (lu < 2 || lu > 13) {
        return;
    }
    if (g_lunFake < 2) {
        return;
    }
    if (!g_seatOn[lu] || BOTC_SeatDead(lu)) {
        return;
    }
    if (!BOTC_IsLunatic(lu)) {
        return;
    }
    if (BOTC_LunFakeBelievedRole(lu) == 134) {
        BOTC_ManInfoOpenSeats(lu, "【假疯子·奥赫】可选：填「假疯子」今晚杀的角色名；点【取消】跳过", 25);
    }
    else {
        BOTC_ManInfoOpenSeats(lu, "【假疯子】可选：填「假疯子」今晚杀了谁（1~12，多个用英文逗号隔开）；点【取消】跳过", 24);
    }
}

// 按中文角色名反查角色索引；找不到返回 -1。
int BOTC_LunFakeRoleByName (string s) {
    int i;
    if (StringLength(s) <= 0) {
        return -1;
    }
    for (i = 0; i <= 163; i += 1) {
        if (g_roleName[i] == s) {
            return i;
        }
    }
    return -1;
}

// 【疯子 · 假科学怪人能力】（用户 2026-11-10）：剧本里有科学怪人时，科学怪人行动结束后
//   可选给疯子一份「假的善良能力」。他只是以为自己拿到了，面板照常能开，结算什么都不产生。
int BOTC_LunFakeRoleAllowed (int role) {
    if (role < 0 || role > 163) {
        return 0;
    }
    if (BOTC_RoleTeam(role) != 0 && BOTC_RoleTeam(role) != 1) {
        return 0;
    }
    return 1;
}

void BOTC_LunFakeAbilAsk (int seat) {
    int i;
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!g_seatOn[seat] || BOTC_SeatDead(seat) || !BOTC_IsLunatic(seat)) {
        return;
    }
    if (!BOTC_RoleOnBoard(132)) {
        return;
    }
    g_lunFakeEditSeat = seat;
    g_pickMode[g_teller] = 33;
    g_pickWho[g_teller] = 1;
    BOTC_PickFilter(g_teller, false);
    for (i = 0; i < 64; i += 1) {
        if (BOTC_LunFakeRoleAllowed(g_gridSlot[i]) != 0) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(g_teller), false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【疯子·假能力】选一个善良角色"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("跳过"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_LunFakeAbilPick (int role) {
    int lu;
    lu = g_lunFakeEditSeat;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
    g_pickMode[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    if (lu < 2 || lu > 13) {
        return;
    }
    if (role < 0 || role > 163 || BOTC_LunFakeRoleAllowed(role) == 0) {
        BOTC_Notice(g_teller, "只能选一个善良角色。");
        return;
    }
    g_lunFakeAbil = role + 1;
    g_lunFakeAbilTo = lu;
    g_lunFakeNight = g_nightNum;
    g_lunFakeActed = 0;
    BOTC_PmInfo(g_who[lu], "【信息】你得知" + g_roleName[role]);
    BOTC_PmStore(g_teller, "【疯子·假能力】已告诉疯子 " + BOTC_NameStr(lu) + "：他获得了「" + g_roleName[role] + "」能力（这次能力按中毒 / 醉酒处理，效果不生效）。");
}

// 假能力的夜序：和真能力一样按能力表的夜序走，只是同一夜只唤醒一次。
int BOTC_LunFakeNightOrder (int q) {
    int act;
    int o;
    int role;
    if (q < 2 || q > 13) {
        return 0;
    }
    if (g_lunFakeAbil <= 0 || g_lunFakeAbilTo != q) {
        return 0;
    }
    if (!g_seatOn[q] || BOTC_SeatDead(q)) {
        return 0;
    }
    if (g_lunFakeActed == g_nightNum) {
        return 0;
    }
    role = g_lunFakeAbil - 1;
    if (role < 0 || role > 163) {
        return 0;
    }
    if (g_lunFakeNight < 1 || g_nightNum < g_lunFakeNight) {
        return 0;
    }
    act = g_roleAct[role];
    if (act == 2 && g_nightNum == g_lunFakeNight) {
        return 0;
    }
    if (act != 1 && act != 2 && act != 5 && act != 6) {
        return 0;
    }
    if (g_lunFakeNight == g_nightNum) {
        o = BOTC_NoFirstOf(role);
        if (o > 0) {
            return o;
        }
        return BOTC_NoOtherOf(role);
    }
    return BOTC_NoOtherOf(role);
}

// 自动唤醒 + 首夜邪恶情报的进度全部清零（换夜、重新正式开始、取消正式开始都用它）
void BOTC_AutoWakeReset () {
    int i;
    int j;
    for (i = 0; i <= 13; i += 1) {
        g_autoWoke[i] = false;
        g_insertWake[i] = false;
        g_boffinActing[i] = false;
        g_boffinActingSource[i] = 0;
        g_grantActing[i] = false;
        g_grantDoneNight[i] = false;
        g_bnestActing[i] = false;
        g_bnestSource[i] = 0;
        g_pedantActing[i] = false;
        g_lunFakeAct[i] = false;      // 【疯子·假能力】只是「这一夜正在按假能力唤醒」，换夜要清
        for (j = 0; j <= 13; j += 1) {
            g_boffinDoneBy[(i * 14) + j] = false;
            g_bnestDoneBy[(i * 14) + j] = false;
        }
    }
    g_autoOn = false;
    g_autoLast = 0;
    g_wakeCd = 0;
    g_wakeCurrentOrd = 0;
    g_nightCursorOrd = 0;
    g_evilStep = 0;
    g_lgPend = false;
    // 【首夜不在场身份弹窗】（用户 2026-11-04）：换夜 / 重新开始时一并收掉
    g_bluffAskOn = false;
    g_bluffAskQi = 0;
    g_bluffAskQn = 0;
    if (g_bluffAskDlg > 0) {
        DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
    }
}

// 【首夜固定信息是否应该让位给更早的角色行动】
//   官网当前顺序：爪牙信息 11 → 告密者 12 → 落难少女 13 → 疯子 15 → 恶魔信息 17。
//   例如哲学家 6 / 炼金术士 7 / 科学怪人赋予的早期能力，必须先于爪牙信息行动。
bool BOTC_FirstNightInfoHasEarlierWake (int ord) {
    int i;
    int q;
    int r;
    int o;
    int bo;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (g_autoWoke[q]) {
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r == 136 || r == 141) {
            continue;                       // 只作为夜序提示，不占唤醒位
        }
        o = BOTC_NightOrderOf(q);
        if (o > 0 && o < ord && !BOTC_WakeSkipNow(q)) {
            return true;
        }
    }
    // 科学怪人借给恶魔的能力也要按该能力自己的夜序先行动。
    bo = BOTC_BoffinWakeSeat();
    if (bo >= 2 && !g_autoWoke[bo]) {
        o = BOTC_BoffinWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    bo = BOTC_GrantWakeSeat();
    if (bo >= 2) {
        o = BOTC_GrantWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    bo = BOTC_BoffinNestedWakeSeat();
    if (bo >= 2) {
        o = BOTC_BoffinNestedWakeOrder(bo);
        if (o > 0 && o < ord) {
            return true;
        }
    }
    return false;
}

int BOTC_MagicianSeatNow () {
    int m;
    m = BOTC_AbilitySeat(136);
    if (m < 2 || m > 13) {
        return 0;
    }
    if (BOTC_SeatDead(m)) {
        return 0;
    }
    // 相克：维齐尔在场时，魔术师没有能力。
    if (BOTC_AbilityInPlay(141)) {
        return 0;
    }
    return m;
}

// 全角色技能面板只用目标类型作标题，不显示角色名、效果说明或括号注释。
string BOTC_SkillPickText (int n) {
    if (n >= 3) {
        return "选择三名玩家";
    }
    if (n == 2) {
        return "选择两名玩家";
    }
    return "选择一名玩家";
}

string BOTC_SkillPickTextFor (int p) {
    int n;
    if (BOTC_ActRoleOf(p) == 163) {
        return "选择至多三名玩家";
    }
    n = BOTC_TargetsOf(p);
    if (BOTC_TargetMustBeLiving(p)) {
        if (n >= 3) {
            return "选择三名存活玩家";
        }
        if (n == 2) {
            return "选择两名存活玩家";
        }
        return "选择一名存活玩家";
    }
    return BOTC_SkillPickText(n);
}

// 夜间唤醒时采用「先确认是否发动」的限次角色。
bool BOTC_NightLimitRole (int r) {
    return (r == 29 || r == 30 || r == 41 || r == 55 || r == 56 || r == 77 || r == 78 || r == 109 || r == 124 || r == 128);
}

bool BOTC_NightLimitUsed (int p, int r) {
    if (r == 29) { return g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]; }
    if (r == 30) { return g_profUsed[p]; }
    if (r == 41) { return g_assiUsed[p]; }
    if (r == 55) { return g_tokOn[(((g_teller * 14) + p) * 256) + 68]; }
    if (r == 56) { return g_tokOn[(((g_teller * 14) + p) * 256) + 70]; }
    if (r == 77) { return g_tokOn[(((g_teller * 14) + p) * 256) + 98]; }
    if (r == 78) { return g_tokOn[(((g_teller * 14) + p) * 256) + 99]; }
    if (r == 109) { return g_tokOn[(((g_teller * 14) + p) * 256) + 130]; }
    if (r == 124) { return g_tokOn[(((g_teller * 14) + p) * 256) + 145]; }
    if (r == 128) { return g_tokOn[(((g_teller * 14) + p) * 256) + 147]; }
    return false;
}

string BOTC_LimitedAskText (int p, int r) {
    string pick;
    if (p < 1 || p > 13 || r < 0 || r > 163) {
        return "是否发动能力？";
    }
    pick = "选择一名玩家";
    if (r == 29) { pick = "选择一个角色"; }
    if (r == 30) { pick = "选择一名已死亡玩家"; }
    if (r == 46) { pick = "选择一名玩家"; }
    if (r == 55) { pick = "选择除你以外的两名玩家"; }
    if (r == 56) { pick = "选择一个善良角色"; }
    if (r == 77) { pick = "选择一名存活玩家"; }
    if (r == 78) { pick = "选择恶魔或爪牙角色"; }
    if (r == 124) { pick = "选择一个镇民角色"; }
    return "是否发动能力（" + pick + "）";
}

bool BOTC_LimitedAskOpen (int p) {
    int r;
    if (p < 1 || p > 13) {
        return false;
    }
    r = BOTC_ActRoleOf(p);
    if (!BOTC_NightLimitRole(r)) {
        return false;
    }
    if (BOTC_NightLimitUsed(p, r)) {
        return false;
    }
    // 先只显示是 / 否，不显示任何目标槽或角色信息。
    g_limitedAsk[p] = true;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText(BOTC_LimitedAskText(p, r)), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
    DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("是"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("否"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    return true;
}

void BOTC_LimitedAccept (int p) {
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (g_limitedAsk[p] && r == 162) {
        g_limitedAsk[p] = false;
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_GudiaoAnswer(p, true);
        return;
    }
    if (!g_limitedAsk[p] || !BOTC_NightLimitRole(r)) {
        return;
    }
    g_limitedAsk[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
    if (r == 29) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_CourtierOpen(p);
        return;
    }
    if (r == 56) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PhiloOpen(p);
        return;
    }
    if (r == 78) {
        // 工程师：确认发动后打开专用面板；真正提交才消耗 token 99，
        //   点【取消（不使用能力）】不消耗，仍算这次没有使用能力。
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_EngOpen(p);
        return;
    }
    if (r == 124) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_DrossOpen(p);
        return;
    }
    // 其余限次角色进入通用座位面板；确认发动后只保留【确认】。
    g_skillPicking[p] = true;
    BOTC_SkillRender(p);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_Notice(g_who[p], BOTC_SkillPickTextFor(p));
}

void BOTC_LimitedDecline (int p) {
    int r;
    if (!g_limitedAsk[p]) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    g_limitedAsk[p] = false;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (r == 162) {
        BOTC_GudiaoAnswer(p, false);
        return;
    }
    BOTC_Notice(g_who[p], "这次不发动技能。");
    BOTC_PmStore(g_teller, "【限次技能】" + BOTC_NameStr(p) + " 选择这次不发动，本局机会仍然保留。");
}

bool BOTC_PoAskOpen (int p) {
    if (p < 1 || p > 13 || BOTC_ActRoleOf(p) != 46) {
        return false;
    }
    if (BOTC_ProtectTokOn(p, 52)) {
        return false;                 // 已经憋刀：这一夜直接强制三目标
    }
    g_poAsk[p] = true;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText(BOTC_LimitedAskText(p, 46)), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
    DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("是"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("否"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    return true;
}

void BOTC_PoAskAnswer (int p, bool use) {
    if (p < 1 || p > 13 || !g_poAsk[p] || BOTC_ActRoleOf(p) != 46) {
        return;
    }
    g_poAsk[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
    if (!use) {
        g_skillPicking[p] = false;
        g_tokOn[(((g_teller * 14) + p) * 256) + 52] = true;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_Notice(g_who[p], "你选择了不发动技能。");
        BOTC_PmStore(g_teller, "【珀】" + BOTC_NameStr(p) + " 选择憋刀：下一夜必须选择三名玩家，再下一夜重新询问。");
        BOTC_GrimRender(g_teller);
        return;
    }
    g_skillPicking[p] = true;
    BOTC_SkillRender(p);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_Notice(g_who[p], "选择一名玩家");
}

bool BOTC_SummonerCanUseRole (int role) {
    if (role < 0 || role > 163 || BOTC_RoleTeam(role) != 3) {
        return false;
    }
    if (!BOTC_BoardHasRole(role)) {
        return false;                      // 只能召唤当前剧本实际包含的恶魔
    }
    if (g_summonerDone) {
        return false;
    }
    if (g_nightNum == 3) {
        return true;
    }
    if (g_nightNum == 2) {
        return (role == 44 || (role == 163 && BOTC_BoardHasRole(163)));
    }
    return false;
}

void BOTC_SummonerGridCatalog (int p) {
    int r;
    int n;
    int t;
    for (t = 0; t < 4; t += 1) {
        g_gridCatN[t] = 0;
    }
    for (r = 0; r < 512; r += 1) {
        g_gridCatRole[r] = -1;
    }
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (g_roleName[r] == "" || BOTC_RoleTeam(r) != 3 || r == 146 || !BOTC_BoardHasRole(r)) {
            continue;
        }
        if (g_nightNum == 2 && r != 44 && !(r == 163 && BOTC_BoardHasRole(163))) {
            continue;
        }
        if (n >= 128) {
            break;
        }
        g_gridCatRole[(3 * 128) + n] = r;
        n = n + 1;
    }
    g_gridCatN[3] = n;
    for (t = 0; t < 4; t += 1) {
        g_pickCatPageBy[(p * 4) + t] = 1;
    }
}

int BOTC_SummonerSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_seatOn[q] && BOTC_HasAbility(q, 150)) {
            return q;
        }
    }
    return 0;
}

bool BOTC_SummonerWaiting () {
    return (g_summonerPending && !g_summonerDone);
}

void BOTC_SummonerFail () {
    if (g_gameOver || !g_started) {
        return;
    }
    BOTC_PmStore(g_teller, "【召唤师】本次没有成功创造恶魔。按当前项目口径，不自动判定善良胜利；是否因失去能力、死亡或其他规则获胜，由说书人手动裁定。");
    BOTC_Notice(g_teller, "召唤师本次未成功创造恶魔：系统不会自动判胜，请说书人裁定。");
}

bool BOTC_SummonerLmCheck (int target, int role) {
    if (target < 2 || target > 13 || role != 112) {
        return false;
    }
    g_lmOn = true;
    g_lmSeat = target;
    BOTC_PmStore(g_teller, "【召唤师×小怪宝】" + BOTC_NameStr(target) + " 被召唤为小怪宝，本局切换为小怪宝结算。");
    return true;
}

void BOTC_SummonerSummon (int p, int target, int role) {
    bool targetWasDead;
    int i;
    if (p < 1 || p > 13 || target < 2 || target > 13 || role < 0 || role > 163) {
        return;
    }
    if (!BOTC_SummonerCanUseRole(role)) {
        if (g_nightNum == 2) {
            BOTC_Notice(g_who[p], "召唤师在第二个夜晚只能召唤普卡；若典狱长在剧本中，也可以召唤典狱长。");
        }
        else if (g_nightNum == 3) {
            BOTC_Notice(g_who[p], "请选择一个恶魔角色。");
        }
        else {
            BOTC_Notice(g_who[p], "召唤师只能在第二个夜晚召唤普卡或剧本中的典狱长，或在第三个夜晚创造恶魔。");
        }
        return;
    }
    if (!BOTC_AbilityWorks(p, 150)) {
        if (g_nightNum == 3) {
            BOTC_SummonerFail();
        }
        else {
            BOTC_PmStore(g_teller, "【召唤师】第二夜召唤普卡失败：召唤师当时中毒 / 醉酒，仍保留第三夜召唤机会。");
        }
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    targetWasDead = BOTC_SeatDead(target);
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时不能再创造新的邪恶恶魔。
    if (BOTC_HolySoulBlocks(target)) {
        BOTC_PmStore(g_teller, "【召唤师×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(target) + " 不能再转变为邪恶，本次召唤未生效。");
        BOTC_Notice(g_teller, "召唤未生效：圣洁之魂限制本局邪恶玩家已达上限。");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (g_nightNum == 3) {
            BOTC_SummonerFail();
        }
        return;
    }
    BOTC_SetSeatRole(g_teller, target, role);
    BOTC_SetSeatRole(g_who[target], target, role);
    if (BOTC_SeatTrueRole(target) != role) {
        BOTC_PmStore(g_teller, "【召唤师】身份写入失败：目标没有变成 " + g_roleName[role] + "，本次召唤不消耗。");
        BOTC_Notice(g_teller, "召唤没有生效：身份写入失败，请检查目标是否允许变成该恶魔。");
        return;
    }
    g_tokOn[(((g_teller * 14) + target) * 256) + 14] = false;
    g_tokOn[(((g_teller * 14) + target) * 256) + 15] = true;
    if (role == 43) {
        if (targetWasDead) {
            // 旧死亡 token 必须先撤掉；僵怖的“已死过一次”由 58 和 g_zombUsed 记录，
            // 红叉只保留公开的假死外观。
            for (i = 0; i < g_deathN; i += 1) {
                g_tokOn[(((g_teller * 14) + target) * 256) + g_deathTok[i]] = false;
            }
            for (i = 32; i <= 41; i += 1) {
                g_tokOn[(((g_teller * 14) + target) * 256) + i] = false;
            }
            g_tokOn[(((g_teller * 14) + target) * 256) + 11] = false;
            g_tokOn[(((g_teller * 14) + target) * 256) + 56] = false;
            g_tokOn[(((g_teller * 14) + target) * 256) + 57] = false;
            g_tokOn[(((g_teller * 14) + target) * 256) + 112] = false;
            g_tokOn[(((g_teller * 14) + target) * 256) + 143] = false;
            g_tokOn[(((g_teller * 14) + target) * 256) + 157] = false;
            g_deadKind[target] = 0;
            g_deadByDemon[target] = 0;
            g_deadType[target] = -1;
            g_deadNightNum[target] = 0;
            g_deadDay[target] = 0;
            g_deadPending[target] = false;
            g_deadShown[target] = true;
        }
        g_zombUsed[target] = targetWasDead;
        g_zombFake[target] = targetWasDead;
        g_tokOn[(((g_teller * 14) + target) * 256) + 58] = targetWasDead;
        if (targetWasDead) {
            BOTC_PmStore(g_teller, "【召唤师×僵怖】" + BOTC_NameStr(target) + " 原本已死亡 → 变成已经假死过一次的僵怖：保留“假死”状态，内部视为存活，下一次死亡才会真正死亡。");
        }
    }
    BOTC_SummonerLmCheck(target, role);
    g_summonerPending = false;
    g_summonerDone = true;
    g_awake[target] = false;
    g_autoWoke[target] = false;
    g_testWoke[target] = false;
    g_insertWake[target] = false;
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[target]);
    BOTC_ChangeRoleMsg(target, role);
    BOTC_PmStore(g_teller, "【召唤师】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(target) + "，他变成邪恶的" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【召唤师】新恶魔会在后续恶魔夜序行动；爪牙与他不会自动互认。");
    // 【召唤师 × 提线木偶】（用户 2026-11-12）：新恶魔出现后，提线木偶要重新与恶魔邻座。
    BOTC_MarionetteSeatAlign();
}

bool BOTC_ComboRole (int r) {
    return (r == 27 || r == 66 || r == 67 || r == 150);
}

void BOTC_ComboRoleOpen (int p) {
    int cp;
    int k;
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    cp = g_who[p];
    g_pickMode[cp] = 41;
    g_pickWho[cp] = p;
    if (r == 66) {
        BOTC_PickFilter(cp, true);
        BOTC_CerenShowGoblin(cp);
    }
    else if (r == 150) {
        g_pickTeam = 3;
        BOTC_PickFilter(cp, false);
        for (k = 0; k < 64; k += 1) {
            if (BOTC_RoleTeam(g_gridSlot[k]) == 3) {
                continue;
            }
            DialogControlSetVisible(g_pickBtn[k], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickIcon[k], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickName[k], PlayerGroupSingle(cp), false);
        }
        if (g_nightNum == 2) {
            BOTC_Notice(cp, "第二个夜晚只能召唤普卡或剧本中的典狱长。");
        }
    }
    else {
        BOTC_PickFilter(cp, false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("返回"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_ComboResolve (int p) {
    int r;
    int t;
    int role;
    int k;
    r = BOTC_ActRoleOf(p);
    if (!BOTC_ComboRole(r)) {
        return;
    }
    t = g_skillT1[p];
    role = g_skillRoleSel[p] - 1;
    if (t < 2 || t > 13) {
        BOTC_Notice(g_who[p], "先选择目标1。");
        return;
    }
    if (role < 0 || role > 163) {
        BOTC_Notice(g_who[p], "请先选择一个角色。");
        return;
    }
    if (r == 150) {
        if (!BOTC_SummonerCanUseRole(role)) {
            if (g_nightNum == 2) {
                BOTC_Notice(g_who[p], "召唤师在第二个夜晚只能召唤普卡；若典狱长在剧本中，也可以召唤典狱长。");
            }
            else {
                BOTC_Notice(g_who[p], "请选择一个恶魔角色。");
            }
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_SummonerSummon(p, t, role);
        return;
    }
    // 赌徒（27）可以选择任何玩家，包括已死亡玩家（与内置百科文案一致）
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (r == 27) {
        g_gambleTarget[p] = t;
        g_gambleWait[p] = false;
        BOTC_GambleGuess(p, role);
    }
    else if (r == 66) {
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【洗脑师】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效（没有让他疯狂）。");
        }
        else {
            BOTC_CerenApply(p, t, role);
        }
    }
    else if (r == 67) {
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效（没有改造任何人）。");
        }
        else {
            for (k = 2; k <= 13; k += 1) {
                g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
            }
            g_hagPick = false;
            g_hagWho = t;
            g_hagActor = p;
            BOTC_HagApply(t, role);
        }
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    g_skillRoleSel[p] = 0;
}

// 食人魔（148）：首夜选择朋友后静默加入其当时阵营。
// 自身中毒 / 醉酒不影响；只有陌客相克例外会让他得知自己变成了邪恶。
void BOTC_OgreResolve (int p, int target) {
    int targetAlign;
    int i;
    bool learnEvil;
    bool hagCreated;
    if (p < 2 || p > 13 || target < 2 || target > 13 || p == target || !g_seatOn[target]) {
        return;
    }
    // 【食人魔按真实阵营】（用户 2026-11-12）：不再读伪装 / 登记层。
    targetAlign = BOTC_SeatAlign(target);
    if (targetAlign < 0) {
        targetAlign = 0;
    }
    // 间谍真身本来就是邪恶、陌客真身本来就是善良，直接按真身算即可。
    learnEvil = false;
    // 相克：麻脸巫婆创造的邪恶食人魔不能通过自身能力变回善良。
    hagCreated = g_tokOn[(((g_teller * 14) + p) * 256) + 74];
    if (hagCreated && BOTC_SeatAlign(p) == 1 && targetAlign == 0) {
        targetAlign = 1;
        BOTC_PmStore(g_teller, "【食人魔×麻脸巫婆】" + BOTC_NameStr(p) + " 是被创造的邪恶食人魔，不能因自身能力变成善良。");
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时不能再新增邪恶，保持善良。
    if (targetAlign == 1 && BOTC_HolySoulBlocks(p)) {
        targetAlign = 0;
        BOTC_PmStore(g_teller, "【食人魔×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(p) + " 保持善良阵营。");
    }
    g_tokOn[(((g_teller * 14) + p) * 256) + 14] = false;
    g_tokOn[(((g_teller * 14) + p) * 256) + 15] = false;
    if (targetAlign == 1) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 15] = true;
    }
    else {
        g_tokOn[(((g_teller * 14) + p) * 256) + 14] = true;
    }
    // 【挚友（207）】（用户 2026-11-11）：自动放在被选择的玩家旁；食人魔离场时由 BOTC_SourceGoneCleanup 收掉。
    for (i = 1; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 207] = false;
    }
    g_tokOn[(((g_teller * 14) + target) * 256) + 207] = true;
    BOTC_PairClearSeat(p);
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【食人魔】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(target) + "，现在是" + BOTC_AlignName(BOTC_SeatAlign(p)) + "阵营。");
    if (learnEvil) {
        BOTC_PmInfo(g_who[p], "【阵营转变】你现在是邪恶阵营。");
        BOTC_PmStore(g_teller, "【食人魔×陌客】已告诉 " + BOTC_NameStr(p) + "：他现在是邪恶阵营。");
    }
}

// 食人魔（148）「挚友」：朋友阵营变化后持续同步，食人魔始终与被标记的玩家同阵营。
void BOTC_OgreFriendSync () {
    int f;
    int q;
    int fa;
    bool changed;
    bool hagCreated;
    if (!g_started) {
        return;
    }
    f = 0;
    for (q = 1; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 207]) {
            f = q;
            break;
        }
    }
    if (f <= 0) {
        return;
    }
    // 【食人魔按真实阵营】（用户 2026-11-12）：挚友阵营变化也读真身。
    fa = BOTC_SeatAlign(f);
    if (fa < 0) {
        fa = 0;
    }
    changed = false;
    for (q = 2; q <= 13; q += 1) {
        if (q == f || BOTC_SeatTrueRole(q) != 148) {
            continue;
        }
        if (fa == 1) {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 15]) {
                continue;
            }
            // 圣洁之魂：邪恶名额已满时不能新增邪恶。
            if (BOTC_HolySoulBlocks(q)) {
                continue;
            }
            g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;
            changed = true;
        }
        else {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 14]) {
                continue;
            }
            // 麻脸巫婆创造的邪恶食人魔不能通过自身能力变回善良。
            hagCreated = g_tokOn[(((g_teller * 14) + q) * 256) + 74];
            if (hagCreated && BOTC_SeatAlign(q) == 1) {
                continue;
            }
            g_tokOn[(((g_teller * 14) + q) * 256) + 15] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 14] = true;
            changed = true;
        }
    }
    if (changed) {
        BOTC_GrimRender(g_teller);
    }
}

void BOTC_SendFirstNightMinionInfo () {
    int i;
    int q;
    int dm;
    int mag;
    int dn;
    int n;
    string s;
    string s2;
    string sd;
    dm = BOTC_EvilSeatAt(1);
    if (dm < 2) {
        BOTC_PmStore(g_teller, "【邪恶信息】场上没有真恶魔：首夜爪牙信息跳过。");
        return;
    }
    mag = BOTC_MagicianSeatNow();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2 || BOTC_IsMarionette(q)) {
            continue;
        }
        sd = "";
        s2 = "";
        dn = 0;
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (i == q) {
                continue;
            }
            if (g_seatOn[i] && (i == dm || i == mag)) {
                if (dn > 0) {
                    sd = sd + ",";
                }
                sd = sd + BOTC_NameStr(i);
                dn = dn + 1;
            }
            if (g_seatOn[i] && BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2 && !BOTC_IsMarionette(i)) {
                if (n > 0) {
                    s2 = s2 + ",";
                }
                s2 = s2 + BOTC_NameStr(i);
                n = n + 1;
            }
        }
        // 魔术师与真恶魔合并成一列，并按座位号自然排列，不能把魔术师固定追加在末尾。
        s = "【信息】你得知" + sd + "是恶魔。";
        if (n > 0) {
            s = s + "爪牙：" + s2 + "。";
        }
        else {
            s = s + "本局没有其他爪牙。";
        }
        BOTC_PmInfo(g_who[q], s);
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「" + s + "」");
    }
}

void BOTC_SendFirstNightDemonInfo () {
    int i;
    int q;
    int n;
    int mag;
    string s;
    string s2;
    mag = BOTC_MagicianSeatNow();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 3) {
            continue;
        }
        s2 = "";
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i]) {
                continue;
            }
            if (BOTC_IsMarionette(i) && i != mag) {
                continue;
            }
            // 魔术师和真爪牙在同一轮按座位号排列，避免总被追加到末尾而暴露。
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2 && i != mag) {
                continue;
            }
            if (n > 0) {
                s2 = s2 + ",";
            }
            s2 = s2 + BOTC_NameStr(i);
            n = n + 1;
        }
        if (n > 0) {
            s = "【信息】你得知" + s2 + " 是爪牙。";
        }
        else {
            s = "【信息】你得知没有爪牙。";
        }
        BOTC_PmInfo(g_who[q], s);
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「" + s + "」");
    }
}

// 单独把真实的提线木偶告知所有恶魔；首夜延后到提线木偶自己的行动轮次，
// 罂粟种植者触发的即时互认则可在互认完成后立即调用。
// 【一局一次】（用户 2026-11-13）：恶魔只需要知道一次「谁是提线木偶」，
//   罂粟种植者生效时首夜已经发过，死亡后的互认不再重复发同一条。
void BOTC_SendMarionetteToDemons () {
    int i;
    int q;
    int mi;
    int mag;
    int sent;
    string ms;
    if (g_marionetteSent) {
        return;
    }
    mag = BOTC_MagicianSeatNow();
    ms = "";
    mi = 0;
    for (i = 2; i <= 13; i += 1) {
        // 【提线木偶 × 魔术师】（用户 2026-11-12）：魔术师存活时，恶魔不会得知谁是提线木偶。
        if (!g_seatOn[i] || !BOTC_IsMarionette(i) || mag >= 2) {
            continue;
        }
        if (mi > 0) {
            ms = ms + ",";
        }
        ms = ms + BOTC_NameStr(i);
        mi = mi + 1;
    }
    if (mi > 0) {
        sent = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 3) {
                continue;
            }
            BOTC_PmInfo(g_who[q], "【信息】你得知" + ms + " 是提线木偶。");
            BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(q) + "：「你得知" + ms + " 是提线木偶。」");
            sent = sent + 1;
        }
        if (sent > 0) {
            g_marionetteSent = true;
        }
    }
    else {
        BOTC_PmStore(g_teller, "【提线木偶】本局没有可告知恶魔的提线木偶。");
    }
}

// 【提线木偶首夜行动位】（用户 2026-11-10）：爪牙信息之后，等到提线木偶自己的
// 夜间轮次再单独把“谁是提线木偶”发给所有恶魔；随后再询问是否给疯子发一条假提线。
void BOTC_SendFirstNightMarionetteInfo () {
    int i;
    int lu;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && BOTC_IsMarionette(i)) {
            // 提线木偶只在这里由说书人转述给恶魔，不再作为本人角色被额外唤醒。
            g_autoWoke[i] = true;
            g_testWoke[i] = true;
        }
    }
    BOTC_SendMarionetteToDemons();
    lu = BOTC_RealLunaticSeat();
    if (lu >= 2 && !BOTC_SeatDead(lu) && BOTC_LunaticMarionetteAsk(lu)) {
        return;
    }
    BOTC_PmStore(g_teller, "【疯子·提线木偶】本次没有额外发送假提线信息。");
}

// 【罂粟种植者 · 死亡后的邪恶互认】（用户 2026-11-06）
//   自动发送互认信息：爪牙与恶魔互相认识（提线木偶不参与），恶魔额外得知提线木偶；
//   有疯子时按首夜口径让说书人填写假爪牙。
void BOTC_PoppyRecognize () {
    int lu;
    g_poppyEvilPend = false;
    g_poppyEvilNight = 0;
    g_poppyEvilWaitOrd = 0;
    BOTC_PmStore(g_teller, "【罂粟种植者】现在进行邪恶互认：爪牙和恶魔互相认识（提线木偶不参与）。");
    BOTC_Notice(g_teller, "【罂粟种植者】邪恶互认：已自动发送互认信息。");
    if (BOTC_LegionOn()) {
        BOTC_LegionRecognize();
        return;
    }
    if (g_lmOn && !BOTC_LmHasDemon()) {
        BOTC_PmStore(g_teller, "【罂粟种植者】场上没有恶魔（小怪宝）：邪恶互认跳过。");
        return;
    }
    BOTC_SendFirstNightMinionInfo();
    lu = BOTC_RealLunaticSeat();
    if (lu >= 2 && !BOTC_SeatDead(lu)) {
        BOTC_LunaticInfo();
    }
    BOTC_SendFirstNightDemonInfo();
    BOTC_SendMarionetteToDemons();
}

// 【首夜固定信息 · 官网最新顺序】（用户 2026-10-21）
//   g_evilStep：0 = 爪牙信息（第 11 位）、1 = 落难少女（第 13 位）、
//               2 = 疯子假爪牙（第 15 位）、3 = 恶魔信息（第 17 位）、
//               4 = 提线木偶信息（第 19 位）。
//   每一步先看有没有更早的角色该行动，没有才执行本步；所以不会再把整套邪恶信息抢到开局。
bool BOTC_AutoWakeEvilStep () {
    int ord;
    int q;
    if (g_nightNum != 1) {
        return false;
    }
    while (g_evilStep < 5) {
    if (g_evilStep == 0) {
        ord = 11;
    }
    else if (g_evilStep == 1) {
        ord = 13;
    }
    else if (g_evilStep == 2) {
        ord = 15;
    }
    else if (g_evilStep == 3) {
        ord = 17;
    }
    else {
        ord = 19;
    }
    if (BOTC_FirstNightInfoHasEarlierWake(ord)) {
        return false;
    }
    g_autoOn = true;
    if (g_evilStep == 0) {
        g_evilStep = g_evilStep + 1;
        if (BOTC_PoppyActive()) {
            BOTC_PmStore(g_teller, "【罂粟种植者】跳过他造成的爪牙互认。");
        }
        else if (BOTC_LegionOn()) {
            BOTC_LegionRecognize();
        }
        else if (g_lmOn && !BOTC_LmHasDemon()) {
            BOTC_PmStore(g_teller, "【小怪宝】场上没有恶魔：爪牙互认跳过。");
        }
        else {
            BOTC_SendFirstNightMinionInfo();
        }
        BOTC_WakeRender();
        return true;
    }
    if (g_evilStep == 1) {
        g_evilStep = g_evilStep + 1;
        if (BOTC_DamselSeat() >= 2) {
            BOTC_DamselDealInfo();
            BOTC_PmStore(g_teller, "【落难少女】已通知所有爪牙「落难少女在场」。");
            BOTC_WakeRender();
            return true;
        }
        // 本局没有落难少女：不占唤醒位，继续判断下一个固定信息。
        continue;
    }
    if (g_evilStep == 2) {
        g_evilStep = g_evilStep + 1;
        q = BOTC_RealLunaticSeat();
        if (q < 2) {
            // 本局没有真疯子：不占唤醒位，继续判断恶魔信息或更早的角色。
            continue;
        }
        else if (BOTC_LegionLunatic()) {
            if (BOTC_LegionOn()) {
                BOTC_PmStore(g_teller, "【疯子】他以为自己是「军团」→ 已在军团阶段由说书人手动填写善良玩家。");
            }
            else {
                // 【军团 × 疯子】（用户 2026-11-10）：真恶魔不是军团，但疯子以为自己是军团 →
                //   按军团口径让说书人手动填写善良玩家名单。
                g_lgPend = true;
                BOTC_ManInfoOpenSeats(q, "【军团】疯子以为自己是军团：手动填 1~4 名善良玩家；点【取消】= 不发送", 19);
                libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定"), PlayerGroupSingle(g_teller));
            }
        }
        else {
            BOTC_LunaticInfo();
        }
        BOTC_WakeRender();
        return true;
    }
    if (g_evilStep == 3) {
        // 第 17 位恶魔信息。疯子若还没按第 15 位被正常唤醒，
        // 上面的「更早角色」检查会先放他去行动，等他回来后才会走到这里。
        g_evilStep = g_evilStep + 1;
        if (BOTC_PoppyActive()) {
            BOTC_PmStore(g_teller, "【罂粟种植者】跳过他造成的恶魔互认。");
        }
        else if (BOTC_LegionOn()) {
            BOTC_PmStore(g_teller, "【军团】已在爪牙信息阶段获得全部善良玩家座位。");
        }
        else if (g_lmOn && !BOTC_LmHasDemon()) {
            BOTC_PmStore(g_teller, "【小怪宝】场上没有恶魔：恶魔信息跳过。");
        }
        else {
            BOTC_SendFirstNightDemonInfo();
        }
        // 【不在场身份改回右下角手动发送】（用户 2026-11-04）：首夜不再自动弹出发送框。
        if (!BOTC_LegionOn()) {
            BOTC_NotifyDemonsLunatic();
        }
        BOTC_WakeRender();
        return true;
    }

    // g_evilStep == 4：提线木偶自己的首夜第 19 位。
    g_evilStep = g_evilStep + 1;
    BOTC_PmStore(g_teller, "【提线木偶】到达其首夜行动轮次：先把提线身份单独告知所有恶魔。");
    BOTC_SendFirstNightMarionetteInfo();
    BOTC_WakeRender();
    return true;
    }
    return false;
}

// 自动唤醒用：这个座位今晚要不要跳过（规则上不能醒 + 说书人打的 token 说他今晚不能动）
//   僵怖：带着「死于今日（僵怖）」= 今天有人死 → 不唤醒；
//   教父：没有「死于今日（教父）」= 今天没有外来者死 → 不能动手，不唤醒；
//   被驱魔人点名的恶魔：带着「被选择（驱魔人）」→ 不唤醒。
bool BOTC_WakeSkipNow (int q) {
    int r;
    int r2;
    if (q < 2 || q > 13) {
        return true;
    }
    if (!BOTC_CanWakeAt(q)) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 31)) {
        return true;
    }
    r = BOTC_SeatTrueRole(q);
    // 【小怪宝（112）】（用户 2026-10-10）：小怪宝本人不行动 —— 只有身上带着「是恶魔（小怪宝）」的那个人才行动
    if (r == 112 && !g_tokOn[(((g_teller * 14) + q) * 256) + 134]) {
        return true;
    }
    if (r == 43 && BOTC_ProtectTokOn(q, 57)) {
        return true;
    }
    if (BOTC_HasAbility(q, 39) && !BOTC_ProtectTokOn(q, 56) && !BOTC_GodfatherCanKill() && g_nightNum > g_seatFirstNight[q]) {
        return true;                            // 教父：今天没有外来者死（也不是他的首夜）→ 今晚不唤醒
    }
    r2 = g_mark[(g_teller * 14) + q] - 1;
    if (r2 == 155 && (g_skinTarget[q] >= 2 || g_skinChainBroken[q])) {
        return true;
    }
    if (r2 == 43 && BOTC_SomeoneDiedToday()) {
        return true;                            // 僵怖：今天有人死 → 不唤醒（疯子以为自己是僵怖也一样）
    }
    // 送葬者：今天没人被处决，或处决对象没有真的死亡 → 不进入自动唤醒队列。
    //   这里只拦自动流程；说书人手动唤醒仍可强制打开。
    if (r2 == 6 && !BOTC_ExecutedDeathToday()) {
        return true;
    }
    if (r2 == 147) {
        return true;
    }
    if (r2 == 36) {
        return true;                            // 月之子（36）：夜里不唤醒，他的选择在「死亡公开」那一下走
    }
    if (r2 == 29 && g_courtUsed[q]) {
        return true;
    }
    if (r2 == 30 && g_profUsed[q]) {
        return true;
    }
    if (r2 == 41 && g_assiUsed[q]) {
        return true;
    }
    if (r2 == 55 && BOTC_ProtectTokOn(q, 68)) {
        return true;                            // 女裁缝：一局一次，用过了就不再唤醒
    }
    // 【杂耍艺人】（用户 2026-11-04）：真正拥有该能力（含哲学家 / 食人族 / 炼金术士借来的）
    //   当天公开猜测过，入夜才唤醒并给提示；假声称、酒鬼 / 提线木偶的假身份不唤醒。
    if (BOTC_HasAbility(q, 58) && g_juggUsed[q]) {
        return true;                            // 只在首个白天猜完之后的那一晚醒一次
    }
    if (BOTC_HasAbility(q, 58) && !g_juggDone[q]) {
        return true;
    }
    if (r2 == 90 && g_nightNum > g_seatFirstNight[q] && !BOTC_BountyTrigger()) {
        return true;
    }
    // 【国王（104）】首夜那一步 = 「告诉恶魔谁是国王」（开局自动发），**不唤醒国王本人**
    if (r == 104 && g_nightNum <= g_seatFirstNight[q]) {
        return true;
    }
    // 【国王（104）】其它夜：只有「死亡数 ≥ 存活数」才进唤醒队列（否则按规则今晚不给信息）
    if (r == 104 && !BOTC_KingConditionOK()) {
        return true;
    }
    return false;
}

// 这些角色在夜序中不是被唤醒，而是由说书人按结果手动打死亡 token。
//   祖母（22）不在此列：孙子被恶魔杀死时由 BOTC_NanaLinkCheck 自动结算死亡，无需说书人手动打 token。
//   月之子（36）也不在此列：他死亡后公开声称到一名非邪恶玩家，天亮由 BOTC_MoonChildResolve() 自动打死亡 token。
bool BOTC_ManualDeathTokenRole (int r) {
    // 【修补匠（35）】（用户 2026-11-09）：不再提醒说书人手动打死亡 token，从这张表里移除。
    return (r == 94 || r == 112 || r == 133 || r == 28);
}

string BOTC_ManualDeathSelectedText () {
    int q;
    string s;
    s = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_mdPick[q]) {
            continue;
        }
        if (StringLength(s) > 0) {
            s = s + ", ";
        }
        s = s + BOTC_NameStr(q);
    }
    if (s == "") {
        return "尚未选择";
    }
    return s;
}

void BOTC_ManualDeathRender () {
    string title;
    string note;
    text row;
    int q;
    int n;
    if (!g_mdOpen) {
        return;
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (g_mdPick[q]) {
            n = n + 1;
        }
    }
    note = "";
    if (g_mdRole == 112) {
        title = "【小怪宝·技能目标】点击一名存活玩家死亡";
        note = "再次点击同一玩家可取消；确认后打「死亡（小怪宝）」。已选：" + BOTC_ManualDeathSelectedText();
    }
    else if (g_mdRole == 28) {
        title = "【造谣者·技能目标】点击一名存活玩家死亡";
        note = "再次点击同一玩家可取消；没有目标时点「取消」即无事发生。确认后打「死亡（造谣者）」。已选：" + BOTC_ManualDeathSelectedText();
    }
    else if (g_mdRole == 90) {
        title = "【赏金猎人·设置调整】点击一名善良玩家转为邪恶";
        note = "只能选择善良阵营且存活的玩家；点「取消」则本次不转。已选：" + BOTC_ManualDeathSelectedText();
    }
    else if (g_mdRole == 133) {
        // 【牙噶巴卜】（用户 2026-11-10）：和军团同款多选，任意数量，列表实时显示选了谁。
        title = "【牙噶巴卜·技能目标】已选 " + IntToString(n) + " 人，点座位选择/取消，人数不限";
    }
    else {
        // 【军团】（用户 2026-11-10）：任意数量，用下方的已选列表实时显示选了谁。
        title = "【军团·技能目标】已选 " + IntToString(n) + " 人，点座位选择/取消，人数不限";
    }
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText(title), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    if ((g_mdRole == 94 || g_mdRole == 133) && g_mdList > 0) {
        DialogControlRemoveAllItems(g_mdList, PlayerGroupSingle(g_teller));
        if (n <= 0) {
            DialogControlAddItem(g_mdList, PlayerGroupSingle(g_teller), StringToText("尚未选择任何玩家。"));
        }
        else {
            n = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_mdPick[q]) {
                    continue;
                }
                n = n + 1;
                row = StringToText(IntToString(n) + ". ") + BOTC_PlayerNameText(q);
                DialogControlAddItem(g_mdList, PlayerGroupSingle(g_teller), row);
            }
        }
    }
}

// 【单个目标技能面板 · 确认】（用户 2026-11-10）：小怪宝 / 造谣者打死亡 token，
//   赏金猎人把善良玩家转为邪恶；目标来自 g_skillT1[1]（说书人那一格的目标1）。
void BOTC_MdAskConfirm () {
    int old;
    int q;
    if (!g_mdAsk) {
        return;
    }
    q = g_skillT1[1];
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q)) {
        BOTC_Notice(g_teller, "只能选择仍然存活的玩家。");
        return;
    }
    if (g_mdRole == 90 && BOTC_SeatAlign(q) != 0) {
        BOTC_Notice(g_teller, "赏金猎人只能把善良阵营的玩家转为邪恶。");
        return;
    }
    old = g_mdRole;
    g_mdAsk = false;
    g_mdRole = 0;
    g_mdSrc = 0;
    if (old == 90) {
        if (BOTC_HolySoulBlocks(q)) {
            BOTC_PmStore(g_teller, "【赏金猎人×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(q) + " 保持善良阵营。");
            BOTC_GrimRender(g_teller);
            return;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;
        g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
        BOTC_PairClearSeat(q);
        BOTC_PmInfo(g_who[q], "【阵营变化】你转变为邪恶阵营。");
        BOTC_PmStore(g_teller, "【赏金猎人】设置调整：" + BOTC_NameStr(q) + " 已转为邪恶阵营。");
        BOTC_ClaimBtnRender();
        BOTC_SeatStateSync();
        BOTC_GrimRender(g_teller);
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 1, 1, old);
    if (BOTC_SeatDead(q)) {
        BOTC_PmStore(g_teller, "【" + g_roleName[old] + "】说书人选择 " + BOTC_NameStr(q) + " → 已结算死亡并打上「死亡（" + g_roleName[old] + "）」。");
        BOTC_CheckWin();
    }
    else {
        BOTC_PmStore(g_teller, "【" + g_roleName[old] + "】本次没有玩家实际死亡。");
    }
}

// 【单个目标技能面板 · 取消】= 这一夜不发动，不产生死亡 / 阵营变化。
void BOTC_MdAskCancel () {
    int old;
    if (!g_mdAsk) {
        return;
    }
    old = g_mdRole;
    g_mdAsk = false;
    g_mdRole = 0;
    g_mdSrc = 0;
    if (old == 90) {
        BOTC_PmStore(g_teller, "【赏金猎人】本次设置调整已取消，没有玩家转为邪恶。");
    }
    else if (old == 28) {
        BOTC_PmStore(g_teller, "【造谣者】本次没有选择死亡目标，无事发生。");
    }
    else {
        BOTC_PmStore(g_teller, "【夜序·非唤醒】本次死亡目标选择已取消，没有玩家死亡。");
    }
}

void BOTC_ManualDeathOpen (int src, int role) {
    int q;
    if (src < 2 || src > 13 || (role != 112 && role != 94 && role != 28 && role != 90 && role != 133)) {
        return;
    }
    // 【单个目标改用技能面板】（用户 2026-11-10）：小怪宝 / 造谣者 / 赏金猎人不再走
    //   说书人答题框，改成和筑梦师同款的「选择一名玩家」面板：所选玩家显示在目标1，
    //   点【确认】结算，点【取消】就是这一次不发动。
    // 【牙噶巴卜】（用户 2026-11-10）：和军团同款多选面板，任意数量 + 已选玩家列表。
    if (role != 94 && role != 133) {
        g_mdAsk = true;
        g_mdRole = role;
        g_mdSrc = src;
        g_skillPicking[1] = true;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        g_skillRoleSel[1] = 0;
        libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
        BOTC_SkillRender(1);
        // 标题和取消按钮放在 Render 之后设置：说书人那一格万一被登记了身份，
        // Render 的角色分支会覆盖标题 / 隐藏取消，这里统一改回来。
        libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_skillOk[1], StringToText("确认"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_skillCancel[1], StringToText("取消"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_skillOk[1], PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), true);
        if (role == 90) {
            BOTC_PmStore(g_teller, "【赏金猎人·设置调整】点一名存活且善良阵营的玩家，确认后把他转为邪恶；点【取消】本次不转。");
        }
        else {
            BOTC_PmStore(g_teller, "【" + g_roleName[role] + "】点一名存活玩家，确认后打上「死亡（" + g_roleName[role] + "）」；点【取消】则本次无人死亡。");
        }
        return;
    }
    BOTC_MiSeatFieldsReset();
    g_miSeat = src;
    g_miRole = 816;
    g_miKind = role;
    g_mdOpen = true;
    g_mdRole = role;
    g_mdSrc = src;
    for (q = 0; q <= 13; q += 1) {
        g_mdPick[q] = false;
    }
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    if (role == 90) {
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确认转为邪恶"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确认死亡"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    if (role == 94 || role == 133) {
        // 【军团 / 牙噶巴卜】任意数量：用「已选玩家」列表，隐藏单行提示。
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_mdList, PlayerGroupSingle(g_teller), true);
    }
    else {
        // 小怪宝 / 造谣者 / 赏金猎人：单个目标，沿用原来的单行「已选」提示。
        DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_mdList, PlayerGroupSingle(g_teller), false);
    }
    BOTC_ManualDeathRender();
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_ManualDeathPick (int q) {
    int j;
    if (!g_mdOpen || q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q] || BOTC_SeatDead(q)) {
        BOTC_Notice(g_teller, "只能选择仍然存活的玩家。");
        return;
    }
    // 【赏金猎人设置调整】（用户 2026-11-09）：只能选择善良阵营玩家。
    if (g_mdRole == 90 && BOTC_SeatAlign(q) != 0) {
        BOTC_Notice(g_teller, "赏金猎人只能把善良阵营的玩家转为邪恶。");
        return;
    }
    if (g_mdRole == 112 || g_mdRole == 28 || g_mdRole == 90) {
        if (g_mdPick[q]) {
            g_mdPick[q] = false;
        }
        else {
            g_mdPick[q] = true;
            for (j = 2; j <= 13; j += 1) {
                if (j != q) {
                    g_mdPick[j] = false;
                }
            }
        }
    }
    else {
        // 【军团 / 牙噶巴卜】（用户 2026-11-10）：任意数量，点一次选中、再点一次取消。
        g_mdPick[q] = !g_mdPick[q];
    }
    BOTC_ManualDeathRender();
}

void BOTC_ManualDeathConfirm () {
    int q;
    int n;
    int old;
    string picked;
    if (!g_mdOpen) {
        return;
    }
    picked = BOTC_ManualDeathSelectedText();
    n = 0;
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mdList, PlayerGroupAll(), false);
    // 【赏金猎人设置调整】（用户 2026-11-09）：把选中的善良玩家转为邪恶，受圣洁之魂上限限制。
    if (g_mdRole == 90) {
        for (q = 2; q <= 13; q += 1) {
            if (!g_mdPick[q] || !g_seatOn[q] || BOTC_SeatDead(q)) {
                continue;
            }
            if (BOTC_SeatAlign(q) != 0) {
                continue;
            }
            if (BOTC_HolySoulBlocks(q)) {
                BOTC_PmStore(g_teller, "【赏金猎人×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(q) + " 保持善良阵营。");
                continue;
            }
            g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;
            g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
            BOTC_PairClearSeat(q);
            BOTC_PmInfo(g_who[q], "【阵营变化】你转变为邪恶阵营。");
            BOTC_PmStore(g_teller, "【赏金猎人】设置调整：" + BOTC_NameStr(q) + " 已转为邪恶阵营。");
            n = n + 1;
        }
        g_mdOpen = false;
        g_mdRole = 0;
        g_mdSrc = 0;
        g_miRole = -1;
        g_miSeat = 0;
        for (q = 0; q <= 13; q += 1) {
            g_mdPick[q] = false;
        }
        if (n > 0) {
            BOTC_ClaimBtnRender();
            BOTC_SeatStateSync();
        }
        BOTC_GrimRender(g_teller);
        return;
    }
    old = g_mdRole;
    for (q = 2; q <= 13; q += 1) {
        if (!g_mdPick[q] || !g_seatOn[q] || BOTC_SeatDead(q)) {
            continue;
        }
        BOTC_MarkDeathQuietSrc(q, 1, 1, g_mdRole);
        if (BOTC_SeatDead(q)) {
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_PmStore(g_teller, "【" + g_roleName[old] + "】说书人选择 " + picked + " → 已结算死亡并打上「死亡（" + g_roleName[old] + "）」。");
    }
    else {
        BOTC_PmStore(g_teller, "【" + g_roleName[old] + "】本次没有玩家实际死亡。");
    }
    g_mdOpen = false;
    g_mdRole = 0;
    g_mdSrc = 0;
    g_miRole = -1;
    g_miSeat = 0;
    for (q = 0; q <= 13; q += 1) {
        g_mdPick[q] = false;
    }
    if (n > 0) {
        BOTC_CheckWin();
    }
}

void BOTC_ManualDeathCancel () {
    int q;
    int old;
    // 【单个目标技能面板】也要一起收：跨阶段强制收尾时会直接调到这里。
    if (g_mdAsk) {
        BOTC_MdAskCancel();
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupAll(), false);
    }
    if (!g_mdOpen) {
        return;
    }
    old = g_mdRole;
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mdList, PlayerGroupAll(), false);
    g_mdOpen = false;
    g_mdRole = 0;
    g_mdSrc = 0;
    g_miRole = -1;
    g_miSeat = 0;
    for (q = 0; q <= 13; q += 1) {
        g_mdPick[q] = false;
    }
    if (old == 90) {
        BOTC_PmStore(g_teller, "【赏金猎人】本次设置调整已取消，没有玩家转为邪恶。");
    }
    else if (old == 28) {
        BOTC_PmStore(g_teller, "【造谣者】本次没有选择死亡目标，无事发生。");
    }
    else if (old == 133) {
        BOTC_PmStore(g_teller, "【牙噶巴卜】本次没有选择死亡目标，无事发生。");
    }
    else {
        BOTC_PmStore(g_teller, "【夜序·非唤醒】本次死亡目标选择已取消，没有玩家死亡。");
    }
}

//--------------------------------------------------------------------------------------------------
// 【帽匠 · 茶会换角色】（用户 2026-11-09）
//   茶会把恶魔和爪牙拉进私聊之后，逐个询问要不要换角色：
//     · 选「否」= 这一位不换；选「是」= 恶魔只弹恶魔角色、爪牙只弹爪牙角色；
//     · 爪牙不能出现两个相同角色，已经死亡的爪牙也算重复（所以可以先让死亡的爪牙换掉，
//       再把另一个爪牙变成他）；撞重名时先把这一位排到队尾，等别人处理完再来。
//--------------------------------------------------------------------------------------------------
void BOTC_HatTokClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_hatDone[q]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 209] = false;
        }
    }
}

void BOTC_HatRoleStart () {
    int q;
    int r;
    g_hatN = 0;
    g_hatIdx = 0;
    g_hatAsk = false;
    for (q = 0; q <= 13; q += 1) {
        g_hatQ[q] = 0;
        g_hatTries[q] = 0;
    }
    // 与 BOTC_HatCollect 同一口径：在场的恶魔 / 爪牙，提线木偶不算。
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || g_who[q] < 1) {
            continue;
        }
        if (BOTC_IsMarionette(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (!BOTC_IsDemonSeat(q) && BOTC_RoleTeam(r) != 2) {
            continue;
        }
        g_hatN = g_hatN + 1;
        g_hatQ[g_hatN] = q;
    }
    if (g_hatN <= 0) {
        BOTC_HatTokClear();
        return;
    }
    BOTC_HatRoleNext();
}

void BOTC_HatRoleNext () {
    int q;
    g_hatAsk = false;
    while (g_hatIdx < g_hatN) {
        g_hatIdx = g_hatIdx + 1;
        q = g_hatQ[g_hatIdx];
        if (q < 2 || q > 13) {
            continue;
        }
        if (!g_seatOn[q] || g_who[q] < 1) {
            continue;
        }
        BOTC_HatRoleAsk(q);
        return;
    }
    BOTC_PmStore(g_teller, "【帽匠】茶会换角色询问结束。");
    // 【今晚茶会（209）】（用户 2026-11-11）：结算步骤完成，移除帽匠角色标记旁的茶会标记。
    BOTC_HatTokClear();
    BOTC_GrimRender(g_teller);
}

void BOTC_HatRoleAsk (int q) {
    int r;
    string kind;
    string note;
    if (q < 2 || q > 13) {
        return;
    }
    r = BOTC_SeatTrueRole(q);
    g_hatAsk = true;
    BOTC_MiSeatFieldsReset();
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    if (BOTC_IsDemonSeat(q)) {
        kind = "恶魔";
        note = "选「是」后弹出恶魔角色列表；选「否」这位保持不变。";
    }
    else {
        kind = "爪牙";
        note = "选「是」后弹出爪牙角色列表；爪牙不能出现两个相同的角色（已死亡的也算）。";
    }
    g_miSeat = q;
    g_miRole = 818;
    g_miKind = 0;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【帽匠】" + BOTC_NameStr(q) + "（" + kind + "：" + BOTC_RoleNameSafe(r) + "）是否更换角色？")), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miYes, StringToText("是"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText("否"), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_HatRoleOpenGrid (int q) {
    int r;
    int team;
    if (q < 2 || q > 13) {
        return;
    }
    r = BOTC_SeatTrueRole(q);
    if (BOTC_IsDemonSeat(q)) {
        team = 3;
    }
    else if (BOTC_RoleTeam(r) == 2) {
        team = 2;
    }
    else {
        return;
    }
    g_hatAsk = false;
    g_pickMode[g_teller] = 54;
    g_pickWho[g_teller] = q;
    g_pickTeam = team;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    if (team == 3) {
        libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_NameSubstText(StringToText("帽匠：为 " + BOTC_NameStr(q) + " 选择新的恶魔角色")), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_NameSubstText(StringToText("帽匠：为 " + BOTC_NameStr(q) + " 选择新的爪牙角色")), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

bool BOTC_HatRoleApply (int q, int role) {
    int i;
    int r;
    int dup;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return false;
    }
    if (BOTC_SeatTrueRole(q) == role) {
        BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 本来就是 " + BOTC_RoleNameSafe(role) + "，保持不变。");
        return true;
    }
    // 爪牙不能有两个同角色：已经死亡的爪牙也算，所以要先让死亡的那位换掉。
    if (BOTC_RoleTeam(role) == 2) {
        dup = 0;
        for (i = 2; i <= 13; i += 1) {
            if (i == q) {
                continue;
            }
            if (!g_seatOn[i] || g_who[i] < 1) {
                continue;
            }
            r = BOTC_SeatTrueRole(i);
            if (r == role) {
                dup = i;
                break;
            }
        }
        if (dup > 0) {
            if (g_hatTries[q] < 2 && g_hatN < 13) {
                g_hatTries[q] = g_hatTries[q] + 1;
                g_hatN = g_hatN + 1;
                g_hatQ[g_hatN] = q;
                BOTC_Notice(g_teller, "场上已经有 " + BOTC_RoleNameSafe(role) + "（" + BOTC_NameStr(dup) + "，已死亡也算）。先把这一位排到队尾，处理完其他人再回来选。");
                BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 暂时不能变成 " + BOTC_RoleNameSafe(role) + "：" + BOTC_NameStr(dup) + " 已经是这个角色（已死亡也算重复）。已把这一位排到队尾。");
                return true;
            }
            BOTC_Notice(g_teller, "场上已经有 " + BOTC_RoleNameSafe(role) + "（" + BOTC_NameStr(dup) + "，已死亡也算）。请换一个爪牙角色，或点【取消】跳过这一位。");
            BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 不能变成 " + BOTC_RoleNameSafe(role) + "：" + BOTC_NameStr(dup) + " 已经是这个角色（已死亡也算重复）。");
            return false;
        }
    }
    BOTC_SetSeatRole(g_teller, q, role);
    BOTC_ChangeRoleMsg(q, role);
    BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(q) + " 在茶会后换成了 " + BOTC_RoleNameSafe(role) + "。");
    return true;
}

void BOTC_HatRoleAbort (int p) {
    if (p != g_teller) {
        return;
    }
    if (g_pickMode[g_teller] != 54) {
        return;
    }
    g_pickMode[g_teller] = 0;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PmStore(g_teller, "【帽匠】这一位保持不变。");
    BOTC_HatRoleNext();
}

// 在普通行动之间插入“非唤醒夜序节点”：手动死亡 token 提示 / 农夫延迟选人。
bool BOTC_NonWakeOrderStep (int beforeOrd) {
    int i;
    int q;
    int r;
    int ord;
    int score;
    int best;
    int bestOrd;
    int bestRole;
    bool bestFarm;
    bool caret;
    best = 0;
    bestOrd = 0;
    bestRole = -1;
    bestFarm = false;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = g_mark[(g_teller * 14) + q] - 1;
        caret = false;
        // 【小怪宝】（用户 2026-11-04）：真正行动的是「照看者」，魔典上写的是其爪牙身份，
        //   所以按魔典身份永远匹配不到 112；这里直接按 g_lmSeat 识别，在 112 的夜序位次提醒说书人打死亡 token。
        if (g_lmOn && q == g_lmSeat) {
            r = 112;
            caret = true;
        }
        if (g_manualDeathDone[q]) {
            continue;
        }
        if (!caret) {
            if (r < 0 || r > 163 || !BOTC_ManualDeathTokenRole(r)) {
                continue;
            }
            if (!BOTC_HasAbility(q, r)) {
                continue;
            }
            // 【造谣者 28】只有当天真的公开声明过造谣，才在它的夜序位置提醒说书人结算死亡；
            //   没声明过的夜晚不提醒，避免每个夜晚都凭空要求打死亡 token（用户 2026-11-09）。
            if (r == 28 && !g_gossipDone[q]) {
                continue;
            }
            // 【造谣者 28】（用户 2026-11-11）：能力者本人已在夜序到达前死亡，或本人夜序时
            //   处于中毒 / 醉酒 → 能力不存在 / 不生效，直接跳过，不弹选人窗。
            if (r == 28 && (BOTC_SeatDead(q) || !BOTC_AbilityWorks(q, 28))) {
                continue;
            }
        }
        if (caret) {
            ord = BOTC_NightOrder(112);
        }
        else {
            ord = BOTC_NightOrderOf(q);
        }
        if (ord <= 0) {
            continue;
        }
        score = (ord * 10) + 6;
        if (beforeOrd > 0 && score > beforeOrd) {
            continue;
        }
        if (best < 2 || score < bestOrd) {
            best = q;
            bestOrd = score;
            bestRole = r;
            bestFarm = false;
        }
    }
    // 农夫死亡触发不再当场弹框，而是在农夫自己的夜序节点打开选人面板。
    for (q = 2; q <= 13; q += 1) {
        if (!g_farmPending[q]) {
            continue;
        }
        ord = BOTC_NightOrder(80);
        if (ord <= 0) {
            continue;
        }
        score = (ord * 10) + 7;
        if (beforeOrd > 0 && score > beforeOrd) {
            continue;
        }
        if (best < 2 || score < bestOrd) {
            best = q;
            bestOrd = score;
            bestRole = 80;
            bestFarm = true;
        }
    }
    if (best < 2) {
        return false;
    }
    if ((bestOrd / 10) > g_nightCursorOrd) {
        g_nightCursorOrd = bestOrd / 10;
    }
    if (bestFarm) {
        g_farmPending[best] = false;
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(best) + " 的死亡触发到达夜序节点：请选择一名存活善良玩家变成农夫（不唤醒农夫本人）。");
        BOTC_FarmerOpen(best, false);
    }
    else {
        g_manualDeathDone[best] = true;
        if (bestRole == 94) {
            // 军团是一个整体行动：一次弹窗处理所有军团座位，不在后续同夜序位置重复弹。
            for (q = 2; q <= 13; q += 1) {
                if (BOTC_HasAbility(q, 94)) {
                    g_manualDeathDone[q] = true;
                }
            }
        }
        if (bestRole == 112 && g_nightNum <= 1) {
            BOTC_PmStore(g_teller, "【小怪宝】首夜只确认照看者，不结算死亡。");
        }
        else if (bestRole == 133 && g_nightNum <= 1) {
            BOTC_PmStore(g_teller, "【牙噶巴卜】首夜只告知秘密短语，暂不结算死亡。");
        }
        else if (bestRole == 94 || bestRole == 112 || bestRole == 28 || bestRole == 133) {
            // 【造谣者】（用户 2026-11-09）：改为弹窗点选一名玩家死亡，可取消。
            // 【牙噶巴卜】（用户 2026-11-10）：和军团同款多选弹窗，任意数量。
            // 【牙噶巴卜·秘密短语】（用户 2026-11-11）：先告知白天说了几次、当前状态能否致死；
            //   只有活着、清醒健康、且白天至少说出 1 次时才弹出死亡目标选择。
            if (bestRole == 133) {
                if (BOTC_YaggaNightReport(best)) {
                    BOTC_ManualDeathOpen(best, bestRole);
                }
            }
            else {
                BOTC_ManualDeathOpen(best, bestRole);
            }
        }
        else {
            BOTC_Notice(g_teller, "【" + g_roleName[bestRole] + "】座位 " + IntToString(best - 1) + "：请手动打上死亡token。");
            BOTC_PmStore(g_teller, "【夜序·非唤醒】" + BOTC_NameStr(best) + "（" + g_roleName[bestRole] + "）到达行动位次，请按规则手动打上死亡 token。");
        }
    }
    return true;
}

int BOTC_PedantWakeSeat () {
    int q;
    if (!g_started || !g_isNight || g_pedantDoneNight == g_nightNum) {
        return 0;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 171]) {
            return q;
        }
    }
    return 0;
}

// 【唤醒下一个 / 结束手动唤醒】按钮（用户 2026-11-08）：手动唤醒的人还醒着时点它 =
//   结束这次手动唤醒（收回该座位），不推进自动夜序；没有手动唤醒时按原逻辑唤醒下一个。
void BOTC_WakeBtnPress () {
    int q;
    q = g_manualWakeSeat;
    if (q >= 2 && q <= 13 && g_awake[q]) {
        BOTC_WakeManualAt(q);
        // 【结束手动唤醒 ≠ 撤销这一晚的行动】（用户 2026-11-08）：收回唤醒会把 g_autoWoke 清掉，
        //   再点【唤醒下一个】时自动夜序会把这个座位重新唤醒一次；这里补回「今晚已行动」标记。
        g_autoWoke[q] = true;
        BOTC_Notice(g_teller, "已结束手动唤醒。");
        BOTC_WakeRender();
        return;
    }
    g_manualWakeSeat = 0;
    BOTC_AutoWakeNext();
}

// 【自动唤醒】（用户 2026-09-20）：按一下 → 唤醒夜间顺序里下一个该行动的人，并自动跟他进私聊；
//   再按一下 = 收掉上一个、唤醒下一个。全都轮完弹一句「所有玩家均已行动完毕。」
void BOTC_AutoWakeNext () {
    int chatTo;
    int i;
    int q;
    int r;
    int best;
    int bestOrd;
    int bestOrd2;
    int ks;
    int ko;
    int xs;
    int xo;
    int boffinSeat;
    int boffinSource;
    int boffinOrd;
    int boffinBestOrd;
    bool boffinWake;
    int grantSeat;
    int grantOrd;
    int grantBestOrd;
    bool grantWake;
    int bnestSeat;
    int bnestSource;
    int bnestOrd;
    int bnestBestOrd;
    bool bnestWake;
    int pedantSeat;
    int pedantOrd;
    int pedantBestOrd;
    bool pedantWake;
    int lunSeat;
    int lunOrd;
    int lunBestOrd;
    bool lunWake;
    int hatOrd2;
    bool hatWake;
    int poppyOrd2;
    int bs;
    int mezSeat;
    int mezOrd;
    if (!g_isNight) {
        BOTC_Notice(g_teller, "白天不能唤醒：先点【进入夜晚】，夜里才唤醒。");
        return;
    }
    if (g_mdOpen || g_mdAsk) {
        BOTC_Notice(g_teller, "先在技能目标面板里确认或取消（小怪宝 / 军团 / 造谣者 / 赏金猎人），再继续唤醒。");
        return;
    }
    // 【军团】疯子的「屏蔽两个」框还没答完：先别往下唤醒别人（用户 2026-09-30 实测会被顺带唤醒）
    if (BOTC_LegionPendBlock()) {
        return;
    }
    // 【唤醒下一个 · 1 秒冷却】：连点第二下会立刻收回上一位、直接跳到下一位，
    //   等于把上一位的行动整段跳过；这里用 2 拍（0.5 秒一拍 = 1 秒）内置冷却挡住手抖连点。
    if (g_wakeCd > 0) {
        BOTC_Notice(g_teller, "点太快了：唤醒有 1 秒冷却，请 " + IntToString((g_wakeCd + 1) / 2) + " 秒后再点。");
        return;
    }
    g_wakeCd = 2;
    if (!g_autoOn && !g_wakeHintSent) {
        BOTC_WakeListHint();
    }
    g_wakeHintSent = true;
    g_autoOn = true;
    // 上一个：先在进入下一项（角色或首夜固定信息）之前退出私聊并收回技能。
    // 这样疯子第 15 位行动结束后，下一次点击会先收回他，再发第 17 位恶魔信息。
    if (g_autoLast >= 2) {
        BOTC_ForceLeave(g_teller);
        if (g_awake[g_autoLast]) {
            BOTC_WakeToggle(g_autoLast);
        }
        g_autoLast = 0;
    }
    // 【首夜固定信息弹窗】（用户 2026-11-09）：疯子假爪牙 / 提线木偶追问 / 书生 × 疯子 /
    //   国王 × 疯子这些框不挂在唤醒座位上，点【唤醒下一个】时必须先按取消收掉，
    //   否则它会一直盖在屏幕上，叠到下一位的面板上面。
    BOTC_InfoPopupClosePending();
    // 【手动唤醒排队】（用户 2026-11-08）：刚才有人醒着时点的手动唤醒，收掉上一位后优先执行。
    if (g_manualWakeQueue >= 2 && g_manualWakeQueue <= 13) {
        q = g_manualWakeQueue;
        g_manualWakeQueue = 0;
        if (!g_awake[q]) {
            g_manualWakeInsert = true;   // 插入结算：不把主按钮变成【结束手动唤醒】
            BOTC_WakeManualAt(q);
        }
        if (g_awake[q] || g_wakeChoiceSeat != q) {
            g_manualWakeInsert = false;
        }
        BOTC_WakeRender();
        return;
    }
    // 【失忆者 / 食人族 / 变脸师 / 小精灵】（用户 2026-11-03）：夜间唤醒之前先走一步
    //   「不唤醒、不私聊」的能力发放，优先于所有角色和首夜固定信息。
    if (BOTC_PreGrantStep()) {
        BOTC_WakeRender();
        return;
    }
    // 【赏金猎人（90）· 首夜设置调整】（用户 2026-11-01）：首夜有两个夜间顺序 ----
    //   1) 最早这一步：不唤醒、不私聊，只提醒说书人先把一名镇民转为邪恶（官方设置调整）；
    //   2) 夜序第 71 位：正常唤醒他，并告知一名邪恶玩家的座位（见 BOTC_WakeApply 的 r == 90）。
    //   酒鬼 / 提线木偶的「假赏金」不占第一步（BOTC_SeatOfRole 读的是真实身份）。
    if (g_nightNum == 1 && !g_bountySetupDone[0]) {
        bs = BOTC_SeatOfRole(90);
        if (bs >= 2 && bs <= 13) {
            g_bountySetupDone[0] = true;
            g_bountySetupDone[bs] = true;
            if (PlayerType(g_teller) == 1) {
                // 【赏金猎人设置调整】（用户 2026-11-09）：改为弹窗让说书人点一名善良阵营玩家转为邪恶。
                BOTC_PmStore(g_teller, "【赏金猎人】设置调整：" + BOTC_NameStr(bs) + " 在场，请先把一名善良阵营玩家转为邪恶；之后他会在正常夜序里得知一名邪恶玩家的座位。");
                BOTC_ManualDeathOpen(bs, 90);
            }
            else {
                BOTC_PmStore(g_teller, "【赏金猎人】设置调整：" + BOTC_NameStr(bs) + " 在场，请先把一名镇民转为邪恶；之后他会在正常夜序里得知一名邪恶玩家的座位。");
                BOTC_Notice(g_teller, "【赏金猎人】设置调整：请先把一名镇民转为邪恶。");
            }
            BOTC_WakeRender();
            return;
        }
    }
    // 【科学怪人（132）】首夜先按正常唤醒流程唤醒他并选择赐予恶魔的能力
    if (BOTC_BoffinFirstWakeStep()) {
        return;
    }

    // 【暴风捕手】（用户 2026-10-11）：在「邪恶互认」之前先走他这一步（你得知 A 是 B）
    if (BOTC_StormEvilStep()) {
        return;
    }
    if (BOTC_AutoWakeEvilStep()) {
        return;
    }
    // 下一个：今晚还没轮到过、在夜间顺序表里、而且允许唤醒的人里面，顺序最靠前的那个
    best = 0;
    bestOrd = 0;
    boffinSeat = 0;
    boffinSource = 0;
    boffinOrd = 0;
    boffinBestOrd = 0;
    boffinWake = false;
    grantSeat = 0;
    grantOrd = 0;
    grantBestOrd = 0;
    grantWake = false;
    bnestSeat = 0;
    bnestSource = 0;
    bnestOrd = 0;
    bnestBestOrd = 0;
    bnestWake = false;
    pedantSeat = 0;
    pedantOrd = 0;
    pedantBestOrd = 0;
    pedantWake = false;
    lunSeat = 0;
    lunOrd = 0;
    lunBestOrd = 0;
    lunWake = false;
    hatOrd2 = 0;
    hatWake = false;
    poppyOrd2 = 0;
    BOTC_BuildSeatList();
    // 先处理刚获得更早夜序能力或身份的插入队列；它优先于正常扫描。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!g_insertWake[q]) {
            continue;
        }
        if (g_hatParty[q]) {
            g_insertWake[q] = false;    // 【帽匠】待开茶会时由专门的插入点处理，不占普通唤醒位
            continue;
        }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r == 136 || r == 141) {
            g_insertWake[q] = false;
            continue;                       // 只作为夜序提示，不占唤醒位
        }
        if (r < 0 || r > 163 || BOTC_NightOrderOf(q) <= 0 || BOTC_WakeSkipNow(q)) {
            g_insertWake[q] = false;
            continue;
        }
        bestOrd2 = BOTC_NightOrderOf(q) * 10;
        if (!BOTC_IsLunatic(q)) {
            bestOrd2 = bestOrd2 + 5;
        }
        if (best == 0 || bestOrd2 < bestOrd) {
            best = q;
            bestOrd = bestOrd2;
        }
    }
    if (best >= 2) {
        g_insertWake[best] = false;
        bestOrd = 0;
    }
    else {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (g_autoWoke[q]) {
                continue;
            }
            if (g_hatParty[q]) {
                continue;                   // 【帽匠】待开茶会：不排进他自己的第 3 位
            }
            r = g_mark[(g_teller * 14) + q] - 1;
            if (r == 136 || r == 141) {
                continue;                   // 魔术师由邪恶信息直接处理；维齐尔在白天公开
            }
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_NightOrderOf(q) <= 0) {
                continue;
            }
            if (BOTC_WakeSkipNow(q)) {
                continue;
            }
            bestOrd2 = BOTC_NightOrderOf(q) * 10;
            if (!BOTC_IsLunatic(q)) {      // 【哲学疯子也算疯子那一档】（用户 2026-10-14 报「在恶魔之后行动」）
                bestOrd2 = bestOrd2 + 5;
            }
            if (best == 0 || bestOrd2 < bestOrd) {
                best = q;
                bestOrd = bestOrd2;
            }
        }
    }
    // 【假疯子】（用户 2026-11-12）：在真疯子被唤醒**之前**单独插一个夜序 ——
    //   先给说书人弹窗填写「假疯子今晚杀了谁」，填完立刻私聊告知真疯子（让他以为恶魔已知情），
    //   下一次点【唤醒下一个】才真正唤醒他本人。
    if (g_lunFakeKillNight != g_nightNum && g_lunFake >= 2 && g_lunFakeTo >= 2 && g_lunFakeTo <= 13) {
        q = g_lunFakeTo;
        if (BOTC_IsLunatic(q) && g_seatOn[q] && !BOTC_SeatDead(q) && !g_autoWoke[q] && !BOTC_WakeSkipNow(q)) {
            ko = BOTC_NightOrderOf(q);
            if (ko > 0 && (ko * 10) <= bestOrd) {
                g_lunFakeKillNight = g_nightNum;
                BOTC_LunaticFakeKillAsk();
                BOTC_WakeRender();
                return;
            }
        }
    }
    // 【帽匠（120）· 白天死亡 / 夜间死亡】（用户 2026-11-04）：
    //   夜间死亡：以「死亡时正在行动的夜序」为界，下一个唤醒位就插茶会，不再等全部击杀角色行动完；
    //   白天死亡：不再在入夜第一拍提前开，排到帽匠自己的夜序位（第 3 位）再自动开。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!g_hatParty[q]) {
            continue;
        }
        if (g_hatPartyNight[q] != g_nightNum) {
            g_hatParty[q] = false;
            g_hatWaitOrd[q] = 0;
            continue;
        }
        if (g_hatDone[q] || !BOTC_HasAbility(q, 120) || !BOTC_SeatDead(q)) {
            g_hatParty[q] = false;
            g_hatWaitOrd[q] = 0;
            continue;
        }
        if (g_hatWaitOrd[q] > 0) {
            hatOrd2 = (g_hatWaitOrd[q] * 10) + 8;
        }
        else {
            hatOrd2 = BOTC_NightOrderOf(q) * 10;
            if (hatOrd2 <= 0) {
                hatOrd2 = BOTC_NightOrder(120) * 10;    // 夜序拿不到时按帽匠自己的第 3 位兜底
            }
            if (hatOrd2 <= 0) {
                hatOrd2 = 30;
            }
            hatOrd2 = hatOrd2 + 8;
        }
        if (best < 2 || hatOrd2 < bestOrd) {
            best = q;
            bestOrd = hatOrd2;
            hatWake = true;
        }
    }
    // 【科学怪人（132）】同一名恶魔还有一次「借来能力」的夜间时机，单独占用一次唤醒
    boffinSeat = BOTC_BoffinWakeSeat();
    if (boffinSeat >= 2) {
        boffinOrd = BOTC_BoffinWakeOrder(boffinSeat);
        boffinSource = BOTC_BoffinWakeSource(boffinSeat);
        if (boffinOrd > 0) {
            boffinBestOrd = (boffinOrd * 10) + 1;
            if (best < 2 || boffinBestOrd < bestOrd) {
                best = boffinSeat;
                bestOrd = boffinBestOrd;
                boffinWake = true;
                grantWake = false;
                bnestWake = false;
                hatWake = false;
            }
        }
    }
    // 【科怪 × 哲学家 / 炼金术士】嵌套能力按所选角色自己的夜序额外行动。
    bnestSeat = BOTC_BoffinNestedWakeSeat();
    if (bnestSeat >= 2) {
        bnestOrd = BOTC_BoffinNestedWakeOrder(bnestSeat);
        bnestSource = BOTC_BoffinNestedWakeSource(bnestSeat);
        if (bnestOrd > 0) {
            bnestBestOrd = (bnestOrd * 10) + 2;
            if (best < 2 || bnestBestOrd < bestOrd) {
                best = bnestSeat;
                bestOrd = bnestBestOrd;
                bnestWake = true;
                boffinWake = false;
                grantWake = false;
                hatWake = false;
            }
        }
    }
    // 【赋予能力】附加能力按它自己的夜序额外行动一次。
    grantSeat = BOTC_GrantWakeSeat();
    if (grantSeat >= 2) {
        grantOrd = BOTC_GrantWakeOrder(grantSeat);
        if (grantOrd > 0) {
            grantBestOrd = (grantOrd * 10) + 3;
            if (best < 2 || grantBestOrd < bestOrd) {
                best = grantSeat;
                bestOrd = grantBestOrd;
                grantWake = true;
                boffinWake = false;
                bnestWake = false;
                hatWake = false;
            }
        }
    }
    // 【书生（152）】给正确猜测的恶魔单独插一次额外行动；不占用其原本夜序。
    pedantSeat = BOTC_PedantWakeSeat();
    if (pedantSeat >= 2) {
        pedantOrd = BOTC_NightOrder(152);
        if (pedantOrd > 0) {
            pedantBestOrd = (pedantOrd * 10) + 4;
            if (best < 2 || pedantBestOrd < bestOrd) {
                best = pedantSeat;
                bestOrd = pedantBestOrd;
                pedantWake = true;
                grantWake = false;
                boffinWake = false;
                bnestWake = false;
                hatWake = false;
            }
        }
    }
    // 【疯子 · 假科学怪人能力】（用户 2026-11-10）：按那份假能力自己的夜序额外唤醒疯子一次，
    //   面板照常打开、玩家照常选人，但确认时什么都不结算。
    lunSeat = 0;
    lunOrd = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        lunOrd = BOTC_LunFakeNightOrder(q);
        if (lunOrd > 0) {
            lunSeat = q;
            break;
        }
    }
    if (lunSeat >= 2) {
        lunBestOrd = (lunOrd * 10) + 6;
        if (best < 2 || lunBestOrd < bestOrd) {
            best = lunSeat;
            bestOrd = lunBestOrd;
            lunWake = true;
            boffinWake = false;
            bnestWake = false;
            grantWake = false;
            pedantWake = false;
            hatWake = false;
        }
    }
    // 【罂粟种植者（86）· 死亡后的邪恶互认】（用户 2026-11-06）：
    //   白天死亡 → 排到罂粟自己的夜序位；夜间死亡 → 紧接当前行动之后插入一步。
    //   这一步不唤醒任何人、不开私聊，直接自动发送互认信息。
    if (g_poppyEvilPend) {
        if (g_poppyEvilNight != g_nightNum) {
            // 夜号对不上（例如说书人整夜没走到这一步）：作废，避免下一夜乱发。
            g_poppyEvilPend = false;
            g_poppyEvilWaitOrd = 0;
        }
        else if (BOTC_PoppyActive()) {
            // 场上还有另一份有效的罂粟能力（例如别人也获得了这份能力）：仍然不能互认。
            g_poppyEvilPend = false;
            g_poppyEvilWaitOrd = 0;
        }
        else {
            if (g_poppyEvilWaitOrd > 0) {
                poppyOrd2 = (g_poppyEvilWaitOrd * 10) + 9;
            }
            else if (g_poppyEvilWaitOrd < 0) {
                poppyOrd2 = 9;
            }
            else {
                poppyOrd2 = BOTC_NightOrder(86) * 10;
                if (poppyOrd2 <= 0) {
                    poppyOrd2 = 50;
                }
                poppyOrd2 = poppyOrd2 + 9;
            }
            if (best < 2 || poppyOrd2 < bestOrd) {
                BOTC_PoppyRecognize();
                BOTC_WakeRender();
                return;
            }
        }
    }
    // 【国王（104）· 首夜那一步】（用户 2026-10-10）：**不唤醒国王本人** ——
    //   在他的夜序位次上把「谁是国王」告诉恶魔（真恶魔 + 疯子）。疯子以为自己是恶魔，
    //   不告诉他，他一看自己没有这条信息就知道自己是假的了。
    ks = BOTC_SeatOfRole(104);
    if (g_kingAnnounced != g_nightNum) {
        if (ks >= 2 && ks <= 13 && g_nightNum <= g_seatFirstNight[ks]) {
            ko = BOTC_NightOrderOf(ks);
            if (ko > 0) {
                if (best < 2 || (ko * 10) <= bestOrd) {
                    g_kingAnnounced = g_nightNum;
                    BOTC_KingAnnounce();
                    BOTC_WakeRender();
                    return;
                }
            }
        }
        else if (ks < 2 && g_nightNum == 1 && BOTC_BoardHasRole(104)) {
            // 【剧本里有国王但不在场】（用户 2026-11-04）：首夜同一位置让说书人选择是否发假信息。
            ko = BOTC_NightOrder(104);
            if (ko > 0 && (best < 2 || (ko * 10) <= bestOrd)) {
                g_kingAnnounced = g_nightNum;
                BOTC_FakeKingAsk();
                BOTC_WakeRender();
                return;
            }
        }
    }
    // 【书生（152）· 首夜第 20 位】（用户 2026-10-31）：不唤醒书生本人，直接告知恶魔书生在场。
    //   （用户 2026-11-08）只保留真书生流程：剧本里有书生但本局没发到时不再自动弹假信息窗；
    //   但场上真有疯子时，仍让说书人选择是否把「书生在场」也告诉疯子（不发真恶魔）。
    if (g_nightNum == 1 && g_pedantInfoNight != g_nightNum) {
        pedantOrd = BOTC_NightOrder(152);
        if (pedantOrd > 0 && (best < 2 || (pedantOrd * 10) <= bestOrd)) {
            if (BOTC_PedantInPlay()) {
                g_pedantInfoNight = g_nightNum;
                BOTC_PedantDealInfo();
                BOTC_WakeRender();
                return;
            }
            if (BOTC_BoardHasRole(152) && BOTC_RealLunaticSeat() >= 2) {
                g_pedantInfoNight = g_nightNum;
                BOTC_FakePedantAsk();
                BOTC_WakeRender();
                return;
            }
        }
    }
    // 【灵言师（85）· 关键词结算】（用户 2026-11-11 改版）：白天说出关键词的玩家不立刻转阵营，
    //   到下一个夜晚的灵言师夜序位次才结算；灵言师那时中毒 / 醉酒则保持记录，顺延到清醒的夜晚。
    if (g_mezeSay >= 2 && !g_mezeDone && g_mezeSayNight < g_nightNum) {
        mezSeat = BOTC_AbilitySeat(85);
        if (mezSeat < 2 || mezSeat > 13) {
            mezSeat = g_mezeSeat;
        }
        mezOrd = BOTC_NightOrder(85);
        if (mezOrd <= 0) {
            mezOrd = 34;      // 部分剧本没有灵言师的次夜位次：按另一张表的同一位次结算
        }
        if (mezSeat >= 2 && mezSeat <= 13 && (best < 2 || (mezOrd * 10) <= bestOrd)) {
            g_mezeSayNight = g_nightNum;   // 同一夜不重复结算；能力不生效时下一夜继续
            BOTC_MezeResolve();
            BOTC_WakeRender();
            return;
        }
    }
    // 【限（147）】被动结算：不唤醒本人、不进私聊；到夜序位置时直接给所有镇民上毒。
    xs = BOTC_XaanAutoSeat();
    if (xs >= 2) {
        xo = BOTC_NightOrder(147);
        if (xo > 0 && (best < 2 || (xo * 10) <= bestOrd)) {
            BOTC_XaanApply(xs);
            BOTC_WakeRender();
            return;
        }
    }
    // 【狐媚娘（153）】处决后的下一夜第 35 位，处理受选者阵营变化。
    if (BOTC_VixenNightStep(bestOrd)) {
        BOTC_WakeRender();
        return;
    }
    // 【异教领袖（106）】到夜序时不唤醒、不私聊，弹窗让说书人选相邻存活玩家的阵营。
    if (BOTC_CultChoiceStep(bestOrd)) {
        BOTC_WakeRender();
        return;
    }
    // 非唤醒夜序节点：到点提示说书人打死亡 token；农夫到点才弹选人面板。
    if (BOTC_NonWakeOrderStep(bestOrd)) {
        BOTC_WakeRender();
        return;
    }
    if (best < 2) {
        g_wakeDone = true;      // 【已行动完毕】（用户 2026-11-08）：主按钮文字固定下来
        BOTC_Notice(g_teller, "所有玩家均已行动完毕。");
        BOTC_WakeRender();
        return;
    }
    g_wakeDone = false;
    if (hatWake) {
        // 【帽匠（120）· 击杀阶段之后】：不唤醒他本人、也不跟他进私聊，只把恶魔 + 爪牙拉进群聊
        g_hatParty[best] = false;
        g_hatWaitOrd[best] = 0;
        g_hatDone[best] = true;
        g_autoWoke[best] = true;
        BOTC_HatGroupChat();
        BOTC_HatRoleStart();          // 【帽匠】茶会之后逐个询问邪恶玩家是否换角色（用户 2026-11-09）
        BOTC_WakeRender();
        return;
    }
    if (pedantWake) {
        g_pedantActing[best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (grantWake) {
        g_boffinActing[best] = false;
        g_boffinActingSource[best] = 0;
        g_grantActing[best] = true;
        g_bnestActing[best] = false;
        g_bnestSource[best] = 0;
        g_grantDoneNight[best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (lunWake) {
        g_boffinActing[best] = false;
        g_boffinActingSource[best] = 0;
        g_grantActing[best] = false;
        g_bnestActing[best] = false;
        g_bnestSource[best] = 0;
        g_lunFakeAct[best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            g_lunFakeAct[best] = false;
            BOTC_WakeRender();
            return;
        }
        g_lunFakeActed = g_nightNum;
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (boffinWake) {
        g_boffinActing[best] = true;
        g_boffinActingSource[best] = boffinSource;
        g_grantActing[best] = false;
        g_bnestActing[best] = false;
        g_bnestSource[best] = 0;
        g_boffinDoneBy[(boffinSource * 14) + best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    if (bnestWake) {
        g_boffinActing[best] = false;
        g_boffinActingSource[best] = 0;
        g_grantActing[best] = false;
        g_bnestActing[best] = true;
        g_bnestSource[best] = bnestSource;
        g_bnestDoneBy[(bnestSource * 14) + best] = true;
        g_autoLast = best;
        if (!g_awake[best]) {
            BOTC_WakeToggle(best);
        }
        if (!g_awake[best]) {
            BOTC_WakeRender();
            return;
        }
        BOTC_TellerPmTo(best);
        BOTC_WakeRender();
        return;
    }
    g_boffinActing[best] = false;
    g_boffinActingSource[best] = 0;
    g_grantActing[best] = false;
    g_bnestActing[best] = false;
    g_bnestSource[best] = 0;
    g_autoWoke[best] = true;
    // 【逆臣（119）】（用户 2026-10-16）：第二晚起不唤醒他 → 也不跟他进私聊（这一步只告知阵营有没有转变）
    if (g_nightNum >= 2 && g_mark[(g_teller * 14) + best] - 1 == 119) {
        BOTC_WakeToggle(best);
        BOTC_WakeRender();
        return;
    }
    // 【帽匠（120）】（用户 2026-10-16）：他的夜序位只是开茶会 ---- 不唤醒他本人、也不跟他进私聊
    if (g_mark[(g_teller * 14) + best] - 1 == 120) {
        BOTC_WakeToggle(best);
        BOTC_WakeRender();
        return;
    }
    g_autoLast = best;
    if (!g_awake[best]) {
        BOTC_WakeToggle(best);
    }
    if (!g_awake[best]) {
        BOTC_WakeRender();
        return;
    }
    // 跟他进私聊：说书人那边回车直接进这条私聊（统一走 BOTC_TellerPmTo）
    // 【理发师（62）】（用户 2026-09-21）：这一格实际是「再次唤醒恶魔」，所以私聊开给那只恶魔
    chatTo = best;
    if (BOTC_HasAbility(best, 62) && g_barberFrom >= 2) {
        chatTo = g_barberFrom;
    }
    BOTC_TellerPmTo(chatTo);
    BOTC_WakeRender();
}

// 【这个座位是不是电脑】（用户 2026-09-20）：电脑玩家没人操作技能面板 ---- 脚本替他选目标，
//   这样说书人能看到后面的流程（侍女 / 占卜师被唤醒后弹的答题框等）。
bool BOTC_SeatIsComputer (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    return (PlayerType(g_who[q]) != 1);   // 1 = 真人；q 是格子 → 问"这格现在坐的人"（物理座位）
}

// 【首夜固定信息弹窗 · 离开这一步时收掉】（用户 2026-11-09）：
//   疯子假爪牙（0）/ 提线木偶追问（15）/ 书生 × 疯子（16）/ 国王 × 疯子（18）这几块框
//   由「首夜固定信息」步骤直接弹出，本人并没有被唤醒，所以收回唤醒那套按座位匹配的
//   BOTC_WakeActionPanelsClose() 收不到它们，点【唤醒下一个】后会一直盖在屏幕上。
//   这里按【取消】口径收掉：这次不发送。
void BOTC_InfoPopupClosePending () {
    int k;
    // 【疯子·假能力】角色网格（模式 33）也挂在这里收：点【唤醒下一个】时默认「跳过」，
    //   否则它会盖在下一位的唤醒面板上（用户 2026-11-10）。
    if (g_pickDlg > 0 && g_pickMode[g_teller] == 33) {
        BOTC_PickChoose(g_teller, -1);
    }
    if (g_miDlg <= 0 || !DialogIsVisible(g_miDlg, g_teller)) {
        return;
    }
    if (g_miRole != 41 || g_miSeat < 2 || g_miSeat > 13) {
        return;
    }
    if (g_miKind != 0 && g_miKind != 15 && g_miKind != 16 && g_miKind != 18 && g_miKind != 23 && g_miKind != 24 && g_miKind != 25) {
        return;
    }
    k = g_miKind;
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    // 【疯子 · 假疯子】（用户 2026-11-10）：这里只是「随唤离场」把当前框收掉，
    //   不能顺带再弹下一条追问（提线木偶取消会接假疯子追问），否则新框会盖到下一位身上。
    if (k == 15) {
        BOTC_PmStore(g_teller, "【信息】已取消本次附加信息，不向该玩家发送。");
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        g_miSeat = 0;
        g_miRole = -1;
        g_miKind = 0;
        // 【疯子信息合批】（用户 2026-11-10）：链被这里打断，已经确认的爪牙信息照常一次性发给疯子。
        BOTC_LunInfoFlush();
        return;
    }
    BOTC_MiCancelApply();
    g_miSeat = 0;
}

// 【收回唤醒：收掉没选完的行动弹窗】（用户 2026-11-02）：
//   玩家还没选完就被收回 → 身份网格 / 专用面板一起关掉，默认按「不发动」处理。
//   ⚠ 顺序有讲究：模式 41 取消会重新显示技能面板、模式 12 取消会重新显示信息框，
//   所以本函数必须在 BOTC_WakeApply 里「关技能面板」那几句**之前**调用。
void BOTC_WakeActionPanelsClose (int q) {
    int ob;
    int mode;
    int act;
    if (q < 2 || q > 13) {
        return;
    }
    act = BOTC_ActRoleOf(q);
    // ① 说书人手上的身份网格：只认夜间行动用到的模式，模式 0（改身份）绝不能走取消
    mode = g_pickMode[g_teller];
    if (mode == 42 || mode == 23 || mode == 21 || mode == 28 || mode == 9) {
        if (g_pickWho[g_teller] == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 10 || mode == 11 || mode == 12) {
        if (g_miSeat == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 19) {
        if (g_engSeat == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 17) {
        if (g_cannSeat == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 18) {
        if (g_rangerBy == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 26) {
        if (g_wudSeat == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 27) {
        if (g_wudBy == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 32) {
        if (g_boffinEditSource == q) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    else if (mode == 16) {
        if (act == 67) {
            BOTC_PickChoose(g_teller, -1);
        }
    }
    // ② 玩家自己手上的身份网格：观察者就是 g_who[q]，只认夜间行动用到的模式
    ob = g_who[q];
    if (ob >= 1 && ob <= 13 && ob != g_teller) {
        mode = g_pickMode[ob];
        if (mode == 5 || mode == 8 || mode == 30 || mode == 35 || mode == 41 || mode == 43) {
            BOTC_PickChoose(ob, -1);
        }
        else if (mode == 14 || mode == 15) {
            if (g_pickWho[ob] == q) {
                BOTC_PickChoose(ob, -1);
            }
        }
    }
    // ③ 说书人 / 玩家的专用夜间面板：只收为这个座位打开的那一块
    // 【二选一醉酒】（用户 2026-11-08）：那个框不记 g_miSeat，按发起座位 g_dkFrom 收，
    //   否则唤醒下一个时它会一直挂在屏幕上（下一位的面板还会叠在它上面）。
    if (g_miRole == 807 && g_dkFrom == q) {
        BOTC_DrunkPickClose();
    }
    if (g_miRole == 813 && g_miSeat == q) {
        BOTC_GudiaoClose();
    }
    else if (g_miDlg > 0 && g_miSeat == q && g_miRole != 801 && g_miRole != 802 && g_miRole != 803 && g_miRole != 808) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        // 【疯子信息合批】（用户 2026-11-10）：疯子首夜那三个框被收回唤醒时只静默收起，
        //   不再接下去追问（新框会盖到下一位身上），已经确认的部分照常一次性发给疯子。
        if (g_miRole == 41 && (g_miKind == 0 || g_miKind == 15 || g_miKind == 23)) {
            if (g_miKind == 0) {
                BOTC_LunInfoClean();
            }
            else {
                BOTC_LunInfoFlush();
            }
            g_evilA = 0;
            g_evilB = 0;
            g_evilC = 0;
            g_evilD = 0;
            g_miRole = -1;
            g_miKind = 0;
        }
        else {
            BOTC_MiCancelApply();
        }
        g_miSeat = 0;
    }
    if (g_nobleDlg > 0 && g_nobleSeat == q) {
        DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), false);
        g_nobleSeat = 0;
    }
    if (g_engDlg > 0 && g_engSeat == q) {
        // 已经提交、只剩「谁变哪个爪牙」时按默认顺序收尾；其余阶段视作不使用能力。
        if (g_engStage == 4) {
            BOTC_EngAssign(0);
        }
        else {
            if (g_engStage == 5) {
                BOTC_EngAssignOne(0);
            }
            else {
                BOTC_EngCancel();
            }
        }
    }
    if (g_farmDlg > 0 && g_farmSeat == q) {
        DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), false);
        g_farmSeat = 0;
        g_farmViaLevi = false;
    }
    if (g_wakeChoiceDlg > 0 && g_wakeChoiceSeat == q) {
        BOTC_WakeAbilityChoiceCancel();
    }
    if (g_organDlg > 0 && g_organSeat == q) {
        g_organSeat = 0;
        DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    }
    // ④ 饕餮（154）：状态按客户端号记，确认是这一格的行动才收
    ob = g_who[q];
    if (ob >= 1 && ob <= 13 && g_taotieOpen[ob] && g_taotieActor[ob] == q) {
        BOTC_TaotieClear();
    }
    // ⑤ 理发师（62）把恶魔叫醒了：收回这一格 = 恶魔放弃交换
    if (g_barberFrom >= 2 && g_barberFrom == q) {
        BOTC_BarberDecline(q);
    }
    // ⑥ 麻脸巫婆造出恶魔后的「生死无常」挂在说书人自己那一格
    if (g_hagKill && act == 67) {
        g_hagKill = false;
        g_skillPicking[1] = false;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    }
    // ⑦ 奥赫（134）角色在场时，最终死亡玩家由说书人在他自己那一格上点
    if (g_ojoAskSt && act == 134) {
        g_ojoAskSt = false;
        g_ojoFrom = 0;
        g_ojoRole = -1;
        g_ojoAllow[1] = false;
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    }
}

void BOTC_WakeApply (int q, bool manual) {
    int r;
    int dm;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_awake[q]) {
        // 【间谍 / 寡妇】（用户 2026-11-10）：收回唤醒 = 还没到点的自动看魔典一起取消
        BOTC_PeekWaitClear(q);
        BOTC_UtWaitClear(q);           // 【送葬者】收回唤醒 = 还没到点的自动发信息一起取消
        // 【中毒 / 醉酒间谍或寡妇】本人还没作答的「真实/伪造魔典」弹窗也一起静默作废
        if (g_fakeAskP == q) {
            BOTC_FakeAskAnswer(-2);
        }
        // 收回唤醒时，如果这个人正在看说书人魔典（间谍），先把魔典换回他自己那份
        BOTC_SpyPeekEnd();
        // 【没选完的弹窗一起收掉】（用户 2026-11-02）：必须排在下面关技能面板之前
        //   （模式 41 取消会重显技能面板、模式 12 取消会重显信息框）。
        BOTC_WakeActionPanelsClose(q);
        g_awake[q] = false;
        g_skillPicking[q] = false;
        g_limitedAsk[q] = false;
        g_poAsk[q] = false;
        g_skillRoleSel[q] = 0;
        g_skillT1[q] = 0;
        g_skillT2[q] = 0;
        g_skillT3[q] = 0;
        DialogSetVisible(g_skillDlg[q], PlayerGroupSingle(g_who[q]), false);
        BOTC_SkillBtnRender();
        if (q >= 2) {
            BOTC_PmInfo(g_who[q], "【夜晚】说书人收回了你的技能。");
        }
        BOTC_Notice(g_teller, "取消唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
        BOTC_PmStore(g_teller, "【夜间】收回 " + BOTC_NameStr(q) + "（" + BOTC_SeatRoleStr(q) + "）的技能。");
        if (g_sgSeat == q) {                   // 【修行者（114）】收回他的唤醒 = 把那个面板一起收掉
            BOTC_SgClose();
        }
        if (g_gblSeat == q) {                  // 【赌徒】收回他的唤醒 = 判定面板一起收掉
            BOTC_GblClose();
        }
        g_boffinActing[q] = false;
        g_boffinActingSource[q] = 0;
        g_grantActing[q] = false;
        g_bnestActing[q] = false;
        g_bnestSource[q] = 0;
        g_lunFakeAct[q] = false;
        g_wakeCurrentOrd = 0;
        return;
    }
    // 【使用技能】（用户 2026-11-06）：座 1 只在说书人临时扮演了角色时才允许走夜间流程。
    if (q == 1 && (g_tellCastRole <= 0 || g_tellCastRole > 163)) {
        return;
    }
    if (q >= 2 && !g_seatOn[q]) {
        BOTC_Notice(g_teller, "这个座位现在没有人，不能唤醒。");
        return;
    }
    // 【疯子·假能力】（用户 2026-11-10）：这一步只把疯子骗过去 ——
    //   照常唤醒、照常开面板让他选人；确认后走正常结算，但 BOTC_SkillWorks 期间返回 false，
    //   所以效果按中毒 / 醉酒处理、一律不生效；这里也顺带不碰任何角色专用面板。
    if (g_lunFakeAct[q] && g_lunFakeAbil > 0 && g_lunFakeAbil <= 164) {
        g_awake[q] = true;
        g_wakeCurrentOrd = BOTC_LunFakeNightOrder(q);
        if (g_wakeCurrentOrd > g_nightCursorOrd) {
            g_nightCursorOrd = g_wakeCurrentOrd;
        }
        g_wokeTonight[q] = true;
        g_skillT1[q] = 0;
        g_skillT2[q] = 0;
        g_skillT3[q] = 0;
        g_skillPicking[q] = false;
        BOTC_SkillBtnRender();
        BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了。");
        BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "（假能力「" + g_roleName[g_lunFakeAbil - 1] + "」，按中毒 / 醉酒处理：效果不生效）。");
        BOTC_PmStore(g_teller, "【疯子·假能力】唤醒 " + BOTC_NameStr(q) + "：他以为自己在用「" + g_roleName[g_lunFakeAbil - 1] + "」，这次能力按中毒 / 醉酒处理，效果不生效。");
        BOTC_TellerPmTo(q);
        BOTC_SkillOpen(q);
        return;
    }
    r = BOTC_ActRoleOf(q);
    if (r < 0 || r > 163) {
        BOTC_Notice(g_teller, "这个座位还没有身份，不能唤醒。");
        return;
    }
    // 送葬者的最终自动拦截：本体、手工赋予、科学怪人借用都走这里。
    //   当天没有「被处决并死亡」的玩家时，不唤醒本人，也不继续打开私聊。
    if (!manual && r == 6 && !BOTC_ExecutedDeathToday()) {
        BOTC_PmStore(g_teller, "【送葬者】今天没有因处决而死亡的玩家，本次自动唤醒跳过。");
        return;
    }
    // 【逆臣（119）】（用户 2026-10-16）：第二晚起**不唤醒他** ---- 他的夜序位只做一件事：
    //   告诉他阵营有没有转变（没转变就什么都不发，人也不醒、不弹面板、不进私聊）。
    //   ⚠ 按「魔典上写的身份」判 ---- 酒鬼 / 悟道者那些以为自己是他的人也会轮到这个位次，
    //     但他们没有实际能力，所以什么都不做（用户 2026-10-16）。
    if (!manual && !g_boffinActing[q] && g_nightNum >= 2 && g_mark[(g_teller * 14) + q] - 1 == 119) {
        if (BOTC_HasAbility(q, 119)) {
            if (g_tcPending >= 2 && g_tcPending <= 13) {
                BOTC_TurncoatApply(g_tcPending);
                g_tcPending = 0;
            }
            else {
                BOTC_PmStore(g_teller, "【逆臣】轮到他这一步：阵营没有转变，什么都不发。");
            }
        }
        return;
    }
    // 【帽匠（120）】（用户 2026-10-16 / 2026-11-04）：他**死后**的那一个夜晚，轮到他这一步就把
    //   「恶魔 + 爪牙」拉进群聊（跟小怪宝一样的恶人频道，提线木偶不进）。
    //   白天死亡也走同一条路径：由自动唤醒排到他的夜序位开；这里只是兜底（手动唤醒等）。
    if (!manual && !g_boffinActing[q] && g_mark[(g_teller * 14) + q] - 1 == 120) {
        if (BOTC_HasAbility(q, 120) && BOTC_SeatDead(q) && !g_hatDone[q]) {
            g_hatDone[q] = true;
            g_hatParty[q] = false;
            g_hatWaitOrd[q] = 0;
            BOTC_HatGroupChat();
            BOTC_HatRoleStart();      // 【帽匠】茶会之后逐个询问邪恶玩家是否换角色（用户 2026-11-09）
        }
        return;
    }
    // 【女巫（65）· 自动唤醒前再拦一次】（用户 2026-10-21）：公共判定之后仍有个别特殊分支，
    // 这里放在自动流程入口的第一层；说书人手动强制唤醒不受这条限制。
    if (!manual && r == 65 && BOTC_HasAbility(q, 65) && !BOTC_WitchCanAct(q)) {
        BOTC_Notice(g_teller, "女巫只剩 3 名存活玩家，能力已失效，不再唤醒她。");
        return;
    }

    // 自动唤醒按角色的行动类别判断今晚能不能唤醒；手动唤醒只看座位、身份和借用能力来源。
    if (g_boffinActing[q]) {
        if (!BOTC_BoffinWorksAt(g_boffinActingSource[q]) || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "【科学怪人】来源失效或恶魔已经死亡，这次借用能力不能唤醒。");
            g_boffinActing[q] = false;
            g_boffinActingSource[q] = 0;
            return;
        }
    }
    else if (g_grantActing[q]) {
        if (g_grantRoleBy[q] <= 0 || g_grantRoleBy[q] > 163 || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "【赋予能力】附加能力已经不存在或玩家死亡，这次唤醒取消。");
            g_grantActing[q] = false;
            return;
        }
        if (g_grantDrunkBy[q]) {
            BOTC_PmStore(g_teller, "【赋予能力】这份附加能力处于醉酒状态：面板可以照常打开，但能力效果无效。");
        }
    }
    else if (g_bnestActing[q]) {
        if (!BOTC_BoffinNestedWorksAt(g_bnestSource[q], q) || (!manual && BOTC_SeatDead(q))) {
            BOTC_PmStore(g_teller, "来源失效或恶魔已经死亡，这次能力不能唤醒。");
            g_bnestActing[q] = false;
            g_bnestSource[q] = 0;
            return;
        }
    }
    else if (g_pedantActing[q]) {
        if (!manual && BOTC_SeatDead(q)) {
            BOTC_PmStore(g_teller, "【书生】已猜测玩家已经死亡，这次额外行动取消。");
            g_pedantActing[q] = false;
            return;
        }
    }
    else {
        if (!manual && !BOTC_CanWakeAt(q)) {
            BOTC_Notice(g_teller, BOTC_WakeBlockStr(q));
            return;
        }
    }
    // （猎手那种「公开触发」的角色现在连唤都唤不醒，见 BOTC_CanWakeAt；所以这里不用再提醒）
    g_awake[q] = true;
    if (g_boffinActing[q]) {
        g_wakeCurrentOrd = BOTC_NightOrder(g_boffinRoleBy[g_boffinActingSource[q]] - 1);
    }
    else if (g_grantActing[q]) {
        g_wakeCurrentOrd = BOTC_GrantNightOrder(q);
    }
    else if (g_bnestActing[q]) {
        g_wakeCurrentOrd = BOTC_NightOrder(g_bnestRoleBy[g_bnestSource[q]] - 1);
    }
    else if (g_pedantActing[q]) {
        g_wakeCurrentOrd = BOTC_NightOrder(152);
    }
    else {
        if (q == 1) {
            g_wakeCurrentOrd = BOTC_NightOrder(r);
        }
        else {
            g_wakeCurrentOrd = BOTC_NightOrderOf(q);
        }
    }
    if (g_wakeCurrentOrd > g_nightCursorOrd) {
        g_nightCursorOrd = g_wakeCurrentOrd;
    }
    g_wokeTonight[q] = true;      // 侍女（24）查的就是这一条：今晚因为自己的技能被唤醒过
    g_skillT1[q] = 0;
    g_skillT2[q] = 0;
    g_skillT3[q] = 0;
    g_skillPicking[q] = false;
    BOTC_SkillBtnRender();
    // 【理发师（62）】（用户 2026-09-21）：这一步**不是**唤醒理发师，而是再唤醒一次恶魔（让他交换角色）。
    //   所以私聊 / 提示都写给恶魔，理发师本人（已经死了）什么都不发、面板也不给他开。
    if (r == 62) {
        dm = BOTC_FindDemon();
        if (dm >= 2) {
            BOTC_PmInfo(g_who[dm], "【夜晚】你被唤醒了（理发师：选两名玩家交换他们的角色）。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(dm) + " 恶魔（理发师交换）。");
            BOTC_PmStore(g_teller, "【夜间】唤醒 " + BOTC_NameStr(dm) + "（恶魔）---- 理发师 " + BOTC_NameStr(q) + " 的能力：交换两名玩家的角色。");
        }
        else {
            BOTC_PmStore(g_teller, "【理发师】场上没有活着的恶魔，这一步跳过。");
        }
    }
    else {
        if (g_boffinActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了：现在使用科学怪人赋予你的「" + g_roleName[r] + "」能力。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "（恶魔借用「" + g_roleName[r] + "」能力）。");
        }
        else if (g_grantActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "（附加能力「" + g_roleName[r] + "」）。");
        }
        else if (g_bnestActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了：现在使用科学怪人经哲学家 / 炼金术士赋予你的「" + g_roleName[r] + "」能力。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "：" + g_roleName[r]);
        }
        else if (g_pedantActing[q]) {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了：书生已猜测，选择一名玩家。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + "：结算书生的额外攻击。");
        }
        else {
            BOTC_PmInfo(g_who[q], "【夜晚】你被唤醒了。");
            BOTC_Notice(g_teller, "已唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
        }
    }
    // 【教父必须进私聊】（用户 2026-10-16 第三次报：「不管自动还是手动唤醒都不会自动进，只有教父」）：
    //   不再限制「只首夜」---- 只要教父被唤醒就跟别的角色一个待遇，走统一的 BOTC_TellerPmTo。
    if (r == 39 && q >= 2 && g_who[q] >= 2) {
        BOTC_TellerPmTo(q);
    }
    // 【横行霸道 · 炼金术士(95)】（用户 2026-10-03）：首夜唤醒他时，给说书人弹"只列爪牙"的网格
    // 【酒鬼 / 提线木偶 版本也要弹】（用户 2026-10-13）：这里原来判**真身** 95 ----
    //   可酒鬼(14) / 提线木偶(93) 的魔典上写的是「炼金术士」，真身并不是 95 → 他们永远拿不到这个面板。
    //   本函数里 r 就是「魔典上写的身份」（他以为自己是的那只），按 r 判才对。
    if (r == 95 && !g_boffinActing[q] && !g_bnestActing[q] && BOTC_ActingIsFirstNight(q)) {
        BOTC_AlcBorrowOpen(q);
    }
    // 【横行霸道 · 将军(96)】（用户 2026-10-03）：**每夜**唤醒他时都弹面板（说书人填 善良 / 邪恶 / 均势）
    if (r == 96) {  // 【按魔典上写的身份判】（用户 2026-10-13，酒鬼 / 提线木偶 版本也要弹）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【将军】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，答案随你给。");
        }
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 96, "");
    }
    // 被唤醒时把魔典给他打开（行动完成前关不掉）
    // 【理发师（62）】（用户 2026-09-21）：他不算被唤醒，魔典 / 面板都不给他开
    // 【间谍（18）/ 寡妇（75）】（用户 2026-11-10）：不先摊自己那份，等 1..5 秒直接摊说书人那份
    if (r != 62 && r != 18 && r != 75) {
        BOTC_GrimRender(g_who[q]);
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), true);
        g_grimOn[g_who[q]] = true;
    // 【魔典会盖住面板】（用户 2026-10-03）：说书人面板(将军) / 只列爪牙的网格(炼金术士) 都建得比魔典**早**，
    //   光"重新显示"压不上去 -> 这两个角色被唤醒时直接把魔典收掉（跟麻脸巫婆开面板前先收魔典是同一套做法）
    if ((r == 96 || r == 95 || r == 104 || r == 109 || r == 108)) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[q]), false);
        g_grimOn[g_who[q]] = false;
    }
    }
    // 【间谍（18）/ 寡妇（75）】（用户 2026-11-10）：唤醒后不再点【使用技能】，
    //   延迟 1..5 秒自动把**说书人那份实时真魔典**摊开；寡妇看完先选是否抄录，再进下毒面板。
    if (r == 18 || r == 75) {
        BOTC_PeekQueue(q, (r == 75));
    }
    // 【顺序】先唤醒（上面几句），再给信息，最后才是他选目标 / 被收回（收在 BOTC_SkillConfirm 或说书人手里）
    BOTC_PmStore(g_teller, "【夜间】唤醒 " + BOTC_NameStr(q) + " " + BOTC_SeatRoleStr(q) + "。");
    // 【假疯子刀人】（用户 2026-11-12）：正常自动唤醒时，这一步已经作为「假疯子」夜序
    //   在唤醒他本人**之前**单独问过（见 BOTC_AutoWakeNext）；这里只补说书人手动唤醒、
    //   且今晚还没问过的情况。函数内部还会按座位 / 存活 / 是否真疯子兜一遍。
    if (manual && g_lunFakeKillNight != g_nightNum && BOTC_IsLunatic(q) && q == g_lunFakeTo) {
        g_lunFakeKillNight = g_nightNum;
        BOTC_LunaticFakeKillAsk();
    }
    if (r == 102) {
        BOTC_VizierFearChat(q);
    }
    // 【科怪嵌套哲学家 / 炼金术士】只在尚未发动时再次弹选择；发动后自动唤醒会跳过。
    if (g_boffinActing[q] && (r == 56 || r == 95) && !g_bnestChosenBy[g_boffinActingSource[q]]) {
        BOTC_BoffinNestedOpen(g_boffinActingSource[q]);
    }
    // ===== 【横行霸道 · 新角色的唤醒动作】=====（用户 2026-10-03）
    //   挂在这行后面 = 每次唤醒（自动/手动）都一定会跑到，跟教父首夜那条不同（那条只在首夜跑）。
    //   ① 炼金术士(95)：首夜弹「只列爪牙」的网格，让说书人替他挑借到哪一只
    if (r == 95 && !g_boffinActing[q] && !g_bnestActing[q] && BOTC_ActingIsFirstNight(q)) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        BOTC_AlcBorrowOpen(q);
    }
    // 【科学怪人（132）】每夜手动重新唤醒都从身份网格重新选能力，再选接收者。
    if (r == 132) {
        if (BOTC_BoffinSourceIs(q)) {
            BOTC_BoffinOpenRole(q);
        }
        else {
            BOTC_BoffinOpenStatus(q);
        }
    }
    // 【送葬者】（用户 2026-11-11）：清醒时延迟 1..5 秒自动私聊今天被处决者的角色；
    //   中毒 / 醉酒 / 酒鬼 / 提线木偶 / 涡流（信息错误），
    //   或被处决者是真陌客 / 真间谍时，改由说书人从身份网格里手动选。
    //   说书人主动手动唤醒（manual）时也保留手动选择，方便临时改口供。
    if (r == 6) {
        if (!manual && BOTC_SkillWorks(q) && !BOTC_InfoErrorOn(q) && !BOTC_UtMaskSeat(BOTC_UtExecSeat())) {
            BOTC_UtQueue(q);
        }
        else {
            BOTC_UtPickOpen(q);
        }
    }
    // 【守鸦人】唤醒后由说书人从身份网格中选择本夜要告知的角色。
    if (r == 8) {
        g_pickMode[g_teller] = 42;
        g_pickWho[g_teller] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(g_teller, false);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
    }
    // 【保留角色】骑士首次夜晚填两名非恶魔；鸩弹「只列镇民」的角色网格。
    if (r == 122) {
        BOTC_ManInfoOpenSeats(q, "【骑士】填两名玩家（左 / 右各一个座位号 1~12）", 13);
    }
    if (r == 142) {
        BOTC_ManInfoOpenSeats(q, "【事务官】填一名玩家（座位号 1~12）", 14);
    }
    if (r == 124) {
        BOTC_LimitedAskOpen(q);
    }
    if (r == 78) {
        BOTC_LimitedAskOpen(q);
    }
    if (r == 125) {
        BOTC_ManInfoOpen(q, 125, "");
    }
    //   ② 将军(96)：每夜都弹真人说书面板（说书人填 善良 / 邪恶 / 均势）
    if (r == 96) {  // 【同上】（用户 2026-10-13）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【将军】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，答案随你给。");
        }
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 96, "");
    }
    // 【何方教众（板子 9）】（用户 2026-10-10）：这 11 个角色唤醒时的附加动作（面板 / 信息 / 提醒）
    BOTC_HfWakeAction(q);
    // 【牙噶巴卜（133）】（用户 2026-10-21）：他的第一个夜晚只输入并发送秘密短语；
    //   之后每个白天由 BOTC_YaggaListen() 在公聊里自动统计他说出短语的次数，夜晚夜序位次告知说书人。
    if (r == 133 && BOTC_ActingIsFirstNight(q)) {
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【牙噶巴卜】" + BOTC_NameStr(q) + " 中毒/酒鬼：短语仍可按规则给他，但能力是否生效由你判断。");
        }
        BOTC_ManInfoOpen(q, 809, "");
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：国王身上带着「死亡（恶魔）」token 时唤醒他 → 弹填数字框
    if (r == 108 && BOTC_ChoirboyKingDead()) {  // 【按魔典上写的身份判】（用户 2026-10-13）
        if (BOTC_SeatImpaired(q)) {
            BOTC_PmStore(g_teller, "【唱诗男孩】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 能力失效，随便给。");
        }
        BOTC_ManInfoOpen(q, 804, "");
    }
    // 【首夜信息位 · 新面板】（用户 2026-09-21）：洗衣妇（0）/ 图书管理员（1）/ 调查员（2）填两个座位号 + 选一个身份，
    //   祖母（22）填一个孙子 + 选他的身份；点【确定】由脚本私聊给他，并自动打「正确 / 错误」token。
    //   唤醒时自动挑人那套已经删掉，全由说书人自己填。
    if ((r == 0 || r == 1 || r == 2 || r == 22)) {
        BOTC_MiFnOpen(q, r);
    }
    // 【贤者（59）】（用户 2026-09-21）：被恶魔杀死的那一晚，弹「填两个玩家」的框（脚本预填真恶魔 + 一个陪衬）
    // 【镜像双子（64）】（用户 2026-09-21）：他和首夜信息位是同一类判定 ----
    //   · 行动类别和洗衣妇 / 图管 / 调查员 / 祖母一样是「首夜信息位」（g_roleAct = 5）：
    //     只有他的「首夜」那一晚会被唤醒；复活 / 被麻脸巫婆造出来会重新算首夜（g_seatFirstNight）。
    //   · 唤醒时同样弹一块「填座位号 + 选身份」的面板（这一块是配对面板，角色代号 23）。
    //   · 配对还算数就不重复配：他本人没变、对立双子还在场、对方身上「对立双子(77)」标记还在。
    if (r == 64) {
        if (g_twinA != q) {
            g_twinB = 0;                 // 换局残留 / 上一只双子留下的记录，一律作废
        }
        g_twinA = q;
        if (g_twinB >= 2) {
            if (!g_seatOn[g_twinB] || !g_tokOn[(((g_teller * 14) + g_twinB) * 256) + 77]) {
                g_twinB = 0;             // 对立双子不在场了 / 身上标记没了 → 这一对不算数
            }
        }
        if (g_twinB >= 2) {
            BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(q) + " 这一对还算数（对立双子是 " + BOTC_NameStr(g_twinB) + "），这次不用再配。");
            // 【不在这里补发信息】（用户 2026-10-14）：中毒 / 酒鬼那一次的信息脚本不补 ----
            //   要补你自己私下告诉他们；配对 token 也可以在 token 面板上手动点 76 / 77。
        }
        else {
            BOTC_Notice(g_teller, "【镜像双子】填对立双子的座位号，再选他的身份（身份都能选）。");
            BOTC_MiFnOpen(q, 23);
            return;
        }
    }
    // 【洗脑师（66）/ 麻脸巫婆（67）】（用户 2026-09-21）：**两个都是玩家自己填** → 唤醒后不弹说书人面板，
    //   由下面那条通用规则把技能面板开出来（先选目标 → 再自己从身份网格里选身份）。
    if (r == 59) {
        BOTC_SageOpen(q, false);
    }
    // 街头风琴手：玩家自己选择是否主动醉酒到下一个黄昏。
    if (r == 140) {
        BOTC_OrganOpen(q);
    }
    // 【理发师（62）】（用户 2026-09-21）：他死的那一晚，这个槽位实际是唤起恶魔交换两名玩家
    if (r == 62) {
        BOTC_BarberOpen(q);
    }
    // 厨师（3）/ 共情者（4）：老的数字框（脚本把正确答案显示在框下面，说书人自己填）
    if ((r == 3 || r == 4)) {
        BOTC_ManInfoOpen(q, r, "");
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：跟共情者 / 厨师一样 ---- 被唤醒时弹数字框，
    //   说书人填「要给他看的座位号」（1~12 → 玩家 2~13），他收到「你得知X。」
    if (r == 72) {
        BOTC_ManInfoOpen(q, 72, "");
        // 【路由】（用户 2026-09-23）：【确定】按钮是按 g_miRole >= 60 派发的，
        //   而那个发送函数的编号惯例是 60 + 角色 → 这里补成 132（= 60 + 72），
        //   它里面的 role == 72 分支才会命中（否则会被算成 72-60 = 12 = 镇长）。
        g_miRole = 132;
    }
    // 【梦殒春宵 · 用户 2026-09-21】钟表匠 / 数学家 的答案由脚本先算好填进框里，你可以直接确定或改掉
    if (r == 47) {
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 47, "");
    }
    if (r == 50) {
        // 【数学家：脚本先把正确答案填进框里】（用户 2026-11-04）
        BOTC_ManInfoOpenPre(q, 50, "", IntToString(BOTC_MalfCount(q)));
    }
    if (r == 53) {
        g_miTrue = "";
        BOTC_ManInfoOpen(q, 53, "");
    }
    // 【哲学家】（56）：还没选过角色就弹身份网格（只列善良角色，用户 2026-09-21）
    if (r == 56 && !BOTC_ProtectTokOn(q, 70)) {
        BOTC_LimitedAskOpen(q);
    }
    if ((r == 51 || r == 52 || r == 53)) {
        BOTC_ManInfoOpen(q, r, "");
    }
    if (r == 58) {
        // 【杂耍艺人改由说书人手动填写】（用户 2026-11-12）：不再自动预填猜对数量。
        BOTC_ManInfoOpen(q, 58, "");
    }
    if (r == 76) {
        BOTC_NobleOpen(q);
    }
    if (r == 90) {
        // 【赏金猎人】正常唤醒：把一名邪恶玩家的座位告诉他（设置调整已在首夜更早一步单独提醒）
        BOTC_ManInfoOpen(q, 90, "");
        g_miRole = 150;
    }
    if (r == 91) {
        BOTC_MiFnOpen(q, 26);
    }
    if (r == 85 && BOTC_ActingIsFirstNight(q)) {   // 【只有首夜】（用户 2026-10-18）
        BOTC_MezeOpen(q);
    }
    // 【风雅集（板子 10）】（用户 2026-10-16）：修行者（114）两选一 / 店小二（115）填两名玩家
    if (r == 114) {
        BOTC_SgOpen(q);
    }
    if (r == 115) {
        BOTC_DxeNightOpen(q);
    }
    // 【数学家】效果类角色（要选人那种）：中毒 / 酒鬼还用了能力 = 能力被挡下 → 记一格「未正常生效」
    //   信息类的几位改成「说书人给的答案和真身对不上才记」，见 BOTC_MalfNote（用户 2026-09-21）
    // 【数学家 × 提线木偶】（用户 2026-11-12）：提线木偶被唤醒就代表能力未正常生效，记一格。
    if ((!BOTC_SkillWorks(q) && g_roleTargets[r] > 0 && r != 24 && r != 50 && r != 55 && r != 27) || BOTC_IsMarionette(q)) {
        BOTC_MalfMark(q);
    }
    // 【被唤醒就直接弹技能面板】（用户 2026-09-20）：教父（39）只在「今天有外来者死」那晚才弹（首夜只听信息）
    // 【理发师（62）】（用户 2026-09-21）：他的面板由 BOTC_BarberOpen 自己开（要换成交换用的标题），这里跳过
    // 【间谍（18）/ 寡妇（75）】（用户 2026-11-10）：先等 1..5 秒自动摊开魔典，寡妇抄录选完才进下毒面板，这里不提前弹
    if (g_started && r >= 0 && r <= 163 && (g_pedantActing[q] || g_roleTargets[r] > 0 || r == 151 || r == 162) && r != 36 && r != 62 && r != 64 && r != 18 && r != 75 && !(r == 119 && g_nightNum >= 2) && (r != 39 || BOTC_GodfatherCanKill())) {   // 逆臣：只有首夜选人
        BOTC_SkillOpen(q);
    }
    // 【电脑玩家：唤醒之后自动替他选目标】（用户 2026-09-20）
    //   间谍（18）/ 寡妇（75）（用户 2026-11-10）：先等 1..5 秒自动摊开魔典，寡妇抄录选完才轮到下毒
    if (BOTC_SeatIsComputer(q) && r != 162 && r != 18 && r != 75 && (r != 39 || BOTC_GodfatherCanKill()) && !(r == 135 && BOTC_ActingIsFirstNight(q))) {  // 教父不能动 / 卡扎力首夜只私聊
        BOTC_TestAutoSkill(q);
        if (g_gambleWait[q]) {
            BOTC_TestAutoSkill(q);    // 赌徒：第一次是选人，第二次才是猜角色
        }
        if (g_skillT1[q] > 0) {
            BOTC_PmStore(g_teller, "【电脑】" + BOTC_NameStr(q) + " 是电脑：脚本自动替他选了目标。");
        }
    }
}

//--------------------------------------------------------------------------------------------------
// 【使用技能】（用户 2026-11-06）：说书人在【发送特定信息】面板里点【使用技能】，
//   先选一个本剧本存在的角色，然后像玩家一样正常走该角色的夜间行动流程
//   （技能面板 / 信息面板 / 私聊 / token 全部复用 BOTC_WakeApply）。
//   · 临时角色只影响逻辑格 1 的夜间行动，不写进能力层，避免被当成“该角色在场”。
//   · 白天 / 未开始 / 该角色夜间没有行动 → 只提示说书人，不发动。
//--------------------------------------------------------------------------------------------------
bool BOTC_TellerCastCan (int r) {
    int act;
    if (r < 0 || r > 163) {
        return false;
    }
    act = g_roleAct[r];
    if (act == 0 || act == 3 || act == 4) {
        return false;
    }
    if (act == 5 && g_nightNum > 1) {
        return false;
    }
    if (act == 2 && g_nightNum < 2) {
        return false;
    }
    return true;
}

void BOTC_TellerCastOpen () {
    if (!g_started || !g_isNight) {
        BOTC_Notice(g_teller, "【使用技能】只能在夜间使用。");
        return;
    }
    BOTC_SpecClose();
    g_pickMode[g_teller] = 52;
    g_pickWho[g_teller] = 0;
    g_pickForceAlign = -1;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("使用技能：选择一个本剧本的角色"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_TellerCastRole (int r) {
    if (!g_started || !g_isNight) {
        BOTC_Notice(g_teller, "【使用技能】只能在夜间使用。");
        return;
    }
    // 【该角色夜间没有行动】（用户 2026-11-06）：只提示，不改临时角色。
    if (!BOTC_TellerCastCan(r)) {
        BOTC_Notice(g_teller, "该角色夜间没有行动能力。");
        return;
    }
    // 上一份临时角色还开着 → 先按正常取消流程收回，再换新的。
    if (g_awake[1]) {
        BOTC_WakeApply(1, true);
    }
    g_tellCastRole = r + 1;
    BOTC_WakeApply(1, true);
}

// 兼容所有自动唤醒调用：自动流程仍完整使用行动类别、限次和夜间顺序判定。
void BOTC_WakeToggle (int q) {
    BOTC_WakeApply(q, false);
}

// 技能面板控件按**逻辑格**创建。点击事件里的 p 是物理玩家号；
// 换座后继续用玩家号反查控件，容易把旧面板和新座位错开。
// 这里直接按被点击控件的唯一编号找出它所属的逻辑格。
int BOTC_SkillControlOwner (int c) {
    int q;
    for (q = 1; q <= 13; q += 1) {
        if (c == g_skillBtn[q] ||
            c == g_skillSlotA[q] ||
            c == g_skillSlotB[q] ||
            c == g_skillSlotC[q] ||
            c == g_skillNoPick[q] ||
            c == g_skillOk[q] ||
            c == g_skillCancel[q]) {
            return q;
        }
    }
    return 0;
}

// 找这个物理玩家当前坐在哪个逻辑格，并且该格的技能选人面板正在等待目标。
int BOTC_SkillPickerForPlayer (int p) {
    int q;
    for (q = 1; q <= 13; q += 1) {
        if (g_who[q] == p && g_skillPicking[q]) {
            return q;
        }
    }
    return 0;
}

// 统一处理技能面板上的“使用技能 / 清空目标 / 确认 / 取消”。
// 返回 false 表示这次点击的不是技能面板控件。
bool BOTC_SkillClickControl (int p, int c) {
    int q;
    int r;
    q = BOTC_SkillControlOwner(c);
    if (q < 1) {
        return false;
    }
    // 控件只应对它当前所属的玩家或说书人生效。
    if (p != g_who[q] && p != g_teller) {
        return true;
    }
    if (c == g_skillBtn[q]) {
        r = BOTC_ActRoleOf(q);
        if (r == 18) {
            BOTC_SpyPeek(q);
        }
        else if (r == 75) {
            // 【寡妇顺序】（用户 2026-11-06）：先看魔典 → 选是否抄录 → 再进下毒面板
            if (!BOTC_WidowPeek(q)) {
                BOTC_SkillOpen(q);
            }
        }
        else {
            BOTC_SkillOpen(q);
        }
        return true;
    }
    if (c == g_skillSlotA[q]) {
        if (BOTC_DemonTargetLocked(q) && g_skillT1[q] != 0) {
            BOTC_Notice(g_who[q], "恶魔必须选择目标，不能取消。");
            return true;
        }
        g_skillT1[q] = 0;
        BOTC_SkillRender(q);
        return true;
    }
    if (c == g_skillSlotB[q]) {
        if (BOTC_ComboRole(BOTC_ActRoleOf(q))) {
            BOTC_ComboRoleOpen(q);
        }
        else {
            if (BOTC_DemonTargetLocked(q) && g_skillT2[q] != 0) {
                BOTC_Notice(g_who[q], "恶魔必须选择目标，不能取消。");
                return true;
            }
            g_skillT2[q] = 0;
            BOTC_SkillRender(q);
        }
        return true;
    }
    if (c == g_skillSlotC[q]) {
        if (BOTC_DemonTargetLocked(q) && g_skillT3[q] != 0) {
            BOTC_Notice(g_who[q], "恶魔必须选择目标，不能取消。");
            return true;
        }
        g_skillT3[q] = 0;
        BOTC_SkillRender(q);
        return true;
    }
    if (c == g_skillNoPick[q]) {
        if (BOTC_DemonTargetLocked(q)) {
            BOTC_Notice(g_who[q], "恶魔必须选择目标，不能取消。");
            return true;
        }
        BOTC_SkillCancel(q);
        return true;
    }
    if (c == g_skillOk[q]) {
        BOTC_SkillConfirm(q);
        return true;
    }
    if (c == g_skillCancel[q]) {
        if (BOTC_DemonTargetLocked(q)) {
            BOTC_Notice(g_who[q], "恶魔必须选择目标，不能取消。");
            return true;
        }
        BOTC_SkillCancel(q);
    }
    return true;
}

void BOTC_SkillBtnRender () {
    int p;
    for (p = 2; p <= 13; p += 1) {
        // 技能面板已经改成「被唤醒就自动弹」，按钮不再需要了；
        //   【间谍（18）/ 寡妇（75）】（用户 2026-11-10）：唤醒后延迟 1..5 秒自动摊开魔典，也不再给【使用技能】。
        DialogSetVisible(g_skillBtnDlg[p], PlayerGroupSingle(g_who[p]), false);
        // 【理发师交换】面板开在恶魔身上，不能因为这一格没被再次唤醒就顺手关掉。
        if (!g_awake[p] && p != g_barberFrom && !g_skillPicking[p] && !g_limitedAsk[p] && !g_poAsk[p] && !g_pedantActing[p] && !(p == 1 && (g_scarletPick || g_courtPick || g_halfPick))) {
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        }
    }
}

void BOTC_SkillOpen (int p) {
    int r;
    if (g_choiceOrigOn && g_choiceOrigBy == p) {
        g_choiceOrigOn = false;
        g_choiceOrigBy = 0;
    }
    g_choiceSaid[p] = false;
    r = BOTC_ActRoleOf(p);
    // 【疯子·假能力】（用户 2026-11-10）：科学怪人给的那份假能力照常打开通用目标面板；
    //   确认后走正常结算，但 BOTC_SkillWorks 返回 false，效果按中毒 / 醉酒处理、不生效。
    if (g_lunFakeAct[p]) {
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        g_skillPicking[p] = true;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
        BOTC_SkillRender(p);
        BOTC_Notice(g_who[p], BOTC_SkillPickTextFor(p));
        return;
    }
    if (r == 162) {
        BOTC_GudiaoOpen(p);
        return;
    }
    if (g_pedantActing[p]) {
        BOTC_PedantOpen(p);
        return;
    }
    // 【理发师交换兜底】当晚还挂着「今晚理发」，而交换来源没记上（自动步骤被跳过、或说书人
    //   手动再次唤醒恶魔）→ 把这只恶魔补记为交换来源，别再落到它自己的三目标面板上。
    //   ⚠ 只在理发师那一步（夜序 82）之后才补记，避免抢走恶魔自己那一步的夜间行动。
    if (g_barberFrom < 2 && g_barberWait && BOTC_IsDemonSeat(p) && !BOTC_IsLunatic(p) && g_nightCursorOrd >= BOTC_NightOrder(62)) {
        g_barberFrom = p;
        BOTC_PmStore(g_teller, "【理发师】补记交换来源：" + BOTC_NameStr(p) + "（恶魔）。");
    }
    // 理发师交换优先于被唤醒恶魔的原能力：统一显示两个目标槽。
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        g_skillPicking[p] = true;
        DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
        libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("选择两名玩家"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
        libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("取消"), PlayerGroupSingle(g_who[p]));
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
        return;
    }
    // 珀：未憋刀时每夜先询问；憋刀后的下一夜直接进入强制三目标。
    if (r == 46 && !BOTC_ProtectTokOn(p, 52)) {
        BOTC_PoAskOpen(p);
        return;
    }
    // 限次角色先问是否发动；选「否」不消耗机会，选「是」后才进入技能面板。
    if (BOTC_NightLimitRole(r)) {
        if (BOTC_NightLimitUsed(p, r)) {
            // 【用过就不能再开面板】（用户 2026-11-10 报「巡山人用完第二晚还能用」）：
            //   手动唤醒不走 BOTC_CanWakeAt，以前这里会掉进下面的通用面板，等于让他再发一次。
            BOTC_PmStore(g_teller, "【限次能力】" + BOTC_NameStr(p) + " " + BOTC_SeatRoleStr(p) + " 的一次性能力已经用掉了，这次不再打开技能面板。");
            g_skillPicking[p] = false;
            g_limitedAsk[p] = false;
            g_skillT1[p] = 0;
            g_skillT2[p] = 0;
            g_skillT3[p] = 0;
            g_skillRoleSel[p] = 0;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            BOTC_SkillBtnRender();
            return;
        }
        BOTC_LimitedAskOpen(p);
        return;
    }
    if (g_boffinActing[p] && !BOTC_BoffinWorksAt(g_boffinActingSource[p])) {
        BOTC_PmStore(g_teller, "【科学怪人】来源已经失效，这次借用能力不能打开面板。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_bnestActing[p] && !BOTC_BoffinNestedWorksAt(g_bnestSource[p], p)) {
        BOTC_PmStore(g_teller, "来源已经失效，这次能力不能打开面板。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_grantActing[p] && (g_grantRoleBy[p] <= 0 || g_grantRoleBy[p] > 163)) {
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【逆臣（119）】（用户 2026-10-16）：他**只有首夜**能选人 ---- 第二晚起不弹这个面板
    //   （他第二晚起只在「不共戴天的人被处决」那一夜被告知转阵营，见 BOTC_WakeToggle 的 119 分支）
    if (r == 119 && g_nightNum >= 2) {
        return;
    }
    // 侍臣（29）：他选的是**角色**不是座位 ---- 直接弹身份网格（用户 2026-09-20）
    if (r == 29) {
        BOTC_CourtierOpen(p);
        return;
    }
    // 奥赫（134）：他选的也是**角色**不是座位 ---- 直接弹身份网格
    if (r == 134) {
        BOTC_OjoOpen(p);
        return;
    }
    // 卡扎力（135）：首夜自动唤醒后只与说书人私聊，不打开刀人面板；之后正常选人。
    if (!g_boffinActing[p] && r == 135 && BOTC_ActingIsFirstNight(p)) {
        return;
    }
    // 熊孩子（151）：选择的是一张镇民角色，不是玩家座位。
    if (r == 151 && !g_boffinActing[p] && !g_bnestActing[p]) {
        BOTC_RascalOpen(p);
        return;
    }
    // 饕餮（154）：使用专用 12 座位多选面板，不套普通 3 目标槽。
    if (r == 154) {
        BOTC_TaotieOpen(p);
        return;
    }
    // 哲学家（56）：他选的也是**角色**不是座位 ---- 直接弹身份网格（只列善良角色，用户 2026-09-21）
    if (r == 56 && !g_boffinActing[p] && !g_bnestActing[p]) {
        BOTC_PhiloOpen(p);
        return;
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    g_skillRoleSel[p] = 0;
    g_skillPicking[p] = true;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
    BOTC_SkillRender(p);      // 先显示面板再刷槽位：免得显示动作把子控件的显隐覆盖掉
    if (BOTC_ComboRole(r)) {
        BOTC_Notice(g_who[p], "请选择目标1和角色");
    }
    else {
        BOTC_Notice(g_who[p], BOTC_SkillPickTextFor(p));
    }
}

void BOTC_SkillRender (int p) {
    int r;
    r = BOTC_ActRoleOf(p);

    // 【说书人那一格】（用户 2026-09-21 报「生死无常面板点不动」的根因）：
    //   麻脸巫婆的「生死无常」这类面板开在**玩家 1** 身上，他在魔典上没有身份（r = -1）----
    //   原来这里直接 return，于是槽位文字永远不刷新：说书人点座位看着像没反应。
    //   现在 p == g_teller 放行（标题留给调用方自己写，别覆盖）。
    if (r < 0 || r > 163) {
        if (g_who[p] != g_teller) {
            return;
        }
    }
    else {
        // 限次角色确认发动后不给取消；理发师交换仍可在开始前放弃。
        if (g_pedantActing[p]) {
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
        }
        else if (!BOTC_NightLimitRole(r) && p == g_barberFrom) {
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
        }
        else {
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
        }
        if (g_pedantActing[p]) {
            libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("选择一名玩家"), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText(BOTC_SkillPickTextFor(p)), PlayerGroupSingle(g_who[p]));
        }
    }
    // 一名玩家 + 一个角色：左侧目标、右侧角色按钮、右下确认。
    if (BOTC_ComboRole(r)) {
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), false);
        libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("选择一名玩家和一个角色"), PlayerGroupSingle(g_who[p]));
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT1[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：") + BOTC_PlayerNameText(g_skillT1[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillRoleSel[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("选择角色：" + g_roleName[g_skillRoleSel[p] - 1]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("选择角色"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
        DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
        if (r == 150 && g_nightNum == 2) {
            DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 144);
            DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
            DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
            libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("不发动"), PlayerGroupSingle(g_who[p]));
        }
        libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("确认"), PlayerGroupSingle(g_who[p]));
        return;
    }
    // 【生死无常】（用户 2026-09-21）：这块面板自己写着「【取消】= 今晚不杀」，所以照旧给取消键
    if (g_who[p] == g_teller && g_hagKill) {
        DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_teller), true);
    }
    // 前置「是否发动技能」会隐藏全部目标槽；进入真正技能面板时必须把目标1恢复显示。
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), true);
    if (g_skillT1[p] > 0) {
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：") + BOTC_PlayerNameText(g_skillT1[p]), PlayerGroupSingle(g_who[p]));
    }
    else {
        libNtve_gf_SetDialogItemText(g_skillSlotA[p], StringToText("目标1：未选"), PlayerGroupSingle(g_who[p]));
    }
    // ■ 珀（46）的「攻击三次」：三个目标（1/2 横排 + 3 在下面中间）---- 用户 2026-09-20
    if (BOTC_TargetsOf(p) >= 3) {
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 41);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 41);
        DialogControlSetPosition(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 144, 99);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT2[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：") + BOTC_PlayerNameText(g_skillT2[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        }
        if (g_skillT3[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotC[p], StringToText("目标3：") + BOTC_PlayerNameText(g_skillT3[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotC[p], StringToText("目标3：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 169);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 169);
        // 【攻击三次（珀）】那一夜必须选满 3 个目标：连【不选】都不给（用户 2026-09-20）
        DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
        return;
    }
    // 不是三目标：第三个槽收起来（藏到画面外）
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
    // 珀的「不发动」已经移到唤醒后的前置询问，目标面板里不再显示「不选」。
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);
    if (BOTC_TargetsOf(p) >= 2) {      // 理发师交换时恶魔也要选两个目标（用户 2026-09-21）
        // 占卜师：两个目标槽并排摆
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 54);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), true);
        if (g_skillT2[p] > 0) {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：") + BOTC_PlayerNameText(g_skillT2[p]), PlayerGroupSingle(g_who[p]));
        }
        else {
            libNtve_gf_SetDialogItemText(g_skillSlotB[p], StringToText("目标2：未选"), PlayerGroupSingle(g_who[p]));
        }
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 27, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 261, 144);
    }
    else {
        // 其它夜间角色（僧侣 / 守鸦人 / 投毒者 / 管家 / 小恶魔）：只要一个目标，槽位居中、第二个槽收起来
        DialogControlSetPosition(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 144, 54);
        DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
        DialogControlSetPosition(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 3000, 3000);   // 兜底：藏到画面外
        DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
        DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    }
}

bool BOTC_SelfForbidden (int r) {
    return (r == 7 || r == 13 || r == 24 || r == 48 || r == 55 || r == 148 || r == 156);
}

// 【恶魔不能取消自己的目标】（用户 2026-11-04）：单选刀人的恶魔点中目标后，再点同一个人不会取消。
//   例外：小怪宝(112) / 军团(94) / 牙噶巴卜(133) 由说书人决定死亡；饕餮(154) 是多选面板需要点掉重选。
bool BOTC_DemonTargetLocked (int p) {
    int r;
    // 【珀 / 限次技能的是否发动面板】（用户 2026-11-07）：这时还没进入目标选择，
    // 【否】必须交给 BOTC_PoAskAnswer / BOTC_LimitedDecline，不能被“恶魔目标不可取消”提前拦截。
    if (g_poAsk[p] || g_limitedAsk[p]) {
        return false;
    }
    r = BOTC_ActRoleOf(p);
    if (r < 0 || BOTC_RoleTeam(r) != 3) {
        return false;
    }
    if (r == 94 || r == 112 || r == 133 || r == 150 || r == 154) {
        return false;
    }
    return (BOTC_TargetsOf(p) == 1);
}

void BOTC_SkillPickSeat (int p, int q) {
    int need;
    if (!g_skillPicking[p]) {
        return;
    }
    if (g_choiceOrigOn && g_choiceOrigBy == p) {
        g_choiceOrigOn = false;
        g_choiceOrigBy = 0;
    }
    g_choiceSaid[p] = false;
    if (q < 2 || q > 13) {
        return;
    }
    // 【小怪宝 / 造谣者 / 赏金猎人】说书人那一格用技能面板选单目标（用户 2026-11-10）：
    //   只能点存活玩家；赏金猎人还只能点善良阵营。
    if (g_mdAsk && p == 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q)) {
            BOTC_Notice(g_teller, "只能选择仍然存活的玩家。");
            return;
        }
        if (g_mdRole == 90 && BOTC_SeatAlign(q) != 0) {
            BOTC_Notice(g_teller, "赏金猎人只能把善良阵营的玩家转为邪恶。");
            return;
        }
    }
    if (BOTC_ActRoleOf(p) == 154) {
        BOTC_TaotieToggle(g_who[p], q);
        return;
    }
    if (BOTC_TargetMustBeLiving(p) && !BOTC_TargetIsLiving(q)) {
        BOTC_Notice(g_who[p], "目标已死亡，请重新选择。");
        return;
    }
    if (p == 1 && g_boffinRecipientPick) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
            BOTC_Notice(g_teller, "科学怪人能力只能交给一名存活的恶魔。");
            return;
        }
    }
    if (g_ojoAskSt && p == 1 && !g_ojoAllow[q]) {
        BOTC_Notice(g_teller, "这个座位不在奥赫这次可选的范围内。");
        return;
    }
    // 【理发师 × 落难少女】（用户 2026-11-03）：只能在这两名候选里指定谁当落难少女
    if (p == 1 && g_damselAsk == 2 && q != g_damselAskA && q != g_damselAskB) {
        BOTC_Notice(g_teller, "理发师的交换只能在这两名玩家之间选择落难少女。");
        return;
    }

    if (p == q) {
        if (BOTC_SelfForbidden(BOTC_ActRoleOf(p))) {
            BOTC_Notice(g_who[p], "这个角色的技能表写了「除你以外」，不能选自己。");
            return;
        }
    }
    need = BOTC_TargetsOf(p);
    if (g_skillT1[p] == q) {
        if (BOTC_DemonTargetLocked(p)) {
            BOTC_Notice(g_who[p], "恶魔必须选择目标，不能取消。");
            return;
        }
        g_skillT1[p] = 0;
    }
    else {
        if (g_skillT2[p] == q) {
            if (BOTC_DemonTargetLocked(p)) {
                BOTC_Notice(g_who[p], "恶魔必须选择目标，不能取消。");
                return;
            }
            g_skillT2[p] = 0;
        }
        else {
            if (g_skillT3[p] == q) {
                if (BOTC_DemonTargetLocked(p)) {
                    BOTC_Notice(g_who[p], "恶魔必须选择目标，不能取消。");
                    return;
                }
                g_skillT3[p] = 0;
            }
            else {
                if (g_skillT1[p] == 0) {
                    g_skillT1[p] = q;
                }
                else {
                    if (need >= 2 && g_skillT2[p] == 0) {
                        g_skillT2[p] = q;
                    }
                    else {
                        if (need >= 3 && g_skillT3[p] == 0) {
                            g_skillT3[p] = q;
                        }
                        else {
                            g_skillT1[p] = q;
                        }
                    }
                }
            }
        }
    }
    BOTC_SkillRender(p);
}

int BOTC_PickBoardGood () {
    int i;
    int r;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        // 【无神论者局 · 允许重复】（用户 2026-11-12）：无神论者清邪恶时可以发重复的善良角色；
        //   无神论者本人和带全局状态的唯一角色不参与兜底替换。
        if (BOTC_DealRoleSingleton(r)) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 0 && (g_athDeal || !BOTC_RoleInPlay(r))) {
            return r;
        }
    }
    return 0;
}

void BOTC_RangerOpen (int p, int target) {
    int q;
    if (p < 1 || p > 13 || target < 2 || target > 13) {
        return;
    }
    // 【给说书人弹，不是给巡山人自己弹】（用户 2026-10-04 报）：
    //   选「落难少女变成哪个镇民」是**说书人**的事（跟他平时给玩家改身份一样），
    //   所以面板固定开在玩家 1 身上；p 仍然是巡山人本人（g_rangerBy 记他，日志也写他）。
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);   // 巡山人自己那份技能面板收掉
    g_skillPicking[p] = false;
    g_rangerWho = target;
    g_rangerBy = p;
    g_pickMode[g_teller] = 18;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 0;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 0) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_RangerPick (int role) {
    int t;
    t = g_rangerWho;
    if (t < 2 || t > 13 || role < 0 || role > 163) {
        return;
    }
    BOTC_SetSeatRole(g_teller, t, role);
    BOTC_SetSeatRole(g_who[t], t, role);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, role);
    BOTC_PmStore(g_teller, "【巡山人】落难少女（" + BOTC_NameStr(t) + "）变成了 " + g_roleName[role] + "。");
}

//--------------------------------------------------------------------------------------------------
// 【悟道者（118）】（用户 2026-10-16）
//   ① 首夜：说书人点他「以为」的那张外来者卡（**认知覆盖类不能选**：酒鬼 14 / 疯子 38）----
//      点完脚本把这一格（说书人那份 + 他自己那份）都写成那张外来者卡，并打「是悟道者」140（真身读回 118）。
//   ② 被**邪恶玩家**的能力选择 / 影响 → 他立刻变成一个「不在场的镇民」（说书人从身份网格里点，参考巡山人）。
//      不做白天 / 晚上的区分（用户 2026-10-16）：点完当场就私聊告诉他。
//--------------------------------------------------------------------------------------------------
void BOTC_WudOutsiderOpen (int seat) {
    int q;
    if (seat < 2 || seat > 13) {
        return;
    }
    g_wudSeat = seat;
    g_pickMode[g_teller] = 26;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 1;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 1) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
            continue;
        }
        if (g_gridSlot[q] == 14 || g_gridSlot[q] == 38) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【悟道者】" + BOTC_NameStr(seat) + "：他「以为」自己是哪一个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_WudOutsiderPick (int role) {
    int t;
    t = g_wudSeat;
    if (t < 2 || t > 13 || role < 0 || role > 163) {
        return;
    }
    BOTC_SetSeatRole(g_teller, t, role);
    BOTC_SetSeatRole(g_who[t], t, role);
    g_tokOn[(((g_teller * 14) + t) * 256) + 140] = true;
    // 【诺-达鲺 / 常驻标记重算】（用户 2026-11-12）：SetSeatRole 里按「以为的外来者」先跑过一次
    //   常驻层，那时 140 还没写，诺-达鲺的毒会被挪到别人身上；补上 140、真身读回 118 后必须再算一次。
    if (g_started) {
        BOTC_SeatStateSync();
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(t) + " 以为自己是「" + g_roleName[role] + "」。");
    // 选完清掉「正在配置」的座位，否则 BOTC_WudTryTrigger 的「同一次多段效果只开一次」会一直把这个座位挡掉。
    g_wudSeat = 0;
    g_wudBy = 0;
    // 【无神论者局 · 多个悟道者】（用户 2026-11-12）：一次只弹一个，点完接着问下一个还没配置的悟道者。
    BOTC_WudSetupCheck();
}

// 【悟道者判定「邪恶玩家」】（用户 2026-10-19）：不能只看真身是不是爪牙 / 恶魔。
//   统一按「这个人当前的实际阵营」判：
//     · BOTC_SeatAlign 会读角色自带阵营 + 善良(14) / 邪恶(15) token；初始爪牙 / 恶魔、提线木偶、逆臣转变等都在这里。
//     · 半兽人的「失足」127 按互动登记当作邪恶（它不一定改真身阵营）。
//     · 灵言师手动使用的「转为邪恶」103 也按邪恶算。
bool BOTC_WudPickerEvil (int q) {
    if (q < 1 || q > 13) {      // 允许 1：说书人用 -t 测试时也能认真身 / 阵营 token
        return false;
    }
    if (BOTC_SeatAlign(q) == 1) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 127)) {
        return true;
    }
    if (BOTC_ProtectTokOn(q, 103)) {
        return true;
    }
    return false;
}

// 【悟道者 · 统一影响入口】
//   与和尚一样覆盖“选择或影响”，但悟道者只改变自身角色，不阻止原本的邪恶效果。
//   调用点必须在具体效果开始生效之前；本次完成后，原能力仍继续结算。
bool BOTC_WudTryTrigger (int target, int source) {
    if (target < 2 || target > 13 || source < 1 || source > 13) {
        return false;
    }
    if (!g_seatOn[target] || BOTC_SeatDead(target)) {
        return false;
    }
    if (!BOTC_ProtectTokOn(target, 140)) {
        return false;
    }
    if (!BOTC_AbilityWorks(target, 118)) {
        return false;
    }
    if (!BOTC_WudPickerEvil(source)) {
        return false;
    }
    if (g_wudSeat == target) {
        return false;                      // 同一次多段效果只开一次角色选择
    }
    BOTC_WudChangeOpen(target, source);
    BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(target) + " 被 " + BOTC_NameStr(source) + " 的邪恶能力选择或影响 → 先选择他的新镇民角色；原效果仍会继续结算。");
    return true;
}

void BOTC_WudCheckSelection (int source) {
    if (!BOTC_WudPickerEvil(source)) {
        return;
    }
    if (BOTC_WudTryTrigger(g_skillT1[source], source)) {
        return;
    }
    if (BOTC_WudTryTrigger(g_skillT2[source], source)) {
        return;
    }
    BOTC_WudTryTrigger(g_skillT3[source], source);
}

void BOTC_WudChangeOpen (int seat, int by) {
    int q;
    if (seat < 2 || seat > 13) {
        return;
    }
    g_wudSeat = seat;
    g_wudBy = by;
    g_pickMode[g_teller] = 27;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 0;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 0) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【悟道者】" + BOTC_NameStr(seat) + " 被 " + BOTC_NameStr(by) + "（邪恶）的能力碰了 → 他立刻变成一名不在场的镇民，你挑一个："), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_WudChangePick (int role) {
    int t;
    t = g_wudSeat;
    if (t < 2 || t > 13 || role < 0 || role > 163) {
        return;
    }
    // 【相克：悟道者 × 数学家】能力造成角色变化，属于数学家会记录的一次异常。
    BOTC_MalfNote(t, "悟道者被邪恶能力影响后改变角色");
    BOTC_SetSeatRole(g_teller, t, role);
    BOTC_SetSeatRole(g_who[t], t, role);
    g_tokOn[(((g_teller * 14) + t) * 256) + 140] = false;
    // 【相克：悟道者 × 村夫】变成村夫后统一走 BOTC_VillageSync()：
    //   真实身份计数、移走旧标记，原持有者已离场就换到另一名村夫（用户 2026-11-11）。
    if (role == 105) {
        BOTC_VillageSync();
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, role);
    BOTC_PmStore(g_teller, "【悟道者】" + BOTC_NameStr(t) + " 变成了 " + g_roleName[role] + "（已撤掉「是悟道者」）。");
    g_wudSeat = 0;
    g_wudBy = 0;
}

// 首夜：如果本局发了悟道者，让他挑「以为的外来者」（只挑一次）
void BOTC_WudSetupCheck () {
    int q;
    int r;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) { continue; }
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r != 118) { continue; }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) { continue; }
        BOTC_WudOutsiderOpen(q);
        return;
    }
}

//==================================================================================================
// 【旧《赎罪小镇》保留角色实现】
//==================================================================================================
// 鸩（124）：每局一次，选择一个镇民角色；该角色若真在场，则醉酒并在夜里死亡。
void BOTC_DrossOpen (int p) {
    int q;
    if (p < 2 || p > 13) {
        return;
    }
    if (!BOTC_HasAbility(p, 124)) {
        return;
    }
    if (BOTC_ProtectTokOn(p, 145)) {
        BOTC_PmStore(g_teller, "【鸩】这一局的一次性能力已经用过了。");
        return;
    }
    g_pickMode[g_teller] = 28;
    g_pickWho[g_teller] = p;
    g_pickTeam = 0;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_RoleTeam(g_gridSlot[q]) != 0) {
            DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
            DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_DrossPick (int role) {
    int p;
    int t;
    p = g_pickWho[g_teller];
    g_pickMode[g_teller] = 0;
    g_pickWho[g_teller] = 0;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
    if (p < 2 || p > 13 || role < 0 || role > 163) {
        return;
    }
    if (BOTC_RoleTeam(role) != 0) {
        BOTC_Notice(g_teller, "鸩只能选择一个镇民角色。");
        return;
    }
    g_tokOn[(((g_teller * 14) + p) * 256) + 145] = true;
    BOTC_GrimRender(g_teller);
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶：这次能力失效，但一次性机会已消耗。");
        return;
    }
    t = BOTC_SeatOfRole(role);
    if (t < 2 || BOTC_SeatDead(t)) {
        BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」，但他不在场（或已经死亡），无事发生。");
        return;
    }
    if (BOTC_HasAbility(t, 86)) {
        BOTC_PmStore(g_teller, "【鸩×罂粟种植者】" + BOTC_NameStr(p) + " 选择了罂粟种植者 " + BOTC_NameStr(t) + "：罂粟种植者不会因为鸩的能力中毒。");
        return;
    }
    g_tokOn[(((g_teller * 14) + t) * 256) + 144] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【鸩】" + BOTC_NameStr(p) + " 选中在场的「" + g_roleName[role] + "」：" + BOTC_NameStr(t) + " 醉酒并死亡。");
    BOTC_MarkDeathQuietSrc(t, 1, 0, 124);
}


// 赶尸人（126）：找出离他最近的两名存活镇民；这两人各自的第一次死亡会被挡下。
bool BOTC_CorpseFirstDeath (int q) {
    int i;
    int c;
    int d;
    int best1;
    int best2;
    int s1;
    int s2;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    // 画皮的“下一次死亡”优先于赶尸人的旧式首次免死；否则两者同桌时画皮永远等不到拦截点。
    if (g_liveCorpse[q] || g_skinTargetBy[q] >= 2) {
        return false;
    }
    if (BOTC_SeatDead(q)) {
        return false;
    }
    if (g_corpseSpent[q]) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 148]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 148] = false;
        g_corpseSpent[q] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【赶尸人】" + BOTC_NameStr(q) + " 的首次死亡保护已经用掉，这一次会正常死亡。");
        return false;
    }
    c = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatImpaired(i)) {
            continue;
        }
        if (BOTC_SeatDead(i) && !BOTC_KeepsAbilityAlive(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 126)) {
            c = i;
        }
    }
    if (c < 2) {
        return false;
    }
    best1 = 999;
    best2 = 999;
    s1 = 0;
    s2 = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == c) {
            continue;
        }
        if (BOTC_SeatTeam(i) != 0) {
            continue;
        }
        d = BOTC_RingDist(c, i);
        if (d < best1) {
            best2 = best1;
            s2 = s1;
            best1 = d;
            s1 = i;
        }
        else {
            if (d < best2) {
                best2 = d;
                s2 = i;
            }
        }
    }
    if (q != s1 && q != s2) {
        return false;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 148] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【赶尸人】" + BOTC_NameStr(q) + " 是赶尸人邻近的镇民，首次死亡被当作仍然存活（已打「活尸」）。");
    return true;
}

//==================================================================================================
// 【活尸（通用） / 画皮（155）】
//   活尸的“真实死亡”和“广场公开死亡”分开：真实死亡会立即影响胜负，但广场可以暂时仍显示存活。
//   画皮的下一次死亡拦截发生在统一死亡入口，先经过其他保护 / 无敌判定，避免绕过既有免死。
//==================================================================================================
bool BOTC_PhysicallyDead (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (g_liveCorpse[q]) {
        return true;
    }
    return BOTC_SeatDead(q);
}

// 活尸在来源有效且尚未公开死亡时，参与能力互动仍按存活处理。
bool BOTC_LivingCorpseCountsAlive (int q) {
    int p;
    if (q < 2 || q > 13 || !g_liveCorpse[q] || g_deadShown[q] || g_liveCorpseLost[q]) {
        return false;
    }
    p = g_liveCorpseFrom[q];
    return (p >= 1 && p <= 13 && (p == 1 || g_seatOn[p]) && BOTC_AbilityWorks(p, 155));
}

bool BOTC_SkinCanPrevent (int p) {
    if (p < 1 || p > 13 || (p >= 2 && !g_seatOn[p]) || g_skinChainBroken[p]) {
        return false;
    }
    if (!BOTC_HasAbility(p, 155)) {
        return false;
    }
    return (!BOTC_SeatDead(p) && BOTC_AbilityWorks(p, 155));
}

// 清掉画皮当前这次“选中 → 下一次死亡”的关系。活尸状态本身另由 Revive / Finalize 处理。
void BOTC_SkinLinkClear (int p, bool broken) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    q = g_skinTarget[p];
    if (q >= 2 && q <= 13) {
        g_skinTargetBy[q] = 0;
        g_tokOn[(((g_teller * 14) + q) * 256) + 193] = false;
    }
    g_skinTarget[p] = 0;
    g_skinChainBroken[p] = broken;
}

// 复活活尸：撤销秘密死亡；一局一次能力由统一死亡钩子在实际处理后刷新。
void BOTC_LivingCorpseRevive (int q) {
    int t;
    bool wasZombuulFake;
    if (q < 2 || q > 13) {
        return;
    }
    wasZombuulFake = g_zombFake[q];
    if (!g_liveCorpse[q] && !wasZombuulFake && !BOTC_PublicDead(q) && !BOTC_SeatDead(q)) {
        return;
    }
    g_liveCorpse[q] = false;
    g_liveCorpseFrom[q] = 0;
    g_liveCorpseLost[q] = false;
    g_deathLearned[q] = false;
    g_deadShown[q] = false;
    g_deadPending[q] = false;
    g_deadKind[q] = 0;
    g_deadByDemon[q] = 0;
    g_deadType[q] = -1;
    g_deadNightNum[q] = 0;
    g_deadClaimDay[q] = -1;
    g_deadDay[q] = 0;
    g_tokOn[(((g_teller * 14) + q) * 256) + 192] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 193] = false;
    // 画皮真正复活了已经显示死亡的僵怖：恢复一次「首次不会死」，
    // 让他重新拥有“假死 + 真实死亡”两条命。
    if (wasZombuulFake) {
        g_zombFake[q] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 58] = false;
        BOTC_PmStore(g_teller, "【画皮 × 僵怖】已复活假死中的 " + BOTC_NameStr(q) + "，并恢复一次僵怖假死能力 → 他现在重新拥有两条命。");
        BOTC_PmStore(g_teller, "【画皮 × 僵怖】本次属于真正复活；后续第一次死亡会再次假死，第二次死亡才真正死亡。");
    }
    for (t = 0; t < g_deathN; t += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[t]] = false;
    }
    BOTC_GrimRender(g_teller);
    BOTC_DeclareRender();
}

// 活尸最终公开死亡。真实死亡此前已经发生，因此这里只结算“得知死亡”，不重跑死亡时能力。
void BOTC_LivingCorpseRevealNow (int q) {
    int ob;
    if (q < 2 || q > 13 || !g_liveCorpse[q] || g_deadShown[q]) {
        return;
    }
    g_liveCorpseLost[q] = true;
    g_deadPending[q] = false;
    g_deadShown[q] = true;
    if (!g_isNight) {
        g_deadClaimDay[q] = g_dayNum;      // 活尸公开死亡：只在当天白天允许死后声称（月之子 / 呆瓜）
    }
    BOTC_PlaySfx("Marine_Death");
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
    BOTC_PmStore(g_teller, "【活尸】" + BOTC_NameStr(q) + " 的真实死亡已经公开。这次的死因沿用首次死亡，不重复触发死亡时能力。");
    BOTC_DeclareRender();
    if (!g_deathLearned[q]) {
        g_deathLearned[q] = true;
        BOTC_MoonChildCheck(q);
        BOTC_KlutzCheck(q);
    }
}

// 来源失效：白天立即公开；夜晚排入天亮死亡队列。已经排入后不再因来源恢复而撤销。
void BOTC_LivingCorpseFinalize (int q) {
    if (q < 2 || q > 13 || !g_liveCorpse[q] || g_deadShown[q] || g_liveCorpseLost[q]) {
        return;
    }
    g_liveCorpseLost[q] = true;
    if (g_isNight) {
        g_deadPending[q] = true;
        BOTC_PmStore(g_teller, "【活尸】" + BOTC_NameStr(q) + " 的来源已经失效；将在天亮公开他的死亡。");
    }
    else {
        BOTC_LivingCorpseRevealNow(q);
    }
}

// 画皮在来源失效时检查所有关联。中毒 / 醉酒只影响仍处于活尸状态的目标；
// 尚未变成活尸的“选择”关系继续保留，等目标下一次真实死亡时再判定。
void BOTC_SkinSourceCheck () {
    int p;
    int q;
    string why;
    for (p = 1; p <= 13; p += 1) {
        q = g_skinTarget[p];
        if (q < 2 || q > 13) {
            continue;
        }
        why = "";
        if ((p >= 2 && !g_seatOn[p]) || BOTC_SeatDead(p) || !BOTC_HasAbility(p, 155)) {
            why = "画皮已经死亡或离场";
        }
        else {
            if (g_liveCorpse[q] && !g_deadShown[q] && !BOTC_SkinCanPrevent(p)) {
                why = "画皮已经无法阻止目标的下一次死亡";
            }
        }
        if (why == "") {
            continue;
        }
        if (g_liveCorpse[q] && !g_deadShown[q]) {
            BOTC_LivingCorpseFinalize(q);
        }
        BOTC_SkinLinkClear(p, true);
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(p) + " 的关联中断：" + why + "；本次能力不会重获。");
    }
}

void BOTC_SkinSourceGone (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    q = g_skinTarget[p];
    if (g_liveCorpse[q] && !g_deadShown[q]) {
        BOTC_LivingCorpseFinalize(q);
    }
    BOTC_SkinLinkClear(p, true);
    BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(p) + " 离场：选中关系终止，不会重获能力。");
    BOTC_GrimRender(g_teller);
}

// 统一死亡拦截。返回 0 = 与画皮无关；1 = 本次死亡已经被画皮完整处理；2 = 画皮失败并继续正常死亡。
int BOTC_SkinDeathHook (int q) {
    int p;
    bool wasLivingCorpse;
    bool wasVisibleDead;
    if (q < 2 || q > 13) {
        return 0;
    }
    p = g_skinTargetBy[q];
    if (p < 1 || p > 13) {
        return 0;
    }
    if (BOTC_SkinCanPrevent(p)) {
        wasLivingCorpse = g_liveCorpse[q];
        wasVisibleDead = (BOTC_PublicDead(q) || g_zombFake[q]);
        if (BOTC_PublicDead(q) || g_zombFake[q]) {
            BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 带有选择标记且广场显示为死亡 → 画皮 " + BOTC_NameStr(p) + " 尝试复活他。");
        }
        else {
            BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 即将死亡 → 画皮 " + BOTC_NameStr(p) + " 阻止了这次死亡。");
        }
        BOTC_LivingCorpseRevive(q);
        if (wasLivingCorpse || wasVisibleDead) {
            BOTC_RestoreOneShot(q);    // 只有真正从活尸 / 已显示死亡状态复活时才刷新
        }
        BOTC_SkinLinkClear(p, false);
        BOTC_PmInfo(g_who[p], "【画皮】你阻止了 " + BOTC_NameStr(q) + " 的死亡，重获能力。");
        if (g_isNight) {
            g_insertWake[p] = true;
            g_autoWoke[p] = false;
            g_testWoke[p] = false;
            BOTC_PmStore(g_teller, "【画皮】已重获能力，将在今晚补一次攻击行动。");
        }
        else {
            BOTC_PmStore(g_teller, "【画皮】已重获能力，下一晚可以再次选择目标。");
        }
        BOTC_GrimRender(g_teller);
        return 1;
    }
    BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 下一次死亡时，画皮 " + BOTC_NameStr(p) + " 因中毒、醉酒、死亡或失去能力而无法阻止；不会重获能力。");
    BOTC_SkinLinkClear(p, true);
    if (g_liveCorpse[q]) {
        BOTC_LivingCorpseFinalize(q);
        return 1;
    }
    return 2;
}

// 画皮首次攻击和重获能力后的攻击。攻击必须经过现有死亡阻断层，才能正确处理无敌 / 免死。
void BOTC_SkinChoose (int p, int q) {
    string blk;
    int old;
    if (p < 1 || p > 13 || q < 2 || q > 13 || (p >= 2 && !g_seatOn[p]) || !g_seatOn[q]) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        BOTC_Notice(g_who[p], "要选择一名存活玩家。");
        return;
    }
    old = g_skinTarget[p];
    if (old >= 2 && old <= 13) {
        g_tokOn[(((g_teller * 14) + old) * 256) + 193] = false;
    }
    g_skinTarget[p] = q;
    g_skinTargetBy[q] = p;
    g_skinChainBroken[p] = false;
    g_skinActionNight[p] = g_nightNum;
    g_tokOn[(((g_teller * 14) + q) * 256) + 193] = true;
    BOTC_GrimRender(g_teller);
    if (!BOTC_AbilityWorks(p, 155)) {
        BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(p) + " 中毒 / 醉酒 / 失去能力：仍记录选中的 " + BOTC_NameStr(q) + "，但这次攻击不形成活尸。");
        return;
    }
    if (g_liveCorpse[q]) {
        BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 已经是活尸；画皮只记录其为下一次死亡目标。");
        return;
    }
    blk = BOTC_DeathBlocker(q, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【画皮】攻击 " + BOTC_NameStr(q) + " 被【" + blk + "】挡住 → 没有形成活尸；选中关系保留。");
        return;
    }
    // 【画皮 × 僵怖 · 互相抵消】：僵怖的首次死亡能力会被触发并消耗，
    // 但这里不调用假死外观，因此他不会死亡，也不会进入「假死」或「活尸」状态。
    if (BOTC_HasAbility(q, 43) && BOTC_AbilityWorks(q, 43) && !g_zombUsed[q]) {
        g_zombUsed[q] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【画皮 × 僵怖】" + BOTC_NameStr(q) + " 的首次死亡能力与画皮攻击互相抵消：他不死亡，也不进入假死或活尸；选择标记保留。");
        BOTC_PmInfo(g_who[q], "【僵怖】你的首次死亡能力已触发并与画皮攻击抵消；你没有死亡。");
        BOTC_ScarletAfterZombuul();
        return;
    }
    g_liveCorpse[q] = true;
    g_liveCorpseFrom[q] = p;
    g_liveCorpseLost[q] = false;
    g_deathLearned[q] = false;
    g_deadKind[q] = 1;
    g_deadByDemon[q] = 0;
    g_deadType[q] = -1;
    g_deadNightNum[q] = g_nightNum;
    g_deadDay[q] = 0;
    g_deadPending[q] = false;
    g_deadShown[q] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 193] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 192] = true;
    // 活尸已经真实离场，自身能力带来的常驻 token / 记录按通用离场规则清理。
    BOTC_SourceGoneCleanup(q, true);
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 进入活尸：真实死亡，广场显示存活；不会在天亮公布。");
    BOTC_PmStore(g_teller, "【画皮】" + BOTC_NameStr(q) + " 下一次即将死亡时，将复活并让画皮重获能力。");
    BOTC_CheckWin();
}

//==================================================================================================
// 【使节（157）】每晚最多一次；其他玩家使用能力选中邪恶玩家时，由说书人决定是否改选使节。
//==================================================================================================
int BOTC_EnvoySeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_HasAbility(q, 157) && !BOTC_SeatImpaired(q)) {
            return q;                      // 能力即使使节已经死亡也仍然存在
        }
    }
    return 0;
}

bool BOTC_EnvoyMaybePrompt (int p) {
    int a;
    int b;
    int c;
    int envoy;
    int slot;
    string names;
    if (!g_isNight || g_gameOver || g_envoyUsed || g_envoyPrompt) {
        return false;
    }
    if (p < 1 || p > 13 || (p == 1 && !g_testSelfOn)) {
        return false;
    }
    // 【痢蛭 × 使节】首夜 / 中途补选的宿主不能被改指。
    if (BOTC_ActRoleOf(p) == 100 && BOTC_LleechHostMode(p)) {
        return false;
    }
    if (BOTC_IsLunatic(p)) {
        return false;                      // 疯子的假能力不触发使节
    }
    envoy = BOTC_EnvoySeat();
    if (envoy < 2) {
        return false;
    }
    a = g_skillT1[p];
    b = g_skillT2[p];
    c = g_skillT3[p];
    if (a == envoy || b == envoy || c == envoy) {
        return false;                      // 已经选中使节，不再重复询问
    }
    slot = 0;
    if (a >= 2 && a <= 13 && BOTC_SeatAlign(a) == 1) {
        slot = 1;
    }
    else if (b >= 2 && b <= 13 && BOTC_SeatAlign(b) == 1) {
        slot = 2;
    }
    else if (c >= 2 && c <= 13 && BOTC_SeatAlign(c) == 1) {
        slot = 3;
    }
    if (slot == 0) {
        return false;
    }
    if (!g_choiceOrigOn || g_choiceOrigBy != p) {
        g_choiceOrigOn = true;
        g_choiceOrigBy = p;
        g_choiceOrigT1 = g_skillT1[p];
        g_choiceOrigT2 = g_skillT2[p];
        g_choiceOrigT3 = g_skillT3[p];
    }
    g_envoyBy = p;
    g_envoySeat = envoy;
    g_envoySlot = slot;
    g_envoyPrompt = true;
    names = "";
    if (a >= 2 && a <= 13) { names = BOTC_NameStr(a); }
    if (b >= 2 && b <= 13) {
        if (names != "") { names = names + "、"; }
        names = names + BOTC_NameStr(b);
    }
    if (c >= 2 && c <= 13) {
        if (names != "") { names = names + "、"; }
        names = names + BOTC_NameStr(c);
    }
    BOTC_PmStore(g_teller, "【使节】本次选择包含邪恶玩家（" + names + "）。请判定是否改为使节 " + BOTC_NameStr(envoy) + "。");
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    BOTC_ManInfoOpen(p, 811, "");
    return true;
}

void BOTC_EnvoyAnswer (bool changed) {
    int p;
    int seat;
    int slot;
    if (!g_envoyPrompt) {
        return;
    }
    p = g_envoyBy;
    seat = g_envoySeat;
    slot = g_envoySlot;
    g_envoyPrompt = false;
    g_redirectSkip = true;
    g_redirectBy = p;
    if (changed) {
        if (slot == 1) { g_skillT1[p] = seat; }
        if (slot == 2) { g_skillT2[p] = seat; }
        if (slot == 3) { g_skillT3[p] = seat; }
        g_envoyNight = g_nightNum;
        g_envoyUsed = true;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 194] = true;
        BOTC_PmStore(g_teller, "【使节】已触发：本次能力的一个邪恶目标已改为 " + BOTC_NameStr(seat) + "；今晚不再重复触发。");
    }
    else {
        BOTC_PmStore(g_teller, "【使节】本次未触发；今晚后续若仍有选择包含邪恶玩家，仍可再次判定。");
    }
    BOTC_GrimRender(g_teller);
    if (p >= 1 && p <= 13) {
        BOTC_SkillConfirm(p);
    }
}

void BOTC_EnvoyDawnClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 194] = false;
        g_choiceSaid[q] = false;
    }
    g_envoyNight = 0;
    g_envoyUsed = false;
    g_envoyPrompt = false;
    g_envoyBy = 0;
    g_envoySeat = 0;
    g_envoySlot = 0;
    g_redirectSkip = false;
    g_redirectBy = 0;
    g_halfPick = false;
    g_halfBy = 0;
    g_halfSlot = 0;
    g_halfOriginal = 0;
    g_choiceOrigOn = false;
    g_choiceOrigBy = 0;
    g_choiceOrigT1 = 0;
    g_choiceOrigT2 = 0;
    g_choiceOrigT3 = 0;
    BOTC_BrokerClear("天亮");
}

//==================================================================================================
// 【半仙（158）】夜间只转移“选中半仙”的那一个目标槽，由说书人指定另一名邪恶玩家。
//   候选只要「还在座位上 + 登记为邪恶」即可，**已经死亡的邪恶玩家同样可选**。
//==================================================================================================
int BOTC_HalfImmortalSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_AbilityWorks(q, 158)) {
            return q;
        }
    }
    return 0;
}

bool BOTC_HalfImmortalHasAlt (int p, int half, int slot) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatAlign(q) != 1 || q == half) {
            continue;
        }
        if (slot != 1 && g_skillT1[p] == q) { continue; }
        if (slot != 2 && g_skillT2[p] == q) { continue; }
        if (slot != 3 && g_skillT3[p] == q) { continue; }
        return true;
    }
    return false;
}

bool BOTC_HalfImmortalMaybePrompt (int p) {
    int half;
    int slot;
    int q;
    string names;
    if (!g_isNight || g_gameOver || g_halfPick || g_redirectSkip) {
        return false;
    }
    if (p < 2 || p > 13 || BOTC_IsLunatic(p)) {
        return false;
    }
    // 【痢蛭 × 半仙】首夜 / 中途补选的宿主不能被改指。
    if (BOTC_ActRoleOf(p) == 100 && BOTC_LleechHostMode(p)) {
        return false;
    }
    half = 0;
    slot = 0;
    if (g_skillT1[p] >= 2 && g_skillT1[p] <= 13 && g_skillT1[p] != p && BOTC_AbilityWorks(g_skillT1[p], 158) && BOTC_HalfImmortalHasAlt(p, g_skillT1[p], 1)) {
        half = g_skillT1[p];
        slot = 1;
    }
    else if (g_skillT2[p] >= 2 && g_skillT2[p] <= 13 && g_skillT2[p] != p && BOTC_AbilityWorks(g_skillT2[p], 158) && BOTC_HalfImmortalHasAlt(p, g_skillT2[p], 2)) {
        half = g_skillT2[p];
        slot = 2;
    }
    else if (g_skillT3[p] >= 2 && g_skillT3[p] <= 13 && g_skillT3[p] != p && BOTC_AbilityWorks(g_skillT3[p], 158) && BOTC_HalfImmortalHasAlt(p, g_skillT3[p], 3)) {
        half = g_skillT3[p];
        slot = 3;
    }
    if (slot == 0 || !BOTC_HalfImmortalHasAlt(p, half, slot)) {
        return false;
    }
    if (!g_choiceOrigOn || g_choiceOrigBy != p) {
        g_choiceOrigOn = true;
        g_choiceOrigBy = p;
        g_choiceOrigT1 = g_skillT1[p];
        g_choiceOrigT2 = g_skillT2[p];
        g_choiceOrigT3 = g_skillT3[p];
    }
    g_halfPick = true;
    g_halfBy = p;
    g_halfSlot = slot;
    g_halfOriginal = half;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    names = "";
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatAlign(q) != 1 || q == half) {
            continue;
        }
        if (slot != 1 && g_skillT1[p] == q) { continue; }
        if (slot != 2 && g_skillT2[p] == q) { continue; }
        if (slot != 3 && g_skillT3[p] == q) { continue; }
        if (StringLength(names) > 0) {
            names = names + "、";
        }
        names = names + BOTC_NameStr(q);
    }
    BOTC_ManInfoOpenSeats(p, "【半仙改选】输入一名邪恶玩家座位号作为新的目标（已死亡的邪恶玩家也可以）；候选：" + names, 12);
    g_miRole = 815;
    g_miKind = 0;
    DialogControlSetSize(g_miEdit, PlayerGroupSingle(g_teller), 240, 41);
    DialogControlSetPosition(g_miEdit, PlayerGroupSingle(g_teller), c_anchorTopLeft, 222, 83);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    BOTC_Notice(g_teller, "【半仙】" + BOTC_NameStr(p) + " 选择了半仙：请输入一名邪恶玩家作为新的选择目标。");
    BOTC_PmStore(g_teller, "【半仙】" + BOTC_NameStr(p) + " 的选择包含半仙 " + BOTC_NameStr(half) + "；请改指一名邪恶玩家（可含已死亡，候选：" + names + "）。原选择不得重复作为其他目标槽。");
    BOTC_GrimRender(g_teller);
    return true;
}

void BOTC_HalfImmortalApply (int p, int slot, int seat) {
    if (g_halfSlot == 1 && slot != 1 && g_skillT1[p] == seat) {
        BOTC_Notice(g_teller, "新的目标不能与这项能力的其他目标重复。");
        return;
    }
    if (g_halfSlot == 2 && slot != 2 && g_skillT2[p] == seat) {
        BOTC_Notice(g_teller, "新的目标不能与这项能力的其他目标重复。");
        return;
    }
    if (g_halfSlot == 3 && slot != 3 && g_skillT3[p] == seat) {
        BOTC_Notice(g_teller, "新的目标不能与这项能力的其他目标重复。");
        return;
    }
    if (!g_seatOn[seat] || BOTC_SeatAlign(seat) != 1 || seat == g_halfOriginal) {
        BOTC_Notice(g_teller, "半仙只能改为选择另一名邪恶玩家（已死亡的邪恶玩家也可以）。");
        return;
    }
    if (slot == 1) { g_skillT1[p] = seat; }
    if (slot == 2) { g_skillT2[p] = seat; }
    if (slot == 3) { g_skillT3[p] = seat; }
    g_halfPick = false;
    g_halfBy = 0;
    g_halfSlot = 0;
    g_halfOriginal = 0;
    g_miSeat = 0;
    g_miRole = -1;
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【半仙】已将 " + BOTC_NameStr(p) + " 的第 " + IntToString(slot) + " 个目标改为邪恶玩家 " + BOTC_NameStr(seat) + "。");
    BOTC_GrimRender(g_teller);
    if (BOTC_HalfImmortalMaybePrompt(p)) {
        return;
    }
    g_redirectSkip = true;
    g_redirectBy = p;
    BOTC_SkillConfirm(p);
}

//==================================================================================================
// 【掮客（159）】每晚选择两名存活玩家；同阵营时，本夜对这两人的选择彼此互换。
//==================================================================================================
void BOTC_BrokerClear (string why) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 195] = false;
    }
    g_brokerOn = false;
    g_brokerA = 0;
    g_brokerB = 0;
    g_brokerBy = 0;
    g_brokerAsk = false;
    g_brokerForced = false;
    g_brokerRedirectedBy = 0;
    BOTC_GrimRender(g_teller);
}

bool BOTC_BrokerActive () {
    if (!g_isNight || !g_brokerOn) {
        return false;
    }
    if (g_brokerA < 2 || g_brokerB < 2 || g_brokerBy < 1) {
        return false;
    }
    if (!g_seatOn[g_brokerA] || !g_seatOn[g_brokerB] || (g_brokerBy >= 2 && !g_seatOn[g_brokerBy])) {
        return false;
    }
    if (!BOTC_AbilityWorks(g_brokerBy, 159)) {
        return false;
    }
    if (g_brokerForced) {
        return true;
    }
    return (BOTC_SeatAlign(g_brokerA) == BOTC_SeatAlign(g_brokerB));
}

void BOTC_BrokerActivate (int p, int a, int b, bool forced) {
    g_brokerOn = true;
    g_brokerA = a;
    g_brokerB = b;
    g_brokerBy = p;
    g_brokerAsk = false;
    g_brokerForced = forced;
    g_tokOn[(((g_teller * 14) + a) * 256) + 195] = true;
    g_tokOn[(((g_teller * 14) + b) * 256) + 195] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【掮客】" + BOTC_NameStr(p) + " 选择 " + BOTC_NameStr(a) + " 与 " + BOTC_NameStr(b) + " → 熟客生效：本夜选择其中一人会改为另一人。");
}

void BOTC_BrokerSelect (int p, int a, int b) {
    string extra;
    int ra;
    int rb;
    if (p < 1 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    BOTC_BrokerClear("重新选择");
    if (!g_seatOn[a] || !g_seatOn[b] || BOTC_SeatDead(a) || BOTC_SeatDead(b)) {
        BOTC_PmStore(g_teller, "【掮客】目标不是两名存活玩家，本次不生效。");
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【掮客】" + BOTC_NameStr(p) + " 中毒、醉酒或能力失效，本次不放置熟客。");
        return;
    }
    ra = BOTC_SeatTrueRole(a);
    rb = BOTC_SeatTrueRole(b);
    if (ra < 0 || ra > 163 || rb < 0 || rb > 163) {
        BOTC_PmStore(g_teller, "【掮客】目标身份尚未确定，本次不生效。");
        return;
    }
    extra = BOTC_NameStr(a) + "、" + BOTC_NameStr(b);
    if ((g_roleTag[ra] & 8) != 0 || (g_roleTag[rb] & 8) != 0) {
        g_brokerAsk = true;
        g_brokerBy = p;
        g_brokerA = a;
        g_brokerB = b;
        BOTC_PmStore(g_teller, "【掮客】本次选择包含陌客 / 间谍等干扰身份：" + extra + "。请判定是否发动。");
        BOTC_ManInfoOpen(p, 812, extra);
        return;
    }
    if (BOTC_SeatAlign(a) == BOTC_SeatAlign(b)) {
        BOTC_BrokerActivate(p, a, b, false);
    }
    else {
        BOTC_PmStore(g_teller, "【掮客】" + extra + " 阵营不同，本夜不形成熟客。");
    }
}

void BOTC_BrokerAnswer (bool yes) {
    int p;
    int a;
    int b;
    if (!g_brokerAsk) {
        return;
    }
    p = g_brokerBy;
    a = g_brokerA;
    b = g_brokerB;
    g_brokerAsk = false;
    if (yes) {
        BOTC_BrokerActivate(p, a, b, true);
    }
    else {
        BOTC_BrokerClear("说书人判定不发动");
        BOTC_PmStore(g_teller, "【掮客】说书人判定本次不发动，今晚不形成熟客。");
    }
}

// 掮客自动改选：如果一组里同时选了两人则保持不变，否则把选中一人替换为另一人。
bool BOTC_BrokerRedirect (int p) {
    int a;
    int b;
    int c;
    int na;
    int nb;
    int nc;
    bool hasA;
    bool hasB;
    string fromName;
    string toName;
    if (!BOTC_BrokerActive()) {
        return false;
    }
    // 【痢蛭 × 掮客】首夜 / 中途补选的宿主不能被改指。
    if (BOTC_ActRoleOf(p) == 100 && BOTC_LleechHostMode(p)) {
        return false;
    }
    a = g_skillT1[p];
    b = g_skillT2[p];
    c = g_skillT3[p];
    hasA = (a == g_brokerA || b == g_brokerA || c == g_brokerA);
    hasB = (a == g_brokerB || b == g_brokerB || c == g_brokerB);
    if (hasA && hasB) {
        return false;
    }
    if (!hasA && !hasB) {
        return false;
    }
    na = a;
    nb = b;
    nc = c;
    if (hasA) {
        fromName = BOTC_NameStr(g_brokerA);
        toName = BOTC_NameStr(g_brokerB);
        if (a == g_brokerA) { na = g_brokerB; }
        if (b == g_brokerA) { nb = g_brokerB; }
        if (c == g_brokerA) { nc = g_brokerB; }
    }
    else {
        fromName = BOTC_NameStr(g_brokerB);
        toName = BOTC_NameStr(g_brokerA);
        if (a == g_brokerB) { na = g_brokerA; }
        if (b == g_brokerB) { nb = g_brokerA; }
        if (c == g_brokerB) { nc = g_brokerA; }
    }
    g_skillT1[p] = na;
    g_skillT2[p] = nb;
    g_skillT3[p] = nc;
    g_redirectSkip = true;
    g_redirectBy = p;
    g_brokerRedirectedBy = p;
    BOTC_PmStore(g_teller, "【掮客】" + BOTC_NameStr(p) + " 的目标由 " + fromName + " 转移为 " + toName + "。");
    return true;
}

//==================================================================================================
// 【酒保（160）】配板时选择一名邻近的善良非旅行者醉酒；酒保死亡不清理这份醉酒。
//==================================================================================================
int BOTC_BartenderNeighbor (int p, int dir) {
    int i;
    int k;
    int n;
    if (p < 2 || p > 13) {
        return 0;
    }
    BOTC_BuildSeatList();
    n = g_seatN;
    if (n < 3) {
        return 0;
    }
    k = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == p) {
            k = i;
        }
    }
    if (k < 0) {
        return 0;
    }
    return g_seatList[(k + dir + n) % n];
}

bool BOTC_BartenderGoodNeighbor (int q) {
    int r;
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return false;
    }
    if (BOTC_RoleTeam(r) == 5) {
        return false;                      // 旅行者
    }
    return (BOTC_SeatAlign(q) == 0);
}

void BOTC_BartenderClear () {
    if (g_bartenderDrunk >= 2 && g_bartenderDrunk <= 13) {
        g_tokOn[(((g_teller * 14) + g_bartenderDrunk) * 256) + 196] = false;
    }
    g_bartenderSeat = 0;
    g_bartenderDrunk = 0;
    g_bartenderAsk = false;
    g_bartenderA = 0;
    g_bartenderB = 0;
    BOTC_GrimRender(g_teller);
}

void BOTC_BartenderApply (int p, int q) {
    if (g_bartenderDrunk >= 2 && g_bartenderDrunk <= 13 && g_bartenderDrunk != q) {
        g_tokOn[(((g_teller * 14) + g_bartenderDrunk) * 256) + 196] = false;
    }
    g_bartenderSeat = p;
    g_bartenderDrunk = q;
    g_bartenderAsk = false;
    g_bartenderA = 0;
    g_bartenderB = 0;
    BOTC_WudTryTrigger(q, p);
    g_tokOn[(((g_teller * 14) + q) * 256) + 196] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【酒保】" + BOTC_NameStr(p) + " 邻近的善良玩家 " + BOTC_NameStr(q) + " 醉酒。");
}

void BOTC_BartenderSetup () {
    int p;
    int a;
    int b;
    int ca;
    int cb;
    p = 0;
    for (a = 2; a <= 13; a += 1) {
        if (g_seatOn[a] && BOTC_HasAbility(a, 160) && !BOTC_SeatImpaired(a)) {
            p = a;
        }
    }
    if (p < 2) {
        BOTC_BartenderClear();
        return;
    }
    g_bartenderSeat = p;
    a = BOTC_BartenderNeighbor(p, -1);
    b = BOTC_BartenderNeighbor(p, 1);
    ca = 0;
    cb = 0;
    if (BOTC_BartenderGoodNeighbor(a)) { ca = a; }
    if (BOTC_BartenderGoodNeighbor(b)) { cb = b; }
    if (ca == 0 && cb == 0) {
        BOTC_BartenderClear();
        BOTC_PmStore(g_teller, "【酒保】" + BOTC_NameStr(p) + " 两侧没有合法的善良非旅行者，本次不产生醉酒。");
        return;
    }
    if (ca > 0 && cb > 0) {
        if (RandomInt(1, 2) == 1) {
            BOTC_BartenderApply(p, ca);
        }
        else {
            BOTC_BartenderApply(p, cb);
        }
        return;
    }
    if (ca > 0) { BOTC_BartenderApply(p, ca); }
    else { BOTC_BartenderApply(p, cb); }
}

void BOTC_BartenderSync () {
    if (g_bartenderAsk || g_bartenderSeat < 2) {
        return;
    }
    if (!g_seatOn[g_bartenderSeat]) {
        BOTC_BartenderClear();
        return;
    }
    // 【处决死亡保留 / 其他死亡移除】（用户 2026-11-11）：详情页写的是「酒保因为非处决的原因
    //   死亡或离场时移除」→ 死于处决时 196 不撤，其余死亡立即撤掉。
    if (BOTC_SeatDead(g_bartenderSeat)) {
        if (g_deadKind[g_bartenderSeat] == 3) {
            return;
        }
        BOTC_BartenderClear();
        return;
    }
    if (!BOTC_HasAbility(g_bartenderSeat, 160) || BOTC_SeatImpaired(g_bartenderSeat)) {
        BOTC_BartenderClear();
        return;
    }
    if (g_bartenderDrunk < 2 || g_bartenderDrunk > 13) {
        BOTC_BartenderClear();
        return;
    }
    if (g_bartenderDrunk != BOTC_BartenderNeighbor(g_bartenderSeat, -1) && g_bartenderDrunk != BOTC_BartenderNeighbor(g_bartenderSeat, 1)) {
        BOTC_BartenderClear();
        return;
    }
    if (!BOTC_BartenderGoodNeighbor(g_bartenderDrunk)) {
        BOTC_BartenderClear();
    }
}

void BOTC_BartenderAnswer (bool left) {
    int p;
    int q;
    if (!g_bartenderAsk) {
        return;
    }
    p = g_bartenderSeat;
    q = g_bartenderB;
    if (left) {
        q = g_bartenderA;
    }
    BOTC_BartenderApply(p, q);
}

//==================================================================================================
// 【和尚（161）】每晚第一次阻止一个将要影响邻座存活玩家的邪恶能力。
// 首版通过统一技能确认入口和恶魔击杀入口拦截选择型能力。
//==================================================================================================
int BOTC_HeshangSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q)) {
            continue;
        }
        if (!g_heshangSeatUsed[q] && BOTC_AbilityWorks(q, 161)) {
            return q;
        }
    }
    return 0;
}

bool BOTC_HeshangAdjacentAlive (int h, int q) {
    if (h < 2 || h > 13 || q < 2 || q > 13 || BOTC_SeatDead(q)) {
        return false;
    }
    return (q == BOTC_BartenderNeighbor(h, -1) || q == BOTC_BartenderNeighbor(h, 1));
}

void BOTC_HeshangMark (int h, int src, string effect) {
    g_heshangUsed = true;
    g_heshangNight = g_nightNum;
    g_heshangBy = h;
    g_heshangSeatUsed[h] = true;
    g_heshangSeatNight[h] = g_nightNum;
    g_tokOn[(((g_teller * 14) + h) * 256) + 197] = true;
    BOTC_PmInfo(g_who[h], "【和尚】你的能力被触发了。");
    BOTC_PmStore(g_teller, "【和尚】" + BOTC_NameStr(src) + " 的" + effect + "将影响邻座存活玩家 → 本次效果被阻止。");
    BOTC_GrimRender(g_teller);
}

bool BOTC_HeshangTryBlockSelection (int p, int role) {
    int h;
    int t;
    if (!g_isNight || p < 2 || p > 13) {
        return false;
    }
    if (role < 0 || role > 163 || BOTC_SeatAlign(p) != 1 || BOTC_SeatDead(p)) {
        return false;
    }
    if (role == 41) {
        return false;                      // 刺客的刺杀明确不能被保护。
    }
    if (!BOTC_AbilityWorks(p, role)) {
        return false;
    }
    for (h = 2; h <= 13; h += 1) {
        if (!g_seatOn[h] || BOTC_SeatDead(h) || g_heshangSeatUsed[h] || !BOTC_AbilityWorks(h, 161)) {
            continue;
        }
        t = 0;
        if (BOTC_HeshangAdjacentAlive(h, g_skillT1[p])) {
            t = g_skillT1[p];
        }
        else if (BOTC_HeshangAdjacentAlive(h, g_skillT2[p])) {
            t = g_skillT2[p];
        }
        else if (BOTC_HeshangAdjacentAlive(h, g_skillT3[p])) {
            t = g_skillT3[p];
        }
        if (t == 0) {
            continue;
        }
        BOTC_HeshangMark(h, p, "能力选择");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return true;
    }
    return false;
}

bool BOTC_HeshangTryBlockSeat (int src, int role, int target) {
    int h;
    if (!g_isNight || src < 2 || src > 13 || target < 2 || target > 13) {
        return false;
    }
    if (role == 41 || BOTC_SeatAlign(src) != 1 || BOTC_SeatDead(src)) {
        return false;
    }
    if (!BOTC_AbilityWorks(src, role)) {
        return false;
    }
    for (h = 2; h <= 13; h += 1) {
        if (!g_seatOn[h] || BOTC_SeatDead(h) || g_heshangSeatUsed[h] || !BOTC_AbilityWorks(h, 161)) {
            continue;
        }
        if (!BOTC_HeshangAdjacentAlive(h, target)) {
            continue;
        }
        BOTC_HeshangMark(h, src, "能力攻击");
        return true;
    }
    return false;
}

void BOTC_HeshangDawnClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 197] = false;
        g_heshangSeatUsed[q] = false;
        g_heshangSeatNight[q] = 0;
    }
    g_heshangUsed = false;
    g_heshangNight = 0;
    g_heshangBy = 0;
    g_heshangNoDashiiMute = false;
}

//==================================================================================================
// 【蛊雕（162）】按当前方向寻找下一名“存活镇民角色”，令其中毒且可被当作邪恶的蛊雕。
//   效果分类：自动目标 + 每夜信息 + 持续中毒 + 互动干扰 + 每局一次方向改变。
//==================================================================================================
int BOTC_GudiaoNextTownsfolk (int p, int from, int dir) {
    int i;
    int q;
    int n;
    if (p < 2 || p > 13 || (dir != 1 && dir != -1)) {
        return 0;
    }
    BOTC_BuildSeatList();
    n = g_seatN;
    if (n < 2) {
        return 0;
    }
    q = p;
    if (from >= 2 && from <= 13) {
        for (i = 0; i < n; i += 1) {
            if (g_seatList[i] == from) {
                q = from;
                break;
            }
        }
    }
    for (i = 0; i < n; i += 1) {
        q = BOTC_RingNext(q, dir);
        if (q < 2 || q == p || !g_seatOn[q] || BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_SeatTeam(q) != 0) {
            continue;                         // 按当前真实角色类型寻找镇民，不看阵营 token
        }
        if (BOTC_SeatTrueRole(q) == 136) {
            continue;                         // 相克：蛊雕跳过魔术师
        }
        return q;
    }
    return 0;
}

string BOTC_GudiaoDirStr (int dir) {
    if (dir == -1) {
        return "逆时针";
    }
    return "顺时针";
}

int BOTC_GudiaoFlightSeat (int p) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (g_gdFlightBy[q] == p && g_tokOn[(((g_teller * 14) + q) * 256) + 200]) {
            return q;
        }
    }
    return g_gdPrev[p];
}

void BOTC_GudiaoClose () {
    g_miSeat = 0;
    g_miRole = -1;
    DialogControlSetVisible(g_miYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNote, PlayerGroupAll(), false);
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
}

void BOTC_GudiaoOpen (int p) {
    if (p < 2 || p > 13) {
        return;
    }
    // 已经改过方向、能力当前失效或电脑玩家：不需要再询问方向，直接按既定方向结算。
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 199] || !BOTC_SkillWorks(p) || BOTC_SeatIsComputer(p)) {
        BOTC_GudiaoApply(p, false);
        return;
    }
    BOTC_GudiaoClose();
    // 【是否发动技能的玩家模板】（用户 2026-11-07）：改向由蛊雕玩家本人决定。
    g_limitedAsk[p] = true;
    g_skillPicking[p] = false;
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    libNtve_gf_SetDialogItemText(g_skillTitle[p], StringToText("是否发动技能（改变方向）"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillSlotA[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotB[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillSlotC[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetVisible(g_skillNoPick[p], PlayerGroupSingle(g_who[p]), false);
    DialogControlSetPosition(g_skillOk[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 36, 144);
    DialogControlSetPosition(g_skillCancel[p], PlayerGroupSingle(g_who[p]), c_anchorTopLeft, 252, 144);
    libNtve_gf_SetDialogItemText(g_skillOk[p], StringToText("是"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_skillCancel[p], StringToText("否"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_skillOk[p], PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_skillCancel[p], PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
}

void BOTC_GudiaoAnswer (int p, bool change) {
    if (p < 2 || p > 13) {
        return;
    }
    if (g_miRole == 813 && g_miSeat == p) {
        BOTC_GudiaoClose();
    }
    if (g_limitedAsk[p]) {
        g_limitedAsk[p] = false;
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    }
    BOTC_GudiaoApply(p, change);
}

void BOTC_GudiaoApply (int p, bool change) {
    int q;
    int from;
    int dir;
    int target;
    int role;
    bool blocked;
    if (p < 2 || p > 13) {
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【蛊雕】" + BOTC_NameStr(p) + " 中毒 / 醉酒 / 活尸，蛊毒没有移动，方向机会也没有消耗。");
        return;
    }
    dir = 1;
    if (change && !g_tokOn[(((g_teller * 14) + p) * 256) + 199]) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 199] = true;
        BOTC_PmStore(g_teller, "【蛊雕】" + BOTC_NameStr(p) + " 改变方向：此后按逆时针寻找下一名存活镇民。");
    }
    else {
        change = false;
    }
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 199]) {
        dir = -1;
    }
    from = 0;
    if (!change) {
        from = BOTC_GudiaoFlightSeat(p);
    }
    target = BOTC_GudiaoNextTownsfolk(p, from, dir);
    if (target < 2) {
        if (change) {
            g_tokOn[(((g_teller * 14) + p) * 256) + 199] = true;
            BOTC_PmStore(g_teller, "【蛊雕】" + BOTC_NameStr(p) + " 改为逆时针，但场上没有可选的存活镇民。");
        }
        else {
            BOTC_PmStore(g_teller, "【蛊雕】" + BOTC_NameStr(p) + " 没有找到可选的存活镇民。");
        }
        BOTC_PmInfo(g_who[p], "【蛊雕】没有找到可选的存活镇民。");
        BOTC_GrimRender(g_teller);
        return;
    }
    // 盘璇只记录飞行位置：先移动，再判断蛊毒是否被和尚阻止。
    for (q = 2; q <= 13; q += 1) {
        if (g_gdFlightBy[q] != p) {
            continue;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 200] = false;
        g_gdFlightBy[q] = 0;
    }
    g_tokOn[(((g_teller * 14) + target) * 256) + 200] = true;
    g_gdFlightBy[target] = p;
    g_gdPrev[p] = target;
    BOTC_WudTryTrigger(target, p);
    blocked = BOTC_HeshangTryBlockSeat(p, 162, target);
    role = BOTC_SeatTrueRole(target);
    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(target) + " 的角色是：" + BOTC_RoleNameSafe(role) + "。");
    if (blocked) {
        BOTC_PmStore(g_teller, "【蛊雕】按" + BOTC_GudiaoDirStr(dir) + "飞到 " + BOTC_NameStr(target) + "：盘璇已移动，但蛊毒被和尚阻止。");
        BOTC_GrimRender(g_teller);
        return;
    }
    // 同一名蛊雕换目标时，上一份蛊毒到下个黄昏前也不会重叠：新目标会顶替旧标记。
    for (q = 2; q <= 13; q += 1) {
        if (g_gdBy[q] != p) {
            continue;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 198] = false;
        g_gdBy[q] = 0;
        BOTC_PairClearSeat(q);
    }
    g_tokOn[(((g_teller * 14) + target) * 256) + 198] = true;
    g_gdBy[target] = p;
    BOTC_PairClearSeat(target);
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【蛊雕】按" + BOTC_GudiaoDirStr(dir) + "飞到 " + BOTC_NameStr(target) + "（" + BOTC_RoleNameSafe(role) + "）：盘璇与蛊毒均已放置；蛊毒持续到下个黄昏，身份/阵营查验可能把他当作邪恶的蛊雕。");
}

void BOTC_GudiaoDuskClear () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 198]) {
            continue;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 198] = false;
        BOTC_PairClearSeat(q);
    }
    for (q = 2; q <= 13; q += 1) {
        g_gdBy[q] = 0;
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_GudiaoSourceGone (int q) {
    int i;
    if (q < 2 || q > 13) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (g_gdBy[i] == q) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 198] = false;
            g_gdBy[i] = 0;
            BOTC_PairClearSeat(i);
        }
        if (g_gdFlightBy[i] == q) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 200] = false;
            g_gdFlightBy[i] = 0;
        }
    }
    g_gdPrev[q] = 0;
    g_tokOn[(((g_teller * 14) + q) * 256) + 199] = false;
    BOTC_GrimRender(g_teller);
}

//==================================================================================================
// 【典狱长（163）】每夜先记录 1~3 名新判罚对象，再结算上一批。
//   上一批中有人白天死于处决 → 其他上一批玩家今晚死亡；否则由说书人从上一批选择一人死亡。
//==================================================================================================
void BOTC_WardenClear (int p, bool sourceGone) {
    int i;
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    for (i = 1; i <= 3; i += 1) {
        q = g_wardenPick[(p * 4) + i];
        if (q >= 2 && q <= 13 && g_wardenBy[q] == p) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 201] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 202] = false;
            g_wardenBy[q] = 0;
        }
        g_wardenPick[(p * 4) + i] = 0;
    }
    if (g_wardenAskBy == p) {
        g_wardenAsk = false;
        g_wardenAskBy = 0;
        g_wardenCandN = 0;
        if (g_miRole == 814) {
            DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
            g_miSeat = 0;
            g_miRole = -1;
        }
    }
    if (sourceGone) {
        BOTC_PmStore(g_teller, "【典狱长】" + BOTC_NameStr(p) + " 已离场：清除其判罚与死于今日标记。");
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_WardenExecDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 201]) {
        return;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 202] = true;
    BOTC_PmStore(g_teller, "【典狱长】判罚目标 " + BOTC_NameStr(q) + " 因处决死亡 → 打上「死于今日（典狱长）」。");
    BOTC_GrimRender(g_teller);
}

void BOTC_WardenOpenChoice (int p) {
    string s;
    int i;
    if (p < 2 || p > 13 || g_wardenCandN <= 0) {
        return;
    }
    s = "";
    for (i = 0; i < g_wardenCandN; i += 1) {
        if (StringLength(s) > 0) {
            s = s + "、";
        }
        s = s + BOTC_NameStr(g_wardenCand[i]);
    }
    g_wardenAsk = true;
    g_wardenAskBy = p;
    BOTC_MiSeatFieldsReset();
    g_miSeat = p;
    g_miRole = 814;
    g_miKind = 0;
    g_miText = "只结算上一批判罚；不会改变本夜新选择的判罚目标。";
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText("【典狱长·技能目标】点击场上的判罚玩家：" + s), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(g_miText), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【典狱长·技能目标】点击场上的判罚玩家：" + s + "。");
}

void BOTC_WardenKillChoice (int q) {
    int p;
    int i;
    bool ok;
    if (!g_wardenAsk) {
        return;
    }
    p = g_wardenAskBy;
    ok = false;
    for (i = 0; i < g_wardenCandN; i += 1) {
        if (g_wardenCand[i] == q) {
            ok = true;
        }
    }
    if (!ok) {
        BOTC_Notice(g_teller, "这个座位不是上一批判罚中仍能死亡的玩家，请重新填写。");
        return;
    }
    g_wardenAsk = false;
    g_wardenAskBy = 0;
    g_wardenCandN = 0;
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【典狱长】上一批无人死于处决 → 说书人选择 " + BOTC_NameStr(q) + " 在本轮死亡。");
    BOTC_DemonStrike(p, 163, q, false);
    if (BOTC_SeatDead(q)) {
        BOTC_PmStore(g_teller, "【典狱长】已为 " + BOTC_NameStr(q) + " 打上「死亡（典狱长）」。");
    }
}

void BOTC_WardenResolve (int p, int a, int b, int c) {
    int i;
    int q;
    int oldN;
    int oldExec;
    int candN;
    int[4] old;
    if (p < 2 || p > 13) {
        return;
    }
    old[1] = g_wardenPick[(p * 4) + 1];
    old[2] = g_wardenPick[(p * 4) + 2];
    old[3] = g_wardenPick[(p * 4) + 3];
    oldN = 0;
    oldExec = 0;
    for (i = 1; i <= 3; i += 1) {
        q = old[i];
        if (q < 2 || q > 13) {
            continue;
        }
        oldN = oldN + 1;
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 202]) {
            oldExec = q;
        }
        if (g_wardenBy[q] == p) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 201] = false;
            g_wardenBy[q] = 0;
        }
    }
    g_wardenPick[(p * 4) + 1] = 0;
    g_wardenPick[(p * 4) + 2] = 0;
    g_wardenPick[(p * 4) + 3] = 0;
    candN = 0;
    if (a >= 2 && a <= 13) {
        candN = candN + 1;
        g_wardenPick[(p * 4) + candN] = a;
        g_wardenBy[a] = p;
        g_tokOn[(((g_teller * 14) + a) * 256) + 201] = true;
    }
    if (b >= 2 && b <= 13) {
        candN = candN + 1;
        g_wardenPick[(p * 4) + candN] = b;
        g_wardenBy[b] = p;
        g_tokOn[(((g_teller * 14) + b) * 256) + 201] = true;
    }
    if (c >= 2 && c <= 13) {
        candN = candN + 1;
        g_wardenPick[(p * 4) + candN] = c;
        g_wardenBy[c] = p;
        g_tokOn[(((g_teller * 14) + c) * 256) + 201] = true;
    }
    BOTC_GrimRender(g_teller);
    if (oldN <= 0) {
        BOTC_PmStore(g_teller, "【典狱长】本夜记录第一批判罚；从下一夜开始结算上一批。");
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【典狱长】本夜能力失效：上一批判罚不造成死亡，但新一批判罚标记已经放置。");
        for (i = 1; i <= 3; i += 1) {
            q = old[i];
            if (q >= 2 && q <= 13) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 202] = false;
            }
        }
        BOTC_GrimRender(g_teller);
        return;
    }
    if (oldExec >= 2) {
        for (i = 1; i <= 3; i += 1) {
            q = old[i];
            if (q < 2 || q > 13 || q == oldExec || BOTC_SeatDead(q)) {
                continue;
            }
            BOTC_DemonStrike(p, 163, q, false);
        }
        BOTC_PmStore(g_teller, "【典狱长】上一批中的 " + BOTC_NameStr(oldExec) + " 死于处决 → 其他上一批玩家在今晚死亡。");
    }
    else {
        candN = 0;
        for (i = 1; i <= 3; i += 1) {
            q = old[i];
            if (q < 2 || q > 13 || BOTC_SeatDead(q)) {
                continue;
            }
            g_wardenCand[candN] = q;
            candN = candN + 1;
        }
        g_wardenCandN = candN;
        if (candN == 1) {
            q = g_wardenCand[0];
            g_wardenCandN = 0;
            BOTC_PmStore(g_teller, "【典狱长】上一批无人死于处决，唯一可死亡目标 " + BOTC_NameStr(q) + " 在本轮死亡。");
            BOTC_DemonStrike(p, 163, q, false);
        }
        else {
            if (candN > 1) {
                BOTC_WardenOpenChoice(p);
            }
            else {
                BOTC_PmStore(g_teller, "【典狱长】上一批无人死于处决，但已经没有仍能死亡的上一批玩家。");
            }
        }
    }
    for (i = 1; i <= 3; i += 1) {
        q = old[i];
        if (q >= 2 && q <= 13) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 202] = false;
        }
    }
    BOTC_GrimRender(g_teller);
}

// 利维坦（127）：白天公开；第二名善良玩家被处决时邪恶胜；持有第五天 token 且能力生效时，进入夜晚即邪恶胜。
// 公开通知只在进入白天之后检查，不向任何玩家私聊；中毒 / 醉酒 / 已死亡时当天不播报。
bool BOTC_LeviathanSeatActive (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || BOTC_SeatImpaired(q)) {
        return false;
    }
    return BOTC_HasAbility(q, 127);
}

// 活着且真正具有利维坦能力的座位（不含酒鬼 / 提线木偶 / 悟道者的认知覆盖）。
bool BOTC_LeviathanAlive () {
    return BOTC_LeviathanRoleHolder() >= 2;
}

int BOTC_LeviathanRoleHolder () {
    int i;
    int c;
    c = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 127)) {
            c = i;
        }
    }
    return c;
}

// 相克：第五天结束时利维坦和镇长都存活，且当天没有任何处决 → 善良胜。
// 这里是相克规则，不要求镇长清醒；镇长即使是邪恶阵营也照样成立。
bool BOTC_LeviathanMayorJinx () {
    int i;
    int mayor;
    mayor = 0;
    if (g_gameOver || g_dayNum != 5 || g_execUsedToday) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 12)) {
            mayor = i;
        }
    }
    if (!BOTC_LeviathanAlive() || mayor < 2) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×镇长相克】第五天结束时利维坦和镇长都存活，且当天没有处决 → 善良阵营获胜。");
    BOTC_ShowWin(0, "利维坦与镇长一起熬过了第五个白天，", "没有处决的小镇迎来了真正的和平。");
    return true;
}

// 相克：利维坦本人提名并处决了旅店老板上个夜晚保护的一名玩家 → 善良胜。
// 这里看的是提名者身份，中毒 / 醉酒不改变他仍然是利维坦。
bool BOTC_LeviathanInnkeeperJinx (int q) {
    int n;
    if (g_gameOver || q < 2 || q > 13) {
        return false;
    }
    if (g_innNight != g_dayNum || (q != g_innA && q != g_innB)) {
        return false;
    }
    n = g_nomFromOf[q];
    if (n < 2 || n > 13 || BOTC_SeatDead(n) || !BOTC_HasAbility(n, 127)) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×旅店老板相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了上个夜晚被旅店老板保护的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
    BOTC_ShowWin(0, "利维坦亲手处决了旅店老板昨夜保护的人，", "镇民抓住了这个致命破绽。");
    return true;
}

// 处决型相克：利维坦本人提名并处决对应角色 / 对应记录目标时，善良胜。
bool BOTC_LeviathanNominationJinx (int q) {
    int i;
    int h;
    int n;
    n = g_nomFromOf[q];
    if (BOTC_LeviathanInnkeeperJinx(q)) {
        return true;
    }
    if (n < 2 || n > 13 || BOTC_SeatDead(n) || !BOTC_HasAbility(n, 127)) {
        return false;
    }
    h = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i) || !BOTC_HasAbility(i, 161) || BOTC_SeatImpaired(i)) {
            continue;
        }
        if (BOTC_HeshangAdjacentAlive(i, q)) {
            h = i;
        }
    }
    if (h >= 2) {
        BOTC_PmStore(g_teller, "【利维坦×和尚相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了和尚邻座的存活玩家 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦越过边界，伤害了和尚庇护的人，", "这份罪孽反而让镇民找到了真相。");
        return true;
    }
    if (BOTC_HasAbility(q, 11)) {
        BOTC_PmStore(g_teller, "【利维坦×士兵相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了士兵 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦亲手处决了士兵，", "镇民抓住了这个致命破绽。");
        return true;
    }
    if (g_monkNight == g_dayNum && g_monkA == q) {
        BOTC_PmStore(g_teller, "【利维坦×僧侣相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了僧侣上一夜保护的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦处决了僧侣昨夜保护的人，", "镇民抓住了这个致命破绽。");
        return true;
    }
    if (g_exoJinxNight == g_dayNum && g_exoJinxSeat == q) {
        BOTC_PmStore(g_teller, "【利维坦×驱魔人相克】利维坦" + BOTC_NameStr(n) + " 提名并处决了驱魔人上一夜点中的 " + BOTC_NameStr(q) + " → 善良阵营获胜。");
        BOTC_ShowWin(0, "利维坦处决了驱魔人昨夜点中的玩家，", "镇民抓住了这个致命破绽。");
        return true;
    }
    return false;
}

// 相克：利维坦在场时，孙子死于处决 → 邪恶胜。
bool BOTC_LeviathanGrandchildJinx (int q) {
    if (q < 2 || q > 13 || !g_tokOn[(((g_teller * 14) + q) * 256) + 30]) {
        return false;
    }
    if (!BOTC_LeviathanAlive()) {
        return false;
    }
    BOTC_PmStore(g_teller, "【利维坦×祖母相克】利维坦在场，孙子 " + BOTC_NameStr(q) + " 死于处决 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "利维坦看着祖母的孙子被处决，", "祖母的哭声回荡在空荡的小镇。");
    return true;
}

// 相克夜间选人只在守鸦人 / 贤者 / 农夫中至少一位真实、存活且尚未失去能力时启用。
bool BOTC_LeviathanJinxTargetOn () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i) || g_levJinxLost[i]) {
            continue;
        }
        if (BOTC_HasAbility(i, 8) || BOTC_HasAbility(i, 59) || BOTC_HasAbility(i, 80) || BOTC_HasAbility(i, 131)) {
            return true;
        }
    }
    return false;
}

// 动态启用 / 关闭利维坦的夜间「相克选人」。普通板子仍然是纯被动恶魔。
void BOTC_LeviathanSpecialSync () {
    g_roleTargets[127] = 0;
    g_roleAct[127] = 0;
    // 普通对局保留官网末尾提示位；相克特殊行动启用时才改到前面。
    g_noAllFirst[127] = 87;
    g_noAllOther[127] = 123;
    if (BOTC_LeviathanRoleHolder() < 2 || !BOTC_LeviathanJinxTargetOn()) {
        return;
    }
    g_roleTargets[127] = 1;
    g_roleAct[127] = 2;
    g_noAllOther[127] = 8;
}

// 利维坦选中守鸦人 / 贤者 / 农夫：能力生效但目标不死亡。
void BOTC_LeviathanJinxTrigger (int q) {
    if (q < 2 || q > 13 || g_levJinxLost[q]) {
        return;
    }
    // 相克：利维坦选中报丧女妖 → 她死亡，随后按正常「被恶魔杀死」触发死亡后能力。
    if (BOTC_HasAbility(q, 131)) {
        BOTC_PmStore(g_teller, "【利维坦×报丧女妖相克】" + BOTC_NameStr(q) + " 被利维坦选中：报丧女妖死亡，死亡后能力按正常流程触发。");
        BOTC_MarkDeathQuiet(q, 1, 1);
        return;
    }
    if (BOTC_SeatImpaired(q)) {
        return;
    }
    if (BOTC_HasAbility(q, 8)) {
        g_levJinxWake[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×守鸦人相克】" + BOTC_NameStr(q) + " 被利维坦选中：守鸦人能力生效，但不会死亡。他今晚仍会按夜序醒来选一名玩家。");
        BOTC_WakeRender();
        return;
    }
    if (BOTC_HasAbility(q, 59)) {
        g_levJinxLost[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×贤者相克】" + BOTC_NameStr(q) + " 被利维坦选中：贤者能力生效，但不会死亡；触发后失去能力。");
        BOTC_SageOpen(q, true);
        BOTC_LeviathanSpecialSync();
        return;
    }
    if (BOTC_HasAbility(q, 80)) {
        g_levJinxLost[q] = true;
        BOTC_PmStore(g_teller, "【利维坦×农夫相克】" + BOTC_NameStr(q) + " 被利维坦选中：农夫能力生效，但不会死亡；触发后失去能力。");
        BOTC_FarmerOpen(q, true);
        BOTC_LeviathanSpecialSync();
        return;
    }
}

// 天数 token：始终按当前已经到达的白天编号，夜晚不提前使用下一天的 token。
// 例：第四天结束后的第五夜仍挂第四天；进入第五个白天后才更新为第五天。
void BOTC_LeviathanTokenSync () {
    int i;
    int c;
    int day;
    int tok;
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    day = g_dayNum;
    if (day < 1) {
        day = 1;
    }
    if (day > 5) {
        day = 5;
    }
    tok = 149 + day - 1;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 149] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 150] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 151] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 152] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 153] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 154] = false;
    }
    g_tokOn[(((g_teller * 14) + c) * 256) + tok] = true;
    if (g_execGoodCount > 0) {
        g_tokOn[(((g_teller * 14) + c) * 256) + 154] = true;
    }
    BOTC_GrimRender(g_teller);
    BOTC_LeviathanSpecialSync();
}

// 天亮后公开：只有真实、存活、未中毒 / 未醉酒且能力生效的利维坦才播报。
// 同一个生效阶段只播一次；如果某天黎明时被压制，下一个健康黎明会重新公开。
void BOTC_LeviathanDayCheck () {
    int c;
    if (g_gameOver || !g_started || g_dayNum < 1) {
        return;
    }
    BOTC_LeviathanTokenSync();
    c = BOTC_LeviathanRoleHolder();
    if (c < 2 || !BOTC_LeviathanSeatActive(c)) {
        g_levAnnouncedSeat = 0;
        return;
    }
    if (g_levAnnouncedSeat != c) {
        g_levAnnouncedSeat = c;
        BOTC_PubAnnounce("利维坦在场");
    }
    // 第五天白天只更新 token，不结算；第五天之后进入任何白天时都立刻检查胜利。
    if (g_dayNum > 5) {
        BOTC_LeviathanTokenWin();
    }
}

void BOTC_LeviathanExecution (int q) {
    int c;
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    // 相克优先于「第二名善良玩家」的胜利。
    if (BOTC_LeviathanNominationJinx(q)) {
        return;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    if (!BOTC_LeviathanSeatActive(c)) {
        BOTC_PmStore(g_teller, "【利维坦】这次处决时利维坦中毒 / 醉酒 / 失去能力 → 不计入处决数。");
        return;
    }
    if (BOTC_WinAlignOf(q) != 0) {
        return;
    }
    // 【陌客 / 失足】（用户 2026-11-01）：被半兽人「失足」标记（被视为邪恶）的玩家，
    //   不该计入「处决善良角色」的计数。
    // 【陌客改由说书人判定】（用户 2026-11-02）：处决陌客时不再自动排除，弹窗让说书人定阵营。
    if (BOTC_IsRecluseAbility(q)) {
        BOTC_LevRecluseAsk(q);
        return;
    }
    if (BOTC_ProtectTokOn(q, 127)) {
        BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 被「失足」标记 → 不计入处决数。");
        return;
    }
    BOTC_LevCountGood(q);
}

// 【利维坦 · 善良处决计数】（用户 2026-11-02）：从 BOTC_LeviathanExecution 尾部抽出来，
//   供「陌客由说书人判为善良」那条路复用（判为善良的当时才计数，第二名善良被处决即刻判胜）。
void BOTC_LevCountGood (int q) {
    int c;
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    if (!BOTC_LeviathanSeatActive(c)) {
        BOTC_PmStore(g_teller, "【利维坦】这次处决时利维坦中毒 / 醉酒 / 失去能力 → 不计入处决数。");
        return;
    }
    if (g_levGoodExec[q]) {
        BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 之前已经被计入过一次，本次不重复计数。");
        return;
    }
    g_levGoodExec[q] = true;
    g_execGoodCount = g_execGoodCount + 1;
    g_tokOn[(((g_teller * 14) + c) * 256) + 154] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【利维坦】善良玩家被处决：" + IntToString(g_execGoodCount) + " 名。");
    if (g_execGoodCount > 1) {
        BOTC_ShowWin(1, "利维坦看着第二名善良玩家被处决，", "小镇已经无可挽回。");
    }
}

// 【利维坦×陌客 · 说书人判定】（用户 2026-11-02）：处决陌客不再自动排除，
//   改为弹窗让说书人定阵营：【是】= 按善良计入；【否】/ X = 按邪恶不计入。
void BOTC_LevRecluseAsk (int q) {
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    // 电脑说书人不会点弹窗：沿用旧行为，直接按不计入处理。
    if (PlayerType(g_teller) != 1) {
        BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 是陌客 → 电脑说书人不弹窗，按不计入处理。");
        return;
    }
    if (g_levRecSeat >= 2) {
        BOTC_LevRecluseAnswer(0);
    }
    g_levRecSeat = q;
    libNtve_gf_SetDialogItemText(g_levRecTitle, StringToText("【利维坦】" + BOTC_NameStr(q) + " 是陌客：这次处决是否按善良阵营计入？"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_levRecDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 是陌客 → 请选择【是：按善良计入】或【否：不计入】。");
}

void BOTC_LevRecluseAnswer (int ans) {
    int q;
    q = g_levRecSeat;
    g_levRecSeat = 0;
    if (g_levRecDlg != 0) {
        DialogSetVisible(g_levRecDlg, PlayerGroupAll(), false);
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (ans != 0) {
        BOTC_LevCountGood(q);
        return;
    }
    BOTC_PmStore(g_teller, "【利维坦】" + BOTC_NameStr(q) + " 按邪恶登记 → 不计入处决数。");
}

// 【半兽人×陌客 / 间谍 · 说书人判定】（用户 2026-11-11）：目标真身是陌客（15）/ 间谍（18）时，
//   他到底算善良还是邪恶由说书人定 → 弹窗问「这次是否击杀」。
//   【是：击杀】= 目标死亡（夜间·非恶魔杀）且今晚恶魔不造成死亡；【否 / X】= 不杀，恶魔正常出刀。
void BOTC_LycanAsk (int p, int t) {
    if (p < 2 || p > 13 || t < 2 || t > 13 || g_gameOver) {
        return;
    }
    if (g_lycanTgt >= 2) {
        BOTC_LycanResolve(g_lycanBy, g_lycanTgt, false);      // 上一次没答完 → 先按不杀收掉
    }
    g_lycanBy = p;
    g_lycanTgt = t;
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉
    g_grimOn[g_who[p]] = false;
    BOTC_ManInfoOpen(p, 805, BOTC_NameStr(t));
    BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 是间谍 / 陌客能力者 → 请选择【击杀】或【不杀】。");
}

void BOTC_LycanAnswer (int yes) {
    int p;
    int t;
    p = g_lycanBy;
    t = g_lycanTgt;
    g_lycanBy = 0;
    g_lycanTgt = 0;
    if (t < 2 || t > 13) {
        return;
    }
    BOTC_LycanResolve(p, t, yes != 0);
}

// 【半兽人结算】kill 为真 → 目标死亡且今晚恶魔不造成死亡；否则不杀、恶魔正常出刀。
//   自动判定（登记层）和陌客 / 间谍弹窗两条路都走这里，保证副作用一致。
void BOTC_LycanResolve (int p, int t, bool kill) {
    if (p < 2 || p > 13 || t < 2 || t > 13) {
        return;
    }
    // 【能力失效】（用户 2026-11-11）：半兽人中中毒 / 醉酒 / 酒鬼 / 提线木偶时能力不生效 ----
    //   弹窗等待期间可能被打上中毒 / 醉酒，所以这里按结算那一刻再判一次，绝不落刀。
    if (kill && !BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 中毒 / 醉酒 / 酒鬼 / 提线木偶：能力失效 → 不杀人，恶魔正常出刀。");
        return;
    }
    if (!kill) {
        BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 不击杀 " + BOTC_NameStr(t) + "（按登记为邪恶）→ 恶魔正常出刀。");
        return;
    }
    BOTC_MarkDeathQuietSrc(t, 1, 0, 107);
    g_lycanNoDemon = true;
    BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 击杀了 " + BOTC_NameStr(t) + "（按登记为善良）→ 今晚恶魔不造成死亡。");
}

// 【教父×陌客】（用户 2026-11-05）：陌客白天死亡时不再按登记自动判定，
//   改为弹窗问说书人这次死亡算不算外来者死亡；结果直接决定教父当晚能不能杀人。
void BOTC_GfRecluseAsk (int q) {
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    if (g_gfRecSeat >= 2) {
        BOTC_GfRecluseAnswer(0);          // 上一次没答完 → 先按不算收掉
    }
    g_gfRecSeat = q;
    libNtve_gf_SetDialogItemText(g_gfRecTitle, StringToText("【教父】" + BOTC_NameStr(q) + " 是陌客：这次白天死亡是否算作外来者？"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_gfRecDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(q) + " 是陌客 → 请选择【是：算作外来者】或【否：不算】。");
}

void BOTC_GfRecluseAnswer (int ans) {
    int q;
    q = g_gfRecSeat;
    g_gfRecSeat = 0;
    if (g_gfRecDlg != 0) {
        DialogSetVisible(g_gfRecDlg, PlayerGroupAll(), false);
    }
    if (q < 2 || q > 13) {
        return;
    }
    g_gfRecAnsSet[q] = true;
    if (ans != 0) {
        g_gfRecAns[q] = true;
        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = true;
        BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(q) + "（陌客）算作外来者死亡 → 今晚教父可以杀人。");
    }
    else {
        g_gfRecAns[q] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = false;
        BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(q) + "（陌客）不算外来者死亡 → 今晚教父不能杀人。");
    }
    BOTC_GrimRender(g_teller);
}

// 【教父×陌客】（用户 2026-11-05）：只有教父能力在场（含借来的）且还活着时才需要判定。
bool BOTC_GfAliveInPlay () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!BOTC_HasAbility(q, 39)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        return true;
    }
    return false;
}

//--------------------------------------------------------------------------------------------------
// 【异教领袖（106）· 夜间改阵营】（用户 2026-11-07）：夜里不唤醒他、也不私聊他，
//   到他的夜序位次时弹窗，让说书人选择把他变成哪一名相邻存活玩家的阵营。
//   · 相邻只算活人（BOTC_EmpathNeighbor 会跳过死人，顺延到最近的一名存活玩家）。
//   · 每名异教领袖每夜只弹一次（g_cultChDone 记夜数），借来的能力同样生效。
//   · 能力失效（中毒 / 醉酒 / 来源离场）时不弹窗。
//--------------------------------------------------------------------------------------------------
int BOTC_CultChoiceOrd (int q) {
    if (g_nightNum <= g_seatFirstNight[q] && BOTC_NoFirstOf(106) > 0) {
        return BOTC_NoFirstOf(106);
    }
    return BOTC_NightOrder(106);
}

bool BOTC_CultChoiceStep (int beforeOrd) {
    int q;
    int ord;
    if (!g_started || !g_isNight || g_gameOver) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!BOTC_HasAbility(q, 106)) {
            continue;
        }
        if (!BOTC_AbilityWorks(q, 106)) {
            continue;
        }
        if (g_cultChDone[q] == g_nightNum) {
            continue;
        }
        ord = BOTC_CultChoiceOrd(q);
        if (ord <= 0) {
            continue;
        }
        if (beforeOrd > 0 && (ord * 10) > beforeOrd) {
            continue;                      // 还没到他的夜序，先让别人行动
        }
        g_cultChDone[q] = g_nightNum;      // 同一夜不重复弹
        BOTC_CultChoiceAsk(q);
        return true;
    }
    return false;
}

void BOTC_CultChoiceAsk (int q) {
    int L;
    int R;
    string sl;
    string sr;
    if (q < 2 || q > 13 || g_gameOver) {
        return;
    }
    if (g_cultChSeat >= 2) {
        BOTC_CultChoiceAnswer(0);          // 上一次没答完 → 先按不改变收掉
    }
    L = BOTC_EmpathNeighbor(q, -1);
    R = BOTC_EmpathNeighbor(q, 1);
    g_cultChSeat = q;
    g_cultChLSeat = L;
    g_cultChRSeat = R;
    if (g_cultChDlg == 0) {
        return;
    }
    if (L <= 0 && R <= 0) {
        g_cultChSeat = 0;
        g_cultChLSeat = 0;
        g_cultChRSeat = 0;
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 没有相邻的存活玩家 → 今晚不改变阵营。");
        return;
    }
    libNtve_gf_SetDialogItemText(g_cultChTitle, StringToText("【异教领袖】" + BOTC_NameStr(q) + "：选择一名相邻存活玩家，变成其阵营"), PlayerGroupSingle(g_teller));
    sl = "左邻：无";
    sr = "右邻：无";
    if (L > 0) {
        sl = "左邻 [" + IntToString(g_lab[L]) + "] " + TextToString(BOTC_SeatNameText(L)) + "（" + BOTC_AlignName(BOTC_SeatRegAlign(L)) + "）";
    }
    if (R > 0) {
        sr = "右邻 [" + IntToString(g_lab[R]) + "] " + TextToString(BOTC_SeatNameText(R)) + "（" + BOTC_AlignName(BOTC_SeatRegAlign(R)) + "）";
    }
    libNtve_gf_SetDialogItemText(g_cultChL, StringToText(sl), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_cultChR, StringToText(sr), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_cultChL, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_cultChR, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_cultChX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_cultChDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 到夜序 → 请选择把他变成哪一名相邻存活玩家的阵营；点 X = 今晚不改变。");
}

void BOTC_CultChoiceAnswer (int ans) {
    int q;
    int t;
    int al;
    bool mustEvil;
    q = g_cultChSeat;
    t = 0;
    if (ans == 1) {
        t = g_cultChLSeat;
    }
    if (ans == 2) {
        t = g_cultChRSeat;
    }
    g_cultChSeat = 0;
    g_cultChLSeat = 0;
    g_cultChRSeat = 0;
    if (g_cultChDlg != 0) {
        DialogSetVisible(g_cultChDlg, PlayerGroupAll(), false);
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (t < 2 || t > 13) {
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 今晚不改变阵营。");
        return;
    }
    al = BOTC_SeatRegAlign(t);
    // 官方相克：麻脸巫婆造出来的邪恶异教领袖不能因自身能力变成善良。
    mustEvil = false;
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 74] && BOTC_SeatAlign(q) == 1 && al == 0) {
        mustEvil = true;
        BOTC_PmStore(g_teller, "【异教领袖×麻脸巫婆】" + BOTC_NameStr(q) + " 是被创造的邪恶异教领袖，不能因自身能力变成善良。");
    }
    // 官方相克：恶魔借来的异教领袖能力不能把恶魔变成善良。
    if (BOTC_BoffinMustStayEvil(q) && BOTC_SeatAlign(q) == 1 && al == 0) {
        mustEvil = true;
        BOTC_PmStore(g_teller, "【异教领袖×科学怪人】" + BOTC_NameStr(q) + " 的恶魔不会被这个能力变成善良。");
    }
    if (mustEvil) {
        al = 1;
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时不能再新增邪恶，保持善良。
    if (al == 1 && BOTC_HolySoulBlocks(q)) {
        al = 0;
        BOTC_PmStore(g_teller, "【异教领袖×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(q) + " 保持善良阵营。");
    }
    // 【食人族 × 异教领袖 · 阵营锁定】（用户 2026-11-10）：已锁定时保持当前阵营；
    //   第一次因异教领袖改变阵营前，记住他的原阵营。
    if (BOTC_SeatRegAlign(q) != al) {
        if (g_cannLocked[q]) {
            al = BOTC_SeatRegAlign(q);
            BOTC_PmStore(g_teller, "【食人族×异教领袖】" + BOTC_NameStr(q) + " 的阵营已锁定为 " + BOTC_AlignName(al) + "，今晚不改变。");
        }
        else {
            if (BOTC_HasAbility(q, 74) && g_cannOrigAlign[q] < 0) {
                g_cannOrigAlign[q] = BOTC_SeatRegAlign(q);
            }
        }
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 15] = false;
    if (al == 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;
    }
    else {
        g_tokOn[(((g_teller * 14) + q) * 256) + 14] = true;
    }
    BOTC_SetReg(q, -1, -1);             // 真身阵营刚变 → 登记层缓存作废，技能按新阵营算
    BOTC_GrimRender(g_teller);
    BOTC_ClaimBtnRender();
    BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 变成 " + BOTC_NameStr(t) + " 的阵营 → " + BOTC_AlignName(al) + "。");
}

void BOTC_CultChoiceSettle () {
    int q;
    q = g_cultChSeat;
    g_cultChSeat = 0;
    g_cultChLSeat = 0;
    g_cultChRSeat = 0;
    if (g_cultChDlg != 0) {
        DialogSetVisible(g_cultChDlg, PlayerGroupAll(), false);
    }
    if (q >= 2 && q <= 13) {
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 的选择没有作答 → 今晚不改变阵营。");
    }
}

//--------------------------------------------------------------------------------------------------
// 【和平主义者（33）· 处决弹窗】（用户 2026-11-06）：处决善良角色时弹窗让说书人决定是否触发。
//   返回 true = 已弹窗（暂停处决等回答）；返回 false = 不弹窗（照常处决）。
//   不弹窗的情况：目标是尸体 / 有「无敌」token / 已带「处决不死」token / 无和平主义者在场 /
//   和平主义者已死亡或失效 / 目标不是善良且不是陌客/间谍。
//--------------------------------------------------------------------------------------------------
bool BOTC_PacifistAsk (int q) {
    int i;
    int pf;
    if (q < 2 || q > 13 || g_gameOver) {
        return false;
    }
    // 电脑说书不弹窗，沿用旧行为
    if (PlayerType(g_teller) != 1) {
        return false;
    }
    // 目标已有「无敌」token → 不弹窗（肯定不会死）
    if (BOTC_ProtectTokOn(q, 176)) {
        return false;
    }
    // 目标已带「处决不死」token（和平主义者 28 / 魔鬼代言人 27）→ 不弹窗
    if (BOTC_ProtectTokOn(q, 27) || BOTC_ProtectTokOn(q, 28)) {
        return false;
    }
    // 找和平主义者：通过能力层（支持借来的能力）
    pf = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_AbilityWorks(i, 33)) {
            pf = i;
            break;
        }
    }
    if (pf < 2) {
        return false;
    }
    // 和平主义者已死亡或已失效（中毒/醉酒）→ 不弹窗
    if (BOTC_SeatDead(pf) || BOTC_SeatImpaired(pf)) {
        return false;
    }
    // 目标是尸体 → 不弹窗（尸体处决不走和平主义者）
    if (BOTC_SeatDead(q)) {
        return false;
    }
    // 目标必须是善良 / 陌客 / 间谍 → 其他不弹窗
    if (BOTC_SeatRegAlign(q) != 0 && BOTC_SeatTrueRole(q) != 15 && BOTC_SeatTrueRole(q) != 18) {
        return false;
    }
    // 上一次还没答完 → 先按「照常处决」收掉
    if (g_pacAskSeat >= 2) {
        BOTC_PacifistAnswer(0);
    }
    g_pacAskSeat = q;
    libNtve_gf_SetDialogItemText(g_pacAskTitle, StringToText("【和平主义者】" + BOTC_NameStr(q) + " 即将被处决：是否让他不死？"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pacAskDlg, PlayerGroupSingle(g_teller), true);
    BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(q) + " 即将被处决，请选择【是：不死】或【否：照常处决】。");
    return true;
}

void BOTC_PacifistAnswer (int ans) {
    int q;
    q = g_pacAskSeat;
    g_pacAskSeat = 0;
    if (g_pacAskDlg != 0) {
        DialogSetVisible(g_pacAskDlg, PlayerGroupAll(), false);
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (ans != 0) {
        // 说书人选【是】→ 给目标打「处决不死（和平主义者）」token
        g_tokOn[(((g_teller * 14) + q) * 256) + 28] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【和平主义者】已为 " + BOTC_NameStr(q) + " 打上「处决不死（和平主义者）」标记。");
        // 走免死流程：公屏播报 + 结束提名
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但不知道为什么，他并没有死亡。");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 说书人选【否】/ X → 照常处决，继续走 BOTC_ExecAfterRps
    BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(q) + " 照常处决。");
    BOTC_ExecAfterRps(q);
}

// 白天陌客死亡时先问说书人；返回 true = 已弹窗、调用方不要按登记自动打 token。
// 电脑说书人 / 夜间死亡 / 教父不在场 → 返回 false，沿用原来的自动判定。
bool BOTC_GfRecluseDayAsk (int q) {
    if (g_isNight || q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_GfAliveInPlay() || !BOTC_IsRecluseAbility(q)) {
        return false;
    }
    if (PlayerType(g_teller) != 1) {
        return false;
    }
    g_gfRecAnsSet[q] = false;
    g_gfRecAns[q] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 56] = false;
    BOTC_GfRecluseAsk(q);
    return true;
}

// 进入夜晚前还没作答 → 按不算外来者处理（跟利维坦×陌客判定同一口径）。
void BOTC_GfRecluseSettle () {
    if (g_gfRecSeat >= 2) {
        BOTC_GfRecluseAnswer(0);
    }
}

// 第五天 token 的统一胜利入口：天亮、进入夜晚、解毒 / 恢复能力时都会调用。
void BOTC_LeviathanTokenWin () {
    int c;
    if (g_gameOver || !g_started) {
        return;
    }
    // 【第五天结算时机】（用户 2026-11-03）：第五天提示只在「第五天结束 / 点【进入夜晚】」之后才判胜。
    //   第五天的白天（处决前、处决后但还没点【进入夜晚】）一律不结算 —— 否则天亮死亡清理 / 换身份 /
    //   手动改 token 这些通用同步点都会误触发，出现「还没处决就宣布利维坦胜利」。
    //   g_isNight 在 BOTC_NightGo 的入夜分支里、BOTC_DuskResolve 之前就已经置真，所以黄昏那次照常结算。
    if (g_dayNum < 6 && !g_isNight) {
        return;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2 || !g_tokOn[(((g_teller * 14) + c) * 256) + 153]) {
        return;
    }
    if (!BOTC_LeviathanSeatActive(c)) {
        return;
    }
    BOTC_PmStore(g_teller, "【利维坦】持有第五天 token，且利维坦存活、能力生效 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "利维坦跨过了第五天，", "小镇再也没有明天。");
}

// 按下【进入夜晚】后的黄昏结算：镇长相克优先，随后检查第五天 token。
// 中毒 / 醉酒 / 失去能力时本轮不结算，token 继续保留；恢复能力时会由统一入口立刻判胜。
void BOTC_LeviathanDuskCheck () {
    int c;
    if (g_gameOver) {
        return;
    }
    // 【利维坦×陌客】（用户 2026-11-02）：进入夜晚前还没作答 → 默认按不计入处理。
    if (g_levRecSeat >= 2) {
        BOTC_LevRecluseAnswer(0);
    }
    BOTC_LeviathanSpecialSync();
    if (g_dayNum >= 5) {
        g_levAfterFifth = true;
    }
    c = BOTC_LeviathanRoleHolder();
    if (c < 2) {
        return;
    }
    if (BOTC_LeviathanMayorJinx()) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + c) * 256) + 153] && !BOTC_LeviathanSeatActive(c)) {
        BOTC_PmStore(g_teller, "【利维坦】已经有第五天 token，但这次进入夜晚时他中毒 / 醉酒 / 失去能力 → 暂不结算。");
    }
    BOTC_LeviathanTokenWin();
}

void BOTC_SkillConfirmCore (int p);

// 【疯子·假能力】（用户 2026-11-10）：假能力按中毒 / 醉酒处理 ---- 结算照常走完，
//   但 BOTC_SkillWorks 在此期间一律返回 false，所以效果不生效；确认完立刻撤掉行动标记。
void BOTC_SkillConfirm (int p) {
    BOTC_SkillConfirmCore(p);
    if (p >= 1 && p <= 13 && g_lunFakeAct[p]) {
        g_lunFakeAct[p] = false;
        BOTC_GrimRender(g_teller);
    }
}

void BOTC_SkillConfirmCore (int p) {
    int r;
    string s;
    int n;
    int n2;
    int t;
    int rt;
    int dk;
    int i;
    int w1;
    int w2;
    int w3;
    bool goonHit;
    int nr;                       // 舞蛇人（49）交换角色时用：新恶魔拿到的角色
    int nrP;                      // 【交换时"换给恶魔"的那个角色】（用户 2026-10-12）：= 选人这位的真身
    int alP;                      // 舞蛇人（交换前）的阵营（用户 2026-10-02）
    int alT;                      // 原恶魔（交换前）的阵营（用户 2026-10-02）
    bool snakeOk;                 // 【舞蛇人】这一支：这一次到底换不换（用户 2026-10-14）
    bool snakeLm;                 // 【舞蛇人】这一支：目标是不是「带着小怪宝」（要一起把 134 挪到新恶魔身上）
    string lus;                   // 疯子报给恶魔时的身份说明（哲学疯子用，用户 2026-10-03）
    int cogP;                     // 【认知覆盖】（用户 2026-10-19）：选人这位的认知 token（-1 = 不是）
    int cogT;                     // 【认知覆盖】：目标那一格的认知 token
    int cardP;                    // 【认知覆盖】：选人这位「以为的身份」
    int cardT;                    // 【认知覆盖】：目标「以为的身份」
    // 【小怪宝 / 造谣者 / 赏金猎人】说书人的单目标技能面板（用户 2026-11-10）
    if (g_mdAsk && g_who[p] == g_teller) {
        BOTC_MdAskConfirm();
        // 还没选目标 / 选了不合法目标时保持面板打开，等说书人改选。
        if (!g_mdAsk) {
            g_skillPicking[p] = false;
            g_skillT1[p] = 0;
            g_skillT2[p] = 0;
            g_skillT3[p] = 0;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        }
        return;
    }
    if (g_scarletPick && p == 1) {
        t = g_skillT1[1];
        if (t < 2 || t > 13 || !g_seatOn[t] || BOTC_SeatDead(t) || !BOTC_AbilityWorks(t, 19)) {
            BOTC_Notice(g_teller, "请选择一名当前仍可生效的红唇女郎能力持有者。");
            return;
        }
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_ScarletPromote(t);
        return;
    }
    if (g_courtPick && p == 1) {
        t = g_skillT1[1];
        if (t < 2 || t > 13 || BOTC_RegRoleOf(t) != g_courtRole) {
            BOTC_Notice(g_teller, "请选择一名拥有该「" + BOTC_RoleNameSafe(g_courtRole) + "」角色的玩家。");
            return;
        }
        r = g_courtBy;
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_CourtierApply(r, t, g_courtRole);
        return;
    }
    if (g_boomKeepPick && p == 1) {
        BOTC_BoomKeepConfirm();
        return;
    }
    if (g_limitedAsk[p]) {
        BOTC_LimitedAccept(p);
        return;
    }
    if (g_poAsk[p]) {
        BOTC_PoAskAnswer(p, true);
        return;
    }
    r = BOTC_ActRoleOf(p);
    // 【限次能力用过就彻底不能再结算】（用户 2026-11-10）：
    //   巡山人（77）等每局限一次的角色，用完之后手动唤醒、电脑兜底、面板重开都不能再走一遍。
    if (BOTC_NightLimitRole(r) && BOTC_NightLimitUsed(p, r)) {
        BOTC_PmStore(g_teller, "【限次能力】" + BOTC_NameStr(p) + " " + BOTC_SeatRoleStr(p) + " 的一次性能力已经用掉了，这次不再结算。");
        g_skillPicking[p] = false;
        g_limitedAsk[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_SkillBtnRender();
        return;
    }
    // 玩家按下确认时就先记录他提交的原始选择；后续暗改目标再结算也不会改变这条私聊。
    BOTC_TellSkillChoice(p, -1);
    // 使节：在开始结算原能力之前询问一次；判定后递归回来时跳过询问。
    if (g_redirectSkip && p == g_redirectBy) {
        g_redirectSkip = false;
        g_redirectBy = 0;
    }
    else {
        g_brokerRedirectedBy = 0;
        if (BOTC_HalfImmortalMaybePrompt(p)) {
            return;
        }
        if (BOTC_BrokerRedirect(p)) {
            BOTC_SkillConfirm(p);
            return;
        }
        if (BOTC_EnvoyMaybePrompt(p)) {
            return;
        }
    }
    if (BOTC_HeshangTryBlockSelection(p, r)) {
        return;
    }
    BOTC_WudCheckSelection(p);
    if (g_pedantActing[p]) {
        t = g_skillT1[p];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一名玩家，再按【确认】。");
            return;
        }
        if (!g_tokOn[(((g_teller * 14) + p) * 256) + 171]) {
            BOTC_Notice(g_teller, "书生本次行动需要先给该玩家放置「已猜测」token。");
            g_pedantActing[p] = false;
            g_skillPicking[p] = false;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        g_pedantActing[p] = false;
        BOTC_PedantResolve(p, t);
        return;
    }
    if (g_boffinRecipientPick && p == 1) {
        t = g_skillT1[1];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_teller, "先点一名存活恶魔，再按【确认】。");
            return;
        }
        BOTC_BoffinSetRecipient(t);
        return;
    }
    if (g_boffinActing[p] && !BOTC_BoffinWorksAt(g_boffinActingSource[p])) {
        BOTC_PmStore(g_teller, "【科学怪人】来源已经失效，这次借用能力的确认作废。");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_bnestActing[p] && !BOTC_BoffinNestedWorksAt(g_bnestSource[p], p)) {
        BOTC_PmStore(g_teller, "来源已经失效，这次能力的确认作废。");
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_grantActing[p] && (g_grantRoleBy[p] <= 0 || g_grantRoleBy[p] > 163)) {
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【奥赫（134）】角色不在场 / 有多个持有者：由说书人在这里确认最终死亡玩家
    if (g_ojoAskSt && p == 1) {
        i = g_ojoFrom;
        t = g_skillT1[p];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_teller, "先点一名玩家再确认。");
            return;
        }
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_OjoResolveTarget(i, t);
        return;
    }
    // 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）：说书人指定谁当落难少女
    if (g_damselAsk > 0 && g_who[p] == g_teller) {
        BOTC_DamselAskConfirm(g_skillT1[p]);
        return;
    }

    r = BOTC_ActRoleOf(p);
    if (r == 159) {
        t = g_skillT1[p];
        n = g_skillT2[p];
        if (t < 2 || t > 13 || n < 2 || n > 13 || t == n || BOTC_SeatDead(t) || BOTC_SeatDead(n)) {
            BOTC_Notice(g_who[p], "掮客要选择两名不同的存活玩家。");
            return;
        }
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_BrokerSelect(p, t, n);
        return;
    }
    if (r == 156) {
        s = "";
        t = g_skillT1[p];
        if (t >= 2 && t <= 13 && t != p) {
            s = BOTC_NameStr(t);
        }
        t = g_skillT2[p];
        if (t >= 2 && t <= 13 && t != p) {
            if (s != "") { s = s + "、"; }
            s = s + BOTC_NameStr(t);
        }
        t = g_skillT3[p];
        if (t >= 2 && t <= 13 && t != p) {
            if (s != "") { s = s + "、"; }
            s = s + BOTC_NameStr(t);
        }
        if (s == "") {
            s = "（未选择玩家）";
        }
        BOTC_PmStore(g_teller, "【引路人】" + BOTC_NameStr(p) + " 选择了 " + s + "。");
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_GuideOpen(p, s);
        return;
    }
    if (r == 155) {
        t = g_skillT1[p];
        if (t < 2 || t > 13 || !g_seatOn[t] || BOTC_SeatDead(t)) {
            BOTC_Notice(g_who[p], "画皮要选择一名存活玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_SkinChoose(p, t);
        return;
    }
    if (r == 154) {
        BOTC_TaotieOpen(p);
        return;
    }
    // 【理发师交换】必须先于被唤醒恶魔的原能力结算，否则哈迪寂亚会进入自己的三目标面板。
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        BOTC_TellSkillChoice(p, -1);
        BOTC_BarberSwap(p, g_skillT1[p], g_skillT2[p]);
        return;
    }
    // 【莽夫（37）】（用户 2026-10-16 修 BUG）：**先把莽夫那一份算掉** ----
    //   只要是「用夜间技能选择了一名玩家」的角色，都要先过这一关。原来这两句写在函数很后面，
    //   而寡妇（75）那一支在它们之前就 return 了 → 寡妇毒莽夫时莽夫的能力根本没被记上，
    //   结果变成「莽夫中毒」，而不是「寡妇醉酒」。挪到这里，所有选人类的角色一次覆盖。
    if (g_skillT1[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT1[p]);
    }
    if (g_skillT2[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT2[p]);
    }
    // 【狐媚娘（153）】首夜选择一名玩家，记录魅惑目标并处理告知。
    if (r == 153) {
        t = g_skillT1[p];
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先选择一名玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_VixenChoose(p, t);
        return;
    }
    // 食人魔（148）：选择朋友并静默加入其阵营；毒醉也照常生效。
    if (r == 148) {
        t = g_skillT1[p];
        if (t < 2 || t > 13 || t == p || !g_seatOn[t]) {
            BOTC_Notice(g_who[p], "请选择一名其他玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_OgreResolve(p, t);
        return;
    }
    // 【典狱长（163）】：1~3 个不同玩家；先记录新一批，再由统一函数结算上一批。
    // 疯子自认典狱长只走后面的统一疯子假行动，不放置判罚，也不结算死亡。
    if (r == 163 && !BOTC_IsLunatic(p)) {
        w1 = g_skillT1[p];
        w2 = g_skillT2[p];
        w3 = g_skillT3[p];
        if (w1 >= 2 && (w1 > 13 || !g_seatOn[w1])) {
            BOTC_Notice(g_who[p], "判罚目标无效，请重新选择。");
            return;
        }
        if (w2 >= 2 && (w2 > 13 || w2 == w1)) {
            BOTC_Notice(g_who[p], "判罚目标不能重复。");
            return;
        }
        if (w3 >= 2 && (w3 > 13 || w3 == w1 || w3 == w2)) {
            BOTC_Notice(g_who[p], "判罚目标不能重复。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_WardenResolve(p, w1, w2, w3);
        return;
    }
    // 【鹰身女妖（139）】依次选择第一名与第二名。
    if (r == 139) {
        w1 = g_skillT1[p];
        w2 = g_skillT2[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (w1 < 2 || w1 > 13 || w2 < 2 || w2 > 13 || w1 == w2) {
            BOTC_Notice(g_who[p], "鹰身女妖要选择两个不同的玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        BOTC_HarpyApplyPair(p, w1, w2);
        return;
    }

    // 【利维坦×守鸦人/贤者/农夫】相克选人：必须是存活善良玩家，且不能与上一夜相同（有别的选择时）。
    if (r == 127) {
        t = g_skillT1[p];
        if (t < 2 || t > 13 || !g_seatOn[t] || BOTC_SeatDead(t) || BOTC_SeatAlign(t) != 0) {
            BOTC_Notice(g_who[p], "利维坦要选一名存活的善良玩家。");
            return;
        }
        if (t == g_levTargetLast && g_levTargetLast >= 2) {
            n = 0;
            for (i = 2; i <= 13; i += 1) {
                if (i == t || !g_seatOn[i] || BOTC_SeatDead(i) || BOTC_SeatAlign(i) != 0) {
                    continue;
                }
                n = n + 1;
            }
            if (n > 0) {
                BOTC_Notice(g_who[p], "利维坦不能连续两夜选择同一名玩家，换一个。");
                return;
            }
        }
        BOTC_TellSkillChoice(p, -1);
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【利维坦×相克】利维坦中毒 / 醉酒 / 失去能力 → 今夜的选择没有触发目标能力。");
            return;
        }
        g_levTargetLast = t;
        BOTC_PmStore(g_teller, "【利维坦×相克】利维坦 " + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(t) + "。");
        BOTC_LeviathanJinxTrigger(t);
    }
    // 【道士（123）】：第二夜起选一名玩家；若选中恶魔，道士死亡，恶魔醉酒到黎明。
    if (r == 123) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【道士】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶：这次能力失效。");
            return;
        }
        if (BOTC_SeatTeam(t) == 3) {
            g_tokOn[(((g_teller * 14) + t) * 256) + 142] = true;
            BOTC_GrimRender(g_teller);
            BOTC_PmStore(g_teller, "【道士】" + BOTC_NameStr(p) + " 选中了恶魔 " + BOTC_NameStr(t) + " → 道士死亡，恶魔醉酒到黎明。");
            BOTC_MarkDeathQuietSrc(p, 1, 0, 123);
        }
        else {
            BOTC_PmStore(g_teller, "【道士】" + BOTC_NameStr(p) + " 选中了 " + BOTC_NameStr(t) + "，不是恶魔，无事发生。");
        }
        return;
    }

    // 【守夜人（128）】：每局一次，选一名玩家，让他得知施术者身份。
    if (r == 128) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一名玩家再确认。");
            return;
        }
        if (BOTC_ProtectTokOn(p, 147)) {
            BOTC_PmStore(g_teller, "【守夜人】这一局的一次性能力已经用过了。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_tokOn[(((g_teller * 14) + p) * 256) + 147] = true;
        BOTC_GrimRender(g_teller);
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【守夜人】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶：这次能力失效，目标不会收到任何信息；一次性机会已消耗。");
            return;
        }
        BOTC_PmInfo(g_who[t], "【信息】你得知" + BOTC_NameStr(p) + "是守夜人。");
        BOTC_PmStore(g_teller, "【守夜人】已告诉 " + BOTC_NameStr(t) + "：" + BOTC_NameStr(p) + " 是守夜人。");
        return;
    }
    // 【杂技演员（129）】：第 2 夜起选一名玩家；若目标当晚醉酒或中毒，且自己健康，则自己死亡。
    if (r == 129) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一名玩家再确认。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 156] = false;
        }
        g_tokOn[(((g_teller * 14) + t) * 256) + 156] = true;
        BOTC_GrimRender(g_teller);
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【杂技演员】" + BOTC_NameStr(p) + " 自己中毒/醉酒/提线木偶 → 能力失效，不会死亡（目标仍已打「被选择」）。");
            return;
        }
        if (BOTC_SeatImpaired(t)) {
            BOTC_PmStore(g_teller, "【杂技演员】" + BOTC_NameStr(t) + " 当晚醉酒/中毒 → " + BOTC_NameStr(p) + " 死亡。");
            BOTC_MarkDeathQuietSrc(p, 1, 0, 129);
            if (BOTC_SeatDead(p)) {
                g_tokOn[(((g_teller * 14) + p) * 256) + 157] = true;
                BOTC_GrimRender(g_teller);
            }
        }
        else {
            BOTC_PmStore(g_teller, "【杂技演员】" + BOTC_NameStr(p) + " 选择了清醒健康的 " + BOTC_NameStr(t) + "，没有死亡。");
        }
        return;
    }
    // 【寡妇（75）】（用户 2026-09-26）：看魔典 → 点一个目标 → **按【确认】才下毒**（这一刻才收回魔典 + 关面板）
    if (r == 75) {
        if (g_skillT1[p] < 2) {
            BOTC_Notice(g_who[p], "先点一个目标座位。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        BOTC_WidowPoison(g_skillT1[p]);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【说书人那一格】（用户 2026-09-21 报「确认按钮点不了」）：生死无常 / 镜像双子配对 / 心上人
    //   这几块面板开在**玩家 1** 身上，他在魔典上没有身份（r = -1）----
    //   说书人专用的这几步必须先走，不能让下面那句直接 return。
    if (g_who[p] == g_teller && g_hagKill) {
        BOTC_HagKill(1, g_skillT1[1], g_skillT2[1]);
        return;
    }
    if (g_who[p] == g_teller && g_sweetBySt) {
        if (g_skillT1[p] <= 0) {
            BOTC_Notice(g_who[p], "先选好目标再确认。");
            return;
        }
        g_sweetBySt = false;
        BOTC_SweetPickAt(g_skillT1[p]);
        // 【收面板】（用户 2026-09-21 报「点了确认关不掉」）：这些说书人专用分支提前 return，
        //   走不到函数结尾那句关闭 ---- 每条分支自己关一次
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (g_who[p] == g_teller && g_twinPick) {
        if (g_skillT1[p] <= 0) {
            BOTC_Notice(g_who[p], "先选好目标再确认。");
            return;
        }
        BOTC_TwinPickAt(g_skillT1[p]);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 哈迪寂亚（87）：选满 3 名玩家 → 公开播报 → 依次让他们选「活着 / 死亡」
    if (r == 87) {
        // 【中毒 / 醉酒适配】（用户 2026-09-26）：他中毒 / 酒鬼时能力完全无效 → 不播报、不弹面板、不改生死
        if (!BOTC_SkillWorks(p)) {
            g_skillPicking[p] = false;
            g_skillT1[p] = 0;
            g_skillT2[p] = 0;
            g_skillT3[p] = 0;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            BOTC_PmStore(g_teller, "【哈迪寂亚】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 能力无效：不播报、不改生死。");
            return;
        }
        if (g_skillT1[p] < 2 || g_skillT2[p] < 2 || g_skillT3[p] < 2) {
            BOTC_Notice(g_who[p], "哈迪寂亚要选满 3 名玩家。");
            return;
        }
        if (g_skillT1[p] == g_skillT2[p] || g_skillT1[p] == g_skillT3[p] || g_skillT2[p] == g_skillT3[p]) {
            BOTC_Notice(g_who[p], "三名玩家不能重复，重选一个。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        BOTC_HdStart(p, g_skillT1[p], g_skillT2[p], g_skillT3[p]);
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (r == 77) {
        t = g_skillT1[p];
        if (t < 2 || BOTC_SeatDead(t)) {
            BOTC_Notice(g_who[p], "要选一名存活的玩家。");
            return;
        }
        BOTC_TellSkillChoice(p, -1);
        g_tokOn[(((g_teller * 14) + p) * 256) + 98] = true;
        BOTC_GrimRender(g_teller);
        // 【中毒 / 醉酒适配】（用户 2026-09-26）：巡山人自己中毒 / 酒鬼 → 能力失效，落难少女不会变
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【巡山人】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 能力失效：他选的 " + BOTC_NameStr(t) + " 就算是落难少女也不会变。");
            g_skillPicking[p] = false;
            g_skillT1[p] = 0;
            g_skillT2[p] = 0;
            g_skillT3[p] = 0;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            return;
        }
        if (BOTC_HasAbility(t, 82)) {
            BOTC_RangerOpen(p, t);
        }
        else {
            BOTC_PmStore(g_teller, "【巡山人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "：不是落难少女，无事发生（这一次能力用掉了）。");
            g_skillPicking[p] = false;
            g_skillT1[p] = 0;
            g_skillT2[p] = 0;
            g_skillT3[p] = 0;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        }
        return;
    }
    if (r < 0 || r > 163) {
        return;
    }
    if (g_skillT1[p] <= 0) {
        BOTC_Notice(g_who[p], "先选好目标再确认。");
        return;
    }
    // 【心上人】（用户 2026-09-21）：这一步是说书人在自己面板上选人，跟角色能力无关
    if (g_sweetBySt && g_who[p] == g_teller) {
        g_sweetBySt = false;
        BOTC_SweetPickAt(g_skillT1[p]);
        return;
    }
    n = BOTC_TargetsOf(p);
    if (n >= 2 && g_skillT2[p] < 2) {
        BOTC_Notice(g_who[p], "这个角色要选两名玩家：第二个目标还没选。");
        return;
    }
    if (n >= 3 && g_skillT3[p] < 2) {
        BOTC_Notice(g_who[p], "这一夜你必须攻击 3 名玩家：三个目标都要选满。");
        return;
    }
    // 必须选活人的角色（水手 23 / 驱魔人 25 / 旅店老板 26 / 魔鬼代言人 40 / 刺客 41 / 月之子 36）：选到死人要他重选
    // 赌徒（27）不在此列：可以选择任何玩家，包括已死亡玩家（与内置百科文案一致）
    if (r == 23 || r == 25 || r == 26 || r == 40 || r == 41 || r == 36) {
        if (BOTC_SeatDead(g_skillT1[p])) {
            BOTC_Notice(g_who[p], "要选一个活着的人。");
            return;
        }
        if (r == 26 && g_skillT2[p] >= 2 && BOTC_SeatDead(g_skillT2[p])) {
            BOTC_Notice(g_who[p], "两个人里有一位已经死了，重选一个活人。");
            return;
        }
    }
    // 教授（30）：反过来 ---- 必须选一个**已经死了**的人；而且每局限一次
    if (r == 30) {
        if (g_profUsed[p]) {
            BOTC_Notice(g_who[p], "教授的复活一局只能用一次，你已经用过了。");
            return;
        }
    }
    // 驱魔人（25）：不能连续两夜点同一个人（场上没有别人可选时才放行）
    if (r == 25 && g_skillT1[p] == g_exoLast && g_exoLast >= 2) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (i == g_skillT1[p]) {
                continue;
            }
            if (!g_seatOn[i]) {
                continue;
            }
            if (BOTC_SeatDead(i)) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            BOTC_Notice(g_who[p], "驱魔人不能连续两夜点同一个人，换一个吧。");
            return;
        }
    }
    // 珀（46）的「攻击三次」（用户 2026-11-04）：三个人必须是三个不同的目标，可以选尸体；
    //   场上可选人数不足 3 个时按实际能选到的数量算。
    if (BOTC_TargetsOf(p) >= 3) {
        n = 0;
        BOTC_BuildSeatList();
        for (i = 0; i < g_seatN; i += 1) {
            if (g_seatList[i] == p) {
                continue;
            }
            n = n + 1;
        }
        if (n > 2) {
            if (g_skillT2[p] <= 0 || g_skillT3[p] <= 0 || g_skillT2[p] == g_skillT1[p] || g_skillT3[p] == g_skillT1[p] || g_skillT3[p] == g_skillT2[p]) {
                BOTC_Notice(g_who[p], "三个人必须是三个不同的人（这一夜要攻击 3 次）。");
                return;
            }
        }
    }
    if (BOTC_TargetsOf(p) >= 2) {      // 理发师交换时恶魔也要选两个目标（用户 2026-09-21）
        if (g_skillT2[p] <= 0 || g_skillT2[p] == g_skillT1[p]) {
            BOTC_Notice(g_who[p], "两个目标必须是两个不同的人。");
            return;
        }
    }
    // 【莽夫（37）】（用户 2026-09-20 / 2026-11-13）：这次确认的夜间目标里有没有莽夫。
    //   放在这里（角色分支之前）才能覆盖所有用夜间技能选人的角色；此前这段被移走后漏了，
    //   普通恶魔 / 刺客选莽夫都不会让他醉酒。莽夫自己「今夜只算第一个」的保护在 BOTC_GoonTouch 里。
    //   刺客那一路需要它：选莽夫 → 刺客醉酒，但 goonHit 仍让「刺杀莽夫」这一刀照常结算（莽夫死亡并转邪恶）。
    BOTC_GoonTouch(p, g_skillT1[p]);
    if (g_skillT2[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT2[p]);
    }
    if (g_skillT3[p] >= 2) {
        BOTC_GoonTouch(p, g_skillT3[p]);
    }
    BOTC_TellSkillChoice(p, g_skillRoleSel[p] - 1);
    s = BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(g_skillT1[p]);
    if (g_skillT2[p] >= 2) {
        s = s + " " + BOTC_NameStr(g_skillT2[p]);
    }
    if (g_skillT3[p] >= 2) {
        s = s + " " + BOTC_NameStr(g_skillT3[p]);
    }
    s = s + "。";
    BOTC_PmStore(g_teller, s);
    // 莽夫（37）：这次选的目标里有没有他 ---- ⚠ 疯子也要算（他也确实「选择」了一名玩家，用户 2026-09-20）。
    //   已经在上面（BOTC_TellSkillChoice 之前）统一调用过 BOTC_GoonTouch，这里不再重复；
    //   BOTC_GoonTouch 自己也有「今夜只算第一个」的保护。
    // ■ 疯子（38）：**他魔典上写的是「他以为自己是」的那只恶魔**，所以 r 会等于那只恶魔 ----
    //   必须放在所有真角色分支**之前**处理掉，处理完直接 return（否则会照着恶魔的分支真杀人）。
    //   用户 2026-09-20：他以为自己在杀人，其实不产生任何死亡，只打「被选择（疯子）」并把目标告诉真恶魔。
    if (BOTC_IsLunatic(p)) {
        t = g_skillT1[p];
        // 【多个疯子】（用户 2026-11-12）：不再整行清空「被选择（疯子）」，
        //   否则后行动的疯子会把先行动的疯子标记抹掉；天亮时统一清（见 BOTC_DawnReveal）。
        g_tokOn[(((g_teller * 14) + t) * 256) + 48] = true;
        s = BOTC_NameStr(t);
        if (g_skillT2[p] >= 2) {
            g_tokOn[(((g_teller * 14) + g_skillT2[p]) * 256) + 48] = true;
            s = s + "、" + BOTC_NameStr(g_skillT2[p]);
        }
        if (g_skillT3[p] >= 2) {
            g_tokOn[(((g_teller * 14) + g_skillT3[p]) * 256) + 48] = true;
            s = s + "、" + BOTC_NameStr(g_skillT3[p]);
        }
        // 他以为自己是珀（46）时，「攻击三次」那一夜打完要把标记撤掉（用户 2026-09-20：不然一直卡在 3 刀）
        if (BOTC_ProtectTokOn(p, 52)) {
            g_tokOn[(((g_teller * 14) + p) * 256) + 52] = false;
        }
        // 【相克规则：疯子 × 数学家】（用户 2026-09-21）：先记下他这个假刀的目标，两边都记到之后再判
        if (BOTC_SkillWorks(p)) {
            g_lunTar = t;
            g_lunSeat = p;
            g_lunActed = true;
            BOTC_MalfLunCheck();
        }
        BOTC_GrimRender(g_teller);
        // 【告诉真恶魔「疯子今晚『杀』的是谁」】（用户 2026-09-20；2026-11-13 改为确认后立即告知）
        //   · 目标 1 / 2 / 3 全报（疯子以为自己是珀、带「攻击三次」那一夜就报三个）；
        //   · 哲学家假装的疯子（带「是哲学家」token）照样报，名字就是他本人，后面加一句说明；
        //   · 疯子中毒 / 酒鬼 → 什么都**不发**（用户 2026-09-21 定的口径），只给说书人记一行；
        //   · 用户 2026-11-13：选完确认后立即私聊所有真恶魔，不再延迟。
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次没有发送给恶魔；他实际选择了 " + s + "，这条别外传。");
        }
        else {
            lus = "";
            if (BOTC_ProtectTokOn(p, 70) || BOTC_ProtectTokOn(p, 97)) {
                lus = "（哲学家假装的疯子）";
            }
            n2 = 0;
            for (i = 2; i <= 13; i += 1) {
                if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                    n2 = i;
                }
            }
            if (n2 >= 2) {
                BOTC_LunPickQueue(s, p, g_cannLun[p]);
                BOTC_PmStore(g_teller, "【疯子】已记录疯子选择了" + s + lus + "，并直接私聊告知了恶魔。");
            }
            else {
                BOTC_PmStore(g_teller, "【疯子】疯子选择了" + s + "，但场上没有真恶魔 → 这条信息不会发出去。");
            }
        }
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    g_skillPicking[p] = false;
    // 【炼金术士 × 间谍/寡妇】：猜中后的下一夜，恶魔必须选那个间谍/寡妇 —— 卡【确认】不卡选人；多刀只看目标里有没有他
    if (g_alcGuess >= 2 && g_alcDay == g_nightNum && r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
        if (!BOTC_SeatDead(g_alcBy) && BOTC_AbilityWorks(g_alcBy, 95)) {
            if (g_skillT1[p] != g_alcGuess && g_skillT2[p] != g_alcGuess && g_skillT3[p] != g_alcGuess) {
                BOTC_Notice(g_who[p], "炼金术士猜测正确，你今晚必须选择" + IntToString(g_alcGuess - 1) + BOTC_NameStr(g_alcGuess));
                return;
            }
        }
    }
    // ■ 痢蛭（100）（用户 2026-10-03）：**首夜**他自己选一名存活玩家当宿主（打「中毒（痢蛭）120」+ 自己获得「不会死亡122」）；
    //   第二夜起按恶魔刀杀人。
    //   【用户 2026-11-13 按官方标记口径重写】首夜无论自己是否中毒 / 醉酒、也无论宿主能不能
    //   真的中毒，都照样把「中毒（痢蛭）」120 放到被选中的玩家身上；无效时它等同「倒转放置」
    //   的提示标记，只记录「该玩家被痢蛭选择过」—— 因为痢蛭恢复清醒健康后，这名玩家仍然
    //   会成为宿主。120 只在痢蛭死亡 / 离场时移除（BOTC_LleechPoisonClear）。
    if (r == 100) {
        t = g_skillT1[p];
        // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：失去能力之后，面板照弹，但选人 / 出刀一律不生效
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 18]) {
            BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(p) + " 已经失去能力（相克 · 痢蛭 × 主谋）→ 这一次不生效。");
            g_skillPicking[p] = false;
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
            return;
        }
        if (BOTC_LleechHostMode(p)) {
            // 【疯子假痢蛭】（用户 2026-11-12）：认知身份不放置 120 / 122 标记
            if (BOTC_SeatTrueRole(p) == 38) {
                BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(p) + " 是疯子以为自己是痢蛭 → 这次不放置「中毒（痢蛭）」/「不会死亡」。");
            }
            else {
                if (t >= 2 && t <= 13 && !BOTC_SeatDead(t)) {
                    for (i = 2; i <= 13; i += 1) {
                        g_tokOn[(((g_teller * 14) + i) * 256) + 120] = false;   // 旧宿主先收回，避免同时存在两个宿主
                    }
                    g_tokOn[(((g_teller * 14) + t) * 256) + 120] = true;      // 中毒（痢蛭）：宿主（无效时等同倒转放置）
                    g_tokOn[(((g_teller * 14) + p) * 256) + 122] = true;      // 不会死亡（痢蛭）：宿主活着他不会死
                    g_lleechHost = t;
                    BOTC_GrimRender(g_teller);
                    if (BOTC_ActingIsFirstNight(p)) {
                        BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(p) + " 首夜选了 " + BOTC_NameStr(t) + " 当宿主（他自己暂时不会死亡）。");
                    }
                    else {
                        // 【中途被创造的痢蛭】（用户 2026-11-13，官方「进场能力」口径）：
                        //   一进场就先补选宿主，这一夜不再额外刀人。
                        BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(p) + " 是中途成为痢蛭的（此前没有宿主）→ 按进场能力先选宿主：" + BOTC_NameStr(t) + "（他自己暂时不会死亡）。");
                    }
                    if (!BOTC_SkillWorks(p)) {
                        BOTC_PmStore(g_teller, "【痢蛭】他这次中毒 / 酒鬼 → 「中毒（痢蛭）」按倒转口径放置：现在没有任何效果；他恢复清醒健康后，" + BOTC_NameStr(t) + " 仍然会成为宿主。");
                    }
                    else {
                        if (BOTC_SeatRealRole(t) == 11 || BOTC_SeatRealRole(t) == 37) {
                            BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(t) + " 是士兵 / 莽夫 → 不会因痢蛭而中毒，「中毒（痢蛭）」按倒转口径放置（没有效果）；但" + BOTC_NameStr(t) + " 死亡时痢蛭仍会跟着死亡。");
                        }
                    }
                }
            }
        }
        else {
            if (!BOTC_SkillWorks(p)) {
                BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一刀无效。");
            }
            else {
                BOTC_DemonStrike(p, 100, t, false);
            }
        }
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // ■ 恐惧之灵（102）（用户 2026-10-03）：每夜选一名玩家；**首次选择 / 更换目标时全场都知道**。
    //   （"你提名他且他被处决 → 他的阵营落败" 已经接在处决那边：BOTC_ExecToggleAt 最前面一段，用户 2026-10-04）
    if (r == 102) {
        t = g_skillT1[p];
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效（不记目标、不播报）。");
        }
        else {
            if (g_fearTarget != t) {
                BOTC_FearClear("换了目标");          // 官网：换目标后移除旧的「恐惧」
                g_fearTarget = t;
                if (t >= 2 && t <= 13) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + 121] = true;   // 官网：放到他选中的那个玩家的角色标记旁
                    BOTC_GrimRender(g_teller);
                }
                g_fearPending = true;      // 换了新目标：等白天再公开播报（用户 2026-10-03）
                BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(t) + "。");
            }
            else {
                BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(p) + " 又选了 " + BOTC_NameStr(t) + "（目标没变，不重复播报）。");
            }
        }
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // ===== 【何方教众（板子 9）· 新角色的技能结算】（用户 2026-10-10）=====
    // ■ 传教士（103）：选中一名玩家 → 他是爪牙（按登记层）就失去能力
    if (r == 103) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 中毒/酒鬼：没打标记。");
            return;
        }
        // 【只有「爪牙」才打这枚标记】（用户 2026-10-14 修）：原来这一行在 if 上面、**无条件**打 ----
        //   选中镇民 / 外来者也会给他挂上「失去能力（传教士）125」，而唤醒那边只认这枚 token，
        //   于是那名玩家**永远醒不过来**（官方口径：选中的不是爪牙 → 无事发生，见 g_tipLine[1994]）。
        // 【传教士 × 间谍 / 陌客能力者】（用户 2026-11-12）：不再按伪装自动判定，改弹说书人。
        if (BOTC_IsDisguiseAbility(t)) {
            BOTC_JudgeAsk(14, "【传教士】" + BOTC_NameStr(p) + " 选中了间谍 / 陌客能力者 " + BOTC_NameStr(t) + "：这次是否按爪牙处理并让他失去能力？", p, t, 0);
            BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 选中了 " + BOTC_NameStr(t) + "：对方是间谍 / 陌客能力者，请选择是否按爪牙处理。");
            return;
        }
        if (BOTC_PairTeam(g_teller, t) == 2) {   // 【说书人视角】（用户 2026-10-11：原来写死观察者 1）
            g_tokOn[(((g_teller * 14) + t) * 256) + 125] = true;
            BOTC_GrimRender(g_teller);
            if (BOTC_HasAbility(t, 141)) {
                BOTC_PmInfo(g_who[t], "【维齐尔×传教士相克】你被传教士选中：失去能力，但白天仍然不会死亡。");
                BOTC_PmStore(g_teller, "【维齐尔×传教士相克】" + BOTC_NameStr(t) + " 失去能力并得知此事；白天免死仍保留。");
                BOTC_VizierSync();
            }
            else {
                BOTC_PmInfo(g_who[t], "【信息】你被传教士选中了：能力失效。");
                BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 选中爪牙 " + BOTC_NameStr(t) + "：失去能力。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "（" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(t)) + "）：不是爪牙 → 无事发生（没有打标记）。");
        }
        return;
    }
    // ■ 村夫（105）：选中一名玩家 → 弹说书人答题框（善良 / 邪恶），填完私聊发给他
    if (r == 105) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【村夫】" + BOTC_NameStr(p) + " 中毒/酒鬼：随便给。");
        }
        BOTC_ManInfoOpen(p, 105, BOTC_NameStr(t));
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉（跟将军同一个做法）
        g_grimOn[g_who[p]] = false;
        return;
    }
    // ■ 半兽人（107）：选中一名存活玩家；他是善良 → 他死（夜间·非恶魔杀）且今晚恶魔不造成死亡
    if (r == 107) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 中毒 / 醉酒 / 酒鬼 / 提线木偶：能力失效 → 不杀人，恶魔正常出刀。");
            return;
        }
        if (!g_seatOn[t] || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 不是存活玩家，无事发生。");
            return;
        }
        // 【陌客 / 间谍 · 说书人判定】（用户 2026-11-11）：目标真身是陌客（15）/ 间谍（18）时登记阵营
        //   由说书人定 → 弹窗问「这次是否击杀」；其余目标直接按登记层自动结算 ----
        //   目标登记成善良 → 他死（夜间·非恶魔杀）且今晚恶魔不造成死亡；登记成邪恶 → 不杀，恶魔正常出刀。
        if (BOTC_IsDisguiseAbility(t)) {
            BOTC_LycanAsk(p, t);
            return;
        }
        BOTC_LycanResolve(p, t, BOTC_SeatRegAlign(t) == 0);
        return;
    }
    // ■ 解谜大师（109）：每局限一次，猜「谁是那个醉酒的人」→ 猜对给真恶魔，猜错弹框让说书人给假信息
    if (r == 109) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 中毒/酒鬼：这次不生效。");
            return;
        }
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 130]) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 这一局已经猜过了。");
            return;
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 130] = true;      // 「已猜测」：放他自己身上
        n = 0;                                                   // 那个醉酒的人在哪一格
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 129]) {
                n = i;
            }
        }
        BOTC_GrimRender(g_teller);
        if (n == t) {
            n2 = 0;                                              // 找一个活着的恶魔
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
                if (BOTC_SeatTeam(i) == 3) { n2 = i; }
            }
            if (n2 >= 2) {
                // 【猜中 · 只发编号】（用户 2026-11-07）：和错误信息统一成「你得知「N」」，
                //   不再拼「[N]某某是恶魔」。
                BOTC_PmInfo(g_who[p], "【信息】你得知" + IntToString(g_lab[n2]));
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜中：已告诉他恶魔的座位号 " + IntToString(g_lab[n2]) + "。");
            }
            else {
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜对，但没有活着的恶魔。");
            }
        }
        else {
            BOTC_ManInfoOpen(p, 109, "他猜的是 " + BOTC_NameStr(t) + "（猜错了）→ 填一条**错误**信息给他");
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉
            g_grimOn[g_who[p]] = false;
        }
        return;
    }
    // ■ 堤丰之首（111）/ 小怪宝（112）：恶魔刀（走通用的恶魔那一套：保护 / 士兵 / 免死都算）
    if (r == 111 || r == 112) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        BOTC_DemonStrike(p, r, t, false);
        return;
    }
    if (r == 7) {
        // 僧侣：打「保护」标记，并记下今晚保护的是谁（天亮清标记、结算抗刀）
        //   被保护的人不会收到任何提示（规则如此）：标记只有说书人那份魔典上看得到
        if (!BOTC_SkillWorks(p)) {
            // 僧侣自己中毒 / 酒鬼：技能失效 ---- 连「保护」标记都不打，被保护的人也就没有。
            //   本人不当场知道（他以为自己保护成功了），只私聊告诉说书人
            BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次保护无效，没有打标记。");
        }
        else {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 9] = true;
            g_nightMonk = g_skillT1[p];
            g_nightMonkFrom = p;
            g_monkA = g_skillT1[p];
            g_monkNight = g_nightNum;
        }
    }
    if (r == 17) {
        // 投毒者：打「中毒」标记 ---- 智能说书判定读的就是这个标记，被毒的人以后去查别人得到的都是错的
        //   （不是别人看他出错）；中毒的人功能技能会失效，但夜里照常被唤醒
        if (!BOTC_SkillWorks(p)) {
            // 投毒者自己中毒 / 酒鬼 / 提线木偶：这一晚的毒无效（本人不当场知道，只私聊告诉说书人）
            BOTC_PmStore(g_teller, "【夜间】投毒者（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次投毒无效，没有打标记。");
        }
        else {
            // 换了目标：只收回**这名投毒者自己**上一次毒的人（同一个人只刷新，不重复清）；
            //   其他拥有投毒者能力的角色（炼金术士借毒等）各自那份毒保持不动。
            if (g_poisonAt[p] >= 2 && g_poisonAt[p] != g_skillT1[p]) {
                BOTC_PoisonClearSource(p, "投毒者换了目标");
            }
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 7] = true;
            g_poisonAt[p] = g_skillT1[p];
            g_poisonDayBy[p] = g_dayNum;
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(g_skillT1[p]) + " 中毒（投毒者：" + BOTC_NameStr(p) + "）。");
            BOTC_BartenderSync();
        }
    }
    if (r == 13) {
        // 管家：记下今晚的主人 ---- 明天提名阶段主人先投了「有罪票」，管家才能投有罪票
        //   （用户 2026-09-19）顺手把「主人」token 挪到新主人身上：先清掉上一次那位
        if (g_butlerMaster >= 2) {
            g_tokOn[(((g_teller * 14) + g_butlerMaster) * 256) + 20] = false;
        }
        g_butlerSeat = p;
        g_butlerMaster = g_skillT1[p];
        if (!BOTC_SkillWorks(p)) {
            // 中毒 / 酒鬼：技能失效（本人不当场知道），明天他可以随便投
            BOTC_PmStore(g_teller, "【夜间】管家（" + BOTC_NameStr(p) + "）中毒/酒鬼，这一次指定主人无效，明天他可以自由投票。");
        }
        else {
            g_tokOn[(((g_teller * 14) + g_butlerMaster) * 256) + 20] = true;      // 自动在主人身上打「主人」标记（说书人那份）
            BOTC_GrimRender(g_teller);
            BOTC_PmStore(g_teller, "【夜间】管家 " + BOTC_NameStr(p) + " 的主人是 " + BOTC_NameStr(g_butlerMaster) + "。");
        }
        BOTC_PmInfo(g_who[p], "【信息】你今晚的主人是 " + BOTC_NameStr(g_butlerMaster) + "：明天他投有罪票，你才能投有罪票，否则只能弃权。");
    }
    // ■ 水手（23）：谁醉由说书人点（【二选一醉酒】面板，用户 2026-10-16）----
    //   左边 = 水手他自己，右边 = 他选的那名玩家；点哪个哪个醉到下一个黄昏。
    //   【能力失效】（用户 2026-11-12 统一口径）：中毒 / 酒鬼 / 提线木偶 → 不弹面板、不放置醉酒标记。
    if (r == 23) {
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【水手】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶：这一次能力失效，没有放置醉酒标记。");
        }
        else {
            t = g_skillT1[p];
            BOTC_DrunkPickOpen(0, p, p, t);
        }
    }
    // ■ 侍女（24）：报「这两个人里有几个当晚因为自己的技能被唤醒」。
    //   说书人那份永远收到正确答案；智能说书直接把答案发给本人（中毒 / 酒鬼就报个错的）。
    if (r == 24) {
        n = 0;
        if (g_wokeTonight[g_skillT1[p]]) {
            n = n + 1;
        }
        if (g_wokeTonight[g_skillT2[p]]) {
            n = n + 1;
        }
        BOTC_PmStore(g_teller, "【侍女】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + " 和 " + BOTC_NameStr(g_skillT2[p]) + " → 正确答案：" + IntToString(n) + " 人。");
        BOTC_ManInfoOpen(p, 24, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
    // ■ 梦殒春宵（板子 3）：选完人之后要用答题框给信息的角色（用户 2026-09-21）
//   筑梦师（48）→ 自动配一对角色；女裁缝（55）→ 问「是不是同一阵营」
if (r == 48) {
    BOTC_ManInfoDreamer(p, g_skillT1[p]);
}
if (r == 116) {
    BOTC_PmStore(g_teller, "【郎中】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + "：给他一个跟那个角色能力相关的词语（2~4 个字）。");
    BOTC_ManInfoOpen(p, 806, BOTC_NameStr(g_skillT1[p]));
}
if (r == 55) {
    if (BOTC_ProtectTokOn(p, 68)) {
        BOTC_PmStore(g_teller, "【女裁缝】" + BOTC_NameStr(p) + " 这一局已经用过了。");
    }
    else {
        g_tokOn[(((g_teller * 14) + p) * 256) + 68] = true;      // 失去能力（女裁缝）：用过就记上
        BOTC_GrimRender(g_teller);
        BOTC_ManInfoOpen(p, 55, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
}
// ■ 舞蛇人（49）：选到真恶魔 → 两人交换角色与阵营，原恶魔永久中毒（用户 2026-09-21）
if (r == 49) {
    t = g_skillT1[p];
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次能力失效，没有交换。");
    }
    else {
        if (t < 2 || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选的目标无效（死了或没座位）。");
        }
        else {
            rt = BOTC_SeatTrueRole(t);
            // 【带小怪宝的人：交换的是他**那只爪牙**的身份，不是小怪宝本身】（用户 2026-10-14 两次更正）----
            //   · 小怪宝不是「会被发到座位上的角色」（除非疯子以为自己是它），所以绝不能把 112 写进座位；
            //   · 带着「是恶魔（小怪宝）134」的那一格，真身被 SeatTrueRole 读成 112，可交换要换的是他**原本那只爪牙**
            //     （魔典上写的那只）→ 这里改读 g_mark；
            //   · 换完之后由新恶魔（原舞蛇人）接手照看小怪宝：134 挪过去、g_lmSeat 也跟着改。
            nr = rt;
            snakeOk = true;
            snakeLm = false;
            if (g_lmOn && g_tokOn[(((g_teller * 14) + t) * 256) + 134]) {
                nr = g_mark[(g_teller * 14) + t] - 1;
                snakeLm = true;
                if (nr < 0 || nr > 163 || nr == 112) {
                    snakeOk = false;
                    BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "（他在照看小怪宝）：魔典上读不出他本来的爪牙身份 → 这一次没有交换。");
                }
            }
            // 【带宝的那位就是「恶魔」，不用再看他的角色队】（用户 2026-10-14 报「不是恶魔，无事发生」）----
            //   他的真身份是本来的**爪牙**（team 2），恶魔身份是靠 134 来的；所以这里必须跳过队判。
            if (snakeOk && !snakeLm && (nr < 0 || nr > 163 || BOTC_RoleTeam(nr) != 3)) {
                snakeOk = false;
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "：不是恶魔，无事发生。");
            }
            if (snakeOk) {
                // 【认知覆盖整包】（用户 2026-10-19）：两人「以为的身份 / 那枚 token」先记下来
                cogP = BOTC_CogTokOf(BOTC_SeatTrueRole(p));
                cogT = BOTC_CogTokOf(rt);
                cardP = g_mark[(g_teller * 14) + p] - 1;
                cardT = g_mark[(g_teller * 14) + t] - 1;
                // 【换给恶魔的角色 = 选人这位的真身】（用户 2026-10-12 修）：
                //   原来这里写死 49（舞蛇人）---- 可是这个能力可能是**哲学家(56) 借来的**
                //   （g_mark 显示成舞蛇人、真身仍是哲学家，BOTC_SeatTrueRole 会按"是哲学家"token 回 56），
                //   那种情况下原恶魔该变成**中毒的哲学家**，不该变成舞蛇人。
                nrP = BOTC_SeatTrueRole(p);
                if (nrP == 112) {
                    nrP = g_mark[(g_teller * 14) + p] - 1;     // 【舞蛇人自己带着小怪宝】（用户 2026-10-14）：同样忽略 134 那层
                }
                if (nrP < 0 || nrP > 163 || nrP == rt) {
                    nrP = 49;             // 兜底：真身读不出来（或跟恶魔同一个角色）时，退回原来的舞蛇人
                }
                // 【阵营检测】（用户 2026-10-02）：舞蛇人换恶魔 = 两人**交换阵营**。
                //   先记下交换前各自的阵营，换完按「对方原来的阵营」钉回来；
                //   两人阵营一样时（比如邪恶的舞蛇人换邪恶的恶魔）等于没换，谁都不动。
                alP = BOTC_SeatAlign(p);
                alT = BOTC_SeatAlign(t);
                BOTC_SetSeatRole(g_teller, p, nr);
                BOTC_SetSeatRole(g_who[p], p, nr);
                BOTC_SetSeatRole(g_teller, t, nrP);
                BOTC_SetSeatRole(g_who[t], t, nrP);
                // 【认知覆盖整包跟着换】（用户 2026-10-19）
                if (cogT >= 0) {
                    BOTC_PutCogCover(p, cardT, cogT);
                }
                if (cogP >= 0) {
                    BOTC_PutCogCover(t, cardP, cogP);
                }
                // 先把两人身上旧的「善良(14) / 邪恶(15)」标记撤掉，再按交换后的结果重新钉
                g_tokOn[(((g_teller * 14) + p) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + p) * 256) + 15] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 15] = false;
                // 新恶魔（原舞蛇人）拿原恶魔的阵营；新舞蛇人（原恶魔）拿原舞蛇人的阵营。
                //   只有「新身份自带的阵营」跟要钉的不一样时才打 token（一样就不用打）
                if (BOTC_RoleAlign(nr) != alT) {
                    g_tokOn[(((g_teller * 14) + p) * 256) + (14 + alT)] = true;
                }
                if (BOTC_RoleAlign(nrP) != alP) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + (14 + alP)] = true;
                }
                BOTC_PairClearSeat(p);         // 阵营刚变 → 登记层缓存作废
                BOTC_PairClearSeat(t);
                g_tokOn[(((g_teller * 14) + t) * 256) + 85] = true;
                g_tokOn[(((g_teller * 14) + p) * 256) + 13] = true;
                // 【小怪宝跟着「现在的恶魔」走】（用户 2026-10-14）：换的是身份，照看权也跟着换 ----
                //   134 挪到新恶魔（原舞蛇人）身上、g_lmSeat 指向他；不然那一格还带着 134，会被继续当成恶魔（阵营 / 胜负都会错）。
                if (snakeLm) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + 134] = false;
                    g_tokOn[(((g_teller * 14) + p) * 256) + 134] = true;
                    g_lmSeat = p;
                }
                g_autoWoke[p] = false;         // 新恶魔：当晚还要按恶魔那一格被唤醒
                g_testWoke[p] = false;
                g_autoWoke[t] = true;          // 原恶魔（现在换到的那个角色）：当晚到此为止，不再行动
                g_testWoke[t] = true;
                BOTC_GrimRender(g_teller);
                BOTC_GrimRender(g_who[p]);
                BOTC_GrimRender(g_who[t]);
                // 【统一身份转变提示】（用户 2026-10-01）：两人都走同一个函数（顺带写说书人日志）
                //   【认知覆盖】（用户 2026-10-19）：对方只说「他以为的身份」，不说酒鬼 / 提线木偶本体
                if (cogT >= 0) {
                    BOTC_ChangeRoleMsg(p, cardT);
                }
                else {
                    BOTC_ChangeRoleMsg(p, nr);
                }
                if (cogP >= 0) {
                    BOTC_ChangeRoleMsg(t, cardP);
                }
                else {
                    BOTC_ChangeRoleMsg(t, nrP);
                }
                if (cogP >= 0) {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[cardP] + "（永久中毒）。");
                }
                else {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[nrP] + "（永久中毒）。");
                }
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 和 " + BOTC_NameStr(t) + " 交换了角色与阵营：" + BOTC_NameStr(p) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(p)) + g_roleName[nr] + "，" + BOTC_NameStr(t) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(t)) + g_roleName[nrP] + "并永久中毒。");
            }
        }
    }
}
// ■ 驱魔人（25）：点名一名玩家。点中恶魔 → 恶魔当晚不会因其自身能力被唤醒，并得知点名他的是驱魔人。
    //   判定**只认真身**（用户 2026-09-20）；点名不能与上一夜重复。
    if (r == 25) {
        t = g_skillT1[p];
        g_exoLast = t;
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】驱魔人（" + BOTC_NameStr(p) + "）中毒/酒鬼，这一次点名无效。");
        }
        else {
            // 相克记录：驱魔人昨晚实际选择的玩家，不论他是不是恶魔。
            g_exoJinxSeat = t;
            g_exoJinxNight = g_nightNum;
            // 【驱魔人 × 陌客能力者】（用户 2026-11-12）：不再按伪装自动判定，改弹说书人。
            if (BOTC_IsDisguiseAbility(t)) {
                BOTC_JudgeAsk(13, "【驱魔人】" + BOTC_NameStr(p) + " 点名了间谍 / 陌客能力者 " + BOTC_NameStr(t) + "：这次是否按恶魔处理？", p, t, 0);
                BOTC_PmStore(g_teller, "【驱魔人】" + BOTC_NameStr(p) + " 点名了 " + BOTC_NameStr(t) + "：对方是间谍 / 陌客能力者，请选择是否按恶魔处理。");
                return;
            }
            if (BOTC_RegIsDemon(t)) {                 // 按「互动干扰」后的登记算（用户 2026-09-20）
                for (i = 2; i <= 13; i += 1) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 31] = false;     // 旧的「被点名」先全清掉
                }
                g_tokOn[(((g_teller * 14) + t) * 256) + 31] = true;
                g_exoBlock = t;
                g_exoNight = g_nightNum;
                g_exoFrom = p;
                BOTC_GrimRender(g_teller);
                BOTC_PmInfo(g_who[t], "【信息】你被驱魔人选中了。");
                if (BOTC_SeatTrueRole(t) == 44) {
                    BOTC_PukkaExorcistResolve(t);
                }
            }
            else {
                BOTC_PmStore(g_teller, "【驱魔人】" + BOTC_NameStr(p) + " 点名了 " + BOTC_NameStr(t) + "（" + BOTC_RoleNameSafe(BOTC_RegRoleOf(t)) + "）---- 不是恶魔，没有效果。");
            }
        }
    }
    // ■ 旅店老板（26）：两名目标今晚不会死亡；其中一人醉酒到下一个黄昏。
    //   谁醉由说书人点（【二选一醉酒】面板，用户 2026-10-16）；原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
    //   【中毒 / 醉酒时整条能力失效】（用户 2026-11-03）：不保护、不打醉酒标记，也不再弹选择窗。
    if (r == 26) {
        if (BOTC_SkillWorks(p)) {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 25] = true;
            g_tokOn[(((g_teller * 14) + g_skillT2[p]) * 256) + 25] = true;
            g_innA = g_skillT1[p];
            g_innB = g_skillT2[p];
            g_innNight = g_nightNum;
            g_drunkFrom = p;
            BOTC_GrimRender(g_teller);
            BOTC_DrunkPickOpen(1, p, g_skillT1[p], g_skillT2[p]);
        }
        else {
            BOTC_PmStore(g_teller, "【旅店老板】" + BOTC_NameStr(p) + " 中毒/醉酒，这一次能力无效：不保护、也不放醉酒标记。");
        }
    }
    // ■ 混沌（121）（用户 2026-10-16）：跟其它恶魔一样刀人；杀了「离他最近的两名镇民之一」→ 除旅行者外的全体善良中毒到下个黄昏。
    if (r == 121) {
        BOTC_DemonStrike(p, 121, g_skillT1[p], false);
        BOTC_HunDunCheck(p, g_skillT1[p]);
    }
    // ■ 逆臣（119）（用户 2026-10-16）：首夜选一名其他玩家 → 打「不共戴天」；谁先死于处决，另一方当晚转邪恶。
    if (r == 119) {
        t = g_skillT1[p];
        // 【逆臣 · 能力失效】（用户 2026-11-11）：中毒 / 酒鬼 / 提线木偶 → 不放置「不共戴天」标记。
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【逆臣】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶：能力失效，未放置「不共戴天」。");
        }
        else {
            if (t >= 2 && t <= 13) {
                g_tcSeat = p;
                g_tokOn[(((g_teller * 14) + t) * 256) + 139] = true;
                BOTC_GrimRender(g_teller);
            }
        }
    }
    // 玩家 + 角色组合技能：角色已经在同一面板中预选，确认后才结算。
    if (BOTC_ComboRole(r)) {
        BOTC_ComboResolve(p);
        return;
    }
    // ■ 教授（30）：复活一名已死亡的镇民（走现成的「复活」通道，复活后恢复一次性能力）。
    if (r == 30) {
        BOTC_ProfessorResolve(p, g_skillT1[p]);
    }
    // ■ 教父（39）：今天有外来者死亡时，当晚可以杀一个人（死因打「死亡（教父）」，不算恶魔杀）
    if (r == 39) {
        t = g_skillT1[p];
        // 【教父也吃这一条】（用户 2026-10-13）：中毒 / 酒鬼 / 提线木偶 → 这一刀不生效
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效，没有记死亡。");
        }
        else {
            if (BOTC_GodfatherCanKill()) {
                BOTC_PmStore(g_teller, "【教父】今天有外来者死亡 → " + BOTC_NameStr(p) + " 可以动手。");
            }
            else {
                BOTC_PmStore(g_teller, "【提示】今天没有外来者死亡，按规则教父今晚不能杀人 ---- 你仍可以照记。");
            }
            BOTC_MarkDeathQuietSrc(t, 1, 0, 39);
        }
    }
    // ■ 魔鬼代言人（40）：选一名活人（不能连续两夜点同一个）→ 打「处决不死（魔鬼代言人）」token(27)，
    //   他明天被处决不会死（处决那边只提示、不硬拦 ---- 说书人是最终裁定者）。本人不被告知。
    if (r == 40) {
        t = g_skillT1[p];
        if (t == g_devAdvLast) {
            BOTC_Notice(g_who[p], "魔鬼代言人不能连续两夜点同一个人，换一个吧。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】魔鬼代言人（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次没有打「处决不死」标记。");
        }
        else {
            for (i = 2; i <= 13; i += 1) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 27] = false;      // 只保一个人：旧的先全清
            }
            g_tokOn[(((g_teller * 14) + t) * 256) + 27] = true;
            BOTC_GrimRender(g_teller);
        }
        g_devAdvLast = t;
    }
    // ■ 刺客（41）：每局限一次，选一名活人 → **直接死，无视一切保护**（用户 2026-09-20 定）。
    //   死因「死亡（刺客）」且**不算恶魔杀**（不触发祖母联动、不触发小恶魔传位）。
    if (r == 41) {
        t = g_skillT1[p];
        if (g_assiUsed[p]) {
            BOTC_Notice(g_who[p], "刺客的刺杀一局只能用一次，你已经用过了。");
            return;
        }
        g_assiUsed[p] = true;
        g_tokOn[(((g_teller * 14) + p) * 256) + 45] = true;             // 失去能力（刺客）
        BOTC_SkillBtnRender();
        // 【刺客 × 莽夫】（用户 2026-09-20）：刺客今夜第一个选中莽夫时，莽夫的醉酒**不挡这一刀** ----
        //   莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营就固定在邪恶。
        goonHit = (BOTC_HasAbility(t, 37) && g_goonBy == p);
        if (!BOTC_SkillWorks(p) && !goonHit) {
        }
        else {
            s = "";
            if (BOTC_ProtectTokOn(t, 9)) { s = s + "保护（僧侣） "; }
            if (BOTC_ProtectTokOn(t, 25)) { s = s + "不会死亡（旅店老板） "; }
            if (BOTC_ProtectTokOn(t, 26)) { s = s + "不会死亡（水手） "; }
            if (BOTC_ProtectTokOn(t, 27)) { s = s + "处决不死（魔鬼代言人） "; }
            if (BOTC_ProtectTokOn(t, 28)) { s = s + "处决不死（和平主义者） "; }
            if (BOTC_ProtectTokOn(t, 29)) { s = s + "首次未死（弄臣） "; }
            if (BOTC_ProtectTokOn(t, 51)) { s = s + "不会死亡（茶艺师） "; }
            if (BOTC_AbilityWorks(t, 23)) { s = s + "水手·清醒 "; }
            if (BOTC_AbilityWorks(t, 11)) { s = s + "士兵 "; }
            if (BOTC_AbilityWorks(t, 12)) { s = s + "镇长 "; }
            if (BOTC_AbilityWorks(t, 34)) { s = s + "弄臣 "; }
            if (s == "") {
                s = "（他身上本来没有保护）";
            }
            BOTC_PmStore(g_teller, "【刺客】" + BOTC_NameStr(p) + " 刺杀了 " + BOTC_NameStr(t) + " → 直接死亡，**无视一切保护**：" + s + "。");
            BOTC_MarkDeathQuietSrc(t, 1, 0, 41);
            if (goonHit) {
                BOTC_PmStore(g_teller, "【刺客 × 莽夫】刺客是今夜第一个选中莽夫的人 → 莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营**固定为邪恶**。");
            }
        }
    }
    // ■ 卡扎力（135）：除首夜外，每个夜晚选择一名玩家死亡
    if (r == 135) {
        BOTC_DemonStrike(p, 135, g_skillT1[p], false);
    }
    // ■ 僵怖（43）：今天没人死的夜晚才能动手（能不能唤醒已经在 BOTC_CanWakeAt 拦过了）
    if (r == 43) {
        BOTC_DemonStrike(p, 43, g_skillT1[p], false);
    }
    // ■ 普卡（44）：先把上一次的毒结算掉，再毒新的人
    if (r == 44) {
        BOTC_PukkaResolve(p, g_skillT1[p]);
    }
    // ■ 沙巴洛斯（45）：先反刍，再吃两个人
    if (r == 45) {
        BOTC_SabalosResolve(p, g_skillT1[p], g_skillT2[p]);
    }
    // ■ 珀（46）：平时 1 个目标；带「攻击三次（珀）」时 3 个
    if (r == 46) {
        BOTC_PoResolve(p, g_skillT1[p], g_skillT2[p], g_skillT3[p]);
    }
    // ■ 方古（68）：这一刀 + 「第一次杀死外来者 → 转化」
    if (r == 68) {
        BOTC_FangGuResolve(p, g_skillT1[p]);
    }
    // ■ 亡骨魔（69）：这一刀 + 「被杀爪牙保留能力 + 邻近镇民中毒（说书人挑）」
    if (r == 69) {
        BOTC_VigResolve(p, g_skillT1[p]);
    }
    // ■ 诺-达鲺（70）：这一刀（他的两份毒是常驻效果，黄昏统一重算）
    if (r == 70) {
        BOTC_DemonStrike(p, 70, g_skillT1[p], false);
        BOTC_NoDashiiSync();
    }
    // ■ 涡流（71）：这一刀（镇民信息必错 + 没人被处决就赢，都是常驻效果）
    if (r == 71) {
        BOTC_DemonStrike(p, 71, g_skillT1[p], false);
        BOTC_VortoxSync();
    }
    if (r == 21) {
        // 小恶魔：这里只记下今晚刀谁，等说书人点【进入白天】时再死人（见 BOTC_DawnResolve）
        g_nightImp = g_skillT1[p];
        g_nightImpFrom = p;
        if (g_demonTar < 2) {          // 【疯子 × 数学家】相克规则：小恶魔这一刀也算「真恶魔的目标」
            g_demonTar = g_skillT1[p];
            BOTC_MalfLunCheck();
        }
        if (g_skillT1[p] == p) {
            BOTC_PmStore(g_teller, "【夜间】小恶魔自刀了（" + BOTC_NameStr(p) + "）。");
        }
        // 当场结算这一刀（只记录，天亮再公开）：这样排在后面的守鸦人醒来时能读到死亡 token
        BOTC_ImpKillResolve(p, g_skillT1[p]);
    }
    if (r == 5) {
        BOTC_FtAnswer(g_who[p], g_skillT1[p], g_skillT2[p]);
    }
    if (g_hagKill && g_who[p] == g_teller) {
        // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：说书人定了谁死（0~2 个）
        BOTC_HagKill(1, g_skillT1[1], g_skillT2[1]);
        return;
    }
    if (g_twinPick && g_who[p] == g_teller) {
        // 镜像双子（64）：说书人在自己面板上点了谁当对立双子
        BOTC_TwinPickAt(g_skillT1[p]);
        return;
    }
    if (r == 65) {
        // 女巫（65）：确认 = 诅咒他
        BOTC_WitchApply(p, g_skillT1[p]);
    }
    if (r == 63) {
        // 呆瓜（63）：确认 = 公开选一名存活玩家（选到邪恶 → 他的阵营落败，用户 2026-09-21）
        BOTC_KlutzPick(p, g_skillT1[p]);
    }
    if (r == 36) {
        // 月之子（36）：确认 = 公开选择一名存活玩家（天亮结算他死不死）
        BOTC_MoonChildDeclare(p, g_skillT1[p]);
    }
    // 【守鸦人（8）的「自动发信息」仍然不发】（用户 2026-10-05）：答案由说书人自己看魔典给。
    // 【但「他选了谁」要提示说书人】（用户 2026-10-07）：确认这一刻把这句写进说书人私聊。
    if (r == 8 && g_skillT1[p] >= 2) {
        BOTC_PmStore(g_teller, "【守鸦人】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(g_skillT1[p]) + "。");
        if (g_levJinxWake[p]) {
            g_levJinxWake[p] = false;
            g_levJinxLost[p] = true;
            BOTC_PmStore(g_teller, "【利维坦×守鸦人相克】守鸦人的能力已经触发 → 他本局失去能力。");
            BOTC_LeviathanSpecialSync();
        }
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

void BOTC_KillSeat (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 9]) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被小恶魔选中，但他有「保护」，没有死。");
        return;
    }
    BOTC_MarkDeath(q, 1, 1, -1);      // 夜间死亡 + 被恶魔击杀
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(q) + StringToText(" 死亡"));
    BOTC_BansheeAnnounce(q);
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
}

//==================================================================================================
// 夜间刀口结算（小恶魔 / 僧侣）
//   技能确认时只记下目标，等说书人点【进入白天】（天亮）才真的死人并播报昨晚的死亡信息：
//     僧侣保护的人 = 小恶魔今晚选的同一个人 → 不死，私人告诉说书人；
//     小恶魔把自己刀了 → 死；场上还有活着的爪牙就传位（智能说书随机，手动说书解锁身份编辑）；
//   僧侣的「保护」只算昨晚，天亮时标记一起清掉。
//==================================================================================================

// 这个座位在场、而且还没死
bool BOTC_SeatAliveQ (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    return !BOTC_SeatDead(q);
}

// 这个座位（按说书人那份魔典上的身份）是不是爪牙
bool BOTC_SeatIsMinion (int q) {
    int r;
    if (q < 2 || q > 13) {
        return false;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return false;
    }
    return (BOTC_RoleTeam(r) == 2);
}

// 活着的爪牙名单（传位时给说书人看）
string BOTC_MinionListStr () {
    int i;
    int q;
    int n;
    string s;
    BOTC_BuildSeatList();
    s = "";
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                if (n > 0) {
                    s = s + ",";
                }
                s = s + BOTC_NameStr(q);
                n = n + 1;
            }
        }
    }
    if (n == 0) {
        s = "（没有）";
    }
    return s;
}

// 清掉这一夜的记录（新局、天亮结算完都调用）
void BOTC_NightSkillReset () {
    int i;
    BOTC_TaotieClear();
    g_hagNoDemonKill = false;          // 【麻脸巫婆】恶魔刀无效只算造出恶魔的那一晚（用户 2026-09-21）
    g_lycanNoDemon = false;            // 【半兽人（107）】「今晚恶魔不造成死亡」只算今晚（用户 2026-10-10 补）
    g_lycanBy = 0;                     // 【半兽人×陌客/间谍】待判定目标每夜清空
    g_lycanTgt = 0;
    g_kingAnnounced = 0;               // 【国王（104）】「谁是国王」发过的标记：每夜重新放开
    g_nightImp = 0;
    g_nightImpFrom = 0;
    g_nightMonk = 0;
    g_nightMonkFrom = 0;
    for (i = 2; i <= 13; i += 1) { g_levJinxWake[i] = false; }
    // 【疯子 × 数学家】相克规则的记录：一夜用完就清（用户 2026-09-21）
    g_lunTar = 0;
    g_lunSeat = 0;
    g_lunActed = false;
    g_demonTar = 0;
    // 【疯子·告知恶魔】（用户 2026-11-12）：一夜用完就作废
    g_lunPickPend = false;
    g_lunPickText = "";
    g_lunPickLu = 0;
    g_lunPickCann = false;
    g_lunFakeKillNight = 0;            // 【假疯子】每夜重新允许问一次
    for (i = 1; i <= 13; i += 1) {
        g_lunPickSent[i] = false;
    }
    // 【小怪宝 / 军团·死亡目标】跨夜必须彻底清空，避免上一夜的已选座位残留。
    if ((g_mdOpen || g_mdAsk || g_miRole == 816) && g_miDlg > 0) {
        DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_mdList, PlayerGroupAll(), false);
        if (g_miRole == 816) {
            g_miRole = -1;
            g_miSeat = 0;
        }
    }
    // 【小怪宝 / 造谣者 / 赏金猎人】的技能面板跨夜也要收（用户 2026-11-10）。
    if (g_mdAsk) {
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        if (g_skillDlg[1] > 0) {
            DialogSetVisible(g_skillDlg[1], PlayerGroupAll(), false);
        }
    }
    g_mdAsk = false;
    g_mdOpen = false;
    g_mdRole = 0;
    g_mdSrc = 0;
    for (i = 0; i <= 13; i += 1) {
        g_mdPick[i] = false;
        // 【非唤醒夜序节点】「本夜已提示过」只算本夜，跨夜必须重新放开，
        //   否则造谣者 / 修补匠 / 小怪宝 / 军团 / 牙噶巴卜 只有在第一夜会提醒（用户 2026-11-09）。
        g_manualDeathDone[i] = false;
    }
}

//==================================================================================================
// 恶魔击杀统一通道：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
//==================================================================================================
void BOTC_DemonStrike (int src, int srcRole, int q, bool selfPromote) {
    bool demonHandled;
    string blk;
    string who;
    // 【麻脸巫婆（67）】（用户 2026-09-21）：她今晚造出了恶魔 → 恶魔自己的刀一律无效，死亡改由说书人定
    if (g_hagNoDemonKill) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚恶魔自己的刀无效（她已经造出了一只恶魔）。");
        return;
    }
    // 【半兽人（107）】（用户 2026-10-10）：今晚他杀死了善良玩家 → 恶魔今晚不造成死亡
    if (g_lycanNoDemon) {
        BOTC_PmStore(g_teller, "【半兽人】今晚他杀死了善良玩家 → 恶魔这一刀不造成死亡。");
        return;
    }
    // 电脑自动行动等路径可能直接调用这里；若本次尚未经过掮客的前置改选，入口再兜一次。
    if (BOTC_BrokerActive() && src != g_brokerRedirectedBy) {
        if (q == g_brokerA) {
            q = g_brokerB;
        }
        else if (q == g_brokerB) {
            q = g_brokerA;
        }
    }
    if (BOTC_HeshangTryBlockSeat(src, srcRole, q)) {
        return;
    }
    // 【相克规则：疯子 × 数学家】（用户 2026-09-21）：记下真恶魔今晚的第一个目标
    if (g_demonTar < 2 && srcRole >= 0 && srcRole <= 163 && BOTC_RoleTeam(srcRole) == 3) {
        g_demonTar = q;
        BOTC_MalfLunCheck();
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    who = BOTC_RoleNameSafe(BOTC_SeatTrueRole(src));
    if (BOTC_SeatDead(q)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）选的 " + BOTC_NameStr(q) + " 本来就死了，没再动他。");
        return;
    }
    // 【莽夫那一份醉酒】（用户 2026-09-20）：施术者的醉酒如果完全来自「今夜第一个选莽夫」这一下，
    //   那它只挡「打莽夫自己」的那一刀；打别的目标照旧生效（沙巴洛斯的另一个目标还死就是这个道理）。
    if (BOTC_SeatImpaired(src) && !(BOTC_GoonDrunkOnly(src) && q != g_goonSeat)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）中毒/酒鬼，这一次的能力无效。");
        return;
    }
    // 【悟道者】：直接受到邪恶能力影响时，先变身；原本的击杀仍继续结算。
    BOTC_WudTryTrigger(q, src);
    // 僧侣按顺序排在他前面：这里能直接读到他的保护
    if (g_nightMonk == q) {
        if (!BOTC_SeatImpaired(g_nightMonkFrom)) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被僧侣保护住了，这一次没有生效。");
            return;
        }
        BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(g_nightMonkFrom) + "）中毒/酒鬼，保护无效。");
    }
    // 【旅店老板 / 水手 / 弄臣 那些免死】统一走 BOTC_DeathBlocker（智能说书硬判）
    blk = BOTC_DeathBlocker(q, 1, 1, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 带着【" + blk + "】，这一次没有生效。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(q);
        }
        return;
    }
    // 士兵：免疫恶魔的刀（中毒 / 酒鬼时失效）
    if (BOTC_AbilityWorks(q, 11)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 是士兵，免疫恶魔的刀。");
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 1, 1, srcRole);
    if (g_mayorHold) {
        // 镇长（12）那一刀被挂起：等说书人在弹窗里拍板之后再继续（日志 / 祖母 / 传位 / 胜负）
        g_mayorHold = false;
        g_mayorAskSrc = src;
        g_mayorAskSrcRole = srcRole;
        return;
    }
    BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(src) + "（" + who + "）击杀。");
    BOTC_NanaLinkCheck(q);             // 祖母（22）：孙子被恶魔杀死，她也一起死
    // 恶魔死了：
    //   ① **自刀**（小恶魔自己那一刀）→ **红唇女郎优先**（她在、活着、清醒、恶魔死后活人 ≥4
    //      就必须是她顶上，不给说书人挑）；没有她才让说书人挑一名活着的爪牙接位（智能说书随机挑）
    //   ② 别的死法 / 别的恶魔杀的 → 同样是红唇女郎优先，没有她就交回调用方判胜负
    demonHandled = false;
    if (selfPromote) {
        demonHandled = BOTC_ScarletCheck();
        if (!demonHandled) {
            demonHandled = BOTC_ImpPromote();
        }
    }
    else {
        demonHandled = BOTC_ScarletCheck();
    }
    if (!demonHandled) {
        BOTC_CheckWin();
    }
}

// 小恶魔这一刀：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
void BOTC_ImpKillResolve (int imp, int q) {
    BOTC_DemonStrike(imp, 21, q, (q == imp));
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 8 批】（用户 2026-09-20）：43 僵怖 / 44 普卡 / 45 沙巴洛斯 / 46 珀
//   四个恶魔都走上面那条 BOTC_DemonStrike（保护 / 免死 / 士兵 / 镇长弹刀 / 祖母联动 / 传位 / 胜负）
//==================================================================================================

// 「今天有人死」：按**死亡发生的时间**算（用户 2026-09-20）----
//   白天死的都算（处决 / 白天技能杀 / 说书人手动标的，不管打的是哪种死因 token）；
//   夜里死的不算（记死亡时是夜里 → g_deadDay 记 0）。
//   教父（39）的「今天有外来者死亡」和僵怖（43）的「今天有人死」共用这一条。
bool BOTC_ExecutedDeathToday () {
    int q;
    if (g_dayNum <= 0 || !g_execUsedToday) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_exec[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum || g_deadKind[q] != 3) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            return true;
        }
    }
    return false;
}

bool BOTC_SomeoneDiedToday () {
    int q;
    if (g_dayNum <= 0) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_deadDay[q] == g_dayNum) {
            return true;                    // 白天死的都算（处决 / 技能杀 / 说书人手动标，任何死因 token 都行）
        }
    }
    return false;
}

// ■ 僵怖（43）：「第一次死亡时，你不会死」。
//   全桌照常看到「死亡」（天亮公播 + 红叉），但他其实还活着（内部一切按活人算，见 BOTC_SeatDead）。
//   返回值：true = 这次死亡被这一条吃掉了（调用方不要再记死亡）。
bool BOTC_ZombuulFake (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_HasAbility(q, 43)) {
        return false;                       // 只有拥有僵怖能力才有这一条
    }
    // 中毒 / 酒鬼的僵怖：他的能力失效 ---- **这一次的死亡就是真死**，不消耗「第一次不会死」（用户 2026-09-20）
    if (!BOTC_AbilityWorks(q, 43)) {
        BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 「第一次不会死」这一条失效：这次照常真死。");
        return false;
    }
    if (g_zombUsed[q]) {
        // 那一次假死已经用掉：**这次的死亡是真死** ---- 顺手把「看起来死了其实活着」的状态撤掉
        //   （用户 2026-09-20：不撤的话他一直算活着，胜负和主谋的加时都判不出来）
        if (g_zombFake[q]) {
            g_zombFake[q] = false;
        }
        return false;
    }
    if (g_zombFake[q]) {
        return false;
    }
    g_zombUsed[q] = true;
    g_zombFake[q] = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 58] = true;   // 已假死（僵怖）
    if (g_isNight) {
        g_deadPending[q] = true;            // 夜里：等天亮统一公开「X 死亡」（全桌都当他死了）
    }
    else {
        g_deadShown[q] = true;              // 白天：当场公开红叉（播报由调用方负责）
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
        g_deadPending[q] = false;
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 第一次死亡 → 不会真的死：全桌照常看到「死亡」，但他其实还活着。");
    BOTC_PmStore(g_teller, "【僵怖】要真正杀死他：再记一次死亡就行。");
    BOTC_PmInfo(g_who[q], "【僵怖】你其实没有死，继续正常行动。");
    BOTC_ScarletAfterZombuul();
    return true;
}

// ■ 普卡（44）的毒：来源离场（他死了）就把毒收回来（用户 2026-09-20 的通用规则：
//   「任何角色离场 / 死亡，除非有特别说明，能力失效、它造成的 token 一起消失」）。
// 【恐惧之灵(102) 收「恐惧」】（用户 2026-10-03）：换目标 / 他死亡或离场时，把「恐惧」121 全部撤掉
void BOTC_FearClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 121]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 121] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【恐惧之灵】" + why + " → 已撤掉「恐惧」标记（" + IntToString(n) + " 人）。");
    }
}
// 【痢蛭(100) 收毒】（用户 2026-10-03）：痢蛭死亡 / 离场时，把所有人身上的「中毒（痢蛭）120」撤掉
void BOTC_LleechPoisonClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 120]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 120] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【痢蛭】" + why + " → 已撤掉「中毒（痢蛭）」（" + IntToString(n) + " 人）。");
    }
}
void BOTC_PukkaPoisonClear (string why) {
    int q;
    q = g_pukkaSeat;
    g_pukkaSeat = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 63]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 63] = false;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【中毒】" + BOTC_NameStr(q) + " 身上的普卡之毒已清掉。");
    }
}

// ■ 普卡（44）：「每个夜晚选择一名玩家：他中毒。上一个被选中的玩家会死亡，然后恢复健康。」
//   · 首夜也会行动（首夜顺序 5）；毒**不跟黄昏清**，一直挂到普卡下一次正常生效的行动
//   · 普卡在本次选择时能力不生效（中毒 / 醉酒 / 活尸 / 提线木偶等）：
//     新目标不中毒，g_pukkaSeat 保持上一次正常生效时的目标；下一次正常行动再结算他。
void BOTC_PukkaResolve (int p, int t) {
    int old;
    old = g_pukkaSeat;
    if (!BOTC_SkillWorks(p)) {
        if (old >= 2) {
            BOTC_PmStore(g_teller, "【普卡】" + BOTC_NameStr(p) + " 本次选择时能力不生效：" + BOTC_NameStr(t) + " 不会中毒；上一次正常生效时选择的 " + BOTC_NameStr(old) + " 仍保持中毒，下一次正常行动时才会毒发。");
        }
        else {
            BOTC_PmStore(g_teller, "【普卡】" + BOTC_NameStr(p) + " 本次选择时能力不生效：" + BOTC_NameStr(t) + " 不会中毒，也没有需要保留的上一目标。");
        }
        return;
    }
    // ① 先给新目标挂毒（用户 2026-09-20：普卡的刀是**先挂毒，然后再结算死亡**）
    BOTC_WudTryTrigger(t, p);
    g_tokOn[(((g_teller * 14) + t) * 256) + 63] = true;      // 中毒（普卡）（用户 2026-09-20）
    g_pukkaSeat = t;
    BOTC_GrimRender(g_teller);
    // ② 再结算「上一次被毒的人」：他毒发身亡，然后恢复健康（这一份毒收掉）
    if (old >= 2) {
        // 【顺序】（用户 2026-09-20 确认）：**先结算死亡，再恢复健康** ----
        //   死亡这一刻他身上的「中毒」标记还在（所以「清醒才免死」那类保护，比如水手 / 弄臣，这时候是不生效的），
        //   死完之后才把中毒 token 撤掉。
        if (!BOTC_SeatDead(old)) {
            BOTC_DemonStrike(p, 44, old, false);
        }
        if (g_tokOn[(((g_teller * 14) + old) * 256) + 63]) {
            g_tokOn[(((g_teller * 14) + old) * 256) + 63] = false;
            BOTC_GrimRender(g_teller);
        }
        if (old == t) {
            // 同一个目标：老的毒已经结算掉（恢复健康），不再挂账
            g_pukkaSeat = 0;
        }
    }
}

// 【驱魔人 × 普卡】：普卡今晚不能选新目标，但上一名由普卡正常选中的玩家仍会毒发。
// 死亡统一走恶魔击杀通道，因此会使用普卡的专属死因 token 21；毒发后撤掉中毒（普卡）。
// 普卡自身能力不生效时，旧目标不死亡，且继续保持普卡之毒。
void BOTC_PukkaExorcistResolve (int p) {
    int old;
    if (p < 2 || p > 13) {
        return;
    }
    old = g_pukkaSeat;
    if (!BOTC_SkillWorks(p)) {
        if (old >= 2) {
            BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 当前能力不生效；上一目标 " + BOTC_NameStr(old) + " 不会死亡，并继续保持普卡之毒。");
        }
        else {
            BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 当前能力不生效，也没有需要结算的上一目标。");
        }
        return;
    }
    if (old < 2) {
        BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 今晚被驱魔，无法选择新目标；目前没有上一目标需要毒发。");
        return;
    }
    if (!BOTC_SeatDead(old)) {
        BOTC_DemonStrike(p, 44, old, false);
    }
    if (g_tokOn[(((g_teller * 14) + old) * 256) + 63]) {
        g_tokOn[(((g_teller * 14) + old) * 256) + 63] = false;
        BOTC_GrimRender(g_teller);
    }
    g_pukkaSeat = 0;
    BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 今晚不选择新目标；上一目标 " + BOTC_NameStr(old) + " 毒发（死亡标记：普卡），随后撤掉中毒（普卡）。");
}

// ■ 沙巴洛斯（45）：反刍（复活一名上一夜吃掉、现在还死着的玩家）
void BOTC_SabalosRevive (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    // 【复活也等天亮统一结算】（用户 2026-09-20）：公开死亡的那种只在夜里记「复活（沙巴洛斯）」标记，
    //   红叉留到天亮再统一清掉 + 公布「【复活】」；还没公开的（同一夜刚死）照旧静默取消。
    if (BOTC_PublicDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = true;   // 复活（沙巴洛斯）：天亮统一结算
    }
    else {
        BOTC_ClearDeath(q);                     // 还没公开（比如同一夜刚死）：静默取消，不播报
        BOTC_RestoreOneShot(q);                 // 静默复活同样是「重新进场」
    }
    g_sabChosen[q] = false;                 // 这一个候选用掉了（以后不再反刍他）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 " + BOTC_NameStr(q) + "：红叉留到天亮统一公布「【复活】」。");
}

// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · 候选 = 上一夜吃掉、现在还死着的两个人
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 善良角色尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · **候选 = 他以前选过的所有人里、现在还死着的**（用户 2026-09-20）----
//     不一定是被他杀的：例如他选了莽夫、自己醉了什么都没发生，莽夫第二天被处决，之后一样可以反刍
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · **概率按「双刀次数」算**（用户 2026-09-20）：每当有 2 个人在同一天死于沙巴洛斯的刀就记一次，
//     初始 0%，**第一次双刀也是 0%**，从第二次双刀起每多一次 +25%（0 / 25 / 50 / 75 / 100），封顶 100%
//   · 一局限一次（`g_sabRegurgDone`）
//   · **决赛圈（场上活着 ≤ 4 人）必复活** ---- 但前提是概率不是 0（也就是至少开过 2 次双刀）
//   · **自称是「教授」时**：第一次有机会复活（第 3 夜起、已经有死掉的候选人）→ 必定复活（演得像教授）
//   · 候选 = 他以前选过的所有人里、现在还死着的；挑人优先级：决胜轮复活落后一方 / 平时邪恶优先 /
//     想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
int BOTC_SabalosRegurgPick (int p) {
    int q;
    int i;
    int n;
    int k;
    int pick;
    int chance;
    int evilAlive;
    int goodAlive;
    int alive;
    bool wantEvil;
    bool force;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (g_sabRegurgDone[p]) {
        return 0;                       // 一局只能发动一次
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return 0;                       // 没有候选：没有什么可反刍的
    }
    chance = (g_sabDouble - 1) * 25;
    if (chance > 100) {
        chance = 100;
    }
    // 场上活着的人数（按公开死亡 / 红叉算，跟判胜负一个口径）
    alive = 0;
    evilAlive = 0;
    goodAlive = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_SettledDead(q)) {
            continue;
        }
        alive = alive + 1;
        if (BOTC_SeatAlign(q) == 0) {
            goodAlive = goodAlive + 1;
        }
        else {
            evilAlive = evilAlive + 1;
        }
    }
    force = false;
    if (alive <= 4 && chance > 0) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】决赛圈 → 这一次必定反刍。");
    }
    if (g_claim[p] == 30 && g_nightNum >= 3) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】他自称是「教授」→ 第一次有机会复活时必定反刍。");
    }
    if (!force) {
        if (chance <= 0) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次不反刍。");
            return 0;
        }
        if (RandomInt(1, 100) > chance) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次没反刍。");
            return 0;
        }
    }
    wantEvil = true;
    if (alive <= 4) {
        if (evilAlive > goodAlive) {
            wantEvil = false;              // 决胜轮：邪恶已经占优 → 改帮善良那一方
        }
    }
    pick = 0;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        if (wantEvil) {
            if (BOTC_SeatAlign(q) != 1) {
                continue;
            }
        }
        else {
            if (BOTC_SeatAlign(q) != 0) {
                continue;
            }
            if (BOTC_OneShotAt(q)) {
                continue;
            }
        }
        n = n + 1;
    }
    if (n > 0) {
        k = RandomInt(1, n);
        i = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (wantEvil) {
                if (BOTC_SeatAlign(q) != 1) {
                    continue;
                }
            }
            else {
                if (BOTC_SeatAlign(q) != 0) {
                    continue;
                }
                if (BOTC_OneShotAt(q)) {
                    continue;
                }
            }
            i = i + 1;
            if (i == k) {
                pick = q;
                break;
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotAt(q)) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotAt(q)) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        return 0;
    }
    g_sabRegurgDone[p] = true;
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 → 复活 " + BOTC_NameStr(pick) + "（" + BOTC_AlignName(BOTC_SeatAlign(pick)) + "）。");
    return pick;
}

// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，他上一夜吃掉的一名玩家可能被反刍。」
//   ---- 先反刍，再吃两个人。
//   反刍谁定：真人说书只提示（他自己用【死亡标记】/ 复活处理）；智能说书按概率自动掷。
// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，一名他选过的玩家可能被反刍。」
//   ---- 先反刍，再吃两个人；**反刍要在「选目标 / 杀人」之前判定**（用户 2026-09-20）。
void BOTC_SabalosResolve (int p, int t1, int t2) {
    int pick;
    int goonPos;
    int i;
    int diedN;
    bool wasA;
    bool wasB;
    string s;
    s = "";
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || !g_sabChosen[i]) {
            continue;
        }
        if (!BOTC_SeatDead(i)) {
            continue;
        }
        if (StringLength(s) > 0) {
            s = s + " ";
        }
        s = s + BOTC_NameStr(i);
    }
    if (StringLength(s) <= 0) {
        s = "无";
    }
    BOTC_PmStore(g_teller, "待复活玩家：" + s);
    BOTC_PmStore(g_teller, "放置复活（沙巴洛斯）token以反刍。");
    if (t1 >= 2) {
        g_sabChosen[t1] = true;         // 先记进候选池：以后一样可以被反刍（用户 2026-09-20）
    }
    if (t2 >= 2) {
        g_sabChosen[t2] = true;
    }
    g_sabA = t1;
    g_sabB = t2;
    if (!BOTC_SkillWorks(p) && !BOTC_GoonDrunkOnly(p)) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 今晚吃人无效：这两个人都不死。");
        return;
    }
    // 【按目标顺序结算】（用户 2026-09-20）：莽夫是「被他选中的那一刻」才让施术者醉酒的 ----
    //   · 目标1 = 莽夫 → 当场醉酒：莽夫自己那一口不算，**排在他后面的目标2 也不再结算**
    //   · 目标2 = 莽夫 → 目标1 排在前面、早就结算完了，照常死（莽夫自己那一口照旧不算）
    goonPos = 0;
    if (BOTC_GoonDrunkOnly(p)) {
        if (t1 == g_goonSeat) {
            goonPos = 1;
        }
        else {
            if (t2 == g_goonSeat) {
                goonPos = 2;
            }
        }
    }
    if (goonPos == 1) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】目标1 是莽夫（" + BOTC_NameStr(g_goonSeat) + "）→ 他当场醉酒：莽夫自己那一口不算，排在他后面的目标2 也不再结算。");
        BOTC_GrimRender(g_teller);
        return;
    }
    BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 今晚吃了 " + BOTC_NameStr(t1) + " 和 " + BOTC_NameStr(t2) + "。");
    wasA = BOTC_SeatDead(t1);
    wasB = false;
    if (t2 >= 2) {
        wasB = BOTC_SeatDead(t2);
    }
    BOTC_DemonStrike(p, 45, t1, false);
    if (t2 >= 2) {
        BOTC_DemonStrike(p, 45, t2, false);
    }
    // 【累计一次「双刀」】（用户 2026-09-20）：这一夜真的有 2 个人死于他的刀
    diedN = 0;
    if (!wasA && BOTC_SeatDead(t1)) {
        diedN = diedN + 1;
    }
    if (t2 >= 2 && !wasB && BOTC_SeatDead(t2)) {
        diedN = diedN + 1;
    }
    if (diedN >= 2) {
        g_sabDouble = g_sabDouble + 1;
    }
}

// ■ 珀（46）：「每个夜晚选择一名玩家：他死亡。如果你选择不杀人，下一个夜晚你必须选择三名玩家。」
//   计数完全由 token 52「攻击三次（珀）」驱动（说书人也能自己打 / 撤）。
void BOTC_PoResolve (int p, int t1, int t2, int t3) {
    int goonPos;
    if (BOTC_ProtectTokOn(p, 52)) {
        BOTC_PmStore(g_teller, "【珀】今晚是「攻击三次」：三个人一起死。");
        // 【按目标顺序结算】（用户 2026-09-20）：排到莽夫之后的目标不再结算（莽夫自己那一口也不算）
        goonPos = 0;
        if (BOTC_GoonDrunkOnly(p)) {
            if (t1 == g_goonSeat) {
                goonPos = 1;
            }
            else {
                if (t2 == g_goonSeat) {
                    goonPos = 2;
                }
                else {
                    if (t3 == g_goonSeat) {
                        goonPos = 3;
                    }
                }
            }
        }
        if (goonPos != 0) {
            BOTC_PmStore(g_teller, "【珀】莽夫（" + BOTC_NameStr(g_goonSeat) + "）排在他选的第 " + IntToString(goonPos) + " 个 → 从莽夫开始（含他自己）都不结算，排在后面的目标也不再死。");
        }
        if (goonPos == 0 || goonPos > 1) {
            BOTC_DemonStrike(p, 46, t1, false);
        }
        if (t2 >= 2) {
            if (goonPos == 0 || goonPos > 2) {
                BOTC_DemonStrike(p, 46, t2, false);
            }
        }
        if (t3 >= 2) {
            if (goonPos == 0) {
                BOTC_DemonStrike(p, 46, t3, false);
            }
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 52] = false;      // 打完了，标记撤掉
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【珀】「攻击三次」已经用掉，标记撤掉。");
    }
    else {
        BOTC_DemonStrike(p, 46, t1, false);
    }
}

// 技能面板用的「这个角色这次要选几个目标」：珀带「攻击三次」时是 3，其余照角色表
// ■ 镜像双子（64）：「你与一名对立阵营的玩家互相知道对方是什么角色。如果其中善良玩家被处决，邪恶阵营获胜。
//   如果你们都存活，善良阵营无法获胜。」配对由**说书人**点，身份由脚本**自动**告诉两人（用户 2026-09-21）。
// 【双子 · 一切以 token 为准】（用户 2026-09-22）：76 = 镜像双子本人、77 = 对立双子
int BOTC_TwinSeatOf (int tok) {
    int i;
    for (i = 13; i >= 1; i -= 1) {
        if (i > 1 && !g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + tok]) {
            return i;
        }
    }
    return 0;
}

// 【双子能力有没有生效】（用户 2026-09-22）：镜像双子活着（或带「保留能力」）且不醉酒、不中毒 ----
//   失效时：没有特胜、也不发「你的对立双子是谁」的信息（等他清醒再补）
bool BOTC_TwinActive () {
    int a;
    a = BOTC_TwinSeatOf(76);
    if (a < 2) {
        return false;
    }
    if (BOTC_SeatImpaired(a)) {
        return false;
    }
    if (BOTC_SeatDead(a) && !BOTC_KeepsAbilityAlive(a)) {
        return false;
    }
    return true;
}

bool BOTC_TwinBlocksGood () {
    if (!BOTC_TwinActive()) {
        return false;                       // 【以 token 为准 + 醉酒/中毒即失效】（用户 2026-09-22）
    }
    if (BOTC_SeatTrueRole(g_twinA) != 64) {
        return false;                       // 那只镜像双子被改了身份 / 离场 → 能力没了
    }
    // 【亡骨魔的「保留能力」】（用户 2026-09-21）：被亡骨魔杀死的双子死后能力还在 →
    //   这一对照样算「都在」，处决善良那只一样是邪恶胜（百科就是这么写的）。
    if (BOTC_TwinSeatOf(77) < 2) {
        return false;
    }
    if (BOTC_SeatDead(BOTC_TwinSeatOf(77)) && !BOTC_KeepsAbilityAlive(BOTC_TwinSeatOf(77))) {
        return false;                       // 对立双子死了、而且没保留能力 → 能力没了
    }
    return true;
}

// 【镜像双子这一格现在算不算「中毒 / 酒鬼 / 带信息错误（涡流）」】（用户 2026-10-14）----
//   ⚠ 只看**镜像双子本人那一格**（含后来借到这个能力的人：炼金 123 / 哲学家 70 / 食人族 97 都读得到）；
//     **对立双子身上有没有标记一概不管**（用户 2026-10-14 明确）。
//   命中时：配对 token 76 / 77 脚本不代打，身份信息**只发镜像双子本人**，对立双子那边不说。
bool BOTC_TwinBadInfo (int a) {
    if (a < 2) {
        return true;
    }
    if (!BOTC_SkillWorks(a)) {
        return true;
    }
    if (BOTC_InfoErrorOn(a)) {
        return true;
    }
    return false;
}
// 【把两人的身份互相告诉对方】（用户 2026-09-21；2026-10-14 恢复「清醒就照旧发两边」）----
//   ⚠ 带「中毒 / 酒鬼 / 信息错误（涡流）」的镜像双子**不走这里**：那种只发给镜像双子本人（见 BOTC_TwinBadInfo 那两支）。
void BOTC_TwinNightInfo () {
    int ra;
    int rb;
    if (g_twinA < 2 || g_twinB < 2) {
        return;
    }
    ra = BOTC_SeatTrueRole(g_twinA);
    rb = BOTC_SeatTrueRole(g_twinB);
    if (ra < 0 || rb < 0) {
        return;
    }
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(g_twinB) + "是" + g_roleName[rb] + "。");
    BOTC_PmInfo(g_who[g_twinB], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[ra] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(g_twinB) + "）。");
}

void BOTC_TwinPickAt (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return;
    }
    if (g_twinA < 2) {
        BOTC_Notice(g_teller, "场上还没有镜像双子。");
        return;
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinPick = false;
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）：token 不代打，信息只发他本人。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(q)) + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_TwinNightInfo();
}
// ■ 女巫（65）：「每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。」
//   提示标记「被诅咒」：夜晚行动后放置（她醉/中毒时不放）；黄昏、或女巫死亡/离场时移除（官方时机）。
void BOTC_WitchCurseClear (string why) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 73]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 73] = false;
        }
    }
    g_witchCurse = 0;
    BOTC_GrimRender(g_teller);
}

void BOTC_WitchApply (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13 || !g_seatOn[q]) {     // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_witchFrom = p;
    if (!BOTC_WitchCanAct(p)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次没有下咒。");
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次不放置「被诅咒」标记。");
        return;
    }
    BOTC_WitchCurseClear("女巫换了目标");
    g_witchCurse = q;
    g_tokOn[(((g_teller * 14) + q) * 256) + 73] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【女巫】诅咒了 " + BOTC_NameStr(q) + "：他明天白天一旦发起提名就会死亡。");
}

// 被诅咒的人发起提名 → 立刻死（提名照常继续；不算恶魔杀）
void BOTC_WitchNomCheck (int by) {
    int ob;
    string blk;
    if (by < 2 || by > 13 || g_witchCurse != by) {
        return;
    }
    if (g_witchFrom >= 2 && !BOTC_WitchCanAct(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次诅咒不触发。");
        return;
    }
    if (g_witchFrom >= 2 && BOTC_SeatImpaired(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】女巫中毒/酒鬼 → 这次诅咒不生效。");
        return;
    }
    // 【免死 / 保护】（用户 2026-09-21）：他免疫死亡 → 什么都不发生（不打红叉、公屏一个字都不播）
    blk = BOTC_DeathBlocker(by, 2, 0, false);
    if (blk != "") {
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(by);
        }
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 带着【" + blk + "】→ 这一次没有死（公屏什么都不会播）。");
        return;
    }
    // 【当场死 = 当场盖红叉】（用户 2026-09-21）：走「白天死亡 + 非恶魔杀」那一格，死因是「死亡（女巫）」
    BOTC_MarkDeathQuietSrc(by, 2, 0, 65);
    g_deadShown[by] = true;
    if (!BOTC_DeathSfxMute(by)) {
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
    }
    g_deadPending[by] = false;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 公屏只播「X 死亡」（不提女巫，谁都不知道是他干的，用户 2026-09-21）
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(by) + StringToText(" 死亡"));
    BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 因诅咒死亡（他的提名照常继续）。");
    BOTC_DiagStore(g_teller, "【诊断】" + BOTC_NameStr(by) + " 被女巫诅咒致死（公屏只播了「死亡」）。");
    BOTC_CheckWin();
}

// 只剩三名存活玩家 → 女巫失去能力、诅咒立刻解除（用户 2026-09-21：自动）
bool BOTC_WitchCanAct (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_witchLost) {
        return false;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只有 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只有 3 人 → 女巫能力永久失效，诅咒已解除。");
        return false;
    }
    return true;
}

void BOTC_WitchSync () {
    int i;
    int n;
    if (g_witchFrom < 2 && g_witchCurse < 2) {
        return;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SeatDead(g_seatList[i])) {
            n = n + 1;
        }
    }
    if (n <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只剩 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只剩 3 人 → 她从现在起失去能力（之后不用再唤醒她）。");
    }
}
// ■ 洗脑师（66）：「每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，
//   不然他可能被处决。」疯狂本身不做判定（纯 token，用户 2026-09-21）---- 脚本只打标记 + 自动告诉目标。
// 【相克 · 洗脑师（66）× 哥布林（99）】（用户 2026-10-14）：洗脑师只能选 **善良角色 + 哥布林** ----
//   百科口径：「洗脑师与哥布林：洗脑师可以选择将玩家洗脑成哥布林。」（脚本相克表 g_jinxText[49] 那条）
//   所以先按「只列善良」筛一遍，再把哥布林那一格单独放出来；其它爪牙 / 恶魔仍然点不到。
void BOTC_CerenShowGoblin (int p) {
    int q;
    for (q = 0; q < g_gridN; q += 1) {
        if (g_gridSlot[q] != 99) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), true);
    }
}
void BOTC_CerenOpen (int p) {
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_cerenPick = true;
    g_pickMode[g_who[p]] = 14;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], true);          // 先只列善良角色
    BOTC_CerenShowGoblin(g_who[p]);           // 【相克】再把哥布林单独放出来（别的爪牙 / 恶魔仍然点不到）
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

// 【洗脑师 · 疯狂记账】（用户 2026-11-10）：
//   每个来源座位（真身洗脑师 / 失忆洗脑师 / 借来能力的玩家）各存一份，不共用同一枚 token；
//   某格只要还被任一来源的「本夜目标 / 上一夜目标」覆盖，就保留 token 71。
bool BOTC_CerenSeatMad (int s) {
    int src;
    if (s < 1 || s > 13) {
        return false;
    }
    for (src = 1; src <= 13; src += 1) {
        if (g_cerenTgt[src] == s && g_cerenTgt[src] > 0) {
            return true;
        }
        if (g_cerenOld[src] == s && g_cerenOld[src] > 0) {
            return true;
        }
    }
    return false;
}

// 洗脑师死亡 / 离场 / 换身份：撤掉他那一份疯狂，不能连带撤掉别的洗脑师的。
void BOTC_CerenSourceGone (int q) {
    int t1;
    int t2;
    if (q < 1 || q > 13) {
        return;
    }
    t1 = g_cerenTgt[q];
    t2 = g_cerenOld[q];
    g_cerenTgt[q] = 0;
    g_cerenTgtRole[q] = 0;
    g_cerenTgtNight[q] = 0;
    g_cerenOld[q] = 0;
    g_cerenOldRole[q] = 0;
    g_cerenOldNight[q] = 0;
    if (t1 > 0 && !BOTC_CerenSeatMad(t1)) {
        g_tokOn[(((g_teller * 14) + t1) * 256) + 71] = false;
    }
    if (t2 > 0 && t2 != t1 && !BOTC_CerenSeatMad(t2)) {
        g_tokOn[(((g_teller * 14) + t2) * 256) + 71] = false;
    }
}

// 黎明：按夜数收掉上一夜那一份；本夜刚放的那一份保留，玩家继续疯狂。
void BOTC_CerenDawnClear () {
    int src;
    int s;
    for (src = 1; src <= 13; src += 1) {
        if (g_cerenOld[src] > 0 && g_cerenOldNight[src] < g_nightNum) {
            s = g_cerenOld[src];
            g_cerenOld[src] = 0;
            g_cerenOldRole[src] = 0;
            g_cerenOldNight[src] = 0;
            if (!BOTC_CerenSeatMad(s)) {
                g_tokOn[(((g_teller * 14) + s) * 256) + 71] = false;
            }
        }
    }
    for (src = 1; src <= 13; src += 1) {
        if (g_cerenTgt[src] > 0 && g_cerenTgtNight[src] < g_nightNum) {
            s = g_cerenTgt[src];
            g_cerenTgt[src] = 0;
            g_cerenTgtRole[src] = 0;
            g_cerenTgtNight[src] = 0;
            if (!BOTC_CerenSeatMad(s)) {
                g_tokOn[(((g_teller * 14) + s) * 256) + 71] = false;
            }
        }
    }
}

// 换座位：来源与目标都是一整格，跟着人一起换。
void BOTC_CerenSwapState (int x, int y) {
    int i;
    int t;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {
        return;
    }
    // 先把「目标座位」按换位映射（来源记录稍后整条换位，避免重复映射）
    for (i = 1; i <= 13; i += 1) {
        if (g_cerenTgt[i] == x) {
            g_cerenTgt[i] = y;
        }
        else if (g_cerenTgt[i] == y) {
            g_cerenTgt[i] = x;
        }
        if (g_cerenOld[i] == x) {
            g_cerenOld[i] = y;
        }
        else if (g_cerenOld[i] == y) {
            g_cerenOld[i] = x;
        }
    }
    t = g_cerenTgt[x];
    g_cerenTgt[x] = g_cerenTgt[y];
    g_cerenTgt[y] = t;
    t = g_cerenTgtRole[x];
    g_cerenTgtRole[x] = g_cerenTgtRole[y];
    g_cerenTgtRole[y] = t;
    t = g_cerenTgtNight[x];
    g_cerenTgtNight[x] = g_cerenTgtNight[y];
    g_cerenTgtNight[y] = t;
    t = g_cerenOld[x];
    g_cerenOld[x] = g_cerenOld[y];
    g_cerenOld[y] = t;
    t = g_cerenOldRole[x];
    g_cerenOldRole[x] = g_cerenOldRole[y];
    g_cerenOldRole[y] = t;
    t = g_cerenOldNight[x];
    g_cerenOldNight[x] = g_cerenOldNight[y];
    g_cerenOldNight[y] = t;
}

void BOTC_CerenApply (int src, int who, int role) {
    if (src < 1 || src > 13 || who < 1 || who > 13 || role < 0 || role > 163) {    // 允许 1（用户 2026-09-21）
        return;
    }
    g_cerenWho = who;
    g_cerenRole = role;
    g_cerenPick = false;
    // 上一夜那一份转入 old：本夜到黎明前仍然处于疯狂状态
    g_cerenOld[src] = g_cerenTgt[src];
    g_cerenOldRole[src] = g_cerenTgtRole[src];
    g_cerenOldNight[src] = g_cerenTgtNight[src];
    g_cerenTgt[src] = who;
    g_cerenTgtRole[src] = role;
    g_cerenTgtNight[src] = g_nightNum;
    g_tokOn[(((g_teller * 14) + who) * 256) + 71] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【洗脑师】你明天白天和夜晚都要「疯狂」地证明自己是" + g_roleName[role] + "，不然可能被处决。");
    BOTC_PmStore(g_teller, "【洗脑师】已让 " + BOTC_NameStr(who) + " 疯狂证明自己是" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【洗脑师】他没做到的话，你可以处决他（占用当天处决名额）。");
}
// ■ 麻脸巫婆（67）：「每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。
//   如果因此创造了一个恶魔，当晚的死亡由说书人决定。」
//   用户 2026-09-21 的口径：阵营不变；转变当晚算他的「首个夜晚」；只提示**目标**（麻脸巫婆与说书人都不告知她结果）；
//   造出恶魔 → 当晚恶魔自己的刀无效，改由说书人在「生死无常」面板里决定 0~2 个人死（死因算她造成的）。
void BOTC_ChangeRoleMsg (int q, int role) {
    string s;
    string shown;
    string rp;
    int newRole;
    int prevRole;
    int prevA;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    // 【阵营没变就省略】（用户 2026-10-21）：比较改身份前 / 后的有效阵营。
    s = BOTC_TransitionRoleName(g_seatPrevAlign[q], BOTC_SeatAlign(q), role);
    shown = s;
    newRole = role;
    prevRole = g_seatPrevRole[q];
    prevA = g_seatPrevAlign[q];
    // 【全员追忆】正式开始前身份怎么变都只在本人魔典上重算占位卡、私聊也只报「失忆的X」；
    //   正式开始之后，理发师、麻脸巫婆、说书人手动改、方古击杀等一切身份转变都直接让玩家
    //   看到真实新身份；阵营没变时只报角色名，阵营变了才带「善良的/邪恶的」前缀。
    if (g_board == 13) {
        BOTC_AmnesiaSyncSeat(q, role);
        if (g_nightNum == 0) {
            newRole = BOTC_AmnesiaMaskRole(role);
            shown = g_roleName[newRole];
            // 正式开始前玩家只看到占位卡，认知基准也必须先遮成占位卡再比较。
            prevRole = BOTC_AmnesiaMaskRole(prevRole);
            prevA = BOTC_RoleAlign(prevRole);
        }
    }
    // 【复盘】（用户 2026-11-11）：身份变化一条，阵营跟着变时补上「善良→邪恶」
    rp = BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 的身份由「" + BOTC_RoleNameSafe(prevRole) + "」变为「" + BOTC_RoleNameSafe(newRole) + "」";
    if (prevA != BOTC_SeatAlign(q)) {
        rp = rp + "，阵营 " + BOTC_AlignName(prevA) + "→" + BOTC_AlignName(BOTC_SeatAlign(q));
    }
    BOTC_RpAdd(rp + "。");
    // 【本人魔典同步角色标记】（用户 2026-11-10）：红唇女郎继承恶魔 / 小恶魔自刀传位，
    //   以及方古 / 理发师 / 麻脸巫婆等身份转变后，当事人自己那份魔典上"自己这一格"必须
    //   立刻写成新的角色（继承到哪只恶魔就写哪只）。只重绘不写数据的话，本人的镜像行
    //   还停在旧身份，他会一直看到自己原来的角色。
    if (g_who[q] >= 1 && g_who[q] <= 13) {
        if (g_mark[(g_teller * 14) + q] <= 0) {
            g_mark[(g_who[q] * 14) + q] = 0;
        }
        else {
            g_mark[(g_who[q] * 14) + q] = BOTC_PlayerRoleView(q, g_mark[(g_teller * 14) + q] - 1) + 1;
        }
    }
    // 【本人魔典自动刷新】（用户 2026-11-05）：方古 / 理发师 / 麻脸巫婆等身份转变后，
    //   以前只有全员追忆才会刷本人那份魔典，普通板子会一直显示旧身份。
    BOTC_GrimRender(g_who[q]);
    // 【认知层面没变化就不通知】（用户 2026-11-06）：疯子被灵言师 / 方古转阵营、
    //   提线木偶被转成自己以为的身份等，玩家看到的东西没变，不必私聊打扰他。
    if (prevRole == newRole && prevA == BOTC_SeatAlign(q)) {
        BOTC_PmStore(g_teller, "【身份转变】" + BOTC_NameStr(q) + " 的认知没有变化 → 不通知他。");
        return;
    }
    BOTC_PmInfo(g_who[q], "【身份转变】你的身份转变：" + shown + "。");
    BOTC_PmStore(g_teller, "【身份转变】" + BOTC_NameStr(q) + " → " + s + "。");
}

void BOTC_HagOpen (int p) {
    int k;
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    // 官方移除时机：麻脸巫婆下一次夜晚行动时，把上一次的「角色变化（麻脸巫婆）」标记收掉（用户 2026-09-21）
    for (k = 2; k <= 13; k += 1) {
        g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
    }
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_hagPick = true;
    g_hagActor = p;
    g_hagAsk = 0;
    g_hagConfirmOk = false;
    g_pickMode[g_who[p]] = 15;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], false);   // 整张板子的角色都能选
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

// 【麻脸巫婆 · 落难少女 / 跨阵营二次确认】（用户 2026-11-03）
void BOTC_HagApply (int who, int role) {
    int oldR;
    int oldA;
    int hagSeat;
    if (who < 1 || who > 13 || role < 0 || role > 163) {
        return;
    }
    // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：一个在场时，创造另一个失败；
    //   只私聊提醒说书人，不向玩家透露任何结果。若被改造者本人就是那个克星，改完只剩一个 → 允许。
    if (role == 100 && BOTC_RoleInPlayOther(101, who)) {
        g_hagActor = 0;
        BOTC_PmStore(g_teller, "【麻脸巫婆】场上已经有「异端分子」→ 不能创造「痢蛭」（互为克星，同一时间只能有一个在场）；这次改造失败。");
        return;
    }
    if (role == 101 && BOTC_RoleInPlayOther(100, who)) {
        g_hagActor = 0;
        BOTC_PmStore(g_teller, "【麻脸巫婆】场上已经有「痢蛭」→ 不能创造「异端分子」（互为克星，同一时间只能有一个在场）；这次改造失败。");
        return;
    }
    hagSeat = g_hagActor;
    oldR = BOTC_SeatTrueRole(who);
    // 【唯一恶魔】（用户 2026-11-10）：把场上唯一一只恶魔熬成非恶魔角色 → 先问说书人要不要让她改变选择
    if (hagSeat >= 1 && !g_hagConfirmOk && BOTC_HagOnlyDemon(who, role)) {
        BOTC_HagDemonAskOpen(who, role, hagSeat);
        return;
    }
    if (role == 82 && oldR != 82 && hagSeat >= 1 && !g_hagDamselBypass) {
        // 【酒鬼假身份不算在场】（用户 2026-11-13）：只看真身，别把「以为自己是落难少女的酒鬼」当成她在场
        if (BOTC_RoleTrueInPlay(82)) {
            g_hagActor = 0;
            BOTC_PmStore(g_teller, "【麻脸巫婆】落难少女已经在场 → 无事发生。");
            return;
        }
        BOTC_DamselAskOpenHag(who, hagSeat);
        return;
    }
    oldA = BOTC_SeatAlign(who);
    if (hagSeat >= 1 && !g_hagConfirmOk && BOTC_RoleAlign(role) != oldA && !BOTC_RoleTrueInPlay(role)) {
        BOTC_HagConfirmOpen(who, role, hagSeat);
        return;
    }
    g_hagConfirmOk = false;
    g_hagActor = 0;
    BOTC_HagApplyReal(who, role);
    g_hagDamselBypass = false;
}

// 真的把人变成那个角色（阵营不变；转变当晚算他的「首个夜晚」）
void BOTC_HagApplyReal (int who, int role) {
    int oldR;
    int oldA;
    if (who < 1 || who > 13 || role < 0 || role > 163) {    // 允许 1（用户 2026-09-21）
        return;
    }
    // 【克星互斥 · 异端分子 × 痢蛭】（用户 2026-11-13）：兜底再判一次（跨阵营二次确认等路径会直接走到这里）。
    if (role == 100 && BOTC_RoleInPlayOther(101, who)) {
        g_hagActor = 0;
        BOTC_PmStore(g_teller, "【麻脸巫婆】场上已经有「异端分子」→ 不能创造「痢蛭」（互为克星，同一时间只能有一个在场）；这次改造失败。");
        return;
    }
    if (role == 101 && BOTC_RoleInPlayOther(100, who)) {
        g_hagActor = 0;
        BOTC_PmStore(g_teller, "【麻脸巫婆】场上已经有「痢蛭」→ 不能创造「异端分子」（互为克星，同一时间只能有一个在场）；这次改造失败。");
        return;
    }
    oldR = BOTC_SeatTrueRole(who);
    // 【相克 · 麻脸巫婆 × 落难少女】（用户 2026-10-03）：她选落难少女时**不自动改人**，
    //   改由说书人手动指定谁变成落难少女（用户 2026-11-03：改成弹出说书人选座面板）。
    if (role == 82 && oldR != 82 && !g_hagDamselBypass && g_hagActor >= 1) {
        BOTC_DamselAskOpenHag(who, g_hagActor);
        return;
    }
    // 官方：那个角色已经在场 → 无事发生（她本人不会知道结果）
    // 【酒鬼假身份不算在场】（用户 2026-11-13）：在场判定只看真身，
    //   酒鬼 / 疯子 / 提线木偶 / 悟道者「以为自己是」的那张卡不再挡住麻脸巫婆创造真角色。
    // 【用户 2026-10-16 报的 BUG】：原来还挂了个「&& oldR != role」的例外，结果「熬在场的恶魔 / 熬他本人那一格」
    //   会绕过这一条，一路走到「造出恶魔 → 生死无常面板」那支 ✗。按官方口径，只要那个角色在场就什么都不发生。
    if (BOTC_RoleTrueInPlay(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】她选的角色（" + g_roleName[role] + "）已经在场 → 无事发生。");
        return;
    }
    // 【利维坦×麻脸巫婆】第五天之后不能把利维坦加入游戏（用户 2026-10-20：本板子启用这条相克）。
    if (role == 127 && g_levAfterFifth) {
        BOTC_PmStore(g_teller, "【利维坦×麻脸巫婆】第五个白天已经结束 → 这次创造利维坦无效。");
        BOTC_Notice(g_teller, "第五个白天之后不能再创造利维坦。");
        return;
    }
    oldA = BOTC_SeatAlign(who);
    g_hagOldRole = oldR;
    // 【认知覆盖先不落地】（用户 2026-10-19）：酒鬼 / 疯子 / 悟道者只是麻脸巫婆这次能力的「认知外壳」。
    //   第一层选完后先不要改真身、不要给目标发身份提示，只打开第二层让他「以为是谁」的面板。
    //   等 BOTC_HagBelieve() 选完再一次性提交，避免目标先看到酒鬼 / 疯子本身。
    if (role == 14 || role == 38 || role == 118) {
        BOTC_HagBelieveOpen(who, role);
        return;
    }
    // 转变当晚算他的「首个夜晚」：排在麻脸巫婆之后的「你的首个夜晚」角色当晚就能行动（用户 2026-09-21）
    //   必须先写在 SetSeatRole 之前，否则那里的「本夜夜序是否已过」判断读不到正确顺序（用户 2026-11-09）
    g_seatFirstNight[who] = g_nightNum;
    BOTC_SetSeatRole(g_teller, who, role);
    // 阵营不变：只有当「转变后的身份自带阵营」跟「他原来的阵营」不一样时，才需要打「善良(14) / 邪恶(15)」
    //   token 去把它钉住（用户 2026-09-21：转变后的身份跟原来同阵营就不用打）。
    //   认知覆盖已经在上面提前转交第二层，不会走到这里。
    if (BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    // 转变当晚算他的「首个夜晚」：已在 BOTC_SetSeatRole 之前写好（用户 2026-11-09）
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;        // 角色变化（麻脸巫婆）：官方提示标记
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
    BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + "（原 " + BOTC_RoleNameSafe(oldR) + "）变成 " + g_roleName[role] + "，阵营不变（" + BOTC_AlignName(BOTC_SeatAlign(who)) + "）。");
    if (BOTC_SeatAlign(who) != BOTC_RoleAlign(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】注意：他的阵营跟这张身份自带的阵营不一样，因为他身上带着「" + BOTC_AlignName(BOTC_SeatAlign(who)) + "」标记（更早的转变 / 莽夫那类能力 / 你手动打的）。要改就先把那个标记撤掉。");
    }
    // 认知覆盖角色已在函数开头转交第二层；选完后由 BOTC_HagBelieve() 一次性提交。
    BOTC_ChangeRoleMsg(who, role);
    // 【数学家】（用户 2026-09-21）：改造完之后他的真身应该就是面板上那个身份；不是 → 记一格「未正常生效」
    if (BOTC_SeatTrueRole(who) != role) {
        BOTC_MalfNote(who, "麻脸巫婆改造后的真身和面板选的身份不符");
    }
    // 【洗脑师那条不用核】：她的效果是「疯狂」，脚本没法判定他到底疯没疯（纯 token + 说书人裁定，用户 2026-09-21）
    if (role == 64) {
        // 【新的镜像双子登场】（用户 2026-09-21）：旧配对已经作废，这时候直接把配对面板弹给说书人
        g_twinA = who;
        g_twinB = 0;
        g_twinPick = false;
        BOTC_PmStore(g_teller, "【镜像双子】现在场上有镜像双子（" + BOTC_NameStr(who) + "）：请你给他配一名对立双子（身份都能选）。");
        BOTC_MiFnOpen(who, 23);
    }
    if (BOTC_RoleTeam(role) == 3) {
        g_autoWoke[who] = false;           // 造出来的恶魔：当晚还要按恶魔那一格被唤醒
        g_testWoke[who] = false;
    }
    // 【诺-达鲺造出来 / 换位后】（用户 2026-11-04）：确保旧恶魔周围的中毒标记清掉、新恶魔两侧重新标记
    if (role == 70) {
        BOTC_NoDashiiSync();
    }
    BOTC_HagDemonCheck(role);
}

// 造出恶魔 → 当晚死亡由说书人定：恶魔自己的刀无效 + 开「生死无常」面板
void BOTC_HagDemonCheck (int role) {
    if (role < 0 || role > 163) {
        return;
    }
    if (BOTC_RoleTeam(role) != 3) {
        return;
    }
    g_hagNoDemonKill = true;
    BOTC_PmStore(g_teller, "【麻脸巫婆】她造出了一只恶魔（" + g_roleName[role] + "）→ 今晚恶魔自己的刀无效，改由你在「生死无常」面板里决定 0~2 个人死。");
    BOTC_HagKillOpen();
}

void BOTC_HagKillOpen () {
    g_hagKill = true;
    BOTC_SkillOpen(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择两名玩家"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【麻脸巫婆】请在你的面板里决定今晚死谁：最多 2 个，也可以点【取消】一个都不杀。");
}

// 说书人定了谁死（0~2 个）：死因是「死亡（麻脸巫婆）」---- 不算恶魔杀，不触发被恶魔杀死的技能
void BOTC_HagKill (int p, int a, int b) {
    int n;
    n = 0;
    if (a >= 2 && a <= 13 && !BOTC_SeatDead(a)) {
        BOTC_MarkDeathByTok(a, 93);
        // 【不公聊】（用户 2026-09-21）：生死无常造成的死亡**不在公屏单独播「【麻脸巫婆】X 死亡」**----
        //   那样等于把她说出来了。天亮统一按普通死亡播报「昨晚 X 死亡」就行（上面那句 MarkDeathByTok 已经排进队列）。
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(a) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    if (b >= 2 && b <= 13 && b != a && !BOTC_SeatDead(b)) {
        BOTC_MarkDeathByTok(b, 93);
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(b) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    g_hagKill = false;
    // 【收面板】（用户 2026-09-21）：生死无常结算完把面板关掉、停止继续选目标，不然会一直挂在说书人脸上
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (n == 0) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚没有让任何人死。");
    }
    BOTC_CheckWin();
}

// 酒鬼 / 疯子：由说书人再选一次他「以为自己是哪个角色」（跟哲学家那套一样）
void BOTC_HagBelieveOpen (int who, int kind) {
    int q;
    g_hagWho = who;
    g_cerenRole = kind;                 // 借用这个全局记一下：14 = 酒鬼 / 38 = 疯子 / 118 = 悟道者
    g_pickMode[g_teller] = 16;
    g_pickWho[g_teller] = who;
    g_pickTeam = 0;                     // 酒鬼只列镇民
    if (kind == 38) {
        g_pickTeam = 3;                 // 疯子只列恶魔
    }
    if (kind == 118) {
        g_pickTeam = 1;                 // 【悟道者（118）】（用户 2026-10-16）：只列外来者
    }
    BOTC_PickFilter(g_teller, false);
    if (kind == 14) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个镇民？"), PlayerGroupSingle(g_teller));
    }
    else {
        if (kind == 118) {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪只恶魔？"), PlayerGroupSingle(g_teller));
        }
    }
    // 【认知覆盖类不能当那张卡】（用户 2026-10-16）：酒鬼(14) / 疯子(38) 从网格里藏起来
    if (kind == 118) {
        for (q = 0; q < 64; q += 1) {
            if (g_gridSlot[q] == 14 || g_gridSlot[q] == 38) {
                DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
            }
        }
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_HagBelieve (int role) {
    int who;
    int kind;
    int oldA;
    int prevPerc;
    int prevRole;
    int newRole;
    who = g_hagWho;
    kind = g_cerenRole;
    if (who < 2 || who > 13 || role < 0 || role > 163) {
        return;
    }
    oldA = BOTC_SeatAlign(who);
    // 【改造前的认知】（用户 2026-11-06）：先记下他原来「以为的身份 / 阵营」，
    //   改造后认知层面没变就不私聊打扰他。
    prevPerc = BOTC_PerceivedAlign(who);
    prevRole = g_mark[(g_teller * 14) + who] - 1;
    // 转变当晚算他的「首个夜晚」：必须先写在 SetSeatRole 之前，否则那里的「本夜夜序是否已过」判断读不到正确顺序（用户 2026-11-09）
    g_seatFirstNight[who] = g_nightNum;
    // 【认知身份与原身份相同也要让旧身份离场】（用户 2026-10-19）：表面上不改格子里的卡，
    //   但真身已经从原来的角色变成酒鬼 / 疯子 / 悟道者。先走一次旧角色离场，再写回说书人选中的认知身份；
    //   中间不刷新玩家魔典，所以目标不会看到认知覆盖角色本身。
    if (role == g_hagOldRole) {
        BOTC_SetSeatRole(g_teller, who, kind);
    }
    g_pickMode[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    if (kind == 38) {
        // 疯子：真身是疯子，但魔典上按「他以为自己是的那只恶魔」显示（跟原本的疯子一样，用户 2026-09-21）
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 49] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成疯子（认知自己是" + g_roleName[role] + "）。");
    }
    else if (kind == 118) {
        // 【悟道者（118）】（用户 2026-10-16）：跟酒鬼同一套 ---- 真身是悟道者，魔典上按「他以为自己是那个外来者」显示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 140] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成悟道者（认知自己是" + g_roleName[role] + "）。");
    }
    else {
        // 酒鬼：真身是酒鬼，魔典上按「他以为自己是那个镇民」显示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 8] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成酒鬼（认知自己是" + g_roleName[role] + "）。");
    }
    // 【选完才提交身份变化的配套状态】（用户 2026-10-19）：阵营固定、首个夜晚、官方角色变化标记，
    //   原来在 BOTC_HagApply() 第一层就提前写了；现在只能在第二层选完后补上。
    if (kind == 14 || kind == 38 || BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    // 转变当晚算他的「首个夜晚」：已在 BOTC_SetSeatRole 之前写好（用户 2026-11-09）
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
    // 【身份转变提示】（用户 2026-11-06）：只比较玩家认知层面的变化。
    //   麻脸巫婆造出的认知只覆盖角色、不覆盖阵营，阵营按改造后的实际阵营比较：
    //   提线木偶 → 占卜师 / → 酒鬼占卜师 都是从「善良占卜师」变成「邪恶占卜师」，要通知；
    //   善良哲学家 → 疯子（以为自己是小恶魔）只报「小恶魔」，不追加善良 / 邪恶前缀。
    newRole = role;
    if (g_board == 13 && g_nightNum == 0) {
        newRole = BOTC_AmnesiaMaskRole(role);
    }
    if (prevRole != newRole || prevPerc != BOTC_SeatAlign(who)) {
        BOTC_PmInfo(g_who[who], "【身份转变】你的身份转变：" + BOTC_TransitionRoleName(prevPerc, BOTC_SeatAlign(who), newRole) + "。");
    }
    else {
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 的认知没有变化 → 不发身份转变提示。");
    }
}
//==================================================================================================
// 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）
//   相克：只要要把某位玩家变成落难少女（或理发师交换涉及落难少女），都改为说书人指定谁当落难少女。
//   麻脸巫婆把善良玩家变成爪牙/恶魔、或把邪恶玩家变成镇民/外来者时，还要说书人二次确认；
//   说书人拒绝 → 她重新选择。
//==================================================================================================
void BOTC_BuildHagAsk () {
    DialogCreate(684, 153, c_anchorRight, 185, -10, false);
    g_hagAskDlg = DialogLastCreated();
    DialogSetVisible(g_hagAskDlg, PlayerGroupAll(), false);
    g_hagAskTitle = BOTC_NewLabel(g_hagAskDlg, 666, 44, 18, 13, StringToText("【麻脸巫婆】确认这次身份改造？"));
    libNtve_gf_SetDialogItemStyle(g_hagAskTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_hagAskTitle, false, PlayerGroupAll());
    g_hagAskYes = BOTC_NewButton(g_hagAskDlg, 306, 50, 27, 81, "是：确认改造");
    g_hagAskNo = BOTC_NewButton(g_hagAskDlg, 306, 50, 351, 81, "否：让她重选");
    g_hagAskX = BOTC_NewButton(g_hagAskDlg, 30, 26, 640, 6, "X");
    DialogControlSetVisible(g_hagAskYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskX, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskX, PlayerGroupSingle(g_teller), true);
}

// 弹给说书人：这次改造会跨阵营，确认还是让她重选？
void BOTC_HagConfirmOpen (int who, int role, int hagSeat) {
    if (who < 2 || who > 13 || role < 0 || role > 163 || hagSeat < 1 || hagSeat > 13) {
        return;
    }
    g_hagAsk = 1;
    g_hagAskWho = who;
    g_hagAskRole = role;
    g_hagAskActor = hagSeat;
    g_hagActor = hagSeat;
    libNtve_gf_SetDialogItemText(g_hagAskTitle, StringToText("【麻脸巫婆】把 ") + StringToText(BOTC_NameStr(who)) + StringToText("（原") + StringToText(g_roleName[BOTC_SeatTrueRole(who)]) + StringToText("）变成「") + StringToText(g_roleName[role]) + StringToText("」？阵营会变，是否确认？"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_hagAskYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_hagAskDlg, PlayerGroupSingle(g_teller), true);
}

// 【麻脸巫婆 · 唯一恶魔】（用户 2026-11-10）
//   目标是不是场上唯一一只还活着的恶魔，而且这次选的角色不是恶魔。
bool BOTC_HagOnlyDemon (int who, int role) {
    int q;
    int n;
    if (who < 2 || who > 13 || role < 0 || role > 163) {
        return false;
    }
    if (BOTC_SeatDead(who) || !BOTC_IsDemonSeat(who)) {
        return false;
    }
    if (BOTC_RoleTeam(role) == 3) {
        return false;
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!BOTC_SeatDead(q) && BOTC_IsDemonSeat(q)) {
            n = n + 1;
        }
    }
    return (n <= 1);
}

// 弹给说书人：这次改造会把场上唯一的恶魔熬成非恶魔，要不要让她改变选择？
//   是（或 X）= 让她重选 / 否 = 仍然改造
void BOTC_HagDemonAskOpen (int who, int role, int hagSeat) {
    if (who < 2 || who > 13 || role < 0 || role > 163 || hagSeat < 1 || hagSeat > 13) {
        return;
    }
    g_hagAsk = 2;
    g_hagAskWho = who;
    g_hagAskRole = role;
    g_hagAskActor = hagSeat;
    g_hagActor = hagSeat;
    libNtve_gf_SetDialogItemText(g_hagAskTitle, StringToText("【麻脸巫婆】要把场上唯一的恶魔 ") + StringToText(BOTC_NameStr(who)) + StringToText("（原") + StringToText(g_roleName[BOTC_SeatTrueRole(who)]) + StringToText("）变成「") + StringToText(g_roleName[role]) + StringToText("」，之后场上就没有恶魔了。是否让她改变选择？"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_hagAskYes, StringToText("是：让她重选"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_hagAskNo, StringToText("否：仍然改造"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_hagAskYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_hagAskDlg, PlayerGroupSingle(g_teller), true);
}

// 说书人的二次确认：1 = 同意改造 / 0 = 拒绝（让她重新选）/ -1 = 点了 X（按不改造处理）
void BOTC_HagAskAnswer (int ans) {
    int who;
    int role;
    int hagSeat;
    int mode;
    if (g_hagAsk <= 0) {
        return;
    }
    mode = g_hagAsk;
    who = g_hagAskWho;
    role = g_hagAskRole;
    hagSeat = g_hagAskActor;
    g_hagAsk = 0;
    g_hagAskWho = 0;
    g_hagAskRole = 0;
    g_hagAskActor = 0;
    DialogSetVisible(g_hagAskDlg, PlayerGroupSingle(g_teller), false);
    // 【唯一恶魔】（用户 2026-11-10）：这一问的按钮文案是反的，问完先恢复默认
    if (mode == 2) {
        libNtve_gf_SetDialogItemText(g_hagAskYes, StringToText("是：确认改造"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_hagAskNo, StringToText("否：让她重选"), PlayerGroupSingle(g_teller));
        if (ans != 0) {                 // 是 / X → 不改造，让她重新选
            g_hagDamselBypass = false;
            g_hagActor = 0;
            if (hagSeat >= 1 && hagSeat <= 13) {
                BOTC_PmStore(g_teller, "【麻脸巫婆】说书人不让她把场上唯一的恶魔熬成别的东西 → 她需要重新选择。");
                g_hagPick = false;
                g_hagConfirmOk = false;
                g_hagActor = hagSeat;
                BOTC_SkillOpen(hagSeat);
            }
            return;
        }
        // 否 → 仍然改造：已经问过「唯一恶魔」这一条，跳过跨阵营那条，免得连着弹两次
        g_hagConfirmOk = true;
        g_hagActor = hagSeat;
        BOTC_HagApply(who, role);
        return;
    }
    if (ans > 0) {
        g_hagConfirmOk = true;
        g_hagActor = hagSeat;
        BOTC_HagApply(who, role);
        return;
    }
    g_hagDamselBypass = false;
    g_hagActor = 0;
    if (hagSeat >= 1 && hagSeat <= 13) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】说书人拒绝这次跨阵营改造 → 她需要重新选择角色。");
        g_hagPick = false;
        g_hagConfirmOk = false;
        g_hagActor = hagSeat;
        BOTC_SkillOpen(hagSeat);
    }
}

// 理发师交换：把「今晚理发」标记撤掉、恢复状态
void BOTC_DamselBarberClear () {
    if (g_barberSeat >= 2 && g_barberSeat <= 13) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_SkillBtnRender();
}

// 麻脸巫婆选到落难少女：由说书人点一名玩家变成落难少女
void BOTC_DamselAskOpenHag (int who, int hagSeat) {
    if (hagSeat < 1 || hagSeat > 13) {
        hagSeat = g_hagActor;
    }
    if (hagSeat < 1 || hagSeat > 13) {
        return;
    }
    g_damselAsk = 1;
    g_damselHagWho = who;
    g_damselHagActor = hagSeat;
    g_damselAskA = 0;
    g_damselAskB = 0;
    g_damselBarberP = 0;
    g_hagActor = 0;
    g_hagAsk = 0;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    g_skillPicking[1] = true;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), true);
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_who[1]));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_who[1]), true);
    libNtve_gf_SetDialogItemText(g_skillCancel[1], StringToText("取消"), PlayerGroupSingle(g_who[1]));
    BOTC_PmStore(g_teller, "【麻脸巫婆×落难少女】由你指定一名玩家变成落难少女（她原本选中的是 " + BOTC_NameStr(who) + "）。");
}

// 理发师交换到落难少女：由说书人在两名候选里指定谁当落难少女
void BOTC_DamselAskOpenBarber (int p, int a, int b) {
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    g_damselAsk = 2;
    g_damselAskA = a;
    g_damselAskB = b;
    g_damselBarberP = p;
    g_damselHagWho = 0;
    g_damselHagActor = 0;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    g_skillPicking[1] = true;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), true);
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_who[1]));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_who[1]), true);
    libNtve_gf_SetDialogItemText(g_skillCancel[1], StringToText("取消"), PlayerGroupSingle(g_who[1]));
    BOTC_PmStore(g_teller, "【理发师×落难少女】由你指定谁当落难少女：候选 " + BOTC_NameStr(a) + " 和 " + BOTC_NameStr(b) + "。点一名玩家后【确认】；【取消】= 这次不交换。");
}

// 理发师：说书人已经选定落难少女 → 选中的是原来那位 = 不交换，另一位 = 正常交换
void BOTC_DamselBarberApply (int a, int b, int choose) {
    int p;
    int ra;
    int rb;
    int ds;
    p = g_damselBarberP;
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    ra = BOTC_SeatTrueRole(a);
    rb = BOTC_SeatTrueRole(b);
    if (ra == 82) {
        ds = a;
    }
    else {
        if (rb == 82) {
            ds = b;
        }
        else {
            ds = 0;
        }
    }
    if (ds > 0 && choose == ds) {
        BOTC_DamselBarberClear();
        BOTC_PmStore(g_teller, "【理发师×落难少女】说书人指定 " + BOTC_NameStr(ds) + " 继续当落难少女 → 这次不交换。");
        return;
    }
    g_damselBarberBypass = true;
    BOTC_BarberSwap(p, a, b);
    g_damselBarberBypass = false;
    BOTC_PmStore(g_teller, "【理发师×落难少女】说书人指定 " + BOTC_NameStr(choose) + " 成为落难少女 → 正常交换。");
}

void BOTC_DamselAskCancel () {
    int kind;
    int p;
    kind = g_damselAsk;
    p = g_damselBarberP;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    g_damselAsk = 0;
    g_damselAskA = 0;
    g_damselAskB = 0;
    g_damselBarberP = 0;
    g_damselHagWho = 0;
    g_damselHagActor = 0;
    g_hagDamselBypass = false;
    if (kind == 2) {
        BOTC_DamselBarberClear();
        BOTC_PmStore(g_teller, "【理发师×落难少女】说书人取消 → " + BOTC_NameStr(p) + " 这次不交换。");
        return;
    }
    if (kind == 1) {
        BOTC_PmStore(g_teller, "【麻脸巫婆×落难少女】说书人取消 → 这次不产生落难少女。");
    }
}

void BOTC_DamselAskConfirm (int t) {
    int kind;
    int a;
    int b;
    kind = g_damselAsk;
    if (kind <= 0) {
        return;
    }
    if (t < 2 || t > 13) {
        BOTC_Notice(g_teller, "先点一名玩家再确认。");
        return;
    }
    if (kind == 2 && (t != g_damselAskA && t != g_damselAskB)) {
        BOTC_Notice(g_teller, "理发师的交换只能在这两名玩家之间选择落难少女。");
        return;
    }
    a = g_damselAskA;
    b = g_damselAskB;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    g_damselAsk = 0;
    if (kind == 1) {
        g_hagActor = g_damselHagActor;
        g_hagDamselBypass = true;
        g_damselHagWho = 0;
        g_damselHagActor = 0;
        BOTC_HagApply(t, 82);
        return;
    }
    g_damselAskA = 0;
    g_damselAskB = 0;
    BOTC_DamselBarberApply(a, b, t);
    g_damselBarberP = 0;
}

//==================================================================================================
// 【食人族（74）】（用户 2026-09-23）：吃到疯子的能力
//==================================================================================================
int BOTC_CannSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            return i;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_mark[(g_teller * 14) + i] - 1 == 74) {
            return i;
        }
    }
    return 0;
}

// 只给「自动打中毒 token」用：借用食人族能力的玩家也算在内。
//   不能拿它去做改身份 / 变身那套，否则会把失忆者改成恶魔。
int BOTC_CannAbilitySeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 74)) {
            return i;
        }
    }
    return 0;
}

// 【食人族（74）· 持续检测】（用户 2026-11-10）：
//   「饱餐」永远只挂在最后一名死于处决的玩家角色标记旁，跨夜不清；下一名玩家死于处决时转移。
//   「中毒（食人族）」跟着「饱餐」持有人的当前阵营走：邪恶 → 食人族中毒；变善良 → 摘掉。
//   因为每次都按当前状态重算，食人族中途被创造（麻脸巫婆 / 理发师 / 舞蛇人 / 说书人改身份 /
//   借用能力）时会自动补放这两枚标记，不依赖当时有没有提前放好标记。
void BOTC_CannSync () {
    int i;
    int cs;
    int bearer;
    bool bad;
    bearer = g_cannFedSeat;
    if (bearer < 2 || bearer > 13) {
        bearer = 0;
    }
    // 饱餐：只保留在最后一名死于处决的玩家身上
    for (i = 2; i <= 13; i += 1) {
        if (i == bearer) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 206] = true;
        }
        else if (g_tokOn[(((g_teller * 14) + i) * 256) + 206]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 206] = false;
        }
    }
    cs = BOTC_CannSeat();
    if (cs < 2) {
        // 【失忆者 / 借用能力者】（用户 2026-11-06）：中毒标记要落到能力持有者身上。
        cs = BOTC_CannAbilitySeat();
    }
    bad = false;
    if (bearer > 0) {
        // 【间谍 / 陌客能力者】（用户 2026-11-12）：按说书人对这次处决的裁定算。
        if (BOTC_IsDisguiseAbility(bearer) && g_cannFedEvilSet[bearer]) {
            bad = g_cannFedEvil[bearer];
        }
        else {
            bad = (BOTC_SeatAlign(bearer) == 1);
        }
    }
    if (cs < 2 || cs > 13 || cs == bearer || BOTC_SeatDead(cs)) {
        bad = false;
    }
    // 中毒：只在「饱餐」持有人当前为邪恶阵营时挂在食人族身上
    for (i = 2; i <= 13; i += 1) {
        if (bad && i == cs) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 178] = true;
        }
        else if (g_tokOn[(((g_teller * 14) + i) * 256) + 178]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 178] = false;
        }
    }
    if (bad) {
        g_cannPoisonSeat = cs;
    }
    else {
        g_cannPoisonSeat = 0;
    }
}

// 【处决死亡的食人族钩子】（用户第 6 / 7 条 + 2026-11-10 的持续检测规则）：
//   1. 「饱餐 / 中毒」统一交给 BOTC_CannSync 按最新状态重算；
//   2. 只要今天有人死于处决且食人族存活，夜里就先给他发一次能力。
void BOTC_CannExecHooks (int q) {
    int cs;
    int oldPoison;
    if (q < 1 || q > 13) {
        return;
    }
    // 【食人族 × 间谍 / 陌客能力者】（用户 2026-11-12）：死亡者是否邪恶由说书人裁定。
    if (q >= 2 && BOTC_IsDisguiseAbility(q) && !g_cannFedEvilSet[q] && (BOTC_CannSeat() >= 2 || BOTC_CannAbilitySeat() >= 2)) {
        BOTC_JudgeAsk(17, "【食人族】" + BOTC_NameStr(q) + "（间谍 / 陌客能力者）死于处决：这次是否按邪恶阵营结算？", q, 0, 0);
        BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(q) + " 是间谍 / 陌客能力者 → 请选择这次处决是否按邪恶阵营结算。");
        return;
    }
    oldPoison = g_cannPoisonSeat;
    BOTC_CannSync();
    cs = BOTC_CannSeat();
    if (cs < 2) {
        cs = BOTC_CannAbilitySeat();
    }
    if (cs < 2 || cs > 13 || cs == q || BOTC_SeatDead(cs)) {
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【食人族吃到疯子】（用户 2026-11-08）：疯子不提供任何可用的夜间能力，
    //   夜里不再弹「选择他获得的能力」，认知提醒已经在处决时由模式 17 面板完成。
    if (BOTC_SeatTrueRole(q) != 38) {
        g_cannPending = 1;
    }
    if (g_cannPoisonSeat == cs && oldPoison != cs) {
        BOTC_PmStore(g_teller, "【食人族】邪恶角色 " + BOTC_NameStr(q) + " 死于处决 → " + BOTC_NameStr(cs) + " 自动中毒；「饱餐」已转移到 " + BOTC_NameStr(q) + "。");
    }
    BOTC_CannLockCheck(q);
    BOTC_GrimRender(g_teller);
}

// 【食人族 × 异教领袖 / 莽夫】（用户 2026-11-10）
//   这个座位自己能不能被改阵营：异教领袖 / 莽夫能力持有者算「能转变」。
bool BOTC_AlignCanChange (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    return (BOTC_HasAbility(q, 37) || BOTC_HasAbility(q, 106));
}

// 【食人族 × 异教领袖 / 莽夫】（用户 2026-11-10）：食人族当前不在原阵营时，
//   另一名无法转变阵营的玩家死于处决 → 锁定他现在的阵营。
void BOTC_CannLockCheck (int dead) {
    int i;
    int al;
    if (dead < 2 || dead > 13) {
        return;
    }
    if (BOTC_AlignCanChange(dead)) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (i == dead) {
            continue;
        }
        if (g_cannOrigAlign[i] < 0 || g_cannLocked[i]) {
            continue;
        }
        if (!BOTC_HasAbility(i, 74)) {
            continue;
        }
        al = BOTC_SeatRegAlign(i);
        if (al == g_cannOrigAlign[i]) {
            continue;
        }
        g_cannLocked[i] = true;
        BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(i) + " 仍是 " + BOTC_AlignName(al) + " 阵营时，无法转变阵营的 " + BOTC_NameStr(dead) + " 死于处决 → " + BOTC_NameStr(i) + " 的阵营锁定为 " + BOTC_AlignName(al) + "。");
    }
}

void BOTC_CannAfterExec (int q) {
    int cs;
    int kind;
    BOTC_CannRevert();
    cs = BOTC_CannSeat();
    if (cs < 2 || cs == q) {
        return;
    }
    kind = 0;
    if (BOTC_SeatTrueRole(q) == 38) {
        kind = 38;
    }
    if (kind == 0) {
        return;
    }
    // 【食人族吃到疯子】（用户 2026-11-08）：只做认知提醒，不改身份、不打标记、不进夜序，
    //   所以这里不再写 g_cannKind，避免下一次处决被 BOTC_CannRevert 当成「变过身」去还原。
    g_cannSeat = cs;
    g_cannSrc = q;
    BOTC_CannOpen(kind);
}

void BOTC_CannRevert () {
    int cs;
    cs = g_cannSeat;
    if (cs < 2) {
        cs = BOTC_CannSeat();
    }
    if (cs < 2) {
        return;
    }
    if (BOTC_SeatDead(cs)) {
        return;                  // 食人族死了：不还原，他始终是带着那两个标记的那个角色
    }
    if (g_cannKind > 0 || g_tokOn[(((g_teller * 14) + cs) * 256) + 97]) {
        BOTC_SetSeatRole(g_teller, cs, 74);
        g_tokOn[(((g_teller * 14) + cs) * 256) + 49] = false;
        g_tokOn[(((g_teller * 14) + cs) * 256) + 97] = false;
        g_cannLun[cs] = false;
        g_cannLunDemon[cs] = -1;
        if (g_cannKind > 0) {
            BOTC_ChangeRoleMsg(cs, 74);
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 变回食人族。");
        }
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[cs]);
    }
    g_cannRole = 0;
    g_cannKind = 0;
    g_cannSeat = 0;
    g_cannSrc = 0;
}

void BOTC_CannOpen (int kind) {
    if (g_cannSeat < 2) {
        return;
    }
    g_pickMode[g_teller] = 17;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 3;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("食人族：选一只恶魔（疯子）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_CannPick (int role) {
    int cs;
    if (g_cannSeat < 2 || role < 0 || role > 163) {
        return;
    }
    cs = g_cannSeat;
    if (BOTC_RoleTeam(role) != 3) {
        BOTC_Notice(g_teller, "疯子只能选恶魔。");
        return;
    }
    // 【食人族×疯子】（用户 2026-11-10）：记住「他以为自己是哪只恶魔」。他之后会真的按疯子
    //   的夜序被唤醒、选一名玩家假刀（不产生死亡），再由脚本告诉恶魔：这名食人族是疯子 + 目标。
    g_cannLun[cs] = true;
    g_cannLunDemon[cs] = role;
    BOTC_PmInfo(g_who[cs], "你得知你现在把自己当成邪恶阵营的恶魔「" + g_roleName[role] + "」。");
    BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 吃到了疯子 → 他以为自己现在是邪恶阵营的恶魔 " + g_roleName[role] + "；疯子夜序会唤醒他假刀（不产生死亡），之后告诉恶魔他是疯子以及目标。");
    g_cannRole = 0;
    g_cannKind = 0;
    g_cannSeat = 0;
    g_cannSrc = 0;
}

//==================================================================================================
// 【不在场身份 · 统一发送】（用户 2026-11-04）
//   ① 所有自动 / 手动发送路径都走这里：3 个身份按**最新一次**整组覆盖旧值，同一玩家只保留最新一份；
//   ② 同时在私聊频道提醒说书人：哪 3 个身份发给了哪位玩家。
//==================================================================================================
string BOTC_BluffRoleNames (int r1, int r2, int r3) {
    return g_roleName[r1 - 1] + "," + g_roleName[r2 - 1] + "," + g_roleName[r3 - 1];
}

void BOTC_BluffSlotWrite (int who, int slot, int v) {
    libNtve_gf_SetDialogItemImage(g_bluffIcon[slot], BOTC_IconName(v - 1), PlayerGroupSingle(who));
    libNtve_gf_SetDialogItemText(g_bluffName[slot], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
    libNtve_gf_SetDialogItemStyle(g_bluffName[slot], "ModLeftSize20Bold", PlayerGroupSingle(who));
}

void BOTC_BluffGiveTo (int q, int r1, int r2, int r3) {
    int i;
    int v;
    int who;
    bool replaced;
    if (q < 2 || q > 13) {
        return;
    }
    if (r1 < 1 || r1 > 163 || r2 < 1 || r2 > 163 || r3 < 1 || r3 > 163) {
        return;
    }
    who = g_who[q];
    replaced = g_bluffGiveRole[(who * 3)] > 0;
    for (i = 0; i < 3; i += 1) {
        if (i == 0) {
            v = r1;
        }
        else if (i == 1) {
            v = r2;
        }
        else {
            v = r3;
        }
        g_bluffGiveRole[(who * 3) + i] = v;
        BOTC_BluffSlotWrite(who, i, v);
    }
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(who), true);
    g_bluffGot[who] = true;
    if (replaced) {
        BOTC_Notice(who, "说书人重新给了你 3 个不在场身份，以这次为准，看右下角面板。");
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + BOTC_NameStr(q) + "：" + BOTC_BluffRoleNames(r1, r2, r3) + "（覆盖了上一次发给他的 3 个身份）。");
    }
    else {
        BOTC_Notice(who, "说书人给了你 3 个不在场身份，看右下角面板。");
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + BOTC_NameStr(q) + "：" + BOTC_BluffRoleNames(r1, r2, r3) + "。");
    }
}

void BOTC_BluffSendToCannibal () {
    int i;
    int ca;
    ca = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            ca = i;
        }
    }
    if (ca < 2) {
        BOTC_NoticeBox(g_teller, "没找到「是食人族」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    BOTC_BluffGiveTo(ca, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

//==================================================================================================
// 【梦殒春宵 · 四个恶魔】（用户 2026-09-21）：68 方古 / 69 亡骨魔 / 70 诺-达鲺 / 71 涡流
//   四个都走统一恶魔击杀通道 BOTC_DemonStrike，死因各自打 64 / 65 / 66 / 67。
//   常驻效果：诺-达鲺两侧最近镇民中毒；涡流让镇民信息必错 + 没人被处决就邪恶胜；
//             亡骨魔让被杀爪牙保留能力、并让邻近镇民中毒（说书人挑一侧）。
//==================================================================================================

// 环形走位：从 from 出发沿 dir（+1 顺时针 / -1 逆时针）走到座位表里的下一个座位
int BOTC_RingNext (int from, int dir) {
    int i;
    int idx;
    int n;
    BOTC_BuildSeatList();
    n = g_seatN;
    if (n <= 0) {
        return 0;
    }
    idx = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == from) {
            idx = i;
        }
    }
    if (idx < 0) {
        return 0;
    }
    idx = idx + dir;
    if (idx < 0) {
        idx = n - 1;
    }
    if (idx >= n) {
        idx = 0;
    }
    return g_seatList[idx];
}

// 从 from 沿 dir 找下一个「真身镇民」（跳过节肢 / 外来者 / 爪牙 / 恶魔；死亡也算；skip 跳过某一格）
int BOTC_NextTownsfolk (int from, int dir, int skip) {
    int i;
    int q;
    BOTC_BuildSeatList();
    q = from;
    for (i = 0; i < g_seatN; i += 1) {
        q = BOTC_RingNext(q, dir);
        if (q < 2) {
            return 0;
        }
        if (q == skip) {
            continue;
        }
        if (BOTC_SeatTeam(q) == 0) {
            return q;
        }
    }
    return 0;
}

// 场上「活着、并且当前有这个恶魔能力」的座位在哪（0 = 没有 → 他的常驻效果也就没有了）
int BOTC_LiveDemonSeat (int role) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!BOTC_AbilityWorks(q, role)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        return q;
    }
    return 0;
}

// 【诺-达鲺（70）】两侧最近的镇民中毒（死亡也算）。
//   用户 2026-09-21 口径：毒钉在最近那个镇民身上，**他死了不蔓延**；
//   只有「他不再是镇民」（角色被换 / 换了位置）时才沿同一方向往外延到**下一个镇民**。
void BOTC_NoDashiiSync () {
    int q;
    int d;
    int keep;
    int oldA;
    int oldB;
    int oldDemon;
    oldA = g_nodA;
    oldB = g_nodB;
    oldDemon = g_nodDemon;
    d = BOTC_LiveDemonSeat(70);
    if (d < 2) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
        }
        g_nodA = 0;
        g_nodB = 0;
        g_nodDemon = 0;
        g_nodManual = false;
        if (oldA >= 2 || oldB >= 2) {
            BOTC_PmStore(g_teller, "【诺-达鲺】场上没有活着的诺-达鲺 → 两份「中毒（诺-达鲺）」都撤掉。");
            BOTC_GrimRender(g_teller);
        }
        return;
    }
    // 【换了一个诺-达鲺 / 换座位 / 身份变化】（用户 2026-10-19）：旧毒口只对「同一个诺-达鲺」有效；
    //   红唇女郎在另一个位置继位后，必须从新诺-达鲺的位置重新向两侧找最近镇民。
    if (g_nodDemon != d) {
        g_nodA = 0;
        g_nodB = 0;
        g_nodManual = false;
    }
    g_nodDemon = d;
    // 【手动优先】（用户 2026-10-19）：说书人在 token 面板改过诺-达鲺的毒口后，
    //   自动同步只记录实际标记，不再清掉重打；直到身份 / 座位再次变化才恢复自动重算。
    if (g_nodManual) {
        g_nodA = 0;
        g_nodB = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_tokOn[(((g_teller * 14) + q) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = q;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = q;
                }
            }
        }
        return;
    }
    // 顺时针那侧
    keep = 0;
    if (g_nodA >= 2 && g_seatOn[g_nodA] && BOTC_SeatTeam(g_nodA) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodA >= 2 && g_seatOn[g_nodA]) {
            g_nodA = BOTC_NextTownsfolk(g_nodA, 1, g_nodB);       // 他不再是镇民 → 沿这一侧再往外找一个
        }
        else {
            g_nodA = BOTC_NextTownsfolk(d, 1, g_nodB);
        }
    }
    // 逆时针那侧
    keep = 0;
    if (g_nodB >= 2 && g_seatOn[g_nodB] && BOTC_SeatTeam(g_nodB) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodB >= 2 && g_seatOn[g_nodB]) {
            g_nodB = BOTC_NextTownsfolk(g_nodB, -1, g_nodA);
        }
        else {
            g_nodB = BOTC_NextTownsfolk(d, -1, g_nodA);
        }
    }
    // 【和尚 × 诺-达鲺】：游戏中途新产生 / 换位的诺-达鲺若即将毒到和尚邻座，
    //   和尚压制这条持续中毒到黎明；诺-达鲺当晚的攻击不受影响。
    if (g_isNight && oldDemon != d && !g_heshangNoDashiiMute) {
        if (BOTC_HeshangTryBlockSeat(d, 70, g_nodA) || BOTC_HeshangTryBlockSeat(d, 70, g_nodB)) {
            g_heshangNoDashiiMute = true;
            BOTC_PmStore(g_teller, "【和尚】诺-达鲺的持续中毒被压制到下一个黎明；诺-达鲺当晚的攻击仍然有效。");
        }
    }
    if (g_heshangNoDashiiMute) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
        }
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【悟道者 × 诺-达鲺】：开局已经成型的诺-达鲺不触发；游戏过程中新产生 / 换位的
    //   诺-达鲺若让悟道者成为两侧镇民，则悟道者先变身，随后仍照常中毒。
    if (g_isNight && oldDemon != d) {
        BOTC_WudTryTrigger(g_nodA, d);
        BOTC_WudTryTrigger(g_nodB, d);
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
    }
    if (g_nodA >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodA) * 256) + 80] = true;
    }
    if (g_nodB >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodB) * 256) + 80] = true;
    }
    if (oldA != g_nodA || oldB != g_nodB) {
        BOTC_PmStore(g_teller, "【诺-达鲺】与他相邻的两名镇民中毒：" + BOTC_NameStr(g_nodA) + "（顺时针）/ " + BOTC_NameStr(g_nodB) + "（逆时针）。");
        BOTC_GrimRender(g_teller);
    }
}

// 【熊孩子（151）】：选中的镇民角色真实对应玩家获得「捣蛋」；借用能力不算。
void BOTC_RascalSync () {
    int s;
    int q;
    int role;
    for (q = 1; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 170] = false;
    }
    for (s = 1; s <= 13; s += 1) {
        if (!g_rascalActive[s]) {
            continue;
        }
        if ((s != 1 && !g_seatOn[s]) || BOTC_SeatDead(s) || !BOTC_HasAbility(s, 151)) {
            g_rascalActive[s] = false;
            g_rascalRole[s] = 0;
            continue;
        }
        role = g_rascalRole[s];
        if (role < 0 || role > 163 || BOTC_RoleTeam(role) != 0) {
            g_rascalActive[s] = false;
            g_rascalRole[s] = 0;
            continue;
        }
        for (q = 2; q <= 13; q += 1) {
            // 【熊孩子】只认真正持有该角色的玩家，变脸师临时借来的那张牌不算（用户 2026-11-13）。
            if (g_seatOn[q] && BOTC_SeatRealRole(q) == role) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 170] = true;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_RascalDuskClear () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        g_rascalActive[q] = false;
        g_rascalRole[q] = 0;
        g_tokOn[(((g_teller * 14) + q) * 256) + 170] = false;
    }
    BOTC_GrimRender(g_teller);
}

// 【涡流（71）】：只要他活着并且清醒，镇民玩家通过能力拿到的信息一定错 → 给镇民打提醒标记
void BOTC_VortoxSync () {
    int q;
    int d;
    int on;
    on = 0;
    d = BOTC_LiveDemonSeat(71);
    if (d >= 2) {
        on = 1;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (on == 1 && BOTC_SeatTeam(q) == 0) {
            BOTC_WudTryTrigger(q, d);
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = false;
        }
    }
    BOTC_GrimRender(g_teller);
}

// 【涡流（71）】每个黄昏：今天白天没有人被处决 → 邪恶阵营获胜
//   （处决了但没死也算「有人被处决」；流放旅行者不算 ---- 我们还没做旅行者）
void BOTC_VortoxDuskCheck () {
    int d;
    if (!g_started || g_gameOver) {
        return;
    }
    // 【第 1 夜之前不算】（用户 2026-09-21 救火）：入夜 1 时天号还是 0（准备阶段），
    //   那时候还没「白天」可谈 ---- 不加这一句，涡流第一晚就会直接判邪恶胜。
    if (g_dayNum < 1) {
        return;
    }
    d = BOTC_LiveDemonSeat(71);
    if (d < 2) {
        return;
    }
    if (g_execUsedToday) {
        BOTC_PmStore(g_teller, "【涡流】今天白天有人被处决 → 这条胜利条件不触发。");
        return;
    }
    BOTC_PmStore(g_teller, "【涡流】今天白天没有人被处决 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "*黑白颠倒，对错不再，左右变换，长短无猜。", "万物紊乱无可寻，短视死亡把命栽，何处寻答？随我来。*");
}

// 【亡骨魔（69）】被亡骨魔杀死的爪牙「保留能力」：带着 79 标记的爪牙，即使死了也照常行动
//   （百科：只要亡骨魔还活着就行；他不再是爪牙 / 死爪牙自己中毒醉酒时作废）
bool BOTC_KeepsAbilityAlive (int q) {
    int v;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 79]) {
        return false;
    }
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) {
        return false;
    }
    if (BOTC_SeatImpaired(q)) {
        return false;
    }
    v = BOTC_AbilitySeat(69);
    if (v < 2 || v > 13 || BOTC_SeatDead(v)) {
        return false;
    }
    return true;
}

// 亡骨魔杀了爪牙之后：弹面板让说书人从「顺时针 / 逆时针各取最近的一个镇民」里挑一个中毒
void BOTC_VigPickOpen (int minion, int a, int b) {
    string ta;
    string tb;
    BOTC_MiSeatFieldsReset();
    g_vigFrom = minion;
    g_vigA = a;
    g_vigB = b;
    ta = "（这一侧没有镇民）";
    tb = "（这一侧没有镇民）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    g_miSeat = 0;
    g_miRole = 79;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【亡骨魔】" + BOTC_NameStr(minion) + "（被杀死的爪牙）邻近的镇民：让哪一侧中毒？")), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText("左 = " + ta + "（顺时针）　右 = " + tb + "（逆时针）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【亡骨魔】点左边或右边，让那名镇民中毒。");
}

// 真的给这名镇民打上「中毒（亡骨魔）」；两个候选都没人时什么也不做
void BOTC_VigPoison (int who) {
    int m;
    m = g_vigFrom;
    g_vigFrom = 0;
    if (who < 2 || who > 13) {
        BOTC_PmStore(g_teller, "【亡骨魔】这一侧没有合格的镇民 → 这一次不中毒。");
        return;
    }
    BOTC_WudTryTrigger(who, m);
    g_tokOn[(((g_teller * 14) + who) * 256) + 81] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【亡骨魔】" + BOTC_NameStr(m) + "（被杀的爪牙）→ " + BOTC_NameStr(who) + " 中毒。");
}

//--------------------------------------------------------------------------------------------------
// 【风雅集（板子 10）· 店小二（115）】（用户 2026-11-06）
//   配板阶段就放好「熟客 135」和「醉酒 136」；首夜唤醒只负责把信息发给店小二。
//   · 无论清醒还是中毒 / 酒鬼 / 信息错误（涡流 84、熊孩子 170、活尸），都先问说书人：
//     要不要把当前持有这两枚 token 的两名玩家的座位号告诉他；失效时在标题里提醒应点【取消】。
//   · 选【取消】= 说书人自己填两名玩家，发完再从这两人里选一名成为新的醉酒（另一名成为新熟客），
//     旧的熟客 / 醉酒标记全部移除。
//   · 店小二只拿到两个座位号，不会知道谁是醉酒的。
//--------------------------------------------------------------------------------------------------
// 醉酒目标优先级：一次性能力者（信息分类 1）> 夜间能力者（行动 1/2 或分类 3）> 持续信息位（分类 2）
int BOTC_DxeDrunkTier (int q) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return 3;
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;
    }
    if (g_roleAct[r] == 1 || g_roleAct[r] == 2 || g_roleInfoClass[r] == 3) {
        return 1;
    }
    if (g_roleInfoClass[r] == 2) {
        return 2;
    }
    return 3;
}

// 熟客候选：默认只挑善良；allowEvil = 假店小二（酒鬼 / 提线木偶）时允许挑邪恶。
//   allowLunatic = 放开疯子（38）：只有没有别的候选人时才用。
int BOTC_DxePickPatron (int p, bool allowEvil, bool allowLunatic) {
    int i;
    int n;
    int r;
    int a;
    a = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == p || BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (!allowEvil) {
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_RoleTeam(r) > 1) { continue; }
        }
        if (!allowLunatic && r == 38) {
            continue;              // 疯子（38）：尽量不当熟客
        }
        n += 1;
        if (RandomInt(1, n) == 1) {
            a = i;
        }
    }
    return a;
}

// 醉酒候选：优先善良（allowEvil = 场上没有善良目标时才放开邪恶），按 BOTC_DxeDrunkTier 分层同层随机
int BOTC_DxePickDrunk (int p, int patron, bool allowEvil, bool allowLunatic) {
    int i;
    int n;
    int r;
    int tier;
    int best;
    int b;
    b = 0;
    n = 0;
    best = 9;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == p || i == patron || BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (!allowEvil) {
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_RoleTeam(r) > 1) { continue; }
        }
        if (!allowLunatic && r == 38) {
            continue;              // 疯子（38）：尽量不当醉酒
        }
        tier = BOTC_DxeDrunkTier(i);
        // 【避开已经醉酒 / 中毒的座位】（用户 2026-11-08）：诺-达鲺等已经产生的状态优先避让，
        //   有明显的干净候选时不给重复状态；只有所有候选都已被影响时才仍按原分层挑。
        if (BOTC_SeatImpaired(i)) {
            tier += 10;
        }
        if (tier < best) {
            best = tier;
            b = i;
            n = 1;
        }
        else {
            if (tier == best) {
                n += 1;
                if (RandomInt(1, n) == 1) {
                    b = i;
                }
            }
        }
    }
    return b;
}

// 配板阶段（以及中途被创造时）放好熟客 / 醉酒（用户 2026-11-06 二次调整）：
//   · 店小二的判定同时认「认知身份」（g_mark = 115）和借用能力，所以酒鬼 / 提线木偶假店小二也会放。
//   · 真店小二：熟客与醉酒都只从善良里挑。
//   · 假店小二（酒鬼 / 提线木偶）：熟客允许是邪恶角色，醉酒仍优先善良角色。
//   · 疯子（38）尽量不当这两枚 token 的目标。
void BOTC_DxeSetup () {
    int i;
    int p;
    int a;
    int b;
    bool fake;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 135] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
    }
    p = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_mark[(g_teller * 14) + i] - 1 == 115 || BOTC_HasAbility(i, 115)) {
            p = i;
        }
    }
    if (p < 2) {
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【酒鬼（14）/ 提线木偶（93）假扮的店小二】（用户 2026-11-12 统一口径）：能力不生效 → 不放置熟客 / 醉酒标记
    fake = (BOTC_SeatTrueRole(p) == 14 || BOTC_SeatTrueRole(p) == 93);
    if (fake) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【店小二】" + BOTC_NameStr(p) + " 是酒鬼 / 提线木偶假扮的店小二：能力不生效，本次不放置熟客 / 醉酒标记。");
        return;
    }
    a = BOTC_DxePickPatron(p, false, false);
    if (a < 2) {
        a = BOTC_DxePickPatron(p, false, true);      // 实在没人时放开疯子
    }
    b = BOTC_DxePickDrunk(p, a, false, false);
    if (b < 2) {
        b = BOTC_DxePickDrunk(p, a, false, true);   // 善良里只剩疯子
    }
    if (b < 2) {
        b = BOTC_DxePickDrunk(p, a, true, false);   // 连善良目标都没有才退到邪恶
    }
    if (a >= 2) {
        g_tokOn[(((g_teller * 14) + a) * 256) + 135] = true;
    }
    if (b >= 2) {
        g_tokOn[(((g_teller * 14) + b) * 256) + 136] = true;
    }
    BOTC_GrimRender(g_teller);
    if (a >= 2 && b >= 2) {
        BOTC_PmStore(g_teller, "【店小二】配板阶段已放置：熟客 " + BOTC_NameStr(a) + "，醉酒 " + BOTC_NameStr(b) + "。");
    }
    else {
        BOTC_PmStore(g_teller, "【店小二】场上没有足够的候选玩家，本次未能放满熟客 / 醉酒标记。");
    }
}

// 首夜唤醒入口：无论店小二是否清醒，都先问说书人要不要直接告诉他当前熟客 / 醉酒的两人
void BOTC_DxeNightOpen (int q) {
    int i;
    int a;
    int b;
    string ttl;
    a = 0;
    b = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 135]) {
            a = i;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 136]) {
            b = i;
        }
    }
    if (a < 2 || b < 2 || a == b) {
        BOTC_DxeManualOpen(q);
        return;
    }
    g_dxeMode = 0;
    ttl = "【店小二】把当前熟客[" + IntToString(g_lab[a] + g_nameNumShift) + "]和醉酒[" + IntToString(g_lab[b] + g_nameNumShift) + "]告诉他？（确认=告诉，取消=自己填两名）";
    if (BOTC_SeatImpaired(q) || BOTC_InfoErrorOn(q)) {
        ttl = ttl + "　（他中毒 / 醉酒 / 信息错误：应点【取消】）";
    }
    BOTC_ManInfoOpenSeats(q, ttl, 22);
}

void BOTC_DxeManualOpen (int seat) {
    g_dxeMode = 1;
    BOTC_ManInfoOpenSeats(seat, "【店小二】填他要得知的两名善良玩家（左 / 右各一个座位号 1~12），填完再选一人成为醉酒", 12);
}

//--------------------------------------------------------------------------------------------------
// 【二选一醉酒】（用户 2026-10-16）：水手（23）/ 旅店老板（26）/ 店小二（115）共用亡骨魔那套二选一面板。
//   kind：0 = 水手（左 = 他自己、右 = 他选的人）　1 = 旅店老板（他选的两名玩家）　2 = 店小二（说书人填的那两个号）
//         3 = 店小二从说书人手动填的两名玩家中选一名成为新醉酒（另一名成为新熟客，旧标记移除）
//   ⚠ 谁醉由说书人点 ---- 原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
//--------------------------------------------------------------------------------------------------
void BOTC_DrunkPickOpen (int kind, int who, int a, int b) {
    string ta;
    string tb;
    string ttl;
    string note;
    BOTC_MiSeatFieldsReset();
    g_dkKind = kind;
    g_dkFrom = who;
    g_dkA = a;
    g_dkB = b;
    ta = "（没有人）";
    tb = "（没有人）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    ttl = "【水手】" + BOTC_NameStr(who) + "：他自己 / 他选的玩家，谁醉酒？";
    note = "左 = " + ta + "　右 = " + tb;
    if (kind == 1) {
        ttl = "【旅店老板】" + BOTC_NameStr(who) + " 选的两名玩家：谁醉酒？";
    }
    if (kind == 2) {
        ttl = "【店小二】" + BOTC_NameStr(who) + " 得知的两个人：谁醉酒？";
    }
    if (kind == 3) {
        ttl = "【店小二】两人里谁成为新的醉酒？";
        note = "左 = " + ta + "　右 = " + tb + "　（选一人醉酒，另一人成为新熟客；旧的熟客 / 醉酒标记会移除）";
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    else if (BOTC_SeatImpaired(who)) {
        note = note + "　（他中毒/酒鬼：点【取消】= 这次谁也不醉）";
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    g_miSeat = 0;
    g_miRole = 807;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(ttl)), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// side：1 = 点了左边（候选 A）/ 0 = 点了右边（候选 B）
void BOTC_DrunkPickApply (int side) {
    int k;
    int who;
    int pick;
    int other;
    int i;
    k = g_dkKind;
    who = g_dkFrom;
    pick = g_dkB;
    if (side != 0) {
        pick = g_dkA;
    }
    other = g_dkA;
    if (pick == g_dkA) {
        other = g_dkB;
    }
    g_dkKind = 0;
    g_dkFrom = 0;
    g_dkA = 0;
    g_dkB = 0;
    if (pick < 2 || pick > 13) {
        return;
    }
    // 【能力失效】（用户 2026-11-12 统一口径）：施术者中毒 / 酒鬼 / 提线木偶 → 不放置醉酒 / 熟客标记
    if (k == 0 || k == 1 || k == 3) {
        if (!BOTC_SkillWorks(who)) {
            BOTC_PmStore(g_teller, "【二选一醉酒】" + BOTC_NameStr(who) + " 中毒/酒鬼/提线木偶：本次能力失效，没有放置标记。");
            return;
        }
    }
    if (k != 3) {
        BOTC_WudTryTrigger(pick, who);
    }
    if (k == 0) {
        if (g_sailorDrunk >= 2 && g_sailorDrunk != pick) {
            BOTC_SailorDrunkClear("水手换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 59] = true;      // 醉酒（水手）
        g_sailorDrunk = pick;
        BOTC_SailorSync();
    }
    if (k == 1) {
        if (g_nightDrunk >= 2 && g_nightDrunk != pick) {
            BOTC_DrunkClear("旅店老板换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 60] = true;      // 醉酒（旅店老板）
        g_nightDrunk = pick;
    }
    if (k == 2) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 136] = true;     // 醉酒（店小二）
    }
    if (k == 3) {
        // 手动重放：先把旧的熟客 / 醉酒全部清掉，选中的那人是新醉酒，另一人是新熟客
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 135] = false;
            g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 136] = true;     // 新的醉酒（店小二）
        if (other >= 2 && other <= 13 && other != pick) {
            g_tokOn[(((g_teller * 14) + other) * 256) + 135] = true;   // 另一人成为新的熟客（店小二）
        }
        BOTC_PmStore(g_teller, "【店小二】新的醉酒：" + BOTC_NameStr(pick) + "，新的熟客：" + BOTC_NameStr(other) + "（旧的熟客 / 醉酒标记已移除）。");
    }
    BOTC_BartenderSync();
    BOTC_GrimRender(g_teller);
}

// 【收起没答完的「二选一醉酒」面板】（用户 2026-11-08）：这个框不挂 g_miSeat，
//   原来唤醒下一个 / 天亮只把面板留在屏幕上不结算，变成一个点不动的僵尸框。
//   这里按「不选 = 这次谁也不醉」静默收掉，不发消息、不改任何标记。
void BOTC_DrunkPickClose () {
    if (g_miRole != 807) {
        return;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    g_miSeat = 0;
    g_miRole = -1;
    g_dkKind = 0;
    g_dkFrom = 0;
    g_dkA = 0;
    g_dkB = 0;
}

//--------------------------------------------------------------------------------------------------
// 【混沌（121）】（用户 2026-10-16）：每夜*刀一个人；如果这一刀杀死了「离他最近的两名镇民之一」
//   → 除旅行者外的所有善良玩家中毒，直到下一个黄昏（转成邪恶自动失效、转回善良自动生效）。
//--------------------------------------------------------------------------------------------------
void BOTC_HunDunPoisonAll (int demon) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatAlign(i) != 0) {
            continue;                                   // 只毒善良（旅行者本图没有）
        }
        BOTC_WudTryTrigger(i, demon);
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = true;
    }
    BOTC_GrimRender(g_teller);
}

// 到黄昏把那一份「善良中毒」全清掉（混沌死亡 / 离场的那一份由 BOTC_TokGoneWithSource 负责）
void BOTC_HunDunClear () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = false;
    }
    BOTC_GrimRender(g_teller);
}

// 这一刀要不要触发：目标是镇民 + 已经死了 + 他是「离混沌最近的两名镇民」之一
void BOTC_HunDunCheck (int demon, int target) {
    int a;
    int b;
    if (demon < 2 || demon > 13 || target < 2 || target > 13) {
        return;
    }
    // 【这一刀直接分出胜负 → 不触发中毒】（百科口径；用户 2026-10-16 要求严格照做）
    //   最典型的影响是异端分子：他要是被这枚「中毒」打上，对调胜负就失效了 ----
    //   而百科说这种「一刀结束游戏」的场合根本不该给任何人上毒。
    //   （BOTC_DemonStrike 里面已经调过 BOTC_CheckWin，所以这里能直接读到 g_gameOver）
    if (g_gameOver) {
        return;
    }
    if (!(BOTC_SeatDead(target) || g_deadPending[target])) {
        return;                                     // 没造成死亡（被免死 / 被拦下）→ 不触发
    }
    if (BOTC_SeatTeam(target) != 0) {
        return;                                     // 不是镇民 → 不触发
    }
    a = BOTC_NextTownsfolk(demon, 1, 0);
    b = BOTC_NextTownsfolk(demon, -1, 0);
    if (target != a && target != b) {
        return;
    }
    BOTC_HunDunPoisonAll(demon);
    BOTC_PmStore(g_teller, "【混沌】这一刀杀死了邻近的镇民 " + BOTC_NameStr(target) + " → 除旅行者外的所有善良玩家中毒到下个黄昏。");
}

//--------------------------------------------------------------------------------------------------
// 【逆臣（119）】（用户 2026-10-16）：谁先死于处决，另一方当晚转邪恶（处决那一侧见 BOTC_ExecToggleAt）
//--------------------------------------------------------------------------------------------------
void BOTC_TurncoatApply (int who) {
    if (who < 2 || who > 13) {
        return;
    }
    if (BOTC_SeatAlign(who) == 1) {
        return;                                     // 本来就是邪恶 → 不变成善良（百科）
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时不能再新增邪恶。
    if (BOTC_HolySoulBlocks(who)) {
        BOTC_PmStore(g_teller, "【逆臣×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(who) + " 保持善良阵营。");
        return;
    }
    g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;      // 「邪恶」token：真身也算邪恶
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【逆臣】你转变为邪恶阵营。");
    BOTC_PmStore(g_teller, "【逆臣】" + BOTC_NameStr(who) + " 转变为邪恶阵营。");
}

// 【方古（68）】先正常结算这一刀；如果这一刀**真的杀死了外来者**、而且「限一次」还没用 → 转化
void BOTC_FangGuResolve (int p, int q) {
    int wasDead;
    int isOut;
    wasDead = 0;
    isOut = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_SeatTeam(q) == 1) {
            isOut = 1;
        }
    }
    BOTC_DemonStrike(p, 68, q, false);
    if (wasDead == 1 || isOut == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        return;                       // 被保护 / 免死 / 士兵挡下 → 他没死就不转化（百科明写）
    }
    // 【「限一次」的判定】（用户 2026-09-21 问原理）：光看「现在这只方古那一格」不够 ----
    //   转化之后新方古在**另一个座位**上，他去杀外来者时读自己那格是空的，会再转化一次。
    //   所以：① 全局 g_fangUsed 记账（整局一次，跨座位）；② 第 78 格 token 只当说书人提醒，
    //   顺带也留着「手动给当前方古打上这枚 token = 这一局已经用掉」的口子。
    if (g_fangUsed || g_tokOn[(((g_teller * 14) + p) * 256) + 78]) {
        BOTC_PmStore(g_teller, "【方古】「限一次」已经用过了 → 这一刀按普通击杀结算（外来者正常死亡）。");
        return;
    }
    // 【圣洁之魂（89）】（用户 2026-11-08）：邪恶名额已满时无法新增邪恶方古，按普通击杀结算。
    if (BOTC_HolySoulBlocks(q)) {
        BOTC_PmStore(g_teller, "【方古×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(q) + " 无法转变为方古，这一刀按普通击杀结算。");
        return;
    }
    g_fangUsed = true;
    g_tokOn[(((g_teller * 14) + p) * 256) + 78] = true;           // 「限一次」：整局留着，方古死了也不撤
    // 【修 BUG】（用户 2026-09-23）：他不是死，是「当场变成方古」----
    //   上面 BOTC_DemonStrike 已经按「击杀」记了死亡 token / 待天亮公布，这里整条收掉，
    //   否则天一亮还会公屏播「X 死亡」，看起来就是「既变成方古又死了」。
    //   （BOTC_ClearDeath 只清死亡记录 / 红叉 / 待公布 + 一次性能力复位，不发任何公屏。）
    BOTC_ClearDeath(q);
    BOTC_SetSeatRole(g_teller, q, 68);
    BOTC_SetSeatRole(g_who[q], q, 68);
    g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;          // 转邪恶
    g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
    BOTC_ChangeRoleMsg(q, 68);                      // 【统一身份转变提示】（用户 2026-10-01）：方古转化也走这一套
    BOTC_PmStore(g_teller, "【方古】" + BOTC_NameStr(q) + "（外来者）变成邪恶的方古；老方古（" + BOTC_NameStr(p) + "）代替他死亡。");
    BOTC_MarkDeathByTok(p, 64);                     // 老方古死亡（死因照打「死亡（方古）」）
    g_autoWoke[q] = true;
    BOTC_GrimRender(g_teller);
    BOTC_CheckWin();
}

// 【亡骨魔（69）】先正常结算这一刀；杀死的是**真身爪牙** → 给他打「保留能力」，
//   再让说书人从他两侧最近的镇民里挑一个中毒
void BOTC_VigResolve (int p, int q) {
    int wasDead;
    int isMinion;
    int a;
    int b;
    wasDead = 0;
    isMinion = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 2) {
            isMinion = 1;
        }
    }
    // 【先打「保留能力」再结算这一刀】（用户 2026-09-21）：他死的那一刻「离场清理」会跑 ----
    //   标记先挂着，清理才知道「这个人保留能力、别收他的 token」；没死的话再把标记撤掉。
    if (wasDead == 0 && isMinion == 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = true;
    }
    BOTC_DemonStrike(p, 69, q, false);
    if (wasDead == 1 || isMinion == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = false;      // 没死（被保护 / 免死 / 士兵）→ 不保留，撤掉
        return;
    }
    a = BOTC_NextTownsfolk(q, 1, 0);
    b = BOTC_NextTownsfolk(q, -1, 0);
    BOTC_GrimRender(g_teller);
    BOTC_VigPickOpen(q, a, b);
}

// 【测试】把座位 2（游戏里的「玩家1」）按麻脸巫婆的能力变成某个角色（用户 2026-09-21）
//   role < 0 = 用当前板子上的第一只恶魔（测试「造出恶魔」那一套：恶魔刀无效 + 生死无常面板）
void BOTC_TestHag (int role) {
    int i;
    int b;
    int r;
    int pick;
    pick = role;
    if (pick < 0) {
        pick = 21;
        b = g_board;
        if (b < 1 || b > 15) {
            b = 1;
        }
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            r = g_boardRole[(b * 256) + i];
            if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
                pick = r;
                break;
            }
        }
    }
    BOTC_Notice(g_teller, "【麻脸巫婆·测试】把 " + BOTC_NameStr(2) + " 熬成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_PmStore(g_teller, "【麻脸巫婆·测试】-熬 指令：把 " + BOTC_NameStr(2) + " 变成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_HagApply(2, pick);
}

// 【查看某个座位】（用户 2026-09-21）：把那个座位现在的身份 / 阵营 / 标记写进说书人日志
void BOTC_SeatDump (int q) {
    int t;
    string tk;
    string st;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    tk = "";
    for (t = 0; t < 256; t += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
            continue;
        }
        if (BOTC_IsHiddenTok(t)) {
            continue;
        }
        if (g_tokShort[t] == "") {
            continue;
        }
        if (tk != "") {
            tk = tk + "、";
        }
        tk = tk + g_tokShort[t];
    }
    if (tk == "") {
        tk = "（没有）";
    }
    if (BOTC_SeatAlign(q) == 1) {
        st = "邪恶";
    }
    else {
        st = "善良";
    }
    if (BOTC_SeatDead(q)) {
        s = "已死亡";
    }
    else {
        s = "活着";
    }
    BOTC_Notice(g_teller, "【查看】" + BOTC_NameStr(q) + "：" + BOTC_SeatRoleStr(q));
    BOTC_PmStore(g_teller, "【查看】座位 " + IntToString(q - 1) + "（" + BOTC_NameStr(q) + "）：魔典身份 = " + BOTC_SeatRoleStr(q) + "，真身索引 = " + IntToString(BOTC_SeatTrueRole(q)));
    BOTC_PmStore(g_teller, "【查看】阵营 = " + st + "；状态 = " + s);
    BOTC_PmStore(g_teller, "【查看】身上的标记：" + tk);
}
// 【镜像双子 · 配对】（用户 2026-09-21）：说书人在「祖母那种面板」里填座位号 + 选身份（所有角色都能选）。
//   他中毒 / 酒鬼时按规则两人不该知道对方身份 → 只记下来、不发信息，让说书人自己决定。
void BOTC_TwinPair (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (g_twinA < 2) {
        // 【-t 测试 / 说书人自己那一格】（用户 2026-09-21）：他自己就是镜像双子时也能配对
        if (BOTC_SeatTrueRole(1) == 64) {
            g_twinA = 1;
        }
        else {
            BOTC_Notice(g_teller, "场上还没有镜像双子。");
            return;
        }
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）----
        //   配对 token 76 / 77 脚本不代打；「你的对立双子是谁」只发给镜像双子本人（说书人填的那个身份），对立双子那边一个字都不发。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子（身份：" + g_roleName[role] + "）；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
    BOTC_PmInfo(g_who[q], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[64] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(q) + "）。");
    // 【数学家】（用户 2026-09-21）：说书人填的身份跟那个人的真身 / 登记层都对不上 → 记一格「未正常生效」
    //   （挂在镜像双子那一格：是他这条能力给出去的信息不对）
    if (BOTC_SeatTrueRole(q) != role && BOTC_RegRoleOf(q) != role) {
        BOTC_MalfNote(g_twinA, "镜像双子配对时填的身份和真身（含登记层）都不符");
    }
}
bool BOTC_TargetMustBeLiving (int p) {
    int r;
    r = BOTC_ActRoleOf(p);
    if (r == 23 || r == 24 || r == 40 || r == 49 || r == 77 || r == 107 || r == 155 || r == 159) {
        return true;
    }
    // 痢蛭只有「选宿主」时要求存活（首夜，或中途被创造后补选）；之后每夜的杀人目标可以是任意玩家。
    if (r == 100 && BOTC_LleechHostMode(p)) {
        return true;
    }
    return false;
}

bool BOTC_TargetIsLiving (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    // BOTC_SeatDead 已经包含公开红叉；复活待公布时它会在夜间返回 false，
    // 因此这里不能再单独用 BOTC_PublicDead 拦掉。
    if (g_zombFake[q] || BOTC_SeatDead(q)) {
        return false;
    }
    return true;
}

int BOTC_TargetsOf (int p) {
    int r;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (p == 1 && g_boomKeepPick) {
        return 3;
    }
    // 【小怪宝 / 造谣者 / 赏金猎人】（用户 2026-11-10）：说书人那一格只要 1 个目标槽
    if (g_who[p] == g_teller && g_mdAsk) {
        return 1;
    }
    // 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）：说书人那一格只要 1 个目标
    if (g_who[p] == g_teller && g_damselAsk > 0) {
        return 1;
    }
    r = BOTC_ActRoleOf(p);
    // 【说书人那一格】（用户 2026-09-21 报「目标2 不见了」）：生死无常 / 镜像双子配对 / 心上人
    //   这几块面板开在**玩家 1** 身上，他魔典上没有身份（r = -1）----
    //   这几个特例必须放在「没身份就 return 0」**前面**，否则它们永远只拿到 1 个目标槽。
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：两个目标槽（最多杀 2 个）
    if (g_who[p] == g_teller && g_hagKill) {
        return 2;
    }
    // 【镜像双子配对】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_twinPick) {
        return 1;
    }
    // 【心上人】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_sweetBySt) {
        return 1;
    }
    // 奥赫选到不在场 / 重复角色时，说书人那一格弹一次单目标选择
    if (p == 1 && g_ojoAskSt) {
        return 1;
    }
    if (p == 1 && g_boffinRecipientPick) {
        return 1;
    }
    if (g_pedantActing[p]) {
        return 1;
    }
    if (r < 0 || r > 163) {
        return 0;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔被再次唤醒时也要两个目标槽
    if (p == g_barberFrom) {
        return 2;
    }
    if (r == 46 && BOTC_ProtectTokOn(p, 52)) {
        return 3;
    }
    // 哈迪寂亚（87）：固定三个目标
    if (r == 87) {
        return 3;
    }
    return g_roleTargets[r];
}

// 「每局限一次」的角色（智能说书反刍时尽量避开）：猎手 10 / 侍臣 29 / 教授 30 / 刺客 41
bool BOTC_OneShotRole (int r) {
    if (r == 10 || r == 29 || r == 30 || r == 41) {
        return true;
    }
    return false;
}

// 【沙巴洛斯反刍】该座位是否拥有「每局限一次」能力：真身或借来的能力都算。
bool BOTC_OneShotAt (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
        return true;
    }
    if (BOTC_HasAbility(q, 10) || BOTC_HasAbility(q, 29) || BOTC_HasAbility(q, 30) || BOTC_HasAbility(q, 41)) {
        return true;
    }
    return false;
}

// 技能面板的【取消】：普通角色就是关掉面板；珀的发动 / 憋刀由前置询问处理。
void BOTC_SkillCancel (int p) {
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    // 【小怪宝 / 造谣者 / 赏金猎人】说书人点【取消】= 这一次不发动（用户 2026-11-10）
    if (g_mdAsk && g_who[p] == g_teller) {
        BOTC_MdAskCancel();
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    if (p == 1 && (g_scarletPick || g_courtPick || g_halfPick)) {
        BOTC_Notice(g_teller, "请先选择一名符合条件的目标再确认。");
        return;
    }
    if (g_boomKeepPick && p == 1) {
        BOTC_Notice(g_teller, "炸弹人必须选满三名保留玩家。");
        return;
    }
    // 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）：取消 = 这次不产生落难少女
    if (g_damselAsk > 0 && g_who[p] == g_teller) {
        BOTC_DamselAskCancel();
        return;
    }
    if (g_limitedAsk[p]) {
        BOTC_LimitedDecline(p);
        return;
    }
    if (g_poAsk[p]) {
        BOTC_PoAskAnswer(p, false);
        return;
    }
    if (g_boffinRecipientPick) {
        g_boffinRecipientPick = false;
        if (g_boffinEditSource >= 2 && g_boffinEditSource <= 13) {
            g_boffinPendingBy[g_boffinEditSource] = 0;
        }
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_PmStore(g_teller, "【科学怪人】取消了这次能力接收者选择。");
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (r == 150 && g_nightNum == 2) {
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【召唤师】" + BOTC_NameStr(p) + " 第二个夜晚不召唤普卡，保留第三个夜晚的召唤机会。");
        return;
    }
    // 奥赫（134）由说书人选择补杀目标时，取消 = 这次不杀
    if (g_ojoAskSt && p == 1) {
        g_ojoAskSt = false;
        g_ojoFrom = 0;
        g_ojoRole = -1;
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【奥赫】说书人取消了这次补杀。");
        return;
    }
    // 每局限一次的角色：点【取消】就是「今晚不发动」，说书人那边要看得到（机会还在）
    //   【巡山人（77）】（用户 2026-10-04）：他也有这个按钮（BOTC_SkillRender 里 30/41/77 都显示【取消】），
    //   这里把他的那行也补上 —— 不然点取消时脚本什么都不写，说书人会以为机会用掉了。
    if (g_awake[p] && g_isNight) {
        if (r == 30 || r == 41 || r == 77) {
            BOTC_Notice(g_teller, "【" + BOTC_SeatRoleStr(p) + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
            BOTC_PmStore(g_teller, "【" + g_roleName[r] + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
        }
    }
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：点【取消】= 今晚一个都不杀
    if (g_hagKill && g_who[p] == g_teller) {
        g_hagKill = false;
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚一个都不杀。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔点【取消】= 放弃交换 → 撤掉「今晚理发」标记
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        BOTC_BarberDecline(p);
    }
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

// 天亮结算：只做「公开」----把昨晚记下的死亡亮出来（红叉 + 播报），再清掉只算一晚的状态
void BOTC_DawnResolve () {
    int q;
    int ob;
    BOTC_EnvoyDawnClear();
    BOTC_HeshangDawnClear();
    BOTC_CultChoiceSettle();       // 【异教领袖（106）】天亮仍未作答 → 今晚不改变阵营
    BOTC_NoDashiiSync();           // 和尚压制结束后，持续中毒在黎明恢复
    BOTC_CerenDawnClear();         // 【洗脑师】黎明收掉上一夜那一份「疯狂」（本夜刚放的那份保留）
    // 【「死于今日」的移除时机】（用户 2026-09-20）：昨天留下的「死于今日 / 死于今日（僵怖）/ 死于今日（教父）」标记，
    //   一到第二天白天就清掉 ---- 放在整个天亮流程的**最前面**，免得后面处理夜间死亡时又混进新标记。
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 11]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 57]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 56]) {
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 11] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 57] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = false;     // 「死于今日（教父）」也一起清掉
    }
    // 【间谍 / 寡妇 · 延迟看魔典】（用户 2026-11-10）：天亮把还没到点的自动看魔典一起取消
    for (q = 1; q <= 13; q += 1) {
        BOTC_PeekWaitClear(q);
        BOTC_UtWaitClear(q);          // 【送葬者】天亮把还没到点的自动发信息一起取消
    }
    // 【中毒 / 醉酒间谍或寡妇】还没作答的「真实/伪造魔典」弹窗一起静默作废
    BOTC_FakeAskAnswer(-2);
    // 天亮：间谍「看说书人魔典」的临时权限一起收掉
    BOTC_SpyPeekEnd();
    if (g_tokOn[(((g_teller * 14) + 62) * 256) + 92] || g_barberWait) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 92] = false;
        }
        if (g_barberSeat >= 2) {
            BOTC_PmStore(g_teller, "【理发师】昨晚没结算交换 → 这次机会作废，「今晚理发」标记收掉。");
        }
        g_barberSeat = 0;
        g_barberFrom = 0;
        g_barberWait = false;
    }
    // 【梦殒春宵】数学家 / 卖花女孩 / 城镇公告员 的当日标记：天亮清掉（用户 2026-09-21）
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 86] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 87] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 88] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 91] = false;      // 杂耍艺人的「干扰」标记也是当天的（用户 2026-09-21）
    }
    BOTC_GrimRender(g_teller);
    BOTC_PhiloDrunkSync();        // 天亮再同步一次（哲学家中毒/清醒的醉酒来回切）
    // 【哲学家】今天死了 → 他给的「醉酒（哲学家）」收掉（用户 2026-09-21：死亡那天在死亡结算前判不出来，所以天亮再兜一次）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        for (ob = 2; ob <= 13; ob += 1) {
            if (g_tokOn[(((g_teller * 14) + ob) * 256) + 90]) {
                g_tokOn[(((g_teller * 14) + ob) * 256) + 90] = false;
                BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(q) + " 已经死亡 → " + BOTC_NameStr(ob) + " 不再醉酒。");
            }
        }
    }
    // 僧侣的保护只维持一晚：天亮先把「保护」标记清掉
    if (g_nightMonk >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9]) {
            g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9] = false;
            BOTC_GrimRender(g_teller);
        }
    }
    // 旅店老板的「不会死亡」与驱魔人的「被点名」也只算昨晚（用户 2026-09-20）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 25]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 25] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 31]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 31] = false;
        }
    }
    g_exoBlock = 0;
    g_exoNight = 0;
    BOTC_GrimRender(g_teller);
    // 疯子（38）的「被选择」标记：天亮撤掉（跟百科一致）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 48]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 48] = false;
        }
    }
    // 【天亮：死亡 / 复活排队播报】（用户 2026-09-26）
    //   顺序：先复活（按座位号），再死亡（按座位号）；进白天 4 秒后播第一条，之后每 4 秒一条。
    //   每一条 = 红叉 + 左下角公屏 + 记录，都在同一瞬间（不再一次性全放出来）。
    BOTC_SkinSourceCheck();
    g_dawnQN = 0;
    g_dawnQI = 0;
    // ① 挂着复活标记、但他本来就没死：只把标记悄悄撤掉（不播报）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43] && !g_tokOn[(((g_teller * 14) + q) * 256) + 113]) {
            continue;
        }
        // 待复活玩家在夜间按存活处理，因此这里必须看公开红叉，不能看 BOTC_SeatDead。
        if (!BOTC_PublicDead(q)) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
            BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 身上有「复活」标记但他没死，标记先撤掉。");
        }
    }
    // ② 排队：先复活（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43] && !g_tokOn[(((g_teller * 14) + q) * 256) + 113]) {
            continue;
        }
        if (!BOTC_PublicDead(q)) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 1;
        g_dawnQN = g_dawnQN + 1;
    }
    // ③ 再排队：昨晚的死亡（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_deadPending[q]) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 2;
        g_dawnQN = g_dawnQN + 1;
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：天亮重新算一次
    // 主谋（42）：加时那一天到了 ---- 这一天的处决决定胜负
    if (g_mmExtra && !g_mmArmed && !g_mmDone) {
        g_mmArmed = true;
        BOTC_PmStore(g_teller, "【主谋】加时的这一天开始了：今天被处决的人，他的阵营立刻落败。");
    }
    BOTC_FoolSync();              // 弄臣（34）：维护「首次未死 / 失去能力」标记
    // 月之子（36）：昨天那个「可以公开选人」的窗口到期（他今天要是又死了会重新开）
    for (q = 1; q <= 13; q += 1) {      // q 从 1 开始：说书人那一格也能声称（用户 2026-09-26）
        g_moonOpen[q] = false;
        g_moonDeclare[g_who[q]] = false;
        g_klutzDeclare[g_who[q]] = false;     // 呆瓜（63）：新的一天，死后声称的点头像阶段也清掉
    }
    // 造谣者（28）：新的一天，声明次数与内容都清掉（每天一次）
    g_gossipBy = 0;
    BOTC_DrunkPickClose();         // 【二选一醉酒】天亮还没答 → 静默收起，免得留个点不动的框
    g_miSeat = 0;                  // 信息位答题框：换局把待发的那句清掉
    g_miRole = -1;
    g_gossipText = "";
    for (q = 1; q <= 13; q += 1) {      // 同上：说书人（q = 1）的每日声称次数也要跟着刷
        g_gossipDone[q] = false;
        g_gossipTextBy[q] = "";
        g_juggDone[q] = false;         // 杂耍艺人（58）：新的一天，又能公开猜一次（用户 2026-09-21）
        BOTC_JugglerCancel(g_who[q]);  // 未提交的公开猜测不带进新的一天
        g_alsaOpen[g_who[q]] = false;  // 戏法师（149）：新的一天，重新开放猜测
        g_alsaDay[g_who[q]] = -1;
        for (ob = 0; ob <= 13; ob += 1) {
            g_alsaChoice[(g_who[q] * 14) + ob] = 0;
        }
        g_psyDone[q] = false;          // 精神病患者（84）：新的一天，又能声称一次
        g_cultDeclDone[q] = false;     // 异教领袖（106）：新的一天，又能声称一次（用户 2026-10-11）
        g_declareUsed[g_who[q]] = false;   // 猎手：每天都能声称一次（用户 2026-11-04）
        g_declarePick[g_who[q]] = false;
        g_damselDone[g_who[q]] = false;    // 猜落难：每天都能声称一次（用户 2026-11-04）
        g_damselPick[g_who[q]] = false;
    }
    DialogSetVisible(g_alsaDlg, PlayerGroupAll(), false);

    BOTC_HdHide();

    // 【天亮播报队列】（用户 2026-09-26）：4 秒后播第一条；没东西要播就照旧立刻判胜负
    if (g_dawnQN > 0) {
        TimerStart(g_tDawn, 4.0, false, c_timeGame);
    }
    else {
        BOTC_CheckWin();
    }
    if (g_nightImp >= 2 && !BOTC_SeatDead(g_nightImp)) {
        BOTC_PmStore(g_teller, "【天亮】昨晚小恶魔那一刀没有造成死亡。");
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：昨晚死的人在这里被公开 → 他们的格子立刻换成【死后声称】
    BOTC_DeclareRender();
    // 新的一天：今天被处决过谁重新计数（送葬者问的就是「今天」被处决的人）
    for (q = 2; q <= 13; q += 1) {
        g_exec[q] = false;
    }
    BOTC_NightSkillReset();

}

// 天亮播报一条（kind：1 = 复活 / 2 = 死亡）---- 红叉 + 左下角公屏 + 记录，同一瞬间
void BOTC_DawnReveal (int q, int kind) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (kind == 1) {
        if (!BOTC_PublicDead(q)) {
            return;
        }
        BOTC_ClearDeath(q);
        // 【复活不再延迟】（用户 2026-09-26）：红叉当场撤（BOTC_ClearDeath 已经撤了）、fuhuo 当场响，不挂复活动画
        g_revFxCt[q] = 0;
        g_revFxSnd[q] = 0;
        BOTC_PlaySfx("fuhuo");
        BOTC_RestoreOneShot(q);
        g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
        for (ob = 1; ob <= 13; ob += 1) {
            BOTC_GrimRender(ob);
        }
        BOTC_PubAnnounce("【复活】" + BOTC_NameStr(q) + " 复活");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 复活 ----");
        BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 带着「复活」标记 → 自动复活。");
        BOTC_SailorSync();
        BOTC_TeaLadySync();
        return;
    }
    if (!g_deadPending[q]) {
        return;
    }
    g_deadPending[q] = false;
    if (BOTC_PublicDead(q)) {
        // 僵怖第一次假死已经公开过红叉；第二次真死仍要在天亮补一次死亡播报。
        if (!(BOTC_HasAbility(q, 43) && g_zombUsed[q] && !g_zombFake[q])) {
            return;
        }
    }
    g_deadShown[q] = true;
    g_deadClaimDay[q] = g_dayNum;          // 天亮公布死讯：这个白天才允许死后声称（月之子 / 呆瓜）
    BOTC_PlaySfx("Marine_Death");
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【死亡】昨晚，" + BOTC_NameStr(q) + " 死亡");
    if (!g_liveCorpse[q]) {
        BOTC_BansheeAnnounce(q);
    }
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：昨晚 " + BOTC_NameStr(q) + " 死亡 ----");
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    if (g_zombFake[q]) {
        BOTC_PmStore(g_teller, "【僵怖】他其实没有死：全桌都看到他「死亡」，但他照常行动。");
    }
    BOTC_DeclareRender();
    if (g_liveCorpse[q]) {
        if (!g_deathLearned[q]) {
            g_deathLearned[q] = true;
            BOTC_MoonChildCheck(q);
            BOTC_KlutzCheck(q);
        }
    }
    else {
        BOTC_MoonChildCheck(q);
        BOTC_KlutzCheck(q);          // 呆瓜（63）：天亮得知死讯的瞬间也要立刻弹窗选人
    }
}

// 天亮队列：每 4 秒播一条；播完最后一条再判胜负
bool BOTC_DawnFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_dawnQN <= 0) {
        return true;
    }
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    BOTC_DawnReveal(g_dawnQ[g_dawnQI], g_dawnKind[g_dawnQI]);
    g_dawnQI = g_dawnQI + 1;
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    TimerStart(g_tDawn, 4.0, false, c_timeGame);
    return true;
}

// 黄昏（进入夜晚）时到期的状态：投毒者的毒只算一个夜晚 + 一个白天
// 把「当前这次投毒」收回来：中毒 token 去掉、记录清空。why 只用来写给说书人看的日志。
//   触发点：① 投毒者换目标（他自己点新目标时）② 黄昏到期 ③ 投毒者死亡 ④ 投毒者换了身份
// 【按来源独立】（用户 2026-11-13）：多个拥有投毒者能力的角色各自记一份，只收指定来源那一份；
//   同一名玩家被不止一个来源毒着时，中毒标记保留，直到最后一个来源也撤掉。
void BOTC_PoisonClearSource (int src, string why) {
    int tgt;
    int i;
    bool still;
    if (src < 1 || src > 13) {
        return;
    }
    tgt = g_poisonAt[src];
    g_poisonAt[src] = 0;
    g_poisonDayBy[src] = 0;
    if (tgt < 2) {
        return;
    }
    still = false;
    for (i = 1; i <= 13; i += 1) {
        if (g_poisonAt[i] == tgt) {
            still = true;
        }
    }
    if (still) {
        BOTC_PmStore(g_teller, "【投毒者】" + why + "：仍有其他拥有投毒者能力的角色在毒 " + BOTC_NameStr(tgt) + "，中毒标记保留。");
        return;
    }
    if (g_tokOn[(((g_teller * 14) + tgt) * 256) + 7]) {
        // 这里只管投毒者那份（7）；普卡的毒是 63 那一格，一直挂到普卡下一次行动，不跟黄昏清
        g_tokOn[(((g_teller * 14) + tgt) * 256) + 7] = false;
        BOTC_GrimRender(g_teller);
        BOTC_SailorSync();         // 中毒状态变了：水手的「不会死亡」标记跟着刷新
    }
}

// 收掉所有投毒者能力来源的毒（换局 / 统一清理用）；黄昏到期走 BOTC_DuskResolve 里按来源判断。
void BOTC_PoisonClear (string why) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        if (g_poisonAt[i] >= 2) {
            BOTC_PoisonClearSource(i, why);
        }
    }
}

void BOTC_DuskResolve () {
    int q;
    int i;
    BOTC_GudiaoDuskClear();
    BOTC_XaanPoisonClear("黄昏到期");
    // 首夜设置的毒必须完整保留一个白天；只有跨过一天后的黄昏才到期。每个来源分别判断。
    for (i = 1; i <= 13; i += 1) {
        if (g_poisonAt[i] >= 2) {
            if (g_poisonDayBy[i] < g_dayNum) {
                BOTC_PoisonClearSource(i, "黄昏到期");
            }
            else {
                BOTC_PmStore(g_teller, "【投毒者】" + BOTC_NameStr(i) + " 首夜的中毒仍在本日生效，等到下一个黄昏再清除。");
            }
        }
    }
    BOTC_DrunkClear("黄昏到期");           // 醉酒也只算一个夜晚 + 一个白天（暂时）
    BOTC_BartenderSync();                  // 酒保若在黄昏恢复清醒 / 目标阵营变化，立即校正
    BOTC_HunDunClear();                    // 【混沌（121）】「全体善良中毒」只到下一个黄昏（用户 2026-10-16）
    // 吟游诗人（31）的全员醉酒：触发那一天**不清**，要撑到明天黄昏（用户 2026-09-20）
    if (g_minstrelDay > 0 && g_dayNum <= g_minstrelDay) {
        BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒要撑到明天黄昏 → 这一轮黄昏先不清。");
    }
    else {
        if (g_minstrelDay > 0) {
            BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒到点了 → 这一轮清掉。");
        }
        for (q = 2; q <= 13; q += 1) {
            g_minstrelDrunk[q] = false;
        }
        g_minstrelDay = 0;
    }
    // 处决免死（魔鬼代言人 / 和平主义者）只保「今天白天」那一次处决：到黄昏就清掉
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 24] || g_tokOn[(((g_teller * 14) + q) * 256) + 59] || g_tokOn[(((g_teller * 14) + q) * 256) + 60] || g_tokOn[(((g_teller * 14) + q) * 256) + 61] || g_tokOn[(((g_teller * 14) + q) * 256) + 62]) {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 53] || g_tokOn[(((g_teller * 14) + q) * 256) + 54] || g_tokOn[(((g_teller * 14) + q) * 256) + 55]) {
                // 侍臣的「三个夜晚 + 三个白天」还没到点：跳过（用户 2026-09-20）
            }
            else {
                if (g_minstrelDrunk[q]) {
                    // 这一份醉酒是吟游诗人的，还没到点：跳过（用户 2026-09-20）
                }
                else {
                    if (!BOTC_PhiloDrunkSelf(q)) {      // 【哲学家×酒鬼】（用户 2026-10-13）：他这份醉酒是他自己的身份，到黄昏也不清
                        g_tokOn[(((g_teller * 14) + q) * 256) + 24] = false;
                    }
                    g_tokOn[(((g_teller * 14) + q) * 256) + 59] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 60] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 61] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 62] = false;
                }
            }
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 27]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 27] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 28]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 28] = false;
        }
    }
    g_sailorDrunk = 0;            // 水手（23）那一份醉酒也是「到黄昏为止」，记录一起清
    BOTC_CourtierTick();          // 侍臣（29）：每个黄昏把醉酒 1 → 2 → 3 → 失去能力
    // 吟游诗人（31）的「全员醉酒」标记：到点才撤（还没到点的那些由上面的 g_minstrelDrunk 挡住）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 50]) {
            if (g_minstrelDrunk[q]) {
                // 还没到点：留着
            }
            else {
                g_tokOn[(((g_teller * 14) + q) * 256) + 50] = false;
            }
        }
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：黄昏重新算一次
    // 主谋（42）：加时这一天没人被处决 → 解除武装，按原本规则判（恶魔已死 → 善良胜）
    if (g_mmArmed && !g_gameOver) {
        g_mmArmed = false;
        g_mmDone = true;                 // 加时走完了（g_mmExtra 留着，免得又被判成「刚开始加时」）
        BOTC_PmStore(g_teller, "【主谋】加时这一天没人被处决 → 加时结束，按原本规则结算。");
        BOTC_CheckWin();
    }
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21）：黄昏重算常驻效果；涡流还要查「今天有没有人被处决」
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_VortoxDuskCheck();
    // 【利维坦（127）】放在所有黄昏标记清理 / 重算之后：第五天中毒 / 醉酒解除的那一刻才能正确判定。
    BOTC_LeviathanDuskCheck();
    // 【教父×陌客】（用户 2026-11-05）：进入夜晚前还没回答 → 按不算外来者处理。
    BOTC_GfRecluseSettle();
}

// 传位：把某个座位改成「死掉的那只恶魔」（说书人那份和他自己那份魔典一起改），并告诉他
// 【传位目标 q 是格子】（用户 2026-10-07）：给谁刷魔典要走 g_who[q]。
void BOTC_PromoteTo (int q) {
    int i;
    int idx;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    // 【变成同一只恶魔】（用户 2026-09-21）：以前固定改成小恶魔，现在看死掉的是哪一只
    if (g_demonKind < 21 || g_demonKind > 163 || BOTC_RoleTeam(g_demonKind) != 3) {
        g_demonKind = 21;
    }
    BOTC_SetSeatRole(g_teller, q, g_demonKind);
    BOTC_SetSeatRole(g_who[q], q, g_demonKind);
    // 【重要】这里**故意不清** g_pair* / g_pairV* 那套「观察者 × 座位」缓存：
    //   ① 还没看过他的中毒 / 酒鬼（共情者、占卜师等），之后第一次看他时按新身份算 ----
    //      「恶魔一定被看成善良」这条会照常生效；
    //   ② 已经把他看成邪恶的（中毒 / 酒鬼时判过），之后保持不变，不会被这次传位洗白。
    // 【诊断】把「传位前已经把他看成邪恶的中毒 / 酒鬼观察者」写一行，方便测试时核对
    s = "";
    for (i = 2; i <= 13; i += 1) {
        idx = (i * 14) + q;
        if (g_pairImp[idx] == 1) {
            if (g_pairVAlign[idx] == 1) {
                s = s + BOTC_NameStr(i) + " ";
            }
        }
    }
    if (s != "") {
        BOTC_DiagStore(g_teller, "【诊断传位】" + BOTC_NameStr(q) + " 变成恶魔，但这些人中毒 / 酒鬼时已经把他看成邪恶，之后不变：" + s);
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[q]);
    // 被改成小恶魔的玩家一定要收到通知：私聊一行 + 屏幕字幕 + 提示条，三种都给
    BOTC_ChangeRoleMsg(q, g_demonKind);
    // 智能说书：新恶魔诞生，重新抽 3 个不在场身份发给他
    BOTC_SkillBtnRender();
    // 【红唇继承诺-达鲺】（用户 2026-11-04）：传位后按新恶魔位置重算两侧中毒标记，旧恶魔身边的标记清掉。
    if (g_demonKind == 70) {
        BOTC_NoDashiiSync();
    }
}

// 真正活着的人数（按说书人那份的死亡记录算：token 记的隐蔽死亡也算死）
int BOTC_AliveCountTrue () {
    int i;
    int q;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!BOTC_PhysicallyDead(q)) {
            n = n + 1;
        }
    }
    return n;
}

// 红唇女郎（索引 19）被动：场上没有活着的恶魔时，如果**恶魔死之后还有 ≥4 人活着**，她直接变成新的恶魔
//   （官方原话是「恶魔死前有 5 人以上活着」，两种说法等价；用户 2026-09-19 明确按 ≥4 算）
//   谁杀的、怎么死的都不看，只看「恶魔身上有没有死亡 token」---- token 里记了恶魔死了就算数
//   （哪怕还没公开红叉给别的玩家看）；她自己也必须是「token 里还活着」的那个人；
//   她中毒 / 酒鬼时能力失效（本人不当场知道）；变身是悄悄进行的（只私聊新恶魔 + 写说书人日志）。
//   变身后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）。
//   返回值：true = 已经变身（调用方不要再走「说书人传位 / 智能随机」那套）。
//==================================================================================================
void BOTC_ScarletOpenPick (string candidates) {
    g_scarletPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择红唇女郎接刀"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_skillNoPick[1], PlayerGroupSingle(g_teller), false);
    BOTC_Notice(g_teller, "【红唇女郎】场上有多名可用持有者：请选择其中一名接刀。");
    BOTC_PmStore(g_teller, "【红唇女郎】多名候选：" + candidates + "。请点其中一名确认。");
    BOTC_GrimRender(g_teller);
}

bool BOTC_ScarletPromote (int sw) {
    int i;
    int alive;
    if (sw < 2 || sw > 13 || !g_seatOn[sw] || BOTC_SeatDead(sw) || !BOTC_AbilityWorks(sw, 19)) {
        return false;
    }
    g_scarletPick = false;
    // 小怪宝局：身份仍是红唇女郎，只接手小怪宝的「是恶魔」标记。
    if (g_lmOn) {
        for (i = 1; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 134] = false;
        }
        g_tokOn[(((g_teller * 14) + sw) * 256) + 134] = true;
        g_lmSeat = sw;
        BOTC_SeatStateSync();
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[sw]);
        BOTC_PmInfo(g_who[sw], "【小怪宝】现在由你照看小怪宝；你的身份仍是红唇女郎。");
        BOTC_PmStore(g_teller, "【红唇女郎】" + BOTC_NameStr(sw) + " 接刀，接手照看小怪宝。");
        return true;
    }
    BOTC_PromoteTo(sw);
    g_tokOn[(((g_teller * 14) + sw) * 256) + 123] = false;
    g_alcBorrow = 0;
    g_tokOn[(((g_teller * 14) + sw) * 256) + 13] = true;
    BOTC_GrimRender(g_teller);
    alive = BOTC_AliveCountTrue();
    BOTC_Notice(g_teller, "红唇女郎规则：" + BOTC_NameStr(sw) + " 接刀，成为新的恶魔。");
    BOTC_PmStore(g_teller, "【红唇女郎】" + BOTC_NameStr(sw) + " 接刀；当前真实存活 " + IntToString(alive) + " 人。");
    return true;
}

// 僵怖首次假死是项目自定义的接刀触发点：即使僵怖内部仍算活着，也让红唇女郎接刀。
bool BOTC_ScarletAfterZombuul () {
    int i;
    int count;
    int only;
    string candidates;
    if (g_scarletPick) {
        return true;
    }
    count = 0;
    only = 0;
    candidates = "";
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i) || !BOTC_AbilityWorks(i, 19)) {
            continue;
        }
        count = count + 1;
        only = i;
        if (candidates != "") {
            candidates = candidates + "、";
        }
        candidates = candidates + BOTC_NameStr(i);
    }
    if (count < 1) {
        return false;
    }
    g_demonKind = 43;
    if (count > 1) {
        BOTC_ScarletOpenPick(candidates);
        BOTC_PmStore(g_teller, "【僵怖 × 红唇女郎】僵怖首次假死触发接刀；请选择一名红唇女郎。");
        return true;
    }
    BOTC_PmStore(g_teller, "【僵怖 × 红唇女郎】僵怖首次假死触发接刀：" + BOTC_NameStr(only) + " 成为新的恶魔。");
    return BOTC_ScarletPromote(only);
}

bool BOTC_ScarletCheck () {
    int i;
    int q;
    int sw;
    int alive;
    int count;
    string candidates;
    sw = 0;
    count = 0;
    candidates = "";
    if (g_scarletPick) {
        return true;
    }
    BOTC_BuildSeatList();
    // 【画皮 × 红唇女郎】恶魔成为活尸时已经真实死亡，直接按没有存活恶魔结算，不触发红唇接任。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (g_liveCorpse[q] && BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            BOTC_PmStore(g_teller, "【画皮 × 红唇女郎】恶魔 " + BOTC_NameStr(q) + " 已成为活尸（真实死亡）→ 红唇女郎不接任。");
            return false;
        }
    }
    // 【小怪宝局】（用户 2026-10-11）：这一局的「恶魔」是**照看小怪宝的那个人**（token 134 / g_lmSeat），
    //   他的真身其实是爪牙（只是被 token 当成 112）---- 所以：
    //   ① 照看人还活着 → 轮不到红唇（原来这里只扫真身 team 3，小怪宝局里永远扫不到，
    //      于是随便死个人她都可能变身）；
    //   ② 还没指定谁照看（g_lmSeat = 0）→ 也当「没有死掉的恶魔」，她不该变身。
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;
        }
        if (!BOTC_SeatDead(g_lmSeat)) {
            return false;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            return false;                 // 场上还有活着的恶魔：还轮不到红唇女郎
        }
        // 【按能力认人】（用户 2026-10-13）：原来写死「真身 = 19」----
        //   可这个能力可能是**借来的**（炼金术士 95 / 哲学家 56 / 食人族 74），他们的真身不是 19，
        //   于是「炼金术士借到红唇」永远顶不上位。BOTC_HasAbility 把这四种都算上。
        if (BOTC_AbilityWorks(q, 19)) {
            sw = q;
            count = count + 1;
            if (candidates != "") {
                candidates = candidates + "、";
            }
            candidates = candidates + BOTC_NameStr(q);
        }
    }
    if (count < 1) {
        return false;                     // 场上没有活着的红唇女郎
    }
    // 人数门槛（用户 2026-09-19）：按「恶魔**死了之后**还活着几个人」算，≥4 就能顶
    alive = BOTC_AliveCountTrue();
    if (alive < 4) {
        BOTC_PmStore(g_teller, "【红唇女郎】恶魔已经死了，但场上只有 " + IntToString(alive) + " 人活着，她不能变身。");
        return false;
    }
    if (count > 1) {
        BOTC_ScarletOpenPick(candidates);
        return true;
    }
    // 【相克 · 小怪宝 × 红唇女郎】（用户 2026-10-13 更正）：她**身份不变**，只是接手照看小怪宝 ----
    //   规则上她还是红唇女郎（魔典上那张牌该写「红唇女郎」），只是「**是恶魔（小怪宝）**」----
    //   所以这里**不动真身**，只把 token 134 挪到她身上、并把 g_lmSeat 指向她（照看人 = 现在的恶魔）。
    //   胜负那边靠 token 134 / g_lmSeat 判定，所以照样是「活着的新恶魔」，不会立刻判善良胜。
    //   （原来那版把她的真身改成了 112 小怪宝 ---- 牌面会写成「小怪宝」，跟规则不符。）
    if (g_lmOn) {
        for (i = 1; i <= 13; i += 1) {
            if (i == sw) { continue; }
            g_tokOn[(((g_teller * 14) + i) * 256) + 134] = false;
        }
        g_tokOn[(((g_teller * 14) + sw) * 256) + 134] = true;
        g_lmSeat = sw;
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[sw]);
        BOTC_PmInfo(g_who[sw], "【小怪宝】照看它的人已经死了 → 现在由你照看小怪宝（你的身份没变，还是红唇女郎）。");
        BOTC_PmStore(g_teller, "【红唇女郎】照看小怪宝的人已经死了、场上还有 " + IntToString(alive) + " 人活着 → 改由 " + BOTC_NameStr(sw) + " 照看小怪宝（她身份不变，牌面仍是红唇女郎，只是「是恶魔」）。");
        return true;
    }
    BOTC_PromoteTo(sw);
    // 【借能力上位的人要把「借用」痕迹清掉】（用户 2026-10-13）：炼金术士(95) 靠 token 123 + g_alcBorrow 记账，
    //   BOTC_SeatTrueRole 会按它读回 95（镇民）→ 胜负那边就看不到「活着的恶魔」了。
    //   （哲学家 70 / 食人族 97 的两枚由 BOTC_SetSeatRole 的离场清理收掉，这里只管炼金那两笔。）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 123] = false;
    g_alcBorrow = 0;
    // 继位之后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 13] = true;
    BOTC_GrimRender(g_teller);
    BOTC_Notice(g_teller, "红唇女郎规则：恶魔已死、场上还有 " + IntToString(alive) + " 人活着 ---- " + BOTC_NameStr(sw) + " 直接变成了新的恶魔。");
    return true;
}

//==================================================================================================
// 镇长（索引 12）：被恶魔攻击时可能由别人替他死（一次性被动）+ 特殊胜利；以及通用胜负检查
//==================================================================================================
// 该弹谁：善良方只比邪恶方多 0~2 人（邪恶方快追平）→ 弹活着的邪恶；否则弹善良，优先顺序：
//   ① 已经用掉限次技能（打了「失去能力」token）② 一次性信息者（分类 1）/ 外来者 ③ 其他镇民
int BOTC_MayorPick (int mayor) {
    int i;
    int q;
    int r;
    int good;
    int evil;
    int n;
    int pick;
    int n1;
    int n2;
    int n3;
    int p1;
    int p2;
    int p3;
    good = 0;
    evil = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            evil = evil + 1;
        }
        else {
            good = good + 1;
        }
    }
    // 邪恶方快追平：弹一个活着的邪恶
    if (good - evil <= 2) {
        n = 0;
        pick = 0;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == mayor || BOTC_SeatDead(q)) {
                continue;
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleAlign(r) == 1) {
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = q;
                }
            }
        }
        return pick;
    }
    // 善良方领先：弹善良方（三个优先级各挑一个，最后按优先级取）
    n1 = 0;
    n2 = 0;
    n3 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 12] || g_tokOn[(((g_teller * 14) + q) * 256) + 17]) {
            n1 = n1 + 1;
            if (RandomInt(1, n1) == 1) {
                p1 = q;
            }
        }
        else {
            if (g_roleInfoClass[r] == 1 || BOTC_RoleTeam(r) == 1) {
                n2 = n2 + 1;
                if (RandomInt(1, n2) == 1) {
                    p2 = q;
                }
            }
            else {
                n3 = n3 + 1;
                if (RandomInt(1, n3) == 1) {
                    p3 = q;
                }
            }
        }
    }
    if (p1 >= 2) {
        return p1;
    }
    if (p2 >= 2) {
        return p2;
    }
    return p3;
}

// 镇长被恶魔攻击：返回 true = 这次不按正常流程打死镇长（替死的人写在 g_mayorVictim，0 = 没人死）
//   智能说书：按 g_mayorBounceChance% 判定，成功就替死并给镇长打「失去能力」token（之后不再弹）；
//   手动说书：不自动弹，只把建议写给说书人，镇长这次不死，由他自己处理。
bool BOTC_MayorBounce (int mayor) {
    int pick;
    g_mayorVictim = 0;
    if (!g_started) {
        return false;
    }
    pick = BOTC_MayorPick(mayor);
    if (pick >= 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    else {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    return true;
    if (RandomInt(1, 100) > g_mayorBounceChance) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定没弹成，镇长自己死。");
        return false;
    }
    if (pick < 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，但场上没有能替他的人，镇长自己死。");
        return false;
    }
    g_mayorVictim = pick;
    g_tokOn[(((g_teller * 14) + mayor) * 256) + 18] = true;   // 一次性被动：内部记账（这一格不显示在面板 / 圆桌上）
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，" + BOTC_NameStr(pick) + " 替他死了。");
    return true;
}

//==================================================================================================
// 【镇长（12）手动拍板】（用户 2026-09-21）：恶魔那一刀现在是脚本自己打 token 的，
//   所以改成 ---- 一旦**即将**给镇长打上「夜间」死亡 token，就弹窗问说书人：
//     【是】→ 说书人在魔典上点一个座位，那个人替他死（镇长不死）；
//     【否】→ 镇长自己死（把挂起来的那次死亡补上）。
//   智能说书还是老样子：按 g_mayorBounceChance% 自动判定。
//==================================================================================================
bool BOTC_MayorCanAsk (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_started || g_gameOver) {
        return false;
    }
    if (g_mayorBusy || g_mayorAskOn || g_mayorPick) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 12)) {
        return false;                       // 中毒 / 酒鬼 → 能力失效
    }
    return true;
}

// 记下「等一下要补的那次死亡」，并决定是弹窗还是自动判定；返回 true = 这次死亡先别记
bool BOTC_MayorTakeOver (int q, int row, int byDemon, int srcRole, int src, bool tokPath, int tok) {
    if (!BOTC_MayorCanAsk(q)) {
        return false;
    }
    g_mayorAskQ = q;
    g_mayorAskRow = row;
    g_mayorAskByDemon = byDemon;
    g_mayorAskSrcRole = srcRole;
    g_mayorAskSrc = src;
    g_mayorUseTokPath = tokPath;
    g_mayorAskTok = tok;
    BOTC_MayorAskShow(q);
    g_mayorHold = true;
    return true;
}

// 记死亡那条通道（死亡 token 一打上就走这里）
bool BOTC_MayorInterceptRow (int q, int row, int tok) {
    if (row < 0 || row >= g_deathN) {
        return false;
    }
    if (g_deathKind[row] != 1) {
        return false;                       // 只拦「夜间」死因：处决 / 白天死的不算
    }
    return BOTC_MayorTakeOver(q, row, g_deathByDemon[row], -1, 0, false, tok);
}

// 说书人在 token 面板手动打死亡 token 那条通道
bool BOTC_MayorInterceptTok (int q, int t) {
    int k;
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            if (g_deathKind[k] != 1) {
                return false;
            }
            return BOTC_MayorTakeOver(q, k, g_deathByDemon[k], -1, 0, true, t);
        }
    }
    return false;
}

void BOTC_BuildMayorAsk () {
    // 【技能框往右挪 200】（用户 2026-09-23）：镇长弹刀那个框
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_mayorDlg = DialogLastCreated();
    DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    g_mayorTitle = BOTC_NewLabel(g_mayorDlg, 666, 44, 18, 13, StringToText("镇长夜里要死了：要不要让别人替他死？"));
    libNtve_gf_SetDialogItemStyle(g_mayorTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mayorTitle, false, PlayerGroupAll());
    g_mayorYes = BOTC_NewButton(g_mayorDlg, 306, 50, 27, 81, "是：我选一个人替他死");
    g_mayorNo = BOTC_NewButton(g_mayorDlg, 306, 50, 351, 81, "否：镇长自己死");
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
}

void BOTC_MayorAskShow (int q) {
    g_mayorAskOn = true;
    libNtve_gf_SetDialogItemText(g_mayorTitle, BOTC_PlayerNameText(q) + StringToText(" 夜里要死了：要不要让别人替他死？"), PlayerGroupSingle(g_teller));
    // 【换座位后的说书人也要有按钮】（用户 2026-10-18）
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_mayorDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "镇长夜里要死了：选【是】= 你点一个人替他死，选【否】= 镇长自己死。");
}

void BOTC_MayorAskHide () {
    g_mayorAskOn = false;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 换局 / 收摊：这一套状态清干净
void BOTC_MayorClear () {
    g_mayorAskOn = false;
    g_mayorPick = false;
    g_mayorBusy = false;
    g_mayorHold = false;
    g_mayorAskQ = 0;
    g_mayorAskRow = 0;
    g_mayorAskSrc = 0;
    g_mayorAskSrcRole = -1;
    g_mayorAskByDemon = 0;
    g_mayorUseTokPath = false;
    g_mayorAskTok = 0;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 把挂起来的那次死亡补上（回答【否】/ 放弃替死都走这里）
void BOTC_MayorResolveSelf () {
    int q;
    q = g_mayorAskQ;
    if (q < 2 || q > 13) {
        BOTC_MayorClear();
        return;
    }
    g_mayorBusy = true;
    if (g_mayorUseTokPath) {
        BOTC_SyncDeathFromTok(q, g_mayorAskTok);
    }
    else {
        BOTC_MarkDeathRowTok(q, g_mayorAskRow, g_mayorAskTok, false);
        if (g_mayorAskSrc >= 2) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(g_mayorAskSrc) + "（" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(g_mayorAskSrc)) + "）击杀。");
        }
        if (g_mayorAskByDemon != 0) {
            BOTC_NanaLinkCheck(q);
        }
    }
    g_mayorBusy = false;
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 说书人点了【是】/【否】
void BOTC_MayorAnswer (int ans) {
    if (!g_mayorAskOn) {
        return;
    }
    BOTC_MayorAskHide();
    if (ans == 0) {
        BOTC_MayorResolveSelf();
        return;
    }
    g_mayorPick = true;
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    if (g_deadPick) {
        g_deadPick = false;
        libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_teller), true);
    g_grimOn[g_teller] = true;
    BOTC_Notice(g_teller, "选择一个玩家");
    BOTC_BigHintShow(1, "点一个座位：这个人替镇长死。");
}

// 说书人在魔典上点了座位：这个人替死
void BOTC_MayorVictimAt (int v) {
    int q;
    q = g_mayorAskQ;
    if (v < 2 || v > 13 || v == q || BOTC_SeatDead(v)) {
        BOTC_Notice(g_teller, "这个人不能替他死，换一个。");
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    g_mayorBusy = true;
    BOTC_MarkDeathRowTok(v, g_mayorAskRow, g_mayorAskTok, false);   // 替死：把**同一个**死亡 token 原样转移过去
    g_mayorBusy = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 18] = true;      // 一次性被动：用掉了
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(v) + " 替 " + BOTC_NameStr(q) + " 死了。");
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 点座位之前反悔（按【死亡标记】= 放弃这次替死，镇长照常死）
void BOTC_MayorCancel () {
    if (!g_mayorPick) {
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    BOTC_MayorResolveSelf();
}

// 通用胜负检查：每次有人死之后都可以调
//   善良胜：场上没有活着的恶魔；邪恶胜：场上只剩 2 人活着；
//   两条同时满足（比如剩 3 人时恶魔被处决）时判善良胜。
bool BOTC_AtheistOn () {
    return BOTC_AbilityInPlay(83);
}

void BOTC_CheckWin () {
    int i;
    int q;
    int r;
    int alive;
    int demonAlive;
    int demonSeat;                 // 已经死掉的那只恶魔坐在哪（0 = 没有）
    bool mmAlive;                  // 主谋是不是活着且清醒
    if (g_gameOver || !g_started) {
        return;
    }
    if (g_scarletPick) {
        return;                         // 等候说书人指定红唇女郎，暂不判胜负
    }
    // 【食人魔（148）· 挚友】（用户 2026-11-11）：判胜前先让食人魔的阵营追上朋友的最新阵营。
    BOTC_OgreFriendSync();
    // 【哥布林(99) 兜底判胜】（用户 2026-10-23 更正）：
    //   必须明确记录为「处决」（g_deadKind == 3）才能触发。
    //   用【死亡标记】打红叉，或其它死亡 token，都不算处决，不得触发哥布林胜利。
    for (i = 2; i <= 13; i += 1) {
        if (!g_goblinClaim[i] || g_goblinClaimDay[i] != g_nightNum) {
            continue;
        }
        if (!BOTC_SeatDead(i) || g_deadKind[i] != 3) {
            continue;
        }
        if (!BOTC_AbilityWorks(i, 99)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
        BOTC_ShowWin(BOTC_SeatAlign(i), "哥布林" + BOTC_NameStr(i) + "亮出了他的真身，", "他的阵营就此得逞。");
        return;
    }
    // 【天亮排队播报还没走完】（用户 2026-09-26）：先不判胜负，等最后一条播完再判
    if (g_dawnQN > 0) {
        return;
    }
    // 【主谋加时期间不判胜负】（用户 2026-09-20）：恶魔被处决之后要打完「加时的一夜 + 一天」，
    //   这段时间唯一的胜负来源是：
    //     ① 加时那一天的处决（`BOTC_ExecToggleAt` 里按真身阵营立刻判负）；
    //     ② 加时那一天没人被处决 → 那个黄昏由 `BOTC_DuskResolve` 收掉加时、再来判（恶魔已死 → 善良胜）。
    //   所以这里直接返回，免得「天一亮」就按「没有活着的恶魔」把善良判胜了。
    if (g_mmExtra && !g_mmDone) {
        return;
    }
    // 【镜像双子（64）】（用户 2026-09-21）：两个双子都活着 → 善良阵营此刻不能获胜（先把双子解决掉）
    if (BOTC_TwinBlocksGood()) {
        BOTC_PmStore(g_teller, "【镜像双子】两只双子都还活着 → 善良阵营现在不能获胜。");
        return;
    }
    demonAlive = 0;
    demonSeat = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        // 【判胜负看「确定死亡」= 红叉 + 真的死了】（用户 2026-09-20）----
        //   夜里刚记下的死亡（只有 token、还没到天亮盖红叉）**不算**：等天亮统一结算
        //   （死亡 token 自动打红叉 / 复活 token 自动复活）之后再来判胜负；
        //   僵怖那种「盖了红叉但其实还活着」的座位也不算死。
        if (BOTC_SettledDead(q)) {
            if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
                demonSeat = q;          // 已经公开死亡的恶魔（用来判断「是不是死于处决」）
            }
            continue;
        }
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 3) {
            demonAlive = demonAlive + 1;
        }
    }
    // ⓪ 主谋（42）：**恶魔死于处决**、而且主谋还活着且清醒 → 不结算胜负，改打「加时一夜 + 一天」。
    //   ⚠ 用户 2026-09-20 的口径：只有「死于处决」才给加时 ---- 夜里被刀 / 造谣者 / 月之子 / 赌徒
    //     这类死法照常结算（善良胜），主谋不管用。
    //   ⚠ 相克 · 亡骨魔 × 主谋：被亡骨魔杀死的主谋带着「保留能力」token 79，死了也算有这份能力。
    if (demonAlive == 0 && !g_mmExtra) {
        mmAlive = false;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (!BOTC_AbilityWorks(q, 42)) {
                continue;
            }
            if (BOTC_SeatDead(q) && !g_tokOn[(((g_teller * 14) + q) * 256) + 79]) {
                continue;
            }
            mmAlive = true;
        }
        if (demonSeat >= 2 && g_deadKind[demonSeat] == 3 && mmAlive) {
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                if (!BOTC_AbilityWorks(q, 42)) {
                    continue;
                }
                if (BOTC_SeatDead(q) && !g_tokOn[(((g_teller * 14) + q) * 256) + 79]) {
                    continue;
                }
                g_mmExtra = true;
                g_mmArmed = false;
                g_lastDeadSeat = 0;       // 这次恶魔死亡已经转化为主谋加时，不能再改写后续加时处决
                BOTC_PmStore(g_teller, "【主谋】恶魔（" + BOTC_NameStr(demonSeat) + "）死于处决，而主谋（" + BOTC_NameStr(q) + "）仍保留能力 → 进入加时：再打一夜 + 一天；这一天的处决决定胜负。");
                return;
            }
        }
    }
    // 【小怪宝（112）】（用户 2026-10-10）：抽到他的那一局**没有**「真身是恶魔」的角色 ----
    //   恶魔 = 被说书人打上「是恶魔（小怪宝）」的那个人（g_lmSeat）。他一旦「确定死亡」→ 善良胜。
    //   还没指定谁照看（开局那一会儿 g_lmSeat = 0）就先不判，免得一开局就判善良胜。
    if (g_lmOn) {
        // 小怪宝局：照看人（= 现在的恶魔）一死就判善良胜；没别的「恶魔」可杀
        if (g_lmSeat >= 2 && BOTC_SettledDead(g_lmSeat)) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    else {
        // ① 场上没有活着的恶魔 → 善良胜（哪怕这时也只剩 2 人，两条同时满足还是判善良）
        if (demonAlive == 0 && !BOTC_AtheistOn() && !BOTC_SummonerWaiting()) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    // ③ 场上只剩 2 人活着（恶魔还活着）→ 邪恶胜
    //   ⚠ 人数也按**公开死亡（红叉）**算：夜里刚死、还没到天亮的先不算 ----
    //     这样「今晚杀人 + 反刍复活」会在天亮一起结算完再判，不会因为说书人还没来得及复活就先判负。
    alive = 0;
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SettledDead(g_seatList[i])) {
            alive = alive + 1;
        }
    }
    if (alive <= 2) {
        // 【无神论者的特殊胜利】（用户 2026-09-26）：真身无神论者在场 + 只剩 2 人活着（说书人没被处决）→ 说书人胜
        if (BOTC_AtheistOn()) {
            BOTC_ShowWin(2, "只剩 " + IntToString(alive) + " 名玩家存活，说书人没有被处决", "");
            return;
        }
        BOTC_ShowWin(1, "恶魔骗过了镇民，", "屠戮了整个小镇。");
    }
}

// 镇长的特殊胜利：黄昏（进夜晚）时只剩 3 个人活着、且今天没有处决过人 → 他的阵营获胜
void BOTC_CheckMayorWin () {
    int i;
    int q;
    int mayor;
    if (g_gameOver || !g_started) {
        return;
    }
    mayor = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_AbilityWorks(q, 12)) {
            mayor = q;
        }
    }
    if (mayor < 2) {
        return;
    }
    if (g_execUsedToday) {
        return;                        // 今天处决过人
    }
    if (BOTC_AliveCountTrue() == 3) {
        BOTC_ShowWin(BOTC_SeatAlign(mayor), "伟大的镇长" + BOTC_NameStr(mayor) + "建了一堵高墙，", "将所有恶魔驱逐出境！");
    }
}

// 胜负横幅：只弹自定义画面（不动游戏自带结束按钮），说书人点【继续】收掉，然后可以开下一把
//   以后想换成图片：把 g_winBg 的贴图按 g_winSide 设成 botc_win_good.dds / botc_win_evil.dds 即可
// 【异端分子(101)】（用户 2026-10-04 / 2026-11-03）：数场上**生效的**异端分子能力份数。
//   口径（用户两次强调）：**醉酒 / 中毒 → 失去能力、不对调**；**死亡 → 不会失去能力、照样对调**。
//   BOTC_SeatImpaired = 醉酒 OR 中毒（包含了「哲学家让人醉」「心上人醉酒」那几份），
//   里面**没有任何**「死了就算失能」的判断 —— 所以这里直接用它就是对的口径。
//   ⚠ 以后别往这里加 BOTC_SeatDead：那会把「死后仍然生效」这条弄没（用户明确要求保留）。
//   （用 BOTC_AbilityWorks 判，所以「哲学家借到异端分子 / 食人族吃掉异端分子 / 炼金术士借到」也算。）
//   多份能力要按次数反复对调（2 份 = 对调 2 次 → 抵消），见 BOTC_ShowWin。
int BOTC_HereticCount () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_AbilityWorks(i, 101)) {
            n = n + 1;
        }
    }
    return n;
}

bool BOTC_HereticOn () {
    return (BOTC_HereticCount() % 2) == 1;
}

// 【善良的胜利条件现在成立吗】（用户 2026-10-10）：场上没有活着的恶魔
//   小怪宝那一局：恶魔恒等于「照看他的那个人」→ 看他死没死
//   判定口径跟 BOTC_CheckWin 一致：用 BOTC_SettledDead（红叉 + 真的死了），夜里刚记的死亡不算
// 【这一格现在算不算「恶魔」】（用户 2026-10-11）：处决 / 死亡结算里判「一个事件同时达成两边」用
//   · 真身阵营是恶魔（team 3）→ 算；
//   · 小怪宝那一局：照看他的人就是恶魔 —— 他死后那枚 token 会被离场清理收掉，
//     真身会变回他原来的爪牙角色，所以这里用 g_lmSeat 兜住。
bool BOTC_IsDemonSeat (int q) {
    int r;
    if (q < 1 || q > 13) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
        return true;
    }
    if (g_lmOn && q == g_lmSeat) {
        return true;
    }
    return false;
}
bool BOTC_GoodWinNow () {
    int i;
    int q;
    int r;
    if (BOTC_SummonerWaiting()) {
        return false;                  // 召唤师未完成召唤：不自动按无恶魔判胜
    }
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;              // 还没指定谁照看 → 先不算善良达成
        }
        return BOTC_SettledDead(g_lmSeat);
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SettledDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
            return false;
        }
    }
    return true;
}

void BOTC_WinAdminRender () {
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupAll(), false);
    if (!g_started || g_isNight || g_gameOver) {
        g_winPanelOn = false;
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupSingle(g_teller), true);
    if (!g_winPanelOn) {
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    if (g_winLocked) {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("√ 锁定"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("锁定"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_winAdminDlg, PlayerGroupSingle(g_teller), true);
}

bool BOTC_WinAdminClick (int p, int c) {
    if (p != g_teller) {
        return false;
    }
    if (c == g_winAdminBtn) {
        g_winPanelOn = !g_winPanelOn;
        BOTC_WinAdminRender();
        return true;
    }
    if (!g_winPanelOn) {
        return false;
    }
    if (c == g_winAdminClose) {
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    if (c == g_winAdminLockBtn) {
        g_winLocked = !g_winLocked;
        BOTC_WinAdminRender();
        if (g_winLocked) {
            BOTC_NoticeKeep(g_teller, "【胜负】已锁定：所有玩家暂时无法获胜。");
        }
        else {
            BOTC_NoticeKeep(g_teller, "【胜负】已解除锁定。");
        }
        return true;
    }
    if (c == g_winAdminGoodBtn || c == g_winAdminEvilBtn) {
        if (g_winLocked) {
            BOTC_Notice(g_teller, "胜负状态已锁定：先点【解锁】才能结算。");
            return true;
        }
        g_manualWin = true;
        if (c == g_winAdminGoodBtn) {
            BOTC_ShowWin(0, "说书人手动宣布善良阵营胜利。", "");
        }
        else {
            BOTC_ShowWin(1, "说书人手动宣布邪恶阵营胜利。", "");
        }
        g_manualWin = false;
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    return false;
}

void BOTC_ShowWin (int side, string why1, string why2) {
    if (g_gameOver) {
        return;
    }
    // 【政客（97）】（用户 2026-11-10）：已经弹窗在等说书人回答，重复调用直接忽略，
    //   否则会重新算一遍异端分子对调、还把没问完的政客跳过去。
    if (g_polSeat >= 2) {
        return;
    }
    if (!g_started) {
        return;
    }
    if (g_winLocked) {
        BOTC_PmStore(g_teller, "【胜负】当前处于锁定状态，本次胜利被阻止。");
        return;
    }
    // 【双方同时达成胜利条件 → 优先善良胜】（用户 2026-10-10）：全图胜负只有这一个出口，所以规则挂在这里 ——
    //   只要这一次判的不是善良胜，而此刻**善良的胜利条件也成立**（场上没有活着的恶魔；
    //   小怪宝那局 = 照看他的人已死），一律改判**善良胜**。
    //   例：善良的圣徒正带着小怪宝被处决（圣徒规则说善良落败 + 恶魔死亡说善良获胜）→ 判善良胜。
    //   ⚠ **只认「最近一次死亡正好是恶魔」**（`g_lastDeadSeat` + `BOTC_IsDemonSeat`）：
    //     只有「这一下死的是恶魔」才叫同时达成；跟死亡无关的胜利（教派投票 / 只剩 2 人 / 镇长 / 主谋…）
    //     一律不许被这条改写。
    //     （原来用「处决结算中」那个标记会被处决函数里的早退 `return` 漏掉，标记一直留着，
    //       把后面的教派投票也抢成善良胜 —— 用户 2026-10-11 报的就是这个。）
    //   ⚠ 无神论者那局（本来就没有恶魔）不套这条，免得把「说书人胜」也盖掉。
    //   ⚠ 主谋加时中的处决必须按被处决者阵营结算，哪怕 `g_lastDeadSeat` 仍然指向
    //     加时开始前死掉的恶魔，也不能改写为善良胜。
    //   ⚠ **还要再确认「场上真的没有别的恶魔活着」**（用户 2026-10-13 报的方古 BUG）：
    //     方古那一刀是「老方古死 + 外来者当场变成新方古」，最近死的确实是恶魔，可新方古还活着
    //     → 这时候判邪恶胜（只剩 2 人）是对的，**不能**被这条改写成善良胜。
    //     所以再加一道 `BOTC_GoodWinNow()`（= 场上没有活着的恶魔；小怪宝那局 = 照看人已死）。
    if (!g_manualWin && !g_mmExtra && side != 0 && !BOTC_AtheistOn() && BOTC_GoodWinNow() && g_lastDeadSeat >= 2 && g_lastDeadSeat <= 13 && BOTC_SeatDead(g_lastDeadSeat) && BOTC_IsDemonSeat(g_lastDeadSeat)) {
        side = 0;
        why1 = "镇民们找出并处决了所有恶魔！";
        why2 = "";
        BOTC_PmStore(g_teller, "【胜负】双方同时达成胜利条件 → 按规则优先判**善良胜**。");
    }
    // 【异端分子(101)】（用户 2026-10-04）：官方口径 —— 有生效的异端分子 → **胜负对调**（死后仍然生效）。
    //   放在 BOTC_ShowWin 里 = **所有阵营胜负自动全覆盖**（用户 2026-10-04 明确要求「特殊胜利也要」）：
    //     恶魔全灭 / 只剩 2 人 / 镇长 / 圣徒 / 镜像双子 / 哥布林 / 恐惧之灵 / 主谋加时两个分支 /
    //     无神论者被处决 / 处决说书人 …… 全图只有这一个出口，所以都是在同一处对调。
    //   ⚠ 没有例外（用户 2026-10-04 定稿「异端分子会反转所有胜负」）：
    //     连「说书人胜」（side 2 = 无神论者那条「只剩两人存活且说书人没被处决」）也一起反转，
    //     说书人那一侧是对局里的「邪恶」方 → 反转后记成**善良胜**（side 0）。
    //   ⚠ 多份异端分子能力按次数叠加对调（2 份 = 对调两次 → 抵消；3 份 = 对调一次）。
    if (!g_manualWin && BOTC_HereticOn()) {
        if (side == 0) {
            side = 1;
        }
        else {
            side = 0;
        }
        // 结局文案要**明说**被改写过：不然原来那句（例如「哥布林…他的阵营就此得逞」、
        // 「神之使徒…」这类按「谁赢」写死的话）会跟真实结果自相矛盾。
        why1 = "【异端分子】在场，结局已被改写——" + why1;
        why2 = why2 + "（异端分子在场：胜负结果已被对调）";
        BOTC_PmStore(g_teller, "【异端分子】能力生效 → 这次胜负对调。");
    }

    // 【政客（97）】（用户 2026-11-10）：政客所在阵营落败时，先问说书人是否让他改换阵营一起获胜。
    //   弹窗期间先不封盘（g_gameOver 还是 false），回答后由 BOTC_PoliticianAnswer 走同一个封盘出口。
    if (BOTC_PoliticianAsk(side, why1, why2)) {
        return;
    }
    BOTC_WinFinalize(side, why1, why2);
}

// 【政客（97）】（用户 2026-11-10）：胜负封盘 —— 原 BOTC_ShowWin 的收尾部分。
//   政客判定问完（或者根本不需要问）之后才走到这里，全图仍然只有这一个封盘出口。
void BOTC_WinFinalize (int side, string why1, string why2) {
    g_gameOver = true;
    // 【复盘】（用户 2026-11-11）：结算那一刻拍下结束身份 / 认知偏差 / 阵营，之后才允许在日志里查看
    BOTC_RpCapture(false);
    g_rpOn = true;
    // 【场次统计】（用户 2026-10-20）：唯一胜负出口只记一次；此时阵营 / 说书人座位都已经确定。
    BOTC_StatsRecord(side);
    // 【结算即恢复战网名】（用户 2026-11-12）：复盘仍已由上一行之前拍下；
    //   桌面和魔典从结算这一刻起显示各人的真实战网名。
    BOTC_ResetPlayerNames();
    // 【中途退出的座位要留到重新开始】（用户 2026-11-03）：结算期间玩家还要复盘看全场身份和 token，
    //   所以这里不再移除；等说书人点【重新开始】时才由 BOTC_WinRestart() 调用 BOTC_ClearLeftSeats()。
    // 【胜负那一刻也清投票状态】（用户 2026-10-10）：白天可能正停在提名 / 投票中间就分出了胜负 ——
    //   跟入夜用的是同一个 BOTC_NomReset()：已投 / 弃权 / 票数 / 待处决 / 提名记录全清，
    //   并退出提名阶段（免得胜负面板后面还挂着上一轮的投票标记）。
    BOTC_NomReset();
    g_cultOn = false;          // 【教派投票】：胜负已定就把这一轮投票收掉
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    g_winSide = side;
    g_winChat1 = why1;
    g_winChat2 = why2;
    if (StringLength(why2) > 0) {
        g_winReason = why1 + "\n" + why2;
    }
    else {
        g_winReason = why1;
    }
    g_winStage = true;
    BOTC_MusicStop();
    BOTC_PlaySfxTimed(g_sfxJieSuanName, 2.0);
    BOTC_EndNoticeShow();
    TimerStart(g_tWinStage, 5.0, false, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// 【政客（97）· 找人说书人判定】（用户 2026-11-10）
//   扫一遍还在座位上的玩家：拥有政客能力且能力生效（含哲学家 / 食人族 / 说书人赋予等借来的），
//   并且登记阵营不是这次获胜的那一侧 → 弹窗问说书人要不要让他转变阵营一起赢。
//   返回 true = 已经弹窗、正在等说书人回答（这一拍先别封盘）。
//   · 已经在获胜方阵营的政客不用问，本来就跟着赢。
//   · 「说书人胜」（side 2）= 无神论者对局：邪恶一侧是 align 1，转为邪恶即跟说书人一起赢。
//   · 多名政客逐个问，每人只问一次（g_polDone）。
//--------------------------------------------------------------------------------------------------
bool BOTC_PoliticianAsk (int side, string why1, string why2) {
    int i;
    int winAlign;
    if (side != 0 && side != 1 && side != 2) {
        return false;
    }
    // 已经在等回答：保持弹窗，别再换人问、也别让调用方直接封盘。
    if (g_polSeat >= 2) {
        return true;
    }
    winAlign = side;
    if (side == 2) {
        winAlign = 1;                   // 说书人胜 = 邪恶一侧
    }
    for (i = 2; i <= 13; i += 1) {
        if (g_polDone[i]) {
            continue;
        }
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_AbilityWorks(i, 97)) {
            continue;
        }
        if (BOTC_SeatAlign(i) == winAlign) {
            continue;
        }
        g_polDone[i] = true;
        g_polSeat = i;
        g_polSide = side;
        g_polWhy1 = why1;
        g_polWhy2 = why2;
        libNtve_gf_SetDialogItemText(g_polTitle, StringToText("【政客】" + BOTC_NameStr(i) + " 所在阵营落败\n是否让他转变阵营并一起获胜？"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_polYes, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_polNo, PlayerGroupSingle(g_teller), true);
        DialogSetVisible(g_polDlg, PlayerGroupSingle(g_teller), true);
        return true;
    }
    return false;
}

// 【政客（97）】（用户 2026-11-10）：说书人回答 —— 1 = 转变阵营并获胜 / 0 = 不转变。
//   转变 = 把该格写成获胜那一侧的 善良 / 邪恶 token，登记层随即作废缓存，
//   之后的场次统计、复盘魔典和胜负面板都按新阵营算。
void BOTC_PoliticianAnswer (int ans) {
    int q;
    int side;
    int winAlign;
    int i;
    string w1;
    string w2;
    q = g_polSeat;
    side = g_polSide;
    w1 = g_polWhy1;
    w2 = g_polWhy2;
    g_polSeat = 0;
    DialogSetVisible(g_polDlg, PlayerGroupAll(), false);
    if (q < 2 || q > 13) {
        return;
    }
    winAlign = side;
    if (side == 2) {
        winAlign = 1;                   // 说书人胜 = 邪恶一侧
    }
    if (ans != 0) {
        if (winAlign == 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;
            g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
        }
        else {
            g_tokOn[(((g_teller * 14) + q) * 256) + 14] = true;
            g_tokOn[(((g_teller * 14) + q) * 256) + 15] = false;
        }
        BOTC_PairClearSeat(q);
        BOTC_PmStore(g_teller, "【政客】" + BOTC_NameStr(q) + " 转变为" + BOTC_AlignName(winAlign) + "阵营，跟着获胜方一起胜利。");
        BOTC_PmInfo(g_who[q], "【政客】你的阵营转变为" + BOTC_AlignName(winAlign) + "，本局随获胜方一起胜利。");
    }
    else {
        BOTC_PmStore(g_teller, "【政客】" + BOTC_NameStr(q) + " 没有转变阵营，按原来的结果结算。");
    }
    for (i = 1; i <= 13; i += 1) {
        BOTC_GrimRender(i);
    }
    if (BOTC_PoliticianAsk(side, w1, w2)) {
        return;
    }
    BOTC_WinFinalize(side, w1, w2);
}

// 胜利该放哪一首（善良胜 + 存活 ≤ 3 → 第二首；邪恶胜 → 那首邪恶曲）
string BOTC_WinTrackName () {
    if (g_winSide == 1) {
        return g_musicEvilName;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        return g_musicGood2Name;
    }
    return g_musicGood1Name;
}

// 2 秒过场结束：弹胜利面板 + 播胜利曲
bool BOTC_WinStageFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_winStage) {
        return true;
    }
    g_winStage = false;
    BOTC_EndNoticeHide();          // 字幕收掉，换成胜利面板
    BOTC_ShowWinNow();
    BOTC_MusicPlay(BOTC_WinTrackName(), 6, 0.0);   // 优先级 6：比准备阶段（4）还高，谁都盖不掉
    return true;
}

//--------------------------------------------------------------------------------------------------
// 结算过场：屏幕正中那句「游戏结束，我们得到的结果是：」
//   放 jiesuan 音效的时候弹出来，一直留到胜利面板弹出 ---- 所以它有自己的一套显隐，
//   不走 BOTC_BigNotice 那个「3.5 秒自动收起」。
//--------------------------------------------------------------------------------------------------

// 跟 BOTC_NewLabelC 一样，但创建标签最后那个固定值（2.0）能自己给 ---- 用聊天指令 wbig 试它是不是字号倍率
int BOTC_NewLabelCY (int d, int w, int h, int x, int y, text t, fixed f) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, f);
    return DialogControlLastCreated();
}

void BOTC_EndNoticeMake () {
    if (g_endDlg != 0) {
        DialogDestroy(g_endDlg);       // 用 wbig 调参数时重建：先把旧的拆掉，免得叠层
        g_endDlg = 0;
    }
    DialogCreate(900, 120, c_anchorCenter, 0, 0, false);
    g_endDlg = DialogLastCreated();
    DialogSetImageVisible(g_endDlg, false);
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
    // 文字在标签里是**左对齐**的，居中得靠自己补偏移：这句 13 个字大概 390 宽，
    //   所以左边缘放在「中间往左 195」= 对话框内 x 255。嫌偏左偏右就改这个 255。
    g_endLbl = BOTC_NewLabelCY(g_endDlg, 880, 120, 255, 0, TextWithColor(StringToText("游戏结束，我们得到的结果是："), Color(255, 215, 60)), g_endSize);
    libNtve_gf_SetDialogItemStyle(g_endLbl, g_endStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_endLbl, false, PlayerGroupAll());
}

void BOTC_BuildEndNotice () {
    BOTC_EndNoticeMake();
}

void BOTC_EndNoticeShow () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), true);
}

void BOTC_EndNoticeHide () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
}

// 真正弹面板（原来的 BOTC_ShowWin 内容）
void BOTC_ShowWinNow () {
    // 【屏蔽】（用户 2026-11-06）：结算时自动解除所有玩家的屏蔽，复盘阶段大家都能看到全部发言。
    BOTC_BlockClearAll();
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_winLabel, StringToText("特殊胜利"), PlayerGroupAll());
        BOTC_PubAnnounce("【胜负】特殊胜利 ---- 说书人获胜：" + g_winChat1);
        if (StringLength(g_winChat2) > 0) {
            BOTC_PubAnnounce(g_winChat2);
        }
    }
    else {
        if (g_winSide == 1) {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("邪恶阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】邪恶阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
        else {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("善良阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】善良阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
    }
    // 分胜负了：邪恶小窗也一起关掉（免得盖在结算面板上）
    BOTC_EvilClose();
    libNtve_gf_SetDialogItemText(g_winSub, BOTC_NameSubst(g_winReason), PlayerGroupAll());   // 结算面板的正文：名字换成真名
    DialogSetVisible(g_winDlg, PlayerGroupAll(), true);
    BOTC_RateShowAll();             // 【说书人评分】结算面板下方的打分行发给除说书人以外的玩家
    // 【结算即自动公开真魔典】（用户 2026-11-03）：胜负一出就把说书人那份魔典（身份 + 全部 token）
    //   摊给全场，复盘时人人都能看到所有人的角色和标记；不再需要说书人手动点【复盘（公开魔典）】。
    BOTC_ReplayReveal();
    // 【换座位后的说书人也要能点】（用户 2026-10-18）：继续 / 复盘按钮按「现在的」说书人露出来
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_winBtn, PlayerGroupSingle(g_teller), true);
    // 结算时已经自动公开真魔典，不再保留单独的复盘按钮。
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    // 胜利面板上面那条「恭喜...获胜」（名字带各自的颜色）
    //   【2026-09-16 用户要求】要的是「去掉对话框（黑框）、信息留住」---- 所以这里照常显示，
    //   黑底在 BOTC_BuildWinCongrats() 里已经关掉了（那两行注释）。
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsStText(), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsText(), PlayerGroupAll());
    }
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), true);
}

void BOTC_BuildWin () {
    DialogCreate(660, 250, c_anchorCenter, 150, 0, false);
    g_winDlg = DialogLastCreated();
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】胜利面板不要底图：对话框自带的那层默认面板图也关掉，
    //   只留文字 + 复盘 / 继续两个按钮（黑图那层早就在下面 g_winBg 处隐藏了）
    DialogSetImageVisible(g_winDlg, false);
    libNtve_gf_CreateDialogItemImage(g_winDlg, 660, 250, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_winBg = DialogControlLastCreated();
    DialogControlSetPosition(g_winBg, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    libNtve_gf_SetDialogItemAcceptMouse(g_winBg, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_winBg, "botc_black.dds", PlayerGroupAll());
    // 【2026-09-16 用户要求】胜利面板先不要黑底：底图控件直接藏掉
    //   ⚠ 不能只是「不设贴图」---- 没贴图的图片控件会被星际画成占位蓝块，所以是「设了贴图再隐藏」
    DialogControlSetVisible(g_winBg, PlayerGroupAll(), false);
    g_winLabel = BOTC_NewLabelC(g_winDlg, 640, 60, 85, 55, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_winLabel, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winLabel, false, PlayerGroupAll());
g_winSub = BOTC_NewLabelC(g_winDlg, 1160, 64, 10, 118, StringToText(""));
libNtve_gf_SetDialogItemStyle(g_winSub, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winSub, false, PlayerGroupAll());
    g_winBtn = BOTC_NewButton(g_winDlg, 260, 40, 200, 180, "重新开始");
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    // 【复盘】说书人专用：把自己的魔典（含 token）替换给全场
    g_replayBtn = BOTC_NewButton(g_winDlg, 240, 40, 80, 180, "复盘（公开魔典）");
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetPosition(g_winBtn, PlayerGroupAll(), c_anchorTopLeft, 340, 180);
}

// 【说书人评分】（用户 2026-11-02）：结算面板下方的 1..5 分打分框。
//   只发给除说书人以外的在场真人；点完一次后本局不能再改。
void BOTC_BuildRate () {
    int i;
    DialogCreate(660, 46, c_anchorCenter, 150, 150, false);
    g_rateDlg = DialogLastCreated();
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    DialogSetImageVisible(g_rateDlg, false);
    g_rateLbl = BOTC_NewLabel(g_rateDlg, 170, 30, 8, 8, StringToText("为说书人打分："));
    libNtve_gf_SetDialogItemStyle(g_rateLbl, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_rateLbl, false, PlayerGroupAll());
    for (i = 0; i < 5; i += 1) {
        g_rateBtn[i] = BOTC_NewButton(g_rateDlg, 84, 30, 178 + (i * 92), 8, IntToString(i + 1) + " 分");
        libNtve_gf_SetDialogItemStyle(g_rateBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupAll(), false);
    }
}

void BOTC_RateShowAll () {
    int p;
    int i;
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    for (i = 0; i < 5; i += 1) {
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupAll(), false);
    }
    g_rateTeller = 0;                      // 面板没发出去就作废，避免给未出场的说书人评分
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (PlayerType(g_teller) != 1) {
        return;                            // 电脑说书人不接受评分
    }
    if (!BOTC_PlayerHere(g_teller)) {
        return;                            // 【说书人已退出】不给已离开的说书人发打分面板
    }
    g_rateTeller = g_teller;               // 记录本局被评分的说书人
    for (p = 2; p <= 13; p += 1) {
        if (p == g_teller) {
            continue;
        }
        if (PlayerType(p) != 1) {
            continue;
        }
        if (PlayerStatus(p) == 2) {
            continue;
        }
        libNtve_gf_SetDialogItemText(g_rateLbl, StringToText("为说书人打分："), PlayerGroupSingle(p));
        DialogControlSetSize(g_rateLbl, PlayerGroupSingle(p), 170, 30);
        for (i = 0; i < 5; i += 1) {
            DialogControlSetVisible(g_rateBtn[i], PlayerGroupSingle(p), true);
        }
        DialogSetVisible(g_rateDlg, PlayerGroupSingle(p), true);
    }
}

// 【说书人退出】（用户 2026-11-08）：结算阶段说书人一退出，立刻把全场打分面板收掉，
//   并作废本次评分（g_rateTeller = 0），防止接任的新说书人（或其他人）把分数记到别人账上。
void BOTC_RateCloseAll () {
    int i;
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    for (i = 0; i < 5; i += 1) {
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupAll(), false);
    }
    libNtve_gf_SetDialogItemText(g_rateLbl, StringToText("说书人已离开，本局评分取消。"), PlayerGroupAll());
    DialogControlSetSize(g_rateLbl, PlayerGroupAll(), 460, 30);
    g_rateTeller = 0;
}

void BOTC_RateSubmit (int p, int v) {
    bank bk;
    int rs;
    int rc;
    int rep;
    int i;
    if (!g_gameOver) {
        return;
    }
    if (p < 2 || p > 13 || p == g_teller || p == g_rateTeller) {
        return;
    }
    if (g_ratedP[p]) {
        return;
    }
    if (v < 1 || v > 5) {
        return;
    }
    if (g_teller < 1 || g_teller > 13 || PlayerType(g_teller) != 1) {
        return;
    }
    // 【说书人退出】（用户 2026-11-08）：本次评分只算给弹面板时的说书人；
    //   说书人中途退出后 g_rateTeller 已被清零，任何人再点都不能把分数记到接任者头上。
    if (g_rateTeller < 1 || g_rateTeller > 13) {
        return;
    }
    if (PlayerType(g_rateTeller) != 1 || !BOTC_PlayerHere(g_rateTeller)) {
        return;
    }
    if (PlayerType(p) != 1 || PlayerStatus(p) == 2) {
        return;
    }
    g_ratedP[p] = true;
    BOTC_BankEnsure(g_rateTeller);       // 【兜底补加载】说书人座位开局可能是空的
    bk = g_bank[g_rateTeller];
    rs = 0;
    rc = 0;
    if (BankKeyExists(bk, "stats", "rs")) {
        rs = BankValueGetAsInt(bk, "stats", "rs");
    }
    if (BankKeyExists(bk, "stats", "rc")) {
        rc = BankValueGetAsInt(bk, "stats", "rc");
    }
    BankValueSetFromInt(bk, "stats", "rs", rs + v);
    BankValueSetFromInt(bk, "stats", "rc", rc + 1);
    // 【声望值】（用户 2026-11-03）：按分数增减，最低 0。
    rep = BOTC_TellerRepGet(bk) + BOTC_RepDelta(v);
    if (rep < 0) {
        rep = 0;
    }
    BankValueSetFromInt(bk, "stats", "rep", rep);
    // 【积分】（用户 2026-11-06）：说书人按每名玩家打的分累计积分，1..5 星 +10/+15/+20/+25/+30；
    //   每名玩家本局只计一次（g_ratedP 已在上方拦截重复打分）。
    BOTC_StatsPointAdd(bk, BOTC_RatePointDelta(v));
    BankSave(bk);
    libNtve_gf_SetDialogItemText(g_rateLbl, StringToText("已评分：" + IntToString(v) + " 分，感谢反馈。"), PlayerGroupSingle(p));
    // 【评分文字被省略号截断】（用户 2026-11-05）：打分按钮收起后把标签放宽，保证整句显示完整
    DialogControlSetSize(g_rateLbl, PlayerGroupSingle(p), 460, 30);
    for (i = 0; i < 5; i += 1) {
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupSingle(p), false);
    }
}

// 胜利面板上面那条「恭喜...获胜」：单独一个对话框，放在胜利面板正上方
//   名字用每个玩家自己的颜色，字体跟「提名开始」那 4 个字一样大
void BOTC_BuildWinCongrats () {
    DialogCreate(1100, 76, c_anchorCenter, 150, -186, false);
    g_congratsDlg = DialogLastCreated();
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条也不要底图（对话框自带的默认面板图）
    DialogSetImageVisible(g_congratsDlg, false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条先不要黑底（想恢复就把下面两行放开）
    //   原来注释：给这条恭喜也铺一块黑底（跟胜利面板同款），不然文字直接压在草地上看不清
    // DialogSetImage(g_congratsDlg, "botc_black.dds");
    // DialogSetImageVisible(g_congratsDlg, true);
    g_congratsLbl = BOTC_NewLabelC(g_congratsDlg, 1080, 76, 10, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_congratsLbl, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_congratsLbl, false, PlayerGroupAll());
}

// 拼「恭喜 玩家1、玩家2 获胜」----赢的那一方（g_winSide：0 = 善良 / 1 = 邪恶）
//   每个名字用他自己的玩家颜色
text BOTC_CongratsText () {
    int i;
    int q;
    text t;
    bool first;
    t = StringToText("恭喜 ");
    first = true;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        // 【按阵营算，不按身份】（用户 2026-09-20）：默认镇民 / 外来 = 善良、爪牙 / 恶魔 = 邪恶，
        //   但身上打了「善良(14) / 邪恶(15)」token 的座位按那个 token 算（莽夫转阵营就靠这个）。
        if (BOTC_WinAlignOf(q) != g_winSide) {
            continue;
        }
        if (!first) {
            t = t + StringToText("、");
        }
        t = t + BOTC_PlayerNameText(q);
        first = false;
    }
    if (first) {
        return StringToText("本局结束");
    }
    return t + StringToText(" 获胜");
}

// 【特殊胜利】（无神论者在场 + 只剩 2 人活着）：说书人获胜；
//   中途转为邪恶阵营的玩家跟说书人一起获胜（用户 2026-11-12）
text BOTC_CongratsStText () {
    int i;
    int q;
    text t;
    t = StringToText("恭喜 ") + BOTC_PlayerNameText(1);
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_WinAlignOf(q) != 1) {
            continue;
        }
        t = t + StringToText(",") + BOTC_PlayerNameText(q);
    }
    return t + StringToText(" 获胜");
}

// 复盘：把说书人那份魔典（身份 + 全部 token）复制给每个玩家自己那份，并摊开给全场看
void BOTC_ReplayReveal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        ob = g_who[q];
        for (t = 2; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = g_mark[(g_teller * 14) + t];
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = g_tokOn[(((g_teller * 14) + t) * 256) + k];
            }
        }
    }
    g_replayOn = true;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    BOTC_GrimFlagAll(true);
    BOTC_PubAnnounce("【复盘】说书人把真实魔典（身份 + token）公开给全场。");
}

// 清空所有玩家各自魔典里的「缓存身份 + token」
//   （【取消正式开始】/【切换板子】时用）：玩家那一行整行清干净，连自己座位上的
//   身份标记也不留，避免上一把 / 上一张板子的角色和 token 带进下一把。
//   说书人那一行是真值，不能清；玩家要看自己的角色走【我的角色】页面。
void BOTC_GrimResetPerPlayer () {
    int ob;
    int t;
    int k;
    for (ob = 1; ob <= 13; ob += 1) {
        if (ob == g_teller) {
            continue;                          // 说书人那一行是真值，不能清
        }
        for (t = 0; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = 0;
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
    }
    g_replayOn = false;
    for (ob = 1; ob <= 13; ob += 1) {
        g_grimSnapOn[ob] = false;
        BOTC_GrimRender(ob);
    }
}

// 【取消正式开始 / 切换板子 · 全场清空】（用户 2026-11-06）：连说书人真值行一起清，
//   所有人魔典上的角色标记和 token 全部归零，回到「还没发牌」的干净状态。
//   ⚠ 只在取消正式开始 / 换板子时调用；发牌流程里不能用，否则会把刚配好的真值身份清掉。
void BOTC_GrimClearAllRows () {
    int ob;
    int t;
    int k;
    for (ob = 1; ob <= 13; ob += 1) {
        for (t = 0; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = 0;
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
    }
    g_replayOn = false;
    for (ob = 1; ob <= 13; ob += 1) {
        g_grimSnapOn[ob] = false;
        BOTC_GrimRender(ob);
    }
}

void BOTC_WinClose () {
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);   // 上面那条「恭喜...」一起收掉
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);       // 【说书人评分】打分框一起收掉
    g_gameOver = false;
    // ⚠ 这里**不**停胜利曲：面板收掉之后胜利 BGM 还要一直放着，
    //   直到说书人点【取消正式开始】（那一步会 BOTC_MusicStop）。
}

// 【重新开始】（用户 2026-11-01）：结算面板上原来那个【继续】改成【重新开始】，
//   点一下就把这一局清干净（等同【取消正式开始】）并回到剧本选择页面。
void BOTC_WinRestart () {
    // 【延后保存】重新开始前先把结算时攒下的场次 / 积分写完，避免玩家直接退出漏存。
    BOTC_StatsSaveFlush();
    BOTC_WinClose();
    // 【这时候才移除中途退出的座位】（用户 2026-11-03）：结算期间它们要留着给全场复盘，
    //   说书人点【重新开始】才统一从圆桌上拿掉；接着 BOTC_GameStartCancel() 的换局重置会再清一次表。
    BOTC_ClearLeftSeats();
    BOTC_GameStartCancel();        // 清掉上一局：天数 / token / 魔典 / 日志 / 音乐都回到准备阶段
    // 【重新开始后重新取名】（用户 2026-11-12）：回到选板页并显示战网名；
    //   选板后的 20 秒入场阶段会重新洗座位，再按新的 -名字 或随机名分配。
    g_dealConfirmed = false;       // 重新选剧本，旧的发牌作废
    BOTC_BoardOpen();              // 进入剧本选择页面
}

//==================================================================================================
// 传位面板：恶魔死了之后，说书人点一名活着的爪牙，让他变成新的小恶魔
//   （智能说书模式不弹这个面板，直接随机挑一名；面板是纯自定义界面，跟游戏自带结束按钮无关）
//==================================================================================================
void BOTC_BuildPromote () {
    int i;
    DialogCreate(378, 288, c_anchorRight, 338, -70, false);
    g_promDlg = DialogLastCreated();
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
    g_promTitle = BOTC_NewLabelC(g_promDlg, 360, 30, 9, 7, StringToText("恶魔死了：点一名爪牙接位"));
    libNtve_gf_SetDialogItemStyle(g_promTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_promTitle, false, PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        g_promBtn[i] = BOTC_NewButton(g_promDlg, 162, 31, 18 + ((i % 2) * 180), 41 + ((i / 2) * 34), "");
        DialogControlSetVisible(g_promBtn[i], PlayerGroupAll(), false);
        g_promSeat[i] = 0;
    }
    g_promClose = BOTC_NewButton(g_promDlg, 280, 31, 49, 248, "取消（我自己处理）");
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
}

void BOTC_PromoteOpen () {
    int i;
    int q;
    int n;
    if (g_gameOver || !g_started) {
        return;
    }
    for (i = 0; i < 12; i += 1) {
        DialogControlSetVisible(g_promBtn[i], PlayerGroupSingle(g_teller), false);
        g_promSeat[i] = 0;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!BOTC_SeatIsMinion(q)) {
            continue;
        }
        libNtve_gf_SetDialogItemText(g_promBtn[n], BOTC_PlayerNameText(q) + StringToText("（" + BOTC_SeatRoleStr(q) + "）"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_promBtn[n], PlayerGroupSingle(g_teller), true);
        g_promSeat[n] = q;
        n = n + 1;
        if (n >= 12) {
            break;
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "场上没有活着的爪牙，没人能接位。");
        return;
    }
    // 【换座位后的说书人也要有关闭键】（用户 2026-10-18）
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
    DialogControlSetVisible(g_promClose, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_promDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_PromoteHide () {
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
}

// 小恶魔自刀之后的传位：智能说书随机挑一名活着的爪牙；手动说书只解锁身份编辑，说书人自己点
// 小恶魔自刀之后的传位：返回 true = 有人接了位子（游戏继续，不算善良胜）
bool BOTC_ImpPromote () {
    int i;
    int q;
    int n;
    int pick;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                n = n + 1;
            }
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "小恶魔自刀死了，场上没有活着的爪牙，邪恶方没人可传。");
        BOTC_PmStore(g_teller, "【天亮】小恶魔自刀死了，场上没有活着的爪牙。");
        return false;         // 没人接位：交给调用方按胜负条件判（没有恶魔 → 善良胜）
    }
    // 手动说书：弹传位面板，说书人点一名爪牙接位（身份面板也顺手解锁，兜底用）
    g_promoteOpen = true;
    BOTC_PromoteOpen();
    BOTC_PmStore(g_teller, "【传位】等说书人传位。活着的爪牙：" + BOTC_MinionListStr());
    return true;              // 等说书人接位，这局先不算结束
}

//==================================================================================================
// 占卜师（Fortune Teller）：每晚选两名玩家，说书人回答「有 / 没有」恶魔
//   干扰项也算恶魔；间谍 / 陌客按各自的登记算；中毒 / 酒鬼的占卜师会收到相反答案（大概率）
//   信息统一由 1 号（智能说书）通过私聊发给本人
//==================================================================================================

// 占卜师点了座位：选满两个人就出结果
void BOTC_FtPick (int p, int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_ftPick[p]) {
        return;
    }
    if (g_ftFirst[p] == 0) {
        g_ftFirst[p] = q;
        BOTC_Notice(p, "已选 " + BOTC_NameStr(q) + "，再点第二位玩家。");
        return;
    }
    if (q == g_ftFirst[p]) {
        BOTC_Notice(p, "两个人不能是同一个，换一个。");
        return;
    }
    BOTC_FtAnswer(p, g_ftFirst[p], q);
    g_ftPick[p] = false;
    g_ftFirst[p] = 0;
}

//==================================================================================================
// 【酒鬼 / 中毒的占卜师专用】看不见的「假干扰项」
//   占卜师中毒 → 1 个假干扰项；占卜师是酒鬼 → 2 个（放在 2 个非恶魔玩家身上，其中一个也可能是爪牙）。
//   持有者大概率是「被动触发 / 大信息位」：按随机发牌同款镇民分类，
//   持续信息位（2）/ 死亡能力（4）/ 无主动能力（6）的镇民最合适，另外陌客也算；
//   极小概率落在一次性信息者（分类 1，含首夜信息位），其余角色是中概率。
//   占卜师验到假干扰项的持有者，一律报「有恶魔」，不吃那 70% 的看反概率。
//   只给智能说书判定用：没有界面、不占 g_tokOn；占卜师死了或者中毒解除就移除。
//==================================================================================================

// 这个身份当假干扰项「有多合适」（权重；<= 0 = 不给这个身份）
int BOTC_FtFakeWeight (int r) {
    if (r < 0 || r > 163) {
        return 0;
    }
    // 【改读随机发牌同款镇民分类】（用户 2026-11-06）：不再硬编码共情者 / 守鸦人 / 士兵 / 镇长。
    //   持续信息位 2 / 死亡能力 4 / 无主动能力 6 的镇民最适合当假干扰项。
    if (BOTC_RoleTeam(r) == 0 && (g_roleInfoClass[r] == 2 || g_roleInfoClass[r] == 4 || g_roleInfoClass[r] == 6)) {
        return 12;                     // 持续信息 / 死亡能力 / 无主动能力：最适合
    }
    if (r == 15) {
        return 12;                     // 陌客：外来者干扰身份
    }
    if (g_roleInfoClass[r] == 1) {
        return 1;                      // 一次性信息者（含首夜信息位）：极小概率
    }
    return 4;                          // 其他角色：中概率
}

// 在「可以当假干扰项」的座位里按权重抽一个
//   mode：0 = 只要善良 / 1 = 只要爪牙 / 2 = 善良或爪牙都行
//   allowChecked = false 时跳过占卜师已经验过的座位（免得他验过「没恶魔」之后又变成有恶魔）
int BOTC_FtFakePickSeat (int ft, int mode, bool allowChecked) {
    int i;
    int q;
    int r;
    int w;
    int wsum;
    int pick;
    pick = 0;
    wsum = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ft) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!allowChecked) {
            if (g_ftChkSeat[q]) {
                continue;
            }
        }
        if (BOTC_SeatTeam(q) == 3) {
            continue;                  // 恶魔永远不上这个假干扰项
        }
        if (q == g_herring) {
            continue;                  // 真干扰项那个座位不重复占
        }
        if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0) {
            continue;
        }
        if (mode == 0) {
            if (BOTC_RoleAlign(r) != 0) {
                continue;
            }
        }
        if (mode == 1) {
            if (BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        if (mode == 2) {
            if (BOTC_RoleAlign(r) != 0 && BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        w = BOTC_FtFakeWeight(g_mark[(g_teller * 14) + q] - 1);
        if (w <= 0) {
            continue;
        }
        wsum = wsum + w;
        if (RandomInt(1, wsum) <= w) {
            pick = q;
        }
    }
    return pick;
}

// 每次占卜师要验人之前调一次：把假干扰项同步到「当前该有的样子」----
//   占卜师清醒 / 已死 → 全部移除；酒鬼 → 2 个；中毒 → 1 个。状态没变就沿用，不重抽。
void BOTC_FtFakeSync () {
    int i;
    int q;
    int ft;
    int w;
    int mode;
    int pick;
    int n;
    string s;
    ft = 0;
    w = 0;
    if (w <= 0) {
        if (g_ftFakeOwner != 0) {
            BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项已移除（占卜师清醒 / 已死亡）。");
        }
        g_ftFakeSeat[0] = 0;
        g_ftFakeSeat[1] = 0;
        g_ftFakeOwner = 0;
        g_ftFakeWant = 0;
        return;
    }
    if (g_ftFakeOwner == ft && g_ftFakeWant == w) {
        // 状态没变：基本沿用已经打好的假干扰项，但有两种例外要处理 ----
        //   持有者「还没被验过就死了」→ 把 token 转给别的玩家（优先级 / 权重跟原来一样）；
        //   已经验过的持有者不动（信息已经发出去了，再换人就自相矛盾了）。
        for (i = 0; i < 2; i += 1) {
            q = g_ftFakeSeat[i];
            if (q < 2) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (g_ftChkSeat[q]) {
                continue;              // 已经验过：不转移
            }
            g_ftFakeSeat[i] = 0;       // 先空出来，免得抽到自己
            mode = 0;
            if (i == 1) {
                if (RandomInt(1, 100) <= 30) {
                    mode = 1;
                }
            }
            pick = BOTC_FtFakePickSeat(ft, mode, false);
            if (pick <= 0 && mode == 1) {
                pick = BOTC_FtFakePickSeat(ft, 0, false);
            }
            if (pick <= 0) {
                pick = BOTC_FtFakePickSeat(ft, 2, false);
            }
            if (pick <= 0) {
                // 实在没得挑（比如只剩验过的人）才允许放到验过的座位上
                pick = BOTC_FtFakePickSeat(ft, 2, true);
            }
            g_ftFakeSeat[i] = pick;
            if (pick >= 2) {
                BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项转移： " + BOTC_NameStr(q) + " 还没被验过就死了 → 转到 " + BOTC_NameStr(pick) + "。");
            }
        }
        return;
    }
    g_ftFakeOwner = ft;
    g_ftFakeWant = w;
    g_ftFakeSeat[0] = 0;
    g_ftFakeSeat[1] = 0;
    for (i = 0; i < w; i += 1) {
        mode = 0;                      // 默认给善良角色
        if (i == 1) {
            // 第 2 个假干扰项：小概率落在爪牙身上（酒鬼占卜师两个，其中一个可以是爪牙）
            if (RandomInt(1, 100) <= 30) {
                mode = 1;
            }
        }
        pick = BOTC_FtFakePickSeat(ft, mode, false);
        if (pick <= 0 && mode == 1) {
            pick = BOTC_FtFakePickSeat(ft, 0, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, true);
        }
        g_ftFakeSeat[i] = pick;
    }
    // 【诊断】写清楚打给了谁（不占 token、玩家看不到）
    s = "【诊断占卜师】假干扰项（他是" + BOTC_DiagStateStr(ft) + "）：";
    n = 0;
    for (i = 0; i < 2; i += 1) {
        if (g_ftFakeSeat[i] >= 2) {
            if (n > 0) {
                s = s + "、";
            }
            s = s + BOTC_NameStr(g_ftFakeSeat[i]);
            n = n + 1;
        }
    }
    if (n <= 0) {
        s = s + "没找到合适的人";
    }
    BOTC_PmStore(g_teller, s + " ---- 验到他们会报「有恶魔」");
}

// 给出答案：有 / 没有 恶魔（信息只给本人）
void BOTC_FtAnswer (int ob, int a, int b) {
    bool demon;
    bool realDemon;
    bool lie;
    // 先记下「这两个座位已经被验过了」再同步：这样正在验的这个座位不会被当成
    //   「没验过就死了」而把假干扰项转走（他这一验就是验它）。
    if (a >= 2 && a <= 13) {
        g_ftChkSeat[a] = true;
    }
    if (b >= 2 && b <= 13) {
        g_ftChkSeat[b] = true;
    }
    BOTC_FtFakeSync();                 // 再按当前状态把「假干扰项」同步好（酒鬼 2 个 / 中毒 1 个 / 清醒清掉；
                                       // 持有者没被验过就死了会在这里转给别人）
    // 真值：按「登记」那一层算（干扰项也算恶魔）
    realDemon = false;
    if (a == g_herring || b == g_herring) {
        realDemon = true;
    }
    if (BOTC_RegAsDemon(ob, a) || BOTC_RegAsDemon(ob, b)) {
        realDemon = true;
    }
    // 他实际被告知的答案：清醒 = 真值；中毒 / 酒鬼 = 他自己那一层（一个座位只判一次）
    demon = false;
    if (BOTC_RegistersAsDemonToFT(ob, a)) {
        demon = true;
    }
    if (BOTC_RegistersAsDemonToFT(ob, b)) {
        demon = true;
    }
    lie = (demon != realDemon);
    // 【真人说书 · 信息位答题框】（用户 2026-09-20）：弹一个填数字的小窗给说书人，填完自动发给占卜师本人。
    //   要不要骗他（酒鬼 / 中毒）由你在框里填什么数字决定。
    BOTC_ManInfoOpen(BOTC_PosOf(ob), 5, BOTC_NameStr(a) + " / " + BOTC_NameStr(b));
    BOTC_PmStore(g_teller, BOTC_NameStr(BOTC_PosOf(ob)) + " 选择了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b));
    if (BOTC_SeatImpaired(BOTC_PosOf(ob))) {
        // 中毒 / 酒鬼：单独一行写清楚（报的什么 / 真值 / 两个座位各自是不是干扰项）
        BOTC_DiagFtLine(BOTC_PosOf(ob), a, b, demon, realDemon);
    }
    else {
        BOTC_DiagSeatLine("占卜师", BOTC_PosOf(ob), lie, a, b);
    }
}

// 给一个「不一样的身份」（中毒 / 酒鬼说假话时用；只在 0..16 的善良身份里挑，免得答案太离谱）
int BOTC_WrongRole (int r) {
    int k;
    int i;
    for (i = 0; i < 40; i += 1) {
        k = RandomInt(0, 16);
        if (k != r) {
            return k;
        }
    }
    if (r == 0) {
        return 1;
    }
    return 0;
}

//==================================================================================================
// 【守鸦人（索引 8）的自动发信息已删除】（用户 2026-10-05 要求「都删了」）
//   原 `BOTC_RkAnswer()` 会算一次「查到的身份」（走登记层 / 中毒看错层）然后：
//     · 智能说书模式 → 私聊发给守鸦人本人；
//     · 手动说书模式 → 写进说书人私聊日志（连同一行诊断）。
//   现在原型 / 定义 / 调用三处全部删除：守鸦人夜里被唤醒、选完人、按【确认】，
//   **不再自动发任何信息**，答案由说书人自己看魔典处理。
//==================================================================================================

// 智能说书：给每个邪恶座位自动分配一个「不在场的好身份」当伪装口供
// （以后送葬者/调查员这类被中毒的人来查他，给的就是这份口供，不会露馅）
// 【伪装】不再由 AI 说书人自动安排：给每个邪恶玩家一句提示，让他自己挑自称的身份
//   （正式开局后右上角会长出【伪装身份】按钮；手动说书也走同一句提示）
void BOTC_ClaimHint () {
    // 【伪装】那条私聊提示删掉了（用户要求）---- 邪恶玩家自己看右上角的【伪装身份】按钮就行。
    //   函数保留成空壳，调用点（随机发牌 / 智能说书开局）不用动；以后想恢复提示在这里加回来即可。
}


//==================================================================================================
// 板子（剧本）系统
//   开局先黑屏选板子：手动说书由说书人点选；玩家1是电脑时改成玩家投票、票高者采用
//   黑屏：星际的对话图片按原尺寸画（不拉伸），所以用 256x216 的黑块拼满 1920x1080
//   渐变：用 4 档不同透明度的黑图（botc_black64/128/192 + botc_black）逐帧切换
//==================================================================================================
int BOTC_BoardCount () {
    return 14;  // 【板子张数】（不含板子 7 自定义剧本）：14 = 移花接木
}

string BOTC_BoardName (int b) {
    if (b == 1) {
        return "暗流涌动";
    }
    if (b == 2) {
        return "黯月初升";
    }
    if (b == 3) {
        return "梦殒春宵";
    }
    if (b == 4) {
        return "瓦釜雷鸣";
    }
    if (b == 5) {
        return "夜半狂欢";
    }
    if (b == 6) {
        return "罂粟花开";
    }
    if (b == 7) {
        return "自定义剧本";         // 玩家自己拼的（用户 2026-10-03）
    }
    if (b == 8) {
        return "横行霸道";
    }
    if (b == 9) {
        return "何方教众";          // 用户 2026-10-10：Whose Cult Is It Anyway
    }
    if (b == 10) {
        return "风雅集";           // 用户 2026-10-16：玩家自制剧本（剧本作者 苏通染；华灯初上 + 实验性角色）
    }
    if (b == 11) {
        return "心理博弈 XI";
    }
    if (b == 12) {
        return "信口雌黄";
    }
    if (b == 13) {
        return "全员追忆";
    }
    if (b == 14) {
        return "成双成对";
    }
    if (b == 15) {
        return "移花接木";
    }
    return "未定";                 // ⚠ 兜底 return 必须是这个非 void 函数的**最后一句**，新板子往上面加
}

// 【剧本难度】（用户 2026-11-06）：玩家难度 / 说书人难度，1..5 星；0 = 不显示（自定义剧本）
