// 每条摆到 (col,row)：图标按钮 + 名字 + 能力（位置/大小 = 旧版排版，一模一样）
void BOTC_AbNewEntry (int p, int slot, int r, int x, int y, int w) {
    int idx;
    idx = (p * 26) + slot;
    g_abNewRole[idx] = r;
    DialogControlSetPosition(g_abNewHit[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_abNewIcon[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    libNtve_gf_SetDialogItemImage(g_abNewIcon[idx], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_abNewName[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 4);
    DialogControlSetPosition(g_abNewAb[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 34);
    // 【条目宽度 w】（用户 2026-10-04）：爪牙 / 恶魔 那两段改成**三列**，文字框必须跟着变窄，
    //   否则会压到右边那一列的图标上。镇民 / 外来者 / 传奇仍然用 460（两列）。
    DialogControlSetSize(g_abNewName[idx], PlayerGroupSingle(p), w, 26);
    DialogControlSetSize(g_abNewAb[idx], PlayerGroupSingle(p), w, 78);
    libNtve_gf_SetDialogItemText(g_abNewName[idx], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abNewAb[idx], BOTC_KeyColor(g_tipAbility[r]), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abNewHit[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewIcon[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewName[idx], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abNewAb[idx], PlayerGroupSingle(p), true);
}

void BOTC_AbCatCtrlRender (int p, int t) {
    int cap;
    int page;
    int pages;
    int y;
    if (p < 1 || p > 13 || t < 0 || t > 3) {
        return;
    }
    cap = BOTC_AbCatCap(t);
    pages = BOTC_GridCatPages(t, cap);
    page = g_abCatPage[(p * 4) + t];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    g_abCatPage[(p * 4) + t] = page;
    if (pages <= 1) {
        DialogControlSetVisible(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), false);
        return;
    }
    // 镇民有两列，底部最后一行结束于 y=822；翻页按钮放到它右下方的空行。
    y = 834;
    if (t == 1) { y = 46; }
    if (t == 2) { y = 416; }
    if (t == 3) { y = 686; }
    DialogControlSetPosition(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), c_anchorTopLeft, 865, y);
    DialogControlSetPosition(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), c_anchorTopLeft, 909, y);
    libNtve_gf_SetDialogItemText(g_abCatPrev[(p * 4) + t], StringToText("<"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_abCatNext[(p * 4) + t], StringToText(">"), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abCatPrev[(p * 4) + t], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abCatNext[(p * 4) + t], PlayerGroupSingle(p), true);
}

//==================================================================================================
// 【角色能力表 · 第 3 页：名词解释】（用户 2026-09-20）
//   每个词条带 1~3 个关键词；只要**当前板子里有角色带这个关键词**（g_roleKey），就显示这一条。
//   所以换板子会自动跟着变：没有「可能」类角色的板子就不会出现「可能」这条。
//==================================================================================================
void BOTC_InitGloss () {
    int i;
    for (i = 0; i < 164; i += 1) {
        g_roleKey[i] = "";
    }
    // ---- 每个角色身上带的关键词（多个用 | 隔开）----
    g_roleKey[0] = "首个夜晚";      g_roleKey[1] = "首个夜晚";      g_roleKey[2] = "首个夜晚";
    g_roleKey[3] = "首个夜晚";      g_roleKey[9] = "失去能力";
    g_roleKey[6] = "每个夜晚*";     g_roleKey[7] = "每个夜晚*";     g_roleKey[21] = "每个夜晚*";
    g_roleKey[10] = "每局限一次|失去能力";
    g_roleKey[12] = "可能";         g_roleKey[14] = "中毒|醉酒";
    g_roleKey[17] = "中毒";         g_roleKey[22] = "首个夜晚";
    g_roleKey[23] = "醉酒|可能";    g_roleKey[26] = "醉酒|可能";
    g_roleKey[28] = "可能";         g_roleKey[29] = "每局限一次|醉酒|失去能力";
    g_roleKey[30] = "每局限一次|复活|起死回生|失去能力";
    g_roleKey[31] = "醉酒";         g_roleKey[33] = "可能";
    g_roleKey[34] = "失去能力";     g_roleKey[35] = "可能";
    g_roleKey[37] = "醉酒";         g_roleKey[39] = "首个夜晚";
    g_roleKey[41] = "每局限一次|失去能力";
    g_roleKey[43] = "起死回生";     g_roleKey[44] = "中毒";
    g_roleKey[45] = "复活|反刍";
    // ---- 梦殒春宵（板子 3）----
    g_roleKey[47] = "首个夜晚";      g_roleKey[48] = "每个夜晚";
    g_roleKey[49] = "每个夜晚";      g_roleKey[50] = "每个夜晚*|首个夜晚";
    g_roleKey[51] = "每个夜晚*";     g_roleKey[52] = "每个夜晚*";
    g_roleKey[53] = "每个夜晚*";     g_roleKey[55] = "每局限一次|每个夜晚";
    g_roleKey[56] = "每局限一次|首个夜晚";  g_roleKey[57] = "每局限一次";
    g_roleKey[58] = "每个夜晚*";     g_roleKey[59] = "每个夜晚*";
