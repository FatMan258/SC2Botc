    g_organNo = BOTC_NewButton(g_organDlg, 220, 52, 295, 85, "否");
    DialogControlSetVisible(g_organYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organNo, PlayerGroupAll(), false);

    // 炼金术士声称第一步：先明确要猜间谍还是寡妇。
    DialogCreate(560, 180, c_anchorRight, 320, -70, false);
    g_alcDlg = DialogLastCreated();
