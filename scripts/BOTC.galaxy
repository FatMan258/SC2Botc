// BOTC_NameSubst 的 text 版本（原来那个只吃 string，这里给系统提示拼色用）
text BOTC_NameSubstText (text t) {
    int p;
    int q;
    int seat;
    string h;
    // 【两段式替换】（用户 2026-10-06 报「玩家10 以上名字串位」）：
    //   单段式替换时，**换进去的真名里可能又含「玩家N」**（电脑的名字就叫"玩家10"），
    //   后面的短编号（玩家1）就会把它再替一次 → 剩下个尾巴 `0`（就是那个 `[9] [1] 玩家2` + `0`）。
    //   所以先全部换成不会互相匹配的标记 `@@N@@`，第二段再把标记换成真名 —— 谁也不会被替第二遍。
    // 【第一段：把「玩家N」换成按**位置**编号的标记 @@位置@@】（用户 2026-10-07 重写）：
    //   写侧现在写的是 `BOTC_NameStr(位置)` = "玩家" + g_lab[位置]（= 编号）；这里按位置 p 循环，
    //   两种写法都收（"玩家p" = 有人按位置写、也兼容旧文本；"玩家p-1" = 有人按编号写），
    //   统一变成 @@p@@ —— 第二段直接拿 p 当**位置**用，不再查 g_lab。
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p - 1)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("说书人："), StringToText("@@0@@"), c_stringReplaceAll, true);
    // 【第二段：@@位置@@ → 那个格子现在坐的人】（用户 2026-10-07）：写侧和第一段都用**位置**，
    //   所以这里直接用 p，不需要再拿 g_lab 反查（旧代码那一步会把位置又当成编号、错开一位）。
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("@@" + IntToString(p) + "@@"), BOTC_PlayerNameText(p), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("@@0@@"), BOTC_PlayerNameText(1) + StringToText("："), c_stringReplaceAll, true);
    // 【说话人标记 → 那个人现在的显示】（用户 2026-10-07）：按"人"查他现在坐哪一格
    for (p = 1; p <= 13; p += 1) {
        t = TextReplaceWord(t, StringToText(BOTC_SayToken(p)), BOTC_PlayerNameText(BOTC_PosOf(p)), c_stringReplaceAll, true);
    }
    for (p = 1; p <= 13; p += 1) {
        h = PlayerHandle(p);
        if (StringLength(h) <= 0) {
            h = TextToString(PlayerName(p));
        }
        if (StringLength(h) <= 0) {
            h = "座位" + IntToString(p);
        }
        t = TextReplaceWord(t, StringToText(BOTC_HandleToken(p)), TextWithColor(StringToText(h), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("@@HL" + IntToString(p) + "@@"), TextWithColor(StringToText("本地玩家"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("@@HN" + IntToString(p) + "@@"), TextWithColor(StringToText(h), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
    }
    return t;
}

// 【日志专用】：说书人看到的其他玩家写成「[编号] 显示名（真实战网ID）」。
text BOTC_LogPlayerNameText (int p) {
    string shown;
    string battle;
    text base;
    if (p < 1 || p > 13) {
        return StringToText("");
    }
    base = BOTC_PlayerNameText(p);
    if (p == 1 || g_who[p] == g_teller) {
        return base;
    }
    shown = BOTC_ChatNoColor(TextToString(BOTC_SeatNameText(p)));
    battle = TextToString(PlayerName(g_who[p]));
    if (StringLength(battle) <= 0 || shown == battle) {
        return base;
    }
    return base + StringToText("（") + TextWithColor(StringToText(battle), Color(225, 225, 225)) + StringToText("）");
}

// 【提示条说话人】（用户 2026-11-13）：名字自带颜色标签时不再套一层座位色，
//   避免嵌套标签把后面的聊天正文染色；普通名字仍按说话人颜色显示。
text BOTC_SpeakerNameText (int p) {
    text t;
    if (p < 1 || p > 13) {
        return StringToText("");
    }
    t = BOTC_PlayerDisplayName(p);
    if (StringFind(TextToString(t), "<c", false) >= 0) {
        return t;
    }
    return TextWithColor(t, BOTC_SayColor(p));
}

// 与 BOTC_NameSubstText 相同的占位符替换，但玩家名走日志专用格式。
text BOTC_LogNameSubstText (text t) {
    int p;
    int q;
    int seat;
    string h;
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("玩家" + IntToString(p - 1)), StringToText("@@" + IntToString(p) + "@@"), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("说书人："), StringToText("@@0@@"), c_stringReplaceAll, true);
    for (p = 13; p >= 2; p -= 1) {
        t = TextReplaceWord(t, StringToText("@@" + IntToString(p) + "@@"), BOTC_LogPlayerNameText(p), c_stringReplaceAll, true);
    }
    t = TextReplaceWord(t, StringToText("@@0@@"), BOTC_LogPlayerNameText(1) + StringToText("："), c_stringReplaceAll, true);
    for (p = 1; p <= 13; p += 1) {
        t = TextReplaceWord(t, StringToText(BOTC_SayToken(p)), BOTC_LogPlayerNameText(BOTC_PosOf(p)), c_stringReplaceAll, true);
    }
    for (p = 1; p <= 13; p += 1) {
        h = PlayerHandle(p);
        if (StringLength(h) <= 0) {
            h = TextToString(PlayerName(p));
        }
        if (StringLength(h) <= 0) {
            h = "座位" + IntToString(p);
        }
        t = TextReplaceWord(t, StringToText(BOTC_HandleToken(p)), TextWithColor(StringToText(h), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("@@HL" + IntToString(p) + "@@"), TextWithColor(StringToText("本地玩家"), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
        t = TextReplaceWord(t, StringToText("@@HN" + IntToString(p) + "@@"), TextWithColor(StringToText(h), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false))), c_stringReplaceAll, true);
    }
    return t;
}

text BOTC_LogLineText (int viewer, string line, int who) {
    text t;
    t = StringToText(line);
    if (who == 0) {
        t = BOTC_KeyColor(t);
    }
    if (viewer == g_teller) {
        t = BOTC_LogNameSubstText(t);
    }
    else {
        t = BOTC_NameSubstText(t);
    }
    if (who <= 0) {
        t = TextWithColor(t, Color(189, 183, 107));
    }
    return t;
}

// 聊天窗 / 私聊窗 / 日志页渲染时统一走它。
//   用户 2026-09-19：**系统提示**（who == 0，不是玩家发的）整行刷成 BDB76B，
//   关键词（镇民 / 外来者 / 爪牙 / 恶魔 / 中毒 / 善良 / 邪恶 + 22 个角色名）和玩家名是「内层」，
//   保留各自的颜色；玩家自己发的行（who != 0）完全不动。
//   ⚠ 顺序很关键：整行刷色必须放在**所有 TextReplaceWord 之后** ----
//     先刷色再替换的话，整词替换会把外层颜色重建掉（实测整行会变回白色）。
text BOTC_LineText (string line, int who) {
    text t;
    t = StringToText(line);
    // who == -1：系统行但整行已预着色（BOTC_PubAnnouncePlain），跳过关键词自动上色，
    //   避免玩家战网名里的「邪恶」「善良」等字被染成阵营色。
    if (who == 0) {
        t = BOTC_KeyColor(t);                          // 1) 关键词先上色
    }
    t = BOTC_NameSubstText(t);                         // 2) 「玩家N」「说书人：」换彩色名字
    if (who <= 0) {
        t = TextWithColor(t, Color(189, 183, 107));    // 3) 最后整行刷 BDB76B（内层颜色保留）
    }
    return t;
}

// 身份图标文件名（打包在依赖的 Mod 里）
string BOTC_IconName (int idx) {
    if (idx == 148) {
        return "botc_role148.dds";
    }
    if (idx == 149) {
        return "botc_role149.dds";
    }
    if (idx == 150) {
        return "botc_role150.dds";
    }
    if (idx == 151) {
        return "botc_role151.dds";
    }
    if (idx == 152) {
        return "botc_role152.dds";
    }
    if (idx == 153) {
        return "botc_role153.dds";
