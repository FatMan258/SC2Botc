// 角色能力表：居中大面板，分两页
//--------------------------------------------------------------------------------------------------
void BOTC_AbilityRender (int p) {
    if (g_abPage[p] <= 1) {
        // 第 1 页：善良阵营镇民（贴图 1111 x 706）
        DialogControlSetSize(g_abImg, PlayerGroupSingle(p), 1111, 706);
        DialogControlSetPosition(g_abImg, PlayerGroupSingle(p), c_anchorTopLeft, 34, 42);
        libNtve_gf_SetDialogItemImage(g_abImg, "botc_ability1.dds", PlayerGroupSingle(p));
    }
    else {
        // 第 2 页：外来者 / 爪牙 / 恶魔 / 备注（贴图 1111 x 794）
        DialogControlSetSize(g_abImg, PlayerGroupSingle(p), 1111, 794);
        DialogControlSetPosition(g_abImg, PlayerGroupSingle(p), c_anchorTopLeft, 34, 42);
        libNtve_gf_SetDialogItemImage(g_abImg, "botc_ability2.dds", PlayerGroupSingle(p));
    }
    libNtve_gf_SetDialogItemText(g_abTitle, StringToText("角色能力表  " + IntToString(g_abPage[p]) + " / 2"), PlayerGroupSingle(p));
}

void BOTC_AbilityOpen (int p) {
    int ox;
    int oy;
    BOTC_GridPlan();               // 按当前板子的角色算一遍网格
    BOTC_AbNewRender(p);
    g_abOpen[p] = true;
    g_noOpen[p] = false;
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), false);   // 切回剧本角色视图时收掉夜序视图
    // 回到上次拖动的位置（0,0 = 屏幕正中心；局内记忆、退出地图后重置）
    ox = g_abOffX[p];
    oy = g_abOffY[p];
    if (ox < -370) { ox = -370; }
    if (ox > 370) { ox = 370; }
    if (oy < -30) { oy = -30; }
    if (oy > 30) { oy = 30; }
    DialogSetPosition(g_abNewDlg[p], c_anchorCenter, ox, oy);
    DialogSetPosition(g_noDlg[p], c_anchorCenter, ox, oy);   // 夜序视图同一窗口，位置保持一致
    // 【剧本角色表与魔典共存】（用户 2026-11-04）：打开角色表不再收起魔典
    DialogSetVisible(g_abNewDlg[p], PlayerGroupSingle(p), true);
}

// ---- 夜间顺序表 ----
//   内容全部读 g_nightOrderFirst / g_nightOrder + 当前板子的角色清单（g_boardRole），
//   面板代码里不出现任何角色名字 ---- 换板子只改数据
// ---- 角色提示面板（右下角）----
//   顶部：你的角色是 + 85 小图 + 角色名（没发牌就只留「你的角色是」）
//   下面：可滚动列表 ---- 能力 / 简介 / 规则细节 / 我该做什么 / 通用提示
void BOTC_BuildTip () {
    DialogCreate(1010, 620, c_anchorTopRight, 10, 232, false);
    g_tipDlg = DialogLastCreated();
    DialogSetVisible(g_tipDlg, PlayerGroupAll(), false);
    g_tipTitleLbl = BOTC_NewLabel(g_tipDlg, 220, 26, 10, 8, StringToText("你的角色是"));
    libNtve_gf_SetDialogItemStyle(g_tipTitleLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_tipTitleLbl, false, PlayerGroupAll());
    libNtve_gf_CreateDialogItemImage(g_tipDlg, 85, 85, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_tipIcon = DialogControlLastCreated();
    DialogControlSetSize(g_tipIcon, PlayerGroupAll(), 85, 85);
    DialogControlSetPosition(g_tipIcon, PlayerGroupAll(), c_anchorTopLeft, 10, 40);
    libNtve_gf_SetDialogItemAcceptMouse(g_tipIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_tipIcon, "botc_blank.dds", PlayerGroupAll());
    DialogControlSetVisible(g_tipIcon, PlayerGroupAll(), false);
    g_tipName = BOTC_NewLabel(g_tipDlg, 340, 30, 105, 66, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_tipName, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_tipName, false, PlayerGroupAll());
    g_tipList = BOTC_NewList(g_tipDlg, 990, 430, 10, 134);
    libNtve_gf_SetDialogItemStyle(g_tipList, "ModLeftSize16Bold", PlayerGroupAll());
    g_tipClose = BOTC_NewButton(g_tipDlg, 160, 36, 840, 574, "关闭");
    g_tipBack = BOTC_NewButton(g_tipDlg, 200, 36, 10, 574, "我的角色");   // 从左往右：我的角色 → 游戏帮助 → 场次统计 → 关闭（用户 2026-11-04）
    g_tipBtnRules = BOTC_NewButton(g_tipDlg, 180, 36, 220, 574, "游戏帮助");
    g_tipBtnStats = BOTC_NewButton(g_tipDlg, 180, 36, 410, 574, "场次统计");
    g_tipBtnWiki = BOTC_NewButton(g_tipDlg, 200, 36, 600, 574, "规则百科");
}

//--------------------------------------------------------------------------------------------------
// 【规则百科】（用户 2026-11-06）：钟楼 wiki 的十个规则页面，随时打开查阅
//   正文数据在 BOTC_WikiInit()（文件末尾，由 work/gen_wiki.py 生成），这里只负责界面。
//--------------------------------------------------------------------------------------------------
string BOTC_WikiName (int k) {
    if (k == 0) { return "规则概要"; }
    if (k == 1) { return "重要细节"; }
    if (k == 2) { return "术语汇总"; }
    if (k == 3) { return "给说书人的建议"; }
    if (k == 4) { return "规则解释"; }
    if (k == 5) { return "相克规则"; }
    if (k == 6) { return "可以但不建议"; }
    if (k == 7) { return "夜晚行动顺序一览"; }
    if (k == 8) { return "隐性规则"; }
    if (k == 9) { return "规则调整提前公示"; }
    return "";
}

void BOTC_BuildWiki () {
    int i;
    DialogCreate(1180, 900, c_anchorCenter, 0, 0, false);
    g_wikiDlg = DialogLastCreated();
    DialogSetVisible(g_wikiDlg, PlayerGroupAll(), false);
    g_wikiTitle = BOTC_NewLabel(g_wikiDlg, 860, 34, 292, 12, StringToText("规则百科"));
    libNtve_gf_SetDialogItemStyle(g_wikiTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_wikiTitle, false, PlayerGroupAll());
    g_wikiList = BOTC_NewList(g_wikiDlg, 876, 770, 292, 56);
    libNtve_gf_SetDialogItemStyle(g_wikiList, "ModLeftSize16Bold", PlayerGroupAll());
    for (i = 0; i < 10; i += 1) {
        g_wikiCatBtn[i] = BOTC_NewButton(g_wikiDlg, 262, 58, 16, 56 + (i * 70), BOTC_WikiName(i));
        libNtve_gf_SetDialogItemStyle(g_wikiCatBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
    }
    g_wikiClose = BOTC_NewButton(g_wikiDlg, 160, 36, 1008, 848, "关闭");
    libNtve_gf_SetDialogItemStyle(g_wikiClose, "ModLeftSize16Bold", PlayerGroupAll());
    g_wikiArtBtn = BOTC_NewButton(g_wikiDlg, 200, 36, 16, 848, "拓展阅读");
    libNtve_gf_SetDialogItemStyle(g_wikiArtBtn, "ModLeftSize16Bold", PlayerGroupAll());
}

void BOTC_WikiRender (int p) {
    int i;
    int k;
    k = g_wikiSel[p];
    if (k < 0 || k > 9) {
        k = 0;
        g_wikiSel[p] = 0;
    }
    libNtve_gf_SetDialogItemText(g_wikiTitle, StringToText("规则百科 · " + BOTC_WikiName(k)), PlayerGroupSingle(p));
    DialogControlRemoveAllItems(g_wikiList, PlayerGroupSingle(p));
    for (i = 0; i < g_wikiN[k]; i += 1) {
        DialogControlAddItem(g_wikiList, PlayerGroupSingle(p), BOTC_KeyColor(g_wikiLine[g_wikiAt[k] + i]));
    }
    for (i = 0; i < 10; i += 1) {
        if (i == k) {
            libNtve_gf_SetDialogItemText(g_wikiCatBtn[i], StringToText("● " + BOTC_WikiName(i)), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_wikiCatBtn[i], StringToText(BOTC_WikiName(i)), PlayerGroupSingle(p));
        }
    }
}

void BOTC_WikiOpen (int p) {
    g_wikiOpen[p] = true;
    BOTC_WikiRender(p);
    DialogSetVisible(g_wikiDlg, PlayerGroupSingle(p), true);
}

