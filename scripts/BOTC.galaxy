// 拓展阅读文本数据（由 work/gen_wiki_articles.py 从钟楼百科整理生成）
//   仅内嵌数据，暂未接入界面；后续界面通过 BOTC_ArtCount / BOTC_ArtName /
//   BOTC_ArtAt / BOTC_ArtN / BOTC_ArtLine 读取。
void BOTC_ArtInit () {
    // 0 “规则”与“理念”——关于角色能力互动的说明（8 段 / 55 行）
    g_artAt[0] = 0;
    g_artN[0] = 55;
    g_artLine[0] = StringToText("在《染·钟楼谜团》的中文正版发货之后，或许有很多玩家会逐渐开始发现，");
    g_artLine[1] = StringToText("《染》这款游戏的规则有的时候看起来会有些含糊不清，甚至无法用简单的规则解释一些较为复杂的角色");
    g_artLine[2] = StringToText("互动。这也会导致出现「看似国内外规则不够统一」的情况，甚至我们也从Steven那儿收到了诸如");
    g_artLine[3] = StringToText("「官方中文擅自定下与国外不同的规则」、「说书人培训中出现了较多的谬误」等国内玩家的反馈（虽然");
    g_artLine[4] = StringToText("事实并非如此，但这些反馈仍然导致在沟通上产生了一些误解）。这是因为有一部分通过民间翻译先行接");
    g_artLine[5] = StringToText("触到游戏的玩家已经开始熟悉这款游戏，并且对游戏产生了自己的一部分理解所导致的。");
    g_artLine[6] = StringToText("想调和这样的矛盾其实是一个较为长远的过程。《染》从一开始就不是作为一款竞技游戏而去设计的，");
    g_artLine[7] = StringToText("Steven在设计它的时候更多的是想要让玩家享受这款游戏的乐趣，游戏过程中的体验相比规则来说");
    g_artLine[8] = StringToText("更为重要。比如说，从设计方面来讲，爪牙角色的能力就应该是能对善良玩家产生不良的影响，");
    g_artLine[9] = StringToText("而外来者也是如此。那么如果理解了游戏的设计理念，说书人应该不难判断在麻脸巫婆创造一名角色时，");
    g_artLine[10] = StringToText("不应该让陌客或者间谍被当作那种角色从而导致麻脸巫婆的能力未能成功创造出对应的角色，");
    g_artLine[11] = StringToText("因为从设计层面上来讲，麻脸巫婆的能力不应该在这种情况下受到妨碍。而如果只讲究规则，");
    g_artLine[12] = StringToText("那么的确陌客和间谍可以被当作对应的角色，但你仍然需要注意，因为这两个角色的能力里提及了「可能");
    g_artLine[13] = StringToText("」一词，这意味着这件事情仍然是由说书人来做出决定的。即使你认为麻脸巫婆这名玩家的这一步操作不");
    g_artLine[14] = StringToText("应该这么做想要通过这种方法阻止他，那么为什么不让他的能力生效，从而自己认识到这样的结果呢？");
    g_artLine[15] = StringToText("又或许，玩家有自己的想法，而这一想法在说书人视角下是完全看不到的。无论如何，");
    g_artLine[16] = StringToText("作为说书人的你不应该是限制玩家乐趣的枷锁，给与玩家更多的可能性，才会在游戏中碰撞出更多的火花");
    g_artLine[17] = StringToText("和乐趣。");
    g_artLine[18] = StringToText("同样的，陌客在绝大部分情况下不应该被当作爪牙并在小恶魔自杀时变成新的小恶魔。");
    g_artLine[19] = StringToText("然而在某些混合剧本中，如果一名陌客玩家在一开始就是邪恶阵营的（他要么可能是邪恶的爪牙变成了陌");
    g_artLine[20] = StringToText("客，要么是由于灵言师的效果一开始就变为邪恶了，诸如此类），那么当邪恶的小恶魔自杀时，");
    g_artLine[21] = StringToText("你完全可以将陌客当作爪牙角色来让他变成新的小恶魔。他是邪恶一方，他完全有理由成为那个新的大坏");
    g_artLine[22] = StringToText("蛋。");
    g_artLine[23] = StringToText("然而，为什么钟楼百科在绝大多数情况下，都会更加注重规则本身上的东西，");
    g_artLine[24] = StringToText("而非谈及设计理念或者说书理念呢？因为玩家需要引导。任何说书人都是从生疏到熟练的过程中慢慢进步");
    g_artLine[25] = StringToText("的。如果在一名说书人连游戏最基础的底层逻辑都无法弄清楚的情况下，先塞给他一大堆理念相关的东西，");
    g_artLine[26] = StringToText("这样好么？这可能会让他觉得《染》是一款随心所欲的游戏，说书人就是游戏的最高法则。");
    g_artLine[27] = StringToText("他会不清楚规则与规则之间的界限，甚至肆意去打破它，去给玩家创造毁灭性的糟糕体验。");
    g_artLine[28] = StringToText("因此玩家需要一个可以查看规则的地方，这个地方需要确保能够将正确的规则呈现给玩家。");
    g_artLine[29] = StringToText("然而规则是没有情感的，在消化规则的同时，也希望各位玩家更多的是加入自己的思考。");
    g_artLine[30] = StringToText("调查员的能力是得知两名玩家和一个爪牙角色，他的提示标记要在为首夜做准备的时候就放置。");
    g_artLine[31] = StringToText("然而如果你将陌客作为那个爪牙角色放置了提示标记，但投毒者在首个夜晚选择对陌客使用自己的角色能");
    g_artLine[32] = StringToText("力时，陌客就无法再被当作爪牙角色了。说书人不应该欺骗清醒健康的玩家，因此在唤醒调查员之前，");
    g_artLine[33] = StringToText("说书人理应按照规则重新放置提示标记。角色与角色之间的互动会随着角色的增加逐渐变得复杂，");
    g_artLine[34] = StringToText("钟楼百科也无法确保在第一时间能将这些全部的角色互动一一罗列出来供大家参考，");
    g_artLine[35] = StringToText("因此说书人也应当在学习规则时加以思考，而非对钟楼百科罗列出的东西死记硬背——这或许大部分时候");
    g_artLine[36] = StringToText("有用，但是无法处理一些极端特殊的状况。当然，你也可以将任何问题反馈给官方人员，");
    g_artLine[37] = StringToText("或者协助参与钟楼百科的审核或更新。");
    g_artLine[38] = StringToText("为什么钟楼百科不可以将规则和理念同时呈现出来呢？这样或许玩家们在贯彻说书人理念的时候，");
    g_artLine[39] = StringToText("有一个参考。实际上，这样做可能会起到反作用。虽然Steven作为设计师会有他的形形色色的想法，");
    g_artLine[40] = StringToText("但没有必要将一个人的理念完完全全强加给另一个人。理念是开放的，正如不同的玩家的乐趣和兴奋点不");
    g_artLine[41] = StringToText("同一样，如果限制了理念方面的内容，让玩家都秉承着死板的教条，那么就会扼杀玩家的创造力与这款游");
    g_artLine[42] = StringToText("戏的生命力。当你觉得你是一个规则方面大部分情况下没问题的说书人，想要更进一步时，");
    g_artLine[43] = StringToText("你可以阅读阅读给说书人的建议，这里有一些引导性质的观点，然而接下来更多的是去实践和贯彻围绕你");
    g_artLine[44] = StringToText("的性格而来的，与众不同的《染》的游戏。因此百科在绝大多数情况下对于理念方面也只是一个单纯的引");
    g_artLine[45] = StringToText("导和建议，更多的内容还需要说书人自己去探索。如果只是参照他人的建议，");
    g_artLine[46] = StringToText("那么这款游戏的无限可能性就会逐渐消失。");
    g_artLine[47] = StringToText("不过，如果你希望能通过设计师的角度来对理念有更进一步的认识，请关注百科里持续更新的「拓展阅读");
    g_artLine[48] = StringToText("」栏目（你可以在百科首页中找到它）。");
    g_artLine[49] = StringToText("此外，对于规则方面，Steven还将涉及到规则的问题分为了两类，一类是机制型问题（Mecha");
    g_artLine[50] = StringToText("nic question），一类是社交型问题（Social question）。对于前者，");
    g_artLine[51] = StringToText("你或许能很容易找到问题的答案，而对于后者，实际上并无明确的答案，这取决于不同的情形、");
    g_artLine[52] = StringToText("场合与玩家团体。应对这样的问题，更应该抛开固定的机制与规则，寻求变通。");
    g_artLine[53] = StringToText("最后，你可以不时回来查看钟楼百科，利用左侧导航条的「最近更改」你可以知道钟楼百科最近发生了哪");
    g_artLine[54] = StringToText("些变化。与我们一起，让《染》在国内大放光彩吧！");
    // 1 设计师的平衡天书（77 段 / 292 行）
    g_artAt[1] = 55;
    g_artN[1] = 292;
    g_artLine[55] = StringToText("（From Steven Medway）");
    g_artLine[56] = StringToText("我在染.钟楼谜团的平衡上投入了大量的精力和时间。这并不是说我已经做得尽善尽美了，");
    g_artLine[57] = StringToText("但是在平衡这个领域里确实已经有大量的幕后工作，贯穿了游戏的所有部分。");
    g_artLine[58] = StringToText("【镇民的平衡】");
    g_artLine[59] = StringToText("目前有 108 位镇民已创作完成，而且还有更多在创作中。理想情况下，镇民之间应该是平衡的。");
    g_artLine[60] = StringToText("但并不是。他们中的一些人获得的信息比其他人更好，或者拥有比其他人更能影响游戏的能力。然而，");
    g_artLine[61] = StringToText("这些差异是定性的，而不是定量的，因此它们高度依赖于具体的情形。有些游戏情况下会让一个角色「得");
    g_artLine[62] = StringToText("到 X」，而另一个角色「得到 2X」，染.钟楼谜团中的能力无法在数学上进行比较。");
    g_artLine[63] = StringToText("一些镇民比其他人稍好一些。不过，在所有情况下，只有少数人比其他人更好 -例如，");
    g_artLine[64] = StringToText("艺术家比游戏中的任何其他镇民获得更好的信息，因为他们可以复制大多数其他镇民的能力而不会受到惩");
    g_artLine[65] = StringToText("罚。不过，这样的角色非常罕见。考虑一下厨师对比 钟表匠。在单爪牙的游戏中，钟表匠更好。");
    g_artLine[66] = StringToText("在双爪牙的游戏中，厨师通常更好。角色间并不平衡-他们的力量水平各不相同-但没有哪位镇民（除了");
    g_artLine[67] = StringToText("那个讨厌的艺术家）比其他镇民更好。");
    g_artLine[68] = StringToText("【外来者的平衡】");
    g_artLine[69] = StringToText("外来者并不真正需要与其他外来者保持平衡，尽管这也是个次要的考虑。外来者真正需要平衡的是游戏中");
    g_artLine[70] = StringToText("额外多出一个善良方玩家所创造的局势变化。添加到游戏中的外来者会产生额外的善良方投票、");
    g_artLine[71] = StringToText("会额外增加邪恶团队所需要杀死的人数，并且每个外来者都会带来一个隐藏的优势 - 可信度。");
    g_artLine[72] = StringToText("如果一场比赛中只有一个外来者，而该外来者公开了自己的角色，那么善良方团队将获得巨大优势。所以，");
    g_artLine[73] = StringToText("外来者的能力需要平衡的是这三个因素。大多数外来者都大致是这样，但很难判断平衡性。");
    g_artLine[74] = StringToText("虽然管家对他们参与的每一场比赛都有影响（他们使投票给邪恶玩家的难度更大），");
    g_artLine[75] = StringToText("但圣徒影响比赛往往十次只有一次。一般来说，我发现外来者的能力在平衡他们自身给善良方团队带来的");
    g_artLine[76] = StringToText("优势方面存在不足，但已经接近。");
    g_artLine[77] = StringToText("【爪牙的平衡】");
    g_artLine[78] = StringToText("关于镇民的一切都适用于爪牙。爪牙不需要平衡镇民 -爪牙需要平衡的是其他的爪牙。");
    g_artLine[79] = StringToText("一些爪牙做的事情与其他人截然不同，因此爪牙的平衡非常依赖于具体情景。不过，");
    g_artLine[80] = StringToText("关于爪牙的能力需要了解的一件重要事情是，与镇民不同，爪牙获取信息的能力与他们的能力相比非常薄");
    g_artLine[81] = StringToText("弱。善良团队的强项是信息，而邪恶团队的强项是混淆信息，或者让比赛更快地进入最后一天。");
    g_artLine[82] = StringToText("知道全部信息的爪牙（间谍）并不比使谎言看起来可信的爪牙（投毒者）更强大。");
    g_artLine[83] = StringToText("直接比较爪牙的能力是很困难的。");
    g_artLine[84] = StringToText("【恶魔的平衡】");
    g_artLine[85] = StringToText("一些恶魔需要和其他恶魔大致保持平衡，但另一些恶魔则不需要。我用于平衡恶魔的通用模板是「每晚杀");
    g_artLine[86] = StringToText("死一个人，外加一点小额外能力」。例如，小恶魔每晚可以杀人一次，但可以让爪牙变成新的自己。");
    g_artLine[87] = StringToText("普卡每晚杀人一次，但还有毒。涡流每晚杀人一次，但也会使信息变错。这个公式大致适用于创造平衡的");
    g_artLine[88] = StringToText("游戏，以及恶魔之间的平衡。一些恶魔使用相反的公式：「每晚杀一次，加上一些很强的东西，");
    g_artLine[89] = StringToText("再加上一些很糟糕的东西。」例如，小怪宝每晚杀人一次，加上场上多出一个额外的爪牙能力并可以变换");
    g_artLine[90] = StringToText("恶魔是谁（超强），但是每晚由说书人来选择谁死，也没有邪恶的玩家会得到用于伪装的角色（糟糕）。");
    g_artLine[91] = StringToText("痢蛭每晚杀人一次，使一名玩家中毒并且自己不会死（超强），但是当他们的宿主死亡时就会随之死去。");
    g_artLine[92] = StringToText("虽然无法准确确定这些能力的确切强度，但公式大致有效。");
    g_artLine[93] = StringToText("同样，每晚杀人不止一次的恶魔也会有一个缺点来平衡它们。沙巴洛斯每晚可以杀人两次，但会反刍。");
    g_artLine[94] = StringToText("另一方面，珀每晚杀人三次，但首先需要休息一晚（将它们的杀戮能力提高到每晚 1.5 次……这符");
    g_artLine[95] = StringToText("合公式） 。");
    g_artLine[96] = StringToText("【旅行者的平衡】");
    g_artLine[97] = StringToText("旅行者很难平衡。由于旅行者可以是善或恶，因此他们的能力强度不是问题。");
    g_artLine[98] = StringToText("问题是——如果善良团队认为一个旅行者是邪恶的，他们能否对抗这种能力？");
    g_artLine[99] = StringToText("如果一个好的旅行者正在摧毁他们，邪恶团队能否无效该能力？旅行者可以被流放的规则是专门为平衡旅");
    g_artLine[100] = StringToText("行者而设计的。如果善良团队认为一个邪恶的旅行者的能力破坏了平衡，他们可以自由地从游戏中移除这");
    g_artLine[101] = StringToText("种能力。而邪恶团队如果因为一个善良的旅行者而遭殃，可以让恶魔在晚上杀死他们。这种机制并不完美，");
    g_artLine[102] = StringToText("但意味着虽然旅行者可以影响游戏，但不能破坏游戏。旅行者之间确实是不平衡的。");
    g_artLine[103] = StringToText("他们之间平衡的方式是都内置了在失衡时被移出游戏的能力。旅行者是不平衡的……但任何一个团队都可");
    g_artLine[104] = StringToText("以选择重新平衡他们。");
    g_artLine[105] = StringToText("【传奇角色的平衡】");
    g_artLine[106] = StringToText("传奇角色超难平衡。传奇角色之间不需要平衡，它们需要与自己平衡。添加一个传奇角色角色不应该给善");
    g_artLine[107] = StringToText("恶任何一方带来优势。一些传奇角色通过以不同方式为两个团队提供优势来做到这一点。");
    g_artLine[108] = StringToText("一些传奇角色通过纠正场外的不平衡来做到这一点。正是出于这个原因，我建议仅在必要时才将传奇角色");
    g_artLine[109] = StringToText("添加到游戏中。「只是为了好玩」将传奇角色添加到游戏会使游戏失衡。");
    g_artLine[110] = StringToText("例如，在暗流涌动中添加哨兵会提升善良团队的难度。这不公平。将哨兵添加到外来者数量固定的自定义");
    g_artLine[111] = StringToText("剧本，可以纠正这个剧本的天然的不平衡，有利于善良团队，并使局势恢复平衡。");
    g_artLine[112] = StringToText("革命者会为善良团队提供巨大的优势。确定两个玩家是同一个阵营是很棒的。然而，革命者是为残疾玩家、");
    g_artLine[113] = StringToText("低龄玩家等使用的，他们往往处于战略弱势地位。所以这个传奇角色提供了一个修正机制来平衡场外的失");
    g_artLine[114] = StringToText("衡。「每场游戏一次，被视为错误的阵营」也有助于通过说书人实现平衡。传奇角色用于纠正失衡，");
    g_artLine[115] = StringToText("并且应该只被用于纠正失衡。");
    g_artLine[116] = StringToText("【善良角色与邪恶角色的平衡】");
    g_artLine[117] = StringToText("这将是一个常见的问题 –共情者是否比间谍更强大？贞洁者比投毒者更强吗？一般来说，答案是「不」。");
    g_artLine[118] = StringToText("邪恶角色比善良角色更厉害，因为善良角色比邪恶角色数量多，邪恶角色每天都可能输掉比赛，");
    g_artLine[119] = StringToText("而善良角色只会在最后一天失败。单个善恶角色之间的平衡是完全不存在的，而这本该如此。");
    g_artLine[120] = StringToText("洗衣妇只知道一个角色，间谍知道所有角色。但是仅有两个邪恶的角色，却有七个善良的角色。");
    g_artLine[121] = StringToText("所以最终仍然是平衡的。");
    g_artLine[122] = StringToText("【善良阵营VS邪恶阵营】");
    g_artLine[123] = StringToText("这是一个大问题：善良阵营与邪恶阵营平衡吗？给定相同的技术水平，每个阵营是否有同样的机会获胜？");
    g_artLine[124] = StringToText("这只能通过统计数据来确定。虽然可能会发生刚刚输掉游戏的苦逼玩家怪游戏不公平，");
    g_artLine[125] = StringToText("但统计数据不会撒谎。近 600 场有记录的暗流涌动游戏中善良邪恶阵营间的赢/输率仅有1%的差");
    g_artLine[126] = StringToText("额。暗流涌动事实上非常的平衡。黯月初升的游戏记录相对略少一点，邪恶胜率略高，");
    g_artLine[127] = StringToText("而梦殒春宵的善良阵营胜率略高 -约为 52% 或 53%。然而——基于这些数据记录，");
    g_artLine[128] = StringToText("我通过加强亡骨魔（或者说它的威胁）来强化了梦殒春宵中的邪恶阵营。从那时起，");
    g_artLine[129] = StringToText("我们的梦殒春宵统计数据就已经平衡了不少。在黯月初升中，新玩家在前几场游戏时可能还不太了解这个");
    g_artLine[130] = StringToText("剧本中善良玩家的策略，而老手玩家的胜率却越来越趋近50/50。");
    g_artLine[131] = StringToText("在开暗流涌动的最初 3、4 年中，我投入了大量的时间、精力和注意力来观察游戏，");
    g_artLine[132] = StringToText("看看哪个阵营获胜，以及为什么获胜。我在说书时总是如此专注（和紧张）");
    g_artLine[133] = StringToText("的原因并不是因为游戏本身难以运行，而是因为我在脑海中一直在观察玩家并从设计师的视角思考如何让");
    g_artLine[134] = StringToText("游戏更加平衡。如果某个特定的剧本看起来很极端，我会修改某些角色。如果玩家评论「这个角色没用」，");
    g_artLine[135] = StringToText("我会重视并重新设计角色（如果我也认可这个批评的话）。在起初的至少18个月中，");
    g_artLine[136] = StringToText("善恶胜率都约为 70/30。有时是 80/20。我投入了大量的工作来加强邪恶团队，");
    g_artLine[137] = StringToText("重新平衡善良阵营，让事情更加公平。我们做到了，但确实花了好几年的时间。");
    g_artLine[138] = StringToText("【配置的平衡】");
    g_artLine[139] = StringToText("一个常见的抱怨是某个剧本的特定角色配置比其他配置更容易一些。虽然确实如此，");
    g_artLine[140] = StringToText("但我没有发现他们不公平到可以让一个阵营获胜的地步。例如，对于善良阵营来说，");
    g_artLine[141] = StringToText("酒鬼和投毒者都在场的配置肯定比间谍和管家在场的设置更困难。我曾经认为说书人所做的配置选择确实");
    g_artLine[142] = StringToText("会破坏游戏的平衡，但实践证明我错了。有很多次我为新玩家连续开了四五场暗流涌动，");
    g_artLine[143] = StringToText("尽管我尽了最大的努力来设计邪恶阵营胜利的局面，善良阵营还是赢了很多次……或反过来说，");
    g_artLine[144] = StringToText("说书人当然可以通过连续五天告诉博学者 「Evin 是恶魔」和「一加一等于三」来故意破坏梦殒春");
    g_artLine[145] = StringToText("宵游戏……但不知为何这样仍然无法彻底决定那场游戏的胜负。就算这样做确实杀死了比赛，");
    g_artLine[146] = StringToText("也不能将 「我可以故意破坏游戏」等同于「我可能不小心使游戏失衡」，这对说书人来说是不公平的。");
    g_artLine[147] = StringToText("【老手 vs 新手】");
    g_artLine[148] = StringToText("我认为染在这方面有点过于平衡，但只是一点点。理想情况是成为一款「易学难精」的游戏。");
    g_artLine[149] = StringToText("染基本上是这样的。虽然一队邪恶的老手通常会击败一队善良的新手，而一队善良的老手通常会击败一队");
    g_artLine[150] = StringToText("邪恶的新手，但并不总是这样。例如，在国际象棋中，更好的玩家（以显着优势）总是会赢。在钟楼，");
    g_artLine[151] = StringToText("情况并非如此。通常是这样，但并非总是如此。");
    g_artLine[152] = StringToText("【马太效应问题】");
    g_artLine[153] = StringToText("许多游戏都有马太效应的问题，这会在领先的玩家和落后的玩家之间造成不平衡。");
    g_artLine[154] = StringToText("在很多德式游戏中这个问题十分典型。基本上，领先的玩家可以获得更多资源/工具/货币/等。");
    g_artLine[155] = StringToText("因此有更多的机会增加他们的领先优势。如果没有死后投票的机制，钟楼谜团也将会面对马太效应问题。");
    g_artLine[156] = StringToText("如果玩家死后不能投票，善良玩家的死就意味着有更多的邪恶方投票，这不可避免地导致更多的善良玩家");
    g_artLine[157] = StringToText("死去，反之亦然。钟楼谜团通过让死去的玩家投票来平衡这一点。它不仅增加了乐趣和参与度，");
    g_artLine[158] = StringToText("而且还平衡了领先阵营和落后团队。当然，依然可能发生只剩邪恶玩家活着的情况——如果发生这种情况，");
    g_artLine[159] = StringToText("邪恶方的表现如此出色，提前胜利是他们应得的。");
    g_artLine[160] = StringToText("【战术的平衡】");
    g_artLine[161] = StringToText("有些游戏有最优解。每当一种特定的玩法被发现时，它可能会被证明是（不管是使用逻辑或仅仅是习惯性");
    g_artLine[162] = StringToText("的）最佳的策略。这意味着任何不使用该策略的人要么无知，要么是在故意误导整个团队。无论如何，");
    g_artLine[163] = StringToText("如果任何特定角色被找到了最优解，无论是哪一个阵营的，我都会重做这个角色。");
    g_artLine[164] = StringToText("我无法证明钟楼谜团没有优势策略。但我能做的就是回应说「是的，但如果情况稍有不同，");
    g_artLine[165] = StringToText("就会变成另一种策略效果更好。」例如，听到有人说「我们总是立即杀死F4」的时候，我回应说：");
    g_artLine[166] = StringToText("「这将导致更多的邪恶玩家在最后一天还活着，所以获取了信息但失去了投票权……而老玩家则会因此知");
    g_artLine[167] = StringToText("道如何伪装角色而受益。」在墨尔本的一场比赛中，游戏开始玩家们说的第一句话是「好的，");
    g_artLine[168] = StringToText("F4请先说话」，这局游戏里我是恶魔，我忍到最后一天时「透露」我是调查员，");
    g_artLine[169] = StringToText("因为「我知道三个活着的玩家之一是爪牙，这太棒了。如果我在第一天这么说，我会被杀的。");
    g_artLine[170] = StringToText("所以直到现在才透露我是F4，这让我们赢得了比赛。」最后邪恶团队赢得了那场比赛，");
    g_artLine[171] = StringToText("因为我们利用了他们自以为的「最优解」的漏洞。");
    g_artLine[172] = StringToText("【随机性的平衡】");
    g_artLine[173] = StringToText("有些游戏用掷骰子决定赢输。这会让玩家感到无助。有些游戏根本不涉及运气要素。");
    g_artLine[174] = StringToText("这些游戏又会遇到遇到分析瘫痪（个人或团体因为过度分析或是或过度思考而导致行动或决策被瘫痪，");
    g_artLine[175] = StringToText("无法做出行动或决定的情形），玩家总是会输给那些更有经验的人，并且随着时间的推移每场游戏变得同");
    g_artLine[176] = StringToText("质化。在我看来，最好的游戏兼具两者的元素。");
    g_artLine[177] = StringToText("在钟楼中，善良阵营有可能靠运气获胜。他们为了好玩而处决一名玩家，结果，那正好是恶魔，");
    g_artLine[178] = StringToText("然后善良阵营胜利了。为了弄清楚这是否会在游戏的平衡中发挥重要作用（没有人喜欢偶然输掉），");
    g_artLine[179] = StringToText("我根据不同玩家数量的恶魔被杀死的可能性构建了一些概率树。我不是专家，");
    g_artLine[180] = StringToText("但我知道基本的数学概率计算是如何运作的。我花了大约 20 个小时来解决这个问题。假设：");
    g_artLine[181] = StringToText("每天执行一次处决");
    g_artLine[182] = StringToText("善良方玩家随机选择一名玩家杀死");
    g_artLine[183] = StringToText("恶魔每晚杀人一次");
    g_artLine[184] = StringToText("死人不能投票");
    g_artLine[185] = StringToText("……根据玩家人数，善良阵营靠运气获胜的可能性约为 45% 到 55%。这听起来可能很高，");
    g_artLine[186] = StringToText("但这几乎正是我们所需要的。这意味着，如果好队打得很烂（忽略他们的信息，不使用他们的能力，");
    g_artLine[187] = StringToText("随机处决等）而邪恶队也摆烂（不使用他们的能力，随机杀人等），那么两个队获胜的机会大致相等。");
    g_artLine[188] = StringToText("要将自己的胜率提升到 70%、80% 或 90% 的，一方阵营只需要比另一方玩得更好。");
    g_artLine[189] = StringToText("作为一名善良玩家，钟楼这个游戏的玩法并不是让你使用自己的能力来百分之百确定恶魔是谁，");
    g_artLine[190] = StringToText("然后使用社交霸凌技巧来强迫别人听你的。染.钟楼谜团是一款关于明智地使用你的能力（或其他人的能");
    g_artLine[191] = StringToText("力），将 50% 的获胜可能性变为 80% 的获胜可能性的游戏。如果善恶双方都表现不佳，");
    g_artLine[192] = StringToText("则概率为 50/50。如果善良方玩得不错，而邪恶方玩得不好，绝大多数时候善良方胜。");
    g_artLine[193] = StringToText("如果邪恶阵营发挥得好，而善良方发挥得不好，那么绝大多数时候邪恶都会获胜。如果善恶都发挥得好，");
    g_artLine[194] = StringToText("则回到 50/50。这才是这个游戏应有的状况。");
    g_artLine[195] = StringToText("【刻意不公平的设计理念】");
    g_artLine[196] = StringToText("我对 染.钟楼谜团 的设计理念是故意制造不公平的情况。使用极端非对称的定性方法，而非定量方法。");
    g_artLine[197] = StringToText("大多数游戏是对称的，或者至少是通过调整其游戏要素在数量上或数学上的级别来达到近似对称。例如，");
    g_artLine[198] = StringToText("如果 A 队的统计数据 +1，则 B 队的统计数据 +1，或者如果玩家 A 的统计数据获得三");
    g_artLine[199] = StringToText("个 +2，那么玩家 B 稍后的统计数据将 +6。在较新版本的《龙与地下城》中，");
    g_artLine[200] = StringToText("巫师变成了一个用越来越有想象力的方法来「在Y轮里造成X伤害」的职业，");
    g_artLine[201] = StringToText("这样他们就不会被同样「在Y轮里造成X伤害」的战士碾压，尽管方法不同。这很好，");
    g_artLine[202] = StringToText("如果那是你想要的那种游戏。它的好处是能够轻松平衡。牧师太弱了？让他们的治疗法术治疗 8 点而");
    g_artLine[203] = StringToText("不是 6 点。小偷是否被强得超模了？让他们躲在阴影中的机会从 90% 变为 85%。然后测试。");
    g_artLine[204] = StringToText("十分简单。");
    g_artLine[205] = StringToText("定性的差异非常非常难以被量化（就如字面意思说显示的）。它们依赖于具体情景，也依赖于玩家。例如，");
    g_artLine[206] = StringToText("在旧版本的龙与地下城中，巫师不会像战士那样「每Y 轮造成 X 伤害」，");
    g_artLine[207] = StringToText("他们会在战斗一开始就立即跑开躲起来。然而，他们脱离战斗时施展的「睡眠」咒语，");
    g_artLine[208] = StringToText("却能让全队人完全从守卫身边溜过。巫师的强度与战士的强度几乎完全取决于玩家何时以及在什么环境中");
    g_artLine[209] = StringToText("做了什么。即使知道了所有因素，仍然很难判断谁强谁弱。");
    g_artLine[210] = StringToText("我设计染.钟楼谜团的方法是完全摆脱「+1，-1」的设计理念，而是创造出从本质上就截然不同，");
    g_artLine[211] = StringToText("甚至完全不公平的角色。相比起创造一个角色并思考「哦，哇。那是不公平的，最好不要，");
    g_artLine[212] = StringToText("」我选择让角色保持原样，并在对立阵营中创造了更多不公平的角色。例如，共情者是不公平的。");
    g_artLine[213] = StringToText("知道你的两个邻居都是好人不公平——而知道你的两个邻居都是邪恶的，这是非常不公平！");
    g_artLine[214] = StringToText("所以……我创造了投毒者。天哪，投毒者太不公平了。让某人的信息在他们不知情的情况下变成错的？");
    g_artLine[215] = StringToText("还每晚都行？这太疯狂了——不公平。圣徒也不公平。如果没有人信任你，你就会输掉比赛。哎，不公平。");
    g_artLine[216] = StringToText("图书管理员也是不公平的……你知道圣徒是谁，所以你知道不要处决他们，他们又反过来相信你。");
    g_artLine[217] = StringToText("占卜者是不公平的。知道哪个玩家是恶魔几乎就赢得了胜利（尤其是在干扰项死了的情况下）。所以，");
    g_artLine[218] = StringToText("小恶魔也是不公平的，在占卜者一指向他们时就可以换玩家。");
    g_artLine[219] = StringToText("染.钟楼谜团的设计理念不是创造一个公平的游戏，其中一个团队的能力可以与另一个团队的能力进行抗");
    g_artLine[220] = StringToText("衡。我的设计理念是创造一个游戏，其中每个玩家都有非常强大的能力，甚至强到了不公平的地步，");
    g_artLine[221] = StringToText("但对方阵营也有接近碾压的能力。这样，最大的权利就被赋予了玩家。赢得游戏不只靠能力，");
    g_artLine[222] = StringToText("也不只靠玩家，而是靠玩家善用自己的能力。可以想象，这种设计理念意味着平衡非常困难，");
    g_artLine[223] = StringToText("需要很长时间，并且只能通过个人判断什么是平衡的，什么不是，因为它无法通过数学分析来判断。");
    g_artLine[224] = StringToText("然而，这确实意味着，由于玩家的能力或盲目的运气，有时似乎游戏可以由于角色能力而输赢。");
    g_artLine[225] = StringToText("但获胜的通常不是单个角色或玩家，而是一个隐藏的互动网络导致某个玩家获得了「C位」。例如，");
    g_artLine[226] = StringToText("虽然恶魔玩家可能会抱怨说他们输了是因为猎手「太超模了」，因为他们在第二天就赢得了比赛，");
    g_artLine[227] = StringToText("而且恶魔「没有做错什么」，但他们可能忽视了这位猎手与洗衣妇私聊、和图书管理员沟通得知了不用瞄");
    g_artLine[228] = StringToText("准谁，争取到了僧侣的保护，伪装成守鸦人，并说服投毒者毒占卜师而不是他。");
    g_artLine[229] = StringToText("猎手为了他的胜利付出了努力，并且公平地获胜，尽管看起来是因为这个角色不公平。");
    g_artLine[230] = StringToText("【下限能力】");
    g_artLine[231] = StringToText("大多数角色具有中等强度的「下限」能力。这意味着如果玩家什么都不做，");
    g_artLine[232] = StringToText("他们仍然会从该能力中获得一些好处。例如，不主动的共情者仍然可以得知有价值的信息。");
    g_artLine[233] = StringToText("一个什么都不说的贞洁者仍然可以通过意外被提名来为团队做出贡献。大多数角色都有「浅层」能力，");
    g_artLine[234] = StringToText("有用，但不会破坏游戏。在谈论平衡问题时，这些能力的存在对于初学者来说尤其重要。例如，");
    g_artLine[235] = StringToText("对于新玩家来说， 送葬者可能会显得很弱，因为恶魔总是会提前杀死他们。");
    g_artLine[236] = StringToText("守鸦人可能看起来没什么强度，因为是否被恶魔杀死「全靠运气」 。从这个意义上说，");
    g_artLine[237] = StringToText(" 送葬者和守鸦人的「下限」能力都不足。占卜者具有很高的下限能力。即使是新玩家也可以通过纯运气");
    g_artLine[238] = StringToText("获得游戏决胜信息。因此，关于这些角色不平衡的批评是正确的——占卜者在入门级别上比送葬者或守鸦");
    g_artLine[239] = StringToText("人更强大。在某些情况下，游戏确实不平衡。");
    g_artLine[240] = StringToText("钟楼因角色不平衡而受到过批评。这通常指的是他们的能力下限。一个新玩家看到间谍能力被吓坏了。");
    g_artLine[241] = StringToText("然后当他们自己成为间谍，就会意识到实际上玩起来有多么困难。其他人输给了主谋后大喊大叫。");
    g_artLine[242] = StringToText("然后当他们自己成为主谋，发现真的很难让他们的能力发挥作用。一个玩过几把的玩家如果总是在第一天");
    g_artLine[243] = StringToText("就脱口而出说他们是守鸦人，结果在他终于被恶魔杀死时选了个死去的玩家，");
    g_artLine[244] = StringToText("他可能会看着占卜者或镇长并高谈阔论所谓的「平衡问题」。只有当他成为占卜者并在试图找出干扰项时");
    g_artLine[245] = StringToText("盘到崩溃，或者成为镇长并发现说服两个邪恶的玩家不投票是多么困难时，");
    g_artLine[246] = StringToText("才会意识到情况完全不是那么回事。");
    g_artLine[247] = StringToText("【上限能力】");
    g_artLine[248] = StringToText("每个角色都有不同的「天花板力量」。这个术语代表了一个角色在真正处于碾压模式的老手手中时可能有");
    g_artLine[249] = StringToText("多强大。上限能力高于下限能力。问题是「高多少？」有些角色的下限力量很低，但上限能力却非常高。");
    g_artLine[250] = StringToText("例如，艺术家的下限能力较低，因为大多数玩家会使用艺术家来问「我是艺术家吗？");
    g_artLine[251] = StringToText("」或「这个玩家是邪恶的吗？」。这个角色的普通玩法确实强度不高。但是，");
    g_artLine[252] = StringToText("老手可以使用艺术家来询问「恶魔是 Dave、Jim、Sally、Achmed或者Joan吗？");
    g_artLine[253] = StringToText("」而之前恶魔已经被确认为方古。此信息（无论是或否）将为善良阵营赢得比赛。");
    g_artLine[254] = StringToText("送葬者可以连续 7 天伪装是士兵，然后在最后一天拿出他所有积攒的信息。");
    g_artLine[255] = StringToText("送葬者和艺术家的下限都较低，但上限较高。");
    g_artLine[256] = StringToText("反之，有些角色的下限很高，但上限差不多没变化。例如，一个钟表匠获得了非常好的信息，");
    g_artLine[257] = StringToText("但玩家利用这些信息来直接搞定邪恶团队的方法并不多。当然，他们可以选择是透露他们的信息还是先隐");
    g_artLine[258] = StringToText("藏起来，但无论哪种方式，都不会产生巨大的差异。或者罂粟种植者——他们真的一开始就已经削弱了邪");
    g_artLine[259] = StringToText("恶团队。当然，罂粟种植者可以通过尽可能长时间地活着来延长这一点，但所造成的伤害与在第二个或第");
    g_artLine[260] = StringToText("三个晚上死亡并没有灾难性的不同。");
    g_artLine[261] = StringToText("尽管存在一些交叉，但上限能力不一定与被动与主动有关。例如，哥布林是一个相当被动的能力。");
    g_artLine[262] = StringToText("下限非常低——在新玩家手中，或者在不想付出努力的玩家手中，它非常低。");
    g_artLine[263] = StringToText("它甚至会因为暴露了爪牙是什么角色导致善良阵营获得优势。但是在熟练的老手手中，");
    g_artLine[264] = StringToText("他们能单人引领游戏胜利。这个角色拥有毁灭性的天花板力量。");
    g_artLine[265] = StringToText("由于角色具有「漏洞」，染.钟楼谜团被批评为不平衡。虽然我不同意存在漏洞（如果有，");
    g_artLine[266] = StringToText("它们会成为灯神的规则），但不同角色的能力之间的确存在一定程度的不平衡。");
    g_artLine[267] = StringToText("不同的玩家可以让一个角色做到完全不同的事情，这只是看起来是不平衡的。如果它实际上是不平衡的，");
    g_artLine[268] = StringToText("它就会变成一个灯神规则。然而，人们经常看到的是一个狡猾的玩家充分利用了他们的能力，");
    g_artLine[269] = StringToText("而对方却没有任何反击。在这种情况下，一个玩家的操作促使他们利用自己的智慧来使游戏失衡，");
    g_artLine[270] = StringToText("使其对自己有利。这很好。这只是「获胜」的另一种说法。");
    g_artLine[271] = StringToText("你可以认为外来者相反拥有的是「地板能力」——一种相当的不公平，并且真的纯属拖后腿的能力。");
    g_artLine[272] = StringToText("管家的下限有点低，没什么用，但谈不上「地板能力」。圣徒就完全不是「下限低」，");
    g_artLine[273] = StringToText("而是一个极端的「地板能力」。");
    g_artLine[274] = StringToText("【强度的波动】");
    g_artLine[275] = StringToText("这要棘手得多。有些角色的强度会根据配置、说书人给出的信息或运气而发生根本变化。");
    g_artLine[276] = StringToText("我认为这个批评颇具价值，尽管我对官方剧本的运作状态非常满意。");
    g_artLine[277] = StringToText("例如，提线木偶在没有错误信息的环境中非常强大。如果提线木偶认为他们是贵族，");
    g_artLine[278] = StringToText("并透露说某3名玩家中有1名是邪恶的，在这种情况下，提线木偶就在言之凿凿地传播虚假信息，");
    g_artLine[279] = StringToText("而且恶魔还可以随时让他倒戈。这种情况下提线木偶的能力上限有中到高的水平。但是，");
    g_artLine[280] = StringToText("如果提线木偶认为他们是洗衣妇，那么提线木偶要么没用，要么因为暴露他们是提线木偶反而有害于邪恶");
    g_artLine[281] = StringToText("阵营。所以，提线木偶角色下限低，上限威力高，强度波动性大。如果围绕木偶构建了正确的剧本，");
    g_artLine[282] = StringToText("那么它是平衡的。如果将木偶放到错误的剧本中，那将是极其不平衡的。");
    g_artLine[283] = StringToText("厨师则相反。厨师具有中等强度的下限——无论发生什么，厨师都是有用的，但并不关键。");
    g_artLine[284] = StringToText("无论您构建什么剧本， 厨师都会或多或少保持平衡。");
    g_artLine[285] = StringToText("在官方剧本中（到目前为止，暗流涌动、黯月初升和梦殒春宵），偶尔会出现一个看起来不平衡的配置。");
    g_artLine[286] = StringToText("典型的例子是共情者坐在两个邪恶的玩家旁边。我同意这似乎不平衡。好消息是（在官方剧本中），");
    g_artLine[287] = StringToText("当这些情况发生时，要么你认为已经没有胜算的队伍获胜了，要么他们至少打得轰轰烈烈。");
    g_artLine[288] = StringToText("一个角色的强度上下限波动如此剧烈，以至于游戏的输赢是由于能力本身而不是由于玩家对这种情况做出");
    g_artLine[289] = StringToText("的反应决定的，是极其罕见的情况。");
    g_artLine[290] = StringToText("它可以在官方版本中发生，但很少见。但是，当说书人创建自己的剧本时，这更容易成为一个问题。");
    g_artLine[291] = StringToText("在这种情况下，平衡是一个需要面对的问题。把外交官和投毒者放在一起？哎哟。");
    g_artLine[292] = StringToText("又或者把吟游诗人和军团放在一起？然而，某些不平衡的角色组合虽然是一个问题，");
    g_artLine[293] = StringToText("但往往会创造出有趣的游戏。染.钟楼谜团的设计目的是让玩家永远不会陷入无法胜利的境地。");
    g_artLine[294] = StringToText("绝不能出现让你知道自己已经输定了只是在那里坐牢等待游戏结束的情况。");
    g_artLine[295] = StringToText("我讨厌在其他游戏中出现这种情况，所以染.钟楼谜团被设计成这种情况绝不会发生。");
    g_artLine[296] = StringToText("如果某个特定的角色组合或魔典设置确实使自定义游戏失衡了，经验表明，");
    g_artLine[297] = StringToText("最有趣和最令人难忘的正是这些游戏。是的，平衡是自定义游戏中的一个问题，");
    g_artLine[298] = StringToText("因为某些角色组合会产生巨大的强度波动。这不是我所希望的。好消息是，");
    g_artLine[299] = StringToText("弄清楚它的过程通常是一个有趣的过程，如果它达到了成为一个漏洞的程度，它就会被灯神规则修复。");
    g_artLine[300] = StringToText("【自定义游戏】");
    g_artLine[301] = StringToText("自定义游戏中更大的平衡问题是说书人在需要时不使用哨兵、 圣洁之魂、 骗人精或公爵夫人。");
    g_artLine[302] = StringToText("一个已知外来者数量且没有哨兵的游戏会摧毁邪恶阵营。一场有三名额外邪恶玩家且没有圣洁之魂的游戏");
    g_artLine[303] = StringToText("对善良阵营来说是毁灭性的。没有骗人精且没有醉酒或中毒可能性的游戏会让邪恶玩家感到非常不公平 ");
    g_artLine[304] = StringToText("- 确实如此。一场没有信息也没有公爵夫人的游戏会给善良阵营带来不公平的感觉……事实并非如此，");
    g_artLine[305] = StringToText("但确实有这种感觉。");
    g_artLine[306] = StringToText("【说书人的干预】");
    g_artLine[307] = StringToText("关于说书人破坏游戏平衡的能力，已经有很多说法了。我认为说书人唯一能让游戏失去平衡的方法就是他");
    g_artLine[308] = StringToText("们犯了一个大错，或者故意破坏游戏。");
    g_artLine[309] = StringToText("如果说书人将镇长展示给洗衣妇，然后守鸦人得知镇长是镇长， 共情者告诉大家镇长是善良的，");
    g_artLine[310] = StringToText("占卜师告诉大家镇长不是恶魔，然后当恶魔在最后一晚攻击了镇长，说书人杀死了投毒者……是的。");
    g_artLine[311] = StringToText("这是相当不平衡的。恶意的说书人可能会破坏游戏，这对任何人来说都没有乐趣。");
    g_artLine[312] = StringToText("或者，如果说书人告诉博学者可以确认恶魔的信息，比如说「杰里米是恶魔。莎拉是畸形秀演员，");
    g_artLine[313] = StringToText("」然后吉尔声称自己是畸形秀演员并被处决，这是真的不平衡。这是一个新手说书人的错误，");
    g_artLine[314] = StringToText("它确实发生过。");
    g_artLine[315] = StringToText("不过，我所看到的是，如果说书人通常是在帮助邪恶的团队伪装角色，并且只是试图进行一场精彩的比赛，");
    g_artLine[316] = StringToText("那么事情就是平衡的。当他们变得不平衡时，那是因为一个阵营打得很好。这正是它应该的样子。");
    g_artLine[317] = StringToText("【舆论VS真正重要的】");
    g_artLine[318] = StringToText("当公共舆论声称某个特定角色或规则不平衡时，我通常把这当做一种恭维。");
    g_artLine[319] = StringToText("这意味着角色最初看起来非常强大，但巧妙的方法可以抗衡它。或者一个角色看起来很弱，");
    g_artLine[320] = StringToText("但明智的用法展示出这个角色实际上很强大。这意味着一个角色的外表与他们的真实实力不符。");
    g_artLine[321] = StringToText("他们真正的优势在于玩家的精妙玩法。对我来说，这说明游戏设计是优秀的，");
    g_artLine[322] = StringToText("因为这意味着初学者相信角色能力会为他们赢得游戏，而老手则面临着提出更精妙策略的挑战。");
    g_artLine[323] = StringToText("间谍就是一个很好的例子。很多人看到间谍竟然可以看魔典，于是嚷嚷着「不平衡」，");
    g_artLine[324] = StringToText("我不会对此感到大惊小怪。对间谍的最初反应是普遍的困惑和震惊——潜台词是它是一个不平衡的角色，");
    g_artLine[325] = StringToText("而我是一个愚蠢的设计师才会创造它。然而，无所不知对邪恶玩家并没有多大帮助，");
    g_artLine[326] = StringToText("所以我实际上给了间谍另一个能力来弥补他们「无所不知」能力的弱点——被当作善良角色。");
    g_artLine[327] = StringToText("间谍不平衡的论点可以简单地用统计数据来反驳。间谍低于 50% 的个人胜率使其成为暗流涌动四个");
    g_artLine[328] = StringToText("爪牙中胜率较低的一个。暗流涌动的胜率是 50/50 。");
    g_artLine[329] = StringToText("当你深入研究游戏机制以及决定胜负的关键因素时，表面上的批评就会失去分量。是的，间谍似乎不平衡，");
    g_artLine[330] = StringToText("但你能利用这些信息赢得比赛吗？当然，圣徒看起来很不平衡，但它真的会经常输掉比赛吗？");
    g_artLine[331] = StringToText("不同的角色有着质的不同的能力、不同的下限强度、不同的上限强度，并且在很大程度上依赖于玩家的能");
    g_artLine[332] = StringToText("力和具体局势。确定一个角色是否失衡的最糟糕方法是听取一个苦逼玩家的抱怨，他刚刚输掉了一场游戏，");
    g_artLine[333] = StringToText("而该角色在他们的失败中发挥了关键作用。确定一个角色是否失衡的最佳方法是在游戏中扮演该角色的说");
    g_artLine[334] = StringToText("书人，并观察该角色真正意义上的斗争、胜利以及不断变化的强度和影响力。");
    g_artLine[335] = StringToText("很多关于角色「坏掉」或「不平衡」的批评来自尚未玩过游戏的人，或者玩过一两次就在没有具体局面的");
    g_artLine[336] = StringToText("情况下阅读实验性角色的人，或者来自刚刚输了游戏的玩家。");
    g_artLine[337] = StringToText("当然，对不平衡的合理批评有时是正确的。如果有人指出一个漏洞，我会通过重写或用灯神来修复它。");
    g_artLine[338] = StringToText("如果有人指出平衡或力量的差异，他们可能是正确的，但也应该根据上述几点综合来看待。");
    g_artLine[339] = StringToText("【平衡与乐趣】");
    g_artLine[340] = StringToText("作为一名设计师，平衡对我来说是一个重要的考虑因素。但是，它不是第一位的。乐趣更重要。");
    g_artLine[341] = StringToText("可玩性更重要。有时，有些角色会因为非常有趣而从平衡的裂缝中溜走。有时平衡只是一个见仁见智的问");
    g_artLine[342] = StringToText("题，因为玩家自己决定什么是公平的，什么是不公平的。");
    g_artLine[343] = StringToText("例如，最初的博学者每场比赛只允许投票一次。它更加平衡，但不那么有趣，当然也不那么好用。");
    g_artLine[344] = StringToText("最初的占卜者没有干扰项。钟楼的规则经过几年的发展，已经多次完善。有些角色有20多个版本。");
    g_artLine[345] = StringToText("每次改进的目的是创造更多乐趣，鼓励参与和创造力，并以平衡作为口号而不是目标。");
    g_artLine[346] = StringToText("平衡必然是「大致的」，并且在不牺牲乐趣、参与度和创造力的情况下永远不可能是「绝对的」。");
    // 2 创作幕后——超越暗流涌动（29 段 / 103 行）
    g_artAt[2] = 347;
    g_artN[2] = 103;
    g_artLine[347] = StringToText("设计师Steven Medway谈论玩过染.钟楼谜团的第一版「暗流涌动」后，");
    g_artLine[348] = StringToText("进入后续更高级的剧本。（请注意，本文最初创作并发表于3年前，2019年7月30日）");
    g_artLine[349] = StringToText("现在，你已经玩过了暗流涌动……接下来会是什么？你对其他剧本有何期待？在这些更深、");
    g_artLine[350] = StringToText("更暗的水域里会有鲨鱼吗？");
    g_artLine[351] = StringToText("是的。");
    g_artLine[352] = StringToText("你们中的许多人都很享受暗流涌动并对这个剧本理解越来越深刻，这是件好事，");
    g_artLine[353] = StringToText("但染.钟楼谜团提供的不仅仅是暗流涌动。不同的主题、机制和角色创造了不同的策略，");
    g_artLine[354] = StringToText("而玩家的策略——他们自己发现的策略——是令人难忘、紧张和刺激的游戏的基石。");
    g_artLine[355] = StringToText("暗流涌动是染.钟楼谜团 的「初学者」版，也几乎可以肯定地说是你最熟悉的剧本。信息一层又一层，");
    g_artLine[356] = StringToText("同一事件可以有诸多原因，以及善恶玩家都有大量策略可以使用。即使一直只玩 「暗流涌动」，");
    g_artLine[357] = StringToText("我仍然相信你将拥有数十甚至数百小时的愉快游戏时间。它有足够的深度，即使对于高级玩家也是如此。");
    g_artLine[358] = StringToText("暗流涌动的精髓可能是你已经熟悉的……有些人是好人，有些人是坏人；如果你是邪恶的——你需要假装");
    g_artLine[359] = StringToText("是善良的；如果你是好人- 你需要弄清楚谁是邪恶的。");
    g_artLine[360] = StringToText("对于染.钟楼谜团的其他剧本，我想做一些不同的事情。不仅要加入额外的角色，");
    g_artLine[361] = StringToText("还要改变游戏本身的性质——它的目标、策略和感觉。「你是坏人吗？」 如果在没有上下文的情况下提");
    g_artLine[362] = StringToText("出问题，这是一个无聊的问题，所以我不仅想改变上下文，还想改变通常被问到的问题。");
    g_artLine[363] = StringToText("如果你是一个说书人，并且想为你的玩家提供更多的挑战和变化，请考虑一下其他剧本。");
    g_artLine[364] = StringToText("你作为说书人的角色将变得更加重要，但也将允许你更多的创意和参与。");
    g_artLine[365] = StringToText("在 黯月初升 中，善良玩家被动地接收到的信息极少。他们不能只是简单地坐在那里，晚上被唤醒，");
    g_artLine[366] = StringToText("然后早上向团队揭露自己得到的信息。每个 黯月初升 角色都有一些能力，一些既残酷又有效，");
    g_artLine[367] = StringToText("甚至能改变游戏规则的能力……但前提是要主动地使用。玩家要积极主动，与他人交谈，");
    g_artLine[368] = StringToText("并有效地使用他们的角色能力来获取任何信息。爪牙和恶魔在夜间可以进行多次击杀，");
    g_artLine[369] = StringToText("善良团队需要密切关注谁在夜间死亡，以及为什么死亡。弄清楚为什么一晚上死了4个人，");
    g_artLine[370] = StringToText("或者在你以为会死4个人的时候没有人死，比弄清楚谁是好人谁是坏人更重要。");
    g_artLine[371] = StringToText("梦殒春宵则相反。所有镇民都会收到信息，大多数都是被动地。大多数信息都非常有用。");
    g_artLine[372] = StringToText("好的团队有大量有用的信息。然而——这是一个巨大的问题——恶魔可以使所有这些信息都变成假的，");
    g_artLine[373] = StringToText("或者使其中一些信息变成假的，或者甚至改变他们的角色，导致即使信息是真的，也需要正确的解读。");
    g_artLine[374] = StringToText("梦殒春宵在很大程度上是一个信息游戏，善良玩家也会被鼓励去撒谎。玩家会变换角色。角色会变换阵营。");
    g_artLine[375] = StringToText("有时爪牙甚至会意外杀死他们的恶魔。");
    g_artLine[376] = StringToText("【基础三个剧本之后】");
    g_artLine[377] = StringToText("暗流涌动探讨善与恶、信息与假信息、以及牺牲。黯月初升探讨力量和后果，以及未知的死因。");
    g_artLine[378] = StringToText("梦殒春宵探讨角色变换、善良阵营的谎言以及过量的逆推信息。每个剧本的游戏体验—以及说书体验—都");
    g_artLine[379] = StringToText("截然不同，而不仅仅是更复杂。");
    g_artLine[380] = StringToText("暗流涌动鼓励玩家考虑「你是好人还是坏人？」的问题，而其他剧本则鼓励不同的问题：");
    g_artLine[381] = StringToText("「我们面对的是哪些邪恶角色？」、「你是怎么死的？」、「我如何将我的能力与其他人的联动起来？」、");
    g_artLine[382] = StringToText("「这个一眼假的信息意味着什么？」、「恶魔已经死了吗？」、「我们如何在这个新的胜利条件下获胜？");
    g_artLine[383] = StringToText("」、「如果旧的打法行不通了，那新的策略是什么？」 等等。");
    g_artLine[384] = StringToText("目前正在设计和完善的剧本将会探讨更多的问题和主题，为玩家提供更多全新的体验。");
    g_artLine[385] = StringToText("游园惊梦探讨阵营变化、和说书人的逻辑与创造力。游园惊梦是纯逻辑和应用逻辑的中级难度剧本。");
    g_artLine[386] = StringToText("恶魔不能杀人，而是拥有各种基于时间限制的能力，这意味着善良团队不需要玩「极限生存」的游戏来充");
    g_artLine[387] = StringToText("分发挥他们的能力。许多角色要求说书人创造完全属于自己的规则和能力，");
    g_artLine[388] = StringToText("所以这将是一个非常复杂的剧本，但它的节奏更轻松。如果你喜欢梦殒春宵，你就会喜欢游园惊梦，");
    g_artLine[389] = StringToText("因为它们都是关于多重真相以脆弱但可预测的方式叠加的体验。");
    g_artLine[390] = StringToText("无名之墓探讨处决和提名，以及杀死某些特定玩家而非其他玩家的好处、禁忌和激励。");
    g_artLine[391] = StringToText("无名之墓也是一个中级剧本并且主题是关于处决的。我们要杀谁？我们应该杀死一个已知的善良玩家来触");
    g_artLine[392] = StringToText("及一个已知的邪恶玩家吗？很多邪恶角色公开行动，当面自爆，但又有强大的能力来兜底。不过，");
    g_artLine[393] = StringToText("这个剧本仍在设计中，可以期待看看。");
    g_artLine[394] = StringToText("凶宅魅影探讨了极端危险的虚张声势、私下的联盟和邪恶团队的错误信息。这是唯一在计划中的高级剧本。");
    g_artLine[395] = StringToText("我现在只能说，这对两边阵营来说都极具挑战性。即使是邪恶的团队，也可能不知道到底谁站在他们这边。");
    g_artLine[396] = StringToText("这是一场私聊、秘密结盟和高风险的伪装的游戏。与其他剧本不同，一些角色能够单枪匹马地为他们的团");
    g_artLine[397] = StringToText("队赢得或输掉比赛。");
    g_artLine[398] = StringToText("每个剧本都与其他剧本完全不同，有些玩家喜欢一个剧本，但不喜欢另一个剧本。");
    g_artLine[399] = StringToText("这些剧本并不适合所有人，但可以为快速深入的硬核玩家提供更多深度和挑战。它们还没有完成，");
    g_artLine[400] = StringToText("尽管它们正在接受游戏测试并且看起来很快就能完成。如果某些角色在不同剧本中协调并表现更好，");
    g_artLine[401] = StringToText("则它们会被修改或替换。");
    g_artLine[402] = StringToText("【创建你自己的剧本】");
    g_artLine[403] = StringToText("不过，你无需等待这些扩展来创建独特的体验。使用脚本工具，你可以创建自己的游戏来探索自己的想法。");
    g_artLine[404] = StringToText("也许你想围绕白天行动的角色制作游戏主题？这创造了独特的基调和策略。");
    g_artLine[405] = StringToText("也许你想围绕中毒来制作游戏主题，并让数学家发挥关键作用？这肯定是一个更高级的团队需要解决的问");
    g_artLine[406] = StringToText("题。也许你拥有KS版本的军团角色，并且想要围绕某3 个特定的镇民组合，");
    g_artLine[407] = StringToText("打造出他们3个人面临着一大群恶魔的独特体验？去吧。它可能不成立……但它也可能会非常出色！");
    g_artLine[408] = StringToText("创建自己的剧本是一门艺术，第一次可能并不理想。但是，只要通过一些小小的尝试和错误，");
    g_artLine[409] = StringToText("你就可以制作具有原创策略的原创游戏，供玩家探索。");
    g_artLine[410] = StringToText("有时，只要加入一个特别强大的角色本身就可以改变游戏的性质。例如，利维坦将游戏变为一个漫长、");
    g_artLine[411] = StringToText("深思熟虑、逻辑性很强，但没有玩家死亡的游戏，而暴乱创造的游戏就像一场喧嚣的大屠杀，全是仓促、");
    g_artLine[412] = StringToText("糟糕、一经做出就立即后悔的决定。红唇女郎为邪恶团队的虚张声势创造了一个更轻松、更安全的环境，");
    g_artLine[413] = StringToText("而镜像双子则让人压力山大。女巫或侍臣可以制造一种纠结而保守的气氛，而造谣者、");
    g_artLine[414] = StringToText("博学者或小精灵倾向于引发讨论和点子的自由交流。一旦你熟悉了运行黯月初升和梦殒春宵（请注意……");
    g_artLine[415] = StringToText("它们对说书人来说也更具挑战性！），尝试使用脚本工具看看什么最适合你和你的团队。");
    g_artLine[416] = StringToText("每个官方剧本都经过精心设计，尽可能提供最具互动性和趣味性的体验，因此我衷心建议你在创建自己的");
    g_artLine[417] = StringToText("游戏之前先熟悉《暗流涌动》、《黯月初升》和《梦殒春宵》的来龙去脉。");
    g_artLine[418] = StringToText("【再次回到暗流涌动...】");
    g_artLine[419] = StringToText("暗流涌动引入了许多在以后的剧本中更深入探讨的概念。它就是其他剧本的最佳教程。");
    g_artLine[420] = StringToText("你玩的暗流涌动越多，围绕醉酒和中毒概念的心流就越会成为一种本能，你就越习惯于游戏的一些基本策");
    g_artLine[421] = StringToText("略，例如分享信息，不仅要弄清楚谁是好人谁是邪恶的，还有哪些角色在发挥作用，");
    g_artLine[422] = StringToText("以及如何利用能力来发挥自己的优势。暗流涌动采用了社交推理游戏的基本概念——说谎，");
    g_artLine[423] = StringToText("并找出谁在说谎，并在此之上又添加了一大堆误导、假信息和策略。但在本质上，");
    g_artLine[424] = StringToText("暗流涌动的体验仍然很像Mafia（杀人游戏，一种与狼人杀类似的早期社交推理游戏，译者注）。");
    g_artLine[425] = StringToText("节奏很相似，你甚至会发现一些熟悉的风格的角色。");
    g_artLine[426] = StringToText("其他剧本要求玩家围绕非常不同的问题和非常不同的体验进行探索。策略不同，信息不同，");
    g_artLine[427] = StringToText("甚至目标也不同。你当然可以在不先玩暗流涌动的情况下以玩家身份跳关到黯月初升或梦殒春宵，");
    g_artLine[428] = StringToText("但学习曲线会更陡峭。如果你的队里只有一个新玩家，我不建议全体玩暗流涌动来便于「让新玩家理解」，");
    g_artLine[429] = StringToText("因为老玩家仍然会更快地建立连接并超过初学者。相反，我建议使用革命者，");
    g_artLine[430] = StringToText("这样新玩家可以与老手组队并在他们玩的时候学习。");
    g_artLine[431] = StringToText("不过，对于说书人来说，首先要熟悉暗流涌动是必须的——其他剧本鼓励甚至必须要求说书人的创造力，");
    g_artLine[432] = StringToText("为此你需要对事物的运作方式有一个坚实的基础。");
    g_artLine[433] = StringToText("我原本以为暗流涌动对于普通玩家来说最多大约有十二个月的寿命。五年过去了，");
    g_artLine[434] = StringToText("新的策略和故事仍在不断涌现。我曾经体验过的一些最好的游戏是在过去的六个月里，");
    g_artLine[435] = StringToText("其他人也告诉我同样的故事。暗流涌动不要求复杂的谎言或洞察力，但它又肯定会给予高端的操作以正面");
    g_artLine[436] = StringToText("反馈。我知道我听起来像在王婆卖瓜，但是哈哈……暗流涌动确实至今仍然经常给我带来兴奋的体验，");
    g_artLine[437] = StringToText("以至于成为我这一周的高光亮点——不是因为游戏本身制造了这个体验，而是因为它提供了让玩家自己创");
    g_artLine[438] = StringToText("造这种体验的基石。");
    g_artLine[439] = StringToText("在暗流涌动中，知道某人是好是坏通常足以处理问题。而当你进入其他剧本时，你需要了解更多。不过，");
    g_artLine[440] = StringToText("我想最大的不同是游戏的方式。围观时，它们看起来很相似。但是玩起来，");
    g_artLine[441] = StringToText("暗流涌动感觉就像是在玩一场慢慢揭开凶手真面目的剧本杀。黯月初升感觉就像每个人都有一门点燃的大");
    g_artLine[442] = StringToText("炮和一个大盾牌，慢慢决定将他们指向哪里；梦殒春宵感觉就像有人把达芬奇笔记本所有丢失的页面都放");
    g_artLine[443] = StringToText("在一个装有《远方》漫画的袋子里，而你要一张一张地把它们取出来，不知道哪个是哪个。");
    g_artLine[444] = StringToText("无论你是坚持熟悉节奏的暗流涌动，还是进入更深、更黑暗的进阶剧本，我希望你能像我一样喜欢《染.");
    g_artLine[445] = StringToText("钟楼谜团》，并希望它对你的生活产生影响就像我一样。下一篇幕后文章将介绍如何构建自己的脚本……。");
    g_artLine[446] = StringToText("好玩的东西！");
    g_artLine[447] = StringToText("我希望通过对染.钟楼谜团背后的设计理念的了解，可以帮助你确定染.钟楼谜团是否适合你和你的团队。");
    g_artLine[448] = StringToText("如果是这样，我希望这些幕后文章能帮助你真正从游戏中有所收获——无论你是寻求策略和洞察力的玩家，");
    g_artLine[449] = StringToText("还是寻找为玩家设计更多乐趣的方法的说书人。");
    // 3 成为一个好说书人的经历（16 段 / 81 行）
    g_artAt[3] = 450;
    g_artN[3] = 81;
    g_artLine[450] = StringToText("（From Ben）");
    g_artLine[451] = StringToText("10天前，Steve找到我——用他那种特有的、似是而非的古怪方式——让我写一篇文章，");
    g_artLine[452] = StringToText("讲讲我是如何成为一个好的说书人的。说实话，我的第一反应是，我并不是一个好的说书人。");
    g_artLine[453] = StringToText("我能列举出一大堆说书人规则都比我掌握得更好。真的，你只要看过任何一期「NRB玩BOTC」的系");
    g_artLine[454] = StringToText("列视频下的评论，你就会知道，我只是「一个来自外太空的邪恶弱鸡蜥蜴人」，");
    g_artLine[455] = StringToText("来银河系目的是「偷走太阳」。");
    g_artLine[456] = StringToText("于是我接下来花了一周时间仔细琢磨思索，整理了这些年来我学到的各种实用小技巧。");
    g_artLine[457] = StringToText("我原本准备讲讲应该如何每天晚上反复检查魔典来避免遗漏。或者讨论讨论哪些特定的角色组合可以给邪");
    g_artLine[458] = StringToText("恶阵营的伪装留出巨大空间。然而我思考得越多，我越发意识到脑子里存了一堆的规则和技巧也并不能让");
    g_artLine[459] = StringToText("你变成一个好的说书人。所以，这才是我怎么变成一个「好」说书人的故事……");
    g_artLine[460] = StringToText("我最初认识染.钟楼谜团是2018年的夏天。那时候我还是一个初出茅庐的游戏新闻自由撰稿人，");
    g_artLine[461] = StringToText("同时还管理了英国德比市的一家桌游吧。在那里我们最喜欢干的一件事就是，在接近营业结束的时候，");
    g_artLine[462] = StringToText("邀请所有还在的客人一起，把门锁上，倒上几大杯啤酒，开始玩社交推理游戏。经典的比如说狼人杀，");
    g_artLine[463] = StringToText("阿瓦隆，甚至银河冲突都经常会在那些充满了啤酒和吹牛的快乐夜晚里出现。");
    g_artLine[464] = StringToText("当桌游吧的老板宣布我们将要去参加英国游戏展（UKGE）的时候，我准备去看看有什么炫酷的玩意儿，");
    g_artLine[465] = StringToText("然后我就在UKGE的官网上看到了那个视频。我整个人都震惊了。一款社交推理游戏，类似于狼人杀，");
    g_artLine[466] = StringToText("但是没有淘汰机制，而且坏人还能让好人得到的信息出错。看到这个视频的一瞬间我感觉我大脑里好像有");
    g_artLine[467] = StringToText("什么开关被触发了，紧接着我开始想有这样一套明显更高级的机制的存在，我怎么还回得去享受狼人杀。");
    g_artLine[468] = StringToText("「这恐怕得超级不平衡吧」我当时暗中想到，「这样一个游戏不可能在没有淘汰机制的情况下运行起来」。");
    g_artLine[469] = StringToText("于是我们就来到UKGE，我立马冲向这个染.钟楼谜团所在的角落里的小摊位。");
    g_artLine[470] = StringToText("摊位后面坐着两个澳大利亚人，后来我得知这两个就是Evin和Sarah。");
    g_artLine[471] = StringToText("我立刻开始向他们滔滔不绝地表达我对这个超酷的游戏的热爱和我有多迫不及待想试一试了。");
    g_artLine[472] = StringToText("我那时心情激动，根本没有想过这可能是一个完全由游戏制作新人团队出品的，");
    g_artLine[473] = StringToText("非常非常小甚至完全还未发布的独立游戏。我只以为是我偶然得知的一个已经非常成熟的完成作品。");
    g_artLine[474] = StringToText("自然地，当我开始疯狂膜拜他们的时候，他们显然完全惊呆了甚至可能有点害怕！然后，");
    g_artLine[475] = StringToText("我那一周不停地回到那个展位，一次又一次地参加每一场游戏。在展会结束的时候，我整个人都成了信徒，");
    g_artLine[476] = StringToText("并且开始询问是否能够以某种方式参与到这个游戏团队中。他们对于我的狂热非常的开心并且提出要送我");
    g_artLine[477] = StringToText("一本样品。从这开始，我从一个胖乎乎毛茸茸的书呆子变成了一个胖乎乎毛茸茸的书呆子说书人。");
    g_artLine[478] = StringToText("在接下来的几个月里我主持了很多场游戏，多数在我们的桌游吧里。很快我就意识到我显然不能像对待狼");
    g_artLine[479] = StringToText("人杀那样处理染.钟楼谜团。我是指，我不能只是简单的做个脱离玩家活动的裁判或者法官之类的。");
    g_artLine[480] = StringToText("因为这个游戏需要GM的输出和机制决策。这个游戏不能像一个团队竞赛或者竞争类桌游那样运行，");
    g_artLine[481] = StringToText("它需要创造一种叙述性的、角色扮演性的体验，");
    g_artLine[482] = StringToText("那时候基本每周都是同一批人在玩，于是我开始几乎完全专注于团队的社交活跃度上。在宣布死亡的时候，");
    g_artLine[483] = StringToText("我不会简单地说「Lydia今晚死了」。我会说类似于「你们听到可能都会震惊但是Lydia有可能");
    g_artLine[484] = StringToText("这个月第一次的真的不在邪恶阵营里，因为她晚上居然死翘翘了。」 我在说话的时候可能会像个白痴一");
    g_artLine[485] = StringToText("样手舞足蹈四处扑腾，一会儿提高一会儿降低音调来笨拙地尝试戏剧性的表达。你猜怎么着？");
    g_artLine[486] = StringToText("所有人都玩得很开心……甚至在某局游戏本身因为我粗心大意又搞砸了的时候也是如此。我开始意识到，");
    g_artLine[487] = StringToText("不同于我主持的任何其他游戏，染的角色扮演体验不是来自于扮演游戏给你赋予的那个角色，");
    g_artLine[488] = StringToText("而是来自于扮演整车人的意识里给你赋予的那个人设。「永远邪恶的Lydia」，");
    g_artLine[489] = StringToText("并非出于她自己的选择，成了车上的那个「天才邪恶狂徒」。当她在晚上死掉的时候，");
    g_artLine[490] = StringToText("整车人都感觉像是听到达斯维达说出「我就是你父亲」或者得知奈德斯塔克被处决的时候，震惊了。");
    g_artLine[491] = StringToText("我经常问我自己为什么这一堆人永远有那么多乐趣，尤其是在如此多的其他社交推理游戏名声狼藉不受欢");
    g_artLine[492] = StringToText("迎的时候。我想最终是因为我的玩家们在同等的享受游戏和朋友们的陪伴本身。他们在彼此眼中生动鲜活，");
    g_artLine[493] = StringToText("这意味着，不管游戏本身好坏，他们都会享受这段时光。就好像你周末出去玩，你不是只是去喝啤酒的，");
    g_artLine[494] = StringToText("你也不是只是去酒吧里听音乐的，你也不是专门就去那里和朋友说话的。你享受的是所有这些事情的组合。");
    g_artLine[495] = StringToText("因此即使唱歌的跑了调，啤酒像马尿，你依然能开怀大笑。");
    g_artLine[496] = StringToText("在2019年的4月，染经历了一场堪称疯狂的众筹活动——达成了几乎1000%的众筹目标。");
    g_artLine[497] = StringToText("我感到我能不仅仅是做一个狂热粉丝，所以我和Steve说想成为这个团队更永久性的成员之一。");
    g_artLine[498] = StringToText("我当真被欢迎进了团队，然后开始在展会和活动上主持游戏。");
    g_artLine[499] = StringToText("当你的玩家们全都互相认识的时候很容易保障他们都玩的开心。但是当在活动上的时候你面前9个全是陌");
    g_artLine[500] = StringToText("生人。每个人对于怎样算是一场有趣的游戏都有不同的看法，可能每个人都对于喜欢的社交推理游戏有着");
    g_artLine[501] = StringToText("截然不同的期待。然而你得无论如何确保他们都享受乐趣的同时不会互相指责对方是个骗子。");
    g_artLine[502] = StringToText("我认为不是所有人都能完全理解在活动上做一个主持人有多难。");
    g_artLine[503] = StringToText("所以我就应用了我在和朋友们一起玩的时候所学到的。这些人都不是固定熟人车，了解对方的人设和性格。");
    g_artLine[504] = StringToText("于是我就决定在游戏过程中带领他们进入那种状态。「大家早上好」，我会指着穿着金属乐队T恤的Da");
    g_artLine[505] = StringToText("ve说。「恐怕现在我们知道丧钟为谁而鸣了。看起来不是昨晚去找了Dave的沙人！");
    g_artLine[506] = StringToText("」（金属乐队Metallica是殿堂级的元祖重金属乐队，与麦加帝斯、超级杀手、炭疽合称四大鞭。");
    g_artLine[507] = StringToText("丧钟为谁而鸣是他们最著名的作品之一，名字来源于海明威的同名小说。而他们另一首著名作品Ente");
    g_artLine[508] = StringToText("r Sandman沙人来了，描绘了一个小朋友噩梦中出现的，夜晚去将他抓走的沙人的情景。译者注）");
    g_artLine[509] = StringToText("这听起来像是个高估了自己喜剧天赋的马戏团小丑的垃圾金属乐队梗，嗯自信点这就是（哈哈）。");
    g_artLine[510] = StringToText("但这有一个重要目的。对于我的其他游戏参与者来说，Dave不再是一个正好和他们一起参加游戏的陌");
    g_artLine[511] = StringToText("生人而已了。他成为了Dave，一个重金属爱好者，他的死让我们所有人哈哈大笑。");
    g_artLine[512] = StringToText("而对于Dave——倒霉的第一晚就死了——一般来说一个不够大度的人可能已经很沮丧了。");
    g_artLine[513] = StringToText("他却把他的死和一个玩笑关联起来，同时还关联着所有人的微笑和GM告诉他他挺喜欢鞭击金属这些事。");
    g_artLine[514] = StringToText("在那场游戏和更多场其他游戏里我确保自己在和玩家说话时，我不是在说魔典背后的机制上发生了什么，");
    g_artLine[515] = StringToText("而是在城镇广场上实实在在地发生了什么。我会赞扬他们的热闹喧哗，或者慷慨激昂的指证，");
    g_artLine[516] = StringToText("或者逻辑清晰的辩护。我会时不时的把玩家随机拉到一边问问他们是否享受游戏，");
    g_artLine[517] = StringToText("或者他们对于谁是恶魔有没有个想法了。说穿了，我把劲使在让他们知道我很享受游戏并且希望他们同样");
    g_artLine[518] = StringToText("享受游戏上。在我玩乐队去巡回演出的时候，我就知道在99%的情况下，如果乐队明显玩嗨了的时候，");
    g_artLine[519] = StringToText("观众也会嗨。我曾见识过几乎是勉强会演奏乐器的乐队，彻底的俘获了观众，");
    g_artLine[520] = StringToText("完全是因为他们肉眼可见的燥起来了。我也见到过绝对的大师在舞台上尬住的情况，");
    g_artLine[521] = StringToText("因为他们显然就是对自己在做的事情不走心。");
    g_artLine[522] = StringToText("好的说书的精华就在其中，至少是我的版本的精华。不是关于熟悉规则——尽管那当然非常有帮助。");
    g_artLine[523] = StringToText("好的说书的关键材料就在说书人角色的名字里。穿针引线，让你的玩家在你和其他玩家身上投入情感。");
    g_artLine[524] = StringToText("你如何达到这个效果并不重要，你终会找到最适合你自己的方式。我的好朋友Edd，比如说，");
    g_artLine[525] = StringToText("建了一个Spotify歌单，里面全是和游戏相关的曲目，比如Alice Cooper的「投毒」，");
    g_artLine[526] = StringToText("Iron Maiden的「月之子」。他用这个来掩盖他晚上移动时发出的声音。");
    g_artLine[527] = StringToText("每当我闭上眼听到一些俗气又和染特别切题的歌曲响起，我就会想起这个家伙玩染的时候有多么开心，");
    g_artLine[528] = StringToText("甚至为了仅仅一场游戏用90秒的BGM坐下来做了整整一百首歌的歌单。");
    g_artLine[529] = StringToText("所以，玩开心，享受你的玩家，而最重要的是，不要担忧。如果你自己玩的开心，他们也玩的开心，");
    g_artLine[530] = StringToText("那你就做得很好！");
    // 4 创作幕后——逻辑一片混乱？（29 段 / 116 行）
    g_artAt[4] = 531;
    g_artN[4] = 116;
    g_artLine[531] = StringToText("From Steven Medway 注：原文发表于2019年4月13日");
    g_artLine[532] = StringToText("大家好！我是Evin,给大家带来染.钟楼谜团的官方博客。染的Kickstarter众筹活动开");
    g_artLine[533] = StringToText("始得可以说相当狂野——我们在16小时内就达成了众筹目标，并且获得了Shut Up & Sit");
    g_artLine[534] = StringToText(" Down有史以来最高的评价，经历了一场热闹的众筹活动所能经历的全部高潮（达成目标！");
    g_artLine[535] = StringToText("解锁额外奖励！获得各种狂热的支持！）和低谷（睡觉……我的天，太久没睡了） 。");
    g_artLine[536] = StringToText("不过在这篇帖子里没我什么事。我将把键盘交给Steven Medway，染.钟楼谜团的设计师，");
    g_artLine[537] = StringToText("他将会给大家带来一系列的文章，来讲述这个游戏设计过程中的各种选择和制作过程。");
    g_artLine[538] = StringToText("我们把这个系列命名为帷幕之后。");
    g_artLine[539] = StringToText("染是一个非常有趣的游戏，但是它为什么有趣并不是所有人都明白，甚至对于那些已经染了几百场的玩家");
    g_artLine[540] = StringToText("（包括我自己）来说也是如此。在这一系列的深度文章中，Steven将会带我们看看「帷幕之后」，");
    g_artLine[541] = StringToText("也就是说，游戏设计的理念，灵感和各种幕后工作。");
    g_artLine[542] = StringToText("这第一篇帖子将会回答一个问题：「如果说书人可以对玩家说谎，那这有和纯瞎猜有什么区别？");
    g_artLine[543] = StringToText("这有什么好玩的？」在未来的帖子里我们将会回答其他的问题比如说狼人杀（我们有什么相同点，");
    g_artLine[544] = StringToText("有什么不同？）；外来者在游戏中的作用（为什么会有些角色的能力是给团队带来副作用？）；等等。");
    g_artLine[545] = StringToText("那我就不废话了，把键盘交给Steven。");
    g_artLine[546] = StringToText("逻辑一片混乱？也许有点……");
    g_artLine[547] = StringToText("如果你在一局染的游戏里是好人阵营，一个不可避免的问题是：我们有什么信息可用？这个信息是真的吗？");
    g_artLine[548] = StringToText("说书人在骗我吗？我们怎么知道这点？");
    g_artLine[549] = StringToText("在任何一局染的游戏里，好人都有一大堆信息可以用来获胜。一些镇民被动的获得信息——他们每晚都醒");
    g_artLine[550] = StringToText("来，得知比如恶魔今天是否投票了，或者他身边有几个邪恶玩家。另一些镇民因为他们的能力而得知信息");
    g_artLine[551] = StringToText("——比如贞洁者知道提名他的人是否是镇民，送葬者得知今天被处决的玩家的角色，");
    g_artLine[552] = StringToText("或者猎手知道他刚刚试图杀死的玩家是否是恶魔。");
    g_artLine[553] = StringToText("为了平衡这一点，游戏里有一些机制来防止坏人被瞬间找出来，比如中毒和醉酒。");
    g_artLine[554] = StringToText("如果一个玩家中毒或者醉酒了，他们可能获得错误信息，他们暂时的失去了能力——但说书人会假装他们");
    g_artLine[555] = StringToText("还有能力。比如说，一个醉酒的共情者每晚还是会醒来，然后得到可能错误的信息。");
    g_artLine[556] = StringToText("一个醉酒的贞洁者无法导致提名他的镇民被处决。");
    g_artLine[557] = StringToText("好人阵营并不能通过简单地把一系列的事实凑到一起，然后就解决谜题，得知谁是坏人的原因，");
    g_artLine[558] = StringToText("是因为如果他们总是能如此的话，那么一个足够聪明和团结的好人团队几乎可以赢下所有游戏。");
    g_artLine[559] = StringToText("而对于一个邪恶方玩家来说，被人100%确定为邪恶并不好玩。相反，好人团队要想赢，");
    g_artLine[560] = StringToText("就得在提名处决时做出明智的判断并且积极且机智地使用他们的能力。邪恶团队则可以使用他们的能力来");
    g_artLine[561] = StringToText("精确又谨慎地给善良团队制造错误信息，并且根据局势情况来精心制造谎言，");
    g_artLine[562] = StringToText("从而扰乱善良团队的逻辑推理。");
    g_artLine[563] = StringToText("邪恶团队对虚假信息的利用对于他们的生存来说至关重要。甚至说书人在一定情况下都可能会给善良阵营");
    g_artLine[564] = StringToText("一些错误信息。说书人并不能随心所欲的欺骗玩家，也不能破坏游戏规则——除非某个角色的能力允许他");
    g_artLine[565] = StringToText("这样做。当一个玩家中毒或者醉酒时，是由说书人来决定给玩家哪种扰乱信息，");
    g_artLine[566] = StringToText("而玩家并不会知道自己是否得到了错误的信息——这就是关键。");
    g_artLine[567] = StringToText("这就创造出一种局面，在任何一场游戏里，善良玩家多数情况下可以信任他们大多数的信息……但是他们");
    g_artLine[568] = StringToText("得把他们的理论付诸验证来看是否正确。然而，由于中毒和醉酒（或者其他导致虚假信息的方式）");
    g_artLine[569] = StringToText("的情况并不常见，这意味着两件事：");
    g_artLine[570] = StringToText("（1）好人阵营可以相信他们绝大多数的信息是真实的。所有信息都是错的是不可能的，");
    g_artLine[571] = StringToText("绝大多数信息都是错的也是不可能呢的。但有可能其中一个（有时候两三个）信息是假的。所以，");
    g_artLine[572] = StringToText("默认的一种情况——相信你的信息是对的——是可行的策略。（除非涡流在场，那是另一个话题，");
    g_artLine[573] = StringToText("我们一会儿会提到）");
    g_artLine[574] = StringToText("（2）如果你，作为一个玩家，能够意识到你的信息事实上是错误的，那么这其实对于你的队伍来说是个");
    g_artLine[575] = StringToText("巨大优势。如果你知道（或者认为你知道）你的信息是错误的，一般来说你也就知道了为什么你的信息是");
    g_artLine[576] = StringToText("错的，因为可以造成这种状况的情形并不多。一旦你知道了为什么你的信息是错的，");
    g_artLine[577] = StringToText("你就可以基于这个做出进一步的推论。比如，如果善良队伍确定了男爵在场，");
    g_artLine[578] = StringToText("并且男爵给游戏添加了一名酒鬼——每位善良玩家都能确定他们中有一人会是酒鬼。");
    g_artLine[579] = StringToText("如果你能知道你就是那个酒鬼（通过推理你的信息是错误的），那么你就可以进一步确认其他人不会是酒");
    g_artLine[580] = StringToText("鬼（因此你就可以信任他们所有人的信息），并且确认男爵确实在场。那么……那个声称自己是送葬者还");
    g_artLine[581] = StringToText("说自己挖到了被处决的间谍的玩家就肯定在撒谎了。因为这种情况下男爵和间谍无法同时在场。");
    g_artLine[582] = StringToText("无论是什么情况，确知你的信息是错误的本身实际上也都给了你可以利用的信息。");
    g_artLine[583] = StringToText("这一切都意味着「我的信息是真的吗？」并不是最有价值的问题。明智的做法是假设它是真的，");
    g_artLine[584] = StringToText("除非你有理由去怀疑它。更有价值的问题是「如果我的信息是真的，那么我应该怎么做？");
    g_artLine[585] = StringToText("」因为那也意味着你同时在思考「如果我的信息是假的，为什么是假的？」");
    g_artLine[586] = StringToText("染的设计包含了一些常见的逻辑推理要素。你可以使用这些推理来使你得到的无论什么信息都发挥作用，");
    g_artLine[587] = StringToText("比如：");
    g_artLine[588] = StringToText("（1）如果A那么B");
    g_artLine[589] = StringToText("你在染中获得的大多数信息都不是确定的。但是你可以知道如果它是真的，那么另一件事也必须是真的。");
    g_artLine[590] = StringToText("举个例子，如果你是卖花女孩，你得知恶魔昨天投票了，你没法确认他投了，");
    g_artLine[591] = StringToText("因为有些恶魔会搞乱你的信息。所以你没法得知恶魔是否真的投了。但是你的确可以知道的是，");
    g_artLine[592] = StringToText("如果恶魔确实投了票，那么这个恶魔不会是涡流（因为涡流会让所有信息变成错误的）。");
    g_artLine[593] = StringToText("同时如果恶魔昨天投了票，那么恶魔不会是坐在你身边的诺-达鯴（因为诺-达鯴会让他的邻居中毒）。");
    g_artLine[594] = StringToText("所以，不是说你就只能消极游戏或者祈祷你的信息是真的了，而是利用这个信息去推测还有什么可能也是");
    g_artLine[595] = StringToText("对的。");
    g_artLine[596] = StringToText("（2）如果B那么C那么D……");
    g_artLine[597] = StringToText("一模一样的流程，但是通过B和C把你从A带到了D。举个例子，如果你是卖花女孩，");
    g_artLine[598] = StringToText("然后得知昨天恶魔投票了，并且昨天所有玩家都投票了，同时筑梦师声称他的信息是错的。");
    g_artLine[599] = StringToText("那么这个筑梦师在撒谎，因为你知道涡流不可能在场。（有点复杂但是你懂这个意思就行了。）");
    g_artLine[600] = StringToText("基本是来说，只要你确认了一件事，那么你同样也就确认了一大堆事。");
    g_artLine[601] = StringToText("（3）如果B不对那么A也不对");
    g_artLine[602] = StringToText("当你检查了你的信息，并且从逻辑上推演了它引导向何方，那么你经常会发现得出的结论毫无道理。");
    g_artLine[603] = StringToText("这就是所谓的「归谬法」——一种逻辑上的不一致。如果你的信息是真的，");
    g_artLine[604] = StringToText("然后你顺着往下捋——不管走了多远——结果发现出现了谬误，那么你就会知道你的初始前提是错误的。");
    g_artLine[605] = StringToText("当然当你知道它错了的时候，你往往也会知道它为什么会错……这非常有用。比如说，你是送葬者，");
    g_artLine[606] = StringToText("你得知小恶魔刚刚被处决了。逻辑上来说这只能意味着有红唇女郎在场，并且已经变成了恶魔。然而，");
    g_artLine[607] = StringToText("因为这场游戏只有一个爪牙，并且调查员说两个玩家之一是男爵，并且已经有两个玩家声称是外来者，");
    g_artLine[608] = StringToText("这局本不应该有2个外来者，否则数量不对了。那么你的爪牙是男爵和红唇女郎在场的信息产生了悖论。");
    g_artLine[609] = StringToText("所以，你的信息是真的这个假设错了。怎么使用这个信息取决于你，你可以去和调查员聊聊，");
    g_artLine[610] = StringToText("也许他只是个谎称自己是调查员的好人玩家，也许你可以怀疑自称外来者的玩家在撒谎把他们处决了，");
    g_artLine[611] = StringToText("或者你让所有人知道你就是那个酒鬼……这是个大好消息！确定你自己是酒鬼就意味着他们不会是酒鬼，");
    g_artLine[612] = StringToText("那么谁的信息听起来不对劲谁就是在撒谎！嫌疑人的池子缩小了。");
    g_artLine[613] = StringToText("（4）要么A要么B");
    g_artLine[614] = StringToText("这个概念和很多染的角色都很搭。你得知要么A是真的要么B是真的。同样的，你没法确定其中一项，");
    g_artLine[615] = StringToText("但是足以让你开始分享和推理了。这类信息是专门设计来防止有人100%确认地指证说「我确定你是坏");
    g_artLine[616] = StringToText("人」的，这对新人玩家来说体验很差。相应的我选择使用「我知道你们两个中有人是坏的但是我不确定是");
    g_artLine[617] = StringToText("谁」这种信息，因为这样拥有这个信息的玩家会很有乐趣——他得解决一个谜题，");
    g_artLine[618] = StringToText("同时对于被指证为坏人的玩家也很有乐趣——因为他永远都会有借口！他们可以说「我相信你说的我和D");
    g_artLine[619] = StringToText("ave中的一个人是坏的，因为我相信Dave确实是坏人！」很多角色有这类型的信息。所以，");
    g_artLine[620] = StringToText("「没有什么信息是确定的」并不意味着「我们什么信息也没有。」比如说，");
    g_artLine[621] = StringToText("图书管理员可能会得知两个玩家之一是酒鬼。博学者每天得到两条信息，一真一假。");
    g_artLine[622] = StringToText("当你把以上所有逻辑放到一起，你就会得到一个复杂但有趣的逻辑交互系统，");
    g_artLine[623] = StringToText("它会随着玩家逐渐揭露更多的信息而变动。这也意味着撒谎远不是简单的使用肢体语言和社交技巧——你");
    g_artLine[624] = StringToText("需要精心的把你的谎言嵌入进已经给出的信息里，并且利用好善良玩家可能会发生的逻辑跳跃。比如说，");
    g_artLine[625] = StringToText("你是恶魔，而善良玩家错误的以为有陌客在场，你会伪装成陌客吗？还是伪装成知道谁是陌客的图书管理");
    g_artLine[626] = StringToText("员并且暗示你的一个爪牙来跳陌客？又或者干脆伪装成另一个角色来完全驳斥他们「陌客在场」这一错误");
    g_artLine[627] = StringToText("信息以此来让自己显得更可信，因为你可以想象最终他们一定会反应过来以为陌客在场是个错误？");
    g_artLine[628] = StringToText("也许你会伪装陌客，但是计划一会儿就变为伪装猎手，这样让猎手的伪装显得更可信？你得审时度势。");
    g_artLine[629] = StringToText("这完全取决于善良团队完全确认了什么信息，完全弄错了什么信息，以及很快将会得出什么结论。");
    g_artLine[630] = StringToText("你的谎言可能会变得远比你的角色能力重要。");
    g_artLine[631] = StringToText("如果玩家是新手，全程不说话，不分享信息，那么场面可能确实是「逻辑混乱」的。相应的，");
    g_artLine[632] = StringToText("如果邪恶方玩家完全掌控了游戏局面，把他们脑子里塞满了大师级的精心编制的谎言，");
    g_artLine[633] = StringToText("场面也可能看起来是「逻辑混乱」的。但是，只要有那么一两个善良方玩家脑子在线，");
    g_artLine[634] = StringToText("并且愿意把他们的信息拼凑起来，并且也鼓励其他玩家这么做……那邪恶方就麻烦了。在多数的游戏里，");
    g_artLine[635] = StringToText("善良队伍要么在最后一天前点出来（有较高的确定性地）一两个玩家是恶魔……要么确定了足够多的善良");
    g_artLine[636] = StringToText("玩家的身份，这样只剩下少数的几个玩家有嫌疑，而他们还刚刚好有足够的时间来把他们轮流处决掉。");
    g_artLine[637] = StringToText("我喜欢解密和社交类游戏，我希望你也喜欢。在这两种类型的游戏碰撞交融在一起的时候设定难度是一个");
    g_artLine[638] = StringToText("巨大的挑战。对于部分人来说，这游戏可能太让人迷惑了。对于一些人来说，可能又太简单了。");
    g_artLine[639] = StringToText("而对于另一部分人来说，这可能正是他们的菜。对于说书人来说快乐就在于给你的玩家精心制造一局恰好");
    g_artLine[640] = StringToText("适合他们水平难度的游戏——无论是在游戏开始前还是在游戏中。对于邪恶玩家来说乐趣在于巧妙编制完");
    g_artLine[641] = StringToText("美的谎言来牵着善良玩家的鼻子走，让他们彻底走偏。而对于善良玩家来说，");
    g_artLine[642] = StringToText("乐趣在于穿透混乱逻辑的迷雾，在可能性的大海中捞出代表真相的针，在于分辨事实与谎言，");
    g_artLine[643] = StringToText("并构建起一个信任你逻辑的团队。");
    g_artLine[644] = StringToText("我希望对于染.钟楼谜团的设计理念的深入探讨能够帮助你确定这是否是一个适合你和你朋友的游戏。");
    g_artLine[645] = StringToText("如果是的话，我希望这一系列的「帷幕之后」文章能够帮助你充分地享受这个游戏——无论你是一个在寻");
    g_artLine[646] = StringToText("找策略和洞察的玩家，还是一个希望给玩家创造更多欢乐的说书人。");
    // 5 染·钟楼谜团是一款策略游戏（47 段 / 128 行）
    g_artAt[5] = 647;
    g_artN[5] = 128;
    g_artLine[647] = StringToText("在染.钟楼谜团中，好人可能因为各种原因接收到错误的信息。玩游戏时最常听到的一个抱怨就是：");
    g_artLine[648] = StringToText("「...我可能是醉酒了或者被毒了。」");
    g_artLine[649] = StringToText("这种由好人提供的错误信息在社交推理游戏中是非常反常的，打破了许多人对于社交推理游戏的一个基本");
    g_artLine[650] = StringToText("认知：提供错误信息的玩家一定得是坏人（或者是卧底、是莫德雷德的爪牙、是狼人之类的）。");
    g_artLine[651] = StringToText("在许多其他游戏中，识别错误信息对于确定谁是坏人至关重要。好人队伍拥有的任何信息都应该直接用于");
    g_artLine[652] = StringToText("确定谁是坏人。");
    g_artLine[653] = StringToText("因此，这引出了一个非常自然的问题：如果作为好人，我的信息根本不可靠，");
    g_artLine[654] = StringToText("我要如何利用信息来赢得游戏？或者说得直接点，有人评论说：这游戏根本就没有办法使用得到的信息来");
    g_artLine[655] = StringToText("获胜，你甚至有可能根本就什么信息都没有。");
    g_artLine[656] = StringToText("嗨，我叫Andrew Nathenson，我已经玩了几百场染。我有一个关于染的策略的播客叫做");
    g_artLine[657] = StringToText("Cult of the Clocktower（钟楼密教）。我最近开始为染的出版公司The P");
    g_artLine[658] = StringToText("andemonium Institute志愿服务，我是他们的12位「传奇」说书人之一；基本上，");
    g_artLine[659] = StringToText("可以理解为游戏的传播大使。我是想说，我也许是怀着不那么客观的偏爱在评论这个游戏。");
    g_artLine[660] = StringToText("我非常喜欢这个游戏，并且和它有着超越玩家身份的联系。但是我也是世界上最有经验的游戏玩家之一，");
    g_artLine[661] = StringToText("花费了比任何正常人更多的时间来研究它。所以，我是基于所有以上的资历或者说身份来做出这样的论断：");
    g_artLine[662] = StringToText("染.钟楼谜团根本上是一款策略游戏，而不是社交推理游戏。");
    g_artLine[663] = StringToText("好吧，这可能有点夸张了。它当然也是一款社交推理游戏，但它的确有着绝大多数人，");
    g_artLine[664] = StringToText("包括很多和我一样热爱这个游戏的人都没意识到的策略深度。我希望在阅读这篇文章后，");
    g_artLine[665] = StringToText("您将看到比原先更多一些的策略可能性。");
    g_artLine[666] = StringToText("这篇文章是针对已经熟悉染.钟楼谜团的人编写的。我将假设您已经了解了我将提到的规则和术语。");
    g_artLine[667] = StringToText("【证据】");
    g_artLine[668] = StringToText("在分析游戏策略之前，我想先谈谈一些数据。这些数据只来自我的视角，是我对游戏中「发生了什么」的");
    g_artLine[669] = StringToText("记录，而不是像「谁赢了游戏」这样可以追溯的东西。尽管如此，我一直在积极地跟踪这些数据，");
    g_artLine[670] = StringToText("所以它比起纯感官认知还是稍微可靠一些。");
    g_artLine[671] = StringToText("我不确定我玩过多少次「染」（不算作为说书人），因为一开始我没有记录我的游戏次数。");
    g_artLine[672] = StringToText("我大多数时间都是当说书人，因为在我所在的几乎所有群里，我都是最有经验的玩家，");
    g_artLine[673] = StringToText("所以我并没有玩太多次。");
    g_artLine[674] = StringToText("假设我作为善良玩家玩了大约50场游戏——虽然我相信实际上的数量要比这个高得多。");
    g_artLine[675] = StringToText("准确地来说有3场游戏是我错误地认为一名好人是坏人，并且输掉了的（投票投了好人）。");
    g_artLine[676] = StringToText("那么，可以说我是玩好人阵营有94%的胜率吗？当然不是。在很多游戏中，我知道谁是恶魔，");
    g_artLine[677] = StringToText("但是其他人想要处决另一个人（比如我），所以我并没有成功说服大家去处决我想要的那个人。许多时候，");
    g_artLine[678] = StringToText("我成功地说服镇民去处决了我想要的那个人，但他们最后又被证明是爪牙。");
    g_artLine[679] = StringToText("我对谁是恶魔认知也经常是错误的，或者在游戏中场时还在犹豫，其他人根本不听我的却正确地处决了恶");
    g_artLine[680] = StringToText("魔。");
    g_artLine[681] = StringToText("我是想说，在约95%的游戏中，我都能够利用可用信息在游戏结束前推断出一个存活的邪恶角色，");
    g_artLine[682] = StringToText("就算如果我没能推断出来，其他镇民们也能推断出来。值得注意的是，「存活的邪恶角色」并不等同于恶");
    g_artLine[683] = StringToText("魔，但是如果我意外地处决了一个爪牙，我通常也不会感到太糟糕，我认为这个概率依然比多数人想象中");
    g_artLine[684] = StringToText("的上限还要高。我并不认为我在社交上特别擅长看人状态（事实上，我认为我经常很差劲），");
    g_artLine[685] = StringToText("在这个游戏中，我几乎完全不相信我的直觉，而是只能依赖我的推理。因此，我认为这些证据表明了，");
    g_artLine[686] = StringToText("只要你能够成功的引导所有人的处决方向，那么这个游戏对于你来说十分接近「必胜」了。");
    g_artLine[687] = StringToText("最后这句话非常重要。我之所以能知道谁是邪恶的，很大程度上是因为我能说服我的队友先处决我提出的");
    g_artLine[688] = StringToText("对象来验证我的猜想。并不是每个人都能拥有这样的奢侈，因为很难保证团队会听从你的意见。");
    g_artLine[689] = StringToText("但由于我对游戏非常了解，我可以提出非常好的论点来支持我想要的结果。");
    g_artLine[690] = StringToText("甚至如果我自己被处决可以给我更多机会来控制未来的处决方向的话，我通常会很乐意自己被处决。");
    g_artLine[691] = StringToText("这就是策略的开始。");
    g_artLine[692] = StringToText("【信息从何而来？】");
    g_artLine[693] = StringToText("想象一场暗流涌动的游戏，其中善良阵营由洗衣妇、厨师、僧侣、送葬者、");
    g_artLine[694] = StringToText("守鸦人和自认为是调查员的酒鬼组成。邪恶方是投毒者和小恶魔。洗衣妇得知厨师是两名玩家之一，");
    g_artLine[695] = StringToText("酒鬼调查员认为洗衣妇或送葬者是红唇女郎。");
    g_artLine[696] = StringToText("第一天，厨师宣布他就是厨师，邪恶的玩家0连坐。小恶魔自称镇长，投毒者自称士兵。");
    g_artLine[697] = StringToText("调查员也给出了信息（错误的），指向了洗衣妇和送葬者。送葬者和洗衣妇都暴露了自己的角色来保护自");
    g_artLine[698] = StringToText("己，玩家们决定处决洗衣妇，因为送葬者还有可能获得更多信息。");
    g_artLine[699] = StringToText("第二天晚上，送葬者中毒，并得知被处决的玩家（洗衣妇）是红唇女郎。第二天，送葬者也被处决了。");
    g_artLine[700] = StringToText("在游戏的剩余时间里，僧侣未能挽救任何人的生命，守鸦人被杀时中毒，导致他们得知小恶魔确实是镇长。");
    g_artLine[701] = StringToText("投毒者被处决，邪恶获胜。");
    g_artLine[702] = StringToText("这个例子是基于我说书的一次真实游戏，我对它进行了一些简化以减少玩家数量。");
    g_artLine[703] = StringToText("旁观这场游戏，或者作为一个好人玩家来玩这一场游戏，人们可能会认为好人队伍几乎拿到的信息全错，");
    g_artLine[704] = StringToText("根本没有机会获胜，这么想情有可原的。调查员、守鸦人和送葬者都得到了假信息。");
    g_artLine[705] = StringToText("厨师的信息单独看根本没用。洗衣妇可以确定大厨是好人，但反正厨师也是死在晚上的，那也没意义了。");
    g_artLine[706] = StringToText("所有的信息结合在一起，描绘了一个有红唇女郎的世界，那就没有投毒者，所以没有理由怀疑任何人中毒。");
    g_artLine[707] = StringToText("然而，这场游戏里充斥着好人方在战术和战略上的重大失误，直接导致了大部分错误信息的产生。");
    g_artLine[708] = StringToText("邪恶的团队只是很好地利用了它们。");
    g_artLine[709] = StringToText("送葬者过早暴露了自己的角色，让投毒者很容易瞄准他。守鸦人也是差不多一样；");
    g_artLine[710] = StringToText("游戏中的善良玩家把他们的角色暴露得过于明显，以至于投毒者简直都要毒不过来了。");
    g_artLine[711] = StringToText("洗衣妇没有与大厨建立起双向的信任，所以没有人为他站台来证明他不是红唇女郎。");
    g_artLine[712] = StringToText("如果他们被排除了红唇的嫌疑，镇上大概率会发生另一次处决，那么就有可能将投毒从游戏中移除，");
    g_artLine[713] = StringToText("或者至少有机会排除掉另一个小恶魔的嫌疑人。僧侣完全没有猜准恶魔的刀法。");
    g_artLine[714] = StringToText("如果这些错误中的任何一个得到纠正，那么在整个比赛过程中，好人队伍很可能会收到截然不同的信息。");
    g_artLine[715] = StringToText("所以是的，虽然以他们获得的信息来看根本赢不了，但是是他们自己的选择让他们收到了错误的信息。");
    g_artLine[716] = StringToText("（是的，投毒者有可能走运直接毒中了关键角色；但走运的几率大概是 25 场比赛中只有 1 场。");
    g_artLine[717] = StringToText("这种情况偶尔会发生，但不足以推翻更广泛的观点。）");
    g_artLine[718] = StringToText("整个案例复盘旨在回答这个问题：信息从何而来？显然，一些信息来自 说书人，");
    g_artLine[719] = StringToText("说书人的选择决定了玩家了解到哪些虚假信息。所有真实信息都来自角色能力。但是，");
    g_artLine[720] = StringToText("在整个游戏中决定了获得什么样的信息的最大因素之一是好人方的玩法：具体来说，他们选择处决谁，");
    g_artLine[721] = StringToText("他们选择把能力用给谁，以及他们选择如何公聊与私聊。");
    g_artLine[722] = StringToText("在上面提到这种游戏里，说「信息不足以让人获胜」是正确的，但很具有误导性。");
    g_artLine[723] = StringToText("这样的陈述意味着信息就是整个游戏，或者说信息至少是足以决定游戏的结果。然而不是。");
    g_artLine[724] = StringToText("游戏的核心内容很大程度上是在获取信息，而不仅仅利用已经存在的信息。");
    g_artLine[725] = StringToText("【到底什么是信息？】");
    g_artLine[726] = StringToText("到目前为止，我一直将「信息」视为说书人告诉玩家的一切。然而，玩家们可以从游戏中获得的信息远不");
    g_artLine[727] = StringToText("止这些。我将快速列出一些我个人认为非常重要的机制性信息，这些信息可以作为逻辑推理的基点，");
    g_artLine[728] = StringToText("并且无论醉酒/中毒/等等，这些信息都会出现在游戏中。");
    g_artLine[729] = StringToText("1. 投票和提名。虽然精明的邪恶玩家在投票和提名时会比较狡猾，比如互相投票，");
    g_artLine[730] = StringToText("但依然有些信息是你可以信赖和注意采集的。爪牙一定不会跟投决定性的一票导致他们的恶魔被处决（在");
    g_artLine[731] = StringToText("没有后手的情况下）。得票特别多的玩家，投他们的人当中多半有邪恶方玩家。");
    g_artLine[732] = StringToText("嘴里说的理论和自己投票方式相矛盾的玩家通常是邪恶的。沿着这些思路可以从投票中收集到很多信息。");
    g_artLine[733] = StringToText("2. 谁与谁交谈，何时交谈。例如，恶魔不太可能能够准确地伪装成送葬者，除非他与间谍有过接触，");
    g_artLine[734] = StringToText("或者玩家们过于开放的暴露了自己的角色。你可以通过隐藏角色和观察谁和谁私聊了来准确地推断出谁是");
    g_artLine[735] = StringToText("真正的送葬者。");
    g_artLine[736] = StringToText("3. 死亡和平安夜。黯月初升教会了我们晚上的死亡信息有多么重要。这个理论也可以应用于任何剧本。");
    g_artLine[737] = StringToText("观察谁死了会告诉你很多信息，平安夜同样如此。");
    g_artLine[738] = StringToText("4. 伪装和声明角色。邪恶玩家编造的虚假信息仍然是信息。分析它们并找出矛盾还是非常有用的。");
    g_artLine[739] = StringToText("许多玩邪恶阵营的技巧来自编造相当真实的虚假信息，这些信息可以推导出一个错误然而合理的世界。");
    g_artLine[740] = StringToText("没有经验的玩家很难做到这一点，因此游戏的一种高级技巧就是分析信息并抓住这些谎言。");
    g_artLine[741] = StringToText("现在，来到关于信息的最后一点：");
    g_artLine[742] = StringToText("所有好人玩家的信息都是真实的。永远。");
    g_artLine[743] = StringToText("什么？？不可能。刚刚案例里的调查员就得知两个玩家中一名玩家是红唇女郎，然而两者都不是。");
    g_artLine[744] = StringToText("好吧，是也不是。所有的好人总是会得到真实的信息，但前提是您知道如何解读它。");
    g_artLine[745] = StringToText("思考一下我们如何更有效地解读这些信息可能会有所帮助。例如，我们可以说调查员得知了如下信息：");
    g_artLine[746] = StringToText("「玩家 A 是红唇女郎或者玩家B是红唇女郎或者玩家 A 是陌客或者玩家 B 是陌客或者调查员");
    g_artLine[747] = StringToText("自己是酒鬼或者投毒者选中了自己。」");
    g_artLine[748] = StringToText("所以，说「我可能醉酒或者中毒了」确实是一种相当准确的信息传递方式，尽管看起来是废话。");
    g_artLine[749] = StringToText("此信息不太具体，但绝对是真实的。并且，通过结合许多这样的信息，以及游戏规则/事实，");
    g_artLine[750] = StringToText("例如「每晚只有一个玩家可以中毒」和「只有一个玩家是酒鬼」，您最终可以消除许多这样的可能性。");
    g_artLine[751] = StringToText("这个技巧的关键在于快速地思考，并且知道哪些可能性太小以至于可以排除。");
    g_artLine[752] = StringToText("这并不是说您总能理清所有的信息并且比如说找出谁是酒鬼。但我希望它能在某种程度上平息「任何信息");
    g_artLine[753] = StringToText("都可以任意为真或为假」的抱怨。我上面的逻辑陈述是调查员得知的信息的完整版本，");
    g_artLine[754] = StringToText("这种形式解读的信息永远是真的。");
    g_artLine[755] = StringToText("【处决顺序（最常见的错误）】");
    g_artLine[756] = StringToText("好人团队所能犯的最大错误之一就是在错误的时间选择错误的处决对象。就算你真的没办法猜出谁是恶魔，");
    g_artLine[757] = StringToText("你至少可以处决可能是恶魔的玩家，以最大限度地提高胜率。");
    g_artLine[758] = StringToText("我不打算在这里深入探讨——这是另一篇文章的主题——但我会尝试通过一个例子来阐明主要思想。");
    g_artLine[759] = StringToText("我看到一个非常常见的错误：在默认情况下有 2 个外来者的游戏中，陌客是唯一声称自己是外来者的");
    g_artLine[760] = StringToText("玩家。人们决定处决了这个陌客。这太可怕了，因为只要没有其他人声称自己是外来者，");
    g_artLine[761] = StringToText("陌客就被机制本身证明了一定是好人。你错过了消灭恶魔、投毒者等的机会。");
    g_artLine[762] = StringToText("类似的情况可能还有团队决定处决一名向「铁好人」（比如被提名时直接导致提名玩家被处决的贞洁者—");
    g_artLine[763] = StringToText("—译者注）证实了自己角色的洗衣妇（尽管间谍有时候也能玩出这个效果；如您所料，");
    g_artLine[764] = StringToText("有很多注意事项和例外情况）。");
    g_artLine[765] = StringToText("此外，尽量不要跳过处决阶段。处决是好人获胜的方式。很多的游戏最后变成抛硬币幸福二选一就是因为");
    g_artLine[766] = StringToText("在游戏早期跳过了一次处决。我因为相信一位镇长而输掉了一场比赛，这个镇长后来被证明是酒鬼，");
    g_artLine[767] = StringToText("但我觉得这是完全应得的，因为我们浪费了早期的一次处决，否则就只会有一个恶魔嫌疑人。无论如何，");
    g_artLine[768] = StringToText("关于游戏中的信息，我已经扯得有点远了，所以可能就写到这里为止刚好。");
    g_artLine[769] = StringToText("所有这一切的要点是：直接提供给你的信息并不能为你决定游戏的胜负，你玩游戏的方式才真正决定了你");
    g_artLine[770] = StringToText("能得到什么样的信息。");
    g_artLine[771] = StringToText("【最后一点。】");
    g_artLine[772] = StringToText("染是一款社交团队游戏。无论你在推理解谜方面做得多么好，有时都还是会输，");
    g_artLine[773] = StringToText("因为你无法说服你的团队相信你或你的逻辑；推理和沟通是两种截然不同的技能，");
    g_artLine[774] = StringToText("两者都是玩好一场游戏所必需的。");
    // 6 设计师总结的国内玩家对染的错误理解（21 段 / 24 行）
    g_artAt[6] = 775;
    g_artN[6] = 24;
    g_artLine[775] = StringToText("本文由设计师Steven整理提供，由小黑翻译。看看你中枪了几个？！");
    g_artLine[776] = StringToText("某些中国玩家错误地认为：");
    g_artLine[777] = StringToText("· 1.邪恶的旅行者可以在小恶魔自杀时变成小恶魔。");
    g_artLine[778] = StringToText("· 2.「疯狂」地证明自己是某个角色意味着「要像拿到了那个角色一样来进行游戏」。");
    g_artLine[779] = StringToText("· 3.占卜师的「干扰项」也会干扰其他玩家的信息能力。");
    g_artLine[780] = StringToText("· 4.镇长的「让他人代替他死亡」的能力在一局游戏中只能被触发一次。");
    g_artLine[781] = StringToText("· 5.只有士兵能成为代替镇长死亡的目标，且说书人需要询问士兵玩家是否愿意这么做。");
    g_artLine[782] = StringToText("· 6.陌客和间谍必须被当作与原本不同的角色和阵营，且一旦决定他们被当作什么了之后，");
    g_artLine[783] = StringToText("在这局游戏中就无法再次发生变化。");
    g_artLine[784] = StringToText("· 7.玩家可以通过杀死说书人或让说书人中毒来让其他玩家获得错误信息。");
    g_artLine[785] = StringToText("· 8.存活玩家的一票算两票，死亡玩家的一票算一票。");
    g_artLine[786] = StringToText("· 9.单个玩家在一整局游戏内只能发起一次提名，只能被提名一次，只能参与一次投票。（译注：");
    g_artLine[787] = StringToText("魔像狂喜）");
    g_artLine[788] = StringToText("· 10.每个白天必须要处决一名玩家。");
    g_artLine[789] = StringToText("· 11.能探查其他玩家的角色，其目标始终由玩家来进行选择。（例如由作为洗衣妇的玩家来选择要");
    g_artLine[790] = StringToText("查看哪两名玩家的镇民角色）");
    g_artLine[791] = StringToText("· 12.方古能在一局游戏中多次传染。");
    g_artLine[792] = StringToText("· 13.涡流只会让一名镇民玩家获得错误信息。");
    g_artLine[793] = StringToText("· 14.变成舞蛇人的恶魔必须按之前的伪装继续撒谎。");
    g_artLine[794] = StringToText("· 15.如果麻脸巫婆创造了一个新的恶魔，说书人必须要杀掉原本的恶魔。");
    g_artLine[795] = StringToText("· 16.被流放的旅行者无法获得投票标记。");
    g_artLine[796] = StringToText("· 17.如果守鸦人在死亡时醉酒或中毒，无法被唤醒，也不会获得任何信息。");
    g_artLine[797] = StringToText("· 18.中毒和醉酒的玩家不会在夜晚醒来。");
    g_artLine[798] = StringToText("· 19.所有恶魔都能通过自杀来让其他玩家变成恶魔。");
    // 7 疯狂规则如何运作？——疯狂的小精灵（27 段 / 91 行）
    g_artAt[7] = 799;
    g_artN[7] = 91;
    g_artLine[799] = StringToText("Ben：");
    g_artLine[800] = StringToText("你好Steve。希望你不介意我询问你一个小问题。");
    g_artLine[801] = StringToText("关于小精灵——他在什么时候获得能力？是在他的目标死亡的那一刻立即获得么？同样的，");
    g_artLine[802] = StringToText("如果小精灵在那个镇民快死的时候才疯狂地证明自己是那个角色，而在其他多数时间里都在证明自己是别");
    g_artLine[803] = StringToText("的角色，那么他还会获得那个镇民的能力吗？");
    g_artLine[804] = StringToText("Steve：");
    g_artLine[805] = StringToText("小精灵在游戏开始时会获得小精灵的能力。");
    g_artLine[806] = StringToText("疯狂证明自己是自己得知的那个在场镇民的小精灵会在对应玩家死亡后立即获得那个镇民角色的能力。");
    g_artLine[807] = StringToText("在这里，让我们假设说书人对小精灵展示的角色标记是贵族。");
    g_artLine[808] = StringToText("如果说书人认为小精灵玩家明显地向部分或所有玩家证明自己是贵族，说书人可以让小精灵获得贵族的能");
    g_artLine[809] = StringToText("力（译注：在贵族玩家死亡后）。由说书人来判断小精灵玩家是否「疯狂」。");
    g_artLine[810] = StringToText("如果小精灵玩家在一开始时疯狂地证明自己是贵族，但在接下来的两天里沉默，");
    g_artLine[811] = StringToText("说书人可以判定他疯狂地证明自己是贵族，并让他获得贵族的能力（译注：在贵族玩家死亡后，下同，");
    g_artLine[812] = StringToText("不再单独注明）。");
    g_artLine[813] = StringToText("如果小精灵玩家在一开始时疯狂地证明自己是贵族，然后改为声称自己是贤者，");
    g_artLine[814] = StringToText("然而所有玩家都认为小精灵实际上是贵族，说书人可以判定他疯狂地证明自己是贵族，");
    g_artLine[815] = StringToText("并让他获得贵族的能力。");
    g_artLine[816] = StringToText("如果小精灵玩家在一开始时疯狂地证明自己是贵族，然后改为声称自己是贤者，");
    g_artLine[817] = StringToText("并且所有玩家都认为小精灵实际上是贤者，说书人可以判定他并未疯狂地证明自己是贵族，");
    g_artLine[818] = StringToText("从而不让他获得贵族的能力。");
    g_artLine[819] = StringToText("如果小精灵玩家在一开始时疯狂地证明自己是贵族，然后改为声称自己是贤者，");
    g_artLine[820] = StringToText("然后又尝试向他人证明自己曾经被洗脑师洗脑过，自己真的是贵族。说书人可以判定他疯狂地证明自己是");
    g_artLine[821] = StringToText("贵族，并让他获得贵族的能力。");
    g_artLine[822] = StringToText("如果小精灵玩家在前两天一直沉默，但之后疯狂地证明自己是贵族，并为此前的沉默行为给出了非常可信");
    g_artLine[823] = StringToText("的理由，说书人可以判定他疯狂地证明自己是贵族，并让他获得贵族的能力。");
    g_artLine[824] = StringToText("如果小精灵玩家在前两天一直沉默，但之后疯狂地证明自己是贵族，却并未给出可信的理由，");
    g_artLine[825] = StringToText("或给出了可信的理由但并未表现出非常努力地想要说服别人，而只是像为了想要从说书人那里获得能力而");
    g_artLine[826] = StringToText("在干瘪地念白，说书人可以判定他并未疯狂地证明自己是贵族，从而不让他获得贵族的能力。");
    g_artLine[827] = StringToText("如果小精灵玩家在前五天里疯狂地证明自己是占卜师，但在贵族玩家将要被处决前赶紧改口，");
    g_artLine[828] = StringToText("说书人可以判定他并未疯狂地证明自己是贵族，从而不让他获得贵族的能力。");
    g_artLine[829] = StringToText("如果小精灵玩家在前五天里疯狂地证明自己是占卜师，然后说出自己其实是贵族，");
    g_artLine[830] = StringToText("并给出了为什么要谎称自己是占卜师的理由，给出了贵族的信息并引发了一系列讨论，");
    g_artLine[831] = StringToText("且其他玩家开始相信小精灵玩家是贵族并在游戏中开始运用这个错误的「贵族的信息」进行分析。");
    g_artLine[832] = StringToText("然后贵族玩家在那天被处决，说书人可以判定他疯狂地证明自己是贵族，并让他获得贵族的能力。");
    g_artLine[833] = StringToText("判断一名玩家是否疯狂的决定权在说书人手中。规则中没有硬性规定玩家哪些可以说，哪些不能说，");
    g_artLine[834] = StringToText("哪些必须得说，哪些一定不能说。每局游戏都可能会出现不同的情况。关键的是，");
    g_artLine[835] = StringToText("说书人认为这个小精灵玩家是否：表现得非常努力；或真诚地证明自己是贵族；");
    g_artLine[836] = StringToText("或让自己给出的贵族信息引发了讨论，人们认为他的信息值得被接受；或其他玩家单纯只是相信这名玩家；");
    g_artLine[837] = StringToText("或等等其他情况。");
    g_artLine[838] = StringToText("精准地去判断小精灵玩家是否疯狂，尤其是玩家的行为和语言是否符合疯狂这一行为并不是一件能够被精");
    g_artLine[839] = StringToText("确的状态和硬性的规则所能规定的。把判断是否疯狂当做判断是否幽默那样吧。怪咖（梦殒春宵的旅行者）");
    g_artLine[840] = StringToText("就是一个不错的例子。如果怪咖在某个白天一开始博得了笑声，但在那天快要结束时没有让气氛活跃，");
    g_artLine[841] = StringToText("说书人可以判断怪咖今天表现得比较搞笑。反之亦然，如果在某个白天快结束时博得了笑声，");
    g_artLine[842] = StringToText("但在开始时没有，说书人仍然可以判断怪咖今天表现得比较搞笑。如果怪咖在一天开始时让人发笑，");
    g_artLine[843] = StringToText("但随后变得恶俗并让大家的情绪开始低落，说书人可以判断怪咖今天表现得不够搞笑——是的，");
    g_artLine[844] = StringToText("他曾经搞笑过，但在说书人这里对他的总体评价是不合格。怪咖可能无法让人笑出声来，");
    g_artLine[845] = StringToText("但如果说书人认为怪咖很搞笑，那些其他玩家尝试不笑出声来只是为了想要流放怪咖（译注：");
    g_artLine[846] = StringToText("原文用的处决一词，应为手误，下面几处同样已被更正），那么说书人可以判断怪咖表现得很搞笑并阻止");
    g_artLine[847] = StringToText("他的死亡。");
    g_artLine[848] = StringToText("我通常使用这一类比来应对人们要求我去用规则精确定义哪些是疯狂，哪些不是的请求。试想一下，");
    g_artLine[849] = StringToText("在遇到这种情况下一头雾水的说书人……「我在一场游戏里，怪咖讲了一个冷笑话。");
    g_artLine[850] = StringToText("有一位玩家发出了咯咯的笑声，但那名玩家本身比较幼稚，会因为任何事情而发笑。");
    g_artLine[851] = StringToText("所有其他的玩家只是叹息，翻着白眼，也并未觉得那很好笑。这意味着怪咖搞笑么？讲冷笑话算作搞笑么？");
    g_artLine[852] = StringToText("我向所有人争论说，因为有一名玩家笑了，所以怪咖足够搞笑，因此不会死亡。其他玩家会说，");
    g_artLine[853] = StringToText("因为绝大部分玩家都没有笑，所以怪咖不够搞笑。我能得到关于哪种类型的笑话好笑，");
    g_artLine[854] = StringToText("哪种不好笑的解释么？某人的轶事，或是幽默的抬杠，算是搞笑吗？我们还能得到关于‘有多少玩家笑了");
    g_artLine[855] = StringToText("才能让怪咖不会被流放’的解释么？一个人因为三个不同的笑话分别大笑，");
    g_artLine[856] = StringToText("是否就能认为这个怪咖和用一个笑话让三个人笑的怪咖同样搞笑呢？玩家要求对怪咖的行为是否搞笑用一");
    g_artLine[857] = StringToText("些明确的规则做出区分，以此他们才能够知道什么情况下才能提议流放怪咖。同样的，我判断在下一天，");
    g_artLine[858] = StringToText("怪咖并不够搞笑，因为他没有讲出任何笑话，即使大家都在因为怪咖滑稽的流放辩解而捧腹大笑。");
    g_artLine[859] = StringToText("这样对吗？」");
    g_artLine[860] = StringToText("虽然这些问题都有些夸张成分在里面，这些玩家也不会真的去问有关怪咖的一些问题，");
    g_artLine[861] = StringToText("因为相比疯狂规则来说，人们更容易用直觉来判断某人是否搞笑。在上面的例子中，");
    g_artLine[862] = StringToText("我也不会想要去告诉这位倒霉的说书人应该用什么样的标准来判断是否搞笑。");
    g_artLine[863] = StringToText("他应该按自己的想法来进行判断。");
    g_artLine[864] = StringToText("对于疯狂来说，玩家说了什么，没说什么，什么时候说，什么时候不说，判断方式也是一样的。");
    g_artLine[865] = StringToText("如果你判定一名小精灵玩家努力向他人证明自己是贵族，那么你可以让他获得贵族的能力。");
    g_artLine[866] = StringToText("如果他连续六天都在努力让他人相信自己是贵族，而另一名玩家说他可能就是小精灵，");
    g_artLine[867] = StringToText("而小精灵玩家此时却只是眨眼和保持沉默……那么我基本上可以判断他没有疯狂地证明自己是贵族，");
    g_artLine[868] = StringToText("因为他在最后一刻犹豫了。但是，如果小精灵在宣传自己是贵族时对善良玩家的信息造成了巨大的冲击，");
    g_artLine[869] = StringToText("而他的眨眼被当做是厚颜无耻的表现，只有半数玩家相信小精灵就是小精灵，");
    g_artLine[870] = StringToText("而另一半相信他是贵族……那么我还是会倾向于给与小精灵贵族的能力，即使他明确的表示出自己就是小");
    g_artLine[871] = StringToText("精灵。一切都会归结于小精灵他到底做了什么，他有多令人信服，说书人来判断小精灵他这样做的意图是");
    g_artLine[872] = StringToText("什么，他的言行究竟产生了什么样的影响。");
    g_artLine[873] = StringToText("设置怪咖这样的角色机制的目的是鼓励幽默，笑声和轻松。如果怪咖这样做了，他就会获得奖励。");
    g_artLine[874] = StringToText("而设置醉酒和中毒机制的目的是让善良玩家在毫无知觉的情况下传递错误的信息。");
    g_artLine[875] = StringToText("疯狂机制的目的则是让善良玩家有意识地传递错误的信息。如果他这么做了，");
    g_artLine[876] = StringToText("他会得到奖励（或避免被惩罚）。");
    g_artLine[877] = StringToText("以简单的方式来看待事物是非常有用的，这样会避免误认为疯狂这种机制拥有或者需要有一套玩家「需要");
    g_artLine[878] = StringToText("满足」的精确标准。要么玩家表现出疯狂，要么没有，这都是可以的。而如果玩家不表现出疯狂的行为而");
    g_artLine[879] = StringToText("试图去寻找漏洞以图在不付出任何代价的情况下满足疯狂条件并获取一些好处，");
    g_artLine[880] = StringToText("或者当他们认为疯狂的定义必须是满足了一系列特定的标准时，问题也就随之出现。");
    g_artLine[881] = StringToText("小精灵的能力可能会让人觉得有些奇怪，因为其他具有疯狂能力的角色（译注：指洗脑师，");
    g_artLine[882] = StringToText("梦殒春宵里的爪牙角色）是让玩家有一天的时间来表现出疯狂。而对于小精灵来说，");
    g_artLine[883] = StringToText("他会持续整场游戏并直到贵族死去。在判断小精灵是否疯狂时，我通常会优先考虑小精灵最近的言行，");
    g_artLine[884] = StringToText("而不是他在游戏早些时候说过的话。");
    g_artLine[885] = StringToText("这就是我能给出的最好的答案，我希望这能解释清楚一些事情。但很不幸的是，");
    g_artLine[886] = StringToText("我不知道你所说的「被强迫必须疯狂」是什么意思。你能解释一下么？每一名玩家都是可以在任何时候说");
    g_artLine[887] = StringToText("任何想说的话的，他们从来不会被迫说出任何不想说的话。每一个运用了疯狂机制的角色都以独特的方式");
    g_artLine[888] = StringToText("来实现了这一点，而疯狂对以特定方式说（或是不说）特定事情有着特定的惩罚或好处，");
    g_artLine[889] = StringToText("但玩家永远不会被强迫去说任何事情。");
    // 8 有关说书人的创造力--有趣的巫师（38 段 / 55 行）
    g_artAt[8] = 890;
    g_artN[8] = 55;
    g_artLine[890] = StringToText("努努：");
    g_artLine[891] = StringToText("Steven，你好。");
    g_artLine[892] = StringToText("巫师是一个非常有趣的角色，你能告诉我有关「愿望」、「代价」和「线索」具体指什么吗？");
    g_artLine[893] = StringToText("Steven：");
    g_artLine[894] = StringToText("巫师可以许愿任何事情,例如");
    g_artLine[895] = StringToText("我许愿得知三名善良玩家的角色。");
    g_artLine[896] = StringToText("我许愿可以看魔典。");
    g_artLine[897] = StringToText("我许愿改变我的阵营。");
    g_artLine[898] = StringToText("我许愿恶魔不会死。");
    g_artLine[899] = StringToText("我许愿努努转变为邪恶。");
    g_artLine[900] = StringToText("对这些许愿，说书人可以做出类似这样的回应：");
    g_artLine[901] = StringToText("我会满足你的愿望 。（最常见的）");
    g_artLine[902] = StringToText("不，我不会满足你太多的愿望，许个其他的愿望吧。");
    g_artLine[903] = StringToText("你愿望太多了！我没有实现你的愿望，你的愿望被使用了。（极个别情况）");
    g_artLine[904] = StringToText("有关代价，我也会举例来说明，注意说书人绝大多数时候不会告知巫师他的代价是什么。");
    g_artLine[905] = StringToText("巫师许愿成为善良玩家，然后巫师得知他转变成了善良阵营，代价是说书人秘密的改变了恶魔的角色和位");
    g_artLine[906] = StringToText("置。");
    g_artLine[907] = StringToText("巫师许愿邻近的一名玩家变成邪恶的巫师，然后成功了，代价是新邪恶的巫师的能力不会生效。");
    g_artLine[908] = StringToText("设置代价的原因是：可能玩家的愿望太强力，你实现了他的愿望，然后你需要通过代价来实现平衡。例如：");
    g_artLine[909] = StringToText("巫师希望我的票被计算为五票，说书人可以不实现他的愿望，因为这太不公平了；");
    g_artLine[910] = StringToText("或者也可以实现他的愿望，然后在当晚杀死巫师，这就是一个比较公平的代价。");
    g_artLine[911] = StringToText("说书人绝大部分的时候不会告诉巫师他的代价是什么，不告诉巫师代价会更有趣，代价可以是任何事情。");
    g_artLine[912] = StringToText("有关线索，有时候我没有给出线索，有的时候我会给出一些线索：我会宣布一些奇怪的事情，");
    g_artLine[913] = StringToText("有时候我会说这是线索，一般情况我不会说这是线索。例如");
    g_artLine[914] = StringToText("巫师许愿成为新的恶魔，代价是老恶魔死亡，为了提醒善良玩家，我宣布线索可能是「你寻找的真相发生");
    g_artLine[915] = StringToText("了改变」或者「昨晚我去了一趟剧院，我观看了一场精彩的变脸表演」或者直接是「恶魔发生了改变」。");
    g_artLine[916] = StringToText("设计线索是因为，如果善良阵营不知道巫师的许愿是什么，而输掉了比赛会是一个非常不公平的事情，");
    g_artLine[917] = StringToText("所以我希望通过线索，不是非常清晰的线索，去帮助善良阵营。");
    g_artLine[918] = StringToText("作为一个说书人，你需要有创造力，你需要问自己「这个愿望对善良阵营公平吗」，如果是公平的，");
    g_artLine[919] = StringToText("那我不会额外的做一些事情，如果不公平，我会留下线索让善良阵营知道，巫师的愿望被实现了。");
    g_artLine[920] = StringToText("巫师是一个非常开放的角色。");
    g_artLine[921] = StringToText("【范例】");
    g_artLine[922] = StringToText("如果大家对巫师还有疑问，希望获得更多的范例来理解这个角色，可以提供给大家其他设计师的一些范例，");
    g_artLine[923] = StringToText("仅供大家参考。以下内容来自于英文WIKI编辑者之一：Jams。");
    g_artLine[924] = StringToText("巫师是一个能决定游戏走向的角色。它可以打破游戏规则。");
    g_artLine[925] = StringToText("愿望：巫师玩家可以要求说书人为他们做任何事。以下是一些例子：");
    g_artLine[926] = StringToText("我许愿死后获得麻脸巫婆的能力。");
    g_artLine[927] = StringToText("我许愿每个玩家都有修补匠的能力。");
    g_artLine[928] = StringToText("我许愿每个人都变成自己最喜欢的角色。");
    g_artLine[929] = StringToText("我许愿在提名和投票期间时钟指针逆时针转动。");
    g_artLine[930] = StringToText("我许愿每个玩家都能许一个愿。");
    g_artLine[931] = StringToText("巫师许的愿并不与巫师这个角色绑定。一旦许愿，就会永久改变那场游戏，而且巫师无需存活，");
    g_artLine[932] = StringToText("其愿望也能持续生效。例如，如果巫师许愿每天只有两名好人玩家可以提名，那么在巫师死后，");
    g_artLine[933] = StringToText("每天只有两名好人玩家可以提名的规则仍然适用。");
    g_artLine[934] = StringToText("代价：有些愿望不太平衡。例如，邪恶的巫师可能会许愿邪恶阵营在当天结束时赢得游戏，");
    g_artLine[935] = StringToText("或者恶魔不会因处决而死亡。甚至像 「我希望每个玩家都有瘟疫医生的能力」 这样的愿望也可能非常");
    g_artLine[936] = StringToText("有利于邪恶阵营。所以，每当巫师许了一个愿，说书人可以采取一些措施 —— 设定一个 「代价」—");
    g_artLine[937] = StringToText("— 来平衡这个愿望的影响力，让游戏对所有玩家来说都公平且有趣。");
    g_artLine[938] = StringToText("例子 1：巫师许愿游戏中有更多爪牙的能力发挥作用。每天，说书人使用一个非原本游戏中的爪牙能力");
    g_artLine[939] = StringToText("来影响游戏中的一名玩家。这个愿望的代价是，邪恶阵营无法选择这些爪牙能力是什么，");
    g_artLine[940] = StringToText("以及如何使用它们。");
    g_artLine[941] = StringToText("例子 2：巫师许愿每天只有两名好人玩家可以提名，而邪恶阵营可以自由提名。");
    g_artLine[942] = StringToText("说书人决定这个愿望的代价将是每天只有一名邪恶玩家可以提名 —— 每天只有前两名好人玩家和第一");
    g_artLine[943] = StringToText("名提名的邪恶玩家被允许提名。");
    g_artLine[944] = StringToText("如果某个愿望对邪恶阵营来说强大到足以破坏游戏平衡，这个愿望的代价可以是巫师转为善良阵营。");
    // 9 钟楼笔记：相克更新（39 段 / 99 行）
    g_artAt[9] = 945;
    g_artN[9] = 99;
    g_artLine[945] = StringToText("（Form Jamie Mercado 2025年10月9日）");
    g_artLine[946] = StringToText("几周前，在Cow & Moon那张我们常坐的角落桌前，Steve盯着我笃定地说：");
    g_artLine[947] = StringToText("「我想把所有的相克规则都重新整理一遍。」");
    g_artLine[948] = StringToText("那时我们已经在角色设计的漩涡中摸爬滚打好几个星期，Steve脑子里堆满了新点子，");
    g_artLine[949] = StringToText("几乎要溢出来了。这当然很好——但也有个不得不提的大前提：每设计出一个新角色，");
    g_artLine[950] = StringToText("就必须确保它能和已有角色兼容，或者得加上一条特别说明，也就是「相克规则」（Jinx），");
    g_artLine[951] = StringToText("来帮助玩家们搞清楚万一出了问题该怎么处理。");
    g_artLine[952] = StringToText("正因如此，每出一个新角色，游戏的复杂度就会增加一分。而我们设计《染·钟楼谜团》时的初心，");
    g_artLine[953] = StringToText("是让它对新玩家足够友好：说书人确实需要读完整本规则才能主持游戏，但玩家只需听一遍三分钟的规则");
    g_artLine[954] = StringToText("概要、看一张纸上的简介，就可以开始一局精彩的博弈。");
    g_artLine[955] = StringToText("回到相克规则本身——在和Steve一边头脑风暴一边设计新角色的过程中，我们开始思考，");
    g_artLine[956] = StringToText("有没有可能把这些冲突处理得更简单、更好上手？以往的规则大多是「一对一」的特例，");
    g_artLine[957] = StringToText("用来解决特定角色之间的问题。但我们想试试看，能不能用一条统一的规则模式来覆盖那些互动方式相似");
    g_artLine[958] = StringToText("的角色组合。理论上来说，如果相似的问题可以用相似的方式解决，那么说书人需要记住的就不再是大量");
    g_artLine[959] = StringToText("的个例规则，玩家理解起来也会更顺畅。");
    g_artLine[960] = StringToText("不过这套新系统也有它的两大难点。第一，如果我们更倾向于制定能覆盖多种情况的通用规则，");
    g_artLine[961] = StringToText("那每条规则就不可能为某个角色组合量身定做，灵活度会受到限制。第二，");
    g_artLine[962] = StringToText("那些早已熟悉旧版相克规则的老玩家，可能需要重新适应新内容，还可能对自己喜欢的老规则被「重写」");
    g_artLine[963] = StringToText("感到失望。尤其是那些围绕某些特定互动制作了自定义剧本的玩家，一旦规则变动，剧本可能「失效」，");
    g_artLine[964] = StringToText("这确实令人沮丧。而更棘手的是，这次规则调整并不是因为「某条规则坏了需要修复」，而是我们发现，");
    g_artLine[965] = StringToText("真正「出问题」的，是游戏整体的可理解性和可上手程度。");
    g_artLine[966] = StringToText("和Steve一起合作的早期，我就明白了一件事：游戏设计中，很多时候你必须做出一些无法让所有人");
    g_artLine[967] = StringToText("都满意的决定。你得清楚自己最看重的是什么。我们选择站在「让更多人能玩懂」这一边，");
    g_artLine[968] = StringToText("即便这意味着不能再为每一种角色组合做出最酷最精细的规则。也正是在这样的原则下，");
    g_artLine[969] = StringToText("我们决定重构整套相克规则系统。");
    g_artLine[970] = StringToText("首先，Steve 和我意识到，我们得先弄清楚——到底是哪一类角色互动最容易触发相克规则？");
    g_artLine[971] = StringToText("只有把这些情况分类清楚，后面的工作才能展开。于是，我们坐下来认真梳理，");
    g_artLine[972] = StringToText("最后列出了以下几类常见的「相克类型」：");
    g_artLine[973] = StringToText("· 角色变化");
    g_artLine[974] = StringToText("· 规则解释");
    g_artLine[975] = StringToText("· 邪恶阵营自动获胜");
    g_artLine[976] = StringToText("· 邪恶阵营转变善良阵营");
    g_artLine[977] = StringToText("· 不佳游戏体验");
    g_artLine[978] = StringToText("· 善良阵营自动获胜");
    g_artLine[979] = StringToText("· 查看魔典");
    g_artLine[980] = StringToText("· 增添趣味");
    g_artLine[981] = StringToText("· 失去能力");
    g_artLine[982] = StringToText("· 夜晚没有死亡");
    g_artLine[983] = StringToText("· 设置调整");
    g_artLine[984] = StringToText("· 说书人决策");
    g_artLine[985] = StringToText("· 独特机制");
    g_artLine[986] = StringToText("（注：有些分类名听起来很直白，有些则是我们为了方便建表简化的缩写，");
    g_artLine[987] = StringToText("比如 「夜晚没有死亡」 指的是那些不会造成夜晚死亡的角色，与那些能力在「夜晚死亡」时才触发的");
    g_artLine[988] = StringToText("角色之间的互动；「查看魔典」则是指那些建立于「邪恶不掌握在场信息」设定的角色，");
    g_artLine[989] = StringToText("与能看到魔典的角色之间的互动；「说书人决策类」则是指，那些冲突只有在说书人做了某个「本可以不");
    g_artLine[990] = StringToText("做」的选择后才会发生的互动……等等。）");
    g_artLine[991] = StringToText("有了分类之后，我们开始把历史上的每一组有相克规则的角色搭配，归到这些类别中。");
    g_artLine[992] = StringToText("大多数组合很快就归好类了，但也有一些组合我和 Steve 的看法不一致，");
    g_artLine[993] = StringToText("或者一个组合似乎能归到好几个类。我们互相争论、反复核对，最后你要是好奇我们具体怎么归类的，");
    g_artLine[994] = StringToText("其实都可以在公开表格中查到——我们把所有旧的相克规则、更新过的版本、");
    g_artLine[995] = StringToText("以及最终归类结果都整理出来了。挺有趣的是，当我们把所有组合都归完类后，");
    g_artLine[996] = StringToText("发现这些分类竟然正好全覆盖了所有相克组合。只剩两个分类最终没用上：");
    g_artLine[997] = StringToText("「角色变化类」归类到「失去能力」和「不佳游戏体验」里了；而「独特机制类」，");
    g_artLine[998] = StringToText("我们竟然没找到真正「独特到无法归类」的角色互动。");
    g_artLine[999] = StringToText("接下来才是最关键的一步：回头检查每一条相克规则（包括我们想新增的一些），看看有没有更直观、");
    g_artLine[1000] = StringToText("通用的写法。我们基本是按角色来处理的——比如我们会列出所有与维齐尔存在冲突的角色，");
    g_artLine[1001] = StringToText("然后挨个对比这些规则，看看有没有相似的写法已经在同类问题里用过了。如果有，");
    g_artLine[1002] = StringToText("就思考能不能把那条规则扩展应用到更多角色上。这项工作一做就是好几天，");
    g_artLine[1003] = StringToText("几乎每天都是长时间会议（我们常去的 Enmore Road 印度餐厅已经记住我们的常点菜单了）");
    g_artLine[1004] = StringToText("。虽然目前这个版本我们已经比较满意，但也知道，还有优化空间。其中有几处改动，");
    g_artLine[1005] = StringToText("我们觉得既有趣也可能引发争议，下面就特别说说：");
    g_artLine[1006] = StringToText("魔术师与军团：魔术师会和军团一同被唤醒，并可能被当作邪恶阵营。军团会知道魔术师是否在场，");
    g_artLine[1007] = StringToText("但不会得知具体是哪一名玩家。");
    g_artLine[1008] = StringToText("这最初是 Steve 提出来的，我当时一听就愣了：「如果我是魔术师」，我反驳，");
    g_artLine[1009] = StringToText("「我直接找齐所有好人，说我知道所有军团，请他们投票杀我，然后互相保护不就完了？谁还能阻止我们？");
    g_artLine[1010] = StringToText("」");
    g_artLine[1011] = StringToText("Steve 提了个反例：军团其实也可以用同样的方式操作。他们可以挑1–2个军团队友，");
    g_artLine[1012] = StringToText("再混上1–2个好人，然后假装自己是魔术师。这听上去确实挺疯狂的，但也可能带来新的骗术和博弈—");
    g_artLine[1013] = StringToText("—比如你在非军团局里用「男爵」假装自己是魔术师，岂不妙哉？反正如果真的玩不转，");
    g_artLine[1014] = StringToText("我们还可以改回来。");
    g_artLine[1015] = StringToText("数学家与酒鬼：数学家可能会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_artLine[1016] = StringToText("我们光是为了这个规则就争了整整两天。这里得先补点背景：Steve 最初设计数学家时，");
    g_artLine[1017] = StringToText("设想它是一个「错误追踪器」——能发现哪些能力没有正常生效。按这个设定，");
    g_artLine[1018] = StringToText("如果一个酒鬼的能力「故障」了（也就是说，行为表现和清醒状态时的角色不同），");
    g_artLine[1019] = StringToText("那数学家的数字就会上升。比如，一个酒鬼共情者身边两名善良玩家却看到「1」，");
    g_artLine[1020] = StringToText("那数学家那晚就会得出一个「1」。但由于卡面空间有限，加上其他角色的连带影响，");
    g_artLine[1021] = StringToText("最终上线时我们把酒鬼（和提线木偶 ）从「可被追踪的出错对象」里剔除了。");
    g_artLine[1022] = StringToText("最早的「数学家与疯子」的相克规则就是为了弥补这个缺口的：如果疯子选了一名玩家杀死，");
    g_artLine[1023] = StringToText("却没人死（因为真正的恶魔选了别人），那数学家那晚得知的信息就会增加1——因为疯子「故障了」，");
    g_artLine[1024] = StringToText("和他自己设想的能力不一致。照这个逻辑，把酒鬼和提线木偶也加进「故障监控」范围是说得通的。");
    g_artLine[1025] = StringToText("但实践中，这引发的问题比想象中多太多了。如果数学家必须得知每次酒鬼或提线木偶的信息出错或能力");
    g_artLine[1026] = StringToText("失效，那善良方就能推测出谁可能是酒鬼或提线木偶，从而大幅缩小身份范围。经过一番激烈争论，");
    g_artLine[1027] = StringToText("我们决定先试试看让数学家能在说书人判断下感知这些「故障」。如果效果不好，我们就撤销——那时候，");
    g_artLine[1028] = StringToText("「数学家与疯子」的那条规则也很可能会随之取消。");
    g_artLine[1029] = StringToText("删除的相克规则");
    g_artLine[1030] = StringToText("在提线木偶和卡扎力这两个角色的例子中，我们通过更新它们在历书中的说明，");
    g_artLine[1031] = StringToText("解决了原先依靠相克规则才能解释的问题。现在这两个角色的历书内容中，已经加入了以下补充说明：");
    g_artLine[1032] = StringToText("提线木偶：提线木偶不会因其他角色能力导致他确认自己是爪牙而被唤醒。例如：告密者，传教士，");
    g_artLine[1033] = StringToText("小怪宝，罂粟种植者，帽匠，落难少女等。");
    g_artLine[1034] = StringToText("卡扎力：卡扎力能够将他想要的任意玩家变成爪牙，无论该名玩家的角色能力如何，例如：士兵，莽夫，");
    g_artLine[1035] = StringToText("落难少女，国王等。");
    g_artLine[1036] = StringToText("【最后的几点想法（暂时的），按顺序说不上来，但这些是我们希望大家记住的核心原则：】");
    g_artLine[1037] = StringToText("· 如果一条相克规则涉及了某个在场角色的「能力使用方式」，那就默认这个角色需要「存活、清醒、");
    g_artLine[1038] = StringToText("健康」才能让这条规则对游戏产生影响。");
    g_artLine[1039] = StringToText("· 拿不准的时候，就看看这条能力到底是在帮助谁——如果是镇民，就该为善良阵营服务；");
    g_artLine[1040] = StringToText("如果是外来者、爪牙或恶魔，那就自然偏向邪恶方。");
    g_artLine[1041] = StringToText("· 如果还是不清楚，那就听说书人的。说书人是规则的最终裁定者。各位说书人，");
    g_artLine[1042] = StringToText("请在支持邪恶玩家伪装的同时，尽可能确保游戏公平有趣、张弛有度。");
    g_artLine[1043] = StringToText("· 最后永恒不变的信条：要以优雅的方式杀戮，也要以有尊严的方式死去。");
}

int BOTC_ArtCount () {
    return 10;
}

string BOTC_ArtName (int k) {
    if (k == 0) { return "「规则」与「理念」——关于角色能力互动的说明"; }
    if (k == 1) { return "设计师的平衡天书"; }
    if (k == 2) { return "创作幕后——超越暗流涌动"; }
    if (k == 3) { return "成为一个好说书人的经历"; }
    if (k == 4) { return "创作幕后——逻辑一片混乱？"; }
    if (k == 5) { return "染·钟楼谜团是一款策略游戏"; }
    if (k == 6) { return "设计师总结的国内玩家对染的错误理解"; }
    if (k == 7) { return "疯狂规则如何运作？——疯狂的小精灵"; }
    if (k == 8) { return "有关说书人的创造力--有趣的巫师"; }
    if (k == 9) { return "钟楼笔记：相克更新"; }
    return "";
}

int BOTC_ArtAt (int k) {
    if (k < 0 || k > 9) { return 0; }
    return g_artAt[k];
}

int BOTC_ArtN (int k) {
    if (k < 0 || k > 9) { return 0; }
    return g_artN[k];
}

text BOTC_ArtLine (int i) {
    if (i < 0 || i >= 1100) { return StringToText(""); }
    return g_artLine[i];
}

