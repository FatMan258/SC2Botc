    libNtve_gf_SetDialogItemImage(g_saySeatIcon, "botc_blank.dds", PlayerGroupAll());
    DialogControlSetVisible(g_saySeatIcon, PlayerGroupAll(), false);
    // 名字行跟着说书人格一起右移；宽度收窄到 203，右边界仍停在 1044，不越出魔典
    g_saySeatLbl = BOTC_NewLabelC(g_grimDlg, 203, 26, 841, 153, StringToText(""));
