    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// 【工程师（78）】（用户 2026-11-04）：先选恶魔 / 爪牙；恶魔选 1 个、爪牙选 2 个（不可重复），
//   确认提交后才消耗「失去能力」token。工程师本人不会收到是否改变成功的提示。
void BOTC_EngReset () {
    g_engStage = 0;
    g_engMode = 0;
    g_engR1 = -1;
    g_engR2 = -1;
    g_engSeatA = 0;
    g_engSeatB = 0;
    g_engSeat = 0;
}

void BOTC_EngOpen (int seat) {
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_EngReset();
    g_engSeat = seat;
    g_engStage = 0;
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText("【工程师】选择要改变的邪恶角色类型"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText("恶魔（1 个）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText("爪牙（2 个）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engClose, StringToText("取消（不使用能力）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_EngGrid (int p, int team) {
    int q;
    string title;
    if (p < 1 || p > 13) {
        return;
    }
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    g_pickMode[p] = 19;
    g_pickWho[p] = p;
    g_pickTeam = team;
    BOTC_PickFilter(p, false);
    // 第二个爪牙不能与第一个重复：把第一个角色所在的格子藏起来。
    if (g_engMode == 2 && g_engR1 >= 0) {
        for (q = 0; q < g_gridN; q += 1) {
            if (g_gridSlot[q] == g_engR1) {
                DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
                DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
                DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
            }
        }
    }
    if (g_engMode == 3) {
        title = "【工程师】选择 1 个本剧本的恶魔角色";
    }
    else {
        if (g_engStage == 1) {
            title = "【工程师】选择第 1 个爪牙角色";
        }
        else {
            title = "【工程师】选择第 2 个爪牙角色（不能重复）";
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(title), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（不使用能力）"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

void BOTC_EngPickResult (int role) {
    if (role < 0 || role > 163) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 3) {
        g_engR1 = role;
        g_engR2 = -1;
        g_engStage = 3;
        BOTC_EngConfirmShow();
        return;
    }
    if (g_engStage == 1) {
        g_engR1 = role;
        g_engStage = 2;
        BOTC_EngGrid(g_teller, 2);
        return;
    }
    if (role == g_engR1) {
        BOTC_Notice(g_teller, "两个爪牙角色不能重复，请重新选择。");
        BOTC_EngGrid(g_teller, 2);
        return;
    }
    g_engR2 = role;
    g_engStage = 3;
    BOTC_EngConfirmShow();
}

void BOTC_EngConfirmShow () {
    string title;
    if (g_engSeat < 2 || g_engSeat > 13) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 3) {
        title = "【工程师】已选恶魔「" + g_roleName[g_engR1] + "」。点【确认提交】后获得「失去能力」；点【取消】不使用能力。";
    }
    else {
        title = "【工程师】已选爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」。点【确认提交】后获得「失去能力」；点【取消】不使用能力。";
    }
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText(title), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText("确认提交"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText("取消"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engClose, StringToText("取消（不使用能力）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
}

// 只改真实身份；目标已经是这个角色时保持不动。
void BOTC_EngSetRole (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (BOTC_SeatTrueRole(q) == role) {
        return;
    }
    BOTC_SetSeatRole(g_teller, q, role);
    BOTC_ChangeRoleMsg(q, role);
}

void BOTC_EngAssign (int swap) {
    int qa;
    int qb;
    int ra;
    int rb;
    qa = g_engSeatA;
    qb = g_engSeatB;
    if (qa < 2 || qb < 2) {
        BOTC_EngCancel();
        return;
    }
    if (swap != 0) {
        ra = g_engR2;
        rb = g_engR1;
    }
    else {
        ra = g_engR1;
        rb = g_engR2;
    }
    BOTC_EngSetRole(qa, ra);
    BOTC_EngSetRole(qb, rb);
    BOTC_PmStore(g_teller, "【工程师】" + BOTC_NameStr(qa) + " 变成「" + g_roleName[ra] + "」，" + BOTC_NameStr(qb) + " 变成「" + g_roleName[rb] + "」。");
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    BOTC_EngReset();
}

void BOTC_EngSubmit () {
    int q;
    int i;
    int n;
    int a;
    int b;
    int extra;
    q = g_engSeat;
    if (q < 2 || q > 13) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 3 && g_engR1 < 0) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 2 && (g_engR1 < 0 || g_engR2 < 0)) {
        BOTC_EngCancel();
        return;
    }
    // 提交后才消耗工程师的「失去能力」token。
    g_tokOn[(((g_teller * 14) + q) * 256) + 99] = true;
    BOTC_GrimRender(g_teller);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    if (g_engMode == 3) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!BOTC_SeatDead(i) && BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
                if (BOTC_SeatTrueRole(i) != g_engR1) {
                    BOTC_EngSetRole(i, g_engR1);
                    n += 1;
                }
            }
        }
        BOTC_PmStore(g_teller, "【工程师】提交：恶魔角色 → 「" + g_roleName[g_engR1] + "」，实际改变 " + IntToString(n) + " 名。");
        BOTC_EngReset();
        return;
    }
    // 爪牙：收集存活爪牙，由说书人选择谁获得第一个角色，另一位获得剩下的角色。
    a = 0;
    b = 0;
    extra = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) {
            continue;
        }
        n += 1;
        if (a == 0) {
            a = i;
        }
        else {
            if (b == 0) {
                b = i;
            }
            else {
                extra += 1;
            }
        }
    }
    if (a == 0) {
        BOTC_PmStore(g_teller, "【工程师】提交：场上没有存活爪牙，未改变任何身份。");
        BOTC_EngReset();
        return;
    }
    if (b == 0) {
        BOTC_EngSetRole(a, g_engR1);
        BOTC_PmStore(g_teller, "【工程师】提交：只有一名存活爪牙，" + BOTC_NameStr(a) + " 变成「" + g_roleName[g_engR1] + "」。");
        BOTC_EngReset();
        return;
    }
    if (extra > 0) {
        BOTC_PmStore(g_teller, "【工程师】场上有 " + IntToString(n) + " 名存活爪牙，只调整前两名。");
    }
    g_engSeatA = a;
    g_engSeatB = b;
    g_engStage = 4;
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText("【工程师】选择谁变成「" + g_roleName[g_engR1] + "」，另一位变成「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText(IntToString(g_lab[a]) + "号变「" + g_roleName[g_engR1] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText(IntToString(g_lab[b]) + "号变「" + g_roleName[g_engR1] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_EngCancel () {
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    // 只有还没点【确认提交】时取消才算「这次不使用能力」，不写 token 99。
    BOTC_EngReset();
}

void BOTC_FarmerOpen (int seat, bool viaLevi) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!viaLevi) {
        g_farmPending[seat] = false;
    }
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：农夫死的时候中毒/酒鬼 → 能力失效，不挑人
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(seat) + " 死的时候中毒/酒鬼 → 能力失效，没人变成农夫。");
        return;
    }
    g_farmSeat = seat;
    g_farmViaLevi = viaLevi;
    if (viaLevi) {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫×利维坦】" + BOTC_NameStr(seat) + " 的能力被触发：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫】" + BOTC_NameStr(seat) + " 夜里死了：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_farmEdit, StringToText(""), PlayerGroupSingle(g_teller));
    // 【换座位出来的说书人也要有确认键】（用户 2026-10-18）：同上
    DialogControlSetVisible(g_farmOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_farmOk, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_FarmerSend () {
    int n;
    int t;
    string s;
    if (g_farmSeat < 2 || g_farmSeat > 13) {
        return;
    }
    s = libNtve_gf_DialogItemEditValue(g_farmEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "填 1~12 的座位号。");
        return;
    }
    t = n + 1;
    if (!g_seatOn[t]) {
        BOTC_Notice(g_teller, "这个座位没有玩家。");
        return;
    }
    if (!BOTC_TargetIsLiving(t)) {
        BOTC_Notice(g_teller, "要挑一个还活着的玩家。");
        return;
    }
    if (BOTC_SeatAlign(t) != 0) {
        BOTC_Notice(g_teller, "要挑一个善良阵营的玩家。");
        return;
    }
    BOTC_SetSeatRole(g_teller, t, 80);
    BOTC_SetSeatRole(g_who[t], t, 80);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, 80);
    if (g_farmViaLevi) {
        BOTC_PmStore(g_teller, "【农夫×利维坦】相克触发 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    else {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(g_farmSeat) + " 夜里死亡 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), false);
    g_farmSeat = 0;
    g_farmViaLevi = false;
}

void BOTC_ManInfoOk () {
    string s2;
    string s;
    int n;
    int seat;
    int kind;
    int role;
    int tru;                      // 数学家核对用的正确答案
    int i;

    // 【半仙（158）】不占用技能三目标面板，避免与典狱长等多选角色互相覆盖。
    if (g_miRole == 815) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (!g_halfPick || seat != g_halfBy) {
            BOTC_Notice(g_teller, "这次半仙改选已经失效。");
            DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "请填写一名邪恶玩家的座位号（1~12）。");
            return;
        }
        BOTC_HalfImmortalApply(seat, g_halfSlot, n + 1);
        return;
    }

    // 【典狱长（163）】上一批无人死于处决：说书人填写一名候选座位，确认后立即结算死亡。
    if (g_miRole == 814) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "请填写一名候选玩家的座位号（1~12）。");
            return;
        }
        if (g_wardenAskBy == 0 || seat != g_wardenAskBy) {
            BOTC_Notice(g_teller, "这次典狱长判定已经失效。");
            DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_WardenKillChoice(n + 1);
        return;
    }

    // 【科学怪人状态面板】只用于查看，点关闭即可，不发送任何信息。
    if (g_miRole == 810) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_miText = "";
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
        return;
    }

    // 【牙噶巴卜（133）】首夜秘密短语：只私聊发给本人；之后杀谁由说书人手动打死亡 token。
    if (g_miRole == 809) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先输入一段秘密短语再点【确定】。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        BOTC_PmStore(g_teller, "【牙噶巴卜】秘密短语已发给 " + BOTC_NameStr(seat) + "：" + s + "。之后是否造成死亡由你手动打死亡 token。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }

    // 【发送特定信息 · 自定义文本】（用户 2026-10-21）：自动在输入内容前加「你得知」，结尾补句号。
    if (g_miRole == 808) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "自定义文本是空的：先输入内容再发送。");
            return;
        }
        s = "你得知" + s + "。";
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], BOTC_InfoText(s));
        BOTC_PmStore(g_teller, "【说书人工具】自定义文本已发给 " + BOTC_NameStr(seat) + "：" + BOTC_InfoText(s));
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        g_specTo = 0;
        return;
    }

    // 【事务官（142）】：一个框 = 一名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 14) {
        seat = g_miSeat;
        g_evilA = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        if (g_evilA < 2) {
            BOTC_Notice(g_teller, "请填写一个玩家座位号（1~12）。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 167] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【事务官】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + "。");
        return;
    }
    // 【骑士（122）】：两个框 = 两名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 13) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA) + "," + BOTC_NameStr(g_evilB));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 141] = true;
        g_tokOn[(((g_teller * 14) + g_evilB) * 256) + 141] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【骑士】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "。");
        return;
    }
    // 【店小二（115）】（用户 2026-11-06）：清醒时先问要不要把当前熟客 / 醉酒的两名玩家告诉他
    if (g_miRole == 41 && g_miKind == 22) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 135]) {
                g_evilA = i;
            }
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 136]) {
                g_evilB = i;
            }
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_dxeMode = 0;
        if (g_evilA < 2 || g_evilB < 2 || g_evilA == g_evilB) {
            BOTC_DxeManualOpen(seat);
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知[" + IntToString(g_lab[g_evilA] + g_nameNumShift) + "],[" + IntToString(g_lab[g_evilB] + g_nameNumShift) + "]。");
        BOTC_PmStore(g_teller, "【店小二】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "（当前熟客 / 醉酒）。");
        return;
    }
    // 【风雅集（板子 10）· 店小二（115）】：两个框 = 他要得知的两名玩家 → 私聊告诉他
    //   配板阶段已经放好熟客 / 醉酒（用户 2026-11-06）；只有说书人点了【取消】才走这里，
    //   填完再让说书人从这两人里选一名成为新的醉酒（另一名成为新熟客）。
    if (g_miRole == 41 && g_miKind == 12) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知[" + IntToString(g_lab[g_evilA] + g_nameNumShift) + "],[" + IntToString(g_lab[g_evilB] + g_nameNumShift) + "]。");
        BOTC_PmStore(g_teller, "【店小二】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "。");
        if (g_dxeMode == 1) {
            BOTC_DrunkPickOpen(3, seat, g_evilA, g_evilB);   // 这两人里选一名成为新醉酒，另一名成为新熟客
        }
        g_dxeMode = 0;
        return;
    }

    // 【风雅集（板子 10）· 郎中（116）】（用户 2026-10-16）：框里那个词原样私聊发给他
    if (g_miRole == 806) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一个词再点【确定】。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        BOTC_PmStore(g_teller, "【郎中】已告诉 " + BOTC_NameStr(seat) + "：" + s);
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【军团 · 假军团（疯子）】（用户 2026-09-30）：说书人填的两个座位号 = 这两个军团不给疯子看
    //   两个框都空 / 点取消 = 不屏蔽（疯子看到所有队友）
    if (g_miRole == 41 && g_miKind == 9) {
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(g_evilA, g_evilB);
        BOTC_NotifyDemonsLunatic();
        return;
    }
    if (g_miRole == 85) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一段短语再点【确定】。");
            return;
        }
        s2 = "【信息】你得知" + s;
        BOTC_PmInfo(g_who[seat], s2);
