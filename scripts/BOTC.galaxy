// 把一段文字按每行 n 个字切开，铺进列表（星际的列表不自动换行）

// 往列表里铺一段已经切好的文案：从 g_tipLine[at] 开始，共 n 行
//   （中文不要用 StringSub 现场切，它按字节算位置，会把字切坏）
void BOTC_TipLines (int p, int at, int n) {
    int i;
    for (i = 0; i < n; i += 1) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), BOTC_KeyColor(g_tipLine[at + i]));
    }
}

// 说书人提示：只有玩家1 才铺这一份
void BOTC_TipStLines (int p) {
    int i;
    for (i = 0; i < g_tipStN; i += 1) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), BOTC_KeyColor(g_tipStLine[i]));
    }
}

void BOTC_TipRender (int p) {
    int r;
    int team;
    int pos;
    DialogControlRemoveAllItems(g_tipList, PlayerGroupSingle(p));
    // 【场次统计页】（用户 2026-10-20）：直接读当前说书人的 bank，按玩家号列 1～13。
    if (g_tipMode[p] == 3) {
        BOTC_StatsRender(p);
        return;
    }
    if (g_tipMode[p] == 2) {
        // 【游戏帮助】（用户 2026-11-04）：规则页左上角直接写「游戏帮助」
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("游戏帮助"), PlayerGroupSingle(p));
    }
    if (g_tipForce[p] >= 0) {
        r = g_tipForce[p];                  // 调试指令 /tip / 能力表详情强制指定的身份（每人一份）
    }
    else {
        pos = BOTC_PosOf(p);
        if (!g_dealConfirmed && !g_started) {
            // 【确认发放前不显示身份】（用户 2026-11-06）：说书人配板 / 手动改身份阶段，
            //   玩家不能通过【我的角色】提前看到自己的角色，必须等说书人点【确认发放】。
            //   游戏正式开始后不再拦截，避免中途改身份（会清 g_dealConfirmed）时误伤。
            r = -1;
        }
        else if (g_board == 13 && p != g_teller) {
            // 【全员追忆 · 我的角色看自己魔典】（用户 2026-11-05）：板子 13 的真身只在真值行，
            //   【我的角色】改读玩家自己那份魔典上给本人标记的身份，不再泄露真实角色。
            r = g_mark[(p * 14) + pos] - 1;
        }
        else {
            // 【我的角色始终显示真实身份】（用户 2026-11-04）：不读玩家自己那份可被说书人改写的镜像行，
            //   改读真值行；酒鬼 / 疯子 / 悟道者 / 提线木偶这类认知偏差角色仍显示他们以为的身份。
            r = BOTC_SeatTrueRole(pos);
            if (r == 14 || r == 38 || r == 118 || r == 93) {
                r = g_mark[(g_teller * 14) + pos] - 1;
            }
        }
    }
    // 帮助面板的两种子页面：2 = 只看游戏规则（跳过角色那段）
    if (g_tipMode[p] != 2) {
    if (p == g_teller && g_tipForce[p] < 0) {
        // 【说书人提示】只有玩家1 看得到：他没有自己的角色，这里给的是主持手册
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("说书人提示"), PlayerGroupSingle(p));
        libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
        BOTC_TipStLines(p);
    }
    else {
    // 【左上角标题】（用户 2026-11-04）：从剧本角色表点进来的写「角色介绍」，从【我的角色】进来的写「我的角色是」
    if (g_tipForce[p] >= 0) {
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("角色介绍"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_tipTitleLbl, StringToText("我的角色是"), PlayerGroupSingle(p));
    }
    if (r >= 0 && r <= 163 && g_roleName[r] != "") {
        libNtve_gf_SetDialogItemImage(g_tipIcon, BOTC_NightIconName(r), PlayerGroupSingle(p));
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), true);
        libNtve_gf_SetDialogItemText(g_tipName, TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
        // 胜利条件先铺（在【角色能力】之前）：爪牙 / 恶魔看邪恶版，其余看善良版
        if (BOTC_RoleTeam(r) == 2 || BOTC_RoleTeam(r) == 3) {
            BOTC_TipLines(p, g_tipWinEvilAt, g_tipWinEvilN);
        }
        else {
            BOTC_TipLines(p, g_tipWinGoodAt, g_tipWinGoodN);
        }
        if (r == 130) { BOTC_BootleggerSyncText(); }
        // 【详情页权限】（用户 2026-11-07）：说书人看全部章节；
        //   普通玩家看【角色能力】【角色简介】【规则细节】，
        //   第九节再按阵营分流：【对抗X】给善良阵营，【伪装成X】给邪恶阵营。
        if (p == g_teller) {
            BOTC_TipLines(p, g_tipRoleAt[r], g_tipRoleN[r]);
            if (g_tipBluffN[r] > 0) {
                BOTC_TipLines(p, g_tipBluffAt[r], g_tipBluffN[r]);
            }
            // 【第十节】（用户 2026-11-12）：【对说书人的建议】，仅说书人可见
            if (g_tipAdvN[r] > 0) {
                BOTC_TipLines(p, g_tipAdvAt[r], g_tipAdvN[r]);
            }
        }
        else {
            if (g_tipP1N[r] > 0) {
                BOTC_TipLines(p, g_tipP1At[r], g_tipP1N[r]);
                BOTC_TipLines(p, g_tipP2At[r], g_tipP2N[r]);
            }
            else {
                BOTC_TipLines(p, g_tipRoleAt[r], g_tipRoleN[r]);
            }
            // 【第九节】（用户 2026-11-08）：不再按查看者阵营分流，改成按**被查看的角色**分——
            //   善良角色（镇民 / 外来者）给【伪装成X】，邪恶角色（爪牙 / 恶魔）给【对抗X】，
            //   所有玩家看到的都一样。只有从剧本角色表 / 角色能力表点进来看某个角色时才显示；
            //   【我的角色】【游戏帮助】这类 g_tipForce = -1 的入口一律不显示。
            if (g_tipForce[p] >= 0) {
                team = BOTC_RoleTeam(r);
                if (team == 2 || team == 3) {
                    if (g_tipVsN[r] > 0) {
                        BOTC_TipLines(p, g_tipVsAt[r], g_tipVsN[r]);
                    }
                }
                else {
                    if (g_tipBluffN[r] > 0) {
                        BOTC_TipLines(p, g_tipBluffAt[r], g_tipBluffN[r]);
                    }
                }
            }
        }
    }
    else {
        DialogControlSetVisible(g_tipIcon, PlayerGroupSingle(p), false);
        if (g_tipForce[p] < 0 && !g_dealConfirmed) {
            // 【未确认发放的提示】（用户 2026-11-06）：不发角色，但明确告诉玩家还没发牌
            libNtve_gf_SetDialogItemText(g_tipName, StringToText("（说书人尚未发放身份）"), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_tipName, StringToText(""), PlayerGroupSingle(p));
        }
    }
    if ((p >= 2 || g_tipForce[p] >= 0) && r >= 0) {
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("--------------------------------------------------"));
        DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("我该做什么？"));
        if (g_board == 13) {
            team = BOTC_RoleTeam(r);       // 全员追忆按玩家眼前这张占位卡显示对应阵营说明
        }
        else {
            team = BOTC_SeatTeam(BOTC_PosOf(p));
        }
        if (g_tipForce[p] >= 0) {
            team = BOTC_RoleTeam(g_tipForce[p]);   // 按被强制那个角色的阵营显示
        }
        if (team == 3) {
            BOTC_TipLines(p, g_tipDemonAt, g_tipDemonN);
        }
        else if (team == 2) {
            BOTC_TipLines(p, g_tipMinionAt, g_tipMinionN);
        }
        else {
            BOTC_TipLines(p, g_tipGoodAt, g_tipGoodN);
        }
    }
    }
    }
    // 1 = 只看角色细节（跳过最后的规则概述）
    if (g_tipMode[p] != 1) {
    DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("--------------------------------------------------"));
    DialogControlAddItem(g_tipList, PlayerGroupSingle(p), StringToText("规则概述"));
    BOTC_TipLines(p, g_tipCommonAt, g_tipCommonN);
    }
}

void BOTC_TipOpen (int p) {
    // 笔记与所有页面共存，打开帮助时不再收笔记（用户 2026-11-04）
    BOTC_TipRender(p);
    g_tipOpen[p] = true;
    DialogSetVisible(g_tipDlg, PlayerGroupSingle(p), true);
}

void BOTC_TipClose (int p) {
    g_tipOpen[p] = false;
    g_tipForce[p] = -1;            // 关掉提示面板就回到「显示自己的角色」
    DialogSetVisible(g_tipDlg, PlayerGroupSingle(p), false);
}

//==================================================================================================
// 【笔记】（用户 2026-09-20）：屏幕中央一块记事板，每个玩家一份 ----
//   8 行单行输入框（星际的输入框不支持多行），关闭 / 切到别的面板时自动保存，下次打开还在。
//==================================================================================================
void BOTC_BuildNotes (int p) {
    int i;
    int y;
    DialogCreate(760, 600, c_anchorCenter, 0, 0, false);   // 首次打开在屏幕正中心（用户 2026-11-04）
    g_noteDlg[p] = DialogLastCreated();
    DialogSetVisible(g_noteDlg[p], PlayerGroupAll(), false);
    DialogSetImageVisible(g_noteDlg[p], true);
    g_noteTitle[p] = BOTC_NewLabel(g_noteDlg[p], 720, 30, 20, 10, StringToText("笔记"));
    libNtve_gf_SetDialogItemStyle(g_noteTitle[p], "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_noteTitle[p], false, PlayerGroupAll());
    for (i = 0; i < 8; i += 1) {
        y = 50 + (i * 56);
        g_noteEdit[(p * 8) + i] = BOTC_NewEdit(g_noteDlg[p], 720, 46, 20, y);
    }
    g_noteClose[p] = BOTC_NewButton(g_noteDlg[p], 220, 40, 270, 540, "关闭（保存）");
    DialogSetVisible(g_noteDlg[p], PlayerGroupSingle(p), false);
}

//==================================================================================================
// 【竞选角色类型】（用户 2026-11-11）：剧本页右上角入口，每个玩家一份 ----
//   4 个类型（镇民 / 外来者 / 爪牙 / 恶魔）各自独立开关：参与 = 随机配板时抽到该类型权重 ×1.5。
//   默认 4 类全开。状态保存在玩家本地 bank 的 opts 章节（键 jrw，位掩码），
//   只有点【关闭（保存）】才写入；随机配板读的是保存后的状态，所以本局配板之后再改只影响下一局。
//==================================================================================================
// 位掩码取第 which 位（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔），避开位运算按除法逐位取
int BOTC_JrBit (int mask, int which) {
    int v;
    int i;
    v = mask;
    for (i = 0; i < which; i += 1) {
        v = v / 2;
    }
    return v % 2;
}

// 读玩家本地保存的参与状态；没存过就默认 4 类全开（15）
int BOTC_JrMaskLoad (int p) {
    int v;
    if (p < 1 || p > 13) {
        return 15;
    }
    // 【缓存优先 · 不阻塞读档】（用户 2026-11-11）：开局已经加载并等待过一次，这里只读缓存；
    //   不再每次打开竞选角色都 BankLoad + BankWait，掉线同步时不会卡住全场。
    BOTC_BankInit();
    v = 15;
    if (BankKeyExists(g_bank[p], "opts", "jrw")) {
        v = BankValueGetAsInt(g_bank[p], "opts", "jrw");
        if (v < 0 || v > 15) {
            v = 15;
        }
    }
    return v;
}

void BOTC_JrSave (int p) {
    int v;
    if (p < 1 || p > 13) {
        return;
    }
    v = 0;
    if (g_jrWant[(p * 4) + 3] == 1) {
        v = v + 8;
    }
    if (g_jrWant[(p * 4) + 2] == 1) {
        v = v + 4;
    }
    if (g_jrWant[(p * 4) + 1] == 1) {
        v = v + 2;
    }
    if (g_jrWant[(p * 4) + 0] == 1) {
        v = v + 1;
    }
    // 【缓存优先 · 不阻塞读档】（用户 2026-11-11）：写回开局缓存并保存，不再先 BankWait 重读。
    //   缓存里的其他章节都在，保存不会丢场次；下一次进图刷新时生效。
    // 【兜底补加载】（用户 2026-11-13）：句柄缺失时先补一次，否则偏好会写进空句柄而丢失。
    BOTC_BankEnsure(p);
    BankValueSetFromInt(g_bank[p], "opts", "jrw", v);
    BankSave(g_bank[p]);
}

string BOTC_JrTypeName (int t) {
    if (t == 0) {
        return "镇民";
    }
    if (t == 1) {
        return "外来者";
    }
    if (t == 2) {
        return "爪牙";
    }
    return "恶魔";
}

// 【认知偏差角色的竞选归类】（用户 2026-11-11）：这几个角色按玩家「以为的身份」参与竞选：
//   疯子（38）以为自己是恶魔 → 恶魔竞选；
//   悟道者（118）以为自己是外来者 → 外来者竞选；
//   酒鬼（14）以为自己是镇民 → 镇民竞选。
//   提线木偶（93）抽到的可能是镇民也可能是外来者，两边的竞选都算（在爪牙重排处单独判断）。
//   其余角色按真实阵营：外来者走外来者竞选，镇民走镇民竞选。
int BOTC_JrRoleType (int role) {
    if (role == 38) {
        return 3;
    }
    if (role == 118) {
        return 1;
    }
    if (role == 14) {
        return 0;
    }
    if (BOTC_RoleTeam(role) == 1) {
        return 1;
    }
    return 0;
}

void BOTC_JrRender (int p) {
    int t;
    string s;
    for (t = 0; t < 4; t += 1) {
        s = "参与" + BOTC_JrTypeName(t) + "角色竞选：";
        if (g_jrWant[(p * 4) + t] == 1) {
            s = s + "参与";
        }
        else {
            s = s + "不参与";
        }
        libNtve_gf_SetDialogItemText(g_jrTypeBtn[(p * 4) + t], StringToText(s), PlayerGroupSingle(p));
    }
}

void BOTC_BuildJoinRole (int p) {
    int i;
    int y;
    DialogCreate(560, 404, c_anchorCenter, 0, 0, false);
    g_jrDlg[p] = DialogLastCreated();
    DialogSetVisible(g_jrDlg[p], PlayerGroupAll(), false);
    DialogSetImageVisible(g_jrDlg[p], true);
    g_jrTitle[p] = BOTC_NewLabel(g_jrDlg[p], 520, 30, 20, 12, StringToText("竞选角色类型"));
    libNtve_gf_SetDialogItemStyle(g_jrTitle[p], "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_jrTitle[p], false, PlayerGroupAll());
    BOTC_NewLabel(g_jrDlg[p], 520, 40, 20, 42, StringToText("参与的类型在随机配板时权重 ×1.5；修改后点【关闭（保存）】生效。"));
    // 【认知偏差角色的竞选归类】（用户 2026-11-11）：面板内注明这四个角色按「以为的身份」参与竞选。
    BOTC_NewLabel(g_jrDlg[p], 520, 48, 20, 82, StringToText("认知偏差角色按「以为的身份」参与竞选：疯子 → 恶魔，悟道者 → 外来者，提线木偶 → 镇民 / 外来者，酒鬼 → 镇民。"));
    for (i = 0; i < 4; i += 1) {
