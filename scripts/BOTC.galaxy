    }
    g_specTo = q;
    g_specMode = 3;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), true);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemText(g_specInfoClear, StringToText("清空全部"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送给他"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, BOTC_NameSubstText(StringToText("玩家号 + 身份：发给 " + BOTC_NameStr(q))), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("玩家号最多 6 个（1~12）；身份按钮可选 0~6 个。只填玩家号 → 发玩家号；1 个玩家号 + 1 个身份 → A是B；有多个结果 → 自动拼成列表。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("取消"), PlayerGroupAll());
    BOTC_SpecSeatClear();
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecRoleOpen (int i) {
    if (i < 0 || i > 5) {
        return;
    }
    // 【发送不在场身份】（用户 2026-11-04）：模式 6（选角色）/ 8（已选好收件人）只允许前 3 个坑位
    if (g_specMode == 6 || g_specMode == 8) {
        if (i > 2) {
            return;
        }
        g_specBluffOn = true;
        g_specPickSlot = i;
        g_specMode = 4;
        g_pickMode[g_teller] = 29;
        g_pickWho[g_teller] = g_specTo;
        g_pickTeam = -1;
        g_pickAlign = -1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(i + 1) + " 个不在场身份"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
        BOTC_PickFilter(g_teller, false);
        DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    if (g_specMode != 3 || g_specTo < 2 || g_specTo > 13) {
        return;
    }
    g_specBluffOn = false;
    g_specPickSlot = i;
    g_specMode = 4;
    g_pickMode[g_teller] = 29;
    g_pickWho[g_teller] = g_specTo;
    g_pickTeam = -1;
    g_pickAlign = -1;
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(i + 1) + " 个身份（点空白处不选）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecSeatSend () {
    int i;
    int n;
    int r;
    int seatN;
    int roleN;
    string one;
    string seats;
    string roles;
    string msg;
    // 【发送不在场身份】（用户 2026-11-04）：模式 8 的【发送】走自己的流程
    if (g_specMode == 8) {
        BOTC_SpecBluffSend();
        return;
    }
    // 模式 6：独立面板的【发送】→ 收起面板，点座位直接发送
    if (g_specMode == 6) {
        BOTC_MBluffSend();
        return;
    }
    if (g_specTo < 2 || g_specTo > 13) {
        return;
    }
    seats = "";
    roles = "";
    seatN = 0;
    roleN = 0;
    for (i = 0; i < 6; i += 1) {
        one = libNtve_gf_DialogItemEditValue(g_specSeatEdit[i], g_teller);
        if (StringLength(one) > 0) {
            n = BOTC_TextNum(one);
            if (n < 1 || n > 12) {
                BOTC_Notice(g_teller, "第 " + IntToString(i + 1) + " 个玩家号不对：只能填 1~12，留空表示不用这一格。");
                return;
            }
            if (seatN > 0) {
                seats = seats + ",";
            }
            seats = seats + BOTC_NameStr(n + 1);
            seatN = seatN + 1;
        }
        if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
            r = g_specRoleSel[i] - 1;
            if (roleN > 0) {
                roles = roles + ",";
            }
            roles = roles + g_roleName[r];
            roleN = roleN + 1;
        }
    }
    if (seatN <= 0 && roleN <= 0) {
        BOTC_Notice(g_teller, "至少填一个玩家号，或选择一个身份。");
        return;
    }
    if (seatN > 0 && roleN <= 0) {
        msg = "【信息】你得知" + seats + "。";
    }
    else {
        if (seatN <= 0) {
            msg = "【信息】你得知" + roles + "。";
        }
        else {
            if (seatN == 1 && roleN == 1) {
                msg = "【信息】你得知" + seats + "是" + roles + "。";
            }
            else {
                msg = "【信息】你得知" + seats + "中有" + roles + "。";
            }
        }
    }
    BOTC_PmInfo(g_who[g_specTo], msg);
    BOTC_PmStore(g_teller, "【说书人工具】已发给 " + BOTC_NameStr(g_specTo) + "：" + msg);
    BOTC_SpecClose();
}

void BOTC_RecogClose () {
    int i;
    for (i = 0; i < 7; i += 1) {
        libNtve_gf_SetDialogItemText(g_recogEdit[i], StringToText(""), PlayerGroupAll());
    }
    g_recogTo = 0;
    DialogSetVisible(g_recogDlg, PlayerGroupAll(), false);
}

void BOTC_RecogOpen (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    BOTC_RecogClose();
    g_recogTo = q;
    libNtve_gf_SetDialogItemText(g_recogTitle, BOTC_NameSubstText(StringToText("发送互认：发给 " + BOTC_NameStr(q))), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_recogDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_RecogSend () {
    int i;
    int j;
    int n;
    int q;
    int dn;
    int mn;
    int[7] vals;
    string raw;
    string sd;
    string sm;
    string msg;
    if (g_recogTo < 2 || g_recogTo > 13) {
        BOTC_Notice(g_teller, "先点一名玩家作为互认信息的收件人。");
        return;
    }
    sd = "";
    sm = "";
    dn = 0;
    mn = 0;
    for (i = 0; i < 7; i += 1) {
        vals[i] = 0;
    }
    for (i = 0; i < 7; i += 1) {
        raw = libNtve_gf_DialogItemEditValue(g_recogEdit[i], g_teller);
        if (StringLength(raw) <= 0) {
            continue;
        }
        n = BOTC_TextNum(raw);
        q = n + 1;
        if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
            BOTC_Notice(g_teller, "第 " + IntToString(i + 1) + " 个输入框只能填 1~12，并且对应座位必须有人。");
            return;
        }
        for (j = 0; j < i; j += 1) {
            if (vals[j] == q) {
                BOTC_Notice(g_teller, "座位号 " + IntToString(n) + " 重复填写了。");
                return;
            }
        }
        vals[i] = q;
        if (i < 2) {
            if (dn > 0) {
                sd = sd + ",";
            }
            sd = sd + BOTC_NameStr(q);
            dn = dn + 1;
        }
        else {
            if (mn > 0) {
                sm = sm + ",";
            }
            sm = sm + BOTC_NameStr(q);
            mn = mn + 1;
        }
    }
    if (dn <= 0 && mn <= 0) {
        BOTC_Notice(g_teller, "至少填写一个恶魔或爪牙的座位号。");
        return;
    }
    if (dn > 0) {
        msg = "【信息】你得知" + sd + "是恶魔。";
        if (mn > 0) {
            msg = msg + "爪牙：" + sm + "。";
        }
    }
    else {
        msg = "【信息】你得知爪牙：" + sm + "。";
    }
    BOTC_PmInfo(g_who[g_recogTo], msg);
    BOTC_PmStore(g_teller, "【发送互认】已发给 " + BOTC_NameStr(g_recogTo) + "：" + msg);
    BOTC_RecogClose();
}

// 选好收件人（q = 格子）：自定义文本走共用答题框；玩家号 + 身份 / 手动互认走各自面板
void BOTC_SpecPickSeat (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (g_specMode == 1) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_ManInfoOpen(q, 808, "输入自定义文本（发送时自动加「你得知」）");
        return;
    }
    if (g_specMode == 2) {
        BOTC_SpecSeatShow(q);
        return;
    }
    if (g_specMode == 5) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_RecogOpen(q);
        return;
    }
    // 【发送不在场身份 · 独立面板】（用户 2026-11-04）：已点【发送】，点座位 = 直接发送
    if (g_specMode == 7) {
        if (q < 2 || q > 13) {
            return;
        }
        g_specTo = q;
        BOTC_SpecBluffSend();
    }
}

// ==================================================================================================
// 【发送不在场身份】（用户 2026-11-04）：说书人不再用右下角面板手动选 / 发送。
//   流程：发送特定信息 → 发送不在场身份 → 点 3 个身份按钮各选一个角色 → 自动提示点座位选收件人
//         → 面板重新弹出显示 3 个角色 + 【发送】/【取消】。
//   左下角原有的「不在场身份」面板改为只给收到的玩家看，说书人不再显示。
// ==================================================================================================
void BOTC_SpecBluffRoleShow () {
    g_specMode = 6;
    g_specBluffOn = true;
    g_mbOn = true;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_MBluffRender();
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecBluffOpen () {
    int i;
    g_specTo = 0;
    g_specPickSlot = 0;
    for (i = 0; i < 6; i += 1) {
        g_specRoleSel[i] = 0;
    }
    BOTC_SpecBluffRoleShow();
}

// 3 个角色已经选满 → 收起面板，等说书人点一个座位当收件人
void BOTC_SpecBluffSeatAsk () {
    g_specMode = 7;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_NoticeKeep(g_teller, "【发送不在场身份】已选好 3 个身份：点一个玩家的座位 = 收件人；不想发送就再点【说书人工具】取消。");
}

// 收件人已选好：面板重新弹出，显示 3 个角色 + 【发送】/【取消】
void BOTC_SpecBluffSeatShow () {
    int i;
    g_specMode = 8;
    g_specBluffOn = true;
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), true);
    }
    for (i = 3; i < 6; i += 1) {
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemText(g_specInfoClear, StringToText("随机 3 个"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, BOTC_NameSubstText(StringToText("发送不在场身份（2 / 2：发给 " + BOTC_NameStr(g_specTo) + "）")), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("点【发送】把这 3 个不在场身份发给他；也可以点【随机 3 个】重抽；点【取消】不发送。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("取消"), PlayerGroupAll());
    BOTC_SpecSeatRender();
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecBluffSeatPick (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    g_specTo = q;
    BOTC_SpecBluffSeatShow();
}

// ==================================================================================================
// 【发送不在场身份 · 独立面板】（用户 2026-11-04）：不再和【发送特定信息】共用面板。
//   流程：发送特定信息 → 发送不在场身份 → 独立面板选 / 随机 3 个角色 → 点【发送】
//         → 面板收起，直接点一名玩家的座位即可发送；不想发就再点【说书人工具】取消。
void BOTC_MBluffRender () {
    int i;
    int v;
    string s;
    if (!g_mbOn) {
        DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
        return;
    }
    libNtve_gf_SetDialogItemText(g_mbTitle, StringToText("手动发送不在场身份"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_mbHint, StringToText("点【随机 3 个】自动填充，或点身份卡逐个选择；点【发送】后，直接点一名玩家的座位即可发送。不想发送就再点【说书人工具】取消。"), PlayerGroupSingle(g_teller));
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemText(g_mbRoleBtn[i], StringToText(""), PlayerGroupSingle(g_teller));
        v = g_specRoleSel[i];
        if (v >= 1 && v <= 163) {
            s = g_roleName[v - 1];
            libNtve_gf_SetDialogItemImage(g_mbRoleIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(g_teller));
        }
        else {
            s = "选身份";
            libNtve_gf_SetDialogItemImage(g_mbRoleIcon[i], "botc_blank.dds", PlayerGroupSingle(g_teller));
        }
        libNtve_gf_SetDialogItemText(g_mbRoleName[i], StringToText(s), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MBluffRoll () {
    int i;
    BOTC_BluffRoll();
    for (i = 0; i < 3; i += 1) {
        g_specRoleSel[i] = g_bluffPick[i];
    }
    BOTC_MBluffRender();
}

void BOTC_MBluffSend () {
    int i;
    int v;
    for (i = 0; i < 3; i += 1) {
        v = g_specRoleSel[i];
        if (v < 1 || v > 163) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（第 " + IntToString(i + 1) + " 个还是空的）。");
            return;
        }
    }
    g_specMode = 7;
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    BOTC_NoticeKeep(g_teller, "【发送不在场身份】已选好 3 个身份：点一名玩家的座位即可发送；不想发送就再点【说书人工具】取消。");
}

void BOTC_MBluffCancel () {
    g_mbOn = false;
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
}

void BOTC_BuildMBluff () {
    int i;
    int x;
    DialogCreate(760, 300, c_anchorCenter, 0, -40, false);
    g_mbDlg = DialogLastCreated();
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    BOTC_FrameSilver(g_mbDlg, 760, 300);
    g_mbTitle = BOTC_NewLabel(g_mbDlg, 720, 30, 20, 10, StringToText("手动发送不在场身份"));
    libNtve_gf_SetDialogItemStyle(g_mbTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mbTitle, false, PlayerGroupAll());
    g_mbHint = BOTC_NewLabel(g_mbDlg, 720, 52, 20, 42, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_mbHint, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mbHint, false, PlayerGroupAll());
    for (i = 0; i < 3; i += 1) {
        x = 60 + (i * 240);
        g_mbRoleBtn[i] = BOTC_NewButton(g_mbDlg, 110, 110, x, 100, "");
        g_mbRoleIcon[i] = BOTC_NewImageItem(g_mbDlg, 110, 110, x, 100, "botc_blank.dds");
        g_mbRoleName[i] = BOTC_NewLabel(g_mbDlg, 102, 20, x + 4, 186, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_mbRoleName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_mbRoleName[i], false, PlayerGroupAll());
    }
    g_mbRollBtn = BOTC_NewButton(g_mbDlg, 200, 44, 40, 216, "随机 3 个");
    g_mbSendBtn = BOTC_NewButton(g_mbDlg, 200, 44, 280, 216, "发送");
    g_mbCancelBtn = BOTC_NewButton(g_mbDlg, 200, 44, 520, 216, "取消");
    BOTC_MBluffRender();
}

// 【随机 3 个】（用户 2026-11-04）：规则与发给恶魔的随机不在场一致
void BOTC_SpecBluffRoll () {
    BOTC_MBluffRoll();
}

void BOTC_SpecBluffSend () {
    int i;
    int v;
    if (g_specTo < 2 || g_specTo > 13) {
        BOTC_Notice(g_teller, "还没有选择收件人：点一个玩家的座位。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        v = g_specRoleSel[i];
        if (v < 1 || v > 163) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（第 " + IntToString(i + 1) + " 个还是空的）。");
            return;
        }
    }
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = g_specRoleSel[i];
    }
    BOTC_BluffSendAt(g_specTo);       // 共用原来那套：给对方显示右下角面板 + 通知
    BOTC_SpecClose();
}
void BOTC_BuildGrim () {
    int i;
    int q;
    int t;
    int f;
    DialogCreate(1053, 936, c_anchorRight, 0, -70, false);
    g_grimDlg = DialogLastCreated();
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), false);
    g_grimTitle = BOTC_NewLabel(g_grimDlg, 450, 34, 14, 12, StringToText("魔典"));
    // 标题只是文字，不要让它的控件范围盖住左边新加的【强制玩家发起提名】按钮
    libNtve_gf_SetDialogItemAcceptMouse(g_grimTitle, false, PlayerGroupAll());
    // 说书人专用的「游戏正式开始」按钮（正式开始后变成「取消正式开始」）
    g_grimStart = BOTC_NewButton(g_grimDlg, 223, 36, 803, 9, "游戏正式开始");
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimStart, PlayerGroupSingle(g_teller), true);
