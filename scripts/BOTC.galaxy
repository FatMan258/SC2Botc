    g_tipLine[575] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的邻近的存活玩家是最靠近") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("两名存活玩家----一名为顺时针方向最近的存");
