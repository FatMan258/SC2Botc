        g_poisonAt[i] = 0;
        g_poisonDayBy[i] = 0;
    }
    g_gblSeat = 0;                 // 【赌徒 · 判定面板】（用户 2026-11-01）：换局关掉
    for (i = 0; i <= 13; i += 1) {
        g_bountySetupDone[i] = false;   // 【赏金猎人 · 首夜设置调整】（用户 2026-11-01）：换局重来
    }
    g_spyP = 0;
    g_peekNoTok = 0;
    g_copyP = 0;                   // 【是否抄录魔典】（用户 2026-11-06）：换局清掉待答状态
    g_copyWidow = false;
    if (g_copyDlg > 0) {
        DialogSetVisible(g_copyDlg, PlayerGroupAll(), false);
    }
    g_butlerSeat = 0;
    for (i = 1; i <= 13; i += 1) {
        g_grimView[i] = 0;             // 【-grim】看过别人那份的，换局清掉
        g_grimViewOn[i] = false;
        g_grimSnapOn[i] = false;       // 间谍 / 寡妇保存的真魔典快照，换局清掉
    }
    g_butlerMaster = 0;
    g_herring = 0;
    g_pickTeam = -1;          // 身份网格默认不过滤（用户 2026-09-21）
    g_pickAlign = -1;
    // 酒鬼 / 中毒占卜师的假干扰项：换局清空
    g_ftFakeSeat[0] = 0;
    g_ftFakeSeat[1] = 0;
    g_ftFakeOwner = 0;
    g_ftFakeWant = 0;
    g_chatMode = 2;                // 发言时段：**游戏开始前默认公聊**（用户 2026-09-17）；之后由说书人 / 智能说书切换
    BOTC_SkipReset();              // 【快进到提名】换局：票数清零
    // 邪恶小窗：换局一律关掉、清空
    g_evilEnable = false;          // 【总开关】false = 邪恶小窗整个停用（用户 2026-09-19）；想恢复就把这行改成 true
    g_evilOn = false;
    g_evilCount = 0;
    for (i = 0; i < 14; i += 1) {
        g_evilIn[i] = false;
    }
    BOTC_EvilRender();
    // 背景音乐：选板子 / 准备阶段一首，夜晚一首（音轨名 = 数据编辑器里 Sound 的 ID）
    //   ⚠ 夜晚这首要等你把音乐导入地图、建好 Sound 条目之后，把这里的名字改成那个 ID
    //      （比如导入成 Assets\Sounds\OverworldNight.wav、Sound 叫 OverworldNight，就写 "OverworldNight"）
    g_musicBoardName = "LostViking_MusicGameLoop";
    g_musicNightName = "night";                    // 自己做的夜晚音轨（天黑就放，天亮停）
    g_musicPmName = "siliao";                      // 白天私聊时间
    g_musicPubName = "gongliao1";                  // 白天公聊时间
    g_musicNomName = "timing";                     // 白天提名阶段
    g_musicSilentName = "moren";                   // 自己做的「静音」音轨（停音乐时用它顶住）
    // 把这条静音音轨设成**默认**音轨：这样一旦当前音轨被停掉，引擎回落到的是它（安静），
    //   而不是星际自带的种族音乐（就是「暂停音轨之后还会冒出星际原生音乐」那个现象）
    SoundtrackDefault(PlayerGroupAll(), c_soundtrackCategoryMusic, g_musicSilentName, c_soundtrackCueAny, c_soundtrackIndexAny);
    g_musicPubSmallName = "gongliao2";             // 在场 ≤ 4 人：白天的曲子（公聊 / 私聊 / 自由都用它）
    g_musicNomSmallName = "timing2";               // 在场 ≤ 4 人：提名阶段的曲子
    g_sfxDayName = "baitian";                      // 天亮那声（音效；放 4 秒后淡出）
    // 入夜那声提示音（数据编辑器「音效」里的 ID）。
    //   使用 Ping2；不要改回已被 SoundData.xml 静音的 Ping。
    //   ⚠ 大小写敏感：写错大小写会报「请求的声音文件未知」。
    //     想换成自己的提示音：数据编辑器 → 音效 → 新建一个指向你导入的音频，把 ID 填这里；
    //     或者在游戏里用聊天指令 sfx <名字> 现场试。
    g_sfxPingName = "Ping2";
    // 大提示的字体样式（聊天里 style <名字> 能现场换）。
    //   ObjectiveDisplay = 星际剧情里那种「任务目标」大字，比原来的 UnitWireframeVitalLarge 大得多
    g_bigStyle = "ObjectiveDisplay";
    // 提名开始那 4 个字：先跟夜晚大字用同一个样式（聊天里 nstyle <名字> 能现场换成更大的）
    g_nomBigStyle = "ObjectiveDisplay";
    // 魔典座位名的字体（原来靠 mod 里的字体表才有 UnitWireframeVitalLarge，新 mod 没带 → 用基础游戏里
    //   确定有的小字号；聊天里 gstyle <名字> 能现场换着看）
    g_grimNameStyle = "ModLeftSize16Bold";
    g_nameNumShift = 0;            // 名字前的序号 = 游戏内号 + 0（= 跟游戏里一致；差一位就用 nameoff -1 / nameoff 1 现场调）
    g_sfxNomName = "timingkaishi";                 // 提名开始那声（数据编辑器「音效」里的 ID）
    g_sfxChargeName = "Raynor_PenetratorRoundChargeUp";   // 猎手射中恶魔：充能音
