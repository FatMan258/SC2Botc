    libNtve_gf_SetDialogItemAcceptMouse(g_tmSecLbl, false, PlayerGroupAll());
    g_tmEditPub = BOTC_NewEdit(g_tmDlg, 190, 30, 130, 44);
    // 下面两个按钮：尺寸保持原样（130×30）
    g_tmBtnGo = BOTC_NewButton(g_tmDlg, 130, 30, 10, 156, "开始");
    libNtve_gf_SetDialogItemStyle(g_tmBtnGo, "ModLeftSize16Bold", PlayerGroupAll());
    g_tmBtnStop = BOTC_NewButton(g_tmDlg, 130, 30, 150, 156, "停止");
    libNtve_gf_SetDialogItemStyle(g_tmBtnStop, "ModLeftSize16Bold", PlayerGroupAll());

    // 收起后的小按钮（参考私聊面板）
    DialogCreate(130, 30, c_anchorTopLeft, 540, 70, false);
    g_tmMiniDlg = DialogLastCreated();
    DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
    g_tmExpandBtn = BOTC_NewButton(g_tmMiniDlg, 130, 30, 0, 0, "展开计时");
    libNtve_gf_SetDialogItemStyle(g_tmExpandBtn, "ModLeftSize16Bold", PlayerGroupAll());
    // 【默认收起】（用户 2026-09-20）：一开始只显示【展开计时】小按钮，点开才展开面板
    g_tmHidden = true;
    DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_tmDlg, PlayerGroupSingle(g_teller), false);

    // --- 所有人看到的倒计时条（屏幕顶端偏下、水平居中，只显示当前这一种）---
    DialogCreate(560, 36, c_anchorTop, 0, 60, false);
    g_tmShowDlg = DialogLastCreated();
    DialogSetImageVisible(g_tmShowDlg, false);      // 不要那个框，只留文字（用户 2026-09-19）
    DialogSetVisible(g_tmShowDlg, PlayerGroupAll(), false);
    g_tmLbl = BOTC_NewLabel(g_tmShowDlg, 520, 36, 20, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_tmLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_tmLbl, false, PlayerGroupAll());
}

// 【汉字字形预热】（用户 2026-09-19）：把 22 个角色名的汉字先渲染一遍，让星际把字形栅格化进字体图集。
//   它建在**选板子那张黑布之前**，所以整个选板子阶段它都被黑布盖着（玩家看不到）；
//   黑布一撤（BOTC_BoardFinish）就把它藏起来。样式用魔典座位名字那一套（g_grimNameStyle）。
void BOTC_BuildGlyphWarm () {
    int i;
    string s;
    s = "";
    for (i = 0; i <= 21; i += 1) {
        s = s + g_roleName[i] + " ";
    }
    s = s + "1 [本地玩家]";                 // 座位名字那一行的写法也热一下
    DialogCreate(1400, 30, c_anchorTopLeft, 0, 300, false);
    g_warmDlg = DialogLastCreated();
    DialogSetImageVisible(g_warmDlg, false);          // 不要底框，只要字被画出来
    g_warmLbl = BOTC_NewLabel(g_warmDlg, 1400, 30, 0, 0, StringToText(s));
    // 【汉字预热】（用户 2026-10-04）：它建在黑布之后、聊天之前 —— BOTC_GrimInitData() 已经先跑过，
    //   所以这里拿到的是真正的角色名和字体样式（跟魔典座位名字同一套）。
    libNtve_gf_SetDialogItemStyle(g_warmLbl, g_grimNameStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_warmLbl, false, PlayerGroupAll());
    DialogSetVisible(g_warmDlg, PlayerGroupAll(), true);
}

// 手动配板的布局：跟选身份网格同一套格子，只是横向起点 / 行距不同（原来手调的那几个数）
void BOTC_RsLayout () {
    int j;
    int t;
    int k;
    int cap;
    int page;
    int pages;
    int shown;
    int slot;
    int x;
    int y;
    BOTC_GridBuildCat();
    for (j = 0; j < 64; j += 1) {
        g_gridSlot[j] = -1;
        g_gridTeam[j] = 0;
        g_gridIdx[j] = 0;
    }
    slot = 0;
    for (t = 0; t < 4; t += 1) {
        cap = BOTC_GridCatCap(t);
        pages = BOTC_GridCatPages(t, cap);
        page = g_rsCatPage[t];
        if (page < 1) {
            page = 1;
        }
        if (page > pages) {
            page = pages;
        }
        g_rsCatPage[t] = page;
        k = (page - 1) * cap;
        shown = 0;
        while (k < g_gridCatN[t] && shown < cap && slot < 64) {
            g_gridSlot[slot] = g_gridCatRole[(t * 128) + k];
            g_gridTeam[slot] = t;
            g_gridIdx[slot] = shown;
            x = 300 + ((shown % 7) * 95);
            y = BOTC_GridBlockY(t) + ((shown / 7) * 110);
            DialogControlSetPosition(g_rsBtn[slot], PlayerGroupAll(), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_rsIcon[slot], PlayerGroupAll(), c_anchorTopLeft, x, y);
            DialogControlSetPosition(g_rsName[slot], PlayerGroupAll(), c_anchorTopLeft, x, y + 86);
            libNtve_gf_SetDialogItemImage(g_rsIcon[slot], BOTC_NightIconName(g_gridSlot[slot]), PlayerGroupAll());
            libNtve_gf_SetDialogItemText(g_rsName[slot], TextWithColor(StringToText(g_roleName[g_gridSlot[slot]]), BOTC_RoleTeamColor(g_gridSlot[slot])), PlayerGroupAll());
            DialogControlSetVisible(g_rsBtn[slot], PlayerGroupAll(), true);
            DialogControlSetVisible(g_rsIcon[slot], PlayerGroupAll(), true);
            DialogControlSetVisible(g_rsName[slot], PlayerGroupAll(), true);
            slot = slot + 1;
            k = k + 1;
            shown = shown + 1;
        }
        g_gridTeamN[t] = shown;
    }
    g_gridN = slot;
    for (j = slot; j < 64; j += 1) {
        DialogControlSetVisible(g_rsBtn[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_rsIcon[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_rsName[j], PlayerGroupAll(), false);
    }
    for (j = 0; j < 4; j += 1) {
        DialogControlSetPosition(g_rsSec[j], PlayerGroupAll(), c_anchorTopLeft, 30, BOTC_GridBlockY(j) - 30);
        DialogControlSetPosition(g_rsQuotaLbl[j], PlayerGroupAll(), c_anchorTopLeft, 150, BOTC_GridBlockY(j) - 30);
        DialogControlSetVisible(g_rsSec[j], PlayerGroupAll(), (g_gridTeamN[j] > 0));
        DialogControlSetVisible(g_rsQuotaLbl[j], PlayerGroupAll(), (g_gridTeamN[j] > 0));
        DialogControlSetPosition(g_rsCatPrev[j], PlayerGroupAll(), c_anchorTopLeft, 1032, BOTC_GridBlockY(j) - 31);
        DialogControlSetPosition(g_rsCatNext[j], PlayerGroupAll(), c_anchorTopLeft, 1076, BOTC_GridBlockY(j) - 31);
    }
}

void BOTC_BuildRoleSet () {
    int j;
    int x;
    int y;
    g_rsOpenBtn = BOTC_NewButton(g_grimDlg, 164, 42, 646, 880, "手动配板");
    DialogControlSetVisible(g_rsOpenBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rsOpenBtn, PlayerGroupSingle(g_teller), true);

    DialogCreate(1170, 900, c_anchorCenter, 225, -70, false);
    g_rsDlg = DialogLastCreated();
    DialogSetVisible(g_rsDlg, PlayerGroupAll(), false);
    g_rsTitle = BOTC_NewLabel(g_rsDlg, 900, 30, 16, 8, StringToText("手动配板：挑好本局出场的角色，再点【发给座位】"));
    libNtve_gf_SetDialogItemStyle(g_rsTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_rsTitle, false, PlayerGroupAll());

    for (j = 0; j < 4; j += 1) {
        g_rsSec[j] = BOTC_NewLabel(g_rsDlg, 100, 26, 30, 46, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_rsSec[j], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_rsSec[j], false, PlayerGroupAll());
        g_rsQuotaLbl[j] = BOTC_NewLabel(g_rsDlg, 840, 26, 140, 46, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_rsQuotaLbl[j], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_rsQuotaLbl[j], false, PlayerGroupAll());
        g_rsCatPage[j] = 1;
        g_rsCatPrev[j] = BOTC_NewButton(g_rsDlg, 38, 22, 1032, 46, "<");
        g_rsCatNext[j] = BOTC_NewButton(g_rsDlg, 38, 22, 1076, 46, ">");
        DialogControlSetVisible(g_rsCatPrev[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_rsCatNext[j], PlayerGroupAll(), false);
    }
    DialogControlSetPosition(g_rsSec[0], PlayerGroupAll(), c_anchorTopLeft, 30, 46);
    DialogControlSetPosition(g_rsSec[1], PlayerGroupAll(), c_anchorTopLeft, 30, 336);
    DialogControlSetPosition(g_rsSec[2], PlayerGroupAll(), c_anchorTopLeft, 30, 496);
    DialogControlSetPosition(g_rsSec[3], PlayerGroupAll(), c_anchorTopLeft, 30, 656);
    DialogControlSetPosition(g_rsQuotaLbl[0], PlayerGroupAll(), c_anchorTopLeft, 150, 46);
    DialogControlSetPosition(g_rsQuotaLbl[1], PlayerGroupAll(), c_anchorTopLeft, 150, 336);
    DialogControlSetPosition(g_rsQuotaLbl[2], PlayerGroupAll(), c_anchorTopLeft, 150, 496);
    DialogControlSetPosition(g_rsQuotaLbl[3], PlayerGroupAll(), c_anchorTopLeft, 150, 656);
    libNtve_gf_SetDialogItemText(g_rsSec[0], TextWithColor(StringToText("镇民"), Color(0, 191, 255)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_rsSec[1], TextWithColor(StringToText("外来者"), Color(0, 191, 255)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_rsSec[2], TextWithColor(StringToText("爪牙"), Color(255, 69, 0)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_rsSec[3], TextWithColor(StringToText("恶魔"), Color(255, 0, 0)), PlayerGroupAll());

    // 建 64 格（位置 / 图标 / 名字 由 BOTC_RsLayout 按当前板子摆）
    for (j = 0; j < 64; j += 1) {
        g_rsBtn[j] = BOTC_NewButton(g_rsDlg, 85, 85, 300, 76, "");
        libNtve_gf_CreateDialogItemImage(g_rsDlg, 85, 85, c_anchorTopLeft, 300, 76, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_rsIcon[j] = DialogControlLastCreated();
        DialogControlSetSize(g_rsIcon[j], PlayerGroupAll(), 85, 85);
        libNtve_gf_SetDialogItemAcceptMouse(g_rsIcon[j], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_rsIcon[j], "botc_blank.dds", PlayerGroupAll());
        g_rsName[j] = BOTC_NewLabelC(g_rsDlg, 85, 20, 300, 162, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_rsName[j], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_rsName[j], false, PlayerGroupAll());
    }
    BOTC_RsLayout();
    g_rsRandomBtn = BOTC_NewButton(g_rsDlg, 240, 40, 300, 840, "随机选择");
    g_rsDealBtn = BOTC_NewButton(g_rsDlg, 240, 40, 560, 840, "发给座位");
    g_rsCloseBtn = BOTC_NewButton(g_rsDlg, 180, 40, 820, 840, "关闭");
}
void BOTC_PickChoose (int ob, int idx) {
    int alcSeat;
    int infoSeat;
    int attachSeat;
    int gobSeat;
    bool gobSelf;
    bool gobRebuttal;
    int q;
    if (idx >= 0 && idx < 64) {
        idx = g_pickSlotRole[(ob * 64) + idx];
    }
    // 【伪造魔典 · 改身份】（用户 2026-11-07）：只写伪造数据，绝不碰真实魔典 / 真实对局。
    if (g_pickMode[ob] == 53) {
        q = g_pickWho[ob];
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickWho[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (q >= 2 && q <= 13) {
            if (idx >= 0) {
                g_fakeMark[q] = idx + 1;
            }
            else {
                g_fakeMark[q] = 0;
            }
            BOTC_FakeRender();
        }
        return;
    }
    // 【帽匠 · 茶会换角色】（用户 2026-11-09）：模式 54，只改被询问那一位的真实身份。
    if (g_pickMode[ob] == 54) {
        q = g_pickWho[ob];
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickWho[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx < 0) {
            BOTC_PmStore(g_teller, "【帽匠】这一位保持不变。");
            BOTC_HatRoleNext();
            return;
        }
        if (!BOTC_HatRoleApply(q, idx)) {
            BOTC_HatRoleOpenGrid(q);
            return;
        }
        BOTC_HatRoleNext();
        return;
    }
    // 【获得别人能力】（用户 2026-11-03）：失忆者 / 食人族 / 变脸师 / 小精灵 / 哲学家嵌套。
    //   选角色不再改自身身份，也不打「是哲学 / 是炼金术士」token，直接把能力挂到目标座位。
    attachSeat = g_pickAttachSeat[ob];
    if (attachSeat > 0) {
        q = g_pickMode[ob];            // 21 / 36 = 炼金术士能力者借爪牙能力
        g_pickAttachSeat[ob] = 0;
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_AttachGrantOrNest(attachSeat, idx);
            // 【小精灵获得能力】（用户 2026-11-10）：确认获得后把目标身上的「疯狂」换成本人身上的「获得能力」token。
            if (q == 49 && attachSeat >= 2 && attachSeat <= 13) {
                if (g_pixieSeatBy[attachSeat] > 0 && g_pixieSeatBy[attachSeat] <= 13) {
                    g_tokOn[(((g_teller * 14) + g_pixieSeatBy[attachSeat]) * 256) + 116] = false;
                }
                g_tokOn[(((g_teller * 14) + attachSeat) * 256) + 117] = true;
                BOTC_GrimRender(g_teller);
            }
            // 【炼金术士能力者】借到爪牙后，在私聊里告诉他获得的是谁的能力
            if ((q == 21 || q == 36) && BOTC_RoleTeam(idx) == 2 && attachSeat >= 2 && attachSeat <= 13) {
                BOTC_PmInfo(g_who[attachSeat], "【信息】你得知" + g_roleName[idx]);
            }
        }
        else {
            BOTC_AttachCancel(attachSeat);
        }
        return;
    }
    // 【使用技能】模式 52（用户 2026-11-06）：说书人选定角色后，走正常夜间行动流程。
    if (g_pickMode[ob] == 52) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        g_pickWho[ob] = 0;
        if (idx >= 0) {
            BOTC_TellerCastRole(idx);
        }
        return;
    }
    if (g_pickMode[ob] == 43) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_RascalPick(g_pickWho[ob], idx);
        }
        g_pickWho[ob] = 0;
        return;
    }
    // 【送葬者 / 守鸦人】模式 42：说书人选择角色后直接私聊告诉被唤醒的玩家。
    if (g_pickMode[ob] == 42) {
        infoSeat = g_pickWho[ob];
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        g_pickWho[ob] = 0;
        if (idx >= 0 && infoSeat >= 1 && infoSeat <= 13) {
            BOTC_PmInfo(g_who[infoSeat], "【信息】你得知" + g_roleName[idx] + "。");
            BOTC_PmStore(g_teller, "【角色信息】已告诉 " + BOTC_NameStr(infoSeat) + "：你得知" + g_roleName[idx] + "。");
        }
        return;
    }
    // 【瘟疫医生】模式 39：从当前板子的爪牙中选择说书人获得的能力。
    if (g_pickMode[ob] == 39) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_PlagueDoctorPick(idx);
        }
        else {
            if (ob == g_teller) {
                BOTC_PmStore(g_teller, "【瘟疫医生】说书人放弃了这个爪牙能力。");
            }
            g_pdPick = false;
            BOTC_PlagueDoctorJinxClear();
        }
        return;
    }
    // 【瘟疫医生×男爵】模式 40：选择第 N 名玩家要变成的外来者。
    if (g_pickMode[ob] == 40) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_PlagueDoctorBaronPick(idx);
        }
        else {
            BOTC_PlagueDoctorJinxEnd(ob);
        }
        return;
    }
    // 【赋予能力】模式 34：任意角色都可选，只记录待赋予的能力。
    if (g_pickMode[ob] == 34) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            g_grantRoleSel = idx + 1;
        }
        else {
            g_grantRoleSel = 0;
        }
        if (g_grantRoleSel > 0) {
            libNtve_gf_SetDialogItemText(g_grantRoleBtn, StringToText(g_roleName[g_grantRoleSel - 1]), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_grantRoleBtn, StringToText("选择能力"), PlayerGroupSingle(g_teller));
        }
        DialogSetVisible(g_grantDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    // 【科怪 × 哲学家 / 炼金术士】模式 35 / 36：嵌套选择，不改恶魔牌面。
    if (g_pickMode[ob] == 35 || g_pickMode[ob] == 36) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_BoffinNestedPick(g_pickWho[ob], idx);
        }
        else {
            g_boffinDoneBy[(g_pickWho[ob] * 14) + g_boffinTargetBy[g_pickWho[ob]]] = true;
            BOTC_PmStore(g_teller, BOTC_NameStr(g_boffinTargetBy[g_pickWho[ob]]) + " 选择了 不发动");
        }
        return;
    }
    // 【科学怪人（132）】模式 32：首夜由说书人选择恶魔借用哪个不在场善良角色的能力
    if (g_pickMode[ob] == 32) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_BoffinPick(idx);
        }
        return;
    }
    // 【疯子·假科学怪人能力】（用户 2026-11-10）模式 33：说书人给疯子挑一个「假的善良角色」。
    if (g_pickMode[ob] == 33) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_LunFakeAbilPick(idx);
        }
        else {
            BOTC_PmStore(g_teller, "【疯子·假能力】已跳过，这次不给疯子假能力。");
        }
        return;
    }
    // 【奥赫（134）】模式 30：直接选择一个角色；-1 = 今晚不发动
    if (g_pickMode[ob] == 30) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx < 0) {
            BOTC_OjoDecline(BOTC_PosOf(ob));
        }
        else {
            BOTC_OjoPick(BOTC_PosOf(ob), idx);
        }
        return;
    }

    // 【发送特定信息 · 玩家号 + 身份】（用户 2026-10-21）：模式 29 = 选第 N 个身份。
    if (g_pickMode[ob] == 29) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (g_specPickSlot >= 0 && g_specPickSlot <= 5) {
            if (idx >= 0) {
                g_specRoleSel[g_specPickSlot] = idx + 1;
            }
            else {
                g_specRoleSel[g_specPickSlot] = 0;
            }
        }
        // 【发送不在场身份 · 独立面板】（用户 2026-11-04）：选完角色回到独立面板，不自动跳收件人
        if (g_specBluffOn) {
            g_specMode = 6;
            BOTC_MBluffRender();
            DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
            DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), true);
            return;
        }
        g_specMode = 3;
        BOTC_SpecSeatRender();
        DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    // 【首夜不在场身份弹窗】（用户 2026-11-04）：模式 50 = 首夜弹窗的 3 个角色槽
    if (g_pickMode[ob] == 50) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (g_pickBluffSlot[ob] >= 0 && g_pickBluffSlot[ob] <= 2) {
            if (idx >= 0) {
                g_bluffPick[g_pickBluffSlot[ob]] = idx + 1;
            }
            else {
                g_bluffPick[g_pickBluffSlot[ob]] = 0;
            }
        }
        BOTC_BluffAskRender();
        return;
    }
    // 【全员追忆 · 猜角色】（用户 2026-11-06）：模式 51，选完角色立即比对真身份并反馈。
    if (g_pickMode[ob] == 51) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            BOTC_GuessRoleResolve(ob, idx);
        }
        return;
    }
    // 玩家 + 角色组合面板：身份网格只回填角色，不直接发动技能。
    if (g_pickMode[ob] == 41) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            g_skillRoleSel[g_pickWho[ob]] = idx + 1;
        }
        BOTC_SkillRender(g_pickWho[ob]);
        DialogSetVisible(g_skillDlg[g_pickWho[ob]], PlayerGroupSingle(ob), true);
        return;
    }
    // 赌徒（27）「猜角色」模式：必须放在最前面（下面第一行会把格子号换成身份，-1 会越界）
    if (g_pickMode[ob] == 4) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        if (idx < 0) {
            BOTC_GambleCancel(BOTC_PosOf(ob));
        }
        else {
            BOTC_GambleGuess(BOTC_PosOf(ob), idx);
        }
        return;
    }
    // 侍臣（29）「选一个角色」模式：和模式 4 一样必须放在最前面（-1 不能拿去当数组下标）
    if (g_pickMode[ob] == 5) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        if (idx < 0) {
            BOTC_Notice(g_teller, "【侍臣】" + BOTC_NameStr(BOTC_PosOf(ob)) + " 今晚不发动技能。");
            BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(BOTC_PosOf(ob)) + " 今晚不发动技能。");
        }
        else {
            BOTC_CourtierPick(BOTC_PosOf(ob), idx);
        }
        return;
    }
    // 【测试】说书人自己选身份（-t）：点一个图标 = 拿这个身份（用户 2026-09-20）
    // 【哲学家（56）选角色】（用户 2026-09-21）：模式 8，和侍臣一样必须放在函数最前面
    // 【说书人给哲学家定认知】（用户 2026-09-21）：模式 9
    // 【说书人给筑梦师选两个角色】（用户 2026-09-21）：模式 10 = 善良 / 11 = 邪恶
    // 【杂耍艺人公开猜测选身份】（用户 2026-09-21）：模式 13 ---- 选完回到他那 5 格面板
    // 【麻脸巫婆（67）】（用户 2026-09-21）：选完角色 → 真的把他变成那个角色（在场就无事发生）
    //   她中毒 / 酒鬼时这一次不生效（用户 2026-09-21）
    // 【炼金术士(95) 本体】（用户 2026-11-10）：选完借到的爪牙 → 只说书人真值行改成它 + 打「是炼金术士」token + 私聊告知（**不发身份转变提示**；本人魔典仍显示炼金术士）
    if (g_pickMode[ob] == 21) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        // 【炼金术士(95)】（用户 2026-10-03）：面板由说书人（玩家1）操作，被借能力的座位存在 g_pickWho[ob]
        alcSeat = g_pickWho[ob];
        if (alcSeat < 2 || alcSeat > 13) {
            alcSeat = ob;
        }
        if (idx >= 0 && alcSeat >= 2 && alcSeat <= 13) {
            // 【真身酒鬼 / 提线木偶的炼金术士】（用户 2026-11-11）：照常选、照常借到能力，
            //   但说书人魔典上的角色标记不改、不打「是炼金术士」token；夜间借来的能力仍会被唤醒，
            //   按醉酒处理，不会正确生效。
            if (BOTC_SeatTrueRole(alcSeat) == 14 || BOTC_SeatTrueRole(alcSeat) == 93) {
                BOTC_AttachGrant(alcSeat, idx, false);
                BOTC_PmInfo(g_who[alcSeat], "【信息】你得知" + g_roleName[idx]);
                BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(alcSeat) + " 真身是酒鬼/提线木偶：借到的是【" + g_roleName[idx] + "】，能力已挂上但按醉酒处理（不会正确生效），说书人魔典上的角色标记不改。");
                return;
            }
            // 【炼金术士 · 能力失效】（用户 2026-11-11）：中毒 / 醉酒 → 这一次借不到能力，
            //   不改说书人魔典标记、不打「是炼金术士」token、不发信息。
            if (!BOTC_SkillWorks(alcSeat)) {
                BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(alcSeat) + " 中毒/醉酒：能力失效，未借到任何能力。");
                return;
            }
            // 【炼金术士 × 间谍/寡妇相克】（用户 2026-11-06）：不能借用，改为该角色一定在场，让他重选。
            if (idx == 18 || idx == 75) {
                BOTC_PmStore(g_teller, "【炼金术士×间谍/寡妇】按相克规则不能借用该能力，改为该角色一定在场；请重新选择另一只爪牙。");
                BOTC_AlcBorrowOpen(alcSeat);
                return;
            }
            g_alcBorrow = idx;
            // 【炼金术士改说书人魔典标记】（用户 2026-11-10）：只有真身炼金术士才改说书人真值行 +
            //   放「是炼金术士」token；借来的炼金术士能力（变脸师 / 食人族等）只更新能力层，不二次改标记。
            if (g_faceShow[alcSeat] != 96 && g_grantRoleBy[alcSeat] != 96) {
                g_mark[(g_teller * 14) + alcSeat] = idx + 1;
                g_tokOn[(((g_teller * 14) + alcSeat) * 256) + 123] = true;
            }
            BOTC_SeatStateSync();
            BOTC_GrimRender(g_teller);
            BOTC_GrimRender(g_who[alcSeat]);
            BOTC_PmInfo(g_who[alcSeat], "【信息】你得知" + g_roleName[g_alcBorrow]);
            BOTC_PmStore(g_teller, "【炼金术士】" + BOTC_NameStr(alcSeat) + " 借到的是【" + g_roleName[g_alcBorrow] + "】（说书人魔典标记已换成该角色并放置「是炼金术士」标记；他本人魔典仍显示炼金术士）。");
        }
        return;
    }
    // 【国王（104）】（用户 2026-10-10）：选一个存活角色 → 私聊告诉他「那个角色还活着」
    if (g_pickMode[ob] == 22) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        if (idx >= 0) {
            BOTC_KingAnswer(g_pickWho[ob], idx);
        }
        else {
            BOTC_PmStore(g_teller, "【国王】这次没给信息。");
        }
        return;
    }
    // 【暴风捕手 · 发送特定信息】（用户 2026-10-11）：选一个角色 → 把同款「你得知 A 是 B」发出去
    if (g_pickMode[ob] == 23) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_specMode = 0;
        if (idx >= 0) {
            BOTC_SpecStormPick(g_pickWho[ob], idx);
            return;
        }
        BOTC_PmStore(g_teller, "【暴风捕手】这次没发。");
        return;
    }
    // 炼金术士声称第一步：从固定的「间谍 / 寡妇」入口里选择要猜的爪牙。
    if (g_pickMode[ob] == 20) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        if (idx >= 0) {
            BOTC_AlchemistPickRole(ob, idx);
        }
        else {
            BOTC_AlchemistPickRole(ob, 0);
        }
        return;
    }
    if (g_pickMode[ob] == 19) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx < 0) {
            BOTC_EngCancel();
            return;
        }
        BOTC_EngPickResult(idx);
        return;
    }
    if (g_pickMode[ob] == 18) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        if (idx >= 0) {
            BOTC_RangerPick(idx);
        }
        return;
    }
    // 【悟道者（118）】（用户 2026-10-16）：26 = 他以为的外来者卡 / 27 = 被邪恶能力碰了之后变成哪个镇民
    if (g_pickMode[ob] == 26) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        if (idx >= 0) {
            BOTC_WudOutsiderPick(idx);
        }
        return;
    }
    if (g_pickMode[ob] == 27) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        g_pickMode[ob] = 0;
        if (idx >= 0) {
            BOTC_WudChangePick(idx);
        }
        return;
    }
    if (g_pickMode[ob] == 15) {
        // 【先收掉这一层，再结算】（用户 2026-10-19 报「麻脸熬酒鬼选角色没用」）：
        //   酒鬼 / 疯子 / 悟道者会在 BOTC_HagApply() 里紧接着打开「他以为的身份」面板（mode 16）；
        //   原来这里在调用**之后**又关面板 + 把 mode 清 0 → 刚打开的那一面被立刻关掉，选角色自然没反应。
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx >= 0) {
            if (BOTC_SeatImpaired(BOTC_PosOf(ob))) {
                BOTC_Notice(g_teller, "【麻脸巫婆】她中毒/酒鬼 → 这一次不生效，没有改造。");
                BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(BOTC_PosOf(ob)) + " 中毒/酒鬼 → 改造无效。");
            }
            else {
                BOTC_HagApply(g_hagWho, idx);
            }
        }
        return;
    }
    // 【麻脸巫婆：酒鬼 / 疯子以为自己是哪个角色】（用户 2026-09-21）
    if (g_pickMode[ob] == 16) {
        if (idx >= 0) {
            BOTC_HagBelieve(idx);
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        return;
    }
    // 【食人族（74）】（用户 2026-09-23）：只挑恶魔
    if (g_pickMode[ob] == 17) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        if (idx < 0) {
            g_cannRole = 0;
            g_cannKind = 0;
            g_cannSeat = 0;
            g_cannSrc = 0;
        }
        else {
            BOTC_CannPick(idx);
        }
        return;
    }
    // 【洗脑师（66）】（用户 2026-09-21）：选完善良角色 → 给目标打「疯狂」标记 + 告诉他
    if (g_pickMode[ob] == 14) {
        if (idx >= 0) {
            BOTC_CerenApply(g_pickWho[ob], g_cerenWho, idx);
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        return;
    }
    // 【杂耍艺人公开猜测选身份】（用户 2026-09-21）：模式 13 ---- 选完回到他那 5 格面板
    //   ⚠ 这一段以前被多出来的一个花括号嵌在别的模式里面，结果模式 15 / 16 / 14 全变成死代码（用户 2026-09-21 报）
    if (g_pickMode[ob] == 13) {
        if (idx >= 0 && g_juggRow >= 1 && g_juggRow <= 5) {
            g_juggRole[(ob * 5) + g_juggRow - 1] = idx;
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_JugglerRowRender(ob);
        DialogSetVisible(g_juggDlg, PlayerGroupSingle(ob), true);
        return;
    }
    // 【首夜信息位选身份】（用户 2026-09-21）：模式 12
    if (g_pickMode[ob] == 12) {
        if (idx >= 0) {
            g_miFnRole = idx;
            // 【小精灵】单独记一份（索引 + 1），避免角色 0（洗衣妇）与「还没选」混淆。
            if (g_miRole == 86) {
                g_pixiePickRole = idx + 1;
            }
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_MiFnRefresh();
        return;
    }
    if (g_pickMode[ob] == 10 || g_pickMode[ob] == 11) {
        if (idx >= 0) {
            if (g_pickMode[ob] == 10) {
                g_miRoleA = idx;
            }
            else {
                g_miRoleB = idx;
            }
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_MiDreamerRefresh();
        return;
    }
    if (g_pickMode[ob] == 9) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        g_pickTeam = -1;
        if (idx < 0) {
            g_tokOn[(((g_teller * 14) + g_philoSeat) * 256) + 70] = false;
            BOTC_PmStore(g_teller, "【哲学家】说书人取消了这次选择，他下个夜晚还可以再选。");
        }
        else {
            BOTC_PhiloBelieve(g_philoSeat, idx);
        }
        return;
    }
    if (g_pickMode[ob] == 8) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        if (idx < 0) {
            BOTC_Notice(ob, "【哲学家】这次先不选（下个夜晚还可以再选）。");
        }
        else {
            BOTC_PhiloPick(BOTC_PosOf(ob), idx);
        }
        return;
    }
    if (g_pickMode[ob] == 6) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(ob));
        g_pickMode[ob] = 0;
        if (idx < 0) {
        BOTC_PmStore(g_teller, "取消了「说书人自己拿身份」。");
        }
        else {
            BOTC_TestSelfRole(idx);
        }
        return;
    }

    if (ob == g_teller && g_pickWho[ob] == 1 && idx < 0) {
        BOTC_TestSelfRole(-1);
        BOTC_Notice(g_teller, "说书人的身份已清空。");
        return;
    }
    if (idx < 0) {
        if (g_pickMode[ob] == 0 && g_pickWho[ob] >= 2 && g_pickWho[ob] <= 13) {
            BOTC_SetSeatRole(ob, g_pickWho[ob], -1);
            if (ob == g_teller) {
                g_pickForceAlign = -1;
                BOTC_PickApplyAlign(g_pickWho[ob]);
            }
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
            BOTC_GrimRender(ob);
            if (ob == g_teller) {
                BOTC_PmStore(g_teller, "【说书人】清空了 " + BOTC_NameStr(g_pickWho[ob]) + " 的身份。");
            }
            return;
        }
        return;
    }
    // 不在场身份：同一个身份面板复用，选的坑位不同
    if (g_pickMode[ob] == 1) {
        if (idx < 0) {
            g_bluffPick[g_pickBluffSlot[ob]] = 0;
        }
        else {
            g_bluffPick[g_pickBluffSlot[ob]] = idx + 1;
        }
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        BOTC_BluffRender();
        return;
    }
    // 伪装身份（口供）：只有说书人用，选完关掉面板
    if (g_pickMode[ob] == 2) {
        if (idx < 0) {
            g_claim[g_pickWho[ob]] = -1;
            BOTC_PmStore(g_teller, "伪装：" + BOTC_NameStr(g_pickWho[ob]) + " 取消了自称的身份。");
            if (ob != g_teller) {
                BOTC_Notice(ob, "已取消你自称的身份（伪装）。");
            }
        }
        else {
            g_claim[g_pickWho[ob]] = idx;
            BOTC_PmStore(g_teller, "伪装：" + BOTC_NameStr(g_pickWho[ob]) + " 自称是 " + g_roleName[idx] + "。");
            if (ob != g_teller) {
                // 玩家自己设的时候要给本人一个明确回执（BOTC_Notice 会同时写进他自己的私聊日志 + 弹字幕）
                BOTC_Notice(ob, "你已设置伪装身份：自称是「" + g_roleName[idx] + "」。点了【清除身份】可以取消。");
            }
        }
        BOTC_ClaimBtnRender();         // 按钮文字跟着更新成「伪装：X」
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        return;
    }
    // 声称（白天用；现在只有猎手）：选了猎手就进入「点头像」阶段
        // 【ob 是客户端】（用户 2026-10-07）：下面这些座位函数要**格子**，统一用 BOTC_PosOf(ob)。
    if (g_pickMode[ob] == 28) {
        BOTC_DrossPick(idx);
        return;
    }
    if (g_pickMode[ob] == 3) {
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
        // 【模式 3 同时服务白天声称与死后声称】（用户 2026-10-26）：
        //   点击入口上方已经从该玩家 64 格快照读出了真实角色，不能再按原始槽位
        //   二次映射。槽位 58 在白天是造谣者、在死亡面板却是呆瓜，硬映射会把
        //   点呆瓜解释成点造谣者。
        // 【声称/猜测】（用户 2026-11-04）：第二行两个公开猜测入口。
        //   点击后进入「点头像」阶段，真正的有效性只在 BOTC_DeclareSlay 里判断。
        if (idx == 152) {
            if (g_pedantGuessUsed[ob]) {
                BOTC_Notice(ob, "你这一局已经用过「猜书生」了。");
                return;
            }
            g_declarePick[ob] = true;
            g_guessKind[ob] = 1;
            BOTC_DeclareRender();
            BOTC_Notice(ob, "点一个玩家头像：你猜他是【书生】。再点一次【声称/猜测】可以取消。");
            return;
        }
        if (idx == 109) {
            if (g_puzzleGuessUsed[ob]) {
                BOTC_Notice(ob, "你这一局已经用过「猜醉酒」了。");
                return;
            }
            g_declarePick[ob] = true;
            g_guessKind[ob] = 2;
            BOTC_DeclareRender();
            BOTC_Notice(ob, "点一个玩家头像：你对他说出你的猜想。再点一次【声称/猜测】可以取消。");
            return;
        }
        // 【防刷屏 · 声称冷却】（用户 2026-11-06）：真正的「声称」两次之间至少 15 秒；
        //   上面的猜测入口不占冷却，所以这里只拦非猜测入口。
        if (!BOTC_DeclareIsGuess(idx)) {
            if (BOTC_DeclareCdBlocked(ob)) {
                return;
            }
        }
        // 维齐尔：只做公开声称，能力结算由说书人手工完成。
        if (idx == 141) {
            BOTC_VizierClaim(ob);
            return;
        }
        if (idx == 149) {
            BOTC_AlsaahirOpen(ob);
            return;
        }
        // 【全员追忆 · 猜角色】（用户 2026-11-06）：slot 51 传 role 0 作占位，这里截获后打开猜角色面板。
        if (idx == 0 && g_board == 13) {
            g_declarePick[ob] = false;
            g_guessKind[ob] = 0;
            BOTC_GuessRoleOpen(ob);
            return;
        }
        // 【哥布林(99)】（用户 2026-11-04）：每个人每天都能声称一次，但只有真正的哥布林声明才有效。
        //   只能在「自己提名自己」的提名流程中，或被别人提名后的反驳阶段声称；投票倒计时开始后不能再声称。
        if (idx == 99) {
            gobSeat = BOTC_PosOf(ob);
            gobSelf = (g_nomFrom == gobSeat && g_nomTo == gobSeat);
            gobRebuttal = (g_nomTo == gobSeat);
            if (!gobSelf && !(gobRebuttal && g_phase == 4)) {
                BOTC_Notice(ob, "【哥布林】只能在你被提名后的反驳阶段，或你提名自己时声称。");
                return;
            }
            if (g_phase >= 5) {
                BOTC_Notice(ob, "【哥布林】投票倒计时开始后不能再声称。");
                return;
            }
            if (g_goblinClaimDay[gobSeat] == g_nightNum) {
                BOTC_Notice(ob, "【哥布林】今天你已经声称过了，每人每天只能声称一次。");
                return;
            }
            g_goblinClaimDay[gobSeat] = g_nightNum;
            g_goblinClaim[gobSeat] = true;
            BOTC_PubAnnounce(BOTC_NameStr(gobSeat) + " 公开声明自己是【哥布林】。");
            BOTC_DeclareCdSet(ob);
            // 【只有真哥布林能力才生效】（用户 2026-11-04）：任何人都能声称，但假声称 / 借不到能力的人
            //   不能给说书人「被处决就获胜」的错误提示；结算层在 BOTC_CheckWin 里另有 BOTC_AbilityWorks 兜底。
            //   假声称不再给说书人私聊提醒（用户 2026-11-04）。
            if (BOTC_HasAbility(gobSeat, 99)) {
                if (BOTC_SeatImpaired(gobSeat)) {
                    BOTC_PmStore(g_teller, "【哥布林】" + BOTC_NameStr(gobSeat) + " 中毒/酒鬼 → 这次声明不生效（当天被处决也不算赢）。");
                }
                else {
                    BOTC_PmStore(g_teller, "【哥布林】" + BOTC_NameStr(gobSeat) + " 已公开声明：如果今天他被处决，他的阵营获胜。");
                    BOTC_Notice(g_teller, "【哥布林】他今天被处决的话 → 他的阵营获胜。");
                }
            }
            return;
        }
        // 【异教领袖（106）】（用户 2026-10-10）：公开声称 → 全员 20 秒投票
        if (idx == 106) {
            // 【提名环节一开始就不能声称】（用户 2026-10-12）：原来是「phase 2..6 才拦」，
            //   也就是**提名环节刚开、还没人发起提名（phase 1）**时还能声称 ---- 现在跟精神病患者同一口径：
            //   只要进了提名环节（g_phase != 0）就不给。
            if (g_phase != 0) {
                BOTC_Notice(ob, "【异教领袖】提名环节已经开始了：只能在提名阶段之前声称。");
                return;
            }
            // 【一天只能声称一次】（用户 2026-10-11，照造谣者 / 精神病患者那套）
            if (g_cultDeclDone[BOTC_PosOf(ob)]) {
                BOTC_Notice(ob, "你今天已经声称过【异教领袖】了：一天只能声称一次，等明天吧。");
                return;
            }
            // 【已经有一次教派提议在投票了】：这一次不算「用掉今天的声称」（跟 BOTC_CultStart 同一句口径）
            if (g_cultOn) {
                BOTC_Notice(ob, "已经有一次教派提议在投票了，等这一轮结束。");
                return;
            }
            // 【没能力也照开投票，只是不结算胜利】（用户 2026-10-11 明确）：
            //   谁都可以公开声称、走完 20 秒全员投票；但**只有真身有这个能力（而且清醒）的人**，
            //   全员同意才算他阵营获胜 —— 没这个能力的那个，投票走完什么都不发生（见 BOTC_CultEnd）。
            g_cultDeclDone[BOTC_PosOf(ob)] = true;   // 【今天这一次用掉了】（用户 2026-10-11）
            BOTC_PubAnnounce(BOTC_NameStr(BOTC_PosOf(ob)) + " 公开声称自己是【异教领袖】，提议所有人加入他的教派。");
            BOTC_DeclareCdSet(ob);
            BOTC_CultStart(BOTC_PosOf(ob));
            return;
        }
        // 【炼金术士 × 间谍/寡妇】：先选要猜间谍还是寡妇，再进入点座位阶段
        if (idx == 95) {
            BOTC_AlchemistAsk(ob);
            return;
        }
        if (idx == 10) {
            // 【猎手每天一次】（用户 2026-11-04）：已经声称过猎手的人当天再选它 → 直接拦掉。
            if (g_declareUsed[ob]) {
                BOTC_Notice(ob, "你今天已经声称过【猎手】了：每人每天只能声称一次。");
                return;
            }
            g_declarePick[ob] = true;
            BOTC_DeclareRender();
            BOTC_Notice(ob, "点一个玩家头像：你声称自己是【猎手】，并选择猎杀他。再点一次【声称】可以取消。");
        }
        if (idx == 28) {
            BOTC_GossipOpen(ob);         // 造谣者：弹出公开声明的输入框（用户 2026-09-25 报「点了没用」）
        }
        if (idx == 58) {
            BOTC_JugglerOpen(ob);        // 杂耍艺人：弹出公开猜测输入框（用户 2026-09-21）
        }
        if (idx == 84) {
            // 【精神病患者的声称只能在提名阶段之前】（用户 2026-09-26）：提名环节开了就用不了
            if (g_phase != 0) {
                BOTC_Notice(ob, "【精神病患者】的声称只能在提名阶段之前用：现在提名环节已经开始了。");
                return;
            }
            if (g_psyDay[BOTC_PosOf(ob)] != g_dayNum) {
                g_psyDone[BOTC_PosOf(ob)] = false;
            }
            if (g_psyDone[BOTC_PosOf(ob)]) {
                BOTC_Notice(ob, "你今天已经声称过【精神病患者】了：一天只能声称一次。");
                return;
            }
            g_declarePick[ob] = true;
            g_psyDeclare[ob] = true;
            BOTC_DeclareRender();
            BOTC_Notice(ob, "点一个玩家头像：你公开选择他。再点一次【声称】可以取消。");
        }
        if (idx == 82) {
            BOTC_DamselClick(ob);
            return;
        }
        if (BOTC_IsDeathClaimRole(idx)) {
            // 「死后声称」的角色（月之子 36 / 呆瓜 63）：**任何死人都能声称**，之后点头像 = 公开选一名存活玩家
            if (!BOTC_SeatDead(BOTC_PosOf(ob))) {
                BOTC_Notice(ob, "这是「死后声称」：你还活着，走不了这条。");
                return;
            }
            if (idx == 36) {
                if (!BOTC_DeadClaimDayOK(BOTC_PosOf(ob))) {
                    BOTC_Notice(ob, "【月之子】只能在你死亡公开的那个白天声称：白天死亡请在入夜前声称，夜间死亡请在天亮后的当天白天声称；之后的白天不再允许。");
                    return;
                }
                if (g_moonClaimed[BOTC_PosOf(ob)]) {
                    BOTC_Notice(ob, "你本局已经声称过【月之子】了：每名玩家全局只能声称一次，复活后才会重置。");
                    return;
                }
                if (g_moonDone[BOTC_PosOf(ob)]) {
                    BOTC_Notice(ob, "你已经声明过月之子了。");
                    return;
                }
                g_declarePick[ob] = true;
                g_moonDeclare[ob] = true;
                BOTC_DeclareRender();
                BOTC_Notice(ob, "点一个存活玩家的头像：你公开选择他 ---- 如果他是善良的，他会在今晚死亡。再点一次【声称】可以取消。");
            }
            else {
                if (!BOTC_DeadClaimDayOK(BOTC_PosOf(ob))) {
                    BOTC_Notice(ob, "【呆瓜】只能在你死亡公开的那个白天声称：白天死亡请在入夜前声称，夜间死亡请在天亮后的当天白天声称；之后的白天不再允许。");
                    return;
                }
                if (g_klutzClaimed[BOTC_PosOf(ob)]) {
                    BOTC_Notice(ob, "你本局已经声称过【呆瓜】了：每名玩家全局只能声称一次，复活后才会重置。");
                    return;
                }
                if (g_klutzDone[BOTC_PosOf(ob)]) {
                    BOTC_Notice(ob, "你已经声明过呆瓜了。");
                    return;
                }
                g_declarePick[ob] = true;
                g_klutzDeclare[ob] = true;
                BOTC_DeclareRender();
                BOTC_Notice(ob, "点一个存活玩家的头像：你公开选择他 ---- 如果他是邪恶的，你的阵营落败。再点一次【声称】可以取消。");
            }
        }
        return;
    }
    BOTC_SetSeatRole(ob, g_pickWho[ob], idx);
    if (ob == g_teller) {
        BOTC_PickApplyAlign(g_pickWho[ob]);
    }
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), false);
    BOTC_GrimRender(ob);
    if (ob == g_teller && idx == 93 && g_pickWho[ob] >= 2 && g_pickWho[ob] <= 13) {
        BOTC_MarionetteSync();
        if (g_started) {
            BOTC_ChangeRoleMsg(g_pickWho[ob], g_mark[(g_teller * 14) + g_pickWho[ob]] - 1);
        }
        return;
    }
    if (ob == g_teller && g_pickWho[ob] == 1) {
        BOTC_TestSelfRole(idx);
        return;
    }
    if (ob == g_teller && g_started && g_pickWho[ob] >= 2 && idx >= 0) {
        BOTC_GrimRender(g_who[g_pickWho[ob]]);
        BOTC_ChangeRoleMsg(g_pickWho[ob], idx);
        BOTC_PmStore(g_teller, "【说书人】把 " + BOTC_NameStr(g_pickWho[ob]) + " 改成了 " + g_roleName[idx] + "。");
    }
    // 小恶魔自刀后的传位：说书人把某个人改成【小恶魔】之后自动重新锁定身份编辑
    if (ob == g_teller && g_promoteOpen && idx == 21) {
        BOTC_PromoteTo(g_pickWho[ob]);
        g_promoteOpen = false;
        BOTC_Notice(g_teller, "小恶魔已经传给 " + BOTC_NameStr(g_pickWho[ob]) + "，身份重新锁定。");
        BOTC_PmStore(g_teller, "【天亮】说书人把小恶魔传给了 " + BOTC_NameStr(g_pickWho[ob]) + "。");
    }
}

// 写座位身份的唯一入口（不带锁）：idx < 0 表示清空，否则存 idx + 1。
// 将来的角色能力（红唇女郎 / 小恶魔）和智能说书人直接调它即可绕开 UI 锁。

// 【身份一变就重算的那些常驻标记】（用户 2026-10-14：「转变身份也检测一次 token，包括各种醉酒 / 中毒」）----
//   这一批标记全是「按座位现在的角色现算」的，所以身份一变（含「借能力」那几枚改真身的 token）就要整体重算：
//     诺-达鲺 80 中毒 / 涡流 84 信息错误 / 水手 26 免死 / 弄臣 29 首次未死 / 茶艺师 51 免死 /
//     暴风捕手 133 免死 / 哲学家 90 醉酒。
//   ⚠ 炼金术士（123）/ 哲学家（70）/ 食人族（97）/ 小怪宝（134）那几处要**在打完 token 之后再调一次** ----
//     因为前面的 `BOTC_SetSeatRole()` 会拿「还没打标记时的角色」先算一遍（那时他看着像刚借来的那只爪牙）。
void BOTC_BoffinRecipientSync () {
    int b;
    int q;
    for (b = 2; b <= 13; b += 1) {
        if (!BOTC_BoffinSourceIs(b)) {
            if (g_boffinChosenBy[b] || g_boffinRoleBy[b] > 0 || g_boffinTargetBy[b] > 0) {
                BOTC_BoffinClearSource(b);
            }
            continue;
        }
        if (!g_boffinChosenBy[b]) {
            continue;
        }
        q = g_boffinTargetBy[b];
        if (q >= 2 && q <= 13 && g_seatOn[q] && !BOTC_SeatDead(q) && BOTC_IsDemonSeat(q)) {
            continue;
        }
        g_boffinTargetBy[b] = 0;
        g_boffinAnnouncedBy[b] = 0;
        g_boffinChosenBy[b] = false;
        if (q >= 2 && q <= 13 && g_boffinActingSource[q] == b) {
            g_boffinActing[q] = false;
            g_boffinActingSource[q] = 0;
        }
        if (q >= 2 && q <= 13) {
            BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(q) + " 已不再是恶魔 → 移除 " + BOTC_NameStr(b) + " 赋予他的能力。");
        }
    }
}

// 【持续检测 · 村夫 / 半兽人 / 掮客】（用户 2026-11-10）：这三条都要求「角色中途上场 / 阵营中途变化」
//   时立刻重算，而不是只在正式开局设置里做一次；统一挂在 BOTC_SeatStateSync()、死亡记录与手动改 token 之后。
// 【村夫（105）· 醉酒标记 126】（用户 2026-11-11 重写）：
//   · 计数只认真实身份 BOTC_SeatTrueRole(i) == 105 且在场存活：哲学家 / 食人族 / 说书人赋予
//     的村夫能力不参与「村夫在场数量」计算（详情页规则细节），酒鬼 / 提线木偶的假村夫也不算。
//   · 该村夫离场（死亡 / 被换身份）即清除旧标记，不会留下两枚 126；场上仍有 ≥2 名存活村夫时
//     按持续检测改放到另一名村夫，不足两名就直接撤掉。
//   · 持有者还活着就保留原位置（说书人手动挪过的标记不被打回）；清醒村夫离场后，剩余的
//     醉酒村夫仍然保持醉酒（百科），所以不会因为人数掉到 1 就把标记收掉。
void BOTC_VillageSync () {
    int i;
    int n;
    int keep;
    int first;
    int cnt;
    int cur;
    if (!g_started) {
        return;
    }
    n = 0;
    keep = 0;
    first = 0;
    cnt = 0;
    cur = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 126]) {
            cnt = cnt + 1;
            cur = i;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        // 【变脸师】临时借来的「村夫」不算现场村夫（用户 2026-11-13）。
        if (BOTC_SeatRealRole(i) != 105) {
            continue;
        }
        n = n + 1;
        if (first == 0) {
            first = i;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 126]) {
            keep = i;
        }
    }
    // 现有标记仍在一名存活村夫身上 → 保留（只有一枚就不动，多枚则整理成一枚）
    if (keep >= 2) {
        if (cnt == 1) {
            return;
        }
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 126] = false;
        }
        g_tokOn[(((g_teller * 14) + keep) * 256) + 126] = true;
        BOTC_PmStore(g_teller, "【村夫】「醉酒（村夫）」旧标记已移走 → 保留在 " + BOTC_NameStr(keep) + "。");
        return;
    }
    // 没有有效持有者：先撤掉死亡 / 换身份留下的旧标记
    if (cnt >= 1) {
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 126] = false;
        }
        BOTC_PmStore(g_teller, "【村夫】" + BOTC_NameStr(cur) + " 已离场 → 撤掉「醉酒（村夫）」。");
    }
    // 持续检测：村夫数量增加到 2 人且尚未放置 → 立即补一枚
    if (n >= 2 && first >= 2) {
        g_tokOn[(((g_teller * 14) + first) * 256) + 126] = true;
        BOTC_PmStore(g_teller, "【村夫】场上有多名村夫 → " + BOTC_NameStr(first) + " 获得「醉酒（村夫）」；要换人直接挪标记。");
    }
}

// 【半兽人（107）】正式开局已经随机打过「失足」127；中途被麻脸巫婆 / 理发师 / 舞蛇人 / 说书人改动上场时，
//   只要场上还没有这枚标记，就按开局的规则补打一枚（标记本身本局永久保留，不随来源离场清除）。
void BOTC_HalfOrcSync () {
    int i;
    int k;
    int n;
    int pick;
    // 【酒鬼 / 提线木偶】（用户 2026-11-11）：只认真身是半兽人，假半兽人不补打「失足」127。
    if (!g_started || BOTC_SeatOfRole(107) < 2) {
        return;
    }
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 127]) {
            return;
        }
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatAlign(i) != 0) { continue; }
        if (BOTC_SeatRealRole(i) == 107) { continue; }
        n = n + 1;
    }
    pick = 0;
    if (n > 0) {
        k = RandomInt(1, n);
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_SeatRealRole(i) == 107) { continue; }
            k = k - 1;
            if (k <= 0) { pick = i; break; }
        }
    }
    if (pick >= 2) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 127] = true;
        BOTC_PmStore(g_teller, "【半兽人】中途上场 → 补打「失足」标记：" + BOTC_NameStr(pick) + "。");
    }
}

// 【掮客（159）】熟客标记 195 只在「能力可用 + 两名熟客阵营一致」时保留；
//   阵营中途被改动、掮客死亡 / 醉酒 / 失去能力时，立即整套失效并移除标记（不再等天亮）。
void BOTC_BrokerSync () {
    if (!g_started || !g_isNight || !g_brokerOn || g_brokerForced) {
        return;
    }
    if (BOTC_BrokerActive()) {
        return;
    }
    BOTC_BrokerClear("阵营变化");
    BOTC_PmStore(g_teller, "【掮客】两名熟客的阵营已不一致（或掮客已失效）→ 本夜熟客失效，已移除熟客标记。");
}

void BOTC_SeatStateSync () {
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_SailorSync();
    BOTC_FoolSync();
    BOTC_TeaLadySync();
    BOTC_StormSync();
    BOTC_VizierSync();
    BOTC_PhiloDrunkSync();
    BOTC_BoffinRecipientSync();     // 【科学怪人】旧恶魔死亡 / 被换身份后，清空所赋能力，下一夜重新选新恶魔（用户 2026-11-02）
    BOTC_BoffinSyncKnowledge();
    BOTC_DamselPoisonSync();
    BOTC_RascalSync();
    BOTC_LeviathanTokenWin();
    BOTC_SkinSourceCheck();
    BOTC_BartenderSync();
    BOTC_VillageSync();             // 【村夫】中途变成村夫 / 村夫数量变化时重算醉酒标记
    BOTC_HalfOrcSync();             // 【半兽人】中途上场时补「失足」标记
    BOTC_BrokerSync();              // 【掮客】熟客阵营中途变化时立即失效
}

// 【夜序插入·例外】炼金术士借到科学怪人能力时允许插队（帽匠夜间死亡另走 g_hatWaitOrd 的击杀阶段插入）。
//   其他身份 / 能力转变必须等正常夜序。
void BOTC_QueueWakeInsert (int q, int refOrd, int newOrd) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_started || !g_isNight) {
        g_insertWake[q] = false;
        return;
    }
    g_insertWake[q] = false;
    if (newOrd <= 0 || refOrd <= 0 || newOrd >= refOrd) {
        return;
    }
    g_insertWake[q] = true;
    g_autoWoke[q] = false;
    g_testWoke[q] = false;
    BOTC_PmStore(g_teller, "【夜序插入】" + BOTC_NameStr(q) + " 获得更早夜序的身份/能力，将优先插入今晚行动。");
}

// 【全员追忆】：玩家只看四类占位身份，真实身份始终只在说书人那一行。
int BOTC_AmnesiaMaskRole (int roleIdx) {
    int team;
    if (g_board != 13 || roleIdx < 0 || roleIdx >= 143) {
        return roleIdx;
    }
    // 认知覆盖按「他以为的身份」所属类别发占位卡，不能按真身类别。
    // 随机发牌通常已把认知身份写进 g_mark；这里同时兜住手动配板和直接指定本体的路径。
    if (roleIdx == 14 || roleIdx == 93) { return 143; }   // 酒鬼 / 提线木偶：以为自己是好人
    if (roleIdx == 38) { return 146; }                    // 疯子：以为自己是恶魔
    if (roleIdx == 118) { return 144; }                   // 悟道者：以为自己是外来者
    team = BOTC_RoleTeam(roleIdx);
    if (team == 0) { return 143; }
    if (team == 1) { return 144; }
    if (team == 2) { return 145; }
    if (team == 3) { return 146; }
    return roleIdx;
}

// 【全员追忆】玩家自己那份魔典始终按阵营映射为四类占位身份；
//   只有该玩家已经猜对身份时才显示真实角色。真值行、夜间唤醒和全部角色能力
//   始终按说书人魔典结算。
int BOTC_PlayerRoleView (int seat, int roleIdx) {
    if (g_board == 13 && seat >= 2 && seat <= 13 && !g_guessRoleDone[g_who[seat]]) {
        return BOTC_AmnesiaMaskRole(roleIdx);
    }
    return roleIdx;
}

// 【全员追忆 · 换身份同步】未猜对前始终按新类别重算占位卡；猜对后显示真实身份。
void BOTC_AmnesiaSyncSeat (int seat, int roleIdx) {
    if (g_board != 13 || seat < 2 || seat > 13 || roleIdx < 0 || roleIdx > 163) {
        return;
    }
    g_mark[(g_who[seat] * 14) + seat] = BOTC_PlayerRoleView(seat, roleIdx) + 1;
}

void BOTC_SetSeatRole (int ob, int seat, int roleIdx) {
    int oldR;
    int i;
    int oldOrd;
    int newOrd;
    int refOrd;
    bool firstOnly;
    // 【说书人自己那一格】（用户 2026-09-26）：只有说书人自己能改；只写 g_mark[(g_teller * 14) + 1]，
    //   不牵动 2..13 那套「换身份 = 原角色离场」的记账
    if (seat == 1) {
        if (ob != g_teller) {
            return;
        }
        if (roleIdx < 0) {
            g_mark[(g_teller * 14) + 1] = 0;
        }
        else {
            g_mark[(g_teller * 14) + 1] = roleIdx + 1;
        }
        return;
    }
    if (seat < 2 || seat > 13) {
        return;
    }
    // 先记转变前阵营，BOTC_ChangeRoleMsg() 用它判断是否该显示善良/邪恶。
    // 只记说书人真值行；随后写玩家镜像行时不能覆盖这个基准。
    // 【认知基准】（用户 2026-11-06）：同时记下他「以为的身份」和「以为的阵营」，
    //   认知层面没有变化时不再私聊打扰（疯子被灵言师 / 方古转阵营等）。
    if (ob == g_teller) {
        g_seatPrevAlign[seat] = BOTC_PerceivedAlign(seat);
        g_seatPrevRole[seat] = g_mark[(g_teller * 14) + seat] - 1;
    }
    // 【通用规则】换身份 = 原角色离场（用户 2026-09-20）：正式开局后换人，旧角色带来的 token 一起收掉
    oldR = BOTC_SeatTrueRole(seat);
    oldOrd = 0;
    if (g_started && g_isNight && ob == g_teller) {
        oldOrd = BOTC_NightOrderOf(seat);
    }
    // 【利维坦（127）×麻脸巫婆 / 帽匠】：第五天之后，任何来源都不能再把利维坦加入游戏。
    if (ob == g_teller && g_started && oldR != 127 && roleIdx == 127 && g_levAfterFifth) {
        BOTC_Notice(g_teller, "第五个白天已经结束，不能再创造利维坦。");
        BOTC_PmStore(g_teller, "【利维坦】第五个白天已经结束，这次身份修改被阻止（麻脸巫婆 / 帽匠都不例外）。");
        return;
    }
    if (ob == g_teller && g_started && oldR >= 0 && oldR != roleIdx) {
        if (oldR == 157 && roleIdx != 157) {
            g_tokOn[(((g_teller * 14) + seat) * 256) + 194] = false;
            g_envoyNight = 0;
            g_envoyUsed = false;
            g_envoyPrompt = false;
            g_redirectSkip = false;
        }
        if (oldR == 158 && roleIdx != 158 && g_halfOriginal == seat) {
            g_halfPick = false;
            g_halfBy = 0;
            g_halfSlot = 0;
            g_halfOriginal = 0;
        }
        BOTC_SourceGoneCleanup(seat, false);
        // 【变脸师（117）】（用户 2026-11-10）：变脸期间被真正改身份 → 结束临时变脸，
        //   否则下个夜晚会把说书人刚改的新身份换回原身份。
        if (g_faceShow[seat] > 0) {
            BOTC_FaceStateClear(seat);
        }
        // 【换身份 = 借来的能力收回】（用户 2026-11-11）：失忆者 / 食人族 / 小精灵 / 赋予能力
        //   挂在 g_grantRoleBy 上的能力跟着原身份一起离场，不能被新身份继续使用。
        BOTC_GrantLostByRoleChange(seat);
        // 【食人族 × 疯子】（用户 2026-11-11）：吃到疯子后留下的「以为自己是恶魔」认知属于原身份，
        //   换身份后必须收回，否则新身份还会被 BOTC_IsLunatic() 当成疯子、按疯子夜序行动。
        if (g_cannLun[seat]) {
            g_cannLun[seat] = false;
            g_cannLunDemon[seat] = -1;
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(seat) + " 换了身份 → 收回「以为自己是恶魔」的疯子状态。");
        }
        // 【疯子 · 假能力】（用户 2026-11-11）：那份假能力记录挂在原身份上，换身份后不再按假能力唤醒。
        if (g_lunFakeAbilTo == seat) {
            g_lunFakeAbil = 0;
            g_lunFakeAbilTo = 0;
            g_lunFakeNight = 0;
            g_lunFakeActed = 0;
            BOTC_PmStore(g_teller, "【疯子·假能力】" + BOTC_NameStr(seat) + " 换了身份 → 收回那份假能力。");
        }
        g_lunFakeAct[seat] = false;
        // 【炼金术士】借到的爪牙记录跟着原身份收回（「是炼金术士」token 123 由下面统一清掉）。
        if (oldR == 95) {
            g_alcBorrow = 0;
        }
        if (roleIdx == 117 && oldR != 117) {
            g_faceFail[seat] = false;
            g_faceDone[seat] = 0;
        }
        // 【换身份就清掉旧的认知标记】（用户 2026-09-21）：是酒鬼(8) / 是恶魔(13) / 是疯子(49) / 是哲学家(70) / 是悟道者(140)
        //   【炼金术士也清】（用户 2026-10-19）：是炼金术士(123) 不清的话，他换身份之后真身还挂在炼金术士上，
        //   对面那个「变成炼金术士」的人反而读不出 95 ---- 换完两边都不对。
        g_tokOn[(((g_teller * 14) + seat) * 256) + 8] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 13] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 49] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 70] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 97] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 118] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 123] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 140] = false;
        // 【魔像(81)离场】（用户 2026-11-03）：理发师等把魔像换成别的角色后，
        //   他身上的「无法提名」token 也跟着旧角色一起收掉，不再继续限制新身份提名。
        //   借来的魔像能力（哲学家 / 食人族等）换身份时也一并清掉，避免新身份被旧限制卡住。
        g_tokOn[(((g_teller * 14) + seat) * 256) + 101] = false;
        // 【只清掉真正离场的那位哲学家】（用户 2026-10-26）：以前任何座位
        //   改身份都会清空这个全局记录，别人的身份变化会让哲学魔像等借用能力失联。
        if (oldR == 56 || g_tokOn[(((g_teller * 14) + seat) * 256) + 70]) {
            g_philoRole = 0;
        }
        BOTC_BoffinClearSource(seat);
        g_levJinxWake[seat] = false;
        g_levJinxLost[seat] = false;
        // 【心上人 82 / 店小二 136 / 解谜大师 129】（用户 2026-11-11）：离场即清，统一放在
        //   BOTC_SourceGoneCleanup 的 !dying 分支按能力层 + 真值行处理（死亡不清，换身份 / 交换才清），
        //   这里不再重写，避免同一份标记被清两次、也避免店小二离场误清解谜大师的标记。
    }
    // 【僵怖（43）· 假死状态不跟座位】（用户 2026-11-10）：g_zombFake / g_zombUsed / 「已假死」token 58
    //   记的都是座位，身份被换走（理发师交换、麻脸巫婆、说书人改身份等）后不会自己清掉，会留下一个
    //   「不是僵怖却内部算活着」的假活座位，胜负也永远判不掉 → 身份离场时统一清干净。
    //   新拿到僵怖身份的座位从全新的「第一次不会死」开始；如果它本身已经死了，就照样是死的。
    if (ob == g_teller && oldR == 43 && roleIdx != 43) {
        g_zombFake[seat] = false;
        g_zombUsed[seat] = false;
        g_tokOn[(((g_teller * 14) + seat) * 256) + 58] = false;
    }
    // 投毒者换了身份（被改掉 / 传位 / 重新发牌...）→ 他这次下的毒收回来
    // 【只认真值行】（用户 2026-11-11）：玩家在自己那份魔典上给别的座位标「声称身份」也会走这里，
    //   以前没拦 ob / oldR，标到投毒者那一格就会把全场的中毒 token 一起清掉（白天突然消失）。
    if (g_started && ob == g_teller && oldR >= 0 && oldR != roleIdx && g_poisonAt[seat] >= 2) {
        BOTC_PoisonClearSource(seat, "投毒者换了身份");
    }
    // 【确认下发之后改标记不算取消下发】（用户 2026-11-10）：不再把 g_dealConfirmed 清掉，
    //   已下发状态保持，下面按「已下发」直接把新身份实时同步到玩家自己那份魔典。
    if (roleIdx < 0) {
        g_mark[(ob * 14) + seat] = 0;
    }
    else if (ob != g_teller) {
        // 【全员追忆 · 正式开始前一律映射占位卡】（用户 2026-11-10）：只要是玩家自己那份魔典，
        //   不管是否已经确认下发，正式开局前改标记都只写「失忆的镇民 / 外来者 / 爪牙 / 恶魔」。
        g_mark[(ob * 14) + seat] = BOTC_PlayerRoleView(seat, roleIdx) + 1;
    }
    else {
        g_mark[(ob * 14) + seat] = roleIdx + 1;
    }
    if (ob == g_teller && seat >= 2) {
        // 【写给"这一格现在坐的人"自己那一份】（用户 2026-10-07）：行号 = 他的**物理座位**
        //   （g_who[seat]），列号 = **格子** seat。原来写 `(seat * 14) + seat`，随机座位后就错人了。
        // 【确认下发前不下发身份】（用户 2026-11-10）：配板阶段还没点【确认发放】时只写说书人真值行，
        //   玩家自己那份魔典这一格保持空白；已下发（g_dealConfirmed）或游戏已正式开始则实时同步。
        if (!g_started && !g_dealConfirmed) {
            for (i = 1; i <= 13; i += 1) {
                if (i == g_teller) {
                    continue;                      // 真值行不能动
                }
                if (g_mark[(i * 14) + seat] != 0) {
                    g_mark[(i * 14) + seat] = 0;
                    BOTC_GrimRender(i);
                }
            }
        }
        else {
            if (roleIdx < 0) {
                g_mark[(g_who[seat] * 14) + seat] = 0;
            }
            else {
                g_mark[(g_who[seat] * 14) + seat] = BOTC_PlayerRoleView(seat, roleIdx) + 1;
            }
            // 【已下发状态下改标记 → 本人实时变化】（用户 2026-11-10）：还开着「我的角色」的立刻重刷
            if (g_tipOpen[g_who[seat]]) {
                BOTC_TipRender(g_who[seat]);
            }
        }
    }
    // 【身份一变就重算的常驻标记】（用户 2026-09-21 / 2026-10-14）----
    //   诺-达鲺（70）的两份毒 80 / 涡流（71）的信息错误 84 / 水手 26 / 弄臣 29 / 茶艺师 51 /
    //   暴风捕手 133 / 哲学家醉酒 90 这些标记都是「按座位现在的角色现算」的，身份一变就整体重算一次。
    if (oldR != roleIdx) {
        g_nodManual = false;
    }
    if (g_started) {
        BOTC_SeatStateSync();
    }
    // 【酒保（160）/ 店小二（115）】（用户 2026-11-09）：正式开局后不再重跑配板阶段的随机
    //   熟客 / 醉酒位置，否则说书人手动改过的标记会在后续身份变化里被重新随机覆盖。
    //   失效标记照旧由 BOTC_SeatStateSync() 清理，新出现的角色只提醒说书人手动放置。
    // 【只认真值行】（用户 2026-11-11）：玩家可以在自己那份魔典上给别的座位标「声称身份」，
    //   这类镜像行写入不是真的换身份；以前没拦 ob 会按人数给说书人刷屏同一条提醒，必须挡住。
    if (g_started && ob == g_teller && seat >= 2 && seat <= 13 && oldR != roleIdx && roleIdx == 160 && BOTC_RoleInPlay(160)) {
        BOTC_PmStore(g_teller, "【酒保】" + BOTC_NameStr(seat) + " 成为酒保 → 请手动为一名相邻的善良玩家放置「醉酒」标记。");
    }
    // 【酒保（160）】（用户 2026-11-09）：配置版型阶段不再提前随机醉酒位置，
    //   统一由游戏正式开始、进入首夜时的 BOTC_OpeningMarkSync() 结算。
    // 【店小二（115）】（用户 2026-11-06）：开局前离场清掉旧标记。
    // 【正式开局前不再提前放标】（用户 2026-11-11）：这里只清掉熟客 135 / 醉酒 136，
    //   不再重跑 BOTC_DxeSetup() 的配板随机，否则随机配板后手动替换角色就会提前出现两枚 token；
    //   正式开局统一由 BOTC_GameStartGo() 结算。
    if (ob == g_teller && seat >= 2 && seat <= 13 && oldR != roleIdx && oldR == 115 && !g_started) {
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 135] = false;
            g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
        }
        BOTC_GrimRender(g_teller);
    }
    if (g_started && ob == g_teller && seat >= 2 && seat <= 13 && oldR != roleIdx && roleIdx == 115) {
        BOTC_PmStore(g_teller, "【店小二】" + BOTC_NameStr(seat) + " 成为店小二 → 请手动放置「熟客」与「醉酒」标记。");
    }
    // 【落难少女入场 → 通知所有爪牙】（用户 2026-10-03）：游戏开始后任何时候变成落难少女，都通知一次
    if (g_started && ob == g_teller && seat >= 2 && seat <= 13 && roleIdx == 82 && oldR != 82) {
        BOTC_DamselDealInfo();
        BOTC_PmStore(g_teller, "【落难少女】" + BOTC_NameStr(seat) + " 成为落难少女 → 已通知所有爪牙「落难少女在场」。");
    }
    // 【利维坦（127）】游戏中途成为利维坦：不在这里公开，只按当前天数打 token；进入下一个白天再播报。
    if (ob == g_teller && g_started && seat >= 2 && seat <= 13) {
        if (oldR == 127 && roleIdx != 127) {
            g_levAnnouncedSeat = 0;
            g_levTargetLast = 0;
            for (i = 2; i <= 13; i += 1) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 149] = false;
                g_tokOn[(((g_teller * 14) + i) * 256) + 150] = false;
                g_tokOn[(((g_teller * 14) + i) * 256) + 151] = false;
                g_tokOn[(((g_teller * 14) + i) * 256) + 152] = false;
                g_tokOn[(((g_teller * 14) + i) * 256) + 153] = false;
                g_tokOn[(((g_teller * 14) + i) * 256) + 154] = false;
            }
            BOTC_GrimRender(g_teller);
        }
        if (roleIdx == 127 && oldR != 127) {
            g_levTargetLast = 0;
            BOTC_LeviathanTokenSync();
        }
    }
    if (g_started && oldR != roleIdx) {
        BOTC_LeviathanSpecialSync();
    }
    if (!BOTC_BoffinSourceIs(seat)) {
        BOTC_BoffinClearSource(seat);
    }
    if (g_started && g_isNight && ob == g_teller && oldR != roleIdx) {
        // 【首夜信息位中途上身】（用户 2026-11-11）：贵族(76) 这类只有首夜夜序的身份被理发师换到
        //   另一名玩家身上时，新座位的 g_seatFirstNight 还是 1，BOTC_NightOrderOf 会按普通夜序读成 0
        //   （本夜不唤醒），整段夜序被漏掉。官方文本规定中途被创造的首夜信息位「在他作为该身份的
        //   第一个夜晚得知信息」---- 所以把今晚记成他的首夜；即使首夜那个位次在全局游标里已经过去，
        //   也照旧补一次唤醒（他今晚还没以这个新身份行动过）。
        firstOnly = false;
        if (roleIdx >= 0 && roleIdx <= 163 && BOTC_NoOtherOf(roleIdx) <= 0 && BOTC_NoFirstOf(roleIdx) > 0) {
            g_seatFirstNight[seat] = g_nightNum;
            firstOnly = true;
        }
        newOrd = BOTC_NightOrderOf(seat);
        if (oldR == 95 && roleIdx == 132 && g_alcBorrow == 132) {
            refOrd = oldOrd;
            if (g_wakeCurrentOrd > refOrd) {
                refOrd = g_wakeCurrentOrd;
            }
            BOTC_QueueWakeInsert(seat, refOrd, newOrd);
        }
        else {
            g_insertWake[seat] = false;
            if (newOrd > 0) {
                if (!firstOnly && g_nightCursorOrd > 0 && newOrd <= g_nightCursorOrd) {
                    // 新身份的夜序位次已经过去（含正好等于当前这一步）：本夜不再行动
                    if (!g_autoWoke[seat]) {
                        BOTC_PmStore(g_teller, "【夜序】" + BOTC_NameStr(seat) + " 改成 " + g_roleName[roleIdx] + " 后，其夜序位次已过，本夜不再行动。");
                    }
                    g_autoWoke[seat] = true;
                }
                else {
                    // 新身份的夜序还没到：即使他今晚已经以旧身份行动过，也要在本夜后续正常唤醒
                    if (firstOnly && !BOTC_SeatDead(seat)) {
                        BOTC_PmStore(g_teller, "【夜序】" + BOTC_NameStr(seat) + " 获得 " + g_roleName[roleIdx] + "（他的第一个夜晚），本夜稍后会补一次唤醒。");
                    }
                    else if (g_autoWoke[seat]) {
                        BOTC_PmStore(g_teller, "【夜序】" + BOTC_NameStr(seat) + " 改成 " + g_roleName[roleIdx] + " 后，其夜序位次还没到，本夜后续会再次唤醒他。");
                    }
                    g_autoWoke[seat] = false;
                }
            }
        }
    }
}

// 说书人按【处决标记】：进入 / 退出「点座位标处决」模式
void BOTC_ExecMode () {
    if (g_execPick) {
        g_execPick = false;
        libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
        return;
    }
    // 两个标记模式互斥
    g_deadPick = false;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    BOTC_BigHintHide(g_teller);       // 顺手收掉长驻提示
    g_execPick = true;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决中"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【处决标记】已进入处决模式：点击场上玩家的座位即可处决该玩家（占用今天的处决名额）。再次点击按钮可取消处决。");
}

// 【强制玩家发起提名】（用户 2026-11-03）：说书人点按钮 → 弹窗选目标1（发起提名者）和目标2（被提名者）
void BOTC_ForceNomOpen () {
    int i;
    int q;
    // 【再点 = 关闭】（用户 2026-11-08）：弹窗已经打开时再点同一按钮直接收起，不再重复填充列表。
    if (DialogIsVisible(g_fnDlg, g_teller)) {
        BOTC_ForceNomClose();
        return;
    }
    if (g_phase != 1) {
        BOTC_Notice(g_teller, "【强制发起提名】只能在自由提名阶段使用。");
        return;
    }
    BOTC_BuildSeatList();
    g_fnAN = 0;
    g_fnBN = 0;
    for (i = 0; i < 13; i += 1) {
        g_fnA[i] = 0;
        g_fnB[i] = 0;
    }
    DialogControlRemoveAllItems(g_fnList1, PlayerGroupSingle(g_teller));
    DialogControlRemoveAllItems(g_fnList2, PlayerGroupSingle(g_teller));
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2 || q > 13) {
            continue;
        }
        // 已经退出的玩家不参与提名（座位虽然还留着）
        if (g_leftKeepP[g_who[q]]) {
            continue;
        }
        // 目标1：今天还没发起提名的活人；或者能力生效、还有次数的报丧女妖
        if ((!BOTC_SeatDead(q) && !g_nomUsed[q] && !BOTC_ProtectTokOn(q, 101)) || BOTC_BansheeCanNominate(q)) {
            g_fnA[g_fnAN] = q;
            g_fnAN = g_fnAN + 1;
            DialogControlAddItem(g_fnList1, PlayerGroupSingle(g_teller), BOTC_PlayerNameText(q));
        }
        // 目标2：今天还没被提名过的玩家（可以是死人）
        if (!g_nomTargeted[q]) {
            g_fnB[g_fnBN] = q;
            g_fnBN = g_fnBN + 1;
            DialogControlAddItem(g_fnList2, PlayerGroupSingle(g_teller), BOTC_PlayerNameText(q));
        }
    }
    if (g_fnAN <= 0 || g_fnBN <= 0) {
        BOTC_Notice(g_teller, "【强制发起提名】现在没有可选的目标：请确认自由提名阶段已开始，或今天的名额已经用完。");
    } else {
        BOTC_Notice(g_teller, "【强制发起提名】用法：先在目标1里选今天还没发起提名的活人（或能力生效且还有次数、仍在场的报丧女妖），再在目标2里选今天还没被提名过的玩家（可以是死人），点【发起提名】后他就会像正常提名一样对目标2发起提名。");
    }
    DialogSetVisible(g_fnDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_ForceNomClose () {
    DialogSetVisible(g_fnDlg, PlayerGroupAll(), false);
}

void BOTC_ForceNomSubmit () {
    int s1;
    int s2;
    int a;
    int b;
    if (g_phase != 1) {
        BOTC_ForceNomClose();
        BOTC_Notice(g_teller, "【强制发起提名】只能在自由提名阶段使用。");
        return;
    }
    // ⚠ 星际的【列表选中项】下标从 1 开始（0 = 没选），取出来必须减 1 再用；
    //   之前直接用 1 基下标查 g_fnA/g_fnB，两个目标都会顺延一位（选 [1] 提名 [2] 会变成 [2] 提名 [3]，用户 2026-11-04）。
    s1 = DialogControlGetSelectedItem(g_fnList1, g_teller) - 1;
    s2 = DialogControlGetSelectedItem(g_fnList2, g_teller) - 1;
    if (s1 < 0 || s1 >= g_fnAN || s2 < 0 || s2 >= g_fnBN) {
        BOTC_Notice(g_teller, "【强制发起提名】请先在目标1和目标2里各选一个玩家。");
        return;
    }
    a = g_fnA[s1];
    b = g_fnB[s2];
    if (a < 2 || a > 13 || b < 2 || b > 13 || g_nomTargeted[b]) {
        BOTC_ForceNomClose();
        BOTC_Notice(g_teller, "【强制发起提名】目标已经不符合条件，请重新打开再选。");
        return;
    }
    BOTC_ForceNomClose();
    g_nomPickBy = a;
    g_nomPickSec[a] = 0;
    BOTC_PhaseSet(2);
    BOTC_NomPick(a, b);
    if (g_phase == 2) {
        // 没能正常发起（例如目标刚被提名过）：退回自由提名，不留选人状态
        g_nomPickBy = 0;
        g_nomPickSec[a] = 0;
        BOTC_PhaseSet(1);
        BOTC_Notice(g_teller, "【强制发起提名】目标不符合条件，已取消。");
    }
}

// 处决某个座位：盖红叉 + 算死亡、占掉今天的处决名额，并立刻结束提名阶段
void BOTC_ExecToggleAt (int q) {
    int ob;
    int other;
    int twA;
    int twB;
    if (q == 1) {
        // 【处决说书人的胜负】（用户口径 + 百科）：真身是无神论者在场 → 善良胜；否则邪恶胜
        g_execPick = false;
        libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
        g_deadShown[1] = true;
        for (ob = 1; ob <= 13; ob += 1) {
            BOTC_GrimRender(ob);
        }
        BOTC_PubAnnounce("【处决】说书人 被处决");
        if (BOTC_AtheistOn()) {
            BOTC_Notice(g_teller, "说书人被处决：真身无神论者在场 → 善良阵营获胜。");
            other = 0;
            for (ob = 2; ob <= 13; ob += 1) {
                if (BOTC_SeatTrueRole(ob) == 83) {
                    other = ob;
                }
            }
            BOTC_ShowWin(0, "在无神论者" + BOTC_NameStr(other) + "的带领下你们联手终结了邪恶说书人的谬论，", "小镇从此恢复平静");
        }
        else {
            BOTC_Notice(g_teller, "说书人被处决：场上没有无神论者 → 邪恶阵营获胜。");
            BOTC_ShowWin(1, "当所谓的「无神论者」煽动镇民们把说书人处刑时，", "还有谁能拯救他们呢？");
        }
        return;
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    // 【恐惧之灵(102)】（用户 2026-10-04，官方口径）：恐惧之灵**本人提名**了他当前选中的那名玩家，
    //   而今天处决的正是那个人 → **那个人的阵营落败、游戏立刻结束**。
    //   ⚠ 官方明说「处决后没有死亡，他的阵营仍然会落败」，所以这一段必须放在最前面：
    //     下面「圣徒 / 弄臣 / 旅店老板那些没死的分支」都是提前 return 的，放后面就漏了。
    // 【逆臣（119）】（用户 2026-10-16）：谁先死于处决，另一方当晚转变为邪恶阵营。
    //   · 被处决的是逆臣自己 → 他选的那个人（带「不共戴天」139）转邪恶；
    //   · 被处决的是带「不共戴天」的那个人 → 逆臣转邪恶（前提：逆臣还没因为别的原因死掉；
    //     他自己死于处决已经在上一条处理过了，所以这里要求「活着的逆臣，或他是死于处决的」）。
    if (g_tcSeat >= 2 && g_tcSeat <= 13) {
        if (q == g_tcSeat) {
            for (ob = 2; ob <= 13; ob += 1) {
                if (g_tokOn[(((g_teller * 14) + ob) * 256) + 139]) {
                    g_tokOn[(((g_teller * 14) + ob) * 256) + 139] = false;
                    g_tcPending = ob;
                    BOTC_PmStore(g_teller, "【逆臣】他自己死于处决 → 今晚唤醒他时告诉 " + BOTC_NameStr(ob) + " 转变为邪恶阵营。");
                }
            }
            BOTC_GrimRender(g_teller);
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 139]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 139] = false;
            if (!BOTC_SeatDead(g_tcSeat) || g_deadKind[g_tcSeat] == 3) {
                g_tcPending = g_tcSeat;
                BOTC_PmStore(g_teller, "【逆臣】「不共戴天」的那个人死于处决 → 今晚唤醒他时告诉他：你转变为邪恶阵营。");
            }
            BOTC_GrimRender(g_teller);
        }
    }
    //   · 是不是「本人提名」查 g_nomFromOf[q]（今天这个座位是谁提的名）；
    //   · 提名者是不是真有能力走 BOTC_HasAbility（真身 / 哲学家 / 食人族 / 炼金借能力）；
    //   · 中毒 / 醉酒 = 能力不生效；提名者已经死了也一样不生效（死人不能提名）。
    if (g_fearTarget >= 2 && q == g_fearTarget && g_nomFromOf[q] >= 2 && g_nomFromOf[q] <= 13) {
        if (BOTC_HasAbility(g_nomFromOf[q], 102)) {
            if (BOTC_AbilityWorks(g_nomFromOf[q], 102) && !BOTC_SeatDead(g_nomFromOf[q])) {
                BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决");
                BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（恐惧之灵）----");
                BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(g_nomFromOf[q]) + " 提名的 " + BOTC_NameStr(q) + " 被处决（他当前选中的目标）→ 他的阵营落败，游戏结束。");
                BOTC_ShowWin(1 - BOTC_SeatAlign(q), "恐惧之灵" + BOTC_NameStr(g_nomFromOf[q]) + "的提名把" + BOTC_NameStr(q) + "送上了绞刑架，", "他的阵营就此落败。");
                return;
            }
            BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(g_nomFromOf[q]) + " 中毒/酒鬼或已死亡 → 这次处决不触发「阵营落败」。");
        }
    }
    // 已经死了的人（尸体）也可以被「处决」---- 提名是允许提尸体的，但处理方式不同：
    //   不重新标记死亡（他已经挂着红叉 / 死亡 token 了）、不触发圣徒 / 红唇女郎那些特殊结算、
    //   而且**不写进 g_exec**（送葬者查不到尸体的身份）；但**今天的处决名额照样占掉**
    //   ---- 一天只能处决一次，处决了尸体也算这一次用掉了。
    // 【镜像双子 · 先把这一对记下来】（用户 2026-09-21）：下面的尸体分支 / 死亡结算都可能动到 g_twin*，
    //   先存进 locals，判定用 locals。
    twA = BOTC_TwinSeatOf(76);
    twB = BOTC_TwinSeatOf(77);
    if (BOTC_SeatDead(q)) {
        if (g_execUsedToday) {
            BOTC_Notice(g_teller, "今天已经处决过一个人了，尸体处决也不能在同一天重复结算。");
            return;
        }
        g_execUsedToday = true;
        g_execByCorpse = true;         // 这次「处决」的是尸体：没有死亡标记可以取消
        BOTC_LeviathanExecution(q);
        if (g_gameOver) {
            return;
        }
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(q) + StringToText(" 被处决（他本来就是尸体）"));
    BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（尸体）----");
        // 【镜像双子（64）】（用户 2026-09-21）：处决的是「两个双子里的善良一方」→ 邪恶获胜 ----
        //   ⚠ 哪怕他已经是尸体也算：亡骨魔把善良双子杀了，他（作为爪牙）保留着能力，
        //     处决他同样算「善良一方被处决」（用户实测口径）。
        if (BOTC_TwinActive() && twA >= 2 && (q == twA || q == twB)) {
            if (BOTC_SeatAlign(q) == 0) {
                other = twA;
                if (q == twA) {
                    other = twB;
                }
                if (!BOTC_SeatDead(other) || BOTC_KeepsAbilityAlive(other)) {
                    BOTC_PmStore(g_teller, "【镜像双子】处决的是双子里的善良一方 → 邪恶阵营获胜。");
                    BOTC_ShowWin(1, "你们将无辜的" + BOTC_NameStr(q) + "推向了深渊，", "而" + BOTC_NameStr(other) + "将会代替他永远的活下去......");
                    return;
                }
            }
        }
        // 【主谋（42）加时那一天 · 处决的是尸体】（用户 2026-09-22）----
        //   百科口径：那个白天「如果有玩家被处决，他的阵营落败」，并且特别注明
        //   「**无论该玩家是否死于处决**」---- 看的是**谁被处决**，不是「谁死了」。
        //   所以处决一具尸体同样算：善良的尸体 → 邪恶胜；邪恶的尸体 → 善良胜。
        //   （这条判定原来只写在下面「活人处决」那一段里，尸体在那之前就 return 了，所以永远轮不到。）
        if (g_mmArmed) {
            BOTC_PmStore(g_teller, "【主谋加时】" + BOTC_NameStr(q) + "（尸体）被处决 → " + BOTC_AlignName(BOTC_WinAlignOf(q)) + "阵营落败。");
            if (BOTC_WinAlignOf(q) == 0) {
                BOTC_ShowWin(1, "主谋" + BOTC_NameStr(q) + "的阴谋得逞，", "恶魔又从地狱里回来了。");
            }
            else {
                BOTC_ShowWin(0, "主谋" + BOTC_NameStr(q) + "的阴谋被你们识破！", "");
            }
            return;
        }
        // 跟真处决一样收尾：提名阶段立刻结束 → 白天结束、直接进入夜晚
        //   （BOTC_NomClose 里也会自动入夜，所以后面再判断一次，避免来回切）
        // 【处决后不自动入夜】（用户 2026-09-20）：只收掉提名环节，留在白天，由说书人自己点【进入夜晚】
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 一天只能处决一个人
    if (g_execUsedToday) {
        if (g_execByCorpse) {
            BOTC_Notice(g_teller, "今天已经处决过一个人了（那次处决的是尸体，没有死亡标记可以取消）。");
        }
        else {
            BOTC_Notice(g_teller, "今天已经处决过一个人了。要改的话，用【死亡标记】点那个人取消（等于复活）。");
        }
        return;
    }
    // 主谋（42）加时：这一天的处决直接判胜负（被处决的人按**真身阵营**落败）
    if (g_mmArmed) {
        BOTC_MarkDeath(q, 3, 0, -1);
        if (!g_gameOver && BOTC_LeviathanGrandchildJinx(q)) {
            return;
        }
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决");
        BOTC_PmStore(g_teller, "【主谋加时】" + BOTC_NameStr(q) + " 被处决 → " + BOTC_AlignName(BOTC_WinAlignOf(q)) + "阵营落败。");
        if (BOTC_WinAlignOf(q) == 0) {
                BOTC_ShowWin(1, "主谋" + BOTC_NameStr(q) + "的阴谋得逞，", "恶魔又从地狱里回来了。");
        }
        else {
                BOTC_ShowWin(0, "主谋" + BOTC_NameStr(q) + "的阴谋被你们识破！", "");
        }
        return;
    }
    g_exec[q] = true;
    g_execUsedToday = true;
    g_execByCorpse = false;
    // 【精神病患者（84）· 处决猜拳】（用户 2026-11-03 / 2026-11-07）：被提名处决时先猜石头剪刀布；
    //   按能力层判断（真身 / 哲学家 / 食人族 / 炼金术士 / 科学怪人 / 说书人赋予都算），
    //   能力失效（中毒 / 醉酒 / 来源离场）、没有提名者时直接处决。
    if (BOTC_AbilityWorks(q, 84) && g_nomFromOf[q] >= 2 && g_nomFromOf[q] <= 13) {
        BOTC_PsyRpsStart(q);
        return;
    }
    // 【和平主义者（33）· 处决弹窗】（用户 2026-11-06）：善良角色即将被处决时，
    //   弹窗让说书人决定是否触发和平主义者能力。有「无敌」token 或已带「处决不死」token 的不弹窗。
    if (BOTC_PacifistAsk(q)) {
        return;   // 已弹窗，暂停处决等说书人回答
    }
    BOTC_ExecAfterRps(q);
}

// 猜拳通过（或不需要猜拳）之后的处决结算：原来直接接在处决按钮后的那一段。
void BOTC_ExecAfterRps (int q) {
    int hook;
    // 相克：维齐尔正在照看小怪宝时，处决不会被白天免死挡下。
    if (g_lmOn && g_lmSeat == q) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 166] = false;
        BOTC_PmStore(g_teller, "【小怪宝×维齐尔相克】" + BOTC_NameStr(q) + " 正在照看小怪宝 → 这次处决按正常死亡处理，维齐尔白天免死不生效。");
    }
    BOTC_LeviathanExecution(q);
    if (g_gameOver) {
        return;
    }
    if (BOTC_CorpseFirstDeath(q)) {
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但他并没有死亡。");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 和平主义者（33）：**只有智能说书**才自动掷一次（用户 2026-09-20）----
    //   掷中就在目标身上打「处决不死（和平主义者）」token，紧接着下面那条就把这次处决挡掉；
    //   真人说书**不掷**：想保谁就自己在他身上打那个 token，再点处决。
    // 【处决不死】token（魔鬼代言人 27 / 和平主义者 28）：直接生效 ---- 公屏只说「被处决了，但不知道为什么，他并没有死亡」，
    //   原因（谁保的）只写进说书人私聊（用户 2026-09-20）
    // 维齐尔本人被处决：白天不会死亡，但这次处决仍然结束今天的提名。
    if (BOTC_VizierDayImmune(q)) {
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但不知道为什么，他并没有死亡。");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 【痢蛭 (100) 的免死也要挡处决】（用户 2026-10-06 报「痢蛭的免死 TOKEN 没有用」）：
    //   官网口径「如果宿主存活，痢蛭就不会死亡」—— 处决也一样；以前这里只列了 27 / 28 / 茶艺师 / 水手，
    //   漏了痢蛭的「不会死亡（痢蛭）122」，所以他被处决照样死。现在补上。
    if (BOTC_ProtectTokOn(q, 27) || BOTC_ProtectTokOn(q, 28) || (BOTC_TeaLadyProtects(q) && !BOTC_IsDisguiseAbility(q)) || BOTC_SailorImmune(q) || BOTC_LleechImmune(q)) {
        if (BOTC_ProtectTokOn(q, 27)) {
            BOTC_PmStore(g_teller, "【处决】" + BOTC_NameStr(q) + " 带着「处决不死（魔鬼代言人）」，这一次处决没有生效。");
        }
        else {
            if (BOTC_ProtectTokOn(q, 28)) {
                BOTC_PmStore(g_teller, "【处决】" + BOTC_NameStr(q) + " 带着「处决不死（和平主义者）」，这一次处决没有生效。");
            }
            else {
                if (BOTC_LleechImmune(q)) {
                    BOTC_PmStore(g_teller, "【处决】" + BOTC_NameStr(q) + " 是痢蛭、而且宿主还活着 → 按规则他不会死亡。");
                }
                else {
                    if (BOTC_SailorImmune(q)) {
                        BOTC_PmStore(g_teller, "【处决】" + BOTC_NameStr(q) + " 是清醒的水手 → 按规则他不会死亡。");
                    }
                    else {
                        BOTC_PmStore(g_teller, "【处决】" + BOTC_NameStr(q) + " 是茶艺师的邻居、而且她两名邻居都是善良的 → 按规则他不会死亡。");
                    }
                }
            }
        }
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但不知道为什么，他并没有死亡。");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
        // 【处决后不自动入夜】（用户 2026-09-20）：只收掉提名环节，留在白天，由说书人自己点【进入夜晚】
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 弄臣（34）：「你第一次死亡时，你不会死」---- 自动生效
    if (BOTC_FoolSave(q)) {
        BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但不知道为什么，他并没有死亡。");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
        BOTC_PmStore(g_teller, "---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（弄臣免死）----");
        // 【处决后不自动入夜】（用户 2026-09-20）：只收掉提名环节，留在白天，由说书人自己点【进入夜晚】
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 【处决不死提示】（魔鬼代言人 / 和平主义者）：只提示、不硬拦（说书人裁定）
    if (BOTC_DeathBlocker(q, 3, 0, false) != "") {
        BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(q) + " 带着【" + BOTC_DeathBlocker(q, 3, 0, false) + "】，按规则这次处决不该让他死 ---- 你仍可以照记。");
    }
    // 画皮的下一次死亡免死覆盖处决；在这里终结处决，避免 BOTC_MarkDeath 继续补红叉。
    hook = BOTC_SkinDeathHook(q);
    if (hook == 1) {
        if (!BOTC_PublicDead(q) && !BOTC_SeatDead(q)) {
            BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但不知道为什么，他并没有死亡。");
            BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（没有死亡）----");
            BOTC_PmStore(g_teller, "【画皮】已阻止 " + BOTC_NameStr(q) + " 的处决死亡，画皮重获能力。");
        }
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    if (g_liveCorpse[q]) {
        BOTC_LivingCorpseFinalize(q);
        if (g_phase != 0) {
            BOTC_NomCloseEx(false);
        }
        return;
    }
    // 【茶艺师 × 间谍 / 陌客能力者】（用户 2026-11-12）：处决前先让说书人裁定是否死亡。
    if (BOTC_TeaLadyProtects(q) && BOTC_IsDisguiseAbility(q) && !g_teaDieOk[q]) {
        g_teaExecSeat = q;
        BOTC_JudgeAsk(18, "【茶艺师】" + BOTC_NameStr(q) + " 是茶艺师的邻居、也是间谍 / 陌客能力者：这次处决是否让他死亡？", q, 1, 0);
        BOTC_PmStore(g_teller, "【茶艺师】" + BOTC_NameStr(q) + " 是间谍 / 陌客能力者，且两名邻居都按善良登记 → 请选择这次处决是否死亡。");
        return;
    }
    BOTC_ExecApplyKill(q);
}

// 【处决死亡结算】（用户 2026-11-12 从 BOTC_ExecAfterRps 拆出）：
//   茶艺师判定弹窗点【是：死亡】后从这里继续，保证后续处决效果只走一次。
void BOTC_ExecApplyKill (int q) {
    int ob;
    int other;
    int twA;
    int twB;
    // 【镜像双子 · 先记下这一对】（用户 2026-09-21 报「还是不行」的根因）：
    //   死亡结算（BOTC_MarkDeath → 离场清理）会按官方把配对战作废、76/77 标记一起收掉，
    //   等死亡落定之后再读 g_twinA / g_twinB 就已经是 0 了 → 那句「善良一方被处决」永远判不到。
    //   所以在打死亡标记之前先把这一对存进 locals，下面用 locals 判。
    twA = BOTC_TwinSeatOf(76);
    twB = BOTC_TwinSeatOf(77);
    BOTC_VixenExecPending(q);
    BOTC_MarkDeath(q, 3, 0, -1);      // 死亡类型：白天被处决
    if (!g_gameOver && BOTC_LeviathanGrandchildJinx(q)) {
        return;
    }
    BOTC_MinstrelCheck(q);        // 吟游诗人（31）：爪牙死于处决 → 全员醉酒到明天黄昏
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：有人死了，重新算一次两名邻居
    BOTC_ScarletCheck();          // 恶魔被处决的话，红唇女郎（活着且人数够）直接顶上
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决");
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决 ----");
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    // 圣徒：被处决 → 他的阵营落败（中毒 / 酒鬼时失效）
    if (BOTC_HasAbility(q, 16)) {
        if (BOTC_AbilityWorks(q, 16)) {
            BOTC_ShowWin(1 - BOTC_SeatAlign(q), "神之使徒" + BOTC_NameStr(q) + "被凡人亲手送上了绞刑架，", "神再也不会眷顾这片土地。");
        }
        else {
            BOTC_PmStore(g_teller, "【圣徒】" + BOTC_NameStr(q) + " 被处决，但他中毒/酒鬼，特殊胜利不触发。");
        }
    }
    // 【镜像双子（64）】（用户 2026-09-21 修正）：处决的是**两个双子里的善良那一方** → 邪恶立刻获胜。
    //   ⚠ 不能只看「谁是 g_twinB」---- 麻脸巫婆能造出**善良的镜像双子**，善良那只可能是 g_twinA 也可能是 g_twinB，
    //     所以这里按他**这一场的阵营**（BOTC_SeatAlign）判，并且另一只还活着才算。
    //   ⚠ 用的必须是上面存下来的 twA / twB：这一刀打完，配对战已经被离场清理作废了。
    if (twA >= 2 && twB >= 2 && (q == twA || q == twB)) {
        if (BOTC_SeatAlign(q) == 0) {
            other = twA;
            if (q == twA) {
                other = twB;
            }
            // 【保留了能力的双子】（用户 2026-09-21）：他即使死了，能力还在 → 这一对照样算数
            if (!BOTC_SeatDead(other) || BOTC_KeepsAbilityAlive(other)) {
                BOTC_ShowWin(1, "你们将无辜的" + BOTC_NameStr(q) + "推向了深渊，", "而" + BOTC_NameStr(other) + "将会代替他永远的活下去......");
                return;
            }
        }
    }
    // 【哥布林(99)】（用户 2026-10-03）：今天公开声明过 + 今天被处决 + 真有这个能力 + 没中毒/醉酒 → **他的阵营获胜**
    if (g_goblinClaim[q] && g_goblinClaimDay[q] == g_nightNum && BOTC_AbilityWorks(q, 99)) {
        // 【双方同时达成胜利条件 → 善良胜】（用户 2026-10-10）：他要是同时还「是恶魔」（最典型的就是哥布林带着小怪宝），
        //   处决他就同时满足了「哥布林的邪恶胜」和「恶魔死亡 → 善良胜」→ 两边撞一起时判**善良胜**。
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
        BOTC_ShowWin(BOTC_SeatAlign(q), "哥布林" + BOTC_NameStr(q) + "亮出了他的真身，", "他的阵营就此得逞。");
        return;
    }
    // 【食人族（74）】（用户 2026-11-03）：邪恶角色被处决 → 自动中毒到下一次处决死亡；
    //   今天有人死于处决 → 夜里先给食人族发一次能力（非唤醒、非私聊）。
    BOTC_CannExecHooks(q);
    // 【食人族（74）】处决结算后：先变回食人族，再看要不要弹面板
    BOTC_CannAfterExec(q);
    // 炸弹人已走完普通处决死亡流程后，再执行「三名保留者 + 爆炸 + 指向投票」。
    if (BOTC_BoomdandyTrigger(q)) {
        return;
    }
    BOTC_CheckWin();
    // 【处决后不自动入夜】（用户 2026-09-20）：提名阶段收掉，但留在白天 ----
    //   说书人想什么时候入夜就自己点【进入夜晚】。
    if (g_phase != 0) {
        BOTC_NomCloseEx(false);
    }
}

//--------------------------------------------------------------------------------------------------
// 【精神病患者（84）· 处决猜拳】（用户 2026-11-03）
//   精神病患者被提名处决时先猜石头剪刀布：精神病患者先选，提名者（自己提名自己时改由说书人）再选。
//   两次选择都单独私聊告诉说书人，公聊依次提示谁该猜、最后公布双方选择和结果。
//   精神病患者没有输（赢或平局）→ 处决无事发生；输了 → 走正常处决死亡。
//   能力失效（中毒 / 醉酒 / 来源离场）、没有提名者时没有猜拳环节。
//   （用户 2026-11-06）：猜拳期间自动退出提名阶段；不做超时自动选择；进入夜晚自动关闭弹窗。
//--------------------------------------------------------------------------------------------------
string BOTC_RpsPickStr (int k) {
    if (k == 1) {
        return "石头";
    }
    if (k == 2) {
        return "剪刀";
    }
    return "布";
}

void BOTC_PsyRpsShowFor (int who, string hint) {
    DialogControlSetVisible(g_rpsRock, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rpsScissors, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rpsPaper, PlayerGroupAll(), false);
    DialogSetVisible(g_rpsDlg, PlayerGroupAll(), false);
    if (who < 1 || who > 13) {
        return;
    }
    libNtve_gf_SetDialogItemText(g_rpsTitle, BOTC_PlayerNameText(who) + StringToText(hint), PlayerGroupSingle(who));
    DialogControlSetVisible(g_rpsRock, PlayerGroupSingle(who), true);
    DialogControlSetVisible(g_rpsScissors, PlayerGroupSingle(who), true);
    DialogControlSetVisible(g_rpsPaper, PlayerGroupSingle(who), true);
    DialogSetVisible(g_rpsDlg, PlayerGroupSingle(who), true);
}

void BOTC_PsyRpsClear () {
    g_rpsOn = false;
    g_rpsQ = 0;
    g_rpsOpp = 0;
    g_rpsStage = 0;
    g_rpsPsyPick = 0;
    g_rpsOppPick = 0;
    if (g_rpsDlg > 0) {
        DialogSetVisible(g_rpsDlg, PlayerGroupAll(), false);
    }
}

void BOTC_PsyRpsStart (int q) {
    int nom;
    if (q < 2 || q > 13) {
        BOTC_ExecAfterRps(q);
        return;
    }
    nom = g_nomFromOf[q];
    if (nom < 2 || nom > 13) {
        BOTC_ExecAfterRps(q);
        return;
    }
    g_rpsOn = true;
    g_rpsQ = q;
    g_rpsStage = 0;
    g_rpsPsyPick = 0;
    g_rpsOppPick = 0;
    if (nom == q) {
        g_rpsOpp = 0;              // 自己提名自己 → 对手是说书人
    }
    else {
        g_rpsOpp = nom;
    }
    // 提名阶段先收掉，避免猜拳期间别人继续提名。
    if (g_phase != 0) {
        BOTC_NomCloseEx(false);
    }
    BOTC_PubAnnounce("【精神病患者】" + BOTC_NameStr(q) + " 被处决，需要进行猜拳。请" + BOTC_NameStr(q) + "选择石头、剪刀或布。");
    BOTC_PmStore(g_teller, "【精神病患者猜拳】" + BOTC_NameStr(q) + " 被处决，开始猜拳；等他的选择。");
    BOTC_PsyRpsShowFor(g_who[q], "：请选择石头、剪刀或布");
}

void BOTC_PsyRpsAdvance () {
    int oppPhys;
    int res;
    int q;
    string oppName;
    string psyStr;
    string oppStr;
    string resStr;
    if (!g_rpsOn) {
        return;
    }
    if (g_rpsStage == 0) {
        if (g_rpsPsyPick <= 0) {
            return;
        }
        psyStr = BOTC_RpsPickStr(g_rpsPsyPick);
        BOTC_PmStore(g_teller, "【精神病患者猜拳】" + BOTC_NameStr(g_rpsQ) + " 选择了" + psyStr + "。");
        oppPhys = g_teller;
        oppName = "说书人";
        if (g_rpsOpp >= 2 && g_rpsOpp <= 13) {
            oppName = BOTC_NameStr(g_rpsOpp);
            oppPhys = g_who[g_rpsOpp];
            if (oppPhys < 1) {
                oppPhys = g_teller;
            }
        }
        BOTC_PubAnnounce("【精神病患者】" + BOTC_NameStr(g_rpsQ) + " 已做出选择。请" + oppName + "选择石头、剪刀或布。");
        g_rpsStage = 1;
        BOTC_PsyRpsShowFor(oppPhys, "：请选择石头、剪刀或布");
        return;
    }
    if (g_rpsOppPick <= 0) {
        return;
    }
    q = g_rpsQ;
    psyStr = BOTC_RpsPickStr(g_rpsPsyPick);
    oppStr = BOTC_RpsPickStr(g_rpsOppPick);
    oppName = "说书人";
    if (g_rpsOpp >= 2 && g_rpsOpp <= 13) {
        oppName = BOTC_NameStr(g_rpsOpp);
    }
    // 1 石头 / 2 剪刀 / 3 布：0 = 精神病患者输，1 = 平局，2 = 精神病患者赢
    res = 0;
    if (g_rpsPsyPick == g_rpsOppPick) {
        res = 1;
    }
    else {
        if (g_rpsPsyPick == 1 && g_rpsOppPick == 2) {
            res = 2;
        }
        else {
            if (g_rpsPsyPick == 2 && g_rpsOppPick == 3) {
                res = 2;
            }
            else {
                if (g_rpsPsyPick == 3 && g_rpsOppPick == 1) {
                    res = 2;
                }
            }
        }
    }
    resStr = "【精神病患者】落败";
    if (res == 2) {
        resStr = "【精神病患者】胜出";
    }
    else {
        if (res == 1) {
            resStr = "平局";
        }
    }
    BOTC_PmStore(g_teller, "【精神病患者猜拳】" + oppName + " 选择了" + oppStr + "。");
    BOTC_PubAnnounce("【猜拳】" + BOTC_NameStr(q) + " 选择了" + psyStr + "，" + oppName + " 选择了" + oppStr + " → " + resStr + "。");
    BOTC_PsyRpsClear();
    if (res == 0) {
        BOTC_PmStore(g_teller, "【精神病患者猜拳】" + BOTC_NameStr(q) + " 落败 → 进入正常处决。");
        BOTC_ExecAfterRps(q);
        return;
    }
    // 赢或平局：处决无事发生。
    BOTC_PubAnnounce("【处决】" + BOTC_NameStr(q) + " 被处决了，但并没有死亡（猜拳未输）。");
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 被处决（猜拳未输，未死亡）----");
    BOTC_PmStore(g_teller, "【精神病患者猜拳】" + BOTC_NameStr(q) + " 没有输（" + resStr + "），处决无事发生。");
    BOTC_GrimRender(g_teller);
    if (g_phase != 0) {
        BOTC_NomCloseEx(false);
    }
}

void BOTC_PsyRpsChoose (int p, int pick) {
    int want;
    if (!g_rpsOn) {
        return;
    }
    if (pick < 1 || pick > 3) {
        return;
    }
    if (g_rpsStage == 0) {
        if (g_rpsPsyPick != 0) {
            return;
        }
        want = g_who[g_rpsQ];
        if (p != want) {
            return;
        }
        g_rpsPsyPick = pick;
        BOTC_PsyRpsAdvance();
        return;
    }
    want = g_teller;
    if (g_rpsOpp >= 2 && g_rpsOpp <= 13) {
        want = g_who[g_rpsOpp];
        if (want < 1) {
            want = g_teller;
        }
    }
    if (p != want) {
        return;
    }
    if (g_rpsOppPick != 0) {
        return;
    }
    g_rpsOppPick = pick;
    BOTC_PsyRpsAdvance();
}

void BOTC_BuildPsyRps () {
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_rpsDlg = DialogLastCreated();
    DialogSetVisible(g_rpsDlg, PlayerGroupAll(), false);
    g_rpsTitle = BOTC_NewLabel(g_rpsDlg, 666, 44, 18, 13, StringToText("猜拳：选择石头、剪刀或布"));
    libNtve_gf_SetDialogItemStyle(g_rpsTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_rpsTitle, false, PlayerGroupAll());
    g_rpsRock = BOTC_NewButton(g_rpsDlg, 200, 50, 27, 81, "石头");
    g_rpsScissors = BOTC_NewButton(g_rpsDlg, 200, 50, 235, 81, "剪刀");
    g_rpsPaper = BOTC_NewButton(g_rpsDlg, 200, 50, 443, 81, "布");
    DialogControlSetVisible(g_rpsRock, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rpsScissors, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rpsPaper, PlayerGroupAll(), false);
}

// 说书人按【死亡标记】：进入 / 退出「点座位标死亡」模式
void BOTC_DeadMode () {
    // 镇长替死正在选人：按【死亡标记】= 放弃这次替死（镇长照常死，用户 2026-09-21）
    if (g_mayorPick) {
        BOTC_MayorCancel();
        return;
    }
    if (g_deadPick) {
        g_deadPick = false;
        libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
        BOTC_BigHintHide(g_teller);               // 退出死亡标记模式：把长驻提示收掉（只收说书人那份）
        return;
    }
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    g_deadPick = true;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡中"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【死亡标记】已进入死亡模式：点击玩家座位公布他的死亡；对已经死亡的玩家再次点击可以复活；对已经退出的玩家使用无效。再次点击按钮可取消死亡模式。");
    // 用户 2026-09-19：跟【唤醒】一样挂一条长驻提示，说清楚怎么点、怎么取消
    BOTC_BigHintShow(1, "选择一个玩家公布他的死亡，再次点击死亡玩家复活他。");
}

// 写 / 清死亡类型
// 死亡 token（暗流涌动只有 3 种死因）：10 处决 / 16 小恶魔 / 19 猎手
//   用户 2026-09-19：死亡类 token 改成所有玩家都能打；玩家那份只管自己的标记，判定仍读说书人那份
bool BOTC_IsDeathTok (int t) {
    int k;
    if (t == 112 || t == 143 || t == 157) {
        return true;
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            return true;
        }
    }
    return false;
}

// 隐形 token：只用来记账，token 面板和圆桌小格都不画（18 = 镇长弹刀用过）
bool BOTC_RoleOnBoard (int r) {
    int i;
    if (r < 0) {
        return true;
    }
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        if (g_boardRole[(g_board * 256) + i] == r) {
            return true;
        }
    }
    return false;
}

bool BOTC_TokHidden (int t, int ob) {
    int r;
    if (t < 0 || t > 255) {
        return true;
    }
    if (t == 18 || g_tokName[t] == "") {
        return true;
    }
    // 【饱餐（食人族）206】（用户 2026-11-10）：食人族不在场时只记账、不显示；
    //   等场上真的出现食人族（真实角色或借用食人族能力者）后，才把已经放好的标记显示出来。
    //   这一条必须排在「失忆者在场 → token 全开」和板子过滤之前，否则会被提前放行。
    if (t == 206) {
        return !(BOTC_CannSeat() > 0 || BOTC_CannAbilitySeat() > 0);
    }
    // 【失忆者（73）在本剧本 → token 全开】（用户 2026-11-06）：失忆者能获得任意角色能力，
    //   不管他是否已经拿到、是否在场，玩家标记面板都要能打上任意角色的 token；
    //   已经打上的 token 也要能在圆桌小格里显示出来。
    if (BOTC_BoardHasRole(73)) {
        return false;
    }
    // 【死亡类 token 按本局角色过滤】：只显示角色在板子里、实际在场或临时获得能力对应的死因。
    //   通用死亡（g_tokRole = -1）仍始终显示，避免暗流涌动列出全套剧本的死亡标记。
    if (BOTC_IsDeathTok(t) || (t >= 32 && t <= 41)) {
        r = g_tokRole[t];
        return !(r < 0 || BOTC_RoleOnBoard(r) || BOTC_RoleInPlay(r));
    }
    // 【是恶魔（小怪宝）134】（用户 2026-10-13 改）：小怪宝没发到玩家手里，所以不看「谁身上有他」----
    //   只要**板子里有小怪宝（112）**，这枚 token 就一直列在面板里（照看人被处决 / 死亡也不会消失）。
    if (t == 134) {
        return !g_lmOn && !BOTC_BoardHasRole(112);
    }
    // 【免死（暴风捕手）133】（用户 2026-10-11 实测报的根因）：暴风捕手是**传奇角色**，
    //   不在 g_boardRole 里（g_tokRole[133] = 113 这条过滤会把整枚 token 藏掉）→ 单独按 g_legacyOn[113] 放行。
    if (t == 133) {
        return !BOTC_StormInGame();
    }
    // 说书人自己拿身份测试时，把该角色专属 token 放行；角色不在配板里也能手动试。
    if (g_testSelfOn && g_tokRole[t] >= 0 && g_mark[(g_teller * 14) + 1] - 1 == g_tokRole[t]) {
        return false;
    }

    if (ob == g_teller) {
        // 【说书人也按「板子上的角色」过滤】（用户 2026-09-26）：跟其他人同一口径 ----
        //   只要本局板子里有这个角色（哪怕这局没发到他身上）就列出来
        return !BOTC_RoleOnBoard(g_tokRole[t]);
    }
    return !BOTC_RoleOnBoard(g_tokRole[t]);
}

bool BOTC_IsHiddenTok (int t) {
    int r;
    if (t < 0 || t > 255) {
        return true;
    }
    if (t == 18) {
        return true;               // 内部记账槽（镇长弹刀）
    }
    // 14 / 15 = 善良 / 邪恶（用户 2026-09-20：重新启用 ---- 这两个 token 现在是能打的）
    //   莽夫（37）转变阵营就是用「邪恶」那一格记的，判胜负时 BOTC_WinAlignOf 会读它。
    // 【饱餐（食人族）206】（用户 2026-11-10）：和 token 面板同一口径——
    //   场上没有食人族（真实角色或借用食人族能力者）时只记账、不在圆桌小格里显示。
    if (t == 206) {
        return !(BOTC_CannSeat() > 0 || BOTC_CannAbilitySeat() > 0);
    }
    // 【是恶魔（小怪宝）134】（用户 2026-10-13 改）：同上 ---- 板子里有小怪宝就一直列出来
    if (t == 134) {
        return !g_lmOn && !BOTC_BoardHasRole(112);
    }
    if (g_testSelfOn && g_tokRole[t] >= 0 && g_mark[(g_teller * 14) + 1] - 1 == g_tokRole[t]) {
        return false;
    }
    if (g_tokName[t] == "") {
        return true;               // 还没用到的空槽
    }
    // 【角色专属 token 的动态监测】（用户 2026-09-19 / 09-20）：
    //   默认「**场上真的有这个角色**」才列出来（场上没有的一律不显示，面板才不会爆满）；
    //   例外：**是疯子(49) / 是酒鬼(8)** ---- 只要**当前板子里有这个身份**就永远能打，
    //   这样才能手动摆两个恶魔、再给其中一个打「是疯子」（酒鬼的「是酒鬼」同理）。
    //   （通用 token 的 g_tokRole = -1，永远显示）
    r = g_tokRole[t];
    if (r >= 0) {
        if (!BOTC_RoleInPlay(r)) {
            if (t != 49 && t != 8 && t != 82 && t != 91 && t != 92) {   // 82/91/92 = 梦殒春宵这批（用户 2026-09-21）
                return true;
            }
            if (!BOTC_BoardHasRole(r)) {
                return true;
            }
        }
    }
    return false;
}

// 当晚已经复活、但红叉要等天亮才公开的玩家。教授 42 / 沙巴洛斯 43 / 哈迪寂亚 113。
bool BOTC_PendingRevive (int q) {
    if (q < 2 || q > 13 || !g_isNight) {
        return false;
    }
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 42] ||
            g_tokOn[(((g_teller * 14) + q) * 256) + 43] ||
            g_tokOn[(((g_teller * 14) + q) * 256) + 113]);
}

// 【胜负 / 人数统计要用的「确定死亡」】（用户 2026-09-20）：**红叉 + 真的死了**都成立才算 ----
//   ① 只是夜里记了死亡 token、还没到天亮盖红叉 → 不算（等天亮统一结算）；
//   ② 僵怖那种「盖了红叉、但其实还活着」（BOTC_SeatDead 返回 false）→ 也不算，他算活着。
bool BOTC_SettledDead (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    // 活尸已经真实死亡；即使广场仍显示存活，也必须计入胜负人数。
    if (g_liveCorpse[q]) {
        return true;
    }
    // 【复活动画还没走完】（用户 2026-09-26）：他其实已经复活了 → 先不算死（免得天亮的播报还没走完就把胜负判了）
    if (g_revFxCt[q] > 0) {
        return false;
    }
    if (!g_deadShown[q]) {
        return false;
    }
    if (!BOTC_SeatDead(q)) {
        return false;
    }
    return true;
}

// 这个座位是不是死的：5 种死亡 token 里任意一个亮着就算；
//   另外**红叉（公开死亡）也算** ---- 因为红叉是「单纯的死亡」（不写任何 token / 类型），
//   死亡类型由说书人在 token 面板手动打（见 BOTC_MarkDeadPlain）。
bool BOTC_SeatDead (int q) {
    int t;
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    // 活尸：来源仍有效且未公开死亡时，能力互动按存活；来源失效 / 公开死亡后按死亡。
    if (g_liveCorpse[q]) {
        return (!BOTC_LivingCorpseCountsAlive(q));
    }
    // 【复活当晚按内部存活处理】（用户 2026-11-02）：红叉保留给天亮公布，
    // 但教授 / 沙巴洛斯 / 哈迪寂亚的复活对象在夜间可被唤醒、可选择，也按活着结算。
    if (BOTC_PendingRevive(q)) {
        return false;
    }
    // 僵怖（43）：第一次死亡不会真的死 ---- 全桌看到的是「死了」（公开红叉那一层照常画），
    //   内部一切按活着算（胜负 / 唤醒 / 技能检测读的都是这里）。用户 2026-09-20
    if (g_zombFake[q]) {
        return false;
    }
    if (g_deadShown[q]) {
        return true;
    }
    for (t = 0; t < g_deathN; t += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[t]]) {
            return true;
        }
    }
    for (t = 32; t <= 41; t += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
            return true;
        }
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 143]) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 112]) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 157]) {
        return true;
    }
    return false;
}

// 死亡类型 → token 索引
// 公开死亡（别人看得到的）：处决 / 死亡标记 / 小恶魔天亮结算 / 猎手命中 才会点亮
bool BOTC_PublicDead (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    return g_deadShown[q];
}

// 【结算后移除中途退出的座位】（用户 2026-11-01）：胜负已算出之后调用 ——
//   清掉"保留座位"与"蓝叉"两张表，再重排一次圆桌，退出玩家的座位就从圈里消失。
void BOTC_ClearLeftSeats () {
    int i;
    for (i = 1; i <= 13; i += 1) {
        g_leftKeepP[i] = false;
        g_leftDeadP[i] = false;
        // 【这里要一起把"这一格上一轮还在场"的缓存清掉】（用户 2026-11-07）：
        //   BOTC_BuildSeatList 现在会按 g_seatOn 兜底保留"人已不在游戏"的座位，
        //   不清掉的话结算后点【重新开始】座位会去不掉。
        g_seatOn[i] = false;
    }
    BOTC_GrimRelayout();
}

// 死亡类型 → token 索引（暗流涌动只有 3 种死因：处决 / 小恶魔 / 猎手）
//   夜间死（含镇长替死：也是夜里被恶魔攻击引起的）→ 小恶魔；白天死 → 猎手
//   数据层 g_deadKind / g_deadByDemon 照旧保留，送葬者 / 守鸦人 / 贤者那些判定继续读它
int BOTC_DeathTokIndex (int kind, int byDemon) {
    int k;
    // 先找「类别 + 是不是恶魔杀」都对的
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] == kind && g_deathByDemon[k] == byDemon) {
            return g_deathTok[k];
        }
    }
    // 退一步：只按类别找（比如镇长替死是夜里死、但不是恶魔直接杀）
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] == kind) {
            return g_deathTok[k];
        }
    }
    if (g_deathN > 0) {
        return g_deathTok[0];
    }
    return -1;
}

// 【说书人手动打「死亡」token = 这个人真的死了】（用户 2026-09-22）：token 面板上打
//   「死亡（造谣者）」这种死因，以前只记类型，不打红叉也不播报 ---- 天亮什么都没发生。
//   现在的口径：夜里记的交给天亮统一公布；白天记的当场公布（红叉 + 死亡音效 + 公屏）。
//   已经公开死过的人不会再播一遍（他本来就是用【死亡标记】公开的）。
void BOTC_PublishDeathNow (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_PublicDead(q)) {
        return;
    }
    BOTC_PlaySfx("Marine_Death");
    g_deadPending[q] = false;
    g_deadShown[q] = true;
    if (!g_isNight) {
        g_deadClaimDay[q] = g_dayNum;      // 白天公布死讯：当天白天才允许死后声称（月之子 / 呆瓜）
    }
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
    BOTC_BansheeAnnounce(q);
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    BOTC_MoonChildCheck(q);
    BOTC_KlutzCheck(q);
    BOTC_DeclareRender();
}

// 说书人在 token 面板手动点「死亡」那一格：把其它死亡 token 关掉，并把死亡类型同步过来
//   （守鸦人「今晚死的」、送葬者都读这套类型）
void BOTC_SyncDeathFromTok (int q, int t) {
    int k;
    int hook;
    string blk;
    if (q < 1 || q > 13) {
        return;                           // 允许 1：说书人自己那一格
    }
    hook = BOTC_SkinDeathHook(q);
    if (hook == 1) {
        return;
    }
    if (g_liveCorpse[q]) {
        BOTC_LivingCorpseFinalize(q);
        return;
    }
    g_lastDeadSeat = q;               // 【最近一次死亡】（2026-10-11）
    // 镇长（12）：即将被打上「夜间」死亡 token → 先弹窗问说书人（用户 2026-09-21）
    if (BOTC_MayorInterceptTok(q, t)) {
        return;
    }
    // 僵怖（43）：手动打死亡 token 也必须先过「第一次不会死」----
    // 用户 2026-10-21 报：说书人打夜间死亡 token 后，僵怖被误算成真死。
    // 第一次：消耗假死，并撤掉刚点亮的死亡 token；天亮仍按假死统一公开。
    // 已经假死：这次 token 就是第二次死亡，继续走下面的真死分支。
    if (!g_zombFake[q] && BOTC_ZombuulFake(q)) {
        for (k = 0; k < g_deathN; k += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[k]] = false;
        }
        for (k = 32; k <= 41; k += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + k] = false;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 143] = false;
        BOTC_GrimRender(g_teller);
        // 白天手动记死亡时仍要当场公开；夜里留给天亮队列统一公开。
        if (!g_isNight) {
            BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
            BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
            BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
        }
        return;
    }
    if (g_zombFake[q]) {
        g_zombFake[q] = false;
        BOTC_PmStore(g_teller, "【僵怖】说书人手动记了 " + BOTC_NameStr(q) + " 的死亡 → 按真死算。");
    }
    // 【通用规则】他离场 → 他带来的 token 与配套记录一起收掉（用户 2026-09-20）
    // 【保留能力（亡骨魔）】（用户 2026-09-21）：带着这枚标记的爪牙死后能力还在
    //   → 不收他的 token、也不作废配套记录（离场清理整段跳过）
    if (!BOTC_KeepsAbilityAlive(q)) {
        BOTC_SourceGoneCleanup(q, true);
    }
    BOTC_PlagueDoctorDeath(q);
    // 【牙噶巴卜死亡 token】同一枚 token 按打上的时段决定是白天还是夜晚恶魔杀。
    if (t == 158) {
        for (k = 0; k < g_deathN; k += 1) {
            if (g_deathTok[k] == 158) {
                g_deathKind[k] = 1;
                if (!g_isNight) {
                    g_deathKind[k] = 2;
                }
                g_deathByDemon[k] = 1;
            }
        }
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] != t) {
            g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[k]] = false;
        }
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            g_deadKind[q] = g_deathKind[k];
            g_deadByDemon[q] = g_deathByDemon[k];
            g_deadType[q] = k;                     // 记住是表里第几条（自刀传位靠它区分小恶魔 / 普卡）
            if (g_deathKind[k] == 1) {
                g_deadNightNum[q] = g_nightNum;
            }
            else {
                g_deadNightNum[q] = 0;
            }
            // 【僵怖 / 教父要用】手动记的死亡也按「发生的时间」标：白天 = 今天（用户 2026-09-20）
            if (g_isNight) {
                g_deadDay[q] = 0;
            }
            else {
                g_deadDay[q] = g_dayNum;
                if (BOTC_RoleEffInPlay(43)) {
                    g_tokOn[(((g_teller * 14) + q) * 256) + 57] = true;
                }
                // 【教父（39）的「死于今日」】（用户 2026-09-20）：白天死的是**外来者**才打（按互动干扰算，
                //   跟 BOTC_GodfatherCanKill 的判定一致）；他今晚能不能动就看这一格。
                // 【教父×陌客】（用户 2026-11-05）：陌客白天死亡改由说书人弹窗裁定。
                if (!BOTC_GfRecluseDayAsk(q)) {
                    if (BOTC_RoleEffInPlay(39) && BOTC_SeatRegTeam(q) == 1) {
                        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = true;
                    }
                }
            }
            // 【保护 / 免死提示】（用户 2026-09-19）：说书人手动打死亡 token 时**只提示、不硬拦** ----
            //   他才是最终裁定者（例如和平主义者就是「可能不死」）。按规则这刀不该生效就把原因说清楚。
            blk = BOTC_DeathBlocker(q, g_deathKind[k], g_deathByDemon[k], false);
            if (blk != "") {
                BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(q) + " 现在带着【" + blk + "】，按规则这次死亡不该生效 ---- 你仍可以照记。");
            }
        }
    }
    // 【哈迪寂亚 / 杂技演员的专属死亡 token】（用户 2026-10-24）：
    //   112 / 157 有明确 token，但以前既不在 g_deathTok，也不在 32..41 区段，
    //   所以死亡 token 面板能点亮，死亡记录却完全不动。
    if (t == 112 || t == 157) {
        for (k = 0; k < g_deathN; k += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[k]] = false;
        }
        for (k = 32; k <= 41; k += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + k] = false;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 112] = (t == 112);
        g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 143] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 157] = (t == 157);
        g_deadKind[q] = 1;
        g_deadByDemon[q] = 0;
        if (t == 112) {
            g_deadByDemon[q] = 1;
        }
        g_deadType[q] = -1;
        g_deadNightNum[q] = g_nightNum;
        g_deadDay[q] = 0;
        blk = BOTC_DeathBlocker(q, 1, g_deadByDemon[q], false);
        if (blk != "") {
            BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(q) + " 现在带着【" + blk + "】，按规则这次死亡不该生效 ---- 你仍可以照记。");
        }
    }
    // 角色专属的死亡 token（32~41，例如「死亡（赌徒）」）：大类按「夜间 · 其他」同步
    if ((t >= 32 && t <= 41) || t == 143) {
        // 【只留一个死因】（用户 2026-09-22）：这一批不属于死亡类型表，以前不会互相顶掉，
        //   结果一个人身上能同时亮「死亡（造谣者）」和「死亡（赌徒）」。
        for (k = 32; k <= 41; k += 1) {
            if (k != t) {
                g_tokOn[(((g_teller * 14) + q) * 256) + k] = false;
            }
        }
        if (t != 143) { g_tokOn[(((g_teller * 14) + q) * 256) + 143] = false; }
        k = BOTC_DeathRowOf(1, 0);
        g_deadKind[q] = g_deathKind[k];
        g_deadByDemon[q] = g_deathByDemon[k];
        g_deadType[q] = k;
        g_deadNightNum[q] = g_nightNum;
        g_deadDay[q] = 0;                      // 角色专属死亡 token 都归「夜间」那一档（教父 / 僵怖不算今天）
        blk = BOTC_DeathBlocker(q, 1, 0, false);
        if (blk != "") {
            BOTC_PmStore(g_teller, "【提示】" + BOTC_NameStr(q) + " 现在带着【" + blk + "】，按规则这次死亡不该生效 ---- 你仍可以照记。");
        }
    }
    // 【农夫（80）】：夜间死亡先记待处理，到农夫自己的夜序节点再弹选人面板。
    if (BOTC_HasAbility(q, 80) && !g_levJinxLost[q] && BOTC_SeatDead(q) && g_deadKind[q] == 1) {
        g_farmPending[q] = true;
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(q) + " 夜间死亡 → 等到农夫夜序节点再选择新的农夫。");
    }
    // 【打上死亡 token = 这个人真的死了】（用户 2026-09-22）：说书人只在 token 面板打
    //   死因 token 也算死 ---- 夜里记的等天亮统一公布，白天记的当场公布。
    if (q >= 2 && q <= 13 && !BOTC_PublicDead(q)) {
        if (g_isNight) {
            g_deadPending[q] = true;
        }
        else {
            BOTC_PublishDeathNow(q);
        }
    }
    BOTC_HatDeath(q);
    BOTC_BansheeAnnounce(q);
    // 【唱诗男孩（108）】（用户 2026-10-10）：这一格是国王、而且刚打的正是「夜间 · 恶魔杀」→ 提醒说书人
    if (BOTC_HasAbility(q, 104)) {
        for (k = 0; k < g_deathN; k += 1) {
            if (g_deathTok[k] != t) { continue; }
            if (g_deathKind[k] != 1) { continue; }
            if (g_deathByDemon[k] != 1) { continue; }
            BOTC_ChoirboyCheck(q);
        }
    }
    BOTC_BartenderSync();          // 【酒保】非处决死亡 → 立即撤掉「醉酒（酒保）」196（用户 2026-11-11）
}

// 唤醒提示里用的名字：他明面上的身份（魔典上写的那个），
//   酒鬼（14）/ 疯子（38）在后面加个括号说明（用户 2026-09-20）
//   ⚠ 这里判的是**真身**：只是「被醉 / 被毒」的人不加括号（以前用的是 BOTC_SeatIsDrunk，
//     那样连被水手醉过的普通玩家都会被标成「（酒鬼）」）
string BOTC_SeatRoleStr (int q) {
    int r;
    // 【使用技能】（用户 2026-11-06）：说书人临时扮演的角色直接显示该角色名。
    if (q == 1 && g_tellCastRole > 0 && g_tellCastRole <= 163) {
        return g_roleName[g_tellCastRole - 1];
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return "未定";
    }
    if (BOTC_SeatTrueRole(q) == 14) {
        return g_roleName[r] + "（酒鬼）";       // 酒鬼：魔典上是他「以为自己是」的那个镇民
    }
    if (BOTC_IsLunatic(q)) {
        return g_roleName[r] + "（疯子）";       // 疯子（38）：魔典上是他「以为自己是」的那只恶魔
    }
    if (BOTC_SeatTrueRole(q) == 118) {
        return g_roleName[r] + "（悟道者）";   // 悟道者：魔典上是他「以为自己是」的那张外来者
    }
    return g_roleName[r];
}

// 【普通死亡】红叉：只是「他死了」----**不写任何死亡 token、不记死亡类型**。
//   死亡类型（夜间/恶魔、处决...）由说书人在 token 面板手动打（见 BOTC_SyncDeathFromTok）。
//   这样「白天用别的办法弄死小恶魔」不会误触发「自刀 → 传位」那套判定。
//   注意：BOTC_SeatDead() 会把「红叉（g_deadShown）」也算成死，所以内部判定照常有效。
//==================================================================================================
// 【通用规则 · 角色离场】（用户 2026-09-20）：某个角色死亡 / 离场之后，除非有特殊说明，
//   「他带来的」token 一起收掉，配套的全局记录也一起归零。
//   例：旅店老板死了 → 他给的「免死 / 醉酒」跟着没；驱魔人死了 → 被点名的标记也没了；
//       茶艺师死了 → 他给的那两个「免死」跟着没。
//   例外（不清，因为那是「记录」或「事实」，不是能力的效果）：
//     · 死亡 token（16/19/21/22/23/32~41）与复活 token（42/43）---- 清了等于把人复活 / 抹掉已经发生的事
//     · 身份标记（8 是酒鬼 / 49 是疯子 / 13 是恶魔）、「攻击三次（珀）」「已假死（僵怖）」
//     · 通用「醉酒 24」：那一格是手动槽，谁醉的不一定跟这一格绑，所以不动它
//   2026-11-11：孙子（30）、干扰项（6）和各角色的「失去能力 / 已使用」记录改为按详情页
//   的移除时机（死亡或离场）一起收掉，不再当永久记录保留。
//==================================================================================================
bool BOTC_InfoErrorOn (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (g_liveCorpse[q]) {
        return true;
    }
    return g_tokOn[(((g_teller * 14) + q) * 256) + 84] || g_tokOn[(((g_teller * 14) + q) * 256) + 170];
}

bool BOTC_TokGoneWithSource (int t) {
    if (t == 7) { return true; }                            // 中毒（投毒者）
    if (t == 9) { return true; }                            // 保护（僧侣）
    if (t == 20) { return true; }                           // 主人（管家）
    if (t == 25) { return true; }                           // 不会死亡（旅店老板）
    if (t == 26) { return true; }                           // 不会死亡（水手）
    if (t == 27) { return true; }                           // 处决不死（魔鬼代言人）
    if (t == 28) { return true; }                           // 处决不死（和平主义者）
    if (t == 29) { return true; }                           // 首次未死（弄臣）
    if (t == 31) { return true; }                           // 被选择（驱魔人）
    if (t == 48) { return true; }                           // 被选择（疯子）
    if (t == 50) { return true; }                           // 全员醉酒（吟游诗人）
    if (t == 51) { return true; }                           // 不会死亡（茶艺师）
    if (t == 53 || t == 54 || t == 55) { return true; }     // 醉酒（侍臣）：三天三夜那三格
    if (t == 59) { return true; }                           // 醉酒（水手）
    if (t == 60) { return true; }                           // 醉酒（旅店老板）
    if (t == 61) { return true; }                           // 醉酒（莽夫）
    if (t == 62) { return true; }                           // 醉酒（吟游诗人）
    if (t == 63) { return true; }                           // 中毒（普卡）
    if (t == 120) { return true; }                          // 中毒（痢蛭）
    if (t == 73) { return true; }                           // 被诅咒（女巫）：她死亡/离场时收掉（官方时机，用户 2026-09-21）
    // 【四个恶魔的常驻标记】（用户 2026-09-21）：来源角色离场就收掉（百科的移除时机）
    if (t == 79 || t == 81) { return true; }                // 保留能力 / 中毒（亡骨魔）→ 亡骨魔死亡或离场时
    if (t == 80) { return true; }                           // 中毒（诺-达鲺）→ 诺-达鲺死亡或离场时
    if (t == 84) { return true; }                           // 信息错误（涡流）→ 涡流死亡或离场时
    if (t == 95) { return true; }                           // 得知（气球驾驶员）→ 气球驾驶员死亡或离场时
    if (t == 102) { return true; }                          // 已被猜测（落难少女）→ 落难少女死亡或离场时
    // 【镜像双子 / 对立双子】（官方移除时机）：镜像双子死亡或离场时收掉（用户 2026-09-21）
    if (t == 76 || t == 77) { return true; }
    if (t == 123) { return true; }                          // 是炼金术士（95）：炼金术士离场 / 被换掉身份时收掉
    // 【何方教众（板子 9）的新标记】（用户 2026-10-10）：来源角色死亡 / 离场就收掉（跟上面同一套规则）
    if (t == 125) { return true; }                          // 失去能力（传教士）
    // 【醉酒（村夫）126 不进本表】（用户 2026-11-11）：这枚标记的移除时机是「在该村夫离场时」，
    //   由 BOTC_VillageSync() 按真实身份 + 存活单独重算：持有者死亡 / 被换身份就移走，
    //   场上仍有 ≥2 名存活村夫时改放到另一名村夫；清醒村夫离场不撤标记
    //   （百科「如果所有清醒的村夫都离场，剩余的醉酒村夫仍然保持醉酒状态」）。
    // 【解谜大师 129】（用户 2026-11-11）：他离场时才撤掉醉酒，他本人死亡时保留 ----
    //   不在本表里，由 BOTC_SourceGoneCleanup 单独按「非死亡」处理。
    // 【失足（半兽人）127】（用户 2026-11-11）：半兽人死亡或离场都收掉这枚标记。
    if (t == 127) { return true; }                          // 失足（半兽人）
    if (t == 128) { return true; }                          // 死亡（半兽人）
    if (t == 133) { return true; }                          // 免死（暴风捕手）
    if (t == 135) { return true; }                          // 熟客（店小二）：随来源离场收掉；醉酒 136 单独处理（离场清、本人死亡不清）
    if (t == 138) { return true; }                          // 善良中毒（混沌）（用户 2026-10-16：混沌死亡 / 离场就收）
    if (t == 147) { return true; }                          // 守夜人的「失去能力」随角色离场
    if (t == 156) { return true; }                          // 杂技演员的「被选择」随角色离场
    if (t == 161) { return true; }                          // 瘟疫医生给予的说书人能力
    if (t >= 162 && t <= 165) { return true; }              // 鹰身女妖 / 街头风琴手的提示标记
    if (t == 170) { return true; }                           // 捣蛋（熊孩子）
    if (t == 178) { return true; }                           // 中毒（食人族）→ 食人族本人离场 / 被换掉身份时收掉
    if (t == 207) { return true; }                           // 挚友（食人魔）→ 食人魔离场时收掉
    if (t == 208) { return true; }                           // 具有能力（报丧女妖）→ 报丧女妖离场时收掉（死亡时保留）
    // 【详情页写的「死亡或离场时移除」】（用户 2026-11-11）：补齐这些「失去能力 / 已使用」记录。
    if (t == 6) { return true; }                             // 干扰项（占卜师）
    if (t == 12) { return true; }                            // 失去能力（猎手）
    if (t == 17) { return true; }                            // 失去能力（贞洁者）
    if (t == 30) { return true; }                            // 孙子（祖母）
    if (t == 44) { return true; }                            // 失去能力（教授）
    if (t == 45) { return true; }                            // 失去能力（刺客）
    if (t == 46) { return true; }                            // 失去能力（弄臣）
    if (t == 47) { return true; }                            // 失去能力（侍臣）
    if (t == 68) { return true; }                            // 失去能力（女裁缝）
    if (t == 69) { return true; }                            // 失去能力（艺术家）
    if (t == 98) { return true; }                            // 失去能力（巡山人）
    if (t == 99) { return true; }                            // 失去能力（工程师）
    if (t == 100) { return true; }                           // 失去能力（渔夫）
    if (t == 101) { return true; }                           // 无法提名（魔像）
    if (t == 103) { return true; }                           // 转为邪恶（灵言师）
    if (t == 104) { return true; }                           // 失去能力（灵言师）
    if (t == 114) { return true; }                           // 得知（赏金猎人）
    if (t == 130) { return true; }                           // 已猜测（解谜大师）
    if (t == 144) { return true; }                           // 醉酒（鸩）
    // 【是恶魔（小怪宝）134 **不再跟来源走**】（用户 2026-10-13）：照看人被处决 / 离场时，
    //   原来这里会把 token 一起收掉（他的真身被读成 112 → 被当成「小怪宝离场」）----
    //   现在这枚 token 归板子管（见 BOTC_TokHidden），要挪 / 要撤由说书人自己在 token 面板上点。
    return false;
}

// 某个座位离场（死亡 / 被换掉身份）：扫掉「来源角色 = 他的真身」的那批 token，并把配套记录归零
void BOTC_SourceGoneCleanup (int q, bool dying) {
    int r;
    int i;
    int t;
    int n;
    if (q < 1 || q > 13) {
        return;
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return;
    }
    // 【离场即清 · 不看死亡】（用户 2026-11-11）：解谜大师「醉酒」129、店小二「醉酒」136、
    //   心上人「醉酒」82 的移除时机都是「本人离场时」，与本人是否已经死亡无关：
    //   死亡本身不清（心上人正是死亡时才放标记），之后被换身份 / 被交换角色仍按离场清。
    //   放在这里而不是 BOTC_TokGoneWithSource：那一层不分 dying，会把死亡那一路也一起收掉。
    //   按能力层 + 真值行判断，覆盖说书人赋予、哲学家 / 食人族借用以及酒鬼 / 提线木偶假扮。
    if (!dying) {
        if (r == 61 || BOTC_HasAbility(q, 61) || g_mark[(g_teller * 14) + q] - 1 == 61) {
            for (i = 2; i <= 13; i += 1) {
                if (g_tokOn[(((g_teller * 14) + i) * 256) + 82]) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 82] = false;
                    BOTC_PmStore(g_teller, "【心上人】" + BOTC_NameStr(q) + " 离场 → " + BOTC_NameStr(i) + " 不再醉酒。");
                }
            }
        }
        if (r == 115 || BOTC_HasAbility(q, 115) || g_mark[(g_teller * 14) + q] - 1 == 115) {
            for (i = 2; i <= 13; i += 1) {
                if (g_tokOn[(((g_teller * 14) + i) * 256) + 136]) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
                    BOTC_PmStore(g_teller, "【店小二】" + BOTC_NameStr(q) + " 离场 → " + BOTC_NameStr(i) + " 不再醉酒。");
                }
            }
        }
        if (r == 109 || BOTC_HasAbility(q, 109) || g_mark[(g_teller * 14) + q] - 1 == 109) {
            for (i = 2; i <= 13; i += 1) {
                if (g_tokOn[(((g_teller * 14) + i) * 256) + 129]) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 129] = false;
                    BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(q) + " 离场 → " + BOTC_NameStr(i) + " 不再醉酒。");
                }
            }
        }
    }
    if (r == 151) {
        g_rascalActive[q] = false;
        g_rascalRole[q] = 0;
    }
    if (r == 153 && !g_vixenExecPending) {
        BOTC_VixenClear();
    }
    if (r == 155) {
        BOTC_SkinSourceGone(q);
    }
    if (r == 159) {
        BOTC_BrokerClear("掮客离场");
    }
    if (r == 161) {
        BOTC_HeshangDawnClear();
    }
    if (r == 162) {
        BOTC_GudiaoSourceGone(q);
    }
    if (r == 163) {
        BOTC_WardenClear(q, true);
    }
    // 【限（147）】（用户 2026-11-11）：官方移除时机写的是「下一次黄昏，或限死亡 / 离场时」，
    //   黄昏那一段已有，这里补来源离场（死亡 / 换身份）时收回 168 / 169。
    if (r == 147) {
        BOTC_XaanPoisonClear("限离场");
    }
    // 【舞蛇人的毒】（用户 2026-09-21）：中毒这个人死了 / 离场 → 这一格收掉（官方提示标记的移除时机）
    // 【哲学家（56）】（用户 2026-11-11）：官方写的移除时机是「哲学家死亡或离场时」→
    //   用过能力的哲学家真身已经换成借来的角色，只能靠「是哲学家」70 认出来，
    //   所以放弃按 r == 56 判断，改按 70 收：死亡和换身份（离场）都清 70、全场 90 和 g_philoRole。
    //   ⚠ 哲学家自己发动能力时也会改一次身份，但那一刻 70 还没打上，不会误清。
    //   ⚠ g_philoRole 不清的话，BOTC_PhiloDrunkSync 会按旧记录把 90 再加回来。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        g_philoRole = 0;
        g_tokOn[(((g_teller * 14) + q) * 256) + 70] = false;
        // 【死亡 → 真值行还原成哲学家】（用户 2026-11-11）：用过能力后真值行写的是借来的角色，
        //   死亡时还原成 56，说书人魔典不再显示借来的角色，送葬者 / 守鸦人 / 食人族
        //   读到的死者身份也回到哲学家；换身份（离场）不还原，新身份照旧生效。
        //   ⚠ 必须用调用方传进来的 dying，不能读 BOTC_SeatDead(q)：
        //     红叉 / 普通死亡 / 活尸这几条路都是先清 token、后写死亡状态，
        //     清理那一刻 BOTC_SeatDead(q) 还没变真。
        if (dying) {
            g_mark[(g_teller * 14) + q] = 57;
            BOTC_GrimRender(g_teller);
        }
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 90]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 90] = false;
                BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(q) + " 离场 → " + BOTC_NameStr(i) + " 不再醉酒。");
            }
        }
    }
    // 【炼金术士（95）死亡 → 收掉「是炼金术士」并把真值行还原成 96】（用户 2026-11-13）：
    //   借到爪牙能力后真值行写的是借来的爪牙，死亡时删除 123、还原成 96（炼金术士），
    //   说书人魔典不再显示那只爪牙；g_alcBorrow 一并清空，避免借来的能力残留。
    //   换身份由 BOTC_SetSeatRole 自己清 123 并写入新身份，不走这里。
    if (dying && g_tokOn[(((g_teller * 14) + q) * 256) + 123]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 123] = false;
        g_alcBorrow = 0;
        g_mark[(g_teller * 14) + q] = 96;
        BOTC_GrimRender(g_teller);
    }
    // 【变脸师（117）死亡 → 真值行还原】（用户 2026-11-11）：临时变脸期间死亡，
    //   把说书人魔典上的角色标记还原成原身份，并收掉「是变脸师」205 与临时状态
    //   （借用变脸师能力的座位 g_faceBase 为 0，只清状态、不动标记）。
    //   换身份走 BOTC_SetSeatRole 里的 BOTC_FaceStateClear，不走这里。
    if (dying && g_faceShow[q] > 0) {
        if (g_faceBase[q] > 0 && g_mark[(g_teller * 14) + q] == g_faceShow[q]) {
            g_mark[(g_teller * 14) + q] = g_faceBase[q];
        }
        BOTC_FaceStateClear(q);
        BOTC_GrimRender(g_teller);
    }
    // 【管家（13）死亡 / 离场】（用户 2026-11-11）：官方移除时机是「管家死亡或离场时」，
    //   换身份也要清掉主人记录（token 20 由下面「来源离场」那段收）----
    //   否则新身份会被旧主人一直卡投票，直到本局结束。
    if (g_butlerSeat == q) {
        g_butlerSeat = 0;              // 【不提示】（用户 2026-10-13）：清掉就行
        g_butlerMaster = 0;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 85]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 85] = false;
    }
    n = 0;
    for (i = 1; i <= 13; i += 1) {
        for (t = 0; t < 256; t += 1) {
            if (t == 123) {
                continue;                       // 【是炼金术士】（用户 2026-10-16）：炼金术士死亡 / 离场也**不撤**这枚 token
            }
            if (t == 7) {
                continue;                       // 【中毒（投毒者）】（用户 2026-11-01）：只由下面「投毒者本人离场」那一行清，
                                                //   否则任何一格被改成投毒者都会把别人身上的毒 token 一起抹掉。
            }
            if (t == 208 && dying) {
                continue;                       // 【具有能力（报丧女妖）】（用户 2026-11-11）：死亡时保留，只有非死亡离场才收。
            }
            if (!BOTC_TokGoneWithSource(t)) {
                continue;
            }
            if (g_tokRole[t] != r) {
                continue;
            }
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + t]) {
                continue;
            }
            g_tokOn[(((g_teller * 14) + i) * 256) + t] = false;
            n = n + 1;
        }
    }
    // 【小精灵（91）】（用户 2026-11-11）：官方写「疯狂标记会在小精灵死亡或离场时移除」→
    //   死亡与换身份都要收掉目标身上的「疯狂（小精灵）」116；117「获得能力」仍只按离场清（下面那段）。
    if (g_pixieSeatBy[q] > 0 && g_pixieSeatBy[q] <= 13) {
        g_tokOn[(((g_teller * 14) + g_pixieSeatBy[q]) * 256) + 116] = false;
    }
    // 【提示标记移除时机补齐】（用户 2026-11-11）：小精灵「获得能力」117、书生「已被猜测」180
    //   官方只写「离场时移除」，本人死亡不清；只有真换身份（非死亡）才收。
    //   ⚠ 用调用方传进来的 dying 判断，理由同上（清理时 BOTC_SeatDead 还没变真）。
    if (!dying) {
        if (g_pixieSeatBy[q] > 0) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 117] = false;
            g_pixieRoleBy[q] = 0;
            g_pixieSeatBy[q] = 0;
            g_pixieDone[q] = false;
            g_pixieAsked[q] = false;
            n = n + 1;
        }
        if (BOTC_HasAbility(q, 152) && g_tokOn[(((g_teller * 14) + q) * 256) + 180]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 180] = false;
            n = n + 1;
        }
    }
    // 配套的全局记录：token 没了就把「记着的那个座位」也清掉，免得黄昏 / 天亮还按旧记录结算
    if (g_poisonAt[q] >= 2) {
        // 【按来源独立】（用户 2026-11-13）：借到投毒者能力的炼金术士等同样按自己的记录收毒，
        //   不按真身 17 判断；其他来源的毒不受影响。
        BOTC_PoisonClearSource(q, "投毒者离场");
    }
    if (r == 23) { BOTC_SailorDrunkClear("水手离场"); }
    if (r == 7) { g_monkA = 0; g_monkNight = 0; }
    if (r == 25) { g_exoJinxSeat = 0; g_exoJinxNight = 0; }
    if (r == 26) { BOTC_DrunkClear("旅店老板离场"); g_innA = 0; g_innB = 0; g_innNight = 0; }
    // 【借来的旅店老板能力】（用户 2026-11-08）：哲学家 / 食人族 / 炼金术士 / 说书人赋予的能力持有者
    //   死亡 / 离场时，按 g_drunkFrom 收掉他放的那份醉酒（token 60 / 24），不能只认真身 26。
    if (r != 26 && g_drunkFrom == q) { BOTC_DrunkClear("旅店老板能力持有者离场"); }
    // 【洗脑师】（用户 2026-11-10）：来源死亡 / 离场 / 换身份 → 撤掉他那一份疯狂记录与 token
    //   按记录判断而不是按真身 66，这样借用洗脑师能力的玩家离场也能正确收掉自己那一份。
    if (g_cerenTgt[q] > 0 || g_cerenOld[q] > 0) {
        BOTC_CerenSourceGone(q);
        n = n + 1;
    }
    if (r == 44) { BOTC_PukkaPoisonClear("普卡离场"); }
    if (r == 100) { BOTC_LleechPoisonClear("痢蛭离场"); }    // 中毒（痢蛭）120
    if (r == 95) { }          // 炼金术士离场：123「是炼金术士」的清理在下面统一做
    if (r == 102) { BOTC_FearClear("恐惧之灵离场"); }        // 撤掉所有「恐惧」121
    if (r == 137) {
        g_pdRole = 0;
        g_pdPick = false;
        if (g_pdBtn > 0) {
            DialogControlSetVisible(g_pdBtn, PlayerGroupAll(), false);
        }
    }
    if (r == 139) {
        g_harpyFirstBy[q] = 0;
        g_harpySecondBy[q] = 0;
        g_harpyDay[q] = 0;
    }
    if (r == 140) {
        g_organDrunkBy[q] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 164] = false;
    }
    if (r == 141) {
        g_vizierSeat = 0;
        g_vizierGood = 0;
        g_vizierAnnounced[q] = false;
        for (q = 1; q <= 13; q += 1) {
            g_vizierClaimed[q] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 166] = false;
        }
    }
    // 【何方教众（板子 9）】（用户 2026-10-10）：配套记录的清理
    if (r == 107) { g_lycanNoDemon = false; }               // 半兽人离场：今晚「恶魔不造成死亡」作废
    if (r == 113) { g_stormOn = false; g_stormSeat = 0; }    // 暴风捕手离场：保护作废
    // 【逆臣（119）】（用户 2026-10-16）：他死亡 / 离场且没触发阵营转变 → 「不共戴天」收掉（百科的移除时机）
    if (r == 119) {
        g_tcSeat = 0;
        g_tcPending = 0;
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 139] = false;
        }
    }
    if (r == 29) {                    // 侍臣离场：三天三夜的醉酒作废
        g_courtSeat = 0;
        g_courtLeft = 0;
        g_courtPick = false;
        g_courtBy = 0;
    }
    if (r == 31) {                    // 吟游诗人离场：全员醉酒那一份作废
        g_minstrelDay = 0;
        for (i = 2; i <= 13; i += 1) {
            g_minstrelDrunk[i] = false;
        }
    }
    if (r == 37) {                    // 莽夫离场：今夜「第一个选他的人」作废
        g_goonSeat = 0;
        g_goonBy = 0;
    }
    if (r == 25) {                    // 驱魔人离场：今晚那次封锁作废
        g_exoBlock = 0;
        g_exoFrom = 0;
        g_exoNight = 0;
    }
    // 【镜像双子（64）】（用户 2026-09-21）：**他死亡 / 离场 → 配对战作废** ----
    //   76 / 77 两个标记在上面那轮扫描里已经按百科收掉；这里把「记着的那一对」也清空，
    //   这样以后又出现新的镜像双子时，说书人能在夜里重新给他配一名对立双子。
    if (r == 64) {
        g_twinA = 0;
        g_twinB = 0;
        g_twinPick = false;
    }
    // 【女巫（65）】她死亡 / 离场 / 换身份：诅咒和「只剩三人失效」记录一起作废；
    // 如果之后又有新的女巫进入游戏，会按当时人数重新判断。
    if (r == 65) {
        BOTC_WitchCurseClear("女巫死亡或离场");
        g_witchFrom = 0;
        g_witchLost = false;
    }
    // 【寡妇（75）】（用户 2026-09-23）：她死亡 / 离场 → 她那一份中毒解除
    if (r == 75) {
        BOTC_WidowPoisonClear("寡妇死亡或离场");
        g_widowP = 0;
    }
    // 【解谜大师（109）/ 店小二（115）】：他们的醉酒标记（129 / 136）改为在
    //   BOTC_SetSeatRole 的「换身份 = 离场」分支统一处理，这样死亡后又被换身份也能撤掉，
    //   而本人单纯死亡时不会经过那条分支，标记保留到本局结束；店小二熟客 135 仍随来源收。
    if (n > 0) {
        BOTC_GrimRender(g_teller);
    }
    BOTC_LeviathanSpecialSync();
    BOTC_LeviathanTokenWin();
}

// 【僵怖的死亡音效要不要静音】（用户 2026-09-22）----
//   清醒僵怖的「第一次死亡」（假死）由 BOTC_ZombuulFake 自己放一声（白天当场放；夜里那一次由天亮统一公布时放）；
//   他的「第二次死亡」（真死）不再放 ---- 全桌早就看过他死了，再响一声是重复提示。
//   所以：**拥有生效的僵怖能力、而且假死已经用掉** → 这些通用的「打红叉 / 公布死亡」音效点一律跳过。
//   （中毒 / 酒鬼的僵怖没有「第一次不会死」这一条，他的死就是普通死亡 → 照常放。）
bool BOTC_DeathSfxMute (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_HasAbility(q, 43)) {
        return false;                       // 只有拥有僵怖能力才有这一条
    }
    if (!BOTC_AbilityWorks(q, 43)) {
        return false;
    }
    return g_zombUsed[q];
}

void BOTC_MarkDeadPlain (int q) {
    bool deferNightZombuul;
    int hook;
    if (q < 1 || q > 13) {
        return;
    }
    // 【退出 / 掉线不触发死亡技能】（用户 2026-11-11）：蓝叉死亡直接落地 ——
    //   不被画皮 / 赶尸人 / 僵怖 / 维齐尔这类「死亡时」能力拦下，也不触发任何角色死亡技能。
    if (!g_leftMark) {
        if (BOTC_VizierDayImmune(q)) {
            BOTC_PmStore(g_teller, "【维齐尔】" + BOTC_NameStr(q) + " 在白天不会死亡，这次红叉死亡被忽略。");
            return;
        }
        hook = BOTC_SkinDeathHook(q);
        if (hook == 1) {
            return;
        }
        if (g_liveCorpse[q]) {
            BOTC_LivingCorpseFinalize(q);
            return;
        }
        if (BOTC_CorpseFirstDeath(q)) {
            return;
        }
        // 僵怖（43）：第一次死亡不会死 ---- 「红叉死亡」也先过这一层
        if (BOTC_ZombuulFake(q)) {
            return;
        }
    }
    deferNightZombuul = !g_leftMark && g_isNight && BOTC_HasAbility(q, 43) && g_zombUsed[q];
    if (!g_leftMark) {
        BOTC_PoppyDeathMark(q);            // 罂粟种植者（86）：死亡后的邪恶互认属于死亡技能，退出不触发
    }
    // 【通用规则】他离场 → 他带来的 token 与配套记录一起收掉（用户 2026-09-20）
    // 【保留能力（亡骨魔）】（用户 2026-09-21）：带着这枚标记的爪牙死后能力还在
    //   → 不收他的 token、也不作废配套记录（离场清理整段跳过）
    if (!BOTC_KeepsAbilityAlive(q)) {
        BOTC_SourceGoneCleanup(q, true);
    }
    BOTC_PlagueDoctorDeath(q);
    g_deadKind[q] = 0;
    g_deadByDemon[q] = 0;
    g_deadType[q] = -1;                // 普通红叉死亡：不记具体死因
    g_deadNightNum[q] = 0;
    // 【第 8 批】白天标的普通死亡也算「今天有人死」（僵怖 43 / 教父 39 要用）；夜里标的算「昨夜」
    if (g_isNight) {
        g_deadDay[q] = 0;
    }
    else {
        g_deadDay[q] = g_dayNum;
        // 【退出 / 掉线 / 被踢出】（用户 2026-11-11）：这次蓝叉不算「今天有人死」，
        //   不给僵怖 / 教父打「死于今日」，避免退出反过来触发别的角色能力。
        if (!g_leftMark) {
            // 僵怖（43）的「死于今日」：说书人手动标的白天死亡也照打（用户 2026-09-20）
            if (BOTC_RoleEffInPlay(43)) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 57] = true;
            }
            // 【教父（39）的「死于今日」】（用户 2026-09-20）：白天死的是外来者才打
            // 【教父×陌客】（用户 2026-11-05）：陌客白天死亡改由说书人弹窗裁定。
            if (!BOTC_GfRecluseDayAsk(q)) {
                if (BOTC_RoleEffInPlay(39) && BOTC_SeatRegTeam(q) == 1) {
                    g_tokOn[(((g_teller * 14) + q) * 256) + 56] = true;
                }
            }
        }
    }
    if (deferNightZombuul) {
        g_deadPending[q] = true;
    }
    else {
        g_deadPending[q] = false;
        g_deadShown[q] = true;         // 红叉：公开死亡
        // 【死后声称窗口】夜里被红叉公布的死讯，只能在天亮后的那个白天声称（月之子 / 呆瓜）
        if (g_isNight) {
            g_deadClaimDay[q] = g_nightNum;
        }
        else {
            g_deadClaimDay[q] = g_dayNum;
        }
    }
    if (!BOTC_DeathSfxMute(q)) {
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
    }
    BOTC_VillageSync();            // 【村夫】村夫死亡（离场）→ 撤掉他身上的「醉酒（村夫）」；仍有 ≥2 名则改放给另一名
    BOTC_BartenderSync();          // 【酒保】非处决死亡 → 立即撤掉「醉酒（酒保）」196（用户 2026-11-11）
    BOTC_GrimRender(g_teller);                // 立刻刷一次（用户 2026-09-20）
    BOTC_DeclareRender();              // 他那一格立刻换成【死后声称】（用户 2026-09-20）
    // 【退出 / 掉线 / 被踢出】（用户 2026-11-11）：只打蓝叉，不触发任何角色死亡技能
    if (!g_leftMark) {
        BOTC_MoonChildCheck(q);            // 月之子（36）：红叉死亡也触发他的公开选择（用户 2026-09-20）
        BOTC_SweetDeath(q);               // 心上人（61）：这条路径不经过 MarkDeathRowTok（用户 2026-09-21）
        BOTC_BarberDeath(q);              // 理发师（62）：同上
        BOTC_HatDeath(q);                 // 帽匠（120）：按白天 / 夜晚死亡分流
        BOTC_KlutzCheck(q);               // 呆瓜（63）：红叉死亡 = 他知道自己死了 → 公开选人
        BOTC_LleechHostCheck(q);       // 【痢蛭】(用户 2026-10-03)：宿主一死（含红叉那条通道）-> 痢蛭同一步里也死，免得胜负先后顺序出错
    }
    BOTC_SkinSourceCheck();
}

// 【主动退出 / 掉线 / 强制退出 / 被投票踢出】统一走这里打蓝叉（用户 2026-11-11）：
//   死亡记录照常落地，但不触发该角色的任何「死亡时」能力（理发师、守鸦人、月之子、呆瓜、心上人、帽匠等）。
void BOTC_MarkDeadLeave (int q) {
    g_leftMark = true;
    BOTC_MarkDeadPlain(q);
    g_leftMark = false;
}

void BOTC_MarkDeath (int q, int kind, int byDemon, int srcRole) {
    int hook;
    if (BOTC_CorpseFirstDeath(q)) {
        return;
    }
    hook = BOTC_SkinDeathHook(q);
    if (hook == 1) {
        return;
    }
    if (g_liveCorpse[q]) {
        BOTC_LivingCorpseFinalize(q);
        return;
    }
    BOTC_MarkDeathQuietSrc(q, kind, byDemon, srcRole);
    if (q >= 2 && q <= 13) {
        g_deadShown[q] = true;
        if (!BOTC_DeathSfxMute(q)) {
            BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
        }
        g_deadPending[q] = false;
        BOTC_MoonChildCheck(q);            // 月之子（36）：死亡公开了 → 触发他的公开选择
        BOTC_KlutzCheck(q);                // 呆瓜（63）：死亡公开了 → 公开选人（用户 2026-09-21）
        BOTC_DeclareRender();              // 死亡公开了：他那一格立刻换成【死后声称】（用户 2026-09-20）
    }
}

// 只写「死亡记录」（死亡 token + 类型），不点亮公开红叉、也不马上播报 ---- 夜间死亡用它，
//   天亮时由 BOTC_DawnResolve() 统一公开（这样排在后面的角色，比如守鸦人，能先读到死亡 token）
// 按大类（kind + byDemon）找死亡类型表里的第几条；找不到就退成「同 kind 的第一条」，
//   再找不到就第一条（跟以前 BOTC_DeathTokIndex 的兜底一致）
int BOTC_DeathRowOf (int kind, int byDemon) {
    int k;
    int first;
    first = -1;
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] == kind && g_deathByDemon[k] == byDemon) {
            if (first < 0) {
                first = k;
            }
            // 优先挑「这一条 token 这一局真的会出现」的（例如 BMR 局里不会去点小恶魔那一格）
            if (!BOTC_IsHiddenTok(g_deathTok[k])) {
                return k;
            }
        }
    }
    if (first >= 0) {
        return first;
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] == kind && g_deathByDemon[k] == byDemon) {
            return k;
        }
    }
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathKind[k] == kind) {
            return k;
        }
    }
    return 0;
}

// 按 token 槽找那一条死因（找不到 = -1）
int BOTC_DeathRowByTok (int t) {
    int k;
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            return k;
        }
    }
    return -1;
}

bool BOTC_BansheeDeadPower (int q) {
    if (q < 2 || q > 13 || !g_bansheePower[q] || !BOTC_SeatDead(q)) {
        return false;
    }
    if (!BOTC_HasAbility(q, 131)) {
        return false;
    }
    return BOTC_AbilityWorks(q, 131);
}

bool BOTC_BansheeCanNominate (int q) {
    if (!BOTC_BansheeDeadPower(q)) {
        return false;
    }
    if (!g_nomUsed[q]) {
        return true;
    }
    return !g_bansheeSecondNom[q];
}

int BOTC_BansheeVoteWeight (int q) {
    if (BOTC_BansheeDeadPower(q)) {
        return 2;
    }
    return 1;
}

void BOTC_BansheeAnnounce (int q) {
    if (q < 2 || q > 13 || g_bansheeSaid[q] || !BOTC_PublicDead(q)) {
        return;
    }
    if (g_deadByDemon[q] != 1 || !BOTC_HasAbility(q, 131)) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 131)) {
        BOTC_PmStore(g_teller, "【报丧女妖】" + BOTC_NameStr(q) + " 被恶魔杀死，但能力当前失效（中毒 / 醉酒）→ 不公屏播报。");
        g_bansheeSaid[q] = true;
        return;
    }
    g_bansheePower[q] = true;
    g_bansheeSaid[q] = true;
    // 【具有能力（208）】（用户 2026-11-11）：能力生效时放在报丧女妖角色标记旁，离场前一直保留。
    g_tokOn[(((g_teller * 14) + q) * 256) + 208] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PubAnnounce("报丧女妖来索命了。");
    BOTC_PmStore(g_teller, "【报丧女妖】" + BOTC_NameStr(q) + " 被恶魔杀死并公开死亡 → 已公屏播报，并获得死亡后能力：每天最多两次提名，每次赞成票计 2 票，且不消耗死人票。");
}

// 真正的实现：row = 死亡类型表里的第几条
void BOTC_MarkDeathRow (int q, int row) {
    BOTC_MarkDeathRowTok(q, row, -1, false);
}

// tok >= 0 时用这一格（角色专属死因，例如「死亡（赌徒）」）；否则用大类那一格
void BOTC_MarkDeathRowTok (int q, int row, int tok, bool pierce) {
    int t;
    int r2;
    int hook;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_VizierDayImmune(q)) {
        BOTC_PmStore(g_teller, "【维齐尔】" + BOTC_NameStr(q) + " 在白天不会死亡，这次死亡结算被忽略。");
        return;
    }
    // 画皮必须在实际写入死亡记录之前拦截，且死因 / 红叉 / 死亡时触发都不落地。
    hook = BOTC_SkinDeathHook(q);
    if (hook == 1) {
        return;
    }
    if (g_liveCorpse[q]) {
        BOTC_LivingCorpseFinalize(q);
        return;
    }
    g_lastDeadSeat = q;           // 【最近一次死亡】（2026-10-11）
    // 僵怖（43）：第一次死亡不会死（用户 2026-09-20）---- 各条记死亡的路径都从这一个口进来
    // 【刺客那一刀穿掉这条】（用户 2026-10-14）：僵怖被刺客刀，**无论如何都会死** → pierce 时不走假死
    if (!pierce && BOTC_ZombuulFake(q)) {
        return;
    }
    // 镇长（12）：即将被打上「夜间」死亡 token → 交给说书人拍板（用户 2026-09-21）
    g_mayorHold = false;
    if (BOTC_MayorInterceptRow(q, row, tok)) {
        return;
    }
    BOTC_PoppyDeathMark(q);
    // 【记下死掉的是哪只恶魔】（用户 2026-09-21）：红唇女郎 / 传位接位的人变成同一只恶魔
    r2 = BOTC_SeatTrueRole(q);
    if (r2 >= 0 && r2 <= 163 && BOTC_RoleTeam(r2) == 3) {
        g_demonKind = r2;
    }
    // 【通用规则】他离场 → 他带来的 token 与配套记录一起收掉（用户 2026-09-20）
    // 【保留能力（亡骨魔）】（用户 2026-09-21）：带着这枚标记的爪牙死后能力还在
    //   → 不收他的 token、也不作废配套记录（离场清理整段跳过）
    if (!BOTC_KeepsAbilityAlive(q)) {
        BOTC_SourceGoneCleanup(q, true);
    }
    BOTC_PlagueDoctorDeath(q);
    if (row >= 0 && row < g_deathN && g_deathKind[row] == 1 && BOTC_HasAbility(q, 80) && !g_levJinxLost[q]) {
        g_farmPending[q] = true;
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(q) + " 夜间死亡 → 等到农夫夜序节点再选择新的农夫。");
    }
    if (row < 0 || row >= g_deathN) {
        row = 0;
    }
    if (tok < 0 || tok > 255) {
        tok = g_deathTok[row];
    }
    // 先清掉所有死亡 token（大类 + 角色专属的那批），再点亮这次对应的那一格
    for (t = 0; t < g_deathN; t += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[t]] = false;
    }
    for (t = 32; t <= 41; t += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + t] = false;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 112] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 143] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 157] = false;
    // 复活待公布的玩家如果在天亮前再次死亡，新的死亡覆盖这次复活。
    g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
    g_deadKind[q] = g_deathKind[row];
    // 【教父 39 / 僵怖 43 要用】「今天有人死」按**死亡发生的时间**算（用户 2026-09-20）：
    //   白天死的（不管说书人打的是哪种死亡 token）= 今天有人死；夜里死的 = 不算今天。
    if (g_isNight) {
        g_deadDay[q] = 0;
    }
    else {
        g_deadDay[q] = g_dayNum;
    }
    if (g_deadKind[q] == 3) {
        BOTC_WardenExecDeath(q);
    }
    g_deadByDemon[q] = g_deathByDemon[row];
    g_deadType[q] = row;
    if (g_deadKind[q] == 1) {
        g_deadNightNum[q] = g_nightNum;
    }
    else {
        g_deadNightNum[q] = 0;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + tok] = true;
    // 【唱诗男孩（108）】（用户 2026-10-10）：恶魔夜里杀死了国王 → 把「谁是恶魔」私聊给唱诗男孩
    BOTC_ChoirboyHook(q, row);
    // 被处决的人：自动打「死于今日」（送葬者问的就是今天被处决的人）---- 第二天天亮会清掉
    // 【只给在场角色打】（用户 2026-11-02）：场上没有送葬者、也没有食人族时不打，免得面板出现没人用的标记。
    if (g_deadKind[q] == 3 && (BOTC_RoleEffInPlay(6) || BOTC_RoleEffInPlay(74))) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 11] = true;
    }
    // 【食人族（74）· 饱餐】（用户 2026-11-10）：白天有人死于处决 → 饱餐标记转移到这名死者；
    //   是否已经把食人族发到场上、是否醉酒中毒都不影响，跨夜也不清（等下一次处决死亡再转移）。
    //   记录死亡天数，供夜里判断「今天是否有人死于处决」，中途被创造的食人族也能补到能力。
    if (!g_isNight && g_deadKind[q] == 3) {
        g_cannFedSeat = q;
        g_cannFedDay = g_dayNum;
        BOTC_CannSync();
    }
    // 僵怖（43）的「死于今日」：**白天死的任何人都要打**（用户 2026-09-20）----
    //   跟送葬者那个不一样：送葬者只认「今天被处决的人」，僵怖是任何类型的白天死亡都算
    if (!g_isNight && BOTC_RoleEffInPlay(43)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 57] = true;
    }
    // 教父（39）的「死于今日」：白天死的是**外来者**才打（按互动干扰算，跟 GodfatherCanKill 一致）
    // 【教父×陌客】（用户 2026-11-05）：陌客白天死亡改由说书人弹窗裁定。
    if (!g_isNight && !BOTC_GfRecluseDayAsk(q)) {
        if (BOTC_RoleEffInPlay(39) && BOTC_SeatRegTeam(q) == 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 56] = true;
        }
    }
    // 【心上人（61）/ 理发师（62）】（用户 2026-09-21）：死了就触发（不管白天夜里、哪种死因）
    BOTC_SweetDeath(q);
    BOTC_BarberDeath(q);
    g_deadPending[q] = true;
    BOTC_HatDeath(q);
    // 【立刻刷新说书人那份魔典】（用户 2026-09-20）：夜里的死亡是「先记 token、天亮才公开」，
    //   以前这里不刷，所以 token 面板里已经打上✓了、圆桌上却还是空的。
    BOTC_VillageSync();            // 【村夫】村夫死亡（离场）→ 撤掉他身上的「醉酒（村夫）」；仍有 ≥2 名则改放给另一名
    BOTC_BartenderSync();          // 【酒保】非处决死亡 → 立即撤掉「醉酒（酒保）」196（用户 2026-11-11）
    BOTC_GrimRender(g_teller);
    BOTC_SkinSourceCheck();
}

// 按大类记死亡（说书人点处决 / 死亡标记、智能说书都用它）
void BOTC_MarkDeathQuiet (int q, int kind, int byDemon) {
    BOTC_MarkDeathQuietSrc(q, kind, byDemon, -1);
}

// srcRole >= 0 且那个角色有专属死亡 token 时，打它自己那一格（用户 2026-09-20）
// 【痢蛭(100) 宿主联动】（用户 2026-10-03）：宿主（身上有「中毒（痢蛭）120」）一死 / 一离场 ->
//   先撤掉痢蛭身上的「不会死亡（痢蛭）122」（官网口径：宿主的毒移除时才失去免死），
//   再让痢蛭**立刻打红叉**（用户 2026-10-03 口径：不走恶魔刀、不等天亮）。
void BOTC_LleechHostCheck (int deadSeat) {
    int i;
    int leech;
    int mm;
    bool works;
    if (deadSeat < 2 || deadSeat > 13) {
        return;
    }
    if (!g_tokOn[(((g_teller * 14) + deadSeat) * 256) + 120]) {
        return;                       // 他不是痢蛭的宿主
    }
    leech = 0;
    for (i = 2; i <= 13; i += 1) {
        // 【相克 · 痢蛭 × 主谋】已经「失去能力」（内部记账槽 18）的痢蛭 → 不再算这条「宿主死我也死」
        works = BOTC_AbilityWorks(i, 100);
        if (!works && BOTC_HasAbility(deadSeat, 37)) {
            // 【莽夫首日被处决】（用户 2026-11-13，官方 FAQ）：莽夫一死，他给痢蛭的那份
            //   「醉酒（莽夫）」也随之消失 → 原本被它挡下的「宿主死我也死」当场照常结算。
            if (BOTC_GoonDrunkOnly(i)) {
                works = true;
            }
        }
        if (g_seatOn[i] && works && !BOTC_SeatDead(i) && !g_tokOn[(((g_teller * 14) + i) * 256) + 18]) {
            leech = i;
        }
    }
    if (leech < 2) {
        return;
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07 要求实现这条相克规则）：
    //   宿主**死于处决**、而且主谋（42）**活着且清醒** → 痢蛭**不死亡**，改为**失去能力**：
    //     · 撤掉他的「不会死亡（痢蛭）122」（宿主一死，这条免死本来就要收）；
    //     · 打上内部记账的「失去能力」18（面板 / 圆桌上都不显示这个槽）；
    //     · 之后「宿主死我也死」对他不再生效（上面的寻找循环会跳过带 18 的座位），
    //       夜里也不再唤醒他（BOTC_CanWakeAt / BOTC_WakeBlockStr），他也不能再选宿主 / 刀人。
    //   ⚠「死于处决」的口径跟主谋加时那条**完全一致**（BOTC_CheckWin 里用的也是 g_deadKind[seat] == 3）。
    if (g_deadKind[deadSeat] == 3) {
        mm = 0;
        for (i = 2; i <= 13; i += 1) {
            if (!g_seatOn[i] || !BOTC_AbilityWorks(i, 42)) {
                continue;
            }
            if (BOTC_SeatDead(i)) {
                continue;
            }
            mm = i;
        }
        if (mm >= 2) {
            g_tokOn[(((g_teller * 14) + leech) * 256) + 122] = false;      // 撤「不会死亡（痢蛭）」
            BOTC_LoseAbility(leech, 18);                                    // 打「失去能力」（内部记账槽）
            BOTC_PmStore(g_teller, "【相克 · 痢蛭 × 主谋】宿主 " + BOTC_NameStr(deadSeat) + " 死于处决，而主谋 " + BOTC_NameStr(mm) + " 还活着 → 痢蛭 " + BOTC_NameStr(leech) + " 不死亡，改为失去能力（「不会死亡」已撤掉，之后不再唤醒他）。");
            return;
        }
    }
    g_tokOn[(((g_teller * 14) + leech) * 256) + 122] = false;      // ① 先撤「不会死亡」
    BOTC_GrimRender(g_teller);
    // ② 【用户 2026-10-03】宿主一死 -> 痢蛭**立刻打红叉**（BOTC_MarkDeadPlain）：
    //    · 不再走「夜间死亡 + 算恶魔刀」那条（以前魔典上会显示成小恶魔的死亡标记）；
    //    · 红叉当场就亮 = 「确定死亡」，所以「只剩 3 人时宿主死 + 痢蛭死」这一串会在
    //      同一个调用里先把恶魔算死，BOTC_CheckWin 不会再出现「先判了邪恶胜利」的先后问题。
    BOTC_MarkDeadPlain(leech);
    BOTC_PmStore(g_teller, "【痢蛭】宿主 " + BOTC_NameStr(deadSeat) + " 已死 → 痢蛭 " + BOTC_NameStr(leech) + " 立刻死亡（红叉，已先撤掉他的「不会死亡」）。");
}

// 【痢蛭 · 恢复清醒健康后宿主已死 → 立即死亡】（用户 2026-11-13，官方规则）：
//   他中毒 / 醉酒期间宿主死亡时，BOTC_LleechHostCheck 会按规则放过他（宿主死也不受影响）；
//   等他恢复清醒 / 健康，宿主已经是一具尸体 —— 这时必须当场死亡。
//   0.5 秒 tick 每拍检查一次，保证「一恢复就结算」；带重入保护，避免打红叉时再绕回来。
void BOTC_LleechRecoverCheck () {
    int i;
    int q;
    int host;
    bool hostAlive;
    if (g_lleechRecover > 0) {
        return;
    }
    if (!g_started || g_gameOver) {
        return;
    }
    host = 0;
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 120]) {
            host = q;
        }
    }
    if (host < 2) {
        return;                            // 场上没有宿主标记（还没选过 / 已经收掉）
    }
    g_lleechRecover = 1;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (!BOTC_HasAbility(i, 100)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 18]) {
            continue;                      // 相克 · 主谋：失去能力，不再算这条
        }
        if (!BOTC_AbilityWorks(i, 100)) {
            continue;                      // 还在中毒 / 醉酒：先放过，恢复后再结算
        }
        host = 0;
        hostAlive = false;
        for (q = 2; q <= 13; q += 1) {
            if (!g_tokOn[(((g_teller * 14) + q) * 256) + 120]) {
                continue;
            }
            host = q;
            if (!BOTC_SeatDead(q)) {
                hostAlive = true;
            }
        }
        if (host < 2 || hostAlive) {
            continue;                      // 宿主还活着 / 已经没有宿主
        }
        g_tokOn[(((g_teller * 14) + i) * 256) + 122] = false;      // 先撤「不会死亡（痢蛭）」
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【痢蛭】" + BOTC_NameStr(i) + " 恢复清醒 / 健康时，宿主 " + BOTC_NameStr(host) + " 已经死亡 → 痢蛭立即死亡。");
        BOTC_MarkDeadPlain(i);
        break;                             // 宿主标记会随痢蛭离场一起收掉，这一拍只结一个
    }
    g_lleechRecover = 0;
}
void BOTC_MarkDeathQuietSrc (int q, int kind, int byDemon, int srcRole) {
    int row;
    int tok;
    string blk;
    bool pierce;
    if (BOTC_CorpseFirstDeath(q)) {
        return;
    }
    // 【带着免死 / 保护 = 不死】（用户 2026-10-06：「那个 token 跟茶艺师的免死一个口径，无论什么原因都不会死亡」）
    //   这里是"所有真的把人标死"的**总入口**（夜刀 / 各角色杀 / 处决 …… 都从这儿过），
    //   所以统一在这里问一次 `BOTC_DeathBlocker()`：
    //     僧侣保护 9 / 旅店老板 25 / 水手 26 / **痢蛭 122** / 茶艺师 / 弄臣 / 魔鬼代言人 27 / 和平主义者 28 …
    //     命中就**这一次不标死**，并往说书人私聊写一行说明。
    //   ⚠ 说书人**手动**打红叉 / 死亡标记走的是 `BOTC_MarkDeadPlain()`（另一个函数），不受这里限制；
    //     痢蛭"宿主死了就跟着死"那条链也走 `BOTC_MarkDeadPlain()`，所以不会被自己的免死挡住。
    // 【刺客（41）那一刀带「穿透」】（用户 2026-10-14 修）：原来这里写死 false ----
    //   于是日志写着「无视一切保护」，实际却被水手 / 旅店老板那些免死挡住了（用户截图报的就是这个）。
    //   口径按「死因来源角色」判：srcRole == 41 = 刺客（含炼金术士 / 哲学家 / 食人族借到的那一份）----
    //   这一份 pierce 同时交给 BOTC_MarkDeathRowTok：僵怖的假死也要被穿掉。
    pierce = (srcRole == 41);
    blk = BOTC_DeathBlocker(q, kind, byDemon, pierce);
    // 【茶艺师 × 间谍 / 陌客能力者】（用户 2026-11-12）：茶艺师是否保护由说书人裁定。
    if (blk == "不会死亡（茶艺师）" && BOTC_IsDisguiseAbility(q) && !g_teaDieOk[q]) {
        g_teaQuietSeat = q;
        g_teaQuietKind = kind;
        g_teaQuietByDemon = byDemon;
        g_teaQuietSrc = srcRole;
        BOTC_JudgeAsk(18, "【茶艺师】" + BOTC_NameStr(q) + " 是茶艺师的邻居、也是间谍 / 陌客能力者：这次是否让他死亡？", q, 0, 0);
        BOTC_PmStore(g_teller, "【茶艺师】" + BOTC_NameStr(q) + " 是间谍 / 陌客能力者 → 请选择这次死亡是否生效。");
        return;
    }
    if (blk != "" && !(g_teaDieOk[q] && blk == "不会死亡（茶艺师）")) {
        BOTC_PmStore(g_teller, "【死亡被挡】" + BOTC_NameStr(q) + " 带着【" + blk + "】→ 这一次没有死亡。");
        return;
    }
    row = BOTC_DeathRowOf(kind, byDemon);
    tok = -1;
    if (srcRole >= 0 && srcRole <= 163) {
        tok = g_roleDeathTok[srcRole];
    }
    BOTC_MarkDeathRowTok(q, row, tok, pierce);
    BOTC_LleechHostCheck(q);       // 【痢蛭】(用户 2026-10-03)：宿主死了 -> 痢蛭也跟着死
}

// 按「具体哪一条死因」记死亡 ---- 给「同一个大类里有好几种死因」的场合用（例如普卡的毒杀）
void BOTC_MarkDeathByTok (int q, int t) {
    BOTC_MarkDeathRow(q, BOTC_DeathRowByTok(t));
}

void BOTC_ClearDeath (int q) {
    int t;
    if (q < 1 || q > 13) {
        return;                           // 允许 1：说书人自己那一格
    }
    g_liveCorpse[q] = false;
    g_liveCorpseFrom[q] = 0;
    g_liveCorpseLost[q] = false;
    g_deathLearned[q] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 192] = false;
    if (g_skinTargetBy[q] >= 2) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 193] = true;
    }
    g_deadKind[q] = 0;
    g_deadByDemon[q] = 0;
    g_deadType[q] = -1;
    g_deadNightNum[q] = 0;
    g_deadClaimDay[q] = -1;
    g_deadDay[q] = 0;
    g_deadShown[q] = false;
    g_deadPending[q] = false;
    g_bansheeSaid[q] = false;
    // 僵怖（43）：复活之后他只是普通的活着，不再是「看起来死了其实活着」
    g_zombFake[q] = false;
    for (t = 0; t < g_deathN; t += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + g_deathTok[t]] = false;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 11] = false;     // 「死于今日」一起清掉
    g_tokOn[(((g_teller * 14) + q) * 256) + 57] = false;     // 「死于今日（僵怖）」也一起清掉

    // 【角色专属的死亡 token 也要清】（用户 2026-09-20）：32~41 是后来一个个加上的角色死因
    //   （造谣者 / 赌徒 / 修补匠 / 月之子 / 教父 / 刺客 / 僵怖 / 沙巴洛斯 / 珀 / 祖母·孙子），
    //   复活时以前只清了大类那 6 格，这些会残留下来。
    for (t = 32; t <= 41; t += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + t] = false;
    }
    g_tokOn[(((g_teller * 14) + q) * 256) + 112] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 143] = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 157] = false;
    // 【复活刷新「限次 / 死亡触发」的技能】（用户 2026-09-21）：这些本质上都是「死一次才能用一次」的限次技能，
    //   复活之后一律恢复：月之子 / 呆瓜 的公开选择、守鸦人 / 贤者 的死亡触发（那两位本来就是按「这一次死亡」算的），
    //   以及可声称的限次角色 ---- 猎手（10）/ 造谣者（28）/ 月之子（36）/ 杂耍艺人（58）/ 呆瓜（63）。
    //   ★【登记处 · 另一半】（用户 2026-10-14 定的规矩）：以后新增「一局一次」的角色，这里和
    //     BOTC_RestoreOneShot() 里都要登记（那边又叫「★ 登记处」，一般要清 bool 记账 + 那枚「失去能力」token）。
    g_moonDone[q] = false;
    g_moonClaimed[q] = false;          // 月之子：复活后重新获得一次声称机会
    g_moonPick[q] = 0;
    g_moonDeclare[g_who[q]] = false;
    g_moonOpen[q] = false;
    g_moonAskSt = false;
    g_moonWaitSeat = 0;
    g_moonWaitTick = 0;
    g_klutzDone[q] = false;
    g_klutzClaimed[q] = false;         // 呆瓜：复活后重新获得一次声称机会
    g_klutzPick[q] = 0;
    g_klutzDeclare[g_who[q]] = false;
    g_klutzAskSt = false;
    g_klutzWaitSeat = 0;
    g_klutzWaitTick = 0;
    g_declareUsed[g_who[q]] = false;   // 猎手：又能声称一次（这两个标记是**客户端**口径 → 要用那个人的客户端号）
    g_declarePick[g_who[q]] = false;   // 声称"选目标中"标记同上：客户端口径
    g_gossipDone[q] = false;           // 造谣者：又能公开声明
    g_juggDone[q] = false;             // 杂耍艺人：又能公开猜测
    g_juggUsed[q] = false;             // 杂耍艺人：复活后刷新，还能再得一次信息
    g_tokOn[(((g_teller * 14) + q) * 256) + 12] = false;      // 失去能力（猎手）也收掉
    BOTC_DeclareRender();              // 声称 / 死后声称 按钮跟着刷新（用户 2026-09-21）
    BOTC_SailorSync();
    BOTC_TeaLadySync();                        // 茶艺师（32）：有人复活了，重新算一次
    BOTC_VillageSync();                        // 村夫（105）：复活后重新恢复两名村夫时补回醉酒标记
}

// 死亡类型的中文（说书人私聊日志里用）
string BOTC_DeadKindStr (int q) {
    if (q < 2 || q > 13) {
        return "？";
    }
    if (g_liveCorpse[q]) {
        if (g_deadShown[q]) {
            return "活尸（已公开死亡）";
        }
        return "活尸（真实已死亡，广场仍显示存活）";
    }
    // 【牙噶巴卜】同一枚死亡 token 按打上的时段记录成恶魔白天 / 夜晚杀。
    if (g_deadType[q] == 18) {
        if (g_deadKind[q] == 2) {
            return "死亡（恶魔·白天）";
        }
        if (g_deadKind[q] == 1) {
            return "死亡（恶魔·夜晚）";
        }
    }
    if (g_deadKind[q] == 1) {
        if (g_deadByDemon[q] == 1) {
            return "夜间死亡（被恶魔击杀，第 " + IntToString(g_deadNightNum[q]) + " 夜）";
        }
        return "夜间死亡（第 " + IntToString(g_deadNightNum[q]) + " 夜）";
    }
    if (g_deadKind[q] == 2) {
        return "白天死亡";
    }
    if (g_deadKind[q] == 3) {
        return "白天被处决";
    }
    if (BOTC_SeatDead(q)) {
        return "死亡（类型未定：等说书人打死亡类型 token）";
    }
    return "活着";
}

// 死亡 / 复活的总入口：红叉和「死亡」token 一起加或去，播报"死亡"或"复活"，并记死亡类型
// 【恶魔死了】统一处理（token / 红叉都算）：先让红唇女郎顶上（活着、清醒、恶魔死后活人 ≥4），
//   没人顶就走传位（智能说书随机挑一名爪牙 / 手动说书弹传位面板让人点）。
//   返回 true = 已经有人接位（这局继续，调用方不要再判胜负）；
//   false = 场上还有活着的恶魔，或者没人能接（调用方按胜负条件判：没有恶魔 → 善良胜）。
//   ⚠ 手动说书弹面板时也算 true（等说书人点人，先不判胜负）。
bool BOTC_DemonGoneCheck () {
    int i;
    int q;
    int r;
    int demonSeat;
    if (g_gameOver || !g_started) {
        return false;
    }
    // 场上还有活着的恶魔？有就什么都不用做（顺便记下「已经死掉的恶魔」是哪个座位）
    demonSeat = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
            if (!BOTC_SeatDead(q)) {
                return false;
            }
            demonSeat = q;
        }
    }
    // 【手动记死亡也要记下死的是哪只恶魔】（用户 2026-11-09）：说书人在 token 面板给奥赫打
    //   「死亡（造谣者）」这类角色专属死因时只走 BOTC_SyncDeathFromTok，不经过
    //   BOTC_MarkDeathRowTok，g_demonKind 还停在新局默认的小恶魔（21）----
    //   红唇女郎接位就会错误变成小恶魔。这里按实际死掉的那一格补记。
    if (demonSeat >= 2) {
        r = BOTC_SeatTrueRole(demonSeat);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
            g_demonKind = r;
        }
    }
    // 小恶魔是被「死亡（小恶魔）」那一格记死的（自己刀的）：**先看红唇女郎** ----
    //   她在、活着、没中毒酒鬼、恶魔死后活人 ≥4 → 必须是她顶上（规则如此，不给说书人挑）；
    //   没有她才走传位（说书人挑一名活着的爪牙，智能说书随机挑）。
    if (demonSeat >= 2) {
        // 【只认小恶魔那一刀】（用户 2026-09-19）：以前写的是「kind == 1 && byDemon == 1」，
        //   那样普卡的毒杀（同属 死亡[夜间/恶魔]）也会弹传位面板 ---- 现在改成查 g_deathImp：
        //   只有打着「死亡（小恶魔）」那一条 token 死的，才走传位。
        if (g_deadType[demonSeat] >= 0 && g_deadType[demonSeat] < g_deathN && g_deathImp[g_deadType[demonSeat]] == 1) {
            // 自刀：场上只要有「能顶」的红唇女郎（活着 / 没中毒酒鬼 / 恶魔死后活人 ≥4）
            //   就必须是她顶上，不给说书人挑（用户 2026-09-19 改）；没有她才走传位
            if (BOTC_ScarletCheck()) {
                return true;
            }
            return BOTC_ImpPromote();
        }
    }
    if (BOTC_ScarletCheck()) {
        return true;                   // 红唇女郎顶上
    }
    // 别的死法（被处决 / 被猎手打 / 红叉标的普通死亡）：**不走传位** ----
    //   传位只给「小恶魔自刀」（死亡（夜间/恶魔）那条），这样白天用别的方式杀死小恶魔
    //   不会莫名其妙弹出传位面板。没人接位就交给调用方判胜负（没有活着的恶魔 → 善良胜）。
    return false;
}

void BOTC_DeathToggle (int q, int kind, int byDemon, int srcRole) {
    int ob;
    int hook;
    bool demonHandled;
    bool deferNightZombuul;
    if (q < 1 || q > 13) {
        return;
    }
    if (q >= 2 && !g_seatOn[q]) {
        return;
    }
    // 【已经退出的玩家】：座位还在，但死亡 / 复活标记都无效（用户 2026-11-03）
    if (q >= 2 && g_leftKeepP[g_who[q]]) {
        BOTC_PmStore(g_teller, "【死亡标记】" + BOTC_NameStr(q) + " 已经退出游戏，标记无效。");
        return;
    }
    if (BOTC_VizierDayImmune(q)) {
        BOTC_PmStore(g_teller, "【维齐尔】" + BOTC_NameStr(q) + " 在白天不会死亡，这次死亡被忽略。");
        return;
    }
    if (!BOTC_PublicDead(q)) {
        hook = BOTC_SkinDeathHook(q);
        if (hook == 1) {
            BOTC_GrimRender(g_teller);
            if (!BOTC_PublicDead(q)) {
                BOTC_Notice(g_teller, "【画皮】这次死亡已经被阻止；选择关系已处理，不会补红叉或死亡播报。");
            }
            return;
        }
        if (g_liveCorpse[q]) {
            BOTC_LivingCorpseFinalize(q);
            BOTC_GrimRender(g_teller);
            return;
        }
    }
    if (BOTC_PublicDead(q) && !g_zombFake[q]) {
        // 复活：死亡 token / 红叉去掉；如果他是被处决的，今天的处决名额也还回来
        //   （僵怖那种「看起来死了其实活着」的座位不走这里：再点一次是记真死，见下面 BOTC_MarkDeadPlain）
        BOTC_ClearDeath(q);
        BOTC_PlaySfx("fuhuo");     // 【手动复活也响】（用户 2026-09-22）：说书人撤红叉 / 教授 / 沙巴洛斯 都会走到这里
        BOTC_RestoreOneShot(q);       // 复活 = 重新进场：一次性能力 + 首夜重算（用户 2026-09-20）
        if (g_exec[q]) {
            g_exec[q] = false;
            g_execUsedToday = false;
        }
        for (ob = 1; ob <= 13; ob += 1) {
            BOTC_GrimRender(ob);
        }
        // 复活也要上公屏（聊天窗 + 公聊记录 + 字幕都由 BOTC_PubAnnounce 一次搞定）
        BOTC_PubAnnounce("【复活】" + BOTC_NameStr(q) + " 复活");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 复活 ----");
        BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + " 复活，类型清空。");
        return;
    }
    if (BOTC_SeatDead(q)) {
        if (g_liveCorpse[q]) {
            BOTC_LivingCorpseFinalize(q);
            return;
        }
        // 他早就在 token 里记过死亡了（说书人的内部记录 / 技能检测用）：
        //   这次只是把「公开死亡」点亮给全桌看红叉，保留原来记的死因，不当作复活、也不改类型
        g_deadShown[q] = true;
        if (!BOTC_DeathSfxMute(q)) {
            BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
        }
        BOTC_PmStore(g_teller, "【死亡标记】" + BOTC_NameStr(q) + " 之前已经记过死亡（" + BOTC_DeadKindStr(q) + "），这次只把红叉公开给全桌。");
    }
    else {
        if (kind == 0) {
            BOTC_MarkDeadPlain(q);         // 红叉：单纯死亡，不带类型 / 不写 token
            // 【农夫改在「打上死亡 token」那一步触发】（用户 2026-09-26）：红叉这条路不再触发
        }
        else {
            BOTC_MarkDeath(q, kind, byDemon, srcRole);   // 有明确死因（处决 / 猎手 / 贞洁者...）：照旧记类型
        }
    }
    deferNightZombuul = g_isNight && BOTC_HasAbility(q, 43) && g_deadPending[q];
    // 恶魔死了（不论死因）：红唇女郎先顶上，没人顶就走传位（智能随机 / 手动弹面板）
    demonHandled = BOTC_DemonGoneCheck();
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 僵怖夜间死亡统一等天亮公开；其它手动死亡仍当场播报。
    if (!deferNightZombuul) {
        BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
        BOTC_BansheeAnnounce(q);
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
    }
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    // 圣徒：被处决 → 他的阵营落败（中毒 / 酒鬼时失效）
    if (g_deadKind[q] == 3) {
        if (BOTC_HasAbility(q, 16)) {
            if (BOTC_AbilityWorks(q, 16)) {
            BOTC_ShowWin(1 - BOTC_SeatAlign(q), "神之使徒" + BOTC_NameStr(q) + "被凡人亲手送上了绞刑架，", "神再也不会眷顾这片土地。");
                return;
            }
            BOTC_PmStore(g_teller, "【圣徒】" + BOTC_NameStr(q) + " 被处决，但他中毒/酒鬼，特殊胜利不触发。");
        }
    }
    if (!demonHandled) {
        BOTC_CheckWin();               // 没人接位才判胜负（没有活着的恶魔 → 善良胜）
    }
}

// 【死亡标记】点座位：按当前昼夜自动判类型（夜里=夜间死亡，白天=白天死亡）
void BOTC_DeadToggleAt (int q) {
    g_deadPick = false;
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    BOTC_BigHintHide(g_teller);       // 顺手收掉长驻提示
    // 【普通死亡】红叉只标记「他死了」：不带死亡类型（kind = 0 = 未定），
    //   死亡类型的 token（夜间/恶魔、处决...）由说书人在 token 面板手动打
    BOTC_DeathToggle(q, 0, 0, -1);
}

// 随机配板收尾：占卜师在场时自动挑一个干扰项
//   规则：善良的镇民或外来者，排除陌客和他自己；结果打在说书人那份的「干扰项（占卜师）」token 上
//   【2026-09-16】挑人改成**按权重**（跟「假干扰项」共用 BOTC_FtFakeWeight）：优先落在
//   「重要又难自证」的角色身上（共情者 / 守鸦人 / 士兵 / 镇长 = 12 最高，首夜信息位 = 1 最低，
//   其余 = 4），不再是一人一票的纯随机。自动发牌与智能说书走的就是这里。
void BOTC_PickRedHerring () {
    int i;
    int q;
    int ft;
    int n;
    int pick;
    int r;
    int w;
    int wsum;
    int roll;
    if (g_herringLock) {
        return;   // 智能说书开局之后干扰项就锁定了
    }
    ft = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        // 占卜师存的是 6；「以为自己是占卜师」的酒鬼（8）/ 提线木偶（118）不算
        if (g_mark[(g_teller * 14) + q] == 6 && !g_tokOn[(((g_teller * 14) + q) * 256) + 8] && !g_tokOn[(((g_teller * 14) + q) * 256) + 118]) {
            ft = q;
        }
    }
    if (ft == 0) {
        return;
    }
    n = 0;
    wsum = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ft) {
            continue;
        }
        // 善良的镇民或外来者（按真实身份算，酒鬼算外来者），排除陌客（15）
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r != 15 && (BOTC_RoleTeam(r) == 0 || BOTC_RoleTeam(r) == 1)) {
            g_redCand[n] = q;
            // 权重按「魔典上写的身份」算（跟假干扰项口径一致；酒鬼按他以为的身份）
            w = BOTC_FtFakeWeight(g_mark[(g_teller * 14) + q] - 1);
            if (w <= 0) {
                w = 1;                 // 保底：至少算 1 份，别让这种座位彻底抽不到
            }
            g_redW[n] = w;
            wsum = wsum + w;
            n = n + 1;
        }
    }
    if (n == 0) {
        return;
    }
    pick = g_redCand[RandomInt(0, n - 1)];      // 兜底值（权重异常时就用这个）
    if (wsum > 0) {
        roll = RandomInt(1, wsum);
        for (i = 0; i < n; i += 1) {
            roll = roll - g_redW[i];
            if (roll <= 0) {
                pick = g_redCand[i];
                break;
            }
        }
    }
    g_tokOn[(((g_teller * 14) + pick) * 256) + 6] = true;
    g_herring = pick;   // 占卜师验到他 = 验到恶魔
    BOTC_Notice(g_teller, "占卜师（" + BOTC_NameStr(ft) + "）的干扰项已自动指定：" + BOTC_NameStr(pick) + "。");
}

//==================================================================================================
// 身份分类：真实身份 / 阵营 / 善良邪恶，以及「登记」（别人和技能看到的样子）
//   阵营 g_roleTeam：0=镇民 1=外来者 2=爪牙 3=恶魔
//   善恶 g_roleAlign：0=善良 1=邪恶
//   酒鬼在魔典上放的是他「以为自己是」的镇民，真实身份靠「是酒鬼」token（索引 8）判断
//==================================================================================================
int BOTC_RoleTeam (int idx) {
    if (idx < 0 || idx > 163) {
        return -1;
    }
    return g_roleTeam[idx];
}

int BOTC_RoleAlign (int idx) {
    if (idx < 0 || idx > 163) {
        return -1;
    }
    return g_roleAlign[idx];
}

// 【身份转变用身份名】：只有阵营真的改变才显示「善良/邪恶的X」。
string BOTC_TransitionRoleName (int oldAlign, int newAlign, int role) {
    if (role < 0 || role > 163) {
        return "未知";
    }
    if (oldAlign == newAlign) {
        return g_roleName[role];
    }
    return BOTC_AlignName(newAlign) + "的" + g_roleName[role];
}

string BOTC_TeamName (int t) {
    if (t == 0) {
        return "镇民";
    }
    if (t == 1) {
        return "外来者";
    }
    if (t == 2) {
        return "爪牙";
    }
    if (t == 3) {
        return "恶魔";
    }
    if (t == 4) {
        return "传奇角色";
    }
    if (t == 5) {
        return "奇遇角色";
    }
    return "未知";
}

string BOTC_AlignName (int a) {
    if (a == 0) {
        return "善良";
    }
    if (a == 1) {
        return "邪恶";
    }
    return "未知";
}

// 组合标签，比如「爪牙邪恶」；没身份返回「未定」
string BOTC_RoleTagStr (int idx) {
    if (idx < 0 || idx > 163) {
        return "未定";
    }
    return BOTC_TeamName(g_roleTeam[idx]) + "·" + BOTC_AlignName(g_roleAlign[idx]);
}

// 某个座位的真实身份（-1 = 这个座位没身份）
int BOTC_SeatTrueRole (int q) {
    if (q < 1 || q > 13) {
        return -1;                        // 允许 1：说书人自己那一格（-t 试技能用）
    }
    if (g_mark[(g_teller * 14) + q] <= 0) {
        return -1;
    }
    // 【是提线木偶(118) 排最前】（用户 2026-10-13）：这枚 token 只有开局照板子发牌时会打（+说书人的换座位工具），
    //   之后没有任何能力会再获得它 → 身上有 118 的人一定是提线木偶。
    //   他以为自己有那个能力（魔典上可能被写成哲学家 / 炼金术士那类），真身必须读回提线木偶(93)。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 118]) {
        return 93;
    }
    // 【是酒鬼(8) 排其次】（用户 2026-10-13）：「是酒鬼」只可能是真酒鬼 ----
    //   真酒鬼的魔典上写的是他「以为自己是」的那个身份；他要是以为自己是哲学家 / 炼金术士，
    //   就会被顺手打上 70 / 123 那一层「借能力」标记。先把 8 认掉，他的真身才不会被读成「哲学家」。
    //   （哲学家借到酒鬼能力的那一份**不打 8**：只给他打「醉酒」24，见 BOTC_PhiloBelieve。）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 8]) {
        return 14;                                // 是酒鬼（14）
    }
    // 【是悟道者(140)】（用户 2026-10-16）：他以为自己是一个外来者，实际上是个镇民 → 真身读回 118
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 140]) {
        return 118;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return 56;                                // 是哲学家（56）：他只是「获得」别人的能力，本人还是哲学家（用户 2026-09-21）
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97]) {
        return 74;                                // 是食人族（74）
    }
    // 【是炼金术士(123)】（用户 2026-10-03 / 2026-11-10）：真身判成炼金术士(95) → 算善良（除非身上有「邪恶」token）；
    //   说书人真值行的角色标记显示借到的那只爪牙，借到的能力由 g_alcBorrow 记账。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 123]) {
        return 95;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 49]) {
        return 38;                                // 是疯子（38）：魔典上写的是他「以为自己是」的恶魔
    }
    // 【是恶魔（小怪宝）】（用户 2026-10-10）：谁在照看他，谁的真身就算小怪宝（恶魔）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 134]) {
        return 112;
    }
    return g_mark[(g_teller * 14) + q] - 1;
}

// 【变脸师（117）临时改写的角色不算真身在场】（用户 2026-11-13）：
//   变脸师夜里把说书人真值行的角色标记临时改成借到的角色，并打上「是变脸师」205，
//   g_faceBase 备份着原来的标记值（角色索引 + 1）。判断「这个角色在不在场」时必须还原成
//   变脸师本人，否则他借来的那张牌会被误当成真的在场（哲学家选角、麻脸巫婆 / 舞蛇人的
//   在场判定都会受影响）。其余身份仍直接走 BOTC_SeatTrueRole。
int BOTC_SeatRealRole (int q) {
    if (q >= 2 && q <= 13) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 205] && g_faceBase[q] > 0) {
            return g_faceBase[q] - 1;
        }
    }
    return BOTC_SeatTrueRole(q);
}

// 【无神论者（83）可以被醉酒/中毒】（用户 2026-11-12 改回）：
//   无神论者一旦中毒 / 醉酒，他的能力不再生效，场上又没有恶魔 → 善良直接获胜。
//   这是官网口径（侍臣 / 旅店老板 / 吟游诗人 / 解谜大师 / 水手 / 心上人等正常对其生效）。
int BOTC_SeatTeam (int q) {
    return BOTC_RoleTeam(BOTC_SeatTrueRole(q));
}
// 【他到底有没有 X 这个能力】（用户 2026-10-03）：
//   · 真身就是它；
//   · 哲学家(70) 借的（g_philoRole）；
//   · 食人族(97) 吃的（g_cannRole）；
//   · 炼金术士(95，token 123) 借的（g_alcBorrow）。
//   · 科学怪人 / 说书人【赋予能力】附加的；
//   【2026-10-13 起这一条就是「能力」的统一口径】（用户报「炼金借红唇顶不上恶魔」之后全脚本清了一遍）：
//     「他有没有 X 这个能力」的地方一律用这个函数（原来写 `BOTC_SeatTrueRole(q) == X` 的地方全换成它）----
//     它**正好排除**酒鬼(14) / 提线木偶(93)（他们以为自己有能力，但能力其实不生效），
//     又**包含**炼金 / 哲学家 / 食人族 借来的能力。
//     而「他以为自己是 X → 该给他弹 X 的面板 / 走 X 的流程」那种地方要用**魔典上写的身份**（g_mark）。
//   中毒/醉酒**不影响**这个判定本身（有没有能力是事实），要不要生效由调用方自己再判 BOTC_SeatImpaired。
bool BOTC_HasAbility (int q, int role) {
    int tr;
    if (q < 1 || q > 13 || role < 0 || role > 163) {
        return false;
    }
    // 【灵言师（85）】（用户 2026-11-11）：关键词已被说出后打「失去能力」，本局不再有该能力。
    if (role == 85 && g_tokOn[(((g_teller * 14) + q) * 256) + 104]) {
        return false;
    }
    if (q == 1 && g_pdRole == role + 1) {
        return true;                       // 瘟疫医生给予说书人的能力
    }
    tr = BOTC_SeatTrueRole(q);
    if (tr == role) {
        return true;
    }
    // 【科学怪人（132）】能力挂在本局的那名恶魔身上；来源失效时这里自动返回 false
    if (BOTC_BoffinActiveFor(q, role)) {
        return true;
    }
    if (g_grantRoleBy[q] == role + 1) {
        return true;
    }
    // 【酒鬼(14) / 提线木偶(93) / 悟道者(118) 借不到能力】（用户 2026-10-13 / 2026-10-16）：他们以为自己有那个能力，其实没有 ----
    //   真身是这几位的话，身上那几枚「借能力」标记（是哲学家 70 / 是食人族 97 / 是炼金术士 123）一律不算。
    if (tr == 14 || tr == 93 || tr == 118) {
        return false;
    }
    if (BOTC_BoffinNestedHasRole(q, role)) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        if (g_philoRole == role) {
            return true;
        }
        // 【借用记录自愈】（用户 2026-10-26）：哲学家的魔典身份就是他选中的
        //   善良能力。若旧全局记录被其它身份变化清掉，只要真身仍读作哲学家，
        //   就按魔典上显示的角色恢复该能力（酒鬼 / 疯子 / 悟道者除外）。
        if (g_philoRole <= 0 && tr == 56 && role != 14 && role != 38 && role != 118 && g_mark[(g_teller * 14) + q] - 1 == role) {
            return true;
        }
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 97] && g_cannRole == role) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 123] && g_alcBorrow == role) {
        // 【炼金术士 × 间谍/寡妇相克】（用户 2026-11-06）：炼金术士不会拥有这两个能力，
        //   本应获得时改为该角色一定在场。
        if (role == 18 || role == 75) {
            return false;
        }
        return true;
    }
    return false;
}

// 【真身阵营】（用户 2026-09-20）：除了身份本身，还要看「善良(14) / 邪恶(15)」token ----
//   莽夫被选中转阵营时就是这样：他身上带了「邪恶」token，于是**真身也算邪恶的外来者**，
//   所有按真身看阵营的地方（共情者名额、沙巴洛斯反刍优先级、判胜负...）都跟着变。
int BOTC_SeatAlign (int q) {
    if (q < 1 || q > 13) {
        return 0;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 15]) {
        return 1;                              // 邪恶 token：真身也算邪恶
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 14]) {
        return 0;                              // 善良 token：真身也算善良
    }
    return BOTC_RoleAlign(BOTC_SeatTrueRole(q));
}

// 【圣洁之魂（89）】（用户 2026-11-08）：传奇角色。本局带它时，游戏过程中全场邪恶玩家
//   总数（无论生死）最多只能比开局设置多一名；名额用完后，任何玩家都不能再加入邪恶阵营，
//   说书人手动打「邪恶(15)」token 也一并拦下。
//   「开局设置」= 游戏正式开始时记录的 g_startEvilN（标准爪牙 + 恶魔数），
//   准备阶段的说书人手动调整不计入限制，正式开始后才开始约束。
int BOTC_EvilTotalAll () {
    int q;
    int n;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 2) {
            continue;
        }
        if (BOTC_SeatAlign(q) == 1) {
            n = n + 1;
        }
    }
    return n;
}

bool BOTC_HolySoulOn () {
    return g_legacyOn[89];
}

// q 即将从善良转为邪恶：圣洁之魂在场且名额已满 → 返回真（调用方应让 q 保持善良）。
bool BOTC_HolySoulBlocks (int q) {
    if (!g_started || !BOTC_HolySoulOn()) {
        return false;
    }
    if (q < 2 || q > 13 || g_who[q] < 2) {
        return false;
    }
    if (BOTC_SeatAlign(q) == 1) {
        return false;                     // 本来就已经是邪恶：不算新增
    }
    return BOTC_EvilTotalAll() >= g_startEvilN + 1;
}

// 【圣洁之魂（89）· 「禁止邪恶」提示标记】（用户 2026-11-11）：
//   放置：场上邪恶玩家数量达到「开局设置 + 1」或更多（g_startEvilN + 1）。
//   位置：圣洁之魂是传奇角色、没有座位，按用户要求就当作给说书人放 token，记在说书人格（格 1）上。
//   移除：标记放置后，有邪恶玩家转回善良阵营（人数回落到开局设置及以下）。
//   状态没变时不写任何东西，由 BOTC_Tick_Func 里的 0.5 秒 tick 调用。
void BOTC_HolySoulMarkSync () {
    bool was;
    int n;
    was = g_tokOn[(((g_teller * 14) + 1) * 256) + 107];
    if (!g_started || !BOTC_HolySoulOn()) {
        if (was) {
            g_tokOn[(((g_teller * 14) + 1) * 256) + 107] = false;
            if (g_started) {
                BOTC_PmStore(g_teller, "【圣洁之魂】已不在场，「禁止邪恶」标记移除。");
            }
        }
        return;
    }
    n = BOTC_EvilTotalAll();
    if (was) {
        if (n <= g_startEvilN) {
            g_tokOn[(((g_teller * 14) + 1) * 256) + 107] = false;
            BOTC_PmStore(g_teller, "【圣洁之魂】有邪恶玩家转为善良，「禁止邪恶」标记移除。");
        }
        return;
    }
    if (n >= g_startEvilN + 1) {
        g_tokOn[(((g_teller * 14) + 1) * 256) + 107] = true;
        BOTC_PmStore(g_teller, "【圣洁之魂】场上邪恶玩家已比开局多一名或更多，已打上「禁止邪恶」。");
    }
}

// 【玩家自己以为的阵营】（用户 2026-11-06）：身份转变提示只在他「认知层面」真的变了时才发。
//   酒鬼(14) / 疯子(38) / 提线木偶(93) / 悟道者(118) 按魔典上「他以为自己是」的身份算阵营：
//     疯子以为自己是恶魔 → 邪恶；提线木偶以为自己是镇民 → 善良；酒鬼 / 悟道者本来就善良。
//   麻脸巫婆造出来的认知外壳会被「善良(14)/邪恶(15)」钉住（她的能力只改角色、不改阵营），
//     这时按实际阵营算，所以「提线木偶 → 酒鬼占卜师」认知里仍然是邪恶。
int BOTC_PerceivedAlign (int q) {
    int tr;
    int mk;
    if (q < 2 || q > 13) {
        return 0;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 14] || g_tokOn[(((g_teller * 14) + q) * 256) + 15]) {
        return BOTC_SeatAlign(q);
    }
    tr = BOTC_SeatTrueRole(q);
    if (tr == 14 || tr == 38 || tr == 93 || tr == 118) {
        mk = g_mark[(g_teller * 14) + q] - 1;
        if (mk >= 0 && mk <= 163) {
            return BOTC_RoleAlign(mk);
        }
    }
    return BOTC_SeatAlign(q);
}

// 【判胜负用的阵营】（用户 2026-09-20）：**默认**按身份自带的阵营 ---- 镇民 / 外来者 = 善良，爪牙 / 恶魔 = 邪恶；
//   但一旦这个座位被打上「善良(14)」或「邪恶(15)」token，判胜负时就按那个 token 算（莽夫转阵营就是靠它）。
int BOTC_WinAlignOf (int q) {
    return BOTC_SeatAlign(q);      // BOTC_SeatAlign 自己就会读「善良 / 邪恶」token
}

// 这个角色的「伪装登记」选项（空字符串 = 没有伪装）
//   间谍：真身爪牙邪恶，但可能被看成镇民或外来者善良
//   陌客：真身外来者善良，但可能被看成爪牙或恶魔邪恶
string BOTC_RoleDisguiseStr (int idx) {
    if (idx == 18) {
        return "镇民/外来者善良";
    }
    if (idx == 15) {
        return "爪牙/恶魔邪恶";
    }
    return "";
}

// 【登记层缓存作废】（用户 2026-09-20）：某个座位的真身 / 钦定登记一变，
//   所有观察者对他那一条缓存都要重掷 ---- 不然改完阵营，技能还照旧按老的算。
void BOTC_PairClearSeat (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    for (ob = 1; ob <= 13; ob += 1) {
        g_pairRole[(ob * 14) + q] = -2;
    }
}

// 登记覆盖：-1 表示跟真实一致。说书人或技能想「钦定」结果时直接写这里，
// 写进去就压过概率掷骰（要做一次性的判定，判定完记得 BOTC_SetReg(q, -1, -1) 还原）。
void BOTC_SetReg (int q, int team, int align) {
    if (q < 2 || q > 13) {
        return;
    }
    // 【科学怪人 × 异教领袖 / 莽夫】：借用这两种能力也不能把恶魔改成善良。
    if (align == 0 && BOTC_BoffinMustStayEvil(q)) {
        align = 1;
        BOTC_PmStore(g_teller, "【科学怪人相克】" + BOTC_NameStr(q) + " 是恶魔，不能因为借来的异教领袖 / 莽夫能力转为善良阵营，保留邪恶。");
    }
    g_regTeam[q] = team;
    g_regAlign[q] = align;
    BOTC_PairClearSeat(q);         // 钦定登记改了 → 缓存作废（用户 2026-09-20）
}

// 兼容旧调用：判定不再按「一次技能」清空，而是按「观察者 × 对象」固定下来，所以这里是空的
void BOTC_BeginCheck () {
}

// 【哲学家借到酒鬼能力的那一格】（用户 2026-10-13）：token 70（是哲学家）+ 他选的是酒鬼(14) ----
//   他本人就是「酒鬼」→ 给他打的「醉酒」24 是他**自己的身份**，不是「一次醉酒」
//   （旅店老板 / 水手 / 吟游诗人那种一个昼夜就到期的），所以下面三处清理都要放过它。
bool BOTC_PhiloDrunkSelf (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
        return false;
    }
    return (g_philoRole == 14);
}

// 【这一次技能到底生不生效】（用户 2026-10-13）：中毒 / 酒鬼 / 醉酒都走 BOTC_SeatImpaired ----
//   （酒鬼的真身是 14，本来就算醉酒）；**再加一条提线木偶**：提线木偶(93) 以为自己有能力，
//   其实是个没有能力的爪牙 → 他的技能一律不生效（面板照弹、流程照走，只是效果没有）。
//   注意：说书人手动填数字那种「钦定面板」不走这里（那是说书人自己拍板）。
bool BOTC_SkillWorks (int q) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (g_liveCorpse[q]) {
        return false;
    }
    // 【疯子·假能力】（用户 2026-11-10）：科学怪人发给疯子的那份假能力按中毒 / 醉酒处理 ----
    //   面板照常打开、说书人照常给信息、流程照走，但这一次的效果不生效。
    if (g_lunFakeAct[q]) {
        return false;
    }
    // 科学怪人给恶魔的能力：只看科学怪人是否存活且清醒健康，恶魔自身中毒不影响
    if (g_boffinActing[q]) {
        return BOTC_BoffinWorksAt(g_boffinActingSource[q]);
    }
    if (g_bnestActing[q]) {
        return BOTC_BoffinNestedWorksAt(g_bnestSource[q], q);
    }
    if (g_grantActing[q]) {
        return (!g_grantDrunkBy[q] && !BOTC_SeatImpaired(q));
    }
    if (BOTC_IsMarionette(q)) {
        return false;
    }
    return !BOTC_SeatImpaired(q);
}

// 这个座位现在是不是酒鬼 / 中毒（中毒 = 说书人那份魔典上打了「中毒」token，索引 7）
// 这个座位现在算不算「醉酒」：真身是酒鬼(14) **或** 带着醉酒 token(24)
//   （用户 2026-09-19：醉酒 token 照搬中毒那一套，二者没有本质区别）
bool BOTC_SeatIsDrunkRaw (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    if (BOTC_SeatRealRole(q) == 14) {
        return true;                      // 【变脸师】临时显示的「酒鬼」不算真身（用户 2026-11-13）
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 24]) {
        return true;
    }
    // 侍臣（29）的三个月长醉酒：醉酒1 / 2 / 3 都算醉酒（用户 2026-09-20）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 53] || g_tokOn[(((g_teller * 14) + q) * 256) + 54] || g_tokOn[(((g_teller * 14) + q) * 256) + 55]) {
        return true;
    }
    // 【各角色专属的「醉酒」token】（用户 2026-09-20）：水手 59 / 旅店老板 60 / 莽夫 61 / 吟游诗人 62
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 59] || g_tokOn[(((g_teller * 14) + q) * 256) + 60] || g_tokOn[(((g_teller * 14) + q) * 256) + 61] || g_tokOn[(((g_teller * 14) + q) * 256) + 62]) {
        return true;
    }
    // 【何方教众（板子 9）那两枚「醉酒」】（用户 2026-10-11 修传教士不认醉酒）：村夫 126 / 解谜大师 129。
    //   这两枚原来只被各自角色的逻辑读写，没接进「醉酒」判定 ---- 被它们标记的人能力照样生效（传教士就是这么漏的）。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 126] || g_tokOn[(((g_teller * 14) + q) * 256) + 129]) {
        return true;
    }
    // 【风雅集（板子 10）】（用户 2026-10-16）：店小二让其中一位一直醉着（136）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 136]) {
        return true;
    }
    // 【赎罪小镇】道士醉酒到黎明 / 鸩造成的醉酒。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 142] || g_tokOn[(((g_teller * 14) + q) * 256) + 144]) {
        return true;
    }
    // 街头风琴手自己选择的醉酒，持续到下一个黄昏。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 164]) {
        return true;
    }
    // 【心上人（61）82 / 酒保（160）196】（用户 2026-11-13）：这两份醉酒以前只写进了
    //   BOTC_SeatIsDrunk，没进这里的「raw」判定，导致哲学家被它们弄醉时
    //   BOTC_SeatImpairedRaw 仍认为他清醒 → 持续检测不会收掉「醉酒（哲学家）」90。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 82] || g_tokOn[(((g_teller * 14) + q) * 256) + 196]) {
        return true;
    }
    return false;
}

// 这个座位现在算不算「醉酒」：真身是酒鬼(14) **或** 带着醉酒 token(24)
//   （用户 2026-09-19：醉酒 token 照搬中毒那一套，二者没有本质区别）
bool BOTC_SeatIsDrunk (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    if (BOTC_SeatIsDrunkRaw(q)) {
        return true;
    }
    // 【哲学家（56）让人醉的那一份】（用户 2026-09-21）：也算醉酒，他的能力真的会失效
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 90]) {
        return true;
    }
    // 哲学家活着、清醒、已经选过角色 → 他选的那个角色真正的持有者一定醉酒
    //   （token 还没同步过来也算，用户 2026-09-21）
    if (q == BOTC_PhiloDrunkSeat()) {
        return true;
    }
    // 【心上人（61）】（用户 2026-09-23）：他死时指定的那个人「从今以后一直醉酒」----
    //   这一格（82「醉酒（心上人）」）必须算进醉酒状态里，否则醉酒的人能力照旧生效
    //   （本次报的「醉酒方古照样刀人」就是漏了这一条：只打了 token、没接进这个函数）。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 82]) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 196]) {
        return true;
    }
    return false;
}

// 【保护 / 免死类】某个座位身上带着哪个保护 token（t = token 槽）
bool BOTC_ProtectTokOn (int q, int t) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    return g_tokOn[(((g_teller * 14) + q) * 256) + t];
}

// 【这次死亡会不会被挡住】返回空字符串 = 没被挡；否则返回「是谁挡的」（给说书人看的说明）
//   判定顺序（用户 2026-09-19）：① 来源保护 → ② 无条件免死 → ③ 处决免死 → ④ 穿透（刺客无视以上一切）
//   kind / byDemon 就是死亡类型表里的那两个大类字段；ignoreProtect = 这次死亡带「穿透」
string BOTC_DeathBlocker (int q, int kind, int byDemon, bool ignoreProtect) {
    if (q < 2 || q > 13) {
        return "";
    }
    // 维齐尔在白天不会因为任何原因死亡（刺客的夜间穿透不影响这条保护）。
    if (BOTC_VizierDayImmune(q)) {
        return "白天不会死亡（维齐尔）";
    }
    // 【通用 token 176 · 无敌】（用户 2026-11-03）：夜间 / 白天任何死因都不死，说书人手动备用。
    //   放在穿透判断之前，刺客的夜间穿透也不能越过它。
    if (BOTC_ProtectTokOn(q, 176)) {
        return "无敌";
    }
    if (ignoreProtect) {
        return "";                         // 穿透（刺客那一刀）：无视一切保护 / 免死
    }
    // ① 来源保护：僧侣只免疫「恶魔」造成的死亡（教父 / 刺客 / 其他来源都挡不住）
    if (byDemon == 1 && BOTC_ProtectTokOn(q, 9)) {
        return "保护（僧侣）";
    }
    // ② 无条件免死
    if (BOTC_ProtectTokOn(q, 25)) {
        return "不会死亡（旅店老板）";
    }
    if (BOTC_ProtectTokOn(q, 26)) {
        return "不会死亡（水手）";
    }
    // 【痢蛭(100)】（用户 2026-10-03 加；2026-10-06 改成现算）：宿主活着的时候他不会死（跟水手同一条通道）
    if (BOTC_LleechImmune(q)) {
        return "不会死亡（痢蛭）";
    }
    // 水手（23）：有「水手」这个能力（真身 / 借来的都算）、而且现在清醒 → 任何死因都挡（中毒 / 酒鬼时这条失效）
    if (BOTC_SailorImmune(q)) {
        return "不会死亡（水手·清醒）";
    }
    if (BOTC_ProtectTokOn(q, 29) && !BOTC_SeatImpaired(q)) {
        return "首次未死（弄臣）";
    }
    // 弄臣（34）：万一标记没打上，也按真身 + 状态兜一层（中毒 / 酒鬼时这条不生效）
    if (BOTC_AbilityWorks(q, 34) && !g_foolUsed[q]) {
        return "首次未死（弄臣）";
    }
    // 茶艺师（32）：两名邻居都是善良 → 那两个邻居不会死（动态判定，只认真身）
    if (BOTC_TeaLadyProtects(q)) {
        return "不会死亡（茶艺师）";
    }

    // ③ 处决免死（只有处决这一种死法看这两个）
    if (kind == 3) {
        if (BOTC_ProtectTokOn(q, 27)) {
            return "处决不死（魔鬼代言人）";
        }
        if (BOTC_ProtectTokOn(q, 28)) {
            return "处决不死（和平主义者）";
        }
    }
    // 【免死（暴风捕手）133】（用户 2026-11-06 按钟楼百科原文改口径）：被宣布的那个善良角色
    //   **只能死于处决** ---- 处决（kind 3）照旧能杀，其余死因（夜间 kind 1、白天 kind 2、
    //   猎手 / 女巫 / 魔像等）一律挡住。
    if (BOTC_ProtectTokOn(q, 133) && kind != 3) {
        return "免死（暴风捕手）";
    }
    return "";
}

void BOTC_DrunkClear (string why) {
    if (g_nightDrunk >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 24] || g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 60]) {
            if (g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 53] || g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 54] || g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 55]) {
                // 这个座位身上的醉酒是侍臣的（还有好几个阶段）：别清掉，只把这一边的记录收回来
            }
            else {
                if (g_nightDrunk == g_sailorDrunk) {
                    // 这个座位同时被水手醉着（水手那份还没到点）：别清掉，只把旅店老板这一边的记录收回来
                }
                else {
                    if (!BOTC_PhiloDrunkSelf(g_nightDrunk)) {   // 【哲学家×酒鬼】（用户 2026-10-13）：他这份醉酒是他自己的身份，不清
                        g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 24] = false;
                    }
                    g_tokOn[(((g_teller * 14) + g_nightDrunk) * 256) + 60] = false;
                    BOTC_GrimRender(g_teller);
                }
            }
        }
    }
    g_nightDrunk = 0;
    g_drunkFrom = 0;
    BOTC_SailorSync();                 // 醉酒状态变了：水手的「不会死亡」标记跟着刷新
}

// ■ 水手（23）自己那一份醉酒：换目标 / 他死了 / 黄昏到期时收回来
void BOTC_SailorDrunkClear (string why) {
    int q;
    q = g_sailorDrunk;
    g_sailorDrunk = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 24] || g_tokOn[(((g_teller * 14) + q) * 256) + 59]) {
        if (g_nightDrunk == q) {
            // 这份醉酒旅店老板也下了：别清掉，只把水手这一边的记录收回来
            return;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 53] || g_tokOn[(((g_teller * 14) + q) * 256) + 54] || g_tokOn[(((g_teller * 14) + q) * 256) + 55]) {
            return;
        }
        if (!BOTC_PhiloDrunkSelf(q)) {              // 【哲学家×酒鬼】（用户 2026-10-13）：他这份醉酒是他自己的身份，不清
            g_tokOn[(((g_teller * 14) + q) * 256) + 24] = false;
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 59] = false;
        BOTC_GrimRender(g_teller);
    }
}

// ■ 水手（23）：「你不会死亡」---- 只要他清醒（没中毒 / 没醉），任何死因都挡。
//   刺客的穿透（ignoreProtect）照样能越过他；处决那边也走这一条（见 BOTC_ExecToggleAt）。
bool BOTC_SailorImmune (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 26]) {
        return true;                       // 说书人手动打的「不会死亡（水手）」标记：以他为准
    }
    if (BOTC_AbilityWorks(q, 23)) {
        return true;
    }
    return false;
}

// 【痢蛭这一夜该不该「选宿主」】（用户 2026-11-13）：首夜一定选；游戏中途被创造出来的痢蛭
//   （麻脸巫婆 / 说书人赋予能力）还没有任何宿主标记时，也先把「选宿主」这个进场能力结算掉，
//   之后才按每夜刀人走。疯子以为自己是痢蛭只走首夜那一次，之后照常「刀人」。
bool BOTC_LleechHostMode (int p) {
    int i;
    if (BOTC_ActingIsFirstNight(p)) {
        return true;
    }
    if (BOTC_IsLunatic(p)) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 120]) {
            return false;                  // 已经有宿主：按每夜刀人走
        }
    }
    return true;                           // 还没有宿主 → 先补选一次
}

// ■ 痢蛭（100）：「宿主活着 → 他不会死亡」---- 照**水手 / 茶艺师**那种「每次现算」的写法，
//   不依赖「不会死亡（痢蛭）122」这个标记有没有被正确打上（痢蛭中途被创造时也能生效）。
//   【用户 2026-11-13 按官方标记口径】「中毒（痢蛭）」标记在首夜一定会放到宿主身上，
//   但痢蛭自己中毒 / 醉酒时它等同「倒转放置」、没有任何效果 —— 此时这条免死同样不生效；
//   恢复清醒健康后，只要宿主还活着就自动恢复。
//   · 自己算的条件：他有「痢蛭」这个能力（真身 / 借来的都算）、在场、活着、没中毒没醉酒，
//     而且他的宿主（带着「中毒（痢蛭）120」的那个座位）还活着。
bool BOTC_LleechImmune (int q) {
    int i;
    if (q < 2 || q > 13) {
        return false;
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：失去能力的痢蛭连「不会死亡」也没了
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 18]) {
        return false;
    }
    if (!g_seatOn[q] || BOTC_SeatDead(q)) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 100)) {
        return false;                      // 没有能力 / 来源失效 / 中毒 / 醉酒：这条免死不生效
    }
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && !BOTC_SeatDead(i) && g_tokOn[(((g_teller * 14) + i) * 256) + 120]) {
            return true;                   // 宿主还活着
        }
    }
    return false;
}

// ■ 水手（23）的「不会死亡（水手）」标记：他清醒、活着、在场就亮着；中毒 / 酒鬼 / 死了就撤掉。
//   标记只是给说书人看的（判定读的是 BOTC_SailorImmune），说书人手动改也没问题。
void BOTC_SailorSync () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!BOTC_HasAbility(q, 23)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 26]) {
            if (BOTC_SeatDead(q) || !BOTC_AbilityWorks(q, 23)) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 26] = false;
                BOTC_PmStore(g_teller, "【水手】" + BOTC_NameStr(q) + " 现在中毒 / 酒鬼 / 已死亡 → 撤掉「不会死亡（水手）」标记。");
            }
        }
        else {
            if (!BOTC_SeatDead(q) && BOTC_AbilityWorks(q, 23)) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 26] = true;
            }
        }
    }
    BOTC_GrimRender(g_teller);            // 标记变了就刷一次魔典（圆桌上那 4 个小格跟着更新）
}

// 【通用中毒（不含「中毒（痢蛭）120」）】（用户 2026-10-11 修传教士不认中毒时拆出来的）：
//   通用「中毒」7（投毒者 / 说书人手动打的）+ 普卡 63 + 舞蛇人 85 + 诺-达鲺 80 + 亡骨魔 81 + **寡妇 96**。
//   （用户 2026-10-14 补 96：寡妇的毒是「一直挂到她死」，可 7 那一格会被投毒者换目标 / 黄昏收掉 → 只认 7 会漏掉她那份毒。）
//   ⚠ 单独拉一个函数出来，是给「痢蛭自己也中毒了吗」那种判断用的：那里不能再回头看 120，否则自己套自己。
bool BOTC_SeatIsPoisonedOther (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 7] || g_tokOn[(((g_teller * 14) + q) * 256) + 63] || g_tokOn[(((g_teller * 14) + q) * 256) + 85] || g_tokOn[(((g_teller * 14) + q) * 256) + 80] || g_tokOn[(((g_teller * 14) + q) * 256) + 81] || g_tokOn[(((g_teller * 14) + q) * 256) + 96] || g_tokOn[(((g_teller * 14) + q) * 256) + 138] || g_tokOn[(((g_teller * 14) + q) * 256) + 169] || g_tokOn[(((g_teller * 14) + q) * 256) + 178] || g_tokOn[(((g_teller * 14) + q) * 256) + 198]);
}

// 【「中毒（痢蛭）120」现在算不算数】（用户 2026-10-11）：官网口径 ——
//   痢蛭选中宿主 = 宿主中毒（能力失效）；痢蛭自己中毒 / 醉酒 / 失去能力 = 那一次不生效，宿主恢复健康。
//   所以只有那名痢蛭现在「真身 100、在场、活着、没中毒没醉酒、没失去能力」时，120 才真的算中毒。
// 【防死循环】（用户 2026-11-13）：宿主身上带 120 → 问「痢蛭现在清醒吗」→ 痢蛭是否醉酒
//   → 哲学家的醉酒判定又要回头看宿主的状态 → 再问一次痢蛭……宿主正好是哲学家时会无限
//   自我递归，脚本线程卡死、全场表现为「时停」。求值过程中再次进入时直接按清醒返回，
//   只打断递归，外层最终结论仍按完整流程算，不会改变正常对局结果。
bool BOTC_LleechPoisonOn () {
    bool r;
    if (g_lleechEval > 0) {
        return true;
    }
    g_lleechEval = 1;
    r = BOTC_LleechPoisonOnCore();
    g_lleechEval = 0;
    return r;
}

bool BOTC_LleechPoisonOnCore () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
        if (!BOTC_AbilityWorks(i, 100)) { continue; }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 18]) { continue; }        // 失去能力（相克：痢蛭 × 主谋）
        if (BOTC_SeatIsDrunk(i)) { continue; }                                // 痢蛭自己醉酒
        if (BOTC_SeatIsPoisonedOther(i)) { continue; }                        // 痢蛭自己中毒（不看 120，避免递归）
        return true;
    }
    return false;
}

bool BOTC_SeatIsPoisoned (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    if (BOTC_SeatIsPoisonedOther(q)) {
        return true;
    }
    // 【中毒（痢蛭）120】（用户 2026-10-11；2026-11-13 按官方标记口径重写）：
    //   首夜他选的玩家身上一定带着这枚标记；但只有「那名痢蛭现在清醒」且「这名玩家能因
    //   痢蛭而中毒」时才算真的中毒。士兵 11 / 莽夫 37 不会因痢蛭中毒 —— 那两枚标记等同
    //   官方规则的「倒转放置」：只提示「被痢蛭选择过」，没有任何效果（但宿主死亡时痢蛭仍会死）。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 120] && BOTC_LleechPoisonOn()) {
        if (BOTC_SeatRealRole(q) != 11 && BOTC_SeatRealRole(q) != 37) {
            return true;
        }
    }
    // 【混沌（121）】（用户 2026-10-16）：他那一刀杀了邻近镇民 → 所有善良玩家中毒；
    //   这枚 token 面板上就叫「中毒」---- 带着它就算中毒（用户 2026-10-16 简化，不再按阵营现算）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 138]) {
        return true;
    }
    return false;
}

bool BOTC_SeatImpaired (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    if (g_liveCorpse[q]) {
        return true;
    }
    if (BOTC_SeatIsDrunk(q)) {
        return true;
    }
    return BOTC_SeatIsPoisoned(q);
}

// 同上，但**不算**「哲学家让人醉」那一份：给 BOTC_PhiloDrunkSeat 自己用，避免自己套自己
bool BOTC_SeatImpairedRaw (int q) {
    if (q < 1 || q > 13) {
        return false;                     // 允许 1：说书人自己那一格
    }
    if (g_liveCorpse[q]) {
        return true;
    }
    if (BOTC_SeatIsDrunkRaw(q)) {
        return true;
    }
    return BOTC_SeatIsPoisoned(q);
}

// 掷一次「观察者 ob 眼里的座位 q」：登记（间谍/陌客可能被看成别的）+ 中毒/酒鬼视角下看到的身份。
//   每个「观察者 × 对象」只掷一次，之后一直沿用；只有观察者的中毒/酒鬼状态变了才会重掷
//   （状态解除就会重新判定，符合「治好以后看到的就是真的」）
void BOTC_RollPair (int ob, int q) {
    int idx;
    int r;
    int imp;
    int subImp;
    bool gdMask;
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return;
    }
    idx = (ob * 14) + q;
    gdMask = false;
    imp = 0;
    if (BOTC_SeatImpaired(BOTC_PosOf(ob))) {
        imp = 1;
    }
    r = BOTC_SeatTrueRole(q);
    // 【座位自己中毒 / 酒鬼】（用户 2026-09-21）：间谍 / 陌客的干扰身份属于能力，失去能力就不再生效
    subImp = 0;
    if (BOTC_SeatImpaired(q)) {
        subImp = 1;
    }
    if (g_pairTeam[idx] >= 0 && g_pairImp[idx] == imp && g_pairRole[idx] == r && g_pairSubImp[idx] == subImp) {
        return;                       // 观察者状态、这个座位的真身、中毒状态都没变 → 沿用上次的判定
    }
    if (g_regTeam[q] >= 0 || g_regAlign[q] >= 0) {
        // 说书人钦定优先
        g_pairTeam[idx] = g_regTeam[q];
        g_pairAlign[idx] = g_regAlign[q];
        if (g_pairTeam[idx] < 0) {
            g_pairTeam[idx] = BOTC_SeatTeam(q);
        }
        if (g_pairAlign[idx] < 0) {
            g_pairAlign[idx] = BOTC_SeatAlign(q);
        }
    }
    else {
        g_pairTeam[idx] = BOTC_SeatTeam(q);
        g_pairAlign[idx] = BOTC_SeatAlign(q);
        // 【干扰身份中毒 / 酒鬼就失效】（用户 2026-09-21）：这时候按真身登记
        //   间谍 = 爪牙 + 邪恶，陌客 = 外来者 + 善良
        if (subImp == 0) {
            if (r == 18) {
                // 间谍：大概率被看成镇民或外来者 + 善良
                if (RandomInt(1, 100) <= g_regDisguiseChance) {
                    g_pairTeam[idx] = RandomInt(0, 1);
                    g_pairAlign[idx] = 0;
                }
            }
            if (r == 15) {
                // 陌客：大概率被看成爪牙或恶魔 + 邪恶
                if (RandomInt(1, 100) <= g_regDisguiseChance) {
                    g_pairTeam[idx] = RandomInt(2, 3);
                    g_pairAlign[idx] = 1;
                }
            }
        }
    }
    // 【半兽人（107）的「失足」】（用户 2026-10-10）：被标记的那名玩家**始终被当作邪恶阵营** ----
    //   只改「登记层」（技能查到的阵营），真身与判胜负（BOTC_WinAlignOf）都不受影响。
    if (BOTC_ProtectTokOn(q, 127)) {
        g_pairAlign[idx] = 1;
    }
    // 【蛊雕（162）· 蛊毒互动干扰】：中毒目标在查验角色或阵营时，可能只被当作
    // 「邪恶的蛊雕」。无论目标原本是什么角色都走这一层；真正阵营与胜负不受影响。
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 198] && RandomInt(1, 100) <= g_regDisguiseChance) {
        g_pairTeam[idx] = 2;
        g_pairAlign[idx] = 1;
        gdMask = true;
    }
    // 「这个座位在观察者眼里是什么身份」：先说真身，再按登记改 ----
    //   陌客 / 间谍这次登记成别的阵营时，看到的必须是那个阵营里的某个身份
    //   （陌客可能被看成爪牙 / 恶魔，间谍可能被看成某个镇民 / 外来者），
    //   所有「查身份」的技能（送葬者、守鸦人、洗衣妇 / 图管 / 调查员报的那个身份）都用它。
    g_pairSeen[idx] = r;
    if (gdMask) {
        g_pairSeen[idx] = 162;
    }
    else if (r == 15 || r == 18) {
        if (g_pairTeam[idx] != BOTC_RoleTeam(r)) {
            g_pairSeen[idx] = BOTC_RoleForTeamNotInPlay(g_pairTeam[idx]);
        }
    }
    if (g_pairSeen[idx] < 0) {
        g_pairSeen[idx] = r;           // 兜底：取不到就还是真身
    }
    // 中毒 / 酒鬼「看到的」阵营和身份：在登记之上，再掷一次「这次有没有把这个人看错」----
    //   同样是「观察者 × 座位」只掷一次、只对新查验的座位掷；已经看错的座位后面一直看错。
    //   例外：**恶魔永远被看成善良**（中毒 / 酒鬼一定包庇恶魔：占卜师验不到他、
    //   共情者 / 厨师不会把他算成邪恶、送葬者 / 守鸦人挖到他也是一张善良身份）---- 不看骰。
    g_pairVTeam[idx] = g_pairTeam[idx];
    g_pairVAlign[idx] = g_pairAlign[idx];
    g_pairVSeen[idx] = g_pairSeen[idx];
    if (imp == 1) {
        if (BOTC_SeatTeam(q) == 3) {
            g_pairVAlign[idx] = 0;
            g_pairVTeam[idx] = RandomInt(0, 1);
            g_pairVSeen[idx] = BOTC_RoleForTeamNotInPlay(g_pairVTeam[idx]);
        }
        else {
            if (RandomInt(1, 100) <= g_viewFlipChance) {
                if (g_pairVAlign[idx] == 1) {
                    g_pairVAlign[idx] = 0;
                    g_pairVTeam[idx] = RandomInt(0, 1);
                }
                else {
                    g_pairVAlign[idx] = 1;
                    g_pairVTeam[idx] = RandomInt(2, 3);
                }
                g_pairVSeen[idx] = BOTC_RoleForTeamNotInPlay(g_pairVTeam[idx]);
            }
        }
        if (g_pairVSeen[idx] < 0) {
            g_pairVSeen[idx] = g_pairSeen[idx];
        }
    }
    g_pairImp[idx] = imp;
    g_pairRole[idx] = r;              // 记下这次是按「哪个真身」判的（身份一变就作废）
    g_pairSubImp[idx] = subImp;       // 座位自己的中毒 / 酒鬼状态（干扰身份用，用户 2026-09-21）
}

int BOTC_PairTeam (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairTeam[(ob * 14) + q];
}

int BOTC_PairAlign (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairAlign[(ob * 14) + q];
}

// 这个座位「看到的身份」：平时就是真身；陌客 / 间谍这次登记成别的阵营时，
//   看到的是那个阵营里的某个身份（陌客可能被看成投毒者 / 小恶魔这种）
int BOTC_PairSeenRole (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairSeen[(ob * 14) + q];
}

// 中毒 / 酒鬼「看到的」阵营 / 善恶 / 身份（清醒的人跟登记那一层一样，不会有差别）
int BOTC_ViewTeam (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairVTeam[(ob * 14) + q];
}

int BOTC_ViewAlign (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairVAlign[(ob * 14) + q];
}

int BOTC_ViewSeenRole (int ob, int q) {
    if (ob < 1 || ob > 13 || q < 2 || q > 13) {
        return -1;
    }
    BOTC_RollPair(ob, q);
    return g_pairVSeen[(ob * 14) + q];
}

// 统一入口：useView = true 取「中毒 / 酒鬼看到的那一层」，false 取「登记」那一层
int BOTC_SeeAlign (int ob, int q, bool useView) {
    if (useView) {
        return BOTC_ViewAlign(ob, q);
    }
    return BOTC_PairAlign(ob, q);
}

// 说书人视角（旧接口）：观察者取**说书人自己的客户端 g_teller**（用户 2026-10-11）
//   ⚠ 原来写死 = 1 ---- 顺位接手 / 换说书人之后说书人不是玩家 1，那份就变成"玩家1 的视角"了。
int BOTC_SeatRegTeam (int q) {
    return BOTC_PairTeam(g_teller, q);
}

int BOTC_SeatRegAlign (int q) {
    return BOTC_PairAlign(g_teller, q);
}

// 技能判定最常用的四个问题（ob = 谁在看）
bool BOTC_RegAsMinion (int ob, int q) {
    return BOTC_PairTeam(ob, q) == 2;
}

bool BOTC_RegAsDemon (int ob, int q) {
    return BOTC_PairTeam(ob, q) == 3;
}

bool BOTC_RegAsEvil (int ob, int q) {
    return BOTC_PairAlign(ob, q) == 1;
}

bool BOTC_RegAsGood (int ob, int q) {
    return BOTC_PairAlign(ob, q) == 0;
}

//==================================================================================================
// 【互动干扰 / 登记层统一入口】（用户 2026-09-20 定成通用规则）：
//   **任何「检测身份 / 阵营」触发的技能都要问这一层，不能直接看真身** ----
//   间谍可能被看成镇民 / 外来者（善良），陌客可能被看成爪牙 / 恶魔（邪恶），
//   所以「茶艺师的邻居、教授要复活的镇民、和平主义者要保的善良、吟游诗人盯的爪牙、
//     驱魔人点名的恶魔、赌徒要猜的角色」全部按登记算。
//   观察者固定用 1（说书人视角 = 这个世界「客观」的登记，不掺某个人的中毒 / 酒鬼看错）。
//==================================================================================================
int BOTC_RegRoleOf (int q) {
    int r;
    if (q < 2 || q > 13) {
        return -1;
    }
    r = BOTC_PairSeenRole(g_teller, q);
    if (r < 0) {
        r = BOTC_SeatTrueRole(q);
    }
    return r;
}

bool BOTC_RegIsGood (int q) {
    return BOTC_SeatRegAlign(q) == 0;
}

bool BOTC_RegIsTownsfolk (int q) {
    return BOTC_SeatRegTeam(q) == 0;
}

bool BOTC_RegIsMinion (int q) {
    return BOTC_SeatRegTeam(q) == 2;
}

bool BOTC_RegIsDemon (int q) {
    return BOTC_SeatRegTeam(q) == 3;
}

// 【间谍 / 陌客能力者】（用户 2026-11-12）：真身或借到该能力的座位都算。
//   这些座位不再由脚本自动按伪装结算，统一改弹说书人判定窗。
bool BOTC_IsSpyAbility (int q) {
    return BOTC_HasAbility(q, 18);
}

bool BOTC_IsRecluseAbility (int q) {
    return BOTC_HasAbility(q, 15);
}

bool BOTC_IsDisguiseAbility (int q) {
    return BOTC_IsSpyAbility(q) || BOTC_IsRecluseAbility(q);
}

// 某阵营还活着的人数（胜负判定、票数门槛之类会用到）
int BOTC_AliveTeamCount (int t) {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatTeam(q) == t) {
            if (!BOTC_PublicDead(q)) {
                n = n + 1;
            }
        }
    }
    return n;
}

// 这个身份现在场上有没有：只看真身（用户 2026-11-13）。
//   认知偏差（酒鬼 / 疯子 / 提线木偶 / 悟道者「以为自己是」）以及借能力 / 变脸临时改写的
//   魔典标记都不算该角色在场，哪怕他说书人魔典上那一格写着这个身份。
bool BOTC_RoleInPlay (int idx) {
    int i;
    int q;
    if (idx < 0) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        // 【变脸师】临时借来的那张牌不算在场，这里用还原过的真身判定（用户 2026-11-13）。
        if (BOTC_SeatRealRole(q) == idx) {
            return true;
        }
    }
    return false;
}

// 【角色效果是否在场】（用户 2026-11-06）：身份在场，或者有玩家通过失忆者 / 食人族 /
//   哲学家 / 炼金术士 / 科学怪人 / 说书人赋予拿到了这项能力 ----
//   只给「能力在就该记 token / 该触发被动」的场合用；身份登记（不在场名单、伪装池）仍用 BOTC_RoleInPlay。
bool BOTC_RoleEffInPlay (int r) {
    int q;
    if (r < 0 || r > 163) {
        return false;
    }
    if (BOTC_RoleInPlay(r)) {
        return true;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_HasAbility(q, r)) {
            return true;
        }
    }
    return false;
}

// 只看真身：酒鬼 / 疯子 / 提线木偶 / 悟道者以为自己是的那张牌面不算这个角色真的在场。
// 【统一口径】（用户 2026-11-13）：BOTC_RoleInPlay 现在也只看真身，这里直接复用，避免两套逻辑分叉。
bool BOTC_RoleTrueInPlay (int idx) {
    return BOTC_RoleInPlay(idx);
}

// 【除某个座位之外，还有没有这个角色】（用户 2026-11-13）：麻脸巫婆把「克星」改造成另一个时，
//   如果那个克星就是被改造者本人，改完之后场上只剩一个，应当允许 —— 所以要排除目标座位。
bool BOTC_RoleInPlayOther (int idx, int exceptSeat) {
    int i;
    int q;
    if (idx < 0) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == exceptSeat) {
            continue;
        }
        if (BOTC_SeatRealRole(q) == idx) {
            return true;
        }
    }
    return false;
}

// 【有没有人「以为自己是」这个角色】（用户 2026-11-13）：酒鬼 / 疯子 / 提线木偶 / 悟道者
//   按魔典上写着的那张假卡算。随机不在场身份发放要把它排除，避免把别人的假身份再发出去。
bool BOTC_RoleCogSeenInPlay (int idx) {
    int i;
    int q;
    int r;
    if (idx < 0 || idx > 163) {
        return false;
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        if (r != 14 && r != 38 && r != 93 && r != 118) {
            continue;
        }
        if (g_mark[(g_teller * 14) + q] == (idx + 1)) {
            return true;
        }
    }
    return false;
}

//==================================================================================================
// 【实验性角色 · 能力实现】
//   只加入自定义剧本角色池，不新增板子。复杂的手工裁定仍交给真人说书人。
//==================================================================================================

// 【限（147）】点击【确认发放】时冻结初始外来者数量；之后角色变化不会改写触发夜。
void BOTC_XaanSetupSync () {
    int q;
    int r;
    int n;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 1) {
            n = n + 1;
        }
    }
    g_xaanInitialOutsiders = n;
    g_xaanPoisonOn = false;
    if (BOTC_RoleTrueInPlay(147)) {
        if (n > 0) {
            BOTC_PmStore(g_teller, "【限】初始外来者 " + IntToString(n) + " 名 → 大限将至会在第 " + IntToString(n) + " 夜触发。");
        }
        else {
            BOTC_PmStore(g_teller, "【限】初始外来者 0 名 → 本局不会触发大限将至。");
        }
    }
}

bool BOTC_XaanCanAct (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q)) {
        return false;
    }
    if (!BOTC_HasAbility(q, 147) || !BOTC_AbilityWorks(q, 147)) {
        return false;
    }
    if (g_xaanInitialOutsiders <= 0 || g_nightNum != g_xaanInitialOutsiders) {
        return false;
    }
    return !g_xaanPoisonOn;
}

int BOTC_XaanAutoSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (BOTC_XaanCanAct(q)) {
            return q;
        }
    }
    return 0;
}

void BOTC_XaanApply (int q) {
    int i;
    int r;
    if (!BOTC_XaanCanAct(q)) {
        return;
    }
    g_xaanPoisonOn = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 168] = true;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 0) {
            BOTC_WudTryTrigger(i, q);
            g_tokOn[(((g_teller * 14) + i) * 256) + 169] = true;
        }
    }
    BOTC_SailorSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【限】第 " + IntToString(g_nightNum) + " 夜触发大限将至：所有镇民中毒到下一个黄昏。");
}

void BOTC_XaanPoisonClear (string why) {
    int q;
    if (!g_xaanPoisonOn) {
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 168] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 169] = false;
    }
    g_xaanPoisonOn = false;
    BOTC_SailorSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【限】大限将至结束：所有镇民恢复健康（" + why + "）。");
}

// 【瘟疫医生（137）】（用户 2026-11-12 恢复实现）：
//   当你死亡时，说书人会获得一个爪牙能力；并按下列相克规则改写：
//   · 男爵 → 改为至多两名玩家会变成外来者
//   · 炸弹人 / 镜像双子 → 改为一名玩家会变成该角色
//   · 提线木偶 → 改为一名与恶魔邻近的善良玩家变成提线木偶
//   · 恐惧之灵 / 哥布林 / 红唇女郎 / 间谍 / 赶尸人 / 狐媚娘 / 蛊雕 → 改为一名爪牙玩家获得此能力，且他会得知此事
bool BOTC_PlagueDoctorUsable () {
    return true;
}

void BOTC_PlagueDoctorJinxClear () {
    g_pdJinxRole = 0;
    g_pdJinxKind = 0;
    g_pdBarN = 0;
}

// 场上还有没有存活的爪牙（相克：爪牙获得能力要用）。
bool BOTC_PlagueDoctorMinionAlive () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 2) {
            return true;
        }
    }
    return false;
}

// 当前板子里还有没有可以变成的外来者（相克：男爵要用）。
bool BOTC_PlagueDoctorOutsiderOnBoard () {
    int i;
    for (i = 0; i <= 163; i += 1) {
        if (BOTC_RoleTeam(i) != 1) {
            continue;
        }
        if (i == 14 || (i >= 143 && i <= 146)) {
            continue;
        }
        if (BOTC_RoleOnBoard(i)) {
            return true;
        }
    }
    return false;
}

// 统一的身份转变：真值行 + 玩家自己的镜像行 + 双方魔典 + 转变提示。
void BOTC_PlagueDoctorSetRole (int seat, int role) {
    if (seat < 2 || seat > 13 || role < 0 || role > 163) {
        return;
    }
    BOTC_SetSeatRole(g_teller, seat, role);
    BOTC_SetSeatRole(g_who[seat], seat, role);
    BOTC_GrimRender(g_teller);
    if (g_who[seat] >= 1 && g_who[seat] <= 13) {
        BOTC_GrimRender(g_who[seat]);
    }
    BOTC_ChangeRoleMsg(seat, role);
}

// 相克流程收尾：清状态、刷新魔典与「说书人能力」入口。
void BOTC_PlagueDoctorJinxEnd (int ob) {
    if (ob != g_teller) {
        return;
    }
    if (g_pdJinxKind == 1 && g_pdBarN > 0) {
        BOTC_PmStore(g_teller, "【瘟疫医生×男爵】已有 " + IntToString(g_pdBarN) + " 名玩家变成外来者。");
    }
    else if (g_pdJinxKind == 1) {
        BOTC_PmStore(g_teller, "【瘟疫医生×男爵】相克结束：没有玩家变成外来者。");
    }
    BOTC_PlagueDoctorJinxClear();
    BOTC_GrimRender(g_teller);
    BOTC_WakeRender();
}

// 死亡触发入口：从当前板子的爪牙里挑一个能力。
void BOTC_PlagueDoctorOpenRole () {
    int r;
    bool any;
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (!g_pdPick) {
        return;
    }
    BOTC_CustomSyncBoardRoles();
    any = false;
    for (r = 0; r <= 163; r += 1) {
        if (BOTC_RoleTeam(r) == 2 && BOTC_RoleOnBoard(r)) {
            any = true;
        }
    }
    if (!any) {
        g_pdPick = false;
        BOTC_PmStore(g_teller, "【瘟疫医生】当前板子里没有爪牙角色 → 说书人不会获得能力。");
        return;
    }
    g_pickMode[g_teller] = 39;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("瘟疫医生：选择一个说书人获得的爪牙能力"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

// 相克 · 男爵：让说书人从当前板子的外来者里挑一名玩家要变成的角色（最多两名）。
void BOTC_PlagueDoctorBaronOpen () {
    g_pickMode[g_teller] = 40;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("瘟疫医生×男爵：选择第 " + IntToString(g_pdBarN + 1) + " 名玩家要变成的外来者（最多两名，点取消结束）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_PlagueDoctorBaronPick (int role) {
    if (role < 0 || role > 163) {
        BOTC_PlagueDoctorJinxEnd(g_teller);
        return;
    }
    g_pdJinxRole = role + 1;
    g_pdJinxKind = 1;
    BOTC_PlagueDoctorSeatAsk();
}

// 相克：需要说书人再指定一名玩家 → 用统一的「填座位号」框。
void BOTC_PlagueDoctorSeatAsk () {
    string title;
    if (g_pdJinxKind == 1) {
        title = "【瘟疫医生×男爵】填写第 " + IntToString(g_pdBarN + 1) + " 名要变成 " + g_roleName[g_pdJinxRole - 1] + " 的玩家座位号（1~12）";
    }
    else if (g_pdJinxKind == 2) {
        title = "【瘟疫医生×炸弹人】填一名要变成炸弹人的玩家座位号（1~12）";
    }
    else if (g_pdJinxKind == 3) {
        title = "【瘟疫医生×镜像双子】填一名要变成镜像双子的玩家座位号（1~12）";
    }
    else if (g_pdJinxKind == 4) {
        title = "【瘟疫医生×提线木偶】填一名与恶魔邻近的善良玩家座位号（1~12）";
    }
    else {
        title = "【瘟疫医生】填一名爪牙玩家的座位号（1~12）：他获得「" + g_roleName[g_pdJinxRole - 1] + "」能力";
    }
    BOTC_ManInfoOpenSeats(2, title, 26);
    g_miRole = 819;
}

void BOTC_PlagueDoctorSeatApply () {
    string s;
    int n;
    int seat;
    int role;
    int a;
    int b;
    bool ok;
    if (g_pdJinxKind < 1 || g_pdJinxKind > 5) {
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_PlagueDoctorJinxClear();
        return;
    }
    s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "请填写座位号（1~12）。");
        return;
    }
    seat = n + 1;
    if (!g_seatOn[seat] || BOTC_SeatDead(seat)) {
        BOTC_Notice(g_teller, "那个座位没有存活的玩家。");
        return;
    }
    // 相克：爪牙获得能力 → 只能选存活爪牙。
    if (g_pdJinxKind == 5) {
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(seat)) != 2) {
            BOTC_Notice(g_teller, "相克规则要求由一名爪牙玩家获得此能力。");
            return;
        }
        role = g_pdJinxRole - 1;
        DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_AttachGrant(seat, role, false);
        BOTC_PmInfo(g_who[seat], "你得知：你获得了「" + g_roleName[role] + "」能力。");
        BOTC_PmStore(g_teller, "【瘟疫医生】相克：爪牙 " + BOTC_NameStr(seat) + " 获得「" + g_roleName[role] + "」能力（说书人不获得）。");
        BOTC_PlagueDoctorJinxClear();
        BOTC_GrimRender(g_teller);
        BOTC_WakeRender();
        return;
    }
    // 相克：提线木偶 → 必须是与存活恶魔相邻的善良玩家。
    if (g_pdJinxKind == 4) {
        if (BOTC_SeatAlign(seat) != 0) {
            BOTC_Notice(g_teller, "相克规则要求选一名善良玩家。");
            return;
        }
        ok = false;
        a = seat - 1;
        if (a < 2) {
            a = 13;
        }
        b = seat + 1;
        if (b > 13) {
            b = 2;
        }
        if (g_seatOn[a] && !BOTC_SeatDead(a) && BOTC_RoleTeam(BOTC_SeatTrueRole(a)) == 3) {
            ok = true;
        }
        if (g_seatOn[b] && !BOTC_SeatDead(b) && BOTC_RoleTeam(BOTC_SeatTrueRole(b)) == 3) {
            ok = true;
        }
        if (!ok) {
            BOTC_Notice(g_teller, "相克规则要求选一名与恶魔邻近的玩家。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_PlagueDoctorSetRole(seat, 93);
        BOTC_PmStore(g_teller, "【瘟疫医生×提线木偶】" + BOTC_NameStr(seat) + " 变成了提线木偶。");
        BOTC_PlagueDoctorJinxClear();
        BOTC_GrimRender(g_teller);
        BOTC_WakeRender();
        return;
    }
    // 相克：男爵 → 把这一名玩家变成刚才挑的外来者。
    if (g_pdJinxKind == 1) {
        role = g_pdJinxRole - 1;
        DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
        g_miRole = -1;
        g_miSeat = 0;
        BOTC_PlagueDoctorSetRole(seat, role);
        g_pdBarN = g_pdBarN + 1;
        BOTC_PmStore(g_teller, "【瘟疫医生×男爵】" + BOTC_NameStr(seat) + " 变成了 " + g_roleName[role] + "。");
        if (g_pdBarN < 2) {
            BOTC_PlagueDoctorBaronOpen();
        }
        else {
            BOTC_PlagueDoctorJinxEnd(g_teller);
        }
        return;
    }
    // 相克：炸弹人（138）/ 镜像双子（64）→ 一名玩家变成该角色。
    role = g_pdJinxRole - 1;
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    g_miRole = -1;
    g_miSeat = 0;
    BOTC_PlagueDoctorSetRole(seat, role);
    BOTC_PmStore(g_teller, "【瘟疫医生】" + BOTC_NameStr(seat) + " 变成了 " + g_roleName[role] + "。");
    BOTC_PlagueDoctorJinxClear();
    BOTC_GrimRender(g_teller);
    BOTC_WakeRender();
}

void BOTC_PlagueDoctorPick (int role) {
    g_pdPick = false;
    if (role < 0 || role > 163) {
        BOTC_PmStore(g_teller, "【瘟疫医生】说书人放弃了这个爪牙能力。");
        BOTC_PlagueDoctorJinxClear();
        return;
    }
    BOTC_PlagueDoctorJinxClear();
    // 相克 · 男爵：改为至多两名玩家会变成外来者。
    if (role == 20) {
        if (!BOTC_PlagueDoctorOutsiderOnBoard()) {
            BOTC_PmStore(g_teller, "【瘟疫医生×男爵】当前板子里没有可变成的外来者 → 相克不生效。");
            return;
        }
        g_pdJinxKind = 1;
        BOTC_PlagueDoctorBaronOpen();
        return;
    }
    // 相克 · 炸弹人 / 镜像双子：改为一名玩家会变成该角色。
    if (role == 138 || role == 64) {
        if (role == 138) {
            g_pdJinxKind = 2;
        }
        else {
            g_pdJinxKind = 3;
        }
        g_pdJinxRole = role + 1;
        BOTC_PlagueDoctorSeatAsk();
        return;
    }
    // 相克 · 提线木偶：改为一名与恶魔邻近的善良玩家变成提线木偶。
    if (role == 93) {
        g_pdJinxKind = 4;
        g_pdJinxRole = role + 1;
        BOTC_PlagueDoctorSeatAsk();
        return;
    }
    // 相克 · 恐惧之灵 / 哥布林 / 红唇女郎 / 间谍 / 赶尸人 / 狐媚娘 / 蛊雕：
    //   改为一名爪牙玩家获得此能力，且他会得知此事。
    if (role == 102 || role == 99 || role == 19 || role == 18 || role == 126 || role == 153 || role == 162) {
        g_pdJinxKind = 5;
        g_pdJinxRole = role + 1;
        if (!BOTC_PlagueDoctorMinionAlive()) {
            g_pdRole = role + 1;
            BOTC_PlagueDoctorJinxClear();
            BOTC_PmStore(g_teller, "【瘟疫医生】相克：场上没有存活爪牙 → 改为说书人自己获得「" + g_roleName[role] + "」能力。夜间点【说书人：" + g_roleName[role] + "】使用。");
            BOTC_WakeRender();
            return;
        }
        BOTC_PlagueDoctorSeatAsk();
        return;
    }
    // 常规：说书人自己获得这个爪牙能力。
    g_pdRole = role + 1;
    if (role == 84) {
        // 【精神病患者】只能白天公开声称：白天点【声称/猜测】选「精神病患者」，再点一名玩家头像。
        BOTC_PmStore(g_teller, "【瘟疫医生】说书人获得「精神病患者」能力：白天点【声称/猜测】选择精神病患者，再点一名玩家头像即可（不需要夜间入口）。");
    }
    else {
        BOTC_PmStore(g_teller, "【瘟疫医生】说书人获得「" + g_roleName[role] + "」能力。夜间魔典上点【说书人：" + g_roleName[role] + "】使用。");
    }
    BOTC_GrimRender(g_teller);
    BOTC_WakeRender();
}

// 你死亡时触发：死亡那一刻中毒 / 醉酒则不获得能力。
void BOTC_PlagueDoctorDeath (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_started) {
        return;
    }
    if (!BOTC_HasAbility(q, 137)) {
        return;
    }
    if (g_pdRole > 0) {
        return;
    }
    if (g_pdPick) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 137)) {
        BOTC_PmStore(g_teller, "【瘟疫医生】" + BOTC_NameStr(q) + " 死亡时醉酒或中毒 → 说书人不获得爪牙能力。");
        return;
    }
    g_pdPick = true;
    BOTC_PmStore(g_teller, "【瘟疫医生】" + BOTC_NameStr(q) + " 死亡 → 说书人获得一个爪牙能力，请从面板中选择。");
    BOTC_PlagueDoctorOpenRole();
}

// 夜间魔典左侧的【说书人：X】入口：说书人自己发动获得的爪牙能力。
void BOTC_PlagueDoctorAct () {
    int r;
    if (g_pdRole <= 0 || g_pdRole > 163) {
        return;
    }
    if (!g_isNight) {
        BOTC_Notice(g_teller, "说书人获得的爪牙能力只能在夜间使用。");
        return;
    }
    r = g_pdRole - 1;
    // 【精神病患者（84）】（用户 2026-11-12）：改用白天【声称/猜测】面板里的精神病患者入口。
    if (r == 84) {
        BOTC_Notice(g_teller, "精神病患者能力请在白天点【声称/猜测】里的精神病患者入口，再点一名玩家头像发动。");
        return;
    }
    if (!BOTC_TellerCastCan(r)) {
        BOTC_Notice(g_teller, "这条爪牙能力今夜没有可执行的夜间行动。");
        return;
    }
    if (r == 18) {
        BOTC_SpyPeek(1);
        return;
    }
    if (r == 75) {
        if (!BOTC_WidowPeek(1)) {
            BOTC_SkillOpen(1);
        }
        return;
    }
    BOTC_SkillOpen(1);
}

bool BOTC_BoomHasImmuneToken (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    // 保护 / 不会死亡 / 处决不死 / 首次未死 / 维齐尔白天免死。
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 9] || g_tokOn[(((g_teller * 14) + q) * 256) + 25] || g_tokOn[(((g_teller * 14) + q) * 256) + 26] || g_tokOn[(((g_teller * 14) + q) * 256) + 27] || g_tokOn[(((g_teller * 14) + q) * 256) + 28] || g_tokOn[(((g_teller * 14) + q) * 256) + 29] || g_tokOn[(((g_teller * 14) + q) * 256) + 51] || g_tokOn[(((g_teller * 14) + q) * 256) + 122] || g_tokOn[(((g_teller * 14) + q) * 256) + 133] || g_tokOn[(((g_teller * 14) + q) * 256) + 166]);
}

void BOTC_BoomKeepOpen () {
    g_boomKeepPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择三名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_skillNoPick[1], PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "炸弹人：请选择三名保留玩家，其余无免死 token 的玩家将死亡。");
}

void BOTC_BoomVoteStart () {
    int i;
    g_boomKeepPick = false;
    g_boomVoteOn = true;
    g_boomResult = false;
    g_skillPicking[1] = false;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    for (i = 1; i <= 13; i += 1) {
        g_boomVote[i] = 0;
        g_boomCount[i] = 0;
    }
    BOTC_PlaySfx(g_sfxCountName);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(10), PlayerGroupAll());
    BOTC_BigNotice("选择一名玩家或说书人");
    DialogControlSetVisible(g_boomTellerBtn, PlayerGroupAll(), true);
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i]) {
            BOTC_Notice(g_who[i], "炸弹人指向投票：点一个在座玩家座位，或点下方【指向说书人】；倒计时结束前可以随时更改。");
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[i]), true);
            g_grimOn[g_who[i]] = true;
        }
    }
    libNtve_gf_StopTimer(g_tSpeech);
    libNtve_gf_StopTimer(g_tVote);
    TimerStart(g_tVote, 10.0, false, c_timeGame);
}

void BOTC_BoomVotePick (int p, int q) {
    int seat;
    if (!g_boomVoteOn || p < 2 || p > 13 || q < 1 || q > 13) {
        return;
    }
    seat = BOTC_PosOf(p);
    if (seat < 2 || seat > 13 || !g_seatOn[seat]) {
        BOTC_Notice(p, "你已经不能参与这次指向投票。");
        return;
    }
    if (q != 1 && !g_seatOn[q]) {
        BOTC_Notice(p, "只能选择一名在座的玩家。");
        return;
    }
    g_boomVote[seat] = q;
    BOTC_Notice(p, "已指向 " + BOTC_NameStr(q) + "；倒计时结束前可以继续改选。");
}

void BOTC_BoomVoteEnd () {
    int i;
    int q;
    int top;
    int topN;
    int tie;
    if (!g_boomVoteOn) {
        return;
    }
    g_boomVoteOn = false;
    DialogControlSetVisible(g_boomTellerBtn, PlayerGroupAll(), false);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    for (i = 1; i <= 13; i += 1) {
        g_boomCount[i] = 0;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || g_boomVote[i] <= 0) {
            continue;
        }
        q = g_boomVote[i];
        if (q >= 1 && q <= 13) {
            g_boomCount[q] = g_boomCount[q] + 1;
        }
    }
    g_boomResult = true;
    BOTC_NomUI();                  // 复用提名票数区：在各座位名下方显示最终得票
    // 【炸弹人指向说书人】（用户 2026-11-12）：说书人拿到唯一最高票时直接按处决说书人结算。
    top = 0;
    topN = 0;
    tie = 0;
    for (i = 1; i <= 13; i += 1) {
        if (g_boomCount[i] <= 0) {
            continue;
        }
        if (g_boomCount[i] > topN) {
            topN = g_boomCount[i];
            top = i;
            tie = 0;
        }
        else {
            if (g_boomCount[i] == topN) {
                tie = 1;
            }
        }
    }
    if (top == 1 && topN > 0 && tie == 0) {
        BOTC_PmStore(g_teller, "【炸弹人】说书人获得最高票（" + IntToString(topN) + " 票）→ 说书人被处决。");
        g_boomPending = false;
        BOTC_ExecToggleAt(1);
        return;
    }
    BOTC_PmStore(g_teller, "【炸弹人】10 秒指向投票结束，完整票数已显示在各座位下方。最高票不自动处决，请按规则手工裁定。");
    if (g_boomCount[1] > 0) {
        if (g_boomCount[1] == topN && tie != 0) {
            BOTC_PmStore(g_teller, "【炸弹人】说书人获得 " + IntToString(g_boomCount[1]) + " 票，并列最高，请手动裁定是否处决说书人。");
        }
        else {
            BOTC_PmStore(g_teller, "【炸弹人】说书人获得 " + IntToString(g_boomCount[1]) + " 票。");
        }
    }
    g_boomPending = false;
}

void BOTC_BoomKeepConfirm () {
    int i;
    int q;
    int a;
    int b;
    int c;
    string killed;
    if (!g_boomKeepPick) {
        return;
    }
    a = g_skillT1[1];
    b = g_skillT2[1];
    c = g_skillT3[1];
    if (a < 2 || a > 13 || b < 2 || b > 13 || c < 2 || c > 13 || a == b || a == c || b == c) {
        BOTC_Notice(g_teller, "炸弹人必须选择三名不同的存活玩家。");
        return;
    }
    if (!g_seatOn[a] || !g_seatOn[b] || !g_seatOn[c] || BOTC_SeatDead(a) || BOTC_SeatDead(b) || BOTC_SeatDead(c)) {
        BOTC_Notice(g_teller, "三名保留者必须都是存活玩家。");
        return;
    }
    g_boomKeepPick = false;
    for (i = 1; i <= 13; i += 1) {
        g_boomKeep[i] = false;
    }
    g_boomKeep[a] = true;
    g_boomKeep[b] = true;
    g_boomKeep[c] = true;
    // 先快照所有免死 token，再同时结算死亡，避免来源先死导致后续 token 被提前清掉。
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_boomKeep[q]) {
            continue;
        }
        if (BOTC_BoomHasImmuneToken(q)) {
            g_boomKeep[q] = true;
            BOTC_PmStore(g_teller, "【炸弹人】" + BOTC_NameStr(q) + " 带免死 / 保护 token，爆炸未杀死他。");
        }
    }
    g_skillPicking[1] = false;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    BOTC_PubAnnounce("炸弹人引爆，除保留者外的玩家死亡。");
    killed = "";
    BOTC_PlaySfx("Marine_Death");
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_boomKeep[q]) {
            continue;
        }
        BOTC_MarkDeathRowTok(q, BOTC_DeathRowOf(2, 0), -1, true);
        g_deadShown[q] = true;
        g_deadPending[q] = false;
        BOTC_MoonChildCheck(q);
        BOTC_KlutzCheck(q);
        BOTC_DeclareRender();
        BOTC_PubAnnounce("【死亡】" + BOTC_NameStr(q) + " 死亡");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡（炸弹人）----");
        BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
        if (StringLength(killed) > 0) {
            killed = killed + "、";
        }
        killed = killed + BOTC_NameStr(q);
    }
    for (q = 1; q <= 13; q += 1) {
        BOTC_GrimRender(q);
    }
    if (StringLength(killed) > 0) {
        BOTC_PmStore(g_teller, "【炸弹人】保留：" + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "、" + BOTC_NameStr(c) + "；爆炸死亡：" + killed + "。");
    }
    BOTC_BoomVoteStart();
}

bool BOTC_BoomdandyTrigger (int q) {
    if (g_boomPending || q < 2 || q > 13 || !BOTC_HasAbility(q, 138) || !BOTC_AbilityWorks(q, 138)) {
        return false;
    }
    g_boomPending = true;
    g_boomSeat = q;
    if (g_phase != 0) {
        BOTC_NomCloseEx(false);
    }
    BOTC_PubAnnounce("【炸弹人】" + BOTC_NameStr(q) + " 引爆了炸弹！");
    BOTC_BigNotice("炸弹人引爆");
    BOTC_PmStore(g_teller, "【炸弹人】" + BOTC_NameStr(q) + " 已被处决。请先选择三名保留玩家，其余玩家会死亡；免死 / 保护 token 会阻止爆炸死亡。");
    BOTC_BoomKeepOpen();
    return true;
}

void BOTC_HarpyApplyPair (int src, int a, int b) {
    int j;
    int base;
    if (src < 1 || src > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    for (j = 1; j <= 13; j += 1) {
        base = (g_teller * 14) + j;
        g_tokOn[(base * 256) + 162] = false;
        g_tokOn[(base * 256) + 163] = false;
        g_harpyFirstBy[j] = 0;
        g_harpySecondBy[j] = 0;
        g_harpyDay[j] = 0;
    }
    if (!BOTC_AbilityWorks(src, 139)) {
        BOTC_PmStore(g_teller, "【鹰身女妖】能力失效 → 这次不放置疯狂 / 第二名标记，也不发送信息。");
        return;
    }
    g_harpyFirstBy[src] = a;
    g_harpySecondBy[src] = b;
    g_harpyDay[src] = g_nightNum;
    g_tokOn[((((g_teller * 14) + a) * 256) + 162)] = true;
    g_tokOn[((((g_teller * 14) + b) * 256) + 163)] = true;
    BOTC_PmInfo(g_who[a], "【信息】你得知鹰身女妖选择了你：明天你需要疯狂地证明" + BOTC_NameStr(b) + "是邪恶的，否则你们之中可能有人死亡。");
    BOTC_PmStore(g_teller, "【鹰身女妖】" + BOTC_NameStr(src) + " 选择了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b) + "；次日疯狂与死亡由你手工处理。");
    BOTC_GrimRender(g_teller);
}

void BOTC_OrganOpen (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    g_organSeat = q;
    if (q >= 2 && BOTC_SeatIsComputer(q)) {
        BOTC_OrganChoose(0);
        return;
    }
    libNtve_gf_SetDialogItemText(g_organTitle, StringToText("是否发动能力（选择自己是否醉酒）"), PlayerGroupSingle(g_who[q]));
    DialogControlSetVisible(g_organYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_organYes, PlayerGroupSingle(g_who[q]), true);
    DialogControlSetVisible(g_organNo, PlayerGroupSingle(g_who[q]), true);
    DialogSetVisible(g_organDlg, PlayerGroupSingle(g_who[q]), true);
}

void BOTC_OrganChoose (int yes) {
    int q;
    string s;
    q = g_organSeat;
    if (q < 1 || q > 13) {
        return;
    }
    g_organSeat = 0;
    g_organDrunkBy[q] = (yes != 0);
    g_tokOn[((((g_teller * 14) + q) * 256) + 164)] = (yes != 0);
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    s = "保持清醒。";
    if (yes != 0) {
        s = "醉酒到下一个黄昏。";
    }
    BOTC_PmInfo(g_who[q], "【信息】你得知自己" + s);
    if (yes != 0) {
        s = "醉酒。";
    }
    else {
        s = "清醒。";
    }
    BOTC_PmStore(g_teller, "【街头风琴手】" + BOTC_NameStr(q) + " 选择了" + s);
    BOTC_GrimRender(g_teller);
    BOTC_SeatStateSync();
}

bool BOTC_OrganActive () {
    int q;
    q = BOTC_AbilitySeat(140);
    if (q == 1) {
        return !g_tokOn[((((g_teller * 14) + q) * 256) + 164)];
    }
    return (q >= 2 && q <= 13 && !BOTC_SeatDead(q));
}

bool BOTC_ButlerVoteCounts (int q) {
    if (!BOTC_OrganActive() || q != g_butlerSeat) {
        return true;
    }
    if (q < 2 || q > 13 || BOTC_SeatImpaired(q)) {
        return true;               // 管家自己醉酒 / 中毒时不看主人
    }
    if (g_butlerMaster < 2 || g_butlerMaster > 13) {
        return false;
    }
    return (g_vote[g_butlerMaster] == 1);
}

void BOTC_OrganDuskClear () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        g_tokOn[((((g_teller * 14) + q) * 256) + 164)] = false;
        g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
        g_organDrunkBy[q] = false;
    }
    g_organSeat = 0;
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
}

bool BOTC_VizierClaimReady () {
    if (!g_started || g_phase < 1 || g_phase > 6) {
        return false;
    }
    if (g_vizierSeat < 2 || g_vizierSeat > 13) {
        return false;
    }
    return !g_execUsedToday;
}

// 统一按能力层找维齐尔：原生、炼金术士借用、哲学家 / 食人族 /
// 科学怪人 / 说书人赋予都算，不依赖真身是否恰好是 141。
void BOTC_VizierAnnounce () {
    int q;
    // 相克：戏法师在场时，首日不公开维齐尔身份。
    if (BOTC_RoleTrueInPlay(149)) {
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatDead(q) || g_vizierAnnounced[q]) {
            continue;
        }
        if (!BOTC_HasAbility(q, 141)) {
            continue;
        }
        g_vizierAnnounced[q] = true;
        BOTC_PubAnnounce("【维齐尔】" + BOTC_NameStr(q) + " 是维齐尔。");
        BOTC_PmStore(g_teller, "【维齐尔】已向全场公开：" + BOTC_NameStr(q) + " 具有维齐尔能力。");
    }
}

void BOTC_VizierAfterVote (int nominee, int goodVotes) {
    int i;
    int zeal;
    bool relevant;
    if (nominee < 2 || nominee > 13) {
        return;
    }
    g_vizierSeat = nominee;
    g_vizierGood = goodVotes;
    // 只有场上存在生效的维齐尔能力，或本轮有人声称维齐尔时才提示。
    relevant = BOTC_AbilityInPlay(141);
    for (i = 1; i <= 13; i += 1) {
        if (g_vizierClaimed[i]) {
            relevant = true;
        }
    }
    if (!relevant) {
        return;
    }
    if (goodVotes > 0) {
        BOTC_PmStore(g_teller, "【维齐尔】有善良玩家投票");
    }
    else {
        // 【维齐尔×狂热者 · 相克】（用户 2026-11-11）：狂热者的票默认没计入善良票，
        //   这里把可裁定的口径一起写给说书人，由他决定本场算不算「有善良玩家投票」。
        zeal = 0;
        for (i = 2; i <= 13; i += 1) {
            if (zeal == 0 && g_vote[i] == 1 && BOTC_HasAbility(i, 110)) {
                zeal = i;
            }
        }
        if (zeal >= 2) {
            BOTC_PmStore(g_teller, "【维齐尔】无善良玩家投票（" + BOTC_NameStr(zeal) + " 是狂热者，这票按相克未计入；若判定它算善良，本次改为「有善良玩家投票」）");
        }
        else {
            BOTC_PmStore(g_teller, "【维齐尔】无善良玩家投票");
        }
    }
}

void BOTC_VizierClaim (int p) {
    int seat;
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_VizierClaimReady()) {
        BOTC_Notice(p, "当前不能声称维齐尔：现在不在提名阶段，或今天已经处决过。");
        return;
    }
    if (g_vizierClaimed[p]) {
        BOTC_Notice(p, "你本轮已经声称过维齐尔了。");
        return;
    }
    g_vizierClaimed[p] = true;
    seat = BOTC_PosOf(p);
    BOTC_PubAnnounce(BOTC_NameStr(seat) + " 宣布使用维齐尔能力");
    BOTC_DeclareCdSet(p);
    // 【只有真有能力的人才提醒】（用户 2026-11-04）：任何人都能公开声称维齐尔，假声称不写私聊；
    //   真身 / 借到该能力的人按是否中毒醉酒区分提醒。
    if (BOTC_HasAbility(seat, 141)) {
        if (g_vizierSeat >= 2 && g_vizierSeat <= 13) {
            if (g_vizierGood > 0) {
                BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat) + "：有善良玩家投票");
            }
            else {
                BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat) + "：无善良玩家投票");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【维齐尔·声称】" + BOTC_NameStr(seat));
        }
        if (BOTC_AbilityWorks(seat, 141)) {
            BOTC_PmStore(g_teller, "【维齐尔】" + BOTC_NameStr(seat) + " 拥有可用的维齐尔能力：按他的声称公开票数。");
        }
        else {
            BOTC_PmStore(g_teller, "【维齐尔】" + BOTC_NameStr(seat) + " 中毒/醉酒 → 能力失效，是否公开票数由你裁定。");
        }
    }
    BOTC_Notice(p, "你已公开声称维齐尔。技能为白板，由说书人手工结算。");
}

bool BOTC_VizierMissionaryProtected (int q) {
    if (q < 2 || q > 13 || !BOTC_HasAbility(q, 141)) {
        return false;
    }
    return (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive());
}

void BOTC_VizierSync () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 166] = false;
        if (!g_seatOn[i]) {
            continue;
        }
        if (!BOTC_SeatDead(i) && (BOTC_AbilityWorks(i, 141) || BOTC_VizierMissionaryProtected(i))) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 166] = true;
        }
    }
    // 第一夜之后才出现的新维齐尔立即公开；初始维齐尔由第一个白天统一公开。
    if (g_started && g_dayNum >= 1) {
        BOTC_VizierAnnounce();
    }
}

bool BOTC_VizierDayImmune (int q) {
    if (g_isNight || q < 1 || q > 13) {
        return false;
    }
    if (BOTC_SeatDead(q)) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 166]) {
        return false;
    }
    if (BOTC_VizierMissionaryProtected(q)) {
        return true;               // 相克：被布道失去能力，但白天仍然不会死
    }
    return BOTC_AbilityWorks(q, 141);
}

// 相克：恐惧之灵被唤醒时，把仍具有维齐尔角色的玩家拉进同一条私聊。
void BOTC_VizierFearChat (int fearSeat) {
    int i;
    int s;
    int viz;
    if (fearSeat < 2 || fearSeat > 13) {
        return;
    }
    viz = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && !BOTC_SeatDead(i) && BOTC_HasAbility(i, 141)) {
            viz = i;
        }
    }
    if (viz < 2 || viz == fearSeat) {
        return;
    }
    BOTC_TellerPmTo(fearSeat);
    s = g_mySess[g_teller];
    if (s < 1 || s > 13 || !g_sessAlive[s]) {
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】私聊建立失败：没有可用会话位。");
        return;
    }
    if (!g_member[(s * 14) + g_who[viz]]) {
        BOTC_JoinSess(g_who[viz], s);
    }
    if (g_member[(s * 14) + g_who[viz]]) {
        BOTC_AppendPm(g_who[fearSeat], "【相克】维齐尔也在本私聊中：他得知了恐惧之灵本轮选择的目标。");
        BOTC_AppendPm(g_who[viz], "【相克】恐惧之灵被唤醒，你被拉入本私聊。");
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】已把维齐尔 " + BOTC_NameStr(viz) + " 拉入与恐惧之灵 " + BOTC_NameStr(fearSeat) + " 的私聊。");
        BOTC_RefreshSessListAll();
    }
    else {
        BOTC_PmStore(g_teller, "【维齐尔×恐惧之灵相克】维齐尔加入私聊失败，请手工拉入。");
    }
}

int BOTC_PoppySeat () {
    return BOTC_AbilitySeat(86);
}

//   原生身份、科怪赋予、说书人手工赋予都算；酒鬼认知里的罂粟不算。
//   能力来源中毒 / 醉酒 / 失效时不算。
bool BOTC_PoppyActive () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        if (q >= 2 && !g_seatOn[q]) {
            continue;
        }
        if (q >= 2 && BOTC_SeatDead(q)) {
            continue;                    // 罂粟死亡后不再阻止邪恶互认
        }
        if (BOTC_AbilityWorks(q, 86)) {
            return true;
        }
    }
    return false;
}

// 在真正写入死亡状态之前调用：此时能力状态还是死亡前的真实状态。
// 若罂粟能力正在生效，给他打「唤醒邪恶」token；中毒 / 醉酒死亡时不打。
void BOTC_PoppyDeathMark (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!BOTC_AbilityWorks(q, 86)) {
        return;
    }
    // 【用户 2026-11-06】白天死亡 → 当晚走到罂粟自己的夜序位再互认；
    //   夜间死亡 → 当前玩家行动结束后立刻插入一次互认。
    if (g_isNight) {
        g_poppyEvilNight = g_nightNum;
        if (g_wakeCurrentOrd > 0) {
            g_poppyEvilWaitOrd = g_wakeCurrentOrd;
        }
        else {
            g_poppyEvilWaitOrd = -1;
        }
        BOTC_PmStore(g_teller, "【罂粟种植者】" + BOTC_NameStr(q) + " 夜间死亡 → 当前行动结束后立即插入邪恶互认。");
    }
    else {
        g_poppyEvilNight = g_dayNum + 1;
        g_poppyEvilWaitOrd = 0;
        BOTC_PmStore(g_teller, "【罂粟种植者】" + BOTC_NameStr(q) + " 白天死亡 → 入夜后走到他的夜序位时自动进行邪恶互认。");
    }
    g_poppyEvilPend = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 105] = true;
}

// 登记成某个阵营时「看起来是什么身份」：优先挑这个阵营里**不在场**的身份
//   （这样报出来的身份不会跟真实的配板打架），实在没有就随便挑一个同阵营的。
//   陌客被看成爪牙 / 恶魔、间谍被看成镇民 / 外来者，都靠它给出那张脸。
int BOTC_RoleForTeamNotInPlay (int t) {
    int i;
    int n;
    int pick;
    pick = -1;
    n = 0;
    for (i = 0; i <= 163; i += 1) {
        if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = i;
            }
        }
    }
    if (pick >= 0) {
        return pick;
    }
    n = 0;
    for (i = 0; i <= 163; i += 1) {
        if (BOTC_RoleTeam(i) == t) {
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = i;
            }
        }
    }
    return pick;
}

// 某个座位「自称的身份」（伪装口供）：-1 = 没设。
// 智能说书判定用的就是它：中毒 / 酒鬼的人来查这个座位时，给的是这份口供而不是真身。
int BOTC_SeatClaim (int q) {
    if (q < 2 || q > 13) {
        return -1;
    }
    return g_claim[q];
}

// 参与座位列表的文本（诊断用），形如 "3 4 5 6 7 8 9 10 11"
string BOTC_SeatListStr () {
    int i;
    string s;
    BOTC_BuildSeatList();
    s = "";
    for (i = 0; i < g_seatN; i += 1) {
        if (i > 0) {
            s = s + " ";
        }
        s = s + IntToString(g_seatList[i] - 1);
    }
    return s;
}

//==================================================================================================
// 调查 / 信息类角色的判定（智能说书用；手动模式这些函数也照样能调）
//   核心原则：技能一律看「登记」那一层（间谍/陌客可能被看成别的），不要直接看真实身份。
//==================================================================================================

// 角色标签查询：tag 传单个位（1 / 2 / 4 / 8）
bool BOTC_RoleHasTag (int idx, int tag) {
    if (idx < 0 || idx > 163 || tag <= 0) {
        return false;
    }
    return ((g_roleTag[idx] / tag) % 2) == 1;
}

// 这个座位「现在算不算」某个阵营的人（t：0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）
//   陌客：登记成邪恶（爪牙/恶魔）时就不再算外来者 ---- 图管因此会得到「本局没有外来者」
//   间谍：登记成镇民/外来者时就算那个阵营，否则算爪牙
bool BOTC_SeatCountsAsTeam (int ob, int q, int t) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return false;
    }
    if (r == 15 || r == 18) {
        return (BOTC_PairTeam(ob, q) == t);
    }
    return (BOTC_RoleTeam(r) == t);
}

// 占卜师专用：这个座位在他眼里算不算恶魔。
//   ⚠ 这里**不吃**「中毒 / 酒鬼看反」那一层（BOTC_ViewTeam）：那一层会让每个好人有约 35%
//      的概率被看成恶魔，酒鬼占卜师验谁都是「有恶魔」，假干扰项反而没了意义。
//   所以占卜师这条改成：
//     ① 假干扰项（g_ftFakeSeat，只有智能说书有、玩家看不见）→ 一律算恶魔；
//     ② 真干扰项（g_herring）→ 算恶魔（酒鬼占卜师没有真干扰项）；
//     ③ 中毒 / 酒鬼时**真恶魔永远被看成善良**（包庇恶魔）；
//     ④ 其余按「登记」那一层算（陌客 / 间谍自己的伪装照样会让他看起来像恶魔）。
bool BOTC_RegistersAsDemonToFT (int ob, int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (ob == g_ftFakeOwner) {
        if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
            return true;
        }
    }
    if (q == g_herring) {
        if (!BOTC_SeatIsDrunk(ob)) {
            return true;
        }
    }
    if (BOTC_SeatImpaired(ob)) {
        if (BOTC_SeatTeam(q) == 3) {
            return false;              // 包庇恶魔：真恶魔在他眼里一定是善良
        }
    }
    return (BOTC_PairTeam(ob, q) == 3);
}

// 智能说书通过私聊给某个玩家发信息：进他的私聊日志，同时只对他弹一行字幕
//    ⚠ 第一参数必须是**物理座位**（客户端号）：手里是格子的话要写 g_who[格子]（开局随机座位后两者不同）。
// 【信息】统一标签：同一段文字重复调用时不会叠第二个前缀。
string BOTC_InfoText (string s) {
    int pos;
    pos = StringFind(s, "【信息】", false);
    // StringFind 命中首字符时返回 1（未命中 -1），0 只是兼容写法。
    if (pos == 0 || pos == 1) {
        return s;
    }
    return "【信息】" + s;
}

// 【信息】正文统一加「」（用户 2026-11-04）：只处理以「【信息】你得知」开头的结果。
//   是 / 否 单独成句时分别上蓝 / 红；正文里已经自带「」的消息（如「谁是恶魔」）不再重复包。
string BOTC_InfoWrap (string s) {
    int n;
    int p;
    int pos;
    string body;
    string tail;
    pos = StringFind(s, "【信息】你得知", false);
    // StringFind 命中首字符时返回 1（未命中 -1），0 只是兼容写法。
    if (pos < 0 || pos > 1) {
        return s;
    }
    p = StringLength("【信息】你得知");
    n = StringLength(s);
    if (n <= p) {
        return s;
    }
    body = StringSub(s, p + 1, n);
    tail = "";
    if (StringSub(s, n - 2, n) == "。") {
        body = StringSub(s, p + 1, n - 3);
        tail = "。";
    }
    if (StringLength(body) <= 0) {
        return s;
    }
    if (StringFind(body, "「", false) >= 0) {
        return s;
    }
    if (body == "是") {
        return "【信息】你得知「<c val=\"00BFFF\">是</c>」" + tail;
    }
    if (body == "否") {
        return "【信息】你得知「<c val=\"FF0000\">否</c>」" + tail;
    }
    return "【信息】你得知「" + body + "」" + tail;
}

// 【测试·私聊镜像】（用户 2026-10-21）：只镜像 BOTC_PmInfo 的角色结果，不镜像普通玩家聊天。
//   镜像只写入说书人的私聊窗 / 日志，不弹全桌字幕，也不会把原信息误发给其他玩家。
void BOTC_PmMirrorInfo (int p, string s) {
    int whoBak;
    bool boxBak;
    if (!g_pmInfoMirrorOn || p == g_teller || p < 1 || p > 13) {
        return;
    }
    if (StringLength(s) <= 0) {
        return;
    }
    whoBak = g_chatWhoNow;
    boxBak = g_pmBoxOnlyNow;
    g_chatWhoNow = 0;
    g_pmBoxOnlyNow = false;
    BOTC_PmStore(g_teller, "【私聊镜像·" + BOTC_NameStr(BOTC_PosOf(p)) + "】" + s);
    g_chatWhoNow = whoBak;
    g_pmBoxOnlyNow = boxBak;
}

void BOTC_PmInfo (int p, string s) {
    int whoBak;
    int pos;
    if (p < 1 || p > 13) {
        return;
    }
    // 所有统一写作「你得知…」的角色结果自动加绿色【信息】标签；操作提示不强行套标签。
    pos = StringFind(s, "你得知", false);
    // StringFind 命中首字符时返回 1（未命中 -1），0 只是兼容写法。
    if (pos == 0 || pos == 1) {
        s = BOTC_InfoText(s);
    }
    // 【信息】你得知… 正文统一包进「」，是 / 否 单独成句时分别上蓝 / 红。
    s = BOTC_InfoWrap(s);
    // 【复盘】（用户 2026-11-11）：记下这名玩家收到的信息（「你选择了…」由技能确认单独记一条，这里跳过；
    //   饕餮这类自带面板的选择带【信息】前缀，仍按信息保留）。
    pos = StringFind(s, "你选择了", false);
    if (pos != 1) {
        if (StringLength(s) > 0) {
            BOTC_RpAdd(BOTC_PeriodStr() + "：" + BOTC_NameStr(BOTC_PosOf(p)) + " 收到 " + s);
        }
    }
    // 信息是系统行：保存时把说话人清 0，聊天窗才会走绿色关键词渲染。
    whoBak = g_chatWhoNow;
    g_chatWhoNow = 0;
    BOTC_AppendPm(p, s);
    g_chatWhoNow = whoBak;
    BOTC_PmMirrorInfo(p, s);
    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, BOTC_KeyColor(BOTC_NameSubst(s)));   // 提示条也保留【信息】绿色渲染
}

// 玩家确认技能后，在私聊框回显本人实际选择的目标。
void BOTC_TellRoleChoice (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 163) {
        return;
    }
    // 【复盘】（用户 2026-11-11）：单独选角色的技能也记一条
    BOTC_RpAdd(BOTC_PeriodStr() + "：" + BOTC_NameStr(p) + "（" + BOTC_SeatRoleStr(p) + "）选择了" + g_roleName[role] + "。");
    BOTC_PmInfo(g_who[p], "你选择了" + g_roleName[role] + "。");
}

void BOTC_TellSkillChoice (int p, int role) {
    string s;
    int o1;
    int o2;
    int o3;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_choiceSaid[p]) {
        g_choiceOrigOn = false;
        g_choiceOrigBy = 0;
        return;
    }
    o1 = g_skillT1[p];
    o2 = g_skillT2[p];
    o3 = g_skillT3[p];
    if (g_choiceOrigOn && g_choiceOrigBy == p) {
        o1 = g_choiceOrigT1;
        o2 = g_choiceOrigT2;
        o3 = g_choiceOrigT3;
    }
    s = "";
    if (o1 >= 2) {
        s = BOTC_NameStr(o1);
    }
    if (o2 >= 2) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(o2);
    }
    if (o3 >= 2) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + BOTC_NameStr(o3);
    }
    if (role >= 0 && role <= 163) {
        if (StringLength(s) > 0) {
            s = s + ",";
        }
        s = s + g_roleName[role];
    }
    if (StringLength(s) <= 0) {
        if (g_choiceOrigOn && g_choiceOrigBy == p) {
            g_choiceOrigOn = false;
            g_choiceOrigBy = 0;
        }
        return;
    }
    // 【复盘】（用户 2026-11-11）：所有玩家确认的夜间技能目标 / 角色都记一条
    BOTC_RpAdd(BOTC_PeriodStr() + "：" + BOTC_NameStr(p) + "（" + BOTC_SeatRoleStr(p) + "）选择了" + s + "。");
    BOTC_PmInfo(g_who[p], "你选择了" + s + "。");
    g_choiceSaid[p] = true;
    if (g_choiceOrigOn && g_choiceOrigBy == p) {
        g_choiceOrigOn = false;
        g_choiceOrigBy = 0;
    }
}

// 这次信息要不要说假话：中毒 / 酒鬼的人大概率（g_claimChance%）得到假信息，小概率得到真信息
bool BOTC_InfoIsLie (int ob) {
    if (!BOTC_SeatImpaired(ob)) {
        return false;
    }
    return (RandomInt(1, 100) <= g_claimChance);
}

// 给一个「错的」数字：在 0..3 里挑一个不等于真值的。
//   注意：厨师 / 共情者的假数字已经不靠「另掷一次骰」了 ---- 他们走「中毒 / 酒鬼看到的那一层」
//   （`g_pairVAlign`，一个座位只判一次），厨师再用 BOTC_ChefNear 压回「最多差 1 对」。
//   这条通用的「0..3 乱数」现在没人用，留着给别的数字类判定兜底。
int BOTC_WrongCount (int n) {
    int k;
    int i;
    for (i = 0; i < 32; i += 1) {
        k = RandomInt(0, 3);
        if (k != n) {
            return k;
        }
    }
    if (n == 0) {
        return 1;
    }
    return 0;
}

//==================================================================================================
// 酒鬼 / 中毒的送葬者：专门的概率与算法
//   ① 被处决的人「按登记算」是善良时：第 1 天大概率报他的真身，越往后报真身的概率越低，
//      而且假身份越来越往恶魔那边偏（第 1~2 天偏爪牙、第 3 天爪牙 / 恶魔五五、第 4 天起偏恶魔）；
//   ② 被处决的人「按登记算」是邪恶时：一律藏起来报一张善良身份（恶魔当然也藏），有口供先用口供；
//   ③ 目标如果是陌客 / 间谍，「真身」也是登记那一层的那张脸（干扰先生效）；
//   ④ 一个身份最多只报一次（`g_idUsed`；真身不受这条限制 ---- 他是真的，不能因为重复就改口）。
//==================================================================================================

// 第 day 天「报真身」的概率（百分比）
int BOTC_UtRealChance (int day) {
    if (day <= 1) {
        return 80;
    }
    if (day == 2) {
        return 55;
    }
    if (day == 3) {
        return 35;
    }
    return 25;
}

// 假身份里给「恶魔」的概率（百分比），其余给爪牙 ---- 越往后越容易甩恶魔
int BOTC_UtDemonChance (int day) {
    if (day <= 2) {
        return 20;
    }
    if (day == 3) {
        return 50;
    }
    return 70;
}

// 记住这个身份已经用过了（一个身份最多只报一次）
void BOTC_MarkIdUsed (int r) {
    if (r >= 0 && r <= 163) {
        g_idUsed[r] = true;
    }
}

// 挑一个「还没用过」的假身份：阵营 t（0 镇民 / 1 外来者 / 2 爪牙 / 3 恶魔）。
//   优先挑不在场的，其次随便挑；酒鬼（14）不当假身份用。都没有就返回 -1。
int BOTC_PickFreshFakeRole (int t) {
    int i;
    int n;
    int pick;
    pick = -1;
    n = 0;
    for (i = 0; i <= 163; i += 1) {
        if (i == 14) {
            continue;
        }
        if (BOTC_RoleTeam(i) != t) {
            continue;
        }
        if (g_idUsed[i]) {
            continue;
        }
        if (BOTC_RoleInPlay(i)) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = i;
        }
    }
    if (pick >= 0) {
        return pick;
    }
    n = 0;
    for (i = 0; i <= 163; i += 1) {
        if (i == 14) {
            continue;
        }
        if (BOTC_RoleTeam(i) != t) {
            continue;
        }
        if (g_idUsed[i]) {
            continue;
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = i;
        }
    }
    return pick;
}

// 厨师报的数字：中毒 / 酒鬼看错之后可能跟真值差很远，压回「最多差 1 对」，别给太离谱的
int BOTC_ChefNear (int n, int nt) {
    if (n < nt - 1) {
        if (nt <= 0) {
            return 0;
        }
        return nt - 1;
    }
    if (n > nt + 1) {
        return nt + 1;
    }
    return n;
}

// 挑一个「现在场上没有的善良身份」（镇民 / 外来者）：优先用恶魔手上那 3 个不在场身份。
//   假信息报一个根本不在场的身份，怎么都不会跟真实的配板对上，最不容易穿帮。
//   （现在没人调用了 ---- 送葬者 / 守鸦人改成走「他看错的那一层」，留着备用。）
int BOTC_PickOutOfPlayGood () {
    int i;
    int r;
    g_hintN = 0;
    for (i = 0; i < 3; i += 1) {
        r = g_bluffPick[i] - 1;
        if (r >= 0 && r <= 16) {
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN > 0) {
        return g_fakePool[RandomInt(0, g_hintN - 1)];
    }
    g_hintN = 0;
    for (i = 0; i <= 16; i += 1) {
        if (BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
            g_fakePool[g_hintN] = i;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN > 0) {
        return g_fakePool[RandomInt(0, g_hintN - 1)];
    }
    return BOTC_WrongRole(0);
}

// 假信息里「就是 X」的那一位：优先挑真邪恶的座位（把好人的注意力往邪恶身上引）
//   注意：**恶魔也在候选里** ---- 调查员的假线索点到恶魔是合理的（这游戏本来就是在找恶魔）
//   ob = 提问题的人：他自己不能出现在这条信息里
// 假信息里「就是 X」的那个人。
//   wantGood = false（洗衣妇那类）：优先挑**真邪恶**的座位，把好人往邪恶身上引；
//   wantGood = true （调查员中毒 / 酒鬼）：优先挑**真身善良**的座位 ---- 这样配上后面的陪衬，
//     给出的就是「两个好人」里有一位是爪牙（陌客也算好人，不排除）。
int BOTC_PickFakeSubject (int ob, bool wantGood) {
    int i;
    int q;
    int k;
    int r;
    BOTC_BuildSeatList();
    g_hintN = 0;
    // 【认知覆盖角色优先】（用户 2026-09-20）：酒鬼 / 疯子自己就是「假信息」的好素材 ----
    //   中毒的洗衣妇可以说「酒鬼（以为自己是共情者）和占卜师里有一个是共情者」这种。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (BOTC_CogSeenRole(q) >= 0) {
            g_fakePool[g_hintN] = q;
            g_hintN = g_hintN + 1;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (wantGood) {
            if (BOTC_SeatAlign(q) == 0) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        else {
            if (BOTC_SeatAlign(q) == 1) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i < g_seatN; i += 1) {
            if (g_seatList[i] == ob) {
                continue;
            }
            g_fakePool[g_hintN] = g_seatList[i];
            g_hintN = g_hintN + 1;
        }
    }
    // 没掷中「互动干扰」时，把陌客 / 间谍的座位从池子里剔掉（剔完空了就保持原样）
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            q = g_fakePool[i];
            r = BOTC_SeatTrueRole(q);
            if (r != 15 && r != 18) {
                g_fakePool[k] = q;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0) {
        return 0;
    }
    return g_fakePool[RandomInt(0, g_hintN - 1)];
}

// 假信息里的「陪衬」：另挑一个座位（优先善良的，这一对看起来更像真的）
int BOTC_PickFakePartner (int subj, int ob) {
    int i;
    int q;
    int k;
    int r;
    BOTC_BuildSeatList();
    g_hintN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (q != subj && BOTC_SeatAlign(q) == 0) {
            g_fakePool[g_hintN] = q;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (q != subj) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    // 陪衬也一样：没掷中「互动干扰」就不拿陌客 / 间谍当陪衬
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            q = g_fakePool[i];
            r = BOTC_SeatTrueRole(q);
            if (r != 15 && r != 18) {
                g_fakePool[k] = q;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0) {
        return 0;
    }
    return g_fakePool[RandomInt(0, g_hintN - 1)];
}

// 假信息（洗衣妇 / 调查员 中毒或酒鬼时）：把好人往邪恶身上引 ----
//   ① 「就是 X」的那个人优先挑真邪恶的座位；
//   ② 报的身份优先用恶魔手上那 3 个不在场身份（挑同阵营的），没有就用别的「不在场的同阵营身份」。

//==================================================================================================
// 【认知覆盖角色的「他们以为的身份」】（用户 2026-09-20）：
//   酒鬼（14）和疯子（38）魔典上写的是**他们以为自己是**的那个身份（g_mark），
//   中毒 / 酒鬼的信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母...）可以拿这一份当假信息，
//   也可以把「这个认知覆盖的人」当成被点到的对象（例如中毒的洗衣妇会说「酒鬼（以为自己是共情者）
//   和占卜师里有一个是共情者」）。
//   疯子另外一条：他收到的那 3 个「不在场身份」里，**真正不在场**的那些优先拿来当假信息。
//==================================================================================================
int BOTC_CogSeenRole (int q) {
    int r;
    if (q < 2 || q > 13) {
        return -1;
    }
    r = BOTC_SeatTrueRole(q);
    if (r != 14 && r != 38) {
        return -1;                                  // 只有酒鬼 / 疯子是「认知覆盖」
    }
    r = g_mark[(g_teller * 14) + q] - 1;                         // 他「以为自己是」的那个身份
    if (r < 0 || r > 163) {
        return -1;
    }
    return r;
}

// 疯子（38）收到 / 选好的那 3 个不在场身份里，**真正不在场**的那些（用户要求优先）
void BOTC_PushLunaticBluffs (int t) {
    int i;
    int k;
    int r;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatTrueRole(i) != 38) {
            continue;
        }
        for (k = 0; k < 3; k += 1) {
            // 【按玩家取最新一份】（用户 2026-11-04）：不再读全局的最后一组，避免拿到别人刚发的那 3 个
            r = g_bluffGiveRole[(g_who[i] * 3) + k] - 1;
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != t) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;                           // 只要「真正不在场」的那几个
            }
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
}

void BOTC_PushCogSeenRoles (int t) {
    int i;
    int r;
    for (i = 2; i <= 13; i += 1) {
        r = BOTC_CogSeenRole(i);
        if (r < 0) {
            continue;
        }
        if (BOTC_RoleTeam(r) != t) {
            continue;
        }
        g_fakePool[g_hintN] = r;
        g_hintN = g_hintN + 1;
    }
}

bool BOTC_MakeFakeHint (int ob, int t) {
    int i;
    int r;
    int k;
    if (ob < 1 || ob > 13) {
        return false;
    }
    BOTC_BuildSeatList();
    // 【角色互动干扰概率】中毒 / 酒鬼的信息位报的**身份和点的人**也要过这一关（用户 2026-09-19）：
    //   这次掷中（g_fakeBias = true）才允许出现「互动干扰类」（陌客 15 / 间谍 18），
    //   没掷中就把它们从候选里剔掉 ---- 免得中毒的调查员老是「得知间谍」。
    g_fakeBias = (RandomInt(1, 100) <= g_infoBias);
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    // ① 「就是 X」的人：
    //     调查员（t == 2，找爪牙）→ 优先挑**真身善良**的，凑成「两个好人」给中毒 / 酒鬼的他
    //     其他（洗衣妇那种找镇民的）→ 还是优先挑真邪恶，把好人往邪恶身上引
    g_infoA = BOTC_PickFakeSubject(ob, (t == 2));
    // ② 报什么身份：**先**用「疯子收到的真正不在场身份」+「酒鬼 / 疯子以为的身份」（用户 2026-09-20），
    //   再用原来的「3 个不在场身份 → 不在场身份 → 同阵营随便」那三级兜底
    g_hintN = 0;
    BOTC_PushLunaticBluffs(t);
    BOTC_PushCogSeenRoles(t);
    for (i = 0; i < 3; i += 1) {
        r = g_bluffPick[i] - 1;
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == t) {
            g_fakePool[g_hintN] = r;
            g_hintN = g_hintN + 1;
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i <= 163; i += 1) {
            if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
                g_fakePool[g_hintN] = i;
                g_hintN = g_hintN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        for (i = 0; i <= 163; i += 1) {
            if (BOTC_RoleTeam(i) == t) {
                g_fakePool[g_hintN] = i;
                g_hintN = g_hintN + 1;
            }
        }
    }
    // 报的身份也一样：没掷中「互动干扰」就不报陌客 / 间谍（剔完空了就保持原样）
    if (!g_fakeBias && g_hintN > 1) {
        k = 0;
        for (i = 0; i < g_hintN; i += 1) {
            r = g_fakePool[i];
            if (r != 15 && r != 18) {
                g_fakePool[k] = r;
                k = k + 1;
            }
        }
        if (k > 0) {
            g_hintN = k;
        }
    }
    if (g_hintN <= 0 || g_infoA <= 0) {
        return false;
    }
    g_infoRole = g_fakePool[RandomInt(0, g_hintN - 1)];
    // ③ 陪衬
    g_infoB = BOTC_PickFakePartner(g_infoA, ob);
    return (g_infoA > 0 && g_infoB > 0);
}

// 图书管理员（中毒 / 酒鬼）专用的假信息：
//   ① 场上有酒鬼：报「酒鬼」，而且「酒鬼」这个身份优先安在邪恶玩家的座位上
//      （真外来者的座位不算 ---- 免得跟真实的配板打架；酒鬼自己那个座位可以，
//        他在魔典上显示成镇民）。
//   ② 场上没酒鬼：跟别的假信息一样，报一个不在场的外来者、指向邪恶玩家。
bool BOTC_MakeFakeOutsiderHint (int ob) {
    int i;
    int q;
    int r;
    BOTC_BuildSeatList();
    g_fakeBias = (RandomInt(1, 100) <= g_infoBias);   // 同上：这次允不允许出现互动干扰
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    if (BOTC_RoleInPlay(14)) {
        g_hintN = 0;
        // 认知覆盖的人（酒鬼 / 疯子）先放进来（用户 2026-09-20）
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (BOTC_CogSeenRole(q) >= 0) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;                  // 别把「酒鬼」安在他自己头上
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0) {
                continue;
            }
            // 真外来者（管家 / 陌客 / 圣徒）不算
            if (r == 13 || r == 15 || r == 16) {
                continue;
            }
            if (BOTC_SeatAlign(q) == 1) {
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        if (g_hintN <= 0) {
            // 一个邪恶都没有（很少见）：镇民 / 酒鬼也算进来
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                if (q == ob) {
                    continue;
                }
                r = BOTC_SeatTrueRole(q);
                if (r < 0) {
                    continue;
                }
                if (r == 13 || r == 15 || r == 16) {
                    continue;
                }
                g_fakePool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
        if (g_hintN > 0) {
            g_infoRole = 14;
            g_infoA = g_fakePool[RandomInt(0, g_hintN - 1)];
            g_infoB = BOTC_PickFakePartner(g_infoA, ob);
            return (g_infoA > 0 && g_infoB > 0);
        }
    }
    return BOTC_MakeFakeHint(ob, 1);
}

// 生成「这两个人里有一位是 <某阵营的某个身份>」，结果放在 g_infoRole / g_infoA / g_infoB
//   t = 阵营（0 镇民 / 1 外来者 / 2 爪牙）
//   lie = true（中毒 / 酒鬼）：走「假信息」那一套（指向邪恶 + 用不在场身份），不再套用伪装口供
//   场上有干扰身份（陌客 / 间谍）时，有 g_infoBias% 的额外概率让那个「就是 X」的人是他
// 返回 false = 现在给不出这种信息（场上没人登记成这个阵营）
bool BOTC_MakeTeamHint (int ob, int t, bool lie) {
    int i;
    int q;
    int r;
    int r2;
    int subj;
    BOTC_BuildSeatList();
    g_infoRole = -1;
    g_infoA = 0;
    g_infoB = 0;
    if (lie) {
        // 假信息（中毒 / 酒鬼的情报位）：伪装口供不再参与，改成「指向邪恶 + 用不在场身份」。
        //   图书管理员（外来者）有自己的一套（会优先报「酒鬼」）。
        if (t == 1) {
            return BOTC_MakeFakeOutsiderHint(ob);
        }
        return BOTC_MakeFakeHint(ob, t);
    }
    // 第一步：找出算这个阵营的人，顺便记下其中的干扰身份
    g_hintN = 0;
    g_hintBiasN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;                  // 「其中一位是 X」不能把提问题的人自己算进去
        }
        if (BOTC_SeatCountsAsTeam(ob, q, t)) {
            g_hintPool[g_hintN] = q;
            g_hintN = g_hintN + 1;
            r = BOTC_SeatTrueRole(q);
            if (r == 15 || r == 18) {
                g_hintBiasPool[g_hintBiasN] = q;
                g_hintBiasN = g_hintBiasN + 1;
            }
        }
    }
    if (g_hintN <= 0) {
        return false;
    }
    // 第二步：挑「就是 X」的那个人（有干扰身份时按概率优先指向他）
    subj = g_hintPool[RandomInt(0, g_hintN - 1)];
    if (g_hintBiasN > 0) {
        if (RandomInt(1, 100) <= g_infoBias) {
            subj = g_hintBiasPool[RandomInt(0, g_hintBiasN - 1)];
        }
    }
    // 第三步：报什么身份 ---- 真身就是这阵营就用真身；是登记成别的阵营（陌客 / 间谍），
    //   就用「他在这个观察者眼里是什么身份」（跟送葬者 / 守鸦人报的保持一致）；
    //   再不行才挑一个不在场的同阵营身份
    r = BOTC_SeatTrueRole(subj);
    if (BOTC_RoleTeam(r) == t) {
        g_infoRole = r;
    }
    else {
        r2 = BOTC_PairSeenRole(ob, subj);
        if (r2 >= 0 && r2 <= 163 && r2 != r && BOTC_RoleTeam(r2) == t) {
            g_infoRole = r2;
        }
        else {
            g_hintN = 0;
            for (i = 0; i <= 163; i += 1) {
                if (BOTC_RoleTeam(i) == t && BOTC_BoardHasRole(i) && !BOTC_RoleInPlay(i)) {
                    g_hintPool[g_hintN] = i;
                    g_hintN = g_hintN + 1;
                }
            }
            if (g_hintN > 0) {
                g_infoRole = g_hintPool[RandomInt(0, g_hintN - 1)];
            }
            else {
                g_infoRole = r;
            }
        }
    }
    // 第四步：另一个陪衬 ---- 优先挑「不算这个阵营」的人，让这条信息更像真的
    g_hintN = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ob) {
            continue;
        }
        if (q != subj) {
            if (!BOTC_SeatCountsAsTeam(ob, q, t)) {
                g_hintPool[g_hintN] = q;
                g_hintN = g_hintN + 1;
            }
        }
    }
    g_infoA = subj;
    if (g_hintN > 0) {
        g_infoB = g_hintPool[RandomInt(0, g_hintN - 1)];
    }
    else {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == ob) {
                continue;
            }
            if (q != subj) {
                g_infoB = q;
            }
        }
    }
    return (g_infoA > 0 && g_infoB > 0);
}

// 厨师：相邻两个都算邪恶的「对数」
//   useView = true 时用「中毒 / 酒鬼看到的那一层」（按观察者算，只在把某个人看错的座位上不同）
int BOTC_ChefCount (int ob, bool useView) {
    int i;
    int a;
    int b;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (BOTC_SeeAlign(ob, a, useView) == 1 && BOTC_SeeAlign(ob, b, useView) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 厨师：**真身口径**的「相邻邪恶对数」----不看登记 / 干扰那一层。
//   专门给说书人自己对账用：真身 3 连坐（例如 10、11、12 全邪恶）这里就是 2 对，
//   而厨师实际听到的数字走登记层（间谍被洗白就少一对），两个数不一样是正常的。
int BOTC_ChefCountTrue () {
    int i;
    int a;
    int b;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (BOTC_SeatAlign(a) == 1 && BOTC_SeatAlign(b) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 把「相邻邪恶」的那几对写成文字： (玩家10+玩家11) (玩家11+玩家12)
//   trueLayer = true 按真身算；false 按「观察者 ob 眼里的登记」算
string BOTC_ChefPairStr (int ob, bool trueLayer) {
    int i;
    int a;
    int b;
    int ea;
    int eb;
    string s;
    bool first;
    BOTC_BuildSeatList();
    s = "";
    first = true;
    for (i = 0; i < g_seatN; i += 1) {
        a = g_seatList[i];
        b = g_seatList[(i + 1) % g_seatN];
        if (trueLayer) {
            ea = BOTC_SeatAlign(a);
            eb = BOTC_SeatAlign(b);
        }
        else {
            ea = BOTC_PairAlign(ob, a);
            eb = BOTC_PairAlign(ob, b);
        }
        if (ea == 1 && eb == 1) {
            if (first) {
                s = "(" + BOTC_NameStr(a) + "+" + BOTC_NameStr(b) + ")";
                first = false;
            }
            else {
                s = s + " (" + BOTC_NameStr(a) + "+" + BOTC_NameStr(b) + ")";
            }
        }
    }
    if (first) {
        return "没有";
    }
    return s;
}

// 厨师诊断用：列出「真身和登记不一样」的座位（间谍被洗白 / 陌客被抹黑那种）
string BOTC_ChefOddStr (int ob) {
    int i;
    int q;
    int r;
    int sr;
    string s;
    bool first;
    BOTC_BuildSeatList();
    s = "";
    first = true;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        if (r < 0) {
            continue;                      // 这个座位还没发身份：跳过，别让 g_roleName 越界
        }
        sr = BOTC_PairSeenRole(ob, q);
        if (sr >= 0 && sr != r) {
            if (first) {
                s = BOTC_NameStr(q) + "＝" + g_roleName[r] + "→被看成 " + g_roleName[sr] + "（" + BOTC_RoleTagStr(sr) + "）";
                first = false;
            }
            else {
                s = s + "｜" + BOTC_NameStr(q) + "＝" + g_roleName[r] + "→被看成 " + g_roleName[sr] + "（" + BOTC_RoleTagStr(sr) + "）";
            }
        }
    }
    if (first) {
        return "没有";
    }
    return s;
}

// 共情者：左右两边最近的两个「活着的」玩家里，有几个算邪恶（自己死了返回 -1）
// 本局真正邪恶的人数（爪牙 + 恶魔）---- 共情者的「邪恶名额」上限就用它
int BOTC_EvilCountTrue () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAlign(q) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 酒鬼 / 中毒的共情者已经用掉几个「邪恶名额」
int BOTC_EmpMarkCount () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_empMark[i]) {
            n = n + 1;
        }
    }
    return n;
}

// 这个座位在酒鬼 / 中毒的共情者眼里算不算邪恶（带名额限制）。
//   **只有「正常的善良身份被他看错成邪恶」才占名额**：
//     ① 真身是邪恶 → 照报邪恶，但不占名额（那不是"看错"，本来就有这么多邪恶）；
//     ② 真身善良、但登记层是邪恶（陌客那种自己的干扰）→ 照报邪恶，也不占名额；
//     ③ 真身善良、登记层也善良 → 那就是他被中毒 / 酒鬼影响看错了，**占名额**；
//        名额用完（= 本局邪恶人数）以后再遇到这种座位，一律当善良报。
//   之前已经占过名额的座位会一直沿用。
bool BOTC_EmpSeatEvil (int me, int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (BOTC_ViewAlign(me, q) != 1) {
        return false;                  // 他眼里这个是善良，不用讨论
    }
    if (BOTC_SeatAlign(q) != 0) {
        return true;                   // 真身就是邪恶：照报，不占名额
    }
    if (BOTC_PairAlign(me, q) != 0) {
        return true;                   // 陌客 / 间谍自己造成的「邪恶」：照报，不占名额
    }
    if (g_empMark[q]) {
        return true;
    }
    if (BOTC_EmpMarkCount() >= BOTC_EvilCountTrue()) {
        return false;                  // 名额用完了：看错成邪恶也只能当善良
    }
    g_empMark[q] = true;
    return true;
}

// 酒鬼 / 中毒共情者最终报出来的数「几个邪恶」（带名额限制）
int BOTC_EmpathCountCapped (int me) {
    int l;
    int r;
    int n;
    n = 0;
    l = BOTC_EmpathNeighbor(me, -1);
    r = BOTC_EmpathNeighbor(me, 1);
    if (l > 0) {
        if (BOTC_EmpSeatEvil(me, l)) {
            n = n + 1;
        }
    }
    if (r > 0) {
        if (BOTC_EmpSeatEvil(me, r)) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_EmpathCount (int ob, int me, bool useView) {
    int i;
    int k;
    int q;
    int n;
    int left;
    int right;
    BOTC_BuildSeatList();
    if (BOTC_SeatDead(me)) {
        return -1;
    }
    k = -1;
    for (i = 0; i < g_seatN; i += 1) {
        if (g_seatList[i] == me) {
            k = i;
        }
    }
    if (k < 0 || g_seatN < 2) {
        return 0;
    }
    left = 0;
    right = 0;
    i = (k + g_seatN - 1) % g_seatN;
    for (q = 0; q < g_seatN; q += 1) {
        if (left > 0) {
            q = g_seatN;
        }
        else {
            if (BOTC_SeatDead(g_seatList[i])) {
                i = (i + g_seatN - 1) % g_seatN;
            }
            else {
                left = g_seatList[i];
            }
        }
    }
    i = (k + 1) % g_seatN;
    for (q = 0; q < g_seatN; q += 1) {
        if (right > 0) {
            q = g_seatN;
        }
        else {
            if (BOTC_SeatDead(g_seatList[i])) {
                i = (i + 1) % g_seatN;
            }
            else {
                right = g_seatList[i];
            }
        }
    }
    n = 0;
    if (left > 0) {
        if (BOTC_SeeAlign(ob, left, useView) == 1) {
            n = n + 1;
        }
    }
    if (right > 0) {
        if (BOTC_SeeAlign(ob, right, useView) == 1) {
            n = n + 1;
        }
    }
    return n;
}

// 共情者的一个邻居：dir = -1 左边 / +1 右边，返回座位号（没有就 0）。
//   跳过死人 ---- 和 BOTC_EmpathCount 的「最近的两个活人」保持一致。
int BOTC_EmpathNeighbor (int me, int dir) {
    int i;
    int k;
    int q;
    BOTC_BuildSeatList();
    if (me < 2 || me > 13 || g_seatN < 2) {
        return 0;
    }
    k = -1;
    for (i = 0; i < g_seatN; i += 1) {
        if (g_seatList[i] == me) {
            k = i;
        }
    }
    if (k < 0) {
        return 0;
    }
    i = (k + dir + g_seatN) % g_seatN;
    for (q = 1; q < g_seatN; q += 1) {
        if (!BOTC_SeatDead(g_seatList[i])) {
            return g_seatList[i];
        }
        i = (i + dir + g_seatN) % g_seatN;
    }
    return 0;
}

// 共情者身边的邻居里有没有陌客（索引 15）：
//   有陌客在场时才允许把假信息说成「2 个邪恶」---- 陌客本来就可能被看成邪恶，说得通；
//   没有陌客还给 2，那这条信息基本就是明摆着告诉他自己是酒鬼。
bool BOTC_EmpathNeighborIsRecluse (int me) {
    int a;
    int b;
    a = BOTC_EmpathNeighbor(me, -1);
    b = BOTC_EmpathNeighbor(me, 1);
    if (a > 0 && BOTC_SeatTrueRole(a) == 15) {
        return true;
    }
    if (b > 0 && BOTC_SeatTrueRole(b) == 15) {
        return true;
    }
    return false;
}

//==================================================================================================
// 【诊断】往说书人私聊日志里写细节，方便测试时核对「陌客 / 间谍的干扰有没有生效」。
//   只写说书人日志（玩家看不到），所以可以放心把真身写出来。
//==================================================================================================

// 这个座位现在是清醒 / 中毒 / 酒鬼（诊断文案用）
string BOTC_DiagStateStr (int q) {
    if (!g_debugOn) {
        return "";
    }
    if (BOTC_SeatIsDrunk(q)) {
        return "酒鬼";
    }
    if (BOTC_SeatIsPoisoned(q)) {
        return "中毒";
    }
    return "清醒";
}

// 这次信息是真话还是假话（lie 传「这条答案跟登记层不一样」）
string BOTC_DiagLie (int ob, bool lie) {
    string who;
    if (!BOTC_SeatImpaired(ob)) {
        return "真信息（他清醒）";
    }
    who = BOTC_DiagStateStr(ob);
    if (lie) {
        return "假信息（他是" + who + "）";
    }
    return "真信息（他是" + who + "，这次掷到真话）";
}

// 这个座位在「观察者 ob」眼里是什么样（简短版，一行放得下）：
//   普通座位 =「玩家3＝共情者」；陌客 / 间谍额外写这次有没有被当成别的身份
string BOTC_DiagSeat (int ob, int q) {
    int r;
    int t;
    int sr;
    string s;
    if (q < 2 || q > 13) {
        return "（无）";
    }
    r = BOTC_SeatTrueRole(q);
    if (r < 0) {
        return BOTC_NameStr(q) + "＝未定";
    }
    s = BOTC_NameStr(q) + "＝" + g_roleName[r];
    if (BOTC_SeatImpaired(ob)) {
        // 中毒 / 酒鬼：他「看错」的座位是固定下来的，这里写的就是他眼里的样子
        t = BOTC_ViewTeam(g_who[ob], q);
        sr = BOTC_ViewSeenRole(g_who[ob], q);
        if (t == BOTC_RoleTeam(r) && sr == r) {
            return s + "（没看错）";
        }
        if (sr >= 0 && sr <= 163) {
            return s + "→他看成 " + g_roleName[sr] + "（" + BOTC_TeamName(t) + "·" + BOTC_AlignName(BOTC_ViewAlign(ob, q)) + "）";
        }
        return s + "→看成别的身份";
    }
    if (r == 15 || r == 18) {
        t = BOTC_PairTeam(g_who[ob], q);
        if (t == BOTC_RoleTeam(r)) {
            s = s + "（没被当成别的）";
        }
        else {
            sr = BOTC_PairSeenRole(g_who[ob], q);
            if (sr >= 0 && sr <= 163) {
                s = s + "→看成 " + g_roleName[sr] + "（" + BOTC_TeamName(t) + "·" + BOTC_AlignName(BOTC_PairAlign(ob, q)) + "）";
            }
            else {
                s = s + "→被当成别的身份";
            }
        }
    }
    return s;
}

// 【诊断】单独一行写进说书人私聊日志。为了不让日志变长、也不要一行太长被界面截掉，
//   只有「本人中毒 / 酒鬼」「涉及陌客 / 间谍」「涉及占卜师干扰项」时才写。
//   a / b 是这条信息涉及的座位（没有就传 0）。
void BOTC_DiagSeatLine (string tag, int ob, bool lie, int a, int b) {
    int ra;
    int rb;
    bool hasHerring;
    string s;
    ra = -1;
    rb = -1;
    hasHerring = false;
    if (a >= 2 && a <= 13) {
        ra = BOTC_SeatTrueRole(a);
    }
    if (b >= 2 && b <= 13) {
        rb = BOTC_SeatTrueRole(b);
    }
    if (g_herring >= 2) {
        // 酒鬼占卜师没有真干扰项（只有那 2 个假干扰项），诊断里也不用提
        if (!BOTC_SeatIsDrunk(ob)) {
            if (a == g_herring || b == g_herring) {
                hasHerring = true;
            }
        }
    }
    if (!BOTC_SeatImpaired(ob) && ra != 15 && ra != 18 && rb != 15 && rb != 18 && !hasHerring) {
        return;
    }
    s = "【诊断·" + tag + "】" + BOTC_DiagLie(ob, lie);
    if (a >= 2 && a <= 13) {
        s = s + "｜" + BOTC_DiagSeat(ob, a);
    }
    if (b >= 2 && b <= 13) {
        s = s + "｜" + BOTC_DiagSeat(ob, b);
    }
    if (hasHerring) {
        s = s + "｜干扰项 " + BOTC_HerringStr();
    }
    BOTC_DiagStore(g_teller, s);
}

// 厨师专用诊断（写说书人私聊日志）：说书人问得最多的一句就是
//   「为什么厨师报的对数跟我数的真身对数不一样」---- 因为厨师走的是**登记层**，
//   间谍被当成善良就会少一对、陌客被当成邪恶就会多一对。
//   这里把「真身几对 / 登记后几对 / 两个数字各自是哪几对 / 谁被当成别的身份」全写清楚。
//   没有干扰（登记 = 真身）而且他没中毒 / 酒鬼 时不写，免得刷屏。
void BOTC_DiagChefLine (int ob, int nRep, int ntReg) {
    int t;
    string s;
    t = BOTC_ChefCountTrue();
    if (t == ntReg && nRep == ntReg && !BOTC_SeatImpaired(ob)) {
        return;
    }
    s = "【诊断厨师】" + BOTC_DiagLie(ob, nRep != ntReg) + "｜真身相邻邪恶 " + IntToString(t) + " 对：" + BOTC_ChefPairStr(ob, true);
    BOTC_DiagStore(g_teller, s);
    s = "【诊断厨师】登记后 " + IntToString(ntReg) + " 对：" + BOTC_ChefPairStr(ob, false) + "｜他实际被告知 " + IntToString(nRep) + " 对";
    BOTC_DiagStore(g_teller, s);
    s = "【诊断厨师】登记与真身不一致：" + BOTC_ChefOddStr(ob);
    BOTC_DiagStore(g_teller, s);
}

// 占卜师诊断里对一个座位的描述：真身 + 登记阵营 + 是不是（假 / 真）干扰项
string BOTC_DiagFtSeat (int ob, int q) {
    int r;
    string s;
    if (q < 2 || q > 13) {
        return "（无）";
    }
    r = BOTC_SeatTrueRole(q);
    s = BOTC_NameStr(q) + "＝" + BOTC_RoleNameSafe(r) + "（" + BOTC_TeamName(BOTC_PairTeam(ob, q)) + "）";
    if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
        s = s + "·假干扰项";
    }
    else {
        if (q == g_herring) {
            if (!BOTC_SeatIsDrunk(ob)) {
                s = s + "·真干扰项";
            }
        }
    }
    return s;
}

// 占卜师专用诊断行：写清楚「他是什么状态、报了什么、两个座位各是什么」
void BOTC_DiagFtLine (int ob, int a, int b, bool demon, bool realDemon) {
    string s;
    s = "【诊断占卜师】" + BOTC_DiagStateStr(ob) + "｜报 " + BOTC_YesNoStr(demon) + "（真值 " + BOTC_YesNoStr(realDemon) + "）";
    s = s + "｜" + BOTC_DiagFtSeat(ob, a) + "｜" + BOTC_DiagFtSeat(ob, b);
    BOTC_DiagStore(g_teller, s);
}

// 诊断用：占卜师那条「有 / 没」的真值
string BOTC_YesNoStr (bool b) {
    if (b) {
        return "有恶魔";
    }
    return "没恶魔";
}

// 把一个身份索引渲染成给玩家看的文案（送葬者 / 守鸦人的答案走这里）：
// 身份索引 -> 名字（越界给「未定」，诊断文案用）
string BOTC_RoleNameSafe (int r) {
    if (r < 0 || r > 163) {
        return "未定";
    }
    return g_roleName[r];
}

// 送葬者专用诊断行：把「真身 / 登记层看到什么 / 实际报的是什么」都写清楚 ----
//   普通那行【诊断】写的是「他看错的那一层」，那是给占卜师 / 共情者 / 厨师用的，
//   送葬者（尤其是酒鬼 / 中毒的）不吃那一层，所以单独写。
void BOTC_DiagUtLine (int q, bool lie, int t, int r2, int rp, int day) {
    string s;
    if (!BOTC_SeatImpaired(q)) {
        s = "【诊断送葬者】清醒";
    }
    else {
        if (lie) {
            s = "【诊断送葬者】假信息（他是" + BOTC_DiagStateStr(q) + "）";
        }
        else {
            s = "【诊断送葬者】真信息（他是" + BOTC_DiagStateStr(q) + "）";
        }
    }
    s = s + "｜第" + IntToString(day) + "天｜" + BOTC_NameStr(t) + " 真身 " + BOTC_RoleNameSafe(BOTC_SeatTrueRole(t));
    if (r2 != BOTC_SeatTrueRole(t)) {
        s = s + "，登记层看到 " + BOTC_RoleNameSafe(r2);   // 陌客 / 间谍被当成别的身份
    }
    else {
        s = s + "，登记层没被伪装";
    }
    s = s + "｜报的是 " + BOTC_RoleNameSafe(rp);
    BOTC_DiagStore(g_teller, s);
}

// 把一个身份索引渲染成给玩家看的文案（送葬者 / 守鸦人的答案走这里）：
//   跟这个座位的真身一致时沿用 BOTC_SeatRoleStr（说书人提示里会给酒鬼带「（酒鬼）」后缀），
//   是伪装 / 看错的身份就直接报那个名字；
//   例外：报出来的就是这个座位**真的是酒鬼**时，只写「酒鬼」，不带他以为自己是的那张皮
string BOTC_RoleTextStr (int q, int r) {
    if (r < 0 || r > 163) {
        return "未定";
    }
    if (r == 14) {
        return g_roleName[14];         // 酒鬼：只报「酒鬼」，不带他以为自己是的那张皮
    }
    if (r == 38) {
        return g_roleName[38];         // 疯子：同理，只报「疯子」（用户 2026-09-20）
    }
    if (r == BOTC_SeatTrueRole(q)) {
        return BOTC_SeatRoleStr(q);
    }
    return g_roleName[r];
}

// 诊断用：干扰项（占卜师）现在挂在谁头上
string BOTC_HerringStr () {
    if (g_herring >= 2 && g_herring <= 13) {
        return BOTC_NameStr(g_herring);
    }
    return "无";
}

// 【中毒 / 酒鬼也留真信息 token】（用户 2026-09-19）：先算一遍「他本来应该得知的」那条信息，
//   在**说书人那份魔典**上打上命中 / 错误的 token；打完之后 g_infoA / g_infoB / g_infoRole
//   会被调用方随后的「假信息」重算覆盖掉，所以这里只是顺手留个底。
//   lie = false（本来就该说真话）时什么都不做 ---- 正常流程自己会打；
//   **酒鬼不补**（酒鬼本身不是镇民，见 BOTC_MarkInfoTokens 里的说明）。
void BOTC_MarkTrueInfoTokens (int who, int t, bool lie) {
    if (!lie) {
        return;
    }
    if (who < 2 || who > 13) {
        return;
    }
    if (BOTC_SeatIsDrunk(who)) {
        return;                        // 酒鬼：不补真信息 token
    }
    if (BOTC_MakeTeamHint(who, t, false)) {
        BOTC_MarkInfoTokens(who, t, false);
    }
}

// 「其中一位是 X」这类信息：算好后私聊发给本人，同时给说书人记一行（带诊断）

// 【智能说书】「其中一位是 X」这类信息报完之后，在**说书人那份魔典**上补 token ----
//   这样结算 / 复盘（公开魔典）时能一眼看出当时这条信息是怎么给的（用户 2026-09-16 要求）：
//     洗衣妇（t = 0）：命中那位打 token 0「镇民（洗衣妇）」、陪衬那位打 token 1「错误（洗衣妇）」
//     图书管理员（t = 1）：token 2 / 3        调查员（t = 2）：token 4 / 5
//   ⚠ 命中那位 = g_infoA（就是「就是 X」的那个人）；g_infoB 是陪衬。
//   ⚠ 传 lie = true（这是**假信息**）时直接不打；传 lie = false 就照打 ----
//     用户 2026-09-19 改的：**中毒的人**也要在魔典上留下「他本来应该得知的」那条 token
//     （由 BOTC_MarkTrueInfoTokens 先把真信息算一遍再调这里）。
//   ⚠ **酒鬼不一样**（用户 2026-09-19）：酒鬼本身就不是镇民（魔典上写的是他「以为」的身份），
//     所以酒鬼一律不打 token。厨师（t = 3）是数字信息，本来就没有 token，不打。
void BOTC_MarkInfoTokens (int ob, int t, bool lie) {
    int tok;
    if (lie) {
        return;                        // 假信息：不打（真信息由 BOTC_MarkTrueInfoTokens 那边补）
    }
    if (ob < 2 || ob > 13) {
        return;
    }
    if (BOTC_SeatIsDrunk(ob)) {
        return;                        // 酒鬼：本来就不是镇民，不打 token（用户 2026-09-19）
    }
    if (g_infoA < 2 || g_infoA > 13 || g_infoB < 2 || g_infoB > 13) {
        return;
    }
    if (t == 0) {
        tok = 0;                       // 镇民（洗衣妇）
    }
    else {
        if (t == 1) {
            tok = 2;                   // 外来者（图管）
        }
        else {
            if (t == 2) {
                tok = 4;               // 爪牙（调查员）
            }
            else {
                return;                // 厨师那种数字信息：不打
            }
        }
    }
    g_tokOn[(((g_teller * 14) + g_infoA) * 256) + tok] = true;        // 命中那位：镇民 / 外来者 / 爪牙（对应角色）
    g_tokOn[(((g_teller * 14) + g_infoB) * 256) + tok + 1] = true;    // 陪衬那位：错误（同角色）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "已按这条信息在魔典打上 token：" + BOTC_NameStr(g_infoA) + "＝" + g_tokName[tok] + "；" + BOTC_NameStr(g_infoB) + "＝" + g_tokName[tok + 1] + "。");
}

// 第一夜：智能说书把被动信息类角色的信息私聊发给他们
// 【智能说书】轮到他被唤醒时，把他该知道的信息私聊给他（先唤醒 → 再给信息 → 再选目标/收回）
//   洗衣服 / 图书管理员 / 调查员 / 厨师 / 共情者 = 首夜信息；送葬者 = 今天被处决的人；间谍 = 看魔典

//==================================================================================================
// 【智能说书】邪恶阵营互通信息（这不是唤醒，不记作唤醒）：恶魔知道爪牙是谁（不说他们的具体角色），
//   爪牙知道恶魔和其他爪牙是谁；顺便把 3 个「不在场身份」发给恶魔（新恶魔诞生时再抽一次）。
//==================================================================================================


// 打开「自称身份」面板：ob = 谁来选（说书人 1 或邪恶玩家自己），who = 给哪个座位设
// 邪恶玩家自己设的时候，面板里只留善良身份（镇民 / 外来者），因为他们要伪装成好人。
void BOTC_ClaimOpen (int ob, int who) {
    if (who < 2 || who > 13) {
        return;
    }
    // 【真人说书不开放伪装身份】（用户 2026-09-20）：那个按钮本来只给邪恶玩家，但真人说书时伪装由说书人自己安排
    BOTC_Notice(ob, "真人说书：伪装身份由说书人自己安排，不需要你选。");
    return;
    g_pickMode[ob] = 2;
    g_pickWho[ob] = who;
    if (ob == g_teller) {
    libNtve_gf_SetDialogItemText(g_pickTitle, BOTC_PlayerNameText(who) + StringToText(" 自称的身份（伪装）"), PlayerGroupSingle(ob));
        BOTC_PickFilter(ob, false);
    }
    else {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("我自称的身份（只能挑善良身份）"), PlayerGroupSingle(ob));
        BOTC_PickFilter(ob, true);
    }
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(ob), true);
}

// 身份面板里哪些按钮可见：goodOnly = 只留善良身份（镇民 / 外来者）
// 教父（39）的配比方向：+1 = 外来者 +1 / 镇民 -1；-1 = 反过来（用户 2026-09-20 手动指定）
// 銆愭皵鐞冮┚椹跺憳锛?2锛夌殑閰嶆瘮鏂瑰悜銆戯紙鐢ㄦ埛 2026-09-23锛夛細璺熸暀鐖堕偅濂椾竴涓€瀵瑰簲锛屽彧鏄礋鏂瑰悜鏄€?0銆嶄笉鏄€?1銆?---
//   （这一行是上一次写入时的乱码注释，已清理：用户 2026-09-23）
// 【气球驾驶员（72）的配比方向】（用户 2026-09-23）：跟教父那套一一对应，只是负方向是「+0」不是「-1」----
//   plus = true  → 外来者 +1、镇民 -1
//   plus = false → 什么都不动（+0）
void BOTC_BalPickSet (int p, bool plus) {
    if (p != g_teller) {
        return;
    }
    g_balPlus = plus;
    g_balPlusSeeded = true;        // 手动指定过就不再让发牌那边掷 50/50
    if (plus) {
        BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
        BOTC_Notice(g_teller, "气球驾驶员配比：外来者 +1、镇民 -1。");
    }
    else {
        BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
        BOTC_Notice(g_teller, "气球驾驶员配比：镇民不变。");
    }
}
void BOTC_GfPickSet (int p, bool plus) {
    if (p != g_teller) {
        return;
    }
    g_gfPlus = plus;
    g_gfPlusSeeded = true;                       // 手动指定过就不再让发牌那边掷 50/50
    BOTC_RsQuotaUpdate();
    BOTC_RsRender(g_teller);                            // 手动配板那边的名额文字跟着刷一遍
    if (plus) {
        BOTC_Notice(g_teller, "教父配比：外来者 +1、镇民 -1。");
        // （这行「【教父】说书人手动指定配比方向：…」已按用户 2026-09-23 要求删掉）
    }
    else {
        BOTC_Notice(g_teller, "教父配比：外来者 -1、镇民 +1。");
        // （这行「【教父】说书人手动指定配比方向：…」已按用户 2026-09-23 要求删掉）
    }
}

// 【小精灵】按角色找「在场且活着」的玩家座位（真身 = r 的第一个存活座位；没有 = 0）
int BOTC_PixieLiveSeatOf (int r) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        if (BOTC_SeatDead(i)) { continue; }
        if (BOTC_SeatTrueRole(i) == r) { return i; }
    }
    return 0;
}

// 【悟道者（118）】（用户 2026-11-12）：身份网格里是否还有「不在场」的合法候选。
//   一个都没有时放开不在场限制，避免技能面板一个可点的格子都没有。
bool BOTC_WudHasOutsideOutsider () {
    int i;
    int r;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 1 || r == 14 || r == 38) {
            continue;                      // 只要外来者，且酒鬼 / 疯子不能当
        }
        if (!BOTC_RoleTrueInPlay(r)) {
            return true;
        }
    }
    return false;
}

bool BOTC_WudHasOutsideTownsfolk () {
    int i;
    int j;
    int r;
    int n;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) != 0 || r == 118 || (r >= 143 && r <= 146)) {
            continue;
        }
        // 【相克：悟道者 × 村夫】场上村夫已有 3 人时不能再变成村夫。
        if (r == 105) {
            n = 0;
            for (j = 2; j <= 13; j += 1) {
                if (g_seatOn[j] && BOTC_SeatTrueRole(j) == 105) {
                    n = n + 1;
                }
            }
            if (n >= 3) {
                continue;
            }
        }
        if (!BOTC_RoleTrueInPlay(r)) {
            return true;
        }
    }
    return false;
}

// 技能专用角色网格的限制：翻页后也必须继续生效。
bool BOTC_PickModeRoleAllowed (int p, int r) {
    int mode;
    int seat;
    int i;
    int cnt;
    if (p < 1 || p > 13 || r < 0 || r > 163) {
        return false;
    }
    mode = g_pickMode[p];
    // 【小精灵选镇民】（用户 2026-11-10）：网格只列在场且活着、真实身份是镇民的角色。
    if (mode == 12 && g_miRole == 86) {
        if (g_roleTeam[r] != 0) {
            return false;
        }
        return (BOTC_PixieLiveSeatOf(r) >= 2);
    }
    if (mode == 3) {
        return BOTC_CanDeathClaimRole(r, BOTC_PosOf(p));
    }
    if (mode == 9 && g_philoKind == 118) {
        return (r != 14 && r != 38);
    }
    if (mode == 16 && g_cerenRole == 118) {
        return (r != 14 && r != 38);
    }
    // 【悟道者（118）· 首夜「以为的外来者」】（用户 2026-11-12）：只能是酒鬼 / 疯子以外的外来者，
    //   并且优先要求未出场；整张板子都没有未出场的外来者时放开限制，避免面板无格可点。
    if (mode == 26) {
        if (r == 14 || r == 38) {
            return false;
        }
        if (BOTC_RoleTeam(r) != 1) {
            return false;
        }
        return (!BOTC_WudHasOutsideOutsider() || !BOTC_RoleTrueInPlay(r));
    }
    // 【悟道者（118）· 被邪恶能力碰后变身】（用户 2026-11-12）：只能变成不在场的镇民；
    //   不列悟道者自己 / 全员追忆占位身份；村夫不足 3 人时才可以变。
    if (mode == 27) {
        if (BOTC_RoleTeam(r) != 0) {
            return false;
        }
        if (r == 118 || (r >= 143 && r <= 146)) {
            return false;
        }
        if (r == 105) {
            cnt = 0;
            for (i = 2; i <= 13; i += 1) {
                if (g_seatOn[i] && BOTC_SeatTrueRole(i) == 105) {
                    cnt = cnt + 1;
                }
            }
            if (cnt >= 3) {
                return false;
            }
        }
        return (!BOTC_WudHasOutsideTownsfolk() || !BOTC_RoleTrueInPlay(r));
    }
    if (mode == 20) {
        return (r == 18 || r == 75);
    }
    // 【炼金术士 × 蛊雕】：炼金术士不能借用蛊雕能力。
    if (mode == 21 && r == 162) {
        return false;
    }
    // 【炼金术士 × 提线木偶】：相克，炼金术士无法获得提线木偶能力，直接从选择里剔除。
    if ((mode == 21 || mode == 36) && r == 93) {
        return false;
    }
    if (mode == 22) {
        seat = BOTC_SeatOfRole(r);
        return (seat >= 2 && seat <= 13 && !BOTC_SeatDead(seat));
    }
    if (mode == 23) {
        seat = BOTC_SeatOfRole(r);
        return ((seat >= 2 && seat <= 13) || BOTC_SeatTrueRole(1) == r);
    }
    if (mode == 41 && BOTC_ActRoleOf(g_pickWho[p]) == 150) {
        return BOTC_SummonerCanUseRole(r);
    }
    if (mode == 32) {
        return BOTC_BoffinRoleAllowed(r);
    }
    // 【疯子·假能力】（用户 2026-11-10）：只列镇民和外来者。
    if (mode == 33) {
        return (BOTC_LunFakeRoleAllowed(r) == 1);
    }
    if (mode == 35) {
        return (BOTC_RoleAlign(r) == 0 && r != 56 && r != 95);
    }
    // 【瘟疫医生（137）· 死亡时挑能力】（用户 2026-11-12）：只列当前板子的爪牙。
    if (mode == 39) {
        return (BOTC_RoleTeam(r) == 2 && BOTC_RoleOnBoard(r));
    }
    // 【瘟疫医生 × 男爵】（用户 2026-11-12）：只列当前板子的外来者；
    //   酒鬼（14）需要额外的认知镇民选择，不在这里生成；全员追忆占位身份 143..146 永不出现。
    if (mode == 40) {
        if (BOTC_RoleTeam(r) != 1) {
            return false;
        }
        if (r == 14 || (r >= 143 && r <= 146)) {
            return false;
        }
        return BOTC_RoleOnBoard(r);
    }
    // 【失忆者首夜黑名单】（用户 2026-11-11）：善良角色 + 爪牙都能选，但下列角色不适合作为失忆者的能力：
    //   认知偏差 / 无能力 / 自指：酒鬼 14、疯子 38、悟道者 118、提线木偶 93、失忆者自身 73
    //   身份与胜负条件类：陌客 15、圣徒 16、主谋 42、政客 97、异端分子 101
    //   规则依赖全场：无神论者 83（依赖全场无神论判定）、巡山人 77（依赖自身在场开局设置）
    //   开局设置类（失忆者首夜拿到时配置阶段已过）：男爵 20、教父 39、店小二 115、召唤师 150
    //   依赖专属信息结构：间谍 18、寡妇 75（查看魔典与抄录快照）
    if (mode == 46) {
        if (r == 14 || r == 15 || r == 16 || r == 18) {
            return false;
        }
        if (r == 20 || r == 38 || r == 39 || r == 42) {
            return false;
        }
        if (r == 73 || r == 75 || r == 77 || r == 83) {
            return false;
        }
        if (r == 93 || r == 97 || r == 101) {
            return false;
        }
        if (r == 115 || r == 118 || r == 120 || r == 150) {
            return false;
        }
        if (r == 35 || r == 60 || r == 61 || r == 62) {
            return false;
        }
        if (r == 63 || r == 82 || r == 92 || r == 137) {
            return false;
        }
        if (r == 152 || r == 157 || r == 160) {
            return false;
        }
        return true;
    }
    // 【首夜不在场身份弹窗】（用户 2026-11-04）：只列不在场的镇民 / 外来者
    if (mode == 50) {
        return (BOTC_RoleTeam(r) <= 1 && !BOTC_RoleInPlay(r));
    }
    // 【全员追忆 · 猜角色】（用户 2026-11-06）：排除全员追忆占位身份 143..146
    // 【帽匠 · 茶会换角色】（用户 2026-11-09）：模式 54 同样排除全员追忆占位身份 143..146。
    if (mode == 51 || mode == 54) {
        return (r < 143 || r > 146);
    }
    // 【变脸师（117）】（用户 2026-11-12）：本剧本全部善良角色（镇民 + 外来者），
    //   排除占位身份 143..146 与变脸师本人；这一局获得过的角色不再出现。
    if (mode == 48) {
        if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
            return false;
        }
        // 全员追忆的占位身份 143..146 不是真正的角色。
        if (r >= 143 && r <= 146) {
            return false;
        }
        // 变脸师自己（117）不能选，避免自己给自己再套一层。
        if (r == 117) {
            return false;
        }
        // 只列当前剧本里的角色。
        if (!BOTC_RoleOnBoard(r)) {
            return false;
        }
        seat = g_pickAttachSeat[p];
        if (seat >= 2 && seat <= 13 && g_faceEver[(seat * 164) + r]) {
            return false;
        }
    }
    // 【变脸师 · 嵌套那一层】（哲学家 35 / 炼金术士 36）：
    //   哲学家层放开为本剧本善良角色（镇民 + 外来者），炼金术士层保持爪牙；
    //   两层都排除变脸师本人和这一局已经获得过的角色。
    if (mode == 35 || mode == 36) {
        seat = g_pickAttachSeat[p];
        if (seat >= 2 && seat <= 13 && g_facePicking == seat) {
            if (r == 117) {
                return false;
            }
            if (mode == 35 && BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
                return false;
            }
            if (g_faceEver[(seat * 164) + r]) {
                return false;
            }
        }
    }
    return true;
}

// 相克规则允许在「只列善良」里额外露出哥布林。generic 过滤之后单独补回。
bool BOTC_PickModeShowsGoblin (int p) {
    int mode;
    int act;
    if (p < 1 || p > 13) {
        return false;
    }
    // 【相克】只有当前剧本里存在哥布林（99）才允许露出（用户 2026-11-10）
    if (!BOTC_RoleOnBoard(99)) {
        return false;
    }
    mode = g_pickMode[p];
    if (mode == 14) {
        return true;
    }
    if (mode == 12 && g_miRole >= 60 && (g_miRole - 60) == 25) {
        return true;
    }
    if (mode == 41) {
        act = BOTC_ActRoleOf(g_pickWho[p]);
        return (act == 66);
    }
    return false;
}

void BOTC_PickCatCtrlRender (int p) {
    int t;
    int n;
    int pages;
    int page;
    bool show;
    string label;
    if (p < 1 || p > 13) {
        return;
    }
    // 声称面板（mode 3）使用独立的固定底行，不参与分类与单类分页。
    if (g_pickMode[p] == 3) {
        for (t = 0; t < 4; t += 1) {
            DialogControlSetVisible(g_pickCatBtn[t], PlayerGroupSingle(p), false);
        }
        DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), false);
        return;
    }
    // 四栏同页模式（非全员追忆 / 非全角色选择）：不显示分类按钮和单类分页
    if (!BOTC_PickUseCategory(p)) {
        for (t = 0; t < 4; t += 1) {
            DialogControlSetVisible(g_pickCatBtn[t], PlayerGroupSingle(p), false);
        }
        DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), false);
        return;
    }
    for (t = 0; t < 4; t += 1) {
        n = BOTC_PickCatShowN(p, t);
        DialogControlSetVisible(g_pickCatBtn[t], PlayerGroupSingle(p), (n > 0));
        if (t == 0) {
            label = "镇民";
        }
        else if (t == 1) {
            label = "外来者";
        }
        else if (t == 2) {
            label = "爪牙";
        }
        else {
            label = "恶魔";
        }
        if (t == g_pickCatSel[p]) {
            libNtve_gf_SetDialogItemText(g_pickCatBtn[t], TextWithColor(StringToText("▶ " + label), Color(255, 215, 0)), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_pickCatBtn[t], TextWithColor(StringToText(label), Color(200, 200, 200)), PlayerGroupSingle(p));
        }
    }
    t = g_pickCatSel[p];
    if (t < 0 || t > 3) {
        t = 0;
    }
    n = BOTC_PickCatShowN(p, t);
    pages = ((n + 34) / 35);
    if (pages < 1) {
        pages = 1;
    }
    page = g_pickCatPageBy[(p * 4) + t];
    if (page < 1) {
        page = 1;
    }
    if (page > pages) {
        page = pages;
    }
    show = (pages > 1);
    DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), show);
    DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), show);
    if (show) {
        libNtve_gf_SetDialogItemText(g_pickPageLbl, StringToText("第 " + IntToString(page) + " / " + IntToString(pages) + " 页"), PlayerGroupSingle(p));
    }
}

// 保持当前面板的过滤条件重新排版
void BOTC_PickRepaint (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    g_pickTeam = g_pickFilterTeam[p];
    g_pickAlign = g_pickFilterAlign[p];
    BOTC_PickFilter(p, g_pickFilterGood[p]);
}

// 左上角切换类别
void BOTC_PickCatSet (int p, int t) {
    if (p < 1 || p > 13 || t < 0 || t > 3) {
        return;
    }
    if (BOTC_PickCatShowN(p, t) <= 0) {
        return;
    }
    g_pickCatSel[p] = t;
    BOTC_PickRepaint(p);
}

// 左下角单类上一页 / 下一页
void BOTC_PickPageMove (int p, int d) {
    int t;
    int n;
    int pages;
    int page;
    if (p < 1 || p > 13) {
        return;
    }
    t = g_pickCatSel[p];
    if (t < 0 || t > 3) {
        t = 0;
    }
    n = BOTC_PickCatShowN(p, t);
    pages = ((n + 34) / 35);
    if (pages < 1) {
        pages = 1;
    }
    page = g_pickCatPageBy[(p * 4) + t];
    if (page < 1) {
        page = 1;
    }
    if (d < 0 && page > 1) {
        page = page - 1;
    }
    if (d > 0 && page < pages) {
        page = page + 1;
    }
    g_pickCatPageBy[(p * 4) + t] = page;
    BOTC_PickRepaint(p);
}

void BOTC_PickFilter (int p, bool goodOnly) {
    int q;
    bool show;
    g_pickFilterGood[p] = goodOnly;
    g_pickFilterTeam[p] = g_pickTeam;
    g_pickFilterAlign[p] = g_pickAlign;
    BOTC_PickLayoutFor(p);
    // 【点击快照】面板显示完成后，立刻保存这一位玩家眼前的 64 格角色。
    //   全追角色很多，其它功能调用 BOTC_GridPlan() 会重排公共 g_gridSlot；
    //   普通发身份点击时必须读这里，避免显示的「僵怖」被重排后的「数学家」槽位覆盖。
    for (q = 0; q < 64; q += 1) {
        g_pickSlotRole[(p * 64) + q] = g_gridSlot[q];
    }
    // 【末尾那几个固定槽（g_gridN..63）默认全部藏起来】（用户 2026-10-04 报「炼金术士面板多出一只哥布林」）：
    //   声称面板（BOTC_DeclareOpen）和炼金术士借能力面板（BOTC_AlcBorrowOpen）都会把角色摆到这几个槽里，
    //   而它们**共用同一个对话框** —— 不先清一遍，上一面用过的格子（比如 61 号槽那只白字「哥布林」）
    //   就会留在这一面；炼金面板只按「团队」过滤，哥布林本来就是爪牙，所以它躲过了过滤、留在屏幕上。
    for (q = g_gridN; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    for (q = 0; q < g_gridN; q += 1) {
        // 图标网格版：按钮和它的图标、名字要一起显隐（格子的身份见 g_gridSlot）
        show = true;
        if (goodOnly && BOTC_RoleAlign(g_gridSlot[q]) == 1) {
            show = false;
        }
        if (g_pickTeam >= 0 && BOTC_RoleTeam(g_gridSlot[q]) != g_pickTeam) {
            show = false;
        }
        if (g_pickAlign >= 0 && BOTC_RoleAlign(g_gridSlot[q]) != g_pickAlign) {
            show = false;
        }
        if (!BOTC_PickModeRoleAllowed(p, g_gridSlot[q])) {
            show = false;
        }
        if (g_gridSlot[q] == 99 && BOTC_PickModeShowsGoblin(p)) {
            show = true;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), show);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), show);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), show);
    }
    g_pickTeam = -1;          // 过滤是一次性的：用完立刻还原成「不过滤」（用户 2026-09-21）
    g_pickAlign = -1;
    // 【取消键】（用户 2026-09-21）：除非特殊说明，技能面板不给「取消」----
    //   筑梦师 / 首夜信息位 / 洗脑师 / 麻脸巫婆（含认知覆盖）/ 赌徒猜身份都必须选完，不给取消；
    //   侍臣（不发动技能）/ 哲学家（这夜先不选）/ 说书人改身份 / 测试 / 杂耍艺人那一行保留。
    // 【右下角按钮默认显示】（用户 2026-11-10）：失忆者 / 食人族 / 小精灵的选能力面板会临时藏掉它，
    //   其余面板在这里统一恢复，避免上一次的隐藏状态或文案残留到下一个面板。
    DialogControlSetVisible(g_pickClose, PlayerGroupSingle(p), true);
    libNtve_gf_SetDialogItemText(g_pickClose, StringToText("取消"), PlayerGroupSingle(p));
    // 【瘟疫医生】模式 39 / 40 只能通过选角色或底部【取消】结束，不提供右上角关闭，
    //   否则会留下没人收尾的相克状态。
    if (g_pickMode[p] == 39 || g_pickMode[p] == 40) {
        DialogControlSetVisible(g_pickClose, PlayerGroupSingle(p), false);
    }
    show = true;
    if (g_pickMode[p] == 4 || g_pickMode[p] == 10 || g_pickMode[p] == 11 || g_pickMode[p] == 12) {
        show = false;
    }
    if (g_pickMode[p] == 14 || g_pickMode[p] == 15 || g_pickMode[p] == 16) {
        show = false;
    }
    // 声称 / 死后声称（模式 3）：只保留右下角【取消】关闭面板，不再显示底部按钮。
    //   这个网格与失忆者等面板共用，失忆者写上的「取消（DIY能力）」文案会残留在声称面板。
    if (g_pickMode[p] == 3) {
        show = false;
    }
    // 【底部取消 + 右下角永久失去】（用户 2026-11-12）：失忆者（46）/ 食人族（47）/ 小精灵（49）
    //   的【清除身份】已改写成「取消（…）」，右下角再显示【取消】就和它重复，这里把右下角那个藏掉；
    //   变脸师（48）额外保留右下角按钮，文案改成【永久失去】。
    if (g_pickMode[p] == 46 || g_pickMode[p] == 47 || g_pickMode[p] == 49) {
        DialogControlSetVisible(g_pickClose, PlayerGroupSingle(p), false);
    }
    if (g_pickMode[p] == 48) {
        libNtve_gf_SetDialogItemText(g_pickClose, StringToText("永久失去"), PlayerGroupSingle(p));
        DialogControlSetVisible(g_pickClose, PlayerGroupSingle(p), true);
    }
    // 限次角色的角色选择：侍臣 / 哲学家 / 鸩。
    //   工程师（19）允许点【取消（不使用能力）】，所以单独保留底部按钮。
    if (g_pickMode[p] == 5 || g_pickMode[p] == 8 || g_pickMode[p] == 28) {
        show = false;
    }
    // 其余由角色技能或技能后续步骤调度的身份网格：同样不给底部取消 / 返回。
    if (g_pickMode[p] == 9 || g_pickMode[p] == 13 || g_pickMode[p] == 17 || g_pickMode[p] == 20 || g_pickMode[p] == 21 || g_pickMode[p] == 22 || g_pickMode[p] == 23 || g_pickMode[p] == 26 || g_pickMode[p] == 27 || g_pickMode[p] == 30 || g_pickMode[p] == 35 || g_pickMode[p] == 36 || g_pickMode[p] == 42 || g_pickMode[p] == 51 || g_pickMode[p] == 54) {
        show = false;
    }
    if (g_pickMode[p] == 41 && !(BOTC_ActRoleOf(g_pickWho[p]) == 150 && g_nightNum == 2)) {
        show = false;
    }
    // 【科学怪人（132）首夜】：必须选择一份能力，不给取消
    if (g_pickMode[p] == 32) {
        show = false;
    }
    if (g_pickMode[p] == 39) {
        show = false;                  // 瘟疫医生死亡时必须选择一个爪牙能力
    }
    // 【使用技能】（用户 2026-11-06）：说书人挑角色这一步不给底部取消按钮。
    if (g_pickMode[p] == 52) {
        show = false;
    }
    if (g_pickMode[p] == 43) {
        show = false;                  // 熊孩子每夜必须选择一个镇民角色
    }

    // 【巡山人（77）· 说书人给落难少女定新身份】（用户 2026-10-04）：这一步必须选完 —— 不给【取消】。
    //   理由：巡山人一局只有一次机会，他选中的那一刻 token 98 就打上了，点错取消没法重来。
    if (g_pickMode[p] == 18) {
        show = false;
    }
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(p), show);
    // 四栏标题：分类样式永远隐藏；四栏同页模式由 BOTC_PickLayoutStacked 控制显隐
    if (g_pickMode[p] == 3 || g_pickMode[p] == 51 || BOTC_PickUseCategory(p)) {
        for (q = 0; q < 4; q += 1) {
            DialogControlSetVisible(g_pickSec[q], PlayerGroupSingle(p), false);
        }
    }
    BOTC_PickCatCtrlRender(p);
    BOTC_PickAlignRender(p);
}

// 邪恶玩家（爪牙 / 恶魔）自己的【伪装身份】按钮：只有他们是邪恶、且身份已经发下去之后才显示。
//   按钮文字直接显示现在自称的身份（「伪装：镇长」），一眼就能看出自己有没有设过。
void BOTC_ClaimBtnRender () {
    int p;
    for (p = 2; p <= 13; p += 1) {
        DialogSetVisible(g_claimBtnDlg[p], PlayerGroupSingle(p), false);   // 【AI 已废弃】声称按钮原来只有智能说书才露（2026-10-16 清死代码）
        if (g_claim[BOTC_PosOf(p)] >= 0) {
            libNtve_gf_SetDialogItemText(g_claimBtnP[p], StringToText("伪装：" + g_roleName[g_claim[BOTC_PosOf(p)]]), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_claimBtnP[p], StringToText("伪装身份"), PlayerGroupSingle(p));
        }
    }
}

// 【诊断】把「玩家1 是不是电脑」是怎么判出来的写进私聊日志
//   同时写给 玩家1 和 玩家2：玩家1 是电脑时，读日志的是坐在玩家2 的那个人
void BOTC_P1LogMode () {
    string s;
    string ai;
    string verdict;
    if (g_p1RawAI) {
        ai = "是";
    }
    else {
        ai = "否";
    }
    if (g_p1IsComp) {
        verdict = "【诊断说书模式】判定：电脑说书 → 智能说书已启用";
    }
    else {
        verdict = "【诊断说书模式】判定：真人说书 → 手动说书";
    }
    s = "【诊断说书模式】PlayerType(1)=" + IntToString(g_p1RawType) + "（实测：电脑=2 / 真人=1）｜被AI接管=" + ai + "｜难度=" + IntToString(g_p1RawDiff) + "｜句柄=" + g_p1RawHandle;
    BOTC_DiagStore(g_teller, s);
    BOTC_DiagStore(2, s);
    BOTC_DiagStore(g_teller, verdict);
    BOTC_DiagStore(2, verdict);
}

// 【临时测试】把「你」那个座位弄成猎手（索引 10）：
//   场上本来有猎手就跟他整行对调（身份 + token），没有就跟一个镇民对调（不动配板）

// 同上，但指定座位（给「玩家2 自动声称猎手」那个测试用）

// 【测试猎手弹窗】把指定座位弄成「酒鬼猎手」：魔典上写着猎手、身上带「是酒鬼」token
//   ---- 他以为自己是猎手，声称之后走「猎手请求」弹窗（说书人那边会看到真身是酒鬼）。
//   优先跟场上原本的猎手对调，其次跟原本的酒鬼，都没有就跟一个镇民对调（配板人数不变）。

// 【测试猎手弹窗】把指定座位弄成「中毒的猎手」：真猎手 + 打「中毒」token（索引 7）
//   ---- 说书人弹窗里那行参考会写「他是真的【猎手】，但现在中毒」，让他自己决定怎么演。

// 【测试猎手弹窗】第 1 个白天：玩家2（座位 2）自动声称【猎手】、猎杀 玩家3（座位 3）
//   开关是聊天指令 slay（真猎手）/ slayd（酒鬼猎手）/ slayp（中毒的猎手），只在第 1 个白天跑一次。

// 玩家1（说书人位）是不是电脑控制？
//   查的是原生函数（都在 TriggerLibs/natives.galaxy 里，参见桌面那份原生函数清单）：
//     PlayerType(玩家)  → 玩家类型编号
//     PlayerHandle(玩家) → Battle.net 句柄。**别调它**：对「没有 gameUser 的电脑座位」会直接报错，
//       而且报错是在 BOTC_Init 里发生的 ---- 会把整条初始化打断（事件 / 计时器全不注册）。
//     PlayerDifficulty(玩家) → AI 难度，只写进诊断日志
//   【2026-09-16 实机实测】大厅里把玩家1 放成电脑时：PlayerType(1) = 2、句柄为空、难度 = 2。
//     注意 `PlayerIsUnderAIControl(1)` 在这种大厅电脑上返回的是**否**（那个函数只反映
//     「玩家被 AI 接管」这条开关，跟大厅里的电脑座位不是一回事），所以不能拿它当判据。
//   ⚠ 不要用玩家名去猜（PlayerGetName 那类函数在编辑器里根本不存在，会直接编译不过）。
//   三个来源，按优先级：
//     ① g_p1ForceManual：强制当人（聊天里输入「手动」，或玩家1 自己动手了）
//     ② g_p1ForceComputer：强制当电脑（聊天里输入「AI」，测试时懒得改大厅就用它）
//     ③ 真身判定（缓存一次）：
//          PlayerType = 1 → 真人（人类玩家的编号，待机房实测确认）
//          PlayerType = 2 → 电脑（实测值）
//          其它值 → 一律先当电脑（智能说书）；真人被误判时聊天里发「-手动」切回来
bool BOTC_P1IsComputer () {
    if (g_p1ForceManual) {
        return false;
    }
    if (g_p1ForceComputer) {
        return true;
    }
    if (!g_p1ChkDone) {
        g_p1ChkDone = true;
        g_p1RawType = PlayerType(1);
        g_p1RawAI = PlayerIsUnderAIControl(1);
        g_p1RawDiff = PlayerDifficulty(1);
        g_p1RawHandle = "";
        g_p1IsComp = false;
        if (g_p1RawType == 1) {
            g_p1IsComp = false;                    // 明确是真人
        }
        else {
            if (g_p1RawType == 2) {
                g_p1IsComp = true;                 // 实测：大厅里的电脑
            }
            else {
                // 类型既不是 1 也不是 2 的少见情况：**绝不调 PlayerHandle** ----
                //   PlayerHandle(1) 对「没有 gameUser 的电脑座位」会直接报错，而这一句是在
                //   BOTC_Init 里跑的，报错会把整条初始化打断（后面所有事件 / 计时器都不注册），
                //   表现就是「进游戏什么都不响应、AI 说书人像宕机」。
                //   改成：这种说不清的情况一律先当**电脑**（= 智能说书），除非它已经被别的 AI 接管标志否定。
                //   万一真人说书人被误判成电脑：聊天里发「-手动」就能切回来（见 BOTC_Chat_Func）。
                g_p1IsComp = true;
            }
        }
        BOTC_P1LogMode();
    }
    return g_p1IsComp;
}

// 设置说书模式：false = 手动说书，true = 智能说书
//   （模式不由按钮切换，而是开局自动判定 + 选板子环节推断，见 BOTC_P1IsComputer / BOTC_BoardPick）

// 开局定模式（判断方式见 BOTC_P1IsComputer 的说明）
void BOTC_InitMode () {
    int p;
    // 【队伍1 = 说书人】（用户 2026-11-07）：大厅里的「队伍1」就是「说书人」队。
    //   首次进游戏时，谁被分在队伍1 谁就当说书人（不再只看玩家1 的槽位有没有人）。
    //   ⚠ 只在 BOTC_Init 里跑这一次；之后玩家与说书人换座位、重新开始都不再改说书人。
    p = BOTC_TeamTellerSeat();
    if (p >= 2) {
        g_teller = p;
        // 【玩家1 还在场时不要把他踢出圈】（用户 2026-11-10 报「队伍1 的玩家当说书人后，
        //   原来的说书人和新说书人共用一个名字、少一个座位号」）：
        //   队伍1 的玩家不是玩家1 时，玩家1 只是普通玩家 —— 他应当坐进新说书人空出来的那一格，
        //   圈里人数才不变；只有玩家1 本来就不在（不在场 / 是电脑）时才隐藏说书人原来那一格。
        if (PlayerType(1) == 1 && PlayerStatus(1) != 2) {
            g_hideSeat = 0;
            g_who[1] = p;             // "说书人格"上坐的人
            g_who[p] = 1;             // 玩家1 填进说书人原来那一格
        }
        else {
            g_hideSeat = p;           // 他原来那个玩家号不进圈
            g_who[1] = p;             // "说书人格"上坐的人
            g_who[p] = p;
        }
        BOTC_Notice(g_teller, "检测到你在大厅的「说书人」队伍：本局由你当说书人。");
        BOTC_DiagStore(2, "【诊断说书模式】队伍1 的座位 " + IntToString(p) + " 当说书人（手动说书）");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：手动说书（队伍1 玩家当说书人）"));
        return;
    }
    // 【玩家1 不在 → 顺位让"下一个进房间的人"当说书人】（用户 2026-10-07）：
    //   以前"第一个进房间的人走了"会直接掉进【智能说书】那条老路（第 2 个人顶不上来）。
    //   现在：只要场上还有真人，就由玩家号最小的那位（= 下一个进房间的）接手，模式走手动说书。
    //   （玩家1 是**真电脑**时不算这种情况 —— 那是你自己要的智能说书。）
    if (!(PlayerType(1) == 1 && PlayerStatus(1) != 2) && PlayerType(1) != 2) {
        p = BOTC_FirstPresentSeat();
        if (p >= 2) {
            g_teller = p;
            g_hideSeat = p;               // 他原来那个玩家号不进圈（用户 2026-10-07）
            g_who[1] = p;                 // "说书人格"上坐的人
            g_who[p] = p;                 // 玩家1 那一格本来就没人，保持原样
            BOTC_Notice(g_teller, "玩家1 不在场：按进房间顺序，本局由你当说书人。");
            BOTC_DiagStore(2, "【诊断说书模式】玩家1 不在场 → 顺位由座位 " + IntToString(p) + " 当说书人（手动说书）");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：手动说书（玩家1 不在，顺位接手）"));
            return;
        }
    }
    if (BOTC_P1IsComputer()) {
        BOTC_Notice(g_teller, "检测到玩家1 是电脑：本局由系统自动推进。");
        BOTC_DiagStore(2, "【诊断说书模式】检测到玩家1 是电脑：本局由系统自动推进。");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：智能说书"));
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局：手动说书"));
    }
}

//==================================================================================================
// 夜晚唤醒机制
//==================================================================================================

// 行动类别的中文名（说书人的提示里用）
string BOTC_ActName (int act) {
    if (act == 1) {
        return "夜晚主动";
    }
    if (act == 2) {
        return "夜晚主动*";
    }
    if (act == 3) {
        return "公开触发";
    }
    if (act == 4) {
        return "触发式被动";
    }
    if (act == 5) {
        return "首夜被动";
    }
    if (act == 6) {
        return "条件性行动";
    }
    return "被动";
}

// 自动唤醒今晚能不能叫醒这个座位（说书人手动唤醒与「收回唤醒」不走这里）
//   被动（0）永远不能唤醒；带星号（2）第 2 夜起；公开触发（3）和触发式被动（4）放行但会提醒；
//   首夜被动（5）只有第 1 夜；游戏正式开始之前不限制，方便说书人自己演示。
//   中毒 / 酒鬼不影响唤醒：夜里照常把他叫起来，只是他的技能会失效、查到的东西是错的。
bool BOTC_CanWakeAt (int q) {
    int r;
    int act;
    if (q < 2 || q > 13) {
        return false;
    }
    // 【退出 / 掉线 / 被踢出的座位】（用户 2026-11-11）：人已经离开游戏，不再被
    //   守鸦人、帽匠这类「死亡触发」唤醒，也不参与任何夜间行动。
    if (g_leftDeadP[g_who[q]]) {
        return false;
    }
    // 驱魔人（25）点名的恶魔：当晚**不能因其自身能力被唤醒**（用户 2026-09-20）
    //   【痢蛭 · 进场能力】（用户 2026-11-13，官方规则）：游戏中途被创造、还没有宿主的痢蛭，
    //   「选宿主」属于进场能力而不是夜间能力 —— 驱魔人拦不住它，否则会出现「痢蛭没有宿主」。
    if (g_exoBlock >= 2 && q == g_exoBlock && g_nightNum == g_exoNight) {
        if (!(BOTC_HasAbility(q, 100) && BOTC_LleechHostMode(q))) {
            return false;
        }
    }
    if (!g_started) {
        return true;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return false;
    }
    if (r == 150 && BOTC_HasAbility(q, 150)) {
        if (g_summonerDone) {
            return false;                  // 已经完成召唤，不再重复唤醒
        }
        if (g_nightNum != 2 && g_nightNum != 3) {
            return false;                  // 第二夜只能召唤普卡，第三夜正常召唤
        }
    }
    if (BOTC_NightLimitUsed(q, r)) {
        return false;
    }
    // 【女巫（65）】只剩 3 名存活后永久失去能力，不能继续被唤醒。
    if (r == 65 && BOTC_HasAbility(q, 65) && !BOTC_WitchCanAct(q)) {
        return false;
    }
    // 【按「拥有能力」判】（用户 2026-11-09）----
    //   真间谍 / 真寡妇 / 麻脸巫婆造出来的 / 说书人换上去的 / 哲学家 70、食人族 97 借来的，
    //   一律照旧能唤醒；只有炼金术士 123 相克拿不到这两个能力，仍不唤醒。
    if (BOTC_BorrowedSpyWidow(q, r)) {
        return false;
    }
    // 【巡山人（77）】（用户 2026-10-04 报「每晚都能用」）：官方是一局**只有一次**猜测和选择的机会 ——
    //   用过一次就会在身上打「失去能力（巡山人）98」，之后再唤醒一律拦掉。
    if (r == 77 && BOTC_HasAbility(q, 77) && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) {
        return false;
    }
    // 【传教士（103）】（用户 2026-10-10）：被他选中的爪牙在他**存活且清醒**期间失去能力
    //   → 不能因自身能力被唤醒（标记 125 由 BOTC_SourceGoneCleanup 在他死亡 / 离场时统一收掉）
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive()) {
        return false;
    }
    // 【鸩（124）】一局限一次：用过后不再唤醒。
    if (r == 124 && BOTC_HasAbility(q, 124) && g_tokOn[(((g_teller * 14) + q) * 256) + 145]) {
        return false;
    }
    if (r == 128 && BOTC_HasAbility(q, 128) && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) {
        return false;
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：宿主死于处决 + 主谋存活 → 痢蛭失去能力，之后不再唤醒他
    if (r == 100 && BOTC_HasAbility(q, 100) && g_tokOn[(((g_teller * 14) + q) * 256) + 18]) {
        return false;
    }
    // 画皮只有“没有当前目标且攻击链未断”时才能再次行动。
    if (r == 155 && (g_skinTarget[q] >= 2 || g_skinChainBroken[q])) {
        return false;
    }
    // 僵怖（43）：今天有人死（任何类型的白天死亡）→ 今晚不唤醒他（用户 2026-09-20）
    //   ⚠ 判「有没有僵怖这个能力」：疯子（38）魔典上也写着僵怖，但他没有这个能力（真身 38），不受这条限制
    if (r == 43 && BOTC_HasAbility(q, 43) && BOTC_SomeoneDiedToday()) {
        return false;
    }
    act = g_roleAct[r];
    // 死了的人不再唤醒（例外：守鸦人这类触发式被动 act == 4 ---- 他就是「今晚死了」才被唤醒的，
    //   下面那一段会单独放行）
    if (act != 4) {
        if (BOTC_SeatDead(q)) {
            // 【亡骨魔（69）的「保留能力」】（用户 2026-09-21）：被他杀死的爪牙保留能力
            //   → 即使死了也照样被唤醒、照样行动（百科：只要亡骨魔还活着）
            if (BOTC_KeepsAbilityAlive(q)) {
                return true;
            }
            return false;
        }
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：平时不唤醒；国王身上带着「死亡（恶魔）」token 时才允许唤醒
    if (r == 108 && BOTC_HasAbility(q, 108)) {
        return BOTC_ChoirboyKingDead();
    }
    if (act == 1) {
        return true;
    }
    if (act == 2) {
        return (g_nightNum >= 2);
    }
    if (act == 4) {
        // 【帽匠（120）】（用户 2026-10-16）：死后的那一个夜晚（还没开过茶会）才轮到他这一步 ----
        //   死法不限（处决 / 白天被杀 / 夜里被恶魔杀）；他本人什么都不做，只是把恶魔 + 爪牙拉进群聊。
        if (BOTC_HasAbility(q, 120)) {
            if (!BOTC_SeatDead(q)) {
                return false;
            }
            return !g_hatDone[q];
        }
        // 【守鸦人×利维坦】相克触发时，不需要真的死亡也能在今晚醒来。
        if (BOTC_HasAbility(q, 8) && g_levJinxWake[q]) {
            return true;
        }
        if (BOTC_HasAbility(q, 8) && g_levJinxLost[q]) {
            return false;
        }
        // 【贤者（59）】（用户 2026-09-21）：只有「被恶魔杀死」的那一晚才醒（死于处决 / 其他死法不醒）
        if (BOTC_HasAbility(q, 59)) {
            if (g_levJinxLost[q]) {
                return false;
            }
            if (g_deadByDemon[q] != 1) {
                return false;
            }
            return (g_deadNightNum[q] == g_nightNum);
        }
        // 【理发师（62）】（用户 2026-09-21）：他死的那一晚要唤起恶魔交换角色（「今晚理发」标记亮着就算）
        if (BOTC_HasAbility(q, 62)) {
            return g_tokOn[(((g_teller * 14) + q) * 256) + 92];
        }
        // 【农夫（80）】（用户 2026-09-26）：他的能力是「死后换一名农夫」，本人不需要被唤醒
        //   （换成了农夫的那个人，也由说书人自己私聊告诉他，不进夜序）
        if (BOTC_HasAbility(q, 80)) {
            return false;
        }
        // 触发式被动（守鸦人这类）：只有他「这一夜」真的死了，才允许唤醒
        if (g_deadKind[q] != 1) {
            return false;
        }
        return (g_deadNightNum[q] == g_nightNum);
    }
    // act == 3 = 公开触发（猎手）：**夜里不能被唤醒**（用户 2026-09-19）。
    //   黯月初升的「侍女」会去查某个人当晚能不能被唤醒，所以说书人不能随便叫醒一个
    //   夜里本来没有行动的人 ---- 这里直接落到最后的 return false。
    if (act == 5) {
        return (g_nightNum <= g_seatFirstNight[q]);   // 【复活后首夜重算】（用户 2026-09-20）
    }
    // act == 6 = 条件性行动（教父 / 教授 / 刺客...）：能不能唤醒由说书人自己判断，这里一律放行
    if (act == 6) {
        return true;
    }
    return false;
}

// 不能唤醒时给说书人的理由
string BOTC_WakeBlockStr (int q) {
    int r;
    int act;
    if (g_exoBlock >= 2 && q == g_exoBlock && g_nightNum == g_exoNight) {
        return BOTC_NameStr(q) + " 今晚被驱魔人点名了，不能因其自身能力被唤醒（这是驱魔人的能力效果）。";
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return BOTC_NameStr(q) + " 还没定身份，先在说书人那份魔典上给他定个身份。";
    }
    if (r == 150 && BOTC_HasAbility(q, 150)) {
        if (g_summonerDone) {
            return BOTC_NameStr(q) + "（召唤师）已经完成召唤，不再重复行动。";
        }
        if (g_nightNum != 2 && g_nightNum != 3) {
            return BOTC_NameStr(q) + "（召唤师）只能在第二个夜晚召唤普卡，或在第三个夜晚创造恶魔；现在是第 " + IntToString(g_nightNum) + " 夜。";
        }
    }
    // 【女巫（65）】只剩 3 名存活后永久失去能力
    if (r == 65 && BOTC_HasAbility(q, 65) && (g_witchLost || BOTC_AliveCountTrue() <= 3)) {
        return BOTC_NameStr(q) + "（女巫）只剩 3 名存活玩家，能力已经永久失效，不再唤醒她。";
    }
    // 【借来的间谍(18) / 寡妇(75)：不能唤醒】（用户 2026-10-14，第二次收窄）：只认借来的那一份
    if (BOTC_BorrowedSpyWidow(q, r)) {
        return BOTC_NameStr(q) + " 是**借来的**" + g_roleName[r] + "→ 这个能力不能把他叫醒；要看魔典 / 下毒你自己私下处理。";
    }
    // 【巡山人（77）】（用户 2026-10-04）：一局只有一次机会，用过了就不能再唤醒
    if (r == 77 && BOTC_HasAbility(q, 77) && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) {
        return BOTC_NameStr(q) + "（巡山人）这一局的机会已经用掉了（他带着「失去能力（巡山人）」标记），不用再唤醒他。";
    }
    // 【相克 · 痢蛭 × 主谋】（用户 2026-10-07）：失去了能力的痢蛭不用再唤醒
    if (r == 100 && BOTC_HasAbility(q, 100) && g_tokOn[(((g_teller * 14) + q) * 256) + 18]) {
        return BOTC_NameStr(q) + "（痢蛭）因为「宿主死于处决 · 主谋存活」已经失去能力，不用再唤醒他。";
    }
    // 僵怖（43）：今天有人死（任何类型的白天死亡）→ 今晚不唤醒他（用户 2026-09-20）
    if (r == 43 && BOTC_HasAbility(q, 43) && BOTC_SomeoneDiedToday()) {
        return "今天已经有人死了，僵怖（" + BOTC_NameStr(q) + "）今晚不会被唤醒。";
    }
    act = g_roleAct[r];
    if (act != 4) {
        if (BOTC_SeatDead(q)) {
            return BOTC_NameStr(q) + " 已经死了，今晚不唤醒他。";
        }
    }
    // 【传教士（103）】（用户 2026-10-10）：被布道的爪牙（传教士还活着且清醒）不能因自身能力被唤醒
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 125] && BOTC_MissionaryActive()) {
        return BOTC_NameStr(q) + " 被传教士布道了：只要那名传教士存活且清醒，他就不能因自身能力被唤醒。";
    }
    if (r == 124 && BOTC_HasAbility(q, 124) && g_tokOn[(((g_teller * 14) + q) * 256) + 145]) {
        return BOTC_NameStr(q) + "（鸩）这一局的一次性能力已经用过了。";
    }
    if (r == 128 && BOTC_HasAbility(q, 128) && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) {
        return BOTC_NameStr(q) + "（守夜人）这一局的一次性能力已经用过了。";
    }
    if (BOTC_NightLimitUsed(q, r)) {
        return BOTC_NameStr(q) + " 这一局的限次能力已经用过了，今晚不再唤醒。";
    }
    // 【唱诗男孩（108）】（用户 2026-10-10）：平时不唤醒
    if (r == 108 && BOTC_HasAbility(q, 108)) {
        return BOTC_NameStr(q) + "（唱诗男孩）只有国王被恶魔杀死之后才会被唤醒。";
    }
    if (act == 0) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·被动）没有夜间行动，不能被唤醒。";
    }
    if (act == 2) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·夜晚主动*）带星号，第 2 夜起才能行动，首夜不能唤醒。";
    }
    if (act == 3) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·公开触发）没有夜间行动，不能被唤醒。";
    }
    if (act == 5) {
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·首夜被动）只有他的「首夜」（第 " + IntToString(g_seatFirstNight[q]) + " 夜）能唤醒，现在是第 " + IntToString(g_nightNum) + " 夜。";
    }
    if (act == 4) {
        if (r == 59) {
            return BOTC_NameStr(q) + "（贤者）只有「被恶魔杀死」的那一晚才会被唤醒（现在没记到他今晚被恶魔杀过）。";
        }
        if (r == 62) {
            return BOTC_NameStr(q) + "（理发师）只有他死的那一晚才要唤起恶魔交换角色（现在没有「今晚理发」标记）。";
        }
        return BOTC_NameStr(q) + "（" + g_roleName[r] + "·触发式被动）只有他「今晚」死了才会被唤醒（现在没记到他今晚死过）。";
    }
    return BOTC_NameStr(q) + "（" + g_roleName[r] + "·" + BOTC_ActName(act) + "）今晚不能唤醒。";
}

// 进唤醒模式时把「今晚该醒的角色」私聊写给说书人
// 这个身份今晚的行动顺序（0 = 今晚不醒；首夜和其他夜用不同的表）
// 【官方全角色夜序表】（用户 2026-09-23）：直接读表；表里没有（0）就是这一夜不唤醒
int BOTC_NoFirstOf (int r) {
    if (r < 0 || r > 163) {
        return 0;
    }
    return g_noAllFirst[r];
}

int BOTC_NoOtherOf (int r) {
    if (r < 0 || r > 163) {
        return 0;
    }
    return g_noAllOther[r];
}

int BOTC_NightOrder (int r) {
    if (r < 0 || r > 163) {
        return 0;
    }
    if (g_nightNum <= 1) {
        return g_noAllFirst[r];
    }
    return g_noAllOther[r];
}

// 这个座位**今晚**的夜间顺序：
//   如果今晚正好是他的「首夜」（g_seatFirstNight，复活之后会往后挪），就按首夜顺序算；
//   否则按平常的夜间顺序。首夜信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母...）平常只有第 1 夜有顺序，
//   复活之后这里会重新给出首夜顺序，于是又能被唤醒一次。
int BOTC_NightOrderOf (int q) {
    int r;
    if (q < 2 || q > 13) {
        return 0;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    // 【疯子（含「哲学疯子」/ 食人族吃到的疯子）】（用户 2026-10-14 报「哲学疯子会在恶魔之后行动」）----
    //   真疯子 / 哲学家借到疯子能力（token 49）/ 食人族吃到疯子，都算：一律按**疯子(38)**那一格的夜序走
    //   （疯子在恶魔**之前**行动，这样恶魔当晚就能知道他选的是谁）。
    //   原来只认「真身 == 38」，而哲学疯子的真身是 56 → 按他「以为自己是的那只恶魔」排，就排到恶魔后面去了。
    if (BOTC_IsLunatic(q)) {
        // 疯子自认典狱长时跟随典狱长的行动轮次；其他假恶魔仍按疯子(38)提前行动。
        if (r != 163) {
            r = 38;
        }
    }
    // 【小怪宝】（用户 2026-11-07）：真正行动的是 g_lmSeat 指向的照看者。
    // 照看者自己的真实角色是爪牙，不能再用「真身 == 112」判断，否则全员追忆等
    // 没有玩家实际持有角色 112 的局里，会整段漏掉小怪宝的夜序。
    if (g_lmOn && q == g_lmSeat) {
        r = 112;
    }
    if (r < 0 || r > 163) {
        return 0;
    }
    if (g_nightNum <= g_seatFirstNight[q] && BOTC_NoFirstOf(r) > 0) {
        return BOTC_NoFirstOf(r);
    }
    return BOTC_NightOrder(r);
}

// 发一段唤醒提示：全部写进说书人的私聊记录（用户 2026-11-04：入夜只在私聊频道提醒，不弹面板）
void BOTC_WakeHintSend (string s, int idx) {
    BOTC_PmStore(g_teller, s);
}

// 唤醒提示：太长会被私聊窗那行截掉，所以**自动换行**（用户 2026-09-19 要求）
//   · 一行大概放 32 个字，放不下就把当前这行发出去、另起一行（续行缩进两格）
//   · ⚠ 以前这里既 BOTC_PmStore 又 BOTC_Notice（而 Notice 内部又会存一次），同一行会记两遍
void BOTC_WakeListHint () {
    int i;
    int q;
    int r;
    int n;
    int o;
    int sent;
    string s;
    string item;
    BOTC_BuildSeatList();
    s = "【唤醒】" + BOTC_PeriodStr() + " 可以唤醒（按夜间顺序）：";
    n = 0;                         // 当前这一行已经放了几个
    sent = 0;                      // 已经发出去几行（0 = 第一行还没发）
    // 先按顺序表 1..9 排
    for (o = 1; o <= 127; o += 1) {       // 官方全角色夜序表最长 124 行，别只扫到 20
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            r = g_mark[(g_teller * 14) + q] - 1;
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_NightOrderOf(q) != o) {
                continue;
            }
            if (BOTC_WakeSkipNow(q)) {
                continue;
            }
            item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
            if (n > 0) {
                item = "、" + item;
            }
            if (n > 0 && StringLength(s) + StringLength(item) > 32) {
                BOTC_WakeHintSend(s, sent);
                sent = sent + 1;
                s = "  ";
                n = 0;
                item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
            }
            s = s + item;
            n = n + 1;
        }
    }
    // 手工赋予的能力也有自己的夜序；获得能力的当夜按该角色的首夜列排队。
    for (o = 1; o <= 127; o += 1) {
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (BOTC_GrantWakeOrder(q) != o) {
                continue;
            }
            item = IntToString(q - 1) + " " + g_roleName[g_grantRoleBy[q] - 1] + "（附加）";
            if (n > 0) {
                item = "、" + item;
            }
            if (n > 0 && StringLength(s) + StringLength(item) > 32) {
                BOTC_WakeHintSend(s, sent);
                sent = sent + 1;
                s = "  ";
                n = 0;
                item = IntToString(q - 1) + " " + g_roleName[g_grantRoleBy[q] - 1] + "（附加）";
            }
            s = s + item;
            n = n + 1;
        }
    }
    // 再把「不在顺序表里但今晚真的能醒」的补上（只有触发式被动，比如守鸦人今晚被刀了）
    //   ⚠ 公开触发的角色（猎手那种）夜里**不会被唤醒**，不能列进来误导说书人
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = g_mark[(g_teller * 14) + q] - 1;
        if (r < 0 || r > 163) {
            continue;
        }
        if (g_roleAct[r] == 3) {
            continue;                  // 公开触发：不在夜里唤醒
        }
        if (BOTC_NightOrder(r) > 0) {
            continue;
        }
        if (BOTC_WakeSkipNow(q)) {
            continue;
        }
        item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
        if (n > 0) {
            item = "、" + item;
        }
        if (n > 0 && StringLength(s) + StringLength(item) > 32) {
            BOTC_WakeHintSend(s, sent);
            sent = sent + 1;
            s = "  ";
            n = 0;
            item = IntToString(q - 1) + " " + BOTC_SeatRoleStr(q);
        }
        s = s + item;
        n = n + 1;
    }
    if (sent == 0 && n == 0) {
        s = s + "今晚没有该醒的角色";
    }
    BOTC_WakeHintSend(s, sent);
    // 僵怖（43）：今天有人死 → 今晚不唤醒他，单独说一句（免得说书人以为漏了）
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!BOTC_HasAbility(q, 43)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_SomeoneDiedToday()) {
            BOTC_WakeHintSend("【僵怖】" + IntToString(q - 1) + " " + BOTC_SeatRoleStr(q) + "：今天已经有人死了 → 今晚不唤醒他（他要「今天没人死」才能发动）。", 1);
        }
    }
    // 教父（39）：今天有没有外来者死亡（决定他今晚能不能动）
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_HasAbility(q, 39)) {
            if (BOTC_GodfatherCanKill()) {
                BOTC_WakeHintSend("【教父】" + IntToString(q - 1) + " 今晚可以动手（今天有外来者死亡）。", 1);
            }
            else {
                BOTC_WakeHintSend("【教父】" + IntToString(q - 1) + " 今晚不能动手（今天没有外来者死亡）。", 1);
            }
        }
    }
    // 驱魔人（25）点名的那一位：今晚不会被唤醒，单独提醒一行（只写私聊记录，不再弹字幕）
    if (g_exoBlock >= 2 && g_exoNight == g_nightNum) {
        BOTC_WakeHintSend("【驱魔人】" + IntToString(g_exoBlock - 1) + " " + BOTC_SeatRoleStr(g_exoBlock) + " 今晚被点名，不会因其自身能力被唤醒。", 1);
    }
}

//==================================================================================================
// 间谍（Spy）：技能 = 把说书人当前魔典（身份 + token）保存成只读快照给本人
//   看完后切回自己的魔典界面，但渲染内容继续使用这份当时的快照；不修改真实魔典数据
//==================================================================================================

void BOTC_SpyCopyTruth (int p) {
    int q;
    int t;
    int sp;
    int m;
    int d;
    if (p < 1 || p > 13) {
        return;
    }
    sp = g_who[p];
    // 【伪造魔典抄录】（用户 2026-11-07）：他刚才看的是伪造那份，就抄伪造的数据。
    if (g_grimFakeOn[sp]) {
        for (q = 1; q <= 13; q += 1) {
            g_grimSnapMark[(sp * 14) + q] = 0;
            for (t = 0; t < 256; t += 1) {
                g_grimSnapTok[(((sp * 14) + q) * 256) + t] = false;
            }
        }
        for (q = 2; q <= 13; q += 1) {
            g_grimSnapMark[(sp * 14) + q] = g_fakeMark[q];
            for (t = 0; t < 256; t += 1) {
                g_grimSnapTok[(((sp * 14) + q) * 256) + t] = g_fakeTok[((q * 256) + t)];
            }
        }
        g_grimViewOn[sp] = false;
        g_grimView[sp] = 0;
        g_grimFakeOn[sp] = false;
        g_grimSnapOn[sp] = true;
        return;
    }
    for (q = 1; q <= 13; q += 1) {
        g_grimSnapMark[(sp * 14) + q] = g_mark[(g_teller * 14) + q];
        for (t = 0; t < 256; t += 1) {
            g_grimSnapTok[(((sp * 14) + q) * 256) + t] = g_tokOn[(((g_teller * 14) + q) * 256) + t];
        }
    }
    // 相克：间谍 / 寡妇查看魔典时，魔术师与恶魔的身份标记被拿掉。
    m = BOTC_MagicianSeatNow();
    if (m >= 2) {
        g_grimSnapMark[(sp * 14) + m] = 0;
        d = BOTC_FindDemon();
        if (d >= 2) {
            g_grimSnapMark[(sp * 14) + d] = 0;
        }
    }
    g_grimViewOn[sp] = false;
    g_grimView[sp] = 0;
    g_grimSnapOn[sp] = true;
}

// 【这一格是不是「拿不到」间谍(18) / 寡妇(75) 能力的借能力者】（用户 2026-11-09）----
//   改为按「是否拥有能力」判：真间谍 / 真寡妇 / 麻脸巫婆造出来的 / 说书人换身份换上去的、
//   哲学家 70、食人族 97、科学怪人 / 嵌套 / 赋予能力（g_grantRoleBy）拿到的，全都算拥有能力，
//   照旧能看魔典、照旧能被唤醒。
//   唯一仍要拦的是炼金术士 123 相克：他拿不到这两个能力（本应获得时改为该角色一定在场），
//   BOTC_HasAbility 里也已经强制返回假。
bool BOTC_BorrowedSpyWidow (int q, int r) {
    if (q < 1 || q > 13) {
        return false;
    }
    if (r != 18 && r != 75) {
        return false;
    }
    return g_tokOn[(((g_teller * 14) + q) * 256) + 123];
}
//==================================================================================================
// 【间谍 / 寡妇 · 唤醒延迟看魔典】（用户 2026-11-10）
//   被唤醒后不再需要点【使用技能】：等 1..5 秒自动摊开说书人那份实时真魔典；
//   中毒 / 醉酒的间谍、寡妇照旧由说书人选择给真实还是伪造；寡妇看完先选是否抄录，再进下毒面板。
//==================================================================================================
void BOTC_PeekQueue (int q, bool widow) {
    if (q < 1 || q > 13) {
        return;
    }
    g_peekWait[q] = RandomInt(2, 10);      // 0.5 秒一拍：2..10 拍 = 1..5 秒
    g_peekWaitWidow[q] = widow;
    // 提醒说书人先别急着点下一名：这几秒里魔典会自动摊开
    BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 已唤醒，魔典将在 1..5 秒后自动打开。");
}

void BOTC_PeekWaitClear (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    g_peekWait[q] = 0;
    g_peekWaitWidow[q] = false;
}

void BOTC_PeekTick () {
    int q;
    int r;
    bool wid;
    for (q = 1; q <= 13; q += 1) {
        if (g_peekWait[q] <= 0) {
            continue;
        }
        g_peekWait[q] = g_peekWait[q] - 1;
        if (g_peekWait[q] > 0) {
            continue;
        }
        wid = g_peekWaitWidow[q];
        g_peekWaitWidow[q] = false;
        // 到点时这个人已经不在地下：直接作废，不补看
        if (!g_started || !g_isNight || !g_seatOn[q] || !g_awake[q]) {
            continue;
        }
        r = BOTC_ActRoleOf(q);
        if (wid) {
            if (r == 75) {
                // 寡妇：看魔典 → 选是否抄录 → 选完才进下毒面板；魔典打不开时才直接给下毒面板兜底
                if (!BOTC_WidowPeek(q)) {
                    BOTC_SkillOpen(q);
                }
            }
        }
        else {
            if (r == 18) {
                BOTC_SpyPeek(q);
            }
        }
    }
}

//==================================================================================================
// 【送葬者 · 清醒时自动发信息】（用户 2026-11-11）
//   轮到他的夜序、并且今天真的有人死于处决时：延迟 1..5 秒自动私聊「你得知<角色>」；
//   中毒 / 醉酒 / 酒鬼 / 提线木偶 / 涡流（信息错误）时仍由说书人从身份网格里手动选；
//   被处决者是真陌客(15) / 真间谍(18) 时也弹身份网格，让说书人自己决定报什么角色。
//   这里报的角色走「查身份」那一层（BOTC_PairSeenRole），跟占卜师 / 守鸦人一致。
//==================================================================================================
// 今天「被处决并真的死亡」的那个座位（0 = 没有）
int BOTC_UtExecSeat () {
    int q;
    if (g_dayNum <= 0 || !g_execUsedToday) {
        return 0;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_exec[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum || g_deadKind[q] != 3) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            return q;
        }
    }
    return 0;
}

// 清醒的送葬者被唤醒后调用：排一个 1..5 秒的自动发送
void BOTC_UtQueue (int q) {
    int t;
    if (q < 1 || q > 13) {
        return;
    }
    t = BOTC_UtExecSeat();
    if (t < 2 || t > 13) {
        return;
    }
    g_utWait[q] = RandomInt(2, 10);       // 0.5 秒一拍：2..10 拍 = 1..5 秒
    g_utSeatP[q] = t;
}

void BOTC_UtWaitClear (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    g_utWait[q] = 0;
    g_utSeatP[q] = 0;
}

// 被处决者是间谍 / 陌客能力者：不自动报登记身份，交给说书人挑一个角色发
bool BOTC_UtMaskSeat (int t) {
    if (t < 2 || t > 13) {
        return false;
    }
    return BOTC_IsDisguiseAbility(t);
}

// 说书人手动挑「送葬者得知什么角色」（模式 42）：中毒 / 醉酒 / 酒鬼 / 提线木偶 / 涡流，
//   以及被处决者是真陌客 / 真间谍时都走这里。
void BOTC_UtPickOpen (int q) {
    if (q < 1 || q > 13) {
        return;
    }
    g_pickMode[g_teller] = 42;
    g_pickWho[g_teller] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_UtTick () {
    int q;
    int t;
    int rp;
    for (q = 1; q <= 13; q += 1) {
        if (g_utWait[q] <= 0) {
            continue;
        }
        g_utWait[q] = g_utWait[q] - 1;
        if (g_utWait[q] > 0) {
            continue;
        }
        t = g_utSeatP[q];
        g_utSeatP[q] = 0;
        // 到点时人已经不在夜里 / 已被收回唤醒 / 座位上没人：直接作废
        if (!g_started || !g_isNight || !g_awake[q]) {
            continue;
        }
        if (q >= 2 && !g_seatOn[q]) {
            continue;
        }
        if (t < 2 || t > 13) {
            continue;
        }
        // 到点时被处决者已经是真陌客 / 真间谍：改由说书人挑角色
        if (BOTC_UtMaskSeat(t)) {
            BOTC_UtPickOpen(q);
            continue;
        }
        rp = BOTC_PairSeenRole(q, t);
        if (rp < 0 || rp > 163) {
            continue;
        }
        BOTC_PmInfo(g_who[q], "【信息】你得知" + g_roleName[rp] + "。");
        BOTC_PmStore(g_teller, "【送葬者】已告诉 " + BOTC_NameStr(q) + "：" + BOTC_NameStr(t) + " 今天死于处决，角色是" + g_roleName[rp] + "。");
    }
}

void BOTC_SpyPeek (int p) {
    int sp;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_awake[p]) {
        BOTC_Notice(g_who[p], "只有被唤醒的时候才能看说书人的魔典。");
        return;
    }
    // 中毒 / 酒鬼的间谍：功能技能失效。原先是直接「打不开」；现在改成由说书人选择
    //   给他看真实魔典还是伪造魔典（用户 2026-11-07）。
    if (!BOTC_SkillWorks(p)) {
        if (BOTC_SeatIsDrunk(p) || BOTC_SeatIsPoisoned(p)) {
            BOTC_FakeAskOpen(p, false);
            return;
        }
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【夜间】间谍 " + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶，没给他开魔典。");
        return;
    }
    // 【罂粟种植者 × 间谍】（用户 2026-11-06）：罂粟存活且能力生效时，间谍无法查看说书人的魔典。
    //   只说「打不开」，不暴露罂粟；原因只私聊告诉说书人。
    if (BOTC_PoppyActive()) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【罂粟种植者×间谍】" + BOTC_NameStr(p) + " 无法查看魔典（罂粟种植者能力生效）。");
        return;
    }
    // 【按「拥有间谍能力」判】（用户 2026-11-09）----
    //   真间谍 / 麻脸造出来的 / 说书人换上去的 / 哲学家 70、食人族 97 借来的 /
    //   科学怪人、嵌套、赋予能力拿到的，一律照旧能看；只有炼金术士 123 相克拿不到这个能力。
    if (BOTC_BorrowedSpyWidow(p, 18)) {
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【炼金术士×间谍】" + BOTC_NameStr(p) + " 没有间谍能力（相克），没给他开魔典。");
        return;
    }
    BOTC_SpyPeekShow(p, false, false, true);
}

// 结束正在看真魔典的状态：切回自己的魔典界面，但保留当时的只读快照
void BOTC_SpyPeekEnd () {
    int sp;
    if (g_spyP < 2) {
        return;
    }
    sp = g_who[g_spyP];
    g_spyP = 0;
    g_peekNoTok = 0;        // 还原：不再是「只看身份」模式（要在下面那次 GrimRender 之前清掉）
    g_grimViewOn[sp] = false;
    g_grimView[sp] = 0;
    g_grimFakeOn[sp] = false;
    BOTC_CopyAskHide();     // 没回答就被收回 / 天亮：把「是否抄录」弹窗一起收掉（不新增快照）
    BOTC_GrimRender(sp);
}

//==================================================================================================
// 【是否抄录魔典】（用户 2026-11-06）：间谍 / 寡妇看完说书人的实时真魔典后由本人决定
//   【抄录】= 把此刻的真魔典存成快照，此后自己那份魔典继续显示它；
//   【不抄录】= 看完即恢复自己那份魔典，不保存快照。
//   无论选哪个，都在说书人私聊里留一条记录。
//==================================================================================================
void BOTC_CopyAskOpen (int p, bool widow) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_copyDlg <= 0) {
        return;
    }
    g_copyP = p;
    g_copyWidow = widow;
    libNtve_gf_SetDialogItemText(g_copyLbl, StringToText("你正在查看说书人的魔典。是否抄录一份到你自己的魔典？"), PlayerGroupSingle(g_who[p]));
    DialogControlSetVisible(g_copyLbl, PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_copyYes, PlayerGroupSingle(g_who[p]), true);
    DialogControlSetVisible(g_copyNo, PlayerGroupSingle(g_who[p]), true);
    DialogSetVisible(g_copyDlg, PlayerGroupSingle(g_who[p]), true);
}

void BOTC_CopyAskHide () {
    if (g_copyP < 1) {
        return;
    }
    g_copyP = 0;
    g_copyWidow = false;
    if (g_copyDlg > 0) {
        DialogSetVisible(g_copyDlg, PlayerGroupAll(), false);
    }
}

void BOTC_CopyAskAnswer (int p, bool yes) {
    bool wid;
    int sp;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_copyP != p) {
        return;
    }
    wid = g_copyWidow;
    sp = g_who[p];
    BOTC_CopyAskHide();
    if (yes) {
        BOTC_SpyCopyTruth(p);          // 把此刻的实时真魔典存成快照
        BOTC_NoticeKeep(g_teller, "【魔典】" + BOTC_SeatRoleStr(p) + " " + BOTC_NameStr(p) + " 选择了抄录。");
    }
    else {
        // 不抄录：实时视图和旧快照都不留（看完即恢复自己那份魔典）
        g_grimViewOn[sp] = false;
        g_grimView[sp] = 0;
        g_grimSnapOn[sp] = false;
        BOTC_NoticeKeep(g_teller, "【魔典】" + BOTC_SeatRoleStr(p) + " " + BOTC_NameStr(p) + " 选择了不抄录。");
    }
    BOTC_SpyPeekEnd();                 // 收回实时真魔典（抄录的那份快照继续留在本人魔典上）
    if (wid) {
        BOTC_SkillOpen(p);             // 寡妇：抄录选择结束之后才进下毒目标面板
    }
}


// 【-grim n】（用户 2026-10-07）：开发 / 测试用 —— 把自己的魔典切去"看 座位 n 自己那份"（n = 1..12）。
//   · 座位 n = 魔典上的**格子 n+1**（编号 [n]），那一格坐着的人由 g_who 查；
//   · 只改"渲染读哪一行"（g_grimView），**不动任何数据** —— 随时能切回，也不会污染别人的魔典；
//   · -grim 0（或者只发 -grim）＝ 看回自己那份。
void BOTC_GrimViewMsg (int p, string arg) {
    int sp;
    int n;
    if (p < 1 || p > 13) {
        return;
    }
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        n = StringToInt(arg);          // 【容错】-grim3（不加空格）也认
    }
    else {
        n = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    }
    if (n < 1 || n > 12) {
        g_grimViewOn[p] = false;
        g_grimView[p] = 0;
        libNtve_gf_SetDialogItemText(g_grimTitle, StringToText("魔典"), PlayerGroupSingle(p));
        BOTC_GrimRender(p);
        BOTC_PmInfo(p, "【-grim】已看回你自己那份魔典。用法：-grim 1 ~ -grim 12 = 看那个座位自己那份；-grim 0 = 看回自己。");
        return;
    }
    g_grimView[p] = g_who[n + 1];      // 座位 n = 格子 n+1 上坐着的人 → 看的就是他那份
    g_grimViewOn[p] = true;
    BOTC_PanelOpen(p, 2);              // 摊开自己的魔典（跟【发起私聊】同一套）
    // 【看得见】（用户 2026-10-07 报「-grim 貌似没用」）：标题写成"正在看谁"，免得以为没生效
    libNtve_gf_SetDialogItemText(g_grimTitle, StringToText("魔典 · 正在看 座位 " + IntToString(n) + "（" + BOTC_NameStr(n + 1) + "）自己那份"), PlayerGroupSingle(p));
    BOTC_GrimRender(p);
    if (!g_seatOn[n + 1]) {
        BOTC_PmInfo(p, "【-grim】注意：座位 " + IntToString(n) + " 现在没有真人（看到的会是空魔典）。");
    }
    BOTC_PmInfo(p, "【-grim】现在看的是 座位 " + IntToString(n) + "（" + BOTC_NameStr(n + 1) + "）自己那份魔典：只有他自己的身份、和他自己打过的标记。发 -grim 0 看回自己。");
}

//==================================================================================================
// 寡妇（75）【用户 2026-09-23】：首个夜晚看一眼说书人的魔典，然后选一个座位让那个人中毒。
//   魔典那套直接复用间谍的 BOTC_SpyPeek / BOTC_SpyPeekEnd（看的是说书人那份实时真魔典）；
//   顺序（用户 2026-11-06）：先看魔典 → 选是否抄录 → 选完（无论抄录与否）再开下毒目标面板，
//   抄录与否都不影响下毒能力。
//   中毒：照官方口径**一直挂到她死亡 / 离场**才解除（不是投毒者那种黄昏到期）。
//   另外「会有一名善良玩家知道寡妇在场」这条按用户要求由说书人自己私聊通知，脚本不管。
//==================================================================================================
bool BOTC_WidowPeek (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    // 【寡妇（75）】（用户 2026-09-26）：按**魔典上写的身份**判断就行（哲学家 / 麻脸造出来的寡妇也能看；酒鬼假扮的会被下面的中毒/酒鬼检查挡住）
    if (BOTC_ActRoleOf(p) != 75) {
        return false;
    }
    if (!BOTC_SkillWorks(p)) {
        // 【中毒 / 醉酒的寡妇】（用户 2026-11-07）：不再直接「打不开」，改为由说书人选择
        //   给她看真实魔典还是伪造魔典；能力已经失效，所以不给下毒面板。
        if (BOTC_SeatIsDrunk(p) || BOTC_SeatIsPoisoned(p)) {
            g_widowP = p;
            BOTC_FakeAskOpen(p, true);
            return true;
        }
        BOTC_Notice(g_who[p], "魔典打不开。");
        BOTC_PmStore(g_teller, "【夜间】寡妇 " + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶，没给她开魔典，也没下毒。");
        return false;
    }
    // 【使用技能】（用户 2026-11-06）：说书人扮演寡妇时直接进下毒面板，不给自己摊真魔典 / 抄录。
    if (p == 1) {
        g_widowP = p;
        BOTC_SkillOpen(p);
        return true;
    }
    // 【罂粟种植者 × 寡妇】（用户 2026-11-06）：罂粟存活且能力生效时，寡妇看不了魔典，
    //   但下毒照常 → 直接进标准选目标面板（失败原因只告诉说书人）。
    //   【按「拥有寡妇能力」判】（用户 2026-11-09）：只有炼金术士 123 相克拿不到这个能力，
    //   他同样看不了魔典、只进标准选目标面板。
    if (BOTC_PoppyActive()) {
        g_widowP = p;
        BOTC_PmStore(g_teller, "【罂粟种植者×寡妇】" + BOTC_NameStr(p) + " 无法查看魔典（罂粟种植者能力生效），但仍可正常下毒。");
        BOTC_SkillOpen(p);
        return true;
    }
    if (BOTC_BorrowedSpyWidow(p, 75)) {
        g_widowP = p;
        BOTC_SkillOpen(p);
        return true;
    }
    g_widowP = p;
    BOTC_SpyPeek(p);            // 把说书人那份（实时）真魔典摊给她看
    if (g_spyP == p) {
        // 【顺序】（用户 2026-11-06）：先看魔典 → 选是否抄录 → 选完（无论抄录与否）再进下毒面板
        BOTC_PmInfo(g_who[p], "【寡妇】这是说书人的魔典（身份 + 所有 token 都能看）。看完先选择是否抄录，然后进入下毒目标选择。");
        BOTC_PmStore(g_teller, "【夜间】寡妇 " + BOTC_NameStr(p) + " 正在看魔典：看完选择是否抄录，再选下毒目标。");
        BOTC_CopyAskOpen(p, true);
        return true;
    }
    BOTC_SkillOpen(p);          // 兜底：魔典没摊开（例如没被唤醒）也照旧给下毒面板
    return true;
}

// 寡妇点座位：下毒（同一时刻只留一个毒：她只能行动一次，所以直接覆盖）
void BOTC_WidowPoison (int q) {
    int p;
    if (q < 2 || q > 13) {
        return;
    }
    p = g_spyP;
    if (p < 2) {
        p = g_widowP;                 // 【借来的寡妇】（用户 2026-10-14）：她没摊开魔典，座位记在 g_widowP
    }
    // 【寡妇自己没能力就不下毒】（用户 2026-10-13）：中毒 / 酒鬼 / 提线木偶 → 这一下不下毒
    if (p >= 2 && !BOTC_SkillWorks(p)) {
        BOTC_SpyPeekEnd();
        BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次没有下毒。");
        return;
    }
    BOTC_WudTryTrigger(q, p);
    BOTC_WidowPoisonClear("寡妇换了目标");
    g_widowP = p;
    g_widowPoison = q;
    // 【用户 2026-10-21】寡妇只写自己的「中毒（寡妇）」96，
    // 不再同时写投毒者的通用中毒 7；两份毒可以独立存在、独立解除。
    g_tokOn[(((g_teller * 14) + q) * 256) + 96] = true;
    BOTC_SpyPeekEnd();                            // 看完这一眼就把魔典收回去
    BOTC_GrimRender(g_teller);
    BOTC_SailorSync();                            // 中毒状态变了：水手那条免死跟着刷新
    BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(p) + " 让 " + BOTC_NameStr(q) + " 中毒（一直挂到寡妇死亡/离场）。");
    // 【寡妇把自己毒了】（用户 2026-11-12）：她刚给自己挂上 96 → 现在已不清醒，
    //   按规则「中毒 / 醉酒的寡妇不会让善良玩家得知寡妇在场」，不弹告知窗口，也不提醒说书人。
    if (p >= 2 && p <= 13 && !BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(p) + " 现在中毒/醉酒 → 不发送「寡妇在场」，也不弹告知窗口。");
        return;
    }
    BOTC_PmStore(g_teller, "【寡妇】记得按规则私聊告诉一名善良玩家「寡妇在场」");
    // 【寡妇清醒下毒后 · 在场告知】（用户 2026-11-02）：由说书人弹窗选择一名善良玩家得知「寡妇在场」。
    //   寡妇中毒 / 醉酒 / 提线木偶时（含把自己毒了的情况）不弹窗。
    if (p >= 2 && p <= 13) {
        BOTC_ManInfoOpenSeats(p, "【寡妇】选择一名善良玩家，让他得知「寡妇在场」；点【取消】= 不告知", 17);
    }
}

// 解除寡妇的毒（她死了 / 离场 / 换局）
void BOTC_WidowPoisonClear (string why) {
    if (g_widowPoison >= 2) {
        // 只撤寡妇自己的 96；如果目标同时被投毒者打上了 7，那一份保持独立。
        g_tokOn[(((g_teller * 14) + g_widowPoison) * 256) + 96] = false;
        BOTC_GrimRender(g_teller);
        BOTC_SailorSync();
        BOTC_PmStore(g_teller, "【寡妇】" + BOTC_NameStr(g_widowPoison) + " 的中毒解除（" + why + "）。");
    }
    g_widowPoison = 0;
}
//==================================================================================================
// 【声称】（白天发动；目前只有猎手）
//   规则：所有人都能声称自己是猎手（谁都能声称），但只有「真的猎手 + 没中毒/酒鬼 + 能力没用掉」
//   才可能真的杀死恶魔；其它情况一律只播报「无事发生」。
//   猎手放空一次之后打「失去能力」token，之后无论怎么声称都只是无事发生。晚上不能声称。
//==================================================================================================
// 【声称 / 猜测中】（用户 2026-11-11）：按钮文字要区分玩家正在「声称」还是「猜测」。
//   返回 0 空闲 / 1 声称中 / 2 猜测中。
//   只看真正开始选目标、填内容的状态；时机不对被拦下的声称（例如提名阶段点精神病患者）
//   不会置位，所以文字保持不变。
int BOTC_DeclareBusyMode (int p) {
    if (p < 1 || p > 13) {
        return 0;
    }
    // 猜测：猜书生 / 猜醉酒、戏法师、猜落难、杂耍艺人（含它的身份网格）、全员追忆猜角色
    if (g_guessKind[p] != 0 || g_alsaOpen[p] || g_damselPick[p]) {
        return 2;
    }
    if (DialogIsVisible(g_juggDlg, p) || (g_pickMode[p] == 13 && DialogIsVisible(g_pickDlg, p))) {
        return 2;
    }
    if (g_pickMode[p] == 51 && DialogIsVisible(g_pickDlg, p)) {
        return 2;
    }
    // 声称：猎手 / 精神病患者 / 月之子 / 呆瓜、造谣者声明、炼金术士
    if (g_declarePick[p] || g_alcChoice[p] || g_alcPick[p]) {
        return 1;
    }
    if (DialogIsVisible(g_gossipDlg, p)) {
        return 1;
    }
    return 0;
}

void BOTC_DeclareRender () {
    int p;
    int m;
    DialogControlSetVisible(g_declareBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_dclaimBtn, PlayerGroupAll(), false);
    BOTC_WinAdminRender();

    if (!g_started || g_isNight) {
        return;
    }
    // 【p 是格子】（用户 2026-10-07 报「声称显示还是按物理玩家」）：这一圈按**格子**走（g_seatOn / BOTC_PublicDead），
    //   所以"发给谁"要用 g_who[p]、"谁在选目标"要用 g_declarePick[g_who[p]]（那两个都是客户端口径）。
    for (p = 1; p <= 13; p += 1) {
        // 【说书人也能用】（用户 2026-09-26）：p = 1 是「说书人」那一格，不在座位表里，所以跳过 g_seatOn 判定
        if (p >= 2 && !g_seatOn[p]) {
            continue;
        }
        if (BOTC_PublicDead(p)) {
            DialogControlSetVisible(g_dclaimBtn, PlayerGroupSingle(g_who[p]), true);
            m = BOTC_DeclareBusyMode(g_who[p]);
            if (m == 1) {
                libNtve_gf_SetDialogItemText(g_dclaimBtn, StringToText("声称中：点头像"), PlayerGroupSingle(g_who[p]));
            }
            else if (m == 2) {
                libNtve_gf_SetDialogItemText(g_dclaimBtn, StringToText("猜测中：点头像"), PlayerGroupSingle(g_who[p]));
            }
            else {
                libNtve_gf_SetDialogItemText(g_dclaimBtn, StringToText("声称"), PlayerGroupSingle(g_who[p]));
            }
        }
        else {
            DialogControlSetVisible(g_declareBtn, PlayerGroupSingle(g_who[p]), true);
            m = BOTC_DeclareBusyMode(g_who[p]);
            if (m == 1) {
                libNtve_gf_SetDialogItemText(g_declareBtn, StringToText("声称中"), PlayerGroupSingle(g_who[p]));
            }
            else if (m == 2) {
                libNtve_gf_SetDialogItemText(g_declareBtn, StringToText("猜测中"), PlayerGroupSingle(g_who[p]));
            }
            else {
                libNtve_gf_SetDialogItemText(g_declareBtn, StringToText("声称/猜测"), PlayerGroupSingle(g_who[p]));
            }
        }

    }
}

// 【死后声称】能选的角色（用户 2026-09-20）：现在只有月之子（36）；以后加新角色往这里加一个就行
bool BOTC_IsDeathClaimRole (int r) {
    return (r == 36 || r == 63);      // 月之子 / 呆瓜（用户 2026-09-21）
}

// 这个座位死后能不能声称这个身份：通用那份（月之子 / 呆瓜），外加
// 【带「保留能力（亡骨魔）」标记的精神病患者】（用户 2026-09-26）---- 他的能力被亡骨魔保住了，死后照样能声称
bool BOTC_CanDeathClaimRole (int r, int p) {
    if (BOTC_IsDeathClaimRole(r)) {
        return true;
    }
    if (r == 84 && p >= 1 && p <= 13 && g_tokOn[(((g_teller * 14) + p) * 256) + 79]) {
        return true;
    }
    return false;
}

// 打开「死后声称」面板：跟白天【声称】一样使用标题下方的固定入口行，只列死亡后可声称的身份。
void BOTC_DClaimOpen (int p) {
    int q;
    int k;
    string s;
    bool amne;
    if (p < 1 || p > 13) {
        return;
    }
    // 【失忆者（73）】在板子上时，死后声称也开放全部死亡声称身份（月之子 / 呆瓜等）。
    amne = BOTC_BoardHasRole(73);
    g_pickMode[p] = 3;
    g_pickWho[p] = 0;
    BOTC_PickFilter(p, false);
    // 【声称弹窗不提供「清除身份」】（用户 2026-11-04）：声称只负责选身份，不能让玩家清掉自己的标记。
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(p), false);
    // 跟白天【声称】一致：不使用普通分类网格，只把死亡后可声称的身份排成一行。
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatBtn[q], PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_pickPagePrev, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageNext, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_pickPageLbl, PlayerGroupSingle(p), false);
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    k = 0;
    s = "";
    if ((amne || BOTC_BoardHasRole(36)) && BOTC_CanDeathClaimRole(36, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 57, 36, k, g_roleName[36]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[36];
        k = k + 1;
    }
    if ((amne || BOTC_BoardHasRole(63)) && BOTC_CanDeathClaimRole(63, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 58, 63, k, g_roleName[63]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[63];
        k = k + 1;
    }
    if ((amne || BOTC_BoardHasRole(84)) && BOTC_CanDeathClaimRole(84, BOTC_PosOf(p))) {
        BOTC_DeclareSlot(p, 59, 84, k, g_roleName[84]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[84];
        k = k + 1;
    }
    // 【死亡爪牙也能猜落难】（用户 2026-11-02）：死后声称面板补一个「猜落难」入口；
    //   每人每天各一次（g_damselDone），真正是否爪牙由 BOTC_DamselGuess 判定。
    if ((amne || BOTC_BoardHasRole(82)) && !g_damselDone[p]) {
        BOTC_DeclareSlot(p, 60, 82, k, "猜落难");
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + "猜落难";
        k = k + 1;
    }
    if (StringLength(s) <= 0) {
        s = "本局没有可以公开声称的角色";
    }
    else {
        s = "声称一个身份（" + s + "）";
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(s), PlayerGroupSingle(p));
    // 【屏蔽 / 踢出玩家】（用户 2026-11-07）：死后声称同样属于声称面板，两个入口一并提供。
    libNtve_gf_SetDialogItemText(g_blockBtnPick, StringToText("屏蔽"), PlayerGroupSingle(p));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(p), true);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 点【死后声称】：白天 + 必须是死人（任何玩家都能点；真月之子才会真结算）
void BOTC_DClaimClick (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【再点一次 = 取消选座】（用户 2026-11-10）：见 BOTC_DeclareClick，死后声称面板同样处理。
    if (g_blockPick[p]) {
        BOTC_BlockEnd(p);
        BOTC_Notice(p, "已取消屏蔽。");
        return;
    }
    if (g_kickMode == p) {
        BOTC_KickPickStart(p);
        BOTC_DeclareRender();
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "声称是白天才能用的（晚上不能声称）。");
        return;
    }
    if (!BOTC_PublicDead(BOTC_PosOf(p))) {
        BOTC_Notice(p, "这是「死后声称」：你还没被公开宣布死亡（红叉），用旁边那个【声称】。");
        return;
    }
    if (g_declarePick[p]) {
        g_declarePick[p] = false;
        g_moonDeclare[p] = false;
        g_klutzDeclare[p] = false;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    BOTC_DClaimOpen(p);
}

// 打开「声称一个身份」面板：复用身份面板，现在只留猎手
// 【声称面板 · 摆一格】（用户 2026-10-03）：把第 slot 格摆到第 k 位（0 起算，从左往右），
//   图标用 role 的夜间图、名字用 lbl（按阵营上色）。声称面板只显示这 7 格，所以统一排一行，
//   不会再出现「哥布林跑到落难那一栏 / 精神病跑到最左边」这种位置错乱。
void BOTC_DeclareSlot (int p, int slot, int role, int k, string lbl) {
    int x;
    int y;
    x = 55 + (k * 105);       // 最多 10 个固定入口也能完整放进面板
    y = 126;
    g_gridSlot[slot] = role;
    g_pickSlotRole[(p * 64) + slot] = role;
    DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
    libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(role), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(lbl), BOTC_RoleTeamColor(role)), PlayerGroupSingle(p));
    DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
}

// 【声称面板 · 摆一格「猜测」】（用户 2026-11-04）：第二行两个公开猜测入口，
//   位置固定、排版跟声称那一行一致；图标沿用书生的夜间图。
void BOTC_DeclareGuessSlot (int p, int slot, int role, int k, string lbl) {
    int x;
    int y;
    x = 55 + (k * 105);
    y = 232;
    g_gridSlot[slot] = role;
    g_pickSlotRole[(p * 64) + slot] = role;
    DialogControlSetPosition(g_pickBtn[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_pickName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x - 10, y + 86);
    libNtve_gf_SetDialogItemImage(g_pickIcon[slot], BOTC_NightIconName(role), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickName[slot], TextWithColor(StringToText(lbl), BOTC_RoleTeamColor(role)), PlayerGroupSingle(p));
    DialogControlSetVisible(g_pickBtn[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickIcon[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_pickName[slot], PlayerGroupSingle(p), true);
}

void BOTC_DeclareOpen (int p) {
    int q;
    int k;
    string s;
    bool amne;
    if (p < 1 || p > 13) {
        return;
    }
    // 【失忆者（73）】在板子上时，显示全部角色的公开声称入口（失忆者可能拥有其中任何一个的能力）。
    amne = BOTC_BoardHasRole(73);
    g_pickMode[p] = 3;
    g_pickWho[p] = 0;
    BOTC_PickFilter(p, false);
    // 【声称弹窗不提供「清除身份」】（用户 2026-11-04）：声称只负责选身份，不能让玩家清掉自己的标记。
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(p), false);
    // 声称面板用的是网格末尾的固定槽，不是可翻页的四类网格。
    for (q = 0; q < 4; q += 1) {
        DialogControlSetVisible(g_pickCatPrev[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickCatNext[q], PlayerGroupSingle(p), false);
    }
    // 【声称面板】（用户 2026-10-03）：先把整个网格藏掉（含上次用过的固定槽），只留可声称身份。
    for (q = 0; q < 64; q += 1) {
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
    }
    // 固定入口、**按角色号从左往右**排：
    //   猎手10 / 造谣者28 / 杂耍艺人58 / 猜落难82 / 精神病患者84 / 炼金术士95 / 哥布林99
    //   槽位用网格末尾那几个板子用不到的格（57..63），位置全由 BOTC_DeclareSlot 里的 k 统一算。
    k = 0;
    s = "";
    if (amne || BOTC_BoardHasRole(10)) {
        BOTC_DeclareSlot(p, 57, 10, k, g_roleName[10]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[10];
        k = k + 1;
    }
    if (amne || BOTC_BoardHasRole(28)) {
        BOTC_DeclareSlot(p, 58, 28, k, g_roleName[28]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[28];
        k = k + 1;
    }
    if (amne || BOTC_BoardHasRole(58)) {
        BOTC_DeclareSlot(p, 59, 58, k, g_roleName[58]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[58];
        k = k + 1;
    }
    // 【猜落难】（82）：每人每天各一次，用过的入口直接藏掉（别人不受影响）。
    if ((amne || BOTC_BoardHasRole(82)) && !g_damselDone[p]) {
        BOTC_DeclareSlot(p, 60, 82, k, "猜落难");
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + "猜落难";
        k = k + 1;
    }
    // 【说书人通过瘟疫医生拿到精神病患者（84）】（用户 2026-11-12）：这条能力是白天的公开声称，
    //   不能靠夜间【说书人：X】按钮结算 → 不显示夜间按钮，改由【声称/猜测】面板里的精神病患者入口发动。
    if (amne || BOTC_BoardHasRole(84) || (p == g_teller && g_pdRole == 85)) {
        BOTC_DeclareSlot(p, 61, 84, k, g_roleName[84]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[84];
        k = k + 1;
    }
    // 【炼金术士(95) × 间谍/寡妇】：板子同时提供炼金术士与间谍 / 寡妇时保留公开声称入口。
    if ((amne || BOTC_BoardHasRole(95)) && (amne || BOTC_BoardHasRole(18) || BOTC_BoardHasRole(75))) {
        BOTC_DeclareSlot(p, 62, 95, k, g_roleName[95]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[95];
        k = k + 1;
    }
    if (amne || BOTC_BoardHasRole(99)) {
        BOTC_DeclareSlot(p, 63, 99, k, g_roleName[99]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[99];
        k = k + 1;
    }
    // 【异教领袖（106）】（用户 2026-10-10）：**任何人都可以声称**自己是异教领袖 → 开 20 秒全员投票
    if (amne || BOTC_BoardHasRole(106)) {
        BOTC_DeclareSlot(p, 56, 106, k, g_roleName[106]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[106];
        k = k + 1;
    }
    // 维齐尔：本轮有人被提名后开放，整个提名阶段都可声称；每个玩家本轮只能点一次。
    if (BOTC_BoardHasRole(141) && g_phase >= 1 && g_phase <= 6 && g_vizierSeat >= 2 && !g_vizierClaimed[p]) {
        BOTC_DeclareSlot(p, 55, 141, k, g_roleName[141]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[141];
        k = k + 1;
    }
    if (amne || BOTC_BoardHasRole(149)) {
        BOTC_DeclareSlot(p, 54, 149, k, g_roleName[149]);
        if (StringLength(s) > 0) { s = s + " / "; }
        s = s + g_roleName[149];
        k = k + 1;
    }
    // 【声称/猜测】（用户 2026-11-04）：第二行两个公开猜测入口。
    //   正常剧本里板子上没有书生(152) / 解谜大师(109) 就不显示；板子上有失忆者(73) 时两个都显示。
    //   其中只有猜书生、猜醉酒、全员追忆的猜角色算「猜测」，不占 15 秒声称冷却。
    //   每人每局各一次，用过的入口直接藏掉。
    q = 0;
    if (amne || BOTC_BoardHasRole(152)) {
        if (!g_pedantGuessUsed[p]) {
            BOTC_DeclareGuessSlot(p, 52, 152, q, "猜书生");
            if (StringLength(s) > 0) { s = s + " / "; }
            s = s + "猜书生";
            q = q + 1;
        }
    }
    if (amne || BOTC_BoardHasRole(109)) {
        if (!g_puzzleGuessUsed[p]) {
            BOTC_DeclareGuessSlot(p, 53, 109, q, "猜醉酒");
            if (StringLength(s) > 0) { s = s + " / "; }
            s = s + "猜醉酒";
            q = q + 1;
        }
    }
    // 【全员追忆 · 猜角色】（用户 2026-11-06）：板子 13 独有入口，每天限一次，猜对后本局永久隐藏。
    //   槽位 51（固定入口，role 传 0 只是占位，真正的模式切换在 BOTC_PickChoose 里处理）。
    if (g_board == 13 && p != g_teller && g_started) {
        if (!g_guessRoleDone[p] && g_guessRoleDay[p] != g_dayNum) {
            BOTC_DeclareGuessSlot(p, 51, 0, q, "猜角色");
            if (StringLength(s) > 0) { s = s + " / "; }
            s = s + "猜角色";
            q = q + 1;
        }
    }
    if (StringLength(s) <= 0) {
        s = "本局没有可以公开声称的角色";
    }
    else {
        s = "声称一个身份（" + s + "）";
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(s), PlayerGroupSingle(p));
    // 【屏蔽 / 踢出玩家】（用户 2026-11-07）：声称/猜测面板也提供这两个入口，所有人（含说书人）都能看到。
    //   屏蔽在这里没有具体目标，文字固定为「屏蔽」，点了走原来的「点一个座位屏蔽 / 解除屏蔽」流程。
    libNtve_gf_SetDialogItemText(g_blockBtnPick, StringToText("屏蔽"), PlayerGroupSingle(p));
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(p), true);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

// 点【声称】按钮：白天才能用；已经在选目标时再点一次 = 取消
void BOTC_DeclareClick (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【再点一次 = 取消选座】（用户 2026-11-10）：从声称/猜测面板点了【屏蔽】或【踢出玩家】之后，
    //   魔典上还留着【声称/猜测】；此时再点它就是退出选座，不用非得点一个座位才能脱身。
    if (g_blockPick[p]) {
        BOTC_BlockEnd(p);
        BOTC_Notice(p, "已取消屏蔽。");
        return;
    }
    if (g_kickMode == p) {
        BOTC_KickPickStart(p);           // 内部会退出选座并提示「已取消踢人投票」
        BOTC_DeclareRender();            // 按钮文字还原成【声称/猜测】
        return;
    }
    if (!g_started || g_isNight) {
        BOTC_Notice(p, "声称是白天才能用的（晚上不能声称）。");
        return;
    }
    if (BOTC_PublicDead(BOTC_PosOf(p))) {
        BOTC_Notice(p, "你已经死了（红叉已经盖上），不能声称。（月之子是「死后选人」，用他自己的按钮）");
        return;
    }
    if (g_declarePick[p]) {
        g_declarePick[p] = false;
        g_guessKind[p] = 0;          // 【取消猜测】（用户 2026-11-04）
        g_psyDeclare[p] = false;     // 精神病患者 / 月之子 / 呆瓜的选人阶段一起复位
        g_moonDeclare[p] = false;
        g_klutzDeclare[p] = false;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    if (g_alcChoice[p] || g_alcPick[p]) {
        g_alcChoice[p] = false;
        g_alcPick[p] = false;
        g_alcRolePick[p] = 0;
        DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
        // 还在「猜间谍/寡妇」的身份网格（模式 20）也一起收掉
        if (g_pickMode[p] == 20) {
            g_pickMode[p] = 0;
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        }
        // 说书人那边正在替这个座位挑借来的爪牙（模式 21）同样收起
        if (g_pickMode[g_teller] == 21 && g_pickWho[g_teller] == p) {
            g_pickMode[g_teller] = 0;
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
        }
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消声称。");
        return;
    }
    if (g_alsaOpen[p]) {
        BOTC_AlsaahirCancel(p);
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消戏法师猜测。");
        return;
    }
    // 【面板里的后续步骤都能用同一个按钮取消】（用户 2026-11-08）：造谣者输入框、
    //   杂耍艺人猜测（含其中的选身份网格）、全员追忆猜角色、猜落难。
    //   维齐尔 / 哥布林 / 异教领袖点击即公开播报，发出去就收不回来，不在可取消之列。
    if (DialogIsVisible(g_gossipDlg, p)) {
        DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消造谣者声明。");
        return;
    }
    if (DialogIsVisible(g_juggDlg, p) || (g_pickMode[p] == 13 && DialogIsVisible(g_pickDlg, p))) {
        if (g_pickMode[p] == 13) {
            g_pickMode[p] = 0;
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        }
        BOTC_JugglerCancel(p);
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消杂耍艺人猜测。");
        return;
    }
    if (g_pickMode[p] == 51 && DialogIsVisible(g_pickDlg, p)) {
        g_pickMode[p] = 0;
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消猜角色。");
        return;
    }
    if (g_damselPick[p]) {
        g_damselPick[p] = false;
        BOTC_DeclareRender();
        BOTC_Notice(p, "已取消猜落难。");
        return;
    }
    // 【再点 = 关闭】（用户 2026-11-08）：声称/猜测面板已经打开时再点同一按钮直接收起，
    //   不再重复打开；面板里的身份网格随面板一起关掉。
    if (g_pickMode[p] == 3 && DialogIsVisible(g_pickDlg, p)) {
        g_pickMode[p] = 0;
        g_pickWho[p] = 0;
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        BOTC_Notice(p, "已关闭声称。");
        return;
    }
    BOTC_DeclareOpen(p);
}

// 【猎手 / 精神病请求排队】（用户 2026-11-01）：说书人手里那个 15 秒判定弹窗还没拍板时，
//   其他人不能再发起同类声称，防止新请求把旧弹窗顶掉。魔像 / 贞洁者只在自动判定倒计时未结束时短暂占用。
bool BOTC_SlayAskBusy () {
    if (g_snipeStage != 0) {
        return true;                   // 猎手击杀过场还没结算完，也不许再声称
    }
    if (!g_slayAskOn) {
        return false;
    }
    if (g_slayAskGolem || g_slayAskVirgin) {
        // 自动判定倒计时（1..5 秒）期间短暂占用，避免新声称把待结算的魔像 / 贞洁者顶掉
        return (g_slayAuto && g_slayAskSec > 0);
    }
    return true;
}

// 【牙噶巴卜（133）/ 无神论者（83）在场】（用户 2026-11-04）：猎手 / 精神病的声称一律弹给说书人，
//   而且不管发起人是不是真角色，两个按钮都能点（这两张牌本来就需要说书人多裁定）。
bool BOTC_SlayAskManual () {
    return (BOTC_RoleTrueInPlay(133) || BOTC_RoleTrueInPlay(83));
}

// 声称之后点头像：判决这次声称
// 【声称/猜测 · 恶魔猜书生】（用户 2026-11-04）
//   · 任何玩家都能点、都能猜；只有真实恶魔（且能力生效）的猜测才算有效。
//   · 无效猜测只记在说书人私聊里，不给任何公开节奏差异。
//   · 有效的恶魔猜测：不管猜没猜中，真书生都拿 token 180「已被猜测（书生）」；
//     猜中了恶魔再拿 token 171「已猜测（书生）」，夜里在书生夜序多杀一次。
void BOTC_GuessPedant (int p, int q) {
    int ob;
    int ped;
    int pk;
    ob = g_who[p];
    g_declarePick[ob] = false;
    g_guessKind[ob] = 0;
    BOTC_DeclareRender();
    g_pedantGuessUsed[ob] = true;
    // 有效性：真恶魔 + 能力没有失效（中毒 / 醉酒 / 提线木偶时按失效处理）
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(p)) != 3) {
        BOTC_GrimRender(g_teller);     // 假声称：不给说书人私聊提醒（用户 2026-11-04）
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【书生猜测】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(q) + " → 他是恶魔，但中毒/醉酒/提线木偶 → 无效猜测。");
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【书生在场按能力层找】（用户 2026-11-04）：与 BOTC_PedantInPlay 同一口径，
    //   真身书生、哲学家借来的、说书人赋予的都算；不能只按真身 152 查找，否则借来的书生永远不会被猜中。
    ped = 0;
    for (pk = 2; pk <= 13; pk += 1) {
        if (ped == 0 && g_seatOn[pk] && BOTC_HasAbility(pk, 152)) {
            ped = pk;
        }
    }
    pk = ped;
    // 无论猜没猜中，真书生都获得「已被猜测」标记
    if (pk >= 2) {
        g_tokOn[(((g_teller * 14) + pk) * 256) + 180] = true;
    }
    if (pk >= 2 && q == pk) {
        // 猜中：恶魔获得额外攻击
        g_tokOn[(((g_teller * 14) + p) * 256) + 171] = true;
        BOTC_PmStore(g_teller, "【书生猜测】" + BOTC_NameStr(p) + " 猜中 " + BOTC_NameStr(q) + " 就是书生 → 恶魔今夜在书生夜序额外杀一次。");
        BOTC_Notice(g_teller, "【书生】恶魔猜中了书生：恶魔取得额外攻击，本夜书生夜序会唤醒他。");
    }
    else {
        BOTC_PmStore(g_teller, "【书生猜测】" + BOTC_NameStr(p) + " 猜 " + BOTC_NameStr(q) + " → 没猜中；书生已获得「已被猜测」标记。");
    }
    BOTC_GrimRender(g_teller);
}

// 【声称/猜测 · 解谜大师】（用户 2026-11-04）
//   · 任何玩家都能点；只有真解谜大师（或借到该能力的人）的猜测才算有效。
//   · 有效时：真解谜大师拿 token 130「已猜测（解谜大师）」；说书人弹框自己填要告诉他的座位号，
//     猜对 / 猜错 / 中毒醉酒都由说书人自己判。
void BOTC_GuessPuzzle (int p, int q) {
    int ob;
    int real;
    ob = g_who[p];
    g_declarePick[ob] = false;
    g_guessKind[ob] = 0;
    BOTC_DeclareRender();
    g_puzzleGuessUsed[ob] = true;
    if (!BOTC_HasAbility(p, 109)) {
        BOTC_GrimRender(g_teller);     // 假声称：不给说书人私聊提醒（用户 2026-11-04）
        return;
    }
    if (!BOTC_AbilityWorks(p, 109)) {
        BOTC_PmStore(g_teller, "【解谜大师猜测】" + BOTC_NameStr(p) + " 中毒/醉酒 → 能力失效，结果由你裁定。");
    }
    real = BOTC_SeatOfRole(109);
    if (real < 2 || real > 13) {
        real = p;
    }
    g_tokOn[(((g_teller * 14) + real) * 256) + 130] = true;
    BOTC_ManInfoOpen(p, 109, "他白天公开猜 " + BOTC_NameStr(q) + "。填一个座位号告他（猜对 / 猜错 / 中毒醉酒由你判断）");
    BOTC_GrimRender(g_teller);
}

// 【全员追忆 · 猜角色 · 打开面板】（用户 2026-11-06）
//   进入模式 51，只显示玩家当前阵营的真实角色（排除占位身份 143..146）。
void BOTC_GuessRoleOpen (int p) {
    int seat;
    int team;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_board != 13) {
        return;
    }
    if (!g_started) {
        BOTC_Notice(p, "游戏正式开始后才能猜角色。");
        return;
    }
    if (p == g_teller) {
        BOTC_Notice(p, "说书人不需要猜自己的身份。");
        return;
    }
    seat = BOTC_PosOf(p);
    if (seat < 2 || seat > 13) {
        return;
    }
    // 每天限一次
    if (g_guessRoleDay[p] == g_dayNum) {
        BOTC_Notice(p, "你今天已经猜过角色了，明天再来。");
        return;
    }
    // 猜对后本局永久隐藏
    if (g_guessRoleDone[p]) {
        BOTC_Notice(p, "你这局已经猜对过身份，不需要再猜了。");
        return;
    }
    // 按玩家当前占位身份读阵营（全员追忆玩家只看到占位身份）
    team = BOTC_RoleTeam(BOTC_SeatTrueRole(seat));
    g_pickMode[p] = 51;
    g_pickWho[p] = seat;
    g_pickTeam = team;       // 只显示同阵营角色
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    // 标题
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("猜角色（每天限一次）—— 选一个你猜测的" + BOTC_TeamName(team)), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
    BOTC_DeclareRender();              // 按钮文字切到「猜测中」
}

// 【全员追忆 · 猜角色 · 选定比对】（用户 2026-11-06）
//   玩家选了一个角色，跟自己的真身份比对。猜对 → 身份替换成真角色 + 本局隐藏按钮；
//   猜错 → 只发反馈。两种情况都通知说书人。
void BOTC_GuessRoleResolve (int p, int roleIdx) {
    int seat;
    int real;
    bool correct;
    if (p < 1 || p > 13 || roleIdx < 0 || roleIdx > 163) {
        return;
    }
    seat = BOTC_PosOf(p);
    real = BOTC_SeatTrueRole(seat);
    correct = (roleIdx == real);
    // 记录今天已经猜过（无论对错都消耗次数）
    g_guessRoleDay[p] = g_dayNum;
    // 玩家反馈
    if (correct) {
        BOTC_Notice(p, "【猜角色】恭喜你猜对了！你的真实身份是【" + g_roleName[real] + "】。");
        // 把玩家魔典上自己的占位卡替换成真角色（全员追忆规则：玩家只看到占位身份，
        //   但猜对后应该揭示真身份）
        g_mark[(p * 14) + seat] = real + 1;
        // 本局永久隐藏按钮
        g_guessRoleDone[p] = true;
        BOTC_PmStore(g_teller, "【全员追忆 · 猜角色】" + BOTC_NameStr(seat) + " 猜对了！他猜的是【" + g_roleName[roleIdx] + "】，真实身份就是【" + g_roleName[real] + "】。他自己的魔典也替换成真角色。");
    }
    else {
        BOTC_Notice(p, "【猜角色】很遗憾，猜错了。你猜的是【" + g_roleName[roleIdx] + "】。明天还能再猜一次。");
        BOTC_PmStore(g_teller, "【全员追忆 · 猜角色】" + BOTC_NameStr(seat) + " 猜错了。他猜的是【" + g_roleName[roleIdx] + "】，真实身份是【" + g_roleName[real] + "】。");
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(p);
    BOTC_DeclareRender();
}

void BOTC_DeclareSlay (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13) {
        return;
    }
    // 【声称/猜测】（用户 2026-11-04）：第二行两个猜测入口点完头像后走这里。
    if (g_guessKind[g_who[p]] == 1) {
        BOTC_GuessPedant(p, q);
        return;
    }
    if (g_guessKind[g_who[p]] == 2) {
        BOTC_GuessPuzzle(p, q);
        return;
    }
    // 月之子（36）专用按钮进入的「点头像」阶段：点头像 = 公开选一名存活玩家（不是猎杀）
    if (g_moonDeclare[g_who[p]]) {
        BOTC_MoonChildDeclare(p, q);
        return;
    }
    // 呆瓜（63）专用按钮进入的「点头像」阶段：点头像 = 公开选一名存活玩家（用户 2026-09-21）
    if (g_klutzDeclare[g_who[p]]) {
        BOTC_KlutzPick(p, q);
        return;
    }
    // 【请求排队】（用户 2026-11-01）：上一个猎手 / 精神病判定还没答完，不许再发起同类声称
    if (BOTC_SlayAskBusy()) {
        BOTC_Notice(g_who[p], "说书人还在处理上一个【猎手 / 精神病患者】请求（15 秒），请等一下再声称。");
        return;
    }
    // 精神病患者（84）：点头像 = 公开选一名玩家（说书人拍板生死）
    if (g_psyDeclare[g_who[p]]) {
        BOTC_PsyPick(p, q);
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    if (!g_started || g_isNight) {
        return;
    }
    if (BOTC_SeatDead(p) || g_declareUsed[g_who[p]]) {
        g_declarePick[g_who[p]] = false;
        BOTC_DeclareRender();
        if (g_declareUsed[g_who[p]]) {
            BOTC_Notice(g_who[p], "你今天已经声称过【猎手】了：每人每天只能声称一次。");
        }
        return;                        // 死了 / 已经声称过：这次点头像不算
    }
    g_declarePick[g_who[p]] = false;
    BOTC_DeclareRender();
    g_declareUsed[g_who[p]] = true;           // 猎手这次声称用掉（不管后面判成什么样，当天只有这一次）
    // 所有人都看得到：谁声称自己是猎手、要猎杀谁
    BOTC_PubAnnounce(BOTC_NameStr(p) + " 声称自己是【猎手】，并选择猎杀 " + BOTC_NameStr(q) + "。");
    BOTC_DeclareCdSet(g_who[p]);
    // 【真人说书】**所有人声称都弹这个提示**（用户 2026-09-16 定稿：统一处理，方便恶魔伪装）----
    //   不管他是真猎手、中毒的猎手、以为自己是猎手的酒鬼，还是纯粹的假声称，看到的都是
    //   「等说书人拍板」这一套；真正的答案只写给说书人（弹窗上的按钮组合 + 他私聊日志里那行
    //   BOTC_SlayHintStr 文案 ---- 弹窗正文 2026-09-16 按要求精简成「标题 + 按钮」）。
    //   这样「当场就出无事发生」这条信息渠道就没了，谁都没法靠节奏猜自己失效、也没法靠节奏分辨自称真假。
    //   （点【是】= 走击杀那套过场，点【否】= 无事发生）
    BOTC_SlayAsk(p, q);
    return;
    // 以下都是【智能说书】的自动判定（电脑说书人一律当场判，不存在「被酒鬼看出破绽」的问题）
    // 不是真猎手（含酒鬼）：只是声称，无事发生
    if (BOTC_SeatTrueRole(p) != 10) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        return;
    }
    // 中毒 / 酒鬼 / 提线木偶：能力失效（本人不当场知道），这一次也算用掉了
    if (!BOTC_SkillWorks(p)) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        BOTC_LoseAbility(p, 12);
        return;
    }
    // 已经放过一次了
    if (g_tokOn[(((g_teller * 14) + p) * 256) + 12]) {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        return;
    }
    // 真的在射：目标是恶魔就死，其它人无事发生（能力都用掉）
    //   ⚠ 这里看的是**猎手眼里的登记**，不是真身：陌客有概率被登记成「恶魔」（`g_pairTeam == 3`），
    //     那时猎手打他也会真的打死他（陌客的能力就是「可能被看成恶魔」）。
    //     占卜师专用的那条「假干扰项」不算进来（那是占卜师的东西，猎手不吃）。
    //   【相克 · 猎手 × 痢蛭】（用户 2026-11-11）：目标是痢蛭的宿主时也照打。
    if ((BOTC_PairTeam(p, q) == 3) || BOTC_SlayLeechHost(q)) {
        // 「命中了恶魔」这句**不在这里播** ---- 要等枪声响起、恶魔真的死了再播（见 BOTC_SnipeFunc）
        BOTC_SlayKill(p, q);
        return;
    }
    BOTC_PubAnnounce("【说书人】：无事发生。");
    BOTC_LoseAbility(p, 12);
}

//--------------------------------------------------------------------------------------------------
// 【猎手请求】：猎手声称 + 点头像之后，由说书人决定「是否让他击杀」
//   智能说书（g_aiMode）不弹窗，直接按规则自动判（见上面 BOTC_DeclareSlay）；
//   真人说书时无论他点的是谁，都弹给说书人：点【是】= 执行击杀那套过场，点【否】= 播「无事发生」。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildSlayAsk () {
    // 【2026-09-16】去掉黑底、去掉正文与参考两行：只留标题（谁猎杀谁 + 是否击杀）和按钮
    // 【技能框往右挪 200】（用户 2026-09-23）：猎手「是否让他击杀」那个框
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_slayDlg = DialogLastCreated();
    DialogSetVisible(g_slayDlg, PlayerGroupAll(), false);
    g_slayTitle = BOTC_NewLabel(g_slayDlg, 666, 44, 18, 13, StringToText("猎手声称：是否让他击杀？"));
    libNtve_gf_SetDialogItemStyle(g_slayTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_slayTitle, false, PlayerGroupAll());
    g_slayYes = BOTC_NewButton(g_slayDlg, 306, 50, 27, 81, "是：让他击杀");
    g_slayNo = BOTC_NewButton(g_slayDlg, 306, 50, 351, 81, "否：无事发生");
    // 【静默的否】（用户 2026-09-26）：贞洁者 / 魔像这些「不是声称」的技能用它 ---- 点了公屏一个字都不播
    g_slayNo2 = BOTC_NewButton(g_slayDlg, 306, 50, 351, 81, "否：不发动");
    DialogControlSetVisible(g_slayNo2, PlayerGroupAll(), false);
    // 【右上角 X】（用户 2026-11-01）：说书人的判定弹窗都能直接关掉，X = 选【否】
    g_slayX = BOTC_NewButton(g_slayDlg, 30, 26, 640, 6, "X");
    // 弹窗只有说书人（玩家1）看得到、点得到 ---- 其它玩家连按钮都没有
    DialogControlSetVisible(g_slayYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_slayNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_slayX, PlayerGroupAll(), false);
    DialogControlSetVisible(g_slayYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_slayNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_slayX, PlayerGroupSingle(g_teller), true);
}

//--------------------------------------------------------------------------------------------------
// 【利维坦×陌客 · 说书人判定框】（用户 2026-11-02）：和猎手判定框同尺寸同位置，
//   【是】= 这次处决按善良阵营计入；【否】/ 右上角 X = 按邪恶不计入。
//   只有说书人看得到、点得到，其它玩家连按钮都没有。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildLevRecluse () {
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_levRecDlg = DialogLastCreated();
    DialogSetVisible(g_levRecDlg, PlayerGroupAll(), false);
    g_levRecTitle = BOTC_NewLabel(g_levRecDlg, 666, 44, 18, 13, StringToText("【利维坦】陌客处决：是否按善良阵营计入？"));
    libNtve_gf_SetDialogItemStyle(g_levRecTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_levRecTitle, false, PlayerGroupAll());
    g_levRecYes = BOTC_NewButton(g_levRecDlg, 306, 50, 27, 81, "是：按善良计入");
    g_levRecNo = BOTC_NewButton(g_levRecDlg, 306, 50, 351, 81, "否：不计入");
    g_levRecX = BOTC_NewButton(g_levRecDlg, 30, 26, 640, 6, "X");
    DialogControlSetVisible(g_levRecYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_levRecNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_levRecX, PlayerGroupAll(), false);
    DialogControlSetVisible(g_levRecYes, PlayerGroupSingle(g_teller), true);
