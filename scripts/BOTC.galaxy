}

string BOTC_BoardStar (int n) {
    if (n <= 0) { return ""; }
    if (n == 1) { return "★"; }
    if (n == 2) { return "★★"; }
    if (n == 3) { return "★★★"; }
    if (n == 4) { return "★★★★"; }
    return "★★★★★";
}

