int         g_kickBtnPick;        // 【踢出玩家】按钮（紧挨【屏蔽】右边；只在身份标记 / 声称面板出现；所有人共用冷却）
int[14]     g_pickBtnOff;         // 屏蔽 / 踢出按钮是否已经被 0.5 秒 tick 收起来（避免每拍重复设置控件）
bool[14]    g_blockPick;          // 「屏蔽」选人模式：正在魔典上点座位选要屏蔽 / 解除屏蔽的玩家
bool[196]   g_block;              // 屏蔽关系：索引 (屏蔽者 * 14) + 被屏蔽者
int         g_saySeatBtn;         // 魔典上的「说书人」格子（透明按钮：平时不可点，只在「发起私聊」选人模式里能点）
int         g_saySeatLbl;         // 「说书人」格子里的那行字（只有三个字，没有座位号、没有图标）

