        g_grimRole[q] = BOTC_NewLabelC(g_grimDlg, 112, 22, g_seatX[i] - 56, g_seatY[i] - 50, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_grimRole[q], g_grimNameStyle, PlayerGroupAll());
