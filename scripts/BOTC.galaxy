    if (b == 1) { return 1; }        // 暗流涌动
    if (b == 2) { return 3; }        // 黯月初升
    if (b == 3) { return 4; }        // 梦殒春宵
    if (b == 4) { return 2; }        // 瓦釜雷鸣
    if (b == 5) { return 3; }        // 夜半狂欢
    if (b == 6) { return 3; }        // 罂粟花开
    if (b == 8) { return 3; }        // 横行霸道
    if (b == 9) { return 3; }        // 何方教众
    if (b == 10) { return 4; }       // 风雅集
    if (b == 11) { return 4; }       // 心理博弈 XI
    if (b == 12) { return 2; }       // 信口雌黄
    if (b == 13) { return 5; }       // 全员追忆
    if (b == 14) { return 2; }       // 成双成对
    if (b == 15) { return 4; }       // 移花接木
    return 0;
}

