    g_tipLine[687] = TextWithColor(StringToText("魔鬼代言人"), Color(255, 69, 0)) + StringToText("也不能选择被当作死亡的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("。");
