// 【智能说书支持的板子】（用户 2026-09-20）：黯月初升（2）那些角色的自动判定还没做完，
//   智能说书跑这张板子会发错身份 / 中途卡住 ---- 先只让智能说书用暗流涌动（1）。
//   真人说书完全不受影响：说书人自己点板子，照样能开黯月初升。

// 这张板子智能说书能不能跑（true = 暂不支持自动说书）

// 智能说书模式下点了【暂不支持自动说书】的板子：提示投票的人 + 全屏一行字幕

// 选板子期间变黑用的光照名字 ---- 就是你自己在数据编辑器里做的那套纯黑光照（black）。
//   名字必须跟数据编辑器里显示的完全一致（大小写也算）；如果变黑没反应/是硬切，
//   先确认这里写的是不是数据里那个名字。
string BOTC_BoardLightName () {
    return "black";
}

// 【私聊可见性 · 跨局持久化】（用户 2026-11-02 / 2026-11-03）：原来的开关只活在当前地图里，
//   重新进一局就会回到默认「开启」。现在按说书人账号存进 bank 的 opts 章节（键 pmv），
//   下次加载地图 / 换说书人后自动恢复上次的设置；没有保存过时默认「关闭」（私聊频道不可见）。
void BOTC_PmVisLoad (int p) {
    bank bk;
    if (p < 1 || p > 13) {
        return;
    }
    // 【不在 tick 里读档】（用户 2026-11-11 反馈全场卡死）：交接说书人时这条链
    //   BOTC_LeftCheck → BOTC_TellerHandover → BOTC_AfterSeatChange → BOTC_PmVisSync
    //   全部跑在 0.5 秒 tick 里。原来的做法是逐人 BankLoad + BankWait
    //   的阻塞调用，只要有一份 bank 因为掉线 / Battle.net 同步没返回，整条脚本线程
    //   就停在这里 → 全场（含说书人）同时卡死。开局已经加载并等待过，这里只读缓存句柄。
    if (!g_bankInit) {
        return;
    }
    bk = g_bank[p];
    if (BankKeyExists(bk, "opts", "pmv")) {
        g_pmVisOn = BankValueGetAsInt(bk, "opts", "pmv") != 0;
    }
    else {
        // 【默认不可见】（用户 2026-11-03）：没有保存过设置的说书人默认只看到自己所在的私聊。
        g_pmVisOn = false;
    }
}

void BOTC_PmVisSave () {
    bank bk;
    int v;
    bk = BOTC_MyBank();
    v = 0;
    if (g_pmVisOn) {
        v = 1;
    }
    BankValueSetFromInt(bk, "opts", "pmv", v);
    BankSave(bk);
}

// 【跟随说书人】：换座位 / 交接说书人后只读一次，之后本地开关以内存里的值为准。
void BOTC_PmVisSync () {
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (g_pmVisFor == g_teller) {
        return;
    }
    // 【不在 tick 里阻塞读档】（用户 2026-11-11）：存档还没就绪时先不同步，
    //   保留 g_pmVisFor 让下次（加载完成后的重建 / 换位）重新读，而不是在这里 BankWait。
    if (!g_bankInit) {
        return;
    }
    g_pmVisFor = g_teller;
    BOTC_PmVisLoad(g_teller);
}

// 【私聊可见性】选板子页右上角的开关：只改非说书人看到的会话列表，不影响已有私聊内容。
void BOTC_PmVisRender () {
    BOTC_PmVisSync();
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    if (!g_boardOpen || g_cOpen) {
        return;
    }
    if (g_pmVisOn) {
        libNtve_gf_SetDialogItemText(g_pmVisBtn, StringToText("私聊可见性：开启"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_pmVisBtn, StringToText("私聊可见性：关闭"), PlayerGroupSingle(g_teller));
    }
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupSingle(g_teller), true);
}

void BOTC_PmVisToggle () {
    g_pmVisOn = !g_pmVisOn;
    // 【保存到账号】（用户 2026-11-02）：立刻落盘，下一局 / 下次进图继续沿用。
    BOTC_PmVisSave();
    g_pmVisFor = g_teller;
    BOTC_PmVisRender();
    BOTC_RefreshSessListAll();
    if (g_pmVisOn) {
        BOTC_NoticeKeep(g_teller, "【私聊可见性】已开启：恢复显示所有进行中的私聊。");
    }
    else {
        BOTC_NoticeKeep(g_teller, "【私聊可见性】已关闭：非说书人只保留自己所在的私聊。");
    }
}

// 建选板子的页面（含黑屏遮罩）
// 【黑布独立一层】（用户 2026-10-04）：开局那块黑幕原来建在选板子页（g_boardDlg）里，而 g_boardDlg
//   建得比聊天窗**晚** → 黑布压在聊天框上面，选板子阶段根本看不到聊天。
//   现在把黑布拆成**自己一个对话框**，并且**全图最先创建 = 最低图层**：
//     黑布（最低）→ 汉字预热 → 聊天窗（公聊 / 私聊）→ …其它面板… → 选板子页 / 自定义剧本面板（最高）
//   于是选板子阶段：聊天框显示在黑布上面；选板子按钮 / 自定义剧本按钮仍然压在聊天框上面，照样能点。
void BOTC_BuildBlack () {
    int i;
    int x;
    int y;
    // 黑屏遮罩：11 列 x 7 行 = 77 块（2640 x 1512），块之间留 16px 重叠，免得交界处有缝
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_blackDlg = DialogLastCreated();
    DialogSetVisible(g_blackDlg, PlayerGroupAll(), false);
    for (i = 0; i < 77; i += 1) {
        x = (i % 11) * 240;
        y = (i / 11) * 216;
        libNtve_gf_CreateDialogItemImage(g_blackDlg, 256, 216, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_blackTile[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_blackTile[i], PlayerGroupAll(), c_anchorTopLeft, x, y);
        libNtve_gf_SetDialogItemAcceptMouse(g_blackTile[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_blackTile[i], "botc_black.dds", PlayerGroupAll());
        DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), false);
    }
}

void BOTC_BuildBoard () {
    int i;
    int x;
    int y;
    string s;
    // 对话框开得比屏幕大，保证各种分辨率都能盖满
    DialogCreate(2640, 1512, c_anchorTopLeft, 0, 0, false);
    g_boardDlg = DialogLastCreated();
    // 【关掉对话框自己的底图】（用户 2026-10-04 报「整个选板子页的对话框显形了」）：
    //   对话框创建时自带一张底图/边框；以前 77 块黑布就在这个对话框里、正好把它盖住，
    //   现在黑布搬成独立对话框了 → 底图整块露出来。关掉它，页面就只剩封面 / 按钮 / 设置。
    DialogSetImageVisible(g_boardDlg, false);
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), false);
    // 【黑屏遮罩搬走了】（用户 2026-10-04）：77 块黑布现在建在 BOTC_BuildBlack() 里（最早创建 = 最低图层）。
    //   这个页面本体只留标题 / 封面 / 板子按钮 / 本局设置；它自己建得最晚，所以压在聊天框上面。
    g_boardTitle = BOTC_NewLabelC(g_boardDlg, 900, 64, 510, 150, StringToText("选择板子"));
    libNtve_gf_SetDialogItemStyle(g_boardTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardTitle, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);
    g_boardHint = BOTC_NewLabelC(g_boardDlg, 1400, 36, 260, 222, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_boardHint, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardHint, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    // 倒计时单独一个标签，而且必须用「左对齐」的（居中标签每次更新会重新居中、整串左右跳，看着像闪）
    g_boardTime = BOTC_NewLabel(g_boardDlg, 800, 36, 700, 266, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_boardTime, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_boardTime, false, PlayerGroupAll());
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);
    // 【一级分类】（用户 2026-11-01）：官方剧本 / 更多剧本
    g_boardTabOfficial = BOTC_NewButton(g_boardDlg, 220, 48, 40, 24, "【官方剧本】");
    DialogControlSetVisible(g_boardTabOfficial, PlayerGroupAll(), false);
    g_boardTabMore = BOTC_NewButton(g_boardDlg, 220, 48, 280, 24, "更多剧本");
    DialogControlSetVisible(g_boardTabMore, PlayerGroupAll(), false);
    // 当前参与人数：按实际在场玩家自动统计，只读（用户 2026-11-01 删除手动调整）
    g_seatInfoLbl = BOTC_NewLabel(g_boardDlg, 900, 36, 980, 956, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_seatInfoLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_seatInfoLbl, false, PlayerGroupAll());
    DialogControlSetVisible(g_seatInfoLbl, PlayerGroupAll(), false);
    // 【选板页右下角开始按钮】：先选剧本打钩，再点开始走 10 秒准备倒计时。
    g_boardStartBtn = BOTC_NewButton(g_boardDlg, 280, 50, 1600, 930, "开始说书");
    libNtve_gf_SetDialogItemStyle(g_boardStartBtn, "CustomMenuBarButton", PlayerGroupAll());
    DialogSetVisible(g_boardStartBtn, PlayerGroupAll(), false);
    // 【私聊可见性】选板子页右上角，仅说书人可见；状态不随切换板子重置。
    //   【下移一行】（用户 2026-11-11）：右上角第一行留给【竞选角色】【菜单】，这里挪到第二行。
    g_pmVisBtn = BOTC_NewButton(g_boardDlg, 360, 48, 1520, 60, "私聊可见性：关闭");
    DialogControlSetVisible(g_pmVisBtn, PlayerGroupAll(), false);
    for (i = 0; i < 13; i += 1) {
        x = 40 + (i * 310);
                                  //   5 张时 x = 80 / 440 / 800 / 1160 / 1520（夜半狂欢在最右）
        libNtve_gf_CreateDialogItemImage(g_boardDlg, 256, 256, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_boardPic[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, x + 32, 330);
        libNtve_gf_SetDialogItemAcceptMouse(g_boardPic[i], true, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_boardPic[i], "botc_blank.dds", PlayerGroupAll());
        DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
        g_boardBtn[i] = BOTC_NewButton(g_boardDlg, 320, 80, x, 630, "板子");
        DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
        // 【剧本难度】（用户 2026-11-06）：板子按钮下方两行红字，自定义剧本不显示
        g_boardDiffP[i] = BOTC_NewLabelC(g_boardDlg, 320, 22, x, 630, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_boardDiffP[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_boardDiffP[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), false);
        g_boardDiffS[i] = BOTC_NewLabelC(g_boardDlg, 320, 22, x, 630, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_boardDiffS[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_boardDiffS[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), false);
    }
    //--------------------------------------------------------------------------------------------
    // 右边那块「本局设置（投票）」（用户 2026-09-17）：只有智能说书模式才显示
    //   私聊时间（1~4 分钟 / 换成自由发言）· 公聊时间（1~4 分钟）·
    //   提名时间（10 / 20 / 30 秒）· 第一天白天要不要开邪恶小窗
    //--------------------------------------------------------------------------------------------
    g_bvDlg = g_boardDlg;              // 直接挂在选板子页面上：跟着它一起显隐
    g_bvTitle = BOTC_NewLabelC(g_boardDlg, 430, 34, 1470, 150, StringToText("本局设置（投票）"));
    libNtve_gf_SetDialogItemStyle(g_bvTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvTitle, false, PlayerGroupAll());
    DialogControlSetVisible(g_bvTitle, PlayerGroupAll(), false);
    // 行 1：私聊时间（1 / 2 / 3 / 4 分钟 + 自由发言）
    g_bvHead[0] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 190, StringToText("私聊时间（自由 = 把私聊时间换成自由发言）"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[0], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[0], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[0], PlayerGroupAll(), false);
    for (i = 0; i < 5; i += 1) {
        if (i == 4) {
            s = "自由";
        }
        else {
            s = IntToString(i + 1) + "分";
        }
        g_bvPmBtn[i] = BOTC_NewButton(g_boardDlg, 80, 38, 1470 + (i * 86), 216, s);
        DialogControlSetVisible(g_bvPmBtn[i], PlayerGroupAll(), false);
    }
    // 行 2：公聊时间（1 / 2 / 3 / 4 分钟）
    g_bvHead[1] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 262, StringToText("公聊时间"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[1], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[1], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[1], PlayerGroupAll(), false);
    for (i = 0; i < 4; i += 1) {
        s = IntToString(i + 1) + "分";
        g_bvPubBtn[i] = BOTC_NewButton(g_boardDlg, 100, 38, 1470 + (i * 107), 288, s);
        DialogControlSetVisible(g_bvPubBtn[i], PlayerGroupAll(), false);
    }
    // 行 3：提名时间（自由提名阶段的秒数：10 / 20 / 30 秒）
    g_bvHead[2] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 334, StringToText("提名时间（自由提名）"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[2], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[2], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[2], PlayerGroupAll(), false);
    for (i = 0; i < 3; i += 1) {
        if (i == 0) {
            s = "10秒";
        }
        else {
            if (i == 1) {
                s = "20秒";
            }
            else {
                s = "30秒";
            }
        }
        g_bvNomBtn[i] = BOTC_NewButton(g_boardDlg, 133, 38, 1470 + (i * 143), 360, s);
        DialogControlSetVisible(g_bvNomBtn[i], PlayerGroupAll(), false);
    }
    // 行 4：第一天白天要不要开邪恶小窗（点一下循环：未投 → 要 → 不要）
    g_bvHead[3] = BOTC_NewLabel(g_boardDlg, 430, 24, 1470, 406, StringToText("第一天白天开邪恶小窗？"));
    libNtve_gf_SetDialogItemStyle(g_bvHead[3], "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bvHead[3], false, PlayerGroupAll());
    DialogControlSetVisible(g_bvHead[3], PlayerGroupAll(), false);
    g_bvEvilBtn = BOTC_NewButton(g_boardDlg, 220, 38, 1470, 432, "第一天小窗：未投");
    DialogControlSetVisible(g_bvEvilBtn, PlayerGroupAll(), false);
    // 票数 + 每人自己的「你已选」
    for (i = 0; i < 5; i += 1) {
        g_bvLine[i] = BOTC_NewLabel(g_boardDlg, 430, 22, 1470, 486 + (i * 24), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_bvLine[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_bvLine[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_bvLine[i], PlayerGroupAll(), false);
    }
    // 选板子的提示里补一句：现在不用等所有人都投
    BOTC_BvRender();
}

// 黑布：等光照全黑之后再铺上去（所以看不出跳变），保证 UI 背后是纯黑、也是兜底
void BOTC_BoardFadeRender () {
    int i;
    if (g_boardFade < 4) {
        DialogSetVisible(g_blackDlg, PlayerGroupAll(), false);
        for (i = 0; i < 77; i += 1) {
            DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), false);
        }
        return;
    }
    // 【黑布是独立对话框】（用户 2026-10-04）：整块一起显隐（它建得最早 = 最低图层）
    DialogSetVisible(g_blackDlg, PlayerGroupAll(), true);
    for (i = 0; i < 77; i += 1) {
        libNtve_gf_SetDialogItemImage(g_blackTile[i], "botc_black.dds", PlayerGroupAll());
        DialogControlSetVisible(g_blackTile[i], PlayerGroupAll(), true);
    }
}

// 选板子期间把玩家界面全藏起来（游戏原生 UI 藏不了）
void BOTC_HideAllUI () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmPickEnd(p);         // 选板子时界面全收：顺手把「发起私聊」模式也退掉
        // 【黑布降层后新增】（用户 2026-10-04）：这个按钮原来是「建完就一直挂着」、靠黑布盖住的，
        //   现在黑布降到最低层了，所以要显式收掉；选完板子由 BOTC_ShowAllUI 放回来。
        DialogSetVisible(g_sayBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_panelDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_miniDlg[p], PlayerGroupAll(), false);
        // 选板子时公聊窗**不藏**：它压在板子那块黑布上面（用户 2026-09-19）
        DialogSetVisible(g_pmDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_pmBgDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_chatFrameDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_pmFrameDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_logBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_grimBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_abBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_tipBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_noteBtnDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_claimBtnDlg[p], PlayerGroupAll(), false);
        // 【竞选角色】选板页也要能点（用户 2026-11-11 二改）：入口按钮保留，只收面板
        DialogSetVisible(g_jrBtnDlg[p], PlayerGroupSingle(p), true);
        if (g_jrDlg[p] != 0) {
            DialogSetVisible(g_jrDlg[p], PlayerGroupAll(), false);
        }
        g_jrOn[p] = 0;
    }
    DialogSetVisible(g_nightBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_chatBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), false);
    BOTC_GrimFlagAll(false);
    // 【伪造魔典】属于当前剧本，选板子时和魔典一起收起来
    if (g_fakeBtnDlg != 0) {
        DialogSetVisible(g_fakeBtnDlg, PlayerGroupAll(), false);
    }
    if (g_fakeDlg != 0) {
        DialogSetVisible(g_fakeDlg, PlayerGroupAll(), false);
    }
    if (g_fakeAskDlg != 0) {
        DialogSetVisible(g_fakeAskDlg, PlayerGroupAll(), false);
    }
    // 【中毒 / 醉酒间谍或寡妇】还没到点的自动兜底一起取消
    g_fakeAskSec = 0;

    DialogSetVisible(g_logDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_logPickDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_abDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_noDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_abNewDlg[p], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_tipDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_pickDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_taotieDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);   // 【发送特定信息】（用户 2026-10-10）
    DialogSetVisible(g_recogDlg, PlayerGroupAll(), false);  // 手动互认输入面板
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);   // 【教派投票】（用户 2026-10-10）
    // 【计时器】（用户 2026-10-04 截图：选板子时露出一个「展开计时」）：它原来是建完就挂给说书人、
    //   靠黑布盖住的；黑布降到最低层之后就露出来了 → 选板子期间显式收掉，选完由 BOTC_ShowAllUI 放回初始状态。
    DialogSetVisible(g_tmDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_noteDlg[p], PlayerGroupAll(), false);   // 【笔记】记事板一起收掉
        g_noteOn[p] = false;
        g_abOpen[p] = false;
        g_noOpen[p] = false;
        g_dlgDrag[p] = 0;
    }
    // 【测试·换座位】发布版隐藏（用户 2026-10-09）：这里也保持收着，别让"界面全开"把它放出来
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);
}

// 选完板子把界面放回来（之前收起面板的人保持收起）
void BOTC_ShowAllUI () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_chatDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_sayBtnDlg[p], PlayerGroupSingle(p), true);   // 【聊天：公聊/私聊】按钮放回来（用户 2026-10-04）
        DialogSetVisible(g_pmDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_pmBgDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_chatFrameDlg[p], PlayerGroupSingle(p), true);
        DialogSetVisible(g_pmFrameDlg[p], PlayerGroupSingle(p), true);
        if (g_hidden[p]) {
            DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), false);
            DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), true);
        }
        else {
            DialogSetVisible(g_panelDlg[p], PlayerGroupSingle(p), true);
            DialogSetVisible(g_miniDlg[p], PlayerGroupSingle(p), false);
        }
        BOTC_SessNavRender(p);     // 选板/换界面后重新放出私聊左右翻看按钮
    }
    // 右上角三个按钮、发牌按钮的显隐交给 NomUI 统一处理
    BOTC_NomUI();
    BOTC_ClaimBtnRender();
    BOTC_WakeRender();
    BOTC_SkillBtnRender();
    // 这三条也在 NomUI 里管：正式开始之前不出现（用户 2026-09-17）
    DialogSetVisible(g_nightBtnDlg, PlayerGroupSingle(g_teller), g_started);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    DialogSetVisible(g_chatBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    BOTC_ChatBtnRender();

    // 【计时器】（用户 2026-10-04）：选板子期间被 HideAllUI 收掉了，这里恢复成**建完时的初始状态**
    //   —— 小按钮给说书人、面板收着（跟 BOTC_BuildTimer 结尾那两句一致）。
    DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_tmDlg, PlayerGroupSingle(g_teller), false);
    BOTC_BluffRender();
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
}

// 开局：黑屏淡入 -> 选板子
//==================================================================================================
// 背景音乐：选板子 → 正式开始之前，循环播 LostViking_MusicGameLoop
//   ⚠ 声音相关的原生函数名我是按标准 Galaxy 写法写的（SoundlinkAsset / SoundPlay / SoundStop）。
//      如果编辑器报「语法错误」说不认识这几个名字，用这个办法拿到准确写法：
//      在触发器列表里找「音效 → 播放音效」，随便拖一个动作出来、音效选
//      LostViking_MusicGameLoop，切到「查看脚本」看一眼生成的代码，把那行发我，
//      我照着换掉下面这两句就行（别处都不用动）。
//   另外：星际自带的那套音乐（按种族播的）**用触发器关不掉**，要彻底盖掉得在数据编辑器里
//   动地图音效（数据 → 音效，把 Music 类那几条的音量改 0，或者把地图音乐换成这一段）。
//==================================================================================================
// 音轨名（数据编辑器里的 ID）在文件开头的全局区声明，想换曲子改 BOTC_GrimInitData() 里的赋值
// 播放指定音轨（用的是编辑器「播放音轨」动作生成的写法；音轨会盖掉游戏自带音乐）
//   prio = 优先级：3 夜晚（最高，任何切换都盖不掉）/ 2 提名阶段 / 1 白天时段
//   delay = 上一首淡出后隔多少秒再放新的
//           2.5 秒 = 白天里的「时段切换」（私聊 / 公聊 / 自由）
//           4.0 秒 = 昼夜切换（天黑 / 天亮）与提名阶段，留给那几条大提示
void BOTC_MusicPlay (string name, int prio, fixed delay) {
    if (name == "") {
        return;
    }
    if (g_musicPrio > prio) {
        return;                        // 现在放的是更高优先级的音乐（夜晚 / 提名阶段）→ 不许覆盖
    }
    if (g_musicNow == name) {
        g_musicPrio = prio;            // 已经在放这一首了，只刷新一下优先级
        return;
    }
    if (g_musicPending == name) {
        // 已经排上这一首了（天亮时「时段切换」会先排一次、昼夜切换再排一次）：
        //   把计时器按这次给的延迟重来一遍，保证要 4 秒的那次不会被 2.5 秒顶掉
        g_musicPendPrio = prio;
        g_musicPrio = prio;
        TimerStart(g_tMusic, delay, false, c_timeGame);
        return;
    }
    if (g_musicNow != "") {
        // 上一首还在放：先淡出停掉，等 delay 秒让淡出走完，再由计时器放新的
        BOTC_MusicStop();
        g_musicPending = name;
        g_musicPendPrio = prio;
        g_musicPrio = prio;            // 待播放的这首也占住优先级，免得这 delay 秒里被别的曲子插队
        TimerStart(g_tMusic, delay, false, c_timeGame);
        return;
    }
    g_musicPending = "";
    g_musicNow = name;
    g_musicPrio = prio;
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, name, c_soundtrackCueAny, c_soundtrackIndexAny, false);
}

// 离开某个高优先级场景（比如提名结束）时把优先级降下来，好让白天的曲子能放进来
void BOTC_MusicDropPrio (int prio) {
    if (g_musicPrio > prio) {
        g_musicPrio = prio;
    }
    if (g_musicPendPrio > prio) {
        g_musicPendPrio = prio;
    }
}

void BOTC_MusicStop () {
    g_musicPending = "";               // 有等着要放的也一起取消
    g_musicPendPrio = 0;
    g_musicPrio = 0;
    if (g_musicNow == "") {
        return;
    }
    g_musicNow = "";
    // 编辑器「停止音轨」动作生成的写法：true = 淡出之后再停
    SoundtrackStopCurrent(PlayerGroupAll(), c_soundtrackCategoryMusic, true);
}

// 换曲子用的 1.5 秒计时器：到点了就把等着的那首放出来
bool BOTC_MusicTimer_Func (bool testConds, bool runActions) {
    string nm;
    int pr;
    if (!runActions) {
        return true;
    }
    if (g_musicPending != "") {
        nm = g_musicPending;
        pr = g_musicPendPrio;
        g_musicPending = "";
        BOTC_MusicPlay(nm, pr, 0.0);     // 到点直接放，不用再等
    }
    return true;
}

// 兼容旧名字：选板子 / 准备阶段放的那首
void BOTC_MusicStart () {
    // 准备阶段（选板子 / 等待正式开始）的 BGM 优先级最高（4）：这期间任何切换都不许盖掉它
    BOTC_MusicPlay(g_musicBoardName, 4, 2.5);
}

// 白天该放哪一首：
//   **存活玩家 ≤ 4**（小局）→ 不管公聊 / 私聊 / 自由，统一放 gongliao2
//   人多的局 → 公聊一首（gongliao1）、私聊与自由一首（siliao）
//   ⚠ 判据是「还活着的人数」（BOTC_AliveCountTrue：按死亡记录算，隐蔽死亡也算死），
//     不是在场座位数 ---- 人没退局但已经死了，也要按小局算。
string BOTC_DayTrackName () {
    if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
        return g_musicPubSmallName;
    }
    if (g_chatMode == 2) {
        return g_musicPubName;
    }
    return g_musicPmName;
}

// 按当前发言时段放白天的曲子（天亮、以及切时段都用它，保证一定放得出来）
//   delay：昼夜切换（天亮）传 4.0；白天里的时段切换传 2.5
void BOTC_DayMusicRefresh (fixed delay) {
    if (!g_started) {
        return;
    }
    if (g_isNight) {
        return;
    }
    BOTC_MusicPlay(BOTC_DayTrackName(), 1, delay);
}

//--------------------------------------------------------------------------------------------------
// 音效 + 「大提示」横幅
//   入夜那一下：先响一声 ping（音效，不是音轨），屏幕中上方弹出蓝色大字「夜晚 X」
//   大字显示 3.5 秒自动收起，刚好把音乐那 4 秒的空白填满
//--------------------------------------------------------------------------------------------------

// 播一个音效（原生 SoundLink + SoundPlayForPlayer，参数表照 TriggerLibs/natives.galaxy 抄的）
//   id = 数据编辑器「音效」那一栏的 ID（不是音轨）；空字符串 = 不播
//   参数写法照编辑器「播放音效」动作生成的代码抄：
//     SoundPlayForPlayer(SoundLink("Ping", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
//   ---- 名字大小写敏感（"ping" 会报「请求的声音文件未知」），所属玩家用 c_maxPlayers，
//      音量 100.0（百分比），最后一个 0.0 = 从头播（c_soundOffsetStart）
void BOTC_PlaySfx (string id) {
    if (id == "") {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
}

// 只放给**某一个玩家**听的音效（私聊请求 / 私聊建立这类 UI 提示用）
//   ⚠ 别用 g_sfxTimed 那套句柄的写法：同一时刻只会记一个句柄，这里的音效都是短音、不用手动停
void BOTC_PlaySfxTo (string id, int p) {
    if (id == "") {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), p, PlayerGroupSingle(p), 100.0, 0.0);
}

//--------------------------------------------------------------------------------------------------
// 【游戏正式开始】的 10 秒倒计时（用户 2026-09-16 要求）
//   画面跟提名投票那个 10 秒倒计时**完全一样**：同一个 g_cdDlg / g_cdLbl，图用 BOTC_CdImg()
//   的 botc_cd10.dds ... botc_cd1.dds。数字 10→1 各停 1 秒，走完就收起来。
//   说书人点【游戏正式开始】那一下同时放 UI 音效 g_sfxStartName（UI_ObjectiveComplete）。
//--------------------------------------------------------------------------------------------------
void BOTC_StartCdRender () {
    int sec;
    if (!g_startCdOn) {
        return;
    }
    sec = g_startCdSec;
    if (sec < 1) {
        sec = 1;
    }
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(sec), PlayerGroupAll());
}

void BOTC_StartCdBegin () {
    g_startCdOn = true;
    g_startCdSec = 10;
    BOTC_StartCdRender();
    TimerStart(g_tStartCd, 1.0, true, c_timeGame);
}

// 固定流程倒计时结束后，把共用计时条还给公聊 / 私聊计时器。
void BOTC_FixedCountdownStop () {
    DialogSetPosition(g_tmShowDlg, c_anchorTop, 0, 60);
    libNtve_gf_SetDialogItemStyle(g_tmLbl, "ModLeftSize20Bold", PlayerGroupAll());
    DialogSetVisible(g_tmShowDlg, PlayerGroupAll(), g_tmOn);
    if (g_tmOn) {
        BOTC_TimerRender();
    }
}

void BOTC_StartCdStop () {
    g_startCdOn = false;
    g_startCdSec = 0;
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    BOTC_FixedCountdownStop();
}

// 倒计时每秒一拍：10 → 9 → ... → 1 → 收起
bool BOTC_StartCdFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_startCdOn) {
        return true;
    }
    if (g_boardStarting) {
        // 逐秒更新数字；显示框只在开始 / 结束切换显隐，避免数字之间出现空窗。
        g_startCdSec = g_startCdSec - 1;
        if (g_startCdSec <= 0) {
            BOTC_StartCdStop();
            BOTC_BoardStartGo();
            return true;
        }
        BOTC_BoardStartCdRender();
        return true;
    }
    g_startCdSec = g_startCdSec - 1;
    if (g_startCdSec <= 0) {
        BOTC_StartCdStop();
        // 【倒计时走完才真正开始】用户 2026-09-16 要求：这一刻才执行「进入第 1 夜」那一套
        if (g_startPending) {
            BOTC_GameStartGo();
        }
        return true;
    }
    BOTC_StartCdRender();
    return true;
}

// 播一个「限时音效」：放出来，过 secs 秒后**淡出**停掉（天亮那声 baitian 就是用这个）
//   句柄从 SoundLastPlayed() 拿（SoundPlayForPlayer 本身不返回东西），到点由计时器 SoundStop(句柄, true)
void BOTC_PlaySfxTimed (string id, fixed secs) {
    if (id == "") {
        return;
    }
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    g_sfxTimed = SoundLastPlayed();
    TimerStart(g_tSfxStop, secs, false, c_timeGame);
}

bool BOTC_SfxStopFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    SoundStop(g_sfxTimed, true);       // true = 先淡出再停
    return true;
}

void BOTC_BuildBigNotice () {
    // 位置对齐「魔典正中央那张板子图」：
    //   魔典对话框是 1170x1040 居中的（屏幕 1920x1080 的坐标系），所以它的左上角在 (375, 20)；
    //   板子图的图块在魔典内 (444, 392) 起、256x256，也就是屏幕坐标 y 412~668 ---- 这里把大字放在
    //   图块上方一点（屏幕 y 445）。
    //   锚点用 c_anchorTop（水平居中），所以大字天然跟板子图在同一条中线上。
    //   用户 2026-09-19：整块（对话框 + 里面的文字）再往右挪 100（锚点是 c_anchorTop，X 偏移就是左右挪）
    DialogCreate(600, 200, c_anchorTop, 100, 295, false);
    g_bigDlg = DialogLastCreated();
    DialogSetImageVisible(g_bigDlg, false);
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
    // ⚠ 实测：标签里的文字是**左对齐**的（那个「居中」参数不管用），所以左边缘要自己往右挪：
    //   对话框左边缘 = 屏幕中心 - 300，标签 x = 234 → 文字起点 ≈ 中心 - 66，
    //   而「夜晚 X」大概 96 宽 → 正好骑在中心线上。以后嫌偏左/偏右就改这个 234。
    g_bigLbl = BOTC_NewLabelC(g_bigDlg, 600, 40, 234, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bigLbl, false, PlayerGroupAll());   // 别挡住下面的点击
    // 【常驻提示的独立框】（用户 2026-09-22）：跟大字框同一个 X 锚点 / 偏移，只是往下 400 ----
    //   （大字框在 y=295，它就在 y=695；里面的标签还是 (214, 150)，落点 = 大字原来的位置 + 400）
    //   （用户 2026-09-30 起这个框不再显示文字：提示挪到魔典里了，见下面 g_hintLbl 那几行）
    DialogCreate(600, 200, c_anchorTop, 100, 595, false);
    g_hintDlg = DialogLastCreated();
    DialogSetImageVisible(g_hintDlg, false);
    DialogSetVisible(g_hintDlg, PlayerGroupAll(), false);
    // ⚠ 用户 2026-09-30：这一行从「独立提示框 g_hintDlg」改成挂在魔典 g_grimDlg 上（魔典关掉它跟着藏）
    //   位置 (425,725) 是魔典内部坐标：x 按圆桌中心 515 减去估宽一半（9 个全角字 × 20 号 ≈ 180）凑的居中；
    //   想左右挪就改 425、上下挪就改 725。字号用 ModLeftSize20Bold（比大字那档 ObjectiveDisplay 小一号）。
    g_hintLbl = BOTC_NewLabelC(g_grimDlg, 700, 40, 425, 725, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_hintLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_hintLbl, false, PlayerGroupAll());  // 别挡住下面的点击
    DialogControlSetVisible(g_hintLbl, PlayerGroupAll(), false);
    g_tBig = TimerCreate();
    g_tBigTrig = TriggerCreate("BOTC_BigTimer_Func");
    TriggerAddEventTimer(g_tBigTrig, g_tBig);
}

// 弹一条大提示（全场可见）；连着调用会刷新文字并重新计时
//   这个带颜色参数：c = 文字颜色
void BOTC_BigNoticeC (string s, color c) {
    int i;
    libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());          // 正常大字（长驻提示会改成小一号）
    DialogControlSetPosition(g_bigLbl, PlayerGroupAll(), c_anchorTopLeft, 234, 150);
    libNtve_gf_SetDialogItemText(g_bigLbl, TextWithColor(StringToText(s), c), PlayerGroupAll());
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), true);
    for (i = 1; i <= 13; i += 1) {
        g_bigHintOn[i] = false;    // 正常播报顶掉了长驻提示（每人一份，逐个清）
    }
    TimerStart(g_tBig, 3.5, false, c_timeGame);
}

// 「长驻提示」（用户 2026-09-19）：跟白天/夜晚大字共用同一块地方，但**不自动消失** ----
//   唤醒 / 提名选人的操作提示就挂在这儿；一律用小一号字（20）保证整句放得下
void BOTC_BigHintShow (int p, string s) {
    if (p < 1 || p > 13) {
        return;
    }
    libNtve_gf_SetDialogItemStyle(g_bigLbl, "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_bigLbl, PlayerGroupSingle(p), c_anchorTopLeft, 110, 8);
    libNtve_gf_SetDialogItemText(g_bigLbl, TextWithColor(StringToText(s), Color(120, 230, 255)), PlayerGroupSingle(p));
    DialogSetVisible(g_bigDlg, PlayerGroupSingle(p), true);
    g_bigHintOn[p] = true;
}

// 【常驻提示】（用户 2026-09-30 改）：提名环节那种「一直挂着的操作提示」现在挂在**魔典 g_grimDlg** 上 ----
//   位置：x=425 / y=725，都是魔典内部坐标（x 是按圆桌中心 515 估宽凑的居中；y 沿用原来那个独立框的高度）。
//   想调位置就改下面 DialogControlSetPosition 的 425 / 725；想调字号就把 "ModLeftSize20Bold" 换个样式名。
//   显示时间：不自动消失，靠 BOTC_BigHintHide 收（进选人 / 结束提名 / 入夜 / 换局都会收）。
void BOTC_BigHintShowMid (int p, string s) {
    if (p < 1 || p > 13) {
        return;
    }
    libNtve_gf_SetDialogItemStyle(g_hintLbl, "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_hintLbl, PlayerGroupSingle(p), c_anchorTopLeft, 425, 725);
    libNtve_gf_SetDialogItemText(g_hintLbl, TextWithColor(StringToText(s), Color(120, 230, 255)), PlayerGroupSingle(p));
    DialogControlSetVisible(g_hintLbl, PlayerGroupSingle(p), true);
}

// p 传 0（越界同义）= 全场一起收掉（换局 / 重开那种收尾用）
void BOTC_BigHintHide (int p) {
    int i;
    if (g_bigDlg == 0 || g_hintLbl == 0) {
        return;                       // UI 尚未建好时由初始化流程调用，不能操作空句柄
    }
    if (p < 1 || p > 13) {
        for (i = 1; i <= 13; i += 1) {
            g_bigHintOn[i] = false;
        }
        DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_hintLbl, PlayerGroupAll(), false);
        return;
    }
    if (g_bigHintOn[p]) {
        g_bigHintOn[p] = false;
        DialogSetVisible(g_bigDlg, PlayerGroupSingle(p), false);
    }
    DialogControlSetVisible(g_hintLbl, PlayerGroupSingle(p), false);
}

// 默认颜色 = 亮蓝（夜晚用）
void BOTC_BigNotice (string s) {
    BOTC_BigNoticeC(s, Color(90, 170, 255));
}

// 大提示到点自动收起
bool BOTC_BigTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    DialogSetVisible(g_bigDlg, PlayerGroupAll(), false);
    return true;
}

// 入夜那一下：一声 ping + 大字「夜晚 X」（第 1 夜 = 夜晚 1）
//   号码取 g_nightNum；准备阶段（还没正式开始）那一夜号码是 0，
//   这时只响 ping、不弹大字，免得出现「夜晚 0」
void BOTC_NightBanner () {
    BOTC_PlaySfx(g_sfxPingName);
    if (g_nightNum >= 1) {
        BOTC_BigNotice("夜晚 " + IntToString(g_nightNum));
    }
}

//--------------------------------------------------------------------------------------------------
// 提名开始：「提名开始」4 个褐色大字在屏幕正中一个一个浮现，最后一起消失
//   节奏：第 1 个字立刻出现 → 每 0.75 秒冒一个（第 4 个在 3.0 秒时出现）→ 3.75 秒时 4 个字一起收掉，
//   刚好赶上 4.0 秒提名阶段正式开始（魔典弹出 + timing 那首音乐进来）
//   同时给全场播一声 g_sfxNomName（timingkaishi）
//--------------------------------------------------------------------------------------------------

// 跟 BOTC_NewLabelC 一样，但最后那个固定值（2.0）可以自己给 ---- 用来试它到底是不是「字体大小」
int BOTC_NewLabelCX (int d, int w, int h, int x, int y, text t, fixed f) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, f);
    return DialogControlLastCreated();
}

// 造（或重建）这 4 个字。重建时先把旧对话框拆掉，免得用 nbig 调参数时叠出好几层
void BOTC_NomBigMake () {
    int i;
    int base;
    int step;
    if (g_nomBigDlg != 0) {
        DialogDestroy(g_nomBigDlg);
        g_nomBigDlg = 0;
    }
    DialogCreate(600, 140, c_anchorCenter, 0, 0, false);
    g_nomBigDlg = DialogLastCreated();
    DialogSetImageVisible(g_nomBigDlg, false);
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), false);
    // 4 个字各一个标签。**标签里的文字是左对齐的**，所以「字的左边缘」就是标签的 x
    //   ---- 想让整组居中，就调 base / step 这两个数：
    //   base = 第一个字的左边缘（对话框 600 宽 → 中线在 300），step = 字间距
    base = 224;
    step = 40;
    for (i = 0; i < 4; i += 1) {
        // 褐色（150,90,40）用文字颜色标记写进去 ---- 标签没有单独的「设置文字颜色」动作，
        //   但颜色标记（TextWithColor）在标签里是好用的（人数配置那行就是这么上色的）
        g_nomBigLbl[i] = BOTC_NewLabelCX(g_nomBigDlg, 110, 140, base + (i * step), 0, TextWithColor(StringToText(g_nomBigCh[i]), Color(150, 90, 40)), g_nomBigSize);
        libNtve_gf_SetDialogItemStyle(g_nomBigLbl[i], g_nomBigStyle, PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_nomBigLbl[i], false, PlayerGroupAll());
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
}

void BOTC_BuildNomBig () {
    g_nomBigCh[0] = "提";
    g_nomBigCh[1] = "名";
    g_nomBigCh[2] = "开";
    g_nomBigCh[3] = "始";
    BOTC_NomBigMake();
    g_tNomBig = TimerCreate();
    g_tNomBigTrig = TriggerCreate("BOTC_NomBigTimer_Func");
    TriggerAddEventTimer(g_tNomBigTrig, g_tNomBig);
}

// 开始演：先把 4 个字全藏起来 → 放音效 → 第 1 个字立刻出现 → 之后每 0.75 秒冒一个
void BOTC_NomBigShow () {
    int i;
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), true);
    BOTC_PlaySfx(g_sfxNomName);
    g_nomBigOn = true;
    g_nomBigIdx = 1;
    g_nomBigHold = 0;
    DialogControlSetVisible(g_nomBigLbl[0], PlayerGroupAll(), true);
    // 每 0.8 秒冒一个字：4 个字分别在 0 / 0.8 / 1.6 / 2.4 秒出现，之后再多留 2 拍（约 1.6 秒）
    //   到 4.0 秒才一起收掉 ---- 「略微延长」就是靠这两个数：0.8（间隔）和下面的 >= 2（多留几拍）
    TimerStart(g_tNomBig, 0.8, true, c_timeGame);
}

// 一起收掉
void BOTC_NomBigHide () {
    int i;
    for (i = 0; i < 4; i += 1) {
        DialogControlSetVisible(g_nomBigLbl[i], PlayerGroupAll(), false);
    }
    DialogSetVisible(g_nomBigDlg, PlayerGroupAll(), false);
    g_nomBigOn = false;
    g_nomBigIdx = 0;
    g_nomBigHold = 0;
}

bool BOTC_NomBigTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_nomBigOn) {
        return true;                   // 没在演（或者早收掉了）：这一拍什么都不做
    }
    if (g_nomBigIdx < 4) {
        DialogControlSetVisible(g_nomBigLbl[g_nomBigIdx], PlayerGroupAll(), true);
        g_nomBigIdx = g_nomBigIdx + 1;
        return true;
    }
    g_nomBigHold = g_nomBigHold + 1;
    if (g_nomBigHold >= 2) {
        BOTC_NomBigHide();
        // 【4 个字收掉之后再挂常驻提示】（用户 2026-09-22）：正在提名环节里才挂 ----
        //   提前结束提名（BOTC_NomClose）也会调 BOTC_NomBigHide，那时不该再挂提示，所以加 g_phase 判断。
        if (g_phase == 1) {
            BOTC_BigHintShowMid(1, "点【发起提名】选人");
            // 【发起提名】跟这行提示同拍开放（用户 2026-09-30）：别再让玩家在「提名开始」那段动画里就抢提名
            g_nomStartOn = true;
            BOTC_NomUI();
        }
    }
    return true;
}

// 【切换板子】：正式开始之前说书人能在顶部换一次板子（重新走选板子页面）
void BOTC_BsBtnRender () {
    DialogSetVisible(g_bsBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tsBtnDlg, PlayerGroupAll(), false);              // 【换座位】一起收起来
    DialogSetVisible(g_legBtnDlg, PlayerGroupAll(), false);
    BOTC_LegacyPanelHide();
    DialogSetVisible(g_legPanel, PlayerGroupAll(), false);
    // 【测试·换座位】发布版始终隐藏；正式【换座位】仍由下面的 g_tsBtnDlg 提供。
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);
    if (g_started || g_boardOpen) {
        return;
    }
    DialogSetVisible(g_bsBtnDlg, PlayerGroupSingle(g_teller), true);
    // 【发完牌就收掉"换座位"】（用户 2026-10-07）：说书人点过【确认发放】之后不许再换座位；
    //   【取消正式开始】会把 g_dealConfirmed 清掉（BOTC_ResetGameVars 里），这里就又会放回来。
    if (!g_swapOff && (!g_dealConfirmed || g_swapUnlocked)) {
        DialogSetVisible(g_tsBtnDlg, PlayerGroupAll(), true);   // 【换座位】正式开始前所有玩家都能用
    }
    DialogSetVisible(g_legBtnDlg, PlayerGroupSingle(g_teller), true);
}

// 【换说书人 · 方案 A 第 3 步】（用户 2026-10-06）：说书人点【换说书人】→ 点一个座位 → 交接。
//   第 3+4 步合在一起：换人的同时，把两个座位的**观察者行与列整体对调**（魔典/标记/token），
//   这样：新说书人拿到"真值那一行"（看得到真魔典），老说书人拿到对方原来那份玩家视角。
// 【-pos】把"位置(格子) ↔ 坐的人(物理座位)"整张表打进自己的私聊（用户 2026-10-07，换位排查用）
void BOTC_PosOfDump (int p) {
    int i;
    string s;
    BOTC_AppendPm(p, "【座位表】你 = 座位 " + IntToString(p) + "、位置 " + IntToString(BOTC_PosOf(p))
        + "；说书人 = 座位 " + IntToString(g_teller) + "、位置 " + IntToString(BOTC_PosOf(g_teller)));
    s = "格子 → 坐的人（= 物理座位号）：";
    for (i = 1; i <= 13; i += 1) {
        if (i == 1) {
            s = s + "  [说书人格]=" + IntToString(g_who[i]);
        }
        else {
            s = s + "  [" + IntToString(g_lab[i] + g_nameNumShift) + "]=" + IntToString(g_who[i]);
        }
    }
    BOTC_AppendPm(p, s);
    // 【每格会渲染成什么名字】（用户 2026-10-07）：这里写的就是"占位名"，渲染时会被换成真名 →
    //   你看到的这行应该和魔典上的显示完全一致，对不上就说明是面板没刷新。
    s = "格子 → 显示：";
    for (i = 1; i <= 13; i += 1) {
        s = s + "  " + BOTC_NameStr(i);
    }
    BOTC_AppendPm(p, s);
}

// 【顺位找"在座的真人"】（用户 2026-10-07）：第一个进房间的人（说书人）走了之后，
//   由"下一个进房间的玩家"接手 —— SC2 里进房间越早、玩家号越小（房主 = 1、之后 2、3…），
//   所以这里就是"从 2 往 13 找第一个还在座的真人"。
int BOTC_FirstPresentSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (PlayerType(i) == 1 && PlayerStatus(i) != 2) {
            return i;
        }
    }
    return 0;
}

// 【队伍1 = 说书人】（用户 2026-11-07）：大厅「队伍1」在那张地图里就叫「说书人」队，
//   返回队伍1 里在座真人中玩家号最小的那个；没有真人就返回 0（交给原来的兜底逻辑）。
//   只在 BOTC_InitMode（= 首次进游戏）里用一次，换座位 / 重新开始都不会再调用。
int BOTC_TeamTellerSeat () {
    int i;
    int best;
    playergroup tg;
    tg = GameAttributePlayersForTeam(1);
    best = 0;
    i = -1;
    while (true) {
        i = PlayerGroupNextPlayer(tg, i);
        if (i < 0) {
            break;
        }
        if (i < 1 || i > 13) {
            continue;
        }
        if (PlayerType(i) != 1 || PlayerStatus(i) == 2) {
            continue;
        }
        if (best == 0 || i < best) {
            best = i;
        }
    }
    return best;
}

// 【开局随机分配座位号】（用户 2026-10-07）：物理座位（SC2 玩家号）动不了 —— 引擎不让人换槽，
//   所以"随机"动的是 `g_who`（格子 → 人）：**说书人以外的在场玩家**在玩家格上整体洗一次。
//   说书人固定坐"说书人格"（格子 1），他原来那个玩家号不进圈（BOTC_BuildSeatList 会把 g_teller 排除）。
//   时机：BOTC_Init 里（还没发牌，格子上的身份 / token / 死亡都还是空的，只要洗 g_who 就够了）。
void BOTC_ShuffleSeats () {
    int i;
    int n;
    int j;
    int t;
    int m;
    int active;
    int[14] people;
    int[14] fillers;
    int[14] positions;
    playergroup ag;
    ag = PlayerGroupActive();
    // 收集"在场、且不是说书人"的玩家号
    // 【玩家1 也参与洗牌】（用户 2026-11-10 报「队伍1 玩家当说书人后少一个座位号、两人共用一个名字」）：
    //   大厅「队伍1」的玩家不是玩家1 本人时，玩家1 只是一个普通玩家，他必须和 2..13 一起进池子；
    //   原来从 2 开始收集，玩家1 直接被漏掉 → 圈上少一个人。
    n = 0;
    m = 0;
    for (i = 1; i <= 13; i += 1) {
        active = 0;
        if (i == 1) {
            if (PlayerType(1) == 1 && PlayerStatus(1) != 2) {
                active = 1;
            }
        }
        else {
            if (PlayerGroupHasPlayer(ag, i)) {
                active = 1;
            }
        }
        if (i == g_hideSeat || i == g_teller) {
            continue;
        }
        if (active) {
            people[n] = i;
            n = n + 1;
        }
        else {
            fillers[m] = i;
            m = m + 1;
        }
    }
    // 在场玩家和逻辑座位都洗牌：单玩家局也会随机落在 2..13 的任意一格。
    if (n >= 2) {
        for (i = n - 1; i >= 1; i -= 1) {
            j = RandomInt(0, i);
            t = people[i];
            people[i] = people[j];
            people[j] = t;
        }
    }
    m = 0;
    for (i = 2; i <= 13; i += 1) {
        if (i != g_hideSeat) {
            positions[m] = i;
            m = m + 1;
        }
    }
    if (m >= 2) {
        for (i = m - 1; i >= 1; i -= 1) {
            j = RandomInt(0, i);
            t = positions[i];
            positions[i] = positions[j];
            positions[j] = t;
        }
    }
    for (i = 0; i < m; i += 1) {
        if (i < n) {
            g_who[positions[i]] = people[i];
        }
        else {
            g_who[positions[i]] = fillers[i - n];
        }
    }
    // 说书人格 = 说书人本人
    g_who[1] = g_teller;
}

// 【不在场身份面板的说书人专属控件：重发给"现在的说书人"】（用户 2026-10-07 报「换说书人之后，
//   不在场身份那里不显示 3 个格子选身份，也没有【随机 3 个】和【发送】这两个按钮」）：
//   那 3 个坑位按钮 + 3 颗功能键是在 **BOTC_BuildBluff 建面板的那一刻**
//   用 `PlayerGroupSingle(g_teller)` 发下去的 —— 那时候 g_teller 还是老说书人 ✗。
//   换说书人 / 换座位之后只重开了对话框，没重发这些控件 → 新说书人看到的就是空面板。
//   这里统一"先全场收掉、再单独发给现在的说书人"，并把 3 格的内容按数据重画一遍。
void BOTC_BluffTellerUI () {
    int i;
    // 【右下角面板整体兜底】（用户 2026-11-06）：前面的 HideAllUI / 新局清理可能只收回
    // 父对话框，若这里只重发三个子控件，说书人就会看到“面板不见了”。每次重载说书人
    // 专属控件时，连带把整块不在场身份面板重新显示给当前说书人。
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupSingle(g_teller), true);
    }
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupSingle(g_teller), true);
    // 【发送】（用户 2026-11-08）：游戏正式开始前不重发给说书人，由 BOTC_BluffRender 统一按 g_started 处理
    if (g_started) {
        DialogControlSetVisible(g_bluffSendBtn, PlayerGroupSingle(g_teller), true);
    }
    BOTC_BluffRender();            // 恶魔那 3 格：按现在选的内容重画；【发送目标】按钮也在这里按是否有疯子 / 告密者 / 失忆者决定显隐
}

// 【换位前记录：每个人自己那一格原本有没有露出身份】（用户 2026-11-07 报「换座位后能看到
//   换到自己原来座位上那个人的身份」）：说书人还在微调、没点【确认发放】时，玩家行里可能只有
//   说书人手动指派过的那几格有身份；换位的行列对调会把别人的标记搬进这一行，所以必须在换之前
//   把「谁本来就看得见自己身份」记下来，换完只给这些人重写，空白的人继续保持空白。
void BOTC_SwapOwnShownCapture () {
    int p;
    int q;
    int cur;
    for (p = 1; p <= 13; p += 1) {
        g_swapOwnShown[p] = false;
        q = BOTC_PosOf(p);
        if (p == g_teller || q < 2 || q > 13 || g_who[q] != p) {
            continue;
        }
        // 【只认「当前这一轮」的身份】（用户 2026-11-07）：直接按真值行算出这名玩家此刻应该看到
        //   的身份，跟他行里那一格比对。上一局确认过的旧身份、或者还没重发过的残留都不算数，
        //   否则换位后反而会把新发牌的身份提前写给他。
        cur = BOTC_PlayerRoleView(q, g_mark[(g_teller * 14) + q] - 1) + 1;
        if (cur > 0 && g_mark[(p * 14) + q] == cur) {
            g_swapOwnShown[p] = true;
        }
    }
}

// 【换位 / 换说书人之后的统一重刷】（用户 2026-10-07 报「换完有时候渲染不对、第二遍才对」）：
//   换位会改动"谁坐哪格"，牵动的地方不止魔典一处 —— 魔典文字、整圈显隐、说书人专属按钮、
//   私聊名单、每人的聊天窗…… 之前两个入口各刷一部分，才会"有时候对、有时候不对"。
//   现在两个入口换完都只调这一个函数，一次刷全（who = 发起换位的人，给他一句确认）。
//--------------------------------------------------------------------------------------------------
// 【换座位 / 换说书人的交互收尾】（用户 2026-11-10）：换人和切阶段一样，会让所有「按旧行列绑定」的
//   交互失效——声称 / 猜测 / 各种选座模式、私聊与换座请求、踢人投票、处决·死亡标记、说书人判定
//   弹窗和工具面板。这里复用阶段收尾的那套清理，但**保留**夜间唤醒链和玩家正在选择的技能面板：
//   技能面板由 BOTC_AfterSeatChange 后面的重发窗体按新座位重绑，不清 g_skillPicking。
//--------------------------------------------------------------------------------------------------
void BOTC_SeatChangeUiCancel () {
    int q;
    // ① 说书人 / 角色还在等选人的状态
    g_pdPick = false;
    g_boomKeepPick = false;
    g_boomVoteOn = false;
    if (g_boomTellerBtn != 0) {
        DialogControlSetVisible(g_boomTellerBtn, PlayerGroupAll(), false);
    }
    g_boomPending = false;
    g_boomResult = false;
    g_twinPick = false;
    g_courtPick = false;
    g_scarletPick = false;
    g_halfPick = false;
    g_sweetPick = false;
    g_boffinRecipientPick = false;
    g_wardenAsk = false;
    g_wardenAskBy = 0;
    g_wardenCandN = 0;
    g_moonAskSt = false;
    g_moonWaitSeat = 0;
    g_moonWaitTick = 0;
    // g_moonBy / g_moonPick 保留到天亮，由 BOTC_MoonChildResolve() 结算死亡
    g_klutzAskSt = false;
    g_klutzWaitSeat = 0;
    g_klutzWaitTick = 0;
    g_klutzBy = 0;
    g_hagPick = false;
    g_hagKill = false;
    g_hagAsk = 0;
    g_hagAskWho = 0;
    g_hagAskRole = 0;
    g_hagAskActor = 0;
    // ② 说书人正在点的座位模式：换座位 / 踢人 / 邀请 / 伪造魔典 / 处决 / 死亡
    //   换座位的选择状态直接清空，不走 BOTC_SwapCancelAll()：调用点还要用 g_swapPickBy
    //   给发起人发「换位完成」的确认，这里不能让它再补一句「换座位已经关闭了…这一按取消」。
    g_swapPickBy = 0;
    g_swapFirst = 0;
    g_tellerPick = 0;
    g_kickMode = 0;
    g_invitePick = false;
    g_inviteBy = 0;
    g_bluffPickSeat = false;
    g_tokFake = false;
    if (g_execPick) {
        g_execPick = false;
        if (g_teller >= 1 && g_teller <= 13) {
            libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
        }
    }
    if (g_deadPick) {
        g_deadPick = false;
        if (g_teller >= 1 && g_teller <= 13) {
            libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
        }
    }
    BOTC_HdHide();
    BOTC_ManualDeathCancel();
    // ③ 按玩家清：私聊请求 / 选人模式 / 声称 / 日志 / 帮助 / 笔记 / 夜序 / 赌徒杂耍戏法师
    for (q = 1; q <= 13; q += 1) {
        if (g_gambleWait[q]) {
            BOTC_GambleCancel(q);
        }
        BOTC_JugglerHide(q);           // 只收面板，保留已填的公开猜测草稿
        if (g_alsaOpen[q]) {
            BOTC_AlsaahirCancel(q);
        }
        if (g_pmPick[q] || g_blockPick[q]) {
            BOTC_PmPickEnd(q);
        }
        if (g_logOpen[q] || g_logPickOn[q] || g_logPick[q]) {
            BOTC_LogClose(q);
        }
        if (g_abOpen[q]) {
            BOTC_AbClose(q);
        }
        if (g_noOpen[q]) {
            BOTC_NightOrderClose(q);
        }
        if (g_tipOpen[q]) {
            BOTC_TipClose(q);
        }
        if (g_noteOn[q]) {
            BOTC_NoteClose(q);
        }
        BOTC_RsClose(q);
        if (g_reqFrom[q] != 0 || g_reqJoinSess[q] != 0 || g_reqSec[q] > 0 || g_invSess[q] != 0) {
            g_reqFrom[q] = 0;
            g_reqJoinSess[q] = 0;
            g_invSess[q] = 0;
            BOTC_ClearReq(q);
        }
        g_askPick[q] = false;
        g_askFrom[q] = 0;
        g_askSec[q] = 0;
        g_declarePick[q] = false;
        g_psyDeclare[q] = false;
        g_damselPick[q] = false;
        g_moonDeclare[q] = false;
        g_klutzDeclare[q] = false;
        g_ftPick[q] = false;
        g_alcPick[q] = false;
        g_alcChoice[q] = false;
        g_alcRolePick[q] = 0;
        g_tokWho[q] = 0;
        g_pickMode[q] = 0;
        g_pickWho[q] = 0;
        g_pickAttachSeat[q] = 0;       // 获得能力网格的挂载座位，换人后必须作废
        g_gambleWait[q] = false;
        g_wardenBy[q] = 0;
        g_boomKeep[q] = false;
        g_boomVote[q] = 0;
        g_boomCount[q] = 0;
        g_cultVote[q] = 0;
        g_wikiOpen[q] = false;
        g_artOpen[q] = false;
    }
    g_pickTeam = -1;
    g_pickAlign = -1;
    // ④ 说书人侧的夜间信息弹窗（按旧座位填的答案框 / 贵族 / 工程师 / 农夫 / 多重能力 / 街头风琴手等）
    BOTC_DrunkPickClose();
    g_miSeat = 0;
    g_miRole = -1;
    DialogControlSetVisible(g_miYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupAll(), false);
    DialogControlSetVisible(g_miNote, PlayerGroupAll(), false);
    DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
    g_nobleSeat = 0;
    DialogSetVisible(g_nobleDlg, PlayerGroupAll(), false);
    g_engSeat = 0;
    g_engSeatA = 0;
    g_engSeatB = 0;
    g_engStage = 0;
    DialogSetVisible(g_engDlg, PlayerGroupAll(), false);
    g_farmSeat = 0;
    DialogSetVisible(g_farmDlg, PlayerGroupAll(), false);
    g_wakeChoiceSeat = 0;
    DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
    g_organSeat = 0;
    DialogSetVisible(g_organDlg, PlayerGroupAll(), false);
    g_sgSeat = 0;
    DialogSetVisible(g_sgDlg, PlayerGroupAll(), false);
    g_gblSeat = 0;
    DialogSetVisible(g_gblDlg, PlayerGroupAll(), false);
    BOTC_TaotieClear();
    // ⑤ 各类判定 / 询问弹窗
    BOTC_SlayAskHide();
    BOTC_CopyAskHide();
    BOTC_DamselAskCancel();
    BOTC_MayorClear();
    BOTC_PsyRpsClear();
    BOTC_EngCancel();
    g_levRecSeat = 0;
    g_gfRecSeat = 0;
    g_pacAskSeat = 0;
    // 【理发师 · 恶魔与死者互换】切阶段 / 换座位收掉待判定，避免旧弹窗劫持后续点击
    g_barAskOn = false;
    g_barAskBypass = false;
    g_barAskP = 0;
    g_barAskA = 0;
    g_barAskB = 0;
    DialogSetVisible(g_barAskDlg, PlayerGroupAll(), false);
    g_ojoAskSt = false;
    g_ojoFrom = 0;
    g_ojoRole = -1;
    g_sweetBySt = false;
    g_cultChSeat = 0;
    g_cultChLSeat = 0;
    g_cultChRSeat = 0;
    g_fakeAskP = 0;
    g_fakeAskWidow = false;
    g_fakeAskSec = 0;
    g_gossipBy = 0;
    if (g_cultOn) {
        BOTC_CultCancel("换座位");
    }
    g_cultOn = false;
    g_cultWho = 0;
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_cultChDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_hagAskDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_levRecDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_gfRecDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_pacAskDlg, PlayerGroupAll(), false);
    // 【政客（97）】（用户 2026-11-10）：换座位 / 切阶段打断政客判定 → 按「不转变」直接封盘，
    //   不让这一局卡在等回答上。
    if (g_polSeat >= 2) {
        BOTC_WinFinalize(g_polSide, g_polWhy1, g_polWhy2);
    }
    g_polSeat = 0;
    DialogSetVisible(g_polDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_fakeAskDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_fakeDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_gossipDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_alcDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_askDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_wikiDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_artDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_abDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_abListDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    for (q = 0; q < 5; q += 1) {
        DialogControlSetVisible(g_rateBtn[q], PlayerGroupAll(), false);
    }
    // ⑥ 说书人工具面板
    BOTC_SpecClose();
    BOTC_GrantClose();
    BOTC_RecogClose();
    BOTC_MBluffCancel();
    BOTC_BluffTgtClose();
    if (g_bluffAskOn) {
        BOTC_BluffAskCancel();
    }
    BOTC_KickEnd();
    BOTC_LegacyPanelHide();
    BOTC_GudiaoClose();
    BOTC_EvilClose();
    BOTC_EndNoticeHide();
    BOTC_PromoteHide();
    BOTC_ForceNomClose();
    BOTC_NomBigHide();
    if (g_cOpen) {
        BOTC_CustomClose();
    }
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    BOTC_BigHintHide(0);
}

void BOTC_AfterSeatChange (int who) {
    int p;
    int q;
    int t;
    BOTC_BuildSeatList();
    // 说书人格是唯一真相：任何换位收尾都从 g_who[1] 反推当前说书人的物理座位。
    //   两个入口本来都会写 g_teller；这里再兜底一次，防止连续换人后事件仍按旧行
    //   处理 token（尤其死亡 token 看起来能点亮、却没有写进死亡结算）。
    if (g_who[1] >= 1 && g_who[1] <= 13) {
        g_teller = g_who[1];
    }
    // 【随机名字兜底】（用户 2026-11-11）：换说书人 / 换座位后，旧说书人变成普通玩家、
    //   新说书人隐藏自己的随机名；这里给所有非说书人真人补齐名字，保证换位后仍不暴露战网名。
    if (g_started) {
        for (p = 1; p <= 13; p += 1) {
            if ((PlayerType(p) == 1 || PlayerType(p) == 2) && PlayerStatus(p) != 2) {
                BOTC_RandomNameEnsure(p);
            }
        }
    }
    // 【换人前正在进行的交互一律作废】（用户 2026-11-10）：声称 / 猜测 / 选座 / 请求 / 判定弹窗
    //   都按旧行列绑定，换完再继续会点错人；这里先统一静默取消，后面的重刷只负责按新映射重建。
    BOTC_SeatChangeUiCancel();
    // 【私聊可见性跟着新说书人】（用户 2026-11-02）：换位 / 交接后按新说书人的账号恢复上次设置。
    BOTC_PmVisSync();
    BOTC_GrimRelayout();                    // 整圈位置 + 显隐（g_seatOn 没换）
    if (g_started) {
        BOTC_SeatStateSync();               // 换位后按新真值行重新校正常驻标记
    }
    // 【token 面板跟随新说书人】（用户 2026-10-21）：换位前打开的 token 面板可能还在显示旧观察者行，
    // 先全部关掉并清掉「正在看哪个座位」的缓存；说书人自己那个＋只给新的 g_teller。
    DialogSetVisible(g_tokDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        g_tokWho[p] = 0;
        g_tokPage[p] = 1;
    }
    // 【正在选目标的技能面板重新绑定】（用户 2026-10-24）：
    //   技能面板控件按逻辑格建；只搬 g_skillPicking / g_skillT1 而不重发窗体，
    //   玩家会继续看到旧格的面板，但点击检测已经换到新格 → 点座位和【确认】都没反应。
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_skillDlg[p], PlayerGroupAll(), false);
        DialogSetVisible(g_skillBtnDlg[p], PlayerGroupAll(), false);
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_skillPicking[p]) {
            BOTC_SkillRender(p);
            DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), true);
        }
        else {
            if (g_limitedAsk[p] || g_poAsk[p]) {
                BOTC_SkillOpen(p);
            }
        }
    }
    BOTC_SkillBtnRender();
    BOTC_NomUI();                           // 说书人专属按钮（发牌 / 手动配板 / 确认发放 / 正式开始）
    BOTC_ClaimBtnRender();                  // 【伪装身份】按钮
    BOTC_WakeRender();                      // 【唤醒 / 手动唤醒 / 互认】按钮
    // 说书人那几块"先全收、再给新说书人开"
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    // 【收到过不在场身份的那几份要放回来】（用户 2026-10-09 报「发了不在场身份之后，切到那个座位看不到」）：
    //   上面那两句是"先全收、再给说书人开"——但那份面板是**按玩家**渲染的，换位时不能连玩家手上那份一起收掉，
    //   否则恶魔 / 疯子 / 食人族那 3 格就"看不见了"（内容还在，只是被藏了）。这里按 g_bluffGot 放回来。
    for (p = 1; p <= 13; p += 1) {
        if (g_bluffGot[p]) {
            DialogSetVisible(g_bluffDlg, PlayerGroupSingle(p), true);
        }
    }
    BOTC_BluffTellerUI();                   // 【不在场身份面板：3 个坑位 + 【随机 3 个】/【发送】重发给新说书人】（用户 2026-10-07）
    // 【换位之后，把"每个人自己那一格"的身份重刷一遍】（用户 2026-10-07）：
    //   发过牌之后换座位的话，各人自己那份魔典里"自己的身份"要按**他现在坐的格子**重新填一次
    //   （说书人没有玩家身份格，跳过）。
    // 【整行先清】（用户 2026-11-01）：以前只写自己那一格、不清旧格，换座位后玩家会看到
    //   "别人原来坐的那一格"留下的角色 → 有概率看到别人的身份。
    // 【未确认发放也要重刷】（用户 2026-11-07 报「换过座位后能看到换到自己原来座位上那个人的身份，
    //   说书人还在微调、没点确认发放」）：没确认发放时手动指派过的身份已经写进玩家行，
    //   换位的行列对调会把它搬到别人的行上。这里按换位前记下的可见性重写：
    //   原本看得见的写自己那一格，原本空白的整行清空，绝不提前露出身份。
    if (!g_replayOn && (g_dealConfirmed || !g_started)) {
        for (p = 1; p <= 13; p += 1) {
            if (p == g_teller) {
                continue;
            }
            q = BOTC_PosOf(p);
            if (q < 2 || q > 13 || g_who[q] != p) {
                continue;
            }
            if (!g_dealConfirmed && !g_swapOwnShown[p]) {
                for (t = 2; t <= 13; t += 1) {
                    g_mark[(p * 14) + t] = 0;
                }
                continue;
            }
            for (t = 2; t <= 13; t += 1) {
                if (t == q) {
                    g_mark[(p * 14) + t] = BOTC_PlayerRoleView(t, g_mark[(g_teller * 14) + t] - 1) + 1;
                }
                else {
                    g_mark[(p * 14) + t] = 0;
                }
            }
        }
    }
    // 魔典 + 左边聊天窗（名字 / 编号都要按新的映射重画）
    for (p = 1; p <= 13; p += 1) {
        BOTC_GrimRender(p);
        BOTC_ChatRender(p);
        if (g_logOpen[p]) {
            BOTC_LogRender(p);
        }
    }
    // 【发送魔典】显隐依赖 g_teller / g_who / 间谍寡妇快照，换位后必须按新座位重算，
    // 否则新说书人（尤其是原本没抄录的间谍 / 寡妇）拿不到按钮，旧说书人还挂着按钮。
    BOTC_GrimShareRender();
    BOTC_DeclareRender();
    BOTC_RefreshSessListAll();              // 私聊名单
    // 【换位收尾兜底】（用户 2026-11-07 报「说书人换座位后，新说书人右下角没有发送不在场身份的面板」）：
    //   上面逐人重刷魔典 / 聊天 / 私聊名单时都可能再动到右下角这块面板的显隐，这里在函数最后
    //   统一给当前说书人再开一次父对话框（子控件已由 BOTC_BluffTellerUI 放好，父对话框不可见
    //   时子控件一律不渲染）。
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
    if (who >= 1 && who <= 13) {
        BOTC_Notice(who, "【换位完成】界面已全部重刷。");
    }
}

// 【测试·换座位】（用户 2026-10-07）：说书人点按钮 → 点两个玩家格 → 互换这两格。
//   用途：验证"座位换过之后，私聊 / 技能 / 提名投票 / 面板"是不是都还跟着人走。
// 【撤回所有人在选的「换座位」】（用户 2026-10-11）：按钮收掉之后，**已经点下按钮、还没点第二个座位**的人
//   原来还能接着换（点击流程只看 g_swapPickBy，不看锁没锁）→ 这里把他这一按也撤掉。
//   说书人【确认发放】和点【游戏正式开始】时都调它。
void BOTC_SwapCancelAll () {
    if (g_swapPickBy >= 2) {
        BOTC_Notice(g_swapPickBy, "换座位已经关闭了（说书人确认发放 / 正式开始）：这一按取消。");
    }
    g_swapPickBy = 0;
    g_swapFirst = 0;
}

void BOTC_SwapSeatStart (int p) {
    if (!BOTC_DevPlayer(p)) {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }

    if (g_swapPickBy == p) {
        g_swapPickBy = 0;
        g_swapFirst = 0;
        BOTC_Notice(p, "取消【测试·换座位】。");
        return;
    }
    g_swapPickBy = p;
    g_swapFirst = 0;
    BOTC_PanelOpen(p, 2);                       // 摊开魔典（跟【发起私聊】同一套）
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "【测试·换座位】点两个座位（可以点「说书人」那一格）：第一格 → 第二格；再点一次按钮可取消。");
}

// 【换座位 · 请求框】（用户 2026-10-07；2026-11-06 改为魔典中间的醒目弹窗）：
//   原来贴在魔典底部下方且隐藏背景，容易被忽略；现在放到屏幕正中、带底框和说明文字，
//   收到请求的人一眼就能看到【同意】/【拒绝】。
void BOTC_BuildSeatAsk () {
    DialogCreate(760, 250, c_anchorCenter, 0, -40, false);
    g_askDlg = DialogLastCreated();
    DialogSetVisible(g_askDlg, PlayerGroupAll(), false);
    BOTC_NewLabelC(g_askDlg, 720, 34, 20, 16, StringToText("换座位请求"));
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize20Bold", PlayerGroupAll());
    // 【不要逐字显示】（用户 2026-11-07）：请求人名字一填进去就整段立即显示，
    //   不用 NewLabelC（第 9 个参数会开「逐字显示」）。
    g_askLbl = BOTC_NewLabel(g_askDlg, 720, 40, 20, 62, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_askLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_askLbl, false, PlayerGroupAll());
    BOTC_NewLabelC(g_askDlg, 720, 26, 20, 112, StringToText("点击【同意】双方座位互换；15 秒内未处理将自动拒绝。"));
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize16Bold", PlayerGroupAll());
    g_askYes = BOTC_NewButton(g_askDlg, 260, 52, 70, 160, "同意");
    g_askNo = BOTC_NewButton(g_askDlg, 260, 52, 430, 160, "拒绝");
    DialogControlSetVisible(g_askLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_askYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_askNo, PlayerGroupAll(), false);
}

// 【是否抄录魔典】（用户 2026-11-06）：间谍 / 寡妇看完说书人实时真魔典后由本人选择。
//   只弹给当事人；抄录与否都会给说书人留一条记录。
void BOTC_BuildCopyAsk () {
    DialogCreate(820, 270, c_anchorCenter, 0, -40, false);
    g_copyDlg = DialogLastCreated();
    DialogSetVisible(g_copyDlg, PlayerGroupAll(), false);
    BOTC_NewLabelC(g_copyDlg, 780, 34, 20, 16, StringToText("查看说书人魔典"));
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize20Bold", PlayerGroupAll());
    g_copyLbl = BOTC_NewLabelC(g_copyDlg, 780, 44, 20, 62, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_copyLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_copyLbl, false, PlayerGroupAll());
    BOTC_NewLabelC(g_copyDlg, 780, 26, 20, 116, StringToText("【抄录】把此刻的魔典保存到你自己的魔典；【不抄录】看完即恢复。"));
    libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize16Bold", PlayerGroupAll());
    g_copyYes = BOTC_NewButton(g_copyDlg, 300, 52, 70, 180, "抄录");
    g_copyNo = BOTC_NewButton(g_copyDlg, 300, 52, 450, 180, "不抄录");
    DialogControlSetVisible(g_copyLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_copyYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_copyNo, PlayerGroupAll(), false);
}

// 【点【换座位】】（用户 2026-10-07）：正式开始前，任何玩家（含说书人）都能用。
void BOTC_SeatAskStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【暂时禁用换座位】（用户 2026-11-13）
    if (g_swapOff) {
        BOTC_Notice(p, "换座位功能已暂时关闭。");
        return;
    }
    if (g_started || g_boardOpen) {
        BOTC_Notice(p, "正式开始之后不能换座位。");
        return;
    }
    if (g_askPick[p]) {
        g_askPick[p] = false;
        BOTC_Notice(p, "取消【换座位】。");
        return;
    }
    // 【踢出投票期间禁止换座位】（用户 2026-11-10）：投票还没结束时谁都不能发起换座位。
    if (g_kickTar >= 1) {
        BOTC_Notice(p, "踢出投票进行中，暂时不能换座位。");
        return;
    }
    g_askPick[p] = true;
    BOTC_PanelOpen(p, 2);                          // 摊开魔典
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "【换座位】点一个座位（可以点「说书人」那一格）；再点一次按钮可取消。");
}

// 【点中某一格 → 发请求】（用户 2026-10-07）：cell = 点中的格子（1 = 说书人格）
void BOTC_SeatAskSend (int p, int cell) {
    int to;
    if (p < 1 || p > 13 || cell < 1 || cell > 13) {
        return;
    }
    g_askPick[p] = false;
    // 【踢出投票期间禁止换座位】（用户 2026-11-10）：已经进入选座状态的，投票一开就作废这一按。
    if (g_kickTar >= 1) {
        BOTC_Notice(p, "踢出投票进行中，暂时不能换座位。");
        return;
    }
    to = g_who[cell];                              // 那一格现在坐的**人**（物理座位）
    if (to == p) {
        BOTC_Notice(p, "那是你自己那一格，换一个吧。");
        return;
    }
    if (g_askFrom[to] != 0) {
        BOTC_Notice(p, BOTC_NameStr(BOTC_PosOf(to)) + " 已经收到一个换座位请求了，等他先处理。");
        return;
    }
    g_askFrom[to] = p;
    g_askSec[to] = 30;                             // 【15 秒应答窗口】（用户 2026-11-02）：超时自动拒绝
    libNtve_gf_SetDialogItemText(g_askLbl, BOTC_NameSubst(BOTC_NameStr(BOTC_PosOf(p)) + " 想与你交换座位"), PlayerGroupSingle(to));
    DialogControlSetVisible(g_askLbl, PlayerGroupSingle(to), true);
    DialogControlSetVisible(g_askYes, PlayerGroupSingle(to), true);
    DialogControlSetVisible(g_askNo, PlayerGroupSingle(to), true);
    DialogSetVisible(g_askDlg, PlayerGroupSingle(to), true);
    BOTC_PlaySfxTo(g_sfxReqName, to);              // 跟私聊请求同一个提示音
    BOTC_Notice(p, "已向 " + BOTC_NameStr(BOTC_PosOf(to)) + " 发出换座位请求，等对方同意。");
}

// 【对方点同意 / 拒绝】（用户 2026-10-07）
void BOTC_SeatAskAnswer (int p, bool yes) {
    int from;
    int a;
    int b;
    if (p < 1 || p > 13) {
        return;
    }
    from = g_askFrom[p];
    if (from == 0) {
        return;
    }
    g_askFrom[p] = 0;
    g_askSec[p] = 0;
    libNtve_gf_SetDialogItemText(g_askLbl, StringToText(""), PlayerGroupSingle(p));
    DialogControlSetVisible(g_askLbl, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_askYes, PlayerGroupSingle(p), false);
    DialogControlSetVisible(g_askNo, PlayerGroupSingle(p), false);
    DialogSetVisible(g_askDlg, PlayerGroupSingle(p), false);
    if (g_started) {
        BOTC_Notice(p, "已经正式开始了，这次换座位作废。");
        return;
    }
    // 【踢出投票期间禁止换座位】（用户 2026-11-10）：同意也不生效，直接作废这次请求。
    if (yes && g_kickTar >= 1) {
        BOTC_Notice(p, "踢出投票进行中，暂时不能换座位，这次请求作废。");
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 想换座位，但踢出投票进行中，这次请求作废。");
        return;
    }
    if (!yes) {
        BOTC_Notice(from, BOTC_NameStr(BOTC_PosOf(p)) + " 拒绝了和你换座位。");
        return;
    }
    a = BOTC_PosOf(from);                          // 发起人现在占的格子
    b = BOTC_PosOf(p);                             // 我（同意方）现在占的格子
    if (a < 1 || a > 13 || b < 1 || b > 13 || a == b) {
        return;
    }
    BOTC_SeatSwap(a, b);                           // 整体对调（含说书人格：换到格子 1 的人当说书人）
    BOTC_PubAnnounce("【换座位】" + BOTC_NameStr(a) + " ↔ " + BOTC_NameStr(b) + "（双方同意）");
}

// 【换座位请求 15 秒超时】（用户 2026-11-02）：无操作默认拒绝。
void BOTC_SeatAskTimeout (int p) {
    int from;
    from = g_askFrom[p];
    if (from == 0) {
        return;
    }
    BOTC_SeatAskAnswer(p, false);
    BOTC_Notice(p, "换座位请求超时，已自动拒绝。");
}

// 【私聊请求 15 秒超时】（用户 2026-11-02）：无操作默认拒绝，并进入 15 秒冷却。
void BOTC_ReqTimeout (int p) {
    int from;
    if (g_invSess[p] != 0) {
        BOTC_DeclineInvite(p, true);
        return;
    }
    if (g_reqJoinSess[p] != 0) {
        BOTC_VoteJoin(p, false);
        return;
    }
    from = g_reqFrom[p];
    if (from == 0) {
        return;
    }
    g_reqFrom[p] = 0;
    BOTC_ClearReq(p);
    BOTC_PmCooldown(from, p);
    BOTC_Notice(p, "私聊请求已超时，自动拒绝。");
    BOTC_AppendPm(from, BOTC_NameStr(BOTC_PosOf(p)) + " 没有在 15 秒内回应，私聊请求已自动取消。");
}

// 【防刷屏 · 声称 / 快进 / 屏蔽冷却 + 公聊禁言】（用户 2026-11-06）
//   1. 同一名玩家两次「声称」之间至少 15 秒，倒计时从这次声称被播报到公聊那一刻开始；
//      只有猜书生 / 猜醉酒 / 全员追忆（板子 13）专属的猜角色算「猜测」，不占冷却，
//      其余入口（猜落难、戏法师等）一律按声称处理。
//   2. 【快进到提名】按钮：同一名玩家 5 秒内只能点一次（投票和取消共用）。
//   3. 【屏蔽 / 解除屏蔽】：同一名玩家 5 秒内只能操作一次（换目标也算）。
//   4. 公聊频道 5 秒内连发 5 条即视为刷屏，禁言 15 秒；私聊与提名阶段不检测。
bool BOTC_DeclareIsGuess (int idx) {
    if (idx == 0) {
        // 猜角色只属于全员追忆（板子 13），其他剧本的 0 号占位不算猜测。
        return (g_board == 13);
    }
    return (idx == 109 || idx == 152);
}

bool BOTC_DeclareCdBlocked (int p) {
    int sec;
    if (p < 1 || p > 13) {
        return true;
    }
    if (g_declareCd[p] <= 0) {
        return false;
    }
    sec = (g_declareCd[p] + 1) / 2;
    BOTC_Notice(p, "【声称】冷却中：还需 " + IntToString(sec) + " 秒才能再声称。");
    return true;
}

void BOTC_DeclareCdSet (int p) {
    if (p >= 1 && p <= 13) {
        g_declareCd[p] = 30;
    }
}

bool BOTC_SpamAllow (int p) {
    int sec;
    if (p < 1 || p > 13) {
        return true;
    }
    if (g_spamMute[p] > 0) {
        sec = (g_spamMute[p] + 1) / 2;
        BOTC_Notice(p, "【公聊】你因刷屏被禁言：还需 " + IntToString(sec) + " 秒。");
        return false;
    }
    if (g_spamWin[p] > 0) {
        g_spamCnt[p] = g_spamCnt[p] + 1;
    }
    else {
        g_spamWin[p] = 10;
        g_spamCnt[p] = 1;
    }
    if (g_spamCnt[p] >= 5) {
        g_spamCnt[p] = 0;
        g_spamWin[p] = 0;
        g_spamMute[p] = 30;
        BOTC_Notice(p, "【公聊】检测到刷屏：你被禁言 15 秒。");
        return false;
    }
    return true;
}

// 这些冷却都挂在 0.5 秒一拍的 BOTC_Tick_Func 上。
void BOTC_GateCdTick () {
    int p;
    // 【唤醒下一个】1 秒内置冷却（2 拍）
    if (g_wakeCd > 0) {
        g_wakeCd = g_wakeCd - 1;
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_declareCd[p] > 0) {
            g_declareCd[p] = g_declareCd[p] - 1;
        }
        if (g_skipCd[p] > 0) {
            g_skipCd[p] = g_skipCd[p] - 1;
        }
        if (g_blockCd[p] > 0) {
            g_blockCd[p] = g_blockCd[p] - 1;
        }
        // 【屏蔽 / 踢出玩家 按钮只属于两个面板】（用户 2026-11-07）：身份标记面板（模式 0）和
        //   声称/猜测面板（模式 3）以外，一律把这两个按钮收起来，避免残留在技能网格等窗口上。
        if (g_pickMode[p] == 0 || g_pickMode[p] == 3) {
            g_pickBtnOff[p] = 0;
        }
        else {
            if (g_pickBtnOff[p] == 0) {
                g_pickBtnOff[p] = 1;
                DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(p), false);
                DialogControlSetVisible(g_kickBtnPick, PlayerGroupSingle(p), false);
            }
        }
        if (g_spamMute[p] > 0) {
            g_spamMute[p] = g_spamMute[p] - 1;
        }
        if (g_spamWin[p] > 0) {
            g_spamWin[p] = g_spamWin[p] - 1;
        }
    }
    // 【踢出玩家】共用冷却（所有人共用一个计时器，不按玩家分开）
    if (g_kickBtnCd > 0) {
        g_kickBtnCd = g_kickBtnCd - 1;
    }
}

// 【请求计时】（用户 2026-11-02）：挂在 0.5 秒一拍的 BOTC_Tick_Func 上。
//   30 拍 = 15 秒；同时递减私聊拒绝冷却。
void BOTC_ReqTick () {
    int p;
    int q;
    int s;
    int who;
    int from;
    bool ok;
    for (p = 1; p <= 13; p += 1) {
        // 【房间状态变化 → 默认拒绝】（用户 2026-11-10）：审批框还在，但房主已经离开房间 /
        //   申请人或被点成员已经进出别的私聊，这时候点【是】或【否】都没有意义，直接作废。
        if (g_reqJoinSess[p] != 0) {
            s = g_reqJoinSess[p];
            ok = BOTC_SessApprover(s, p);
            if (ok) {
                who = g_joinWho[s];
                if (who < 1 || who > 13 || g_mySess[who] != 0) {
                    ok = false;
                }
            }
            if (ok && g_joinTell[s] >= 1 && g_joinTell[s] <= 13) {
                if (!BOTC_SessIn(s, g_joinTell[s])) {
                    ok = false;
                }
            }
            if (!ok) {
                BOTC_JoinVoid(s, p);
            }
        }
        // 【邀请同理】（用户 2026-11-10）：邀请人离开房间，或被邀请人进了别的私聊，邀请立即失效。
        if (g_invSess[p] != 0) {
            s = g_invSess[p];
            from = g_invFrom[p];
            ok = BOTC_SessIn(s, from);
            if (ok && g_mySess[p] != 0) {
                ok = false;
            }
            if (!ok) {
                BOTC_InviteVoid(p);
            }
        }
        if (g_reqFrom[p] != 0 || g_reqJoinSess[p] != 0 || g_invSess[p] != 0) {
            if (g_reqSec[p] > 0) {
                g_reqSec[p] = g_reqSec[p] - 1;
                if (g_reqSec[p] <= 0) {
                    BOTC_ReqTimeout(p);
                }
            }
        }
    }
    for (p = 1; p <= 13; p += 1) {
        for (q = 1; q <= 13; q += 1) {
            if (g_pmCool[(p * 14) + q] > 0) {
                g_pmCool[(p * 14) + q] = g_pmCool[(p * 14) + q] - 1;
            }
        }
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_askFrom[p] != 0) {
            if (g_askSec[p] > 0) {
                g_askSec[p] = g_askSec[p] - 1;
                if (g_askSec[p] <= 0) {
                    BOTC_SeatAskTimeout(p);
                }
            }
        }
    }
}

// 【换位时跟着角色/玩家走的逐格运行状态】
//   g_mark / g_tokOn 与死亡记录已经由两个换位入口单独搬运；这里再补首夜、
//   当前技能选择、赋予能力、每日声称等按逻辑格保存的数组。漏搬时最典型的
//   现象是：换说书人后卡扎力面板仍开着却点不动，或者新玩家继承另一格
//   “今天已经造谣过”的状态。
void BOTC_SwapPerSeatRuntime (int x, int y) {
    int t;
    int i;
    bool b;
    string s;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {
        return;
    }
    t = g_seatFirstNight[x]; g_seatFirstNight[x] = g_seatFirstNight[y]; g_seatFirstNight[y] = t;
    b = g_awake[x];          g_awake[x] = g_awake[y];          g_awake[y] = b;
    b = g_autoWoke[x];       g_autoWoke[x] = g_autoWoke[y];    g_autoWoke[y] = b;
    b = g_insertWake[x];     g_insertWake[x] = g_insertWake[y]; g_insertWake[y] = b;
    if (g_manualWakeSeat == x) { g_manualWakeSeat = y; }
    else { if (g_manualWakeSeat == y) { g_manualWakeSeat = x; } }
    if (g_manualWakeQueue == x) { g_manualWakeQueue = y; }
    else { if (g_manualWakeQueue == y) { g_manualWakeQueue = x; } }
    b = g_wokeTonight[x];    g_wokeTonight[x] = g_wokeTonight[y]; g_wokeTonight[y] = b;

    b = g_skillPicking[x];   g_skillPicking[x] = g_skillPicking[y]; g_skillPicking[y] = b;
    b = g_limitedAsk[x];     g_limitedAsk[x] = g_limitedAsk[y]; g_limitedAsk[y] = b;
    b = g_poAsk[x];          g_poAsk[x] = g_poAsk[y];          g_poAsk[y] = b;
    t = g_skillT1[x];        g_skillT1[x] = g_skillT1[y];      g_skillT1[y] = t;
    t = g_skillT2[x];        g_skillT2[x] = g_skillT2[y];      g_skillT2[y] = t;
    t = g_skillT3[x];        g_skillT3[x] = g_skillT3[y];      g_skillT3[y] = t;
    t = g_skillRoleSel[x];   g_skillRoleSel[x] = g_skillRoleSel[y]; g_skillRoleSel[y] = t;

    t = g_grantRoleBy[x];    g_grantRoleBy[x] = g_grantRoleBy[y]; g_grantRoleBy[y] = t;
    // 【变脸师】获得过的角色清单跟着角色所在格一起搬（用户 2026-11-10）。
    for (i = 0; i < 164; i += 1) {
        b = g_faceEver[(x * 164) + i];
        g_faceEver[(x * 164) + i] = g_faceEver[(y * 164) + i];
        g_faceEver[(y * 164) + i] = b;
    }
    // 【变脸师】临时变脸状态也跟着角色所在格一起搬（用户 2026-11-10）。
    t = g_faceDone[x];       g_faceDone[x] = g_faceDone[y];       g_faceDone[y] = t;
    b = g_faceFail[x];       g_faceFail[x] = g_faceFail[y];       g_faceFail[y] = b;
    t = g_faceShow[x];       g_faceShow[x] = g_faceShow[y];       g_faceShow[y] = t;
    t = g_faceBase[x];       g_faceBase[x] = g_faceBase[y];       g_faceBase[y] = t;
    t = g_facePrevRole[x];   g_facePrevRole[x] = g_facePrevRole[y]; g_facePrevRole[y] = t;
    t = g_facePrevFirstNight[x]; g_facePrevFirstNight[x] = g_facePrevFirstNight[y]; g_facePrevFirstNight[y] = t;
    b = g_facePrevDrunkBy[x]; g_facePrevDrunkBy[x] = g_facePrevDrunkBy[y]; g_facePrevDrunkBy[y] = b;
    b = g_facePrevActing[x]; g_facePrevActing[x] = g_facePrevActing[y]; g_facePrevActing[y] = b;
    b = g_facePrevDoneNight[x]; g_facePrevDoneNight[x] = g_facePrevDoneNight[y]; g_facePrevDoneNight[y] = b;
    b = g_grantDrunkBy[x];   g_grantDrunkBy[x] = g_grantDrunkBy[y]; g_grantDrunkBy[y] = b;
    b = g_grantActing[x];    g_grantActing[x] = g_grantActing[y]; g_grantActing[y] = b;
    b = g_grantDoneNight[x]; g_grantDoneNight[x] = g_grantDoneNight[y]; g_grantDoneNight[y] = b;
    t = g_grantFirstNight[x]; g_grantFirstNight[x] = g_grantFirstNight[y]; g_grantFirstNight[y] = t;

    b = g_profUsed[x];       g_profUsed[x] = g_profUsed[y];    g_profUsed[y] = b;
    b = g_foolUsed[x];       g_foolUsed[x] = g_foolUsed[y];    g_foolUsed[y] = b;
    b = g_assiUsed[x];       g_assiUsed[x] = g_assiUsed[y];    g_assiUsed[y] = b;
    b = g_courtUsed[x];      g_courtUsed[x] = g_courtUsed[y];  g_courtUsed[y] = b;

    b = g_gossipDone[x];     g_gossipDone[x] = g_gossipDone[y]; g_gossipDone[y] = b;
    t = g_gossipDay[x];      g_gossipDay[x] = g_gossipDay[y];   g_gossipDay[y] = t;
    s = g_gossipTextBy[x];   g_gossipTextBy[x] = g_gossipTextBy[y]; g_gossipTextBy[y] = s;
    b = g_juggDone[x];       g_juggDone[x] = g_juggDone[y];    g_juggDone[y] = b;
    b = g_juggUsed[x];       g_juggUsed[x] = g_juggUsed[y];    g_juggUsed[y] = b;
    b = g_psyDone[x];        g_psyDone[x] = g_psyDone[y];      g_psyDone[y] = b;
    t = g_psyDay[x];         g_psyDay[x] = g_psyDay[y];        g_psyDay[y] = t;
    // 【全员追忆 · 猜角色】（用户 2026-11-06）：换座位时日期戳和已猜对标记跟着人走
    t = g_guessRoleDay[x];   g_guessRoleDay[x] = g_guessRoleDay[y]; g_guessRoleDay[y] = t;
    b = g_guessRoleDone[x];  g_guessRoleDone[x] = g_guessRoleDone[y]; g_guessRoleDone[y] = b;
    b = g_cultDeclDone[x];   g_cultDeclDone[x] = g_cultDeclDone[y]; g_cultDeclDone[y] = b;
    // ⚠ g_damselPick / g_damselDone 按**物理玩家**记（不是格子），换座位时不能对调，
    //   否则两个人当天的猜落难次数会跟着格子错位。
    b = g_rascalActive[x];   g_rascalActive[x] = g_rascalActive[y]; g_rascalActive[y] = b;
    t = g_rascalRole[x];     g_rascalRole[x] = g_rascalRole[y]; g_rascalRole[y] = t;
    b = g_pedantActing[x];   g_pedantActing[x] = g_pedantActing[y]; g_pedantActing[y] = b;
    if (g_vixenSeat == x) { g_vixenSeat = y; }
    else { if (g_vixenSeat == y) { g_vixenSeat = x; } }
    // 【投毒者的毒跟着人走】（用户 2026-11-01 / 2026-11-13）：按来源座位独立记账。
    //   来源座位整体对调（谁下的毒跟着人走），再把所有目标座位按 x↔y 换格。
    t = g_poisonAt[x]; g_poisonAt[x] = g_poisonAt[y]; g_poisonAt[y] = t;
    t = g_poisonDayBy[x]; g_poisonDayBy[x] = g_poisonDayBy[y]; g_poisonDayBy[y] = t;
    for (i = 0; i <= 13; i += 1) {
        if (g_poisonAt[i] == x) { g_poisonAt[i] = y; }
        else { if (g_poisonAt[i] == y) { g_poisonAt[i] = x; } }
    }
    if (g_vixenTarget == x) { g_vixenTarget = y; }
    else { if (g_vixenTarget == y) { g_vixenTarget = x; } }
    b = g_moonDone[x];       g_moonDone[x] = g_moonDone[y];    g_moonDone[y] = b;
    b = g_moonClaimed[x];    g_moonClaimed[x] = g_moonClaimed[y]; g_moonClaimed[y] = b;
    t = g_moonPick[x];       g_moonPick[x] = g_moonPick[y];    g_moonPick[y] = t;
    b = g_moonOpen[x];       g_moonOpen[x] = g_moonOpen[y];    g_moonOpen[y] = b;
    b = g_klutzDone[x];      g_klutzDone[x] = g_klutzDone[y];  g_klutzDone[y] = b;
    b = g_klutzClaimed[x];   g_klutzClaimed[x] = g_klutzClaimed[y]; g_klutzClaimed[y] = b;
    t = g_klutzPick[x];      g_klutzPick[x] = g_klutzPick[y];  g_klutzPick[y] = t;

    // 只保存单一格号的光标也要跟着那一格搬家，不能留下旧格号。
    if (g_lastDeadSeat == x) { g_lastDeadSeat = y; }
    else { if (g_lastDeadSeat == y) { g_lastDeadSeat = x; } }
    if (g_gossipBy == x) { g_gossipBy = y; }
    else { if (g_gossipBy == y) { g_gossipBy = x; } }
    if (g_autoLast == x) { g_autoLast = y; }
    else { if (g_autoLast == y) { g_autoLast = x; } }
    for (i = 1; i <= 3; i += 1) {
        t = g_wardenPick[(x * 4) + i];
        g_wardenPick[(x * 4) + i] = g_wardenPick[(y * 4) + i];
        g_wardenPick[(y * 4) + i] = t;
    }
    t = g_wardenBy[x];
    g_wardenBy[x] = g_wardenBy[y];
    g_wardenBy[y] = t;
    for (i = 1; i <= 13; i += 1) {
        if (i == x || i == y) { continue; }
        if (g_wardenBy[i] == x) { g_wardenBy[i] = y; }
        else if (g_wardenBy[i] == y) { g_wardenBy[i] = x; }
    }
    if (g_wardenAskBy == x) { g_wardenAskBy = y; }
    else if (g_wardenAskBy == y) { g_wardenAskBy = x; }
    for (i = 0; i < 4; i += 1) {
        if (g_wardenCand[i] == x) { g_wardenCand[i] = y; }
        else if (g_wardenCand[i] == y) { g_wardenCand[i] = x; }
    }
    // 【洗脑师 · 疯狂记账】跟着人一起搬家（用户 2026-11-10）
    BOTC_CerenSwapState(x, y);
}

void BOTC_GudiaoSwapState (int x, int y) {
    int q;
    int t;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {
        return;
    }
    t = g_gdPrev[x];
    g_gdPrev[x] = g_gdPrev[y];
    g_gdPrev[y] = t;
    for (q = 1; q <= 13; q += 1) {
        if (g_gdBy[q] == x) {
            g_gdBy[q] = y;
        }
        else if (g_gdBy[q] == y) {
            g_gdBy[q] = x;
        }
        if (g_gdFlightBy[q] == x) {
            g_gdFlightBy[q] = y;
        }
        else if (g_gdFlightBy[q] == y) {
            g_gdFlightBy[q] = x;
        }
    }
}

// 真换：第 x 格 与 第 y 格 互换（x / y 都是格子 2..13；说书人格不参与）
//   ① 列 = 被看的人（身份 / token）两格对调   ② 行 = 观察者（谁知道什么）两个人对调
//   ③ 每格自己的数组（在场 / 死亡）对调       ④ g_who（谁坐哪格）对调
//   ⚠ g_mySess / 私聊成员**不动**（人没有换，会话跟着人）
void BOTC_SwapSkinState (int x, int y) {
    int q;
    int t;
    bool b;
    b = g_liveCorpse[x];        g_liveCorpse[x] = g_liveCorpse[y];          g_liveCorpse[y] = b;
    b = g_liveCorpseLost[x];    g_liveCorpseLost[x] = g_liveCorpseLost[y];  g_liveCorpseLost[y] = b;
    b = g_deathLearned[x];      g_deathLearned[x] = g_deathLearned[y];      g_deathLearned[y] = b;
    b = g_skinChainBroken[x];   g_skinChainBroken[x] = g_skinChainBroken[y];g_skinChainBroken[y] = b;
    t = g_liveCorpseFrom[x];    g_liveCorpseFrom[x] = g_liveCorpseFrom[y];  g_liveCorpseFrom[y] = t;
    t = g_skinTarget[x];        g_skinTarget[x] = g_skinTarget[y];          g_skinTarget[y] = t;
    t = g_skinTargetBy[x];      g_skinTargetBy[x] = g_skinTargetBy[y];      g_skinTargetBy[y] = t;
    t = g_skinActionNight[x];   g_skinActionNight[x] = g_skinActionNight[y];g_skinActionNight[y] = t;
    // 座位互换后，状态里记录的来源 / 目标座位也要跟着映射，不能留下旧编号。
    for (q = 1; q <= 13; q += 1) {
        if (g_liveCorpseFrom[q] == x) { g_liveCorpseFrom[q] = y; }
        else if (g_liveCorpseFrom[q] == y) { g_liveCorpseFrom[q] = x; }
        if (g_skinTarget[q] == x) { g_skinTarget[q] = y; }
        else if (g_skinTarget[q] == y) { g_skinTarget[q] = x; }
        if (g_skinTargetBy[q] == x) { g_skinTargetBy[q] = y; }
        else if (g_skinTargetBy[q] == y) { g_skinTargetBy[q] = x; }
    }
    if (g_envoyBy == x) { g_envoyBy = y; }
    else if (g_envoyBy == y) { g_envoyBy = x; }
    if (g_envoySeat == x) { g_envoySeat = y; }
    else if (g_envoySeat == y) { g_envoySeat = x; }
    if (g_halfBy == x) { g_halfBy = y; }
    else if (g_halfBy == y) { g_halfBy = x; }
    if (g_halfOriginal == x) { g_halfOriginal = y; }
    else if (g_halfOriginal == y) { g_halfOriginal = x; }
    if (g_brokerBy == x) { g_brokerBy = y; }
    else if (g_brokerBy == y) { g_brokerBy = x; }
    if (g_brokerA == x) { g_brokerA = y; }
    else if (g_brokerA == y) { g_brokerA = x; }
    if (g_brokerB == x) { g_brokerB = y; }
    else if (g_brokerB == y) { g_brokerB = x; }
    if (g_brokerRedirectedBy == x) { g_brokerRedirectedBy = y; }
    else if (g_brokerRedirectedBy == y) { g_brokerRedirectedBy = x; }
    if (g_choiceOrigBy == x) { g_choiceOrigBy = y; }
    else if (g_choiceOrigBy == y) { g_choiceOrigBy = x; }
    if (g_choiceOrigT1 == x) { g_choiceOrigT1 = y; }
    else if (g_choiceOrigT1 == y) { g_choiceOrigT1 = x; }
    if (g_choiceOrigT2 == x) { g_choiceOrigT2 = y; }
    else if (g_choiceOrigT2 == y) { g_choiceOrigT2 = x; }
    if (g_choiceOrigT3 == x) { g_choiceOrigT3 = y; }
    else if (g_choiceOrigT3 == y) { g_choiceOrigT3 = x; }
}

void BOTC_SeatSwap (int x, int y) {
    int q;
    int t;
    int ob;
    int a;
    int b;
    int ib;
    bool bb;
    string s;
    if (x < 1 || x > 13 || y < 1 || y > 13 || x == y) {   // 【测试·换座位】允许格子 1（说书人格）
        return;
    }
    BOTC_SwapOwnShownCapture();                 // 【换位前】记下谁本来就看得见自己的身份（用户 2026-11-07）
    a = g_who[x];                               // 第 x 格现在坐的人（物理座位）
    b = g_who[y];
    // ① 列：两格的身份 / token 对调
    for (ob = 1; ob <= 13; ob += 1) {
        ib = g_mark[(ob * 14) + x];
        g_mark[(ob * 14) + x] = g_mark[(ob * 14) + y];
        g_mark[(ob * 14) + y] = ib;
        for (t = 0; t < 256; t += 1) {
            bb = g_tokOn[(((ob * 14) + x) * 256) + t];
            g_tokOn[(((ob * 14) + x) * 256) + t] = g_tokOn[(((ob * 14) + y) * 256) + t];
            g_tokOn[(((ob * 14) + y) * 256) + t] = bb;
        }
    }
    // 【保存旧说书人的真值行】（列已经先换过，所以这份快照就是换位后的完整真值 token 行）。
    if (x == 1 || y == 1) {
        for (q = 1; q <= 13; q += 1) {
            g_swapTruthMark[q] = g_mark[(g_teller * 14) + q];
            for (t = 0; t < 256; t += 1) {
                g_swapTruthTok[(q * 256) + t] = g_tokOn[(((g_teller * 14) + q) * 256) + t];
            }
        }
    }
    // ② 行：两个人"知道什么"对调（间谍那份备份 / 说书人真值行也跟着人走）
    for (q = 1; q <= 13; q += 1) {
        ib = g_mark[(a * 14) + q];
        g_mark[(a * 14) + q] = g_mark[(b * 14) + q];
        g_mark[(b * 14) + q] = ib;
        for (t = 0; t < 256; t += 1) {
            bb = g_tokOn[(((a * 14) + q) * 256) + t];
            g_tokOn[(((a * 14) + q) * 256) + t] = g_tokOn[(((b * 14) + q) * 256) + t];
            g_tokOn[(((b * 14) + q) * 256) + t] = bb;
        }
    }
    // ③ 每格自己的数组（死亡）—— ⚠ `g_seatOn` 不换（同【换说书人】：那是"槽位有没有真人"，跟着槽位走）
    bb = g_deadShown[x];   g_deadShown[x] = g_deadShown[y];   g_deadShown[y] = bb;
    bb = g_deadPending[x]; g_deadPending[x] = g_deadPending[y]; g_deadPending[y] = bb;
    bb = g_leftShown[x];   g_leftShown[x] = g_leftShown[y];   g_leftShown[y] = bb;
    t = g_deadKind[x];     g_deadKind[x] = g_deadKind[y];     g_deadKind[y] = t;
    t = g_deadByDemon[x];  g_deadByDemon[x] = g_deadByDemon[y];  g_deadByDemon[y] = t;
    t = g_deadType[x];     g_deadType[x] = g_deadType[y];     g_deadType[y] = t;
    t = g_deadNightNum[x]; g_deadNightNum[x] = g_deadNightNum[y]; g_deadNightNum[y] = t;
    t = g_deadClaimDay[x]; g_deadClaimDay[x] = g_deadClaimDay[y]; g_deadClaimDay[y] = t;
    t = g_deadDay[x];      g_deadDay[x] = g_deadDay[y];       g_deadDay[y] = t;
    bb = g_bansheeSaid[x]; g_bansheeSaid[x] = g_bansheeSaid[y]; g_bansheeSaid[y] = bb;
    bb = g_bansheePower[x]; g_bansheePower[x] = g_bansheePower[y]; g_bansheePower[y] = bb;
    bb = g_bansheeSecondNom[x]; g_bansheeSecondNom[x] = g_bansheeSecondNom[y]; g_bansheeSecondNom[y] = bb;
    t = g_bnestRoleBy[x]; g_bnestRoleBy[x] = g_bnestRoleBy[y]; g_bnestRoleBy[y] = t;
    bb = g_bnestChosenBy[x]; g_bnestChosenBy[x] = g_bnestChosenBy[y]; g_bnestChosenBy[y] = bb;
    bb = g_bnestActing[x]; g_bnestActing[x] = g_bnestActing[y]; g_bnestActing[y] = bb;
    t = g_bnestSource[x]; g_bnestSource[x] = g_bnestSource[y]; g_bnestSource[y] = t;
    t = g_harpyFirstBy[x]; g_harpyFirstBy[x] = g_harpyFirstBy[y]; g_harpyFirstBy[y] = t;
    t = g_harpySecondBy[x]; g_harpySecondBy[x] = g_harpySecondBy[y]; g_harpySecondBy[y] = t;
    t = g_harpyDay[x]; g_harpyDay[x] = g_harpyDay[y]; g_harpyDay[y] = t;
    bb = g_organDrunkBy[x]; g_organDrunkBy[x] = g_organDrunkBy[y]; g_organDrunkBy[y] = bb;
    // 【僵怖的两个标记也要跟着人走】（用户 2026-10-07 报「换完之后僵怖死亡没有死亡音效」）：
    //   `g_zombUsed`（「第一次不会死」用过没有）/ `g_zombFake`（现在算不算活着）记的是**人**的状态，
    //   上面这一串漏了它们 → 换位之后僵怖的假死 / 真死判定、以及死亡音效的静音判定
    //   （`BOTC_DeathSfxMute` 读的就是 `g_zombUsed`）都会落到错的格子上。
    bb = g_zombUsed[x];    g_zombUsed[x] = g_zombUsed[y];     g_zombUsed[y] = bb;
    bb = g_zombFake[x];    g_zombFake[x] = g_zombFake[y];     g_zombFake[y] = bb;
    BOTC_SwapSkinState(x, y);
    BOTC_GudiaoSwapState(x, y);
    BOTC_SwapPerSeatRuntime(x, y);
    // ④ 谁坐哪格
    t = g_who[x];          g_who[x] = g_who[y];               g_who[y] = t;
    // ⑤ 动到了「说书人格」（格子 1）→ 坐进去的人就是**新说书人**（跟【换说书人】同一套收尾）
    if (x == 1 || y == 1) {
        g_teller = g_who[1];
        // 【强制回写真值行】（用户 2026-10-21）：不依赖前面的行列置换顺序，
        // 新说书人的观察者行必须拿到旧说书人那一行的完整身份 + token。
        for (q = 1; q <= 13; q += 1) {
            g_mark[(g_teller * 14) + q] = g_swapTruthMark[q];
            for (t = 0; t < 256; t += 1) {
                g_tokOn[(((g_teller * 14) + q) * 256) + t] = g_swapTruthTok[(q * 256) + t];
            }
        }
        // ⚠ g_hideSeat 不动（同上：换说书人不改玩家人数）
        BOTC_PubAnnounce("【换座位】" + BOTC_NameStr(x) + " ↔ " + BOTC_NameStr(y) + "：说书人格换人了");
        BOTC_PmStore(g_teller, "【换座位】你现在是新的说书人。");
        BOTC_BsBtnRender();
        DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);
        DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
        DialogSetVisible(g_tmMiniDlg, PlayerGroupAll(), false);
        DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
        DialogSetVisible(g_tmMiniDlg, PlayerGroupSingle(g_teller), true);
    }
    // ⑥ 留档 + 重刷全场魔典（两格的名字都变了）
    s = "【换座位】" + BOTC_NameStr(x) + " ↔ " + BOTC_NameStr(y);
    BOTC_PmStore(g_teller, s);
    if (g_swapPickBy >= 1) {
        BOTC_Notice(g_swapPickBy, s);
    }
    // 换位会改动诺-达鲺的相邻关系：丢掉旧毒口并按新座位立刻重算一次。
    g_nodA = 0;
    g_nodB = 0;
    g_nodDemon = 0;
    g_nodManual = false;
    if (g_started) {
        BOTC_NoDashiiSync();
    }
    BOTC_AfterSeatChange(g_swapPickBy);    // 【统一重刷】（用户 2026-10-07）
}

void BOTC_TellerPickStart (int p) {
    if (p != g_teller) {
        return;
    }
    if (g_tellerPick == p) {
        g_tellerPick = 0;
        BOTC_Notice(g_teller, "取消【换说书人】。");
        return;
    }
    g_tellerPick = p;
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    g_grimOn[p] = true;
    BOTC_Notice(p, "点一个座位：让他成为新的说书人（你会坐到他原来的位置）。再点一次按钮可取消。");
}

void BOTC_TellerHandover (int p, int seat) {
    int old;          // 老说书人的**物理座位**（行 = 谁知道什么，按物理座位存）
    int posOld;       // 老说书人占的**位置/格子**（说书人格永远是 1）
    int newSeat;      // 新说书人的**物理座位**（点的那一格现在坐的人）
    int q;
    int t;
    int ob;
    bool b;
    int ib;
    string nOld;
    string nNew;
    g_tellerPick = 0;
    if (seat < 2 || seat > 13) {
        BOTC_Notice(g_teller, "这个格子不能换说书人。");
        return;
    }
    old = g_teller;                // 老说书人的物理座位
    posOld = BOTC_PosOf(old);      // 老说书人占的格子（第一次换位时 = 1）
    newSeat = g_who[seat];         // 点的那一格现在坐的人 —— 必须在 g_who 对调**之前**取
    if (seat == posOld || newSeat == old) {
        BOTC_Notice(g_teller, "这个格子不能换说书人。");
        return;
    }
    // 【先拼名字再换人】（用户 2026-10-06 报「播报里写成 玩家0 → 说书人」）：
    //   `BOTC_NameStr()` 判断"是不是说书人"用的是 `g_teller`，所以必须在**换之前**把名字取好。
    nOld = BOTC_NameStr(posOld);
    nNew = BOTC_NameStr(seat);
    BOTC_SwapOwnShownCapture();    // 【换位前】记下谁本来就看得见自己的身份（用户 2026-11-07）
    // ① 魔典「谁看到什么」的矩阵。⚠【行列是两套坐标系】（用户 2026-10-07 报「第二次换位就乱」）：
    //    · **行 = 观察者 = 物理座位**（谁知道什么）→ 老说书人 old 与 新说书人 newSeat 两行对调，
    //      真值行跟着"说书人这个身份"走，新说书人才看得到真魔典。
    //    · **列 = 被看的人 = 位置/格子** → 「说书人格 posOld」与「点的那个格子 seat」两列对调。
    //    （原来两处都用 old = g_teller：第一次换位两者恰好都是 1 所以看不出问题，换第二次就错行。）
    // 【先快照原始真值行】（用户 2026-10-24）：后续行列交换即使有一步出错，
    //   最终也必须能从这份原始快照恢复新说书人的身份与全部 token。
    for (q = 1; q <= 13; q += 1) {
        g_swapTruthMark[q] = g_mark[(old * 14) + q];
        for (t = 0; t < 256; t += 1) {
            g_swapTruthTok[(q * 256) + t] = g_tokOn[(((old * 14) + q) * 256) + t];
        }
    }
    for (q = 1; q <= 13; q += 1) {
        ib = g_mark[(old * 14) + q];
        g_mark[(old * 14) + q] = g_mark[(newSeat * 14) + q];
        g_mark[(newSeat * 14) + q] = ib;
    }
    for (ob = 1; ob <= 13; ob += 1) {
        ib = g_mark[(ob * 14) + posOld];
        g_mark[(ob * 14) + posOld] = g_mark[(ob * 14) + seat];
        g_mark[(ob * 14) + seat] = ib;
    }
    for (q = 1; q <= 13; q += 1) {
        for (t = 0; t < 256; t += 1) {
            b = g_tokOn[(((old * 14) + q) * 256) + t];
            g_tokOn[(((old * 14) + q) * 256) + t] = g_tokOn[(((newSeat * 14) + q) * 256) + t];
            g_tokOn[(((newSeat * 14) + q) * 256) + t] = b;
        }
    }
    for (ob = 1; ob <= 13; ob += 1) {
        for (t = 0; t < 256; t += 1) {
            b = g_tokOn[(((ob * 14) + posOld) * 256) + t];
            g_tokOn[(((ob * 14) + posOld) * 256) + t] = g_tokOn[(((ob * 14) + seat) * 256) + t];
            g_tokOn[(((ob * 14) + seat) * 256) + t] = b;
        }
    }
    // 【间谍 / 寡妇抄录快照也要跟着换列】（用户 2026-11-10）：快照按格子索引，而名字是按格子实时渲染的，
    //   只换 g_mark 不换快照的话，抄录魔典会把新说书人原来的身份继续挂在旧格子上（配着老说书人的名字），
    //   与实时真魔典对不上。行列语义与上面 g_mark / g_tokOn 完全一致：行 = 物理座位，列 = 格子。
    for (ob = 1; ob <= 13; ob += 1) {
        ib = g_grimSnapMark[(ob * 14) + posOld];
        g_grimSnapMark[(ob * 14) + posOld] = g_grimSnapMark[(ob * 14) + seat];
        g_grimSnapMark[(ob * 14) + seat] = ib;
        for (t = 0; t < 256; t += 1) {
            b = g_grimSnapTok[(((ob * 14) + posOld) * 256) + t];
            g_grimSnapTok[(((ob * 14) + posOld) * 256) + t] = g_grimSnapTok[(((ob * 14) + seat) * 256) + t];
            g_grimSnapTok[(((ob * 14) + seat) * 256) + t] = b;
        }
    }
    // ② 每个**格子（位置）**自己的那些数组（在场 / 死亡）→ 按 posOld ↔ seat 对调
    //   ⚠ `g_mySess`（我在哪条私聊）**不换**：它和 `g_member` 一样按**物理座位**存（私聊投递用的是
    //     PlayerGroupSingle(座位)），换位时人没动、会话当然不用换 —— 原来跟着对调，换完两边会串会话。
    // ⚠【g_seatOn 不换】（用户 2026-10-07 报「换说书人之后被点那一格的座位图/编号/名字整列不见了」）：
    //   它记的是"这个槽位有没有真人"（2..13 的引擎事实），换位时人并没有换槽 ----
    //   一对调，被点那一格就变成"不在场"，BOTC_GrimRelayout 会把整列控件都藏掉。
    b = g_deadShown[posOld];
    g_deadShown[posOld] = g_deadShown[seat];
    g_deadShown[seat] = b;
    b = g_deadPending[posOld];
    g_deadPending[posOld] = g_deadPending[seat];
    g_deadPending[seat] = b;
    b = g_leftShown[posOld];
    g_leftShown[posOld] = g_leftShown[seat];
    g_leftShown[seat] = b;
    t = g_deadKind[posOld];
    g_deadKind[posOld] = g_deadKind[seat];
    g_deadKind[seat] = t;
    t = g_deadByDemon[posOld];
    g_deadByDemon[posOld] = g_deadByDemon[seat];
    g_deadByDemon[seat] = t;
    t = g_deadType[posOld];
    g_deadType[posOld] = g_deadType[seat];
    g_deadType[seat] = t;
    t = g_deadNightNum[posOld];
    g_deadNightNum[posOld] = g_deadNightNum[seat];
    g_deadNightNum[seat] = t;
    t = g_deadClaimDay[posOld];
    g_deadClaimDay[posOld] = g_deadClaimDay[seat];
    g_deadClaimDay[seat] = t;
    t = g_deadDay[posOld];
    g_deadDay[posOld] = g_deadDay[seat];
    g_deadDay[seat] = t;
    b = g_bansheeSaid[posOld];
    g_bansheeSaid[posOld] = g_bansheeSaid[seat];
    g_bansheeSaid[seat] = b;
    b = g_bansheePower[posOld];
    g_bansheePower[posOld] = g_bansheePower[seat];
    g_bansheePower[seat] = b;
    b = g_bansheeSecondNom[posOld];
    g_bansheeSecondNom[posOld] = g_bansheeSecondNom[seat];
    g_bansheeSecondNom[seat] = b;
    t = g_bnestRoleBy[posOld];
    g_bnestRoleBy[posOld] = g_bnestRoleBy[seat];
    g_bnestRoleBy[seat] = t;
    b = g_bnestChosenBy[posOld];
    g_bnestChosenBy[posOld] = g_bnestChosenBy[seat];
    g_bnestChosenBy[seat] = b;
    b = g_bnestActing[posOld];
    g_bnestActing[posOld] = g_bnestActing[seat];
    g_bnestActing[seat] = b;
    t = g_bnestSource[posOld];
    g_bnestSource[posOld] = g_bnestSource[seat];
    g_bnestSource[seat] = t;
    t = g_harpyFirstBy[posOld];
    g_harpyFirstBy[posOld] = g_harpyFirstBy[seat];
    g_harpyFirstBy[seat] = t;
    t = g_harpySecondBy[posOld];
    g_harpySecondBy[posOld] = g_harpySecondBy[seat];
    g_harpySecondBy[seat] = t;
    t = g_harpyDay[posOld];
    g_harpyDay[posOld] = g_harpyDay[seat];
    g_harpyDay[seat] = t;
    b = g_organDrunkBy[posOld];
    g_organDrunkBy[posOld] = g_organDrunkBy[seat];
    g_organDrunkBy[seat] = b;
    // 【僵怖的两个标记也要跟着人走】（同【换座位】）：漏了它们，换说书人之后
    //   `BOTC_SeatDead` / `BOTC_DeathSfxMute` 会按错的格子判 → 僵怖的死亡音效（惨叫）出不来。
    b = g_zombUsed[posOld];
    g_zombUsed[posOld] = g_zombUsed[seat];
    g_zombUsed[seat] = b;
    b = g_zombFake[posOld];
    g_zombFake[posOld] = g_zombFake[seat];
    g_zombFake[seat] = b;
    BOTC_SwapSkinState(posOld, seat);
    BOTC_SwapPerSeatRuntime(posOld, seat);
    // 【编号不跟着人走】（用户 2026-10-06 报「换完显示 0 [玩家2]」的根因）：
    //   编号属于**位置**（格子 2 永远叫 [1]），换说书人时**只搬人**、不动 g_lab。
    //   而"人"由 g_who 记录 —— 这里把两个人的格子对调，名字/颜色就跟着人走了。
    t = g_who[posOld];
    g_who[posOld] = g_who[seat];
    g_who[seat] = t;
    // ③ 换说书人本人：新说书人的**物理座位** = newSeat（PlayerGroupSingle / 各种权限判定都要它）
    g_teller = newSeat;
    // 【全部私聊】页签只属于说书人（2026-11-09）：换人后把旧说书人收回【私聊记录】，
    //   避免他的日志面板还停在只读存档上；新说书人开着的日志顺便刷出按钮。
    if (g_logMode[old] == 4) {
        g_logMode[old] = 1;
        if (g_logOpen[old]) {
            BOTC_LogRender(old);
        }
    }
    if (g_logOpen[g_teller]) {
        BOTC_LogRender(g_teller);
    }
    // 【从原始真值快照强制重建新说书人行】（用户 2026-10-24）：
    //   不依赖上方行列置换的中间结果。列随人换位：posOld ↔ seat。
    for (q = 1; q <= 13; q += 1) {
        ib = q;
        if (q == posOld) { ib = seat; }
        else { if (q == seat) { ib = posOld; } }
        g_mark[(g_teller * 14) + q] = g_swapTruthMark[ib];
        for (t = 0; t < 256; t += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + t] = g_swapTruthTok[(ib * 256) + t];
        }
    }
    // ⚠【这里不要动 g_hideSeat】（用户 2026-10-07 实测：一动就"点换说书人会掉一格"）：
    //   换说书人只是"谁当说书人"换人 —— 玩家人数没变，圈里该有的格子数也没变。
    //   g_hideSeat 只在"刚进游戏顺位接手"那一次设置（BOTC_InitMode），之后整局不再改。
    BOTC_PubAnnounce("【换说书人】" + nOld + " → " + nNew + "（接下来的说书人操作请找他）");
    BOTC_PmStore(g_teller, "【换说书人】你现在是新的说书人（原说书人在 " + BOTC_NameStr(posOld) + " 那一格）。");
    BOTC_BsBtnRender();
    BOTC_AfterSeatChange(p);       // 【统一重刷】（用户 2026-10-07）：魔典 / 整圈 / 按钮 / 私聊名单 / 聊天窗 一次刷全
}

void BOTC_BoardSwitch () {
    if (g_started) {
        BOTC_Notice(g_teller, "已经开始游戏了，不能换板子。");
        return;
    }
    if (g_dealConfirmed) {
        BOTC_CancelDeal();         // 【切换板子也要收回已下发的身份】按钮文字同时回到【确认发放】
    }
    g_dealConfirmed = false;
    // 【切换板子前先收夜间唤醒弹窗】（用户 2026-11-07）：玩家技能面板 / 说书人夜间弹窗全部关闭
    BOTC_PhaseUiForceClose();
    // 【换板子清缓存】（用户 2026-11-06）：旧板子发过的角色和 token 不能带到新板子，
    //   全场魔典（含说书人真值行）的角色标记 / token 一起整行清空。
    BOTC_GrimClearAllRows();
    BOTC_PmStore(g_teller, "【板子】说书人点了【切换板子】→ 重新打开选板子页面。");
    BOTC_BoardOpen();
}

void BOTC_BoardOpen () {
    int i;
    g_introOn = false;
    DialogSetVisible(g_introDlg, PlayerGroupAll(), false);
    BOTC_ResetPlayerNames();
    BOTC_BvReset();                // 本局设置投票：每局重新来（顺便把默认值填上）
    g_boardPage = 1;               // 每次打开选板页都先回到官方剧本分类
    g_boardSel = 0;
    g_boardStarting = false;
    BOTC_StartCdStop();
    for (i = 1; i <= 14; i += 1) {
        g_boardVote[i] = 0;
    }
    g_boardOpen = true;
    g_cOpen = false;                                  // 自定义剧本面板：每次开选板子页都先收起来
    DialogSetVisible(g_cDlg, PlayerGroupAll(), false);
    // 开局第 0 秒就全黑：立刻铺黑布，同时把光照切成纯黑（藏在黑布后面完成）。
    // 之后撤掉黑布时背景仍是黑的，再由光照渐变回白天。
    g_boardFade = 4;
    g_boardLastSec = -1;
    BOTC_HideAllUI();
    BOTC_BoardFadeRender();
    GameSetLighting(BOTC_BoardLightName(), 2.0);
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), true);
    // 【当前说书人】只在选板页显示（用户 2026-11-01），并往右挪，别被【更多剧本】挡住
    BOTC_PreNoticeRender();
    DialogSetVisible(g_preDlg, PlayerGroupAll(), true);
    BOTC_BoardRender();
    // 【全员场次播报】（用户 2026-11-04）：只在首次进入游戏时播一次；重新开始不再重复
    if (!g_countsAnnounced) {
        g_countsAnnounced = true;
        BOTC_AnnounceGameCounts();
    }
    // 【选板子计时】（用户 2026-09-25）：这 30 秒现在只剩「智能说书自己按票数定板子」用；
    //   真人说书不限时间、也不显示倒计时（见 BOTC_BoardTick），到点什么都不做。
    TimerStart(g_tBoard, 30.0, false, c_timeGame);
    BOTC_MusicStart();             // 选板子时就开始循环放背景音乐（一直到正式开始才停）
    BOTC_BsBtnRender();            // 选板子页面打开时把【切换板子】收起来
    // 【单机测试：玩家1 是电脑时自动选板并开始】（用户 2026-11-12）
    //   这样真人坐在其他座位即可直接测试 -名字；真人玩家1不受影响。
    if (BOTC_P1IsComputer()) {
        BOTC_BoardSelect(1);
        BOTC_BoardStart();
    }
}

// 刷新选板子页面：标题、说明、板子按钮和票数（倒计时单独走 BoardTick，避免整块重刷导致闪）
// 【选板子界面显示顺序】（用户 2026-09-22）：梦殒春宵 / 暗流涌动 / 黯月初升（内部编号不变）
// 【一级分类】（用户 2026-11-01）：官方剧本 = 暗流涌动 / 黯月初升 / 梦殒春宵；
//   其余全部归入更多剧本，自定义剧本排在更多剧本第一个。
//   返回 -1 = 自定义剧本入口，0 = 空槽位。
int BOTC_BoardAtSlot (int slot) {
    if (g_boardPage == 2) {
        if (slot == 0) {
            return -1;              // 自定义剧本入口（只对说书人可点）
        }
        if (slot == 1) {
            return 4;               // 瓦釜雷鸣
        }
        if (slot == 2) {
            return 5;               // 夜半狂欢
        }
        if (slot == 3) {
            return 6;               // 罂粟花开
        }
        if (slot == 4) {
            return 8;               // 横行霸道
        }
        if (slot == 5) {
            return 9;               // 何方教众
        }
        if (slot == 6) {
            return 10;              // 风雅集
        }
        if (slot == 7) {
            return 11;              // 心理博弈 XI
        }
        if (slot == 8) {
            return 12;              // 信口雌黄
        }
        if (slot == 9) {
            return 13;              // 全员追忆
        }
        if (slot == 10) {
            return 14;              // 成双成对
        }
        if (slot == 11) {
            return 15;              // 移花接木
        }
        return 0;
    }
    if (slot == 0) {
        return 1;                   // 暗流涌动
    }
    if (slot == 1) {
        return 2;                   // 黯月初升
    }
    if (slot == 2) {
        return 3;                   // 梦殒春宵
    }
    return 0;
}

void BOTC_BoardRender () {
    int i;
    int b;
    int k;
    int v;
    string s;
    BOTC_BuildSeatList();
    libNtve_gf_SetDialogItemText(g_boardTitle, StringToText("选择板子"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_boardHint, StringToText("由说书人点一个板子开始本局，不限时间。（检测到 " + IntToString(g_seatN) + " 位玩家）"), PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        b = BOTC_BoardAtSlot(i);
        if (b == 0) {
            DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), false);
        }
        else {
            if (b < 0) {
                // 【自定义剧本】入口：更多剧本的第一个（用户 2026-11-01）
                if (g_boardSel == 7) {
                    libNtve_gf_SetDialogItemText(g_boardBtn[i], TextWithColor(StringToText("√"), Color(120, 255, 120)) + StringToText(" 自定义剧本"), PlayerGroupAll());
                }
                else {
                    libNtve_gf_SetDialogItemText(g_boardBtn[i], StringToText("自定义剧本"), PlayerGroupAll());
                }
                libNtve_gf_SetDialogItemImage(g_boardPic[i], "botc_board_custom.dds", PlayerGroupAll());
                DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), false);
                DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), false);
            }
            else {
                v = 0;
                for (k = 2; k <= 13; k += 1) {
                    if (g_boardVote[k] == b) {
                        v = v + 1;
                    }
                }
                s = BOTC_BoardName(b);
                if (g_boardSel == b) {
                    libNtve_gf_SetDialogItemText(g_boardBtn[i], TextWithColor(StringToText("√"), Color(120, 255, 120)) + StringToText(" " + s), PlayerGroupAll());
                }
                else {
                    libNtve_gf_SetDialogItemText(g_boardBtn[i], StringToText(s), PlayerGroupAll());
                }
                libNtve_gf_SetDialogItemImage(g_boardPic[i], BOTC_BoardPic(b), PlayerGroupAll());
                // 【剧本难度】（用户 2026-11-06）：两行红字显示在板子按钮下方
                libNtve_gf_SetDialogItemText(g_boardDiffP[i], StringToText("<c val=\"FF0000\">玩家难度：" + BOTC_BoardStar(BOTC_BoardPlayerDiff(b)) + "</c>"), PlayerGroupAll());
                libNtve_gf_SetDialogItemText(g_boardDiffS[i], StringToText("<c val=\"FF0000\">说书人难度：" + BOTC_BoardStar(BOTC_BoardTellerDiff(b)) + "</c>"), PlayerGroupAll());
                DialogControlSetVisible(g_boardDiffP[i], PlayerGroupAll(), true);
                DialogControlSetVisible(g_boardDiffS[i], PlayerGroupAll(), true);
            }
            DialogControlSetVisible(g_boardBtn[i], PlayerGroupAll(), true);
            DialogControlSetVisible(g_boardPic[i], PlayerGroupAll(), true);
        }
    }
    // 【一级分类布局】（用户 2026-11-01）：每行 6 张；官方剧本 3 张，更多剧本 12 张。
    for (i = 0; i < 12; i += 1) {
        if (i < 6) {
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 72 + (i * 310), 90);
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 40 + (i * 310), 370);
            DialogControlSetPosition(g_boardDiffP[i], PlayerGroupAll(), c_anchorTopLeft, 40 + (i * 310), 452);
            DialogControlSetPosition(g_boardDiffS[i], PlayerGroupAll(), c_anchorTopLeft, 40 + (i * 310), 474);
        }
        else {
            DialogControlSetPosition(g_boardPic[i], PlayerGroupAll(), c_anchorTopLeft, 72 + ((i - 6) * 310), 500);
            DialogControlSetPosition(g_boardBtn[i], PlayerGroupAll(), c_anchorTopLeft, 40 + ((i - 6) * 310), 780);
            DialogControlSetPosition(g_boardDiffP[i], PlayerGroupAll(), c_anchorTopLeft, 40 + ((i - 6) * 310), 862);
            DialogControlSetPosition(g_boardDiffS[i], PlayerGroupAll(), c_anchorTopLeft, 40 + ((i - 6) * 310), 884);
        }
    }
    // 分类按钮：当前所在分类用【】标出来
    if (g_boardPage == 2) {
        libNtve_gf_SetDialogItemText(g_boardTabOfficial, StringToText("官方剧本"), PlayerGroupAll());
        libNtve_gf_SetDialogItemText(g_boardTabMore, StringToText("【更多剧本】"), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_boardTabOfficial, StringToText("【官方剧本】"), PlayerGroupAll());
        libNtve_gf_SetDialogItemText(g_boardTabMore, StringToText("更多剧本"), PlayerGroupAll());
    }
    DialogControlSetVisible(g_boardTabOfficial, PlayerGroupAll(), true);
    DialogControlSetVisible(g_boardTabMore, PlayerGroupAll(), true);
    // 人数按实际在场玩家自动统计，不再提供手动修正（用户 2026-11-01）
    libNtve_gf_SetDialogItemText(g_seatInfoLbl, StringToText("当前参与人数：" + IntToString(g_seatN) + " 人（按实际在场玩家自动调整）"), PlayerGroupAll());
    DialogControlSetVisible(g_seatInfoLbl, PlayerGroupAll(), true);
    DialogControlSetVisible(g_boardTitle, PlayerGroupAll(), false);   // 标题不显示（用户 2026-10-03）
    DialogControlSetVisible(g_boardHint, PlayerGroupAll(), false);
    DialogControlSetVisible(g_boardTime, PlayerGroupAll(), false);   // 【本局设置投票】只有智能说书才显示（2026-10-16 清死代码）
    BOTC_PmVisRender();
    // 逼下一次 tick 把倒计时补上
    g_boardLastSec = -1;
    BOTC_BoardTick();
    BOTC_BvRender();              // 右边那块「本局设置（投票）」跟着一起刷新
    BOTC_BoardStartBtnRender();
}

// 每半秒只更新倒计时那一行，而且只在秒数变化时才写（写太勤会闪）
void BOTC_BoardTick () {
    int sec;
    return;                        // 真人说书：不限时间，不写倒计时（用户 2026-09-21）
    sec = FixedToInt(TimerGetRemaining(g_tBoard));
    if (sec < 0) {
        sec = 0;
    }
    if (sec != g_boardLastSec) {
        g_boardLastSec = sec;
        libNtve_gf_SetDialogItemText(g_boardTime, StringToText("剩余 " + IntToString(sec) + " 秒"), PlayerGroupAll());
    }
}

void BOTC_BoardStartBtnRender () {
    DialogSetVisible(g_boardStartBtn, PlayerGroupAll(), false);
    if (!g_boardOpen || g_boardFade < 4 || g_cOpen) {
        return;
    }
    if (g_boardStarting) {
        libNtve_gf_SetDialogItemText(g_boardStartBtn, StringToText("取消说书"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_boardStartBtn, StringToText("开始说书"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_boardStartBtn, PlayerGroupSingle(g_teller), true);
}

void BOTC_BoardStartCdRender () {
    string s;
    if (!g_boardStarting) {
        return;
    }
    s = IntToString(g_startCdSec) + " 秒";
    libNtve_gf_SetDialogItemText(g_tmLbl, TextWithColor(StringToText(s), Color(255, 215, 0)), PlayerGroupAll());
}

void BOTC_BoardSelect (int b) {
    if (!g_boardOpen || g_boardFade < 4 || g_boardStarting) {
        return;
    }
    if (b < 1 || b > 15) {
        return;
    }
    g_boardSel = b;
    BOTC_BoardRender();
}

void BOTC_BoardStart () {
    if (!g_boardOpen || g_boardFade < 4 || g_boardStarting) {
        return;
    }
    if (g_boardSel < 1 || g_boardSel > 15) {
        // 【未选剧本点开始说书】公聊提示，所有玩家可见（用户 2026-11-13）
        BOTC_PubAnnounce("【开始说书】说书人还没有选择剧本，请先在选剧本页面选择一个剧本。");
        return;
    }
    g_boardStarting = true;
    g_startCdSec = 10;
    g_startCdOn = true;
    BOTC_PlaySfx(g_sfxStartName);
    DialogSetPosition(g_tmShowDlg, c_anchorTopLeft, 1600, 990);
    libNtve_gf_SetDialogItemStyle(g_tmLbl, "ModLeftSize20Bold", PlayerGroupAll());
    DialogSetVisible(g_tmShowDlg, PlayerGroupAll(), true);
    BOTC_BoardStartCdRender();
    BOTC_BoardStartBtnRender();
    BOTC_Notice(g_teller, "已选择「" + BOTC_BoardName(g_boardSel) + "」：10 秒后进入取名阶段，期间可点【取消说书】。");
    TimerStart(g_tStartCd, 1.0, true, c_timeGame);
}

void BOTC_BoardStartCancel () {
    if (!g_boardStarting) {
        return;
    }
    g_boardStarting = false;
    BOTC_StartCdStop();
    BOTC_BoardStartBtnRender();
    BOTC_Notice(g_teller, "已取消说书；剧本选择保留，可以重新点【开始说书】。");
}

void BOTC_BoardStartGo () {
    int b;
    if (!g_boardStarting) {
        return;
    }
    b = g_boardSel;
    g_boardStarting = false;
    BOTC_StartCdStop();
    if (b < 1 || b > 15) {
        BOTC_BoardStartBtnRender();
        return;
    }
    BOTC_BoardFinish(b);
}

// 有人点了板子：手动说书只有说书人能点、点了即定；投票模式记票
void BOTC_BoardPick (int p, int b) {
    int k;
    int all;
    if (!g_boardOpen || g_boardFade < 4) {
        return;
    }
    if (b < 1 || b > 15) {         // 横行霸道 = 8 / 何方教众 = 9 / 风雅集 = 10（编号不连续，不能再用 g_boardCount 当上限）
        return;
    }
    if (p == g_teller) {
        // 【先打钩，再点右下角开始】（用户 2026-11-12）：点剧本不再直接开局。
        BOTC_BoardSelect(b);
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    // 【玩家 2 帮玩家 1 选板的测试旁路已关闭】（用户 2026-10-21）：
    //   非说书人点板子不再参与定板；正式说书人自己点板不受影响。
    // 真人说书：其他玩家点板子一律不算（用户 2026-09-25：删掉「没人点板子就自动切【智能说书】」那段）
    return;
    // 【智能说书不支持的板子】（用户 2026-09-20）：点了不算票、不计入，直接提示他改投暗流涌动。
    //   否则智能说书会拿着黯月初升的板子跑：身份抽错 / 中途卡住。
    if (false) {
        BOTC_BoardRender();
        return;
    }
    g_boardVote[p] = b;
    BOTC_BoardRender();
    // 用户 2026-09-17：不用等所有玩家都投 ---- **票最多的板子票数超过本局玩家的一半**就直接进入；
    //   没超过就继续等，30 秒到点由 BOTC_BoardTimeout 按票数最高的定。
    BOTC_BuildSeatList();
    all = BOTC_BoardTopVotes();
    k = g_seatN / 2;
    if (all > k) {
        BOTC_BoardFinish(BOTC_BoardWinner());
    }
}

// 票数最高的板子（平票取编号小的）
int BOTC_BoardWinner () {
    int i;
    int k;
    int v;
    int best;
    int bestN;
    best = 1;
    bestN = -1;
    for (i = 1; i <= 15; i += 1) {  // 板子号最大到 15（7 = 自定义剧本，没人能投票）
        v = 0;
        for (k = 2; k <= 13; k += 1) {
            if (g_boardVote[k] == i) {
                v = v + 1;
            }
        }
        if (v > bestN) {
            bestN = v;
            best = i;
        }
    }
    return best;
}

// 倒计时结束：投票模式按票数定，手动模式没人选就默认第一个板子
void BOTC_BoardTimeout () {
    int b;
    if (!g_boardOpen) {
        return;
    }
    // ⚠ 这里**不再**因为「玩家1 一直没点」就自动切智能说书 ---- 真人说书人临时走开、
    //   或只是想多看两眼板子，就会被误判成电脑，然后整局被 AI 接管（很难发现原因）。
    //   现在判定智能说书只有两个来源（用户 2026-09-25：选板子时「别人点了」那条也删了）：
    //     ① g_p1ForceComputer（BOTC_Init 里的手动开关 / 说书人在聊天里输入 -AI）；
    //     ② 真身判定：玩家1 是大厅里的电脑（见 BOTC_P1IsComputer）。
    // 【真人说书 · 不限时间】（用户 2026-09-21）：时间到了什么都不做，
    //   等说书人自己点一个板子；原来的「到点默认用第一个板子」已经删掉。
    return;
}

// 定下板子：收掉选项、黑屏淡出、播报、刷新魔典中央
void BOTC_BoardFinish (int b) {
    // 【切换板子先强制收尾】（用户 2026-11-08）：清掉上一块板子还挂着的弹窗和选人状态
    BOTC_PhaseUiForceClose();
    // 【智能说书不支持的板子】（用户 2026-09-20）：最后一道保险。
    g_board = b;
    // 【暴风捕手（113）】（用户 2026-10-10）：内置板子一律保护异教领袖；自定义剧本（b == 7）用做板子时选的那个
    if (b != 7) {
        g_stormRole = 106;
        g_cStormRole = 106;
    }
    BOTC_LegacyApply(b);
    g_boardOpen = false;
    g_bootSavePending = false;
    g_bootSaveSlot = 0;
    // 入场取名阶段继续保持黑幕；20 秒后才撤掉并分配座位 / 名字。
    g_boardFade = 4;
    BOTC_BoardFadeRender();
    DialogSetVisible(g_boardDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_warmDlg, PlayerGroupAll(), false);   // 汉字预热标签：黑布撤了就别再挂着了
    BOTC_BoardInfoRender();
    // 诊断：把引擎检测到的参与座位写给说书人（人数不对时看这一行）
    BOTC_BuildSeatList();
    BOTC_DiagStore(g_teller, "【诊断】本局参与座位：" + BOTC_SeatListStr() + "（共 " + IntToString(g_seatN) + " 人）");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("本局板子：" + BOTC_BoardName(b)));
    BOTC_PeriodRecord("---- 本局板子：" + BOTC_BoardName(b) + " ----");
    // 智能说书：结算本局设置投票（私聊 / 公聊 / 提名时间 / 第一天邪恶小窗）
    BOTC_BvApply();
    BOTC_PickLayout();             // 板子定了：两个图标网格按这个板子的角色重排
    BOTC_RsLayout();
    BOTC_IntroBegin();
}
//==================================================================================================
// 【自定义剧本】（用户 2026-10-03）
//   选板子页最下方那颗【自定义剧本】点进去 → 黑布不撤，上面盖一层：
//   · 正上方 6 个分类按钮：镇民 / 外来者 / 爪牙 / 恶魔 / 传奇角色 / 奇遇角色
//   · 左盘块 = 该分类**目前有的全部角色**（点图标 = 选中 / 取消），左盘块右下角【上一页】【下一页】
//   · 右盘块 = 已选角色（紧凑版，中号图标 + 名字，不带技能；点一下 = 取消）
//   · 最右下角【保存】（写进本机 bank）/【开始游戏】（当成第 7 张板子直接开局）
//   上限：镇民 14 / 外来者 5 / 爪牙 5 / 恶魔 5 / 传奇 2 / 奇遇 2，右侧一共摆得下 33 格
//==================================================================================================
// 【私货商人（130）】自定义文本。默认值用官网能力；输入后可覆盖。
string BOTC_BootleggerDefaultText () {
    return "这个剧本包含有自制角色或自制规则。";
}

string BOTC_BootleggerEffectiveText () {
    // 全员追忆（板子 13）：本图私货商人写的是整套失忆规则。
    if (g_board == 13 && g_legacyOn[130]) {
        return "全员追忆规则：1. 游戏开始时，玩家只会得知自己的角色类型（镇民、外来者、爪牙或恶魔），不会得知具体角色名；真实角色只有说书人知道。2. 玩家仍可正常获取信息，恶魔正常得知爪牙是谁，爪牙正常互认，夜间仍按真实角色被唤醒并发动能力。3. 恶魔不会自动获得三个不在场身份，但说书人仍可按需发送。4. 每个白天，玩家可以私下向说书人猜测一个关于自己技能的问题；回答为「无关 / 有关 / 接近 / 完美」，只有完全答对才是「完美」。问题只能与自己的技能有关，不能直接询问角色名、字数或所属剧本。5. 遇到认知覆盖时，玩家只获得自己所认知角色的信息，猜测也只指向这名认知角色。6. 每天黄昏时，说书人公布目前已有多少名玩家猜中并获得「完美」。7. 说书人在夜间唤醒时的话术与行动，是玩家推断真实角色的重要线索。";
    }
    // 心理博弈 XI 的板载私货商人规则：不采用麻脸巫婆×利维坦相克，第五天后仍可由麻脸巫婆创造利维坦。
    if (g_board == 11 && g_legacyOn[130]) {
        return "本剧本不采用麻脸巫婆与利维坦的相克规则。第五个白天之后，麻脸巫婆可以创造利维坦。";
    }
    if (StringLength(g_bootText) > 0) {
        return g_bootText;
    }
    return BOTC_BootleggerDefaultText();
}

// 全员追忆是固定规则文本：预先把每一行写好，避免运行时按 UTF-8 字节截断产生问号。
string BOTC_BootleggerAmnesiaLine (int i) {
    if (i == 0)  { return "全员追忆规则："; }
    if (i == 1)  { return "1. 游戏开始时，玩家只会得知自己的角色类型（镇民、外来者、爪牙或恶魔），"; }
    if (i == 2)  { return "不会得知具体角色名；真实角色只有说书人知道。"; }
    if (i == 3)  { return "2. 玩家仍可正常获取信息，恶魔正常得知爪牙是谁，爪牙正常互认，"; }
    if (i == 4)  { return "夜间仍按真实角色被唤醒并发动能力。"; }
    if (i == 5)  { return "3. 恶魔不会自动获得三个不在场身份，但说书人仍可按需发送。"; }
    if (i == 6)  { return "4. 每个白天，玩家可以私下向说书人猜测一个关于自己技能的问题；"; }
    if (i == 7)  { return "回答为「无关 / 有关 / 接近 / 完美」，只有完全答对才是「完美」。"; }
    if (i == 8)  { return "问题只能与自己的技能有关，不能直接询问角色名、字数或所属剧本。"; }
    if (i == 9)  { return "5. 遇到认知覆盖时，玩家只获得自己所认知角色的信息，猜测也只指向这名认知角色。"; }
    if (i == 10) { return "6. 每天黄昏时，说书人公布目前已有多少名玩家猜中并获得「完美」。"; }
    if (i == 11) { return "7. 说书人在夜间唤醒时的话术与行动，是玩家推断真实角色的重要线索。"; }
    return "";
}

// 把自定义规则同步到角色能力表和角色详情。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// 【角色详情 · 全章节】（用户 2026-11-07）
//   159 个角色的详情页按钟楼百科重写为九个章节：背景故事 / 角色能力 / 角色简介 / 范例 /
//   运作方式 / 提示标记 / 规则细节 / 提示与技巧 / 对抗XX。
//   说书人看全部；普通玩家只看 g_tipP1（能力 + 简介）与 g_tipP2（规则细节）。
//   私货商人（130）由 BOTC_BootleggerSyncText() 动态生成，失忆占位身份（143..146）保持原样。
//--------------------------------------------------------------------------------------------------
void BOTC_ApplyRoleTipsAll () {
    g_tipLine[8068] = StringToText("【背景故事】");
    g_tipLine[8069] = StringToText("「晚礼服上的血渍？");
    g_tipLine[8070] = StringToText("才不是呢，这只是洒上了雪莉酒。真粗心！」");
    g_tipLine[8071] = StringToText("【角色能力】");
    g_tipLine[8072] = StringToText("在你的首个夜晚，你会得知两名玩家和一个镇民角色：这两名玩家之一是该角色。");
    g_tipLine[8073] = StringToText("【角色简介】");
    g_tipLine[8074] = StringToText("洗衣妇会得知一个特定的在场镇民角色，但不知道是谁在扮演该角色。");
    g_tipLine[8075] = StringToText("· 在第一个夜晚，洗衣妇会被唤醒，得知两名玩家，并得知其中一人的角色。");
    g_tipLine[8076] = StringToText("· 洗衣妇只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[8077] = StringToText("【范例】");
    g_tipLine[8078] = StringToText("小文是厨师，小米是守鸦人。洗衣妇得知要么小文是厨师，要么小米是厨师。");
    g_tipLine[8079] = StringToText("小佳是小恶魔，小艾是贞洁者。洗衣妇得知要么小佳是贞洁者，要么小艾是贞洁者。");
    g_tipLine[8080] = StringToText("小明是间谍，小美是红唇女郎。洗衣妇得知他俩其中一人是守鸦人。此时，间谍被当作了一名镇民——在这个例子里，");
    g_tipLine[8081] = StringToText("  被当作了守鸦人。");
    g_tipLine[8082] = StringToText("【运作方式】");
    g_tipLine[8083] = StringToText("在为首个夜晚进行准备时，将洗衣妇的「镇民」提示标记放置在任意一个镇民角色标记旁，然后将洗衣妇的「错误」");
    g_tipLine[8084] = StringToText("  提示标记放置在任意其他角色标记旁。");
    g_tipLine[8085] = StringToText("在首个夜晚里，唤醒洗衣妇，并指向标记有「镇民」和「错误」的玩家。将标记有「镇民」的玩家标记展示给洗衣妇。");
    g_tipLine[8086] = StringToText("  让洗衣妇重新入睡。在说书人方便的时候，移除洗衣妇的提示标记。");
    g_tipLine[8087] = StringToText("【提示标记】");
    g_tipLine[8088] = StringToText("· 镇民");
    g_tipLine[8089] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8090] = StringToText("放置条件：放置在一个镇民角色或能被当作镇民角色的角色标记旁边。");
    g_tipLine[8091] = StringToText("移除时机：在洗衣妇获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8092] = StringToText("· 错误");
    g_tipLine[8093] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8094] = StringToText("放置条件：放置在未放置「镇民」提示标记的其他任意一个角色标记旁边。");
    g_tipLine[8095] = StringToText("移除时机：在洗衣妇获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8096] = StringToText("【规则细节】");
    g_tipLine[8097] = StringToText("· 不同于图书管理员和调查员，洗衣妇永远不可能得知没有镇民在场。在极端情况下（如5人局且有男爵在场时），");
    g_tipLine[8098] = StringToText("  洗衣妇会得知自己与任意一名玩家之中有洗衣妇，但这在大部分情况下也等同于明示洗衣妇有男爵在场了。");
    g_tipLine[8099] = StringToText("  因此如果这种情形可能发生，说书人也应该调整角色配置让本局游戏更加有趣一些。");
    g_tipLine[8100] = StringToText("· 如果在首夜就中毒或醉酒，洗衣妇可能会得知错误的玩家（没有放置洗衣妇标记的玩家），或得知错误的角色，");
    g_tipLine[8101] = StringToText("  或两者兼而有之。但即使如此，说书人也应该让洗衣妇得知镇民角色，否则等同于在明示洗衣妇她自己醉酒中毒了，");
    g_tipLine[8102] = StringToText("  且给出的信息也不符合洗衣妇应该获取的信息内容。");
    g_tipLine[8103] = StringToText("· 特定角色互动：");
    g_tipLine[8104] = StringToText("  · 间谍：洗衣妇能将间谍当作镇民，并得知间谍和任意其他玩家之中有一个任意镇民角色。");
    g_tipLine[8105] = StringToText("【提示与技巧】");
    g_tipLine[8106] = StringToText("· 洗衣妇这个角色看起来非常强大。虽然你无法从邪恶阵营的玩家身上获取信息，但你能够确定一个善良角色。");
    g_tipLine[8107] = StringToText("  你需要时刻关注这个善良角色，因为一旦他获得了有用的信息，就等同于你也得到了这手信息。");
    g_tipLine[8108] = StringToText("  如果这个善良角色是拥有可以做出选择的有效能力，你也能够帮助他让的能力发挥出更好的效果。");
    g_tipLine[8109] = StringToText("· 与其他角色相比，处于醉酒或中毒状态的洗衣妇还是比较容易发现自己获取了错误信息的。让我们看看其他角色。");
    g_tipLine[8110] = StringToText("  厨师是很难确定自己获得的信息\"1\"是否正确的。如果某位玩家告诉你他是某个镇民角色，");
    g_tipLine[8111] = StringToText("  而说书人又告诉你这位玩家是另一个镇民角色，这表明你很可能处于醉酒或中毒状态。");
    g_tipLine[8112] = StringToText("  你可以用这条信息为自己的队伍创建优势，因为如果你是酒鬼，那其他人就不可能再是酒鬼了。");
    g_tipLine[8113] = StringToText("  因为你能轻松辨别你得到的信息正确还是错误，这也就意味着当你获得的信息看起来比较可信的时候，");
    g_tipLine[8114] = StringToText("  你就会对自己的角色更加确信。");
    g_tipLine[8115] = StringToText("· 要去识别这两位玩家中哪一位是镇民的方法，不是在公聊时直接问他们，也不是去挨个私聊。");
    g_tipLine[8116] = StringToText("  最好的方式是在其中一位玩家被质疑时告诉其他玩家你所知道的信息，而且最好在他们自曝之前说出来，");
    g_tipLine[8117] = StringToText("  这样能够让他们更加相信你。");
    g_tipLine[8118] = StringToText("· 如果你在第一天就选择分享你的信息并且很快将它们说出来，善良阵营玩家就能够获得一个坚实的推理基础。");
    g_tipLine[8119] = StringToText("  这在你查验到场上存在其他信息获取类镇民角色（如占卜师或共情者）时非常有效。");
    g_tipLine[8120] = StringToText("· 等到游戏的最后一个白天（或在游戏后期）去分享你的信息也会非常有用。如果你能保证你查验到的镇民能活到最后一天，");
    g_tipLine[8121] = StringToText("  你就能在剩余存活玩家中排除一个恶魔！这种方式让你能够轻松地辨别出谁是恶魔，或者至少让原本三选一的难题变成二选一。");
    g_tipLine[8122] = StringToText("· 与你所查验到的镇民玩家交流，并且秘密地让他知晓你得知了他的角色。这样，你就有机会和他组成同盟，");
    g_tipLine[8123] = StringToText("  并且能够在其中一人被提名时互相替对方辩护。不要告诉其他人你的同盟是谁，因为邪恶阵营的玩家也会知道。");
    g_tipLine[8124] = StringToText("  不论是与像占卜师这样恶魔非常想要杀害的人结盟，还是与像守鸦人或士兵这样恶魔会极力避免杀害的人结盟，");
    g_tipLine[8125] = StringToText("  这一策略都十分有用。");
    g_tipLine[8126] = StringToText("· 在与你所辨识的镇民私聊并确认他们的角色后，你可以在其他玩家面前用一个假的角色来伪装他。");
    g_tipLine[8127] = StringToText("  如果你想要使这位镇民免受投毒者或其他角色的影响，或是想要引诱邪恶阵营的玩家去攻击一位已经使用过能力的镇民（例如厨师");
    g_tipLine[8128] = StringToText("  ），这种策略都会非常有用。");
    g_tipLine[8129] = StringToText("· 有些时候，说书人会指向邪恶阵营的玩家并告诉你他可能是一个镇民角色。如果你认为这种情况发生的话，");
    g_tipLine[8130] = StringToText("  不要直接说出你获取到的是哪个镇民角色。你可以编一个假的镇民角色并试图让邪恶阵营的玩家承认自己是这个角色。");
    g_tipLine[8131] = StringToText("  或者你也可以尝试让善良阵营的玩家在你曝出他的真实角色之前把自己的角色告知与你，");
    g_tipLine[8132] = StringToText("  这会让你更加相信他……但也会让他降低对你的信任。你们两个可以在没有提前私聊的情况下同时公开你们的角色。");
    g_tipLine[8133] = StringToText("  这会帮助大家更快地确认你们都在讲真话。");
    g_tipLine[8134] = StringToText("· 公开哪个角色在场，但不说是哪位玩家。这种情况邪恶阵营将会得到很少的信息，但是那位镇民就会信任你，");
    g_tipLine[8135] = StringToText("  并且在将来他公开他的角色时会显得更可信。");
    g_tipLine[8136] = StringToText("· 你也可以声明自己就是洗衣妇，然后指向一个你认为是邪恶阵营的玩家，说他是一位你所知道的镇民。");
    g_tipLine[8137] = StringToText("  一个投机取巧的邪恶阵营玩家就可能会抓住这个机会并且表现得像个善良阵营玩家，并且说他们确实就是这个镇民角色。");
    g_tipLine[8138] = StringToText("  但在你的眼里，你会清楚地知道，他在说谎。");
    g_tipLine[8139] = StringToText("· 当心间谍！他可能会被你错认作镇民。你所得知的调查员可能根本就不是调查员……");
    g_tipRoleAt[0] = 8068; g_tipRoleN[0] = 72; g_tipP1At[0] = 8071; g_tipP1N[0] = 6; g_tipP2At[0] = 8096; g_tipP2N[0] = 9;
    g_tipAbility[0] = StringToText("在你的首个夜晚，你会得知两名玩家和一个镇民角色：这两名玩家之一是该角色。");
    g_tipLine[8140] = StringToText("【背景故事】");
    g_tipLine[8141] = StringToText("「毫无疑问，这位女士，在通常情况下，你可以从图书馆的馆藏中借阅《凶恶药典》。");
    g_tipLine[8142] = StringToText("然而，你看起来不像是会员。」");
    g_tipLine[8143] = StringToText("【角色能力】");
    g_tipLine[8144] = StringToText("在你的首个夜晚，你会得知两名玩家和一个外来者角色：这两名玩家之一是该角色（或者你会得知没有外来者在场）。");
    g_tipLine[8145] = StringToText("【角色简介】");
    g_tipLine[8146] = StringToText("图书管理员会得知一个特定的在场外来者角色，但不知道是谁在扮演该角色。");
    g_tipLine[8147] = StringToText("· 在第一个夜晚，图书管理员会得知两名玩家其中一人的外来者角色。");
    g_tipLine[8148] = StringToText("· 图书管理员只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[8149] = StringToText("· 酒鬼是外来者。如果图书管理员得知两名玩家中有酒鬼，他不会得知酒鬼玩家以为的那个镇民角色。");
    g_tipLine[8150] = StringToText("【范例】");
    g_tipLine[8151] = StringToText("小八是圣徒，小莱是男爵。图书管理员得知要么小八是圣徒，要么小莱是圣徒。");
    g_tipLine[8152] = StringToText("说书人决定将陌客当作一名爪牙而不是外来者。现在场上没有其他外来者了。图书管理员得知了「0」。");
    g_tipLine[8153] = StringToText("小黑是酒鬼，且以为自己是僧侣。道哥是送葬者。图书管理员得知要么小黑是酒鬼，要么道哥是酒鬼。酒鬼是小黑的实际角色，");
    g_tipLine[8154] = StringToText("  即使他以为自己是僧侣。");
    g_tipLine[8155] = StringToText("【运作方式】");
    g_tipLine[8156] = StringToText("在为首个夜晚进行准备时，将图书管理员的「外来者」提示标记放置在任意一个外来者角色标记旁，");
    g_tipLine[8157] = StringToText("  然后将图书管理员的「错误」提示标记放置在任意其他角色标记旁。");
    g_tipLine[8158] = StringToText("在首个夜晚里，唤醒图书管理员，并指向标记有「外来者」和「错误」的玩家。将有「外来者」");
    g_tipLine[8159] = StringToText("  的玩家的角色标记展示给图书管理员。或者，如果说书人由于场上无外来者而未放置这两个标记，");
    g_tipLine[8160] = StringToText("  则对图书管理员展示手势「0」。让图书管理员重新入睡。在说书人方便的时候，移除图书管理员的提示标记。");
    g_tipLine[8161] = StringToText("【提示标记】");
    g_tipLine[8162] = StringToText("· 外来者");
    g_tipLine[8163] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8164] = StringToText("放置条件：放置在一个对应外来者角色或能被当作外来者角色的角色标记旁边。");
    g_tipLine[8165] = StringToText("移除时机：在图书管理员获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8166] = StringToText("· 错误");
    g_tipLine[8167] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8168] = StringToText("放置条件：放置在未放置「外来者」提示标记的其他任意一个角色标记旁边。");
    g_tipLine[8169] = StringToText("移除时机：在图书管理员获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8170] = StringToText("【规则细节】");
    g_tipLine[8171] = StringToText("· 如果在首夜就中毒或醉酒，图书管理员可能会得知错误的玩家（没有放置他的提示标记的玩家），或得知错误的角色，");
    g_tipLine[8172] = StringToText("  或两者兼而有之。但即使如此，说书人也应该让图书管理员得知外来者角色，否则等同于在明示图书管理员他自己醉酒中毒了，");
    g_tipLine[8173] = StringToText("  且给出的信息也不符合图书管理员应该获取的信息内容。");
    g_tipLine[8174] = StringToText("· 因为给出「0」这样的信息也在图书管理员的合理信息范围内，因此醉酒或中毒的图书管理员在某些情况下，");
    g_tipLine[8175] = StringToText("  说书人也可以给出「0」这样的信息以进行信息混淆。（如场上有酒鬼，但本剧本中还含有哨兵的时候，");
    g_tipLine[8176] = StringToText("  玩家将无法确信场上是否有外来者）但大部分时候，在很容易能确定场上有外来者的场合下给出「0」这样的信息，");
    g_tipLine[8177] = StringToText("  基本上等同于明示图书管理员醉酒了。");
    g_tipLine[8178] = StringToText("· 特定角色互动：");
    g_tipLine[8179] = StringToText("  · 陌客：在仅有一名外来者且为陌客的情况下，图书管理员可能会将陌客当作非外来者角色，从而得知没有外来者在场。");
    g_tipLine[8180] = StringToText("  · 间谍：图书管理员能将间谍当作外来者，并得知间谍和任意其他玩家之中有一个任意外来者角色。");
    g_tipLine[8181] = StringToText("【提示与技巧】");
    g_tipLine[8182] = StringToText("· 找出两位玩家当中哪一位是你所知道的那位外来者非常重要。这位玩家虽说是外来者，但也是善良阵营的玩家。");
    g_tipLine[8183] = StringToText("  虽说他的能力有可能对善良阵营产生不利影响，但是他肯定会站在善良阵营的角度投票，而且你也能确定他不是恶魔。");
    g_tipLine[8184] = StringToText("· 如果你获取到的信息是\"0\"，这将非常有用，但是你要首先保证你没有醉酒或是中毒。");
    g_tipLine[8185] = StringToText("  这条信息不但排除了场上外来者的存在，还帮你排除了场上出现男爵的可能。现在如果有任何人宣称自己是外来者，");
    g_tipLine[8186] = StringToText("  你就有理由怀疑他是个邪恶阵营的玩家。你也可以设个圈套撒谎说场上有外来者，");
    g_tipLine[8187] = StringToText("  这样就可能会有爪牙或者恶魔去伪装这类角色。");
    g_tipLine[8188] = StringToText("· 你会在游戏的第一晚获得信息。尽早公布信息将有助于你确定善良角色，而且也能用你的信息来证实其他镇民（像占卜师或是守鸦人");
    g_tipLine[8189] = StringToText("  ）的信息。");
    g_tipLine[8190] = StringToText("· 如果你在游戏的后期还没有公布你的信息（且你得知的那个角色仍然存活），");
    g_tipLine[8191] = StringToText("  你就可以在最后一天或者临近最后一天的时候选择公布。这样的话，你知晓的那位玩家就可以被排除恶魔嫌疑了，");
    g_tipLine[8192] = StringToText("  善良阵营的玩家也可以将他们的怀疑对象减少一位。");
    g_tipLine[8193] = StringToText("· 与其被处决，圣徒这样的角色宁可死在晚上。外来者一般不是恶魔的首要击杀对象，");
    g_tipLine[8194] = StringToText("  因此你可以通过你的信息让外来者先被杀死，这样可以保护一个更强大的角色（如共情者或占卜师）免受侵害。");
    g_tipLine[8195] = StringToText("· 如果你所得知的两名玩家里有酒鬼，你应该早点说出来，尤其是在酒鬼以为自己是个能够获取信息的角色时。");
    g_tipLine[8196] = StringToText("  知晓\"他们的信息可能有误\"这一点本身也是一条信息。");
    g_tipLine[8197] = StringToText("· 又或者，你可以故意给出谁是酒鬼的错误信息。因为恶魔通常不太愿意去攻击一个酒鬼，");
    g_tipLine[8198] = StringToText("  这样你就能够保护一个正常的能获取信息的镇民，而恶魔就有可能去攻击那个真正的酒鬼。");
    g_tipLine[8199] = StringToText("· 不加顾虑地给出你的信息可能会让其他人相信你，但是这不代表你也需要相信他们。总可能有邪恶阵营的玩家来对你表示赞成，");
    g_tipLine[8200] = StringToText("  但他们做这些只是为了让自己伪装得更加善良。");
    g_tipLine[8201] = StringToText("· 相反的，要求其他玩家对你表明自身意味着你能够相信他们，但不代表他们会相信你。在这种情况下，");
    g_tipLine[8202] = StringToText("  你可以试着去找一个平衡点，让你们两个的信息都看起来比较合理。例如，你可以给出一个可能在场的角色范围，");
    g_tipLine[8203] = StringToText("  然后让他们从这些角色中选自己是哪一个。");
    g_tipRoleAt[1] = 8140; g_tipRoleN[1] = 64; g_tipP1At[1] = 8143; g_tipP1N[1] = 7; g_tipP2At[1] = 8170; g_tipP2N[1] = 11;
    g_tipAbility[1] = StringToText("在你的首个夜晚，你会得知两名玩家和一个外来者角色：这两名玩家之一是该角色（或者你会得知没有外来者在场）。");
    g_tipLine[8204] = StringToText("【背景故事】");
    g_tipLine[8205] = StringToText("「这真是个散步的好夜晚，您说呢，莫罗佐夫先生？");
    g_tipLine[8206] = StringToText("还是我应该称呼您为……莫罗佐夫男爵？」");
    g_tipLine[8207] = StringToText("【角色能力】");
    g_tipLine[8208] = StringToText("在你的首个夜晚，你会得知两名玩家和一个爪牙角色：这两名玩家之一是该角色（或者你会得知没有爪牙在场）。");
    g_tipLine[8209] = StringToText("【角色简介】");
    g_tipLine[8210] = StringToText("调查员会得知一个特定的在场爪牙角色，但不知道是谁在扮演该角色。");
    g_tipLine[8211] = StringToText("· 在第一个夜晚，调查员会得知两名玩家其中一人的爪牙角色。");
    g_tipLine[8212] = StringToText("· 调查员只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[8213] = StringToText("【范例】");
    g_tipLine[8214] = StringToText("小米是男爵，小佳是镇长。调查员得知要么小米是男爵，要么小佳是男爵。");
    g_tipLine[8215] = StringToText("小兰是间谍，小莱是投毒者。调查员得知要么小兰是间谍，要么小莱是间谍。");
    g_tipLine[8216] = StringToText("小文是陌客，小明是小恶魔。调查员得知要么小文是投毒者，要么小明是投毒者。此时，");
    g_tipLine[8217] = StringToText("  陌客被当作了一名爪牙——在这个例子里，被当作了投毒者。");
    g_tipLine[8218] = StringToText("【运作方式】");
    g_tipLine[8219] = StringToText("在为首个夜晚进行准备时，将调查员的「爪牙」提示标记放置在任意一个爪牙角色标记旁，然后将调查员的「错误」");
    g_tipLine[8220] = StringToText("  提示标记放置在任意其他角色标记旁。");
    g_tipLine[8221] = StringToText("在首个夜晚里，唤醒调查员，并指向标记有「爪牙」和「错误」的玩家。将标记有「爪牙」的玩家的角色标记展示给调查员。");
    g_tipLine[8222] = StringToText("  让调查员重新入睡。在说书人方便的时候，移除调查员的提示标记。");
    g_tipLine[8223] = StringToText("【提示标记】");
    g_tipLine[8224] = StringToText("· 爪牙");
    g_tipLine[8225] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8226] = StringToText("放置条件：放置在一个对应爪牙角色或能被当作爪牙角色的角色标记旁边。");
    g_tipLine[8227] = StringToText("移除时机：在调查员获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8228] = StringToText("· 错误");
    g_tipLine[8229] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8230] = StringToText("放置条件：放置在未放置「爪牙」提示标记的其他任意一个角色标记旁边。");
    g_tipLine[8231] = StringToText("移除时机：在调查员获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8232] = StringToText("【规则细节】");
    g_tipLine[8233] = StringToText("· 在仅有一名爪牙且为间谍的情况下，调查员可能会将间谍当作非爪牙角色，从而得知没有爪牙在场。这种情况下，");
    g_tipLine[8234] = StringToText("  实际上也与「得知两名玩家其中之一是间谍」相似（因为基本上不可能存在初始没有任何爪牙在场的情况），");
    g_tipLine[8235] = StringToText("  但相对来说调查员在得知「0」的时候会对谁是间谍这一事实毫无头绪。");
    g_tipLine[8236] = StringToText("· 由于麻脸巫婆这样的角色存在，很有可能出现某局游戏进行到一半时没有任何爪牙角色在场，此时有新的调查员产生时，");
    g_tipLine[8237] = StringToText("  也会因此得知「0」。");
    g_tipLine[8238] = StringToText("· 如果在首夜就中毒或醉酒，调查员可能会得知错误的玩家（没有放置他的提示标记的玩家），或得知错误的角色，");
    g_tipLine[8239] = StringToText("  或两者兼而有之。但即使如此，说书人也应该让调查员得知爪牙角色，否则等同于在明示调查员他自己醉酒中毒，");
    g_tipLine[8240] = StringToText("  且给出的信息也不符合调查员应该获取的信息内容。");
    g_tipLine[8241] = StringToText("· 特定角色互动：");
    g_tipLine[8242] = StringToText("  · 陌客：调查员能将陌客当作爪牙，并得知陌客和任意其他玩家之中有一个任意爪牙角色。");
    g_tipLine[8243] = StringToText("· 相克规则：");
    g_tipLine[8244] = StringToText("  · 维齐尔：说书人不会宣布维齐尔在场。");
    g_tipLine[8245] = StringToText("【提示与技巧】");
    g_tipLine[8246] = StringToText("· 在第一天尽早公布你的信息。你可能无法确定到底哪位玩家是爪牙，但如果你成功让大家相信你的话，");
    g_tipLine[8247] = StringToText("  那么善良阵营是有足够的时间将两名玩家全都处决的，这将确保最后一天一定少了一名爪牙。");
    g_tipLine[8248] = StringToText("· 尽管只靠你自己的信息还不足矣给一位玩家定性，但是你可以将你的信息和其他善良阵营玩家的信息相结合（例如共情者和厨师");
    g_tipLine[8249] = StringToText("  ）。如果你相信他们，你就可以召集其他人尽早将爪牙处决，从而剥夺他的投票权并使你的阵营获得优势。");
    g_tipLine[8250] = StringToText("· 如果你强烈怀疑两名玩家其中之一，那你就先什么都别说，静静观察他们的行动。如果他一直在保护一名玩家，");
    g_tipLine[8251] = StringToText("  那这名被他保护的玩家很有可能就是恶魔。如果他一直想要处决一名玩家，那他针对的这位玩家应该就是善良的。");
    g_tipLine[8252] = StringToText("  在收集到了一些可靠的信息后，你就可以把它们都公布出来了。如果你认定的爪牙存活到了最后一天，那他也不必被处决，");
    g_tipLine[8253] = StringToText("  因为这时首先要解决的目标是恶魔。");
    g_tipLine[8254] = StringToText("· 与其公开讨论，不如对部分玩家秘密分享你获得的信息。其他玩家的信息可能能够帮助你锁定目标。");
    g_tipLine[8255] = StringToText("· 如果你得知的爪牙是红唇女郎，你就需要尽早处决她，以避免她削弱善良阵营的实力。");
    g_tipLine[8256] = StringToText("· 如果你得知的信息并非男爵，你就需要谨慎对待每一位声称自己是外来者的玩家。如果你知道在场仅有一位外来者，");
    g_tipLine[8257] = StringToText("  但场上有两位玩家都说自己是外来者，那他们之中可能有一位在说谎，也有可能都在说谎。");
    g_tipLine[8258] = StringToText("· 当心陌客！因为他可能会被你当作爪牙。如果你所查验的其中一位玩家的实际角色是陌客，但他被你认作了爪牙，");
    g_tipLine[8259] = StringToText("  另一位玩家有可能是任何角色，甚至也可能是你得知的那个爪牙角色。");
    g_tipLine[8260] = StringToText("· 尽管你能得知两名玩家其中一名是爪牙，但这并不表示另一名玩家一定是善良的。");
    g_tipRoleAt[2] = 8204; g_tipRoleN[2] = 57; g_tipP1At[2] = 8207; g_tipP1N[2] = 6; g_tipP2At[2] = 8232; g_tipP2N[2] = 13;
    g_tipAbility[2] = StringToText("在你的首个夜晚，你会得知两名玩家和一个爪牙角色：这两名玩家之一是该角色（或者你会得知没有爪牙在场）。");
    g_tipLine[8261] = StringToText("【背景故事】");
    g_tipLine[8262] = StringToText("「今晚的预约有些古怪。我从未见过梅威瑟太太此前跟那个哈德逊巷的流氓有过交情。");
    g_tipLine[8263] = StringToText("然而今晚，他们订了一张双人桌。真奇怪。」");
    g_tipLine[8264] = StringToText("【角色能力】");
    g_tipLine[8265] = StringToText("在你的首个夜晚，你会得知场上邻座的邪恶玩家有多少对。");
    g_tipLine[8266] = StringToText("【角色简介】");
    g_tipLine[8267] = StringToText("厨师会得知是否有邪恶玩家相邻而坐。");
    g_tipLine[8268] = StringToText("· 在第一个夜晚，厨师会得知有多少对邪恶玩家相邻而坐。两名相邻而坐的玩家为一对，");
    g_tipLine[8269] = StringToText("  然而每名玩家都能分别与两侧的玩家各组成一对。因此，两名相邻而坐的玩家是一对，三名相邻而坐的玩家是两对，");
    g_tipLine[8270] = StringToText("  四名相邻而坐的玩家是三对，以此类推。");
    g_tipLine[8271] = StringToText("· 厨师会像探查其他角色类型一样探查邪恶旅行者，但仅仅只会关注那些在厨师行动前加入游戏的旅行者。");
    g_tipLine[8272] = StringToText("【范例】");
    g_tipLine[8273] = StringToText("没有邪恶玩家相邻而坐。厨师得知了「0」。");
    g_tipLine[8274] = StringToText("小恶魔与男爵相邻而坐。在另一侧，投毒者与红唇女郎相邻而坐。厨师得知了「2」。");
    g_tipLine[8275] = StringToText("邪恶的替罪羊坐在小恶魔与红唇女郎的中间。在另一侧，投毒者与男爵相邻而坐。厨师得知了「3」。");
    g_tipLine[8276] = StringToText("陌客坐在小恶魔与投毒者的中间。厨师得知了「1」。此时，陌客在「小恶魔-陌客」这一对里被当作了邪恶阵营，");
    g_tipLine[8277] = StringToText("  但在「投毒者-陌客」这一对里被当作了善良阵营。");
    g_tipLine[8278] = StringToText("（备注：这个例子只是想举例说明厨师对阵营的探查是分多次进行，且陌客能在不同的能力不同的时间点下被视为不同的阵营或");
    g_tipLine[8279] = StringToText("  角色。在实际游戏中，因为厨师这样的多次探查能力非常少见，因此如果想采用这种给「1」的信息方式，");
    g_tipLine[8280] = StringToText("  建议说书人应该提前告知玩家，否则应该默认这种情况下要么得知「0」，要么得知「2」。在陌客的范例中，");
    g_tipLine[8281] = StringToText("  也可以看到实际上对这个例子以及「1」的结果避而不提。）");
    g_tipLine[8282] = StringToText("【运作方式】");
    g_tipLine[8283] = StringToText("在首个夜晚里，唤醒厨师。为厨师用手势比划场上互为邻座的邪恶玩家有多少对（0，1，2，等等）。让厨师重新入睡。");
    g_tipLine[8284] = StringToText("【提示标记】");
    g_tipLine[8285] = StringToText("无");
    g_tipLine[8286] = StringToText("【规则细节】");
    g_tipLine[8287] = StringToText("· 厨师的单次能力会为玩家进行多次检测判断。因此具有互动干扰类能力的角色可能会在与其左右相邻的玩家组合中被当作不同的");
    g_tipLine[8288] = StringToText("  阵营。但通常来说，我们建议按照在厨师的单次能力探查中始终保持同一阵营来进行判断，以提升厨师玩家的游戏体验。毕竟，");
    g_tipLine[8289] = StringToText("  不仅互动干扰能力会影响厨师的结果，醉酒和中毒也会。");
    g_tipLine[8290] = StringToText("· 厨师的能力探查的是相邻玩家，且并未加「存活」这一附加条件。在游戏中途产生的厨师，");
    g_tipLine[8291] = StringToText("  获取到的信息仍然会考虑仍然在游戏中的所有玩家（已经提前离开游戏的旅行者则不算在内）。");
    g_tipLine[8292] = StringToText("【提示与技巧】");
    g_tipLine[8293] = StringToText("· 在游戏开始，单看你自己的信息并不是非常有用，但如果你将你的信息与你队友的信息相结合，就会变得非常有用了。");
    g_tipLine[8294] = StringToText("  如果你能找到共情者或者占卜师，随后知道了一名玩家的阵营，或是知道了一名玩家是否为恶魔后，");
    g_tipLine[8295] = StringToText("  你的信息就开始发挥作用了。这是因为你在得知一名玩家阵营的同时，也知道了他周围的人的阵营。");
    g_tipLine[8296] = StringToText("  就算是将你的信息与洗衣妇，图书管理员或调查员的信息相结合也会很有用。例如，如果你知道至少有一对邪恶玩家挨着坐，");
    g_tipLine[8297] = StringToText("  调查员还说玩家A和玩家B中有一个爪牙，那你就可以知道A或B的相邻玩家里很有可能会有邪恶阵营的玩家。");
    g_tipLine[8298] = StringToText("· 你的信息随着游戏的进行将会变得越来越有用，所以在关键的时刻记得对善良阵营重申你的信息。当只剩下三名玩家存活时，");
    g_tipLine[8299] = StringToText("  你肯定知道这里面至少有一位邪恶玩家，因此在这个时候你所掌握的信息——场上邪恶玩家是否邻座——将决定游戏的最终结果");
    g_tipLine[8300] = StringToText("  。记得在这个节点让你的队伍仔细思考你的信息。");
    g_tipLine[8301] = StringToText("· 得到信息\"0\"意味着没有邪恶玩家邻座；记得在白天寻找有哪些窃窃私语的玩家。他们有可能是邪恶阵营，");
    g_tipLine[8302] = StringToText("  但也有可能只是善良阵营的玩家在进行秘密交流。");
    g_tipLine[8303] = StringToText("· 如果你知道邪恶玩家不邻座，并且确信某位玩家是邪恶阵营的，那与他相邻的玩家肯定就是善良阵营的。因此，");
    g_tipLine[8304] = StringToText("  如果你和邪恶阵营的玩家中间隔了一个玩家，那中间这位玩家肯定也是善良的。");
    g_tipLine[8305] = StringToText("· 得到信息\"1\"或更多意味着场上的邪恶玩家是坐在一起的。注意那些窃窃私语并且形成微妙同盟关系的玩家。");
    g_tipLine[8306] = StringToText("· 得到信息\"2\"意味着场上邪恶阵营是两两一对分开座的，也有可能是三位邪恶阵营玩家连在一起。记住，");
    g_tipLine[8307] = StringToText("  邪恶的旅行者也会被算进去，这将帮助你判断他们邻座的玩家阵营的好坏。");
    g_tipLine[8308] = StringToText("· 间谍可能不会被当作是邪恶阵营，你可能因此会获得错误的数字。类似的，陌客也有可能被你当作邪恶阵营。");
    g_tipLine[8309] = StringToText("  为了确保你信息的准确性，你需要用尽一切方法去尽快找到在场的间谍或陌客。对于陌客来说，");
    g_tipLine[8310] = StringToText("  有时候你只需要直接在场上问有没有人是这个角色就足够了。而找出场上的间谍就需要用到你的直觉了。");
    g_tipLine[8311] = StringToText("  你还需要去注意哪些玩家在夜晚被杀害了。如果你觉得恶魔的杀戮效率太高，那就表示可能有间谍在帮助他。");
    g_tipLine[8312] = StringToText("· 如果这局游戏是汀西维尔模式（只有5-6位玩家的模式），恶魔和爪牙不会互相知道彼此是谁，");
    g_tipLine[8313] = StringToText("  并且会竭尽所能的去试图找到对方。故意给团队一个错误信息能够让邪恶阵营的玩家找错队友。例如，");
    g_tipLine[8314] = StringToText("  在你知道场上邪恶玩家不相邻的情况下，说场上邪恶玩家是邻座的。这样场上的恶魔就可能会一不小心向他的善良阵营邻座透露");
    g_tipLine[8315] = StringToText("  自己的恶魔角色，又或者爪牙可能不会投票将自己善良阵营的邻座处决，并偶然投票处决了恶魔。");
    g_tipRoleAt[3] = 8261; g_tipRoleN[3] = 55; g_tipP1At[3] = 8264; g_tipP1N[3] = 8; g_tipP2At[3] = 8286; g_tipP2N[3] = 6;
    g_tipAbility[3] = StringToText("在你的首个夜晚，你会得知场上邻座的邪恶玩家有多少对。");
    g_tipLine[8316] = StringToText("【背景故事】");
    g_tipLine[8317] = StringToText("「我的皮肤有些刺痛。");
    g_tipLine[8318] = StringToText("这有些不太对劲。我能感觉得到。」");
    g_tipLine[8319] = StringToText("【角色能力】");
    g_tipLine[8320] = StringToText("每个夜晚，你会得知与你邻近的两名存活的玩家中邪恶玩家的数量。");
    g_tipLine[8321] = StringToText("【角色简介】");
    g_tipLine[8322] = StringToText("共情者会持续得知与自己邻近的玩家是否为邪恶。");
    g_tipLine[8323] = StringToText("· 共情者只会得知与自己邻近的邪恶玩家数量，但不会得知具体哪一名玩家是邪恶的。");
    g_tipLine[8324] = StringToText("· 共情者不会探查已死亡的玩家。因此，如果共情者与一位已死亡玩家相邻，他不会获取到有关死亡玩家的任何信息。");
    g_tipLine[8325] = StringToText("  取而代之的是，他会获取与那位死亡玩家同一方向上最近的存活玩家的信息。");
    g_tipLine[8326] = StringToText("· 共情者在恶魔之后行动，因此如果恶魔杀死了共情者邻近玩家之一，共情者不会得知有关那位现在已死的玩家的信息。");
    g_tipLine[8327] = StringToText("  共情者的信息以当晚黎明时的状态为基准，而非黄昏。");
    g_tipLine[8328] = StringToText("【范例】");
    g_tipLine[8329] = StringToText("共情者与两名善良玩家相邻——士兵与僧侣。共情者得知了「0」。");
    g_tipLine[8330] = StringToText("下一天，士兵被处决。在那一晚，僧侣被小恶魔杀死。共情者现在会探查与士兵和僧侣相邻的玩家——图书管理员与邪恶的枪手");
    g_tipLine[8331] = StringToText("  。共情者得知了「1」。");
    g_tipLine[8332] = StringToText("在最后一夜里，只有三名玩家存活：共情者，小恶魔与男爵。不论谁坐在何处，共情者均会得知「2」。");
    g_tipLine[8333] = StringToText("【运作方式】");
    g_tipLine[8334] = StringToText("每个夜晚，唤醒共情者。为共情者用手势比划与他邻近的邪恶玩家数量（0，1，或2）。让共情者重新入睡。");
    g_tipLine[8335] = StringToText("【提示标记】");
    g_tipLine[8336] = StringToText("无");
    g_tipLine[8337] = StringToText("【规则细节】");
    g_tipLine[8338] = StringToText("· 共情者得知的信息是当晚黎明时的状况，而非黄昏时的，因此在当晚复活的角色（通常会是在共情者行动之前复活），");
    g_tipLine[8339] = StringToText("  也可能会因为成为与共情者邻近的存活玩家，从而影响共情者获取的信息。");
    g_tipLine[8340] = StringToText("【提示与技巧】");
    g_tipLine[8341] = StringToText("· 你应该根据你得到的信息决定如何对待你的邻座：");
    g_tipLine[8342] = StringToText("  · 如果你得到的数字是\"0\"，那你可能就是坐在两位善良阵营玩家中间，你可以与他们合作并且努力让他们存活下来。");
    g_tipLine[8343] = StringToText("  · 如果你得到的数字是\"1\"，那就只有一位邻座是可信的。你需要决定你要相信哪一位，并且让另外一位出局。");
    g_tipLine[8344] = StringToText("  · 如果你得到的数字是\"2\"，那就表明你坐在两位邪恶阵营玩家中间，你应该尽快想办法去改变现状。");
    g_tipLine[8345] = StringToText("· 如果你相信你的邻座，让他们保持存活会极大程度地缩小恶魔的嫌疑范围。");
    g_tipLine[8346] = StringToText("· 在夜晚，你被唤醒时所得到的信息是基于场上目前的状况的（在恶魔当晚杀害过玩家之后）。");
    g_tipLine[8347] = StringToText("  这就意味着如果你的邻座当晚被杀害了，你就能立刻得到下一位存活玩家的信息。");
    g_tipLine[8348] = StringToText("· 如果你的邻座玩家死亡，你将会收到离你最近的下一位存活玩家的信息。让你的邻座被杀害意味着你能得到更多信息。");
    g_tipLine[8349] = StringToText("  与送葬者配合证实你死去邻座的角色，并按次序拿到下一位的新信息是一个不错的策略。");
    g_tipLine[8350] = StringToText("· 尽早说出你获得的信息（尤其是当你坐在邪恶玩家旁边时）能够让其余善良阵营的玩家与你更好地配合，");
    g_tipLine[8351] = StringToText("  并进一步查验你所怀疑的玩家的角色。");
    g_tipLine[8352] = StringToText("· 然而稍作等待再透露你的信息意味着你能够保护你的善良阵营邻座并且监视邪恶阵营的那一个，");
    g_tipLine[8353] = StringToText("  同时你也能收集更多的场上信息。");
    g_tipLine[8354] = StringToText("· 如果你得到的数字是\"1\"或\"2\"，你可以考虑告诉你的邻座你得到的数字是\"0\"。");
    g_tipLine[8355] = StringToText("  这可能会让你看起来像个酒鬼或者是中毒了，这样邪恶阵营的玩家就会更倾向让你活着，因为你看起来并不构成威胁。");
    g_tipLine[8356] = StringToText("  不过你得记得在游戏结束之前把你的真实信息公布出来！");
    g_tipLine[8357] = StringToText("· 邻座的旅行者也会计入到你获取的信息当中。如果你之前得到的信息都是\"0\"，但这一轮突然得到了\"1\"，");
    g_tipLine[8358] = StringToText("  你旁边新加入的旅行者应该会有很大嫌疑。");
    g_tipLine[8359] = StringToText("· 当心间谍！他们可能被你当作好人，导致你得到错误的数字。另外，陌客也可能被你当作邪恶，");
    g_tipLine[8360] = StringToText("  这将导致你会误以为自己坐在邪恶阵营玩家旁边。");
    g_tipRoleAt[4] = 8316; g_tipRoleN[4] = 45; g_tipP1At[4] = 8319; g_tipP1N[4] = 9; g_tipP2At[4] = 8337; g_tipP2N[4] = 3;
    g_tipAbility[4] = StringToText("每个夜晚，你会得知与你邻近的两名存活的玩家中邪恶玩家的数量。");
    g_tipLine[8361] = StringToText("【背景故事】");
    g_tipLine[8362] = StringToText("「我在你的灵魂中感受到了庞大的恶意！");
    g_tipLine[8363] = StringToText("但……那可能只是你的香水味道。我对接骨木汁过敏。」");
    g_tipLine[8364] = StringToText("【角色能力】");
    g_tipLine[8365] = StringToText("每个夜晚，你要选择两名玩家：你会得知他们之中是否有恶魔。");
    g_tipLine[8366] = StringToText("会有一名善良玩家始终被你的能力当作恶魔。");
    g_tipLine[8367] = StringToText("【角色简介】");
    g_tipLine[8368] = StringToText("占卜师能探查谁是恶魔，但某些时候也会误以为善良玩家是恶魔。");
    g_tipLine[8369] = StringToText("· 每个夜晚，占卜师需要选择两名玩家，得知其中是否有恶魔。他不会得知具体哪一名玩家是恶魔，只知道两名玩家之中有恶魔。");
    g_tipLine[8370] = StringToText("  如果两名玩家均不是恶魔，他会得知「否」。");
    g_tipLine[8371] = StringToText("· 不幸的是，会有一名被称作「干扰项」的玩家，会被占卜师在选中时当作恶魔。「干扰项」在一整场游戏中只会是同一名玩家。");
    g_tipLine[8372] = StringToText("  这名玩家可以是任何善良玩家，甚至是占卜师自己。占卜师不会知道哪一名玩家是他的「干扰项」。");
    g_tipLine[8373] = StringToText("· 占卜师可以选择任意两名玩家——无论他们存活与否，甚至可以选择自己。如果占卜师选中了已死亡的恶魔，仍然会得知「是」");
    g_tipLine[8374] = StringToText("  。");
    g_tipLine[8375] = StringToText("【范例】");
    g_tipLine[8376] = StringToText("占卜师选择了镇长与送葬者，并得知了「否」。");
    g_tipLine[8377] = StringToText("占卜师选择了小恶魔与共情者，并得知了「是」。");
    g_tipLine[8378] = StringToText("占卜师选择了一名存活的小恶魔与一名死亡的小恶魔，并得知了「是」。");
    g_tipLine[8379] = StringToText("占卜师选择了自己与作为「干扰项」的圣徒。占卜师得知了「是」。");
    g_tipLine[8380] = StringToText("【运作方式】");
    g_tipLine[8381] = StringToText("在为首个夜晚进行准备时，将占卜师的「干扰项」提示标记放置在任意善良角色标记旁，标记那名玩家为「干扰项」。");
    g_tipLine[8382] = StringToText("每个夜晚，唤醒占卜师。让占卜师指向任意两名玩家。如果这两名玩家中任意一名是恶魔或「干扰项」，");
    g_tipLine[8383] = StringToText("  对占卜师点头表示「是」。否则，摇头表示「否」。让占卜师重新入睡。");
    g_tipLine[8384] = StringToText("在小型游戏中（指汀西维尔模式），我们建议你在某些情况下将占卜师本人作为「干扰项」，");
    g_tipLine[8385] = StringToText("  以使占卜师能通过这种方式得到更多信息。");
    g_tipLine[8386] = StringToText("【提示标记】");
    g_tipLine[8387] = StringToText("· 干扰项");
    g_tipLine[8388] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8389] = StringToText("放置条件：放置在任意一个善良玩家的角色标记旁边，可以是占卜师自己。");
    g_tipLine[8390] = StringToText("移除时机：占卜师死亡或离场时。");
    g_tipLine[8391] = StringToText("【规则细节】");
    g_tipLine[8392] = StringToText("· 虽然在占卜师的角色详解中提及了「‘干扰项’在一整场游戏中只会是同一名玩家」，");
    g_tipLine[8393] = StringToText("  但这是由于在暗流涌动中不会出现阵营转变效果而导致的。不去介绍更深层次的规则仅仅只是不希望玩家在一开始就因为接收到");
    g_tipLine[8394] = StringToText("  过于复杂的规则而变得迷惑（正常来说，玩家需要进入到梦殒春宵后才会接触到阵营转变的效果）。实际上，");
    g_tipLine[8395] = StringToText("  占卜师的能力包含了动态检测效果，一旦被他标记为「干扰项」的那名玩家变为邪恶阵营，");
    g_tipLine[8396] = StringToText("  说书人就需要重新选择另一名善良玩家并放置「干扰项」标记。但只要被标记为「干扰项」的玩家阵营没有发生变化，");
    g_tipLine[8397] = StringToText("  那么他就始终都会是「干扰项」。这种情况其实与得知寡妇在场的玩家变为邪恶阵营后，");
    g_tipLine[8398] = StringToText("  会重新有一名善良玩家得知寡妇在场是类似的。");
    g_tipLine[8399] = StringToText("· 虽然在绝大部分情况下这并没有什么用，但是以为自己是占卜师的酒鬼因为不具有占卜师的能力，也就因此不会有「干扰项」");
    g_tipLine[8400] = StringToText("  这个标记。提线木偶同理。");
    g_tipLine[8401] = StringToText("· 特定角色互动：");
    g_tipLine[8402] = StringToText("  · 数学家：占卜师因为选择「干扰项」而得知「是」不会计入到数学家的能力检测中，");
    g_tipLine[8403] = StringToText("    因为这是他自身能力让自己获取的信息出错。醉酒中毒情况下，占卜师选择了「干扰项」玩家而得知了「否」");
    g_tipLine[8404] = StringToText("    时（因为在未醉酒中毒情况下会得知「是」，「看错干扰项」这一能力因为醉酒中毒而未正常生效），");
    g_tipLine[8405] = StringToText("    会计入到数学家的能力检测中。");
    g_tipLine[8406] = StringToText("  · 涡流：如果涡流在场，占卜师仅仅选中了「干扰项」会得知「是」，这是因为占卜师的获取信息只判断「是否选中了恶魔」，");
    g_tipLine[8407] = StringToText("    而这次选择他没有选中恶魔，因此得知「是」。");
    g_tipLine[8408] = StringToText("  · 咖啡师：咖啡师的「获取正确信息」效果对占卜师生效的期间里，会让占卜师不再把「干扰项」错认成恶魔。");
    g_tipLine[8409] = StringToText("【提示与技巧】");
    g_tipLine[8410] = StringToText("· 得到\"没有恶魔\"的信息要比你得到\"有恶魔\"的信息更有用。\"没有恶魔\"意味着你所选择的两位玩家都不是恶魔，");
    g_tipLine[8411] = StringToText("  这能帮助你缩小恶魔的嫌疑范围。");
    g_tipLine[8412] = StringToText("· 你可以用你已经验证的非恶魔玩家帮助你找到恶魔。在你得到信息\"有恶魔\"的两位中选择一位，");
    g_tipLine[8413] = StringToText("  再从你已经确认不是恶魔的两位中选择一位，查验这两位看看会得到什么结果。如果你得到了\"有恶魔\"，");
    g_tipLine[8414] = StringToText("  那你已经可以假设你找到恶魔了；如果你得到了信息\"没有恶魔\"，那你没选择的另外一位就是恶魔了。");
    g_tipLine[8415] = StringToText("· 你只有有限的夜晚去收集信息。花大量时间集中在一到两个玩家身上会让你整场获得的信息都不多。由于这个原因，");
    g_tipLine[8416] = StringToText("  一个行之有效的方法就是去广撒网并且查验尽可能多的玩家。在你获得大量信息之后，");
    g_tipLine[8417] = StringToText("  就可以开始重点着手于你所怀疑的玩家了。");
    g_tipLine[8418] = StringToText("· 如果你在你所怀疑的玩家身上得到了\"有恶魔\"，确认究竟是哪位玩家让你得到了\"有\"就是你接下来的目标，");
    g_tipLine[8419] = StringToText("  特别是如果那个玩家到游戏后期还活着的时候。");
    g_tipLine[8420] = StringToText("· 你的\"干扰项\"玩家在游戏开始就会被确定下来并且不会再更改（在《暗流涌动》里来说，一定是这样的），");
    g_tipLine[8421] = StringToText("  因此你不会因为你的能力得到一个以上的错误信息。记住，你的误认可以是任何人，包括你自己。");
    g_tipLine[8422] = StringToText("  得到一个\"有恶魔\"的信息并不能一定找到恶魔。");
    g_tipLine[8423] = StringToText("· 你可以选择查验你自己和另一位玩家。因为你已经知道自己不是恶魔了，这样你就能去确认某一位玩家的角色。");
    g_tipLine[8424] = StringToText("  尽管是这样你也还是要小心，说书人可能让你自己作为那个\"干扰项\"，因此这个方法并不总是行之有效的。");
    g_tipLine[8425] = StringToText("· 当心陌客，他可能会被你当做恶魔。这和\"干扰项\"不是一回事。");
    g_tipLine[8426] = StringToText("· 公开说自己是一个恶魔不是那么愿意攻击的角色，像圣徒，管家，士兵或守鸦人这类的角色能让你活得更久，");
    g_tipLine[8427] = StringToText("  这样你就有更多的时间来获取有用的信息了。");
    g_tipRoleAt[5] = 8361; g_tipRoleN[5] = 67; g_tipP1At[5] = 8364; g_tipP1N[5] = 11; g_tipP2At[5] = 8391; g_tipP2N[5] = 18;
    g_tipAbility[5] = StringToText("每个夜晚，你要选择两名玩家：你会得知他们之中是否有恶魔。会有一名善良玩家始终被你的能力当作恶魔。");
    g_tipLine[8428] = StringToText("【背景故事】");
    g_tipLine[8429] = StringToText("「嗯……看看我们发现了什么？左靴到足跟都有磨损，靴尖下还有些硝石屑。这是军人才会有的装束。」");
    g_tipLine[8430] = StringToText("【角色能力】");
    g_tipLine[8431] = StringToText("每个夜晚*，你会得知今天白天死于处决的玩家的角色。");
    g_tipLine[8432] = StringToText("【角色简介】");
    g_tipLine[8433] = StringToText("送葬者会得知当天因处决而死亡的角色。");
    g_tipLine[8434] = StringToText("· 只有死于处决的玩家才会被送葬者得知是哪一种角色。在白天因为其他原因造成的死亡，例如枪手杀死的玩家，");
    g_tipLine[8435] = StringToText("  或对旅行者的流放，不算在内。");
    g_tipLine[8436] = StringToText("· 送葬者会在除首个夜晚以外的每晚醒来，因为在首个夜晚之前不会有任何处决发生。");
    g_tipLine[8437] = StringToText("· 如果当天没有玩家死亡，送葬者不会得知任何消息。说书人在夜晚时要么不唤醒送葬者，要么唤醒他但并不对他展示角色标记。");
    g_tipLine[8438] = StringToText("· 如果酒鬼被处决，送葬者会被展示酒鬼标记，而非那名酒鬼玩家以为自己是的那个镇民标记。");
    g_tipLine[8439] = StringToText("【范例】");
    g_tipLine[8440] = StringToText("镇长今天被处决。当晚，送葬者被展示了镇长标记。");
    g_tipLine[8441] = StringToText("以为自己是贞洁者的酒鬼今天被处决。送葬者被展示了酒鬼标记，因为送葬者得知的是玩家实际角色，");
    g_tipLine[8442] = StringToText("  而不是玩家以为的那个角色。");
    g_tipLine[8443] = StringToText("间谍被处决。两名旅行者被流放。在当晚，送葬者被展示了管家标记，因为此时间谍被当作了管家，且流放并不是处决。");
    g_tipLine[8444] = StringToText("今天白天没有人被处决。当晚，送葬者没有被唤醒。");
    g_tipLine[8445] = StringToText("【运作方式】");
    g_tipLine[8446] = StringToText("如果一名玩家死于处决，将送葬者的「死于今日」提示标记放置在那名死亡玩家的角色标记旁。");
    g_tipLine[8447] = StringToText("除首个夜晚以外的每个夜晚，如果当天有任何玩家死于处决，唤醒送葬者。向他展示被标记了「死于今日」的角色标记。");
    g_tipLine[8448] = StringToText("  让送葬者重新入睡。在说书人方便的时候，移除送葬者的提示标记。");
    g_tipLine[8449] = StringToText("在《暗流涌动》里，每个白天只会有一场处决，且每次处决都会导致一名玩家死亡。在其他剧本中，");
    g_tipLine[8450] = StringToText("  每天可能会有多于一次的处决（在这种情形下由说书人决定向送葬者展示其中的哪一个角色标记），");
    g_tipLine[8451] = StringToText("  或发生了处决但并未导致死亡（在这种情形下送葬者不会得知任何消息）。");
    g_tipLine[8452] = StringToText("【提示标记】");
    g_tipLine[8453] = StringToText("· 死于今日");
    g_tipLine[8454] = StringToText("放置时机：在白天时，如果有人因处决而死亡，在该玩家的角色标记旁放置。");
    g_tipLine[8455] = StringToText("放置条件：在因处决而死亡的玩家的角色标记旁放置，而不论此时送葬者是否醉酒中毒。");
    g_tipLine[8456] = StringToText("移除时机：在送葬者获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[8457] = StringToText("特殊说明：由于送葬者的能力为回溯型能力，因此如果送葬者在游戏中途产生，仍然要根据当前情况补放标记，");
    g_tipLine[8458] = StringToText("  而不是因为没有放置标记便不在夜晚告知送葬者信息。");
    g_tipLine[8459] = StringToText("【规则细节】");
    g_tipLine[8460] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，送葬者可能不会被唤醒，也可能会被唤醒但不得知任何消息。");
    g_tipLine[8461] = StringToText("  说书人可以自行决定并提前告知玩家本场游戏将以何种方式运作。然而，不论是否唤醒送葬者，");
    g_tipLine[8462] = StringToText("  都不应该对侍女获得的消息产生影响。（即：如果说书人决定不唤醒送葬者，那么无论实际操作中是否唤醒送葬者，");
    g_tipLine[8463] = StringToText("  侍女都不应探查到送葬者被唤醒，反之亦然。）");
    g_tipLine[8464] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，但涡流在场，送葬者不会因此得知错误的信息。因为无人因处决而死，");
    g_tipLine[8465] = StringToText("  所以送葬者不会因此获得信息，也就不会受到涡流的影响。");
    g_tipLine[8466] = StringToText("· 在夜晚因处决而死亡的玩家其角色不会被送葬者得知。");
    g_tipLine[8467] = StringToText("【提示与技巧】");
    g_tipLine[8468] = StringToText("· 被处决的玩家越多，你得到的信息就越多。尽可能多地促成处决将让你获益匪浅。");
    g_tipLine[8469] = StringToText("  善良阵营击杀邪恶阵营玩家的主要手段就是处决，因为邪恶阵营玩家基本不会死在晚上，因此每一次处决都是攻击恶魔的机会。");
    g_tipLine[8470] = StringToText("  即使你没有找到恶魔，你也至少要活到游戏的最后一天，这样你将会知道更多关于你队友以及其角色信息。");
    g_tipLine[8471] = StringToText("· 你不会得知旅行者的角色。他们会因为流放而死亡，但不会因为处决而死亡。对于这一点来说唯一一个例外就是替罪羊，");
    g_tipLine[8472] = StringToText("  因为他确实会因为他的角色能力被处决。然而，你不会得知他的阵营，只能得知他的角色，而他的角色人尽皆知。");
    g_tipLine[8473] = StringToText("· 处决一个你不知道角色的人会让你声称自己是送葬者这件事更可信。同样的，");
    g_tipLine[8474] = StringToText("  处决一个已经说了自己是什么角色的人会让你能够证实他之前说的话是否真实，因为你会知道他到底是不是他所说的这个角色。");
    g_tipLine[8475] = StringToText("  这两种方法都会让你的善良玩家队友相信你。");
    g_tipLine[8476] = StringToText("· 早期比较适合的被处决的人选是像洗衣妇和图书管理员之类的角色，因为你在确认了他们角色的同时也证实了其他善良阵营玩家");
    g_tipLine[8477] = StringToText("  的角色。");
    g_tipLine[8478] = StringToText("· 太早暴露自己会增加你死亡或是中毒的风险。等到关键时刻再公布你的信息将会让你接收到的信息量最大化。");
    g_tipLine[8479] = StringToText("  不过还是要记得在游戏结束之前说出你的角色！");
    g_tipLine[8480] = StringToText("· 如果你知道了一些关键信息（比如你查验到的是恶魔），早点说出自己的角色也是个不错的选择。");
    g_tipLine[8481] = StringToText("· 如果你看到被处决的玩家是小恶魔，现在场上大概率就是原来的红唇女郎接过了恶魔的接力棒。");
    g_tipLine[8482] = StringToText("· 如果被处决的玩家是酒鬼，你将会看到酒鬼的角色标记，而不是他以为的镇民角色的标记。");
    g_tipLine[8483] = StringToText("· 由于提名贞洁者而被处决的玩家也会触发你的能力，因此你也会在晚上知道他是谁。");
    g_tipLine[8484] = StringToText("· 当心间谍和陌客！他们有可能相应地被你当做善良角色和邪恶角色，因为他们的能力在他们死后也依然生效。");
    g_tipLine[8485] = StringToText("· 如果你认为有送葬者在场，你可以通过某种方法测试一下。你可以撒谎说自己是某个其他角色，然后再让自己被处决。");
    g_tipLine[8486] = StringToText("  这样送葬者将会知道你的真实角色，并且能够告诉团队你到底是谁，因而证实他之前说的就是真话。");
    g_tipRoleAt[6] = 8428; g_tipRoleN[6] = 59; g_tipP1At[6] = 8430; g_tipP1N[6] = 9; g_tipP2At[6] = 8459; g_tipP2N[6] = 8;
    g_tipAbility[6] = StringToText("每个夜晚*，你会得知今天白天死于处决的玩家的角色。");
    g_tipLine[8487] = StringToText("【背景故事】");
    g_tipLine[8488] = StringToText("「今夜吹来的是一股邪恶又致命的风。");
    g_tipLine[8489] = StringToText("来吧，我的同胞，这风暴过于肆虐，来修道院找寻庇佑吧。");
    g_tipLine[8490] = StringToText("我保证，我会用性命，护你周全。」");
    g_tipLine[8491] = StringToText("【角色能力】");
    g_tipLine[8492] = StringToText("每个夜晚*，你要选择除你以外的一名玩家：当晚恶魔的负面能力对他无效。");
    g_tipLine[8493] = StringToText("【角色简介】");
    g_tipLine[8494] = StringToText("僧侣会保护他人免受恶魔侵害。");
    g_tipLine[8495] = StringToText("· 除首个夜晚以外的每个夜晚，僧侣可以保护除自己以外的任意玩家。");
    g_tipLine[8496] = StringToText("· 如果恶魔攻击了被僧侣保护的玩家，那名玩家不会死亡。恶魔也不能再去攻击另一名玩家——当晚会没有任何人死亡。");
    g_tipLine[8497] = StringToText("· 僧侣无法保护被恶魔提名并处决的玩家。");
    g_tipLine[8498] = StringToText("【范例】");
    g_tipLine[8499] = StringToText("僧侣保护了占卜师。小恶魔攻击了占卜师。今晚没有人死亡。");
    g_tipLine[8500] = StringToText("僧侣保护了镇长。小恶魔攻击了镇长。镇长的「会有其他玩家死亡」的能力不会被触发，因为小恶魔的能力对镇长无效。");
    g_tipLine[8501] = StringToText("  今晚没有人死亡。");
    g_tipLine[8502] = StringToText("僧侣保护了小恶魔。小恶魔选择在当晚自杀，但无事发生。小恶魔仍然存活，并且也没有新的小恶魔被创造出来。");
    g_tipLine[8503] = StringToText("【运作方式】");
    g_tipLine[8504] = StringToText("除首个夜晚以外的每个夜晚，唤醒僧侣。让僧侣指向除自己外的任意一名玩家。（如果僧侣指向自己，摇头表示否定，");
    g_tipLine[8505] = StringToText("  并让他指向另一名玩家。）让僧侣重新入睡。将僧侣的「保护」提示标记放置在他选择的玩家角色标记旁。");
    g_tipLine[8506] = StringToText("如果恶魔攻击了标记有「保护」标记的玩家，玩家仍然会存活。（不要对他进行通常应该进行的放置恶魔「死亡」标记的操作，");
    g_tipLine[8507] = StringToText("  或放置帷幕标记的操作。）在黎明时，宣布当晚无人死亡。（不要解释原因。）");
    g_tipLine[8508] = StringToText("在黎明时，移除「保护」提示标记。");
    g_tipLine[8509] = StringToText("在其他剧本中，恶魔可能会拥有除杀死以外的其他能力。僧侣的保护同样可以阻止恶魔的其他有害效果，");
    g_tipLine[8510] = StringToText("  例如中毒或将玩家转变为邪恶阵营。");
    g_tipLine[8511] = StringToText("【提示标记】");
    g_tipLine[8512] = StringToText("· 保护");
    g_tipLine[8513] = StringToText("放置时机：在僧侣夜晚行动并选择了玩家后。");
    g_tipLine[8514] = StringToText("放置条件：在僧侣要保护的玩家角色标记旁放置。僧侣无法保护自己。若此时僧侣醉酒中毒，不放置该标记。");
    g_tipLine[8515] = StringToText("移除时机：在黎明时，或僧侣死亡或离场时。");
    g_tipLine[8516] = StringToText("【规则细节】");
    g_tipLine[8517] = StringToText("· 僧侣能够保护的有害效果包括：死亡，醉酒，中毒，疯狂，阵营变化，来自与该玩家（保护目标）");
    g_tipLine[8518] = StringToText("  阵营不同的恶魔对他进行的角色变化，涡流的错误信息，等等。");
    g_tipLine[8519] = StringToText("· 僧侣无法保护的效果包括：复活（沙巴洛斯和哈迪寂亚），来自与该玩家（保护目标）阵营相同的恶魔对他进行的角色变化，");
    g_tipLine[8520] = StringToText("  照看小怪宝，成为痢蛭的寄生对象（只会让该玩家免疫中毒，但痢蛭的免死能力还是会与该玩家绑定），等等。");
    g_tipLine[8521] = StringToText("· 相克规则：");
    g_tipLine[8522] = StringToText("  · 利维坦：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_tipLine[8523] = StringToText("  · 暴乱：如果暴乱提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_tipLine[8524] = StringToText("【提示与技巧】");
    g_tipLine[8525] = StringToText("· 你的目标是要去保证还有价值的善良阵营玩家存活并阻止恶魔带来的骚乱。");
    g_tipLine[8526] = StringToText("  根据手头可用的信息以及其他玩家的行为来尝试预判恶魔在每个晚上可能会对哪位玩家出手。每个恶魔的想法都不同，");
    g_tipLine[8527] = StringToText("  找到一种能够让你保护更多玩家的方法。");
    g_tipLine[8528] = StringToText("· 不要试着预测恶魔会做什么。相反，你需要与你的队友交流并且尽全力保证其中一名玩家的存活。");
    g_tipLine[8529] = StringToText("  像占卜师和共情者这样强力的角色，能够在你的保护下整场存活。");
    g_tipLine[8530] = StringToText("· 如果你找到了猎手或者贞洁者，你要说服他们不要立刻使用能力，因为你能保护他们。");
    g_tipLine[8531] = StringToText("  这能让他们把整场仅限一次的能力多保留一会儿，直到场面上出现了更多的信息。");
    g_tipLine[8532] = StringToText("· 你不能保护的玩家只有你自己。如果你阻挠了恶魔的行动，那他很可能会想要找到你并且杀害你，");
    g_tipLine[8533] = StringToText("  因此你要尽量避免被恶魔盯上。你可以伪装成像厨师这类不那么起眼的角色，");
    g_tipLine[8534] = StringToText("  也可以伪装成守鸦人或者士兵这种恶魔对他毫无兴趣的角色。");
    g_tipLine[8535] = StringToText("· 如果你在晚上成功保护了某个人，你有理由确认他是个善良阵营玩家，因为恶魔想要他死。唯一的例外就是小恶魔，");
    g_tipLine[8536] = StringToText("  他可以通过特殊的能力自杀并且将恶魔能力传递给爪牙，不过这种情况发生的概率也不是很大。");
    g_tipLine[8537] = StringToText("· 如果你怀疑某个人是小恶魔，并且感觉他可能要自杀来传递恶魔能力，你就可以故意保护他，让他没办法做这件事情。");
    g_tipLine[8538] = StringToText("· 公然承认自己的僧侣角色能让你更好地与善良阵营玩家配合，找到一个夜晚守护的最佳人选。即便你死了，你也守护了小镇。");
    g_tipLine[8539] = StringToText("  因为恶魔必须要耗费一个晚上的时间去杀你，这样就不能杀送葬者或是贞洁者了。（如果你要这么玩的话，就得当心投毒者！");
    g_tipLine[8540] = StringToText("  他能让你的能力失效，之后恶魔就可以随意杀人了。）");
    g_tipLine[8541] = StringToText("· 误导恶魔，让他们弄错你将要保护的玩家。你可以公开选择玩家也可以私下选择。如果恶魔相信你将要保护占卜师，");
    g_tipLine[8542] = StringToText("  恶魔就不会杀他，这样你就可以保护你想要保护的另一个人。如果你不说要保护某一个人，");
    g_tipLine[8543] = StringToText("  而是说要从几个人里面挑几个保护会让恶魔更加猜不透你。");
    g_tipLine[8544] = StringToText("· 如果你成功保护了目标，就让他说自己是士兵。这样就会让恶魔认为这个目标没有再次攻击的必要了，");
    g_tipLine[8545] = StringToText("  同时又能让你自己再多隐藏一晚。");
    g_tipRoleAt[7] = 8487; g_tipRoleN[7] = 59; g_tipP1At[7] = 8491; g_tipP1N[7] = 7; g_tipP2At[7] = 8516; g_tipP2N[7] = 8;
    g_tipAbility[7] = StringToText("每个夜晚*，你要选择除你以外的一名玩家：当晚恶魔的负面能力对他无效。");
    g_tipLine[8546] = StringToText("【背景故事】");
    g_tipLine[8547] = StringToText("「我的鸟儿们会替我复仇的！飞吧！飞吧，我尽职的小可爱！");
    g_tipLine[8548] = StringToText("去到庄园和溪边！去到小巷和集会所里！快飞吧！」");
    g_tipLine[8549] = StringToText("【角色能力】");
    g_tipLine[8550] = StringToText("如果你在夜晚死亡，你会被唤醒，然后你要选择一名玩家：你会得知他的角色。");
    g_tipLine[8551] = StringToText("【角色简介】");
    g_tipLine[8552] = StringToText("守鸦人仅当在夜晚死去时，才能得知任意玩家的角色。");
    g_tipLine[8553] = StringToText("· 守鸦人会在他死去的那个夜晚被唤醒，然后立刻选择一名玩家。");
    g_tipLine[8554] = StringToText("· 如果守鸦人愿意，他可以选择一名已死亡的玩家。");
    g_tipLine[8555] = StringToText("【范例】");
    g_tipLine[8556] = StringToText("守鸦人被小恶魔杀死，然后被唤醒以选择一名玩家。经过一番深思熟虑后，他选择了小八。小八是共情者，");
    g_tipLine[8557] = StringToText("  而守鸦人得知了这一消息。");
    g_tipLine[8558] = StringToText("小恶魔杀死了镇长。镇长并没有死亡，而是由守鸦人通过镇长的能力代替镇长死亡。守鸦人被唤醒并选择了已死亡的陌客道哥。");
    g_tipLine[8559] = StringToText("  守鸦人得知道哥是红唇女郎，因为陌客此时被当作了红唇女郎。");
    g_tipLine[8560] = StringToText("【运作方式】");
    g_tipLine[8561] = StringToText("如果守鸦人在夜晚死去，唤醒他。让守鸦人指向任意一名玩家。对守鸦人展示那名玩家的角色标记。让守鸦人重新入睡。");
    g_tipLine[8562] = StringToText("我们建议你阻止甚至禁止玩家在夜晚谈论他们当晚正在进行的操作。");
    g_tipLine[8563] = StringToText("【提示标记】");
    g_tipLine[8564] = StringToText("无");
    g_tipLine[8565] = StringToText("【规则细节】");
    g_tipLine[8566] = StringToText("· 只要守鸦人死在夜晚，不论因什么原因而死，他都能被唤醒并使用能力。");
    g_tipLine[8567] = StringToText("· 醉酒或中毒的守鸦人，或是以为自己是守鸦人的酒鬼或提线木偶如果在夜晚死亡，仍然会被唤醒并使用能力。");
    g_tipLine[8568] = StringToText("· 守鸦人只会得知玩家的角色，不会得知玩家的阵营。守鸦人在得知信息时会受到互动干扰类能力的影响而可能得知错误的角色。");
    g_tipLine[8569] = StringToText("· 相克规则：");
    g_tipLine[8570] = StringToText("  · 利维坦：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果守鸦人被选择，");
    g_tipLine[8571] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[8572] = StringToText("  · 暴乱：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果守鸦人被选择，");
    g_tipLine[8573] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[8574] = StringToText("【提示与技巧】");
    g_tipLine[8575] = StringToText("· 如果恶魔知道你是个守鸦人，他会非常不想杀你。伪装成一个对恶魔有持续威胁的角色会对你比较有帮助，比如共情者，");
    g_tipLine[8576] = StringToText("  占卜师，猎手，送葬者或者镇长。即便是伪装成一个可能被善良阵营相信的好角色（例如厨师或洗衣妇），");
    g_tipLine[8577] = StringToText("  也能够让你在恶魔眼里看起来更显眼，就可能在晚上吸引到恶魔的注意。");
    g_tipLine[8578] = StringToText("· 在暗流涌动中，守鸦人的信息最为优质。在每个夜幕来临之前，想清楚你想知道哪位玩家的角色。");
    g_tipLine[8579] = StringToText("  你绝对不会想一瞬间去随便做个匆忙的决定。");
    g_tipLine[8580] = StringToText("· 选存活的玩家通常比选已经死亡的玩家更能带来收益。如果你知道一个存活玩家是善良角色，你就不应该去处决他。");
    g_tipLine[8581] = StringToText("  如果你知道一个存活玩家是邪恶角色，你就应该处决他！然而，去确认一个死亡玩家是否为善良角色偶尔也可以带来巨大帮助。");
    g_tipLine[8582] = StringToText("  例如，确认一个已经死亡的洗衣妇、图书管理员、调查员或者厨师在说真话能够帮助你证实他们的信息。");
    g_tipLine[8583] = StringToText("· 当心间谍和陌客。如果你认为某名玩家是间谍，在你选择他时不大可能会得知他的真实角色，");
    g_tipLine[8584] = StringToText("  因为他的能力会让你将他错误地当作其他角色。然而，你可以用你的能力去查验酒鬼。如果你知道某名玩家是酒鬼，");
    g_tipLine[8585] = StringToText("  那你就可以确定他属于善良阵营，也能确信他所拿到的信息基本都是错误的。");
    g_tipLine[8586] = StringToText("· 记住，你只有死在夜晚才会得到信息。死在白天你将不会得知任何事情。");
    g_tipLine[8587] = StringToText("· 有时，安静地坐着并且拒绝提供任何信息会让你产生有强大威胁的气场，而实际上你也不必为你的伪装提供任何理由。");
    g_tipLine[8588] = StringToText("· 死在夜晚对你来说是最好的选择，因此要试着引诱恶魔来杀你。");
    g_tipLine[8589] = StringToText("· 你可能在第一天想要告诉团队的第一件事就是你是守鸦人。这通常会让你能够活到最后一天，因为恶魔大概率不会杀你。");
    g_tipLine[8590] = StringToText("  这个策略就意味着你将在游戏后期掌握更多主动（因为存活玩家可以比死亡玩家多投票），");
    g_tipLine[8591] = StringToText("  但你就牺牲了通过死亡换取信息的机会。");
    g_tipLine[8592] = StringToText("· 如果你在晚上通过死亡触发了能力，在接下来的白天告诉大家你是守鸦人的话，你的信息就能够立刻起作用。");
    g_tipLine[8593] = StringToText("· 如果你没有告诉任何人你是守鸦人，并且还活到了最后一天，那就很可能有间谍在场。如果你意识到这种情况，");
    g_tipLine[8594] = StringToText("  注意哪些人在窃窃私语。");
    g_tipRoleAt[8] = 8546; g_tipRoleN[8] = 49; g_tipP1At[8] = 8549; g_tipP1N[8] = 6; g_tipP2At[8] = 8565; g_tipP2N[8] = 9;
    g_tipAbility[8] = StringToText("如果你在夜晚死亡，你会被唤醒，然后你要选择一名玩家：你会得知他的角色。");
    g_tipLine[8595] = StringToText("【背景故事】");
    g_tipLine[8596] = StringToText("「我是纯洁的。就让那些无罪之人匍匐在地，替我受苦吧。我的名誉不应被你恶毒的指控所玷污。」");
    g_tipLine[8597] = StringToText("【角色能力】");
    g_tipLine[8598] = StringToText("当你首次被提名时，如果提名你的玩家是镇民，他立刻被处决。");
    g_tipLine[8599] = StringToText("【角色简介】");
    g_tipLine[8600] = StringToText("贞洁者不会被处决……也许吧。提名贞洁者的玩家通常会死亡。");
    g_tipLine[8601] = StringToText("· 如果一名镇民提名了贞洁者，那名镇民会立即被处决。因为每天只能有最多一次处决，提名的流程会立即结束，");
    g_tipLine[8602] = StringToText("  即使有其他玩家被提名且即将被处决。");
    g_tipLine[8603] = StringToText("· 只有镇民才会被贞洁者的能力处决。如果外来者，爪牙或恶魔提名了贞洁者，无事发生，并且提名流程会继续。");
    g_tipLine[8604] = StringToText("· 贞洁者的能力非常强大，因为如果有镇民提名了贞洁者并死亡，那么几乎可以确定这两名角色一定都是镇民。");
    g_tipLine[8605] = StringToText("· 当第一次被提名后，贞洁者会失去能力，即使发起提名者没有死亡，或者贞洁者处于醉酒或中毒状态。");
    g_tipLine[8606] = StringToText("【范例】");
    g_tipLine[8607] = StringToText("洗衣妇提名了贞洁者。洗衣妇被处决，并且投票终止。");
    g_tipLine[8608] = StringToText("以为自己是厨师的酒鬼提名了贞洁者。酒鬼仍然存活，并且贞洁者失去了他的能力。因为酒鬼是一名外来者而不是镇民。");
    g_tipLine[8609] = StringToText("  接下来玩家可以选择投票是否处决贞洁者。");
    g_tipLine[8610] = StringToText("一名已死亡的玩家提名了贞洁者。然而已死亡玩家无法发起提名。说书人宣布这次提名无效。贞洁者不会因此失去他的能力。");
    g_tipLine[8611] = StringToText("【运作方式】");
    g_tipLine[8612] = StringToText("如果首次提名贞洁者的玩家是镇民，立即宣布那名发起提名的玩家被处决。");
    g_tipLine[8613] = StringToText("  那名玩家死亡——在魔典中将帷幕标记放置在其角色标记上。贞洁者失去他的能力——将贞洁者的「失去能力」");
    g_tipLine[8614] = StringToText("  提示标记放置在其角色标记旁。终止提名流程并推进至夜晚阶段。（今天白天没有其他人能被处决。）");
    g_tipLine[8615] = StringToText("如果首次提名贞洁者的玩家不是镇民，照常继续进行投票。贞洁者失去他的能力——将贞洁者的「失去能力」");
    g_tipLine[8616] = StringToText("  提示标记放置在其角色标记旁。");
    g_tipLine[8617] = StringToText("【提示标记】");
    g_tipLine[8618] = StringToText("· 失去能力");
    g_tipLine[8619] = StringToText("放置时机：在贞洁者被首次提名时。");
    g_tipLine[8620] = StringToText("放置条件：在贞洁者角色标记旁放置。不论贞洁者是否醉酒中毒，都要放置该标记。");
    g_tipLine[8621] = StringToText("移除时机：贞洁者死亡或离场时。");
    g_tipLine[8622] = StringToText("【规则细节】");
    g_tipLine[8623] = StringToText("· 如果提名贞洁者的玩家其镇民角色不会因为处决而死亡（如弄臣、水手或被魔鬼代言人保护的玩家），");
    g_tipLine[8624] = StringToText("  则说书人会宣布该玩家被处决但没有死亡（不会说明具体原因），然后因为有处决发生，所以白天阶段依然会立即结束。");
    g_tipLine[8625] = StringToText("· 如果提名贞洁者的镇民玩家同时被女巫诅咒，则女巫的诅咒与贞洁者的处决在同一时间被触发。在这种情况下，");
    g_tipLine[8626] = StringToText("  由说书人来对以何种顺序结算这两个效果做出决定，但应该倾向于产生更多信息的结果（参考隐性规则第1条，同时触发）。");
    g_tipLine[8627] = StringToText("  因此，在大部分情况下，即使该玩家的角色是还未触发能力的弄臣，也建议当晚送葬者依然能够得知该玩家的角色。");
    g_tipLine[8628] = StringToText("【提示与技巧】");
    g_tipLine[8629] = StringToText("· 你是游戏中少数几个能够被绝对证实为善良的镇民。如果一名玩家因为提名你被处决，这就毋庸置疑地证明了你是贞洁者。");
    g_tipLine[8630] = StringToText("· 让已经获得信息的角色或是已经使用过能力的角色（像洗衣妇，调查员或者猎手）提名你是个不错的选择。");
    g_tipLine[8631] = StringToText("  他们的死不但能够验证他们获得的信息，而且随着游戏进行他们也不会因此失去获得更多信息的机会了。");
    g_tipLine[8632] = StringToText("· 像送葬者、占卜师或者甚至共情者这样的角色，在已经收到一定信息的情况下都可以作为一个不错的选择。");
    g_tipLine[8633] = StringToText("  又或者是在他们受到怀疑且想要排除自己恶魔嫌疑的情况下也可以让他们提名你。");
    g_tipLine[8634] = StringToText("· 在场的「追求者」你全都不喜欢怎么办？你可以提名自己并且触发能力，这样就能证明你是个贞洁者了！");
    g_tipLine[8635] = StringToText("· 一旦对你发起的提名生效，提名者（如果是镇民）就会立刻被处决，并且结束这个白天（即使是在有其他人已经被投票并且即将");
    g_tipLine[8636] = StringToText("  被处决的情况下）。使用这个策略可以让你阻止一场处决的发生并且证明你自己是个善良角色。");
    g_tipLine[8637] = StringToText("· 如果你被认作贞洁者但是还没用过你的能力，你将会是被攻击或中毒的首要目标。尽早使用你的能力会降低这种可能性，");
    g_tipLine[8638] = StringToText("  并且能够让善良阵营围绕着你作为基点进行推理。");
    g_tipLine[8639] = StringToText("· 等几个白天再宣布你是贞洁者也能够让你好好决定到底要谁来提名你。在游戏进行几天后被证明是善良的玩家能够完全解开一个");
    g_tipLine[8640] = StringToText("  邪恶的谜团。");
    g_tipLine[8641] = StringToText("· 如果你能够找到一个声称自己是僧侣的玩家，说服他在每个晚上都保护你。这样你在晚上就不用怕死了，");
    g_tipLine[8642] = StringToText("  你总是可以等到白天出现并且让某名玩家提名你。");
    g_tipLine[8643] = StringToText("· 如果你的能力没有生效，有以下几种可能：");
    g_tipLine[8644] = StringToText("  · 提名你的人是邪恶阵营的！邪恶阵营玩家能够提名贞洁者并且让你的能力无法生效，");
    g_tipLine[8645] = StringToText("    这样你的角色将无法被证明并且让你们两个都被人怀疑。");
    g_tipLine[8646] = StringToText("  · 提名你的人是个外来者！包括酒鬼，即使他以为自己是个镇民。");
    g_tipLine[8647] = StringToText("  · 你才是那个酒鬼又或者你中毒了，因此你失去了你的能力。");
    g_tipLine[8648] = StringToText("· 当心间谍！这是唯一一个可以触发你能力的邪恶阵营角色，因为他可能会被当作镇民。");
    g_tipRoleAt[9] = 8595; g_tipRoleN[9] = 54; g_tipP1At[9] = 8597; g_tipP1N[9] = 9; g_tipP2At[9] = 8622; g_tipP2N[9] = 6;
    g_tipAbility[9] = StringToText("当你首次被提名时，如果提名你的玩家是镇民，他立刻被处决。");
    g_tipLine[8649] = StringToText("【背景故事】");
    g_tipLine[8650] = StringToText("「受死吧。」");
    g_tipLine[8651] = StringToText("【角色能力】");
    g_tipLine[8652] = StringToText("每局游戏限一次，你可以在白天时公开选择一名玩家：如果他是恶魔，他死亡。");
    g_tipLine[8653] = StringToText("【角色简介】");
    g_tipLine[8654] = StringToText("猎手可以通过猜测谁是恶魔来杀死他。");
    g_tipLine[8655] = StringToText("· 猎手可以在白天里的任何时间选择使用他的能力，且必须在使用能力时对所有人进行宣布。如果猎手选中了恶魔，");
    g_tipLine[8656] = StringToText("  恶魔会立刻死亡。否则，无事发生。");
    g_tipLine[8657] = StringToText("· 玩家无法得知死去玩家的真实角色。毕竟，他有可能是陌客！");
    g_tipLine[8658] = StringToText("· 处于醉酒或中毒状态下且使用了自己能力的猎手将无法再次使用他的能力。");
    g_tipLine[8659] = StringToText("· 猎手通常会选择一名存活玩家。即使猎手选中了一个已死亡的小恶魔，也会无事发生，因为已死亡的玩家无法再次死亡。");
    g_tipLine[8660] = StringToText("· 玩家可以在任何时间发表任何言论，因此假装是猎手的玩家可以假装使用了猎手的能力。");
    g_tipLine[8661] = StringToText("【范例】");
    g_tipLine[8662] = StringToText("猎手选择了小恶魔。小恶魔死亡，并且善良阵营获胜！");
    g_tipLine[8663] = StringToText("猎手选择了陌客。陌客死亡，因为陌客此时被当作了小恶魔，但游戏继续。");
    g_tipLine[8664] = StringToText("小恶魔谎称自己是猎手。他对红唇女郎宣布使用了猎手的能力。无事发生。");
    g_tipLine[8665] = StringToText("【运作方式】");
    g_tipLine[8666] = StringToText("在白天时，猎手可以宣布他想要使用他的能力。如果他这么做了，让猎手指向任意一名玩家。");
    g_tipLine[8667] = StringToText("  如果被选择的玩家是一名存活的恶魔，宣布那名玩家死亡——在魔典中那名玩家的角色标记上放置一枚帷幕标记。");
    g_tipLine[8668] = StringToText("  如果被选择的玩家不是一名存活的恶魔，宣布「无事发生」。在这两种情形下，");
    g_tipLine[8669] = StringToText("  猎手都会失去他的能力——将猎手的「失去能力」提示标记放置在猎手的角色标记旁。");
    g_tipLine[8670] = StringToText("如果一名玩家谎称自己是猎手并想要使用自己的能力，如同他真的是猎手一样配合他进行表演——允许短暂的讨论时间，");
    g_tipLine[8671] = StringToText("  让他做出自己的决定，然后你装作在魔典中摆弄标记的样子，并说「无事发生」。");
    g_tipLine[8672] = StringToText("如果猎手想要使用自己的能力，给与玩家一到两分钟的时间以讨论猎手应该选择谁。");
    g_tipLine[8673] = StringToText("  这会让玩家们觉得自己需要为胜利（或失败）负责任。但一定是由猎手来做出最终决断。");
    g_tipLine[8674] = StringToText("【提示标记】");
    g_tipLine[8675] = StringToText("· 失去能力");
    g_tipLine[8676] = StringToText("放置时机：在猎手公开宣布使用自己的能力并选择目标时。");
    g_tipLine[8677] = StringToText("放置条件：在猎手公开宣布使用自己的能力并选择目标后，放置在猎手角色标记旁。不论猎手是否醉酒中毒，都要放置该标记。");
    g_tipLine[8678] = StringToText("移除时机：猎手死亡或离场时。");
    g_tipLine[8679] = StringToText("【规则细节】");
    g_tipLine[8680] = StringToText("· 相克规则：");
    g_tipLine[8681] = StringToText("  · 痢蛭：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_tipLine[8682] = StringToText("【提示与技巧】");
    g_tipLine[8683] = StringToText("· 在游戏后期使用你的能力要比你在游戏前期使用这个能力要有效得多。有更少的玩家存活，");
    g_tipLine[8684] = StringToText("  你就有更大的概率选中恶魔并赢得游戏。除此之外，如果少于五名玩家存活，红唇女郎也无法在你杀死恶魔之后变成新的恶魔。");
    g_tipLine[8685] = StringToText("· 然而，在游戏前期用了你的能力也比到死都没用能力要好。大多数玩家会在最后一天到来之前死掉，");
    g_tipLine[8686] = StringToText("  因此你在最后一天也已经死了的概率还是挺高的。确保死之前把你的能力用掉。恶魔会想要尽快杀死你，");
    g_tipLine[8687] = StringToText("  因此在你想要使用能力之前，不要说你自己是猎手。");
    g_tipLine[8688] = StringToText("· 与其他玩家协作，这样可以帮助你决定要选择哪位玩家。当你告诉大家你是猎手的时候，");
    g_tipLine[8689] = StringToText("  你会发现有一些玩家将开始公布自己的角色以及获得的信息，这能够让你做出一个最优选择。");
    g_tipLine[8690] = StringToText("· 大多数情况下，你选择击杀的玩家并不是恶魔。但这也是有用的，因为你知道了一个玩家他肯定不是恶魔。");
    g_tipLine[8691] = StringToText("  知道谁不是恶魔几乎和知道谁是恶魔一样有用。");
    g_tipLine[8692] = StringToText("· 有的时候，选择击杀一名玩家并不是因为你认为他是个恶魔，而是为了确保他不是恶魔。例如，如果一个玩家说自己是圣徒，");
    g_tipLine[8693] = StringToText("  并且将要被处决了，你可以通过对他使用能力来确保他不是恶魔。如果他没死，你们就要考虑去处决另外一个人了！");
    g_tipLine[8694] = StringToText("· 当你选择使用自己的能力时，说书人会允许大家花一到两分钟时间来讨论一下其他人的看法是什么。他们可能会给你建议，");
    g_tipLine[8695] = StringToText("  但是最终选择还是你自己来做。在这期间，你可以假装要去选择某一位玩家，这样你就可以观察他们受到了多大压力。例如，");
    g_tipLine[8696] = StringToText("  如果你本来是想选择说自己是镇长的玩家，你可以跟大家说你特别想选那个说自己是士兵的玩家，");
    g_tipLine[8697] = StringToText("  然后在你做出最终决定之前偷偷观察士兵的反应。");
    g_tipLine[8698] = StringToText("· 如果你在游戏中找到了僧侣，说服他每个夜晚都来保护你。通过这种方式，你能够公然声明自己的猎手角色，");
    g_tipLine[8699] = StringToText("  且知道恶魔晚上没办法杀你。只要僧侣活着，你就知道你明天永远会活着，因此不必有\"今天一定要把能力用掉\"的压力。");
    g_tipLine[8700] = StringToText("  如果僧侣在晚上死了，你就不再安全了；但是如果你在晚上死了可僧侣还活着，你也能知道那位玩家其实并不是僧侣。");
    g_tipLine[8701] = StringToText("· 你的能力对陌客也有效，因为陌客可能被当作恶魔。如果你的目标死亡，并且声称自己是陌客，");
    g_tipLine[8702] = StringToText("  他就可能真是陌客……当然也有可能他就是恶魔，同时场上的红唇女郎已经变成了新的恶魔。");
    g_tipLine[8703] = StringToText("· 注意小恶魔可能会在整场游戏中变更玩家。如果你在游戏前期对爪牙使用能力，什么都不会发生，");
    g_tipLine[8704] = StringToText("  但是这名玩家在最后一天可能就是小恶魔。");
    g_tipRoleAt[10] = 8649; g_tipRoleN[10] = 56; g_tipP1At[10] = 8651; g_tipP1N[10] = 10; g_tipP2At[10] = 8679; g_tipP2N[10] = 3;
    g_tipAbility[10] = StringToText("每局游戏限一次，你可以在白天时公开选择一名玩家：如果他是恶魔，他死亡。");
    g_tipLine[8705] = StringToText("【背景故事】");
    g_tipLine[8706] = StringToText("「就像大卫对歌利亚所说，");
    g_tipLine[8707] = StringToText("像忒修斯对米诺陶所说，");
    g_tipLine[8708] = StringToText("也像阿周那对福授所说的那样……");
    g_tipLine[8709] = StringToText("绝不。」");
    g_tipLine[8710] = StringToText("【角色能力】");
    g_tipLine[8711] = StringToText("恶魔的负面能力对你无效。");
    g_tipLine[8712] = StringToText("【角色简介】");
    g_tipLine[8713] = StringToText("士兵无法被恶魔杀死。");
    g_tipLine[8714] = StringToText("· 士兵无法因为恶魔的能力而死去。因此，如果小恶魔在夜晚攻击士兵，无事发生。没有任何人会死亡。");
    g_tipLine[8715] = StringToText("  小恶魔也不能再去选择攻击另外一名玩家。");
    g_tipLine[8716] = StringToText("· 即使发起提名的玩家是恶魔，士兵仍然会因为处决而死亡。士兵的能力会保护自己不被恶魔的能力杀死，");
    g_tipLine[8717] = StringToText("  但无法保护自己被恶魔玩家的其他行为杀死。");
    g_tipLine[8718] = StringToText("【范例】");
    g_tipLine[8719] = StringToText("小恶魔攻击了士兵。士兵没有死亡，因此当晚无人死亡。");
    g_tipLine[8720] = StringToText("投毒者让士兵中毒，然后小恶魔攻击了士兵。士兵死亡，因为他在处于中毒状态时失去了能力。");
    g_tipLine[8721] = StringToText("小恶魔攻击了镇长。说书人选择由士兵来代替镇长死亡。然而，因为士兵无法被恶魔杀死，当晚无人死亡。");
    g_tipLine[8722] = StringToText("（备注：这个例子只是作为解释镇长的能力逻辑用，在实际游戏中，你很少会遇到需要非得士兵或者是其他无法死去的玩家代替");
    g_tipLine[8723] = StringToText("  镇长死亡的情况，因此通过镇长的能力造成夜晚无人死亡的操作不建议频繁发生。具体可以看镇长条目下「运作方式」");
    g_tipLine[8724] = StringToText("  里的设计师建议）");
    g_tipLine[8725] = StringToText("【运作方式】");
    g_tipLine[8726] = StringToText("在夜晚时，如果恶魔攻击了士兵，士兵仍然存活。（在黎明时，宣布当晚没有人死亡。）");
    g_tipLine[8727] = StringToText("在其他剧本中，恶魔可能会拥有除杀死以外的其他能力。士兵的保护能力同样可以阻止恶魔的其他有害效果，");
    g_tipLine[8728] = StringToText("  例如让士兵中毒或将士兵转变为邪恶阵营。");
    g_tipLine[8729] = StringToText("【提示标记】");
    g_tipLine[8730] = StringToText("无");
    g_tipLine[8731] = StringToText("【规则细节】");
    g_tipLine[8732] = StringToText("· 与僧侣的能力相似，士兵能够免疫的有害效果包括：死亡，醉酒，中毒，疯狂，阵营变化，");
    g_tipLine[8733] = StringToText("  来自与自身阵营不同的恶魔对他进行的角色变化，等等。");
    g_tipLine[8734] = StringToText("· 士兵无法免疫的效果包括：来自与该玩家（保护目标）阵营相同的恶魔对他进行的角色变化，照看小怪宝，");
    g_tipLine[8735] = StringToText("  成为痢蛭的寄生对象（只会让士兵免疫中毒，但痢蛭的免死能力还是会与士兵绑定），等等。");
    g_tipLine[8736] = StringToText("· 相克规则：");
    g_tipLine[8737] = StringToText("  · 利维坦：如果利维坦提名并处决了士兵，善良阵营获胜。");
    g_tipLine[8738] = StringToText("  · 暴乱：如果暴乱提名并处决了士兵，善良阵营获胜。");
    g_tipLine[8739] = StringToText("【提示与技巧】");
    g_tipLine[8740] = StringToText("· 如果恶魔攻击了你，这个夜晚就没人会死。这有两点好处。第一，因为今晚没有玩家死亡，");
    g_tipLine[8741] = StringToText("  场上存活玩家会比正常情况下要多一些，这就给了善良阵营玩家更多可以处决的轮次。第二，");
    g_tipLine[8742] = StringToText("  没有玩家死亡会支持你的\"我是个士兵\"这一声明。为了让恶魔选你作为目标，你可以伪装成更诱人的角色，比如占卜师，");
    g_tipLine[8743] = StringToText("  送葬者，共情者或者猎手。");
    g_tipLine[8744] = StringToText("· 在游戏的最后一天，如果你能证明你是士兵，善良阵营将会有巨大的优势。你将会让大家从多选题里排除一个错误选项。");
    g_tipLine[8745] = StringToText("  让共情者或者占卜师来证实你不是恶魔会非常有帮助。");
    g_tipLine[8746] = StringToText("· 一个聪明的恶魔在第一次杀不掉你之后就不会再攻击你了，除非他想到了能杀你的方法。");
    g_tipLine[8747] = StringToText("  如果你能让恶魔相信其实昨晚是僧侣保护了你，那恶魔就有可能再攻击你一次。");
    g_tipLine[8748] = StringToText("· 如果你不确定一位玩家是善良还是邪恶，允许那些能获取大量信息的角色伪装成你。这样，恶魔就更容易攻击你，");
    g_tipLine[8749] = StringToText("  而不是攻击他。你甚至可以和一些玩家秘密地交流，并且互相声明自己是对方的角色，");
    g_tipLine[8750] = StringToText("  这样你就能够把他获得的信息公布给大家，并且保证他还活着。");
    g_tipLine[8751] = StringToText("· 如果你在晚上死了，要么你是被投毒者下毒了，要么你根本就是个酒鬼。这是个重大新闻，会对团队非常有帮助。");
    g_tipLine[8752] = StringToText("  如果你中毒了，就表示投毒者还活着（在只有一个爪牙的对局中，你就能知道场上到底存在的是哪个爪牙了！），");
    g_tipLine[8753] = StringToText("  这也能让你推断出已死亡玩家的阵营。如果你是酒鬼，那其他人就不能是酒鬼了。不论怎样，你都会知道一些有用的信息。");
    g_tipLine[8754] = StringToText("· 你还是需要在游戏中适时告诉大家你是士兵，而不是一直伪装到底。毕竟，善良玩家会需要尽可能多的信息。");
    g_tipLine[8755] = StringToText("· 如果你没有告诉任何人你是士兵，并且活到了最后一天，每天晚上都有人会死，那就很有可能有间谍在场，");
    g_tipLine[8756] = StringToText("  并且他一直在告诉恶魔要去杀谁。");
    g_tipRoleAt[11] = 8705; g_tipRoleN[11] = 52; g_tipP1At[11] = 8710; g_tipP1N[11] = 8; g_tipP2At[11] = 8731; g_tipP2N[11] = 8;
    g_tipAbility[11] = StringToText("恶魔的负面能力对你无效。");
    g_tipLine[8757] = StringToText("【背景故事】");
    g_tipLine[8758] = StringToText("「我们必须抛开分歧，停止这种毫无意义的杀戮。");
    g_tipLine[8759] = StringToText("毕竟，我们都是纳税人。嗯，我是说我们中的绝大多数。」");
    g_tipLine[8760] = StringToText("【角色能力】");
    g_tipLine[8761] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。");
    g_tipLine[8762] = StringToText("如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipLine[8763] = StringToText("【角色简介】");
    g_tipLine[8764] = StringToText("镇长可以在最后一天通过和平的方式获得胜利。");
    g_tipLine[8765] = StringToText("· 为了生存，镇长偶尔会让其他玩家「意外地」被杀死。如果镇长被攻击且即将死去时，说书人可以选择另一名玩家死亡。");
    g_tipLine[8766] = StringToText("  没有人会得知该玩家的死亡原因，仅仅只是得知该玩家死亡了。");
    g_tipLine[8767] = StringToText("· 如果在某个白天结束时只有三名玩家存活，并且那个白天没有人被处决，那么游戏结束且善良阵营获胜。");
    g_tipLine[8768] = StringToText("· 旅行者的数量也会被计入镇长的胜利条件中，因此他们必须先被流放。请记住流放并不是处决。（译注：");
    g_tipLine[8769] = StringToText("  如果场上有旅行者且包含旅行者在内的存活玩家只有三名，显然此时已经达成了邪恶阵营的胜利条件。因此如果游戏还未结束，");
    g_tipLine[8770] = StringToText("  说明场上至少还有三名非旅行者玩家，此时需要先对旅行者进行流放才能满足镇长的胜利条件。）");
    g_tipLine[8771] = StringToText("· 传奇角色的数量不会被计入镇长的胜利条件中，因为说书人不是一名玩家。");
    g_tipLine[8772] = StringToText("· 如果恶魔攻击了镇长，且说书人选择了一名已死亡玩家、士兵或被僧侣保护的玩家作为替代，则当晚不会有玩家死亡。");
    g_tipLine[8773] = StringToText("  （但这种情况不建议频繁发生）");
    g_tipLine[8774] = StringToText("【范例】");
    g_tipLine[8775] = StringToText("小恶魔攻击了镇长。说书人选择由守鸦人代替镇长死亡。下一个白天，只有三名玩家存活。当天没有任何人为处决而发起提名。");
    g_tipLine[8776] = StringToText("  善良阵营获胜。");
    g_tipLine[8777] = StringToText("包含两名旅行者在内的五名玩家存活。两名旅行者都被流放了，并且剩余玩家的处决投票数量打平。");
    g_tipLine[8778] = StringToText("  因为投票数量打平意味着这些玩家都不会被处决，善良阵营获胜。");
    g_tipLine[8779] = StringToText("【运作方式】");
    g_tipLine[8780] = StringToText("在夜晚时，如果镇长即将死去，由你来选择镇长会真正死去，或是镇长仍然存活但有其他角色代替他死亡——将恶魔的「死亡」");
    g_tipLine[8781] = StringToText("  提示标记放置在镇长或代替镇长死亡的角色标记旁，并在对应的角色标记上放置帷幕标记。");
    g_tipLine[8782] = StringToText("在黎明时，宣布被标记了「死亡」标记的玩家在当晚死亡。（不要说出他的死亡原因。）");
    g_tipLine[8783] = StringToText("在黄昏时，如果正好有三名玩家存活，且当天没有玩家被处决，宣布游戏结束且善良阵营获胜。（注：");
    g_tipLine[8784] = StringToText("  即使宣布胜利的时机是在黄昏，但镇长的能力有效与否是在处决阶段结算的）");
    g_tipLine[8785] = StringToText("我们建议你让镇长活到最后一天，因为这种方式对玩家来说会更加有趣。在罕见的情形下，如果游戏早期时，");
    g_tipLine[8786] = StringToText("  镇长便在玩家群体中以压倒性的优势让大家认为自己是镇长，那么让镇长在被恶魔攻击时死去，以使得邪恶玩家仍有机会获胜。");
    g_tipLine[8787] = StringToText("在《暗流涌动》里，镇长的能力描述中「你的阵营获胜」始终意味着「善良阵营获胜」，因为镇长始终会是善良角色。");
    g_tipLine[8788] = StringToText("  在其他剧本中，如果出现了邪恶的镇长，他的能力意味着「邪恶阵营获胜」。");
    g_tipLine[8789] = StringToText("【提示标记】");
    g_tipLine[8790] = StringToText("无");
    g_tipLine[8791] = StringToText("【规则细节】");
    g_tipLine[8792] = StringToText("· 如果镇长的替死能力被触发，代替镇长死亡的角色，其死亡原因会与镇长保持一致。也就是说，");
    g_tipLine[8793] = StringToText("  如果恶魔攻击了镇长且贤者代替了镇长死亡，贤者能够触发他的能力。在判断那些死亡触发能力的角色的死亡原因时，");
    g_tipLine[8794] = StringToText("  这一点会显得比较重要。");
    g_tipLine[8795] = StringToText("· 同样地，在造成死亡的这个能力中，代替镇长死亡的角色会被当作选中为该能力的目标。原本这项能力是选择镇长并生效的，");
    g_tipLine[8796] = StringToText("  改为选择「代替镇长死亡的目标」并生效（不论这项选择是能力所属的玩家做出的还是说书人做出的）。也就是说，");
    g_tipLine[8797] = StringToText("  如果月之子选择了镇长而说书人想要通过镇长的能力改为「让一名邪恶玩家代替镇长死亡」，这会导致在能力实际生效时，");
    g_tipLine[8798] = StringToText("  被当作「月之子在白天选中了那名邪恶玩家」而导致不满足回溯条件，从而使得月之子无法通过能力杀死任何玩家。");
    g_tipLine[8799] = StringToText("  这虽然是可行的，但镇长能力的触发选择权在说书人，过于复杂的互动方式会让玩家难以理解，");
    g_tipLine[8800] = StringToText("  且结果并不一定会容易被所有玩家接受，不如参考镇长词条运作方式中的建议。");
    g_tipLine[8801] = StringToText("  此外镇长死在月之子手里和被大家当作邪恶玩家并死于处决其实结果并无区别，说书人应该考虑更为简单的处理方式。");
    g_tipLine[8802] = StringToText("· 虽然镇长的特殊胜利在黄昏时宣布，但镇长的特殊胜利能力触发是在白天，");
    g_tipLine[8803] = StringToText("  因此投毒者或者其他能让镇长醉酒或中毒的角色仍然会阻止镇长因为自己的能力而以特殊方式获胜。");
    g_tipLine[8804] = StringToText("· 特定角色互动：");
    g_tipLine[8805] = StringToText("  · 数学家：在镇长因为失去能力或其他效果影响下无法触发「代替死亡」能力时，对于数学家获取的信息，可以+1或不变。");
    g_tipLine[8806] = StringToText("    这是由于镇长需要触发能力才能检测到能力未生效从而被数学家得知，而镇长的能力触发取决于说书人。通常来说，");
    g_tipLine[8807] = StringToText("    为了避免造成不必要的混乱，对于这类触发与否由说书人决定的能力，应该尽量以不变来告知数学家。但特殊情况下，");
    g_tipLine[8808] = StringToText("    如果这能避免玩家过早发现恶魔，那么可以视情况决定给出什么样的信息。");
    g_tipLine[8809] = StringToText("· 相克规则：");
    g_tipLine[8810] = StringToText("  · 利维坦：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。（即使镇长是邪恶阵营也是如此。）");
    g_tipLine[8811] = StringToText("  · 暴乱：镇长可以停止暴乱的提名链。如果他这样做了，并且场上只有一名暴乱存活，善良阵营获胜；否则，邪恶阵营获胜。");
    g_tipLine[8812] = StringToText("【提示与技巧】");
    g_tipLine[8813] = StringToText("· 你的能力在最后一天仅剩三名玩家时生效。你可能不知道谁是恶魔，但你能够通过让场上不发生处决来保证胜利。");
    g_tipLine[8814] = StringToText("  尽全力说服大家相信你是镇长。如果善良阵营相信你，他们要么根本不提名任何人，");
    g_tipLine[8815] = StringToText("  要么就会故意达成平票来保证没有处决的发生。");
    g_tipLine[8816] = StringToText("· 不到游戏的最后，你最好都不要表明自己的镇长角色。如果你暴露的太早，恶魔就会用很多夜晚来尝试杀死你，");
    g_tipLine[8817] = StringToText("  说书人也许就会让这种尝试成功。或者你可以在前期秘密告诉一到两名玩家你是镇长，到游戏最后一天再告诉剩余玩家，");
    g_tipLine[8818] = StringToText("  这样你就会更容易被人相信。");
    g_tipLine[8819] = StringToText("· 如果一个不那么容易被当成恶魔目标的角色死亡（例如管家），这就意味着你可能才是恶魔的攻击目标。");
    g_tipLine[8820] = StringToText("  你可以通过这一点作为证据来向其他玩家证明你是镇长。");
    g_tipLine[8821] = StringToText("· 一旦恶魔攻击了你并且其他人替你死亡，恶魔就会知道你是镇长。在每天早上刚开始的时候，");
    g_tipLine[8822] = StringToText("  如果某位玩家表现出惊讶或者疑惑，他大概率就是恶魔！");
    g_tipLine[8823] = StringToText("· 如果你要尝试通过不发生处决来赢得胜利，首先要确定你不是酒鬼。在游戏中多听其他玩家的发言，");
    g_tipLine[8824] = StringToText("  并且验证哪些外来者是真的。如果你认为酒鬼在场，你就得找到他是谁，因为如果你是酒鬼的话，即便最后一天没有发生处决，");
    g_tipLine[8825] = StringToText("  邪恶阵营也会胜利。同样的，如果仅剩的两名玩家为小恶魔和投毒者，你就肯定是那个会中毒的目标了。");
    g_tipLine[8826] = StringToText("  在触发你的镇长特殊胜利能力前，确保投毒者已经死了。");
    g_tipRoleAt[12] = 8757; g_tipRoleN[12] = 70; g_tipP1At[12] = 8760; g_tipP1N[12] = 14; g_tipP2At[12] = 8791; g_tipP2N[12] = 21;
    g_tipAbility[12] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipLine[8827] = StringToText("【背景故事】");
    g_tipLine[8828] = StringToText("「是的，先生……不对，先生……当然，先生。」");
    g_tipLine[8829] = StringToText("【角色能力】");
    g_tipLine[8830] = StringToText("每个夜晚，你要选择除你以外的一名玩家：明天白天，只有他投票时你才能投票。");
    g_tipLine[8831] = StringToText("【角色简介】");
    g_tipLine[8832] = StringToText("管家只能在他的主人投票时才能投票。");
    g_tipLine[8833] = StringToText("· 每个夜晚，管家需要选择一名玩家来成为自己的主人。这名玩家可以是与前一夜相同的，也可以是与前一夜不同的。");
    g_tipLine[8834] = StringToText("· 如果主人在投票时举手，或主人的投票已经被统计时，管家可以举手参与投票。");
    g_tipLine[8835] = StringToText("· 如果主人放下了他的手，表明他不参与投票，或在投票被统计前将手放下，管家也必须将自己的手放下。");
    g_tipLine[8836] = StringToText("· 说书人没有监视管家的责任。管家需要为自己的投票负责。管家在不应该投票的场合下故意投票会被视为作弊。");
    g_tipLine[8837] = StringToText("· 因为角色能力不能以任何形式影响流放流程，管家可以在流放表决中自由参与表决。");
    g_tipLine[8838] = StringToText("· 已死亡的玩家只能在拥有投票标记时才能举手投票。如果管家选择了一名已死亡玩家作为主人，这种情况仍然适用。");
    g_tipLine[8839] = StringToText("· 管家的能力从不会被强制必须投票。");
    g_tipLine[8840] = StringToText("· 管家的投票可以在他主人之前或之后被说书人计票。座次顺序并不重要。");
    g_tipLine[8841] = StringToText("【范例】");
    g_tipLine[8842] = StringToText("管家选择小黑成为他的主人。明天，如果小黑在一次处决中举手投票了，那么管家也可以一同参与投票。否则，");
    g_tipLine[8843] = StringToText("  管家无法举手投票。");
    g_tipLine[8844] = StringToText("当前正处于一次提名的流程中。管家和他的主人一同举手投票。轮到说书人开始计票时，");
    g_tipLine[8845] = StringToText("  管家的主人在最后一秒放下了自己的手。管家此时也必须立刻放下自己的手。");
    g_tipLine[8846] = StringToText("管家死了。因为死亡的玩家没有任何能力，因此管家可以使用他的投票标记在任何时候投票。");
    g_tipLine[8847] = StringToText("【运作方式】");
    g_tipLine[8848] = StringToText("每个夜晚，唤醒管家。让管家指向除自己外的任意一名玩家。用「主人」提示标记来标记这名玩家。让管家重新入睡。");
    g_tipLine[8849] = StringToText("在一次提名中，管家只能在主人举手投票，或主人的投票已经被统计时，才能举手投票。");
    g_tipLine[8850] = StringToText("如果管家不小心进行了违规投票，仍统计管家的票。因为如果不这么做，实际的总票数会比原本的总票数少，");
    g_tipLine[8851] = StringToText("  因此所有玩家都会知道谁是管家，这对邪恶阵营来说非常不公平。人总会犯错。继续进行游戏，并在稍后私下提示管家。");
    g_tipLine[8852] = StringToText("【提示标记】");
    g_tipLine[8853] = StringToText("· 主人");
    g_tipLine[8854] = StringToText("放置时机：在管家夜晚行动并选择了玩家后。");
    g_tipLine[8855] = StringToText("放置条件：在管家选择的玩家角色标记旁放置。管家无法选择自己。若此时管家醉酒中毒，不放置该标记。");
    g_tipLine[8856] = StringToText("移除时机：在黄昏时，或管家死亡或离场时。");
    g_tipLine[8857] = StringToText("【规则细节】");
    g_tipLine[8858] = StringToText("· 即使管家作弊投票，他的票也仍然会被统计并且有效。管家不应该，也无法用这种方式来证明自己是管家。");
    g_tipLine[8859] = StringToText("· 对于管家的作弊行为，不要以「不好的事」来进行处罚，因为这样会导致游戏产生相对于正常情况的额外信息，");
    g_tipLine[8860] = StringToText("  这不利于玩家进行推理分析。「被视为作弊」其实更多地是一种基于社交上的措辞，");
    g_tipLine[8861] = StringToText("  是对于玩家不遵守游戏规则的一种客观的表达，但并不意味着作弊的玩家需要在游戏中受到处罚。如果真的有作弊的现象发生，");
    g_tipLine[8862] = StringToText("  那么跟这位玩家在游戏结束后私下好好谈谈吧。");
    g_tipLine[8863] = StringToText("· 对于轮盘计票方式中，主人坐在管家下家的情况而导致管家可能无法参与投票的情况，有以下几种建议：");
    g_tipLine[8864] = StringToText("  · 提倡玩家养成提前举手的习惯。因为即使提前举手，也会在说书人的手指向某个玩家时，才会计算该玩家的票，");
    g_tipLine[8865] = StringToText("    提前举手也会成为一些谈判和背叛的策略。在这种情况下，如果主人提前举手了，管家自然就能正常举手且不算做作弊。");
    g_tipLine[8866] = StringToText("    即使管家的投票被说书人统计后主人在自己的票被统计之前又把手放下，管家的票依然会被计算且不算作弊。");
    g_tipLine[8867] = StringToText("  · 对于线上游戏，很难在短时间内观察主人的举手情况并做出反馈时，建议以以下方式进行互动：");
    g_tipLine[8868] = StringToText("    管家玩家可以在交流阶段公开声明自己是管家，并询问主人自己可以参与针对哪些玩家的提名投票，向主人寻求建议。");
    g_tipLine[8869] = StringToText("· 相克规则：");
    g_tipLine[8870] = StringToText("  · 食人族：如果食人族获得了管家的能力，他会得知这一信息。");
    g_tipLine[8871] = StringToText("  · 街头风琴手：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，但只在他的主人投票时他的票才会被统计。");
    g_tipLine[8872] = StringToText("【提示与技巧】");
    g_tipLine[8873] = StringToText("· 被你选为\"主人\"的那名玩家非常重要。你的投票依然按照正常的投票计数，只不过在你的主人不举手的情况下你不能投票。");
    g_tipLine[8874] = StringToText("  既然如此，你就需要仔细听场上玩家的发言，并且找出哪些玩家是善良阵营的。如果你的主人是邪恶的，");
    g_tipLine[8875] = StringToText("  你就只能在一些没用的时候投票。如果你的主人是善良的，你就可以投出有意义的一票。找到一个善良的主人，");
    g_tipLine[8876] = StringToText("  然后紧紧跟随他。");
    g_tipLine[8877] = StringToText("· 如果你告诉你的主人你选择了他，他在投票时基本就会默认你也会跟着投。");
    g_tipLine[8878] = StringToText("  观察你的主人在何时希望你投票能够让你发现一些细节，帮助你判断他到底是善良的还是邪恶的。");
    g_tipLine[8879] = StringToText("  一个邪恶阵营的主人可能会鼓动你去投一个看起来比较可信的玩家。");
    g_tipLine[8880] = StringToText("· 你的主人不投票，你就不可以投票，但是这不意味着在他投票时你必须投票。记得只去投那些你认为是邪恶阵营的玩家，");
    g_tipLine[8881] = StringToText("  或者是值得你投出一票的人。");
    g_tipLine[8882] = StringToText("· 被你选做主人的玩家通常是会相信你的，他也会希望你保持存活。毕竟，你也是他权力中的一部分。");
    g_tipLine[8883] = StringToText("  帮你活下来能让他获得最大的利益，因此如果有人要提名你，这个时候建立起来的信任就会帮助到你。");
    g_tipLine[8884] = StringToText("· 你可以选择一名死亡玩家作为你的主人。但是要小心一点——因为死亡玩家仅剩一票可用了，他可能暂时不会用这一票，");
    g_tipLine[8885] = StringToText("  这意味着你可能根本就没机会投票。");
    g_tipLine[8886] = StringToText("· 如果其他玩家认为你是邪恶玩家，并且想要处决你，你通常能够通过承诺晚上去做他的管家来赢得他的信任。");
    g_tipLine[8887] = StringToText("  如果你让他今天不要提名你，并且答应在今晚选他做你的主人，对方经常是会同意并且让你保持存活的。");
    g_tipRoleAt[13] = 8827; g_tipRoleN[13] = 61; g_tipP1At[13] = 8829; g_tipP1N[13] = 12; g_tipP2At[13] = 8857; g_tipP2N[13] = 15;
    g_tipAbility[13] = StringToText("每个夜晚，你要选择除你以外的一名玩家：明天白天，只有他投票时你才能投票。");
    g_tipLine[8888] = StringToText("【背景故事】");
    g_tipLine[8889] = StringToText("「我是个只在社交场合里~嗝儿~喝酒的人，亲爱的。");
    g_tipLine[8890] = StringToText("但无可否认，我是一个非常~嗝儿~擅长社交的人。」");
    g_tipLine[8891] = StringToText("（英文维基上的背景描述与角色详解中的不同，此处也一并贴出。见下）");
    g_tipLine[8892] = StringToText("「这完全合乎~嗝儿~逻辑。我知道的是狄亚哈特小姐是个占卜师。狄亚哈特夫人则发誓詹金斯是她的管家。");
    g_tipLine[8893] = StringToText("  得出这样的推论非常~嗝儿~简单。」");
    g_tipLine[8894] = StringToText("【角色能力】");
    g_tipLine[8895] = StringToText("你不知道你是酒鬼。你以为你是一个镇民角色，但其实你不是。");
    g_tipLine[8896] = StringToText("【角色简介】");
    g_tipLine[8897] = StringToText("酒鬼以为自己是镇民，且对自己实际上是酒鬼一事毫不知情。");
    g_tipLine[8898] = StringToText("· 在初始设置时，不会将酒鬼的角色标记放进盲抽袋中。作为替代，会有一个镇民的角色标记放进盲抽袋中，");
    g_tipLine[8899] = StringToText("  且抽到该角色标记的玩家会在整场游戏中秘密地成为酒鬼。说书人知道哪位镇民实际上是酒鬼，而酒鬼玩家无从得知。");
    g_tipLine[8900] = StringToText("· 酒鬼没有任何能力。不论他获得的镇民标记是否会以某些方式影响游戏，酒鬼却无法使用这一镇民能力。然而，");
    g_tipLine[8901] = StringToText("  说书人会装作酒鬼玩家是他以为的那种镇民。如果那个镇民会在夜晚醒来，酒鬼同样会被唤醒并如同那个镇民的方式进行行动。");
    g_tipLine[8902] = StringToText("  如果那个镇民能够获取信息，说书人可以对酒鬼给出错误的信息作为替代——我们也建议说书人这样去做。");
    g_tipLine[8903] = StringToText("【范例】");
    g_tipLine[8904] = StringToText("以为自己是士兵的酒鬼被小恶魔攻击。酒鬼死亡。");
    g_tipLine[8905] = StringToText("以为自己是共情者的酒鬼被唤醒并得知了「0」，即使他与一位邪恶玩家相邻。在下一夜，他得知了「1」。");
    g_tipLine[8906] = StringToText("以为自己是守鸦人的酒鬼在夜晚被杀死。他选择了圣徒，但得知这名玩家是投毒者。");
    g_tipLine[8907] = StringToText("占卜师被处决。在当晚，以为自己是送葬者的酒鬼，得知今天白天死亡的是酒鬼。");
    g_tipLine[8908] = StringToText("【运作方式】");
    g_tipLine[8909] = StringToText("在游戏设置时，将角色标记放进盲抽袋之前，移除酒鬼标记并添加一枚额外的镇民角色标记。将酒鬼的「是酒鬼」");
    g_tipLine[8910] = StringToText("  提示标记放置进魔典中。将用于替换的镇民角色标记放进盲抽袋中，而不是酒鬼的角色标记。");
    g_tipLine[8911] = StringToText("在为首个夜晚进行准备时，将酒鬼的「是酒鬼」提示标记放置在用于替换的那名镇民角色标记旁，");
    g_tipLine[8912] = StringToText("  用于提醒那名玩家的角色实际上是酒鬼。这名玩家现在是一名外来者，并且不再具有这个镇民的能力。");
    g_tipLine[8913] = StringToText("  （但他仍然以为自己是镇民。）");
    g_tipLine[8914] = StringToText("在游戏过程中，以酒鬼的镇民角色来让酒鬼进行行动。（如果那个角色会在夜里行动，唤醒酒鬼让他进行行动。");
    g_tipLine[8915] = StringToText("  如果镇民的能力会获取信息，若你愿意，你可以对酒鬼给出错误的信息。参考规则书中的「醉酒与中毒」部分。）");
    g_tipLine[8916] = StringToText("【提示标记】");
    g_tipLine[8917] = StringToText("· 是酒鬼");
    g_tipLine[8918] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[8919] = StringToText("放置条件：在将所有玩家的角色标记收回到魔典后，在其中一个镇民角色标记旁放置。");
    g_tipLine[8920] = StringToText("移除时机：酒鬼离场时。");
    g_tipLine[8921] = StringToText("【规则细节】");
    g_tipLine[8922] = StringToText("· 如果酒鬼醉酒或中毒，他不会有任何变化。属于认知覆盖类的能力不会因为醉酒或中毒失效。一旦玩家成为了酒鬼这个角色，");
    g_tipLine[8923] = StringToText("  玩家会始终认为自己是镇民（除非玩家通过推理分析得出自己实际上是酒鬼）。");
    g_tipLine[8924] = StringToText("· 认知覆盖类能力的角色只要还是这个角色，说书人就能对其进行合理的欺骗，");
    g_tipLine[8925] = StringToText("  但前提条件是需要让他持续认为自己是满足自己当前角色「认知范围」内的角色，且无法对「认知范围」以外的内容进行欺骗。");
    g_tipLine[8926] = StringToText("  例如，说书人无法欺骗一个未转变阵营的酒鬼说他的阵营发生了变化。但是，如果有邪恶玩家声称自己是农夫且在夜晚死亡，");
    g_tipLine[8927] = StringToText("  说书人能够欺骗酒鬼并告诉他他变成了农夫，因为农夫仍然是一个镇民角色，这满足酒鬼的「认知范围」。");
    g_tipLine[8928] = StringToText("· 特定角色互动：");
    g_tipLine[8929] = StringToText("  · 咖啡师：咖啡师的「清醒且健康」效果能够让能获取信息的酒鬼在生效期间内获得正确信息。");
    g_tipLine[8930] = StringToText("· 相克规则：");
    g_tipLine[8931] = StringToText("  · 数学家：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_tipLine[8932] = StringToText("  · 科学怪人：恶魔无法拥有酒鬼的能力。");
    g_tipLine[8933] = StringToText("【提示与技巧】");
    g_tipLine[8934] = StringToText("· 酒鬼永远不知道自己是酒鬼——他在游戏开始时就会获得一个镇民角色标记，在收到错误信息时也会表现得像个普通镇民一样。");
    g_tipLine[8935] = StringToText("  你只能在游戏进行过程中发现到底是不是酒鬼；如果你发现你收到了明显有误的信息，");
    g_tipLine[8936] = StringToText("  亦或是能力没有成功触发(例如士兵死于夜晚)，你就需要注意了。");
    g_tipLine[8937] = StringToText("· 确认酒鬼是否在场非常重要——这将让镇民知道是否需要仔细核对自己拿到的信息。");
    g_tipLine[8938] = StringToText("  一个最直观的用来确定场上是否有酒鬼的方法，就是看场上已知的外来者数量是否符合你的预期（如果比你想的多了，");
    g_tipLine[8939] = StringToText("  那场上可能存在男爵，而酒鬼也可能随之加入了游戏）。");
    g_tipLine[8940] = StringToText("· 如果你怀疑酒鬼在场，那就需要尽快找到哪位镇民是酒鬼。每局游戏中最多存在一个酒鬼，");
    g_tipLine[8941] = StringToText("  因此知道酒鬼是谁能让你更谨慎地对待他的信息，这也意味着其他镇民能够相信自己得到的信息是真实且可靠的。");
    g_tipLine[8942] = StringToText("· 像送葬者和守鸦人这样的角色，是可以查验到酒鬼的实际角色的。你不会被他们当作你以为的那个镇民！");
    g_tipLine[8943] = StringToText("  这对于像贞洁者这样的角色也同样适用——酒鬼不会触发贞洁者的能力，因为酒鬼不是镇民而是外来者。");
    g_tipLine[8944] = StringToText("· 如果你发现了你是酒鬼，尝试着逆向推理你所获取的信息。例如，如果你曾认为你是共情者并且获取到了信息\"0\"，");
    g_tipLine[8945] = StringToText("  你就要怀疑自己邻座中至少存在一名邪恶玩家。又或者，你曾以为自己是个调查员，");
    g_tipLine[8946] = StringToText("  你可以假设自己所得知的两名玩家都不是爪牙。");
    g_tipLine[8947] = StringToText("· 时刻记得酒鬼会收到的是不可靠的信息，而不是绝对错误的信息。在大多数情况下，你会收到错误的信息，");
    g_tipLine[8948] = StringToText("  但是说书人偶尔也会告诉你正确的信息。（例如，酒鬼守鸦人在死亡后选择查验自己的角色，说书人会告诉他，他是守鸦人。");
    g_tipLine[8949] = StringToText("  因为不论说其他什么答案，他都会意识到自己其实是个酒鬼。）当其他答案都能明显地证明你是个酒鬼时，");
    g_tipLine[8950] = StringToText("  说书人可能就会告诉你真的信息。");
    g_tipLine[8951] = StringToText("  · 然而，要记住像猎手、僧侣、镇长这样的角色，如果他们的真实角色是酒鬼的话，是无法影响游戏的。");
    g_tipLine[8952] = StringToText("    比如一个酒鬼猎手是无法杀死任何玩家的，他们的能力总是会无效。");
    g_tipRoleAt[14] = 8888; g_tipRoleN[14] = 65; g_tipP1At[14] = 8894; g_tipP1N[14] = 9; g_tipP2At[14] = 8921; g_tipP2N[14] = 12;
    g_tipAbility[14] = StringToText("你不知道你是酒鬼。你以为你是一个镇民角色，但其实你不是。");
    g_tipLine[8953] = StringToText("【背景故事】");
    g_tipLine[8954] = StringToText("「侬康康窝咦锅惹，咋锅就怼窝恁锅粗暴。介样叭行。麻绳添酒嘿料，泥滴燕绳恨舔没，窝这哈圆酿泥料！侬晓得伐！");
    g_tipLine[8955] = StringToText("  窝叭象载康岛泥鸟，辣过饿魔阔能揍载窝家边乱晃。呔！窝揍斯弄个以斯！」");
    g_tipLine[8956] = StringToText("【角色能力】");
    g_tipLine[8957] = StringToText("你可能会被当作邪恶阵营、爪牙角色或恶魔角色，即使你已死亡。");
    g_tipLine[8958] = StringToText("【角色简介】");
    g_tipLine[8959] = StringToText("陌客会看起来像是邪恶一员，但实际上是善良的。");
    g_tipLine[8960] = StringToText("· 任何时候要探查陌客的阵营时，由说书人来决定陌客被当作善良还是邪恶。");
    g_tipLine[8961] = StringToText("· 任何时候陌客被影响特定的爪牙或恶魔角色的能力选择时，由说书人来决定陌客是否会被当作某种特定的爪牙或是恶魔角色。");
    g_tipLine[8962] = StringToText("· 陌客能在同一个夜晚的不同能力中分别被当作善良或邪恶阵营，外来者、爪牙或恶魔角色。由说书人来选择最有趣的结果。");
    g_tipLine[8963] = StringToText("· 陌客在被当作特定的爪牙或恶魔角色时，不会获得这一角色的能力。例如，被当作投毒者的陌客无法在夜晚被唤醒，");
    g_tipLine[8964] = StringToText("  也无法让一名玩家中毒。");
    g_tipLine[8965] = StringToText("【范例】");
    g_tipLine[8966] = StringToText("猎手对陌客使用了自己的能力。说书人决定让陌客被当作小恶魔，因此陌客死亡。猎手认为他刚刚杀死了小恶魔。");
    g_tipLine[8967] = StringToText("坐在陌客与僧侣之间的共情者得知自己与一名邪恶玩家邻近。下一个夜晚，共情者得知与其邻近的玩家中没有邪恶玩家。");
    g_tipLine[8968] = StringToText("调查员得知，要么陌客是红唇女郎，要么圣徒是红唇女郎。");
    g_tipLine[8969] = StringToText("陌客被处决了。送葬者得知小恶魔被处决。");
    g_tipLine[8970] = StringToText("陌客坐在小恶魔与一名邪恶的旅行者之间。因为对厨师展示「2」这样的信息会过于暴露邪恶玩家，");
    g_tipLine[8971] = StringToText("  说书人改为给出厨师正确的信息——「0」。");
    g_tipLine[8972] = StringToText("【运作方式】");
    g_tipLine[8973] = StringToText("每当因游戏规则或角色能力的效果要探查或影响玩家的阵营或角色，且陌客因此被选中为目标时，");
    g_tipLine[8974] = StringToText("  由你决定陌客被当作哪种角色和哪种阵营。（做出任何合适的举动，例如展示一个邪恶角色标记，点头，给出手势，");
    g_tipLine[8975] = StringToText("  或允许一项通常只针对邪恶阵营，爪牙或恶魔角色的能力对陌客生效。）");
    g_tipLine[8976] = StringToText("【提示标记】");
    g_tipLine[8977] = StringToText("无");
    g_tipLine[8978] = StringToText("【规则细节】");
    g_tipLine[8979] = StringToText("· 陌客有很多「可以但不建议」的内容，希望各位说书人在有陌客在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[8980] = StringToText("· 陌客的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，");
    g_tipLine[8981] = StringToText("  那么陌客是有可能被当作「善良的恶魔」或者是「邪恶的陌客」的（如舞蛇人和食人族）。");
    g_tipLine[8982] = StringToText("· 相克规则：");
    g_tipLine[8983] = StringToText("  · 贤者：陌客可能会被贤者当作杀死他的恶魔。");
    g_tipLine[8984] = StringToText("  · 食人魔：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_tipLine[8985] = StringToText("【提示与技巧】");
    g_tipLine[8986] = StringToText("· 尽可能早地告诉所有人你是陌客。这样可以解释大多数玩家获得的错误信息，例如厨师、共情者或者调查员。");
    g_tipLine[8987] = StringToText("  类似占卜师和守鸦人这样能继续获得信息的玩家就知道不用选择你作为验证对象了。然而，即便大家知道你是陌客，");
    g_tipLine[8988] = StringToText("  他们也有可能想去处决你。");
    g_tipLine[8989] = StringToText("· 你也可以直到最后一天都对自己的角色闭口不谈。如果你能找出哪些其他玩家是外来者，");
    g_tipLine[8990] = StringToText("  或者你之前曾被误认为了哪些角色（但愿没有很多），这时你可能可以说服大家自己实际上是外来者。");
    g_tipLine[8991] = StringToText("  因为善良阵营玩家经常会想要去杀死陌客，但从整体上来看这并不会给团队带来增益，");
    g_tipLine[8992] = StringToText("  因此保持存活从某种意义上说也是在帮助队伍获胜。");
    g_tipLine[8993] = StringToText("· 你通常会被当作邪恶玩家——留意那些说你是善良角色的人。如果你挨着共情者坐但是他说他两侧都是善良玩家，");
    g_tipLine[8994] = StringToText("  或是占卜师说你不是恶魔，他们都有可能是在说谎，因为他们是邪恶阵营的。");
    g_tipLine[8995] = StringToText("· 别被猎杀了！如果猎手选择你，他通常是能够杀死你的，这样会让你看起来像个恶魔且红唇女郎在场。这对团队没有帮助，");
    g_tipLine[8996] = StringToText("  因此需要极力避免。同样也要避免被处决，因为送葬者通常会把你认作爪牙或恶魔，这会让善良阵营更加迷惑。");
    g_tipLine[8997] = StringToText("· 被当作邪恶阵营有时候也会有些帮助。说你是邪恶阵营玩家的那个人通常会被大家所信任，");
    g_tipLine[8998] = StringToText("  厨师或是共情者的信息将有助于你找到其他邪恶玩家...如果你能说服大家相信你实际上并非邪恶阵营的话。");
    g_tipLine[8999] = StringToText("· 如果其他玩家极其怀疑你，并且非常想处决你，在最后一天来临之前你最好坦然接受你的命运。");
    g_tipLine[9000] = StringToText("  你甚至可以给自己投出一票来确保自己被处决。如果大家认为你是邪恶的，死在最后一天之前至少能够确认你不是恶魔，");
    g_tipLine[9001] = StringToText("  并让善良阵营的注意力转移到其他玩家身上。死在倒数第二天也是安全的，但死在最后一天也就意味着你输了。");
    g_tipRoleAt[15] = 8953; g_tipRoleN[15] = 49; g_tipP1At[15] = 8956; g_tipP1N[15] = 9; g_tipP2At[15] = 8978; g_tipP2N[15] = 7;
    g_tipAbility[15] = StringToText("你可能会被当作邪恶阵营、爪牙角色或恶魔角色，即使你已死亡。");
    g_tipLine[9002] = StringToText("【背景故事】");
    g_tipLine[9003] = StringToText("「智慧带来和平。耐心孕育智慧。");
    g_tipLine[9004] = StringToText("无需惧怕，因为恐惧消散的那一天终将到来。");
    g_tipLine[9005] = StringToText("让我们一同祈祷，愿我们愿景一致，共赴圣洁。」");
    g_tipLine[9006] = StringToText("【角色能力】");
    g_tipLine[9007] = StringToText("如果你死于处决，你的阵营落败。");
    g_tipLine[9008] = StringToText("【角色简介】");
    g_tipLine[9009] = StringToText("圣徒在被处决时会导致游戏结束。");
    g_tipLine[9010] = StringToText("· 如果圣徒因处决而死亡，游戏结束。善良阵营落败，邪恶阵营获胜。");
    g_tipLine[9011] = StringToText("· 如果圣徒因处决以外的任何方式死亡——例如被恶魔杀死——游戏仍会继续。");
    g_tipLine[9012] = StringToText("【范例】");
    g_tipLine[9013] = StringToText("有七名玩家存活，且正处于提名流程中。圣徒获得了四票，即将被处决。紧接着，男爵被提名但仅获得了三票。");
    g_tipLine[9014] = StringToText("  没有其他的提名出现。圣徒被处决，且邪恶阵营获胜。");
    g_tipLine[9015] = StringToText("小恶魔被提名，玩家们纷纷投票。枪手杀死了参与投票的圣徒。圣徒死亡，但游戏继续。");
    g_tipLine[9016] = StringToText("圣徒被处决。然而，替罪羊的能力被触发，因此替罪羊代替圣徒被处决。游戏继续，因为圣徒没有死亡。");
    g_tipLine[9017] = StringToText("【运作方式】");
    g_tipLine[9018] = StringToText("如果圣徒因处决而死亡，宣布游戏结束且邪恶阵营获胜。");
    g_tipLine[9019] = StringToText("圣徒的能力中有特定的描述「你的阵营落败」。在《暗流涌动》里，这始终意味着「邪恶阵营获胜」，");
    g_tipLine[9020] = StringToText("  因为圣徒始终会是善良角色。在其他剧本中，可能会让角色改变阵营。如果一名邪恶的圣徒被处决，善良阵营获胜。");
    g_tipLine[9021] = StringToText("【提示标记】");
    g_tipLine[9022] = StringToText("无");
    g_tipLine[9023] = StringToText("【规则细节】");
    g_tipLine[9024] = StringToText("· 特定角色互动：");
    g_tipLine[9025] = StringToText("  · 小怪宝：照看小怪宝的圣徒如果作为场上最后一名存活的恶魔被处决，善良阵营会获胜。");
    g_tipLine[9026] = StringToText("【提示与技巧】");
    g_tipLine[9027] = StringToText("· 如果你死于处决，游戏结束，你的阵营失败。保证善良阵营知道你是圣徒！你可以在大街上喊！站在屋顶喊！");
    g_tipLine[9028] = StringToText("  告诉所有人你是圣徒！你必须被认为是个善良玩家，要不就完了。如果你被提名了，");
    g_tipLine[9029] = StringToText("  一定要大声喊出自己是圣徒……游戏的结局如何就看此时了。");
    g_tipLine[9030] = StringToText("· 为了证明你是善良角色，你可以找其他善良玩家来查验你。杀死你和共情者之间的玩家可以让共情者得知你的阵营。");
    g_tipLine[9031] = StringToText("  说服占卜师在晚上选择你来证明你不是恶魔。找到守鸦人让他选择你来确认你的角色。让猎手尝试击杀你。");
    g_tipLine[9032] = StringToText("  恶魔通常在晚上不会想杀你，因此经常会有人问你的真实角色是什么。这时有几个能帮你作证的玩家将至关重要。");
    g_tipLine[9033] = StringToText("· 还有另一种方法，你可以保持沉默或者伪装成一个对恶魔来说非常有吸引力的目标，像猎手或是僧侣。如果你在晚上死了，");
    g_tipLine[9034] = StringToText("  你就能够规避掉白天被善良阵营意外处决的风险。");
    g_tipLine[9035] = StringToText("· 找出场上存在哪些外来者。如果本来应该有两名外来者在场，且只有你和陌客表露了自己是外来者，");
    g_tipLine[9036] = StringToText("  这种情况下即使你俩看起来都有点可疑，但善良阵营应该会相信你们都是善良玩家，因为外来者数量刚好能对得上。");
    g_tipRoleAt[16] = 9002; g_tipRoleN[16] = 35; g_tipP1At[16] = 9006; g_tipP1N[16] = 6; g_tipP2At[16] = 9023; g_tipP2N[16] = 3;
    g_tipAbility[16] = StringToText("如果你死于处决，你的阵营落败。");
    g_tipLine[9037] = StringToText("【背景故事】");
    g_tipLine[9038] = StringToText("「将α化合物加入到β化合物中……");
    g_tipLine[9039] = StringToText("别！太！多！」");
    g_tipLine[9040] = StringToText("【角色能力】");
    g_tipLine[9041] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipLine[9042] = StringToText("【角色简介】");
    g_tipLine[9043] = StringToText("投毒者能秘密地干扰其他角色的能力。");
    g_tipLine[9044] = StringToText("· 每个夜晚，投毒者会选择一名玩家在当晚的剩余时间和接下来的一整个白天阶段里中毒。");
    g_tipLine[9045] = StringToText("· 中毒的玩家会失去能力，但说书人会装作他仍具有能力。他的能力不会真实地影响游戏。");
    g_tipLine[9046] = StringToText("  为了保证中毒的玩家处于未中毒的幻象中，说书人会在正确的时间下唤醒他，并如同他未中毒一样走过场来执行他的能力。");
    g_tipLine[9047] = StringToText("  如果中毒玩家的角色能力能够获取信息，说书人可以给他提供错误信息。");
    g_tipLine[9048] = StringToText("· 如果一名中毒的玩家在他中毒的期间里使用了「每局游戏限一次」的能力，他无法再次使用这项能力。");
    g_tipLine[9049] = StringToText("【范例】");
    g_tipLine[9050] = StringToText("在夜晚时，投毒者让猎手中毒。在下一个白天里，猎手尝试杀死小恶魔。无事发生。猎手现在失去能力。");
    g_tipLine[9051] = StringToText("坐在两名邪恶玩家之间的中毒的共情者得知了「0」。下一个夜晚，不再中毒的共情者得知了正确的信息：「2」。");
    g_tipLine[9052] = StringToText("调查员中毒了。他得知两名玩家中一人是男爵，虽然这两人都不是爪牙。（或者调查员可能会得知正确的爪牙玩家，");
    g_tipLine[9053] = StringToText("  但得知错误的爪牙角色。）");
    g_tipLine[9054] = StringToText("送葬者中毒了。送葬者得知了贞洁者死亡，虽然今天死去的是小恶魔。几天后，一名中毒的圣徒被处决，但游戏继续。");
    g_tipLine[9055] = StringToText("投毒者让镇长中毒，然后变成了小恶魔。镇长不再中毒，因为投毒者这个角色已经不在场了。");
    g_tipLine[9056] = StringToText("【运作方式】");
    g_tipLine[9057] = StringToText("每个夜晚，唤醒投毒者。让投毒者指向任意一名玩家。被选择的玩家中毒——将「中毒」");
    g_tipLine[9058] = StringToText("  提示标记放置在被选择的玩家角色标记旁。让投毒者重新入睡。（这名中毒的玩家会照常被唤醒并行动。他失去了能力，");
    g_tipLine[9059] = StringToText("  但他认为自己还拥有能力。如果他的能力会获取信息，你可以按你的意愿来给出错误的信息。参考规则书中的「醉酒与中毒」");
    g_tipLine[9060] = StringToText("  部分。）");
    g_tipLine[9061] = StringToText("每到黄昏时，中毒玩家会恢复健康——移除他的中毒提示标记。");
    g_tipLine[9062] = StringToText("【提示标记】");
    g_tipLine[9063] = StringToText("· 中毒");
    g_tipLine[9064] = StringToText("放置时机：在投毒者夜晚行动并选择了玩家后。");
    g_tipLine[9065] = StringToText("放置条件：在投毒者选择的玩家角色标记旁放置。若此时投毒者醉酒中毒，不放置该标记。");
    g_tipLine[9066] = StringToText("移除时机：白天阶段结束时，或投毒者死亡或离场时。");
    g_tipLine[9067] = StringToText("【规则细节】");
    g_tipLine[9068] = StringToText("· 虽然投毒者的能力描述中，中毒的持续时间看似与水手和旅店老板等有所差别，但实际上这只是为了新手玩家便于理解，");
    g_tipLine[9069] = StringToText("  而不用特意引出「黄昏」这个概念。实际上，投毒者的能力描述同样可以写为：「每个夜晚，你要选择一名玩家：");
    g_tipLine[9070] = StringToText("  他会中毒到下个黄昏。」");
    g_tipLine[9071] = StringToText("【提示与技巧】");
    g_tipLine[9072] = StringToText("· 确定你要下毒的目标非常重要。如果你能找到的话，像占卜师和送葬者这样在晚上能获得信息的角色都是不错的选择。");
    g_tipLine[9073] = StringToText("  你也可以基于玩家来做出你的选择；那些对于善良阵营有强领导力和号召力的玩家或者一直保持安静不想引起注意的玩家都是很");
    g_tipLine[9074] = StringToText("  好的选项。");
    g_tipLine[9075] = StringToText("· 下毒给团队中能获得关键信息的角色能够摧毁玩家之间的信任。如果一个团队是围绕着送葬者进行游戏的，");
    g_tipLine[9076] = StringToText("  那你就可以通过在合适的时间给他下毒来让大家把目标都转移到一个无辜的玩家身上。");
    g_tipLine[9077] = StringToText("· 与恶魔协作，确保你们不会选择到同一位玩家。除非你们是选择了像守鸦人这样的角色，否则你这一夜的下毒机会就被浪费了。");
    g_tipLine[9078] = StringToText("· 给贞洁者、猎手或镇长这样的角色下毒也很棒，但前提是他们刚好能在中毒期间触发能力。");
    g_tipLine[9079] = StringToText("  因此你需要在适当的时候去说服他们使用能力，这样才能使他们的能力无效化。");
    g_tipLine[9080] = StringToText("· 你也可以对恶魔下毒，这样就可以伪装成僧侣或者士兵，因为今天晚上没人被杀害。（这样做之前最好跟恶魔说一声！）");
    g_tipLine[9081] = StringToText("· 作为一个投毒者，每晚选择不同的目标下毒要比整场都盯着一个玩家下毒要更有效。例如，");
    g_tipLine[9082] = StringToText("  你只需要在你觉得占卜师打算选择恶魔的晚上对他下毒，剩余时间你都可以去干扰其他玩家了。");
    g_tipLine[9083] = StringToText("  这种下毒方法要比一直盯着同一名玩家下毒更难被发现。");
    g_tipLine[9084] = StringToText("· 在第一天晚上，如果你不知道毒谁，就毒那个坐在恶魔旁边的人。你知道谁是恶魔，如果这时刚好有个共情者坐在他旁边，");
    g_tipLine[9085] = StringToText("  你就能极大程度地干扰善良阵营得到的信息。");
    g_tipLine[9086] = StringToText("【对抗投毒者】");
    g_tipLine[9087] = StringToText("· 投毒者在首个夜晚不会因为谁的能力过于强大而下毒，因为他除了他的邪恶阵营队友之外谁都不认识，");
    g_tipLine[9088] = StringToText("  他只能随便选择一个人作为目标。因此，你通常可以相信首个夜晚你的能力是能够正常生效的。");
    g_tipLine[9089] = StringToText("  这对于像贞洁者或猎手这样的角色来说非常重要，因为他们整场只能使用自己的能力一次。");
    g_tipLine[9090] = StringToText("· 投毒者会非常想给在多个夜晚都能拿到信息的角色下毒，例如共情者、送葬者或占卜师。他也会非常希望去下毒给猎手，");
    g_tipLine[9091] = StringToText("  因为猎手可以直接杀死恶魔。如果你认为投毒者在场，就需要谨慎对待其他角色所给出的信息，");
    g_tipLine[9092] = StringToText("  特别是当一些玩家已经公开他们的角色之后。然而，如果你认为一个玩家中毒了，你通常就可以假设说书人给了他错误信息。");
    g_tipLine[9093] = StringToText("· 如果中毒对你没什么大影响（比如你是陌客，或者已经给出过信息的厨师），");
    g_tipLine[9094] = StringToText("  你就可以伪装成一个对投毒者来说很有吸引力的目标，来确保他不会去毒其他人。");
    g_tipLine[9095] = StringToText("· 当心那些突然给出了不同信息的角色，特别是那些已经在团队里公布了自己角色的玩家。例如，");
    g_tipLine[9096] = StringToText("  坐在两个相同玩家中间的共情者突然报出了和前一晚不同的数字，这意味着他大概率被下毒了。");
    g_tipLine[9097] = StringToText("· 在缺乏明显目标时，投毒者经常会对这样的玩家下毒：");
    g_tipLine[9098] = StringToText("  · 强势或直率的玩家，特别是正在统领善良阵营的玩家。");
    g_tipLine[9099] = StringToText("  · 友好或很可爱的玩家——这太难顶了！");
    g_tipLine[9100] = StringToText("  · 安静或者是避免引起注意的玩家；这些人看起来像是隐藏了一些东西。");
    g_tipLine[9101] = StringToText("· 与其他爪牙不同，只要投毒者还活着，他一直都是致命的威胁。如果你怀疑某位玩家是投毒者，尽早让他出局总是有益的。");
    g_tipLine[9102] = StringToText("  例如，调查员可能会知道两名玩家中有投毒者，那就可以把他们两个都处决了。又或者，两名玩家都说自己是某一个角色，");
    g_tipLine[9103] = StringToText("  这通常意味着有一名爪牙与一名善良玩家宣称的角色撞车了，让他们两个都出局，投毒者自然就出局了。");
    g_tipRoleAt[17] = 9037; g_tipRoleN[17] = 67; g_tipP1At[17] = 9040; g_tipP1N[17] = 9; g_tipP2At[17] = 9067; g_tipP2N[17] = 4;
    g_tipAbility[17] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天中毒。");
    g_tipLine[9104] = StringToText("【背景故事】");
    g_tipLine[9105] = StringToText("「每个调酒大师心中明白");
    g_tipLine[9106] = StringToText("配方没有麻烦来得更快");
    g_tipLine[9107] = StringToText("双面间谍是麻烦的主菜」");
    g_tipLine[9108] = StringToText("【角色能力】");
    g_tipLine[9109] = StringToText("每个夜晚，你能查看魔典。");
    g_tipLine[9110] = StringToText("你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipLine[9111] = StringToText("【角色简介】");
    g_tipLine[9112] = StringToText("间谍知道所有人的具体角色。间谍看起来像是善良一员，但实际上是邪恶的。");
    g_tipLine[9113] = StringToText("· 如果任何角色的能力会探查或影响善良玩家，间谍可能会被那名角色当作善良阵营。");
    g_tipLine[9114] = StringToText("  如果任何角色的能力会探查或影响镇民角色或外来者角色，间谍可能会被那名角色当作是一个特定的镇民或外来者角色。");
    g_tipLine[9115] = StringToText("  由说书人来决定间谍被当作什么，在同一个夜晚间谍能被多次当作不同阵营或不同的角色。");
    g_tipLine[9116] = StringToText("· 间谍在被当作特定的镇民或外来者角色时，不会获得这一角色的能力。例如，被当作猎手的间谍无法猎杀恶魔。");
    g_tipLine[9117] = StringToText("【范例】");
    g_tipLine[9118] = StringToText("洗衣妇得知要么小黑是守鸦人，要么道哥是守鸦人。小黑是僧侣，道哥是被当作守鸦人的间谍。");
    g_tipLine[9119] = StringToText("间谍坐在小恶魔与共情者之间。厨师得知了「1」因为间谍此时被当作邪恶阵营。当夜稍晚时分，共情者得知了「0」，");
    g_tipLine[9120] = StringToText("  因为间谍此时被当作善良阵营。");
    g_tipLine[9121] = StringToText("间谍提名了贞洁者且被贞洁者的能力处决，因为说书人选择让间谍被当作一个镇民角色。在当晚，");
    g_tipLine[9122] = StringToText("  送葬者得知白天死去的是酒鬼，因为间谍现在被当作了酒鬼。");
    g_tipLine[9123] = StringToText("【运作方式】");
    g_tipLine[9124] = StringToText("每个夜晚，唤醒间谍并让他按自己意愿的时长来查看魔典。让间谍重新入睡。");
    g_tipLine[9125] = StringToText("每当因游戏规则或角色能力的效果要探查或影响玩家的阵营或角色，且间谍因此被选中为目标时，");
    g_tipLine[9126] = StringToText("  由你决定间谍被当作哪种角色和哪种阵营。（做出任何合适的举动，例如展示一个善良角色标记，点头，给出手势，");
    g_tipLine[9127] = StringToText("  或允许一项通常只针对善良阵营，镇民或外来者角色的能力对间谍生效。）");
    g_tipLine[9128] = StringToText("【提示标记】");
    g_tipLine[9129] = StringToText("无");
    g_tipLine[9130] = StringToText("【规则细节】");
    g_tipLine[9131] = StringToText("· 间谍有很多「可以但不建议」的内容，希望各位说书人在有间谍在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[9132] = StringToText("· 说书人不应该利用间谍能够被当作任意角色或阵营这一点，来将间谍在魔典中的角色标记替换成其他角色标记，");
    g_tipLine[9133] = StringToText("  以此向能够查看魔典的角色传递额外的信息。邪恶玩家之间的交流需要玩家自己自发进行，而且需要让善良玩家有迹可循。");
    g_tipLine[9134] = StringToText("· 间谍的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，");
    g_tipLine[9135] = StringToText("  那么间谍是有可能被当作「善良的间谍」或者是「邪恶的镇民」的（如食人族）。");
    g_tipLine[9136] = StringToText("· 养成良好的魔典使用习惯非常重要。这不仅仅是在有间谍或是寡妇的时候能确保他们获得正确的信息，");
    g_tipLine[9137] = StringToText("  也是对说书人记录繁杂的游戏信息并确保各项处理结算无误的重要支撑。必要时，");
    g_tipLine[9138] = StringToText("  说书人还应该利用提示标记以外的其他方式去记录信息，但这些信息不会被间谍得知。在线上游戏中，");
    g_tipLine[9139] = StringToText("  间谍不应该也无法看到说书人做的任何自定义笔记。");
    g_tipLine[9140] = StringToText("· 如果说书人觉得自己的某些提示标记处理可能与常规处理方式不同，想办法在白天时私下与间谍沟通（例如夜晚拍醒他并用手机");
    g_tipLine[9141] = StringToText("  打字示意让他白天来私聊你）来确保间谍正确理解了你魔典里的提示标记的位置和放置逻辑。");
    g_tipLine[9142] = StringToText("· 恶魔的三个不在场善良角色（即伪装）是否出现在魔典中，取决于说书人是否将伪装在展示给恶魔之后放在魔典中或放回剧本盒");
    g_tipLine[9143] = StringToText("  （剧本盒也位于魔典内的左侧下方，用于收纳不在场的角色和提示标记，但这些标记不会平铺在魔典左侧）。");
    g_tipLine[9144] = StringToText("  如果说书人选择在展示完后放回剧本盒，则间谍无法看到这一信息。");
    g_tipLine[9145] = StringToText("· 间谍查看魔典时，除去角色标记和提示标记之外，还能查看玩家的阵营。对于非旅行者角色标记，");
    g_tipLine[9146] = StringToText("  正面放置代表该玩家阵营与其角色初始阵营相同，倒转放置代表该玩家阵营与其角色初始阵营不同。对于旅行者角色标记，");
    g_tipLine[9147] = StringToText("  正面放置代表该玩家为善良阵营，倒转放置代表该玩家为邪恶阵营。");
    g_tipLine[9148] = StringToText("· 仅在暗流涌动这一剧本的实体版本中，间谍的夜晚顺序位于投毒者（首夜）和僧侣（非首夜）之后（与常规顺序的区别在于，");
    g_tipLine[9149] = StringToText("  不会看到小恶魔的「死亡」标记和管家的「主人」标记，且在小恶魔自杀的那个夜晚，自己变成小恶魔之前仍能查看魔典）。");
    g_tipLine[9150] = StringToText("  这是为了避免新人玩家在一开始接触到间谍这一需要处理大量信息的角色显得棘手，而避免了冗杂信息的发生。");
    g_tipLine[9151] = StringToText("  同时也给出了足够的时间允许间谍在入睡后继续进行思考。（如果间谍在管家之后被唤醒，");
    g_tipLine[9152] = StringToText("  则有可能会因为查看魔典的时间太长而被管家玩家意识到场上可能有间谍。）当玩家熟悉游戏之后，");
    g_tipLine[9153] = StringToText("  间谍还是应当参考线上魔典的顺序，在将近黎明的时候被唤醒。");
    g_tipLine[9154] = StringToText("· 查看魔典也属于「获取信息」。如果间谍醉酒或中毒，说书人对他展示的魔典内容可能会是错误的。");
    g_tipLine[9155] = StringToText("· 相克规则：");
    g_tipLine[9156] = StringToText("  · 魔术师：当间谍查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_tipLine[9157] = StringToText("  · 炼金术士：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。每次处决后，");
    g_tipLine[9158] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[9159] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_tipLine[9160] = StringToText("  · 落难少女：如果间谍正在场或曾经在场，落难少女中毒。");
    g_tipLine[9161] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[9162] = StringToText("  · 瘟疫医生：如果说书人本应获得间谍的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[9163] = StringToText("  · 食人魔：间谍必定被食人魔当作邪恶阵营。");
    g_tipLine[9164] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[9165] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[9166] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[9167] = StringToText("【提示与技巧】");
    g_tipLine[9168] = StringToText("· 在游戏开始你将知道所有信息，尽可能记住他们并提供给队友！所有在场的玩家及他们对应的角色都会被放置在魔典中。");
    g_tipLine[9169] = StringToText("  使用这些信息帮助邪恶阵营队友挑选善良角色做伪装，以及消灭高优先级的目标。");
    g_tipLine[9170] = StringToText("· 在魔典中，你不止能够看到谁是谁，还能看到说书人在他们角色标记旁放置的提示标记。这将让你能够看出谁是酒鬼，");
    g_tipLine[9171] = StringToText("  投毒者对哪名玩家下了毒，谁是占卜师的干扰项，恶魔杀了谁以及洗衣妇或是图书管理员获取到了谁的信息。");
    g_tipLine[9172] = StringToText("  记得你可能会被洗衣妇或图书管理员当作善良角色，如果你在魔典里面看到了这些，尽早去猜测并伪装成那个角色。");
    g_tipLine[9173] = StringToText("· 对于你来说，选一个善良角色做伪装是很容易的，因为你知道所有不在场的角色。");
    g_tipLine[9174] = StringToText("· 你还能够获取到作为邪恶玩家原本很难去猜到的信息，比如玩家的角色等等。这能让你化身为特别强大的角色，就像洗衣妇，");
    g_tipLine[9175] = StringToText("  送葬者和守鸦人，因为他们也能获取到角色信息。你能够通过说出善良玩家的真实角色来博取信任，");
    g_tipLine[9176] = StringToText("  特别是当他们还没说出自己角色或者是正在伪装成其他角色的时候。");
    g_tipLine[9177] = StringToText("· 伪装成图书管理员或者调查员，然后选择一个强大的角色（像共情者，守鸦人或镇长）并把他标记为酒鬼或邪恶爪牙，");
    g_tipLine[9178] = StringToText("  这能让你诋毁这些玩家。作为间谍，你可以在他们表露自己的角色之前先把这些说出来。相比于其他邪恶玩家来说，");
    g_tipLine[9179] = StringToText("  你的伪装将更可信。");
    g_tipLine[9180] = StringToText("· 你可以向恶魔和其他爪牙（如投毒者）提供支持。在一些强大的角色对邪恶阵营造成威胁之前，");
    g_tipLine[9181] = StringToText("  你可以偷偷告诉你的队友应该对哪些角色下手。通常来说，你会想与你的邪恶阵营同伴进行大量私聊并传达你获得的信息，");
    g_tipLine[9182] = StringToText("  所以你需要提前准备好借口来解释为什么你一直在与其他人窃窃私语。");
    g_tipLine[9183] = StringToText("· 你几乎总是会被其他角色当作是善良玩家，比如共情者，厨师以及送葬者。基于这一点，");
    g_tipLine[9184] = StringToText("  你能比其他邪恶阵营玩家更容易地获取到善良阵营玩家的信任。这也能够让你在后续的游戏中更有可能成为恶魔的接班人。");
    g_tipLine[9185] = StringToText("  一旦你在团队之中建立起了信任，就鼓励小恶魔把恶魔血脉传给你吧！");
    g_tipLine[9186] = StringToText("· 你是唯一一个能够触发贞洁者能力的邪恶玩家。死于贞洁者能力的玩家通常是场上最受信任的玩家。");
    g_tipLine[9187] = StringToText("  故意给出错误信息并且通过贞洁者来牺牲自己能让你更容易误导善良阵营。同样的，如果你知道送葬者在场，");
    g_tipLine[9188] = StringToText("  你就可以让你自己被处决。当你被认作善良玩家后，他们就会更相信你的信息。");
    g_tipLine[9189] = StringToText("  这也能阻止一场你不希望看到的处决发生（如果当前要被处决的是恶魔），你的处决优先级将高于当前已经存在的投票处决。");
    g_tipLine[9190] = StringToText("· 间谍对于那种需要其他玩家配合的伪装特别有效。例如，你可以声称自己是洗衣妇，图书管理员或者守鸦人来协助恶魔伪装。");
    g_tipLine[9191] = StringToText("  （最好让你的恶魔大哥知道你要这么做！）");
    g_tipLine[9192] = StringToText("· 你可以通过暗号将能够用于伪装的角色告诉其他邪恶玩家，这样就不需要和他们私聊了。就像在玩桥牌的时候，");
    g_tipLine[9193] = StringToText("  故意谈论\"星星\"或是\"宝石\"这样的内容能够让同伴知道你的方片牌很多，");
    g_tipLine[9194] = StringToText("  你也可以用一些缩写来提醒队友他们可以使用哪些角色做伪装。或者你直接告诉他们也行。你可以这样做，就公开说：");
    g_tipLine[9195] = StringToText("  \"我不会说这个人是谁，但是有人告诉我大威是僧侣了\"，然后大威就大概可能意识到你要做什么，");
    g_tipLine[9196] = StringToText("  并且开始伪装成僧侣这个角色。");
    g_tipLine[9197] = StringToText("· 确保说书人知道你正在伪装成什么角色，这能让说书人协助你做伪装。例如，如果你正在伪装成管家然后被处决了，");
    g_tipLine[9198] = StringToText("  说书人就知道他这时候应该向送葬者展示一枚管家的角色标记。");
    g_tipLine[9199] = StringToText("· 你不需要在第一晚就记住整个魔典内容。因为你每个晚上都能看魔典，每晚记几个角色就行了。");
    g_tipLine[9200] = StringToText("【对抗间谍】");
    g_tipLine[9201] = StringToText("· 对抗间谍的第一步就是要先发现他的存在。例如，你发现恶魔的击杀好像过于高效了。");
    g_tipLine[9202] = StringToText("  如果占卜师和猎手很快就死了但是守鸦人和士兵还安然无恙，这就意味着恶魔知道的可能比正常情况下要多。");
    g_tipLine[9203] = StringToText("· 如果你怀疑场上有间谍，你就应该假设邪恶阵营玩家知道所有的事情。这就意味着对于善良阵营来说，");
    g_tipLine[9204] = StringToText("  能带来最大收益的事情就是现在把所有的信息都分享出来。这将让你们的协作更高效，");
    g_tipLine[9205] = StringToText("  并且找出那些还没有完全准备好伪装的邪恶阵营玩家。");
    g_tipLine[9206] = StringToText("· 着重注意一下场上那些经常一起窃窃私语的玩家，特别是在第一天的时候。虽然也不能断定这就是间谍在与恶魔交流，");
    g_tipLine[9207] = StringToText("  但是他们的交流频率肯定会比正常玩家之间要高。");
    g_tipLine[9208] = StringToText("· 间谍很擅于伪装成洗衣妇或者守鸦人，因为这些角色能够查验到一些邪恶阵营通常无法获取的信息。如果你怀疑间谍在场，");
    g_tipLine[9209] = StringToText("  留意每一位声称是这些角色的玩家。");
    g_tipLine[9210] = StringToText("· 像共情者或者厨师这种查验阵营的角色，得到的信息有的时候对不上。这有可能就意味着因为间谍的存在引起了数字上的差异。");
    g_tipLine[9211] = StringToText("· 送葬者或守鸦人可能会得到信息：某名玩家是间谍。这通常是说书人在说谎，你应该带着怀疑的态度审视这条信息。");
    g_tipLine[9212] = StringToText("· 如果间谍在场的话，小恶魔会更倾向于自杀并期望能把恶魔血脉传给间谍，因为间谍更能融入到小镇当中去。");
    g_tipLine[9213] = StringToText("  如果在夜晚发生了任何无意义的死亡，你都应该注意这一点。");
    g_tipRoleAt[18] = 9104; g_tipRoleN[18] = 110; g_tipP1At[18] = 9108; g_tipP1N[18] = 9; g_tipP2At[18] = 9130; g_tipP2N[18] = 37;
    g_tipAbility[18] = StringToText("每个夜晚，你能查看魔典。你可能会被当作善良阵营、镇民角色或外来者角色，即使你已死亡。");
    g_tipLine[9214] = StringToText("【背景故事】");
    g_tipLine[9215] = StringToText("「你曾向我展示了紫焰议会的秘密。我们也曾一起在烈火里拥抱，在欲望中交欢，在兽性的驱使下耳鬓厮磨，");
    g_tipLine[9216] = StringToText("  我将永生永世侍奉于你。但今晚，我亲爱的，我是你的主人。」");
    g_tipLine[9217] = StringToText("【角色能力】");
    g_tipLine[9218] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipLine[9219] = StringToText("【角色简介】");
    g_tipLine[9220] = StringToText("红唇女郎会在恶魔死亡时变成恶魔。");
    g_tipLine[9221] = StringToText("· 如果在恶魔死前有五名或更多的玩家存活；或者说，如果在恶魔死后有四名或更多的玩家存活，那么红唇女郎会立刻变成恶魔，");
    g_tipLine[9222] = StringToText("  游戏会如同恶魔尚未死亡一样继续进行。");
    g_tipLine[9223] = StringToText("· 当红唇女郎的能力触发时，旅行者的数量不会计算在内。");
    g_tipLine[9224] = StringToText("· 如果在恶魔被处决时少于五名玩家存活，游戏会结束，并且善良阵营获胜。");
    g_tipLine[9225] = StringToText("· 如果在小恶魔选择自杀时，有五名或更多的玩家存活，必须是由红唇女郎来变成新的小恶魔。（前提是，");
    g_tipLine[9226] = StringToText("  红唇女郎此时能力正常生效）");
    g_tipLine[9227] = StringToText("· 如果红唇女郎变成了恶魔，她在各种意义上都会成为恶魔。如果她被处决，善良阵营会获胜。她会在每个晚上攻击玩家。");
    g_tipLine[9228] = StringToText("  她被当作恶魔。");
    g_tipLine[9229] = StringToText("【范例】");
    g_tipLine[9230] = StringToText("有七名玩家存活：小恶魔，红唇女郎，两名镇民，三名旅行者。小恶魔被处决，因此游戏结束且善良阵营获胜，");
    g_tipLine[9231] = StringToText("  因为旅行者不计算在红唇女郎的能力里。");
    g_tipLine[9232] = StringToText("有五名玩家存活：小恶魔，红唇女郎，男爵，两名镇民。小恶魔被处决。红唇女郎变成了小恶魔，且游戏继续。");
    g_tipLine[9233] = StringToText("小兰是红唇女郎。占卜师选择了小兰和小美，并得知了「否」。随后，小恶魔死亡，因此小兰变成了小恶魔。");
    g_tipLine[9234] = StringToText("  占卜师再次选择了小兰和小美，并得知了「是」。");
    g_tipLine[9235] = StringToText("【运作方式】");
    g_tipLine[9236] = StringToText("如果恶魔死亡，且在恶魔死前有五名或更多的存活玩家，在魔典中用闲置的小恶魔标记替换红唇女郎的标记，");
    g_tipLine[9237] = StringToText("  也意味着那名玩家的角色从红唇女郎变成了小恶魔。（她现在是恶魔，且具有恶魔的能力。如果她死亡，善良阵营获胜。）");
    g_tipLine[9238] = StringToText("在当晚，唤醒新的小恶魔，向她展示「你是」信息标记，然后向她展示小恶魔角色标记。");
    g_tipLine[9239] = StringToText("在《暗流涌动》里，只有一种恶魔——小恶魔。在其他剧本中，可能会有多种不同的恶魔。如果红唇女郎变成了恶魔，");
    g_tipLine[9240] = StringToText("  她一定会变成与刚死去的恶魔同一种类的恶魔，并获得这种恶魔的能力。当这种情况发生时，使用红唇女郎的「是恶魔」");
    g_tipLine[9241] = StringToText("  提示标记标记红唇女郎现在是恶魔，并参照对应的恶魔介绍里的「运作方式」来进行相关操作。");
    g_tipLine[9242] = StringToText("【提示标记】");
    g_tipLine[9243] = StringToText("· 是恶魔");
    g_tipLine[9244] = StringToText("放置时机：当红唇女郎因自己的能力变成恶魔时。");
    g_tipLine[9245] = StringToText("放置条件：当红唇女郎变成恶魔，且没有多余的恶魔角色标记用于替换红唇女郎角色标记时，在红唇女郎角色标记旁边放置。");
    g_tipLine[9246] = StringToText("（实体游戏里，只有小恶魔有多余的恶魔角色标记，而在混合剧本中，可能会存在多个不同种类的恶魔在场的情况，");
    g_tipLine[9247] = StringToText("  因此这个提示标记实际上能用到的场合很少，建议说书人使用其他更清楚的方式来记录红唇女郎的恶魔角色。");
    g_tipLine[9248] = StringToText("  在线游戏因为可以重复发送角色，因此没有太大的影响，甚至可以使用完红唇女郎的标记后再改变红唇女郎的角色，");
    g_tipLine[9249] = StringToText("  来记录这个恶魔曾经是红唇女郎）");
    g_tipLine[9250] = StringToText("（这里推荐一种方式：在恶魔死亡且红唇女郎变成恶魔后，交换恶魔与红唇女郎的角色，并用红唇女郎的「是恶魔」");
    g_tipLine[9251] = StringToText("  标记标记原恶魔，这样可以保证红唇女郎变成的恶魔正确运作，而原本的恶魔已经死亡除非有办法复活否则角色暂时不会发生变");
    g_tipLine[9252] = StringToText("  化）");
    g_tipLine[9253] = StringToText("移除时机：当红唇女郎变成的这个恶魔角色离场时。");
    g_tipLine[9254] = StringToText("【规则细节】");
    g_tipLine[9255] = StringToText("· 特定角色互动：");
    g_tipLine[9256] = StringToText("  · 痢蛭：当宿主死亡时，如果在宿主死亡之前，场上除旅行者外存活玩家人数为5人，红唇女郎不会因此变成痢蛭。");
    g_tipLine[9257] = StringToText("    因为在痢蛭死亡时，场上的存活玩家的人数已经不足5人。（宿主与痢蛭的死亡并非同时进行的）");
    g_tipLine[9258] = StringToText("· 相克规则：");
    g_tipLine[9259] = StringToText("  · 瘟疫医生：如果说书人本应获得红唇女郎的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[9260] = StringToText("  · 哈迪寂亚：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[9261] = StringToText("  · 小怪宝：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[9262] = StringToText("  · 方古：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[9263] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[9264] = StringToText("  · 梼杌：红唇女郎在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[9265] = StringToText("  · 入殓师：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[9266] = StringToText("  · 孟婆：如果恶魔选择死亡且红唇女郎即将变成恶魔，改为恶魔与红唇女郎交换角色，随后原恶魔死亡。");
    g_tipLine[9267] = StringToText("【提示与技巧】");
    g_tipLine[9268] = StringToText("· 当你与恶魔合作且找到了一个你们俩都认同的策略时，红唇女郎将发挥她最大的作用，因为恶魔可以安全地死掉。");
    g_tipLine[9269] = StringToText("  或许你可以公开指出邪恶阵营的恶魔，然后恶魔再尽最大努力让大家相信他确实邪恶。这会让你看起来非常善良且值得信赖。");
    g_tipLine[9270] = StringToText("  或许恶魔可以在晚上自杀然后宣称自己是守鸦人，并因此证实你此前的伪装。或许恶魔可以指控你为邪恶，");
    g_tipLine[9271] = StringToText("  但说辞并不那么让人信服，这样相比之下你看起来就会更加善良。或许你和恶魔可以同时说自己是某个相同的角色，比如镇长。");
    g_tipLine[9272] = StringToText("  不管怎么说，\"你们两个中间肯定有个镇长\"，没错吧？你们哪个死了都无所谓，不管怎样游戏都会继续，");
    g_tipLine[9273] = StringToText("  因为总会有一个恶魔存活。");
    g_tipLine[9274] = StringToText("· 与其他爪牙不同，在游戏前期你更需要\"活下来\"。像男爵和投毒者就算很早就死了也无所谓（因为前期他们就会带来很多麻烦");
    g_tipLine[9275] = StringToText("  ）。但你如果打算在某个时刻变为恶魔，就需要活到游戏最后。等待，仔细倾听然后声称自己是某个你确信不在场的角色，");
    g_tipLine[9276] = StringToText("  这样通常能够达到最令人满意的效果。");
    g_tipLine[9277] = StringToText("· 时机很重要。如果恶魔死亡时存活玩家少于五位，这个时候游戏就结束了，且善良玩家胜利，时刻记住这一点。");
    g_tipLine[9278] = StringToText("  如果恶魔备受他人关注，并且你觉得他可能没法活到游戏最后了，立刻采取行动且让恶魔在五名或以上玩家存活时被杀死...");
    g_tipLine[9279] = StringToText("  趁着还来得及。");
    g_tipLine[9280] = StringToText("· 你是红唇女郎，因此你不会被当作恶魔。如此一来，如果你能够被猎手或占卜师这样的善良角色证实，");
    g_tipLine[9281] = StringToText("  且在之后的某个时间变为恶魔。善良阵营就将难以找到真正的恶魔，因为他们的信息没办法很好地结合在一起。");
    g_tipLine[9282] = StringToText("· 如果恶魔玩得很好，并且似乎已经被善良阵营所信任，你就不需要使用自己的能力了。");
    g_tipLine[9283] = StringToText("  你可以扮演一个普通的爪牙角色在小镇之中传递错误信息，让善良玩家之间滋生猜忌，给大家带来麻烦，");
    g_tipLine[9284] = StringToText("  这个时候就忽略你的能力吧。");
    g_tipLine[9285] = StringToText("【对抗红唇女郎】");
    g_tipLine[9286] = StringToText("· 红唇女郎在场时，恶魔可以做到一些原本无法做到的事且无需承担任何后果。例如，");
    g_tipLine[9287] = StringToText("  他可以在被成功处决或者被猎手杀死的情况下让游戏继续进行。如果你确定你真的已经揪出了小恶魔但是游戏还在继续，");
    g_tipLine[9288] = StringToText("  你就需要怀疑场上有红唇女郎在场了。如果场上的送葬者不是酒鬼，他将有可能在晚上看到一个小恶魔角色标记。");
    g_tipLine[9289] = StringToText("· 如果小恶魔在晚上自杀，红唇女郎必定先于其他爪牙变为恶魔。在原本的小恶魔出局后，");
    g_tipLine[9290] = StringToText("  知道这一点将帮助你更快找到新恶魔的所在。");
    g_tipLine[9291] = StringToText("· 恶魔和红唇女郎可能通过配合来互相证明。例如，红唇女郎可能会伪装成洗衣妇并且\"证实\"恶魔的角色。");
    g_tipLine[9292] = StringToText("  这样可能会让他们俩看起来都很善良，并且暗中准备好了在后续游戏中传递恶魔血脉的准备。");
    g_tipLine[9293] = StringToText("· 红唇女郎不会被当作恶魔，这意味着只能查验恶魔的角色在她身上无法得到信息。例如，");
    g_tipLine[9294] = StringToText("  占卜师无法在查验她时得到信息\"是\"，猎手的能力对她也不会起作用。留意那些在游戏前期就急于被其他人验证的玩家。");
    g_tipLine[9295] = StringToText("· 如果你觉得红唇女郎在场（例如，调查员或者守鸦人获得到了相关信息），让她就这么一直活着也是个不错的策略。");
    g_tipLine[9296] = StringToText("  在最后一天仅剩三名玩家存活时，你现在要考虑的问题就不再是\"谁是恶魔\"了，而是\"红唇女郎有没有变成恶魔\"。");
    g_tipLine[9297] = StringToText("  如果你认为恶魔已经更换玩家了，处决之前那个红唇女郎。如果你认为恶魔没有发生变化，那就可以不用考虑红唇女郎了，");
    g_tipLine[9298] = StringToText("  从剩下的玩家中寻找恶魔吧。");
    g_tipLine[9299] = StringToText("· 与其他爪牙不同，红唇女郎可能会大胆地将矛头指向自己的恶魔，并且可能会故意处决恶魔来让自己看起来更加善良。");
    g_tipLine[9300] = StringToText("  如果你怀疑某位玩家是红唇女郎，时刻关注她一直在针对谁，以及矛头是否突然转变；如果她原本一直在针对某一位玩家，");
    g_tipLine[9301] = StringToText("  但在存活玩家少于5人时突然调转了矛头，那之前那个被针对的玩家很有可能就是恶魔。");
    g_tipLine[9302] = StringToText("· 红唇女郎通常是作为一个备用计划，而不是攻略首领的第二阶段。如果恶魔能够很好地融入小镇且没有受到太多质疑，");
    g_tipLine[9303] = StringToText("  红唇女郎就可以表现得更像个一般的爪牙，并且更随意地牺牲自己。如果你发现红唇女郎表现得太过明显，");
    g_tipLine[9304] = StringToText("  那就需要怀疑那个之前很受大家信任的玩家了。");
    g_tipRoleAt[19] = 9214; g_tipRoleN[19] = 91; g_tipP1At[19] = 9217; g_tipP1N[19] = 12; g_tipP2At[19] = 9254; g_tipP2N[19] = 13;
    g_tipAbility[19] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）恶魔死亡，你变成那个恶魔。");
    g_tipLine[9305] = StringToText("【背景故事】");
    g_tipLine[9306] = StringToText("「这个小镇没救了，不是么？廉价的外来劳动力……这就是问题所在。要我说，我会把他们全部调配到矿井里。");
    g_tipLine[9307] = StringToText("  不过是稍有些困难的工作，这不会伤害到任何人，要是有人提出反对意见就赏他一记耳光。这就是所谓的底线，不是么？」");
    g_tipLine[9308] = StringToText("【角色能力】");
    g_tipLine[9309] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipLine[9310] = StringToText("【角色简介】");
    g_tipLine[9311] = StringToText("男爵会改变在场的外来者数量。");
    g_tipLine[9312] = StringToText("· 外来者的数量变化会发生在初始设置时，且不会因为男爵死亡而恢复成原本的数量。对角色在初始设置时的更改，");
    g_tipLine[9313] = StringToText("  而在游戏过程中不产生影响的能力，都会在角色列表和角色标记上以方括号标注在角色描述的末尾——就像[这样]。");
    g_tipLine[9314] = StringToText("· 增加的外来者角色总是会替换掉原本的镇民角色，而不是其他角色类型。");
    g_tipLine[9315] = StringToText("【范例】");
    g_tipLine[9316] = StringToText("正在进行七人游戏的初始设置，有五名镇民，一名爪牙，和一名恶魔。因为爪牙是男爵，说书人移除了两名镇民，");
    g_tipLine[9317] = StringToText("  并添加了一个圣徒标记和一个管家标记。现在，总共有三名镇民，两名外来者，一名爪牙，");
    g_tipLine[9318] = StringToText("  和一名恶魔被放进了盲抽袋并被玩家们抽取。");
    g_tipLine[9319] = StringToText("正在进行十五人游戏的初始设置，有九名镇民，两名外来者（圣徒和管家），三名爪牙，和一名恶魔。因为男爵在场，");
    g_tipLine[9320] = StringToText("  说书人必须添加一个酒鬼标记和一个陌客标记。因此，说书人移除了僧侣标记来添加陌客标记。然后，");
    g_tipLine[9321] = StringToText("  作为添加酒鬼角色标记的替代，说书人在魔典中加入了酒鬼的「是酒鬼」提示标记……因为在这局游戏中，");
    g_tipLine[9322] = StringToText("  会有一名玩家不是镇民——而是外来者：酒鬼。所有的这些被添加的角色标记会放进盲抽袋并被玩家们抽取。");
    g_tipLine[9323] = StringToText("【运作方式】");
    g_tipLine[9324] = StringToText("在游戏设置时，移除任意两个镇民角色标记，并添加任意两个外来者角色标记。（如果你添加了酒鬼，");
    g_tipLine[9325] = StringToText("  请记得同样需要依照酒鬼的初始设置方法进行设置步骤。）这些外来者角色标记会作为镇民角色标记的替代放入盲抽袋中。");
    g_tipLine[9326] = StringToText("【提示标记】");
    g_tipLine[9327] = StringToText("无");
    g_tipLine[9328] = StringToText("【规则细节】");
    g_tipLine[9329] = StringToText("· 相克规则：");
    g_tipLine[9330] = StringToText("  · 瘟疫医生：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[9331] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[9332] = StringToText("【提示与技巧】");
    g_tipLine[9333] = StringToText("· 你的能力甚至在游戏还未开始的时候就已经生效了。这意味着你除了帮恶魔获胜之外，绝对没有其他任何责任了！享受游戏吧！");
    g_tipLine[9334] = StringToText("  故意和某位镇民宣称相同的角色来让他看起来像是邪恶方的！散布谎言！你可以通过下套、");
    g_tipLine[9335] = StringToText("  伪装双重角色以及富有创造性的伪装来让善良玩家看起来邪恶，让邪恶玩家看起来善良。你可以大胆去做你任何想要做的事情，");
    g_tipLine[9336] = StringToText("  因为你已经没什么可以再失去的了！");
    g_tipLine[9337] = StringToText("· 由于你向游戏中添加了额外的外来者，且这些玩家通常会公开声明自己的外来者角色，");
    g_tipLine[9338] = StringToText("  这时候你也说自己是外来者能给局势带来巨大的混乱。如果酒鬼在场，且只有你和一个真的外来者声明了自己的外来者角色——");
    g_tipLine[9339] = StringToText("  在这种情况下，由于场上多了两个外来者，善良阵营将会知道男爵在场，但只会认为你是个真的外来者。然而，");
    g_tipLine[9340] = StringToText("  如果场上没有酒鬼，就会比一般情况下多出三个外来者，善良阵营可能会想把三个外来者全部处决，");
    g_tipLine[9341] = StringToText("  因为这里面至少有一个是邪恶阵营的——处决三名玩家（包括你自己）将带来一场好戏且能够给你的队伍带来优势。");
    g_tipLine[9342] = StringToText("· 故意与一位在场玩家声明一样的角色，这样可以让他的角色看起来也邪恶。你就算死了也无所谓，因此当占卜师，送葬者，");
    g_tipLine[9343] = StringToText("  甚至镇长在场时，你也可以声明自己是这些角色，这样你们俩看起来就会都比较可疑。那个玩家会怀疑你邪恶，");
    g_tipLine[9344] = StringToText("  但其他玩家也同样会怀疑他，且不会相信任何他给出的信息。");
    g_tipLine[9345] = StringToText("· 对邪恶阵营来说，在场上没有男爵的时候说场上有男爵也是个不错的策略。");
    g_tipLine[9346] = StringToText("  声称自己是个外来者将会让大家开始讨论是否有男爵在场。如果善良阵营开始相信男爵确实在场，");
    g_tipLine[9347] = StringToText("  你这个外来者角色就很合理了，但是善良阵营也会同样相信场上有个酒鬼，因为在没有其他玩家声明自己是外来者的情况下，");
    g_tipLine[9348] = StringToText("  另一个外来者肯定就是酒鬼了。这样他们就会对自己的信息一直保持怀疑态度。");
    g_tipLine[9349] = StringToText("· 更好的是，如果在男爵不在场的情况下你说场上有男爵，且两位邪恶阵营玩家刚好都说自己是外来者，");
    g_tipLine[9350] = StringToText("  这样看起来就像是男爵增加了两个外来者，这两名外来者通常也不会被善良玩家处决。因为善良阵营想要让善良玩家一直活着，");
    g_tipLine[9351] = StringToText("  就算是被\"确信\"的外来者活着也比死了强。");
    g_tipLine[9352] = StringToText("· 当个替死鬼吧。想办法代替恶魔被处决。不要怕以这种方式死亡，因为这能多保证你的恶魔老大一天的安全。而且，");
    g_tipLine[9353] = StringToText("  如果你看起来太值得被处决以至于猎手或守鸦人对你使用了能力，这样还至少能够保证他们不会把能力用在恶魔身上。");
    g_tipLine[9354] = StringToText("  即便你提名了贞洁者，没有被立刻处决会让你看起来很邪恶，但这也避免了让恶魔陷入相同的处境。");
    g_tipLine[9355] = StringToText("· 如果你没有伪装成外来者，就尽可能往真的外来者身上泼脏水。在场上明显存在男爵时，外来者通常会被善良阵营所信任，");
    g_tipLine[9356] = StringToText("  如果你想赢就必须杀掉他们。");
    g_tipLine[9357] = StringToText("· 还有一种选择，就是让恶魔在游戏前期杀死你——在游戏前期死亡的玩家通常被大家认为是善良角色，");
    g_tipLine[9358] = StringToText("  利用这一点你就可以四处搜集情报并反馈给邪恶阵营，同时还可以顺便散播一下谎言。虽然说这条策略对任何爪牙都实用，");
    g_tipLine[9359] = StringToText("  但男爵无疑是最适合的，因为你那牛X的能力早就已经开始生效了。");
    g_tipLine[9360] = StringToText("【对抗男爵】");
    g_tipLine[9361] = StringToText("· 如果外来者的数量与正常情况下对不上（例如：在仅有一位外来者的游戏中出现了三位外来者），场上就很有可能存在男爵。");
    g_tipLine[9362] = StringToText("  关于这一点，你有几种选择：");
    g_tipLine[9363] = StringToText("  · 如果你相信所有的外来者，那就让他们都活着！就算他们能力拉胯，但总归也是善良阵营的玩家。");
    g_tipLine[9364] = StringToText("  · 如果你不确定有没有男爵，那就最好尽快让外来者们都出局；这其实有可能是邪恶阵营玩家伪装成了额外的外来者来避免被怀疑");
    g_tipLine[9365] = StringToText("    。");
    g_tipLine[9366] = StringToText("  · 如果你相信外来者但数量确实对不上，那有一个镇民可能就是酒鬼，你应该尽快找到他。");
    g_tipLine[9367] = StringToText("· 不同于其他爪牙，男爵对于游戏的影响是显而易见的；你将很快注意到场上是否存在意料之外的外来者。");
    g_tipLine[9368] = StringToText("  查明场上有男爵其实是件好事，因为这就意味着（特别是在人数较少的游戏中）可能场上会少一个投毒者，间谍或红唇女郎。");
    g_tipLine[9369] = StringToText("· 相比于其他爪牙来说，男爵就算一直活着也不会带来更多的收益了，因此他的行动通常会趋于大胆且在游戏中会显得更有进攻性");
    g_tipLine[9370] = StringToText("  。男爵不怕死；他会故意和其他玩家宣称同样的角色，故意第一个提名贞洁者，故意惹恼猎手，也可能他就在那搅局。");
    g_tipLine[9371] = StringToText("  如果你认为某位玩家非常喜欢引发混乱，他可能就是男爵！");
    g_tipLine[9372] = StringToText("· 与其他爪牙不同，男爵的效果在游戏最最开始就已经生效了且无法被改变。这也就意味着不是完全有必要非得处决男爵。");
    g_tipLine[9373] = StringToText("  让一个邪恶阵营玩家出局确实是有利的，但如果你有更好的选择（例如发现了一个可能是小恶魔或投毒者的玩家），");
    g_tipLine[9374] = StringToText("  就可以先把男爵放在一边。");
    g_tipLine[9375] = StringToText("· 别忘了小恶魔也可以将恶魔角色传递给男爵！也不要完全忽视男爵的存在，");
    g_tipLine[9376] = StringToText("  最后一天再去考虑他有没有变成恶魔实在是有些晚了。");
    g_tipRoleAt[20] = 9305; g_tipRoleN[20] = 72; g_tipP1At[20] = 9308; g_tipP1N[20] = 7; g_tipP2At[20] = 9328; g_tipP2N[20] = 4;
    g_tipAbility[20] = StringToText("会有额外的外来者在场。[+2 外来者]");
    g_tipLine[9377] = StringToText("【背景故事】");
    g_tipLine[9378] = StringToText("「我们必须让自己的头脑保持敏锐，刀刃保持锋利。");
    g_tipLine[9379] = StringToText("邪恶在我们之中穿行，想要不择手段地摧毁我们的善良。");
    g_tipLine[9380] = StringToText("那些愚蠢之辈，把我们美丽的小镇给毁了。不要相信任何人。");
    g_tipLine[9381] = StringToText("但如果你一定要相信某人，请相信我。」");
    g_tipLine[9382] = StringToText("【角色能力】");
    g_tipLine[9383] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名爪牙会变成小恶魔。");
    g_tipLine[9384] = StringToText("【角色简介】");
    g_tipLine[9385] = StringToText("小恶魔会在夜晚杀戮，且能创造自己的分身……以可怕的代价。");
    g_tipLine[9386] = StringToText("· 除首个夜晚以外的每个夜晚，小恶魔会选择一名玩家进行杀戮。因为夜间大多数角色都在恶魔之后行动，");
    g_tipLine[9387] = StringToText("  被恶魔杀死的玩家可能在当晚无法使用他的能力。");
    g_tipLine[9388] = StringToText("· 小恶魔作为恶魔，能够得知哪些玩家是他的爪牙，也能得知三个不在场的善良角色，他能较为安全地伪装成这些角色。");
    g_tipLine[9389] = StringToText("· 如果小恶魔死亡，游戏结束且善良阵营获胜。然而，如果小恶魔选择在夜晚杀死自己，");
    g_tipLine[9390] = StringToText("  他会死亡并且会有一名存活的爪牙变成小恶魔。新的小恶魔在当晚无法进行行动，");
    g_tipLine[9391] = StringToText("  但现在那名爪牙现在在各种意义上都会成为恶魔——他会在此后的每个夜晚杀戮，且会在死亡时让邪恶阵营落败。");
    g_tipLine[9392] = StringToText("【范例】");
    g_tipLine[9393] = StringToText("现在是第一夜。小恶魔得知小文和小美是爪牙。小恶魔还得知僧侣，厨师和图书管理员不在场。小恶魔谎称自己是厨师，");
    g_tipLine[9394] = StringToText("  并在稍晚时分谎称自己是镇长。最后，小恶魔被处决，且善良阵营获胜。");
    g_tipLine[9395] = StringToText("在夜晚时，小恶魔被唤醒并选择了一名玩家，那名玩家死亡。在下一个夜晚，小恶魔选择让自己死亡。于是小恶魔死亡，");
    g_tipLine[9396] = StringToText("  并且投毒者变成了小恶魔。");
    g_tipLine[9397] = StringToText("【运作方式】");
    g_tipLine[9398] = StringToText("除首个夜晚以外的每个夜晚，唤醒小恶魔。让小恶魔指向任意一名玩家。让小恶魔重新入睡。");
    g_tipLine[9399] = StringToText("  被选择的玩家死亡——在那名玩家的角色标记旁放置小恶魔的「死亡」提示标记并放置帷幕标记。");
    g_tipLine[9400] = StringToText("如果小恶魔选择在夜里自杀，用多出来的小恶魔标记替换一名存活的爪牙玩家的角色标记，让那名玩家的角色改变为小恶魔。");
    g_tipLine[9401] = StringToText("  唤醒新的小恶魔，向他展示「你是」信息标记，然后向他展示小恶魔角色标记。让新的小恶魔重新入睡。");
    g_tipLine[9402] = StringToText("黎明时，宣布有哪名玩家在夜晚死去。（不要说明死亡原因。）");
    g_tipLine[9403] = StringToText("如果小恶魔选择在夜晚攻击一名已死亡的玩家，允许他这么做。当一个角色能力描述中提及「选择一名玩家」，");
    g_tipLine[9404] = StringToText("  意味着任何玩家——无论存活或是死亡——都能被选择。小恶魔可能在计划伪装成士兵，");
    g_tipLine[9405] = StringToText("  而这种情形下会让他的谎言看起来更加可信。");
    g_tipLine[9406] = StringToText("【提示标记】");
    g_tipLine[9407] = StringToText("· 死亡");
    g_tipLine[9408] = StringToText("放置时机：在小恶魔夜晚行动并选择了玩家后放置。");
    g_tipLine[9409] = StringToText("放置条件：小恶魔选择的玩家当前存活，且能被小恶魔杀死，且小恶魔未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[9410] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[9411] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[9412] = StringToText("【提示与技巧】");
    g_tipLine[9413] = StringToText("· 邪恶玩家有很多策略可以选择，尤其是小恶魔。一般来说，恶魔会希望自己看起来比较可信，且在可能的时候传递错误信息，");
    g_tipLine[9414] = StringToText("  让爪牙来证实你是一个善良阵营玩家，或者在需要的时候牺牲他们。这个章节中可以查看到更多信息。");
    g_tipLine[9415] = StringToText("· 努力活过白天。就算场上有三名爪牙，你也没法保证红唇女郎在场。（然而，如果你已经与爪牙交流过并且确定她在场，");
    g_tipLine[9416] = StringToText("  就忽略这条建议吧！）");
    g_tipLine[9417] = StringToText("· 如果你被怀疑了，在晚上自杀永远可以作为选择之一。杀死自己并且将恶魔血脉传递给一名更受信任的爪牙虽然会让你失去继续");
    g_tipLine[9418] = StringToText("  投票的权利，但让场上一直有恶魔存活更加重要。你也可以在没人怀疑你的时候自杀——大家比较倾向于相信死在晚上的玩家。");
    g_tipLine[9419] = StringToText("  不管你选上面哪种方式，如果你在晚上死了，就在白天给善良阵营传递错误信息。例如你可以说自己是个守鸦人，");
    g_tipLine[9420] = StringToText("  这很有可能改变游戏的走势。");
    g_tipLine[9421] = StringToText("· 你的爪牙就是被用来牺牲的马前卒！杀死他们！全都杀了！你才是最重要的那个！");
    g_tipLine[9422] = StringToText("· 在游戏开始，说书人将会告诉你三个可以用作伪装的角色。当然了，你也可以伪装成你喜欢的角色，但这几个相对安全一些。");
    g_tipLine[9423] = StringToText("  由于小恶魔可以在晚上自杀来将恶魔角色传递给一名爪牙，所以不论是选择相对保守的伪装还是选择一个激进一点的伪装都很有");
    g_tipLine[9424] = StringToText("  效。如果你是一名新玩家，或者还不太清楚游戏的运作方式，要么你直接向说书人寻求帮助，");
    g_tipLine[9425] = StringToText("  要么就选一个相对保守的角色做伪装，比如士兵或者陌客。如果你喜欢刺激，");
    g_tipLine[9426] = StringToText("  也可以选择像占卜师或者送葬者这样\"高风险高回报\"的角色做伪装。");
    g_tipLine[9427] = StringToText("· 选择攻击目标的时候，你通常希望尽早选那些强大、棘手、能够获取信息的镇民，比如共情者、送葬者、僧侣或者猎手。");
    g_tipLine[9428] = StringToText("  在游戏前期就把这些信息抹杀掉会帮你很大忙。有些时候，你也可以故意留一个这样的镇民，让他一直活到最后一天，");
    g_tipLine[9429] = StringToText("  这样也会让其他人怀疑他的真实角色。他们可能会质问这位玩家\"如果你是真的占卜师，凭什么能活到现在？\"，");
    g_tipLine[9430] = StringToText("  然后就将他处决。");
    g_tipLine[9431] = StringToText("· 同样，在夜晚选择攻击目标的时候，你也最好早点选择那些已经被大家所信任的玩家。");
    g_tipLine[9432] = StringToText("  一个被所有人都确信的贞洁者永远也不会被处决，留她在场会增加你被处决的几率。被所有人都确信的外来者们也得消失，");
    g_tipLine[9433] = StringToText("  因为他们也不会被处决。在最后一天，你会希望留下至少一位看起来比你更有嫌疑的玩家，能留两位当然更好。");
    g_tipLine[9434] = StringToText("· 把你的爪牙派出去搜集信息。尽可能多地知道大家的角色。这会帮你避免攻击到一些像守鸦人或士兵这样棘手的角色，");
    g_tipLine[9435] = StringToText("  也就能够避免随之而来的问题。");
    g_tipLine[9436] = StringToText("· 与你的爪牙交流！通过帮助他们伪装角色的方式与他们配合。可以允许你们其中的一位尽可能看起来邪恶，");
    g_tipLine[9437] = StringToText("  而另外一位就可以继承恶魔血脉并存活到游戏最后。问问间谍他知道什么。与投毒者合作来避免夜里与他选到相同的目标。");
    g_tipLine[9438] = StringToText("  男爵你可以任他到处撒野。问问红唇女郎的计划是杀死你还是让你活着。");
    g_tipLine[9439] = StringToText("· 善良阵营有一万种理由认为你是个邪恶的小恶魔。如果发生这种情况，千万别放弃！或许你可以说服大家共情者是个酒鬼？");
    g_tipLine[9440] = StringToText("  或许你也可以争辩说你可能是占卜师的那个\"干扰项\"？");
    g_tipLine[9441] = StringToText("· 如果你不想在夜晚杀死任何人，你可以选择一名已经死亡的玩家。这也可以帮你伪装成士兵或者僧侣，");
    g_tipLine[9442] = StringToText("  因为无人死亡的夜晚看起来就像是士兵或僧侣的能力生效了。");
    g_tipLine[9443] = StringToText("【对抗小恶魔】");
    g_tipLine[9444] = StringToText("· 善良玩家杀死恶魔就能获胜。如果你得知有一位玩家可能是恶魔，另一位玩家可能是爪牙，");
    g_tipLine[9445] = StringToText("  通常来说这时最好的做法是优先处决掉那个你怀疑是恶魔的玩家！");
    g_tipLine[9446] = StringToText("· 找到谁不是小恶魔和找到小恶魔一样重要。确定其他玩家是善良阵营能让你们迅速构建起信任，");
    g_tipLine[9447] = StringToText("  汇总信息并罗列出一系列的嫌疑人...这也意味着你能够知道谁不是恶魔。最后一天通常仅剩三名玩家存活，");
    g_tipLine[9448] = StringToText("  而其中一名就是恶魔——如果你不确定恶魔是哪个但可以担保其中一位玩家肯定是善良阵营，");
    g_tipLine[9449] = StringToText("  那你们能够处决掉恶魔的可能性就从三选一变成了二选一。");
    g_tipLine[9450] = StringToText("  · 守鸦人或猎手这样的角色非常擅于排除恶魔——虽说用这些一次性的能力找恶魔很令人兴奋，");
    g_tipLine[9451] = StringToText("    但就算最后只找到了一个善良玩家也同样能带来很大帮助。");
    g_tipLine[9452] = StringToText("· 如果有人在某个奇怪的时间点出人意料地死亡了，或者是死在了备受大家怀疑的情况下，");
    g_tipLine[9453] = StringToText("  你或许就见证了恶魔自杀并将自己的恶魔血脉传递给了一位爪牙的伟大时刻。这是条令人兴奋的消息，");
    g_tipLine[9454] = StringToText("  因为你已经知道他是邪恶玩家了，你就可以回顾他之前做过的所有事，并且找出他的邪恶阵营同伴。在这个时候，来自厨师、");
    g_tipLine[9455] = StringToText("  共情者和调查员的信息就显得非常有价值了，因为你可以用这个已经死去的恶魔作为参考基点来找到其他邪恶阵营的角色。");
    g_tipLine[9456] = StringToText("  如果这些角色不在场，你也有很多选择：想想他之前和哪些玩家进行过交流或者是统一了战线？");
    g_tipLine[9457] = StringToText("  他是不是伪装成了一个持有信息的角色？他用他们的信息证实或者保护了谁？例如，");
    g_tipLine[9458] = StringToText("  他可能会伪装成洗衣妇来\"证实\"其他爪牙的伪装，一旦大家相信了那个爪牙，他就会在晚上自杀。");
    g_tipLine[9459] = StringToText("· 当心红唇女郎！只要有五名及以上的玩家存活，小恶魔就算被处决，邪恶阵营也能够继续运作下去。");
    g_tipLine[9460] = StringToText("  如果你认为你知道谁是小恶魔，你可以考虑等到场上只剩下五名以下玩家时再发起对他的处决，");
    g_tipLine[9461] = StringToText("  这样红唇女郎的能力就无法被触发，如此一来就可以阻止恶魔血脉的传递。");
    g_tipLine[9462] = StringToText("· 小恶魔的攻击能力能够让他有效地移除那些能够给他带来威胁的角色，而且他会非常享受这种感觉。");
    g_tipLine[9463] = StringToText("  保护那些能持续获得信息的角色（如送葬者）或者有强大的一次性能力的角色（如贞洁者），试着骗恶魔做出一些错误的选择。");
    g_tipLine[9464] = StringToText("  比如，士兵或镇长都可以伪装成一个更具有吸引力的目标，让自己的能力化解掉恶魔的攻击。要不像圣徒（他非常想死在晚上）");
    g_tipLine[9465] = StringToText("  ，陌客或者洗衣妇这样的角色也可以试着吸引恶魔的注意——他们虽然免不了一死，但总好过占卜师被杀！");
    g_tipLine[9466] = StringToText("· 如果在这场游戏中玩家总数少于等于6（即汀西维尔模式），有关恶魔的规则会稍微有些变化。");
    g_tipLine[9467] = StringToText("  他在首个夜晚不会得知可以伪装的角色，他也不会知道爪牙是谁。一种有趣的策略就是在另一位玩家面前伪装成爪牙，");
    g_tipLine[9468] = StringToText("  然后鼓动恶魔多跟你交交底。如果他承认自己是恶魔了，你就可以把他赶出小镇，一锤定音！");
    g_tipLine[9469] = StringToText("· 不像你可能遇到过的其他恶魔，小恶魔这个能将恶魔血脉传递给爪牙的特殊能力让他有一个很特殊的地位。");
    g_tipLine[9470] = StringToText("  他能够通过更复杂的伪装实现金蝉脱壳，但这通常会需要不止一位玩家进行配合。在寻找邪恶阵营的时候，");
    g_tipLine[9471] = StringToText("  留意那些互相证实了阵营的角色。例如：");
    g_tipLine[9472] = StringToText("  · 他可能伪装成洗衣妇/图书管理员并且证实了爪牙伪装的镇民/外来者角色。（这在爪牙伪装成圣徒时将非常可怕！）");
    g_tipLine[9473] = StringToText("  · 他伪装成了共情者然后声称两位邻座玩家都是善良阵营，很快他就死了然后把恶魔血脉传给了邻座的爪牙。");
    g_tipLine[9474] = StringToText("  · 他也可以死后伪装成守鸦人，回过头来证实爪牙的伪装，但这个爪牙早已变成恶魔了。");
    g_tipLine[9475] = StringToText("  · 他也可以伪装成猎手，假装\"猎杀\"他的爪牙，后面他自己再死掉。（他们也可以对真猎手耍这个把戏，");
    g_tipLine[9476] = StringToText("    让真猎手对爪牙使用能力，过后再把恶魔血脉传递给这个已经被证实非恶魔的爪牙。）");
    g_tipLine[9477] = StringToText("  · 他也可能在晚上故意谁都不杀，然后让爪牙去伪装成僧侣或者士兵。夜晚无人死亡会让大家会非常愿意相信士兵，");
    g_tipLine[9478] = StringToText("    这个爪牙也就成了一个非常理想的恶魔继承人。");
    g_tipRoleAt[21] = 9377; g_tipRoleN[21] = 102; g_tipP1At[21] = 9382; g_tipP1N[21] = 10; g_tipP2At[21] = 0; g_tipP2N[21] = 0;
    g_tipAbility[21] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名爪牙会变成小恶魔。");
    g_tipLine[9479] = StringToText("【背景故事】");
    g_tipLine[9480] = StringToText("「我的小心肝呀，如果你要出门，记得加件外套。这是你的保温杯。这是你的围巾。你知道我心脏不太好。要是你感冒了，");
    g_tipLine[9481] = StringToText("  或者有个三长两短，我该怎么办？」");
    g_tipLine[9482] = StringToText("【角色能力】");
    g_tipLine[9483] = StringToText("在你的首个夜晚，你会得知一名善良玩家和他的角色。");
    g_tipLine[9484] = StringToText("如果恶魔杀死了他，你也会死亡。");
    g_tipLine[9485] = StringToText("【角色简介】");
    g_tipLine[9486] = StringToText("祖母知道自己的孙子是谁，但是如果孙子被恶魔杀死，祖母也会死亡。");
    g_tipLine[9487] = StringToText("· 在首个夜晚，祖母会得知自己的孙子——一名善良玩家的镇民或外来者角色信息。孙子不会得知自己有位祖母。");
    g_tipLine[9488] = StringToText("· 如果恶魔杀死了孙子，祖母也会死亡。如果孙子通过任何其他方式死亡——例如处决，");
    g_tipLine[9489] = StringToText("  或在夜晚因其他原因死亡——祖母不会因此死亡。");
    g_tipLine[9490] = StringToText("【范例】");
    g_tipLine[9491] = StringToText("在首个夜晚，祖母被唤醒并得知自己的孙子小佳是教授。三个夜晚后，小佳被恶魔杀死，因此祖母也一同死亡。");
    g_tipLine[9492] = StringToText("祖母得知自己的孙子小莱是赌徒。小莱进行赌博且因此而死亡。祖母依然存活。");
    g_tipLine[9493] = StringToText("祖母得知自己的孙子小美是修补匠。小美被恶魔杀死，但祖母因为水手的能力而处于醉酒状态，因此祖母依然存活。");
    g_tipLine[9494] = StringToText("【运作方式】");
    g_tipLine[9495] = StringToText("在为首个夜晚进行准备时，通过将「孙子」提示标记放置到任意一个善良角色的角色标记旁来选择一名「孙子」。");
    g_tipLine[9496] = StringToText("在首个夜晚，唤醒祖母，向其展示标有「孙子」的角色标记，然后指向该名「孙子」玩家，然后让祖母重新入睡。");
    g_tipLine[9497] = StringToText("如果恶魔杀死了「孙子」，祖母死亡——将「死亡」提示标记放置到祖母的角色标记旁。");
    g_tipLine[9498] = StringToText("【提示标记】");
    g_tipLine[9499] = StringToText("· 孙子");
    g_tipLine[9500] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[9501] = StringToText("放置条件：放置在一个善良角色或能被当作善良角色的角色标记旁边。");
    g_tipLine[9502] = StringToText("移除时机：祖母死亡或离场后。");
    g_tipLine[9503] = StringToText("· 死亡");
    g_tipLine[9504] = StringToText("放置时机：在恶魔杀死了被标记有「孙子」的玩家时放置。");
    g_tipLine[9505] = StringToText("放置条件：恶魔杀死「孙子」，且祖母未醉酒中毒时，放置在祖母角色标记旁边，");
    g_tipLine[9506] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[9507] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[9508] = StringToText("【规则细节】");
    g_tipLine[9509] = StringToText("· 在绝大多数情况下，祖母得知的角色都应该是善良角色。因为如果祖母得知了邪恶角色，");
    g_tipLine[9510] = StringToText("  这会带来祖母能力之外的额外信息（有处于善良阵营的邪恶角色，又或者在剧本条件不允许的情况下作为了祖母醉酒中毒的明确");
    g_tipLine[9511] = StringToText("  提示）。");
    g_tipLine[9512] = StringToText("· 相克规则：");
    g_tipLine[9513] = StringToText("  · 利维坦：如果利维坦在场，孙子死于处决，邪恶阵营获胜。");
    g_tipLine[9514] = StringToText("  · 暴乱：如果暴乱在场，孙子死于处决，邪恶阵营获胜。");
    g_tipLine[9515] = StringToText("【提示与技巧】");
    g_tipLine[9516] = StringToText("· 保护你心爱的孙子！他们绝对是善良的，这一点在黯月初升剧本中非常珍贵（除非你第一夜就中毒或者醉酒，");
    g_tipLine[9517] = StringToText("  那你可能错认孙子的角色，甚至误以为某个邪恶玩家是你的孙子，而不知道你的真孙子是谁，但是你的真孙子一定是善良的）。");
    g_tipLine[9518] = StringToText("  此外，如果他们被恶魔杀死，你也会死--也算是你保护他额外的动力吧！");
    g_tipLine[9519] = StringToText("· 和你的孙子对话，和他们花言巧语，让他们信任你！不像洗衣妇等角色，你的信息非常绝对，");
    g_tipLine[9520] = StringToText("  因为你只知道一个玩家和他们的角色-让他们先承认他们是谁没有好处，除非你强烈地怀疑你醉酒了。当你有机会的时候，");
    g_tipLine[9521] = StringToText("  表露出你很了解他们，你们会从一开始就建立很多信任。");
    g_tipLine[9522] = StringToText("· 不要向任何人透露你孙子的角色！如果邪恶的团队知道你们的关系，他们绝对会想杀了你的孙子，");
    g_tipLine[9523] = StringToText("  并带走你的生命作为一个奖赏。保守秘密以保证你们的生命的安全。");
    g_tipLine[9524] = StringToText("· 向几个玩家透露你的角色和你的孙子。这有两个好处——如果这些人值得信任，他们会知道反过来信任你和你的孙子。但是，");
    g_tipLine[9525] = StringToText("  如果你和你的孙子突然死了呢？你可以极大地怀疑这些玩家——有可能其中一个其实就是恶魔！（注意：");
    g_tipLine[9526] = StringToText("  如果你怀疑你在和邪恶的玩家对话，你不必告诉他们谁是你真正的孙子...）");
    g_tipLine[9527] = StringToText("· 使用你的信息，有许多方法可以与善良阵营玩家建立信任！");
    g_tipLine[9528] = StringToText("  · 鼓励有保护能力的角色来保护你的孙子。如果你知道一名玩家是旅店老板，可以让他保护孙子，或者你的孙子和茶艺师很临近，");
    g_tipLine[9529] = StringToText("    试着让你的孙子和茶艺师邻座，这样你的孙子就可以在晚上得到保护，保证你们两个的安全。");
    g_tipLine[9530] = StringToText("  · 同样，你可以警告像水手和驱魔人这样的玩家，他们有的会让你的孙子醉酒，或者只是在善良阵营玩家身上浪费他们的能力。");
    g_tipLine[9531] = StringToText("  · 最后，你可以鼓励赌徒和侍女在你或你的孙子身上使用他们的能力，当你们的信息一致时，让你们可以彼此信任！");
    g_tipLine[9532] = StringToText("· 如果只有你和你的孙子在晚上死去，你很可能是因为你的能力而死的。如果你怀疑是这种情况，一定要让善良阵营玩家知道，");
    g_tipLine[9533] = StringToText("  否则在晚上两个玩家的死亡就像是沙巴洛斯或珀潜伏的迹象，而事实上僵怖或普卡仍非常可能存在。");
    g_tipLine[9534] = StringToText("· 不要一开始就和你的孙子窃窃私语，尤其是在游戏的早期，这会吸引所有玩家的注意，恶魔可能会怀疑你们是祖母和孙子，");
    g_tipLine[9535] = StringToText("  就把你们两个干掉。");
    g_tipLine[9536] = StringToText("· 向团队透露你是祖母，但不要说你的孙子是哪个玩家。比如你可以简单的说「我就是祖母，我知道镇上有个驱魔人」，");
    g_tipLine[9537] = StringToText("  或者类似的话。这让团队知道你是一个镇民角色，也让他们知道并期待一个驱魔人会在之后现身。");
    g_tipRoleAt[22] = 9479; g_tipRoleN[22] = 59; g_tipP1At[22] = 9482; g_tipP1N[22] = 8; g_tipP2At[22] = 9508; g_tipP2N[22] = 7;
    g_tipAbility[22] = StringToText("在你的首个夜晚，你会得知一名善良玩家和他的角色。如果恶魔杀死了他，你也会死亡。");
    g_tipLine[9538] = StringToText("【背景故事】");
    g_tipLine[9539] = StringToText("「你们随便谁来我都能把他喝到桌子底下去！说你呢！那个话痨！敢来和我喝一杯么？不来？那你呢，老太婆？");
    g_tipLine[9540] = StringToText("  你以前喝过老麦基利的加香料朗姆酒吗？保证能让你喝成个真男人！上船咯，噢耶！」");
    g_tipLine[9541] = StringToText("【角色能力】");
    g_tipLine[9542] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会醉酒直到下个黄昏。");
    g_tipLine[9543] = StringToText("你不会死亡。");
    g_tipLine[9544] = StringToText("【角色简介】");
    g_tipLine[9545] = StringToText("水手要么自己醉酒，要么让别人醉酒。只要水手是清醒状态，就不会死亡。");
    g_tipLine[9546] = StringToText("· 每个夜晚，水手需要选择一名玩家，该玩家可能会醉酒。");
    g_tipLine[9547] = StringToText("· 如果水手选择了自己，他失去自己的「不会死亡」能力，直到恢复清醒为止。");
    g_tipLine[9548] = StringToText("· 如果水手不小心选择了已死亡的玩家，说书人应提醒他重新选择。");
    g_tipLine[9549] = StringToText("· 如果水手选择了其他玩家，由说书人来选择哪名玩家将会醉酒。如果水手选择了一个镇民，说书人通常会让该镇民醉酒，");
    g_tipLine[9550] = StringToText("  但如果选择了外来者、爪牙或是恶魔，那么说书人通常会让水手自己醉酒。");
    g_tipLine[9551] = StringToText("· 在水手清醒时，他不会死亡，即使水手还没在夜晚被唤醒。");
    g_tipLine[9552] = StringToText("【范例】");
    g_tipLine[9553] = StringToText("水手选择了驱魔人，于是说书人决定让驱魔人醉酒。在这个夜晚，水手被沙巴洛斯攻击。水手依然存活。在下一个白天，");
    g_tipLine[9554] = StringToText("  水手被处决，但依然存活。");
    g_tipLine[9555] = StringToText("在白天，造谣者发表了一个公开声明，他以为是错误的，但其实是正确的。在当晚，造谣者的能力将会杀死一名玩家。");
    g_tipLine[9556] = StringToText("  水手让自己醉酒了，于是说书人决定让水手死亡。");
    g_tipLine[9557] = StringToText("水手选择了主谋，但是说书人决定让水手醉酒。在下一个白天，水手要求处决自己来「证明自己是水手」，但是因为他醉酒，");
    g_tipLine[9558] = StringToText("  所以死亡了。");
    g_tipLine[9559] = StringToText("【运作方式】");
    g_tipLine[9560] = StringToText("每个夜晚，唤醒水手。让水手指向任意一名存活玩家。让水手重新入睡。水手或他选择的玩家两者之一会进入醉酒状态——将「");
    g_tipLine[9561] = StringToText("  醉酒」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[9562] = StringToText("如果清醒的水手将要死亡，他会依然存活。如果清醒的水手被处决，宣布该玩家被处决但依然存活。（不要说明原因。）");
    g_tipLine[9563] = StringToText("【提示标记】");
    g_tipLine[9564] = StringToText("· 醉酒");
    g_tipLine[9565] = StringToText("放置时机：在水手夜晚行动并选择了玩家后。");
    g_tipLine[9566] = StringToText("放置条件：由说书人来选择水手醉酒还是水手选择的玩家醉酒，并在对应角色标记旁放置醉酒提示标记。");
    g_tipLine[9567] = StringToText("  水手无法选择已死亡的玩家。若此时水手醉酒中毒，不放置该标记。");
    g_tipLine[9568] = StringToText("移除时机：在黄昏时，或水手死亡或离场时。");
    g_tipLine[9569] = StringToText("【提示与技巧】");
    g_tipLine[9570] = StringToText("· 显而易见...如果你在晚上选择了一个镇民，你很可能不会醉酒。如果你选择了一个外来者，爪牙，或恶魔，你可能醉酒。");
    g_tipLine[9571] = StringToText("  水手的生存能力非常强大，说书人通常会抓住一切机会让善良阵营玩家为水手的存活付出代价，只要有可能就会让镇民醉酒，");
    g_tipLine[9572] = StringToText("  而你选择了非镇民玩家就会让你醉酒。");
    g_tipLine[9573] = StringToText("· 选择你想醉酒的玩家，比如你怀疑的邪恶玩家，或者是目前没有其他人有用的镇民。");
    g_tipLine[9574] = StringToText("  一个醉酒的祖母或一个醉酒的弄臣可能比一个醉酒的驱魔人或一个醉酒的侍臣危害要小。");
    g_tipLine[9575] = StringToText("· 通过让其他玩家醉酒来最大化你的生存能力。如果你一直选择镇民，特别是能力强大的镇民，");
    g_tipLine[9576] = StringToText("  你可以比其他玩家更容易活到最后一天。");
    g_tipLine[9577] = StringToText("· 告诉玩家晚上你选了谁，让他们知道他们可能喝醉了。这是至关重要的。例如，");
    g_tipLine[9578] = StringToText("  一个醉酒的旅店老板需要知道他们的能力可能在没有玩家死亡的晚上其实没起作用，");
    g_tipLine[9579] = StringToText("  或者醉酒的侍女需要知道他们的信息可能是假的。");
    g_tipLine[9580] = StringToText("· 与其他玩家交流，寻找好的买醉对象。你不会想和你不清楚角色的玩家买醉的...你要喝就要找知晓的那几个。");
    g_tipLine[9581] = StringToText("  如果你能分辨出一些玩家的角色，你就能更好地为善良阵营团队工作。有些人，醉了会更好。");
    g_tipLine[9582] = StringToText("· 你可以通过故意被处决来证明你就是那个水手。如果你没有醉酒，你就不会死。从这一点开始，如果团队确信你确实是水手，");
    g_tipLine[9583] = StringToText("  而不是简单地受到魔鬼代言人的保护，那么你应该能够活到最后一天，这使善良阵营的团队找到恶魔的机会大大增加。");
    g_tipLine[9584] = StringToText("  毕竟...他们知道恶魔不是你。");
    g_tipRoleAt[23] = 9538; g_tipRoleN[23] = 47; g_tipP1At[23] = 9541; g_tipP1N[23] = 11; g_tipP2At[23] = 0; g_tipP2N[23] = 0;
    g_tipAbility[23] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会醉酒直到下个黄昏。你不会死亡。");
    g_tipLine[9585] = StringToText("【背景故事】");
    g_tipLine[9586] = StringToText("「我没有看到任何不寻常的事，夫人。请原谅我，但要是我真的看到了什么，");
    g_tipLine[9587] = StringToText("  那一定不是屋子主人在大约十一点的时候溜进了教授的实验室还把那些花花绿绿的药剂混合在了一起，就如你所说的那样，");
    g_tipLine[9588] = StringToText("  女士。」");
    g_tipLine[9589] = StringToText("【角色能力】");
    g_tipLine[9590] = StringToText("每个夜晚，你要选择除你以外的两名存活的玩家：你会得知他们中有几人在当晚因其自身能力而被唤醒。");
    g_tipLine[9591] = StringToText("【角色简介】");
    g_tipLine[9592] = StringToText("侍女能得知谁在夜晚被唤醒过。");
    g_tipLine[9593] = StringToText("· 每个夜晚，侍女需要选择两名玩家，并得知他们是否在当晚被唤醒过。侍女必须选择存活的玩家，且不能选择自己。");
    g_tipLine[9594] = StringToText("  这个能力不会探查出这些玩家中谁被唤醒过，仅仅是告知数量。");
    g_tipLine[9595] = StringToText("· 侍女的能力只会探查到为了使用自己的能力而被唤醒的角色。该能力不会探查因任何其他原因被唤醒的角色——例如说书人唤醒");
    g_tipLine[9596] = StringToText("  爪牙让他们得知谁是恶魔，唤醒恶魔给与他在首个夜晚会获得的恶魔信息，因另一个角色的能力而唤醒一位玩家，");
    g_tipLine[9597] = StringToText("  或是不小心唤醒了某个人。");
    g_tipLine[9598] = StringToText("· 如果一名角色在之前的夜晚被唤醒，但在这个夜晚没有，就不会被侍女探查到。");
    g_tipLine[9599] = StringToText("· 中毒或醉酒的玩家当晚因自己的能力被唤醒，仍然会计算在内。");
    g_tipLine[9600] = StringToText("· 如果侍女不小心选择了已死亡的玩家或是自己，说书人应提醒她重新选择。（该条规则的细节，可以参考互动干扰页面。）");
    g_tipLine[9601] = StringToText("【范例】");
    g_tipLine[9602] = StringToText("侍女选择了驱魔人和旅店老板，并得知了「2」。在接下来的一个夜晚，驱魔人选择了沙巴洛斯，这会导致沙巴洛斯被唤醒。");
    g_tipLine[9603] = StringToText("  同一晚，侍女选择了沙巴洛斯和弄臣。因为沙巴洛斯只因驱魔人的能力被唤醒，侍女得知了「0」。");
    g_tipLine[9604] = StringToText("现在是第二个夜晚。侍女选择了祖母和邪恶的莽夫，并得知了「2」。莽夫当晚会被唤醒，但是侍女醉酒了。");
    g_tipLine[9605] = StringToText("现在是首个夜晚。侍女选择了刺客和月之子，并得知了「0」，因为刺客在首个夜晚不会被唤醒来使用自己的能力。");
    g_tipLine[9606] = StringToText("  在下一个夜晚，侍女选择了刺客和造谣者。刺客被唤醒但没有使用自己的能力。造谣者使用了自己的能力，");
    g_tipLine[9607] = StringToText("  但造谣者使用能力不需要被唤醒。侍女得知了「1」。");
    g_tipLine[9608] = StringToText("【运作方式】");
    g_tipLine[9609] = StringToText("每个夜晚，唤醒侍女。让侍女指向除自己外任意两名存活的玩家。用手势向侍女比划出所选角色中当晚被唤醒过的数量（0，");
    g_tipLine[9610] = StringToText("  1，或2）。让侍女重新入睡。");
    g_tipLine[9611] = StringToText("如果没有两名存活玩家能够选择（由于主谋、僵怖等的能力造成），不要唤醒侍女。");
    g_tipLine[9612] = StringToText("【提示标记】");
    g_tipLine[9613] = StringToText("无");
    g_tipLine[9614] = StringToText("【规则细节】");
    g_tipLine[9615] = StringToText("· 相克规则：");
    g_tipLine[9616] = StringToText("  · 数学家：侍女会得知数学家是否醒来，即使她是在数学家之前醒来。");
    g_tipLine[9617] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[9618] = StringToText("  · 引路人：侍女会得知引路人是否醒来，即使她是在引路人之前醒来。");
    g_tipLine[9619] = StringToText("【提示与技巧】");
    g_tipLine[9620] = StringToText("· 你的能力并不能直接检测出邪恶的玩家--但是可以检测出那些对自己的角色能力撒谎的玩家。");
    g_tipLine[9621] = StringToText("  这可以用于发现善良或是邪恶的玩家，因为许多善良的玩家有理由对他们的角色说谎......至少在最开始可能会这样。");
    g_tipLine[9622] = StringToText("  如果你发现有人在撒谎，看看他们怎么自圆其说。善良的玩家通常会坦白他们的真实角色，");
    g_tipLine[9623] = StringToText("  而邪恶的玩家将不得不选择第二次虚张声势来配合你的信息，或者加倍地坚持他们的主张。");
    g_tipLine[9624] = StringToText("· 挑选玩家使用能力来验证他们的发言。如果有人声称自己是赌徒，他们每天晚上都会醒来--检查他们，看他们是否诚实。");
    g_tipLine[9625] = StringToText("  再比如，声称自己是侍臣的人每晚都会醒来，直到他们使用了自己的能力--如果他们声称对某人使用了能力，");
    g_tipLine[9626] = StringToText("  你可以通过看他们第二天晚上是否醒来来检查他们的话是否属实。");
    g_tipLine[9627] = StringToText("· 在游戏的初期，你可以在玩家透露他们的角色之前，告诉他们你获取的信息，这会让他们愿意相信你。");
    g_tipLine[9628] = StringToText("· 连续几晚选择相同的玩家。有些角色的行动在每个夜晚并不一致。例如，一个自称是旅店老板的刺客可能在你选择他的时候醒来");
    g_tipLine[9629] = StringToText("  ，这时候看上去是合理的。然而，一旦他杀了人，他就不会再醒来，这时候你再查他，就会发现他不诚实。");
    g_tipLine[9630] = StringToText("· 找到一个夜间不醒来的玩家（如弄臣或吟游诗人--如果你信任这个玩家，你可以把他们作为彻底检查一个人的基础。");
    g_tipLine[9631] = StringToText("  由于弄臣或吟游诗人总是会给你一个0，你知道任何读到的 \"1 \"一定是来自你选择的另一个玩家。）这种方法比较慢，");
    g_tipLine[9632] = StringToText("  而且给你带来的信息比较少，但对另一个玩家的关注会相对准确。");
    g_tipLine[9633] = StringToText("· 尽可能多的挑选玩家，撒下一张大网，获得整个城镇的大量信息。在黯月初升中，死亡可能随时降临，");
    g_tipLine[9634] = StringToText("  在与其他玩家和他们的信息/发言进行比较时，广泛的信息会让你的能力更有价值。");
    g_tipRoleAt[24] = 9585; g_tipRoleN[24] = 50; g_tipP1At[24] = 9589; g_tipP1N[24] = 12; g_tipP2At[24] = 9614; g_tipP2N[24] = 5;
    g_tipAbility[24] = StringToText("每个夜晚，你要选择除你以外的两名存活的玩家：你会得知他们中有几人在当晚因其自身能力而被唤醒。");
    g_tipLine[9635] = StringToText("【背景故事】");
    g_tipLine[9636] = StringToText("「每一个不洁之灵，每一份撒旦之力，每一次炼狱敌人的猛袭，每一个军团，每一个崇拜恶魔的组织和教派，");
    g_tipLine[9637] = StringToText("  以我主耶稣基督的名义和力量，将你们驱逐。我命令你们，远离上帝的教堂，");
    g_tipLine[9638] = StringToText("  远离上帝按祂的形貌所创造并受神圣羔羊的宝血所救赎的灵魂。」");
    g_tipLine[9639] = StringToText("【角色能力】");
    g_tipLine[9640] = StringToText("每个夜晚*，你要选择一名玩家（与上个夜晚不同）：如果你选中了恶魔，他会得知你是驱魔人，");
    g_tipLine[9641] = StringToText("  但他当晚不会因其自身能力而被唤醒。");
    g_tipLine[9642] = StringToText("【角色简介】");
    g_tipLine[9643] = StringToText("驱魔人能阻止恶魔被唤醒来发动攻击。");
    g_tipLine[9644] = StringToText("· 除首个夜晚以外的每个夜晚，驱魔人都需要选择一名玩家。如果所选玩家不是恶魔，恶魔仍然可以发动攻击。如果选中了恶魔，");
    g_tipLine[9645] = StringToText("  恶魔当晚不会被唤醒，因而当晚不会选择玩家进行攻击。恶魔会得知他不能发动攻击，且得知谁是驱魔人。");
    g_tipLine[9646] = StringToText("· 任何其他恶魔能力仍然会生效——例如僵怖被杀后依然保持存活，普卡会杀死他在上一个夜晚攻击的玩家，");
    g_tipLine[9647] = StringToText("  或是沙巴洛斯反刍一名玩家。");
    g_tipLine[9648] = StringToText("· 驱魔人不能连续两个夜晚选择同一名玩家。");
    g_tipLine[9649] = StringToText("【范例】");
    g_tipLine[9650] = StringToText("驱魔人选择了沙巴洛斯。沙巴洛斯当晚不会杀人。在黎明，说书人宣布当晚无人死亡。");
    g_tipLine[9651] = StringToText("驱魔人选择了普卡。普卡当晚不会被唤醒来发动攻击，但是因为普卡在前一个夜晚的攻击，仍然会有一名玩家死亡。");
    g_tipLine[9652] = StringToText("珀选择不攻击任何人。在下一个夜晚，驱魔人选择了珀。珀当晚不会被唤醒进行攻击。再下一个夜晚，驱魔人选择了刺客。");
    g_tipLine[9653] = StringToText("  刺客仍然可以在当晚发动攻击，并且珀选择攻击三名玩家，因为珀在上次选择时（两天前）没有选择任何玩家。");
    g_tipLine[9654] = StringToText("【运作方式】");
    g_tipLine[9655] = StringToText("除了首个夜晚以外的每个夜晚，唤醒驱魔人。让驱魔人指向任意一名玩家。（如果驱魔人指向上一夜选择过的玩家，");
    g_tipLine[9656] = StringToText("  摇头表示否定，并让他指向另一名玩家。）将「被选择」提示标记放置到所选玩家的角色标记旁。让驱魔人重新入睡。");
    g_tipLine[9657] = StringToText("如果驱魔人选择了恶魔，唤醒恶魔。向恶魔展示「该角色的能力对你生效」信息标记以及驱魔人角色标记，");
    g_tipLine[9658] = StringToText("  然后指向驱魔人玩家。并让恶魔重新入睡。当晚的后续时段中，不要因为恶魔的自身能力唤醒恶魔。");
    g_tipLine[9659] = StringToText("被驱魔人选中的恶魔不会被唤醒来使用自己的能力，但是如果有需要的话，仍然会因其他角色的能力被再次唤醒。");
    g_tipLine[9660] = StringToText("  在将驱魔人与来自其他剧本的角色一同使用时，这一点可以提供参考。");
    g_tipLine[9661] = StringToText("【提示标记】");
    g_tipLine[9662] = StringToText("· 被选择");
    g_tipLine[9663] = StringToText("放置时机：在驱魔人夜晚行动并选择了玩家后。");
    g_tipLine[9664] = StringToText("放置条件：在驱魔人选择的玩家角色标记旁放置。驱魔人不能选择已经放置有「被选择」标记的玩家。");
    g_tipLine[9665] = StringToText("  不论驱魔人是否醉酒中毒，都要放置该标记。");
    g_tipLine[9666] = StringToText("移除时机：在驱魔人选择了下一个目标后，或驱魔人死亡或离场时。");
    g_tipLine[9667] = StringToText("【规则细节】");
    g_tipLine[9668] = StringToText("· 相克规则：");
    g_tipLine[9669] = StringToText("  · 利维坦：如果利维坦提名并处决了驱魔人选择的那名玩家，善良阵营获胜。");
    g_tipLine[9670] = StringToText("  · 暴乱：如果暴乱提名并处决了驱魔人选择的那名玩家，善良阵营获胜。");
    g_tipLine[9671] = StringToText("  · 牙噶巴卜：如果驱魔人选中了牙噶巴卜，那么牙噶巴卜在当晚无法造成死亡。");
    g_tipLine[9672] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[9673] = StringToText("  · 姑获鸟：一名已获得过爪牙能力的姑获鸟被驱魔人选中，他能够因为爪牙的能力被唤醒。");
    g_tipLine[9674] = StringToText("【提示与技巧】");
    g_tipLine[9675] = StringToText("· 如果你在晚上选择了一个玩家，并且当晚没有人死亡，你可能已经找到了恶魔！要么在第二个白天就公开告诉大家你是谁，");
    g_tipLine[9676] = StringToText("  你选择了谁，要么等一两个晚上，再选择同一个玩家，这样可以确定一下。有时，由于其他原因，晚上不会出现死亡，");
    g_tipLine[9677] = StringToText("  但如果你多次选择同一个玩家，而且每次晚上都没有死亡，你就可以相当肯定地认为你已经找到了恶魔。");
    g_tipLine[9678] = StringToText("· 当你使用了能力之后，如果还是有玩家在晚上死亡，在接下来的所有晚上不需要再选择那名玩家，");
    g_tipLine[9679] = StringToText("  因为你较大概率已经选择了一个非恶魔的玩家。");
    g_tipLine[9680] = StringToText("· 随着游戏的进行，与其他玩家多交流，调查哪些角色在游戏中，以及他们是如何行动的。即使你选中了恶魔，");
    g_tipLine[9681] = StringToText("  使他丧失杀人的能力，也有很多其他可能会在夜间发生死亡的情况。当然，就算你选择了一个非恶魔的玩家，");
    g_tipLine[9682] = StringToText("  也可能晚上不发生死亡。例如，珀选着晚上不行动，赌徒赌死了自己，造谣者发表了一个正确的声明而导致死亡，修补匠暴毙，");
    g_tipLine[9683] = StringToText("  茶艺师保护了外来者和镇民导致没有人死亡，旅店老板选择了恶魔晚上刀的玩家，弄臣被教父攻击但没有死亡等等。");
    g_tipLine[9684] = StringToText("· 作为驱魔人，你在游戏初期往往很弱，但随着游戏的进行，你的力量会成倍增加--因为你不仅了解到哪些玩家不是恶魔，");
    g_tipLine[9685] = StringToText("  而且可以选择的存活玩家也越来越少。前几天尽量活着，在你有一些可靠的信息之前最好不要透露你是驱魔人。");
    g_tipLine[9686] = StringToText("  如果你太早透露，而你还没有找到恶魔，那么你会变成恶魔的头号目标。要么保持沉默，要么虚张声势，");
    g_tipLine[9687] = StringToText("  扮演恶魔不想杀的角色，如水手, 弄臣或是莽夫。");
    g_tipLine[9688] = StringToText("· 如果你怀疑僵怖在游戏中，大可去选择死亡的玩家。如果白天没人有死亡，而你当晚驱除了一个死亡的玩家，当晚没有死亡，");
    g_tipLine[9689] = StringToText("  那你很可能找到了一个僵怖。");
    g_tipLine[9690] = StringToText("· 一旦你成功选择了恶魔，恶魔就会知道你是谁。从这一点上看，要寻找谁在试图杀死你。");
    g_tipLine[9691] = StringToText("  恶魔和他们的爪牙会想尽办法让你被处决，因为如果你在晚上找到恶魔后立即死亡，恶魔就会暴露他们的位置。");
    g_tipLine[9692] = StringToText("· 如果你已经公开以驱魔人的角色出场，你每天都可以有效地说服大家找出2个不是恶魔的玩家。如果有2名玩家特别可疑，");
    g_tipLine[9693] = StringToText("  你可以处决其中一人，并承诺为另一人驱魔。");
    g_tipRoleAt[25] = 9635; g_tipRoleN[25] = 59; g_tipP1At[25] = 9639; g_tipP1N[25] = 10; g_tipP2At[25] = 9667; g_tipP2N[25] = 7;
    g_tipAbility[25] = StringToText("每个夜晚*，你要选择一名玩家（与上个夜晚不同）：如果你选中了恶魔，他会得知你是驱魔人，但他当晚不会因其自身能力而被唤醒。");
    g_tipLine[9694] = StringToText("【背景故事】");
    g_tipLine[9695] = StringToText("「到里头来，美丽的旅者，放松筋骨，好好歇息。尽管饮酒作乐，黑暗之物今夜无法伤你分毫。」");
    g_tipLine[9696] = StringToText("【角色能力】");
    g_tipLine[9697] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会醉酒到下个黄昏。");
    g_tipLine[9698] = StringToText("【角色简介】");
    g_tipLine[9699] = StringToText("旅店老板在夜晚保护玩家们免于死亡，但是某些人在此过程中会醉酒。");
    g_tipLine[9700] = StringToText("· 与僧侣类似，旅店老板能让玩家们不被恶魔杀死。受保护的玩家也不会因为外来者、爪牙、镇民和旅行者的能力而死亡。");
    g_tipLine[9701] = StringToText("· 旅店老板只在夜晚保护玩家，并不包括白天。");
    g_tipLine[9702] = StringToText("· 旅店老板选择的两名玩家其中之一将在当晚和下一个白天醉酒。该玩家可以是善良的或邪恶的，但几乎总会是善良的，");
    g_tipLine[9703] = StringToText("  这取决于你的游戏走向。选择了自己的旅店老板可能会醉酒，这意味着他会失去能力并且当晚可以死亡，");
    g_tipLine[9704] = StringToText("  而他保护的另一个人也不再安全。");
    g_tipLine[9705] = StringToText("【范例】");
    g_tipLine[9706] = StringToText("旅店老板保护了弄臣和侍女。说书人选择让弄臣醉酒。明天，当弄臣被处决时，他会死亡，即使他还没有使用自己的能力。");
    g_tipLine[9707] = StringToText("旅店老板保护了刺客和珀。说书人选择让刺客醉酒。当晚的后续时段中，刺客使用了自己的能力，但是无事发生。");
    g_tipLine[9708] = StringToText("旅店老板保护了他自己和和平主义者。说书人选择让旅店老板醉酒。当晚，恶魔攻击了和平主义者，和平主义者死亡。");
    g_tipLine[9709] = StringToText("【运作方式】");
    g_tipLine[9710] = StringToText("除了首个夜晚以外的每个夜晚，唤醒旅店老板。让旅店老板指向任意两名玩家。让旅店老板重新入睡。将「不会死亡」");
    g_tipLine[9711] = StringToText("  提示标记放置到所选的两个角色标记旁。所选玩家其中一人醉酒——将「醉酒」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[9712] = StringToText("  标有「不会死亡」的玩家当晚不会死亡。");
    g_tipLine[9713] = StringToText("在黎明，移除「不会死亡」提示标记。");
    g_tipLine[9714] = StringToText("在黄昏，移除「醉酒」提示标记。");
    g_tipLine[9715] = StringToText("【提示标记】");
    g_tipLine[9716] = StringToText("· 不会死亡");
    g_tipLine[9717] = StringToText("放置时机：在旅店老板夜晚行动并选择了玩家后。");
    g_tipLine[9718] = StringToText("放置条件：在旅店老板选择的两名玩家的角色标记旁分别各放置一个此标记。若此时旅店老板醉酒中毒，不放置该标记。");
    g_tipLine[9719] = StringToText("移除时机：在黎明时，或旅店老板死亡或离场时。");
    g_tipLine[9720] = StringToText("· 醉酒");
    g_tipLine[9721] = StringToText("放置时机：在成功放置了旅店老板的「不会死亡」提示标记后。");
    g_tipLine[9722] = StringToText("放置条件：在旅店老板当晚选择的两名玩家之中，由说书人选择一名玩家，在他的角色标记旁放置。");
    g_tipLine[9723] = StringToText("移除时机：在黄昏时，或旅店老板死亡或离场时。");
    g_tipLine[9724] = StringToText("【规则细节】");
    g_tipLine[9725] = StringToText("· 相克规则：");
    g_tipLine[9726] = StringToText("  · 利维坦：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[9727] = StringToText("  · 暴乱：如果暴乱提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[9728] = StringToText("【提示与技巧】");
    g_tipLine[9729] = StringToText("· 你的能力很强大，如果有效使用，你可以阻止邪恶阵营的侵害，并保护善良玩家的安全。然而，");
    g_tipLine[9730] = StringToText("  这是有代价的——任何受你保护的人都变得不可靠，因为他们可能会在幸存的那晚醉酒。与强力的玩家合作，保护关键的角色，");
    g_tipLine[9731] = StringToText("  这非常重要——某些角色（例如和平主义者和驱魔人）生存时间越长越强大。");
    g_tipLine[9732] = StringToText("· 注意你的能力会导致醉酒！不要保护在当晚需要接收可靠信息的人或那些将使用他们能力的人。例如，");
    g_tipLine[9733] = StringToText("  如果你知道一个侍臣即将使用他们的能力，你保护他们可能会导致他们醉酒因此浪费他们的强大能力！");
    g_tipLine[9734] = StringToText("· 你保护的人，与你公开声称要保护的人，可以不一样。因为如果邪恶阵营相信你说的话，");
    g_tipLine[9735] = StringToText("  他们不会想浪费时间瞄准那些不能被杀死的玩家。同时，你秘密地保护其他可能成为受害者的玩家，希望他们能免遭杀戮。");
    g_tipLine[9736] = StringToText("· 用自己的能力保护自己似乎是个好主意，但通常不建议这样做——因为说书人很可能会选择让你醉酒，让你的保护完全失效，");
    g_tipLine[9737] = StringToText("  这样你和另一个玩家都会很危险。");
    g_tipLine[9738] = StringToText("· 如果你认为你至少辨别了2个邪恶的玩家，请同时选择他们！保护他们免于死亡并不理想，");
    g_tipLine[9739] = StringToText("  但这确实意味着他们中的一个会在那天晚上醉酒。如果你设法抓住了恶魔或像刺客或魔鬼代言人这样的强大爪牙，");
    g_tipLine[9740] = StringToText("  你就从源头上切断了邪恶的能力！但是，如果你选错了，那么大概率就是善良玩家醉酒了。");
    g_tipRoleAt[26] = 9694; g_tipRoleN[26] = 47; g_tipP1At[26] = 9696; g_tipP1N[26] = 9; g_tipP2At[26] = 9724; g_tipP2N[26] = 4;
    g_tipAbility[26] = StringToText("每个夜晚*，你要选择两名玩家：他们当晚不会死亡，但其中一人会醉酒到下个黄昏。");
    g_tipLine[9741] = StringToText("【背景故事】");
    g_tipLine[9742] = StringToText("「正面，我赢。");
    g_tipLine[9743] = StringToText("反面，你输。」");
    g_tipLine[9744] = StringToText("【角色能力】");
    g_tipLine[9745] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[9746] = StringToText("【角色简介】");
    g_tipLine[9747] = StringToText("赌徒能够猜测玩家的角色……但是猜错的代价是相当巨大的。");
    g_tipLine[9748] = StringToText("· 除了首个夜晚以外的每个夜晚，赌徒需要选择一名玩家，并在角色列表上指向一个角色图标来猜测其角色。如果猜测正确，");
    g_tipLine[9749] = StringToText("  无事发生。如果猜测错误，赌徒死亡。");
    g_tipLine[9750] = StringToText("· 赌徒不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[9751] = StringToText("· 赌徒可以选择任何玩家，无论是已死亡还是存活，甚至可以是赌徒自己。");
    g_tipLine[9752] = StringToText("【范例】");
    g_tipLine[9753] = StringToText("赌徒指向吟游诗人玩家，然后指向吟游诗人图标。本次猜测正确，因此赌徒依然存活，但是当晚他还是被恶魔杀死了。");
    g_tipLine[9754] = StringToText("魔鬼代言人正试图伪装成和平主义者。当晚，赌徒指向魔鬼代言人玩家，然后指向和平主义者图标。本次猜测错误，");
    g_tipLine[9755] = StringToText("  因此赌徒死亡。");
    g_tipLine[9756] = StringToText("【运作方式】");
    g_tipLine[9757] = StringToText("除了首个夜晚以外的每个夜晚，唤醒赌徒。让赌徒指向任意一名玩家，然后指向角色列表上的任意一个角色图标。");
    g_tipLine[9758] = StringToText("  让赌徒重新入睡。如果所选的玩家的角色和所选角色图标不同，赌徒死亡——将「死亡」提示标记放置到赌徒的角色标记旁。");
    g_tipLine[9759] = StringToText("【提示标记】");
    g_tipLine[9760] = StringToText("· 死亡");
    g_tipLine[9761] = StringToText("放置时机：在赌徒夜晚行动后。");
    g_tipLine[9762] = StringToText("放置条件：如果赌徒的猜测错误，且赌徒可以死亡，则将此标记放置在赌徒角色标记旁，");
    g_tipLine[9763] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。若此时赌徒醉酒中毒，则无论猜测正确与否，均不放置该标记。");
    g_tipLine[9764] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[9765] = StringToText("【提示与技巧】");
    g_tipLine[9766] = StringToText("· 这是一个高风险，高回报的角色。你得到的信息不容易被影响，但你随时可能付出你生命，多么刺激！");
    g_tipLine[9767] = StringToText("· 你的最强用途之一，就是用你的能力去确认其他善良玩家的角色。得知几个玩家及其角色将大大有助于建立信任，");
    g_tipLine[9768] = StringToText("  例如可以大概率去确认：一个玩家没有被处决成功，是一个和平主义者正在发挥作用，或者自称侍女的玩家没有在说谎。");
    g_tipLine[9769] = StringToText("· 选择你最想知道角色的善良玩家。你的能力意味着很难活到最后一天，所以在你的运气用完之前，尽量使你的信息更有价值。");
    g_tipLine[9770] = StringToText("  这可能意味着为了确认像驱魔人或侍臣这样的强大角色，而赌上自己的性命去信任这名玩家，");
    g_tipLine[9771] = StringToText("  这会在关键时刻善良阵营大有裨益。");
    g_tipLine[9772] = StringToText("· 是很谨慎地进行一场有充分理由的赌博，还是将这一切都留给幸运女神，这两种玩法是有区别的。");
    g_tipLine[9773] = StringToText("  你的确可以尝试猜测邪恶的角色，但是即使你非常强烈地怀疑某人是邪恶的，你仍然必须猜测他们是哪种爪牙和恶魔，");
    g_tipLine[9774] = StringToText("  爪牙和恶魔都有四种！这赔率对你并不有利。话虽如此...如果你猜对了，那恭喜你获得头等奖。");
    g_tipLine[9775] = StringToText("· 你可以故意死去，以证明你是赌徒。这似乎有悖常理，但如果你有几个已经确认过的玩家，你想消除对自己可靠性的任何怀疑，");
    g_tipLine[9776] = StringToText("  那你可以预言你自己的死亡（最好是私下里告诉你信任的人），然后那天晚上，选择猜测错误。以这种方式死去，");
    g_tipLine[9777] = StringToText("  你会很容易获得信任。");
    g_tipLine[9778] = StringToText("· 如果你不知道该猜谁，你可以猜自己。既然你肯定知道自己是赌徒，那么你的能力绝对不会在那天晚上杀死你，");
    g_tipLine[9779] = StringToText("  从而保证你的猜测不对自己的死负责。如果你怀疑自己可能在夜间被狡猾的恶魔或刺客盯上，");
    g_tipLine[9780] = StringToText("  这也很有用——如果你选择猜测自己并且仍然死亡，那你肯定是被邪恶势力盯上了！");
    g_tipRoleAt[27] = 9741; g_tipRoleN[27] = 40; g_tipP1At[27] = 9744; g_tipP1N[27] = 8; g_tipP2At[27] = 0; g_tipP2N[27] = 0;
    g_tipAbility[27] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[9781] = StringToText("【背景故事】");
    g_tipLine[9782] = StringToText("「巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉巴拉。巴拉。」");
    g_tipLine[9783] = StringToText("【角色能力】");
    g_tipLine[9784] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[9785] = StringToText("【角色简介】");
    g_tipLine[9786] = StringToText("造谣者会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[9787] = StringToText("· 每个白天，造谣者可以公开发表一个声明。如果该声明是正确的，说书人会在当晚杀死一名玩家。如果声明是错误的，");
    g_tipLine[9788] = StringToText("  那就没有玩家会因造谣者而死。");
    g_tipLine[9789] = StringToText("· 含糊不清的词语、低声细语、说书人无法判断对错的声明、或是发表声明时有人没听到等情况下，声明都不作数。");
    g_tipLine[9790] = StringToText("  如同猎手的能力，说书人和每一名玩家都必须要听到并明确造谣者发表的声明，明白造谣者正在使用自己的能力，");
    g_tipLine[9791] = StringToText("  以此来让说书人判定接下来会发生什么。");
    g_tipLine[9792] = StringToText("· 如果造谣者在白天处于醉酒或中毒时发表了一个正确的声明，但当晚造谣者能力触发时他恢复了清醒和健康，");
    g_tipLine[9793] = StringToText("  那么说书人仍然会杀死一名玩家。");
    g_tipLine[9794] = StringToText("【范例】");
    g_tipLine[9795] = StringToText("在白天，造谣者说：「我是造谣者。我的公开声明是：恶魔戴着帽子。」恶魔没有戴帽子。当晚，");
    g_tipLine[9796] = StringToText("  没有玩家因造谣者的能力而死亡。");
    g_tipLine[9797] = StringToText("与造谣者邻近的玩家分别是善良的旅行者和和平主义者。在白天，醉酒的造谣者说：「我的两个邻近玩家都是善良的。」");
    g_tipLine[9798] = StringToText("  在黄昏，醉酒的造谣者恢复清醒。当晚，侍女死亡。");
    g_tipLine[9799] = StringToText("在白天，造谣者发表了一个正确的声明。当晚，造谣者被恶魔杀死。造谣者失去了自己的能力，");
    g_tipLine[9800] = StringToText("  因此不会有任何人因为他正确的声明而死亡。");
    g_tipLine[9801] = StringToText("【运作方式】");
    g_tipLine[9802] = StringToText("每个白天，如果造谣者发表了一个明确且正确的公开声明，将造谣者的「死亡」提示标记放置到魔典左侧的中央，");
    g_tipLine[9803] = StringToText("  来提醒自己当晚需要放置该标记。");
    g_tipLine[9804] = StringToText("除了首个夜晚以外的每个夜晚，如果今天白天造谣者发表了一个明确且正确的公开声明，");
    g_tipLine[9805] = StringToText("  你选择任意一名玩家死亡——将「死亡」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[9806] = StringToText("在选择因造谣者能力而死亡的玩家时，我们推荐你选择能够死亡的角色，不要选择那些受到能力保护而无法死亡的角色（例如弄臣");
    g_tipLine[9807] = StringToText("  或茶艺师的能力）。当声明造成死亡时，造谣者才能得到更多信息。这对善良阵营更有帮助，也会让游戏更加有趣。");
    g_tipLine[9808] = StringToText("【提示标记】");
    g_tipLine[9809] = StringToText("· 死亡");
    g_tipLine[9810] = StringToText("放置时机：在造谣者发表了公开声明后。");
    g_tipLine[9811] = StringToText("放置条件：如果造谣者发表的公开声明清晰且正确，则将此标记放置在魔典中央，");
    g_tipLine[9812] = StringToText("  用以提醒说书人在轮到造谣者的夜晚顺序时选择一名玩家死亡。不论造谣者醉酒中毒，只要声明正确，那么都需要放置标记。");
    g_tipLine[9813] = StringToText("特殊说明：由于造谣者的能力为回溯型能力，因此如果造谣者在游戏中途产生，");
    g_tipLine[9814] = StringToText("  仍然要根据当前情况补放标记（如果那个玩家在白天进行了公开声明且为真），");
    g_tipLine[9815] = StringToText("  而不是因为没有放置标记便不在夜晚继续处理造谣者的能力生效情况。");
    g_tipLine[9816] = StringToText("移动条件：在轮到造谣者的夜晚行动时，将此标记移动至任意一名玩家的角色标记旁，");
    g_tipLine[9817] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家（应倾向于选择能够死亡的玩家）。若此时造谣者醉酒中毒，");
    g_tipLine[9818] = StringToText("  或造谣者死亡或离场，则直接移除该标记。");
    g_tipLine[9819] = StringToText("移除时机：在黎明时宣布了死亡玩家之后，或造谣者死亡或离场时移除。");
    g_tipLine[9820] = StringToText("【提示与技巧】");
    g_tipLine[9821] = StringToText("· 克服对死亡的恐惧！很多造谣者都会试探性地使用他们的能力，因为他们担心会意外造成死亡。");
    g_tipLine[9822] = StringToText("  虽然你确实应该对任何可能导致死亡的能力保持谨慎，但信息的潜在收益足以弥补风险。要每天使用你的能力！");
    g_tipLine[9823] = StringToText("· 类似于梦殒春宵剧本中的艺术家，你是一个极其灵活和多才多艺的信息收集者。由于你可以就任何事情发表你喜欢的任何声明，");
    g_tipLine[9824] = StringToText("  你可以弥补善良阵营中的空白，验证其他玩家的信息，或者提出每个人都非常想知道但无法解决的问题！充分利用这一点，");
    g_tipLine[9825] = StringToText("  善良阵营的玩家将感谢你。");
    g_tipLine[9826] = StringToText("· 你的声明要准确！当你试图弄清楚某人是否因你的能力而死亡时，一个可能是真的或假的模糊声明（例如「恶魔昨天污蔑了一位");
    g_tipLine[9827] = StringToText("  善良玩家为邪恶的。」）对你没有帮助。取而代之的是，做出可能绝对正确或错误的二元声明（「昨天恶魔被提名。」）");
    g_tipLine[9828] = StringToText("· 故意说出你认为是错误的声明。这降低了你的能力杀死玩家的风险，但仍然能让你获取信息。如果没有人死（或者至少，");
    g_tipLine[9829] = StringToText("  你认为没有人因你的能力而死），那么你可以颠倒你的说法以获得真相！（例如，故意说「侍女不在游戏中」，");
    g_tipLine[9830] = StringToText("  因为其他玩家自称是侍女。当没有死亡发生时，你可以更相信他们的说法！）");
    g_tipLine[9831] = StringToText("· 故意说出你认为是正确的声明！这有两个原因，一，如果有人因为你的能力而死，");
    g_tipLine[9832] = StringToText("  很难否认你是造谣者（前提是你可以追溯这名玩家的死亡是因为你的能力，而不是其他原因。");
    g_tipLine[9833] = StringToText("  但如果是沙巴洛斯或珀这样的多刀恶魔这在游戏中，这个方法会不太有效！）。二，如果有人因为你的能力而死，");
    g_tipLine[9834] = StringToText("  那么你可以非常确信这个说法是真实的（毕竟故意说虚假的声明并不能说明你的能力失效，所以如果你怀疑自己能力失效，");
    g_tipLine[9835] = StringToText("  可以用这个方法确认！）");
    g_tipLine[9836] = StringToText("· 要谨慎考虑你声明时的游戏状态和时间。如果你在游戏末期声明真确，那么晚上额外的死亡可能导致邪恶团队获得胜利。");
    g_tipLine[9837] = StringToText("  由于活着的玩家数量很少，为了安全起见，尽量避免做任何可能导致额外死亡的声明。");
    g_tipLine[9838] = StringToText("· 不确定你能做出什么样的声明？下面有一些例子！");
    g_tipLine[9839] = StringToText("  · 「恶魔是僵怖。」");
    g_tipLine[9840] = StringToText("  · 「Steven是邪恶的。」");
    g_tipLine[9841] = StringToText("  · 「邪恶的玩家们邻座。」");
    g_tipLine[9842] = StringToText("  · 「刺客已经使用了他的能力。」");
    g_tipLine[9843] = StringToText("  · 「小明是侍臣。」");
    g_tipLine[9844] = StringToText("  · 「我的邻座是善良玩家。」");
    g_tipRoleAt[28] = 9781; g_tipRoleN[28] = 64; g_tipP1At[28] = 9783; g_tipP1N[28] = 11; g_tipP2At[28] = 0; g_tipP2N[28] = 0;
    g_tipAbility[28] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[9845] = StringToText("【背景故事】");
    g_tipLine[9846] = StringToText("「比起一只羊带领的一百头狮子，我更害怕一头狮子带领的一百只羊。」");
    g_tipLine[9847] = StringToText("【角色能力】");
    g_tipLine[9848] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个角色：如果该角色在场，该角色之一从当晚开始醉酒三天三夜。");
    g_tipLine[9849] = StringToText("【角色简介】");
    g_tipLine[9850] = StringToText("侍臣能使一个角色醉酒，且不需要知道该角色是哪名玩家。");
    g_tipLine[9851] = StringToText("· 每局游戏限一次，侍臣可以选择一个角色，使其醉酒三个夜晚和三个白天，立即生效。");
    g_tipLine[9852] = StringToText("· 侍臣不会得知自己成功或失败，因此侍臣可能会选到不在场的角色。");
    g_tipLine[9853] = StringToText("· 侍臣选择的是一个角色，而不是一名玩家。说书人可能需要提醒侍臣玩家注意这一点。");
    g_tipLine[9854] = StringToText("  也需要提醒试图伪装成侍臣的邪恶玩家注意这一点。");
    g_tipLine[9855] = StringToText("· 如果醉酒或中毒的侍臣选择了一个角色，该角色不会醉酒，即使侍臣于之后恢复了清醒和健康。如果侍臣使一个角色醉酒，");
    g_tipLine[9856] = StringToText("  但是侍臣变得醉酒或中毒，那名醉酒的玩家会重新恢复清醒。如果侍臣在三个夜晚和三个白天结束前又恢复了清醒和健康，");
    g_tipLine[9857] = StringToText("  那名被侍臣选中角色的玩家还是会继续醉酒。");
    g_tipLine[9858] = StringToText("【范例】");
    g_tipLine[9859] = StringToText("已经过去了四个夜晚，侍臣都被唤醒但没有使用自己的能力。在第五个夜晚，侍臣使沙巴洛斯醉酒。从今晚起的三个夜晚，");
    g_tipLine[9860] = StringToText("  沙巴洛斯能够行动，但是无法杀死任何人。");
    g_tipLine[9861] = StringToText("侍臣在醉酒时使用了自己的能力。无事发生，但侍臣再也不会被唤醒了。");
    g_tipLine[9862] = StringToText("侍臣使主谋醉酒。珀被处决而主谋依然存活。游戏结束，善良阵营获胜。");
    g_tipLine[9863] = StringToText("【运作方式】");
    g_tipLine[9864] = StringToText("每个夜晚，唤醒侍臣。侍臣要么摇头表示不使用能力，要么指向角色列表上的任意一个角色图标。让侍臣重新入睡。");
    g_tipLine[9865] = StringToText("如果侍臣使用了能力且该角色在场，对应的玩家当晚醉酒，持续三天三夜。将侍臣的「醉酒1」放置到该玩家的角色标记旁。");
    g_tipLine[9866] = StringToText("  在下一夜，将「醉酒1」替换成「醉酒2」。再下一夜，将「醉酒2」替换成「醉酒3」。再下一夜的黄昏，移除「醉酒3」，");
    g_tipLine[9867] = StringToText("  且侍臣失去能力。将「失去能力」提示标记放置到侍臣角色标记旁，并从夜晚顺序表上移除其夜晚标记。");
    g_tipLine[9868] = StringToText("在侍臣选择了角色使其醉酒后，在本局游戏的剩余时段内不再唤醒侍臣。");
    g_tipLine[9869] = StringToText("在其他的剧本中，场上可能会出现多个相同角色。侍臣只能让他选择的角色所对应的玩家其中之一醉酒。");
    g_tipLine[9870] = StringToText("【提示标记】");
    g_tipLine[9871] = StringToText("· 醉酒1");
    g_tipLine[9872] = StringToText("放置时机：在侍臣夜晚行动时选择使用能力，并选择了剧本列表上的一个角色后。");
    g_tipLine[9873] = StringToText("放置条件：如果侍臣未醉酒中毒，且他选择的角色在场，在该角色的角色标记旁边放置。如果此时有多个该角色在场，");
    g_tipLine[9874] = StringToText("  由说书人选择其中一个角色并在这个角色标记旁放置。");
    g_tipLine[9875] = StringToText("移除时机：在黄昏时，将醉酒1替换成醉酒2，不论此时侍臣是否醉酒中毒。如果侍臣死亡或离场，则改为移除标记。");
    g_tipLine[9876] = StringToText("· 醉酒2");
    g_tipLine[9877] = StringToText("放置时机：当醉酒1放置且到达下一次黄昏时，将其替换成醉酒2。除此之外该标记不会放置。");
    g_tipLine[9878] = StringToText("放置条件：与醉酒1保持相同的目标。");
    g_tipLine[9879] = StringToText("移除时机：在放置醉酒2的下一个黄昏时，将醉酒2替换成醉酒3，不论此时侍臣是否醉酒中毒。如果侍臣死亡或离场，");
    g_tipLine[9880] = StringToText("  则改为移除标记。");
    g_tipLine[9881] = StringToText("· 醉酒3");
    g_tipLine[9882] = StringToText("放置时机：当醉酒2放置且到达下一次黄昏时，将其替换成醉酒3。除此之外该标记不会放置。");
    g_tipLine[9883] = StringToText("放置条件：与醉酒2保持相同的目标。");
    g_tipLine[9884] = StringToText("移除时机：在放置醉酒3的下一个黄昏时，将此标记移除并为侍臣放置失去能力标记，不论此时侍臣是否醉酒中毒。");
    g_tipLine[9885] = StringToText("  如果侍臣死亡或离场，也移除此标记。");
    g_tipLine[9886] = StringToText("· 失去能力");
    g_tipLine[9887] = StringToText("放置时机：当醉酒3放置且到达下一次黄昏时，或侍臣在醉酒中毒期间选择使用自己的能力时。");
    g_tipLine[9888] = StringToText("放置条件：在满足上述两种时机之一时，放置在侍臣角色标记旁。");
    g_tipLine[9889] = StringToText("移除时机：侍臣死亡或离场时。");
    g_tipLine[9890] = StringToText("【规则细节】");
    g_tipLine[9891] = StringToText("· 相克规则：");
    g_tipLine[9892] = StringToText("  · 维齐尔：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[9893] = StringToText("  · 召唤师：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[9894] = StringToText("【提示与技巧】");
    g_tipLine[9895] = StringToText("· 侍臣的独特之处在于你选择的是角色，而不是玩家。这意味着如果你选择了一个在游戏里中存在的角色，那他就会醉酒。");
    g_tipLine[9896] = StringToText("  这与投毒者不同，投毒者是选择让玩家中毒，而不管他们是什么角色。多亏了这一点，你可以使用一些不同的策略！");
    g_tipLine[9897] = StringToText("· 整个游戏你只能使用一次你的能力，所以要把握好时机！你做出选择的时间越晚，你那时候的信息越多，");
    g_tipLine[9898] = StringToText("  造成的混乱也可能越多。另一方面，邪恶阵营的玩家会尽快瞄准你，所以尽早使用你的能力可以确保你在死前使用出能力并获得");
    g_tipLine[9899] = StringToText("  一些信息。要由你来判断游戏的进程并做出选择！");
    g_tipLine[9900] = StringToText("· 显然，你能力最强的用途之一就是瞄准恶魔——如果你可以通过让恶魔醉酒来阻止恶魔，那么善良阵营玩家将有三晚的平安，");
    g_tipLine[9901] = StringToText("  而邪恶阵营将处于严重劣势。判断是哪个恶魔在游戏中的可靠方法是观察每晚的死亡人数——发现一个规律的话，");
    g_tipLine[9902] = StringToText("  你就可以在他们发动毁灭性攻击之前醉酒他们，比如致命的沙巴洛斯或狡猾的珀。");
    g_tipLine[9903] = StringToText("· 你可以使用的另一个强大策略是让爪牙醉酒。醉酒的刺客或教父无法在镇上造成额外死亡，");
    g_tipLine[9904] = StringToText("  但要把握好时机——只有在你确定这会帮助善良阵营的前提下，再这么做。选择灌醉魔鬼代言人或主谋就更阴险了，");
    g_tipLine[9905] = StringToText("  因为邪恶的阵营往往靠他们的能力在危急关头拯救他们，而醉酒不会马上被发现。");
    g_tipLine[9906] = StringToText("  一个认为自己背后有主谋的邪恶阵营可能会让他们的恶魔被处决，而事实上他们即将输掉游戏！");
    g_tipLine[9907] = StringToText("· 在大多数情况下，让善良阵营的玩家醉酒可能不是你能力使用的最佳选择，但实际上在某些情况下它确实是可行的。例如，");
    g_tipLine[9908] = StringToText("  醉酒的造谣者不能再随机死亡，醉酒的祖母不会与孙子一起死去，醉酒的月之子死亡后不会导致额外善良阵营玩家的死亡。");
    g_tipLine[9909] = StringToText("· 如果你怀疑某人可能不是他们声称的人，你可以选择他们声称的角色，看看他们的发言是否会发生变化。例如，");
    g_tipLine[9910] = StringToText("  如果一个侍女在你醉酒那个角色之后继续提供「真实」信息，或者一个驱魔人在应该被醉酒之后继续「阻止」恶魔，");
    g_tipLine[9911] = StringToText("  那你完全可以怀疑他们。（注意：如果你错了，让真正的侍女或驱魔人醉酒了，");
    g_tipLine[9912] = StringToText("  你可能会因为干扰了善良阵营而受到怀疑和愤怒！这是一场冒险的游戏，但回报很大。）");
    g_tipLine[9913] = StringToText("· 如果你只是不确定要让谁醉酒，而且你又感觉自己要死了，一个有效的选择是简单地选择剧本中最致命的角色。");
    g_tipLine[9914] = StringToText("  无论这个角色是否在游戏中，你现在都可以完全确信这个角色根本不会影响你的游戏，让善良玩家可以排除那个角色进行推理。");
    g_tipLine[9915] = StringToText("  （你问，黯月初升剧本中谁是最致命的角色？好吧，这取决于你！）");
    g_tipRoleAt[29] = 9845; g_tipRoleN[29] = 71; g_tipP1At[29] = 9847; g_tipP1N[29] = 11; g_tipP2At[29] = 9890; g_tipP2N[29] = 4;
    g_tipAbility[29] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个角色：如果该角色在场，该角色之一从当晚开始醉酒三天三夜。");
    g_tipLine[9916] = StringToText("【背景故事】");
    g_tipLine[9917] = StringToText("「过程很简单。将液压植入器连接到改良型气矩阵放大器上，加入20CC的伪多拉芬，让他的参数Z保持在20%以上，");
    g_tipLine[9918] = StringToText("  你丈夫就会重新活蹦乱跳。");
    g_tipLine[9919] = StringToText("现在，我们需要的仅仅是一次雷击。」");
    g_tipLine[9920] = StringToText("【角色能力】");
    g_tipLine[9921] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名死亡的玩家：如果他是镇民，你会将他起死回生。");
    g_tipLine[9922] = StringToText("【角色简介】");
    g_tipLine[9923] = StringToText("教授能让死者重获新生。");
    g_tipLine[9924] = StringToText("· 每局游戏限一次，教授可以选择一名已死亡的玩家。如果该玩家是镇民，他将被复活，再次变成存活状态。");
    g_tipLine[9925] = StringToText("· 如果教授选择了外来者、爪牙或恶魔，则无事发生，并且教授失去自己的能力。");
    g_tipLine[9926] = StringToText("· 复活的玩家会重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的能力也会重新获得。");
    g_tipLine[9927] = StringToText("· 复活的镇民能不能在自己复活的当晚进行行动，取决于复活的镇民本该在教授之前还是之后行动。");
    g_tipLine[9928] = StringToText("  如果复活的镇民有「在你的首个夜晚」的能力，则会在教授重新入睡后立即被唤醒来使用这类能力。");
    g_tipLine[9929] = StringToText("【范例】");
    g_tipLine[9930] = StringToText("教授选择了一名声称自己是茶艺师的已死亡玩家。该玩家实际上是疯子。无人被复活。");
    g_tipLine[9931] = StringToText("教授复活了祖母，祖母得知了一名善良玩家的角色。在黎明，所有玩家都得知这名祖母玩家复活了，");
    g_tipLine[9932] = StringToText("  但是并不知道该玩家是祖母。");
    g_tipLine[9933] = StringToText("醉酒的教授选择复活吟游诗人。教授不得而知的是，当晚沙巴洛斯反刍了吟游诗人，他现在已经是存活状态。");
    g_tipLine[9934] = StringToText("  说书人摇头表示不行，因为教授必须选择一名已死亡的玩家。教授改为选择了已死亡的弄臣。因为教授醉酒，无事发生，");
    g_tipLine[9935] = StringToText("  并且教授不能再次使用自己的能力。");
    g_tipLine[9936] = StringToText("【运作方式】");
    g_tipLine[9937] = StringToText("除首夜以外的夜晚，唤醒教授。教授要么摇头表示不使用能力，要么指向一名已死亡的玩家。让教授重新入睡。");
    g_tipLine[9938] = StringToText("如果教授选择了一名已死亡的镇民，所选玩家再次变成存活状态——将教授的「复活」提示标记放置到该玩家的角色标记旁，");
    g_tipLine[9939] = StringToText("  并移除其帷幕标记。（如果被复活的玩家其角色在当晚的后续时段中应该被唤醒，则照常唤醒。");
    g_tipLine[9940] = StringToText("  如果该玩家的角色只会在首个夜晚被唤醒，则立即唤醒该玩家来使用自己的能力。）黎明时，在宣布哪些玩家死亡后，");
    g_tipLine[9941] = StringToText("  宣布哪些玩家再次变成存活状态了。（不要说明原因。）教授失去自己的能力——将「失去能力」");
    g_tipLine[9942] = StringToText("  提示标记放置到教授的角色标记旁，并从夜晚顺序表上移除其夜晚标记。");
    g_tipLine[9943] = StringToText("【提示标记】");
    g_tipLine[9944] = StringToText("· 复活");
    g_tipLine[9945] = StringToText("放置时机：在教授夜晚行动时选择使用能力，并选择了一名已死亡的玩家后。");
    g_tipLine[9946] = StringToText("放置条件：如果在被教授选择时，该玩家的角色类型是镇民，且教授未醉酒中毒，则在该玩家的角色标记旁放置，");
    g_tipLine[9947] = StringToText("  用以提醒说书人在黎明时分宣布当晚的复活玩家。");
    g_tipLine[9948] = StringToText("移除时机：在黎明时宣布复活玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[9949] = StringToText("· 失去能力");
    g_tipLine[9950] = StringToText("放置时机：在教授夜晚行动时选择使用能力，并选择了一名已死亡的玩家后。");
    g_tipLine[9951] = StringToText("放置条件：只要教授选择了已死亡玩家，不论教授是否醉酒中毒，都会将此标记放置在教授角色标记旁。");
    g_tipLine[9952] = StringToText("移除时机：教授死亡或离场时。");
    g_tipLine[9953] = StringToText("【规则细节】");
    g_tipLine[9954] = StringToText("· 如果在城镇广场上没有死亡玩家，则无需唤醒教授（即使可能已经有人死亡，但还未被说书人告知）。");
    g_tipLine[9955] = StringToText("  侍女也不会因此检测到教授因为自身能力被唤醒。");
    g_tipLine[9956] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[9957] = StringToText("  · 狸猫：如果狸猫与使用过能力的教授交换角色，新教授仍然失去能力。");
    g_tipLine[9958] = StringToText("【提示与技巧】");
    g_tipLine[9959] = StringToText("· 尽可能早地使用你的能力！邪恶的玩家真的不想让你活着，所以尽快触发你的能力会给你带来优势。此外，");
    g_tipLine[9960] = StringToText("  在游戏早期死亡的玩家更有可能是善良的镇民，因为他们占多数，而邪恶方会互相保护。");
    g_tipLine[9961] = StringToText("· 也可以在游戏后期使用你的能力！虽然有风险，但在游戏快结束时，复活善良镇民对邪恶阵营玩家极有破坏性。");
    g_tipLine[9962] = StringToText("  善良阵营玩家将能够在你和你复活的镇民周围团结起来，而邪恶阵营玩家更难伪装自己，因为游戏已经到了后期。");
    g_tipLine[9963] = StringToText("· 请记住，如果你的能力失败，死去的玩家要么是邪恶的，要么是外来者。不要马上下结论——你可能已经选中了一个僵怖或困惑");
    g_tipLine[9964] = StringToText("  的疯子！");
    g_tipLine[9965] = StringToText("· 复活夜晚死亡的玩家，而不是被处决的玩家。晚上死去的玩家，更可能是善良的。");
    g_tipLine[9966] = StringToText("· 如果你认为白天的处决犯了错误，请复活被处决的玩家！如果你的能力有效，你就救活了一个无辜的镇民。如果不是，");
    g_tipLine[9967] = StringToText("  那么你可以非常确定他们第一次执行它们是正确的。（策略：向你认为善良的玩家展示自己的角色，并要求他们被故意处决，");
    g_tipLine[9968] = StringToText("  这样你就可以把他们带回来，证明你们俩。这在游戏早期尤其有效！）");
    g_tipLine[9969] = StringToText("· 成功复活一个镇民，你将成为游戏中更值得信赖的善良玩家之一。虽然你仍可能被怀疑（沙巴洛斯始终是一个问题），");
    g_tipLine[9970] = StringToText("  但你和你复活的镇民可以互相信任，并且大多数其他玩家会想加入你们！利用这个优势，面对邪恶阵营团结善良阵营玩家。");
    g_tipLine[9971] = StringToText("· 在选择复活谁时，请提前告诉玩家你打算做什么。这不仅为你不是沙巴洛斯的事实提供了可信度（因为说书人可以选择谁被反刍");
    g_tipLine[9972] = StringToText("  ），而且这也意味着如果他们是一个出于任何原因以镇民角色虚张声势的外来者，他们可以提醒你。此外，");
    g_tipLine[9973] = StringToText("  如果有些玩家同意执行此计划，但是没有复活成功，那你可以怀疑他们是邪恶的。");
    g_tipRoleAt[30] = 9916; g_tipRoleN[30] = 58; g_tipP1At[30] = 9920; g_tipP1N[30] = 9; g_tipP2At[30] = 9953; g_tipP2N[30] = 5;
    g_tipAbility[30] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名死亡的玩家：如果他是镇民，你会将他起死回生。");
    g_tipLine[9974] = StringToText("【背景故事】");
    g_tipLine[9975] = StringToText("「我应倾听，当你轻敲我心……");
    g_tipLine[9976] = StringToText("美梦因你，甜美温馨……");
    g_tipLine[9977] = StringToText("若你羞赧，难以决定……");
    g_tipLine[9978] = StringToText("我会安睡，待你光临。」");
    g_tipLine[9979] = StringToText("【角色能力】");
    g_tipLine[9980] = StringToText("当一名爪牙死于处决时，除了你和旅行者以外的所有其他玩家醉酒直到明天黄昏。");
    g_tipLine[9981] = StringToText("【角色简介】");
    g_tipLine[9982] = StringToText("如果有爪牙因为处决而死去，吟游诗人会让所有人醉酒。");
    g_tipLine[9983] = StringToText("· 如果一名爪牙玩家被处决且死亡，所有玩家（除了吟游诗人）会立即变得醉酒，并在整个夜晚和下一个白天都保持醉酒状态。");
    g_tipLine[9984] = StringToText("  镇民、外来者、爪牙、甚至是恶魔都会醉酒，但是旅行者不会。如果爪牙在夜晚死亡，吟游诗人不会使人醉酒。");
    g_tipLine[9985] = StringToText("· 如果一名已死亡的爪牙玩家被处决，吟游诗人的能力不会触发——已死亡的角色不会再次死亡！");
    g_tipLine[9986] = StringToText("  如果一名爪牙玩家被处决但没有死亡，吟游诗人的能力不会触发。如果一名爪牙玩家在吟游诗人醉酒或中毒期间死于处决时，");
    g_tipLine[9987] = StringToText("  吟游诗人的能力不会触发。");
    g_tipLine[9988] = StringToText("【范例】");
    g_tipLine[9989] = StringToText("在首个白天，和平主义者死亡。当晚，玩家们正常行动，因为和平主义者不是爪牙。在第二个白天，法官处决了教父。当晚，");
    g_tipLine[9990] = StringToText("  所有人都醉酒，包括恶魔，因此无人死亡。在第三个白天，魔鬼代言人醉酒了，");
    g_tipLine[9991] = StringToText("  受到魔鬼代言人保护的一名爪牙玩家被处决并死亡。因为有爪牙因处决而死去，吟游诗人又一次让所有人醉酒。");
    g_tipLine[9992] = StringToText("刺客被处决，因此吟游诗人让所有人醉酒。在下一个白天，教父被处决，因此吟游诗人让所有人再次醉酒。");
    g_tipLine[9993] = StringToText("  恶魔两个夜晚都没办法成功发起攻击。在下一个白天，获得主谋能力的学徒被流放了，因此当晚所有人都再次恢复清醒，");
    g_tipLine[9994] = StringToText("  因为吟游诗人的能力不会因旅行者被流放而触发。");
    g_tipLine[9995] = StringToText("在白天，刺客死亡，因此吟游诗人让所有人醉酒。在下一个白天，僵怖被处决且第一次死亡。善良阵营获胜，因为僵怖醉酒，");
    g_tipLine[9996] = StringToText("  因而没有任何能力。");
    g_tipLine[9997] = StringToText("【运作方式】");
    g_tipLine[9998] = StringToText("在白天，如果一名爪牙玩家死于处决，除旅行者外的所有其他玩家都醉酒——将吟游诗人的「全员醉酒」");
    g_tipLine[9999] = StringToText("  提示标记放置到魔典左侧的中央。");
    g_tipLine[10000] = StringToText("在下一天的黄昏，所有因吟游诗人醉酒的玩家恢复清醒——移除「全员醉酒」提示标记。");
    g_tipLine[10001] = StringToText("【提示标记】");
    g_tipLine[10002] = StringToText("· 全员醉酒");
    g_tipLine[10003] = StringToText("放置时机：当有一名爪牙死于处决时。");
    g_tipLine[10004] = StringToText("放置条件：当有爪牙死于处决，且此时吟游诗人未醉酒中毒，放置在魔典中央。（为了区分效果持续生效的终止时机，");
    g_tipLine[10005] = StringToText("  建议在每到黎明时，将此标记从魔典中央移动至吟游诗人角色旁。如果黄昏时，「全员醉酒」标记在吟游诗人旁，则移除，");
    g_tipLine[10006] = StringToText("  如果「全员醉酒」标记在魔典中央，则不移除。）");
    g_tipLine[10007] = StringToText("移除时机：放置此标记后的下一天黄昏。如果当天再次有爪牙死于处决，则重新放置此标记，否则移除此标记。");
    g_tipLine[10008] = StringToText("  吟游诗人死亡或离场时，也要移除此标记。");
    g_tipLine[10009] = StringToText("【规则细节】");
    g_tipLine[10010] = StringToText("· 相克规则：");
    g_tipLine[10011] = StringToText("  · 军团：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处决的玩家是军团。");
    g_tipLine[10012] = StringToText("【提示与技巧】");
    g_tipLine[10013] = StringToText("· 乍一看，吟游诗人似乎没有那么强大，但实际上你获得了游戏中最可靠的一些信息。在任何一天处决之后，");
    g_tipLine[10014] = StringToText("  如果有人在晚上死去，那么你都可以确认今天被处决的人不是爪牙，而如果被处决的是恶魔，");
    g_tipLine[10015] = StringToText("  通常游戏就结束了（僵怖和主谋除外），因此你可以推测今天被处决的是善良的！");
    g_tipLine[10016] = StringToText("· 如果大家确实成功处决了一个爪牙，吟游诗人的能力就会激活，当晚不会有人因恶魔死去。");
    g_tipLine[10017] = StringToText("  但这并不意味着平安夜一定是因为你的能力。在黯月初升中，人们不死的原因和他们死的原因一样多（例如驱魔人、旅店老板、");
    g_tipLine[10018] = StringToText("  珀）！为了确保是你的能力触发了，并且最近的被处决者确实是爪牙，你可以找一些证据 - 因为你影响了游戏中的所有能力");
    g_tipLine[10019] = StringToText("  ，你应该能够找到其他能力没有按预期工作的证据。例如，侍女或赌徒等角色可能会得到奇怪的结果，再例如，");
    g_tipLine[10020] = StringToText("  没有人可以免于处决（例如和平主义者、魔鬼代言人），并且像修补匠这样的角色不会在那天随机死亡。");
    g_tipLine[10021] = StringToText("· 去处决！执行处决的次数越多，找到爪牙的机会就越大。优秀的玩家可能不愿意处决任何不是恶魔嫌疑人的人，");
    g_tipLine[10022] = StringToText("  因为在黯月初升中死亡人数可能会出乎意料的多，但把刺客或主谋等强大的爪牙从游戏中移除，会大有裨益。");
    g_tipLine[10023] = StringToText("  再加上一晚的缓刑，你在成功执行时所获得的能力应当会让你比更积极！");
    g_tipLine[10024] = StringToText("· 恶魔可能不太会以你为目标，因为他们低估了你的力量！除非爪牙有被处决的危险，");
    g_tipLine[10025] = StringToText("  否则吟游诗人可能会比其他没有保护的城镇居民活得更久，因为恶魔会更害怕驱魔人或茶艺师活下去。");
    g_tipLine[10026] = StringToText("  充分利用这一点——希望当邪恶的团队意识到你有多么危险时，已经有一两个爪牙倒下了！");
    g_tipLine[10027] = StringToText("· 如果邪恶团队更精明一点，他们可能会更早地瞄准你，尤其是当爪牙有被处决的危险时。");
    g_tipLine[10028] = StringToText("  将你的角色隐藏几天可能会给邪恶玩家不小的打击，因为当爪牙被处决，所有人都无法正常行动时，他们才知道你阻止了他们，");
    g_tipLine[10029] = StringToText("  也暴露了爪牙。你的意外死亡也可能表明邪恶团队在保护被大家怀疑的爪牙。");
    g_tipRoleAt[31] = 9974; g_tipRoleN[31] = 56; g_tipP1At[31] = 9979; g_tipP1N[31] = 9; g_tipP2At[31] = 10009; g_tipP2N[31] = 3;
    g_tipAbility[31] = StringToText("当一名爪牙死于处决时，除了你和旅行者以外的所有其他玩家醉酒直到明天黄昏。");
    g_tipLine[10030] = StringToText("【背景故事】");
    g_tipLine[10031] = StringToText("「若你感到寒冷，茶能使你温暖。");
    g_tipLine[10032] = StringToText("若你感到愤怒，茶能使你冷静。");
    g_tipLine[10033] = StringToText("若你感到沮丧，茶能使你振奋。");
    g_tipLine[10034] = StringToText("若你感到激动，茶能使你镇定。」");
    g_tipLine[10035] = StringToText("【角色能力】");
    g_tipLine[10036] = StringToText("如果与你邻近的两名存活的玩家是善良的，他们不会死亡。");
    g_tipLine[10037] = StringToText("【角色简介】");
    g_tipLine[10038] = StringToText("茶艺师保护着她邻近的玩家免于死亡……只要他们都是善良的。");
    g_tipLine[10039] = StringToText("· 如果茶艺师邻近的两名存活玩家当前都是善良的，这两名玩家就都不会死亡。恶魔不能杀死他们，教父和造谣者也不行。");
    g_tipLine[10040] = StringToText("  如果他们被处决，也不会死亡。唯一的例外是刺客，他能杀死受到保护而免于死亡的人。");
    g_tipLine[10041] = StringToText("· 茶艺师的邻近的存活玩家是最靠近茶艺师两名存活玩家——一名为顺时针方向最近的存活玩家，");
    g_tipLine[10042] = StringToText("  一名为逆时针方向上最近的存活玩家。已死亡的邻近玩家会被跳过。");
    g_tipLine[10043] = StringToText("· 然而，如果邻近的存活玩家其中之一是邪恶的，或者两个都是邪恶的，那么茶艺师就无法保护她的邻近存活玩家。");
    g_tipLine[10044] = StringToText("  如果一名邪恶玩家死亡，使得茶艺师现在的两个邻近玩家都是善良的，那么他们就又都不会死亡了。");
    g_tipLine[10045] = StringToText("【范例】");
    g_tipLine[10046] = StringToText("茶艺师在游戏开始时的邻近玩家是主谋和善良的莽夫。主谋被处决且死亡。现在，茶艺师邻近的存活玩家是善良的莽夫和侍臣。");
    g_tipLine[10047] = StringToText("  恶魔攻击了侍臣，但侍臣依然存活。之后，莽夫转变为邪恶的，并且恶魔再次攻击侍臣。这一次，侍臣死亡。");
    g_tipLine[10048] = StringToText("茶艺师邻近的存活玩家是善良的女舍监和善良的法官。女舍监被流放，但依然存活。");
    g_tipLine[10049] = StringToText("【运作方式】");
    g_tipLine[10050] = StringToText("如果茶艺师邻近的两名存活玩家都是善良的，将茶艺师的「不会死亡」提示标记放置到这两名玩家的角色标记旁。");
    g_tipLine[10051] = StringToText("  如果茶艺师邻近的两名存活玩家中有任何一个是邪恶的，移除这些提示标记。");
    g_tipLine[10052] = StringToText("  根据这个条件在整局游戏中随时更新这些提示标记（例如一名玩家的阵营改变了）。");
    g_tipLine[10053] = StringToText("如果一名标有「不会死亡」的玩家将要死去，该玩家依然存活。如果一名标有「不会死亡」的玩家被处决，");
    g_tipLine[10054] = StringToText("  宣布该玩家被处决但依然存活。（不要说明原因。）");
    g_tipLine[10055] = StringToText("【提示标记】");
    g_tipLine[10056] = StringToText("· 不会死亡");
    g_tipLine[10057] = StringToText("放置时机：每当茶艺师的两名邻近存活玩家都是属于善良阵营时，放置此标记。");
    g_tipLine[10058] = StringToText("放置条件：该标记的放置条件会进行动态检测。当满足条件时，放置标记，当不满足条件时，立即移除标记。");
    g_tipLine[10059] = StringToText("  标记会放置在茶艺师的两名邻近存活玩家的角色标记旁。");
    g_tipLine[10060] = StringToText("移除时机：茶艺师死亡或离场时，或由于动态检测条件不满足时。");
    g_tipLine[10061] = StringToText("特殊说明：动态检测会检查茶艺师的两名邻近存活玩家和他们的阵营，因此如果与茶艺师邻近的两名存活玩家的生死状态或阵营");
    g_tipLine[10062] = StringToText("  状态发生了变化，都需要重新进行检查。");
    g_tipLine[10063] = StringToText("【提示与技巧】");
    g_tipLine[10064] = StringToText("· 茶艺师是一个强大的保护者，但自己很脆弱。什么时候、向谁坦白你的角色，对善良方的策略非常重要。立即公开角色，");
    g_tipLine[10065] = StringToText("  可以帮助你的邻居免受处决（即最好的情况：两个邻居都是善良的），但会使你暴露于邪恶团队。");
    g_tipLine[10066] = StringToText("  保持安静或谨慎行事会使确认信息变得更加困难，但你会活得更久，并且可能会诱骗恶魔瞄准受了你保护的邻居，");
    g_tipLine[10067] = StringToText("  从而浪费宝贵的杀戮。很难说这些策略哪种对哪种错——自己判断哪种策略最适合你所在的游戏！");
    g_tipLine[10068] = StringToText("· 处决你的邻居！如果你的两个邻居都很是善良的，他们就不会死。测试这一点的最快和最简单的方法是处决他们——如果他们没");
    g_tipLine[10069] = StringToText("  有死，那么很有可能是你的能力拯救了他们。警惕那些通常免疫处决的角色（例如水手、弄臣），因为他们会搅浑水。");
    g_tipLine[10070] = StringToText("  你还应该小心魔鬼代言人，他也可能起欺骗你，让你觉得一个邪恶的邻居是好人，因为他们的能力可以与你的处决时间相吻合。");
    g_tipLine[10071] = StringToText("  最后，请注意和平主义者——当他们还活着的时候，说书人可能会选择放过任何善良的处决者，你也可能误以为能力发动了。");
    g_tipLine[10072] = StringToText("· 你也可以选择不那么主动——你可以什么也不透露，等着看结果如何！恶魔不知道你是谁的话，可以给你带来一些安全感，");
    g_tipLine[10073] = StringToText("  同时你邻居的角色，也可能对局势有益。例如，如果你有两个好邻居，恶魔在晚上袭击他们毫无影响。对于其他情况，");
    g_tipLine[10074] = StringToText("  如果你的邻居死亡，说明你至少有一个邪恶的邻居，并且一旦你想到嫌疑人就可以选择告诉大家。");
    g_tipLine[10075] = StringToText("  （尤其是对像僵怖这样的角色，他们可能会选择提前「假死」，但如果没有意识到你是他们的邻居，他们这样做就很危险！）");
    g_tipLine[10076] = StringToText("· 与邻居建立信任。甚至在他们被确认是好人之前，都应该鼓励他们配合你——毕竟，如果他们能证明他们都是善良的，");
    g_tipLine[10077] = StringToText("  那么你可以相信你的能力会发挥作用并保护他们。召集优秀团队比而花时间杀死邻居来证明他们的阵营更重要。");
    g_tipLine[10078] = StringToText("· 无论你使用哪种策略，每次邻居死亡时都可以切换策略，特别是如果你认为邻居是邪恶的时候。");
    g_tipLine[10079] = StringToText("  你的能力延伸到最接近的活着的玩家，所以每次你失去一个邻座玩家，你就会获得一个玩家阵营，");
    g_tipLine[10080] = StringToText("  而这一次你可能会有两个好邻居！但请注意——随着游戏的进行，你获得邪恶邻居的机会会越来越高。在最后的日子里，");
    g_tipLine[10081] = StringToText("  你可以优先假设你身边的人是邪恶的，除非你有强有力的证据证明他们是善良的。");
    g_tipRoleAt[32] = 10030; g_tipRoleN[32] = 52; g_tipP1At[32] = 10035; g_tipP1N[32] = 10; g_tipP2At[32] = 0; g_tipP2N[32] = 0;
    g_tipAbility[32] = StringToText("如果与你邻近的两名存活的玩家是善良的，他们不会死亡。");
    g_tipLine[10082] = StringToText("【背景故事】");
    g_tipLine[10083] = StringToText("「任何有强烈惩罚冲动的人都不可信赖。」");
    g_tipLine[10084] = StringToText("【角色能力】");
    g_tipLine[10085] = StringToText("被处决的善良玩家可能不会死亡。");
    g_tipLine[10086] = StringToText("【角色简介】");
    g_tipLine[10087] = StringToText("和平主义者防止善良玩家因处决而死亡。");
    g_tipLine[10088] = StringToText("· 当一名善良玩家被处决时，说书人选择该玩家是死亡还是存活。");
    g_tipLine[10089] = StringToText("· 一如既往，当这类能力以如此直白的方式生效时，只需要告知大家发生了什么事，不要告知为什么发生。大家得知处决成功了，");
    g_tipLine[10090] = StringToText("  但被处决的玩家没有死亡——这就够了。");
    g_tipLine[10091] = StringToText("· 如果一名玩家被处决但依然存活，也仍然算作今天白天的处决。今天不能再发起其他的提名了。");
    g_tipLine[10092] = StringToText("【范例】");
    g_tipLine[10093] = StringToText("旅店老板被处决，但因为和平主义者的能力依然存活。");
    g_tipLine[10094] = StringToText("和平主义者在场。善良阵营占据了优势。因此即使过了七天，有五名善良玩家被处决，");
    g_tipLine[10095] = StringToText("  和平主义者的能力也没能救下其中任何一人。");
    g_tipLine[10096] = StringToText("和平主义者在场。邪恶阵营占据了优势。疯子被处决但依然存活。在下一个白天，善良的教授被处决且死亡，");
    g_tipLine[10097] = StringToText("  因为和平主义者醉酒了。再下一个白天，善良的主教被流放并死去，因为和平主义者只能保护被处决的玩家，");
    g_tipLine[10098] = StringToText("  无法保护被流放的旅行者。再下一个白天，和平主义者被处决，但因为和平主义者的能力而依然存活。");
    g_tipLine[10099] = StringToText("【运作方式】");
    g_tipLine[10100] = StringToText("如果一个善良角色被处决，要么宣布该玩家死亡，要么宣布该玩家依然存活。（不要说明原因。）然后，夜晚阶段开始。");
    g_tipLine[10101] = StringToText("  （无论被处决的玩家存活还是死亡，每个白天都只能有一次处决。）");
    g_tipLine[10102] = StringToText("每局游戏触发一次和平主义者的能力，通常来说是合理的。只要你觉得合适，也可以多触发几次。在少见的情形下，");
    g_tipLine[10103] = StringToText("  为了让和平主义者看起来很可疑，你可以永不触发他的能力。");
    g_tipLine[10104] = StringToText("【提示标记】");
    g_tipLine[10105] = StringToText("无");
    g_tipLine[10106] = StringToText("【规则细节】");
    g_tipLine[10107] = StringToText("无");
    g_tipLine[10108] = StringToText("【提示与技巧】");
    g_tipLine[10109] = StringToText("· 不要说出你的角色！你的能力能保证善良玩家的安全（由说书人决定），而邪恶阵营会希望尽快将你干掉。");
    g_tipLine[10110] = StringToText("  可以声称自己是不太重要的角色，比如弄臣或莽夫，并坚持这个说法，直到你有充分的理由透露你是谁。");
    g_tipLine[10111] = StringToText("· 你应该最后才表露角色，但你如何做还是取决于你。例如，你有百分百信任的善良玩家，那可以向他们透露角色。");
    g_tipLine[10112] = StringToText("  如果之后你的能力救了人，他们会立刻知道是得益于你。如果你没有那么信任的人，那么只需谨慎行事，直到你死去，");
    g_tipLine[10113] = StringToText("  或者游戏局面发展到你必须表露角色。");
    g_tipLine[10114] = StringToText("· 你的能力在游戏后期更强大，所以尽可能地生存下去。当游戏进入高潮时，说书人更有可能在关键时刻拯救一个善良的玩家，");
    g_tipLine[10115] = StringToText("  而不是在第一天从血腥的小镇中拯救一个人。简而言之，你活得越久，你拯救同伴的机会就越大，");
    g_tipLine[10116] = StringToText("  所以采取任何你认为有必要的行动来实现这一点……如果合理的话。");
    g_tipLine[10117] = StringToText("· 等待你的能力触发了，再表露你的角色。看到某个玩家意外地从处决中解救出来，会让善良的团队相信你在游戏中，");
    g_tipLine[10118] = StringToText("  而如果过早透露，然后大家看到你的能力激活，反而会让他们觉得是邪恶方刻意为之。");
    g_tipLine[10119] = StringToText("· 可能不死的原因有很多，所以不要立即判断是你的能力决定的。实际上，水手、弄臣或茶艺师的邻居都可能在处决后活下来，");
    g_tipLine[10120] = StringToText("  而你过早地揭示你的角色会让你成为一个重要目标，特别是如果还在游戏的早期。");
    g_tipLine[10121] = StringToText("· 魔鬼代言人是你最大的敌人——他能够模仿你的能力并在此之上保护他们的邪恶同伙。由于你的能力非常相似，");
    g_tipLine[10122] = StringToText("  和平主义者对于这个狡猾的爪牙来说是一个常用的伪装——如果你认为有他在场，请谨慎行事，并且让善良团队尽可能相信你。");
    g_tipRoleAt[33] = 10082; g_tipRoleN[33] = 41; g_tipP1At[33] = 10084; g_tipP1N[33] = 8; g_tipP2At[33] = 10106; g_tipP2N[33] = 2;
    g_tipAbility[33] = StringToText("被处决的善良玩家可能不会死亡。");
    g_tipLine[10123] = StringToText("【背景故事】");
    g_tipLine[10124] = StringToText("「……然后国王说道：‘什么？！我甚至从未有过一条橡胶马裤，更别提一门奶油大炮了！’嗬嗬！欢乐一日！」");
    g_tipLine[10125] = StringToText("【角色能力】");
    g_tipLine[10126] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipLine[10127] = StringToText("【角色简介】");
    g_tipLine[10128] = StringToText("弄臣能够死里逃生……但仅限一次。");
    g_tipLine[10129] = StringToText("· 弄臣首次因任何理由死亡时，他依然存活。弄臣不会得知是他自己的能力救了自己的命。");
    g_tipLine[10130] = StringToText("· 如果其他角色的能力保护弄臣免于死亡，弄臣不会使用掉自己的能力。只有当弄臣将要真正的死去时，他的能力才会触发。");
    g_tipLine[10131] = StringToText("【范例】");
    g_tipLine[10132] = StringToText("在首个白天，弄臣被处决但依然存活。在第四个白天，弄臣再次被处决。这一次，他死亡。");
    g_tipLine[10133] = StringToText("恶魔攻击了弄臣，但他依然存活。当晚无人死亡。在下一个白天，弄臣被法官处决并且死亡。");
    g_tipLine[10134] = StringToText("恶魔攻击了弄臣，但他被茶艺师保护。弄臣依然存活，且保留着自己的能力。之后，在茶艺师死亡后，恶魔攻击了弄臣，");
    g_tipLine[10135] = StringToText("  但他被旅店老板保护。弄臣依然存活，且保留着自己的能力。之后，在旅店老板死亡后，恶魔攻击了弄臣，");
    g_tipLine[10136] = StringToText("  他依旧存活但使用了自己的能力，所以弄臣下一次再被攻击时，就会死亡。");
    g_tipLine[10137] = StringToText("【运作方式】");
    g_tipLine[10138] = StringToText("如果弄臣将要死亡，他依然存活。（但是如果此时醉酒或中毒就会死亡。）如果弄臣被处决，宣布该玩家被处决但依然存活。");
    g_tipLine[10139] = StringToText("  （不要说明原因。）");
    g_tipLine[10140] = StringToText("无论哪种情况，弄臣都失去自己的能力——将「失去能力」提示标记放置到弄臣的角色标记旁。");
    g_tipLine[10141] = StringToText("【提示标记】");
    g_tipLine[10142] = StringToText("· 失去能力");
    g_tipLine[10143] = StringToText("放置时机：当弄臣的能力触发时。");
    g_tipLine[10144] = StringToText("放置条件：只有当弄臣没有受到其他免死效果保护，且自己未醉酒中毒的状况下，即将死亡且还未放置他的「失去能力」");
    g_tipLine[10145] = StringToText("  标记时，才能放置。将此标记放置在弄臣角色标记旁边。");
    g_tipLine[10146] = StringToText("移除时机：弄臣死亡或离场时。");
    g_tipLine[10147] = StringToText("【提示与技巧】");
    g_tipLine[10148] = StringToText("· 弄臣是在《黯月初升》中少数可以自由呼吸的角色之一，因为他们的能力使他们免于一次死亡。然而，");
    g_tipLine[10149] = StringToText("  这并不意味着你应该固步自封——作为一个积极主动的弄臣可以虚张声势，把邪恶阵营逼疯，浪费恶魔一次宝贵的杀戮机会，");
    g_tipLine[10150] = StringToText("  保护你的善良队友。谁会笑到最后？由你决定！");
    g_tipLine[10151] = StringToText("· 你的能力使你免于死亡……一次。你可以依靠这一点来保证你在整个游戏中的长期生存，");
    g_tipLine[10152] = StringToText("  但也可以故意虚张声势让恶魔来瞄准你。比如你自称是驱魔人或侍臣，那么没有经验的恶魔可能会惊慌失措地瞄准你，");
    g_tipLine[10153] = StringToText("  从而浪费当晚的杀戮。这也是对付珀和沙巴洛斯的有效策略，这两个恶魔都是通过尽快屠杀小镇而获胜的——如果他们选择了你");
    g_tipLine[10154] = StringToText("  ，那么你和另一个善良玩家（一个如果恶魔不选择你，可能会选择的玩家）就可以活到下一天！");
    g_tipLine[10155] = StringToText("· 你的角色能力在晚上恶魔杀戮时触发，是更有价值的。你不会因处决而死并不意味着你应该冲上处决台！");
    g_tipLine[10156] = StringToText("· 如果你真的受到善良团队的怀疑，你可以通过被处决来证明自己——因为你不会死，这是一个相当不错的证明。");
    g_tipLine[10157] = StringToText("  这实际上是放弃了你的夜间自我保护，从而让善良阵营安心，但这并不是绝对的证据（精明的玩家会指出，");
    g_tipLine[10158] = StringToText("  魔鬼代言人的行动也达到了同样的效果），但是你愿意牺牲自己的行为可能会动摇小镇的心……并希望这么做，");
    g_tipLine[10159] = StringToText("  能摆脱过分热心的驱魔人或侍女。");
    g_tipLine[10160] = StringToText("· 尝试通过跟踪死亡轨迹来推断你何时成为了夜间目标。例如，如果你在整个游戏中每晚都看到两次死亡，");
    g_tipLine[10161] = StringToText("  然后突然出现了一次死亡……可能是沙巴洛斯试图攻击您，而你却安然无恙。");
    g_tipLine[10162] = StringToText("  知道你什么时候可能容易受到攻击可以让你调整你的策略，以便在必要时或多或少地成为目标。");
    g_tipLine[10163] = StringToText("· 如果你信任一个确实不想晚上死去的玩家，你可以自称是他的角色。例如，和平主义者可能希望人们知道他们在游戏中，");
    g_tipLine[10164] = StringToText("  但又不想暴露在恶魔前……所以你可以伪装他！如果恶魔袭击你，和平主义者会再活一天！");
    g_tipLine[10165] = StringToText("· 如果你过早意外死亡，你应该留意刺客或普卡。刺客将能够绕过你的保护并杀死你，而普卡会毒害你，");
    g_tipLine[10166] = StringToText("  使你的能力无法正常生效。这两个都是致命的角色，早早知道他们在场对于善良团队来说可能是一个巨大的福音，");
    g_tipLine[10167] = StringToText("  即使它是以牺牲你为代价的。（注意：还要考虑水手选中的可能，这对善良团队来说不太致命，但仍然可能你突然死亡的原因。");
    g_tipLine[10168] = StringToText("  ）");
    g_tipLine[10169] = StringToText("· 你仍然可以通过其他方式得到保护——茶艺师、旅店老板、和平主义者甚至是魔鬼代言人也可以让你免于死亡。");
    g_tipLine[10170] = StringToText("  如果你幸运地在你自己的力量之上获得任何额外的保护，那就好好利用，嘲讽一下邪恶的队伍吧！这有什么关系呢？");
    g_tipRoleAt[34] = 10123; g_tipRoleN[34] = 48; g_tipP1At[34] = 10125; g_tipP1N[34] = 6; g_tipP2At[34] = 0; g_tipP2N[34] = 0;
    g_tipAbility[34] = StringToText("当你首次将要死亡时，你不会死亡。");
    g_tipLine[10171] = StringToText("【背景故事】");
    g_tipLine[10172] = StringToText("「我觉得我发现问题所在了。幸运的是，我有一个想法！这能让这台投石车的发射距离变成原来的两倍，");
    g_tipLine[10173] = StringToText("  而这只需要些微的调……」");
    g_tipLine[10174] = StringToText("【角色能力】");
    g_tipLine[10175] = StringToText("你随时可能死亡。");
    g_tipLine[10176] = StringToText("【角色简介】");
    g_tipLine[10177] = StringToText("修补匠随时可能会死亡，不需要任何理由。");
    g_tipLine[10178] = StringToText("· 说书人随时可以杀死修补匠。");
    g_tipLine[10179] = StringToText("· 修补匠在受到免于死亡的能力保护时，不能因自己的能力而死亡。");
    g_tipLine[10180] = StringToText("【范例】");
    g_tipLine[10181] = StringToText("现在是第三个白天。突然，修补匠死亡了。");
    g_tipLine[10182] = StringToText("在夜晚，修补匠死亡了，虽然恶魔攻击的是其他玩家。");
    g_tipLine[10183] = StringToText("茶艺师坐在修补匠和另一个善良玩家旁边，保护修补匠免于死亡。修补匠不会因为自己的能力而死亡。");
    g_tipLine[10184] = StringToText("修补匠被恶魔攻击。修补匠因为旅店老板的保护而没有死亡。当晚的后续时段中，旅店老板死亡，");
    g_tipLine[10185] = StringToText("  因此说书人选择将修补匠也杀死。");
    g_tipLine[10186] = StringToText("【运作方式】");
    g_tipLine[10187] = StringToText("在任何时候，你都可以决定让修补匠死亡。如果是在白天，立即宣布修补匠刚刚死亡。如果是在夜晚，将「死亡」");
    g_tipLine[10188] = StringToText("  提示标记放置到修补匠的角色标记旁，等到黎明再宣布这个夜晚有哪些玩家死亡了。（不要说出修补匠的死亡原因。）");
    g_tipLine[10189] = StringToText("虽然你可以在白天冷不丁地杀死修补匠，但是修补匠还是死在夜晚会更有意思，");
    g_tipLine[10190] = StringToText("  因为玩家们会想知道修补匠到底是因为自己的能力死亡的，还是因为别的什么原因。");
    g_tipLine[10191] = StringToText("你可以一直不杀死修补匠。这会让他看起来非常可疑。");
    g_tipLine[10192] = StringToText("如果杀死修补匠会导致游戏结束，那我们推荐你永远不要在这种情况下杀死他。游戏的获胜与否应当靠玩家自己的努力，");
    g_tipLine[10193] = StringToText("  而不是看说书人的脸色。");
    g_tipLine[10194] = StringToText("【提示标记】");
    g_tipLine[10195] = StringToText("· 死亡");
    g_tipLine[10196] = StringToText("放置时机：在夜晚期间，说书人决定修补匠死亡时。");
    g_tipLine[10197] = StringToText("放置条件：如果说书人决定让修补匠死亡，则在修补匠的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[10198] = StringToText("  如果说书人选择让修补匠在白天死去，则不需要放置提示标记，而是直接放置帷幕标记并提示玩家翻转自己的生命标记即可。");
    g_tipLine[10199] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10200] = StringToText("【提示与技巧】");
    g_tipLine[10201] = StringToText("· 说书人将你的生命掌握在他手中，并且可以瞬间扼杀你！不要低估每一次看似不重要的突然死亡——不要给他机会在一个对善良");
    g_tipLine[10202] = StringToText("  阵营非常不利的时间杀死你！");
    g_tipLine[10203] = StringToText("· 在你死后，要表明你是修补匠，尤其是当你在晚上死去的时候。虽然你可能会成为恶魔（或狡猾的刺客）的目标，");
    g_tipLine[10204] = StringToText("  但说书人可以随时杀死你，并且可能在晚上让你死亡以支持邪恶阵营。例如，如果恶魔被驱魔人挡住了，你可能会死去，");
    g_tipLine[10205] = StringToText("  以创造恶魔仍在行动的迹象，来保住恶魔。如果驱魔人玩家知道这一点，他们可以决定再次阻止同一玩家，");
    g_tipLine[10206] = StringToText("  而不是认为他们不是恶魔，从而忽略。你的死亡也可以造成是不同恶魔在场的假象——例如，");
    g_tipLine[10207] = StringToText("  你额外的死亡可能表明存在沙巴洛斯，而恶魔实际上可能是普卡。");
    g_tipLine[10208] = StringToText("· 你很少会在公开场合死去——如果这么做，所有镇民会一起目睹惨剧。虽然这个意外的死亡可能看起来很不好受，");
    g_tipLine[10209] = StringToText("  但考虑一下这个好处——大家都会相信你是修补匠，善良阵营可以相信你，因为没有其他人可以在处决之外的白天公开死亡。");
    g_tipLine[10210] = StringToText("  利用这一点，在时候帮助剩下的善良玩家。");
    g_tipLine[10211] = StringToText("· 说书人一直在努力创造一个平衡的游戏，让善恶都有平等的获胜机会。这意味着即使你的死亡通常看起来是随机的，");
    g_tipLine[10212] = StringToText("  它也可能是为了某种更大的目的。这也意味着如果他选择不杀你，这就是一种信息，特别是当城镇减少到只剩下三名玩家时。");
    g_tipLine[10213] = StringToText("  如果你在游戏接近尾声时仍然站着，开始思考为什么说书人不冒险杀死你。你是少数几个还活着的善良玩家之一吗？");
    g_tipLine[10214] = StringToText("  （或者他们只是因为知道你会死而与你开玩笑？）");
    g_tipLine[10215] = StringToText("· 不过说真的，对说书人好一点。大多数说书人会对新玩家宽容以待。");
    g_tipRoleAt[35] = 10171; g_tipRoleN[35] = 45; g_tipP1At[35] = 10174; g_tipP1N[35] = 6; g_tipP2At[35] = 0; g_tipP2N[35] = 0;
    g_tipAbility[35] = StringToText("你随时可能死亡。");
    g_tipLine[10216] = StringToText("【背景故事】");
    g_tipLine[10217] = StringToText("「天蝎座侧身遥望恋人，此刻即为抉择进行之时。");
    g_tipLine[10218] = StringToText("以白银拂过我的掌心，你的宿命将在此地揭示。");
    g_tipLine[10219] = StringToText("以钢铁穿过我的咽喉，群星在上你将追悔莫及。」");
    g_tipLine[10220] = StringToText("【角色能力】");
    g_tipLine[10221] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是善良的，在当晚他会死亡。");
    g_tipLine[10222] = StringToText("【角色简介】");
    g_tipLine[10223] = StringToText("月之子会在死亡时诅咒他人，将其杀死。");
    g_tipLine[10224] = StringToText("· 月之子必须在得知自己死亡后的一到两分钟内选择一名玩家，无论是被处决后，还是在黎明说书人宣布夜晚的死亡玩家后。");
    g_tipLine[10225] = StringToText("  月之子可以在作出决定前花点时间听取大家的建议。");
    g_tipLine[10226] = StringToText("· 如果月之子选择了一名善良玩家，该玩家会在当晚死亡。如果月之子选择了一名邪恶玩家，无事发生。");
    g_tipLine[10227] = StringToText("· 一如既往地，如果一名邪恶玩家伪装成月之子假装使用能力，说书人应当配合他。");
    g_tipLine[10228] = StringToText("· 说书人并没有义务提醒月之子来选择玩家。月之子必须在得知自己死亡后的短时间内使用自己的能力。");
    g_tipLine[10229] = StringToText("  故意不使用能力将被认定为作弊。");
    g_tipLine[10230] = StringToText("· 如果月之子在夜晚是清醒且健康的，但在今天白天选择玩家时是醉酒或中毒的，所选的玩家会死亡。");
    g_tipLine[10231] = StringToText("  如果月之子在夜晚是醉酒或中毒的，但在今天白天选择玩家时是清醒且健康的，所选的玩家不会死亡。");
    g_tipLine[10232] = StringToText("· 如果月之子在选择莽夫时，莽夫是善良的，则无论莽夫的阵营在夜晚如何变化，月之子都会杀死莽夫。");
    g_tipLine[10233] = StringToText("【范例】");
    g_tipLine[10234] = StringToText("普卡杀死了月之子。在下一个白天，月之子选择了一名玩家，该玩家是驱魔人。当晚，驱魔人死亡。");
    g_tipLine[10235] = StringToText("和平主义者在场。月之子被处决但依然存活。月之子无法选择玩家，因为月之子没有死亡。");
    g_tipLine[10236] = StringToText("沙巴洛斯吞食了月之子。月之子选择了刺客，刺客依然存活。沙巴洛斯当晚再次吞食了月之子，并在下一夜将其反刍。");
    g_tipLine[10237] = StringToText("  几个夜晚后，沙巴洛斯又吞食了月之子。这一次，月之子选择了造谣者，造谣者死亡。");
    g_tipLine[10238] = StringToText("【运作方式】");
    g_tipLine[10239] = StringToText("当你宣布月之子玩家死亡时，月之子需要选择任意一名存活玩家。如果所选玩家是善良的，将「死亡」");
    g_tipLine[10240] = StringToText("  提示标记放置到该玩家的角色标记旁。当晚，标有月之子的「死亡」提示标记的玩家死亡。");
    g_tipLine[10241] = StringToText("如果月之子没有意识到自己必须在死亡时选择一名玩家，私下提醒该玩家。新手玩家可能没有弄清楚自己的角色是如何运作的。");
    g_tipLine[10242] = StringToText("【提示标记】");
    g_tipLine[10243] = StringToText("· 死亡");
    g_tipLine[10244] = StringToText("放置时机：在月之子得知自己死亡后，使用自己的能力选择了一名存活玩家时。");
    g_tipLine[10245] = StringToText("放置条件：如果月之子选择的存活玩家属于善良阵营，则在该存活玩家的角色标记旁放置此标记，");
    g_tipLine[10246] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。在月之子选择时不论月之子是否中毒醉酒，");
    g_tipLine[10247] = StringToText("  只判断他选择的玩家是否善良来决定是否放置标记。（因为月之子的能力是回溯型能力）");
    g_tipLine[10248] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10249] = StringToText("  或者在夜晚行动轮到月之子的行动时月之子醉酒中毒，或月之子离场，则移除此标记。");
    g_tipLine[10250] = StringToText("【提示与技巧】");
    g_tipLine[10251] = StringToText("· 如果可以的话，尽量避免死亡！即使你是外来者，你仍然是一名善良玩家，在这个剧本中，并没有很多善良玩家是多余的。");
    g_tipLine[10252] = StringToText("  对你来说尤其如此，因你的能力额外死的玩家一定是好人，你甚至不能指望带走一个邪恶的人。");
    g_tipLine[10253] = StringToText("  用难以杀死的角色（比如弄臣或莽夫）来伪装以避开恶魔的注意是一个不错的选择，");
    g_tipLine[10254] = StringToText("  尤其是如果你悄悄地向善良的玩家表露你的角色，他们就不会轻易处决你。或者，在绝对必要之前，");
    g_tipLine[10255] = StringToText("  你可以不向任何人承认任何事情，从而保证自己的安全！");
    g_tipLine[10256] = StringToText("· 也可以直接赴死。这并不总是最好的举动（实际上应该只在游戏的早期尝试），");
    g_tipLine[10257] = StringToText("  但你的能力强大到可以确认角色是否善良——如果他们死了，你可以确信他们说的是实话，也就是说可以信任他们的信息。");
    g_tipLine[10258] = StringToText("  最好在你死前协调好你要选择的人——有一些善良角色适合早逝。如果你正在怀疑某人，");
    g_tipLine[10259] = StringToText("  要求城镇处决你以获取信息也是建立信任的好方法 - 大多数邪恶的玩家不会自愿去死。不过，");
    g_tipLine[10260] = StringToText("  僵怖和魔鬼代言人可能会给你的分析添麻烦！");
    g_tipLine[10261] = StringToText("· 在死亡时，选择一个你认为对你致命的诅咒有好处的人。这有几个重要的原因！首先，如果他们死了：你可以相信他们是好的，");
    g_tipLine[10262] = StringToText("  并且他们拥有的任何信息都可能是可靠的。其次，如果你的能力激活而这个人死了，");
    g_tipLine[10263] = StringToText("  很可能你说的是实话——虽然邪恶阵营可以通过恶魔或刺客的帮助来模拟你的能力激活，但他们通常会接受你免费的额外击杀，");
    g_tipLine[10264] = StringToText("  导致不寻常的死亡人数。好团队相信你，他们就可以相信你杀的人，然后从那里开始拼凑信息，找出潜伏在小镇的邪恶团队！");
    g_tipLine[10265] = StringToText("· 在死亡时，也可以选择一个你怀疑是邪恶的人。这有几个重要的原因！首先，");
    g_tipLine[10266] = StringToText("  如果你认为接下来的晚上会出现大量死亡（例如珀已经蓄力），那么你能力的额外杀戮可能会让善良方更劣势。其次，");
    g_tipLine[10267] = StringToText("  你选那个玩家居然没死？那么你可以有理由相信他们是邪恶的。虽然也不一定确认他是邪恶的，但如果您认为自己是清醒的，");
    g_tipLine[10268] = StringToText("  那么请以怀疑的态度看待该玩家 - 通常有不止一个线索表明某人不是他们声称的那个人。");
    g_tipLine[10269] = StringToText("· 在选择要杀死的玩家时，请注意「不会死」或在夜间受到保护的角色不会因你的能力而死亡。这包括像水手和弄臣这样的角色，");
    g_tipLine[10270] = StringToText("  以及受茶艺师或旅店老板保护的玩家。试着在你死之前对在场玩家角色有一个很好的了解，");
    g_tipLine[10271] = StringToText("  这样你就可以围绕这些角色进行选择。或者，如果你想避免额外的死亡，你可以刻意选择其中之一，避免死亡人数急剧上升。");
    g_tipLine[10272] = StringToText("· 如果教父在场，他们将有机会在你死的同一晚杀死某人。如果你怀疑场上有教父，");
    g_tipLine[10273] = StringToText("  请注意这种额外的杀戮并相应地计划你的选择。另请注意，他们可能会选择欺骗你，让你相信你杀死了一名善良玩家，");
    g_tipLine[10274] = StringToText("  但实际上这是一个主动赴死的邪恶爪牙，在传播混乱的信息！");
    g_tipRoleAt[36] = 10216; g_tipRoleN[36] = 59; g_tipP1At[36] = 10220; g_tipP1N[36] = 13; g_tipP2At[36] = 0; g_tipP2N[36] = 0;
    g_tipAbility[36] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家。如果他是善良的，在当晚他会死亡。");
    g_tipLine[10275] = StringToText("【背景故事】");
    g_tipLine[10276] = StringToText("「是的，老大。我跟那个家伙好好解释过了。他不愿意再听我解释一遍。不不，老大，我不需要医生——只是刀伤而已。");
    g_tipLine[10277] = StringToText("  明天早上就好了。」");
    g_tipLine[10278] = StringToText("【角色能力】");
    g_tipLine[10279] = StringToText("每个夜晚，首个使用其自身能力选择了你的玩家会醉酒直到下个黄昏。你会转变为他的阵营。");
    g_tipLine[10280] = StringToText("【角色简介】");
    g_tipLine[10281] = StringToText("莽夫在夜晚对其他角色的能力免疫，但是会不断改变阵营。");
    g_tipLine[10282] = StringToText("· 每个夜晚，被唤醒的玩家之中，首个使用自己的能力选择了莽夫的玩家将会立即醉酒。");
    g_tipLine[10283] = StringToText("  该玩家的能力在当晚和下一个白天不会生效。");
    g_tipLine[10284] = StringToText("· 之后在同一个夜晚，如果另一位玩家被唤醒且使用自己的能力选择了莽夫，该能力会正常生效。");
    g_tipLine[10285] = StringToText("· 除非玩家自己选择了莽夫，否则莽夫不能让玩家醉酒。通过祖母之类的角色能力，而由说书人选择了莽夫不算在内。");
    g_tipLine[10286] = StringToText("· 一旦莽夫让一名玩家醉酒，莽夫的阵营改变为与该玩家一致。如果选择莽夫的玩家已经醉酒或中毒，");
    g_tipLine[10287] = StringToText("  莽夫仍然会改变阵营并让该玩家醉酒。");
    g_tipLine[10288] = StringToText("· 如果被刺客选择，莽夫会死亡，但仍然会转变为邪恶阵营。");
    g_tipLine[10289] = StringToText("【范例】");
    g_tipLine[10290] = StringToText("侍臣选择了莽夫。莽夫转变为善良阵营，并且侍臣醉酒。");
    g_tipLine[10291] = StringToText("沙巴洛斯攻击了莽夫和造谣者。由于沙巴洛斯在选择莽夫的那一刻就醉酒，所以莽夫和造谣者都不会死亡，且莽夫转为邪恶。");
    g_tipLine[10292] = StringToText("  在下一个夜晚，沙巴洛斯攻击了赌徒和莽夫。赌徒死亡，然后沙巴洛斯因为莽夫而再次醉酒。莽夫仍存活且仍为邪恶。");
    g_tipLine[10293] = StringToText("侍女选择了莽夫和吟游诗人，并得知了「1」，因为侍女醉酒了。");
    g_tipLine[10294] = StringToText("（此范例假设了侍女是当夜首个使用能力选择莽夫的角色，且莽夫仍为善良，");
    g_tipLine[10295] = StringToText("  因此在本该得知0的基础上因为醉酒所以得知了1）");
    g_tipLine[10296] = StringToText("茶艺师的邻近玩家是善良的莽夫和修补匠。修补匠被处决但没有死亡。在下一个白天，莽夫转变为邪恶阵营。");
    g_tipLine[10297] = StringToText("  修补匠再次被处决，并且死亡。");
    g_tipLine[10298] = StringToText("【运作方式】");
    g_tipLine[10299] = StringToText("在夜晚，如果一名玩家用自己的能力选择了莽夫，并且莽夫的「醉酒」提示标记未激活，那么该玩家立即醉酒——将「醉酒」");
    g_tipLine[10300] = StringToText("  标记放置到该玩家角色标记旁。完成该玩家的能力结算并让他重新入睡。如果该玩家与莽夫阵营不同，");
    g_tipLine[10301] = StringToText("  旋转莽夫的角色标记（正向放置代表善良，颠倒放置代表邪恶）以符合他的阵营，然后唤醒莽夫，");
    g_tipLine[10302] = StringToText("  对他做出拇指手势（指明他的新阵营），然后让莽夫重新入睡。");
    g_tipLine[10303] = StringToText("在下一个黄昏，因莽夫而醉酒的玩家恢复清醒——移除莽夫的「醉酒」提示标记。");
    g_tipLine[10304] = StringToText("【提示标记】");
    g_tipLine[10305] = StringToText("· 醉酒");
    g_tipLine[10306] = StringToText("放置时机：每个夜晚，莽夫第一次被其他玩家使用自身能力（不论该能力是否会产生任何效果，是否该玩家在选择时醉酒中毒）");
    g_tipLine[10307] = StringToText("  选择时。");
    g_tipLine[10308] = StringToText("放置条件：将此标记放置在那名玩家的角色标记旁。（对于是否是首次被其他玩家选择，只需要检查莽夫的「醉酒」");
    g_tipLine[10309] = StringToText("  标记是否已经放置进魔典中某个角色标记旁）");
    g_tipLine[10310] = StringToText("移除时机：在黄昏时，或莽夫死亡或离场时。");
    g_tipLine[10311] = StringToText("【规则细节】");
    g_tipLine[10312] = StringToText("· 相克规则：");
    g_tipLine[10313] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。");
    g_tipLine[10314] = StringToText("  · 科学怪人：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[10315] = StringToText("【提示与技巧】");
    g_tipLine[10316] = StringToText("· 与其他玩家相比，莽夫处于一个有趣的位置，因为直到最后你都无法确定自己将为哪个阵营效力。安静地坐着，虚张声势，");
    g_tipLine[10317] = StringToText("  看看游戏如何展开对你有利——你的能力会给你大量的信息，你将处于一个很好的位置来帮助你的团队进入游戏尾声……不管你");
    g_tipLine[10318] = StringToText("  站在哪一边。");
    g_tipLine[10319] = StringToText("· 或者，特别是如果你早早变成邪恶阵营——出来吧！让两个阵营都知道你在比赛中可以让他们为你的忠诚而战，这总是很有趣。");
    g_tipLine[10320] = StringToText("  这还可以让双方的玩家都知道以你为目标是一个糟糕的选择……如果这是你想要解决的问题。请注意，");
    g_tipLine[10321] = StringToText("  如果你在一个热衷于处决的嗜血城镇，这可能会有风险——他们可能会因为潜在的邪恶罪行而处决您。");
    g_tipLine[10322] = StringToText("  不过你可以试着阻止他们——指出一旦你死了，你的阵营就会被锁定，因为你会失去你的能力，而如果他们让你活着，");
    g_tipLine[10323] = StringToText("  可能让你重新变回善良的！");
    g_tipLine[10324] = StringToText("· 你不太可能在晚上死去。多亏了你强大的能力，其他角色的能力在他们触发之前就会出现问题 - 即使是普卡也是如此，");
    g_tipLine[10325] = StringToText("  他们在毒死你之前就出现了问题。（不过要当心刺客，他可以直接杀死你——如果你惹恼他们，邪恶的小队可以把你送走！）");
    g_tipLine[10326] = StringToText("· 当接近游戏结束时，你目前的阵营可能胜利也可能失败。如果你是善良的，");
    g_tipLine[10327] = StringToText("  这意味着是时候提供帮助了——揭示你是谁并提供你的信息！如果你的阵营在某些晚上改变，这可能是能力失败的迹象，");
    g_tipLine[10328] = StringToText("  并且可能暴露邪恶的玩家在利用你的沉默作为一个安全的空间来虚张声势。一旦你这样做了，");
    g_tipLine[10329] = StringToText("  那你真的需要尽快找到恶魔——如果还有一两个晚上，邪恶阵营可能会让你失望，如果是这样的话，");
    g_tipLine[10330] = StringToText("  你可以很好地把他们获胜的关键信息交给善良阵营，然后邪恶阵营就无法享受它了。");
    g_tipLine[10331] = StringToText("· 如果你在游戏快结束时是邪恶的，那么是时候散布一些混乱了（如果你还没有这样做的话！）。");
    g_tipLine[10332] = StringToText("  虽然你可以选择作为莽夫自称是善良阵营，但这并不是你唯一的选择——你可以随心所欲地虚张声势，制造混乱，");
    g_tipLine[10333] = StringToText("  甚至只是为了维持你善良的外表但实际上为邪恶。在这一点上尝试寻找其他邪恶的玩家也可能是一个好主意，");
    g_tipLine[10334] = StringToText("  从而你可以和其他邪恶玩家沟通合作。");
    g_tipRoleAt[37] = 10275; g_tipRoleN[37] = 60; g_tipP1At[37] = 10278; g_tipP1N[37] = 11; g_tipP2At[37] = 10311; g_tipP2N[37] = 4;
    g_tipAbility[37] = StringToText("每个夜晚，首个使用其自身能力选择了你的玩家会醉酒直到下个黄昏。你会转变为他的阵营。");
    g_tipLine[10335] = StringToText("【背景故事】");
    g_tipLine[10336] = StringToText("「吾即是暗夜……没错吧？」");
    g_tipLine[10337] = StringToText("【角色能力】");
    g_tipLine[10338] = StringToText("你以为你是一个恶魔，但其实你不是。");
    g_tipLine[10339] = StringToText("恶魔知道你是疯子以及你在每个夜晚选择了哪些玩家。");
    g_tipLine[10340] = StringToText("【角色简介】");
    g_tipLine[10341] = StringToText("疯子以为自己是恶魔。");
    g_tipLine[10342] = StringToText("· 和酒鬼很相似，疯子不知道自己的真实角色和真实阵营。疯子每个夜晚都会被唤醒来发动攻击，就如同他是场上真正的恶魔，");
    g_tipLine[10343] = StringToText("  但是疯子的选择没有效果，因为他没有恶魔的能力。");
    g_tipLine[10344] = StringToText("· 疯子会在首个夜晚被唤醒来得知三个不在场的角色，以及与当前游戏数量符合的爪牙，但是这些信息可能是错误的。");
    g_tipLine[10345] = StringToText("· 真正的恶魔会知道疯子每个夜晚攻击了哪些玩家。");
    g_tipLine[10346] = StringToText("【范例】");
    g_tipLine[10347] = StringToText("疯子以为自己是沙巴洛斯，每个夜晚被唤醒来选择两名玩家。他所选的玩家不会死亡。");
    g_tipLine[10348] = StringToText("疯子以为自己是僵怖，因为僵怖的能力导致他不会每个夜晚都被唤醒。真正的僵怖假装成了疯子的爪牙，");
    g_tipLine[10349] = StringToText("  且总是攻击疯子所选择的玩家，以维持住疯子就是恶魔的假象。");
    g_tipLine[10350] = StringToText("【运作方式】");
    g_tipLine[10351] = StringToText("在设置游戏时，将疯子标记和恶魔标记都放入盲抽袋内。在所有标记都返还给你后，");
    g_tipLine[10352] = StringToText("  在魔典中将疯子和恶魔的角色标记交换位置。");
    g_tipLine[10353] = StringToText("在首个夜晚，唤醒疯子，如同他是恶魔一般进行行动。向疯子展示「他们是你的爪牙」信息标记并指向若干名玩家，");
    g_tipLine[10354] = StringToText("  数量等同于在场的爪牙数量。（可以指向任何玩家，无论他们是不是爪牙。）");
    g_tipLine[10355] = StringToText("  向疯子展示任意三个善良角色标记作为他的「伪装」。（这些角色标记甚至可以是在场的角色。）");
    g_tipLine[10356] = StringToText("在首个夜晚，唤醒恶魔。向恶魔展示「你是」信息标记，然后是他的恶魔角色标记。（这会告知他才是真正的恶魔。）");
    g_tipLine[10357] = StringToText("  向恶魔展示「这名玩家是」信息标记，然后是疯子角色标记，然后指向疯子玩家。");
    g_tipLine[10358] = StringToText("每个夜晚，在恶魔被唤醒发动攻击前，唤醒疯子，如同他是恶魔一般进行行动。将「被选择」");
    g_tipLine[10359] = StringToText("  提示标记放置到疯子选择的每个角色标记旁，然后让疯子重新入睡。唤醒真正的恶魔，指向疯子玩家，");
    g_tipLine[10360] = StringToText("  向真正的恶魔展示疯子标记，然后指向疯子选择的玩家。接下来恶魔如常进行行动。");
    g_tipLine[10361] = StringToText("你能够让疯子以为自己是与在场的恶魔所不同的另一种恶魔，只需在盲抽袋中放入两个恶魔标记，并在将标记收回魔典之后，");
    g_tipLine[10362] = StringToText("  将其中一个恶魔标记替换为疯子标记。");
    g_tipLine[10363] = StringToText("在线上游戏中，你可以不依照实体的初始设置规则进行游戏设置，而是在任何情况下（疯子以为的恶魔与真恶魔同一种类或不同");
    g_tipLine[10364] = StringToText("  种类皆可）都向疯子和真恶魔发送恶魔角色标记。但如果你真的这样做，请在游戏开始时对所有玩家阐述角色发送方式与实体规");
    g_tipLine[10365] = StringToText("  则的区别。");
    g_tipLine[10366] = StringToText("【提示标记】");
    g_tipLine[10367] = StringToText("· 被选择（共3枚）");
    g_tipLine[10368] = StringToText("放置时机：在疯子夜晚行动并选择了玩家后。");
    g_tipLine[10369] = StringToText("放置条件：根据疯子所以为的那种恶魔的行动方式，让疯子选择对应数量的玩家。");
    g_tipLine[10370] = StringToText("  在疯子所选择的这些玩家的角色标记旁各放置一个「被选择」标记，用以提示说书人在真恶魔行动前告知真恶魔疯子的选择目标");
    g_tipLine[10371] = StringToText("  。");
    g_tipLine[10372] = StringToText("移除时机：在黎明时。（由于可能在中途会有新的恶魔产生，而疯子的能力是持续暴露型能力，");
    g_tipLine[10373] = StringToText("  为了保证所有的恶魔都能在当晚正确地接受到信息，最好是在黎明时再进行移除。）");
    g_tipLine[10374] = StringToText("· 是疯子（仅线上魔典，实体没有此标记）");
    g_tipLine[10375] = StringToText("与酒鬼的「是酒鬼」提示标记处理方法类似。");
    g_tipLine[10376] = StringToText("【规则细节】");
    g_tipLine[10377] = StringToText("· 相克规则：");
    g_tipLine[10378] = StringToText("  · 数学家：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。");
    g_tipLine[10379] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[10380] = StringToText("  · 戏子（改）：疯子不会因为戏子（改）能力参与互认，也不会因为戏子（改）的能力醉酒。");
    g_tipLine[10381] = StringToText("【提示与技巧】");
    g_tipLine[10382] = StringToText("· 抽出恶魔角色总是令人兴奋的体验：你将与善良阵营对战，晚上将他们杀死，白天则当着他们的面撒谎！你是镇上危险的祸害，");
    g_tipLine[10383] = StringToText("  威胁要把他们都撕成碎片！！....好吧，要么，要么你是疯子。");
    g_tipLine[10384] = StringToText("· 疯子是一个独特的外来者，欺骗善良玩家相信他们是在为邪恶而战，却发现实际与你认为的不符。幸运的是，");
    g_tipLine[10385] = StringToText("  你的邪恶叙述中的这些问题将帮助你确定你是否真的是邪恶的！在几乎所有情况下，最好假设您是正确的，");
    g_tipLine[10386] = StringToText("  并且只有真正开始怀疑您是否遇到了错误事情。例如：");
    g_tipLine[10387] = StringToText("  · 你杀死的玩家不会死，但其他人会。你是一名沙巴洛斯，但由于某种原因，你的每晚的2次杀戮中只有1次发生。你是僵怖，");
    g_tipLine[10388] = StringToText("    但昨天有处决和杀戮。虽然真正的恶魔可以看到并尝试模仿你的杀戮选择，");
    g_tipLine[10389] = StringToText("    但《黯月初升》中的恶魔色彩丰富且多种多样——密切关注杀戮成功或失败的原因。是狡猾的旅店老板占了你便宜，");
    g_tipLine[10390] = StringToText("    还是真正的恶魔不在乎你的妄想？");
    g_tipLine[10391] = StringToText("  · 与你的「爪牙」交谈。就像一个真正的恶魔一样，你会被告知与你一起的邪恶的玩家。如果他们是真正的爪牙，");
    g_tipLine[10392] = StringToText("    他们就会知道你是恶魔。但是，如果您是疯子……他们可能是任何人！镇民、其他外来者、");
    g_tipLine[10393] = StringToText("    真正恶魔的爪牙……密切关注你的邪恶队伍，看看他们的行为方式。如果他们支持你并与你合作，你可能没什么好害怕的。");
    g_tipLine[10394] = StringToText("    如果他们给你奇怪的表情，与你对抗，甚至直接告诉你他们不是你的爪牙，");
    g_tipLine[10395] = StringToText("    那么......这可能表明一切都与你的认知不符。");
    g_tipLine[10396] = StringToText("  · 像真正的恶魔一样，您还将收到三个不在游戏中的角色。如果你是疯子，你可以得知任何东西，");
    g_tipLine[10397] = StringToText("    并且通常会包括实际在游戏中的角色 - 暗示你的真实本性。如果您知道游戏中没有茶艺师，");
    g_tipLine[10398] = StringToText("    然后坐在对面的茶艺师证明了他们的角色（通过处决他们的一个邻居），那么可能是时候怀疑您的「邪恶」角色了。");
    g_tipLine[10399] = StringToText("  · 这似乎很明显，但如果你死了并且游戏继续进行，那么这表明你可能不是困扰这个城镇的恶魔。当然，请记住，如果您是僵怖，");
    g_tipLine[10400] = StringToText("    那您将获得额外的生命，而主谋会在您死亡的情况下强制游戏再继续一天。因此，根据游戏的特性，也许不要立即下结论。");
    g_tipLine[10401] = StringToText("· 如果你得出了你是疯子的结论，不要绝望——这意味着你的真正目标已经暴露，是时候为善良阵营而战了。");
    g_tipLine[10402] = StringToText("  您可能在游戏的前半部分都认为自己是一个嗜血的恶魔，但这并不意味着您现在不能成为小镇的一员，");
    g_tipLine[10403] = StringToText("  用您的投票和声音来对抗潜伏在其中的真正邪恶恶魔。");
    g_tipLine[10404] = StringToText("· 一旦你弄清楚了，不要马上出来——不仅善良阵营会倾向于怀疑并可能无论如何都会处决你，但如果邪恶阵营认为你受到束缚，");
    g_tipLine[10405] = StringToText("  你可以做很多事情让他们认为你仍然觉得自己是个疯子。例如，恶魔每天晚上都知道你选择去杀死谁——如果他们相信的选择，");
    g_tipLine[10406] = StringToText("  那么你可能会指向你怀疑实际上是邪恶的玩家。如果恶魔一直忠实地追随你直到那天晚上突然转向，");
    g_tipLine[10407] = StringToText("  那你可能已经打到了罪魁祸首，真正的邪恶恶魔。");
    g_tipLine[10408] = StringToText("· 如果您认为自己是疯子，请尽快告诉团队。你越早停止意外地为邪恶的阵营效力，而开始为善良阵营效力，");
    g_tipLine[10409] = StringToText("  你就能越早将所有信息放在一起。当善良阵营认为你是疯子时，可以确定正确的外来者数量，");
    g_tipLine[10410] = StringToText("  并且可以逆转你之前放弃的任何虚假信息。");
    g_tipRoleAt[38] = 10335; g_tipRoleN[38] = 76; g_tipP1At[38] = 10337; g_tipP1N[38] = 9; g_tipP2At[38] = 10376; g_tipP2N[38] = 5;
    g_tipAbility[38] = StringToText("你以为你是一个恶魔，但其实你不是。恶魔知道你是疯子以及你在每个夜晚选择了哪些玩家。");
    g_tipLine[10411] = StringToText("【背景故事】");
    g_tipLine[10412] = StringToText("「通常来说，这只是件小事。但在你侮辱我女儿时，你就侮辱了我。你侮辱我，就侮辱了我的家族。");
    g_tipLine[10413] = StringToText("  你真的应该更小心些——要是你不幸发生意外事故，那就太遗憾了。」");
    g_tipLine[10414] = StringToText("【角色能力】");
    g_tipLine[10415] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。");
    g_tipLine[10416] = StringToText("如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipLine[10417] = StringToText("【角色简介】");
    g_tipLine[10418] = StringToText("教父会在小镇杀害外来者时进行报复。");
    g_tipLine[10419] = StringToText("· 每当一名外来者死于处决，教父会在当晚选择一名玩家，使其死亡。");
    g_tipLine[10420] = StringToText("· 只有外来者在白天死去时，教父才能杀死玩家。夜晚死亡的外来者不算在内。");
    g_tipLine[10421] = StringToText("· 如果教父在场，会在场上增加或减少一个外来者。");
    g_tipLine[10422] = StringToText("· 在游戏开始时，教父会得知哪些外来者在场。");
    g_tipLine[10423] = StringToText("· 如果今天白天有两名外来者玩家死亡，当晚教父仍然只能杀死一名玩家。");
    g_tipLine[10424] = StringToText("【范例】");
    g_tipLine[10425] = StringToText("教父得知疯子和月之子在场，因此教父伪装成修补匠。在第三个白天，疯子死于处决。当晚，恶魔杀死了吟游诗人，");
    g_tipLine[10426] = StringToText("  同时教父杀死了和平主义者。");
    g_tipLine[10427] = StringToText("修补匠被处决但依然存活，因为他受到了魔鬼代言人的保护。教父当晚不行动。在下一个白天，修补匠因自己的能力而死亡。");
    g_tipLine[10428] = StringToText("  当晚，恶魔杀死了一名玩家，同时教父杀死了自己来假装成一名善良玩家。");
    g_tipLine[10429] = StringToText("【运作方式】");
    g_tipLine[10430] = StringToText("在设置游戏时，将角色标记放进盲抽袋之前，要么移除一个镇民并加入一个外来者，要么移除一个外来者并加入一个镇民。");
    g_tipLine[10431] = StringToText("在首个夜晚，唤醒教父。向教父展示所有在场的外来者的角色标记。让教父重新入睡。");
    g_tipLine[10432] = StringToText("如果一名外来者在白天死亡，将「死于今日」提示标记放置到该玩家的角色标记旁。当晚，唤醒教父。");
    g_tipLine[10433] = StringToText("  让教父指向任意一名玩家。让教父重新入睡。所选玩家死亡——将「死亡」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10434] = StringToText("【提示标记】");
    g_tipLine[10435] = StringToText("· 死于今日");
    g_tipLine[10436] = StringToText("放置时机：在白天时，如果有外来者死亡，不论死亡原因为何，在该玩家的角色标记旁放置。");
    g_tipLine[10437] = StringToText("放置条件：在死亡的外来者角色标记旁放置，而不论此时教父是否醉酒中毒。如果一天有多名外来者死亡，");
    g_tipLine[10438] = StringToText("  也只会有一个「死于今日」标记被放置。该标记会用于提醒说书人夜晚是否会唤醒教父。");
    g_tipLine[10439] = StringToText("移除时机：在教父夜晚行动后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10440] = StringToText("特殊说明：由于教父的能力为回溯型能力，因此如果教父在游戏中途产生，仍然要根据当前情况补放标记，");
    g_tipLine[10441] = StringToText("  而不是因为没有放置标记便不在夜晚唤醒教父。");
    g_tipLine[10442] = StringToText("· 死亡");
    g_tipLine[10443] = StringToText("放置时机：在教父夜晚行动并选择了玩家后放置。");
    g_tipLine[10444] = StringToText("放置条件：教父选择的玩家当前存活，且能被教父杀死，且教父未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[10445] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[10446] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10447] = StringToText("【规则细节】");
    g_tipLine[10448] = StringToText("· 相克规则：");
    g_tipLine[10449] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[10450] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[10451] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[10452] = StringToText("【提示与技巧】");
    g_tipLine[10453] = StringToText("· 教父可以根据说书人判断在正常游戏设置中添加或删除外来者。然后，您可以在晚上杀死这些无辜的善良玩家以获得额外的杀戮");
    g_tipLine[10454] = StringToText("  ……但前提是您可以说服城镇为您做肮脏的工作！你的能力是微妙的，但如果以正确的方式去滥用，就会变得强大。");
    g_tipLine[10455] = StringToText("· 你开始知道哪些外来者在玩，这可以帮助你和你的邪恶团队了解会发生什么。例如，如果您知道有一个疯子，");
    g_tipLine[10456] = StringToText("  您可以期望他们暂时不会出现，并且可以自己作为一个额外的外来者伪装。或者，如果有一个莽夫，");
    g_tipLine[10457] = StringToText("  你可能想找到他们并使其归顺，让他们变得邪恶加入你，而不是仅仅让他们被杀。这是可靠、");
    g_tipLine[10458] = StringToText("  强大的信息——使用它可以最好地帮助您的团队。");
    g_tipLine[10459] = StringToText("· 如果外来者比预期的少，你可以用伪装来填补这个空白——如果外来者的数量比预期的多或少，玩家会怀疑你，");
    g_tipLine[10460] = StringToText("  但如果外来者的数量与预期的一样多，他们往往会完全忽略你。（这也可以使它成为你的恶魔的特殊伪装！）");
    g_tipLine[10461] = StringToText("· 如果游戏中的外来者比预期的要多，那么最好尝试说服大家没有教父在场，并且其中一个邪恶玩家在伪装外来者。");
    g_tipLine[10462] = StringToText("  这不仅保持了爪牙在游戏中的模糊性（意味着可怕的主谋仍然有可能在策划个大事件），而且如果他们相信你，");
    g_tipLine[10463] = StringToText("  他们甚至可能开始处决外来者，给你一个免费的额外杀戮！");
    g_tipLine[10464] = StringToText("· 以任何必要的方式处决外来者！你不仅杀死了一个善良玩家并可能激活了像月之子这样的角色，而且当晚你将获得额外的杀戮。");
    g_tipLine[10465] = StringToText("  如果你能把握好时机，你的邪恶团队可以在你意想不到的帮助下对善良团队发动毁灭性的反击！");
    g_tipLine[10466] = StringToText("· 当你有机会杀戮时与恶魔好好配合，以最大限度地增加死亡的玩家数量。本来好不容易有机会杀戮，");
    g_tipLine[10467] = StringToText("  结果却因为恶魔本来就要杀死他们而重复了，那可太糟了。另外，在一个晚上死去的玩家越多，善良阵营就越有可能完全恐慌。");
    g_tipLine[10468] = StringToText("· 当你有机会杀戮时，你可以故意选择一个死去的玩家来掩盖你的额外杀戮，隐藏你的角色在游戏中的事实。");
    g_tipLine[10469] = StringToText("  如果您试图宣传没有教父在场，这将非常有用-善良团队通常会在他们意识到您在场时停止杀死外来者，");
    g_tipLine[10470] = StringToText("  并且这种方法会牢牢地将阴影笼罩在他们身上。延迟满足的致命杀戮在游戏后期可能会更令你激动！");
    g_tipLine[10471] = StringToText("【对抗教父】");
    g_tipLine[10472] = StringToText("当你要对抗教父的时候，这里有几件事你应该记住：");
    g_tipLine[10473] = StringToText("· 计算有多少外来者在游戏中。如果这个数字比应该有的数字少1或多1，那么你可能有一个教父在场。一些外来者玩家，");
    g_tipLine[10474] = StringToText("  尤其是莽夫和疯子可能不想立即透露他们是谁，所以一开始这可能会很棘手。但是，如果你能让所有外来者都透露他们是谁，");
    g_tipLine[10475] = StringToText("  而且结果与预期不同，那么你就知道外来者在撒谎，或者你们中间有教父。");
    g_tipLine[10476] = StringToText("· 如果你知道一个教父在场，那么你就知道其他爪牙不在场（如果场上只有 1 个爪牙）。在这种情况下，");
    g_tipLine[10477] = StringToText("  你就能知道自称是外来者的玩家就是善良阵营，不应该被处决，而且你也不必担心主谋或魔鬼代言人。");
    g_tipLine[10478] = StringToText("· 如果你怀疑是教父，那就永远不要杀死外来者。处决外来者会让你们失去一名善良玩家，然后当晚你将失去另外2个（或更多！");
    g_tipLine[10479] = StringToText("  ）善良玩家，这可能是毁灭性的。");
    g_tipLine[10480] = StringToText("· 在黯月初升中，知道哪些爪牙在场是获胜的关键。如果您不知道教父是否在场，并且处决了外来者，");
    g_tipLine[10481] = StringToText("  请特别注意当晚有多少玩家死亡。如果当晚有额外的玩家死亡，或者人数正常，您就会知道哪些爪牙在场。");
    g_tipLine[10482] = StringToText("  可能还有其他原因导致额外玩家在晚上死亡，例如赌徒、造谣者或修补匠，因此请先排除这些原因。");
    g_tipRoleAt[39] = 10411; g_tipRoleN[39] = 72; g_tipP1At[39] = 10414; g_tipP1N[39] = 10; g_tipP2At[39] = 10447; g_tipP2N[39] = 5;
    g_tipAbility[39] = StringToText("在你的首个夜晚，你会得知有哪些外来者角色在场。如果有外来者在白天死亡，你会在当晚被唤醒并且你要选择一名玩家：他死亡。[-1或+1外来者]");
    g_tipLine[10483] = StringToText("【背景故事】");
    g_tipLine[10484] = StringToText("「如果异议被驳回，我的委托人将进行无罪申辩，理由是控方不遵守法规第27章B条——针对动词进行非正确或误导性的词形");
    g_tipLine[10485] = StringToText("  变化。昨晚有九名陪审团成员死亡，这个事实只不过是表面证据，正如威尔斯诉图勒案所开创的先例，");
    g_tipLine[10486] = StringToText("  这是无罪释放的进一步理由。」");
    g_tipLine[10487] = StringToText("【角色能力】");
    g_tipLine[10488] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipLine[10489] = StringToText("【角色简介】");
    g_tipLine[10490] = StringToText("魔鬼代言人能在处决中拯救玩家。");
    g_tipLine[10491] = StringToText("· 每个夜晚，魔鬼代言人需要选择一名存活的玩家，保护他不会因处决而死亡。在下一个白天，如果该玩家被处决，");
    g_tipLine[10492] = StringToText("  处决会成功但该玩家依然存活。");
    g_tipLine[10493] = StringToText("· 魔鬼代言人不能连续两个夜晚选择同一名玩家，无论该玩家是否从处决中被救出，");
    g_tipLine[10494] = StringToText("  并且魔鬼代言人也不能选择被当作死亡的僵怖。");
    g_tipLine[10495] = StringToText("【范例】");
    g_tipLine[10496] = StringToText("在夜晚，魔鬼代言人保护了自己。在下一个白天，魔鬼代言人被处决但依然存活。");
    g_tipLine[10497] = StringToText("魔鬼代言人保护了僵怖。僵怖被处决但依然存活，因此其生命标记不翻面。在下一个白天，僵怖再次被处决，");
    g_tipLine[10498] = StringToText("  并且被当作已死亡。");
    g_tipLine[10499] = StringToText("魔鬼代言人保护了教父。教父被处决但依然存活。之后，魔鬼代言人保护了修补匠。修补匠被处决，但是由于修补匠的能力，");
    g_tipLine[10500] = StringToText("  说书人还是杀死了修补匠。（注：此时说书人宣布的是修补匠被处决，然后死亡，但并没有说明死亡原因，");
    g_tipLine[10501] = StringToText("  因此可能会被其他玩家误以为修补匠是死于处决）之后，魔鬼代言人保护了月之子，");
    g_tipLine[10502] = StringToText("  并且法官强制让本次处决成功——处决被执行，但月之子依然存活。");
    g_tipLine[10503] = StringToText("【运作方式】");
    g_tipLine[10504] = StringToText("每个夜晚，唤醒魔鬼代言人。让魔鬼代言人指向任意一名玩家。如果魔鬼代言人选择了他上一夜曾选择的玩家或已死亡的玩家，");
    g_tipLine[10505] = StringToText("  提醒他更换目标。让魔鬼代言人重新入睡。将「处决不死」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10506] = StringToText("如果标有「处决不死」的玩家被处决，宣布该玩家被处决但依然存活。（不要说明原因。）");
    g_tipLine[10507] = StringToText("【提示标记】");
    g_tipLine[10508] = StringToText("· 处决不死");
    g_tipLine[10509] = StringToText("放置时机：在魔鬼代言人行动并选择了玩家后放置。");
    g_tipLine[10510] = StringToText("放置条件：在魔鬼代言人选择的玩家角色标记旁放置。魔鬼代言人不能选择已经放置有「处决不死」标记的玩家。");
    g_tipLine[10511] = StringToText("  如果魔鬼代言人醉酒中毒，该标记不会有任何效果，但你仍然需要放置该标记，");
    g_tipLine[10512] = StringToText("  用于提示在下一夜让魔鬼代言人不能选择今夜选择的这名玩家。在魔典中将提示标记倒置，代表该提示标记没有任何效果，");
    g_tipLine[10513] = StringToText("  仅用于标记该玩家被魔鬼代言人选择过。");
    g_tipLine[10514] = StringToText("移除时机：在魔鬼代言人选择了下一个目标后，或魔鬼代言人死亡或离场时。");
    g_tipLine[10515] = StringToText("【规则细节】");
    g_tipLine[10516] = StringToText("无");
    g_tipLine[10517] = StringToText("【提示与技巧】");
    g_tipLine[10518] = StringToText("· 魔鬼代言人会干扰流程，即使被处决成功，也让被提名的玩家存活。可想而知，一个时机敏锐的聪明玩家，可以利用这个能力，");
    g_tipLine[10519] = StringToText("  严重破坏善良阵营猎杀恶魔的能力！");
    g_tipLine[10520] = StringToText("· 保护你的恶魔——如果你认为他们可能被处决！因为你的保护不能连续两次对同一个玩家起作用，");
    g_tipLine[10521] = StringToText("  所以选择恶魔的时机非常重要——如果你在血腥的一天让恶魔孤立无援，那你和你的队伍可能会为此付出代价！");
    g_tipLine[10522] = StringToText("  密切关注善良团队、他们的信息以及他们的怀疑导向。");
    g_tipLine[10523] = StringToText("· 如果你能活到最后一天，就做好保护你的恶魔的准备。（注意此时吟游诗人或旅店老板如果活着——他们可能会处决你，");
    g_tipLine[10524] = StringToText("  然后以这种方式打断恶魔的能力，从而在最后一刻推翻你们。）");
    g_tipLine[10525] = StringToText("· 保护自己和其他爪牙。尽管保护恶魔才是你的头等大事，但活着的邪恶玩家越多越好！如果您有一个主谋尤其如此，");
    g_tipLine[10526] = StringToText("  只有在其他一切都失败时他们才能幸存下来，或者甚至只是一个还没有刺伤任何人的刺客，他才会受益。就像恶魔一样，");
    g_tipLine[10527] = StringToText("  注意善良团队怀疑谁，并尝试用他们的目标来确定你授予谁免疫处决的机会。");
    g_tipLine[10528] = StringToText("· 保护你认为会被处决的善良玩家——这样做的好处是让这些玩家看起来非常可疑，特别是如果善良阵营已经知道（或怀疑）");
    g_tipLine[10529] = StringToText("  你在游戏中。虽然其他能力可以让一名善良玩家免于被执行，但那你适时的拯救加上一个耳语动作或只是因为偏执的善良玩家思");
    g_tipLine[10530] = StringToText("  维会让他们怀疑那些可怜的笨蛋。");
    g_tipLine[10531] = StringToText("· 您可以使用您的能力来模仿防止处决的善良角色能力 - 例如，茶艺师、水手或和平主义者。在所有这些伪装中，");
    g_tipLine[10532] = StringToText("  和平主义者是最简单的伪装，因为它的能力是随机的，所以善良团队不能尝试通过连续两次处决同一个玩家来「测试」");
    g_tipLine[10533] = StringToText("  你——但如果你认为你可以侥幸逃脱，你的虚张声势会显得格外稳固！");
    g_tipLine[10534] = StringToText("【对抗魔鬼代言人】");
    g_tipLine[10535] = StringToText("当你要对抗魔鬼代言人的时候，这里有几件事你应该记住：");
    g_tipLine[10536] = StringToText("· 当玩家被处决但没有死亡时，尽你所能确定原因。游戏中可能有茶艺师或和平主义者，或者被处决的玩家可能是弄臣或水手。");
    g_tipLine[10537] = StringToText("  如果你认为被处决的玩家是好人，你可以让他们活着，但如果你认为玩家是邪恶的并受到魔鬼代言人的保护，");
    g_tipLine[10538] = StringToText("  那么稍后再处决他们。");
    g_tipLine[10539] = StringToText("· 连续两次处决可疑的玩家。由于魔鬼代言人不能连续两次保护同一个玩家，如果玩家在今天的处决中幸存下来，");
    g_tipLine[10540] = StringToText("  明天杀死他们是规避棘手的魔鬼代言人的可靠方法。");
    g_tipLine[10541] = StringToText("· 如果您认为某人是邪恶的并且非常强烈地引导大家处决那个玩家，请等待一天并在明天处决该玩家。");
    g_tipLine[10542] = StringToText("  魔鬼代言人希望你处决受他们保护的玩家，所以如果你注意哪些玩家正在努力引导特定玩家被处决，");
    g_tipLine[10543] = StringToText("  你可以避免他们的能力生效，同时仍然处决你想要的玩家。");
    g_tipLine[10544] = StringToText("· 一旦你发现有魔鬼代言人在场，立即处决他们！虽然你可以忽略其他一些爪牙，但魔鬼代言人却不能。例如，");
    g_tipLine[10545] = StringToText("  如果你知道男爵是谁，你可能最好将注意力集中在其他玩家身上，并让男爵继续活着。或者，如果你确定了哪个玩家是刺客，");
    g_tipLine[10546] = StringToText("  你可以把他晾着，然后全力以赴处决恶魔。然而，魔鬼代言人真的，真的，无论如何都要死去才能获胜。如果可能的话，");
    g_tipLine[10547] = StringToText("  在将注意力集中在恶魔身上之前处决魔鬼代言人。");
    g_tipRoleAt[40] = 10483; g_tipRoleN[40] = 65; g_tipP1At[40] = 10487; g_tipP1N[40] = 8; g_tipP2At[40] = 10515; g_tipP2N[40] = 2;
    g_tipAbility[40] = StringToText("每个夜晚，你要选择一名存活的玩家（与上个夜晚不同）：如果明天白天他被处决，他不会死亡。");
    g_tipLine[10548] = StringToText("【背景故事】");
    g_tipLine[10549] = StringToText("「……」");
    g_tipLine[10550] = StringToText("【角色能力】");
    g_tipLine[10551] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipLine[10552] = StringToText("【角色简介】");
    g_tipLine[10553] = StringToText("刺客能杀死恶魔解决不掉的麻烦角色。");
    g_tipLine[10554] = StringToText("· 每局游戏限一次，在夜晚，刺客能杀死一名玩家。即使该玩家受到了包括角色能力在内的任何方式的保护而免于死亡，");
    g_tipLine[10555] = StringToText("  也依然会死亡。");
    g_tipLine[10556] = StringToText("· 刺客的能力如常受到醉酒和中毒的影响。");
    g_tipLine[10557] = StringToText("· 如果刺客攻击了莽夫，莽夫会死去并转变为邪恶阵营。");
    g_tipLine[10558] = StringToText("· 如果刺客攻击了尚未触发能力的僵怖（不论因为什么理由），僵怖会死去，但在死后触发能力且仍存活。");
    g_tipLine[10559] = StringToText("【范例】");
    g_tipLine[10560] = StringToText("在前三个夜晚刺客被唤醒，但是选择不行动。在第四个夜晚，刺客选择杀死弄臣。尽管弄臣还拥有自己的能力，");
    g_tipLine[10561] = StringToText("  他仍然死亡并保持已死亡状态。");
    g_tipLine[10562] = StringToText("茶艺师与两名善良玩家邻近。刺客选择杀死茶艺师的两名邻近玩家的其中之一，虽然受到茶艺师保护，该玩家依然死亡。");
    g_tipLine[10563] = StringToText("吟游诗人在场。主谋被处决。当晚，刺客选择杀死月之子，但是月之子没有死亡，因为刺客因吟游诗人而醉酒。");
    g_tipLine[10564] = StringToText("因侍臣而醉酒的刺客想要杀死莽夫。刺客已经失去能力，因此莽夫依然存活但转变为邪恶阵营。");
    g_tipLine[10565] = StringToText("【运作方式】");
    g_tipLine[10566] = StringToText("除了首个夜晚以外的每个夜晚，唤醒刺客。刺客要么摇头表示不使用能力，要么指向任意一名玩家。让刺客重新入睡。");
    g_tipLine[10567] = StringToText("如果刺客选择了玩家，该玩家死亡——将「死亡」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10568] = StringToText("  本次死亡不能通过任何方式来防止（除非刺客没有了能力，例如醉酒或中毒）。刺客失去自己的能力——将「失去能力」");
    g_tipLine[10569] = StringToText("  提示标记放置到刺客的角色标记旁，并从夜晚顺序表上移除其夜晚标记。（刺客不会再被唤醒。）");
    g_tipLine[10570] = StringToText("【提示标记】");
    g_tipLine[10571] = StringToText("· 死亡");
    g_tipLine[10572] = StringToText("放置时机：在刺客夜晚行动时选择使用能力，并选择了一名玩家后放置。");
    g_tipLine[10573] = StringToText("放置条件：刺客选择的玩家当前存活，且刺客未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[10574] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[10575] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10576] = StringToText("· 失去能力");
    g_tipLine[10577] = StringToText("放置时机：在刺客夜晚行动时选择使用能力，并选择了一名玩家后放置。");
    g_tipLine[10578] = StringToText("放置条件：只要刺客选择了玩家，不论刺客是否醉酒中毒，都会将此标记放置在刺客角色标记旁。");
    g_tipLine[10579] = StringToText("移除时机：刺客死亡或离场时。");
    g_tipLine[10580] = StringToText("【提示与技巧】");
    g_tipLine[10581] = StringToText("· 很少有爪牙拥有你所拥有的力量，绝对掌控他人的生死。没有任何保护措施可以保护玩家免受您的袭击（无论如何，");
    g_tipLine[10582] = StringToText("  除非您喝醉了，别这样）。享受善良阵营对你的恐惧，并在最糟糕的时刻摧毁他们的心智！");
    g_tipLine[10583] = StringToText("· 杀死你的恶魔无法杀死的玩家。那个驱魔人是在阻止你的恶魔行动吗？不会再阻止了。");
    g_tipLine[10584] = StringToText("  那个和平主义者是在旅店老板的保护下吗？小把戏罢了。一个自鸣得意的水手给你带来麻烦？让他不能见到明早的太阳。");
    g_tipLine[10585] = StringToText("  没有什么能阻止你的刀锋，所以你不妨充分利用，去袭击那些认为自己不会被选中的玩家。");
    g_tipLine[10586] = StringToText("· 杀死玩家以混淆死亡人数并掩盖游戏中的恶魔类型。如果玩家怀疑僵怖在场，您可以在恶魔无法杀戮的夜晚袭击，");
    g_tipLine[10587] = StringToText("  这会混淆信息（特别是因为您的能力可以模仿有毒素的普卡）。另一个有用的例子是为休息的珀提供掩护-善良阵营不会看到没");
    g_tipLine[10588] = StringToText("  人死亡的情况，这使得你的大哥在爆发时更具破坏性。");
    g_tipLine[10589] = StringToText("· 与你的恶魔协调希望你袭击的人。对于像沙巴洛斯和珀这样的爆发恶魔来说尤其如此，他们每晚可以杀死很多玩家，");
    g_tipLine[10590] = StringToText("  所以这总是值得讨论以避免与他们选择同一个玩家。你的额外杀戮很强大，但因为你和恶魔都选择同一个目标而「失去」");
    g_tipLine[10591] = StringToText("  它真的很糟糕。在这种情况下，沟通不会让你浪费能力。");
    g_tipLine[10592] = StringToText("· 如果你不知道要杀谁，或者如果你觉得特别棘手，你可以在晚上杀死自己（或杀死一个邪恶的玩家），");
    g_tipLine[10593] = StringToText("  让那个邪恶的玩家看起来像一个善良玩家。由于邪恶的玩家很少会在晚上死去，");
    g_tipLine[10594] = StringToText("  所以善良阵营通常会假设任何在晚上死去的玩家都是好的，相信该玩家的信息并将他们的信息作为假设。");
    g_tipLine[10595] = StringToText("  如果你在这个过程中削弱了一个善良玩家的能力，这会非常有害——例如，如果你知道旅店老板在晚上保护你，然后你自杀了，");
    g_tipLine[10596] = StringToText("  你不仅早上看起来没有问题，而且旅店老板也会以为他们确实在保护你。");
    g_tipLine[10597] = StringToText("【对抗刺客】");
    g_tipLine[10598] = StringToText("当你要对抗刺客的时候，这里有几件事你应该记住：");
    g_tipLine[10599] = StringToText("· 别做梦了！刺客有机会杀死他们选择的任何玩家，而该玩家无法做任何事情来阻止死亡的发生。旅店老板保护不了他们，");
    g_tipLine[10600] = StringToText("  茶艺师也保护不了，弄臣、水手，甚至莽夫都会死在刺客手上。作为一名善良玩家，");
    g_tipLine[10601] = StringToText("  与刺客作战的最佳方式就是注意刺客何时袭击并在之后收拾残局。好消息是，刺客每场游戏只能杀死一名玩家，");
    g_tipLine[10602] = StringToText("  而教父通常可以杀死多名玩家。");
    g_tipRoleAt[41] = 10548; g_tipRoleN[41] = 55; g_tipP1At[41] = 10550; g_tipP1N[41] = 9; g_tipP2At[41] = 0; g_tipP2N[41] = 0;
    g_tipAbility[41] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一名玩家：他死亡，即使因为任何原因让他不会死亡。");
    g_tipLine[10603] = StringToText("【背景故事】");
    g_tipLine[10604] = StringToText("「怪物的触手被钉在了教堂大门上。母亲和孩子们在街上跳舞。棒极了。一切都在按我的计划进行。」");
    g_tipLine[10605] = StringToText("【角色能力】");
    g_tipLine[10606] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，");
    g_tipLine[10607] = StringToText("  他的阵营落败。");
    g_tipLine[10608] = StringToText("【角色简介】");
    g_tipLine[10609] = StringToText("主谋在恶魔死亡后仍然有方法获胜。");
    g_tipLine[10610] = StringToText("· 如果最后一名存活的恶魔死于处决，游戏继续。玩家们不会得知刚死去的是恶魔。在下一个白天，");
    g_tipLine[10611] = StringToText("  如果一名善良玩家被处决——无论该玩家是否死于处决——邪恶阵营获胜。如果一名邪恶玩家被处决，或者没有人被处决，");
    g_tipLine[10612] = StringToText("  则善良阵营获胜。");
    g_tipLine[10613] = StringToText("· 已死亡的恶魔无法进行攻击，如常失去自己的能力。在这个额外的夜晚和白天，其他角色的能力会正常生效。");
    g_tipLine[10614] = StringToText("· 如果恶魔死亡且只剩余两名存活玩家，游戏仍然会额外进行一天——邪恶阵营不会因为只剩两名存活玩家而获胜，");
    g_tipLine[10615] = StringToText("  而善良阵营也不会因为杀死了恶魔而获胜。主谋的能力为「额外进行一天一夜」，此能力会覆盖游戏常规规则。");
    g_tipLine[10616] = StringToText("【范例】");
    g_tipLine[10617] = StringToText("（注：以下范例都假设为主谋在场）");
    g_tipLine[10618] = StringToText("沙巴洛斯死亡。在下一个白天，教授被处决且死亡。邪恶阵营获胜。");
    g_tipLine[10619] = StringToText("珀死亡。在下一个白天，教父被处决，但因为魔鬼代言人的保护而依然存活。然而，由于一名邪恶玩家被处决，善良阵营获胜。");
    g_tipLine[10620] = StringToText("僵怖被处决，且看起来已经死亡。主谋的能力还未触发，因为处决僵怖并未导致游戏结束。当僵怖被第二次处决并真的死去时，");
    g_tipLine[10621] = StringToText("  主谋的能力才会触发，并会让游戏额外进行一天一夜。");
    g_tipLine[10622] = StringToText("场上有三名玩家存活。恶魔死亡。在下一个白天，只有两名玩家存活，善良阵营决定不进行处决。当夜幕降临，");
    g_tipLine[10623] = StringToText("  只有两名玩家存活但恶魔已经死亡，因此善良阵营获胜。");
    g_tipLine[10624] = StringToText("【运作方式】");
    g_tipLine[10625] = StringToText("如果恶魔死于处决且游戏即将结束，继续进行游戏。（如常添加帷幕标记。不要说出恶魔已经死了。）");
    g_tipLine[10626] = StringToText("明天，如果一名善良玩家被处决，宣布游戏结束且邪恶阵营获胜，但是如果一名邪恶玩家被处决，或没有玩家被处决，");
    g_tipLine[10627] = StringToText("  宣布游戏结束且善良阵营获胜。");
    g_tipLine[10628] = StringToText("【提示标记】");
    g_tipLine[10629] = StringToText("无");
    g_tipLine[10630] = StringToText("【规则细节】");
    g_tipLine[10631] = StringToText("· 相克规则：");
    g_tipLine[10632] = StringToText("  · 哈迪寂亚：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：如果他们都选择存活，邪恶阵营获胜。");
    g_tipLine[10633] = StringToText("    否则，善良阵营获胜。");
    g_tipLine[10634] = StringToText("  · 痢蛭：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[10635] = StringToText("  · 炼金术士：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_tipLine[10636] = StringToText("  · 亡骨魔：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipLine[10637] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[10638] = StringToText("  · 梼杌：主谋在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[10639] = StringToText("  · 姑获鸟：如果姑获鸟死亡，获得主谋能力的姑获鸟保留主谋的能力。");
    g_tipLine[10640] = StringToText("【提示与技巧】");
    g_tipLine[10641] = StringToText("· 主谋是一个即使在恶魔死后仍会延续恶魔的邪恶企划的爪牙，给邪恶阵营第二次胜利的机会。你玩的是终极的长线游戏，");
    g_tipLine[10642] = StringToText("  甚至连你自己的团队都努力活得更久……而从不宣布你的存在。");
    g_tipLine[10643] = StringToText("· 几乎不惜一切代价活下去——你的能力是邪恶阵营的后备计划和最后手段，如果你死了，它就不会激活。");
    g_tipLine[10644] = StringToText("  与你的恶魔协调以进行一次强有力的虚张声势并讨好善良阵营 - 对你来说，");
    g_tipLine[10645] = StringToText("  不在晚上行动的角色（所以你不会引起侍女的怀疑）以及善良团队想要的保护角色是一个好的选择，如和平主义者、");
    g_tipLine[10646] = StringToText("  茶艺师或吟游诗人。");
    g_tipLine[10647] = StringToText("· 作为主谋，时机就是一切。善良阵营知道你可能潜伏着，如果他们确信已经杀死了恶魔，他们所要做的就是不触发你的能力。");
    g_tipLine[10648] = StringToText("  为了智取他们，尽量在善良阵营不怀疑你在场的时候处决恶魔。一般来说，");
    g_tipLine[10649] = StringToText("  这意味着处决应该发生在游戏的早期（大多数恶魔会存活几天），或者如果他们认为他们正在处决的玩家不是恶魔。");
    g_tipLine[10650] = StringToText("  黯月初升是唯一一个可以让您的恶魔在第一天死亡的剧本，这大概率是一件好事！");
    g_tipLine[10651] = StringToText("· 鼓励你的小镇接受处决！虽然大多数善良阵营不需要任何额外的帮助就会不分青红皂白处决，");
    g_tipLine[10652] = StringToText("  但确保他们每天都积极地处决将使他们准备好在恶魔死去后继续保持处决习惯。毕竟你不希望他们害怕你的威胁！");
    g_tipLine[10653] = StringToText("  提醒他们处决会获得信息（测试水手或茶艺师的能力，寻找魔鬼代言人的存在），并且处决恶魔，");
    g_tipLine[10654] = StringToText("  善良阵营真的不能浪费任何机会以找到那些邪恶的玩家。这些都是实话，这让你看起来更加善良且值得信赖！");
    g_tipLine[10655] = StringToText("· 说服善良阵营是另一个爪牙在场。伪装成一个外来者来模拟教父的存在。将不寻常的死亡计数归咎于刺客的存在（而不是赌徒、");
    g_tipLine[10656] = StringToText("  造谣者或修补匠的能力）。如果一个玩家被处决但没有死？这肯定是魔鬼代言人在场的有力证据！");
    g_tipLine[10657] = StringToText("  如果善良阵营全心全意地相信他们知道哪些除你之外的爪牙在场，那么他们会更愿意进行最后的处决，");
    g_tipLine[10658] = StringToText("  特别是如果你已经使用其他一些技巧与你的恶魔协调好这次死亡！");
    g_tipLine[10659] = StringToText("· 通过说服恶魔（和其他爪牙）偶尔避免在夜间杀人，让善良阵营陷入虚假的安全感。一个晚上（或两个）没有杀戮，");
    g_tipLine[10660] = StringToText("  而善良阵营已经知道他们可以在这样的夜晚之后安全地处决，他们更有可能在没有杀戮的夜晚后处决，因为恶魔已经被处决。");
    g_tipLine[10661] = StringToText("· 如果恶魔死于处决，那就尽你所能在那天晚上让一个玩家死亡。告诉刺客使用他们的能力。说服赌徒猜你的角色。");
    g_tipLine[10662] = StringToText("  协助造谣者做出真实的陈述。请求说书人杀死修补匠。如果玩家认为晚上的死亡是由恶魔造成的，");
    g_tipLine[10663] = StringToText("  那么他们明天再次处决的可能性就会大大增加。");
    g_tipLine[10664] = StringToText("【对抗主谋】");
    g_tipLine[10665] = StringToText("当你要对抗主谋的时候，这里有几件事你应该记住：");
    g_tipLine[10666] = StringToText("· 在黯月初升中，所有其他爪牙都会给出暗示他们在场的证据。魔鬼代言人防止玩家因处决而死亡，刺客在夜间造成额外死亡，");
    g_tipLine[10667] = StringToText("  教父也是如此。如果你能看到这些线索，你就可以确定游戏中没有主谋。如果游戏中没有主谋，则在不确定玩家是好是坏时，");
    g_tipLine[10668] = StringToText("  您无需谨慎处决。");
    g_tipLine[10669] = StringToText("· 但是，如果您看不到魔鬼代言人、教父或刺客在场的证据，则您可能遇到一个主谋在策划一切，在这种情况下，");
    g_tipLine[10670] = StringToText("  通常最好假设他是存在的。");
    g_tipLine[10671] = StringToText("· 如果有一个夜晚没有人死亡，那么对第二天处决的人要非常谨慎。甚至可能根本不处决。只要在夜里有人死亡，");
    g_tipLine[10672] = StringToText("  恶魔还活着的可能性很大……但如果恶魔是僵怖，情况可能就不是这样了。但在大多数情况下，");
    g_tipLine[10673] = StringToText("  夜间死亡意味着您可以安全地在第二天进行处决，而夜间没有死亡意味着您应该怀疑您昨天处决的玩家实际上是恶魔的可能性。");
    g_tipLine[10674] = StringToText("· 如果死了，主谋就不能使用他的能力。尽可能多地处决玩家，希望能在恶魔之前杀死主谋。就像魔鬼代言人一样，");
    g_tipLine[10675] = StringToText("  主谋存活的时间越长，善良阵营的麻烦就越多，尽早杀死他。多去造成死亡，尽力找出哪些玩家可能是爪牙。最后，祝你好运。");
    g_tipRoleAt[42] = 10603; g_tipRoleN[42] = 73; g_tipP1At[42] = 10605; g_tipP1N[42] = 11; g_tipP2At[42] = 10630; g_tipP2N[42] = 10;
    g_tipAbility[42] = StringToText("如果恶魔因为死于处决而因此导致游戏结束时，再额外进行一个夜晚和一个白天。在那个白天如果有玩家被处决，他的阵营落败。");
    g_tipLine[10676] = StringToText("【背景故事】");
    g_tipLine[10677] = StringToText("「我不。明白。你的。方式。人类。同类。向我。指引。泥土。那是。圣地。静卧。安睡。我也。必须。长眠。立刻。」");
    g_tipLine[10678] = StringToText("【角色能力】");
    g_tipLine[10679] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。");
    g_tipLine[10680] = StringToText("当你首次死亡后，你仍存活，但会被当作死亡。");
    g_tipLine[10681] = StringToText("【角色简介】");
    g_tipLine[10682] = StringToText("僵怖能秘密地在墓地中保持存活。");
    g_tipLine[10683] = StringToText("· 当僵怖因任何原因死亡后，他会保持存活状态，但说书人会表现得如同僵怖死亡了一样。僵怖第二次死亡时，才会真正地死亡，");
    g_tipLine[10684] = StringToText("  且善良阵营获胜。");
    g_tipLine[10685] = StringToText("· 看似死亡的僵怖在绝大多数情况下都算作已死亡。该玩家在城镇广场的生命标记会翻面以标识死亡。下一次该玩家投票时，");
    g_tipLine[10686] = StringToText("  会失去投票标记。该玩家不能发起提名，该玩家可以在有巫毒师的情况下投票，该玩家不算作茶艺师的存活邻近玩家，等等。");
    g_tipLine[10687] = StringToText("  不同之处是游戏还会继续，僵怖仍然能发起攻击，且游戏会在只剩两名其他存活玩家的情况下继续进行。");
    g_tipLine[10688] = StringToText("· 如果无人在白天死亡，僵怖才会在夜晚被唤醒并发起攻击。如果一名已死亡的玩家被处决，该玩家无法再次死亡，");
    g_tipLine[10689] = StringToText("  因此僵怖仍然会被唤醒。");
    g_tipLine[10690] = StringToText("· 如果一个醉酒或中毒的僵怖死亡，善良阵营获胜。如果一个「死亡」的僵怖醉酒或中毒，不要宣布该玩家存活。");
    g_tipLine[10691] = StringToText("【范例】");
    g_tipLine[10692] = StringToText("僵怖被处决且看起来已经死亡。僵怖当晚不能发动攻击。数天后，城镇广场看起来只剩两名玩家存活。");
    g_tipLine[10693] = StringToText("  善良阵营相当确定僵怖就是已死亡玩家中的一名，并且游戏继续，直到再有一名玩家死亡。");
    g_tipLine[10694] = StringToText("今天白天无人死亡。当晚，僵怖发动攻击。在下一个白天，修补匠死亡。当晚，僵怖不会被唤醒。");
    g_tipLine[10695] = StringToText("【运作方式】");
    g_tipLine[10696] = StringToText("当僵怖首次死亡后，他依然存活。宣布僵怖已经死亡，但是不要在魔典中给僵怖添加帷幕标记。");
    g_tipLine[10697] = StringToText("  （如常将城镇广场上他的生命标记翻面。）从现在起，僵怖被当作已死亡。");
    g_tipLine[10698] = StringToText("每个白天，如果有玩家死亡，将「死于今日」提示标记放置到该玩家的角色标记旁。（如果僵怖因处决而「死亡」，");
    g_tipLine[10699] = StringToText("  会被当作已死亡，因此要给僵怖放置「死于今日」提示标记。）");
    g_tipLine[10700] = StringToText("除了首个夜晚以外的每个夜晚，如果有任何玩家标有「死于今日」，不要唤醒僵怖。");
    g_tipLine[10701] = StringToText("除了首个夜晚以外的每个夜晚，如果没有玩家标有「死于今日」，唤醒僵怖。让僵怖指向任意一名玩家。让僵怖重新入睡。");
    g_tipLine[10702] = StringToText("  所选玩家死亡——将「死亡」提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10703] = StringToText("【提示标记】");
    g_tipLine[10704] = StringToText("· 死于今日");
    g_tipLine[10705] = StringToText("放置时机：在白天时，如果有玩家死亡（包括僵怖在内），不论死亡原因为何，在该玩家的角色标记旁放置。");
    g_tipLine[10706] = StringToText("放置条件：在死亡的玩家角色标记旁放置，而不论此时僵怖是否醉酒中毒。如果一天有多名玩家死亡，");
    g_tipLine[10707] = StringToText("  也只会有一个「死于今日」标记被放置。该标记会用于提醒说书人夜晚是否会唤醒僵怖。");
    g_tipLine[10708] = StringToText("移除时机：在轮到僵怖的夜晚行动顺序结束后，说书人可以任由自己方便来进行移除，或者在黎明时移除。");
    g_tipLine[10709] = StringToText("特殊说明：由于僵怖的能力为回溯型能力，因此如果僵怖在游戏中途产生，仍然要根据当前情况补放标记，");
    g_tipLine[10710] = StringToText("  而不是因为没有放置标记便在夜晚唤醒僵怖。");
    g_tipLine[10711] = StringToText("· 死亡");
    g_tipLine[10712] = StringToText("放置时机：在僵怖夜晚行动并选择了玩家后放置。");
    g_tipLine[10713] = StringToText("放置条件：僵怖选择的玩家当前存活，且能被僵怖杀死，且僵怖未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[10714] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[10715] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10716] = StringToText("【规则细节】");
    g_tipLine[10717] = StringToText("· 相克规则：");
    g_tipLine[10718] = StringToText("  · 召唤师：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_tipLine[10719] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[10720] = StringToText("  · 戏子：在戏子存在于剧本中时，僵怖可以在游戏中任意时候向说书人示意自己「想要死亡」。无论僵怖是否触发过「假死」，");
    g_tipLine[10721] = StringToText("    当晚僵怖会变为死亡状态。");
    g_tipLine[10722] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，僵怖可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[10723] = StringToText("    无论僵怖是否触发过「假死」，当晚僵怖会变为死亡状态。");
    g_tipLine[10724] = StringToText("【提示与技巧】");
    g_tipLine[10725] = StringToText("· 邪恶的僵怖因其隐匿性和生存能力而成为黯月初升中最致命的恶魔。沙巴洛斯和珀可能会杀死许多人，");
    g_tipLine[10726] = StringToText("  而普卡可能会让你被毒药侵扰，但当小镇确定它们在场时，它们都脆弱得令人失望。");
    g_tipLine[10727] = StringToText("  但对你来说不是这样——你很难被找到也更难被杀死，你的耐心是恐怖的；你会满足于躺在死者中间，");
    g_tipLine[10728] = StringToText("  静静地听着小镇分崩离析，在活人中寻找恶魔，从没想过墓地里的一具腐烂的尸体还在呼吸。");
    g_tipLine[10729] = StringToText("  善良阵营应该祈祷你不是他们所面对的恶魔，因为那样的话没有玩家是安全的；死者和生者都同样令人恐惧。");
    g_tipLine[10730] = StringToText("· 你只有在白天没有人死亡时才有晚上杀人的能力。这可能很困难，因为即使玩家被提名，处决他们的大多数人仍然是善良玩家，");
    g_tipLine[10731] = StringToText("  这意味着当你急需他们死亡时，麻烦的驱魔人或侍臣可能仍然活着。解决这个麻烦的一种方法是大声引导不执行任何处决，");
    g_tipLine[10732] = StringToText("  但如果您过于频繁地这样做，善良阵营可能会发现这很可疑并开始质疑您的角色。");
    g_tipLine[10733] = StringToText("  更合理的策略是鼓励处决您认为不会导致死亡的处决——例如，清醒的水手或茶艺师的邻居. 这提供了善良阵营清楚的信息，");
    g_tipLine[10734] = StringToText("  但也将给予你宝贵的杀戮......无论如何，只要修补匠不会在白天死去。你也可以（可能只有一次）");
    g_tipLine[10735] = StringToText("  引导主谋在场的言论，利用善良阵营对是否杀死恶魔的怀疑，让他们推迟一晚，而不是冒着输掉比赛的风险。");
    g_tipLine[10736] = StringToText("· 杀死自己，然后像死去的玩家一样躲在众人的视线中！如果善良玩家认为另一个恶魔在场，这可能特别有效，");
    g_tipLine[10737] = StringToText("  因为他们不会将死者视为嫌疑人而将注意力集中在生者身上。即使他们确实怀疑你，");
    g_tipLine[10738] = StringToText("  选择在正确的时间死去也可以让他们减少对你的怀疑——例如，让自己早日被处决以「测试」你的水手不死能力，");
    g_tipLine[10739] = StringToText("  并将你的死归咎于普卡。或者更简单地说，你可以选择自己并在晚上死去——在晚上死去的玩家往往是善良的并且被认为是值得");
    g_tipLine[10740] = StringToText("  信赖的。最后，你可以配合你的教父在适当的时候送你出去，让大家看起来好像没有僵怖在游戏中，你是游戏的无辜受害者。");
    g_tipLine[10741] = StringToText("  然后，您可以利用您的死亡作为传播错误信息的平台并迷惑优秀团队......或者只是坐下来观看比赛的展开。");
    g_tipLine[10742] = StringToText("· 与其过早死去，不如决定做一个老练的生存者，活在人间，活得越久越好！以这种方式生存有几个优势——其中之一，");
    g_tipLine[10743] = StringToText("  你可以不断地虚张声势并提供新信息，从而误导善良阵营。你可以保证至少在死亡中幸存一次，所以你有一个plan b，");
    g_tipLine[10744] = StringToText("  以防万一大家怀疑你。最后，如果善良阵营开始怀疑你是游戏中的恶魔，你可以将他们的怀疑引向其他死者——如果他们对其他");
    g_tipLine[10745] = StringToText("  人执行一两次死刑，那你就可以逃过一两次死刑！");
    g_tipLine[10746] = StringToText("【对抗僵怖】");
    g_tipLine[10747] = StringToText("当你要对抗僵怖的时候，这里有几件事你应该记住：");
    g_tipLine[10748] = StringToText("· 注意死亡发生的时间和原因。如果晚上有人死亡，但不是在玩家被处决后死亡，那么几乎可以肯定你中间有一个僵怖。");
    g_tipLine[10749] = StringToText("  一旦你知道了这一点，你可以执行以下操作...");
    g_tipLine[10750] = StringToText("· 怀疑死者。处决你最怀疑的死者。与死者交谈，找出谁的话最没有意义，并专注于那些玩家。你不确定僵怖是死玩家之一，");
    g_tipLine[10751] = StringToText("  但这是一个很好的起点。如果你能尽早确认某些死去的玩家不是僵怖，那么你将在游戏后期获得优势。");
    g_tipLine[10752] = StringToText("· 每天处决。即使你杀死了善良玩家，至少这也比不处决任何人并让恶魔选择谁死要好。");
    g_tipLine[10753] = StringToText("· 在最后一天，僵怖出现在生者中的可能性很小。至此，大多数僵怖会在晚上自杀，或者只是运气不好被处决。");
    g_tipLine[10754] = StringToText("  由于僵怖的杀戮频率远低于其他恶魔，因此在最后一天黎明时它已经死亡的可能性很高。如果您没有其他信息，");
    g_tipLine[10755] = StringToText("  请确保游戏的最终处决是对死玩家的处决。");
    g_tipRoleAt[43] = 10676; g_tipRoleN[43] = 80; g_tipP1At[43] = 10678; g_tipP1N[43] = 13; g_tipP2At[43] = 10716; g_tipP2N[43] = 8;
    g_tipAbility[43] = StringToText("每个夜晚*，如果今天白天没有人死亡，你会被唤醒并要选择一名玩家：他死亡。当你首次死亡后，你仍存活，但会被当作死亡。");
    g_tipLine[10756] = StringToText("【背景故事】");
    g_tipLine[10757] = StringToText("「您人真好，发生了这样的事情，您还愿意让我来您金碧辉煌的家里做客。我很抱歉，刚才不小心划伤了您。这是一点点赔礼，");
    g_tipLine[10758] = StringToText("  没事的，请收下吧，把这根金牙签当做我那卑微的歉意吧。」");
    g_tipLine[10759] = StringToText("【角色能力】");
    g_tipLine[10760] = StringToText("每个夜晚，你要选择一名玩家：他中毒。");
    g_tipLine[10761] = StringToText("上个因你的能力中毒的玩家会死亡并恢复健康。");
    g_tipLine[10762] = StringToText("【角色简介】");
    g_tipLine[10763] = StringToText("普卡能让他的受害者中毒，并在之后毒发身亡。");
    g_tipLine[10764] = StringToText("· 当普卡攻击时，他的受害者会立即中毒。在下一个夜晚，该名玩家会在普卡发起下一次攻击之后的时间点死亡。");
    g_tipLine[10765] = StringToText("· 不同于其他恶魔，普卡在首个夜晚就会行动。");
    g_tipLine[10766] = StringToText("· 驱魔人能防止普卡被唤醒来使玩家中毒。旅店老板能防止普卡杀死已经中毒的玩家，随后该玩家会恢复健康。");
    g_tipLine[10767] = StringToText("· 如果醉酒状态的普卡选择了一名玩家，该玩家不会中毒，也不会在下一个夜晚死亡。");
    g_tipLine[10768] = StringToText("· 如果普卡在上一个夜晚选择玩家时是清醒的，但是当晚醉酒了，该玩家不会死亡。但是当普卡恢复清醒，中毒效果会恢复，");
    g_tipLine[10769] = StringToText("  且会在随后的夜晚杀死该玩家。");
    g_tipLine[10770] = StringToText("【范例】");
    g_tipLine[10771] = StringToText("普卡使侍女中毒。侍女得到错误信息。下一夜，侍女死亡。");
    g_tipLine[10772] = StringToText("普卡使弄臣中毒。在下个白天，弄臣被处决且死亡，因为他没有能力。在下个夜晚，无人死亡，且普卡使造谣者中毒。");
    g_tipLine[10773] = StringToText("  再下个夜晚，醉酒状态的普卡试图使修补匠中毒，但没有成功。再下个夜晚，恢复清醒的普卡让造谣者死亡。");
    g_tipLine[10774] = StringToText("（因为普卡的致死能力只看他上一个成功中毒的角色，因此会跳过修补匠。在普卡醉酒期间，虽然造谣者不再中毒，");
    g_tipLine[10775] = StringToText("  但不会因此移除造谣者的中毒标记，并在普卡恢复清醒的时候立刻让原本选择的造谣者重新中毒。因此轮到普卡行动时，");
    g_tipLine[10776] = StringToText("  造谣者就会死亡。）");
    g_tipLine[10777] = StringToText("普卡使和平主义者中毒。在下一个夜晚，驱魔人选择了普卡，阻止了他当晚被唤醒。和平主义者死亡，");
    g_tipLine[10778] = StringToText("  但是普卡当晚没有被唤醒以发起攻击。");
    g_tipLine[10779] = StringToText("月之子被处决并死亡，并选择了侍臣。当晚，普卡选择了月之子。侍臣没有死亡，因为已死亡的月之子中毒了。");
    g_tipLine[10780] = StringToText("【运作方式】");
    g_tipLine[10781] = StringToText("每个夜晚，唤醒普卡。让普卡指向任意一名玩家。让普卡重新入睡。所选玩家中毒——将「中毒」");
    g_tipLine[10782] = StringToText("  提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10783] = StringToText("除了首个夜晚以外的每个夜晚，其他标有普卡的「中毒」提示标记的玩家死亡——将「死亡」");
    g_tipLine[10784] = StringToText("  提示标记放置到这些玩家的角色标记旁，然后移除他们的「中毒」提示标记。");
    g_tipLine[10785] = StringToText("被普卡杀死的玩家在死亡时仍然中毒。如果有来自其他剧本的角色，你可能需要将「中毒」标记保留在「死亡」标记旁，");
    g_tipLine[10786] = StringToText("  直到这些角色的死亡能力结算完毕。例如，如果普卡杀死了贤者，贤者可能会因为中毒效果而获得错误信息。");
    g_tipLine[10787] = StringToText("【提示标记】");
    g_tipLine[10788] = StringToText("· 中毒");
    g_tipLine[10789] = StringToText("放置时机：在普卡夜晚行动并选择了玩家后放置。");
    g_tipLine[10790] = StringToText("放置条件：普卡选择的玩家能因普卡而中毒，且普卡未醉酒中毒，那么在该玩家的角色标记旁放置普卡的中毒标记。");
    g_tipLine[10791] = StringToText("移除时机：当普卡的能力满足让被中毒标记的角色死亡时，在结算完该角色的「死亡触发能力」后移除，");
    g_tipLine[10792] = StringToText("  或普卡死亡或离场时移除。");
    g_tipLine[10793] = StringToText("· 死亡");
    g_tipLine[10794] = StringToText("放置时机：在普卡夜晚行动（并可能会放置「中毒」标记）结束时，放置此标记。");
    g_tipLine[10795] = StringToText("放置条件：普卡未醉酒中毒时，不论普卡此次夜晚行动是否被唤醒或成功放置标记，进行以下操作：");
    g_tipLine[10796] = StringToText("  检查在本次普卡夜晚行动之前，已放置有普卡的「中毒」标记的玩家（其他角色的中毒标记不会检查）。");
    g_tipLine[10797] = StringToText("  若该玩家已死亡或无法被普卡杀死，直接移除「中毒」标记。否则，在该玩家的角色标记旁放置「死亡」标记，");
    g_tipLine[10798] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。如果普卡已醉酒中毒，跳过此操作，且不会移除原本放置的中毒标记。");
    g_tipLine[10799] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10800] = StringToText("【规则细节】");
    g_tipLine[10801] = StringToText("· 相克规则：");
    g_tipLine[10802] = StringToText("  · 召唤师：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_tipLine[10803] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[10804] = StringToText("  · 戏子：在戏子存在于剧本中时，普卡可以在游戏中任意时候向说书人示意自己「想要死亡」。说书人会在当晚杀死这名玩家。");
    g_tipLine[10805] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，普卡可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[10806] = StringToText("    说书人会在当晚杀死这名玩家。");
    g_tipLine[10807] = StringToText("【提示与技巧】");
    g_tipLine[10808] = StringToText("· 狡猾的普卡因其恶毒和残忍而成为黯月初升中最致命的恶魔。所有其他恶魔都给小镇一个晚上的礼遇；普卡没有这样的耐心，");
    g_tipLine[10809] = StringToText("  从第一天晚上开始就在镇上播下混乱，在镇民甚至有机会采取行动之前就选择了他们的第一个受害者。僵怖可能比你更强壮，");
    g_tipLine[10810] = StringToText("  沙巴洛斯和珀可能会更有效地杀人，但他们很容易受到优秀团队使用的最致命武器的攻击：信息。你不仅杀死了你的受害者，");
    g_tipLine[10811] = StringToText("  而且还压制了你的受害者，迫使他们在精神错乱中度过最后的日子，他们的信息混乱，他们曾经构成的危险也化为乌有。");
    g_tipLine[10812] = StringToText("  优秀的团队总是希望你不在比赛中，以免他们不得不在整场比赛中怀疑所有通常会将他们引导到你家门口的信息。");
    g_tipLine[10813] = StringToText("· 考虑你想毒死谁以及想杀谁。一个咄咄逼人、健谈的侍女没有意识到他们最后一天的信息是错误的，");
    g_tipLine[10814] = StringToText("  可以在坟墓之外为你做很多工作。如果你非常幸运，你可以在他们抓住你之前抓住一个驱魔人或侍臣，");
    g_tipLine[10815] = StringToText("  或者你可以让一个旅店老板的顾客暴露给你的教父或月之子诅咒，时机稍好。");
    g_tipLine[10816] = StringToText("  你是黯月初升中唯一有能力混淆目标信息的邪恶玩家，那么为什么不充分利用呢？");
    g_tipLine[10817] = StringToText("· 瞄准你认为不会在第二天被处决的玩家。如果善良阵营处决了你中毒的受害者，");
    g_tipLine[10818] = StringToText("  那么那天晚上你就不会造成死亡……狡猾的优秀玩家可能会用它来检测你在比赛中。");
    g_tipLine[10819] = StringToText("  一个不合时宜的执行会让你争先恐后地赶上比赛的其余部分！");
    g_tipLine[10820] = StringToText("· 瞄准那些被善良阵营怀疑的声称自己对（死于）处决免疫的玩家，例如水手或茶艺师和她的邻座。");
    g_tipLine[10821] = StringToText("  即使在下个夜晚没有发生死亡，也会让人觉得他们假装使用了魔鬼代言人的能力，甚至可以引导善良阵营实际上他们是僵怖。");
    g_tipLine[10822] = StringToText("  （善良阵营处决死亡玩家的任意一天对于你而言都非常有利）");
    g_tipLine[10823] = StringToText("· 你的毒只能被狡猾的莽夫阻止，但角色仍然可以在晚上被茶艺师或旅店老板等角色保护免于死亡。您无需害怕弄臣或水手，");
    g_tipLine[10824] = StringToText("  但仍需谨慎选择 - 错过一次杀戮不会有任何影响，尤其是在您与沙巴洛斯或珀竞争的情况下。");
    g_tipLine[10825] = StringToText("  可靠和有条不紊应该是你的目标。");
    g_tipLine[10826] = StringToText("· 尽量掩饰普卡存在的事实。一旦善良阵营知道你在场，他们就可以开始回溯你的有毒信息，取消你所有的辛勤工作！");
    g_tipLine[10827] = StringToText("  虽然看起来声称僵怖在场似乎是显而易见的选择，但实际上在刺客或教父的帮助下模仿珀甚至沙巴洛斯更容易……或者只是伪装");
    g_tipLine[10828] = StringToText("  成一些勇于冒险的镇民。例如，如果你知道造谣者声明将在当晚造成死亡，那或许就是让你的爪牙采取行动的时候，");
    g_tipLine[10829] = StringToText("  创造一个模拟珀蓄力后的爆发杀戮。虽然他们最终可能会找到你，但等到他们这么做的时候......已经阻止不了你了。");
    g_tipLine[10830] = StringToText("【对抗普卡】");
    g_tipLine[10831] = StringToText("当你要对抗普卡的时候，这里有几件事你应该记住：");
    g_tipLine[10832] = StringToText("· 与普卡战斗的第一步是弄清楚普卡是否在起作用。寻找夜间的可疑死亡，例如「弄臣」过早死亡，或「水手」完全死亡。或者，");
    g_tipLine[10833] = StringToText("  考虑到当没有人在夜间死亡时，那是因为那天被处决的普卡目标。如果围绕这两个信号形成模式，");
    g_tipLine[10834] = StringToText("  您几乎可以肯定在游戏中有普卡。");
    g_tipLine[10835] = StringToText("· 一旦您发现普卡正在发挥作用，您就需要进行一些信息回溯。每个昨晚死去的玩家，都是在前一天晚上被毒死的。");
    g_tipLine[10836] = StringToText("  死亡的茶艺师的能力在活着的时候不起作用是有原因的。赌徒的死亡有一个理由，");
    g_tipLine[10837] = StringToText("  那就是他们在前一天晚上选择一名玩家时没有死。死亡的侍女在前天晚上得到了虚假信息。");
    g_tipLine[10838] = StringToText("  死亡的驱魔人可能实际上是在玩家死亡的夜晚选择了恶魔。回溯可能很复杂，");
    g_tipLine[10839] = StringToText("  因为前天晚上发生的事情比昨晚发生的事情更难记住，但如果你能做到的话，这将提供大量信息。");
    g_tipLine[10840] = StringToText("· 如果普卡在比赛中，没有人是安全的。弄臣和水手无法被他们的角色能力等保护。另外，");
    g_tipLine[10841] = StringToText("  由于普卡比平时提前一整晚选择杀死谁，所以有利于所有善良玩家尽快向所有人公开他们的角色和信息，尽可能。有时，");
    g_tipLine[10842] = StringToText("  一些善良玩家与其他恶魔一起，不透露他们是谁可能是有益的，这样恶魔会攻击某些玩家而让其他人独自一人 - 但对于普卡");
    g_tipLine[10843] = StringToText("  ，情况并非如此。表明一切，并作为善良阵营将那个讨厌的投毒者绳之以法！");
    g_tipLine[10844] = StringToText("· 如果您不知道哪些玩家是邪恶的，请处决您认为中毒的玩家。在所有条件相同的情况下，最好处决一个被普卡毒化的好玩家，");
    g_tipLine[10845] = StringToText("  而不是一个没有中毒的善良玩家，因为当你处决一个普卡的受害者时，当晚会没有人死于恶魔。显然，最好处决邪恶玩家，");
    g_tipLine[10846] = StringToText("  但如果你不知道谁是好人或谁是邪恶的，那么在投票处决似乎中毒的玩家方面会犯错。");
    g_tipRoleAt[44] = 10756; g_tipRoleN[44] = 91; g_tipP1At[44] = 10759; g_tipP1N[44] = 11; g_tipP2At[44] = 10800; g_tipP2N[44] = 7;
    g_tipAbility[44] = StringToText("每个夜晚，你要选择一名玩家：他中毒。上个因你的能力中毒的玩家会死亡并恢复健康。");
    g_tipLine[10847] = StringToText("【背景故事】");
    g_tipLine[10848] = StringToText("「布嘞啦嘎，福塔啊啊嘎，呐姆姆啊塔噶！呐什，噶姆塔姆什，呐哟咯咯发咯咯咯咯咯咯嘎，哈什嗝呵！」");
    g_tipLine[10849] = StringToText("【角色能力】");
    g_tipLine[10850] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。");
    g_tipLine[10851] = StringToText("你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipLine[10852] = StringToText("【角色简介】");
    g_tipLine[10853] = StringToText("沙巴洛斯每个夜晚能够吞食两名玩家，但是可能会在下一个夜晚将其中一名吐出来。");
    g_tipLine[10854] = StringToText("· 不同于其他恶魔，沙巴洛斯每个夜晚会攻击两次。在攻击后的下一个夜晚，");
    g_tipLine[10855] = StringToText("  说书人可以决定让沙巴洛斯攻击过的两名玩家其中之一重获新生。");
    g_tipLine[10856] = StringToText("· 被复活的玩家可以是在存活状态下被沙巴洛斯攻击的玩家，也可以是在死亡状态下被沙巴洛斯攻击的玩家。");
    g_tipLine[10857] = StringToText("· 因反刍而复活的玩家重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的能力也会重新获得。");
    g_tipLine[10858] = StringToText("  如果有「在你的首个夜晚」的能力，玩家可以再次使用该能力。");
    g_tipLine[10859] = StringToText("【范例】");
    g_tipLine[10860] = StringToText("沙巴洛斯攻击了造谣者，然后是赌徒。造谣者死亡，但是赌徒由于受到旅店老板的保护，依然存活。");
    g_tipLine[10861] = StringToText("沙巴洛斯攻击了存活的侍臣和已死亡的驱魔人。侍臣死亡。在下一个夜晚，说书人决定让驱魔人复活。");
    g_tipLine[10862] = StringToText("  驱魔人当晚不会行动——因为正常情况下驱魔人在沙巴洛斯之前行动。");
    g_tipLine[10863] = StringToText("沙巴洛斯攻击了茶艺师的邻近玩家，然后是茶艺师。茶艺师的邻近玩家受到茶艺师的保护，没有死亡，");
    g_tipLine[10864] = StringToText("  但是紧接着茶艺师死亡了。");
    g_tipLine[10865] = StringToText("【运作方式】");
    g_tipLine[10866] = StringToText("除了首个夜晚以外的每个夜晚，唤醒沙巴洛斯。让沙巴洛斯依次指向任意两名玩家，每次一名。让沙巴洛斯重新入睡。");
    g_tipLine[10867] = StringToText("  按照选择的顺序，每名所选玩家依次死亡——将「死亡」提示标记放置到这些玩家的角色标记旁。");
    g_tipLine[10868] = StringToText("之后的每个夜晚，在唤醒沙巴洛斯前，你可以选择一个标有沙巴洛斯的「死亡」标记的角色，");
    g_tipLine[10869] = StringToText("  该角色再次变成存活——将「死亡」标记替换成沙巴洛斯的「复活」标记，并移除其帷幕标记。");
    g_tipLine[10870] = StringToText("  如果正常情况下该玩家会被唤醒，则在当晚的后续时段中照常唤醒。如果该玩家只在首个夜晚被唤醒，");
    g_tipLine[10871] = StringToText("  则现在就唤醒该玩家让他使用自己的能力。黎明时，在宣布哪些玩家死亡后，宣布哪些玩家复活了。（不要说明原因。）");
    g_tipLine[10872] = StringToText("因为沙巴洛斯不能反刍自己——角色在死亡时没有能力——最好只是让沙巴洛斯偶尔进行反刍。每局游戏一次，或者两次，");
    g_tipLine[10873] = StringToText("  通常已经足够了。");
    g_tipLine[10874] = StringToText("【提示标记】");
    g_tipLine[10875] = StringToText("· 死亡");
    g_tipLine[10876] = StringToText("放置时机：在沙巴洛斯夜晚行动并选择了玩家后放置。");
    g_tipLine[10877] = StringToText("放置条件：沙巴洛斯选择的玩家当前存活，且能被他杀死，且沙巴洛斯未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[10878] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。如果上述情况不满足，仍然需要放置该标记，但将该标记倒转放置，");
    g_tipLine[10879] = StringToText("  代表该提示标记没有任何效果，仅用于标记该玩家被沙巴洛斯选择过。（因为沙巴洛斯的能力是回溯型能力，");
    g_tipLine[10880] = StringToText("  需要判断上一个夜晚选择的玩家，而不判断该玩家是否由于受到了沙巴洛斯的攻击而导致死亡）");
    g_tipLine[10881] = StringToText("移除时机：在下一个夜晚，轮到沙巴洛斯夜晚行动，说书人将其唤醒之前（用于处理沙巴洛斯的反刍结算，并在结算后移除）。");
    g_tipLine[10882] = StringToText("  或沙巴洛斯死亡或离场时移除。");
    g_tipLine[10883] = StringToText("· 复活");
    g_tipLine[10884] = StringToText("放置时机：在轮到沙巴洛斯夜晚行动，说书人将其唤醒之前。");
    g_tipLine[10885] = StringToText("放置条件：由说书人决定，当前已经放置有沙巴洛斯的「死亡」标记（不论正常放置还是倒转放置），");
    g_tipLine[10886] = StringToText("  且已经死亡的玩家之一是否复活。如果沙巴洛斯当前醉酒中毒，无人复活，跳过此标记的放置步骤。");
    g_tipLine[10887] = StringToText("  如果说书人决定让满足上述条件的玩家之一复活，则在该玩家的角色标记旁放置，");
    g_tipLine[10888] = StringToText("  用以提醒说书人在黎明时分宣布当晚的复活玩家。");
    g_tipLine[10889] = StringToText("移除时机：在黎明时宣布复活玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10890] = StringToText("【规则细节】");
    g_tipLine[10891] = StringToText("· 关于沙巴洛斯造成的反刍所带来的首夜能力使用时机的疑问：在这三个官方剧本中，");
    g_tipLine[10892] = StringToText("  角色详解通常只用于解决剧本内的一些互动方式，如果将角色互动拉到全角色和混合剧本的维度，则需要使用到统一的规则。");
    g_tipLine[10893] = StringToText("  在黯月初升中，因为只会至多有一名恶魔在场，并且爪牙发起攻击的情形不太常见，所以在大部分情况下，");
    g_tipLine[10894] = StringToText("  你可以让反刍的角色在沙巴洛斯的行动结束后立即行动。然而如果是混合剧本，则需要综合考虑，选择更准确的，");
    g_tipLine[10895] = StringToText("  不会出错的处理方式进行游戏的主持。");
    g_tipLine[10896] = StringToText("【提示与技巧】");
    g_tipLine[10897] = StringToText("· 强大的沙巴洛斯因其残暴和持续性而成为黯月初升中最致命的恶魔。普卡或僵怖都无法单独在一个晚上与您的多次击杀的速度相");
    g_tipLine[10898] = StringToText("  匹敌，虽然珀可以在一个晚上将三名玩家淘汰出局，但由于他们需要休息，所以您依然是当之无愧的王。");
    g_tipLine[10899] = StringToText("  当他们怀疑你在游戏中时，善良阵营应该感到恐慌；只有被你吞噬的人意外复活时他们才会有机会对你发起反击！");
    g_tipLine[10900] = StringToText("· 积极的杀戮，不要给善良阵营喘口气的机会。公平地说，你不是最……巧妙的恶魔，因为你没有伪装的机会。");
    g_tipLine[10901] = StringToText("  在美好的一天像哥斯拉一样在城镇中闯荡，吞噬任何阻止你伪装角色的人。如果你吃了它们，");
    g_tipLine[10902] = StringToText("  侍女不会发现你的虚张声势是假的。做一些聪明的选择，并密切关注哪些玩家在夜间受到保护，");
    g_tipLine[10903] = StringToText("  您可以用其他恶魔双倍效率结束这场比赛。");
    g_tipLine[10904] = StringToText("· 或者，您可能想更低调的玩游戏。虽然你是一个可怕的、永远在饥饿的怪物，但这并不意味着你没有一点施展策略的机会。");
    g_tipLine[10905] = StringToText("  故意选择隐藏你的第二次杀戮可能会造成关于其他恶魔在场的混乱假象 - 如果他们无法确定是哪个恶魔在场，");
    g_tipLine[10906] = StringToText("  那么善良阵营总是会多疑，因为珀可以通过休息来放松片刻。这对你很有帮助，");
    g_tipLine[10907] = StringToText("  因为对付其他恶魔的策略与对付你的策略大不相同，一旦你开始爆发杀戮的本性，可怜的善良阵营就会措手不及！");
    g_tipLine[10908] = StringToText("  它还可以帮助您躲避侍臣的三天痛饮（谁会留意任何关于恶魔是什么角色的相关消息）");
    g_tipLine[10909] = StringToText("  ......直到你能找到它们并吃掉它们，无论如何。");
    g_tipLine[10910] = StringToText("· 卑鄙的小镇处决了你的爪牙吗？只是为了处决一个想要吞噬他们所有人的饥饿恶魔吗？多么残忍！多么不公平！");
    g_tipLine[10911] = StringToText("  对他们来说幸运的是，你是你同类中独一无二的恶魔，因为你的唾液具有治疗作用。晚上吃掉你的爪牙的尸体，");
    g_tipLine[10912] = StringToText("  试着让它们起死回生。这会说书人的心血来潮……但也许他们会同情你，把你心爱的爪牙还给你，");
    g_tipLine[10913] = StringToText("  尤其是当邪恶阵营正在苦苦挣扎的时候。这还有一个额外的好处，就是让你的爪牙看起来像个善良角色，");
    g_tipLine[10914] = StringToText("  因为通常你只会反刍善良玩家。");
    g_tipLine[10915] = StringToText("· 有时你的反刍会对你不利（或者说书人会认为你做得太好了），你会吐出一个善良玩家，让他们出乎意料地恢复生命。");
    g_tipLine[10916] = StringToText("  这可能会给你带来许多问题——比如，除非你声称自己是很难被信任的教授，否则这将证实你在游戏中，");
    g_tipLine[10917] = StringToText("  这可能是一个取决于你游戏策略的问题。更糟糕的是，重生的玩家很可能被认为是善良的，其他玩家会毫无疑问地信任他们。");
    g_tipLine[10918] = StringToText("  对付这种情况的最好方法几乎就是立即再次杀死他们，最好是在他们有机会利用他们的能力得到任何新信息之前。");
    g_tipLine[10919] = StringToText("· 虚张声势，尽你所能传播虚假信息。沙巴洛斯可能很快就会变得很明显在场，");
    g_tipLine[10920] = StringToText("  僵怖或普卡能通过他们的角色能力破坏善良阵营的信息，但你没有这样的奢侈待遇。");
    g_tipLine[10921] = StringToText("· 如果善良阵营不知道你在游戏中，你可以通过说服他们在只有4名玩家存活时不要处决，");
    g_tipLine[10922] = StringToText("  然后在当晚杀死2名玩家并将活着的玩家数量意外减少到2人来获胜. 如果你有一个没用过能力且还活着的刺客小弟，");
    g_tipLine[10923] = StringToText("  或者当晚可以说服愚蠢的造谣者或赌徒使用能力，你甚至可以在有5或6名玩家还活着的情况下取得意外的胜利.");
    g_tipLine[10924] = StringToText("【对抗沙巴洛斯】");
    g_tipLine[10925] = StringToText("当你要对抗沙巴洛斯的时候，这里有几件事你应该记住：");
    g_tipLine[10926] = StringToText("· 沙巴洛斯往往是一个明显的恶魔。当他们每晚杀戮两次时，您可以相当快地了解到哪个恶魔在游戏中。然而，");
    g_tipLine[10927] = StringToText("  由于沙巴洛斯的杀伤力是普通恶魔的两倍，所以游戏很快就进入了最后一天。一旦你确定了沙巴洛斯在游戏中，");
    g_tipLine[10928] = StringToText("  将注意力转向找出它是哪个玩家。像侍臣、驱魔人、侍女这样的角色可以直接帮助你做到这一点，这可能比一般通过像弄臣、");
    g_tipLine[10929] = StringToText("  茶艺师、和平主义者和赌徒这样的角色能力来判断谁是邪恶玩家的策略更有效.");
    g_tipLine[10930] = StringToText("· 如果一名玩家被反刍，这是个好消息。反刍的玩家必不会是沙巴洛斯，通常还是个好人。有时爪牙会被反刍，但确实很少。");
    g_tipLine[10931] = StringToText("  因此，让反刍的玩家活着通常是个好主意，不要处决他们，并相信他们就是他们所说的那个人。");
    g_tipLine[10932] = StringToText("· 在暗流涌动和梦殒春宵中，当只剩下4名玩家时，善良阵营可能不会发起处决。由于恶魔只能杀死一名玩家，");
    g_tipLine[10933] = StringToText("  因此第二天仍会有3名玩家活着。然而，在黯月初升中，情况并非如此，因为夜间可能会发生额外的死亡。");
    g_tipLine[10934] = StringToText("  如果一个沙巴洛斯在场，并且有4个（甚至5个，如果像刺客或赌徒这样的角色还活着）玩家还活着并且今天没有人被处决，");
    g_tipLine[10935] = StringToText("  那么今晚邪恶就可以获胜。当一个沙巴洛斯在场时，你会想要每天处决玩家，尤其是当4或5个玩家还活着的时候。");
    g_tipRoleAt[45] = 10847; g_tipRoleN[45] = 89; g_tipP1At[45] = 10849; g_tipP1N[45] = 10; g_tipP2At[45] = 10890; g_tipP2N[45] = 6;
    g_tipAbility[45] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipLine[10936] = StringToText("【背景故事】");
    g_tipLine[10937] = StringToText("「我给你一朵花，陪陪我好不好……」");
    g_tipLine[10938] = StringToText("【角色能力】");
    g_tipLine[10939] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。");
    g_tipLine[10940] = StringToText("如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipLine[10941] = StringToText("【角色简介】");
    g_tipLine[10942] = StringToText("珀能选择在夜晚不发起攻击，但会在下一夜疯狂杀戮。");
    g_tipLine[10943] = StringToText("· 如同其他的恶魔，珀可以在每晚攻击一名玩家。然而，如果珀不选择任何人，那么在下个夜晚珀可以攻击三名玩家。");
    g_tipLine[10944] = StringToText("· 如果珀在上一个夜晚不选择任何人时处于醉酒或中毒，当晚珀仍然能够选择三名玩家。");
    g_tipLine[10945] = StringToText("· 当要求珀选择三名玩家时，他必须要选择。珀不能再次不选择任何人。");
    g_tipLine[10946] = StringToText("· 只有当珀不选择任何人，才能得到三次攻击的机会。如果珀在上一次进行选择时攻击了某人但该玩家没有死亡，");
    g_tipLine[10947] = StringToText("  珀也不会获得三次攻击的机会。");
    g_tipLine[10948] = StringToText("· 珀在首个夜晚不行动，但这不算作珀「没有选择」。");
    g_tipLine[10949] = StringToText("· 如果驱魔人选择了珀，珀不会行动，但是这并不算作珀「没有选择任何人」。然而，");
    g_tipLine[10950] = StringToText("  如果珀在驱魔人选择他的前一夜就没有选择任何人，那么在驱魔人选择珀的下一夜，珀能够选择三名玩家，");
    g_tipLine[10951] = StringToText("  因为珀在上一次选择时没有选择任何人。");
    g_tipLine[10952] = StringToText("【范例】");
    g_tipLine[10953] = StringToText("在第二个夜晚，珀攻击了一名玩家。在第三个夜晚，珀选择不攻击任何人。在第四个夜晚，珀攻击了三名玩家。");
    g_tipLine[10954] = StringToText("珀选择不攻击任何人，但是醉酒了。在下一个夜晚，珀中毒了。珀选择了三名玩家，但是这些玩家都没有死亡。再下一个夜晚，");
    g_tipLine[10955] = StringToText("  珀恢复清醒和健康并攻击了一名玩家，该玩家死亡。");
    g_tipLine[10956] = StringToText("珀攻击了月之子，然后是莽夫，最后是祖母。只有月之子死亡，因为珀在攻击莽夫时醉酒了。");
    g_tipLine[10957] = StringToText("【运作方式】");
    g_tipLine[10958] = StringToText("除了首个夜晚以外的每个夜晚，唤醒珀。珀要么摇头表示不选择任何人，要么指向任意一名玩家。让珀重新入睡。");
    g_tipLine[10959] = StringToText("  如果珀没有选择任何人，将「攻击三次」提示标记放置到珀的角色标记旁。如果珀选择了一名玩家，该玩家死亡——将「死亡」");
    g_tipLine[10960] = StringToText("  提示标记放置到该玩家的角色标记旁。");
    g_tipLine[10961] = StringToText("如果唤醒珀行动时标有「攻击三次」，让珀依次指向三名玩家，每次一名。按照选择的顺序，");
    g_tipLine[10962] = StringToText("  每名所选玩家依次死亡——将「死亡」提示标记放置到这些玩家的角色标记旁。移除「攻击三次」提示标记。");
    g_tipLine[10963] = StringToText("【提示标记】");
    g_tipLine[10964] = StringToText("· 攻击三次");
    g_tipLine[10965] = StringToText("放置时机：在珀夜晚行动并选择不进行攻击后放置。");
    g_tipLine[10966] = StringToText("放置条件：在珀夜晚行动并选择不进行攻击后，放置在珀角色标记旁。不论珀在未做选择时是否醉酒中毒，都需要进行放置。");
    g_tipLine[10967] = StringToText("移除时机：在下一个夜晚，轮到珀夜晚行动并结算完行动效果（此时说书人需要提醒他必须选择三名玩家作为攻击目标）");
    g_tipLine[10968] = StringToText("  后移除。");
    g_tipLine[10969] = StringToText("· 死亡");
    g_tipLine[10970] = StringToText("放置时机：在珀夜晚行动并选择了玩家后放置。");
    g_tipLine[10971] = StringToText("放置条件：珀选择的玩家当前存活，且能被珀杀死，且珀未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[10972] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[10973] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[10974] = StringToText("【提示与技巧】");
    g_tipLine[10975] = StringToText("· 耐心和凶残的珀是黯月初升中最致命的恶魔。没有其他恶魔在一夜中能做出和你一样多的破坏。与饥饿的沙巴洛斯不同，");
    g_tipLine[10976] = StringToText("  你的受害者不会出乎你意料的复活。与僵怖和普卡不同，你的不攻击是可以主动选择的。");
    g_tipLine[10977] = StringToText("  善良阵营一想到你在游戏中就应该吓得发抖，因为他们知道在任何时候，你都可能爆发并让城镇四分五裂。");
    g_tipLine[10978] = StringToText("· 每晚攻击一个，完全无视攻击三次的能力以保持信息（死亡数量）的一致。这样做的一个好处是它消除了你最明显的「充能」");
    g_tipLine[10979] = StringToText("  之夜没有人死亡，并且让你几乎与僵怖或普卡没有区别……至少在最初是这样。");
    g_tipLine[10980] = StringToText("  浪费资源试图处决假死恶魔或怀疑自己信息的善良玩家对您来说是一件好事！明显的缺点是你的杀戮会少得多，");
    g_tipLine[10981] = StringToText("  这让善良阵营有更长的时间来识破你的伪装并找到你。");
    g_tipLine[10982] = StringToText("  · 不要退缩——持续充能和爆发。通过每晚利用你的爆发能力，你基本上可以「买二赠一」");
    g_tipLine[10983] = StringToText("    ——这意味着你在两个夜晚比正常情况下多杀一个。如果善良玩家死了，他们不会知道是什么鬼东西让他们死亡的！");
    g_tipLine[10984] = StringToText("    这种方法的缺点是很明显的让你暴露在游戏中 - 你会在一个晚上造成比任何角色都要多的杀戮，而善良阵营会认同这一点。");
    g_tipLine[10985] = StringToText("    这会让你理所当然地陷入困境，因为像侍臣这样的角色可能会与你痛饮三天三夜，");
    g_tipLine[10986] = StringToText("    或者造谣者可能会开始在他们的陈述中讲的非常具体。");
    g_tipLine[10987] = StringToText("  · 最后，混搭！根据游戏情况的不同，上述两种方法都是可行的，但灵活一点是值得的——在一段时间内每晚杀死一个，");
    g_tipLine[10988] = StringToText("    等到你找到了三个你知道可以死的目标，然后开始你的充能，或者提前释放一次爆发杀戮……但伪装月之子在场来掩盖额外的杀");
    g_tipLine[10989] = StringToText("    戮，然后在剩下的游戏中正常杀戮。通过混合你的爆发杀戮和常规击杀，你可以看情况选择——也许善良阵营很狡猾，");
    g_tipLine[10990] = StringToText("    得知很多信息，所以隐藏你的恶魔角色是至关重要的。又或者善良阵营可能是不团结的，");
    g_tipLine[10991] = StringToText("    你应该在他们有机会团结之前杀掉他们。无论哪种方式，你都是有选择的，所以你不妨充分利用它。");
    g_tipLine[10992] = StringToText("    这种方法的缺点是时机难以把控——你必须提前规划你的行动，这意味着如果你在一个晚上没有进行杀戮，");
    g_tipLine[10993] = StringToText("    那么你真的需要杀死一个以上的人，这可能导致你陷入困境.");
    g_tipLine[10994] = StringToText("· 与刺客和教父（甚至是善良的玩家！）配合，以掩盖你休息的夜晚。如果在充能三杀的当晚发生死亡，");
    g_tipLine[10995] = StringToText("  善良的玩家通常会认为死亡是由于恶魔的攻击，而这种虚假信息会导致他们误入歧途，甚至可能让他们相信有善良玩家在撒谎，");
    g_tipLine[10996] = StringToText("  而实际上他们并没有。例如，如果你一晚上没有杀人（因为你正在准备第二天晚上的三杀），但是那天晚上，");
    g_tipLine[10997] = StringToText("  由于造谣者在白天发表了真实的公开声明而导致一名玩家死亡，那么善良阵营可能相信造谣者的说法是错误的，");
    g_tipLine[10998] = StringToText("  因为他们认为死亡是由于恶魔的袭击而不是造谣者。真的很麻烦对吧。");
    g_tipLine[10999] = StringToText("【对抗珀】");
    g_tipLine[11000] = StringToText("当你要对抗珀的时候，这里有几件事你应该记住：");
    g_tipLine[11001] = StringToText("· 尽快找出珀正在策划阴谋。确定由于夜间行动导致死亡的方式 - 每晚有1名玩家死亡，就像暗示珀在场一样，");
    g_tipLine[11002] = StringToText("  如果没有人在晚上死亡，然后2或3个人在下一个晚上死亡也一样。沙巴洛斯通常每晚都会杀死更多的玩家，");
    g_tipLine[11003] = StringToText("  僵怖和普卡经常导致夜晚没有死亡，但在接下来的晚上也不会有额外的杀戮。如果你发现一个珀在游戏中，");
    g_tipLine[11004] = StringToText("  侍臣可以有效地消除他们的能力，并且其他可能杀死玩家的善良角色，例如月之子，祖母，赌徒和造谣者，");
    g_tipLine[11005] = StringToText("  他们会变的特别小心。");
    g_tipLine[11006] = StringToText("· 能防死的善良角色需要配合好，才能发挥的淋漓尽致。茶艺师、弄臣、旅店老板，甚至是莽夫和水手，");
    g_tipLine[11007] = StringToText("  都应该尽最大努力发挥自己的能力，挽救宝贵的生命，让珀的三杀不至于毁灭小镇。");
    g_tipLine[11008] = StringToText("· 始终注意有多少玩家还活着。一旦只剩下 5 名玩家还活着，如果善良阵营那天没有人处决，那么珀可以在那天晚上获胜。");
    g_tipLine[11009] = StringToText("  如果其他因夜间行动导致死亡的角色在场，这个数字会更高。如果您认为珀正在游戏中，并且有4、5甚至6名玩家还活着，");
    g_tipLine[11010] = StringToText("  请认真考虑那天您将处决谁……这可能是您的最后一次机会！");
    g_tipRoleAt[46] = 10936; g_tipRoleN[46] = 75; g_tipP1At[46] = 10938; g_tipP1N[46] = 14; g_tipP2At[46] = 0; g_tipP2N[46] = 0;
    g_tipAbility[46] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipLine[11011] = StringToText("【背景故事】");
    g_tipLine[11012] = StringToText("「不要打扰我。时钟的滴答声必须延续下去，它的每一圈循环都象征着生命，");
    g_tipLine[11013] = StringToText("  它的每一圈循环都包含着世间万物——世间的所有答案——它是一个无比神圣的机器。好了，我必须工作了。」");
    g_tipLine[11014] = StringToText("【角色能力】");
    g_tipLine[11015] = StringToText("在你的首个夜晚，你会得知恶魔与爪牙之间最近的距离。（邻座的玩家距离为1）");
    g_tipLine[11016] = StringToText("【角色简介】");
    g_tipLine[11017] = StringToText("钟表匠能得知恶魔与爪牙之间最近的距离。");
    g_tipLine[11018] = StringToText("· 钟表匠只在第一个夜晚得知该信息。");
    g_tipLine[11019] = StringToText("· 距离指代恶魔与爪牙之间坐着的玩家数量，从恶魔旁边的玩家开始，到最近的爪牙结束，顺时针或逆时针均可。");
    g_tipLine[11020] = StringToText("【范例】");
    g_tipLine[11021] = StringToText("方古坐在麻脸巫婆旁边。钟表匠得知了「1」。");
    g_tipLine[11022] = StringToText("诺-达鲺顺时针方向依次坐着筑梦师、舞蛇人，然后是镜像双子。诺-达鲺逆时针方依次坐着畸形秀演员、心上人、哲学家、");
    g_tipLine[11023] = StringToText("  贤者，然后是女巫。因为女巫与恶魔的距离为五，而镜像双子与恶魔的距离为三，所以钟表匠得知了「3」。");
    g_tipLine[11024] = StringToText("方古与两名旅行者相邻，一善一恶。洗脑师与其中一名旅行者相邻。在第一个晚上，钟表匠得知了「2」，");
    g_tipLine[11025] = StringToText("  因为邪恶的旅行者不是爪牙。");
    g_tipLine[11026] = StringToText("【运作方式】");
    g_tipLine[11027] = StringToText("在第一个夜晚，唤醒钟表匠。对他用手势比划数字来表示恶魔与爪牙之间最近的距离(1，2，3等）。让钟表匠重新入睡。");
    g_tipLine[11028] = StringToText("【提示标记】");
    g_tipLine[11029] = StringToText("无");
    g_tipLine[11030] = StringToText("【规则细节】");
    g_tipLine[11031] = StringToText("· 当钟表匠即将被唤醒之前，说书人会根据当前场上的情况给出实时的信息。");
    g_tipLine[11032] = StringToText("  这意味着钟表匠得知的信息可能会与游戏初始时的情况有所不同，因为有一些角色的能力能够在游戏的过程中改变玩家的角色（");
    g_tipLine[11033] = StringToText("  如麻脸巫婆和理发师等）。");
    g_tipLine[11034] = StringToText("· 钟表匠在获得信息时，说书人需要每次抽取两名玩家（其中一名为恶魔，另一名为爪牙，必须是两名不同的玩家）");
    g_tipLine[11035] = StringToText("  进行距离计算，直到将场上所有的「恶魔-爪牙」组合遍历完毕。这一过程类似于厨师，会进行多次判断，");
    g_tipLine[11036] = StringToText("  因此某些角色可能会在不同的玩家组合中被当作为不同的结果（如间谍、陌客、照看小怪宝的爪牙等）。最后，");
    g_tipLine[11037] = StringToText("  说书人会将这些距离值中的最小值作为信息提供给钟表匠。");
    g_tipLine[11038] = StringToText("· 在计算距离时，距离值等同于：恶魔与爪牙这两名玩家之间的玩家数量+1。因此，钟表匠能得知的最小数字为「1」。");
    g_tipLine[11039] = StringToText("  （然而，在极端情况下，如果场上缺乏某种类型的角色，如无恶魔或无爪牙的时候，钟表匠会得知「0」。）");
    g_tipLine[11040] = StringToText("· 在抽取两名玩家的组合时，即使是已死亡的玩家也依然会被钟表匠进行探查。");
    g_tipLine[11041] = StringToText("· 相克规则：");
    g_tipLine[11042] = StringToText("  · 召唤师：召唤师会被钟表匠当作恶魔。");
    g_tipLine[11043] = StringToText("【提示与技巧】");
    g_tipLine[11044] = StringToText("· 你不必立即提供你的信息；等待一两天以便你可以在邪恶阵营放松警惕的时候观察其他玩家来发现可疑之处。");
    g_tipLine[11045] = StringToText("· 如果你能找出一个爪牙那么你的信息将会变得非常有用。弄清楚谁是爪牙，你就可以确定谁更有嫌疑是恶魔。");
    g_tipLine[11046] = StringToText("  你需要和其他善良角色合作尝试揭露真相。许多玩家有着辨识出邪恶阵营的能力（如神谕者和女裁缝）");
    g_tipLine[11047] = StringToText("  或是辨识恶魔与爪牙的能力（如卖花女孩、城镇公告员甚至是舞蛇人）。");
    g_tipLine[11048] = StringToText("· 如果你得到一个特别大的数字（＞3），那么爪牙们很可能坐的很近并离恶魔很远。同样的如果你得到一个很小的数字（＜2）");
    g_tipLine[11049] = StringToText("  ，那么其中一个爪牙里恶魔的距离很近。你可以利用这些信息来观察他们是否有对话，或有其他玩家的互动与你的信息匹配。");
    g_tipLine[11050] = StringToText("· 如果你有怀疑是恶魔的对象，你可以利用你的信息来寻找可能是爪牙的玩家，然后观察他们，");
    g_tipLine[11051] = StringToText("  他们提供的信息以及有什么信息是关于他们的。相比于恶魔（知道三个不在场角色）爪牙们倾向于努力的隐藏自己，");
    g_tipLine[11052] = StringToText("  你可以好好利用爪牙们的弱点来确认谁是恶魔。");
    g_tipLine[11053] = StringToText("· 你的信息将随着游戏推进以及玩家逐渐死亡变得越发的有用。由于邪恶的玩家不太可能会在夜晚时死去，");
    g_tipLine[11054] = StringToText("  他们往往想要活的更长来互相支持对方以及他们的观点，因此他们相比于游戏开始时会变得越来越容易暴露。");
    g_tipLine[11055] = StringToText("  观察仍然活着的玩家中是否能匹配你的信息；如果他们在暗中支持对方，那么他们很有可能是潜藏的邪恶玩家。");
    g_tipLine[11056] = StringToText("· 所有你即将面对的爪牙都有明显的表现，也就是说即使他们死了，也会有明显的现象。");
    g_tipLine[11057] = StringToText("  如果你注意到突然间没有人再因为女巫诅咒而死，被洗脑师洗脑，或者因为麻脸巫婆改变角色，");
    g_tipLine[11058] = StringToText("  那么很有可能你们已经处决了这些爪牙。弄清楚这些可以让你回推出谁会是恶魔！镜像双子是一个例外，");
    g_tipLine[11059] = StringToText("  因为你通常会在很早的时候就得知他们在场。这也意味着你可能在很早就确定（最多）四个有可能是恶魔的玩家。");
    g_tipRoleAt[47] = 11011; g_tipRoleN[47] = 49; g_tipP1At[47] = 11014; g_tipP1N[47] = 6; g_tipP2At[47] = 11030; g_tipP2N[47] = 13;
    g_tipAbility[47] = StringToText("在你的首个夜晚，你会得知恶魔与爪牙之间最近的距离。（邻座的玩家距离为1）");
    g_tipLine[11060] = StringToText("【背景故事】");
    g_tipLine[11061] = StringToText("「我记得有钟表匠……天空是红色的，有不规则的三角形不断从天上坠落下来。有紫罗兰的气味……还有气泡咕嘟咕嘟的声音。");
    g_tipLine[11062] = StringToText("  一个眼睛发光、还有着乱糟糟的胡须的女人对着天空发出嘶嘶声。然后，我醒了……」");
    g_tipLine[11063] = StringToText("【角色能力】");
    g_tipLine[11064] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个善良角色和一个邪恶角色，该玩家是其中一个角色。");
    g_tipLine[11065] = StringToText("【角色简介】");
    g_tipLine[11066] = StringToText("筑梦师能得知一名玩家可能对应的角色，但不能确认哪个是正确的。");
    g_tipLine[11067] = StringToText("· 每个夜晚，筑梦师需要选择一名其他玩家，并得知一个善良角色与一个邪恶角色，其中一个是那名玩家的真实角色。");
    g_tipLine[11068] = StringToText("· 筑梦师得知的错误角色标记取决于所选玩家的真正的角色类型。如果筑梦师选择的玩家是镇民或外来者，");
    g_tipLine[11069] = StringToText("  对应的错误的邪恶角色可以是爪牙或恶魔。如果筑梦师选择的玩家是爪牙或恶魔，对应的错误的善良角色可以是镇民或外来者。");
    g_tipLine[11070] = StringToText("· 筑梦师不能选择自己和旅行者作为目标。");
    g_tipLine[11071] = StringToText("【范例】");
    g_tipLine[11072] = StringToText("筑梦师选择一名玩家，该玩家是畸形秀演员。筑梦师得知该玩家是畸形秀演员或洗脑师。");
    g_tipLine[11073] = StringToText("筑梦师选择了一名获得了卖花女孩能力的哲学家。筑梦师得知该玩家要么是哲学家，要么是亡骨魔。");
    g_tipLine[11074] = StringToText("在白天，镜像双子和艺术家都声称自己是艺术家。在那天晚上，筑梦师选择了镜像双子。如果说书人想帮助善良阵营，");
    g_tipLine[11075] = StringToText("  他可以给筑梦师展示这两个角色：镜像双子和心上人。反之，他可以给筑梦师镜像双子和艺术家这两个角色。");
    g_tipLine[11076] = StringToText("筑梦师选择了一名玩家，他的真实角色是涡流。因为涡流的能力效果，筑梦师获得的信息必须是错误的。");
    g_tipLine[11077] = StringToText("  所以筑梦师得到这个玩家的角色是神谕者或诺-达鲺。");
    g_tipLine[11078] = StringToText("【运作方式】");
    g_tipLine[11079] = StringToText("每个夜晚，唤醒筑梦师。让他指向除自己和旅行者外的任意一名玩家。如果被选择的玩家的真实角色是镇民或外来者，");
    g_tipLine[11080] = StringToText("  向筑梦师展示他的真实角色和任意一个爪牙或恶魔角色标记。如果被选择的玩家的真实角色是爪牙或恶魔，");
    g_tipLine[11081] = StringToText("  则给筑梦师展示他的真实角色和任意一个镇民或外来者角色标记。让筑梦师重新入睡。");
    g_tipLine[11082] = StringToText("如果筑梦师选择了一名邪恶玩家，你能通过这种方式来帮助邪恶阵营：你可以给筑梦师展示邪恶玩家正在伪装的虚假角色，");
    g_tipLine[11083] = StringToText("  或者展示一些需要隐藏自己的角色，例如舞蛇人、贤者、畸形秀演员或呆瓜。");
    g_tipLine[11084] = StringToText("【提示标记】");
    g_tipLine[11085] = StringToText("无");
    g_tipLine[11086] = StringToText("【提示与技巧】");
    g_tipLine[11087] = StringToText("· 每次你选择一名玩家，你就会得知他潜在的一种邪恶角色的可能性。请关注这些信息，因为这会给你带来惊人的信息量，");
    g_tipLine[11088] = StringToText("  哪怕这是错误的信息。例如，任何潜在角色是爪牙的玩家将不太可能是恶魔，所以你可以将他们从你嫌疑名单上划掉。");
    g_tipLine[11089] = StringToText("· 你的信息可以绝佳的辨识出是否受到涡流或诺-达鲺影响，因为和其他玩家不同，你的信息可以非常容易证实是否正确。");
    g_tipLine[11090] = StringToText("  如果你得知的一名玩家的信息不太合理，那么你就要保持怀疑了。如果你得到更多玩家的信息都不合理？");
    g_tipLine[11091] = StringToText("  那么你就要寻找其他的可能性。");
    g_tipLine[11092] = StringToText("· 试着去选择没有和你邻座的玩家。如果你和诺-达鲺邻座，你就会中毒，那么你的信息就会对于恶魔有利。");
    g_tipLine[11093] = StringToText("  通过选择离你更远的玩家，你会选中邪恶玩家获得关于他们的不可靠信息的可能性就会小的多。");
    g_tipLine[11094] = StringToText("  （当然你仍然可以在后续去选择你的邻座玩家）");
    g_tipLine[11095] = StringToText("· 在游戏早期提供你的信息将更有帮助。很少有玩家会直接公布他的角色，因为邪恶玩家们需要时间来配合，");
    g_tipLine[11096] = StringToText("  那么你就有绝佳的时机来证实你是一个善良玩家。");
    g_tipLine[11097] = StringToText("· 当与你选择的玩家交换信息的时候，谨慎于先透露你的信息。如果你对一名邪恶玩家这么做，");
    g_tipLine[11098] = StringToText("  那么很可能你会给他提供一个可能伪装的角色。取而代之的是，让他透露他的角色给你，来看是否与你的信息匹配");
    g_tipLine[11099] = StringToText("· 如果你选择在交换信息时先透露你的信息，那么这将很明确的证实你的筑梦师角色……提供你的消息当然也是不错的选择。");
    g_tipLine[11100] = StringToText("  这将使对方对你有更多的信任，因为除此之外很难获取这样的信息。");
    g_tipLine[11101] = StringToText("· 鼓励玩家们不要过早的揭示自己的角色。如果有人声明了他的角色，你仍然可以去做检查，");
    g_tipLine[11102] = StringToText("  但是如果所有人都公开了他们的角色，那你就很难去证明自己了。");
    g_tipLine[11103] = StringToText("· 相比于你认为说了真话的玩家，可以去检查那些你认为在说谎的玩家。将玩家从谎言中抓出的体验是很棒的，");
    g_tipLine[11104] = StringToText("  因为你会得知这个邪恶玩家的角色，如果你想让他死去，你可以立即公布这个信息。");
    g_tipLine[11105] = StringToText("· 可以选择你认为说真话的玩家；不仅这让他更受到支持，而且如果你发现你的信息错误，");
    g_tipLine[11106] = StringToText("  你可以去怀疑是否有什么其他原因导致了这一切。");
    g_tipLine[11107] = StringToText("· 你永远不会得到涡流这个角色，因为如果涡流在场你必定获得错误信息。");
    g_tipLine[11108] = StringToText("· 如果场上有一对镜像双子角色，不用去检查他们。你很可能会得到镜像双子中善良与邪恶的角色……这将毫无用处。");
    g_tipLine[11109] = StringToText("  有一个例外：你可以借此发现是否有涡流在场。");
    g_tipRoleAt[48] = 11060; g_tipRoleN[48] = 50; g_tipP1At[48] = 11063; g_tipP1N[48] = 8; g_tipP2At[48] = 0; g_tipP2N[48] = 0;
    g_tipAbility[48] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个善良角色和一个邪恶角色，该玩家是其中一个角色。");
    g_tipLine[11110] = StringToText("【背景故事】");
    g_tipLine[11111] = StringToText("「这位老爷……虽然我的烟斗是金色的，虽然我只要一首曲子就能驯服最狂野的灯神，但我只是一个卑贱的舞蛇人罢了，");
    g_tipLine[11112] = StringToText("  哎……听天由命吧。俗话说，人心不足蛇吞象。但不是我，这位老爷……真的不是我。」");
    g_tipLine[11113] = StringToText("【角色能力】");
    g_tipLine[11114] = StringToText("每个夜晚，你要选择一名存活的玩家：如果你选中了恶魔，你和他交换角色和阵营，然后他中毒。");
    g_tipLine[11115] = StringToText("【角色简介】");
    g_tipLine[11116] = StringToText("舞蛇人会得知哪些玩家不是恶魔……但是如果舞蛇人太过于冒失或贪婪，自己就会成为恶魔。");
    g_tipLine[11117] = StringToText("· 每个夜晚，舞蛇人需要选择一名存活玩家。如果那名玩家不是恶魔，无事发生。当选中一名恶魔时，");
    g_tipLine[11118] = StringToText("  舞蛇人变成那个恶魔并转为邪恶，那名恶魔则转为善良并永久中毒。");
    g_tipLine[11119] = StringToText("· 如果具有舞蛇人能力的哲学家选中了恶魔玩家并变成了新的恶魔，原本的恶魔会变成中毒的哲学家。");
    g_tipLine[11120] = StringToText("【范例】");
    g_tipLine[11121] = StringToText("舞蛇人选择的玩家是麻脸巫婆，无事发生。下个夜晚，舞蛇人选择他自己，依旧无事发生。");
    g_tipLine[11122] = StringToText("舞蛇人选择的玩家是亡骨魔。舞蛇人立即变成邪恶的亡骨魔，曾经是亡骨魔的玩家变成善良的舞蛇人并中毒。");
    g_tipLine[11123] = StringToText("麻脸巫婆把自己变成了舞蛇人。然后，舞蛇人——原本为麻脸巫婆——选择了方古玩家。舞蛇人变成了方古，");
    g_tipLine[11124] = StringToText("  方古变成了中毒的舞蛇人。但两者仍然邪恶。");
    g_tipLine[11125] = StringToText("【运作方式】");
    g_tipLine[11126] = StringToText("每个夜晚，唤醒舞蛇人。让他指向任意一名存活玩家。");
    g_tipLine[11127] = StringToText("如果被选择的玩家不是恶魔，则无事发生。让舞蛇人重新入睡。");
    g_tipLine[11128] = StringToText("如果被选择的玩家是恶魔，旧的舞蛇人变为新的（邪恶）恶魔，并且旧的恶魔变为新的（善良）舞蛇人。");
    g_tipLine[11129] = StringToText("  在魔典中交换舞蛇人和恶魔的角色标记。在新的舞蛇人角色标记旁放置「中毒」提示标记。");
    g_tipLine[11130] = StringToText("  唤醒新的恶魔并依次向他展示「你是」信息标记、向下的大拇指、」你是」信息标记、然后是恶魔的角色标记。");
    g_tipLine[11131] = StringToText("  （这代表该玩家现在是邪恶的恶魔。）让新恶魔重新入睡。唤醒新的舞蛇人并依次向他展示「你是」信息标记、向上的大拇指、");
    g_tipLine[11132] = StringToText("  「你是」信息标记、然后是舞蛇人的角色标记。（这代表该玩家现在是善良的舞蛇人。）让新舞蛇人重新入睡。");
    g_tipLine[11133] = StringToText("在舞蛇人属于邪恶阵营，或者恶魔属于善良阵营的特殊情况下，依旧相应地交换他们的阵营。");
    g_tipLine[11134] = StringToText("【提示标记】");
    g_tipLine[11135] = StringToText("· 中毒");
    g_tipLine[11136] = StringToText("放置时机：舞蛇人成功触发自己的能力，并在与恶魔交换角色标记之后。");
    g_tipLine[11137] = StringToText("放置条件：舞蛇人与恶魔交换角色标记之后，放置在原恶魔现舞蛇人的角色标记旁。");
    g_tipLine[11138] = StringToText("  （即使是通过其他角色能力获取的舞蛇人的能力，依然要放置舞蛇人的中毒标记，但如果没有多余的舞蛇人中毒标记，");
    g_tipLine[11139] = StringToText("  则可以用对应角色的相应提示标记来提示现在的这个角色中毒了，且让这个角色中毒的效果是来自于这个角色本身。）");
    g_tipLine[11140] = StringToText("移除时机：放置有此标记的角色死亡或离场时。");
    g_tipLine[11141] = StringToText("【规则细节】");
    g_tipLine[11142] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[11143] = StringToText("  · 梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_tipLine[11144] = StringToText("【提示与技巧】");
    g_tipLine[11145] = StringToText("· 舞蛇人存在双重可能性。在任何可能的时候，你可能变为邪恶转而开始背叛你的队伍。而在此之前，你是一名善良玩家，");
    g_tipLine[11146] = StringToText("  你的信息也极其有用（知道谁不是恶魔与知道谁是恶魔同样重要！）。不像其他玩家，你并不为了你的队伍，而是为了你自己，");
    g_tipLine[11147] = StringToText("  或者说为游戏结束时你所在的阵营。");
    g_tipLine[11148] = StringToText("· 谨慎一点；只选择少数玩家来确认不是恶魔。瞄准那些你认为会存活一段时间的玩家-如果在最后一天还活着的玩家中有你知道");
    g_tipLine[11149] = StringToText("  不是恶魔的，那么你们将从3选一变为2选1！一旦你对自己收集到的信息感到满足了（或者你并不想再冒险了），");
    g_tipLine[11150] = StringToText("  请记住你可以在晚上选择自己来避免成为恶魔！");
    g_tipLine[11151] = StringToText("· 大胆一点；选择尽可能多的玩家，你确认不是恶魔的玩家越多，你就越强大！这种方法会提高你成为恶魔的概率，");
    g_tipLine[11152] = StringToText("  但如果你整局游戏都是善良阵营，那么你将拥有强大的力量来对抗邪恶阵营。");
    g_tipLine[11153] = StringToText("  然而如果你变邪恶了……我相信如果你这么做的话你也不会担心遇到这样的情况不是吗？");
    g_tipLine[11154] = StringToText("· 不要告诉任何人你是舞蛇人，除非你确信你自己不会变为恶魔。即使你小心翼翼，你仍然有可能一不小心变为邪恶阵营。");
    g_tipLine[11155] = StringToText("  被你偷走恶魔角色的玩家现在是善良阵营，他会提供大量所发生的信息，如果此时有任何人知道你是舞蛇人，");
    g_tipLine[11156] = StringToText("  你会面临巨大的麻烦。尝试不揭露自己的角色直到死亡，或者你决定不再选择新的玩家。");
    g_tipLine[11157] = StringToText("· 请牢记每个你选择的玩家如果没有使你交换角色，那么他不是恶魔。在验证恶魔时，");
    g_tipLine[11158] = StringToText("  你比占卜师更加精确……只要你能够让团队相信你。");
    g_tipLine[11159] = StringToText("· 如果你一直是善良阵营，在最后请说出你的信息——如果你一直隐藏你的信息那只会对善良阵营造成伤害！");
    g_tipLine[11160] = StringToText("  如果你变邪恶了……不要承认自己是舞蛇人，而是先抓紧找个角色伪装吧。");
    g_tipLine[11161] = StringToText("· 突然变为恶魔会让人很震惊，所以你要为这个可能性做好准备。准备一个角色，即便最坏的情况发生了，");
    g_tipLine[11162] = StringToText("  你也可以马上声明自己是恶魔但被舞蛇人给交换了。只要你足够快且气势汹汹，");
    g_tipLine[11163] = StringToText("  那么可怜的恶魔将很难跟上你的步调来证明你才是邪恶的那一个。");
    g_tipLine[11164] = StringToText("· 那么如果你是恶魔但是变成了舞蛇人该怎么办？不必烦恼——你现在属于善良阵营，依然有着足够清晰的方式获得胜利。");
    g_tipLine[11165] = StringToText("  你有几个选择——立即告知大家你现在属于新的阵营，暴露你的爪牙，然后用你邪恶的能力来追捕新的恶魔吧……或者你也可以");
    g_tipLine[11166] = StringToText("  什么都不说直到几天后。如果这样，你的爪牙们仍然会相信你是恶魔然后去运用他们的能力寻找和对抗新的恶魔。");
    g_tipLine[11167] = StringToText("  同时在这期间你也可以悄悄的告诉一两个善良阵营的玩家让其成为你秘密找寻恶魔计划的伙伴。");
    g_tipRoleAt[49] = 11110; g_tipRoleN[49] = 58; g_tipP1At[49] = 11113; g_tipP1N[49] = 7; g_tipP2At[49] = 11141; g_tipP2N[49] = 3;
    g_tipAbility[49] = StringToText("每个夜晚，你要选择一名存活的玩家：如果你选中了恶魔，你和他交换角色和阵营，然后他中毒。");
    g_tipLine[11168] = StringToText("【背景故事】");
    g_tipLine[11169] = StringToText("「任何连续的，且能进行定量初等运算的形式系统X，都具有不完全性。也就是说，在这个形式系统X内存在一些命题，");
    g_tipLine[11170] = StringToText("  这些命题既不能被证明为真，也不能被证明为否。所以，你喝醉了。」");
    g_tipLine[11171] = StringToText("【角色能力】");
    g_tipLine[11172] = StringToText("每个夜晚，你会得知有多少名玩家的能力因为其他角色的能力而未正常生效。（从上个黎明到你被唤醒时）");
    g_tipLine[11173] = StringToText("【角色简介】");
    g_tipLine[11174] = StringToText("数学家会得知从黎明开始，有多少事情「出错了」。");
    g_tipLine[11175] = StringToText("· 当一个角色的能力受到其他角色的影响而无法按预期方式发挥作用时，数学家会得知这些异常的发生。");
    g_tipLine[11176] = StringToText("  如果由于其他角色的影响使得一名玩家获得一条本应正确，实则错误的信息时，或者本应产生效果的角色能力没有生效时，");
    g_tipLine[11177] = StringToText("  数学家就会得知这些情况。");
    g_tipLine[11178] = StringToText("· 数学家不会得知异常发生在哪名玩家身上，只会得知异常在多少名玩家身上发生了。");
    g_tipLine[11179] = StringToText("· 数学家的能力不会检测数学家自身是否未正常生效。");
    g_tipLine[11180] = StringToText("· 数学家不会检测中毒和醉酒这些状态本身，而是检测因为中毒和醉酒而导致的没有按照预期发挥作用的能力。");
    g_tipLine[11181] = StringToText("  陌客被厨师当作了邪恶玩家，中毒的士兵被小恶魔杀死，此类情况会被数学家检测到。");
    g_tipLine[11182] = StringToText("  中毒的共情者获取了正确信息则不会被检测到。");
    g_tipLine[11183] = StringToText("【范例】");
    g_tipLine[11184] = StringToText("中毒的神谕者得知有两名死亡玩家是邪恶的，但是事实上有三名死亡玩家是邪恶的。所有其他能力正常生效。");
    g_tipLine[11185] = StringToText("  数学家得知了「1」。");
    g_tipLine[11186] = StringToText("中毒的舞蛇人选择了镇民玩家并且无事发生。醉酒的杂耍艺人得知了正确信息。中毒的博学者得知了两条正确信息。当晚，");
    g_tipLine[11187] = StringToText("  数学家得知了「1」，因为舞蛇人和杂耍艺人的能力没有出现异常，但博学者得知的其中一条信息原本应该是错误的。");
    g_tipLine[11188] = StringToText("涡流在游戏中。五名善良玩家得知了错误信息。女巫醉酒了，当被女巫诅咒的玩家发起提名时，该玩家没有死亡。");
    g_tipLine[11189] = StringToText("  虽然有六名玩家的角色能力都没有正常生效，但是数学家由于涡流的能力，得知了「3」。");
    g_tipLine[11190] = StringToText("【运作方式】");
    g_tipLine[11191] = StringToText("每当一名玩家的角色能力由于其他角色的能力而未正常生效时，在该玩家的角色标记旁放置「未正常生效」提示标记。");
    g_tipLine[11192] = StringToText("每个夜晚，唤醒数学家。对他用手势比划数字（0，1，2 等），这个数字等同于魔典中\"未正常生效\"提示标记的数量。");
    g_tipLine[11193] = StringToText("  让数学家重新入睡。移除所有\"未正常生效\" 提示标记。");
    g_tipLine[11194] = StringToText("【提示标记】");
    g_tipLine[11195] = StringToText("只要剧本中有数学家，且数学家在该剧本中能够中途被创造出来，或能被其他角色获取到能力，则不论数学家是否在场，");
    g_tipLine[11196] = StringToText("  都应该及时记录各种未正常生效的情况，并在有数学家出现且在夜晚行动顺序轮到他时反馈给数学家。");
    g_tipLine[11197] = StringToText("· 未正常生效");
    g_tipLine[11198] = StringToText("放置时机：每当有玩家的能力因为受到其他角色能力的影响，而未正常生效时，在该玩家的角色标记旁放置「未正常生效」");
    g_tipLine[11199] = StringToText("  标记。");
    g_tipLine[11200] = StringToText("放置条件：一旦有玩家因他人能力而让自己的角色能力未正常生效，在该玩家的角色标记旁放置此标记。");
    g_tipLine[11201] = StringToText("  同一个玩家不论当天能力有多少次未正常生效，或由于他更换了自己的角色但在处于不同角色下有多少次未正常生效，");
    g_tipLine[11202] = StringToText("  均只会在一名玩家的角色标记旁最多放置1枚「未正常生效」标记。");
    g_tipLine[11203] = StringToText("移除时机：在数学家获取信息后，说书人可以任由自己方便来进行移除。或在黎明时移除。");
    g_tipLine[11204] = StringToText("【规则细节】");
    g_tipLine[11205] = StringToText("· 相克规则：");
    g_tipLine[11206] = StringToText("  · 侍女：侍女会得知数学家是否醒来，即使她是在数学家之前醒来。");
    g_tipLine[11207] = StringToText("  · 疯子：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。");
    g_tipLine[11208] = StringToText("  · 酒鬼：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_tipLine[11209] = StringToText("  · 提线木偶：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_tipLine[11210] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[11211] = StringToText("  · 悟道者：数学家会得知悟道者产生了错误信息或「能力未正常生效」。");
    g_tipLine[11212] = StringToText("  · 引路人：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。");
    g_tipLine[11213] = StringToText("【提示与技巧】");
    g_tipLine[11214] = StringToText("· 你的信息是很有用的，但前提是你得弄清楚其他人都做了什么。和你的队友们沟通，得到他们的信息，");
    g_tipLine[11215] = StringToText("  尽可能找到谁的信息不正确或能力没有正常生效——这将对善良阵营有着巨大的帮助。一些类似于钟表匠、卖花女孩、");
    g_tipLine[11216] = StringToText("  女裁缝和神谕者等等的角色会需要你的帮助来确保他们的信息是正确的。");
    g_tipLine[11217] = StringToText("· 注意你的信息可能会受到游戏进程改变，如果你得到的信息突然变化，请保持警惕。如果刚刚心上人被处决了，");
    g_tipLine[11218] = StringToText("  那么你得到的数值很可能在夜晚增加。又或者，如果你之前得到的信息是\"0\"然后突然变成了\"2\"，");
    g_tipLine[11219] = StringToText("  那么你可以怀疑是麻脸巫婆创造出了一名诺-达鲺。");
    g_tipLine[11220] = StringToText("· 务必和说书人确认你的能力所观测的是什么异常情况。在梦殒春宵中，你通常会观测善良玩家的能力因为邪恶角色导致的改变，");
    g_tipLine[11221] = StringToText("  例如诺-达鲺和涡流。然而，你也同样会观测这些情况，如心上人死后，哲学家选择了在场的一个角色，");
    g_tipLine[11222] = StringToText("  或者中毒的舞蛇人选择了一个恶魔但无事发生。");
    g_tipLine[11223] = StringToText("· 当心涡流！和其他人一样，所有你的信息将会是错误的。如果你得到一个很小的数字，但是看起来有很多人的信息都错误了，");
    g_tipLine[11224] = StringToText("  那么你可以怀疑有涡流在场。特别是当其他人似乎得到错误信息的时候而你得到的信息是\"0\"那么你可以认为你中毒了或者涡流");
    g_tipLine[11225] = StringToText("  在场。");
    g_tipLine[11226] = StringToText("· 得到\"0\"的信息是非常棒的，因为这意味着没有人会获得错误信息或者会发生能力异常。");
    g_tipLine[11227] = StringToText("  每个人都可以相信他们在白天和夜晚所获得的信息。");
    g_tipLine[11228] = StringToText("· 得到\"1\"的信息也是很不错，这意味着只有一个能力没有达到预期结果。如果你们可以找出是那一个是什么，");
    g_tipLine[11229] = StringToText("  那么其他人就可以相信他们在那天的能力是有效的。");
    g_tipLine[11230] = StringToText("· 如果你得到的信息是\"2\"或者更大，那么你们可能将面临麻烦。这说明了你们之中有很多能力出现了异常……或者你中毒了。");
    g_tipLine[11231] = StringToText("· 与其他镇民不同，数学家可以不必害怕站出来说明自己的角色。不仅仅因为你的信息要分享出来才最有用，");
    g_tipLine[11232] = StringToText("  而且即便你只能提供一晚上的信息也是相当有价值的。何况你对邪恶阵营的威胁相比卖花女孩与杂耍艺人等角色要小的多。");
    g_tipRoleAt[50] = 11168; g_tipRoleN[50] = 65; g_tipP1At[50] = 11171; g_tipP1N[50] = 12; g_tipP2At[50] = 11204; g_tipP2N[50] = 9;
    g_tipAbility[50] = StringToText("每个夜晚，你会得知有多少名玩家的能力因为其他角色的能力而未正常生效。（从上个黎明到你被唤醒时）");
    g_tipLine[11233] = StringToText("【背景故事】");
    g_tipLine[11234] = StringToText("「昨天，我的紫罗兰凋谢了。今天，我的罂粟花盛开了。」");
    g_tipLine[11235] = StringToText("【角色能力】");
    g_tipLine[11236] = StringToText("每个夜晚*，你会得知在今天白天时是否有恶魔投过票。");
    g_tipLine[11237] = StringToText("【角色简介】");
    g_tipLine[11238] = StringToText("卖花女孩会得知恶魔是否参与了投票。");
    g_tipLine[11239] = StringToText("· 无论被提名的玩家是否被处决，恶魔的投票都会被卖花女孩计算在内。");
    g_tipLine[11240] = StringToText("· 卖花女孩的能力不会检测到恶魔玩家因为其他的原因而举手表决。例如恶魔玩家举手「投票」选择晚餐吃什么，");
    g_tipLine[11241] = StringToText("  或者恶魔玩家举手赞成流放旅行者，都不会被卖花女孩的能力检测到。");
    g_tipLine[11242] = StringToText("· 如果在原恶魔投票之后，卖花女孩得知该信息之前，恶魔玩家发生了改变，卖花女孩的能力还是会检测到原恶魔是否投票。");
    g_tipLine[11243] = StringToText("· 如果有两名或更多的恶魔玩家在场，卖花女孩的能力都会检测他们当中是否有任一恶魔投票，即使那些死去的恶魔也能检测到。");
    g_tipLine[11244] = StringToText("  哪怕只有一名恶魔玩家投票，卖花女孩得知的信息都是「是」。");
    g_tipLine[11245] = StringToText("【范例】");
    g_tipLine[11246] = StringToText("今天白天有一项提名。很多玩家投票，被提名的玩家被处决。但恶魔没有参与投票。那天晚上，卖花女孩得知了「否」。");
    g_tipLine[11247] = StringToText("今天白天共有三项提名。恶魔在第二次提名投票，没有人被处决。那天晚上，卖花女孩得知了「是」。");
    g_tipLine[11248] = StringToText("今天白天没有提名。白天有一名旅行者被流放了，流放时所有玩家都举手表示赞成。那天晚上，卖花女孩得知的信息是「否」，");
    g_tipLine[11249] = StringToText("  因为赞成流放不是投票。");
    g_tipLine[11250] = StringToText("【运作方式】");
    g_tipLine[11251] = StringToText("每个黎明，在卖花女孩角色标记旁放置「恶魔未投票」提示标记，并移除「恶魔已投票」提示标记（如果有）。");
    g_tipLine[11252] = StringToText("每个白天，如果恶魔在任何处决中投票，则将「恶魔未投票」提示标记替换为「恶魔已投票」提示标记。");
    g_tipLine[11253] = StringToText("除首个夜晚以外的每个夜晚，唤醒卖花女孩。如果卖花女孩被标记为「恶魔未投票」，摇头告知否。");
    g_tipLine[11254] = StringToText("  如果卖花女孩被标记为「恶魔已投票」，点头告知是。让卖花女孩重新入睡。");
    g_tipLine[11255] = StringToText("如果你忘记了恶魔是否在白天投票，在夜晚唤醒恶魔，并向他展示「你今天投票了吗？」信息标记。他必须诚实回答，");
    g_tipLine[11256] = StringToText("  然后重新入睡。");
    g_tipLine[11257] = StringToText("【提示标记】");
    g_tipLine[11258] = StringToText("只要剧本中有卖花女孩，且卖花女孩在该剧本中能够中途被创造出来，或能被其他角色获取到能力，则不论卖花女孩是否在场，");
    g_tipLine[11259] = StringToText("  都应该及时记录恶魔是否投票的情况，并在有卖花女孩出现且在夜晚行动顺序轮到她时反馈给卖花女孩。");
    g_tipLine[11260] = StringToText("· 恶魔未投票");
    g_tipLine[11261] = StringToText("放置时机：每个黎明。");
    g_tipLine[11262] = StringToText("放置条件：如果卖花女孩在场，放置在卖花女孩角色标记旁，否则放置在魔典中央。");
    g_tipLine[11263] = StringToText("移除条件：当满足「恶魔已投票」放置的条件时，将此标记进行替换。");
    g_tipLine[11264] = StringToText("· 恶魔已投票");
    g_tipLine[11265] = StringToText("放置时机：有任何恶魔玩家在处决投票中举手并被计票时。");
    g_tipLine[11266] = StringToText("放置条件：用此标记替换「恶魔未投票」标记。");
    g_tipLine[11267] = StringToText("移除条件：在黎明时。");
    g_tipLine[11268] = StringToText("【规则细节】");
    g_tipLine[11269] = StringToText("无");
    g_tipLine[11270] = StringToText("【提示与技巧】");
    g_tipLine[11271] = StringToText("· 注意！你需要掌握每天都有谁参与投票了，否则你的信息就不会有太大用处。邪恶的玩家可能会在他们是否投票上撒谎，");
    g_tipLine[11272] = StringToText("  所以如果你忘记了，不要过分依赖于让别人来告诉你都有谁投票了。你的信息可以帮助锁定恶魔的位置，");
    g_tipLine[11273] = StringToText("  所以请确保这个信息是有效的。");
    g_tipLine[11274] = StringToText("· 相比于经常投票的人，对那些不投票的人留个心眼。邪恶阵营玩家可能不太希望投票来引起你的注意，");
    g_tipLine[11275] = StringToText("  但是如果你成功的让大量玩家参与了投票而得到信息为\"否\"，那么你就可以锁定恶魔是在那些没有投票的玩家之中。");
    g_tipLine[11276] = StringToText("  同时对于那些在很多人投票时参与投票的人留心，因为很有可能有一个恶魔试图伪装自己而加入投票，从而来限制你的信息。");
    g_tipLine[11277] = StringToText("· 对于一次处决而言，只需要存活玩家的一半的票数就可以成功。如果将要决定处决，");
    g_tipLine[11278] = StringToText("  试图去说服大家限制他们的投票来达到需求范围。这可以使你清晰的将玩家们分为两组——如果你的信息是\"是\"，");
    g_tipLine[11279] = StringToText("  那么你就知道恶魔参与了白天的投票。如果是\"否\"，那么你就知道恶魔在那些白天没有投票的人之中。");
    g_tipLine[11280] = StringToText("  通过这种方式来控制投票可以更容易缩小恶魔的范围，但很显然，和保持沉默来观察投票相比，");
    g_tipLine[11281] = StringToText("  这会使你更容易成为恶魔的击杀目标。");
    g_tipLine[11282] = StringToText("· 你的能力可以让你侦查到恶魔，所以你会成为邪恶阵营比较优去解决的目标。试着和其他你认为是善良的玩家配合，");
    g_tipLine[11283] = StringToText("  让他们来保护你。尤其是像贤者这样的（希望恶魔以他们为目标）角色会希望来伪装成你的角色，吸引恶魔的仇恨，");
    g_tipLine[11284] = StringToText("  而你就可以在暗处收集有关恶魔的信息。这样可以保护你不会成为女巫、洗脑师和麻脸巫婆等会干扰你的角色的目标。");
    g_tipLine[11285] = StringToText("· 你和城镇公告员有着特别的协同作用，因为你们都是对于提名及处决投注精力的玩家。当你在追踪谁投票时，");
    g_tipLine[11286] = StringToText("  同时也特别关注是谁发起的提名。这不仅可以帮助你的队友，而且你在做投票控制的同时，");
    g_tipLine[11287] = StringToText("  给他们的这点帮助并不会让你付出什么代价。");
    g_tipLine[11288] = StringToText("· 在罕见的情况下，你可以直接侦查到涡流是否在场。如果所有玩家投票了，但是你得知没有恶魔参与投票，");
    g_tipLine[11289] = StringToText("  那么涡流必然在场（这将是一个非常有用的信息），或者你中毒/醉酒了（这对大家而言也是非常有用的信息）");
    g_tipRoleAt[51] = 11233; g_tipRoleN[51] = 57; g_tipP1At[51] = 11235; g_tipP1N[51] = 10; g_tipP2At[51] = 11268; g_tipP2N[51] = 2;
    g_tipAbility[51] = StringToText("每个夜晚*，你会得知在今天白天时是否有恶魔投过票。");
    g_tipLine[11290] = StringToText("【背景故事】");
    g_tipLine[11291] = StringToText("「号外！号外！迷宫中的巫术！天才博学者揭露了一切谜团！城镇有危险了！号外！」");
    g_tipLine[11292] = StringToText("【角色能力】");
    g_tipLine[11293] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipLine[11294] = StringToText("【角色简介】");
    g_tipLine[11295] = StringToText("城镇公告员得知爪牙是否提名。");
    g_tipLine[11296] = StringToText("· 每个夜晚，城镇公告员都会得知「是」或「否」。");
    g_tipLine[11297] = StringToText("· 他不会得知哪些玩家是爪牙或有多少爪牙进行了提名，只会得知今天白天是否有爪牙发起了提名。");
    g_tipLine[11298] = StringToText("【范例】");
    g_tipLine[11299] = StringToText("今天白天，仅有一名镇民玩家发起提名。当晚，城镇公告员得知了「否」。");
    g_tipLine[11300] = StringToText("今天白天，有四名玩家发起提名。其中两名玩家是爪牙。有很多玩家投票，但无人被处决，当晚，城镇公告员得知了「是」。");
    g_tipLine[11301] = StringToText("一名爪牙流放了一名旅行者。当晚，城镇公告员得知了「否」，因为发起流放不是提名。");
    g_tipLine[11302] = StringToText("【运作方式】");
    g_tipLine[11303] = StringToText("每个黎明，在城镇公告员角色标记旁放置「爪牙未提名」提示标记，并移除「爪牙已提名」提示标记（如果有）。");
    g_tipLine[11304] = StringToText("每个白天，如果有任何爪牙发起提名，则将「爪牙未提名」提示标记替换为「爪牙已提名」提示标记。");
    g_tipLine[11305] = StringToText("除了第一个夜晚的每个夜晚都唤醒城镇公告员。如果城镇公告员被标记为「爪牙未提名」，摇头告知否。");
    g_tipLine[11306] = StringToText("  如果城镇公告员被标记为「爪牙已提名」，点头告知是。让城镇公告员重新入睡。然后移除「爪牙已提名」标记，如果有的话。");
    g_tipLine[11307] = StringToText("如果你忘记了爪牙是否在白天提名，在夜晚分别单独唤醒每名爪牙玩家。每次唤醒一名玩家并对他展示「你今天提名了吗？」");
    g_tipLine[11308] = StringToText("  信息标记。他必须诚实回答，然后重新入睡。随后再唤醒下一名爪牙玩家。");
    g_tipLine[11309] = StringToText("【提示标记】");
    g_tipLine[11310] = StringToText("只要剧本中有城镇公告员，且城镇公告员在该剧本中能够中途被创造出来，或能被其他角色获取到能力，");
    g_tipLine[11311] = StringToText("  则不论城镇公告员是否在场，都应该及时记录爪牙是否提名的情况，并在有城镇公告员出现且在夜晚行动顺序轮到他时反馈给城镇公告员");
    g_tipLine[11312] = StringToText("  。");
    g_tipLine[11313] = StringToText("· 爪牙未提名");
    g_tipLine[11314] = StringToText("放置时机：每个黎明。");
    g_tipLine[11315] = StringToText("放置条件：如果城镇公告员在场，放置在城镇公告员角色标记旁，否则放置在魔典中央。");
    g_tipLine[11316] = StringToText("移除条件：当满足「爪牙已提名」放置的条件时，将此标记进行替换。");
    g_tipLine[11317] = StringToText("· 爪牙已提名");
    g_tipLine[11318] = StringToText("放置时机：有任何爪牙玩家在提名流程中提名了一名玩家并被说书人成功受理时。");
    g_tipLine[11319] = StringToText("放置条件：用此标记替换「爪牙未提名」标记。");
    g_tipLine[11320] = StringToText("移除条件：在黎明时。");
    g_tipLine[11321] = StringToText("【规则细节】");
    g_tipLine[11322] = StringToText("无");
    g_tipLine[11323] = StringToText("【提示与技巧】");
    g_tipLine[11324] = StringToText("· 注意每天都有谁发起了提名！这应该很容易理解，因为你在每晚得到的信息只有在知道有谁提名时才能有用。");
    g_tipLine[11325] = StringToText("  邪恶玩家可能会对你撒谎，而且每天会发生大量的事情，即便是善良玩家也可能会在几天后忘记提名的情况。");
    g_tipLine[11326] = StringToText("· 尽可能多的让不同的人去提名，提名的人越多你就越能发挥自己的能力去推动游戏的进程。");
    g_tipLine[11327] = StringToText("· 与占卜师不同，当你得到信息\"否\"时并不能给你太多有用信息。因为有可能实际上恶魔潜藏在其中。相反，");
    g_tipLine[11328] = StringToText("  如果你得到\"是\"则会很有价值——这会让你发现爪牙，你可以尽可能让他们被处决。");
    g_tipLine[11329] = StringToText("· 要当心女巫！因为她们和你一样也希望更多的人发起提名，因为这会提高他的诅咒生效的机会。");
    g_tipLine[11330] = StringToText("  试着去推测女巫会对谁使用能力（例如那些很积极的玩家或者经常提名的玩家）并鼓励其他人去提名。");
    g_tipLine[11331] = StringToText("· 如果镜像双子在场，你可以让他们其中的一个进行提名，这可以帮助你了解谁是真正的爪牙！");
    g_tipLine[11332] = StringToText("  你只需要结合其他镇民的信息来确保你的信息正确，排除涡流或者其他会导致你能力失效的风险；毕竟如果弄错镜像双子，");
    g_tipLine[11333] = StringToText("  那么游戏就结束了！");
    g_tipLine[11334] = StringToText("· 你和卖花女孩有着特别的协同作用，因为你们都是对于提名及处决投注精力的玩家。当你在关注谁提名时，");
    g_tipLine[11335] = StringToText("  同时也特别关注是谁投票了。这不仅可以毫不费力的帮助到你的队友，而且可以让他免除暴露自己给恶魔的风险。");
    g_tipLine[11336] = StringToText("· 如果你在游戏早期发现了一个爪牙，那么你们最好是把他处决了。而如果你是在游戏后期发现一个爪牙。");
    g_tipLine[11337] = StringToText("  那么你们可能考虑留着他而去处决其他人。毕竟，游戏的目标是找到恶魔并处决，而不是爪牙。");
    g_tipRoleAt[52] = 11290; g_tipRoleN[52] = 48; g_tipP1At[52] = 11292; g_tipP1N[52] = 6; g_tipP2At[52] = 11321; g_tipP2N[52] = 2;
    g_tipAbility[52] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipLine[11338] = StringToText("【背景故事】");
    g_tipLine[11339] = StringToText("「唯有受选者才能凝视面纱之外的光景。亡者躁动不安……他们的每一根僵硬的手指都指向了刺骨的北地。」");
    g_tipLine[11340] = StringToText("【角色能力】");
    g_tipLine[11341] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是邪恶的。");
    g_tipLine[11342] = StringToText("【角色简介】");
    g_tipLine[11343] = StringToText("神谕者会得知有多少死亡玩家是邪恶的。");
    g_tipLine[11344] = StringToText("· 由于神谕者每晚在恶魔之后行动，所以神谕者的信息以当晚黎明时的状态为基准，他得知的是在所有玩家都睁开眼睛时，");
    g_tipLine[11345] = StringToText("  死亡的邪恶玩家数量。");
    g_tipLine[11346] = StringToText("· 神谕者能力能检测死去的爪牙和恶魔，以及任何属于邪恶阵营的玩家。例如邪恶的旅行者，或者变得邪恶的镇民或外来者。");
    g_tipLine[11347] = StringToText("· 在计算死亡玩家的数量时，请记住计算在魔典中倒置的镇民和外来者角色标记，因为这意味着他们现在属于邪恶阵营。");
    g_tipLine[11348] = StringToText("【范例】");
    g_tipLine[11349] = StringToText("第一个白天，卖花女孩被处决。当晚，恶魔杀死了杂耍艺人。神谕者被唤醒并得知「0」，因为所有死亡玩家都是善良的。");
    g_tipLine[11350] = StringToText("游戏进行到一半，七名玩家死亡。其中五名是善良的，两名是邪恶的。并且在白天，一名邪恶旅行者被流放了。当晚，");
    g_tipLine[11351] = StringToText("  恶魔杀死了他的一名爪牙。神谕者醒来并得知了「4」，因为四名死亡玩家是邪恶的。");
    g_tipLine[11352] = StringToText("【运作方式】");
    g_tipLine[11353] = StringToText("除了第一个夜晚的每个夜晚，唤醒神谕者。对他用手势比划已死亡的邪恶玩家的数量 (0，1，2等）。让神谕者重新入睡。");
    g_tipLine[11354] = StringToText("【提示标记】");
    g_tipLine[11355] = StringToText("无");
    g_tipLine[11356] = StringToText("【提示与技巧】");
    g_tipLine[11357] = StringToText("· 只要你的信息是\"0\"，你就可以相信那些已经死去的玩家都是善良的，也因此你可以与他们合作并使用他们的信息。");
    g_tipLine[11358] = StringToText("· 一旦你得到\"1\"或者更大的信息时，邪恶玩家已经有人死去，你现在需要尤其注意和谁去沟通交流。");
    g_tipLine[11359] = StringToText("  将你的怀疑交给他们去做——他们会急切的希望证明自己是好的，并帮助你来做很多相关指控。");
    g_tipLine[11360] = StringToText("· 大部分在夜晚死亡的玩家是善良的。邪恶的玩家希望自己能尽可能的活下去，");
    g_tipLine[11361] = StringToText("  所以恶魔通常也会集中去杀戮那些有威胁的善良玩家。如果你突然得知有一个邪恶玩家，");
    g_tipLine[11362] = StringToText("  你通常需要开始怀疑最近被处决的玩家。");
    g_tipLine[11363] = StringToText("· 方古和亡骨魔是两个你可以辨别出的恶魔。方古会在他击杀外来者时将其转化，");
    g_tipLine[11364] = StringToText("  而亡骨魔很可能在游戏早期杀死他的一两个爪牙同伴，以确保他的能力保持持续有效。如果你发现了这两种情况中的趋势，");
    g_tipLine[11365] = StringToText("  那么去检查来自这些恶魔的其他内容（比如：外来者数量、在只有少量玩家存活时有爪牙能力生效）。");
    g_tipLine[11366] = StringToText("  如果你可以确认是其中的一种情况，那么你就可以确认没有涡流影响，并且这将为你的胜利带来战略上的意义。");
    g_tipLine[11367] = StringToText("· 你可以随意一些，想要早些说明自己角色或晚些都可以，你会一整天都得到有用的信息，");
    g_tipLine[11368] = StringToText("  所以即便你只有第一天晚上的信息对善良阵营来说也是很有用的。你可以在你的死亡的基础上推断出两种情况——有亡骨魔受到");
    g_tipLine[11369] = StringToText("  了你的威胁，或者有某个邪恶玩家白天被处决了但恶魔不想让你知道。");
    g_tipRoleAt[53] = 11338; g_tipRoleN[53] = 32; g_tipP1At[53] = 11340; g_tipP1N[53] = 8; g_tipP2At[53] = 0; g_tipP2N[53] = 0;
    g_tipAbility[53] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是邪恶的。");
    g_tipLine[11370] = StringToText("【背景故事】");
    g_tipLine[11371] = StringToText("「地上有七十二根火柴……今天的太阳落得更早，月亮还是按时升起……一块破布……庄园里的邪恶之物……三个又三个……我");
    g_tipLine[11372] = StringToText("  们相信的事物和他真正看到的不一样……绿光代表镁……残留物，但是图案不太对……地上有七十二根火柴……」");
    g_tipLine[11373] = StringToText("【角色能力】");
    g_tipLine[11374] = StringToText("每个白天，你可以私下询问说书人以得知两条信息：一个是正确的，一个是错误的。");
    g_tipLine[11375] = StringToText("【角色简介】");
    g_tipLine[11376] = StringToText("博学者能得知惊人的信息，每一个白天，甚至每一局游戏里他能得到的信息都不会相同，但其中一半是错误的。");
    g_tipLine[11377] = StringToText("· 每个白天，说书人选择两条信息提供给博学者……发挥创造力！一条必须是正确的，一条必须是错误的，");
    g_tipLine[11378] = StringToText("  博学者不知道哪条对哪条错。");
    g_tipLine[11379] = StringToText("· 是否与说书人交谈取决于博学者而非说书人。博学者从说书人处获取信息不是公开交流，因此其他玩家不能旁听。");
    g_tipLine[11380] = StringToText("  博学者会秘密地获取信息。");
    g_tipLine[11381] = StringToText("· 博学者可以选择不从说书人那里获取信息，如果他愿意的话。");
    g_tipLine[11382] = StringToText("· 醉酒或中毒的博学者可能会得到两条正确信息或两条错误信息。");
    g_tipLine[11383] = StringToText("【范例】");
    g_tipLine[11384] = StringToText("博学者得知「所有戴眼镜的玩家都是善良的」以及「坐在黑色沙发上的玩家之一是爪牙」。");
    g_tipLine[11385] = StringToText("博学者得知「舞蛇人存在于游戏中」和「昨晚每个玩家都得到了真实的信息」。");
    g_tipLine[11386] = StringToText("博学者得知「恶魔是女性玩家」和「小八属于邪恶阵营」。");
    g_tipLine[11387] = StringToText("博学者得知「小文和小米属于同一个阵营」和「只有一名外来者在场」。");
    g_tipLine[11388] = StringToText("【运作方式】");
    g_tipLine[11389] = StringToText("每个白天仅限一次，如果博学者要求与你进行私聊，请和他一起离开玩家围成的圆圈，保证你们的私聊不会被偷听。");
    g_tipLine[11390] = StringToText("  然后以耳语的方式告知博学者一真一假两条信息。（如果你无法立刻想出两条信息，要么多想一会儿，");
    g_tipLine[11391] = StringToText("  要么让博学者几分钟后再来找你。）");
    g_tipLine[11392] = StringToText("保证你提供的信息有用并且与游戏有关。避免提供恶魔是谁这种信息，否则可能导致游戏快速结束。");
    g_tipLine[11393] = StringToText("  如果你无法决定告知博学者什么信息，你可以选择提供类似于镇民能力能够获取的信息。");
    g_tipLine[11394] = StringToText("【提示标记】");
    g_tipLine[11395] = StringToText("无");
    g_tipLine[11396] = StringToText("【规则细节】");
    g_tipLine[11397] = StringToText("· 博学者在中文社区内的「谜题」式信息方式引起了设计师的兴趣，对于「是否应该给博学者提供谜题类信息」，");
    g_tipLine[11398] = StringToText("  设计师的回复如下（原文翻译）：「从规则上来讲，给出这样的信息是不允许的，");
    g_tipLine[11399] = StringToText("  因为这种含糊不清的内容并不能算是‘正确’或是‘错误’的信息。然而，如果说书人愿意以这样的方式给出信息，");
    g_tipLine[11400] = StringToText("  也没有任何问题。因为这允许了新人玩家在伪装自己是博学者时有更为宽松的要求——他们不需要编造明显正确或是错误的信息");
    g_tipLine[11401] = StringToText("  便能成功地伪装。说书人能够在一定限度内去‘犯一些错’，而这会使得玩家们也因此在伪装上更为容易。");
    g_tipLine[11402] = StringToText("  编造谜题也会让游戏变得更加有趣。」");
    g_tipLine[11403] = StringToText("· 如果你在作为说书人时想要给出谜题类的信息，那么你需要注意适时给出更为严肃的信息来「以假乱真」，");
    g_tipLine[11404] = StringToText("  或是适当协助邪恶玩家进行一些谜题的伪造，来帮助他们显得更像是真正从你这里获得了谜题类信息一样。");
    g_tipLine[11405] = StringToText("【提示与技巧】");
    g_tipLine[11406] = StringToText("· 在每天你可以得到一条真信息和一条假信息。最简单的运用方式就是选择一条你认为是真信息的然后去推理。例如，");
    g_tipLine[11407] = StringToText("  说书人告诉你a)有畸形秀演员在场b)你的邻座都是善良的，而现在没有证据表明畸形秀演员在场，");
    g_tipLine[11408] = StringToText("  那么你只需要假设你的邻座确实都是善良的。有可能这是错误的，但是你必须要做出一个\"最好的假设\"。");
    g_tipLine[11409] = StringToText("· 在某些情况下，你的其中一条信息会被证实是正确的，那么另一条就是错误的。或者其中一条被证实是错误，");
    g_tipLine[11410] = StringToText("  则另一条就会是正确的。这将为你让你得知大量信息。例如，如果你得知a)有一个金发玩家是爪牙b)有三个外来者在场，");
    g_tipLine[11411] = StringToText("  如果大量证据表明爪牙已经死去了（而死去的玩家中没有金发玩家），那么你可以大胆认为场上确实有三个外来者。");
    g_tipLine[11412] = StringToText("· 有些时候你可以尝试去验证你其中一条的真假，这同样会给你带来很多信息。例如，");
    g_tipLine[11413] = StringToText("  如果你得知a)恶魔穿着衬衫或b)坐在黑色沙发上的玩家都是善良的。那么你可以故意去处决所有穿着衬衫的玩家，");
    g_tipLine[11414] = StringToText("  而如果游戏仍然继续，恶魔仍然在夜里行动，那么你就知道恶魔没有穿衬衫，所以所有坐在黑色沙发上的玩家就都是善良的。");
    g_tipLine[11415] = StringToText("· 如果你能判断你哪条信息是错的，那么假信息就和真信息一样有用。当你在颠倒真假信息时，注意不要犯逻辑错误。例如，");
    g_tipLine[11416] = StringToText("  你得知\"女巫昨晚选择了一名善良玩家\"，如果你认为这条信息是错的，那么相反的信息并不一定是\"女巫昨晚选择了一名邪恶");
    g_tipLine[11417] = StringToText("  玩家\"，因为也许并没有女巫在场，又或者女巫已经死了。你唯一能够知道的是所有善良玩家昨晚都没有被女巫诅咒所以可以放");
    g_tipLine[11418] = StringToText("  心提名。");
    g_tipLine[11419] = StringToText("· 每一天你可以得到两条信息。要立刻分辨出哪一条是真信息可能不太容易，但随着游戏进行，");
    g_tipLine[11420] = StringToText("  你可以将后续的信息与之前的信息对比，从而得出具体的结论。例如，如果你在第一天得知a)有舞蛇人在场或b)所有戴帽子");
    g_tipLine[11421] = StringToText("  的玩家是善良的。然后在第三天，你得知a)有一个新的玩家在昨晚成为了恶魔b)爪牙已经死了，那么这些信息就有所交互。");
    g_tipLine[11422] = StringToText("  如果你假设恶魔已经被舞蛇人换了，那么你就可以推断至少有一个戴帽子的玩家是邪恶的，并且爪牙仍然还活着。");
    g_tipLine[11423] = StringToText("· 告诉大家你在每天得到的信息，可以让大家帮助你记住。一旦游戏不断推进，你可能很难记住说书人说的所有信息。毕竟，");
    g_tipLine[11424] = StringToText("  你需要成为一名真正的博学者！告诉大家你的信息以确保这些信息不会被遗忘。或者，");
    g_tipLine[11425] = StringToText("  如果你有很好的记忆力（或者你能悄悄的写下来，又或者说书人允许你写下来做记录），那么你可以保持低调，");
    g_tipLine[11426] = StringToText("  然后在后续一次性揭露你的爆炸信息。");
    g_tipLine[11427] = StringToText("· 为了获得更多信息，你需要尽可能的多活几天。你可以装作是那些恶魔不太愿意去攻击的对象，如：贤者、");
    g_tipLine[11428] = StringToText("  钟表匠或者已经使用能力的女裁缝等，或者你也可以保持沉默。你活的越久，你能得到的信息就越多。");
    g_tipLine[11429] = StringToText("  但是也不要藏的太久……你需要适当的早些告诉大家你的信息，来帮助大家处决邪恶玩家，否则由于女巫、");
    g_tipLine[11430] = StringToText("  洗脑师或者畸形秀演员等能力，你们之中会有越来越多的人死去。如果有镜像双子或者涡流在场，");
    g_tipLine[11431] = StringToText("  那么利用你的信息对大家进行纠正将会尤其的有用。");
    g_tipLine[11432] = StringToText("· 注意说书人使用的词汇——如果你做了小小的变更有可能会出现截然不同的结果。");
    g_tipLine[11433] = StringToText("  由于对说书人而言如果博学者在游戏中将会非常困难，因为他们需要编造一些对你有用但又不能对邪恶阵营太过不公平的信息，");
    g_tipLine[11434] = StringToText("  所以说书人通常会非常谨慎的给出信息。要准确的记住说书人给出的信息，以免产生混淆。例如，");
    g_tipLine[11435] = StringToText("  如果说书人说\"所有爪牙都坐在蓝色沙发上\"而你告诉大家\"蓝色沙发上的玩家都是爪牙\"，那么你就犯了一个逻辑错误。");
    g_tipLine[11436] = StringToText("  又或者，如果说书人说\"恶魔戴着眼镜\"，而你告诉大家\"恶魔就是戴眼镜的人\"，请注意，");
    g_tipLine[11437] = StringToText("  这里的说法略微不同——如果恶魔在你不注意的情况下摘下眼镜，而你一直告诉大家恶魔戴着眼镜，你就错了。");
    g_tipLine[11438] = StringToText("· 每一天都要去找说书人，以尽可能的获取更多的信息。随着你每天都去找说书人，你就会得到更多的信息，");
    g_tipLine[11439] = StringToText("  当然恶魔也更有可能去杀你。博学者对于恶魔而言是一个非常危险的角色，所以如果恶魔看见你在每天都去找说书人，");
    g_tipLine[11440] = StringToText("  那么即使你没有说明你自己的角色，恶魔也可能会在晚上攻击你。");
    g_tipLine[11441] = StringToText("· 你也可以在前期不去找说书人。这样会导致你获取更少的信息，但同时更容易存活。而你在当时获取的信息有可能会更有价值。");
    g_tipLine[11442] = StringToText("  在通常情况下，如果只有3、4、5名玩家存活时，你的信息会更有用，因为它会指向更少的玩家。例如，在12人存活时，");
    g_tipLine[11443] = StringToText("  得知两名玩家中有一个是爪牙是比较简单的，但是如果只有3个玩家存活，那就会变得非常简单。");
    g_tipRoleAt[54] = 11370; g_tipRoleN[54] = 74; g_tipP1At[54] = 11373; g_tipP1N[54] = 10; g_tipP2At[54] = 11396; g_tipP2N[54] = 9;
    g_tipAbility[54] = StringToText("每个白天，你可以私下询问说书人以得知两条信息：一个是正确的，一个是错误的。");
    g_tipLine[11444] = StringToText("【背景故事】");
    g_tipLine[11445] = StringToText("「你听到那个穿羊绒大衣的家伙对我们小贝尔说什么了吗？他说……‘好’？哎，行吧，和哈利还有那个杂耍艺人那一出相比，");
    g_tipLine[11446] = StringToText("  这算不了什么。说什么？我可不说，我又不是什么长舌妇。」");
    g_tipLine[11447] = StringToText("【角色能力】");
    g_tipLine[11448] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[11449] = StringToText("【角色简介】");
    g_tipLine[11450] = StringToText("女裁缝能得知两名玩家是否属于同一阵营。");
    g_tipLine[11451] = StringToText("· 女裁缝每场游戏只能得到一次信息，所以女裁缝最好是选择最佳时机来使用能力，还要选择最关键的玩家。");
    g_tipLine[11452] = StringToText("· 女裁缝可以选择除自己外的任何玩家，无论他是生是死，甚至可以选择旅行者。");
    g_tipLine[11453] = StringToText("【范例】");
    g_tipLine[11454] = StringToText("在第一个夜晚，女裁缝选择了两名玩家，他们是理发师和钟表匠。因为他俩都是善良的，女裁缝得知「是」。");
    g_tipLine[11455] = StringToText("在前三个夜晚，女裁缝选择不使用他的能力。在第四个夜晚，她选择了两名玩家，他们分别是方古和心上人，女裁缝得知「否」");
    g_tipLine[11456] = StringToText("  。");
    g_tipLine[11457] = StringToText("麻脸巫婆把数学家变成了女巫，女巫仍然是善良的。当晚，女裁缝选择了两名玩家，他们是女巫和城镇公告员。");
    g_tipLine[11458] = StringToText("  女裁缝得知「是」，因为他们是善良的。");
    g_tipLine[11459] = StringToText("【运作方式】");
    g_tipLine[11460] = StringToText("每个夜晚，唤醒女裁缝。她要么摇头不使用能力，要么指向另两名玩家。");
    g_tipLine[11461] = StringToText("如果她摇头，无事发生。让女裁缝重新入睡。");
    g_tipLine[11462] = StringToText("如果她指向两名玩家，要么点头代表是（表示这些玩家是同一阵营），要么摇头代表否（表示这些玩家不是同一阵营）。");
    g_tipLine[11463] = StringToText("  让女裁缝重新入睡。在女裁缝使用能力后，为她放置「失去能力」提示标记，并从夜晚顺序表上移除她的夜晚标记。");
    g_tipLine[11464] = StringToText("【提示标记】");
    g_tipLine[11465] = StringToText("· 失去能力");
    g_tipLine[11466] = StringToText("放置时机：在女裁缝夜晚行动时选择使用能力，并选择了除自己外的两名玩家后。");
    g_tipLine[11467] = StringToText("放置条件：只要女裁缝选择了除自己外的两名玩家，不论女裁缝是否醉酒中毒，都会将此标记放置在女裁缝角色标记旁。");
    g_tipLine[11468] = StringToText("移除时机：女裁缝死亡或离场时。");
    g_tipLine[11469] = StringToText("【提示与技巧】");
    g_tipLine[11470] = StringToText("· 你可以过几天再使用你的能力。虽然这有一定的风险，你很可能在这段时间内死亡，但是如果你等待一段时间，");
    g_tipLine[11471] = StringToText("  你就会对当前局势有一定的了解，比如大家都说自己是什么角色以及你觉得谁可疑。这也意味着随着处决以及恶魔击杀玩家，");
    g_tipLine[11472] = StringToText("  只有更少的活着的玩家供你选择。");
    g_tipLine[11473] = StringToText("· 尽快的使用你的能力！你只有一次机会，如果你在还没使用时就死去了，你肯定会为此自责。");
    g_tipLine[11474] = StringToText("  即使在首夜随机选两个玩家也比到时候一个都选不了好。");
    g_tipLine[11475] = StringToText("· 一个常见的女裁缝易犯的错误是没有记住你辨识的是是否是同一阵营——而不是是否是\"善良\"阵营。这也就意味着，");
    g_tipLine[11476] = StringToText("  如果你足够幸运直接选择了两名邪恶玩家，那你依然会得到信息\"是\"。虽然你更有可能是选到两名善良玩家，");
    g_tipLine[11477] = StringToText("  但是如果你并不确定，你可以尝试协同其他玩家的信息（如钟表匠），来看看是否关联到你的信息。");
    g_tipLine[11478] = StringToText("  你也可以在你还没有揭露他们是同一阵营时观察这两名玩家，看看他们是否相互串通或包庇。");
    g_tipLine[11479] = StringToText("· 如果你有一个很信任的玩家（不管活着还是死了），你可以参照他来确认其他玩家的阵营。如果你得知他们属于不同阵营，");
    g_tipLine[11480] = StringToText("  那么你可以确信另一个玩家会是邪恶的那一个。这在处理棘手的镜像双子时尤其有效。");
    g_tipLine[11481] = StringToText("· 把能力用在那些你不太了解的人身上！得知两名玩家是否同一阵营是非常强力的，");
    g_tipLine[11482] = StringToText("  这可以帮助大家决定是否相信他们是某一角色以及是否相信他们的所作所为。");
    g_tipLine[11483] = StringToText("· 把能力用在那些对游戏有重要影响的角色身上。弄清楚博学者或者卖花女孩是否可信要比弄清楚理发师是否可信要更有效。");
    g_tipLine[11484] = StringToText("· 一般情况下，不要选择那些你的邻座玩家。如果你坐在诺-达鲺旁边，他们会使你中毒并且会非常赞同你的观点。");
    g_tipLine[11485] = StringToText("  通过选择离你更远的玩家，虽然你仍然可能因为中毒得到错误信息，但是至少你可以知道他们之中没有恶魔来搅局。");
    g_tipRoleAt[55] = 11444; g_tipRoleN[55] = 42; g_tipP1At[55] = 11447; g_tipP1N[55] = 6; g_tipP2At[55] = 0; g_tipP2N[55] = 0;
    g_tipAbility[55] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[11486] = StringToText("【背景故事】");
    g_tipLine[11487] = StringToText("「如果你要说什么事情是最真实的？我想是啤酒。痛快喝吧，说不定我们明天就要死了。」");
    g_tipLine[11488] = StringToText("【角色能力】");
    g_tipLine[11489] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个善良角色：你获得该角色的能力。");
    g_tipLine[11490] = StringToText("如果这个角色在场，他醉酒。");
    g_tipLine[11491] = StringToText("【角色简介】");
    g_tipLine[11492] = StringToText("哲学家能够决定自己的能力是什么。");
    g_tipLine[11493] = StringToText("· 他可以选择获得其他角色的能力，但每局仅限一次。当他这么做时，他获得那个角色的能力，但不会变成那个角色。");
    g_tipLine[11494] = StringToText("· 他在选择获得谁的能力时可能会想要思考一小会儿。如果哲学家选择了一个已经在游戏中的角色，该角色对应的玩家醉酒。");
    g_tipLine[11495] = StringToText("  如果哲学家死亡，醉酒或中毒了，那么那名醉酒的玩家会再次恢复清醒。");
    g_tipLine[11496] = StringToText("· 如果哲学家之前选择了不在场的角色，但之后被选择的角色在场了，被选择的角色对应的玩家也会醉酒。");
    g_tipLine[11497] = StringToText("· 如果哲学家获得了一种在夜晚使用的能力，他将在该角色应该被唤醒的时候被唤醒。如果这个角色能力是「首个夜晚」能力，");
    g_tipLine[11498] = StringToText("  他会在当晚使用该能力。");
    g_tipLine[11499] = StringToText("· 如果哲学家通过集骨者重新获得了他的能力，或由于咖啡师使用了两次他的能力，哲学家可以选择一个新的能力，");
    g_tipLine[11500] = StringToText("  或者和以前一样的能力。");
    g_tipLine[11501] = StringToText("· 如果哲学家获取的能力在死亡时生效，例如呆瓜的能力，那么当哲学家死亡后，他选择的角色能力就会生效。");
    g_tipLine[11502] = StringToText("【范例】");
    g_tipLine[11503] = StringToText("哲学家选择获得筑梦师能力。从现在起，他将在筑梦师应该行动时进行行动。");
    g_tipLine[11504] = StringToText("在第三个夜晚，哲学家选择获得钟表匠的能力。当晚，他得知了恶魔与爪牙之间的最近的距离。");
    g_tipLine[11505] = StringToText("哲学家选择获得了艺术家的能力，但场上已经有一名艺术家。那名艺术家玩家醉酒。在那之后，哲学家死亡，");
    g_tipLine[11506] = StringToText("  艺术家玩家恢复清醒。（如果哲学家醉酒或者变成了新的角色，原来那个因哲学家而醉酒的玩家也会恢复清醒。）");
    g_tipLine[11507] = StringToText("【运作方式】");
    g_tipLine[11508] = StringToText("每个夜晚，唤醒哲学家。他要么摇头不使用能力，要么指向角色列表上一个镇民或外来者图标。让哲学家重新入睡。");
    g_tipLine[11509] = StringToText("如果他指向的是不在场的角色，将哲学家角色标记更换为他所选的角色标记，并放置「是哲学家」提示标记。");
    g_tipLine[11510] = StringToText("如果他指向的是一个已在场的角色，该角色醉酒，在角色标记旁放置「醉酒」提示标记。（现在，");
    g_tipLine[11511] = StringToText("  你可以把被选择角色的相关提示标记给哲学家使用了。）如果哲学家死亡，醉酒的玩家将恢复清醒，此时需要移除「醉酒」");
    g_tipLine[11512] = StringToText("  提示标记。");
    g_tipLine[11513] = StringToText("（由于实体标记的操作方式在两种情况下不同，再加上哲学家的能力是会对对应的角色进行动态检测，");
    g_tipLine[11514] = StringToText("  因此建议说书人还应该以其他方式对此进行记录，这里提供一个参考处理方式：如果对应角色在场，");
    g_tipLine[11515] = StringToText("  互换哲学家和那个角色的标记，并在哲学家角色标记旁标记醉酒，在换来的角色标记旁标记「是哲学家」。");
    g_tipLine[11516] = StringToText("  这样也能应对在哲学家选择了一个不在场的角色，但随后该角色又再次在场的情况。）");
    g_tipLine[11517] = StringToText("【提示标记】");
    g_tipLine[11518] = StringToText("· 醉酒");
    g_tipLine[11519] = StringToText("放置时机：在哲学家夜晚行动时选择使用能力，并选择了一个善良角色后。");
    g_tipLine[11520] = StringToText("放置条件：放置在哲学家所选择的那个善良角色所对应的玩家的角色标记旁。如果此时哲学家中毒或醉酒，则不放置。");
    g_tipLine[11521] = StringToText("转移条件：哲学家的醉酒能力是动态检测的，因此一旦哲学家选择的那个角色有被中途创造出来，");
    g_tipLine[11522] = StringToText("  或者这个善良角色所属的玩家角色发生变化，就需要移动醉酒标记到合适的位置。（建议在哲学家所选角色不在场时，");
    g_tipLine[11523] = StringToText("  始终将醉酒提示标记放置于魔典中央，以提醒与放置有「是哲学家」标记的角色——即哲学家获得能力的那种角色——会处于醉酒");
    g_tipLine[11524] = StringToText("  状态）");
    g_tipLine[11525] = StringToText("移除时机：哲学家死亡或离场时。");
    g_tipLine[11526] = StringToText("· 是哲学家");
    g_tipLine[11527] = StringToText("放置时机：在哲学家夜晚行动时选择使用能力，并成功选择了一个善良角色后。");
    g_tipLine[11528] = StringToText("放置条件：哲学家玩家的角色标记旁。");
    g_tipLine[11529] = StringToText("移除时机：哲学家死亡或离场时。");
    g_tipLine[11530] = StringToText("【规则细节】");
    g_tipLine[11531] = StringToText("· 与侍臣相似的是，如果哲学家所选择的角色的在场数量超过1人，那么哲学家的能力只会使得其中一名玩家醉酒。但通常来说，");
    g_tipLine[11532] = StringToText("  说书人应该倾向于优先让存活的玩家醉酒。");
    g_tipLine[11533] = StringToText("· 相克规则：");
    g_tipLine[11534] = StringToText("  · 赏金猎人：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_tipLine[11535] = StringToText("【提示与技巧】");
    g_tipLine[11536] = StringToText("· 哲学家最强大之处就是他的能力非常广泛，多才多艺。你可以模仿列表中的任何善良角色！");
    g_tipLine[11537] = StringToText("  尝试去了解队伍缺少什么或者谁对于对抗当前的邪恶势力更有效。每一个镇民都是可以选择的选项：");
    g_tipLine[11538] = StringToText("1.钟表匠-由于钟表匠只在首个夜晚获得信息，所以你可以在后续的任何时候放心的选择钟表匠的能力。");
    g_tipLine[11539] = StringToText("  这不仅可以让你确认钟表匠的信息，而且如果在游戏后期获得这个信息可以更容易结合大家的信息来确认恶魔与爪牙之间的联系");
    g_tipLine[11540] = StringToText("  。");
    g_tipLine[11541] = StringToText("2.筑梦师-如果大家都不透露他们的角色，那么你可以选择筑梦师来获取这些信息！");
    g_tipLine[11542] = StringToText("  筑梦师可以获取到惊人的信息并且可以快速的和善良玩家建立信任关系，而且也能不错的侦测出涡流。");
    g_tipLine[11543] = StringToText("3.舞蛇人-舞蛇人可以发现谁是恶魔，谁不是恶魔，并且他不会受到涡流的影响，这使他的信息变得更加有效。");
    g_tipLine[11544] = StringToText("  当然他也给了你变成恶魔的可能性，但是显然你不会滥用你的能力去做这样的事吧？");
    g_tipLine[11545] = StringToText("4.数学家-在梦殒春宵版本中，搞清楚谁的信息是可靠的是至关重要的，尤其是在面对涡流的时候。");
    g_tipLine[11546] = StringToText("  如果你想知道善良阵营的信息准不准确，那么没有比数学家更合适的了。");
    g_tipLine[11547] = StringToText("5.卖花女孩-在梦殒春宵版本中，相比其他镇民，恶魔更害怕卖花女孩。知道恶魔是否投票是至关重要的信息，");
    g_tipLine[11548] = StringToText("  可以缩小恶魔的范围。悄悄的获得这个角色能力可能会更好，因为这可能会使恶魔放松警惕。");
    g_tipLine[11549] = StringToText("6.城镇公告员-如果说卖花女孩是针对恶魔的，那么城镇公告员就是针对爪牙的。如果有女巫在场，");
    g_tipLine[11550] = StringToText("  所有的善良角色将更谨慎的去提名，而邪恶玩家会更大胆去提名，所以获得这个角色的能力会是一个不错的选择。");
    g_tipLine[11551] = StringToText("  这也是另一个值得秘密获取的能力，因为爪牙们可能认为场上没有公告员……然后突然之间发现你才是那个城镇公告员！");
    g_tipLine[11552] = StringToText("7.神谕者-相信已死亡的玩家通常在染·钟楼谜团这款游戏中很重要。但不幸的是，");
    g_tipLine[11553] = StringToText("  像亡骨魔这样的恶魔会让此在梦殒春宵版本中变得更加困难，因为可能爪牙会假借死亡的名义潜藏。");
    g_tipLine[11554] = StringToText("  而最好的办法就是有神谕者来审判这些死者。即使没有狡猾的亡骨魔存在，你的信息也是有用的。");
    g_tipLine[11555] = StringToText("8.博学者-如果你觉得对于目前来说没有足够的信息，那么博学者就可以带来帮助。");
    g_tipLine[11556] = StringToText("  他在每天都可以从说书人那里得到有趣的信息提示，而且可以帮助善良玩家们推断出谁是邪恶玩家。");
    g_tipLine[11557] = StringToText("9.女裁缝-探查其他玩家的阵营有助于让你了解你是否应该信任他们。如果你对某个特定的玩家抱有怀疑，");
    g_tipLine[11558] = StringToText("  女裁缝可以让你对他产生进一步的了解。这也是一个限次能力，意味着你可以和初始的女裁缝进行配合，");
    g_tipLine[11559] = StringToText("  使你们两人都能得到更可靠的信息。");
    g_tipLine[11560] = StringToText("10.艺术家-有机会向说书人询问一个是否问题是非常强大的，不要低估这个能力以及能能在关键时刻为你带来的信息。");
    g_tipLine[11561] = StringToText("  当然这是有限制的，和女裁缝一样，艺术家只能使用这个能力一次，所以要注意你去发动能力的时机，如果你注意的话，");
    g_tipLine[11562] = StringToText("  你们可能会得到两个艺术家的问题答案。");
    g_tipLine[11563] = StringToText("11.杂耍艺人-杂耍艺人在他们的第一个白天行动，并不是整局游戏的第一个白天。这意味着，在游戏经历了几天后，");
    g_tipLine[11564] = StringToText("  你可以出人意料的成为杂耍艺人然后去简单快速且准确的确认一些事情。很多玩家在第一天的时候不愿意暴露自己，");
    g_tipLine[11565] = StringToText("  但是随着时间的推移，他们会慢慢透露自己的角色，这使得你比一般的杂耍艺人要更容易发挥效果。");
    g_tipLine[11566] = StringToText("12.贤者-假装获得了其他镇民的能力，而实际上去获得贤者的能力。假装为卖花女孩或者博学者会让恶魔非常害怕……布下");
    g_tipLine[11567] = StringToText("  完美的诱饵，让恶魔上钩。");
    g_tipLine[11568] = StringToText("· 你也可以选择外来者的能力，比如理发师或者呆瓜。通常来说这肯定不如成为其他镇民更有用，");
    g_tipLine[11569] = StringToText("  但也许有这样一点理由你可以这样考虑：");
    g_tipLine[11570] = StringToText("1.你使得一个真正的外来者醉酒。例如，如果你认为恶魔会去击杀心上人，那么你可以选择获得心上人的能力并使他醉酒。");
    g_tipLine[11571] = StringToText("  这意味着他们的能力由于他们醉酒而不会正常发动。");
    g_tipLine[11572] = StringToText("2.呆瓜的能力很恐怖，但是很值得信赖。因为如果呆瓜选择了一名玩家后游戏没有结束，");
    g_tipLine[11573] = StringToText("  那么他肯定是善良的（假设他确实是呆瓜的话）。如果你迫切的需要信息或者想要冒险，那么你可以这样选择。");
    g_tipLine[11574] = StringToText("· 尽早的去使用你的能力通常对你更有用-你越早使用，就可以通过你的能力获得更多信息以及对游戏产生影响。");
    g_tipLine[11575] = StringToText("  这也意味着即使恶魔杀死了你，但你的功效已经发挥了。肯定没有人会想在自己还是哲学家的时候就死去。");
    g_tipLine[11576] = StringToText("· 选择靠后时间再去使用能力可能会冒很大风险，但是却给了你更多的时间去考虑去获得哪个角色的能力。");
    g_tipLine[11577] = StringToText("  你可以有更好的主意去获得谁的能力，因为你知道了你们在对抗哪种恶魔，");
    g_tipLine[11578] = StringToText("  以及哪个角色对于现在的好人阵营能带来更有用的帮助。例如，你怀疑恶魔是亡骨魔，那么你可以选择神谕者。");
    g_tipLine[11579] = StringToText("  如果你们对于镜像双子难以把握，你可以选择女裁缝。或者你需要一个直接的答案？那么你可以选择艺术家。");
    g_tipLine[11580] = StringToText("· 在决定发动能力前尽可能获取信息。由于你选择一个角色后如果这个角色在场则会使他醉酒。");
    g_tipLine[11581] = StringToText("  所以了解有哪些角色在场可以让你在不影响队友的情况获取能力。");
    g_tipLine[11582] = StringToText("· 如果有玩家是类似神谕者或筑梦师这类每晚提供信息的角色，那么你可以秘密的去选择这些角色。由于他们会因你醉酒，");
    g_tipLine[11583] = StringToText("  所以他们的信息应该会和你不同，或者表现的有明显的变化。如果他们的信息依然没有改变，那么他们几乎肯定是邪恶的。");
    g_tipLine[11584] = StringToText("· 你可以完全不必理会这些建议，去选择那些你喜欢的角色吧！舞蛇人？冲冲冲！");
    g_tipLine[11585] = StringToText("· 有时候，可以故意选择在场的角色。这确保了即使恶魔杀死了你们其中一个，你们依然可以获得对应角色的信息。");
    g_tipLine[11586] = StringToText("  这也意味着善良玩家更不愿意去处决你。例如，如果镜像双子在场，而你们担心城镇公告员无法活过当晚，");
    g_tipLine[11587] = StringToText("  你可以利用你的能力获取城镇公告员的能力。这样即使你死了，真正的城镇公告员也可以获得信息。这是双赢的。");
    g_tipRoleAt[56] = 11486; g_tipRoleN[56] = 102; g_tipP1At[56] = 11488; g_tipP1N[56] = 14; g_tipP2At[56] = 11530; g_tipP2N[56] = 5;
    g_tipAbility[56] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个善良角色：你获得该角色的能力。如果这个角色在场，他醉酒。");
    g_tipLine[11588] = StringToText("【背景故事】");
    g_tipLine[11589] = StringToText("「天啊！多么美妙的作品！我的作品……用你们的话怎么说来着……对，璀璨夺目！栩栩如生！没错！」");
    g_tipLine[11590] = StringToText("【角色能力】");
    g_tipLine[11591] = StringToText("每局游戏限一次，在白天时，你可以私下询问说书人一个是非问题，你会得知该问题的答案。");
    g_tipLine[11592] = StringToText("【角色简介】");
    g_tipLine[11593] = StringToText("艺术家可以向说书人提出任一是非问题。");
    g_tipLine[11594] = StringToText("· 艺术家可以询问有关任何内容的问题，也可以随心所欲的遣词造句来提问。说书人需要诚实地回答「是」、「不是」，");
    g_tipLine[11595] = StringToText("  或「我不知道。」");
    g_tipLine[11596] = StringToText("· 是否提问由艺术家决定，而非说书人。艺术家向说书人询问不是公开交流，因此其他玩家不能旁听。");
    g_tipLine[11597] = StringToText("  艺术家会秘密地询问并获取问题的答案。");
    g_tipLine[11598] = StringToText("【范例】");
    g_tipLine[11599] = StringToText("艺术家问：「恶魔坐在棕色椅子上吗？」说书人回答：「不是」，因为此时恶魔坐在黑色椅子上。");
    g_tipLine[11600] = StringToText("艺术家问：「大壮是镜像双子吗？」说书人回答，「是的」，因为此时大壮是镜像双子。");
    g_tipLine[11601] = StringToText("艺术家问：「有多少爪牙活着？」说书人回答：「我无法用’是，不是，或者我不知道’来回答。请再问一个问题。」");
    g_tipLine[11602] = StringToText("艺术家问：「我们快要赢了吗？」说书人回答：「我不知道。」因为此时即使所有爪牙都死了，");
    g_tipLine[11603] = StringToText("  还是有很多善良的玩家相信恶魔是好人。");
    g_tipLine[11604] = StringToText("【运作方式】");
    g_tipLine[11605] = StringToText("在任何一个白天，艺术家都可以要求与你进行私聊。请和他一同离开玩家围成的圆圈以保证你们的私聊不会被偷听。");
    g_tipLine[11606] = StringToText("  艺术家会问你一个问题。你需要以耳语的方式回答他「是」、「不是」或「我不知道」。如果你不能用这三种答案进行回答，");
    g_tipLine[11607] = StringToText("  让他重新问一个问题。艺术家在使用他的能力之后，为他放置「失去能力」提示标记。");
    g_tipLine[11608] = StringToText("与博学者一样，伪装成艺术家的邪恶玩家可能会要求与你私下聊天并假装提出问题。为了帮助他伪装角色，");
    g_tipLine[11609] = StringToText("  你可以通过点头或摇头来假装给出答案。");
    g_tipLine[11610] = StringToText("【提示标记】");
    g_tipLine[11611] = StringToText("· 失去能力");
    g_tipLine[11612] = StringToText("放置时机：在艺术家拜访说书人并询问是非问题后。");
    g_tipLine[11613] = StringToText("放置条件：在艺术家询问问题后，放置在艺术家角色标记旁。不论艺术家是否醉酒中毒，都要放置该标记。");
    g_tipLine[11614] = StringToText("移除时机：艺术家死亡或离场时。");
    g_tipLine[11615] = StringToText("【规则细节】");
    g_tipLine[11616] = StringToText("· 请注意说书人有权回答「我不知道」，且这样会使得艺术家的能力被浪费掉。针对含糊不清的问题，");
    g_tipLine[11617] = StringToText("  或者玩家尝试用多个问题嵌套成一个问题，或是如果说书人认为让玩家「重新再问一个问题」");
    g_tipLine[11618] = StringToText("  会导致对现在的问题有一定程度的暗示作用，那么这种时候，说书人都可以回答「我不知道」。");
    g_tipLine[11619] = StringToText("【提示与技巧】");
    g_tipLine[11620] = StringToText("· 你可以在第一天就尽快的使用你的能力！由于有恶魔及麻脸巫婆的存在，如果你没有使用你的能力，");
    g_tipLine[11621] = StringToText("  你每天都会面临失去你能力的风险。如果你对目前的情况一无所知，那么你可以问很多问题，这会成为找到恶魔的良好开端。");
    g_tipLine[11622] = StringToText("· 你可以过几天再使用你的能力。这非常冒险，因为你很可能失去你的能力。话虽如此，");
    g_tipLine[11623] = StringToText("  梦殒春宵版本中充满了大量的信息——等待玩家们给出信息然后你就可以问出一个更加具体更加致命的通过是否来改变游戏进程");
    g_tipLine[11624] = StringToText("  的问题。特别是像卖花女孩、城镇公告员和神谕者等角色可以帮助你缩小邪恶玩家的范围。");
    g_tipLine[11625] = StringToText("· 如果你问的问题过于具体（例如张三是不是恶魔？）那么通常你只会得到一个毫无帮助的\"不是\"。取而代之的，");
    g_tipLine[11626] = StringToText("  你可以去问那些可以将大家分成两组的问题。例如，去问恶魔是否在一个特定的群体中，这样无论得到是或否，");
    g_tipLine[11627] = StringToText("  都可以缩小恶魔的范围。其他也可以问一些集中的位置是否有邪恶玩家，或者去询问关于镜像双子这样的角色。");
    g_tipLine[11628] = StringToText("· 如果你对游戏内的线索没有太多，你也可以去问那些游戏机制外可以将大家分成两部分的信息。例如，");
    g_tipLine[11629] = StringToText("  如果有一定比例的玩家穿着红T恤，那么你可以问恶魔是不是在其中。");
    g_tipLine[11630] = StringToText("· 如果你可以将信息描述为是/否问题，那么游戏汇总的大部分的信息你都可以复制。你可以听一听大家的发言，");
    g_tipLine[11631] = StringToText("  然后去精心设计你的问题，尽量覆盖善良队伍中的薄弱面，或者去确认/否认其他某个玩家的说法。");
    g_tipLine[11632] = StringToText("· 不要被恶魔发现，这样他们就不会在你使用能力之前杀死你。你可以试着伪装成其他角色，");
    g_tipLine[11633] = StringToText("  或者说你告诉大家你已经使用你的能力去问了问题。如果恶魔相信你，那么他们会认为你现在不具有威胁，");
    g_tipLine[11634] = StringToText("  转而去考虑其他可能获取信息的更具有威胁的目标。");
    g_tipLine[11635] = StringToText("· 不要过于直接的去问关于涡流的问题。比如你问\"是否有涡流在场\"那么你总会得到答案\"否\"——要么是涡流不在场，");
    g_tipLine[11636] = StringToText("  要么是涡流在场并导致你的信息错误。如果真的想检测是否有涡流，你可以问一个绝对正确的问题（如，2+2=4吗？）");
    g_tipLine[11637] = StringToText("  如果说书人说\"否\"，那么你的信息在某方面违背了，所以你知道你得到错误信息了。");
    g_tipLine[11638] = StringToText("· 另一种发现涡流的方式是询问可以在游戏中验证的信息。例如问：恶魔是否在某三名玩家中（注意：");
    g_tipLine[11639] = StringToText("  这三名玩家最好不要离你太近，因为有可能有诺-达鲺影响到你）如果你得到\"是\"那么就处决那些人。如果游戏继续，");
    g_tipLine[11640] = StringToText("  那么你们就知道有涡流。如果你得到\"否\"，那么你就知道要么这三名玩家不是恶魔，要么其中一个可能就是涡流。");
    g_tipRoleAt[57] = 11588; g_tipRoleN[57] = 53; g_tipP1At[57] = 11590; g_tipP1N[57] = 8; g_tipP2At[57] = 11615; g_tipP2N[57] = 4;
    g_tipAbility[57] = StringToText("每局游戏限一次，在白天时，你可以私下询问说书人一个是非问题，你会得知该问题的答案。");
    g_tipLine[11641] = StringToText("【背景故事】");
    g_tipLine[11642] = StringToText("「下一场表演，我需要一朵花、一袋豆子、一条玩具蛇、一支画笔、和一个电动的树篱修剪机。不过我得和你说，宝贝，");
    g_tipLine[11643] = StringToText("  这可能是我最后的表演了哦。」");
    g_tipLine[11644] = StringToText("【角色能力】");
    g_tipLine[11645] = StringToText("在你的首个白天，你可以公开猜测任意玩家的角色最多五次。在当晚，你会得知猜测正确的角色数量。");
    g_tipLine[11646] = StringToText("【角色简介】");
    g_tipLine[11647] = StringToText("杂耍艺人会冒着风险说服别人在第一天就透露他们的角色，希望尽可能多地猜测说实话的人。");
    g_tipLine[11648] = StringToText("· 在第一个白天，杂耍艺人可以对任意玩家的角色进行猜测。当晚，他会得知他猜对的次数……如果他没有被杀害的话。");
    g_tipLine[11649] = StringToText("· 他必须公开猜测，以使所有玩家听到他猜测的内容。他可以猜测零个角色，或者最多猜测五个角色，");
    g_tipLine[11650] = StringToText("  他所猜测的玩家和角色可以相同也可以不同。");
    g_tipLine[11651] = StringToText("· 如果杂耍艺人在醉酒或中毒时做出了猜测，但当晚他的能力触发时却清醒且健康，那么说书人仍然会给他真实的信息。");
    g_tipLine[11652] = StringToText("【范例】");
    g_tipLine[11653] = StringToText("第一个白天，杂耍艺人猜测小明是城镇公告员，小兰是诺-达鲺，小黑是贤者。当晚，杂耍艺人得知「2」，");
    g_tipLine[11654] = StringToText("  这代表他猜对了两个。");
    g_tipLine[11655] = StringToText("第四个夜晚，博学者变成了杂耍艺人。下个白天，新的杂耍艺人猜测小八是麻脸巫婆，小八是女巫，小米是麻脸巫婆。当晚，");
    g_tipLine[11656] = StringToText("  杂耍艺人得知「1」。");
    g_tipLine[11657] = StringToText("【运作方式】");
    g_tipLine[11658] = StringToText("在第一个白天，如果杂耍艺人声明使用他的能力，你需要拿着魔典进入玩家围成的圆圈内。杂耍艺人最多可以做出五次猜测，");
    g_tipLine[11659] = StringToText("  每次猜测选择一名玩家和一个角色。对于每个正确的猜测，放置一枚「猜测正确」提示标记在杂耍艺人角色标记旁。");
    g_tipLine[11660] = StringToText("  （确保其他玩家不会看到你放置了几枚提示标记。）");
    g_tipLine[11661] = StringToText("当晚，唤醒杂耍艺人。对他用手势比划等同于「猜测正确」提示标记的数量（0，1，2 等）。让杂耍艺人重新入睡。");
    g_tipLine[11662] = StringToText("  在稍后说书人方便的时候，移除所有「猜测正确」提示标记以及杂耍艺人的夜晚标记。");
    g_tipLine[11663] = StringToText("如果杂耍艺人猜的太快，让他放慢速度。");
    g_tipLine[11664] = StringToText("如果邪恶玩家伪装成杂耍艺人，在他假装进行猜测时，你可以在魔典中假装四处移动标记来协助他进行伪装。");
    g_tipLine[11665] = StringToText("【提示标记】");
    g_tipLine[11666] = StringToText("· 猜测正确");
    g_tipLine[11667] = StringToText("放置时机：在杂耍艺人宣布公开猜测期间。");
    g_tipLine[11668] = StringToText("放置条件：每当杂耍艺人猜测正确一次，便放置一枚猜测正确标记在杂耍艺人的角色标记旁边。（实际上，");
    g_tipLine[11669] = StringToText("  你也可以放置在魔典中的其他位置，比如猜测正确的对应角色的角色标记旁，有助于说书人进行一些更详细的记录。）");
    g_tipLine[11670] = StringToText("移除时机：在杂耍艺人获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[11671] = StringToText("【规则细节】");
    g_tipLine[11672] = StringToText("· 不建议杂耍艺人在进行猜测时，多次进行所选玩家与角色的猜测组合完全相同的猜测。（如猜测小明是数学家三次。）");
    g_tipLine[11673] = StringToText("  但杂耍艺人仍然可以猜测同一名玩家为不同的角色多次，或猜测多名玩家为同一角色多次。");
    g_tipLine[11674] = StringToText("· 如果杂耍艺人的玩家是新人玩家，说书人可以对他进行宽容处理：在他忘记使用自己的能力的当晚唤醒他，并正常告知他信息。");
    g_tipLine[11675] = StringToText("  此时「0」为正确信息。然而如果是老手玩家，说书人则需要严格进行要求，那名玩家必须要公开声明自己是杂耍艺人之后，");
    g_tipLine[11676] = StringToText("  才能够在夜晚获得信息（即使他公开声明之后不进行任何猜测，也一样能够获得信息）。");
    g_tipLine[11677] = StringToText("· 相克规则：");
    g_tipLine[11678] = StringToText("  · 食人族：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，当晚食人族会替杂耍艺人得知对应的信息。");
    g_tipLine[11679] = StringToText("【提示与技巧】");
    g_tipLine[11680] = StringToText("· 你可以尽可能多的去猜测那些善良角色！你能够确认的善良角色越多，就有越多的善良玩家你们可以信任。");
    g_tipLine[11681] = StringToText("  这也有助于保护你和其他有信息的玩家——你可能会成为首要目标，但是如果还有博学者、卖花女孩等在场时，");
    g_tipLine[11682] = StringToText("  那么恶魔就需要谨慎的做出选择。");
    g_tipLine[11683] = StringToText("· 在没有线索的情况下猜测出邪恶玩家是很困难的，但是如果你能猜测并确认一个邪恶玩家，那么将非常强大。");
    g_tipLine[11684] = StringToText("  如果你打算用这个方式，那么你可以去试着找一个类似筑梦师的角色配合（他可以得到某个人的潜在邪恶角色），");
    g_tipLine[11685] = StringToText("  这在解决镜像双子时也特别有效。");
    g_tipLine[11686] = StringToText("· 猜测一下你能够猜测最多多少个角色——你能够获取5名玩家的信息，你得到的数字会给你很多信息，即使有时候他不是全对。");
    g_tipLine[11687] = StringToText("  得到传说中的5是非常困难的，但是如果你控制好，你将获得5个可以信任的人——这对邪恶队伍将会是致命打击！");
    g_tipLine[11688] = StringToText("· 猜测一小部分的玩家角色，以获得焦点位玩家的角色信息，这对攻击邪恶玩家非常有效，");
    g_tipLine[11689] = StringToText("  但你也可以通过猜测可验证为真实的信息来确定涡流的存在。");
    g_tipLine[11690] = StringToText("· 一个积极主动的杂耍艺人是恶魔的首要目标。考虑找个人和你一起声称杂耍艺人来迷惑恶魔让他找不到真正的杂耍艺人在哪里。");
    g_tipLine[11691] = StringToText("  如果你能够找到贤者和你一起配合这将是非常棒的，因为如果恶魔选错了的话。这对邪恶阵营来说真的是最糟糕的事情。");
    g_tipLine[11692] = StringToText("· 可以说服大家尽可能的表明自己的角色，即使你没有去猜测他们。善良玩家需要依靠信息去推进，");
    g_tipLine[11693] = StringToText("  而你可以促使这点——利用你的能力来让大家的信息早呈现。这样做的好处是，善良队伍可以更好的相互协作，");
    g_tipLine[11694] = StringToText("  而同时恶魔将会没有明确的目标，虽然不管怎样恶魔都会杀人，但是始终会有带着新信息而活着的玩家。");
    g_tipLine[11695] = StringToText("· 猜错了也不完全是坏事，事实上，错误的信息和正确的信息一样有用！如果你没有得到你期望的数字，");
    g_tipLine[11696] = StringToText("  那么可能其中有邪恶玩家，或者有一个类似心上人这样的外来者玩家试图隐藏角色，");
    g_tipLine[11697] = StringToText("  或者甚至能判断出有玩家受到了洗脑师的影响！弄清楚你的数字为什么错了，就会给你们提供到有价值的信息。");
    g_tipLine[11698] = StringToText("· 这条不是针对杂耍艺人的，而是对他的队友说的。如果你怀疑杂耍艺人是伪装的，你可以对他撒谎报一个假的角色，");
    g_tipLine[11699] = StringToText("  看他是否能够发现你，可以用来对抗那些伪装成杂耍艺人的人。（但事后一定要告诉大家）");
    g_tipLine[11700] = StringToText("· 不是所有人都想向你透露角色。这之中通常就会有邪恶玩家——在第一天要自信的进行伪装可能很艰难，尤其对于爪牙而言。");
    g_tipLine[11701] = StringToText("  然而外来者（特别是呆瓜）和像神谕者、城镇公告员等这类的角色也会不情愿过早暴露自己，以避免恶魔把他们当做目标。");
    g_tipLine[11702] = StringToText("  你可以去怀疑那些不愿意透露他们的人，但不要不假思索就判断他们一定是邪恶的。");
    g_tipRoleAt[58] = 11641; g_tipRoleN[58] = 62; g_tipP1At[58] = 11644; g_tipP1N[58] = 8; g_tipP2At[58] = 11671; g_tipP2N[58] = 8;
    g_tipAbility[58] = StringToText("在你的首个白天，你可以公开猜测任意玩家的角色最多五次。在当晚，你会得知猜测正确的角色数量。");
    g_tipLine[11703] = StringToText("【背景故事】");
    g_tipLine[11704] = StringToText("「这书山卷海中一定隐藏着秘密，我非常确信！这些秘密就隐藏在这一字一句之间等待着我们发掘。小子！再帮我多拿点蜡烛！");
    g_tipLine[11705] = StringToText("  还有墨水！虽然这些笔记有些晦涩，但有关恶魔的谜语很快就会被揭晓。」");
    g_tipLine[11706] = StringToText("【角色能力】");
    g_tipLine[11707] = StringToText("如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。");
    g_tipLine[11708] = StringToText("【角色简介】");
    g_tipLine[11709] = StringToText("贤者在活着的时候什么也不知道，但当贤者被恶魔杀死时，他会得知谁是恶魔。");
    g_tipLine[11710] = StringToText("· 贤者只有在被恶魔杀死时才会获取信息，死于处决时不会。");
    g_tipLine[11711] = StringToText("【范例】");
    g_tipLine[11712] = StringToText("第二个夜晚，恶魔杀死了贤者。说书人为贤者指出了两名玩家，其中一名是恶魔。");
    g_tipLine[11713] = StringToText("在最后一夜，恶魔杀死了醉酒的贤者。说书人为贤者指出了一名死亡玩家和剩下的一名存活善良玩家，没有给他正确信息。");
    g_tipLine[11714] = StringToText("麻脸巫婆创造了一名恶魔。因为麻脸巫婆的能力，当晚由说书人来选择杀死谁。说书人决定旧恶魔死亡，贤者也死亡，");
    g_tipLine[11715] = StringToText("  且当晚这些恶魔选择攻击的目标中没有贤者。因为贤者死于麻脸巫婆，而非恶魔，所以贤者不会醒来也不会得知任何信息。");
    g_tipLine[11716] = StringToText("【运作方式】");
    g_tipLine[11717] = StringToText("如果贤者被恶魔杀死，唤醒贤者。指向两名玩家，其中一名是杀死贤者的恶魔。让贤者重新入睡。");
    g_tipLine[11718] = StringToText("如果贤者在游戏前期死亡，你可能会想给贤者展示两名存活玩家，因为这能让邪恶阵营仍然有微弱的获胜机会。");
    g_tipLine[11719] = StringToText("  如果贤者在游戏的最后一个夜晚死去，你可以指向一名存活玩家和一名已死亡的玩家。");
    g_tipLine[11720] = StringToText("【提示标记】");
    g_tipLine[11721] = StringToText("无");
    g_tipLine[11722] = StringToText("【规则细节】");
    g_tipLine[11723] = StringToText("· 相克规则：");
    g_tipLine[11724] = StringToText("  · 陌客：陌客可能会被贤者当作杀死他的恶魔。");
    g_tipLine[11725] = StringToText("  · 利维坦：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果贤者被选择，");
    g_tipLine[11726] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[11727] = StringToText("  · 暴乱：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果贤者被选择，他的能力生效但不会死亡。");
    g_tipLine[11728] = StringToText("【提示与技巧】");
    g_tipLine[11729] = StringToText("· 让自己被恶魔杀死。随便用什么方式，越快越好。如果恶魔杀死了你，你可以得到非常棒的信息，");
    g_tipLine[11730] = StringToText("  所以尽你可能去让恶魔杀死你。你可以装作一个恶魔想要击杀的目标，比如卖花女孩或者博学者，或者保持沉默。");
    g_tipLine[11731] = StringToText("  和希望死的时间越晚越有利的守鸦人不同，你能从更早就死亡中获得更大收益。如果恶魔在前两晚（或前期）杀死了你，");
    g_tipLine[11732] = StringToText("  那么你们就有足够的时间去处决你得到的那两名可能是恶魔的玩家。");
    g_tipLine[11733] = StringToText("· 如果恶魔杀死了你，那么立刻告诉大家你得到的信息。善良玩家越早知道了你是贤者，知道了两名玩家中有一个是恶魔，");
    g_tipLine[11734] = StringToText("  那么你们就越早可以指出谁是恶魔。如果你要等到最后一天再公开信息（正如占卜师可能会在最后一天只能证明活着的某一个两");
    g_tipLine[11735] = StringToText("  玩家不是恶魔一样），你也只能知道其中有一个是恶魔。而且，在这种情况下，你还需要让大家相信你是贤者，");
    g_tipLine[11736] = StringToText("  可能对你们而言已经没有足够的时间了。");
    g_tipLine[11737] = StringToText("· 你也可以就直接公开说自己是贤者，为了活到最后一天。如果你认为大家可以相信你，就告诉大家你是贤者，");
    g_tipLine[11738] = StringToText("  那么恶魔也不会来杀你，而其他玩家会在白天被处决。但是要这么做，至关重要的是要让大家都相信你。");
    g_tipLine[11739] = StringToText("  活到最后就意味着邪恶方不能通过最后活着的三个玩家都是邪恶的来获胜，也意味着在最后三选一时变为二选一。");
    g_tipLine[11740] = StringToText("· 如果你在夜晚死了但是没有获得信息，这也是个不错的消息！虽然你没有发现恶魔是谁，");
    g_tipLine[11741] = StringToText("  但是你知道了只有通过麻脸巫婆的方式导致你死亡才会使你没有得到信息，所以你可以将你确认的信息告诉大家。");
    g_tipRoleAt[59] = 11703; g_tipRoleN[59] = 39; g_tipP1At[59] = 11706; g_tipP1N[59] = 5; g_tipP2At[59] = 11722; g_tipP2N[59] = 6;
    g_tipAbility[59] = StringToText("如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。");
    g_tipLine[11742] = StringToText("【背景故事】");
    g_tipLine[11743] = StringToText("「我不是怪物！我是人！求你了！」");
    g_tipLine[11744] = StringToText("【角色能力】");
    g_tipLine[11745] = StringToText("如果你「疯狂」地证明自己是外来者，你可能被处决。");
    g_tipLine[11746] = StringToText("【角色简介】");
    g_tipLine[11747] = StringToText("畸形秀演员如果试图揭露自己是谁，他就会被处决。");
    g_tipLine[11748] = StringToText("· 「疯狂」是一个术语，意思是「你正在尝试说服他人相信某件事情」。所以，「畸形秀演员‘疯狂’地证明自己是畸形秀演员」");
    g_tipLine[11749] = StringToText("  ，这意味着他正在试图说服他人相信他是畸形秀演员。「他‘疯狂’地证明他是外来者」，");
    g_tipLine[11750] = StringToText("  这意味着他正在试图说服他人相信他是外来者。");
    g_tipLine[11751] = StringToText("· 说服的形式包含口头暗示自己的角色，也包含在自己的角色被质疑时的保持沉默。畸形秀演员是否「疯狂」由说书人来决定。");
    g_tipLine[11752] = StringToText("  如果你认为他正在以任何方式证明自己是一名外来者，你就可以处决他，即使在提名阶段之外，甚至是在晚上都可以处决他。");
    g_tipLine[11753] = StringToText("  如果你这样做，正常情况下这意味今天白天不会再有其他人被处决，因为每个白天只有一次处决。");
    g_tipLine[11754] = StringToText("· 如果畸形秀演员晚上暗示他是畸形秀演员，那么你在当晚可以处决他，即使今天白天已经有人被处决。宣布他的死亡，");
    g_tipLine[11755] = StringToText("  并正常进行夜晚。明天仍然可能发生一场处决。");
    g_tipLine[11756] = StringToText("【范例】");
    g_tipLine[11757] = StringToText("在进入第一个白天十秒后，畸形秀演员向其他玩家说他是畸形秀演员。说书人宣布畸形秀演员被立即处决。");
    g_tipLine[11758] = StringToText("  由于每天最多一次处决，今天无法再提名发起处决。");
    g_tipLine[11759] = StringToText("女巫私下与说书人对话，告诉说书人：小文（小文是畸形秀演员）告诉她说他自己是呆瓜。说书人决定立即处决畸形秀演员。");
    g_tipLine[11760] = StringToText("畸形秀演员告诉其他玩家他是一名镇民，但是不说具体是哪一个角色。其他玩家问他是不是畸形秀演员，畸形秀演员沉默不答。");
    g_tipLine[11761] = StringToText("  经过一分钟左右的沉默，说书人处决了畸形秀演员。");
    g_tipLine[11762] = StringToText("畸形秀演员说他是神谕者，提供了一些捏造的神谕者信息，然后说：「而且我绝对不是畸形秀演员」又附含深意的眨了下眼，");
    g_tipLine[11763] = StringToText("  说书人选择立即处决畸形秀演员。");
    g_tipLine[11764] = StringToText("【运作方式】");
    g_tipLine[11765] = StringToText("在游戏里的任何时间点（包括夜晚），如果你认为畸形秀演员「疯狂」地证明了他是一名外来者，");
    g_tipLine[11766] = StringToText("  那么你就可以决定处决畸形秀演员。向所有人宣布他被处决。并在魔典中为他放置帷幕标记。");
    g_tipLine[11767] = StringToText("如果这次处决发生在白天的常规处决之前，则直接进入到夜晚阶段。（每个白天最多能进行一次处决。）");
    g_tipLine[11768] = StringToText("【提示标记】");
    g_tipLine[11769] = StringToText("无");
    g_tipLine[11770] = StringToText("【提示与技巧】");
    g_tipLine[11771] = StringToText("· 不要承认自己是畸形秀演员，甚至不要承认自己是外来者。当然，很难定义\"承认\"一词。在染·钟楼谜团中，");
    g_tipLine[11772] = StringToText("  我们用\"疯狂\"来代替。这意味着，如果你尝试让任何人相信你是畸形秀演员，说书人可能（也应该）将你立即处决。或者，");
    g_tipLine[11773] = StringToText("  你尝试让大家相信你是外来者，说书人可能（也应该）将你立即处决。这会根据说书人的判断，");
    g_tipLine[11774] = StringToText("  而说书人会根据你想要做的事情而做决定，而不单单是你的说辞。例如，如果你告诉大家\"你可能是畸形秀演员，");
    g_tipLine[11775] = StringToText("  也可能不是\"，那么说书人可能会判断你是试图说服大家相信你是畸形秀演员，然后处决你。或者，");
    g_tipLine[11776] = StringToText("  如果大家在问你是什么角色时你保持沉默，不告诉大家你是什么角色，说书人也可能判断你是在用沉默的方式告诉大家你是畸形秀演员");
    g_tipLine[11777] = StringToText("  ，然后处决你。");
    g_tipLine[11778] = StringToText("· 保持积极，不要沉默。就如上述所言，那些整局游戏都倾向沉默的畸形秀演员很可能被说书人处决。如果你要发言，");
    g_tipLine[11779] = StringToText("  可以挑一个角色来声明，然后尽你可能去说服大家相信你就是这个角色而不是畸形秀演员，那么你基本上就不会被处决。例如，");
    g_tipLine[11780] = StringToText("  如果你在游戏中让大家相信你是神谕者，然后尽可能的给出对的、合理的信息，那么你不会被处决。而且，");
    g_tipLine[11781] = StringToText("  如果恶魔也认为你有威胁然后击杀了你，也很不错！毕竟，如果你在夜晚死亡，");
    g_tipLine[11782] = StringToText("  也意味着其他善良玩家（那些更可能是镇民的玩家）不会死。");
    g_tipLine[11783] = StringToText("· 故意说明自己是畸形秀演员有一些好处与坏处。一方面，如果你被处决了，那么所有人就会相信你是善良玩家。另一方面，");
    g_tipLine[11784] = StringToText("  其他善良玩家对处决是无法掌控的，如果你在一天中过早的被处决，你可以阻碍类似于博学者、");
    g_tipLine[11785] = StringToText("  艺术家或者杂耍艺人使用他们的能力。当然，说书人也可能会简单的决定不去处决你，");
    g_tipLine[11786] = StringToText("  这会让你处于一个无法证实的状态……会让你看起来更像邪恶的。");
    g_tipLine[11787] = StringToText("· 向一两个你相信的玩家秘密的说明自己的角色。然后你就可以去伪装成一个镇民，");
    g_tipLine[11788] = StringToText("  这会让你看起来可疑而且给你带来麻烦（尤其是你给出的信息和其他玩家提供的信息不一致时）。");
    g_tipLine[11789] = StringToText("  尽早承认自己就意味着那些你选择相信的玩家会不考虑你提供的信息并且保护你免受大家处决（此外，得知你的存在，");
    g_tipLine[11790] = StringToText("  对于了解是否方古在场也很有帮助）");
    g_tipLine[11791] = StringToText("· 小心说书人！他会观察你的表现，对他而言可以轻易处决你，并阻碍善良玩家去找到杀死恶魔。");
    g_tipLine[11792] = StringToText("  避免在说书人能听到的范围去表明自己的真实角色，但也要小心向那些可以的邪恶玩家透露自己的角色——他们可能会告诉说书");
    g_tipLine[11793] = StringToText("  人，并用这种方式杀死你。");
    g_tipRoleAt[60] = 11742; g_tipRoleN[60] = 52; g_tipP1At[60] = 11744; g_tipP1N[60] = 12; g_tipP2At[60] = 0; g_tipP2N[60] = 0;
    g_tipAbility[60] = StringToText("如果你「疯狂」地证明自己是外来者，你可能被处决。");
    g_tipLine[11794] = StringToText("【背景故事】");
    g_tipLine[11795] = StringToText("「我永远也忘不掉她……永远……」");
    g_tipLine[11796] = StringToText("【角色能力】");
    g_tipLine[11797] = StringToText("当你死亡时，会有一名玩家开始醉酒。");
    g_tipLine[11798] = StringToText("【角色简介】");
    g_tipLine[11799] = StringToText("心上人死亡的时候，一名玩家会在剩余的游戏时间里醉酒。");
    g_tipLine[11800] = StringToText("· 由说书人选择哪名玩家醉酒。");
    g_tipLine[11801] = StringToText("· 这项能力当心上人死亡时才会被触发。");
    g_tipLine[11802] = StringToText("【范例】");
    g_tipLine[11803] = StringToText("心上人死了。数学家现在醉酒了，并可能在夜晚获得错误信息。");
    g_tipLine[11804] = StringToText("心上人死了。畸形秀演员现在醉酒了。畸形秀演员现在可以安全地透露自己的角色，然而他不知道这一点。");
    g_tipLine[11805] = StringToText("心上人死了。恶魔现在醉酒了，所以他的攻击无法杀死任何人。");
    g_tipLine[11806] = StringToText("【运作方式】");
    g_tipLine[11807] = StringToText("如果心上人死亡，你选择任一玩家醉酒，为他放置「醉酒」提示标记。心上人在死亡时不会失去该能力。");
    g_tipLine[11808] = StringToText("你在选择醉酒玩家时通常都应该选择镇民，这样可以给善良阵营制造些麻烦。但如果邪恶阵营优势巨大，你也可以让外来者，");
    g_tipLine[11809] = StringToText("  爪牙甚至恶魔醉酒。");
    g_tipLine[11810] = StringToText("【提示标记】");
    g_tipLine[11811] = StringToText("· 醉酒");
    g_tipLine[11812] = StringToText("放置时机：当心上人死亡时。");
    g_tipLine[11813] = StringToText("放置条件：心上人死亡，且此时心上人未醉酒中毒，由说书人选择任意一名玩家，并在其角色标记旁放置心上人的「醉酒」");
    g_tipLine[11814] = StringToText("  提示标记。");
    g_tipLine[11815] = StringToText("移除时机：心上人离场时。");
    g_tipLine[11816] = StringToText("【提示与技巧】");
    g_tipLine[11817] = StringToText("· 尽量保证自己不要死亡。你死后会立即导致一个玩家醉酒，使得他们的能力和获得的信息变得不可靠。");
    g_tipLine[11818] = StringToText("  虽然也有可能有邪恶玩家因此醉酒，但是你是外来者，而你的能力通常是影响善良阵营玩家——所以你总是应该假设你会影响那");
    g_tipLine[11819] = StringToText("  些善良阵营的同伴们。");
    g_tipLine[11820] = StringToText("· 你可以伪装成一个恶魔不想攻击的目标。为了增加你的生存概率，你可以声明你是那些恶魔不想去触碰的角色——可以是那些恶魔");
    g_tipLine[11821] = StringToText("  会尽量避开的贤者，或者说是像艺术家和杂耍艺人这样的已经使用了能力的角色。恶魔如果认为你的优先级较低，");
    g_tipLine[11822] = StringToText("  就会去选择其他目标，这样也会使你避免死亡（需要注意的是，你可以秘密的向一两个人透露你的真实角色，");
    g_tipLine[11823] = StringToText("  这样他们就不会被你的任何可能不是真信息的\"信息\"所干扰）。");
    g_tipLine[11824] = StringToText("· 如果你死了，请立即公开你的角色。因为你的能力是在你死后生效，知道你是心上人对于善良阵营的玩家来说非常重要。");
    g_tipLine[11825] = StringToText("  如果你即将被处决，这样做也同样值得——即使你公开之后，恶魔就可能会考虑杀害你，或者从那些有威胁的角色进行击杀，");
    g_tipLine[11826] = StringToText("  例如哲学家这样的更危险的角色。");
    g_tipLine[11827] = StringToText("· 尝试去找出谁在你死后醉酒了。即使死了，你也是有用的——如果能找到那名信息由于你变得不可靠的玩家，");
    g_tipLine[11828] = StringToText("  那么也意味着你们可以知道谁的信息没有因为你而受到影响。");
    g_tipLine[11829] = StringToText("· 小心女巫和洗脑师！恶魔不是唯一可以击杀你的人——一次偶然的提名或者表现的不好很有可能你会在恶魔杀死你之前死去。");
    g_tipLine[11830] = StringToText("  如果你知道这两个爪牙中的任何一个在场，避免引起他们的注意，总之要小心行事。");
    g_tipLine[11831] = StringToText("· 如果必要的话，尽可能活的更久一些。根据游戏的状况（例如还有谁活着），你所造成的醉酒可能会影响很小或者没有影响。");
    g_tipLine[11832] = StringToText("  例如，如果现在还活着的人是中毒的舞蛇人、杂耍艺人、呆瓜和你，那么现在你的死亡比起游戏早期死后可能干扰神谕者、");
    g_tipLine[11833] = StringToText("  城镇公告员这样的能力的角色更安全。");
    g_tipRoleAt[61] = 11794; g_tipRoleN[61] = 40; g_tipP1At[61] = 11796; g_tipP1N[61] = 6; g_tipP2At[61] = 0; g_tipP2N[61] = 0;
    g_tipAbility[61] = StringToText("当你死亡时，会有一名玩家开始醉酒。");
    g_tipLine[11834] = StringToText("【背景故事】");
    g_tipLine[11835] = StringToText("「对了，你以前知不知道，理发师和手术医生其实是同一个职业？不知道？那现在你知道了。」");
    g_tipLine[11836] = StringToText("【角色能力】");
    g_tipLine[11837] = StringToText("如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。");
    g_tipLine[11838] = StringToText("【角色简介】");
    g_tipLine[11839] = StringToText("理发师能允许恶魔交换两名玩家的角色。");
    g_tipLine[11840] = StringToText("· 玩家阵营在交换角色时保持不变。每名玩家都会得知他们变成了什么角色。");
    g_tipLine[11841] = StringToText("· 恶魔可以选择不进行角色交换。");
    g_tipLine[11842] = StringToText("· 如果玩家变成了一个新的角色，他们会获得新角色的能力，包括「在你的首个夜晚」的能力或已经被使用的「每局游戏限一次」");
    g_tipLine[11843] = StringToText("  的能力。");
    g_tipLine[11844] = StringToText("· 如果有两名或者更多的存活恶魔，由说书人选择哪个恶魔来操作交换。");
    g_tipLine[11845] = StringToText("· 恶魔可以选择自己进行角色交换。");
    g_tipLine[11846] = StringToText("· 恶魔不能选择另一名恶魔玩家进行角色交换。");
    g_tipLine[11847] = StringToText("· 如果一名玩家在死亡之后变成了理发师，恶魔不能在当晚交换两个玩家的角色。");
    g_tipLine[11848] = StringToText("【范例】");
    g_tipLine[11849] = StringToText("理发师死了。恶魔本来想要交换钟表匠和杂耍艺人，但随后决定什么都不做。");
    g_tipLine[11850] = StringToText("理发师死了。恶魔交换了存活的神谕者和死亡的理发师。现在，有一名存活的理发师和一名死亡的神谕者。");
    g_tipLine[11851] = StringToText("理发师死了。涡流与一名存活的女巫交换角色。");
    g_tipLine[11852] = StringToText("理发师死了。亡骨魔与死去的心上人交换角色。曾经的亡骨魔现在是邪恶的心上人，游戏本该因此结束，");
    g_tipLine[11853] = StringToText("  但是由于在先前的夜晚里麻脸巫婆创造了一名善良恶魔，游戏继续。");
    g_tipLine[11854] = StringToText("【运作方式】");
    g_tipLine[11855] = StringToText("如果理发师死亡，为他放置「今晚理发」提示标记。");
    g_tipLine[11856] = StringToText("在理发师死亡的夜晚，唤醒一名恶魔玩家。向他展示「该角色的能力对你生效」信息标记，理发师角色标记。恶魔要么摇头，");
    g_tipLine[11857] = StringToText("  要么指向两名玩家。让恶魔重新入睡。移除「今晚理发」。");
    g_tipLine[11858] = StringToText("如果恶魔指向两名玩家，交换那两名玩家的角色标记。然后分别单独唤醒两名被交换的玩家，并展示「你是」信息标记、");
    g_tipLine[11859] = StringToText("  新的角色标记，再让他们重新入睡。如果玩家的新角色标记与其所属阵营颜色不同，将其倒置以代表相反阵营。");
    g_tipLine[11860] = StringToText("如果一名善良玩家变成爪牙或恶魔，或者是一名邪恶的玩家变成镇民或外来者，你可能需要提醒他阵营未改变。");
    g_tipLine[11861] = StringToText("【提示标记】");
    g_tipLine[11862] = StringToText("· 今晚理发");
    g_tipLine[11863] = StringToText("放置时机：当理发师死亡时。");
    g_tipLine[11864] = StringToText("放置条件：理发师死亡，且此时理发师未醉酒中毒，在理发师角色标记旁放置此提示标记。");
    g_tipLine[11865] = StringToText("移除时机：当理发师的能力触发，且恶魔执行了交换效果（或放弃交换）后。");
    g_tipLine[11866] = StringToText("【规则细节】");
    g_tipLine[11867] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[11868] = StringToText("  · 梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_tipLine[11869] = StringToText("【提示与技巧】");
    g_tipLine[11870] = StringToText("· 尽量不要让自己死亡。你死后会给邪恶团队带来巨大的收益——他们可以用你的交换能力做出很多选择来尽可能的削弱善良阵营");
    g_tipLine[11871] = StringToText("  玩家。");
    g_tipLine[11872] = StringToText("· 伪装成一个恶魔不想击杀的目标。为了增加你的存活机会，你可以说自己是那些恶魔不想去击杀的角色——比如像贤者这样的角色");
    g_tipLine[11873] = StringToText("  ，恶魔肯定会尽量避开，或者说是像艺术家和杂耍艺人这样的已经使用了能力的角色。恶魔如果认为你的优先级较低，");
    g_tipLine[11874] = StringToText("  就会去选择其他目标，这样也会使你避免死亡（需要注意的是，你可以秘密的向一两个人透露你的真实角色，");
    g_tipLine[11875] = StringToText("  这样他们就不会被你的任何可能不是真信息的\"信息\"所干扰）。");
    g_tipLine[11876] = StringToText("· 如果你死了，你应该告诉大家，当然也可以不用立即公布。重要的是要让大家知道理发师的交换发生了，如果你等待一段时间，");
    g_tipLine[11877] = StringToText("  善良玩家可能会出来说他们被改变了角色。如果这个时候你告诉大家你的角色，那么你看起来会更值得信任。");
    g_tipLine[11878] = StringToText("· 在有些时候，故意去死也是可行的——比如说，如果你知道所有的邪恶玩家都是谁，而你确定大部分的邪恶玩家都死了。");
    g_tipLine[11879] = StringToText("  这就会使最难发现的理发师交换情况不会发生（两个邪恶的玩家交换角色），");
    g_tipLine[11880] = StringToText("  这也意味着恶魔更有可能会尝试交换善良玩家角色（从而确认你的角色），或者选择不发动交换（最小化对游戏的影响）。");
    g_tipLine[11881] = StringToText("· 如果你是善良玩家，然后在理发师死去的那晚角色发生变化，最好尽快的告诉大家，因为可以因此确认理发师的存在，");
    g_tipLine[11882] = StringToText("  也可以帮助你找到和你交换角色的玩家。除非你和一个邪恶玩家交换了角色，否则和你换的玩家也会想要站出来，");
    g_tipLine[11883] = StringToText("  所以你可以知道你可以信任那个玩家。");
    g_tipLine[11884] = StringToText("· 帮帮我，我是恶魔，刚刚理发师死了，我该怎么做！理发师的能力是非常通用且强大的，但他使用起来很困难，");
    g_tipLine[11885] = StringToText("  尤其是你在意外的情况下杀死了他！以下是一些可以考虑的选项：");
    g_tipLine[11886] = StringToText("  · 交换两个邪恶玩家。通常情况下，你可以这样来转移恶魔，从而使所有的善良玩家（卖花女孩、博学者甚至是筑梦师）");
    g_tipLine[11887] = StringToText("    的信息无效。一个适当时机的恶魔转移可以将善良玩家无法追踪。");
    g_tipLine[11888] = StringToText("  · 交换两个善良玩家！记住你可以交换活着的玩家和死亡的玩家，你可以用这个能力来解决一些麻烦的角色，");
    g_tipLine[11889] = StringToText("    比如哲学家或者贤者或者其他的角色……只需要简单的把刚死去的理发师和他们交换。");
    g_tipLine[11890] = StringToText("    你也可以把一个已知的畸形秀演员和其他玩家交换，这样他们无法轻易的证实他们被交换了。最后，");
    g_tipLine[11891] = StringToText("    你可以随机选择两个玩家交换以制造更多的混乱！注意：善良玩家会知道他们被交换了，");
    g_tipLine[11892] = StringToText("    而且善良玩家会知道被交换玩家的角色，所以会变得更信任对方。确保这样做是值得的。");
    g_tipLine[11893] = StringToText("  · 交换一个邪恶玩家和一个善良玩家。通常这不是一个好的主意，因为一个有着邪恶能力的善良玩家会对你们产生影响。");
    g_tipLine[11894] = StringToText("    例如一个善良女巫或者善良的洗脑师，对你们来说会很危险。然而，这对双方而言都是如此，");
    g_tipLine[11895] = StringToText("    善良玩家可能会决定去处决那些变为邪恶角色的善良玩家，并且对此讨论这种情况。这是双向的。");
    g_tipLine[11896] = StringToText("    如果邪恶队伍得到善良玩家的能力可以用来对付他们，那也可能会是具有毁灭性的。例如，一个邪恶玩家变为心上人、");
    g_tipLine[11897] = StringToText("    哲学家或者舞蛇人就非常棒。");
    g_tipLine[11898] = StringToText("  · 有些时候，你可以在理发师死后选择什么都不做。如果你没有好的角色决定去换，而且觉得目前的邪恶玩家的角色都还不错，");
    g_tipLine[11899] = StringToText("    你可以什么都不做。由于没有产生影响，这也会使你受益。要么会让理发师看起来在撒谎，");
    g_tipLine[11900] = StringToText("    要么让大家以为恶魔和爪牙之间交换了角色。不管怎么样，这些都是错误的信息，同样可以干扰善良队伍并分散他们的注意力。");
    g_tipRoleAt[62] = 11834; g_tipRoleN[62] = 67; g_tipP1At[62] = 11836; g_tipP1N[62] = 12; g_tipP2At[62] = 11866; g_tipP2N[62] = 3;
    g_tipAbility[62] = StringToText("如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。");
    g_tipLine[11901] = StringToText("【背景故事】");
    g_tipLine[11902] = StringToText("「哎哟！」");
    g_tipLine[11903] = StringToText("【角色能力】");
    g_tipLine[11904] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。");
    g_tipLine[11905] = StringToText("【角色简介】");
    g_tipLine[11906] = StringToText("呆瓜可能会导致他的阵营突然落败，除非他很聪明。");
    g_tipLine[11907] = StringToText("· 当呆瓜死亡时，他必须公开选择一名玩家。他可能需要花几分钟来做决定——毕竟，这是一个大决定，");
    g_tipLine[11908] = StringToText("  而且其他玩家可以向他提供建议，但最终决定始终由呆瓜来做出。如果他选择了一名邪恶玩家，那游戏就立即结束，");
    g_tipLine[11909] = StringToText("  善良阵营落败。如果他选择了一名善良玩家，无事发生，游戏继续。");
    g_tipLine[11910] = StringToText("· 说书人没有义务提醒呆瓜公开表明自己的角色并选择一名玩家。呆瓜必须在他得知自己死亡后，尽快去这样做。");
    g_tipLine[11911] = StringToText("  故意不这样做会被认为是作弊。");
    g_tipLine[11912] = StringToText("【范例】");
    g_tipLine[11913] = StringToText("呆瓜死于处决。经过一番争吵，呆瓜选择了一名玩家，而该玩家是善良的女裁缝。夜幕降临，游戏继续。");
    g_tipLine[11914] = StringToText("恶魔杀死了呆瓜玩家小莱。当说书人在黎明宣布小莱死亡后，小莱说「所有人注意了，我是呆瓜，」在讨论几分钟后，");
    g_tipLine[11915] = StringToText("  小莱公开选择了一名玩家，而该玩家是邪恶的恶魔，游戏立即结束，邪恶方获胜，而且笑得很大声。");
    g_tipLine[11916] = StringToText("【运作方式】");
    g_tipLine[11917] = StringToText("当呆瓜玩家被宣布死亡时，他必须宣布他是呆瓜，然后选择一名存活玩家（给他足够的时间）。如果他选择了一名邪恶玩家，");
    g_tipLine[11918] = StringToText("  游戏结束，邪恶阵营获胜。如果他选择了一名善良玩家，游戏继续。");
    g_tipLine[11919] = StringToText("在特殊情况下，当属于邪恶阵营的呆瓜选择了一名邪恶玩家也会导致游戏结束，并且改为善良阵营获胜。");
    g_tipLine[11920] = StringToText("如果呆瓜玩家没有意识到他必须在死亡时选择一名玩家，私下提醒他。新手玩家可能不明白他的角色如何运作。");
    g_tipLine[11921] = StringToText("【提示标记】");
    g_tipLine[11922] = StringToText("无");
    g_tipLine[11923] = StringToText("【提示与技巧】");
    g_tipLine[11924] = StringToText("· 就像梦殒春宵中几乎所有的外来者一样，你应该尽可能地避免死亡。如果你使用不当你的能力，那非常糟糕，");
    g_tipLine[11925] = StringToText("  因为它可能会直接结束游戏，但是只有当你真正死亡的时候，它才会成为一个问题！");
    g_tipLine[11926] = StringToText("· 如果好人团队举步维艰，你可以慷慨赴死，通过选择他们来确定一个人是善良阵营的。你的能力会产生非常强大的信息，");
    g_tipLine[11927] = StringToText("  但是这伴随着相当大的风险。确信某人是好人可以让你完全信任他们，这在这个剧本中是非常罕见的事情！和舞蛇人相似的是，");
    g_tipLine[11928] = StringToText("  你的能力也不会被涡流干扰，这意味着就算你怀疑他存在场上，也不必担心你的信息会是虚假的。（ 注意：");
    g_tipLine[11929] = StringToText("  虽然这听起来非常有用，甚至很诱人，但是请记住，不够小心的选择你就会直接输掉这场游戏！）");
    g_tipLine[11930] = StringToText("· 在你死亡之前，和其他玩家一起努力寻找一个你认为他是善良阵营的玩家，以防止你意外的死亡了。");
    g_tipLine[11931] = StringToText("  （在你死亡之前是否向这个玩家透露你的角色，这取决于你自己——如果你这么做，");
    g_tipLine[11932] = StringToText("  他们可能会在你们都活着的时候更倾向于信任你。如果你不这么做，你的选择会更令人惊讶，");
    g_tipLine[11933] = StringToText("  但是这会看起来你与那个玩家的勾结会更少。这一切都取决于团队目前的倾向。）");
    g_tipLine[11934] = StringToText("· 不要选择一名和别人角色重复的玩家——在大多数情况下，角色重复意味着两个玩家中的一个是邪恶的，");
    g_tipLine[11935] = StringToText("  这给了你50%的机会去输掉这场游戏！这包括镜像双子和他的善良双胞胎，因为很难确定他们哪一个是真正的邪恶。");
    g_tipLine[11936] = StringToText("  你应该选择的目标是场上唯一的角色。");
    g_tipLine[11937] = StringToText("· 如果大家想要处决你，你可以在投票前大声宣布你死亡后将选择哪位玩家作为呆瓜。如果大家认为这个玩家是邪恶的，");
    g_tipLine[11938] = StringToText("  他们就不太可能处决你，这有助于善良团队继续下去这个游戏。如果恶魔那天晚上没有杀你，那可能意味着恶魔不想杀你，");
    g_tipLine[11939] = StringToText("  因为他知道你无论如何选的玩家都是善良阵营的。");
    g_tipLine[11940] = StringToText("· 如果你死亡了，并且选择了一个玩家，而游戏并没有结束，你几乎可以肯定那名玩家是个善良的玩家。既然呆瓜不受涡流、");
    g_tipLine[11941] = StringToText("  诺-达鲺的影响，也可能不受心上人或者哲学家影响，那么你可以放心地假设你没有醉酒或者中毒。");
    g_tipRoleAt[63] = 11901; g_tipRoleN[63] = 41; g_tipP1At[63] = 11903; g_tipP1N[63] = 9; g_tipP2At[63] = 0; g_tipP2N[63] = 0;
    g_tipAbility[63] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。");
    g_tipLine[11942] = StringToText("【背景故事】");
    g_tipLine[11943] = StringToText("「我不是小美！我是小梅！她才是小美！小美才是那个坏人，不是我！」");
    g_tipLine[11944] = StringToText("【角色能力】");
    g_tipLine[11945] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。");
    g_tipLine[11946] = StringToText("如果其中善良玩家被处决，邪恶阵营获胜。");
    g_tipLine[11947] = StringToText("如果你们都存活，善良阵营无法获胜。");
    g_tipLine[11948] = StringToText("【角色简介】");
    g_tipLine[11949] = StringToText("镜像双子会与对立阵营一人互为镜像，其他玩家不知道双子的正邪。");
    g_tipLine[11950] = StringToText("· 由说书人来选择镜像双子与一名对立阵营玩家配对，被选择的玩家是对立双子。");
    g_tipLine[11951] = StringToText("· 在首个夜晚，双子两人会被一同唤醒，并得知对方的角色。");
    g_tipLine[11952] = StringToText("· 如果双子中善良一方被处决，邪恶阵营获胜。如果邪恶一方被处决，游戏继续。死去的镜像双子会失去能力，");
    g_tipLine[11953] = StringToText("  如果在他死后处决善良双子，邪恶阵营不会获胜。");
    g_tipLine[11954] = StringToText("· 两个双子都存活时善良阵营无法获胜。此时即使恶魔死亡，游戏也会继续。善良阵营要杀死镜像双子以取得胜利。");
    g_tipLine[11955] = StringToText("· 如果一名善良玩家变成了镜像双子，他仍然是善良玩家，此时一名邪恶玩家成为他的对立双子。");
    g_tipLine[11956] = StringToText("  另一个双子是什么角色并不重要，真正重要的是他们的阵营，好人可以安全处决邪恶的双子，但如果处决的是善良的双子，");
    g_tipLine[11957] = StringToText("  邪恶阵营获胜。");
    g_tipLine[11958] = StringToText("· 如果两个双子都是相同阵营，则由说书人为镜像双子重新选择一名玩家成为对立双子。");
    g_tipLine[11959] = StringToText("【范例】");
    g_tipLine[11960] = StringToText("两个双子都声称是神谕者。邪恶双子被处决，游戏继续。");
    g_tipLine[11961] = StringToText("对立双子和镜像双子都大声地声称自己是艺术家。他们都私下拜访说书人并询问了一个问题。善良玩家稀里糊涂地处决了恶魔。");
    g_tipLine[11962] = StringToText("  游戏继续，从现在开始，夜晚没有人死亡。");
    g_tipLine[11963] = StringToText("麻脸巫婆将善良的贤者变成镜像双子。对立双子是一名邪恶的女巫。善良的双子被处决，邪恶阵营胜利。");
    g_tipLine[11964] = StringToText("【运作方式】");
    g_tipLine[11965] = StringToText("初始设置时，在一名善良玩家的角色标记旁放置「对立双子」提示标记以表示他是与镜像双子阵营对立的双子。");
    g_tipLine[11966] = StringToText("在首个夜晚，同时唤醒两名双子。指向邪恶双子，并对善良双子展示邪恶双子的角色标记。指向善良双子，");
    g_tipLine[11967] = StringToText("  并对邪恶双子展示善良双子的角色标记。让他们重新入睡。");
    g_tipLine[11968] = StringToText("只要两个双子都存活，善良阵营就无法获胜。如果善良的双子被处决，邪恶阵营获胜。");
    g_tipLine[11969] = StringToText("如果麻脸巫婆在最后一夜创造了一个镜像双子，你可以选择恶魔或一名死亡的玩家作为对立双子，这样的话，");
    g_tipLine[11970] = StringToText("  善良玩家仍然有机会获胜。");
    g_tipLine[11971] = StringToText("选择旅行者作为对立双子通常不是好主意。");
    g_tipLine[11972] = StringToText("【提示标记】");
    g_tipLine[11973] = StringToText("· 对立双子");
    g_tipLine[11974] = StringToText("放置时机：为首个夜晚做准备时；或当前对立双子与镜像双子同一阵营时；或有新的镜像双子被创造出来时。");
    g_tipLine[11975] = StringToText("放置条件：当需要放置此提示标记时，选择与当前的镜像双子对立阵营的任意一名玩家，在其角色标记旁放置。");
    g_tipLine[11976] = StringToText("移除时机：镜像双子死亡或离场时。");
    g_tipLine[11977] = StringToText("【规则细节】");
    g_tipLine[11978] = StringToText("· 在游玩梦殒春宵剧本时，以上述运作方式来唤醒镜像双子与对立双子是没有任何问题的，");
    g_tipLine[11979] = StringToText("  但是这一方式在扩展到其他混合剧本的时候可能会出现问题。（例如镜像双子被传教士影响，");
    g_tipLine[11980] = StringToText("  或有涡流在场时炼金术士获得了镜像双子的能力，等等。）我们建议说书人在熟悉镜像双子的角色能力逻辑之后，");
    g_tipLine[11981] = StringToText("  分别单独唤醒镜像双子和其对立双子，并用原本的提示方式对两名玩家单独进行提示，而不是让他们进行眼神接触来确认。");
    g_tipLine[11982] = StringToText("· 相克规则：");
    g_tipLine[11983] = StringToText("  · 瘟疫医生：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[11984] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[11985] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[11986] = StringToText("  · 梼杌：镜像双子在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[11987] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[11988] = StringToText("  · 姑获鸟：如果姑获鸟获得了镜像双子的能力，新对立双子会知道「姑获鸟在场」，但不会知道姑获鸟是谁。");
    g_tipLine[11989] = StringToText("【提示与技巧】");
    g_tipLine[11990] = StringToText("· 说善良的镜像双子是邪恶的镜像双子，说善良的镜像双子是邪恶的镜像双子，");
    g_tipLine[11991] = StringToText("  说善良的镜像双子是邪恶的镜像双子（重要的事情说三遍）。毕竟，真正善良的镜像双子一定会这么做！");
    g_tipLine[11992] = StringToText("· 声称你和另一个镜像双子是同一个角色。在首个夜晚，你会得知另一个善良双子的角色，同样，他也会得知你的角色。");
    g_tipLine[11993] = StringToText("  这对你来说是一个提示，这可以让你明确的得知哪个角色可以伪装。显然，当你伪装成这个角色时，");
    g_tipLine[11994] = StringToText("  另一个镜像双子也会声称自己就是这个角色，所以你要比他看起来更像这个角色。然而，");
    g_tipLine[11995] = StringToText("  既然另一个镜像双子无论如何都会大喊你是邪恶的，那么你们两个声称自己是同一个角色话就不会有人你的角色进一步指控你了");
    g_tipLine[11996] = StringToText("  。事实上，这样伪装是最安全的，那么如果你选择去伪装另一个角色，而这个角色已经在游戏中，");
    g_tipLine[11997] = StringToText("  那么这名善良阵营的角色会明确知道你是邪恶的。例如，善良的镜像双子是钟表匠，邪恶的镜像双子也声称自己是钟表匠，");
    g_tipLine[11998] = StringToText("  那么即使善良的玩家知道其中一个钟表匠是邪恶的，但不知道是哪一个。但在一局游戏中，善良的镜像双子是呆瓜，");
    g_tipLine[11999] = StringToText("  邪恶的镜像双子声称自己是杂耍艺人，而真正的杂耍艺人揭露了他们是谁，");
    g_tipLine[12000] = StringToText("  因为善良的玩家知道镜像双子中的一个一定是邪恶的，所以他们就会处决自称是杂耍艺人的那一个。");
    g_tipLine[12001] = StringToText("· 要时刻充满激情，不要放松。有时候，一个善良的玩家死去了是完全可以的（因为他的死亡并不关键，");
    g_tipLine[12002] = StringToText("  甚至可以通过死亡试图证明自己是善良的，减少对善良团队的干扰），所以一个邪恶的玩家装酷，模仿善良玩家的状态，");
    g_tipLine[12003] = StringToText("  假装不在乎被处决也是完全可以的。但是！假装自己是善良的镜像双子可不是这样的。一旦处决了善良的镜像双子，");
    g_tipLine[12004] = StringToText("  就会导致比赛结束，邪恶势力获胜，所以每当善良的镜像双子将要被处决时，善良的镜像双子总是会非常大声激烈的争论，");
    g_tipLine[12005] = StringToText("  坚持他们在任何情况下都不能被处决。他们的处境很像圣徒，这会给你带来很大的麻烦。因此，");
    g_tipLine[12006] = StringToText("  任何对被处决时表示消极甚至放任不管的邪恶镜像双子，都可能会被处决，");
    g_tipLine[12007] = StringToText("  因为一个善良的镜像双子会对你的状态表示更加的抗议。");
    g_tipLine[12008] = StringToText("· 有一种策略（当然这种策略通常不是很好），就是否认一切。坚持说明本场不存在镜像双子。");
    g_tipLine[12009] = StringToText("  并声称指控你是邪恶镜像双子的玩家是在撒谎。要注意这种策略很少奏效，因为这会使善良的团队面临着一个两难的境地，");
    g_tipLine[12010] = StringToText("  而这个困境有一个看起来「非常棒」的解决方案。要么他们相信善良的镜像双子说的是实话，");
    g_tipLine[12011] = StringToText("  然后处决你（杀死一个爪牙或杀死一个普通的好人），要么他们不相信善良的镜像双子说的是实话，");
    g_tipLine[12012] = StringToText("  然后处决他（杀死一个爪牙或杀死一个善良的镜像双子，但这会使结束游戏，让邪恶阵营获胜）。");
    g_tipLine[12013] = StringToText("  由于处决指控你的善良镜像双子的风险很高，自作聪明的玩家几乎总是会把你当作更安全的选择来处决。");
    g_tipLine[12014] = StringToText("· 尽你所能的扮演好镜像双子。提供虚假信息，表明你的邪恶团队所说出的信息是真实的。你可以提供真实的信息，");
    g_tipLine[12015] = StringToText("  让你看起来更可信。提出你需要的任何论点，让善良阵营的玩家相信善良的镜像双子其是邪恶的镜像双子。如果他被处决，");
    g_tipLine[12016] = StringToText("  邪恶就会获胜。");
    g_tipLine[12017] = StringToText("· 同样，如果你是一个邪恶的其他玩家，而不是邪恶的镜像双子，那么尽你所能支持你的队友，让善良的镜像双子看起来可疑。");
    g_tipLine[12018] = StringToText("  提供虚假信息，表明善良的镜像双子是邪恶的。如果情况允许，你有时可以提供真实的信息，");
    g_tipLine[12019] = StringToText("  让善良的镜像双子看起来邪恶（例如，如果玩家们认为本局有涡流存在，你可以说你是艺术家，");
    g_tipLine[12020] = StringToText("  并且知道邪恶的镜像双子是邪恶的）。支持邪恶的镜像双子，并为处决善良镜像双子展开你的活动。");
    g_tipLine[12021] = StringToText("· 如果你是恶魔，可以在某个阶段的夜晚停止杀戮，假装恶魔在那天被处决。通常情况下，镜像双子都存在于场上，");
    g_tipLine[12022] = StringToText("  此时如果恶魔被处决，游戏将继续（邪恶镜像双子的能力是当两个镜像双子都活着的时候，「善良阵营不能赢」）。因此，");
    g_tipLine[12023] = StringToText("  当恶魔被处决时，夜间阶段继续进行，没有任何死亡，「优秀」的玩家很快就知道恶魔是昨天被处决的玩家。那么，");
    g_tipLine[12024] = StringToText("  如果你还活着，并且选择攻击夜间死亡的玩家，这会让人觉得恶魔已经被处决了。");
    g_tipLine[12025] = StringToText("  最后一个被处决的可怜朋友将是唯一的嫌疑人！");
    g_tipLine[12026] = StringToText("· 如果你是恶魔，并且场上存在镜像双子，那么你可以随意尝试更冒险的操作，即使你可能无法成功。因为一旦你死了，");
    g_tipLine[12027] = StringToText("  游戏还会继续，那么如果你被处决，也并不会邪恶阵营的落败，那么你的存活与否比起其他情况来说显得就不那么重要。所以，");
    g_tipLine[12028] = StringToText("  在一局游戏中，有一对镜像双子在场，并且你通常不自信的话，这可能是一个很好的机会，让你伪装成为博学者或筑梦师、");
    g_tipLine[12029] = StringToText("  舞蛇人或卖花女孩。");
    g_tipLine[12030] = StringToText("· 有一种罕见的情况，如果游戏中没有镜像双子，那么两个邪恶玩家都可以虚张声势地扮演镜像双子。");
    g_tipLine[12031] = StringToText("  如果双方都声称自己是镜像双子，那么好的玩家会假设其中一个是邪恶的镜像双子，并最终处决其中一个。");
    g_tipLine[12032] = StringToText("  既然两个玩家都声称自己是善良的镜像双子，而且都声称另一个是邪恶的镜像双子，");
    g_tipLine[12033] = StringToText("  那么很有可能会在游戏过程中其中一位被玩家们处决，那么这样一来，邪恶的团队需要想办法保护其中一个更加重要的队友，");
    g_tipLine[12034] = StringToText("  那么另一名伪装成善良镜像双子的玩家就必须表现出更可疑。在《梦殒春宵》中，要伪装地在游戏中体现处有镜像双子，");
    g_tipLine[12035] = StringToText("  可能需要真正的爪牙不要以明显的方式使用他们的能力。例如，如果游戏中只有一个爪牙，而你声称这个爪牙是一个镜像双子，");
    g_tipLine[12036] = StringToText("  但一个玩家死于女巫的诅咒，那么每个人都会知道你在撒谎。");
    g_tipLine[12037] = StringToText("· 除了以上的情况，还有一种方式，如果游戏中没有镜像双子，邪恶玩家可以虚张声势称自己为善良的镜像双子，");
    g_tipLine[12038] = StringToText("  并声称某个特定的善良玩家就是邪恶镜像双子。当然，这个玩家可能会无视你，也不会去解释他们是否为善良的镜像双子，");
    g_tipLine[12039] = StringToText("  所以要小心。然而，如果你伪装的很好，你可能会让那个玩家被处决，并让他们在剩下的比赛中看起来依然邪恶（也让你看起来");
    g_tipLine[12040] = StringToText("  依然善良）。在《梦殒春宵》中，要虚张声势地说游戏中有邪恶的镜像双子，");
    g_tipLine[12041] = StringToText("  可能需要真正的爪牙不要以明显的方式使用他们的能力。例如，如果游戏中只有一个爪牙，");
    g_tipLine[12042] = StringToText("  而你声称这个爪牙是一个邪恶的双胞胎，但一个玩家死于洗脑师的疯狂，那么每个人都会知道你在撒谎。");
    g_tipLine[12043] = StringToText("【对抗镜像双子】");
    g_tipLine[12044] = StringToText("· 如果两个玩家声称对方是邪恶的镜像双子，那么你可以放心地假设有一个邪恶的镜像双子在游戏中。");
    g_tipLine[12045] = StringToText("  如果在这个游戏中只有一个爪牙，你就知道你不会受到女巫、洗脑师和麻脸巫婆的伤害。");
    g_tipLine[12046] = StringToText("· 一旦你确定一个邪恶的镜像双子存在于游戏中，比如一旦有两个玩家声称对方是邪恶的镜像双子，");
    g_tipLine[12047] = StringToText("  那么就不必急于处决他们中的任何一个。如果你在游戏的早期做出了一个愚蠢的决定，并处决了错误的镜像双子，");
    g_tipLine[12048] = StringToText("  那么善良阵营会输掉游戏。最好至少等几天，甚至到比赛的最后三选一环节，再选择执行处决那一对双子。到那时，");
    g_tipLine[12049] = StringToText("  你将拥有尽可能多的信息来做出决定。");
    g_tipLine[12050] = StringToText("· 善良阵营必须处死邪恶的镜像双子，善良阵营才有机会获胜。而且他们决不能处决善良的镜像双子，否则他们立刻就输了。");
    g_tipLine[12051] = StringToText("  作为一个团队，要注意不要把你全部的大部分注意力和演绎技巧放在找出哪个镜像双子是邪恶上。");
    g_tipLine[12052] = StringToText("  因为这样可能会导致你忽略恶魔是谁的问题，直到你发现邪恶的镜像双子是谁。如果你杀死了恶魔，游戏仍将继续，");
    g_tipLine[12053] = StringToText("  你还需要处决邪恶的镜像双子才能获胜。但如果邪恶的镜像双子和恶魔都还活着，而只剩下3名玩家，邪恶就会获胜，");
    g_tipLine[12054] = StringToText("  所以你需要判断是否要在处决恶魔之前优先解决镜像双子的问题。");
    g_tipLine[12055] = StringToText("· 比较两个镜像双子的信息，以确定哪个镜像双子是善良的。如果这对镜像双子都声称是艺术家，但给出了相互矛盾的信息，");
    g_tipLine[12056] = StringToText("  那么按照他们的说法，看看你是否能确定哪一个是真的。邪恶的镜像双子是在撒谎的人。");
    g_tipLine[12057] = StringToText("  如果两个镜像双子都声称自己是杂耍艺人，但他们的信息冲突，看看你能否确定哪个镜像双子的信息是准确的。");
    g_tipLine[12058] = StringToText("  真正杂耍艺人应该是拥有准确信息的人。");
    g_tipLine[12059] = StringToText("· 某些镇民角色可以直接帮助优秀的团队找出哪个镜像双子是邪恶的。城镇公告员可以发现邪恶的镜像双子何时发起了提名。");
    g_tipLine[12060] = StringToText("  杂耍艺人可以猜到谁是邪恶的镜像双子，并在那天晚上知道他们是否正确。");
    g_tipLine[12061] = StringToText("  女裁缝可以确定双子是否与其他非双子角色为相同阵营。钟表匠可能会获得恶魔可能是谁的信息（基于恶魔与邪恶镜像双子的接");
    g_tipLine[12062] = StringToText("  近程度），然后对这些信息进行反向推理，以找出邪恶的镜像双子是谁。艺术家可以直接提问。然而，如果你是筑梦师，");
    g_tipLine[12063] = StringToText("  不要选择梦见任何个镜像双子，任何一个称职的说书人都会告诉你，玩家要么是邪恶的镜像双子，要么就是他们声称的角色。");
    g_tipLine[12064] = StringToText("· 如果只有一个人指控一名其他玩家是邪恶的镜像双子，那么信任原告，而不是被告。");
    g_tipLine[12065] = StringToText("  大多数邪恶的镜像双子也会声称他们的原告是邪恶的镜像双子，但并非总是如此。");
    g_tipLine[12066] = StringToText("  在只有一个玩家指控另一个玩家是邪恶镜像双子的情况下，你面临着一个选择：要么相信原告说的是实话，要么杀死被告，");
    g_tipLine[12067] = StringToText("  可能的后果是你杀死了一个爪牙；或者，你可以相信被告说的是实话，然后处决原告，那这样可能导致你输掉比赛。");
    g_tipLine[12068] = StringToText("  杀死原告太危险了，至少在你有确凿的证据之前是这样的，所以如果你必须杀死其中一人，可以优先考虑处决被告。");
    g_tipLine[12069] = StringToText("· 当夜间杀戮停止时，几乎可以肯定你已经处决了恶魔。既然游戏在恶魔死亡时继续（邪恶的镜像双子活着时，");
    g_tipLine[12070] = StringToText("  镜像双子的能力会让善良的阵营无法获胜），那么一旦杀戮停止，恶魔很可能就死了。最近被处决的玩家，");
    g_tipLine[12071] = StringToText("  几乎可以肯定是恶魔，恶魔会在夜晚进行杀戮，但现在他已经死了，他不能再这样做了。");
    g_tipRoleAt[64] = 11942; g_tipRoleN[64] = 130; g_tipP1At[64] = 11944; g_tipP1N[64] = 15; g_tipP2At[64] = 11977; g_tipP2N[64] = 12;
    g_tipAbility[64] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。如果其中善良玩家被处决，邪恶阵营获胜。如果你们都存活，善良阵营无法获胜。");
    g_tipLine[12072] = StringToText("【背景故事】");
    g_tipLine[12073] = StringToText("「山羊之血，三滴落下。一绺头发，怒意迸发。名字被说出，阴影被放大。左脚踏上荆棘路，莫要回头看它。」");
    g_tipLine[12074] = StringToText("【角色能力】");
    g_tipLine[12075] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipLine[12076] = StringToText("【角色简介】");
    g_tipLine[12077] = StringToText("女巫能诅咒玩家，被诅咒的玩家如果发起提名，就会被咒杀。");
    g_tipLine[12078] = StringToText("· 每个夜晚，女巫会选择一名玩家诅咒。那名玩家如果在下个白天提名了任何玩家，就会死亡。尽管如此，他的提名仍然生效。");
    g_tipLine[12079] = StringToText("· 女巫的诅咒只持续一个白天，但女巫可以每晚一次又一次地诅咒同一名玩家。");
    g_tipLine[12080] = StringToText("· 只剩三名玩家存活时，女巫的诅咒立即解除，女巫也无法再进行夜晚行动。");
    g_tipLine[12081] = StringToText("【范例】");
    g_tipLine[12082] = StringToText("夜晚，女巫诅咒了贤者。下个白天，贤者提名了筑梦师。说书人立即宣布贤者死亡。玩家仍然投票给筑梦师，");
    g_tipLine[12083] = StringToText("  随后筑梦师也死于处决。");
    g_tipLine[12084] = StringToText("女巫诅咒了自己。下个白天，女巫提名恶魔并死亡。玩家对是否要处决恶魔进行投票，但票数未过半，提名继续。");
    g_tipLine[12085] = StringToText("女巫诅咒了呆瓜。方古攻击了呆瓜，所以呆瓜变成了方古。新的方古现在被诅咒，他发起了提名，然后新的方古死了，");
    g_tipLine[12086] = StringToText("  善良阵营胜利。");
    g_tipLine[12087] = StringToText("女巫诅咒了博学者。当晚，在恶魔杀死一名玩家后，只剩三名玩家存活，所以诅咒被移除。博学者可以安全提名。");
    g_tipLine[12088] = StringToText("女巫诅咒了杂耍艺人。下个白天，杂耍艺人发起对旅行者的流放投票。杂耍艺人不会死亡而且还可以提名处决，");
    g_tipLine[12089] = StringToText("  因为女巫的诅咒不影响发起流放。");
    g_tipLine[12090] = StringToText("【运作方式】");
    g_tipLine[12091] = StringToText("每个夜晚，唤醒女巫。让她指向一名玩家。让女巫重新入睡。在被选择的玩家角色标记旁放置「被诅咒」提示标记。下个白天，");
    g_tipLine[12092] = StringToText("  如果被标记为「被诅咒」的玩家发起了提名，立即宣布他死亡。（提名正常进行）");
    g_tipLine[12093] = StringToText("【提示标记】");
    g_tipLine[12094] = StringToText("· 被诅咒");
    g_tipLine[12095] = StringToText("放置时机：在女巫夜晚行动并选择了玩家后。");
    g_tipLine[12096] = StringToText("放置条件：在女巫要诅咒的玩家角色标记旁放置。若此时女巫醉酒中毒，不放置该标记。");
    g_tipLine[12097] = StringToText("移除时机：在黄昏时，或女巫死亡或离场时。");
    g_tipLine[12098] = StringToText("【提示与技巧】");
    g_tipLine[12099] = StringToText("· 选择诅咒哪位玩家是女巫能力的关键，根据你的阵营团队和本局出现在场上的角色的不同，");
    g_tipLine[12100] = StringToText("  意味着将有许多不同的因素会影响你的决定。你的爪牙伙伴们和恶魔都非常强大且具有破坏性，所以，去协调配合他们，");
    g_tipLine[12101] = StringToText("  争取最大程度地干扰善良阵营的玩家。如果不小心诅咒了恶魔当晚选择杀死的人，那将会十分遗憾！");
    g_tipLine[12102] = StringToText("· 喜欢争吵的玩家经常会是女巫的首选的诅咒目标！每当他们听到反对自己的言论时，或听到和自己不同的想法，");
    g_tipLine[12103] = StringToText("  他们就会发起提名并死于女巫的诅咒，这种突发情况常常会毁了他们原本设定好的计划。");
    g_tipLine[12104] = StringToText("· 瞄准你想要死亡的角色。比如像博学者或卖花女孩这类强力的提供信息的角色，");
    g_tipLine[12105] = StringToText("  也包括像呆瓜这种会将善良阵营置于危险中的角色。选择像贤者这类角色也是不错的选择-他们的能力只有在夜晚被恶魔杀死时");
    g_tipLine[12106] = StringToText("  生效，这意味着你的诅咒将使他们无法发动能力并获取应有的信息。");
    g_tipLine[12107] = StringToText("· 一些玩家会对你的把戏了如指掌，并尝试让一些因不活跃而不太容易被女巫选择的玩家去发起提名。");
    g_tipLine[12108] = StringToText("  他们希望能最大限度让隐藏起来的城镇公告员从这些提名中获得的信息。如果你看到了这种趋势或听到了这种讨论，");
    g_tipLine[12109] = StringToText("  就去选择诅咒比较安静的玩家或者没有发起过提名的玩家");
    g_tipLine[12110] = StringToText("· 故意诅咒另一个邪恶的玩家或你自己，让自己看起来是一名善良的玩家。被女巫杀死的玩家通常会被视为好人，");
    g_tipLine[12111] = StringToText("  所以在适当的时候牺牲自己可以让你潜入到善良阵营之中，去散布和加深他们的矛盾。（如果你选择尝试这么做，");
    g_tipLine[12112] = StringToText("  请小心神谕者，他们会发现邪恶阵营 最近的死亡，并因此对你产生怀疑！）");
    g_tipLine[12113] = StringToText("· 隐藏你的角色以支持其他爪牙的角色伪装也是有必要的。当一个女巫的能力被触发时，");
    g_tipLine[12114] = StringToText("  镇民会十分明确本场存在的爪牙中有女巫（玩家提名，然后他立即死亡这是专属女巫的能力）。");
    g_tipLine[12115] = StringToText("  如果你的恶魔和爪牙伪装说自己是镜像双子，那么你的能力一旦被发动将可能破坏这种伪装，并使他们的谎言被戳穿。记住，");
    g_tipLine[12116] = StringToText("  你可以诅咒一个死去的玩家-这将在必要时隐藏你的能力。");
    g_tipLine[12117] = StringToText("【对抗女巫】");
    g_tipLine[12118] = StringToText("· 你只需要在女巫真的在场的前提下小心提名，但你很难在第一天就发现女巫的存在。所以在第一天就要小心提名。");
    g_tipLine[12119] = StringToText("  如果一个玩家在提名时死亡，则证明一定存在女巫，那么你应该持续的小心提名。");
    g_tipLine[12120] = StringToText("· 鼓励团队中较安静的玩家去发起提名。比较安静的玩家，或者很少发起提名的玩家，不太可能成为女巫的目标。");
    g_tipLine[12121] = StringToText("  （当然女巫可能已经预判了你的预判）");
    g_tipLine[12122] = StringToText("· 你经常提名吗？你喜欢争吵或带领玩家的节奏趋势吗？你在游戏中是否经常因为你帅气的颜值而或者因为强大的能力被针对？");
    g_tipLine[12123] = StringToText("  你可能就是女巫的首选目标！女巫喜欢倾向于诅咒领导团队的玩家，所以如果这是你，除非其他人已经因为女巫而死亡，");
    g_tipLine[12124] = StringToText("  否则不要提名。（长得好看就是原罪！）");
    g_tipLine[12125] = StringToText("· 其实你不需要在一场游戏中过于担心女巫的存在！因为在梦殒春宵中的爪牙们的行为方式十分明显，");
    g_tipLine[12126] = StringToText("  你通常会在一切情况中得知本局游戏不存在女巫。例如，如果游戏中只有一个爪牙，而两名玩家声称互为镜像双子，");
    g_tipLine[12127] = StringToText("  那么你可以非常确定本局游戏的爪牙是镜像双子，而不是女巫。如果这个游戏中有两个爪牙，有人声称昨晚被换成了其他角色，");
    g_tipLine[12128] = StringToText("  有人声称昨天被洗脑了，那这时你可以假设这些爪牙是一个麻脸巫婆和一个洗脑师。没有女巫，也无需小心提名。");
    g_tipLine[12129] = StringToText("· 因为女巫而死去的人很可能是善良阵营的。女巫，特别是新手女巫，通常会诅咒善良阵营的玩家。尤其是能力强大的镇民角色。");
    g_tipLine[12130] = StringToText("  如果一位博学者、卖花女孩或钟表匠在提名时死亡，你可以放心地认为这些玩家是善良的，并让说出他们收到的信息。");
    g_tipLine[12131] = StringToText("· 不要被女巫带给你的恐惧支配——把握每一天！随意提名并失去一到两名镇民并不会导致游戏结束，");
    g_tipLine[12132] = StringToText("  因为死亡并不会导致玩家移除游戏（他们依然可以发言或进行一次投票）。这些死亡虽然会帮助邪恶团队更容易胜利，");
    g_tipLine[12133] = StringToText("  但你仍然有机会处决恶魔。专注于你能做些什么来赢得游戏，而不是你之前做过些什么。");
    g_tipRoleAt[65] = 12072; g_tipRoleN[65] = 62; g_tipP1At[65] = 12074; g_tipP1N[65] = 7; g_tipP2At[65] = 0; g_tipP2N[65] = 0;
    g_tipAbility[65] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipLine[12134] = StringToText("【背景故事】");
    g_tipLine[12135] = StringToText("「所谓的现实，其实，只是一种想法罢了。具体点来说，是我的想法。」");
    g_tipLine[12136] = StringToText("【角色能力】");
    g_tipLine[12137] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipLine[12138] = StringToText("【角色简介】");
    g_tipLine[12139] = StringToText("洗脑师促使玩家假装成与自己实际角色不同的角色。");
    g_tipLine[12140] = StringToText("· 洗脑师会选择让一名玩家「疯狂」地证明自己是某个镇民或外来者角色。被选择的玩家明天必须试图说服其他玩家相信他是这个");
    g_tipLine[12141] = StringToText("  角色，否则就会死亡。");
    g_tipLine[12142] = StringToText("· 简短的暗示不足以避免死亡。玩家必须付出努力说服其他玩家。虽然疯狂的玩家不会被强迫一定要说出他不想说的东西，");
    g_tipLine[12143] = StringToText("  但是如果说书人感受不到他的努力，他就会付出代价。");
    g_tipLine[12144] = StringToText("· 疯狂的邪恶玩家可能会以这种方式被处决，但「可能」意味着你可以选择不这么做，以防止邪恶玩家通过这种策略获胜。");
    g_tipLine[12145] = StringToText("· 像畸形秀演员一样，执行处决惩罚计入每天的处决限制。");
    g_tipLine[12146] = StringToText("【范例】");
    g_tipLine[12147] = StringToText("洗脑师使理发师「疯狂」地证明他是博学者。第二天，理发师声称自己是博学者，并拜访说书人，");
    g_tipLine[12148] = StringToText("  然后告诉其他玩家两个编造的信息。当被问及他是否疯狂时，理发师断然说「不」来避免被处决。");
    g_tipLine[12149] = StringToText("洗脑师使死亡的艺术家「疯狂」地证明他是贤者。第二天，艺术家没说自己是贤者。所以艺术家被处决。");
    g_tipLine[12150] = StringToText("洗脑师使卖花女孩「疯狂」地证明她是钟表匠。卖花女孩对其他玩家说，她是钟表匠，并得知恶魔与爪牙的最近距离是「2」，");
    g_tipLine[12151] = StringToText("  但私下暗示其他玩家她疯狂了。这一举动被说书人发现了，并处决了卖花女孩。");
    g_tipLine[12152] = StringToText("【运作方式】");
    g_tipLine[12153] = StringToText("每个夜晚，唤醒洗脑师。让洗脑师指向一名玩家和角色列表上一个镇民或外来者图标。让洗脑师重新入睡。");
    g_tipLine[12154] = StringToText("  为这名玩家放置「疯狂」提示标记并唤醒这名玩家，依次向他展示「该角色的能力对你生效」信息标记、洗脑师的角色标记、");
    g_tipLine[12155] = StringToText("  他要疯狂证明的角色标记。让那名玩家重新入睡。");
    g_tipLine[12156] = StringToText("在下一个白天或夜晚，如果被选择的玩家没有尽最大努力去说服其他玩家他是被选择的角色，你就可以处决他。");
    g_tipLine[12157] = StringToText("  向所有玩家宣布他的死亡。如果你在白天的常规处决前处决了他，则直接进入夜晚阶段。（每个白天最多一次处决。）");
    g_tipLine[12158] = StringToText("【提示标记】");
    g_tipLine[12159] = StringToText("· 疯狂");
    g_tipLine[12160] = StringToText("放置时机：在洗脑师夜晚行动并选择了玩家和善良角色后。");
    g_tipLine[12161] = StringToText("放置条件：在洗脑师要洗脑的玩家，其角色标记旁放置。若此时洗脑师醉酒中毒，不放置该标记。");
    g_tipLine[12162] = StringToText("移除时机：在下一个夜晚的黎明时，或洗脑师死亡或离场时。（在实体游戏中，因为只有一个「疯狂」标记，");
    g_tipLine[12163] = StringToText("  因此需要说书人在洗脑师第二夜行动后，转移疯狂标记，但需要注意此时到黎明之前，");
    g_tipLine[12164] = StringToText("  上一夜洗脑师选择的玩家仍然还处于疯狂状态，并且可能会因为不够疯狂而被处决。）");
    g_tipLine[12165] = StringToText("【规则细节】");
    g_tipLine[12166] = StringToText("· 相克规则：");
    g_tipLine[12167] = StringToText("  · 哥布林：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[12168] = StringToText("【提示与技巧】");
    g_tipLine[12169] = StringToText("· 疯狂是一种能严重阻碍优秀团队找寻恶魔的处罚，也是一门艺术——你可以阻止一名善良玩家透露出他的信息，");
    g_tipLine[12170] = StringToText("  迫使他改变他的发言内容或者让两名玩家对跳相同的角色，如果他们不配合，甚至可以处决掉你选择的受害者。");
    g_tipLine[12171] = StringToText("  在选择谁疯狂（以及对什么角色疯狂）时，请仔细考虑您喜欢的结果！");
    g_tipLine[12172] = StringToText("· 把目标尽量选择成有很多话要说的玩家。大多数游戏中都会有掌控全场节奏的玩家——可能他们已经和其他玩家建立了信任，");
    g_tipLine[12173] = StringToText("  或者可能他们非常确定他们的信息是非常正确的。不管怎样，强迫这类玩家疯狂会阻碍他们相互交流……或者让他们产生一丝丝");
    g_tipLine[12174] = StringToText("  怀疑。");
    g_tipLine[12175] = StringToText("· 如果一个玩家将会透露很多重要的信息，你可以用你的疯狂去阻止他这样做。如果你强迫卖花女孩、");
    g_tipLine[12176] = StringToText("  女裁缝或者神谕者对心上人进行疯狂，他们很难透露出改变局势的相关信息。");
    g_tipLine[12177] = StringToText("  听听看大家是在跟从谁的脚步进行分析（公开或者私下），这样你就可以关注他们是否有能力获取信息，如果有，");
    g_tipLine[12178] = StringToText("  就让他们疯狂。");
    g_tipLine[12179] = StringToText("· 有一个非常残忍的行为可以让善良团队陷入困境，那就是让他们对自己是一个复杂的角色进行疯狂，比如博学者，");
    g_tipLine[12180] = StringToText("  直到比赛结束，他每天都能接收很多的信息。看着这名玩家疯狂的创造出3天以上的信息，不仅很搞笑，");
    g_tipLine[12181] = StringToText("  而且还会让善良团队的玩家分心。");
    g_tipLine[12182] = StringToText("· 在选择让玩家进行疯狂时，尽量不让人发现你的存在或者保持对一个人的洗脑。如果玩家不再疯狂，");
    g_tipLine[12183] = StringToText("  那么他会立即向大家表明他受到了你的影响。这时，好人团队会注意到一些不和寻常的疯狂行为。");
    g_tipLine[12184] = StringToText("  避免这种情况的一种方法就是不断地选择同一名玩家进行疯狂，让他每天都陷入疯狂的状态，");
    g_tipLine[12185] = StringToText("  这样他们就没有机会透露你对他做了什么，而代价就是把你的能力限制在了这一个玩家身上。");
    g_tipLine[12186] = StringToText("  另一种方法是为你的疯狂挑选貌似合理的角色——例如，在一个疑似有方古的游戏中让某人对外来者疯狂，");
    g_tipLine[12187] = StringToText("  或者洗脑成某些提供一些不一致的信息，比如像舞蛇人这样的角色。");
    g_tipLine[12188] = StringToText("· 使用疯狂的一种高级方法是建立连贯的叙述逻辑。例如，你想让一名玩家被大家认为是贤者，");
    g_tipLine[12189] = StringToText("  你可以让他们前一天声称自己是筑梦师，这会显得更有说服力，这会像真正的贤者一样。这会让真正的贤者的可信度降低，");
    g_tipLine[12190] = StringToText("  而不会让它看起来其中一个被洗脑师影响而疯狂——你创造的简单逻辑线索将会让其他玩家感觉不到突兀并且认为这条逻辑是对");
    g_tipLine[12191] = StringToText("  的从而继续下去。另一种保持一致性的方法是为邪恶阵营想要编造的故事提供素材——例如，");
    g_tipLine[12192] = StringToText("  如果你试图让他们相信方古存在游戏之中，那就让他们对外来者疯狂吧。");
    g_tipLine[12193] = StringToText("· 如果善良阵营怀疑涡流存在于场上，他们将非常不愿意在没有处决的情况下结束这一天。");
    g_tipLine[12194] = StringToText("  如果他们没有任何关于潜在邪恶的准确信息，他们可能会选择进行「安全」");
    g_tipLine[12195] = StringToText("  的处决——那些使用了自己能力的玩家（例如钟表匠或者艺术家）。让一个更加强大的角色对这些角色进行疯狂，");
    g_tipLine[12196] = StringToText("  你就能不费吹灰之力看到善良阵营处决他们——如果他们反抗，他们可能会打破疯狂从而被直接处决！");
    g_tipLine[12197] = StringToText("· 你的能力同样可以影响死亡的玩家！即使他们已经死亡，他们任然可以被处决（这意味着善良阵营不能处决他们想要处决的玩家");
    g_tipLine[12198] = StringToText("  ，但是邪恶阵营的玩家可以在夜间自由的行动）。如果你知道你的恶魔将会选择击杀谁，那么你可以让他们对理发师、");
    g_tipLine[12199] = StringToText("  心上人或者呆瓜进行疯狂，这对于善良阵营的玩家来说是个额外分心的事情，因为他们要为这些角色带来的能力效果而思考！");
    g_tipLine[12200] = StringToText("· 理论上，让玩家对自己是畸形秀演员疯狂似乎是个有趣的把戏。但是实际上，");
    g_tipLine[12201] = StringToText("  这种疯狂对邪恶阵营没有一点的帮助——你的目标将被迫声明他是畸形秀演员，这显然没有任何作用，因为他们（可能）");
    g_tipLine[12202] = StringToText("  不具备畸形秀演员的能力。善良阵营也将会知道他们可能被你的能力影响而疯狂，从而意识到你的存在！");
    g_tipLine[12203] = StringToText("· 故意将你的能力用在邪恶的玩家身上，这会让他们看起来像个受到你的能力影响的好人。这存在一定的风险，");
    g_tipLine[12204] = StringToText("  因为如果他们不能有效地发挥疯狂的作用，他们可能被处决，但如果善良阵营认为一名玩家被邪恶的能力影响了，");
    g_tipLine[12205] = StringToText("  他们将更有可能信任他们。但是最好在你做出这样的行为之前提前告知你的队友你的计划。");
    g_tipLine[12206] = StringToText("· 你的对于善良阵营来说是非常显而易见的——疯狂是一种公开的折磨方式，所以善良阵营会在几天后确信你存在于游戏之中。");
    g_tipLine[12207] = StringToText("  如果你的邪恶阵营声称还有其他的爪牙存在，请记住这一点；例如，在仅有一名爪牙存在的游戏中，");
    g_tipLine[12208] = StringToText("  如果有人因为你的疯狂而死亡，你的恶魔就不可能被麻脸巫婆变成别的恶魔，这将证明没有其他的爪牙存在于游戏中，");
    g_tipLine[12209] = StringToText("  从而证明他们在撒谎！");
    g_tipLine[12210] = StringToText("· 这是一个又高级又有趣的技巧：说书人会决定玩家在进行疯狂时是否达到了疯狂表演的程度。这给新手玩家提供了一些容忍度，");
    g_tipLine[12211] = StringToText("  但是相反，对于熟悉游戏=并了解疯狂机制是如何运作的经验丰富的老玩家来说，难度也会增加。");
    g_tipLine[12212] = StringToText("  针对于后者这给了你一些更好的机会去看到一些复杂且真诚的疯狂表演，因为这是对他们的期望——这是非常有趣的且非常有效");
    g_tipLine[12213] = StringToText("  的！");
    g_tipLine[12214] = StringToText("【对抗洗脑师】");
    g_tipLine[12215] = StringToText("· 确保你理解了什么是「疯狂」。如果你疯狂了，或者你正在和一个处于疯狂状态的玩家交流，");
    g_tipLine[12216] = StringToText("  知道疯狂是如何运作的是非常重要的。如果洗脑师让你对一个特殊的角色进行疯狂，");
    g_tipLine[12217] = StringToText("  你必须尽自己的最大努力让大家相信你是这个特殊的角色，否则说书人将会处决你。告诉玩家你是哪个角色，");
    g_tipLine[12218] = StringToText("  如果这个角色应该获得信息，就要编造一些信息给到大家。如果另外一个玩家也声称自己是这个角色，告诉大家他在撒谎，");
    g_tipLine[12219] = StringToText("  因为你就是那个角色。让大家相信你就是洗脑师让你疯狂的那个角色，就是你需要做的所有的一切。需要注意的是，");
    g_tipLine[12220] = StringToText("  在白天开始时单单只是陈述「我是个筑梦师」（例如如果洗脑师已经把你洗脑成筑梦师）然后在中途保持沉默将可能被处决。");
    g_tipLine[12221] = StringToText("  你对大家说的是什么并不重要，但是你的语气，热情和论点的力度是非常重要的。");
    g_tipLine[12222] = StringToText("  如果说书人认为你是在真正努力说服善良阵营你是那个角色，那么说书人几乎不会处决你。");
    g_tipLine[12223] = StringToText("· 如果你被洗脑师影响而疯狂了，而你没有努力让大家相信你是这个新的角色，说书人可能会处决你。");
    g_tipLine[12224] = StringToText("  有时候被处决是可以接受的，甚至对你的团队是有帮助的。例如，如果你是个神谕者，");
    g_tipLine[12225] = StringToText("  你有大量的有关死亡玩家的信息去告诉团队，但是由于疯狂却无法告诉他们，那么最好此时不要理会洗脑师的疯狂，");
    g_tipLine[12226] = StringToText("  告诉团队你是神谕者，然后告诉他们你的信息，最后被说书人直接处决。有时候你的信息比你的生命更加有价值。同样的，");
    g_tipLine[12227] = StringToText("  如果你不擅长进行疯狂的表演，说书人可能会处决你——这不是世界末日。继续游戏并且你有更多的时间去处决恶魔。");
    g_tipLine[12228] = StringToText("· 小心说书人！当玩家处于疯狂状态时，说书人通常会更加关注他在说些什么。例如，");
    g_tipLine[12229] = StringToText("  如果玩家公开声明自己是呆瓜（即试图让大家相信自己是个呆瓜），但是当他认为说书人在没有看他的时候眨了眨眼睛，");
    g_tipLine[12230] = StringToText("  或者私下偷偷地告诉他旁边的人实际上他是个舞蛇人，如果说书人在他表演过程中抓住了他们，他们可能会立即被处决。");
    g_tipLine[12231] = StringToText("· 小心邪恶的玩家！如果你对你是另一个角色而疯狂，但是你想私下告诉一两个玩家你的真正的角色是什么（当你认为说书人没有");
    g_tipLine[12232] = StringToText("  看你的时候），你可能会意外的和一个即将揭发你的邪恶玩家交谈。这个玩家如果向他的团队发出信号，");
    g_tipLine[12233] = StringToText("  或者他们直接告诉说书人你告诉了他们你的真正角色，这样可以让你被处决。");
    g_tipLine[12234] = StringToText("· 当你认为有人处于疯狂状态之中，不要对他们施加太大的压力，他们可能处于疯狂状态，他们也可能处于不同的原因撒谎。");
    g_tipLine[12235] = StringToText("  但是，如果你和大家都认为，一个处于疯狂状态的玩家说的话是因为他们疯狂了，那么说书人可能会处决有问题的玩家。");
    g_tipLine[12236] = StringToText("· 洗脑师可以将死亡的玩家作为目标！鸦木布拉夫的居民们能够，甚至有些时候也必须要处决已死之人。这是个奇怪的地方。");
    g_tipLine[12237] = StringToText("  如果一名死亡玩家被洗脑师作为目标，那名玩家仍可能因为不够疯狂而被处决，因为每天只能执行一次处决，没有提名发生，");
    g_tipLine[12238] = StringToText("  今天不可能执行对其他玩家的处决，然后夜间将降临。");
    g_tipLine[12239] = StringToText("· 作为一个团队，当洗脑师存在于游戏之中时，你可能会知晓。玩家们可能会突然的被处决。");
    g_tipLine[12240] = StringToText("  然后这名玩家可能会告诉大家他在昨天，或者前几天，处于疯狂状态，如果他们不再疯狂，他们可以放心地这样做。");
    g_tipLine[12241] = StringToText("  请注意那些声称被洗脑师选中的玩家，回溯他们的信息，以获得谁是善良的谁是邪恶的信息。");
    g_tipLine[12242] = StringToText("  如果两名玩家都声称他们在前一晚上同时被洗脑师选择了，那么他们至少有一个人在撒谎，且撒谎的玩家可能是邪恶的。");
    g_tipLine[12243] = StringToText("  洗脑师总是大概率选择善良阵营的玩家，而且几乎永远不会选择恶魔（这太冒险了！）除非他们有意图的死亡，");
    g_tipLine[12244] = StringToText("  否则你可以永远放心地假设之前被选择的玩家并不是恶魔。让这些玩家存活，即使你认为他们可能是爪牙，");
    g_tipLine[12245] = StringToText("  因为专注于寻找并杀死恶魔才是你最重要的事情。");
    g_tipRoleAt[66] = 12134; g_tipRoleN[66] = 112; g_tipP1At[66] = 12136; g_tipP1N[66] = 10; g_tipP2At[66] = 12165; g_tipP2N[66] = 3;
    g_tipAbility[66] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，不然他可能被处决。");
    g_tipLine[12246] = StringToText("【背景故事】");
    g_tipLine[12247] = StringToText("「绕釜环行火融融，毒肝腐脏寘其中。");
    g_tipLine[12248] = StringToText("蛤蟆蛰眠寒石底，三十一日夜相继；");
    g_tipLine[12249] = StringToText("汗出淋漓化毒浆，投之鼎釜沸为汤。」");
    g_tipLine[12250] = StringToText("【角色能力】");
    g_tipLine[12251] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，");
    g_tipLine[12252] = StringToText("  当晚的死亡由说书人决定。");
    g_tipLine[12253] = StringToText("【角色简介】");
    g_tipLine[12254] = StringToText("麻脸巫婆能将玩家变为不同的角色。");
    g_tipLine[12255] = StringToText("· 除首个夜晚以外的每个夜晚，麻脸巫婆需要选择一名玩家和一个角色，那名玩家变为她选择的角色。");
    g_tipLine[12256] = StringToText("· 她无法创造重复角色，如果那个角色已在场，则无事发生。");
    g_tipLine[12257] = StringToText("【范例】");
    g_tipLine[12258] = StringToText("麻脸巫婆试图将博学者变成贤者，但无事发生，因为贤者在场。");
    g_tipLine[12259] = StringToText("麻脸巫婆将卖花女孩变成镜像双子。现在，有一名善良阵营的镜像双子，所以镜像双子和一名邪恶玩家被唤醒并得知彼此的角色");
    g_tipLine[12260] = StringToText("  。");
    g_tipLine[12261] = StringToText("在最后一个夜晚，麻脸巫婆将神谕者变成善良的诺-达鲺。说书人只杀死了邪恶的恶魔，");
    g_tipLine[12262] = StringToText("  这样只有一个恶魔在最后一个白天存活。");
    g_tipLine[12263] = StringToText("【运作方式】");
    g_tipLine[12264] = StringToText("除首夜外的每个夜晚，唤醒麻脸巫婆。让她指向一名玩家和角色列表上的一个角色图标。让麻脸巫婆重新入睡。");
    g_tipLine[12265] = StringToText("如果她选择的角色在场，无事发生。");
    g_tipLine[12266] = StringToText("如果她选择的角色不在场，则唤醒所选玩家。依次向他展示「你是」信息标记、他的新角色标记，然后让他重新入睡。");
    g_tipLine[12267] = StringToText("  用新角色标记替换他的旧角色标记。（你可能需要倒置角色标记，表示玩家阵营与该角色原本阵营相反。");
    g_tipLine[12268] = StringToText("  同样你可能也需要通过手势来提醒玩家，他的阵营没有改变。）");
    g_tipLine[12269] = StringToText("如果有玩家因此变成恶魔，你能在当晚杀死任意数量的玩家或阻止被恶魔攻击的玩家死亡来平衡游戏。");
    g_tipLine[12270] = StringToText("  由你选择且未被恶魔选择的玩家的死亡视为被麻脸巫婆杀死。");
    g_tipLine[12271] = StringToText("如果麻脸巫婆将恶魔变成另一种恶魔，最好是让今晚无人死亡，以此来提示善良阵营恶魔的角色发生了变化。");
    g_tipLine[12272] = StringToText("  你可以在唤醒恶魔并让他选择攻击目标后，再决定无人死亡。如果麻脸巫婆创造了新的邪恶恶魔，");
    g_tipLine[12273] = StringToText("  最好杀死老恶魔和一名其他玩家，以此提示善良阵营恶魔玩家已经改变了。如果麻脸巫婆创造了善良恶魔，");
    g_tipLine[12274] = StringToText("  最好杀死一个恶魔（如果是最后一夜），或让两个恶魔一同肆虐（如果不是最后一夜）");
    g_tipLine[12275] = StringToText("  但由于所有恶魔都死亡善良阵营才能获胜，所以请谨慎使用这种方法。");
    g_tipLine[12276] = StringToText("【提示标记】");
    g_tipLine[12277] = StringToText("无");
    g_tipLine[12278] = StringToText("【规则细节】");
    g_tipLine[12279] = StringToText("· 说书人应该如何处理「因为麻脸巫婆创造了恶魔」而导致的死亡：");
    g_tipLine[12280] = StringToText("  · 麻脸巫婆造成死亡的时间范围为当前剧本中首个能够造成死亡的恶魔行动开始前，到最后一个能够造成死亡的恶魔行动结束后。");
    g_tipLine[12281] = StringToText("  · 在这个期间，说书人能够自由决定是否让某名玩家死亡，或让被恶魔攻击的某名玩家存活。");
    g_tipLine[12282] = StringToText("  · 说书人在这个时间范围内，可以分别在不同的恶魔行动前或后多次执行造成或阻止死亡的效果。");
    g_tipLine[12283] = StringToText("  · 一旦说书人决定杀死某个还未唤醒的恶魔，这名恶魔玩家当晚就不会被唤醒。否则，就需要唤醒这名玩家。");
    g_tipLine[12284] = StringToText("    这对于在创造出哈迪寂亚等带有特殊效果的恶魔时非常重要。");
    g_tipLine[12285] = StringToText("  · 说书人只能造成更多的死亡或阻止原本要发生的死亡，其他类型的恶魔能力无法阻止，如普卡的中毒、哈迪寂亚的复活等。");
    g_tipLine[12286] = StringToText("  · 不建议说书人阻止恶魔成功攻击的玩家的死亡，并再自己决定让这名玩家死亡，因为这会造成更多的混乱。");
    g_tipLine[12287] = StringToText("    恶魔攻击后无法杀死某名玩家再由说书人决定杀死，这种情况不算在内。");
    g_tipLine[12288] = StringToText("  · 说书人造成的死亡视为麻脸巫婆造成，因此不会触发贤者、唱诗男孩等角色的能力，");
    g_tipLine[12289] = StringToText("    也能够成功杀死士兵（如果麻脸巫婆没有照看小怪宝的话）。");
    g_tipLine[12290] = StringToText("  · 只要麻脸巫婆创造了恶魔，即使在那之后麻脸巫婆离场、失去能力或死亡，当晚说书人仍然可以决定造成或阻止死亡。");
    g_tipLine[12291] = StringToText("  · 说书人只能阻止恶魔造成的死亡，由非恶魔玩家造成的死亡无法阻止。");
    g_tipLine[12292] = StringToText("· 相克规则：");
    g_tipLine[12293] = StringToText("  · 村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，村夫的醉酒效果可能会更换目标。");
    g_tipLine[12294] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[12295] = StringToText("  · 落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[12296] = StringToText("  · 异教领袖/政客/莽夫/食人魔：被麻脸巫婆创造的邪恶异教领袖/政客/莽夫/食人魔无法因为自身能力转变为善良阵营。");
    g_tipLine[12297] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[12298] = StringToText("  · 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[12299] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[12300] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[12301] = StringToText("  · 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[12302] = StringToText("  · 戏子（改）：麻脸巫婆无法创造戏子（改），麻脸巫婆创造的邪恶玩家无法获得戏子（改）的能力。");
    g_tipLine[12303] = StringToText("【提示与技巧】");
    g_tipLine[12304] = StringToText("· 你的能力会改变玩家的角色，但不会改变他们的阵营。这意味着如果你把一个善良玩家变成一个女巫，");
    g_tipLine[12305] = StringToText("  他们将是一个善良的爪牙。同样，如果您将邪恶玩家转变为哲学家，他们现在是邪恶阵营的镇民。");
    g_tipLine[12306] = StringToText("  在决定转变谁时请记住这一点 - 创造邪恶的镇民/外来者，甚至是善良的爪牙/恶魔都有好处，");
    g_tipLine[12307] = StringToText("  但是记得你的能力并不能让某一名善良玩家加入邪恶阵营。");
    g_tipLine[12308] = StringToText("· 创造新恶魔是麻脸巫婆的一项独特能力。您可以将现有的恶魔转化为不同的恶魔角色（让涡流进入游戏中），");
    g_tipLine[12309] = StringToText("  但你也可以通过将邪恶玩家变成新的恶魔来「转移」恶魔，最后你可以通过改造任何敌人来创造一个善良恶魔！当然，");
    g_tipLine[12310] = StringToText("  这种能力有一个主要的缺点——说书人会通过控制当晚的死亡来平衡你所做的任何操作。通常来说，「转移」");
    g_tipLine[12311] = StringToText("  恶魔会导致邪恶玩家（通常是前一个恶魔）死亡 - 说书人不允许多个邪恶恶魔活着的情况下继续游戏！");
    g_tipLine[12312] = StringToText("  所以更微妙的操作是，改变在场的恶魔角色，这可能根本不会导致死亡，所以善良阵营可以借此发现一些变化的迹象。最后，");
    g_tipLine[12313] = StringToText("  虽然他们可能会允许有一个善良恶魔共存，但你应该小心，因为那个善良恶魔也有杀戮的能力，并且能紧紧咬住邪恶阵营！");
    g_tipLine[12314] = StringToText("  （另外，小心对待亡骨魔一旦它变成别的东西，如果你是保留能力的死亡爪牙，你就会失去能力！）");
    g_tipLine[12315] = StringToText("· 创造外来者！有一个讨厌的博学者得到很多有用的信息吗？把他们变成心上人！怀疑某人是试图欺骗你的恶魔的贤者？");
    g_tipLine[12316] = StringToText("  现在他们是一个卑微的呆瓜了，死去不再是一件那么幸运的事了！你的恶魔是无处可藏的方古？创造一个新的！");
    g_tipLine[12317] = StringToText("· 通过将他们变成对当前游戏配置不太有用的镇民来削弱麻烦的镇民。例如，如果你的恶魔是亡骨魔，");
    g_tipLine[12318] = StringToText("  神谕者将是一个特别危险的角色，而钟表匠的信息可能不会那么令人担忧。或者（在提醒你的恶魔之后），");
    g_tipLine[12319] = StringToText("  你可以将玩家变成像贤者一样很有用的镇民，抵消他们原本的强大能力。总是简单地将别人变成外来者似乎更容易，但请记住，");
    g_tipLine[12320] = StringToText("  您只能将某人变成不在场角色 - 最好让一些信息流逝而不是因为已经有一个理发师潜伏在其中而使转换失败。");
    g_tipLine[12321] = StringToText("· 与您的邪恶阵营沟通，以充分利用您的转换。没有什么比把一个镇民变成无用的东西并在第二天早上醒来看到你的恶魔选择了同");
    g_tipLine[12322] = StringToText("  样的目标并杀死他们更让他们沮丧的了。与你的恶魔和爪牙一起消灭多个目标是非常有效的。或者，");
    g_tipLine[12323] = StringToText("  您可以在您的恶魔杀死他们时创造一个呆瓜，让您的受害者措手不及（因为他们不会考虑在他们死亡的情况下该信任谁）。");
    g_tipLine[12324] = StringToText("· 创造爪牙！即使是善良爪牙！像女巫和洗脑师这样的角色很有趣，即使在善良阵营中也会造成很大的伤害。");
    g_tipLine[12325] = StringToText("  如果场上有一个特别爱针对他人或似乎非常偏执的玩家......并且思路是错误的，");
    g_tipLine[12326] = StringToText("  请让他们有能力根据自己的冲动采取行动并坐下来欣赏大屠杀。同样的，你要注意——这些能力对你也是有效的！");
    g_tipLine[12327] = StringToText("· 转变你自己！虽然这将意味着你能转变的日子结束了，但很多时候将自己变成另一个角色会改变游戏的状态。");
    g_tipLine[12328] = StringToText("  善良玩家赢得了大家的信任吗？成为诺-达鲺并接管恶魔！想偷偷地破坏卖花女孩的信息？变身邪恶的哲学家，");
    g_tipLine[12329] = StringToText("  获得卖花女孩的能力并让她醉倒！只是感觉游戏节奏慢了？成为女巫，诅咒那个打算提名的玩家！");
    g_tipLine[12330] = StringToText("· 如果你没有在夜晚改造一个玩家，你可以让邪恶玩家声称他们被改造成了邪恶阵营的角色，即使他们不是。");
    g_tipLine[12331] = StringToText("  公开声称自己是被改造的玩家往往会立即得到善良玩家的信任，因为麻脸巫婆通常会改造善良玩家。或者，");
    g_tipLine[12332] = StringToText("  如果你是昨晚被麻脸巫婆改造的邪恶玩家。告诉大家，你已经变成了……变成了一个善良角色。");
    g_tipLine[12333] = StringToText("· 在游戏的某个阶段，不再进行有效的改造。（比如选择改造自己为麻脸巫婆）只要你改造了玩家，善良阵营就会知道你还活着，");
    g_tipLine[12334] = StringToText("  因为一个死了的麻脸巫婆没有能力。这种策略在只有一个爪牙的游戏，或者另一个爪牙是镜像双子的游戏中特别有用。");
    g_tipLine[12335] = StringToText("  如果善良玩家知道所有爪牙还活着，那么他们也知道所有被处决的玩家都是善良的。但是当他们怀疑一个爪牙已经死了，");
    g_tipLine[12336] = StringToText("  从那时起，他们将不知道哪些死去的玩家是善良的，哪些是邪恶的。");
    g_tipLine[12337] = StringToText("· 如果一个邪恶玩家声称自己是洗脑师的受害者，或者他们声称镜像双子在场，");
    g_tipLine[12338] = StringToText("  那么可能会与一个善良玩家声称他们被麻脸巫婆发生冲突。如果游戏中只有麻脸巫婆在场，");
    g_tipLine[12339] = StringToText("  那么声称受到洗脑师影响是没有意义的。注意你的邪恶玩家，如果你想让他们的说法被相信，不要在晚上改造他们。");
    g_tipLine[12340] = StringToText("【对抗麻脸巫婆】");
    g_tipLine[12341] = StringToText("当你要对抗麻脸巫婆的时候，这里有几件事你应该记住：");
    g_tipLine[12342] = StringToText("· 如果你被麻脸巫婆变成了不同的角色，请立即告诉大家昨晚发生了什么。大家会更倾向于认为你是善良的，");
    g_tipLine[12343] = StringToText("  仅仅是因为麻脸巫婆针对了你。");
    g_tipLine[12344] = StringToText("· 只要发生转变，您就可以知道麻脸巫婆还活着。这意味着死去的玩家更容易被认为他是善良的。在只有1个爪牙的游戏中，");
    g_tipLine[12345] = StringToText("  只要麻脸巫婆通过更换角色来表明他们还活着，你就可以相信迄今为止被处决的所有玩家，因为他们都一定是善良的。");
    g_tipLine[12346] = StringToText("· 如果有玩家之前已经被改造，但昨晚没有人被改造，要么是麻脸巫婆昨晚改造了一个邪恶玩家（他没有告诉大家），");
    g_tipLine[12347] = StringToText("  要么是麻脸巫婆选择了一个游戏中的角色，或者是麻脸巫婆已经死了。如果没有发生任何转换，请调查这些可能性，");
    g_tipLine[12348] = StringToText("  看看它们是否带给您任何有用的信息。");
    g_tipLine[12349] = StringToText("· 如果夜间死亡人数超过1，那么说明麻脸巫婆可能创造了一个新的恶魔。通常来说，");
    g_tipLine[12350] = StringToText("  如果麻脸巫婆将恶魔玩家变成另一个恶魔角色，晚上不会发生死亡。如果麻脸巫婆创造了一个新的恶魔玩家（例如，");
    g_tipLine[12351] = StringToText("  通过将自己或同伴爪牙改造成恶魔），那么晚上会发生2次死亡……其中一个很可能是恶魔！当这些不寻常的死亡情况发生时，");
    g_tipLine[12352] = StringToText("  那你可以假设恶魔已经改变了——它现在可能是一个之前不在场的涡流，或者它现在可能是一个方古，");
    g_tipLine[12353] = StringToText("  而之前它是一个诺-达鲺，这意味着相邻的镇民不再中毒。");
    g_tipLine[12354] = StringToText("· 请记住，如果你是一个善良玩家，并且变成了女巫，你仍然是好人 - 现在可以使用你的女巫能力诅咒人......如果你");
    g_tipLine[12355] = StringToText("  幸运的话，甚至可能诅咒到邪恶玩家。如果你是一个善良玩家，并且变成了一个恶魔，");
    g_tipLine[12356] = StringToText("  那么你就是一个善良恶魔——你可以利用你的能力在晚上杀死玩家，并可能以这种方式杀死邪恶的恶魔。");
    g_tipLine[12357] = StringToText("  如果您确实成为了一个好恶魔，请记住只有在包括您在内的所有恶魔都死了之后，善良才会获胜，");
    g_tipLine[12358] = StringToText("  因此您和邪恶的恶魔都需要死去才能使善良获胜。");
    g_tipLine[12359] = StringToText("· 麻脸巫婆的能力只能创造不在游戏中的角色——所以声称自己是一个不受欢迎的角色，麻脸巫婆就不会试图将玩家变成它。");
    g_tipLine[12360] = StringToText("  例如，如果你声称自己是心上人，那么麻脸巫婆就不会试图将镇民变成心上人，");
    g_tipLine[12361] = StringToText("  而是可能意外选择在游戏中的角色……这意味着不会发生任何转变。即使麻脸巫婆创造了新角色，");
    g_tipLine[12362] = StringToText("  通过声称自己是不受欢迎的角色，你几乎可以保证麻脸巫婆不会创造出那个特别不受欢迎的角色。");
    g_tipRoleAt[67] = 12246; g_tipRoleN[67] = 117; g_tipP1At[67] = 12250; g_tipP1N[67] = 7; g_tipP2At[67] = 12278; g_tipP2N[67] = 25;
    g_tipAbility[67] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipLine[12363] = StringToText("【背景故事】");
    g_tipLine[12364] = StringToText("「你那高墙和锐器不过是虚无缥缈的泡影。」");
    g_tipLine[12365] = StringToText("【角色能力】");
    g_tipLine[12366] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[12367] = StringToText("被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipLine[12368] = StringToText("【角色简介】");
    g_tipLine[12369] = StringToText("方古会侵染外来者。");
    g_tipLine[12370] = StringToText("· 方古首次攻击并成功杀死外来者时，改为方古死亡，外来者变成邪恶的方古。");
    g_tipLine[12371] = StringToText("· 这种情况在整局游戏仅能出现一次。如果新的方古攻击外来者，外来者正常死亡。");
    g_tipLine[12372] = StringToText("· 新的方古也是恶魔，如果他死亡，善良阵营获胜。但他不会得知哪些玩家是爪牙。");
    g_tipLine[12373] = StringToText("· 方古会使得在初始设置时增加一名外来者。");
    g_tipLine[12374] = StringToText("· 如果方古攻击外来者，但外来者没有因此死亡，则外来者不会成为邪恶的方古，方古也不会死。");
    g_tipLine[12375] = StringToText("【范例】");
    g_tipLine[12376] = StringToText("方古攻击并杀死艺术家。下个夜晚，方古攻击了心上人，心上人成为新方古，老方古死亡。心上人不会使一名玩家醉酒，");
    g_tipLine[12377] = StringToText("  因为心上人没有死。下个夜晚，新方古攻击并杀死了呆瓜。");
    g_tipLine[12378] = StringToText("方古攻击死去的呆瓜。因为呆瓜已经死了，他不会再次死亡，所以方古不会死。呆瓜仍然为善良阵营，今晚无人死亡。");
    g_tipLine[12379] = StringToText("【运作方式】");
    g_tipLine[12380] = StringToText("在初始设置时，将角色标记放入盲抽袋前，把一个镇民角色标记替换为一个外来者角色标记。");
    g_tipLine[12381] = StringToText("除首个夜晚外的每个夜晚，唤醒方古。让他指向一名玩家。让方古重新入睡。");
    g_tipLine[12382] = StringToText("如果被选择的玩家不是外来者，为那名玩家放置「死亡」提示标记。");
    g_tipLine[12383] = StringToText("如果被选择的玩家是外来者，且「限一次」提示标记已经被放置在魔典中，也为那名玩家放置「死亡」标记。");
    g_tipLine[12384] = StringToText("如果被选择的玩家是外来者，且「限一次」提示标记不在魔典中，在原来的方古旁放置「死亡」提示标记。");
    g_tipLine[12385] = StringToText("  唤醒被选择的外来者。依次向他展示「你是」信息标记、向下的大拇指、方古角色标记。用多出的方古标记替换他的角色标记，");
    g_tipLine[12386] = StringToText("  且他转为邪恶阵营。让新方古重新入睡。把「限一次」标记放在魔典中心。（与「每局游戏限一次」能力不同，");
    g_tipLine[12387] = StringToText("  这个标记在接下来的游戏中始终留在那里，即使方古死亡或改变角色。）");
    g_tipLine[12388] = StringToText("【提示标记】");
    g_tipLine[12389] = StringToText("· 死亡");
    g_tipLine[12390] = StringToText("放置时机：在方古夜晚行动并选择了玩家后放置。");
    g_tipLine[12391] = StringToText("放置条件：方古选择的玩家当前存活，且能被方古杀死，且方古未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[12392] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[12393] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[12394] = StringToText("· 限一次");
    g_tipLine[12395] = StringToText("放置时机：在方古即将成功杀死一名外来者，但此时魔典中央还未放置「限一次」提示标记时。");
    g_tipLine[12396] = StringToText("放置条件：在方古成功触发能力转化外来者时，放置在魔典中央。");
    g_tipLine[12397] = StringToText("移除时机：持续至整局游戏结束。");
    g_tipLine[12398] = StringToText("【规则细节】");
    g_tipLine[12399] = StringToText("· 相克规则：");
    g_tipLine[12400] = StringToText("  · 红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipLine[12401] = StringToText("【提示与技巧】");
    g_tipLine[12402] = StringToText("· 得益于你的恶魔传递的能力，弄明白谁是外来者对你来说是有好处的。在游戏中尽快尽早地获取这些信息是非常重要的，");
    g_tipLine[12403] = StringToText("  且是你该考虑的主要战术。这么做可以帮助你洗脱嫌疑，且能帮助你在场上听感变好、地位变高以及传递恶魔的火种。");
    g_tipLine[12404] = StringToText("  ——在正确的时候选择使用你的能力，往往能起到场上形式的质变并给你带来胜利。");
    g_tipLine[12405] = StringToText("· 当压力突增你察觉到自己即将被处决时，你可以故意选择一个外来者，用你的能力代替他的死亡，");
    g_tipLine[12406] = StringToText("  来确保恶魔火种的延续（以此方式回到善良阵营来隐藏自己）。即使善良阵营怀疑之前的坏事都是你做的，");
    g_tipLine[12407] = StringToText("  他们也没有能力去阻止让坏事继续发生。");
    g_tipLine[12408] = StringToText("· 传递你的恶魔能力来扩张你的邪恶势力！因为邪恶的玩家越多，你的阵营拥有的票数就越多。但是这样做是有风险的，");
    g_tipLine[12409] = StringToText("  因为当你传递你的恶魔能力的时候，你可能会暴露——例如神谕者和筑梦师，他们有能力去获取一些对邪恶阵营不利的信息，");
    g_tipLine[12410] = StringToText("  如果你没有仔细的思考场上的局势就传递你的恶魔能力的话。尽管这样做有一定的风险，但是额外的投票能力其实是无价的。");
    g_tipLine[12411] = StringToText("· 如果你成功的伪装了一个很好的角色并且混入了善良阵营被好人们认下，请不要在这个时候击杀一名外来者。");
    g_tipLine[12412] = StringToText("  他们在场上表现的角色可能没有你伪装的好，因为你知道不存在游戏中的角色，");
    g_tipLine[12413] = StringToText("  所以在这时候传递恶魔的能力只会让邪恶阵营变得更加脆弱。");
    g_tipLine[12414] = StringToText("· 让你的爪牙们保持沟通！你的爪牙（尤其是女巫、洗脑师和麻脸巫婆）非常具有破坏性，如果他们不知道自己的恶魔是谁，");
    g_tipLine[12415] = StringToText("  这场游戏可能没有一个好的发展和一个令人满意的结局。尝试提前跟他们沟通让他们知道你是否打算传递出恶魔的能力以及你可");
    g_tipLine[12416] = StringToText("  能传递的目标是谁——这样做的话即使你意外的攻击了一个隐藏的外来者触发了你的能力，");
    g_tipLine[12417] = StringToText("  这样的话新的恶魔在醒来时也不会被诅咒、疯狂或被变成一个新的恶魔。");
    g_tipLine[12418] = StringToText("· 因为你在某些时候可以把牺牲自我当做计划的一部分，所以可以考虑利用梦殒春宵提供的不在场的某些角色进行更有利的角色伪");
    g_tipLine[12419] = StringToText("  装。死亡之后声称自己是贤者，然后指向两名善良阵营的玩家声称他们中间存在恶魔。或者声称自己是心上人，");
    g_tipLine[12420] = StringToText("  让每个人都怀疑自己的信息可能出错。或者声称自己是呆瓜，指向一名邪恶阵营的玩家，将他们伪装成善良的玩家。");
    g_tipLine[12421] = StringToText("  其他的一些伪装角色也同样对方古非常有用，但是如果你不得不死，为什么不用这些更有用的角色呢？");
    g_tipLine[12422] = StringToText("· 如果你成为了新的方古，不要惊慌！你的首要任务是找到谁是你的邪恶阵营的队友——从前一晚死亡的方古开始，");
    g_tipLine[12423] = StringToText("  通过他再去找到爪牙。在那之后，杀戮就是你要做的事情。避免被善良阵营发现你是新的恶魔，然后为你的新的团队赢得胜利！");
    g_tipLine[12424] = StringToText("【对抗方古】");
    g_tipLine[12425] = StringToText("· 知道方古存在游戏中是打败他的第一步。第一个也是最大的线索就是外来者的数量比平时要多。");
    g_tipLine[12426] = StringToText("  当然这也可能是邪恶阵营的玩家声称是自己是外来者的结果，也可能是由于方古造成的。");
    g_tipLine[12427] = StringToText("· 某些角色能够直接发现方古的存在。每当一个新的方古出现时，神谕者能够发现一个新的死亡的邪恶阵营玩家。");
    g_tipLine[12428] = StringToText("  卖花女孩能够发现恶魔是否投票，如果投了票的玩家死在夜里，这可能是方古出现在游戏中的线索。筑梦师、");
    g_tipLine[12429] = StringToText("  艺术家和博学者有时候也能得到方古存在于游戏中的信息，当然这些信息不会十分明确的告诉你谁是方古。");
    g_tipLine[12430] = StringToText("  如果数学家一直得到是0的信息，即其他玩家的信息都没有出错，那意味着涡流和诺-达鲺不在游戏之中，");
    g_tipLine[12431] = StringToText("  方古就可能存在于场上。");
    g_tipLine[12432] = StringToText("· 如果你怀疑方古在存在游戏之中，就处决外来者。方古在一整局游戏中不转换外来者的阵营是很少见的，");
    g_tipLine[12433] = StringToText("  所以外来者特别令人怀疑。最好在游戏末期的时候处决外来者而不是早期，因为越到后期，");
    g_tipLine[12434] = StringToText("  方古才更有可能将外来者变成邪恶的新恶魔。");
    g_tipLine[12435] = StringToText("· 如果一名玩家在夜里死亡，请注意他们与谁在交谈。死亡的方古通常会想要和他的爪牙交谈谁是那个新的恶魔。");
    g_tipLine[12436] = StringToText("· 如果你是一个外来者，在你确定方古没有存在游戏中之前，请不要暴露你的角色。如果方古在游戏之中，");
    g_tipLine[12437] = StringToText("  你可能会在某个时刻突然变成邪恶的恶魔。如果你告诉了善良阵营你是一个外来者，他们可能认为你是邪恶的，然后将你处决。");
    g_tipRoleAt[68] = 12363; g_tipRoleN[68] = 75; g_tipP1At[68] = 12365; g_tipP1N[68] = 10; g_tipP2At[68] = 12398; g_tipP2N[68] = 3;
    g_tipAbility[68] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipLine[12438] = StringToText("【背景故事】");
    g_tipLine[12439] = StringToText("「世间万扉集为一体，世间万匙铸为一身。世间万盅将与我共饮，但凡饮下我所赐圣水者，必将永不干渴，");
    g_tipLine[12440] = StringToText("  化作万孔泉眼涌作永生。」");
    g_tipLine[12441] = StringToText("【角色能力】");
    g_tipLine[12442] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[12443] = StringToText("被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipLine[12444] = StringToText("【角色简介】");
    g_tipLine[12445] = StringToText("亡骨魔每当杀死自己的爪牙时，会使爪牙保留能力。");
    g_tipLine[12446] = StringToText("· 每当亡骨魔杀死一名爪牙时，虽然爪牙会死亡，但只要亡骨魔还存活，该爪牙就能保留能力，且仍能在夜晚行动。");
    g_tipLine[12447] = StringToText("· 类似于诺-达鲺，那个被亡骨魔杀死的爪牙顺时针或逆时针方向最近的镇民玩家会中毒，即使该镇民已经死亡。");
    g_tipLine[12448] = StringToText("  如果亡骨魔死亡或失去能力，受亡骨魔影响的中毒玩家恢复健康。亡骨魔在杀死爪牙时总是会使一名镇民玩家中毒，");
    g_tipLine[12449] = StringToText("  在说书人选择中毒玩家时会跳过与爪牙相邻的非镇民角色。由说书人选择该爪牙哪一侧的镇民中毒。");
    g_tipLine[12450] = StringToText("· 不仅是最后一个被亡骨魔杀死的爪牙，所有被亡骨魔杀死的爪牙都会保留能力并使一名镇民中毒。");
    g_tipLine[12451] = StringToText("· 如果死亡的爪牙变成非爪牙角色，便不再使相应的镇民中毒，且不再保留能力。如果死亡的爪牙醉酒或中毒，");
    g_tipLine[12452] = StringToText("  也会失去能力直到再次恢复清醒和健康。");
    g_tipLine[12453] = StringToText("【范例】");
    g_tipLine[12454] = StringToText("亡骨魔杀死了女巫。下个白天，一名被女巫诅咒的玩家发起了提名，被诅咒的玩家死亡。");
    g_tipLine[12455] = StringToText("亡骨魔杀死了镜像双子。与镜像双子邻近的是呆瓜和卖花女孩，贤者在呆瓜的另一侧。说书人选择让贤者中毒。下个白天，");
    g_tipLine[12456] = StringToText("  善良的双子被处决，邪恶阵营胜利。");
    g_tipLine[12457] = StringToText("亡骨魔杀死了麻脸巫婆。麻脸巫婆将博学者变成女巫。女巫诅咒并杀死一名玩家之后，女巫被亡骨魔杀死。");
    g_tipLine[12458] = StringToText("  麻脸巫婆将死去的女巫变为神谕者，神谕者现在不再保留能力。麻脸巫婆将亡骨魔变成了涡流。麻脸巫婆现在也失去能力。");
    g_tipLine[12459] = StringToText("【运作方式】");
    g_tipLine[12460] = StringToText("在初始设置时，将角色标记放入盲抽袋前，把一个外来者角色标记替换为一个镇民角色标记。");
    g_tipLine[12461] = StringToText("  （如果没有可以移除的外来者标记，则不需要添加镇民标记。）");
    g_tipLine[12462] = StringToText("除首个夜晚外的每个夜晚，唤醒亡骨魔。让亡骨魔指向一名玩家。让亡骨魔重新入睡。如果被选择的玩家不是爪牙，");
    g_tipLine[12463] = StringToText("  为那名玩家放置「死亡」提示标记。");
    g_tipLine[12464] = StringToText("如果被选择的玩家是爪牙，为那名玩家放置「死亡」和「保留能力」提示标记。距离爪牙顺时针或逆时针最近的镇民玩家中毒，");
    g_tipLine[12465] = StringToText("  为该镇民玩家放置「中毒」提示标记。（顺时针和逆时针分别判断最近的一个镇民，并取这两个镇民的其中之一）");
    g_tipLine[12466] = StringToText("【提示标记】");
    g_tipLine[12467] = StringToText("· 死亡");
    g_tipLine[12468] = StringToText("放置时机：在亡骨魔夜晚行动并选择了玩家后放置。");
    g_tipLine[12469] = StringToText("放置条件：亡骨魔选择的玩家当前存活，且能被亡骨魔杀死，且亡骨魔未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[12470] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[12471] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[12472] = StringToText("· 保留能力");
    g_tipLine[12473] = StringToText("放置时机：在亡骨魔夜晚行动并选择了玩家后放置。");
    g_tipLine[12474] = StringToText("放置条件：被亡骨魔成功杀死的玩家角色如果是爪牙角色，则在该玩家角色标记旁放置「保留能力」标记。");
    g_tipLine[12475] = StringToText("移除时机：亡骨魔死亡或离场，或被标记的玩家角色不再是爪牙角色时移除。");
    g_tipLine[12476] = StringToText("· 中毒");
    g_tipLine[12477] = StringToText("放置时机：与「保留能力」标记一同放置。");
    g_tipLine[12478] = StringToText("放置条件：放置在与此次放置了「保留能力」标记的爪牙玩家邻近的镇民玩家之一的角色标记旁。");
    g_tipLine[12479] = StringToText("特殊说明：动态检测会检查标记有「保留能力」的玩家角色类型是否为爪牙，及与其邻近的镇民玩家是哪一玩家。");
    g_tipLine[12480] = StringToText("  一旦标记了此「中毒」标记的玩家不再是放置了「保留能力」标记的邻近的镇民玩家之一，就需要移动「中毒」");
    g_tipLine[12481] = StringToText("  标记至与「保留能力」的爪牙玩家同一侧的满足条件的玩家角色标记旁（不会因此将「中毒」标记替换到爪牙玩家的另一侧去）");
    g_tipLine[12482] = StringToText("  。");
    g_tipLine[12483] = StringToText("移除时机：亡骨魔死亡或离场，或与该中毒标记相对应的被标记了「保留能力」的玩家角色不再是爪牙角色时移除。");
    g_tipLine[12484] = StringToText("【规则细节】");
    g_tipLine[12485] = StringToText("· 相克规则：");
    g_tipLine[12486] = StringToText("  · 主谋：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipLine[12487] = StringToText("【提示与技巧】");
    g_tipLine[12488] = StringToText("· 尽可能早的杀死你的爪牙。如果你在晚上杀死你的爪牙，他们会保留他们的能力。如果你的爪牙在白天死亡，");
    g_tipLine[12489] = StringToText("  跟正常玩家死亡一样失去他们的能力。亲手杀死你的爪牙们来确保在接下来的游戏当中他们的能力能够一直保留。女巫、");
    g_tipLine[12490] = StringToText("  麻脸巫婆或者洗脑师确保能够每晚行动对你的阵营获胜有着极大的帮助。不是让一个又一个的好人因为死亡失去能力（女巫和洗脑师");
    g_tipLine[12491] = StringToText("  ），就是让他们变成另一个角色而失去能力（麻脸巫婆）。梦殒春宵中，在最后时刻到来之前任何可以减少善良阵营得到信息的");
    g_tipLine[12492] = StringToText("  方式，都是有帮助的。");
    g_tipLine[12493] = StringToText("· 耐心的听取善良阵营的玩家暴露的信息。如果他们不怀疑你的爪牙，最好让他们都活着。");
    g_tipLine[12494] = StringToText("  每天你存活的爪牙可以用他们的投票帮助你避免被处决，这是非常有帮助的。在你认为善良阵营玩家可能会处决他们之前，");
    g_tipLine[12495] = StringToText("  杀死一名爪牙不是个好的选择。");
    g_tipLine[12496] = StringToText("· 在夜间，尽快杀死一个即将被处决的善良阵营玩家。因为如果你杀死了可疑的善良玩家，");
    g_tipLine[12497] = StringToText("  其他人会认为亡骨魔存在于游戏中且认为死去的玩家是一个爪牙。这对于邪恶阵营来说是个扰乱局势的好方法。");
    g_tipLine[12498] = StringToText("  如果他们认为那名善良阵营的玩家是个爪牙，其他人就不会听取那名玩家说出的信息，");
    g_tipLine[12499] = StringToText("  甚至认为该玩家死前分享的信息的反面才是真的。并且也不再信任该名玩家。如果钟表匠或城镇公告员在游戏中，");
    g_tipLine[12500] = StringToText("  他们的信息将会被误导因为他们会分不清谁是真正的是爪牙。如果善良阵营团队已经通过筑梦师、");
    g_tipLine[12501] = StringToText("  博学者或者艺术家获取的信息推测出亡骨魔存在游戏中，那么这个策略是非常有效的。");
    g_tipLine[12502] = StringToText("· 杀死女巫、麻脸巫婆或者洗脑师可以让他们在死后依然保留他们的能力。杀死镜像双子意味着如果善良的双子被处决，");
    g_tipLine[12503] = StringToText("  好人还是会输掉游戏。然而，因为大部分的玩家都不会处决仅存的双子，他们可能需要你帮助说服他们这样做。");
    g_tipLine[12504] = StringToText("  在夜晚杀死镜像双子会消除善良团队通过处决双子来确定谁是善良谁是邪恶的可能性——让善良团队获取的信息越少对邪恶阵营");
    g_tipLine[12505] = StringToText("  越有利。");
    g_tipLine[12506] = StringToText("· 如果你的镜像双子被好人团队怀疑且即将会被处决，那么就在提名处决之前的晚上，杀死他们。双子死在夜晚是最好的，");
    g_tipLine[12507] = StringToText("  因为这会让好人疑惑你是否真的杀死了善良阵营的双子。还有额外的收获是让镇民中毒，这对邪恶阵营来说是很有帮助的。");
    g_tipLine[12508] = StringToText("· 如果你不知道选择该杀哪一个爪牙，那就选择一个旁边有特别麻烦的镇民的爪牙，这样说书人就可以让他们中毒。");
    g_tipLine[12509] = StringToText("  让一个对邪恶阵营很有威胁的镇民活着且获得虚假的信息通常比让他们死亡更有好。");
    g_tipLine[12510] = StringToText("· 因为你的存在会使场上减少一个外来者，你知道这一点，所以把自己伪装成一个外来者是一个非常容易和有效的。");
    g_tipLine[12511] = StringToText("  更好的方式是告诉你的爪牙让他去伪装成外来者。死在夜里的爪牙通常会被认为是值得信赖的玩家，");
    g_tipLine[12512] = StringToText("  所以如果他们声称自己是呆瓜或者是心上人，那么他们会提供给善良阵营更多的错误信息，但是。");
    g_tipLine[12513] = StringToText("  假装自己是个贤者也是被杀害的爪牙可以伪装的绝佳选择。");
    g_tipLine[12514] = StringToText("【对抗亡骨魔】");
    g_tipLine[12515] = StringToText("· 一定要留意死在夜里的玩家。如果玩家的死亡顺序按照有用程度降序死亡，那么可能本局游戏并没有亡骨魔在游戏中，");
    g_tipLine[12516] = StringToText("  这时候应该思考一下恶魔是否是涡流、方古或者诺-达鲺。然而如果玩家们的死亡看似是随机的时候，");
    g_tipLine[12517] = StringToText("  或者是这些玩家很快就将会被你的团队处决时，可能亡骨魔就在游戏之中。观察谁死在夜里以及听听他们的发言。");
    g_tipLine[12518] = StringToText("  如果你能找到哪些死亡的玩家是爪牙，你就可以根据他们的信息反向推理，因为大部分死去的爪牙都会撒谎。");
    g_tipLine[12519] = StringToText("· 游戏的最后一天是最容易发现亡骨魔存在游戏中的。在梦殒春宵中，爪牙的行为是非常容易被察觉的。");
    g_tipLine[12520] = StringToText("  女巫会在人们提名时杀死他们，大部分被麻脸巫婆改变过角色的玩家也会告诉大家。");
    g_tipLine[12521] = StringToText("  如果到了最后一天爪牙任然在活跃地使用他们的能力，那么可能有亡骨魔存在游戏之中。");
    g_tipLine[12522] = StringToText("  如果只有3名玩家存活且昨晚有2个爪牙行动了，那么你就能知道场上一定有亡骨魔，因为如果两个爪牙都存活，");
    g_tipLine[12523] = StringToText("  那就意味着没有善良阵营的玩家存活了。");
    g_tipLine[12524] = StringToText("· 如果集骨者存在，请一定小心。他会造成场上存在亡骨魔的假象。");
    g_tipLine[12525] = StringToText("· 如果你认为你知道哪些死去的玩家是爪牙，那么学会运用这些有利的信息。例如，如果你知道谁是死去的爪牙，");
    g_tipLine[12526] = StringToText("  钟表匠就能告诉你恶魔可能是谁。艺术家能够告诉你恶魔和爪牙的关系，或者确认你的怀疑是否正确。");
    g_tipLine[12527] = StringToText("  一个城镇公告员的信息能够告诉你你是否是正确的，如果他们的信息和你的推测不一致，那么该玩家可能不是城镇公告员。");
    g_tipLine[12528] = StringToText("· 如果亡骨魔存在于游戏之中，那么你可以大胆放心的假设当仅存3名玩家存活时，其中2名玩家是善良的。这是非常棒的事情，");
    g_tipLine[12529] = StringToText("  因为这样你就知道他们的所有信息不可能都是错误的。没有涡流或诺-达鲺搅浑局势，");
    g_tipLine[12530] = StringToText("  就可以确定三名玩家中只有一个玩家的信息是假的。你有两个独立的假设——要么所有的玩家都在说实话（可能），");
    g_tipLine[12531] = StringToText("  要么两名玩家在说实话（可能），另一个在说谎。检验三名玩家所阐述的内容，看看他们在哪里会有逻辑冲突。");
    g_tipLine[12532] = StringToText("  你可能会遇到这样的情况：「如果A是真的，那B一定为真。如果B为真，那么C必须也为真。C为假，所以A为假。」");
    g_tipLine[12533] = StringToText("  此时你可能无法通过这种方法确定谁是恶魔，但是从你假设他们中有2至3名玩家都在说真话开始，");
    g_tipLine[12534] = StringToText("  你可以准确的找到这三名玩家中谁是最像好人的。确定谁是那个好人，就像确认谁是邪恶的玩家是一样有所帮助的。");
    g_tipLine[12535] = StringToText("· 如果一个玩家看起来像得到了错误的信息，但大多数玩家都没有错误，此时存在游戏之中的恶魔要么可能是亡骨魔，");
    g_tipLine[12536] = StringToText("  要么可能是诺-达鲺。无论哪种方式，开始处决邻近得到假信息的镇民的玩家——要么可能处决了诺-达鲺，");
    g_tipLine[12537] = StringToText("  要么你会得知亡骨魔在场。");
    g_tipLine[12538] = StringToText("· 当一个镇民突然开始获得假信息，他们通常是由于亡骨魔中毒了或者是心上人醉酒了。");
    g_tipLine[12539] = StringToText("  涡流和诺-达鲺是从游戏一开始就会让玩家获得假信息。如果你能确定一个获得真信息的镇民现在得到的是假信息，");
    g_tipLine[12540] = StringToText("  那么你也能确定在晚上死亡的玩家是一个爪牙。知道谁是爪牙是非常有用的，尤其是与场上的钟表匠、城镇公告员、筑梦师、");
    g_tipLine[12541] = StringToText("  女裁缝或者杂耍艺人的信息相结合。");
    g_tipRoleAt[69] = 12438; g_tipRoleN[69] = 104; g_tipP1At[69] = 12441; g_tipP1N[69] = 12; g_tipP2At[69] = 12484; g_tipP2N[69] = 3;
    g_tipAbility[69] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipLine[12542] = StringToText("【背景故事】");
    g_tipLine[12543] = StringToText("「彼因汝之罪孽，吾已嗅汝之恶臭满溢全身。时日曷丧？予及汝皆亡。竖子命如草芥，以吾之力，使汝终末于深海，");
    g_tipLine[12544] = StringToText("  终于此良夜。」");
    g_tipLine[12545] = StringToText("【角色能力】");
    g_tipLine[12546] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[12547] = StringToText("与你邻近的两名镇民中毒。");
    g_tipLine[12548] = StringToText("【角色简介】");
    g_tipLine[12549] = StringToText("诺-达鲺会使与它邻近的镇民中毒。");
    g_tipLine[12550] = StringToText("· 在诺-达鲺顺时针和逆时针方向上最近的镇民中毒，无论这些镇民是存活还是死亡。");
    g_tipLine[12551] = StringToText("  如果诺-达鲺死亡或者因为其他原因失去能力，那么这两名镇民玩家恢复健康。总是会有两名镇民玩家因此中毒，");
    g_tipLine[12552] = StringToText("  诺-达鲺的效果会跳过与他相邻的非镇民角色。");
    g_tipLine[12553] = StringToText("· 如果有玩家成为新的诺-达鲺，或一个中毒的镇民变成了一个非镇民角色，都会根据新位置关系立刻改变中毒的玩家。");
    g_tipLine[12554] = StringToText("【范例】");
    g_tipLine[12555] = StringToText("在游戏开始时，诺-达鲺与城镇公告员和舞蛇人相邻，这两名玩家都中毒了。几天之后，他们都死了，");
    g_tipLine[12556] = StringToText("  与诺-达鲺最近的存活玩家变为了钟表匠和理发师，但他们不会受到诺-达鲺的影响。");
    g_tipLine[12557] = StringToText("诺-达鲺顺时针方向依次坐着哲学家，数学家和贤者。诺-达鲺逆时针方向依次坐着女巫，畸形秀演员和女裁缝。");
    g_tipLine[12558] = StringToText("  哲学家和女裁缝中毒了。");
    g_tipLine[12559] = StringToText("麻脸巫婆将死亡的诺-达鲺变成了卖花女孩。下个夜晚，麻脸巫婆将存活的方古变成了诺-达鲺。");
    g_tipLine[12560] = StringToText("  这个新的诺-达鲺现在使与他邻近的两个镇民玩家中毒。");
    g_tipLine[12561] = StringToText("【运作方式】");
    g_tipLine[12562] = StringToText("在为首个夜晚进行准备时，让两名与诺-达鲺邻近的镇民玩家中毒——在他们角色标记旁放置「中毒」提示标记。");
    g_tipLine[12563] = StringToText("如果一名被诺-达鲺影响的镇民变成了一个非镇民角色，或者诺-达鲺变成了另一个角色，");
    g_tipLine[12564] = StringToText("  或者如果一个新的玩家变成了诺-达鲺，都会让与诺-达鲺现在邻近的镇民中毒，而之前邻近但现在不邻近的镇民恢复健康。");
    g_tipLine[12565] = StringToText("  如有需要，立即移除诺-达鲺的「中毒」提示标记。");
    g_tipLine[12566] = StringToText("除首个夜晚外的每个夜晚，唤醒诺-达鲺。让诺-达鲺指向一名玩家。该玩家死亡，在他角色标记旁放置「死亡」提示标记。");
    g_tipLine[12567] = StringToText("  让诺-达鲺重新入睡。");
    g_tipLine[12568] = StringToText("【提示标记】");
    g_tipLine[12569] = StringToText("· 死亡");
    g_tipLine[12570] = StringToText("放置时机：在诺-达鲺夜晚行动并选择了玩家后放置。");
    g_tipLine[12571] = StringToText("放置条件：诺-达鲺选择的玩家当前存活，且能被诺-达鲺杀死，且诺-达鲺未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[12572] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[12573] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[12574] = StringToText("· 中毒");
    g_tipLine[12575] = StringToText("放置时机：在为首个夜晚做准备时放置，或有新的诺-达鲺出现时立即放置。");
    g_tipLine[12576] = StringToText("放置条件：放置在与诺-达鲺邻近的两名镇民玩家的角色标记旁。");
    g_tipLine[12577] = StringToText("特殊说明：动态检测会检查诺-达鲺及与其邻近的镇民玩家是哪些玩家。一旦诺-达鲺及其邻近的玩家角色的座次或角色发生变");
    g_tipLine[12578] = StringToText("  化，就需要移动「中毒」标记至满足条件的玩家角色标记旁。");
    g_tipLine[12579] = StringToText("移除时机：诺-达鲺死亡或离场时移除。");
    g_tipLine[12580] = StringToText("【提示与技巧】");
    g_tipLine[12581] = StringToText("· 找到谁是那个与你相邻的镇民。你可能坐在了爪牙、旅行者或者外来者的旁边，所以你可能不会立即发现你会让谁中毒。");
    g_tipLine[12582] = StringToText("· 一旦知道与你相邻的镇民是谁，就要尽可能地支持他们，听他们说。向其他玩家重复他们的观点。由于他们中毒了，");
    g_tipLine[12583] = StringToText("  他们的信息可能是假的，传播他们的假信息将会使其他人看起来很可疑，尤其是最初宣称这些假信息的不是你。");
    g_tipLine[12584] = StringToText("· 在夜里，不要杀害与你相邻的人。因为他们中毒了，他们活得越久，没有中毒的镇民就死的越多，游戏中错误信息就越多，");
    g_tipLine[12585] = StringToText("  你获胜的机会就越大。");
    g_tipLine[12586] = StringToText("· 如果大家开始认为诺-达鲺在游戏之中，那就杀掉与你相邻的人吧。这样做会让局势看起来像是其他人是诺-达鲺，");
    g_tipLine[12587] = StringToText("  或者至少让你看起来是个不同于诺-达鲺的其他恶魔。");
    g_tipLine[12588] = StringToText("· 如果所有的邪恶阵营玩家都在传播假信息，那么有时候看起来像是涡流在游戏之中。");
    g_tipLine[12589] = StringToText("  提出场上实际存在的恶魔是涡流的依据会使场上其余好人玩家不信任自己的信息是正确的，而且那会使你起来像好人。");
    g_tipLine[12590] = StringToText("【对抗诺-达鲺】");
    g_tipLine[12591] = StringToText("· 诺-达鲺的毒会跳过爪牙、外来者和旅行者。多亏这一点，诺-达鲺不需要和你相邻就能够使你中毒。");
    g_tipLine[12592] = StringToText("· 在极少数情况下，诺-达鲺最近的镇民可能会改变——这要多亏于理发师或者麻脸巫婆这样的角色。当这种情况发生时，");
    g_tipLine[12593] = StringToText("  最近的一位新镇民将会中毒。例如，恶魔坐在了卖花女孩的旁边，他们的旁边是博学者。卖花女孩因此中毒。在晚上，");
    g_tipLine[12594] = StringToText("  麻脸巫婆将卖花女孩变成了呆瓜。由于呆瓜是一个外来者，所以新的一位最靠近恶魔的镇民就是博学者，他从现在开始中毒。");
    g_tipLine[12595] = StringToText("  另一个例子——离恶魔最近的角色是他们的一个爪牙，即一个被恶魔选择与舞蛇人互换角色的女巫。现在，");
    g_tipLine[12596] = StringToText("  这个新的邪恶的舞蛇人变成了与恶魔最相邻的镇民角色，他变成了中毒的镇民，数学家不再中毒。");
    g_tipLine[12597] = StringToText("· 梦殒春宵里有一些错误信息来源，但是如果你是个镇民角色，并且怀疑你的信息受到了干扰，");
    g_tipLine[12598] = StringToText("  那么你应该从仔细观察与你相邻的玩家开始，看看他们是否有可疑之处。如果诺-达鲺是中毒的来源，");
    g_tipLine[12599] = StringToText("  那么他如果要发挥他的能力，就必须要靠近你。");
    g_tipLine[12600] = StringToText("· 根据游戏的规模（游玩人数），区分在场恶魔是否为诺-达鲺应该是比较容易的。举个例子，如果在场的恶魔是亡骨魔，");
    g_tipLine[12601] = StringToText("  那么大部分的镇民信息应该都是合理且构成逻辑链的。这种时候你就可以大方排除涡流或者亡骨魔的可能性。");
    g_tipLine[12602] = StringToText("  如果部分镇民甚至全部人的信息都极其不合理，你就应该考虑到诺-达鲺与涡流的可能性。区分以下三种情况：");
    g_tipLine[12603] = StringToText("  所有的信息都是错误的、部分信息是错误的、有玩家故意给出错误信息，是帮助你们轻松取胜或者惨败的关键。");
    g_tipLine[12604] = StringToText("· 想出一个我们还没想到的很酷且有趣的策略，然后联系我们并发布到钟楼百科上！");
    g_tipRoleAt[70] = 12542; g_tipRoleN[70] = 63; g_tipP1At[70] = 12545; g_tipP1N[70] = 9; g_tipP2At[70] = 0; g_tipP2N[70] = 0;
    g_tipAbility[70] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。与你邻近的两名镇民中毒。");
    g_tipLine[12605] = StringToText("【背景故事】");
    g_tipLine[12606] = StringToText("「黑白颠倒，对错不再，左右变换，长短无猜。万物紊乱无可寻，短视死亡把命栽，何处寻答？随我来。」");
    g_tipLine[12607] = StringToText("【角色能力】");
    g_tipLine[12608] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[12609] = StringToText("镇民玩家的能力都会产生错误信息。");
    g_tipLine[12610] = StringToText("如果白天没人被处决，邪恶阵营获胜。");
    g_tipLine[12611] = StringToText("【角色简介】");
    g_tipLine[12612] = StringToText("涡流使所有信息变得错误。");
    g_tipLine[12613] = StringToText("· 任何时候角色是镇民的玩家通过能力获取信息时，他们会得知错误信息。哪怕他们醉酒或中毒，信息也一定是错误的。");
    g_tipLine[12614] = StringToText("· 涡流不会影响其他人通过其他方式获得的信息，例如说书人解释的规则或玩家的角色或阵营的变化。");
    g_tipLine[12615] = StringToText("· 当夜晚降临时，如果今天白天没有人被处决，邪恶阵营胜利。流放旅行者不算在内。");
    g_tipLine[12616] = StringToText("【范例】");
    g_tipLine[12617] = StringToText("涡流杀死了贤者。贤者得知了两名玩家，他们都不是恶魔。");
    g_tipLine[12618] = StringToText("白天没有人投票或提名，但是畸形秀演员被处决了。当晚，卖花女孩和城镇公告员都得知「是」。");
    g_tipLine[12619] = StringToText("在白天，博学者得知了两条信息。两条都是错误的。当晚，筑梦师选择那名博学者玩家，并得知这名玩家是哲学家或诺-达鲺。");
    g_tipLine[12620] = StringToText("麻脸巫婆将杂耍艺人变成女巫。杂耍艺人得知他现在是善良女巫，因为这个信息来自于玩家的角色变化，而非镇民的能力。");
    g_tipLine[12621] = StringToText("涡流在场。今天白天，一名玩家因为女巫能力死亡，两个旅行者被流放，进行了五次提名，但没有人被处决。邪恶阵营胜利。");
    g_tipLine[12622] = StringToText("【运作方式】");
    g_tipLine[12623] = StringToText("只要涡流存活，每当有镇民因为能力需要你提供信息，你就必须提供错误信息。");
    g_tipLine[12624] = StringToText("除首个夜晚外的每个夜晚，唤醒涡流。让涡流指向一名玩家，将该玩家杀死。该玩家死亡，在他角色标记旁放置「死亡」");
    g_tipLine[12625] = StringToText("  提示标记。让涡流重新入睡。");
    g_tipLine[12626] = StringToText("每个黄昏，如果今天白天没有玩家被处决，游戏结束，邪恶阵营获胜。");
    g_tipLine[12627] = StringToText("【提示标记】");
    g_tipLine[12628] = StringToText("· 死亡");
    g_tipLine[12629] = StringToText("放置时机：在涡流夜晚行动并选择了玩家后放置。");
    g_tipLine[12630] = StringToText("放置条件：涡流选择的玩家当前存活，且能被涡流杀死，且涡流未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[12631] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[12632] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[12633] = StringToText("【规则细节】");
    g_tipLine[12634] = StringToText("· 相克规则：");
    g_tipLine[12635] = StringToText("  · 报丧女妖：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的‘通用简化原则’已涵盖包括多角色互动下的");
    g_tipLine[12636] = StringToText("    涡流信息的简化处理方式，此条仅作说明。）");
    g_tipLine[12637] = StringToText("【提示与技巧】");
    g_tipLine[12638] = StringToText("· 作为一个恶魔，你有两个非常明显的优势——迫使善良阵营进行处决（否则直接结束游戏！）以及迫使所有镇民的信息为假。");
    g_tipLine[12639] = StringToText("  这种致命的组合让你成为名单上最可怕的恶魔——即使谈及你是否存在也会让你的敌人战战兢兢。");
    g_tipLine[12640] = StringToText("  不过要小心——你不是无懈可击的，如果善良阵营玩家知道你在场发挥了作用，那么他们可以通过获取的错误信息反向推测，");
    g_tipLine[12641] = StringToText("  并在很短的时间内将你的邪恶阵营统统打包处决掉！");
    g_tipLine[12642] = StringToText("· 提供真实信息来掩盖你涡流能力的存在。在梦殒春宵中，很多信息都是两面性的，");
    g_tipLine[12643] = StringToText("  除非善良阵营愿意使用一些非常强大的能力（例如艺术家或者杂耍艺人），否则很难准确地确认你是否在场。");
    g_tipLine[12644] = StringToText("  这意味着很难马上确认是真是假。混入真实/可以证明的信息来扰乱局势，将让你看起来非常值得信任，");
    g_tipLine[12645] = StringToText("  且能让善良阵营对涡流是否在场感到困惑。");
    g_tipLine[12646] = StringToText("· 如果善良阵营已经一致认为场上存在涡流，不要绝望——只需你调整展示明显虚假的信息，");
    g_tipLine[12647] = StringToText("  这样会让你更方便的融入那些同样获得虚假信息的好人之中！人们通常会选择相信同样被涡流能力影响的人，");
    g_tipLine[12648] = StringToText("  如果你证明你的信息同样也受到干扰的话。");
    g_tipLine[12649] = StringToText("· 你可以说服场上没有涡流，让他们不要处决玩家来证明这一点，但是这是非常困难的。");
    g_tipLine[12650] = StringToText("  这通常需要一个非常强有力的能力来说服大家，例如艺术家或者筑梦师，他们可以比其他能力更好的判断出是否自己得到了错误");
    g_tipLine[12651] = StringToText("  的信息。除非你真的觉得好人方会接受你的这个逻辑/行为，不然不要做这种冒险的举动——大部分玩家都会对放弃处决持有谨");
    g_tipLine[12652] = StringToText("  慎的态度，尤其是当任何信息都看起来令人迷惑或不可靠时。尽管如此，以这种方式取得胜利时非常令人满意的。");
    g_tipLine[12653] = StringToText("· 在你展示你的伪装信息之前，先了解一下好人玩家都有什么角色在场——你可能会根据他们的动作改变你的策略。");
    g_tipLine[12654] = StringToText("  如果善良的玩家发现了你存在于游戏之中，并开始寻找不符合这种说法的人，");
    g_tipLine[12655] = StringToText("  那么带着真实信息出现在视野之中可能会适得其反！");
    g_tipLine[12656] = StringToText("· 告诉你的爪牙你是哪个恶魔——他们也可能会收集角色的信息，知道你的能力在场上发挥作用是很重要的，");
    g_tipLine[12657] = StringToText("  因为他们可能会调整他们的伪装信息来使自己值得相信。");
    g_tipLine[12658] = StringToText("【对抗涡流】");
    g_tipLine[12659] = StringToText("· 不要惊慌！涡流表面上看起来很吓人，但是只要善良阵营是聪明的，涡流可能会提供一个比角色表上的其他恶魔更简单的挑战。");
    g_tipLine[12660] = StringToText("  即使你完全搞不懂场上的局势，一旦场上只剩下三名玩家存活，你也有三分之一的几率杀死恶魔。所以，");
    g_tipLine[12661] = StringToText("  这听起来没有那么令人害怕。");
    g_tipLine[12662] = StringToText("· 作为一个团队，你可以通过分享信息来判断场上是否有涡流在场。善良玩家提供的信息越多，就越容易发现涡流在场，");
    g_tipLine[12663] = StringToText("  因为这些信息并没有叠加串联起来形成有用的信息链。一到两条奇怪的信息很容易被当成是诺-达鲺、");
    g_tipLine[12664] = StringToText("  心上人或者一个邪恶的玩家在说谎造成的，但是五到六条对不上的信息通常证明了是涡流存在于游戏之中。");
    g_tipLine[12665] = StringToText("  一旦你发现了涡流存在游戏之之中，即使你不知道恶魔是哪位玩家，这也是善良团队的优势。");
    g_tipLine[12666] = StringToText("· 如果你发现涡流在游戏之中发挥着作用，那么所有的信息都是虚假的。这听起来很糟糕，但是那实际上非常有用！有了涡流，");
    g_tipLine[12667] = StringToText("  信息不再可能是真的。这意味着心上人或者哲学家让你醉酒了，他们也不能得到真实的信息。");
    g_tipLine[12668] = StringToText("  知道所有的信息100%都是假的，意味着你可以简单地把这些信息反过来，这就是真实有效的。例如，");
    g_tipLine[12669] = StringToText("  如果你不知道哪个恶魔在场发挥着作用，卖花女孩说恶魔没有投票，城镇公告员说爪牙没有提名，");
    g_tipLine[12670] = StringToText("  女裁缝说卖花女孩和城镇公告员是不同阵营的，那么这中间就包含了太多的可能性，这是非常混乱的。");
    g_tipLine[12671] = StringToText("  但是如果你知道了涡流在场，那么卖花女孩就知道恶魔投票了，城镇公告员就知道爪牙提了名，");
    g_tipLine[12672] = StringToText("  女裁缝就知道卖花女孩和城镇公告员是同一阵营。这对你的信息有了确定性的帮助（即使你必须不断地将假的信息转变为真的信");
    g_tipLine[12673] = StringToText("  息）。");
    g_tipLine[12674] = StringToText("· 没有进行处决的话，游戏直接结束。不要跳过处决阶段除非你真的确定没有涡流在场。（涡流之所以有这么强大的能力，");
    g_tipLine[12675] = StringToText("  是为了防止善良阵营故意在第一天不提名处决，让神谕者、卖花女孩和城镇公告员得到错误的信息，以此确定涡流的存在。）");
    g_tipLine[12676] = StringToText("  善良团队就应该每天进行提名处决以防止真的涡流在场。显然，处决掉邪恶的玩家最好，");
    g_tipLine[12677] = StringToText("  但是处决掉善良的玩家比直接输掉比赛要好得多。");
    g_tipLine[12678] = StringToText("· 如果在涡流存在的游戏中有任何的玩家提供了真实的信息，请处决掉他们。因为他们在说谎。说谎只意味着一件事，");
    g_tipLine[12679] = StringToText("  他们是邪恶的玩家想要掩盖涡流存在的事实从而扰乱场上的局势。或者他们是舞蛇人、");
    g_tipLine[12680] = StringToText("  贤者或者畸形秀演员因为某些原因在隐藏自己的角色从而编造的谎言。但他们是邪恶的可能性更大。");
    g_tipLine[12681] = StringToText("· 有些角色更善于感知涡流是否在场。因为涡流强制所有的信息都是假的，所以你可以尝试创造这样一种情况，");
    g_tipLine[12682] = StringToText("  即你的信息预期会产生特定的结果，并查看你是否得到了这样的结果。举一些例子包括艺术家（问一个是/否问题）、");
    g_tipLine[12683] = StringToText("  杂耍艺人（仅仅猜测他自己）、筑梦师（可以选择信任的玩家然后看信息是否相匹配）、");
    g_tipLine[12684] = StringToText("  卖花女孩（让所有人都投票——如果你得到的是恶魔没有投票，你就得知你的信息是错误的）、");
    g_tipLine[12685] = StringToText("  城镇公告员（在一天内只有一个人提名——如果你被告知有爪牙提名，你应该知道如何去做了吧）");
    g_tipLine[12686] = StringToText("  或者女裁缝（选择两个你确定知道结果的玩家发动你的能力——尤其是当场上存在镜像双子的时候！）");
    g_tipLine[12687] = StringToText("· 要小心诺-达鲺、哲学家和心上人——多亏了他们的能力能导致中毒或者醉酒，有些人能得到错误的信息。");
    g_tipLine[12688] = StringToText("  如果你认为你得到了错误的信息，试着找出这个来源是影响着整场游戏还是仅仅只是影响了你。");
    g_tipLine[12689] = StringToText("· 并非所有能接收信息的角色都能被涡流影响。比如，舞蛇人将会得知谁不是恶魔这是因为他的能力带来的副作用效果。");
    g_tipLine[12690] = StringToText("  正因为如此，他们的信息在涡流在场时会被认为是真实的。");
    g_tipRoleAt[71] = 12605; g_tipRoleN[71] = 86; g_tipP1At[71] = 12607; g_tipP1N[71] = 9; g_tipP2At[71] = 12633; g_tipP2N[71] = 4;
    g_tipAbility[71] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。镇民玩家的能力都会产生错误信息。如果白天没人被处决，邪恶阵营获胜。");
    g_tipLine[12691] = StringToText("【背景故事】");
    g_tipLine[12692] = StringToText("「再来点热量！高点！高点！再高点！啊~从这上面往下看，风景真美，你说呢？你能看见孩子们在河边柳树下钓鱼吗？");
    g_tipLine[12693] = StringToText("  你能看到马戏团帐篷杆上反射的阳光吗？这是什么？一位老人孤身一人在葡萄园里昏倒了？少来点热量！低点！低点！再低点！");
    g_tipLine[12694] = StringToText("  」");
    g_tipLine[12695] = StringToText("【角色能力】");
    g_tipLine[12696] = StringToText("每个夜晚，你会得知一名与上个夜晚得知的玩家角色类型不同的玩家。[+0~1外来者]");
    g_tipLine[12697] = StringToText("【角色简介】");
    g_tipLine[12698] = StringToText("气球驾驶员能得知不同角色类型的玩家。");
    g_tipLine[12699] = StringToText("· 气球驾驶员每次必须得知不同于上一次得知玩家的角色类型的玩家。");
    g_tipLine[12700] = StringToText("· 气球驾驶员不会得知玩家的角色类型。");
    g_tipLine[12701] = StringToText("· 向气球驾驶员展示的玩家可以存活或死亡。");
    g_tipLine[12702] = StringToText("· 向气球驾驶员展示的玩家可以善良或邪恶。");
    g_tipLine[12703] = StringToText("· 如果气球驾驶员中毒或醉酒，他可以得知与上一次得知玩家的角色类型相同的玩家。如果之后气球驾驶员恢复了健康清醒，");
    g_tipLine[12704] = StringToText("  他们必须得知与上一次得知玩家的角色类型不同的玩家。");
    g_tipLine[12705] = StringToText("· 设置调整阶段，说书人可以决定是否让气球驾驶员添加一名额外的外来者。");
    g_tipLine[12706] = StringToText("【范例】");
    g_tipLine[12707] = StringToText("小艾是维齐尔，小莱是女祭司，小美是政客。首个夜晚，气球驾驶员得知了小艾。第二个夜晚，气球驾驶员得知了小莱。");
    g_tipLine[12708] = StringToText("  第三个夜晚，气球驾驶员得知了小美。");
    g_tipLine[12709] = StringToText("小朱是守夜人，小艾是士兵，小兰是解谜大师。首个夜晚，气球驾驶员得知了小朱。第二个夜晚，投毒者选择了气球驾驶员。");
    g_tipLine[12710] = StringToText("  由于气球驾驶员中毒了，说书人决定让气球驾驶员得知了另一个镇民小艾。第三个夜晚，");
    g_tipLine[12711] = StringToText("  气球驾驶员恢复了健康清醒并得知与小艾不同角色类型的小兰。");
    g_tipLine[12712] = StringToText("【运作方式】");
    g_tipLine[12713] = StringToText("在设置调整阶段，你可以额外增加一名外来者。");
    g_tipLine[12714] = StringToText("在为首个夜晚进行准备时，将「得知」提示标记放置在任意一名玩家的角色标记旁。之后每个夜晚的准备阶段，将「得知」");
    g_tipLine[12715] = StringToText("  提示标记放置在一名与当前放置着该提示标记的角色类型不同的玩家角色标记旁。");
    g_tipLine[12716] = StringToText("每个夜晚，唤醒气球驾驶员。指向被放置「得知」提示标记的玩家。然后让气球驾驶员入睡。");
    g_tipLine[12717] = StringToText("【提示标记】");
    g_tipLine[12718] = StringToText("· 得知");
    g_tipLine[12719] = StringToText("放置时机：在为每个夜晚做准备时放置。");
    g_tipLine[12720] = StringToText("放置条件：首个夜晚放置在任意一名玩家的角色标记旁边；之后的每个夜晚放置在与当前放置着「得知」");
    g_tipLine[12721] = StringToText("  提示标记的角色类型不同的玩家角色标记旁边。");
    g_tipLine[12722] = StringToText("特殊说明：如果气球驾驶员因其他能力得知错误信息（如中毒醉酒）或上个夜晚得知的玩家角色类型发生变化时，");
    g_tipLine[12723] = StringToText("  将该标记移动到给气球驾驶员展示的玩家角色标记旁。");
    g_tipLine[12724] = StringToText("移除时机：气球驾驶员死亡或离场时。");
    g_tipLine[12725] = StringToText("【规则细节】");
    g_tipLine[12726] = StringToText("· 相克规则：");
    g_tipLine[12727] = StringToText("  · 提线木偶：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_tipLine[12728] = StringToText("【提示与技巧】");
    g_tipLine[12729] = StringToText("· 多留心外来者的发言吧！你可能在开局时悄悄地增加了一名外来者——如果你听到有人声称自己是狂热者、告密者或月之子，");
    g_tipLine[12730] = StringToText("  这些信息不仅能帮你证明自己，还能让你更清晰地梳理夜晚所得的信息。");
    g_tipLine[12731] = StringToText("· 每天和昨晚你得知的那位玩家进行讨论，听听他们说自己是什么角色；将他们的说法和你前天获得的信息做个对照，");
    g_tipLine[12732] = StringToText("  看看是否合情合理。");
    g_tipLine[12733] = StringToText("· 别急着立刻公开你的信息。不妨等等——等到局势更清晰、善良玩家更愿意说实话、邪恶玩家已经选好自己的伪装时再出手。");
    g_tipLine[12734] = StringToText("  毕竟，若邪恶玩家知道获得了他们的信息，那他们也许会故意假扮外来者，掩人耳目。");
    g_tipLine[12735] = StringToText("· 选一个你信得过的玩家，每天都把你掌握的信息告诉他。这能帮你在善良阵营中保留信誉，让大家相信你从未说谎。");
    g_tipLine[12736] = StringToText("· 为了活得久一点，可以适当隐藏身份。比如声称自己是报丧女妖或农夫，让邪恶玩家觉得你价值不高，不会优先杀你。");
    g_tipLine[12737] = StringToText("  你活得越久，积累的信息就越有分量。");
    g_tipLine[12738] = StringToText("· 当你积累了好几晚的信息，不妨挑一个你最信任的玩家作为「锚点」——如果你在第三夜认到了筑梦师，且十分信任他，");
    g_tipLine[12739] = StringToText("  那你就能推断出第二晚和第四晚得知的玩家不太可能是镇民。");
    g_tipLine[12740] = StringToText("· 注意剧本中是否存在互动干扰类型的角色，比如间谍和陌客。他们可能会被你当作其他类型的角色。实际上，");
    g_tipLine[12741] = StringToText("  如果你的说书人坏的有些特别（就是特别的坏），他可以每个夜晚都让你看到陌客（请不要这样做！）。");
    g_tipLine[12742] = StringToText("· 留意那些也会判断角色类型的角色，比如图书管理员或城镇公告员。如果你能确认某人一定是外来者，或绝不可能是爪牙，");
    g_tipLine[12743] = StringToText("  那么你的信息就能变得更加精准和强大。");
    g_tipLine[12744] = StringToText("· 除非剧本中存在酒鬼、洗脑师等角色，否则如果你连续两晚得知的玩家都声称自己是镇民，那极有可能其中一位就是邪恶玩家。");
    g_tipLine[12745] = StringToText("  这样的信息就和女裁缝得知这两名玩家不属于同一阵营差不多。");
    g_tipLine[12746] = StringToText("· 仔细看看角色列表上有哪些角色。落难少女大概率不会在存活的时候主动承认自己是外来者，");
    g_tipLine[12747] = StringToText("  而畸形秀演员甚至根本不能说自己是外来者！所以，即使你连续两晚得知的都是自称镇民的玩家，");
    g_tipLine[12748] = StringToText("  也不一定说明其中一定有邪恶玩家。尤其当恶魔是涡流时，你每晚得知的玩家的角色类型就都一样！");
    g_tipRoleAt[72] = 12691; g_tipRoleN[72] = 58; g_tipP1At[72] = 12695; g_tipP1N[72] = 11; g_tipP2At[72] = 12725; g_tipP2N[72] = 3;
    g_tipAbility[72] = StringToText("每个夜晚，你会得知一名与上个夜晚得知的玩家角色类型不同的玩家。[+0~1外来者]");
    g_tipLine[12749] = StringToText("【背景故事】");
    g_tipLine[12750] = StringToText("「等下，你说了啥？谁？哦，没事了。等下，你说了啥？」");
    g_tipLine[12751] = StringToText("【角色能力】");
    g_tipLine[12752] = StringToText("你不知道你的能力是什么。每个白天你可以找说书人猜测一次，你会得知你的猜测有多准确。");
    g_tipLine[12753] = StringToText("【角色简介】");
    g_tipLine[12754] = StringToText("失忆者不会知道他的能力是什么。");
    g_tipLine[12755] = StringToText("· 由说书人来决定失忆者的具体能力。这可以是来自《染·钟楼谜团》中现有角色的能力，也可以是与之相似的能力，");
    g_tipLine[12756] = StringToText("  或是完全原创的能力。");
    g_tipLine[12757] = StringToText("· 失忆者可能会在夜晚的任意时刻被唤醒，以得知信息或者选择玩家。他的能力也可以是被动效果，");
    g_tipLine[12758] = StringToText("  无需失忆者玩家主动做出任何行动。");
    g_tipLine[12759] = StringToText("· 每个白天，失忆者都可以私下拜访说书人，并猜测自己的能力是什么。说书人用以下方式回答失忆者的猜测：「无关」");
    g_tipLine[12760] = StringToText("  代表猜测与实际差距较大，「有关」代表猜测的方向正确，「接近」代表猜测的结果与实际能力较为接近，而「完美」");
    g_tipLine[12761] = StringToText("  代表猜测的结果与实际能力完全相符。");
    g_tipLine[12762] = StringToText("· 失忆者的猜测可以是具体的，例如「我是否是在每个夜晚得知两名阵营相同的玩家？」，也可以是较为模糊的，");
    g_tipLine[12763] = StringToText("  例如「我的能力是否与已死亡的玩家有关？」。");
    g_tipLine[12764] = StringToText("【范例】");
    g_tipLine[12765] = StringToText("每个夜晚，失忆者均被唤醒且在说书人的提示下指向了两名玩家。在第一个夜晚，说书人对他点头。在第二个夜晚，");
    g_tipLine[12766] = StringToText("  说书人对他摇头。失忆者猜测：「我的能力是能够得知我选择的这两名玩家均为爪牙？」说书人告诉他：「接近」，");
    g_tipLine[12767] = StringToText("  因为失忆者的能力是得知这两名玩家之中是否有爪牙。");
    g_tipLine[12768] = StringToText("每个夜晚，失忆者均得知了一个数字。实际上，失忆者得知的是与他邻近的存活镇民玩家的数量。");
    g_tipLine[12769] = StringToText("每个夜晚，失忆者均被展示了一个角色标记。实际上，失忆者得知的是不在场的角色。");
    g_tipLine[12770] = StringToText("【运作方式】");
    g_tipLine[12771] = StringToText("在进行游戏设置时，决定失忆者玩家的能力是什么。在游戏过程中，将那名玩家视作具有该能力一样，在需要的时候将他唤醒，");
    g_tipLine[12772] = StringToText("  在需要的时候提示他选择玩家，或者进行任何其他恰当的操作。如有需要，使用失忆者的「？」提示标记来进行标注。");
    g_tipLine[12773] = StringToText("每个白天，失忆者都可以私下进行一次关于自身能力的猜测。使用「无关」、「有关」、「接近」、「完美」来回答他的猜测。");
    g_tipLine[12774] = StringToText("在决定失忆者的能力时，让这一能力容易被猜测，这样失忆者就可以随着时间的推移而逐渐弄清楚他的能力具体是什么。");
    g_tipLine[12775] = StringToText("  每个夜晚得知一条信息，或以失忆者能够注意到的方式影响游戏的能力，都是关于失忆者能力的不错的主意。");
    g_tipLine[12776] = StringToText("如果失忆者猜到了他的能力，但使用了与你预想不同的措辞，仍然应该告诉他猜对了。");
    g_tipLine[12777] = StringToText("你可以让失忆者的能力比普通镇民的能力稍微强力一些。这是因为在不知道具体能力是什么的前提下，");
    g_tipLine[12778] = StringToText("  玩家需要更加努力才能从自己的能力中获益。");
    g_tipLine[12779] = StringToText("【提示标记】");
    g_tipLine[12780] = StringToText("· ？");
    g_tipLine[12781] = StringToText("失忆者的提示标记的放置时机与条件，以及何时移除，完全取决于说书人为失忆者决定的能力是什么。");
    g_tipLine[12782] = StringToText("【规则细节】");
    g_tipLine[12783] = StringToText("· 失忆者的夜晚行动顺序并非要完全依照在线魔典的原定顺序。说书人应该根据自己为失忆者设定的能力的具体情况，");
    g_tipLine[12784] = StringToText("  来决定失忆者应该在什么顺序被唤醒。通常来说，如果失忆者的能力会造成醉酒/中毒，或是具有一些保护效果，");
    g_tipLine[12785] = StringToText("  或是在较早行动才能获得更多的收益时，应该让失忆者在夜晚靠前的顺序中被唤醒。如果失忆者的能力会得知一些信息，");
    g_tipLine[12786] = StringToText("  或是需要基于一些其他行动来被唤醒，或是在较晚行动才能获得更多的收益时，应该让失忆者在夜晚靠后的顺序中被唤醒。");
    g_tipLine[12787] = StringToText("  但需要注意的是，一旦你决定好失忆者的能力在夜晚的唤醒顺序时，就不应该再擅自改动，");
    g_tipLine[12788] = StringToText("  而是在每个夜晚都以这个顺序来将失忆者唤醒（当然，由于能力的不同，且同一剧本中其他角色首夜和非首夜的顺序差异，");
    g_tipLine[12789] = StringToText("  失忆者在首个夜晚的顺序可能会与其他夜晚有所不同）。");
    g_tipLine[12790] = StringToText("【提示与技巧】");
    g_tipLine[12791] = StringToText("· 多数时候，失忆者的能力是获取信息的能力，但也并非绝对如此。失忆者的能力往往比一般的镇民能力更强大（因为存在无法猜");
    g_tipLine[12792] = StringToText("  中的风险），这让你的能力更显得有用，前提是你能猜测正确。");
    g_tipLine[12793] = StringToText("· 当你拜访说书人进行猜测时，问题可以具体也可以宽泛，但是一般建议玩家从宽泛的问题入手，");
    g_tipLine[12794] = StringToText("  例如「我的能力与外来者有关吗？」，然后再层层深入，例如「我会得知我选择的玩家角色是否以L字母开头？」。");
    g_tipLine[12795] = StringToText("· 大多数失忆者的能力会在夜晚唤醒你并让你选择一名玩家，尝试在每个夜晚选择不同的玩家，");
    g_tipLine[12796] = StringToText("  根据获得的不同结果推断自己的真实能力。");
    g_tipLine[12797] = StringToText("· 在你猜测你的能力时，记得你的能力可能与游戏的任何机制相关联，例如：");
    g_tipLine[12798] = StringToText("  · 角色：是得知谁是特定角色吗？是得知谁是特定角色类型，例如外来者或爪牙吗？");
    g_tipLine[12799] = StringToText("    是得知角色名字是不是以特定的字母开头或结尾吗？是得知角色在剧本页面中的位置吗？");
    g_tipLine[12800] = StringToText("  · 效果：是让其他玩家醉酒吗？能公开选择玩家并对他产生什么效果吗？能在晚上向其他玩家提供信息吗？");
    g_tipLine[12801] = StringToText("    能改变或交换玩家的角色或阵营吗？能阻止或制造玩家的死亡吗？");
    g_tipLine[12802] = StringToText("  · 场面：是得知谁和谁相邻而坐吗？是得知谁和谁相对而坐吗？是得知谁今天提名了吗？是得知谁今天投票了吗？");
    g_tipLine[12803] = StringToText("  · 社交：是得知谁迈向胜利吗？是得知谁在撒谎吗？是得知谁的信息正确吗？");
    g_tipLine[12804] = StringToText("· 随时向大家寻求帮助来揭示你的能力，如果你无法理解你获得的诸如1,3,1,2,1这样的信息代表什么，");
    g_tipLine[12805] = StringToText("  或许你的盟友可以。");
    g_tipLine[12806] = StringToText("· 请记住，说书人一定是试图让你的能力可以很合理地被推理出来，如果你发现你的能力奇怪到开始让你怀疑说书人会不会将其作");
    g_tipLine[12807] = StringToText("  为你的能力，那就应该基于这一原则重新进行猜测。");
    g_tipRoleAt[73] = 12749; g_tipRoleN[73] = 59; g_tipP1At[73] = 12751; g_tipP1N[73] = 13; g_tipP2At[73] = 12782; g_tipP2N[73] = 8;
    g_tipAbility[73] = StringToText("你不知道你的能力是什么。每个白天你可以找说书人猜测一次，你会得知你的猜测有多准确。");
    g_tipLine[12808] = StringToText("【背景故事】");
    g_tipLine[12809] = StringToText("「我讨厌小丑的味道。吃起来会让我想笑。」");
    g_tipLine[12810] = StringToText("【角色能力】");
    g_tipLine[12811] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipLine[12812] = StringToText("【角色简介】");
    g_tipLine[12813] = StringToText("食人族会吃下被处决的角色，并获得他们的能力。");
    g_tipLine[12814] = StringToText("· 如果一名善良玩家死于处决，食人族能获得他的能力。如果一名邪恶玩家死于处决，食人族也只会认为自己获得了能力，");
    g_tipLine[12815] = StringToText("  因为他中毒了，说书人可能会对他撒谎。");
    g_tipLine[12816] = StringToText("· 每当有一名玩家死于处决时，食人族会失去上一次获得的能力。");
    g_tipLine[12817] = StringToText("· 处决一名已经死亡的玩家不会让食人族获得能力。处决一名存活但并未导致死亡的玩家也不会让食人族获得能力。");
    g_tipLine[12818] = StringToText("  玩家必须要被处决并因此死亡，才会让食人族获得能力。");
    g_tipLine[12819] = StringToText("· 食人族不会被告知自己获得了什么能力。他必须自己弄明白。");
    g_tipLine[12820] = StringToText("· 如果食人族获得了「即使你已死亡」的能力，例如陌客，或在死亡后才会生效的能力，例如守鸦人或心上人，");
    g_tipLine[12821] = StringToText("  食人族会在死亡时仍然保留这些能力，但失去食人族自己角色本身的能力。");
    g_tipLine[12822] = StringToText("【范例】");
    g_tipLine[12823] = StringToText("钟表匠被处决并死亡。当晚，食人族得知了「2」，因为恶魔与爪牙之间的最近距离是2。");
    g_tipLine[12824] = StringToText("女巫被处决并死亡，而她之前正谎称自己是调查员。当晚，中毒的食人族得知了镇长和杂耍艺人之中有一人是女巫。");
    g_tipLine[12825] = StringToText("士兵死于处决。当晚，小恶魔攻击了食人族，但食人族没有死亡。随后僧侣死于处决。当晚，食人族和小恶魔都选择了造谣者，");
    g_tipLine[12826] = StringToText("  造谣者没有死亡。在下一个白天，没有人被处决。在当晚，食人族仍然具有僧侣的能力。");
    g_tipLine[12827] = StringToText("【运作方式】");
    g_tipLine[12828] = StringToText("如果一名善良玩家死于处决，用「饱餐」提示标记标记他的角色，并移除食人族的「中毒」标记（如果有的话）。");
    g_tipLine[12829] = StringToText("  现在食人族会拥有这名善良玩家的能力（不要告诉他具体的能力是什么），且夜晚时会在这名玩家原本会被唤醒的时机被唤醒。");
    g_tipLine[12830] = StringToText("如果一名邪恶玩家死于处决，用「饱餐」提示标记标记他的角色，并用「中毒」标记食人族。食人族现在中毒了。");
    g_tipLine[12831] = StringToText("  你可以选择在夜晚时唤醒食人族，并假装他获得了一项新的能力。");
    g_tipLine[12832] = StringToText("请留意每名邪恶玩家正在谎称自己是什么角色。如果他们被处决了，那么他们谎称的那种角色就是你要去假装食人族获得了能力");
    g_tipLine[12833] = StringToText("  的最佳选择。");
    g_tipLine[12834] = StringToText("【提示标记】");
    g_tipLine[12835] = StringToText("· 饱餐");
    g_tipLine[12836] = StringToText("放置时机：在白天时，如果有人因处决而死亡，在该玩家的角色标记旁放置。");
    g_tipLine[12837] = StringToText("放置条件：在因处决而死亡的玩家的角色标记旁放置，而不论此时食人族是否醉酒中毒。");
    g_tipLine[12838] = StringToText("转移时机：在下一名玩家死于处决时，将「饱餐」标记转移到最近被处决的角色旁边。");
    g_tipLine[12839] = StringToText("特殊说明：由于食人族的能力为持续检测型能力，因此如果食人族在游戏中途被创造，仍然要根据当前情况补放标记，");
    g_tipLine[12840] = StringToText("  而不是因为没有放置标记便不让食人族获得能力。");
    g_tipLine[12841] = StringToText("· 中毒");
    g_tipLine[12842] = StringToText("放置时机：有邪恶玩家死于处决，或放置了食人族的「饱餐」标记的角色成为邪恶阵营时。");
    g_tipLine[12843] = StringToText("放置条件：在食人族的角色标记旁放置。");
    g_tipLine[12844] = StringToText("移除时机：当一名善良玩家死于处决时。");
    g_tipLine[12845] = StringToText("特殊说明：如果食人族在游戏中途被创造，且上一名死于处决的玩家是邪恶阵营，仍然要在食人族角色标记旁放置「中毒」");
    g_tipLine[12846] = StringToText("  标记。");
    g_tipLine[12847] = StringToText("【规则细节】");
    g_tipLine[12848] = StringToText("· 如果死于处决的玩家在随后改变角色或转换阵营，同样会被食人族持续检测。");
    g_tipLine[12849] = StringToText("· 特定角色互动：");
    g_tipLine[12850] = StringToText("  · 异教领袖/莽夫：获得这些能力将允许食人族转变阵营，如果有另一名无法转变阵营的玩家在食人族转变为原来阵营之前死于处决");
    g_tipLine[12851] = StringToText("    ，食人族将被锁定为他当前的阵营。");
    g_tipLine[12852] = StringToText("  · 杂耍艺人：如果杂耍艺人死于处决，食人族只能在第二天无人死于处决的情况下从杂耍艺人的能力获得信息。");
    g_tipLine[12853] = StringToText("    在杂耍艺人被处决的下一个白天是食人族杂耍艺人的「首个白天」，所以他必须在当天进行公开猜测，");
    g_tipLine[12854] = StringToText("    并且必须确保无人死于处决。以便食人族杂耍艺人保持他的能力，在当晚得到猜测的结果。");
    g_tipLine[12855] = StringToText("  · 酒鬼：如果食人族获得酒鬼的能力，你可以欺骗食人族是任何镇民，包括酒鬼自以为的那个角色。");
    g_tipLine[12856] = StringToText("  · 疯子：如果食人族获得疯子的能力，你应该告诉食人族，他现在是剧本上的某个恶魔，");
    g_tipLine[12857] = StringToText("    并在疯子的夜晚行动顺序时唤醒食人族进行攻击，之后唤醒恶魔，恶魔得知食人族玩家是疯子以及攻击目标。");
    g_tipLine[12858] = StringToText("  · 畸形秀演员：如果食人族拥有畸形秀演员能力，他可以声称自己是一个拥有畸形秀演员能力的食人族，并且不会被处决，");
    g_tipLine[12859] = StringToText("    因为他没有声称自己是外来者。然而，如果他声称自己是畸形秀演员，他可能会被处决。");
    g_tipLine[12860] = StringToText("  · 政客：如果食人族获得政客的能力，他将与已经死亡的政客发生竞争。因为只有一名玩家能够为自己阵营失败负最大责任，");
    g_tipLine[12861] = StringToText("    所以只有一名玩家可以转变阵营并获胜。");
    g_tipLine[12862] = StringToText("  · 洗脑师：如果一名玩家被洗脑并对特定角色疯狂，他不能声称自己是拥有该角色能力的食人族，");
    g_tipLine[12863] = StringToText("    期望以此逃避违反洗脑疯狂的处决。因为他没有声称自己就是这个角色，这不符合疯狂的要求。");
    g_tipLine[12864] = StringToText("  · 教授/沙巴洛斯：当食人族复活，他将获得最近死于处决的玩家能力。");
    g_tipLine[12865] = StringToText("  · 呆瓜/月之子：参考管家的相克规则，如果食人族玩家在获得这些角色能力的时候死亡，");
    g_tipLine[12866] = StringToText("    且不知道自己是否获得了对应的能力的时候，说书人应该对他进行提醒。即使不进行提醒，也不应该算作是作弊。");
    g_tipLine[12867] = StringToText("· 相克规则：");
    g_tipLine[12868] = StringToText("  · 杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，当晚食人族会替杂耍艺人得知对应的信息。");
    g_tipLine[12869] = StringToText("  · 管家：如果食人族获得了管家的能力，他会得知这一信息。");
    g_tipLine[12870] = StringToText("  · 狂热者：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[12871] = StringToText("  · 公主：如果食人族提名并处决了公主且公主因此死亡，当晚恶魔不会造成死亡。");
    g_tipLine[12872] = StringToText("【提示与技巧】");
    g_tipLine[12873] = StringToText("· 尽量执行处决！虽然处决善良玩家并不好，但是你的能力可以让这一举动的负面影响降低到最小。");
    g_tipLine[12874] = StringToText("  即使你们意外处决了一名善良玩家，你仍可以获取其能力继续帮助团队。");
    g_tipLine[12875] = StringToText("· 请留意那些宣称拥有每局游戏限一次能力的玩家，你可以使用他们的每局游戏限一次能力，");
    g_tipLine[12876] = StringToText("  并在游戏进行中吞噬到更多此类能力。");
    g_tipLine[12877] = StringToText("· 你要注意，任何时候你都不会被告知获得了何种能力，但你可以根据晚上被唤醒后说书人给予你的反馈或指示来判断——比如你");
    g_tipLine[12878] = StringToText("  在夜晚被唤醒要求选择两位玩家，你可能获得了占卜师或是侍女的能力，但你无法确定是哪个（译者注：");
    g_tipLine[12879] = StringToText("  在说书人反馈信息后你应该能够排除其中一种）。");
    g_tipLine[12880] = StringToText("· 如果可以的话，与那些白天即将被处决的玩家交流一下，希冀于能够了解到他们的确切能力。如果他们的能力只能在白天使用，");
    g_tipLine[12881] = StringToText("  例如猎手，而你不知道自己拥有这种能力，你很有可能会错过发动能力的机会。");
    g_tipLine[12882] = StringToText("· 亦或者，在第二天白天再去寻找那些前一天被处决的玩家，告知他们你是食人族然后和他们分享你在夜晚获得的信息，");
    g_tipLine[12883] = StringToText("  从而获取这些玩家的信任。这能够帮助你在被处决的死者群体里获得信任。");
    g_tipLine[12884] = StringToText("· 切记，邪恶玩家可能在被处决前伪装成拥有某个能力，说书人通常会配合他们让你认为自己拥有了那种能力。");
    g_tipRoleAt[74] = 12808; g_tipRoleN[74] = 77; g_tipP1At[74] = 12810; g_tipP1N[74] = 12; g_tipP2At[74] = 12847; g_tipP2N[74] = 25;
    g_tipAbility[74] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipLine[12885] = StringToText("【背景故事】");
    g_tipLine[12886] = StringToText("「还要再来点酒吗？麦角酒庄的这款07年的窖藏非常特别。是的，的的确确很特别。」");
    g_tipLine[12887] = StringToText("【角色能力】");
    g_tipLine[12888] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[12889] = StringToText("【角色简介】");
    g_tipLine[12890] = StringToText("寡妇查看魔典并毒害一名她选择的玩家。");
    g_tipLine[12891] = StringToText("· 寡妇仅在她的首个夜晚行动并使一名玩家中毒。");
    g_tipLine[12892] = StringToText("· 因寡妇中毒的玩家会一直保持中毒直到寡妇死亡。");
    g_tipLine[12893] = StringToText("· 在寡妇行动的那个夜晚，会有一名善良玩家知道寡妇在场，他不会得知谁是寡妇，也不会得知谁中毒了。");
    g_tipLine[12894] = StringToText("【范例】");
    g_tipLine[12895] = StringToText("寡妇查看了魔典，然后指向了魔典上的水手角色标记。水手在本局游戏中中毒。即使水手是清醒状态，也会在被处决时死亡。");
    g_tipLine[12896] = StringToText("在第三个夜晚，麻脸巫婆将自己变成了寡妇。当晚，善良的替罪羊得知寡妇在场。");
    g_tipLine[12897] = StringToText("共情者因为寡妇中毒。旅店老板让寡妇醉酒了，所以共情者不再中毒。随后旅店老板死亡，现在寡妇恢复了清醒，");
    g_tipLine[12898] = StringToText("  共情者又中毒了。");
    g_tipLine[12899] = StringToText("【运作方式】");
    g_tipLine[12900] = StringToText("在为首个夜晚进行准备时，将寡妇的「得知」提示标记放置在任意一名善良玩家旁。");
    g_tipLine[12901] = StringToText("在首个夜晚，唤醒寡妇并对她展示魔典。她可以按照自己意愿的时长来查看魔典。随后，让寡妇指向魔典上的一个角色标记，");
    g_tipLine[12902] = StringToText("  或一名玩家。使用寡妇的「中毒」提示标记标记那名玩家，他开始中毒。让寡妇重新入睡。");
    g_tipLine[12903] = StringToText("然后唤醒那名被放置「得知」的善良玩家。对他展示寡妇角色标记，然后让这名玩家入睡。");
    g_tipLine[12904] = StringToText("【提示标记】");
    g_tipLine[12905] = StringToText("· 中毒");
    g_tipLine[12906] = StringToText("放置时机：在寡妇进行夜晚行动，查看完魔典并选择了一名玩家或魔典上的一个角色标记之后。");
    g_tipLine[12907] = StringToText("放置条件：如果寡妇在选择玩家时清醒健康，则放置在她选择的玩家对应的角色标记旁。");
    g_tipLine[12908] = StringToText("移除时机：寡妇死亡或离场时。");
    g_tipLine[12909] = StringToText("· 得知");
    g_tipLine[12910] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[12911] = StringToText("放置条件：在一名善良玩家的角色标记旁放置。");
    g_tipLine[12912] = StringToText("移除时机：寡妇死亡或离场时。");
    g_tipLine[12913] = StringToText("【规则细节】");
    g_tipLine[12914] = StringToText("· 相克规则：");
    g_tipLine[12915] = StringToText("  · 魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_tipLine[12916] = StringToText("  · 罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[12917] = StringToText("  · 炼金术士：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。每次处决后，");
    g_tipLine[12918] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[12919] = StringToText("  · 落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[12920] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[12921] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[12922] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[12923] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[12924] = StringToText("【提示与技巧】");
    g_tipLine[12925] = StringToText("· 和间谍类似，你在游戏开始时知道所有事情！所有在场的角色以及谁是这些角色，这些内容都躺在魔典里。");
    g_tipLine[12926] = StringToText("  利用这些信息帮助邪恶阵营选择合适的伪装，提供他们无法得知的信息，并干掉高优先级目标。在魔典中，");
    g_tipLine[12927] = StringToText("  你不仅能看到每个人是谁，还能看到说书人的提醒标记，允许你追溯人们在游戏开始时获得的信息。");
    g_tipLine[12928] = StringToText("· 你选择对谁投毒？这是你最应当扪心自问的重要问题。不同于每晚都能观看魔典的间谍，你只能看到一次魔典。");
    g_tipLine[12929] = StringToText("  不同于只能选择某名玩家来投毒的投毒者，你可以选择对某个角色投毒。慢慢思考，看清楚每个角色，尽可能做出最佳选择。");
    g_tipLine[12930] = StringToText("  没有必要太过着急。");
    g_tipLine[12931] = StringToText("· 除了观看魔典之外，你还能对一名玩家投毒！如果你不确定该对谁投毒，就对能获得最多潜在信息的镇民角色投毒。");
    g_tipLine[12932] = StringToText("  这能保证善良阵营在整局游戏中都获得非常糟糕的信息。可以选择对博学者、侍女、");
    g_tipLine[12933] = StringToText("  渔夫或气球驾驶员投毒实在是不容错过的体验。尽力去做吧。（如果你不确定谁是你觉得最厉害的，");
    g_tipLine[12934] = StringToText("  那就选你觉得最能伤到你的人！）");
    g_tipLine[12935] = StringToText("· 如果有一个简单而明显的目标投毒角色可选，那就转而对一个其他角色投毒。因为善良阵营会知道寡妇在场，");
    g_tipLine[12936] = StringToText("  他们会寻找寡妇最明显可能会选择的选项。如果你没有选择最明显的可选项，");
    g_tipLine[12937] = StringToText("  那么善良阵营会假定一名拥有强大信息能力的镇民中毒而他其实没有，同时假定一个可能性较低的角色健康而他其实也不是。");
    g_tipLine[12938] = StringToText("  多么狡诈呀。");
    g_tipLine[12939] = StringToText("· 此外，你可以尝试对一名你认为会指挥小镇讨论的玩家投毒，希望利用他们（现在虚假）的信息来达成你的目的。");
    g_tipLine[12940] = StringToText("· 不要对一名你能转而让恶魔杀死的玩家投毒。比如，当你对厨师投毒时，最好让恶魔杀死占卜师。既然你看过魔典，");
    g_tipLine[12941] = StringToText("  那么在游戏早期就和恶魔沟通杀死哪些玩家就会变得很容易。");
    g_tipLine[12942] = StringToText("· 和你的恶魔协作来让他们不会杀死你投毒的对象——除非那是类似守鸦人这样的角色。");
    g_tipLine[12943] = StringToText("  否则你的中毒可能会在游戏早期就被一名能关注到相同目标的睿智恶魔浪费掉！");
    g_tipLine[12944] = StringToText("· 尽你所能让知道你在场的玩家受到怀疑：如果小镇认为他们在撒谎，他们可能会认为他们在你在场这件事上也在撒谎！");
    g_tipLine[12945] = StringToText("  你可以通过许多社交上的方法来达成这一点，但你也可以尝试用你造成的中毒（对那名玩家本身或是对能够证明那名玩家的镇民");
    g_tipLine[12946] = StringToText("  ）来瓦解那名玩家受到的信任。");
    g_tipLine[12947] = StringToText("· 因为一名玩家知道你在场，否认游戏中有人中毒通常会比论证中毒不在某个地方更难一些。你会给善良阵营带来巨大伤害，");
    g_tipLine[12948] = StringToText("  所以如果没有特别明显的证据的话他们不会放弃你潜伏在游戏中的想法。误导他们谁是中毒者会显得更合理。");
    g_tipLine[12949] = StringToText("· 如果你在一局剧本上有寡妇的游戏中是一名邪恶玩家，一个勇敢但有潜在回报的玩法是宣称你被告知了寡妇在场。");
    g_tipLine[12950] = StringToText("  这能让小镇信任你而在没有真正寡妇在场的情况下怀疑他们自己的能力。");
    g_tipLine[12951] = StringToText("· 在小型（五到八人）游戏中，对首夜能力角色投毒，比如调查员或钟表匠。这能确保你的中毒能带来切实的效果，");
    g_tipLine[12952] = StringToText("  并避免因你中毒的玩家在他们获得错误信息之前被恶魔杀死或被处决。");
    g_tipLine[12953] = StringToText("· 在大型（十二人以上）游戏中，避免对首夜能力角色投毒，转而对每晚都能获得信息的角色投毒，比如侍女或是神谕者，");
    g_tipLine[12954] = StringToText("  或是强力的非信息角色比如贞洁者或旅店老板。在大型游戏中，中毒玩家因为意外地处决或因为恶魔在有机会和你沟通之前就杀");
    g_tipLine[12955] = StringToText("  掉他们而导致死亡的几率要低很多，而你则有更多的机会调和局势来让他们的中毒发挥全部效果。");
    g_tipLine[12956] = StringToText("· 死亡。如果你是存活的寡妇，那一名善良玩家就会中毒。如果你是死亡的寡妇，那那名玩家就不再中毒。");
    g_tipLine[12957] = StringToText("  这可以将持续不断的错误信息转化为持续不断的正确信息——如果善良玩家开始怀疑自己中毒，");
    g_tipLine[12958] = StringToText("  这个方法将会提供一些很有价值的东西。");
    g_tipLine[12959] = StringToText("· 如果寡妇在场，或者寡妇不在场但一名邪恶的玩家说她在，试着说服团队你认为你被寡妇投毒。");
    g_tipLine[12960] = StringToText("  提供真实的信息以获得优秀的二重伪装。如果团队认为你因寡妇中毒，那么你就能让他们相信你是善良的，");
    g_tipLine[12961] = StringToText("  同时将他们的注意力从真正的中毒玩家身上转移。此外，如果你突然宣称获得了正确信息，");
    g_tipLine[12962] = StringToText("  那么就有可能让善良阵营相信你曾经中毒但现在是健康的，进而得出寡妇一定已经死亡的结论！让善良阵营认为你是善良的，");
    g_tipLine[12963] = StringToText("  认为中毒玩家是健康的，认为他们已经杀死了寡妇而实际上并非如此……这些好像麻花一样纷乱缠绕。");
    g_tipLine[12964] = StringToText("· 对你自己投毒来隐藏寡妇在场。一个中毒的寡妇没有能力，因此善良阵营不会得知寡妇在场。");
    g_tipLine[12965] = StringToText("  你不会因为有一名中毒的善良玩家而获得对抗善良阵营的优势，但这能暗示有一个其他的爪牙在场。");
    g_tipLine[12966] = StringToText("  这在单爪牙游戏中会特别有效。比如，如果你在一场七人游戏中对自己投毒并宣称有外来者在场，");
    g_tipLine[12967] = StringToText("  那么这可能会看起来像是男爵在场。");
    g_tipLine[12968] = StringToText("【对抗寡妇】");
    g_tipLine[12969] = StringToText("· 不同于《染》中的其他许多角色，寡妇会自带线索：寡妇的呼唤。如果你核实了一名宣称收到了寡妇呼唤的玩家的阵营，");
    g_tipLine[12970] = StringToText("  那对演绎游戏的各种可能就大有裨益。");
    g_tipLine[12971] = StringToText("· 反之，如果你确信寡妇在场，你就更可以相信宣称收到寡妇呼唤的玩家，因为只有善良玩家能收到这类呼唤。然而，");
    g_tipLine[12972] = StringToText("  也别忘记邪恶玩家仍然可以伪装成收到了！如果你最终面临两名玩家宣称他们得知了寡妇在场，");
    g_tipLine[12973] = StringToText("  你有理由相信其中一名是善良的而另一名是试图欺骗你的邪恶玩家。");
    g_tipLine[12974] = StringToText("· 一名善良玩家知道寡妇在场。如果是你，暂时不要告诉任何人。等待并观察是否有邪恶玩家说他们得知了寡妇在场。");
    g_tipLine[12975] = StringToText("  邪恶玩家常会宣称自己是得知了寡妇在场的善良玩家，在互相之间缺乏沟通的情况下甚至偶尔会公开宣称。");
    g_tipLine[12976] = StringToText("  如果你等到此时才告诉人们你所知道的，并发现自己面临一个重复宣称，这是好消息——你找到了一名邪恶玩家。");
    g_tipLine[12977] = StringToText("  或者至少是一名有切实理由欺骗善良阵营的善良玩家，比如疯子或莽夫。");
    g_tipLine[12978] = StringToText("· 一旦善良阵营得知寡妇在场，鼓励他们共享他们所有的信息，包括他们的角色。寡妇知道在场的所有角色，");
    g_tipLine[12979] = StringToText("  所以对善良阵营最有利的方案就是透露一切。如果邪恶阵营知道所有角色，那善良阵营也可以知道。");
    g_tipLine[12980] = StringToText("· 如果你杀了寡妇，他们的毒就会终止。如果某名你认为是爪牙的玩家死亡，注意信息是否开始突然变得再次清晰起来。");
    g_tipLine[12981] = StringToText("· 寡妇极有可能对强力的信息角色投毒。一个值得扪心自问的问题是你是否可能成为寡妇的目标。");
    g_tipLine[12982] = StringToText("  类似占卜师或是气球驾驶员这样的角色具有很高的优先级，因为他们能探查到恶魔。");
    g_tipLine[12983] = StringToText("  类似僧侣或半兽人这样的角色也具有很高的优先级，因为他们阻止了恶魔的杀戮。");
    g_tipLine[12984] = StringToText("· 在单爪牙游戏中，知道寡妇在场是一个关键信息，因为你就可以立即排除其他爪牙。如果寡妇在场，那么哥布林就不会在场。");
    g_tipLine[12985] = StringToText("· 不同于投毒者，寡妇不能改变投毒的目标。如果你能确定哪名玩家因寡妇中毒，那你就能立即确定没有其他玩家因寡妇中毒。");
    g_tipLine[12986] = StringToText("  如果寡妇是剧本中唯一的中毒来源，那么你就消除了其他所有玩家的中毒可能性。");
    g_tipLine[12987] = StringToText("· 注意那些花费许多时间在一起耳语的玩家，尤其是在第一天；虽然他们并不总会是寡妇和他们的恶魔，");
    g_tipLine[12988] = StringToText("  但这两位通常比一般凑对的玩家有更多的话题要说。");
    g_tipLine[12989] = StringToText("· 寡妇让邪恶阵营更容易宣称是那些能得知其他玩家角色的角色（比如筑梦师或图书管理员，因为他们已经获得了这些信息）。");
    g_tipLine[12990] = StringToText("  如果寡妇可能存在，在信任这些角色之前将这一点放在心里。");
    g_tipLine[12991] = StringToText("· 只要寡妇存活，他们在游戏全程都很致命。如果你有一条线索指向一个疑似寡妇，");
    g_tipLine[12992] = StringToText("  那么处决他们并消除他们对小镇暗藏的影响对你总是有好处的。");
    g_tipLine[12993] = StringToText("· 记住，对抗寡妇类似对抗间谍，然而寡妇只能在首夜看到魔典，因而只能完全依赖于记忆力。");
    g_tipLine[12994] = StringToText("  这使得他们在玩家人数较多的游戏中面临更多挑战，因为他们可能只记住了少量关键信息。不同于间谍，");
    g_tipLine[12995] = StringToText("  第一晚之后发生的任何事情寡妇都看不到。");
    g_tipRoleAt[75] = 12885; g_tipRoleN[75] = 111; g_tipP1At[75] = 12887; g_tipP1N[75] = 7; g_tipP2At[75] = 12913; g_tipP2N[75] = 11;
    g_tipAbility[75] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[12996] = StringToText("【背景故事】");
    g_tipLine[12997] = StringToText("「讽刺的确是最不足挂齿的机智。尽管如此，先生，回应你的批评，就是一种机智。」");
    g_tipLine[12998] = StringToText("【角色能力】");
    g_tipLine[12999] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipLine[13000] = StringToText("【角色简介】");
    g_tipLine[13001] = StringToText("贵族能得知三名玩家中的一名是邪恶的。");
    g_tipLine[13002] = StringToText("· 贵族只会在第一个夜晚得知他的信息。");
    g_tipLine[13003] = StringToText("· 如果贵族在游戏中途被创造，他会在自己作为贵族时的第一个夜晚得知信息。");
    g_tipLine[13004] = StringToText("· 贵族得知的是两名善良玩家和一名邪恶玩家。他不会得知一名善良玩家和两名邪恶玩家，也不会得知三名邪恶玩家。");
    g_tipLine[13005] = StringToText("【范例】");
    g_tipLine[13006] = StringToText("贵族得知了小明、小艾和小黑。小明和小艾是善良玩家，小黑是邪恶玩家。");
    g_tipLine[13007] = StringToText("贵族得知了道哥、小兰和小八。道哥是共情者。小兰是圣徒。小八是陌客，但被贵族当作了邪恶阵营。");
    g_tipLine[13008] = StringToText("第三个夜晚，麻脸巫婆把小艾变成了贵族。小艾得知了小文、小美和小佳中有一名邪恶玩家。小美是邪恶的间谍，");
    g_tipLine[13009] = StringToText("  但被当作善良阵营。与此同时小佳是珀，同样也是邪恶玩家。");
    g_tipLine[13010] = StringToText("【运作方式】");
    g_tipLine[13011] = StringToText("在为首个夜晚进行准备时，将贵族的「得知」标记分别放置在两名善良玩家和一名邪恶玩家的角色标记旁。");
    g_tipLine[13012] = StringToText("在首个夜晚，唤醒贵族，并指向三名标记有「得知」的玩家。让贵族重新入睡。");
    g_tipLine[13013] = StringToText("【提示标记】");
    g_tipLine[13014] = StringToText("· 得知");
    g_tipLine[13015] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[13016] = StringToText("放置条件：放置在三名玩家的角色标记旁边。这三名玩家需要满足两名为善良阵营，一名为邪恶阵营。");
    g_tipLine[13017] = StringToText("移除时机：在贵族获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[13018] = StringToText("【规则细节】");
    g_tipLine[13019] = StringToText("· 特定角色互动：");
    g_tipLine[13020] = StringToText("  · 异教领袖：就算在首夜因为自身能力就变为邪恶，也不会被贵族当做邪恶玩家得知。因为异教领袖的首夜行动顺序在贵族之后，");
    g_tipLine[13021] = StringToText("    他在贵族在被唤醒时始终都是善良的。");
    g_tipLine[13022] = StringToText("  · 舞蛇人：可能在贵族醒来之前阵营发生交换，所以在贵族信息中需要展示新的阵营状态。");
    g_tipLine[13023] = StringToText("  · 莽夫：在贵族醒来时，莽夫的阵营可能已经变为邪恶，所以可以将莽夫作为邪恶玩家展示。注意，");
    g_tipLine[13024] = StringToText("    贵族没有使用自身能力选择莽夫。");
    g_tipLine[13025] = StringToText("  · 陌客/间谍：可以被贵族当作邪恶或善良。");
    g_tipLine[13026] = StringToText("【提示与技巧】");
    g_tipLine[13027] = StringToText("· 立即带着你的信息现身。如果你告诉团队你是贵族，以及你得知了哪三名玩家，团队可以马上用上这些信息。");
    g_tipLine[13028] = StringToText("· 直到游戏快结束时才揭露你所得知的信息。说书人很可能向你展示了一名爪牙玩家而非恶魔玩家。");
    g_tipLine[13029] = StringToText("  如果如果仅剩三名玩家存活而你得知的其中两名玩家已经死亡，并且你十分确定剩下的那名玩家不是恶魔，");
    g_tipLine[13030] = StringToText("  这就增加了你选对待处决玩家的几率。如果你得知的玩家中还有两名存活，那就更好了。");
    g_tipLine[13031] = StringToText("· 你的信息本身并不太优秀。除非能将你的信息与其他玩家所知结合起来，否则仅仅知道三名玩家中有一名是邪恶的对你没有太大");
    g_tipLine[13032] = StringToText("  帮助。做好团队一员并尽可能多地进行沟通。");
    g_tipLine[13033] = StringToText("· 记得，你得知的玩家中一定有且仅有一名是邪恶的。与调查员不同，他们可以得知两名邪恶玩家，");
    g_tipLine[13034] = StringToText("  而贵族一定确切地得知一名邪恶玩家。因此，如果你能找出三名玩家中的邪恶玩家，那么你也同时得知了两名玩家是善良的。");
    g_tipLine[13035] = StringToText("  了解三名玩家的阵营极有帮助。如果你能够做到，就去找出哪名玩家是邪恶的。");
    g_tipLine[13036] = StringToText("· 体验三种不同的理论。如果你假定第一名玩家是邪恶的，这能暗示出游戏中其他玩家的哪些信息？这合理吗？");
    g_tipLine[13037] = StringToText("  如果你假定第二名玩家是邪恶的，这能暗示出游戏中其他玩家的哪些信息？这合理吗？如果你假定第三名玩家是邪恶的，");
    g_tipLine[13038] = StringToText("  这能暗示出游戏中其他玩家的哪些信息？这合理吗？这三者之中哪一种最合理？");
    g_tipLine[13039] = StringToText("· 如果有类似送葬者这样的角色在场，那杀死一些角色来证明他们的角色是值得的。但贵族不是这样（值得被杀）的角色。");
    g_tipLine[13040] = StringToText("  即使你可以通过死亡来证明你是谁，仍然留下了三名玩家需要杀死。仅仅为了杀死一名邪恶玩家就让包含七名善良角色在内的八");
    g_tipLine[13041] = StringToText("  名玩家死亡是非常不值得的。（你死了，恶魔杀人，第一名玩家死，恶魔杀人，第二名玩家死，恶魔杀人，第三名玩家死，");
    g_tipLine[13042] = StringToText("  恶魔杀人）相反，你应当利用手中的信息，让人们相信你是贵族而不杀死你。");
    g_tipRoleAt[76] = 12996; g_tipRoleN[76] = 47; g_tipP1At[76] = 12998; g_tipP1N[76] = 7; g_tipP2At[76] = 13018; g_tipP2N[76] = 8;
    g_tipAbility[76] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipLine[13043] = StringToText("【背景故事】");
    g_tipLine[13044] = StringToText("「我的小屋温暖而坚固。我的斧头靠在门边，我的靴子在火旁烘干，我的麋鹿肉正在锅里细火慢炖……听听！");
    g_tipLine[13045] = StringToText("  有尖叫声在山谷中回荡！或许雨水、泥泞和寒风会掩盖狼的气味，但我熟悉山路，我的步伐坚定。我来了。」");
    g_tipLine[13046] = StringToText("【角色能力】");
    g_tipLine[13047] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名存活的玩家：如果你选中了落难少女，她会变成一个不在场的镇民角色。");
    g_tipLine[13048] = StringToText("  [+落难少女]");
    g_tipLine[13049] = StringToText("【角色简介】");
    g_tipLine[13050] = StringToText("巡山人能够在爪牙找到落难少女之前拯救她……至少说希望如此。");
    g_tipLine[13051] = StringToText("· 落难少女可以在巡山人不在场时出现在游戏中。在游戏设置阶段，如果巡山人在场而落难少女不在场，");
    g_tipLine[13052] = StringToText("  那么落难少女就会被添加进来并替换掉一个其他镇民。而如果落难少女已经在场，");
    g_tipLine[13053] = StringToText("  巡山人不会因此再将另外一名落难少女添加进场。");
    g_tipLine[13054] = StringToText("· 如果巡山人在夜晚时正确地选中了落难少女，那么落难少女就会立即变成一个不在场的镇民角色。");
    g_tipLine[13055] = StringToText("  由说书人来决定会变成哪一个镇民角色，且落难少女会得知自己变成了什么角色。");
    g_tipLine[13056] = StringToText("· 如果落难少女变成了镇民，她会获得那个镇民的能力并失去落难少女的能力。");
    g_tipLine[13057] = StringToText("· 巡山人只有一次猜测和选择的机会，并且会在夜晚进行。");
    g_tipLine[13058] = StringToText("· 在白天，爪牙们一共有一次公开猜测的机会。如果爪牙猜对了谁是落难少女，邪恶阵营获胜。如果爪牙猜错了谁是落难少女，");
    g_tipLine[13059] = StringToText("  其他爪牙就不能通过猜对落难少女是谁获胜了。");
    g_tipLine[13060] = StringToText("· 如果落难少女在被巡山人选择时醉酒或中毒，只要巡山人清醒且健康，那么落难少女就能够变成镇民。");
    g_tipLine[13061] = StringToText("【范例】");
    g_tipLine[13062] = StringToText("巡山人在第一个夜晚被唤醒，但没有使用自己的能力。在第二个夜晚，巡山人选择了角色为落难少女的玩家。");
    g_tipLine[13063] = StringToText("  落难少女变成了贵族，并因此在当晚得知了三名玩家，且其中有一名是邪恶的。");
    g_tipLine[13064] = StringToText("巡山人选择了小兰。小兰是唱诗男孩，因此无事发生。巡山人不会在此后的夜晚因为自己的能力被唤醒了。");
    g_tipLine[13065] = StringToText("【运作方式】");
    g_tipLine[13066] = StringToText("在进行游戏设置，将角色标记放进盲抽袋之前，如果落难少女不在即将要放入盲抽袋的这些角色之中，");
    g_tipLine[13067] = StringToText("  那么移除一个镇民角色标记，并加入落难少女。");
    g_tipLine[13068] = StringToText("每个夜晚，唤醒巡山人。他要么摇头不使用能力，要么指向一名玩家。");
    g_tipLine[13069] = StringToText("如果他摇头，那么让巡山人重新入睡。");
    g_tipLine[13070] = StringToText("如果他指向了一名玩家，让巡山人重新入睡。巡山人现在失去能力——将「失去能力」提示标记放置在巡山人旁，");
    g_tipLine[13071] = StringToText("  并从夜晚顺序表旁移除他的夜晚标记。如果他选中了落难少女，那么唤醒落难少女，对她展示「你是」");
    g_tipLine[13072] = StringToText("  信息标记和一个不在场的镇民角色标记，然后让落难少女重新入睡。落难少女现在拥有这个镇民的能力，");
    g_tipLine[13073] = StringToText("  因此将这个镇民角色标记替换落难少女角色标记。");
    g_tipLine[13074] = StringToText("【提示标记】");
    g_tipLine[13075] = StringToText("· 失去能力");
    g_tipLine[13076] = StringToText("放置时机：在巡山人夜晚行动时选择使用能力，并选择了一名存活的玩家后。");
    g_tipLine[13077] = StringToText("放置条件：只要巡山人选择了一名存活的玩家，不论巡山人是否醉酒中毒，都会将此标记放置在巡山人角色标记旁。");
    g_tipLine[13078] = StringToText("移除时机：巡山人死亡或离场时。");
    g_tipLine[13079] = StringToText("【规则细节】");
    g_tipLine[13080] = StringToText("· 落难少女被选中后角色变为不在场的镇民角色，玩家的角色类型也会跟着改变，而不仅仅只是获得镇民的能力。");
    g_tipLine[13081] = StringToText("· 拥有落难少女能力的其他角色被巡山人选择，该玩家并不会变成一个不在场的镇民角色。");
    g_tipLine[13082] = StringToText("· 特定角色互动：");
    g_tipLine[13083] = StringToText("  · 气球驾驶员：如果时机合适，可以得知落难少女两次——一次作为外来者，一次作为被巡山人改变后的镇民。");
    g_tipLine[13084] = StringToText("  · 侍臣：如果侍臣让落难少女醉酒，然后巡山人选中落难少女，他变为一个新的角色，这名原落难少女玩家仍然会继续醉酒。");
    g_tipLine[13085] = StringToText("  · 教父/方古：如果被巡山人选中的落难少女玩家改变的角色后在白天死亡，教父无法在晚上被唤醒杀人；");
    g_tipLine[13086] = StringToText("    方古不能转化到该玩家身上。该玩家不再是落难少女，所以不再是外来者。");
    g_tipLine[13087] = StringToText("  · 提线木偶：如果巡山人在场，落难少女不会是提线木偶。不过，巡山人可能是提线木偶。");
    g_tipLine[13088] = StringToText("  · 痢蛭：即使落难少女是宿主，他仍然能被巡山人改变，但仍然继续中毒。");
    g_tipLine[13089] = StringToText("  · 咖啡师：如果受到咖啡师行动两次的效果影响，如果巡山人还没进行选择，他可以在一晚内选择两名玩家；");
    g_tipLine[13090] = StringToText("    或者如果巡山人已经在之前选择过一次，他会被唤醒并再次选择。如果落难少女被选中，他仍然只会改变角色一次。");
    g_tipLine[13091] = StringToText("· 相克规则：");
    g_tipLine[13092] = StringToText("  · 提线木偶：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_tipLine[13093] = StringToText("【提示与技巧】");
    g_tipLine[13094] = StringToText("· 尽快找到落难少女。你只有一次机会并且你需要在你或者她死亡之前找到她。在小型剧本游戏中这一点可能更重要，");
    g_tipLine[13095] = StringToText("  因为任何一名玩家过早死亡的几率都更高，但是盲选命中的几率也更高。你最好在一场小型游戏的首夜就冒个险而不是赌你和她");
    g_tipLine[13096] = StringToText("  都能活到明天，并且落难少女可以因此获得一个明晚就能使用的能力。");
    g_tipLine[13097] = StringToText("· 在你真正确定之后再使用你的能力。你只有一次机会命中，而搜寻过程也会有许多乐趣。");
    g_tipLine[13098] = StringToText("  试着与那些能够得知角色的角色例如筑梦师合作。即使是送葬者对你来说也很棒，");
    g_tipLine[13099] = StringToText("  因为确认落难少女已死的事实可以让你知道你已经从落难少女搜寻的支线中转回了恶魔搜寻的主线上。");
    g_tipLine[13100] = StringToText("· 落难少女很可能反复而多疑，甚至可能试图让自己被杀。将你的能力用在那些似乎有心事或是寡言少语看起来像是落难少女的玩家");
    g_tipLine[13101] = StringToText("  身上。如果一名玩家热衷于处决自己，私下询问她是否想让你在夜间猜测她是落难少女。但要小心，");
    g_tipLine[13102] = StringToText("  这可能只是邪恶玩家试图欺骗你消耗你的能力。");
    g_tipLine[13103] = StringToText("· 私下对其他玩家宣称你是落难少女。这有助于引出落难少女和其他各类爪牙。那些能够证明自己的角色，例如贞洁者或是魔像，");
    g_tipLine[13104] = StringToText("  可以给你提供一个可信的人来安排一次私聊，让你和落难少女都可以没有妨碍地对这名玩家宣称你们各自的角色。");
    g_tipLine[13105] = StringToText("· 不惜代价活着。你可以宣称你已经使用了你的能力，或者是已经找到了你的落难少女，这些意味着你不再是邪恶阵营的威胁。");
    g_tipLine[13106] = StringToText("  看看如果你随机地公开宣称一名玩家是你的落难少女会发生什么，但要小心，");
    g_tipLine[13107] = StringToText("  宣称你已经使用了你的能力会让落难少女认为她现在是一个单纯的风险（角色）而不再有获得奖励的可能，");
    g_tipLine[13108] = StringToText("  从而试图让自己被杀。");
    g_tipLine[13109] = StringToText("· 试着赶走爪牙或是引诱他们跌入公开猜测的陷阱。在可疑人士之间四处走动并宣称是落难少女，");
    g_tipLine[13110] = StringToText("  或是让一个可信的善良玩家在和你对话后对某名可疑玩家状似无意地透露落难少女在场。如果爪牙被欺骗，");
    g_tipLine[13111] = StringToText("  将他们的猜测浪费在你身上（或者任何并非落难少女的玩家身上），他们就无法伤害你真正的落难少女了。");
    g_tipRoleAt[77] = 13043; g_tipRoleN[77] = 69; g_tipP1At[77] = 13046; g_tipP1N[77] = 15; g_tipP2At[77] = 13079; g_tipP2N[77] = 14;
    g_tipAbility[77] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名存活的玩家：如果你选中了落难少女，她会变成一个不在场的镇民角色。[+落难少女]");
    g_tipLine[13112] = StringToText("【背景故事】");
    g_tipLine[13113] = StringToText("「如果它弯曲了，那可就太棒了。但如果它断裂了，那么它就必须得修一修了。」");
    g_tipLine[13114] = StringToText("【角色能力】");
    g_tipLine[13115] = StringToText("每局游戏限一次，在夜晚时，你可以选择让恶魔变成你选择的恶魔角色，或让所有爪牙变成你选择的爪牙角色。");
    g_tipLine[13116] = StringToText("【角色简介】");
    g_tipLine[13117] = StringToText("工程师能够决定镇子即将面临何种威胁。");
    g_tipLine[13118] = StringToText("· 工程师能够决定在场的爪牙种类，或在场的恶魔种类，但无法同时决定这两者。");
    g_tipLine[13119] = StringToText("· 当工程师创造新的角色时，原本的恶魔玩家会仍然是恶魔，原本的爪牙玩家会仍然是爪牙。");
    g_tipLine[13120] = StringToText("  邪恶玩家的总数量不会因此发生改变。");
    g_tipLine[13121] = StringToText("· 如果工程师尝试创造一个已经在场的角色时，那个角色所属的玩家不会发生变化。工程师不会得知这一消息，");
    g_tipLine[13122] = StringToText("  也不能再次使用自己的能力了。");
    g_tipLine[13123] = StringToText("· 如果要创造爪牙，工程师需要根据本局游戏的玩家总数，选择等同于原本应该在场的爪牙数量的爪牙角色。");
    g_tipLine[13124] = StringToText("  （参考旅行者列表或设置列表）");
    g_tipLine[13125] = StringToText("· 如果工程师无意中选择了数量不符的角色时，说书人应该以较为公平且可行的方式来改变一定数量的邪恶玩家的角色。");
    g_tipLine[13126] = StringToText("· 工程师只能选择来自于当前剧本列表中的角色。");
    g_tipLine[13127] = StringToText("【范例】");
    g_tipLine[13128] = StringToText("在第二个夜晚，工程师选择让恶魔变成痢蛭。原本为小恶魔的小莱现在变成了痢蛭。");
    g_tipLine[13129] = StringToText("在第一个夜晚，工程师将男爵变成了炸弹人。仍然会有额外的两名外来者在场。");
    g_tipLine[13130] = StringToText("在场的爪牙为恐惧之灵和精神病患者，他们制造了相当大的混乱。工程师选择让灵言师和间谍在场。");
    g_tipLine[13131] = StringToText("  说书人决定将恐惧之灵变成了灵言师，将精神病患者变成了间谍。");
    g_tipLine[13132] = StringToText("在场的爪牙为间谍、刺客和女巫。工程师选择让间谍、刺客和灵言师在场。因此，女巫变成了灵言师。");
    g_tipLine[13133] = StringToText("【运作方式】");
    g_tipLine[13134] = StringToText("每个夜晚，唤醒工程师。他要么摇头不使用能力，要么指向角色列表上的一个或多个邪恶角色。");
    g_tipLine[13135] = StringToText("如果他摇头不使用能力，无事发生。让工程师重新入睡。");
    g_tipLine[13136] = StringToText("如果他指向了角色列表上的恶魔或爪牙角色，让他重新入睡。以合适的方式用新的角色标记替换被工程师能力所影响的那些玩家");
    g_tipLine[13137] = StringToText("  原本的角色标记。分别依次唤醒每个角色发生变化的邪恶玩家，对其展示「你是」信息标记，和他当前的角色标记，");
    g_tipLine[13138] = StringToText("  然后再让他重新入睡，重复步骤直到所有受到影响的邪恶玩家均因此被唤醒。工程师现在失去能力——将「失去能力」");
    g_tipLine[13139] = StringToText("  提示标记放置在工程师旁，并从夜晚顺序表旁移除他的夜晚标记。");
    g_tipLine[13140] = StringToText("【提示标记】");
    g_tipLine[13141] = StringToText("· 失去能力");
    g_tipLine[13142] = StringToText("放置时机：在工程师夜晚行动时选择使用能力，并选择了一个或多个角色后。");
    g_tipLine[13143] = StringToText("放置条件：只要工程师选择使用能力，不论工程师是否醉酒中毒，都会将此标记放置在工程师角色标记旁。");
    g_tipLine[13144] = StringToText("移除时机：工程师死亡或离场时。");
    g_tipLine[13145] = StringToText("【规则细节】");
    g_tipLine[13146] = StringToText("· 特定角色互动：");
    g_tipLine[13147] = StringToText("  · 侍女：爪牙/恶魔因为得知他们的新角色而被唤醒，不会被侍女探查，除非他们因为自身获得的新能力醒来。");
    g_tipLine[13148] = StringToText("  · 方古/小恶魔：如果工程师选择的时候，场上有复数的相同角色恶魔，这些相同角色的恶魔玩家都会改变角色。");
    g_tipLine[13149] = StringToText("  · 小怪宝：如果小怪宝在场的时候，工程师选择其他恶魔，当前照看小怪宝的玩家会变成那个恶魔，不管他之前是什么角色。");
    g_tipLine[13150] = StringToText("    如果工程师选择让小怪宝进入游戏，之前的恶魔会变成一个不在场的爪牙角色并且正在照看小怪宝。");
    g_tipLine[13151] = StringToText("  · 提线木偶：如果提线木偶被工程师带入游戏，提线木偶不需要与恶魔相邻。变为提线木偶的玩家不会被展示他是提线木偶，");
    g_tipLine[13152] = StringToText("    而是改为展示「你是」，然后展示任何一个镇民或外来者角色标记。如果提线木偶被工程师变为其他爪牙，他将被展示「你是」");
    g_tipLine[13153] = StringToText("    ，并且展示新的爪牙角色标记。");
    g_tipLine[13154] = StringToText("  · 珀：如果一个没被唤醒的恶魔被工程师变为珀，珀在当晚不能三杀。");
    g_tipLine[13155] = StringToText("  · 传教士：如果爪牙已经被传教士布道，然后被工程师转变，爪牙得知他的角色改变但仍然会被传教士影响，");
    g_tipLine[13156] = StringToText("    所以他的新角色仍然失去能力。");
    g_tipLine[13157] = StringToText("  · 陌客：理论上可以被当作爪牙/恶魔，然后被工程师转变或者影响其他发生转变的角色……不要这样做，陌客是外来者。");
    g_tipLine[13158] = StringToText("  · 间谍：可以不被当作爪牙，同时无视工程师的转换，保持他的能力。");
    g_tipLine[13159] = StringToText("  · 亡骨魔：如果被工程师变为其他恶魔，被亡骨魔杀死的爪牙失去能力，与这些爪牙相邻的中毒玩家会立即解除中毒。");
    g_tipLine[13160] = StringToText("  · 寡妇：如果被工程师带入游戏，当晚一名善良玩家得知场上有寡妇。");
    g_tipLine[13161] = StringToText("  · 僵怖：如果把假死的僵怖变为其他恶魔，他在城镇广场上将继续表现为死亡，但在其他所有情况下都当作存活。");
    g_tipLine[13162] = StringToText("· 相克规则：");
    g_tipLine[13163] = StringToText("  · 召唤师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_tipLine[13164] = StringToText("  · 军团：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，工程师失去能力并改为得知这一信息。");
    g_tipLine[13165] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[13166] = StringToText("  · 梼杌：如果梼杌变成了其他恶魔，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[13167] = StringToText("【提示与技巧】");
    g_tipLine[13168] = StringToText("· 如果你是工程师，你大抵能够完成如下四件事中的一件：决定哪些爪牙在场，决定哪些爪牙不在场，决定哪个恶魔在场，");
    g_tipLine[13169] = StringToText("  决定哪个恶魔不在场。");
    g_tipLine[13170] = StringToText("· 你指定哪些爪牙在场的话，你和整个善良阵营都能知道面对的（对手）是谁。这个信息至关重要。");
    g_tipLine[13171] = StringToText("  知道有哥布林或炸弹人在场至少意味着你们需要对处决小心谨慎。知道一个间谍或寡妇在场意味着你和整个善良阵营应当尽快且");
    g_tipLine[13172] = StringToText("  诚实地透露角色。知道自己要对抗的对手意味着你可以相应地规划起自己的策略。同样，");
    g_tipLine[13173] = StringToText("  指定哪个恶魔在场可以让你为此做好计划。知道涡流在场意味着善良阵营（镇民）必须反转他们获得的信息，");
    g_tipLine[13174] = StringToText("  它们不可能是真的。");
    g_tipLine[13175] = StringToText("· 如果你想指定哪些爪牙不在场，只需要简单地选择其他爪牙在场即可。如果你想避免中毒发生，");
    g_tipLine[13176] = StringToText("  那么选择投毒者以外的角色就可以保证这点。如果你的队伍特别忌惮主谋，");
    g_tipLine[13177] = StringToText("  那么你可以通过将所有爪牙都换成其他爪牙来确保你不会碰到他们。类似地，如果你不知道你希望哪个恶魔在场，");
    g_tipLine[13178] = StringToText("  但有某种恶魔是你绝对不希望在场的，那么将恶魔变为其他角色。你仍会面对一个强大的对手，但并不会是最可怕的对手。");
    g_tipLine[13179] = StringToText("· 避免邪恶阵营（甚至是善良阵营！）在你使用能力之前杀死你，在首夜使用你的能力。这确保了你能行动起来。");
    g_tipLine[13180] = StringToText("  但提前行动的缺点是没有机会进行团队讨论，以及没能获得任何可能会影响你决定的相关信息，");
    g_tipLine[13181] = StringToText("  比如哪些善良角色在场以及哪些邪恶角色他们特别适合对抗。");
    g_tipLine[13182] = StringToText("· 想要创造最理想的爪牙和恶魔（阵容），你需要等到第二或者第三个晚上，同时在此期间引发尽可能多的讨论。");
    g_tipLine[13183] = StringToText("  为了尽可能做出最好的决定，你需要知道尽可能多的在场善良角色，以便充分地利用他们的特殊能力，");
    g_tipLine[13184] = StringToText("  例如创造一个亡骨魔来帮助神谕者探察邪恶玩家，或是在巫毒师在场时创造一个哥布林，");
    g_tipLine[13185] = StringToText("  你可以确定死去的玩家都是善良阵营的。");
    g_tipLine[13186] = StringToText("· 时机对工程师来说至关重要。一些邪恶（角色）能力可以通过你在正确时机的行动而被完全无效掉。比如，");
    g_tipLine[13187] = StringToText("  如果你在灵言师即将转变一名玩家为邪恶的那个夜晚将灵言师转变为魔鬼代言人，那名玩家就会留在善良阵营。");
    g_tipLine[13188] = StringToText("  如果你在最后一夜将魔鬼代言人转变为灵言师，你就能确保最后一天会在恶魔无法免于被处决的情况下进行，");
    g_tipLine[13189] = StringToText("  同时灵言师也无法使用他们的能力（因为不会再有夜晚）。");
    g_tipLine[13190] = StringToText("· 在游戏中途创造一个明显的恶魔或爪牙角色能用来确认你是工程师。一个出人意料的恐惧之灵或是镜像双子可以让善良阵营信任");
    g_tipLine[13191] = StringToText("  你，因为这些角色似乎前一天还不存在，但是它们也许不是善良阵营真正希望面对的爪牙。");
    g_tipLine[13192] = StringToText("  你从证明自己是善良玩家中获得的好处与团队面对最合适的爪牙与恶魔获得的好处，你需要小心平衡这两者。");
    g_tipLine[13193] = StringToText("· 不要担心创造那些在方括号中注明引入外来者的角色，就像[这样]。方括号内容指示说书人在设置阶段需要添加或移除一些标");
    g_tipLine[13194] = StringToText("  记，不会在游戏中期影响到其他事情。如果你引入了男爵，不会有两个外来者被引入。");
    g_tipLine[13195] = StringToText("· 关于你的能力你需要汇总多少讨论内容取决于你自己。讨论太多，恶魔可能会在当晚杀死你，阻止你使用你的能力。讨论太少，");
    g_tipLine[13196] = StringToText("  团队会因为你没有让他们参与决策而（对你）产生怀疑。");
    g_tipRoleAt[78] = 13112; g_tipRoleN[78] = 85; g_tipP1At[78] = 13114; g_tipP1N[78] = 13; g_tipP2At[78] = 13145; g_tipP2N[78] = 22;
    g_tipAbility[78] = StringToText("每局游戏限一次，在夜晚时，你可以选择让恶魔变成你选择的恶魔角色，或让所有爪牙变成你选择的爪牙角色。");
    g_tipLine[13197] = StringToText("【背景故事】");
    g_tipLine[13198] = StringToText("「这是这条河流里我最喜欢的一截儿……看看阳光是如何让一道彩虹横跨修道院和集市的？");
    g_tipLine[13199] = StringToText("  这是能让鱼儿长得肥美的最好的地方。我一天天变老，它们也一天天长大。」");
    g_tipLine[13200] = StringToText("【角色能力】");
    g_tipLine[13201] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipLine[13202] = StringToText("【角色简介】");
    g_tipLine[13203] = StringToText("渔夫知道其他人不知道的事情：接下来该做什么。");
    g_tipLine[13204] = StringToText("· 渔夫自由选择什么时候使用他的能力。");
    g_tipLine[13205] = StringToText("· 当渔夫拜访说书人时，说书人会给他一条建议。");
    g_tipLine[13206] = StringToText("· 说书人的建议不需要是事实。他是说书人觉得能帮助渔夫获胜的策略指示，如果他这样做的话。");
    g_tipLine[13207] = StringToText("· 如果渔夫醉酒或中毒，说书人可以给渔夫一条糟糕的建议。");
    g_tipLine[13208] = StringToText("【范例】");
    g_tipLine[13209] = StringToText("渔夫拜访了说书人并得知了「你不应该相信小八」。小八是中毒的共情者，并不自知地散布了错误信息。");
    g_tipLine[13210] = StringToText("在第三个白天，渔夫拜访了说书人并得知了「让声称自己是外来者的玩家活着」。这些玩家实际上是呆瓜和恐惧之灵。");
    g_tipLine[13211] = StringToText("  说书人认为让这些玩家存活会有助于让善良玩家成功处决恶魔。");
    g_tipLine[13212] = StringToText("在游戏的最后一天，渔夫获得了「杀死小博」的建议。渔夫醉酒了，小博是一个镇民。说书人给了一条糟糕的建议。");
    g_tipLine[13213] = StringToText("【运作方式】");
    g_tipLine[13214] = StringToText("每局游戏限一次，渔夫可以使用他的能力。私下里，给他一条能帮助他获胜的建议。然后，把「失去能力」");
    g_tipLine[13215] = StringToText("  的提示标记放置在渔夫的角色标记旁边。");
    g_tipLine[13216] = StringToText("给渔夫建议的最好方式是让他做什么，而不是「是什么」信息。这让渔夫这个角色更有趣也更与众不同。");
    g_tipLine[13217] = StringToText("例如，建议「你应该处决那个玩家」，或者「保护那名玩家」，或者「找到醉酒的玩家」，或者「颠覆你之前的想法」，");
    g_tipLine[13218] = StringToText("  或者「忽略爪牙们的存在」，或者「相信哪名玩家」。这些建议会比「这名玩家是邪恶的」或者「恶魔是诺-达鲺」更有趣。");
    g_tipLine[13219] = StringToText("【提示标记】");
    g_tipLine[13220] = StringToText("· 失去能力");
    g_tipLine[13221] = StringToText("放置时机：在渔夫私下拜访说书人，使用自己的能力并获取建议后。");
    g_tipLine[13222] = StringToText("放置条件：在渔夫获取建议后，不论渔夫是否醉酒中毒，都会将此标记放置在渔夫角色标记旁。");
    g_tipLine[13223] = StringToText("移除时机：渔夫死亡或离场时。");
    g_tipLine[13224] = StringToText("【提示与技巧】");
    g_tipLine[13225] = StringToText("· 问问自己为什么会得到这样的建议。即使它是你完全没有预料到的亦或是会把你带入一条与之前（推论）完全不相关的路径，");
    g_tipLine[13226] = StringToText("  要记得说书人无所不知。他们最能给你提供帮助你获胜的建议。");
    g_tipLine[13227] = StringToText("· 听从收到的建议。渔夫不提供信息，而是提供帮助获胜的建议。如果建议是「处决你顺时针方向的邻座」，那就这么做。");
    g_tipLine[13228] = StringToText("  听从收到的建议！除非你认为你的信息值得怀疑，否则如果你不实现他们，建议可能会变得无效，");
    g_tipLine[13229] = StringToText("  因为他们是基于你询问时的当下局势给出的。两天才处决艾瑞克可能不是一个好主意，尽快劝说进行对他的处决。");
    g_tipLine[13230] = StringToText("· 在遵循建议之后，试着考量一下你现在在游戏中的情况，并试着逆推一下为什么会给你这样的建议。");
    g_tipLine[13231] = StringToText("  在给你的建议中谁占重要地位？为什么？遵循建议有什么好处？这说明游戏的迷惑之处在哪里？");
    g_tipLine[13232] = StringToText("· 立即使用你的能力。不用冒着在得到建议之前就被恶魔杀死或被处决的风险。在第一天就尽快寻求建议！毕竟，");
    g_tipLine[13233] = StringToText("  如果你不使用能力，你每天都有失去建议的风险。立即使用能力可以回避这种风险。基于游戏配置，");
    g_tipLine[13234] = StringToText("  说书人在第一天仍然可能给你许多好建议。");
    g_tipLine[13235] = StringToText("· 尽可能地推迟使用你的能力。这很有风险，但你等待的时间越长，说书人就越能给你直逼胜利的确切建议。另外，");
    g_tipLine[13236] = StringToText("  如果你连续数天勇敢直面死亡的风险，说书人可能更倾向于给予你一些有趣的建议来奖励你。");
    g_tipLine[13237] = StringToText("· 关注那些可能会影响你死亡可能性的角色能力，并在你使用能力时将这些因素考虑进去。如果剧本里是利维坦，");
    g_tipLine[13238] = StringToText("  那恶魔无法杀死你。如果你相信一名玩家是僧侣，你可以寻求他的保护。这两种情况下，你都有更高的几率存活到游戏后期，");
    g_tipLine[13239] = StringToText("  并且在此基础上延后你获得的建议。");
    g_tipLine[13240] = StringToText("· 关注说书人使用的特定词语。如果某些内容看起来模棱两可，他也许是在暗示某件事而非直白阐述。");
    g_tipLine[13241] = StringToText("  如果说书人告诉你不要相信某名玩家，那名玩家也许是善良阵营的共情者，但是已经被寡妇投毒，");
    g_tipLine[13242] = StringToText("  会提供将善良阵营引入毁灭的错误信息。理解说书人给予的建议时要特别当心。「凯文正在分享正确的信息」");
    g_tipLine[13243] = StringToText("  不意味着凯文是善良阵营，「处决艾瑞克」也不意味着艾瑞克是邪恶阵营。建议也许会专门针对你当前进行的游戏，");
    g_tipLine[13244] = StringToText("  说书人实在是很热衷于拐弯抹角。");
    g_tipLine[13245] = StringToText("· 注意剧本里涉及胜利条件的角色能力。你收到的建议可能与此相关。例如，");
    g_tipLine[13246] = StringToText("  一个渔夫收到来自说书人的建议让他试图阻止处决一个哥布林。");
    g_tipLine[13247] = StringToText("· 拜访说书人，然后直接回来，假装你已经使用了你的渔夫能力但实际上没有。让邪恶阵营以为你的力量对他们不再是威胁。");
    g_tipLine[13248] = StringToText("  如果恶魔相信你已经使用了你的能力，他们可能认为杀死你不再有价值，这会让你存活并且在稍后的游戏中使用能力。");
    g_tipLine[13249] = StringToText("· 想想有了建议你需要信任谁。你可能只想简单地立即展示它，把线索放在明面上让大家理解。");
    g_tipLine[13250] = StringToText("  或者你可能想与一队信任的玩家分享提示，他们可以秘密地配合使用它。");
    g_tipLine[13251] = StringToText("· 如果你不确定你记住的建议是否正确，你可以重新拜访说书人让他们重复一次。");
    g_tipLine[13252] = StringToText("  但是需要注意说书人可能不会提供（关于建议的）来龙去脉或是明晰解释。");
    g_tipLine[13253] = StringToText("· 那些会被认为是不同阵营或角色的角色会影响渔夫获得的提示。例如，一个陌客可能被认为是恶魔，导致说书人建议你处决他。");
    g_tipLine[13254] = StringToText("  要提防这种可能性。");
    g_tipRoleAt[79] = 13197; g_tipRoleN[79] = 58; g_tipP1At[79] = 13200; g_tipP1N[79] = 8; g_tipP2At[79] = 0; g_tipP2N[79] = 0;
    g_tipAbility[79] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipLine[13255] = StringToText("【背景故事】");
    g_tipLine[13256] = StringToText("「即使那些高高在上的人也需要吃东西。没有了我们，城市就会挨饿。」");
    g_tipLine[13257] = StringToText("【角色能力】");
    g_tipLine[13258] = StringToText("当你在夜晚死亡时，一名存活的善良玩家会变成农夫。");
    g_tipLine[13259] = StringToText("【角色简介】");
    g_tipLine[13260] = StringToText("农夫能够创造更多的农夫。");
    g_tipLine[13261] = StringToText("· 如果一名农夫在夜晚死亡，会有另一名玩家变成农夫。");
    g_tipLine[13262] = StringToText("· 只有善良玩家能够通过这种方式变成农夫。");
    g_tipLine[13263] = StringToText("· 如果这名新的农夫也在夜晚死亡了，会再次有另一名农夫被创造出来。");
    g_tipLine[13264] = StringToText("· 在白天死亡的农夫，例如因处决而死亡，无法创造新的农夫。");
    g_tipLine[13265] = StringToText("· 已经转为邪恶阵营的农夫，例如受到灵言师的能力所影响，仍然可以创造新的农夫。");
    g_tipLine[13266] = StringToText("  然而已经转为邪恶阵营的镇民和外来者无法因为这种方式被变成农夫。");
    g_tipLine[13267] = StringToText("· 农夫们之间不会互相认识，但是每名变成农夫的玩家都会得知他现在是农夫了。");
    g_tipLine[13268] = StringToText("· 当一名玩家变成农夫后，他不再是原本的角色，也不再拥有那个角色的能力。");
    g_tipLine[13269] = StringToText("  所有与他原本能力相关的持续性效果都会立即终止。");
    g_tipLine[13270] = StringToText("【范例】");
    g_tipLine[13271] = StringToText("小佳是农夫，恶魔在夜晚杀死了他。小文是恐惧之灵，小美是炼金术士。小美在当晚变成了农夫。小文无法因此变成农夫，");
    g_tipLine[13272] = StringToText("  因为他是邪恶玩家。");
    g_tipLine[13273] = StringToText("在第二个夜晚，农夫死亡。小精灵变成了农夫。在第三个夜晚，新的农夫死亡，善良的异端分子变成了农夫。");
    g_tipLine[13274] = StringToText("  现在异端分子和小精灵都不在场了，并且有三名农夫在场，其中两名已死亡。");
    g_tipLine[13275] = StringToText("农夫在夜晚死亡。间谍被当作了善良阵营，并因此变成了农夫，但实际上他仍然保持为邪恶阵营不变。");
    g_tipLine[13276] = StringToText("【运作方式】");
    g_tipLine[13277] = StringToText("如果农夫在夜晚死亡，唤醒一名存活的善良玩家。对他展示「你是」信息标记和农夫角色标记，然后让他重新入睡。");
    g_tipLine[13278] = StringToText("  用农夫角色标记替换他此前的角色标记。");
    g_tipLine[13279] = StringToText("【提示标记】");
    g_tipLine[13280] = StringToText("无");
    g_tipLine[13281] = StringToText("【规则细节】");
    g_tipLine[13282] = StringToText("· 存活且善良的玩家才会因农夫的能力变成农夫，所以在农夫行动顺序之前已经死亡的玩家或已经转变为邪恶阵营的玩家不会因农夫");
    g_tipLine[13283] = StringToText("  的能力变成农夫。");
    g_tipLine[13284] = StringToText("· 特定角色互动：");
    g_tipLine[13285] = StringToText("  · 食人族/哲学家/小精灵：如果获得农夫能力的玩家在夜晚死亡，他会让一个存活善良玩家变成农夫，");
    g_tipLine[13286] = StringToText("    而不是变成他原本实际的角色。");
    g_tipLine[13287] = StringToText("  · 侍女：当晚如果一名玩家仅被唤醒告知角色变成农夫，他是因为之前农夫的能力被唤醒，所以不会被侍女探查。然而，");
    g_tipLine[13288] = StringToText("    如果当晚该玩家在变成农夫之前因自身能力醒来，尽管他现在拥有的是不同的能力，侍女仍会探查。");
    g_tipLine[13289] = StringToText("  · 赌徒：如果赌徒已经赌错并死亡，他不能在当晚的晚些时候变成农夫，因为他已经死亡。");
    g_tipLine[13290] = StringToText("  · 造谣者：如果当晚造谣者在行动顺序之前变成农夫，没有玩家会因造谣者而死，因为造谣者这个角色离场了。然而，");
    g_tipLine[13291] = StringToText("    农夫可以因为造谣者的能力死亡后让造谣者自己变成农夫。");
    g_tipLine[13292] = StringToText("  · 半兽人：如果半兽人杀死农夫，然后变成农夫，当晚恶魔能够造成死亡，因为场上不再有半兽人能力阻止恶魔的杀戮。");
    g_tipLine[13293] = StringToText("  · 数学家：玩家变成农夫并且不再能够使用他之前的能力，数学家不会检测。");
    g_tipLine[13294] = StringToText("  · 镇长：农夫可以代替镇长死亡，之后善良的镇长也可以变成农夫。");
    g_tipLine[13295] = StringToText("  · 罂粟种植者：如果罂粟种植者变成农夫，邪恶阵营无法互认。");
    g_tipLine[13296] = StringToText("  · 莽夫：可以变成农夫。先前的农夫玩家没有使用自身能力选择莽夫，是说书人选择，所以莽夫不会导致之前的农夫醉酒。");
    g_tipLine[13297] = StringToText("  · 间谍：可以被当作善良玩家，变成农夫。");
    g_tipLine[13298] = StringToText("  · 旅行者：根据标准钟楼规则，旅行者不能改变角色，因此存活的善良旅行者无法变成农夫。");
    g_tipLine[13299] = StringToText("  · 咖啡师：如果当晚因为咖啡师导致农夫能力生效两次，农夫的死亡会导致两名存活善良玩家变成农夫。");
    g_tipLine[13300] = StringToText("· 相克规则：");
    g_tipLine[13301] = StringToText("  · 利维坦：每个夜晚*，利维坦要选择一名存活玩家（与之前的每个夜晚不同）：如果农夫被选择，他的能力生效但不会死亡。");
    g_tipLine[13302] = StringToText("  · 暴乱：每个夜晚*，暴乱要选择一名存活玩家（与之前的每个夜晚不同）：如果农夫被选择，他的能力生效但不会死亡。");
    g_tipLine[13303] = StringToText("【提示与技巧】");
    g_tipLine[13304] = StringToText("· 如果你在夜晚死亡，静静地等待某名玩家作为新任农夫搭讪你。");
    g_tipLine[13305] = StringToText("· 农夫能够成为邪恶阵营的强力牢笼。如果你在夜晚变为农夫，联系最近死亡的玩家，告诉他们现在你是农夫。");
    g_tipLine[13306] = StringToText("  这种互动很难伪装，这意味着你们两个可以互相信任。");
    g_tipLine[13307] = StringToText("· 如果你发觉你想活下来，作为农夫现身，公然激恶魔在夜晚杀死你。在夜晚没有其他死亡来源的游戏中尤其有效。");
    g_tipLine[13308] = StringToText("  这能够迷惑恶魔，让他们反复揣测你的动机。");
    g_tipLine[13309] = StringToText("· 宣称自己是那些高优先级目标，例如赏金猎人或是占卜师，诱骗恶魔在夜晚杀死你。一旦你死亡并确认了新农夫是谁，");
    g_tipLine[13310] = StringToText("  就宣称你和他其实交换过（宣称的）角色，他们才是真正的高优先级目标，诱使恶魔也杀死他们。");
    g_tipLine[13311] = StringToText("· 试着不要立刻公开现身，因为建立一个大的农夫团队比一个小的农夫团队要厉害得多。回溯这些信息（链）");
    g_tipLine[13312] = StringToText("  让新农夫能够获得你可以信任的确切信息。");
    g_tipLine[13313] = StringToText("· 试着寻找一个高优先级目标并和他们交换（宣称的）角色，这样你可以作为一个优秀的目标在夜晚被杀，");
    g_tipLine[13314] = StringToText("  这也有助于保护其他玩家，尤其是当你是第一任农夫时。");
    g_tipLine[13315] = StringToText("· 试着在游戏过程中和多数人交谈，这样使你看起来像是在传播关于邪恶阵营重要信息，");
    g_tipLine[13316] = StringToText("  这样能让你看起来是一个需要被灭口的高优先级目标。");
    g_tipLine[13317] = StringToText("· 不惜代价避免处决，因为你的能力只在你死于夜晚时才能触发。");
    g_tipLine[13318] = StringToText("· 在你确认了一批玩家已经转变为农夫时一起现身，并使用这些信息作为开始寻找邪恶玩家的基础。");
    g_tipLine[13319] = StringToText("  这是一个分辨你可以信任和不能信任的人的优秀策略。");
    g_tipLine[13320] = StringToText("· 如果一个农夫链人数大于当前游戏设置中的邪恶玩家总数，这基本意味着你可以信任该农夫队伍中的所有人。");
    g_tipLine[13321] = StringToText("· 让强力角色转变为农夫比试着让他们在夜晚存活能带来更多好处。不要因为害怕把强力角色转变为农夫而害怕在夜晚死亡。");
    g_tipLine[13322] = StringToText("· 注意玩家在成为农夫之前的角色。如果他们是外来者，这可能是一个善良阵营做得不够好的线索，说书人正试图帮助他们。");
    g_tipLine[13323] = StringToText("  如果是一个游戏开始时能力的玩家或已经使用了能力的每场游戏限一次能力角色，这意味着游戏是均势。如果是一个强力角色，");
    g_tipLine[13324] = StringToText("  也许这意味着善良阵营即将获胜。");
    g_tipRoleAt[80] = 13255; g_tipRoleN[80] = 70; g_tipP1At[80] = 13257; g_tipP1N[80] = 13; g_tipP2At[80] = 13281; g_tipP2N[80] = 22;
    g_tipAbility[80] = StringToText("当你在夜晚死亡时，一名存活的善良玩家会变成农夫。");
    g_tipLine[13325] = StringToText("【背景故事】");
    g_tipLine[13326] = StringToText("「要魔像帮忙？魔像来碾碎！魔像帮了忙。」");
    g_tipLine[13327] = StringToText("【角色能力】");
    g_tipLine[13328] = StringToText("每局游戏你只能发起提名一次。当你发起提名时，如果被你提名的玩家不是恶魔，他死亡。");
    g_tipLine[13329] = StringToText("【角色简介】");
    g_tipLine[13330] = StringToText("魔像会杀死他提名的玩家。");
    g_tipLine[13331] = StringToText("· 当魔像提名了一名玩家后，那名玩家会立即死亡。提名流程会继续正常进行。");
    g_tipLine[13332] = StringToText("· 如果魔像提名了恶魔，无事发生。说书人无需对魔像的提名进行确认或否决，而是继续如常进行投票流程。如果玩家有需要，");
    g_tipLine[13333] = StringToText("  说书人也可以说「无事发生」。");
    g_tipLine[13334] = StringToText("· 当魔像进行了一次提名之后，不论被他提名的人是否死亡，魔像在这局游戏中都不能再进行提名。");
    g_tipLine[13335] = StringToText("  不再进行提名是玩家的责任而非说书人的责任，故意在不应该提名的情况下进行提名会被当作是作弊。");
    g_tipLine[13336] = StringToText("【范例】");
    g_tipLine[13337] = StringToText("魔像提名了罂粟种植者。罂粟种植者死亡。魔像在这局游戏中不能再提名了。");
    g_tipLine[13338] = StringToText("魔像提名了陌客，说书人决定让陌客被当作是恶魔。无事发生，随后说书人开始了对陌客的处决投票。");
    g_tipLine[13339] = StringToText("  魔像在这局游戏中不能再提名了。");
    g_tipLine[13340] = StringToText("【运作方式】");
    g_tipLine[13341] = StringToText("如果魔像提名了一名非恶魔玩家，那名玩家死亡，投票会继续正常进行。使用「无法提名」标记标记魔像。");
    g_tipLine[13342] = StringToText("如果魔像提名了一名恶魔玩家，投票继续正常进行。（不要说明原因）使用「无法提名」标记标记魔像。");
    g_tipLine[13343] = StringToText("如果魔像意外地在无法提名的时候这么做了，你可以接受或拒绝这项提名。最好来说是拒绝这项提名，");
    g_tipLine[13344] = StringToText("  前提是这不会证明是否真的有魔像在场。为了让游戏变得更加公平，即使玩家是在伪装成魔像，");
    g_tipLine[13345] = StringToText("  也应该提醒他们不能进行多于一次的提名。");
    g_tipLine[13346] = StringToText("【提示标记】");
    g_tipLine[13347] = StringToText("· 无法提名");
    g_tipLine[13348] = StringToText("放置时机：在魔像进行了首次提名之后。");
    g_tipLine[13349] = StringToText("放置条件：放置在魔像角色标记旁边。");
    g_tipLine[13350] = StringToText("移除时机：魔像死亡或离场时。");
    g_tipLine[13351] = StringToText("【规则细节】");
    g_tipLine[13352] = StringToText("· 特定角色互动：");
    g_tipLine[13353] = StringToText("  · 弄臣/水手/茶艺师/暴风捕手：在满足能力要求的情况下都可以阻止魔像造成的死亡。");
    g_tipLine[13354] = StringToText("  · 陌客：可以被当作恶魔，从而免于因魔像的能力而死。");
    g_tipLine[13355] = StringToText("  · 修补匠：可以令修补匠在适当时刻死亡以（让对方）模拟魔像。");
    g_tipLine[13356] = StringToText("  · 女巫：如果健康清醒且被女巫诅咒的魔像提名非恶魔玩家，说书人来决定谁的能力优先触发。但通常是让魔像先触发，");
    g_tipLine[13357] = StringToText("    这样可以保证两个角色的能力都能正常生效。如果魔像提名的是女巫，那么说书人就只能从其中选择一个能力来进行触发了（因");
    g_tipLine[13358] = StringToText("    为一个效果触发后导致一名玩家死亡，另一个效果就无法被触发了）。");
    g_tipLine[13359] = StringToText("  · 咖啡师：即使受到咖啡能力生效两次效果的影响，魔像仍被限制为每局游戏只能提名一次。但当魔像提名时，");
    g_tipLine[13360] = StringToText("    被提名玩家会死亡两次。所以受咖啡行动两次效果影响的魔像可以在一次提名中直接杀死一个未使用能力的弄臣。");
    g_tipLine[13361] = StringToText("    如果魔像已经使用了他唯一的一次提名机会，那么咖啡师对他没有任何效果。");
    g_tipLine[13362] = StringToText("【提示与技巧】");
    g_tipLine[13363] = StringToText("· 如果你想证明你是魔像，提名一名你确定不是恶魔的玩家。那名玩家会死亡，善良阵营会相信你是魔像。");
    g_tipLine[13364] = StringToText("  然而这个策略有一个非常明显的缺点，那就是失去了两名善良玩家的提名权。在以这种方式提名之前，问问自己「这值得吗？」");
    g_tipLine[13365] = StringToText("· 如果你想查明一名玩家是否是恶魔，请提名他们。如果他们没有死亡，你就会知道他们是恶魔。");
    g_tipLine[13366] = StringToText("  你可能很难说服善良阵营你是魔像，因为你的提名与来自一名邪恶玩家的提名并无法区分，但是你自己能知道真相。");
    g_tipLine[13367] = StringToText("  这有重大意义。");
    g_tipLine[13368] = StringToText("· 如果你想从游戏中移除一个爪牙，请耐心等待并只在你认为你已经查明了谁是爪牙时才提名。爪牙仍然可以死于你的能力，");
    g_tipLine[13369] = StringToText("  这可能格外有用。和其他外来者不同，魔像的能力完全可以用来帮助善良阵营。");
    g_tipLine[13370] = StringToText("· 如果你已经提名，注意还有多少玩家仍存活。还要谨记多少邪恶玩家可能仍然存活。如果游戏到了只有三名玩家存活的时机，");
    g_tipLine[13371] = StringToText("  其中包括你和另外两名邪恶玩家，那么善良阵营将无法获胜，因为没有人能提名恶魔。");
    g_tipLine[13372] = StringToText("  同样的如果包括你在内的四名玩家还存活，而仅存的另一名善良玩家提名了一名非恶魔玩家，那么善良阵营将无法获胜。");
    g_tipLine[13373] = StringToText("  在游戏早期无法提名不会太不利，但是在最后一天可能会成为重大缺陷。");
    g_tipLine[13374] = StringToText("· 如果可以的话，把你的能力留到最后一天。如果只有另外两名玩家存活，你有一半机会选择到恶魔并知道恶魔是谁。");
    g_tipLine[13375] = StringToText("  如果你意外地选择了非恶魔玩家而落败，至少游戏落败是因为善良玩家进行了一次五五开的选择而不是邪恶阵营投票超过了善良");
    g_tipLine[13376] = StringToText("  阵营。一个善良玩家决定游戏命运通常会好于把事情交给一次民主投票。");
    g_tipLine[13377] = StringToText("· 考虑一直不提名。虽然这可能会比较无聊（嘘！），但有时候最好还是让玩家存活（耶！）。");
    g_tipRoleAt[81] = 13325; g_tipRoleN[81] = 53; g_tipP1At[81] = 13327; g_tipP1N[81] = 9; g_tipP2At[81] = 13351; g_tipP2N[81] = 11;
    g_tipAbility[81] = StringToText("每局游戏你只能发起提名一次。当你发起提名时，如果被你提名的玩家不是恶魔，他死亡。");
    g_tipLine[13378] = StringToText("【背景故事】");
    g_tipLine[13379] = StringToText("「别摸头发，亲爱的。」");
    g_tipLine[13380] = StringToText("【角色能力】");
    g_tipLine[13381] = StringToText("所有爪牙都知道落难少女在场。每局游戏限一次，任意爪牙可以公开猜测你是落难少女，如果猜对，你的阵营落败。");
    g_tipLine[13382] = StringToText("【角色简介】");
    g_tipLine[13383] = StringToText("落难少女需要避免被爪牙发现。");
    g_tipLine[13384] = StringToText("· 如果一名爪牙公开猜中了落难少女（因此所有玩家都知道他是爪牙），邪恶阵营获胜。");
    g_tipLine[13385] = StringToText("· 不论有多少爪牙在场，他们都仅仅只有一次猜测的机会。如果有爪牙做出了猜测但答案错误，");
    g_tipLine[13386] = StringToText("  后续做出的任何猜测都不会再生效。");
    g_tipLine[13387] = StringToText("· 如果恶魔假装自己是爪牙并做出了猜测，这次猜测不会计算在内。爪牙仍然能够进行猜测并在猜中后获胜。");
    g_tipLine[13388] = StringToText("· 爪牙可以在任何时候做出猜测。");
    g_tipLine[13389] = StringToText("· 如果落难少女死亡，她将不再承担被爪牙猜中的风险，因为她在死亡时已经失去了能力。");
    g_tipLine[13390] = StringToText("· 巡山人并非一定会与落难少女一同出场。但如果巡山人在场，且在夜晚时选中了落难少女，");
    g_tipLine[13391] = StringToText("  那么落难少女就会变成一个不在场的镇民，且不再是落难少女。落难少女会得知自己变成了哪一镇民，");
    g_tipLine[13392] = StringToText("  且从那一刻起具有这一镇民的能力。");
    g_tipLine[13393] = StringToText("【范例】");
    g_tipLine[13394] = StringToText("小明是落难少女。他声称自己是半兽人。女巫猜测小明是落难少女。邪恶阵营获胜。");
    g_tipLine[13395] = StringToText("道哥是落难少女。炸弹人猜测小佳是落难少女。无事发生，游戏继续。随后哥布林猜测道哥是落难少女。同样无事发生，");
    g_tipLine[13396] = StringToText("  游戏继续。");
    g_tipLine[13397] = StringToText("【运作方式】");
    g_tipLine[13398] = StringToText("在首个夜晚，唤醒所有爪牙。对他们展示落难少女角色标记。让爪牙们重新入睡。");
    g_tipLine[13399] = StringToText("在游戏中的任意时间，如果一名爪牙公开猜测谁是落难少女且结果错误，使用「已被猜测」标记落难少女。");
    g_tipLine[13400] = StringToText("  后续的所有来自爪牙的猜测都不再产生效果。");
    g_tipLine[13401] = StringToText("在游戏中的任意时间，如果一名爪牙公开猜测谁是落难少女且结果正确（同时「已被猜测」标记尚未放置），游戏结束。");
    g_tipLine[13402] = StringToText("  宣布邪恶阵营获胜。");
    g_tipLine[13403] = StringToText("【提示标记】");
    g_tipLine[13404] = StringToText("· 已被猜测");
    g_tipLine[13405] = StringToText("放置时机：在一名爪牙玩家进行了对落难少女的猜测，且猜测错误之后。");
    g_tipLine[13406] = StringToText("放置条件：放置在落难少女的角色标记旁边。");
    g_tipLine[13407] = StringToText("移除时机：落难少女死亡或离场时。");
    g_tipLine[13408] = StringToText("【规则细节】");
    g_tipLine[13409] = StringToText("· 如果落难少女玩家因巡山人变为具有设置调整能力的镇民，设置调整能力不会生效。");
    g_tipLine[13410] = StringToText("· 特定角色互动：");
    g_tipLine[13411] = StringToText("  · 食人族：如果食人族获得落难少女的能力，爪牙可以通过猜测该玩家「是落难少女」让食人族玩家的阵营落败。");
    g_tipLine[13412] = StringToText("  · 僧侣：僧侣只能在夜晚保护，并且针对的是恶魔而不是爪牙，所以僧侣的保护不会阻止爪牙正确猜测落难少女并结束游戏。");
    g_tipLine[13413] = StringToText("    除了，一个正在照顾小怪宝的爪牙在夜晚进行猜测，此时落难少女被僧侣保护，我将裁定在这种情况下游戏不会结束。");
    g_tipLine[13414] = StringToText("    （僧侣的保护能力能阻止恶魔通过触发落难少女的能力来获胜，即使这个能力来自于落难少女而不是恶魔。）");
    g_tipLine[13415] = StringToText("  · 理发师：如果落难少女被交换，你不需要重新告知爪牙落难少女在场，尽管落难少女的能力已经重新进场，");
    g_tipLine[13416] = StringToText("    爪牙们会从之前的告知中继续知道落难少女在场。如果一名玩家之前不是爪牙，然后被交换为爪牙角色，");
    g_tipLine[13417] = StringToText("    他会被告知落难少女在场。");
    g_tipLine[13418] = StringToText("  · 莽夫：爪牙猜测莽夫是落难少女不会触发莽夫的阵营转换——爪牙没有使用自身能力选择莽夫。");
    g_tipLine[13419] = StringToText("  · 陌客：可以被当作爪牙并猜测落难少女，并结束游戏。如果你是陌客，也许不去猜测是最好的！");
    g_tipLine[13420] = StringToText("    理论上你可以在对应时刻将陌客当作爪牙并告诉他有落难少女在场，但请不要这样做。");
    g_tipLine[13421] = StringToText("  · 红唇女郎/小恶魔：如果恶魔死亡，并且红唇女郎/某个爪牙变为恶魔，他不能猜测落难少女。");
    g_tipLine[13422] = StringToText("  · 女巫：即使只有三名玩家存活，女巫失去能力，他仍然可以猜测落难少女");
    g_tipLine[13423] = StringToText("  · 军团：军团由于被当作爪牙而能够猜测落难少女。");
    g_tipLine[13424] = StringToText("  · 小怪宝：所有爪牙，包括那名正在照看宝宝而因此还被当作恶魔的爪牙，都会得知落难少女在场并能够进行猜测。");
    g_tipLine[13425] = StringToText("  · 沙巴洛斯：如果落难少女被复活，爪牙同样不会被重新告知有落难少女在场，他们在游戏开始时被告知就足够了。");
    g_tipLine[13426] = StringToText("    如果场上出现之前没有被告知过的新爪牙，他会被告知。因此，最好不要让沙巴洛斯复活落难少女。");
    g_tipLine[13427] = StringToText("    如果在落难少女之前猜测机会已经使用过，在落难少女复活的新场合中，猜测次数重置，因此爪牙还有一次猜测机会。");
    g_tipLine[13428] = StringToText("  · 侍女：如果落难少女玩家因巡山人变成镇民角色的当晚被侍女选择，只有该玩家因为自身新能力醒来才会被侍女算入已唤醒。");
    g_tipLine[13429] = StringToText("    落难少女玩家不是因为自身能力而醒来得知自己的新角色，所以不会被侍女探查。");
    g_tipLine[13430] = StringToText("  · 水手：如果落难少女因巡山人变为成水手，他在当晚不能选择与其他玩家喝酒，因为水手的夜晚顺序已经过去了。");
    g_tipLine[13431] = StringToText("    因此这名（原落难少女）水手玩家在当晚和下一个白天都不会死亡。");
    g_tipLine[13432] = StringToText("· 相克规则：");
    g_tipLine[13433] = StringToText("  · 麻脸巫婆：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[13434] = StringToText("  · 间谍/寡妇：如果间谍/寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[13435] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[13436] = StringToText("  · 戏子（改）：落难少女不会因为戏子（改）的能力醉酒。");
    g_tipLine[13437] = StringToText("【提示与技巧】");
    g_tipLine[13438] = StringToText("· 不要告诉任何人你是落难少女！甚至不要暗示你可能是！如果一名爪牙相信你是落难少女，并正确地猜测你是落难少女，");
    g_tipLine[13439] = StringToText("  那么邪恶阵营获胜。");
    g_tipLine[13440] = StringToText("· 告诉一至两名你信任的玩家你是落难少女来令团队不会在让你透露角色这点上施加太多压力。");
    g_tipLine[13441] = StringToText("  不过在告诉他们之前要非常确保这一至两名玩家是善良的。那些能够证明是善良的角色，比如贞洁者或猎手尤其有用，");
    g_tipLine[13442] = StringToText("  因为某些时候你可以完全信任他们。而即便是那些几乎能证明自己是善良的角色例如送葬者、洗衣妇或是赌徒也值得交流、");
    g_tipLine[13443] = StringToText("  信任并告诉他们你的角色。");
    g_tipLine[13444] = StringToText("· 伪装成镇民而不是外来者。所有玩家都知道有多少外来者在场。所有的爪牙都知道落难少女在场。");
    g_tipLine[13445] = StringToText("  如果宣称是外来者的人数与在场的外来者人数相等，那么爪牙会倾向于更怀疑那些宣称是外来者的玩家。比如，");
    g_tipLine[13446] = StringToText("  只有一名外来者在场，而爪牙知道落难少女在场，并且有一名玩家宣称自己是心上人，那么心上人很可能就是落难少女。");
    g_tipLine[13447] = StringToText("· 爪牙知道你在场。要留心那些比平时更多观察和倾听的人。");
    g_tipLine[13448] = StringToText("· 如果小镇上的人对他们的角色也保持一定程度的沉默，那就不要伪装。如果多数其他玩家没有透露他们是谁，");
    g_tipLine[13449] = StringToText("  保持沉默意味着你看起来就好像是另一个镇民。爪牙需要靠随机选择猜中对他们来说风险太大。");
    g_tipLine[13450] = StringToText("· 如果你是一个落难少女以外的善良角色，但是落难少女在剧本上，要意识到这是善良玩家撒谎或显得可疑的重要原因。");
    g_tipLine[13451] = StringToText("  以更低的怀疑对待其他玩家，对他们透露自己角色施加更少的压力（即使他们已经被提名），整体上对善良阵营网开一面。");
    g_tipLine[13452] = StringToText("  假设落难少女在场，即使没有人宣称自己是落难少女，这种方案也意味着真正的落难少女能有一些掩护。");
    g_tipLine[13453] = StringToText("· 如果你是一个落难少女以外的善良角色，那就假装是落难少女，看看是否能诱骗爪牙猜测你是落难少女。");
    g_tipLine[13454] = StringToText("  你可能只能通过散布谣言而不是公开宣称落难少女的方式证明自己，但成功率不高。如果爪牙猜测你是落难少女，");
    g_tipLine[13455] = StringToText("  那么善良阵营就会得知一个爪牙，这是极好的信息。这种策略在真落难少女在场时也有效——在这种情况下，");
    g_tipLine[13456] = StringToText("  真落难少女可以安全地作为落难少女现身，因为爪牙每局游戏只能猜测一次落难少女。");
    g_tipLine[13457] = StringToText("· 大胆地宣称自己是已经被巡山人选择而转变为其他角色的（前）落难少女！如果这是真的，你不再是落难少女，");
    g_tipLine[13458] = StringToText("  因此爪牙猜测你是落难少女将不会有任何效果。爪牙也许不想冒着透露自己是谁的风险来猜测一个宣称不再是落难少女的落难少女");
    g_tipLine[13459] = StringToText("  。但是要注意……这种策略非常危险。由于你现在仍然是落难少女，邪恶阵营仍然可以通过猜测你是落难少女而获胜，");
    g_tipLine[13460] = StringToText("  并且他们现在知道你是（或曾是）落难少女。");
    g_tipLine[13461] = StringToText("· 如果你怀疑有巡山人，将寻找他作为你的首要任务——如果你转变成一个镇民，你可以获得很棒的能力并且不再能被爪牙指名。");
    g_tipLine[13462] = StringToText("  善良阵营将努力让你们重逢，而邪恶阵营将努力拦截你们，因此在你搜寻时要小心行事！");
    g_tipLine[13463] = StringToText("· 如果一个爪牙现身并猜测你以外的人是落难少女，那恭喜你！邪恶阵营只有一次机会让爪牙指名你，");
    g_tipLine[13464] = StringToText("  你的这部分能力现在失效了。请随意现身，最好看起来幸灾乐祸一些！");
    g_tipLine[13465] = StringToText("· 如果一个爪牙现身并猜测你以外的人是落难少女，那恭喜你！然而，这也许值得警惕——这可能是来自一个邪恶的镇民或是一个");
    g_tipLine[13466] = StringToText("  恶魔的假猜测，因此你现身并幸灾乐祸的行为可能会让一个真正的爪牙因你的傲慢猜测你并获胜。");
    g_tipLine[13467] = StringToText("· 如果你被杀（在夜晚或通过处决），你将不再拥有能力并可以现身。不过要小心不要太过急于被处决——爪牙会注意到的！");
    g_tipLine[13468] = StringToText("· 你掌握着游戏的命运。极少角色具有这种影响力。要记得你的重要性。就像异端分子一样，");
    g_tipLine[13469] = StringToText("  如果错误的人在错误的时间得知了你是谁，你的能力可能会让你的阵营落败。当你存活时，");
    g_tipLine[13470] = StringToText("  你是游戏中最危险的善良玩家（对你们阵营而言！）。");
    g_tipRoleAt[82] = 13378; g_tipRoleN[82] = 93; g_tipP1At[82] = 13380; g_tipP1N[82] = 13; g_tipP2At[82] = 13408; g_tipP2N[82] = 29;
    g_tipAbility[82] = StringToText("所有爪牙都知道落难少女在场。每局游戏限一次，任意爪牙可以公开猜测你是落难少女，如果猜对，你的阵营落败。");
    g_tipLine[13471] = StringToText("【背景故事】");
    g_tipLine[13472] = StringToText("「让我们驱散这不必要的猜忌和愚蠢的妄想吧。这发生的一切都有一个完全合理的解释。是的，");
    g_tipLine[13473] = StringToText("  现在正有一个茶杯在围绕着地球旋转，它太小了，所以你们都无法看见。但我会真实地用我的手端起这真实的瓷器，饮下这茶。");
    g_tipLine[13474] = StringToText("  」");
    g_tipLine[13475] = StringToText("【角色能力】");
    g_tipLine[13476] = StringToText("说书人可以打破游戏规则，如果说书人被处决，善良阵营获胜，即使你已死亡。[无邪恶角色在场]");
    g_tipLine[13477] = StringToText("【角色简介】");
    g_tipLine[13478] = StringToText("无神论者会知道所有玩家均为善良，不存在任何恶魔。");
    g_tipLine[13479] = StringToText("· 如果无神论者会在游戏中出场，那么这局游戏就不会有邪恶玩家——没有爪牙，也没有恶魔。");
    g_tipLine[13480] = StringToText("· 善良玩家会在说书人被处决时获胜。任何存活玩家都可以提名说书人，并且如果存活玩家数量一半或以上的玩家都参与投票，");
    g_tipLine[13481] = StringToText("  说书人就会被处决。（注：与常规的处决方式相同，所以仍然需要满足其他处决条件）");
    g_tipLine[13482] = StringToText("· 如果无神论者不在场，但说书人被处决了，那么邪恶阵营获胜。");
    g_tipLine[13483] = StringToText("· 善良阵营会在仅剩两名玩家存活时落败。");
    g_tipLine[13484] = StringToText("· 说书人可以打破游戏中的任何规则。他可以在一名玩家提名时杀死该玩家来模拟女巫的诅咒，");
    g_tipLine[13485] = StringToText("  在夜晚杀死一名玩家来模拟恶魔的攻击，给出玩家错误的信息来模拟醉酒，在夜晚改变玩家的角色来模拟麻脸巫婆的能力，");
    g_tipLine[13486] = StringToText("  甚至设置不符合常规数量的外来者在场。");
    g_tipLine[13487] = StringToText("【范例】");
    g_tipLine[13488] = StringToText("调查员得知祖母和女裁缝之中有一人是炸弹人。调查员发起了提名，然后死亡了，即使女巫并不在场。");
    g_tipLine[13489] = StringToText("  猎手对造谣者使用了能力，并杀死了他。");
    g_tipLine[13490] = StringToText("有三名外来者在场，然而根据游戏人数，本该只有两名外来者在场。玩家处决了说书人。善良阵营获胜。");
    g_tipLine[13491] = StringToText("【运作方式】");
    g_tipLine[13492] = StringToText("在进行游戏设置，将盲抽袋给玩家进行角色抽取之前，将所有的邪恶角色标记移除，并加入镇民和外来者角色标记，");
    g_tipLine[13493] = StringToText("  直至盲抽袋中的角色标记总数等同于玩家人数。");
    g_tipLine[13494] = StringToText("你可以在你认为合适的时候打破规则。如果你需要，你可以随意使用邪恶角色的相关提示标记。");
    g_tipLine[13495] = StringToText("无神论者是一个非常复杂的角色，仅建议十分熟练的说书人尝试。在游戏的规则熟知和储备之上，");
    g_tipLine[13496] = StringToText("  这个角色还需要你对游戏乐趣与公平性有正确的判断。你的目的是为所有玩家创造一局有趣的游戏，");
    g_tipLine[13497] = StringToText("  所以你应该仅仅在给出适当的错误信息，或是模拟邪恶角色在场时的行为时打破规则。");
    g_tipLine[13498] = StringToText("  如果你能够让玩家相信无神论者并不在场，或者至少让他们探讨这种可能性，那么你就做得很好了。");
    g_tipLine[13499] = StringToText("避免随意创造规则或是改变游戏的获胜条件。乐趣至上，玩家需要知道如果无神论者在场，他们如何才能获胜。");
    g_tipLine[13500] = StringToText("【提示标记】");
    g_tipLine[13501] = StringToText("无");
    g_tipLine[13502] = StringToText("【规则细节】");
    g_tipLine[13503] = StringToText("· 特定角色互动：");
    g_tipLine[13504] = StringToText("  · 炸弹人：在无神论者对局中，说书人有可能决定一名特定玩家将拥有炸弹人的能力，如果他被处决，");
    g_tipLine[13505] = StringToText("    将杀死除三名玩家外的所有玩家。如果你想这样做的话，你应该向玩家确认：如果他们认为这是无神论者的对局，");
    g_tipLine[13506] = StringToText("    他们可以指向说书人，并且作为炸弹人能力的一部分，会导致说书人「被杀」，并让玩家赢得游戏。");
    g_tipLine[13507] = StringToText("  · 侍臣/旅店老板/吟游诗人/解谜大师/水手/心上人：（通常来说）无神论者成功中毒或醉酒将立即结束游戏，");
    g_tipLine[13508] = StringToText("    因为没有存活恶魔，并且说书人不能再通过打破规则来阻止游戏结束。建议打破规则来阻止这种事情的发生，");
    g_tipLine[13509] = StringToText("    因为这可能会导致一个不愉快的结局。");
    g_tipLine[13510] = StringToText("  · 疯子：如果你让疯子在场，你需要将一个恶魔角色标记放入盲抽袋。然而，他只能是疯子而不是恶魔，");
    g_tipLine[13511] = StringToText("    尽管他抽到的是红色标记。");
    g_tipLine[13512] = StringToText("  · 提线木偶：如果你希望无神论者是提线木偶，你将需要使用提线木偶设置规则的方法2（参考提线木偶页面），");
    g_tipLine[13513] = StringToText("    并且将恶魔设置为无神论者的邻座，以便让无神论者成为提线木偶。");
    g_tipLine[13514] = StringToText("  · 政客：如果政客对他的阵营在无神论者对局中落败负最大责任，他可以转变为邪恶阵营并获胜。");
    g_tipLine[13515] = StringToText("· 相克规则：");
    g_tipLine[13516] = StringToText("  · 暴乱：在暴乱的提名链中，如果说书人被提名，玩家要进行投票。如果说书人「即将被处决」，游戏结束；否则，");
    g_tipLine[13517] = StringToText("    说书人要重新发起提名。");
    g_tipLine[13518] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[13519] = StringToText("  · 戏子：戏子无法反转处决说书人导致的胜负结果。");
    g_tipLine[13520] = StringToText("  · 戏子（改）：戏子（改）无法反转处决说书人导致的胜负结果，无神论者不会因为戏子（改）的能力醉酒。");
    g_tipLine[13521] = StringToText("【提示与技巧】");
    g_tipLine[13522] = StringToText("· 如果你是无神论者，你能确切地知道场上不存在恶魔（及其他邪恶角色），你知道只有处决说书人才能获胜，");
    g_tipLine[13523] = StringToText("  如果你能向其他玩家证明你是无神论者，你就能赢得游戏。");
    g_tipLine[13524] = StringToText("· 如果其他玩家起初并不信任你，并且想提名处决一些玩家，请不要惊慌。对于大多数人来说，");
    g_tipLine[13525] = StringToText("  仅仅因为一名玩家在第一天宣称自己是无神论者就处决说书人是一件风险极大的事情，");
    g_tipLine[13526] = StringToText("  让游戏正常地进行几天是更加明智的选择。记住，要不厌其烦地去宣称并说服其他人接受你是无神论者这个事实。");
    g_tipLine[13527] = StringToText("· 记得尽早表露你的角色，隐藏或者谎报你的角色没有任何意义，因为在场并没有邪恶玩家需要去欺骗，");
    g_tipLine[13528] = StringToText("  也不需要躲避恶魔夜晚的攻击。");
    g_tipLine[13529] = StringToText("· 说服尽可能多的玩家去开诚布公地透露自己所知道的所有角色与信息，因为任何的隐藏都是无意义的，");
    g_tipLine[13530] = StringToText("  你们共同的敌人是说书人，而说书人早已知晓一切。");
    g_tipLine[13531] = StringToText("· 如果剧本中存在可能让你陷入醉酒的角色，比如酒鬼，尽你所能弄清楚你是否醉酒。如果你是一个酒鬼，");
    g_tipLine[13532] = StringToText("  那么你其实根本不是无神论者，没有无神论者在场，你们之中其实隐藏着邪恶玩家，处决说书人只会导致邪恶阵营获胜。");
    g_tipLine[13533] = StringToText("· 千万不要害怕死亡，绝大多数的玩家会在某个阶段想要杀死无神论者，以防你是一名虚张声势的邪恶玩家。记住，");
    g_tipLine[13534] = StringToText("  为了善良阵营获胜而死是值得的，即使这会导致说书人在当晚杀死一名或更多的玩家。");
    g_tipLine[13535] = StringToText("· 如果所有善良阵营的玩家的信息都有迹可循而且指向一致，那就杀死所有这些信息中指认为邪恶的玩家。");
    g_tipLine[13536] = StringToText("  一旦这些玩家都死亡之后，让其他玩家相信你是无神论者会更加容易。");
    g_tipLine[13537] = StringToText("· 如果你发现善良阵营的信息出现明显的矛盾，例如一名玩家得知镜像双子在场且另一名玩家得知红唇女郎在场，");
    g_tipLine[13538] = StringToText("  但本场游戏配置只有一个爪牙，你可以向其他玩家说明这些不一致是说书人打破规则的证据。");
    g_tipLine[13539] = StringToText("· 如果当前游戏有特殊胜利能力角色在场，例如镇长或者圣徒，你需要与说书人确定如果在这种情况下，如果你贸然行动，");
    g_tipLine[13540] = StringToText("  游戏是否会结束。最好提前让所有玩家都知道这么做会导致的结果，无论输赢。");
    g_tipRoleAt[83] = 13471; g_tipRoleN[83] = 70; g_tipP1At[83] = 13475; g_tipP1N[83] = 12; g_tipP2At[83] = 13502; g_tipP2N[83] = 19;
    g_tipAbility[83] = StringToText("说书人可以打破游戏规则，如果说书人被处决，善良阵营获胜，即使你已死亡。[无邪恶角色在场]");
    g_tipLine[13541] = StringToText("【背景故事】");
    g_tipLine[13542] = StringToText("「惊不惊喜？！」");
    g_tipLine[13543] = StringToText("【角色能力】");
    g_tipLine[13544] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。");
    g_tipLine[13545] = StringToText("如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipLine[13546] = StringToText("【角色简介】");
    g_tipLine[13547] = StringToText("精神病患者在光天化日之下展开杀戮。");
    g_tipLine[13548] = StringToText("· 在白天时，如果精神病患者宣布自己是精神病患者并公开选择一名玩家，那名玩家死亡。这个能力每个白天只能使用一次，");
    g_tipLine[13549] = StringToText("  且只能在说书人要求开始提名前进行。");
    g_tipLine[13550] = StringToText("· 精神病患者的能力并非强制使用，他可以在自己不想要使用能力时不这么做。");
    g_tipLine[13551] = StringToText("· 精神病患者能够正常被提名和投票。如果精神病患者被处决，他可能不会死亡。");
    g_tipLine[13552] = StringToText("  他会和提名他的玩家进行一次猜拳（石头剪刀布）。提名他的玩家需要赢得猜拳才能让这次处决成功杀死精神病患者。");
    g_tipLine[13553] = StringToText("  如果平局或者猜拳失败，精神病患者会仍然存活。");
    g_tipLine[13554] = StringToText("· 对精神病患者的处决同样计入每个白天限制一次的次数里。如果精神病患者被处决，");
    g_tipLine[13555] = StringToText("  那么今天白天不会再有其他提名和处决发生了。");
    g_tipLine[13556] = StringToText("· 如果精神病患者因为其他原因死亡，例如恶魔的攻击，那么他不会进行猜拳，而是直接死亡。");
    g_tipLine[13557] = StringToText("【范例】");
    g_tipLine[13558] = StringToText("在第一个白天，小米宣称自己是精神病患者，并选择了小文。小文死亡。");
    g_tipLine[13559] = StringToText("精神病患者选择攻击水手。水手没有醉酒，因此没有死亡。今天精神病患者无法再次使用他的能力了。");
    g_tipLine[13560] = StringToText("精神病患者被理发师提名并因此被处决。在猜拳中，理发师出了石头，精神病患者也出了石头，因此精神病患者仍然存活。");
    g_tipLine[13561] = StringToText("  在下一个白天，圣徒提名并处决了精神病患者。圣徒出了布而精神病患者出了剪刀，因此精神病患者仍然存活。在下一个白天，");
    g_tipLine[13562] = StringToText("  理发师再次提名并处决了精神病患者。理发师出了石头而精神病患者出了剪刀，精神病患者死亡。");
    g_tipLine[13563] = StringToText("【运作方式】");
    g_tipLine[13564] = StringToText("每个白天限一次，在你宣布开始提名之前，精神病患者可以公开选择一名玩家。那名玩家死亡。");
    g_tipLine[13565] = StringToText("如果精神病患者被处决，他需要与提名他的玩家进行猜拳。如果精神病患者在猜拳中输了，那么他死亡。");
    g_tipLine[13566] = StringToText("  如果精神病患者在猜拳中平局或获胜，他会仍然存活。不论猜拳是哪种结果，白天阶段会随即结束，");
    g_tipLine[13567] = StringToText("  因为每个白天只会有一次处决发生。");
    g_tipLine[13568] = StringToText("如果精神病患者因为提名自己或是某些角色的能力效果而被处决，那么他会改为和你进行猜拳。");
    g_tipLine[13569] = StringToText("【提示标记】");
    g_tipLine[13570] = StringToText("无");
    g_tipLine[13571] = StringToText("【规则细节】");
    g_tipLine[13572] = StringToText("· 特定角色互动：");
    g_tipLine[13573] = StringToText("  · 炼金术士：如果炼金术士获得精神病患者的能力并提名贞洁者而因此被处决，他将会和说书人猜拳。");
    g_tipLine[13574] = StringToText("  · 咖啡师：「行动两次」的效果将允许精神病患者在白天杀死2人（咖啡师可能会被立即流放），");
    g_tipLine[13575] = StringToText("    但如果在接下来的这个白天精神病患者被处决，仍然只会进行一次猜拳。");
    g_tipLine[13576] = StringToText("  · 屠夫：每天都可以重新提名精神病患者来进行第二次处决并尝试杀死他。");
    g_tipLine[13577] = StringToText("  · 魔鬼代言人 ：即使受到魔鬼代言人的保护，精神病患者仍然应该进行猜拳，只有当他输了时，");
    g_tipLine[13578] = StringToText("    善良阵营才会发现精神病患者受到了魔鬼代言人的保护，因为精神病患者没有死于一次「猜拳胜利」的处决。");
    g_tipLine[13579] = StringToText("  · 弄臣/水手/茶艺师：如果精神病患者的目标不能死亡，目标不会死亡。这会被数学家记录。");
    g_tipLine[13580] = StringToText("  · 法官：如果法官强制使对精神病患者的提名通过，这只能确保精神病患者被处决，并且将需要进行猜拳来确定他是否会死亡。");
    g_tipLine[13581] = StringToText("  · 呆瓜/月之子：如果精神病患者杀死他，他会在白天得知他的死亡，因此必须在同一天做出选择。");
    g_tipLine[13582] = StringToText("  · 亡骨魔：如果精神病患者被亡骨魔杀死并因此在死亡状态保留了他的能力，如果他在死亡状态被处决，");
    g_tipLine[13583] = StringToText("    则没有必要进行猜拳——他已经死亡，因此无论猜拳的结果如何都不会再次死亡。");
    g_tipLine[13584] = StringToText("· 相克规则：");
    g_tipLine[13585] = StringToText("  · 小怪宝：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[13586] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[13587] = StringToText("  · 姑获鸟：如果姑获鸟获得了精神病患者的能力，他会在被处决时死亡。");
    g_tipLine[13588] = StringToText("【提示与技巧】");
    g_tipLine[13589] = StringToText("· 在第一天或尽可能早表明角色，并立即开始杀戮。就算杀死的玩家不是那么理想，比如已经使用过能力的玩家，还是有帮助的。");
    g_tipLine[13590] = StringToText("  如果善良阵营每天处决一名玩家，而你和恶魔每天杀死两名玩家，那么无论死亡的是谁，你仍然有优势。");
    g_tipLine[13591] = StringToText("  尤其是在多人的场次中，善良阵营可能想立即处决你，但如果他们需要几天时间来实现处决，那对你来说还是值得的。");
    g_tipLine[13592] = StringToText("· 等待完美的机会再表明角色。有的剧本可能会有一些（对邪恶阵营）极其危险的镇民，");
    g_tipLine[13593] = StringToText("  为了对这些特别强大的角色(例如半兽人、国王或异教领袖)发动突然袭击，隐藏几天是值得的。");
    g_tipLine[13594] = StringToText("  即使你杀死了这个玩家后马上就死亡，也足以为邪恶阵营挽救游戏。");
    g_tipLine[13595] = StringToText("· 等到游戏将要结束再表明角色。如果你能活到只剩最后三名玩家时，可以在最后一天提名前杀死一名玩家并赢得比赛。或者，");
    g_tipLine[13596] = StringToText("  如果有四到五名玩家还活着，你可以杀死一个玩家，并迫使善良阵营在当天面临胜负抉择：处决恶魔否则当晚落败。");
    g_tipLine[13597] = StringToText("· 请注意，即使你是非常强大的爪牙，也有一个明显的缺点：善良阵营知道哪个玩家是爪牙，");
    g_tipLine[13598] = StringToText("  这意味着他们可以排除一个处决的对象。此外，有的角色如果的得知了爪牙信息能力会变得非常强大，例如贵族、");
    g_tipLine[13599] = StringToText("  钟表匠或气球驾驶员。");
    g_tipLine[13600] = StringToText("· 必要时自杀。在游戏快结束时，你死了（离邪恶阵营胜利条件更近一步）通常比活着且被认定不是恶魔要好得多。");
    g_tipLine[13601] = StringToText("  你可以用你的能力去死，甚至公开表明你愿意被恶魔杀死来达成这个目的。");
    g_tipLine[13602] = StringToText("· 在存活时尽可能多地获取信息。在私聊中留意善良玩家分别是什么角色，哪些玩家正在计划什么。和每个玩家都聊聊。");
    g_tipLine[13603] = StringToText("  你甚至不需要和其他邪恶玩交流，但如果你愿意也可以试试。即使善良玩家可能会觉得你很烦人，但你拥有的信息越多，");
    g_tipLine[13604] = StringToText("  意味着您越清楚每天要攻击谁。");
    g_tipLine[13605] = StringToText("· 在适当的时候吃下一些处决。在游戏早期，最好让大家处决其他玩家，因为处决到恶魔的几率很低。在游戏后期，");
    g_tipLine[13606] = StringToText("  通常最好让善良阵营来处决你，否则恶魔被处决的几率很高。如果你能说服善良阵营在恶魔被怀疑时的处决你，那么对你有利。");
    g_tipLine[13607] = StringToText("  在恶魔被信任的时候如果你能说服善良阵营不处决你，那么每天都有一个善良被处决和一个善良玩家因精神病患者而死，");
    g_tipLine[13608] = StringToText("  这对你有利。");
    g_tipLine[13609] = StringToText("· 当只有四五个玩家活着时，请仔细考虑攻击谁。一个精明的善良玩家会意识到，当你在提名前攻击一名玩家时，");
    g_tipLine[13610] = StringToText("  仅四名玩家存活且带着一个活着的精神病患者入夜，这将意味着第二天灾祸降临（善良阵营落败）。");
    g_tipLine[13611] = StringToText("· 不要怕死，但要尽量活得长久。在一场多人游戏中，一个幸运的善良阵营在第一天处决了精神病患者，");
    g_tipLine[13612] = StringToText("  他们移除并确认了一个原本要花费大量时间的爪牙。这对您没有帮助，也不是很有趣。");
    g_tipLine[13613] = StringToText("· 你也可以在不表明角色，默默等待被处决。你能力的猜拳部分仍然会激活，即使善良阵营不知道你是精神病患者。");
    g_tipLine[13614] = StringToText("  这样可以浪费当天的处决机会，并且仍然允许您在第二天攻击玩家。当然，前提是你不输掉猜拳。");
    g_tipLine[13615] = StringToText("· 如果有角色在游戏中交换恶魔，即使善良阵营知道你是精神病患者，有时在白天不使用你的能力会很有用。例如，");
    g_tipLine[13616] = StringToText("  如果剧本中有小恶魔、方古或麻脸巫婆，你可以欺骗优秀的团队来处决你，因为他们可能认为你不再具有能力。");
    g_tipLine[13617] = StringToText("· 学习一些石头剪子布的心理学。与正常情况不同，您不需要获胜。获胜或打平对您来说都可以。");
    g_tipLine[13618] = StringToText("  与其试图弄清楚你的猜拳对手会做什么（三分之一的机会），你需要做的就是弄清楚他们不会做什么（三分之二的机会）。");
    g_tipLine[13619] = StringToText("  如果你认为他们不会出石头，就出剪刀。如果你认为他们不会出剪刀，就出布。如果你认为他们不会出布，就出石头。");
    g_tipLine[13620] = StringToText("· 每隔一段时间，杀死一个邪恶的玩家。如果优秀的团队正确地假设你只杀死优秀的玩家，那就是给了他们太多的信息。");
    g_tipLine[13621] = StringToText("  杀死一个邪恶玩家，让他像善良玩家，有时是值得的。");
    g_tipLine[13622] = StringToText("· 可以让邪恶玩家提名你，然后故意输掉。这可能导致提名你的邪恶玩家第二天会被处决，但偶尔也是值得的。");
    g_tipLine[13623] = StringToText("【对抗精神病患者】");
    g_tipLine[13624] = StringToText("· 在精神病患者表明角色并使用能力之前，没有太多针对的事情可以做。直到他们的处决失败时，你才会的得知精神病患者在场，");
    g_tipLine[13625] = StringToText("  那时你可以制定处理他们的策略。");
    g_tipLine[13626] = StringToText("· 一旦精神病患者暴露了自己，请考虑尽快处决他们。每天提名并处决他们，直到精神病患者不幸输掉猜拳而死去。");
    g_tipLine[13627] = StringToText("  这种策略在精神病患者很早表明角色的多人游戏中是最好的。花几天时间将他处决掉是值得的，以免他杀死三、四、");
    g_tipLine[13628] = StringToText("  五甚至更多玩家。");
    g_tipLine[13629] = StringToText("· 一旦精神病患者暴露了自己，只要没有充分的理由杀死另一名玩玩家，考虑每天都处决精神病患者。如果你不知道恶魔是谁，");
    g_tipLine[13630] = StringToText("  最好一遍又一遍地处决精神病患者并希望好运发生。当游戏有四、五或六名玩家活着时，您可以将注意力转移到寻找恶魔上。");
    g_tipLine[13631] = StringToText("· 一旦精神病患者暴露了自己，如果您对恶魔可能是哪个玩家有一两个线索，那就晾着精神病患者不管。");
    g_tipLine[13632] = StringToText("  通常最好的办法是杀死恶魔而不是浪费处决机会在精神病患者身上。");
    g_tipLine[13633] = StringToText("· 如果团队的策略是杀死精神病患者，请确保你每天投票一致。犹豫反复只会让邪恶的团队受益。");
    g_tipLine[13634] = StringToText("· 如果团队的策略是让精神病患者活着并找到恶魔，请对你更强大的角色能力保持沉默，以尽可能少向精神病患者提供信息。");
    g_tipLine[13635] = StringToText("  与你信任的玩家（或任何除精神病患者之外的玩家，真的）交谈，并秘密整理你的信息。精神病患者可能会随时偷听你们私聊，");
    g_tipLine[13636] = StringToText("  所以要小心，并随时小声私聊。或者，为了消除精神病患者干扰，如果您是一个不介意死亡的角色，");
    g_tipLine[13637] = StringToText("  请公开装作精神病患者想要杀死的角色，例如赏金猎人或渔夫。或者，如果你是一个绝对不想死的角色，");
    g_tipLine[13638] = StringToText("  就公开谎称是一个精神病患者懒得碰的角色，比如厨师或告密者。");
    g_tipLine[13639] = StringToText("· 当提名开始时，尽早提名精神病患者。如果提名成功，那将是你和精神病患者猜拳，你至少确定你属于善良阵营。");
    g_tipLine[13640] = StringToText("  警惕其他过于着急提名精神病患者的玩家，因为他们可能是提名精神病患者的邪恶玩家，目的是故意输掉猜拳。");
    g_tipRoleAt[84] = 13541; g_tipRoleN[84] = 100; g_tipP1At[84] = 13543; g_tipP1N[84] = 14; g_tipP2At[84] = 13571; g_tipP2N[84] = 17;
    g_tipAbility[84] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipLine[13641] = StringToText("【背景故事】");
    g_tipLine[13642] = StringToText("「唯有源自内心深处的情感，才能让他人的心灵向你屈从。」");
    g_tipLine[13643] = StringToText("【角色能力】");
    g_tipLine[13644] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipLine[13645] = StringToText("【角色简介】");
    g_tipLine[13646] = StringToText("灵言师向善良玩家提出一笔交易：是否要转为邪恶。");
    g_tipLine[13647] = StringToText("· 在首个夜晚，灵言师从说书人处得知一个关键词。");
    g_tipLine[13648] = StringToText("· 如果善良玩家说出了关键词，不论是公开说出或是私下对说书人说出，他就会在当晚转为邪恶阵营。");
    g_tipLine[13649] = StringToText("  前提条件是说书人需要实际听到那名玩家确切地说出了这个关键词。");
    g_tipLine[13650] = StringToText("· 灵言师不会得知是否有玩家转为了邪恶。说出关键词的善良玩家直到当晚才会得知他是否转为了邪恶。");
    g_tipLine[13651] = StringToText("· 如果灵言师在夜晚是清醒且健康的，那么即使他在白天善良玩家说出关键词时醉酒或中毒，仍然会让这名善良玩家转为邪恶。");
    g_tipLine[13652] = StringToText("  但如果一名玩家即将在夜里转为邪恶时灵言师醉酒中毒了，那么那名玩家会仍然保持善良阵营不变——灵言师会因此消耗他的能力");
    g_tipLine[13653] = StringToText("  的使用次数，并且无法在随后再让其他玩家转为邪恶阵营。");
    g_tipLine[13654] = StringToText("【范例】");
    g_tipLine[13655] = StringToText("灵言师告诉理发师他的关键词是「褶皱翘翘皮」。理发师公开讨论的时候提到了：「这让我想起了一个童话故事，");
    g_tipLine[13656] = StringToText("  米勒的女儿需要猜出褶皱翘翘皮怪人的名字。」理发师在当晚转为了邪恶阵营。");
    g_tipLine[13657] = StringToText("灵言师告诉了镇长他的关键词。镇长仍然想要保持自己的善良阵营不变，并且告诉了其他人谁是灵言师。");
    g_tipLine[13658] = StringToText("灵言师私下告诉了告密者他的关键词是「君士坦丁堡」。告密者私下拜访了说书人，并悄悄说出了「君士坦丁堡」。当晚，");
    g_tipLine[13659] = StringToText("  侍臣让灵言师醉酒了。告密者仍然是善良阵营。");
    g_tipLine[13660] = StringToText("【运作方式】");
    g_tipLine[13661] = StringToText("在为首个夜晚做准备时，用纸条或手机便签或其他便捷的设备写下一个词语。在首个夜晚，唤醒灵言师，");
    g_tipLine[13662] = StringToText("  对他展示你写下的词语，然后让灵言师重新入睡。");
    g_tipLine[13663] = StringToText("当你首次听到有善良玩家说出这个关键词时，使用灵言师的「转为邪恶」提示标记标记那名玩家。");
    g_tipLine[13664] = StringToText("每个夜晚，如果有玩家被标记了「转为邪恶」提示标记，将他唤醒。对他展示「你是」信息标记和朝下的大拇指。");
    g_tipLine[13665] = StringToText("  让他重新入睡。将他的角色标记倒转放置。（这会表示他现在是邪恶阵营了。）灵言师失去能力——将灵言师的「失去能力」");
    g_tipLine[13666] = StringToText("  提示标记放置在灵言师角色标记旁，然后将他的夜晚标记从夜晚顺序表旁移除。");
    g_tipLine[13667] = StringToText("请选择绝对不会无意被说出的非常见词语。你甚至可以杜撰一个词语。灵言师角色的乐趣在于他需要在私下让一名善良玩家转为");
    g_tipLine[13668] = StringToText("  邪恶的同时承担一定的风险，而不是让一名善良玩家在意料之外转变阵营。");
    g_tipLine[13669] = StringToText("【提示标记】");
    g_tipLine[13670] = StringToText("· 转为邪恶");
    g_tipLine[13671] = StringToText("放置时机：在有善良玩家首次说出灵言师的关键词，且被说书人听到时。");
    g_tipLine[13672] = StringToText("放置条件：放置在那名玩家的角色标记旁。");
    g_tipLine[13673] = StringToText("移除时机：在当晚灵言师的行动顺序结束时移除（即使此时灵言师失去能力，也要移除），或在灵言师死亡或离场时移除。");
    g_tipLine[13674] = StringToText("· 失去能力");
    g_tipLine[13675] = StringToText("放置时机：在灵言师的能力即将被触发从而导致一名善良玩家转为邪恶阵营时放置。");
    g_tipLine[13676] = StringToText("放置条件：放置在灵言师角色标记旁。即使灵言师此时失去能力，只要满足他的能力本身的触发条件，就需要放置。");
    g_tipLine[13677] = StringToText("移除时机：在灵言师死亡或离场时移除。");
    g_tipLine[13678] = StringToText("【提示与技巧】");
    g_tipLine[13679] = StringToText("· 确保你正确地听清了或看到了关键词！如果你不太确定，那就向说书人确认。辛辛苦苦说服一名善良玩家加入邪恶阵营，");
    g_tipLine[13680] = StringToText("  却因为让他们说错了关键词导致转变失败，这会让人觉得很傻。他们可能会在这种情况发生后问你许多问题，");
    g_tipLine[13681] = StringToText("  相信没有人会在这个时候不感到尴尬。");
    g_tipLine[13682] = StringToText("· 选择一名很可能愿意转变到邪恶的善良玩家。如果你以前与团队中的各类玩家一起玩过，");
    g_tipLine[13683] = StringToText("  那你应该对哪些玩家更愿意扮演邪恶角色有一些判断。这些玩家会更愿意转变到邪恶阵营。如果你能安排一次与他们的私聊，");
    g_tipLine[13684] = StringToText("  就告诉他们这个关键词或者告诉他们你是灵言师。那他们就有望在当天稍晚时大声公开地说出这个关键词或是私下找说书人说出");
    g_tipLine[13685] = StringToText("  来。");
    g_tipLine[13686] = StringToText("· 选择一个更有理由转变到邪恶的善良角色。一个仍未获得可靠信息的占卜师或守鸦人可能会觉得邪恶阵营即将获胜，");
    g_tipLine[13687] = StringToText("  并因此可能更愿意转变到邪恶阵营。某些外来者，比如心上人或呆瓜，可能会认为他们的能力对善良阵营太具有破坏力，");
    g_tipLine[13688] = StringToText("  并因此可能更愿意转变到邪恶阵营。如果你能安排一次与他们的私聊，就告诉他们这个关键词或者告诉他们你是灵言师。");
    g_tipLine[13689] = StringToText("  如果你足够幸运或是遇到了对的人，他们就可能会说出你的关键词。");
    g_tipLine[13690] = StringToText("· 避免选择一名不太可能愿意转变到邪恶的玩家。如果你知道某名特定玩家确实喜欢做善良阵营的玩家，");
    g_tipLine[13691] = StringToText("  并且常常表现得不太喜欢作为邪恶玩家进行伪装时获得的持续压力，那告诉他们你是灵言师就太过冒险了。要避免这种情况。");
    g_tipLine[13692] = StringToText("· 避免选择一个拥有能够获得大量信息或能为善良阵营所用的强力能力的角色。每晚都在得知新角色的共情者，");
    g_tipLine[13693] = StringToText("  或是已经保护过玩家不受恶魔侵害的僧侣，或是还未使用能力的猎手，这些人都不太可能会愿意转变成邪恶，");
    g_tipLine[13694] = StringToText("  因为他们会感觉自己对善良阵营能提供极大助益。");
    g_tipLine[13695] = StringToText("· 不要对选定与其私聊的善良玩家这件事犹豫过久。在第一天，善良阵营拥有更少的信息，因此更可能对谁是谁感到困惑，");
    g_tipLine[13696] = StringToText("  更愿意转变到邪恶阵营。随着游戏推进，善良阵营获得了越来越多的信息，就更不愿意转变到邪恶阵营，");
    g_tipLine[13697] = StringToText("  因为这看起来像是加入一个即将落败的阵营。并且，如果你在使用能力之前就死亡，这也不怎么好。要想活得够久，");
    g_tipLine[13698] = StringToText("  最好的方法就是尽早使用你的能力。");
    g_tipLine[13699] = StringToText("· 你可以用欺骗一名善良玩家不小心说出关键词的方法，而不必非要选择玩家安排私聊告诉他们你是灵言师。");
    g_tipLine[13700] = StringToText("  通过持续地在公开交谈中持续地大声提及关键词，一个善良玩家也许会以这个词来回应。比如如果关键词是「西瓜」");
    g_tipLine[13701] = StringToText("  而你说「我最近吃了很多西瓜，还有人喜欢吃西瓜吗？」也许某人就会回应说「是的，我也喜欢吃西瓜。」然而，");
    g_tipLine[13702] = StringToText("  这样的对话在旁观者看来会很生硬，善良阵营很可能会意识到你想做什么。");
    g_tipLine[13703] = StringToText("  因为说书人被鼓励选择一个罕见乃至极端不寻常的关键词，这种方法很有风险。另外，");
    g_tipLine[13704] = StringToText("  说书人需要听到这名善良玩家说出这个关键词，而他可能会没意识到这名玩家说了，");
    g_tipLine[13705] = StringToText("  因此善良玩家可能需要说好几次才能让说书人注意到。");
    g_tipLine[13706] = StringToText("· 小心注意善良阵营今天可能处决的人。即使一名善良玩家今天说出了关键词（并且说书人也注意到了），");
    g_tipLine[13707] = StringToText("  这名玩家也不会在今晚之前转变为邪恶。如果你今天被处决，今晚你就没有能力，这样那名玩家就不会转变为邪恶。");
    g_tipLine[13708] = StringToText("  你可以确定明天他就会揭露你是灵言师——而知道谁是爪牙能为善良阵营获胜提供足够的信息。如果你认为今天你会被处决，");
    g_tipLine[13709] = StringToText("  最好不要试图让一名玩家转变为邪恶，转而选择放弃你的能力。");
    g_tipLine[13710] = StringToText("· 如果你有某些方法能躲过处决，比如利维坦或是魔鬼代言人在场，那你可以公开以灵言师角色现身。");
    g_tipLine[13711] = StringToText("  你可以公开告诉团队你是灵言师并且「接触」了一些想要转变为邪恶的玩家。直到其中一名玩家确实转变前，");
    g_tipLine[13712] = StringToText("  他们都会被善良阵营怀疑，他们透露的任何公开信息也都会变得不可信。更嚣张一些的话，");
    g_tipLine[13713] = StringToText("  你甚至可以公开告诉团队这个关键词是什么。你给出的可以是真的关键词，");
    g_tipLine[13714] = StringToText("  也可以是一个让未转变的善良玩家看起来已经转变的干扰项。这套策略对在善良阵营中散播恐惧、迷惑与怀疑方面很有优势，");
    g_tipLine[13715] = StringToText("  但作为代价会暴露你是灵言师。");
    g_tipLine[13716] = StringToText("· 如果灵言师不在场，你可以宣称你已经被灵言师接触过并被告知了关键词。");
    g_tipLine[13717] = StringToText("  这样你或是看起来像是一名勇于拒绝转变为邪恶的善良玩家（你需要选择一名看起来像灵言师的玩家——他们可以是善良或者邪恶");
    g_tipLine[13718] = StringToText("  的），或是看起来像是已经转变为邪恶的善良玩家（但至少你不是恶魔，所以可能并不值得被处决）。但要小心的是，");
    g_tipLine[13719] = StringToText("  这会让你与你宣称给你关键词的玩家产生直接冲突。如果他能被确认角色，那你就麻烦了。此外，");
    g_tipLine[13720] = StringToText("  有些玩家不喜欢这种指控/争论驱动的游戏方式，所以有必要小心你的盟友玩家们。");
    g_tipLine[13721] = StringToText("· 你可以进行许多私聊，告诉许多不同玩家不同的关键词，但都是假的。如果这件事不是在最后一天做的话，");
    g_tipLine[13722] = StringToText("  会让你被处决（因为善良阵营不会在最后一天处决一个爪牙），但也会暂时阻断善良阵营的信息交互。这不是上策，");
    g_tipLine[13723] = StringToText("  但你永远不会知道什么时候你可能真的非常非常需要这么做;)");
    g_tipLine[13724] = StringToText("· 如果你确定一名特定玩家已经转变为邪恶，告诉所有邪恶玩家他是谁，包括恶魔。");
    g_tipLine[13725] = StringToText("  你们现在有了一名额外的能对善良玩家投票的玩家，并且他不会意外地投票给恶魔。");
    g_tipLine[13726] = StringToText("· 你可以通过私下给予一名善良玩家假的关键词的方式来测试他是不是真的想转变为邪恶。");
    g_tipLine[13727] = StringToText("  如果这名玩家假装告诉了说书人这个词，然后假装转变为邪恶，并要求知道其他邪恶玩家是谁，你就会知道他在撒谎。");
    g_tipLine[13728] = StringToText("  给这名玩家关于恶魔是谁的错误信息，因为他觉得你认为他是邪恶的。如果这名玩家告诉你，他试着转变但是没成功，");
    g_tipLine[13729] = StringToText("  你就可以告诉他之前只是在测试他的忠诚并且现在很乐意告诉他真正的关键词。");
    g_tipLine[13730] = StringToText("· 在使用你的能力之前，持续地告诉善良阵营你认为邪恶阵营即将获胜。失去了获胜希望的善良玩家会更有可能愿意转变为邪恶。");
    g_tipLine[13731] = StringToText("【对抗灵言师】");
    g_tipLine[13732] = StringToText("· 如果灵言师接近你并告诉你他是谁，暗示如果你愿意转变到邪恶他就会告诉你关键词，那就暂时答应他。等私聊结束，");
    g_tipLine[13733] = StringToText("  告诉团队谁是灵言师，那么善良玩家将不太可能转变为邪恶，灵言师的能力将不能产生效果。");
    g_tipLine[13734] = StringToText("· 如果灵言师接近你并告诉你关键词，那就向团队暗示这个关键词而不是说出它。同时告诉团队谁是灵言师。");
    g_tipLine[13735] = StringToText("  如果善良阵营知道关键词是什么也知道灵言师是谁，那么善良玩家将不太可能转变为邪恶，灵言师的能力将不能产生效果。");
    g_tipLine[13736] = StringToText("· 如果灵言师接近你并告诉你关键词，答应他会向说书人说出这个关键词。稍后，与说书人私聊但不要说出这个关键词。");
    g_tipLine[13737] = StringToText("  在第二天假装你在前一晚转变成了邪恶阵营，一切尽如计划所设，然后试着去了解其他邪恶玩家是谁。");
    g_tipLine[13738] = StringToText("  如果灵言师告诉了你这些内容，包括恶魔，但是你仍然是善良的……非常好，一场善良阵营的轻松胜利。");
    g_tipLine[13739] = StringToText("· 注意任何在公开讨论中反复使用反常词语或是表现得很想让人参加他的私聊的玩家。");
    g_tipLine[13740] = StringToText("  如果一名玩家一直在高声谈论他们的「廷巴克图」之旅或是他们关于「非线性」问题的大学讲座，那你可能已经发现了灵言师。");
    g_tipLine[13741] = StringToText("  在他们将另一名玩家转变为邪恶之前处决他们。");
    g_tipLine[13742] = StringToText("· 注意那些连续多日进行一对一私聊的玩家。他们可能是在某一天交换了关键词，然后又再次碰头来确认灵言师能力是否生效。");
    g_tipLine[13743] = StringToText("· 如果你是一个可以让邪恶玩家醉酒或中毒的角色，比如水手、侍臣、传教士（其实这个没有醉酒中毒）或炼金术士，");
    g_tipLine[13744] = StringToText("  请对你是谁以及灵言师是否可能醉酒或中毒保持沉默。如果灵言师试图让一名玩家转变为邪恶，但是没有成功，");
    g_tipLine[13745] = StringToText("  那么灵言师可能不会再次使用他们的能力，而善良玩家会得知谁是灵言师。这对善良阵营是一个显著的优势。");
    g_tipLine[13746] = StringToText("  如果灵言师怀疑他们已经醉酒或中毒，那他们就会等到他们认为自己再次清醒并健康时才使用能力。");
    g_tipLine[13747] = StringToText("· 使用亡者的最后一票时多想想。如果灵言师在剧本中，邪恶阵营可能会有额外的一票而善良阵营可能会减少一票。");
    g_tipLine[13748] = StringToText("  鼓励其他死亡玩家也对最后一票多一些思考。这在小规模游戏中尤其重要，因为这样的游戏里每一票都很关键。");
    g_tipLine[13749] = StringToText("· 鼓励所有玩家尽早分享他们的信息，尽早透露他们的角色。每个人能分享的信息越多，就越容易形成善良阵营即将获胜的氛围。");
    g_tipLine[13750] = StringToText("  如果善良阵营相信善良阵营会获胜，那么善良玩家就不太可能由灵言师的能力转变为邪恶。");
    g_tipLine[13751] = StringToText("  毕竟谁愿意加入一个快落败的阵营呢？善良阵营是否真的会获胜并不重要，");
    g_tipLine[13752] = StringToText("  重要的是有高昂的士气来让善良阵营相信善良阵营会获胜。");
    g_tipLine[13753] = StringToText("· 让善良阵营知道灵言师可能在场，并且如果所有人都留在善良阵营，善良阵营将会获得优势。因为所有玩家都承诺保持善良，");
    g_tipLine[13754] = StringToText("  那除了一个爪牙如同没有能力以外，游戏将会如常进行。这虽然不是很大的优势，但每一点优势都是有帮助的。");
    g_tipLine[13755] = StringToText("· 如果一名玩家的信息在连续数日内反复无常自相矛盾，你可能就已经找到了那名被灵言师转变成邪恶的善良玩家。类似的，");
    g_tipLine[13756] = StringToText("  如果其他玩家关于这名玩家的信息不一致也有可能。不要假定这些矛盾是由于醉酒或中毒引起的。");
    g_tipLine[13757] = StringToText("  如果你认为你发现了善良玩家转变成邪恶，那么让他们存活尽可能久。让他们传播他们的谎言。他们不是恶魔，");
    g_tipLine[13758] = StringToText("  所以转而去处决其他玩家。");
    g_tipLine[13759] = StringToText("· 如果一切都完了，你认为这局游戏你将落败，那就去找到灵言师并和他谈谈。「打不过，就加入。」如果你十分绝望、勇敢、");
    g_tipLine[13760] = StringToText("  鲁莽或者机敏而混沌，请随时并反复地高声公布你加入邪恶阵营的想法，希冀于得到灵言师的注意。");
    g_tipLine[13761] = StringToText("· 如果有灵言师接近你想转变你，但你又无法确定，你尽可以与他达成协议：");
    g_tipLine[13762] = StringToText("  你需要等待一段时间观察哪个阵营会获胜来决定是否转变为邪恶，作为交换，");
    g_tipLine[13763] = StringToText("  在你最终决定保持善良前不会向所有人透露他的角色。任何灵言师都可能愿意接受任何不会立即让他作为邪恶玩家现身的计划。");
    g_tipLine[13764] = StringToText("  这让你能处于一个非常有力的地位：你知道一名爪牙，并且能在之后与你认为会获胜的阵营站在一起。");
    g_tipRoleAt[85] = 13641; g_tipRoleN[85] = 124; g_tipP1At[85] = 13643; g_tipP1N[85] = 11; g_tipP2At[85] = 0; g_tipP2N[85] = 0;
    g_tipAbility[85] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipLine[13765] = StringToText("【背景故事】");
    g_tipLine[13766] = StringToText("「黑色罂粟栖息在森林深处的隐蔽树丛里。见到它的狂野生长会为此着迷。闻到它的浓烈香气将永远迷失，");
    g_tipLine[13767] = StringToText("  沦为光明与黑暗之神的奴隶。」");
    g_tipLine[13768] = StringToText("【角色能力】");
    g_tipLine[13769] = StringToText("爪牙和恶魔互相不认识。如果你死亡，当晚他们会互相认识。");
    g_tipLine[13770] = StringToText("【角色简介】");
    g_tipLine[13771] = StringToText("罂粟种植者能够阻止邪恶玩家互相认识。");
    g_tipLine[13772] = StringToText("· 恶魔仍然能够得知三个不在场的角色进行伪装。");
    g_tipLine[13773] = StringToText("· 如果罂粟种植者死亡，恶魔和爪牙会如同是首个夜晚一样互相认识。");
    g_tipLine[13774] = StringToText("· 如果罂粟种植者在游戏中途醉酒或中毒，不会立即使得恶魔和爪牙互相认识。如果罂粟种植者在死亡时醉酒或中毒，");
    g_tipLine[13775] = StringToText("  因为他此时没有任何能力，因此恶魔和爪牙也不会互相认识。");
    g_tipLine[13776] = StringToText("· 邪恶的旅行者在加入游戏时仍然能够得知谁是恶魔。");
    g_tipLine[13777] = StringToText("【范例】");
    g_tipLine[13778] = StringToText("小恶魔、投毒者和女巫在场。在游戏的首个夜晚，小恶魔在被唤醒后得知了三个不在场的善良角色，但不知道哪些玩家是爪牙。");
    g_tipLine[13779] = StringToText("  投毒者和女巫没有被唤醒进行互认，也不知道谁是恶魔。");
    g_tipLine[13780] = StringToText("罂粟种植者死于处决。当晚，沙巴洛斯被唤醒得知哪些玩家是爪牙。教父和男爵被唤醒后通过眼神接触来互认并得知哪名玩家是");
    g_tipLine[13781] = StringToText("  沙巴洛斯。");
    g_tipLine[13782] = StringToText("罂粟种植者实际上是酒鬼。在游戏的首个夜晚，邪恶阵营玩家正常获取「恶魔信息」和「爪牙信息」。第四个夜晚，");
    g_tipLine[13783] = StringToText("  恶魔杀死了罂粟种植者。恶魔和爪牙不会被唤醒得知「恶魔信息」和「爪牙信息」，因为罂粟种植者是酒鬼。");
    g_tipLine[13784] = StringToText("【运作方式】");
    g_tipLine[13785] = StringToText("在首个夜晚，唤醒恶魔。对他展示「这些角色不在场」信息标记以及三个不在场的善良角色标记。然后，让恶魔重新入睡。");
    g_tipLine[13786] = StringToText("  不要进行「爪牙信息」和「恶魔信息」步骤。");
    g_tipLine[13787] = StringToText("如果罂粟种植者死亡，将「唤醒邪恶」提示标记放置在罂粟种植者的角色标记旁。在当晚，");
    g_tipLine[13788] = StringToText("  唤醒爪牙并让他们通过眼神接触来互认。对他们展示「他是恶魔」信息标记，然后指向恶魔玩家。让这些爪牙重新入睡。");
    g_tipLine[13789] = StringToText("  随后唤醒恶魔，对他展示「他们是你的爪牙」信息标记，然后指向所有爪牙。让恶魔重新入睡。");
    g_tipLine[13790] = StringToText("可选规则：如果罂粟种植者醉酒、中毒或离场，当晚爪牙和恶魔会互相认识。");
    g_tipLine[13791] = StringToText("【提示标记】");
    g_tipLine[13792] = StringToText("· 唤醒邪恶");
    g_tipLine[13793] = StringToText("放置时机：在罂粟种植者死亡，且具有能力时放置。");
    g_tipLine[13794] = StringToText("放置条件：放置在罂粟种植者角色标记旁。");
    g_tipLine[13795] = StringToText("移除时机：在安排了恶魔与爪牙的互认环节之后，说书人可以任由自己方便来进行移除。");
    g_tipLine[13796] = StringToText("【规则细节】");
    g_tipLine[13797] = StringToText("· 拥有爪牙或恶魔角色的玩家在罂粟种植者死亡时相互认识，无论阵营和生/死状态。");
    g_tipLine[13798] = StringToText("· 将罂粟种植者变成另一个角色，或罂粟种植者死亡时处于中毒或醉酒状态，将不会导致爪牙/恶魔互认。");
    g_tipLine[13799] = StringToText("· 特定角色互动：");
    g_tipLine[13800] = StringToText("  · 学徒：如果学徒是邪恶阵营，仍然会知道恶魔是谁。学徒罂粟种植者在被恶魔杀死或被流放后，导致邪恶阵营互相认识，");
    g_tipLine[13801] = StringToText("    因为流放也会导致死亡。");
    g_tipLine[13802] = StringToText("  · 食人族/小精灵：如果罂粟种植者被处决并被食人族吃掉或已经被足够疯狂的小精灵知晓，");
    g_tipLine[13803] = StringToText("    食人族或小精灵将在罂粟种植者死亡的同时获得的罂粟种植者能力并阻止恶魔/爪牙互认。");
    g_tipLine[13804] = StringToText("  · 军团：军团玩家不会知道其他军团玩家是谁，但需要单独唤醒他们以提供他们的三个不在场角色。");
    g_tipLine[13805] = StringToText("  · 疯子：剧本里同时有罂粟种植者时，可以向疯子假装有罂粟种植者在场，从而在首夜不告诉疯子，他的「爪牙」是谁。");
    g_tipLine[13806] = StringToText("  · 数学家：首夜不会检测恶魔/爪牙没有互认，因为他们不是通过自身能力获得这些信息，而是通过他们的角色类型。然而，");
    g_tipLine[13807] = StringToText("    数学家会检测到罂粟种植者在死亡时中毒/醉酒并因此不允许恶魔/爪牙互认。");
    g_tipLine[13808] = StringToText("  · 告密者：即使罂粟种植者在场，爪牙也会被单独唤醒并被展示三个不在场角色。");
    g_tipLine[13809] = StringToText("· 相克规则：");
    g_tipLine[13810] = StringToText("  · 间谍：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_tipLine[13811] = StringToText("  · 寡妇：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[13812] = StringToText("  · 召唤师：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，由说书人来决定哪名玩家发生转变。");
    g_tipLine[13813] = StringToText("  · 小怪宝：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，直到其中一名玩家选择照看小怪宝。");
    g_tipLine[13814] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[13815] = StringToText("  · 鸩：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。");
    g_tipLine[13816] = StringToText("  · 孟婆：如果孟婆选中了罂粟种植者，罂粟种植者会得知自己被孟婆选中并死亡。");
    g_tipLine[13817] = StringToText("【提示与技巧】");
    g_tipLine[13818] = StringToText("· 保密就是一切。罂粟种植者的核心力量就是通过无效掉邪恶阵营的核心力量带给邪恶阵营多疑的氛围。");
    g_tipLine[13819] = StringToText("· 荒谬而大声地现身，因为有人大胆而激烈地宣称自己是罂粟种植者这件事非常诡异，");
    g_tipLine[13820] = StringToText("  这会让邪恶阵营不得不再次思考你到底是谁。他们可能会让你存活因为你看起来像是一个像农夫这样试图被杀死的角色。此外，");
    g_tipLine[13821] = StringToText("  恶魔可能并不希望通过杀死你来「证实」你是罂粟种植者。");
    g_tipLine[13822] = StringToText("· 作为罂粟种植者，你基本上需要孤身一人承担让邪恶阵营缺失协调能力的责任。特别注意宣称同一角色的两名玩家。");
    g_tipLine[13823] = StringToText("  其中一名可能是爪牙，因为他们还没有从恶魔那里获得伪装。");
    g_tipLine[13824] = StringToText("· 在第一天要注意谁和谁来往而谁保持沉默。被与阵营中其他人切分的爪牙会格外谨慎，因为他们起始没有信息。具体地说，");
    g_tipLine[13825] = StringToText("  要注意玩家的肢体语言，因为他们可能会无意识地传递出焦虑和孤立感。要怀疑那些最后才透露角色的玩家，他们可能是爪牙。");
    g_tipLine[13826] = StringToText("· 你很可能被视为邪恶阵营在夜晚击杀的首要目标。要非常小心地与其他人分享你的角色。");
    g_tipLine[13827] = StringToText("· 每天和一名新玩家分享你的角色。如果你在游戏早期就死亡，很可能你沟通过的某名玩家实际上是恶魔而不是爪牙，");
    g_tipLine[13828] = StringToText("  因为爪牙没有简单的方法去传达给恶魔你的角色。当然，并不能阻止爪牙公开揭露你的角色，");
    g_tipLine[13829] = StringToText("  但是至少你能带走一个确定的爪牙。");
    g_tipLine[13830] = StringToText("· 作为罂粟种植者，你可以假装是一个邪恶玩家来蒙骗邪恶玩家相信你是。秘密地和不同玩家沟通，");
    g_tipLine[13831] = StringToText("  让他们知道你知道罂粟种植者在场因为你是「邪恶玩家」。他们可能会上钩并向你透露信息。");
    g_tipLine[13832] = StringToText("· 如果你死亡，观察那些突然发生的行为变化。邪恶阵营骤然获得大量信息并可以互相联系。这些变化包括：");
    g_tipLine[13833] = StringToText("  · 那些之前不投票的玩家开始投票。");
    g_tipLine[13834] = StringToText("  · 那些强烈支持投票给某名玩家的玩家突然转变了目标。");
    g_tipLine[13835] = StringToText("  · 在你死亡后不久即表明角色的玩家（他们很可能刚刚从恶魔处得到了伪装）。");
    g_tipLine[13836] = StringToText("· 如果你死后不现身，邪恶阵营能切实知道你是谁而善良阵营并不知道。这意味着那些对你过于关注的玩家可能是邪恶阵营的因为");
    g_tipLine[13837] = StringToText("  他们试图对你隐藏自己的变化。");
    g_tipLine[13838] = StringToText("· 如果你能安排自己在中毒或醉酒时死亡，邪恶阵营就无法互相得知。虽然这可能会非常有难度，");
    g_tipLine[13839] = StringToText("  因为并没有太多善良角色能故意让你醉酒，但它会带来巨大回报。");
    g_tipLine[13840] = StringToText("· 如果存活到最后一天，请现身。");
    g_tipRoleAt[86] = 13765; g_tipRoleN[86] = 76; g_tipP1At[86] = 13768; g_tipP1N[86] = 9; g_tipP2At[86] = 13796; g_tipP2N[86] = 21;
    g_tipAbility[86] = StringToText("爪牙和恶魔互相不认识。如果你死亡，当晚他们会互相认识。");
    g_tipLine[13841] = StringToText("【背景故事】");
    g_tipLine[13842] = StringToText("「沉默是金。」（阿拉伯语）");
    g_tipLine[13843] = StringToText("【角色能力】");
    g_tipLine[13844] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，");
    g_tipLine[13845] = StringToText("  然后如果他们都存活则都死亡。");
    g_tipLine[13846] = StringToText("【角色简介】");
    g_tipLine[13847] = StringToText("哈迪寂亚会让三名玩家一同陷入囚徒困境——究竟谁会选择死亡，来让其他人得以存活？");
    g_tipLine[13848] = StringToText("· 哈迪寂亚可以在除首个夜晚以外的每个夜晚选择三名玩家。所有玩家都会得知哈迪寂亚选择了哪些玩家。");
    g_tipLine[13849] = StringToText("  在前一名被选择的玩家秘密做出自己的选择之后，才会公布下一名被选择的玩家。");
    g_tipLine[13850] = StringToText("· 在夜晚哈迪寂亚的能力生效期间，所有玩家必须保持沉默。从说书人首次宣布一名玩家被选择开始，");
    g_tipLine[13851] = StringToText("  直至说书人宣布哈迪寂亚的能力结算完毕。");
    g_tipLine[13852] = StringToText("· 如果哈迪寂亚没有进行选择，说书人不会发出声明，当晚不会有玩家因哈迪寂亚的能力死亡。");
    g_tipLine[13853] = StringToText("· 在能力结算期间，说书人会大声询问被选择的玩家如何决定自己的生死。如果该玩家点头，那么他存活。如果他摇头，");
    g_tipLine[13854] = StringToText("  那么他死亡。通过这个方式，可以让已经死亡的玩家复活。");
    g_tipLine[13855] = StringToText("· 如果在结算完毕这些玩家的选择之后他们都存活，那么他们会死亡。选择了死亡，");
    g_tipLine[13856] = StringToText("  但因为某些效果使得仍然存活的玩家也会因此再次死亡。");
    g_tipLine[13857] = StringToText("· 哈迪寂亚可以不进行选择，当这种情况发生时，说书人不会宣布哈迪寂亚在场并选择玩家的播报，夜晚继续进行，");
    g_tipLine[13858] = StringToText("  没有任何迹象表明恶魔还活着。");
    g_tipLine[13859] = StringToText("【范例】");
    g_tipLine[13860] = StringToText("哈迪寂亚选择了小文，小兰，和小美。小文选择死亡。小兰选择死亡。小美选择存活。在黎明时，人们发现小文和小兰死了，");
    g_tipLine[13861] = StringToText("  但小美活着。");
    g_tipLine[13862] = StringToText("哈迪寂亚选择了小艾，小莱和死亡的道哥。小艾选择存活。小莱选择存活。道哥选择存活，所以他被复活了。");
    g_tipLine[13863] = StringToText("  然后因为所有被选择的玩家都存活，因此他们都死亡。");
    g_tipLine[13864] = StringToText("哈迪寂亚没有做出选择，说书人不会宣布哈迪寂亚在场并选择玩家的播报。夜晚继续进行。");
    g_tipLine[13865] = StringToText("【运作方式】");
    g_tipLine[13866] = StringToText("除首个夜晚外的每个夜晚，唤醒哈迪寂亚。他可以选择三名玩家。如果他这么做了，用「1」，「2」，「3」");
    g_tipLine[13867] = StringToText("  的提示标记标记他们，与哈迪寂亚选择的顺序相同。让哈迪寂亚入睡。唤醒标记着「1」的玩家并且说「哈迪寂亚选择了」");
    g_tipLine[13868] = StringToText("  和那名玩家的名字，随后询问「你选择活着吗？」他可以点头或摇头。让他入睡。如果他选择了存活，");
    g_tipLine[13869] = StringToText("  去掉他的帷幕标记（如果有的话）；如果他选择了死亡，为他添加帷幕标记。为标记着「2」和「3」的玩家重复这个流程。");
    g_tipLine[13870] = StringToText("  如果这三名玩家都存活（也就是没有人挂着帷幕标记），为他们三个都添加帷幕标记。他们死亡。宣布保持安静的时间结束了。");
    g_tipLine[13871] = StringToText("每个黎明，宣布标记着「1」，「2」，「3」的玩家哪些存活和哪些死亡。即使一名玩家的生死状态没有在夜晚改变，");
    g_tipLine[13872] = StringToText("  你也要这么做。");
    g_tipLine[13873] = StringToText("如有必要，你可以让所有玩家在哈迪寂亚的能力生效期间保持安静。这也包含了通过语言之外的方式发出的声音。");
    g_tipLine[13874] = StringToText("  这样可以阻止玩家向他人传递自己选择了存活与否的信号。");
    g_tipLine[13875] = StringToText("【提示标记】");
    g_tipLine[13876] = StringToText("· 1&2&3");
    g_tipLine[13877] = StringToText("放置时机：在哈迪寂亚夜晚行动并选择了玩家后。");
    g_tipLine[13878] = StringToText("放置条件：在哈迪寂亚选择的玩家的角色标记旁，根据哈迪寂亚选择的先后顺序进行放置。如果哈迪寂亚醉酒中毒，");
    g_tipLine[13879] = StringToText("  不放置这些标记。");
    g_tipLine[13880] = StringToText("移除时机：结算完哈迪寂亚的角色能力后移除。");
    g_tipLine[13881] = StringToText("· 选择生&选择死（仅线上魔典使用，因为帷幕标记的放置会立马被玩家看到）");
    g_tipLine[13882] = StringToText("放置时机：在说书人结算哈迪寂亚的夜晚行动时，根据对应玩家的选择放置。");
    g_tipLine[13883] = StringToText("放置条件：选择死且能被哈迪寂亚杀死的玩家，其角色标记旁会放置「选择死」标记，选择生且能被哈迪寂亚复活的玩家，");
    g_tipLine[13884] = StringToText("  其角色标记旁会放置「选择生」标记。随后，如果这些玩家现在都处于存活状态，那么这些玩家中能被哈迪寂亚杀死的玩家，");
    g_tipLine[13885] = StringToText("  其角色标记旁会放置「选择死」标记，用以提醒说书人在黎明时分宣布当晚的死亡或复活玩家。");
    g_tipLine[13886] = StringToText("移除时机：在黎明时宣布死亡和复活玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[13887] = StringToText("【规则细节】");
    g_tipLine[13888] = StringToText("· 已死亡的玩家如果选择「活着」，会被复活。");
    g_tipLine[13889] = StringToText("· 「如果他们都存活」判断条件不会关注这些玩家是如何做出选择的，而只看在这些选择结算后玩家是否存活。选择「死去」");
    g_tipLine[13890] = StringToText("  的存活玩家如果受到免死能力的保护，会因此存活并计入「如果他们都存活」的判断条件。");
    g_tipLine[13891] = StringToText("· 如果哈迪寂亚醉酒或中毒，他在使用自己的能力时不会产生任何效果：玩家们不会被告知哈迪寂亚的效果生效，");
    g_tipLine[13892] = StringToText("  哈迪寂亚的选择不会被宣布，被他选择的玩家不会被唤醒，不会有玩家因此被杀死或被复活，等等。");
    g_tipLine[13893] = StringToText("· 当哈迪寂亚死亡时，他如常失去自己的能力。此前被他杀死或复活的玩家依然保持当前的生死状态。");
    g_tipLine[13894] = StringToText("  哈迪寂亚的能力不会再继续产生效果。在黎明时，如常宣布玩家生死状态的改变情况。");
    g_tipLine[13895] = StringToText("· 相克规则：");
    g_tipLine[13896] = StringToText("  · 红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[13897] = StringToText("  · 主谋：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：如果他们都选择存活，邪恶阵营获胜。否则，");
    g_tipLine[13898] = StringToText("    善良阵营获胜。");
    g_tipLine[13899] = StringToText("  · 公主：如果公主在首个白天提名并处决了一名玩家，没有人会因为哈迪寂亚而死亡。(公主与哈迪寂亚角色互动结果本应如此，");
    g_tipLine[13900] = StringToText("    此条仅做说明)");
    g_tipLine[13901] = StringToText("【提示与技巧】");
    g_tipLine[13902] = StringToText("· 第二晚开始，所有人都知道哈迪寂亚在场。就没有必要去聊「哪个恶魔在场」这个事了。");
    g_tipLine[13903] = StringToText("· 为了最大化每夜的死亡数量，去选3名善良玩家。善良玩家通常选择存活，这意味着3人都会死亡。这有可能提示善良阵营：");
    g_tipLine[13904] = StringToText("  死亡的玩家都属于善良阵营，但是这是值得的。当其他的邪恶玩家都存活时这个策略特别有用，");
    g_tipLine[13905] = StringToText("  因为邪恶阵营会在接下来的游戏中拥有重要的投票优势。");
    g_tipLine[13906] = StringToText("· 时不时选择一个邪恶玩家，让他看起来更像善良角色，或者保证每晚至少有一人死亡。新手哈迪寂亚总是选择善良玩家，");
    g_tipLine[13907] = StringToText("  所以选择一些邪恶的玩家会很有帮助，尤其是在早期。最好的结果是你选择的两名善良玩家死亡，");
    g_tipLine[13908] = StringToText("  而你选择的唯一邪恶玩家存活。但让3人一起死亡也是非常有用的，因为为这样可以更快让游戏结束。");
    g_tipLine[13909] = StringToText("  尽量避免两名善良玩家活着，而唯一邪恶玩家死去的情况。你选的邪恶玩家应该掌握其他玩家将要选择什么的提示。");
    g_tipLine[13910] = StringToText("· 在某个阶段选择自己，尤其是当所有其他玩家之前已经被选择过时。如果成为唯一没被选择过的玩家会让你显得非常可疑。");
    g_tipLine[13911] = StringToText("  为了避免这种情况，选择一个晚上——只需确定你选择了另外两个很可能选择死亡的玩家，因为你需要选择活着。");
    g_tipLine[13912] = StringToText("  与爪牙提前沟通好，让他们在你选择存活的时候选择死亡，保证你不会意外自杀，因为第三个玩家选择什么并不重要。");
    g_tipLine[13913] = StringToText("· 掌握哪些角色在场的信息，越多越好。有些角色，比如守鸦人、贤者或农夫，会想在晚上死去。有些角色，比如卖花女孩、");
    g_tipLine[13914] = StringToText("  气球驾驶员或罂粟种植者，会想要活下去。一些角色，比如厨师、渔夫或猎手，可能不确定想死还是想活，");
    g_tipLine[13915] = StringToText("  这取决于他们的能力之前或者之后是否足够有用。如果你知道玩家对应的角色，你可以选择三名想要活下去的玩家，");
    g_tipLine[13916] = StringToText("  或者三名不想活下去的玩家。两者往往都很有帮助。");
    g_tipLine[13917] = StringToText("· 偶尔选择死亡的爪牙。你可以复活爪牙，这可能至关重要，尤其是如果他们能够再次使用能力，如刺客或投毒者。");
    g_tipLine[13918] = StringToText("  活着的爪牙也可以更频繁地投票——非常好用。注意选择那些会直接暴露能力的爪牙，比如麻脸巫婆或洗脑师。");
    g_tipLine[13919] = StringToText("  如果这些能力的公开特点过于明显，以至于让善良玩家得知哪些人是爪牙，这就得不偿失了。");
    g_tipLine[13920] = StringToText("· 偶尔选择死去的善良玩家。尽管让这些善良玩家恢复能力肯定没什么帮助，但他们会被当成爪牙，这会混淆善良阵营的视线。");
    g_tipLine[13921] = StringToText("  同样，你几乎可以确定死亡玩家会选择存活，利用这一点来决定选择其他目标玩家。类似的，");
    g_tipLine[13922] = StringToText("  每一个你能够预知的生死抉择都意味着你可以更明智地选择目标。");
    g_tipLine[13923] = StringToText("· 出于不确定性或者恐惧，某些玩家总是选择会选择存活。有机会的话，同时选择三个这类玩家作为目标。");
    g_tipLine[13924] = StringToText("· 和你的爪牙交流，他们可能为你提供一些晚上应该选谁或者不选谁的信息。你和爪牙交流的重要性远超一般恶魔，");
    g_tipLine[13925] = StringToText("  因为你不仅要选择你想杀死的角色，而且要选择角色的组合。你的爪牙可能会提供一些关于他们是什么角色、");
    g_tipLine[13926] = StringToText("  是否可以死于晚上以及他们之后会咋样的信息。");
    g_tipLine[13927] = StringToText("· 如果要在晚上选中一名邪恶玩家，甚至是你自己，请计划一下第二天说什么。事先考虑过的话，更容易为选择存活（或死亡，");
    g_tipLine[13928] = StringToText("  视情况而定）找到有效的理由。避免在没有预先告知的情况下让爪牙选择生或死，这样他们只能匆忙地为自己的选择想出理由。");
    g_tipLine[13929] = StringToText("  如果你的盟友允许你死去（比如红唇女郎），那么提前计划好自己的夜间抉择和理由也是一种很好的做法。");
    g_tipLine[13930] = StringToText("【对抗哈迪寂亚】");
    g_tipLine[13931] = StringToText("· 不要害怕在晚上选择死去。总会有玩家死亡的，问题只是谁死以及几个人会死亡。如果你承担得起死亡的代价，那就选择死去。");
    g_tipLine[13932] = StringToText("  这意味着，通常承担不起死亡的代价的玩家会在夜间存活。");
    g_tipLine[13933] = StringToText("· 如果玩家经历夜间抉择存活下来，可以假定他属于善良阵营，或者至少不是恶魔。在新手局尤其如此。");
    g_tipLine[13934] = StringToText("  通常哈迪寂亚不会在夜间选择自己，所以尽量不要处决这些经历夜间抉择的玩家，确保这一点可能就意味着在结束前处决恶魔。");
    g_tipLine[13935] = StringToText("· 如果玩家在晚上死得蹊跷，询问原因。善良玩家通常会有一个很好的理由来说明他们为何选择存活或者死去。");
    g_tipLine[13936] = StringToText("  一旦理由不具有说服力，你可能就找到了一个邪恶玩家。");
    g_tipLine[13937] = StringToText("· 如果玩家复活，不要处决他们。你可能不知道他们是哪个角色，但他们不是恶魔！");
    g_tipLine[13938] = StringToText("· 集体讨论你计划的夜间抉择的倾向。如果你表明你会选择死去，一旦你被哈迪寂亚选中，");
    g_tipLine[13939] = StringToText("  那意味被选中的其他玩家可以选择存活。如果你表明你会选择存活，这意味着其他两名玩家将需要考虑选择死去，");
    g_tipLine[13940] = StringToText("  以避免所有玩家都选存活（导致三人都死亡）。");
    g_tipLine[13941] = StringToText("· 恶魔很可能会密切关注每个玩家的选择倾向，并据此选择能力的目标。可以在不告诉任何人的情况下在最后一刻改变主意，");
    g_tipLine[13942] = StringToText("  打乱恶魔的计划。");
    g_tipLine[13943] = StringToText("· 特别注意只有 4 或 5 名玩家还活着的夜晚。与大多数每晚只杀死一名玩家的恶魔不同，");
    g_tipLine[13944] = StringToText("  哈迪寂亚每晚可以杀死三名玩家。如果在有 4 或 5 名玩家活着的情况下进入夜间阶段，如果善良玩家选择不当，");
    g_tipLine[13945] = StringToText("  则游戏结束。这一晚非常重要，务必花点时间思考，做出正确的决定。");
    g_tipLine[13946] = StringToText("· 不要违背游戏精神，钻规则的空子打破「沉默」规则（向其他玩家表明你的选择是什么）。在夜晚时，");
    g_tipLine[13947] = StringToText("  安静地结算哈迪寂亚的能力，这样玩家就不会互相交流他们的想法。这使游戏更有趣。不要在技术性问题上违反规则，");
    g_tipLine[13948] = StringToText("  因为说书人会因此调整规则以禁止这种行为。");
    g_tipRoleAt[87] = 13841; g_tipRoleN[87] = 108; g_tipP1At[87] = 13843; g_tipP1N[87] = 16; g_tipP2At[87] = 13887; g_tipP2N[87] = 14;
    g_tipAbility[87] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，然后如果他们都存活则都死亡。");
    g_tipLine[13949] = StringToText("【背景故事】");
    g_tipLine[13950] = StringToText("「请提供你的名字，请出示你的证件，请展示你的武器。」");
    g_tipLine[13951] = StringToText("【角色能力】");
    g_tipLine[13952] = StringToText("在初始设置时，可能会额外增加或减少一个外来者。");
    g_tipLine[13953] = StringToText("【角色简介】");
    g_tipLine[13954] = StringToText("哨兵能够使你剧本中外来者的在场数量保持神秘。");
    g_tipLine[13955] = StringToText("· 官方的角色列表是经过精心设计的，所以外来者的数量永远不会被完全得知，");
    g_tipLine[13956] = StringToText("  这使得邪恶阵营的玩家可以安全地将自己伪装成外来者。许多使用剧本工具创建的角色列表可能不会这么严谨。");
    g_tipLine[13957] = StringToText("  如果由于种种原因，游戏中的外来者数量非常显而易见，说书人可以将哨兵加入游戏。这将使得情况变得复杂，");
    g_tipLine[13958] = StringToText("  并且为邪恶阵营伪装成外来者提供了帮助，或使得在场的外来者看起来更可疑。");
    g_tipLine[13959] = StringToText("· 哨兵在场的游戏中可能会存在比起正常情况下多一个或少一个的外来者，也有可能保持正常的数量，这取决于说书人。");
    g_tipLine[13960] = StringToText("【范例】");
    g_tipLine[13961] = StringToText("这是一场有七名玩家的游戏。角色列表上没有任何角色会添加外来者，而恶魔伪装成了圣徒。因为有哨兵在场，");
    g_tipLine[13962] = StringToText("  善良的玩家就无法确定这名圣徒是不是真的了。");
    g_tipLine[13963] = StringToText("这是一场有九名玩家的游戏。因为女巫刚刚杀了一名玩家，所以即使男爵在角色列表上，善良的玩家也能知道男爵此时不在场，");
    g_tipLine[13964] = StringToText("  所以游戏中应该只有两名外来者。但是不能完全相信这些外来者，因为哨兵在场。实际上，");
    g_tipLine[13965] = StringToText("  这局游戏比起常规的游戏少了一名外来者，而女巫将自己伪装成了管家。");
    g_tipLine[13966] = StringToText("【运作方式】");
    g_tipLine[13967] = StringToText("在游戏开始时，宣布哨兵加入游戏，并将哨兵标记放入魔典中。");
    g_tipLine[13968] = StringToText("设置游戏时，在把角色标记放进盲抽袋之前，添加一个外来者并移除一个镇民，或者移除一个外来者然后添加一个镇民，");
    g_tipLine[13969] = StringToText("  或者不改变外来者数量。");
    g_tipLine[13970] = StringToText("【提示标记】");
    g_tipLine[13971] = StringToText("无");
    g_tipRoleAt[88] = 13949; g_tipRoleN[88] = 23; g_tipP1At[88] = 13951; g_tipP1N[88] = 9; g_tipP2At[88] = 0; g_tipP2N[88] = 0;
    g_tipAbility[88] = StringToText("在初始设置时，可能会额外增加或减少一个外来者。");
    g_tipLine[13972] = StringToText("【背景故事】");
    g_tipLine[13973] = StringToText("「荒芜之地传来呼唤，生肉枯骨，落入尘土。是圣洁之魂在生长，是圣洁之魂在注视，是圣洁之魂在引导。人类遵循这一切，");
    g_tipLine[13974] = StringToText("  否则早已被覆灭。」");
    g_tipLine[13975] = StringToText("【角色能力】");
    g_tipLine[13976] = StringToText("游戏过程中邪恶玩家的总数最多能比初始设置多一名。");
    g_tipLine[13977] = StringToText("【角色简介】");
    g_tipLine[13978] = StringToText("圣洁之魂可以维持邪恶玩家的数量公平和平衡。");
    g_tipLine[13979] = StringToText("· 当通过剧本工具创造角色列表时，最好不要包含超过一个会添加邪恶玩家数量的角色。如果有两名或多名玩家变成邪恶阵营，");
    g_tipLine[13980] = StringToText("  邪恶阵营可能会轻易获胜。因为他们只要揭露自己的角色，就可以凭借人数优势用投票来取得胜利。");
    g_tipLine[13981] = StringToText("  通过加入圣洁之魂可以阻止过多的玩家转变为邪恶阵营，以此创造一个对善良阵营更有趣、更公平的游戏。");
    g_tipLine[13982] = StringToText("· 当圣洁之魂在场时，标准阵营人数之外最多只会有一名玩家转变为邪恶阵营。如果第二名玩家将要转变为邪恶阵营，");
    g_tipLine[13983] = StringToText("  该玩家会保持为善良阵营。");
    g_tipLine[13984] = StringToText("· 标准的邪恶玩家数量印在了旅行者列表和初始设置表上。");
    g_tipLine[13985] = StringToText("【范例】");
    g_tipLine[13986] = StringToText("方古攻击了一名外来者，因此产生了一名邪恶玩家。后来，魔鬼代言人在夜里选择了莽夫。正常情况下，");
    g_tipLine[13987] = StringToText("  莽夫会转变为邪恶阵营，但此时莽夫依旧保持为善良阵营，因为已经有多出来的一名邪恶角色在场。");
    g_tipLine[13988] = StringToText("莽夫是邪恶阵营的。舞蛇人选择了恶魔。邪恶的恶魔现在变成了善良的舞蛇人，善良的舞蛇人现在变成了邪恶的恶魔。");
    g_tipLine[13989] = StringToText("  由于此时邪恶的玩家数量没有增多，圣洁之魂的能力不会因此被触发。");
    g_tipLine[13990] = StringToText("【运作方式】");
    g_tipLine[13991] = StringToText("在游戏开始时，宣布圣洁之魂加入游戏。将圣洁之魂角色标记及其对应提示标记放入魔典中。");
    g_tipLine[13992] = StringToText("在任何时候，如果游戏中有一名额外的邪恶角色出现了，用「禁止邪恶」提示标记圣洁之魂。（如果任何角色转变成善良阵营，");
    g_tipLine[13993] = StringToText("  移除该提示标记。）");
    g_tipLine[13994] = StringToText("如果一名玩家将要转变为邪恶阵营，而圣洁之魂被标记了「禁止邪恶」时，这名玩家将保持为善良阵营。");
    g_tipLine[13995] = StringToText("【提示标记】");
    g_tipLine[13996] = StringToText("· 禁止邪恶");
    g_tipLine[13997] = StringToText("放置时机：当场上的邪恶玩家数量比默认的初始设置邪恶角色数量正好多一名时。");
    g_tipLine[13998] = StringToText("放置条件：放置在圣洁之魂角色标记旁。");
    g_tipLine[13999] = StringToText("移除时机：当「禁止邪恶」提示标记放置后，有邪恶玩家转为善良阵营时。");
    g_tipRoleAt[89] = 13972; g_tipRoleN[89] = 28; g_tipP1At[89] = 13975; g_tipP1N[89] = 10; g_tipP2At[89] = 0; g_tipP2N[89] = 0;
    g_tipAbility[89] = StringToText("游戏过程中邪恶玩家的总数最多能比初始设置多一名。");
    g_tipLine[14000] = StringToText("【背景故事】");
    g_tipLine[14001] = StringToText("「我一个人在这铺满腐败恶臭的街道上行走着。邪恶不请自来，在我的鼻腔里蠕动，将厌恶点燃，将期待烧光。");
    g_tipLine[14002] = StringToText("  这个令人不悦的地方一天比一天更加病态。而我……我会是这些罪恶的解药。」");
    g_tipLine[14003] = StringToText("【角色能力】");
    g_tipLine[14004] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。");
    g_tipLine[14005] = StringToText("每当你得知的玩家死亡，你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipLine[14006] = StringToText("【角色简介】");
    g_tipLine[14007] = StringToText("赏金猎人会一个个地追踪邪恶玩家。");
    g_tipLine[14008] = StringToText("· 在赏金猎人的首个夜晚，他会得知一名邪恶玩家。当赏金猎人得知的那名玩家死亡后，他会再得知另一名邪恶玩家。");
    g_tipLine[14009] = StringToText("· 赏金猎人只会得知一名邪恶玩家，而不会得知他的具体角色。");
    g_tipLine[14010] = StringToText("· 如果赏金猎人在应当得知新玩家的时候醉酒或中毒了，说书人可以让赏金猎人得知一名善良玩家。当这名玩家死亡后，");
    g_tipLine[14011] = StringToText("  赏金猎人会在当晚得知一名新玩家。");
    g_tipLine[14012] = StringToText("· 赏金猎人不会重复得知同一个邪恶玩家两次。");
    g_tipLine[14013] = StringToText("· 如果赏金猎人初始就加入了本局游戏，在设置调整阶段，会有一名镇民加入邪恶阵营。赏金猎人可以得知这名邪恶的镇民玩家。");
    g_tipLine[14014] = StringToText("【范例】");
    g_tipLine[14015] = StringToText("小艾是赏金猎人，大本是鹰身女妖，小黑是茶艺师。设置调整阶段，说书人决定小黑成为邪恶的茶艺师。首个夜晚，");
    g_tipLine[14016] = StringToText("  小艾得知了大本。第三个白天，大本死于处决。当晚，小艾得知了小黑。");
    g_tipLine[14017] = StringToText("首个夜晚，赏金猎人得知了邪恶的男爵小朱。某晚小朱死亡时，赏金猎人因投毒者的能力中毒，");
    g_tipLine[14018] = StringToText("  当晚赏金猎人得知了善良的魔术师小艾。");
    g_tipLine[14019] = StringToText("小兰是以为自己是赏金猎人的酒鬼。由于赏金猎人不在场，没有镇民被转变为邪恶阵营。首个夜晚，");
    g_tipLine[14020] = StringToText("  小兰得知了善良的共情者小明。随后小明死亡，小兰得知了善良的卖花女孩道哥。");
    g_tipLine[14021] = StringToText("【运作方式】");
    g_tipLine[14022] = StringToText("在设置调整阶段，将一名镇民的角色标记倒转放置，表示该玩家是邪恶阵营。将「得知」");
    g_tipLine[14023] = StringToText("  提示标记放置在一名邪恶玩家的角色标记旁。");
    g_tipLine[14024] = StringToText("在首个夜晚，唤醒赏金猎人。指向放置「得知」提示标记的玩家，然后让赏金猎人重新入睡。");
    g_tipLine[14025] = StringToText("每当放置「得知」提示标记的玩家死亡时，将「得知」提示标记放置在一名新的邪恶玩家的角色标记旁。当晚，唤醒赏金猎人，");
    g_tipLine[14026] = StringToText("  指向放置「得知」提示标记的玩家，然后让赏金猎人重新入睡。");
    g_tipLine[14027] = StringToText("【提示标记】");
    g_tipLine[14028] = StringToText("· 得知");
    g_tipLine[14029] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[14030] = StringToText("放置条件：放置在一名邪恶玩家的角色标记旁。");
    g_tipLine[14031] = StringToText("移动时机：当放置提示标记的玩家死亡时，将该标记放置在一名新的邪恶玩家的角色标记旁。");
    g_tipLine[14032] = StringToText("  如果赏金猎人因其他能力得知错误信息（例如中毒醉酒），需将该标记移动到给赏金猎人展示的玩家角色标记旁。");
    g_tipLine[14033] = StringToText("移除时机：赏金猎人死亡或离场时移除。");
    g_tipLine[14034] = StringToText("【规则细节】");
    g_tipLine[14035] = StringToText("· 请注意，赏金猎人在首个夜晚的行动顺序非常靠后。那是唤醒赏金猎人，向他展示他所得知的邪恶玩家的时机。然而，");
    g_tipLine[14036] = StringToText("  被赏金猎人转变的玩家从一开始就已经属于邪恶阵营，应该在首个夜晚立即告知他是邪恶的，");
    g_tipLine[14037] = StringToText("  并且你作为说书人应当在给出其他夜晚信息之前谨记这回事——那名玩家已经属于邪恶阵营，尽管赏金猎人还未被唤醒。");
    g_tipLine[14038] = StringToText("· 如果赏金猎人醉酒或中毒或处于涡流在场的游戏中，在他能够得到信息的时候，你可以（在涡流在场时必须）");
    g_tipLine[14039] = StringToText("  向他给出错误信息并展示一名善良玩家。如果赏金猎人在之后清醒，他不会因此得知新的信息，");
    g_tipLine[14040] = StringToText("  即使他仍然认为那名善良玩家是邪恶的。当赏金猎人得知的玩家死亡，他在当晚得知一名新的玩家。");
    g_tipLine[14041] = StringToText("· 如果「被得知」的邪恶玩家在之后转变为善良，这不会影响赏金猎人，赏金猎人为了获得进一步信息仍然需要那名玩家死亡。");
    g_tipLine[14042] = StringToText("· 值得注意的是，如果你觉得赏金猎人已经获得过很多信息了，可以向他指出一名死亡的邪恶玩家。死亡玩家不能再次死亡，");
    g_tipLine[14043] = StringToText("  所以赏金猎人不会获得新的信息，除非那名玩家被复活并再次被杀死。");
    g_tipLine[14044] = StringToText("· 对于旅行者，离开游戏和被流放都会导致他死亡——所以如果赏金猎人此前得知了一名旅行者，");
    g_tipLine[14045] = StringToText("  上述两种情况都会使得赏金猎人在当晚获得新的信息。");
    g_tipLine[14046] = StringToText("· 相克规则：");
    g_tipLine[14047] = StringToText("  · 哲学家：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_tipLine[14048] = StringToText("  · 卡扎力：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_tipLine[14049] = StringToText("【提示与技巧】");
    g_tipLine[14050] = StringToText("· 这确实很简单是吧？你知道谁是邪恶玩家，而且是从第一天开始！连调查员的信息都没这么强！你应该立即告诉大家你的角色，");
    g_tipLine[14051] = StringToText("  尽快处决那名卑鄙的邪恶玩家就可以获得更多关于残忍恶魔的信息，最终找到隐藏在你们之间的那个恶魔。");
    g_tipLine[14052] = StringToText("· 你知道谁是邪恶玩家，但是他们不知道你知道。在暗处耐心等待，观察邪恶玩家在和谁交流，");
    g_tipLine[14053] = StringToText("  关注他们是否一开始没有伪装却在一次谈话后开始如此做，抑或是显得非常迷茫无助，不知道该和谁说话。");
    g_tipLine[14054] = StringToText("  前一种情况可以向你暴露其他的邪恶玩家，后一种情况可能是被你能力变为邪恶的可怜镇民。无论是哪种情况，");
    g_tipLine[14055] = StringToText("  都可以帮助你更了解谁可能是邪恶的。如果你让他们被处决，并且得知了一名他们曾与之交流的玩家，");
    g_tipLine[14056] = StringToText("  那就是证明你正确的更多证据！");
    g_tipLine[14057] = StringToText("· 一旦你公开赏金猎人角色，你就会是恶魔在夜晚袭击的首要目标，所以你要斟酌时机小心地公开你的信息。");
    g_tipLine[14058] = StringToText("  过早现身可能会导致你在获得全部潜在信息前被杀；过晚现身你可能无法说服足够多玩家处决你的目标来获得更多信息。");
    g_tipLine[14059] = StringToText("  如果你打算通过处决整个邪恶阵营来寻找到恶魔是谁，你获得的信息多寡实质上便左右了游戏。");
    g_tipLine[14060] = StringToText("  但这需要你同时推进大量处决和保持自己存活，因此大家对于你的了解必须恰到好处。");
    g_tipLine[14061] = StringToText("· 要牢记你在游戏中创造了一个邪恶镇民！这不仅意味着邪恶阵营将会额外多出一票和每天一次的提名机会，");
    g_tipLine[14062] = StringToText("  更是意味着如果他们需要的话，有一个白送的角色可以用来伪装。更糟糕的是，这些镇民有充分的理由在自己的信息上撒谎，");
    g_tipLine[14063] = StringToText("  这是一个你必须警惕的误导信息来源。最后要注意的是，当游戏进入最后三人的决战回合时，");
    g_tipLine[14064] = StringToText("  一名额外的邪恶玩家意味着你需要额外的善良阵营票来让邪恶阵营不能仅靠邪恶阵营的票数就击败你们。");
    g_tipLine[14065] = StringToText("· 也许你可以去主动接触那些你在夜晚锁定的邪恶玩家，并试着说服他们你也是邪恶阵营！");
    g_tipLine[14066] = StringToText("  如果那名玩家是因为你的能力所创造的邪恶镇民，他们并不知道其他的邪恶玩家，如果你扮演邪恶玩家，他们可能会信任你。");
    g_tipLine[14067] = StringToText("  但是，如果那名玩家是爪牙，你可能会引起他们对被赏金猎人发现的警觉，他们可以会告知恶魔杀了你，");
    g_tipLine[14068] = StringToText("  所以谨慎使用这个策略！");
    g_tipLine[14069] = StringToText("· 即使你打算保持隐蔽，仍然要努力在白天处决你的目标。你也许想要让一名其他玩家代你宣告信息，");
    g_tipLine[14070] = StringToText("  或是私下宣告信息来拉人入伙以处决你的目标——你可能需要得到大部分玩家的投票，");
    g_tipLine[14071] = StringToText("  尤其是当你看到的是邪恶阵营不希望被投票的爪牙。");
    g_tipLine[14072] = StringToText("· 非常不幸的是，你的信息在中毒时非常不可靠——在你中毒的情况下，你几乎总是会得知一名善良玩家而不是邪恶玩家，");
    g_tipLine[14073] = StringToText("  你可能并不希望那名玩家被处决。如果你认为你已经被邪恶阵营发现并且持续对你下毒，因为目标玩家绝对值得你信任，");
    g_tipLine[14074] = StringToText("  那也许只能接受现状：你将无法再获得良好信息并且失去人们的信任而死亡。");
    g_tipLine[14075] = StringToText("  或者你可以试图与那位玩家讨论是否愿意牺牲自己来换取下一夜可能准确的信息，");
    g_tipLine[14076] = StringToText("  又或者你可以想办法将目光转移到寻找那些隐藏在暗处，扰乱你视线的投毒者和寡妇，");
    g_tipLine[14077] = StringToText("  并祈祷恶魔可能会晚上杀死你当前的目标来为你提供一些新信息。");
    g_tipLine[14078] = StringToText("· 注意剧本上的邪恶角色——你不会希望带领团队奋斗并处决了目标玩家，却发现他们是炸弹人或者哥布林而令邪恶阵营获胜。");
    g_tipRoleAt[90] = 14000; g_tipRoleN[90] = 79; g_tipP1At[90] = 14003; g_tipP1N[90] = 11; g_tipP2At[90] = 14034; g_tipP2N[90] = 15;
    g_tipAbility[90] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。每当你得知的玩家死亡，你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipLine[14079] = StringToText("【背景故事】");
    g_tipLine[14080] = StringToText("「绕着花园转圈圈，女孩跑得疯癫癫。男孩树上荡秋千，");
    g_tipLine[14081] = StringToText("小精灵在谁心间？淑女微笑小镇边，贵族抡斧树长眠。");
    g_tipLine[14082] = StringToText("容貌相似难分辨，谜底揭晓圣光现：小精灵呀是神仙。」");
    g_tipLine[14083] = StringToText("【角色能力】");
    g_tipLine[14084] = StringToText("在你的首个夜晚，你会得知一个在场的镇民角色。如果你「疯狂」地证明你是该角色，当他死亡时你获得该角色的能力。");
    g_tipLine[14085] = StringToText("【角色简介】");
    g_tipLine[14086] = StringToText("小精灵会假装成与别人相同的角色。");
    g_tipLine[14087] = StringToText("· 在首个夜晚，小精灵会得知一个在场的镇民角色。由说书人来决定他得知的是哪个镇民角色。");
    g_tipLine[14088] = StringToText("  小精灵不会知道哪名玩家是这个角色。");
    g_tipLine[14089] = StringToText("· 如果小精灵假装他是这个镇民，他会在对应的镇民玩家死亡时获得这个镇民角色的能力。");
    g_tipLine[14090] = StringToText("  他可以只在某天里声称自己是这个角色，也可以每天都假装自己是这个角色，");
    g_tipLine[14091] = StringToText("  或者指责那个镇民玩家说他是骗子——由说书人来判断小精灵是否有尝试在「疯狂」地证明自己是这个角色。");
    g_tipLine[14092] = StringToText("· 当那个镇民玩家死亡时，小精灵不会得知这一信息，也不会被告知自己获得了新的能力。");
    g_tipLine[14093] = StringToText("  他可能会由于自己在夜晚被唤醒并获得信息或是被要求选择玩家，从而间接得知自己获得了能力。");
    g_tipLine[14094] = StringToText("· 如果小精灵得知的角色所对应的玩家他的角色发生了变化，并随后死亡，小精灵会获得他得知的那个角色的能力，");
    g_tipLine[14095] = StringToText("  而非那名玩家死亡时的角色的能力。");
    g_tipLine[14096] = StringToText("【范例】");
    g_tipLine[14097] = StringToText("小米是小精灵，得知将军在场。在三天时间里，小米一直声称将军玩家在说谎，因为她才是将军。将军玩家被处决。当晚，");
    g_tipLine[14098] = StringToText("  小米获得了将军的能力，并且从现在起每个夜晚都会开始获得信息。");
    g_tipLine[14099] = StringToText("道哥是酒鬼并以为自己是小精灵。他得知半兽人在场。实际上半兽人不在场，但恐惧之灵伪装成了半兽人。随后恐惧之灵死亡。");
    g_tipLine[14100] = StringToText("  说书人假装道哥获得了半兽人的能力，每个夜晚都唤醒他并让他选择一名存活玩家。这些被选择的玩家不会死亡，");
    g_tipLine[14101] = StringToText("  因为道哥没有获得半兽人的能力。");
    g_tipLine[14102] = StringToText("在第一个白天，小精灵玩家声称自己是士兵。真正的士兵也声称自己是士兵。小精灵玩家对此没有进行争辩。当士兵死亡时，");
    g_tipLine[14103] = StringToText("  小精灵玩家没有获得士兵的能力，因为说书人认为小精灵玩家没有「疯狂」地证明自己是士兵。");
    g_tipLine[14104] = StringToText("【运作方式】");
    g_tipLine[14105] = StringToText("在为首个夜晚做准备时，将小精灵的「疯狂」标记放置在一个镇民角色标记旁。");
    g_tipLine[14106] = StringToText("在首个夜晚，唤醒小精灵。对他展示标记了「疯狂」的镇民角色标记。让小精灵重新入睡。");
    g_tipLine[14107] = StringToText("如果标记了「疯狂」的玩家死亡，并且你认为小精灵玩家曾足够「疯狂」地证明自己是这个角色，那么使用「获得能力」");
    g_tipLine[14108] = StringToText("  标记替换「疯狂」标记。小精灵现在获得了这个镇民的能力，并且会在这个镇民的夜晚行动顺序时机被唤醒以使用能力。");
    g_tipLine[14109] = StringToText("有关小精灵以及疯狂机制的更多设计理念，请参考阅读：疯狂规则如何运作？——疯狂的小精灵");
    g_tipLine[14110] = StringToText("【提示标记】");
    g_tipLine[14111] = StringToText("· 疯狂&获得能力");
    g_tipLine[14112] = StringToText("放置时机：在为首个夜晚做准备时。");
    g_tipLine[14113] = StringToText("放置条件：将「疯狂」提示标记放置在一个在场的镇民角色或能被当作镇民角色的角色标记旁。");
    g_tipLine[14114] = StringToText("替换时机：标记了「疯狂」的玩家死亡时，且说书人判断小精灵曾「疯狂」地证明自己是这个角色，则用「获得能力」");
    g_tipLine[14115] = StringToText("  标记替换「疯狂」标记。");
    g_tipLine[14116] = StringToText("移除时机：疯狂标记会在小精灵死亡或离场时移除。获得能力标记会在小精灵离场时移除。");
    g_tipLine[14117] = StringToText("【规则细节】");
    g_tipLine[14118] = StringToText("· 如果小精灵在得知信息时，因为醉酒中毒等原因导致得知了错误信息时，仍然会正常将他的「疯狂」");
    g_tipLine[14119] = StringToText("  标记放置在一名镇民玩家的角色标记旁。只要小精灵在那名玩家死亡时清醒健康，且说书人判断他足够疯狂，");
    g_tipLine[14120] = StringToText("  便能获得他所得知的那个镇民角色的能力（不一定是标记了「疯狂」的那名玩家的角色能力，");
    g_tipLine[14121] = StringToText("  小精灵可以以此获得一个不在场的镇民角色能力）。");
    g_tipLine[14122] = StringToText("【提示与技巧】");
    g_tipLine[14123] = StringToText("· 尽可能地为你所得知在场的镇民疯狂。宣称你是那个角色。给出那个角色应当给出的信息。宣称使用了你的能力。宣称，");
    g_tipLine[14124] = StringToText("  大声并且反复地宣称，另一名玩家在说谎。有必要的话用任何手段杀死他们。一旦做到这一切，");
    g_tipLine[14125] = StringToText("  你就能获得那个角色的能力——这完全值得！");
    g_tipLine[14126] = StringToText("· 从第一天，第一分钟开始就为这个临摹角色疯狂，并在接下来的每天中都继续演下去。");
    g_tipLine[14127] = StringToText("  这将在说服团队你是这个角色这件事上起重要作用，并且可以让说书人明白你的疯狂。");
    g_tipLine[14128] = StringToText("· 在几天内完全不要对你的临摹角色彻底疯狂。不要提任何关于角色的事。然后，在你认为可以处决这名玩家时，对此角色疯狂。");
    g_tipLine[14129] = StringToText("  如果说书人看到你「已经」疯狂于临摹角色，并且你的疯狂促使临摹角色被处决，");
    g_tipLine[14130] = StringToText("  他们很可能会给予你小精灵的疯狂奖励——当此玩家死亡时获得此玩家的能力。");
    g_tipLine[14131] = StringToText("· 一旦你获得了临摹角色的能力，你就可以安全地作为小精灵公开现身。你现在已经锁定住了这个新能力，");
    g_tipLine[14132] = StringToText("  所以你可以随意地使用它。并让临摹角色（以及团队）知道你一直都是小精灵。");
    g_tipLine[14133] = StringToText("  对那位被你当成替罪羊的倒霉善良玩家进行一些道歉也是很有必要的。;)");
    g_tipLine[14134] = StringToText("· 如果你承认你是小精灵，那将被当作「没有对你的临摹角色疯狂」，并且几乎肯定会导致你无法获得临摹的能力。");
    g_tipLine[14135] = StringToText("  最好别这样说。");
    g_tipLine[14136] = StringToText("· 如果你可以与被临摹的玩家进行一次私聊，并告诉他们你是小精灵，那么他们可能会同意处决自己。");
    g_tipLine[14137] = StringToText("  但是要注意……如果说书人无意中听到你宣称是小精灵，那么你不再「疯狂」并不会获得角色能力。类似地，");
    g_tipLine[14138] = StringToText("  如果你告知的玩家是邪恶的，然后转而告诉说书人你说了什么，那么你不再「疯狂」并不会获得角色能力。");
    g_tipLine[14139] = StringToText("· 疯狂时要先发制人。说书人希望看到你做出真诚的努力来说服团队你是一个你并不是的角色。");
    g_tipLine[14140] = StringToText("· 在第一天基于你将扮演的角色调整你的小精灵策略。如果你被展示了调查员那么就尽快杀死他们，");
    g_tipLine[14141] = StringToText("  这样你们两个就都能尽早获得你们的信息。如果你被展示了送葬者，那么就等到他得知了至少一名被处决玩家的角色后（再尝试");
    g_tipLine[14142] = StringToText("  杀了他），这样你们两个就都能证实信息并互相信任。如果你被展示了贤者，那就先伪装成不同的角色，然后再转为贤者，");
    g_tipLine[14143] = StringToText("  让你的贤者伪装看起来变得可信。小精灵的策略数量和可用的角色一样多。");
    g_tipLine[14144] = StringToText("· 你知道一个角色在场，但并不知道哪名玩家是。当他们死后，你有能力确定他们是他们宣称的角色。如果一名玩家死亡，");
    g_tipLine[14145] = StringToText("  而你没有获得临摹的能力，那么死亡的人并不是你知道的角色。真正的你知道的在场角色仍然存活。");
    g_tipLine[14146] = StringToText("· 别忘记限次能力角色与进场能力角色，比如女裁缝或图书管理员可能已经使用了他们的能力。");
    g_tipLine[14147] = StringToText("  通过处决他们（假设你已经成功地对他们的角色「疯狂」），你不仅能确认他们是他们所宣称的角色，");
    g_tipLine[14148] = StringToText("  还能再次使用他们的能力，获得新的信息。");
    g_tipLine[14149] = StringToText("· 你可以测试小精灵看看他们是否在说真话。如果你是小精灵宣称的角色，但你还没有透露你是谁，保持沉默并尽力让自己被杀。");
    g_tipLine[14150] = StringToText("  当你死后，小精灵将获得新的能力，因此小精灵应当会大声说出这件事。如果你死亡，");
    g_tipLine[14151] = StringToText("  但那名宣称是小精灵的玩家并没有宣称获得了新能力，那他们很可能不是小精灵因为他们不知道你已经死亡。");
    g_tipLine[14152] = StringToText("· 当小精灵在剧本中时，不要太过怀疑宣称同一角色的两名玩家。只要他们把角色玩得好，就很可能是两名善良玩家。");
    g_tipLine[14153] = StringToText("  当然邪恶玩家知道这一点，并可能会以伪装来对峙。无论这两名玩家都是善良的（并且其中之一是小精灵）");
    g_tipLine[14154] = StringToText("  还是其中有一名邪恶玩家在对峙，可能最好还是处决其中一名玩家。希望你们能处决掉邪恶玩家或是那个能给予小精灵额外能力");
    g_tipLine[14155] = StringToText("  的善良玩家。");
    g_tipLine[14156] = StringToText("· 在游戏早期就说你是小精灵，故意排除你获得能力的可能性，也仍然能帮上忙。");
    g_tipLine[14157] = StringToText("  你在游戏开始时就知道一个特定的善良角色在场。这是有用的信息。告诉团队你知道的能帮助确认那名玩家是善良的。");
    g_tipLine[14158] = StringToText("  团队会知道你是小精灵，因此在这局游戏中没必要再去疯狂。");
    g_tipRoleAt[91] = 14079; g_tipRoleN[91] = 80; g_tipP1At[91] = 14083; g_tipP1N[91] = 13; g_tipP2At[91] = 14117; g_tipP2N[91] = 5;
    g_tipAbility[91] = StringToText("在你的首个夜晚，你会得知一个在场的镇民角色。如果你「疯狂」地证明你是该角色，当他死亡时你获得该角色的能力。");
    g_tipLine[14159] = StringToText("【背景故事】");
    g_tipLine[14160] = StringToText("「是他干的。」");
    g_tipLine[14161] = StringToText("【角色能力】");
    g_tipLine[14162] = StringToText("爪牙会在其首个夜晚得知三个伪装。");
    g_tipLine[14163] = StringToText("【角色简介】");
    g_tipLine[14164] = StringToText("告密者能够使邪恶阵营获得额外的信息。");
    g_tipLine[14165] = StringToText("· 告密者使得爪牙能够在游戏的首个夜晚得知三个不在场的角色，如同恶魔一样。");
    g_tipLine[14166] = StringToText("· 爪牙得知的三个不在场角色可能与恶魔得知的相同，也可能不同。");
    g_tipLine[14167] = StringToText("· 多名爪牙可能会得知不同的角色，也可能得知相同的角色。");
    g_tipLine[14168] = StringToText("【范例】");
    g_tipLine[14169] = StringToText("告密者在场。在首个夜晚，恶魔和爪牙均得知共情者、旅店老板、魔像不在场。");
    g_tipLine[14170] = StringToText("告密者在场。在首个夜晚，恶魔得知弄臣、僧侣、圣徒不在场。主谋得知弄臣、僧侣、圣徒不在场。女巫得知弄臣、卖花女孩、");
    g_tipLine[14171] = StringToText("  理发师不在场。恐惧之灵得知贵族、失忆者、异端分子不在场。");
    g_tipLine[14172] = StringToText("在游戏的第四个夜晚，麻脸巫婆创造了告密者。所有爪牙因此得知了三个不在场的角色。");
    g_tipLine[14173] = StringToText("【运作方式】");
    g_tipLine[14174] = StringToText("在首个夜晚，唤醒一名爪牙。对他展示「这些角色不在场」信息标记，然后对他展示三个不在场的善良角色标记。");
    g_tipLine[14175] = StringToText("  让这名爪牙重新入睡。重复此流程，直到所有爪牙都得知了三个不在场角色。");
    g_tipLine[14176] = StringToText("【提示标记】");
    g_tipLine[14177] = StringToText("无");
    g_tipLine[14178] = StringToText("【规则细节】");
    g_tipLine[14179] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14180] = StringToText("  · 戏子（改）：告密者不会因为戏子（改）的能力醉酒。");
    g_tipLine[14181] = StringToText("【提示与技巧】");
    g_tipLine[14182] = StringToText("· 当告密者在场，所有邪恶玩家都能得知三个角色作为安全伪装。这意味着不太可能有多个玩家宣称自己是同一角色。");
    g_tipLine[14183] = StringToText("  如果有玩家们宣称自己是同一角色，他们可能是善良角色。关注剧本中有哪些善良角色有动机对他们是谁撒谎——比如小精灵、");
    g_tipLine[14184] = StringToText("  送葬者、圣徒、贤者或莽夫。");
    g_tipLine[14185] = StringToText("· 接近那些宣称是同一角色的玩家来观察他们是否是善良玩家。如果你可以通过查看剧本上最可能隐藏自己的角色来猜出他们的角色");
    g_tipLine[14186] = StringToText("  ，那这些玩家很可能在游戏剩下的时间内信任你。当然你也会信任他。");
    g_tipLine[14187] = StringToText("· 鼓励所有玩家分享关于他们是哪个角色的信息，并尽早如此做。看看你能不能让每个玩家都透露真相或是保持沉默。");
    g_tipLine[14188] = StringToText("  在告密者游戏中，善良阵营玩家谎报自己是谁的好处更少，因为邪恶阵营更容易识别出这些谎言。");
    g_tipLine[14189] = StringToText("  由于邪恶阵营可能会得知六个不在场的角色，所以善良玩家伪装成不在场角色，可能除了其他善良玩家外，不会骗到任何人。");
    g_tipLine[14190] = StringToText("  通常来说最好的方法是善良阵营互相说出真相并鼓励这样操作。");
    g_tipLine[14191] = StringToText("· 如果你在游戏早期就透露你是告密者，并向善良阵营解释邪恶阵营获得了安全的伪装，");
    g_tipLine[14192] = StringToText("  这应当有望鼓励善良阵营尽早开始分享他们的信息。与其等到游戏中后期才共享信息，不如尽早共享信息对善良阵营更有好处。");
    g_tipLine[14193] = StringToText("· 如果你在游戏后期才透露你是告密者，善良阵营可能已经进行了一整局除了全场没有两名玩家宣称同一角色以外都很普通的游戏");
    g_tipLine[14194] = StringToText("  。在这种情况下，稍晚的透露应当能让人们更相信你是告密者而不处决你。");
    g_tipLine[14195] = StringToText("  在第一天就让所有善良玩家都相信你是告密者可能意义不大，但当只有三名玩家还活着并且你是其中之一时，");
    g_tipLine[14196] = StringToText("  这可能意味着一切。这种策略在外来者人数能被得知的游戏中效果最好。");
    g_tipLine[14197] = StringToText("· 尽可能地活跃。尽你所能让团队互相沟通。你知道一些信息。是的，你知道的信息可能不是什么很棒的信息，");
    g_tipLine[14198] = StringToText("  尽管如此它也是信息。要想赢得游戏，善良阵营也需要知道这些信息。当作你是一个拥有一条信息可供分享的有用镇民来玩游戏");
    g_tipLine[14199] = StringToText("  。");
    g_tipRoleAt[92] = 14159; g_tipRoleN[92] = 41; g_tipP1At[92] = 14161; g_tipP1N[92] = 7; g_tipP2At[92] = 14178; g_tipP2N[92] = 3;
    g_tipAbility[92] = StringToText("爪牙会在其首个夜晚得知三个伪装。");
    g_tipLine[14200] = StringToText("【背景故事】");
    g_tipLine[14201] = StringToText("「给出命令，下达命令。只需要这样做就足够了。」");
    g_tipLine[14202] = StringToText("【角色能力】");
    g_tipLine[14203] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipLine[14204] = StringToText("【角色简介】");
    g_tipLine[14205] = StringToText("提线木偶对自己是爪牙一事全然不知。");
    g_tipLine[14206] = StringToText("· 提线木偶会从盲抽袋中抽取到一个镇民或外来者角色，但是他实际上是提线木偶。");
    g_tipLine[14207] = StringToText("· 提线木偶与恶魔是邻座。他们之间不会有其他的玩家。");
    g_tipLine[14208] = StringToText("· 恶魔会知道哪一名玩家是提线木偶。");
    g_tipLine[14209] = StringToText("· 提线木偶不会在游戏的首个夜晚被唤醒以得知其他邪恶玩家都有谁，其他爪牙也不会得知谁是提线木偶。");
    g_tipLine[14210] = StringToText("· 认为自己是提线木偶的玩家所抽取到的善良角色对应的能力不会产生任何效果，但说书人会假装这些效果生效了。");
    g_tipLine[14211] = StringToText("  这与酒鬼的运作方式相似。");
    g_tipLine[14212] = StringToText("· 提线木偶在互动时被当作邪恶阵营以及爪牙角色。");
    g_tipLine[14213] = StringToText("· 提线木偶不会因其他角色能力导致他确认自己是爪牙而被唤醒。例如：告密者，传教士，小怪宝，罂粟种植者，帽匠，");
    g_tipLine[14214] = StringToText("  落难少女等。");
    g_tipLine[14215] = StringToText("【范例】");
    g_tipLine[14216] = StringToText("小明是提线木偶，她认为自己是送葬者。她在每个夜晚被唤醒并得知白天死于处决的角色，但她的信息大部分时候都是错误的。");
    g_tipLine[14217] = StringToText("  在游戏进行到一半后，恶魔告诉她她实际上是提线木偶。");
    g_tipLine[14218] = StringToText("小兰是恶魔，他告诉小美她是提线木偶。小兰撒谎了，实际上提线木偶不在场。");
    g_tipLine[14219] = StringToText("小黑是恶魔，他告诉小八小八是提线木偶。小八认为自己是占卜师，但他实际上不是。因为他不相信小黑，");
    g_tipLine[14220] = StringToText("  于是他提名并处决了小黑。善良阵营获胜。");
    g_tipLine[14221] = StringToText("【运作方式】");
    g_tipLine[14222] = StringToText("在游戏设置时，将角色标记放入盲抽袋之前，移除提线木偶角色标记，并加入一个镇民角色标记。");
    g_tipLine[14223] = StringToText("如果有三名爪牙在场，额外再移除一个爪牙角色标记，并加入一个镇民角色标记。在为首个夜晚做准备时，");
    g_tipLine[14224] = StringToText("  将一名善良镇民玩家的角色标记与一个不在场的爪牙角色标记交换。在首个夜晚，唤醒这名玩家，对他展示「你是」");
    g_tipLine[14225] = StringToText("  信息标记和他的爪牙角色标记，随后展示「你是」信息标记和朝下的大拇指，随后让他重新入睡。");
    g_tipLine[14226] = StringToText("  那名玩家现在是一名邪恶的爪牙了。（这一步骤会确保只会有一个爪牙角色进入盲抽袋里，");
    g_tipLine[14227] = StringToText("  从而使得至少会有一名善良玩家会与恶魔邻座。）");
    g_tipLine[14228] = StringToText("在为首个夜晚做准备时，在一名与恶魔邻座的善良玩家角色标记旁放置提线木偶的「是提线木偶」提示标记。在首个夜晚，");
    g_tipLine[14229] = StringToText("  唤醒恶魔，指向标记了「是提线木偶」的玩家，对恶魔展示提线木偶角色标记。让恶魔重新入睡。");
    g_tipLine[14230] = StringToText("将提线木偶以为的那个角色视同醉酒一样来运作。他会在他以为的那个善良角色的时机被唤醒，可能获得错误信息，");
    g_tipLine[14231] = StringToText("  但不会在首夜爪牙信息时被唤醒，等等。");
    g_tipLine[14232] = StringToText("提线木偶有另一种通用的设置方式：移除提线木偶角色标记和恶魔角色标记，并加入两个镇民角色标记。");
    g_tipLine[14233] = StringToText("  在为首个夜晚做准备时，选择任意一名与善良玩家相邻的镇民玩家，将他的角色标记替换成恶魔，");
    g_tipLine[14234] = StringToText("  并在他邻座选择一位善良玩家标记「是提线木偶」。唤醒恶魔并告诉他他的恶魔角色和邪恶阵营，");
    g_tipLine[14235] = StringToText("  随后告知他提线木偶是谁以及他的恶魔信息。不论爪牙数量多少，都可以按照这个方法进行设置。");
    g_tipLine[14236] = StringToText("【提示标记】");
    g_tipLine[14237] = StringToText("· 是提线木偶");
    g_tipLine[14238] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[14239] = StringToText("放置条件：在将所有玩家的角色标记收回到魔典后，在与恶魔邻座的一个善良玩家的角色标记旁放置。");
    g_tipLine[14240] = StringToText("移除时机：提线木偶离场时。");
    g_tipLine[14241] = StringToText("【规则细节】");
    g_tipLine[14242] = StringToText("· 相克规则：");
    g_tipLine[14243] = StringToText("  · 瘟疫医生：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[14244] = StringToText("  · 小怪宝：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[14245] = StringToText("  · 气球驾驶员：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_tipLine[14246] = StringToText("  · 巡山人：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_tipLine[14247] = StringToText("  · 召唤师：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[14248] = StringToText("  · 卡扎力：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[14249] = StringToText("  · 炼金术士：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一定在场。");
    g_tipLine[14250] = StringToText("  · 魔术师：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_tipLine[14251] = StringToText("  · 数学家：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_tipLine[14252] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14253] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14254] = StringToText("  · 梼杌：梼杌不会得知谁是提线木偶。在梼杌使得提线木偶失去能力后，梼杌会得知对应的那一名提线木偶是谁，");
    g_tipLine[14255] = StringToText("    但提线木偶会仍然以为自己是一个善良角色。");
    g_tipLine[14256] = StringToText("  · 姑获鸟：姑获鸟无法获得提线木偶的能力。");
    g_tipLine[14257] = StringToText("【提示与技巧】");
    g_tipLine[14258] = StringToText("· 作为提线木偶，你本质上是一个邪恶的酒鬼——你不仅没有你以为具有的能力，甚至不是你以为你是的阵营！");
    g_tipLine[14259] = StringToText("  好消息是许多你能用来检测自己是酒鬼的技巧也适用于检测提线木偶。如果你的信息不够合乎情理，");
    g_tipLine[14260] = StringToText("  或是你的能力在它应当生效时没有生效，那么你可能是提线木偶而不是一名善良玩家！");
    g_tipLine[14261] = StringToText("· 即使你无法知道，但你的阵营实际上是邪恶的并且你会被像是女裁缝或城镇公告员这样的角色当作邪恶阵营。但至少，");
    g_tipLine[14262] = StringToText("  你可以利用这点来帮助你确定你的角色……不过镇上的人也可以，所以请小心不要随意请求玩家对你使用他们的能力！");
    g_tipLine[14263] = StringToText("· 在多数情况下，邪恶阵营会想让你知道你应该与他们合作。如果你的一名邻近玩家告诉你你是提线木偶，认真对待这件事；");
    g_tipLine[14264] = StringToText("  虽然他们很有可能在骗你，但他们也可能只是想把你带入你的真实角色，如果你揭露他们，那么邪恶阵营会落败而你也会落败！");
    g_tipLine[14265] = StringToText("· 如果你怀疑你是提线木偶（可能是因为你的信息令你困惑或是某人直截了当地告诉了你），不要告诉其他镇民你的怀疑！");
    g_tipLine[14266] = StringToText("  如果你是对的而小镇相信你，那么善良阵营将会知道恶魔必定是你的邻近玩家之一。");
    g_tipLine[14267] = StringToText("· 除非证据确凿，否则不要提名或投票你的邻近玩家。如果你是提线木偶，恶魔一定是你的邻近玩家之一。");
    g_tipLine[14268] = StringToText("  因为你不知道你是邪恶的而意外地处决了你的恶魔这件事可能会让你不太快乐！");
    g_tipLine[14269] = StringToText("· 缩小在场爪牙类型的范围。提线木偶本质上一种隐秘而不外现的爪牙，而剧本中的其他爪牙可能更像外放的发言者——确认其中");
    g_tipLine[14270] = StringToText("  一种在场也意味着确认大家不必担心是提线木偶。如果你在一个八人游戏（单爪牙）中并且刚刚目睹了一名女巫的死亡，");
    g_tipLine[14271] = StringToText("  你就一定不是提线木偶！");
    g_tipLine[14272] = StringToText("· 如果你确信你知道谁是爪牙，你也可以确信你不是那个潜伏的提线木偶。游戏中的爪牙数量有限，");
    g_tipLine[14273] = StringToText("  即使你不知道他们的爪牙类型，确定谁是爪牙还是能告诉所有其他善良玩家他们不是提线木偶。");
    g_tipLine[14274] = StringToText("· 致力于追猎恶魔！如果你是提线木偶，那恶魔就是你的邻近玩家之一。如果你能证明恶魔坐在其他地方（比如，");
    g_tipLine[14275] = StringToText("  占卜师端了小镇的另一头），那么你就知道你不可能是提线木偶！（额外地如果你是提线木偶，你也让你的恶魔远离怀疑！");
    g_tipLine[14276] = StringToText("  这是双赢！）");
    g_tipLine[14277] = StringToText("· 如果你担心你是提线木偶，但又没法让你的邻近玩家敞开心扉，你总是能试着说服你的邻近玩家他是提线木偶。");
    g_tipLine[14278] = StringToText("  邪恶玩家会知道这不是真的，而善良玩家将不得不就你说的是否是事实与你抗争，并表现出不同的行为。");
    g_tipLine[14279] = StringToText("  这可以给你提供谁是你的秘密邪恶盟友的线索，或者至少能了解到你的秘密邻近邪恶玩家。");
    g_tipLine[14280] = StringToText("· 如果你确信你是提线木偶，那你就会知道你的角色是保护你的恶魔。小镇也会知道木偶可能在，并将密切关注你的存在，");
    g_tipLine[14281] = StringToText("  以便利用你来消灭你的恶魔。为了防止小镇怀疑你，改变你的信息，转而让它们看起来像是真的——比如，");
    g_tipLine[14282] = StringToText("  如果你相信自己是一个博学者，那就确保每天的信息是一个正确一个错误的。");
    g_tipLine[14283] = StringToText("· 如果你是恶魔，决定如何与提线木偶互动是你必须接受的责任。尽快告诉提线木偶他的真实角色绝对是有好处的——这使得他们");
    g_tipLine[14284] = StringToText("  能够按照他们的真实阵营行动，保护你并且不会在他们的能力出问题时向小镇意外地暴露你。");
    g_tipLine[14285] = StringToText("  让提线木偶隐藏在暗处也很有用——有时候最强大的邪恶玩家是最善良的那个人！如果你的提线木偶完全取信于小镇，");
    g_tipLine[14286] = StringToText("  就他们冲锋陷阵（并远离你）。他们最终仍然会获胜，但不是以他们想象的那种方式！");
    g_tipLine[14287] = StringToText("· 如果你是一个恶魔，没有东西能阻止你告诉你的邻近善良玩家他们是你的提线木偶。事实上，你可以告诉他们两个人，");
    g_tipLine[14288] = StringToText("  让他们都确信自己是「真正的」木偶，而另一个是被欺骗的！由于提线木偶并不知道他们真正的阵营，");
    g_tipLine[14289] = StringToText("  因此对这些玩家最好的就是隐藏你的宣称并暗自查明他们是否与你同一阵营——这一流程将会需要一些时间并且会让他们的行为");
    g_tipLine[14290] = StringToText("  对善良阵营产生负面效果。只是要提防他们查明真相后的愤怒——他们几乎一定会回头来处决你，所以确保你有一个退场计划！");
    g_tipLine[14291] = StringToText("· 如果你是一个爪牙，告诉你的邻近善良玩家他们是你的提线木偶！即使你被发现是个骗子，你也成功地让善良阵营陷入困惑，");
    g_tipLine[14292] = StringToText("  并且不会面临因被处决而落败的风险！");
    g_tipLine[14293] = StringToText("· 你是善良的，但有个不太合作的邻近玩家？告诉他们他们是你的提线木偶！至少在一段时间内，");
    g_tipLine[14294] = StringToText("  多数玩家会与你合作并试着解开他们自己的角色，你可以利用这个技巧让他们与你分享信息并参与他们原本不会参与的密谋。");
    g_tipLine[14295] = StringToText("  只要确保在游戏结束前能让他们明白他们必须与善良阵营合作才能获胜就行。");
    g_tipLine[14296] = StringToText("【对抗提线木偶】");
    g_tipLine[14297] = StringToText("· 你就像是寻找暗流涌动中的酒鬼一样，寻找一名毫无疑问在提供错误信息的玩家。如果一名特定玩家的信息不合情理，");
    g_tipLine[14298] = StringToText("  那你也许已经找到了提线木偶。比如，如果一名玩家宣称是共情者并得到了「0」，但你怀疑他的一名邻近玩家是邪恶的，");
    g_tipLine[14299] = StringToText("  那共情者可能就是提线木偶。");
    g_tipLine[14300] = StringToText("· 如果一名玩家宣称是恶魔，而你是提线木偶，那你就面临一个问题。你是提线木偶吗？也许不是。");
    g_tipLine[14301] = StringToText("  如果你认为那名玩家实际上是恶魔，而提线木偶在场，那么与恶魔的另一个邻近玩家谈谈，");
    g_tipLine[14302] = StringToText("  看看你是否能查明他其实才是提线木偶！如果你认为告诉你你是提线木偶的人并非恶魔，那么他们几乎一定其实是一个爪牙。");
    g_tipLine[14303] = StringToText("  不管怎样你找到了一名邪恶玩家（或是一名需要停止骗你的善良玩家）。如果你被告知你是提线木偶但你查明了你其实不是，");
    g_tipLine[14304] = StringToText("  你就几乎赢得了游戏。");
    g_tipLine[14305] = StringToText("· 如果你确信自己不是提线木偶，但有人告诉你你是提线木偶，那告诉团队这件事。团队很可能会处决你的相邻玩家，");
    g_tipLine[14306] = StringToText("  这意味要么一个恶魔死亡，要么一个爪牙死亡，再不然就是一个伪装了但又没啥用的善良玩家死亡，");
    g_tipLine[14307] = StringToText("  最不济是一个胡闹的善良玩家死亡。");
    g_tipLine[14308] = StringToText("· 找出有多少玩家被告知他们是提线木偶。如果有超过一个，那么多半提线木偶根本就不在场。");
    g_tipLine[14309] = StringToText("· 注意你的邻近玩家。如果你认为他们都不是恶魔，并且他们也都没有告诉你你是提线木偶，");
    g_tipLine[14310] = StringToText("  那么你可以忽略提线木偶在游戏中这种情况。只要你在最后一天让你的相邻玩家存活，提线木偶在场这件事就不太令人担心。");
    g_tipLine[14311] = StringToText("  按预设的目标去查明谁是善良玩家谁是恶魔就行。");
    g_tipLine[14312] = StringToText("· 如果剧本上有提线木偶，就不要处决你的邻近玩家。你永远都不能十分确定。如果可以，转而处决其他所有玩家。");
    g_tipLine[14313] = StringToText("· 如果你认为木偶在场但不是你。那你会知道一件非常重要的事——恶魔和爪牙比邻而坐。就好像你是厨师或是钟表匠一样，");
    g_tipLine[14314] = StringToText("  你已经得知了一些非常有用的信息以往下思考。假设两名邪恶的玩家比邻而坐，然后看看这是否与游戏中的其他信息匹配。");
    g_tipLine[14315] = StringToText("  如果匹配的话，你可能已经找到了一对邪恶玩家。如果不匹配，那可能就没有提线木偶在场。不论如何，");
    g_tipLine[14316] = StringToText("  你和所有其他善良玩家都知道了一些有用的。");
    g_tipLine[14317] = StringToText("· 通常来说，查明一名玩家是爪牙很方便，但并不能帮助善良阵营获胜。在最后一天，得知一名死了很久的玩家是主谋很方便，");
    g_tipLine[14318] = StringToText("  但是查明一名死了很久的玩家是提线木偶将格外有用。相比起麻脸巫婆随意地改变了一些角色或是普卡让每个人的信息都变得可");
    g_tipLine[14319] = StringToText("  疑，仅仅一条信息——某个特定玩家是提线木偶——就足以让善良阵营在剩下三名玩家存活的情况下获胜。");
    g_tipLine[14320] = StringToText("· 请注意那些在前几天对分享信息和帮助善良阵营非常直接和热忱，随后突然沉默了的玩家。");
    g_tipLine[14321] = StringToText("  他们可能因为在游戏中途被告知是提线木偶而正陷入精神崩溃之中;)");
    g_tipRoleAt[93] = 14200; g_tipRoleN[93] = 122; g_tipP1At[93] = 14202; g_tipP1N[93] = 13; g_tipP2At[93] = 14241; g_tipP2N[93] = 16;
    g_tipAbility[93] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipLine[14322] = StringToText("【背景故事】");
    g_tipLine[14323] = StringToText("「我们是冬日刺骨的寒风。我们是无月之夜的阴影。我们是你茶里的毒药，是你耳边的低语。我们无处不在。」");
    g_tipLine[14324] = StringToText("【角色能力】");
    g_tipLine[14325] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。[多数玩家为军团]");
    g_tipLine[14326] = StringToText("【角色简介】");
    g_tipLine[14327] = StringToText("军团由多个恶魔组成。");
    g_tipLine[14328] = StringToText("· 如果军团在场，推荐将在场善良和邪恶玩家的数量在通常的数量上进行反转。例如，在一局十人游戏中，");
    g_tipLine[14329] = StringToText("  你可以采取近似七名军团和三名善良玩家的设置。");
    g_tipLine[14330] = StringToText("· 非军团的玩家可以是镇民也可以是外来者，由说书人来决定这些善良玩家的角色类型组合方式。");
    g_tipLine[14331] = StringToText("· 如果一项提名中至少有一名善良玩家参与投票，并且被提名的玩家「即将被处决」，那么在处决阶段时处决会正常发生。");
    g_tipLine[14332] = StringToText("  如果一项提名中只有邪恶玩家参与了投票，那么在统计票数的时候会记为零票。");
    g_tipLine[14333] = StringToText("· 每名军团在互动时被当作恶魔，同时也被当作爪牙。");
    g_tipLine[14334] = StringToText("· 由说书人来决定哪一名玩家会在夜晚死亡。");
    g_tipLine[14335] = StringToText("· 如果游戏中只剩一名善良玩家存活，说书人可以宣布邪恶阵营获胜，因为在这种条件下善良阵营无法获胜。");
    g_tipLine[14336] = StringToText("· 说书人可以不向军团提供恶魔的伪装。");
    g_tipLine[14337] = StringToText("【范例】");
    g_tipLine[14338] = StringToText("场上仅有的善良玩家是占卜师和猎手。有六名军团在场，猎手提名并处决了占卜师。邪恶阵营获胜。");
    g_tipLine[14339] = StringToText("四名玩家存活。在对小佳的提名投票中，三名军团投票，且没有善良玩家参与投票。小佳不会被处决。小艾获得了两票，");
    g_tipLine[14340] = StringToText("  其中一票来自一名善良玩家，因此小艾被处决而不是小佳。邪恶阵营获胜。");
    g_tipLine[14341] = StringToText("【运作方式】");
    g_tipLine[14342] = StringToText("在首个夜晚，恶魔信息步骤中，唤醒所有军团进行互认。（你可以通过指向所有非军团玩家，来让军团玩家明白谁是谁。）");
    g_tipLine[14343] = StringToText("除了首个夜晚以外的每个夜晚，你可以决定让一名玩家死亡。");
    g_tipLine[14344] = StringToText("当统计投票时，如常大声唱票。如果投票统计足以让被提名的玩家「即将被处决」但只有邪恶玩家参与投票，");
    g_tipLine[14345] = StringToText("  宣布本次投票票数为零票。");
    g_tipLine[14346] = StringToText("你应该在大多数夜晚都杀死一名军团。在夜晚杀死善良玩家通常都不太公平。");
    g_tipLine[14347] = StringToText("  你的目的是进入游戏的最后一天只剩三名玩家存活的场面——其中有两名善良玩家和一名军团玩家。在最后一天，");
    g_tipLine[14348] = StringToText("  如果玩家没有成功进行处决，那么在当晚杀死一名善良玩家并使得邪恶阵营获胜。");
    g_tipLine[14349] = StringToText("如果玩家尝试通过强制安排投票的方式来「检测总票数是否为零票」，那么你可以改为照常宣布票数，");
    g_tipLine[14350] = StringToText("  但在魔典中使用军团的「即将被处决」提示标记秘密记录真正「即将被处决」的玩家，并在提名阶段结束后处决这名玩家。");
    g_tipLine[14351] = StringToText("  这会使得有军团存在的游戏变得更加神秘而富有挑战性。");
    g_tipLine[14352] = StringToText("【提示标记】");
    g_tipLine[14353] = StringToText("· 即将被处决");
    g_tipLine[14354] = StringToText("放置时机：在一次提名的投票被统计，当前被提名者得票过半且是当天得票最多的玩家后。");
    g_tipLine[14355] = StringToText("放置条件：放置在该玩家的角色标记旁。");
    g_tipLine[14356] = StringToText("转移时机：当天有新的得票过半且得票超过被标记了「即将被处决」的玩家时，转移到新的即将被处决的玩家的角色标记旁。");
    g_tipLine[14357] = StringToText("移除时机：当天有玩家得票与「即将被处决」的玩家得票相同时，或处决执行完毕。");
    g_tipLine[14358] = StringToText("· 死亡");
    g_tipLine[14359] = StringToText("放置时机：在除首个夜晚以外的夜晚里军团行动时放置。");
    g_tipLine[14360] = StringToText("放置条件：由说书人来决定军团攻击的玩家。如果该玩家当前存活且能被军团杀死，同时有任何军团存活且清醒健康，");
    g_tipLine[14361] = StringToText("  那么在该玩家的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[14362] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[14363] = StringToText("【规则细节】");
    g_tipLine[14364] = StringToText("· 相克规则：");
    g_tipLine[14365] = StringToText("  · 工程师：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，工程师失去能力并改为得知这一信息。");
    g_tipLine[14366] = StringToText("  · 传教士：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_tipLine[14367] = StringToText("  · 吟游诗人：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处决的玩家是军团。");
    g_tipLine[14368] = StringToText("  · 帽匠：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[14369] = StringToText("  · 狂热者：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[14370] = StringToText("  · 召唤师：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[14371] = StringToText("  · 政客：政客可能会被军团当作邪恶玩家。");
    g_tipLine[14372] = StringToText("  · 魔术师：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_tipLine[14373] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14374] = StringToText("  · 戏子：在戏子存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[14375] = StringToText("    说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipLine[14376] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[14377] = StringToText("    说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_tipLine[14378] = StringToText("【提示与技巧】");
    g_tipLine[14379] = StringToText("· 小心使用你的伪装角色。特别是在多人游戏中，可能四个军团要同时使用一个伪装角色。如果你们都选择使用这个角色，");
    g_tipLine[14380] = StringToText("  善良阵营将很容易弄清楚这三个伪装角色是什么。");
    g_tipLine[14381] = StringToText("· 当投票围绕圆圈进行时，请注意谁在投票。除非你知道一位善良玩家也在投票，否则请考虑保持低调。这样，");
    g_tipLine[14382] = StringToText("  你将确保在获得民众支持的投票未通过时，你不会被认定为军团。");
    g_tipLine[14383] = StringToText("· 但是，不要太明显地表明你正在跟着特定玩家或一些玩家投票。除非你成功伪装为管家，否则你最终可能会引起好团队的怀疑。");
    g_tipLine[14384] = StringToText("· 考虑故意声称自己是某个在场的角色。毕竟，如果你死了，你只是众多人中的一员，");
    g_tipLine[14385] = StringToText("  但如果你能让其他人对你伪装角色的玩家产生足够的怀疑，甚至被处决，你就会离胜利更近一步。");
    g_tipLine[14386] = StringToText("· 如果善良阵营很确信他们在军团游戏中，你可以利用他们对新发现的偏执来建立优势。");
    g_tipLine[14387] = StringToText("  尝试向其中一个人推销你和他们可能是最后剩下的善良玩家的想法。在信任圈内只有一个军团与善良玩家很容易导致善良团队陷");
    g_tipLine[14388] = StringToText("  入死亡漩涡。");
    g_tipLine[14389] = StringToText("· 有时候伪装成其他角色需要集体努力，尤其是当它们具有改变游戏规则的含义时，例如无神论者、罂粟种植者或涡流。");
    g_tipLine[14390] = StringToText("  一旦一名玩家提出其中一项声明，就需要大家协调一致来维持谎言。其他军团玩家需要跟随你的脚步。");
    g_tipLine[14391] = StringToText("· 有许多邪恶角色的能力可以立即公开否定军团的存在。这包括女巫的诅咒、魔鬼代言人处决豁免（如果没有其他解释）、");
    g_tipLine[14392] = StringToText("  恐惧之灵或精神病患者暴露自己。如果这些在剧本上，军团将不得不证明这些角色不在场。");
    g_tipLine[14393] = StringToText("· 然而，也有邪恶角色的能力虽然可以向某个玩家否定军团的存在，但由于该证据依赖于该玩家与大家分享他们的信息，");
    g_tipLine[14394] = StringToText("  这可能被视为谎言。这包括一个人被洗脑师洗脑了（直到玩家被戏剧性地处决），或者一个玩家声称寡妇在场。");
    g_tipLine[14395] = StringToText("· 最重要的是，军团可以用假的邪恶角色能力来试图让大家相信这不是军团局。一个邪恶玩家可以声称他们被洗脑师洗脑了，");
    g_tipLine[14396] = StringToText("  或者可以声称他们是知道游戏中有寡妇的善良玩家。");
    g_tipLine[14397] = StringToText("· 假装是爪牙。军团可以被当作恶魔或爪牙——如果你能让善良阵营相信你是一个爪牙，你就可以让善良阵营迷失方向。");
    g_tipLine[14398] = StringToText("  如果守鸦人检测到你是投毒者，请把自己置身危险之中——邪恶团队的其他成员可以利用它来转移对军团的怀疑。");
    g_tipLine[14399] = StringToText("【对抗军团】");
    g_tipLine[14400] = StringToText("· 作为善良阵营的玩家，你在投票和处决方面拥有很大的权力。尝试通过提前举手投票，");
    g_tipLine[14401] = StringToText("  然后在轮到你投票之前放下手来抓住军团玩家。如果你能造成只有军团投票，你可以一举认定一半的玩家为邪恶。");
    g_tipLine[14402] = StringToText("· 请记住，邪恶阵营的伪装角色是不够用的，这意味着将发生两件事，这将有助于您判断出本局是军团局。");
    g_tipLine[14403] = StringToText("  · 1）一些邪恶玩家最终可能会声明相同的伪装角色，从而暴露自己。");
    g_tipLine[14404] = StringToText("  · 2) 部分邪恶玩家可能会直接赌一把从剧本中随机选择一个角色，可能会自称是你的角色（或者你同阵营玩家的角色之一）。");
    g_tipLine[14405] = StringToText("· 不要因为送葬者或筑梦师之类的角色说他们已经知道玩家是特定的爪牙而确信您不在军团局。军团可以被当作爪牙，");
    g_tipLine[14406] = StringToText("  从而隐藏自己。");
    g_tipLine[14407] = StringToText("· 在军团局中，说书人将选择谁在晚上死去，并且很可能每晚都会选择一个军团玩家以达到平衡的目的。这意味着，");
    g_tipLine[14408] = StringToText("  如果你是一个已经表明自己的强大角色并且夜复一夜地存活，这可能表明你正在与军团作战。");
    g_tipLine[14409] = StringToText("· 由于军团作为一个整体可能会获得零或三个伪装角色（如果游戏中有告密者，则可能会获得六个伪装角色），这取决于说书人，");
    g_tipLine[14410] = StringToText("  这意味着有大量角色几乎没有信息可用于继续了解正在发生的事情。你在军团局中的一种迹象是当有多次重复的角色声明，");
    g_tipLine[14411] = StringToText("  一次两次还说的通，但如果你突然获得三个或更多重复的角色声明，那么这是军团在场的一个非常强有力的线索。");
    g_tipLine[14412] = StringToText("· 军团都是关于邪恶玩家进入蜂巢思维动态的。需要注意的一件事是，如果一切看起来真的很合拍。如果大家有太多的共识，");
    g_tipLine[14413] = StringToText("  那就意味着太多的人在一致行动，这可能意味着你被邪恶的玩家包围，只是想让你站在一边。如果有很多人一起投票，");
    g_tipLine[14414] = StringToText("  这可能是您在军团局的进一步暗示。");
    g_tipLine[14415] = StringToText("· 军团在发起提名时可能真的很犹豫。许多军团玩家可能反复确认，他们是否得到了善良玩家足够的支持让提名通过。但是，");
    g_tipLine[14416] = StringToText("  一旦有玩家投票，军团将很快跟上投票。因此，如果有很多人对提名犹豫不决，但热衷于投票，这是军团局的一大暗示。");
    g_tipLine[14417] = StringToText("· 在军团局中要记住的一件关键事情是说书人控制着死亡。说书人必须确保最后一天只剩下一个军团，");
    g_tipLine[14418] = StringToText("  而且由于大多数玩家都是军团，说书人主要是在杀死军团。如果死亡似乎不遵循恶魔杀戮的传统逻辑，");
    g_tipLine[14419] = StringToText("  或者死亡看起来非常令人惊讶，那么这也许就是军团局的线索。");
    g_tipRoleAt[94] = 14322; g_tipRoleN[94] = 98; g_tipP1At[94] = 14324; g_tipP1N[94] = 13; g_tipP2At[94] = 14363; g_tipP2N[94] = 15;
    g_tipAbility[94] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。你也会被当作是爪牙。[多数玩家为军团]");
    g_tipLine[14420] = StringToText("【背景故事】");
    g_tipLine[14421] = StringToText("「探寻地球本质。加以矫正，你将寻得秘石。黄金之上皆是红色。那是真理之冠。」");
    g_tipLine[14422] = StringToText("【角色能力】");
    g_tipLine[14423] = StringToText("你拥有一个爪牙角色的能力。当你使用能力时，说书人可能会要求你更换选择。");
    g_tipLine[14424] = StringToText("【角色简介】");
    g_tipLine[14425] = StringToText("炼金术士具有爪牙的能力。");
    g_tipLine[14426] = StringToText("· 炼金术士通常会获得一个不在场爪牙的能力，但可以获得一个在场爪牙的能力。");
    g_tipLine[14427] = StringToText("· 炼金术士会在自己的首个夜晚得知自己获得了哪一项爪牙的能力。");
    g_tipLine[14428] = StringToText("· 炼金术士仍然是善良的镇民。他会在善良阵营获胜时一同获胜，也会在善良阵营落败时一同落败。");
    g_tipLine[14429] = StringToText("  他被当作善良阵营的炼金术士。");
    g_tipLine[14430] = StringToText("· 不同于一般的爪牙，炼金术士不会被唤醒以得知其他爪牙以及恶魔分别是哪些玩家。");
    g_tipLine[14431] = StringToText("· 如果炼金术士获得的爪牙能力会导致在设置阶段添加或移除角色，这一能力也会在设置阶段生效。");
    g_tipLine[14432] = StringToText("· 如果炼金术士获得了一个可以选择的能力，比如投毒者或维齐尔，说书人可以让炼金术士换个选择，");
    g_tipLine[14433] = StringToText("  炼金术士就必须更换自己的选择。");
    g_tipLine[14434] = StringToText("【范例】");
    g_tipLine[14435] = StringToText("炼金术士拥有男爵的能力，给游戏带来了两个额外的外来者。");
    g_tipLine[14436] = StringToText("炼金术士拥有投毒者的能力。在首个夜晚，他被唤醒并让巫师中毒了。在第二个夜晚，他被唤醒并让戏法师中毒了。");
    g_tipLine[14437] = StringToText("  在第三个夜晚，他被唤醒并尝试选择堤丰之首，但说书人让他更换选择，他转而选择了国王。堤丰之首没有中毒。");
    g_tipLine[14438] = StringToText("【运作方式】");
    g_tipLine[14439] = StringToText("在游戏的首个夜晚，唤醒炼金术士。向炼金术士展示「你是」信息标记，然后展示一个爪牙的角色标记。让炼金术士入睡。");
    g_tipLine[14440] = StringToText("  如果炼金术士获得了一个不在场爪牙的能力，将炼金术士的角色标记替换为刚刚展示的爪牙角色标记并倒置（以标记他仍然是善良");
    g_tipLine[14441] = StringToText("  阵营），并放置「是炼金术士」提示标记。");
    g_tipLine[14442] = StringToText("炼金术士拥有该爪牙的能力。他会像一名爪牙一样使用这项能力，并在每晚该爪牙通常会被唤醒以使用能力时被唤醒。");
    g_tipLine[14443] = StringToText("如果炼金术士在使用能力时需要做出选择，你可以要求他重新选择。如果这是在白天，请直接用言语提出。如果是在夜晚，");
    g_tipLine[14444] = StringToText("  请摇头，指向角色卡上的炼金术士能力文本，等待炼金术士重新选择。");
    g_tipLine[14445] = StringToText("【提示标记】");
    g_tipLine[14446] = StringToText("· 是炼金术士");
    g_tipLine[14447] = StringToText("放置时机：在首个夜晚放置。");
    g_tipLine[14448] = StringToText("放置条件：放置在炼金术士的角色标记旁。");
    g_tipLine[14449] = StringToText("移除时机：炼金术士离场时。");
    g_tipLine[14450] = StringToText("【规则细节】");
    g_tipLine[14451] = StringToText("· 特定角色互动：");
    g_tipLine[14452] = StringToText("  · 学徒：善良学徒可以获得炼金术士的能力，进而获得一个爪牙的能力。");
    g_tipLine[14453] = StringToText("  · 赏金猎人：赏金猎人可以让炼金术士转变为邪恶，让爪牙能力回归邪恶阵营。");
    g_tipLine[14454] = StringToText("  · 洗脑师：无论洗脑师或炼金洗脑师，告知目标玩家「疯狂」的流程都一样，对该玩家展示洗脑师角色标记和需要「疯狂」");
    g_tipLine[14455] = StringToText("    的角色标记。");
    g_tipLine[14456] = StringToText("  · 侍女：炼金术士会在第一夜被唤醒得知他获得了什么爪牙能力，之后是否被唤醒取决于他获得的爪牙能力。");
    g_tipLine[14457] = StringToText("  · 镜像双子：如果炼金术士获得镜像双子能力，则将一名邪恶玩家设置为他的「对立双子」。如果这名善良的炼金双子被处决，");
    g_tipLine[14458] = StringToText("    邪恶阵营获胜。");
    g_tipLine[14459] = StringToText("  · 恐惧之灵：获得恐惧之灵能力的炼金术士在夜晚触发的公开宣布与恐惧之灵相同：「恐惧之灵选择了一名玩家」。");
    g_tipLine[14460] = StringToText("  · 哥布林：炼金哥布林触发哥布林能力需要声明自己是哥布林，而不是炼金哥布林。实际上，");
    g_tipLine[14461] = StringToText("    如果不允许将这两种情况当作同样处理，也太过于为难玩家了。");
    g_tipLine[14462] = StringToText("  · 军团：炼金术士无法获得军团的能力。");
    g_tipLine[14463] = StringToText("  · 小怪宝：炼金术士不是爪牙，所以不会在为秘密决定由哪名玩家照看小怪宝时醒来。");
    g_tipLine[14464] = StringToText("  · 精神病患者：当炼金精神病患者发动能力选择一名玩家时，说书人可以公开要求他重新选择一名玩家，他必须更换选择。");
    g_tipLine[14465] = StringToText("    （说书人也可以要求精神病患者重新选择一名玩家，他可以不更换选择）");
    g_tipLine[14466] = StringToText("· 相克规则：");
    g_tipLine[14467] = StringToText("  · 寡妇：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。每次处决后，");
    g_tipLine[14468] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[14469] = StringToText("  · 间谍：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。每次处决后，");
    g_tipLine[14470] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[14471] = StringToText("  · 召唤师：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_tipLine[14472] = StringToText("    由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[14473] = StringToText("  · 科学怪人：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。");
    g_tipLine[14474] = StringToText("  · 亡魂：如果炼金术士本应获得亡魂的能力，那么他不会拥有该能力并改为亡魂一定在场。每次处决后，");
    g_tipLine[14475] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_tipLine[14476] = StringToText("  · 提线木偶：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一定在场。");
    g_tipLine[14477] = StringToText("  · 主谋：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_tipLine[14478] = StringToText("  · 街头风琴手：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。如果炼金术士和街头风琴手都是清醒的，");
    g_tipLine[14479] = StringToText("    改为他们都醉酒。");
    g_tipLine[14480] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14481] = StringToText("  · 蛊雕：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改为蛊雕一定在场。每次处决后，");
    g_tipLine[14482] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_tipLine[14483] = StringToText("【提示与技巧】");
    g_tipLine[14484] = StringToText("待更新");
    g_tipRoleAt[95] = 14420; g_tipRoleN[95] = 65; g_tipP1At[95] = 14422; g_tipP1N[95] = 12; g_tipP2At[95] = 14450; g_tipP2N[95] = 33;
    g_tipAbility[95] = StringToText("你拥有一个爪牙角色的能力。当你使用能力时，说书人可能会要求你更换选择。");
    g_tipLine[14485] = StringToText("【背景故事】");
    g_tipLine[14486] = StringToText("「我没时间跟你谈条件。」");
    g_tipLine[14487] = StringToText("【角色能力】");
    g_tipLine[14488] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（善良/邪恶/均势）。");
    g_tipLine[14489] = StringToText("【角色简介】");
    g_tipLine[14490] = StringToText("将军清楚哪个阵营更具有优势。");
    g_tipLine[14491] = StringToText("· 如果善良阵营更具优势，说书人会给出大拇指朝上的手势。如果邪恶阵营更具优势，说书人会给出大拇指朝下的手势。");
    g_tipLine[14492] = StringToText("  如果双方阵营势均力敌，或说书人并不确信哪一方更具优势，说书人会给出大拇指水平指向一侧的手势。");
    g_tipLine[14493] = StringToText("· 说书人需要对阵营的优势做出判断。很多因素都会作为考量，例如每个阵营有多少存活的玩家，善良阵营获取的信息程度如何，");
    g_tipLine[14494] = StringToText("  邪恶阵营的伪装的取信程度如何，玩家们即将打算处决谁，或是恶魔玩家的游戏经验是否丰富。");
    g_tipLine[14495] = StringToText("  上述所有内容以及一些其他因素都会影响说书人的判断。");
    g_tipLine[14496] = StringToText("· 说书人判断的是将军被唤醒的那一刻更具有优势的阵营。当晚较早时段里发生的事情也可能会影响判断。");
    g_tipLine[14497] = StringToText("【范例】");
    g_tipLine[14498] = StringToText("有五名善良玩家和三名爪牙存活。即使现在恶魔玩家备受猜疑，极大可能会成为下一个处决对象，");
    g_tipLine[14499] = StringToText("  但此外红唇女郎在场且被认为是善良玩家。说书人给出了拇指向下的手势。");
    g_tipLine[14500] = StringToText("善良阵营拥有了大量的信息，也确信了自己获得的信息的真伪。只有一名爪牙死亡。说书人给出了拇指向上的手势。");
    g_tipLine[14501] = StringToText("珀的玩家是一名老手玩家，且与爪牙之间的协调分工十分默契。僧侣在每个夜晚都保护了博学者，");
    g_tipLine[14502] = StringToText("  善良阵营也对谁是善良玩家有较为清晰的判断。然而，珀极大可能会在明晚杀死三名玩家，所以很难确信哪一方究竟会赢。");
    g_tipLine[14503] = StringToText("  说书人给出了大拇指水平指向一侧的手势。");
    g_tipLine[14504] = StringToText("【运作方式】");
    g_tipLine[14505] = StringToText("每个夜晚，唤醒将军。如果你认为善良阵营更具优势，给出拇指朝上的手势。如果你认为邪恶阵营更具优势，");
    g_tipLine[14506] = StringToText("  给出拇指朝下的手势。如果你不清楚哪一方更具优势，给出拇指水平指向一侧的手势。让将军重新入睡。");
    g_tipLine[14507] = StringToText("【提示标记】");
    g_tipLine[14508] = StringToText("无");
    g_tipLine[14509] = StringToText("【提示与技巧】");
    g_tipLine[14510] = StringToText("· 谨记，你的职能与说书人的个人看法会有互动。这种看法会不可避免地受到游戏机制外的因素影响。");
    g_tipLine[14511] = StringToText("  你们的玩家群体中是否有公认狡猾而邪恶的玩家？也许你的游戏中有人比其他人更具有（游戏）经验？");
    g_tipLine[14512] = StringToText("  何种策略和战术是你的说书人认为最有效的？这些乃至更多事物会影响到你每晚获得的信息。");
    g_tipLine[14513] = StringToText("· 想一想每个白天/夜晚发生的事件，试着想象它们如何改变了游戏的平衡。在得知善良阵营即将获胜前你是否处决了某名玩家？");
    g_tipLine[14514] = StringToText("  也许他是邪恶的而这就是说书人相信局势转向对你有利的原因。也许他获得了错误的信息而他的死亡妨碍了邪恶阵营传递谎言的");
    g_tipLine[14515] = StringToText("  可能。");
    g_tipLine[14516] = StringToText("· 记录下你的信息在每夜之间的变化。如果你能存活足够久，你基本上能得到一个折线图来反映出善良阵营的命运在游戏过程中如");
    g_tipLine[14517] = StringToText("  何变化。在最后一天时，你可以使用这些知识来证实剩余玩家的说法。");
    g_tipLine[14518] = StringToText("· 注意其他玩家的发言，尤其是团队共识。如果团队确信特定玩家是邪恶的且应在明天处决，");
    g_tipLine[14519] = StringToText("  而这名玩家实际上也确实是是邪恶的，那么即使死亡的善良玩家更多，说书人也可能会告诉你善良阵营即将获胜。同理，");
    g_tipLine[14520] = StringToText("  如果团队直言不讳地表达对于某些善良玩家和他们信息的信任，那么说书人可能会告诉你善良阵营即将获胜。");
    g_tipLine[14521] = StringToText("  如果团队直言不讳地表达对于某些善良玩家的不信任，并且试图处决他们，反而是信任邪恶玩家而不处决他们，");
    g_tipLine[14522] = StringToText("  说书人可能会告诉你邪恶阵营即将获胜。");
    g_tipLine[14523] = StringToText("· 如果你的信息在两晚之间发生了逆转（从善良即将获胜转向邪恶即将获胜或反之），这信息很有用。");
    g_tipLine[14524] = StringToText("  某些极端事项正在发生而你应当能猜出来。信息在「没有阵营即将获胜」之内盘桓（从某方即将获胜转向没有阵营即将获胜或反");
    g_tipLine[14525] = StringToText("  之）的话就不太有用。比如，第二晚得到善良阵营即将获胜而第三晚得到没有阵营即将获胜，");
    g_tipLine[14526] = StringToText("  这意味着一个不易察觉的局势改变，更难猜测到原因。");
    g_tipLine[14527] = StringToText("· 如果你一直得到善良阵营即将获胜的信息，让善良阵营知道这点。甚至可以告诉他们「我并不知道我们哪里做对了，");
    g_tipLine[14528] = StringToText("  但继续保持我们正在做的事情」都是很有帮助的，因为即使你不知道细节，你也知道你们在正确的轨道上前行。");
    g_tipLine[14529] = StringToText("  警惕任何试图扭转团队主流叙事的玩家，或是任何突然支持处决新对象的玩家。");
    g_tipLine[14530] = StringToText("· 如果你一直得到邪恶阵营即将获胜的信息，也让善良阵营知道这点，并立即采取相反的行动。如果邪恶阵营即将获胜，");
    g_tipLine[14531] = StringToText("  尝试一些全新的主张并说服团队同意。即使一个被所有人信任并被共情者鉴定为善良的图书管理员（的信息）完全合理，");
    g_tipLine[14532] = StringToText("  如果你和你的团队花费一天时间假设他在说谎、他是邪恶或者他醉酒了，说书人可能也会决定在当晚告诉你善良阵营「即将获胜");
    g_tipLine[14533] = StringToText("  」（或者「没有阵营即将获胜」）。任何操作都比让邪恶阵营日复一日地持续迈向胜利要好，");
    g_tipLine[14534] = StringToText("  所以明智的做法也许是采取反常的行动或是探索看起来不太合理的想法或是怀疑似乎已被验证的信息。");
    g_tipLine[14535] = StringToText("  最糟糕的也不过是说书人继续告诉你邪恶阵营即将获胜，而最好的情况是说书人告诉你善良阵营即将获胜——但不管怎样，");
    g_tipLine[14536] = StringToText("  你都会了解一些重要信息。然而，恶魔可能在你了解这些之前就在夜晚杀死你，");
    g_tipLine[14537] = StringToText("  因此如果你能在不透露你在这么做的情况下干预团队整体信念或意图的话就更好了。");
    g_tipRoleAt[96] = 14485; g_tipRoleN[96] = 53; g_tipP1At[96] = 14487; g_tipP1N[96] = 10; g_tipP2At[96] = 0; g_tipP2N[96] = 0;
    g_tipAbility[96] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（善良/邪恶/均势）。");
    g_tipLine[14538] = StringToText("【背景故事】");
    g_tipLine[14539] = StringToText("「我很高兴你提出了这个问题。是的，我真的很高兴。但我仍然认为，问题的核心应该是在于……」");
    g_tipLine[14540] = StringToText("【角色能力】");
    g_tipLine[14541] = StringToText("如果你是对你的阵营落败负最大责任的人，你转变阵营并获胜，即使你已死亡。");
    g_tipLine[14542] = StringToText("【角色简介】");
    g_tipLine[14543] = StringToText("如果政客落败，政客可以转变他的阵营。");
    g_tipLine[14544] = StringToText("· 当游戏结束时，如果政客是善良阵营落败负最大责任的人，政客会加入邪恶阵营并一起获胜。");
    g_tipLine[14545] = StringToText("· 当决定谁获胜的关键时候，政客玩家应当非常有影响力。简单的散布错误信息或投票善良玩家通常是不够的——他需要比任何一");
    g_tipLine[14546] = StringToText("  个其他的善良玩家起到让善良阵营落败的关键作用，同时最好也是比任何一个邪恶玩家的作用大。");
    g_tipLine[14547] = StringToText("  由说书人决定政客是否符合条件。");
    g_tipLine[14548] = StringToText("· 政客也可以和其他角色一样，以善良阵营获胜。");
    g_tipLine[14549] = StringToText("· 中毒或醉酒的政客不能转变阵营。");
    g_tipLine[14550] = StringToText("· 如果邪恶玩家的总数已经比初始设置多了一名，即使政客是对善良阵营落败负最大责任的人，由于圣洁之魂的存在，");
    g_tipLine[14551] = StringToText("  也不能转变阵营获胜。");
    g_tipLine[14552] = StringToText("【范例】");
    g_tipLine[14553] = StringToText("政客在整局游戏中都在尝试处决恶魔，但没有成功。在只剩三名玩家存活时，政客说服玩家们不要进行处决，");
    g_tipLine[14554] = StringToText("  因为有人宣称自己是镇长。当天没有处决发生，但邪恶阵营获胜，因为有爪牙伪装成了镇长。政客也一同获胜。");
    g_tipLine[14555] = StringToText("在最后一天，政客为共情者投出了一票，并说服玩家们相信共情者是邪恶玩家。然而圣徒被处决了。");
    g_tipLine[14556] = StringToText("  说书人判断善良阵营的落败是善良阵营的集体决定导致的，而非听信了政客的糟糕的建议。善良阵营落败，政客也一同落败。");
    g_tipLine[14557] = StringToText("政客认为邪恶阵营正占据优势，因此声称自己是无神论者。说书人被处决。邪恶阵营获胜，政客也一同获胜。");
    g_tipLine[14558] = StringToText("在最后一天，政客使得处决投票造成了平票的情况。在当晚，恶魔杀死了一名玩家，邪恶阵营获胜。政客也一同获胜。");
    g_tipLine[14559] = StringToText("【运作方式】");
    g_tipLine[14560] = StringToText("当游戏结束时，考量政客玩家在本局游戏中所造成的影响，是否导致了某一方阵营获胜。");
    g_tipLine[14561] = StringToText("  如果政客在他的对立阵营获胜中做出了最重要的贡献，他转变阵营并与原本对应阵营的其他玩家一同获胜。在其他情况下，");
    g_tipLine[14562] = StringToText("  政客保留原本的阵营且按照常规的胜负条件来判断政客玩家的胜负。");
    g_tipLine[14563] = StringToText("请注意政客仅会在游戏结束时才转变阵营，因此即使善良的政客在为邪恶阵营出力，他也依然会被当作是善良阵营。");
    g_tipLine[14564] = StringToText("【提示标记】");
    g_tipLine[14565] = StringToText("无");
    g_tipLine[14566] = StringToText("【规则细节】");
    g_tipLine[14567] = StringToText("· 相克规则：");
    g_tipLine[14568] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。");
    g_tipLine[14569] = StringToText("  · 维齐尔：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[14570] = StringToText("  · 科学怪人：恶魔无法拥有政客的能力。");
    g_tipLine[14571] = StringToText("  · 军团：政客可能会被军团当作邪恶玩家。");
    g_tipLine[14572] = StringToText("【提示与技巧】");
    g_tipLine[14573] = StringToText("· 从第一天开始以伪装现身，并且坚持。不要偏离你的宣称，不要改变你的故事，保持一贯性，作好假信息的静态来源，");
    g_tipLine[14574] = StringToText("  成为善良阵营能力拼凑真相的永久障碍。宣称自己是一个得知军团在场的艺术家，并迫使善良阵营将这点纳入考虑。");
    g_tipLine[14575] = StringToText("· 尽你所能伪装得极端并荒谬！如果善良阵营相信你，那你的伪装越离谱，你就越可能成为那个对落败负有最大责任的玩家！");
    g_tipLine[14576] = StringToText("  假装成无神论者！假装圣徒是你的镜像双子！宣称你被舞蛇所魅惑，然后转变成了呆瓜！用你疯狂的密谋主宰游戏，");
    g_tipLine[14577] = StringToText("  尽可能地传播错误信息。如果善良阵营相信你，你可以为邪恶阵营锁定胜利。即使他们没有，");
    g_tipLine[14578] = StringToText("  你所带来的浩劫也足以让善良阵营落败。");
    g_tipLine[14579] = StringToText("· 安静而稳妥地进行伪装。尽你所能确保没有人怀疑你是政客，然后在最后的最后提供一条关键的误导信息。");
    g_tipLine[14580] = StringToText("  在最后一天带着一条错误的女裁缝信息现身，将一名善良玩家污蔑为邪恶的，然后拥抱胜利。");
    g_tipLine[14581] = StringToText("· 编造一些假信息，并以此对一名特定玩家穷追猛打。假装是调查员、占卜师或赏金猎人并将一名其他玩家设为邪恶。");
    g_tipLine[14582] = StringToText("  如果他们是善良的，这可能是邪恶阵营获胜的决定性因素。即便你意外地被恶魔杀了，无论如何你还是赢了。");
    g_tipLine[14583] = StringToText("· 注意特殊胜利能力角色。尝试触发这些能力。如果你能谋划出对哥布林、善良双子或利维坦游戏中的第二名善良玩家进行的处决");
    g_tipLine[14584] = StringToText("  ，那你一定能确保你的胜利。");
    g_tipLine[14585] = StringToText("· 确保说书人能看到你的努力。成为善良阵营失败的次要因素并不能达成你的目的。");
    g_tipLine[14586] = StringToText("  确保说书人知道你是对你们阵营落败负有最大责任的玩家。");
    g_tipLine[14587] = StringToText("· 不要在外来者计数上捣乱。如果游戏中只有一名外来者在场，而其他某人宣称是陌客，不要挑战他们。");
    g_tipLine[14588] = StringToText("  保持隐蔽把善良阵营蒙在鼓里——简单来说，关于外来者人数的错误信息就足以赢得游戏。");
    g_tipLine[14589] = StringToText("· 如果善良阵营看起来正朝着胜利前行，那就现身。要记得你也可以和善良阵营一起获胜。");
    g_tipLine[14590] = StringToText("  你所能提供的信息——哪些邪恶玩家支持你的邪恶计划，谁对你宣称和他角色相同有反应，");
    g_tipLine[14591] = StringToText("  乃至你是一个外来者——都可能是赢得游戏所需要的信息。");
    g_tipLine[14592] = StringToText("· 尝试将那些能探查阵营（但不包含角色）的角色纳入你的谋划中。说服女裁缝检查你和一名确信善良的玩家，");
    g_tipLine[14593] = StringToText("  或是让月之子在死后选择你。记住，你被当作善良阵营——让他们亲眼确认这点可以让他们信任你的欺诈宣称。");
    g_tipLine[14594] = StringToText("· 让那些拥有强大限次能力的角色将能力消耗在你身上。说服猎手射击你，指名贞洁者或是说服教授试着复活你。");
    g_tipLine[14595] = StringToText("  让他们把强大的能力用在政客身上，削减他们收集信息和取得进展上花费的努力。");
    g_tipLine[14596] = StringToText("· 在最后一天的投票中拉平票。即使你已经死亡。这很卑鄙但很管用！如果善良阵营在最后一天不处决，之后恶魔在当晚杀人，");
    g_tipLine[14597] = StringToText("  邪恶阵营就会获胜。政客想以这种方式获胜的话，你必须是投下关键一票的玩家——如果善良阵营意外地平票，你还是落败了。");
    g_tipLine[14598] = StringToText("  你的能力要求「如果你是负有最大责任的玩家」。");
    g_tipLine[14599] = StringToText("· 如果你认为其他存活的玩家都是邪恶的，那就不要在最后一天提名。这将阻止恶魔被提名。");
    g_tipLine[14600] = StringToText("· 如果剧本上有政客，但你不是政客，那就要非常小心你信任的人。政客可能在场并在竭尽全力从中作梗，");
    g_tipLine[14601] = StringToText("  但他仍然被当作善良玩家。仅仅因为某个人在女裁缝、共情者或贵族这样的角色面前表现得善良，");
    g_tipLine[14602] = StringToText("  也并不意味着你可以信任他们。即使你确信没有人醉酒或中毒。");
    g_tipRoleAt[97] = 14538; g_tipRoleN[97] = 65; g_tipP1At[97] = 14540; g_tipP1N[97] = 12; g_tipP2At[97] = 14566; g_tipP2N[97] = 6;
    g_tipAbility[97] = StringToText("如果你是对你的阵营落败负最大责任的人，你转变阵营并获胜，即使你已死亡。");
    g_tipLine[14603] = StringToText("【背景故事】");
    g_tipLine[14604] = StringToText("「每一个人，都是一颗星星，爱情让它们产生联系，而意志决定了它们的轨迹。」");
    g_tipLine[14605] = StringToText("【角色能力】");
    g_tipLine[14606] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipLine[14607] = StringToText("【角色简介】");
    g_tipLine[14608] = StringToText("巫师许下愿望。");
    g_tipLine[14609] = StringToText("· 这个愿望只受限于玩家的想象力，它可以是任何事。巫师可以在夜晚用手机屏幕展示愿望内容给说书人，");
    g_tipLine[14610] = StringToText("  也可以在白天私下告诉说书人。如果巫师有些鲁莽，他也可以公开许愿。");
    g_tipLine[14611] = StringToText("· 说书人不必立刻公开宣布巫师许下了愿望，而是可以稍后再宣布。");
    g_tipLine[14612] = StringToText("· 许多愿望都伴随着代价。代价可能会以某种方式影响游戏，或是影响这个愿望本身。它也可以是任何事，");
    g_tipLine[14613] = StringToText("  由说书人认真思考后决定。说书人可以决定是否告诉巫师愿望的代价。代价的目的是为了从能力的效果上平衡这个愿望，");
    g_tipLine[14614] = StringToText("  以免它对善良阵营造成不公平的影响。");
    g_tipLine[14615] = StringToText("· 许多愿望会留下线索。线索可以是任何事，由说书人认真思考后决定，然后再公开宣布。");
    g_tipLine[14616] = StringToText("  线索的目的是为了从信息上平衡这个愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[14617] = StringToText("· 当巫师死亡，愿望可能会继续生效，也可能会失效，取决于愿望和代价具体是什么。");
    g_tipLine[14618] = StringToText("· 如果巫师许了一个说书人不理解的愿望，或者说书人认为他无法实现，说书人可以让巫师重新许愿，或者告诉巫师，");
    g_tipLine[14619] = StringToText("  他的愿望被消耗了。");
    g_tipLine[14620] = StringToText("【范例】");
    g_tipLine[14621] = StringToText("巫师许愿可以看一次魔典。说书人实现了这个愿望，并且没有代价和线索。");
    g_tipLine[14622] = StringToText("巫师希望相邻的玩家之一变成邪恶的巫师。说书人实现了这个愿望。代价是新巫师的能力不会生效，没有线索。");
    g_tipLine[14623] = StringToText("巫师许愿所有善良玩家醉酒。说书人实现了这个愿望。说书人宣布了巫师已经完成了许愿，并提供了「有事情出错了」的线索，");
    g_tipLine[14624] = StringToText("  没有提供其他线索。在接下来的游戏中，说书人给所有善良玩家的信息都是错误的。");
    g_tipLine[14625] = StringToText("巫师许愿成为新的恶魔，代价是原来的恶魔死亡。说书人实现了这个愿望，并且杀死了堤丰之首，然后把巫师变成了奥赫。");
    g_tipLine[14626] = StringToText("  第二天黎明说书人公开宣布巫师已经完成了许愿，和「昨晚我去剧院看了一场精彩的变脸表演」这个模糊的线索。");
    g_tipLine[14627] = StringToText("巫师许愿他能在本局游戏获胜。说书人实现了这个愿望。说书人告诉巫师，邪恶阵营会在白天结束后获胜。");
    g_tipLine[14628] = StringToText("  说书人公开宣布巫师已经完成了许愿，并宣布恶魔在小八、小米、小莱之中。大家处决了小八，由于小八是恶魔，");
    g_tipLine[14629] = StringToText("  善良阵营获胜。");
    g_tipLine[14630] = StringToText("巫师许愿有五名玩家存活，并且所有的提示标记都放置在对应角色标记旁。说书人认为这个愿望奇怪、尴尬、");
    g_tipLine[14631] = StringToText("  令人困惑并且无聊，拒绝了这个愿望，然后让巫师重新许愿。");
    g_tipLine[14632] = StringToText("【运作方式】");
    g_tipLine[14633] = StringToText("当巫师通过文字或说话许愿时，决定实现或拒绝这个愿望。如果愿望被拒绝了，让巫师再许愿一次，或告诉他已经失去能力。");
    g_tipLine[14634] = StringToText("如果愿望被实现了，告诉巫师「你的愿望被实现了」，「你的愿望生效了」，点头，");
    g_tipLine[14635] = StringToText("  或给出手势来让巫师得知他的愿望被接受了。立即或在稍后的游戏中，你可以制造一个代价：");
    g_tipLine[14636] = StringToText("  实现一个适合本局游戏的能力的效果调整，来平衡这个愿望。立即或在稍后的游戏中，你可以公开宣布巫师已经完成了许愿，");
    g_tipLine[14637] = StringToText("  然后给善良阵营一些有关这个愿望的线索。");
    g_tipLine[14638] = StringToText("说书一局存在巫师的游戏是有技巧的。当所有愿望被满足时，愿望留下线索时，以及愿望伴随着代价时，");
    g_tipLine[14639] = StringToText("  都是巫师让所有玩家最欢乐的时刻！然而……");
    g_tipLine[14640] = StringToText("如果你认为这个愿望对邪恶阵营只有轻微的好处，并且善良阵营仍然需要找到谁是恶魔来获得游戏的胜利，");
    g_tipLine[14641] = StringToText("  你可以不制造任何代价和提供任何线索。你甚至可以跳过告诉善良阵营「巫师已经完成了许愿」，或者告诉他们，");
    g_tipLine[14642] = StringToText("  但不提供任何线索。");
    g_tipLine[14643] = StringToText("如果你认为这个愿望对善良阵营有着十分明显的能力劣势，严重打破了善良和邪恶阵营的平衡，");
    g_tipLine[14644] = StringToText("  例如善良阵营即使找到恶魔也不可能获胜，你可以改变游戏规则或改变这个愿望，来制造一个对善良阵营公平的游戏。");
    g_tipLine[14645] = StringToText("如果你认为这个愿望对善良阵营有着十分明显的信息劣势，比如他们因愿望缺失了获胜游戏的关键信息，");
    g_tipLine[14646] = StringToText("  给他们一个有帮助的线索来让他们发现巫师的愿望是什么。");
    g_tipLine[14647] = StringToText("如果你认为这个愿望非常极端或难以理解，以致于你想不到任何线索或代价来平衡它，又或者这个愿望会让这个游戏变得无趣，");
    g_tipLine[14648] = StringToText("  拒绝这个愿望。");
    g_tipLine[14649] = StringToText("总得来说，这个愿望应当以巫师的喜好来一定程度上扭转游戏的局势，但也要同时给予善良阵营合理的获胜机会和条件。");
    g_tipLine[14650] = StringToText("  慢慢思考，给出合适的代价和线索。不着急，你会慢慢地熟悉怎么做的。");
    g_tipLine[14651] = StringToText("有关巫师与平衡的更多设计理念，请参考阅读：有关说书人的创造力--有趣的巫师");
    g_tipLine[14652] = StringToText("【提示标记】");
    g_tipLine[14653] = StringToText("· ？（共2枚）");
    g_tipLine[14654] = StringToText("巫师的提示标记的放置时机与条件，以及何时移除，完全取决于说书人以及巫师的愿望是什么。");
    g_tipLine[14655] = StringToText("【提示与技巧】");
    g_tipLine[14656] = StringToText("· 立刻许愿！越早许愿，越早生效！开始随心所欲地破坏这个小镇吧！");
    g_tipLine[14657] = StringToText("· 等几天再决定许什么样的愿望才能对你的阵营更有帮助。这可以隐藏在场的巫师，让善良阵营怀疑其他爪牙在场。");
    g_tipLine[14658] = StringToText("  一个游戏后期的愿望可以更有针对性地对善良阵营造成最大的伤害。");
    g_tipLine[14659] = StringToText("· 作为一个成熟的巫师，要知道你的愿望会产生巨大影响！如果你的愿望无比强大，你应该预测到他会带来沉重的代价！");
    g_tipLine[14660] = StringToText("  如果你的愿望大体上是不影响游戏平衡的，说书人可能不会设定代价或提供信息。");
    g_tipLine[14661] = StringToText("· 在开始游玩有巫师的剧本前，开启你的头脑风暴！如果你抽到了巫师，你将许下什么愿望！");
    g_tipLine[14662] = StringToText("  这可能会让巫师在将要许愿的时候没那么大压力。");
    g_tipLine[14663] = StringToText("· 如果你的主要目的是让邪恶阵营赢下这局游戏，许下一个能通过错误信息或能力干扰的方式帮助你的阵营的愿望！");
    g_tipLine[14664] = StringToText("· 如果你的主要目的是让游戏变得更加有趣，许下一个疯狂的愿望！这虽然可能不会帮你的阵营赢下这局游戏，");
    g_tipLine[14665] = StringToText("  但一定会把这局游戏变得刺激且印象深刻！");
    g_tipLine[14666] = StringToText("· 做好准备，说书人可能会宣布巫师已经完成了许愿，还可能附带着意料之外的线索。假装表现得十分惊讶巫师是在场的，");
    g_tipLine[14667] = StringToText("  来让其他玩家无法发现你提前知道它会发生。");
    g_tipLine[14668] = StringToText("· 帮助善良阵营弄清楚线索意味着什么。如果你看起来十分真诚努力地分析巫师的愿望，善良阵营更可能会相信你，");
    g_tipLine[14669] = StringToText("  你说的话也会被当成是真话。");
    g_tipLine[14670] = StringToText("· 假装帮助善良阵营分析线索代表的意义，但引导他们去往错误的结论。如果你真诚努力地尝试分析巫师的愿望，");
    g_tipLine[14671] = StringToText("  并且为善良玩家提供了一种可能的解释，他们会花费更多的时间讨论你编造的瞎话，剩余去找谁是恶魔的时间只会更少。");
    g_tipLine[14672] = StringToText("· 如果你不介意善良阵营发现愿望是什么，让善良阵营把注意力放在巫师和他的愿望上。");
    g_tipLine[14673] = StringToText("  让玩家同时分析愿望并且找到恶魔是非常困难的，所以如果他们把时间花费在分析愿望是什么的时候，");
    g_tipLine[14674] = StringToText("  他们花费在找恶魔上的时间就少了。");
    g_tipLine[14675] = StringToText("  · 如果你的愿望类似于，每个镇民都会获得错误信息，善良阵营如果知道了愿望是什么，会对你很不好，");
    g_tipLine[14676] = StringToText("    因为他们可以反向分析他们的信息来找到恶魔。如果分析出你的愿望会帮助他们获胜，不要帮助他们！");
    g_tipLine[14677] = StringToText("  · 如果你的愿望类似于，一名善良玩家会中毒直到游戏结束，这很适合让善良阵营把时间花在分析这个愿望上！");
    g_tipLine[14678] = StringToText("    当他们意识到一个玩家是中毒的，他们没有方法验证谁是中毒的，所以他们会花费更多时间在担心谁的能力没有正常生效。");
    g_tipLine[14679] = StringToText("    如果分析出你的愿望能够让善良阵营自乱阵脚，花费更多时间讨论愿望，你当然要帮助他们！");
    g_tipLine[14680] = StringToText("· 和说书人一起制作或完善你的愿望，尊重说书人可能给出的代价和线索。你作为一个有一定信息的玩家个体，");
    g_tipLine[14681] = StringToText("  说书人对于整个游戏局面掌握着更多的信息，更能给出合适的代价或信息来平衡你的愿望。");
    g_tipLine[14682] = StringToText("· 把你的愿望告诉你的邪恶同伴！如果其他邪恶玩家知道即将发生什么，他们可以把你的恶作剧作为他们伪装成其他角色的关键部");
    g_tipLine[14683] = StringToText("  分！");
    g_tipLine[14684] = StringToText("· 和你的队友讨论后，许下你们达成一致的愿望。弄明白什么角色在场以及你的愿望如何影响在场的角色。");
    g_tipLine[14685] = StringToText("· 特立独行！有创意的愿望更有可能被说书人所实现，而想要平衡这些愿望对说书人来说更有难度，");
    g_tipLine[14686] = StringToText("  因为说书人不太可能没有对你的奇思妙想做好准备。");
    g_tipLine[14687] = StringToText("· 大道至简！简单的愿望可以非常强，尤其是如果它在适当的时间生效。在我们测试巫师的对局之中，");
    g_tipLine[14688] = StringToText("  有些愿望给游戏带来了无与伦比的激烈和趣味，例如「让每个玩家都获得修补匠的能力」");
    g_tipLine[14689] = StringToText("  和「让说书人公开宣布巫师已经完成了许愿」。");
    g_tipLine[14690] = StringToText("· 谨小慎微！如果你看起来像一个善良玩家，帮助邪恶阵营获得善良玩家的信任！");
    g_tipLine[14691] = StringToText("· 身先士卒！制造尽可能多的混乱，分散善良玩家的注意力！只要你的愿望已经被实现了，他的效果就会一直存在于游戏之中，");
    g_tipLine[14692] = StringToText("  即使你已死亡！");
    g_tipLine[14693] = StringToText("【对抗巫师】");
    g_tipLine[14694] = StringToText("· 仔细分析说书人宣布或做的不寻常的事情——他可能是巫师愿望的线索，对你分析发生了什么可能起到一定帮助。");
    g_tipLine[14695] = StringToText("  · 利用线索来让自己获利！如果说书人公开宣布有一个修补匠的能力在场，假装自己随时可能死亡。如果你的角色发生了变化，");
    g_tipLine[14696] = StringToText("    寻找其他也发生角色变化的玩家。多讨论你的所见所想，尝试分析这个线索意味着什么。");
    g_tipLine[14697] = StringToText("  · 你可能没有意识到说书人的一些话是巫师的线索。多花一些时间仔细地思考说书人不寻常的话语和行为，但别花太多。");
    g_tipLine[14698] = StringToText("· 在游戏的前期，可以花费大量的时间精力在巫师的愿望上，但记住，作为一个善良玩家，你的最终目标是处决恶魔。");
    g_tipLine[14699] = StringToText("  在游戏的后期，不要花费太多的时间在巫师的愿望上，这会让你偏离游戏的获胜目标。");
    g_tipLine[14700] = StringToText("· 相信说书人会给巫师的愿望制定一个合适的代价或公开宣布一个合适的线索。");
    g_tipLine[14701] = StringToText("  · 如果你认为说书人没有公平地平衡巫师的愿望，在游戏结束后私下与说书人讨论这个问题。");
    g_tipLine[14702] = StringToText("  · 如果你在和说书人讨论游戏的体验和你个人的想法，专注于体验和想法本身，不要攻击说书人和他所做出的决定。");
    g_tipLine[14703] = StringToText("· 享受游戏！如果你期待一个常规的《染·钟楼谜团》游戏对局，你可能会对一个混乱的愿望感到不满或措手不及。");
    g_tipLine[14704] = StringToText("  放下你对一些可能发生的事情的期望，专注于任何线索或非常规的恶作剧，来帮助你的阵营弄明白正在发生什么！");
    g_tipRoleAt[98] = 14603; g_tipRoleN[98] = 102; g_tipP1At[98] = 14605; g_tipP1N[98] = 15; g_tipP2At[98] = 0; g_tipP2N[98] = 0;
    g_tipAbility[98] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着代价和线索。");
    g_tipLine[14705] = StringToText("【背景故事】");
    g_tipLine[14706] = StringToText("「你不会想要侮辱哥布林的。你真的，真的不会。让我们换个话题……我能再吃一块蛋糕吗？」");
    g_tipLine[14707] = StringToText("【角色能力】");
    g_tipLine[14708] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipLine[14709] = StringToText("【角色简介】");
    g_tipLine[14710] = StringToText("哥布林会在小镇明知他是哥布林却要处决他时采取报复。");
    g_tipLine[14711] = StringToText("· 如果哥布林被处决，邪恶阵营获胜。");
    g_tipLine[14712] = StringToText("· 为了让这种情况发生，哥布林需要在被提名后，开始投票前告知其他玩家他是哥布林。他的公开宣言需要让所有人都听见，");
    g_tipLine[14713] = StringToText("  因为善良玩家必须清楚自己接下来的行为所带来的风险。");
    g_tipLine[14714] = StringToText("· 如果哥布林没有公布自己的角色就被处决了，那么哥布林死亡，游戏如常进行。");
    g_tipLine[14715] = StringToText("· 哥布林必须在被处决的当天宣布自己的角色，只有这样他的能力才会生效。在前一天或更早的时间里宣布不会产生效果。");
    g_tipLine[14716] = StringToText("· 任何玩家都可以在被提名时声称自己是哥布林。");
    g_tipLine[14717] = StringToText("【范例】");
    g_tipLine[14718] = StringToText("小黑是哥布林。小艾提名了小黑，随后小黑宣称自己是哥布林。投票随后被统计，小黑「即将被处决」。");
    g_tipLine[14719] = StringToText("  随后又有一些其他的提名被发起，但最终小黑被处决了。邪恶阵营获胜。");
    g_tipLine[14720] = StringToText("小莱是艺术家，但在被提名时宣称自己是哥布林。小莱被处决，游戏继续。");
    g_tipLine[14721] = StringToText("道哥是哥布林。他在前面几天都宣称自己是哥布林，但在最新的一天里没有这么做。他被处决了。游戏继续。");
    g_tipLine[14722] = StringToText("【运作方式】");
    g_tipLine[14723] = StringToText("如果哥布林在被提名后，投票开始前宣称自己是哥布林，复述他的发言以便让所有玩家都能清楚听见。将「已宣称」");
    g_tipLine[14724] = StringToText("  提示标记放置在哥布林的角色标记旁。");
    g_tipLine[14725] = StringToText("如果哥布林在被处决时带有「已宣称」标记，宣布邪恶阵营获胜。");
    g_tipLine[14726] = StringToText("如果一名不是哥布林的玩家宣称自己是哥布林，如常进行相关操作。向所有玩家宣布他宣称自己是哥布林，");
    g_tipLine[14727] = StringToText("  并假装在魔典中移动提示标记。");
    g_tipLine[14728] = StringToText("【提示标记】");
    g_tipLine[14729] = StringToText("· 已宣称");
    g_tipLine[14730] = StringToText("放置时机：在哥布林被提名后，开始投票前，哥布林宣称自己是哥布林时放置。");
    g_tipLine[14731] = StringToText("放置条件：如果哥布林清醒健康，则将此标记放置在哥布林的角色标记旁。");
    g_tipLine[14732] = StringToText("移除时机：在黄昏时。");
    g_tipLine[14733] = StringToText("【规则细节】");
    g_tipLine[14734] = StringToText("· 相克规则：");
    g_tipLine[14735] = StringToText("  · 瘟疫医生：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[14736] = StringToText("  · 洗脑师：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[14737] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14738] = StringToText("  · 戏子：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[14739] = StringToText("  · 戏子（改）：戏子（改）无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[14740] = StringToText("  · 姑获鸟：姑获鸟无法获得哥布林的能力。");
    g_tipLine[14741] = StringToText("【提示与技巧】");
    g_tipLine[14742] = StringToText("· 哥布林有一件事情，并且只有一件事情要做——让小镇卸下他的伪装并处决他！只要你能成功地让小镇解决你，");
    g_tipLine[14743] = StringToText("  那就可以不择手段！");
    g_tipLine[14744] = StringToText("· 宣称你是哥布林！当你这样做时，你几乎是完全透露了你的阵营和角色，所以也许最好等到你确实面临处决的威胁时才这么做，");
    g_tipLine[14745] = StringToText("  但那之后就放手一搏吧！如果你不这么做，你就没有任何能力，而这么做能让你把善良阵营踢出局。");
    g_tipLine[14746] = StringToText("· 为了被处决而获胜，你需要让自己看起来像是恶魔而不是你公开宣称的角色。");
    g_tipLine[14747] = StringToText("  试着从游戏开始就像个恶魔一样行事来增长这种态势。");
    g_tipLine[14748] = StringToText("· 由于其公开宣称的性质，哥布林是一个更聒噪的爪牙——相比起那些尽可能贼眉鼠眼的同伙而言。");
    g_tipLine[14749] = StringToText("  传播关于镇民的绝对谎言（「我听到了两个其他占卜师的宣称，所以我认为你只是在说谎！」），");
    g_tipLine[14750] = StringToText("  对不同的人做出不同的角色宣称（「啥！我从来没有向张三宣称是筑梦师；我一直是侍女！」），");
    g_tipLine[14751] = StringToText("  并且尽你所能地制造尽可能多的混乱（「每个人都知道三个外来者在游戏中，所以我们一定有个巡山人！」）。");
    g_tipLine[14752] = StringToText("  他们打算对此作何反应？处决你？");
    g_tipLine[14753] = StringToText("· 如果你过于倾向混乱并宣称自己是哥布林，那人们可能会相信你是哥布林，这很糟糕，");
    g_tipLine[14754] = StringToText("  因为他们可能不会处决你并停止听取你有用的提示！转而尽量鬼祟而机敏可能会显得更谨慎，");
    g_tipLine[14755] = StringToText("  手握一个强大的角色伪装并以此为理由不想被小镇杀死——宣称是哥布林会导致与小镇的一些不和，");
    g_tipLine[14756] = StringToText("  将之作为在他们跟进处决前的一些语言挣扎，因为许多角色都有理由不想死亡。送葬者、");
    g_tipLine[14757] = StringToText("  博学者或是食人族都是希望尽可能延长生命的良好示例，即使小镇认为他们可疑。");
    g_tipLine[14758] = StringToText("· 不要忘记为了让你的能力被计入，你必须在每次被提名时公开宣称！哥布林不受类似他们洗脑师兄弟导致的疯狂的影响——你直");
    g_tipLine[14759] = StringToText("  视镇民，并让他们直面你的威胁。");
    g_tipLine[14760] = StringToText("· 试着说服小镇你是一个恶魔！几乎在所有情况下，爪牙都是不必处决的妨碍者——如果一个可疑的邪恶爪牙宣称是哥布林，");
    g_tipLine[14761] = StringToText("  小镇可能会退却。然而，如果他们怀疑你是「恶魔」，那他们并无选择只能试图在某个时刻处决你！");
    g_tipLine[14762] = StringToText("  鼓励你的邪恶队友利用他们的伪装审判你来让你的伪装看起来可信……甚至过分可信？");
    g_tipLine[14763] = StringToText("· 鼓励其他玩家宣称是哥布林，无论他们是善良还是邪恶！其他邪恶的爪牙比如投毒者可以使用这个宣称来延长自己的生命（任何");
    g_tipLine[14764] = StringToText("  人都可以宣称是哥布林，进行宣称并不需要哥布林在场！），同时善良玩家也可以使用哥布林宣称在一两日内阻挡控诉，");
    g_tipLine[14765] = StringToText("  以确保能他们能获得更多的信息……甚至可以看起来像是一个角色孤注一掷存活下去仅仅是为了被恶魔杀死！");
    g_tipLine[14766] = StringToText("  对真正的哥布林而言，这样的情况对他的好处是如果小镇上的每个人都宣称自己是哥布林变成了一种新的时尚趋势，");
    g_tipLine[14767] = StringToText("  那最后当轮到「你」挨剁而宣称是哥布林时，整个团队可能弥漫着一种虚假的安全感！");
    g_tipLine[14768] = StringToText("· 试着让小镇以善意的原因处决你（比如让送葬者检查你的能力）会与你进行哥布林宣称产生冲突。");
    g_tipLine[14769] = StringToText("  但不要沮丧——如果小镇认为你是反对他们以这个理由杀死你，而仅仅以宣称哥布林来威慑他们，那这个方案就能奏效。");
    g_tipLine[14770] = StringToText("  当你以这种方式获胜时，他们脸上显露的表情会让你相当满意！");
    g_tipLine[14771] = StringToText("· 当心厨师或是钟表匠或其他类似的角色！如果小镇相信你是哥布林，他们可以利用你的存在来追踪你的恶魔！");
    g_tipLine[14772] = StringToText("  （亦或者在较多人数的游戏中，如果你离其他邪恶阵营同伴都很远，你也可以故意引导到这种追踪上，");
    g_tipLine[14773] = StringToText("  以让小镇花费时间处决你的邻近玩家而不是恶魔！）");
    g_tipLine[14774] = StringToText("· 哥布林说到底是一个非常社交属性（译者注：能力很依赖于沟通而不是自己的操作）的爪牙，");
    g_tipLine[14775] = StringToText("  因此保持对小镇最新变化的了解至关重要——在几乎所有情况下，你都希望动摇他们对你的认知到对立阵营。");
    g_tipLine[14776] = StringToText("  如果小镇认为你是善良的，他们就几乎没有理由会处决你——试着出现几次「疏漏」以提供他们怀疑你的理由！类似的，");
    g_tipLine[14777] = StringToText("  如果他们认为你是邪恶的而你又不加否认，小镇可能会把你当作哥布林——开始拼命努力说服他们你是善良的吧！");
    g_tipLine[14778] = StringToText("  这一切都是为了让你的阵营定位到达「宣称是哥布林，但是我们不相信这点并且我们想继续处决你」的理想状态。");
    g_tipLine[14779] = StringToText("  其中创造的所有混乱只是为了奖励的有趣！");
    g_tipLine[14780] = StringToText("· 如果你是另一个邪恶角色，尤其是恶魔，那就宣称是哥布林吧！在没有其他方案的情况下这是一个很好的备选方案，");
    g_tipLine[14781] = StringToText("  但愿能恐吓到善良阵营不处决你，至少在一两天内。");
    g_tipLine[14782] = StringToText("【对抗哥布林】");
    g_tipLine[14783] = StringToText("· 你最大的问题不是哥布林，而是恶魔宣称是哥布林。这是一个可以防止被处决的绝妙防护，");
    g_tipLine[14784] = StringToText("  哥布林角色迫使你的阵营加倍地斟酌关于谁是恶魔的结论，因为一旦你们错了，游戏就结束了。");
    g_tipLine[14785] = StringToText("· 如果一名玩家宣称是哥布林，而你无法确定他们是否是哥布林，那就先不要处决他们！因为处决的风险太高了。");
    g_tipLine[14786] = StringToText("  至少在这一刻是如此……");
    g_tipLine[14787] = StringToText("· 尽可能地使用任何可能的信息来区分哥布林宣称的真伪：占卜师、猎手、舞蛇人或驱魔人都对是否对哥布林作出扣下扳机的决定");
    g_tipLine[14788] = StringToText("  有极大助益。");
    g_tipLine[14789] = StringToText("· 记住，哥布林的能力只有在他在被提名时公开宣称才能生效。如果你的提名对象没有宣称是哥布林，");
    g_tipLine[14790] = StringToText("  那你就没必要担心哥布林可能获胜。");
    g_tipLine[14791] = StringToText("· 如果一名玩家宣称是哥布林，花点时间与善良阵营合作来查明他们的真实角色。那些能够得知阵营或角色的角色，比如送葬者、");
    g_tipLine[14792] = StringToText("  占卜师、筑梦师、调查员或城镇公告员都能帮上忙。即便是得到那些诸如谁是谁的次要信息，比如来自侍女或是贤者的，");
    g_tipLine[14793] = StringToText("  也会有帮助。当你有足够的信息来判断一名玩家是否真的是哥布林时，你就能相应地决定是否处决他。");
    g_tipLine[14794] = StringToText("· 你可以作为善良玩家宣称是哥布林……但你需要一个特别合适的理由来这么做。");
    g_tipLine[14795] = StringToText("  有可能是你确实必须存活来完成你作为镇民的信息体系，这是一个值得如此做的宣称，但在对邪恶阵营提供了强力掩护之后，");
    g_tipLine[14796] = StringToText("  你重建信任的道路将会十分艰难。");
    g_tipLine[14797] = StringToText("· 在游戏的早期随意地提名以求尽快揭露哥布林。此时哥布林玩家可能还没有充分的时间拟定好策略，");
    g_tipLine[14798] = StringToText("  并在他们确定宣称哥布林是否明置之前就宣称自己是哥布林。");
    g_tipLine[14799] = StringToText("· 如果游戏中仅有一个爪牙，那等到最后一天才杀死哥布林。在这个时期，存活的玩家应当是恶魔、哥布林与一名善良玩家。");
    g_tipLine[14800] = StringToText("  这仍然给予了你杀死恶魔的机会，或者杀死宣称自己是哥布林而你认为是恶魔的那名玩家。");
    g_tipLine[14801] = StringToText("· 如果游戏中多于一个爪牙，那在最后一天来临前杀死宣称哥布林的玩家。或者如果你没做到，");
    g_tipLine[14802] = StringToText("  那至少要确保所有其他爪牙都死亡。如果游戏到此时存活的三名玩家是恶魔、哥布林和另一个爪牙，那邪恶阵营就获胜了。");
    g_tipLine[14803] = StringToText("· 如果你百分百地确信宣称是哥布林的玩家确实是哥布林，那这对善良阵营也是个好消息。假设哥布林玩家说的是真话，");
    g_tipLine[14804] = StringToText("  然后使用这个信息去寻找恶魔。注意哥布林说的其他信息，注意哥布林和谁说话。");
    g_tipLine[14805] = StringToText("  注意那些能获得关于爪牙的信息的角色的信息，比如调查员、厨师、钟表匠或送葬者，");
    g_tipLine[14806] = StringToText("  可以同时确认哪些角色获得了良好的信息以及这些信息指向的恶魔是谁。");
    g_tipLine[14807] = StringToText("· 如果你认为一名宣称是哥布林的玩家其实是善良的而仅仅是不想被处决，那你也宣称自己是哥布林。");
    g_tipLine[14808] = StringToText("  如果你在被提名时宣称得很有说服力，然后说另一个哥布林宣称是虚假的，");
    g_tipLine[14809] = StringToText("  那么那名善良玩家可能就会承认自己是另一个不同的角色——他们真实的善良角色——而不再宣称是哥布林。");
    g_tipLine[14810] = StringToText("  因为真正的哥布林很难做到这点，所以你已经找到了另一名善良玩家。");
    g_tipLine[14811] = StringToText("· 以哥布林的名义让自己免于被处决。如果你真的不想被处决，那么就在你被提名时宣称是哥布林。");
    g_tipLine[14812] = StringToText("  你可以告诉团队你宣称哥布林只是为了让他们不处决你，然后直接宣称你真正的角色。有时候，");
    g_tipLine[14813] = StringToText("  欺骗善良阵营一小段时间是值得的，这样你就可以多存活几天。如果你每天都能得到重要信息，比如博学者或者卖花女孩，");
    g_tipLine[14814] = StringToText("  那么这种方案效果会很棒，但对那些还有能力可用的角色也很棒，比如猎手或者镇长。");
    g_tipLine[14815] = StringToText("· 如果其他方案都行不通，那就处决宣称是哥布林的玩家。他们可能有望、可能、大概在撒谎。");
    g_tipLine[14816] = StringToText("  如果你处决了一名宣称是哥布林的玩家而游戏仍在继续，那他们就不是哥布林！整个团队现在都知道了一些有用的信息！");
    g_tipLine[14817] = StringToText("  这太棒了！");
    g_tipRoleAt[99] = 14705; g_tipRoleN[99] = 113; g_tipP1At[99] = 14707; g_tipP1N[99] = 10; g_tipP2At[99] = 14733; g_tipP2N[99] = 8;
    g_tipAbility[99] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营获胜。");
    g_tipLine[14818] = StringToText("【背景故事】");
    g_tipLine[14819] = StringToText("「美味，美味，美味，美味，美味，美味，美味，美味的脑——馅儿饼！是的。美味的老馅儿饼。我想说的就是这个。」");
    g_tipLine[14820] = StringToText("【角色能力】");
    g_tipLine[14821] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，");
    g_tipLine[14822] = StringToText("  只有当他处于死亡状态时你才会立即死亡。");
    g_tipLine[14823] = StringToText("【角色简介】");
    g_tipLine[14824] = StringToText("痢蛭在宿主存活时存活，在宿主死亡时死亡。");
    g_tipLine[14825] = StringToText("· 在首个夜晚，痢蛭会选择一名玩家，被选择的玩家会在游戏的剩余时间内都处于中毒状态。");
    g_tipLine[14826] = StringToText("· 如果这名玩家存活，痢蛭就不会死亡。如果痢蛭被处决，说书人会告诉大家这名玩家仍然存活，但不会说明原因。");
    g_tipLine[14827] = StringToText("· 如果这名首夜被痢蛭选择的玩家死亡，痢蛭也会死亡。如果此时只剩一名或两名玩家存活，那么善良阵营还是会获胜，");
    g_tipLine[14828] = StringToText("  因为恶魔死亡了。");
    g_tipLine[14829] = StringToText("· 从第二个夜晚开始，痢蛭会攻击并杀死玩家，但不会让他中毒。");
    g_tipLine[14830] = StringToText("· 如果痢蛭在游戏过程中被创造，他会在当晚令一名玩家中毒。他必须要选择一名存活的玩家。");
    g_tipLine[14831] = StringToText("【范例】");
    g_tipLine[14832] = StringToText("痢蛭让贵族中毒。贵族得知了三名善良玩家，而不是一名邪恶和两名善良玩家。痢蛭被处决，但没有死亡。第二个白天，");
    g_tipLine[14833] = StringToText("  贵族被处决。贵族和痢蛭死亡。善良阵营获胜。");
    g_tipLine[14834] = StringToText("痢蛭让农夫中毒。侍臣让痢蛭醉酒。精神病患者杀死了农夫，但痢蛭没有死亡，因为痢蛭没有能力。随后痢蛭被处决并死亡。");
    g_tipLine[14835] = StringToText("【运作方式】");
    g_tipLine[14836] = StringToText("在首个夜晚，唤醒痢蛭。让痢蛭指向任意一名玩家。被他选择的玩家中毒——将「中毒」");
    g_tipLine[14837] = StringToText("  提示标记放置在被选择的玩家角色标记旁。让痢蛭重新入睡。");
    g_tipLine[14838] = StringToText("除首个夜晚以外的每个夜晚，唤醒痢蛭。让痢蛭指向任意一名玩家。被选择的玩家死亡——在那名玩家的角色标记旁放置痢蛭的");
    g_tipLine[14839] = StringToText("  「死亡」提示标记并放置帷幕标记。让痢蛭重新入睡。");
    g_tipLine[14840] = StringToText("如果痢蛭即将死去，但是被痢蛭的「中毒」提示标记的玩家仍然存活，痢蛭不会死亡。如果标记了痢蛭的「中毒」");
    g_tipLine[14841] = StringToText("  提示标记的玩家死亡，那么痢蛭死亡，善良阵营获胜。");
    g_tipLine[14842] = StringToText("当向中毒的善良玩家提供错误信息时，请确保这个信息看起来是正确的。如果这名善良玩家认为这个信息是错误的，");
    g_tipLine[14843] = StringToText("  他会迅速处决自己并获胜。");
    g_tipLine[14844] = StringToText("【提示标记】");
    g_tipLine[14845] = StringToText("· 中毒");
    g_tipLine[14846] = StringToText("放置时机：在痢蛭首个夜晚行动并选择了一名存活的玩家后。");
    g_tipLine[14847] = StringToText("放置条件：痢蛭选择的玩家能因痢蛭而中毒，且痢蛭未醉酒中毒，那么在该玩家的角色标记旁放置痢蛭的中毒标记。");
    g_tipLine[14848] = StringToText("  如果上述情况不满足，仍然需要放置该标记，但将该标记倒转放置，代表该提示标记没有任何效果，");
    g_tipLine[14849] = StringToText("  用于标记该玩家被痢蛭选择过。（因为当痢蛭恢复清醒健康后，该名玩家仍然会成为宿主。）");
    g_tipLine[14850] = StringToText("移除时机：痢蛭死亡或离场时移除。");
    g_tipLine[14851] = StringToText("· 死亡");
    g_tipLine[14852] = StringToText("放置时机：在痢蛭夜晚行动并选择了玩家后放置。");
    g_tipLine[14853] = StringToText("放置条件：痢蛭选择的玩家当前存活，且能被痢蛭杀死，且痢蛭未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[14854] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[14855] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[14856] = StringToText("【规则细节】");
    g_tipLine[14857] = StringToText("· 当痢蛭醉酒或中毒时，宿主恢复健康。如果宿主在这个期间死亡，痢蛭不会受到影响，当痢蛭恢复清醒/健康后会立即死亡。");
    g_tipLine[14858] = StringToText("  如果痢蛭在醉酒或中毒时死亡，他死亡，因为他的能力在醉酒/中毒时无法阻止死亡。如果痢蛭的宿主醉酒/中毒，");
    g_tipLine[14859] = StringToText("  对痢蛭没有影响。");
    g_tipLine[14860] = StringToText("· 痢蛭仍然是恶魔，宿主仍然是他相应的角色类型，痢蛭对宿主的选择不会对他的角色产生任何改变。注意，");
    g_tipLine[14861] = StringToText("  宿主可以是任何存活玩家，不管是什么角色类型。");
    g_tipLine[14862] = StringToText("· 特定角色互动：");
    g_tipLine[14863] = StringToText("  · 驱魔人：如果痢蛭在他的首个夜晚之后被驱魔，他不会醒来，但宿主仍然中毒，并且除非宿主死亡，痢蛭不会死。");
    g_tipLine[14864] = StringToText("    如果痢蛭在游戏过程中被创造，因为痢蛭的「选择玩家让他中毒」的能力属于进场能力且不属于信息类能力，");
    g_tipLine[14865] = StringToText("    所以该能力会尽可能快地进行结算，从而使得在轮到驱魔人行动时，如果驱魔人选中了痢蛭，");
    g_tipLine[14866] = StringToText("    也不会因为「痢蛭无法因为自己的能力被唤醒」而导致「痢蛭没有宿主」的情况出现。");
    g_tipLine[14867] = StringToText("  · 士兵：如果士兵被痢蛭选为宿主，他不会中毒。然而，如果他因为任何原因死亡（被处决，半兽人等等），痢蛭也会死亡。");
    g_tipLine[14868] = StringToText("  · 莽夫：如果莽夫在首个夜晚被选为宿主，这会使得痢蛭醉酒直到下个黄昏，并且莽夫变为邪恶。如果莽夫在首个白天被处决，");
    g_tipLine[14869] = StringToText("    痢蛭仍然会死亡，因为莽夫的醉酒效果由于莽夫的死亡而消失了。莽夫在整局游戏中都不会因为痢蛭的能力中毒（可以将痢蛭的");
    g_tipLine[14870] = StringToText("    中毒标记倒转放置在莽夫的角色标记旁，仅做寄生的提示用），但如果他死亡，痢蛭也会死亡。");
    g_tipLine[14871] = StringToText("  · 疯子：如果疯子自认为是痢蛭，真正的恶魔会被告知疯子在首个夜晚选择谁作为宿主，但是，举例来说，");
    g_tipLine[14872] = StringToText("    这与疯子自认为是普卡并在首个夜晚做出选择没有什么区别——真正的恶魔不会知道这里面的区别。");
    g_tipLine[14873] = StringToText("  · 麻脸巫婆：如果创造出新的恶魔，仍然需要杀死宿主才能杀死痢蛭，麻脸巫婆不能无视痢蛭免死的能力。");
    g_tipLine[14874] = StringToText("  · 旅行者：可以被选为宿主，但不建议。因为如果旅行者离开，他死亡，并且痢蛭因此死亡。");
    g_tipLine[14875] = StringToText("  · 咖啡师：如果咖啡2不是在首个夜晚，痢蛭可以杀害两次。如果咖啡2在首个夜晚，痢蛭选择两名玩家，");
    g_tipLine[14876] = StringToText("    从现在开始他们两个都中毒。无论如何，必须这两名玩家都死亡，痢蛭才会死亡。");
    g_tipLine[14877] = StringToText("· 相克规则：");
    g_tipLine[14878] = StringToText("  · 猎手：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_tipLine[14879] = StringToText("  · 主谋：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[14880] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14881] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14882] = StringToText("  · 半仙：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[14883] = StringToText("  · 使节：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[14884] = StringToText("  · 掮客：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[14885] = StringToText("【提示与技巧】");
    g_tipLine[14886] = StringToText("· 尽早与你的爪牙沟通，并告诉他们你毒了谁。整个邪恶团队需要从一开始就进行良好的合作，才能让这个玩家保持活力。");
    g_tipLine[14887] = StringToText("  假设你把传教士变成了你的宿主，毒害了他们。你不仅可以不用再把他当做威胁，因为它们不会影响任何爪牙，");
    g_tipLine[14888] = StringToText("  而且你还需要积极地让主人活到最后。");
    g_tipLine[14889] = StringToText("· 毒你左右相邻的玩家之一，因为这样你就可以让你的宿主靠近并在你的拇指之下。你可以找出他们中毒的信息是什么，");
    g_tipLine[14890] = StringToText("  并尝试操纵游戏使其看起来合法，让他们不相信自己中毒了。");
    g_tipLine[14891] = StringToText("· 在圆圈的另一边给某人下毒，以尽可能远离你的注意力。");
    g_tipLine[14892] = StringToText("· 避免被处决。即使你不能死于处决，但了解恶魔是谁通常可以为善良阵营赢得比赛提供足够的信息。一旦玩家知道恶魔是痢蛭，");
    g_tipLine[14893] = StringToText("  他们可能会将你排除在讨论之外，并试图找出哪个善良玩家是宿主。");
    g_tipLine[14894] = StringToText("· 你选择谁作为你的宿主会对游戏产生很大的影响，而这你必须盲选。如果你选择了一个只在游戏开始时才获得信息的角色，");
    g_tipLine[14895] = StringToText("  他们可能真的很难弄清楚他们已经中毒了，让你更容易隐藏宿主。然而，他们更有可能因为各种原因而被处决，");
    g_tipLine[14896] = StringToText("  因为他们没有能力为游戏做出贡献。如果贵族是宿主，并且在大家同意的情况下处决他似乎有很多阻力，");
    g_tipLine[14897] = StringToText("  这会很强烈地表明他们是宿主。");
    g_tipLine[14898] = StringToText("· 如果只有3名玩家活着，被处决是一种安全的策略。因为宿主还活着，你会被处死，但不会死。然后游戏进入晚上，");
    g_tipLine[14899] = StringToText("  三个人活着，你可以杀死最后一个不是宿主的玩家。请注意，在这种情况下，不杀死宿主非常重要，否则你也会立即死亡。");
    g_tipLine[14900] = StringToText("  这创造了一个平局，意味着善良阵营胜利。");
    g_tipLine[14901] = StringToText("· 如果出于某种原因，大家处决的焦点在你的宿主身上，你可能需要小心地转移注意力。");
    g_tipLine[14902] = StringToText("  如果你大张旗鼓公开反对处决某一名玩家，这可能会让你看上去非常可疑。相反，也许只是指出其他玩家是一个非常好的目标，");
    g_tipLine[14903] = StringToText("  即使这意味着卖掉你一名爪牙。最好的策略是到达最后一天前你的宿主不要受太多怀疑。");
    g_tipLine[14904] = StringToText("· 在正常的恶魔局中，首要任务是保护恶魔不被杀死。在痢蛭局中，首要任务是制造尽可能多的错误信息来伪装宿主。这样，");
    g_tipLine[14905] = StringToText("  即使有人怀疑他们的信息，它也只是众多错误信息来源之一。");
    g_tipLine[14906] = StringToText("· 痢蛭可能特别棘手，因为实际上「团队」的成员之一是善良的。宿主与你不同阵营，而你无法控制他或他的中毒。");
    g_tipLine[14907] = StringToText("  向说书人建议给出因中毒的错误信息是完全可以的，但说书人可能不听你的。");
    g_tipLine[14908] = StringToText("· 如果邪恶阵营在游戏尾声占了上风，那么说书人可能会让宿主中毒信息变得非常混乱，以此来平衡，");
    g_tipLine[14909] = StringToText("  尤其是如果宿主出于某种原因在整个比赛中都没有受到关注，并且善良阵营甚至还没有发现这是一个痢蛭局。");
    g_tipLine[14910] = StringToText("【对抗痢蛭】");
    g_tipLine[14911] = StringToText("· 弄清楚痢蛭是否在游戏中。这些信息决定了你的游戏目标是什么，因为在你弄清目标之前，你不知道该处决哪些玩家。");
    g_tipLine[14912] = StringToText("  一旦你知道这是痢蛭局，那么关键是找到并杀死宿主。");
    g_tipLine[14913] = StringToText("· 找到中毒的玩家。如果每一个认为自己可能中毒的善良玩家都告诉所有人，");
    g_tipLine[14914] = StringToText("  那么善良阵营应该能够对痢蛭的目标是谁做出一些猜测。");
    g_tipLine[14915] = StringToText("  · 如果有人获得虚假信息：处决他们——他们可能是宿主，或者可能只是一个散布错误信息的爪牙。不亏！");
    g_tipLine[14916] = StringToText("  · 如果你认为你得到了虚假信息：自愿被处决以自证清白。");
    g_tipLine[14917] = StringToText("· 通过有信息的角色来验证其他玩家的信息，以尝试缩小中毒候选人的可能选择范围。请记住，只有一名玩家会因痢蛭中毒，");
    g_tipLine[14918] = StringToText("  并且不会改变。如果你可以验证一名玩家清醒且健康，则他不可能成为痢蛭的宿主。");
    g_tipLine[14919] = StringToText("· 如果根据你手上的信息，找不到任何合适的宿主可疑人选，请寻找似乎以奇怪的方式幸存下来的角色。");
    g_tipLine[14920] = StringToText("  对于找到隐藏的痢蛭宿主角色，以下是不错的选择：");
    g_tipLine[14921] = StringToText("  · 已确认的善良或在整个游戏中幸存下来的任何公开的高优先级目标角色，例如表明角色的气球驾驶员；或者");
    g_tipLine[14922] = StringToText("  · 一个似乎只是在挂机的开局信息角色，例如自游戏开始以来并没有真正做太多事情甚至自愿被处决的钟表匠；或者");
    g_tipLine[14923] = StringToText("  · 一个每场使用一次能力的角色，例如按照他们的提示采取行动的渔夫，但似乎没有多大作用。");
    g_tipLine[14924] = StringToText("· 不要忘记找出谁是邪恶玩家！虽然这不会直接赢得比赛，但处决恶魔仍然是很好的信息。更重要的是，");
    g_tipLine[14925] = StringToText("  恶魔不太可能选择自己的一个爪牙作为宿主，因此你可以排除掉爪牙作为处决对象。");
    g_tipLine[14926] = StringToText("· 通常痢蛭局少于其他恶魔局，如果你到最后一天仍不确定是不是痢蛭局，那么假设它不是痢蛭局通常更安全。");
    g_tipRoleAt[100] = 14818; g_tipRoleN[100] = 109; g_tipP1At[100] = 14820; g_tipP1N[100] = 11; g_tipP2At[100] = 14856; g_tipP2N[100] = 29;
    g_tipAbility[100] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，只有当他处于死亡状态时你才会立即死亡。");
    g_tipLine[14927] = StringToText("【背景故事】");
    g_tipLine[14928] = StringToText("「冰雹砸向了屋顶，将大教堂窗户的玻璃打得粉碎，然后融化进泥土里，就像沙漠里烈日下奄奄一息的羔羊。");
    g_tipLine[14929] = StringToText("  这就是疯子的寓言。」");
    g_tipLine[14930] = StringToText("【角色能力】");
    g_tipLine[14931] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipLine[14932] = StringToText("【角色简介】");
    g_tipLine[14933] = StringToText("异端分子能够转换胜负结果。");
    g_tipLine[14934] = StringToText("· 如果一局游戏会使得善良阵营获胜，异端分子会导致所有善良玩家落败，且邪恶玩家获胜。");
    g_tipLine[14935] = StringToText("· 如果一局游戏将由邪恶阵营获胜而结束，邪恶玩家落败，善良玩家获胜。");
    g_tipLine[14936] = StringToText("· 异端分子的能力会应用于所有的胜利条件，包括只剩两名非旅行者玩家存活，所有恶魔死亡，或一项能力导致的游戏结束。");
    g_tipLine[14937] = StringToText("· 异端分子的能力在他死亡时仍然正常生效，但在他醉酒中毒时不会生效。");
    g_tipLine[14938] = StringToText("【范例】");
    g_tipLine[14939] = StringToText("在第一个白天，异端分子声称自己是异端分子。当晚，恶魔杀死了自己。邪恶阵营获胜。");
    g_tipLine[14940] = StringToText("异端分子在最后一天前都没有揭示自己的角色。三名玩家存活，异端分子说服了善良阵营来处决一名善良玩家，");
    g_tipLine[14941] = StringToText("  让场上只有两名玩家存活，而其中一名玩家是恶魔。善良阵营获胜。");
    g_tipLine[14942] = StringToText("异端分子死亡了。随后，圣徒死于处决。善良阵营获胜。");
    g_tipLine[14943] = StringToText("异端分子中毒了。随后，刺客杀死了恶魔。善良阵营获胜。");
    g_tipLine[14944] = StringToText("异端分子在场，且当前只有三名玩家存活。随后，恶魔死于处决。邪恶阵营获胜。");
    g_tipLine[14945] = StringToText("【运作方式】");
    g_tipLine[14946] = StringToText("如果游戏结束且邪恶阵营即将获胜，宣布善良阵营获胜，邪恶阵营落败。");
    g_tipLine[14947] = StringToText("如果游戏结束且善良阵营即将获胜，宣布邪恶阵营获胜，善良阵营落败。");
    g_tipLine[14948] = StringToText("【提示标记】");
    g_tipLine[14949] = StringToText("无");
    g_tipLine[14950] = StringToText("【规则细节】");
    g_tipLine[14951] = StringToText("· 特定角色互动：");
    g_tipLine[14952] = StringToText("  · 食人族：（参考最新的处决流程整理）如果异端分子被处决并导致游戏结束，食人族不会获得异端分子的能力。");
    g_tipLine[14953] = StringToText("  · 将军：将军的信息应该将异端分子考虑在内。如果善良阵营已经非常接近找出并处决恶魔，但异端分子在场，");
    g_tipLine[14954] = StringToText("    因为处决恶魔会导致邪恶阵营获胜，所以应该展示邪恶更有优势。");
    g_tipLine[14955] = StringToText("  · 哲学家：如果哲学家选择异端分子，随后死亡，哲学家仍然保留这个能力，因为那是「死后能力保留」的能力。然而，");
    g_tipLine[14956] = StringToText("    原始异端分子也会在哲学家死亡时恢复清醒，这意味着游戏中有两个正常生效的异端分子能力。");
    g_tipLine[14957] = StringToText("  · 镜像双子：异端分子的能力只有在游戏因为满足某个胜利条件而结束的时候才会生效。");
    g_tipLine[14958] = StringToText("    所以镜像双子将会阻止因善良阵营获胜而结束游戏，但如果游戏因邪恶阵营获胜而结束，");
    g_tipLine[14959] = StringToText("    异端分子能力会生效并转为让善良阵营获胜。");
    g_tipLine[14960] = StringToText("· 相克规则：");
    g_tipLine[14961] = StringToText("  · 教父：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14962] = StringToText("  · 间谍：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14963] = StringToText("  · 寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14964] = StringToText("  · 麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14965] = StringToText("  · 痢蛭：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14966] = StringToText("  · 男爵：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14967] = StringToText("  · 科学怪人：恶魔无法拥有异端分子的能力。");
    g_tipLine[14968] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[14969] = StringToText("  · 狐媚娘：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[14970] = StringToText("【提示与技巧】");
    g_tipLine[14971] = StringToText("· 不惜一切代价让恶魔存活。通常，在非异端分子游戏中，善良团队可以在任何时候获胜（通过处决恶魔），");
    g_tipLine[14972] = StringToText("  而邪恶阵营只能在最后一天获胜（通过处决一名非恶魔玩家）。在异端分子游戏中，");
    g_tipLine[14973] = StringToText("  邪恶阵营可以在任何时候获胜（通过处决恶魔），而善良阵营只能在最后一天获胜（通过处决一名非恶魔玩家）。");
    g_tipLine[14974] = StringToText("· 让邪恶阵营得知有异端分子在场是极端危险的。如果恶魔相信你，他们可能会在夜晚自杀，落败，然后转为获胜。");
    g_tipLine[14975] = StringToText("  小心透露你自己。");
    g_tipLine[14976] = StringToText("· 如果你相信善良阵营正在溃败，那么最好永远不要向任何人透露你的角色。");
    g_tipLine[14977] = StringToText("· 考虑在游戏的最后一天作为异端分子现身。这很有风险，因为人们很可能不相信你，");
    g_tipLine[14978] = StringToText("  但总比让恶魔在夜晚自杀并立即让邪恶阵营获胜要好。如果你在只有三名玩家存活时大声宣称你是异端分子，");
    g_tipLine[14979] = StringToText("  无论你是否已经死亡，善良阵营也会知道他们需要处决一位非恶魔玩家来故意落败并转为获胜。");
    g_tipLine[14980] = StringToText("· 寻找能够确认你是异端分子的善良玩家，然后与他们合作谋划一场通常来说的落败。");
    g_tipLine[14981] = StringToText("· 试着寻找一名诸如侍臣这样有能力使你中毒或醉酒的善良玩家。这能使得善良阵营能够单纯为了胜利而战而不是时刻带着对落败");
    g_tipLine[14982] = StringToText("  的恐惧。");
    g_tipLine[14983] = StringToText("· 注意有特殊胜利能力的角色，例如镇长、呆瓜、圣徒、主谋或哥布林。如果你对是异端分子一事保持沉默，");
    g_tipLine[14984] = StringToText("  邪恶阵营可能会在不知不觉中给你带来优势。例如，如果哥布林被处决，善良阵营获胜，");
    g_tipLine[14985] = StringToText("  或是如果一名邪恶玩家伪装成镇长并说服团队在最后一天不处决，善良阵营获胜。");
    g_tipLine[14986] = StringToText("· 如果你认为善良阵营即将处决恶魔，那你将需要说服他们。你可以伪装成提供冲突信息的镇民角色，");
    g_tipLine[14987] = StringToText("  或是暗示他们处决这名玩家是一个非常糟糕的主意。作为最终手段，透露你是异端分子来劝阻他们——避免恶魔被处决肯定会避");
    g_tipLine[14988] = StringToText("  免落败，但恶魔可能会也可能不会在夜晚自杀。用可能（甚至只是也许）的落败来交换确定的落败会更好。");
    g_tipLine[14989] = StringToText("· 当只有三名玩家还存活时，可以安心地透露你是异端分子，因为比赛会在黄昏前结束。");
    g_tipLine[14990] = StringToText("  善良阵营可能会发现这是一个绝对关键的信息。");
    g_tipLine[14991] = StringToText("· 当只有四名玩家还存活时，也许可以安心地透露你是异端分子，因为游戏可能因为恶魔如常的攻击而在当晚结束。");
    g_tipLine[14992] = StringToText("  善良阵营可能会发现这是一个绝对关键的信息。然而，恶魔仍然会有机会杀死自己，所以要谨慎行事。");
    g_tipLine[14993] = StringToText("· 更聪明的做法是从不百分百地宣称自己是什么角色。举个例子，如果你宣称你是异端分子或月之子，");
    g_tipLine[14994] = StringToText("  那么善良阵营就会意识到异端分子可能在场，并相应地调整他们的策略，而恶魔并没有被说服到足以选择自杀来赢得游戏。");
    g_tipLine[14995] = StringToText("  或者如果你伪装成杂耍艺人，然后宣称自己是异端分子，然后伪装成舞蛇人，善良阵营也会得到异端分子有可能在场的提示，");
    g_tipLine[14996] = StringToText("  而恶魔也无法确定。与其他角色不同，模棱两可是你的朋友。只有当真正关键的时候如最后一天，");
    g_tipLine[14997] = StringToText("  才百分百坦率地宣称自己是异端分子。");
    g_tipLine[14998] = StringToText("· 你的死亡无关紧要。如果你被提名，除非你愿意否则没有必要为此辩护。如果恶魔在晚上杀了你，那也没问题。");
    g_tipLine[14999] = StringToText("  不要为存活下去而担忧。");
    g_tipLine[15000] = StringToText("· 你掌握着游戏的命运。极少角色拥有这种能力。记住你有多重要。所有其他镇民与外来者（攻略）");
    g_tipLine[15001] = StringToText("  都会写成鼓励你「想说什么说什么」的样子，因为即使犯错也不会终结游戏。例如，即使畸形秀演员透露了他的角色并被处决，");
    g_tipLine[15002] = StringToText("  游戏也会继续。即使占卜师透露了角色并在第二天死亡，游戏仍然继续。但是异端分子不同。");
    g_tipLine[15003] = StringToText("  异端分子的言论可以迅速彻底地左右善良阵营的命运。即使你是一个外来者，");
    g_tipLine[15004] = StringToText("  你仍然是游戏中最危险的善良玩家——对双方都是。");
    g_tipRoleAt[101] = 14927; g_tipRoleN[101] = 78; g_tipP1At[101] = 14930; g_tipP1N[101] = 8; g_tipP2At[101] = 14950; g_tipP2N[101] = 20;
    g_tipAbility[101] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipLine[15005] = StringToText("【背景故事】");
    g_tipLine[15006] = StringToText("「当心不要长久地凝视深渊，以免深渊也同样回望着你。」");
    g_tipLine[15007] = StringToText("【角色能力】");
    g_tipLine[15008] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，");
    g_tipLine[15009] = StringToText("  所有玩家都会得知你选择了新的玩家。");
    g_tipLine[15010] = StringToText("【角色简介】");
    g_tipLine[15011] = StringToText("恐惧之灵在提名中掺入猜疑。");
    g_tipLine[15012] = StringToText("· 在游戏的首个夜晚，恐惧之灵选择了一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[15013] = StringToText("· 在其他夜晚，每当恐惧之灵选择了与上次选择不同的一名玩家后，所有玩家都会得知这件事情。");
    g_tipLine[15014] = StringToText("  如果恐惧之灵选择的玩家与上一次选择的相同，玩家不会得知任何内容。");
    g_tipLine[15015] = StringToText("· 玩家只会得知恐惧之灵是否采取了行动，但不会得知恐惧之灵具体选择了哪一名玩家。");
    g_tipLine[15016] = StringToText("· 如果恐惧之灵提名了他当前选择的玩家，且该玩家因此被处决时，该玩家的阵营落败，游戏结束。");
    g_tipLine[15017] = StringToText("· 只有恐惧之灵当前选择的玩家会受到恐惧之灵的能力影响。他此前选择的玩家不会受到影响。");
    g_tipLine[15018] = StringToText("· 如果被选择的玩家被恐惧之灵提名并处决后没有死亡，他的阵营仍然会落败。");
    g_tipLine[15019] = StringToText("【范例】");
    g_tipLine[15020] = StringToText("在首个夜晚，恐惧之灵选择了管家。所有玩家得知恐惧之灵选择了新的目标。在下个白天，恐惧之灵提名了管家，管家被处决。");
    g_tipLine[15021] = StringToText("  邪恶阵营获胜。");
    g_tipLine[15022] = StringToText("夜晚，恐惧之灵选择了杂耍艺人。卖花女孩提名了杂耍艺人，杂耍艺人被处决。游戏没有因此结束，而是继续进行。");
    g_tipLine[15023] = StringToText("恐惧之灵选择了共情者。在下一个夜晚，恐惧之灵选择了士兵。恐惧之灵提名并处决了共情者。游戏继续进行，");
    g_tipLine[15024] = StringToText("  因为恐惧之灵当前选择的是士兵而非共情者。");
    g_tipLine[15025] = StringToText("因为罂粟种植者在场，恐惧之灵无意中选择了男爵。恐惧之灵提名并处决了男爵。善良阵营获胜。");
    g_tipLine[15026] = StringToText("【运作方式】");
    g_tipLine[15027] = StringToText("每个夜晚，唤醒恐惧之灵。让他指向任意一名玩家。让恐惧之灵重新入睡。在被恐惧之灵选择的玩家的角色标记旁放置「恐惧」");
    g_tipLine[15028] = StringToText("  提示标记。如果恐惧之灵此次选择的玩家在选择前没有放置「恐惧」提示标记，则宣布「恐惧之灵选择了一名玩家」。");
    g_tipLine[15029] = StringToText("  （这会告诉所有玩家恐惧之灵现在存活并且选择了新的目标。）");
    g_tipLine[15030] = StringToText("如果恐惧之灵提名并因此处决了一名标记有「恐惧」的玩家，宣布游戏结束以及哪一方阵营获得了胜利。");
    g_tipLine[15031] = StringToText("【提示标记】");
    g_tipLine[15032] = StringToText("· 恐惧");
    g_tipLine[15033] = StringToText("放置时机：恐惧之灵行动并选择了一名玩家，且该玩家当前没有标记「恐惧」时。");
    g_tipLine[15034] = StringToText("放置条件：恐惧之灵具有能力，则将此标记放置到他选择的玩家的角色标记旁。");
    g_tipLine[15035] = StringToText("移除时机：在恐惧之灵更换目标后移除，或恐惧之灵死亡或离场时移除。");
    g_tipLine[15036] = StringToText("【规则细节】");
    g_tipLine[15037] = StringToText("· 相克规则：");
    g_tipLine[15038] = StringToText("  · 瘟疫医生：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[15039] = StringToText("  · 维齐尔：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[15040] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[15041] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[15042] = StringToText("  · 戏子：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[15043] = StringToText("  · 戏子（改）：戏子（改）无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[15044] = StringToText("【提示与技巧】");
    g_tipLine[15045] = StringToText("· 在首夜选择任意玩家。你几乎不可能在不知道哪些角色在场的情况下，在第一天就提名并处决你希望的玩家，");
    g_tipLine[15046] = StringToText("  所以不要太过纠结你选择了谁。你总是能在第二夜改变主意。");
    g_tipLine[15047] = StringToText("· 在游戏的前几天，注意哪些玩家被认为十分可疑或最有可能被处决。这可能是因为他们是那些常在游戏早期就被杀死的角色，");
    g_tipLine[15048] = StringToText("  比如钟表匠或猎手，也可能是因为玩家表现得心里有鬼并且对他们的角色保持沉默。");
    g_tipLine[15049] = StringToText("  如果你能猜到下一天哪名玩家最可能被处决，那么今晚就选择那名玩家。这样就能明显地提升你以能力获胜的机会，");
    g_tipLine[15050] = StringToText("  因为这名玩家很可能会被谁处决——希望是被你。");
    g_tipLine[15051] = StringToText("· 如果你选择了一名很可能被处决的玩家，注意说书人以及他们的行为。如果你对提名发起的时机有良好的把握，");
    g_tipLine[15052] = StringToText("  你应当能成为第一个进行提名的玩家，这能保证你提名到你所选择的玩家。");
    g_tipLine[15053] = StringToText("· 你果你选择了一名很可能被处决的玩家，但你觉得过于热情地提名会显得太过可疑，那试着就谁应当被处决引发一些讨论，");
    g_tipLine[15054] = StringToText("  但让善良阵营决定来提名他。如果你能让自己看起来像是善良玩家，你就有可能说服他们（或者让他们说服他们自己）");
    g_tipLine[15055] = StringToText("  应当由你来进行提名。");
    g_tipLine[15056] = StringToText("· 如果你认为你无法通过恐惧之灵的能力获胜，那就停止每晚选择新玩家的行为。实际上，");
    g_tipLine[15057] = StringToText("  善良阵营不再得知恐惧之灵选择了一名玩家这点通常令他们相信恐惧之灵已经死亡。");
    g_tipLine[15058] = StringToText("  当他们将目光投向死亡玩家试图从其中找出邪恶玩家时，他们很可能会把一名提供正确信息的善良玩家误解为提供错误信息的邪恶");
    g_tipLine[15059] = StringToText("  玩家。在所有死亡玩家都是善良的情况下这种策略最为有效。");
    g_tipLine[15060] = StringToText("· 如果你认为你无法通过恐惧之灵的能力获胜，那就保持每晚选择新玩家的行为。如果善良阵营不断被提醒恐惧之灵在场，");
    g_tipLine[15061] = StringToText("  那么他们就不太愿意投票给那些看似不靠谱的提名。善良阵营越不确定，邪恶阵营就越有利。");
    g_tipLine[15062] = StringToText("  即使仅仅是每天都公开提醒善良阵营要防范恐惧之灵也能够让他们对被提名玩家投票有所保留，");
    g_tipLine[15063] = StringToText("  甚至是对邪恶的被提名玩家也会如此。这种策略在有多个玩家在场时最有效，因为如果只有一个玩家在场，");
    g_tipLine[15064] = StringToText("  而善良团队知道恐惧之灵还存活，那他们也能知道所有死亡玩家都是善良的，这是关键性信息。");
    g_tipLine[15065] = StringToText("· 如果你是邪恶玩家但不是恐惧之灵，那么尽你所能让恐惧之灵看起来像是善良玩家。通常，");
    g_tipLine[15066] = StringToText("  善良阵营会希望找一名最受信任的善良玩家来完成所有的提名。如果你可以通过宣称自己是洗衣妇这样可以得知角色的角色而暗");
    g_tipLine[15067] = StringToText("  示恐惧之灵是善良的，或是宣称自己是杂耍艺人并证实你的角色，或甚至宣称是已死亡的镜像双子来暗示恐惧之灵是善良的双子");
    g_tipLine[15068] = StringToText("  ，或诸如此类操作，都能带来极大帮助。如果善良阵营信任恐惧之灵是像善良阵营的玩家，");
    g_tipLine[15069] = StringToText("  恐惧之灵就能不受怀疑地进行每天的提名。");
    g_tipLine[15070] = StringToText("· 如果你是邪恶玩家，即使你不是恐惧之灵，也要尽可能多地提名。善良阵营通常希望将提名保持在最小规模，");
    g_tipLine[15071] = StringToText("  密切关注提名玩家和被提名玩家，并避免过多的提名制造混乱阻止追查线索。如果每天只有少数人提名，");
    g_tipLine[15072] = StringToText("  而其中主要是邪恶玩家，那投票大体将聚焦在善良玩家身上（假设邪恶玩家没有提名恶魔）。");
    g_tipLine[15073] = StringToText("  这种情况下邪恶阵营不太可能通过恐惧之灵的能力直接获胜。在大多数游戏内，");
    g_tipLine[15074] = StringToText("  恐惧之灵带入游戏的一个好处是使得善良阵营在投票时会多疑而过于谨慎。如果你可以利用这个优势，");
    g_tipLine[15075] = StringToText("  将其用以阻止邪恶玩家被处决，那么恐惧之灵将对游戏提供巨大影响。有时，");
    g_tipLine[15076] = StringToText("  恐惧之灵可以以让善良阵营被鼓动对将要发生而不是已经发生的事产生恐惧，从而做出无数微小的（错误）决定为手段，");
    g_tipLine[15077] = StringToText("  来为邪恶阵营带来胜机。");
    g_tipLine[15078] = StringToText("【对抗恐惧之灵】");
    g_tipLine[15079] = StringToText("· 你从一开始就知道恐惧之灵在场。这非常重要。在单爪牙游戏中，这意味着你知道三个不在场的爪牙，这是非常有用的信息。");
    g_tipLine[15080] = StringToText("  在双爪牙游戏中，花费一些时间去查明另一个爪牙的角色会很有帮助，也很可行。");
    g_tipLine[15081] = StringToText("· 只要恐惧之灵每晚都选择一名新玩家，你就知道恐惧之灵还存活。在单爪牙游戏中，");
    g_tipLine[15082] = StringToText("  这意味着所有死亡玩家都是善良的（因为恶魔也必须存活）。与死亡玩家交谈并信任他们所说的。他们站在你这边，");
    g_tipLine[15083] = StringToText("  不仅能提供宝贵的信息，还能提供可信赖的投票。");
    g_tipLine[15084] = StringToText("· 如果你能说服团队你很可能是善良的，那就每天都提名。你提名谁并不重要，你的提名是否有足够的投票也不重要。");
    g_tipLine[15085] = StringToText("  你甚至可以询问团队建议你每天提名谁。最重要的是作为一名善良玩家——你——每天都在提名。如果你在提名，");
    g_tipLine[15086] = StringToText("  并且你受信任，那么恐惧之灵就不太可能同样地提名和受信任。你的提名能被确定一定不会让邪恶阵营通过恐惧之灵的能力获胜");
    g_tipLine[15087] = StringToText("  ，因为你知道你不是恐惧之灵。没有任何其他提名玩家能带给你如此的确定性。");
    g_tipLine[15088] = StringToText("· 如果你不能说服团队你是善良的并且你的提名可以被信任，那就和团队一起寻找那名最值得信任的玩家。");
    g_tipLine[15089] = StringToText("  与每个人交谈并尽可能查明一切。让这名玩家每天都提名，但对他们应当提名的玩家保持讨论。当然，选择最终取决于他，");
    g_tipLine[15090] = StringToText("  但是你和团队的意见可以极大地让这名玩家了解到团队认为每天最值得提名处决的玩家。");
    g_tipLine[15091] = StringToText("  如果团队能决定处决哪名玩家并且能够决定哪名玩家应当进行这次提名，而这名玩家也同意团队的决定，");
    g_tipLine[15092] = StringToText("  那么至少你可以将注意力集中在需要被处决的人身上。");
    g_tipLine[15093] = StringToText("· 阻拦过于随性的提名与处决。仅在你认为被提名者是邪恶且提名者被证实是善良时才投票。");
    g_tipLine[15094] = StringToText("· 注意那些过于热衷于提名的玩家。他们可能是恐惧之灵。");
    g_tipLine[15095] = StringToText("· 最好每天的提名数量都超过邪恶玩家的数量。例如，如果有两名邪恶玩家，那至少让三名玩家提名。如果有四名邪恶玩家，");
    g_tipLine[15096] = StringToText("  那至少让五名玩家提名。这保证了每天有至少一名善良玩家在提名。如果每天只有邪恶玩家在提名，那么只有善良玩家在死亡，");
    g_tipLine[15097] = StringToText("  这会让善良阵营获胜的机会随着时间越来越少。");
    g_tipLine[15098] = StringToText("· 邪恶阵营不太可能靠着恐惧之灵的能力获胜。这种情况会发生，但远远少于看起来那样。");
    g_tipLine[15099] = StringToText("  更大的危险来自善良阵营对应当处决谁陷入瘫痪和犹豫。过多的麻痹大意肯定会让恐惧之灵成功提名并处决，");
    g_tipLine[15100] = StringToText("  但是过多的担忧将意味着善良玩家根本无法处决。在其中寻找一个折中点。");
    g_tipRoleAt[102] = 15005; g_tipRoleN[102] = 96; g_tipP1At[102] = 15007; g_tipP1N[102] = 12; g_tipP2At[102] = 15036; g_tipP2N[102] = 8;
    g_tipAbility[102] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败。当你首次选择或更换目标时，所有玩家都会得知你选择了新的玩家。");
    g_tipLine[15101] = StringToText("【背景故事】");
    g_tipLine[15102] = StringToText("「富有和健康总比贫穷和疾病要好。」");
    g_tipLine[15103] = StringToText("【角色能力】");
    g_tipLine[15104] = StringToText("每个夜晚，你要选择一名玩家：如果你选中了爪牙，他会得知被传教士选中。");
    g_tipLine[15105] = StringToText("所有被你选中的爪牙失去能力。");
    g_tipLine[15106] = StringToText("【角色简介】");
    g_tipLine[15107] = StringToText("传教士会净化爪牙的能力。");
    g_tipLine[15108] = StringToText("· 如果传教士选择了一名爪牙，爪牙会被唤醒得知他被布道了，并且他在传教士存活清醒健康的时候无法行动。");
    g_tipLine[15109] = StringToText("· 如果传教士选择了不是爪牙的玩家，无事发生。");
    g_tipLine[15110] = StringToText("· 传教士可以选择死亡玩家。");
    g_tipLine[15111] = StringToText("· 如果传教士在醉酒或中毒的时候选择了一名玩家，那名玩家不会被传教士的能力影响。");
    g_tipLine[15112] = StringToText("· 如果传教士醉酒或中毒，被布道的爪牙会重新获得能力，直到传教士恢复清醒健康。");
    g_tipLine[15113] = StringToText("【范例】");
    g_tipLine[15114] = StringToText("传教士指向小艾，他是一名工程师，无事发生。传教士指向了小茶，他是洗脑师。小茶被唤醒得知了他被布道了，");
    g_tipLine[15115] = StringToText("  并且他没有被唤醒使用他的能力。");
    g_tipLine[15116] = StringToText("道哥是传教士。他指向小明，她是麻脸巫婆。小明被唤醒得知她被布道了，并且不会被唤醒使用她的能力。下一个夜晚，");
    g_tipLine[15117] = StringToText("  投毒者选择了道哥。因为道哥现在中毒了，小明被唤醒使用了她的能力。");
    g_tipLine[15118] = StringToText("【运作方式】");
    g_tipLine[15119] = StringToText("每个夜晚，唤醒传教士并让他选择一名玩家。如果他选中一名爪牙，在那名爪牙的角色标记旁放置「失去能力」提示标记。");
    g_tipLine[15120] = StringToText("  让传教士重新入睡。如可能，则唤醒今晚被传教士选中的爪牙，向他展示「该角色的能力对你生效」");
    g_tipLine[15121] = StringToText("  信息标记以及传教士角色标记。让这名爪牙重新入睡。");
    g_tipLine[15122] = StringToText("在传教士存活期间，所有被标记「失去能力」的爪牙不会拥有能力。");
    g_tipLine[15123] = StringToText("【提示标记】");
    g_tipLine[15124] = StringToText("· 失去能力");
    g_tipLine[15125] = StringToText("放置时机：在传教士行动并选择了一名爪牙玩家后。");
    g_tipLine[15126] = StringToText("放置条件：传教士清醒健康，那么将此标记放置在被他选中的爪牙玩家的角色标记旁。");
    g_tipLine[15127] = StringToText("移除时机：传教士死亡或离场，或被标记的玩家角色不再是爪牙角色时移除。");
    g_tipLine[15128] = StringToText("【规则细节】");
    g_tipLine[15129] = StringToText("· 关于传教士的「失去能力」与其他角色的醉酒中毒效果会有所不同，暂且作为「特例」进行处理。");
    g_tipLine[15130] = StringToText("  如果想要了解与其他情况下失去能力的效果的详细差别，请参考这里。");
    g_tipLine[15131] = StringToText("· 如果传教士死亡，这些爪牙恢复能力。已经使用了「每局游戏限一次」的能力的爪牙无法再次使用能力。");
    g_tipLine[15132] = StringToText("  受传教士影响的爪牙不会被告知传教士已经死亡，但他们可能会在再次被唤醒时意识到这一点。");
    g_tipLine[15133] = StringToText("· 如果传教士醉酒或中毒，因传教士失去能力的爪牙恢复能力，但会在传教士恢复健康清醒后再次失去能力。");
    g_tipLine[15134] = StringToText("· 如果被传教士选中的爪牙在之后变成其他角色类型的角色(也就是不再是爪牙)，那么他不再受到传教士能力的影响。此外，");
    g_tipLine[15135] = StringToText("  邪恶玩家不会仅仅因为属于邪恶阵营就受到传教士能力的影响，他需要明确地作为爪牙角色才能受到影响。");
    g_tipLine[15136] = StringToText("· 同理，一名后来变成爪牙的非爪牙玩家不会因为在变成爪牙之前被传教士选择而受到其能力影响。");
    g_tipLine[15137] = StringToText("  如果他在变成爪牙后被传教士选中，传教士能力正常生效。");
    g_tipLine[15138] = StringToText("· 如果因传教士而失去能力的爪牙在死亡后复活，他不会恢复能力，只要传教士仍然存活，他仍然失去能力。");
    g_tipLine[15139] = StringToText("· 特定角色互动：");
    g_tipLine[15140] = StringToText("  · 咖啡师：被布道的爪牙获得咖啡师能力1不会恢复能力。");
    g_tipLine[15141] = StringToText("  · 工程师：如果工程师做出行动，被布道的爪牙会被告知他的爪牙角色发生改变，但他会继续受到传教士影响，");
    g_tipLine[15142] = StringToText("    并且不会恢复能力。");
    g_tipLine[15143] = StringToText("  · 小怪宝：正在持有小怪宝角色标记的爪牙被传教士选中，会失去他的爪牙能力，但保留小怪宝恶魔的能力。");
    g_tipLine[15144] = StringToText("  · 数学家：那些原本该醒来或使用能力的爪牙，因为被布道而无法这样做时，会被数学家当作是他的能力未正常生效。");
    g_tipLine[15145] = StringToText("  · 灵言师：如果灵言师在首个夜晚被布道，他不会得知关键词。然而，如果传教士死亡或醉酒中毒，");
    g_tipLine[15146] = StringToText("    灵言师会在那个时候得知他的关键词。如果灵言师在其他夜晚被布道，在这之后说出关键词的玩家不会转变为邪恶但仍然消耗灵言师");
    g_tipLine[15147] = StringToText("    的能力，同样的情况适用于如果玩家在白天说出关键词，接着灵言师在夜晚被布道。");
    g_tipLine[15148] = StringToText("    玩家不能在灵言师得知关键词之前说出关键词，在灵言师被告知关键词之前，关键词实际上并不存在，");
    g_tipLine[15149] = StringToText("    所以提前使用相关词语不算作灵言师能力的一次使用，既没有消耗能力，也没有让玩家转变为邪恶。");
    g_tipLine[15150] = StringToText("  · 陌客：陌客可以被传教士当作是爪牙角色，并得知被传教士选中。通常来说你应该避免这样做——请注意，如果你这样做，");
    g_tipLine[15151] = StringToText("    陌客仍然保留能力——如果陌客失去能力，他会停止被当作爪牙，这意味着「布道」");
    g_tipLine[15152] = StringToText("    提示标记应该被移除并且因此陌客不再被布道，所以陌客重新恢复能力。");
    g_tipLine[15153] = StringToText("  · 间谍：间谍可以在被传教士选中时被当作非爪牙角色，并且避免受到传教士能力影响。");
    g_tipLine[15154] = StringToText("  · 亡骨魔：传教士可以选中在亡骨魔的保留能力效果下的死亡爪牙。在这种情况下，传教士的能力会更胜一筹，");
    g_tipLine[15155] = StringToText("    意味着爪牙会像被正常选中那样失去能力。在此之后，如果传教士死亡，受到影响的爪牙将恢复能力。");
    g_tipLine[15156] = StringToText("  · 寡妇：如果寡妇在首个夜晚被传教士选中，那么他不能查看魔典并选择一名玩家中毒，也不会有一名善良玩家知道寡妇在场。");
    g_tipLine[15157] = StringToText("    然而，如果传教士死亡或醉酒中毒，寡妇会在那个时候查看魔典并选择一名玩家中毒，随后会有一名善良玩家知道寡妇在场。");
    g_tipLine[15158] = StringToText("· 相克规则：");
    g_tipLine[15159] = StringToText("  · 维齐尔：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[15160] = StringToText("  · 召唤师：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[15161] = StringToText("  · 军团：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_tipLine[15162] = StringToText("【提示与技巧】");
    g_tipLine[15163] = StringToText("· 传教士的能力可以阻断爪牙的能力。但是他们会得知这点并且能在你死后夺回能力。");
    g_tipLine[15164] = StringToText("  虽然你无法得知你是否成功地命中一个爪牙，但你可以在次日小心观察你的目标，观察他们的行为是否发生了变化。");
    g_tipLine[15165] = StringToText("  如果他们有变化，并且似乎突然提升了对处决的热情，那么你很可能命中了一个爪牙。");
    g_tipLine[15166] = StringToText("· 小心揭露你是传教士的事实！你的能力是邪恶阵营的眼中钉，能够做到比如缴械他们的炸弹人或是智取他们的灵言师这样的事。");
    g_tipLine[15167] = StringToText("  仅是爪牙能力能被夺取这个威胁本身也足以瓦解邪恶阵营的精心谋划，从而使得你具有很高的死亡优先级。");
    g_tipLine[15168] = StringToText("  试着伪装成更无害的镇民，甚至是一个诸如管家或是理发师这样的外来者！");
    g_tipLine[15169] = StringToText("· 如果一名玩家表现可疑并保持沉默，那他就是一个合适目标。尽管善良玩家与邪恶玩家都有试图低调的理由，");
    g_tipLine[15170] = StringToText("  但你的能力对那些并非爪牙而仅仅只是想遁出视线的善良玩家没有效果。在暗中狙击他们不会有任何损失。");
    g_tipLine[15171] = StringToText("· 在第一天，仔细倾听那些公开宣称的人们。要记得爪牙不会获得伪装因而往往是最后才会公开现身的人。");
    g_tipLine[15172] = StringToText("  那些陷入同角色宣称或是仅在游戏后期才现身的玩家是你能力的合适目标。");
    g_tipLine[15173] = StringToText("· 如果你必须在两个潜在爪牙之中选择一个，那就选择那个能造成最多持续输出的。");
    g_tipLine[15174] = StringToText("  命中一个已经杀人的刺客对你的阵营而言不算多大成就，一个失去能力的寡妇仍然已经看过魔典，虽然他们失去了投毒的能力。");
    g_tipLine[15175] = StringToText("  一个麻脸巫婆将会是一个更紧急的优先目标！");
    g_tipLine[15176] = StringToText("· 一旦你死亡，并且你怀疑你已经无效化了一些爪牙，那此时现身是非常重要的事——你现在已经死亡，");
    g_tipLine[15177] = StringToText("  那些能力又恢复并对你的小镇构成了威胁！");
    g_tipLine[15178] = StringToText("· 传教士可以以死亡玩家为目标！虽然这在大多数情况下没什么用，但这让你对亡骨魔或是邪恶的集骨者形成了奇妙的反制。");
    g_tipLine[15179] = StringToText("  一些未来会登场的爪牙可能在死亡后也保留他们的能力——但并不能在你的能力下保留！");
    g_tipRoleAt[103] = 15101; g_tipRoleN[103] = 79; g_tipP1At[103] = 15103; g_tipP1N[103] = 10; g_tipP2At[103] = 15128; g_tipP2N[103] = 34;
    g_tipAbility[103] = StringToText("每个夜晚，你要选择一名玩家：如果你选中了爪牙，他会得知被传教士选中。所有被你选中的爪牙失去能力。");
    g_tipLine[15180] = StringToText("【背景故事】");
    g_tipLine[15181] = StringToText("「未知纷扰让致命冲突重负难堪，");
    g_tipLine[15182] = StringToText("在不祥之夜将神秘与悲伤盈满，");
    g_tipLine[15183] = StringToText("欢喜或曾无羁于漫长多彩世间，");
    g_tipLine[15184] = StringToText("谁的花园遍地绽放着彩绘的脸。」");
    g_tipLine[15185] = StringToText("【角色能力】");
    g_tipLine[15186] = StringToText("每个夜晚，如果死亡的玩家数量大于或等于存活的玩家数量，你会得知一个存活的角色。");
    g_tipLine[15187] = StringToText("恶魔知道你是国王。");
    g_tipLine[15188] = StringToText("【角色简介】");
    g_tipLine[15189] = StringToText("国王能得知仍然存活的角色。");
    g_tipLine[15190] = StringToText("· 国王会在游戏的数个夜晚之后获得能力——只要死亡玩家的数量大于或等于存活玩家的数量。");
    g_tipLine[15191] = StringToText("· 在游戏开始时的第一个夜晚，恶魔会得知谁是国王。如果国王在游戏中途被创造，恶魔会在当晚得知谁是国王。");
    g_tipLine[15192] = StringToText("· 国王未必能幸存到能够使用自己的能力。然而一旦死亡玩家的数量大于或等于存活玩家的数量，");
    g_tipLine[15193] = StringToText("  国王就能在此后的每个夜晚得知一个存活角色。");
    g_tipLine[15194] = StringToText("· 国王既有可能得知善良角色，也有可能得知邪恶角色，甚至还有可能多次得知同一个角色。");
    g_tipLine[15195] = StringToText("· 唱诗男孩并非一定在场。但如果唱诗男孩在场，且在恶魔杀死国王时仍然存活，唱诗男孩就能够得知谁是恶魔。");
    g_tipLine[15196] = StringToText("【范例】");
    g_tipLine[15197] = StringToText("小米是国王。现在场上有十二名存活玩家和一名死亡玩家。在第二个夜晚，她不会得知任何信息。在第三个夜晚，");
    g_tipLine[15198] = StringToText("  她依然没有得知任何信息。在第四天的白天时，有七名玩家死亡，六名玩家存活。在第四个夜晚，小米得知了告密者仍然存活。");
    g_tipLine[15199] = StringToText("  在第五个夜晚，小米得知了女巫仍然存活。");
    g_tipLine[15200] = StringToText("恶魔知道小黑是国王。小文声称自己是唱诗男孩，但实际上是管家。恶魔冒险杀死了小黑。如果小文真的是唱诗男孩，");
    g_tipLine[15201] = StringToText("  他此时就会得知哪名玩家是恶魔了。");
    g_tipLine[15202] = StringToText("【运作方式】");
    g_tipLine[15203] = StringToText("在首个夜晚时，唤醒恶魔。对他展示「这名玩家是」信息标记，然后展示国王角色标记，然后指向角色为国王的玩家。");
    g_tipLine[15204] = StringToText("  让恶魔重新入睡。");
    g_tipLine[15205] = StringToText("当死亡玩家的数量大于或等于存活玩家的数量时，在夜晚顺序表的国王顺序旁添加一个夜晚标记。");
    g_tipLine[15206] = StringToText("每个夜晚，如果夜晚顺序表的国王顺序旁有夜晚标记，那么唤醒国王。对他展示一个存活玩家的角色标记。让国王重新入睡。");
    g_tipLine[15207] = StringToText("仔细思考你需要给国王展示哪一个角色标记。不要担心给出大量的信息。绝大多数国王都会在最后一天到来前死亡，");
    g_tipLine[15208] = StringToText("  而如果一名国王活到了最后一天，那么他通常都能够获胜，这也是没问题的。");
    g_tipLine[15209] = StringToText("【提示标记】");
    g_tipLine[15210] = StringToText("无");
    g_tipLine[15211] = StringToText("【规则细节】");
    g_tipLine[15212] = StringToText("· 特定角色互动：");
    g_tipLine[15213] = StringToText("  · 食人族：如果食人族在场时国王死于处决，恶魔会在当晚被唤醒并告知这名食人族玩家是国王。");
    g_tipLine[15214] = StringToText("  · 侍女：直到死亡的玩家数量大于或等于存活的玩家数量，国王才会被唤醒，因此在此之前，侍女不会探查到国王，");
    g_tipLine[15215] = StringToText("    然后从国王被唤醒开始，才会被侍女的探查。");
    g_tipLine[15216] = StringToText("  · 哲学家/小精灵：其获得能力当晚恶魔应该被展示国王的角色标记，而不是哲学家/小精灵。");
    g_tipLine[15217] = StringToText("  · 罂粟种植者：罂粟种植者不会干扰恶魔知道谁是国王。");
    g_tipLine[15218] = StringToText("  · 教授/沙巴洛斯/集骨者：复活/反刍/重获能力角色选择国王将导致恶魔再次被告知国王是谁。");
    g_tipLine[15219] = StringToText("  · 舞蛇人/理发师/麻脸巫婆/红唇女郎/方古/小恶魔/小怪宝：如果恶魔更换了玩家，此时国王仍存活且清醒和健康，");
    g_tipLine[15220] = StringToText("    新的恶魔玩家会知道国王是谁。");
    g_tipLine[15221] = StringToText("  · 理发师/麻脸巫婆：如果国王被交换到另外一名玩家，或者被重新创造，恶魔会被告知新国王玩家。");
    g_tipLine[15222] = StringToText("  · 酒鬼/提线木偶：如果国王被选为酒鬼/提线木偶，恶魔不会被告知哪名玩家是国王。");
    g_tipLine[15223] = StringToText("  · 莽夫：国王没有使用自己的能力主动选择莽夫，所以国王得知莽夫时不会因为莽夫的能力而醉酒。");
    g_tipLine[15224] = StringToText("  · 疯子：疯子可以被告知国王在场，无论正确与否。");
    g_tipLine[15225] = StringToText("  · 陌客：理论上你可以向陌客展示国王是谁，但这并不有趣。");
    g_tipLine[15226] = StringToText("  · 涡流：恶魔会被告知除该国王玩家以外的任意玩家是国王。国王得知错误信息：不在场或者已经死亡的角色。");
    g_tipLine[15227] = StringToText("  · 僵怖：假死的僵怖在国王「死亡玩家数量大于或等于存活玩家数量」的能力里，被算作死亡。");
    g_tipLine[15228] = StringToText("  · 学徒：如果获得国王能力，恶魔会被告知。");
    g_tipLine[15229] = StringToText("  · 咖啡师：只有当死亡玩家数量大于或等于存活玩家数量时，其才会在国王获得信息时产生效果。1）国王获得正确信息，2）");
    g_tipLine[15230] = StringToText("    国王得知两个角色标记。");
    g_tipLine[15231] = StringToText("· 相克规则：");
    g_tipLine[15232] = StringToText("  · 利维坦：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[15233] = StringToText("  · 暴乱：如果暴乱在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[15234] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[15235] = StringToText("  · 戏子（改）：国王不会因为戏子（改）的能力醉酒。");
    g_tipLine[15236] = StringToText("【提示与技巧】");
    g_tipLine[15237] = StringToText("· 国王是少数能够在早期自信现身的角色之一。恶魔知道国王是谁，也知道他们可能是一个过早被杀就会触发的陷阱。");
    g_tipLine[15238] = StringToText("  因为恶魔只有在确定唱诗男孩不构成妨碍的情况下才能杀死国王，所以国王很可能存活到游戏结束。");
    g_tipLine[15239] = StringToText("· 国王也可以暗中等待。国王在游戏临近尾声时能获得大量而确实的优秀信息，虽然国王常常选择现身，");
    g_tipLine[15240] = StringToText("  但保持沉默也是一种驱离恶魔的好方法。你可以安静地观察那些仿佛对你关注过多的玩家，因为他们可能是恶魔。");
    g_tipLine[15241] = StringToText("· 只要唱诗男孩存活，国王就能拥有对恶魔的防护。寻找另一名善良玩家并隐秘地让他人知道他是唱诗男孩。");
    g_tipLine[15242] = StringToText("  如果其实并没有唱诗男孩在场，这种方法可能有助于推动恶魔狂热地寻找唱诗男孩。如果确实有唱诗男孩在场，");
    g_tipLine[15243] = StringToText("  这种方法会为恶魔提供一个假目标，帮助唱诗男孩（当然还有你）存活。");
    g_tipLine[15244] = StringToText("· 直率地作为国王现身创造了一个有趣的开场。因为唯二能确定国王是否在场的其他角色是唱诗男孩和恶魔。通过直率地现身，");
    g_tipLine[15245] = StringToText("  你提出了一项挑战，表明你不是国王就是恶魔。通过这种方法，你可以向大家询问他们的角色，");
    g_tipLine[15246] = StringToText("  并承诺同意在最后一晚之前被处决来降低对你是否是恶魔的怀疑。");
    g_tipLine[15247] = StringToText("· 因为国王在游戏临近尾声时获得的信息非常强力，而且国王也是被当作恶魔怀疑的主要嫌疑人，");
    g_tipLine[15248] = StringToText("  所以公开的国王存活到游戏结束的几率很低。如果你选择公开，专注于利用你的地位，");
    g_tipLine[15249] = StringToText("  在身旁建立一个可信的王宫而不是专注于存活。");
    g_tipLine[15250] = StringToText("· 成为国王并坐拥王宫会有很多乐趣。让其他玩家来找你并告诉你他们的秘密而不是像农民一样在王宫附近游荡。");
    g_tipRoleAt[104] = 15180; g_tipRoleN[104] = 71; g_tipP1At[104] = 15185; g_tipP1N[104] = 11; g_tipP2At[104] = 15211; g_tipP2N[104] = 25;
    g_tipAbility[104] = StringToText("每个夜晚，如果死亡的玩家数量大于或等于存活的玩家数量，你会得知一个存活的角色。恶魔知道你是国王。");
    g_tipLine[15251] = StringToText("【背景故事】");
    g_tipLine[15252] = StringToText("「玫瑰花是蓝色哒！草桂花是红色哒！哦豁，俺说反啦！」");
    g_tipLine[15253] = StringToText("【角色能力】");
    g_tipLine[15254] = StringToText("每个夜晚，你要选择一名玩家：你会得知他的阵营。[+0~2村夫，复数村夫中有一人醉酒]");
    g_tipLine[15255] = StringToText("【角色简介】");
    g_tipLine[15256] = StringToText("村夫结伴而行，他们能得知玩家的阵营。");
    g_tipLine[15257] = StringToText("· 由说书人在进行游戏设置时决定哪一名村夫醉酒。");
    g_tipLine[15258] = StringToText("· 在场村夫的数量可能是1、2或3，这与一局游戏的玩家人数无关。");
    g_tipLine[15259] = StringToText("· 如果在场村夫的数量为1，他会是清醒的。");
    g_tipLine[15260] = StringToText("· 醉酒的村夫仍然可能会得知正确信息。");
    g_tipLine[15261] = StringToText("· 在游戏设置时如果添加了额外的村夫，他们会替换其他的镇民角色标记。");
    g_tipLine[15262] = StringToText("· 如果村夫在游戏过程中被创造，只有被创造的村夫会发生角色变化。不会有其他玩家因此变成村夫。");
    g_tipLine[15263] = StringToText("· 多名村夫在夜晚会分别独自行动，而不是一同被唤醒。");
    g_tipLine[15264] = StringToText("· 如果所有清醒的村夫都离场，剩余的醉酒村夫仍然保持醉酒状态。");
    g_tipLine[15265] = StringToText("· 如果一名清醒的村夫因为其他效果醉酒或中毒，处于醉酒状态的村夫仍然保持醉酒状态。");
    g_tipLine[15266] = StringToText("【范例】");
    g_tipLine[15267] = StringToText("道哥、小莱和小米都是村夫，道哥醉酒。在夜晚时，他们都选择了卡扎力小艾。道哥得知小艾是善良玩家。");
    g_tipLine[15268] = StringToText("  小莱和小米得知小艾是邪恶玩家。");
    g_tipLine[15269] = StringToText("小八和小明是村夫，小明醉酒。小美是邪恶玩家，并且伪装成村夫。小八选择了小美并得知她是邪恶玩家。");
    g_tipLine[15270] = StringToText("  小明选择了异端分子并得知他是善良玩家。小美声称自己选择了小八并得知他是邪恶玩家。");
    g_tipLine[15271] = StringToText("【运作方式】");
    g_tipLine[15272] = StringToText("在游戏设置时，将角色标记放入盲抽袋之前，使用额外的村夫角色标记替换掉其中的0~2个镇民角色标记。");
    g_tipLine[15273] = StringToText("  在为首个夜晚做准备时，（如果有超过一名村夫在场，）将村夫的「醉酒」提示标记放置到其中一个村夫角色标记旁。");
    g_tipLine[15274] = StringToText("每个夜晚，唤醒任意一名村夫。让他指向一名玩家。对他给出拇指向上或向下的手势。让他重新入睡。重复这个操作，");
    g_tipLine[15275] = StringToText("  直到所有村夫玩家都进行了夜晚行动。");
    g_tipLine[15276] = StringToText("【提示标记】");
    g_tipLine[15277] = StringToText("· 醉酒");
    g_tipLine[15278] = StringToText("放置时机：在为首个夜晚做准备时。");
    g_tipLine[15279] = StringToText("放置条件：如果有超过一名村夫在场，则将该标记放置到其中一个村夫角色标记旁。");
    g_tipLine[15280] = StringToText("村夫的醉酒同为设置调整和持续检测能力。一旦在场村夫的数量增加至2人，且尚未放置醉酒标记，");
    g_tipLine[15281] = StringToText("  说书人需要立即将该醉酒标记放置到其中一个村夫角色标记旁。");
    g_tipLine[15282] = StringToText("移动时机：见与麻脸巫婆的相克规则。");
    g_tipLine[15283] = StringToText("移除时机：在该村夫离场时。");
    g_tipLine[15284] = StringToText("【规则细节】");
    g_tipLine[15285] = StringToText("· 「复数村夫中有一人醉酒」这一项能力既是设置调整能力（需要在为首夜准备时进行调整），又是持续检测型能力。");
    g_tipLine[15286] = StringToText("  在游戏过程中，只要村夫的在场数量超过1人，且村夫的醉酒提示标记尚未被放置，就需要立即放置该标记。");
    g_tipLine[15287] = StringToText("· 只要村夫在场，即使村夫的在场数量不足3人，说书人都无法将村夫作为恶魔的伪装提供给恶魔。");
    g_tipLine[15288] = StringToText("  然而如果有酒鬼或是提线木偶以为自己是村夫，将村夫作为伪装提供给恶魔不算是「YBD」。");
    g_tipLine[15289] = StringToText("· 根据角色标记的实物限制原则，当村夫数量为3人时，不建议再为学徒等角色提供村夫的角色能力。同时，");
    g_tipLine[15290] = StringToText("  如果有任何村夫在场，也不建议让酒鬼认为自己是村夫。");
    g_tipLine[15291] = StringToText("· 哲学家、食人族、学徒等角色的获得能力效果，不会参与到「村夫在场数量」的计算之中。也就是说，");
    g_tipLine[15292] = StringToText("  如果村夫在场数量为1人，那么即使有其他具有村夫能力的角色，这些角色包括村夫在内就都不会因为村夫的能力而醉酒。");
    g_tipLine[15293] = StringToText("  （在统计相克规则中的在场数量时，仍然会参与计算，这是由于受到角色标记的实物数量限制导致的。）");
    g_tipLine[15294] = StringToText("· 特定角色互动：");
    g_tipLine[15295] = StringToText("  · 卡扎力：如果有复数个村夫在场，卡扎力的设置调整优先生效，其他的村夫因卡扎力的能力变成了爪牙，");
    g_tipLine[15296] = StringToText("    剩下的那名村夫一定是清醒的，因为这时村夫已经只有一个了。");
    g_tipLine[15297] = StringToText("· 相克规则：");
    g_tipLine[15298] = StringToText("  · 麻脸巫婆：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，村夫的醉酒效果可能会更换目标。");
    g_tipLine[15299] = StringToText("  · 科学怪人：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[15300] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[15301] = StringToText("  · 悟道者：如果村夫在场数量不足3人，悟道者可以变成新的村夫。如果因此使得村夫的在场数量超过1人，会有一名村夫醉酒。");
    g_tipLine[15302] = StringToText("【提示与技巧】");
    g_tipLine[15303] = StringToText("· 找到你的村夫同伴。要想知道你们之中有谁醉酒了，最简单的方式就是比对你们的信息，找出其中相同之处和不同之处。同时，");
    g_tipLine[15304] = StringToText("  如果你是唯一的村夫，那么就说明你是清醒的！");
    g_tipLine[15305] = StringToText("· 与其他村夫合作，一起选择同一名玩家。这可以帮助你们确定你们谁醉酒了（如果其中有人的信息与其他人不同），");
    g_tipLine[15306] = StringToText("  或者确定是否有人在伪装成村夫（如果你们所有的信息都相同）。");
    g_tipLine[15307] = StringToText("· 如果正好只有两名村夫，而你们又无法确定谁醉酒了，那么一定要选择不同的玩家，这样你们仍然可以获得信息。");
    g_tipLine[15308] = StringToText("  如果你们两人始终选择相同的目标，将无法获得任何有效信息。");
    g_tipLine[15309] = StringToText("· 记住，有三人宣称自己是村夫并不能证明你们之中任何人是善良玩家。注意那些潜藏的邪恶玩家，");
    g_tipLine[15310] = StringToText("  如果村夫实际数量没有那么多，那么邪恶玩家就有机会伪装成村夫，并让你看起来像是醉酒了，但其实你并没有醉酒！");
    g_tipLine[15311] = StringToText("· 你也可以不必理会其他的村夫，假设你的信息就是正确的。如果所有的村夫都这么做，");
    g_tipLine[15312] = StringToText("  那么你们的能力效果叠加时总是会产生正向的收益。");
    g_tipLine[15313] = StringToText("· 尝试处决你认为醉酒的村夫以防万一，因为他们有可能实际上是邪恶玩家。");
    g_tipLine[15314] = StringToText("· 如果你确信某一玩家的阵营，那么就选择他，来检验自己是否是醉酒的。");
    g_tipLine[15315] = StringToText("· 但请注意，说书人仍然有可能向醉酒的村夫提供正确信息，以防止村夫的能力过于强大。");
    g_tipLine[15316] = StringToText("· 在透露自己是村夫之前先等待一小段时间。如果有三名或更多的玩家声称自己是村夫，你就知道他们之中至少有一人在撒谎。");
    g_tipRoleAt[105] = 15251; g_tipRoleN[105] = 66; g_tipP1At[105] = 15253; g_tipP1N[105] = 13; g_tipP2At[105] = 15284; g_tipP2N[105] = 18;
    g_tipAbility[105] = StringToText("每个夜晚，你要选择一名玩家：你会得知他的阵营。[+0~2村夫，复数村夫中有一人醉酒]");
    g_tipLine[15317] = StringToText("【背景故事】");
    g_tipLine[15318] = StringToText("「他们自诩聪明，却成了傻瓜。」");
    g_tipLine[15319] = StringToText("【角色能力】");
    g_tipLine[15320] = StringToText("每个夜晚，你会转变为与你邻近的一名存活的玩家的阵营。");
    g_tipLine[15321] = StringToText("每个白天，你可以提议所有玩家加入你的教派，如果所有善良玩家同意加入，你的阵营获胜。");
    g_tipLine[15322] = StringToText("【角色简介】");
    g_tipLine[15323] = StringToText("异教领袖会在所有人加入他的教派时获胜。");
    g_tipLine[15324] = StringToText("· 在每个夜晚结束时，异教领袖会转变为一名邻近存活玩家的阵营。");
    g_tipLine[15325] = StringToText("· 每个白天限一次，异教领袖可以公开创立一个教派。如果所有善良玩家投票加入教派，游戏立刻结束，异教领袖的阵营获胜。");
    g_tipLine[15326] = StringToText("· 异教领袖可以在一天的任何时候创立教派。");
    g_tipLine[15327] = StringToText("· 投票加入教派不需要消耗投票标记。");
    g_tipLine[15328] = StringToText("· 玩家可以在任何时候说任何事情，所以当玩家要伪装异教领袖的时候，他可以假装要创立一个教派。");
    g_tipLine[15329] = StringToText("【范例】");
    g_tipLine[15330] = StringToText("在第三个白天，善良的异教领袖的邻近存活玩家是善良的城镇公告员和邪恶的哥布林。异教领袖创立了一个教派，");
    g_tipLine[15331] = StringToText("  并且所有善良玩家都投票加入了教派。游戏结束，善良阵营获胜。");
    g_tipLine[15332] = StringToText("异教领袖和诺-达鲺邻座。在第二个白天，异教领袖尝试创立了一个教派。所有玩家都投票加入了教派，但是教派创立失败了，");
    g_tipLine[15333] = StringToText("  因为异教领袖中毒了。");
    g_tipLine[15334] = StringToText("异教领袖的邻近存活玩家是邪恶的投毒者和善良的占卜师。投毒者选择了异教领袖，卡扎力杀死了占卜师。");
    g_tipLine[15335] = StringToText("  异教领袖的邻近存活玩家现在是邪恶的投毒者和邪恶的女巫。这时异教领袖的两名邻近存活玩家都是邪恶的，");
    g_tipLine[15336] = StringToText("  但异教领袖没有转变阵营，因为他中毒了。");
    g_tipLine[15337] = StringToText("【运作方式】");
    g_tipLine[15338] = StringToText("每个夜晚，把异教领袖的角色标记正置（如果他的邻近存活玩家都是善良的），或者倒置（如果他的邻近存活玩家都是邪恶的）");
    g_tipLine[15339] = StringToText("  ，或者在正置和倒置中任选一个（如果两名邻近的存活玩家分别是善良和邪恶的）。如果异教领袖的阵营变化，唤醒异教领袖，");
    g_tipLine[15340] = StringToText("  并给出大拇指向上或向下的手势，然后让异教领袖重新入睡。如果异教领袖的阵营没有变化，不要唤醒他。");
    g_tipLine[15341] = StringToText("在白天，异教领袖可以公开声称他想使用他的能力。如果他这样做了，像提名一样围成一个圈并进行一次投票。");
    g_tipLine[15342] = StringToText("  如果所有善良玩家举手了，宣布获胜的阵营。如果不是所有善良玩家都举手，无事发生。");
    g_tipLine[15343] = StringToText("如果一名玩家正在伪装异教领袖并且就像他们真的是异教领袖一样宣称想要使用能力——给出一段讨论时间，");
    g_tipLine[15344] = StringToText("  进行加入教派的投票，并且在投票之后宣布无事发生。");
    g_tipLine[15345] = StringToText("【提示标记】");
    g_tipLine[15346] = StringToText("无");
    g_tipLine[15347] = StringToText("【规则细节】");
    g_tipLine[15348] = StringToText("· 相克规则：");
    g_tipLine[15349] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶异教领袖无法因为自身能力转变为善良阵营。");
    g_tipLine[15350] = StringToText("  · 科学怪人：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[15351] = StringToText("【提示与技巧】");
    g_tipLine[15352] = StringToText("· 尽早承认是异教领袖，因为游戏早期你的成功几率要高很多。虽然，在第一晚你可能转变为邪恶阵营，");
    g_tipLine[15353] = StringToText("  但大多数时候并不会如此。然而尽管如此，大家可能会犹豫是否在第一天为异教领袖胜利条件而举手，");
    g_tipLine[15354] = StringToText("  因为这感觉像一次廉价的胜利（像赌运气），他们没有太多关于你当前阵营的证据。");
    g_tipLine[15355] = StringToText("· 稍晚承认是异教领袖，因为此时你可以提供更多可以分享的信息。但是要注意，玩家倾向于在游戏晚期怀疑异教领袖，");
    g_tipLine[15356] = StringToText("  因为随着游戏接近尾声，你转变为邪恶阵营的概率越来越高，善良玩家比邪恶玩家更容易死亡，");
    g_tipLine[15357] = StringToText("  所以你的存活相邻玩家在游戏后期时越来越可能是邪恶的。");
    g_tipLine[15358] = StringToText("· 在你是邪恶阵营时承认你是异教领袖（但不要承认你是邪恶的），因为这会更容易在处决和异教领袖投票环节赢得邪恶阵营的支");
    g_tipLine[15359] = StringToText("  持。");
    g_tipLine[15360] = StringToText("· 让其他玩家对你的相邻玩家使用察知能力来验证你的宣称。让侍女或是女裁缝选择你的两名相邻玩家，来核实你对阵营的宣称。");
    g_tipLine[15361] = StringToText("· 尝试处决你与那些已经被核实为镇民的玩家之间的玩家，比如贞洁者或是贵族（之间的玩家），");
    g_tipLine[15362] = StringToText("  这能帮助你赢得信任来达成异教领袖胜利条件。");
    g_tipLine[15363] = StringToText("· 在你转变回善良阵营前不要承认你是邪恶阵营的，否则你可能会被处决并锁定在邪恶阵营中。但如果这是最后一天，");
    g_tipLine[15364] = StringToText("  作为邪恶阵营登场可以摧垮善良阵营轻松赢得胜利。如果你上一晚是邪恶的而现在是善良的，");
    g_tipLine[15365] = StringToText("  你可以告诉大家你曾经是邪恶的因此你的一名相邻玩家一定是邪恶的。");
    g_tipLine[15366] = StringToText("· （你可以）无视异教领袖的入教能力，只是悄然了解你是否有一名邪恶的邻居，就好像共情者那样。在整个游戏流程中，");
    g_tipLine[15367] = StringToText("  默记你处于邪恶的时间，尤其是当你的相邻玩家死亡（前后的变化）。然后你可以获得一些有效信息，");
    g_tipLine[15368] = StringToText("  得知某名玩家很可能是善良的而某名玩家很可能是邪恶的。");
    g_tipLine[15369] = StringToText("· （你可以）始终使用异教领袖的入教能力，观察投票者的行为。邪恶阵营知道你是否紧邻一名邪恶玩家，并且更愿意投票给你。");
    g_tipLine[15370] = StringToText("  异教领袖可能很难说服全体投票，因为常会有一名善良玩家回头想想「如果他是邪恶的呢？」。这都没关系，");
    g_tipLine[15371] = StringToText("  你仍然可以通过观察玩家的投票了解很多事，因为邪恶玩家更热衷于投票，因为他们的投票并不影响结果。");
    g_tipLine[15372] = StringToText("· 在游戏快结束时，如果玩家不能确定恶魔是谁，你的胜利条件可能是最后的福音。如果找到恶魔的概率低于五五开，");
    g_tipLine[15373] = StringToText("  那么异教领袖提供的概率更高。如果投票形式意外地明确了恶魔逃过了处决，还会有一个备用计划。也许你是邪恶阵营，");
    g_tipLine[15374] = StringToText("  但对于善良阵营来说，这仍然是一个更好的获胜契机，而不是知道没能处决恶魔。");
    g_tipLine[15375] = StringToText("· 记得在最后一天时，如果只有三名玩家存活而你是其中之一，那你一定在恶魔边上。如果第三名玩家是邪恶的，");
    g_tipLine[15376] = StringToText("  那你们三人都是邪恶的，这意味着不会有人能提名恶魔，邪恶阵营可以轻易获胜。如果你是善良的，");
    g_tipLine[15377] = StringToText("  那你能确定邪恶阵营只有恶魔还存活。");
    g_tipLine[15378] = StringToText("· 玩家人数非常重要，在九人、十二人或十五人游戏中，你拥有最高的善恶比（善良玩家的比例最高），");
    g_tipLine[15379] = StringToText("  这意味着你有更高的概率是善良阵营，但也等于你需要说服更多人加入你的教派。在一个九人游戏中，有七名善良玩家，");
    g_tipLine[15380] = StringToText("  只有两名邪恶玩家，所以虽然你与邪恶玩家邻座的概率要低很多，但你需要说服其他多达六人加入你的教派。");
    g_tipRoleAt[106] = 15317; g_tipRoleN[106] = 64; g_tipP1At[106] = 15319; g_tipP1N[106] = 10; g_tipP2At[106] = 15347; g_tipP2N[106] = 4;
    g_tipAbility[106] = StringToText("每个夜晚，你会转变为与你邻近的一名存活的玩家的阵营。每个白天，你可以提议所有玩家加入你的教派，如果所有善良玩家同意加入，你的阵营获胜。");
    g_tipLine[15381] = StringToText("【背景故事】");
    g_tipLine[15382] = StringToText("「在文明的浅薄外表之下，藏着呼之欲出的疯狂。」");
    g_tipLine[15383] = StringToText("【角色能力】");
    g_tipLine[15384] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，并且当晚恶魔不会造成死亡。");
    g_tipLine[15385] = StringToText("会有一名善良玩家始终被当作邪恶阵营。");
    g_tipLine[15386] = StringToText("【角色简介】");
    g_tipLine[15387] = StringToText("半兽人会在夜晚游荡，猎杀无辜，与此同时恶魔在自己的老巢里蛰伏。");
    g_tipLine[15388] = StringToText("· 半兽人必须在每个夜晚选择一名存活的玩家。如果半兽人选择了已死亡的玩家，说书人会摇头并让半兽人重新选择。");
    g_tipLine[15389] = StringToText("· 如果半兽人选择的玩家是善良玩家，那名玩家死亡，并且当晚恶魔不能造成死亡。");
    g_tipLine[15390] = StringToText("· 如果半兽人选择的玩家是邪恶玩家，那名玩家不会死亡，并且恶魔可以造成死亡。");
    g_tipLine[15391] = StringToText("· 如果半兽人攻击了善良的玩家但没有导致那名玩家死亡，恶魔可以造成死亡。");
    g_tipLine[15392] = StringToText("· 恶魔与造成死亡无关的能力仍然会正常运作，不会受到半兽人的能力影响。");
    g_tipLine[15393] = StringToText("· 一名善良玩家始终被当作邪恶阵营。他同样也被半兽人当作邪恶阵营，因此半兽人无法杀死这名玩家。");
    g_tipLine[15394] = StringToText("【范例】");
    g_tipLine[15395] = StringToText("半兽人攻击了将军，将军死亡。当晚的稍晚时分，小恶魔攻击了失忆者，失忆者没有死亡，因为今晚小恶魔无法造成死亡。");
    g_tipLine[15396] = StringToText("半兽人攻击了农夫，农夫死亡，一名善良玩家变成了农夫。上个夜晚因普卡而中毒的魔术师今晚不会死亡，");
    g_tipLine[15397] = StringToText("  因为今晚普卡无法造成死亡。");
    g_tipLine[15398] = StringToText("狂热者由于半兽人的能力被当作邪恶阵营。半兽人攻击了教父，教父没有死亡，因为教父是邪恶的。下一个夜晚，");
    g_tipLine[15399] = StringToText("  半兽人攻击了狂热者，狂热者没有死亡，因为半兽人把狂热者当作了邪恶玩家。当晚，亡骨魔攻击了半兽人，半兽人死亡。");
    g_tipLine[15400] = StringToText("【运作方式】");
    g_tipLine[15401] = StringToText("在为首个夜晚进行准备时，将半兽人的「失足」提示标记放置在任意善良角色标记旁，标记那名玩家为「失足」。");
    g_tipLine[15402] = StringToText("除首个夜晚之外的每个夜晚，唤醒半兽人。让他指向任意一名存活的玩家。让半兽人重新入睡。如果被选择的玩家是善良的，");
    g_tipLine[15403] = StringToText("  那名玩家死亡——在那名玩家的角色标记旁放置「死亡」标记。当晚，和平常一样唤醒恶魔进行选择，但是恶魔无法造成死亡。");
    g_tipLine[15404] = StringToText("  如果被选择的玩家是邪恶的，什么事都不会发生。");
    g_tipLine[15405] = StringToText("【提示标记】");
    g_tipLine[15406] = StringToText("· 失足");
    g_tipLine[15407] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[15408] = StringToText("放置条件：放置在任意一个善良玩家的角色标记旁边，可以是半兽人自己。");
    g_tipLine[15409] = StringToText("移除条件：半兽人死亡或离场时。");
    g_tipLine[15410] = StringToText("· 死亡");
    g_tipLine[15411] = StringToText("放置时机：在半兽人夜晚行动并选择了玩家后放置。");
    g_tipLine[15412] = StringToText("放置条件：半兽人选择的玩家当前存活，为善良玩家，且能被半兽人杀死，且半兽人未醉酒中毒，");
    g_tipLine[15413] = StringToText("  那么在该玩家的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[15414] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[15415] = StringToText("【提示与技巧】");
    g_tipLine[15416] = StringToText("· 尝试辨认出那些即使死亡也不会给善良阵营带来灾难性能力损失的善良玩家。");
    g_tipLine[15417] = StringToText("  通过杀死他们并确认他们是善良阵营来在你的盟友间组建信任圈。");
    g_tipLine[15418] = StringToText("· 提防那些可以被当作不同阵营的角色，例如间谍和陌客。即使你选择了他们，他们也可能（一反常态地）");
    g_tipLine[15419] = StringToText("  死于夜晚或在夜晚存活，从而混淆你的信息。");
    g_tipLine[15420] = StringToText("· 为了重新夺回夜间死亡的控制权，邪恶阵营会试图无效化你的能力。因此要考虑在白天的发言中保持一定的含蓄。");
    g_tipLine[15421] = StringToText("· 为了尽可能建立与其他善良玩家信任并分享给善良团队更多信息，可以在第一天就公开宣称是半兽人。");
    g_tipLine[15422] = StringToText("  由于是你在选择谁死于夜晚，因此唯一令你死亡的方法就是被善良阵营处决。你不需要担心恶魔会杀了你，");
    g_tipLine[15423] = StringToText("  所以坦诚地公开你的信息通常会对善良阵营有帮助。然而，如果剧本里有邪恶角色可以以其他方式杀死你，");
    g_tipLine[15424] = StringToText("  例如刺客或是精神病患者，或者如果你无法确定哪些玩家是善良和邪恶的并且到目前为止在夜晚只选择过邪恶玩家，");
    g_tipLine[15425] = StringToText("  你也许会想推迟一两天公开宣告你是半兽人。邪恶阵营希望尽早移除半兽人，但他们通常做不到，所以请随意公开角色。");
    g_tipLine[15426] = StringToText("  不过要小心投毒者，如果你现身，他们可以无效化你的能力而不是杀死你，你将不能判断你选择了一个邪恶玩家还是已经中毒！");
    g_tipLine[15427] = StringToText("· 不要害怕在晚上攻击善良玩家。如果你攻击了一名邪恶玩家，就相当于允许恶魔攻击一名善良玩家。");
    g_tipLine[15428] = StringToText("  既然一名善良玩家几乎一定会成为夜晚死亡的那个人，那么你更愿意让谁来选择哪名善良玩家死亡？是你还是恶魔？");
    g_tipLine[15429] = StringToText("· 如果你相当确定一名特定玩家是邪恶的，并且并不介意证实自己是否正确可能会导致你死亡，那就在夜晚攻击他。");
    g_tipLine[15430] = StringToText("  如果他是邪恶的，他不会因为你选择了他而死亡。要么恶魔偶然间杀死了他们，从而为你杀死了一名邪恶玩家，");
    g_tipLine[15431] = StringToText("  要么他们没有死亡，而恶魔杀死了另一名玩家——哪个都很好因为你刚了解到某名特定玩家是邪恶的，");
    g_tipLine[15432] = StringToText("  而死亡的玩家几乎一定是善良的。");
    g_tipLine[15433] = StringToText("· 第二天开始，恶魔（稍后整个邪恶阵营）可能会知道有半兽人在场。因为恶魔会选择在夜晚杀死一名玩家，");
    g_tipLine[15434] = StringToText("  但另一名玩家会在早晨被发现死亡。因此恶魔会很快地假定有一个半兽人。如果你不希望恶魔知道你的角色，");
    g_tipLine[15435] = StringToText("  不要保持沉默而是伪装成另一个不同的角色，因为所有其他玩家都会揭露他们的角色。");
    g_tipLine[15436] = StringToText("· 如果你公开宣称是半兽人，玩家们可能会在白天建议你当晚攻击哪些玩家。你可以听取团队建议，也可以更加隐秘而独立。");
    g_tipLine[15437] = StringToText("  毕竟邪恶玩家们可能会在攻击目标上给你糟糕的建议，在最后一刻改变想法一定会引起他们警觉。");
    g_tipRoleAt[107] = 15381; g_tipRoleN[107] = 57; g_tipP1At[107] = 15383; g_tipP1N[107] = 11; g_tipP2At[107] = 0; g_tipP2N[107] = 0;
    g_tipAbility[107] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，并且当晚恶魔不会造成死亡。会有一名善良玩家始终被当作邪恶阵营。");
    g_tipLine[15438] = StringToText("【背景故事】");
    g_tipLine[15439] = StringToText("「我看到了，真的。我那会儿正在长椅上整理赞美诗册，突然一首可怕的管风琴曲子在我耳边响起。那风琴手披着一件长斗篷，");
    g_tipLine[15440] = StringToText("  他修长的手指搭在琴键上。他有一顶帽子……就像是……你现在戴着的这顶。」");
    g_tipLine[15441] = StringToText("【角色能力】");
    g_tipLine[15442] = StringToText("如果恶魔杀死了国王，你会得知哪名玩家是恶魔。[+国王]");
    g_tipLine[15443] = StringToText("【角色简介】");
    g_tipLine[15444] = StringToText("唱诗男孩会在国王被戕害时得知谁是恶魔。");
    g_tipLine[15445] = StringToText("· 国王可以在唱诗男孩不在场时出现在游戏中。在游戏设置阶段，如果唱诗男孩在场而国王不在场，");
    g_tipLine[15446] = StringToText("  那么国王就会被添加进来并替换掉一个其他镇民。而如果国王已经在场，唱诗男孩不会因此再将另外一名国王添加进场。");
    g_tipLine[15447] = StringToText("· 如果恶魔使用自己的能力杀死了国王，唱诗男孩会得知哪名玩家是恶魔。恶魔提名并处决国王时，");
    g_tipLine[15448] = StringToText("  不算做使用自己的能力杀死国王。爪牙使用能力杀死国王，例如刺客，也不会计算在内。");
    g_tipLine[15449] = StringToText("· 如果恶魔攻击了国王但未能将其杀死，唱诗男孩不会得知恶魔是谁。");
    g_tipLine[15450] = StringToText("· 唱诗男孩得知的是恶魔的具体玩家，但不得知具体角色。");
    g_tipLine[15451] = StringToText("【范例】");
    g_tipLine[15452] = StringToText("小恶魔攻击了共情者，共情者死亡。下一个夜晚，小恶魔攻击了被僧侣保护的国王，国王没有死亡。再下一个夜晚，");
    g_tipLine[15453] = StringToText("  小恶魔攻击了国王，此时僧侣没有保护国王，国王死亡。唱诗男孩被说书人唤醒，并得知了一名恶魔玩家。");
    g_tipLine[15454] = StringToText("沙巴洛斯杀死了国王。醉酒的唱诗男孩被唤醒，并得知了角色为食人族的玩家是恶魔。");
    g_tipLine[15455] = StringToText("【运作方式】");
    g_tipLine[15456] = StringToText("在进行游戏设置，将角色标记放进盲抽袋之前，如果国王不在即将要放入盲抽袋的这些角色之中，那么移除一个镇民角色标记，");
    g_tipLine[15457] = StringToText("  并加入国王。");
    g_tipLine[15458] = StringToText("除首个夜晚之外的每个夜晚，如果恶魔杀死了国王，在让恶魔重新入睡后唤醒唱诗男孩。对他指向一名恶魔玩家。");
    g_tipLine[15459] = StringToText("  然后让唱诗男孩重新入睡。");
    g_tipLine[15460] = StringToText("【提示标记】");
    g_tipLine[15461] = StringToText("无");
    g_tipLine[15462] = StringToText("【提示与技巧】");
    g_tipLine[15463] = StringToText("· 唱诗男孩是恶魔的隐患，不知道你是否在场会让恶魔对待国王时谨慎行事。恶魔会变得进退两难，如果让国王活得过久，");
    g_tipLine[15464] = StringToText("  那么可能会令他们在关键时刻获得重要信息来影响游戏胜负，（反之，你会直接得知恶魔）。");
    g_tipLine[15465] = StringToText("  尽可能活下去来保持对恶魔的持续压力。");
    g_tipLine[15466] = StringToText("· 即使你死了，也不要暴露角色，你的存活就是对恶魔的一种威胁。你可以将你的角色信息带入坟墓。");
    g_tipLine[15467] = StringToText("  如果你的角色被其他角色知晓了，比如送葬者或是筑梦师，可以尝试和他们沟通让他们隐瞒你的角色。");
    g_tipLine[15468] = StringToText("  一个不知道存活与否的唱诗男孩对于恶魔的威胁程度和一个存活的唱诗男孩一样大。");
    g_tipLine[15469] = StringToText("· 如果国王公开现身，尽量谨慎地与之沟通。当一名玩家过于明显地寻找国王时，");
    g_tipLine[15470] = StringToText("  也等同于间接向邪恶阵营传递自己就是唱诗男孩的信号，你可以尝试寻找另一名值得信任的玩家，");
    g_tipLine[15471] = StringToText("  让他们代表你与国王进行沟通，即使他们不告诉国王你是谁，让国王得知唱诗男孩在场也已足够，这样会让他们更安全。");
    g_tipLine[15472] = StringToText("· 即使没有人承认自己是国王，你也要清楚地明白你在场等于国王在场，他们因为某种原因不愿暴露自己。在这个层面上，");
    g_tipLine[15473] = StringToText("  只有你和恶魔能确定国王在场，但恶魔还有知道国王是谁的优势，并且可能困惑于他们为什么不暴露自己。");
    g_tipLine[15474] = StringToText("· 你可以尝试和一名值得信任的玩家互相交换角色，让他们去宣称自己是唱诗男孩，");
    g_tipLine[15475] = StringToText("  如果恶魔杀死了假冒的唱诗男孩然后再自信地杀死国王，你就可以轻易得知恶魔。当然，如果表现得过于明显，");
    g_tipLine[15476] = StringToText("  恶魔也许不会相信。无论如何，这份犹豫能帮助国王存活。");
    g_tipRoleAt[108] = 15438; g_tipRoleN[108] = 39; g_tipP1At[108] = 15441; g_tipP1N[108] = 10; g_tipP2At[108] = 0; g_tipP2N[108] = 0;
    g_tipAbility[108] = StringToText("如果恶魔杀死了国王，你会得知哪名玩家是恶魔。[+国王]");
    g_tipLine[15477] = StringToText("【背景故事】");
    g_tipLine[15478] = StringToText("「当一个人开始认为某件事只不过是另一件事时，那么他通常都处在错误的边缘。耐心，耐心。不要把‘只不过’和‘应该’，");
    g_tipLine[15479] = StringToText("  ‘是’和‘不是’混为一谈。」");
    g_tipLine[15480] = StringToText("【角色能力】");
    g_tipLine[15481] = StringToText("一名玩家醉酒，即使你已死亡。每局游戏限一次，你可以猜测谁是那个醉酒的玩家，如果猜对了，你会得知谁是恶魔，");
    g_tipLine[15482] = StringToText("  但如果猜错了，你会得知错误的「谁是恶魔」信息。");
    g_tipLine[15483] = StringToText("【角色简介】");
    g_tipLine[15484] = StringToText("解谜大师需要尝试找出谁醉酒了。");
    g_tipLine[15485] = StringToText("· 会有一名玩家因为解谜大师的能力在整局游戏中醉酒。通常来说会是镇民，也有可能会是外来者。该玩家不会知道自己醉酒了。");
    g_tipLine[15486] = StringToText("· 每局游戏限一次，解谜大师可以猜测谁是那名醉酒的玩家。可以进行公开猜测，也可以私下找说书人猜测。不论他猜了什么，");
    g_tipLine[15487] = StringToText("  说书人都会私下告诉解谜大师一名玩家的名字。如果解谜大师猜测正确，他得知的会是恶魔玩家。如果解谜大师猜测错误，");
    g_tipLine[15488] = StringToText("  他得知的则是非恶魔玩家。");
    g_tipLine[15489] = StringToText("· 解谜大师不会得知自己的猜测正确与否。");
    g_tipLine[15490] = StringToText("· 只有猜中因解谜大师的能力醉酒的玩家才算作猜测正确。猜测因为其他原因醉酒的玩家不算猜测正确。");
    g_tipLine[15491] = StringToText("· 在解谜大师死亡后，他的能力造成的醉酒玩家会依然醉酒。已经死亡的解谜大师不能猜测，");
    g_tipLine[15492] = StringToText("  他这一部分的能力因为死亡而失去了。");
    g_tipLine[15493] = StringToText("【范例】");
    g_tipLine[15494] = StringToText("小艾是恶魔。小美是共情者，但因为解谜大师而醉酒了，并且一直获得的是错误信息。解谜大师公开猜测小美醉酒了，");
    g_tipLine[15495] = StringToText("  随后说书人私下告诉他「小艾是恶魔」。");
    g_tipLine[15496] = StringToText("小莱是恶魔。小八死亡并且因为解谜大师而醉酒。小明存活并且因为水手醉酒。解谜大师私下向说书人猜测醉酒的是小明，");
    g_tipLine[15497] = StringToText("  随后说书人告知他「小黑是恶魔」。");
    g_tipLine[15498] = StringToText("【运作方式】");
    g_tipLine[15499] = StringToText("在为首个夜晚做准备时，选择任意一名玩家，并在这名玩家的角色标记旁放置解谜大师的「醉酒」提示标记。该玩家醉酒。");
    g_tipLine[15500] = StringToText("在游戏中的任意时间里，解谜大师都可以公开或私下找你猜测醉酒的玩家。如果他猜测的玩家，");
    g_tipLine[15501] = StringToText("  其角色标记旁有解谜大师的「醉酒」提示标记，私下告诉解谜大师谁是恶魔。如果他猜测的玩家，");
    g_tipLine[15502] = StringToText("  其角色标记旁没有解谜大师的「醉酒」提示标记，告诉解谜大师一名非恶魔玩家是恶魔。");
    g_tipLine[15503] = StringToText("  （不要告诉解谜大师他猜测结果是否正确。）不论上述哪种情况发生，使用解谜大师的「已猜测」");
    g_tipLine[15504] = StringToText("  提示标记放置在解谜大师的角色标记旁。");
    g_tipLine[15505] = StringToText("仅在你有充足的理由的情况下，才让解谜大师的能力使爪牙或恶魔醉酒。绝大多数情况下，让镇民醉酒都是较为优先的选择。");
    g_tipLine[15506] = StringToText("【提示标记】");
    g_tipLine[15507] = StringToText("· 醉酒");
    g_tipLine[15508] = StringToText("放置时机：在为首个夜晚做准备时。");
    g_tipLine[15509] = StringToText("放置条件：任意一名玩家的角色标记旁。");
    g_tipLine[15510] = StringToText("移除时机：解谜大师离场时。");
    g_tipLine[15511] = StringToText("· 已猜测");
    g_tipLine[15512] = StringToText("放置时机：在解谜大师使用能力进行猜测之后。");
    g_tipLine[15513] = StringToText("放置条件：放置在解谜大师的角色标记旁。");
    g_tipLine[15514] = StringToText("移除时机：解谜大师死亡或离场时。");
    g_tipLine[15515] = StringToText("【规则细节】");
    g_tipLine[15516] = StringToText("· 如果场上存在多名恶魔，只告诉解谜大师一名恶魔。优先告诉解谜大师当前存活的邪恶的恶魔。");
    g_tipLine[15517] = StringToText("· 特定角色互动：");
    g_tipLine[15518] = StringToText("  · 哈迪寂亚/沙巴洛斯：如果解谜大师复活，因解谜大师而醉酒的玩家可以改变，解谜大师也会刷新猜测能力。");
    g_tipLine[15519] = StringToText("  · 食人族：如果食人族获得解谜大师的能力，会有某名玩家因此开始醉酒，直到其他玩家被处决并死亡。在此期间，");
    g_tipLine[15520] = StringToText("    食人族解谜大师可以猜测因其被醉酒的玩家并被告知恶魔。如果食人解谜大师在获得新的能力前就死亡，");
    g_tipLine[15521] = StringToText("    他会继续使那名玩家醉酒直到游戏结束。");
    g_tipLine[15522] = StringToText("【提示与技巧】");
    g_tipLine[15523] = StringToText("· 你是截至目前为止最强大的外来者。一旦你找到了醉酒的玩家，你就破解了整个游戏！把自己当作一个镇民。");
    g_tipLine[15524] = StringToText("  尽可能存活并确保你可以在死前使用你的能力。");
    g_tipLine[15525] = StringToText("· 你让某人醉酒。这是善良阵营需要得知的最关键的信息。确保在可行的情况让他们尽快意识到这点，");
    g_tipLine[15526] = StringToText("  以便善良玩家能够将醉酒纳入考虑，并帮助你寻找那个醉酒的玩家。");
    g_tipLine[15527] = StringToText("· 不要马上作为解谜大师现身，否则恶魔很可能会杀了你。解谜大师对恶魔尤其可怕，恶魔害怕那些能知道他们是谁的角色。");
    g_tipLine[15528] = StringToText("· 在你使用能力的同时告诉团队你是解谜大师。像猎手一样，善良阵营在你使用能力前并不需要知道你是谁。");
    g_tipLine[15529] = StringToText("· 就你应当选择的目标向团队寻求建议。他们可能知道一些你不知道的事情。");
    g_tipLine[15530] = StringToText("· 基于收集信息的目的向你认为是善良的玩家透露你是谁。如果他们掌握的信息对他们而言不合理，");
    g_tipLine[15531] = StringToText("  那么你可能已经找到了醉酒玩家并且会是你猜测的绝佳候选人。");
    g_tipLine[15532] = StringToText("· 如果一名玩家使用了公开能力，而那个能力显然没有生效，尽快对此名玩家使用你的猜测。比如，如果一名玩家宣称是贞洁者，");
    g_tipLine[15533] = StringToText("  但是在被提名时没有导致死亡，或者一名玩家宣称是魔像，但他提名时没有人死亡，那么他们可能是醉酒的玩家。");
    g_tipLine[15534] = StringToText("  这并不一定正确，因为玩家可能只是在伪装成那个角色，但是这种情况仍然很有帮助。");
    g_tipLine[15535] = StringToText("· 多数玩家都有动机起身或活跃起来与人交谈——试着去说话或劝服。但解谜大师最好反过来做。保持沉默，观察，倾听。");
    g_tipLine[15536] = StringToText("  尽可能多地关注其他玩家的行动和信息。你不需要关注谁是善良谁是邪恶，只需要关注信息无法说通的玩家，");
    g_tipLine[15537] = StringToText("  或者看起来状态比较奇怪。发现一名醉酒玩家会有一定难度，所以慢慢来。");
    g_tipLine[15538] = StringToText("· 当你进行猜测而说书人告诉了你一名玩家，处决他们。如果你的猜测是正确的，善良阵营会获胜。如果你的猜测是错误的，");
    g_tipLine[15539] = StringToText("  伤害也不会很大，游戏将继续。");
    g_tipLine[15540] = StringToText("· 如果你真的对谁醉酒毫无头绪，猜测你自己！考虑到你几乎肯定不是那个醉酒的人，你会得知一名不是恶魔的玩家。");
    g_tipLine[15541] = StringToText("  这也还有些用——尤其是当那名玩家在最后一天仍然存活时。");
    g_tipLine[15542] = StringToText("· 你知道一名醉酒玩家在场。即使你不进行猜测你也知道这点。这让你几乎像图书管理员一样强大。像图书管理员一样操作，");
    g_tipLine[15543] = StringToText("  为善良阵营的信息池做出贡献。");
    g_tipLine[15544] = StringToText("· 回溯你的信息。如果你被告知是恶魔的玩家被处决后游戏继续，那么此玩家不是恶魔。这意味着你猜测的玩家不是醉酒玩家。");
    g_tipLine[15545] = StringToText("  如果你相信这名玩家是善良的，那么这是一个有用的信息。");
    g_tipRoleAt[109] = 15477; g_tipRoleN[109] = 69; g_tipP1At[109] = 15480; g_tipP1N[109] = 13; g_tipP2At[109] = 15515; g_tipP2N[109] = 7;
    g_tipAbility[109] = StringToText("一名玩家醉酒，即使你已死亡。每局游戏限一次，你可以猜测谁是那个醉酒的玩家，如果猜对了，你会得知谁是恶魔，但如果猜错了，你会得知错误的「谁是恶魔」信息。");
    g_tipLine[15546] = StringToText("【背景故事】");
    g_tipLine[15547] = StringToText("「和你聊天让我很享受。你的想法很有吸引力，和我的想法很相似。除非……这只是你的疯言疯语。」");
    g_tipLine[15548] = StringToText("【角色能力】");
    g_tipLine[15549] = StringToText("如果有大于等于五名玩家存活，你必须在所有提名中投票。");
    g_tipLine[15550] = StringToText("【角色简介】");
    g_tipLine[15551] = StringToText("狂热者热衷于所有投票。");
    g_tipLine[15552] = StringToText("· 如果存活玩家数量为五人或更多，狂热者必须在所有提名中投票。如果只有四名或更少的玩家存活，");
    g_tipLine[15553] = StringToText("  狂热者可以自由选择是否参与投票。");
    g_tipLine[15554] = StringToText("· 在狂热者的能力中，旅行者的数量也计入存活玩家的数量内。");
    g_tipLine[15555] = StringToText("· 如果狂热者死亡，他可以像其他死亡玩家一样正常选择是否投票。");
    g_tipLine[15556] = StringToText("· 狂热者在流放中不是必须要举手赞成的。");
    g_tipLine[15557] = StringToText("· 即使狂热者认定自己醉酒或中毒，他也必须强制参与投票。");
    g_tipLine[15558] = StringToText("· 说书人没有义务提醒狂热者。狂热者必须为自己的投票行为负责。故意不参与投票将被认定为作弊。");
    g_tipLine[15559] = StringToText("【范例】");
    g_tipLine[15560] = StringToText("有七名玩家存活。狂热者在对戏法师、召唤师、食人魔和报丧女妖的提名中都参与了投票。在下一个白天，有五名玩家存活。");
    g_tipLine[15561] = StringToText("  狂热者在对瘟疫医生和女祭司的提名中都参与了投票。在下一个白天，只有三名玩家存活。");
    g_tipLine[15562] = StringToText("  狂热者在对牙噶巴卜的提名中参与了投票，但没有在对女祭司的提名中投票。");
    g_tipLine[15563] = StringToText("有九名玩家存活。狂热者死亡了。在这之后，他在三个白天都没有投票，并在只有三名玩家存活时使用自己的投票标记在对农夫");
    g_tipLine[15564] = StringToText("  提名中进行了投票。");
    g_tipLine[15565] = StringToText("【运作方式】");
    g_tipLine[15566] = StringToText("在每次提名中，如果当前有五名或更多玩家存活，狂热者必须举手投票。");
    g_tipLine[15567] = StringToText("如果狂热者不小心忘记了投票，不要统计他的票。因为如果你统计了票数，实际总票数会比原本总票数多，");
    g_tipLine[15568] = StringToText("  因此所有玩家都会知道谁是狂热者，这对邪恶阵营来说非常不公平。人总会犯错。继续进行游戏，并在稍后私下提示狂热者。");
    g_tipLine[15569] = StringToText("【提示标记】");
    g_tipLine[15570] = StringToText("无");
    g_tipLine[15571] = StringToText("【规则细节】");
    g_tipLine[15572] = StringToText("· 相克规则：");
    g_tipLine[15573] = StringToText("  · 食人族：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[15574] = StringToText("  · 维齐尔：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[15575] = StringToText("  · 军团：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[15576] = StringToText("【提示与技巧】");
    g_tipLine[15577] = StringToText("· 投票！！！！！！");
    g_tipLine[15578] = StringToText("· 积极参与关于应该提名谁的讨论。虽然你必须对每次提名进行投票，但你可以通过说服其他玩家提名你更愿意投票的人来掌控处决");
    g_tipLine[15579] = StringToText("  的主动权。");
    g_tipLine[15580] = StringToText("· 假装成那些从其他玩家被处决中获益的角色，例如送葬者或食人族。这可能会让玩家之间感到疑惑——你总是投票是因为你是狂热者");
    g_tipLine[15581] = StringToText("  ，还是因为你真的很想看到某个人被处决？");
    g_tipLine[15582] = StringToText("· 告诉大家你是狂热者。如果其他玩家知道你会对每次提名投票，这将帮助他们决定他们想投票支持谁。");
    g_tipLine[15583] = StringToText("· 你要明白，由于你对所有提名都投票，其他人可能会对你产生怀疑。");
    g_tipLine[15584] = StringToText("· 如果有旅行者加入游戏，鼓励他们扮演官员或窃贼！");
    g_tipLine[15585] = StringToText("· 与团队合作，将游戏推进到存活玩家少于5人的那一天，这样你就可以自由地投票。");
    g_tipLine[15586] = StringToText("· 如果你在游戏接近尾声时还活着，充分利用最后一天吧！这很可能是游戏中第一次你能自主决定如何投票的机会。");
    g_tipLine[15587] = StringToText("· 如果剧本中有狂热者这个角色，要非常仔细地观察投票，来判断游戏中是否有狂热者参与。");
    g_tipLine[15588] = StringToText("· 如果你是一个希望在夜晚被杀的角色，参与所有的投票，以说服邪恶阵营你是狂热者。");
    g_tipRoleAt[110] = 15546; g_tipRoleN[110] = 43; g_tipP1At[110] = 15548; g_tipP1N[110] = 11; g_tipP2At[110] = 15571; g_tipP2N[110] = 5;
    g_tipAbility[110] = StringToText("如果有大于等于五名玩家存活，你必须在所有提名中投票。");
    g_tipLine[15589] = StringToText("【背景故事】");
    g_tipLine[15590] = StringToText("「在宇宙的阴影之中，被遗忘的角落里，星辰向虚空低声诉说着秘密，那些深邃的真理，");
    g_tipLine[15591] = StringToText("  仅是一瞥就能让肉体凡胎的心智崩溃瓦解。」");
    g_tipLine[15592] = StringToText("【角色能力】");
    g_tipLine[15593] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[邪恶角色全部邻座，你靠近正中，+1爪牙，-或+任意数量外来者]");
    g_tipLine[15594] = StringToText("【角色简介】");
    g_tipLine[15595] = StringToText("堤丰之首被爪牙围绕。");
    g_tipLine[15596] = StringToText("· 所有邪恶角色玩家全都连续相邻而坐。");
    g_tipLine[15597] = StringToText("· 在游戏开始时，堤丰之首的左右两侧必须都要有邪恶角色玩家。他不能位于一连串邪恶角色玩家队列的两侧。");
    g_tipLine[15598] = StringToText("· 邪恶阵营在游戏开始时有一名额外的爪牙。");
    g_tipLine[15599] = StringToText("· 可能会有任意数量的外来者在场。");
    g_tipLine[15600] = StringToText("· 与提线木偶相似，由说书人来决定哪名玩家在初始设置时成为爪牙。此外说书人还会决定爪牙的具体角色。");
    g_tipLine[15601] = StringToText("· 如果堤丰之首在游戏中途被创造，则他无需与其他邪恶角色玩家的位置相邻。");
    g_tipLine[15602] = StringToText("【范例】");
    g_tipLine[15603] = StringToText("在一局游戏中有两名爪牙：街头风琴手和灵言师。堤丰之首位于他们中间，三人相邻而坐。外来者的数量没有出现异常。");
    g_tipLine[15604] = StringToText("维齐尔与鹰身女妖相邻，鹰身女妖的另一侧则是堤丰之首，而堤丰之首的另一侧是哥布林。本局为10人游戏，");
    g_tipLine[15605] = StringToText("  因为堤丰之首的能力而使得有两名外来者在场。");
    g_tipLine[15606] = StringToText("恐惧之灵与炸弹人相邻，炸弹人的另一侧是堤丰之首，堤丰之首的另一侧是投毒者，投毒者的另一侧是主谋。");
    g_tipLine[15607] = StringToText("  本局为15人游戏，但没有外来者在场，因为堤丰之首移除了一个外来者，而解谜大师在首夜变成了炸弹人。");
    g_tipLine[15608] = StringToText("【运作方式】");
    g_tipLine[15609] = StringToText("在进行游戏设置时，将角色标记放入盲抽袋前，移除所有的爪牙角色标记，并加入等量的镇民或外来者角色标记作为补充。");
    g_tipLine[15610] = StringToText("在首个夜晚，分别依次唤醒位于堤丰之首两侧的，等同于常规游戏爪牙数量加一的玩家。");
    g_tipLine[15611] = StringToText("  分别对这些玩家展示一个不同的爪牙角色标记和朝下的大拇指，再让他们重新入睡。");
    g_tipLine[15612] = StringToText("  再用展示给他们的爪牙角色标记替换魔典中这些玩家的善良角色标记。然后再如常进行爪牙信息和恶魔信息步骤。");
    g_tipLine[15613] = StringToText("在除首个夜晚以外的每个夜晚，唤醒堤丰之首。让他指向任意一名玩家。那名玩家死亡——用「死亡」提示标记标记那名玩家。");
    g_tipLine[15614] = StringToText("  让堤丰之首重新入睡。");
    g_tipLine[15615] = StringToText("【提示标记】");
    g_tipLine[15616] = StringToText("· 死亡");
    g_tipLine[15617] = StringToText("放置时机：在堤丰之首夜晚行动并选择了玩家后放置。");
    g_tipLine[15618] = StringToText("放置条件：堤丰之首选择的玩家当前存活，且能被堤丰之首杀死，且堤丰之首未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[15619] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[15620] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[15621] = StringToText("【规则细节】");
    g_tipLine[15622] = StringToText("· 虽然在运作方式中没有提到，然而堤丰之首在设置时也可以移除一部分原有的外来者，并用对应数量的镇民进行替换。");
    g_tipLine[15623] = StringToText("· 如果游戏因堤丰之首而导致有4名邪恶爪牙在场，那么堤丰之首可以不在这5名邪恶玩家的正中间（但不能位于一连串邪恶角色");
    g_tipLine[15624] = StringToText("  玩家队列的两侧）。");
    g_tipLine[15625] = StringToText("· 相克规则：");
    g_tipLine[15626] = StringToText("  · 召唤师：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[15627] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[15628] = StringToText("  · 戏子：堤丰之首和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变成戏子，");
    g_tipLine[15629] = StringToText("    说书人会在这一效果生效之前先告知堤丰之首两侧的玩家是邪恶的爪牙。");
    g_tipLine[15630] = StringToText("【提示与技巧】");
    g_tipLine[15631] = StringToText("· 如果你是爪牙，直接使用你在游戏开始时抽到的角色作为伪装。如果善良阵营找出了一名邪恶玩家，并发现堤丰之首在场，");
    g_tipLine[15632] = StringToText("  他们就能找出整个邪恶团队。所以你必须看起来非常像是善良的。");
    g_tipLine[15633] = StringToText("· 如果你是爪牙，并且开局抽到的角色是外来者，那么就使用恶魔的其中一个伪装。");
    g_tipLine[15634] = StringToText("  因为如果让善良阵营认为游戏中的外来者数量不合标准，这会指出堤丰之首在场。");
    g_tipLine[15635] = StringToText("· 如果你是爪牙，并且你使用其他角色作为伪装，记得将你开局抽到的角色作为备用计划。");
    g_tipLine[15636] = StringToText("· 藏起来！堤丰之首这种恶魔并不适合高风险高收益的玩法。谨慎考虑作为一个明跳出来的邪恶玩家所带来的后果。");
    g_tipLine[15637] = StringToText("· 利用好额外爪牙带来的优势。额外增加一名爪牙意味着你们能以更多票数压倒善良阵营，");
    g_tipLine[15638] = StringToText("  并且能在游戏后期有更多存活的邪恶玩家。");
    g_tipLine[15639] = StringToText("· 随时分析你们与善良阵营对票数的掌控能力对比。");
    g_tipLine[15640] = StringToText("· 不要形成一致票型。如果一条线并排的玩家一起投票，善良阵营会发现邪恶玩家连座的位置，");
    g_tipLine[15641] = StringToText("  特别是有卖花女孩这样的角色可以监测投票信息的时候。");
    g_tipLine[15642] = StringToText("· 利用邻座的优势来交换信息。在每个白天开始时随意闲聊！在夜晚时与邻座玩家窃窃私语！");
    g_tipLine[15643] = StringToText("  你们有着完美的座位优势来制定不间断的邪恶计划。");
    g_tipLine[15644] = StringToText("· 注意那些正在观察你与邻座玩家交谈的玩家。将这些玩家诬陷为邪恶的，以此来转移其他人对于你及你的阵营的注意力。");
    g_tipLine[15645] = StringToText("· 努力诋毁或是毒害那些有信息能够指向堤丰之首在场的玩家们。");
    g_tipLine[15646] = StringToText("· 当善良玩家还没法确定邪恶玩家在哪里时，让那些离你较远的玩家看起来是邪恶的。比如声称自己是城镇公告员，");
    g_tipLine[15647] = StringToText("  然后在只有坐在你对面的某名玩家提名之后，声称自己得知有爪牙提名；或是声称自己是占卜师，");
    g_tipLine[15648] = StringToText("  声称从离自己较远的两名玩家中得知「是」。");
    g_tipLine[15649] = StringToText("· 如果善良玩家正在锁定邪恶团队，你们就去诬陷你们这一排两头的那些善良玩家。");
    g_tipLine[15650] = StringToText("· 如果有玩家认为不是堤丰之首在场，就让他们这样想！爪牙应该做坏事来分散善良玩家的注意力并保护恶魔。");
    g_tipLine[15651] = StringToText("· 公开反对你的队友们，让你们看起来像是对立的阵营。");
    g_tipLine[15652] = StringToText("· 如果你没有坐在整个邪恶阵营的两头，你可以选择一些离你们这排较远的善良玩家，与他们建立信任。");
    g_tipLine[15653] = StringToText("【对抗堤丰之首】");
    g_tipLine[15654] = StringToText("· 注意玩家的投票票型。因为邪恶玩家们坐成一排，他们会为了最大化他们的控票力量而一同投票。");
    g_tipLine[15655] = StringToText("· 找出一名邪恶玩家。如果你找出了一名邪恶的爪牙，并且排除了其他恶魔在场的可能性，这会让你们找出剩下的整个邪恶团队。");
    g_tipLine[15656] = StringToText("· 找出善良玩家们，因为他们不可能与恶魔邻座——因为堤丰之首必须让邪恶玩家坐成一排，并让自己坐在靠近中间的位置，");
    g_tipLine[15657] = StringToText("  所以如果堤丰之首在场，恶魔在初始时总是与邪恶玩家邻座。");
    g_tipLine[15658] = StringToText("· 分析出是哪个恶魔在场。");
    g_tipLine[15659] = StringToText("· 注意有多少个爪牙能力正在生效。如果场上有额外的爪牙，那意味着堤丰之首在场。得知这一点会很有帮助。");
    g_tipLine[15660] = StringToText("· 如果你找出了一名爪牙，或者认为你找到了，那就杀死他们两边的玩家。如果是堤丰之首在场，");
    g_tipLine[15661] = StringToText("  你这样做就能保证杀死了一名爪牙，或两名爪牙，或是杀死恶魔。");
    g_tipRoleAt[111] = 15589; g_tipRoleN[111] = 73; g_tipP1At[111] = 15592; g_tipP1N[111] = 10; g_tipP2At[111] = 15621; g_tipP2N[111] = 9;
    g_tipAbility[111] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[邪恶角色全部邻座，你靠近正中，+1爪牙，-或+任意数量外来者]");
    g_tipLine[15662] = StringToText("【背景故事】");
    g_tipLine[15663] = StringToText("「步骤一：要变得可爱。步骤二：要统治世界。步骤三：先来点藻餐。」");
    g_tipLine[15664] = StringToText("【角色能力】");
    g_tipLine[15665] = StringToText("每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，可能会有一名玩家死亡。[+1爪牙]");
    g_tipLine[15666] = StringToText("【角色简介】");
    g_tipLine[15667] = StringToText("小怪宝不是玩家，而是被一名爪牙照顾的宝宝。");
    g_tipLine[15668] = StringToText("· 每个夜晚，所有爪牙玩家一起睁眼，他们秘密决定谁照顾小怪宝。爪牙们通过指向一名玩家或以其他明显的方式达成一致意见。");
    g_tipLine[15669] = StringToText("  如果他们不能达成一致，由说书人决定谁照顾小怪宝。");
    g_tipLine[15670] = StringToText("· 如果说书人觉得有趣，可以把小怪宝的角色标记交给正照顾小怪宝的玩家。他需要把小怪宝藏进他的口袋，放在他的帽子里，");
    g_tipLine[15671] = StringToText("  或其他合适的地方。玩家不能要求其他人清空他们的口袋。");
    g_tipLine[15672] = StringToText("· 正照顾小怪宝的玩家「是恶魔」。如果他死亡了，善良阵营获胜。他会被其他角色能力检测到「是恶魔」，例如占卜师。");
    g_tipLine[15673] = StringToText("· 如果一个善良玩家正照顾小怪宝，他「是恶魔」，但依旧是善良的。一个死亡玩家照顾小怪宝会让游戏结束，");
    g_tipLine[15674] = StringToText("  因为恶魔已经死亡了。");
    g_tipLine[15675] = StringToText("· 照顾小怪宝的玩家保留他原有的能力。");
    g_tipLine[15676] = StringToText("· 小怪宝不是玩家，所以不会醉酒或中毒。");
    g_tipLine[15677] = StringToText("【范例】");
    g_tipLine[15678] = StringToText("投毒者和寡妇一同被唤醒。他们先是互相指着对方，然后又分别指着自己，再是一同指向了寡妇。现在由寡妇来照看小怪宝。");
    g_tipLine[15679] = StringToText("  在下一个夜晚，他们一同指向了投毒者，因此改为由投毒者来照看小怪宝。");
    g_tipLine[15680] = StringToText("【运作方式】");
    g_tipLine[15681] = StringToText("在设置调整阶段，移除小怪宝的角色标记并加入一个爪牙角色标记。在首个夜晚，跳过爪牙信息和恶魔信息环节。");
    g_tipLine[15682] = StringToText("每个夜晚，唤醒所有爪牙。他们（最终）指向一名玩家。如果他们迟迟无法决定，由说书人选择一名玩家。（如果你愿意，");
    g_tipLine[15683] = StringToText("  把小怪宝的角色标记给这名玩家，并让他藏起来！）把「是恶魔」的提示标记放置在他的角色标记旁。让所有爪牙玩家入睡。");
    g_tipLine[15684] = StringToText("  之后，除了首个夜晚，一名玩家可能会死亡，在那名玩家旁放置「死亡」角色标记和帷幕标记。");
    g_tipLine[15685] = StringToText("被标记「是恶魔」的玩家会被当作恶魔。如果他死亡了，宣布游戏结束，善良阵营获胜。");
    g_tipLine[15686] = StringToText("你可能需要在夜晚利用小怪宝的能力杀死一到两名爪牙。如果在最后一天仍有两名及以上的爪牙存活，");
    g_tipLine[15687] = StringToText("  那么这对于善良阵营而言非常不公平，因为任意一个爪牙都有可能照顾小怪宝但善良玩家完全不知道是谁在照顾。");
    g_tipLine[15688] = StringToText("  为了避免这种情况以使得游戏对善良方更公平，请在游戏过程中杀死爪牙（有必要的话）以保证最后一天只剩一名爪牙存活。");
    g_tipLine[15689] = StringToText("【提示标记】");
    g_tipLine[15690] = StringToText("· 是恶魔");
    g_tipLine[15691] = StringToText("放置时机：在小怪宝的夜晚行动中，爪牙们决定了一个新的照看小怪宝的玩家时。");
    g_tipLine[15692] = StringToText("放置条件：放置在被爪牙选择来照看小怪宝的玩家的角色标记旁。");
    g_tipLine[15693] = StringToText("移除时机：照看小怪宝的玩家发生变化时移除，或小怪宝这个角色本身死亡或离场时移除。");
    g_tipLine[15694] = StringToText("· 死亡");
    g_tipLine[15695] = StringToText("放置时机：在除首个夜晚以外的夜晚里小怪宝行动时放置。");
    g_tipLine[15696] = StringToText("放置条件：由说书人来决定小怪宝攻击的玩家。如果该玩家当前存活且能被小怪宝杀死，那么在该玩家的角色标记旁放置，");
    g_tipLine[15697] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[15698] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[15699] = StringToText("【规则细节】");
    g_tipLine[15700] = StringToText("· 小怪宝这个角色也会被视作是「在场角色」，但它不属于任何一名玩家，也无法被常规的「选择一名玩家」的能力选中。");
    g_tipLine[15701] = StringToText("· 「非指向性」的死亡效果可以杀死小怪宝，例如麻脸巫婆、小怪宝等角色的能力。在这种情况下，小怪宝死亡，");
    g_tipLine[15702] = StringToText("  并会因此移除小怪宝的角色标记与所有提示标记。从现在起，小怪宝会被视作是「不在场」来处理。");
    g_tipLine[15703] = StringToText("· 如果某个能力让一名玩家变成小怪宝，该玩家的角色不会发生变化，而是改为正在照看小怪宝。");
    g_tipLine[15704] = StringToText("  但如果是工程师选择让小怪宝在场，会让一名恶魔因此变成一个正在照看小怪宝的不在场爪牙。");
    g_tipLine[15705] = StringToText("  反之如果工程师选择了其他的恶魔而导致小怪宝需要发生角色变化，当前照看小怪宝的玩家会变成工程师所选择的恶魔，");
    g_tipLine[15706] = StringToText("  同时小怪宝会离场。");
    g_tipLine[15707] = StringToText("· 相克规则：");
    g_tipLine[15708] = StringToText("  · 红唇女郎：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[15709] = StringToText("  · 魔术师：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_tipLine[15710] = StringToText("  · 罂粟种植者：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，直到其中一名玩家选择照看小怪宝。");
    g_tipLine[15711] = StringToText("  · 帽匠：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[15712] = StringToText("  · 精神病患者：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[15713] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[15714] = StringToText("  · 维齐尔：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[15715] = StringToText("【提示与技巧】");
    g_tipLine[15716] = StringToText("· 小怪宝的巨大优势之一是，邪恶阵营一开始就拥有一个额外的爪牙能力，而善良的队伍根本不知道这一点！");
    g_tipLine[15717] = StringToText("  最大化你的爪牙能力搞破坏 - 一个额外的投毒者、女巫甚至教父可以在善良阵营搞清什么发生在他们身上之前就为邪恶阵营");
    g_tipLine[15718] = StringToText("  掌控局势！阅读有趣的爪牙策略，准备好让他们尽快进入状态！");
    g_tipLine[15719] = StringToText("· 镇民们会关注有多少爪牙在场——比预期多的一个的话肯定会暴露出小怪宝正在他们的脚下乱窜！");
    g_tipLine[15720] = StringToText("  如果你想让好的团队对他们需要担心的恶魔保持悬念，请谨慎使用具有明显暗示的能力，");
    g_tipLine[15721] = StringToText("  例如洗脑师和刺客……至少在您设法说服他们之前。");
    g_tipLine[15722] = StringToText("· 因为恶魔是一个无助的宝宝，任何爪牙都可以看护恶魔在白天保护他们的安全。这样做的明显好处是，");
    g_tipLine[15723] = StringToText("  您可以将让宝宝四海为家，以躲避卖花女孩和占卜师等探测恶魔的能力，从而使他们的信息不一致且难以追踪！");
    g_tipLine[15724] = StringToText("  几乎每晚都换人看管小怪宝，意味着每晚被当作恶魔的人都在变化，这会给小镇的人造成巨大的混乱！");
    g_tipLine[15725] = StringToText("· 因为恶魔是一个无助的宝宝，他们特别容易受到伤害——如果你在看护宝宝时死亡，");
    g_tipLine[15726] = StringToText("  它会在另一个爪牙试图拯救他们之前就死亡！（红唇女郎是一个明显的例外，但你不能每次都依赖她！）");
    g_tipLine[15727] = StringToText("  通过将宝宝交给最可靠且最不可疑的爪牙来确保宝宝的安全 - 放在一个固定的人身上可能会降低大家能够找到恶魔的几率—");
    g_tipLine[15728] = StringToText("  —如果宝宝所在的地方完全安全，那么换爪牙来看护是没有意义的！");
    g_tipLine[15729] = StringToText("· 爪牙并不是唯一可以照看小怪宝的玩家！如果有足够多的爪牙同意，你可以把宝宝交给镇上的任何人。一般来说，");
    g_tipLine[15730] = StringToText("  不建议将宝宝交给善良玩家——他们不会喜欢这个小家伙，可能会为了伤害他而寻求被处决！");
    g_tipLine[15731] = StringToText("· 话虽如此，如果您在爪牙团队之外有一个盟友（例如，灵言师成功将一个善良玩家拉入伙），");
    g_tipLine[15732] = StringToText("  他们会成为出色的宝宝看护者……尤其是没有人注意到他们的阵营转变时！如果你们所有的爪牙都死了也没关系，");
    g_tipLine[15733] = StringToText("  只要有人能继续看护宝宝！特别是旅行者在早期游戏中可能是一个不错的选择……前提是您确定他们是邪恶的！");
    g_tipLine[15734] = StringToText("  镇上不太可能处决他们，但很明显，如果他们被流放，他们会把宝宝带走……");
    g_tipLine[15735] = StringToText("· 在决定每晚谁来看护时，你无法用语言交流，这使得注意彼此的肢体语言变得尤为重要。如果有人真的想要宝宝，");
    g_tipLine[15736] = StringToText("  把它给他们通常是个好主意——相信你的团队有一个你不知道的计划，他们可能是一个得知更多伪装角色的间谍或寡妇！");
    g_tipLine[15737] = StringToText("  另一方面，如果有人真的不想要宝宝，请不要给他们——他们可能会怀疑自己即将受到攻击，并想保护宝宝的安全！");
    g_tipLine[15738] = StringToText("· 如果你们用的规则是真正拿着小怪宝角色标记实物的人来看护宝宝，请务必将其隐藏好！");
    g_tipLine[15739] = StringToText("  如果善良阵营注意到你手里拿着一个标记，是很难解释清楚为什么不是以下说法：「哦，这是我的小恶魔儿子，");
    g_tipLine[15740] = StringToText("  我今天要为我们的邪恶阵营看护他。」");
    g_tipLine[15741] = StringToText("· 说书人选择每晚死去的人——小怪宝渴望鲜血，但是手脚笨拙，无法重定向到您的首选目标。可以预料，在某些时候，");
    g_tipLine[15742] = StringToText("  你们中的一些爪牙会因为小怪宝横冲直撞而死。请记住，任何照看宝宝的人都不会被说书人杀死，所以当你接近最后阶段时，");
    g_tipLine[15743] = StringToText("  请确保你信任的玩家可以带着孩子度过最后一天！（为了保持游戏公平，说书人在最后一天不应该允许超过一个活着的爪牙——");
    g_tipLine[15744] = StringToText("  为这个过程做好计划！）");
    g_tipLine[15745] = StringToText("【对抗小怪宝】");
    g_tipLine[15746] = StringToText("· 首先，游戏中有小怪宝吗？是时候计算看得出来的爪牙能力了！是否在原本只应该有2个爪牙时，同时出现：");
    g_tipLine[15747] = StringToText("  有过多人自认外来者，有人在提名时死去，还有一对邪恶双胞胎？听起来男爵、女巫和镜像双子在场，这局可能有小怪宝。");
    g_tipLine[15748] = StringToText("· 在有小怪宝的局中，邪恶阵营无法获取伪装角色，因为他们没有起始恶魔！所以，");
    g_tipLine[15749] = StringToText("  如果出现许多重复被申明的角色且没有其他角色会导致重复角色出现，或有人在游戏早期不愿意表明任何角色，");
    g_tipLine[15750] = StringToText("  那可能是小怪宝的局，爪牙们不知道要声明什么。");
    g_tipLine[15751] = StringToText("· 卖花女孩和占卜师是否得到了太多「是」的答案？小怪宝可以每晚在看护者之间移动，");
    g_tipLine[15752] = StringToText("  所以爪牙可能会多次移动小怪宝标记以分担工作量。这就需要镇上齐心协力......");
    g_tipLine[15753] = StringToText("· 一旦你确定这是小怪宝的局，检测爪牙的能力至关重要，你找到并杀死的每一个爪牙都是另一个潜在的看护者的离开，");
    g_tipLine[15754] = StringToText("  这让可以看护宝宝的邪恶玩家越来越少。不只是爪牙，如果赏金猎人在场，并且你认为你发现对应的邪恶镇民，");
    g_tipLine[15755] = StringToText("  或者是政客在搞事情，他们也是看护者的绝佳人选，所以如果可以的话，处决他们也是值得的。");
    g_tipLine[15756] = StringToText("· 或者，如果你确信某个玩家是邪恶的，你可能想故意让他们活到最后一天，而不是告诉任何人你知道他们是爪牙。");
    g_tipLine[15757] = StringToText("  如果他们活了那么久，而邪恶的团队认为他们值得信赖，他们可能最终会照看小怪宝，最终处决他就可以轻松获胜！");
    g_tipLine[15758] = StringToText("· 如果你作为善良玩家在晚上突然被唤醒并给予了这个宝宝，那就大声喊出来吧！这个孩子不是你的，");
    g_tipLine[15759] = StringToText("  你不应该违背自己的意愿去照看它！如果没有魔鬼代言人或异端分子，您可能希望立即处决自己并通过处决恶魔来赢得比赛！");
    g_tipLine[15760] = StringToText("  确保绝对每个人都知道这个宝宝是一个威胁，并向人们展示标记以明确证明你拥有它，现在应该毫无疑问地处决你。");
    g_tipLine[15761] = StringToText("· 请记住，在小怪宝的局中，选择谁死的不是邪恶阵营。说书人控制着谁死亡，说书人的优先级和邪恶阵营是不一样的。");
    g_tipLine[15762] = StringToText("  如果洗衣妇和贵族在晚上死了，但赏金猎人和教授没有死，尽管他们在城里相对有名，也许只是说书人选择不杀他们。另外，");
    g_tipLine[15763] = StringToText("  如果你不能处决他们，说书人通常需要杀死至少一名邪恶玩家，以避免最后三个邪恶玩家太多，");
    g_tipLine[15764] = StringToText("  所以不一定要相信那些死在晚上的玩家，因为他们中的一些人很可能是邪恶的。");
    g_tipRoleAt[112] = 15662; g_tipRoleN[112] = 103; g_tipP1At[112] = 15664; g_tipP1N[112] = 13; g_tipP2At[112] = 15699; g_tipP2N[112] = 16;
    g_tipAbility[112] = StringToText("每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，可能会有一名玩家死亡。[+1爪牙]");
    g_tipLine[15765] = StringToText("【背景故事】");
    g_tipLine[15766] = StringToText("「在黎明时分，庙宇那被拉长的影子爬上了泉眼。而在黄昏时分，方尖塔将刺目的红光遮挡，让拱道下方的暖流冷却。");
    g_tipLine[15767] = StringToText("  所有的线索都汇聚于此。风暴将至，而在这苹果树之间，这耀眼、葱翠又圣洁的地方，定是那暴风眼。」");
    g_tipLine[15768] = StringToText("【角色能力】");
    g_tipLine[15769] = StringToText("游戏开始时，你要宣布一个善良角色。如果该角色在场，他只能死于处决，但所有邪恶玩家会在首个夜晚得知他是哪一名玩家。");
    g_tipLine[15770] = StringToText("【角色简介】");
    g_tipLine[15771] = StringToText("暴风捕手可以让游戏的焦点集中于一个特定的善良角色上。");
    g_tipLine[15772] = StringToText("· 如果你想要基于一个特定的善良角色的行动或信息来创建一个剧本，又或者是你希望在每一局游戏中都让这个角色出场（或者至");
    g_tipLine[15773] = StringToText("  少会有一名邪恶玩家想要伪装成这个角色），你可以使用暴风捕手。你所选择的角色会在游戏中占据举足轻重的位置，");
    g_tipLine[15774] = StringToText("  会在多数时候成为公开讨论的焦点，且大多数时候都会存活直至游戏的最后一天。");
    g_tipLine[15775] = StringToText("· 被说书人宣布的角色在除处决以外的所有情况下都不会死亡。这个角色可能会在场，也可能不在场。如果他在场，");
    g_tipLine[15776] = StringToText("  那么这名善良玩家的生死就会完全取决于其他善良玩家的意愿，因为邪恶玩家无法杀死他。如果他不在场，");
    g_tipLine[15777] = StringToText("  所有邪恶玩家都会得知这一信息，因此任何一名邪恶玩家都能够轻易伪装成这个角色。（他们不是必须要这样做，");
    g_tipLine[15778] = StringToText("  但他们可以这样做。）");
    g_tipLine[15779] = StringToText("【范例】");
    g_tipLine[15780] = StringToText("说书人创作了一个基于将军为核心的剧本，因此宣布了「暴风捕手对将军青睐有加」。将军在场。在夜晚时，");
    g_tipLine[15781] = StringToText("  小恶魔和教父都攻击了将军，但将军没有死亡。在经过五天的信息积累和讨论之后，玩家们决定处决将军，将军死亡。");
    g_tipLine[15782] = StringToText("说书人希望创建一局基于共情者的信息为核心的游戏，因此宣布了「暴风捕手对共情者青睐有加」。共情者不在场。");
    g_tipLine[15783] = StringToText("  因为邪恶玩家知道这一情况，因此投毒者决定伪装成共情者。");
    g_tipLine[15784] = StringToText("【运作方式】");
    g_tipLine[15785] = StringToText("在游戏开始时，宣布暴风捕手在场。将暴风捕手的角色标记放入魔典。宣布暴风捕手对哪个善良角色「青睐有加」。");
    g_tipLine[15786] = StringToText("  如果被暴风捕手选择的角色在场，使用暴风捕手的「不会死亡」提示标记标记那个角色。");
    g_tipLine[15787] = StringToText("在首个夜晚，分别依次唤醒每个邪恶玩家。如果有善良角色标记了暴风捕手的「不会死亡」提示标记，");
    g_tipLine[15788] = StringToText("  对邪恶玩家展示「这名玩家是」信息标记，对应的善良角色标记，并指向对应的善良玩家，然后让邪恶玩家重新入睡。");
    g_tipLine[15789] = StringToText("  如果没有玩家被暴风捕手标记，对邪恶玩家展示「这些角色不在场」信息标记和对应的善良角色标记，");
    g_tipLine[15790] = StringToText("  然后让邪恶玩家重新入睡。");
    g_tipLine[15791] = StringToText("如果被暴风捕手的「不会死亡」提示标记标记的角色被处决，那么他死亡。如果他会因为其他方式死亡，那么他保持存活。");
    g_tipLine[15792] = StringToText("【提示标记】");
    g_tipLine[15793] = StringToText("· 不会死亡");
    g_tipLine[15794] = StringToText("放置时机：在为首个夜晚做准备时。");
    g_tipLine[15795] = StringToText("放置条件：放置在说书人宣布了暴风捕手的目标所对应的角色标记旁。");
    g_tipLine[15796] = StringToText("移除时机：游戏结束时。");
    g_tipRoleAt[113] = 15765; g_tipRoleN[113] = 32; g_tipP1At[113] = 15768; g_tipP1N[113] = 11; g_tipP2At[113] = 0; g_tipP2N[113] = 0;
    g_tipAbility[113] = StringToText("游戏开始时，你要宣布一个善良角色。如果该角色在场，他只能死于处决，但所有邪恶玩家会在首个夜晚得知他是哪一名玩家。");
    g_tipLine[15797] = StringToText("【背景故事】");
    g_tipLine[15798] = StringToText("「此即梦境。彼亦梦境。所见之物，非此即彼。」");
    g_tipLine[15799] = StringToText("【角色能力】");
    g_tipLine[15800] = StringToText("在你的首个夜晚，你会得知距离最近的邪恶玩家位于你的顺时针还是逆时针方向。如果两侧的邪恶玩家与你距离相等，");
    g_tipLine[15801] = StringToText("  你得知的信息由说书人决定。");
    g_tipLine[15802] = StringToText("【角色简介】");
    g_tipLine[15803] = StringToText("修行者会倾向于信任位于他某一侧的玩家。");
    g_tipLine[15804] = StringToText("· 距离最近的邪恶玩家，就是与修行者之间坐着的玩家数量最少的邪恶玩家。");
    g_tipLine[15805] = StringToText("· 如果修行者顺时针方向上最近的邪恶玩家与修行者之间的玩家数量，等同于修行者逆时针方向上最近的邪恶玩家与修行者之间的");
    g_tipLine[15806] = StringToText("  玩家数量，那么就是「修行者两侧的邪恶玩家与他的距离相等」。");
    g_tipLine[15807] = StringToText("· 如果修行者两侧的邪恶玩家与他的距离相等，由说书人来决定向修行者给出什么样的信息。");
    g_tipLine[15808] = StringToText("  说书人可以决定修行者会得知的信息是顺时针还是逆时针。");
    g_tipLine[15809] = StringToText("· 修行者不会知道他所得知的信息是真实结果，还是由说书人决定的结果。");
    g_tipLine[15810] = StringToText("· 修行者不会得知他与最近的邪恶玩家之间的具体距离。");
    g_tipLine[15811] = StringToText("· 如果修行者在游戏中途被创造，那么他会在当晚被唤醒并获得信息。");
    g_tipLine[15812] = StringToText("· 说书人与修行者关于信息的交流方式可以是用手指指向与他信息相符的方向，或是其他提前商定一致的信息方式。");
    g_tipLine[15813] = StringToText("【范例】");
    g_tipLine[15814] = StringToText("街头风琴手在修行者顺时针方向上且距离为2。恐惧之灵在修行者逆时针方向上且距离为3。修行者被唤醒，");
    g_tipLine[15815] = StringToText("  并得知与他距离最近的邪恶玩家位于顺时针方向。");
    g_tipLine[15816] = StringToText("提线木偶在修行者顺时针方向上且距离为1。寡妇在修行者逆时针方向上且距离也为1。修行者被唤醒，");
    g_tipLine[15817] = StringToText("  说书人决定让修行者得知与他距离最近的玩家位于顺时针方向。");
    g_tipLine[15818] = StringToText("【运作方式】");
    g_tipLine[15819] = StringToText("在首个夜晚，唤醒修行者。用手指水平指向修行者的某一侧，告诉他与他距离最近的邪恶玩家位于这一侧。");
    g_tipLine[15820] = StringToText("  如果修行者两侧最近的邪恶玩家与他的距离相等，由你来决定告诉他什么样的信息，并用手指指向对应的一侧。");
    g_tipLine[15821] = StringToText("  让修行者重新入睡。");
    g_tipLine[15822] = StringToText("【提示标记】");
    g_tipLine[15823] = StringToText("无");
    g_tipLine[15824] = StringToText("【提示与技巧】");
    g_tipLine[15825] = StringToText("· 通常来说，应该优先假设你的信息不是由于邪恶玩家与你距离相等而产生的随机信息，");
    g_tipLine[15826] = StringToText("  因为这种情况的可能性远比实际上有邪恶玩家在某一侧靠近你的可能性要小得多。当然你也需要牢记这种极小的可能性，");
    g_tipLine[15827] = StringToText("  但作为逻辑起点来说，一般最好假设你得知的信息是真实的，并以此为基础展开推理。");
    g_tipLine[15828] = StringToText("· 比如说，你得知距离最近的邪恶玩家位于你的顺时针方向，那么你很可能会马上开始信任位于你的逆时针方向的玩家。");
    g_tipLine[15829] = StringToText("  因为你的信息证明他们很可能是善良玩家，所以你可以优先与他们接触并建立互信，");
    g_tipLine[15830] = StringToText("  并且你还应该关注另一个方向上你们共同的敌人。");
    g_tipLine[15831] = StringToText("· 如果你在一段时间的状态解读后感觉与你左右邻近的玩家都是善良的，你可以进一步向外移动，");
    g_tipLine[15832] = StringToText("  分析你的邻近玩家的邻近玩家们对你说的话。如果你非常肯定其中一个方向有邪恶玩家，");
    g_tipLine[15833] = StringToText("  那意味着你可以信任与你邻近的两名玩家，还可以信任在另一个方向上从你的邻近玩家数过去的两名玩家。");
    g_tipLine[15834] = StringToText("· 如果你的信息确实不对，并且你认为周围的玩家无法信任，那么你该考虑邪恶玩家与你距离相等的可能性了。");
    g_tipLine[15835] = StringToText("  观察与你距离相等的每一对玩家——他们的行为是否能做成邪恶队友：他们之间有没有进行过对话，");
    g_tipLine[15836] = StringToText("  他们的信息是否互相绑定但没有其他信息证明，他们是否一起投票，他们是否在没有充分理由的时候就开始互信与合作？");
    g_tipLine[15837] = StringToText("· 有时候你会感觉你的信息非常模糊。在顺时针方向上的那名邻近玩家是邪恶的吗？还是挨着他的那名玩家是邪恶的？");
    g_tipLine[15838] = StringToText("  或者甚至可能是再数过去的那名玩家？或者说其实得到的是随机信息，实际上有一对邪恶玩家与我距离相等？重要的是，");
    g_tipLine[15839] = StringToText("  游戏进行的时间越长，你可以收集到的佐证就越多，然后就可以进一步缩小选择邪恶玩家的范围。毕竟，");
    g_tipLine[15840] = StringToText("  除非邪恶玩家的位置在游戏中发生了改变，你的信息在三人决赛的时候与在第一天的时候同样有用，");
    g_tipLine[15841] = StringToText("  都可以用来缩小可能存在邪恶玩家的范围。");
    g_tipLine[15842] = StringToText("· 尽早公开你的信息。这能让其他玩家根据那些与你邻近的值得信任的玩家来相应地确定自己能力的目标，");
    g_tipLine[15843] = StringToText("  并且他们可以利用你的信息去缩小邪恶玩家候选人的范围。这种做法还能在场上缺少其他信息指引的时候，");
    g_tipLine[15844] = StringToText("  让玩家们在潜意识里更倾向于处决你所得知的那个方向上的玩家。");
    g_tipLine[15845] = StringToText("· 推迟公开你的信息。如果邪恶玩家感觉自己已经暴露，或者在游戏初期就有大量信息指向自己，");
    g_tipLine[15846] = StringToText("  那么他通常会避免与其他邪恶玩家交流。为了得知你所怀疑的邪恶玩家候选人会与谁交谈，你会想要隐藏信息并进行观察，");
    g_tipLine[15847] = StringToText("  从而顺藤摸瓜，找出恶魔。");
    g_tipLine[15848] = StringToText("· 如果你已经在你得知的方向上找出邪恶玩家，那么你能够确定在另一个方向上至少有一个好人。");
    g_tipLine[15849] = StringToText("  现在你可以基于你的信息无条件地信任那名玩家，并且应当利用这种信任在游戏的剩余时间里努力协作。");
    g_tipLine[15850] = StringToText("· 向与你邻近的玩家，或者向所有人谎报你的信息，看看他们会有什么反应。听到虚假信息的邪恶玩家显然会知道你要么在扯谎，");
    g_tipLine[15851] = StringToText("  要么是醉酒或中毒，但这符合他们的利益，因为他们可以利用这个信息去推动玩家们处决错误方向上的善良玩家。");
    g_tipLine[15852] = StringToText("  注意观察谁对你的信息做出了回应，以及你要怎样去试图了解谁看起来正在过度投入于遵循错误方向的逻辑线。");
    g_tipRoleAt[114] = 15797; g_tipRoleN[114] = 56; g_tipP1At[114] = 15799; g_tipP1N[114] = 14; g_tipP2At[114] = 0; g_tipP2N[114] = 0;
    g_tipAbility[114] = StringToText("在你的首个夜晚，你会得知距离最近的邪恶玩家位于你的顺时针还是逆时针方向。如果两侧的邪恶玩家与你距离相等，你得知的信息由说书人决定。");
    g_tipLine[15853] = StringToText("【背景故事】");
    g_tipLine[15854] = StringToText("「客官您里边儿请嘿！是打尖儿呐还是住店啊？」");
    g_tipLine[15855] = StringToText("【角色能力】");
    g_tipLine[15856] = StringToText("在你的首个夜晚，你会得知两名善良玩家。他们之中会有一人醉酒，即使你已死亡。");
    g_tipLine[15857] = StringToText("【角色简介】");
    g_tipLine[15858] = StringToText("店小二对他店里的顾客非常熟悉，但也为某些酒量不高的顾客感到焦虑。");
    g_tipLine[15859] = StringToText("· 在首个夜晚，店小二会得知两名玩家，这两名玩家都属于善良阵营。");
    g_tipLine[15860] = StringToText("· 店小二所得知的两名玩家之中，会有一名玩家始终醉酒，即使店小二已经死亡。");
    g_tipLine[15861] = StringToText("· 如果店小二在游戏中途被创造，他会在当晚得知两名玩家，且他得知的这两名玩家之中会有一名玩家醉酒。");
    g_tipLine[15862] = StringToText("· 如果已经死亡的玩家变成了店小二，他不会得知任何信息，但仍然会让一名善良玩家醉酒。");
    g_tipLine[15863] = StringToText("【范例】");
    g_tipLine[15864] = StringToText("店小二得知了舞蛇人和哲学家这两名玩家，其中哲学家因为他而醉酒。后来，舞蛇人使用自己的能力变成了邪恶的恶魔，");
    g_tipLine[15865] = StringToText("  但店小二却仍然相信他是善良玩家。");
    g_tipLine[15866] = StringToText("和平主义者被变成了店小二，他得知了善良的小恶魔和炼金术士这两名玩家。善良的小恶魔因此醉酒，他在夜晚试图攻击自己，");
    g_tipLine[15867] = StringToText("  但他的自杀没有成功。");
    g_tipLine[15868] = StringToText("【运作方式】");
    g_tipLine[15869] = StringToText("在为首个夜晚做准备时，分别将「熟客」和「醉酒」提示标记放置到两名善良玩家的角色标记旁。从现在起，标记了「醉酒」");
    g_tipLine[15870] = StringToText("  的那名善良玩家会醉酒直到游戏结束（或店小二离场）。");
    g_tipLine[15871] = StringToText("在首个夜晚，唤醒店小二。分别指向标记了「熟客」和「醉酒」的这两名玩家。然后让店小二重新入睡。");
    g_tipLine[15872] = StringToText("在考虑店小二的能力让谁醉酒时，你应该优先选择获取信息类的角色。这是因为非获取信息类的角色的醉酒状态要么非常容易确");
    g_tipLine[15873] = StringToText("  认（如守夜人），要么非常难确认（如士兵）。同时，让获取信息的角色醉酒，");
    g_tipLine[15874] = StringToText("  可以确保即使玩家已经找到了店小二让谁醉酒之后，醉酒依然能产生一定的效果。");
    g_tipLine[15875] = StringToText("【提示标记】");
    g_tipLine[15876] = StringToText("· 熟客&醉酒");
    g_tipLine[15877] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[15878] = StringToText("放置条件：分别放置在两名不同的善良玩家的角色标记旁。");
    g_tipLine[15879] = StringToText("移除时机：在店小二得知信息之后，说书人可以在方便的时候移除「熟客」提示标记。「醉酒」");
    g_tipLine[15880] = StringToText("  提示标记则会在店小二离场时才会移除。");
    g_tipLine[15881] = StringToText("【规则细节】");
    g_tipLine[15882] = StringToText("· 如果店小二因为其他角色的能力醉酒中毒，或受到涡流效果影响，使得店小二得知了错误信息，");
    g_tipLine[15883] = StringToText("  店小二仍然会让他所得知的两名玩家之中的一人醉酒（如果是店小二醉酒中毒导致的错误信息则需要店小二恢复健康清醒后）。");
    g_tipLine[15884] = StringToText("  这可能会因此导致邪恶玩家醉酒。然而，如果他得知的玩家中存在善良玩家，说书人都应该倾向于让善良玩家醉酒。");
    g_tipLine[15885] = StringToText("· 在店小二醉酒或中毒后，他所得知的玩家可能会发生变化。为了避免他醉酒的目标进行改变，");
    g_tipLine[15886] = StringToText("  说书人应该只调整店小二所得知的消息中，没有醉酒的那一名玩家。");
    g_tipRoleAt[115] = 15853; g_tipRoleN[115] = 34; g_tipP1At[115] = 15855; g_tipP1N[115] = 8; g_tipP2At[115] = 15881; g_tipP2N[115] = 6;
    g_tipAbility[115] = StringToText("在你的首个夜晚，你会得知两名善良玩家。他们之中会有一人醉酒，即使你已死亡。");
    g_tipLine[15887] = StringToText("【背景故事】");
    g_tipLine[15888] = StringToText("「脉浮而阳气不足，气不收敛，发散在外。」");
    g_tipLine[15889] = StringToText("【角色能力】");
    g_tipLine[15890] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[15891] = StringToText("【角色简介】");
    g_tipLine[15892] = StringToText("郎中精通望闻问切，能够通过他人的面相进行初步的推测。");
    g_tipLine[15893] = StringToText("· 每个夜晚，郎中都需要选择一名除自己以外的玩家。他会得知一个与该玩家能力相关的词语。说书人会将词语写在纸上，");
    g_tipLine[15894] = StringToText("  或通过能够记录词语的电子设备，向郎中提供这个词语信息。（就像灵言师得知关键词一样。）");
    g_tipLine[15895] = StringToText("· 郎中得知的词语可能来自于那个玩家角色能力描述中的某个词，如「夜晚」、「死亡」、「公开」等；");
    g_tipLine[15896] = StringToText("  也可以是说书人对该玩家能力的某种概括性描述，如「勇敢」、「牺牲」等。");
    g_tipLine[15897] = StringToText("· 郎中每次只会得知一个词语。通常来说这是一个2-4字的词语（或是一个英文单词），这个词是有明确含义的，");
    g_tipLine[15898] = StringToText("  不能是无法组成词语的字拼接在一起。");
    g_tipLine[15899] = StringToText("· 郎中可以连续多个夜晚选择同一名玩家。郎中可以选择已死亡的玩家。郎中不能选择自己。");
    g_tipLine[15900] = StringToText("【范例】");
    g_tipLine[15901] = StringToText("郎中选择了落难少女，得知了「公开」。第二个夜晚，他选择了杂耍艺人，并再次得知了「公开」。");
    g_tipLine[15902] = StringToText("郎中选择了赏金猎人，得知了「邪恶」，因为赏金猎人的能力中包含「邪恶」一词。");
    g_tipLine[15903] = StringToText("郎中选择了半兽人，得知了「牺牲」。第二个夜晚，他选择了士兵，并得知了「勇敢」。");
    g_tipLine[15904] = StringToText("【运作方式】");
    g_tipLine[15905] = StringToText("每个夜晚，唤醒郎中。让他指向任意一名除自己以外的玩家。将该玩家的能力相关的一个词语以纸条或电子设备等形式告知给郎中");
    g_tipLine[15906] = StringToText("  。然后让郎中重新入睡。");
    g_tipLine[15907] = StringToText("建议在游戏早期时尽量向郎中提供模糊的词语，避免郎中迅速确定对方的具体角色，从而为善良阵营积累大量的优势。");
    g_tipRoleAt[116] = 15887; g_tipRoleN[116] = 21; g_tipP1At[116] = 15889; g_tipP1N[116] = 11; g_tipP2At[116] = 0; g_tipP2N[116] = 0;
    g_tipAbility[116] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[15908] = StringToText("【背景故事】");
    g_tipLine[15909] = StringToText("「台上一分钟，台下十年功。」");
    g_tipLine[15910] = StringToText("【角色能力】");
    g_tipLine[15911] = StringToText("每个白天，如果你「疯狂」地证明自己是一个善良角色（与之前不同），你可能会在当晚获得那个角色的能力，直到下个黄昏。");
    g_tipLine[15912] = StringToText("【角色简介】");
    g_tipLine[15913] = StringToText("变脸师擅长在万千样貌中变化自如。");
    g_tipLine[15914] = StringToText("· 如果变脸师疯狂证明自己是一个善良角色，他就可能会在当晚获得那个角色的能力。");
    g_tipLine[15915] = StringToText("· 每当变脸师获得一项能力时，那项能力会持续到下个黄昏。");
    g_tipLine[15916] = StringToText("· 变脸师无法多次获得同一个角色的能力。");
    g_tipLine[15917] = StringToText("· 变脸师可以连续多天疯狂证明自己是同一个角色，随后在接下来的一天证明自己是其他角色。");
    g_tipLine[15918] = StringToText("  每次在决定变脸师是否能够获得能力时，只会参考变脸师当天白天的言论。");
    g_tipLine[15919] = StringToText("  只要他这一天疯狂证明的角色与他之前曾经证明过且获得能力的角色不同，他就可能会获得这个角色的能力。");
    g_tipLine[15920] = StringToText("· 部分角色能力跨度时间与变脸师获得能力的时间可能会不匹配。（如杂耍艺人、歌伶等。）");
    g_tipLine[15921] = StringToText("  这些角色的能力在变脸师疯狂证明时便可立即获得，无需等到夜晚。");
    g_tipLine[15922] = StringToText("【范例】");
    g_tipLine[15923] = StringToText("第一个白天，变脸师「疯狂」地证明自己是占卜师。当晚，他获得了占卜师的能力，选择了两名玩家并得知了「是」。");
    g_tipLine[15924] = StringToText("  第二个白天，他告诉大家他实际上是女裁缝。当晚，他获得了女裁缝的能力，并立即使用了这项能力。第三个白天，");
    g_tipLine[15925] = StringToText("  变脸师告诉大家自己其实是贤者，然而因为他频繁更换自己的角色，也没有给出充足的理由证明自己的动机，");
    g_tipLine[15926] = StringToText("  玩家对他的实际角色产生了怀疑。当晚他没有成功获得贤者的能力，随后他被恶魔攻击并死亡，且无从得知攻击他的恶魔是谁。");
    g_tipLine[15927] = StringToText("在前几个白天，变脸师都「疯狂」地证明自己是事务官。然而，他只在第一次证明自己是事务官的夜晚里获得了事务官的能力，");
    g_tipLine[15928] = StringToText("  因为他无法在多个夜晚获得同一个角色的能力。在新的一天，变脸师改口说自己实际上是骑士，");
    g_tipLine[15929] = StringToText("  没有报出另一名玩家只是因为他的行为看起来像是爪牙。当晚，变脸师获得了骑士的能力，并得知了两名非恶魔玩家。");
    g_tipLine[15930] = StringToText("【运作方式】");
    g_tipLine[15931] = StringToText("如果变脸师在某个白天「疯狂」地证明了自己是某个角色列表上的善良角色，且他此前未曾获得过这个善良角色的能力，");
    g_tipLine[15932] = StringToText("  那么从当晚起到下一个黄昏结束，变脸师可能会获得那个角色的能力。");
    g_tipLine[15933] = StringToText("如果说书人决定让变脸师获得能力，在当晚将变脸师角色标记更换为他获得能力的角色标记，并放置「是变脸师」提示标记。");
    g_tipLine[15934] = StringToText("对变脸师来说，合理的证明需要否定此前自己曾疯狂证明过的角色，并给出充足的「为什么伪装成之前的那个角色」的理由。");
    g_tipLine[15935] = StringToText("  因此通常来说，让变脸师在一局游戏中获得1-2次能力是比较合适的。当然，如果形势特殊，");
    g_tipLine[15936] = StringToText("  说书人也可以让变脸师多次获得能力，作为对变脸师卖力「表演」的奖励。");
    g_tipLine[15937] = StringToText("【提示标记】");
    g_tipLine[15938] = StringToText("· 是变脸师");
    g_tipLine[15939] = StringToText("放置时机：白天变脸师「疯狂」地证明了自己是某个善良角色，在夜晚说书人决定让他获得能力时。");
    g_tipLine[15940] = StringToText("放置条件：变脸师玩家的角色标记旁。");
    g_tipLine[15941] = StringToText("特殊说明：如果该角色能力跨度时间与变脸师获得能力的时间不匹配，在白天变脸师疯狂证明时即可放置标记。");
    g_tipLine[15942] = StringToText("移除时机：在黄昏时，变脸师死亡或离场时。");
    g_tipRoleAt[117] = 15908; g_tipRoleN[117] = 35; g_tipP1At[117] = 15910; g_tipP1N[117] = 12; g_tipP2At[117] = 0; g_tipP2N[117] = 0;
    g_tipAbility[117] = StringToText("每个白天，如果你「疯狂」地证明自己是一个善良角色（与之前不同），你可能会在当晚获得那个角色的能力，直到下个黄昏。");
    g_tipLine[15943] = StringToText("【背景故事】");
    g_tipLine[15944] = StringToText("「道从本心，众生平等。六道轮回，一叶障目。」");
    g_tipLine[15945] = StringToText("【角色能力】");
    g_tipLine[15946] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，你会立即变成一个不在场的镇民角色。");
    g_tipLine[15947] = StringToText("【角色简介】");
    g_tipLine[15948] = StringToText("悟道者误以为自己置身事外，然而当邪恶睥睨时，他才终于醒悟：没有任何人可以置身事外。");
    g_tipLine[15949] = StringToText("· 在游戏设置时，如果悟道者作为出场角色，则将悟道者角色标记移除，并增加一个未出场的任意外来者角色，");
    g_tipLine[15950] = StringToText("  然后再让玩家随机抽取角色。");
    g_tipLine[15951] = StringToText("· 悟道者不具有自己以为的那个外来者的角色能力。");
    g_tipLine[15952] = StringToText("· 当悟道者被邪恶玩家的能力选择或影响时，在相关的效果生效前，悟道者会先改变角色，变成一个不在场的镇民。");
    g_tipLine[15953] = StringToText("· 如果悟道者的角色变化发生在白天，那么说书人会在当晚所有玩家闭眼后，第一时间唤醒悟道者并告知他相关的角色变化。");
    g_tipLine[15954] = StringToText("· 在悟道者的角色变化后，如果他随即受到邪恶玩家的此次能力效果影响，使得他再次变化角色，");
    g_tipLine[15955] = StringToText("  那么说书人只会告知他最终的变化结果。");
    g_tipLine[15956] = StringToText("【范例】");
    g_tipLine[15957] = StringToText("悟道者以为自己是落难少女。然而实际上，爪牙们没有得知「落难少女在场」这一信息。在下一个夜晚，");
    g_tipLine[15958] = StringToText("  麻脸巫婆选择将悟道者变成修补匠。说书人将悟道者唤醒，告诉他他现在是修补匠。");
    g_tipLine[15959] = StringToText("  悟道者没有因此察觉到自己之前的角色实际上是悟道者。");
    g_tipLine[15960] = StringToText("悟道者以为自己是异端分子。恶魔察觉到了悟道者玩家想要隐藏自己是外来者这一事实，猜测他是异端分子，");
    g_tipLine[15961] = StringToText("  于是恶魔选择自杀。游戏结束，善良阵营获胜，因为悟道者不具有异端分子的能力，无法调转胜负结果。");
    g_tipLine[15962] = StringToText("【运作方式】");
    g_tipLine[15963] = StringToText("在游戏设置时，移除悟道者角色标记，并添加一个外来者角色标记，然后再让玩家抽取角色。将「是悟道者」");
    g_tipLine[15964] = StringToText("  提示标记放置进魔典中。");
    g_tipLine[15965] = StringToText("在为首个夜晚进行准备时，将「是悟道者」提示标记放置在用于替换的那名外来者的角色标记旁，");
    g_tipLine[15966] = StringToText("  用于提醒那名玩家的角色实际上是悟道者。这名玩家现在是一名镇民，并且不再具有这个外来者的能力。");
    g_tipLine[15967] = StringToText("  （但他仍然以为自己是外来者。）");
    g_tipLine[15968] = StringToText("在游戏过程中，以悟道者的外来者角色来让悟道者进行行动。");
    g_tipLine[15969] = StringToText("如果任何邪恶玩家的能力选择了悟道者，或会对悟道者产生效果，则从魔典中移除「是悟道者」提示标记，");
    g_tipLine[15970] = StringToText("  并用一个不在场的镇民标记替换悟道者原本的那个外来者角色标记。如果这个行为发生在夜晚，则在当前玩家重新入睡后，");
    g_tipLine[15971] = StringToText("  唤醒悟道者。对他展示「你是」信息标记和他的新角色标记，告知他他的角色发生了变化。然后让他重新入睡。");
    g_tipLine[15972] = StringToText("  如果这个行为发生在白天，则需要在进入夜晚，所有玩家闭眼后，立即唤醒悟道者并告知他角色变化。");
    g_tipLine[15973] = StringToText("【提示标记】");
    g_tipLine[15974] = StringToText("· 是悟道者");
    g_tipLine[15975] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[15976] = StringToText("放置条件：在将所有玩家的角色标记收回到魔典后，在其中一个外来者角色标记旁放置。");
    g_tipLine[15977] = StringToText("移除时机：当悟道者触发自身能力变为其他不在场的镇民角色或悟道者离场时。");
    g_tipLine[15978] = StringToText("【规则细节】");
    g_tipLine[15979] = StringToText("· 悟道者的能力需要让他认为自己是外来者，因此悟道者无法认为自己是酒鬼或疯子，");
    g_tipLine[15980] = StringToText("  因为这两个角色不会作为角色标记发给玩家。（即使疯子的规则允许让恶魔抽取到疯子角色标记，");
    g_tipLine[15981] = StringToText("  那也仅代表玩家在作为恶魔时可以抽取到疯子标记，而非在作为外来者时可以抽取到疯子标记。）");
    g_tipLine[15982] = StringToText("· 特定角色互动：");
    g_tipLine[15983] = StringToText("  · 诺-达鲺：如果在游戏开始时诺-达鲺与悟道者为邻座，悟道者会直接中毒，不会发生角色变化。");
    g_tipLine[15984] = StringToText("    如果在游戏过程中有玩家变成了邪恶的诺-达鲺且悟道者为与他邻近的镇民，悟道者会正常发生角色变化。");
    g_tipLine[15985] = StringToText("· 相克规则：");
    g_tipLine[15986] = StringToText("  · 数学家：数学家会得知悟道者产生了错误信息或「能力未正常生效」。");
    g_tipLine[15987] = StringToText("  · 村夫：如果村夫在场数量不足3人，悟道者可以变成新的村夫。如果因此使得村夫的在场数量超过1人，会有一名村夫醉酒。");
    g_tipLine[15988] = StringToText("  · 科学怪人：恶魔无法拥有悟道者的能力。");
    g_tipRoleAt[118] = 15943; g_tipRoleN[118] = 46; g_tipP1At[118] = 15945; g_tipP1N[118] = 11; g_tipP2At[118] = 15978; g_tipP2N[118] = 11;
    g_tipAbility[118] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，你会立即变成一个不在场的镇民角色。");
    g_tipLine[15989] = StringToText("【背景故事】");
    g_tipLine[15990] = StringToText("「尔遣使遗尔舅祖总兵书，朕已洞悉。将军之心，犹豫未决。朕恐将军失次机会，殊可惜耳。」");
    g_tipLine[15991] = StringToText("【角色能力】");
    g_tipLine[15992] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为邪恶；如果你先死于处决，");
    g_tipLine[15993] = StringToText("  他会在当晚转变为邪恶。");
    g_tipLine[15994] = StringToText("【角色简介】");
    g_tipLine[15995] = StringToText("逆臣与一名其他玩家势不两立。");
    g_tipLine[15996] = StringToText("· 在首个夜晚，逆臣需要选择一名其他玩家。逆臣和这名玩家之间，谁先死于处决，另一名玩家就会在当晚转变为邪恶阵营。");
    g_tipLine[15997] = StringToText("· 两名玩家之间任何一方以其他方式死亡，不会使得另一方转为邪恶阵营。然而，即使逆臣选择的玩家因为其他原因已经死亡，");
    g_tipLine[15998] = StringToText("  逆臣死于处决也会导致他的阵营变化。");
    g_tipLine[15999] = StringToText("· 如果逆臣因为其他原因死亡，他的能力会失效。因此如果他的能力还未导致玩家转变阵营，");
    g_tipLine[16000] = StringToText("  即使在此之后他选择的玩家死于处决，也不会使得逆臣转变阵营。");
    g_tipLine[16001] = StringToText("· 如果逆臣选择的是邪恶玩家，他不会因为逆臣死于处决而转为善良阵营。同理，");
    g_tipLine[16002] = StringToText("  邪恶的逆臣也不会因为他的目标死于处决而转为善良阵营。");
    g_tipLine[16003] = StringToText("【范例】");
    g_tipLine[16004] = StringToText("逆臣选择了舞蛇人。在下个白天，舞蛇人死于处决。当晚，逆臣转变为邪恶阵营。");
    g_tipLine[16005] = StringToText("逆臣选择了麻脸巫婆。在下个白天，逆臣死于处决。因为麻脸巫婆是邪恶的，所以她不会转变阵营。");
    g_tipLine[16006] = StringToText("逆臣选择了哲学家。在第三个夜晚，涡流攻击了哲学家，哲学家死亡。下一个白天，逆臣死于处决。");
    g_tipLine[16007] = StringToText("  当晚哲学家转变为邪恶阵营。");
    g_tipLine[16008] = StringToText("【运作方式】");
    g_tipLine[16009] = StringToText("在首个夜晚，唤醒逆臣，让逆臣指向任意一名其他玩家。将「不共戴天」提示标记放置在被选择的玩家角色标记旁。");
    g_tipLine[16010] = StringToText("  让逆臣重新入睡。");
    g_tipLine[16011] = StringToText("如果逆臣先死于处决，那么标记了「不共戴天」的玩家在当晚会转变为邪恶阵营。如果被标记「不共戴天」的玩家先死于处决，");
    g_tipLine[16012] = StringToText("  那么逆臣在当晚会转变为邪恶阵营。");
    g_tipLine[16013] = StringToText("在任意一方转变为邪恶阵营后，唤醒角色对应的玩家，并向他展示「你是」信息标记、向下的大拇指，");
    g_tipLine[16014] = StringToText("  让他知道他属于邪恶阵营。让他重新入睡。在魔典上倒置他的角色标记。移除「不共戴天」提示标记。");
    g_tipLine[16015] = StringToText("【提示标记】");
    g_tipLine[16016] = StringToText("· 不共戴天");
    g_tipLine[16017] = StringToText("放置时机：在逆臣首夜行动选择了一名其他玩家后。");
    g_tipLine[16018] = StringToText("放置条件：放置在逆臣选择的玩家角色标记旁。（即使逆臣醉酒中毒，也照常放置。）");
    g_tipLine[16019] = StringToText("移除时机：在逆臣死亡且未触发阵营转变时移除，或在触发了阵营转变后移除。");
    g_tipLine[16020] = StringToText("【规则细节】");
    g_tipLine[16021] = StringToText("无");
    g_tipRoleAt[119] = 15989; g_tipRoleN[119] = 33; g_tipP1At[119] = 15991; g_tipP1N[119] = 12; g_tipP2At[119] = 16020; g_tipP2N[119] = 2;
    g_tipAbility[119] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为邪恶；如果你先死于处决，他会在当晚转变为邪恶。");
    g_tipLine[16022] = StringToText("【背景故事】");
    g_tipLine[16023] = StringToText("「一顶帽子。凉顶帽子。三顶帽子。帽子开会。刺顶帽子。污顶帽子。六顶帽子。戴好帽子。」");
    g_tipLine[16024] = StringToText("【角色能力】");
    g_tipLine[16025] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipLine[16026] = StringToText("【角色简介】");
    g_tipLine[16027] = StringToText("帽匠允许邪恶角色的玩家改变自己的角色。");
    g_tipLine[16028] = StringToText("· 帽匠的能力使得所有邪恶角色的玩家可以选择变成与自己原本角色类型相同的角色。");
    g_tipLine[16029] = StringToText("· 这些玩家可以选择不改变自己的角色。");
    g_tipLine[16030] = StringToText("· 如果一名玩家变成了新的角色，他会获得新角色的能力，即使是一项「在你的首个夜晚」能力或是一项「每局游戏限一次」");
    g_tipLine[16031] = StringToText("  但此前已被其他玩家使用过的能力。");
    g_tipLine[16032] = StringToText("· 一旦玩家的角色变化，他此前的角色能力不再在本局游戏中生效。");
    g_tipLine[16033] = StringToText("· 如果一名玩家在死亡后再变成帽匠，邪恶角色的玩家无法在当晚因此改变自己的角色。");
    g_tipLine[16034] = StringToText("· 一旦某名玩家选择变成了某个角色后，其他玩家便无法选择变成同一角色。如果某名玩家选择变成了一个已在场的角色，");
    g_tipLine[16035] = StringToText("  那么那个角色对应的玩家必须选择变成一个新的角色。");
    g_tipLine[16036] = StringToText("【范例】");
    g_tipLine[16037] = StringToText("帽匠死亡了。奥赫选择变成了诺-达鲺，魔鬼代言人选择变成了红唇女郎。");
    g_tipLine[16038] = StringToText("亡骨魔杀死了麻脸巫婆，后来他又杀死了帽匠。恶魔和爪牙都选择不改变自己的角色，");
    g_tipLine[16039] = StringToText("  因此亡骨魔让麻脸巫婆保留能力的效果仍然继续生效。");
    g_tipLine[16040] = StringToText("刺客杀死了一名玩家。帽匠被处决了。当晚，刺客选择变成了主谋。主谋摇头想保留自己的角色，但说书人对他摇头，");
    g_tipLine[16041] = StringToText("  因为主谋角色已经被其他玩家选择了。说书人示意主谋重新选择，主谋选择了刺客。");
    g_tipLine[16042] = StringToText("  随后新的刺客使用自己的能力杀死了一名玩家。");
    g_tipLine[16043] = StringToText("【运作方式】");
    g_tipLine[16044] = StringToText("如果帽匠死亡，在其角色标记旁放置「今晚茶会」提示标记。");
    g_tipLine[16045] = StringToText("在当晚，一同唤醒所有爪牙和恶魔。对他们展示「该角色的能力对你生效」信息标记，然后展示帽匠角色标记。");
    g_tipLine[16046] = StringToText("  每名以此被唤醒的玩家可以选择摇头或指向角色列表上与自己当前角色类型相同的一个角色。");
    g_tipLine[16047] = StringToText("  如果一名玩家在做出自己的选择后会使得自己的角色与一名其他玩家选择的角色相同，对他摇头示意他重新选择。");
    g_tipLine[16048] = StringToText("  在选择完成后让他重新入睡。移除「今晚茶会」提示标记。根据这些玩家的选择，在魔典上执行相应的角色变化操作。");
    g_tipLine[16049] = StringToText("可选规则：如果帽匠死亡，允许恶魔变成爪牙，且（仅）一名爪牙变成恶魔。这可能会在邪恶阵营内制造一些混乱，");
    g_tipLine[16050] = StringToText("  因为他们可能会尝试在夜晚用手势交流由谁来成为恶魔。");
    g_tipLine[16051] = StringToText("【提示标记】");
    g_tipLine[16052] = StringToText("· 今晚茶会");
    g_tipLine[16053] = StringToText("放置时机：帽匠死亡，且他清醒健康。");
    g_tipLine[16054] = StringToText("放置条件：放置在帽匠角色标记旁。");
    g_tipLine[16055] = StringToText("移除时机：完成帽匠能力的结算步骤后移除。");
    g_tipLine[16056] = StringToText("【规则细节】");
    g_tipLine[16057] = StringToText("· 由说书人决定恶魔和爪牙在茶会中选择更换角色的先后顺序，且需要注意控制茶会的时间。");
    g_tipLine[16058] = StringToText("  如果认为同时睁眼会使得夜晚时间过长，或在容易出现善良爪牙/恶魔的剧本中导致邪恶阵营暴露，");
    g_tipLine[16059] = StringToText("  说书人也可以酌情分别独自唤醒这些玩家并执行角色变化的操作。");
    g_tipLine[16060] = StringToText("· 如果帽匠在夜晚时由于恶魔的攻击而死亡，在茶会中产生的新恶魔在当晚无法再次攻击。");
    g_tipLine[16061] = StringToText("· 相克规则：");
    g_tipLine[16062] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[16063] = StringToText("  · 军团：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_tipLine[16064] = StringToText("  · 小怪宝：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[16065] = StringToText("  · 利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[16066] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16067] = StringToText("  · 梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[16068] = StringToText("【提示与技巧】");
    g_tipLine[16069] = StringToText("· 避免死亡！一旦你死亡，邪恶团队就能相互联系并定下他们认为最强力的角色组合，打破之前游戏的平衡局势。并且，");
    g_tipLine[16070] = StringToText("  如果邪恶团队能在他们需要的时候无需代价就能完成此事，这会导致压倒性的局面。");
    g_tipLine[16071] = StringToText("· 尽早死亡！你死得越早，邪恶团队越是不够时间去确定哪些邪恶角色能够最有效地对抗善良玩家。");
    g_tipLine[16072] = StringToText("  同时因为这样会导致爪牙和恶魔角色在后续表现的迹象与游戏早期存在矛盾，这种做法能够增加你被确证的概率，");
    g_tipLine[16073] = StringToText("  并且因此帮助大家确认在场的外来者数量。");
    g_tipLine[16074] = StringToText("· 在游戏中期死亡是最糟糕的。正当善良团队已经掌握一些信息并以此追踪邪恶玩家时，");
    g_tipLine[16075] = StringToText("  你的能力会完全颠覆这些信息并使得这些信息变得难以解析，特别是在你们最需要利用这些信息针对剩下的邪恶玩家候选人缩小");
    g_tipLine[16076] = StringToText("  范围的时候。");
    g_tipLine[16077] = StringToText("· 在你死后的第二天告诉所有人，你就是帽匠！不管是夜晚能力的选择还是提名和投票的决定，");
    g_tipLine[16078] = StringToText("  他们都需要相应地调整自己的思路来应对邪恶团队潜在的角色变换，以便有效地猎杀恶魔。");
    g_tipLine[16079] = StringToText("· 在你死后，对比此时与游戏初期所发生的局势变化，你可以试试看根据这些信息找出爪牙和恶魔角色发生了什么改变。");
    g_tipLine[16080] = StringToText("  也许有些玩家原本可靠的信息变得奇怪，也许会有邪恶玩家候选人突然变得乐于去死，");
    g_tipLine[16081] = StringToText("  也许场上会出现你们无法解释的额外死亡。你们在帽匠死后获得的任何关于新出现的邪恶角色的信息，");
    g_tipLine[16082] = StringToText("  甚至比在通常游戏对局中更重要，因为你们用来分析邪恶角色的时间已经被缩短了。");
    g_tipRoleAt[120] = 16022; g_tipRoleN[120] = 61; g_tipP1At[120] = 16024; g_tipP1N[120] = 12; g_tipP2At[120] = 16056; g_tipP2N[120] = 12;
    g_tipAbility[120] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipLine[16083] = StringToText("【背景故事】");
    g_tipLine[16084] = StringToText("「有神鸟，其状如黄囊，赤如丹火，六足四翼，浑敦无面目，是识歌舞，实惟帝江也。」");
    g_tipLine[16085] = StringToText("【角色能力】");
    g_tipLine[16086] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，");
    g_tipLine[16087] = StringToText("  除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    g_tipLine[16088] = StringToText("【角色简介】");
    g_tipLine[16089] = StringToText("混沌伺机而动，能够让善良玩家集体中毒。");
    g_tipLine[16090] = StringToText("· 当混沌的攻击杀死一名玩家时，如果该玩家的角色是镇民，并且是与混沌最邻近的镇民玩家，混沌的中毒效果就会被触发，");
    g_tipLine[16091] = StringToText("  并持续到下个黄昏时。");
    g_tipLine[16092] = StringToText("· 即使杀死的是邪恶的镇民，只要该玩家是混沌最邻近的两名镇民玩家之一，混沌的中毒效果就会被触发。");
    g_tipLine[16093] = StringToText("· 如果混沌杀死的镇民会使得「死亡时触发的能力」被触发，那么混沌的中毒效果会在这些能力结算完毕后再触发。");
    g_tipLine[16094] = StringToText("· 如果混沌杀死镇民后导致游戏结束，那么混沌的中毒效果不会触发。");
    g_tipLine[16095] = StringToText("· 攻击已经死亡的镇民，或攻击但没有导致镇民的死亡，不会触发混沌的中毒效果。");
    g_tipLine[16096] = StringToText("· 在混沌的中毒效果的生效期间，只要玩家是善良阵营（旅行者除外），就会受到中毒效果的影响，包括善良的爪牙和恶魔。");
    g_tipLine[16097] = StringToText("· 在混沌的中毒效果的生效期间，如果玩家转变为了善良阵营，就会立即中毒。反之，如果玩家转变为了邪恶阵营，");
    g_tipLine[16098] = StringToText("  就会立即解除混沌的中毒效果对他的影响。");
    g_tipLine[16099] = StringToText("【范例】");
    g_tipLine[16100] = StringToText("混沌的左侧是告密者，再左侧是卖花女孩。混沌杀死了卖花女孩，所有善良玩家中毒到下个黄昏。下一个夜晚，");
    g_tipLine[16101] = StringToText("  麻脸巫婆将告密者变成了数学家，随后混沌攻击并杀死了数学家，所有善良玩家再次中毒到下个黄昏。");
    g_tipLine[16102] = StringToText("混沌使得所有善良玩家中毒。当晚，邪恶的异教领袖转为了善良阵营。下一个白天，异教领袖提议所有玩家加入他的教团，");
    g_tipLine[16103] = StringToText("  善良玩家全都同意，但无事发生。");
    g_tipLine[16104] = StringToText("【运作方式】");
    g_tipLine[16105] = StringToText("除首个夜晚外的每个夜晚，唤醒混沌。让混沌指向一名玩家。该玩家死亡，在他角色标记旁放置「死亡」");
    g_tipLine[16106] = StringToText("  提示标记（除非该玩家受到其他原因影响导致不会死亡）。让混沌重新入睡。");
    g_tipLine[16107] = StringToText("如果混沌成功杀死了与自己邻近的一名镇民玩家，在魔典中央放置混沌的「善良中毒」提示标记。从现在起，");
    g_tipLine[16108] = StringToText("  所有玩家只要是善良阵营（旅行者除外），就会处于中毒状态。");
    g_tipLine[16109] = StringToText("在下一个黄昏开始时，移除混沌的「善良中毒」提示标记。");
    g_tipLine[16110] = StringToText("【提示标记】");
    g_tipLine[16111] = StringToText("· 死亡");
    g_tipLine[16112] = StringToText("放置时机：在混沌夜晚行动并选择了玩家后放置。");
    g_tipLine[16113] = StringToText("放置条件：混沌选择的玩家当前存活，且能被混沌杀死，且混沌未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[16114] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[16115] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16116] = StringToText("· 善良中毒");
    g_tipLine[16117] = StringToText("放置时机：在混沌夜晚行动并选择了玩家后放置。");
    g_tipLine[16118] = StringToText("放置条件：混沌此次行动成功杀死了与他邻近的镇民玩家，则将此标记放置在魔典的正中位置。");
    g_tipLine[16119] = StringToText("移除时机：放置此标记后的下个黄昏开始时，或混沌死亡或离场时。");
    g_tipRoleAt[121] = 16083; g_tipRoleN[121] = 37; g_tipP1At[121] = 16085; g_tipP1N[121] = 14; g_tipP2At[121] = 0; g_tipP2N[121] = 0;
    g_tipAbility[121] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    g_tipLine[16120] = StringToText("【背景故事】");
    g_tipLine[16121] = StringToText("「当有人倒下时，他也就谋杀了世界上的某个部分。」");
    g_tipLine[16122] = StringToText("【角色能力】");
    g_tipLine[16123] = StringToText("在你的首个夜晚，你会得知两名非恶魔玩家。");
    g_tipLine[16124] = StringToText("【角色简介】");
    g_tipLine[16125] = StringToText("骑士会得知角色不为恶魔的玩家。");
    g_tipLine[16126] = StringToText("· 在骑士的首个夜晚，他会得知两名玩家，这两名玩家的角色都不是恶魔。");
    g_tipLine[16127] = StringToText("· 在随后的夜晚，骑士不会得知更多的信息。");
    g_tipLine[16128] = StringToText("· 骑士得知的玩家可以是镇民，外来者甚至爪牙，但骑士不会知道他所得知的玩家的具体角色类型。");
    g_tipLine[16129] = StringToText("【范例】");
    g_tipLine[16130] = StringToText("小明是涡流，小黑是炼金术士。骑士得知了小明和小黑。由于涡流的能力，骑士的信息必须是错误的，");
    g_tipLine[16131] = StringToText("  所以他得知的玩家里必须要包含恶魔。");
    g_tipLine[16132] = StringToText("小努是送葬者，小清是小恶魔，小Z是占卜师。骑士得知了小努和小Z。");
    g_tipLine[16133] = StringToText("【运作方式】");
    g_tipLine[16134] = StringToText("在为首个夜晚进行准备时，将骑士的「得知」提示标记放置在任意两名非恶魔玩家的角色标记旁。");
    g_tipLine[16135] = StringToText("在首个夜晚，唤醒骑士，并指向标记有「得知」的两名玩家。让骑士重新入睡。");
    g_tipLine[16136] = StringToText("【提示标记】");
    g_tipLine[16137] = StringToText("· 得知");
    g_tipLine[16138] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[16139] = StringToText("放置条件：放置在两个非恶魔角色的角色标记旁边。");
    g_tipLine[16140] = StringToText("移除时机：在骑士获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16141] = StringToText("【提示与技巧】");
    g_tipLine[16142] = StringToText("· 你知道你所得知的两名玩家不是恶魔。如果他们都能活到最后三人决赛日，由于你知道其中两名玩家不是恶魔，");
    g_tipLine[16143] = StringToText("  所以你就一定知道恶魔是谁并且利用你的信息获胜！");
    g_tipLine[16144] = StringToText("· 对玩家们隐藏你的信息——恶魔会积极主动想要杀死你得知的玩家，以防在决赛日暴露自己。");
    g_tipLine[16145] = StringToText("  所以不把自己得知的信息告诉别人意味着恶魔不知道该杀谁。");
    g_tipLine[16146] = StringToText("· 在隐藏信息的同时尝试让你得知的两名玩家变得足够可疑，让他们看起来可能是恶魔候选人，但不足以可疑到会被处决。");
    g_tipLine[16147] = StringToText("  这让他们有最大几率活到决赛日。");
    g_tipLine[16148] = StringToText("· 你也可以尽早说出你的信息，尝试说服善良玩家信任你所得知的玩家。从统计数据上看，他们很可能也是善良玩家，");
    g_tipLine[16149] = StringToText("  然后因为获得信任而受益。如果他们不是善良玩家，那他们就是爪牙，所以给他们一点不应有的信任也不是最糟糕的事情。");
    g_tipLine[16150] = StringToText("· 寻找醉酒或中毒的来源——你需要确认你的信息是否正确！如果你怀疑你在首个夜晚醉酒或中毒，");
    g_tipLine[16151] = StringToText("  你可能会想要杀死你得知的两名玩家，因为他们更有可能是恶魔。因此查清你是否醉酒或中毒可以让你们获胜。");
    g_tipLine[16152] = StringToText("· 你还可以在你得知的玩家被提名时才透露你的信息，帮助他们免于被处决。这样做可以让你的信息尽可能长久地不被恶魔知道，");
    g_tipLine[16153] = StringToText("  从而不会使你的信息成为让那些玩家存活的阻碍。");
    g_tipLine[16154] = StringToText("· 同意与你所得知的其中一名玩家交换角色声明和角色信息。你是乐于去死的，来帮助你所得知的非恶魔玩家存活到决赛日。");
    g_tipLine[16155] = StringToText("  所以如果有人分享骑士信息，称你是两名非恶魔玩家之一，并且大家都这样认为的时候，恶魔将会被鼓动去杀死你，");
    g_tipLine[16156] = StringToText("  而不是杀死你所得知的玩家。");
    g_tipLine[16157] = StringToText("· 在游戏早期说出那些并不是你得知的玩家，作为你的公开的「骑士信息」。如果这些玩家没有在夜晚死亡，");
    g_tipLine[16158] = StringToText("  要么是恶魔不相信你是骑士（可能是因为这两名玩家之中真的有恶魔），要么是恶魔在整个对局中还有更高优先级的击杀目标。");
    g_tipLine[16159] = StringToText("  不管是哪种情况，都能让你得到不错的玩家状态信息。");
    g_tipLine[16160] = StringToText("· 声称自己是其他善良角色，比如占卜师或洗衣妇这种角色，可以将你得知的其中一名或两名玩家排除嫌疑。");
    g_tipLine[16161] = StringToText("  这样你就不会被迫过早透露你的骑士信息。");
    g_tipLine[16162] = StringToText("· 你不需要让你得知的玩家向你透露他们的角色或信息，你知道他们不是恶魔，至少能在这个程度上信任他们。对于他们来说，");
    g_tipLine[16163] = StringToText("  最优的玩法可能是基于你的信息所激发的信任，尽可能长久地不暴露自己。");
    g_tipRoleAt[122] = 16120; g_tipRoleN[122] = 44; g_tipP1At[122] = 16122; g_tipP1N[122] = 7; g_tipP2At[122] = 0; g_tipP2N[122] = 0;
    g_tipAbility[122] = StringToText("在你的首个夜晚，你会得知两名非恶魔玩家。");
    g_tipLine[16164] = StringToText("【背景故事】");
    g_tipLine[16165] = StringToText("「定其心神，方可言道。」");
    g_tipLine[16166] = StringToText("【角色能力】");
    g_tipLine[16167] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    g_tipLine[16168] = StringToText("【角色简介】");
    g_tipLine[16169] = StringToText("道士会不断地寻找恶魔，令其短暂失去能力，并以自身死亡作为代价。");
    g_tipLine[16170] = StringToText("· 除首个夜晚以外的每个夜晚，道士需要选择一名玩家，如果那名玩家不是恶魔，道士依然存活。当选中一名恶魔玩家时，");
    g_tipLine[16171] = StringToText("  道士死亡，然后那名恶魔玩家在当晚醉酒。");
    g_tipLine[16172] = StringToText("· 醉酒只会维持到天亮前，天亮后恶魔玩家不再醉酒。");
    g_tipLine[16173] = StringToText("· 如果道士选中了恶魔，但道士的死亡由于某些原因被阻止，恶魔玩家当晚不会醉酒。");
    g_tipLine[16174] = StringToText("【范例】");
    g_tipLine[16175] = StringToText("道士选择他自己，道士存活。下个夜晚，道士选择的玩家是刺客，道士依旧存活。");
    g_tipLine[16176] = StringToText("道士选择的玩家是沙巴洛斯。道士死亡，然后沙巴洛斯醉酒。醉酒的沙巴洛斯无法复活任何玩家。");
    g_tipLine[16177] = StringToText("  随后沙巴洛斯攻击了祖母和侍臣，祖母和侍臣都没有死亡。天亮后，沙巴洛斯恢复了清醒。");
    g_tipLine[16178] = StringToText("旅店老板保护了道士和数学家，说书人决定让数学家醉酒。当晚，道士选择的玩家是死亡的小恶魔，道士依然存活，");
    g_tipLine[16179] = StringToText("  小恶魔没有醉酒。");
    g_tipLine[16180] = StringToText("【运作方式】");
    g_tipLine[16181] = StringToText("除首个夜晚以外的每个夜晚，唤醒道士。让道士指向任意一名玩家。然后让道士重新入睡。");
    g_tipLine[16182] = StringToText("如果被选择的玩家不是恶魔，道士存活。如果被选择的玩家是恶魔，道士死亡，将「死亡」");
    g_tipLine[16183] = StringToText("  提示标记放置到道士玩家的角色标记旁并放置帷幕标记，然后将「醉酒」提示标记放置到恶魔玩家的角色标记旁。");
    g_tipLine[16184] = StringToText("在黎明，移除「醉酒」提示标记。");
    g_tipLine[16185] = StringToText("【提示标记】");
    g_tipLine[16186] = StringToText("· 死亡");
    g_tipLine[16187] = StringToText("放置时机：在道士夜晚行动并选择了玩家后放置。");
    g_tipLine[16188] = StringToText("放置条件：如果道士选择的玩家是恶魔，则将此标记放置在道士玩家角色标记旁，");
    g_tipLine[16189] = StringToText("  用以提醒说书人在黎明时分宣布道士玩家死亡。如果此时道士醉酒中毒或无法死亡，则不放置该标记。");
    g_tipLine[16190] = StringToText("移除时机：在黎明时宣布道士玩家死亡后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16191] = StringToText("· 醉酒");
    g_tipLine[16192] = StringToText("放置时机：在道士夜晚行动并选择了玩家后放置。");
    g_tipLine[16193] = StringToText("放置条件：如果道士选择的玩家是恶魔，则将此标记放置在恶魔玩家角色标记旁。如果此时道士醉酒中毒或无法死亡，");
    g_tipLine[16194] = StringToText("  则不放置该标记。");
    g_tipLine[16195] = StringToText("移除时机：在黎明时，或道士离场时。");
    g_tipLine[16196] = StringToText("【规则细节】");
    g_tipLine[16197] = StringToText("· 特定角色互动：");
    g_tipLine[16198] = StringToText("  · 小怪宝：如果道士选中了照顾小怪宝的玩家，道士会死亡，该玩家醉酒。小怪宝的能力不会受到任何影响。");
    g_tipRoleAt[123] = 16164; g_tipRoleN[123] = 35; g_tipP1At[123] = 16166; g_tipP1N[123] = 8; g_tipP2At[123] = 16196; g_tipP2N[123] = 3;
    g_tipAbility[123] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    g_tipLine[16199] = StringToText("【背景故事】");
    g_tipLine[16200] = StringToText("「甘如醴，毒如砒。」");
    g_tipLine[16201] = StringToText("【角色能力】");
    g_tipLine[16202] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他中毒并死亡。");
    g_tipLine[16203] = StringToText("【角色简介】");
    g_tipLine[16204] = StringToText("鸩可以冒着某个镇民死亡的风险来确认该镇民是否在场。");
    g_tipLine[16205] = StringToText("· 每局游戏限一次，除首个夜晚以外的其他夜晚，鸩可以选择一个镇民角色，如果那个角色在场，");
    g_tipLine[16206] = StringToText("  该角色对应的玩家会中毒并死亡。");
    g_tipLine[16207] = StringToText("· 如果鸩选择了一个不在场的角色，不会有任何玩家受到鸩的影响，即使之后被选择的角色在场了，他也不会受到鸩的影响。");
    g_tipLine[16208] = StringToText("· 如果某个角色有多名玩家在场，且鸩选择了这个角色，只会有一名玩家中毒并死亡。");
    g_tipLine[16209] = StringToText("【范例】");
    g_tipLine[16210] = StringToText("鸩选择了钟表匠，钟表匠中毒并死亡。");
    g_tipLine[16211] = StringToText("鸩选择了艺术家，艺术家不在场，没有人会因为鸩的能力中毒并死亡。");
    g_tipLine[16212] = StringToText("鸩选择了村夫，小王和小李是村夫，说书人决定小王中毒并死亡。");
    g_tipLine[16213] = StringToText("【运作方式】");
    g_tipLine[16214] = StringToText("除首个夜晚以外的每个夜晚，唤醒鸩。他要么摇头不使用能力，要么指向角色列表上一个镇民图标。让鸩重新入睡。");
    g_tipLine[16215] = StringToText("如果鸩使用了能力且该角色在场，对应的玩家中毒并死亡——依次用「中毒」和「死亡」提示标记标记那名玩家。");
    g_tipLine[16216] = StringToText("【提示标记】");
    g_tipLine[16217] = StringToText("· 中毒");
    g_tipLine[16218] = StringToText("放置时机：在鸩夜晚行动时选择使用能力，并选择了一个镇民角色后。");
    g_tipLine[16219] = StringToText("放置条件：放置在鸩所选择的那个镇民角色所对应的玩家的角色标记旁。");
    g_tipLine[16220] = StringToText("特殊说明：如果鸩选择的镇民角色不在场，或是鸩中毒或醉酒，将该标记倒转放置在鸩的的角色标记旁，");
    g_tipLine[16221] = StringToText("  用于标记鸩已经使用过能力。");
    g_tipLine[16222] = StringToText("移除时机：鸩死亡或离场时。");
    g_tipLine[16223] = StringToText("· 死亡");
    g_tipLine[16224] = StringToText("放置时机：在鸩夜晚行动时选择使用能力，并选择了一个镇民角色后。");
    g_tipLine[16225] = StringToText("放置条件：因为鸩的能力而会被杀死的玩家当前存活，且能被鸩杀死，且鸩未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[16226] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[16227] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16228] = StringToText("【规则细节】");
    g_tipLine[16229] = StringToText("· 如果鸩选择了自己，他会中毒但不会死亡。因为鸩先让自己中毒失去了能力，所以通常情况下鸩不会死于自己的能力。");
    g_tipLine[16230] = StringToText("  （特殊情况下，鸩可以死于自己的能力，比如咖啡师的效果1对鸩生效。）");
    g_tipLine[16231] = StringToText("· 相克规则：");
    g_tipLine[16232] = StringToText("  · 罂粟种植者：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。");
    g_tipLine[16233] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16234] = StringToText("  · 半仙：如果鸩选择了半仙，半仙会中毒并死亡。");
    g_tipRoleAt[124] = 16199; g_tipRoleN[124] = 36; g_tipP1At[124] = 16201; g_tipP1N[124] = 8; g_tipP2At[124] = 16228; g_tipP2N[124] = 7;
    g_tipAbility[124] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他中毒并死亡。");
    g_tipLine[16235] = StringToText("【背景故事】");
    g_tipLine[16236] = StringToText("「在人性的背后，存在着以人性为面具的生活。某些时候生活会摘下面具，以深刻的答案应对深刻的问题。」");
    g_tipLine[16237] = StringToText("【角色能力】");
    g_tipLine[16238] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[16239] = StringToText("【角色简介】");
    g_tipLine[16240] = StringToText("女祭司凭借直觉行事。");
    g_tipLine[16241] = StringToText("· 女祭司可以连续几个夜晚得知同一名玩家，也可以在每个夜晚都得知不同的玩家。");
    g_tipLine[16242] = StringToText("· 她得知的玩家可以是存活玩家，也可以是死亡玩家。");
    g_tipLine[16243] = StringToText("· 她得知的玩家可以是善良玩家，也可以是邪恶玩家。");
    g_tipLine[16244] = StringToText("· 没有绝对的标准用于决定说书人究竟要给女祭司什么样的信息。说书人通过自己的判断来决定给出女祭司的信息内容，");
    g_tipLine[16245] = StringToText("  这取决于他认为给出什么样的信息能够对女祭司和善良阵营更加有利。这可能是因为某些玩家有重要信息但尚未公布，");
    g_tipLine[16246] = StringToText("  或是邪恶玩家的伪装一戳即破，或是有值得被信赖的玩家需要建立更强的信任，或是有善良玩家的推理出现了谬误，");
    g_tipLine[16247] = StringToText("  急需被纠正，或是其他各种各样的原因。");
    g_tipLine[16248] = StringToText("【范例】");
    g_tipLine[16249] = StringToText("在首个夜晚，女祭司得知了小佳。小佳是厨师且有有用的信息需要分享。在第二个夜晚，女祭司得知了小明。小明是哥布林，");
    g_tipLine[16250] = StringToText("  但是说书人认为女祭司如果和小明交流并尽早发现小明是邪恶玩家会更容易获益。在第三个夜晚，女祭司得知了道哥。");
    g_tipLine[16251] = StringToText("  道哥是酒鬼，但是得知了错误信息，并且正对善良阵营造成不良的影响。");
    g_tipLine[16252] = StringToText("连续三个夜晚，女祭司都得知了小美。小美是圣徒，但善良阵营正打算处决她。在最后一夜，女祭司得知了小莱，");
    g_tipLine[16253] = StringToText("  小莱是小恶魔，他编造的谎话与好几个善良玩家的信息产生了冲突。");
    g_tipLine[16254] = StringToText("【运作方式】");
    g_tipLine[16255] = StringToText("每个夜晚，唤醒女祭司。指向一名玩家。随后让女祭司重新入睡。");
    g_tipLine[16256] = StringToText("【提示标记】");
    g_tipLine[16257] = StringToText("无");
    g_tipLine[16258] = StringToText("【提示与技巧】");
    g_tipLine[16259] = StringToText("· 每天都尽快地与说书人指示的玩家交谈——说书人认为他对于你来说是最重要的交流对象，");
    g_tipLine[16260] = StringToText("  所以你应该立即与他联系以获得信任，并根据他的信息来决定你在首个白天的发言和行动。");
    g_tipLine[16261] = StringToText("· 不要立即与你得知的玩家交谈。相反地，去观察他与谁交谈，看看你是否能从他的行为和互动中获得为什么需要与他交谈的线索");
    g_tipLine[16262] = StringToText("  。比如说，如果他特别希望与几名特定的玩家交谈，他可能是洗衣妇或占卜师，这个推测也许能够让你决定以什么方式接触他。");
    g_tipLine[16263] = StringToText("  或者，他可能看起来有些不知所措，直到与某些特定玩家交谈后才安心下来，那么他有可能是刚刚得到伪装的爪牙。");
    g_tipLine[16264] = StringToText("· 告诉你得知的玩家，你是女祭司并且在昨晚得知的玩家是他，看看他能不能想到什么充分理由可能是他被你得知的原因。");
    g_tipLine[16265] = StringToText("  虽然你的信息可能非常模糊，但你得知的玩家有可能依据他的角色能力获得的信息来构建一条清晰的逻辑线，");
    g_tipLine[16266] = StringToText("  然后为你以及善良阵营提供更广阔的视野。");
    g_tipLine[16267] = StringToText("· 不要告诉你得知的玩家，你是女祭司。说书人也许不是想让你与那名玩家分享信息，而只是认为他可能对你有所帮助。");
    g_tipLine[16268] = StringToText("· 在首个夜晚，你得知的玩家很可能要么就是已经获得信息的善良玩家，所以他能与你分享信息；要么就是一名爪牙玩家，");
    g_tipLine[16269] = StringToText("  所以你也许能够在他没有获得伪装时获得他的状态信息或者给他挖坑。");
    g_tipLine[16270] = StringToText("· 随着游戏的进行，说书人很有可能会给你指出那些还没有完全分享自己信息的玩家，甚至是那些还没说出自己角色的玩家；");
    g_tipLine[16271] = StringToText("  或是给你指出死亡的玩家，他们需要得知你已经收集但是还没分享的其他信息；或是给你指出邪恶玩家，");
    g_tipLine[16272] = StringToText("  一旦他们陷入与你的对话，而不是与他们的邪恶队友或者是他们正在洗头的玩家，他们就无法推进邪恶阵营的游戏进度。");
    g_tipLine[16273] = StringToText("· 在游戏后期，说书人很有可能会给你指出那些逻辑准确的善良玩家，以鼓励你把自己的思路转变到他们的思路上，");
    g_tipLine[16274] = StringToText("  并增强他们对于团队的信心；或是给你指出恶魔玩家，这样你就可以从他的论点中找出漏洞并进行反驳。");
    g_tipLine[16275] = StringToText("· 如果善良阵营正在占据上风，说书人给你指出的玩家很有可能会加强你们的获胜策略。如果邪恶阵营正在占据上风，");
    g_tipLine[16276] = StringToText("  说书人给你指出的玩家会与你的信息相互矛盾，以此来试图引起你对不同观点的关注，");
    g_tipLine[16277] = StringToText("  进而鼓励你放弃之前你曾强烈支持的观点。你觉得游戏正在往对善良阵营有利的方向发展吗？");
    g_tipLine[16278] = StringToText("  随时运用上述观点去考虑你的信息！");
    g_tipLine[16279] = StringToText("· 说书人是不是连续两次给你指出同一名玩家？很有可能是他想让你从对话中获得的信息而你没有获得，");
    g_tipLine[16280] = StringToText("  所以用开放的心态再尝试进行一次对话吧！");
    g_tipLine[16281] = StringToText("· 归根结底，就算你没有弄清楚说书人为什么要给你指示那些特定玩家，女祭司仍然是具有强大增幅作用的角色。");
    g_tipLine[16282] = StringToText("  即使你每天做的事情只是与你得知的玩家交谈，并且一直都没弄清楚为什么这样做，");
    g_tipLine[16283] = StringToText("  与说书人推荐的玩家交谈这个行为只会对善良阵营有帮助。");
    g_tipRoleAt[125] = 16235; g_tipRoleN[125] = 49; g_tipP1At[125] = 16237; g_tipP1N[125] = 11; g_tipP2At[125] = 0; g_tipP2N[125] = 0;
    g_tipAbility[125] = StringToText("每个夜晚，你会得知一名说书人认为你最应该与其交流的玩家。");
    g_tipLine[16284] = StringToText("【背景故事】");
    g_tipLine[16285] = StringToText("「你须待到天黑再赶路，切莫让人发现你的肚子里都是稻草。」");
    g_tipLine[16286] = StringToText("【角色能力】");
    g_tipLine[16287] = StringToText("与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1外来者]");
    g_tipLine[16288] = StringToText("【角色简介】");
    g_tipLine[16289] = StringToText("赶尸人能将相邻的镇民变成活尸，让人们误以为他们还存活。");
    g_tipLine[16290] = StringToText("· 在设置阶段，如果赶尸人在场，则用一个未出场的镇民角色标记替换一个外来者标记，然后再让玩家随机抽取角色。");
    g_tipLine[16291] = StringToText("· 与赶尸人邻近的镇民在首次死亡时，会进入「活尸」状态。与穷奇的能力相似，该玩家在城镇广场上会表现出「存活」，");
    g_tipLine[16292] = StringToText("  然而实际上已经死亡。在这种情况下再次死亡，玩家在城镇广场上的状态也就会变成死亡状态。");
    g_tipLine[16293] = StringToText("· 只有能够死亡的玩家才能因为赶尸人的能力而进入「活尸」状态。如果玩家的死亡由于某些原因被阻止，他就不会进入「活尸」");
    g_tipLine[16294] = StringToText("  状态，而是正常存活（也不会因此算作他的「首次死亡」，赶尸人的能力能在他真正死亡的时候如常触发）。");
    g_tipLine[16295] = StringToText("· 「活尸」状态下的玩家死亡时，相关的「死亡时触发的能力」不会触发，因为玩家在此之前已经进入了死亡状态（且之前进入死亡");
    g_tipLine[16296] = StringToText("  状态时，自身被当作存活而没有触发「死亡时触发的能力」）。而「得知自己死亡」的能力会正常触发，");
    g_tipLine[16297] = StringToText("  因为这些能力会持续保留到玩家「得知自己死亡」时。");
    g_tipLine[16298] = StringToText("· 「活尸」状态与醉酒中毒相似：玩家会失去自身的能力，如果玩家的能力会让他自己获得信息，则有可能获得错误信息。");
    g_tipLine[16299] = StringToText("· 「活尸」状态是一次性变化。即使之后赶尸人中毒醉酒或是死亡，又或者是「活尸」玩家的角色发生了变化且不再是镇民，");
    g_tipLine[16300] = StringToText("  「活尸」玩家在城镇广场上的状态依旧不会发生变化。但此时「活尸」玩家在参与能力互动时，不再被当作存活状态，");
    g_tipLine[16301] = StringToText("  而是处于死亡状态。");
    g_tipLine[16302] = StringToText("· 如果已经进入「活尸」状态的玩家变成了非镇民角色，赶尸人所能影响的玩家也会发生变化。");
    g_tipLine[16303] = StringToText("  此时会计算分别与他顺时针和逆时针两个方向上最近的镇民玩家，赶尸人的能力会对这些玩家生效。");
    g_tipLine[16304] = StringToText("【范例】");
    g_tipLine[16305] = StringToText("赶尸人的左侧是管家，再左侧是红唇女郎，再左侧是哲学家。他的右侧是旅店老板。白天，管家被处决，说书人宣布管家死亡。");
    g_tipLine[16306] = StringToText("  当晚，哲学家选择获得贤者的能力，随后恶魔攻击了哲学家。哲学家进入「活尸」状态，且失去能力。");
    g_tipLine[16307] = StringToText("  他的贤者能力不会因为恶魔的攻击而触发。");
    g_tipLine[16308] = StringToText("【运作方式】");
    g_tipLine[16309] = StringToText("每当与赶尸人邻近的镇民首次死亡时，该玩家进入「活尸」状态。在魔典中该玩家的角色标记上添加帷幕标记，");
    g_tipLine[16310] = StringToText("  但不要宣布该玩家已经死亡，也不要在城镇广场上将该玩家的生命标记翻面。当该玩家再次死亡时，正常宣布该玩家死亡，");
    g_tipLine[16311] = StringToText("  并在城镇广场上将该玩家的生命标记翻面。");
    g_tipLine[16312] = StringToText("【规则细节】");
    g_tipLine[16313] = StringToText("· 如果玩家因为某些效果「不会死亡」，如旅店老板的效果，则在他将要死亡时，不会受到赶尸人的效果影响。同样的，");
    g_tipLine[16314] = StringToText("  也不会因此被算作「首次死亡」。");
    g_tipLine[16315] = StringToText("· 特定角色互动：");
    g_tipLine[16316] = StringToText("  · 守鸦人/贤者：「活尸」状态的守鸦人在夜晚转为死亡状态时，同样会被说书人唤醒并假装触发他的能力。");
    g_tipLine[16317] = StringToText("    这是因为守鸦人在玩家自身看来是在夜晚死亡的，满足守鸦人的能力的触发条件。如果恶魔导致了贤者从活尸转为死亡状态，");
    g_tipLine[16318] = StringToText("    同样也会触发贤者的唤醒。然而因为他们实际已经死亡，说书人可以提供错误信息。");
    g_tipLine[16319] = StringToText("  · 弄臣：与赶尸人相邻，且未触发能力的弄臣在首次死亡时，会触发弄臣的能力，从而使得弄臣不会死亡。在弄臣再次死亡时，");
    g_tipLine[16320] = StringToText("    会正常受到赶尸人的能力影响，进入「活尸」状态。");
    g_tipLine[16321] = StringToText("· 相克规则：");
    g_tipLine[16322] = StringToText("  · 瘟疫医生：如果说书人本应获得赶尸人的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipRoleAt[126] = 16284; g_tipRoleN[126] = 39; g_tipP1At[126] = 16286; g_tipP1N[126] = 18; g_tipP2At[126] = 16312; g_tipP2N[126] = 11;
    g_tipAbility[126] = StringToText("与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1外来者]");
    g_tipLine[16323] = StringToText("【背景故事】");
    g_tipLine[16324] = StringToText("「末日将临，斗争永无止境。");
    g_tipLine[16325] = StringToText("地狱之心，吾以利剑相迎。");
    g_tipLine[16326] = StringToText("仇恨燃尽，然而愤懑难平。」");
    g_tipLine[16327] = StringToText("【角色能力】");
    g_tipLine[16328] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。");
    g_tipLine[16329] = StringToText("所有玩家都知道利维坦在场。");
    g_tipLine[16330] = StringToText("在第五个白天结束时，邪恶阵营获胜。");
    g_tipLine[16331] = StringToText("【角色简介】");
    g_tipLine[16332] = StringToText("利维坦不进行任何杀戮。");
    g_tipLine[16333] = StringToText("· 所有玩家都会知道利维坦在场，即使利维坦在游戏过程中被创造也是如此。");
    g_tipLine[16334] = StringToText("· 可以有任意数量的邪恶玩家被处决，然而如果有多于一名善良玩家被处决，邪恶阵营获胜。被处决的角色是什么无关紧要，");
    g_tipLine[16335] = StringToText("  只看那名玩家在被处决的时候的阵营是什么。");
    g_tipLine[16336] = StringToText("· 当第五个白天结束时，如果利维坦仍然存活，邪恶阵营获胜。");
    g_tipLine[16337] = StringToText("· 不论何种类型的处决均会计算在内，即使处决没有让玩家死亡也会正常计算。被贞洁者处决，或者畸形秀演员自爆处决，");
    g_tipLine[16338] = StringToText("  都会计算在内。善良玩家被处决但因为和平主义者的能力仍然存活也会计算在内。");
    g_tipLine[16339] = StringToText("【范例】");
    g_tipLine[16340] = StringToText("利维坦在场。在第一个白天，僧侣提名了贞洁者，僧侣被处决。在第二个白天，侍臣被处决。邪恶阵营获胜。");
    g_tipLine[16341] = StringToText("利维坦在场。在第二个白天，红唇女郎被处决。在第三个白天，投毒者被处决。在第五个白天，士兵被处决。邪恶阵营获胜。");
    g_tipLine[16342] = StringToText("【运作方式】");
    g_tipLine[16343] = StringToText("在第一天黎明后，立即宣布利维坦在场。将「第一天」提示标记放置在利维坦的角色标记旁。在接下来的每一个白天开始时，");
    g_tipLine[16344] = StringToText("  将「第二天」、「第三天」、「第四天」、「第五天」提示标记依次替换放置在利维坦的角色标记旁。");
    g_tipLine[16345] = StringToText("  如果一个白天结束并且利维坦的角色标记旁有「第五天」提示标记，则宣布邪恶阵营获胜。");
    g_tipLine[16346] = StringToText("如果一名善良玩家被处决，将「善良被处决」提示标记放置在他的角色标记旁。");
    g_tipLine[16347] = StringToText("如果一名善良玩家被处决并且已经有一名玩家的角色标记旁放置了「善良被处决」提示标记，则宣布邪恶阵营获胜。");
    g_tipLine[16348] = StringToText("对于新手玩家，每天宣布利维坦在场，并说明今天是哪一天，这很有帮助的。在第一个白天，宣布「利维坦在场。这是第一天。");
    g_tipLine[16349] = StringToText("  」在第二个白天，宣布「利维坦在场。现在是第二天。」诸如此类。这可以帮助玩家们记住他们面对的是什么恶魔，");
    g_tipLine[16350] = StringToText("  并避免因忘记计算天数而意外落败。");
    g_tipLine[16351] = StringToText("【提示标记】");
    g_tipLine[16352] = StringToText("· 第一天&第二天&第三天&第四天&第五天");
    g_tipLine[16353] = StringToText("放置时机：利维坦在场，且游戏阶段进入到黎明时。");
    g_tipLine[16354] = StringToText("放置条件：根据当前游戏进行的天数，将对应天数的提示标记放置在利维坦的角色标记旁。");
    g_tipLine[16355] = StringToText("移除时机：在下一次进入黎明时移除当前放置的标记并进行替换。在利维坦死亡或离场时移除。");
    g_tipLine[16356] = StringToText("· 善良被处决");
    g_tipLine[16357] = StringToText("放置时机：当一名善良阵营的玩家被处决时。不论这名玩家是否死于处决，均需要放置。");
    g_tipLine[16358] = StringToText("放置条件：如果利维坦未醉酒中毒，那么在该玩家的角色标记旁放置此标记。");
    g_tipLine[16359] = StringToText("移除时机：利维坦死亡或离场时。");
    g_tipLine[16360] = StringToText("【规则细节】");
    g_tipLine[16361] = StringToText("· 不是利维坦的第五天触发邪恶阵营获胜的条件，而是游戏总天数。所以如果利维坦在第五天之后出现在游戏中，");
    g_tipLine[16362] = StringToText("  邪恶阵营立即获胜。");
    g_tipLine[16363] = StringToText("· 如果你选择每天播报利维坦在场的第几天，一旦利维坦醉酒/中毒，那么在当天不能宣布利维坦在场。");
    g_tipLine[16364] = StringToText("  当利维坦恢复清醒/健康时，可以再次宣布利维坦在场（如果还没有宣布过，则必须宣布）。");
    g_tipLine[16365] = StringToText("· 当利维坦中毒/醉酒时，处决不会算入利维坦获胜条件。如果利维坦在第五天是中毒/醉酒的，");
    g_tipLine[16366] = StringToText("  他在恢复清醒/健康之前不会获胜，但只要利维坦在第五天结束后的任意时候是清醒/健康的，游戏结束，邪恶阵营获胜。");
    g_tipLine[16367] = StringToText("· 同一名善良玩家被处决多次只会计入一次利维坦的获胜条件。");
    g_tipLine[16368] = StringToText("· 相克规则：");
    g_tipLine[16369] = StringToText("  · 士兵：如果利维坦提名并处决了士兵，善良阵营获胜。");
    g_tipLine[16370] = StringToText("  · 僧侣：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_tipLine[16371] = StringToText("  · 旅店老板：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[16372] = StringToText("  · 守鸦人：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果守鸦人被选择，");
    g_tipLine[16373] = StringToText("    他的能力生效但不会死亡。（建议在利维坦选择农夫/守鸦人/贤者并触发这些角色的能力后，这些角色失去能力）");
    g_tipLine[16374] = StringToText("  · 贤者：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果贤者被选择，");
    g_tipLine[16375] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[16376] = StringToText("  · 农夫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果农夫被选择，");
    g_tipLine[16377] = StringToText("    他的能力生效但不会死亡。");
    g_tipLine[16378] = StringToText("  · 镇长：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。");
    g_tipLine[16379] = StringToText("  · 报丧女妖：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果报丧女妖被选择，");
    g_tipLine[16380] = StringToText("    他死亡并能力生效。");
    g_tipLine[16381] = StringToText("  · 驱魔人：如果利维坦提名并处决了驱魔人上个夜晚选择的那名玩家，善良阵营获胜。");
    g_tipLine[16382] = StringToText("  · 祖母：如果利维坦在场，孙子死于处决，邪恶阵营获胜。");
    g_tipLine[16383] = StringToText("  · 国王：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[16384] = StringToText("  · 麻脸巫婆：利维坦不能在第五天之后加入游戏。");
    g_tipLine[16385] = StringToText("  · 帽匠：利维坦不能在第五天之后加入游戏。");
    g_tipLine[16386] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16387] = StringToText("  · 戏子：在戏子存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。说书人会在当晚杀死这名玩家。");
    g_tipLine[16388] = StringToText("  · 和尚：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[16389] = StringToText("  · 打更人：如果利维坦提名并处决了打更人上个夜晚猜测的其中一名玩家，善良阵营获胜。");
    g_tipLine[16390] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[16391] = StringToText("    说书人会在当晚杀死这名玩家。");
    g_tipLine[16392] = StringToText("  · 狸猫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果「太子」被选择，");
    g_tipLine[16393] = StringToText("    他会与狸猫交换角色但不会死亡。");
    g_tipLine[16394] = StringToText("  · 巡察：如果利维坦提名并处决了巡察上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_tipLine[16395] = StringToText("【提示与技巧】");
    g_tipLine[16396] = StringToText("· 鼓励善良阵营早早开始处决。由于您无法在晚上杀死玩家，因此能够干掉非常强大的角色，例如占卜师或卖花女孩，");
    g_tipLine[16397] = StringToText("  会非常有帮助。专注于干掉每晚行动或每局游戏只行动一次的角色。干掉一个只在首夜获得信息的角色，");
    g_tipLine[16398] = StringToText("  或者每场游戏使用一次的能力且已经使用过的角色几乎没有什么好处。");
    g_tipLine[16399] = StringToText("· 注意大家想要处决的角色类型。如果大家想要处决只有一次性能力的角色，因为他们认为这样做更安全，");
    g_tipLine[16400] = StringToText("  那么不要伪装成只有一次性能力的角色。如果团队想要处决每晚行动的角色，因为那是恶魔应该在利维坦局中常常伪装的角色，");
    g_tipLine[16401] = StringToText("  那你就伪装成已经行动的角色，或外来者。这将帮助您避免第一次就被处决。");
    g_tipLine[16402] = StringToText("· 如果您不知道如何伪装角色，请默认伪装成想要隐藏自己角色的强大角色。由于大多数玩家在最后一天仍然活着，因此猎手，");
    g_tipLine[16403] = StringToText("  侍女，博学者或艺术家等强大的善良角色不需要为了躲刀而隐藏自己的角色。「你不是你所说的那个角色，");
    g_tipLine[16404] = StringToText("  因为恶魔会在最后一天之前杀死那个角色」的论点毫无意义。");
    g_tipLine[16405] = StringToText("· 早点伪装成其他角色。由于玩家只能被处决，所以大部分善良玩家都不会遮遮掩掩。保持沉默的玩家更有可能被视为邪恶玩家，");
    g_tipLine[16406] = StringToText("  而不是隐藏某些东西的善良玩家。");
    g_tipLine[16407] = StringToText("· 尽可能多地怀疑具有检测恶魔能力的玩家。如果善良玩家能确认善良玩家，那是无益的，但不是世界末日。");
    g_tipLine[16408] = StringToText("  如果善良玩家可以确认爪牙，那还过得去，因为被处决的是爪牙而不是恶魔。但是能够确认恶魔的玩家是毁灭性的。");
    g_tipLine[16409] = StringToText("  他们需要被抹杀。");
    g_tipLine[16410] = StringToText("· 如果你是恶魔，选择不可证伪的伪装角色。在正常的游戏中，能够回过头来说你的信息是错误的：「因为你可能喝醉或中毒」");
    g_tipLine[16411] = StringToText("  可能会起作用，因为善良阵营有很多处决来弄清楚哪些信息是真的，哪些不是。当利维坦在场时，");
    g_tipLine[16412] = StringToText("  并且在最后一天还有很多玩家还活着时，善良阵营通常会回到最简单的解释，");
    g_tipLine[16413] = StringToText("  而不是弄清楚大局——通过处决信息似乎有误的一名玩家。");
    g_tipLine[16414] = StringToText("· 如果你是一个爪牙，而还没有玩家被处决，尽你所能让自己看起来像一个善良玩家。");
    g_tipLine[16415] = StringToText("  这使您可以尽可能长时间地生存并传播错误信息。被怀疑作恶被处决是可以的。但是，你被处决后所有人都确认你是邪恶的，");
    g_tipLine[16416] = StringToText("  在最后一天之前再次处决，大家确认至少有一名死去的玩家是邪恶的时，这根本没有帮助。");
    g_tipLine[16417] = StringToText("· 如果你是一个爪牙，并且已经有一位玩家被处决，尽你所能看起来像一个恶魔。由于只剩下一次处决，");
    g_tipLine[16418] = StringToText("  被善良阵营认为可能是恶魔的每个玩家都可能在第五天被处决，避免恶魔被处决，从而使邪恶获胜。");
    g_tipLine[16419] = StringToText("【对抗利维坦】");
    g_tipLine[16420] = StringToText("· 关注已经过去了多少天。如果你知道还剩多少时间，可以相应地计划你的策略，并且你不会对游戏的意外结束感到惊讶。");
    g_tipLine[16421] = StringToText("· 计划在整个游戏中总共只执行两名玩家。如果你假定第一个被处决的玩家是善良的，");
    g_tipLine[16422] = StringToText("  你不会因为意外处决第二个善良玩家而输掉游戏。如果你假定第一个被处决的玩家是邪恶的，然后再次处决，");
    g_tipLine[16423] = StringToText("  那么你可能错了并且意外处决了两个善良玩家。每天处决玩家并假定他们是邪恶的，这是非常冒险的，可能会给邪恶带来胜利。");
    g_tipLine[16424] = StringToText("· 等到第三或第四天再处决第一个玩家。不用着急。你可以利用这段时间收集尽可能多的信息，并在以后明智地执行处决。");
    g_tipLine[16425] = StringToText("· 等到第五天执行第二个玩家。这保证了善良阵营不会因为处决两名善良玩家而输掉比赛，因为无论被处决的玩家的阵营如何，");
    g_tipLine[16426] = StringToText("  比赛都会在第五天结束时结束。等到第五天给善良阵营最大的时间来收集信息和讨论谁是谁的各种可能性。");
    g_tipLine[16427] = StringToText("· 如果你相当确定谁是爪牙，并且他们是会造成麻烦的爪牙类型，则在游戏早期处决他们。忽略可能是也可能不是爪牙的玩家，");
    g_tipLine[16428] = StringToText("  忽略可能是爪牙但不会过多影响好团队信息的玩家。例如，在游戏初期杀死投毒者或红唇女郎是绝对有益的，");
    g_tipLine[16429] = StringToText("  但杀死男爵或间谍并没有太大好处。当然，你剥夺了这些玩家的投票权，但由于可能只有两次处决恶魔的机会，");
    g_tipLine[16430] = StringToText("  因此善良阵营通过尝试在两次处决中处决恶魔来获得最大的获胜机会。");
    g_tipLine[16431] = StringToText("· 如果你几乎可以确定某个玩家是爪牙，请在游戏早期处决他们。这将有机会在比赛过程中处决三名玩家。");
    g_tipLine[16432] = StringToText("· 一些角色从处决玩家中受益，例如送葬者或食人族。如果这些角色在发挥作用，那么尽早处决可能会有所帮助。此外，");
    g_tipLine[16433] = StringToText("  由于利维坦不会在晚上行动，许多角色都被它所困扰，并以奇怪而有益的方式运作。");
    g_tipLine[16434] = StringToText("  与你的说书人核实这些角色的相克特殊规则。");
    g_tipLine[16435] = StringToText("· 找出哪些玩家是善良的。即使你可以建立一个90%确认为善良玩家的列表，这也会缩小恶魔的可能性范围。");
    g_tipLine[16436] = StringToText("  如果你能找出两三个善良玩家，那么在处决恶魔的时候，能够在五个玩家而不是八个玩家之间进行选择，更有可能获得胜利。");
    g_tipLine[16437] = StringToText("· 尽早在第一天分享你的信息。鼓励其他人也这样做。由于玩家不会在晚上死去，因此你可以相当肯定大多数（如果不是全部）");
    g_tipLine[16438] = StringToText("  信息角色将存活到最后一天。如果善良玩家在游戏中尽早分享他们的信息，他们会给自己尽可能多的时间来讨论可能性。");
    g_tipLine[16439] = StringToText("· 尽可能将你的信息分享给整个团队。利维坦局几乎不需要保密，每个人拥有的信息越多越好。");
    g_tipLine[16440] = StringToText("· 如果不止一名玩家声称与另一名玩家是同一个角色，则需要分析正反两种逻辑，并探索两者。通常，");
    g_tipLine[16441] = StringToText("  当两个玩家都声称是同一个角色时，其中一个是爪牙，最好同时处决他们。然而，由于可用的处决有限，");
    g_tipLine[16442] = StringToText("  通常最好将两个玩家都视为可能有有用的信息，并探索两者。其中一名玩家可能是爪牙，因此不需要处决。关键是要找到恶魔，");
    g_tipLine[16443] = StringToText("  而不仅仅是邪恶的玩家。");
    g_tipLine[16444] = StringToText("· 如果你想冒险，在最后一天之前处决两名玩家可以提供很棒的信息。如果两名玩家被处决并且游戏继续进行，");
    g_tipLine[16445] = StringToText("  那么你就知道其中至少有一个是爪牙。了解事实往往会滚雪球，并提供其他有用的信息，甚至100%确认或否认玩家的角色。");
    g_tipLine[16446] = StringToText("  但要注意……这个策略可能会在这个过程中输掉游戏。");
    g_tipLine[16447] = StringToText("· 中毒是邪恶角色能力的结果。知道哪个恶魔在场意味着你知道哪些恶魔不在场。查看剧本中可能在场的爪牙，");
    g_tipLine[16448] = StringToText("  这将告诉你哪些角色（如果有）正在毒害玩家。这可能是至关重要的信息。关注哪些爪牙可能在游戏中，并从这一点开始分析。");
    g_tipRoleAt[127] = 16323; g_tipRoleN[127] = 126; g_tipP1At[127] = 16327; g_tipP1N[127] = 12; g_tipP2At[127] = 16360; g_tipP2N[127] = 35;
    g_tipAbility[127] = StringToText("如果多于一名善良玩家被处决，邪恶阵营获胜。所有玩家都知道利维坦在场。在第五个白天结束时，邪恶阵营获胜。");
    g_tipLine[16449] = StringToText("【背景故事】");
    g_tipLine[16450] = StringToText("「夜晚寒冷而孤独，但我有月亮、星星、清风，还有鹅卵石上皮靴的轻柔撞击声与我作伴。远处，");
    g_tipLine[16451] = StringToText("  有烛光正在一扇昏暗的窗户后面闪烁……」");
    g_tipLine[16452] = StringToText("【角色能力】");
    g_tipLine[16453] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipLine[16454] = StringToText("【角色简介】");
    g_tipLine[16455] = StringToText("守夜人会让一名玩家得知他是守夜人。");
    g_tipLine[16456] = StringToText("· 在夜晚，守夜人选择一名玩家。这名玩家被唤醒，然后得知谁是守夜人。");
    g_tipLine[16457] = StringToText("· 守夜人和他选择的玩家不会有眼神交流。他们分开被唤醒。");
    g_tipLine[16458] = StringToText("· 守夜人选择哪个夜晚使用自己的能力。");
    g_tipLine[16459] = StringToText("【范例】");
    g_tipLine[16460] = StringToText("小兰是守夜人。小兰选择了小黑，小黑得知了小兰是守夜人。");
    g_tipLine[16461] = StringToText("小明是醉酒的守夜人。她选择了小米，小米没有被唤醒，也不会得知小明是守夜人。因为醉酒的守夜人不具有能力。");
    g_tipLine[16462] = StringToText("小八是守夜人且涡流在场。小八选择了道哥，道哥得知了小美是守夜人。虽然守夜人具有能力，但因为涡流在场，");
    g_tipLine[16463] = StringToText("  道哥会因此得知错误信息。");
    g_tipLine[16464] = StringToText("【运作方式】");
    g_tipLine[16465] = StringToText("每个夜晚，唤醒守夜人。要么守夜人摇头不使用能力，要么指向任意一名玩家。让守夜人重新入睡。");
    g_tipLine[16466] = StringToText("如果他指向了一名玩家，唤醒被他选择的玩家，对其展示守夜人的角色标记，然后指向守夜人玩家，随后让该玩家重新入睡。");
    g_tipLine[16467] = StringToText("  使用守夜人的「失去能力」标记标记守夜人。守夜人的能力被使用，将守夜人的夜晚标记从夜晚顺序表旁移除。");
    g_tipLine[16468] = StringToText("【提示标记】");
    g_tipLine[16469] = StringToText("· 失去能力");
    g_tipLine[16470] = StringToText("放置时机：在守夜人夜晚行动时选择使用能力，并选择了一名玩家后。");
    g_tipLine[16471] = StringToText("放置条件：只要守夜人选择了玩家，不论守夜人是否醉酒中毒，都会将此标记放置在守夜人角色标记旁。");
    g_tipLine[16472] = StringToText("移除时机：守夜人死亡或离场时。");
    g_tipLine[16473] = StringToText("【规则细节】");
    g_tipLine[16474] = StringToText("· 处于醉酒或中毒状态下且使用了自己能力的守夜人，会和能力正常生效的守夜人一样在游戏的剩余时间里将不会再被唤醒。");
    g_tipLine[16475] = StringToText("· 特定角色互动：");
    g_tipLine[16476] = StringToText("  · 学徒/食人族/哲学家/小精灵：仍然向被选择的玩家展示守夜人标记，即使是那名玩家是那些获得守夜人能力的角色。");
    g_tipLine[16477] = StringToText("  · 咖啡师：如果还未使用能力的守夜人受到咖啡师行动两次的影响，他可以选择两名玩家，被选择的玩家都会被告知。");
    g_tipLine[16478] = StringToText("    被选择的玩家不会被告知两次。");
    g_tipLine[16479] = StringToText("  · 侍女：守夜人在夜晚被唤醒可被侍女探查，即使当晚他选择不使用能力。然而，被守夜人选择的玩家不会被探查，");
    g_tipLine[16480] = StringToText("    因为他是由于守夜人的能力而被唤醒，而不是他自身的能力。");
    g_tipLine[16481] = StringToText("  · 莽夫：如果守夜人是当晚首个使用其自身能力选择了莽夫的玩家，守夜人会被莽夫醉酒，而莽夫不会得知守夜人是谁。");
    g_tipLine[16482] = StringToText("【提示与技巧】");
    g_tipLine[16483] = StringToText("· 作为守夜人，对你而言最重要的两个问题是「我应该何时使用我的能力？」以及「我的能力应该对谁使用？」");
    g_tipLine[16484] = StringToText("· 在游戏早期使用你的能力能确保你能够用出你的能力。就好像女裁缝或猎手一样，");
    g_tipLine[16485] = StringToText("  在游戏的前几天或几晚内死亡从而永远无法用出能力是一件憾事。尽早使用你的能力，");
    g_tipLine[16486] = StringToText("  即便它被用在一名你觉得不太理想的玩家身上，你也等于获得了一些收益。而且通常来说这点收益也已经足够了。如果有人，");
    g_tipLine[16487] = StringToText("  任何人，知道你是守夜人，那么他们不会投票赞成你被处决，而且也可能想其他人证明你是守夜人。");
    g_tipLine[16488] = StringToText("· 如果你愿意，你甚至可以在第一晚使用你的能力。这能保证你获得一些收益，因为在第一天或第二天晚上之前不会发生死亡。");
    g_tipLine[16489] = StringToText("· 在游戏后期使用你的能力会有更大的风险，因为你需要技巧和运气才能存活到这个时间，但此时能力会更有用。");
    g_tipLine[16490] = StringToText("  在极端情况甚至可以锁定胜局。比如，如果只有三名玩家存活，而你选择了其中一人知道你是守夜人（然后他们告诉了整个团队");
    g_tipLine[16491] = StringToText("  ），那可能的恶魔候选人就从三选一减少到二选一，或者如果你选择的玩家已经被确认为善良，就可以直接揭露恶魔是谁。");
    g_tipLine[16492] = StringToText("· 在决定选择哪名玩家时，你几乎总是想选择一名善良并且被证实善良的玩家。如果你选择了一名善良玩家，");
    g_tipLine[16493] = StringToText("  他们会在随后宣称你确实是守夜人，但你宣称他们也是善良阵营也许会不太行。");
    g_tipLine[16494] = StringToText("  如果他们已经通过比如共情者或者筑梦师的能力被证实是善良的，他们宣称你是善良的会更具分量。");
    g_tipLine[16495] = StringToText("  当两名玩家互相宣称是善良的，善良阵营会想要知道这两名玩家不是爪牙和恶魔。在选择之前，注意哪些玩家最可信，");
    g_tipLine[16496] = StringToText("  考虑他们作为你晚上的选择。");
    g_tipLine[16497] = StringToText("· 如果你选择了一名邪恶玩家，能力仍然会有些用处。如果那名邪恶玩家之后宣称你确实是守夜人，");
    g_tipLine[16498] = StringToText("  那么你已经向团队证明了自己。也许之后你会很快因恶魔死亡，但知道你是哪个阵营对善良阵营仍然是有帮助的信息。反之，");
    g_tipLine[16499] = StringToText("  如果你选择的玩家拒绝向团队承认被守夜人选择过，你就可以非常确信他们是邪恶的，");
    g_tipLine[16500] = StringToText("  因为善良玩家没有缘由对你的角色保持整局游戏的沉默。");
    g_tipLine[16501] = StringToText("· 如果你是一名得知守夜人是谁的善良玩家，你可以在次日清晨立即透露这个信息，或者等到游戏后期才透露。");
    g_tipLine[16502] = StringToText("  立即透露信息意味着每天需要考虑处决的玩家减少了一个，这会增加发现并处决恶魔的几率。对善良阵营而言，");
    g_tipLine[16503] = StringToText("  稍晚透露信息会提供极大的帮助，即使是在你死亡而守夜人仍存活时。等到只剩下三至五名玩家存活时才告诉团队你得知的信息");
    g_tipLine[16504] = StringToText("  会极大地增加你获胜的几率。");
    g_tipRoleAt[128] = 16449; g_tipRoleN[128] = 56; g_tipP1At[128] = 16452; g_tipP1N[128] = 7; g_tipP2At[128] = 16473; g_tipP2N[128] = 9;
    g_tipAbility[128] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名玩家：他会得知你是守夜人。");
    g_tipLine[16505] = StringToText("【背景故事】");
    g_tipLine[16506] = StringToText("「列位看官，请扶好帽盔，我将逆天而行，踏空起舞！身如飞燕，胆若雷霆，只为博君一笑一惊！」");
    g_tipLine[16507] = StringToText("【角色能力】");
    g_tipLine[16508] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipLine[16509] = StringToText("【角色简介】");
    g_tipLine[16510] = StringToText("杂技演员会在找到醉酒或中毒的玩家时死亡。");
    g_tipLine[16511] = StringToText("· 除首个夜晚之外的每个夜晚，杂技演员要选择一名玩家。如果该玩家在当晚保持清醒健康，什么也不会发生；");
    g_tipLine[16512] = StringToText("  如果该玩家醉酒或中毒，杂技演员就会死亡。");
    g_tipLine[16513] = StringToText("· 如果杂技演员自己醉酒或中毒，则不会因自身能力而死亡。");
    g_tipLine[16514] = StringToText("· 杂技演员可以选择任何玩家——无论存活还是死亡的玩家，也可以选择自己。");
    g_tipLine[16515] = StringToText("· 如果杂技演员选择的玩家在被选择时是清醒健康的，但在夜晚稍后阶段醉酒或中毒了，杂技演员仍会死亡。");
    g_tipLine[16516] = StringToText("· 杂技演员不会得知所选玩家是醉酒、中毒，还是两者皆有。");
    g_tipLine[16517] = StringToText("· 酒鬼（Drunk）会被杂技演员当作醉酒（drunk）（双关）。");
    g_tipLine[16518] = StringToText("【范例】");
    g_tipLine[16519] = StringToText("水手选择了刺客，说书人让水手醉酒了。杂技演员选择了水手，因为水手醉酒了，所以杂技演员死亡了。");
    g_tipLine[16520] = StringToText("杂技演员选择了清醒健康的修补匠，无事发生。");
    g_tipLine[16521] = StringToText("杂技演员选择了传教士。随后，普卡选择传教士，因为传教士中毒了，所以杂技演员死亡了。");
    g_tipLine[16522] = StringToText("【运作方式】");
    g_tipLine[16523] = StringToText("除首个夜晚以外的每个夜晚，唤醒杂技演员。让杂技演员指向一名玩家。将「被选择」提示标记放置到所选玩家的角色标记旁。");
    g_tipLine[16524] = StringToText("  让杂技演员重新入睡。");
    g_tipLine[16525] = StringToText("如果被选择的玩家在当晚任何时刻醉酒或中毒，杂技演员死亡——在杂技演员的角色标记旁放置「死亡」");
    g_tipLine[16526] = StringToText("  提示标记并放置帷幕标记。");
    g_tipLine[16527] = StringToText("【提示标记】");
    g_tipLine[16528] = StringToText("· 被选择");
    g_tipLine[16529] = StringToText("放置时机：在杂技演员夜晚行动并选择了玩家后。");
    g_tipLine[16530] = StringToText("放置条件：在杂技演员选择的玩家角色标记旁放置。");
    g_tipLine[16531] = StringToText("移除时机：在黎明时，或杂技演员死亡或离场时。");
    g_tipLine[16532] = StringToText("· 死亡");
    g_tipLine[16533] = StringToText("放置时机：在杂技演员选择的玩家醉酒或中毒时放置。");
    g_tipLine[16534] = StringToText("放置条件：杂技演员选择的玩家醉酒或中毒，且杂技演员可以死亡，放置在杂技演员角色标记旁边，");
    g_tipLine[16535] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[16536] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipRoleAt[129] = 16505; g_tipRoleN[129] = 32; g_tipP1At[129] = 16507; g_tipP1N[129] = 11; g_tipP2At[129] = 0; g_tipP2N[129] = 0;
    g_tipAbility[129] = StringToText("每个夜晚*，你要选择一名玩家：如果当晚他醉酒或中毒，你死亡。");
    g_tipLine[16537] = StringToText("【背景故事】");
    g_tipLine[16538] = StringToText("「红是你的发色，蓝是你的瞳色，死是你的褪色。」（爱尔兰盖尔语）");
    g_tipLine[16539] = StringToText("【角色能力】");
    g_tipLine[16540] = StringToText("如果恶魔杀死了你，所有玩家都会得知此事。从现在开始，你每天可以发起两次提名，每次投票时可以投两票。");
    g_tipLine[16541] = StringToText("【角色简介】");
    g_tipLine[16542] = StringToText("报丧女妖在死亡后获得力量，提名和投票次数变为原本的两倍。");
    g_tipLine[16543] = StringToText("· 报丧女妖在存活时，如常进行提名和投票。");
    g_tipLine[16544] = StringToText("· 如果恶魔杀死了报丧女妖，她每天可以发起两次提名，即使通常情况下来说已死亡的玩家无法发起提名。");
    g_tipLine[16545] = StringToText("· 如果恶魔杀死了报丧女妖，她可以自由地在提名中投票，无需消耗投票标记。她可以在同一次提名中投两票。");
    g_tipLine[16546] = StringToText("· 报丧女妖死亡后的能力只会在被恶魔杀死之后获得。死于处决或是死于非恶魔的能力不会让她获得这些能力。");
    g_tipLine[16547] = StringToText("· 如果要在一次提名中投出两票，报丧女妖需要在计票时同时举起两只手。如果玩家因为某些生理障碍无法做到这样的行为，");
    g_tipLine[16548] = StringToText("  说书人可以默认将他的常规票数翻倍。");
    g_tipLine[16549] = StringToText("【范例】");
    g_tipLine[16550] = StringToText("卡扎力杀死了报丧女妖。所有玩家都得知报丧女妖死亡。在下一个白天，报丧女妖提名了村夫并投了两票，");
    g_tipLine[16551] = StringToText("  然后又提名了恐惧之灵并投了两票，然后又在对修行者的提名中投了两票。在下下个白天，报丧女妖没有发起提名，");
    g_tipLine[16552] = StringToText("  但在对卡扎力的提名中投了两票。");
    g_tipLine[16553] = StringToText("报丧女妖中毒了。随后奥赫杀死了报丧女妖。无人得知报丧女妖死亡，并且在接下来的游戏时间里，报丧女妖无法发起提名，");
    g_tipLine[16554] = StringToText("  且只有最后一票。");
    g_tipLine[16555] = StringToText("半兽人杀死了报丧女妖。报丧女妖没有获得自己死亡后的能力，她的死讯也没有被宣告。");
    g_tipLine[16556] = StringToText("【运作方式】");
    g_tipLine[16557] = StringToText("如果报丧女妖被恶魔杀死，在报丧女妖的角色标记旁放置「具有能力」提示标记，并宣布「报丧女妖觉醒了」");
    g_tipLine[16558] = StringToText("  或是类似的有戏剧性的台词。从现在开始，报丧女妖每天可以发起两次提名，但该玩家需要自觉记住自己提名了几次。");
    g_tipLine[16559] = StringToText("  报丧女妖也可以在每次投票时举两只手投票，在计票的时候该玩家每举一只手就算投了一票。");
    g_tipLine[16560] = StringToText("如果报丧女妖在被恶魔杀死的时候不具有能力，或是被恶魔以外的能力杀死，说书人不会宣布她的能力被触发。在这种情况下，");
    g_tipLine[16561] = StringToText("  死亡的报丧女妖无法发起提名，并且需要使用投票标记来投票，如同其他死亡玩家一样。");
    g_tipLine[16562] = StringToText("如果所有善良玩家都已死亡，游戏继续。因为善良阵营仍然有可能因为报丧女妖还能发起提名而获胜。");
    g_tipLine[16563] = StringToText("【提示标记】");
    g_tipLine[16564] = StringToText("· 具有能力");
    g_tipLine[16565] = StringToText("放置时机：在恶魔杀死报丧女妖时。");
    g_tipLine[16566] = StringToText("放置条件：如果报丧女妖此时清醒健康，则将该标记放置在报丧女妖的角色标记旁。");
    g_tipLine[16567] = StringToText("移除时机：报丧女妖离场时。");
    g_tipLine[16568] = StringToText("【规则细节】");
    g_tipLine[16569] = StringToText("· 如果报丧女妖在获得死亡能力时清醒健康，但在随后醉酒中毒，她无法发起提名，且投票需要消耗投票标记。");
    g_tipLine[16570] = StringToText("· 特定角色互动：");
    g_tipLine[16571] = StringToText("  · 官员：官员会让报丧女妖的每一票都算作三票。");
    g_tipLine[16572] = StringToText("  · 窃贼：窃贼会让报丧女妖的每一票都算作负票。与官员效果结合后，每一票都算作负三票。");
    g_tipLine[16573] = StringToText("· 相克规则：");
    g_tipLine[16574] = StringToText("  · 利维坦：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果报丧女妖被选择，");
    g_tipLine[16575] = StringToText("    他死亡并能力生效。");
    g_tipLine[16576] = StringToText("  · 暴乱：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果报丧女妖被选择，他死亡并能力生效。");
    g_tipLine[16577] = StringToText("  · 涡流：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的‘通用简化原则’已涵盖包括多角色互动下的涡流");
    g_tipLine[16578] = StringToText("    信息的简化处理方式，此条仅作说明。）");
    g_tipLine[16579] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16580] = StringToText("  · 狸猫：如果狸猫与报丧女妖交换角色，不会触发报丧女妖的能力。");
    g_tipLine[16581] = StringToText("【提示与技巧】");
    g_tipLine[16582] = StringToText("· 想尽一切有用的办法让恶魔杀死你！");
    g_tipLine[16583] = StringToText("· 你可以在仍然存活的时候公开宣布你是报丧女妖。如果有其他信息佐证你的角色，");
    g_tipLine[16584] = StringToText("  就能迫使邪恶阵营杀死你并证实你是报丧女妖，又或者留你到最后一天，这样恶魔的选项就会减少一人。");
    g_tipLine[16585] = StringToText("· 你在死亡的时候会有明显的证明方式，你应该抓住这份优势。尽可能地收集他人的每一条信息。");
    g_tipLine[16586] = StringToText("· 你的投票会变得超模般地强力。随着存活人数的减少，你的两票会在强推一名玩家时占据越来越大的比重。然而，");
    g_tipLine[16587] = StringToText("  这是一把双刃剑，无论你的判断是对是错，你都会在处决中产生重大的影响。所以有的时候如果你还心存疑虑，");
    g_tipLine[16588] = StringToText("  你就得尝试控制好你的火力！");
    g_tipLine[16589] = StringToText("· 你的提名可能是善良玩家的唯一机会——与正常情况不同，如果只有邪恶玩家存活时游戏就会结束，");
    g_tipLine[16590] = StringToText("  但因为你即使死亡也能提名，所以存在所有存活玩家都是邪恶的可能性。游戏最终可能会因为你在三名邪恶玩家中找到了那个恶魔");
    g_tipLine[16591] = StringToText("  而结束。");
    g_tipLine[16592] = StringToText("· 一旦你死亡，你就可以将重心放在恶魔上——杀死爪牙可能不再那么重要，因为你不会因为只有邪恶玩家存活而输掉游戏！");
    g_tipLine[16593] = StringToText("  所以每天都处决看起来像恶魔的人吧！");
    g_tipLine[16594] = StringToText("· 每天都进行提名，因为大家都确信你是作为善良玩家在发起提名。每天至少参与一次投票，");
    g_tipLine[16595] = StringToText("  因为你的投票是善良阵营的优势力量。");
    g_tipLine[16596] = StringToText("· 如果你发现自己死在夜里，但说书人什么都没有说，记得先去找说书人确认你的能力是否未能触发，而不是一昧地去提名。");
    g_tipRoleAt[131] = 16537; g_tipRoleN[131] = 60; g_tipP1At[131] = 16539; g_tipP1N[131] = 10; g_tipP2At[131] = 16568; g_tipP2N[131] = 13;
    g_tipAbility[131] = StringToText("如果恶魔杀死了你，所有玩家都会得知此事。从现在开始，你每天可以发起两次提名，每次投票时可以投两票。");
    g_tipLine[16597] = StringToText("【背景故事】");
    g_tipLine[16598] = StringToText("「恒星的氢能，取之不尽，静待采掘；碳、氧、氖，尽数裂解。分子引发混沌，熵增由此产生，宇宙现象更替，原子紊乱重塑，");
    g_tipLine[16599] = StringToText("  物质聚合坍缩。所有的一切，都集中在这一个小小的锥形瓶中。」");
    g_tipLine[16600] = StringToText("【角色能力】");
    g_tipLine[16601] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipLine[16602] = StringToText("【角色简介】");
    g_tipLine[16603] = StringToText("科学怪人能够复制善良角色的能力。");
    g_tipLine[16604] = StringToText("· 只要科学怪人存活且清醒健康，恶魔就会拥有一个不在场的镇民或外来者角色的能力。");
    g_tipLine[16605] = StringToText("· 如果恶魔醉酒中毒，恶魔仍然保留自己获得的这个善良角色的能力。然而如果科学怪人醉酒中毒，");
    g_tipLine[16606] = StringToText("  恶魔就会暂时失去这个善良角色的能力。");
    g_tipLine[16607] = StringToText("· 如果恶魔拥有的能力是死亡后触发或保留的能力，且恶魔死亡，那么恶魔会保留获得的这项能力，例如心上人。");
    g_tipLine[16608] = StringToText("· 如果有新恶魔被创造，例如红唇女郎或理发师，那么新恶魔也能从科学怪人处获得能力。");
    g_tipLine[16609] = StringToText("  新恶魔获得的能力可以与旧恶魔获得的能力不同。");
    g_tipLine[16610] = StringToText("· 如果有多名恶魔同时在场且存活，只会有其中一名存活恶魔能够从科学怪人处获得能力。");
    g_tipLine[16611] = StringToText("· 如果在游戏设置时恶魔因此获得的能力能够影响初始设置，例如唱诗男孩，那么就会对游戏设置产生影响。");
    g_tipLine[16612] = StringToText("· 获得善良角色能力的恶魔与科学怪人都能得知恶魔获得了哪个角色的能力。");
    g_tipLine[16613] = StringToText("  说书人可以分别或同时唤醒这两名玩家通知他们相关信息。");
    g_tipLine[16614] = StringToText("· 恶魔因此获得的不在场角色能力可以来自于恶魔的伪装之一。");
    g_tipLine[16615] = StringToText("· 在夜晚时，恶魔会额外在这个善良角色被唤醒的时机下被唤醒。");
    g_tipLine[16616] = StringToText("【范例】");
    g_tipLine[16617] = StringToText("小恶魔拥有贞洁者的能力。戏法师提名了小恶魔，他立即被处决。");
    g_tipLine[16618] = StringToText("堤丰之首拥有侍女的能力。每个夜晚，堤丰之首会被额外唤醒一次，并需要选择两名玩家，");
    g_tipLine[16619] = StringToText("  得知他们之中因自身能力被唤醒的人数。在第四个夜晚，科学怪人醉酒，恶魔因此失去了侍女的能力，当晚不再被额外唤醒。");
    g_tipLine[16620] = StringToText("卡扎力拥有报丧女妖的能力。卡扎力在夜晚死亡，红唇女郎变成了卡扎力。死亡的卡扎力能在每个白天发起两次提名，");
    g_tipLine[16621] = StringToText("  每次提名中都能投出两票。");
    g_tipLine[16622] = StringToText("【运作方式】");
    g_tipLine[16623] = StringToText("在进行游戏设置时，将角色标记放入盲抽袋前，决定好恶魔获得的角色能力，");
    g_tipLine[16624] = StringToText("  并为恶魔本身和获得的角色能力做出相应的设置调整。在将角色标记收回并放入魔典后，");
    g_tipLine[16625] = StringToText("  将恶魔获得的能力对应的角色标记放置在恶魔的角色标记旁。");
    g_tipLine[16626] = StringToText("在首个夜晚，唤醒科学怪人和恶魔。对他们展示「该角色的能力对你生效」信息标记，然后是科学怪人的角色标记，");
    g_tipLine[16627] = StringToText("  再是恶魔获得能力的那个善良角色标记。在展示后将这个善良角色标记放回到恶魔的角色标记旁。");
    g_tipLine[16628] = StringToText("按照恶魔具有这个善良角色的能力一样来进行运作，同时恶魔还具有自己本身的能力。");
    g_tipLine[16629] = StringToText("【提示标记】");
    g_tipLine[16630] = StringToText("无");
    g_tipLine[16631] = StringToText("【规则细节】");
    g_tipLine[16632] = StringToText("· 如果科学怪人让恶魔拥有「能够让自己醉酒中毒」的能力（比如水手、食人族等），当这些能力导致自身醉酒或中毒时，");
    g_tipLine[16633] = StringToText("  仅影响恶魔因科学怪人拥有的能力，不会影响恶魔玩家原本的能力。");
    g_tipLine[16634] = StringToText("· 相克规则：");
    g_tipLine[16635] = StringToText("  · 异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[16636] = StringToText("  · 莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[16637] = StringToText("  · 异端分子：恶魔无法拥有异端分子的能力。");
    g_tipLine[16638] = StringToText("  · 食人魔：恶魔无法拥有食人魔的能力。");
    g_tipLine[16639] = StringToText("  · 政客：恶魔无法拥有政客的能力。");
    g_tipLine[16640] = StringToText("  · 酒鬼：恶魔无法拥有酒鬼的能力。");
    g_tipLine[16641] = StringToText("  · 炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的能力。");
    g_tipLine[16642] = StringToText("  · 村夫：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[16643] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16644] = StringToText("  · 悟道者：恶魔无法拥有悟道者的能力。");
    g_tipLine[16645] = StringToText("  · 狸猫：如果因科学怪人获得狸猫能力的恶魔与「太子」交换角色，改为「太子」变成狸猫且恶魔获得「太子」原本角色的能力。");
    g_tipLine[16646] = StringToText("【提示与技巧】");
    g_tipLine[16647] = StringToText("· 无论恶魔拥有什么能力，都要与他们协作！如果恶魔拥有贞洁者的能力，找到一个强大的善良镇民提名他们。");
    g_tipLine[16648] = StringToText("  如果恶魔拥有造谣者的能力，伪装成造谣者，在恶魔使用造谣者能力时发表虚假的声明。如果恶魔拥有侍臣的能力，");
    g_tipLine[16649] = StringToText("  找出恶魔让哪位善良角色醉酒，并说服该玩家相信他们是清醒且健康的。");
    g_tipLine[16650] = StringToText("· 陷害那些拥有可以互相确认能力的善良玩家。如果善良阵营认为游戏中有科学怪人存在，");
    g_tipLine[16651] = StringToText("  说服大家相信被确认的守夜人或教授其实是拥有善良角色能力的恶魔。游戏后期针对这些玩家发起攻击以保护恶魔。");
    g_tipLine[16652] = StringToText("· 活下来！只有你活着，恶魔才能继续使用善良角色能力！！！");
    g_tipLine[16653] = StringToText("· 如果恶魔获得的是限次能力，鼓励他们在你死亡之前使用。");
    g_tipLine[16654] = StringToText("· 作为恶魔，宣称自己是你当前拥有能力的角色。（尤其是当你拥有可验证的能力时！）");
    g_tipLine[16655] = StringToText("· 作为恶魔，有时可以声称自己是另一个不在场的角色，而不是获得能力的善良角色。如果你拥有和平主义者的能力，");
    g_tipLine[16656] = StringToText("  不要告诉任何人！让好人玩家以为有魔鬼代言人在保护邪恶玩家，而实际上是你的和平主义者能力阻止好人玩家死于处决。");
    g_tipLine[16657] = StringToText("  或者，如果你是拥有僧侣能力的涡流，保护像女裁缝或城镇公告员这样的获取信息型的镇民，");
    g_tipLine[16658] = StringToText("  让他们在涡流的游戏中获得正确（但因此自相矛盾）的信息。");
    g_tipLine[16659] = StringToText("· 作为恶魔，利用你获得的能力帮助邪恶阵营获取信息。作为奥赫，使用筑梦师的能力来检测那些你认为对你撒谎的玩家的角色。");
    g_tipLine[16660] = StringToText("  作为方古，使用图书管理员的能力来识别那些想在邪恶阵营面前隐藏自己的外来者。");
    g_tipLine[16661] = StringToText("· 作为恶魔，利用你的能力暗中干扰镇民。使用侍臣的能力扰乱好人玩家的信息！");
    g_tipLine[16662] = StringToText("  使用哲学家的能力让一个正在游戏中的善良角色不知不觉变得醉酒！");
    g_tipLine[16663] = StringToText("· 作为恶魔，在使用你的能力之前声称自己拥有该能力，以此来让善良玩家相信你。只是一定要在科学怪人死亡之前使用它！");
    g_tipLine[16664] = StringToText("· 作为恶魔，一开始不要提及你的能力，先让自己得到一位或多位善良玩家的信任！");
    g_tipLine[16665] = StringToText("· 如果善良玩家认为科学怪人在场，尽量让拥有可验证能力的玩家存活下来，借此把他们诬陷为恶魔。");
    g_tipLine[16666] = StringToText("  没有什么比让被确认的贞洁者、魔像和守夜人作为最后三名存活玩家更有意思的了！");
    g_tipLine[16667] = StringToText("【对抗科学怪人】");
    g_tipLine[16668] = StringToText("· 记住，被「确认」的玩家不一定是善良的，他们也可能是邪恶的恶魔！幸运的是，");
    g_tipLine[16669] = StringToText("  拥有特定能力并被确认的玩家中最多只有一人是恶魔。如果有玩家声称自己是弄臣、贞洁者、教授和守夜人，");
    g_tipLine[16670] = StringToText("  那么这4名玩家中至少有3个是好人！");
    g_tipLine[16671] = StringToText("· 相信你的社交属性判断，比如紧张的发言，飘忽不定的眼神。有时可能没有机械性的信息来区分教授和拥有教授能力的恶魔。");
    g_tipLine[16672] = StringToText("· 如果你拥有可确认的能力，寻找额外的信息来证明你是拥有该能力的善良玩家，而不是假扮成善良镇民或外来者能力的恶魔。");
    g_tipLine[16673] = StringToText("· 如果你认为游戏中有科学怪人存在，优先处决那些已经确认自己是好人的玩家。说书人通常会给恶魔一个可验证的能力，");
    g_tipLine[16674] = StringToText("  比如和平主义者、魔像或守夜人，因此处决这些玩家可以缩小恶魔玩家的范围。");
    g_tipLine[16675] = StringToText("· 如果奇怪且无法解释的事情不断发生，考虑一种可能性，即恶魔在暗中使用善良角色的能力来制造混乱。例如，");
    g_tipLine[16676] = StringToText("  如果旅店老板保护的玩家持续在夜晚死亡，考虑一下是否恶魔使用了哲学家的能力获得了旅店老板的能力，");
    g_tipLine[16677] = StringToText("  从而让真正的旅店老板处于醉酒状态。");
    g_tipLine[16678] = StringToText("· 要意识到恶魔可能拥有一个对邪恶没有收益的外来者能力。");
    g_tipLine[16679] = StringToText("· 如果你认为游戏中有科学怪人存在，要警惕那些在夜晚死亡的玩家，特别是如果剧本中有与死亡相关的角色时。");
    g_tipLine[16680] = StringToText("  拥有瘟疫医生能力的小恶魔可以以自己为目标，从而让邪恶阵营获得额外的爪牙能力。");
    g_tipLine[16681] = StringToText("  拥有报丧女妖能力的方古可以以外来者为目标以激活其报丧女妖的能力。拥有心上人能力的诺-达鲺可以在红唇女郎在场的情况");
    g_tipLine[16682] = StringToText("  下死亡，从而秘密地让一个善良玩家进入心上人的醉酒状态。");
    g_tipRoleAt[132] = 16597; g_tipRoleN[132] = 86; g_tipP1At[132] = 16600; g_tipP1N[132] = 16; g_tipP2At[132] = 16631; g_tipP2N[132] = 15;
    g_tipAbility[132] = StringToText("恶魔拥有一个不在场的善良角色的能力，即使他醉酒或中毒。你和他都知道他获得了什么能力。");
    g_tipLine[16683] = StringToText("【背景故事】");
    g_tipLine[16684] = StringToText("「莫尔街的谋杀案？假的噶！");
    g_tipLine[16685] = StringToText("巴斯克维尔的猎犬？假的噶！");
    g_tipLine[16686] = StringToText("尼罗河上的惨案？假的噶！」");
    g_tipLine[16687] = StringToText("【角色能力】");
    g_tipLine[16688] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可能会有一名玩家在这之后死亡。");
    g_tipLine[16689] = StringToText("【角色简介】");
    g_tipLine[16690] = StringToText("牙噶巴卜通过言语杀人。");
    g_tipLine[16691] = StringToText("· 说书人提供给牙噶巴卜的短语可以是任意长度，但建议是2到5个字左右。");
    g_tipLine[16692] = StringToText("· 如果牙噶巴卜说出了这段短语，说书人便可以在这之后，在下个黎明前的任意时机杀死一名玩家。");
    g_tipLine[16693] = StringToText("· 牙噶巴卜无论是通过单独说出这段短语，或将它混杂在整句话里说出，都可以触发效果。");
    g_tipLine[16694] = StringToText("· 牙噶巴卜可以在同一天多次说出这段短语。说书人可以因此杀死多名玩家。");
    g_tipLine[16695] = StringToText("· 由说书人来决定牙噶巴卜的能力会让哪名玩家死亡。");
    g_tipLine[16696] = StringToText("· 说书人可以选择只杀死少于牙噶巴卜说出短语的次数这一数量的玩家。");
    g_tipLine[16697] = StringToText("· 在牙噶巴卜醉酒或中毒期间，玩家不会因为他的能力死亡，即使牙噶巴卜在说出短语时清醒健康。在牙噶巴卜清醒健康期间，");
    g_tipLine[16698] = StringToText("  玩家会因为他的能力死亡，即使在牙噶巴卜在说出短语时醉酒或中毒。");
    g_tipLine[16699] = StringToText("· 只有极少数情况下，牙噶巴卜的能力才会让玩家在白天死亡。");
    g_tipLine[16700] = StringToText("【范例】");
    g_tipLine[16701] = StringToText("牙噶巴卜的秘密短语是「这很可疑」。他在第一个白天说了一次。当晚有一名玩家死亡。在下一个白天，");
    g_tipLine[16702] = StringToText("  他说出这段短语总共三次。当晚总共有三名玩家死亡。");
    g_tipLine[16703] = StringToText("牙噶巴卜在今天白天说出了秘密短语总共两次。女巫在场。异端分子在发起提名时死亡了，即使他没有被女巫诅咒。");
    g_tipLine[16704] = StringToText("  魔像提名了恶魔，然后魔像也死亡了。这两名玩家都是被牙噶巴卜的能力杀死的。");
    g_tipLine[16705] = StringToText("【运作方式】");
    g_tipLine[16706] = StringToText("在为首个夜晚做准备时，用纸条或手机便签或其他便捷的设备写下一段短语。");
    g_tipLine[16707] = StringToText("在首个夜晚，唤醒牙噶巴卜，对他展示这段短语，然后让他重新入睡。");
    g_tipLine[16708] = StringToText("每当牙噶巴卜在白天公开说出这段短语时，将一枚「死亡」提示标记放入魔典左侧的中央位置，");
    g_tipLine[16709] = StringToText("  用以提示你需要在今晚放置这个标记。");
    g_tipLine[16710] = StringToText("每个夜晚，你需要选择是否将放入魔典中央的「死亡」提示标记放置在一名玩家的角色标记旁。如果你这么做，");
    g_tipLine[16711] = StringToText("  那么同时为放置了提示标记的角色标记上再放置帷幕标记。这些玩家死亡。");
    g_tipLine[16712] = StringToText("尽量选择朴实的短语。如果恶魔获得的是不太常见的短语，他要么很容易被发现，要么就很少说出来。");
    g_tipLine[16713] = StringToText("  如果恶魔获得的是常见的短语，他可能会每天都把这句话说出来一次或者多次。");
    g_tipLine[16714] = StringToText("【提示标记】");
    g_tipLine[16715] = StringToText("· 死亡");
    g_tipLine[16716] = StringToText("放置时机：在牙噶巴卜说出他的秘密短语时。");
    g_tipLine[16717] = StringToText("放置条件：不论牙噶巴卜是否醉酒中毒，都会将一枚标记放入魔典正中央。");
    g_tipLine[16718] = StringToText("移动时机：在放置了标记之后，到下个黎明之前的任意时机，如果牙噶巴卜清醒健康，");
    g_tipLine[16719] = StringToText("  将这个标记移除或移动到任意一名存活玩家旁（如果该玩家能够被杀死）。");
    g_tipLine[16720] = StringToText("移除时机：在放置标记的当天白天说书人决定使用牙噶巴卜的能力杀死一名玩家时，或在黎明时说书人宣布死亡玩家后，");
    g_tipLine[16721] = StringToText("  或牙噶巴卜死亡或离场时。");
    g_tipLine[16722] = StringToText("【规则细节】");
    g_tipLine[16723] = StringToText("· 相克规则：");
    g_tipLine[16724] = StringToText("  · 驱魔人：如果驱魔人选中了牙噶巴卜，那么牙噶巴卜在当晚无法造成死亡。");
    g_tipLine[16725] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16726] = StringToText("  · 戏子：在戏子存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想要死亡」。不论他是否说过秘密短语，");
    g_tipLine[16727] = StringToText("    说书人都会在当晚杀死这名玩家。");
    g_tipLine[16728] = StringToText("  · 戏子（改）：在戏子（改）存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_tipLine[16729] = StringToText("    不论他是否说过秘密短语，说书人都会在当晚杀死这名玩家。");
    g_tipLine[16730] = StringToText("【提示与技巧】");
    g_tipLine[16731] = StringToText("· 尽可能频繁地说出你的短语！这就是你的攻击方式，至少你可以每天都为你那大杀四方的能力补充弹药！");
    g_tipLine[16732] = StringToText("· 注意每天只说出这段短语一次左右。你说出来的频率决定了你的短语的曝光程度，");
    g_tipLine[16733] = StringToText("  你肯定不愿意因为短语过于明显而让自己暴露了。每天一次是一个比较合适的参考次数，");
    g_tipLine[16734] = StringToText("  你依然有能力去伪装成是其他的恶魔在场。");
    g_tipLine[16735] = StringToText("· 请确保在你说出短语的时候，能够被说书人听见。如果他没能听见，你的能力不会产生任何效果，");
    g_tipLine[16736] = StringToText("  但这仍然会让你的短语频繁地被其他人听到。");
    g_tipLine[16737] = StringToText("· 跟你的爪牙们分享这段短语。他们能够帮助你创造适合说出这段短语的情形，让你在说出短语时显得更加自然，而非生硬。");
    g_tipLine[16738] = StringToText("· 相信说书人会为你冒险多次说出短语给与相应的奖励。你可以尝试冒着被当做话痨的风险来获得额外的攻击次数，");
    g_tipLine[16739] = StringToText("  这会让游戏更快进入终局。");
    g_tipLine[16740] = StringToText("· 如果说书人没有因为你多次说出短语而大开杀戒，这也不要紧。至少你可以每天只说一次短语，");
    g_tipLine[16741] = StringToText("  作为恶魔来说这样也足够有威慑力。");
    g_tipLine[16742] = StringToText("· 你的爪牙们可以决定自己的口癖，并多次重复说出，这样在游戏后期会让他们看起来很像是恶魔。");
    g_tipLine[16743] = StringToText("· 你可以趁有人出去私聊的时候说出短语。听到的人越少，大家就越难弄明白你究竟说了多少次短语。");
    g_tipLine[16744] = StringToText("· 注意那些经常说出某个短语的善良玩家。看起来像牙噶巴卜的人越多，你自己的短语就能藏得越深。");
    g_tipLine[16745] = StringToText("· 如果说书人给了你一个不太自然的短语，你不知道该如何把它放进你的发言里，");
    g_tipLine[16746] = StringToText("  那么你可以要求说书人给你换一个更加自然的短语。");
    g_tipLine[16747] = StringToText("· 充满自信地说出短语。不要尝试用自己的方式重组短语再说出来，说书人不一定会网开一面让你用这种方式触发能力。");
    g_tipLine[16748] = StringToText("· 将这段短语混进你的其他语义相近的发言中，这可以混淆视听，让其他人相信你正在真诚地发表自己的看法，");
    g_tipLine[16749] = StringToText("  而不是单纯地重复短语本身。");
    g_tipLine[16750] = StringToText("· 挑选一个跟你的短语无关的短语作为你的口癖并频繁说出来。这会让你看起来像是一个在为牙噶巴卜打掩护的爪牙。");
    g_tipLine[16751] = StringToText("· 尝试每次说出短语的时候，都使用不同的语气，强调不同的内容或以不同的节奏说出来。这会降低它的辨识度，");
    g_tipLine[16752] = StringToText("  让旁人听起来不像是同一段短语。");
    g_tipLine[16753] = StringToText("【对抗牙噶巴卜】");
    g_tipLine[16754] = StringToText("· 注意那些频繁重复的短语，并与恶魔在夜晚的杀戮情况进行对比。如果你对此抱有疑问，");
    g_tipLine[16755] = StringToText("  那么就值得处决那些重复说出短语的玩家以防万一，即使他们有可能是善良玩家。");
    g_tipLine[16756] = StringToText("· 小心那些爪牙，他们可能会重复说出一些短语，来借此掩盖牙噶巴卜的短语。");
    g_tipLine[16757] = StringToText("  任何过于频繁地说出同一段话的玩家都应该受到怀疑！");
    g_tipLine[16758] = StringToText("· 当说书人在认真聆听玩家的发言时，注意观察哪些玩家有刻意发言的冲动。牙噶巴卜会希望自己在说出短语时，");
    g_tipLine[16759] = StringToText("  说书人能够听到他的发言，所以会在说书人在场时有一定的发言欲望。");
    g_tipRoleAt[133] = 16683; g_tipRoleN[133] = 77; g_tipP1At[133] = 16687; g_tipP1N[133] = 13; g_tipP2At[133] = 16722; g_tipP2N[133] = 8;
    g_tipAbility[133] = StringToText("在你的首个夜晚，你会得知一段秘密短语。每次你在白天公开说出这段短语，当天便可能会有一名玩家在这之后死亡。");
    g_tipLine[16760] = StringToText("【背景故事】");
    g_tipLine[16761] = StringToText("「如同无月之夜里的篝火那般显眼……我看到你了，凡人。」");
    g_tipLine[16762] = StringToText("【角色能力】");
    g_tipLine[16763] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会被你杀死。");
    g_tipLine[16764] = StringToText("【角色简介】");
    g_tipLine[16765] = StringToText("奥赫能够杀死特定的角色。");
    g_tipLine[16766] = StringToText("· 与其他恶魔不同，奥赫在攻击时选择的是角色，而不是玩家。说书人可能需要提醒玩家奥赫能力的特殊之处。");
    g_tipLine[16767] = StringToText("  建议在游戏进入到夜晚阶段时，让所有玩家将角色列表放在手边。");
    g_tipLine[16768] = StringToText("· 如果奥赫愿意，他可以杀死邪恶角色。");
    g_tipLine[16769] = StringToText("· 如果某个角色有多名玩家在场，且奥赫选择了这个角色，只会有一名玩家死亡。");
    g_tipLine[16770] = StringToText("· 如果奥赫选择了不在场的角色，说书人大多数情况下都会杀死一名存活的善良玩家。说书人杀死死亡玩家或邪恶玩家虽然可行，");
    g_tipLine[16771] = StringToText("  但这种情况会非常少见。");
    g_tipLine[16772] = StringToText("【范例】");
    g_tipLine[16773] = StringToText("奥赫选择了瘟疫医生，瘟疫医生死亡。下一个夜晚，奥赫选择了罂粟种植者，罂粟种植者死亡。再下一个夜晚，");
    g_tipLine[16774] = StringToText("  奥赫选择了共情者。共情者不在场，因此说书人决定改为让修行者死亡。");
    g_tipLine[16775] = StringToText("【运作方式】");
    g_tipLine[16776] = StringToText("除首个夜晚以外的每个夜晚，唤醒奥赫。让奥赫指向角色列表上的一个角色标记。如果被选择的角色在场，");
    g_tipLine[16777] = StringToText("  对应的玩家死亡——使用「死亡」提示标记标记那名玩家。如果被选择的角色不在场，那么改为你来选择任意一名玩家，");
    g_tipLine[16778] = StringToText("  那名玩家死亡——使用「死亡」提示标记标记那名玩家。让奥赫重新入睡。");
    g_tipLine[16779] = StringToText("如果奥赫所在的剧本包含能够在同一个夜晚进行多次杀戮的恶魔，例如沙巴洛斯，并且奥赫选择了一个不在场的角色，");
    g_tipLine[16780] = StringToText("  你可以杀死超过一名玩家。这可以帮助奥赫伪装成另一种恶魔。");
    g_tipLine[16781] = StringToText("【提示标记】");
    g_tipLine[16782] = StringToText("· 死亡");
    g_tipLine[16783] = StringToText("放置时机：在奥赫夜晚行动并选择了角色后放置。");
    g_tipLine[16784] = StringToText("放置条件：因为奥赫的能力而会被杀死的玩家当前存活，且能被奥赫杀死，且奥赫未醉酒中毒，");
    g_tipLine[16785] = StringToText("  那么在该玩家的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[16786] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16787] = StringToText("【提示与技巧】");
    g_tipLine[16788] = StringToText("· 优先选择最强力的角色。你的能力的乐趣在于，你可以随心所欲地消灭那些你觉得最具威胁性的角色，");
    g_tipLine[16789] = StringToText("  所以放开手来结果他们吧！");
    g_tipLine[16790] = StringToText("· 考虑一下剧本中的其他恶魔——是否值得伪装成其他恶魔可能的行动来进行杀戮？如果你这样做，");
    g_tipLine[16791] = StringToText("  那意味着你可能不得不放弃优先击杀那些最具威胁性的镇民的做法，但这正是你的能力所在，");
    g_tipLine[16792] = StringToText("  所以你需要考虑一下是否值得去伪装成其他恶魔。");
    g_tipLine[16793] = StringToText("· 如果你觉得你的玩法会让玩家发现你是奥赫，请确保你以一个较弱的镇民角色或外来者角色进行伪装。");
    g_tipLine[16794] = StringToText("  你不会希望在三人决赛圈之前被玩家怀疑为什么你还没有死亡，而其他那些最强力的镇民都已经死了。");
    g_tipLine[16795] = StringToText("· 伪装成一个强力镇民角色，并让你的爪牙们也这样做！如果游戏中有好几个强力角色都还没死亡，");
    g_tipLine[16796] = StringToText("  这会让游戏看起来更像不是奥赫在场。同时，你的整个邪恶团队可以借此散播极具影响力的错误信息。");
    g_tipLine[16797] = StringToText("· 如果你不太确定某名玩家是不是真实地声称了自己的角色，你可以选择这个角色并找出真相。如果他死亡，那很棒，");
    g_tipLine[16798] = StringToText("  你知道你必须将他的信息纳入你的游戏逻辑中。如果他没有死亡，说明他在伪装，你可以无视他的信息。");
    g_tipLine[16799] = StringToText("· 注意那些在你的意料之外死亡的玩家。也许他和另一名玩家互通了角色，而实际上他才是你想要杀死的角色。");
    g_tipLine[16800] = StringToText("  也许你选择的角色并不在场，而他被说书人选中了。");
    g_tipLine[16801] = StringToText("· 基本上你不应该重复选择同一个角色，除非你想让说书人去进行杀戮！但是请记住，");
    g_tipLine[16802] = StringToText("  说书人选择目标的设计意图不是为了帮你摆脱困境，所以让说书人选择玩家可能并不是对你们阵营最有帮助的做法。");
    g_tipLine[16803] = StringToText("· 如果你们的剧本上有恶魔可以在夜晚制造复数死亡，你可以故意选择一个不在场角色（也许是你的伪装之一？），");
    g_tipLine[16804] = StringToText("  以便说书人制造复数死亡，从而让那些制造复数死亡的恶魔在场的逻辑能够成立。");
    g_tipLine[16805] = StringToText("  尽管这些杀戮可能比不上你去选择特定角色进行狙击那样有利，但这样做可以保持恶魔角色的不确定性。");
    g_tipLine[16806] = StringToText("· 别忘了外来者。如果你把所有注意力都集中在击杀镇民上，那么你可能会面临与两名外来者一起进入三人决赛圈的局面，");
    g_tipLine[16807] = StringToText("  而那两名外来者已经通过外来者数量配置来确证。所以不要忘了，外来者也值得被杀死。");
    g_tipLine[16808] = StringToText("· 如果你或爪牙想伪装一个没有在初始伪装信息里的角色，你可以在夜晚选择这个角色，通过结果判断它是否在场，");
    g_tipLine[16809] = StringToText("  并以此调整你的伪装。");
    g_tipLine[16810] = StringToText("【对抗奥赫】");
    g_tipLine[16811] = StringToText("· 如果你是强力角色，你可以声称自己是其他角色，即使你立即死于恶魔的能力。");
    g_tipLine[16812] = StringToText("  奥赫会通过使用他的能力立即杀死你来获得收益，但如果你令他认为你是某些较为弱势的角色，");
    g_tipLine[16813] = StringToText("  他会觉得自己选择了一个不在场角色，然后你可以在游戏后期用你的信息来让邪恶玩家大吃一惊。");
    g_tipLine[16814] = StringToText("· 如果你们发现奥赫在场，你们应该去相信那些早早死亡的强力角色。虽然他们可能没有太多信息，");
    g_tipLine[16815] = StringToText("  但你们基本上可以确信他们获得的信息，因为奥赫不会让他们产生错误信息。并且，奥赫在场的时候，");
    g_tipLine[16816] = StringToText("  玩家死在游戏前期这回事，就可以让你们相信他们大概率是好人，并且大概率正是他们自己声称的角色。");
    g_tipLine[16817] = StringToText("· 通过观察哪些角色死亡来判断奥赫是否在场。如果玩家都按照通常游戏那样死亡——死亡的是那些公开声明自己是强力角色，");
    g_tipLine[16818] = StringToText("  以及那些根据场上公开或半公开信息可以推断出来是强力角色的玩家，那么这很可能不是奥赫在场。");
    g_tipLine[16819] = StringToText("  如果死亡的是那些从头到尾都没有公开声明过自己的角色，并且一直游离在玩家信息之外的玩家，那么这可能是奥赫在场。");
    g_tipLine[16820] = StringToText("· 不要因为在游戏前期死亡的是外来者或不太重要的镇民就放弃奥赫在场的可能性。奥赫可能是在试图摆脱你们的追踪，");
    g_tipLine[16821] = StringToText("  或可能是意外地选中了不在场角色，然后说书人相应地选择更弱小的目标进行击杀。");
    g_tipLine[16822] = StringToText("· 注意那些在夜晚死亡的玩家所声称的角色。考虑一下存活玩家之中，谁的游戏思路比较有可能认为当前的死亡顺序最有利于邪恶");
    g_tipLine[16823] = StringToText("  阵营。如果你的小伙伴是奥赫，他会优先击杀什么角色？这个思路可以帮助你找出谁是真正的奥赫！");
    g_tipRoleAt[134] = 16760; g_tipRoleN[134] = 64; g_tipP1At[134] = 16762; g_tipP1N[134] = 10; g_tipP2At[134] = 0; g_tipP2N[134] = 0;
    g_tipAbility[134] = StringToText("每个夜晚*，你要选择一个角色：他死亡。如果该角色不在场，则由说书人来决定谁会被你杀死。");
    g_tipLine[16824] = StringToText("【背景故事】");
    g_tipLine[16825] = StringToText("「Gon(z)a7les6。请当Zn。机制已被FAN转。系统古攵阝章。重新{配}置。」");
    g_tipLine[16826] = StringToText("【角色能力】");
    g_tipLine[16827] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量外来者]");
    g_tipLine[16828] = StringToText("【角色简介】");
    g_tipLine[16829] = StringToText("卡扎力能自由选择自己的爪牙。");
    g_tipLine[16830] = StringToText("· 如果卡扎力在游戏中途被创造，他不会选择玩家成为新的爪牙。");
    g_tipLine[16831] = StringToText("· 说书人可以将这些变成爪牙的玩家的原本善良角色作为恶魔的伪装提供，因为这些角色都已不在场。");
    g_tipLine[16832] = StringToText("· 卡扎力对设置调整的效果在设置阶段和游戏的首个夜晚均会生效。");
    g_tipLine[16833] = StringToText("· 在唤醒这些爪牙，告诉他们自己的新角色的过程中，说书人可以让卡扎力见证这一过程，也可以让他先行入睡。");
    g_tipLine[16834] = StringToText("· 卡扎力只能选择位于角色列表上的爪牙。他不能选择让多名玩家变成同一个爪牙角色。");
    g_tipLine[16835] = StringToText("· 卡扎力能够将他想要的任意玩家变成爪牙，无论该名玩家的角色能力如何，例如：士兵，莽夫，落难少女，国王等。");
    g_tipLine[16836] = StringToText("【范例】");
    g_tipLine[16837] = StringToText("这是一场15人的游戏，没有爪牙在场。卡扎力被唤醒，他选择让道哥变成了邪恶的街头风琴手，让小米变成了邪恶的维齐尔，");
    g_tipLine[16838] = StringToText("  让小莱变成了邪恶的哥布林。");
    g_tipLine[16839] = StringToText("【运作方式】");
    g_tipLine[16840] = StringToText("在游戏设置时，移除所有的爪牙角色标记，并加入镇民和/或外来者角色标记，");
    g_tipLine[16841] = StringToText("  加入的角色标记总数量与移除的爪牙角色标记数量相等。");
    g_tipLine[16842] = StringToText("在首个夜晚，唤醒卡扎力。让他指向一名玩家，和角色列表上的一个爪牙角色。");
    g_tipLine[16843] = StringToText("  用这个爪牙的角色标记替换该玩家原本的角色标记，然后唤醒该玩家，对他展示「你是」信息标记和这个爪牙角色标记，");
    g_tipLine[16844] = StringToText("  然后展示向下的大拇指。重复这个流程，直到场上有与初始设置时同等数量的爪牙。让卡扎力重新入睡。");
    g_tipLine[16845] = StringToText("除首个夜晚以外的每个夜晚，唤醒卡扎力。让他指向任意一名玩家。那名玩家死亡——在他角色标记旁放置「死亡」提示标记。");
    g_tipLine[16846] = StringToText("  让卡扎力重新入睡。");
    g_tipLine[16847] = StringToText("根据具体剧本的不同，在设置时增加超过一个外来者角色可能会给善良阵营带来巨大的劣势。");
    g_tipLine[16848] = StringToText("【提示标记】");
    g_tipLine[16849] = StringToText("· 死亡");
    g_tipLine[16850] = StringToText("放置时机：在除游戏的第一个夜晚之外，卡扎力进行了夜晚行动并选择了玩家后放置。");
    g_tipLine[16851] = StringToText("放置条件：卡扎力选择的玩家当前存活，且能被卡扎力杀死，且卡扎力未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[16852] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[16853] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[16854] = StringToText("【规则细节】");
    g_tipLine[16855] = StringToText("· 在不考虑与其他角色交互时的运作，卡扎力对于爪牙的转化可以按照「重复这个流程，");
    g_tipLine[16856] = StringToText("  直到场上有与初始设置时同等数量的爪牙」来理解。然而实际上卡扎力的转化的更标准的描述形式应该是「重复这个流程，");
    g_tipLine[16857] = StringToText("  直到卡扎力进行了等同于初始设置爪牙数量次数的选择」。");
    g_tipLine[16858] = StringToText("· 虽然在运作方式中没有提到，然而卡扎力在设置时也可以移除一部分原有的外来者，并用对应数量的镇民进行替换。");
    g_tipLine[16859] = StringToText("· 特定角色互动：");
    g_tipLine[16860] = StringToText("  · 村夫：如果有复数个村夫在场，卡扎力的设置调整优先生效，其他的村夫因卡扎力的能力变成了爪牙，");
    g_tipLine[16861] = StringToText("    剩下的那名村夫一定是清醒的，因为这时村夫已经只有一个了。");
    g_tipLine[16862] = StringToText("· 相克规则：");
    g_tipLine[16863] = StringToText("  · 赏金猎人：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_tipLine[16864] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[16865] = StringToText("  · 召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[16866] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16867] = StringToText("  · 戏子：卡扎力和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变成戏子，");
    g_tipLine[16868] = StringToText("    卡扎力会在这一效果生效之前先进行转变爪牙的行动。");
    g_tipLine[16869] = StringToText("【提示与技巧】");
    g_tipLine[16870] = StringToText("· 选择做邪恶玩家时跟你配合得当的玩家。这是你组建邪恶阵营的大好时机，");
    g_tipLine[16871] = StringToText("  你能组建一支肆意碾压毫无戒心的可怜的善良玩家的团队，而不是随机决定的，东拼西凑的，磕磕绊绊的团队。");
    g_tipLine[16872] = StringToText("· 如果你不太拿得准谁跟你配合最好，那就选那些在跟你阵营不相同的时候会让你感到害怕的玩家。如果你打不过他们，");
    g_tipLine[16873] = StringToText("  就让他们加入你！");
    g_tipLine[16874] = StringToText("· 选择那些不是你作为卡扎力时最优选择的玩家。如果邪恶玩家的组合看起来有些奇特，");
    g_tipLine[16875] = StringToText("  那么就会更像是他们从盲抽袋里抽到了这些角色，也就不会怀疑恶魔是卡扎力了。");
    g_tipLine[16876] = StringToText("· 抛开那些「最佳策略」，选择最有意思的人！归根结底，这个游戏就是为了好玩，如果你觉得和一些人组队一定会很开心，");
    g_tipLine[16877] = StringToText("  那就选择他们，让他们加入，一起玩个痛快！");
    g_tipLine[16878] = StringToText("· 选择能力契合的爪牙。街头风琴手可以与哥布林或炸弹人产生巨大的配合，");
    g_tipLine[16879] = StringToText("  麻脸巫婆也乐意去使唤寡妇——尽可能组建出最适合的团队。");
    g_tipLine[16880] = StringToText("· 选择能让你假装成是另一种恶魔的爪牙。也许你想要瞒天过海，所以不妨选择刺客来让人们怀疑你是一个攻击性更强的恶魔，");
    g_tipLine[16881] = StringToText("  或者选择魔鬼代言人来让人们担心恶魔可能是痢蛭。");
    g_tipLine[16882] = StringToText("· 分配给你选择的玩家最适合他们游玩策略的爪牙角色。你不仅可以选择让谁加入你的团队，还能为他们分配角色！因此，");
    g_tipLine[16883] = StringToText("  请利用好这一优势，为你的爪牙们分配他们喜欢并且能发挥最大作用的角色。");
    g_tipLine[16884] = StringToText("【对抗卡扎力】");
    g_tipLine[16885] = StringToText("· 不要指望找到没有伪装的爪牙，因为根本就不存在！与卡扎力对战的缺点就是，");
    g_tipLine[16886] = StringToText("  所有爪牙在游戏开始时都会得知一个不在场的善良角色，因此他们从游戏开始时就有一个为他们备好的伪装，");
    g_tipLine[16887] = StringToText("  你无法凭借这一点来抓住他们。");
    g_tipLine[16888] = StringToText("· 然而，这也是一种明显的表象！如果每个人都很乐意在一开始就报出自己的角色，那么有可能就是卡扎力在场，");
    g_tipLine[16889] = StringToText("  并因此使得整个邪恶阵营都有伪装的机会。");
    g_tipLine[16890] = StringToText("· 检查外来者的数量。因为卡扎力会对外来者的数量产生不可预知的影响，因此这不会每每都有效，但是也有一定的用处，");
    g_tipLine[16891] = StringToText("  尤其是当你得知的信息表明没有其他效果对外来者的数量产生影响，然而外来者的数量又不太对劲的时候。");
    g_tipLine[16892] = StringToText("· 如果你认为这是卡扎力在场的对局，并且找到了一个爪牙，那么问问自己，谁会选择这名玩家，他还有可能选择谁？");
    g_tipLine[16893] = StringToText("  代入到游戏中的每一名玩家并做出设想，问自己那个爪牙是否会作为这名玩家的选择。如果是，那么根据你发现的信息，");
    g_tipLine[16894] = StringToText("  这名玩家是否有理由成为恶魔，是否可以通过思考他可能选择的其他爪牙来证实这一点？");
    g_tipRoleAt[135] = 16824; g_tipRoleN[135] = 71; g_tipP1At[135] = 16826; g_tipP1N[135] = 10; g_tipP2At[135] = 16854; g_tipP2N[135] = 15;
    g_tipAbility[135] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[由你决定谁是什么爪牙，-或+任意数量外来者]");
    g_tipLine[16895] = StringToText("【背景故事】");
    g_tipLine[16896] = StringToText("「1…2…唵嘛呢…3…4…叭咪吽…（嗖！）");
    g_tipLine[16897] = StringToText("是的，正如你们所见，女士们先生们，梵斯沃船长的那袋金子不见了！没了！无迹可循！感谢诸位，晚安啦！」");
    g_tipLine[16898] = StringToText("【角色能力】");
    g_tipLine[16899] = StringToText("恶魔会以为你是爪牙。爪牙会以为你是恶魔。");
    g_tipLine[16900] = StringToText("【角色简介】");
    g_tipLine[16901] = StringToText("魔术师能够迷惑邪恶玩家，让他们分不清究竟谁才是邪恶。");
    g_tipLine[16902] = StringToText("· 在游戏的首个夜晚，不是告诉所有爪牙哪名玩家是恶魔，而是改为告诉爪牙魔术师和恶魔都是恶魔。");
    g_tipLine[16903] = StringToText("· 在游戏的首个夜晚，恶魔会得知所有爪牙和魔术师都是爪牙。");
    g_tipLine[16904] = StringToText("· 魔术师不会因此被唤醒，也不会得知任何有关恶魔和爪牙的信息。");
    g_tipLine[16905] = StringToText("· 说书人在告知时可以以任意顺序指向魔术师和其他邪恶玩家，这样邪恶玩家就不会知道究竟哪一名玩家是魔术师了。");
    g_tipLine[16906] = StringToText("· 如果罂粟种植者死亡，导致恶魔和爪牙在游戏中途互认，魔术师的能力也会在那个夜晚生效，");
    g_tipLine[16907] = StringToText("  就如同常规情况下在首个夜晚时一样。");
    g_tipLine[16908] = StringToText("【范例】");
    g_tipLine[16909] = StringToText("小佳是利维坦，小美是魔术师。爪牙们被唤醒后，得知要么小佳是恶魔，要么小美是恶魔。小佳得知恐惧之灵玩家，");
    g_tipLine[16910] = StringToText("  刺客玩家和魔术师玩家（小美）都是爪牙。");
    g_tipLine[16911] = StringToText("【运作方式】");
    g_tipLine[16912] = StringToText("在首个夜晚，唤醒所有爪牙。对他们展示「他是恶魔」信息标记，然后指向恶魔与魔术师。让这些爪牙重新入睡。");
    g_tipLine[16913] = StringToText("在首个夜晚，唤醒恶魔。对他展示「他们是你的爪牙」信息标记，然后指向所有爪牙与魔术师。对他展示「这些角色不在场」");
    g_tipLine[16914] = StringToText("  信息标记，然后展示三个善良角色标记。让恶魔重新入睡。");
    g_tipLine[16915] = StringToText("以上述流程替代常规的爪牙信息与恶魔信息的步骤。");
    g_tipLine[16916] = StringToText("【提示标记】");
    g_tipLine[16917] = StringToText("无");
    g_tipLine[16918] = StringToText("【规则细节】");
    g_tipLine[16919] = StringToText("· 特定角色互动：");
    g_tipLine[16920] = StringToText("  · 赏金猎人：被赏金猎人转变为邪恶阵营的镇民不是爪牙或恶魔，因此魔术师不会因自身能力与该玩家发生互动。");
    g_tipLine[16921] = StringToText("  · 罂粟种植者：如果罂粟种植者死亡时魔术师还活着，他会影响爪牙/恶魔信息环节，就像他在首夜运作的那样。");
    g_tipLine[16922] = StringToText("  · 疯子：如果角色列表上有魔术师，你可以假装让疯子以为场上有魔术师，并且向他展示额外一名「爪牙」，");
    g_tipLine[16923] = StringToText("    无论场上是否真的有魔术师。");
    g_tipLine[16924] = StringToText("  · 主谋：不与魔术师的能力发生互动。尽管主谋以为魔术师是恶魔，但主谋能力不会将魔术师当作恶魔，");
    g_tipLine[16925] = StringToText("    所以魔术师被处决时不会触发主谋能力。");
    g_tipLine[16926] = StringToText("  · 灵言师：可以将魔术师转变为邪恶阵营。同样，当灵言师以为魔术师是恶魔，但灵言师能力将魔术师当作善良，");
    g_tipLine[16927] = StringToText("    因此如果魔术师首个说出关键词，当晚会转变为邪恶阵营。");
    g_tipLine[16928] = StringToText("  · 红唇女郎：参考主谋/灵言师。");
    g_tipLine[16929] = StringToText("  · 小恶魔：小恶魔选择在夜里自杀，不能将魔术师的角色改变为小恶魔。");
    g_tipLine[16930] = StringToText("  · 诺-达鲺：如果魔术师是与诺-达鲺邻近的镇民玩家，他无法影响恶魔/爪牙信息环节。");
    g_tipLine[16931] = StringToText("  · 涡流：不与魔术师发生互动。");
    g_tipLine[16932] = StringToText("  · 旅行者/传奇角色：既不是爪牙也不是恶魔（即使是拥有爪牙能力的学徒），所以不会被魔术师能力影响，");
    g_tipLine[16933] = StringToText("    只能得知正确的恶魔玩家。");
    g_tipLine[16934] = StringToText("  · 咖啡师：如果恶魔/爪牙在首夜因为咖啡师变得清醒且健康，恶魔/爪牙信息环节魔术师将不会向他展示。");
    g_tipLine[16935] = StringToText("· 相克规则：");
    g_tipLine[16936] = StringToText("  · 间谍/寡妇：当间谍/寡妇查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_tipLine[16937] = StringToText("    （请同样移除任何相关提示标记以便在缺少角色标记的情况下让其不是那么明显。）");
    g_tipLine[16938] = StringToText("  · 小怪宝：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_tipLine[16939] = StringToText("  · 维齐尔：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[16940] = StringToText("  · 亡魂：每次处决后，存活的魔术师可以公开猜测一名存活玩家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_tipLine[16941] = StringToText("  · 军团：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_tipLine[16942] = StringToText("  · 提线木偶：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_tipLine[16943] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[16944] = StringToText("  · 蛊雕：蛊雕会跳过魔术师。");
    g_tipLine[16945] = StringToText("【提示与技巧】");
    g_tipLine[16946] = StringToText("· 尽可能看起来邪恶。在提名目标上做出错误决定。随意投票。说值得信任的玩家不值得信任，或者反过来。");
    g_tipLine[16947] = StringToText("  邪恶玩家以为你是邪恶的，所以如果你的行为比其他人更邪恶，他们可能会认为你是邪恶玩家，而魔术师是其他人。");
    g_tipLine[16948] = StringToText("· 邪恶玩家相信你是邪恶的话会更倾向于让你存活。爪牙以为你是可能是恶魔。如果你被提名，请注意谁没有投票，");
    g_tipLine[16949] = StringToText("  或者谁似乎害怕投票。你可能找到了一些爪牙。");
    g_tipLine[16950] = StringToText("· 选择一个其他角色来伪装，或是尽可能长时间对你的角色保持沉默。如果邪恶阵营得知了你是魔术师，");
    g_tipLine[16951] = StringToText("  爪牙们就会知道谁是真正的恶魔，而恶魔也会知道谁是真正的爪牙——这不会结束游戏，");
    g_tipLine[16952] = StringToText("  但意味着你的能力不再对邪恶阵营造成任何干扰。");
    g_tipLine[16953] = StringToText("· 如果你发现了一名已被确证的善良玩家，比如贞洁者或是猎手，或是其他一名几乎已被确证的善良玩家，");
    g_tipLine[16954] = StringToText("  比如在单外来者游戏中唯一宣称自己是外来者的玩家，告诉他们你是魔术师。你需要尽可能地存活更久，");
    g_tipLine[16955] = StringToText("  有至少一名善良玩家（加上数名邪恶玩家）不想处决你会帮助达成这一点。");
    g_tipLine[16956] = StringToText("· 尽可能存活更久，不要被处决。恶魔可能不会在晚上杀死你，因为他们以为你是一个爪牙，所以你的存活取决于你和善良阵营。");
    g_tipLine[16957] = StringToText("  你存活越久，你的能力就越产生效果。");
    g_tipLine[16958] = StringToText("· 如果你认为已经被拆穿，邪恶阵营已经发现你是魔术师，那就告诉整个团队你是谁。和疯子一样，");
    g_tipLine[16959] = StringToText("  这一骗术不会持续整个游戏本就是预计内的。如果邪恶阵营知道你是谁，那么暴露自己也不会有任何损失。");
    g_tipLine[16960] = StringToText("· 观察人们的肢体语言和眼神交流。倾听人们话语中的暗示和潜台词。很有可能爪牙（可能也包括恶魔）");
    g_tipLine[16961] = StringToText("  会用各种方式试图接近你，比如以「你懂的」眼神或是暗示你他们了解你的阵营。邪恶阵营会试图互相发现，而你就是候选人。");
    g_tipLine[16962] = StringToText("  如果有人给了你一个会意的眼神或是眨眼，那就眨回去。如果有人接近你而你发现谈话不寻常或令人迷惑，");
    g_tipLine[16963] = StringToText("  对他们暗示你是邪恶的但不要真的说出来，可能会在某种程度上让他们相信你是邪恶的。");
    g_tipLine[16964] = StringToText("· 魔术师最理想的目标是欺骗邪恶玩家相信魔术师确实是邪恶的，并告诉魔术师其他邪恶玩家是谁。");
    g_tipLine[16965] = StringToText("  魔术师更现实的目标是让邪恶阵营迷惑足够久以至于他们会意外地互相残杀，或者至少需要花费几天时间来进行协调。");
    g_tipLine[16966] = StringToText("  如果你是魔术师，你不会得到关于你的计划是否生效的太多反馈。保持耐心，保持希望，如果你觉得你的能力没有产生效果，");
    g_tipLine[16967] = StringToText("  不要过于心急——可能正在产生。");
    g_tipLine[16968] = StringToText("· 如果你在夜晚死亡，恶魔要么发现你是魔术师，要么是故意杀死一名他们以为是爪牙的玩家，如果这种事发生，");
    g_tipLine[16969] = StringToText("  注意前一晚和后一晚的死者。恶魔可能会杀死所有可能的爪牙只是为了查明谁是谁。一旦你死亡，爪牙会知道你不是恶魔，");
    g_tipLine[16970] = StringToText("  但恶魔不会知道你不是爪牙。如果你死亡，注意那些私聊的玩家，他们可能是恶魔的爪牙，");
    g_tipLine[16971] = StringToText("  正在告诉恶魔他们知道了谁是（真正的）邪恶玩家。");
    g_tipRoleAt[136] = 16895; g_tipRoleN[136] = 77; g_tipP1At[136] = 16898; g_tipP1N[136] = 10; g_tipP2At[136] = 16918; g_tipP2N[136] = 27;
    g_tipAbility[136] = StringToText("恶魔会以为你是爪牙。爪牙会以为你是恶魔。");
    g_tipLine[16972] = StringToText("【背景故事】");
    g_tipLine[16973] = StringToText("「辟免剧勒润动。输要时间康护。莫要，抹药。」");
    g_tipLine[16974] = StringToText("【角色能力】");
    g_tipLine[16975] = StringToText("当你死亡时，说书人会获得一个爪牙能力。");
    g_tipLine[16976] = StringToText("【角色简介】");
    g_tipLine[16977] = StringToText("瘟疫医生会将额外的爪牙能力带入游戏中。");
    g_tipLine[16978] = StringToText("· 由说书人来选择获得哪一个爪牙的能力。");
    g_tipLine[16979] = StringToText("· 瘟疫医生的能力效果会在剩余的游戏时间里持续生效。");
    g_tipLine[16980] = StringToText("· 说书人不会有其他变化——他不会转为邪恶阵营，不会成为玩家，不会成为其他能力的合法目标，不能参与投票，");
    g_tipLine[16981] = StringToText("  也不能发起提名。");
    g_tipLine[16982] = StringToText("· 如果瘟疫医生在死亡时醉酒中毒，说书人不会获得爪牙能力，即使瘟疫医生在之后恢复清醒健康。");
    g_tipLine[16983] = StringToText("【范例】");
    g_tipLine[16984] = StringToText("瘟疫医生死亡了。说书人获得了投毒者的能力，并在随后的每个夜晚选择一名玩家使其中毒。");
    g_tipLine[16985] = StringToText("瘟疫医生死于处决，说书人获得了洗脑师的能力。当晚，麻脸巫婆将女巫变成了洗脑师。现在，");
    g_tipLine[16986] = StringToText("  场上有两个具有洗脑师能力的人——说书人和新的洗脑师。");
    g_tipLine[16987] = StringToText("瘟疫医生死亡了，说书人获得了街头风琴手的能力。两天后，瘟疫医生因为吟游诗人的效果醉酒。");
    g_tipLine[16988] = StringToText("  说书人仍然具有街头风琴手的能力，因为这项能力在瘟疫医生死亡时让说书人获得，");
    g_tipLine[16989] = StringToText("  因此现在瘟疫医生的醉酒并不会对说书人获得的能力产生影响。");
    g_tipLine[16990] = StringToText("【运作方式】");
    g_tipLine[16991] = StringToText("当瘟疫医生死亡时，将一个不在场的爪牙角色标记放置在魔典左侧的正中位置，并用瘟疫医生的「说书人能力」");
    g_tipLine[16992] = StringToText("  标记标记该爪牙角色；或直接用该标记标记一个在场的爪牙角色。如可能，在夜晚顺序表旁添加相应的夜晚标记用以提示。");
    g_tipLine[16993] = StringToText("当此爪牙角色的能力将要执行相关行动时，由说书人来为该能力做出一系列的选择。");
    g_tipLine[16994] = StringToText("【提示标记】");
    g_tipLine[16995] = StringToText("· 说书人能力");
    g_tipLine[16996] = StringToText("放置时机：瘟疫医生死亡时，且瘟疫医生未醉酒中毒。");
    g_tipLine[16997] = StringToText("放置条件：放置在由说书人决定获得的爪牙能力，其相应的角色标记旁。");
    g_tipLine[16998] = StringToText("移除时机：游戏结束时，或瘟疫医生离场时。");
    g_tipLine[16999] = StringToText("【规则细节】");
    g_tipLine[17000] = StringToText("· 相克规则：");
    g_tipLine[17001] = StringToText("  · 男爵：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_tipLine[17002] = StringToText("  · 炸弹人：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipLine[17003] = StringToText("  · 镜像双子：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[17004] = StringToText("  · 提线木偶：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木偶。");
    g_tipLine[17005] = StringToText("  · 恐惧之灵/哥布林/红唇女郎/间谍/亡魂：如果说书人本应获得这些爪牙之一的能力，改为一名爪牙玩家获得此能力，");
    g_tipLine[17006] = StringToText("    且他会得知此事。");
    g_tipLine[17007] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17008] = StringToText("  · 赶尸人/狐媚娘/养蛊人/蛊雕：如果说书人本应获得这些爪牙之一的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[17009] = StringToText("【提示与技巧】");
    g_tipLine[17010] = StringToText("· 不要让你自己被处决！你不会想给邪恶阵营一个额外的爪牙能力，所以你活得越久，");
    g_tipLine[17011] = StringToText("  那个可能出现的爪牙能力对局势的影响就会越小。");
    g_tipLine[17012] = StringToText("· 在你死亡后，找出因你死亡而加入游戏的爪牙能力。如果你能向其他善良玩家指出那些公开暴露的爪牙能力，");
    g_tipLine[17013] = StringToText("  或是那些不易暴露的爪牙能力存在的证据，这将能证明你是好人，并且因为证明你是外来者而强化你们阵营的逻辑链。");
    g_tipLine[17014] = StringToText("· 在你死亡后，找出因你死亡而加入游戏的爪牙能力——这个爪牙能力是之前不在场的爪牙能力，");
    g_tipLine[17015] = StringToText("  因此你们可以通过排除这个爪牙在场来确定游戏中可能存在哪些爪牙。");
    g_tipLine[17016] = StringToText("· 盘你的说书人——如果你认为说书人希望获得某个爪牙能力，你可以以此推断出哪些爪牙从一开始就在场，");
    g_tipLine[17017] = StringToText("  因为说书人会为了获得他最感兴趣获得的爪牙能力而留出空间让这个爪牙不在场。");
    g_tipLine[17018] = StringToText("· 如果游戏的初始配置有三名爪牙，你清楚在你死后所有爪牙能力都会在场，所以你们能够制订相应的对策。");
    g_tipLine[17019] = StringToText("· 通常来说，你可以预想到说书人使用爪牙能力往往比爪牙玩家更有效率，因为说书人完全了解游戏的所有信息，");
    g_tipLine[17020] = StringToText("  所以你要特别注意在你死后，游戏的平衡可能会有多大程度的倾斜。");
    g_tipRoleAt[137] = 16972; g_tipRoleN[137] = 49; g_tipP1At[137] = 16974; g_tipP1N[137] = 9; g_tipP2At[137] = 16999; g_tipP2N[137] = 10;
    g_tipAbility[137] = StringToText("当你死亡时，说书人会获得一个爪牙能力。");
    g_tipLine[17021] = StringToText("【背景故事】");
    g_tipLine[17022] = StringToText("「嘀…嘀…嘀…嗒。」");
    g_tipLine[17023] = StringToText("【角色能力】");
    g_tipLine[17024] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipLine[17025] = StringToText("【角色简介】");
    g_tipLine[17026] = StringToText("炸弹人会在被处决后引爆炸弹，消灭在场的绝大多数玩家。");
    g_tipLine[17027] = StringToText("· 如果炸弹人被处决，由说书人来选择会有哪些玩家被杀死，每次一名玩家，直到只剩三名玩家存活。");
    g_tipLine[17028] = StringToText("· 恶魔一定会是这三名存活的玩家之一（在绝大多数情况下都应该是这种结果，否则游戏就会立刻结束）。");
    g_tipLine[17029] = StringToText("· 玩家们要在十声倒数内决定下一个死亡的是谁。今天白天不会有其他的提名和处决，取而代之的是，");
    g_tipLine[17030] = StringToText("  所有玩家会用手指指向自己想要杀死的玩家。在倒数结束后，说书人会统计每名玩家被指向的次数。");
    g_tipLine[17031] = StringToText("  如果这种情况下出现了平局，那么游戏会进入夜晚阶段（邪恶阵营极有可能会因为恶魔在当晚的杀戮而获胜）。");
    g_tipLine[17032] = StringToText("· 即使是失去了投票标记的已死亡玩家，也能够用手指指向自己想要杀死的玩家。");
    g_tipLine[17033] = StringToText("· 玩家在倒数时间内可以随意更换手指指向的目标，在倒数结束后指向的结果才会作为最终结果。");
    g_tipLine[17034] = StringToText("· 炸弹人只会因为处决而触发能力。通过其他方式死亡，例如魔像或者精神病患者，不会触发能力。");
    g_tipLine[17035] = StringToText("  如果炸弹人被处决但没有死亡（由于魔鬼代言人等的能力），他的能力仍然会触发。");
    g_tipLine[17036] = StringToText("· 如果有不会死亡的角色在场，例如弄臣或水手，那么在炸弹人触发能力之后，可能会有多于三名玩家存活。");
    g_tipLine[17037] = StringToText("【范例】");
    g_tipLine[17038] = StringToText("小米是炸弹人，并且被处决了。她的能力被触发，在场的所有玩家除了珀、寡妇和占卜师之外全部死亡。");
    g_tipLine[17039] = StringToText("  所有玩家开始互相指认并展开了激烈的讨论。在倒数十声后，说书人宣布「停下」，并且此时被最多手指指着的是寡妇，");
    g_tipLine[17040] = StringToText("  她因此死亡。邪恶阵营获胜。");
    g_tipLine[17041] = StringToText("【运作方式】");
    g_tipLine[17042] = StringToText("如果炸弹人被处决，宣布炸弹人引爆了自己的炸弹。走进玩家座位围成的圆圈内，并用你的手指指向炸弹人，");
    g_tipLine[17043] = StringToText("  并顺时针开始转圈。（这会看起来像是统计投票一样。）当你的手指指向一名存活玩家时，说出「你还活着」或者「你死了」");
    g_tipLine[17044] = StringToText("  （如果他因为炸弹人的能力而死亡的话）。当你的手指走完一圈后，场上应该有包括恶魔在内的三名玩家仍然存活。然后，");
    g_tipLine[17045] = StringToText("  倒数十声。当倒数结束时，让所有玩家暂停（宣布「停下」），随即统计玩家用手指指向的结果。被最多手指指着的玩家死亡。");
    g_tipLine[17046] = StringToText("  这会因为只剩两名玩家存活而导致游戏结束，因此根据结果你需要宣布获胜的阵营。");
    g_tipLine[17047] = StringToText("你可以延长或缩短每一次倒数之间的间隔——做任何看起来富有戏剧性的事情，可供善良阵营讨论以及决定下一名死亡的玩家。");
    g_tipLine[17048] = StringToText("【提示标记】");
    g_tipLine[17049] = StringToText("无");
    g_tipLine[17050] = StringToText("【规则细节】");
    g_tipLine[17051] = StringToText("· 相克规则：");
    g_tipLine[17052] = StringToText("  · 瘟疫医生：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_tipLine[17053] = StringToText("【提示与技巧】");
    g_tipLine[17054] = StringToText("· 尽你所能更早被处决。你被处决的时间越早，善良团队收集到的信息越少，三选一时猜测的随机性也就越大。");
    g_tipLine[17055] = StringToText("· 尽你所能伪装得荒谬。如果善良玩家看穿了你的伪装而处决你，那就太棒了。如果善良玩家没能看穿你的伪装，");
    g_tipLine[17056] = StringToText("  那伪装也成功了，这仍然很有用。自称是杂耍艺人然后猜中五名玩家。在被共情者验证过的洗衣妇提名你后仍然宣称你是贞洁者");
    g_tipLine[17057] = StringToText("  。宣称是无神论者。一切皆有可能！");
    g_tipLine[17058] = StringToText("· 故意在你的伪装上犯错，让事情看起来像是伪装成善良玩家的邪恶玩家误解了善良角色的能力。");
    g_tipLine[17059] = StringToText("  宣称是占卜师并说从说书人处得知了「2」。或是宣称是在首夜就被唤醒的城镇公告员。");
    g_tipLine[17060] = StringToText("  如果你表现得像一名邪恶玩家意外地犯错，善良阵营可能就会处决你。");
    g_tipLine[17061] = StringToText("· 注意团队的共享信息。并给出与之矛盾的信息，然后让善良阵营自己得出结论。迟早，怀疑的目光会转向你。");
    g_tipLine[17062] = StringToText("· 当你被提名时，宣称你中毒或醉酒了，你并没有理由被处决，宣称一名深受信任的玩家是邪恶的，或者进行其他暧昧的辩护。");
    g_tipLine[17063] = StringToText("  如果你保持沉默，善良阵营会怀疑你是炸弹人而不处决你。如果你给出一个善良阵营不应处决你的确凿理由，");
    g_tipLine[17064] = StringToText("  比如提供一个可信的解释来说明玩家们是善良还是邪恶，那你就面临善良阵营相信你而让你存活的风险！");
    g_tipLine[17065] = StringToText("  注意在你的团队中玩家们通常以何种方式辩解会导致其被处决，并在你被提名时精确地给出那样的辩解。");
    g_tipLine[17066] = StringToText("· 告诉其他邪恶玩家你是炸弹人。尽早这样做以让他们抓住每个机会给你投票。");
    g_tipLine[17067] = StringToText("  并且恶魔也不会为了让你看起来像是善良玩家而试图在夜晚杀了你。");
    g_tipLine[17068] = StringToText("· 伪装成那些有时会因为善良阵营利益而被处决的角色，比如陌客。");
    g_tipLine[17069] = StringToText("· 在爆炸后，所有人都会知道你是爪牙。你可以随意指向你希望指向的玩家，包括恶魔。");
    g_tipLine[17070] = StringToText("  玩家们会因为查明恶魔是谁而忙得七荤八素以至于没空再次猜测你是否是那种会在这个时候指向恶魔的玩家。");
    g_tipLine[17071] = StringToText("  确保你总是在最后一秒才指向一名非恶魔玩家——因为每票都会被计入。");
    g_tipLine[17072] = StringToText("· 在爆炸后，如果你注意到玩家们正在利用你知道恶魔是谁这点来改变他们指向的人，那就改变你指向的人。然后，");
    g_tipLine[17073] = StringToText("  如果团队讨论的结果指向你新指向的人，就再次变更指向。");
    g_tipLine[17074] = StringToText("· 如果你是一名邪恶玩家但不是炸弹人，那就试着谋划让炸弹人看起来邪恶。伪装成能获得关于邪恶角色信息的镇民，");
    g_tipLine[17075] = StringToText("  比如调查员或贤者，然后指向炸弹人玩家。如果镇民玩家已经共享了信息使得炸弹人看起来是邪恶的，");
    g_tipLine[17076] = StringToText("  那就通过假装成共情者或驱魔人让这些镇民看起来善良。如果善良玩家开始相信炸弹人是邪恶的并自愿提名他，");
    g_tipLine[17077] = StringToText("  他们就更有可能投票给他。");
    g_tipLine[17078] = StringToText("· 如果你是一名邪恶玩家但不是炸弹人，那就试着谋划让炸弹人看起来善良但「为了小镇的大义」而处决他。在某些情况下，");
    g_tipLine[17079] = StringToText("  处决一名善良玩家会有利于善良阵营。伪装成比如送葬者角色来鼓动这种处决。");
    g_tipLine[17080] = StringToText("· 如果你是恶魔，那就尽可能让自己与炸弹人划清界限，因为善良阵营会知道谁是炸弹人，");
    g_tipLine[17081] = StringToText("  所以在炸弹人爆炸后你不会希望任何事情将你们两个联系到一起。如果你认为你们两个之间有过多的关联，");
    g_tipLine[17082] = StringToText("  比如钟表匠知道你们相距多远，那就和其他邪恶玩家谈谈，谋求避免处决炸弹人——因为这件事并不总有用。");
    g_tipLine[17083] = StringToText("· 如果你是邪恶，保持沉默，或者说些能让人误解你是邪恶的话。这有可能会让善良玩家相信你是炸弹人而避免处决你。");
    g_tipLine[17084] = StringToText("  这风险很高，因为这种方法向善良阵营泄露了你是邪恶的事实。");
    g_tipLine[17085] = StringToText("· 如果你是爪牙而炸弹人还没有爆炸，那么保留你让你自己显得很可疑这种可能性。如果说书人让你在炸弹人爆炸后存活，");
    g_tipLine[17086] = StringToText("  那你看起来像是善良的话可能会意外地说服善良玩家指向你以外的玩家，这意味着他们更有可能指向恶魔。");
    g_tipLine[17087] = StringToText("  如果你看起来太过邪恶，你就可能会在炸弹人之前被意外处决。最好的场景是说书人在爆炸后让你存活但你看起来比恶魔更可疑");
    g_tipLine[17088] = StringToText("  ，这样多数善良玩家会指向你，让你死亡。");
    g_tipLine[17089] = StringToText("· 当玩家们狂热于互相指向并且有三名玩家存活时，不要为指向平局而太过慌张。如果没有人因为指向而死亡，");
    g_tipLine[17090] = StringToText("  游戏将会继续而夜晚将由于处决完成而立即来临。当晚恶魔（大概率）会杀死一名玩家而让邪恶阵营获胜。");
    g_tipLine[17091] = StringToText("· 当玩家们狂热于互相指向并且因为某些特殊情况某名玩家没有死亡而有四名玩家存活时，确保不要有平局。如果游戏继续，");
    g_tipLine[17092] = StringToText("  夜幕降临时有四名玩家存活，那就还会有一次处决，这就不太合适了。");
    g_tipLine[17093] = StringToText("【对抗炸弹人】");
    g_tipLine[17094] = StringToText("· 注意哪些玩家看起来对死亡充满热忱，无论其原因为何。也许是他们宣称已经使用了他们的能力？");
    g_tipLine[17095] = StringToText("  也许是他们宣称对小镇造成了妨碍？也许是他们因为剧本上有涡流而提名了自己？注意那些玩家试图被处决时给出的可笑理由。");
    g_tipLine[17096] = StringToText("  对于想要被处决的玩家，注意他们的合理逻辑。在执行对他们的处决时慎之又慎。");
    g_tipLine[17097] = StringToText("· 让团队知道炸弹人在剧本上，并且有可能在场。确保所有玩家知道这个角色的机制。一些爪牙，比如洗脑师，");
    g_tipLine[17098] = StringToText("  能够在能力激活后再对其讨论。但其他一些爪牙，比如主谋，就需要在能力激活之前就被讨论和理解。");
    g_tipLine[17099] = StringToText("  让所有玩家都知道他们的机制，这可以在之后减少恐慌。");
    g_tipLine[17100] = StringToText("· 如果你认为炸弹人在场，那就不要太过担忧于确证善良玩家是否善良，这通常来说是一个值得如此做的好策略，");
    g_tipLine[17101] = StringToText("  因为查明哪些玩家是善良的并让他们存活到最后一天能让你知道谁不是恶魔。然而，当炸弹人爆炸时，");
    g_tipLine[17102] = StringToText("  说书人几乎一定会杀死那些可信的善良玩家，转而让哪些看起来最可疑的玩家存活，以让善良阵营在选择指向时遭遇困难。");
    g_tipLine[17103] = StringToText("  因此在游戏早期，查明谁可能是邪恶的比谁可能是善良的要有用很多。");
    g_tipLine[17104] = StringToText("· 如果善良阵营在某些玩家小团体归属于同一阵营这点上有绝佳的信息，那么故意处决炸弹人可能是有好处的。比如，");
    g_tipLine[17105] = StringToText("  如果你知道「张三、李四和王五在同一阵营」以及「大宝、二宝、三宝在同一阵营」，");
    g_tipLine[17106] = StringToText("  那张三是炸弹人的事实能让你知道李四和王五也是邪恶的，那大宝、二宝和三宝就都是善良的。这是很重要的信息，");
    g_tipLine[17107] = StringToText("  如果你认为这足以获胜，那么就找到并处决炸弹人。");
    g_tipLine[17108] = StringToText("· 如果炸弹人爆炸了，而你没有关于应该指向谁的可靠信息，看看你是否能让所有玩家的指向归于同一名特定玩家。");
    g_tipLine[17109] = StringToText("  如果需要改变指向，那所有玩家转而指向同一名新玩家。如果每个人都指向错误的玩家，");
    g_tipLine[17110] = StringToText("  善良阵营将投票分散到三个可选玩家的行为也将几乎确保邪恶阵营获胜。即使是平局也会导致邪恶阵营获胜。");
    g_tipLine[17111] = StringToText("  让大多数玩家同意指向同一名玩家会好于让优柔寡断和混乱不堪阻断善良阵营的配合。你能肯定邪恶阵营会互相配合。");
    g_tipLine[17112] = StringToText("· 如果炸弹人爆炸了，而你有可靠的信息应当指向谁，那就尽可能早地指向你的目标。让其他人尽早指向他们的目标。");
    g_tipLine[17113] = StringToText("  你不会希望善良玩家意外地根本没有指向。指向你的目标，不要改变，并且对你为什么是对的以及为什么其他人也应当指向这名");
    g_tipLine[17114] = StringToText("  玩家给出简短而有力的论点。不同于处决，（炸弹人的指向）没有足够长的时间来对你知晓的答案进行更长更合理的论证，");
    g_tipLine[17115] = StringToText("  而只有有限的时间支持你用简短而有说服力的数句话来让其他人改变主意。如果看起来你不能说服足够玩家跟随你，");
    g_tipLine[17116] = StringToText("  那就指向另一名玩家并鼓励其他人跟随。无论如何都要避免平局的发生。");
    g_tipLine[17117] = StringToText("· 如果炸弹人爆炸了，将你知道一名玩家是爪牙这件事转化为你们的优势。类似贵族或送葬者这类角色可能在之前已经得知过爪牙");
    g_tipLine[17118] = StringToText("  ，此刻会更可信，他们的信息也会对结果更有帮助。即使没有这样的角色，");
    g_tipLine[17119] = StringToText("  知道一名玩家是爪牙的事实也意味着你可能知道谁不是爪牙。无论这些玩家存活还是死亡，这都会透露更多信息。");
    g_tipLine[17120] = StringToText("  如果你能快一些，这些新信息可能会为你应当指向谁提供新线索。接下来的技巧将是在时间结束之前说服其他人相信你的逻辑。");
    g_tipRoleAt[138] = 17021; g_tipRoleN[138] = 100; g_tipP1At[138] = 17023; g_tipP1N[138] = 14; g_tipP2At[138] = 17050; g_tipP2N[138] = 3;
    g_tipAbility[138] = StringToText("如果你被处决，除三名玩家以外的其他所有玩家均会死亡。倒数十声后，被最多玩家手指指着的玩家死亡。");
    g_tipLine[17121] = StringToText("【背景故事】");
    g_tipLine[17122] = StringToText("「我从未见过如此光明的一日，阴森利爪不再笼罩着我。」");
    g_tipLine[17123] = StringToText("【角色能力】");
    g_tipLine[17124] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipLine[17125] = StringToText("【角色简介】");
    g_tipLine[17126] = StringToText("鹰身女妖在善良玩家之间制造争论与怀疑。");
    g_tipLine[17127] = StringToText("· 在夜晚时，鹰身女妖选择玩家时是一次选择一名玩家，而不是同时选择两名玩家。");
    g_tipLine[17128] = StringToText("· 被鹰身女妖选择的玩家会在鹰身女妖下一次进行选择之前持续被影响。");
    g_tipLine[17129] = StringToText("· 如果说书人决定通过鹰身女妖的能力杀死玩家，那么他必须决定是杀死其中一名玩家还是全部杀死。");
    g_tipLine[17130] = StringToText("· 鹰身女妖可以选择已死亡的玩家。如果她这么做，那么说书人只能杀死当前仍存活的目标玩家，");
    g_tipLine[17131] = StringToText("  因为已死亡的玩家不能再次死亡。");
    g_tipLine[17132] = StringToText("· 被鹰身女妖的能力杀死的玩家的死亡顺序由说书人决定，这一点非常重要。");
    g_tipLine[17133] = StringToText("【范例】");
    g_tipLine[17134] = StringToText("鹰身女妖选择了僧侣和工程师。僧侣宣称自己是调查员且得知了工程师玩家，并且号召玩家处决他。有玩家质疑他的行为，");
    g_tipLine[17135] = StringToText("  他再次宣称工程师玩家在他的信息之下看起来非常邪恶，因此他避免了自己因为鹰身女妖的能力而死亡。");
    g_tipLine[17136] = StringToText("鹰身女妖选择了神谕者和已死亡的炼金术士。神谕者宣称他信任炼金术士玩家，因为神谕者的信息说明了他并不是邪恶玩家。");
    g_tipLine[17137] = StringToText("  说书人宣布神谕者死亡。");
    g_tipLine[17138] = StringToText("小文和小米被鹰身女妖选择了。小文没有让善良阵营相信小米是邪恶的。说书人杀死了小文和小米。");
    g_tipLine[17139] = StringToText("【运作方式】");
    g_tipLine[17140] = StringToText("每个夜晚，唤醒鹰身女妖。让鹰身女妖指向一名玩家，再指向另一名玩家。用「疯狂」提示标记标记第一名玩家，");
    g_tipLine[17141] = StringToText("  并用「第二名」提示标记标记第二名玩家。让鹰身女妖重新入睡。唤醒标记了「疯狂」的玩家。");
    g_tipLine[17142] = StringToText("  对他展示「该角色的能力对你生效」信息标记，以及鹰身女妖的角色标记。然后指向标记了「第二名」的玩家。");
    g_tipLine[17143] = StringToText("  让这名玩家重新入睡。");
    g_tipLine[17144] = StringToText("明天，如果标记了「疯狂」的玩家没有「疯狂」地证明标记了「第二名」的玩家是邪恶阵营，");
    g_tipLine[17145] = StringToText("  你可以杀死这两名玩家其中的一人或全部。");
    g_tipLine[17146] = StringToText("【提示标记】");
    g_tipLine[17147] = StringToText("· 疯狂");
    g_tipLine[17148] = StringToText("放置时机：在鹰身女妖夜晚行动并选择了玩家后。");
    g_tipLine[17149] = StringToText("放置条件：放置在鹰身女妖选择的第一名玩家的角色标记旁。若此时鹰身女妖醉酒中毒，不放置该标记。");
    g_tipLine[17150] = StringToText("移除时机：在下一个夜晚唤醒鹰身女妖之前，或鹰身女妖死亡或离场时。");
    g_tipLine[17151] = StringToText("· 第二名");
    g_tipLine[17152] = StringToText("放置时机：在鹰身女妖夜晚行动并选择了玩家后。");
    g_tipLine[17153] = StringToText("放置条件：放置在鹰身女妖选择的第二名玩家的角色标记旁。若此时鹰身女妖醉酒中毒，不放置该标记。");
    g_tipLine[17154] = StringToText("移除时机：在下一个夜晚唤醒鹰身女妖之前，或鹰身女妖死亡或离场时。");
    g_tipLine[17155] = StringToText("【提示与技巧】");
    g_tipLine[17156] = StringToText("· 每晚都选择相同的两名玩家。一名善良玩家努力让大家觉得另一名善良玩家是邪恶的这件事只会有益于你的阵营，");
    g_tipLine[17157] = StringToText("  这会误导善良阵营把焦点放在错误的玩家身上。若非如此，在没人得知是鹰身女妖做出选择的情况下，");
    g_tipLine[17158] = StringToText("  玩家们对这两名玩家各执一词的持续关注最终可能会导致他们因你的能力而死亡。这两种情况都对你的阵营有极大帮助！");
    g_tipLine[17159] = StringToText("· 每晚都选择同样的第一名玩家。这名玩家将不得不持续切换他认为是邪恶的玩家，并在这个过程中越来越不受到大家信任，");
    g_tipLine[17160] = StringToText("  尤其是在没有其他玩家声称自己被鹰身女妖选择的情况下，这意味着会让这名玩家自己看起来是邪恶的。");
    g_tipLine[17161] = StringToText("· 每晚都选择不同的玩家。雨露均沾！当然，这将会让大家在游戏的第二天就知道鹰身女妖在场，");
    g_tipLine[17162] = StringToText("  但他们永远也无法确定是因为鹰身女妖的能力还是因为玩家内心真的相信如此，才让他想把别人通过投票投死。");
    g_tipLine[17163] = StringToText("  因此当恶魔真的被别人以充分的理由想要处决至死时，他也许可以利用对方可能被鹰身女妖能力选择的逻辑来逃脱大家的关注。");
    g_tipLine[17164] = StringToText("· 选择死亡的玩家作为第一名玩家。死亡玩家关于应该处决谁的论据往往更有分量，所以如果是死亡玩家要求对方去死，");
    g_tipLine[17165] = StringToText("  你们就有更大的机会让第二名玩家被处决。");
    g_tipLine[17166] = StringToText("· 选择死亡玩家作为第二名玩家。让玩家去声称已经死亡的玩家是邪恶的，可能看起来并不是最有效的做法，");
    g_tipLine[17167] = StringToText("  但是这可能会让玩家们相信在场恶魔是亡骨魔，并且他在夜晚杀死了一名爪牙，");
    g_tipLine[17168] = StringToText("  或是让大家相信昨天由于鹰身女妖的操纵而被处决的玩家的确是邪恶的，从而让送葬者认为他自己的信息出错。");
    g_tipLine[17169] = StringToText("· 每局游戏至少选择一次邪恶玩家，这是好事。你需要偶尔选择一次邪恶玩家，不然你们会面临这样的风险：");
    g_tipLine[17170] = StringToText("  玩家们相信所有被鹰身女妖选择过的玩家都是善良的，游戏进行一段时间后，");
    g_tipLine[17171] = StringToText("  他们就会开始处决那些从来没被鹰身女妖选择过的玩家。");
    g_tipLine[17172] = StringToText("· 通常来说，在游戏后期，尤其是在决赛日，不太值得去选择邪恶玩家。除非你试图把善良玩家从一条既定的逻辑中带出来。");
    g_tipLine[17173] = StringToText("  大多数情况下，在游戏后期让一名善良玩家将另一名善良玩家打成邪恶，以便引走恶魔身上的火，");
    g_tipLine[17174] = StringToText("  这将对你和你的恶魔产生更大的帮助。");
    g_tipLine[17175] = StringToText("· 偶尔选择一次恶魔！如果可以的话，说书人不太可能会通过你的能力杀死恶魔，所以你们很有可能在这个操作中毫发无伤。");
    g_tipLine[17176] = StringToText("  但是，如果你选择恶魔作为第二名玩家，你们会面临第一名玩家非常成功地说服大家相信恶魔是邪恶的并将他处决的风险！");
    g_tipLine[17177] = StringToText("  另一方面，被选择的玩家可能会因为自己表演得不够好而开始好奇为什么他和恶魔都没有死亡。");
    g_tipLine[17178] = StringToText("· 如果你的团队只需要加快死亡，你可以选择自己。当你需要有玩家表现得不够疯狂的时候，那个人就是你自己！");
    g_tipLine[17179] = StringToText("  忽视掉你需要疯狂证明的事情，并通过各种方式声称场上其他玩家都是邪恶的，然后与你的目标一同死亡，");
    g_tipLine[17180] = StringToText("  满怀期待地将游戏推进到玩家们意料之外的决赛日。");
    g_tipLine[17181] = StringToText("· 当你在游戏中进行一些怪异的投票时，声称自己被鹰身女妖选中是证明这些行为合理的非常好的办法。");
    g_tipLine[17182] = StringToText("  当你得知别人声称自己是圣徒却还是要给他投票？噢，原来你被鹰身女妖选择了，这很合理。");
    g_tipLine[17183] = StringToText("· 选择自己是隐藏鹰身女妖在场的最佳方式。既然每晚只会有一名玩家得知自己被鹰身女妖选择，");
    g_tipLine[17184] = StringToText("  选择自己能够让你以最好的方式在遵守疯狂规则的同时以不太明显的方式表现疯狂，由此可以否认自己被鹰身女妖的能力影响，");
    g_tipLine[17185] = StringToText("  使得那些在随后的游戏中声称自己被鹰身女妖影响的玩家看起来非常可疑。");
    g_tipLine[17186] = StringToText("· 在你没有使用能力选择自己时声称自己被鹰身女妖选择，有时候是值得这样做的。");
    g_tipLine[17187] = StringToText("  这会让你与另一名真正被鹰身女妖选择的玩家产生直接冲突，但同时会让玩家们感到迷惑，不知道谁才是真正被选择的那一位。");
    g_tipLine[17188] = StringToText("  在这种情况下，如果你再次选择同一名玩家，可能会导致第一名玩家通过与第二名玩家一起死亡来证明他才是真正被选择的那名");
    g_tipLine[17189] = StringToText("  玩家，然而这些额外死亡只会对你的阵营有益。");
    g_tipLine[17190] = StringToText("【对抗鹰身女妖】");
    g_tipLine[17191] = StringToText("· 最低程度地满足疯狂的标准，让你和第二名玩家在白天存活下来。你总是可以通过在第二天指出自己被鹰身女妖选择来解释你曾");
    g_tipLine[17192] = StringToText("  经的行为，但今天你不必打破疯狂来造成两个人的死亡，从而让游戏向着对邪恶有利的方向加速。");
    g_tipLine[17193] = StringToText("· 如果你不介意死亡，并且你认为第二名玩家也不介意死亡，尤其是大家认为鹰身女妖不在场的时候，不去遵循疯狂的规则。");
    g_tipLine[17194] = StringToText("  两个人在白天突然死亡是最快的方法去证明大家想错了，同时也更显著地表明鹰身女妖的能力正在发挥作用。");
    g_tipLine[17195] = StringToText("· 如果你真的认为第二名玩家是邪恶的，就不去遵循疯狂的规则。这是高风险-高回报的方式，看看说书人是否会杀死你们。");
    g_tipLine[17196] = StringToText("  如果说书人真的这样做了，那么第二名玩家就不太可能是邪恶的。就算他是邪恶的，你所做的只是设法单杀了一名邪恶玩家！");
    g_tipLine[17197] = StringToText("  如果他和你一起死亡，至少你会知道他基本上不可能是恶魔。");
    g_tipLine[17198] = StringToText("· 如果你多次被鹰身女妖的能力要求疯狂地证明一名特定玩家是邪恶的，那么几乎可以肯定这名玩家不是恶魔。");
    g_tipLine[17199] = StringToText("  对于邪恶团队来说，他们很少能够在一名善良玩家声称恶魔是邪恶的持续压力下为恶魔开脱，");
    g_tipLine[17200] = StringToText("  所以他们不太可能选择恶魔作为第二名玩家，因此你可以把这名玩家当作可能不是恶魔的玩家。虽然这并不能保证他是善良的，");
    g_tipLine[17201] = StringToText("  因为除了恶魔以外的邪恶玩家都是可以牺牲的！");
    g_tipLine[17202] = StringToText("· 如果你被鹰身女妖选择要疯狂地证明死亡玩家是邪恶的，那就接受它。如果你半途而废，");
    g_tipLine[17203] = StringToText("  说书人通过鹰身女妖的能力杀死你的时候不需要考虑太多，因为当另一名玩家已经死亡时，");
    g_tipLine[17204] = StringToText("  说书人触发鹰身女妖的能力只会杀死你。因此你在面对死亡的第二名玩家时可能有更高的风险会死亡！");
    g_tipLine[17205] = StringToText("· 如果有玩家反复声称某个特定玩家是邪恶的，并且你认为他受到了鹰身女妖的影响，如果你内心并不相信他的声明，");
    g_tipLine[17206] = StringToText("  只是为了不去打破他的疯狂，你不必公开表示支持他的声明，而可以在不影响他的推论的有效性的前提下继续提出其他的逻辑线");
    g_tipLine[17207] = StringToText("  。你声称一名其他玩家是邪恶的，这与他的说法并不矛盾，所以你不应该认为鹰身女妖导致的疯狂证明会阻碍你做出与陷入疯狂");
    g_tipLine[17208] = StringToText("  的玩家不同的提名或指控。");
    g_tipLine[17209] = StringToText("· 如果有新的玩家开始指控另一名玩家是邪恶的，并且你认为是鹰身女妖在发挥作用，");
    g_tipLine[17210] = StringToText("  可能你会想以比平时更温和的方式去要求他合理化他的指控，以避免他与另一名玩家都死亡的风险。");
    g_tipLine[17211] = StringToText("· 如果你认为鹰身女妖在场，要么就把大家的注意力放在尝试找出善良玩家并杀死其他玩家的游戏方式上，");
    g_tipLine[17212] = StringToText("  要么只把注意力放在杀死恶魔并忽视其他邪恶玩家的游戏方式上。");
    g_tipRoleAt[139] = 17121; g_tipRoleN[139] = 92; g_tipP1At[139] = 17123; g_tipP1N[139] = 10; g_tipP2At[139] = 0; g_tipP2N[139] = 0;
    g_tipAbility[139] = StringToText("每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，否则他们之中可能会有人死亡。");
    g_tipLine[17213] = StringToText("【背景故事】");
    g_tipLine[17214] = StringToText("「如果你想让别人听信你的花言巧语，那么就搭配上一段音乐吧。」");
    g_tipLine[17215] = StringToText("（英文维基上的背景描述与角色详解中的不同，此处也一并贴出。见下）");
    g_tipLine[17216] = StringToText("「曲柄划圆吱呀吱，舞步渐狂心渐痴。」");
    g_tipLine[17217] = StringToText("【角色能力】");
    g_tipLine[17218] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。");
    g_tipLine[17219] = StringToText("每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipLine[17220] = StringToText("【角色简介】");
    g_tipLine[17221] = StringToText("街头风琴手会让投票秘密进行。");
    g_tipLine[17222] = StringToText("· 当一名玩家被提名后，在投票时所有玩家都需要闭上眼睛。");
    g_tipLine[17223] = StringToText("· 说书人在计票时不会大声唱票，也不会在一次投票结束时告诉大家有多少玩家投了票。");
    g_tipLine[17224] = StringToText("· 说书人不会告诉大家某次提名是否导致了一名玩家「即将被处决」。");
    g_tipLine[17225] = StringToText("· 在提名阶段结束后，说书人宣布了哪名玩家被处决，和正常一样。");
    g_tipLine[17226] = StringToText("· 已死亡的玩家在有投票标记时能够如常投票，但仅限一次。他们的投票标记会在当天白天结束时被移除而不是在单次投票后立即");
    g_tipLine[17227] = StringToText("  被移除。");
    g_tipLine[17228] = StringToText("· 如果街头风琴手醉酒，和正常情况一样，所有玩家睁眼投票。说书人无需对此进行额外说明，比如街头风琴手是否死亡或存活。");
    g_tipLine[17229] = StringToText("  当天夜晚，街头风琴手要再次选择自己醉酒或清醒。");
    g_tipLine[17230] = StringToText("【范例】");
    g_tipLine[17231] = StringToText("有八名玩家存活。贵族被提名了。所有玩家闭眼投票，贵族获得了5票。小恶魔被提名了。所有玩家闭眼投票，");
    g_tipLine[17232] = StringToText("  小恶魔获得了7票。小精灵被提名了。所有玩家闭眼投票，小精灵获得了4票。在提名阶段结束时，");
    g_tipLine[17233] = StringToText("  说书人宣布道哥（小恶魔的玩家）被处决并死亡，善良阵营获胜。");
    g_tipLine[17234] = StringToText("【运作方式】");
    g_tipLine[17235] = StringToText("每个夜晚，唤醒街头风琴手点头或摇头。街头风琴手如果点头：放置「醉酒」提示标记；如果摇头：不放置「醉酒」提示标记。");
    g_tipLine[17236] = StringToText("  让街头风琴手重新入睡。");
    g_tipLine[17237] = StringToText("当一名玩家被提名后开始投票时，如果街头风琴手是清醒的，要求所有玩家闭上双眼。如果有玩家询问原因，");
    g_tipLine[17238] = StringToText("  那么告诉他们街头风琴手在场。秘密无声地进行票数的统计。在那之后，不要告诉大家有多少玩家投了票，");
    g_tipLine[17239] = StringToText("  也不告诉大家被提名者是否「即将被处决」。如果被提名者有足够被处决的票数，标记那名玩家「即将被处决」。");
    g_tipLine[17240] = StringToText("  告诉所有玩家可以睁开眼睛了，并继续处理接下来可能会有的提名。");
    g_tipLine[17241] = StringToText("当一天的所有提名都结束时，宣布当前被标记了「即将被处决」的玩家被处决（并死亡，或因为其他原因没有死亡）。");
    g_tipLine[17242] = StringToText("黄昏时，移除街头风琴手的醉酒提示标记。");
    g_tipLine[17243] = StringToText("玩家不允许使用任何手段或方式来决定谁来投票，例如触碰或是声响。投票必须是秘密进行的。");
    g_tipLine[17244] = StringToText("【提示标记】");
    g_tipLine[17245] = StringToText("· 即将被处决");
    g_tipLine[17246] = StringToText("放置时机：在一次提名的投票被统计，当前被提名者得票过半且是当天得票最多的玩家后。");
    g_tipLine[17247] = StringToText("放置条件：放置在该玩家的角色标记旁。");
    g_tipLine[17248] = StringToText("转移时机：当天有新的得票过半且得票超过被标记了「即将被处决」的玩家时，转移到新的即将被处决的玩家的角色标记旁。");
    g_tipLine[17249] = StringToText("移除时机：当天有玩家得票与「即将被处决」的玩家得票相同时，或处决执行完毕。");
    g_tipLine[17250] = StringToText("· 醉酒");
    g_tipLine[17251] = StringToText("放置时机：在街头风琴手夜晚行动后。");
    g_tipLine[17252] = StringToText("放置条件：在街头风琴手夜晚行动并点头后放置在街头风琴手的角色标记旁。若此时街头风琴手醉酒中毒，则不放置该标记。");
    g_tipLine[17253] = StringToText("移除时机：在黄昏时，或街头风琴手死亡或离场时。");
    g_tipLine[17254] = StringToText("【规则细节】");
    g_tipLine[17255] = StringToText("· 特定角色互动：");
    g_tipLine[17256] = StringToText("  · 枪手：因为说书人能够决定在游戏中有哪些旅行者可以出场并被玩家选择作为自己的旅行者角色，");
    g_tipLine[17257] = StringToText("    因此避免枪手在有街头风琴手的剧本中出场是应对这两个角色的奇怪互动的最好方式。");
    g_tipLine[17258] = StringToText("· 相克规则：");
    g_tipLine[17259] = StringToText("  · 管家：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，但只在他的主人投票时他的票才会被统计。");
    g_tipLine[17260] = StringToText("  · 炼金术士：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。如果炼金术士和街头风琴手都是清醒的，");
    g_tipLine[17261] = StringToText("    改为他们都醉酒。");
    g_tipLine[17262] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17263] = StringToText("  · 梼杌：当梼杌被处决时，如果街头风琴手具有能力，说书人会宣布「无人被处决」。");
    g_tipRoleAt[140] = 17213; g_tipRoleN[140] = 51; g_tipP1At[140] = 17217; g_tipP1N[140] = 13; g_tipP2At[140] = 17254; g_tipP2N[140] = 10;
    g_tipAbility[140] = StringToText("所有玩家在投票时闭眼，且票数会秘密统计。每个夜晚，你要选择自己是否醉酒直到下个黄昏。");
    g_tipLine[17264] = StringToText("【背景故事】");
    g_tipLine[17265] = StringToText("「出色的判决，陛下。冲撞主教这样的小罪的确值得您的‘正义’与‘仁慈’。而您只需要在花园里散散心，参观参观画廊，");
    g_tipLine[17266] = StringToText("  欣赏欣赏冯·斯特劳夫的雕塑作品。放轻松，陛下。把一切……都交给我。」");
    g_tipLine[17267] = StringToText("【角色能力】");
    g_tipLine[17268] = StringToText("所有玩家都知道你是维齐尔。");
    g_tipLine[17269] = StringToText("你在白天时不会死亡。");
    g_tipLine[17270] = StringToText("如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipLine[17271] = StringToText("【角色简介】");
    g_tipLine[17272] = StringToText("维齐尔能够处决玩家，无需经过镇子的同意。");
    g_tipLine[17273] = StringToText("· 在第一个白天，所有玩家都会得知维齐尔在场，并且知道是哪一名玩家。");
    g_tipLine[17274] = StringToText("· 在白天时，维齐尔不会因为任何原因死亡。");
    g_tipLine[17275] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且至少有一名善良玩家参与投票），那么被提名者会立即被处决。");
    g_tipLine[17276] = StringToText("  这算在每个白天的一次处决之内。");
    g_tipLine[17277] = StringToText("· 在一次提名的投票被统计后，如果维齐尔选择处决被提名者（且没有任何善良玩家参与投票），那么无事发生。");
    g_tipLine[17278] = StringToText("· 即使被提名者得票在存活玩家的半数以下，维齐尔仍然能够执行处决。即使有其他玩家得票比此次被提名者多，");
    g_tipLine[17279] = StringToText("  维齐尔仍然能够执行处决。");
    g_tipLine[17280] = StringToText("· 维齐尔无需在每个白天都使用自己的能力来造成强制处决。");
    g_tipLine[17281] = StringToText("【范例】");
    g_tipLine[17282] = StringToText("国王被提名了。有五名玩家投票，维齐尔没有使用他的能力。炸弹人被提名了，有八名玩家投票。维齐尔使用了他的能力，");
    g_tipLine[17283] = StringToText("  炸弹人立即被处决。");
    g_tipLine[17284] = StringToText("恶魔得到了7票，处于「即将被处决」状态。维齐尔提名了理发师小八。两名邪恶玩家和一名善良玩家投了票。");
    g_tipLine[17285] = StringToText("  维齐尔宣布使用能力处决了小八。恶魔今天得以幸存了。");
    g_tipLine[17286] = StringToText("维齐尔被提名并处决了，但没有因此死亡。当晚，恶魔杀死了维齐尔。");
    g_tipLine[17287] = StringToText("【运作方式】");
    g_tipLine[17288] = StringToText("当首个夜晚结束时，对所有玩家宣布维齐尔在场，并告知是哪一名玩家。");
    g_tipLine[17289] = StringToText("如果一次提名的投票统计结束，且至少有一名善良玩家参与投票，且维齐尔宣布被提名者被处决，那么那名玩家被处决并死亡。");
    g_tipLine[17290] = StringToText("  今天白天不会再发生更多的提名，投票和处决了。");
    g_tipLine[17291] = StringToText("【规则细节】");
    g_tipLine[17292] = StringToText("· 如果维齐尔受到非相克规则的角色带来的醉酒或中毒的效果影响，那么他能够在白天死亡，并且无法选择立即执行处决，");
    g_tipLine[17293] = StringToText("  但玩家不会知道这一点，直到维齐尔尝试这么做为止。");
    g_tipLine[17294] = StringToText("· 如果维齐尔在游戏中途被创造，所有玩家都会立即得知谁是维齐尔。然而如果维齐尔的角色中途发生了变化，");
    g_tipLine[17295] = StringToText("  玩家不会立即得知这一消息（因为暴露角色的能力来源消失了）。");
    g_tipLine[17296] = StringToText("· 相克规则：");
    g_tipLine[17297] = StringToText("  · 调查员：说书人不会宣布维齐尔在场。");
    g_tipLine[17298] = StringToText("  · 传教士：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[17299] = StringToText("  · 侍臣：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[17300] = StringToText("  · 魔术师：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_tipLine[17301] = StringToText("  · 戏法师：说书人不会宣布维齐尔在场。");
    g_tipLine[17302] = StringToText("  · 政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[17303] = StringToText("  · 狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[17304] = StringToText("  · 恐惧之灵：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。他会得知恐惧之灵选择了哪名玩家，");
    g_tipLine[17305] = StringToText("    并且无法使用自己的能力让那名玩家立即被处决。");
    g_tipLine[17306] = StringToText("  · 小怪宝：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[17307] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17308] = StringToText("  · 姑获鸟：姑获鸟无法获得维齐尔的能力。");
    g_tipLine[17309] = StringToText("【提示与技巧】");
    g_tipLine[17310] = StringToText("· 显然——你的能力就是处决别人！归根结底，你的能力就是处决任何你想要处决的人，所以不去使用这个能力是没有意义的。");
    g_tipLine[17311] = StringToText("  放下顾虑去处决，带着愉悦去处决，随心所欲地去处决！");
    g_tipLine[17312] = StringToText("· 不要总是去处决！善良玩家将会把你选择处决或不选择处决的行为解读成一种信息，");
    g_tipLine[17313] = StringToText("  所以那些你选择不去处决的玩家常常和你选择处决的玩家一样重要。");
    g_tipLine[17314] = StringToText("· 对于善良阵营来说，当你执行强制处决时什么样的玩家投了票也是很容易理解的信息。");
    g_tipLine[17315] = StringToText("  如果你在只有一名玩家投票的时候执行强制处决，那这名投票的玩家就会被证明是善良玩家，");
    g_tipLine[17316] = StringToText("  并且你在随后的游戏中无法指望有人会投票给他，因为善良玩家们没有理由再给这名玩家投上哪怕一票。");
    g_tipLine[17317] = StringToText("· 所有人都知道你是谁，所以不要太明显地和你的邪恶队友交谈——因为所有人都知道你是谁，所以你不需要伪装角色，");
    g_tipLine[17318] = StringToText("  因此在大多数时间里你不能真的去声称自己是维齐尔以外的角色。无论如何，你只需要向你的邪恶队友交谈以上内容就足够了。");
    g_tipLine[17319] = StringToText("· 与所有人交谈！即使是善良玩家也会重视这个了解你的想法的机会，并试图从你的状态解读出你的计划。");
    g_tipLine[17320] = StringToText("  你也可以在这个过程中与邪恶玩家交谈以便赶上他们的计划。");
    g_tipLine[17321] = StringToText("· 相信你自己对于其他玩家状态的解读，以及城镇广场上的信息提示——这些可能是你获取信息的主要方式！");
    g_tipLine[17322] = StringToText("· 如果你的邪恶队友与你相邻，在夜晚时和他们窃窃私语。这是你能与你的同伴交谈的仅有机会之一。");
    g_tipLine[17323] = StringToText("  你可以用这种方式获取信息并从邪恶阵营的视角去了解现在正在发生的事情，却不用担心会给他们造成过多嫌疑。");
    g_tipLine[17324] = StringToText("· 你需要掩盖你的意图并制定策略去解释你为何没有去处决特定玩家——有时你将需要在恶魔获得投票时不进行强制处决，");
    g_tipLine[17325] = StringToText("  因此事先对某些玩家没有被强制处决而设置一个合理的否定是非常重要的。");
    g_tipLine[17326] = StringToText("【对抗维齐尔】");
    g_tipLine[17327] = StringToText("· 对于判断谁是善良玩家而言，维齐尔对善良阵营来说是一个很好的信息来源。");
    g_tipLine[17328] = StringToText("  从维齐尔强制处决的投票中提取出谁是善良玩家这种信息往往是困难的，但绝对值得去做，显而易见的是，");
    g_tipLine[17329] = StringToText("  最好的信息就是只投了一票维齐尔就执行强制处决，从而证明那名投票的玩家是善良的，");
    g_tipLine[17330] = StringToText("  即使在随后的游戏中维齐尔选择只有三或四票的提名进行处决，这仍然是不错的信息。");
    g_tipLine[17331] = StringToText("· 对于维齐尔选择强制处决的玩家和不选择强制处决的玩家都给予同样多的关注。维齐尔不能在每天的第一次提名就进行处决，");
    g_tipLine[17332] = StringToText("  否则最终被提名的恶魔将很难解释为什么自己没有被处决。所以维齐尔在选择处决谁的时候需要使用一些狡猾的手段来迷惑好人");
    g_tipLine[17333] = StringToText("  。你需要设法看穿这些狡猾的伎俩，找出他的处决意图里真正的局限性在哪！");
    g_tipLine[17334] = StringToText("· 你知道维齐尔不是恶魔。他属于邪恶阵营，所以他会影响那些检测阵营的能力；但同样是因为维齐尔不是恶魔，");
    g_tipLine[17335] = StringToText("  所以他不需要被考虑为除了邪恶的维齐尔以外的其他任何信息，具有选择能力的角色不会去选择他。");
    g_tipLine[17336] = StringToText("· 在决赛日，如果维齐尔仍然存活，只需要对非恶魔玩家的一张善良玩家投票就可以让维齐尔获胜。然而，");
    g_tipLine[17337] = StringToText("  你拥有一些强有力的信息来说服你的善良队友——如果你所指控的玩家不是恶魔，维齐尔应该就已经强制处决并获胜了，");
    g_tipLine[17338] = StringToText("  所以维齐尔没有强制处决的事实意味着你无法接受除了你所指控的玩家，还有任何善良玩家在其他的提名里投票。");
    g_tipLine[17339] = StringToText("· 确保所有在白天时使用的能力在提名开始前已经使用。一旦开始提名阶段，白天可能会因为维齐尔的强制处决而随时结束，");
    g_tipLine[17340] = StringToText("  所以你需要在提名开始前抽出时间使用那些在白天使用的能力。");
    g_tipLine[17341] = StringToText("· 要记住，提名是你们对抗维齐尔的主要武器——如果维齐尔没有进行强制处决，");
    g_tipLine[17342] = StringToText("  不再发起提名可能是通过投票处决那些维齐尔不愿意强制处决的玩家的最佳方式。");
    g_tipLine[17343] = StringToText("· 利用好那些与处决和死亡有互动的善良能力，设法欺骗维齐尔使用能力来验证这些角色。例如，");
    g_tipLine[17344] = StringToText("  如果维齐尔好几次试图处决与茶艺师相邻的玩家，这些玩家却没有死亡，这能够铁证茶艺师的角色。");
    g_tipLine[17345] = StringToText("· 向维齐尔窃窃私语或者「不小心」透露一些信息可能会推迟他的强制处决——要记住，当所有人都知道维齐尔是邪恶玩家时，");
    g_tipLine[17346] = StringToText("  他只能掌握那些他设法弄清楚的公聊信息，因此如果你设计「泄露」一些可以影响维齐尔强制处决的信息让维齐尔无意中听到，");
    g_tipLine[17347] = StringToText("  你就能完全误导他对游戏局势的影响。");
    g_tipLine[17348] = StringToText("· 需要非常具有目的性地选择你要投票的玩家。每次维齐尔选择进行强制处决，这会给你们带来信息，但每次他选择不进行处决，");
    g_tipLine[17349] = StringToText("  这也会带来一点信息。设法操纵维齐尔去处决特定玩家会给你们带来大量信息，这些信息不一定是他们想披露给你们的。");
    g_tipRoleAt[141] = 17264; g_tipRoleN[141] = 86; g_tipP1At[141] = 17267; g_tipP1N[141] = 14; g_tipP2At[141] = 17291; g_tipP2N[141] = 18;
    g_tipAbility[141] = StringToText("所有玩家都知道你是维齐尔。你在白天时不会死亡。如果一次提名中有善良玩家投票，你可以让被提名者立即被处决。");
    g_tipLine[17350] = StringToText("【背景故事】");
    g_tipLine[17351] = StringToText("「你竟敢指责夫人的过错？我认识她一辈子了！整整九年！」");
    g_tipLine[17352] = StringToText("【角色能力】");
    g_tipLine[17353] = StringToText("在你的首个夜晚，你会得知一名善良玩家。");
    g_tipLine[17354] = StringToText("【角色简介】");
    g_tipLine[17355] = StringToText("事务官会得知一名善良玩家。");
    g_tipLine[17356] = StringToText("· 事务官得知的是玩家，但不得知他的具体角色。");
    g_tipLine[17357] = StringToText("· 事务官会在首个夜晚得知他的信息。");
    g_tipLine[17358] = StringToText("· 如果事务官在游戏中途被创造，事务官会在当晚得知信息。");
    g_tipLine[17359] = StringToText("【范例】");
    g_tipLine[17360] = StringToText("事务官得知小艾是善良玩家。小艾是送葬者。");
    g_tipLine[17361] = StringToText("麻脸巫婆将罂粟种植者变成了事务官。当晚，事务官得知小黑是善良玩家。小黑是间谍，但被当作善良阵营。");
    g_tipLine[17362] = StringToText("【运作方式】");
    g_tipLine[17363] = StringToText("在为首个夜晚进行准备时，将事务官的「得知」提示标记放置在任意一名善良玩家的角色标记旁。");
    g_tipLine[17364] = StringToText("在首个夜晚，唤醒事务官，并指向标记有「得知」的那名玩家。让事务官重新入睡。");
    g_tipLine[17365] = StringToText("【提示标记】");
    g_tipLine[17366] = StringToText("· 得知");
    g_tipLine[17367] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[17368] = StringToText("放置条件：放置在一名善良玩家的角色标记旁边。");
    g_tipLine[17369] = StringToText("移除时机：在事务官获取信息后，说书人可以任由自己方便来进行移除。");
    g_tipLine[17370] = StringToText("【提示与技巧】");
    g_tipLine[17371] = StringToText("· 你会得知一名既不是恶魔也不是爪牙的玩家。这是很棒的信息！你可以相信他是怀着善意为你们阵营行动，");
    g_tipLine[17372] = StringToText("  并且只有醉酒和中毒会干扰他们的信息。运用你的信息与其他人共同努力去通关游戏。");
    g_tipLine[17373] = StringToText("· 直接公开自己的信息。如果所有人都知道你和你得知的玩家都是善良的，他们可以直接将这个信息加入到他们的逻辑线构建和能力");
    g_tipLine[17374] = StringToText("  选择方案里。你的信息不会让游戏通关，但它很有用，所以让大家都知道这个信息吧。");
    g_tipLine[17375] = StringToText("· 与你得知的玩家私聊，并且为了让他能够存活而隐藏你的信息。如果让恶魔听到你的信息并且相信这是真的，");
    g_tipLine[17376] = StringToText("  那么恶魔会认为让你得知的玩家存活到三人决赛圈是危险的事情。所以恶魔会希望这名玩家最先死亡。因此，");
    g_tipLine[17377] = StringToText("  不说出你的信息也许有助于让那名玩家存活。");
    g_tipLine[17378] = StringToText("· 一旦公开你的信息，让玩家们把这条信息纳入他们的逻辑线构建中！你知道自己以及你得知的玩家都是善良的，");
    g_tipLine[17379] = StringToText("  所以如果有逻辑线认为你们之中有邪恶玩家，那么另一个人也必须是邪恶玩家。通常来说，");
    g_tipLine[17380] = StringToText("  这意味着构建一条你们都是邪恶玩家的逻辑线最终会得到邪恶玩家过多的结论，而你可以根据这个结论作出相应的辩解。");
    g_tipRoleAt[142] = 17350; g_tipRoleN[142] = 31; g_tipP1At[142] = 17352; g_tipP1N[142] = 7; g_tipP2At[142] = 0; g_tipP2N[142] = 0;
    g_tipAbility[142] = StringToText("在你的首个夜晚，你会得知一名善良玩家。");
    g_tipLine[17381] = StringToText("【背景故事】");
    g_tipLine[17382] = StringToText("「他们接连倒下。一个，又一个。两个，三个，五个。」");
    g_tipLine[17383] = StringToText("【角色能力】");
    g_tipLine[17384] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipLine[17385] = StringToText("【角色简介】");
    g_tipLine[17386] = StringToText("限会让镇民玩家集体中毒。");
    g_tipLine[17387] = StringToText("· 限会让所有镇民玩家中毒一个夜晚和一个白天。限的能力生效夜晚和初始加入游戏的外来者数量相同。比如，游戏开始时，");
    g_tipLine[17388] = StringToText("  有两名外来者，限的能力就会在第二个夜晚生效。");
    g_tipLine[17389] = StringToText("· 限可以让任意数量的外来者加入游戏，但通常是一名到四名外来者。外来者的数量可以和限不在场时的数量一致，");
    g_tipLine[17390] = StringToText("  也可以有所差距。限的能力会覆盖其他设置调整类型的能力，例如男爵等角色。");
    g_tipLine[17391] = StringToText("· 如果在游戏过程中外来者数量发生变化，大限将至的夜晚也仍然取决于初始设置的外来者数量。");
    g_tipLine[17392] = StringToText("· 限需要存活，能力才能生效。");
    g_tipLine[17393] = StringToText("【范例】");
    g_tipLine[17394] = StringToText("由于限的能力，有三名外来者在场。第三个夜晚，驱魔人选择了恶魔，但无事发生，杂技演员选择了酒鬼，但也无事发生，");
    g_tipLine[17395] = StringToText("  女裁缝得知了错误信息。");
    g_tipLine[17396] = StringToText("在一个11名玩家的游戏中，只有一名外来者在场。首个夜晚，限让7位镇民玩家都中毒了。第二个夜晚，");
    g_tipLine[17397] = StringToText("  麻脸巫婆创造了帽匠。即使现在有两名外来者在场，但所有玩家都是健康的。");
    g_tipLine[17398] = StringToText("没有外来者在场。限没有让任何玩家中毒。限声称自己是狂热者。善良阵营认为所有镇民在首个夜晚都中毒了，");
    g_tipLine[17399] = StringToText("  但实际上他们没有。");
    g_tipLine[17400] = StringToText("【运作方式】");
    g_tipLine[17401] = StringToText("在游戏设置时，加入或移除任意数量的外来者角色标记，也可以不变。确认角色标记的总数量和玩家数量匹配。");
    g_tipLine[17402] = StringToText("  移除所有不需要使用的限的提示标记。");
    g_tipLine[17403] = StringToText("在首个夜晚，把「第一晚」提示标记放置在限的角色标记旁。在第二个夜晚，把「第二晚」提示标记替换「第一晚」提示标记。");
    g_tipLine[17404] = StringToText("  在第三个夜晚，把「第三晚」提示标记替换「第二晚」提示标记。在和初始外来者数量等同的那个夜晚，把「大限将至」");
    g_tipLine[17405] = StringToText("  提示标记放置在魔典中央，并在下个黄昏移除。当「大限将至」提示标记被放置时，所有镇民玩家中毒。");
    g_tipLine[17406] = StringToText("【提示标记】");
    g_tipLine[17407] = StringToText("· 第一晚&第二晚&第三晚");
    g_tipLine[17408] = StringToText("放置时间：限在场，且游戏阶段进入到黄昏时。");
    g_tipLine[17409] = StringToText("放置条件：根据当前游戏进行的夜晚数，将对应夜晚数量的提示标记放置在限的角色标记旁。");
    g_tipLine[17410] = StringToText("移除时机：在下一次进入黄昏时移除当前放置的标记并进行替换。在限死亡或离场时移除。");
    g_tipLine[17411] = StringToText("· 大限将至");
    g_tipLine[17412] = StringToText("放置时间：限当晚行动时。");
    g_tipLine[17413] = StringToText("放置条件：当前游戏进行的夜晚数和初始的外来者数量相同时，且限未醉酒中毒，放置在魔典中央。");
    g_tipLine[17414] = StringToText("移除时机：在黄昏时。");
    g_tipLine[17415] = StringToText("【提示与技巧】");
    g_tipLine[17416] = StringToText("· 尽可能地活着！或者至少活到大限将至（等同于外来者数量）的那一天！记住，你必须得活着，能力才能生效！");
    g_tipLine[17417] = StringToText("· 让你自己死于大限将至（等同于外来者数量）那一夜之前，来隐瞒限在场的事实，这样能够让声称是外来者的玩家更可疑！");
    g_tipLine[17418] = StringToText("· 如果限不在场，声称自己是外来者，让大家怀疑限在场。邪恶阵营需要进行大规模的协商和战术安排：");
    g_tipLine[17419] = StringToText("  声称自己是镇民的邪恶玩家需要给出第二个夜晚或第三个夜晚的错误信息，从而让善良玩家相信限在场，");
    g_tipLine[17420] = StringToText("  并且声称外来者的玩家都是善良的！");
    g_tipLine[17421] = StringToText("· 如果限在场，让那些外来者看起来不是那么可信。如果三个善良玩家声称自己是外来者，声称自己是调查员，");
    g_tipLine[17422] = StringToText("  并得知了其中一个外来者玩家是投毒者。或者，声称自己是村夫，得知了其中一个或两个外来者是邪恶的。");
    g_tipLine[17423] = StringToText("  当越来越多的善良外来者被认为是邪恶的时候，大家就越难认为限是在场的。");
    g_tipLine[17424] = StringToText("· 尽快弄清楚外来者的数量！如果你知道了在场有几名外来者，你就会知道在哪一天，");
    g_tipLine[17425] = StringToText("  你和其他邪恶玩家可以引导大家的信息是正确（或不正确）的。");
    g_tipLine[17426] = StringToText("· 仔细聆听和分析善良玩家分享的信息，留意这之间不匹配的地方。如果你注意到某个夜晚的很多个信息来源是有问题的，");
    g_tipLine[17427] = StringToText("  你就知道有多少个外来者在场了。");
    g_tipLine[17428] = StringToText("· 编造一个虚假的大限将至的夜晚或白天！和你的邪恶阵营协调，让每个邪恶玩家在同一天声称自己的能力没有正常生效，");
    g_tipLine[17429] = StringToText("  或获得了错误信息。");
    g_tipLine[17430] = StringToText("· 表现得很混乱，把大家的注意力吸引到你身上。（这样恶魔就不会被注意到了！）");
    g_tipLine[17431] = StringToText("· 作为邪恶玩家，声称自己是获得了很多信息的角色，尤其是信息比较难以伪装的角色。声称自己是筑梦师，食人族，");
    g_tipLine[17432] = StringToText("  或者洗衣妇，在包含限的剧本中显得更加可信。当善良玩家们认为至少有一晚所有的镇民都会中毒时，");
    g_tipLine[17433] = StringToText("  获得错误信息就显得不那么可疑了！");
    g_tipLine[17434] = StringToText("· 警惕真的和健康的信息，或者声称当晚不会是大限将至的夜晚，因为你的能力正常生效了！相比之下，在其他玩家都清醒健康，");
    g_tipLine[17435] = StringToText("  你声称自己中毒，会比其他玩家中毒时声称自己清醒健康要容易得多！");
    g_tipLine[17436] = StringToText("【对抗限】");
    g_tipLine[17437] = StringToText("· 弄清楚限是否在场！通常，弄明白哪些爪牙在和你对抗很重要，限也不例外。");
    g_tipLine[17438] = StringToText("· 搜寻能够证明场上善良外来者的信息，这能帮助大家弄清楚有多少人在说真话。");
    g_tipLine[17439] = StringToText("· 当其他玩家分享信息时，多加注意，分析这些信息是否错误。如果很多玩家真诚地表现出在同一天都可能由于中毒获得了错误信");
    g_tipLine[17440] = StringToText("  息，那可能就是大限将至的夜晚。");
    g_tipLine[17441] = StringToText("· 真诚地分享你的信息，并把你的信息和其他玩家的信息做对比。如果你作为占卜师获得了「是」的信息，");
    g_tipLine[17442] = StringToText("  但守夜人声称自己选择的人没有被唤醒，而且教授声称他选择的贵族也没有被复活，");
    g_tipLine[17443] = StringToText("  那你就要一定程度上对自己的信息保持怀疑态度。");
    g_tipLine[17444] = StringToText("· 说出假的信息！让邪恶阵营分不清哪天大限将至！如果你是图书管理员得知了瘟疫医生，声称在另外两名玩家里得知了莽夫！");
    g_tipLine[17445] = StringToText("  如果邪恶阵营认为的外来者数量与实际的初始数量不同，那么当他们声称自己是镇民并获得错误信息时，");
    g_tipLine[17446] = StringToText("  就能有镇民来证明他们是清醒健康的！");
    g_tipLine[17447] = StringToText("· 弄清楚大限将至的夜晚，然后放弃那个夜晚和白天的所有信息！如果你认为有三个外来者在场，");
    g_tipLine[17448] = StringToText("  然后共情者声称自己在第三个夜晚获得了一个新的数字，忽略这条信息！");
    g_tipLine[17449] = StringToText("· 当一个玩家获得清醒健康的信息，或者（并且）他可以证明自己的能力正常生效了，");
    g_tipLine[17450] = StringToText("  把所有这个夜晚和白天的信息都拿出来比较，并且慎重考虑本局外来者的数量。");
    g_tipLine[17451] = StringToText("  如果筑梦师和洗衣妇在首个夜晚获得的信息看起来都是正确的，管家也得知了正确的守夜人，");
    g_tipLine[17452] = StringToText("  那么限不会只让一个外来者加入游戏。");
    g_tipLine[17453] = StringToText("· 不要过多考虑外来者的数量。如果限真的在场，外来者的数量可以任意发生变化，而并不是简单的数字相加！");
    g_tipLine[17454] = StringToText("· 如果你在首个夜晚获得了信息，可以等一天或两天，来看看你的信息是否能对得上。作为图书管理员，");
    g_tipLine[17455] = StringToText("  如果你知道两名玩家之中有莽夫，完全有可能是说书人在大限之日告诉了你一名邪恶玩家，而莽夫不曾在场！");
    g_tipRoleAt[147] = 17381; g_tipRoleN[147] = 75; g_tipP1At[147] = 17383; g_tipP1N[147] = 10; g_tipP2At[147] = 0; g_tipP2N[147] = 0;
    g_tipAbility[147] = StringToText("在等同于初始外来者数量的夜晚，所有镇民玩家中毒直到下个黄昏。[外来者数量任意]");
    g_tipLine[17456] = StringToText("【背景故事】");
    g_tipLine[17457] = StringToText("「＜咽口水＞");
    g_tipLine[17458] = StringToText("＜咧嘴笑＞");
    g_tipLine[17459] = StringToText("＜/咽口水＞」");
    g_tipLine[17460] = StringToText("【角色能力】");
    g_tipLine[17461] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：你转变为他的阵营，即使你已醉酒或中毒，但你不知道你转变后的阵营。");
    g_tipLine[17462] = StringToText("【角色简介】");
    g_tipLine[17463] = StringToText("食人魔是某人最好的朋友！");
    g_tipLine[17464] = StringToText("· 食人魔选定了玩家之后，他的目标就不会发生变化，即使他在选择时醉酒或中毒也是如此。");
    g_tipLine[17465] = StringToText("· 食人魔会在他的首个夜晚选择玩家后立即转变为那名玩家的阵营，即使他在选择时醉酒或中毒也是如此。");
    g_tipLine[17466] = StringToText("· 说书人不会告知食人魔转变后的阵营。");
    g_tipLine[17467] = StringToText("· 如果随后食人魔的阵营因为其他方式发生变化，食人魔会如常得知他转变后的阵营。");
    g_tipLine[17468] = StringToText("· 如果食人魔在游戏中途被创造，他需要在当晚选择一名玩家，并转变为那名玩家的阵营。");
    g_tipLine[17469] = StringToText("【范例】");
    g_tipLine[17470] = StringToText("在首个夜晚，食人魔选择了召唤师。食人魔转变为邪恶阵营，并在游戏的余下时间里一直都是邪恶阵营。");
    g_tipLine[17471] = StringToText("在首个夜晚，食人魔选择了报丧女妖。食人魔保持善良阵营不变。在第三个夜晚，灵言师将报丧女妖转变为邪恶阵营。");
    g_tipLine[17472] = StringToText("  食人魔仍然是善良阵营。");
    g_tipLine[17473] = StringToText("【运作方式】");
    g_tipLine[17474] = StringToText("在首个夜晚，唤醒食人魔。让食人魔指向一名玩家。让食人魔重新入睡。如果食人魔指向了一名邪恶玩家，");
    g_tipLine[17475] = StringToText("  将食人魔的角色标记倒转放置，代表食人魔现在属于邪恶阵营。");
    g_tipLine[17476] = StringToText("可选规则：使用「挚友」提示标记来标记被食人魔选择的玩家。食人魔始终与他所选择的玩家同一阵营。");
    g_tipLine[17477] = StringToText("  如果食人魔的挚友转变了阵营，食人魔也一同转变阵营，但食人魔不会得知自己的阵营发生变化。");
    g_tipLine[17478] = StringToText("  该可选规则仅在15人及以上的游戏中建议使用，以使得游戏中不会出现过多的邪恶玩家。");
    g_tipLine[17479] = StringToText("【提示标记】");
    g_tipLine[17480] = StringToText("· 挚友（仅15人及以上游戏中使用可选规则时放置）");
    g_tipLine[17481] = StringToText("放置时机：在食人魔进行夜晚行动并选择了一名玩家后。");
    g_tipLine[17482] = StringToText("放置条件：放置在被食人魔选择的玩家旁。");
    g_tipLine[17483] = StringToText("移除时机：食人魔离场时。");
    g_tipLine[17484] = StringToText("【规则细节】");
    g_tipLine[17485] = StringToText("· 相克规则：");
    g_tipLine[17486] = StringToText("  · 陌客：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_tipLine[17487] = StringToText("  · 间谍：间谍必定被食人魔当作邪恶阵营。");
    g_tipLine[17488] = StringToText("  · 麻脸巫婆：被麻脸巫婆创造的邪恶食人魔无法因为自身能力转变为善良阵营。");
    g_tipLine[17489] = StringToText("  · 科学怪人：恶魔无法拥有食人魔的能力。");
    g_tipLine[17490] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17491] = StringToText("  · 蛊雕：如果「蛊毒」玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。");
    g_tipLine[17492] = StringToText("【提示与技巧】");
    g_tipLine[17493] = StringToText("· 与其他玩家相比，食人魔处在一个有趣的位置。因为你不知道你的阵营，但你清楚自己要为谁而战。");
    g_tipLine[17494] = StringToText("  在游戏初期就告诉你的朋友，你选择了他，这对你有利。并且向他表示忠诚，让他能够相信你。");
    g_tipLine[17495] = StringToText("  如果你想让玩家们相信你与你的朋友利益一致，你可以公开进行这种对话；如果你想与你的朋友密谋并制定游戏计划，");
    g_tipLine[17496] = StringToText("  你可以私下进行这种对话。");
    g_tipLine[17497] = StringToText("· 如果你的朋友不相信你，你要保持耐心。向他保证你说的都是实话，并利用好那些可以探查阵营信息的角色，比如厨师，");
    g_tipLine[17498] = StringToText("  让你的观点更具有说服力。");
    g_tipLine[17499] = StringToText("· 对你的朋友说真话，但对其他人撒谎，这可能会让游戏变得有趣，并且对你有利。如果你是善良的，");
    g_tipLine[17500] = StringToText("  而邪恶阵营不知道你的朋友是谁，他们可能会更容易忽视你的朋友。如果你是邪恶的，而善良阵营不知道你的朋友是谁，");
    g_tipLine[17501] = StringToText("  他们可能会更难解释当前的游戏局势。");
    g_tipLine[17502] = StringToText("· 不去告诉你的朋友你选择了他，而是先观察几天，这会对你有利。你可以通过观察他与谁交谈，他对谁投票，");
    g_tipLine[17503] = StringToText("  以及他看起来信任谁，来判断他和你的阵营是哪一方。");
    g_tipLine[17504] = StringToText("· 与你的朋友做相同的投票！如果你的朋友是邪恶的，他会以有利于你们阵营的方式投票；如果你的朋友是善良的，");
    g_tipLine[17505] = StringToText("  他很可能会以他认为对自己阵营有利的方式投票。");
    g_tipLine[17506] = StringToText("· 不要对你的朋友投票。你不知道他到底是善良的还是邪恶的。但不管他是什么阵营，如果他死于处决，你都是杀害队友。");
    g_tipLine[17507] = StringToText("· 告诉多名玩家你选择了他，看看他们会有什么反应，并且你能以此隐藏自己真正的朋友。");
    g_tipLine[17508] = StringToText("  既然你不知道自己正在为哪个阵营而战，那么混乱一点也无妨……对吧？");
    g_tipLine[17509] = StringToText("· 如果你的朋友的行为开始变得奇怪，而且剧本里有改变阵营的角色能力，你要假设最坏的情况——你的朋友可能已经加入敌对阵营");
    g_tipLine[17510] = StringToText("  ！如果你担心你的朋友不再与同阵营的队友分享信息，你可能希望限制你们对他的分享内容，");
    g_tipLine[17511] = StringToText("  并且你会希望通过诸如共情者或艺术家这样的其他信息来源，帮助你去确认你的阵营，或者你朋友当前的阵营。");
    g_tipLine[17512] = StringToText("· 如果你用尽所有手段都无法确认自己的阵营，那么就假设你是善良的，从概率上来说这对你有利。");
    g_tipLine[17513] = StringToText("· 如果有玩家声称自己是食人魔，而他们声称选择的朋友几乎总是善良的。要么因为他是真的选中了善良玩家的食人魔，");
    g_tipLine[17514] = StringToText("  要么就是邪恶玩家正在伪装食人魔。邪恶玩家在伪装食人魔的时候可能更愿意选择一名善良玩家作为假想朋友。");
    g_tipLine[17515] = StringToText("· 让你的朋友向你透露他得知的所有事情——因为你无法获得信息，所以你必须依靠其他角色与你分享游戏中的关键信息。");
    g_tipLine[17516] = StringToText("  在游戏中，只有来自朋友的信息是你最能够信任的，因此好好对待你的朋友并请求他说出自己所知的一切。让他意识到，");
    g_tipLine[17517] = StringToText("  他告诉给你的越多，你越能确信他是善良的，然后你能够更好地帮助善良阵营。如果你的朋友是邪恶的，并向你透露一切，");
    g_tipLine[17518] = StringToText("  那就更好了。");
    g_tipLine[17519] = StringToText("· 如果你是善良玩家，同时有其他玩家声称自己是食人魔并过来找你，通常来说最好告诉他你知道的一切。他要么是善良玩家，");
    g_tipLine[17520] = StringToText("  那么他值得知道这一切；要么是邪恶玩家，那么他早已得知关于各个玩家身份的最关键内容。");
    g_tipLine[17521] = StringToText("  如果你想测试他是否是真的食人魔，你可以撒谎，或者不告诉他任何事情。");
    g_tipRoleAt[148] = 17456; g_tipRoleN[148] = 66; g_tipP1At[148] = 17460; g_tipP1N[148] = 9; g_tipP2At[148] = 17484; g_tipP2N[148] = 8;
    g_tipAbility[148] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：你转变为他的阵营，即使你已醉酒或中毒，但你不知道你转变后的阵营。");
    g_tipLine[17522] = StringToText("【背景故事】");
    g_tipLine[17523] = StringToText("「我在这里，因为你在这里；");
    g_tipLine[17524] = StringToText("我在这里，所以你在这里。」");
    g_tipLine[17525] = StringToText("【角色能力】");
    g_tipLine[17526] = StringToText("每个白天，你可以公开进行一次谁是爪牙，谁是恶魔的猜测。如果你猜对，善良阵营获胜。");
    g_tipLine[17527] = StringToText("【角色简介】");
    g_tipLine[17528] = StringToText("戏法师想要尝试猜出所有的邪恶阵营玩家。");
    g_tipLine[17529] = StringToText("· 戏法师的猜测需要在白天且公开进行。他不需要每个白天都进行猜测。");
    g_tipLine[17530] = StringToText("· 其他玩家也可以假装自己是戏法师来进行猜测。如同杂耍艺人或造谣者，说书人也需要配合假装那名玩家是戏法师。");
    g_tipLine[17531] = StringToText("· 如果戏法师猜对了谁是爪牙，谁是恶魔，游戏会立刻结束。这需要戏法师一次性猜中所有恶魔和爪牙。");
    g_tipLine[17532] = StringToText("· 戏法师不需要猜测恶魔和爪牙的具体角色是什么。");
    g_tipLine[17533] = StringToText("· 如果有多于一名恶魔在场，戏法师也需要猜中全部的恶魔。");
    g_tipLine[17534] = StringToText("· 如果一名玩家既是恶魔也是爪牙，例如军团，戏法师需要猜测这名玩家是恶魔才算猜对。");
    g_tipLine[17535] = StringToText("· 一旦戏法师猜测完毕，他在当天就不能更改自己的猜测结果或是再次进行猜测。");
    g_tipLine[17536] = StringToText("· 戏法师也需要猜出所有属于善良阵营的恶魔和爪牙，但他不需要猜中邪恶的旅行者。");
    g_tipLine[17537] = StringToText("· 如果在游戏中玩家的阵营发生了变化，戏法师需要猜测的是当前的邪恶角色所属玩家，而非游戏开始时的邪恶角色所属玩家。");
    g_tipLine[17538] = StringToText("【范例】");
    g_tipLine[17539] = StringToText("戏法师猜测了四名善良玩家。无事发生。");
    g_tipLine[17540] = StringToText("戏法师猜测道哥是恶魔，小八和小美是爪牙。实际上道哥确实是恶魔，小八和小美也确实是爪牙。善良阵营立刻获胜。");
    g_tipLine[17541] = StringToText("醉酒的戏法师猜测道哥是恶魔，小八和小美是爪牙。实际上道哥确实是恶魔，小八和小美也确实是爪牙。无事发生，游戏继续。");
    g_tipLine[17542] = StringToText("  在下一个白天，恢复清醒的戏法师猜测小八是恶魔，道哥和小美是爪牙。无事发生，游戏继续。");
    g_tipLine[17543] = StringToText("【运作方式】");
    g_tipLine[17544] = StringToText("每个白天限一次，如果戏法师宣称自己想要使用能力，那么让他猜测谁是恶魔，谁是爪牙。如果猜测错误，无事发生，");
    g_tipLine[17545] = StringToText("  游戏继续。如果猜测正确，宣布善良阵营获胜。");
    g_tipLine[17546] = StringToText("可选规则：与杂耍艺人和造谣者相似，说书人可以限制玩家宣称自己是戏法师的猜测次数，例如每天最多三次。");
    g_tipLine[17547] = StringToText("  在多数玩家都想要声称自己是某个公开触发能力的角色时，建议使用该可选规则，避免游戏节奏受到影响而变慢，");
    g_tipLine[17548] = StringToText("  游戏的乐趣也随之减少。");
    g_tipLine[17549] = StringToText("【提示标记】");
    g_tipLine[17550] = StringToText("无");
    g_tipLine[17551] = StringToText("【规则细节】");
    g_tipLine[17552] = StringToText("· 相克规则：");
    g_tipLine[17553] = StringToText("  · 维齐尔：说书人不会宣布维齐尔在场。");
    g_tipLine[17554] = StringToText("【提示与技巧】");
    g_tipLine[17555] = StringToText("· 每天都猜测一次！每次猜测都会为你排除错误答案，缩小恶魔和爪牙的范围。");
    g_tipLine[17556] = StringToText("· 等上几天后再猜测，隐藏你是戏法师的事实。邪恶阵营在知道你的真实角色后，可能会想要让你中毒或杀死你，");
    g_tipLine[17557] = StringToText("  因此隐藏你的角色能帮助你保持正常状态并多活上几天。");
    g_tipLine[17558] = StringToText("· 对那些让你感到担忧的，相互绑定的玩家进行有意图的猜测。例如，如果有人声称自己是图书管理员并且证实了有圣徒，");
    g_tipLine[17559] = StringToText("  你可以猜测这些玩家，来证明他们不是邪恶阵营。");
    g_tipLine[17560] = StringToText("· 如果戏法师在剧本中，那么你可以假装自己是戏法师并做出猜测，来隐藏真正的戏法师。与杂耍艺人和造谣者相似，");
    g_tipLine[17561] = StringToText("  如果多名玩家都公开声称自己是戏法师，邪恶阵营会更难找到真正的戏法师。但要当心：如果太多玩家声称自己是戏法师，");
    g_tipLine[17562] = StringToText("  可能会把真正有用的信息也藏起来！");
    g_tipLine[17563] = StringToText("· 如果你在夜晚死亡，留意那些在你死之前做出的猜测。你可能因为太过接近真相，而让邪恶阵营感到惧怕！");
    g_tipLine[17564] = StringToText("· 鼓励善良玩家站出来分享信息，这样他们就能代替你变成恶魔的攻击对象。对你来说，活的越久越好，");
    g_tipLine[17565] = StringToText("  因为戏法师的每一次猜测都会更接近真相。");
    g_tipLine[17566] = StringToText("· 作为戏法师，留意那些其他声称自己是戏法师的人的猜测。其他的善良玩家通常会带有一些信息，");
    g_tipLine[17567] = StringToText("  或是利用朋友之间的熟悉程度来做出自己的猜测，而且他们的猜测可能就是对的！");
    g_tipLine[17568] = StringToText("· 找出那些探测邪恶玩家的角色，例如调查员、共情者、占卜师或是赏金猎人，并利用他们的信息，提升你猜测成功的可能性。");
    g_tipLine[17569] = StringToText("· 找出一名你确定为邪恶的玩家，然后围绕他做出不同组合的猜测。");
    g_tipLine[17570] = StringToText("· 请记得将已死亡的玩家也纳入到你的猜测中！如果你认为小恶魔在夜晚自杀，或是方古传给了一名外来者，");
    g_tipLine[17571] = StringToText("  你就需要同时将已死亡的和仍存活的恶魔都猜测为恶魔。同时你也需要猜中已死亡的爪牙。");
    g_tipLine[17572] = StringToText("· 如果你觉得你自己中毒了，那么在下一天再进行同样的猜测。");
    g_tipLine[17573] = StringToText("· 优先找到邪恶阵营。一旦你或多或少确定了邪恶阵营的范围，你就可以围绕一名玩家做出不同的猜测来取胜，");
    g_tipLine[17574] = StringToText("  或是避免在不知情的情况下处决了爪牙。");
    g_tipLine[17575] = StringToText("· 请注意邪恶阵营数量会随着玩家人数而发生变化。如果你通常玩的是12人局，");
    g_tipLine[17576] = StringToText("  你可能会忘记在13人以上的对局中多猜测一名爪牙。");
    g_tipLine[17577] = StringToText("· 认真熟悉剧本列表的红色区域。留意那些对邪恶角色做出调整，从而导致与常规恶魔爪牙数量不同的可能性。");
    g_tipLine[17578] = StringToText("  如果剧本中存在小怪宝、军团、暴乱或其他类似的角色，你就需要做出非常规数量的猜测。");
    g_tipLine[17579] = StringToText("· 留意那些能在游戏中途变为恶魔的角色。如果剧本中存在小恶魔、方古、红唇女郎等，");
    g_tipLine[17580] = StringToText("  你可能需要在有别于之前的新信息出现后改变你的猜测方向。");
    g_tipRoleAt[149] = 17522; g_tipRoleN[149] = 59; g_tipP1At[149] = 17525; g_tipP1N[149] = 13; g_tipP2At[149] = 17551; g_tipP2N[149] = 3;
    g_tipAbility[149] = StringToText("每个白天，你可以公开进行一次谁是爪牙，谁是恶魔的猜测。如果你猜对，善良阵营获胜。");
    g_tipLine[17581] = StringToText("【背景故事】");
    g_tipLine[17582] = StringToText("「颂赞北之守护，以吾之智慧，斩却汝命；");
    g_tipLine[17583] = StringToText("颂赞东之守护，以吾之意志，制御汝身；");
    g_tipLine[17584] = StringToText("颂赞南之守护，以超越之力，揭示前路；");
    g_tipLine[17585] = StringToText("颂赞西之守护，于漫漫长夜，化为坚盾。」");
    g_tipLine[17586] = StringToText("【角色能力】");
    g_tipLine[17587] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");
    g_tipLine[17588] = StringToText("【角色简介】");
    g_tipLine[17589] = StringToText("召唤师能够创造恶魔。");
    g_tipLine[17590] = StringToText("· 召唤师能够选择任意一名玩家变成恶魔，他甚至可以选择自己。");
    g_tipLine[17591] = StringToText("· 被创造的新恶魔不会得知谁是爪牙，爪牙也不会得知他是恶魔。邪恶玩家之间需要通过交流来互认。");
    g_tipLine[17592] = StringToText("· 即使在游戏的前两天没有恶魔在场，游戏也不会因此结束。然而，如果召唤师因为某些原因无法创造新的恶魔（死亡或在第三个");
    g_tipLine[17593] = StringToText("  夜晚中毒等），善良阵营获胜。");
    g_tipLine[17594] = StringToText("· 新恶魔在被创造的当晚就能行动。");
    g_tipLine[17595] = StringToText("【范例】");
    g_tipLine[17596] = StringToText("在第三个夜晚，召唤师选择了告密者玩家和痢蛭角色。告密者变成了痢蛭，且需要选择一名玩家让他中毒，并攻击一名玩家。");
    g_tipLine[17597] = StringToText("在游戏的首个白天，召唤师被处决了。善良阵营获胜。");
    g_tipLine[17598] = StringToText("在第三个夜晚，召唤师将炼金术士变成了利维坦。在黎明时，所有玩家都得知了利维坦在场，且现在是第三个白天。");
    g_tipLine[17599] = StringToText("【运作方式】");
    g_tipLine[17600] = StringToText("在设置阶段，将恶魔角色标记移除，并加入一个镇民角色标记。");
    g_tipLine[17601] = StringToText("在为首个夜晚做准备时，将召唤师的「第一晚」提示标记放置在召唤师角色标记旁。在为第二个夜晚做准备时，");
    g_tipLine[17602] = StringToText("  将召唤师的「第二晚」提示标记放置在召唤师角色标记旁。在为第三个夜晚做准备时，将召唤师的「第三晚」");
    g_tipLine[17603] = StringToText("  提示标记放置在召唤师角色标记旁。");
    g_tipLine[17604] = StringToText("在首个夜晚，对召唤师展示三个不在场的善良角色，作为他的伪装。");
    g_tipLine[17605] = StringToText("在夜晚时，如果召唤师旁放置了「第三晚」提示标记，唤醒召唤师。让他指向一名玩家，和角色列表上的一个恶魔图标。");
    g_tipLine[17606] = StringToText("  让召唤师重新入睡。唤醒被召唤师选择的玩家。对他展示「你是」信息标记，和恶魔角色标记。再对他展示「你是」信息标记，");
    g_tipLine[17607] = StringToText("  和朝下的大拇指。用那个恶魔角色标记替换他的角色标记，并让新恶魔重新入睡。");
    g_tipLine[17608] = StringToText("【提示标记】");
    g_tipLine[17609] = StringToText("· 第一晚&第二晚&第三晚");
    g_tipLine[17610] = StringToText("放置时机：在为对应的夜晚做准备时。");
    g_tipLine[17611] = StringToText("放置条件：放置在召唤师的角色标记旁。");
    g_tipLine[17612] = StringToText("移除时机：在为下一个夜晚做准备时，或召唤师死亡或离场时。");
    g_tipLine[17613] = StringToText("【规则细节】");
    g_tipLine[17614] = StringToText("· 特定角色互动：");
    g_tipLine[17615] = StringToText("  · 理发师：如果理发师死亡但无恶魔在场，无事发生。");
    g_tipLine[17616] = StringToText("  · 莽夫：如果召唤师在创造恶魔时选择了莽夫，莽夫转为邪恶，且会与邪恶阵营一同落败，因为场上没有恶魔且召唤师醉酒了。");
    g_tipLine[17617] = StringToText("· 相克规则：");
    g_tipLine[17618] = StringToText("  · 炼金术士：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_tipLine[17619] = StringToText("    由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[17620] = StringToText("  · 钟表匠：召唤师会被钟表匠当作恶魔。");
    g_tipLine[17621] = StringToText("  · 罂粟种植者：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，由说书人来决定哪名玩家发生转变。");
    g_tipLine[17622] = StringToText("  · 侍臣：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[17623] = StringToText("  · 传教士：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[17624] = StringToText("  · 工程师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_tipLine[17625] = StringToText("  · 帽匠/麻脸巫婆/卡扎力：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[17626] = StringToText("  · 提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[17627] = StringToText("  · 僵怖：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_tipLine[17628] = StringToText("  · 普卡：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_tipLine[17629] = StringToText("  · 军团：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_tipLine[17630] = StringToText("  · 堤丰之首：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[17631] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17632] = StringToText("  · 戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[17633] = StringToText("  · 戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[17634] = StringToText("  · 姑获鸟：如果召唤师成功召唤了姑获鸟，召唤师会变成一个不在场的爪牙。");
    g_tipLine[17635] = StringToText("  · 典狱长：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipRoleAt[150] = 17581; g_tipRoleN[150] = 55; g_tipP1At[150] = 17586; g_tipP1N[150] = 9; g_tipP2At[150] = 17613; g_tipP2N[150] = 23;
    g_tipAbility[150] = StringToText("在首个夜晚，你会得知三个伪装。在第三个夜晚，你要选择一名玩家：他变成由你选择的邪恶恶魔。[无恶魔在场]");
    g_tipLine[17636] = StringToText("【背景故事】");
    g_tipLine[17637] = StringToText("「这个是我的！……那个也是我的！」");
    g_tipLine[17638] = StringToText("【角色能力】");
    g_tipLine[17639] = StringToText("每个夜晚，你要选择一个镇民角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[17640] = StringToText("【角色简介】");
    g_tipLine[17641] = StringToText("熊孩子顽皮捣蛋，会让特定的镇民角色产生错误信息。");
    g_tipLine[17642] = StringToText("· 每个夜晚，熊孩子需要选择一个镇民角色。如果这个角色在场，对应玩家会被熊孩子影响，在下个黄昏之前均会产生错误信息。");
    g_tipLine[17643] = StringToText("· 受到熊孩子能力影响的玩家如果醉酒中毒，仍然不会让其他玩家获得信息，因为他已经失去能力。");
    g_tipLine[17644] = StringToText("  然而他在获得因自己的能力而得知的信息时，也会受到熊孩子的能力影响而必定获得错误信息。");
    g_tipLine[17645] = StringToText("· 熊孩子不会影响这名玩家通过其他方式获得的信息，例如说书人的规则解释，他自身的角色/阵营，");
    g_tipLine[17646] = StringToText("  或是由其他玩家的能力使他得知的信息。");
    g_tipLine[17647] = StringToText("· 熊孩子影响的是具体角色所对应的玩家。仅仅是拥有这个角色能力，但实际角色并非熊孩子选择的角色的玩家，");
    g_tipLine[17648] = StringToText("  不会受到熊孩子能力的影响。");
    g_tipLine[17649] = StringToText("· 如果熊孩子选择的角色当前不在场，但随后在场了，这个角色所对应的玩家仍然要受到熊孩子的能力影响。");
    g_tipLine[17650] = StringToText("【范例】");
    g_tipLine[17651] = StringToText("熊孩子选择了正与两名邪恶玩家邻近的共情者。当晚，共情者得知了「0」。");
    g_tipLine[17652] = StringToText("熊孩子选择了卖花女孩。当晚，哲学家选择获得卖花女孩的能力，并获得了正确信息。而原本在场的卖花女孩因为哲学家醉酒，");
    g_tipLine[17653] = StringToText("  且受到熊孩子的影响，获得了错误信息。");
    g_tipLine[17654] = StringToText("【运作方式】");
    g_tipLine[17655] = StringToText("每个夜晚，唤醒熊孩子，让他指向角色列表上的一个镇民角色图标。让熊孩子重新入睡。");
    g_tipLine[17656] = StringToText("如果他指向的角色在场，在对应的角色标记旁放置「捣蛋」提示标记。");
    g_tipLine[17657] = StringToText("如果放置了「捣蛋」提示标记的玩家，其自身角色能力将要产生信息时，改为产生错误信息。");
    g_tipLine[17658] = StringToText("在下个黄昏时，移除「捣蛋」提示标记。");
    g_tipLine[17659] = StringToText("【提示标记】");
    g_tipLine[17660] = StringToText("· 捣蛋");
    g_tipLine[17661] = StringToText("放置时机：在熊孩子行动，并选择了一个镇民角色后。（或熊孩子选择的镇民角色在场后。）");
    g_tipLine[17662] = StringToText("放置条件：如果熊孩子清醒健康，则放置在熊孩子选择的角色标记旁。");
    g_tipLine[17663] = StringToText("移除时机：下个黄昏时，或熊孩子死亡或离场时。");
    g_tipRoleAt[151] = 17636; g_tipRoleN[151] = 28; g_tipP1At[151] = 17638; g_tipP1N[151] = 12; g_tipP2At[151] = 0; g_tipP2N[151] = 0;
    g_tipAbility[151] = StringToText("每个夜晚，你要选择一个镇民角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[17664] = StringToText("【背景故事】");
    g_tipLine[17665] = StringToText("「杀我可以，不过我得死个明白——我到底死在谁的手里？」");
    g_tipLine[17666] = StringToText("【角色能力】");
    g_tipLine[17667] = StringToText("恶魔知道书生在场。每局游戏限一次，恶魔可以拜访说书人并猜测你是书生。如果恶魔猜测正确，即使你已死亡，");
    g_tipLine[17668] = StringToText("  当晚该恶魔可以选择一名玩家：他死亡。");
    g_tipLine[17669] = StringToText("【角色简介】");
    g_tipLine[17670] = StringToText("书生需要避免被恶魔发现。");
    g_tipLine[17671] = StringToText("· 恶魔会在自己的首个夜晚得知书生在场。");
    g_tipLine[17672] = StringToText("· 如果书生在游戏中途被创造，或有任何玩家获得了书生的能力，尚未得知「书生在场」的恶魔会在当晚得知书生在场。");
    g_tipLine[17673] = StringToText("· 只要恶魔得知过书生在场，便能在白天拜访说书人并进行猜测。在这种情况即使书生已经死亡，恶魔也能进行猜测，");
    g_tipLine[17674] = StringToText("  并在猜测正确时触发书生的能力效果。");
    g_tipLine[17675] = StringToText("· 如果一名已死亡的玩家变成了书生，恶魔不会因此得知书生在场，也无法进行猜测或触发书生的能力效果。");
    g_tipLine[17676] = StringToText("· 如果恶魔猜测正确，做出正确猜测的恶魔便能在当晚自己的行动结束后，额外导致一名玩家死亡。");
    g_tipLine[17677] = StringToText("  这一选择的时机最晚不能超过夜晚的「信息类角色行动开始」时机，详情参考夜晚行动顺序一览。");
    g_tipLine[17678] = StringToText("· 如果恶魔猜测正确，即使该恶魔随后被变成了非恶魔角色，依然能够使用书生的能力造成死亡。");
    g_tipLine[17679] = StringToText("· 书生的能力导致的死亡，不算作恶魔的攻击。那名玩家是由书生的能力导致的死亡，因此如果以这种方式杀死了一名爪牙，");
    g_tipLine[17680] = StringToText("  亡骨魔无法使得那名爪牙保留能力。如果执行书生能力的玩家是恶魔，那么仍然算作恶魔的负面能力。");
    g_tipLine[17681] = StringToText("· 如果场上有多名恶魔玩家，这些玩家共享一次猜测机会。任何恶魔使用了这次机会后，");
    g_tipLine[17682] = StringToText("  其他恶魔玩家的猜测都不会触发任何效果。他们不会知道自己的猜测是否正确，");
    g_tipLine[17683] = StringToText("  也不会知道是否有其他恶魔玩家在他之前进行了猜测并耗用了猜测的机会。");
    g_tipLine[17684] = StringToText("· 如果场上有多名书生或具有书生能力的角色，恶魔也只会有一次猜测机会。");
    g_tipLine[17685] = StringToText("【范例】");
    g_tipLine[17686] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，恶魔利用书生的能力杀死了贤者。贤者不会被唤醒并得知两名玩家，");
    g_tipLine[17687] = StringToText("  因为他并未死于恶魔之手。");
    g_tipLine[17688] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，旅店老板使得小明醉酒。当晚恶魔无法使用书生的能力进行攻击，");
    g_tipLine[17689] = StringToText("  且会误以为自己的猜测错误。");
    g_tipLine[17690] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，哲学家选择获得了书生的能力，小明因此醉酒且哲学家获得的书生能力并未被触发，");
    g_tipLine[17691] = StringToText("  所以恶魔不能使用书生的能力进行攻击。");
    g_tipLine[17692] = StringToText("【运作方式】");
    g_tipLine[17693] = StringToText("在首个夜晚，唤醒恶魔。对他展示书生角色标记。让恶魔重新入睡。");
    g_tipLine[17694] = StringToText("在白天时，恶魔可以私下拜访说书人并猜测谁是书生。如果此时还未有任何恶魔玩家猜测过且猜测正确，使用「已猜测」");
    g_tipLine[17695] = StringToText("  标记该恶魔玩家的角色标记。如果猜测错误，将「已猜测」放置于魔典正中央。");
    g_tipLine[17696] = StringToText("如果魔典中已放置「已猜测」标记，则无事发生。");
    g_tipLine[17697] = StringToText("在夜晚时，如果有任何玩家的角色标记旁有「已猜测」标记，则在该玩家自身的夜晚行动结束时（如果该玩家的行动会晚于信息");
    g_tipLine[17698] = StringToText("  类角色行动，则需要提前唤醒该玩家），对其展示书生角色标记，并让他选择一名玩家。标记那名玩家「死亡」，");
    g_tipLine[17699] = StringToText("  并将「已猜测」标记移动至魔典正中央。");
    g_tipLine[17700] = StringToText("在黎明时，如常宣布当晚的死亡情况。");
    g_tipLine[17701] = StringToText("【提示标记】");
    g_tipLine[17702] = StringToText("· 已猜测");
    g_tipLine[17703] = StringToText("放置时机：在一名恶魔玩家私下拜访说书人并进行猜测后。");
    g_tipLine[17704] = StringToText("放置条件：如果「已猜测」未放置在魔典中，则放置此标记。如果猜测正确，将其放在猜测正确的恶魔玩家角色标记旁。否则，");
    g_tipLine[17705] = StringToText("  将其放在魔典正中央。");
    g_tipLine[17706] = StringToText("移动时机：在被标记了「已猜测」的玩家夜晚使用书生的能力进行行动后，将其移动至魔典正中央。或当晚书生醉酒中毒，");
    g_tipLine[17707] = StringToText("  则直接移动到魔典正中央。");
    g_tipLine[17708] = StringToText("移除时机：游戏结束时，或书生离场时。");
    g_tipLine[17709] = StringToText("· 死亡");
    g_tipLine[17710] = StringToText("放置时机：在被标记了「已猜测」的玩家夜晚使用书生的能力进行行动并选择了玩家后放置。");
    g_tipLine[17711] = StringToText("放置条件：被选择的玩家当前存活且能被杀死，且书生未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[17712] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[17713] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[17714] = StringToText("【规则细节】");
    g_tipLine[17715] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17716] = StringToText("  · 戏子（改）：书生不会因为戏子（改）的能力醉酒。");
    g_tipRoleAt[152] = 17664; g_tipRoleN[152] = 53; g_tipP1At[152] = 17666; g_tipP1N[152] = 19; g_tipP2At[152] = 17714; g_tipP2N[152] = 3;
    g_tipAbility[152] = StringToText("恶魔知道书生在场。每局游戏限一次，恶魔可以拜访说书人并猜测你是书生。如果恶魔猜测正确，即使你已死亡，当晚该恶魔可以选择一名玩家：他死亡。");
    g_tipLine[17717] = StringToText("【背景故事】");
    g_tipLine[17718] = StringToText("「王上，妾身有两个妹妹，一个名为喜媚，一个名为琵琶。」");
    g_tipLine[17719] = StringToText("【角色能力】");
    g_tipLine[17720] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道狐媚娘在场。如果你死于处决，当晚他转变为邪恶阵营。");
    g_tipLine[17721] = StringToText("【角色简介】");
    g_tipLine[17722] = StringToText("狐媚娘会魅惑她中意的玩家使其加入邪恶阵营……以自身死亡为代价。");
    g_tipLine[17723] = StringToText("· 在首个夜晚，狐媚娘需要选择一名玩家，该玩家会知道狐媚娘在场。");
    g_tipLine[17724] = StringToText("· 即使狐媚娘在选择玩家的时候醉酒中毒，一旦狐媚娘恢复清醒健康，她选择的玩家也会立即知道狐媚娘在场。");
    g_tipLine[17725] = StringToText("  （这个行为会发生在夜晚阶段，并且需要尽可能快地结算。）");
    g_tipLine[17726] = StringToText("· 如果狐媚娘死于处决（不论是因为常规的处决或是角色能力造成的处决），当晚，被狐媚娘选择的玩家会转变为邪恶阵营。");
    g_tipLine[17727] = StringToText("· 如果狐媚娘选择的玩家在狐媚娘死于处决时已经是邪恶阵营，则无事发生。");
    g_tipLine[17728] = StringToText("【范例】");
    g_tipLine[17729] = StringToText("狐媚娘选择了哲学家，哲学家知道狐媚娘在场。下一个白天，狐媚娘死于处决。当晚，哲学家转变为邪恶阵营。");
    g_tipLine[17730] = StringToText("醉酒的狐媚娘选择了炼金术士，炼金术士不知道狐媚娘在场。第二个夜晚，狐媚娘恢复清醒，炼金术士知道狐媚娘在场。");
    g_tipLine[17731] = StringToText("  下一个白天，狐媚娘死于处决。当晚，炼金术士转变为邪恶阵营。");
    g_tipLine[17732] = StringToText("狐媚娘选择了侍女，侍女知道狐媚娘在场。第二个夜晚，投毒者选择狐媚娘，下一个白天，狐媚娘死于处决。第三个夜晚，");
    g_tipLine[17733] = StringToText("  侍女没有转变为邪恶阵营。");
    g_tipLine[17734] = StringToText("【运作方式】");
    g_tipLine[17735] = StringToText("在狐媚娘的首个夜晚，唤醒狐媚娘，让其指向任意一名玩家。在该玩家角色标记旁放置「被魅惑」提示标记。");
    g_tipLine[17736] = StringToText("  让狐媚娘重新入睡。");
    g_tipLine[17737] = StringToText("唤醒狐媚娘所选玩家。向他展示「该角色的能力对你生效」信息标记，以及狐媚娘角色标记。让该玩家重新入睡。");
    g_tipLine[17738] = StringToText("一旦狐媚娘死于处决，在下个夜晚：");
    g_tipLine[17739] = StringToText("如果狐媚娘所选玩家是善良阵营，倒转放置该玩家的角色标记以提示他的阵营发生了变化，然后唤醒该玩家，");
    g_tipLine[17740] = StringToText("  对他做出相应的拇指手势（表明他现在是邪恶阵营），然后让该玩家重新入睡。");
    g_tipLine[17741] = StringToText("如果狐媚娘所选玩家是邪恶阵营，无事发生。");
    g_tipLine[17742] = StringToText("【提示标记】");
    g_tipLine[17743] = StringToText("· 被魅惑");
    g_tipLine[17744] = StringToText("放置时机：在狐媚娘夜晚行动并选择了玩家后。");
    g_tipLine[17745] = StringToText("放置条件：在狐媚娘选择的玩家角色标记旁放置。如果狐媚娘中毒醉酒，在魔典中将该标记倒置。");
    g_tipLine[17746] = StringToText("移除时机：狐媚娘死于处决，并在当晚狐媚娘行动顺序结束时移除（即使此时狐媚娘失去能力，也要移除），");
    g_tipLine[17747] = StringToText("  或在狐媚娘死亡或离场时移除。");
    g_tipLine[17748] = StringToText("【规则细节】");
    g_tipLine[17749] = StringToText("· 相克规则：");
    g_tipLine[17750] = StringToText("  · 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[17751] = StringToText("  · 瘟疫医生：如果说书人本应获得狐媚娘的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipRoleAt[153] = 17717; g_tipRoleN[153] = 35; g_tipP1At[153] = 17719; g_tipP1N[153] = 9; g_tipP2At[153] = 17748; g_tipP2N[153] = 4;
    g_tipAbility[153] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道狐媚娘在场。如果你死于处决，当晚他转变为邪恶阵营。");
    g_tipLine[17752] = StringToText("【背景故事】");
    g_tipLine[17753] = StringToText("「有兽焉，其状如羊身人面，其目在腋下，虎齿人爪，其音如婴儿，名曰狍鸮，是食人。」");
    g_tipLine[17754] = StringToText("【角色能力】");
    g_tipLine[17755] = StringToText("每个夜晚*，你要选择任意数量的非旅行者玩家或一名旅行者玩家：如果他们的角色类型均不相同，他们死亡。[+1外来者]");
    g_tipLine[17756] = StringToText("【角色简介】");
    g_tipLine[17757] = StringToText("饕餮食量惊人，有的时候它会在夜里大肆杀戮来满足自己无尽的饥饿。");
    g_tipLine[17758] = StringToText("· 饕餮每个夜晚可以选择任意数量的非旅行者玩家。如果这些玩家之中没有任何两名玩家有相同的角色类型，");
    g_tipLine[17759] = StringToText("  那么这些玩家都会死亡。");
    g_tipLine[17760] = StringToText("· 饕餮可以不进行选择，这也视作选择了任意数量的玩家。");
    g_tipLine[17761] = StringToText("· 旅行者与其他非旅行者不属于同一角色类型。但是他们是无辜的！如果饕餮选择攻击一名旅行者，");
    g_tipLine[17762] = StringToText("  那么他当晚就不能再攻击其他玩家了。");
    g_tipLine[17763] = StringToText("· 在设置阶段，如果饕餮在场，则用一个未出场的外来者角色标记替换一个镇民标记，然后再让玩家随机抽取角色。");
    g_tipLine[17764] = StringToText("【范例】");
    g_tipLine[17765] = StringToText("在第二个夜晚，饕餮选择了占卜师、以为自己是守鸦人的酒鬼和刺客。这三名玩家死亡。");
    g_tipLine[17766] = StringToText("在第二个夜晚，饕餮选择了赌徒、筑梦师和博学者，由于他们都是镇民，因此无人死亡。");
    g_tipLine[17767] = StringToText("在第二个夜晚，饕餮选择了送葬者和莽夫。莽夫因为受到了饕餮的选择而使饕餮醉酒，所以无人死亡。");
    g_tipLine[17768] = StringToText("【运作方式】");
    g_tipLine[17769] = StringToText("除了首个夜晚以外的每个夜晚，唤醒饕餮。让饕餮选择任意数量的非旅行者玩家，或一名旅行者玩家。");
    g_tipLine[17770] = StringToText("  饕餮也可以摇头表示不做任何选择。如果饕餮进行了选择，并且这些玩家都属于不同的角色类型，");
    g_tipLine[17771] = StringToText("  那么这些玩家死亡（除非这些玩家受到其他原因影响导致不会死亡）。将「死亡」提示标记放置到这些玩家的角色标记旁。");
    g_tipLine[17772] = StringToText("【提示标记】");
    g_tipLine[17773] = StringToText("· 死亡");
    g_tipLine[17774] = StringToText("放置时机：在饕餮夜晚行动并选择了玩家后放置。");
    g_tipLine[17775] = StringToText("放置条件：饕餮选择的玩家不属于同一角色类型，当前存活，且能被饕餮杀死，且饕餮未醉酒中毒，");
    g_tipLine[17776] = StringToText("  那么在该玩家的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[17777] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[17778] = StringToText("【规则细节】");
    g_tipLine[17779] = StringToText("· 被饕餮攻击而死亡的玩家，其死亡顺序依照饕餮的选择顺序进行。如果饕餮导致了多名玩家死亡，");
    g_tipLine[17780] = StringToText("  且其中一名玩家的能力使得饕餮在死亡结算中途中毒或醉酒（比如心上人），那么后续的其他玩家就不会再死亡。");
    g_tipLine[17781] = StringToText("  （但这种情况极为少见，此处仅做举例说明，不意味着鼓励说书人这么做）");
    g_tipRoleAt[154] = 17752; g_tipRoleN[154] = 30; g_tipP1At[154] = 17754; g_tipP1N[154] = 10; g_tipP2At[154] = 17778; g_tipP2N[154] = 4;
    g_tipAbility[154] = StringToText("每个夜晚*，你要选择任意数量的非旅行者玩家或一名旅行者玩家：如果他们的角色类型均不相同，他们死亡。[+1外来者]");
    g_tipLine[17782] = StringToText("【背景故事】");
    g_tipLine[17783] = StringToText("「愚哉世人！明明妖也，而以为美。迷哉愚人！明明忠也，而以为妄。」");
    g_tipLine[17784] = StringToText("【角色能力】");
    g_tipLine[17785] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。");
    g_tipLine[17786] = StringToText("当他下一次即将死亡时，他重生，随后你重获能力。");
    g_tipLine[17787] = StringToText("【角色简介】");
    g_tipLine[17788] = StringToText("画皮迅速并秘密地进行攻击，神不知鬼不觉，时刻觊觎着下一个目标。");
    g_tipLine[17789] = StringToText("· 画皮在首个夜晚就会攻击一名玩家，但天亮后所有玩家都不会知道这件事，除了画皮自己。");
    g_tipLine[17790] = StringToText("· 画皮的攻击会让玩家进入「活尸」状态，该玩家在城镇广场上会表现出「存活」，然而实际上已经死亡。");
    g_tipLine[17791] = StringToText("· 因画皮能力而进入「活尸」状态下的玩家下一次即将死亡时，画皮会阻止这次死亡，并将他复活。画皮会重获能力，");
    g_tipLine[17792] = StringToText("  在当晚进行下一次秘密的攻击。");
    g_tipLine[17793] = StringToText("· 只有能够被画皮杀死的玩家才能因为画皮的攻击而进入「活尸」状态。如果玩家的死亡由于某些原因被阻止，");
    g_tipLine[17794] = StringToText("  他就不会进入「活尸」状态，而是正常存活。");
    g_tipLine[17795] = StringToText("· 如果被画皮选择的玩家因为任何原因仍然存活，当那名玩家下一次即将死亡时，");
    g_tipLine[17796] = StringToText("  画皮也能阻止这次死亡并试图复活那名玩家（尽管复活存活的玩家会导致无事发生），随后重获能力。");
    g_tipLine[17797] = StringToText("【范例】");
    g_tipLine[17798] = StringToText("首个夜晚，画皮选择了侍女，侍女进入「活尸」状态，当晚侍女选择了画皮和造谣者，但得知了「0」。");
    g_tipLine[17799] = StringToText("首个夜晚，画皮选择了士兵，士兵进入「活尸」状态；第三个夜晚，小恶魔攻击了士兵，士兵被复活了，");
    g_tipLine[17800] = StringToText("  画皮重获能力并选择了守鸦人，守鸦人进入「活尸」状态。");
    g_tipLine[17801] = StringToText("第二个夜晚，麻脸巫婆将男爵变成了画皮，随后画皮选择了僧侣；下一个白天，僧侣被处决并重生。");
    g_tipLine[17802] = StringToText("  当晚画皮重获能力并选择了哲学家。");
    g_tipLine[17803] = StringToText("【运作方式】");
    g_tipLine[17804] = StringToText("在画皮的首个夜晚，唤醒画皮，让其指向任意一名存活玩家，如果画皮选择的玩家能够成功被画皮杀死，");
    g_tipLine[17805] = StringToText("  那么画皮选择的玩家进入「活尸」状态。在魔典中该玩家的角色标记旁放置画皮的「以为存活」提示标记并放置帷幕标记，");
    g_tipLine[17806] = StringToText("  但不要在黎明时宣布该玩家已经死亡，也不要在城镇广场上将该玩家的生命标记翻面。");
    g_tipLine[17807] = StringToText("被放置「以为存活」提示标记的玩家下一次即将死亡时，该玩家再次变成存活状态——移除该玩家角色标记旁的「以为存活」");
    g_tipLine[17808] = StringToText("  提示标记，不要宣布该玩家死亡，并移除其帷幕标记，在画皮玩家角色标记旁放置「重获能力」提示标记。当晚，");
    g_tipLine[17809] = StringToText("  唤醒画皮使用其角色能力。");
    g_tipLine[17810] = StringToText("【提示标记】");
    g_tipLine[17811] = StringToText("· 以为存活");
    g_tipLine[17812] = StringToText("放置时机：在画皮夜晚行动并选择了玩家后放置。");
    g_tipLine[17813] = StringToText("放置条件：画皮选择的玩家能被画皮杀死，且画皮未醉酒中毒，那么在该玩家的角色标记旁放置。");
    g_tipLine[17814] = StringToText("  如果该玩家无法死亡或画皮醉酒中毒，该标记不会有任何效果，但你仍然需要放置该标记，");
    g_tipLine[17815] = StringToText("  用于提示被放置该标记的玩家即将死亡时触发画皮复活以及重获能力。魔典中将提示标记倒置，代表该提示标记没有任何效果，");
    g_tipLine[17816] = StringToText("  仅用于标记该玩家被画皮选择过。");
    g_tipLine[17817] = StringToText("移除时机：在画皮重获能力时，或画皮死亡或离场时。");
    g_tipLine[17818] = StringToText("· 重获能力");
    g_tipLine[17819] = StringToText("放置时机：在画皮复活了一名玩家后放置。");
    g_tipLine[17820] = StringToText("放置条件：画皮未醉酒中毒，在已放置有画皮的「以为存活」标记的玩家即将死亡时在画皮玩家的角色标记旁放置。");
    g_tipLine[17821] = StringToText("移除时机：在画皮夜晚行动并选择了玩家后移除。");
    g_tipLine[17822] = StringToText("【规则细节】");
    g_tipLine[17823] = StringToText("· 「活尸」状态下的玩家下一次即将死亡时，如果画皮由于任何原因无法阻止这次死亡，那么画皮无法将他复活，");
    g_tipLine[17824] = StringToText("  也不会重获能力。通常情况下，这意味着画皮在接下来的游戏中将会毫无作用。");
    g_tipLine[17825] = StringToText("· 如果一名玩家在「活尸」状态已经使用过「每局游戏限一次」的能力，或者已经使用过「每局游戏限一次」");
    g_tipLine[17826] = StringToText("  的能力之后再进入「活尸」状态，即使画皮将他复活，该玩家也无法再次使用「每局游戏限一次」的能力。");
    g_tipLine[17827] = StringToText("· 特定角色互动：");
    g_tipLine[17828] = StringToText("  · 红唇女郎：如果画皮选择了恶魔，通常情况下，游戏会因为场上没有存活恶魔而立即结束。即使场上有红唇女郎，");
    g_tipLine[17829] = StringToText("    也会把恶魔当作存活玩家从而不触发红唇女郎的能力。");
    g_tipRoleAt[155] = 17782; g_tipRoleN[155] = 48; g_tipP1At[155] = 17784; g_tipP1N[155] = 13; g_tipP2At[155] = 17822; g_tipP2N[155] = 8;
    g_tipAbility[155] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。当他下一次即将死亡时，他重生，随后你重获能力。");
    g_tipLine[17830] = StringToText("【背景故事】");
    g_tipLine[17831] = StringToText("「船缓难行，有不洁之气。」");
    g_tipLine[17832] = StringToText("【角色能力】");
    g_tipLine[17833] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有邪恶玩家的能力选择或影响了他们之中的玩家。");
    g_tipLine[17834] = StringToText("【角色简介】");
    g_tipLine[17835] = StringToText("引路人能够得知夜晚是否有邪恶作祟，侵扰玩家。");
    g_tipLine[17836] = StringToText("· 每个夜晚，引路人都可以选择一至三名玩家，但不能不进行选择，也不能选择自己。");
    g_tipLine[17837] = StringToText("· 如果引路人选择的玩家中没有在当晚被邪恶玩家的能力选择或影响，引路人会得知「否」。");
    g_tipLine[17838] = StringToText("· 如果引路人选择的玩家中在当晚被邪恶玩家能力选择或者影响，引路人会得知「是」。如果引路人选择了超过一名玩家，");
    g_tipLine[17839] = StringToText("  他不会得知是具体哪名玩家被邪恶玩家能力选择或者影响了。");
    g_tipLine[17840] = StringToText("· 不仅邪恶的爪牙、恶魔能力会被引路人探查，邪恶的镇民、外来者能力也会被引路人探查。");
    g_tipLine[17841] = StringToText("【范例】");
    g_tipLine[17842] = StringToText("引路人选择了占卜师、共情者和男爵，他们今晚都没有被邪恶玩家选择或影响，引路人得知「否」。");
    g_tipLine[17843] = StringToText("麻脸巫婆将洗脑师变成了邪恶的舞蛇人，舞蛇人选择了士兵，引路人选择了士兵，并得知「是」。");
    g_tipLine[17844] = StringToText("首个夜晚，普卡选择了呆瓜。下个夜晚，僧侣选择了呆瓜，普卡选择了修补匠，随后引路人选择了呆瓜，并得知「是」。");
    g_tipLine[17845] = StringToText("【运作方式】");
    g_tipLine[17846] = StringToText("每个夜晚，唤醒引路人，让引路人指向除自己以外任意一至三名玩家，如果引路人选择的玩家中有任何玩家在当晚被邪恶玩家的");
    g_tipLine[17847] = StringToText("  能力选择或影响过，对引路人点头表示「是」。否则，摇头表示「否」。让引路人重新入睡。");
    g_tipLine[17848] = StringToText("【提示标记】");
    g_tipLine[17849] = StringToText("无");
    g_tipLine[17850] = StringToText("【规则细节】");
    g_tipLine[17851] = StringToText("「影响」的范围包括：改变该玩家的状态（角色、阵营等），对该玩家的能力造成了妨害效果（互动干扰、能力效果干扰、");
    g_tipLine[17852] = StringToText("  阻止能力生效等），等等。暴露角色、让他人获取信息等能力不在「影响」的范围内。");
    g_tipLine[17853] = StringToText("与「保护」类似，如果邪恶玩家执行了善良玩家的能力产生选择或影响，同样会被引路人探查。");
    g_tipLine[17854] = StringToText("· 特定角色互动：");
    g_tipLine[17855] = StringToText("  · 小怪宝：如果一名邪恶玩家照顾了小怪宝，当晚因小怪宝能力死亡的玩家算作被邪恶玩家的能力影响了。");
    g_tipLine[17856] = StringToText("· 相克规则：");
    g_tipLine[17857] = StringToText("  · 侍女：侍女会得知引路人是否醒来，即使她是在引路人之前醒来。");
    g_tipLine[17858] = StringToText("  · 数学家：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。");
    g_tipRoleAt[156] = 17830; g_tipRoleN[156] = 29; g_tipP1At[156] = 17832; g_tipP1N[156] = 9; g_tipP2At[156] = 17850; g_tipP2N[156] = 9;
    g_tipAbility[156] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有邪恶玩家的能力选择或影响了他们之中的玩家。");
    g_tipLine[17859] = StringToText("【背景故事】");
    g_tipLine[17860] = StringToText("「岭海滞公犹未召，蛮荒著我更何尤。」");
    g_tipLine[17861] = StringToText("【角色能力】");
    g_tipLine[17862] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择邪恶玩家时会改为选中你，即使你已死亡。");
    g_tipLine[17863] = StringToText("【角色简介】");
    g_tipLine[17864] = StringToText("使节远离家乡来到陌生的地方，因此容易成为他人欺凌的对象。");
    g_tipLine[17865] = StringToText("· 在每个夜晚，使节的能力能够触发最多一次。使节的能力可以连续在多个夜晚都触发，也可能会连续几个夜晚都不触发。");
    g_tipLine[17866] = StringToText("  由说书人来决定使节的能力触发与否。");
    g_tipLine[17867] = StringToText("· 只要有玩家在使用自身能力选择了邪恶玩家，且使节的能力当晚还未触发，");
    g_tipLine[17868] = StringToText("  说书人就可以决定触发使节的能力让该玩家的选择目标改为使节。");
    g_tipLine[17869] = StringToText("· 如果使节的能力在当晚已经被触发过一次了，那么之后有其他玩家使用能力进行选择时，就无法再被使节影响。");
    g_tipLine[17870] = StringToText("【范例】");
    g_tipLine[17871] = StringToText("占卜师选择了女裁缝和恶魔，说书人决定触发使节的能力，使占卜师改为选择女裁缝和使节。占卜师得知了「否」。");
    g_tipLine[17872] = StringToText("麻脸巫婆选择将邪恶的舞蛇人变成亡骨魔，说书人决定不触发使节的能力。随后，洗脑师选择让自己「疯狂」");
    g_tipLine[17873] = StringToText("  地证明自己是贤者，说书人决定触发使节的能力，使节需要在下个白天和夜晚「疯狂」地证明自己是贤者，");
    g_tipLine[17874] = StringToText("  否则他可能会被处决。");
    g_tipLine[17875] = StringToText("【运作方式】");
    g_tipLine[17876] = StringToText("在每个夜晚，任何玩家使用自身能力选择了目标，其中包含邪恶玩家，且使节的「已触发」提示标记还未放置时，");
    g_tipLine[17877] = StringToText("  说书人可以决定将这项能力其中一个目标从邪恶玩家改为使节。然后，在使节的角色标记旁放置「已触发」提示标记。");
    g_tipLine[17878] = StringToText("在黎明时，移除「已触发」提示标记。");
    g_tipLine[17879] = StringToText("【提示标记】");
    g_tipLine[17880] = StringToText("· 已触发");
    g_tipLine[17881] = StringToText("放置时机：夜晚说书人决定触发使节的能力时放置。");
    g_tipLine[17882] = StringToText("放置条件：放置在使节的角色标记旁。");
    g_tipLine[17883] = StringToText("移除时机：在黎明时，或使节离场时。");
    g_tipLine[17884] = StringToText("【规则细节】");
    g_tipLine[17885] = StringToText("· 相克规则：");
    g_tipLine[17886] = StringToText("  · 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipRoleAt[157] = 17859; g_tipRoleN[157] = 28; g_tipP1At[157] = 17861; g_tipP1N[157] = 9; g_tipP2At[157] = 17884; g_tipP2N[157] = 3;
    g_tipAbility[157] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择邪恶玩家时会改为选中你，即使你已死亡。");
    g_tipLine[17887] = StringToText("【背景故事】");
    g_tipLine[17888] = StringToText("「平时里见他，要么浑身污垢满嘴臭味，要么疯言疯行不知所云。」");
    g_tipLine[17889] = StringToText("【角色能力】");
    g_tipLine[17890] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名邪恶玩家作为替代。");
    g_tipLine[17891] = StringToText("【角色简介】");
    g_tipLine[17892] = StringToText("半仙精通各种怪力乱神之术，能够将对他潜在的威胁转移到邪祟之人的身上。");
    g_tipLine[17893] = StringToText("· 在夜晚时，任何使用自身能力选择半仙的玩家，在其能力生效前，选择的目标会暗中转移到一名邪恶玩家的身上。随后，");
    g_tipLine[17894] = StringToText("  这项能力效果会以那名邪恶玩家作为新的目标来进行结算。");
    g_tipLine[17895] = StringToText("· 使用能力选择半仙的玩家不会得知自己的选择目标被更改，半仙也不会得知自己的能力被触发。");
    g_tipLine[17896] = StringToText("· 只有需要做出选择的能力才能被半仙转移目标。无需进行选择的能力，无法被半仙转移目标。");
    g_tipLine[17897] = StringToText("· 在一项能力更换目标后，无需重新进行选择限制条件的判断。舞蛇人的选择目标可能会因此改为已经死亡的邪恶玩家，");
    g_tipLine[17898] = StringToText("  魔鬼代言人的选择目标可能会改为选中自己。");
    g_tipLine[17899] = StringToText("· 在一项能力更换目标后，需要重新进行能力效果中触发条件的判断。传教士因为半仙而改为选中恶魔时，不会让恶魔失去能力，");
    g_tipLine[17900] = StringToText("  因为恶魔与爪牙是不同的角色类型。");
    g_tipLine[17901] = StringToText("· 一项能力在更换选择目标后，能力自身与选择相关的内容不会因此发生变更，依然以玩家自身做出的选择作为判断基准。");
    g_tipLine[17902] = StringToText("  魔鬼代言人在选择半仙后导致目标转移，他在第二晚无法选择半仙，而不是无法选择转移后的目标。");
    g_tipLine[17903] = StringToText("  管家在选择主人时目标被变更，管家在下个白天投票时仍然需要参考他昨晚选择的那名玩家的投票意见，不会受到影响。");
    g_tipLine[17904] = StringToText("· 如果一项能力需要玩家选择多个目标，而半仙成为了目标之一，那么半仙只会将自己更改为一名邪恶玩家，");
    g_tipLine[17905] = StringToText("  不会使得玩家的其他目标发生变化。半仙也不会让一项能力的多个目标中重复选择同一名玩家。");
    g_tipLine[17906] = StringToText("  如果此时没有其他合法的目标可以转移选择，那么半仙仍然会受到原本能力效果的影响。");
    g_tipLine[17907] = StringToText("· 一项能力中的某个选择目标至多只能被转移一次。也就是说，被半仙转移后的目标，无法受到使节的影响使得目标再次转移。");
    g_tipLine[17908] = StringToText("· 半仙的能力只会在夜晚被触发。在白天时，他的能力不会产生任何效果。");
    g_tipLine[17909] = StringToText("【范例】");
    g_tipLine[17910] = StringToText("占卜师选择了半仙和红唇女郎，半仙的能力使得占卜师的目标变为小恶魔和红唇女郎。占卜师得知了「是」。");
    g_tipLine[17911] = StringToText("魔鬼代言人选择让自己处决不死。在第二个夜晚，魔鬼代言人选择了半仙，说书人将目标变成了魔鬼代言人自己。");
    g_tipLine[17912] = StringToText("  魔鬼代言人继续受到处决不死的保护，且能够在下一个夜晚继续选择保护自己，因为他上一次选择的玩家是半仙。");
    g_tipLine[17913] = StringToText("精神病患者攻击了半仙，半仙死亡，因为他的能力在白天无法被触发。");
    g_tipLine[17914] = StringToText("【运作方式】");
    g_tipLine[17915] = StringToText("每个夜晚，如果有任何玩家使用自身能力选择了半仙，则将选择目标改为任意一名邪恶玩家，再执行能力效果的相关结算。");
    g_tipLine[17916] = StringToText("  无需为新的目标进行角色能力中冒号「：」之前的部分的条件判断，直接执行冒号之后的效果。");
    g_tipLine[17917] = StringToText("【规则细节】");
    g_tipLine[17918] = StringToText("· 特定角色互动：");
    g_tipLine[17919] = StringToText("  · 刺客：如果刺客攻击了半仙，半仙会直接死亡，并且不会将刺客的效果转移到邪恶玩家身上。");
    g_tipLine[17920] = StringToText("  · 恐惧之灵：如果恐惧之灵选择了半仙，是否播报能力取决于半仙转移结果的玩家是否与恐惧之灵之前的选择发生了变化。");
    g_tipLine[17921] = StringToText("    被半仙转移后，恐惧之灵的能力只会对转移后的目标生效（从某种意义上来说，也算是无效了，");
    g_tipLine[17922] = StringToText("    因为恐惧之灵的能力此时只能让邪恶阵营落败）。恐惧之灵需要通过播报与否来判断自己是否选中了半仙。");
    g_tipLine[17923] = StringToText("  · 和尚：如果半仙与和尚为邻座，且有邪恶玩家的能力选择了半仙，在和尚的能力生效前，半仙会先将选择目标转移，");
    g_tipLine[17924] = StringToText("    从而使得邪恶玩家既不会选择半仙为目标，也不会影响半仙，因此不会触发和尚的能力。反之，");
    g_tipLine[17925] = StringToText("    如果半仙将邪恶玩家的选择转移到与和尚邻近的一名邪恶玩家，和尚的能力就会因此被触发。");
    g_tipLine[17926] = StringToText("· 相克规则：");
    g_tipLine[17927] = StringToText("  · 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[17928] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[17929] = StringToText("  · 鸩：如果鸩选择了半仙，半仙会中毒并死亡。");
    g_tipRoleAt[158] = 17887; g_tipRoleN[158] = 43; g_tipP1At[158] = 17889; g_tipP1N[158] = 20; g_tipP2At[158] = 17917; g_tipP2N[158] = 13;
    g_tipAbility[158] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名邪恶玩家作为替代。");
    g_tipLine[17930] = StringToText("【背景故事】");
    g_tipLine[17931] = StringToText("「买卖不成情义在。」");
    g_tipLine[17932] = StringToText("【角色能力】");
    g_tipLine[17933] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[17934] = StringToText("  改为选中另一名玩家。");
    g_tipLine[17935] = StringToText("【角色简介】");
    g_tipLine[17936] = StringToText("掮客促成两名阵营相同的玩家的合作，使得其他玩家的选择被转换。");
    g_tipLine[17937] = StringToText("· 在夜晚时，掮客选择的两名存活玩家如果阵营相同，任何玩家使用自身能力选择他们之一时，在其能力生效前，");
    g_tipLine[17938] = StringToText("  选择的目标会转移到另一名玩家的身上。随后，这项能力效果会以另一名玩家作为新的目标来结算。");
    g_tipLine[17939] = StringToText("· 如果掮客选择的两名存活玩家阵营不相同，那么，任何玩家使用自身能力选择他们之一作为目标时，不会发生转移。");
    g_tipLine[17940] = StringToText("· 使用能力被掮客转移目标的玩家不会得知自己的选择目标被更换。掮客也不会得知是否有玩家因此被转移了选择的目标。");
    g_tipLine[17941] = StringToText("· 只有需要玩家做出选择的能力才能被掮客转移目标。无需进行选择的能力，无法被掮客转移目标。");
    g_tipLine[17942] = StringToText("· 掮客的能力只会在夜晚生效。在白天时，他的能力不会产生任何效果。");
    g_tipLine[17943] = StringToText("【范例】");
    g_tipLine[17944] = StringToText("掮客选择了守鸦人和艺术家。恶魔攻击了艺术家，守鸦人死亡并触发了自己的能力。");
    g_tipLine[17945] = StringToText("魔鬼代言人选择让自己处决不死。在第二个夜晚，掮客选择了魔鬼代言人和珀。魔鬼代言人选择了珀。");
    g_tipLine[17946] = StringToText("  魔鬼代言人继续受到处决不死的保护，且能够在下一个夜晚继续选择保护自己，因为他上一次选择的玩家是珀。");
    g_tipLine[17947] = StringToText("掮客选择了陌客和厨师。小恶魔攻击了厨师，说书人决定让陌客被当作邪恶阵营从而不触发掮客的转移目标效果，厨师死亡了。");
    g_tipLine[17948] = StringToText("【运作方式】");
    g_tipLine[17949] = StringToText("每个夜晚，唤醒掮客。让掮客指向任意两名存活玩家。让掮客重新入睡。如果这两名玩家阵营相同，将「熟客」");
    g_tipLine[17950] = StringToText("  提示标记放置到所选的两名玩家的角色标记旁。今晚，任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    g_tipLine[17951] = StringToText("【提示标记】");
    g_tipLine[17952] = StringToText("· 熟客（共2枚）");
    g_tipLine[17953] = StringToText("放置时机：在掮客夜晚行动并选择了玩家后。");
    g_tipLine[17954] = StringToText("放置条件：如果掮客选择的玩家阵营相同，在这两名玩家的角色标记旁分别各放置一个此标记。若此时掮客醉酒中毒，");
    g_tipLine[17955] = StringToText("  不放置该标记。");
    g_tipLine[17956] = StringToText("移除时机：在黄昏时，或掮客死亡或离场时。");
    g_tipLine[17957] = StringToText("特殊说明：由于掮客的能力是持续检测，当熟客的阵营不同时，也会移除熟客标记。");
    g_tipLine[17958] = StringToText("【规则细节】");
    g_tipLine[17959] = StringToText("· 掮客会持续检测被选择的玩家的阵营，一旦他们当中出现了阵营变化导致这两名玩家阵营不同，");
    g_tipLine[17960] = StringToText("  掮客会立即失去对这两名玩家更换选择目标的能力。");
    g_tipLine[17961] = StringToText("· 更多规则与细节详情请查看更换选择目标。");
    g_tipLine[17962] = StringToText("· 特定角色互动：");
    g_tipLine[17963] = StringToText("  · 刺客：如果刺客攻击了掮客选择的玩家，那名玩家会直接死亡，并不会将刺客的效果转移到另一名玩家身上。");
    g_tipLine[17964] = StringToText("· 相克规则：");
    g_tipLine[17965] = StringToText("  · 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipRoleAt[159] = 17930; g_tipRoleN[159] = 36; g_tipP1At[159] = 17932; g_tipP1N[159] = 11; g_tipP2At[159] = 17958; g_tipP2N[159] = 8;
    g_tipAbility[159] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    g_tipLine[17966] = StringToText("【背景故事】");
    g_tipLine[17967] = StringToText("「客官，再饮一杯吧。」");
    g_tipLine[17968] = StringToText("【角色能力】");
    g_tipLine[17969] = StringToText("与你邻近的善良玩家（旅行者除外）之一醉酒，即使你死于处决。");
    g_tipLine[17970] = StringToText("【角色简介】");
    g_tipLine[17971] = StringToText("酒保会使邻近的一名善良玩家醉酒。");
    g_tipLine[17972] = StringToText("· 由说书人选择哪名善良玩家醉酒，无论这名善良玩家是存活还是死亡。");
    g_tipLine[17973] = StringToText("· 酒保的醉酒效果会跳过与他相邻的邪恶玩家。酒保的醉酒效果不会对旅行者生效。");
    g_tipLine[17974] = StringToText("· 这项能力当酒保死于处决时仍会保留。如果酒保因为非处决的原因而死亡时，醉酒将会解除。");
    g_tipLine[17975] = StringToText("· 如果有玩家成为新的酒保，或一个醉酒的善良玩家转为了邪恶，都会根据新的位置关系立刻改变醉酒的玩家。");
    g_tipLine[17976] = StringToText("【范例】");
    g_tipLine[17977] = StringToText("酒保的邻近玩家是占卜师和修行者。占卜师现在醉酒了，并可能在夜晚得知错误信息。");
    g_tipLine[17978] = StringToText("酒保今天死于处决了。与酒保邻近的送葬者仍然醉酒，当晚送葬者被展示了投毒者标记。");
    g_tipLine[17979] = StringToText("酒保邻近的共情者醉酒了。恶魔当晚杀死了酒保，共情者恢复清醒，当晚共情者获得了正确的信息。");
    g_tipLine[17980] = StringToText("酒保邻近的镇长醉酒了，该方向上的下一名玩家是侍女。白天，镇长说出了灵言师的关键词。当晚，");
    g_tipLine[17981] = StringToText("  镇长转为了邪恶并恢复清醒，侍女现在因为酒保的能力而醉酒。");
    g_tipLine[17982] = StringToText("【运作方式】");
    g_tipLine[17983] = StringToText("在为首个夜晚进行准备时，让一名与酒保邻近的善良玩家（旅行者除外）醉酒——在他的角色标记旁放置「醉酒」标记。");
    g_tipLine[17984] = StringToText("如果酒保死于处决了，那么「醉酒」标记不会被移除。如果酒保因为非处决的原因死亡了，立即移除「醉酒」标记。");
    g_tipLine[17985] = StringToText("如果一名被酒保影响的善良玩家转为了邪恶，或者酒保变成了另一个角色，或者如果一个新的玩家变成了酒保，");
    g_tipLine[17986] = StringToText("  都会让与酒保现在邻近的善良玩家之一醉酒，而之前邻近但现在不邻近的善良玩家恢复清醒。");
    g_tipLine[17987] = StringToText("【提示标记】");
    g_tipLine[17988] = StringToText("· 醉酒");
    g_tipLine[17989] = StringToText("放置时机：在为首个夜晚做准备时放置，或有新的酒保出现时立即放置。");
    g_tipLine[17990] = StringToText("放置条件：放置在与酒保邻近的善良玩家（旅行者除外）之一的角色标记旁。");
    g_tipLine[17991] = StringToText("特殊说明：动态检测会检查酒保及与其邻近的因酒保能力而醉酒的善良玩家是哪些玩家。");
    g_tipLine[17992] = StringToText("  一旦酒保及其邻近的因酒保能力而醉酒的善良玩家的座次或阵营发生变化，就需要移动「醉酒」");
    g_tipLine[17993] = StringToText("  标记至满足条件的玩家角色标记旁（不会因此将「醉酒\"标记替换到酒保玩家的另一侧去）。");
    g_tipLine[17994] = StringToText("移除时机：酒保因为非处决的原因死亡或离场时移除。");
    g_tipRoleAt[160] = 17966; g_tipRoleN[160] = 29; g_tipP1At[160] = 17968; g_tipP1N[160] = 8; g_tipP2At[160] = 0; g_tipP2N[160] = 0;
    g_tipAbility[160] = StringToText("与你邻近的善良玩家（旅行者除外）之一醉酒，即使你死于处决。");
    g_tipLine[17995] = StringToText("【背景故事】");
    g_tipLine[17996] = StringToText("「本来无一物，何处惹尘埃。」");
    g_tipLine[17997] = StringToText("【角色能力】");
    g_tipLine[17998] = StringToText("每个夜晚，当有邪恶玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，");
    g_tipLine[17999] = StringToText("  且你会得知你的能力被触发。");
    g_tipLine[18000] = StringToText("【角色简介】");
    g_tipLine[18001] = StringToText("和尚慈悲为怀，一视同仁地庇护着他周围的人。");
    g_tipLine[18002] = StringToText("· 和尚的能力在每个夜晚都能且仅能触发一次。");
    g_tipLine[18003] = StringToText("· 当邪恶玩家的能力选择了与和尚邻近的存活玩家，或者一项无需选择的能力在满足了条件而被触发，");
    g_tipLine[18004] = StringToText("  且会对与和尚邻近的存活玩家生效时，和尚会使邪恶玩家此次的能力不生效。这一效果跟使这名玩家「中毒/醉酒」相似。");
    g_tipLine[18005] = StringToText("  然而，如果某名邪恶玩家在同一个夜晚可以多次行动，和尚只能使其中一次效果无效，而除此以外的其他效果仍然会正常生效。");
    g_tipLine[18006] = StringToText("· 如果邪恶玩家的能力是一项持续生效的能力，而非选择式或触发式的能力，和尚会使这项能力失效直至下个黎明。");
    g_tipLine[18007] = StringToText("  在下一个白天时，这项能力会再次生效。");
    g_tipLine[18008] = StringToText("· 和尚只能在一项能力开始生效前阻止这项能力。他无法阻止已经生效的能力。");
    g_tipLine[18009] = StringToText("· 一旦和尚的能力被成功触发，他会被唤醒，并得知自己的能力刚刚被触发了。和尚不会得知是哪名邪恶玩家的能力被他阻止了，");
    g_tipLine[18010] = StringToText("  也不会得知这项能力影响的是与他邻近的哪一名玩家。他只是单纯知道自己的能力被触发了。");
    g_tipLine[18011] = StringToText("· 如果一项邪恶玩家的能力无法被阻止，那么和尚的能力不会因此被触发，和尚也不会得知自己的能力触发了。");
    g_tipLine[18012] = StringToText("【范例】");
    g_tipLine[18013] = StringToText("小恶魔自杀了。与和尚邻近的男爵受到和尚的能力影响，无法变成小恶魔。因为场上没有存活的恶魔，游戏结束，");
    g_tipLine[18014] = StringToText("  善良阵营获胜。");
    g_tipLine[18015] = StringToText("刺客使用自己的能力攻击了与和尚邻近的弄臣。弄臣死亡，且和尚不会得知自己的能力被触发了。");
    g_tipLine[18016] = StringToText("与和尚间隔了哲学家的舞蛇人选中了诺-达鲺，并与之交换了角色和阵营。和尚的能力被触发，");
    g_tipLine[18017] = StringToText("  诺-达鲺邻近的两名镇民（包括哲学家）没有因此中毒。诺-达鲺的中毒能力失效，但他仍然可以在当晚选择一名玩家攻击，");
    g_tipLine[18018] = StringToText("  并成功杀死那名玩家。在下个白天，诺-达鲺的中毒能力再次生效，哲学家中毒。");
    g_tipLine[18019] = StringToText("【运作方式】");
    g_tipLine[18020] = StringToText("在每个夜晚，如果有邪恶玩家的能力选择或即将影响与和尚邻近的存活玩家，且和尚的角色标记旁尚未放置「已生效」");
    g_tipLine[18021] = StringToText("  提示标记，那么这项能力无效。将和尚的「已生效」提示标记放置在和尚的角色标记旁。如果这项能力是一项非持续能力，");
    g_tipLine[18022] = StringToText("  能力直接失效，但邪恶玩家的其他能力仍然能正常使用。如果这项能力是一项持续能力，能力会在下一个白天重新生效。随后，");
    g_tipLine[18023] = StringToText("  唤醒和尚，对他展示和尚角色标记。让和尚重新入睡。");
    g_tipLine[18024] = StringToText("在黎明时，移除「已生效」提示标记。");
    g_tipLine[18025] = StringToText("【提示标记】");
    g_tipLine[18026] = StringToText("· 已生效");
    g_tipLine[18027] = StringToText("放置时机：每个夜晚，与和尚邻近的存活玩家第一次被其他邪恶玩家使用能力影响或选择时。");
    g_tipLine[18028] = StringToText("放置条件：放置在和尚的角色标记旁。如果和尚中毒醉酒，倒置该标记表示该标记没有效果，");
    g_tipLine[18029] = StringToText("  用于提示当晚和尚的能力已经触发过。");
    g_tipLine[18030] = StringToText("移除时机：在黎明时，或和尚死亡或离场时。");
    g_tipLine[18031] = StringToText("【规则细节】");
    g_tipLine[18032] = StringToText("· 如果和尚的能力使得一项「玩家让自身获得信息」的能力失效，其处理方式与醉酒中毒相似，该玩家仍然会获得信息，");
    g_tipLine[18033] = StringToText("  但信息可对可错。");
    g_tipLine[18034] = StringToText("· 特定角色互动：");
    g_tipLine[18035] = StringToText("  · 诺-达鲺：如果在游戏开始时，诺-达鲺的中毒影响了与和尚邻近的镇民，和尚的能力在首个夜晚不会触发。");
    g_tipLine[18036] = StringToText("    如果诺-达鲺在游戏中途的某个夜晚被创造并将要影响与和尚邻近的镇民，和尚的能力会被触发，");
    g_tipLine[18037] = StringToText("    诺-达鲺的中毒能力（包括让另一侧的镇民中毒）会在下个黎明才开始生效。");
    g_tipLine[18038] = StringToText("  · 限：如果限的能力让所有镇民中毒，和尚会因中毒而无法触发能力。");
    g_tipLine[18039] = StringToText("  · 混沌：如果混沌的能力让所有善良玩家中毒，（善良的）和尚会因中毒而无法触发能力。");
    g_tipLine[18040] = StringToText("· 相克规则：");
    g_tipLine[18041] = StringToText("  · 利维坦：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[18042] = StringToText("  · 暴乱：如果暴乱提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipRoleAt[161] = 17995; g_tipRoleN[161] = 48; g_tipP1At[161] = 17997; g_tipP1N[161] = 15; g_tipP2At[161] = 18031; g_tipP2N[161] = 12;
    g_tipAbility[161] = StringToText("每个夜晚，当有邪恶玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，且你会得知你的能力被触发。");
    g_tipLine[18043] = StringToText("【角色能力】");
    g_tipLine[18044] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的镇民玩家的角色，他中毒且可能被当作邪恶的蛊雕，直到下个黄昏。");
    g_tipLine[18045] = StringToText("每局游戏限一次，在夜晚时，你可以改变方向。");
    g_tipLine[18046] = StringToText("【角色简介】");
    g_tipLine[18047] = StringToText("蛊雕停留在镇民之中。");
    g_tipLine[18048] = StringToText("· 每个夜晚，蛊雕都会得知顺时针方向上的下一名存活的镇民玩家的角色。其他角色类型的玩家，或是已经死亡的玩家，");
    g_tipLine[18049] = StringToText("  都会被蛊雕跳过。");
    g_tipLine[18050] = StringToText("· 被蛊雕得知的玩家中毒且可能被当作邪恶的蛊雕，直到下个黄昏。这代表着其他玩家可能当作他是邪恶的蛊雕，");
    g_tipLine[18051] = StringToText("  也可能会是原本的阵营和角色，这取决于说书人。");
    g_tipLine[18052] = StringToText("· 蛊雕可以改变方向一次。如果蛊雕这么做了，代表蛊雕得知的玩家不再是顺时针方向上的下一名玩家，而是逆时针方向上的。");
    g_tipLine[18053] = StringToText("  蛊雕会因此得知曾得知过的角色。");
    g_tipLine[18054] = StringToText("【范例】");
    g_tipLine[18055] = StringToText("蛊雕、士兵、修行者、异教领袖、刺客顺时针连坐。第一个夜晚，蛊雕得知了士兵且士兵中毒了。异教领袖转变为了邪恶阵营。");
    g_tipLine[18056] = StringToText("  第一个白天，修行者死于处决了。第二个夜晚，蛊雕得知了异教领袖。异教领袖中毒了且不能因自身能力转变阵营。");
    g_tipLine[18057] = StringToText("游戏的首个夜晚，蛊雕让侍女中毒了。调查员得知侍女和占卜师里有蛊雕。村夫选择了侍女并得知了「邪恶」。");
    g_tipLine[18058] = StringToText("游戏的第一个和第二个夜晚，蛊雕都没有改变方向，并依次得知了共情者和报丧女妖。游戏的第三个夜晚，蛊雕选择改变方向，");
    g_tipLine[18059] = StringToText("  并得知了共情者。");
    g_tipLine[18060] = StringToText("【运作方式】");
    g_tipLine[18061] = StringToText("在为首个夜晚进行准备时，将「蛊毒」提示标记放置在蛊雕的角色标记旁。");
    g_tipLine[18062] = StringToText("每个夜晚，唤醒蛊雕。他要么摇头不改变方向，要么点头改变方向。");
    g_tipLine[18063] = StringToText("如果他摇头，将「蛊毒」提示标记放置在顺时针方向上的下一名存活镇民角色标记旁。如果他点头，");
    g_tipLine[18064] = StringToText("  在蛊雕角色标记旁放置「改变方向」提示标记，随后将「蛊毒」提示标记放置在逆时针方向上的下一名存活镇民角色标记旁，");
    g_tipLine[18065] = StringToText("  之后蛊雕无需再对说书人点头或摇头。");
    g_tipLine[18066] = StringToText("随后，将放置着「蛊毒」提示标记的角色标记展示给蛊雕。让蛊雕重新入睡。");
    g_tipLine[18067] = StringToText("每当因游戏规则或角色能力的效果要探查或影响玩家的阵营或角色，且放置「蛊毒」标记的玩家因此被选中为目标时，");
    g_tipLine[18068] = StringToText("  由你决定他被当作原本的阵营和角色或邪恶的蛊雕。");
    g_tipLine[18069] = StringToText("【提示标记】");
    g_tipLine[18070] = StringToText("· 蛊毒");
    g_tipLine[18071] = StringToText("放置时机：蛊雕入场时。");
    g_tipLine[18072] = StringToText("放置条件：初始放置在蛊雕的角色标记旁；每个夜晚，放置在下一名即将被蛊雕得知的玩家角色标记旁。");
    g_tipLine[18073] = StringToText("特殊说明：如果蛊雕中毒或醉酒，不要移动该标记。");
    g_tipLine[18074] = StringToText("移除时机：蛊雕死亡或离场时。");
    g_tipLine[18075] = StringToText("· 改变方向");
    g_tipLine[18076] = StringToText("放置时机：蛊雕选择改变方向时。");
    g_tipLine[18077] = StringToText("放置条件：放置在蛊雕的角色标记旁，不论蛊雕是否醉酒中毒，都会将此标记放置在蛊雕角色标记旁（如果蛊雕中毒或醉酒，");
    g_tipLine[18078] = StringToText("  倒置此标记表示蛊雕并不会因此改变方向）。");
    g_tipLine[18079] = StringToText("移除时机：蛊雕死亡或离场时。");
    g_tipLine[18080] = StringToText("【规则细节】");
    g_tipLine[18081] = StringToText("· 被「蛊毒」的玩家在同时判定角色和阵营的时候，如果决定让蛊雕的能力产生干扰，那么这名玩家只能被当作「邪恶的蛊雕」。");
    g_tipLine[18082] = StringToText("· 如果被「蛊毒」的玩家不再是镇民或死亡了，这名玩家依然受到「蛊毒」的影响。");
    g_tipLine[18083] = StringToText("· 部分角色的能力中，把「蛊毒」玩家当作是邪恶的蛊雕属于「可以但不建议」，例如小恶魔、涡流、传教士、工程师、");
    g_tipLine[18084] = StringToText("  罂粟种植者、帽匠等。说书人应当结合实际经验来进行判断，给玩家带来良好的游戏体验。");
    g_tipLine[18085] = StringToText("· 相克规则：");
    g_tipLine[18086] = StringToText("  · 炼金术士：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改为蛊雕一定在场。每次处决后，");
    g_tipLine[18087] = StringToText("    存活的炼金术士可以公开猜测一名存活玩家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_tipLine[18088] = StringToText("  · 魔术师：蛊雕会跳过魔术师。");
    g_tipLine[18089] = StringToText("  · 食人魔：如果「蛊毒」玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。");
    g_tipLine[18090] = StringToText("  · 瘟疫医生：如果说书人本应获得蛊雕的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[18091] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[18092] = StringToText("  · 戏子/戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[162] = 18043; g_tipRoleN[162] = 50; g_tipP1At[162] = 18043; g_tipP1N[162] = 11; g_tipP2At[162] = 18080; g_tipP2N[162] = 13;
    g_tipAbility[162] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的镇民玩家的角色，他中毒且可能被当作邪恶的蛊雕，直到下个黄昏。每局游戏限一次，在夜晚时，你可以改变方向。");
    g_tipLine[18093] = StringToText("【背景故事】");
    g_tipLine[18094] = StringToText("「一囚伏法，举族同拘。」");
    g_tipLine[18095] = StringToText("【角色能力】");
    g_tipLine[18096] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，");
    g_tipLine[18097] = StringToText("  当晚他们之中会有一名玩家死亡。");
    g_tipLine[18098] = StringToText("【角色简介】");
    g_tipLine[18099] = StringToText("典狱长对「有罪之人」做出判罚，以连坐或择其一的方式。");
    g_tipLine[18100] = StringToText("· 典狱长在首个夜晚就会行动，他可以选择一至三名玩家，但不能不进行选择。");
    g_tipLine[18101] = StringToText("· 如果下个白天，被典狱长选中的玩家之一死于处决，那么所有其他被典狱长选中的玩家都会在下个夜晚死亡；否则，");
    g_tipLine[18102] = StringToText("  被典狱长选中的玩家中会有一名玩家在下个夜晚死亡。");
    g_tipLine[18103] = StringToText("【范例】");
    g_tipLine[18104] = StringToText("首个夜晚，典狱长选择了小明，小李，小红。下个白天，小明死于处决。下个夜晚，小李与小红死亡。");
    g_tipLine[18105] = StringToText("某个夜晚，典狱长选择了小赵和小孙。下个白天，无人被处决。下个夜晚，说书人决定小赵死亡。");
    g_tipLine[18106] = StringToText("【运作方式】");
    g_tipLine[18107] = StringToText("每个夜晚，唤醒典狱长。让典狱长选择任意一至三名玩家。让典狱长重新入睡。将「判罚」");
    g_tipLine[18108] = StringToText("  提示标记放置到这些玩家的角色标记旁。");
    g_tipLine[18109] = StringToText("在白天，如果被放置「判罚」提示标记的玩家死于处决，在该玩家角色标记旁放置「死于今日」提示标记。");
    g_tipLine[18110] = StringToText("除了首个夜晚以外的每个夜晚，如果有玩家角色标记旁放置「死于今日」提示标记，其他所有标有「判罚」");
    g_tipLine[18111] = StringToText("  提示标记的玩家死亡。否则，说书人要决定被标有「判罚」提示标记的玩家之一死亡。");
    g_tipLine[18112] = StringToText("【提示标记】");
    g_tipLine[18113] = StringToText("· 判罚");
    g_tipLine[18114] = StringToText("放置时机：在典狱长夜晚行动并选择了玩家后放置。");
    g_tipLine[18115] = StringToText("放置条件：在典狱长选择的所有玩家的角色标记旁分别各放置一个此标记。不论典狱长是否醉酒中毒，都要放置此标记。");
    g_tipLine[18116] = StringToText("移除时机：当典狱长的能力结算玩家死亡时移除（不论典狱长是否醉酒中毒），或典狱长死亡或离场时移除。");
    g_tipLine[18117] = StringToText("· 死于今日");
    g_tipLine[18118] = StringToText("放置时机：在白天时，如果有被标记着「判罚」的玩家死于处决，在该玩家的角色标记旁放置。");
    g_tipLine[18119] = StringToText("放置条件：在因处决而死亡的玩家的角色标记旁放置，不论此时典狱长是否醉酒中毒，都要放置此标记。");
    g_tipLine[18120] = StringToText("移除时机：当典狱长的能力结算玩家死亡时移除（不论典狱长是否醉酒中毒），或典狱长死亡或离场时移除。");
    g_tipLine[18121] = StringToText("· 死亡");
    g_tipLine[18122] = StringToText("放置时机：在典狱长夜晚行动结束时，放置此标记。");
    g_tipLine[18123] = StringToText("放置条件：典狱长未醉酒中毒时，不论典狱长此次夜晚行动是否被唤醒或成功放置「判罚」标记，进行以下操作：");
    g_tipLine[18124] = StringToText("  检查在本次典狱长夜晚行动之前，是否存在被典狱长的「死于今日」标记的玩家。若是，则在所有被「判罚」");
    g_tipLine[18125] = StringToText("  提示标记标记的玩家的角色标记旁放置「死亡」标记；若否，则在其中一名「判罚」");
    g_tipLine[18126] = StringToText("  提示标记标记的玩家的角色标记旁放置「死亡」标记，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[18127] = StringToText("  若这些玩家已死亡或无法被典狱长杀死或典狱长醉酒中毒，直接移除「判罚」标记。");
    g_tipLine[18128] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18129] = StringToText("【规则细节】");
    g_tipLine[18130] = StringToText("· 特定角色互动：");
    g_tipLine[18131] = StringToText("  · 莽夫：典狱长造成死亡在他选择玩家之后。例如：典狱长第二个夜晚选择了未被选择过的莽夫，");
    g_tipLine[18132] = StringToText("    第一个夜晚他选择的玩家都不会死亡。但第三个夜晚，只要典狱长健康清醒，");
    g_tipLine[18133] = StringToText("    那么典狱长在第二个夜晚选择的玩家（包括莽夫在内），都会正常结算死亡。");
    g_tipLine[18134] = StringToText("· 相克规则：");
    g_tipLine[18135] = StringToText("  · 召唤师：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipRoleAt[163] = 18093; g_tipRoleN[163] = 43; g_tipP1At[163] = 18095; g_tipP1N[163] = 8; g_tipP2At[163] = 18129; g_tipP2N[163] = 7;
    g_tipAbility[163] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，当晚他们之中会有一名玩家死亡。");
    g_tipLine[18136] = StringToText("【背景故事】");
    g_tipLine[18137] = StringToText("“客官您里边儿请嘿！是打尖儿呐还是住店啊？”");
    g_tipLine[18138] = StringToText("【角色能力】");
    g_tipLine[18139] = StringToText("在你的首个夜晚，你会得知两名善良玩家。他们之中会有一人醉酒，即使你已死亡。");
    g_tipLine[18140] = StringToText("【角色简介】");
    g_tipLine[18141] = StringToText("店小二对他店里的顾客非常熟悉，但也为某些酒量不高的顾客感到焦虑。");
    g_tipLine[18142] = StringToText("· 在首个夜晚，店小二会得知两名玩家，这两名玩家都属于善良阵营。");
    g_tipLine[18143] = StringToText("· 店小二所得知的两名玩家之中，会有一名玩家始终醉酒，即使店小二已经死亡。");
    g_tipLine[18144] = StringToText("· 如果店小二在游戏中途被创造，他会在当晚得知两名玩家，且他得知的这两名玩家之中会有一名玩家醉酒。");
    g_tipLine[18145] = StringToText("· 如果已经死亡的玩家变成了店小二，他不会得知任何信息，但仍然会让一名善良玩家醉酒。");
    g_tipLine[18146] = StringToText("【范例】");
    g_tipLine[18147] = StringToText("店小二得知了舞蛇人和哲学家这两名玩家，其中哲学家因为他而醉酒。后来，舞蛇人使用自己的能力变成了邪恶的恶魔，");
    g_tipLine[18148] = StringToText("  但店小二却仍然相信他是善良玩家。");
    g_tipLine[18149] = StringToText("和平主义者被变成了店小二，他得知了善良的小恶魔和炼金术士这两名玩家。善良的小恶魔因此醉酒，他在夜晚试图攻击自己，");
    g_tipLine[18150] = StringToText("  但他的自杀没有成功。");
    g_tipLine[18151] = StringToText("【运作方式】");
    g_tipLine[18152] = StringToText("在为首个夜晚做准备时，分别将“熟客”和“醉酒”提示标记放置到两名善良玩家的角色标记旁。从现在起，");
    g_tipLine[18153] = StringToText("  标记了“醉酒”的那名善良玩家会醉酒直到游戏结束（或店小二离场）。");
    g_tipLine[18154] = StringToText("在首个夜晚，唤醒店小二。分别指向标记了“熟客”和“醉酒”的这两名玩家。然后让店小二重新入睡。");
    g_tipLine[18155] = StringToText("在考虑店小二的能力让谁醉酒时，你应该优先选择获取信息类的角色。这是因为非获取信息类的角色的醉酒状态要么非常容易确");
    g_tipLine[18156] = StringToText("  认（如守夜人），要么非常难确认（如士兵）。同时，让获取信息的角色醉酒，可以确保即使玩家已经找到了店小二让谁醉");
    g_tipLine[18157] = StringToText("  酒之后，醉酒依然能产生一定的效果。");
    g_tipLine[18158] = StringToText("【提示标记】");
    g_tipLine[18159] = StringToText("· 熟客&醉酒");
    g_tipLine[18160] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[18161] = StringToText("放置条件：分别放置在两名不同的善良玩家的角色标记旁。");
    g_tipLine[18162] = StringToText("移除时机：在店小二得知信息之后，说书人可以在方便的时候移除“熟客”提示标记。“醉酒”提示标记则会在店小二离场时才");
    g_tipLine[18163] = StringToText("  会移除。");
    g_tipLine[18164] = StringToText("【规则细节】");
    g_tipLine[18165] = StringToText("· 如果店小二因为其他角色的能力醉酒中毒，或受到涡流效果影响，使得店小二得知了错误信息，店小二仍然会让他所得知的");
    g_tipLine[18166] = StringToText("  两名玩家之中的一人醉酒（如果是店小二醉酒中毒导致的错误信息则需要店小二恢复健康清醒后）。");
    g_tipLine[18167] = StringToText("  这可能会因此导致邪恶玩家醉酒。然而，如果他得知的玩家中存在善良玩家，说书人都应该倾向于让善良玩家醉酒。");
    g_tipLine[18168] = StringToText("· 在店小二醉酒或中毒后，他所得知的玩家可能会发生变化。为了避免他醉酒的目标进行改变，说书人应该只调整店小二所得");
    g_tipLine[18169] = StringToText("  知的消息中，没有醉酒的那一名玩家。");
    g_tipLine[18170] = StringToText("【背景故事】");
    g_tipLine[18171] = StringToText("“脉浮而阳气不足，气不收敛，发散在外。”");
    g_tipLine[18172] = StringToText("【角色能力】");
    g_tipLine[18173] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[18174] = StringToText("【角色简介】");
    g_tipLine[18175] = StringToText("郎中精通望闻问切，能够通过他人的面相进行初步的推测。");
    g_tipLine[18176] = StringToText("· 每个夜晚，郎中都需要选择一名除自己以外的玩家。他会得知一个与该玩家能力相关的词语。说书人会将词语写在纸上，");
    g_tipLine[18177] = StringToText("  或通过能够记录词语的电子设备，向郎中提供这个词语信息。（就像灵言师得知关键词一样。）");
    g_tipLine[18178] = StringToText("· 郎中得知的词语可能来自于那个玩家角色能力描述中的某个词，如“夜晚”、“死亡”、“公开”等；");
    g_tipLine[18179] = StringToText("  也可以是说书人对该玩家能力的某种概括性描述，如“勇敢”、“牺牲”等。");
    g_tipLine[18180] = StringToText("· 郎中每次只会得知一个词语。通常来说这是一个2-4字的词语（或是一个英文单词），这个词是有明确含义的，");
    g_tipLine[18181] = StringToText("  不能是无法组成词语的字拼接在一起。");
    g_tipLine[18182] = StringToText("· 郎中可以连续多个夜晚选择同一名玩家。郎中可以选择已死亡的玩家。郎中不能选择自己。");
    g_tipLine[18183] = StringToText("【范例】");
    g_tipLine[18184] = StringToText("郎中选择了落难少女，得知了“公开”。第二个夜晚，他选择了杂耍艺人，并再次得知了“公开”。");
    g_tipLine[18185] = StringToText("郎中选择了赏金猎人，得知了“邪恶”，因为赏金猎人的能力中包含“邪恶”一词。");
    g_tipLine[18186] = StringToText("郎中选择了半兽人，得知了“牺牲”。第二个夜晚，他选择了士兵，并得知了“勇敢”。");
    g_tipLine[18187] = StringToText("【运作方式】");
    g_tipLine[18188] = StringToText("每个夜晚，唤醒郎中。让他指向任意一名除自己以外的玩家。将该玩家的能力相关的一个词语以纸条或电子设备等形式告知给郎");
    g_tipLine[18189] = StringToText("  中。然后让郎中重新入睡。");
    g_tipLine[18190] = StringToText("建议在游戏早期时尽量向郎中提供模糊的词语，避免郎中迅速确定对方的具体角色，从而为善良阵营积累大量的优势。");
    g_tipLine[18191] = StringToText("【背景故事】");
    g_tipLine[18192] = StringToText("“台上一分钟，台下十年功。”");
    g_tipLine[18193] = StringToText("【角色能力】");
    g_tipLine[18194] = StringToText("每个白天，如果你“疯狂”地证明自己是一个善良角色（与之前不同），你可能会在当晚获得那个角色的能力，直到下个黄昏。");
    g_tipLine[18195] = StringToText("【角色简介】");
    g_tipLine[18196] = StringToText("变脸师擅长在万千样貌中变化自如。");
    g_tipLine[18197] = StringToText("· 如果变脸师疯狂证明自己是一个善良角色，他就可能会在当晚获得那个角色的能力。");
    g_tipLine[18198] = StringToText("· 每当变脸师获得一项能力时，那项能力会持续到下个黄昏。");
    g_tipLine[18199] = StringToText("· 变脸师无法多次获得同一个角色的能力。");
    g_tipLine[18200] = StringToText("· 变脸师可以连续多天疯狂证明自己是同一个角色，随后在接下来的一天证明自己是其他角色。每次在决定变脸师是否能够获");
    g_tipLine[18201] = StringToText("  得能力时，只会参考变脸师当天白天的言论。只要他这一天疯狂证明的角色与他之前曾经证明过且获得能力的角色不同，");
    g_tipLine[18202] = StringToText("  他就可能会获得这个角色的能力。");
    g_tipLine[18203] = StringToText("· 部分角色能力跨度时间与变脸师获得能力的时间可能会不匹配。（如杂耍艺人、歌伶等。）这些角色的能力在变脸师疯狂证");
    g_tipLine[18204] = StringToText("  明时便可立即获得，无需等到夜晚。");
    g_tipLine[18205] = StringToText("【范例】");
    g_tipLine[18206] = StringToText("第一个白天，变脸师“疯狂”地证明自己是占卜师。当晚，他获得了占卜师的能力，选择了两名玩家并得知了“是”。");
    g_tipLine[18207] = StringToText("  第二个白天，他告诉大家他实际上是女裁缝。当晚，他获得了女裁缝的能力，并立即使用了这项能力。第三个白天，");
    g_tipLine[18208] = StringToText("  变脸师告诉大家自己其实是贤者，然而因为他频繁更换自己的角色，也没有给出充足的理由证明自己的动机，");
    g_tipLine[18209] = StringToText("  玩家对他的实际角色产生了怀疑。当晚他没有成功获得贤者的能力，随后他被恶魔攻击并死亡，且无从得知攻击他的恶魔是");
    g_tipLine[18210] = StringToText("  谁。");
    g_tipLine[18211] = StringToText("在前几个白天，变脸师都“疯狂”地证明自己是事务官。然而，他只在第一次证明自己是事务官的夜晚里获得了事务官的能力，");
    g_tipLine[18212] = StringToText("  因为他无法在多个夜晚获得同一个角色的能力。在新的一天，变脸师改口说自己实际上是骑士，没有报出另一名玩家只是因");
    g_tipLine[18213] = StringToText("  为他的行为看起来像是爪牙。当晚，变脸师获得了骑士的能力，并得知了两名非恶魔玩家。");
    g_tipLine[18214] = StringToText("【运作方式】");
    g_tipLine[18215] = StringToText("如果变脸师在某个白天“疯狂”地证明了自己是某个角色列表上的善良角色，且他此前未曾获得过这个善良角色的能力，");
    g_tipLine[18216] = StringToText("  那么从当晚起到下一个黄昏结束，变脸师可能会获得那个角色的能力。");
    g_tipLine[18217] = StringToText("如果说书人决定让变脸师获得能力，在当晚将变脸师角色标记更换为他获得能力的角色标记，并放置“是变脸师”提示标记。");
    g_tipLine[18218] = StringToText("对变脸师来说，合理的证明需要否定此前自己曾疯狂证明过的角色，并给出充足的“为什么伪装成之前的那个角色”的理由。");
    g_tipLine[18219] = StringToText("  因此通常来说，让变脸师在一局游戏中获得1-2次能力是比较合适的。当然，如果形势特殊，说书人也可以让变脸师多次");
    g_tipLine[18220] = StringToText("  获得能力，作为对变脸师卖力“表演”的奖励。");
    g_tipLine[18221] = StringToText("【提示标记】");
    g_tipLine[18222] = StringToText("· 是变脸师");
    g_tipLine[18223] = StringToText("放置时机：白天变脸师“疯狂”地证明了自己是某个善良角色，在夜晚说书人决定让他获得能力时。");
    g_tipLine[18224] = StringToText("放置条件：变脸师玩家的角色标记旁。");
    g_tipLine[18225] = StringToText("特殊说明：如果该角色能力跨度时间与变脸师获得能力的时间不匹配，在白天变脸师疯狂证明时即可放置标记。");
    g_tipLine[18226] = StringToText("移除时机：在黄昏时，变脸师死亡或离场时。");
    g_tipLine[18227] = StringToText("【背景故事】");
    g_tipLine[18228] = StringToText("“道从本心，众生平等。六道轮回，一叶障目。”");
    g_tipLine[18229] = StringToText("【角色能力】");
    g_tipLine[18230] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，你会立即变成一个不在场的镇民角色。");
    g_tipLine[18231] = StringToText("【角色简介】");
    g_tipLine[18232] = StringToText("悟道者误以为自己置身事外，然而当邪恶睥睨时，他才终于醒悟：没有任何人可以置身事外。");
    g_tipLine[18233] = StringToText("· 在游戏设置时，如果悟道者作为出场角色，则将悟道者角色标记移除，并增加一个未出场的任意外来者角色，");
    g_tipLine[18234] = StringToText("  然后再让玩家随机抽取角色。");
    g_tipLine[18235] = StringToText("· 悟道者不具有自己以为的那个外来者的角色能力。");
    g_tipLine[18236] = StringToText("· 当悟道者被邪恶玩家的能力选择或影响时，在相关的效果生效前，悟道者会先改变角色，变成一个不在场的镇民。");
    g_tipLine[18237] = StringToText("· 如果悟道者的角色变化发生在白天，那么说书人会在当晚所有玩家闭眼后，第一时间唤醒悟道者并告知他相关的角色变化。");
    g_tipLine[18238] = StringToText("· 在悟道者的角色变化后，如果他随即受到邪恶玩家的此次能力效果影响，使得他再次变化角色，那么说书人只会告知他最终");
    g_tipLine[18239] = StringToText("  的变化结果。");
    g_tipLine[18240] = StringToText("【范例】");
    g_tipLine[18241] = StringToText("悟道者以为自己是落难少女。然而实际上，爪牙们没有得知“落难少女在场”这一信息。在下一个夜晚，");
    g_tipLine[18242] = StringToText("  麻脸巫婆选择将悟道者变成修补匠。说书人将悟道者唤醒，告诉他他现在是修补匠。悟道者没有因此察觉到自己之前的角色");
    g_tipLine[18243] = StringToText("  实际上是悟道者。");
    g_tipLine[18244] = StringToText("悟道者以为自己是异端分子。恶魔察觉到了悟道者玩家想要隐藏自己是外来者这一事实，猜测他是异端分子，");
    g_tipLine[18245] = StringToText("  于是恶魔选择自杀。游戏结束，善良阵营获胜，因为悟道者不具有异端分子的能力，无法调转胜负结果。");
    g_tipLine[18246] = StringToText("【运作方式】");
    g_tipLine[18247] = StringToText("在游戏设置时，移除悟道者角色标记，并添加一个外来者角色标记，然后再让玩家抽取角色。将“是悟道者”提示标记放置进魔");
    g_tipLine[18248] = StringToText("  典中。");
    g_tipLine[18249] = StringToText("在为首个夜晚进行准备时，将“是悟道者”提示标记放置在用于替换的那名外来者的角色标记旁，用于提醒那名玩家的角色实际");
    g_tipLine[18250] = StringToText("  上是悟道者。这名玩家现在是一名镇民，并且不再具有这个外来者的能力。（但他仍然以为自己是外来者。）");
    g_tipLine[18251] = StringToText("在游戏过程中，以悟道者的外来者角色来让悟道者进行行动。");
    g_tipLine[18252] = StringToText("如果任何邪恶玩家的能力选择了悟道者，或会对悟道者产生效果，则从魔典中移除“是悟道者”提示标记，");
    g_tipLine[18253] = StringToText("  并用一个不在场的镇民标记替换悟道者原本的那个外来者角色标记。如果这个行为发生在夜晚，则在当前玩家重新入睡后，");
    g_tipLine[18254] = StringToText("  唤醒悟道者。对他展示“你是”信息标记和他的新角色标记，告知他他的角色发生了变化。然后让他重新入睡。");
    g_tipLine[18255] = StringToText("  如果这个行为发生在白天，则需要在进入夜晚，所有玩家闭眼后，立即唤醒悟道者并告知他角色变化。");
    g_tipLine[18256] = StringToText("【提示标记】");
    g_tipLine[18257] = StringToText("· 是悟道者");
    g_tipLine[18258] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[18259] = StringToText("放置条件：在将所有玩家的角色标记收回到魔典后，在其中一个外来者角色标记旁放置。");
    g_tipLine[18260] = StringToText("移除时机：当悟道者触发自身能力变为其他不在场的镇民角色或悟道者离场时。");
    g_tipLine[18261] = StringToText("【规则细节】");
    g_tipLine[18262] = StringToText("· 悟道者的能力需要让他认为自己是外来者，因此悟道者无法认为自己是酒鬼或疯子，因为这两个角色不会作为角色标记发给");
    g_tipLine[18263] = StringToText("  玩家。（即使疯子的规则允许让恶魔抽取到疯子角色标记，那也仅代表玩家在作为恶魔时可以抽取到疯子标记，");
    g_tipLine[18264] = StringToText("  而非在作为外来者时可以抽取到疯子标记。）");
    g_tipLine[18265] = StringToText("· 特定角色互动：");
    g_tipLine[18266] = StringToText("· 诺-达鲺：如果在游戏开始时诺-达鲺与悟道者为邻座，悟道者会直接中毒，不会发生角色变化。");
    g_tipLine[18267] = StringToText("  如果在游戏过程中有玩家变成了邪恶的诺-达鲺且悟道者为与他邻近的镇民，悟道者会正常发生角色变化。");
    g_tipLine[18268] = StringToText("· 相克规则：");
    g_tipLine[18269] = StringToText("· 数学家：数学家会得知悟道者产生了错误信息或“能力未正常生效”。");
    g_tipLine[18270] = StringToText("· 村夫：如果村夫在场数量不足3人，悟道者可以变成新的村夫。如果因此使得村夫的在场数量超过1人，");
    g_tipLine[18271] = StringToText("  会有一名村夫醉酒。");
    g_tipLine[18272] = StringToText("· 科学怪人：恶魔无法拥有悟道者的能力。");
    g_tipLine[18273] = StringToText("【背景故事】");
    g_tipLine[18274] = StringToText("“尔遣使遗尔舅祖总兵书，朕已洞悉。将军之心，犹豫未决。朕恐将军失次机会，殊可惜耳。”");
    g_tipLine[18275] = StringToText("【角色能力】");
    g_tipLine[18276] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚转变为邪恶；如果你先死于处决，");
    g_tipLine[18277] = StringToText("  他会在当晚转变为邪恶。");
    g_tipLine[18278] = StringToText("【角色简介】");
    g_tipLine[18279] = StringToText("逆臣与一名其他玩家势不两立。");
    g_tipLine[18280] = StringToText("· 在首个夜晚，逆臣需要选择一名其他玩家。逆臣和这名玩家之间，谁先死于处决，另一名玩家就会在当晚转变为邪恶阵营。");
    g_tipLine[18281] = StringToText("· 两名玩家之间任何一方以其他方式死亡，不会使得另一方转为邪恶阵营。然而，即使逆臣选择的玩家因为其他原因已经死亡，");
    g_tipLine[18282] = StringToText("  逆臣死于处决也会导致他的阵营变化。");
    g_tipLine[18283] = StringToText("· 如果逆臣因为其他原因死亡，他的能力会失效。因此如果他的能力还未导致玩家转变阵营，即使在此之后他选择的玩家死于");
    g_tipLine[18284] = StringToText("  处决，也不会使得逆臣转变阵营。");
    g_tipLine[18285] = StringToText("· 如果逆臣选择的是邪恶玩家，他不会因为逆臣死于处决而转为善良阵营。同理，邪恶的逆臣也不会因为他的目标死于处决而");
    g_tipLine[18286] = StringToText("  转为善良阵营。");
    g_tipLine[18287] = StringToText("【范例】");
    g_tipLine[18288] = StringToText("逆臣选择了舞蛇人。在下个白天，舞蛇人死于处决。当晚，逆臣转变为邪恶阵营。");
    g_tipLine[18289] = StringToText("逆臣选择了麻脸巫婆。在下个白天，逆臣死于处决。因为麻脸巫婆是邪恶的，所以她不会转变阵营。");
    g_tipLine[18290] = StringToText("逆臣选择了哲学家。在第三个夜晚，涡流攻击了哲学家，哲学家死亡。下一个白天，逆臣死于处决。当晚哲学家转变为邪恶阵营。");
    g_tipLine[18291] = StringToText("  ");
    g_tipLine[18292] = StringToText("【运作方式】");
    g_tipLine[18293] = StringToText("在首个夜晚，唤醒逆臣，让逆臣指向任意一名其他玩家。将“不共戴天”提示标记放置在被选择的玩家角色标记旁。");
    g_tipLine[18294] = StringToText("  让逆臣重新入睡。");
    g_tipLine[18295] = StringToText("如果逆臣先死于处决，那么标记了“不共戴天”的玩家在当晚会转变为邪恶阵营。如果被标记“不共戴天”的玩家先死于处决，");
    g_tipLine[18296] = StringToText("  那么逆臣在当晚会转变为邪恶阵营。");
    g_tipLine[18297] = StringToText("在任意一方转变为邪恶阵营后，唤醒角色对应的玩家，并向他展示“你是”信息标记、向下的大拇指，");
    g_tipLine[18298] = StringToText("  让他知道他属于邪恶阵营。让他重新入睡。在魔典上倒置他的角色标记。移除“不共戴天”提示标记。");
    g_tipLine[18299] = StringToText("【提示标记】");
    g_tipLine[18300] = StringToText("· 不共戴天");
    g_tipLine[18301] = StringToText("放置时机：在逆臣首夜行动选择了一名其他玩家后。");
    g_tipLine[18302] = StringToText("放置条件：放置在逆臣选择的玩家角色标记旁。（即使逆臣醉酒中毒，也照常放置。）");
    g_tipLine[18303] = StringToText("移除时机：在逆臣死亡且未触发阵营转变时移除，或在触发了阵营转变后移除。");
    g_tipLine[18304] = StringToText("【规则细节】");
    g_tipLine[18305] = StringToText("无");
    g_tipLine[18306] = StringToText("【背景故事】");
    g_tipLine[18307] = StringToText("“有神鸟，其状如黄囊，赤如丹火，六足四翼，浑敦无面目，是识歌舞，实惟帝江也。”");
    g_tipLine[18308] = StringToText("【角色能力】");
    g_tipLine[18309] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的镇民玩家，除旅行者外的所有善良玩家会中");
    g_tipLine[18310] = StringToText("  毒直到下个黄昏。");
    g_tipLine[18311] = StringToText("【角色简介】");
    g_tipLine[18312] = StringToText("混沌伺机而动，能够让善良玩家集体中毒。");
    g_tipLine[18313] = StringToText("· 当混沌的攻击杀死一名玩家时，如果该玩家的角色是镇民，并且是与混沌最邻近的镇民玩家，混沌的中毒效果就会被触发，");
    g_tipLine[18314] = StringToText("  并持续到下个黄昏时。");
    g_tipLine[18315] = StringToText("· 即使杀死的是邪恶的镇民，只要该玩家是混沌最邻近的两名镇民玩家之一，混沌的中毒效果就会被触发。");
    g_tipLine[18316] = StringToText("· 如果混沌杀死的镇民会使得“死亡时触发的能力”被触发，那么混沌的中毒效果会在这些能力结算完毕后再触发。");
    g_tipLine[18317] = StringToText("· 如果混沌杀死镇民后导致游戏结束，那么混沌的中毒效果不会触发。");
    g_tipLine[18318] = StringToText("· 攻击已经死亡的镇民，或攻击但没有导致镇民的死亡，不会触发混沌的中毒效果。");
    g_tipLine[18319] = StringToText("· 在混沌的中毒效果的生效期间，只要玩家是善良阵营（旅行者除外），就会受到中毒效果的影响，包括善良的爪牙和恶魔。");
    g_tipLine[18320] = StringToText("· 在混沌的中毒效果的生效期间，如果玩家转变为了善良阵营，就会立即中毒。反之，如果玩家转变为了邪恶阵营，");
    g_tipLine[18321] = StringToText("  就会立即解除混沌的中毒效果对他的影响。");
    g_tipLine[18322] = StringToText("【范例】");
    g_tipLine[18323] = StringToText("混沌的左侧是告密者，再左侧是卖花女孩。混沌杀死了卖花女孩，所有善良玩家中毒到下个黄昏。下一个夜晚，");
    g_tipLine[18324] = StringToText("  麻脸巫婆将告密者变成了数学家，随后混沌攻击并杀死了数学家，所有善良玩家再次中毒到下个黄昏。");
    g_tipLine[18325] = StringToText("混沌使得所有善良玩家中毒。当晚，邪恶的异教领袖转为了善良阵营。下一个白天，异教领袖提议所有玩家加入他的教团，");
    g_tipLine[18326] = StringToText("  善良玩家全都同意，但无事发生。");
    g_tipLine[18327] = StringToText("【运作方式】");
    g_tipLine[18328] = StringToText("除首个夜晚外的每个夜晚，唤醒混沌。让混沌指向一名玩家。该玩家死亡，在他角色标记旁放置“死亡”提示标记（除非该玩家");
    g_tipLine[18329] = StringToText("  受到其他原因影响导致不会死亡）。让混沌重新入睡。");
    g_tipLine[18330] = StringToText("如果混沌成功杀死了与自己邻近的一名镇民玩家，在魔典中央放置混沌的“善良中毒”提示标记。从现在起，");
    g_tipLine[18331] = StringToText("  所有玩家只要是善良阵营（旅行者除外），就会处于中毒状态。");
    g_tipLine[18332] = StringToText("在下一个黄昏开始时，移除混沌的“善良中毒”提示标记。");
    g_tipLine[18333] = StringToText("【提示标记】");
    g_tipLine[18334] = StringToText("· 死亡");
    g_tipLine[18335] = StringToText("放置时机：在混沌夜晚行动并选择了玩家后放置。");
    g_tipLine[18336] = StringToText("放置条件：混沌选择的玩家当前存活，且能被混沌杀死，且混沌未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[18337] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[18338] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18339] = StringToText("· 善良中毒");
    g_tipLine[18340] = StringToText("放置时机：在混沌夜晚行动并选择了玩家后放置。");
    g_tipLine[18341] = StringToText("放置条件：混沌此次行动成功杀死了与他邻近的镇民玩家，则将此标记放置在魔典的正中位置。");
    g_tipLine[18342] = StringToText("移除时机：放置此标记后的下个黄昏开始时，或混沌死亡或离场时。");
    g_tipLine[18343] = StringToText("【背景故事】");
    g_tipLine[18344] = StringToText("“定其心神，方可言道。”");
    g_tipLine[18345] = StringToText("【角色能力】");
    g_tipLine[18346] = StringToText("每个夜晚*，你要选择一名玩家：如果你选中了恶魔，你死亡，然后他醉酒直到下个黎明。");
    g_tipLine[18347] = StringToText("【角色简介】");
    g_tipLine[18348] = StringToText("道士会不断地寻找恶魔，令其短暂失去能力，并以自身死亡作为代价。");
    g_tipLine[18349] = StringToText("· 除首个夜晚以外的每个夜晚，道士需要选择一名玩家，如果那名玩家不是恶魔，道士依然存活。当选中一名恶魔玩家时，");
    g_tipLine[18350] = StringToText("  道士死亡，然后那名恶魔玩家在当晚醉酒。");
    g_tipLine[18351] = StringToText("· 醉酒只会维持到天亮前，天亮后恶魔玩家不再醉酒。");
    g_tipLine[18352] = StringToText("· 如果道士选中了恶魔，但道士的死亡由于某些原因被阻止，恶魔玩家当晚不会醉酒。");
    g_tipLine[18353] = StringToText("【范例】");
    g_tipLine[18354] = StringToText("道士选择他自己，道士存活。下个夜晚，道士选择的玩家是刺客，道士依旧存活。");
    g_tipLine[18355] = StringToText("道士选择的玩家是沙巴洛斯。道士死亡，然后沙巴洛斯醉酒。醉酒的沙巴洛斯无法复活任何玩家。随后沙巴洛斯攻击了祖母和侍");
    g_tipLine[18356] = StringToText("  臣，祖母和侍臣都没有死亡。天亮后，沙巴洛斯恢复了清醒。");
    g_tipLine[18357] = StringToText("旅店老板保护了道士和数学家，说书人决定让数学家醉酒。当晚，道士选择的玩家是死亡的小恶魔，道士依然存活，");
    g_tipLine[18358] = StringToText("  小恶魔没有醉酒。");
    g_tipLine[18359] = StringToText("【运作方式】");
    g_tipLine[18360] = StringToText("除首个夜晚以外的每个夜晚，唤醒道士。让道士指向任意一名玩家。然后让道士重新入睡。");
    g_tipLine[18361] = StringToText("如果被选择的玩家不是恶魔，道士存活。如果被选择的玩家是恶魔，道士死亡，将“死亡”提示标记放置到道士玩家的角色标记");
    g_tipLine[18362] = StringToText("  旁并放置帷幕标记，然后将“醉酒”提示标记放置到恶魔玩家的角色标记旁。");
    g_tipLine[18363] = StringToText("在黎明，移除“醉酒”提示标记。");
    g_tipLine[18364] = StringToText("【提示标记】");
    g_tipLine[18365] = StringToText("· 死亡");
    g_tipLine[18366] = StringToText("放置时机：在道士夜晚行动并选择了玩家后放置。");
    g_tipLine[18367] = StringToText("放置条件：如果道士选择的玩家是恶魔，则将此标记放置在道士玩家角色标记旁，用以提醒说书人在黎明时分宣布道士玩家死亡。");
    g_tipLine[18368] = StringToText("  如果此时道士醉酒中毒或无法死亡，则不放置该标记。");
    g_tipLine[18369] = StringToText("移除时机：在黎明时宣布道士玩家死亡后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18370] = StringToText("· 醉酒");
    g_tipLine[18371] = StringToText("放置时机：在道士夜晚行动并选择了玩家后放置。");
    g_tipLine[18372] = StringToText("放置条件：如果道士选择的玩家是恶魔，则将此标记放置在恶魔玩家角色标记旁。如果此时道士醉酒中毒或无法死亡，");
    g_tipLine[18373] = StringToText("  则不放置该标记。");
    g_tipLine[18374] = StringToText("移除时机：在黎明时，或道士离场时。");
    g_tipLine[18375] = StringToText("【规则细节】");
    g_tipLine[18376] = StringToText("· 特定角色互动：");
    g_tipLine[18377] = StringToText("· 小怪宝：如果道士选中了照顾小怪宝的玩家，道士会死亡，该玩家醉酒。小怪宝的能力不会受到任何影响。");
    g_tipLine[18378] = StringToText("【背景故事】");
    g_tipLine[18379] = StringToText("“甘如醴，毒如砒。”");
    g_tipLine[18380] = StringToText("【角色能力】");
    g_tipLine[18381] = StringToText("每局游戏限一次，在夜晚时*，你可以选择一个镇民角色：如果他在场，他中毒并死亡。");
    g_tipLine[18382] = StringToText("【角色简介】");
    g_tipLine[18383] = StringToText("鸩可以冒着某个镇民死亡的风险来确认该镇民是否在场。");
    g_tipLine[18384] = StringToText("· 每局游戏限一次，除首个夜晚以外的其他夜晚，鸩可以选择一个镇民角色，如果那个角色在场，该角色对应的玩家会中毒并");
    g_tipLine[18385] = StringToText("  死亡。");
    g_tipLine[18386] = StringToText("· 如果鸩选择了一个不在场的角色，不会有任何玩家受到鸩的影响，即使之后被选择的角色在场了，他也不会受到鸩的影响。");
    g_tipLine[18387] = StringToText("· 如果某个角色有多名玩家在场，且鸩选择了这个角色，只会有一名玩家中毒并死亡。");
    g_tipLine[18388] = StringToText("【范例】");
    g_tipLine[18389] = StringToText("鸩选择了钟表匠，钟表匠中毒并死亡。");
    g_tipLine[18390] = StringToText("鸩选择了艺术家，艺术家不在场，没有人会因为鸩的能力中毒并死亡。");
    g_tipLine[18391] = StringToText("鸩选择了村夫，小王和小李是村夫，说书人决定小王中毒并死亡。");
    g_tipLine[18392] = StringToText("【运作方式】");
    g_tipLine[18393] = StringToText("除首个夜晚以外的每个夜晚，唤醒鸩。他要么摇头不使用能力，要么指向角色列表上一个镇民图标。让鸩重新入睡。");
    g_tipLine[18394] = StringToText("如果鸩使用了能力且该角色在场，对应的玩家中毒并死亡——依次用“中毒”和“死亡”提示标记标记那名玩家。");
    g_tipLine[18395] = StringToText("【提示标记】");
    g_tipLine[18396] = StringToText("· 中毒");
    g_tipLine[18397] = StringToText("放置时机：在鸩夜晚行动时选择使用能力，并选择了一个镇民角色后。");
    g_tipLine[18398] = StringToText("放置条件：放置在鸩所选择的那个镇民角色所对应的玩家的角色标记旁。");
    g_tipLine[18399] = StringToText("特殊说明：如果鸩选择的镇民角色不在场，或是鸩中毒或醉酒，将该标记倒转放置在鸩的的角色标记旁，");
    g_tipLine[18400] = StringToText("  用于标记鸩已经使用过能力。");
    g_tipLine[18401] = StringToText("移除时机：鸩死亡或离场时。");
    g_tipLine[18402] = StringToText("· 死亡");
    g_tipLine[18403] = StringToText("放置时机：在鸩夜晚行动时选择使用能力，并选择了一个镇民角色后。");
    g_tipLine[18404] = StringToText("放置条件：因为鸩的能力而会被杀死的玩家当前存活，且能被鸩杀死，且鸩未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[18405] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[18406] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18407] = StringToText("【规则细节】");
    g_tipLine[18408] = StringToText("· 如果鸩选择了自己，他会中毒但不会死亡。因为鸩先让自己中毒失去了能力，所以通常情况下鸩不会死于自己的能力。");
    g_tipLine[18409] = StringToText("  （特殊情况下，鸩可以死于自己的能力，比如咖啡师的效果1对鸩生效。）");
    g_tipLine[18410] = StringToText("· 相克规则：");
    g_tipLine[18411] = StringToText("· 罂粟种植者：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。");
    g_tipLine[18412] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[18413] = StringToText("· 半仙：如果鸩选择了半仙，半仙会中毒并死亡。");
    g_tipLine[18414] = StringToText("【背景故事】");
    g_tipLine[18415] = StringToText("“你须待到天黑再赶路，切莫让人发现你的肚子里都是稻草。”");
    g_tipLine[18416] = StringToText("【角色能力】");
    g_tipLine[18417] = StringToText("与你邻近的两名镇民玩家会在其首次死亡时被当作仍然存活。[-1外来者]");
    g_tipLine[18418] = StringToText("【角色简介】");
    g_tipLine[18419] = StringToText("赶尸人能将相邻的镇民变成活尸，让人们误以为他们还存活。");
    g_tipLine[18420] = StringToText("· 在设置阶段，如果赶尸人在场，则用一个未出场的镇民角色标记替换一个外来者标记，然后再让玩家随机抽取角色。");
    g_tipLine[18421] = StringToText("· 与赶尸人邻近的镇民在首次死亡时，会进入“活尸”状态。与穷奇的能力相似，该玩家在城镇广场上会表现出“存活”，");
    g_tipLine[18422] = StringToText("  然而实际上已经死亡。在这种情况下再次死亡，玩家在城镇广场上的状态也就会变成死亡状态。");
    g_tipLine[18423] = StringToText("· 只有能够死亡的玩家才能因为赶尸人的能力而进入“活尸”状态。如果玩家的死亡由于某些原因被阻止，");
    g_tipLine[18424] = StringToText("  他就不会进入“活尸”状态，而是正常存活（也不会因此算作他的“首次死亡”，赶尸人的能力能在他真正死亡的时候如常");
    g_tipLine[18425] = StringToText("  触发）。");
    g_tipLine[18426] = StringToText("· “活尸”状态下的玩家死亡时，相关的“死亡时触发的能力”不会触发，因为玩家在此之前已经进入了死亡状态（且之前进");
    g_tipLine[18427] = StringToText("  入死亡状态时，自身被当作存活而没有触发“死亡时触发的能力”）。而“得知自己死亡”的能力会正常触发，");
    g_tipLine[18428] = StringToText("  因为这些能力会持续保留到玩家“得知自己死亡”时。");
    g_tipLine[18429] = StringToText("· “活尸”状态与醉酒中毒相似：玩家会失去自身的能力，如果玩家的能力会让他自己获得信息，则有可能获得错误信息。");
    g_tipLine[18430] = StringToText("· “活尸”状态是一次性变化。即使之后赶尸人中毒醉酒或是死亡，又或者是“活尸”玩家的角色发生了变化且不再是镇民，");
    g_tipLine[18431] = StringToText("  “活尸”玩家在城镇广场上的状态依旧不会发生变化。但此时“活尸”玩家在参与能力互动时，不再被当作存活状态，");
    g_tipLine[18432] = StringToText("  而是处于死亡状态。");
    g_tipLine[18433] = StringToText("· 如果已经进入“活尸”状态的玩家变成了非镇民角色，赶尸人所能影响的玩家也会发生变化。此时会计算分别与他顺时针和");
    g_tipLine[18434] = StringToText("  逆时针两个方向上最近的镇民玩家，赶尸人的能力会对这些玩家生效。");
    g_tipLine[18435] = StringToText("【范例】");
    g_tipLine[18436] = StringToText("赶尸人的左侧是管家，再左侧是红唇女郎，再左侧是哲学家。他的右侧是旅店老板。白天，管家被处决，说书人宣布管家死亡。");
    g_tipLine[18437] = StringToText("  当晚，哲学家选择获得贤者的能力，随后恶魔攻击了哲学家。哲学家进入“活尸”状态，且失去能力。");
    g_tipLine[18438] = StringToText("  他的贤者能力不会因为恶魔的攻击而触发。");
    g_tipLine[18439] = StringToText("【运作方式】");
    g_tipLine[18440] = StringToText("每当与赶尸人邻近的镇民首次死亡时，该玩家进入“活尸”状态。在魔典中该玩家的角色标记上添加帷幕标记，");
    g_tipLine[18441] = StringToText("  但不要宣布该玩家已经死亡，也不要在城镇广场上将该玩家的生命标记翻面。当该玩家再次死亡时，正常宣布该玩家死亡，");
    g_tipLine[18442] = StringToText("  并在城镇广场上将该玩家的生命标记翻面。");
    g_tipLine[18443] = StringToText("【规则细节】");
    g_tipLine[18444] = StringToText("· 如果玩家因为某些效果“不会死亡”，如旅店老板的效果，则在他将要死亡时，不会受到赶尸人的效果影响。同样的，");
    g_tipLine[18445] = StringToText("  也不会因此被算作“首次死亡”。");
    g_tipLine[18446] = StringToText("· 特定角色互动：");
    g_tipLine[18447] = StringToText("· 守鸦人/贤者：“活尸”状态的守鸦人在夜晚转为死亡状态时，同样会被说书人唤醒并假装触发他的能力。");
    g_tipLine[18448] = StringToText("  这是因为守鸦人在玩家自身看来是在夜晚死亡的，满足守鸦人的能力的触发条件。如果恶魔导致了贤者从活尸转为死亡状态，");
    g_tipLine[18449] = StringToText("  同样也会触发贤者的唤醒。然而因为他们实际已经死亡，说书人可以提供错误信息。");
    g_tipLine[18450] = StringToText("· 弄臣：与赶尸人相邻，且未触发能力的弄臣在首次死亡时，会触发弄臣的能力，从而使得弄臣不会死亡。");
    g_tipLine[18451] = StringToText("  在弄臣再次死亡时，会正常受到赶尸人的能力影响，进入“活尸”状态。");
    g_tipLine[18452] = StringToText("· 相克规则：");
    g_tipLine[18453] = StringToText("· 瘟疫医生：如果说书人本应获得赶尸人的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[18454] = StringToText("【背景故事】");
    g_tipLine[18455] = StringToText("“这个是我的！……那个也是我的！”");
    g_tipLine[18456] = StringToText("【角色能力】");
    g_tipLine[18457] = StringToText("每个夜晚，你要选择一个镇民角色：他的能力会产生错误信息，直到下个黄昏。");
    g_tipLine[18458] = StringToText("【角色简介】");
    g_tipLine[18459] = StringToText("熊孩子顽皮捣蛋，会让特定的镇民角色产生错误信息。");
    g_tipLine[18460] = StringToText("· 每个夜晚，熊孩子需要选择一个镇民角色。如果这个角色在场，对应玩家会被熊孩子影响，在下个黄昏之前均会产生错误信");
    g_tipLine[18461] = StringToText("  息。");
    g_tipLine[18462] = StringToText("· 受到熊孩子能力影响的玩家如果醉酒中毒，仍然不会让其他玩家获得信息，因为他已经失去能力。");
    g_tipLine[18463] = StringToText("  然而他在获得因自己的能力而得知的信息时，也会受到熊孩子的能力影响而必定获得错误信息。");
    g_tipLine[18464] = StringToText("· 熊孩子不会影响这名玩家通过其他方式获得的信息，例如说书人的规则解释，他自身的角色/阵营，");
    g_tipLine[18465] = StringToText("  或是由其他玩家的能力使他得知的信息。");
    g_tipLine[18466] = StringToText("· 熊孩子影响的是具体角色所对应的玩家。仅仅是拥有这个角色能力，但实际角色并非熊孩子选择的角色的玩家，");
    g_tipLine[18467] = StringToText("  不会受到熊孩子能力的影响。");
    g_tipLine[18468] = StringToText("· 如果熊孩子选择的角色当前不在场，但随后在场了，这个角色所对应的玩家仍然要受到熊孩子的能力影响。");
    g_tipLine[18469] = StringToText("【范例】");
    g_tipLine[18470] = StringToText("熊孩子选择了正与两名邪恶玩家邻近的共情者。当晚，共情者得知了“0”。");
    g_tipLine[18471] = StringToText("熊孩子选择了卖花女孩。当晚，哲学家选择获得卖花女孩的能力，并获得了正确信息。而原本在场的卖花女孩因为哲学家醉酒，");
    g_tipLine[18472] = StringToText("  且受到熊孩子的影响，获得了错误信息。");
    g_tipLine[18473] = StringToText("【运作方式】");
    g_tipLine[18474] = StringToText("每个夜晚，唤醒熊孩子，让他指向角色列表上的一个镇民角色图标。让熊孩子重新入睡。");
    g_tipLine[18475] = StringToText("如果他指向的角色在场，在对应的角色标记旁放置“捣蛋”提示标记。");
    g_tipLine[18476] = StringToText("如果放置了“捣蛋”提示标记的玩家，其自身角色能力将要产生信息时，改为产生错误信息。");
    g_tipLine[18477] = StringToText("在下个黄昏时，移除“捣蛋”提示标记。");
    g_tipLine[18478] = StringToText("【提示标记】");
    g_tipLine[18479] = StringToText("· 捣蛋");
    g_tipLine[18480] = StringToText("放置时机：在熊孩子行动，并选择了一个镇民角色后。（或熊孩子选择的镇民角色在场后。）");
    g_tipLine[18481] = StringToText("放置条件：如果熊孩子清醒健康，则放置在熊孩子选择的角色标记旁。");
    g_tipLine[18482] = StringToText("移除时机：下个黄昏时，或熊孩子死亡或离场时。");
    g_tipLine[18483] = StringToText("【背景故事】");
    g_tipLine[18484] = StringToText("“杀我可以，不过我得死个明白——我到底死在谁的手里？”");
    g_tipLine[18485] = StringToText("【角色能力】");
    g_tipLine[18486] = StringToText("恶魔知道书生在场。每局游戏限一次，恶魔可以拜访说书人并猜测你是书生。如果恶魔猜测正确，即使你已死亡，");
    g_tipLine[18487] = StringToText("  当晚该恶魔可以选择一名玩家：他死亡。");
    g_tipLine[18488] = StringToText("【角色简介】");
    g_tipLine[18489] = StringToText("书生需要避免被恶魔发现。");
    g_tipLine[18490] = StringToText("· 恶魔会在自己的首个夜晚得知书生在场。");
    g_tipLine[18491] = StringToText("· 如果书生在游戏中途被创造，或有任何玩家获得了书生的能力，尚未得知“书生在场”的恶魔会在当晚得知书生在场。");
    g_tipLine[18492] = StringToText("· 只要恶魔得知过书生在场，便能在白天拜访说书人并进行猜测。在这种情况即使书生已经死亡，恶魔也能进行猜测，");
    g_tipLine[18493] = StringToText("  并在猜测正确时触发书生的能力效果。");
    g_tipLine[18494] = StringToText("· 如果一名已死亡的玩家变成了书生，恶魔不会因此得知书生在场，也无法进行猜测或触发书生的能力效果。");
    g_tipLine[18495] = StringToText("· 如果恶魔猜测正确，做出正确猜测的恶魔便能在当晚自己的行动结束后，额外导致一名玩家死亡。");
    g_tipLine[18496] = StringToText("  这一选择的时机最晚不能超过夜晚的“信息类角色行动开始”时机，详情参考夜晚行动顺序一览。");
    g_tipLine[18497] = StringToText("· 如果恶魔猜测正确，即使该恶魔随后被变成了非恶魔角色，依然能够使用书生的能力造成死亡。");
    g_tipLine[18498] = StringToText("· 书生的能力导致的死亡，不算作恶魔的攻击。那名玩家是由书生的能力导致的死亡，因此如果以这种方式杀死了一名爪牙，");
    g_tipLine[18499] = StringToText("  亡骨魔无法使得那名爪牙保留能力。如果执行书生能力的玩家是恶魔，那么仍然算作恶魔的负面能力。");
    g_tipLine[18500] = StringToText("· 如果场上有多名恶魔玩家，这些玩家共享一次猜测机会。任何恶魔使用了这次机会后，其他恶魔玩家的猜测都不会触发任何");
    g_tipLine[18501] = StringToText("  效果。他们不会知道自己的猜测是否正确，也不会知道是否有其他恶魔玩家在他之前进行了猜测并耗用了猜测的机会。");
    g_tipLine[18502] = StringToText("· 如果场上有多名书生或具有书生能力的角色，恶魔也只会有一次猜测机会。");
    g_tipLine[18503] = StringToText("【范例】");
    g_tipLine[18504] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，恶魔利用书生的能力杀死了贤者。贤者不会被唤醒并得知两名玩家，");
    g_tipLine[18505] = StringToText("  因为他并未死于恶魔之手。");
    g_tipLine[18506] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，旅店老板使得小明醉酒。当晚恶魔无法使用书生的能力进行攻击，");
    g_tipLine[18507] = StringToText("  且会误以为自己的猜测错误。");
    g_tipLine[18508] = StringToText("恶魔猜测小明是书生，且猜测正确。当晚，哲学家选择获得了书生的能力，小明因此醉酒且哲学家获得的书生能力并未被触发，");
    g_tipLine[18509] = StringToText("  所以恶魔不能使用书生的能力进行攻击。");
    g_tipLine[18510] = StringToText("【运作方式】");
    g_tipLine[18511] = StringToText("在首个夜晚，唤醒恶魔。对他展示书生角色标记。让恶魔重新入睡。");
    g_tipLine[18512] = StringToText("在白天时，恶魔可以私下拜访说书人并猜测谁是书生。如果此时还未有任何恶魔玩家猜测过且猜测正确，");
    g_tipLine[18513] = StringToText("  使用“已猜测”标记该恶魔玩家的角色标记。如果猜测错误，将“已猜测”放置于魔典正中央。");
    g_tipLine[18514] = StringToText("如果魔典中已放置“已猜测”标记，则无事发生。");
    g_tipLine[18515] = StringToText("在夜晚时，如果有任何玩家的角色标记旁有“已猜测”标记，则在该玩家自身的夜晚行动结束时（如果该玩家的行动会晚于信息");
    g_tipLine[18516] = StringToText("  类角色行动，则需要提前唤醒该玩家），对其展示书生角色标记，并让他选择一名玩家。标记那名玩家“死亡”，");
    g_tipLine[18517] = StringToText("  并将“已猜测”标记移动至魔典正中央。");
    g_tipLine[18518] = StringToText("在黎明时，如常宣布当晚的死亡情况。");
    g_tipLine[18519] = StringToText("【提示标记】");
    g_tipLine[18520] = StringToText("· 已猜测");
    g_tipLine[18521] = StringToText("放置时机：在一名恶魔玩家私下拜访说书人并进行猜测后。");
    g_tipLine[18522] = StringToText("放置条件：如果“已猜测”未放置在魔典中，则放置此标记。如果猜测正确，将其放在猜测正确的恶魔玩家角色标记旁。否则，");
    g_tipLine[18523] = StringToText("  将其放在魔典正中央。");
    g_tipLine[18524] = StringToText("移动时机：在被标记了“已猜测”的玩家夜晚使用书生的能力进行行动后，将其移动至魔典正中央。或当晚书生醉酒中毒，");
    g_tipLine[18525] = StringToText("  则直接移动到魔典正中央。");
    g_tipLine[18526] = StringToText("移除时机：游戏结束时，或书生离场时。");
    g_tipLine[18527] = StringToText("· 死亡");
    g_tipLine[18528] = StringToText("放置时机：在被标记了“已猜测”的玩家夜晚使用书生的能力进行行动并选择了玩家后放置。");
    g_tipLine[18529] = StringToText("放置条件：被选择的玩家当前存活且能被杀死，且书生未醉酒中毒，那么在该玩家的角色标记旁放置，");
    g_tipLine[18530] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[18531] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18532] = StringToText("【规则细节】");
    g_tipLine[18533] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[18534] = StringToText("· 戏子（改）：书生不会因为戏子（改）的能力醉酒。");
    g_tipLine[18535] = StringToText("【背景故事】");
    g_tipLine[18536] = StringToText("“王上，妾身有两个妹妹，一个名为喜媚，一个名为琵琶。”");
    g_tipLine[18537] = StringToText("【角色能力】");
    g_tipLine[18538] = StringToText("在你的首个夜晚，你要选择一名玩家：他会知道狐媚娘在场。如果你死于处决，当晚他转变为邪恶阵营。");
    g_tipLine[18539] = StringToText("【角色简介】");
    g_tipLine[18540] = StringToText("狐媚娘会魅惑她中意的玩家使其加入邪恶阵营……以自身死亡为代价。");
    g_tipLine[18541] = StringToText("· 在首个夜晚，狐媚娘需要选择一名玩家，该玩家会知道狐媚娘在场。");
    g_tipLine[18542] = StringToText("· 即使狐媚娘在选择玩家的时候醉酒中毒，一旦狐媚娘恢复清醒健康，她选择的玩家也会立即知道狐媚娘在场。");
    g_tipLine[18543] = StringToText("  （这个行为会发生在夜晚阶段，并且需要尽可能快地结算。）");
    g_tipLine[18544] = StringToText("· 如果狐媚娘死于处决（不论是因为常规的处决或是角色能力造成的处决），当晚，被狐媚娘选择的玩家会转变为邪恶阵营。");
    g_tipLine[18545] = StringToText("· 如果狐媚娘选择的玩家在狐媚娘死于处决时已经是邪恶阵营，则无事发生。");
    g_tipLine[18546] = StringToText("【范例】");
    g_tipLine[18547] = StringToText("狐媚娘选择了哲学家，哲学家知道狐媚娘在场。下一个白天，狐媚娘死于处决。当晚，哲学家转变为邪恶阵营。");
    g_tipLine[18548] = StringToText("醉酒的狐媚娘选择了炼金术士，炼金术士不知道狐媚娘在场。第二个夜晚，狐媚娘恢复清醒，炼金术士知道狐媚娘在场。");
    g_tipLine[18549] = StringToText("  下一个白天，狐媚娘死于处决。当晚，炼金术士转变为邪恶阵营。");
    g_tipLine[18550] = StringToText("狐媚娘选择了侍女，侍女知道狐媚娘在场。第二个夜晚，投毒者选择狐媚娘，下一个白天，狐媚娘死于处决。第三个夜晚，");
    g_tipLine[18551] = StringToText("  侍女没有转变为邪恶阵营。");
    g_tipLine[18552] = StringToText("【运作方式】");
    g_tipLine[18553] = StringToText("在狐媚娘的首个夜晚，唤醒狐媚娘，让其指向任意一名玩家。在该玩家角色标记旁放置“被魅惑”提示标记。");
    g_tipLine[18554] = StringToText("  让狐媚娘重新入睡。");
    g_tipLine[18555] = StringToText("唤醒狐媚娘所选玩家。向他展示“该角色的能力对你生效”信息标记，以及狐媚娘角色标记。让该玩家重新入睡。");
    g_tipLine[18556] = StringToText("一旦狐媚娘死于处决，在下个夜晚：");
    g_tipLine[18557] = StringToText("如果狐媚娘所选玩家是善良阵营，倒转放置该玩家的角色标记以提示他的阵营发生了变化，然后唤醒该玩家，");
    g_tipLine[18558] = StringToText("  对他做出相应的拇指手势（表明他现在是邪恶阵营），然后让该玩家重新入睡。");
    g_tipLine[18559] = StringToText("如果狐媚娘所选玩家是邪恶阵营，无事发生。");
    g_tipLine[18560] = StringToText("【提示标记】");
    g_tipLine[18561] = StringToText("· 被魅惑");
    g_tipLine[18562] = StringToText("放置时机：在狐媚娘夜晚行动并选择了玩家后。");
    g_tipLine[18563] = StringToText("放置条件：在狐媚娘选择的玩家角色标记旁放置。如果狐媚娘中毒醉酒，在魔典中将该标记倒置。");
    g_tipLine[18564] = StringToText("移除时机：狐媚娘死于处决，并在当晚狐媚娘行动顺序结束时移除（即使此时狐媚娘失去能力，也要移除），");
    g_tipLine[18565] = StringToText("  或在狐媚娘死亡或离场时移除。");
    g_tipLine[18566] = StringToText("【规则细节】");
    g_tipLine[18567] = StringToText("· 相克规则：");
    g_tipLine[18568] = StringToText("· 异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[18569] = StringToText("· 瘟疫医生：如果说书人本应获得狐媚娘的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[18570] = StringToText("【背景故事】");
    g_tipLine[18571] = StringToText("“有兽焉，其状如羊身人面，其目在腋下，虎齿人爪，其音如婴儿，名曰狍鸮，是食人。”");
    g_tipLine[18572] = StringToText("【角色能力】");
    g_tipLine[18573] = StringToText("每个夜晚*，你要选择任意数量的非旅行者玩家或一名旅行者玩家：如果他们的角色类型均不相同，他们死亡。[+1外来者]");
    g_tipLine[18574] = StringToText("【角色简介】");
    g_tipLine[18575] = StringToText("饕餮食量惊人，有的时候它会在夜里大肆杀戮来满足自己无尽的饥饿。");
    g_tipLine[18576] = StringToText("· 饕餮每个夜晚可以选择任意数量的非旅行者玩家。如果这些玩家之中没有任何两名玩家有相同的角色类型，");
    g_tipLine[18577] = StringToText("  那么这些玩家都会死亡。");
    g_tipLine[18578] = StringToText("· 饕餮可以不进行选择，这也视作选择了任意数量的玩家。");
    g_tipLine[18579] = StringToText("· 旅行者与其他非旅行者不属于同一角色类型。但是他们是无辜的！如果饕餮选择攻击一名旅行者，");
    g_tipLine[18580] = StringToText("  那么他当晚就不能再攻击其他玩家了。");
    g_tipLine[18581] = StringToText("· 在设置阶段，如果饕餮在场，则用一个未出场的外来者角色标记替换一个镇民标记，然后再让玩家随机抽取角色。");
    g_tipLine[18582] = StringToText("【范例】");
    g_tipLine[18583] = StringToText("在第二个夜晚，饕餮选择了占卜师、以为自己是守鸦人的酒鬼和刺客。这三名玩家死亡。");
    g_tipLine[18584] = StringToText("在第二个夜晚，饕餮选择了赌徒、筑梦师和博学者，由于他们都是镇民，因此无人死亡。");
    g_tipLine[18585] = StringToText("在第二个夜晚，饕餮选择了送葬者和莽夫。莽夫因为受到了饕餮的选择而使饕餮醉酒，所以无人死亡。");
    g_tipLine[18586] = StringToText("【运作方式】");
    g_tipLine[18587] = StringToText("除了首个夜晚以外的每个夜晚，唤醒饕餮。让饕餮选择任意数量的非旅行者玩家，或一名旅行者玩家。");
    g_tipLine[18588] = StringToText("  饕餮也可以摇头表示不做任何选择。如果饕餮进行了选择，并且这些玩家都属于不同的角色类型，");
    g_tipLine[18589] = StringToText("  那么这些玩家死亡（除非这些玩家受到其他原因影响导致不会死亡）。将“死亡”提示标记放置到这些玩家的角色标记旁。");
    g_tipLine[18590] = StringToText("【提示标记】");
    g_tipLine[18591] = StringToText("· 死亡");
    g_tipLine[18592] = StringToText("放置时机：在饕餮夜晚行动并选择了玩家后放置。");
    g_tipLine[18593] = StringToText("放置条件：饕餮选择的玩家不属于同一角色类型，当前存活，且能被饕餮杀死，且饕餮未醉酒中毒，那么在该玩家的角色标记旁");
    g_tipLine[18594] = StringToText("  放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[18595] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18596] = StringToText("【规则细节】");
    g_tipLine[18597] = StringToText("· 被饕餮攻击而死亡的玩家，其死亡顺序依照饕餮的选择顺序进行。如果饕餮导致了多名玩家死亡，");
    g_tipLine[18598] = StringToText("  且其中一名玩家的能力使得饕餮在死亡结算中途中毒或醉酒（比如心上人），那么后续的其他玩家就不会再死亡。");
    g_tipLine[18599] = StringToText("  （但这种情况极为少见，此处仅做举例说明，不意味着鼓励说书人这么做）");
    g_tipLine[18600] = StringToText("【背景故事】");
    g_tipLine[18601] = StringToText("“愚哉世人！明明妖也，而以为美。迷哉愚人！明明忠也，而以为妄。”");
    g_tipLine[18602] = StringToText("【角色能力】");
    g_tipLine[18603] = StringToText("在你的首个夜晚，你要选择一名存活玩家：他死亡但会被当作存活。");
    g_tipLine[18604] = StringToText("当他下一次即将死亡时，他重生，随后你重获能力。");
    g_tipLine[18605] = StringToText("【角色简介】");
    g_tipLine[18606] = StringToText("画皮迅速并秘密地进行攻击，神不知鬼不觉，时刻觊觎着下一个目标。");
    g_tipLine[18607] = StringToText("· 画皮在首个夜晚就会攻击一名玩家，但天亮后所有玩家都不会知道这件事，除了画皮自己。");
    g_tipLine[18608] = StringToText("· 画皮的攻击会让玩家进入“活尸”状态，该玩家在城镇广场上会表现出“存活”，然而实际上已经死亡。");
    g_tipLine[18609] = StringToText("· 因画皮能力而进入“活尸”状态下的玩家下一次即将死亡时，画皮会阻止这次死亡，并将他复活。画皮会重获能力，");
    g_tipLine[18610] = StringToText("  在当晚进行下一次秘密的攻击。");
    g_tipLine[18611] = StringToText("· 只有能够被画皮杀死的玩家才能因为画皮的攻击而进入“活尸”状态。如果玩家的死亡由于某些原因被阻止，");
    g_tipLine[18612] = StringToText("  他就不会进入“活尸”状态，而是正常存活。");
    g_tipLine[18613] = StringToText("· 如果被画皮选择的玩家因为任何原因仍然存活，当那名玩家下一次即将死亡时，画皮也能阻止这次死亡并试图复活那名玩家");
    g_tipLine[18614] = StringToText("  （尽管复活存活的玩家会导致无事发生），随后重获能力。");
    g_tipLine[18615] = StringToText("【范例】");
    g_tipLine[18616] = StringToText("首个夜晚，画皮选择了侍女，侍女进入“活尸”状态，当晚侍女选择了画皮和造谣者，但得知了“0”。");
    g_tipLine[18617] = StringToText("首个夜晚，画皮选择了士兵，士兵进入“活尸”状态；第三个夜晚，小恶魔攻击了士兵，士兵被复活了，");
    g_tipLine[18618] = StringToText("  画皮重获能力并选择了守鸦人，守鸦人进入“活尸”状态。");
    g_tipLine[18619] = StringToText("第二个夜晚，麻脸巫婆将男爵变成了画皮，随后画皮选择了僧侣；下一个白天，僧侣被处决并重生。当晚画皮重获能力并选择了");
    g_tipLine[18620] = StringToText("  哲学家。");
    g_tipLine[18621] = StringToText("【运作方式】");
    g_tipLine[18622] = StringToText("在画皮的首个夜晚，唤醒画皮，让其指向任意一名存活玩家，如果画皮选择的玩家能够成功被画皮杀死，");
    g_tipLine[18623] = StringToText("  那么画皮选择的玩家进入“活尸”状态。在魔典中该玩家的角色标记旁放置画皮的“以为存活”提示标记并放置帷幕标记，");
    g_tipLine[18624] = StringToText("  但不要在黎明时宣布该玩家已经死亡，也不要在城镇广场上将该玩家的生命标记翻面。");
    g_tipLine[18625] = StringToText("被放置“以为存活”提示标记的玩家下一次即将死亡时，该玩家再次变成存活状态——移除该玩家角色标记旁的“以为存活”提");
    g_tipLine[18626] = StringToText("  示标记，不要宣布该玩家死亡，并移除其帷幕标记，在画皮玩家角色标记旁放置“重获能力”提示标记。当晚，");
    g_tipLine[18627] = StringToText("  唤醒画皮使用其角色能力。");
    g_tipLine[18628] = StringToText("【提示标记】");
    g_tipLine[18629] = StringToText("· 以为存活");
    g_tipLine[18630] = StringToText("放置时机：在画皮夜晚行动并选择了玩家后放置。");
    g_tipLine[18631] = StringToText("放置条件：画皮选择的玩家能被画皮杀死，且画皮未醉酒中毒，那么在该玩家的角色标记旁放置。如果该玩家无法死亡或画皮醉");
    g_tipLine[18632] = StringToText("  酒中毒，该标记不会有任何效果，但你仍然需要放置该标记，用于提示被放置该标记的玩家即将死亡时触发画皮复活以及重");
    g_tipLine[18633] = StringToText("  获能力。魔典中将提示标记倒置，代表该提示标记没有任何效果，仅用于标记该玩家被画皮选择过。");
    g_tipLine[18634] = StringToText("移除时机：在画皮重获能力时，或画皮死亡或离场时。");
    g_tipLine[18635] = StringToText("· 重获能力");
    g_tipLine[18636] = StringToText("放置时机：在画皮复活了一名玩家后放置。");
    g_tipLine[18637] = StringToText("放置条件：画皮未醉酒中毒，在已放置有画皮的“以为存活”标记的玩家即将死亡时在画皮玩家的角色标记旁放置。");
    g_tipLine[18638] = StringToText("移除时机：在画皮夜晚行动并选择了玩家后移除。");
    g_tipLine[18639] = StringToText("【规则细节】");
    g_tipLine[18640] = StringToText("· “活尸”状态下的玩家下一次即将死亡时，如果画皮由于任何原因无法阻止这次死亡，那么画皮无法将他复活，");
    g_tipLine[18641] = StringToText("  也不会重获能力。通常情况下，这意味着画皮在接下来的游戏中将会毫无作用。");
    g_tipLine[18642] = StringToText("· 如果一名玩家在“活尸”状态已经使用过“每局游戏限一次”的能力，或者已经使用过“每局游戏限一次”的能力之后再进");
    g_tipLine[18643] = StringToText("  入“活尸”状态，即使画皮将他复活，该玩家也无法再次使用“每局游戏限一次”的能力。");
    g_tipLine[18644] = StringToText("· 特定角色互动：");
    g_tipLine[18645] = StringToText("· 红唇女郎：如果画皮选择了恶魔，通常情况下，游戏会因为场上没有存活恶魔而立即结束。即使场上有红唇女郎，");
    g_tipLine[18646] = StringToText("  也会把恶魔当作存活玩家从而不触发红唇女郎的能力。");
    g_tipLine[18647] = StringToText("【背景故事】");
    g_tipLine[18648] = StringToText("“船缓难行，有不洁之气。”");
    g_tipLine[18649] = StringToText("【角色能力】");
    g_tipLine[18650] = StringToText("每个夜晚，你要选择除你以外的至多三名玩家：你会得知今晚是否有邪恶玩家的能力选择或影响了他们之中的玩家。");
    g_tipLine[18651] = StringToText("【角色简介】");
    g_tipLine[18652] = StringToText("引路人能够得知夜晚是否有邪恶作祟，侵扰玩家。");
    g_tipLine[18653] = StringToText("· 每个夜晚，引路人都可以选择一至三名玩家，但不能不进行选择，也不能选择自己。");
    g_tipLine[18654] = StringToText("· 如果引路人选择的玩家中没有在当晚被邪恶玩家的能力选择或影响，引路人会得知“否”。");
    g_tipLine[18655] = StringToText("· 如果引路人选择的玩家中在当晚被邪恶玩家能力选择或者影响，引路人会得知“是”。如果引路人选择了超过一名玩家，");
    g_tipLine[18656] = StringToText("  他不会得知是具体哪名玩家被邪恶玩家能力选择或者影响了。");
    g_tipLine[18657] = StringToText("· 不仅邪恶的爪牙、恶魔能力会被引路人探查，邪恶的镇民、外来者能力也会被引路人探查。");
    g_tipLine[18658] = StringToText("【范例】");
    g_tipLine[18659] = StringToText("引路人选择了占卜师、共情者和男爵，他们今晚都没有被邪恶玩家选择或影响，引路人得知“否”。");
    g_tipLine[18660] = StringToText("麻脸巫婆将洗脑师变成了邪恶的舞蛇人，舞蛇人选择了士兵，引路人选择了士兵，并得知“是”。");
    g_tipLine[18661] = StringToText("首个夜晚，普卡选择了呆瓜。下个夜晚，僧侣选择了呆瓜，普卡选择了修补匠，随后引路人选择了呆瓜，并得知“是”。");
    g_tipLine[18662] = StringToText("【运作方式】");
    g_tipLine[18663] = StringToText("每个夜晚，唤醒引路人，让引路人指向除自己以外任意一至三名玩家，如果引路人选择的玩家中有任何玩家在当晚被邪恶玩家的");
    g_tipLine[18664] = StringToText("  能力选择或影响过，对引路人点头表示“是”。否则，摇头表示“否”。让引路人重新入睡。");
    g_tipLine[18665] = StringToText("【提示标记】");
    g_tipLine[18666] = StringToText("无");
    g_tipLine[18667] = StringToText("【规则细节】");
    g_tipLine[18668] = StringToText("“影响”的范围包括：改变该玩家的状态（角色、阵营等），对该玩家的能力造成了妨害效果（互动干扰、能力效果干扰、");
    g_tipLine[18669] = StringToText("  阻止能力生效等），等等。暴露角色、让他人获取信息等能力不在“影响”的范围内。");
    g_tipLine[18670] = StringToText("与“保护”类似，如果邪恶玩家执行了善良玩家的能力产生选择或影响，同样会被引路人探查。");
    g_tipLine[18671] = StringToText("· 特定角色互动：");
    g_tipLine[18672] = StringToText("· 小怪宝：如果一名邪恶玩家照顾了小怪宝，当晚因小怪宝能力死亡的玩家算作被邪恶玩家的能力影响了。");
    g_tipLine[18673] = StringToText("· 相克规则：");
    g_tipLine[18674] = StringToText("· 侍女：侍女会得知引路人是否醒来，即使她是在引路人之前醒来。");
    g_tipLine[18675] = StringToText("· 数学家：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。");
    g_tipLine[18676] = StringToText("【背景故事】");
    g_tipLine[18677] = StringToText("“岭海滞公犹未召，蛮荒著我更何尤。”");
    g_tipLine[18678] = StringToText("【角色能力】");
    g_tipLine[18679] = StringToText("每个夜晚限一次，一名玩家在使用自身能力选择邪恶玩家时会改为选中你，即使你已死亡。");
    g_tipLine[18680] = StringToText("【角色简介】");
    g_tipLine[18681] = StringToText("使节远离家乡来到陌生的地方，因此容易成为他人欺凌的对象。");
    g_tipLine[18682] = StringToText("· 在每个夜晚，使节的能力能够触发最多一次。使节的能力可以连续在多个夜晚都触发，也可能会连续几个夜晚都不触发。");
    g_tipLine[18683] = StringToText("  由说书人来决定使节的能力触发与否。");
    g_tipLine[18684] = StringToText("· 只要有玩家在使用自身能力选择了邪恶玩家，且使节的能力当晚还未触发，说书人就可以决定触发使节的能力让该玩家的选");
    g_tipLine[18685] = StringToText("  择目标改为使节。");
    g_tipLine[18686] = StringToText("· 如果使节的能力在当晚已经被触发过一次了，那么之后有其他玩家使用能力进行选择时，就无法再被使节影响。");
    g_tipLine[18687] = StringToText("【范例】");
    g_tipLine[18688] = StringToText("占卜师选择了女裁缝和恶魔，说书人决定触发使节的能力，使占卜师改为选择女裁缝和使节。占卜师得知了“否”。");
    g_tipLine[18689] = StringToText("麻脸巫婆选择将邪恶的舞蛇人变成亡骨魔，说书人决定不触发使节的能力。随后，洗脑师选择让自己“疯狂”地证明自己是贤者，");
    g_tipLine[18690] = StringToText("  说书人决定触发使节的能力，使节需要在下个白天和夜晚“疯狂”地证明自己是贤者，否则他可能会被处决。");
    g_tipLine[18691] = StringToText("【运作方式】");
    g_tipLine[18692] = StringToText("在每个夜晚，任何玩家使用自身能力选择了目标，其中包含邪恶玩家，且使节的“已触发”提示标记还未放置时，");
    g_tipLine[18693] = StringToText("  说书人可以决定将这项能力其中一个目标从邪恶玩家改为使节。然后，在使节的角色标记旁放置“已触发”提示标记。");
    g_tipLine[18694] = StringToText("在黎明时，移除“已触发”提示标记。");
    g_tipLine[18695] = StringToText("【提示标记】");
    g_tipLine[18696] = StringToText("· 已触发");
    g_tipLine[18697] = StringToText("放置时机：夜晚说书人决定触发使节的能力时放置。");
    g_tipLine[18698] = StringToText("放置条件：放置在使节的角色标记旁。");
    g_tipLine[18699] = StringToText("移除时机：在黎明时，或使节离场时。");
    g_tipLine[18700] = StringToText("【规则细节】");
    g_tipLine[18701] = StringToText("· 相克规则：");
    g_tipLine[18702] = StringToText("· 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[18703] = StringToText("【背景故事】");
    g_tipLine[18704] = StringToText("“平时里见他，要么浑身污垢满嘴臭味，要么疯言疯行不知所云。”");
    g_tipLine[18705] = StringToText("【角色能力】");
    g_tipLine[18706] = StringToText("任何在夜晚使用自身能力选择你的其他玩家，会改为选中另一名邪恶玩家作为替代。");
    g_tipLine[18707] = StringToText("【角色简介】");
    g_tipLine[18708] = StringToText("半仙精通各种怪力乱神之术，能够将对他潜在的威胁转移到邪祟之人的身上。");
    g_tipLine[18709] = StringToText("· 在夜晚时，任何使用自身能力选择半仙的玩家，在其能力生效前，选择的目标会暗中转移到一名邪恶玩家的身上。随后，");
    g_tipLine[18710] = StringToText("  这项能力效果会以那名邪恶玩家作为新的目标来进行结算。");
    g_tipLine[18711] = StringToText("· 使用能力选择半仙的玩家不会得知自己的选择目标被更改，半仙也不会得知自己的能力被触发。");
    g_tipLine[18712] = StringToText("· 只有需要做出选择的能力才能被半仙转移目标。无需进行选择的能力，无法被半仙转移目标。");
    g_tipLine[18713] = StringToText("· 在一项能力更换目标后，无需重新进行选择限制条件的判断。舞蛇人的选择目标可能会因此改为已经死亡的邪恶玩家，");
    g_tipLine[18714] = StringToText("  魔鬼代言人的选择目标可能会改为选中自己。");
    g_tipLine[18715] = StringToText("· 在一项能力更换目标后，需要重新进行能力效果中触发条件的判断。传教士因为半仙而改为选中恶魔时，");
    g_tipLine[18716] = StringToText("  不会让恶魔失去能力，因为恶魔与爪牙是不同的角色类型。");
    g_tipLine[18717] = StringToText("· 一项能力在更换选择目标后，能力自身与选择相关的内容不会因此发生变更，依然以玩家自身做出的选择作为判断基准。");
    g_tipLine[18718] = StringToText("  魔鬼代言人在选择半仙后导致目标转移，他在第二晚无法选择半仙，而不是无法选择转移后的目标。");
    g_tipLine[18719] = StringToText("  管家在选择主人时目标被变更，管家在下个白天投票时仍然需要参考他昨晚选择的那名玩家的投票意见，不会受到影响。");
    g_tipLine[18720] = StringToText("· 如果一项能力需要玩家选择多个目标，而半仙成为了目标之一，那么半仙只会将自己更改为一名邪恶玩家，");
    g_tipLine[18721] = StringToText("  不会使得玩家的其他目标发生变化。半仙也不会让一项能力的多个目标中重复选择同一名玩家。如果此时没有其他合法的目");
    g_tipLine[18722] = StringToText("  标可以转移选择，那么半仙仍然会受到原本能力效果的影响。");
    g_tipLine[18723] = StringToText("· 一项能力中的某个选择目标至多只能被转移一次。也就是说，被半仙转移后的目标，无法受到使节的影响使得目标再次转移。");
    g_tipLine[18724] = StringToText("  ");
    g_tipLine[18725] = StringToText("· 半仙的能力只会在夜晚被触发。在白天时，他的能力不会产生任何效果。");
    g_tipLine[18726] = StringToText("【范例】");
    g_tipLine[18727] = StringToText("占卜师选择了半仙和红唇女郎，半仙的能力使得占卜师的目标变为小恶魔和红唇女郎。占卜师得知了“是”。");
    g_tipLine[18728] = StringToText("魔鬼代言人选择让自己处决不死。在第二个夜晚，魔鬼代言人选择了半仙，说书人将目标变成了魔鬼代言人自己。");
    g_tipLine[18729] = StringToText("  魔鬼代言人继续受到处决不死的保护，且能够在下一个夜晚继续选择保护自己，因为他上一次选择的玩家是半仙。");
    g_tipLine[18730] = StringToText("精神病患者攻击了半仙，半仙死亡，因为他的能力在白天无法被触发。");
    g_tipLine[18731] = StringToText("【运作方式】");
    g_tipLine[18732] = StringToText("每个夜晚，如果有任何玩家使用自身能力选择了半仙，则将选择目标改为任意一名邪恶玩家，再执行能力效果的相关结算。");
    g_tipLine[18733] = StringToText("  无需为新的目标进行角色能力中冒号“：”之前的部分的条件判断，直接执行冒号之后的效果。");
    g_tipLine[18734] = StringToText("【规则细节】");
    g_tipLine[18735] = StringToText("· 特定角色互动：");
    g_tipLine[18736] = StringToText("· 刺客：如果刺客攻击了半仙，半仙会直接死亡，并且不会将刺客的效果转移到邪恶玩家身上。");
    g_tipLine[18737] = StringToText("· 恐惧之灵：如果恐惧之灵选择了半仙，是否播报能力取决于半仙转移结果的玩家是否与恐惧之灵之前的选择发生了变化。");
    g_tipLine[18738] = StringToText("  被半仙转移后，恐惧之灵的能力只会对转移后的目标生效（从某种意义上来说，也算是无效了，因为恐惧之灵的能力此时只");
    g_tipLine[18739] = StringToText("  能让邪恶阵营落败）。恐惧之灵需要通过播报与否来判断自己是否选中了半仙。");
    g_tipLine[18740] = StringToText("· 和尚：如果半仙与和尚为邻座，且有邪恶玩家的能力选择了半仙，在和尚的能力生效前，半仙会先将选择目标转移，");
    g_tipLine[18741] = StringToText("  从而使得邪恶玩家既不会选择半仙为目标，也不会影响半仙，因此不会触发和尚的能力。反之，如果半仙将邪恶玩家的选择");
    g_tipLine[18742] = StringToText("  转移到与和尚邻近的一名邪恶玩家，和尚的能力就会因此被触发。");
    g_tipLine[18743] = StringToText("· 相克规则：");
    g_tipLine[18744] = StringToText("· 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[18745] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[18746] = StringToText("· 鸩：如果鸩选择了半仙，半仙会中毒并死亡。");
    g_tipLine[18747] = StringToText("【背景故事】");
    g_tipLine[18748] = StringToText("“买卖不成情义在。”");
    g_tipLine[18749] = StringToText("【角色能力】");
    g_tipLine[18750] = StringToText("每个夜晚，你要选择两名存活玩家：如果他们阵营相同，今晚任何玩家使用自身能力选择他们之一作为目标时，");
    g_tipLine[18751] = StringToText("  改为选中另一名玩家。");
    g_tipLine[18752] = StringToText("【角色简介】");
    g_tipLine[18753] = StringToText("掮客促成两名阵营相同的玩家的合作，使得其他玩家的选择被转换。");
    g_tipLine[18754] = StringToText("· 在夜晚时，掮客选择的两名存活玩家如果阵营相同，任何玩家使用自身能力选择他们之一时，在其能力生效前，");
    g_tipLine[18755] = StringToText("  选择的目标会转移到另一名玩家的身上。随后，这项能力效果会以另一名玩家作为新的目标来结算。");
    g_tipLine[18756] = StringToText("· 如果掮客选择的两名存活玩家阵营不相同，那么，任何玩家使用自身能力选择他们之一作为目标时，不会发生转移。");
    g_tipLine[18757] = StringToText("· 使用能力被掮客转移目标的玩家不会得知自己的选择目标被更换。掮客也不会得知是否有玩家因此被转移了选择的目标。");
    g_tipLine[18758] = StringToText("· 只有需要玩家做出选择的能力才能被掮客转移目标。无需进行选择的能力，无法被掮客转移目标。");
    g_tipLine[18759] = StringToText("· 掮客的能力只会在夜晚生效。在白天时，他的能力不会产生任何效果。");
    g_tipLine[18760] = StringToText("【范例】");
    g_tipLine[18761] = StringToText("掮客选择了守鸦人和艺术家。恶魔攻击了艺术家，守鸦人死亡并触发了自己的能力。");
    g_tipLine[18762] = StringToText("魔鬼代言人选择让自己处决不死。在第二个夜晚，掮客选择了魔鬼代言人和珀。魔鬼代言人选择了珀。");
    g_tipLine[18763] = StringToText("  魔鬼代言人继续受到处决不死的保护，且能够在下一个夜晚继续选择保护自己，因为他上一次选择的玩家是珀。");
    g_tipLine[18764] = StringToText("掮客选择了陌客和厨师。小恶魔攻击了厨师，说书人决定让陌客被当作邪恶阵营从而不触发掮客的转移目标效果，厨师死亡了。");
    g_tipLine[18765] = StringToText("【运作方式】");
    g_tipLine[18766] = StringToText("每个夜晚，唤醒掮客。让掮客指向任意两名存活玩家。让掮客重新入睡。如果这两名玩家阵营相同，将“熟客”提示标记放置到");
    g_tipLine[18767] = StringToText("  所选的两名玩家的角色标记旁。今晚，任何玩家使用自身能力选择他们之一作为目标时，改为选中另一名玩家。");
    g_tipLine[18768] = StringToText("【提示标记】");
    g_tipLine[18769] = StringToText("· 熟客（共2枚）");
    g_tipLine[18770] = StringToText("放置时机：在掮客夜晚行动并选择了玩家后。");
    g_tipLine[18771] = StringToText("放置条件：如果掮客选择的玩家阵营相同，在这两名玩家的角色标记旁分别各放置一个此标记。若此时掮客醉酒中毒，");
    g_tipLine[18772] = StringToText("  不放置该标记。");
    g_tipLine[18773] = StringToText("移除时机：在黄昏时，或掮客死亡或离场时。");
    g_tipLine[18774] = StringToText("特殊说明：由于掮客的能力是持续检测，当熟客的阵营不同时，也会移除熟客标记。");
    g_tipLine[18775] = StringToText("【规则细节】");
    g_tipLine[18776] = StringToText("· 掮客会持续检测被选择的玩家的阵营，一旦他们当中出现了阵营变化导致这两名玩家阵营不同，掮客会立即失去对这两名玩");
    g_tipLine[18777] = StringToText("  家更换选择目标的能力。");
    g_tipLine[18778] = StringToText("· 更多规则与细节详情请查看更换选择目标。");
    g_tipLine[18779] = StringToText("· 特定角色互动：");
    g_tipLine[18780] = StringToText("· 刺客：如果刺客攻击了掮客选择的玩家，那名玩家会直接死亡，并不会将刺客的效果转移到另一名玩家身上。");
    g_tipLine[18781] = StringToText("· 相克规则：");
    g_tipLine[18782] = StringToText("· 痢蛭：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[18783] = StringToText("【背景故事】");
    g_tipLine[18784] = StringToText("“客官，再饮一杯吧。”");
    g_tipLine[18785] = StringToText("【角色能力】");
    g_tipLine[18786] = StringToText("与你邻近的善良玩家（旅行者除外）之一醉酒，即使你死于处决。");
    g_tipLine[18787] = StringToText("【角色简介】");
    g_tipLine[18788] = StringToText("酒保会使邻近的一名善良玩家醉酒。");
    g_tipLine[18789] = StringToText("· 由说书人选择哪名善良玩家醉酒，无论这名善良玩家是存活还是死亡。");
    g_tipLine[18790] = StringToText("· 酒保的醉酒效果会跳过与他相邻的邪恶玩家。酒保的醉酒效果不会对旅行者生效。");
    g_tipLine[18791] = StringToText("· 这项能力当酒保死于处决时仍会保留。如果酒保因为非处决的原因而死亡时，醉酒将会解除。");
    g_tipLine[18792] = StringToText("· 如果有玩家成为新的酒保，或一个醉酒的善良玩家转为了邪恶，都会根据新的位置关系立刻改变醉酒的玩家。");
    g_tipLine[18793] = StringToText("【范例】");
    g_tipLine[18794] = StringToText("酒保的邻近玩家是占卜师和修行者。占卜师现在醉酒了，并可能在夜晚得知错误信息。");
    g_tipLine[18795] = StringToText("酒保今天死于处决了。与酒保邻近的送葬者仍然醉酒，当晚送葬者被展示了投毒者标记。");
    g_tipLine[18796] = StringToText("酒保邻近的共情者醉酒了。恶魔当晚杀死了酒保，共情者恢复清醒，当晚共情者获得了正确的信息。");
    g_tipLine[18797] = StringToText("酒保邻近的镇长醉酒了，该方向上的下一名玩家是侍女。白天，镇长说出了灵言师的关键词。当晚，镇长转为了邪恶并恢复清醒，");
    g_tipLine[18798] = StringToText("  侍女现在因为酒保的能力而醉酒。");
    g_tipLine[18799] = StringToText("【运作方式】");
    g_tipLine[18800] = StringToText("在为首个夜晚进行准备时，让一名与酒保邻近的善良玩家（旅行者除外）醉酒——在他的角色标记旁放置“醉酒”标记。");
    g_tipLine[18801] = StringToText("如果酒保死于处决了，那么“醉酒”标记不会被移除。如果酒保因为非处决的原因死亡了，立即移除“醉酒”标记。");
    g_tipLine[18802] = StringToText("如果一名被酒保影响的善良玩家转为了邪恶，或者酒保变成了另一个角色，或者如果一个新的玩家变成了酒保，");
    g_tipLine[18803] = StringToText("  都会让与酒保现在邻近的善良玩家之一醉酒，而之前邻近但现在不邻近的善良玩家恢复清醒。");
    g_tipLine[18804] = StringToText("【提示标记】");
    g_tipLine[18805] = StringToText("· 醉酒");
    g_tipLine[18806] = StringToText("放置时机：在为首个夜晚做准备时放置，或有新的酒保出现时立即放置。");
    g_tipLine[18807] = StringToText("放置条件：放置在与酒保邻近的善良玩家（旅行者除外）之一的角色标记旁。");
    g_tipLine[18808] = StringToText("特殊说明：动态检测会检查酒保及与其邻近的因酒保能力而醉酒的善良玩家是哪些玩家。一旦酒保及其邻近的因酒保能力而醉酒");
    g_tipLine[18809] = StringToText("  的善良玩家的座次或阵营发生变化，就需要移动“醉酒”标记至满足条件的玩家角色标记旁（不会因此将“醉酒\"标记替换");
    g_tipLine[18810] = StringToText("  到酒保玩家的另一侧去）。");
    g_tipLine[18811] = StringToText("移除时机：酒保因为非处决的原因死亡或离场时移除。");
    g_tipLine[18812] = StringToText("【背景故事】");
    g_tipLine[18813] = StringToText("“本来无一物，何处惹尘埃。”");
    g_tipLine[18814] = StringToText("【角色能力】");
    g_tipLine[18815] = StringToText("每个夜晚，当有邪恶玩家的能力首次选择或影响与你邻近的存活玩家时，改为此次能力不生效并持续至下个黎明，");
    g_tipLine[18816] = StringToText("  且你会得知你的能力被触发。");
    g_tipLine[18817] = StringToText("【角色简介】");
    g_tipLine[18818] = StringToText("和尚慈悲为怀，一视同仁地庇护着他周围的人。");
    g_tipLine[18819] = StringToText("· 和尚的能力在每个夜晚都能且仅能触发一次。");
    g_tipLine[18820] = StringToText("· 当邪恶玩家的能力选择了与和尚邻近的存活玩家，或者一项无需选择的能力在满足了条件而被触发，");
    g_tipLine[18821] = StringToText("  且会对与和尚邻近的存活玩家生效时，和尚会使邪恶玩家此次的能力不生效。这一效果跟使这名玩家“中毒/醉酒”相似。");
    g_tipLine[18822] = StringToText("  然而，如果某名邪恶玩家在同一个夜晚可以多次行动，和尚只能使其中一次效果无效，而除此以外的其他效果仍然会正常生");
    g_tipLine[18823] = StringToText("  效。");
    g_tipLine[18824] = StringToText("· 如果邪恶玩家的能力是一项持续生效的能力，而非选择式或触发式的能力，和尚会使这项能力失效直至下个黎明。");
    g_tipLine[18825] = StringToText("  在下一个白天时，这项能力会再次生效。");
    g_tipLine[18826] = StringToText("· 和尚只能在一项能力开始生效前阻止这项能力。他无法阻止已经生效的能力。");
    g_tipLine[18827] = StringToText("· 一旦和尚的能力被成功触发，他会被唤醒，并得知自己的能力刚刚被触发了。和尚不会得知是哪名邪恶玩家的能力被他阻止");
    g_tipLine[18828] = StringToText("  了，也不会得知这项能力影响的是与他邻近的哪一名玩家。他只是单纯知道自己的能力被触发了。");
    g_tipLine[18829] = StringToText("· 如果一项邪恶玩家的能力无法被阻止，那么和尚的能力不会因此被触发，和尚也不会得知自己的能力触发了。");
    g_tipLine[18830] = StringToText("【范例】");
    g_tipLine[18831] = StringToText("小恶魔自杀了。与和尚邻近的男爵受到和尚的能力影响，无法变成小恶魔。因为场上没有存活的恶魔，游戏结束，");
    g_tipLine[18832] = StringToText("  善良阵营获胜。");
    g_tipLine[18833] = StringToText("刺客使用自己的能力攻击了与和尚邻近的弄臣。弄臣死亡，且和尚不会得知自己的能力被触发了。");
    g_tipLine[18834] = StringToText("与和尚间隔了哲学家的舞蛇人选中了诺-达鲺，并与之交换了角色和阵营。和尚的能力被触发，诺-达鲺邻近的两名镇民（包括");
    g_tipLine[18835] = StringToText("  哲学家）没有因此中毒。诺-达鲺的中毒能力失效，但他仍然可以在当晚选择一名玩家攻击，并成功杀死那名玩家。");
    g_tipLine[18836] = StringToText("  在下个白天，诺-达鲺的中毒能力再次生效，哲学家中毒。");
    g_tipLine[18837] = StringToText("【运作方式】");
    g_tipLine[18838] = StringToText("在每个夜晚，如果有邪恶玩家的能力选择或即将影响与和尚邻近的存活玩家，且和尚的角色标记旁尚未放置“已生效”提示标记，");
    g_tipLine[18839] = StringToText("  那么这项能力无效。将和尚的“已生效”提示标记放置在和尚的角色标记旁。如果这项能力是一项非持续能力，");
    g_tipLine[18840] = StringToText("  能力直接失效，但邪恶玩家的其他能力仍然能正常使用。如果这项能力是一项持续能力，能力会在下一个白天重新生效。");
    g_tipLine[18841] = StringToText("  随后，唤醒和尚，对他展示和尚角色标记。让和尚重新入睡。");
    g_tipLine[18842] = StringToText("在黎明时，移除“已生效”提示标记。");
    g_tipLine[18843] = StringToText("【提示标记】");
    g_tipLine[18844] = StringToText("· 已生效");
    g_tipLine[18845] = StringToText("放置时机：每个夜晚，与和尚邻近的存活玩家第一次被其他邪恶玩家使用能力影响或选择时。");
    g_tipLine[18846] = StringToText("放置条件：放置在和尚的角色标记旁。如果和尚中毒醉酒，倒置该标记表示该标记没有效果，用于提示当晚和尚的能力已经触发");
    g_tipLine[18847] = StringToText("  过。");
    g_tipLine[18848] = StringToText("移除时机：在黎明时，或和尚死亡或离场时。");
    g_tipLine[18849] = StringToText("【规则细节】");
    g_tipLine[18850] = StringToText("· 如果和尚的能力使得一项“玩家让自身获得信息”的能力失效，其处理方式与醉酒中毒相似，该玩家仍然会获得信息，");
    g_tipLine[18851] = StringToText("  但信息可对可错。");
    g_tipLine[18852] = StringToText("· 特定角色互动：");
    g_tipLine[18853] = StringToText("· 诺-达鲺：如果在游戏开始时，诺-达鲺的中毒影响了与和尚邻近的镇民，和尚的能力在首个夜晚不会触发。");
    g_tipLine[18854] = StringToText("  如果诺-达鲺在游戏中途的某个夜晚被创造并将要影响与和尚邻近的镇民，和尚的能力会被触发，");
    g_tipLine[18855] = StringToText("  诺-达鲺的中毒能力（包括让另一侧的镇民中毒）会在下个黎明才开始生效。");
    g_tipLine[18856] = StringToText("· 限：如果限的能力让所有镇民中毒，和尚会因中毒而无法触发能力。");
    g_tipLine[18857] = StringToText("· 混沌：如果混沌的能力让所有善良玩家中毒，（善良的）和尚会因中毒而无法触发能力。");
    g_tipLine[18858] = StringToText("· 相克规则：");
    g_tipLine[18859] = StringToText("· 利维坦：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[18860] = StringToText("· 暴乱：如果暴乱提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_tipLine[18861] = StringToText("【角色能力】");
    g_tipLine[18862] = StringToText("每个夜晚，你会得知顺时针方向上的下一名存活的镇民玩家的角色，他中毒且可能被当作邪恶的蛊雕，直到下个黄昏。");
    g_tipLine[18863] = StringToText("每局游戏限一次，在夜晚时，你可以改变方向。");
    g_tipLine[18864] = StringToText("【角色简介】");
    g_tipLine[18865] = StringToText("蛊雕停留在镇民之中。");
    g_tipLine[18866] = StringToText("· 每个夜晚，蛊雕都会得知顺时针方向上的下一名存活的镇民玩家的角色。其他角色类型的玩家，或是已经死亡的玩家，");
    g_tipLine[18867] = StringToText("  都会被蛊雕跳过。");
    g_tipLine[18868] = StringToText("· 被蛊雕得知的玩家中毒且可能被当作邪恶的蛊雕，直到下个黄昏。这代表着其他玩家可能当作他是邪恶的蛊雕，");
    g_tipLine[18869] = StringToText("  也可能会是原本的阵营和角色，这取决于说书人。");
    g_tipLine[18870] = StringToText("· 蛊雕可以改变方向一次。如果蛊雕这么做了，代表蛊雕得知的玩家不再是顺时针方向上的下一名玩家，");
    g_tipLine[18871] = StringToText("  而是逆时针方向上的。蛊雕会因此得知曾得知过的角色。");
    g_tipLine[18872] = StringToText("【范例】");
    g_tipLine[18873] = StringToText("蛊雕、士兵、修行者、异教领袖、刺客顺时针连坐。第一个夜晚，蛊雕得知了士兵且士兵中毒了。异教领袖转变为了邪恶阵营。");
    g_tipLine[18874] = StringToText("  第一个白天，修行者死于处决了。第二个夜晚，蛊雕得知了异教领袖。异教领袖中毒了且不能因自身能力转变阵营。");
    g_tipLine[18875] = StringToText("游戏的首个夜晚，蛊雕让侍女中毒了。调查员得知侍女和占卜师里有蛊雕。村夫选择了侍女并得知了“邪恶”。");
    g_tipLine[18876] = StringToText("游戏的第一个和第二个夜晚，蛊雕都没有改变方向，并依次得知了共情者和报丧女妖。游戏的第三个夜晚，蛊雕选择改变方向，");
    g_tipLine[18877] = StringToText("  并得知了共情者。");
    g_tipLine[18878] = StringToText("【运作方式】");
    g_tipLine[18879] = StringToText("在为首个夜晚进行准备时，将“蛊毒”提示标记放置在蛊雕的角色标记旁。");
    g_tipLine[18880] = StringToText("每个夜晚，唤醒蛊雕。他要么摇头不改变方向，要么点头改变方向。");
    g_tipLine[18881] = StringToText("如果他摇头，将“蛊毒”提示标记放置在顺时针方向上的下一名存活镇民角色标记旁。如果他点头，在蛊雕角色标记旁放置“改");
    g_tipLine[18882] = StringToText("  变方向”提示标记，随后将“蛊毒”提示标记放置在逆时针方向上的下一名存活镇民角色标记旁，");
    g_tipLine[18883] = StringToText("  之后蛊雕无需再对说书人点头或摇头。");
    g_tipLine[18884] = StringToText("随后，将放置着“蛊毒”提示标记的角色标记展示给蛊雕。让蛊雕重新入睡。");
    g_tipLine[18885] = StringToText("每当因游戏规则或角色能力的效果要探查或影响玩家的阵营或角色，且放置“蛊毒”标记的玩家因此被选中为目标时，");
    g_tipLine[18886] = StringToText("  由你决定他被当作原本的阵营和角色或邪恶的蛊雕。");
    g_tipLine[18887] = StringToText("【提示标记】");
    g_tipLine[18888] = StringToText("· 蛊毒");
    g_tipLine[18889] = StringToText("放置时机：蛊雕入场时。");
    g_tipLine[18890] = StringToText("放置条件：初始放置在蛊雕的角色标记旁；每个夜晚，放置在下一名即将被蛊雕得知的玩家角色标记旁。");
    g_tipLine[18891] = StringToText("特殊说明：如果蛊雕中毒或醉酒，不要移动该标记。");
    g_tipLine[18892] = StringToText("移除时机：蛊雕死亡或离场时。");
    g_tipLine[18893] = StringToText("· 改变方向");
    g_tipLine[18894] = StringToText("放置时机：蛊雕选择改变方向时。");
    g_tipLine[18895] = StringToText("放置条件：放置在蛊雕的角色标记旁，不论蛊雕是否醉酒中毒，都会将此标记放置在蛊雕角色标记旁（如果蛊雕中毒或醉酒，");
    g_tipLine[18896] = StringToText("  倒置此标记表示蛊雕并不会因此改变方向）。");
    g_tipLine[18897] = StringToText("移除时机：蛊雕死亡或离场时。");
    g_tipLine[18898] = StringToText("【规则细节】");
    g_tipLine[18899] = StringToText("· 被“蛊毒”的玩家在同时判定角色和阵营的时候，如果决定让蛊雕的能力产生干扰，那么这名玩家只能被当作“邪恶的蛊雕”。");
    g_tipLine[18900] = StringToText("  ");
    g_tipLine[18901] = StringToText("· 如果被“蛊毒”的玩家不再是镇民或死亡了，这名玩家依然受到“蛊毒”的影响。");
    g_tipLine[18902] = StringToText("· 部分角色的能力中，把“蛊毒”玩家当作是邪恶的蛊雕属于“可以但不建议”，例如小恶魔、涡流、传教士、工程师、");
    g_tipLine[18903] = StringToText("  罂粟种植者、帽匠等。说书人应当结合实际经验来进行判断，给玩家带来良好的游戏体验。");
    g_tipLine[18904] = StringToText("· 相克规则：");
    g_tipLine[18905] = StringToText("· 炼金术士：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改为蛊雕一定在场。每次处决后，");
    g_tipLine[18906] = StringToText("  存活的炼金术士可以公开猜测一名存活玩家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_tipLine[18907] = StringToText("· 魔术师：蛊雕会跳过魔术师。");
    g_tipLine[18908] = StringToText("· 食人魔：如果“蛊毒”玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。");
    g_tipLine[18909] = StringToText("· 瘟疫医生：如果说书人本应获得蛊雕的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_tipLine[18910] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[18911] = StringToText("· 戏子/戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[18912] = StringToText("【背景故事】");
    g_tipLine[18913] = StringToText("“一囚伏法，举族同拘。”");
    g_tipLine[18914] = StringToText("【角色能力】");
    g_tipLine[18915] = StringToText("每个夜晚，你要选择至多三名玩家：如果明天白天他们之一死于处决，上次被你选择的其他玩家会在当晚死亡。否则，");
    g_tipLine[18916] = StringToText("  当晚他们之中会有一名玩家死亡。");
    g_tipLine[18917] = StringToText("【角色简介】");
    g_tipLine[18918] = StringToText("典狱长对“有罪之人”做出判罚，以连坐或择其一的方式。");
    g_tipLine[18919] = StringToText("· 典狱长在首个夜晚就会行动，他可以选择一至三名玩家，但不能不进行选择。");
    g_tipLine[18920] = StringToText("· 如果下个白天，被典狱长选中的玩家之一死于处决，那么所有其他被典狱长选中的玩家都会在下个夜晚死亡；否则，");
    g_tipLine[18921] = StringToText("  被典狱长选中的玩家中会有一名玩家在下个夜晚死亡。");
    g_tipLine[18922] = StringToText("【范例】");
    g_tipLine[18923] = StringToText("首个夜晚，典狱长选择了小明，小李，小红。下个白天，小明死于处决。下个夜晚，小李与小红死亡。");
    g_tipLine[18924] = StringToText("某个夜晚，典狱长选择了小赵和小孙。下个白天，无人被处决。下个夜晚，说书人决定小赵死亡。");
    g_tipLine[18925] = StringToText("【运作方式】");
    g_tipLine[18926] = StringToText("每个夜晚，唤醒典狱长。让典狱长选择任意一至三名玩家。让典狱长重新入睡。将“判罚”提示标记放置到这些玩家的角色标记");
    g_tipLine[18927] = StringToText("  旁。");
    g_tipLine[18928] = StringToText("在白天，如果被放置“判罚”提示标记的玩家死于处决，在该玩家角色标记旁放置“死于今日”提示标记。");
    g_tipLine[18929] = StringToText("除了首个夜晚以外的每个夜晚，如果有玩家角色标记旁放置“死于今日”提示标记，其他所有标有“判罚”提示标记的玩家死亡。");
    g_tipLine[18930] = StringToText("  否则，说书人要决定被标有“判罚”提示标记的玩家之一死亡。");
    g_tipLine[18931] = StringToText("【提示标记】");
    g_tipLine[18932] = StringToText("· 判罚");
    g_tipLine[18933] = StringToText("放置时机：在典狱长夜晚行动并选择了玩家后放置。");
    g_tipLine[18934] = StringToText("放置条件：在典狱长选择的所有玩家的角色标记旁分别各放置一个此标记。不论典狱长是否醉酒中毒，都要放置此标记。");
    g_tipLine[18935] = StringToText("移除时机：当典狱长的能力结算玩家死亡时移除（不论典狱长是否醉酒中毒），或典狱长死亡或离场时移除。");
    g_tipLine[18936] = StringToText("· 死于今日");
    g_tipLine[18937] = StringToText("放置时机：在白天时，如果有被标记着“判罚”的玩家死于处决，在该玩家的角色标记旁放置。");
    g_tipLine[18938] = StringToText("放置条件：在因处决而死亡的玩家的角色标记旁放置，不论此时典狱长是否醉酒中毒，都要放置此标记。");
    g_tipLine[18939] = StringToText("移除时机：当典狱长的能力结算玩家死亡时移除（不论典狱长是否醉酒中毒），或典狱长死亡或离场时移除。");
    g_tipLine[18940] = StringToText("· 死亡");
    g_tipLine[18941] = StringToText("放置时机：在典狱长夜晚行动结束时，放置此标记。");
    g_tipLine[18942] = StringToText("放置条件：典狱长未醉酒中毒时，不论典狱长此次夜晚行动是否被唤醒或成功放置“判罚”标记，进行以下操作：");
    g_tipLine[18943] = StringToText("  检查在本次典狱长夜晚行动之前，是否存在被典狱长的“死于今日”标记的玩家。若是，则在所有被“判罚”提示标记标记");
    g_tipLine[18944] = StringToText("  的玩家的角色标记旁放置“死亡”标记；若否，则在其中一名“判罚”提示标记标记的玩家的角色标记旁放置“死亡”标记，");
    g_tipLine[18945] = StringToText("  用以提醒说书人在黎明时分宣布当晚的死亡玩家。若这些玩家已死亡或无法被典狱长杀死或典狱长醉酒中毒，");
    g_tipLine[18946] = StringToText("  直接移除“判罚”标记。");
    g_tipLine[18947] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[18948] = StringToText("【规则细节】");
    g_tipLine[18949] = StringToText("· 特定角色互动：");
    g_tipLine[18950] = StringToText("· 莽夫：典狱长造成死亡在他选择玩家之后。例如：典狱长第二个夜晚选择了未被选择过的莽夫，第一个夜晚他选择的玩家都");
    g_tipLine[18951] = StringToText("  不会死亡。但第三个夜晚，只要典狱长健康清醒，那么典狱长在第二个夜晚选择的玩家（包括莽夫在内），");
    g_tipLine[18952] = StringToText("  都会正常结算死亡。");
    g_tipLine[18953] = StringToText("· 相克规则：");
    g_tipLine[18954] = StringToText("· 召唤师：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_tipLine[18955] = StringToText("【伪装成洗衣妇】");
    g_tipLine[18956] = StringToText("当你要伪装成洗衣妇的时候，这里有几件事你应该记住：");
    g_tipLine[18957] = StringToText("· 声明自己是洗衣妇并指向至少一位邪恶阵营的玩家。然后，说出一个镇民角色（最好是你猜测或已经知道不在场的角色）。");
    g_tipLine[18958] = StringToText("  如果邪恶阵营的玩家足够聪明的话，他就会意识到你正尝试让他显得善良，并且也会声明自己确实就是这个镇民角色。");
    g_tipLine[18959] = StringToText("· 例如，如果你指向恶魔和一个随机的善良阵营玩家，并且说他们之中有一个僧侣，然后恶魔就可能会声明自己是僧侣，");
    g_tipLine[18960] = StringToText("  这会让你们俩看起来都像是好人。");
    g_tipLine[18961] = StringToText("· 如果一个善良阵营的玩家说自己是某个镇民角色，在这时你就可以声明自己是洗衣妇，并且证实他说的就是真的。");
    g_tipLine[18962] = StringToText("· 在大家刚醒来的时候，就立刻告诉大家在场有某个具体的角色。然后开始祈祷你猜对了！如果在场确实有这个角色，");
    g_tipLine[18963] = StringToText("  那么恭喜你！如果场上不存在这个角色，也没关系，邪恶阵营的玩家会去伪装成你提到的这个镇民角色。");
    g_tipLine[18964] = StringToText("· 伪装成洗衣妇有可能会有些困难，因为有时候你提到的在场的镇民角色并不在场。如果这样的话，");
    g_tipLine[18965] = StringToText("  记得宣称自己可能是醉酒或者中毒了。或者你还有一种更好的方法，你可以说你确实不是洗衣妇，");
    g_tipLine[18966] = StringToText("  但你是一个在后续游戏中能发挥更大作用的角色（例如猎手或者送葬者），你伪装成洗衣妇这样一个已经使用过能力的角色");
    g_tipLine[18967] = StringToText("  是为了避免受到恶魔攻击。");
    g_tipLine[18968] = StringToText("· 如果你是个间谍或者你能够与间谍沟通，你就能够通过这个角色的能力获得更准确的信息。这将会让你编的故事更可信。");
    g_tipLine[18969] = StringToText("· 你“应该”在第一个夜晚就获得信息。你“应该”得知的内容是两名玩家，和一个角色标记。");
    g_tipLine[18970] = StringToText("【伪装成图书管理员】");
    g_tipLine[18971] = StringToText("当你要伪装成图书管理员的时候，这里有几件事你应该记住：");
    g_tipLine[18972] = StringToText("· 你可以用你的信息给你的邪恶阵营同伙提供支持，这能让他们看起来显得比较善良。这不但能提高他们发言的可信度（尤其");
    g_tipLine[18973] = StringToText("  是当他们说自己是圣徒或陌客的时候），而且你们还可以明目张胆地合作，因为你们互相认为对方是\"善良阵营的玩家\"。");
    g_tipLine[18974] = StringToText("· 你也可以用你的信息去支持一个善良阵营的玩家。圣徒可能会面临不被其他玩家相信的难题，管家也可能希望有人能够相信");
    g_tipLine[18975] = StringToText("  他。这时候他们会很乐于让图书管理员来确认他们的角色，这之后他们也会更愿意相信你，还会跟你投票。");
    g_tipLine[18976] = StringToText("· 将两名善良玩家定义为酒鬼能够让他们怀疑自己所获得的信息，或者削弱像镇长这样的强力角色。");
    g_tipLine[18977] = StringToText("  酒鬼是一个非常安全的选择，因为你所挑选的玩家将没有办法证实你的信息（至少短期内不能）。");
    g_tipLine[18978] = StringToText("· 你也可以说你的邪恶阵营同伴有可能是酒鬼。这就意味着即使他们在角色伪装上出现了失误（例如给出了矛盾的信息），");
    g_tipLine[18979] = StringToText("  也还有回旋的余地。这时候你就可以说他们应该是真的酒鬼了。");
    g_tipLine[18980] = StringToText("· 作为一种自信的体现，在游戏前期立即声明在场的外来者角色，但不要指出可能是哪些玩家。如果你声明的角色在场，");
    g_tipLine[18981] = StringToText("  就能够让善良阵营的玩家相信你；如果你猜错了在场的外来者角色，那就可以让邪恶阵营的玩家去伪装成这个角色。");
    g_tipLine[18982] = StringToText("【伪装成调查员】");
    g_tipLine[18983] = StringToText("如果要装作调查员，你需要注意以下几点：");
    g_tipLine[18984] = StringToText("· 选两名善良阵营的玩家，并声称他们之中有一个爪牙。具体的爪牙角色你最好选投毒者或者红唇女郎，");
    g_tipLine[18985] = StringToText("  这样善良阵营将会非常想把这两名玩家都处决掉。善良阵营的玩家一般不太会急于处决有男爵或间谍嫌疑的玩家，当然了，");
    g_tipLine[18986] = StringToText("  凡事都不绝对。");
    g_tipLine[18987] = StringToText("· 如果你声称男爵在场，另一名邪恶玩家就需要同时声称自己是外来者。否则善良阵营玩家最后就会发现场上外来者的数量有");
    g_tipLine[18988] = StringToText("  问题，并且可能就会处决掉你。如果你能够私聊到邪恶阵营的玩家，不妨建议他这样与你配合。如果另一名邪恶阵营的玩家");
    g_tipLine[18989] = StringToText("  说自己是调查员，还说场上有男爵，这时就该换你伪装成外来者去配合他编故事了。");
    g_tipLine[18990] = StringToText("· 如果你是间谍，或者你可以与间谍沟通，都能为你去诋毁其他玩家提供强有力的援助。");
    g_tipLine[18991] = StringToText("· 与一到两名善良阵营玩家私下交流你的信息会滋生大量猜忌。在这种情况下你甚至不用做太多事情，他们就会自相残杀。");
    g_tipLine[18992] = StringToText("· 声称自己查验到了一个并不在场的爪牙将会引起局势的混乱，同时也可以帮其他邪恶玩家更好地进行伪装。例如，");
    g_tipLine[18993] = StringToText("  声称男爵在场将会帮助一个正伪装成外来者的恶魔；当红唇女郎存在时声称投毒者在场也能够让其他玩家怀疑自己所获得的");
    g_tipLine[18994] = StringToText("  信息。");
    g_tipLine[18995] = StringToText("· 如果你是恶魔，告诉善良阵营场上真实存在的爪牙角色将会让你看起来非常可信，特别是当有其他善良阵营玩家能够佐证你");
    g_tipLine[18996] = StringToText("  的信息时。如果你的爪牙这时候又极力表现的像个坏人，你看起来就更可信了。总之，他们表现得越像爪牙，");
    g_tipLine[18997] = StringToText("  你就越像个调查员。");
    g_tipLine[18998] = StringToText("· 如果一名真正的调查员已经公开宣布了他的信息，且你并不是他得知的那两名玩家之一，你可以尝试宣称你才是真正的调查");
    g_tipLine[18999] = StringToText("  员，并告诉大家那个“假调查员”其实是你得知的两名玩家之一，这能有效地让那个调查员看起来很邪恶。");
    g_tipLine[19000] = StringToText("  如果大家都觉得那个调查员很邪恶，那么通过那个调查员获得的信息并因此被处决的玩家也会因此显得善良。");
    g_tipLine[19001] = StringToText("【伪装成厨师】");
    g_tipLine[19002] = StringToText("当你要伪装成厨师的时候，这里有几件事你应该记住：");
    g_tipLine[19003] = StringToText("· 宣称场上没有或者只有一对邪恶阵营玩家邻座通常都是比较可信的。报出更大的数字，例如有两对或者三对邪恶阵营玩家邻");
    g_tipLine[19004] = StringToText("  座在概率上通常不太可能，因此也不太会被人相信。在人数较少的游戏中，声称场上有两到三对邪恶阵营的玩家邻座通常没");
    g_tipLine[19005] = StringToText("  什么意义，因为场上一共就只有两位邪恶玩家。");
    g_tipLine[19006] = StringToText("· 给出错误的信息能够让善良阵营的玩家感到非常困惑。如果善良阵营认为邪恶玩家是邻座的，但实际上不是的话（反之亦然），");
    g_tipLine[19007] = StringToText("  他们就会就会因为各自的嫌疑而互相攻击，而你只需要隔岸观火。");
    g_tipLine[19008] = StringToText("· 给出真的信息能够让善良玩家确定一些玩家的阵营并厘清状况。这样当然也会带给你一些好处，因为你已经为善良阵营提供");
    g_tipLine[19009] = StringToText("  了很多帮助，那他们就会相信你并且让你活着。又或者如果他们觉得你是邪恶阵营的，那他们通常会觉得你给出的信息是假");
    g_tipLine[19010] = StringToText("  的，也就是说从一开始他们推理的基础就错了。");
    g_tipLine[19011] = StringToText("· 厨师是一个相当容易伪装的角色。如果你是个新手，装成厨师能够在玩家中散布错误信息，而又不需要随着游戏的进行持续");
    g_tipLine[19012] = StringToText("  地更新你的信息。");
    g_tipLine[19013] = StringToText("【伪装成共情者】");
    g_tipLine[19014] = StringToText("当你要伪装成共情者的时候，这里有几件事你应该记住：");
    g_tipLine[19015] = StringToText("· 声称你获得的数字是\"0\"将会让你的邻座不得不相信你，这样你就可以与他们之间建立起信任，");
    g_tipLine[19016] = StringToText("  并让他们的矛头从你的邪恶阵营队友身上移开。这种声明也能够保护你的邪恶阵营同伴，还给了你一个私下交流的好理由。");
    g_tipLine[19017] = StringToText("· 声称你获得的数字是\"1\"将会让你的两位邻座相互争辩，并且让他俩的行为在所有玩家眼中开始逐渐变坏。");
    g_tipLine[19018] = StringToText("  你也能通过这种方式与某位邻座之间建立信任（你可以先告诉其中一位你觉得他是个善良玩家），");
    g_tipLine[19019] = StringToText("  这样还给了你一个提名处决另一位邻座的理由。");
    g_tipLine[19020] = StringToText("· 声称你获得的数字是\"2\"将会是个困难但更有威力的伪装。因为这样你的两位邻座都将知道你在撒谎并且是邪恶阵营的玩");
    g_tipLine[19021] = StringToText("  家，但是如果其他人相信你的话，你就能诬陷两位善良阵营的玩家并有希望浪费掉善良阵营玩家的处决次数。");
    g_tipLine[19022] = StringToText("· 当你的邻座死亡后，你可以试着去改变这个数字。这样可以进一步诬陷刚刚死亡玩家的清白，或者用来暗示活着的那个邻座");
    g_tipLine[19023] = StringToText("  玩家一直都是邪恶阵营的。如果你尝试了一种很冒险的伪装，就一定要注意一点——在你的邻座\"邪恶玩家\"死亡之后，");
    g_tipLine[19024] = StringToText("  你仍然说你得到的数字是\"2\"很可能会引火上身。");
    g_tipLine[19025] = StringToText("· 共情者是个强力的角色，特别是当他的邻座玩家死亡并且获得了下一位玩家的新信息后。如果你在游戏的后期依然活着，");
    g_tipLine[19026] = StringToText("  这一点其实会比较可疑。如果玩家们开始对你产生怀疑，在玩家中绝口不提你的真实角色，说自己是酒鬼或是中毒了都能够");
    g_tipLine[19027] = StringToText("  给你的\"长寿\"找个好理由。");
    g_tipLine[19028] = StringToText("【伪装成占卜师】");
    g_tipLine[19029] = StringToText("当你要伪装成占卜师的时候，这里有几件事你应该记住：");
    g_tipLine[19030] = StringToText("· 你在每个晚上都会醒来（包括第一个晚上），如果你存活的话就会得到信息。当你说你是占卜师的时候，");
    g_tipLine[19031] = StringToText("  善良阵营的玩家会让你把每天晚上行动的详细原因说明一下。所以你得提前准备好你要告诉他们什么。");
    g_tipLine[19032] = StringToText("· 占卜师有时候会得到非常令人困惑的信息。陌客可能被当作恶魔。即便场上没有红唇女郎，恶魔也能将自己转移到爪牙身上。");
    g_tipLine[19033] = StringToText("  \"干扰项\"也能被当作恶魔，这样会导致一个善良玩家看起来很可疑。因此，相比于提供听起来合理且自洽的信息来说，");
    g_tipLine[19034] = StringToText("  能够自信地行动其实更重要一些。");
    g_tipLine[19035] = StringToText("· 在注意以上几点的情况下，如果你提供给队伍的信息也是一致的，你伪装的成功几率将会大大增加。");
    g_tipLine[19036] = StringToText("  如果你一遍又一遍地告诉其他人某位玩家不是恶魔，他们就会倾向于让这位玩家保持存活。如果你一遍又一遍地告诉其他人");
    g_tipLine[19037] = StringToText("  某位玩家可能是恶魔，他们就会倾向于处决这位玩家，但是如果处决之后游戏还在继续进行的话，");
    g_tipLine[19038] = StringToText("  他们就可能把矛头指向你了。");
    g_tipLine[19039] = StringToText("· 你可以撒谎说\"这两个玩家中没有恶魔\"，以便保护你的邪恶阵营队友。");
    g_tipLine[19040] = StringToText("· 如果一个善良玩家特别棘手，你就可以声称你查到他是恶魔了，这样可以让大家都把注意力集中在他身上并且迅速杀死他。");
    g_tipLine[19041] = StringToText("  并且你总是可以在处决他之后解释说他可能是你的\"干扰项\"。这个策略在你用正常手段无法处决某位玩家的情况下特别有");
    g_tipLine[19042] = StringToText("  效。尤其是你能够通过这种方法让圣徒或者镇长被处决，或者至少让善良阵营团队不去相信他们。甚至还能够让像送葬者，");
    g_tipLine[19043] = StringToText("  共情者或者类似的角色的信息变得疑点重重。");
    g_tipLine[19044] = StringToText("· 时刻记得占卜师也可以选择查验死亡的玩家，甚至可以选择查验自己。告诉其他玩家你查验的一个死亡玩家是恶魔会让其他");
    g_tipLine[19045] = StringToText("  玩家怀疑自己之前所得到的信息，也暗示了（在只有一个爪牙的对局中）只剩下一个邪恶阵营玩家存活了。");
    g_tipLine[19046] = StringToText("  这个错误信息看起来没什么用，但实际上会由于场上存活玩家之间的不信任让游戏朝着你希望的方向发展。");
    g_tipLine[19047] = StringToText("  如果恶魔不小心杀死了守鸦人，这时候你可以说这个守鸦人是恶魔自杀假扮的，这时候会非常有效。");
    g_tipLine[19048] = StringToText("· 如果你是小恶魔，你可以公布你是占卜师然后策略性地在晚上死去，这样就可以让你的信息看起来更合理。");
    g_tipLine[19049] = StringToText("· 如果你是红唇女郎，你可以公开针对真的恶魔然后让他被处决。这会让送葬者这类的角色得到一个信息\"被处决的人是小恶");
    g_tipLine[19050] = StringToText("  魔\"，以此来证明你是个真的占卜师。");
    g_tipLine[19051] = StringToText("【伪装成送葬者】");
    g_tipLine[19052] = StringToText("当你要伪装成送葬者的时候，这里有几件事你应该记住：");
    g_tipLine[19053] = StringToText("· 一个优秀的送葬者会等几天再公布自己的角色。在你告诉别人你是送葬者之前，你可以心安理得地安静几天，");
    g_tipLine[19054] = StringToText("  或者说自己是某个其他角色，然后将伪装送葬者当作备用计划。");
    g_tipLine[19055] = StringToText("· 证实一个好玩家的角色能够让你显得善良。为了这个策略能够成功，你需要提前知道他的角色是什么。如果你是间谍，");
    g_tipLine[19056] = StringToText("  或者可以和间谍交流，那你就可以对此更自信，因为你已经能得知所有人的角色了。");
    g_tipLine[19057] = StringToText("· 如果一些关键玩家被处决的话，你能够通过声明他是爪牙或者恶魔的方式让他显得邪恶。这会有些冒险，");
    g_tipLine[19058] = StringToText("  因为那位玩家就会知道你是邪恶阵营的。这给你带来了获胜的可能性，因为剩下的玩家并不知道你在说谎。");
    g_tipLine[19059] = StringToText("  但实际上大多数时候善良阵营玩家被处决的数量要比邪恶阵营玩家多，因此最好谨慎地使用这个策略。");
    g_tipLine[19060] = StringToText("· 如果另一个邪恶玩家死于处决，你可以随意说他是善良角色或是邪恶角色。如果你说他们是善良角色，");
    g_tipLine[19061] = StringToText("  你们两个的信息能够互相佐证，这会让你们两个看起来都更可信。如果你说他是个邪恶阵营玩家，");
    g_tipLine[19062] = StringToText("  他应该表现的更邪恶一点，并且公然暗示他确实邪恶。事实上，验出邪恶阵营能够让你看起来更像一个送葬者。");
    g_tipLine[19063] = StringToText("· 暗中诋毁一个被处决的镇民的更好方法是说你看到了酒鬼的角色标记。如果其他人相信你（特别是如果被处决的玩家相信你），");
    g_tipLine[19064] = StringToText("  那其他玩家就会假设这个人收到的任何信息都不太可信了。如果你不知道一位玩家的角色是什么，");
    g_tipLine[19065] = StringToText("  声明他是酒鬼是个隐藏真相的好方法。");
    g_tipLine[19066] = StringToText("【伪装成僧侣】");
    g_tipLine[19067] = StringToText("当你要伪装成僧侣的时候，这里有几件事你应该记住：");
    g_tipLine[19068] = StringToText("· 僧侣只在恶魔能够杀人的夜晚行动。记住，僧侣不会在首个夜晚被唤醒。");
    g_tipLine[19069] = StringToText("· 你应该有逻辑地选择一位玩家保护。要是一个公开声明自己是占卜师的玩家死在了你眼皮底下，你就洗不白了。然而，");
    g_tipLine[19070] = StringToText("  如果你告诉其他玩家你不相信占卜师说的是真话，而去保护了一位刚刚私聊过你且说自己是共情者的玩家，");
    g_tipLine[19071] = StringToText("  你的选择看起来就会合理一点了。");
    g_tipLine[19072] = StringToText("· 恶魔可以选择一位已经死亡的玩家，而不是一定要选存活玩家。如果你声称自己是僧侣，让恶魔杀已经死亡的玩家会支撑你");
    g_tipLine[19073] = StringToText("  是僧侣的这个假象。在晚上没有人死亡的时候，所有人都会想知道为什么。这同样意味着你说你要保护的那个玩家更被大家");
    g_tipLine[19074] = StringToText("  相信，因为恶魔总是攻击善良阵营的玩家。");
    g_tipLine[19075] = StringToText("· 僧侣通常是秘密进行行动的，在成功保护了某位玩家之前，一般不会暴露自己。你可以用这一点为借口去私聊很多人，");
    g_tipLine[19076] = StringToText("  既可以在善良阵营玩家中散布谎言，又可以协助你的邪恶阵营队友。如果有人质疑你为什么一直保持神秘，");
    g_tipLine[19077] = StringToText("  相信你是僧侣的玩家就会站出来保护你。");
    g_tipLine[19078] = StringToText("· 如果你在最后一天仍然存活，并且每天晚上都会有玩家死去，善良阵营玩家就可能会觉得你是个没啥用的僧侣，");
    g_tipLine[19079] = StringToText("  或者根本就是邪恶阵营的。如果你是个爪牙，这还能有点用，因为这样善良阵营玩家就会想去处决你而错过恶魔，");
    g_tipLine[19080] = StringToText("  最终会达成邪恶阵营的胜利条件。");
    g_tipLine[19081] = StringToText("【伪装成守鸦人】");
    g_tipLine[19082] = StringToText("当你要伪装成守鸦人的时候，这里有几件事你应该记住：");
    g_tipLine[19083] = StringToText("· 如果你想在合适的时候将自己的恶魔角色传递给爪牙，或者为了保护恶魔而死，守鸦人是个绝妙的伪装。");
    g_tipLine[19084] = StringToText("  死在夜晚的玩家一般会被视为好人，而且随着你的死亡所带来的信息能够让你推卸责任，保护一个邪恶阵营的同伴，");
    g_tipLine[19085] = StringToText("  或是让你看起来非常可信。");
    g_tipLine[19086] = StringToText("· 推卸责任能让你把一个善良玩家指责成一个邪恶玩家，你可以怀疑他的角色，他的信息以及他们所相信的人。");
    g_tipLine[19087] = StringToText("· 或者你可以为邪恶玩家的伪装做支撑，证实他们的角色并且让善良阵营更相信他。例如，如果你的恶魔同伴声称自己是僧侣，");
    g_tipLine[19088] = StringToText("  你就可以说你已经选择了这位玩家并且确实看到的是僧侣的角色标记。");
    g_tipLine[19089] = StringToText("· 一个更高级的方法是去声明别人其实是另一个新的角色，而不是之前他曾声明的那个。然后你就可以让你的邪恶阵营同伴说");
    g_tipLine[19090] = StringToText("  他其实一直在说谎，而你一直都是对的！（确保你的队友知道你要做什么，或者他们能够适应这种情况）");
    g_tipLine[19091] = StringToText("· 最后，你可以支持一个善良玩家的声明，这样可以让他相信并配合你。例如，如果你知道一名玩家是共情者，");
    g_tipLine[19092] = StringToText("  你就可以声称你选择了他并看到了共情者的角色标记。");
    g_tipLine[19093] = StringToText("· 如果你不知道你假装验证的那个人的真实角色咋办？说他是酒鬼就行。这同时还会让他们得到的信息受到质疑，");
    g_tipLine[19094] = StringToText("  无疑又给这个策略增添了一些用处。");
    g_tipLine[19095] = StringToText("· 如果你想整场游戏都活着，守鸦人是个极好的伪装。因为恶魔绝不会想杀死守鸦人，你可以说你活到最后是因为恶魔不知道");
    g_tipLine[19096] = StringToText("  用什么方法得知了你的角色（可能是通过间谍，也可能是偷听到了）。");
    g_tipLine[19097] = StringToText("· 你只有在死后才会得到信息，谨慎选择你要去查验谁。想以守鸦人这个角色死亡还是需要花些力气的，");
    g_tipLine[19098] = StringToText("  你要是浪费了这次机会去查验一个根本就没人怀疑的厨师，那你看起来就很可疑了。");
    g_tipLine[19099] = StringToText("· 如果你伪装成另一个角色失败，守鸦人其实是个不错的备选计划。伪装成像占卜师，送葬者，共情者这样的角色一旦信息有");
    g_tipLine[19100] = StringToText("  误就会让你惹上麻烦，但你可以说你其实一直都是个守鸦人，这样你原本所存在的疑点也就说得通了。");
    g_tipLine[19101] = StringToText("· 有些强力的角色将会公然伪装成守鸦人保护他们自己。你可以在他们面前表露自己才是\"真\"守鸦人并且允许他们继续用这");
    g_tipLine[19102] = StringToText("  个角色做伪装，这样能让善良阵营玩家更相信你，同时你可以想办法去削弱他们的能力。");
    g_tipLine[19103] = StringToText("【伪装成贞洁者】");
    g_tipLine[19104] = StringToText("当你要伪装成贞洁者的时候，这里有几件事你应该记住：");
    g_tipLine[19105] = StringToText("· 善良玩家绝不会因为提名你而被处决。这就意味着当你被提名的时候，你们两个中的一个将会是邪恶的，或是至少是酒鬼。");
    g_tipLine[19106] = StringToText("  如果你可以的话，让一个被大家怀疑是邪恶阵营的玩家提名你。在这种情况下，如果大家相信他邪恶，");
    g_tipLine[19107] = StringToText("  你就会被大家相信是善良的。");
    g_tipLine[19108] = StringToText("· 如果一个贞洁者被提名了，提名者与被提名者中但凡有一个是酒鬼，贞洁者的能力都不会被触发。");
    g_tipLine[19109] = StringToText("  贞洁者是酒鬼的话会在游戏开始就失去能力，提名者是酒鬼的话他就是外来者（而不是镇民）。如果在提名你之后没有玩家");
    g_tipLine[19110] = StringToText("  被处决，你就可以提出一个强有力的假设——你们两个之中有一个酒鬼。这样做还有一个好处，就是那个真的酒鬼可能不会");
    g_tipLine[19111] = StringToText("  被大家发现。");
    g_tipLine[19112] = StringToText("· 如果你是爪牙，你可以让恶魔来提名你然后把嫌疑引到自己身上。你越像邪恶阵营的人，恶魔就越像好人，");
    g_tipLine[19113] = StringToText("  因为恶魔在你伪装的角色下本是要被牺牲的角色，其他玩家因此就会更偏向于相信他。");
    g_tipLine[19114] = StringToText("· 如果场上真的有贞洁者，你的伪装就要小心一点了。如果你告诉大家你是贞洁者，而真贞洁者通过处决了一个镇民证明了自");
    g_tipLine[19115] = StringToText("  己，你就肯定不可能是贞洁者了。你需要让一个邪恶阵营角色去提名真贞洁者，避免他的角色被证实，");
    g_tipLine[19116] = StringToText("  这样善良阵营就会一直无法判断你们到底谁是真贞洁者。");
    g_tipLine[19117] = StringToText("· 伪装成贞洁者，被提名然后继续活下去，这是个伪装成其他角色的好机会。即便你在前一两天说了你是贞洁者，");
    g_tipLine[19118] = StringToText("  后面再说你其实是个送葬者或者僧侣之类的角色也是可信的。因为恶魔通常不会想杀一个有邪恶嫌疑的贞洁者，");
    g_tipLine[19119] = StringToText("  他们会更想杀送葬者或者僧侣。这时候再说\"我刚才撒谎说我是某某角色\"就看起来很合理了。");
    g_tipLine[19120] = StringToText("· 如果你确信大家都相信你是贞洁者，就可以坚持让那个对你威胁最大的玩家提名你！他们没有被处决的话看起来就会非常可");
    g_tipLine[19121] = StringToText("  疑。例如，一个共情者给邪恶阵营造成了很多麻烦，你就可以坚持让他提名你，从而让大家把矛头对准他。");
    g_tipLine[19122] = StringToText("【伪装成猎手】");
    g_tipLine[19123] = StringToText("当你要伪装成猎手的时候，这里有几件事你应该记住：");
    g_tipLine[19124] = StringToText("· 没人会因为你\"发动猎手的能力\"而死。记住这一点，这里有一些解决方法：");
    g_tipLine[19125] = StringToText("· 故意对恶魔或者其他爪牙使用能力，这样能让他们看起来不是恶魔，同时有利于邪恶阵营玩家的伪装。");
    g_tipLine[19126] = StringToText("  当你可以和红唇女郎配合时，这个策略将会非常有效，因为真正的恶魔可以死后将能力传递给其他已经被排除嫌疑的玩家。");
    g_tipLine[19127] = StringToText("· 对一个善良玩家使用能力来确认他不是恶魔；这会让你可以\"相信\"他，并因此会让他想要与你组成同盟。");
    g_tipLine[19128] = StringToText("· 或者，你可以故意对一个善良玩家使用，然后自己开始表现得像个坏人。因此你所\"保护\"的玩家会因为你的能力而受人怀");
    g_tipLine[19129] = StringToText("  疑，这会让他们看起来也像邪恶阵营的。");
    g_tipLine[19130] = StringToText("· 向大家征求意见。善良玩家将会很乐意帮你做出正确的选择，与他们合作会让你看起来像个善良玩家，");
    g_tipLine[19131] = StringToText("  同时也能把一些本来被隐藏的信息套出来。");
    g_tipLine[19132] = StringToText("· 不论对善良玩家还是邪恶玩家，伪装成一个已经用过能力的猎手都会非常有利。对于善良阵营玩家来说，");
    g_tipLine[19133] = StringToText("  没有能力的猎手不是恶魔的首要攻击目标，这能让你活下来并且继续偷偷搜集信息。对于邪恶玩家来说，");
    g_tipLine[19134] = StringToText("  这个伪装并不复杂，而且很难被证伪。");
    g_tipLine[19135] = StringToText("· 猎手是一个很好的\"备用伪装\"。如果你谎称的那个角色已经在场了，又或者被其他人怀疑了，你就可以说之前你在说谎。");
    g_tipLine[19136] = StringToText("  如此你就可以以猎手的伪装再多存活一到两天。毕竟……真的猎手也经常这样做。");
    g_tipLine[19137] = StringToText("【伪装成士兵】");
    g_tipLine[19138] = StringToText("当你要伪装成士兵的时候，这里有几件事你应该记住：");
    g_tipLine[19139] = StringToText("· 士兵很容易伪装，因为你不需要给出任何信息，你的能力也能解释为什么你能活这么久。但这并不意味着你就可以高枕无忧");
    g_tipLine[19140] = StringToText("  了；由于你没有信息，当大家的选择面缩减之后，很容易就会开始怀疑你。一个尝试帮助善良阵营玩家的士兵（例如你伪装");
    g_tipLine[19141] = StringToText("  成了占卜师来诱使恶魔攻击）要比一直坐着不说话的士兵可信的多。");
    g_tipLine[19142] = StringToText("· 保持安静并试图不引起他人的注意会让你看起来像是一个强力角色，但也有可能是士兵想要吸引恶魔的注意。");
    g_tipLine[19143] = StringToText("  安静的坐着并且一连几天都对你的能力只字不提，这样在大家看来你就是真的想被恶魔当做目标了。");
    g_tipLine[19144] = StringToText("· 你（或你方恶魔）可以在晚上攻击一个已经死亡的玩家。这将会造成当晚无人死亡的假象，能够让你声称昨夜应该是自己成");
    g_tipLine[19145] = StringToText("  为了恶魔的目标。");
    g_tipLine[19146] = StringToText("· 由于不死的能力存在，那些能获取信息的角色经常会伪装成士兵。如果要取得一名玩家的信任，你可以先将自己伪装成士兵，");
    g_tipLine[19147] = StringToText("  然后跟他们交换角色来保证他们能够一直存活。（温馨提示：如果你方刚好有一个投毒者在场，让这位玩家一直活着能够完");
    g_tipLine[19148] = StringToText("  全摧毁他的能力！）");
    g_tipLine[19149] = StringToText("· 士兵在晚上不会死(除非中毒或者是个酒鬼)。如果你死了，你最好对发生的事情有个合理的解释！");
    g_tipLine[19150] = StringToText("【伪装成镇长】");
    g_tipLine[19151] = StringToText("当你要伪装成镇长的时候，这里有几件事你应该记住：");
    g_tipLine[19152] = StringToText("· 镇长有很好的理由能够在晚上活下来，你可以解释说你一直活着是因为其他玩家替你死了。这会是一个对于恶魔来说很棒的");
    g_tipLine[19153] = StringToText("  伪装。");
    g_tipLine[19154] = StringToText("· 在游戏早期向少数几位玩家公布你的角色，这会在最终你要伪装成这个角色时，为你提供一些帮助，");
    g_tipLine[19155] = StringToText("  而不会让你看起来像是在胡诌。");
    g_tipLine[19156] = StringToText("· 在你的伪装失败之后，镇长也是个不错的备选。在你之前伪装成占卜师的情况下，如果你的信息无效且正在受到怀疑，");
    g_tipLine[19157] = StringToText("  在最后一天交代自己其实是个一直藏着的镇长能够减轻自己的嫌疑。");
    g_tipLine[19158] = StringToText("· 故意杀死一个看起来不是\"最优选项\"的角色也可以证明场上有镇长。例如，你可以选择一个陌客或者已经给出过信息的洗");
    g_tipLine[19159] = StringToText("  衣妇；他们对恶魔来说都是低优先级击杀的目标，这样你就可以说他们的死亡是由于你的能力而导致的替死。");
    g_tipLine[19160] = StringToText("· 作为一个善良玩家，将自己伪装成镇长能够吸引恶魔的攻击。因为恶魔可能会怀疑你是个更强大的角色，");
    g_tipLine[19161] = StringToText("  是为了活下来才伪装成了镇长，当然他也有可能就是想看看镇长到底在不在场。");
    g_tipLine[19162] = StringToText("· 善良阵营玩家如果没有更好的选择，他们会更倾向于通过镇长的能力来赢得游戏。和你的邪恶阵营同伴合作来让场上的混乱");
    g_tipLine[19163] = StringToText("  达到极致，这样善良阵营的玩家就会找不到一条能够明确通往胜利的路。");
    g_tipLine[19164] = StringToText("· 如果你在最后一天被提名了，也不要绝望！与一般的伪装角色不同，你不一定非要说服大家不去投你，");
    g_tipLine[19165] = StringToText("  镇长其实可以呼吁其他人来达成平票，这样就不会发生处决，镇长的能力也就可以正常生效。");
    g_tipLine[19166] = StringToText("【伪装成管家】");
    g_tipLine[19167] = StringToText("当你要伪装成管家的时候，这里有几件事你应该记住：");
    g_tipLine[19168] = StringToText("· 没人会怀疑一个管家！这很蠢，但是很真实；因为你看起来没什么威胁，并且很容易就把自己和善良玩家绑定在一起，");
    g_tipLine[19169] = StringToText("  不论是善良玩家还是邪恶玩家，管家都是个不错的伪装。");
    g_tipLine[19170] = StringToText("· 你不必一直跟随同一个主人。但是重复地选择同一位玩家将能够帮助你更好地与他人建立信任。");
    g_tipLine[19171] = StringToText("· 在没有其他证据的情况下，跟着一名善良玩家投票是让他们信任你的好方法。人们会喜欢被信任的感觉，");
    g_tipLine[19172] = StringToText("  让别人作为你的主人就是建立信任的一种很好的方法。又或者你可以跟着一个邪恶玩家投票，这样你就有正当理由可以与他");
    g_tipLine[19173] = StringToText("  交流并且相信他……如果他被揪出来了，你可以让你看起来像是被欺骗了！");
    g_tipLine[19174] = StringToText("· 伪装成管家的你其实可以随意投票，但是没人会知道。自以为是你主人的玩家将会把你的票视为他的额外奖励，");
    g_tipLine[19175] = StringToText("  但是你其实是独立操作于他的。你可以利用这种期望让善良阵营的玩家认为他们有比实际更多的人数，");
    g_tipLine[19176] = StringToText("  并且可以选一个完美的时刻背叛他们，以此打他们一个措手不及。");
    g_tipLine[19177] = StringToText("· 如果你真的需要投票，但是却跟随了一个吹毛求疵的主人，你也可以跟着另一位所谓的\"主人\"把手举起来，");
    g_tipLine[19178] = StringToText("  并且告诉大家其实你早已经偷偷易主了。小心，这可能会惹恼你原来的主人！");
    g_tipLine[19179] = StringToText("· 如果你想胁迫你的主人投一个你想投的玩家，你可以威胁他说如果他不投票你就要换主人了。");
    g_tipLine[19180] = StringToText("【伪装成酒鬼】");
    g_tipLine[19181] = StringToText("当你要伪装成酒鬼的时候，这里有几件事你应该记住：");
    g_tipLine[19182] = StringToText("· 在游戏开始的时候，伪装成一个具体的镇民角色，因为酒鬼在游戏开始的时候只会知道自己是个镇民角色。");
    g_tipLine[19183] = StringToText("· 伪装成一个更被动地获取信息的角色，比如占卜师、调查员、共情者、洗衣妇、送葬者或者图书管理员，");
    g_tipLine[19184] = StringToText("  然后故意给出显而易见的错误信息。如果你的信息很荒唐（比如声称两位都不是圣徒的玩家之中有一位圣徒），");
    g_tipLine[19185] = StringToText("  你看起来就会很像酒鬼。");
    g_tipLine[19186] = StringToText("· 伪装成一个能力可能会失效的角色，当你的假能力失效时，表现得惊讶一点，并且提出自己是不是有是酒鬼的可能性。");
    g_tipLine[19187] = StringToText("  例如，伪装成一个僧侣然后说你保护的玩家不知道为什么竟然死了。伪装成一个士兵然后在晚上杀死自己，");
    g_tipLine[19188] = StringToText("  或者让恶魔杀了你。伪装成猎手或者去提名贞洁者，并且当角色能力没有造成影响的时候装得很吃惊。");
    g_tipLine[19189] = StringToText("· 暗示酒鬼在场，并且带领大家找出他是谁。这会让他们从寻找恶魔的过程中分心，并且会不那么相信好人阵营的信息。");
    g_tipLine[19190] = StringToText("· 暗示某位玩家可能是酒鬼。如果某位玩家有个能够摧毁你阵营的信息，这将非常有用。例如一个送葬者说你是个死去的投毒");
    g_tipLine[19191] = StringToText("  者而你确实是的时候。");
    g_tipLine[19192] = StringToText("· 如果场上公开声明的外来者数量适合你编故事的话，说服大家有酒鬼在场，或说服大家某位玩家是酒鬼是非常容易办到的。");
    g_tipLine[19193] = StringToText("  例如，在场上应该只有一个外来者的情况下，如果你说贞洁者是个酒鬼且真正的圣徒已经公布了自己的角色，");
    g_tipLine[19194] = StringToText("  那让贞洁者是酒鬼成立的条件就只能是圣徒在说谎。如果你或一个邪恶阵营队友伪装成一个外来者，");
    g_tipLine[19195] = StringToText("  那就更容易说服善良阵营玩家酒鬼是在场的，因为额外的外来者会让场面上看起来是有男爵的加入，");
    g_tipLine[19196] = StringToText("  这个角色可以让两名额外的外来者加入游戏。");
    g_tipLine[19197] = StringToText("· 如果你想让邪恶队友支持你的酒鬼伪装，让他们声称自己是图书管理员。守鸦人和送葬者也行，但就是必须要有人死亡才能");
    g_tipLine[19198] = StringToText("  发挥作用。");
    g_tipLine[19199] = StringToText("· 如果你想要在游戏后期伪装成酒鬼，并且觉得自己能成功，只要给出与你想让善良阵营相信的信息完全相反的内容就行了。");
    g_tipLine[19200] = StringToText("  例如你声称自己是个共情者，并且想要处决你的邻座，你开始就可以说你的邻座都是善良的——如果在后续大家开始相信你");
    g_tipLine[19201] = StringToText("  是酒鬼，他们就会假设你的邻座中至少有一个是邪恶的并且把他们两个都处决。");
    g_tipLine[19202] = StringToText("【伪装成陌客】");
    g_tipLine[19203] = StringToText("当你要伪装成陌客的时候，这里有几件事你应该记住：");
    g_tipLine[19204] = StringToText("· \"我不是邪恶阵营的，我只是被当成了邪恶阵营\"——由于陌客会被当做邪恶玩家，这是你被认作恶魔时候的强力借口。");
    g_tipLine[19205] = StringToText("  这能帮助你避免被共情者，占卜师或是调查员这样的角色怀疑并攻击。");
    g_tipLine[19206] = StringToText("· 尽可能帮助善良阵营。早点告诉他们你是陌客，并且积极地帮他们找到其他外来者，帮他们推理信息的真实性等等。");
    g_tipLine[19207] = StringToText("  如果他们相信你是善良的，在他们眼里让你活着对他们就是有利的，即便是在你搞砸了他们的能力的情况下。");
    g_tipLine[19208] = StringToText("· 把陌客当做一个备用的伪装，或者对你的角色缄口不言一阵子——最后你可以揭示自己的角色并且说你刚才是为了让邪恶阵");
    g_tipLine[19209] = StringToText("  营玩家迷惑才隐藏了自己的外来者角色，或者说是为了验证其他人才这样做的。");
    g_tipLine[19210] = StringToText("· 由于陌客死后还会继续被认作邪恶玩家，因此即便像送葬者或者守鸦人这样的角色查验到了你，你也可以在死后继续保持你");
    g_tipLine[19211] = StringToText("  的伪装。坚持说场上还有其他的爪牙或恶魔能够让小镇里的居民更困惑。");
    g_tipLine[19212] = StringToText("· 知道你被当作邪恶阵营或角色将会给善良阵营提供一些信息，他们会利用这一点；当心厨师这样的角色，");
    g_tipLine[19213] = StringToText("  他将会用你作为支点来找到其他邪恶玩家。如果你坐在恶魔旁边，在进行伪装之前可能需要先等等看其他人说些什么。");
    g_tipLine[19214] = StringToText("【伪装成圣徒】");
    g_tipLine[19215] = StringToText("当你要伪装成圣徒的时候，这里有几件事你应该记住：");
    g_tipLine[19216] = StringToText("· 由于圣徒的特性，他可以算作是邪恶阵营在游戏中最好的伪装了。处决你的风险太大了，因此善良阵营经常会谨慎行事，");
    g_tipLine[19217] = StringToText("  而先把你放在一边。但这已不意味着你就绝对安全了；在最后一天，处决你和处决任意一个人风险都一样（因为如果没处决");
    g_tipLine[19218] = StringToText("  到恶魔，善良阵营一样会输掉游戏）。随着游戏的进行，你还是会被大家无数次怀疑。");
    g_tipLine[19219] = StringToText("· 在一场没有男爵的游戏中伪装成圣徒会比较麻烦，因为你很容易就和其他的外来者发生争执。幸运的是，由于你的特性，");
    g_tipLine[19220] = StringToText("  处决你要比处决管家或者陌客要冒更大的风险；使用这点来干扰善良玩家的处决。");
    g_tipLine[19221] = StringToText("· 游戏过程中你会被能力效果探查为邪恶阵营或角色。一个不错的反驳点就是因为你的圣徒角色导致说书人针对了你。例如，");
    g_tipLine[19222] = StringToText("  你可以说你是占卜师的\"干扰项\"，或者共情者实际上是酒鬼所以才看错了你的阵营。");
    g_tipLine[19223] = StringToText("· 善良玩家伪装成圣徒也大有好处！恶魔通常不会去杀圣徒因为他更希望圣徒在白天被处决。当你是共情者或者占卜师的时候，");
    g_tipLine[19224] = StringToText("  利用这一点你可以活得更久。");
    g_tipLine[19225] = StringToText("· 如果你被处决了且游戏没有结束，大家会立即发现你不是圣徒。准备好一个备用的伪装，例如陌客之类，");
    g_tipLine[19226] = StringToText("  或者一个不想死的强大镇民（像送葬者或者猎手）。");
    g_tipLine[19227] = StringToText("· 小心猎手！圣徒通常是一个能够让你免于被处决的有效伪装，但如果猎手在场，他会非常想试试你的成色，");
    g_tipLine[19228] = StringToText("  因为他的能力不会触发圣徒的失败条件。有一个不错的规避方法就是先让爪牙去伪装成圣徒，被猎手攻击之后小恶魔再把恶");
    g_tipLine[19229] = StringToText("  魔血脉传给这个爪牙。");
    g_tipLine[19230] = StringToText("· 如果你被提名了，脱下之前所有的伪装然后说自己是圣徒。声称你之前所有的信息和角色都是一种引诱恶魔攻击你的策略。");
    g_tipLine[19231] = StringToText("  这通常会让善良阵营立刻停下对你的处决。");
    g_tipLine[19232] = StringToText("【伪装成祖母】");
    g_tipLine[19233] = StringToText("当你要伪装成祖母的时候，这里有几件事你应该记住：");
    g_tipLine[19234] = StringToText("· 作为祖母最简单的虚张声势就是声称你是祖母，并声称一个邪恶的玩家是你的孙子。你可能不想在第一天这样做，");
    g_tipLine[19235] = StringToText("  因为大多数祖母需要一两天来透露他们的信息。等待一两天也让你的假孙子有机会告诉大家他们是谁，");
    g_tipLine[19236] = StringToText("  这样你们就可以配合他们了。或者，你可以简单地说，你是祖母，宣布一个邪恶的玩家是一个特别好的角色，");
    g_tipLine[19237] = StringToText("  并寄希望于那位邪恶玩家能理解你在做什么，并稳步地扮演成为那个角色。");
    g_tipLine[19238] = StringToText("· 也可以让一个善良玩家相信你是他们的祖母。如果善良玩家事先向你透露了他们的角色，或者公开透露了他们的角色，");
    g_tipLine[19239] = StringToText("  那会很容易伪装成他们的祖母。如果你知道他们的角色，你可以告诉大家同样的事情。如果你不知道他们的角色，");
    g_tipLine[19240] = StringToText("  你可以猜一猜...或者什么都不说。");
    g_tipLine[19241] = StringToText("· 请你的邪恶玩家同伴秘密找出善良玩家，并把这些信息反馈给你。一旦你知道了一个善良玩家的角色，");
    g_tipLine[19242] = StringToText("  而那个好玩家又不知情，那么让他们相信你是他们的祖母就容易多了。");
    g_tipLine[19243] = StringToText("· 扮演一名孙子！你可以自称是个善良玩家，还可以自称自己是孙子。告诉别的玩家，祖母私下找过你，你对他们完全信任。");
    g_tipLine[19244] = StringToText("  并寄希望于一个邪恶玩家会声称自己是祖母并证实你的故事。");
    g_tipLine[19245] = StringToText("【伪装成水手】");
    g_tipLine[19246] = StringToText("当你要伪装成水手的时候，这里有几件事你应该记住：");
    g_tipLine[19247] = StringToText("· 你毕竟不是一个真正的水手，你被处决了很可能会死！除非你有一个老谋深算的魔鬼代言人帮助你，");
    g_tipLine[19248] = StringToText("  否则最好避免仅仅为了证明一个观点而被处决。有些对局中会特别热衷于此，所以小心行事，给你的团队更好的选择来消磨");
    g_tipLine[19249] = StringToText("  这一个白天。");
    g_tipLine[19250] = StringToText("· 尽量让有强力能力的玩家相信，他们是因为你才醉酒的。如果有人刚刚透露他们是怀疑茶艺师的邻座是一个坏人，");
    g_tipLine[19251] = StringToText("  你这时候说，哦不！你每天晚上都在和茶艺师拼酒，所以这可能就是他们的能力没有发挥作用的原因。");
    g_tipLine[19252] = StringToText("  甚至他们知道他们有醉酒的可能性也会动摇一个善良玩家的信念。");
    g_tipLine[19253] = StringToText("· 用你的“导致玩家醉酒”来掩护其他邪恶的玩家。例如，如果一个爪牙虚张声势自己是侍女，但拿出一个与镇上所知不符的");
    g_tipLine[19254] = StringToText("  数字？嗯，他们当然是喝醉了——难怪他们的信息全错了！");
    g_tipLine[19255] = StringToText("【伪装成侍女】");
    g_tipLine[19256] = StringToText("当你要伪装成侍女的时候，这里有几件事你应该记住：");
    g_tipLine[19257] = StringToText("· 如果你了解了哪些善良玩家是哪些角色，你就可以声称自己选择了他们，并提供关于他们夜间活动的正确信息。");
    g_tipLine[19258] = StringToText("  这使他们看起来值得信赖，也使你看起来值得信赖。");
    g_tipLine[19259] = StringToText("· 如果你不知道哪个善良玩家是哪个角色，你可以大胆一点，给出与他们夜间活动不一致的信息。例如，");
    g_tipLine[19260] = StringToText("  两个你选择了的玩家说自己是驱魔人和旅店老板，但你却说他们中只有一个人醒了，那么善良玩家很可能会先不信任他们。");
    g_tipLine[19261] = StringToText("· 确认邪恶的玩家，以帮助你的团队看起来值得信赖。你可以倾听队友的虚张声势，然后提供与这些虚张声势相匹配的信息，");
    g_tipLine[19262] = StringToText("  或者你可以提供信息（也许还可以给反应迟钝的队友使个眼色），并希望你的邪恶队员意识到他们应该以符合你的信息的角");
    g_tipLine[19263] = StringToText("  色进行虚张声势。");
    g_tipLine[19264] = StringToText("· 如果你不知道谁是谁，告诉大家你收到的是 \"1 \"比 \"0 \"或 \"2 \"更安全。如果你给了 \"0\"，");
    g_tipLine[19265] = StringToText("  而你选择的玩家中有一个真的醒了，他们知道你在撒谎。如果你给了2，而其中一个玩家没有醒来，他们就知道你在撒谎。");
    g_tipLine[19266] = StringToText("  但是，如果你给的是 \"1\"，那么无论是否有玩家醒来，他们都很难判断你是否在说谎，反而可能去怀疑你查验的玩家。");
    g_tipLine[19267] = StringToText("· 如果你是一名优秀的玩家，伪装成侍女虚张声势可能是恐吓其他玩家说出他们角色的好方法。如果你怀疑他们在撒谎（或者");
    g_tipLine[19268] = StringToText("  他们什么都没说），你可以声称知道他们是否在晚上醒来，这可能会促使他们改变他们的说辞（如果是邪恶的），");
    g_tipLine[19269] = StringToText("  或者暴露他们的真实角色（如果是善良的）。侍女的独特之处，就是擅长检测人们是否在撒谎，而不是检测阵营好坏。");
    g_tipLine[19270] = StringToText("【伪装成驱魔人】");
    g_tipLine[19271] = StringToText("当你要伪装成驱魔人的时候，这里有几件事你应该记住：");
    g_tipLine[19272] = StringToText("· 利用你谎称的角色与人私下交谈。驱魔人与刺客类似，他们自己掌握的信息非常少，必须依靠镇民帮助他们做出正确的决定。");
    g_tipLine[19273] = StringToText("  得知你角色的善良玩家会想着去帮助你，他们会允许你去引导大家，让你的邪恶同伴减少怀疑。这也给了你一个很好的理由");
    g_tipLine[19274] = StringToText("  在私下里和你的爪牙同伴或恶魔窃窃私语--总之，尽早向正确的人传达你的角色，善良玩家甚至可能会在对局里为你的可");
    g_tipLine[19275] = StringToText("  疑行为辩护。");
    g_tipLine[19276] = StringToText("· 如果一个晚上过去了，没有死亡发生，你可以（而且应该！）声称用你的能力选择了一个好玩家。");
    g_tipLine[19277] = StringToText("  你可以利用这一点鼓励镇上的人不信任并最选择处决他们，尤其是那些让邪恶玩家头痛的角色（如茶艺师和和平主义者）。");
    g_tipLine[19278] = StringToText("· 故意不杀人（或要求你的恶魔不杀人），以便加倍虚张声势，说你已经成功阻挡了恶魔。白天起来没有人死亡，");
    g_tipLine[19279] = StringToText("  会使你声称选择的玩家更加被怀疑，从而使你能够坐享其成。这在与像珀这样的恶魔（他可以选择不杀人）");
    g_tipLine[19280] = StringToText("  的组合中特别有效--邪恶的团队可以 \"充电 \"一夜，然后肆意谋杀和狂欢，在镇民认为自己安全无虞后不久就能消灭");
    g_tipLine[19281] = StringToText("  一大批善良玩家。");
    g_tipLine[19282] = StringToText("· 你至少可以在一个与恶魔有关的死亡的夜晚，声称你用你的能力选择了恶魔。如果其他玩家相信你，");
    g_tipLine[19283] = StringToText("  那么你就 \"证明 \"了你的恶魔不可能在当晚行动，从而免除了善良玩家的怀疑。");
    g_tipLine[19284] = StringToText("· 好好听一下有哪些角色会改变死亡人数，你可以杀人或不杀人，但仍然可以声称你已经成功地作为驱魔人阻止了恶魔。");
    g_tipLine[19285] = StringToText("  例如，如果对局里有一个活跃的造谣者，你可以论证他们所做的任何陈述都是真实的，因此要对死亡负责的是造谣者而不是");
    g_tipLine[19286] = StringToText("  恶魔。你也可以根据谁的死亡和时间来论证刺客或教父的存在。");
    g_tipLine[19287] = StringToText("· 在黯月初升剧本中，没有什么事情是肯定的，但是如果善良玩家正在危险地接近你的恶魔，你可以假装是驱魔人，");
    g_tipLine[19288] = StringToText("  提供 \"阻碍\"，给邪恶团队一些额外的生存能力。如果他们在几个人之间摇摆不定，这就会特别有效--鼓励他们处决无");
    g_tipLine[19289] = StringToText("  辜的玩家，而你则为另一个被怀疑是恶魔的玩家驱魔，给善良玩家一个万无一失的方法来处置他们的两个嫌疑人.....");
    g_tipLine[19290] = StringToText("  .只要你说的是真的。(不过要注意的是--一旦夜晚过去，恶魔再次杀人，这一招就会很快暴露出来！要小心把握时机。）");
    g_tipLine[19291] = StringToText("  ");
    g_tipLine[19292] = StringToText("【伪装成旅店老板】");
    g_tipLine[19293] = StringToText("当你要伪装成旅店老板的时候，这里有几件事你应该记住：");
    g_tipLine[19294] = StringToText("· 如果你是恶魔，请杀死你声称要保护的玩家不同的玩家。如果你声称在晚上保护了侍女，而侍女在早上死了，");
    g_tipLine[19295] = StringToText("  那么你就得去解释。如果你是恶魔，或者你是可以与恶魔私聊战术的爪牙，你可以攻击与你声称要保护的玩家不同的玩家。");
    g_tipLine[19296] = StringToText("· 如果你的邪恶阵营同伴的表演得不太好，请声称你保护了他们。这将使他们中的一个或两个看起来像是醉酒了，");
    g_tipLine[19297] = StringToText("  这使他们的失误显得合理，同时也为他们还活着提供了额外的理由。");
    g_tipLine[19298] = StringToText("· 如果善良的玩家拥有特别强的能力，请声称要保护他们。让他们觉得自己有醉酒的可能性，这样他们会很困惑，");
    g_tipLine[19299] = StringToText("  从而有效地抵消他们的能力。");
    g_tipLine[19300] = StringToText("· 私下告诉人们你是旅店老板，这可以获得善良阵营信任，同时给善良方制作很多麻烦。善良的玩家通常会想要向旅店老板透");
    g_tipLine[19301] = StringToText("  露他们的角色，以便获得旅店老板的保护（如果他们是一个不惜一切代价想要活下去的角色）或确保旅店老板永远不会选择");
    g_tipLine[19302] = StringToText("  他们（因为他们需要清醒地使用他们的能力）。知道哪些玩家是哪些角色可以直接帮助你，因为你知道要杀谁，");
    g_tipLine[19303] = StringToText("  而同时那些玩家也会更信任你。");
    g_tipLine[19304] = StringToText("· 准备好后备的虚张声势，以防人们太怀疑你在游戏后期还活着。旅店老板很少能活到游戏后期，但并非不可能。");
    g_tipLine[19305] = StringToText("  你有充分的理由“撒谎”，例如自称是弄臣。诸如弄臣, 水手, 莽夫或坐在茶艺师旁边的玩家等角色都有充分的理由谎");
    g_tipLine[19306] = StringToText("  报自己的角色以吸引恶魔的注意，而旅店老板是恶魔特别喜欢的目标，所以在游戏后期，当你旅店老板的角色受怀疑时，");
    g_tipLine[19307] = StringToText("  你大可考虑再扮演这些角色。");
    g_tipLine[19308] = StringToText("【伪装成赌徒】");
    g_tipLine[19309] = StringToText("当你要伪装成赌徒的时候，这里有几件事你应该记住：");
    g_tipLine[19310] = StringToText("· 你可以声称自己邪恶同伴是好人，并声明你猜对了他们的角色。例如，如果你能说服别人你确实是赌徒，");
    g_tipLine[19311] = StringToText("  那么你就能让别人相信自称是茶艺师的珀确实是茶艺师，如此你们就有优势了。");
    g_tipLine[19312] = StringToText("· 如果你假装通过能力帮助善良玩家确认角色，那也会让你看起来是善良的。玩家倾向于信任那些信任他们的玩家。但是，");
    g_tipLine[19313] = StringToText("  由于你没有将额外的错误信息放入其中，因此善良阵营可能更容易找出邪恶阵营。");
    g_tipLine[19314] = StringToText("· 有个风险很大的玩法——你选择了一个善良的玩家，猜他的善良角色，而你却因为猜了他的角色而死（这个可能需要你和恶");
    g_tipLine[19315] = StringToText("  魔协作一下，让你当晚死亡），那你就可以声称他是邪恶的。毕竟，当真正的赌徒猜错时，他们会死。");
    g_tipLine[19316] = StringToText("· 如果你在晚上意外死亡，你可以用它作为你是赌徒的证据。确保你的“信息”对善良阵营尽可能具有干扰性。");
    g_tipLine[19317] = StringToText("· 通常最明智的做法是在赌了几晚之后安全地使用自己的能力。猜 2 或 3 个角色，散布一些错误信息，");
    g_tipLine[19318] = StringToText("  然后声称在那之后的每晚都在猜自己。大多数一直使用能力猜别人的赌徒很快就会死去，所以当游戏后期到来时，");
    g_tipLine[19319] = StringToText("  你会想要一个可信的借口来解释你为什么还活着。");
    g_tipLine[19320] = StringToText("【伪装成造谣者】");
    g_tipLine[19321] = StringToText("当你要伪装成造谣者的时候，这里有几件事你应该记住：");
    g_tipLine[19322] = StringToText("· 作为造谣者，大概有两种方法可以虚张声势——安全的方式和冒险的方式。安全的方法是做出安全的声明，");
    g_tipLine[19323] = StringToText("  并尽最大努力向群体提供无用的信息——这样，善良阵营玩家很可能相信你是善良的，但忽略了你的信息。");
    g_tipLine[19324] = StringToText("  就像虚张声势一样，这往往是安全的，但是在大家讨论中缺乏虚假信息可能会在游戏后期使你暴露。");
    g_tipLine[19325] = StringToText("  更冒险的虚张声势的方式是让你的造谣者声明尽可能有争议，并尽最大努力说服大家你的虚假声明是真实的，");
    g_tipLine[19326] = StringToText("  而你的真实声明是假的 - 这造成了很多混乱和不确定性。就像是假扮占卜师一样，这最初可能风险更大，");
    g_tipLine[19327] = StringToText("  但游戏中虚假信息的增加可能会对你有利。");
    g_tipLine[19328] = StringToText("· 一般来说，应该故意给出虚假的声明。由于没有真正的造谣者来使用能力使玩家死亡，因此给出虚假声明看起来更可靠，");
    g_tipLine[19329] = StringToText("  因为它与夜晚的较低死亡人数相匹配。");
    g_tipLine[19330] = StringToText("· 你不能单凭扮演造谣者就使玩家死亡，所以要小心说出你认为“真实”的声明。但是，如果你是一个想要被处决以拯救恶魔");
    g_tipLine[19331] = StringToText("  的爪牙，那么你当然要给出看起来可疑的真实声明！但是，如果恶魔是一个多刀恶魔，如沙巴洛斯或珀，");
    g_tipLine[19332] = StringToText("  那么给出常规的真实声明很容易被相信。基本上，根据夜晚死亡人数协调你的声明 - 当死亡人数很多时，");
    g_tipLine[19333] = StringToText("  真实的声明更可信，当死亡人数较少时，虚假声明更可信。");
    g_tipLine[19334] = StringToText("· 如果发生了不寻常的死亡（例如刺客或教父导致的），可以说服大家相信你的虚假声明是真的。更大胆的是！");
    g_tipLine[19335] = StringToText("  如果像修补匠、赌徒或祖母这样的善良玩家在夜晚死亡，你可以说服别人，你的声明不仅是真实的，而且修补匠、");
    g_tipLine[19336] = StringToText("  赌徒或祖母可能在撒谎。");
    g_tipLine[19337] = StringToText("【伪装成侍臣】");
    g_tipLine[19338] = StringToText("当你要伪装成侍臣的时候，这里有几件事你应该记住：");
    g_tipLine[19339] = StringToText("· 过几天再声称你是侍臣，或者至少等几天再声称已经使用了你的能力。这就是真正的侍臣通常会做的事情。另外，请记住，");
    g_tipLine[19340] = StringToText("  真正的侍臣会选择一个角色去醉酒，而不是选择一个玩家。");
    g_tipLine[19341] = StringToText("· 假装自己是侍臣最简单方法是声称已对恶魔或爪牙使用过侍臣能力，然后没有明显效果。例如，声称你在普卡上使用了你的");
    g_tipLine[19342] = StringToText("  能力，但由于夜晚仍然发生了死亡，你一定是猜错了恶魔。 “弄错”对于侍臣来说是很常见的，");
    g_tipLine[19343] = StringToText("  所以只要别的玩家对在场的邪恶角色不明，你就看起来并不可疑。");
    g_tipLine[19344] = StringToText("· 假装醉酒“成功”可能更具破坏性，但也更具风险。如果你可以让团队相信你是侍臣，而且你已经醉酒了游戏中邪恶角色的");
    g_tipLine[19345] = StringToText("  能力，那么其他玩家将非常不愿意处决你。嗯，不错的骗术。");
    g_tipLine[19346] = StringToText("· 如果你声称选择了实际在场的恶魔，或者至少是善良玩家认为在场的恶魔，那么你可能需要与恶魔商量一下，");
    g_tipLine[19347] = StringToText("  夜晚最好不要死亡。醉酒的恶魔不能杀人，所以为了看起来你真的对恶魔做了这件事，恶魔要么不杀人，");
    g_tipLine[19348] = StringToText("  要么有其他的夜晚死亡原因，比如造谣者或修补匠。特别是如果你在游戏后期这样做的话 ，这种策略对你来说很可能获得");
    g_tipLine[19349] = StringToText("  游戏的胜利。如果善良玩家认为恶魔醉酒了，他们可能不会在只剩下3或4（甚至5或6）名玩家活着的情况下处决任何人，");
    g_tipLine[19350] = StringToText("  而像沙巴洛斯或珀这样的精明恶魔可以在那个时候杀死多个玩家。");
    g_tipLine[19351] = StringToText("· 假装将关键角色的能力排除在游戏之外，从而让善良玩家不去考虑他们。如果你是主谋，你可以自称是选择主谋的侍臣，");
    g_tipLine[19352] = StringToText("  这意味着当你的能力在恶魔死后第二天夺取胜利时，他们将完全措手不及。如果你是普卡，你可以声称是让普卡醉酒的侍臣，");
    g_tipLine[19353] = StringToText("  当夜晚死亡持续时，这会让团队相信另一个恶魔在场，他们会完全忽略这种普卡带来的中毒。真不错。");
    g_tipLine[19354] = StringToText("【伪装成教授】");
    g_tipLine[19355] = StringToText("当你要伪装成教授的时候，这里有几件事你应该记住：");
    g_tipLine[19356] = StringToText("· 你不能复活任何人。准备好解释你的能力失败的原因。教授通常比黯月初升剧本中的其他善良角色更难虚张声势，");
    g_tipLine[19357] = StringToText("  所以你需要提前考虑。");
    g_tipLine[19358] = StringToText("· 声称在别的玩家认为可疑的玩家身上使用了你的教授能力。你可以声称想要“测试”以查看他们是否真的是镇民。");
    g_tipLine[19359] = StringToText("  选择一个可疑的玩家更有可能让你看起来像个善良玩家，所以如果你是一个恶魔而不是一个爪牙，那么这个方法会更有用。");
    g_tipLine[19360] = StringToText("· 声称在值得信赖的善良玩家身上使用了你的能力。当什么都没有发生时，小组会假设（除非你能说服他们你因为某种原因醉");
    g_tipLine[19361] = StringToText("  酒或中毒了）你们中的一个是邪恶的。很可能的是那名玩家是受信任的，而你不是。如果你是一个爪牙，");
    g_tipLine[19362] = StringToText("  这个策略会更有用，因为被处决通常是一件好事。");
    g_tipLine[19363] = StringToText("· 如果恶魔是沙巴洛斯，而玩家在夜晚被反刍，这可能看起来与教授复活某人相同。如果你认为这可能会发生，");
    g_tipLine[19364] = StringToText("  或者如果你机智敏捷并且可以在早上声称昨晚的被复活的玩家是由于你的能力，你可以说服别的玩家你有效地使用了你的能");
    g_tipLine[19365] = StringToText("  力。如果反刍的玩家实际上是爪牙，这将造成双重破坏。");
    g_tipLine[19366] = StringToText("· 如果你是一名善良的玩家，自称教授并且已经使用自己的能力（但没有发生任何事情），可能是保持足够长的生命以使用你");
    g_tipLine[19367] = StringToText("  的实际能力的好方法。恶魔通常对攻击失去能力的教授不感兴趣，因为他们不再是威胁。例如，如果你是侍臣，");
    g_tipLine[19368] = StringToText("  但想确保你能活到足够长的时间来确保你的能力没有中毒，那么声称自己不再有能力的教授通常会让你活得足够长。");
    g_tipLine[19369] = StringToText("【伪装成吟游诗人】");
    g_tipLine[19370] = StringToText("当你要伪装成吟游诗人的时候，这里有几件事你应该记住：");
    g_tipLine[19371] = StringToText("· 吟游诗人是一个很好的“掩护”。除了经常提醒人们您是吟游诗人之外，你无需做太多事情。一些优秀的玩家会伪装成吟游");
    g_tipLine[19372] = StringToText("  诗人来掩盖他们是驱魔人的事实，你也可以这么做。");
    g_tipLine[19373] = StringToText("· 如果你是邪恶方，每场游戏至少这么做一次——避免恶魔在晚上杀人。如果没有其他死亡发生，这将模拟真正的吟游诗人在");
    g_tipLine[19374] = StringToText("  场和爪牙被处决时发生的情况。如果你在一个可疑玩家被处决后这样做，你不仅证实了团队对该玩家是爪牙的怀疑，");
    g_tipLine[19375] = StringToText("  而且你还让团队相信他们当晚喝醉了——这给获取夜间信息和反馈的角色会带来巨大的麻烦，例如驱魔人、侍女、");
    g_tipLine[19376] = StringToText("  赌徒甚至月之子。");
    g_tipLine[19377] = StringToText("· .如果你声称自己是吟游诗人，而一个邪恶的玩家被处决，那么当晚恶魔正常杀人是让团队相信被处决的玩家是好人的好方");
    g_tipLine[19378] = StringToText("  法。你甚至可能不需要说更多的话，就说你是吟游诗人 - 让他们自己解决剩下的问题。");
    g_tipLine[19379] = StringToText("· 鼓励处决——当然是对你和你的恶魔以外的玩家处决。");
    g_tipLine[19380] = StringToText("· 如果真正的吟游诗人在场，而你是恶魔，可以降低杀人频率，这样可以让吟游诗人判断失误。如果一个吟游诗人假设他们处");
    g_tipLine[19381] = StringToText("  决了一个爪牙，而他们实际上处决了一个镇民，那么不仅镇民看起来很邪恶，而其他玩家也会认为他们今晚喝醉了（由于吟");
    g_tipLine[19382] = StringToText("  游诗人的能力），虽然他们可能完全清醒。");
    g_tipLine[19383] = StringToText("【伪装成茶艺师】");
    g_tipLine[19384] = StringToText("当你要伪装成茶艺师的时候，这里有几件事你应该记住：");
    g_tipLine[19385] = StringToText("· 如果你的两个活着的邻居都是善良的，尽你最大的努力让他们中的一个或两个被处决。如果善良阵营队认为你是茶艺师，");
    g_tipLine[19386] = StringToText("  他们通常会热衷于处决你的邻居，以获取有关他们阵营的信息。如果可以的话，请继续这样做，直到你没有善良的邻居。");
    g_tipLine[19387] = StringToText("· 如果你的一个或两个活着的邻居是邪恶的，最好安全行事并采取行动让他们继续活着。比起杀死你的邻居，");
    g_tipLine[19388] = StringToText("  善良阵营更想要杀死恶魔，所以你有一些回旋余地。");
    g_tipLine[19389] = StringToText("· 选择何时透露你是茶艺师是至关重要的。如果你透露得太早，善良阵营之后可能会想知道为什么在恶魔杀死其他玩家4或5");
    g_tipLine[19390] = StringToText("  个晚上之后你还活着。如果你透露得太晚，善良阵营可能会怀疑你太沉默了，找到中间点。");
    g_tipLine[19391] = StringToText("· 如果有魔鬼代言人在场，让他挑选一个你身边还活着的邻居，然后在第二天处决那个玩家。这看起来就像你是茶艺师，");
    g_tipLine[19392] = StringToText("  用能力拯救了一个好玩家。如果你使用此策略，请尽量确保发生的事如你预期。如果你看起来像茶艺师，");
    g_tipLine[19393] = StringToText("  并且让团队相信你的两个活着的邻居也很好，那么善良团队会热衷于处决除了你们三个之外的其他人。");
    g_tipLine[19394] = StringToText("· 如果大家认为你是茶艺师，你需要以对你有帮助的方式引导大家的处决。如果你和恶魔之间的存活玩家越来越少，");
    g_tipLine[19395] = StringToText("  你离恶魔越来越近，会很危险。如果恶魔以逆时针方向靠近您，通常顺时针执行更好，如果恶魔以顺时针方向靠近您，");
    g_tipLine[19396] = StringToText("  则逆时针执行。");
    g_tipLine[19397] = StringToText("【伪装成和平主义者】");
    g_tipLine[19398] = StringToText("当你要伪装成和平主义者的时候，这里有几件事你应该记住：");
    g_tipLine[19399] = StringToText("· 你可以一开始保持沉默，用和平主义者作为备用虚张声势。大多数和平主义者会等待几天才表明他们的角色，");
    g_tipLine[19400] = StringToText("  所以你的做法会看起来很正常。或者，如果之前伪装别的角色不太顺利，可以后期切换伪装为和平主义者。");
    g_tipLine[19401] = StringToText("· 如果玩家被处决并且没有死亡，立即声称自己是和平主义者！善良的团队可能会开始拼凑出那个玩家为什么没有死的谜题，");
    g_tipLine[19402] = StringToText("  在这个时候，你看起来非常值得信赖。即使善良的团队弄清楚了玩家活着的原因（由于诸如“弄臣”、“茶艺师”、");
    g_tipLine[19403] = StringToText("  “魔鬼代言人”或“水手”之类的事情），你仍然看起来值得信赖，因为这并没有使你的虚张声势无效。");
    g_tipLine[19404] = StringToText("· 如果你活到最后，没有人在处决中活下来，那你可以假装责怪说书人没有让你的能力触发。因为有时候当善良阵营大有优势");
    g_tipLine[19405] = StringToText("  时，说书人不会激活和平主义者的能力，从而帮助邪恶阵营。这是一件完全合理的事情，虽然不常见，");
    g_tipLine[19406] = StringToText("  但是这个做法是合理的。当然，如果你实际上是一个爪牙，并且希望在后期替恶魔赴死，那么可以忽视这段话，");
    g_tipLine[19407] = StringToText("  不然情况可能会变糟糕。");
    g_tipLine[19408] = StringToText("【伪装成弄臣】");
    g_tipLine[19409] = StringToText("当你要伪装成弄臣的时候，这里有几件事你应该记住：");
    g_tipLine[19410] = StringToText("· 如果你是善良玩家，伪装成会弄臣非常有用！驱魔人、侍女、侍臣、旅店老板等角色，都希望寻找恶魔转而去选择其他玩家。");
    g_tipLine[19411] = StringToText("  大多数恶魔玩家也都想避免攻击弄臣。");
    g_tipLine[19412] = StringToText("· 如果你是邪恶的，那么当你最初的伪装被看穿后，弄臣可以作为备用的伪装。而善良玩家甚至可以同时伪装成弄臣和其他角");
    g_tipLine[19413] = StringToText("  色，邪恶的队伍不会知道你是谁！弄臣是善良玩家非常适合伪装的角色，同时也是邪恶玩家很好的伪装。尽情发挥吧！");
    g_tipLine[19414] = StringToText("· 如果你在公开场合伪装成弄臣，愚蠢的新玩家可能会试图处决你以“证明”你的角色。这种策略可能看起来很有用，");
    g_tipLine[19415] = StringToText("  有时也确实有用，但在大多数情况下，弄臣被处决存活后，很可能他当晚会被杀。大多数弄臣通过吸引恶魔而被杀是最佳状");
    g_tipLine[19416] = StringToText("  态。如果玩家认为你应该被处决，那就反驳吧！弄臣的能力最好在晚上发挥。");
    g_tipLine[19417] = StringToText("· 如果有魔鬼代言人在场，可以在处决时模拟“弄臣”能力。如果受到魔鬼代言人的保护，你可以在处决中幸存下来……但你");
    g_tipLine[19418] = StringToText("  需要协调才能找到正确的时机。");
    g_tipLine[19419] = StringToText("· 如果一个邪恶的玩家伪装成弄臣，不要杀了他们！即使你是恶魔，或者像刺客或教父这样的爪牙，");
    g_tipLine[19420] = StringToText("  你可以在晚上杀死一个爪牙，让他们博取善良阵营的信任。但是，如果对伪装成弄臣的邪恶玩家这样做，");
    g_tipLine[19421] = StringToText("  则会产生相反的效果。忌杀邪恶阵营的假弄臣。");
    g_tipLine[19422] = StringToText("【伪装成修补匠】");
    g_tipLine[19423] = StringToText("当你要伪装成修补匠的时候，这里有几件事你应该记住：");
    g_tipLine[19424] = StringToText("· 伪装成修补匠很容易……直到大家开始质疑你为什么还活着。如果可能的话，通过死亡来帮助你完成伪装。如果你是爪牙，");
    g_tipLine[19425] = StringToText("  或者你是僵怖，再或者如果你是一个有主谋的恶魔，你可以随意死亡（最好是在晚上）让你的伪装看起来合理。");
    g_tipLine[19426] = StringToText("· 如果你确实在晚上死去，那就怪罪于你的“能力”来混淆大家。如果善良玩家认为你是因为修补匠能力而死，");
    g_tipLine[19427] = StringToText("  那么他们将不确定哪个恶魔在场，以及有哪些其他导致死亡的角色也在场，例如赌徒、造谣者或祖母。");
    g_tipLine[19428] = StringToText("· 如果你长时间活着，就直接声称说书人是故意不杀你的，目的是显得你不是修补匠。毕竟说书人有时就是那么讨厌，");
    g_tipLine[19429] = StringToText("  而他们认为这很“有趣”而且做得对。");
    g_tipLine[19430] = StringToText("· 说书人会运行一个平衡的游戏，这意味着当只有3名玩家还活着时，修补匠不会为了让邪恶获胜被说书人随机杀死。");
    g_tipLine[19431] = StringToText("  你可以在游戏快结束时，利用这一点给邪恶团队带来优势。");
    g_tipLine[19432] = StringToText("· 如果你伪装成了修补匠，而真正的修补匠开始似乎在嘲弄你，那么最好改变你的伪装。如果说书人在白天杀死了真正的修补");
    g_tipLine[19433] = StringToText("  匠（说书人可能这样做，虽然可能这么做不太好），那么这将证实对方确实是修补匠，而你在撒谎。准备好你的后备计划。");
    g_tipLine[19434] = StringToText("【伪装成月之子】");
    g_tipLine[19435] = StringToText("当你要伪装成月之子的时候，这里有几件事你应该记住：");
    g_tipLine[19436] = StringToText("· 伪装成月之子，让善良的玩家害怕处决你。许多善良玩家将不愿意处决月之子，如果你死了，另一个善良玩家可能因你死亡，");
    g_tipLine[19437] = StringToText("  这足以阻止他们投票给你。");
    g_tipLine[19438] = StringToText("· 比起仅仅说如果你死了你也可能会杀死另一个玩家更好的选择是，具体地报出如果你死了你会选择谁。例如，");
    g_tipLine[19439] = StringToText("  如果玩家正在讨论是否处决你，你可以声称如果你死了，你打算选择声称是旅店老板的玩家。毕竟——你将不得不选择一个");
    g_tipLine[19440] = StringToText("  人。这可能足以让旅店老板以及任何其他想要让旅店老板活着的玩家不投票处决你。");
    g_tipLine[19441] = StringToText("· 月之子是一个有趣的伪装，一旦你死了就可以表露出来。如果你在此之前一直对自己的角色保持沉默，");
    g_tipLine[19442] = StringToText("  或者如果您想在死后改变自己的伪装，那么月之子是一个不错的选择。当你死了，你自称是月之子，假装诅咒玩家。");
    g_tipLine[19443] = StringToText("  无论该玩家是否死去，善良阵营都会倾向于关注你的能力，而忽略其他更重要的信息。");
    g_tipLine[19444] = StringToText("· 到了诅咒玩家的时候——选择一个善良玩家，并与其他邪恶的玩家协调，让这个玩家度过夜晚。例如，如果您选择茶艺师，");
    g_tipLine[19445] = StringToText("  那么他们会活过今晚，第二天他们会看起来很邪恶，从而可能被处决。");
    g_tipLine[19446] = StringToText("· 到了诅咒玩家的时候——选择一个邪恶的玩家，并与其他邪恶的玩家协调，让这个玩家今晚死去。恶魔、");
    g_tipLine[19447] = StringToText("  刺客或教父都可以杀死这个玩家，这会让这个邪恶的玩家看起来是善良玩家。这种策略会失去一个邪恶同伴，");
    g_tipLine[19448] = StringToText("  但有时向善良团队提供错误信息比让邪恶的玩家活着更重要。");
    g_tipLine[19449] = StringToText("【伪装成莽夫】");
    g_tipLine[19450] = StringToText("当你要伪装成莽夫的时候，这里有几件事你应该记住：");
    g_tipLine[19451] = StringToText("· 莽夫可能是一个棘手的伪装。你可能想在游戏上半场保持沉默，或者在开始时伪装成其他角色。大多数在游戏早期作为莽夫");
    g_tipLine[19452] = StringToText("  出现的莽夫都被善良阵营处决，因为善良阵营害怕莽夫会变坏并成为祸根。好消息是，对你的角色保持沉默几天可以让你观");
    g_tipLine[19453] = StringToText("  察和倾听，并注意那些会让你的莽夫伪装更可信的事情，比如谁在夜间死去，以及哪个“在夜晚行动的”角色正在发挥作用。");
    g_tipLine[19454] = StringToText("  ");
    g_tipLine[19455] = StringToText("· 如果你像莽夫一样虚张声势，善良阵营会想知道你什么时候变坏，什么时候变好。每次你变坏时，");
    g_tipLine[19456] = StringToText("  当晚死亡人数通常会减少——因为邪恶的玩家攻击了你，没有人因为他们的能力而死亡。如果善良团队要相信你，");
    g_tipLine[19457] = StringToText("  就需要好好选择你“变坏”的夜晚。此外，如果您要令人信服地声称你在那天晚上再次变得善良，");
    g_tipLine[19458] = StringToText("  你将需要知道哪些善良玩家在那些晚上选择了你。你可以要求善良的玩家在晚上选择你，这样你就变善良了，");
    g_tipLine[19459] = StringToText("  或者你可以在能力未正常生效的玩家提到他们在晚上选择了你之后简单地声称你变善良了。");
    g_tipLine[19460] = StringToText("· 一个风险更大但有时会奏效的策略是在游戏早期告诉团队你是邪恶的莽夫 。由于莽夫在活着时可以多次更改阵营，");
    g_tipLine[19461] = StringToText("  但他们死后会停止更改阵营（因为没有能力），因此被处决的邪恶莽夫将在游戏的剩余时间里保持邪恶。");
    g_tipLine[19462] = StringToText("  这意味着让邪恶的莽夫存活几天符合善良团队的利益，希望莽夫会再次变善良。不同寻常的是，执行善良莽夫并保留邪恶莽");
    g_tipLine[19463] = StringToText("  夫对好团队是有好处的存在……至少在游戏的早期阶段。你可以通过在游戏早期声称自己是邪恶的莽夫，");
    g_tipLine[19464] = StringToText("  然后在游戏后期声称自己是善良莽夫来利用这一点。");
    g_tipLine[19465] = StringToText("【伪装成疯子】");
    g_tipLine[19466] = StringToText("当你要伪装成疯子的时候，这里有几件事你应该记住：");
    g_tipLine[19467] = StringToText("· 首先作为一个不同的角色虚张声势。在“弄清楚”你是个疯子之前，表现得像一个恶魔去行动一会。");
    g_tipLine[19468] = StringToText("  即使您选择的虚张声势复制了游戏中的善良角色，这也可以实现。毕竟......一个真正的疯子经常被展示到游戏中角");
    g_tipLine[19469] = StringToText("  色作为虚张声势。");
    g_tipLine[19470] = StringToText("· 真诚是关键。虽然大多数其他角色可以冷淡地提供他们的信息，但疯子往往会有明显的情绪反应——“啊哈！”");
    g_tipLine[19471] = StringToText("   那一刻——当他们发现自己是疯子的时候。对于某些人来说，这种情绪反应很难伪装，但你比这更有才华。");
    g_tipLine[19472] = StringToText("  你知道如何在你的话语中加上一点魅力，你知道它在让善良阵营相信你是善良的方面是多么有效。");
    g_tipLine[19473] = StringToText("· 如果你以疯子的角色出现，那么善良阵营会想知道您得知的爪牙是哪些玩家。这是您需要事先考虑的事情 - 选择适当数");
    g_tipLine[19474] = StringToText("  量的善良玩家，并私下接近他们，问他们“你是我的爪牙吗？”。当他们说“不”时，他们会说“不”，");
    g_tipLine[19475] = StringToText("  因为他们是善良的玩家，当你后来成为疯子时，这会给你更多的可信度。");
    g_tipLine[19476] = StringToText("· 另一种错误地声称自己是疯子的方法是，当你公开自己的角色时，将你的真实爪牙透露给其他人。");
    g_tipLine[19477] = StringToText("  告诉团队你私聊了你的（实际）爪牙，但他们声称不是你的爪牙……这使您确信自己是疯子。");
    g_tipLine[19478] = StringToText("· 如果您声称自己是疯子，善良阵营可能想知道您在夜间试图攻击哪些玩家。你可以声称攻击了恶魔攻击过的同一个玩家，");
    g_tipLine[19479] = StringToText("  也可以声称攻击了不同的玩家。它是由你决定。");
    g_tipLine[19480] = StringToText("· 如果你是爪牙。真正的恶魔为了确认自己是不是疯子而通过私聊找你确认，你可以告诉他你不是爪牙。");
    g_tipLine[19481] = StringToText("  如果恶魔的爪牙声称自己不是爪牙，那么恶魔将完全相信他们是疯子，并且他们告诉团队他们是善良的诚意将是显而易见的。");
    g_tipLine[19482] = StringToText("  毕竟，如果你真的相信自己是疯子，那么虚张声势并不难！你总是可以在游戏后期告诉恶魔真相，");
    g_tipLine[19483] = StringToText("  在他们说服善良阵营他们是疯子之后，这样他们就拥有了赢得胜利所需的所有信息。");
    g_tipLine[19484] = StringToText("【伪装成钟表匠】");
    g_tipLine[19485] = StringToText("当你要伪装成钟表匠的时候，这里有几件事你应该记住：");
    g_tipLine[19486] = StringToText("· 作为钟表匠，最普通也最简单的伪装方法就是在第一天的时候告诉大家错误的信息。因为你知道恶魔和爪牙之间相互的距离，");
    g_tipLine[19487] = StringToText("  而这个错误的信息很可能在几天里使善良阵营的玩家们陷入困惑。请记住\"1\"表示恶魔和爪牙相邻。");
    g_tipLine[19488] = StringToText("· 提供正确的钟表匠信息实际上对于邪恶阵营也非常有帮助。如果大家认为你是善良的，选择相信你的信息，");
    g_tipLine[19489] = StringToText("  那么他们可能就不会在使用钟表匠信息的时候把你当做是爪牙或者恶魔，也因此他们无法发现谁实际上会是恶魔。");
    g_tipLine[19490] = StringToText("  如果他们认为你是邪恶的，那么他们很有可能会认为你给出的是错误的信息，因此也会阻碍他们找到真正的恶魔。");
    g_tipLine[19491] = StringToText("· 如果你是恶魔选择要伪装成钟表匠，那么在第一天活下来显得尤为重要。作为梦殒春宵中唯一一个在首夜就能得到信息的角");
    g_tipLine[19492] = StringToText("  色，并且无法再获取任何信息，善良阵营的玩家们将更倾向于在第一天将钟表匠处决掉。等到第二天或之后，");
    g_tipLine[19493] = StringToText("  你再揭示你钟表匠的角色，将有助于你从游戏早期、风险更大的时期中活下来。");
    g_tipLine[19494] = StringToText("· 提供假信息时，选择提供小数字可能更好。如果你提供的数字快要到人数的一半了，这就暗示了恶魔和爪牙实际基本面对面");
    g_tipLine[19495] = StringToText("  而坐了。此外，如果本局有多个爪牙，那么较大的数字就意味着这些爪牙都坐在一起了，而玩家们很可能不会相信这一点。");
    g_tipLine[19496] = StringToText("  较小的数字可以和较大数字一样令人困惑。所以，请慎重考虑你将要选择的数字。");
    g_tipLine[19497] = StringToText("· 由于善良阵营的玩家们很容易通过爪牙能力所表现的现象消失来推测谁是爪牙，所以在夜晚杀死爪牙不是一个明智的选择。");
    g_tipLine[19498] = StringToText("  例如，善良阵营的玩家会认为他们处决了麻脸巫婆（因为他们发现没有人再发生角色改变），那么去杀死可能证明或反驳你");
    g_tipLine[19499] = StringToText("  的钟表匠信息的会是恶魔的玩家会让你很难受，然而如果你在晚上杀死了麻脸巫婆，那么善良玩家们更倾向于认为他们在白");
    g_tipLine[19500] = StringToText("  天确实处决了麻脸巫婆。这可能会帮助或阻碍你的目标，取决于善良玩家们相信什么，尤其是是否相信涡流在场。");
    g_tipLine[19501] = StringToText("【伪装成筑梦师】");
    g_tipLine[19502] = StringToText("当你要伪装成筑梦师的时候，这里有几件事你应该记住：");
    g_tipLine[19503] = StringToText("· 第一天是最艰难的。如果你第一天很早就透露了你是谁。你需要再别人透露他们角色前透露他们的角色。");
    g_tipLine[19504] = StringToText("  如果你选择一个邪恶同伴，寄希望于他能配合你来使你伪装这个角色，这将容易很多。如果你是恶魔这将会特别成功，");
    g_tipLine[19505] = StringToText("  因为你知道3个不在场的善良角色。例如，你声明自己是筑梦师，然后声明你的爪牙是城镇公告员或者方古，");
    g_tipLine[19506] = StringToText("  如果他声明自己是城镇公告员，那么这会使你看起来确实是筑梦师。");
    g_tipLine[19507] = StringToText("· 如果你选择了一名玩家，但不知道他的角色是什么，去鼓励他们透露他们的角色，然后故作明智的点点头说\"和我预期的一");
    g_tipLine[19508] = StringToText("  样\"，或者用别的什么方式去确认他的角色。善良玩家很少会伪装自己的角色，所以经常会在简单的阐述或被提名时就透露");
    g_tipLine[19509] = StringToText("  自己的角色。");
    g_tipLine[19510] = StringToText("· 假装去选择那些已经透露角色的玩家。这样，你可以使你在那些玩家眼中是善良的。例如，相比于告诉钟表匠他是杂耍艺人");
    g_tipLine[19511] = StringToText("  或女巫，如果你告诉他他是钟表匠或亡骨魔，那么钟表匠更可能会认为你是善良的。");
    g_tipLine[19512] = StringToText("· 如果你想让善良阵营看起来可疑，哪怕自己受到怀疑的风险，那么你可以这样做来降低自己的风险，");
    g_tipLine[19513] = StringToText("  告诉大家你知道他的角色是一个很神秘的角色，一个不想向大家透露自己的角色，比如贤者、畸形秀演员、");
    g_tipLine[19514] = StringToText("  心上人或呆瓜等。即使这名善良玩家否认自己是其中之一，但善良玩家们会可能认为你确实是那个得到有用信息的筑梦师。");
    g_tipLine[19515] = StringToText("· 如果你声明一个玩家是某一爪牙，那么请确保你知道有哪些爪牙在场，这些爪牙通常是想要去提供的。例如，");
    g_tipLine[19516] = StringToText("  如果只有一个爪牙在场，而有人由于提名死去，所有人都知道那个爪牙是女巫。如果你声明某一个玩家是卖花女孩或洗脑师");
    g_tipLine[19517] = StringToText("  并不会使你得到大家的信任。说书人通常应该向筑梦师展示在场的爪牙以便迷惑他。");
    g_tipLine[19518] = StringToText("· 当提供一个善良玩家的信息时，优先透露他们可能是恶魔而不是爪牙。因为善良玩家们更可能去怀疑谁可能是恶魔然后更有");
    g_tipLine[19519] = StringToText("  可能去处决他们。");
    g_tipLine[19520] = StringToText("· 当提供关于邪恶玩家的信息时，优先透露他们可能是爪牙。因为善良玩家们相比处决恶魔或爪牙，");
    g_tipLine[19521] = StringToText("  更倾向于处决可能是恶魔的玩家。");
    g_tipLine[19522] = StringToText("· 等待几天再表明自己的筑梦师角色。这会给你足够的时间来把事情讲清楚。");
    g_tipLine[19523] = StringToText("· 绝对不要说你得知一名玩家可能是涡流！因为如果涡流在场，你的信息必然会是错的。");
    g_tipLine[19524] = StringToText("【伪装成舞蛇人】");
    g_tipLine[19525] = StringToText("当你要伪装成舞蛇人的时候，这里有几件事你应该记住：");
    g_tipLine[19526] = StringToText("· 等待几天再表明自己是舞蛇人。你可以保持沉默或者去伪装成另一个善良角色。这也是通常舞蛇人会做的。");
    g_tipLine[19527] = StringToText("· 提前准备好你的信息。一旦你选择声明你是舞蛇人，其他人会想要知道你在每天晚上都选择了谁。");
    g_tipLine[19528] = StringToText("  请记住舞蛇人是在首夜就开始行动的。如果你告诉了大家你的信息，那么他们才更可能会信任你。");
    g_tipLine[19529] = StringToText("· 当你告诉大家你晚上选择的玩家时，至少要有一部分玩家是你没有被选择过的。如果你告诉大家除了某一个人其他人都被选");
    g_tipLine[19530] = StringToText("  过，那么这个玩家必定会是恶魔——当他被处决后如果游戏继续，那么你必定撒谎了。但是，如果善良玩家们认为有3名玩");
    g_tipLine[19531] = StringToText("  家有可能是恶魔，即使他们中的一人被处决后游戏继续，也不会让你显得可疑。");
    g_tipLine[19532] = StringToText("· 与那些你假装选择过的玩家建立信任关系。玩家们通常会相信那些相信自己的人。当你声明某位玩家肯定不是恶魔时，");
    g_tipLine[19533] = StringToText("  这更能使他站在你这边。");
    g_tipLine[19534] = StringToText("· 声明你选择的玩家时可以选择一个邪恶玩家。如果善良阵营相信你是舞蛇人，那么他们会相信你选择的玩家不是恶魔，");
    g_tipLine[19535] = StringToText("  就更可能会让他活下来。");
    g_tipLine[19536] = StringToText("· 如果你是恶魔，你可以声明你被舞蛇人给交换了，你现在是善良阵营！当然，这样做有很大的风险，");
    g_tipLine[19537] = StringToText("  因为任何之前的恶魔都有可能会保险起见而被处决掉，但是如果你在游戏晚期的时候这么做就会比较有效。");
    g_tipLine[19538] = StringToText("  你可以计划着这样去做或者把这个作为一个在危机中的备用手段。如果你真的被舞蛇人交换了，那么你现在是善良的，");
    g_tipLine[19539] = StringToText("  而原来的舞蛇人变为了邪恶的恶魔，所以他必然伪装成另一个角色-这也就说明你可以声明你现在是一个变好了的恶魔。");
    g_tipLine[19540] = StringToText("  如果你选择这样做，准备好告诉大家你的爪牙们是谁。善良玩家会想要知道你的爪牙们是谁，你可以根据自己的喜好来决定");
    g_tipLine[19541] = StringToText("  提供正确或错误的信息。");
    g_tipLine[19542] = StringToText("· 如果你是爪牙，你可以声明你被舞蛇人给交换了！这很疯狂！但如果你这么做，善良玩家会想要知道你的爪牙们是谁，");
    g_tipLine[19543] = StringToText("  而你会面临艰难的抉择。你会告诉除了恶魔之外的其他玩家都是你的爪牙吗？如果你认为善良玩家会选择处决爪牙，");
    g_tipLine[19544] = StringToText("  就这么做吧。如果你期望好人们不会处决爪牙，而是会去优先找恶魔？那么你也可以告诉大家恶魔是你爪牙。");
    g_tipLine[19545] = StringToText("【伪装成数学家】");
    g_tipLine[19546] = StringToText("当你要伪装成数学家的时候，这里有几件事你应该记住：");
    g_tipLine[19547] = StringToText("1.提供更小的数字。如果你告诉大家你的信息是\"4\"、\"3\"甚至\"2\"都会显得很可疑。大部分的时候，");
    g_tipLine[19548] = StringToText("  真正的数学家会在晚上得到0或者1。");
    g_tipLine[19549] = StringToText("2.仔细思考你在首夜提供的信息。因为首夜行动的玩家很少，所以给出0会显得更安全。有时候，给1也是可行的");
    g_tipLine[19550] = StringToText("3.注意言行一致。如果你一直提供的数字是2，那么你可以继续告诉大家是2.如果你之前告诉大家是0，");
    g_tipLine[19551] = StringToText("  表明没有玩家的能力发生预期之外的情况，而突然你的数字变为1，会让大家对你关注到你。你可以有计划的逐步减少你的");
    g_tipLine[19552] = StringToText("  数字而不是增加你的数字——因为随着玩家死去，一些出现异常的情况会越来越少。");
    g_tipLine[19553] = StringToText("4.如果有一些特殊情况发生了，那么你需要将你的数字增加。例如，如果心上人死了，哲学家变为在场角色，");
    g_tipLine[19554] = StringToText("  如果这时你增加了数字，那么会让别人更确信你是数学家，也表明心上人和哲学家确实都说的实话。");
    g_tipLine[19555] = StringToText("5.如果你知道在场的恶魔是什么类型的，那么你可以给出与之匹配的信息。这会使你看起来更像是善良玩家。例如，");
    g_tipLine[19556] = StringToText("  如果你知道涡流在场（而且你认为善良玩家们已经或者即将指出），那么给出一个明显不合理的数字就会显得很合理。");
    g_tipLine[19557] = StringToText("  又或者，如果你知道方古在场（而且你认为善良玩家们已经或者即将指出），那么给出的数字可以暗示大家的能力都正常在");
    g_tipLine[19558] = StringToText("  运作。");
    g_tipLine[19559] = StringToText("6.如果你知道在场的恶魔是什么类型的，但是你认为善良玩家们不能指出这一点，那么你可以选择给出与恶魔类型冲突的数字。");
    g_tipLine[19560] = StringToText("  如果你可以使善良玩家们确信是另一种恶魔在场，那么他们将会非常困惑。例如，如果亡骨魔在场，你可以给1或者2，");
    g_tipLine[19561] = StringToText("  造成可能是诺-达鲺在场的错觉。");
    g_tipLine[19562] = StringToText("7.作为一个假的数学家，你很适合去掩护那些其他伪装角色的邪恶玩家。如果他们声明他们是一个善良角色并且怀疑他们的能");
    g_tipLine[19563] = StringToText("  力异常了，那么你可以给出1（或者更大）来使他的伪装更合理。");
    g_tipLine[19564] = StringToText("8.如果你是爪牙并且想让自己在游戏的后期被处决，那么作为数学家这也比较容易。你可以告诉大家你在某个得到的数字是0");
    g_tipLine[19565] = StringToText("  或1等显然不合逻辑的数字，那么善良玩家们会怀疑你并想要处决你，而最后，他们会发现你并不是恶魔。");
    g_tipLine[19566] = StringToText("【伪装成卖花女孩】");
    g_tipLine[19567] = StringToText("当你要伪装成卖花女孩的时候，这里有几件事你应该记住：");
    g_tipLine[19568] = StringToText("· 你所提供的信息将缩小恶魔可能的范围。如果你在第二天说在某五个人中有一个是恶魔，那么在下一天，");
    g_tipLine[19569] = StringToText("  很可能会变成某三个人中有恶魔，不要轻易的出卖你的队友。关注谁投票了谁没投票，尽可能让善良角色被杀死。");
    g_tipLine[19570] = StringToText("· 或者，如果你确实因此不小心牵连了你的伙伴，你可以尽可能让自己看起来更邪恶。假笑一下，去指控那些受到信任的玩家");
    g_tipLine[19571] = StringToText("  是邪恶玩家。或者故意扮演错你的角色。如果你看起来是邪恶的，那么善良阵营可能认为你想去隐害那些善良玩家。");
    g_tipLine[19572] = StringToText("  如果那些人之中有恶魔，那么你就达到你的目的了。");
    g_tipLine[19573] = StringToText("· 你可以直接指定大家需要用什么方式投票。如果你建议了谁应该投票谁不应该投票，那么在第二天你可以给出直接的信息。");
    g_tipLine[19574] = StringToText("  然而，通常恶魔会杀死这样表现的一个卖花女孩，所以为什么你一直能活着就会变得很可疑。");
    g_tipLine[19575] = StringToText("· 如果你是爪牙，你可以让恶魔在晚上将你杀死。因为死在夜里的玩家要比被处决的玩家更容易被信赖。");
    g_tipLine[19576] = StringToText("· 在你表明你是卖花女孩之前可以试着保持沉默几天。因为真正的卖花女孩通常会这样做，这会使你的角色更合情合理。");
    g_tipLine[19577] = StringToText("  或者你可以伪装成在前几天对游戏没有影响的角色，比如贤者或者心上人，然后再之后再说明你是卖花女孩。");
    g_tipLine[19578] = StringToText("· 如果你的第一次伪装失败，卖花女孩将会是一个不错的伪装角色。例如，你可以先伪装成许多角色，");
    g_tipLine[19579] = StringToText("  类似于杂耍艺人或者女裁缝，然后在游戏后期再说明自己其实是卖花女孩，而之前伪装的角色只不过是为了欺骗恶魔能让自");
    g_tipLine[19580] = StringToText("  己活下来而装的。");
    g_tipLine[19581] = StringToText("· 你可以表现很迷惑。卖花女孩有时是一个容易令人很困惑的角色。在一天中，可能会有很多玩家投票，");
    g_tipLine[19582] = StringToText("  甚至真正的卖花女孩也难以记住具体都有谁投票了，尤其是过了好几天。告诉大家你是卖花女孩，但是你记不住谁投票了，");
    g_tipLine[19583] = StringToText("  这有时也是有用的。当然，即便你每天故意提供相互矛盾的信息，也往往不会受到怀疑。");
    g_tipLine[19584] = StringToText("· 卖花女孩可以在某些情况下辨识出涡流在场。如果涡流在场，你认为善良阵营已经发现了，那么你可以考虑给出涡流对应的");
    g_tipLine[19585] = StringToText("  投票，因此善良玩家会将这个信息反转。");
    g_tipLine[19586] = StringToText("【伪装成城镇公告员】");
    g_tipLine[19587] = StringToText("当你要伪装成城镇公告员的时候，这里有几件事你应该记住：");
    g_tipLine[19588] = StringToText("· 运用你的能力去指挥大家谁去提名，去提名谁。善良玩家会渴望从你的信息中来证实他们不是爪牙，");
    g_tipLine[19589] = StringToText("  你可以利用这一点来要求玩家去提名。如果你是女巫或你们有女巫，这样会尤其的有效，因为你可以迫使别人提名……然后");
    g_tipLine[19590] = StringToText("  他们会死去。（如果你让他去提名导致了这一切，那么他可能会很不高兴~）");
    g_tipLine[19591] = StringToText("· 给出相反的信息来帮助你的队友看起来是善良的，让善良玩家看起来是邪恶的。也就是说当爪牙提名了，你说没有，");
    g_tipLine[19592] = StringToText("  当爪牙没有提名，你说有，这很简单。");
    g_tipLine[19593] = StringToText("· 在游戏后期，说明正确的信息来暴露你的爪牙队友。这会让你看起来更像是善良的，因为你在帮助大家处决邪恶玩家，");
    g_tipLine[19594] = StringToText("  善良阵营会更加的信任你。但是如果你越晚这样去做，他们也就越不可能去处决这个爪牙。");
    g_tipLine[19595] = StringToText("· 在最后一天（或接近最后一天）去暗示恶魔是爪牙。如果他们相信你，善良阵营的玩家们可能不太希望去浪费处决机会去处");
    g_tipLine[19596] = StringToText("  决看起来是爪牙的恶魔。不过切记不要过早这样去做，否则他们可能为了安全起见把恶魔处决了~");
    g_tipLine[19597] = StringToText("· 你是否有镜像双子队友呢？你可以告诉大家镜像双子中善良的那位触发了你的能力！虽然大家依然会谨慎的处决这名玩家，");
    g_tipLine[19598] = StringToText("  但这也可能只是抹黑这个善良玩家的第一步直到获取意想不到的胜利。");
    g_tipLine[19599] = StringToText("· 一旦所有爪牙都死了，就不要再去指控其他善良玩家是爪牙了。在梦殒春宵中，爪牙的行为会很公开，");
    g_tipLine[19600] = StringToText("  比如麻脸巫婆改变角色，女巫杀死提名的人。如果善良玩家发现没有这些明显的迹象了，那么他们会怀疑还在说有爪牙活着");
    g_tipLine[19601] = StringToText("  的城镇公告员。");
    g_tipLine[19602] = StringToText("【伪装成神谕者】");
    g_tipLine[19603] = StringToText("当你要伪装成神谕者的时候，这里有几件事你应该记住：");
    g_tipLine[19604] = StringToText("· 在死去的所有玩家都是善良的情况下告诉大家你得到的信息是1（或更大）。这将使死去的善良玩家不再能够得到信任，");
    g_tipLine[19605] = StringToText("  也意味着善良阵营很可能会忽视他们提供的信息。如果在只有一个爪牙在场的情况下并且爪牙运用一些方法让场上表现的已");
    g_tipLine[19606] = StringToText("  没有爪牙，那么这会很有帮助。比如，大家都知道女巫在游戏中，因为有玩家因为提名死去了，那么如果女巫每晚都选择诅");
    g_tipLine[19607] = StringToText("  咒自己，就会避免其他人因为女巫而死去，从而避免对你的信息的怀疑。");
    g_tipLine[19608] = StringToText("· 如果一个邪恶玩家死去，告诉大家现在死去的所有玩家都是善良的。这会使你已经死去的邪恶队友看起来像是善良的，");
    g_tipLine[19609] = StringToText("  而他所传播的其他错误信息也更有可能被大家相信。");
    g_tipLine[19610] = StringToText("· 你需要逐渐增加你得到的数字。善良阵营每天处决一个邪恶玩家是非常罕见的，所以如果你说你第二晚是1，第三晚是2，");
    g_tipLine[19611] = StringToText("  第四晚是3，那么这会显得很可疑。通常更可信的说法是，你在第二晚得到0，第三晚得到了1，第四晚仍然是1，");
    g_tipLine[19612] = StringToText("  第五晚还是1，第六晚是2之类的。");
    g_tipLine[19613] = StringToText("· 如果有其他种类的恶魔在场，你可以使其看起来像是亡骨魔或者方古才是真正的恶魔。在没有人怀疑的情况下，");
    g_tipLine[19614] = StringToText("  突然得知有邪恶玩家死亡，这会让人联想到有爪牙被亡骨魔杀死了。同样的，如果一个邪恶玩家说自己是外来者，");
    g_tipLine[19615] = StringToText("  你可以突然给出一个比正常情况更高的数字——这会使其看起来像是方古攻击了外来者然后死亡了。");
    g_tipLine[19616] = StringToText("  当然从长远来看这两种方案都有风险，但是会在短时间内造成很多混乱。");
    g_tipLine[19617] = StringToText("· 如果玩家们在特别怀疑某个善良玩家，并且这名善良玩家被处决了，那么这将是你把你的信息增加1的绝佳时机。");
    g_tipLine[19618] = StringToText("  这证实了善良玩家们的怀疑，也就是他们怀疑的那个玩家是邪恶的，他们这些笨蛋值得如此。");
    g_tipLine[19619] = StringToText("【伪装成博学者】");
    g_tipLine[19620] = StringToText("· 让你的信息简单一点！这不仅可以让你可以更容易伪装，而且如果善良玩家相信了你的信息会更容易破坏他们的逻辑。");
    g_tipLine[19621] = StringToText("  例如，试着给出这样的信息a)我的邻座有一个邪恶玩家b)本局游戏中有钟表匠。这样的陈述可以帮助你的恶魔（伪装成");
    g_tipLine[19622] = StringToText("  钟表匠的队友）或者污蔑你的邻座玩家。");
    g_tipLine[19623] = StringToText("· 你也可以给出复杂而混乱的信息！虽然这也许会比较困难，但你可能会使善良玩家们在试图搞清楚你的信息的同时将他们的");
    g_tipLine[19624] = StringToText("  注意力从其他邪恶玩家身上转移。例如，你的信息可以是a)有更多的邪恶玩家在离你更近的位置，");
    g_tipLine[19625] = StringToText("  或b)邪恶玩家们有一个善良玩家在他们中间。这些狡猾的说法可能需要一段时间才能够辨别。");
    g_tipLine[19626] = StringToText("· 向说书人咨询他一般会提供什么样的信息。不管如何，你每天都至少需要去找说书人——不同的说书人会根据他们的个人风");
    g_tipLine[19627] = StringToText("  格和游戏设置的不同而给出不同的信息。你不会从说书人那里得到具体的信息（因为你实际上不是博学者），");
    g_tipLine[19628] = StringToText("  但是说书人肯定会给你一些想法上的建议，或者有关在场人物或座位上的提示。");
    g_tipLine[19629] = StringToText("· 不要说的太过于具体——因为太具体的信息很容易被推翻。例如，如果你很确切的说\"张三是城镇公告员\"而他其实不是，");
    g_tipLine[19630] = StringToText("  那么你的另一条信息就必然会是真的……而如果另一条信息牵扯了你的邪恶阵营就会显得很麻烦。");
    g_tipLine[19631] = StringToText("· 你可以给出两个假信息或者两个真信息。例如那些你想要掩盖的真信息（比如关于你们邪恶阵营的）。要掩盖真相，");
    g_tipLine[19632] = StringToText("  你可以将其描述为明显像是真信息的假信息，或者你可以通过说两条假信息来破坏善良玩家们的逻辑思路。例如，");
    g_tipLine[19633] = StringToText("  如果恶魔是诺-达鲺，你可以说a)恶魔是诺-达鲺b)呆瓜是善良的。如果呆瓜已经被通过其他方式证实了他是善良玩家");
    g_tipLine[19634] = StringToText("  （例如他死后神谕者得知了关于他的信息），那么玩家通常会认为恶魔的类型不是诺-达鲺。");
    g_tipLine[19635] = StringToText("· 运用你的信息让善良玩家们相互猜忌！告诉大家坐在沙发上的玩家里有一个是邪恶的。或者声明一些相互矛盾的信息——例");
    g_tipLine[19636] = StringToText("  如，现在场上有一个筑梦师与哲学家，你可以这样说你的信息a)场上有一个筑梦师b)场上有一个哲学家。");
    g_tipLine[19637] = StringToText("  这会离间善良玩家，使他们相互怀疑，这不失为保护邪恶阵营和制造混乱的好方法。");
    g_tipLine[19638] = StringToText("· 给出那些会走向你期望的情况的信息。这可能会比较困难，但是如果你成功的话会得到对应的回报。");
    g_tipLine[19639] = StringToText("  这个方法的目的是提供一些在某些特征上重合的信息，无论大家接受哪条信息是真或假，都可以确保对于某件事情而言是真");
    g_tipLine[19640] = StringToText("  的或假的。例如，假设你想保护你的恶魔同伴，但他是女性玩家且坐在你旁边，那么你可以说a)恶魔是男性玩家b)我的");
    g_tipLine[19641] = StringToText("  两个邻座玩家都是善良的。这样无论大家认为哪一个是错的，都可能会漏掉原本的恶魔！");
    g_tipLine[19642] = StringToText("【伪装成女裁缝】");
    g_tipLine[19643] = StringToText("· 告诉大家某两位善良玩家是不同阵营的。如果幸运的话，他们之间会相互怀疑，而其他人也会同时对他们两个产生怀疑！");
    g_tipLine[19644] = StringToText("  这非常的棒。");
    g_tipLine[19645] = StringToText("· 如果一名玩家已经被大家证实或即将证实是善良玩家，那么你可以选择这么玩家和一名邪恶玩家，");
    g_tipLine[19646] = StringToText("  然后告诉大家他们是同一阵营的。如果大家相信这么玩家是善良的，他们也就会相信那么邪恶玩家是善良的。");
    g_tipLine[19647] = StringToText("· 你可以用你的能力去选择两名邪恶玩家，来让大家认为他们是善良玩家。如果大家无法辨别他们谁是善良的，谁是邪恶的，");
    g_tipLine[19648] = StringToText("  你可以告诉大家他们是同一阵营的，因为通常来讲，大家会认为如果是同一阵营的话那么他们更有可能都是善良玩家，");
    g_tipLine[19649] = StringToText("  因为女裁缝要同时选到两名邪恶玩家的可能性很低。比如，你可以告诉大家，麻脸巫婆和亡骨魔是同一阵营的，");
    g_tipLine[19650] = StringToText("  那么善良玩家们会以为他们都是善良玩家。");
    g_tipLine[19651] = StringToText("· 或者说，如果大家已经很确定某个玩家是邪恶的，你可以告诉大家你选择的是他和另一名邪恶玩家，");
    g_tipLine[19652] = StringToText("  并且得知他们是不同阵营的。如果大家认为开始认定的那名玩家是邪恶的，那么他们会认为另一名玩家是善良的。比如，");
    g_tipLine[19653] = StringToText("  如果大家相信有一名玩家是邪恶的女巫，你可以告诉大家你得知了这名玩家和诺-达鲺他们是不同阵营的玩家。");
    g_tipLine[19654] = StringToText("  如果幸运的话，善良玩家会相信诺-达鲺是一名善良玩家。而如果女巫能够读懂你的意思，他甚至可能会表现的更像是邪恶");
    g_tipLine[19655] = StringToText("  玩家，并且被大家处决，这样的话恶魔可以比较容易潜藏到胜利。");
    g_tipLine[19656] = StringToText("· 尽可能早一点声明你已经使用了能力。如果你是邪恶玩家，尤其是恶魔，你肯定会比一个真正的裁缝活的更久，但是，");
    g_tipLine[19657] = StringToText("  这并不是你在第六晚才使用你的能力的借口。因为任何一个真正的女裁缝，肯定会在游戏早期使用他们的能力，");
    g_tipLine[19658] = StringToText("  而不是冒着死亡的风险，在最后才使用。");
    g_tipLine[19659] = StringToText("· 请记住，女裁缝不能选择自己。他必须选择两名其他玩家。");
    g_tipLine[19660] = StringToText("【伪装成哲学家】");
    g_tipLine[19661] = StringToText("· 要否定某个角色的效果，你可以声明你选择了他的能力。你可以说你由于不知道这个角色是否在场而已经这样做了。");
    g_tipLine[19662] = StringToText("  或者你可以在有人说明他的角色后再这样做，你可以说你不相信他就是他说的那个角色，或者你可以说你只是想买个保险。");
    g_tipLine[19663] = StringToText("  比如，博学者在场，获得了大量信息。你可以说你当晚获得了博学者的能力，所以真正的博学者的信息变得不可靠，");
    g_tipLine[19664] = StringToText("  应该被忽略。而如果有人问起你为什么这么做的话，你可以说你认为博学者的能力很有用，而恶魔来不及去同时杀两个博学");
    g_tipLine[19665] = StringToText("  者，而且你也不确定那个博学者是否是真的。");
    g_tipLine[19666] = StringToText("· 如果你最初的伪装没有起效果，或者你伪装的角色和善良玩家重复了，那么哲学家就是一个好的伪装角色。");
    g_tipLine[19667] = StringToText("  如果有人说和你是同一个角色，那么你可以说你是哲学家，然后获得了这个角色的能力。");
    g_tipLine[19668] = StringToText("· 为了制造尽可能多的混乱，去选择那些能引起混乱的角色。伪装成博学者很艰难，你需要每天提供复杂的信息，");
    g_tipLine[19669] = StringToText("  但是会制造巨大的混乱。钟表匠比较简单，但是可以使善良玩家走上岔路。女裁缝和艺术家同样可以制造各种各样的混乱，");
    g_tipLine[19670] = StringToText("  而筑梦师和舞蛇人往往不会造成太多干扰而是帮助好人确认他们的信息从而使你自己很好的伪装下去。");
    g_tipLine[19671] = StringToText("· 与其告诉大家你选择了哪个角色，你也可以让大家来告诉你你应该去选什么角色。去询问他们认为哪个角色的收益最大。");
    g_tipLine[19672] = StringToText("  你也可以与一两个人私聊去秘密的询问，或者直接公开询问大家。善良玩家们会更容易去相信有帮助的玩家。");
    g_tipLine[19673] = StringToText("  没有什么比你听从他们的意见而选择角色更能让他们相信你有帮助了。");
    g_tipLine[19674] = StringToText("· 如果一个邪恶玩家伪装的那个角色没有伪装的很好，你可以说你获得了那个角色的能力。如果他们的信息不完整，");
    g_tipLine[19675] = StringToText("  善良玩家也相信你是哲学家的话，那么就很可能相信他就是那名角色，然后由于你选择了那个角色导致他醉酒了。");
    g_tipLine[19676] = StringToText("  如果他们仍然怀疑那名邪恶玩家，你也可以说你也怀疑那个玩家所以变成了那个角色。例如，一个爪牙伪装为卖花女孩，");
    g_tipLine[19677] = StringToText("  而他提供的信息有问题，善良玩家就会觉得他可能是邪恶的。如果你说\"哈哈。卖花女孩的信息确实是错误的，");
    g_tipLine[19678] = StringToText("  因为我是哲学家获得了卖花女孩能力，所以他醉酒了。这很合理\"，那么善良玩家可能会信任你和那个爪牙。然而，");
    g_tipLine[19679] = StringToText("  如果善良玩家仍然怀疑爪牙不是卖花女孩，你可以说\"我也这么认为。所以这也是为什么我会愿意获得这个角色的能力，");
    g_tipLine[19680] = StringToText("  如果他不是，那么我就不会对好人产生影响\"。");
    g_tipLine[19681] = StringToText("【伪装成艺术家】");
    g_tipLine[19682] = StringToText("· 艺术家可以在游戏中获得几乎任何信息。如果你伪装艺术家你可以运用这一点来使你的邪恶队友得到大家信任，");
    g_tipLine[19683] = StringToText("  或者试图对抗善良阵营玩家。");
    g_tipLine[19684] = StringToText("· 将一个善良玩家视作邪恶玩家然后问问题。比如你可以\"问\"某角色是否在游戏中，某玩家是否坐在一个邪恶玩家的旁边等");
    g_tipLine[19685] = StringToText("  等。善良玩家会由于你提供的狡猾的信息来无视真正的恶魔而去处决那些善良的玩家。");
    g_tipLine[19686] = StringToText("· 你也可以问一个可以表明你的邪恶队友是善良的问题。比如说，\"问\"你左边的邪恶玩家是否比右边的多，");
    g_tipLine[19687] = StringToText("  或者恶魔是否坐在某些位置，或者甚至是某个角色在场（而这个角色是邪恶玩家伪装的）。在大家眼里，");
    g_tipLine[19688] = StringToText("  会把注意力从那些不是邪恶玩家的身上转移，等待大家的反而是那些没有威胁的好人。");
    g_tipLine[19689] = StringToText("· 决定你的信息是否要与当前的信息相矛盾。作为恶魔来说，这很危险，因为如果你反驳了他们，他们很可能出于怀疑而将你");
    g_tipLine[19690] = StringToText("  处决。如果你是爪牙，你可以慎重的设定一个论证点，因为就算你被处决了，游戏也不会结束，如果能让大家相信你给出的");
    g_tipLine[19691] = StringToText("  错误信息，那就非常完美了！");
    g_tipLine[19692] = StringToText("· 要注意涡流——如果你知道涡流在场，那么你要谨慎的提供\"真\"信息，因为涡流会让你的\"真\"信息变假。");
    g_tipLine[19693] = StringToText("· 不要马上去声明自己的角色——在早期，一个已经问了问题的艺术家，可能也会为了对抗涡流而牺牲。而如果你就是涡流，");
    g_tipLine[19694] = StringToText("  然后因此被处决，那就非常尴尬了！");
    g_tipLine[19695] = StringToText("【伪装成杂耍艺人】");
    g_tipLine[19696] = StringToText("· 别害羞。杂耍艺人需要公开声明。这意味着不管是说书人还是其他所有玩家都会听到你猜测。杂耍者通常希望尽可能猜到多");
    g_tipLine[19697] = StringToText("  的人，会尽最大努力让大家相信他是杂耍艺人，并且会说服大家都透露他们的角色。如果你要伪装成杂耍艺人，");
    g_tipLine[19698] = StringToText("  就让大家尽量透露自己的角色。");
    g_tipLine[19699] = StringToText("· 你可以通过只猜测善良玩家并确认他们的角色来使自己更像是善良的。并且被你所确认的善良玩家会更容易相信你。例如，");
    g_tipLine[19700] = StringToText("  你猜测卖花女孩是卖花女孩，钟表匠是钟表匠，博学者是博学者，然后告诉大家你的猜测都是正确的，");
    g_tipLine[19701] = StringToText("  这会使你看起来产生了很大的帮助。");
    g_tipLine[19702] = StringToText("· 或者，你可以通过只猜测善良玩家并告诉大家你的猜测不正确而使他们看起来是邪恶的。如果大家相信你是杂耍艺人，");
    g_tipLine[19703] = StringToText("  这会使他们之间互相不信任。例如，如果你猜测了筑梦师、艺术家、女裁缝和城镇公告员，但是你告诉大家你只猜对了3个，");
    g_tipLine[19704] = StringToText("  这就说明这之中有一个人在撒谎。如果幸运的话，大家可能会想方设法去找出是谁，甚至去处决这些玩家。");
    g_tipLine[19705] = StringToText("· 通过猜测邪恶队友的伪装角色来证实他们。去鼓励他们在第一天就说自己的善良角色是什么，然后声明你的猜测是对的。");
    g_tipLine[19706] = StringToText("  例如，你猜测女巫（伪装为心上人）是心上人，舞蛇人是舞蛇人。然后你告诉大家你得到的都是正确的，");
    g_tipLine[19707] = StringToText("  那么大家可能会认为女巫是善良的。");
    g_tipLine[19708] = StringToText("· 利用你的能力去使某个玩家的信息不可信并对他产生怀疑。你可以只猜他一个玩家，或者去猜测他与另外一两个大家目前都");
    g_tipLine[19709] = StringToText("  非常信赖的玩家，然后告诉大家你猜错了。这个技巧在当你选择的是善良的双子时会更加有效，因为这可能会使你们通过触");
    g_tipLine[19710] = StringToText("  发镜像双子的能力而赢得游戏。或者，你可以使博学者或钟表匠看起来是邪恶的，从而使他的信息变得不可靠，");
    g_tipLine[19711] = StringToText("  这会给到你们更多的喘息空间。");
    g_tipLine[19712] = StringToText("· 提防那些狡猾的玩家，他们可能会报一个假的角色，一些善良玩家有一些理由而去撒谎。如果他们这么做而你却说你猜对了");
    g_tipLine[19713] = StringToText("  他们的角色，那么他们就会知道你在撒谎。你当然可以说实际是他们在撒谎，或者你的信息由于诺-达鲺、");
    g_tipLine[19714] = StringToText("  涡流或一个死去的心上人等影响变得不正确，但通常来说这会更难以相信。");
    g_tipLine[19715] = StringToText("· 假装是杂耍艺人可以帮助恶魔发现那些有更高优先级的目标。恶魔大部分都想尽快去杀死卖花女孩、");
    g_tipLine[19716] = StringToText("  神谕者和博学者等目标或其他当前设置里强大的角色。让善良玩家去透露自己的角色有助于帮助恶魔做出选择。当然，");
    g_tipLine[19717] = StringToText("  在梦殒春宵剧本中，所有的选择都是不错的选择，但是如果可以根据情况去选择就更棒了。");
    g_tipLine[19718] = StringToText("【伪装成贤者】");
    g_tipLine[19719] = StringToText("· 贤者的能力只和死亡有关，而且非常强大。如果你打算一直伪装贤者，那么你就需要做好死亡的准备。");
    g_tipLine[19720] = StringToText("  这是值得的——如果善良玩家相信你，他们会花两天去处决那些你指认的并不是恶魔的人！如果你是方古（一个可能在击杀");
    g_tipLine[19721] = StringToText("  外来者后死亡的角色），或者一个麻脸巫婆导致随机死亡的邪恶玩家，这都会特别有效。");
    g_tipLine[19722] = StringToText("· 作为邪恶玩家，你肯定想要活的更久，以产生更大的影响。这会让你伪装成贤者更为困难 ，因为如果你没有在夜晚死亡，");
    g_tipLine[19723] = StringToText("  就没有足够的“信息”来支持你的伪装，但是你可以把这个当做你的另一种武器。你可以尽快和一些人交流（你知道的善良");
    g_tipLine[19724] = StringToText("  玩家，尤其是那些有强大能力的博学者或者是卖花女孩这样的），并告诉他你是贤者。在之后，如果有人怀疑你，");
    g_tipLine[19725] = StringToText("  你可以说你只和一个人透露了你的角色，并指控他要么是恶魔，要么是给恶魔透露了你的信息。");
    g_tipLine[19726] = StringToText("· 如果你开始伪装的是一个有信息的角色，而大家认为你的信息有问题，那么你可以考虑不再伪装那个角色而是告诉大家你是");
    g_tipLine[19727] = StringToText("  贤者。你的信息可能不是正确的，但是善良玩家可能认为你是有更好的理由（为了引起恶魔注意）而撒谎，");
    g_tipLine[19728] = StringToText("  所以会不考虑你是坏人。");
    g_tipLine[19729] = StringToText("【伪装成畸形秀演员】");
    g_tipLine[19730] = StringToText("· 如果你伪装失败了，那么伪装成畸形秀演员是一个不错的退路。作为畸形秀演员，就会使你原本说不通的神谕者信息变得说");
    g_tipLine[19731] = StringToText("  的通，当然你不过是在撒谎来掩盖你自己！");
    g_tipLine[19732] = StringToText("· 如果你明显的暴露了你的角色，说书人是无法处决你的，因为你实际上不是畸形秀演员。你可以把这归咎于\"可能\"-说书");
    g_tipLine[19733] = StringToText("  人是根据自己的判断来决定是否处决你，因此可能会放过畸形秀演员，来让他更可以或者避免大家能得到确认的信息。");
    g_tipLine[19734] = StringToText("  你可以说没有被处决就是因为这些原因。");
    g_tipLine[19735] = StringToText("· 秘密的\"透露\"给几个玩家你的角色以获得他们的信任。作为正常的畸形秀演员来说这是一个好的举动，如果他们相信你，");
    g_tipLine[19736] = StringToText("  当其他人在因为你的假信息等产生怀疑时，他们会来掩护你。因为你的死亡会剥夺善良玩家的一次处决权，");
    g_tipLine[19737] = StringToText("  所以他们会被迫保护你和掩护你的角色。同时，这也会分散他们的注意力，这都是很不错的。");
    g_tipLine[19738] = StringToText("· 畸形秀演员没有信息，所以很难从逻辑上去欺骗别人。可以尝试用\"情绪\"去煽动别人，呼吁大家来帮助你保护你的角色，");
    g_tipLine[19739] = StringToText("  在面对说书人或可能是邪恶的玩家时表现的比较紧张，这些都可能提供帮助，因为这就是真正的畸形秀演员所具有的特征！");
    g_tipLine[19740] = StringToText("· 伪装成畸形秀演员的一个巨大收益是可以干扰对于外来者数量的判断。悄悄的对善良玩家说“那个心上人在撒谎，");
    g_tipLine[19741] = StringToText("  因为我才是真的外来者”表明也有方古存在的危险。至少，如果有外来者出现，会让他们产生怀疑，");
    g_tipLine[19742] = StringToText("  因为他们认为你已经是一个外来者了。畸形秀演员的神秘特质使其成为一个特别有效的策略，因为你可以（也应该）");
    g_tipLine[19743] = StringToText("  说服大家花更多的时间去考虑你的存在而去争论，这也就意味着外来者会更难直接与你对抗，也更难从你的这个谎言去追溯");
    g_tipLine[19744] = StringToText("  你们的邪恶队伍！");
    g_tipLine[19745] = StringToText("【伪装成心上人】");
    g_tipLine[19746] = StringToText("· 大多数真正的心上人不会立即告诉大家他是心上人。他们更有可能完全伪装成另一个角色，或者对于他的角色暂时保密。");
    g_tipLine[19747] = StringToText("  一开始的时候伪装成一个不同的角色，或者保持沉默一段时间，让自己看起来更真实一些。");
    g_tipLine[19748] = StringToText("· 心上人是一个不错的退路。如果你伪装成卖花女孩，而有其他人说他是卖花女孩，那么你说自己实际上是心上人会更可信。");
    g_tipLine[19749] = StringToText("  如果你已经来回声明了三个角色，但没有一个角色能够成功穿上，那么直接恼羞成怒的举手告诉大家你是心上人，");
    g_tipLine[19750] = StringToText("  并且表现出一种无奈的样子。");
    g_tipLine[19751] = StringToText("· 如果你声明你是心上人，但却一直没有死……那么就要当心了。一个表明角色的心上人，通常会很快被恶魔击杀。");
    g_tipLine[19752] = StringToText("  如果你在表明角色后一直没有死，那么大家可能就会想要知道是因为什么。");
    g_tipLine[19753] = StringToText("· 死亡能够更好的伪装你的角色。并且最好是在晚上。如果你是一个可以在夜晚死去的爪牙或者恶魔，例如方古，");
    g_tipLine[19754] = StringToText("  那么死亡是非常有帮助的。善良阵营的玩家会认为有人开始醉酒了，而事实并非如此。大家的信息将会受到猜疑。");
    g_tipLine[19755] = StringToText("  善良玩家们会看起来很邪恶，一片混乱，而你们就可以坐享其成。");
    g_tipLine[19756] = StringToText("· 如果你死了，尽快声明你是心上人，这是大多数心上人会做的。在你死后，号召大家去寻找“谁因为你而醉酒”了-如果大");
    g_tipLine[19757] = StringToText("  家花费大量精力去寻找根本不存在的醉鬼，那么他们就可能不会花太多精力在找寻恶魔上。在任何时候都记得提醒大家他们");
    g_tipLine[19758] = StringToText("  之中的一个醉酒了。");
    g_tipLine[19759] = StringToText("【伪装成理发师】");
    g_tipLine[19760] = StringToText("· 真的理发师通常不会说明他是理发师！你可以对你的角色保持沉默或者伪装成其他角色，同时你就可以保持存活。");
    g_tipLine[19761] = StringToText("· 另一种方式，你可以早点说你是理发师。大家可能还是会想要让你活着，所以也没有什么大不了的。");
    g_tipLine[19762] = StringToText("· 如果你死了，显然不会有善良玩家的角色被交换，所以没有善良玩家会告诉大家他的角色被交换了。所以如果你死了，");
    g_tipLine[19763] = StringToText("  你需要说服大家恶魔没有选择交换角色，要么恶魔选择了两个邪恶玩家交换了角色。");
    g_tipLine[19764] = StringToText("· 和你的队友配合！如果你在至少有两个其他邪恶玩家的游戏中死了，可以让他们声称他们被交换了。");
    g_tipLine[19765] = StringToText("  这会让你看起来是个超级值得信赖的理发师，也会使他们看起来更可靠。例如，你是女巫，但伪装成理发师，而你死了。");
    g_tipLine[19766] = StringToText("  第二天，那些伪装成筑梦师和贤者的亡骨魔和麻脸巫婆告诉大家他们的角色互换了，他们现在是贤者和筑梦师。");
    g_tipLine[19767] = StringToText("  这也和游戏设置所匹配！");
    g_tipLine[19768] = StringToText("【伪装成呆瓜】");
    g_tipLine[19769] = StringToText("· 死亡是你的归宿！自杀然后声明自己是呆瓜这可能会让你力挽狂澜。随着游戏的进行，一些邪恶的角色甚至会自然地导致邪");
    g_tipLine[19770] = StringToText("  恶玩家的死亡，这让伪装成呆瓜变得比通常更可行。如果你是一个刚刚传递了自己恶魔能力的方古，");
    g_tipLine[19771] = StringToText("  或者一个刚刚被亡骨魔杀死的爪牙，那就放心大胆的伪装自己的角色吧，让善良阵营的团队感受到恐惧。");
    g_tipLine[19772] = StringToText("· 当你作为呆瓜“选择一名玩家”时，你有以下的一些选择：");
    g_tipLine[19773] = StringToText("· 选择一名你认为是善良阵营的玩家，且他是大家公认的好人——这样将使你博得该玩家的好感度，");
    g_tipLine[19774] = StringToText("  而且能让你看起来更值得信赖，进而意味着人们会听取你的建议，或者你的谎言，甚至相信你给出的信息。");
    g_tipLine[19775] = StringToText("· 如果你伪装成呆瓜且伪装得非常可靠和可信的，选择一个你知道的邪恶玩家——因为大家都信任你，");
    g_tipLine[19776] = StringToText("  他们就会相信被选中的这个玩家是善良的好人，并且他们将在至少一段时间内免受怀疑。");
    g_tipLine[19777] = StringToText("· 如果你伪装成呆瓜很可疑，选择一个你知道的好人玩家但是好人团队现在还无法确认他是好人的玩家。");
    g_tipLine[19778] = StringToText("  这将会让该玩家在接下来的游戏中被大家怀疑成你俩是一个阵营的玩家。如果你被当成真的邪恶玩家而被好人轮番攻击，");
    g_tipLine[19779] = StringToText("  他们也会这样对待该名玩家。");
    g_tipLine[19780] = StringToText("· 最后，如果你伪装成呆瓜很可疑，而大家很清楚你想把一个善良阵营的玩家拉下水，通过选择一个邪恶阵营的玩家来反向欺");
    g_tipLine[19781] = StringToText("  骗他们，这让他们看起来是极好的，这个代价只是你的命而已。你越坚持他们是邪恶的，大家就越坚持他们是善良的。");
    g_tipLine[19782] = StringToText("· 呆瓜是个很好的陷阱骗局。要么对自己的角色保持沉默，要么假装声明自己是另一个角色，然后再承认自己是笨蛋。");
    g_tipLine[19783] = StringToText("  因为这是一个真正的笨蛋会做的事情，所以你会比你直接承认你是呆瓜更可信。");
    g_tipLine[19784] = StringToText("· 对于喜欢长时间游戏的玩家来说，一个有趣的选择是私下告诉一两个玩家你是呆瓜，然后同时公开声称自己是另一个角色。");
    g_tipLine[19785] = StringToText("  这是一个和善良阵营玩家建立信任的好方法，因为你可以说这个秘密是因为你相信他们不会杀了你。");
    g_tipLine[19786] = StringToText("  玩家喜欢被信任的感觉，在他们获得对你的说法产生怀疑的信息之前，他们可能会倾向于回报你。");
    g_tipLine[19787] = StringToText("  然后你可以享受各种各样的乐趣——例如，让这些玩家代表你传播错误信息，在你几乎不动手脚的情况下混淆有用的信息！");
    g_tipLine[19788] = StringToText("· 在你还活着的时候暴露你是个呆瓜不是个最佳的选择，但是有几个情况是非常有必要这样去做的。比如说，");
    g_tipLine[19789] = StringToText("  你在试图避免被处决！另一个非常明智的决定就是当你面临着公开表明的外来者的数量等于本应参与游戏的外来者的数量—");
    g_tipLine[19790] = StringToText("  —这给了善良阵营非常多的有关哪一种恶魔在场的信息，并且让这些外来者成为值得信赖的善良玩家。通过暴露自己，");
    g_tipLine[19791] = StringToText("  你搅乱了场上的局势信息，让所有的外来者都变得可疑，并且让大家觉得恶魔就是方古。最后，最好是在游戏接近尾声的时");
    g_tipLine[19792] = StringToText("  候“透露”，最好是在最后一天，如果善良阵营不会给你太大的压力的话——当你不再“害怕”被恶魔杀死时，");
    g_tipLine[19793] = StringToText("  隐藏起来没有什么意义。");
    g_tipLine[19794] = StringToText("【伪装成气球驾驶员】");
    g_tipLine[19795] = StringToText("· 由于气球驾驶员可能会让游戏中多出一名外来者，你可以让某个爪牙冒充外来者，制造出“确实多了一名外来者”的假象，");
    g_tipLine[19796] = StringToText("  让你的伪装听起来更可信。");
    g_tipLine[19797] = StringToText("· 多和善良玩家聊天，弄清他们声称的角色类型，然后再结合这些信息编出更“合理”的说法。");
    g_tipLine[19798] = StringToText("· 留意那些手里握有信息、并且暗示其他玩家是邪恶阵营的善良玩家。例如，如果调查员说他看到僧侣可能是投毒者，");
    g_tipLine[19799] = StringToText("  那你就声称你在前后两晚看到了这两个玩家。不仅能让僧侣看起来像个真投毒者，还能顺带获得调查员的信任！");
    g_tipLine[19800] = StringToText("· 不要把你的角色告诉太多人，这样你活到游戏后期时别人也不容易起疑。毕竟气球驾驶员每晚都能获得新信息，");
    g_tipLine[19801] = StringToText("  越往后越关键，恶魔当然早就想把真气球驾驶员干掉。");
    g_tipLine[19802] = StringToText("· 声称你接连两晚看到的都是爪牙，这样会让人以为其中有个爪牙其实是好人——如果这个爪牙正在冒充洗衣妇或事务官之类");
    g_tipLine[19803] = StringToText("  的角色就更好了。反过来也可以反咬一口，说这两名玩家一个是爪牙一个是恶魔，毕竟正常来说两名爪牙不太可能被你连续");
    g_tipLine[19804] = StringToText("  得知，对吧？");
    g_tipLine[19805] = StringToText("· 观察善良玩家之间的信任关系链。如果你说自己连续两晚看到的两个玩家都是镇民，而这俩人又彼此很信任，");
    g_tipLine[19806] = StringToText("  他们很可能会开始怀疑你。所以更好的做法是：盯上那些不太信任彼此的好人。如果送葬者怀疑镇长是恶魔，");
    g_tipLine[19807] = StringToText("  那你就说自己先看到了送葬者，第二晚看到的是镇长，然后坐等他们互相怀疑、场面混乱。");
    g_tipLine[19808] = StringToText("· 别急着公开你“知道”的那些信息。气球驾驶员是最难伪装的角色之一，因为你开局其实根本不知道谁是镇民、");
    g_tipLine[19809] = StringToText("  谁是外来者。多等几天、观察局势后再慢慢开口，这样更容易让你编出来的信息看起来靠谱。你说的内容未必完全对，");
    g_tipLine[19810] = StringToText("  但一定要听起来对。");
    g_tipLine[19811] = StringToText("· 如果你的同伙里有寡妇或间谍，尽早找他们要魔典的详细信息！伪装成一个“信息正确”的气球驾驶员，是个很棒的方式，");
    g_tipLine[19812] = StringToText("  让大家觉得——“他最多是个间谍，肯定不是恶魔啦！”");
    g_tipLine[19813] = StringToText("【伪装成失忆者】");
    g_tipLine[19814] = StringToText("· 当你开始伪装失忆者时，你其实并不需要有一个切实的能力，但是你很可能需要在游戏推进到终局时有一个完整的构想。");
    g_tipLine[19815] = StringToText("· 当你伪装失忆者时，你可能需要伪造（本应在）晚上从说书人处获取的信息。这些信息可以包括：");
    g_tipLine[19816] = StringToText("· 数字");
    g_tipLine[19817] = StringToText("· 指向玩家");
    g_tipLine[19818] = StringToText("· 是或否");
    g_tipLine[19819] = StringToText("· 角色标记");
    g_tipLine[19820] = StringToText("· 阵营手势（大拇指朝上还是朝下）");
    g_tipLine[19821] = StringToText("· 切记每天都要去拜访说书人猜测你的能力，因为失忆者会这么做。记得说书人给失忆者对于能力猜测的线索如下。");
    g_tipLine[19822] = StringToText("· 无关：你的猜测与你的能力完全无关。");
    g_tipLine[19823] = StringToText("· 有关：你的猜测与你的能力有些关联。");
    g_tipLine[19824] = StringToText("· 接近：你快要猜到你的能力了。");
    g_tipLine[19825] = StringToText("· 正确：你已经猜出了你的能力。");
    g_tipLine[19826] = StringToText("· 假装猜测你的能力。创造并破解一个伪造能力的过程能给予你的骗局无限空间。你可以在游戏进程中操作自己的能力来得到");
    g_tipLine[19827] = StringToText("  任何你想要的结论，比如质疑善良玩家，支持邪恶玩家或是让善良玩家质疑他们获得的信息。");
    g_tipLine[19828] = StringToText("· “尽早得知”和“稍晚得知”各有优劣。因为你在谎称能力，早些“弄清”你的能力意味着你可以更容易地散播谎言，");
    g_tipLine[19829] = StringToText("  但同时，过早地猜中会显得不切实际，可能会让其他玩家对你产生怀疑。");
    g_tipLine[19830] = StringToText("· 假装一整局都“猜不出”你的真实能力！因为你自己也“不知道”自己的能力，所以也不必分享自己的信息，");
    g_tipLine[19831] = StringToText("  因为你没有信息。此外，你也可以伪装成一个比较愚笨的失忆者来博取在场玩家的同情。");
    g_tipLine[19832] = StringToText("· 当你假装被“卡”在猜测能力的时候，邀请大家与你一起研究，猜测你的真实能力，这有助于将善良玩家的注意力从寻找邪");
    g_tipLine[19833] = StringToText("  恶玩家转移到帮助你猜测你的能力。毕竟，大部分的玩家都会觉得猜测能力是一件很有趣的事情。");
    g_tipLine[19834] = StringToText("【伪装成食人族】");
    g_tipLine[19835] = StringToText("当你伪装成食人族时，你需要时刻牢记以下几点：");
    g_tipLine[19836] = StringToText("· 试着发起处决！因为一个真正的食人族也会这么做，这是打击善良玩家的绝妙借口。即使稍后他们发现自己错误地处决了一");
    g_tipLine[19837] = StringToText("  名能帮上忙的玩家，他们仍然会希望你能以能力弥补这个损失。一份你十分乐于用谎言来注满的希望。");
    g_tipLine[19838] = StringToText("· 当你试图污蔑一名被处决的玩家是邪恶阵营，记得表现得像能力失效。因为食人族在吃下邪恶玩家时会中毒，");
    g_tipLine[19839] = StringToText("  无论你想说点什么来伪装，这都会给你提供很多机会。");
    g_tipLine[19840] = StringToText("· 在玩家被处决时，你要在夜晚准备好一个伪造能力，这意味着你可能要在玩家处决前和他们沟通或是与你的盟友商议。");
    g_tipLine[19841] = StringToText("  如果你宣称吃掉了每晚都会提供信息的玩家，而又在当晚没有获得任何信息时，理所当然会受到怀疑。当然，");
    g_tipLine[19842] = StringToText("  你也可以说这些玩家其实是邪恶的而你中毒了，只是结果可能视情况会有所不同。");
    g_tipLine[19843] = StringToText("【伪装成贵族】");
    g_tipLine[19844] = StringToText("· 伪装成贵族最简单的方法就是尽早现身，然后指出三名善良玩家。这也会很有趣！如果你是邪恶的，");
    g_tipLine[19845] = StringToText("  说出三名善良玩家中有一名是邪恶的可以在他们之间引发猜忌，此外还有个额外的好处就是这种指证很难被证实或证伪。");
    g_tipLine[19846] = StringToText("  不同于镜像双子中，善良玩家能确切知道另一名玩家是邪恶的，或是共情者得知一名邻座是邪恶的（这意味着两名邻座互相");
    g_tipLine[19847] = StringToText("  知道对方是邪恶的），贵族所得知的玩家可以既宣称自己是善良的又相信另一名贵族得知的玩家是善良的。");
    g_tipLine[19848] = StringToText("  善良玩家互相说服对方自己是善良阵营这件事是非常自然和可信的（因为他们是善良的），但带来的继发效应是你看起来也");
    g_tipLine[19849] = StringToText("  是善良的，而玩家目前没有提及的第三名玩家看起来显得邪恶。说服（其他玩家）他们是善良的等于说服（其他玩家）");
    g_tipLine[19850] = StringToText("  一名善良玩家是邪恶的。");
    g_tipLine[19851] = StringToText("· 让善良玩家自己去探讨三名玩家中哪一名是邪恶的。只要他们最终认为是邪恶的玩家实际上是善良的，你就不会受到怀疑。");
    g_tipLine[19852] = StringToText("  对于假冒的贵族而言，轻劝和建言比直言斥责更有效，倾听比夸夸其谈更有帮助。假装自己是团队一员去帮助他人。");
    g_tipLine[19853] = StringToText("· 如果你自认有冒险精神，并且游戏中有三名或更多的邪恶玩家，宣称自己是贵族并指出两名（或三名）");
    g_tipLine[19854] = StringToText("  邪恶玩家作为你得知的三名玩家必定能够在善良玩家之间引起骚乱。他们很难怀疑贵族玩家提供的三名玩家中有两名或三名");
    g_tipLine[19855] = StringToText("  是邪恶的，因为即使真正的贵族醉酒了，说书人也不太可能会这么操作。提供即使是醉酒的玩家也不太可能获得的信息确实");
    g_tipLine[19856] = StringToText("  会让善良阵营陷入混乱。但要注意，你宣称的三名玩家中至少有一名会被认为邪恶而处决，也许是两名或全部。");
    g_tipLine[19857] = StringToText("· 如果你是恶魔，伪装成贵族并给出正确的信息是相当容易的，而且会让你看起来善良。这是一种安全有效的伪装。");
    g_tipLine[19858] = StringToText("  不同于宣称是调查员看到男爵但是外来者人数对不上的发言，或是宣称是送葬者看到麻脸巫婆被处决但是没有人转变角色，");
    g_tipLine[19859] = StringToText("  简单地指出哪些玩家是邪恶的要容易得多，因为这很难被证伪。即使游戏中有一些在场角色比如罂粟种植者或魔术师让你无");
    g_tipLine[19860] = StringToText("  法确定哪些玩家是爪牙，或是你是刚被转变为方古或刚从舞蛇人转变，你都很可能在随机选择三名玩家时选中一个爪牙。");
    g_tipLine[19861] = StringToText("  如果你想让自己看起来善良并且安全，牺牲一个爪牙伪装成贵族去提供正确信息是非常容易做到的。");
    g_tipLine[19862] = StringToText("【伪装成巡山人】");
    g_tipLine[19863] = StringToText("· 如果你是巡山人，那么一个落难少女也会在场。在某个时机，另一名邪恶玩家需要宣称是落难少女，");
    g_tipLine[19864] = StringToText("  否则你会看起来非常可疑。另一名邪恶玩家可以在死亡后作为落难少女现身。你宣称是巡山人而另一名邪恶玩家宣称是落难");
    g_tipLine[19865] = StringToText("  少女会比你成为一个孤独而可疑的巡山人要可靠得多。");
    g_tipLine[19866] = StringToText("· 假装巡山人可能引出真正的落难少女。如果你在“搜寻少女”的过程中足够有说服力并且设法欺骗真正的落难少女让她暴露");
    g_tipLine[19867] = StringToText("  自己是谁，一个爪牙就可以猜测落难少女是谁而赢得游戏。");
    g_tipLine[19868] = StringToText("· 在你最初的伪装失效后，巡山人可能是一个非常有用的备用伪装，因为巡山人是具有充分理由不在早期现身的善良角色。");
    g_tipLine[19869] = StringToText("  如果你宣称是洗衣妇或是贞洁者而伪装被打破，那么你就可以作为巡山人现身，说你尝试隐藏你的真实角色。");
    g_tipLine[19870] = StringToText("· 如果你是一个爪牙，你知道落难少女是否在场，如果不在，你因此也能知道巡山人不在场。这样两名邪恶玩家搭档组成巡山");
    g_tipLine[19871] = StringToText("  人/落难少女组合就会是相对安全的方案。唯一的风险是你们如果像这样搭档的话，落难少女将应当已经成为一个不在场的");
    g_tipLine[19872] = StringToText("  镇民。和恶魔聊聊，在他们的伪装里找一个落难少女变成的角色。或者，你可以是巡山人并宣称一个死去的爪牙是落难少女");
    g_tipLine[19873] = StringToText("  让你们看起来更可信。");
    g_tipLine[19874] = StringToText("· 即使制造一场对峙也宣称自己是巡山人。如果没有其他巡山人，落难少女更可能信任你。如果有其他巡山人，");
    g_tipLine[19875] = StringToText("  你就制造了一个两难局面，给落难少女带来了极大焦虑，她可能会不想向你们之中的任何一人宣称自己的角色并让自己被处");
    g_tipLine[19876] = StringToText("  决，而不是冒险试着让你们成功选中她，这花费了一次非恶魔处决，并且也中和了真巡山人能力的潜在收益。");
    g_tipLine[19877] = StringToText("【伪装成工程师】");
    g_tipLine[19878] = StringToText("· 最简单的伪装工程师的方法就是说你已经创造了你实际是的那个角色。如果你是投毒者就说创造了投毒者。");
    g_tipLine[19879] = StringToText("  如果你是沙巴洛斯就说你创造了沙巴洛斯。你可能需要在前两夜就这样做，赶在善良阵营讨论并坚持让你选择一个特定角色");
    g_tipLine[19880] = StringToText("  之前，因为他们可能不会选择你想说的角色！");
    g_tipLine[19881] = StringToText("· 确保你告诉大家的被创造角色不会带入明显线索。如果你宣称你创造了哈迪寂亚但是晚上并没有哈迪寂亚行动环节，");
    g_tipLine[19882] = StringToText("  你会需要做很多艰难的解释。但如果你说你创造了一个普卡，那么大家就很难判断你是否在说谎，");
    g_tipLine[19883] = StringToText("  假装真正的恶魔是小恶魔或是方古或是其他类似角色而不是像哈迪寂亚这类会自相矛盾的角色。");
    g_tipLine[19884] = StringToText("· 如果剧本中的所有邪恶角色都不带有明显线索，那么你就可以随心所欲地引发尽可能多的关于你应当创造何种邪恶角色的讨");
    g_tipLine[19885] = StringToText("  论。善良阵营无法知道你的工程师能力是否生效。");
    g_tipLine[19886] = StringToText("· 如果你想迷惑善良阵营，告诉他们你创造了与在场邪恶角色不同的邪恶角色。");
    g_tipLine[19887] = StringToText("· 如果你希望看起来是名善良玩家，就以帮助善良阵营明确情况为代价，告诉他们你创造了与在场邪恶角色相同的邪恶角色。");
    g_tipLine[19888] = StringToText("· 无论你决定告诉善良阵营你创造了什么角色，都要有一个可靠的、完成的、准备良好的故事去说明你为何要做这样的选择。");
    g_tipLine[19889] = StringToText("  通常，善良阵营会关注新邪恶角色带来的额外威胁，而不是移除邪恶角色带来的优势，并认为你的选择使得让邪恶阵营变强。");
    g_tipLine[19890] = StringToText("  例如，如果你告诉他们你创造了女巫或是洗脑师，善良阵营会因为看到白天出现额外死亡的可能性而抱怨，");
    g_tipLine[19891] = StringToText("  但如果你告诉他们你创造这些角色是为了避免主谋或者哥布林，并且大家很熟悉梦殒春宵剧本，因此你认为善良阵营会更擅");
    g_tipLine[19892] = StringToText("  长应对他们熟悉的爪牙，说这些会比简单的耸耸肩表示不知道要更可信。");
    g_tipLine[19893] = StringToText("· 伪装成工程师很大程度上受制于角色列表上的爪牙和恶魔种类。在伪装成工程师之前，和你的邪恶盟友聊聊，");
    g_tipLine[19894] = StringToText("  了解他们的角色，并且告诉他们你打算伪装成工程师。知道那些邪恶角色确实在场以及这些玩家打算做什么能很大程度地帮");
    g_tipLine[19895] = StringToText("  你消除伪装工程师的瑕疵。");
    g_tipLine[19896] = StringToText("【伪装成渔夫】");
    g_tipLine[19897] = StringToText("· 渔夫可以被引导去做游戏里的几乎任何事情。在伪装时利用这一点，给出建议来补足邪恶阵营试图构建以对抗善良阵营的故");
    g_tipLine[19898] = StringToText("  事。");
    g_tipLine[19899] = StringToText("· 你假装从说书人处获得的建议可能是你伪装自己的核心，你必须自己想出这些建议。渔夫的能力非常强大——你所想的内容");
    g_tipLine[19900] = StringToText("  可能是游戏胜负的决定因素。记得用说书人的表达方式来表达你的“建议”。如果你的说书人喜欢告诉渔夫该处决谁，");
    g_tipLine[19901] = StringToText("  那你宣称说书人让你处决某名玩家时，你的伪装就会更可信。");
    g_tipLine[19902] = StringToText("· 要记得说书人给予渔夫的是一个关于该做什么的提示，而不是一条信息。说书人不太可能给予“你的两个邻座中有恶魔”这");
    g_tipLine[19903] = StringToText("  样的信息——这并非建议。一定要确保你构建的假建议是告诉你去做些什么，例如“处决你的邻座”。");
    g_tipLine[19904] = StringToText("· 坚持你的假建议。如果你没能坚持在交流中传递给整个团队你伪造的能力（建议）应当如何去执行，可能情况就不是太好。");
    g_tipLine[19905] = StringToText("  提醒玩家你的建议也许有一个有效日期，因此他们现在听从你的建议很重要，而不是拖到稍后。");
    g_tipLine[19906] = StringToText("· 给予能够保护邪恶玩家的假建议。用它来说服小镇不要处决你的恶魔或其他强力邪恶角色。");
    g_tipLine[19907] = StringToText("· 给予能够定罪善良玩家的假建议。用它来质疑送葬者或占卜师的信息，或来处决圣徒。");
    g_tipLine[19908] = StringToText("· 如果你的建议没有带来好的后果（这是预期内的，因为它们是被捏造出来的），考虑一下扭曲对你建议的阐释以制造更多混");
    g_tipLine[19909] = StringToText("  乱的可能性。");
    g_tipLine[19910] = StringToText("· 如果你认为自己遭受怀疑，提供一些能够定罪一名邪恶玩家的建议。如果大家认为你是邪恶的，他们可能就更信任其他玩家");
    g_tipLine[19911] = StringToText("  而将你的建议理解成对一个善良玩家的攻击。");
    g_tipLine[19912] = StringToText("· 如果你认为自己遭受怀疑，提供一些能够支持一名善良玩家的建议。如果大家认为你是邪恶的，他们可能就更会猜疑并攻击");
    g_tipLine[19913] = StringToText("  那名玩家。");
    g_tipLine[19914] = StringToText("· 让你的暗示有趣、含糊和不同寻常。提出一些会引起许多讨论的内容，让善良阵营在寻找恶魔的努力中迷失和产生冲突。");
    g_tipLine[19915] = StringToText("· 不要让你的暗示过于详尽。尝试并坚持使用一个可以被一两句话表达的简单想法而不是一段可能引起怀疑的长篇大论。");
    g_tipLine[19916] = StringToText("· 过早地伪装成渔夫登场会有风险。如果小镇相信了你已经使用了你的每局游戏限一次能力，他们可能会基于最小化潜在负面");
    g_tipLine[19917] = StringToText("  影响的想法决定处决你。当类似涡流这样的角色在剧本中导致善良阵营如果不处决就会落败时，这个问题尤其需要担忧。");
    g_tipLine[19918] = StringToText("· 在游戏后期宣称是渔夫。如果你最初的伪装没有起效，这可能是一个很棒的掩盖行迹的备选方案。");
    g_tipLine[19919] = StringToText("  你可以宣称你误导小镇是为了避免成为恶魔的目标，这使你可以保留能力在游戏后期使用。");
    g_tipLine[19920] = StringToText("· 在你透露你假暗示前，一定要至少拜访一次说书人。如果仅仅因为有某名玩家揭露你从未拜访说书人而导致你透露暗示变成");
    g_tipLine[19921] = StringToText("  自证谎言，这情况实在是太惨了。");
    g_tipLine[19922] = StringToText("【伪装成农夫】");
    g_tipLine[19923] = StringToText("· 如果你打算隐秘行事，伪装成农夫可能是游戏后期一个不错的考虑。农夫不太可能很早现身，也很适合在你伪装的其他角色");
    g_tipLine[19924] = StringToText("  被识破后作为替代方案。");
    g_tipLine[19925] = StringToText("· 在游戏前期告诉几个人你是农夫，然后让他们活到游戏后期，这样你就能将他们描绘成恶魔或是邪恶角色来解释你为什么没");
    g_tipLine[19926] = StringToText("  有死亡，这是非常强的邪恶伪装。");
    g_tipLine[19927] = StringToText("· 如果一名邪恶玩家因为任何原因在夜晚死亡，你可以选择伪装成农夫。只需要接近他并悄悄告诉他们你要伪装成农夫，");
    g_tipLine[19928] = StringToText("  你在另一名邪恶玩家死亡的晚上成为了农夫。这个方法在和会杀死爪牙的恶魔例如亡骨魔搭配时会尤其有效。");
    g_tipLine[19929] = StringToText("· 作为农夫伪装可能会有些困难因为你需要与其他邪恶玩家合作。如果你因为种种原因在夜晚死亡，你可以自称是农夫。");
    g_tipLine[19930] = StringToText("  这位另一名邪恶玩家创造了自称是农夫与你呼应的机会。但是这并不意味着你被其他人信任，这只能确认你们是一伙的。");
    g_tipLine[19931] = StringToText("· 伪装成农夫可能是对抗真农夫的一个好方法。如果你作为农夫现身，真正的农夫可能会被迫与你对质以防止你们的故事被相");
    g_tipLine[19932] = StringToText("  信。");
    g_tipLine[19933] = StringToText("【伪装成魔像】");
    g_tipLine[19934] = StringToText("· 伪装魔像有些难办。多数时候，一个真正的魔像在提名时会导致死亡。你需要预备一个理由来解释为什么你提名的玩家没有");
    g_tipLine[19935] = StringToText("  死亡。要么是醉酒或中毒（不太可能），要么你选择了恶魔（也不太可能）。");
    g_tipLine[19936] = StringToText("· 提名那些非常可疑看起来像是恶魔的玩家。");
    g_tipLine[19937] = StringToText("· 如果你是爪牙，在游戏早期提名，并预期会因此而死亡。当你提名一名玩家而他们没有死亡，很可能善良阵营会选择杀死你");
    g_tipLine[19938] = StringToText("  和你提名的玩家，恶魔会利用这两个晚上杀死两名玩家。杀掉四名玩家是一个进入最后一天的有效方法，");
    g_tipLine[19939] = StringToText("  但你需要因此牺牲自己。");
    g_tipLine[19940] = StringToText("· 如果你是恶魔，请等到游戏后期再提名玩家。随着存活玩家越来越少，你提名真正恶魔的几率也越来越大，");
    g_tipLine[19941] = StringToText("  善良阵营更可能相信你是魔像而不是处决你。即便你最终只能说服善良阵营先处决被提名的玩家再在明天处决你，");
    g_tipLine[19942] = StringToText("  只要你是可以在晚上杀死多人的恶魔，比如沙巴洛斯、珀或哈迪寂亚，你也能确保明天永不会到来。");
    g_tipLine[19943] = StringToText("【伪装成落难少女】");
    g_tipLine[19944] = StringToText("· 落难少女是当起来十分危险的角色。如果在错误的时间在错误的人面前现身会让她们的阵营落败。");
    g_tipLine[19945] = StringToText("  如果你想伪装成落难少女，你需要展现这种心态——比如没有落难少女会在团队公开现身。像是你的能力会导致你落败一样");
    g_tipLine[19946] = StringToText("  来玩游戏（谨慎、守口如瓶、公开撒谎），否则善良阵营会感觉你并不像你看起来那么无助！");
    g_tipLine[19947] = StringToText("· 基于特殊胜利能力的缘故，相较于其他角色，落难少女是更进阶的伪装——无论善良阵营还是邪恶阵营都对找出落难少女充");
    g_tipLine[19948] = StringToText("  满斗志。不要对这种情况太过沮丧——虽然善良阵营会对你投以额外的关注，但他们不会轻易地喊出你（因为如果他们错了，");
    g_tipLine[19949] = StringToText("  他们就会落败！），你能否说服他们？你是特别的。高风险能带来高回报。");
    g_tipLine[19950] = StringToText("· 落难少女通常会试着选择一名她们信任的善良玩家接纳她们，你也可以这样做。找一名你需要花费许多时间接触的善良玩家，");
    g_tipLine[19951] = StringToText("  让他来担心你和一个潜在的巡山人，而不是担心你的恶魔和其余邪恶阵营成员。通过分享你的秘密，");
    g_tipLine[19952] = StringToText("  你可以很容易地建立一种信任纽带并且可以持续数天，并且可以期望那名玩家会花心思在你和你的问题上，");
    g_tipLine[19953] = StringToText("  而不是诸如“恶魔是谁”这样更会对你产生压力的问题！");
    g_tipLine[19954] = StringToText("· 与邪恶阵营合作可以产生非常有效的落难少女伪装。最明显的选择是你们其中一人伪装巡山人另一人伪装落难少女。");
    g_tipLine[19955] = StringToText("  一旦他“找到”你并成功转变你，你们俩就都可以以善良阵营现身！如果你要试着这样做，确保让善良阵营来努力让你们重");
    g_tipLine[19956] = StringToText("  逢——如果你们在没有任何缘由的情况下突然走到一起，玩家反而会怀疑你。如果你的邪恶盟友遭受抨击，");
    g_tipLine[19957] = StringToText("  也要准备好放弃这个伪装——落难少女可以在没有巡山人的情况下存在，如果你可以看起来像是狡诈爪牙陷阱的受害者就更");
    g_tipLine[19958] = StringToText("  好了！");
    g_tipLine[19959] = StringToText("· 如果你们说服一名邪恶盟友主动承担（公开猜测落难少女），那么在爪牙被欺骗而猜测错误后一个洋洋得意的落难少女现身");
    g_tipLine[19960] = StringToText("  会非常顺畅。善良阵营不仅会对这位落难少女的落败能力无效而放轻松，而且也会对一名邪恶玩家暴露自己而感到满意！");
    g_tipLine[19961] = StringToText("  要注意时机——一个爪牙通常会在感到非常确信或是非常绝望时才会做出对落难少女的猜测。如果成功，");
    g_tipLine[19962] = StringToText("  你会在接下来的游戏中都被相信是善良的。");
    g_tipLine[19963] = StringToText("· 如果你打算假装已经被转变（角色），确保小心地选择你的新角色——与一名善良玩家对峙角色将使得你到目前为止的所有");
    g_tipLine[19964] = StringToText("  努力都付诸东流，因为巡山人总能把落难少女转变为不在场的角色。");
    g_tipLine[19965] = StringToText("· 如果你打算假装已经被转变，故意和一名其他善良玩家对峙角色并控诉他们在他们的能力上撒谎！");
    g_tipLine[19966] = StringToText("  落难少女不能变成一个在场角色，所以如果小镇相信你，那另一个人一定在撒谎。:)");
    g_tipLine[19967] = StringToText("· 如果你初始的善良角色伪装被识破，使用落难少女作为备选方案——和畸形秀演员类似，如果善良玩家认为你撒谎的原因是");
    g_tipLine[19968] = StringToText("  为了掩盖你的外来者角色而不是你事实上是邪恶的，他们可能会收回原本的主张。每个人都知道落难少女是潜在的麻烦，");
    g_tipLine[19969] = StringToText("  所以一些有针对性的眼神接触或私聊有望印证你的观点！");
    g_tipLine[19970] = StringToText("· 试着让一个爪牙以外的邪恶玩家公开猜测某人是落难少女。这种做法可能说服真正的落难少女，有爪牙已经使用了他们唯一");
    g_tipLine[19971] = StringToText("  的猜测机会，因此她可以公开地透露自己——这会允许一个真正的爪牙猜测真正的落难少女而获胜。");
    g_tipLine[19972] = StringToText("  但是要非常小心——在大多数游戏中，唯一并非爪牙的邪恶玩家是恶魔，因此这是一种达成起来会有高风险的策略，");
    g_tipLine[19973] = StringToText("  因为这通常需要恶魔宣称自己是邪恶角色。但是如果你有一名转变为邪恶的（前）善良玩家——比如莽夫，");
    g_tipLine[19974] = StringToText("  或是被灵言师或赏金猎人转变为邪恶的玩家——他们就可以很好地扮演这个角色。只是要确保伪装成爪牙的邪恶玩家不要选");
    g_tipLine[19975] = StringToText("  中“真正的”落难少女，因为当游戏没有结束，落难少女将会明白这是个诡计。");
    g_tipLine[19976] = StringToText("【伪装成无神论者】");
    g_tipLine[19977] = StringToText("· 如果你是一名爪牙玩家，你可以伪装自己是无神论者，而不必担心会有真正的无神论者在场，因为无神论者对局中不会存在");
    g_tipLine[19978] = StringToText("  任何邪恶玩家，所以你是爪牙角色意味着无神论者不在场。");
    g_tipLine[19979] = StringToText("· 如果你是一名恶魔玩家，即使说书人并没有在你的伪装角色中加入无神论者，你也可以大胆地伪装成无神论者，");
    g_tipLine[19980] = StringToText("  无神论者对局中不会存在任何邪恶玩家，因此在你收到恶魔信息的一刹那，无神论者一定不在场。");
    g_tipLine[19981] = StringToText("· 如果你打算伪装成无神论者，那么请做好随时会被处决的准备。大多数情况下，很少有声称是无神论者的玩家可以活到最后");
    g_tipLine[19982] = StringToText("  一天。因此，那些已经使用过能力的角色更适合谎称自己是无神论者，例如男爵；或是能力在死后仍然有作用的角色，");
    g_tipLine[19983] = StringToText("  例如灵言师。如果场上有可以在恶魔死亡后让游戏继续的角色，例如红唇女郎、主谋或是小恶魔，");
    g_tipLine[19984] = StringToText("  会使恶魔玩家伪装无神论者变得容易。");
    g_tipLine[19985] = StringToText("· 如果你作为邪恶玩家希望通过伪装成无神论者来获胜，第一种主要策略就是要花时间向善良阵营证明你是无神论者。");
    g_tipLine[19986] = StringToText("  和其他角色不同，你需要比平常更加依赖社交方式，因为绝大多数无神论者玩家对自己知道的情况和胜利的方式表现得极其");
    g_tipLine[19987] = StringToText("  自信。不过利用善良阵营的信息印证你的逻辑也是可行的，不论是共情者得知坐在他身边的你是邪恶玩家还是中毒的共情者");
    g_tipLine[19988] = StringToText("  得知你是善良玩家都可以被你利用来证明你确实是无神论者，因为说书人可以打破规则，给与了善良阵营错误信息。");
    g_tipLine[19989] = StringToText("· 通过伪装成无神论者来获胜的第二种主要策略就是让善良阵营相信他们之间的信息产生了过多的矛盾点，");
    g_tipLine[19990] = StringToText("  来表明场上存在过多的邪恶玩家这个情况不合理，并以此说服善良阵营。这不同于说服他们某名玩家或某群玩家是邪恶玩家，");
    g_tipLine[19991] = StringToText("  后者的操作对无神论者是不合理的。如果你可以顺利让善良阵营对目前的局势分析产生疑惑，他们很有可能在慌乱下，");
    g_tipLine[19992] = StringToText("  轻信了你的观点处决了说书人，或者是处决了错误的邪恶玩家，让恶魔顺利存活，无论那种情况，邪恶方都能获胜。");
    g_tipLine[19993] = StringToText("  这种策略最适用于能制造较多混乱的角色，比如投毒者或亡骨魔。");
    g_tipLine[19994] = StringToText("· 第三种伪装无神论者获胜的主要策略是向善良阵营证明他们获得的信息太过合理！因为在真正的无神论者对局中，");
    g_tipLine[19995] = StringToText("  说书人通常会尽力让所有的信息指向一致，或者至少让所有玩家看上去都是善良玩家，提出所有事情都太过合理的原因是由");
    g_tipLine[19996] = StringToText("  于说书人（的操作）。这种策略最适用于能够伪装成善良角色的角色，比如间谍或是小恶魔。");
    g_tipLine[19997] = StringToText("· 总的来说，如果你的计划是说服大家所有玩家都是善良的，那么你需要让你的队友和你一起提供非常一致或者极其不准确的");
    g_tipLine[19998] = StringToText("  信息。如果你的目标是让一些善良阵营玩家提前被处决以此来增加邪恶方的胜率，让你的队友和你一起提供一些可以指向特");
    g_tipLine[19999] = StringToText("  定玩家是邪恶阵营的错误信息。");
    g_tipLine[20000] = StringToText("【伪装成罂粟种植者】");
    g_tipLine[20001] = StringToText("· 作为邪恶玩家，你一定知道游戏中是否有罂粟种植者。如果你知道你的邪恶盟友是谁，那就一定没有罂粟种植者。因此，");
    g_tipLine[20002] = StringToText("  即使它没有出现在恶魔获得的“不在场”伪装中，恶魔和爪牙也可以安全地使用它作为伪装。这种伪装是如此安全以至于（");
    g_tipLine[20003] = StringToText("  类似无神论者的伪装）你可能会发现其他邪恶玩家也在向其他人秘密宣称自己是罂粟种植者，你可能会意外地碰到好几个假");
    g_tipLine[20004] = StringToText("  罂粟种植者。");
    g_tipLine[20005] = StringToText("· 当你被提名时，宣称自己是唯一能阻止邪恶阵营互相得知的存在是一个非常具有说服力的理由，能让你幸存。");
    g_tipLine[20006] = StringToText("  然而你需要想好一个解释来说明你为何能熬过当晚。");
    g_tipLine[20007] = StringToText("· 你可以告诉一至两个人你是罂粟种植者，让善良阵营错误地相信他们即将获胜。");
    g_tipLine[20008] = StringToText("· 不要告诉任何人你是罂粟种植者，并使用某些方法杀死自己，等到一天结束时，宣布今天私下谈话的人可能是邪恶的，");
    g_tipLine[20009] = StringToText("  因为邪恶阵营刚彼此得知。");
    g_tipLine[20010] = StringToText("· 如果罂粟种植者在场，伪装成罂粟种植者至少很可能骗他们现身。真正的罂粟种植者会知道你在撒谎，");
    g_tipLine[20011] = StringToText("  但至少恶魔现在知道谁是罂粟种植者。善良阵营甚至可能犹豫该处决你们中哪一个，因为他们会担心邪恶阵营会在真正的罂");
    g_tipLine[20012] = StringToText("  粟种植者死后彼此得知。");
    g_tipLine[20013] = StringToText("· 罂粟种植者是一个优秀的死后伪装。它微妙地传递出一个信息，邪恶阵营将变得比之前更能互相协作，");
    g_tipLine[20014] = StringToText("  如果你们已经合作得很不错，这会让你们看起来更强大。一个对胜利失去信心的善良阵营可能是你需要的强心剂。");
    g_tipLine[20015] = StringToText("· 罂粟种植者游戏通常会有一种奇妙的氛围。和军团游戏类似，善良阵营也会感觉到某些地方出现了问题。");
    g_tipLine[20016] = StringToText("  虽然他们很难确定具体怎么了，但这主要是由于邪恶阵营正在努力搞明白他们怎么重新聚拢成一个阵营。然而，");
    g_tipLine[20017] = StringToText("  有时游戏仅仅只是感觉有些诡异，仿佛每个人都太过安静或者什么事情都没发生。如果你的游戏存在这种感觉，");
    g_tipLine[20018] = StringToText("  你可以考虑从最初的伪装转为伪装成罂粟种植者，以此向善良阵营解释这种感觉的来源。在善良阵营说出“发生什么事了？");
    g_tipLine[20019] = StringToText("  感觉怪怪的”之后的数日内作为罂粟种植者现身可能会让感觉变得清晰而放松。多数时候，聪明的做法是选择一个角色来伪");
    g_tipLine[20020] = StringToText("  装，并让这种伪装左右游戏。但有时候，聪明的做法是让游戏来决定何种伪装最合适。");
    g_tipLine[20021] = StringToText("【伪装成赏金猎人】");
    g_tipLine[20022] = StringToText("· 伪装成赏金猎人将是一个漫长的过程。你可能需要编排一段详尽的故事来陈述在整个游戏过程中你发现了哪些邪恶玩家。");
    g_tipLine[20023] = StringToText("  耐心等待可能是一个不错的选择，观察游戏来让你可以更清晰地讲明白你的故事。要记得，你需要记住你得知的邪恶玩家序");
    g_tipLine[20024] = StringToText("  列，并且与你宣称需要淘汰的玩家信息相一致。");
    g_tipLine[20025] = StringToText("· 伪装赏金猎人会给其他玩家带来很多阴影，你可以杀死关键玩家或离间善良玩家。提防那些能检测阵营的角色，");
    g_tipLine[20026] = StringToText("  例如共情者和异教领袖，他们可能会轻易戳穿你的谎言。");
    g_tipLine[20027] = StringToText("· 伪装成赏金猎人也意味着你将会指认一名或以上的善良玩家是邪恶玩家，你指认的玩家越多，你的敌人也会越多。然而，");
    g_tipLine[20028] = StringToText("  如果你能很好地平衡好你每一天的逻辑，这或许可以直接割裂善良阵营。或是在恶魔受到怀疑是让大家将注意力从恶魔身上");
    g_tipLine[20029] = StringToText("  转移出去。");
    g_tipLine[20030] = StringToText("· 诱骗几名善良阵营的玩家加入你的团队，因为你需要和他们分享你的虚假信息来鼓动他们去处决那些你认为的邪恶玩家。");
    g_tipLine[20031] = StringToText("  在第一天挑选一两名你想拉拢的玩家，向他们提供你的信息，即使你在某一天不幸被发现，你也很有可能已经处决了一到两");
    g_tipLine[20032] = StringToText("  名善良玩家，然后自己被处决，使得所有这些处决都不会落到恶魔身上。");
    g_tipLine[20033] = StringToText("· 如果你公开角色，请做好你会被处决或者是和恶魔沟通让他杀死你，因为一个活很久的赏金猎人是难以服众的。一般来说，");
    g_tipLine[20034] = StringToText("  赏金猎人因为最终能得知恶魔，所以可能是夜晚恶魔最优先攻击的目标。因此，当你觉得自己的爪牙能力已经不再有价值时，");
    g_tipLine[20035] = StringToText("  让恶魔在你“公开”后杀死你反而是博取信任的最佳方法。");
    g_tipLine[20036] = StringToText("· 如果某名玩家的投票没有章法，你可以声称他就是那名已经被你转变为邪恶的镇民。因为赏金猎人创造的邪恶镇民不知道邪");
    g_tipLine[20037] = StringToText("  恶玩家是谁，可能投票就会显得如此。这是一个孤立已经被核实角色的镇民的好方法，因为他们确实是镇民，");
    g_tipLine[20038] = StringToText("  但因为你而变为邪恶。这招对猎手和贞洁者特别有效，因为即使他们是邪恶的，他们的能力仍然生效。");
    g_tipLine[20039] = StringToText("【伪装成小精灵】");
    g_tipLine[20040] = StringToText("· 你是一个陷入尴尬对峙宣称的爪牙吗？伪装成茶艺师，但你邻近的善良玩家刚刚死亡，而另一位茶艺师宣称她有一位愤怒的");
    g_tipLine[20041] = StringToText("  祖母支持他们？别苦恼，只要悄悄走到他们身旁，然后在他们耳旁甜腻软语：“嗨，我其实是小精灵！”");
    g_tipLine[20042] = StringToText("  镇民们通常会非常乐意得知有一个小精灵与他们对峙，因为这证明了他们（角色）存在并为他们的意外死亡提供了一个备用");
    g_tipLine[20043] = StringToText("  方案——依靠这点从你的失误中恢复并保持让善良阵营揣测，但希望他们能站在你这边更久一些。");
    g_tipLine[20044] = StringToText("· 如果你陷入了尴尬的境地，那么小精灵就会是你的伟大福音，但你也可以从一开始就计划成为一个小精灵。");
    g_tipLine[20045] = StringToText("  选择一个你怀疑在场的镇民然后去小镇上！如果你选择的镇民确实在场，他们可能会在某个时刻与你联系，");
    g_tipLine[20046] = StringToText("  但你也可以以此说服大家一个其实不在场的特定角色在场，或通过“证明”他们一定在场来为邪恶玩家的伪装提供可信度！");
    g_tipLine[20047] = StringToText("  当你感受到了游戏的节奏时，故意以小精灵疯狂的方式强势现身给了你许多手段来操作。");
    g_tipLine[20048] = StringToText("· 选择一名明显的善良玩家并以小精灵伪装来与其宣称同一角色将会使得其他玩家相信那个人也相信你。相反，");
    g_tipLine[20049] = StringToText("  支持一名邪恶玩家的伪装将帮助他看起来更可靠，但如果你们其中一人被抓出来，你们两个就会被当作邪恶搭档。");
    g_tipLine[20050] = StringToText("· 如果小镇不信任顽皮的小精灵，利用这一点故意作为小精灵现身并将自己与一名其他玩家绑定。如果团队怀疑你是邪恶的，");
    g_tipLine[20051] = StringToText("  那么与你重复宣称的那个倒霉鬼会看起来像是共谋。");
    g_tipLine[20052] = StringToText("· 秘密地向其他玩家透露你是小精灵，以此赢取他们的信任来延长你的寿命。保持小精灵的存活是有价值的，");
    g_tipLine[20053] = StringToText("  因此那些玩家一定知道你的宣称意味着他们需要在其他人试图处决你时介入。毕竟，你也不用害怕打破疯狂的后果！");
    g_tipLine[20054] = StringToText("· 你伪装成小精灵，但一个真正的小精灵刚刚现身？不要有太大的压力！对峙的小精灵为善良阵营创造了一个真正的难题，");
    g_tipLine[20055] = StringToText("  你们每个都由你们的能力与宣称被绑在了另一名玩家身上，因而待解之结不仅是你们那一个才是真正的小精灵，");
    g_tipLine[20056] = StringToText("  还有你们到底是一对共谋的邪恶玩家还是一名邪恶残忍的邪恶玩家腐化了一名无辜的善良玩家！大量的噪音与混乱让小镇失");
    g_tipLine[20057] = StringToText("  去了恶魔的线索。");
    g_tipLine[20058] = StringToText("· 如果你的镇民死亡，你作为“小精灵”将获得他们的能力并扮演他们（除非你“打破了疯狂”）。");
    g_tipLine[20059] = StringToText("  确保你知道人们开始向你索取信息时能力的生效情况。知道你的镇民的死亡时间也很有好处——如果你是占卜师小精灵而前");
    g_tipLine[20060] = StringToText("  任占卜师两天前死亡了，那你应当有两个晚上的信息！");
    g_tipLine[20061] = StringToText("· 如果恶魔的三个伪装之一是小精灵，那你会有许多玩法选择。");
    g_tipLine[20062] = StringToText("· 你可以用小精灵伪装，通过“确认”一名在场角色来支持你自己的合理性。");
    g_tipLine[20063] = StringToText("· 或者，你可以将其与你的一个伪装结合，在你和一名邪恶盟友之间制造虚假的不和，并在你们其中之一死亡时“解决”这个");
    g_tipLine[20064] = StringToText("  不和。");
    g_tipLine[20065] = StringToText("· 最后，如果你运气够好，你会发现你宣称你“看到”了一个不在场的角色，这实际上提供了你一个自由且额外的伪装。");
    g_tipLine[20066] = StringToText("· 如果小精灵确实在场，他们不太可能在游戏早期就作为小精灵现身。如果你能辨别出他是谁并确保他和他看到的角色都不死");
    g_tipLine[20067] = StringToText("  亡，你会发现你可以宣称自己是小精灵而真正的小精灵则被迫保持沉默来维持他们的疯狂。当他们最终宣告他们才是真正的");
    g_tipLine[20068] = StringToText("  小精灵时，他们不得不面对艰难的战斗来取代你成为“正统”小精灵。");
    g_tipLine[20069] = StringToText("【伪装成告密者】");
    g_tipLine[20070] = StringToText("· 如果你是恶魔，等待多数或全部善良玩家都透露了他们的角色后才透露你是告密者。这将能帮助爪牙选择一个不在场的角色");
    g_tipLine[20071] = StringToText("  来伪装。如果一个爪牙已经伪装成与善良玩家相同的角色，那么你最好选择一个不同的角色来伪装——除非你希望那名爪牙");
    g_tipLine[20072] = StringToText("  被处决。当一名邪恶玩家伪装成告密者时，如果其他邪恶玩家伪装成在场角色，看起来就好像告密者在撒谎。");
    g_tipLine[20073] = StringToText("· 如果你是爪牙，和恶魔交谈并询问哪三个角色不在场，并将此信息传递给其他所有爪牙。这将有助于邪恶玩家伪装成不在场");
    g_tipLine[20074] = StringToText("  角色然后推出告密者在场。");
    g_tipLine[20075] = StringToText("· 在伪装成告密者之后，鼓励所有善良玩家说出他们是何角色的实情。这将有助于恶魔选择出最恰当的夜晚击杀目标，");
    g_tipLine[20076] = StringToText("  以及帮助邪恶阵营选择应当投票处决哪些玩家。这是有较大风险的，因为这要求邪恶阵营在游戏早期就进行伪装且阻断了之");
    g_tipLine[20077] = StringToText("  后改变伪装的可能。");
    g_tipLine[20078] = StringToText("· 在伪装成告密者之后，鼓励所有善良玩家尽可能长时间地对自己的角色保持沉默。如果所有善良玩家都等待一段时间才透露");
    g_tipLine[20079] = StringToText("  他们的角色，并且所有玩家在游戏后期都透露了角色，并且没有两名玩家宣称了相同的角色，这会使得告密者更值得信任，");
    g_tipLine[20080] = StringToText("  也不太可能被处决。这看起来像是邪恶玩家获得了安全的伪装且告密者在游戏中。如果你是唯一一名宣称告密者的玩家，");
    g_tipLine[20081] = StringToText("  你会显得很善良。");
    g_tipLine[20082] = StringToText("【伪装成炼金术士】");
    g_tipLine[20083] = StringToText("待更新");
    g_tipLine[20084] = StringToText("【伪装成将军】");
    g_tipLine[20085] = StringToText("· 通过反复宣称你被告知善良阵营即将落败来让善良阵营持续处于不佳和多疑的状态中。");
    g_tipLine[20086] = StringToText("· 构陷一个死亡的善良玩家，在他们被处决后说出说书人告知你善良阵营即将获胜。");
    g_tipLine[20087] = StringToText("· 试着让善良玩家怀疑他们的信息，说出你被告知善良阵营即将落败，但你并不知道为什么。如果你知道善良阵营正在获得大");
    g_tipLine[20088] = StringToText("  量有用而正确的信息时，这方法尤其有效。");
    g_tipLine[20089] = StringToText("· 如果你认为邪恶阵营即将获胜，即使是微弱优势，也要始终告诉团队善良阵营即将获胜而不是说没有阵营即将获胜。");
    g_tipLine[20090] = StringToText("  如果善良阵营在没有优势的情况下持续相信他们即将获胜，他们就会继续相信他们已经相信的而不会将怀疑目标转向一名新");
    g_tipLine[20091] = StringToText("  玩家。在最后一天，自信于他们在整个游戏中做出了正确决定和明智判断，他们很可能会基于错误信息处决错误的玩家。");
    g_tipLine[20092] = StringToText("  鼓励他们的过度自信。");
    g_tipLine[20093] = StringToText("· 为了提供更具有伤害力的错误信息，可以以降低可信度为代价，给出在“善良阵营即将获胜”与“邪恶阵营即将获胜”之间");
    g_tipLine[20094] = StringToText("  波动剧烈的信息。这种信息意味着团队正在作出会左右游戏走向的重大决策，并且会产生令善良阵营错误地分析他们之前的");
    g_tipLine[20095] = StringToText("  假设和行动的效果。然而，如果你的信息太过狂野以至于和之前的行动完全不符，他们可能不会相信你而处决你。因此，");
    g_tipLine[20096] = StringToText("  这种策略更适合爪牙。");
    g_tipLine[20097] = StringToText("· 为了更可信，可以以减少具伤害力的错误信息为代价，而从不在连续数晚中给出在“善良阵营即将获胜”与“邪恶阵营即将");
    g_tipLine[20098] = StringToText("  获胜”之间波动的信息。至少有一晚给出你被告知“没有阵营正在获胜”能使得从一个阵营跳转到另一个阵营即将获胜显得");
    g_tipLine[20099] = StringToText("  不那么突兀，而更多地像是几天间逐渐变化的结果。从一个阵营即将获胜向另一个阵营（即将获胜）");
    g_tipLine[20100] = StringToText("  的逐步转变更符合现实，因此善良阵营更有可能相信你是将军。然而，这种策略对善良阵营的决策影响较小，");
    g_tipLine[20101] = StringToText("  或者至少影响所需的时间较久。因此这种策略更适合恶魔。");
    g_tipLine[20102] = StringToText("· 每当有重大情况发生在游戏中，比如善良阵营参与并几乎要处决一个公开的哥布林，或是送葬者告诉团队红唇女郎一定在场");
    g_tipLine[20103] = StringToText("  因为恶魔刚被处决，或是贞洁者导致一名玩家被处决，或是醒来时突然发现死亡的玩家宣称自己是呆瓜，");
    g_tipLine[20104] = StringToText("  明确地转变你声称即将获胜的阵营。想必到此时为止你一直在传播关于哪个阵营即将获胜的错误信息。");
    g_tipLine[20105] = StringToText("  在一个重大情况之后，将军完全有理由知道新的一方即将获胜。利用好善良阵营的信念并借此机会向他们提供更具有戏剧色");
    g_tipLine[20106] = StringToText("  彩的错误信息。");
    g_tipLine[20107] = StringToText("【伪装成政客】");
    g_tipLine[20108] = StringToText("· 通过暗示你是政客，而不是直接以政客角色现身来戏弄玩家团队会带来很多乐趣。通过夸张的表现，");
    g_tipLine[20109] = StringToText("  你可以让其他玩家产生双重怀疑。此外，如果剧本上有哥布林，你可以暗示你是，让玩家产生三重怀疑。");
    g_tipLine[20110] = StringToText("· 如果你是一名嗷嗷待宰的邪恶玩家，宣称你是政客来解释你阴暗和邪恶的行为。向大家保证如果他们让你存活你就做个善良");
    g_tipLine[20111] = StringToText("  的人。并且继续以此威胁他们（如果他们反悔你就做坏事）。然而，将政客用作备用伪装可能带来反效果，");
    g_tipLine[20112] = StringToText("  因为人们可能会想处决你来降低你的投票和提名能力。");
    g_tipLine[20113] = StringToText("· 如果你认为善良阵营即将获胜，宣称你是政客，仅仅是为了给局势制造一个大麻烦。突然间增加了一个潜在的额外邪恶票在");
    g_tipLine[20114] = StringToText("  场，让团队必须将其纳入考虑，这给控制投票带来了更大的压力。");
    g_tipLine[20115] = StringToText("· 谨慎地告诉一些人你是政客，这样你稍后的阴暗邪恶行为看起来就显得更为合理。那之后，无耻地提名圣徒并试图处决他们，");
    g_tipLine[20116] = StringToText("  或是试着让镜像双子中错误的那个被处决。");
    g_tipLine[20117] = StringToText("· 秘密告诉一至两名玩家你是政客，并暗示他们可以制造价值换取你不破坏善良阵营。利用你可能转入邪恶阵营的威胁来让善");
    g_tipLine[20118] = StringToText("  良阵营帮你完成你的肮脏计划。没有什么比骗人做事更有趣了。你可以指导半兽人选择夜晚的目标，");
    g_tipLine[20119] = StringToText("  让善良阵营淘汰罂粟种植者。");
    g_tipLine[20120] = StringToText("· 在已经有人宣称是政客时伪装成政客！这会制造许多混乱和噪音，因为玩家不知道该相信哪名玩家。更重要的是，");
    g_tipLine[20121] = StringToText("  你可以通过加码和采取最邪恶的行动来倾泻这种胡搅蛮缠。");
    g_tipLine[20122] = StringToText("【伪装成异端分子】");
    g_tipLine[20123] = StringToText("· 大多数异端分子会等到游戏最后一天才露面。如果你想以这种方式伪装成异端分子，那要么你在游戏的大部分时间里对你的");
    g_tipLine[20124] = StringToText("  角色保持沉默，要么先伪装成另一个角色。根据团队的不同，这种行为模式可能会让你在最后一天来临前就被处决。");
    g_tipLine[20125] = StringToText("  爪牙并不害怕处决，尤其是异端分子的能力在死亡时仍有效。但一个恶魔伪装成异端分子确实是高风险的。");
    g_tipLine[20126] = StringToText("  先以另一伪装现身——并使它可信。");
    g_tipLine[20127] = StringToText("· 记得将异端分子作为备用的伪装。如果你的首个伪装无法正常运转，那么宣称你在撒谎因为你是异端分子是比较可信的。");
    g_tipLine[20128] = StringToText("  异端分子有充分的理由撒谎。如果你的首个伪装成功了，那么你就不必宣称是异端分子，随意地将它作为高风险而荒谬的伪");
    g_tipLine[20129] = StringToText("  装丢掉就好！");
    g_tipLine[20130] = StringToText("· 如果你的一名邪恶盟友玩家被提名，而你确实需要让他存活，突然地宣称是异端分子，并宣称你认为团队即将处决恶魔并落");
    g_tipLine[20131] = StringToText("  败。如果善良阵营足够紧张，尤其是认为被提名者足够邪恶以至于是首先被提名的对象，他们可能会立即放弃并投票给另一");
    g_tipLine[20132] = StringToText("  名玩家。");
    g_tipLine[20133] = StringToText("· 如果两名邪恶玩家都宣称是异端分子，那么看起来他们其中一人一定在说实话而另一人是邪恶的。通常，");
    g_tipLine[20134] = StringToText("  当两名邪恶玩家都宣称自己是同一个善良角色时，团队会希望处决双方，因为相信其中一名是善良玩家而另一名是邪恶的。");
    g_tipLine[20135] = StringToText("  然而，如果善良阵营认为一名玩家是邪恶的而另一名玩家是真的异端分子，那么他们可能会选择让两人都存活以免意外处决");
    g_tipLine[20136] = StringToText("  恶魔。");
    g_tipLine[20137] = StringToText("· 一个真正的异端分子不太可能在第一天就现身并为此自豪。如果你尝试更腼腆并暗示你可能是异端分子但不去确证它，");
    g_tipLine[20138] = StringToText("  你会显得更令人信服。");
    g_tipLine[20139] = StringToText("· 要特别注意善良阵营中计划处决的人。和其他的伪装不同，（其他伪装）如果被善良阵营相信，他们可能不会处决你；");
    g_tipLine[20140] = StringToText("  （伪装异端分子）如果被善良阵营相信，他们可能会处决你，因为他们现在想处决善良玩家，尤其是在游戏后期。");
    g_tipLine[20141] = StringToText("  如果善良阵营认为异端分子在场，他们的策略会反转。确保这实际上是你一开始就想要达成的。");
    g_tipLine[20142] = StringToText("· 如果你是一名善良玩家，可以伪装成异端分子。如果邪恶阵营相信你，他们可能会说服他们的恶魔在夜晚自杀，");
    g_tipLine[20143] = StringToText("  并为善良阵营赢得胜利！反而，如果真的有一个真正的异端分子在场，你可能意外地转而帮助邪恶阵营获胜。");
    g_tipLine[20144] = StringToText("  这确实很有风险！此外，伪装成异端分子会给善良阵营带来很多混乱，因为他们无法确定他们的游戏目标是什么。然而，");
    g_tipLine[20145] = StringToText("  在玩了许多局游戏之后，不时地有善良玩家伪装成异端分子一定会让恶魔玩家怀疑在夜晚自杀是否值得。对善良阵营而言，");
    g_tipLine[20146] = StringToText("  怀疑真正异端分子进行的宣称的恶魔显然是更好的，只有偶尔有善良玩家伪装成异端分子才会发生这种情况。");
    g_tipLine[20147] = StringToText("【伪装成传教士】");
    g_tipLine[20148] = StringToText("· 伪装成传教士可能会有些难做，因为即使是真正的传教士也不会在游戏中获得多少反馈来支持他们的宣称。然而，");
    g_tipLine[20149] = StringToText("  你可以使用你伪装出的能力给其他玩家制造一些阴影或是建立一些信任。");
    g_tipLine[20150] = StringToText("· 为了增加你伪装的可信度，你可以与邪恶阵营合作让爪牙能力消失！只需要使用一个具有公开信息的爪牙能力（例如女巫或");
    g_tipLine[20151] = StringToText("  是洗脑师），然后通过选择邪恶玩家为目标一定时间来掩藏能力。随后你就可以将女巫没有制造死亡或是无人处于疯狂的情");
    g_tipLine[20152] = StringToText("  况归咎于任何一名你选中的倒霉无辜善良玩家，宣称由于你向他们传教而放逐了他们的能力！");
    g_tipLine[20153] = StringToText("· 谨慎选择你控诉为爪牙的人！如果小镇相信你，他们就会认为那个人不是目标恶魔，并且既然你已经无效化了他们，");
    g_tipLine[20154] = StringToText("  大家就可能更愿意四处去处决未知的玩家而不是被你控诉的善良玩家！（当然如果你怀疑他们会这么操作，");
    g_tipLine[20155] = StringToText("  你可以故意抹黑你的恶魔——小镇会把他们当做一个失去能力的爪牙而无视他们一天！）");
    g_tipLine[20156] = StringToText("· 如果某人的行为从前一晚到后一晚发生了巨大变化，你可以暗示这种行为变化是因为你是传教士并且你前一晚选择了他。");
    g_tipLine[20157] = StringToText("  这意味着他们突然做出的不同行动是因为他们得知了自己失去能力。");
    g_tipLine[20158] = StringToText("· 你可以试着用你的能力来建立信任。你可以秘密地找到一名善良玩家，向他们透露你昨晚在他们身上使用了你的传教士能力。");
    g_tipLine[20159] = StringToText("  你可以继续暗示由于他们的行为看起来没有什么不同，你信任他们不是爪牙（显然你知道他们不是，但他们不知道这点）。");
    g_tipLine[20160] = StringToText("  这与管家的伪装有异曲同工之妙——单靠传教士没有任何办法证明他们选择了谁，但仅靠选择和“澄清”就可以激发另一名");
    g_tipLine[20161] = StringToText("  玩家的信任。");
    g_tipLine[20162] = StringToText("· 如果你的伪装快被识破了，可以宣称自己一直是传教士作为备选方案。传教士在现身后是邪恶阵营的主要目标，");
    g_tipLine[20163] = StringToText("  因此你说谎是合理的。这也可以作为从处决下存活的最后一搏，你可以警告说如果没有你，爪牙们会重新获得能力！");
    g_tipLine[20164] = StringToText("· 故意在夜晚死去并作为传教士现身，然后抹黑一些善良玩家！你可以让恶魔杀了你，或者如果你是一个类似方古这样的恶魔");
    g_tipLine[20165] = StringToText("  你可以交棒。一个在夜晚死亡的传教士比一个被处决的传教士更可信。");
    g_tipLine[20166] = StringToText("· 一旦你死亡并且你还有爪牙共犯存活，你可以说你是真正而诚信的传教士。只需要让他们在你死亡前隐藏能力，");
    g_tipLine[20167] = StringToText("  然后进入小镇公开制造麻烦（例如刺客杀人或者魔鬼代言人阻止处决死亡）。");
    g_tipLine[20168] = StringToText("· 指出你在选择了某名特定玩家之后就马上死亡了，而这个爪牙逍遥法外了！这很有风险，但是如果你成功了，");
    g_tipLine[20169] = StringToText("  小镇不仅会为你的死亡难过，还会迁怒于被你指名为爪牙的替罪羊！");
    g_tipLine[20170] = StringToText("【伪装成国王】");
    g_tipLine[20171] = StringToText("· 国王确实是一个伪装起来非常有趣的角色。玩家们倾向于愿意接受大声指挥的国王来指导游戏的进程。");
    g_tipLine[20172] = StringToText("  国王角色是你试着引导游戏叙事的一个好理由，因为你应当有许多角色信息触手可及。");
    g_tipLine[20173] = StringToText("· 与一群玩家建立信任圈会对你很有帮助，因为如果你能存活到游戏后期，你可以帮助验证或否认其他玩家宣称的角色。");
    g_tipLine[20174] = StringToText("  你可以通过宣称另一名邪恶玩家伪装的角色在场来支持他的伪装，也可以通过暗示一名玩家宣称的角色从未被告知你来让其");
    g_tipLine[20175] = StringToText("  角色可信度蒙上阴影。");
    g_tipLine[20176] = StringToText("· 如果你是一个爪牙，直率地作为国王现身，因为此时多数玩家会认为你要么是国王要么是恶魔。如果国王在场，");
    g_tipLine[20177] = StringToText("  这个行为将使他们更受到怀疑，削弱他们已获得信息的效力——纵使这也同时出卖了你自己。这是一个让你自己和真国王一");
    g_tipLine[20178] = StringToText("  起被处决，从而消除他们带给恶魔的困扰的好方法。");
    g_tipLine[20179] = StringToText("· 如果你能存活到游戏末期，利用你的假信息制造强有力的角色揭露。确认一个邪恶玩家的伪装。在实际并非如此的情况下表");
    g_tipLine[20180] = StringToText("  明一个特定爪牙或特定恶魔在场。只是要小心确保你的信息与至今为止的游戏情况一致。");
    g_tipLine[20181] = StringToText("· 因为唱诗男孩只有在国王在场时才可能在场，如果恶魔知道国王不在场，他们也就知道唱诗男孩不在场。");
    g_tipLine[20182] = StringToText("  这可以是你除了游戏开始时获得的伪装之外的两个额外伪装（你可以将他们留给你的爪牙）。");
    g_tipLine[20183] = StringToText("此条目仍在构建。更多关于国王的提示与技巧及伪装国王的策略即将到来！");
    g_tipLine[20184] = StringToText("【伪装成村夫】");
    g_tipLine[20185] = StringToText("· 如果你发现了一对村夫，伪装成第三个村夫。将醉酒村夫的信息说成是正确信息，以此混淆视听。");
    g_tipLine[20186] = StringToText("· 如果你发现了一对村夫，伪装成第三个村夫。确认清醒村夫的信息是正确信息，以此获得大家的信任，");
    g_tipLine[20187] = StringToText("  甚至不惜把你的邪恶同伴推出去，然后在后续游戏中利用大家对你的信任。");
    g_tipLine[20188] = StringToText("· 如果你得到了村夫作为伪装，思考是否想要让多名邪恶玩家一同声称自己是村夫。单独的村夫固然容易引起怀疑，");
    g_tipLine[20189] = StringToText("  但多名邪恶玩家声称自己是村夫会让你们之间的关系绑定在一起，一同成为潜在的怀疑对象。如果善良阵营没有处决村夫的");
    g_tipLine[20190] = StringToText("  打算，那么就让恶魔来伪装成村夫吧。");
    g_tipLine[20191] = StringToText("· 作为恶魔，即使你的伪装里没有村夫，你仍然可以安全地伪装成村夫。只是如果已经有三名玩家声称自己是村夫了，");
    g_tipLine[20192] = StringToText("  那么你得迅速准备好你的备用计划。");
    g_tipLine[20193] = StringToText("· 暂时以村夫作为你的角色宣称，直到你想要暴露你实际想要伪装的角色为止。这是个很好的掩护，");
    g_tipLine[20194] = StringToText("  你可以在不暴露你真实想法的情况下传递你的“真实”信息。");
    g_tipLine[20195] = StringToText("· 如果你从恶魔那里得知村夫在他的伪装角色中，请留意那些假装成村夫的善良玩家。他们实际上可能是非常强力的镇民，");
    g_tipLine[20196] = StringToText("  又或者是带有极端负面效果的外来者，例如落难少女或异端分子。");
    g_tipLine[20197] = StringToText("【伪装成异教领袖】");
    g_tipLine[20198] = StringToText("· 当你伪装成异教领袖时，要牢记一件关键的事——你希望大家对你和你的虚假异教投入大量的关注，");
    g_tipLine[20199] = StringToText("  但你绝不希望他们在异教胜利这件事上达成共识。你并非真正的异教领袖！如果你有支持者，你会想做点什么？");
    g_tipLine[20200] = StringToText("  如果他们都同意加入你的教派但却什么事都没有发生，大家显然会注意到有问题。所以确保一定要有人永远不举手。");
    g_tipLine[20201] = StringToText("  如果他是一名看起来像是善良玩家的邪恶盟友就更好了！");
    g_tipLine[20202] = StringToText("· 伪装成异教领袖会有许多欢乐之处！由于你阵营变换的角色性质，大家会很自然的不信任你，让你在某几天中更露骨的展现");
    g_tipLine[20203] = StringToText("  自己的“邪恶”。");
    g_tipLine[20204] = StringToText("· 如果小镇上有人威胁要处决你，只需要宣称你“目前”是邪恶阵营，警告他们如果他们现在就让你出局，");
    g_tipLine[20205] = StringToText("  你就会保持在邪恶阵营！如果他们转而（处决）你的一位无辜邻座以试图“转变你到善良阵营”的话就更好了。");
    g_tipLine[20206] = StringToText("· 异教领袖是一个很可能存活到游戏结束的角色，因为恶魔们会很希望其转变为邪恶并存活。这意味着这是一个能帮助你存活");
    g_tipLine[20207] = StringToText("  的强力伪装。但是要小心地对小镇对待邪恶阵营的异教领袖的态度变化保持了解——在某个时机，");
    g_tipLine[20208] = StringToText("  他们可能会决定止损而处决你，仅仅只是因为你有微小的概率是伪装的异教领袖（坦白来说你确实是）。");
    g_tipLine[20209] = StringToText("· 当你伪装成异教领袖时，试着每天都发起（异教领袖）投票，如果能让其他邪恶玩家与你一起投票就更好。");
    g_tipLine[20210] = StringToText("  突然地让许多玩家参与教派仪式可以猝不及防地干扰善良玩家，让他们以为其他玩家知道一些他们自己不知道的——如果你");
    g_tipLine[20211] = StringToText("  的时机恰当，你甚至可以因玩家的一时激动影响他们（的判断）。这不仅可以制造许多噪音和干扰来分散善良阵营寻找恶魔");
    g_tipLine[20212] = StringToText("  的注意力，而且能够让你利用入教投票来质疑那些不想加入教派的玩家！");
    g_tipLine[20213] = StringToText("· 或者，如果你已经成功地招募了镇上的大多数人加入了你的教派，试着让你的邪恶盟友不要加入教派投票；");
    g_tipLine[20214] = StringToText("  当你的能力“未能成功”时，他们就会看起来像一名怀着拒绝态度的善良玩家。");
    g_tipLine[20215] = StringToText("· 如果你的邻座中有你的同伙，那在整场游戏中都坚称自己是善良的。或者，如果一名邪恶玩家成为了你的邻座，");
    g_tipLine[20216] = StringToText("  宣称你曾是邪恶阵营但现在转变为善良阵营，这能制造对死者的怀疑，同时支持你的盟友。");
    g_tipLine[20217] = StringToText("· 当伪装成异教领袖时，你可以表现得邪恶，这会让你的邻座显得有问题并且也许（大家）因此会将注意力从你身上移走。");
    g_tipLine[20218] = StringToText("  玩家更愿意处决一名邪恶并且始终邪恶的玩家而不是一名也许能转变为善良的玩家。这能让你在面对共情者或者女裁缝发现");
    g_tipLine[20219] = StringToText("  你是邪恶阵营的情况下提供解释理由和掩护。");
    g_tipLine[20220] = StringToText("· 如果大家咬咬牙处决了你，让他们知道你现在是邪恶阵营——你的实际阵营可能藉由神谕者的检查而证明，");
    g_tipLine[20221] = StringToText("  这意味着善良阵营将会担心在接下来的游戏中会有一张假想的额外邪恶阵营票。（但要提防送葬者或是筑梦师，");
    g_tipLine[20222] = StringToText("  他们能非常迅速地揭露你）");
    g_tipLine[20223] = StringToText("【伪装成半兽人】");
    g_tipLine[20224] = StringToText("· 作为邪恶阵营，你可以简单地杀死任何你希望杀死的人并将其归因于你们之中那位伪装成半兽人的玩家。");
    g_tipLine[20225] = StringToText("· 作为恶魔（或者是与恶魔协作击杀的爪牙）伪装成半兽人时，你可以考虑杀死一个你的爪牙来使得他们的伪装看起来更正当，");
    g_tipLine[20226] = StringToText("  因为如果他们是善良的，他们将只会死在半兽人的能力之下。");
    g_tipLine[20227] = StringToText("· 或者，杀死一名善良玩家并宣称你选择了另一名不同的善良玩家，使得你宣称选择的玩家看起来显得非常邪恶。");
    g_tipLine[20228] = StringToText("· 如果剧本之中有一个邪恶角色能导致中毒或醉酒，你可以抱怨你试图进行的杀戮都未能生效，并将一名你与之交谈过的善良");
    g_tipLine[20229] = StringToText("  玩家诬陷为那个让你中毒并阻止你能力生效的潜在爪牙或恶魔。");
    g_tipLine[20230] = StringToText("· 某些半兽人玩家会在第一天就告诉所有玩家他们是半兽人，并寻求团队关于他们每晚应当攻击谁的建议。");
    g_tipLine[20231] = StringToText("  作为爪牙伪装成半兽人来如此做是有风险的，因为善良玩家可能会建议你攻击恶魔玩家。作为恶魔伪装成半兽人来如此做会");
    g_tipLine[20232] = StringToText("  更安全，因为善良阵营几乎不会建议你攻击你自己。不管怎样，在早期作为半兽人现身并每天定期分享信息是一种比较困难");
    g_tipLine[20233] = StringToText("  的伪装。就好像伪装成占卜师或是博学者一样，需要为情况变复杂做好准备。");
    g_tipLine[20234] = StringToText("· 如果你在游戏后期一股脑地将半兽人信息全部告诉团队，但是一夜过去之后你却没有死亡，他们也许会要求处决你，");
    g_tipLine[20235] = StringToText("  因为恶魔很可能会选择在第一时间杀死一个可信的半兽人。准备一个成熟的理由来解释为什么你没有在攻击一名邪恶玩家的");
    g_tipLine[20236] = StringToText("  那晚死去。你不需要每晚都寻找理由，只需要在你宣称攻击的玩家没有死亡的那晚提供理由。");
    g_tipLine[20237] = StringToText("· 述说一名玩家是善良的比述说他是邪恶的要更安全。如果你说一名善良玩家是善良的，他们不会反对。");
    g_tipLine[20238] = StringToText("  如果你说一名邪恶玩家是善良的，他们也不会反对。如果你说一名善良玩家是邪恶的，他们会反对，");
    g_tipLine[20239] = StringToText("  他们会知道要么你在撒谎，要么你醉酒或中毒了。如果你说一名邪恶玩家是邪恶的，要么他们反对（从而让你看起来邪恶），");
    g_tipLine[20240] = StringToText("  要么他们附和来让他们看起来邪恶——这给了善良阵营关于邪恶玩家是谁的信息。告诉团队某名特定的玩家是善良的会更安");
    g_tipLine[20241] = StringToText("  全也会带来更少的问题，但是你迟早要告诉团队某名特定玩家是邪恶的，否则等于你宣称你在晚上杀死的所有玩家都是善良");
    g_tipLine[20242] = StringToText("  的，这是不可能的。仔细选择你要宣称是邪恶的玩家，并提出一个合理的理由来解释其原因。除非你是一个爪牙并且寻求处");
    g_tipLine[20243] = StringToText("  决。");
    g_tipLine[20244] = StringToText("【伪装成唱诗男孩】");
    g_tipLine[20245] = StringToText("· 恶魔玩家会从游戏开始就知道国王是否在场，如果这局游戏国王不在场，在伪装成唱诗男孩时，需要有另一位邪恶玩家伪装");
    g_tipLine[20246] = StringToText("  成国王来配合你。反过来，如果你的队友伪装成国王，你可以让一些玩家知道你是唱诗男孩来支持他们的伪装。");
    g_tipLine[20247] = StringToText("· 如果国王在场，伪装成唱诗男孩去接近国王。这可以帮助你发现真正的唱诗男孩是否在场，这对恶魔玩家是一个非常有用的");
    g_tipLine[20248] = StringToText("  信息。如果国王没有透露有人与你对峙（也宣称自己是唱诗男孩），杀死他们就很安全，甚至你可以之后抛出一个假冒的恶");
    g_tipLine[20249] = StringToText("  魔。如果有人对峙，你的操作有助于污蔑真正的唱诗男孩，让玩家怀疑他们的信息。");
    g_tipLine[20250] = StringToText("· 伪装成唱诗男孩会在国王（无论真假）死于恶魔之手后面临危机，因为此时，大家会期待你指认恶魔，");
    g_tipLine[20251] = StringToText("  而那名玩家被处决后游戏没有立即结束的话，你的伪装就会被打破。只有当剧本中有红唇女郎这样的爪牙时，");
    g_tipLine[20252] = StringToText("  你才可能平安。");
    g_tipLine[20253] = StringToText("· 如果有其他夜晚导致死亡的手段，比如刺客或是半兽人，你可以宣称国王（无论真假）在夜晚死亡而你没有获得信息，");
    g_tipLine[20254] = StringToText("  因为国王是死于非恶魔之手。这在没有额外死亡（如刺客）时会更显棘手。");
    g_tipLine[20255] = StringToText("· 在和唱诗男孩对峙时要当心。如果在真正的唱诗男孩还存活的情况下杀死国王，你就不得不污蔑一名玩家是恶魔。");
    g_tipLine[20256] = StringToText("  如果这种情况发生得过早，处决真正的恶魔将只是时间问题，因为恶魔的范围已经缩小到了两人之一。");
    g_tipLine[20257] = StringToText("【伪装成解谜大师】");
    g_tipLine[20258] = StringToText("· 解谜大师将一名醉酒玩家带入了善良阵营，一个无法被类似图书管理员这样的角色探查到的醉酒玩家。当伪装成此角色时，");
    g_tipLine[20259] = StringToText("  尽早作为解谜大师现身意味着只要他们相信你可能是，他们就必须担心一些他们的信息是错误的。");
    g_tipLine[20260] = StringToText("  最好是那些会将你的恶魔描绘成邪恶的信息！");
    g_tipLine[20261] = StringToText("· 解谜大师的闪亮时刻是他们进行猜测并有机会得知恶魔的时候。了解这点之后，在恰当时机进行突如其来的透露可能会让善");
    g_tipLine[20262] = StringToText("  良阵营陷入混乱，尤其是如果你能够用你的力量将一名之前广受信任的玩家描绘成醉酒！等待你的机会，");
    g_tipLine[20263] = StringToText("  然后在那个你得知潜在恶魔是谁会导致最大混乱的时机发起冲击。");
    g_tipLine[20264] = StringToText("· 善良阵营会花费大量精力与你一起寻找醉酒玩家——将之作为让你赢得互信团队好感的手段，并且确保他们花费大量时间在");
    g_tipLine[20265] = StringToText("  你和你的能力上担忧，而更少地担忧你的邪恶伙伴。");
    g_tipLine[20266] = StringToText("· 如果你想确保一次不受阻碍的处决，只需要选择小镇上任意一名能被相信是醉酒的玩家，然后随意选一名玩家作为恶魔就可");
    g_tipLine[20267] = StringToText("  以。处决任何一名你得知的玩家对小镇都有好处（因为以防万一！），所以你可以用这个方法来干掉一个烦人的镇长或水手！");
    g_tipLine[20268] = StringToText("  ");
    g_tipLine[20269] = StringToText("· 另一种方案是选择小镇上被认为有正确信息的玩家（甚至你自己！），这样你就（应当）能得知错误的信息。");
    g_tipLine[20270] = StringToText("  然后指向真正的恶魔！如果小镇上的人倾向于处决，这个方法风险很高，但是如果他们没有太多时间杀人，");
    g_tipLine[20271] = StringToText("  他们可能会倾向于将一名“确认并非恶魔”的玩家留住以进入最终三人的行列中！（为了最大限度提高你成功的几率，");
    g_tipLine[20272] = StringToText("  秘密地交流这些信息让恶魔有一个很好的理由存活到最后一天！）");
    g_tipLine[20273] = StringToText("· 一个精妙的双人伪装是一名邪恶玩家将自己设定为获得显然错误信息或者能力未能生效的角色……而你则浮夸地作为解谜大");
    g_tipLine[20274] = StringToText("  师揭露自己，称他醉酒了。你需要很好地把握住时机，因为一旦他们按你的说法处决了某人，游戏不会结束，");
    g_tipLine[20275] = StringToText("  但是如果他们相信了你，这将是一个毁灭性的连续拳伪装！（额外的好处：你可以用这个方法来解救一个被抓到说谎而在挣");
    g_tipLine[20276] = StringToText("  扎的同伴！）");
    g_tipLine[20277] = StringToText("· 解谜大师能极大地分散注意力，因此是一个特别理想的爪牙伪装。如果一切顺利，你会浪费善良阵营的时间，");
    g_tipLine[20278] = StringToText("  处决一些无辜的人，同时保护到你的恶魔！");
    g_tipLine[20279] = StringToText("· 如果你说谎被抓到，并且有被揭露是邪恶阵营的危险，那么解谜大师会是一个极好的备用伪装！对解谜大师而言，");
    g_tipLine[20280] = StringToText("  撒谎并隐藏一段时间是有好处的，所以你有很好的理由来证明你几分钟前的不合理之处。");
    g_tipLine[20281] = StringToText("· 如果你怀疑解谜大师在场并且担心他们会发现你的恶魔，可以故意伪装成一名信息有问题的玩家！");
    g_tipLine[20282] = StringToText("  如果你能诱使解谜大师选择你，小镇上的人不仅会倾向于相信你是善良的，还会无法得知恶魔是谁。");
    g_tipLine[20283] = StringToText("【伪装成狂热者】");
    g_tipLine[20284] = StringToText("· 投票！！！！！！！！！！！");
    g_tipLine[20285] = StringToText("· 如果剧本中有狂热者这个角色，要非常仔细地观察善良玩家的投票，来判断狂热者是否在场。如果某个善良玩家对所有提名");
    g_tipLine[20286] = StringToText("  都投票，他可能就是狂热者，这样你大概就知道一个外来者的位置。如果没有善良玩家对每次提名都投票，");
    g_tipLine[20287] = StringToText("  那么狂热者可能不在游戏中，这就成为爪牙的一个绝佳伪装。");
    g_tipLine[20288] = StringToText("【伪装成修行者】");
    g_tipLine[20289] = StringToText("· 用你的信息指向一名邻近玩家，让他看起来是邪恶的，并让他被处决。显然，这样做的主要好处是能让一名善良玩家被处决！");
    g_tipLine[20290] = StringToText("  并且，如果实际上有一名邪恶玩家位于你的信息的另一个方向，还会附带一个好处就是让那名邪恶玩家看起来是善良的，");
    g_tipLine[20291] = StringToText("  正如同人们相信因你的信息被处决的善良玩家是邪恶的，你的信息同时会强烈暗示坐在另一边的玩家是善良的。");
    g_tipLine[20292] = StringToText("  不过你要小心处理这个逻辑，因为你不会想让玩家们开始怀疑你的信息并认为其实与你距离相同的两名玩家都是邪恶的。");
    g_tipLine[20293] = StringToText("· 用你的信息让一名邻近玩家看起来是善良的，并与其建立信任。如果你发现你的邻近玩家得知了错误信息或误读自己的信息，");
    g_tipLine[20294] = StringToText("  进而因此怀疑你的另一个方向上的邻近玩家，那么你编造那个方向上有邪恶玩家的信息会加强他的怀疑——这会让你的信息");
    g_tipLine[20295] = StringToText("  看起来与他的信息互补，对他有益，并激发那名玩家和场上其他玩家对你的更多信任。");
    g_tipLine[20296] = StringToText("· 不要去假设存在与你距离相等的邪恶玩家——如果你假设你的信息是正确的，由于你给出了一个明确的方向，");
    g_tipLine[20297] = StringToText("  你将更有可能推动善良玩家帮助你。如果你假设有一对与你距离相等的邪恶玩家，你的信息会变得更模糊，");
    g_tipLine[20298] = StringToText("  更难推动善良玩家投票。");
    g_tipLine[20299] = StringToText("· 如果你希望让你看起来是善良的，但又不想做得太明显，你可以假设存在与你距离相等的邪恶玩家。");
    g_tipLine[20300] = StringToText("  对于想要逃避玩家侦查的恶魔来说，这种做法很棒——你可以看起来像是在游戏中花费了非常多时间去试图认真理解你自己");
    g_tipLine[20301] = StringToText("  的信息，但并不想让善良玩家意外被处决，所以你可以在没有引起其他玩家太多关注的时候，由你自己的信息扩展出来的逻");
    g_tipLine[20302] = StringToText("  辑，投放一些轻微的怀疑在那些成双成对的玩家身上。毕竟，如果场上有成对的玩家相互信任，这很好，");
    g_tipLine[20303] = StringToText("  这只能意味着他们必须是与你距离不同的玩家，否则他们可能是成对的邪恶玩家，对吧？");
    g_tipLine[20304] = StringToText("· 始终记住，如果你因为你的信息看起来不准确而开始被怀疑，你可以依靠存在与你距离相等的邪恶玩家这个逻辑。毕竟，");
    g_tipLine[20305] = StringToText("  这个逻辑会让你得知随机信息，这并不是你的错，而可能是场上确实有一对邪恶玩家相互协作让对方看起来是善良的，");
    g_tipLine[20306] = StringToText("  并导致你的信息显得可疑。");
    g_tipLine[20307] = StringToText("【伪装成帽匠】");
    g_tipLine[20308] = StringToText("· 你不想死亡！善良团队将会非常谨慎地对待是否杀死帽匠的问题，利用这个逻辑会让你的存活时间比利用其他方式更长。");
    g_tipLine[20309] = StringToText("  如果你能通过在你死后可能发生的事情来持续渲染人们对这些事情的恐惧，你甚至能以帽匠的伪装进入三人决赛圈和最终决");
    g_tipLine[20310] = StringToText("  赛。");
    g_tipLine[20311] = StringToText("· 如果你死亡，看看你的邪恶同伴们能否伪装出爪牙或恶魔角色改变的迹象来支持你的伪装。这取决于剧本上有哪些邪恶角色。");
    g_tipLine[20312] = StringToText("  这个做法的好处远不止是把你认成好人，还能够让善良团队陷入一个无尽的猜疑链，他们会围绕着那些没有在场并且从未登");
    g_tipLine[20313] = StringToText("  场的恶魔角色展开推理。");
    g_tipLine[20314] = StringToText("· 通常来说帽匠会胡言乱语！他会声称自己是其他角色，尝试着隐藏自己，尽可能长久地存活，这样邪恶团队就无法在最需要");
    g_tipLine[20315] = StringToText("  的时候利用帽匠改变角色。如果你最初的伪装露了马脚，或者这个伪装没有让你有充分理由逃避处决，");
    g_tipLine[20316] = StringToText("  那么帽匠对你来说是个很好的备用伪装。");
    g_tipLine[20317] = StringToText("· 尝试分析你死后场上发生了什么变化来体现你真诚的努力，并以此获取别人的信任。你可能会成为善良团队逻辑链分崩离析");
    g_tipLine[20318] = StringToText("  的关键，因为你持续地输出各种各样爪牙与恶魔角色组合的理论来分散好人们的注意力，并且针对场上出现的任何情况都利");
    g_tipLine[20319] = StringToText("  用这些理论尽可能地扩展出更多合理解释，远远地超出引起这些情况的真实原因。");
    g_tipLine[20320] = StringToText("· 如果你是伪装成帽匠的恶魔，你可以尝试着让游戏看起来是一些较弱的爪牙/恶魔在场。这会增加因你的死亡而造成的威胁，");
    g_tipLine[20321] = StringToText("  因为邪恶团队能够因此选择最强阵容，这对于任何善良团队来说都是非常可怕的，然后你有可能从头到尾存活下来。然而，");
    g_tipLine[20322] = StringToText("  你需要准备好充分的理由去解释为什么邪恶团队一直都没有找机会杀死你。因此，当你被剩余的存活玩家压榨自己的角色范");
    g_tipLine[20323] = StringToText("  围时，最好的方法可能是公开声明自己是其他角色，并且私下告诉那些死亡的善良玩家，自己是帽匠，");
    g_tipLine[20324] = StringToText("  以此获得他们的支持来保你的命。");
    g_tipLine[20325] = StringToText("【伪装成骑士】");
    g_tipLine[20326] = StringToText("· 在你的骑士信息里声称恶魔玩家是其中之一。这很明显，也很直接，但很有效——清除恶魔玩家的恶魔嫌疑可以让你们获胜。");
    g_tipLine[20327] = StringToText("  ");
    g_tipLine[20328] = StringToText("· 将两名善良玩家作为你的骑士信息声明出来。这两名善良玩家都知道自己不是恶魔，所以至少对于他们而言，");
    g_tipLine[20329] = StringToText("  他们会倾向于相信你的信息是正确的，因此他们会更倾向于信任你。");
    g_tipLine[20330] = StringToText("· 将两名善良玩家作为你的骑士信息声明出来，然后在剩下的时间里努力设法让自己看起来是爪牙玩家——这种做法将会陷害");
    g_tipLine[20331] = StringToText("  那两名善良玩家成为潜在的恶魔候选人，他们正在被一名疑似爪牙的玩家“清除”恶魔嫌疑。");
    g_tipLine[20332] = StringToText("· 将一名善良玩家和一名邪恶玩家作为你的骑士信息声明出来，以便在这些玩家之间建立信任。从而提供了一个信任你们的善");
    g_tipLine[20333] = StringToText("  良玩家为你们做担保，让你的邪恶队友以此为基点开始散播错误信息。");
    g_tipLine[20334] = StringToText("· 就像一个真正的骑士可能会做的那样，直到游戏后期才公开你的“骑士信息”，从而让游戏的逻辑线路脱离正轨。");
    g_tipLine[20335] = StringToText("· 骑士是一个很棒的备用伪装——如果恶魔被提名并且可能会获得足够票数被处决，你可以放弃你之前伪装的角色，");
    g_tipLine[20336] = StringToText("  以骑士的角色出现并大声明确地告诉所有人，这名恶魔玩家不是恶魔。");
    g_tipLine[20337] = StringToText("· 骑士对于善良玩家来说也是非常棒的初始伪装——声称自己是骑士并随机挑选两名玩家。这将帮助你隐藏你的真实角色，");
    g_tipLine[20338] = StringToText("  还有个额外的好处，就是你可能可以存活一段时间，直到游戏中后期才会受到许多质疑。即使你不小心将恶魔玩家列为两名");
    g_tipLine[20339] = StringToText("  非恶魔玩家之一，只要你在游戏后期放弃这个声明，通常也不会对善良阵营造成太大伤害。");
    g_tipLine[20340] = StringToText("· 如果你是伪装成骑士的恶魔，杀死你的骑士信息里声称的两名玩家。这会让你看起来是善良玩家，");
    g_tipLine[20341] = StringToText("  因为“恶魔相信你就是骑士，并且杀死了他们无法接受能够存活到决赛日的那些玩家。”");
    g_tipLine[20342] = StringToText("· 仔细思考暴露自己是骑士的时机，以及暴露你作为骑士应该得知的那些信息的时机——你不需要同时暴露自己的骑士角色和");
    g_tipLine[20343] = StringToText("  骑士信息，不同的暴露时机会对游戏有不同影响。尽早声称你自己是骑士可以让你获得一点社交信任，");
    g_tipLine[20344] = StringToText("  但你可以坚持不提供任何实质性的信息，直到游戏差不多快结束时，再提供能够最大程度帮助你的阵营获胜的信息。");
    g_tipLine[20345] = StringToText("【伪装成女祭司】");
    g_tipLine[20346] = StringToText("· 声称自己得知了善良玩家，然后从一开始就支持他们的观点和信息。你在强化善良玩家信息的同时有可能会对你的阵营造成");
    g_tipLine[20347] = StringToText("  伤害，但你也因此收获了善良玩家对自己的大量信任，这有可能会带来回报。");
    g_tipLine[20348] = StringToText("· 相反地，声称自己得知了一名善良玩家，但你与他的对话非常糟糕，因此你怀疑你得知的是一名还没有得到伪装或是发言不");
    g_tipLine[20349] = StringToText("  好的爪牙玩家");
    g_tipLine[20350] = StringToText("· 声称得知了你的邪恶队友。这样你可以有一个很好的理由在首个白天与队友交谈，与他分享伪装及其他信息，");
    g_tipLine[20351] = StringToText("  并且开始计划如何进行游戏。你们只需要确保不管你的队友最后说了什么，都能有充分的理由说明为什么他会在首个夜晚被");
    g_tipLine[20352] = StringToText("  你得知。");
    g_tipLine[20353] = StringToText("· 随意选择大概数量的你“得知”的玩家，并且在事后编造得知这些玩家的原因。但你在首夜的“信息”会是风险最高的选择");
    g_tipLine[20354] = StringToText("  ——在还没有受到游戏展开方式或人们思考内容影响的情况下，首个夜晚女祭司得知的玩家，他的角色有可能是说书人最强");
    g_tipLine[20355] = StringToText("  烈推荐让大家知道的。所以你需要有充分理由去说明。");
    g_tipLine[20356] = StringToText("· 始终准备一个备用方案，以防你需要与你“得知”的玩家对抗——如果他的信息过于强大，或是他已经将太多玩家划为值得");
    g_tipLine[20357] = StringToText("  信任的好人，也许你需要让大家开始怀疑，说书人让你得知这名玩家实际上是为了揭穿他的伪装，或者实际上他是酒鬼，");
    g_tipLine[20358] = StringToText("  而说书人向你展示这名玩家是为了鼓励你们发现这个问题。");
    g_tipLine[20359] = StringToText("· 倾听对于伪装成女祭司来说是非常棒的游戏方式——你希望玩家向你提出一个可能是他会被你得知的原因，");
    g_tipLine[20360] = StringToText("  如果他提出的原因并不正确，你可以鼓励他往错误的方向继续思考，从而误导他的游戏策略。");
    g_tipLine[20361] = StringToText("· 在玩家们公开自己的角色之后，你再去接触他们，从而让你可以做出明智的选择。因为你不想在游戏中期就被玩家发现自己");
    g_tipLine[20362] = StringToText("  是伪装，当他们回顾你在游戏早期的信息时，会质疑你为什么会在游戏开始的两个夜晚得知守鸦人和管家，");
    g_tipLine[20363] = StringToText("  说书人并没有充分理由鼓励女祭司与这些角色交谈。");
    g_tipLine[20364] = StringToText("· 相比伪装成其他角色，伪装成女祭司更容易显得真实。你可以像真正的女祭司那样假装无知，在游戏中花费相当大一部分时");
    g_tipLine[20365] = StringToText("  间假装“不知道发生了什么”，这不仅让你看起来很像一名善良玩家那样在通常情况下都会感到迷惑，");
    g_tipLine[20366] = StringToText("  也能鼓励其他善良玩家试图帮助你找出你的信息与游戏局势的关联性，但这需要他们接受你的观点！");
    g_tipLine[20367] = StringToText("· 对于邪恶玩家来说，女祭司是非常棒的伪装，可以让他们非常方便地扮演成另外一个角色。但对于善良玩家来说，");
    g_tipLine[20368] = StringToText("  女祭司同样是很棒的伪装，它让你具有非常有力的理由去找你需要进行交谈的特定玩家，而不必明确说明你为什么这样做。");
    g_tipLine[20369] = StringToText("· 即使有玩家被大家一致认为很可能是邪恶的，特别是在他们死于处决之后，如果你去声称他们曾是你得知的玩家，");
    g_tipLine[20370] = StringToText("  这会是一种很好的方式让玩家们的共识偏离正轨。");
    g_tipLine[20371] = StringToText("【伪装成守夜人】");
    g_tipLine[20372] = StringToText("· 守夜人是个很难伪装的角色，这主要是因为这个伪装需要两名邪恶玩家配合默契。和洗衣妇或是图书管理员不同，");
    g_tipLine[20373] = StringToText("  你不能简单地宣称自己是这个角色，提供你关于你邪恶盟友的角色信息，并且期待他们的配合。守夜人的机制相反。");
    g_tipLine[20374] = StringToText("  他们需要宣称他们知道你的角色。这通常意味着你们两人需要在事前为此计划进行一些筹谋。");
    g_tipLine[20375] = StringToText("· 宣称是守夜人的最简单方法是当一名邪恶玩家宣称你是守夜人时附和他们，而不是由你主动。真正的守夜人通常会等到使用");
    g_tipLine[20376] = StringToText("  了自己的能力之后才会向团队宣称自己的角色。");
    g_tipLine[20377] = StringToText("· 如果你宣称自己是已经选择了玩家的守夜人，而这名玩家是善良的，他们就会知道你是邪恶的。说出“我一定是醉酒或中毒");
    g_tipLine[20378] = StringToText("  了”可能会被理解为一个仓促的解释。做好对决的准备，这名玩家知道你是邪恶的，但团队其他人只会知道你们其中的一人");
    g_tipLine[20379] = StringToText("  是邪恶的。");
    g_tipLine[20380] = StringToText("· 准备一个充分成熟的理由来说明你为何在游戏的早期或晚期使用了你的能力，以及你为何在这名玩家身上使用能力。");
    g_tipLine[20381] = StringToText("【伪装成报丧女妖】");
    g_tipLine[20382] = StringToText("· 如果你在夜晚死亡，你的伪装就会被拆穿！请确保恶魔清楚不要在夜晚杀死你这件事。");
    g_tipLine[20383] = StringToText("· 先伪装成其他角色，然后在被其他玩家压榨时宣称自己是报丧女妖。这也是大多数报丧女妖会做的事情。");
    g_tipLine[20384] = StringToText("· 早早宣称自己是报丧女妖，并对邪恶阵营示威。这不会让你屡试不爽，但如果从社交心理学来解读的话，");
    g_tipLine[20385] = StringToText("  邪恶阵营可能会为了避免你的能力得到佐证而不去杀死你，这是完全说得通的。");
    g_tipLine[20386] = StringToText("· 宣称自己是报丧女妖，然后与一两名善良玩家绑定，并在夜晚被杀死。你的角色无法得到证实，因为你不是报丧女妖，");
    g_tipLine[20387] = StringToText("  但由此产生的怀疑会把跟你绑定的善良玩家一起拖下水。");
    g_tipLine[20388] = StringToText("· 确保你清楚剧本中存在哪些原因导致你的能力无法被触发，并做好不得不在晚上死亡并创造这种假说的情况。");
    g_tipLine[20389] = StringToText("  善良玩家也许也会出现这种情况，所以这不太可疑，但你必须构建出一套合理的说辞，否则你可能就会在接下来的时间里坐");
    g_tipLine[20390] = StringToText("  牢！");
    g_tipLine[20391] = StringToText("【伪装成魔术师】");
    g_tipLine[20392] = StringToText("· 如果你是一个邪恶角色且正在伪装需要伪装成邪恶的角色，那你正在面临一项非常艰巨的任务。真正的魔术师不会在游戏早");
    g_tipLine[20393] = StringToText("  期说他们是魔术师，所以要么先伪装成另一个角色，要么先对是魔术师的情况保持沉默一段时间。");
    g_tipLine[20394] = StringToText("  你需要在某种程度上先隐遁至少一两天。");
    g_tipLine[20395] = StringToText("· 伪装成魔术师所需要进行的最大决定是选择何时及如何作为魔术师现身。只在被提名时才告诉每个人你是魔术师可能有效，");
    g_tipLine[20396] = StringToText("  但也有风险。在一些诡异事件之后告诉大家你是魔术师——比如一名不受信任的玩家在夜晚死亡，");
    g_tipLine[20397] = StringToText("  或是所有玩家都投票给一名值得信任的玩家，或另一名玩家提供了全新的信息——是一个好时机。");
    g_tipLine[20398] = StringToText("  如果你能编造一个故事来说明为什么当下是你作为魔术师现身的最好时机，并且将这个诡异事件融入其中，就会很合理。");
    g_tipLine[20399] = StringToText("· 在游戏的最后作为魔术师现身。你的理由可以是“邪恶阵营很可能现在已经知道我是魔术师了”。");
    g_tipLine[20400] = StringToText("· 故意伪装成某个特定角色，故意让你的信息看起来可疑来让你看起来是邪恶的，然后作为魔术师现身，也是一种策略。");
    g_tipLine[20401] = StringToText("  保留魔术师伪装作为备用伪装是比较轻松的，它只是以防原本的伪装被揭穿，但即使如此，也仍要尽可能保持原本的伪装。");
    g_tipLine[20402] = StringToText("  甚至可以伪装成两到三个角色，看看其中有没有起效的，同时保留魔术师伪装作为可以使用的备用伪装。");
    g_tipLine[20403] = StringToText("  魔术师是很狡猾的。");
    g_tipLine[20404] = StringToText("· 假设你是一个爪牙并且你知道魔术师在场，如果你公开地伪装成魔术师，那么真正的魔术师也可能会现身。");
    g_tipLine[20405] = StringToText("  邪恶阵营知道哪名玩家是恶魔的重要性，能抵得过善良阵营处决一个爪牙和魔术师（以及魔术师知道你一定是邪恶的），");
    g_tipLine[20406] = StringToText("  你也许会想要试着如此做。");
    g_tipLine[20407] = StringToText("【伪装成瘟疫医生】");
    g_tipLine[20408] = StringToText("· 瘟疫医生基本上不会乐意去死——他清楚自己会对善良阵营取胜的概率产生重大负面影响。你可以利用这个逻辑让自己尽可");
    g_tipLine[20409] = StringToText("  能长久地存活。瘟疫医生很像圣徒，它是少数几个几乎总是会为了生存下去而努力斗争的角色。因此你可以利用这个伪装来");
    g_tipLine[20410] = StringToText("  让你的爪牙尽可能长久地发挥作用，或是让恶魔生存到游戏结束。");
    g_tipLine[20411] = StringToText("· 如果可以的话，考虑将某个爪牙能力隐藏起来。这样在你死亡之后，看起来就像在游戏中添加了一个爪牙能力。");
    g_tipLine[20412] = StringToText("  这个战术可能比较难操作，取决于哪些爪牙能力是你们必须使用的。不过，当游戏中出现额外的爪牙能力来“证明”你是瘟");
    g_tipLine[20413] = StringToText("  疫医生时，确实可以帮助你获得善良玩家的信任并推动他们向着你的叙事方向前进。当然，这里面的平衡之处在于，");
    g_tipLine[20414] = StringToText("  这个战术意味着在你死亡之前的游戏时间里，爪牙使用能力的效率会下降许多，所以你可能希望考虑改为其他战术。");
    g_tipLine[20415] = StringToText("· 让你的存活邪恶队友在你死亡后声称自己受到“说书人的爪牙能力”影响来支持你的伪装。这意味着你们不必在你死亡之前");
    g_tipLine[20416] = StringToText("  隐藏某个爪牙能力，只需要让邪恶玩家们假装受到额外爪牙能力的影响。当然，这样做有个缺点，");
    g_tipLine[20417] = StringToText("  就是会让你和你的邪恶队友直接绑定起来，所以在说服善良玩家相信你的同时需要承担极大的压力！");
    g_tipLine[20418] = StringToText("· 围绕着摸清哪些爪牙能力在场来强调你的推理，因此“你能得知在你死后可能会添加哪个爪牙能力”。然而，");
    g_tipLine[20419] = StringToText("  通常来说这正是瘟疫医生关注的重点，但对你来说，给了你一个绝佳机会去误导其他人认为初始设置以及当前局势有哪些爪");
    g_tipLine[20420] = StringToText("  牙在场。");
    g_tipLine[20421] = StringToText("· 当然，你不是瘟疫医生，所以在你死后不会有爪牙能力加入游戏。为了应对这种情况，准备好在你死后改变你的声明，");
    g_tipLine[20422] = StringToText("  或是编造一个合理的故事来解释为什么你的能力没有生效。也许说书人获得的是被动能力？也许你错误判断了在场的爪牙能");
    g_tipLine[20423] = StringToText("  力，所以说书人实际上获得了意料之外的爪牙能力。也许有麻脸巫婆在你死前改变了爪牙角色，所以说书人获得了初始在场");
    g_tipLine[20424] = StringToText("  的爪牙能力。");
    g_tipLine[20425] = StringToText("【伪装成事务官】");
    g_tipLine[20426] = StringToText("· 事务官是这个游戏最简单的伪装之一，同时也是一个优秀的备用伪装。伪装成事务官，声称恶魔是你得知的玩家。");
    g_tipLine[20427] = StringToText("  如果玩家们信任你，那么恶魔看起来会是善良的，你的工作就完成了。");
    g_tipLine[20428] = StringToText("· 将一名善良玩家作为你的事务官信息声明出来，然后确保其他玩家使用自身能力来指向你是邪恶玩家！");
    g_tipLine[20429] = StringToText("  你会把那名玩家一起拖下水，但是直到善良阵营花费好几天时间才有机会发现你是邪恶的。所以在你被处决之前，");
    g_tipLine[20430] = StringToText("  你还能够有好几天的时间来使用你的爪牙能力。");
    g_tipLine[20431] = StringToText("· 将一名善良玩家作为你的事务官信息声明出来，并尝试与他们一起努力“通关”。如果你们能努力地作为一对合作搭档而被");
    g_tipLine[20432] = StringToText("  信任，你可以在没有受到太多嫌疑的情况下存活度过整局游戏。");
    g_tipLine[20433] = StringToText("【伪装成食人魔】");
    g_tipLine[20434] = StringToText("· 向你假装选择的任意玩家表示忠诚。向你的“朋友”表示忠诚。如果你选择了共情者，整局游戏都假装信任他的信息。");
    g_tipLine[20435] = StringToText("  如果你选择了圣徒，尽你所能去阻止善良阵营处决他。你永远不知道你的“朋友”会在何时被确证为好人。比方说，");
    g_tipLine[20436] = StringToText("  如果你选择了报丧女妖，而报丧女妖在夜晚时被恶魔杀死会触发能力自证，那么你会希望尽可能提前向他展示你的诚意并说");
    g_tipLine[20437] = StringToText("  服他。");
    g_tipLine[20438] = StringToText("· 选择强力的玩家。选择那些能让善良玩家们相信、倾听和服从的玩家。拥有一个强力可靠的玩家作为你的朋友，");
    g_tipLine[20439] = StringToText("  善良阵营可能也会给你一条活路。");
    g_tipLine[20440] = StringToText("· 你不需要马上说出自己选择了谁。有时候，等待几天再说出来会显得更可信。虽然当你等到能够与一名铁定是好人的玩家称");
    g_tipLine[20441] = StringToText("  兄道弟时再表露自己食人魔的身份，对部分玩家来说是不太可信的行为，但对于那些相信你的人来说，");
    g_tipLine[20442] = StringToText("  这反而让他们确信你就是善良的。");
    g_tipLine[20443] = StringToText("· 选择有趣的玩家！钟楼谜团这游戏不用太在意胜负。你在游戏中玩得越开心，作为食人魔这个角色的游戏表现会越好。");
    g_tipLine[20444] = StringToText("  因此去选择那些与你关系融洽的人，选择那些整局游戏都喜欢跟你玩的人吧，这也许能让你有信心去说服善良阵营，");
    g_tipLine[20445] = StringToText("  你就是食人魔。");
    g_tipLine[20446] = StringToText("· 选择那些你认为能活很久的角色作为假想朋友。像镇长或将军这样的角色往往更容易活到决赛日。");
    g_tipLine[20447] = StringToText("  无论伪装食人魔的玩家是善良的还是邪恶的，通常来说，为了符合善良阵营的利益，他们要么杀死你们两个，");
    g_tipLine[20448] = StringToText("  要么将你们都保留到决赛日。");
    g_tipLine[20449] = StringToText("· 如果其他方法都行不通，你可以选择那些你想让他死的玩家作为假想朋友。也许场上的送葬者或女祭司正在给大家制造麻烦？");
    g_tipLine[20450] = StringToText("  公开假装是他们可爱的食人魔朋友，然后故意玩得很烂。善良阵营也许会将你们都杀死，这将需要两天时间，");
    g_tipLine[20451] = StringToText("  并且会导致有两名其他玩家在夜晚死亡。这样，包括你的目标在内，会有四名玩家死亡。这种策略适用于镇民、");
    g_tipLine[20452] = StringToText("  外来者和爪牙，但不适合恶魔。");
    g_tipLine[20453] = StringToText("· 不要告诉任何人你的朋友是谁。在你内心确定一个朋友之后，像管家一样跟着他投票，但是到游戏后期再揭露你的朋友是谁。");
    g_tipLine[20454] = StringToText("  ");
    g_tipLine[20455] = StringToText("· 选择那些比较沉默的玩家。交朋友不仅仅是一个游戏术语。那些比较沉默的玩家往往希望在整局游戏中有一两名玩家可以信");
    g_tipLine[20456] = StringToText("  任，相对来说，那些比较活跃的玩家则希望与其他玩家有更多的对话和更复杂的关系网。与比较沉默的玩家交朋友可以让他");
    g_tipLine[20457] = StringToText("  们在整局游戏中都保护你。这有点狡猾。");
    g_tipLine[20458] = StringToText("· 等上几天，然后选择死亡玩家作为假想朋友。如果你能说服他盲目地使用自己死后的投票标记，游戏局势会变得对你们更有");
    g_tipLine[20459] = StringToText("  利。");
    g_tipLine[20460] = StringToText("· 选择那些无法应对食人魔的玩家。如果有玩家能让你全神贯注地进行整局游戏，并且追问你所得知的一切，");
    g_tipLine[20461] = StringToText("  这会让你很有压力！但这是积极的压力！有些人可能仅仅因为你的一个笑容就会放弃思考一小时，");
    g_tipLine[20462] = StringToText("  无法辨别你是善良还是邪恶的，这可能会很有趣，至少对你来说很有趣。");
    g_tipLine[20463] = StringToText("· 选择邪恶玩家作为假想朋友。这很冒险，即使善良玩家不知道你是哪个阵营，他们能够确信你们是同一阵营。");
    g_tipLine[20464] = StringToText("  但如果他们认为你们都是善良的，虚构的朋友关系可以引导善良阵营走进相互矛盾的逻辑分析之中。");
    g_tipLine[20465] = StringToText("  要确保你与你的邪恶朋友的虚假关系能够让玩家信服。");
    g_tipLine[20466] = StringToText("· 随机选择一名善良玩家作为假想朋友。因为邪恶玩家互相认识，所以很容易选中善良玩家。从概率上来说，");
    g_tipLine[20467] = StringToText("  这也是真正的食人魔通常会选中的目标。做这种理所当然的事能让你看起来可信，并且能在你与你的朋友之间形成信任。");
    g_tipLine[20468] = StringToText("· 听从你的朋友的判断。向你的朋友告知你从善良玩家那里得知的一切。因为真正的食人魔并不知道除了与自己朋友同一阵营");
    g_tipLine[20469] = StringToText("  以外的任何信息，所以他往往会听从朋友的判断。你要做出与真正的食人魔一样的事情。在游戏之中的某个时间点，");
    g_tipLine[20470] = StringToText("  你会想要通过任性的投票或巧妙的欺骗来背叛你的朋友。但是一旦发生这种情况，大家会知道你是邪恶的，");
    g_tipLine[20471] = StringToText("  所以等到游戏后期再这样做吧。");
    g_tipLine[20472] = StringToText("· 选择多名玩家，并分别告诉他们是你的假想朋友。但还要交代他们不要向其他人透露这件事。这种做法总会适得其反，");
    g_tipLine[20473] = StringToText("  但与此同时，这可以让多名玩家做出糟糕的投票决定。");
    g_tipLine[20474] = StringToText("· 如果你是邪恶的，而有善良玩家声称是你的食人魔朋友，你要谨慎地向他透露你是邪恶的事实。他可能是在伪装食人魔。");
    g_tipLine[20475] = StringToText("  让邪恶的食人魔相信你所说的一切会对你们非常有利，但如果是让伪装食人魔的善良玩家发现你是邪恶的，那就非常糟糕。");
    g_tipLine[20476] = StringToText("【伪装成戏法师】");
    g_tipLine[20477] = StringToText("· 伪装成戏法师很容易，因为通常善良玩家也会这么做！即使真的有戏法师在场，你也可以安全地伪装成戏法师，");
    g_tipLine[20478] = StringToText("  只要你还有其他后续的备用伪装计划。");
    g_tipLine[20479] = StringToText("· 认真对待你的猜测。对于你此前进行过的猜测，和此后将要做出的猜测多加思考。如果你缩小了邪恶阵营的范围，");
    g_tipLine[20480] = StringToText("  那么在最后一天的时候，你会发现你自己的推测出现前后矛盾。如果你是恶魔并且活到了最后一天，这一点就更加重要。");
    g_tipLine[20481] = StringToText("· 向其他人征求猜测的意见。向善良玩家征求意见，可以让你看起来更善良。向邪恶玩家征求意见，");
    g_tipLine[20482] = StringToText("  可以让他们看起来更善良。");
    g_tipLine[20483] = StringToText("· 避免猜测已被证实的善良玩家。如果善良阵营察觉到你企图给善良玩家泼脏水并且失败了，他们会倾向于怀疑你是邪恶的，");
    g_tipLine[20484] = StringToText("  这还能进一步坐实那些善良玩家的的确确是善良的。");
    g_tipLine[20485] = StringToText("· 找出那些能探查邪恶的善良玩家。争取赢得他们的信任，这样你就可以利用他们的信息来展开你的“猜测”。");
    g_tipLine[20486] = StringToText("  但要小心……如果他们转过来探查你，就会让你引火上身！");
    g_tipLine[20487] = StringToText("· 让你的猜测转移大家的注意力！让整个游戏围着你转！给你的猜测加点猛料和抓马！善良玩家越是关注你和你的猜测，");
    g_tipLine[20488] = StringToText("  他们就越会相信你是戏法师！");
    // 【对说书人的建议】（用户 2026-11-12）：无神论者第十节，仅说书人可见
    g_tipLine[20500] = StringToText("【对说书人的建议】");
    g_tipLine[20501] = StringToText("请注意：无神论者绝对是一个只有熟练玩家才能掌握的角色，更重要的是，只有熟练的说书人才能掌握的角色。");
    g_tipLine[20502] = StringToText("  需要极度谨慎地对待。");
    g_tipLine[20503] = StringToText("· 【所以…我怎样才能良好运作无神论者？】");
    g_tipLine[20504] = StringToText("这确实是个大问题。有很多方式可以良好运作无神论者。但最重要的是，要贯彻理念，而不是停留在具体策略层面上。");
    g_tipLine[20505] = StringToText("  你可以做任何事情，但什么应该做？这就是区别。");
    g_tipLine[20506] = StringToText("你的目的是创造有趣的对局。和往常一样，你的首要目标是促使他人感到快乐。当你做出决定的时候，始终牢记这样的问题：");
    g_tipLine[20507] = StringToText("  「这对玩家来说好玩吗？」玩家可以通过承受风险来获取信息、解开谜题，或者见识到他从未见过的事情来获得乐趣。");
    g_tipLine[20508] = StringToText("如果「这对玩家来说好玩吗？」这个问题过于模糊，可以替换为这个问题：「这对玩家来说有趣吗？」");
    g_tipLine[20509] = StringToText("  如果你正在做一些有趣的事情，玩家会自发地创造乐趣。");
    g_tipLine[20510] = StringToText("最重要的事情是记得要公平。无神论者对于玩家来说不公平，因为他们任你摆布。无神论者对于说书人来说不公平，");
    g_tipLine[20511] = StringToText("  因为只有玩家赢的时候说书人才会「赢」……所以说书人总是在某一方面失败。这个角色带着一点微妙的不公平。");
    g_tipLine[20512] = StringToText("  无论如何，如果你曾在内心怀疑过你所做的事情是真的不公平且不符合无神论者的设计理念，");
    g_tipLine[20513] = StringToText("  那么就要谨慎行事并转而做出公平的事情。你可以在游戏初期更不公平一些，因为玩家需要好几天来做出判断。");
    g_tipLine[20514] = StringToText("  但不要在最后时刻过于不公。如果你输了，那就是输了。如果你尽可能地让游戏不公平，却总是留出机会让善良阵营获胜，");
    g_tipLine[20515] = StringToText("  然后他们成功做到了（或者非常接近胜利了！），那么这对于所有人来说都是有趣的游戏。");
    g_tipLine[20516] = StringToText("你的目标是通过让善良阵营相信无神论者正在说谎而「获胜」。因此，在游戏规则范围和模糊的公平感之内，");
    g_tipLine[20517] = StringToText("  尽你所能让善良阵营不信任无神论者！尽你所能让善良阵营相互猜疑并相互处决！制造冲突信息。");
    g_tipLine[20518] = StringToText("  使用他们自身能力杀死玩家。如果剧本上有可以制造复数死亡的恶魔，那就制造这些死亡。尽你所能！");
    g_tipLine[20519] = StringToText("  无神论者应该始终都尽可能地被看作邪恶。他知道你在做什么！让探查邪恶的角色探查出无神论者是邪恶的！");
    g_tipLine[20520] = StringToText("  如果玩家们压倒性的认为某名玩家是邪恶的，让这名玩家认为无神论者是善良的！这使得他们两个看起来都是邪恶的！");
    g_tipLine[20521] = StringToText("  尽你所能去制造纷争和疑虑——因为当只有三名玩家存活时，他们需要对彼此猜疑。直到最后一天之前，");
    g_tipLine[20522] = StringToText("  将所有「游戏平衡」的概念统统扔掉，造成尽可能多的混乱和怀疑。");
    g_tipLine[20523] = StringToText("让最可疑的玩家活着。当你需要在夜晚杀死玩家时，像真正的恶魔那样去做。真正的恶魔会杀死非常值得信任的玩家并让看起来");
    g_tipLine[20524] = StringToText("  可疑的玩家活着，这样做可以让恶魔以外的玩家被处决。这条规则的例外是，你也许想让玩家活着，");
    g_tipLine[20525] = StringToText("  这样他们可以使用能力并获取错误信息。比如说，让占卜师活着直到他的信息看起来对他有用。让贞洁者活着，");
    g_tipLine[20526] = StringToText("  直到他触发了他的能力。没必要每晚都杀死最强力的玩家。想象一下，如果恶魔每晚可以杀死一名玩家，");
    g_tipLine[20527] = StringToText("  还可以让一名玩家中毒，还可以查看魔典，那么他会怎么做？去模仿那些行为。");
    g_tipLine[20528] = StringToText("模拟剧本列表中爪牙的能力。虚构能力或游戏规则可能看起来很狡猾或很离谱，但只要有可能，你就可以模仿剧本上邪恶角色的");
    g_tipLine[20529] = StringToText("  行动。如果剧本上有女巫，在玩家发起提名时杀死他。如果剧本上有麻脸巫婆，将玩家变为不同的角色。");
    g_tipLine[20530] = StringToText("  但如果你在剧本上没有女巫或麻脸巫婆的时候这样做，玩家会迅速发现唯一可能发生这种情况的方法，");
    g_tipLine[20531] = StringToText("  就是说书人因为无神论者的能力正在作弊（你确实是！）。你不需要以特定的方式假装爪牙的行动，");
    g_tipLine[20532] = StringToText("  你只需要让游戏看起来是有爪牙和恶魔在场，并且他们有真正的效果。例如，你不需要在假装女巫的时候「选择一名玩家」");
    g_tipLine[20533] = StringToText("  并期待这名玩家发起提名。你可以杀死任何发起提名的玩家，在他提名的那一瞬间做出决定！如果你巧妙地打破游戏规则，");
    g_tipLine[20534] = StringToText("  使得看起来像是有爪牙和恶魔在场，在脑海中记下你正在模拟哪些爪牙和恶魔，这样你就不会意外地模拟了太多爪牙或恶魔！");
    g_tipLine[20535] = StringToText("提供错误信息以制造冲突。给出任何你认为会在玩家之间制造冲突的信息，即使游戏中没有醉酒或中毒。");
    g_tipLine[20536] = StringToText("  如果所有善良玩家都相信其他所有玩家都是善良，那游戏将没有任何挑战可言。如果都是新手玩家，");
    g_tipLine[20537] = StringToText("  向他们给出「所有玩家都是善良的」这种类型的信息，或者说，如果给出的信息都是玩家最不希望看到的，使得他们说出：");
    g_tipLine[20538] = StringToText("  「在无神论者对局中不可能所有信息都表明我们都是善良的！」这很有趣，并且对于合适的时间里合适的团体来说，");
    g_tipLine[20539] = StringToText("  是一个独特的挑战。但一般来说，如果有多条信息相互冲突，以至于由这些信息构成的谜题过于困难而无法解决，");
    g_tipLine[20540] = StringToText("  那么只能得出一个结论——一个无解之题——因此这是一场无神论者对局。");
    g_tipLine[20541] = StringToText("提供错误信息以构筑一致的世界观。假设场上有适当数量的玩家是爪牙和恶魔，并且你给出能够引导善良玩家得出这个结论的信");
    g_tipLine[20542] = StringToText("  息，那么这样做效果很好。但我个人倾向于使用「信息之间不完全重叠」的方法，而不是「所有信息都指向小明和小美是邪");
    g_tipLine[20543] = StringToText("  恶的」。如果你真的使用了后面这个方法，也许你要在魔典上记下你正在让小明和小美表现得像什么角色，");
    g_tipLine[20544] = StringToText("  这样能让你的所有错误信息都是一致的。");
    g_tipLine[20545] = StringToText("以制造冲突的方式使用功能型能力。功能型能力在无神论者对局中很炫酷，因为这些能力有着更强的自我反馈效果。");
    g_tipLine[20546] = StringToText("  当它失效的时候非常具有戏剧性。每当角色能力能够触发时（无论它是否「有效」），你要考虑是否希望它生效。");
    g_tipLine[20547] = StringToText("  如果场上有茶艺师，一名与之邻近的玩家被处决，请考虑是否让该玩家在处决中幸存下来。如果幸存，");
    g_tipLine[20548] = StringToText("  这确证三名玩家都是善良的。如果没有幸存，这会让这些玩家看起来是邪恶的——但你是否希望这些玩家看起来是邪恶的？");
    g_tipLine[20549] = StringToText("  判断好是否应该让无法生效的能力生效，或是让应该生效的能力不生效。做出任何你认为能够让无神论者看起来是在说谎的");
    g_tipLine[20550] = StringToText("  事。");
    g_tipLine[20551] = StringToText("机械直白地进行游戏，让游戏看起来像是普通的对局。如果虚假的猎手声明自己是猎手，他不会猎杀任何人。");
    g_tipLine[20552] = StringToText("  如果一晚有8名玩家获得信息，让其中1至3名玩家获得错误信息，而不是全部。按照通常方式进行投票。");
    g_tipLine[20553] = StringToText("  用是或否来回答艺术家的问题。在查看魔典的时候假装真的在思考给博学者的信息。在杂耍艺人进行猜测的时候在魔典上移");
    g_tipLine[20554] = StringToText("  动他的猜测标记。如果你做每件事都像平常那样，让游戏看起来是一个非常普通的，无神论者不在场的对局，");
    g_tipLine[20555] = StringToText("  玩家会真的怀疑是否要处决你。这正是你想要的。");
    g_tipLine[20556] = StringToText("绷紧情绪进行游戏。保持一本正经的表情。当玩家指责你违反规则时，作出看起来难以置信的表情。");
    g_tipLine[20557] = StringToText("  就像你在游戏时虚张声势那样，保持礼貌、尊敬、友善，但仍然要说玩家错了，没有无神论者在场。");
    g_tipLine[20558] = StringToText("  顺利地进行游戏并保持自信的声调和肢体语言。不需要因为「作弊」而感到尴尬——无神论者的能力鼓励你这样做，");
    g_tipLine[20559] = StringToText("  而这正是玩家真正想要的：一个无法被猜到的说书人正在呈现一个有趣的谜题。你不需要坚持认为无神论者不在场，");
    g_tipLine[20560] = StringToText("  如果你不这样坚持，通常来说那是最好的。");
    g_tipLine[20561] = StringToText("明确处决说书人的规则。完全诚实地遵守游戏规则。尤其是要诚实而明确地遵守处决说书人的规则。告诉玩家，");
    g_tipLine[20562] = StringToText("  无论无神论者是否在场都可以对说书人发起提名，并且你会像普通玩家那样被处决。告诉玩家，");
    g_tipLine[20563] = StringToText("  无神论者在场的情况下处决你意味着善良阵营获胜，如果没有真正的无神论者在场，处决你意味着善良阵营落败。");
    g_tipLine[20564] = StringToText("  所有玩家都需要知道这些规则，这样他们就可以在完全知道自己正在做什么的情况下处决你。此外，");
    g_tipLine[20565] = StringToText("  不要打破任何关于上述内容的规则——如果你被提名，并且玩家通过投票处决了你，那就这样。你输了。不要作弊。");
    g_tipLine[20566] = StringToText("  不要违反规则。善良阵营获胜。游戏结束。");
    g_tipLine[20567] = StringToText("留下线索。善良阵营很少会如此不信任无神论者而在游戏初期尝试进行处决。如果是这样的话，请将你想要「赢」");
    g_tipLine[20568] = StringToText("  的欲望放到一边，给他们一些线索。也许在某个时刻让所有信息都是真实的？或者给出一些线索说明无神论者是善良的。");
    g_tipLine[20569] = StringToText("  「争取胜利」是你的次要目标。「主持有趣并且公平的游戏」始终是你的首要目标。同理，像角色扮演游戏（RPG）");
    g_tipLine[20570] = StringToText("  的城主/主持人那样思考——你希望提供挑战并为了乐趣创造条件。那么，一旦设置好这些条件，");
    g_tipLine[20571] = StringToText("  你希望发挥出自己的最佳状态，但如果你发现事情有点太不公平了，那么就重新调整，让局势更公平一些。");
    g_tipLine[20572] = StringToText("  你很少需要这样做。");
    g_tipLine[20573] = StringToText("游戏结束后向善良阵营表示祝贺。善良阵营可能会获胜，这很好。祝贺他们。你自诩为这个故事中的大坏蛋，");
    g_tipLine[20574] = StringToText("  并且这个大坏蛋的目的就是被打败。善良阵营胜利，所以和他们一起庆祝吧。你创造了一场有趣的游戏，");
    g_tipLine[20575] = StringToText("  所以也要祝贺你自己。如果你赢了，优雅地去给它画上句号。解释错误信息的关键在哪，因此使得善良阵营可以知道他们在");
    g_tipLine[20576] = StringToText("  哪里出错以及他们可以如何获胜。避免说出「你应该这样做」，而是让玩家知道你玩得很开心，你也希望他们开心。");
    g_tipLine[20577] = StringToText("通过曾经帮助玩家成功伪装无神论者来建立一个恐惧的氛围。如果邪恶阵营正在伪装成无神论者，尽你所能去帮助他们获胜。");
    g_tipLine[20578] = StringToText("  特别是你可以激怒玩家来提名你！将可怕的后果公之于众并高兴地要求被提名，让邪恶阵营能够获胜！");
    g_tipLine[20579] = StringToText("  鼓励善良玩家投票给你！刺激善良玩家投票给你！一旦善良阵营因为邪恶玩家声明自己是无神论者而处决了几次说书人，");
    g_tipLine[20580] = StringToText("  他们将在真无神论在场时对于处决说书人变得更犹豫。以这种方式拿捏善良阵营，需要说书人与这些玩家都比较熟悉。");
    g_tipLine[20581] = StringToText("  如果他们喜欢这种幽默，那么他们会喜欢你主持的游戏。但对于陌生玩家，你可能会觉得自己这样做有点混蛋，");
    g_tipLine[20582] = StringToText("  所以在做这种事情之前，先了解一下局内玩家。说书人不仅仅被看作是游戏负责人，还被看作是玩家的负责人。");
    g_tipLine[20583] = StringToText("  是社交组织者。玩家需要在私底下能够信任你，尽管他们对你作为游戏参与者并不信任，模糊这个界线可能会导致一些问题。");
    g_tipLine[20584] = StringToText("  例如，如果玩家认为你是「对立阵营的」而变得不敢向你私下提问，并且对你撒谎，那就不好玩了。");
    g_tipLine[20585] = StringToText("· 【所以……我怎样能够很糟糕地运作无神论者？这问题真尴尬。】");
    g_tipLine[20586] = StringToText("去特喵的玩家！设置一个玩家们根本不可能弄明白的难以置信的复杂场景，然后获胜并宣布你是这局游戏中最聪明的人！");
    g_tipLine[20587] = StringToText("  给博学者无用的信息，比如说天空的颜色！告诉渔夫「你可以做得更好」！如果你把赢得游戏作为你唯一的目标，");
    g_tipLine[20588] = StringToText("  这很容易通过牺牲玩家的乐趣来完成。");
    g_tipLine[20589] = StringToText("以打破规则来结束游戏！突然之间宣布善良阵营落败！一晚杀死三名玩家让游戏变成只有两名玩家存活，");
    g_tipLine[20590] = StringToText("  让他们失去最后一天的机会！在有圣徒的游戏中加入一个邪恶的法官！因为小明正在获得正确信息，");
    g_tipLine[20591] = StringToText("  所以你宣布单方面决定他是「善良双子」，所以你处决他导致邪恶获胜！当你被提名时，不计算票数！");
    g_tipLine[20592] = StringToText("打破基础规则。错误地回答规则问题。对玩家气冲冲。无视私聊请求。打破那些让说书人变得优秀的规则/建议，");
    g_tipLine[20593] = StringToText("  仅仅是「因为你可以」。");
    g_tipLine[20594] = StringToText("让规则/能力以明显错误的方式运作。这可能是偶然发生的。这并不是最糟糕的事情，但玩家会迅速找出无神论者并获胜。");
    g_tipLine[20595] = StringToText("在你获胜的时候幸灾乐祸。玩家落败并对此感到愤怒？让他们感觉更糟糕。");
    g_tipLine[20596] = StringToText("（说真的——请不要做这些事。仅仅因为理论上你可以做，并不意味着你应该这样做。）");
    g_tipLine[20597] = StringToText("· 【等一下，什么？说书人还能在游戏中胜利或失败？这不是坏了规矩？】");
    g_tipLine[20598] = StringToText("现在我已经对此进行过考虑，我后悔使用了说书人「获胜」的措辞。如果脱离语境，这种想法会让一些说书人不惜任何代价取胜，");
    g_tipLine[20599] = StringToText("  甚至包括牺牲玩家的乐趣。相反的是，不如以这种方式去考虑这个问题……如果游戏能够进行到最后一天，说书人「获胜」。");
    g_tipLine[20600] = StringToText("  这始终都是说书人的目标，即使无神论者不在场也是如此。玩家们玩得开心吗？那很棒，说书人也「赢」了。");
    g_tipLine[20601] = StringToText("  说书人能够而且应当尽最大努力让游戏进行到最后一天，因为这对于玩家来说是最有趣的，为了做到这点，");
    g_tipLine[20602] = StringToText("  鼓励说书人去造成尽可能多的冲突、错误信息、猜疑和混乱。为了做到这点，说书人「代表着不存在的邪恶阵营正在进行游");
    g_tipLine[20603] = StringToText("  戏」直至最后一天，然后说书人让善良阵营的玩家决定应该做什么。诸如此类。如果有人在读到这段话时有更好的表达方式，");
    g_tipLine[20604] = StringToText("  使得说书人能够像普通玩家那样「玩游戏」的同时牢记游戏的公平性，那么我很乐意以这种全新的方式进行表达。");
    g_tipLine[20605] = StringToText("· 【为何在无神论者对局中没有邪恶角色？】");
    g_tipLine[20606] = StringToText("无神论者对局中没有邪恶角色，有四个原因。");
    g_tipLine[20607] = StringToText("对于邪恶玩家来说不是很有趣。在无神论者对局中，一名善良玩家开局知道谁是「恶魔」，并且游戏中会有2到5名额外的善良");
    g_tipLine[20608] = StringToText("  玩家（通常是镇民）。这对于善良阵营来说绝对是巨大优势。太巨大了。作为无神论者对局戏中唯一的邪恶玩家，");
    g_tipLine[20609] = StringToText("  你会感到非常孤独和无助。即使游戏中还有另外一名（或两名）邪恶玩家，善良阵营仍然在知道「恶魔」");
    g_tipLine[20610] = StringToText("  是谁的情况下开始游戏。这让邪恶玩家感觉很不公平。");
    g_tipLine[20611] = StringToText("对于善良玩家来说，这样进行游戏更有趣：他们需要弄清楚是否所有人都是善良的，而不是需要弄清楚是否有人说谎。");
    g_tipLine[20612] = StringToText("  如果场上有邪恶玩家，任何表现得像是在说谎的玩家（可能是因为错误信息）实际上可能就是邪恶的。然而，");
    g_tipLine[20613] = StringToText("  在没有邪恶玩家的情况下，每名玩家都面临着额外的挑战——每名看起来在说谎的玩家可能都是善良的。");
    g_tipLine[20614] = StringToText("  这完全颠覆了通常的说法——错误信息=好人，而不是错误信息=坏人。");
    g_tipLine[20615] = StringToText("邪恶玩家在场的无神论者对局中，当善良阵营说出「我们相信无神论者。让我们处决说书人并获胜吧」时，他们获胜。");
    g_tipLine[20616] = StringToText("  邪恶玩家不在场的无神论者对局中，当善良阵营说出「我相信我们都是善良的，说书人在和我们作对。");
    g_tipLine[20617] = StringToText("  让我们处决说书人并获胜吧」时，他们获胜。后者比前者更有趣，因为说书人是坏家伙，但不是邪恶玩家。");
    g_tipLine[20618] = StringToText("无神论者对局中，当所有玩家都是善良的却输掉游戏，相比邪恶玩家在场而输掉游戏，更具有讽刺意味和诗意。");
    g_tipLine[20619] = StringToText("  在一场精彩绝伦的游戏中（双关语，亦可指全是善良玩家的游戏），善良玩家凭借自己输掉游戏，这很有趣。");
    g_tipLine[20620] = StringToText("  在一场绝大多数都是善良玩家的游戏中，邪恶玩家战胜善良玩家。这并不有趣。全是善良玩家的游戏是独一无二的。");
    g_tipLine[20621] = StringToText("  这使得无神论者成为特殊状况。");
    g_tipLine[20622] = StringToText("· 【但我可以让邪恶角色/玩家加入到无神论者对局中吗？】");
    g_tipLine[20623] = StringToText("请不要这样做。关于规则的严格解读，是否允许加入邪恶角色/玩家存在争论。但加入邪恶角色/玩家肯定不是设计意图，");
    g_tipLine[20624] = StringToText("  而且我绝对不建议这样做。");
    g_tipLine[20625] = StringToText("· 【可以在无神论者对局中加入创造邪恶玩家的角色吗？】");
    g_tipLine[20626] = StringToText("可以。说书人可以加入赏金猎人，莽夫，异教领袖等等（在莽夫或异教领袖的例子中，通过打破规则让他在后续的夜晚中转变为");
    g_tipLine[20627] = StringToText("  邪恶）因为无神论者的方括号能力只在设置阶段阻止加入邪恶玩家。应该这样做吗？只有当你了解玩家群体，");
    g_tipLine[20628] = StringToText("  特别是知道特定玩家认为这件事没问题的时候你才能这样做。许多玩家不会同意由于打破规则使他转变为邪恶，");
    g_tipLine[20629] = StringToText("  从而被迫输掉游戏。通常来说，扪心自问：「这个孤独的邪恶玩家有机会获胜吗？游戏对他来说有趣吗？」");
    g_tipLine[20630] = StringToText("  如果这两个问题的答案都是「否」，那么我建议不要将玩家转变为邪恶。");
    g_tipLine[20631] = StringToText("· 【说书人可以告诉实际上仍然善良的玩家现在是邪恶的吗？】");
    g_tipLine[20632] = StringToText("可以。在无神论者对局中，说书人有可能通过打破游戏规则来欺骗玩家的阵营与实际不符，但始终要非常谨慎地处理这种情况。");
    g_tipLine[20633] = StringToText("  这始终取决于如果你认为你的玩家会喜欢这样做。如果你对此有疑问，请谨慎行事，除非你完全确定（玩家喜欢），");
    g_tipLine[20634] = StringToText("  否则不要这样做。");
    g_tipLine[20635] = StringToText("· 【我可以在完全不打破规则的情况下运作游戏吗？】");
    g_tipLine[20636] = StringToText("当然。这会使游戏看起来像是邪恶阵营没有造成任何破坏的非无神论者对局。这很棒，如果这就是你想要的。");
    g_tipLine[20637] = StringToText("· 【我做错了什么？绝大多数情况下，无神论者都赢了！80%甚至更多！】");
    g_tipLine[20638] = StringToText("这很好。无神论者知道谁是恶魔，所以善良阵营在大多数情况下都能获胜并不奇怪。通常情况下，这样的角色需要被削弱，");
    g_tipLine[20639] = StringToText("  所以对于对立阵营来说这仍然很有趣。在无神论者对局中，没有对立阵营。主持一场所有人都获胜的游戏（字面意思！）");
    g_tipLine[20640] = StringToText("  非常棒。此外，无神论者落败会有点糟糕。「噢天啊，我们都是善良玩家，但我们输了。」说书人在「获胜」");
    g_tipLine[20641] = StringToText("  中的喜悦很容易被解读成说书人做出了不公平的举动。所以让无神论者在大多数对局中获胜是好事。");
    g_tipLine[20642] = StringToText("· 【无神论者好玩在哪里？】");
    g_tipLine[20643] = StringToText("无神论者对于无神论者玩家来说很有趣，因为他知道所有事情。他知道谁是「恶魔」（说书人），");
    g_tipLine[20644] = StringToText("  他知道其他所有玩家都是善良的。他知道错误信息毫无意义——这只是说书人心血来潮。无神论者的唯一目标是说服大多数");
    g_tipLine[20645] = StringToText("  善良玩家相信所有人都是善良的，因为他是无神论者，所以没有邪恶玩家在场，所有人都可以相互信任。");
    g_tipLine[20646] = StringToText("  这在钟楼谜团中是一个非常独特的目标。无神论者的敌人是说书人，并且需要在朋友之间组成一个团队。这非常有趣。");
    g_tipLine[20647] = StringToText("无神论者对于善良玩家来说很有趣，因为钟楼谜团是解谜游戏，而无神论者对局是一个独特的谜题。");
    g_tipLine[20648] = StringToText("  他们被无神论者告知说所有人都是善良的。然而，他们因自身能力而得知某些玩家是邪恶的。这不合常理。");
    g_tipLine[20649] = StringToText("  与往常的挑战不同，游戏目标变成「找出一条让我们所得信息都说得通的可能逻辑链，否则，处决说书人！」，");
    g_tipLine[20650] = StringToText("  而不是「寻找邪恶玩家」。因此，游戏挑战不仅仅是找出某名邪恶玩家，而是将整个谜题组合在一起。就像拼图一样，");
    g_tipLine[20651] = StringToText("  只有当你几乎完成谜题的时候，你才知道自己是否丢失了部分线索。");
    g_tipLine[20652] = StringToText("无神论者对于善良玩家来说很有趣，因为在与说书人斗智而不是与其他玩家斗智的过程中会产生一种同志情谊。");
    g_tipLine[20653] = StringToText("  说书人的职责是尽可能地狡猾，而玩家的职责是同心协力让说书人陷入困境。你可以把这种情况看作是玩家与说书人的对决，");
    g_tipLine[20654] = StringToText("  或者玩家与游戏本身的对决。不管怎样，玩家都在面对一个全新而独特的对手，并产生一种新的友谊情感。");
    g_tipLine[20655] = StringToText("  当所有玩家都意识到「我曾经以为玩家X、Y和Z都是坏人，但现在我相信我们都是好人！」，这个时刻非常棒，");
    g_tipLine[20656] = StringToText("  就像是反向的军团游戏。");
    g_tipLine[20657] = StringToText("无神论者对于说书人来说很有趣，因为说书人可以在游戏中测试自己欺诈和误导的技巧。说书人可以真正成为一名玩家（参与游");
    g_tipLine[20658] = StringToText("  戏）。说书人「像对待食物那样对待朋友」。说书人真的在通过欺骗尽可能多的玩家认为这不是无神论者对局来「试图获胜」");
    g_tipLine[20659] = StringToText("  。此外，无神论者令说书人能够告诉任意玩家任意信息，使得说书人享受一场精彩的游戏——观看这样的游戏真的很有趣。");
    g_tipLine[20660] = StringToText("· 【我是新手说书人！无神论者听起来很有趣，但我的玩家并不喜欢。是我做错了什么，还是无神论者很差劲？】");
    g_tipLine[20661] = StringToText("可能两者都有。任何给予说书人很多权力的角色（博学者，渔夫等）对于新手说书人来说都是棘手的。");
    g_tipLine[20662] = StringToText("  我通常只向进阶说书人推荐这些角色。无神论者是所有这些角色之中最棘手的一个。在尝试无神论者之前，");
    g_tipLine[20663] = StringToText("  请先熟悉《暗流涌动》直至你能在睡梦中主持它，然后熟悉《黯月初升》和《梦殒春宵》直至能够在半睡半醒时主持它们。");
    g_tipLine[20664] = StringToText("  如果你不知道你在做什么，很容易意外地让某一方获胜——这对于任何人来说都不好玩。如果你意外地让善良阵营落败，");
    g_tipLine[20665] = StringToText("  他们会因为无能为力而经历一段糟糕的时光。如果你意外地让善良阵营获胜，他们可能会觉得无聊，因为毫无挑战。");
    g_tipLine[20666] = StringToText("然而，即使是经验丰富的说书人也只建议在进阶玩家团体之中运作无神论者。你可以给新手玩家运作无神论者，");
    g_tipLine[20667] = StringToText("  但他们可能不会喜欢。因为无神论者完全颠覆既定的规则和策略。除非这些规则和策略已经在这些玩家脑中确立下来，");
    g_tipLine[20668] = StringToText("  打破规则才不会是一项禁忌。玩家需要在打破规则之前学习规则，否则这个挑战就不算刁钻。");
    g_tipLine[20669] = StringToText("· 【在制作有无神论者的剧本时，哪些角色能与它搭配得很好？】");
    g_tipLine[20670] = StringToText("我认为这不是一个完全准确的问题。更重要的是哪些角色之间存在冲突。将角色混合在一起会有各种机会发生信息对撞。");
    g_tipLine[20671] = StringToText("  共情者的信息可以与调查员的信息冲突。茶艺师的「信息」可以与魔鬼代言人冲突。在选择角色时，最好是成对添加，");
    g_tipLine[20672] = StringToText("  由此玩家认为「如果这是无神论者对局，是因为这里出现了矛盾；但如果这不是无神论者对局，是因为那里出现了矛盾。」");
    g_tipLine[20673] = StringToText("  诸如此类。");
    g_tipLine[20674] = StringToText("我通常喜欢在无神论者对局中加入信息角色或需要隐藏的角色，并且加入很多。这经常给玩家提供说谎的机会，");
    g_tipLine[20675] = StringToText("  而不会暴露出游戏中有无神论者。例如，如果共情者，守鸦人和神谕者都获得错误信息，那么没人知道这些信息是否错误，");
    g_tipLine[20676] = StringToText("  或者三人之中是否有人在说谎。然而，如果我让两名玩家在夜晚死亡（模拟刺客）但我还在一名玩家发起提名时杀死他，");
    g_tipLine[20677] = StringToText("  如果游戏中只可能有一个爪牙，玩家将会知道这是无神论者对局。向信息角色提供冲突信息是最简单的。");
    g_tipLine[20678] = StringToText("但将无神论者与那些具有公开效果的角色相互结合真的非常有趣。将洗脑师与无神论者组合起来，然后真实地处决玩家，");
    g_tipLine[20679] = StringToText("  真的可以让一些玩家相信无神论者不在场。让猎手猎杀任意玩家是非常搞笑的！但被杀害的玩家肯定知道这是无神论者对局。");
    g_tipLine[20680] = StringToText("  信息角色容易引起混乱。功能角色容易制造更多戏剧性，但会让特定玩家知道无神论者在场。我曾经有过一次精彩的对局，");
    g_tipLine[20681] = StringToText("  我唤醒两名玩家并告诉他们，另一名玩家是镜像双子。我唤醒他们，让他们眼神交流，向其中一名玩家展示镜像双子角色标");
    g_tipLine[20682] = StringToText("  记，将标记放回魔典，再次拿出这个标记并向另一名玩家展示。这运作得非常好。诸如此类的「功能」角色，或者猎手，");
    g_tipLine[20683] = StringToText("  魔像，茶艺师以及其他说不上名字的角色，都可以给说书人带来成吨的快乐，但需要更多关注和尝试那些适合你的组合。");
    g_tipLine[20684] = StringToText("· 【我需要因为具有结束游戏能力的角色，去结束游戏吗，比如说圣徒或镇长？】");
    g_tipLine[20685] = StringToText("不需要。说书人可以打破任意规则。游戏可以在圣徒被处决后继续，或者在没有发生处决的最后一天落败。然而，");
    g_tipLine[20686] = StringToText("  在这样做之前多加思考。当圣徒说「我是圣徒！游戏应该结束了！我们应该输了！」时，继续游戏仍然很有趣。");
    g_tipLine[20687] = StringToText("  当镇长说「我是镇长。说书人随意地决定让我的能力失效，所以我们输了」时，游戏一点也不好玩。");
    g_tipLine[20688] = StringToText("我建议不要因为不在场的角色而结束游戏。当然，无神论者对局的重点（主要）是模拟邪恶角色的存在。");
    g_tipLine[20689] = StringToText("  但因为你正在模拟涡流在场，所以由于没有发生处决而结束游戏，这也太过火了。同理，仅仅因为你曾向调查员展示主谋在");
    g_tipLine[20690] = StringToText("  场，然后由于不存在的主谋而结束游戏，同样很过火。玩家不喜欢这样。他们是对的。请不要仅仅因为说书人的选择而结束");
    g_tipLine[20691] = StringToText("  游戏。");
    g_tipLine[20692] = StringToText("无论哪种情况，玩家应该提前知道，如果他们不相信无神论者，他们的行为可能会以游戏落败而告终。");
    g_tipLine[20693] = StringToText("  只要玩家事先清楚做出决定的可能后果（如果他们提问，回答他们的问题）那么以善良角色能力来结束游戏是合适的。");
    g_tipLine[20694] = StringToText("· 【我可以使用复数角色标记吗？】");
    g_tipLine[20695] = StringToText("可以。很棒的主意！（但这需要你有复数套实体游戏，或通过线上魔典实现）");
    g_tipLine[20696] = StringToText("· 【即使玩家没有得到足够的投票，我可以宣布该玩家死亡吗？】");
    g_tipLine[20697] = StringToText("可以。试一试吧。我对你能否逃脱惩罚深表怀疑，尤其是在线上。只是不要用这种方式结束游戏（因为这不有趣）。要知道，");
    g_tipLine[20698] = StringToText("  如果玩家抓到你，他们第二天就会（物理）处决你！");
    g_tipLine[20699] = StringToText("· 【即使玩家获得足够的投票，并且场上没有保护（和平主义者等），我可以宣布他没有死亡吗？】");
    g_tipLine[20700] = StringToText("可以。如果你的剧本上有角色可以阻止死亡，我推荐这样做！多有趣啊！");
    g_tipLine[20701] = StringToText("· 【我可以做出在常规游戏中不可能同时发生的两件事吗？】");
    g_tipLine[20702] = StringToText("比如……模拟女巫杀死一名玩家，并且模拟投毒者对另一名玩家给出错误信息（当游戏中只可能有一个爪牙在场时），");
    g_tipLine[20703] = StringToText("  或者同时让两名玩家中毒（当游戏中只可能有一个爪牙在场时）？");
    g_tipLine[20704] = StringToText("可以！我强烈建议！");
    g_tipLine[20705] = StringToText("· 【我可以做出在剧本上不可能发生的事情吗？】");
    g_tipLine[20706] = StringToText("比如……当剧本上完全没有可以发生醉酒或中毒的角色时，向玩家提供错误信息？");
    g_tipLine[20707] = StringToText("可以！去尝试吧！");
    g_tipLine[20708] = StringToText("· 【我可以制定新的规则吗？（比如长头发的玩家不能发起提名）】");
    g_tipLine[20709] = StringToText("哎鸭！虽然理论上无神论者允许说书人打破规则，制定阻止说书人被处决的规则毫无意义。这就像城主在与玩家进行游戏的时候");
    g_tipLine[20710] = StringToText("  突然说「你们都死了。」当然，你可以这样做。但玩家会失去对你的尊敬并且再也不想和你一起玩了。此外，");
    g_tipLine[20711] = StringToText("  你制定的任何明显不是由于角色能力造成的规则，会让玩家立即认为这是由无神论者造成的，并且立即处决说书人。");
    g_tipLine[20712] = StringToText("  这毫无意义。");
    g_tipLine[20713] = StringToText("· 【我可以制定或打破那些并非「硬性」的规则吗？】");
    g_tipLine[20714] = StringToText("比如「与他人友好相处」，或者规则书中关于如何运作优质游戏的建议？");
    g_tipLine[20715] = StringToText("你可以。虽然但是，你总是可以这样做。那些不是规则。它们是关于如何让游戏变得有趣，包容，刺激和值得的建议。");
    g_tipLine[20716] = StringToText("  如果你希望打破规则并使用无神论者的能力允许或证明一名玩家对另一名玩家来说是混蛋，那么你就是在说，");
    g_tipLine[20717] = StringToText("  你不想要一个有趣，包容，刺激或值得的游戏，而是想要一个无趣，难堪和失望的游戏。无神论者的设计意图不包括鼓励说");
    g_tipLine[20718] = StringToText("  书人打破规则书中关于社交的规则/建议，或是打破线上游戏中的社交规则/建议。");
    g_tipLine[20719] = StringToText("· 【当我将无神论者作为伪装提供给恶魔时，善良玩家总是获胜。无神论者是一个糟糕的伪装吗？】");
    g_tipLine[20720] = StringToText("是也不是。我建议说书人不要将无神论者作为伪装提供给恶魔。所有邪恶玩家都已经知道场上没有无神论者。如果有的话，");
    g_tipLine[20721] = StringToText("  他们不可能是爪牙或恶魔。将无神论者作为伪装提供给恶魔没有意义，只会将对他有用的伪装数量从3减少到2。");
    g_tipLine[20722] = StringToText("所有邪恶玩家都知道他可以安全地在任意对局中的任意时间伪装成无神论者。他们不需要被告知无神论者不在场才能这样做。");
    g_tipLine[20723] = StringToText("  这使得无神论者成为游戏中最简单的伪装之一。");
    g_tipLine[20724] = StringToText("然而，大多数玩家都认为这是一个好主意：杀死无神论者「以防万一他是邪恶的」。我不同意这种每次游戏都应该这样做的策略。");
    g_tipLine[20725] = StringToText("  但是如果没有更好的目标，这样做确实有意义。无神论者倾向于在早期死亡，并且经常如此。");
    g_tipLine[20726] = StringToText("  这使得伪装成无神论者非常危险。");
    g_tipLine[20727] = StringToText("无神论者的伪装如果获得信任，那也是毁灭性的。这确实会让邪恶阵营赢得游戏，因为善良阵营处决说书人并落败。所以，");
    g_tipLine[20728] = StringToText("  这很奇怪。无神论者对邪恶玩家来说是非常容易的伪装，因为你知道你不会和善良玩家合作。");
    g_tipLine[20729] = StringToText("  如果伪装得令人信服就能赢得游戏。但善良阵营可能会在这个过程中杀死你。");
    g_tipLine[20730] = StringToText("尽管向恶魔提供无神论者的伪装没有意义，我不建议你这样做是因为新手玩家将接受这个伪装并使用它，然后因此被杀。");
    g_tipLine[20731] = StringToText("  这不值得。");
    g_tipLine[20732] = StringToText("对于爪牙来说伪装成无神论者效果更好。伪装成无神论者，死亡，然后在随后的游戏中获胜。出于这个原因，");
    g_tipLine[20733] = StringToText("  我建议编写（带有无神论者的）剧本时带上一到两个不介意死亡的爪牙。男爵很好。军团也很好。");
    g_tipLine[20734] = StringToText("  当列表上某些角色的最佳方式是声明自己是无神论者并且做出假设，善良阵营真的会产生相信无神论者声明的妄想。");
    g_tipLine[20735] = StringToText("  作为说书人，这正是你想要的。玩家们盲目相信所有无神论者声明，或盲目不相信所有无神论者声明，");
    g_tipLine[20736] = StringToText("  这都不是最好的对局。但如果每个无神论者声明都被怀疑对待？那更有趣。");
    g_tipLine[20737] = StringToText("· 【我可以加入错误数量的外来者吗？】");
    g_tipLine[20738] = StringToText("可以。添加更多。或减少一些。或者加入正确数量——由你决定。我建议让事情变得可信。如果你额外添加两名外来者但剧本上");
    g_tipLine[20739] = StringToText("  没有男爵……那可能行不通。可能行得通。谁知道呢？");
    g_tipLine[20740] = StringToText("· 【我的无神论者玩家往往会感到沮丧。他坐在那里告诉所有人他是无神论者，但很少玩家相信。有什么帮助的建议吗？】");
    g_tipLine[20741] = StringToText("那太棒了！这正是现实世界中被非无神论者包围的无神论者的感受。同理，或是宗教人士被非宗教人士包围的感受。");
    g_tipLine[20742] = StringToText("  这是这个角色的设计理念——无神论者知道真相，但没人相信他。如果每局无神论者对局都在无神论者公开证实自己后善良");
    g_tipLine[20743] = StringToText("  阵营早早获胜，那就没有什么趣味可言。在长期斗争（以及偶尔的损失）之中才会发生有趣的事情。");
    g_tipLine[20744] = StringToText("话虽如此，如果你的玩家在无神论者对局戏中总是以让无神论者玩家不开心的方式进行，是时候使用社交解决方案，");
    g_tipLine[20745] = StringToText("  而不是机制解决方案。让你所有的玩家都明白，这并不有趣：如果任何声明自己是无神论者的玩家立即被处决然后被排斥，");
    g_tipLine[20746] = StringToText("  直到游戏中的其他人决定他们愿意相信什么。鼓励他们与无神论者玩家交谈，了解无神论者的看法：");
    g_tipLine[20747] = StringToText("  关于说书人尝试让你们思考的各种错误信息，他是怎么考虑的。给无神论者一个机会让你们相信他正在说实话，");
    g_tipLine[20748] = StringToText("  以及是时候处决说书人了。");
    g_tipLine[20749] = StringToText("· 【我不明白无神论者的意义何在？】");
    g_tipLine[20750] = StringToText("无神论者对局的重点是所有玩家都是善良的，并且关于这个事实，说书人正在欺骗玩家。说书人试图让玩家们通过互相处决来毁");
    g_tipLine[20751] = StringToText("  灭，而玩家们试图弄清楚是否所有玩家都是善良的（无神论者说的是实话）或者这是一场普通游戏（场上没有无神论者）。");
    g_tipLine[20752] = StringToText("  这真的是玩家与说书人的对决，而不是玩家之间的对决。意义在于对决的阵营不同。");
    g_tipLine[20753] = StringToText("· 【我是最强说书人，我正在《暗流涌动》中加入并运作无神论者。有什么炫酷的操作可以让我天秀无神论者这个角色？】");
    g_tipLine[20754] = StringToText("（有些操作只能在线上完成）");
    g_tipLine[20755] = StringToText("如果游戏中有无神论者：");
    g_tipLine[20756] = StringToText("· 向洗衣妇展示两名玩家之中有守鸦人。两名玩家都是不是守鸦人。");
    g_tipLine[20757] = StringToText("· 向图书管理员展示两名玩家之中有圣徒。两名玩家实际上都是圣徒。");
    g_tipLine[20758] = StringToText("· 向调查员展示男爵在场，但游戏中外来者的数量无论在男爵局或者非男爵局都是错误的。");
    g_tipLine[20759] = StringToText("· 向厨师展示一个合理的数字。关于厨师能操作的地方不多。");
    g_tipLine[20760] = StringToText("· 对于行为可疑的角色，向占卜师给出「否」的结果。在游戏后期向占卜师给出「是」的结果，");
    g_tipLine[20761] = StringToText("  因此他始终认为最后三名玩家之中有恶魔。");
    g_tipLine[20762] = StringToText("· 如果获得错误信息的玩家提名贞洁者，处决他。如果获得正确信息的玩家提名贞洁者，不处决他。");
    g_tipLine[20763] = StringToText("· 如果游戏中有士兵或僧侣，制造一到两个平安夜。");
    g_tipLine[20764] = StringToText("· 如果猎手使用他的能力，让他杀死善良玩家。");
    g_tipLine[20765] = StringToText("· 当玩家处决了可疑人物时，向送葬者展示今天死于处决的玩家角色是小恶魔。");
    g_tipLine[20766] = StringToText("· 在夜晚杀死守鸦人。如果他选择查看的玩家认为无神论者是邪恶的，告诉守鸦人真实角色。如果他选择查看的玩家认为无神");
    g_tipLine[20767] = StringToText("  论者是善良的，告诉守鸦人错误角色。如果他选择查看无神论者，展示爪牙角色。");
    g_tipLine[20768] = StringToText("· 如果触发镇长的胜利条件，让它成功吧。但在此之前要让镇长看起来尽可能可疑。");
    g_tipLine[20769] = StringToText("· 如果圣徒被处决，让游戏继续。");
    g_tipLine[20770] = StringToText("· 盯住管家——他仍然需要根据主人的行动来投票。");
    g_tipLine[20771] = StringToText("· 避免加入酒鬼。在无神论者对局中，只要说书人愿意，所有人都可以是酒鬼。没有必要在游戏中加入酒鬼，只会混淆视线。");
    g_tipLine[20772] = StringToText("· 在进行投票和处决时要遵守规则。不要作弊。线上玩家群体非常精明，并且拥有检测作弊的技术工具。");
    g_tipLine[20773] = StringToText("· 无神论者在占卜师，调查员，守鸦人，共情者，猎手，送葬者，贞洁者眼里被当作邪恶阵营，爪牙或恶魔。");
    g_tipLine[20774] = StringToText("  无神论者在洗衣妇或图书管理员眼里不会被当作善良阵营，镇民或外来者。");
    g_tipLine[20775] = StringToText("· 游戏初期，在夜晚杀死无神论者。这样看起来像是伪装成无神论者的小恶魔传刀给爪牙。");
    g_tipLine[20776] = StringToText("· 为了增强紧张气氛，让无神论者存活到决胜日。");
    g_tipLine[20777] = StringToText("· 加入两个共情者。或两个守鸦人。或两个圣徒。或两个陌客。确保只有一组重复角色出现（恶魔通常不会重复角色）。");
    g_tipLine[20778] = StringToText("  将重复角色设置为邪恶玩家通常会伪装的普通角色。（例如，不是洗衣妇或送葬者）。为了更好玩，");
    g_tipLine[20779] = StringToText("  可以加入两个贞洁者但只有一个角色能力生效。或是两个猎手但只有一个可以杀死玩家。");
    g_tipLine[20780] = StringToText("· 与其一直说谎，不如假装每个夜晚都有一名玩家中毒。");
    g_tipLine[20781] = StringToText("· 在游戏的某个时刻，开始向所有存活玩家提供正确信息。这将使这些信息看起来更像是错误信息，");
    g_tipLine[20782] = StringToText("  但此时酒鬼/投毒者已经死亡。");
    g_tipLine[20783] = StringToText("· 双重伪装——告诉送葬者，守鸦人或洗衣妇，谁是无神论者。这些善良玩家永远不会怀疑你说的是实话。");
    g_tipLine[20784] = StringToText("如果游戏中没有无神论者：");
    g_tipLine[20785] = StringToText("· 不要将无神论者作为伪装提供给恶魔，恶魔已经知道无神论者不在场。");
    g_tipLine[20786] = StringToText("· 将无神论者作为伪装并加入红唇女郎，以便进一步鼓励恶魔伪装成无神论者！（这样小恶魔就不会介意死亡了）");
    g_tipLine[20787] = StringToText("· 加入男爵，以便进一步鼓励爪牙伪装成无神论者！（男爵不介意死亡）");
    g_tipLine[20788] = StringToText("· 如果你加入间谍，不要加入洗衣妇/守鸦人/送葬者，这样间谍就有机会声明自己是上述这些角色之一，");
    g_tipLine[20789] = StringToText("  并确认另一名邪恶玩家是无神论者。");
    g_tipLine[20790] = StringToText("· 如果你加入投毒者，尽你所能让投毒者活得尽可能久。投毒者由于持续的错误信息使得每局游戏都像是无神论者对局。");
    g_tipLine[20791] = StringToText("· 向恶魔提供那些通常用于确认善良玩家的伪装：送葬者，共情者，占卜师，洗衣妇，厨师等等。");
    g_tipLine[20792] = StringToText("  这将鼓励邪恶玩家确认虚假无神论者是善良的，而不是鼓励邪恶玩家去确认善良玩家是邪恶的。");
    g_tipRoleAt[115] = 18136; g_tipRoleN[115] = 34; g_tipP1At[115] = 18138; g_tipP1N[115] = 8; g_tipP2At[115] = 18164; g_tipP2N[115] = 6;
    g_tipRoleAt[116] = 18170; g_tipRoleN[116] = 21; g_tipP1At[116] = 18172; g_tipP1N[116] = 11; g_tipP2At[116] = 0; g_tipP2N[116] = 0;
    g_tipRoleAt[117] = 18191; g_tipRoleN[117] = 36; g_tipP1At[117] = 18193; g_tipP1N[117] = 12; g_tipP2At[117] = 0; g_tipP2N[117] = 0;
    g_tipRoleAt[118] = 18227; g_tipRoleN[118] = 46; g_tipP1At[118] = 18229; g_tipP1N[118] = 11; g_tipP2At[118] = 18261; g_tipP2N[118] = 12;
    g_tipRoleAt[119] = 18273; g_tipRoleN[119] = 33; g_tipP1At[119] = 18275; g_tipP1N[119] = 12; g_tipP2At[119] = 18304; g_tipP2N[119] = 2;
