//--------------------------------------------------------------------------------------------------
// 小工具
//--------------------------------------------------------------------------------------------------
// 【座位颜色表】（用户 2026-10-06）：**不吃大厅自选色**，按物理座位固定用 SC2 原生那套颜色；
//   说书人一律**白色**（谁是当前说书人谁就是白的，换说书人后自动跟着变）。
//   原生顺序：1 红 / 2 蓝 / 3 青 / 4 紫 / 5 黄 / 6 橙 / 7 绿 / 8 粉 /
//             9 紫罗兰 / 10 浅灰 / 11 深绿 / 12 棕 / 13 浅绿
int[14]     g_seatColor;
// 【座位→人】（用户 2026-10-06）：`g_who[逻辑位置] = 物理座位`——编号属于位置、名字属于人。
//   换说书人时对调的是 g_who 的两项；编号表 g_lab 不动（格子 2 永远叫 [1]）。
int[14]     g_who;

// 【屏蔽关系查询】（用户 2026-11-06）：a 是否屏蔽了 b。
bool BOTC_Blocked (int a, int b) {
    if (a < 1 || a > 13 || b < 1 || b > 13) {
        return false;
    }
    return g_block[(a * 14) + b];
}

// 【双向屏蔽】：任意一方屏蔽了另一方，都算不能私聊 / 邀请 / 加入。
bool BOTC_BlockEither (int a, int b) {
    if (BOTC_Blocked(a, b)) {
        return true;
    }
    return BOTC_Blocked(b, a);
}

// 【私聊里有屏蔽关系】：p 与这个私聊中任意成员的任意方向屏蔽都算。
bool BOTC_SessBlocks (int s, int p) {
    int i;
    if (s < 1 || s > 13) {
        return false;
    }
    for (i = 1; i <= 13; i += 1) {
        if (!g_member[(s * 14) + i]) {
            continue;
        }
        if (BOTC_BlockEither(p, i)) {
            return true;
        }
    }
    return false;
}

// 【解除全部屏蔽】（用户 2026-11-06）：进入新一局和游戏结算时，把所有玩家的屏蔽关系 + 屏蔽 token 一起清掉。
void BOTC_BlockClearAll () {
    int i;
    int j;
    for (i = 1; i <= 13; i += 1) {
        for (j = 1; j <= 13; j += 1) {
            g_block[(i * 14) + j] = false;
            g_tokOn[(((i * 14) + j) * 256) + 182] = false;
        }
    }
}
//   ❌ `Color` 不能当函数返回类型（编辑器报语法错误）→ 改成"返回颜色索引"的写法放在下一轮做。

string BOTC_NameStr (int p) {
    // 【p 是"格子"不是"人"】（用户 2026-10-07 截图实锤）：判"是不是说书人格"必须用 `g_who[p]`，
    //   不能写 `p == g_teller` —— 换位后 g_teller 是**物理座位**（比如 5），而格子号 5 是别人坐的，
    //   结果那个人的名字被误写成"说书人"（玩家之间换不会撞上这种巧合，涉及说书人就撞上）。
    if (g_who[p] == g_teller || p == 1) {
        return "说书人";
    }
    // 日志里存的**占位名**：渲染时会被 BOTC_NameSubst() 换成「[序号] + 战网名」。
    //   保留「玩家N」是为了兼容那些只写字符串、没法塞 text 的地方（提示条之类）。
    // 【占位名按编号 = g_lab[位置]】（用户 2026-10-07）：编号属于**位置/格子**，玩家1 = 格子2、玩家12 = 格子13。
    //   写进去的「玩家N」里的 N 就是 g_lab[位置]（编号）；渲染时 BOTC_NameSubst 把「玩家N」换成"那格现在坐的人"。
    if (p == 1) {
        return "说书人";              // 【不出现"玩家0"】（用户 2026-10-06）：格子 1 永远是"说书人格"，不按编号算
    }
    return "玩家" + IntToString(g_lab[p]);                     // 【占位名 = g_lab[格子]】（用户 2026-10-07）：玩家1 = 格子 2
}

// 「名字前面的标记」----说书人是 [说书人]，玩家是 [序号]。
//   ⚠ 序号 = g_lab[位置] + g_nameNumShift（默认 0 = 玩家1 是格子2、玩家12 是格子13）；
//     要现场调就在聊天里发 nameoff <数字>（-1 就都往前挪一位）。
string BOTC_NameTag (int p) {
    // 【说书人格子按位置判】（用户 2026-10-07）：p 是**逻辑位置**；g_teller 是物理座位，
    //   换说书人之后坐进"说书人格"的是别人（位置 1 的 g_who[1] == g_teller）→ 不能只比 p == g_teller。
    if (g_who[p] == g_teller || p == 1) {
        return "[说书人] ";            // 【去掉 [0]】（用户 2026-10-06）：位置 1 永远是"说书人格"，不带编号
    }
    return "[" + IntToString(g_lab[p] + g_nameNumShift) + "] ";  // 【编号 = g_lab[格子]】（用户 2026-10-07）：格子 2 显示 [1]
}

// 一个玩家显示出来长什么样：标记（默认颜色=白）+ **他的战网名**（按他自己的玩家颜色上色）。
// 【座位名字兜底】（用户 2026-11-04）：单人局里空位 / 电脑座位没有战网名，PlayerName() 返回空串，
//   魔典座位和聊天里的名字会整块空白；这里统一兜底成按编号的「玩家N」（编号仍取 g_lab[位置]）。
text BOTC_SeatNameText (int pos) {
    string nm;
    nm = TextToString(PlayerName(g_who[pos]));
    if (StringLength(nm) <= 0) {
        if (pos == 1) {
            return StringToText("说书人");
        }
        return StringToText("玩家" + IntToString(g_lab[pos]));
    }
    return PlayerName(g_who[pos]);
}

//   ⚠ PlayerName() 返回的是 text，所以整段用 text 拼（string + text 会报「不正确的类型」）。
text BOTC_PlayerNameText (int p) {
    if (p < 1 || p > 13) {
        return StringToText("");
    }
    // 【颜色统一】（用户 2026-10-06 / 2026-10-14）：**说书人 = 粉** Color(255,105,180)；其它按**物理座位的原生色**（g_seatColor），
    //   不再用大厅自选色。公聊 / 私聊 / 日志 / 提示条的名字都走这里，改一处就全跟上了。
    // 【名字取"这个位置现在的人"】（用户 2026-10-06）：位置 p 上现在坐的是物理座位 g_who[p] 那个人。
    // 【"说书人那一格"按位置判】（用户 2026-10-07）：g_teller 是**物理座位**，换说书人之后
    //   坐进这一格的是别人（g_who[1] == g_teller）→ 用 g_who[p] 判，否则这一格会被刷成红色。
    // 【不再标「已退出」】（用户 2026-11-03）：进行中退出只保留座位和名字，不额外加退出后缀。
    if (g_who[p] == g_teller || p == 1) {
        return StringToText(BOTC_NameTag(p)) + TextWithColor(BOTC_SeatNameText(p), libNtve_gf_ConvertPlayerColorToColor(g_seatColor[1]));   // 【说书人 = 游戏原生粉】（用户 2026-10-14）：色号 15
    }
    return StringToText(BOTC_NameTag(p)) + TextWithColor(BOTC_SeatNameText(p), libNtve_gf_ConvertPlayerColorToColor(g_seatColor[p]));
}

// 【说话人占位符】（用户 2026-10-07）：公聊 / 私聊 / 邪恶小窗 / -laugh 的**说话人**不再按"格子"记，
//   而是按**人**（你的物理座位）记成 @@1NN@@。渲染时换成"这个人**现在**所在格子的编号 + 他自己的战网名
//   + 那个格子的颜色"—— 跟公屏弹幕那一行（BOTC_SayColor）完全同一套口径。
//   ⚠ 只有**说话人**用这个；正文里提到别人（"占卜师验了 玩家5"那种）还是按格子记（那是"第几号位"的意思）。
string BOTC_SayToken (int seat) {
    return "@@" + IntToString(100 + seat) + "@@";
}

// 【物理座位 → 逻辑位置】（用户 2026-10-07）：换说书人之后"人"和"位置"不是一回事 ----
//   · 事件 / 点击 / 投递拿到的是**物理座位**（SC2 玩家号，人不会真的换坑）；
//   · 而日志 / 名字 / 编号 / 颜色都要按**位置**取（位置 i 现在坐的是 g_who[i]）。
//   反查：`g_who[i] == 这个物理座位` 的那个 i。没换过人的局 = 自己。
int BOTC_PosOf (int seat) {
    int i;
    for (i = 1; i <= 13; i += 1) {
        if (g_who[i] == seat) {
            return i;
        }
    }
    return seat;
}

// 【说话人那一行的名字颜色】（用户 2026-10-07 报「换位后颜色不对」）：公聊 / 私聊 / 邪恶小窗
//   右上角弹的那一行按**位置**取色（不吃大厅自选色）；说书人那一格 = 粉 Color(255,105,180)（判据跟 BOTC_PlayerNameText
//   一致：位置 p 的 g_who[p] == g_teller）。原来这里用的是 PlayerGetColorIndex（大厅色）→ 现在 0 处。
color BOTC_SayColor (int seat) {
    int i;
    i = BOTC_PosOf(seat);
    if (g_who[i] == g_teller || i == 1) {
        return libNtve_gf_ConvertPlayerColorToColor(g_seatColor[1]);      // 【说书人 = 游戏原生粉】（用户 2026-10-14）：色号 15
    }
    return libNtve_gf_ConvertPlayerColorToColor(g_seatColor[i]);
}

// 把一行里出现的「玩家N」（以及「说书人：」这种说话人写法）全部换成上面那种显示 ----
//   聊天窗 / 私聊窗 / 日志页 / 投票统计 / 提示条都走这里，一行里提到几个人就都替掉。
//   ⚠ 用户 2026-09-19：原来是自己「找位置 + 切字符串」拼出来的，长提示里会把正文吃掉（只剩两个名字）；
//     现在改用原生 TextReplaceWord 做整词替换。
text BOTC_NameSubst (string line) {
    return BOTC_NameSubstText(StringToText(line));
}
text BOTC_PutWord (text t, string word, color c) {
    return TextReplaceWord(t, StringToText(word), TextWithColor(StringToText(word), c), c_stringReplaceAll, true);
}

// 关键词上色（用户 2026-09-19）：系统提示整行是灰的，但下面这些词保持自己的颜色。
//   ⚠【约定·用户 2026-09-21】新增任何文案（角色提示 / 角色能力表 / 名词页 / 公屏 / 私聊）都要走这一套：
//     · 面板文案走 BOTC_TipLines、角色能力表走显示时的 BOTC_KeyColor、聊天日志走 BOTC_LineText ---- 都是自动上色，
//       所以文案里直接写纯文本就行，不要自己手写 TextWithColor（除非要强调某个特殊词）。
//     · 但**新角色名 / 新关键词必须来这张表补一行**，否则那几行字不会上色（跟其它词一样是灰的）。
//   以后新加的系统提示只要走 BOTC_LineText，就会自动带上这套颜色，不用单独处理。
//   ⚠ 顺序有讲究：先长后短（「小恶魔」要在「恶魔」前面替），否则长词会被短词切坏。
//   ⚠【用户 2026-09-30】镇民身份与「镇民」关键词统一改成和外来者同款的天蓝 #00BFFF（原来是 #0000FF）。
