// 夜间唤醒之前的「非唤醒、非私聊」能力发放步骤（用户第 4 / 7 / 11 条）。
bool BOTC_PreGrantStep () {
    int q;
    int role;
    if (!g_isNight) {
        return false;
    }
    // 1. 失忆者首夜
    if (g_amneDoneNight <= 0) {
        q = BOTC_SeatOfRole(73);
        if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false) {
            g_amneDoneNight = 1;
            BOTC_AmnePickOpen(q);
            return true;
        }
    }
    // 2. 食人族：今天有人死于处决
    if (g_cannPending > 0) {
        g_cannPending = 0;
        q = BOTC_SeatOfRole(74);
        if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false) {
            g_cannDoneNight = g_nightNum;
            BOTC_CannPickOpen(q);
            return true;
        }
    }
    // 3. 变脸师：每晚一次
    q = BOTC_SeatOfRole(117);
    if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false && g_faceDoneNight != g_nightNum) {
        g_faceDoneNight = g_nightNum;
        BOTC_FacePickOpen(q);
        return true;
    }
    // 4. 小精灵：得知的镇民已经死亡，且还没用掉机会
    q = BOTC_SeatOfRole(91);
    if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false && g_pixieRoleBy[q] > 0 && !g_pixieDone[q]) {
        role = g_pixieRoleBy[q] - 1;
        if (g_pixieSeatBy[q] > 0 && BOTC_SeatDead(g_pixieSeatBy[q])) {
            g_pixieDone[q] = true;
            BOTC_PixieAskOpen(q, role);
            return true;
        }
    }
    return false;
}

void BOTC_SpecSeatRender () {
    int i;
    int x;
    string s;
    bool card;
    for (i = 0; i < 6; i += 1) {
        card = (g_specBluffOn && i < 3);
        if (card) {
            // 【身份卡】（用户 2026-11-04）：正方形，中间头像，左下角角色名
            x = 30 + (i * 120);
            DialogControlSetSize(g_specRoleBtn[i], PlayerGroupAll(), 100, 100);
            DialogControlSetPosition(g_specRoleBtn[i], PlayerGroupAll(), c_anchorTopLeft, x, 126);
            DialogControlSetSize(g_specRoleIcon[i], PlayerGroupAll(), 100, 100);
            DialogControlSetPosition(g_specRoleIcon[i], PlayerGroupAll(), c_anchorTopLeft, x, 126);
            DialogControlSetPosition(g_specRoleName[i], PlayerGroupAll(), c_anchorTopLeft, x + 4, 202);
            libNtve_gf_SetDialogItemText(g_specRoleBtn[i], StringToText(""), PlayerGroupAll());
            if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
                s = g_roleName[g_specRoleSel[i] - 1];
                libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], BOTC_IconName(g_specRoleSel[i] - 1), PlayerGroupAll());
            }
            else {
                s = "选身份";
                libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], "botc_blank.dds", PlayerGroupAll());
            }
            libNtve_gf_SetDialogItemText(g_specRoleName[i], StringToText(s), PlayerGroupAll());
            DialogControlSetVisible(g_specRoleIcon[i], PlayerGroupAll(), true);
            DialogControlSetVisible(g_specRoleName[i], PlayerGroupAll(), true);
        }
        else {
            x = 30 + (i * 180);
            DialogControlSetSize(g_specRoleBtn[i], PlayerGroupAll(), 160, 44);
            DialogControlSetPosition(g_specRoleBtn[i], PlayerGroupAll(), c_anchorTopLeft, x, 162);
            if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
                s = IntToString(i + 1) + "：" + g_roleName[g_specRoleSel[i] - 1];
            }
            else {
                s = IntToString(i + 1) + "：选身份";
            }
            libNtve_gf_SetDialogItemText(g_specRoleBtn[i], StringToText(s), PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], "botc_blank.dds", PlayerGroupAll());
            DialogControlSetVisible(g_specRoleIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_specRoleName[i], PlayerGroupAll(), false);
        }
    }
}

void BOTC_SpecSeatClear () {
    int i;
    for (i = 0; i < 6; i += 1) {
        libNtve_gf_SetDialogItemText(g_specSeatEdit[i], StringToText(""), PlayerGroupAll());
        g_specRoleSel[i] = 0;
    }
    BOTC_SpecSeatRender();
}

