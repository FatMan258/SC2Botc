    g_tipLine[570] = StringToText("【角色简介】");
    g_tipLine[571] = TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("保护着她邻近的玩家免于死亡......只要他们都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的。");
    g_tipLine[572] = StringToText("如果") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("邻近的两名存活玩家当前都是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("的，这两名玩家就都不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("不能");
    g_tipLine[573] = StringToText("杀死他们，") + TextWithColor(StringToText("教父"), Color(255, 69, 0)) + StringToText("和") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("也不行。如果他们被处决，也不会死亡。唯一的例外是") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("，");
