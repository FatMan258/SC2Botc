    g_tipLine[542] = StringToText("复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能不能在自己复活的当晚进行行动，取决于复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("本该在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("之前还是");
    g_tipLine[543] = StringToText("之后行动。如果复活的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("有「在你的首个夜晚」的能力，则会在") + TextWithColor(StringToText("教授"), Color(0, 191, 255)) + StringToText("重新入睡后立即");
    g_tipLine[544] = StringToText("被唤醒来使用这类能力。");
    g_tipLine[545] = StringToText("【规则细节】");
