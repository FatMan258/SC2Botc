    g_tipLine[692] = StringToText("不会死亡。");
    g_tipLine[693] = StringToText("【角色简介】");
    g_tipLine[694] = TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("能杀死") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("解决不掉的麻烦角色。");
    g_tipLine[695] = StringToText("每局游戏限一次，在夜晚，") + TextWithColor(StringToText("刺客"), Color(255, 69, 0)) + StringToText("能杀死一名玩家。即使该玩家受到了包括角色能力在内");
