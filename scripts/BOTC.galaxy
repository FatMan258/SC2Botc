    }
    if (c == g_hideBtn[p]) {
        BOTC_ToggleHide(p);
        return true;
    }
    if (c == g_expandBtn[p]) {
        BOTC_ToggleHide(p);
        return true;
    }
    if (c == g_logDlgBtn[p]) {
        BOTC_PanelToggle(p, 1);
        return true;
    }
    // 角色能力表
    if (c == g_abOpenBtn[p]) {
        BOTC_PanelToggle(p, 3);
        return true;
    }
    if (c == g_tipBtn[p]) {
        BOTC_PanelToggle(p, 6);
        return true;
    }
    if (c == g_noteOpenBtn[p]) {
        BOTC_PanelToggle(p, 5);
        return true;
    }
    if (c == g_noteClose[p]) {
        BOTC_NoteClose(p);
        return true;
    }
    if (c == g_abPrev) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        BOTC_AbilityRender(p);
        return true;
    }
    if (c == g_abNext) {
        if (g_abPage[p] < 2) {
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_AbilityRender(p);
        return true;
    }
    if (c == g_abListPrev2 || c == g_abPrev) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        BOTC_RoleListRender(p);
        return true;
    }
    if (c == g_abListNext2 || c == g_abNext) {
        if (g_abPage[p] < 2) {
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_RoleListRender(p);
        return true;
    }
    if (c == g_abNewClose[p]) {      BOTC_AbClose(p);         return true;     }
    for (q = 0; q < 4; q += 1) {
        if (c == g_abCatPrev[(p * 4) + q]) {
            if (g_abCatPage[(p * 4) + q] > 1) {
                g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] - 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
        if (c == g_abCatNext[(p * 4) + q]) {
            if (g_abCatPage[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_AbCatCap(q))) {
                g_abCatPage[(p * 4) + q] = g_abCatPage[(p * 4) + q] + 1;
            }
            BOTC_AbNewRender(p);
            return true;
        }
    }
    if (c == g_abSubPrev[p]) {
        if (g_abPage[p] == 3 && g_glossPage[p] > 1) {
            g_glossPage[p] = g_glossPage[p] - 1;
        }
        if (g_abPage[p] == 4 && g_jinxPage[p] > 1) {
            g_jinxPage[p] = g_jinxPage[p] - 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abSubNext[p]) {
        if (g_abPage[p] == 3 && g_glossPage[p] < ((g_glossCount + 5) / 6)) {
            g_glossPage[p] = g_glossPage[p] + 1;
        }
        if (g_abPage[p] == 4 && g_jinxPage[p] < BOTC_JinxPageCount(p)) {
            g_jinxPage[p] = g_jinxPage[p] + 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abNewPrev[p]) {
        if (g_abPage[p] > 1) {
            g_abPage[p] = g_abPage[p] - 1;
        }
        if (g_abPage[p] == 5) { g_jinxPage[p] = 1; }
        BOTC_AbNewRender(p);
        return true;
    }
    if (c == g_abNewNext[p]) {
        if (g_abPage[p] < 5) {
            if (g_abPage[p] == 3) { g_jinxPage[p] = 1; }
            g_abPage[p] = g_abPage[p] + 1;
        }
        BOTC_AbNewRender(p);
        return true;
    }
    for (q = 0; q < 22; q += 1) {
        if (c == g_abNewHit[(p * 26) + q]) {
            // 【剧本角色表 → 帮助详情】（用户 2026-11-04）：剧本角色表保持打开，帮助面板直接显示该角色详情
            g_tipForce[p] = g_abNewRole[(p * 26) + q];
            g_tipMode[p] = 1;
            BOTC_TipOpen(p);
            return true;
        }
    }
    if (c == g_abListClose2) {
        BOTC_AbClose(p);
        return true;
    }
    if (c == g_abClose) {
        BOTC_AbClose(p);
        return true;
    }
    for (q = 0; q < 22; q += 1) {
        if (c == g_abListIcon[q]) {
            BOTC_AbClose(p);                  // 先收起能力表（它建得晚，会盖住详情面板）
            g_tipForce[p] = g_abListRole[q];
            g_tipMode[p] = 1;                 // 【角色介绍】（用户 2026-11-04）：确保从场次统计/规则页点角色也能切回详情
            BOTC_TipOpen(p);
            return true;
        }
    }
    if (c == g_noUp[p]) {
        BOTC_NightOrderScroll(p, -6);
        return true;
    }
    if (c == g_noDown[p]) {
        BOTC_NightOrderScroll(p, 6);
        return true;
    }
    if (c == g_noClose[p]) {
        BOTC_AbClose(p);           // 统一关闭剧本角色表 / 夜间顺序两个视图
        return true;
    }
    if (c == g_abViewBtn[p]) {
        BOTC_AbViewNight(p);       // 左上角【夜间行动顺序】
        return true;
    }
    if (c == g_noViewBtn[p]) {
        BOTC_AbViewRole(p);        // 左上角【剧本角色】
        return true;
    }

    if (c == g_tipBtnRules) {
        g_tipMode[p] = 2;
        BOTC_TipRender(p);
        return true;
    }
    if (c == g_tipBtnStats) {
        g_tipMode[p] = 3;
        BOTC_TipRender(p);
        return true;
    }
    if (c == g_tipBtnWiki) {
        BOTC_WikiOpen(p);
        return true;
    }
    for (q = 0; q < 10; q += 1) {
        if (c == g_wikiCatBtn[q]) {
            g_wikiSel[p] = q;
            BOTC_WikiRender(p);
            return true;
        }
    }
    if (c == g_wikiClose) {
        g_wikiOpen[p] = false;
        DialogSetVisible(g_wikiDlg, PlayerGroupSingle(p), false);
        return true;
    }
    if (c == g_wikiArtBtn) {
        BOTC_ArtOpenPanel(p);
        return true;
    }
    for (q = 0; q < 10; q += 1) {
        if (c == g_artCatBtn[q]) {
            g_artSel[p] = q;
            BOTC_ArtRender(p);
            return true;
        }
    }
    if (c == g_artClose) {
        g_artOpen[p] = false;
        DialogSetVisible(g_artDlg, PlayerGroupSingle(p), false);
        return true;
    }
    if (c == g_artBack) {
        g_artOpen[p] = false;
        DialogSetVisible(g_artDlg, PlayerGroupSingle(p), false);
        BOTC_WikiOpen(p);
        return true;
    }
    if (c == g_tipClose) {
        BOTC_TipClose(p);
        return true;
    }
    if (c == g_tipBack) {
        // 【我的角色】（用户 2026-11-04）：回到自己的角色能力详情页，不再返回剧本角色表
        g_tipForce[p] = -1;
        g_tipMode[p] = 1;
        BOTC_TipRender(p);
        return true;
    }
    // 昼夜切换（只有说书人能按）
    if (c == g_nightBtn) {
        if (p == g_teller) {
            BOTC_NightToggle();
        }
        return true;
    }
    // 魔典相关（每个玩家一份，各自标记）
    if (c == g_grimOpenBtn[p]) {
        BOTC_PanelToggle(p, 2);
        return true;
    }
    if (c == g_rsOpenBtn) {
        if (p == g_teller) {
            BOTC_RsOpen(g_teller);
        }
        return true;
    }
    if (c == g_rsCloseBtn) {
        BOTC_RsClose(p);
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (c == g_rsCatPrev[q]) {
            BOTC_RsPageTurn(q, -1);
            return true;
        }
        if (c == g_rsCatNext[q]) {
            BOTC_RsPageTurn(q, 1);
            return true;
        }
    }
    if (c == g_rsRandomBtn) {
        BOTC_RsRandom(p);
        return true;
    }
    if (c == g_rsDealBtn) {
        BOTC_RsApply(p);
        return true;
    }
    for (q = 0; q < g_gridN; q += 1) {
        if (c == g_rsBtn[q]) {
            BOTC_RsToggle(p, q);
            return true;
        }
    }
    if (c == g_grimShare) {
        BOTC_ShareGrim(p);
        return true;
    }
    if (c == g_grimClose) {
        BOTC_GrimClose(p);
        return true;
    }
    if (c == g_grimDeal) {
        if (p == g_teller) {
            BOTC_Deal();
        }
        return true;
    }
    if (c == g_grimConfirm) {
        if (p == g_teller) {
            // 【确认下发 / 取消下发改成同一个按钮】（用户 2026-11-10）：已下发时点它 = 收回全部身份
            if (g_dealConfirmed) {
                BOTC_CancelDeal();
            }
            else {
                BOTC_ConfirmDeal();
            }
        }
        return true;
    }
    // 游戏正式开始 / 取消正式开始（只有说书人）
    if (c == g_grimStart) {
        if (p == g_teller) {
            if (g_started) {
                BOTC_GameStartCancel();
            }
            else {
                if (g_startPending) {
                    BOTC_GameStartCancel();      // 还在 10 秒倒数里：再点一下 = 把倒数撤掉
                }
                else {
                    BOTC_GameStart();
                }
            }
        }
        return true;
    }
    // 处决标记：按一下进入标记模式，再点座位盖上红叉
    if (c == g_execBtn) {
        if (p == g_teller) {
            BOTC_ExecMode();
        }
        return true;
    }
    // 死亡标记：按一下进入标记模式，再点座位盖上红叉
    if (c == g_deadBtn) {
        if (p == g_teller) {
            BOTC_DeadMode();
        }
        return true;
    }
    if (BOTC_WinAdminClick(p, c)) {
        return true;
    }
    if (c == g_declareBtn) {
        BOTC_DeclareClick(p);
        return true;
    }
    if (c == g_dclaimBtn) {
        BOTC_DClaimClick(p);
        return true;
    }


    // 【风雅集（板子 10）· 修行者（114）】（用户 2026-10-16）：两选一面板
    if (g_sgSeat >= 2) {
        if (c == g_sgB1) { BOTC_SgPick(p, 1); return true; }
        if (c == g_sgB2) { BOTC_SgPick(p, 2); return true; }
    }
    // 哈迪寂亚（87）：当前目标点「活着 / 死亡」（说书人也能替他点）
    if (g_hdActive && g_hdNow >= 0 && g_hdNow <= 2) {
        if (c == g_hdBtnLive[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 1); return true; }
        if (c == g_hdBtnDie[g_hdTar[g_hdNow]]) { BOTC_HdPick(p, 2); return true; }
    }
    // 【造谣者】公开声明输入框：确定 / 取消（用户 2026-09-20）
    if (c == g_gossipOk) {
        BOTC_GossipSubmit(p);
        return true;
    }
    if (c == g_gossipCancel) {
        DialogSetVisible(g_gossipDlg, PlayerGroupSingle(p), false);
        return true;
    }
    // 【杂耍艺人】5 组「座位号 + 身份」面板：确定 / 取消 / 5 个小按钮（用户 2026-09-21）
    if (c == g_juggOk) {
        BOTC_JugglerOk(p);
        return true;
    }
    if (c == g_juggCancel) {
        BOTC_JugglerCancel(p);
        return true;
    }
    if (c == g_juggRoleBtn[0]) { BOTC_JugglerPickRow(p, 1); return true; }
    if (c == g_juggRoleBtn[1]) { BOTC_JugglerPickRow(p, 2); return true; }
    if (c == g_juggRoleBtn[2]) { BOTC_JugglerPickRow(p, 3); return true; }
    if (c == g_juggRoleBtn[3]) { BOTC_JugglerPickRow(p, 4); return true; }
    if (c == g_juggRoleBtn[4]) { BOTC_JugglerPickRow(p, 5); return true; }
    if (c == g_alsaOk) {
        BOTC_AlsaahirSubmit(p);
        return true;
    }
    if (c == g_alsaCancel) {
        BOTC_AlsaahirCancel(p);
        return true;
    }
    for (q = 0; q < 12; q += 1) {
        if (c == g_alsaTypeBtn[q]) {
            BOTC_AlsaahirTypeClick(p, q);
            return true;
        }
    }
    if (c == g_taotieOk) {
        BOTC_TaotieSubmit(p);
        return true;
    }
    if (c == g_taotieCancel) {
        BOTC_TaotieNone(p);
        return true;
    }
    // 【真人说书 · 信息位答题框】（用户 2026-09-20）：确定 / 取消
    if (c == g_nobleOk) {
        BOTC_NobleSend();
        return true;
    }
    // 【右上角 X】（用户 2026-11-01）：贵族答题框直接关掉，什么都不发
    if (c == g_nobleX) {
        DialogSetVisible(g_nobleDlg, PlayerGroupSingle(g_teller), false);
        g_nobleSeat = 0;
        return true;
    }
    if (c == g_engBtn1) {
        if (g_engStage == 3) {
            if (p == BOTC_EngPlayer()) {
                BOTC_EngSubmit();
            }
            return true;
        }
        if (g_engStage == 4) {
            BOTC_EngAssign(0);
            return true;
        }
        if (g_engStage == 5) {
            BOTC_EngAssignOne(0);
            return true;
        }
        if (g_engStage == 0) {
            if (p != BOTC_EngPlayer()) {
                return true;
            }
            g_engMode = 3;
            g_engStage = 1;
            BOTC_EngGrid(p, 3);
        }
        return true;
    }
    if (c == g_engBtn2) {
        if (g_engStage == 3) {
            if (p == BOTC_EngPlayer()) {
                BOTC_EngCancel();
            }
            return true;
        }
        if (g_engStage == 4) {
            BOTC_EngAssign(1);
            return true;
        }
        if (g_engStage == 5) {
            BOTC_EngAssignOne(1);
            return true;
        }
        if (g_engStage == 0) {
            if (p != BOTC_EngPlayer()) {
                return true;
            }
            g_engMode = 2;
            g_engStage = 1;
            BOTC_EngGrid(p, 2);
        }
        return true;
    }
    if (c == g_engBtn3) {
        return true;
    }
    if (c == g_engClose) {
        BOTC_EngCancel();
        return true;
    }
    // 【右上角 X】（用户 2026-11-01）：工程师面板直接关掉，等同【关闭】
    if (c == g_engX) {
        BOTC_EngCancel();
        return true;
    }
    if (c == g_farmOk) {
        BOTC_FarmerSend();
        return true;
    }
    // 【右上角 X】（用户 2026-11-01）：农夫答题框直接关掉，什么都不发
    if (c == g_farmX) {
        DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), false);
        g_farmSeat = 0;
        g_farmViaLevi = false;
        return true;
    }
    if (c == g_miOk) {
        if (p == g_teller) {
            BOTC_ManInfoOk();
        }
        return true;
    }
    if (c == g_miCancel) {
        if (p == g_teller) {
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            BOTC_MiCancelApply();       // 军团那步点取消 = 不屏蔽（疯子看到所有队友）
        }
        return true;
    }
    // 【右上角 X】（用户 2026-11-01）：夜间答题框直接关掉，等同【取消】
    if (c == g_miX) {
        if (p == g_teller) {
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            BOTC_MiCancelApply();
        }
        return true;
    }
    if (c == g_miYes) {
        if (p == g_teller || (g_miRole == 813 && g_miSeat >= 2 && p == g_who[g_miSeat])) {
            BOTC_ManInfoYesNo(1);
        }
        return true;
    }
    if (c == g_miNo) {
        if (p == g_teller || (g_miRole == 813 && g_miSeat >= 2 && p == g_who[g_miSeat])) {
            BOTC_ManInfoYesNo(0);
        }
        return true;
    }
    // 【猎手请求】真人说书：是 / 否（说书人拍板）
    if (c == g_slayYes) {
        if (p == g_teller) {
            BOTC_SlayAnswer(1);
        }
        return true;
    }
    if (c == g_slayNo) {
        if (p == g_teller) {
            BOTC_SlayAnswer(0);
        }
        return true;
    }
    if (c == g_slayNo2) {
        if (p == g_teller) {
            BOTC_SlayAnswer(0);
        }
        return true;
    }
    // 【利维坦×陌客】（用户 2026-11-02）：是 = 按善良计入 / 否 = 不计入
    if (c == g_levRecYes) {
        if (p == g_teller) {
            BOTC_LevRecluseAnswer(1);
        }
        return true;
    }
    if (c == g_levRecNo || c == g_levRecX) {
        if (p == g_teller) {
            BOTC_LevRecluseAnswer(0);
        }
        return true;
    }
    // 【理发师】恶魔与死者互换（用户 2026-11-10）：是 = 允许交换 / 否、X = 让他重新选
    if (c == g_barAskYes) {
        if (p == g_teller) {
            BOTC_BarberAskAnswer(1);
        }
        return true;
    }
    if (c == g_barAskNo || c == g_barAskX) {
        if (p == g_teller) {
            BOTC_BarberAskAnswer(0);
        }
        return true;
    }
    // 【教父×陌客】（用户 2026-11-05）：是 = 算作外来者 / 否、X = 不算
    if (c == g_gfRecYes) {
        if (p == g_teller) {
            BOTC_GfRecluseAnswer(1);
        }
        return true;
    }
    if (c == g_gfRecNo || c == g_gfRecX) {
        if (p == g_teller) {
            BOTC_GfRecluseAnswer(0);
        }
        return true;
    }
    // 【政客（97）】（用户 2026-11-10）：是 = 转变阵营并获胜 / 否 = 不转变
    if (c == g_polYes) {
        if (p == g_teller) {
            BOTC_PoliticianAnswer(1);
        }
        return true;
    }
    if (c == g_polNo) {
        if (p == g_teller) {
            BOTC_PoliticianAnswer(0);
        }
        return true;
    }
    // 【和平主义者（33）· 处决弹窗】（用户 2026-11-06）：是 = 不死 / 否、X = 照常处决
    if (c == g_pacAskYes) {
        if (p == g_teller) {
            BOTC_PacifistAnswer(1);
        }
        return true;
    }
    if (c == g_pacAskNo || c == g_pacAskX) {
        if (p == g_teller) {
            BOTC_PacifistAnswer(0);
        }
        return true;
    }
    // 【异教领袖（106）· 夜间改阵营】（用户 2026-11-07）：左邻 / 右邻 / X = 不改变
    if (c == g_cultChL) {
        if (p == g_teller) {
            BOTC_CultChoiceAnswer(1);
        }
        return true;
    }
    if (c == g_cultChR) {
        if (p == g_teller) {
            BOTC_CultChoiceAnswer(2);
        }
        return true;
    }
    if (c == g_cultChX) {
        if (p == g_teller) {
            BOTC_CultChoiceAnswer(0);
        }
        return true;
    }
    // 【麻脸巫婆二次确认】（用户 2026-11-03）：是 = 确认改造 / 否 = 让她重选 / X = 不改造（唯一恶魔那条也是）
    if (c == g_hagAskYes) {
        if (p == g_teller) {
            BOTC_HagAskAnswer(1);
        }
        return true;
    }
    if (c == g_hagAskNo) {
        if (p == g_teller) {
            BOTC_HagAskAnswer(0);
        }
        return true;
    }
    if (c == g_hagAskX) {
        if (p == g_teller) {
            BOTC_HagAskAnswer(-1);
        }
        return true;
    }
    // 【精神病患者 · 处决猜拳】（用户 2026-11-03）
    if (c == g_rpsRock) {
        BOTC_PsyRpsChoose(p, 1);
        return true;
    }
    if (c == g_rpsScissors) {
        BOTC_PsyRpsChoose(p, 2);
        return true;
    }
    if (c == g_rpsPaper) {
        BOTC_PsyRpsChoose(p, 3);
        return true;
    }
    // 【镇长请求】真人说书：是 / 否（说书人拍板）
    if (c == g_mayorYes) {
        if (p == g_teller) {
            BOTC_MayorAnswer(1);
        }
        return true;
    }
    if (c == g_mayorNo) {
        if (p == g_teller) {
            BOTC_MayorAnswer(0);
        }
        return true;
    }
    // 【快进到提名】投票（只有玩家 2..13 有这个按钮；说书人那边是只读票数）
    if (c == g_skipBtn) {
        BOTC_SkipClick(BOTC_PosOf(p));
        return true;
    }
    // 邪恶玩家自己的【伪装身份】：给自己选一个善良身份当掩护
    if (c == g_claimBtnP[p]) {
        BOTC_ClaimOpen(p, BOTC_PosOf(p));
        return true;
    }

    // 说书人：【唤醒】按钮（自由阶段也能用 ---- 晚上就在这个阶段）
    //   夜里 g_phase 通常是 0，会走到这里；必须和 BOTC_ClickDo 里的同名分支一样走
    //   BOTC_WakeBtnPress()，否则【结束手动唤醒】点了只会往下唤醒，按钮文字卡住不变。
    if (c == g_wakeBtn) {
        if (p == g_teller) {
            BOTC_WakeBtnPress();
        }
        return true;
    }
    if (c == g_wakeManualBtn) {
        if (p == g_teller) {
            BOTC_WakeManualToggle();
        }
        return true;
    }
    if (c == g_pdBtn) {
        if (p == g_teller) {
            BOTC_PlagueDoctorAct();
        }
        return true;
    }
    if (c == g_organYes || c == g_organNo) {
        if (g_organSeat >= 1 && p == g_who[g_organSeat]) {
            if (c == g_organYes) {
                BOTC_OrganChoose(1);
            }
            else {
                BOTC_OrganChoose(0);
            }
        }
        return true;
    }
    if (c == g_alcSpyBtn || c == g_alcWidowBtn || c == g_alcCancelBtn) {
        if (g_alcChoice[p]) {
            if (c == g_alcSpyBtn) {
                BOTC_AlchemistPickRole(p, 18);
            }
            else if (c == g_alcWidowBtn) {
                BOTC_AlchemistPickRole(p, 75);
            }
            else {
                BOTC_AlchemistPickRole(p, 0);
            }
        }
        return true;
    }
    if (c == g_specGrantBtn) {
        if (p == g_teller) {
            BOTC_SpecClose();
            BOTC_GrantOpen();
        }
        return true;
    }
    if (c == g_grantRoleBtn) {
        if (p == g_teller) {
            BOTC_GrantRoleOpen();
        }
        return true;
    }
    if (c == g_grantDrunkBtn) {
        if (p == g_teller) {
            BOTC_GrantDrunkToggle();
        }
        return true;
    }
    if (c == g_grantOk) {
        if (p == g_teller) {
            BOTC_GrantApply();
        }
        return true;
    }
    if (c == g_grantRecycleBtn) {
        if (p == g_teller) {
            BOTC_GrantRecycle();
        }
        return true;
    }
    if (c == g_grantClose) {
        if (p == g_teller) {
            BOTC_GrantClose();
        }
        return true;
    }
    // 【发送特定信息】（用户 2026-10-10）：按钮 → 打开小面板；面板里的两条 → 进入「点收件人」模式
    if (c == g_specBtn) {
        if (p == g_teller) {
            BOTC_SpecOpen();
        }
        return true;
    }
    if (c == g_specBtn1) {
        if (p == g_teller) {
            g_specMode = 1;
            DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
            BOTC_Notice(g_teller, "【自定义文本】点一个玩家的座位 = 收件人 → 输入文本后自动加「你得知」发送。");
        }
        return true;
    }
    if (c == g_specBtn2) {
        if (p == g_teller) {
            g_specMode = 2;
            DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
            BOTC_Notice(g_teller, "【玩家号 + 身份】点一个玩家的座位 = 收件人 → 填最多 6 个玩家号，并可选择最多 6 个身份。");
        }
        return true;
    }
    if (c == g_specRecogBtn) {
        if (p == g_teller) {
            BOTC_SpecClose();
            BOTC_SendRecognize();
        }
        return true;
    }
    if (c == g_specQuickBtn) {
        if (p == g_teller) {
            BOTC_SpecClose();
            BOTC_QuickRecognize();
        }
        return true;
    }
    if (c == g_specCastBtn) {
        if (p == g_teller) {
            BOTC_TellerCastOpen();
        }
        return true;
    }
    if (c == g_specMarkBtn) {
        if (p == g_teller) {
            BOTC_SpecClose();
            g_markUseMode = true;
            BOTC_NoticeKeep(g_teller, "【标记能力使用】点一个圆桌座位：该角色有对应的「失去能力」token 就自动打上，已经有则取消。");
        }
        return true;
    }
    if (c == g_recogOk) {
        if (p == g_teller) {
            BOTC_RecogSend();
        }
        return true;
    }
    if (c == g_recogCancel) {
        if (p == g_teller) {
            BOTC_RecogClose();
        }
        return true;
    }
    for (q = 0; q < 6; q += 1) {
        if (c == g_specRoleBtn[q]) {
            if (p == g_teller) {
                BOTC_SpecRoleOpen(q);
            }
            return true;
        }
    }
    if (c == g_specInfoClear) {
        if (p == g_teller) {
            // 【发送不在场身份】（用户 2026-11-04）：模式 6 / 8 的这颗键改成【随机 3 个】
            if (g_specMode == 6 || g_specMode == 8) {
                BOTC_SpecBluffRoll();
            }
            else {
                BOTC_SpecSeatClear();
            }
        }
        return true;
    }
    if (c == g_specInfoOk) {
        if (p == g_teller) {
            BOTC_SpecSeatSend();
        }
        return true;
    }
    if (c == g_specClose) {
        if (p == g_teller) {
            BOTC_SpecClose();
        }
        return true;
    }
    // 【手动发送不在场身份 · 独立面板】（用户 2026-11-04）
    for (q = 0; q < 3; q += 1) {
        if (c == g_mbRoleBtn[q]) {
            if (p == g_teller) {
                BOTC_SpecRoleOpen(q);
            }
            return true;
        }
    }
    if (c == g_mbRollBtn) {
        if (p == g_teller) {
            BOTC_MBluffRoll();
        }
        return true;
    }
    if (c == g_mbSendBtn) {
        if (p == g_teller) {
            BOTC_MBluffSend();
        }
        return true;
    }
    if (c == g_mbCancelBtn) {
        if (p == g_teller) {
            BOTC_MBluffCancel();
        }
        return true;
    }
    // 【首夜不在场身份弹窗】（用户 2026-11-04）：随机 / 发送 / 取消 / 手动选角色
    //   （用户 2026-11-04 反馈「按钮全都按不了」）：这段原先只写在提名阶段块里，
    //   而首夜弹窗出现在自由阶段（g_phase == 0），所以这里必须再挂一份。
    if (c == g_bluffAskRollBtn) {
        if (p == g_teller) {
            BOTC_BluffAskRoll();
        }
        return true;
    }
    if (c == g_bluffAskSendBtn) {
        if (p == g_teller) {
            BOTC_BluffAskSend();
        }
        return true;
    }
    if (c == g_bluffAskCancelBtn) {
        if (p == g_teller) {
            BOTC_BluffAskCancel();
        }
        return true;
    }
    for (q = 0; q < 3; q += 1) {
        if (c == g_bluffAskBtn[q]) {
            if (p == g_teller) {
                BOTC_BluffAskPick(q);
            }
            return true;
        }
    }
    // 【异教领袖（106）· 教派投票】（用户 2026-10-10）：全员 20 秒投票 / 弃权
    if (c == g_cultYes) {
        BOTC_CultVoteAt(BOTC_PosOf(p), 1);
        return true;
    }
    if (c == g_cultNo) {
        BOTC_CultVoteAt(BOTC_PosOf(p), 2);
        return true;
    }
    // 被唤醒玩家的【使用技能】与目标面板

    // 【控件按格子索引】（用户 2026-10-07「确认按钮无效」）：面板是按格子建/发的，点击事件给的是物理座位 → 一律转成 BOTC_PosOf(p)
    if (c == g_skillBtn[BOTC_PosOf(p)]) {
        // 间谍没有目标可选：点技能直接把说书人那份魔典摊给他看
        // 【按「实际发动的能力」判】（用户 2026-11-09）：借到间谍能力的人也要能点开
        if (BOTC_ActRoleOf(BOTC_PosOf(p)) == 18) {
            BOTC_SpyPeek(BOTC_PosOf(p));
        }
        else {
            // 【寡妇（75）】（用户 2026-09-23）：首个夜晚点技能 = 看一眼魔典，再点一个人下毒
            if (BOTC_ActRoleOf(BOTC_PosOf(p)) == 75) {
            // 【寡妇顺序】（用户 2026-11-06）：先看魔典 → 选是否抄录 → 选完再进下毒面板
            if (!BOTC_WidowPeek(BOTC_PosOf(p))) {
                BOTC_SkillOpen(BOTC_PosOf(p));
            }
            }
            else {
                BOTC_SkillOpen(BOTC_PosOf(p));
            }
        }
        return true;
    }
    if (c == g_skillSlotA[BOTC_PosOf(p)]) {
        g_skillT1[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillSlotB[BOTC_PosOf(p)]) {
        if (BOTC_ComboRole(BOTC_ActRoleOf(BOTC_PosOf(p)))) {
            BOTC_ComboRoleOpen(BOTC_PosOf(p));
            return true;
        }
        g_skillT2[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillSlotC[BOTC_PosOf(p)]) {
        g_skillT3[BOTC_PosOf(p)] = 0;
        BOTC_SkillRender(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillNoPick[BOTC_PosOf(p)]) {
        BOTC_SkillCancel(BOTC_PosOf(p));           // 旧按钮兼容；珀改用前置询问后不会再显示
        return true;
    }

    if (c == g_skillOk[BOTC_PosOf(p)]) {
        BOTC_SkillConfirm(BOTC_PosOf(p));
        return true;
    }
    if (c == g_skillCancel[BOTC_PosOf(p)]) {
        BOTC_SkillCancel(BOTC_PosOf(p));
        return true;
    }
    // 【身份阵营勾选】（用户 2026-10-21）：只有说书人改玩家身份时显示，两个按钮互斥。
    if (c == g_pickGoodBtn) {
        if (p == g_teller) {
            BOTC_PickAlignToggle(0);
        }
        return true;
    }
    if (c == g_pickEvilBtn) {
        if (p == g_teller) {
            BOTC_PickAlignToggle(1);
        }
        return true;
    }
    // 【认知偏差】（用户 2026-11-09）：酒鬼 / 疯子 / 悟道者 / 提线木偶，互斥。
    if (c == g_pickCogBtn[0]) {
        if (p == g_teller) {
            BOTC_PickCogToggle(0);
        }
        return true;
    }
    if (c == g_pickCogBtn[1]) {
        if (p == g_teller) {
            BOTC_PickCogToggle(1);
        }
        return true;
    }
    if (c == g_pickCogBtn[2]) {
        if (p == g_teller) {
            BOTC_PickCogToggle(2);
        }
        return true;
    }
    if (c == g_pickCogBtn[3]) {
        if (p == g_teller) {
            BOTC_PickCogToggle(3);
        }
        return true;
    }
    if (c == g_pickClose) {
        // 【变脸师·永久失去】（用户 2026-11-12）：右下角按钮改为永久停止询问
        if (g_pickMode[p] == 48) {
            BOTC_FaceLoseNow(p);
            return true;
        }
        BOTC_PickAbortAttach(p);                   // 获得能力面板被关掉 = 放弃这次获得
        BOTC_GambleCancel(BOTC_PosOf(p));          // 赌徒猜角色模式下：算「取消猜测」
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        if (g_pickMode[p] == 54) {
            BOTC_HatRoleAbort(p);                  // 【帽匠】关掉角色网格 = 这一位不换
        }
        return true;
    }
    // 【屏蔽】（用户 2026-11-06）：身份面板里点【屏蔽】= 关面板 + 进入魔典屏蔽模式
    //   【身份标记面板】（用户 2026-11-07）：已经有明确目标 → 直接屏蔽 / 解除屏蔽正在看的这名玩家；
    //   声称/猜测等没有目标的网格 → 仍进入「点一个座位屏蔽 / 解除屏蔽」流程。
    if (c == g_blockBtnPick) {
        BOTC_PickAbortAttach(p);
        BOTC_GambleCancel(BOTC_PosOf(p));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        if (g_pickMode[p] == 0) {
            if (g_who[g_pickWho[p]] < 1) {
                BOTC_Notice(p, "这个座位现在没有玩家。");
            }
            else {
                BOTC_BlockToggle(p, g_who[g_pickWho[p]]);
            }
        }
        else {
            BOTC_BlockStart(p);
        }
        return true;
    }
    // 【踢出玩家】（用户 2026-11-07）：关面板 + 对 g_pickWho[p] 发起已有的投票踢人
    if (c == g_kickBtnPick) {
        BOTC_PickAbortAttach(p);
        BOTC_GambleCancel(BOTC_PosOf(p));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
        BOTC_KickBtnPickDo(p);
        return true;
    }
    // 【左上角分类按钮 / 左下角单类翻页】（用户 2026-11-03）
    for (q = 0; q < 4; q += 1) {
        if (c == g_pickCatBtn[q]) {
            BOTC_PickCatSet(p, q);
            return true;
        }
    }
    if (c == g_pickPagePrev) {
        BOTC_PickPageMove(p, -1);
        return true;
    }
    if (c == g_pickPageNext) {
        BOTC_PickPageMove(p, 1);
        return true;
    }
    for (q = 0; q < 4; q += 1) {
        if (c == g_pickCatPrev[q]) {
            if (g_pickCatPageBy[(p * 4) + q] > 1) {
                g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] - 1;
            }
            g_pickTeam = g_pickFilterTeam[p];
            g_pickAlign = g_pickFilterAlign[p];
            BOTC_PickFilter(p, g_pickFilterGood[p]);
            return true;
        }
        if (c == g_pickCatNext[q]) {
            if (g_pickCatPageBy[(p * 4) + q] < BOTC_GridCatPages(q, BOTC_GridCatCap(q))) {
                g_pickCatPageBy[(p * 4) + q] = g_pickCatPageBy[(p * 4) + q] + 1;
            }
            g_pickTeam = g_pickFilterTeam[p];
            g_pickAlign = g_pickFilterAlign[p];
            BOTC_PickFilter(p, g_pickFilterGood[p]);
            return true;
        }
    }
    if (c == g_pickClear) {
        BOTC_PickChoose(p, -1);
        return true;
    }
    for (q = 0; q < 64; q += 1) {
        if (c == g_pickBtn[q]) {
            BOTC_PickChoose(p, q);
            return true;
        }
    }
    // 打 token（＋ 开面板 / 面板里的 20 个按钮 / 清除全部 / 关闭）：抽成函数，提名阶段那边也调它
    if (BOTC_TokClick(p, c)) {
        return true;
    }
    // 【说书人格不能标记角色】（用户 2026-11-06）：改用【说书人工具 → 使用技能】。
    if (p == g_teller && (c == g_saySeatBtn || c == g_saySeatLbl)) {
        BOTC_Notice(p, "说书人的格子不能标记角色。请用【说书人工具 → 使用技能】。");
        return true;
    }
    for (q = 2; q <= 13; q += 1) {
        if (c == g_grimSeat[q]) {
            // 【邀请加入】（用户 2026-11-04）：当前私聊的房主在选人 → 点谁就向谁发出加入邀请
            if (g_invitePick && p == g_inviteBy) {
                BOTC_InviteAt(q);
                return true;
            }
            // （寡妇改成走标准选目标面板了，这里不再「一点就中毒」：用户 2026-09-23）
            BOTC_PickOpen(p, q);
            return true;
        }
    }

    if (c == g_logPubBtn) {
        BOTC_LogSetMode(p, 0);
        return true;
    }
    if (c == g_logPmBtn) {
        BOTC_LogSetMode(p, 1);
        return true;
    }
    if (c == g_logVoteBtn) {
        BOTC_LogSetMode(p, 2);
        return true;
    }
    if (c == g_logSysBtn) {
        BOTC_LogSetMode(p, 3);
        return true;
    }
    // 【全部私聊】（2026-11-09）：说书人专用
    if (c == g_logAllPmBtn) {
        BOTC_LogSetMode(p, 4);
        return true;
    }
    // 【复盘】（用户 2026-11-11）：结算后查看本局完整记录
    if (c == g_rpBtn) {
        BOTC_LogSetMode(p, 5);
        return true;
    }
    // 【下拉里的行】（用户 2026-10-07）：列表框又改回轮询判定（BOTC_LogMenuTick），这里不用管
    if (c == g_logViewBtn) {
        BOTC_LogPickStart(p);
        return true;
    }
    if (c == g_logClose) {
        BOTC_LogClose(p);
        return true;
    }
    if (c == g_pmSend[p]) {
        BOTC_SendPm(p);
        return true;
    }
    // 邪恶小窗：发消息
    if (c == g_evilSend) {
        BOTC_EvilSend(p);
        return true;
    }
    if (c == g_tmHideBtn || c == g_tmExpandBtn) {
        if (p == g_teller) {
            BOTC_TimerToggle();
        }
        return true;
    }
    if (c == g_tmBtnGo) {
        if (p == g_teller) {
            BOTC_TimerStart();
        }
        return true;
    }
    if (c == g_tmBtnStop) {
        if (p == g_teller) {
            BOTC_TimerStop();
        }
        return true;
    }
    if (c == g_sayBtnP[p]) {
        BOTC_SayToggle(p);
        return true;
    }
    if (c == g_leaveBtn[p]) {
        // 【夜晚不能主动退私聊】（用户 2026-10-04）：夜里除说书人外，点【退出私聊】不生效
        if (g_isNight && p != g_teller && g_mySess[p] != 0) {
            BOTC_Notice(p, "现在是夜晚：不能主动退出私聊，等说书人来结束这次私聊。（公聊 / 私聊切换不受影响）");
            return true;
        }
        BOTC_Leave(p);
        return true;
    }
    if (c == g_joinBtn[p]) {
        BOTC_PmPickStart(p);       // 用户 2026-09-19：改成开魔典上点座位选人
        return true;
    }
    if (c == g_joinPopBtn[p]) {
        BOTC_RequestJoin(p);       // 用列表里选中的那条私聊去申请加入
        return true;
    }
    // 【私聊横向查看】（用户 2026-11-04）：左右按钮翻看成员名字
    if (c == g_sessPrevBtn[p]) {
        BOTC_SessNavStep(p, -1);
        return true;
    }
    if (c == g_sessNextBtn[p]) {
        BOTC_SessNavStep(p, 1);
        return true;
    }
    if (c == g_inviteBtn[p]) {
        BOTC_InviteStart(p);
        return true;
    }
    if (c == g_dissolveBtn[p]) {
        BOTC_DissolveStart(p);
        return true;
    }
    if (c == g_reqYes[p]) {
        BOTC_OnYes(p);
        return true;
    }
    if (c == g_reqNo[p]) {
        BOTC_OnNo(p);
        return true;
    }
    // 不在场身份面板
    for (q = 0; q < 3; q += 1) {
        if (c == g_bluffSeat[q]) {
            if (p == g_teller) {
                BOTC_BluffOpenPick(p, q);
            }
            return true;
        }
    }
    if (c == g_bluffRollBtn) {
        if (p == g_teller) {
            BOTC_BluffRoll();
        }
        return true;
    }
    if (c == g_bluffSendBtn) {
        if (p == g_teller && g_started) {
            BOTC_BluffSendStart();
        }
        return true;
    }
    if (c == g_bluffSendAllBtn) {
        if (p == g_teller && g_started) {
            if (BOTC_BluffTgtNeed()) {
                // 【再点 = 关闭】（用户 2026-11-08）：目标弹窗已经打开时再点同一按钮直接收起。
                if (DialogIsVisible(g_bluffTgtDlg, g_teller)) {
                    BOTC_BluffTgtClose();
                }
                else {
                    BOTC_BluffTgtOpen();
                }
            }
            else {
                BOTC_BluffSendToDemons();
            }
        }
        return true;
    }
    if (c == g_bluffTgtBtn[0]) {
        if (p == g_teller) {
            BOTC_BluffTgtClose();
            BOTC_BluffSendToDemons();
        }
        return true;
    }
    if (c == g_bluffTgtBtn[1]) {
        if (p == g_teller) {
            BOTC_BluffTgtClose();
            BOTC_BluffSendToAllMinions();
        }
        return true;
    }
    if (c == g_bluffTgtBtn[2]) {
        if (p == g_teller) {
            BOTC_BluffTgtClose();
            BOTC_BluffSendToAllLunatics();
        }
        return true;
    }
    if (c == g_bluffTgtCancelBtn) {
        if (p == g_teller) {
            BOTC_BluffTgtClose();
        }
        return true;
    }
    return true;
}

// 【点界面】的入口：包一层只是为了打着 g_inClick 标记 ——
//   处理点击期间冒出来的提示只走提示条、不写进私聊日志（用户 2026-09-30：点按钮刷屏太多）。
bool BOTC_Click_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_ClickDo(testConds, runActions);
    g_inClick = false;
    return r;
}

// 【开发/测试指令】谁能用聊天里的那些调试指令：
//   说书人位（玩家1）、玩家2，以及**智能说书模式下的玩家3** ---- 因为「玩家1 是电脑」那种测试局里，
//   坐在玩家2 的那位，原生座位号其实是 3（界面标签才是「玩家2」）。
//==================================================================================================
// 【测试】说书人自己拿身份试技能（用户 2026-09-20）
//   玩家1 没有座位，所以这里用「观察者 1 的座位 1」（g_mark[(g_teller * 14) + 1]）当说书人自己的身份格：
//   技能按钮 / 技能面板初始化时本来就给 p = 1..13 都建过，所以只要显示给玩家1 自己就行；
//   点了【使用技能】之后的流程跟普通玩家完全一样（点魔典上的座位选目标 → 确认）。
//   这一格不参与配板 / 胜负 / 座位表（那些只扫 2..13），换局会一起清掉。
//   指令：-t（弹身份网格点一个身份）／ -t off（关掉、清空）
//==================================================================================================
void BOTC_TestSelfRole (int r) {
    if (r < 0 || r > 163) {
        // 关掉
        g_testSelfOn = false;
        g_mark[(g_teller * 14) + 1] = 0;
        g_awake[1] = false;
        g_skillPicking[1] = false;
        g_limitedAsk[1] = false;
        g_poAsk[1] = false;
        g_skillRoleSel[1] = 0;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_GrimRender(g_teller);
        return;
    }
    g_testSelfOn = true;
    g_mark[(g_teller * 14) + 1] = r + 1;
    g_awake[1] = true;                  // 直接算「被唤醒」（不走唤醒判定，方便随便试）
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillPicking[1] = false;
    BOTC_GrimRender(g_teller);
    // 【新角色一律同时接「说书人自己那一格」】（用户 2026-09-21 定的规矩；2026-09-26 起这是常规功能，不再是测试）：
    //   拿到的角色如果用「祖母式面板」，选完就直接把那块面板弹出来，跟真人唤醒流程完全一致，不用再点【使用技能】。
    if (r == 56) {
        DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), true);
        BOTC_PhiloOpen(BOTC_PosOf(g_teller));
    }
    else {
        // 【镜像双子（64）】：配对只有说书人知道 → 直接弹「座位号 + 身份」面板
        if (r == 64) {
            DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
            BOTC_MiFnOpen(1, 23);
        }
        else {
            // 【洗脑师（66）/ 麻脸巫婆（67）】：两个都是玩家自己填 ----
            //   他们照常点【使用技能】选目标、再自己从身份网格里选身份，这里只把技能按钮露出来。
            DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), false);
            if ((g_roleTargets[r] > 0 || r == 18 || r == 151) && !(r == 119 && g_nightNum >= 2)) { DialogSetVisible(g_skillBtnDlg[1], PlayerGroupSingle(g_teller), true); }   // 逆臣：只有首夜；熊孩子虽然是角色网格，也必须有测试按钮
        }
    }
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
}

// 【测试】弹身份网格：点一个图标 = 说书人自己拿那个身份（复用现成的身份面板，模式 6）
void BOTC_TestSelfOpen () {
    g_pickMode[g_teller] = 6;
    BOTC_GridPlan();               // 保险：先按当前板子把格子重算一遍（跟选身份面板一致）
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("说书人自己拿一个身份（点一个图标）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个身份图标：说书人自己就拿这个身份，之后点【使用技能】试技能。");
}

bool BOTC_DevPlayer (int p) {
    // 单一正式脚本：测试指令固定关闭。
    return false;
}

// 【私聊测试】（用户 2026-09-22）：把「-pm 2 3」里那一对玩家号拆出来，直接让他们开一个私聊。
//   参数 = 星际里的玩家号（2..13）；玩家 1 是说书人，不参与。
//   字符串下标口径拿不准（历史上 StringSub 按字符认数字翻过车），所以两个位置都试一下，读得出来的才算。
void BOTC_TestPmPair (string arg) {
    int sp;
    int a;
    int b;
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-pm 2 3（两个星际玩家号，2~13）");
        return;
    }
    a = StringToInt(StringSub(arg, 0, sp));
    if (a < 2 || a > 13) {
        a = StringToInt(StringSub(arg, 0, sp - 1));
    }
    b = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    if (b < 2 || b > 13) {
        b = StringToInt(StringSub(arg, sp + 2, StringLength(arg)));
    }
    if (a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-pm 2 3（两个星际玩家号，2~13，且不能相同）");
        return;
    }
    BOTC_CreateSess(a, b);
    BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(BOTC_PosOf(a)) + " 和 " + BOTC_NameStr(BOTC_PosOf(b)) + " 的私聊已建立。");
}

// 【提名测试】（用户 2026-09-22）：直接让「玩家 a」提名「玩家 b」----
//   没在提名环节里会先把环节开起来；发起人死了 / 今天已经提名过 / 目标今天已被提名过，
//   都会把原因报给说书人（BOTC_NomWant / BOTC_NomPick 自己会发提示）。
void BOTC_TestNominate (int a, int b) {
    if (g_phase != 1 && g_phase != 2) {
        BOTC_NomOpen();
        BOTC_Notice(g_teller, "【测试】先把提名环节开起来了。");
    }
    BOTC_NomWant(a);
    if (g_nomPickBy != a) {
        BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(a) + " 现在不能发起提名（原因看上面那条提示）。");
        return;
    }
    BOTC_NomPick(a, b);
    if (g_nomFrom == a && g_nomTo == b) {
        BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(a) + " 提名 " + BOTC_NameStr(b) + " 已发起。");
    }
    else {
        BOTC_Notice(g_teller, "【测试】这次提名没成立（目标可能今天已经被提名过）。");
    }
}

// 【提名测试】把「-nom 2 3」里那一对玩家号拆出来（跟 -pm 一样的解析口径）
void BOTC_TestNomPair (string arg) {
    int sp;
    int a;
    int b;
    sp = StringFind(arg, " ", false);
    if (sp < 0) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-nom 2 3（发起人 目标，星际玩家号 2~13）");
        return;
    }
    a = StringToInt(StringSub(arg, 0, sp));
    if (a < 2 || a > 13) {
        a = StringToInt(StringSub(arg, 0, sp - 1));
    }
    b = StringToInt(StringSub(arg, sp + 1, StringLength(arg)));
    if (b < 2 || b > 13) {
        b = StringToInt(StringSub(arg, sp + 2, StringLength(arg)));
    }
    if (a < 2 || a > 13 || b < 2 || b > 13) {
        BOTC_Notice(g_teller, "读到的是「" + arg + "」。用法：-nom 2 3（发起人 目标，星际玩家号 2~13）");
        return;
    }
    BOTC_TestNominate(a, b);
}

// 【测试·唤醒某个座位】（用户 2026-10-09）：`-wake 3` = 模拟"手动唤醒模式里点了魔典上的座位 3"。
//   直接调点击分发里同一支用的 BOTC_WakeManualAt（不必先点【手动唤醒】），
//   所以唤醒 / 弹技能面板 / 发系统私聊 走的是**完全相同**的一条路；再发一次同一条 = 收回。
//   ⚠ 座位号用**魔典上的编号**（1~12）；内部格子 = 编号 + 1。
void BOTC_TestWakeAt (int p, string arg) {
    int i;
    int n;
    int v;
    int q;
    bool was;
    // 【容错解析】（用户 2026-10-09 反馈「指令无效」）：不看空格 ---- 从第 2~9 个字符挨个试读，
    //   第一个能读成 1~12 的就当座位号。这样 "-wake3" / "-wake 3" / 全角空格的 "-wake　3" /
    //   "/wake 3" / "-唤醒 3" 全都认。
    n = 0;
    for (i = 2; i <= 9; i += 1) {
        if (n > 0 || i > StringLength(arg)) {
            continue;
        }
        v = StringToInt(StringSub(arg, i, StringLength(arg)));
        if (v >= 1 && v <= 12) {
            n = v;
        }
    }
    if (n < 1) {
        BOTC_Notice(p, "读到的是「" + arg + "」。用法：-wake 1 ~ -wake 12（魔典上的座位编号；再发一次同一条 = 收回）。");
        return;
    }
    q = n + 1;                       // 座位号 n → 格子 n+1
    if (!g_seatOn[q]) {
        BOTC_Notice(p, "座位 " + IntToString(n) + " 上没有真人。");
        return;
    }
    was = g_awake[q];
    BOTC_PmStore(p, "【测试·唤醒】-wake " + IntToString(n) + " → 座位 " + IntToString(n)
        + "（" + BOTC_NameStr(q) + "，物理座位 " + IntToString(g_who[q])
        + "，身份 " + BOTC_SeatRoleStr(q) + "）");
    if (was) {
        BOTC_PmStore(p, "【测试·唤醒】他此刻**是醒的** → 这一下走「收回」：面板收掉 + 私聊「说书人收回了你的技能」发给他。");
    }
    else {
        if (BOTC_SeatIsComputer(q)) {
            BOTC_PmStore(p, "【测试·唤醒】这一格是**电脑**：屏幕上看不到面板（脚本会替他自动选目标）。");
        }
        else {
            BOTC_PmStore(p, "【测试·唤醒】这一下应该：① 技能面板弹给他 ② 系统私聊「【夜晚】你被唤醒了。」也发给他（物理座位 " + IntToString(g_who[q]) + "）；别人那儿不该出现。");
        }
    }
    BOTC_WakeManualAt(q);            // ← 跟"手动唤醒模式里点这个座位"完全同一条路
    if (g_awake[q]) {
        BOTC_PmStore(p, "【测试·唤醒】调用完成：awake = true。");
    }
    else {
        BOTC_PmStore(p, "【测试·唤醒】调用完成：awake = false（没唤醒 / 刚被收回）。");
    }
    if (g_skillPicking[q]) {
        BOTC_PmStore(p, "【测试·唤醒】他现在是「选目标」状态：技能面板已打开，等他点座位再点【确认】。");
    }
}
// 【测试·替玩家 1 电脑选板】（用户 2026-10-20）：玩家 1 是电脑时不会自己点板子，
// 开发 / 测试位发 `-board 1` ～ `-board 10` 即可走正常选板流程；也认 `-板子 / -选板`。
void BOTC_TestBoardAt (int p, string arg) {
    int i;
    int n;
    int v;
    n = 0;
    for (i = 2; i <= 15; i += 1) {
        if (n > 0 || i > StringLength(arg)) {
            continue;
        }
        v = StringToInt(StringSub(arg, i, StringLength(arg)));
        if (v >= 1 && v <= 15) {
            n = v;
        }
    }
    if (n < 1) {
        BOTC_Notice(p, "读到的是「" + arg + "」。用法：-board 1 ～ -board 15（板子号 7 = 自定义剧本，13 = 全员追忆，14 = 成双成对，15 = 移花接木）。");
        return;
    }
    if (!g_boardOpen || g_boardFade < 4) {
        // 【AI 测试兜底】（用户 2026-10-20）：玩家 1 是电脑时选板页可能没正常撑开；
        //   测试位发指令就按正常入口重新打开一次，再立即选板。
        if (!g_started) {
            BOTC_BoardOpen();
        }
    }
    if (!g_boardOpen || g_boardFade < 4) {
        BOTC_Notice(p, "选板页没有准备好；游戏开始前再发一次 -board 1。");
        return;
    }
    BOTC_PmStore(p, "【测试·选板】替当前说书人选板子 " + IntToString(n) + "（" + BOTC_BoardName(n) + "）。");
    BOTC_BoardPick(g_teller, n);
    if (g_boardSel != n) {
        BOTC_Notice(p, "选板没有生效：检查选板页面是否已经准备好。");
    }
    else {
        BOTC_Notice(p, "【测试】已替玩家 1 勾选板子 " + IntToString(n) + "，请点右下角【开始】。");
    }
}

//--------------------------------------------------------------------------------------------------
// 【灵言师（85）· 关键词监听】（用户 2026-11-11 改版）
//   首夜说书人把关键词发给灵言师、并且收回夜间唤醒之后，开始监听公聊：记下第一个说出该词
//   的善良存活玩家。不立刻转阵营，等下一个夜晚走到灵言师的夜序位次再结算（见 BOTC_MezeResolve）。
//--------------------------------------------------------------------------------------------------
void BOTC_MezeListen (int p, string msg) {
    int q;
    int mz;
    if (g_mezeDone) {
        return;
    }
    if (g_mezeSay >= 2) {
        return;
    }
    if (StringLength(g_mezeWord) <= 0) {
        return;
    }
    if (p < 1 || p > 13 || p == g_teller) {
        return;
    }
    mz = BOTC_AbilitySeat(85);
    if (mz < 2 || mz > 13) {
        mz = g_mezeSeat;
    }
    if (mz < 2 || mz > 13) {
        return;
    }
    // 关键词还挂在夜间唤醒里时先不记录；收回唤醒之后才开始监听公聊。
    if (g_awake[mz]) {
        return;
    }
    q = BOTC_PosOf(p);
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    if (BOTC_SeatAlign(q) != 0) {
        return;
    }
    if (StringFind(msg, g_mezeWord, false) < 0) {
        return;
    }
    g_mezeSay = q;
    g_mezeSayNight = g_nightNum;
    BOTC_PmStore(g_teller, "【灵言师】" + BOTC_NameStr(q) + " 在公聊说出了关键词「" + g_mezeWord + "」，将在下一个夜晚的灵言师夜序转为邪恶。");
    BOTC_Notice(g_teller, "【灵言师】已记录关键词发言者。");
}

// 【灵言师（85）· 夜晚结算】（用户 2026-11-11 改版）：在灵言师的夜序位次执行。
//   能力生效 → 记下的玩家转邪恶、灵言师失去能力；中毒 / 醉酒 → 不转，记录保留到下一个清醒的夜晚。
void BOTC_MezeResolve () {
    int q;
    int mz;
    q = g_mezeSay;
    mz = BOTC_AbilitySeat(85);
    if (mz < 2 || mz > 13) {
        mz = g_mezeSeat;
    }
    if (q < 2 || q > 13) {
        g_mezeSay = 0;
        g_mezeDone = true;
        return;
    }
    if (mz < 2 || mz > 13) {
        return;
    }
    if (!BOTC_AbilityWorks(mz, 85)) {
        BOTC_PmStore(g_teller, "【灵言师】" + BOTC_NameStr(q) + " 已说出关键词，但灵言师当前不生效，顺延到他清醒的夜晚再转阵营。");
        return;
    }
    if (BOTC_SeatAlign(q) != 0) {
        g_mezeSay = 0;
        g_mezeDone = true;
        BOTC_PmStore(g_teller, "【灵言师】" + BOTC_NameStr(q) + " 已经属于邪恶阵营，本次关键词不再改阵营。");
        return;
    }
    if (BOTC_HolySoulBlocks(q)) {
        BOTC_PmStore(g_teller, "【灵言师×圣洁之魂】邪恶玩家已达上限，" + BOTC_NameStr(q) + " 保持善良阵营。");
        return;
    }
    g_mezeSay = 0;
    g_mezeDone = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;      // 「邪恶」token：真身也算邪恶
    g_tokOn[(((g_teller * 14) + q) * 256) + 103] = true;     // 备忘：说出过灵言师的关键词
    g_tokOn[(((g_teller * 14) + mz) * 256) + 104] = true;    // 灵言师失去能力
    BOTC_PmInfo(g_who[q], "【信息】你得知自己已转为邪恶。");
    BOTC_PmStore(g_teller, "【灵言师】" + BOTC_NameStr(q) + " 在夜晚转为邪恶。");
    BOTC_Notice(g_teller, "【灵言师】关键词已结算。");
    BOTC_GrimRender(g_teller);
}

//--------------------------------------------------------------------------------------------------
// 【牙噶巴卜（133）· 秘密短语监听】（用户 2026-11-11）
//   首夜拿到短语之后，每个白天在公聊（非私聊频道）里统计他本人说出短语的次数：
//   · 单独说、夹在整句话里说都算；同一条消息里出现几次就记几次。
//   · 只在夜晚他的夜序位次把次数告诉说书人，杀谁仍由说书人手动决定。
//   · 说出短语时的中毒 / 醉酒不影响计数；只看夜晚结算时的状态决定能力是否生效。
//--------------------------------------------------------------------------------------------------
// 短语在一条消息里出现的次数（按字节扫描，避免 StringSub / StringFind 的位置口径混用）
int BOTC_YaggaCount (string msg, string word) {
    int n;
    int wl;
    int idx;
    int pos;
    int len;
    string rest;
    n = 0;
    len = StringLength(msg);
    wl = StringLength(word);
    if (wl <= 0 || len <= 0) {
        return 0;
    }
    pos = 0;
    while (pos < len) {
        rest = StringSub(msg, pos + 1, len);
        idx = StringFind(rest, word, false);
        if (idx < 0) {
            break;
        }
        n = n + 1;
        pos = pos + idx + wl;
        if (n >= 50) {
            break;
        }
    }
    return n;
}

// 当前持有牙噶巴卜能力的座位（0 = 不在场 / 能力已失去）；中毒 / 醉酒不影响这里
int BOTC_YaggaSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_HasAbility(q, 133)) {
            return q;
        }
    }
    return 0;
}

// 公聊监听：只统计牙噶巴卜本人白天公开说出短语的次数，不立即造成死亡
void BOTC_YaggaListen (int p, string msg) {
    int q;
    int yg;
    int n;
    if (StringLength(g_yaggaWord) <= 0) {
        return;
    }
    if (p < 1 || p > 13 || p == g_teller) {
        return;
    }
    if (!g_started || g_isNight) {
        return;
    }
    yg = BOTC_YaggaSeat();
    if (yg < 2 || yg > 13) {
        return;
    }
    q = BOTC_PosOf(p);
    if (q != yg) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    // 换天：上一天的次数不再累计
    if (g_yaggaDay != g_dayNum) {
        g_yaggaDay = g_dayNum;
        g_yaggaSay = 0;
    }
    n = BOTC_YaggaCount(msg, g_yaggaWord);
    if (n <= 0) {
        return;
    }
    g_yaggaSay = g_yaggaSay + n;
}

// 夜晚夜序位次告知说书人：今天白天说了几次；并说明当前状态是否会因能力造成死亡
// 返回 true 表示本次应该打开选人窗（清醒健康、活着、且白天至少说出过 1 次）
bool BOTC_YaggaNightReport (int seat) {
    int n;
    bool canKill;
    string s;
    if (StringLength(g_yaggaWord) <= 0) {
        return false;
    }
    if (g_yaggaDay == g_dayNum) {
        n = g_yaggaSay;
    }
    else {
        n = 0;
    }
    g_yaggaSay = 0;
    canKill = false;
    s = "【牙噶巴卜】" + BOTC_NameStr(seat) + " 今天白天共说出秘密短语 " + IntToString(n) + " 次（短语：「" + g_yaggaWord + "」）。";
    if (BOTC_SeatDead(seat)) {
        s = s + " 他已经死亡，能力不生效。";
    }
    else if (!BOTC_AbilityWorks(seat, 133)) {
        s = s + " 他当前中毒 / 醉酒，今晚不会因他的能力造成死亡（即使白天说短语时清醒健康）。";
    }
    else if (n <= 0) {
        s = s + " 他当前清醒健康，但今天没有说出短语，不会造成死亡。";
    }
    else {
        s = s + " 他当前清醒健康，可因此最多造成 " + IntToString(n) + " 名玩家死亡，目标由你决定。";
        canKill = true;
    }
    BOTC_PmStore(g_teller, s);
    return canKill;
}

bool BOTC_ChatDo (bool testConds, bool runActions) {
    int p;
    int i;
    int q;
    int n;
    string msg;
    string tag;
    string s;
    p = EventPlayer();
    msg = EventChatMessage(false);
    if (!runActions) {
        return true;
    }
    if (p < 1 || p > 13) {
        return true;
    }
    if (StringLength(msg) == 0) {
        return true;
    }
    // 【入场取名阶段】：改用屏幕中央输入框取名，聊天发言一律拦截（用户 2026-11-13）。
    if (g_introOn) {
        BOTC_IntroTryMsg(p, msg);
        return true;
    }
    // 切换说书模式：「AI」开智能说书、「手动」关掉。
    //   玩家1（说书人位）和 玩家2 都能发 ---- 因为「玩家1 是电脑」时他不会打字，
    //   而坐在玩家2 的那位（开发/测试的人）需要能把它打开。
    //   这两条是「强制」开关，会盖过按玩家类型自动判断的结果（见 BOTC_P1IsComputer）。
    // 【查看句柄】：-handles 对所有真人开放，结果只发给发送者本人。
    if (msg == "-handles") {
        BOTC_HandleListToPm(p);
        return true;
    }
    // 【-pmirror / -私聊镜像】（用户 2026-10-21）：测试开关。开启后所有 BOTC_PmInfo 角色结果同步显示在说书人私聊窗。
    if (BOTC_DevPlayer(p) && (msg == "-pmirror" || msg == "/pmirror" || msg == "-私聊镜像" || msg == "/私聊镜像" || msg == "-镜像私聊")) {
        g_pmInfoMirrorOn = !g_pmInfoMirrorOn;
        if (g_pmInfoMirrorOn) {
            s = "【私聊镜像】已开启：之后发给玩家的角色结果会同步写到说书人私聊窗；再发一次关闭。";
        }
        else {
            s = "【私聊镜像】已关闭。";
        }
        BOTC_Notice(p, s);
        if (p != g_teller) {
            BOTC_Notice(g_teller, s);
        }
        return true;
    }
    // 【-swap】（用户 2026-10-20）：测试用「换两格」，现在对所有真人座位开放。
    if (BOTC_DevPlayer(p) && msg == "-swap") {
        BOTC_SwapSeatStart(p);
        return true;
    }
    // 【-pos】（用户 2026-10-07；2026-10-09 发布版关闭）：打印自己那张身位表（排查用），只给开发位
    if (BOTC_DevPlayer(p) && msg == "-pos") {
        BOTC_PosOfDump(p);
        return true;
    }
    // 【-grim n】（用户 2026-10-07；2026-10-09 发布版关闭）：开发 / 测试用 —— 把自己的魔典切去"看 座位 n（1..12）自己那份"；
    //   -grim 0（或不带数字）＝ 看回自己那份。只改"渲染读哪一行"，不动任何数据。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-grim", false) == 0 || StringFind(msg, "/grim", false) == 0)) {
        BOTC_GrimViewMsg(p, StringSub(msg, 5, StringLength(msg)));
        return true;
    }
    // 【-board n】（用户 2026-10-20）：替玩家 1 电脑选板，供测试换座位 / bank 使用。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-board", false) == 0 || StringFind(msg, "/board", false) == 0 || StringFind(msg, "board", false) == 0 || StringFind(msg, "-板子", false) == 0 || StringFind(msg, "/板子", false) == 0 || StringFind(msg, "板子", false) == 0 || StringFind(msg, "-选板", false) == 0 || StringFind(msg, "/选板", false) == 0 || StringFind(msg, "选板", false) == 0)) {
        BOTC_TestBoardAt(p, msg);
        return true;
    }
    // 【-wake n】（用户 2026-10-09；发布版关闭）：模拟"手动唤醒模式下点了座位 n"----
    //   走的就是点击那一支用的 BOTC_WakeManualAt，所以唤醒 / 弹面板 / 私聊全是真实路径；
    //   再发一次同一条 = 收回。数字由 BOTC_TestWakeAt 自己解析（-wake 3 / -wake3 / /wake 3 / -唤醒 3 都认）。
    if (BOTC_DevPlayer(p) && (StringFind(msg, "-wake", false) == 0 || StringFind(msg, "/wake", false) == 0 || StringFind(msg, "-唤醒", false) == 0)) {
        BOTC_TestWakeAt(p, msg);
        return true;
    }
    // 【投票踢人】（用户 2026-10-02）：发 -kick → 弹魔典 → 点一个座位 = 对他发起踢出投票
    //   （点「说书人」那一格 = 对说书人发起；再发一次 -kick 取消）
    if (msg == "-kick") {
        BOTC_KickPickStart(p);
        return true;
    }
    // 玩家1 自己打字了 → 他百分之百是真人（电脑不会打字）。
    //   万一「玩家类型」那个原生函数判错了、把真人说书当成电脑，这里立刻纠回来。
    //   用聊天里的「AI」强制开启时不走这一步（那条由 g_p1ForceComputer 顶着）。
    // 【调试】三条现场调试指令（只有玩家1 / 玩家2 能用）：
    //   style <样式名>  → 换「大提示」的字体样式并立刻弹一条「夜晚 1」试看
    //   big <文字>      → 直接用大提示弹一行字（试位置 / 试大小）
    //   sfx <音效ID>    → 试播一个音效（顺便把它记成入夜那声）
    //   参数都是英文，所以用 StringSub 直接取（中文会牵扯字节下标，这里不碰）
    // 【-laugh】（用户 2026-09-22）：所有玩家都能用；全桌公用 30 秒冷却，冷却中完全静默 ----
    //   ⚠ 直接内联在这里，不再调外部函数（外面那次「调用」在某些贴法下进不去）
    if (StringFind(msg, "-laugh", false) >= 0) {
        if (g_laughCd <= 0) {
            g_laughCd = 60;
            s = BOTC_SayToken(p) + "：<s val=\"ModLeftSize20Bold\">爽朗的大笑！</s>";     // 【名字要渲染】（用户 2026-09-22）：用「玩家N」占位符，渲染时才带名字和颜色
            g_chatWhoNow = BOTC_PosOf(p);
            BOTC_PubLine(s);
            g_chatWhoNow = 0;
            BOTC_PlaySfx("laugh");
        }
        return true;
    }
    // 【测试·教派投票全流程】（用户 2026-10-11）：说书人自己起一次教派投票，并把**除他以外所有人**自动投成【投票】
    //   —— 用来一次性看完整流程（20 秒到点自动结算；想当场看结果就再发 `-教派胜`）。
    if (BOTC_DevPlayer(p) && msg == "-教派") {
        if (p != g_teller) {
            BOTC_Notice(p, "这条只有说书人能用。");
            return true;
        }
        if (g_cultOn) {
            BOTC_Notice(g_teller, "已经有一次教派投票在走了（要当场看结果发 -教派胜）。");
            return true;
        }
        BOTC_CultStart(1);                    // 以「说书人」那一格当提议人（纯测试；身份会不会结算由你自己 -t 决定）
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q]) { continue; }
            g_vote[q] = 1;                    // 全部投【投票】= 同意加入
        }
        BOTC_NomUI();
        BOTC_PmStore(g_teller, "【教派·测试】已起投票，并把所有人自动投成【投票】（20 秒到点结算；-教派胜 可当场结算）。");
        return true;
    }
    // 【异教领袖（106）· 白天提议入教】（用户 2026-10-10）：只有本尊能发；公开播报，胜负由说书人裁定
    if (msg == "-入教") {
        if (BOTC_AbilityWorks(BOTC_PosOf(p), 106) && !BOTC_SeatDead(BOTC_PosOf(p))) {
            g_cultAsked = true;
            BOTC_PubAnnounce("【教派】" + BOTC_NameStr(BOTC_PosOf(p)) + " 提议所有人加入他的教派！");
            BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(BOTC_PosOf(p)) + " 提议所有人入教 → 逐个问善良玩家同不同意；全部同意就用 -教派胜 裁定。");
        }
        else {
            BOTC_Notice(p, "你不是异教领袖，不能提议入教。");
        }
        return true;
    }
    // 【教派胜利】说书人裁定：异教领袖提议入教且所有善良玩家都同意 → 他的阵营获胜
    if (msg == "-教派胜") {
        if (p == g_teller) {
            if (g_cultOn) {
                BOTC_CultEnd(true);            // 【测试】（用户 2026-10-11）：正在投票就直接结算掉
                return true;
            }
            if (BOTC_SeatOfRole(106) >= 2) {
                BOTC_ShowWin(BOTC_SeatAlign(BOTC_SeatOfRole(106)), "所有善良玩家都加入了异教领袖的教派，", "小镇从此只有一种声音。");
            }
            else {
                if (BOTC_BoffinTargetWithRole(106) >= 2) {
                    BOTC_ShowWin(BOTC_SeatAlign(BOTC_BoffinTargetWithRole(106)), "所有善良玩家都加入了恶魔借来的异教领袖教派，", "小镇从此只有一种声音。");
                }
                else {
                    BOTC_Notice(p, "本局没有异教领袖能力，不能判教派胜利。");
                }
            }
        }
        return true;
    }
    if (BOTC_DevPlayer(p)) {
        if (StringFind(msg, "-style ", false) == 0 && StringLength(msg) > 6) {
            g_bigStyle = StringSub(msg, 6, StringLength(msg));
            libNtve_gf_SetDialogItemStyle(g_bigLbl, g_bigStyle, PlayerGroupAll());
            BOTC_BigNotice("夜晚 1");
            BOTC_Notice(p, "大提示样式改成：" + g_bigStyle);
            return true;
        }
        if (StringFind(msg, "-big ", false) == 0 && StringLength(msg) > 4) {
            BOTC_BigNotice(StringSub(msg, 4, StringLength(msg)));
            return true;
        }
        if (StringFind(msg, "-sfx ", false) == 0 && StringLength(msg) > 4) {
            g_sfxPingName = StringSub(msg, 4, StringLength(msg));
            BOTC_PlaySfx(g_sfxPingName);
            BOTC_Notice(p, "试播音效：" + g_sfxPingName);
            return true;
        }
        // reqsfx <音效ID> / pmsfx <音效ID> → 试播并记下「收到私聊请求 / 私聊建立」这两声 UI 音效
        if (StringFind(msg, "-reqsfx ", false) == 0 && StringLength(msg) > 7) {
            g_sfxReqName = StringSub(msg, 7, StringLength(msg));
            BOTC_PlaySfxTo(g_sfxReqName, p);
            BOTC_Notice(p, "私聊请求音效改成：" + g_sfxReqName);
            return true;
        }
        if (StringFind(msg, "-pmsfx ", false) == 0 && StringLength(msg) > 6) {
            g_sfxPmOnName = StringSub(msg, 6, StringLength(msg));
            BOTC_PlaySfxTo(g_sfxPmOnName, p);
            BOTC_Notice(p, "私聊建立音效改成：" + g_sfxPmOnName);
            return true;
        }
        // startsfx <音效ID> → 试播并记下「游戏正式开始」那声
        if (StringFind(msg, "-startsfx ", false) == 0 && StringLength(msg) > 9) {
            g_sfxStartName = StringSub(msg, 9, StringLength(msg));
            BOTC_PlaySfx(g_sfxStartName);
            BOTC_Notice(p, "正式开始音效改成：" + g_sfxStartName);
            return true;
        }
        // chatsfx <音效ID> → 试播并记下「公屏有人说话」那声
        if (StringFind(msg, "-chatsfx ", false) == 0 && StringLength(msg) > 8) {
            g_sfxChatName = StringSub(msg, 8, StringLength(msg));
            BOTC_PlaySfx(g_sfxChatName);
            BOTC_Notice(p, "公屏说话音效改成：" + g_sfxChatName);
            return true;
        }
        // gstyle <样式名> → 换魔典座位名那一行的字体（试大小用），换完把全场魔典重刷一遍
        //   例子：gstyle ModLeftSize14Bold  /  gstyle ModLeftSize18  /  gstyle ObjectiveDisplay（很大）
        if (StringFind(msg, "-gstyle ", false) == 0 && StringLength(msg) > 7) {
            g_grimNameStyle = StringSub(msg, 7, StringLength(msg));
            for (i = 1; i <= 13; i += 1) {
                BOTC_GrimRender(i);
            }
            BOTC_Notice(p, "魔典座位名字体改成：" + g_grimNameStyle);
            return true;
        }
        // nameoff <数字> → 名字前面方括号里的序号偏移（序号 = 游戏内号 + 这个值）。
        //   默认 -1；如果序号还是差一位，就发 nameoff 0 或 nameoff -2 试，改完聊天窗/日志会重刷。
        if (StringFind(msg, "-nameoff ", false) == 0 && StringLength(msg) > 8) {
            g_nameNumShift = StringToInt(StringSub(msg, 8, StringLength(msg)));
            for (i = 1; i <= 13; i += 1) {
                BOTC_ChatRender(i);
                BOTC_PmBoxRender(i);
                BOTC_LogRender(i);
            }
            BOTC_Notice(p, "名字序号偏移改成：" + IntToString(g_nameNumShift) + "（序号 = 游戏内号 + " + IntToString(g_nameNumShift) + "）");
            return true;
        }
        // nstyle <样式名> → 换「提名开始」那 4 个字的样式，并立刻演一遍看效果
        if (StringFind(msg, "-nstyle ", false) == 0 && StringLength(msg) > 7) {
            g_nomBigStyle = StringSub(msg, 7, StringLength(msg));
            for (i = 0; i < 4; i += 1) {
                libNtve_gf_SetDialogItemStyle(g_nomBigLbl[i], g_nomBigStyle, PlayerGroupAll());
            }
            BOTC_NomBigShow();
            BOTC_Notice(p, "提名大字样式改成：" + g_nomBigStyle);
            return true;
        }
        // nbig <数字> → 用不同的「创建标签最后一个参数」重建那 4 个字（试它是不是字号倍率）
        //   用法举例：nbig 4   或   nbig 8（原来的值是 2）
        if (StringFind(msg, "-nbig ", false) == 0 && StringLength(msg) > 5) {
            g_nomBigSize = StringToFixed(StringSub(msg, 5, StringLength(msg)));
            BOTC_NomBigMake();
            BOTC_NomBigShow();
            BOTC_Notice(p, "提名大字已按新参数重建（原来是 2）");
            return true;
        }
        // wstyle <样式名> → 换结算那句话（游戏结束，我们得到的结果是：）的字体样式并弹出来看
        if (StringFind(msg, "-wstyle ", false) == 0 && StringLength(msg) > 7) {
            g_endStyle = StringSub(msg, 7, StringLength(msg));
            BOTC_EndNoticeMake();
            BOTC_EndNoticeShow();
            BOTC_Notice(p, "结算字幕样式改成：" + g_endStyle);
            return true;
        }
        // wbig <数字> → 用不同的「创建标签最后一个参数」重建结算字幕（试字号倍率）
        if (StringFind(msg, "-wbig ", false) == 0 && StringLength(msg) > 5) {
            g_endSize = StringToFixed(StringSub(msg, 5, StringLength(msg)));
            BOTC_EndNoticeMake();
            BOTC_EndNoticeShow();
            BOTC_Notice(p, "结算字幕已按新参数重建（原来是 2）");
            return true;
        }
        // nametest → 把一行「带名字」的样例同时发到【提示条 / 公聊窗 / 公聊记录 / 私聊记录】，
        //   用来现场看是哪一处显示不全（用户 2026-09-19 排查「只剩两个名字」用）
        if (msg == "-nametest") {
            s = "【名字测试】玩家10 和 玩家11 里，有恶魔（玩家12 说的）---- 结尾这几个字也要在。";
            BOTC_Notice(p, s);          // 提示条 + 他的私聊记录
            BOTC_ChatShowAll(s);        // 公聊窗
            BOTC_PubLogStore(s);        // 公聊记录（点【日志】→ 公聊记录 看）
            return true;
        }
        // /tip <身份索引> → 【调试】让【角色提示】面板强制显示某个角色的文案（开发位可用）；
        //   只发 /tip = 恢复成「显示自己的身份」
        if (StringFind(msg, "-tip", false) == 0) {
            if (StringLength(msg) > 5) {
                g_tipForce[p] = StringToInt(StringSub(msg, 5, StringLength(msg)));
            }
            else {
                g_tipForce[p] = -1;
            }
            BOTC_TipOpen(p);
            if (g_tipForce[p] >= 0 && g_tipForce[p] <= 163) {
                BOTC_Notice(p, "【测试】角色提示面板强制显示：" + g_roleName[g_tipForce[p]]);
            }
            else {
                BOTC_Notice(p, "【测试】角色提示面板恢复成「显示自己的身份」。");
            }
            return true;
        }
        // slay / slayd / slayp / slayf → 【测试猎手弹窗】第 1 个白天让 玩家2 自动声称【猎手】猎杀 玩家3
        //   slay = 真猎手；slayd = 酒鬼猎手（魔典写猎手、其实是酒鬼）；slayp = 中毒的猎手；
        //   slayf = 假声称（身份不动，看座位 2 真身是什么）
        //   再发一次同样的指令 = 关掉
        if (msg == "-slay" || msg == "-slayd" || msg == "-slayp" || msg == "-slayf") {
            i = 0;
            if (msg == "-slayd") {
                i = 1;
            }
            if (msg == "-slayp") {
                i = 2;
            }
            if (msg == "-slayf") {
                i = 3;
            }
            if (g_testSlayOn && g_testSlayMode == i) {
                g_testSlayOn = false;
                BOTC_Notice(p, "【测试】已关掉「玩家2 第 1 个白天自动声称猎手」。");
            }
            else {
                g_testSlayOn = true;
                g_testSlayMode = i;
                g_testSlayDone = false;
                if (i == 1) {
                    BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「酒鬼猎手」自动声称猎杀 玩家3。");
                }
                else {
                    if (i == 2) {
                        BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「中毒的猎手」自动声称猎杀 玩家3。");
                    }
                    else {
                        if (i == 3) {
                            BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「假声称」自动声称猎杀 玩家3（身份不动，看真身是谁）。");
                        }
                        else {
                            BOTC_Notice(p, "【测试】开启：第 1 个白天 玩家2 会用「真猎手」自动声称猎杀 玩家3。");
                        }
                    }
                }
            }
            return true;
        }
        // -tk → 【测试】打开「说书人自己」的 token 面板（配合 -t 用：给自己打中毒 / 醉酒 / 死亡...
        //   普通玩家的 token 还是老规矩：点座位旁边的【＋】）
        if (msg == "-tk") {
            BOTC_TokOpen(p, 1);        // 【开给打字的人】（用户 2026-10-11：原来写死 1）
    BOTC_PmStore(g_teller, "这是「说书人自己」的 token 面板：点一格就是给自己打/去掉那个 token。");
            return true;
        }
        // -t → 【测试】说书人自己拿一个身份（弹身份网格点一个图标）；-t off / -toff = 关掉
        //   拿到身份之后说书人直接算「被唤醒」：屏幕中间会出现【使用技能】，点魔典上的座位选目标
        if (msg == "-t") {
            BOTC_TestSelfOpen();
            return true;
        }
        if (msg == "-t off" || msg == "-toff") {
            BOTC_TestSelfRole(-1);
            return true;
        }
        // 【私聊测试指令】（用户 2026-09-22）：直接让两名玩家开一个私聊 ----
        //   `/pm23`（简写，玩家2 和玩家3）或 `/pm 2 3`（任意两名，星际玩家号 2..13；1 = 说书人）。
        //   用来验证：说书人在【进行中的私聊】里选中那一条 → 点【请求加入】能不能直接进去。
        //   `-pm` 和 `/pm` 两种前缀都认。
        if (msg == "-pm23" || msg == "/pm23") {
            BOTC_CreateSess(2, 3);
            BOTC_Notice(g_teller, "【测试】" + BOTC_NameStr(2) + " 和 " + BOTC_NameStr(3) + " 的私聊已建立。");
            return true;
        }
        if (StringFind(msg, "-pm ", false) == 0 || StringFind(msg, "/pm ", false) == 0) {
            BOTC_TestPmPair(StringSub(msg, 4, StringLength(msg)));
            return true;
        }
        // 【提名测试指令】（用户 2026-09-22）：直接让某名玩家提名某名玩家 ----
        //   `/nom23` = 玩家2 提名 玩家3；`/nom 2 3` = 任意两名（发起人 目标，星际玩家号 2~13）。
        //   `-nom` 和 `/nom` 两种前缀都认。
        if (msg == "-nom23" || msg == "/nom23") {
            BOTC_TestNominate(2, 3);
            return true;
        }
        if (StringFind(msg, "-nom ", false) == 0 || StringFind(msg, "/nom ", false) == 0) {
            BOTC_TestNomPair(StringSub(msg, 5, StringLength(msg)));
            return true;
        }
        // 【处决说书人·测试指令】（用户 2026-09-26）：`-execst` = 直接按「说书人被处决」结算一次
        if (msg == "-execst" || msg == "/execst") {
            BOTC_ExecToggleAt(1);
            return true;
        }
        // -哲酒鬼 / -哲疯子（座位 2 = 游戏里的「玩家1」）：【测试】让那个座位变成「哲学家 + 选了酒鬼 / 疯子」
        //   用户 2026-09-21：跟猎手那套测试指令一个思路，直接跳到第二个网格（他自己没有能力）
    // 【女巫（65）· 测试指令】（用户 2026-09-21）：-诅咒 = 让「被诅咒的那个人」现在发起提名，按诅咒结算一次
    //   （正常玩法里不用它：被诅咒的人自己发起提名时脚本会自动结算）
    if (msg == "-诅咒" || msg == "-女巫") {
        if (g_witchCurse >= 2) {
            BOTC_Notice(g_teller, "【女巫·测试】让 " + BOTC_NameStr(g_witchCurse) + " 发起提名，按诅咒结算。");
            BOTC_WitchNomCheck(g_witchCurse);
        }
        else {
            BOTC_Notice(g_teller, "【女巫·测试】现在没有被诅咒的人。");
        }
    }
        // 【查看某个座位】（用户 2026-09-21）：-看1 ~ -看12 = 把那个座位的身份 / 阵营 / 标记写进你的日志
        if (msg == "-看1") { BOTC_SeatDump(2); }
        if (msg == "-看2") { BOTC_SeatDump(3); }
        if (msg == "-看3") { BOTC_SeatDump(4); }
        if (msg == "-看4") { BOTC_SeatDump(5); }
        if (msg == "-看5") { BOTC_SeatDump(6); }
        if (msg == "-看6") { BOTC_SeatDump(7); }
        if (msg == "-看7") { BOTC_SeatDump(8); }
        if (msg == "-看8") { BOTC_SeatDump(9); }
        if (msg == "-看9") { BOTC_SeatDump(10); }
        if (msg == "-看10") { BOTC_SeatDump(11); }
        if (msg == "-看11") { BOTC_SeatDump(12); }
        if (msg == "-看12") { BOTC_SeatDump(13); }
        // 【麻脸巫婆 / 洗脑师 · 测试指令】（用户 2026-09-21）：直接对**座位 2（游戏里的「玩家1」）**生效，
        //   跟「-哲酒鬼 / -哲疯子」那套一个思路 ---- 不用点技能面板也能验证逻辑。
        //   -熬恶魔 = 把他熬成当前板子上的第一只恶魔（还会开「生死无常」面板）
        if (msg == "-熬恶魔") {
            BOTC_TestHag(-1);
        }
        if (msg == "-熬疯子") {
            BOTC_TestHag(38);
        }
        if (msg == "-熬酒鬼") {
            BOTC_TestHag(14);
        }
        if (msg == "-熬双子" || msg == "-熬镜像双子") {
            BOTC_TestHag(64);
        }
        if (msg == "-熬钟表匠") {
            BOTC_TestHag(47);
        }
        // -疯狂 = 给座位 2 打「疯狂（洗脑师）」并对他说「疯狂证明自己是钟表匠」
        if (msg == "-疯狂") {
            BOTC_CerenApply(2, 2, 47);
        }
        if (msg == "-哲酒鬼" || msg == "-philo14") {
            BOTC_TestPhilo(14);
            return true;
        }
        if (msg == "-哲疯子" || msg == "-philo38") {
            BOTC_TestPhilo(38);
            return true;
        }
        // debug → 【调试总开关】开 / 关：诊断日志、测试播报、真魔典同步一起切换
        if (msg == "-debug") {
            g_debugOn = !g_debugOn;
            if (g_debugOn) {
                BOTC_Notice(p, "【调试】已打开：诊断日志 / 测试播报 / 真魔典同步都会出现。");
            }
            else {
                BOTC_Notice(p, "【调试】已关闭：界面恢复成正式局的样子。");
            }
            return true;
        }
        // bg <数字> → 调公聊 / 私聊那层黑底的不透明度（现场对比，不用重粘脚本）
        if (StringFind(msg, "-bg ", false) == 0 && StringLength(msg) > 3) {
            g_chatAlpha = StringToInt(StringSub(msg, 3, StringLength(msg)));
            BOTC_ChatBgApply();
            BOTC_Notice(p, "聊天黑底透明度改成：" + IntToString(g_chatAlpha) + "（越大越透明）");
            return true;
        }
    }
// 说书人的时段指令：输入「-私聊」/「-公聊」切换发言时段（自由发言已删，用户 2026-09-30）
if (p == g_teller) {
    if (msg == "-私聊") {
        BOTC_ChatModeSet(1);
        return true;
    }
    if (msg == "-公聊") {
        BOTC_ChatModeSet(2);
        return true;
    }
}
    // ⚠ 顺序要紧（用户 2026-09-19 报的 bug）：【聊天：私聊】模式下回车必须**先**走这条，
    //   不能让它落到下面「私聊时段不许公聊」那一关 ---- 那一关会直接把这次输入吞掉，
    //   只弹一句「现在是私聊时间，先在面板上跟人单独聊」，打出去的私聊永远发不出去。
    //   这里只负责转交；能不能发由 BOTC_SayPmText 自己判（不在私聊里 / 时段或阶段不允许时它只提示、不发）。
    if (g_chatSay[p] == 1) {
        BOTC_SayPmText(p, msg);
        return true;
    }
    // 白天时段限制：私聊时间不许公聊（说书人例外，他要用公聊播报）
    if (g_chatMode == 1 && !g_cultOn) {
        if (p != g_teller) {
            BOTC_Notice(p, "现在是私聊时间，先在面板上跟人单独聊；公聊要等公聊时间。");
            return true;
        }
    }
    // 提名阶段的发言限制：只有当前发言者（以及说书人）能说话
    if (g_phase == 1) {
        if (p != g_teller) {
            BOTC_Notice(p, "提名环节请保持安静，等有人发起提名。");
            return true;
        }
    }
    if (g_phase == 2) {
        if (p != g_teller) {
            BOTC_Notice(p, "正在选择提名对象，请保持安静。");
            return true;
        }
    }
    if (g_phase == 3) {
        if (p != g_teller && BOTC_PosOf(p) != g_nomFrom) {
            BOTC_Notice(p, "现在是 " + BOTC_NameStr(g_nomFrom) + " 的发言时间，请等他结束。");
            return true;
        }
    }
    if (g_phase == 4) {
        if (p != g_teller && BOTC_PosOf(p) != g_nomTo) {
            BOTC_Notice(p, "现在是 " + BOTC_NameStr(g_nomTo) + " 的反驳时间，请等他结束。");
            return true;
        }
    }
    if ((g_phase == 5 || g_phase == 6) && !g_cultOn) {
        if (p != g_teller) {
            BOTC_Notice(p, "投票 / 统计阶段请保持安静。");
            return true;
        }
    }
    if (p == g_teller) {
        tag = "";                      // 说书人那格由 BOTC_LineText 渲染成「[说书人] 他的玩家ID」
    }
    else {
        tag = "";                      // 玩家：真实号已经写在名字里了（[2]玩家1），这里不再重复
    }
    // 【防刷屏 · 公聊禁言】（用户 2026-11-06）：只在公聊频道检测（私聊前面已经返回），
    //   提名阶段不检测；5 秒内连发 5 条即禁言 15 秒，禁言期间这条不发。
    if (p != g_teller && g_phase == 0 && !BOTC_SpamAllow(p)) {
        return true;
    }
    // 【灵言师（85）】公聊里说出了关键词 → 该玩家转邪恶、灵言师失去能力。
    BOTC_MezeListen(p, msg);
    // 【牙噶巴卜（133）】公聊里说出了秘密短语 → 只累计次数，夜晚再告知说书人。
    BOTC_YaggaListen(p, msg);
    BOTC_PubSay(p, tag, msg);
    return true;
}

// 聊天/打字这条输入路径也打标记（跟点界面一样：这期间冒出来的提示别写进私聊日志）
bool BOTC_Chat_Func (bool testConds, bool runActions) {
    bool r;
    if (!runActions) {
        return true;
    }
    g_inClick = true;
    r = BOTC_ChatDo(testConds, runActions);
    g_inClick = false;
    return r;
}

//--------------------------------------------------------------------------------------------------
// 初始化
//--------------------------------------------------------------------------------------------------
// 切换白天的发言时段：0 = 自由 / 1 = 只能私聊 / 2 = 只能公聊。全场播报一句，并在日志留痕。
void BOTC_PullAllToPublic () {
    int p;
    int s;
    // 【换说书人之后玩家 1 也是玩家】（用户 2026-10-19 报「在私聊里但显示不在」）：
    //   原来只踢 2..13，玩家 1 的私聊会话会留着 → 人还在私聊里、聊天按钮却切回公聊，状态对不上。
    // 【批量踢】（用户 2026-10-19）：原来每踢一个人都重刷 13 份会话列表 → 进提名 / 入夜会卡一下、第一次点击像没反应。
    // 【说书人所在的私聊整间保留】（用户 2026-11-04）：进提名阶段不再把说书人房间里的其他成员踢出去。
    g_bulkLeave = true;
    for (p = 1; p <= 13; p += 1) {
        if (p == g_teller) {
            continue;
        }
        s = g_mySess[p];
        if (s >= 1 && s <= 13 && g_member[(s * 14) + g_teller]) {
            continue;
        }
        BOTC_ForceLeave(p);
    }
    g_bulkLeave = false;
    BOTC_RefreshSessListAll();
    for (p = 1; p <= 13; p += 1) {
        // 【说书人还在私聊里就保留他的私聊状态】（用户 2026-11-02）：阶段切换只收其他玩家的私聊。
        if (p == g_teller && g_mySess[p] != 0) {
            continue;
        }
        // 【说书人房间内的成员保持私聊】（用户 2026-11-04）：不能因为阶段切换把他们拨回公聊。
        s = g_mySess[p];
        if (s >= 1 && s <= 13 && g_member[(s * 14) + g_teller]) {
            continue;
        }
        g_chatSay[p] = 0;
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：公聊（Tab切换）"), PlayerGroupSingle(p));
    }
}

void BOTC_ChatModeSet (int m) {
    int i;
    int old;
    // 【剧本以外禁用私聊】（用户 2026-11-13）：选剧本 / 取名 / 自定义剧本页面只保留公聊
    if (BOTC_PmOff() && m != 2) {
        BOTC_Notice(g_teller, "剧本开始前只能公聊，私聊频道暂未开放。");
        return;
    }
    // 夜里固定公聊：**不能切成私聊 / 自由**（用户 2026-09-17 要求）。
    //   夜里说书人的【聊天：...】按钮已经收起来了，这里再兜一层，防止聊天指令绕过去。
    if (g_isNight && m != 2) {
        BOTC_Notice(g_teller, "现在是夜晚：发言固定为公聊，等天亮再切时段。");
        return;
    }
    old = g_chatMode;
    if (g_chatMode == m) {
        return;
    }
    g_chatMode = m;
    // 【跨阶段强制收尾】（用户 2026-11-08）：切进公聊 / 私聊前先取消所有还在进行的弹窗和选人
    BOTC_PhaseUiForceClose();
    // 【先定每个人的聊天模式，再解散私聊】（用户 2026-11-02）：
    //   原来是先 BOTC_DissolveAllSess() 再按 g_mySess 判断「不在私聊里的切回公聊」----
    //   解散之后所有人 g_mySess 都是 0，于是全场被强行拨回公聊；正在私聊里打字的人一按回车就发到公屏。
    //   现在改成按**切换那一刻**是否还在私聊里判断：仍在私聊里的保持【私聊】模式（会话结束后回车只在
    //   私聊框提示、绝不进公聊），本来就不在私聊里的才按公聊处理；想主动公聊的玩家自己按 Tab 切。
    //   【换说书人之后玩家 1 也是玩家】（用户 2026-10-19）：别再写死 2..13
    for (i = 1; i <= 13; i += 1) {
        if (i == g_teller) {
            continue;
        }
        if (m == 1) {
            g_chatSay[i] = 1;
        }
        else {
            if (g_mySess[i] == 0) {
                g_chatSay[i] = 0;
            }
        }
        BOTC_SayRender(i);
    }
    // 【私聊阶段 → 公聊阶段：自动解散除说书人以外的私聊】（用户 2026-11-02）
    if (old == 1 && m == 2) {
        BOTC_DissolveAllSess(true);
    }
    if (m == 1) {
        BOTC_PubAnnounce("【时段】私聊时间：现在只能私聊，公聊暂时关闭。");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("私聊时间（只能私聊）"));
    }
    else {
        if (m == 2) {
            BOTC_PubAnnounce("【时段】公聊时间：现在只能公聊，私聊暂时关闭。");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("公聊时间（只能公聊）"));
        }
        else {
            BOTC_PubAnnounce("【时段】自由发言：公聊和私聊都可以。");
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("自由发言时间"));
        }
    }
    BOTC_ChatBtnRender();
    // 白天（正式开局之后）按时段放背景音乐：自由 / 私聊一首，公聊一首
    //   优先级 1：提名阶段（2）和夜晚（3）放的音乐不会被这里盖掉
    BOTC_DayMusicRefresh(2.5);        // 白天里的「时段切换」用 2.5 秒（昼夜切换才是 4 秒）
}

// 说书人按【聊天：...】按钮：公聊 ↔ 私聊（用户 2026-09-30：自由发言已删）
void BOTC_ChatBtnClick () {
    if (g_chatMode == 1) {
        BOTC_ChatModeSet(2);           // 私聊 → 公聊
    }
    else {
        BOTC_ChatModeSet(1);           // 公聊 → 私聊
    }
}

// 【聊天：公聊/私聊】开关：所有玩家都用这一套（用户 2026-09-30：说书人也跟其他玩家一样，切自己的）
// 按自己那份状态刷新按钮文字
void BOTC_SayRender (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_chatSay[p] == 1) {
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：私聊（Tab切换）"), PlayerGroupSingle(p));
    }
    else {
        libNtve_gf_SetDialogItemText(g_sayBtnP[p], StringToText("聊天：公聊（Tab切换）"), PlayerGroupSingle(p));
    }
}

void BOTC_SayToggle (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    // 【剧本以外禁用私聊】（用户 2026-11-13）：选剧本 / 取名 / 自定义剧本页面只能公聊
    if (BOTC_PmOff()) {
        g_chatSay[p] = 0;
        BOTC_SayRender(p);
        return;
    }
    // 私聊阶段：非说书人被锁定成私聊，点按钮也切不回公聊（用户 2026-09-30）
    if (g_chatMode == 1 && !g_cultOn && p != g_teller) {
        g_chatSay[p] = 1;
        BOTC_SayRender(p);
        BOTC_Notice(p, "现在是私聊时间：自动保持【私聊】，到了公聊时间才会解除。");
        return;
    }
    if (g_chatSay[p] == 1) {
        g_chatSay[p] = 0;
        BOTC_SayRender(p);
        BOTC_Notice(p, "已切回【公聊】：回车打的内容全桌可见。");
    }
    else {
        g_chatSay[p] = 1;
        BOTC_SayRender(p);
        BOTC_Notice(p, "已切到【私聊】：回车打的内容只进你当前的私聊（没在私聊里会提示）。");
    }
}

void BOTC_HotSwitch (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    BOTC_SayToggle(p);
}

// 【一键切换公聊 / 私聊】（用户 2026-09-30）：按 Tab（＝"选择英雄 1"那个槽）切自己那份，含说书人
bool BOTC_HotKey_Func (bool testConds, bool runActions) {
    if (runActions) {
        if (g_introOn) {
            return true;
        }
        g_pmBoxOnlyNow = true;      // 只进聊天框、不进日志（用户 2026-09-30）
        BOTC_HotSwitch(EventPlayer());
        g_pmBoxOnlyNow = false;
    }
    return true;
}

// 刷新说书人那个按钮的文字：显示当前"时段"（公聊时间 / 私聊时间）
void BOTC_ChatBtnRender () {
    if (g_chatBtn == 0) {
        return;
    }
    if (g_chatMode == 1) {
        libNtve_gf_SetDialogItemText(g_chatBtn, StringToText("进入公聊阶段"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_chatBtn, StringToText("进入私聊阶段"), PlayerGroupSingle(g_teller));
    }
}

//--------------------------------------------------------------------------------------------------
// 【快进到提名】全体玩家投票（用户 2026-09-16 要求）
//   · 屏幕最上方一个按钮（**只有玩家 2..13 有**；说书人没有这个投票），文字里带票数「快进到提名 3/6」
//   · 投满 80%：智能说书人**直接强制**开提名环节；真人说书那边只显示票数，快不快进由他自己决定
//   · 只有「正式开局后的白天、自由活动阶段（g_phase == 0）」能投票 ----
//     提名阶段和夜晚按钮直接收起，点了也会被拒
//   · 进入提名阶段（以及新的一天 / 换局）会把票数清空
//--------------------------------------------------------------------------------------------------

// 需要几票：在场且活着的玩家（不含说书人）的 80%，向上取整（5 人 = 4 票、10 人 = 8 票）
int BOTC_SkipNeed () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return 0;
    }
    return ((n * 8) + 9) / 10;
}

// 现在几票（只算在场、还活着的人）
int BOTC_SkipCount () {
    int p;
    int n;
    n = 0;
    for (p = 2; p <= 13; p += 1) {
        if (g_seatOn[p] && !BOTC_SeatDead(p)) {
            if (g_skipVote[p]) {
                n = n + 1;
            }
        }
    }
    return n;
}

void BOTC_SkipRender () {
    int n;
    int need;
    string s;
    if (g_skipBtn == 0) {
        return;
    }
    // 提名阶段 / 夜晚 / 还没正式开始：收起（= 不能投票）
    if (!g_started || g_isNight || g_phase != 0) {
        DialogSetVisible(g_skipDlg, PlayerGroupAll(), false);
        return;
    }
    n = BOTC_SkipCount();
    need = BOTC_SkipNeed();
    s = "快进到提名 " + IntToString(n) + "/" + IntToString(need);
    DialogSetVisible(g_skipDlg, PlayerGroupAll(), true);
    // 玩家 2..13：按钮（能按）；说书人：同一位置只有一行字（无边框，跟聊天框一样）
    libNtve_gf_SetDialogItemText(g_skipBtn, StringToText(s), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_skipLbl, StringToText("快进提名票数 " + IntToString(n) + "/" + IntToString(need)), PlayerGroupSingle(g_teller));
    // 【按说书人判，不写死玩家号】（用户 2026-10-09）：换过说书人之后 1 号位就是普通玩家，他也要能投快进票。
    DialogControlSetVisible(g_skipBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_skipBtn, PlayerGroupSingle(g_teller), false);   // 说书人只读票数
    DialogControlSetVisible(g_skipLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_skipLbl, PlayerGroupSingle(g_teller), true);
}

// 清空票数（进提名阶段 / 新的一天 / 换局）
void BOTC_SkipReset () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        g_skipVote[p] = false;
    }
    BOTC_SkipRender();
}

// 点【快进到提名】：投票 / 再点一次取消；投满 80% 时智能说书人强制执行
void BOTC_SkipClick (int p) {
    int n;
    int need;
    if (g_who[p] == g_teller) {
        return;                        // 说书人没有这个投票（他那边是只读的票数）
    }
    if (!g_started || g_isNight || g_phase != 0) {
        BOTC_Notice(g_who[p], "现在不能投票：只有白天自由活动的时候能投（提名阶段和夜晚都不行）。");
        return;
    }
    if (!g_seatOn[p] || BOTC_SeatDead(p)) {
        return;
    }
    // 【防刷屏 · 快进冷却】（用户 2026-11-06）：投票和取消共用 5 秒冷却。
    if (g_skipCd[p] > 0) {
        BOTC_Notice(g_who[p], "【快进】按钮冷却中：还需 " + IntToString((g_skipCd[p] + 1) / 2) + " 秒。");
        return;
    }
    g_skipCd[p] = 10;
    g_skipVote[p] = !g_skipVote[p];
    n = BOTC_SkipCount();
    need = BOTC_SkipNeed();
    BOTC_SkipRender();
    if (g_skipVote[p]) {
        BOTC_PubAnnounce("【快进】" + BOTC_NameStr(p) + " 投票快进到提名阶段（" + IntToString(n) + "/" + IntToString(need) + "）。");
    }
    else {
        BOTC_PubAnnounce("【快进】" + BOTC_NameStr(p) + " 取消了快进票（" + IntToString(n) + "/" + IntToString(need) + "）。");
    }
    if (need <= 0 || n < need) {
        return;
    }
    // 真人说书人：只提示他票数够了，开不开由他自己决定
    BOTC_Notice(g_teller, "【快进】票数到 " + IntToString(n) + "/" + IntToString(need) + " 了：要不要开提名由你决定（点【进入提名环节】）。");
}

