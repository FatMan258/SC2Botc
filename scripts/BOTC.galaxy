    g_roleAct[127] = 0;
    // 利维坦没有主动夜间行动，但官网总表仍保留末尾提示位。
    g_noAllFirst[127] = 87;
    g_noAllOther[127] = 123;
    for (i = 0; i <= 13; i += 1) {
