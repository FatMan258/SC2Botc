// 【选板后的入场取名】（用户 2026-11-12；2026-11-13 改为输入框）：黑幕保持 20 秒，
// 屏幕中央显示输入框 + 【确认】；留空确认则随机取名。说书人看不到输入框，只显示等待文字。
void BOTC_BuildIntro () {
    DialogCreate(1000, 300, c_anchorCenter, 0, 0, false);
    g_introDlg = DialogLastCreated();
    DialogSetImageVisible(g_introDlg, false);
    DialogSetVisible(g_introDlg, PlayerGroupAll(), false);
    g_introTitleLbl = BOTC_NewLabelC(g_introDlg, 960, 64, 20, 28, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_introTitleLbl, g_bigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_introTitleLbl, false, PlayerGroupAll());
    g_introPromptLbl = BOTC_NewLabelC(g_introDlg, 960, 40, 20, 112, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_introPromptLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_introPromptLbl, false, PlayerGroupAll());
    g_introEdit = BOTC_NewEdit(g_introDlg, 460, 44, 190, 160);
    g_introBtn = BOTC_NewButton(g_introDlg, 140, 44, 670, 160, "确认");
    libNtve_gf_SetDialogItemStyle(g_introBtn, "ModLeftSize20Bold", PlayerGroupAll());
}

void BOTC_IntroRender () {
    int sec;
    string s;
    if (!g_introOn) {
        return;
    }
    sec = FixedToInt(TimerGetRemaining(g_tIntro) + 0.999);
    if (sec < 0) {
        sec = 0;
    }
    if (sec > 20) {
        sec = 20;
    }
    if (sec == g_introShownSec) {
        return;
    }
    g_introShownSec = sec;
    s = IntToString(sec) + " 秒";
    libNtve_gf_SetDialogItemText(g_tmLbl, TextWithColor(StringToText(s), Color(255, 215, 0)), PlayerGroupAll());
}

void BOTC_IntroBegin () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        g_introName[p] = "";
        g_introChosen[p] = false;
        g_introAnnounced[p] = false;
        g_introHinted[p] = false;
        g_dispName[p] = "";
    }
    g_introOn = true;
    g_introShownSec = -1;
    g_boardFade = 4;
    BOTC_BoardFadeRender();
    BOTC_HideAllUI();
    DialogSetVisible(g_menuBtnDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_preDlg, PlayerGroupAll(), false);
    for (p = 1; p <= 13; p += 1) {
        DialogSetVisible(g_jrBtnDlg[p], PlayerGroupAll(), false);
        // 20 秒取名期间只隐藏聊天框贴图与边框，不用文字底图遮住播报内容。
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupSingle(p), false);
        DialogSetVisible(g_chatFrameDlg[p], PlayerGroupSingle(p), false);
        DialogSetImageVisible(g_chatDlg[p], false);
        DialogSetVisible(g_chatDlg[p], PlayerGroupSingle(p), true);
    }
    // 【进入 20 秒时先清一次】选板页及 10 秒准备阶段的聊天记录不再带进取名阶段。
    BOTC_ClearAllLogs();
    libNtve_gf_SetDialogItemText(g_introTitleLbl, TextWithColor(StringToText("请为你的角色取名"), Color(255, 215, 0)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_introPromptLbl, StringToText("输入名字后点击【确认】；留空确认则使用随机名字。取名阶段禁止聊天。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_introEdit, StringToText(""), PlayerGroupAll());
    DialogControlSetVisible(g_introEdit, PlayerGroupAll(), true);
    DialogControlSetVisible(g_introBtn, PlayerGroupAll(), true);
    // 【说书人不取名】（用户 2026-11-13）：收起输入框，只显示等待文字。
    if (g_teller >= 1 && g_teller <= 13) {
        libNtve_gf_SetDialogItemText(g_introPromptLbl, StringToText("请等待其他玩家设置名称"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_introEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_introBtn, PlayerGroupSingle(g_teller), false);
    }
    // 倒计时移到输入框下方，避免和输入框 / 按钮重叠。
    DialogSetPosition(g_tmShowDlg, c_anchorCenter, 0, 110);
    libNtve_gf_SetDialogItemStyle(g_tmLbl, g_bigStyle, PlayerGroupAll());
    DialogSetVisible(g_tmShowDlg, PlayerGroupAll(), true);
    DialogSetVisible(g_introDlg, PlayerGroupAll(), true);
    TimerStart(g_tIntro, 20.0, false, c_timeGame);
    BOTC_IntroRender();
}

// 【取名阶段发言拦截】（用户 2026-11-13）：改用屏幕中央输入框取名，聊天发什么都不登记。
void BOTC_IntroTryMsg (int p, string msg) {
    if (!g_introHinted[p]) {
        g_introHinted[p] = true;
        BOTC_Notice(p, "取名阶段不能发言，请在屏幕中央输入框填写名字后点击【确认】。");
    }
}

bool BOTC_IsHexChar (string ch) {
    return BOTC_IsDigitChar(ch) ||
        ch == "a" || ch == "b" || ch == "c" || ch == "d" || ch == "e" || ch == "f" ||
        ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" || ch == "F";
}

bool BOTC_ValidColorName (string s) {
    int i;
    int n;
    int j;
    int depth;
    string chunk;
    string code;
    n = StringLength(s);
    i = 0;
    depth = 0;
    while (i < n) {
        chunk = StringSub(s, i, i + 1);
        if (chunk == "<") {
            if (i + 4 <= n && StringSub(s, i, i + 4) == "</c>") {
                depth = depth - 1;
                if (depth < 0) {
                    return false;
                }
                i = i + 4;
                continue;
            }
            if (i + 16 > n || StringSub(s, i, i + 8) != "<c val=\"") {
                return false;
            }
            code = StringSub(s, i + 8, i + 14);
            if (StringSub(s, i + 14, i + 15) != "\"" || StringSub(s, i + 15, i + 16) != ">") {
                return false;
            }
            for (j = 0; j < 6; j += 1) {
                if (!BOTC_IsHexChar(StringSub(code, j, j + 1))) {
                    return false;
                }
            }
            depth = depth + 1;
            i = i + 16;
            continue;
        }
        if (chunk == ">" || chunk == "@") {
            return false;
        }
        i = i + 1;
    }
    return depth == 0;
}

string BOTC_NameVisibleText (string s) {
    return BOTC_ChatNoColor(s);
}

bool BOTC_NameUsesOfficialName (string s) {
    int i;
    string visible;
    visible = BOTC_NameVisibleText(s);
    BOTC_NamePoolInit();
    for (i = 0; i < 37; i += 1) {
        if (s == g_namePool[i]) {
            return true;
        }
        if (visible == g_namePool[i]) {
            return true;
        }
    }
    return false;
}

// 【能否使用颜色代码】（用户 2026-11-13）：账号积分 >= 1000 才允许；否则确认时自动过滤颜色标签。
bool BOTC_IntroCanColor (int p) {
    if (p < 1 || p > 13 || PlayerType(p) != 1) {
        return false;
    }
    BOTC_BankEnsure(p);
    return BOTC_StatsPointGet(g_bank[p]) >= 1000;
}

void BOTC_IntroTryName (int p, string name) {
    int q;
    string oldName;
    bool hadName;
    if (!g_introOn || p < 1 || p > 13) {
        return;
    }
    if (p == g_teller) {
        BOTC_Notice(p, "说书人保持战网名，不能使用取名功能。");
        return;
    }
    // 【颜色代码门槛】（用户 2026-11-13）：积分不足 1000 时自动过滤掉颜色标签，只保留文字。
    if (!BOTC_IntroCanColor(p)) {
        name = BOTC_ChatNoColor(name);
    }
    if (StringLength(name) <= 0 || BOTC_TextWidth(name) <= 0 || BOTC_TextWidth(name) > 20) {
        BOTC_Notice(p, "名字不能为空，且最多 20 个显示字符（最多 10 个汉字）。");
        return;
    }
    if (!BOTC_ValidColorName(name)) {
        BOTC_Notice(p, "名字只支持 <c val=\"RRGGBB\">文字</c> 颜色标签，且不能包含 @。");
        return;
    }
    if (BOTC_NameUsesOfficialName(name)) {
        BOTC_Notice(p, "这个名字属于官方预设随机名，不能使用，请换一个。");
        return;
    }
    // 【重名 · 先到先得】（用户 2026-11-13）：按去掉颜色标签后的可见文字比较，先确认者占用。
    for (q = 1; q <= 13; q += 1) {
        if (q != p && g_introChosen[q] && StringLength(g_introName[q]) > 0 &&
            BOTC_NameVisibleText(g_introName[q]) == BOTC_NameVisibleText(name)) {
            BOTC_Notice(p, "这个名字已被其他玩家使用，请更换。");
            return;
        }
    }
    // 【第一次才播报进入小镇】（用户 2026-11-13）：用独立的已播报标记判断，
    //   改名永远只走「旧名字 改名成了 新名字」，不会重复触发「进入了小镇」。
    hadName = g_introAnnounced[p];
    oldName = g_introName[p];
    g_introName[p] = name;
    g_introChosen[p] = true;
    g_dispName[p] = name;
    libNtve_gf_SetDialogItemText(g_introPromptLbl, StringToText("已取名：" + name + "，倒计时结束前可继续修改。"), PlayerGroupSingle(p));
    if (hadName) {
        if (StringLength(oldName) > 0 && oldName != name) {
            BOTC_PubLinePlain(oldName + " 改名成了 " + name);
        }
    }
    else {
        g_introAnnounced[p] = true;
        BOTC_PubLinePlain(name + " 进入了小镇");
    }
}

// 【确认取名】（用户 2026-11-13）：读输入框；留空则随机取名。
void BOTC_IntroConfirm (int p) {
    string s;
    if (!g_introOn || p < 1 || p > 13) {
        return;
    }
    if (p == g_teller) {
        BOTC_Notice(p, "说书人保持战网名，不能使用取名功能。");
        return;
    }
    s = libNtve_gf_DialogItemEditValue(g_introEdit, p);
    if (StringLength(s) <= 0) {
        BOTC_IntroRandomName(p);
        return;
    }
    BOTC_IntroTryName(p, s);
}

// 【留空确认 → 随机名字】（用户 2026-11-13）：从名字库挑一个还没被占用的名字；已有名字则按改名播报。
void BOTC_IntroRandomName (int p) {
    string nm;
    string oldName;
    bool hadName;
    bool hadChosen;
    if (!g_introOn || p < 1 || p > 13 || p == g_teller) {
        return;
    }
    hadChosen = g_introChosen[p] && StringLength(g_introName[p]) > 0;
    hadName = g_introAnnounced[p];
    oldName = g_introName[p];
    g_introName[p] = "";
    g_introChosen[p] = false;
    g_dispName[p] = "";
    BOTC_RandomNameEnsure(p);
    nm = g_dispName[p];
    if (StringLength(nm) <= 0) {
        g_introName[p] = oldName;
        g_dispName[p] = oldName;
        g_introChosen[p] = hadChosen;
        return;
    }
    g_introName[p] = nm;
    g_introChosen[p] = true;
    libNtve_gf_SetDialogItemText(g_introPromptLbl, StringToText("已使用随机名字：" + nm + "，倒计时结束前可继续修改。"), PlayerGroupSingle(p));
    if (hadName) {
        if (StringLength(oldName) > 0 && oldName != nm) {
            BOTC_PubLinePlain(oldName + " 改名成了 " + nm);
        }
    }
    else {
        g_introAnnounced[p] = true;
        BOTC_PubLinePlain(nm + " 进入了小镇");
    }
}

void BOTC_IntroFinish () {
    int p;
    if (!g_introOn) {
        return;
    }
    g_introOn = false;
    DialogSetVisible(g_introDlg, PlayerGroupAll(), false);
    BOTC_FixedCountdownStop();
    BOTC_ShuffleSeats();
    BOTC_AssignRandomNames();
    g_boardFade = 0;
    BOTC_BoardFadeRender();
    BOTC_ShowAllUI();
    DialogSetVisible(g_menuBtnDlg, PlayerGroupAll(), true);
    // 【说书人名字 / 称号只在选剧本页显示】（用户 2026-11-13）：这里不再重新放出开局前提示，
    //   显隐统一交给 BOTC_NomUI 按 g_boardOpen 判断。
    BOTC_BluffTellerUI();
    BOTC_FakeBtnRender();
    BOTC_BsBtnRender();
    BOTC_NightApply();
    BOTC_PmVisRender();
    if (g_teller >= 1 && g_teller <= 13) {
        BOTC_GrimRender(g_teller);
    }
    for (p = 1; p <= 13; p += 1) {
        if (p != g_teller && PlayerType(p) != 0 && PlayerStatus(p) != 2) {
            BOTC_GrimRender(p);
        }
    }
    // 名字与座位已经应用完毕，阶段结束时第二次清空聊天。
    BOTC_ClearAllLogs();
}

bool BOTC_IntroTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_introOn) {
        BOTC_IntroFinish();
    }
    return true;
}

