        else {
            if (g_fearTarget != t) {
                BOTC_FearClear("换了目标");          // 官网：换目标后移除旧的「恐惧」
                g_fearTarget = t;
                if (t >= 2 && t <= 13) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + 121] = true;   // 官网：放到他选中的那个玩家的角色标记旁
                    BOTC_GrimRender(g_teller);
                }
                g_fearPending = true;      // 换了新目标：等白天再公开播报（用户 2026-10-03）
                BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(t) + "。");
            }
            else {
                BOTC_PmStore(g_teller, "【恐惧之灵】" + BOTC_NameStr(p) + " 又选了 " + BOTC_NameStr(t) + "（目标没变，不重复播报）。");
            }
        }
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // ===== 【何方教众（板子 9）· 新角色的技能结算】（用户 2026-10-10）=====
    // ■ 传教士（103）：选中一名玩家 → 他是爪牙（按登记层）就失去能力
    if (r == 103) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 中毒/酒鬼：没打标记。");
            return;
        }
        // 【只有「爪牙」才打这枚标记】（用户 2026-10-14 修）：原来这一行在 if 上面、**无条件**打 ----
        //   选中镇民 / 外来者也会给他挂上「失去能力（传教士）125」，而唤醒那边只认这枚 token，
        //   于是那名玩家**永远醒不过来**（官方口径：选中的不是爪牙 → 无事发生，见 g_tipLine[1994]）。
        if (BOTC_PairTeam(g_teller, t) == 2) {   // 【说书人视角】（用户 2026-10-11：原来写死观察者 1）
            g_tokOn[(((g_teller * 14) + t) * 256) + 125] = true;
            BOTC_GrimRender(g_teller);
            if (BOTC_HasAbility(t, 141)) {
                BOTC_PmInfo(g_who[t], "【维齐尔×传教士相克】你被传教士选中：失去能力，但白天仍然不会死亡。");
                BOTC_PmStore(g_teller, "【维齐尔×传教士相克】" + BOTC_NameStr(t) + " 失去能力并得知此事；白天免死仍保留。");
                BOTC_VizierSync();
            }
            else {
                BOTC_PmInfo(g_who[t], "【信息】你被传教士选中了：能力失效。");
                BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 选中爪牙 " + BOTC_NameStr(t) + "：失去能力。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【传教士】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "（" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(t)) + "）：不是爪牙 → 无事发生（没有打标记）。");
        }
        return;
    }
    // ■ 村夫（105）：选中一名玩家 → 弹说书人答题框（善良 / 邪恶），填完私聊发给他
    if (r == 105) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【村夫】" + BOTC_NameStr(p) + " 中毒/酒鬼：随便给。");
        }
        BOTC_ManInfoOpen(p, 105, BOTC_NameStr(t));
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉（跟将军同一个做法）
        return;
    }
    // ■ 半兽人（107）：选中一名存活玩家；他是善良 → 他死（夜间·非恶魔杀）且今晚恶魔不造成死亡
    if (r == 107) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 中毒/酒鬼：无效。");
            return;
        }
        if (!g_seatOn[t] || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 不是存活玩家，无事发生。");
            return;
        }
        // 【说书人拍板】（用户 2026-10-10）：半兽人的「善良即死」要判**登记层**，陌客 / 间谍这种会干扰登记，
        //   所以这里不自动结算 ---- 弹一个框问说书人：是 = 他死、今晚恶魔不造成死亡；否 = 恶魔正常出刀。
        g_lycanTgt = t;
        if (BOTC_SeatRegAlign(t) == 1) {
            BOTC_PmStore(g_teller, "【半兽人】" + BOTC_NameStr(p) + " 选的 " + BOTC_NameStr(t) + " 登记成邪恶（按规则不生效），你也可以自己裁定。");
        }
        BOTC_ManInfoOpen(p, 805, "");
        DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉（跟村夫同一个做法）
        return;
    }
    // ■ 解谜大师（109）：每局限一次，猜「谁是那个醉酒的人」→ 猜对给真恶魔，猜错弹框让说书人给假信息
    if (r == 109) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 中毒/酒鬼：这次不生效。");
            return;
        }
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 130]) {
            BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 这一局已经猜过了。");
            return;
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 130] = true;      // 「已猜测」：放他自己身上
        n = 0;                                                   // 那个醉酒的人在哪一格
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 129]) {
                n = i;
            }
        }
        BOTC_GrimRender(g_teller);
        if (n == t) {
            n2 = 0;                                              // 找一个活着的恶魔
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i] || BOTC_SeatDead(i)) { continue; }
                if (BOTC_SeatTeam(i) == 3) { n2 = i; }
            }
            if (n2 >= 2) {
                BOTC_PmInfo(g_who[p], "【信息】你得知" + BOTC_NameStr(n2) + "是恶魔。");
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜中：已告诉他 " + BOTC_NameStr(n2) + " 是恶魔。");
            }
            else {
                BOTC_PmStore(g_teller, "【解谜大师】" + BOTC_NameStr(p) + " 猜对，但没有活着的恶魔。");
            }
        }
        else {
            BOTC_ManInfoOpen(p, 109, "他猜的是 " + BOTC_NameStr(t) + "（猜错了）→ 填一条**错误**的「谁是恶魔」给他");
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_who[p]), false);   // 魔典会盖住说书人面板：先收掉
        }
        return;
    }
    // ■ 堤丰之首（111）/ 小怪宝（112）：恶魔刀（走通用的恶魔那一套：保护 / 士兵 / 免死都算）
    if (r == 111 || r == 112) {
        t = g_skillT1[p];
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        if (t < 2 || t > 13) {
            BOTC_Notice(g_who[p], "先点一个目标座位再确认。");
            return;
        }
        BOTC_DemonStrike(p, r, t, false);
        return;
    }
    if (r == 7) {
        // 僧侣：打「保护」标记，并记下今晚保护的是谁（天亮清标记、结算抗刀）
        //   被保护的人不会收到任何提示（规则如此）：标记只有说书人那份魔典上看得到
        if (!BOTC_SkillWorks(p)) {
            // 僧侣自己中毒 / 酒鬼：技能失效 ---- 连「保护」标记都不打，被保护的人也就没有。
            //   本人不当场知道（他以为自己保护成功了），只私聊告诉说书人
            BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次保护无效，没有打标记。");
        }
        else {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 9] = true;
            g_nightMonk = g_skillT1[p];
            g_nightMonkFrom = p;
            g_monkA = g_skillT1[p];
            g_monkNight = g_nightNum;
        }
    }
    if (r == 17) {
        // 投毒者：打「中毒」标记 ---- 智能说书判定读的就是这个标记，被毒的人以后去查别人得到的都是错的
        //   （不是别人看他出错）；中毒的人功能技能会失效，但夜里照常被唤醒
        if (!BOTC_SkillWorks(p)) {
            // 投毒者自己中毒 / 酒鬼 / 提线木偶：这一晚的毒无效（本人不当场知道，只私聊告诉说书人）
            BOTC_PmStore(g_teller, "【夜间】投毒者（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次投毒无效，没有打标记。");
        }
        else {
            // 换了目标：先把上一次毒的人收回来（同一个人就只刷新一下，不重复清）
            if (g_nightPoison >= 2 && g_nightPoison != g_skillT1[p]) {
                BOTC_PoisonClear("投毒者换了目标");
            }
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 7] = true;
            g_nightPoison = g_skillT1[p];
            g_poisonFrom = p;
            g_poisonDay = g_dayNum;
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(g_skillT1[p]) + " 中毒（投毒者：" + BOTC_NameStr(p) + "）。");
            BOTC_BartenderSync();
        }
    }
    if (r == 13) {
        // 管家：记下今晚的主人 ---- 明天提名阶段主人先投了「有罪票」，管家才能投有罪票
        //   （用户 2026-09-19）顺手把「主人」token 挪到新主人身上：先清掉上一次那位
        if (g_butlerMaster >= 2) {
            g_tokOn[(((g_teller * 14) + g_butlerMaster) * 256) + 20] = false;
        }
        g_butlerSeat = p;
        g_butlerMaster = g_skillT1[p];
        if (!BOTC_SkillWorks(p)) {
            // 中毒 / 酒鬼：技能失效（本人不当场知道），明天他可以随便投
            BOTC_PmStore(g_teller, "【夜间】管家（" + BOTC_NameStr(p) + "）中毒/酒鬼，这一次指定主人无效，明天他可以自由投票。");
        }
        else {
            g_tokOn[(((g_teller * 14) + g_butlerMaster) * 256) + 20] = true;      // 自动在主人身上打「主人」标记（说书人那份）
            BOTC_GrimRender(g_teller);
            BOTC_PmStore(g_teller, "【夜间】管家 " + BOTC_NameStr(p) + " 的主人是 " + BOTC_NameStr(g_butlerMaster) + "。");
        }
        BOTC_PmInfo(g_who[p], "【信息】你今晚的主人是 " + BOTC_NameStr(g_butlerMaster) + "：明天他投有罪票，你才能投有罪票，否则只能弃权。");
    }
    // ■ 水手（23）：谁醉由说书人点（【二选一醉酒】面板，用户 2026-10-16）----
    //   左边 = 水手他自己，右边 = 他选的那名玩家；点哪个哪个醉到下一个黄昏。
    //   原来那套「按概率表自动掷」是智能说书时代的，已经不走了；中毒 / 酒鬼也照弹面板（面板上有取消键）。
    if (r == 23) {
        t = g_skillT1[p];
        BOTC_DrunkPickOpen(0, p, p, t);
    }
    // ■ 侍女（24）：报「这两个人里有几个当晚因为自己的技能被唤醒」。
    //   说书人那份永远收到正确答案；智能说书直接把答案发给本人（中毒 / 酒鬼就报个错的）。
    if (r == 24) {
        n = 0;
        if (g_wokeTonight[g_skillT1[p]]) {
            n = n + 1;
        }
        if (g_wokeTonight[g_skillT2[p]]) {
            n = n + 1;
        }
        BOTC_PmStore(g_teller, "【侍女】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + " 和 " + BOTC_NameStr(g_skillT2[p]) + " → 正确答案：" + IntToString(n) + " 人。");
        BOTC_ManInfoOpen(p, 24, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
    // ■ 梦殒春宵（板子 3）：选完人之后要用答题框给信息的角色（用户 2026-09-21）
//   筑梦师（48）→ 自动配一对角色；女裁缝（55）→ 问「是不是同一阵营」
if (r == 48) {
    BOTC_ManInfoDreamer(p, g_skillT1[p]);
}
if (r == 116) {
    BOTC_PmStore(g_teller, "【郎中】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(g_skillT1[p]) + "：给他一个跟那个角色能力相关的词语（2~4 个字）。");
    BOTC_ManInfoOpen(p, 806, BOTC_NameStr(g_skillT1[p]));
}
if (r == 55) {
    if (BOTC_ProtectTokOn(p, 68)) {
        BOTC_PmStore(g_teller, "【女裁缝】" + BOTC_NameStr(p) + " 这一局已经用过了。");
    }
    else {
        g_tokOn[(((g_teller * 14) + p) * 256) + 68] = true;      // 失去能力（女裁缝）：用过就记上
        BOTC_GrimRender(g_teller);
        BOTC_ManInfoOpen(p, 55, BOTC_NameStr(g_skillT1[p]) + " / " + BOTC_NameStr(g_skillT2[p]));
    }
}
// ■ 舞蛇人（49）：选到真恶魔 → 两人交换角色与阵营，原恶魔永久中毒（用户 2026-09-21）
if (r == 49) {
    t = g_skillT1[p];
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次能力失效，没有交换。");
    }
    else {
        if (t < 2 || BOTC_SeatDead(t)) {
            BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选的目标无效（死了或没座位）。");
        }
        else {
            rt = BOTC_SeatTrueRole(t);
            // 【带小怪宝的人：交换的是他**那只爪牙**的身份，不是小怪宝本身】（用户 2026-10-14 两次更正）----
            //   · 小怪宝不是「会被发到座位上的角色」（除非疯子以为自己是它），所以绝不能把 112 写进座位；
            //   · 带着「是恶魔（小怪宝）134」的那一格，真身被 SeatTrueRole 读成 112，可交换要换的是他**原本那只爪牙**
            //     （魔典上写的那只）→ 这里改读 g_mark；
            //   · 换完之后由新恶魔（原舞蛇人）接手照看小怪宝：134 挪过去、g_lmSeat 也跟着改。
            nr = rt;
            snakeOk = true;
            snakeLm = false;
            if (g_lmOn && g_tokOn[(((g_teller * 14) + t) * 256) + 134]) {
                nr = g_mark[(g_teller * 14) + t] - 1;
                snakeLm = true;
                if (nr < 0 || nr > 163 || nr == 112) {
                    snakeOk = false;
                    BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "（他在照看小怪宝）：魔典上读不出他本来的爪牙身份 → 这一次没有交换。");
                }
            }
            // 【带宝的那位就是「恶魔」，不用再看他的角色队】（用户 2026-10-14 报「不是恶魔，无事发生」）----
            //   他的真身份是本来的**爪牙**（team 2），恶魔身份是靠 134 来的；所以这里必须跳过队判。
            if (snakeOk && !snakeLm && (nr < 0 || nr > 163 || BOTC_RoleTeam(nr) != 3)) {
                snakeOk = false;
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(t) + "：不是恶魔，无事发生。");
            }
            if (snakeOk) {
                // 【认知覆盖整包】（用户 2026-10-19）：两人「以为的身份 / 那枚 token」先记下来
                cogP = BOTC_CogTokOf(BOTC_SeatTrueRole(p));
                cogT = BOTC_CogTokOf(rt);
                cardP = g_mark[(g_teller * 14) + p] - 1;
                cardT = g_mark[(g_teller * 14) + t] - 1;
                // 【换给恶魔的角色 = 选人这位的真身】（用户 2026-10-12 修）：
                //   原来这里写死 49（舞蛇人）---- 可是这个能力可能是**哲学家(56) 借来的**
                //   （g_mark 显示成舞蛇人、真身仍是哲学家，BOTC_SeatTrueRole 会按"是哲学家"token 回 56），
                //   那种情况下原恶魔该变成**中毒的哲学家**，不该变成舞蛇人。
                nrP = BOTC_SeatTrueRole(p);
                if (nrP == 112) {
                    nrP = g_mark[(g_teller * 14) + p] - 1;     // 【舞蛇人自己带着小怪宝】（用户 2026-10-14）：同样忽略 134 那层
                }
                if (nrP < 0 || nrP > 163 || nrP == rt) {
                    nrP = 49;             // 兜底：真身读不出来（或跟恶魔同一个角色）时，退回原来的舞蛇人
                }
                // 【阵营检测】（用户 2026-10-02）：舞蛇人换恶魔 = 两人**交换阵营**。
                //   先记下交换前各自的阵营，换完按「对方原来的阵营」钉回来；
                //   两人阵营一样时（比如邪恶的舞蛇人换邪恶的恶魔）等于没换，谁都不动。
                alP = BOTC_SeatAlign(p);
                alT = BOTC_SeatAlign(t);
                BOTC_SetSeatRole(g_teller, p, nr);
                BOTC_SetSeatRole(g_who[p], p, nr);
                BOTC_SetSeatRole(g_teller, t, nrP);
                BOTC_SetSeatRole(g_who[t], t, nrP);
                // 【认知覆盖整包跟着换】（用户 2026-10-19）
                if (cogT >= 0) {
                    BOTC_PutCogCover(p, cardT, cogT);
                }
                if (cogP >= 0) {
                    BOTC_PutCogCover(t, cardP, cogP);
                }
                // 先把两人身上旧的「善良(14) / 邪恶(15)」标记撤掉，再按交换后的结果重新钉
                g_tokOn[(((g_teller * 14) + p) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + p) * 256) + 15] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 14] = false;
                g_tokOn[(((g_teller * 14) + t) * 256) + 15] = false;
                // 新恶魔（原舞蛇人）拿原恶魔的阵营；新舞蛇人（原恶魔）拿原舞蛇人的阵营。
                //   只有「新身份自带的阵营」跟要钉的不一样时才打 token（一样就不用打）
                if (BOTC_RoleAlign(nr) != alT) {
                    g_tokOn[(((g_teller * 14) + p) * 256) + (14 + alT)] = true;
                }
                if (BOTC_RoleAlign(nrP) != alP) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + (14 + alP)] = true;
                }
                BOTC_PairClearSeat(p);         // 阵营刚变 → 登记层缓存作废
                BOTC_PairClearSeat(t);
                g_tokOn[(((g_teller * 14) + t) * 256) + 85] = true;
                g_tokOn[(((g_teller * 14) + p) * 256) + 13] = true;
                // 【小怪宝跟着「现在的恶魔」走】（用户 2026-10-14）：换的是身份，照看权也跟着换 ----
                //   134 挪到新恶魔（原舞蛇人）身上、g_lmSeat 指向他；不然那一格还带着 134，会被继续当成恶魔（阵营 / 胜负都会错）。
                if (snakeLm) {
                    g_tokOn[(((g_teller * 14) + t) * 256) + 134] = false;
                    g_tokOn[(((g_teller * 14) + p) * 256) + 134] = true;
                    g_lmSeat = p;
                }
                g_autoWoke[p] = false;         // 新恶魔：当晚还要按恶魔那一格被唤醒
                g_testWoke[p] = false;
                g_autoWoke[t] = true;          // 原恶魔（现在换到的那个角色）：当晚到此为止，不再行动
                g_testWoke[t] = true;
                BOTC_GrimRender(g_teller);
                BOTC_GrimRender(g_who[p]);
                BOTC_GrimRender(g_who[t]);
                // 【统一身份转变提示】（用户 2026-10-01）：两人都走同一个函数（顺带写说书人日志）
                //   【认知覆盖】（用户 2026-10-19）：对方只说「他以为的身份」，不说酒鬼 / 提线木偶本体
                if (cogT >= 0) {
                    BOTC_ChangeRoleMsg(p, cardT);
                }
                else {
                    BOTC_ChangeRoleMsg(p, nr);
                }
                if (cogP >= 0) {
                    BOTC_ChangeRoleMsg(t, cardP);
                }
                else {
                    BOTC_ChangeRoleMsg(t, nrP);
                }
                if (cogP >= 0) {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[cardP] + "（永久中毒）。");
                }
                else {
                    BOTC_PmInfo(g_who[p], "【信息】" + BOTC_NameStr(t) + " 变成了" + BOTC_AlignName(BOTC_SeatAlign(t)) + "的" + g_roleName[nrP] + "（永久中毒）。");
                }
                BOTC_PmStore(g_teller, "【舞蛇人】" + BOTC_NameStr(p) + " 和 " + BOTC_NameStr(t) + " 交换了角色与阵营：" + BOTC_NameStr(p) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(p)) + g_roleName[nr] + "，" + BOTC_NameStr(t) + " 变成 " + BOTC_AlignName(BOTC_SeatAlign(t)) + g_roleName[nrP] + "并永久中毒。");
            }
        }
    }
}
// ■ 驱魔人（25）：点名一名玩家。点中恶魔 → 恶魔当晚不会因其自身能力被唤醒，并得知点名他的是驱魔人。
    //   判定**只认真身**（用户 2026-09-20）；点名不能与上一夜重复。
    if (r == 25) {
        t = g_skillT1[p];
        g_exoLast = t;
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】驱魔人（" + BOTC_NameStr(p) + "）中毒/酒鬼，这一次点名无效。");
        }
        else {
            // 相克记录：驱魔人昨晚实际选择的玩家，不论他是不是恶魔。
            g_exoJinxSeat = t;
            g_exoJinxNight = g_nightNum;
            if (BOTC_RegIsDemon(t)) {                 // 按「互动干扰」后的登记算（用户 2026-09-20）
                for (i = 2; i <= 13; i += 1) {
                    g_tokOn[(((g_teller * 14) + i) * 256) + 31] = false;     // 旧的「被点名」先全清掉
                }
                g_tokOn[(((g_teller * 14) + t) * 256) + 31] = true;
                g_exoBlock = t;
                g_exoNight = g_nightNum;
                g_exoFrom = p;
                BOTC_GrimRender(g_teller);
                BOTC_PmInfo(g_who[t], "【信息】你被驱魔人选中了。");
                if (BOTC_SeatTrueRole(t) == 44) {
                    BOTC_PukkaExorcistResolve(t);
                }
            }
            else {
                BOTC_PmStore(g_teller, "【驱魔人】" + BOTC_NameStr(p) + " 点名了 " + BOTC_NameStr(t) + "（" + BOTC_RoleNameSafe(BOTC_RegRoleOf(t)) + "）---- 不是恶魔，没有效果。");
            }
        }
    }
    // ■ 旅店老板（26）：两名目标今晚不会死亡；其中一人醉酒到下一个黄昏。
    //   谁醉由说书人点（【二选一醉酒】面板，用户 2026-10-16）；原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
    //   【中毒 / 醉酒时整条能力失效】（用户 2026-11-03）：不保护、不打醉酒标记，也不再弹选择窗。
    if (r == 26) {
        if (BOTC_SkillWorks(p)) {
            g_tokOn[(((g_teller * 14) + g_skillT1[p]) * 256) + 25] = true;
            g_tokOn[(((g_teller * 14) + g_skillT2[p]) * 256) + 25] = true;
            g_innA = g_skillT1[p];
            g_innB = g_skillT2[p];
            g_innNight = g_nightNum;
            g_drunkFrom = p;
            BOTC_GrimRender(g_teller);
            BOTC_DrunkPickOpen(1, p, g_skillT1[p], g_skillT2[p]);
        }
        else {
            BOTC_PmStore(g_teller, "【旅店老板】" + BOTC_NameStr(p) + " 中毒/醉酒，这一次能力无效：不保护、也不放醉酒标记。");
        }
    }
    // ■ 混沌（121）（用户 2026-10-16）：跟其它恶魔一样刀人；杀了「离他最近的两名镇民之一」→ 除旅行者外的全体善良中毒到下个黄昏。
    if (r == 121) {
        BOTC_DemonStrike(p, 121, g_skillT1[p], false);
        BOTC_HunDunCheck(p, g_skillT1[p]);
    }
    // ■ 逆臣（119）（用户 2026-10-16）：首夜选一名其他玩家 → 打「不共戴天」；谁先死于处决，另一方当晚转邪恶。
    if (r == 119) {
        t = g_skillT1[p];
        if (t >= 2 && t <= 13) {
            g_tcSeat = p;
            g_tokOn[(((g_teller * 14) + t) * 256) + 139] = true;
            BOTC_GrimRender(g_teller);
        }
    }
    // 玩家 + 角色组合技能：角色已经在同一面板中预选，确认后才结算。
    if (BOTC_ComboRole(r)) {
        BOTC_ComboResolve(p);
        return;
    }
    // ■ 教授（30）：复活一名已死亡的镇民（走现成的「复活」通道，复活后恢复一次性能力）。
    if (r == 30) {
        BOTC_ProfessorResolve(p, g_skillT1[p]);
    }
    // ■ 教父（39）：今天有外来者死亡时，当晚可以杀一个人（死因打「死亡（教父）」，不算恶魔杀）
    if (r == 39) {
        t = g_skillT1[p];
        // 【教父也吃这一条】（用户 2026-10-13）：中毒 / 酒鬼 / 提线木偶 → 这一刀不生效
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【教父】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次能力失效，没有记死亡。");
        }
        else {
            if (BOTC_GodfatherCanKill()) {
                BOTC_PmStore(g_teller, "【教父】今天有外来者死亡 → " + BOTC_NameStr(p) + " 可以动手。");
            }
            else {
                BOTC_PmStore(g_teller, "【提示】今天没有外来者死亡，按规则教父今晚不能杀人 ---- 你仍可以照记。");
            }
            BOTC_MarkDeathQuietSrc(t, 1, 0, 39);
        }
    }
    // ■ 魔鬼代言人（40）：选一名活人（不能连续两夜点同一个）→ 打「处决不死（魔鬼代言人）」token(27)，
    //   他明天被处决不会死（处决那边只提示、不硬拦 ---- 说书人是最终裁定者）。本人不被告知。
    if (r == 40) {
        t = g_skillT1[p];
        if (t == g_devAdvLast) {
            BOTC_Notice(g_who[p], "魔鬼代言人不能连续两夜点同一个人，换一个吧。");
            return;
        }
        if (!BOTC_SkillWorks(p)) {
            BOTC_PmStore(g_teller, "【夜间】魔鬼代言人（" + BOTC_NameStr(p) + "）中毒/酒鬼/提线木偶，这一次没有打「处决不死」标记。");
        }
        else {
            for (i = 2; i <= 13; i += 1) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 27] = false;      // 只保一个人：旧的先全清
            }
            g_tokOn[(((g_teller * 14) + t) * 256) + 27] = true;
            BOTC_GrimRender(g_teller);
        }
        g_devAdvLast = t;
    }
    // ■ 刺客（41）：每局限一次，选一名活人 → **直接死，无视一切保护**（用户 2026-09-20 定）。
    //   死因「死亡（刺客）」且**不算恶魔杀**（不触发祖母联动、不触发小恶魔传位）。
    if (r == 41) {
        t = g_skillT1[p];
        if (g_assiUsed[p]) {
            BOTC_Notice(g_who[p], "刺客的刺杀一局只能用一次，你已经用过了。");
            return;
        }
        g_assiUsed[p] = true;
        g_tokOn[(((g_teller * 14) + p) * 256) + 45] = true;             // 失去能力（刺客）
        BOTC_SkillBtnRender();
        // 【刺客 × 莽夫】（用户 2026-09-20）：刺客今夜第一个选中莽夫时，莽夫的醉酒**不挡这一刀** ----
        //   莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营就固定在邪恶。
        goonHit = (BOTC_HasAbility(t, 37) && g_goonBy == p);
        if (!BOTC_SkillWorks(p) && !goonHit) {
        }
        else {
            s = "";
            if (BOTC_ProtectTokOn(t, 9)) { s = s + "保护（僧侣） "; }
            if (BOTC_ProtectTokOn(t, 25)) { s = s + "不会死亡（旅店老板） "; }
            if (BOTC_ProtectTokOn(t, 26)) { s = s + "不会死亡（水手） "; }
            if (BOTC_ProtectTokOn(t, 27)) { s = s + "处决不死（魔鬼代言人） "; }
            if (BOTC_ProtectTokOn(t, 28)) { s = s + "处决不死（和平主义者） "; }
            if (BOTC_ProtectTokOn(t, 29)) { s = s + "首次未死（弄臣） "; }
            if (BOTC_ProtectTokOn(t, 51)) { s = s + "不会死亡（茶艺师） "; }
            if (BOTC_AbilityWorks(t, 23)) { s = s + "水手·清醒 "; }
            if (BOTC_AbilityWorks(t, 11)) { s = s + "士兵 "; }
            if (BOTC_AbilityWorks(t, 12)) { s = s + "镇长 "; }
            if (BOTC_AbilityWorks(t, 34)) { s = s + "弄臣 "; }
            if (s == "") {
                s = "（他身上本来没有保护）";
            }
            BOTC_PmStore(g_teller, "【刺客】" + BOTC_NameStr(p) + " 刺杀了 " + BOTC_NameStr(t) + " → 直接死亡，**无视一切保护**：" + s + "。");
            BOTC_MarkDeathQuietSrc(t, 1, 0, 41);
            if (goonHit) {
                BOTC_PmStore(g_teller, "【刺客 × 莽夫】刺客是今夜第一个选中莽夫的人 → 莽夫先被改成刺客的阵营（邪恶），随后被刺杀；莽夫死后能力失效，阵营**固定为邪恶**。");
            }
        }
    }
    // ■ 卡扎力（135）：除首夜外，每个夜晚选择一名玩家死亡
    if (r == 135) {
        BOTC_DemonStrike(p, 135, g_skillT1[p], false);
    }
    // ■ 僵怖（43）：今天没人死的夜晚才能动手（能不能唤醒已经在 BOTC_CanWakeAt 拦过了）
    if (r == 43) {
        BOTC_DemonStrike(p, 43, g_skillT1[p], false);
    }
    // ■ 普卡（44）：先把上一次的毒结算掉，再毒新的人
    if (r == 44) {
        BOTC_PukkaResolve(p, g_skillT1[p]);
    }
    // ■ 沙巴洛斯（45）：先反刍，再吃两个人
    if (r == 45) {
        BOTC_SabalosResolve(p, g_skillT1[p], g_skillT2[p]);
    }
    // ■ 珀（46）：平时 1 个目标；带「攻击三次（珀）」时 3 个
    if (r == 46) {
        BOTC_PoResolve(p, g_skillT1[p], g_skillT2[p], g_skillT3[p]);
    }
    // ■ 方古（68）：这一刀 + 「第一次杀死外来者 → 转化」
    if (r == 68) {
        BOTC_FangGuResolve(p, g_skillT1[p]);
    }
    // ■ 亡骨魔（69）：这一刀 + 「被杀爪牙保留能力 + 邻近镇民中毒（说书人挑）」
    if (r == 69) {
        BOTC_VigResolve(p, g_skillT1[p]);
    }
    // ■ 诺-达鲺（70）：这一刀（他的两份毒是常驻效果，黄昏统一重算）
    if (r == 70) {
        BOTC_DemonStrike(p, 70, g_skillT1[p], false);
        BOTC_NoDashiiSync();
    }
    // ■ 涡流（71）：这一刀（镇民信息必错 + 没人被处决就赢，都是常驻效果）
    if (r == 71) {
        BOTC_DemonStrike(p, 71, g_skillT1[p], false);
        BOTC_VortoxSync();
    }
    if (r == 21) {
        // 小恶魔：这里只记下今晚刀谁，等说书人点【进入白天】时再死人（见 BOTC_DawnResolve）
        g_nightImp = g_skillT1[p];
        g_nightImpFrom = p;
        if (g_demonTar < 2) {          // 【疯子 × 数学家】相克规则：小恶魔这一刀也算「真恶魔的目标」
            g_demonTar = g_skillT1[p];
            BOTC_MalfLunCheck();
        }
        if (g_skillT1[p] == p) {
            BOTC_PmStore(g_teller, "【夜间】小恶魔自刀了（" + BOTC_NameStr(p) + "）。");
        }
        // 当场结算这一刀（只记录，天亮再公开）：这样排在后面的守鸦人醒来时能读到死亡 token
        BOTC_ImpKillResolve(p, g_skillT1[p]);
    }
    if (r == 5) {
        BOTC_FtAnswer(g_who[p], g_skillT1[p], g_skillT2[p]);
    }
    if (g_hagKill && g_who[p] == g_teller) {
        // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：说书人定了谁死（0~2 个）
        BOTC_HagKill(1, g_skillT1[1], g_skillT2[1]);
        return;
    }
    if (g_twinPick && g_who[p] == g_teller) {
        // 镜像双子（64）：说书人在自己面板上点了谁当对立双子
        BOTC_TwinPickAt(g_skillT1[p]);
        return;
    }
    if (r == 65) {
        // 女巫（65）：确认 = 诅咒他
        BOTC_WitchApply(p, g_skillT1[p]);
    }
    if (r == 63) {
        // 呆瓜（63）：确认 = 公开选一名存活玩家（选到邪恶 → 他的阵营落败，用户 2026-09-21）
        BOTC_KlutzPick(p, g_skillT1[p]);
    }
    if (r == 36) {
        // 月之子（36）：确认 = 公开选择一名存活玩家（天亮结算他死不死）
        BOTC_MoonChildDeclare(p, g_skillT1[p]);
    }
    // 【守鸦人（8）的「自动发信息」仍然不发】（用户 2026-10-05）：答案由说书人自己看魔典给。
    // 【但「他选了谁」要提示说书人】（用户 2026-10-07）：确认这一刻把这句写进说书人私聊。
    if (r == 8 && g_skillT1[p] >= 2) {
        BOTC_PmStore(g_teller, "【守鸦人】" + BOTC_NameStr(p) + " 选择了 " + BOTC_NameStr(g_skillT1[p]) + "。");
        if (g_levJinxWake[p]) {
            g_levJinxWake[p] = false;
            g_levJinxLost[p] = true;
            BOTC_PmStore(g_teller, "【利维坦×守鸦人相克】守鸦人的能力已经触发 → 他本局失去能力。");
            BOTC_LeviathanSpecialSync();
        }
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

void BOTC_KillSeat (int q) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (BOTC_SeatDead(q)) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 9]) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被小恶魔选中，但他有「保护」，没有死。");
        return;
    }
    BOTC_MarkDeath(q, 1, 1);      // 夜间死亡 + 被恶魔击杀
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(q) + StringToText(" 死亡"));
    BOTC_BansheeAnnounce(q);
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 死亡 ----");
}

//==================================================================================================
// 夜间刀口结算（小恶魔 / 僧侣）
//   技能确认时只记下目标，等说书人点【进入白天】（天亮）才真的死人并播报昨晚的死亡信息：
//     僧侣保护的人 = 小恶魔今晚选的同一个人 → 不死，私人告诉说书人；
//     小恶魔把自己刀了 → 死；场上还有活着的爪牙就传位（智能说书随机，手动说书解锁身份编辑）；
//   僧侣的「保护」只算昨晚，天亮时标记一起清掉。
//==================================================================================================

// 这个座位在场、而且还没死
bool BOTC_SeatAliveQ (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_seatOn[q]) {
        return false;
    }
    return !BOTC_SeatDead(q);
}

// 这个座位（按说书人那份魔典上的身份）是不是爪牙
bool BOTC_SeatIsMinion (int q) {
    int r;
    if (q < 2 || q > 13) {
        return false;
    }
    r = g_mark[(g_teller * 14) + q] - 1;
    if (r < 0 || r > 163) {
        return false;
    }
    return (BOTC_RoleTeam(r) == 2);
}

// 活着的爪牙名单（传位时给说书人看）
string BOTC_MinionListStr () {
    int i;
    int q;
    int n;
    string s;
    BOTC_BuildSeatList();
    s = "";
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                if (n > 0) {
                    s = s + ",";
                }
                s = s + BOTC_NameStr(q);
                n = n + 1;
            }
        }
    }
    if (n == 0) {
        s = "（没有）";
    }
    return s;
}

// 清掉这一夜的记录（新局、天亮结算完都调用）
void BOTC_NightSkillReset () {
    int i;
    BOTC_TaotieClear();
    g_hagNoDemonKill = false;          // 【麻脸巫婆】恶魔刀无效只算造出恶魔的那一晚（用户 2026-09-21）
    g_lycanNoDemon = false;            // 【半兽人（107）】「今晚恶魔不造成死亡」只算今晚（用户 2026-10-10 补）
    g_kingAnnounced = 0;               // 【国王（104）】「谁是国王」发过的标记：每夜重新放开
    g_nightImp = 0;
    g_nightImpFrom = 0;
    g_nightMonk = 0;
    g_nightMonkFrom = 0;
    for (i = 2; i <= 13; i += 1) { g_levJinxWake[i] = false; }
    // 【疯子 × 数学家】相克规则的记录：一夜用完就清（用户 2026-09-21）
    g_lunTar = 0;
    g_lunSeat = 0;
    g_lunActed = false;
    g_demonTar = 0;
}

//==================================================================================================
// 恶魔击杀统一通道：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
//==================================================================================================
void BOTC_DemonStrike (int src, int srcRole, int q, bool selfPromote) {
    bool demonHandled;
    string blk;
    string who;
    // 【麻脸巫婆（67）】（用户 2026-09-21）：她今晚造出了恶魔 → 恶魔自己的刀一律无效，死亡改由说书人定
    if (g_hagNoDemonKill) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚恶魔自己的刀无效（她已经造出了一只恶魔）。");
        return;
    }
    // 【半兽人（107）】（用户 2026-10-10）：今晚他杀死了善良玩家 → 恶魔今晚不造成死亡
    if (g_lycanNoDemon) {
        BOTC_PmStore(g_teller, "【半兽人】今晚他杀死了善良玩家 → 恶魔这一刀不造成死亡。");
        return;
    }
    // 电脑自动行动等路径可能直接调用这里；若本次尚未经过掮客的前置改选，入口再兜一次。
    if (BOTC_BrokerActive() && src != g_brokerRedirectedBy) {
        if (q == g_brokerA) {
            q = g_brokerB;
        }
        else if (q == g_brokerB) {
            q = g_brokerA;
        }
    }
    if (BOTC_HeshangTryBlockSeat(src, srcRole, q)) {
        return;
    }
    // 【相克规则：疯子 × 数学家】（用户 2026-09-21）：记下真恶魔今晚的第一个目标
    if (g_demonTar < 2 && srcRole >= 0 && srcRole <= 163 && BOTC_RoleTeam(srcRole) == 3) {
        g_demonTar = q;
        BOTC_MalfLunCheck();
    }
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_seatOn[q]) {
        return;
    }
    who = BOTC_RoleNameSafe(BOTC_SeatTrueRole(src));
    if (BOTC_SeatDead(q)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）选的 " + BOTC_NameStr(q) + " 本来就死了，没再动他。");
        return;
    }
    // 【莽夫那一份醉酒】（用户 2026-09-20）：施术者的醉酒如果完全来自「今夜第一个选莽夫」这一下，
    //   那它只挡「打莽夫自己」的那一刀；打别的目标照旧生效（沙巴洛斯的另一个目标还死就是这个道理）。
    if (BOTC_SeatImpaired(src) && !(BOTC_GoonDrunkOnly(src) && q != g_goonSeat)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(src) + "（" + who + "）中毒/酒鬼，这一次的能力无效。");
        return;
    }
    // 【悟道者】：直接受到邪恶能力影响时，先变身；原本的击杀仍继续结算。
    BOTC_WudTryTrigger(q, src);
    // 僧侣按顺序排在他前面：这里能直接读到他的保护
    if (g_nightMonk == q) {
        if (!BOTC_SeatImpaired(g_nightMonkFrom)) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被僧侣保护住了，这一次没有生效。");
            return;
        }
        BOTC_PmStore(g_teller, "【夜间】僧侣（" + BOTC_NameStr(g_nightMonkFrom) + "）中毒/酒鬼，保护无效。");
    }
    // 【旅店老板 / 水手 / 弄臣 那些免死】统一走 BOTC_DeathBlocker（智能说书硬判）
    blk = BOTC_DeathBlocker(q, 1, 1, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 带着【" + blk + "】，这一次没有生效。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(q);
        }
        return;
    }
    // 士兵：免疫恶魔的刀（中毒 / 酒鬼时失效）
    if (BOTC_AbilityWorks(q, 11)) {
        BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 是士兵，免疫恶魔的刀。");
        return;
    }
    BOTC_MarkDeathQuietSrc(q, 1, 1, srcRole);
    if (g_mayorHold) {
        // 镇长（12）那一刀被挂起：等说书人在弹窗里拍板之后再继续（日志 / 祖母 / 传位 / 胜负）
        g_mayorHold = false;
        g_mayorAskSrc = src;
        g_mayorAskSrcRole = srcRole;
        return;
    }
    BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(src) + "（" + who + "）击杀。");
    BOTC_NanaLinkCheck(q);             // 祖母（22）：孙子被恶魔杀死，她也一起死
    // 恶魔死了：
    //   ① **自刀**（小恶魔自己那一刀）→ **红唇女郎优先**（她在、活着、清醒、恶魔死后活人 ≥4
    //      就必须是她顶上，不给说书人挑）；没有她才让说书人挑一名活着的爪牙接位（智能说书随机挑）
    //   ② 别的死法 / 别的恶魔杀的 → 同样是红唇女郎优先，没有她就交回调用方判胜负
    demonHandled = false;
    if (selfPromote) {
        demonHandled = BOTC_ScarletCheck();
        if (!demonHandled) {
            demonHandled = BOTC_ImpPromote();
        }
    }
    else {
        demonHandled = BOTC_ScarletCheck();
    }
    if (!demonHandled) {
        BOTC_CheckWin();
    }
}

// 小恶魔这一刀：在「确认目标」的当下就结算（记录死亡 / 保护 / 士兵免疫 / 镇长替死 / 传位 / 胜负）
//   死亡的「公开」（红叉 + 播报）留到天亮，见 BOTC_DawnResolve()。
//   这样按夜间顺序排在小恶魔后面的角色（守鸦人等）醒来时就能读到死亡 token 了。
void BOTC_ImpKillResolve (int imp, int q) {
    BOTC_DemonStrike(imp, 21, q, (q == imp));
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 8 批】（用户 2026-09-20）：43 僵怖 / 44 普卡 / 45 沙巴洛斯 / 46 珀
//   四个恶魔都走上面那条 BOTC_DemonStrike（保护 / 免死 / 士兵 / 镇长弹刀 / 祖母联动 / 传位 / 胜负）
//==================================================================================================

// 「今天有人死」：按**死亡发生的时间**算（用户 2026-09-20）----
//   白天死的都算（处决 / 白天技能杀 / 说书人手动标的，不管打的是哪种死因 token）；
//   夜里死的不算（记死亡时是夜里 → g_deadDay 记 0）。
//   教父（39）的「今天有外来者死亡」和僵怖（43）的「今天有人死」共用这一条。
bool BOTC_ExecutedDeathToday () {
    int q;
    if (g_dayNum <= 0 || !g_execUsedToday) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_exec[q]) {
            continue;
        }
        if (g_deadDay[q] != g_dayNum || g_deadKind[q] != 3) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            return true;
        }
    }
    return false;
}

bool BOTC_SomeoneDiedToday () {
    int q;
    if (g_dayNum <= 0) {
        return false;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (g_deadDay[q] == g_dayNum) {
            return true;                    // 白天死的都算（处决 / 技能杀 / 说书人手动标，任何死因 token 都行）
        }
    }
    return false;
}

// ■ 僵怖（43）：「第一次死亡时，你不会死」。
//   全桌照常看到「死亡」（天亮公播 + 红叉），但他其实还活着（内部一切按活人算，见 BOTC_SeatDead）。
//   返回值：true = 这次死亡被这一条吃掉了（调用方不要再记死亡）。
bool BOTC_ZombuulFake (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!BOTC_HasAbility(q, 43)) {
        return false;                       // 只有拥有僵怖能力才有这一条
    }
    // 中毒 / 酒鬼的僵怖：他的能力失效 ---- **这一次的死亡就是真死**，不消耗「第一次不会死」（用户 2026-09-20）
    if (!BOTC_AbilityWorks(q, 43)) {
        BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 中毒/酒鬼 → 「第一次不会死」这一条失效：这次照常真死。");
        return false;
    }
    if (g_zombUsed[q]) {
        // 那一次假死已经用掉：**这次的死亡是真死** ---- 顺手把「看起来死了其实活着」的状态撤掉
        //   （用户 2026-09-20：不撤的话他一直算活着，胜负和主谋的加时都判不出来）
        if (g_zombFake[q]) {
            g_zombFake[q] = false;
        }
        return false;
    }
    if (g_zombFake[q]) {
        return false;
    }
    g_zombUsed[q] = true;
    g_zombFake[q] = true;
    g_tokOn[(((g_teller * 14) + q) * 256) + 58] = true;   // 已假死（僵怖）
    if (g_isNight) {
        g_deadPending[q] = true;            // 夜里：等天亮统一公开「X 死亡」（全桌都当他死了）
    }
    else {
        g_deadShown[q] = true;              // 白天：当场公开红叉（播报由调用方负责）
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
        g_deadPending[q] = false;
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【僵怖】" + BOTC_NameStr(q) + " 第一次死亡 → 不会真的死：全桌照常看到「死亡」，但他其实还活着。");
    BOTC_PmStore(g_teller, "【僵怖】要真正杀死他：再记一次死亡就行。");
    BOTC_PmInfo(g_who[q], "【僵怖】你其实没有死，继续正常行动。");
    BOTC_ScarletAfterZombuul();
    return true;
}

// ■ 普卡（44）的毒：来源离场（他死了）就把毒收回来（用户 2026-09-20 的通用规则：
//   「任何角色离场 / 死亡，除非有特别说明，能力失效、它造成的 token 一起消失」）。
// 【恐惧之灵(102) 收「恐惧」】（用户 2026-10-03）：换目标 / 他死亡或离场时，把「恐惧」121 全部撤掉
void BOTC_FearClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 121]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 121] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【恐惧之灵】" + why + " → 已撤掉「恐惧」标记（" + IntToString(n) + " 人）。");
    }
}
// 【痢蛭(100) 收毒】（用户 2026-10-03）：痢蛭死亡 / 离场时，把所有人身上的「中毒（痢蛭）120」撤掉
void BOTC_LleechPoisonClear (string why) {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 120]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 120] = false;
            n = n + 1;
        }
    }
    if (n > 0) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【痢蛭】" + why + " → 已撤掉「中毒（痢蛭）」（" + IntToString(n) + " 人）。");
    }
}
void BOTC_PukkaPoisonClear (string why) {
    int q;
    q = g_pukkaSeat;
    g_pukkaSeat = 0;
    if (q < 2 || q > 13) {
        return;
    }
    if (g_tokOn[(((g_teller * 14) + q) * 256) + 63]) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 63] = false;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【中毒】" + BOTC_NameStr(q) + " 身上的普卡之毒已清掉。");
    }
}

// ■ 普卡（44）：「每个夜晚选择一名玩家：他中毒。上一个被选中的玩家会死亡，然后恢复健康。」
//   · 首夜也会行动（首夜顺序 5）；毒**不跟黄昏清**，一直挂到普卡下一次正常生效的行动
//   · 普卡在本次选择时能力不生效（中毒 / 醉酒 / 活尸 / 提线木偶等）：
//     新目标不中毒，g_pukkaSeat 保持上一次正常生效时的目标；下一次正常行动再结算他。
void BOTC_PukkaResolve (int p, int t) {
    int old;
    old = g_pukkaSeat;
    if (!BOTC_SkillWorks(p)) {
        if (old >= 2) {
            BOTC_PmStore(g_teller, "【普卡】" + BOTC_NameStr(p) + " 本次选择时能力不生效：" + BOTC_NameStr(t) + " 不会中毒；上一次正常生效时选择的 " + BOTC_NameStr(old) + " 仍保持中毒，下一次正常行动时才会毒发。");
        }
        else {
            BOTC_PmStore(g_teller, "【普卡】" + BOTC_NameStr(p) + " 本次选择时能力不生效：" + BOTC_NameStr(t) + " 不会中毒，也没有需要保留的上一目标。");
        }
        return;
    }
    // ① 先给新目标挂毒（用户 2026-09-20：普卡的刀是**先挂毒，然后再结算死亡**）
    BOTC_WudTryTrigger(t, p);
    g_tokOn[(((g_teller * 14) + t) * 256) + 63] = true;      // 中毒（普卡）（用户 2026-09-20）
    g_pukkaSeat = t;
    BOTC_GrimRender(g_teller);
    // ② 再结算「上一次被毒的人」：他毒发身亡，然后恢复健康（这一份毒收掉）
    if (old >= 2) {
        // 【顺序】（用户 2026-09-20 确认）：**先结算死亡，再恢复健康** ----
        //   死亡这一刻他身上的「中毒」标记还在（所以「清醒才免死」那类保护，比如水手 / 弄臣，这时候是不生效的），
        //   死完之后才把中毒 token 撤掉。
        if (!BOTC_SeatDead(old)) {
            BOTC_DemonStrike(p, 44, old, false);
        }
        if (g_tokOn[(((g_teller * 14) + old) * 256) + 63]) {
            g_tokOn[(((g_teller * 14) + old) * 256) + 63] = false;
            BOTC_GrimRender(g_teller);
        }
        if (old == t) {
            // 同一个目标：老的毒已经结算掉（恢复健康），不再挂账
            g_pukkaSeat = 0;
        }
    }
}

// 【驱魔人 × 普卡】：普卡今晚不能选新目标，但上一名由普卡正常选中的玩家仍会毒发。
// 死亡统一走恶魔击杀通道，因此会使用普卡的专属死因 token 21；毒发后撤掉中毒（普卡）。
// 普卡自身能力不生效时，旧目标不死亡，且继续保持普卡之毒。
void BOTC_PukkaExorcistResolve (int p) {
    int old;
    if (p < 2 || p > 13) {
        return;
    }
    old = g_pukkaSeat;
    if (!BOTC_SkillWorks(p)) {
        if (old >= 2) {
            BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 当前能力不生效；上一目标 " + BOTC_NameStr(old) + " 不会死亡，并继续保持普卡之毒。");
        }
        else {
            BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 当前能力不生效，也没有需要结算的上一目标。");
        }
        return;
    }
    if (old < 2) {
        BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 今晚被驱魔，无法选择新目标；目前没有上一目标需要毒发。");
        return;
    }
    if (!BOTC_SeatDead(old)) {
        BOTC_DemonStrike(p, 44, old, false);
    }
    if (g_tokOn[(((g_teller * 14) + old) * 256) + 63]) {
        g_tokOn[(((g_teller * 14) + old) * 256) + 63] = false;
        BOTC_GrimRender(g_teller);
    }
    g_pukkaSeat = 0;
    BOTC_PmStore(g_teller, "【驱魔人 × 普卡】" + BOTC_NameStr(p) + " 今晚不选择新目标；上一目标 " + BOTC_NameStr(old) + " 毒发（死亡标记：普卡），随后撤掉中毒（普卡）。");
}

// ■ 沙巴洛斯（45）：反刍（复活一名上一夜吃掉、现在还死着的玩家）
void BOTC_SabalosRevive (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    // 【复活也等天亮统一结算】（用户 2026-09-20）：公开死亡的那种只在夜里记「复活（沙巴洛斯）」标记，
    //   红叉留到天亮再统一清掉 + 公布「【复活】」；还没公开的（同一夜刚死）照旧静默取消。
    if (BOTC_PublicDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = true;   // 复活（沙巴洛斯）：天亮统一结算
    }
    else {
        BOTC_ClearDeath(q);                     // 还没公开（比如同一夜刚死）：静默取消，不播报
        BOTC_RestoreOneShot(q);                 // 静默复活同样是「重新进场」
    }
    g_sabChosen[q] = false;                 // 这一个候选用掉了（以后不再反刍他）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 " + BOTC_NameStr(q) + "：红叉留到天亮统一公布「【复活】」。");
}

// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · 候选 = 上一夜吃掉、现在还死着的两个人
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 善良角色尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · 一局限一次；从他能行动的那一夜算起 0%，之后每夜 +25%（0 / 25 / 50 / 75 / 100%）
//   · **候选 = 他以前选过的所有人里、现在还死着的**（用户 2026-09-20）----
//     不一定是被他杀的：例如他选了莽夫、自己醉了什么都没发生，莽夫第二天被处决，之后一样可以反刍
//   · 决胜轮（场上活着 ≤ 4 人）复活「落后的一方」，平时邪恶优先
//   · 想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
// 智能说书挑反刍对象：返回 0 = 这次不反刍；否则返回要复活的座位
//   · **概率按「双刀次数」算**（用户 2026-09-20）：每当有 2 个人在同一天死于沙巴洛斯的刀就记一次，
//     初始 0%，**第一次双刀也是 0%**，从第二次双刀起每多一次 +25%（0 / 25 / 50 / 75 / 100），封顶 100%
//   · 一局限一次（`g_sabRegurgDone`）
//   · **决赛圈（场上活着 ≤ 4 人）必复活** ---- 但前提是概率不是 0（也就是至少开过 2 次双刀）
//   · **自称是「教授」时**：第一次有机会复活（第 3 夜起、已经有死掉的候选人）→ 必定复活（演得像教授）
//   · 候选 = 他以前选过的所有人里、现在还死着的；挑人优先级：决胜轮复活落后一方 / 平时邪恶优先 /
//     想复活善良时尽量避开「每局限一次」的那几个（猎手 / 侍臣 / 教授 / 刺客）
int BOTC_SabalosRegurgPick (int p) {
    int q;
    int i;
    int n;
    int k;
    int pick;
    int chance;
    int evilAlive;
    int goodAlive;
    int alive;
    bool wantEvil;
    bool force;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (g_sabRegurgDone[p]) {
        return 0;                       // 一局只能发动一次
    }
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        n = n + 1;
    }
    if (n <= 0) {
        return 0;                       // 没有候选：没有什么可反刍的
    }
    chance = (g_sabDouble - 1) * 25;
    if (chance > 100) {
        chance = 100;
    }
    // 场上活着的人数（按公开死亡 / 红叉算，跟判胜负一个口径）
    alive = 0;
    evilAlive = 0;
    goodAlive = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (BOTC_SettledDead(q)) {
            continue;
        }
        alive = alive + 1;
        if (BOTC_SeatAlign(q) == 0) {
            goodAlive = goodAlive + 1;
        }
        else {
            evilAlive = evilAlive + 1;
        }
    }
    force = false;
    if (alive <= 4 && chance > 0) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】决赛圈 → 这一次必定反刍。");
    }
    if (g_claim[p] == 30 && g_nightNum >= 3) {
        force = true;
        BOTC_PmStore(g_teller, "【沙巴洛斯】他自称是「教授」→ 第一次有机会复活时必定反刍。");
    }
    if (!force) {
        if (chance <= 0) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次不反刍。");
            return 0;
        }
        if (RandomInt(1, 100) > chance) {
            BOTC_PmStore(g_teller, "【沙巴洛斯】这次没反刍。");
            return 0;
        }
    }
    wantEvil = true;
    if (alive <= 4) {
        if (evilAlive > goodAlive) {
            wantEvil = false;              // 决胜轮：邪恶已经占优 → 改帮善良那一方
        }
    }
    pick = 0;
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || !g_sabChosen[q]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        if (wantEvil) {
            if (BOTC_SeatAlign(q) != 1) {
                continue;
            }
        }
        else {
            if (BOTC_SeatAlign(q) != 0) {
                continue;
            }
            if (BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                continue;
            }
        }
        n = n + 1;
    }
    if (n > 0) {
        k = RandomInt(1, n);
        i = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (wantEvil) {
                if (BOTC_SeatAlign(q) != 1) {
                    continue;
                }
            }
            else {
                if (BOTC_SeatAlign(q) != 0) {
                    continue;
                }
                if (BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                    continue;
                }
            }
            i = i + 1;
            if (i == k) {
                pick = q;
                break;
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                if (BOTC_SeatAlign(q) == 0 && BOTC_OneShotRole(BOTC_SeatTrueRole(q))) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        n = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || !g_sabChosen[q]) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            n = n + 1;
        }
        if (n > 0) {
            k = RandomInt(1, n);
            i = 0;
            for (q = 2; q <= 13; q += 1) {
                if (!g_seatOn[q] || !g_sabChosen[q]) {
                    continue;
                }
                if (!BOTC_SeatDead(q)) {
                    continue;
                }
                i = i + 1;
                if (i == k) {
                    pick = q;
                    break;
                }
            }
        }
    }
    if (pick <= 0) {
        return 0;
    }
    g_sabRegurgDone[p] = true;
    BOTC_PmStore(g_teller, "【沙巴洛斯】反刍 → 复活 " + BOTC_NameStr(pick) + "（" + BOTC_AlignName(BOTC_SeatAlign(pick)) + "）。");
    return pick;
}

// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，他上一夜吃掉的一名玩家可能被反刍。」
//   ---- 先反刍，再吃两个人。
//   反刍谁定：真人说书只提示（他自己用【死亡标记】/ 复活处理）；智能说书按概率自动掷。
// ■ 沙巴洛斯（45）：「每个夜晚选择两名玩家：他们死亡。下一个夜晚，一名他选过的玩家可能被反刍。」
//   ---- 先反刍，再吃两个人；**反刍要在「选目标 / 杀人」之前判定**（用户 2026-09-20）。
void BOTC_SabalosResolve (int p, int t1, int t2) {
    int pick;
    int goonPos;
    int i;
    int diedN;
    bool wasA;
    bool wasB;
    string s;
    s = "";
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || !g_sabChosen[i]) {
            continue;
        }
        if (!BOTC_SeatDead(i)) {
            continue;
        }
        if (StringLength(s) > 0) {
            s = s + " ";
        }
        s = s + BOTC_NameStr(i);
    }
    if (StringLength(s) <= 0) {
        s = "无";
    }
    BOTC_PmStore(g_teller, "待复活玩家：" + s);
    BOTC_PmStore(g_teller, "放置复活（沙巴洛斯）token以反刍。");
    if (t1 >= 2) {
        g_sabChosen[t1] = true;         // 先记进候选池：以后一样可以被反刍（用户 2026-09-20）
    }
    if (t2 >= 2) {
        g_sabChosen[t2] = true;
    }
    g_sabA = t1;
    g_sabB = t2;
    if (BOTC_SeatImpaired(p) && !BOTC_GoonDrunkOnly(p)) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 今晚吃人无效：这两个人都不死。");
        return;
    }
    // 【按目标顺序结算】（用户 2026-09-20）：莽夫是「被他选中的那一刻」才让施术者醉酒的 ----
    //   · 目标1 = 莽夫 → 当场醉酒：莽夫自己那一口不算，**排在他后面的目标2 也不再结算**
    //   · 目标2 = 莽夫 → 目标1 排在前面、早就结算完了，照常死（莽夫自己那一口照旧不算）
    goonPos = 0;
    if (BOTC_GoonDrunkOnly(p)) {
        if (t1 == g_goonSeat) {
            goonPos = 1;
        }
        else {
            if (t2 == g_goonSeat) {
                goonPos = 2;
            }
        }
    }
    if (goonPos == 1) {
        BOTC_PmStore(g_teller, "【沙巴洛斯】目标1 是莽夫（" + BOTC_NameStr(g_goonSeat) + "）→ 他当场醉酒：莽夫自己那一口不算，排在他后面的目标2 也不再结算。");
        BOTC_GrimRender(g_teller);
        return;
    }
    BOTC_PmStore(g_teller, "【沙巴洛斯】" + BOTC_NameStr(p) + " 今晚吃了 " + BOTC_NameStr(t1) + " 和 " + BOTC_NameStr(t2) + "。");
    wasA = BOTC_SeatDead(t1);
    wasB = false;
    if (t2 >= 2) {
        wasB = BOTC_SeatDead(t2);
    }
    BOTC_DemonStrike(p, 45, t1, false);
    if (t2 >= 2) {
        BOTC_DemonStrike(p, 45, t2, false);
    }
    // 【累计一次「双刀」】（用户 2026-09-20）：这一夜真的有 2 个人死于他的刀
    diedN = 0;
    if (!wasA && BOTC_SeatDead(t1)) {
        diedN = diedN + 1;
    }
    if (t2 >= 2 && !wasB && BOTC_SeatDead(t2)) {
        diedN = diedN + 1;
    }
    if (diedN >= 2) {
        g_sabDouble = g_sabDouble + 1;
    }
}

// ■ 珀（46）：「每个夜晚选择一名玩家：他死亡。如果你选择不杀人，下一个夜晚你必须选择三名玩家。」
//   计数完全由 token 52「攻击三次（珀）」驱动（说书人也能自己打 / 撤）。
void BOTC_PoResolve (int p, int t1, int t2, int t3) {
    int goonPos;
    if (BOTC_ProtectTokOn(p, 52)) {
        BOTC_PmStore(g_teller, "【珀】今晚是「攻击三次」：三个人一起死。");
        // 【按目标顺序结算】（用户 2026-09-20）：排到莽夫之后的目标不再结算（莽夫自己那一口也不算）
        goonPos = 0;
        if (BOTC_GoonDrunkOnly(p)) {
            if (t1 == g_goonSeat) {
                goonPos = 1;
            }
            else {
                if (t2 == g_goonSeat) {
                    goonPos = 2;
                }
                else {
                    if (t3 == g_goonSeat) {
                        goonPos = 3;
                    }
                }
            }
        }
        if (goonPos != 0) {
            BOTC_PmStore(g_teller, "【珀】莽夫（" + BOTC_NameStr(g_goonSeat) + "）排在他选的第 " + IntToString(goonPos) + " 个 → 从莽夫开始（含他自己）都不结算，排在后面的目标也不再死。");
        }
        if (goonPos == 0 || goonPos > 1) {
            BOTC_DemonStrike(p, 46, t1, false);
        }
        if (t2 >= 2) {
            if (goonPos == 0 || goonPos > 2) {
                BOTC_DemonStrike(p, 46, t2, false);
            }
        }
        if (t3 >= 2) {
            if (goonPos == 0) {
                BOTC_DemonStrike(p, 46, t3, false);
            }
        }
        g_tokOn[(((g_teller * 14) + p) * 256) + 52] = false;      // 打完了，标记撤掉
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【珀】「攻击三次」已经用掉，标记撤掉。");
    }
    else {
        BOTC_DemonStrike(p, 46, t1, false);
    }
}

// 技能面板用的「这个角色这次要选几个目标」：珀带「攻击三次」时是 3，其余照角色表
// ■ 镜像双子（64）：「你与一名对立阵营的玩家互相知道对方是什么角色。如果其中善良玩家被处决，邪恶阵营获胜。
//   如果你们都存活，善良阵营无法获胜。」配对由**说书人**点，身份由脚本**自动**告诉两人（用户 2026-09-21）。
// 【双子 · 一切以 token 为准】（用户 2026-09-22）：76 = 镜像双子本人、77 = 对立双子
int BOTC_TwinSeatOf (int tok) {
    int i;
    for (i = 13; i >= 1; i -= 1) {
        if (i > 1 && !g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + tok]) {
            return i;
        }
    }
    return 0;
}

// 【双子能力有没有生效】（用户 2026-09-22）：镜像双子活着（或带「保留能力」）且不醉酒、不中毒 ----
//   失效时：没有特胜、也不发「你的对立双子是谁」的信息（等他清醒再补）
bool BOTC_TwinActive () {
    int a;
    a = BOTC_TwinSeatOf(76);
    if (a < 2) {
        return false;
    }
    if (BOTC_SeatImpaired(a)) {
        return false;
    }
    if (BOTC_SeatDead(a) && !BOTC_KeepsAbilityAlive(a)) {
        return false;
    }
    return true;
}

bool BOTC_TwinBlocksGood () {
    if (!BOTC_TwinActive()) {
        return false;                       // 【以 token 为准 + 醉酒/中毒即失效】（用户 2026-09-22）
    }
    if (BOTC_SeatTrueRole(g_twinA) != 64) {
        return false;                       // 那只镜像双子被改了身份 / 离场 → 能力没了
    }
    // 【亡骨魔的「保留能力」】（用户 2026-09-21）：被亡骨魔杀死的双子死后能力还在 →
    //   这一对照样算「都在」，处决善良那只一样是邪恶胜（百科就是这么写的）。
    if (BOTC_TwinSeatOf(77) < 2) {
        return false;
    }
    if (BOTC_SeatDead(BOTC_TwinSeatOf(77)) && !BOTC_KeepsAbilityAlive(BOTC_TwinSeatOf(77))) {
        return false;                       // 对立双子死了、而且没保留能力 → 能力没了
    }
    return true;
}

// 【镜像双子这一格现在算不算「中毒 / 酒鬼 / 带信息错误（涡流）」】（用户 2026-10-14）----
//   ⚠ 只看**镜像双子本人那一格**（含后来借到这个能力的人：炼金 123 / 哲学家 70 / 食人族 97 都读得到）；
//     **对立双子身上有没有标记一概不管**（用户 2026-10-14 明确）。
//   命中时：配对 token 76 / 77 脚本不代打，身份信息**只发镜像双子本人**，对立双子那边不说。
bool BOTC_TwinBadInfo (int a) {
    if (a < 2) {
        return true;
    }
    if (!BOTC_SkillWorks(a)) {
        return true;
    }
    if (BOTC_InfoErrorOn(a)) {
        return true;
    }
    return false;
}
// 【把两人的身份互相告诉对方】（用户 2026-09-21；2026-10-14 恢复「清醒就照旧发两边」）----
//   ⚠ 带「中毒 / 酒鬼 / 信息错误（涡流）」的镜像双子**不走这里**：那种只发给镜像双子本人（见 BOTC_TwinBadInfo 那两支）。
void BOTC_TwinNightInfo () {
    int ra;
    int rb;
    if (g_twinA < 2 || g_twinB < 2) {
        return;
    }
    ra = BOTC_SeatTrueRole(g_twinA);
    rb = BOTC_SeatTrueRole(g_twinB);
    if (ra < 0 || rb < 0) {
        return;
    }
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(g_twinB) + "是" + g_roleName[rb] + "。");
    BOTC_PmInfo(g_who[g_twinB], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[ra] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(g_twinB) + "）。");
}

void BOTC_TwinPickAt (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return;
    }
    if (g_twinA < 2) {
        BOTC_Notice(g_teller, "场上还没有镜像双子。");
        return;
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinPick = false;
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）：token 不代打，信息只发他本人。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(q)) + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_TwinNightInfo();
}
// ■ 女巫（65）：「每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。」
//   提示标记「被诅咒」：夜晚行动后放置（她醉/中毒时不放）；黄昏、或女巫死亡/离场时移除（官方时机）。
void BOTC_WitchCurseClear (string why) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 73]) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 73] = false;
        }
    }
    g_witchCurse = 0;
    BOTC_GrimRender(g_teller);
}

void BOTC_WitchApply (int p, int q) {
    if (p < 1 || p > 13 || q < 2 || q > 13 || !g_seatOn[q]) {     // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_witchFrom = p;
    if (!BOTC_WitchCanAct(p)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次没有下咒。");
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(p) + " 中毒/酒鬼/提线木偶 → 这一次不放置「被诅咒」标记。");
        return;
    }
    BOTC_WitchCurseClear("女巫换了目标");
    g_witchCurse = q;
    g_tokOn[(((g_teller * 14) + q) * 256) + 73] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【女巫】诅咒了 " + BOTC_NameStr(q) + "：他明天白天一旦发起提名就会死亡。");
}

// 被诅咒的人发起提名 → 立刻死（提名照常继续；不算恶魔杀）
void BOTC_WitchNomCheck (int by) {
    int ob;
    string blk;
    if (by < 2 || by > 13 || g_witchCurse != by) {
        return;
    }
    if (g_witchFrom >= 2 && !BOTC_WitchCanAct(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】只剩 3 名存活玩家 → 女巫能力已经失效，这次诅咒不触发。");
        return;
    }
    if (g_witchFrom >= 2 && BOTC_SeatImpaired(g_witchFrom)) {
        BOTC_PmStore(g_teller, "【女巫】女巫中毒/酒鬼 → 这次诅咒不生效。");
        return;
    }
    // 【免死 / 保护】（用户 2026-09-21）：他免疫死亡 → 什么都不发生（不打红叉、公屏一个字都不播）
    blk = BOTC_DeathBlocker(by, 2, 0, false);
    if (blk != "") {
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(by);
        }
        BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 带着【" + blk + "】→ 这一次没有死（公屏什么都不会播）。");
        return;
    }
    // 【当场死 = 当场盖红叉】（用户 2026-09-21）：走「白天死亡 + 非恶魔杀」那一格，死因是「死亡（女巫）」
    BOTC_MarkDeathQuietSrc(by, 2, 0, 65);
    g_deadShown[by] = true;
    if (!BOTC_DeathSfxMute(by)) {
        BOTC_PlaySfx("Marine_Death");      // 【红叉音效】（用户 2026-09-22）：有人被打上红叉（含自动打）就放一声
    }
    g_deadPending[by] = false;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 公屏只播「X 死亡」（不提女巫，谁都不知道是他干的，用户 2026-09-21）
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(by) + StringToText(" 死亡"));
    BOTC_PmStore(g_teller, "【女巫】" + BOTC_NameStr(by) + " 因诅咒死亡（他的提名照常继续）。");
    BOTC_DiagStore(g_teller, "【诊断】" + BOTC_NameStr(by) + " 被女巫诅咒致死（公屏只播了「死亡」）。");
    BOTC_CheckWin();
}

// 只剩三名存活玩家 → 女巫失去能力、诅咒立刻解除（用户 2026-09-21：自动）
bool BOTC_WitchCanAct (int p) {
    if (p < 1 || p > 13) {
        return false;
    }
    if (g_witchLost) {
        return false;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只有 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只有 3 人 → 女巫能力永久失效，诅咒已解除。");
        return false;
    }
    return true;
}

void BOTC_WitchSync () {
    int i;
    int n;
    if (g_witchFrom < 2 && g_witchCurse < 2) {
        return;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SeatDead(g_seatList[i])) {
            n = n + 1;
        }
    }
    if (n <= 3) {
        g_witchLost = true;
        if (g_witchCurse >= 2) {
            BOTC_WitchCurseClear("存活人数只剩 3 人，女巫失去能力");
        }
        BOTC_PmStore(g_teller, "【女巫】存活人数只剩 3 人 → 她从现在起失去能力（之后不用再唤醒她）。");
    }
}
// ■ 洗脑师（66）：「每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，
//   不然他可能被处决。」疯狂本身不做判定（纯 token，用户 2026-09-21）---- 脚本只打标记 + 自动告诉目标。
// 【相克 · 洗脑师（66）× 哥布林（99）】（用户 2026-10-14）：洗脑师只能选 **善良角色 + 哥布林** ----
//   百科口径：「洗脑师与哥布林：洗脑师可以选择将玩家洗脑成哥布林。」（脚本相克表 g_jinxText[49] 那条）
//   所以先按「只列善良」筛一遍，再把哥布林那一格单独放出来；其它爪牙 / 恶魔仍然点不到。
void BOTC_CerenShowGoblin (int p) {
    int q;
    for (q = 0; q < g_gridN; q += 1) {
        if (g_gridSlot[q] != 99) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), true);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), true);
    }
}
void BOTC_CerenOpen (int p) {
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_cerenPick = true;
    g_pickMode[g_who[p]] = 14;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], true);          // 先只列善良角色
    BOTC_CerenShowGoblin(g_who[p]);           // 【相克】再把哥布林单独放出来（别的爪牙 / 恶魔仍然点不到）
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

void BOTC_CerenApply (int who, int role) {
    if (who < 1 || who > 13 || role < 0 || role > 163) {    // 允许 1（用户 2026-09-21）
        return;
    }
    g_cerenWho = who;
    g_cerenRole = role;
    g_cerenPick = false;
    g_tokOn[(((g_teller * 14) + who) * 256) + 71] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【洗脑师】你明天白天和夜晚都要「疯狂」地证明自己是" + g_roleName[role] + "，不然可能被处决。");
    BOTC_PmStore(g_teller, "【洗脑师】已让 " + BOTC_NameStr(who) + " 疯狂证明自己是" + g_roleName[role] + "。");
    BOTC_PmStore(g_teller, "【洗脑师】他没做到的话，你可以处决他（占用当天处决名额）。");
}
// ■ 麻脸巫婆（67）：「每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。
//   如果因此创造了一个恶魔，当晚的死亡由说书人决定。」
//   用户 2026-09-21 的口径：阵营不变；转变当晚算他的「首个夜晚」；只提示**目标**（麻脸巫婆与说书人都不告知她结果）；
//   造出恶魔 → 当晚恶魔自己的刀无效，改由说书人在「生死无常」面板里决定 0~2 个人死（死因算她造成的）。
void BOTC_ChangeRoleMsg (int q, int role) {
    string s;
    string shown;
    int newRole;
    int prevRole;
    int prevA;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    // 【阵营没变就省略】（用户 2026-10-21）：比较改身份前 / 后的有效阵营。
    s = BOTC_TransitionRoleName(g_seatPrevAlign[q], BOTC_SeatAlign(q), role);
    shown = s;
    newRole = role;
    prevRole = g_seatPrevRole[q];
    prevA = g_seatPrevAlign[q];
    // 【全员追忆】正式开始前身份怎么变都只在本人魔典上重算占位卡、私聊也只报「失忆的X」；
    //   正式开始之后，理发师、麻脸巫婆、说书人手动改、方古击杀等一切身份转变都直接让玩家
    //   看到真实新身份；阵营没变时只报角色名，阵营变了才带「善良的/邪恶的」前缀。
    if (g_board == 13) {
        BOTC_AmnesiaSyncSeat(q, role);
        if (g_nightNum == 0) {
            newRole = BOTC_AmnesiaMaskRole(role);
            shown = g_roleName[newRole];
            // 正式开始前玩家只看到占位卡，认知基准也必须先遮成占位卡再比较。
            prevRole = BOTC_AmnesiaMaskRole(prevRole);
            prevA = BOTC_RoleAlign(prevRole);
        }
    }
    // 【本人魔典自动刷新】（用户 2026-11-05）：方古 / 理发师 / 麻脸巫婆等身份转变后，
    //   以前只有全员追忆才会刷本人那份魔典，普通板子会一直显示旧身份。
    BOTC_GrimRender(g_who[q]);
    // 【认知层面没变化就不通知】（用户 2026-11-06）：疯子被灵言师 / 方古转阵营、
    //   提线木偶被转成自己以为的身份等，玩家看到的东西没变，不必私聊打扰他。
    if (prevRole == newRole && prevA == BOTC_SeatAlign(q)) {
        BOTC_PmStore(g_teller, "【身份转变】" + BOTC_NameStr(q) + " 的认知没有变化 → 不通知他。");
        return;
    }
    BOTC_PmInfo(g_who[q], "【身份转变】你的身份转变：" + shown + "。");
    BOTC_PmStore(g_teller, "【身份转变】" + BOTC_NameStr(q) + " → " + s + "。");
}

void BOTC_HagOpen (int p) {
    int k;
    // 【先收起技能面板】（用户 2026-09-21）：不然它会把身份网格盖住（跟当初筑梦师一个毛病）
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_skillPicking[p] = false;
    // 官方移除时机：麻脸巫婆下一次夜晚行动时，把上一次的「角色变化（麻脸巫婆）」标记收掉（用户 2026-09-21）
    for (k = 2; k <= 13; k += 1) {
        g_tokOn[(((g_teller * 14) + k) * 256) + 74] = false;
    }
    if (p < 1 || p > 13) {             // 允许 1：说书人自己那一格（-t 试技能，用户 2026-09-21）
        return;
    }
    g_hagPick = true;
    g_hagActor = p;
    g_hagAsk = 0;
    g_hagConfirmOk = false;
    g_pickMode[g_who[p]] = 15;
    g_pickWho[g_who[p]] = p;
    BOTC_PickFilter(g_who[p], false);   // 整张板子的角色都能选
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_who[p]));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_who[p]));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_who[p]), true);
}

// 【麻脸巫婆 · 落难少女 / 跨阵营二次确认】（用户 2026-11-03）
void BOTC_HagApply (int who, int role) {
    int oldR;
    int oldA;
    int hagSeat;
    if (who < 1 || who > 13 || role < 0 || role > 163) {
        return;
    }
    hagSeat = g_hagActor;
    oldR = BOTC_SeatTrueRole(who);
    if (role == 82 && oldR != 82 && hagSeat >= 1 && !g_hagDamselBypass) {
        if (BOTC_RoleInPlay(82)) {
            g_hagActor = 0;
            BOTC_PmStore(g_teller, "【麻脸巫婆】落难少女已经在场 → 无事发生。");
            return;
        }
        BOTC_DamselAskOpenHag(who, hagSeat);
        return;
    }
    oldA = BOTC_SeatAlign(who);
    if (hagSeat >= 1 && !g_hagConfirmOk && BOTC_RoleAlign(role) != oldA && !BOTC_RoleInPlay(role)) {
        BOTC_HagConfirmOpen(who, role, hagSeat);
        return;
    }
    g_hagConfirmOk = false;
    g_hagActor = 0;
    BOTC_HagApplyReal(who, role);
    g_hagDamselBypass = false;
}

// 真的把人变成那个角色（阵营不变；转变当晚算他的「首个夜晚」）
void BOTC_HagApplyReal (int who, int role) {
    int oldR;
    int oldA;
    if (who < 1 || who > 13 || role < 0 || role > 163) {    // 允许 1（用户 2026-09-21）
        return;
    }
    oldR = BOTC_SeatTrueRole(who);
    // 【相克 · 麻脸巫婆 × 落难少女】（用户 2026-10-03）：她选落难少女时**不自动改人**，
    //   改由说书人手动指定谁变成落难少女（用户 2026-11-03：改成弹出说书人选座面板）。
    if (role == 82 && oldR != 82 && !g_hagDamselBypass && g_hagActor >= 1) {
        BOTC_DamselAskOpenHag(who, g_hagActor);
        return;
    }
    // 官方：那个角色已经在场 → 无事发生（她本人不会知道结果）
    // 【用户 2026-10-16 报的 BUG】：原来还挂了个「&& oldR != role」的例外，结果「熬在场的恶魔 / 熬他本人那一格」
    //   会绕过这一条，一路走到「造出恶魔 → 生死无常面板」那支 ✗。按官方口径，只要那个角色在场就什么都不发生。
    if (BOTC_RoleInPlay(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】她选的角色（" + g_roleName[role] + "）已经在场 → 无事发生。");
        return;
    }
    // 【利维坦×麻脸巫婆】第五天之后不能把利维坦加入游戏（用户 2026-10-20：本板子启用这条相克）。
    if (role == 127 && g_levAfterFifth) {
        BOTC_PmStore(g_teller, "【利维坦×麻脸巫婆】第五个白天已经结束 → 这次创造利维坦无效。");
        BOTC_Notice(g_teller, "第五个白天之后不能再创造利维坦。");
        return;
    }
    oldA = BOTC_SeatAlign(who);
    g_hagOldRole = oldR;
    // 【认知覆盖先不落地】（用户 2026-10-19）：酒鬼 / 疯子 / 悟道者只是麻脸巫婆这次能力的「认知外壳」。
    //   第一层选完后先不要改真身、不要给目标发身份提示，只打开第二层让他「以为是谁」的面板。
    //   等 BOTC_HagBelieve() 选完再一次性提交，避免目标先看到酒鬼 / 疯子本身。
    if (role == 14 || role == 38 || role == 118) {
        BOTC_HagBelieveOpen(who, role);
        return;
    }
    BOTC_SetSeatRole(g_teller, who, role);
    // 阵营不变：只有当「转变后的身份自带阵营」跟「他原来的阵营」不一样时，才需要打「善良(14) / 邪恶(15)」
    //   token 去把它钉住（用户 2026-09-21：转变后的身份跟原来同阵营就不用打）。
    //   认知覆盖已经在上面提前转交第二层，不会走到这里。
    if (BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    // 转变当晚算他的「首个夜晚」：排在麻脸巫婆之后的「你的首个夜晚」角色当晚就能行动（用户 2026-09-21）
    g_seatFirstNight[who] = g_nightNum;
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;        // 角色变化（麻脸巫婆）：官方提示标记
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
    BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + "（原 " + BOTC_RoleNameSafe(oldR) + "）变成 " + g_roleName[role] + "，阵营不变（" + BOTC_AlignName(BOTC_SeatAlign(who)) + "）。");
    if (BOTC_SeatAlign(who) != BOTC_RoleAlign(role)) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】注意：他的阵营跟这张身份自带的阵营不一样，因为他身上带着「" + BOTC_AlignName(BOTC_SeatAlign(who)) + "」标记（更早的转变 / 莽夫那类能力 / 你手动打的）。要改就先把那个标记撤掉。");
    }
    // 认知覆盖角色已在函数开头转交第二层；选完后由 BOTC_HagBelieve() 一次性提交。
    BOTC_ChangeRoleMsg(who, role);
    // 【数学家】（用户 2026-09-21）：改造完之后他的真身应该就是面板上那个身份；不是 → 记一格「未正常生效」
    if (BOTC_SeatTrueRole(who) != role) {
        BOTC_MalfNote(who, "麻脸巫婆改造后的真身和面板选的身份不符");
    }
    // 【洗脑师那条不用核】：她的效果是「疯狂」，脚本没法判定他到底疯没疯（纯 token + 说书人裁定，用户 2026-09-21）
    if (role == 64) {
        // 【新的镜像双子登场】（用户 2026-09-21）：旧配对已经作废，这时候直接把配对面板弹给说书人
        g_twinA = who;
        g_twinB = 0;
        g_twinPick = false;
        BOTC_PmStore(g_teller, "【镜像双子】现在场上有镜像双子（" + BOTC_NameStr(who) + "）：请你给他配一名对立双子（身份都能选）。");
        BOTC_MiFnOpen(who, 23);
    }
    if (BOTC_RoleTeam(role) == 3) {
        g_autoWoke[who] = false;           // 造出来的恶魔：当晚还要按恶魔那一格被唤醒
        g_testWoke[who] = false;
    }
    // 【诺-达鲺造出来 / 换位后】（用户 2026-11-04）：确保旧恶魔周围的中毒标记清掉、新恶魔两侧重新标记
    if (role == 70) {
        BOTC_NoDashiiSync();
    }
    BOTC_HagDemonCheck(role);
}

// 造出恶魔 → 当晚死亡由说书人定：恶魔自己的刀无效 + 开「生死无常」面板
void BOTC_HagDemonCheck (int role) {
    if (role < 0 || role > 163) {
        return;
    }
    if (BOTC_RoleTeam(role) != 3) {
        return;
    }
    g_hagNoDemonKill = true;
    BOTC_PmStore(g_teller, "【麻脸巫婆】她造出了一只恶魔（" + g_roleName[role] + "）→ 今晚恶魔自己的刀无效，改由你在「生死无常」面板里决定 0~2 个人死。");
    BOTC_HagKillOpen();
}

void BOTC_HagKillOpen () {
    g_hagKill = true;
    BOTC_SkillOpen(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择两名玩家"), PlayerGroupSingle(g_teller));
    BOTC_Notice(g_teller, "【麻脸巫婆】请在你的面板里决定今晚死谁：最多 2 个，也可以点【取消】一个都不杀。");
}

// 说书人定了谁死（0~2 个）：死因是「死亡（麻脸巫婆）」---- 不算恶魔杀，不触发被恶魔杀死的技能
void BOTC_HagKill (int p, int a, int b) {
    int n;
    n = 0;
    if (a >= 2 && a <= 13 && !BOTC_SeatDead(a)) {
        BOTC_MarkDeathByTok(a, 93);
        // 【不公聊】（用户 2026-09-21）：生死无常造成的死亡**不在公屏单独播「【麻脸巫婆】X 死亡」**----
        //   那样等于把她说出来了。天亮统一按普通死亡播报「昨晚 X 死亡」就行（上面那句 MarkDeathByTok 已经排进队列）。
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(a) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    if (b >= 2 && b <= 13 && b != a && !BOTC_SeatDead(b)) {
        BOTC_MarkDeathByTok(b, 93);
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(b) + " 死于她的能力（死亡（麻脸巫婆））。");
        n = n + 1;
    }
    g_hagKill = false;
    // 【收面板】（用户 2026-09-21）：生死无常结算完把面板关掉、停止继续选目标，不然会一直挂在说书人脸上
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    if (n == 0) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚没有让任何人死。");
    }
    BOTC_CheckWin();
}

// 酒鬼 / 疯子：由说书人再选一次他「以为自己是哪个角色」（跟哲学家那套一样）
void BOTC_HagBelieveOpen (int who, int kind) {
    int q;
    g_hagWho = who;
    g_cerenRole = kind;                 // 借用这个全局记一下：14 = 酒鬼 / 38 = 疯子 / 118 = 悟道者
    g_pickMode[g_teller] = 16;
    g_pickWho[g_teller] = who;
    g_pickTeam = 0;                     // 酒鬼只列镇民
    if (kind == 38) {
        g_pickTeam = 3;                 // 疯子只列恶魔
    }
    if (kind == 118) {
        g_pickTeam = 1;                 // 【悟道者（118）】（用户 2026-10-16）：只列外来者
    }
    BOTC_PickFilter(g_teller, false);
    if (kind == 14) {
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个镇民？"), PlayerGroupSingle(g_teller));
    }
    else {
        if (kind == 118) {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪个外来者？（酒鬼 / 疯子不能当）"), PlayerGroupSingle(g_teller));
        }
        else {
            libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("麻脸巫婆：他以为自己是哪只恶魔？"), PlayerGroupSingle(g_teller));
        }
    }
    // 【认知覆盖类不能当那张卡】（用户 2026-10-16）：酒鬼(14) / 疯子(38) 从网格里藏起来
    if (kind == 118) {
        for (q = 0; q < 64; q += 1) {
            if (g_gridSlot[q] == 14 || g_gridSlot[q] == 38) {
                DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
                DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
            }
        }
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_HagBelieve (int role) {
    int who;
    int kind;
    int oldA;
    int prevPerc;
    int prevRole;
    int newRole;
    who = g_hagWho;
    kind = g_cerenRole;
    if (who < 2 || who > 13 || role < 0 || role > 163) {
        return;
    }
    oldA = BOTC_SeatAlign(who);
    // 【改造前的认知】（用户 2026-11-06）：先记下他原来「以为的身份 / 阵营」，
    //   改造后认知层面没变就不私聊打扰他。
    prevPerc = BOTC_PerceivedAlign(who);
    prevRole = g_mark[(g_teller * 14) + who] - 1;
    // 【认知身份与原身份相同也要让旧身份离场】（用户 2026-10-19）：表面上不改格子里的卡，
    //   但真身已经从原来的角色变成酒鬼 / 疯子 / 悟道者。先走一次旧角色离场，再写回说书人选中的认知身份；
    //   中间不刷新玩家魔典，所以目标不会看到认知覆盖角色本身。
    if (role == g_hagOldRole) {
        BOTC_SetSeatRole(g_teller, who, kind);
    }
    g_pickMode[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    if (kind == 38) {
        // 疯子：真身是疯子，但魔典上按「他以为自己是的那只恶魔」显示（跟原本的疯子一样，用户 2026-09-21）
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 49] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成疯子（认知自己是" + g_roleName[role] + "）。");
    }
    else if (kind == 118) {
        // 【悟道者（118）】（用户 2026-10-16）：跟酒鬼同一套 ---- 真身是悟道者，魔典上按「他以为自己是那个外来者」显示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 140] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成悟道者（认知自己是" + g_roleName[role] + "）。");
    }
    else {
        // 酒鬼：真身是酒鬼，魔典上按「他以为自己是那个镇民」显示
        BOTC_SetSeatRole(g_teller, who, role);
        g_tokOn[(((g_teller * 14) + who) * 256) + 8] = true;
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 变成酒鬼（认知自己是" + g_roleName[role] + "）。");
    }
    // 【选完才提交身份变化的配套状态】（用户 2026-10-19）：阵营固定、首个夜晚、官方角色变化标记，
    //   原来在 BOTC_HagApply() 第一层就提前写了；现在只能在第二层选完后补上。
    if (kind == 14 || kind == 38 || BOTC_RoleAlign(role) != oldA) {
        if (oldA == 1) {
            g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + who) * 256) + 14] = true;
        }
    }
    g_seatFirstNight[who] = g_nightNum;
    g_tokOn[(((g_teller * 14) + who) * 256) + 74] = true;
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[who]);
    // 【身份转变提示】（用户 2026-11-06）：只比较玩家认知层面的变化。
    //   麻脸巫婆造出的认知只覆盖角色、不覆盖阵营，阵营按改造后的实际阵营比较：
    //   提线木偶 → 占卜师 / → 酒鬼占卜师 都是从「善良占卜师」变成「邪恶占卜师」，要通知；
    //   善良哲学家 → 疯子（以为自己是小恶魔）只报「小恶魔」，不追加善良 / 邪恶前缀。
    newRole = role;
    if (g_board == 13 && g_nightNum == 0) {
        newRole = BOTC_AmnesiaMaskRole(role);
    }
    if (prevRole != newRole || prevPerc != BOTC_SeatAlign(who)) {
        BOTC_PmInfo(g_who[who], "【身份转变】你的身份转变：" + BOTC_TransitionRoleName(prevPerc, BOTC_SeatAlign(who), newRole) + "。");
    }
    else {
        BOTC_PmStore(g_teller, "【麻脸巫婆】" + BOTC_NameStr(who) + " 的认知没有变化 → 不发身份转变提示。");
    }
}
//==================================================================================================
// 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）
//   相克：只要要把某位玩家变成落难少女（或理发师交换涉及落难少女），都改为说书人指定谁当落难少女。
//   麻脸巫婆把善良玩家变成爪牙/恶魔、或把邪恶玩家变成镇民/外来者时，还要说书人二次确认；
//   说书人拒绝 → 她重新选择。
//==================================================================================================
void BOTC_BuildHagAsk () {
    DialogCreate(684, 153, c_anchorRight, 185, -10, false);
    g_hagAskDlg = DialogLastCreated();
    DialogSetVisible(g_hagAskDlg, PlayerGroupAll(), false);
    g_hagAskTitle = BOTC_NewLabel(g_hagAskDlg, 666, 44, 18, 13, StringToText("【麻脸巫婆】确认这次身份改造？"));
    libNtve_gf_SetDialogItemStyle(g_hagAskTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_hagAskTitle, false, PlayerGroupAll());
    g_hagAskYes = BOTC_NewButton(g_hagAskDlg, 306, 50, 27, 81, "是：确认改造");
    g_hagAskNo = BOTC_NewButton(g_hagAskDlg, 306, 50, 351, 81, "否：让她重选");
    g_hagAskX = BOTC_NewButton(g_hagAskDlg, 30, 26, 640, 6, "X");
    DialogControlSetVisible(g_hagAskYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskX, PlayerGroupAll(), false);
    DialogControlSetVisible(g_hagAskYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskX, PlayerGroupSingle(g_teller), true);
}

// 弹给说书人：这次改造会跨阵营，确认还是让她重选？
void BOTC_HagConfirmOpen (int who, int role, int hagSeat) {
    if (who < 2 || who > 13 || role < 0 || role > 163 || hagSeat < 1 || hagSeat > 13) {
        return;
    }
    g_hagAsk = 1;
    g_hagAskWho = who;
    g_hagAskRole = role;
    g_hagAskActor = hagSeat;
    g_hagActor = hagSeat;
    libNtve_gf_SetDialogItemText(g_hagAskTitle, StringToText("【麻脸巫婆】把 ") + StringToText(BOTC_NameStr(who)) + StringToText("（原") + StringToText(g_roleName[BOTC_SeatTrueRole(who)]) + StringToText("）变成「") + StringToText(g_roleName[role]) + StringToText("」？阵营会变，是否确认？"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_hagAskYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_hagAskX, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_hagAskDlg, PlayerGroupSingle(g_teller), true);
}

// 说书人的二次确认：1 = 同意改造 / 0 = 拒绝（让她重新选）
void BOTC_HagAskAnswer (int ans) {
    int who;
    int role;
    int hagSeat;
    if (g_hagAsk <= 0) {
        return;
    }
    who = g_hagAskWho;
    role = g_hagAskRole;
    hagSeat = g_hagAskActor;
    g_hagAsk = 0;
    g_hagAskWho = 0;
    g_hagAskRole = 0;
    g_hagAskActor = 0;
    DialogSetVisible(g_hagAskDlg, PlayerGroupSingle(g_teller), false);
    if (ans != 0) {
        g_hagConfirmOk = true;
        g_hagActor = hagSeat;
        BOTC_HagApply(who, role);
        return;
    }
    g_hagDamselBypass = false;
    g_hagActor = 0;
    if (hagSeat >= 1 && hagSeat <= 13) {
        BOTC_PmStore(g_teller, "【麻脸巫婆】说书人拒绝这次跨阵营改造 → 她需要重新选择角色。");
        g_hagPick = false;
        g_hagConfirmOk = false;
        g_hagActor = hagSeat;
        BOTC_SkillOpen(hagSeat);
    }
}

// 理发师交换：把「今晚理发」标记撤掉、恢复状态
void BOTC_DamselBarberClear () {
    if (g_barberSeat >= 2 && g_barberSeat <= 13) {
        g_tokOn[(((g_teller * 14) + g_barberSeat) * 256) + 92] = false;
    }
    g_barberFrom = 0;
    g_barberWait = false;
    BOTC_GrimRender(g_teller);
    BOTC_SkillBtnRender();
}

// 麻脸巫婆选到落难少女：由说书人点一名玩家变成落难少女
void BOTC_DamselAskOpenHag (int who, int hagSeat) {
    if (hagSeat < 1 || hagSeat > 13) {
        hagSeat = g_hagActor;
    }
    if (hagSeat < 1 || hagSeat > 13) {
        return;
    }
    g_damselAsk = 1;
    g_damselHagWho = who;
    g_damselHagActor = hagSeat;
    g_damselAskA = 0;
    g_damselAskB = 0;
    g_damselBarberP = 0;
    g_hagActor = 0;
    g_hagAsk = 0;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    g_skillPicking[1] = true;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), true);
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_who[1]));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_who[1]), true);
    libNtve_gf_SetDialogItemText(g_skillCancel[1], StringToText("取消"), PlayerGroupSingle(g_who[1]));
    BOTC_PmStore(g_teller, "【麻脸巫婆×落难少女】由你指定一名玩家变成落难少女（她原本选中的是 " + BOTC_NameStr(who) + "）。");
}

// 理发师交换到落难少女：由说书人在两名候选里指定谁当落难少女
void BOTC_DamselAskOpenBarber (int p, int a, int b) {
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    g_damselAsk = 2;
    g_damselAskA = a;
    g_damselAskB = b;
    g_damselBarberP = p;
    g_damselHagWho = 0;
    g_damselHagActor = 0;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    g_skillPicking[1] = true;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), true);
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_who[1]));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_who[1]), true);
    libNtve_gf_SetDialogItemText(g_skillCancel[1], StringToText("取消"), PlayerGroupSingle(g_who[1]));
    BOTC_PmStore(g_teller, "【理发师×落难少女】由你指定谁当落难少女：候选 " + BOTC_NameStr(a) + " 和 " + BOTC_NameStr(b) + "。点一名玩家后【确认】；【取消】= 这次不交换。");
}

// 理发师：说书人已经选定落难少女 → 选中的是原来那位 = 不交换，另一位 = 正常交换
void BOTC_DamselBarberApply (int a, int b, int choose) {
    int p;
    int ra;
    int rb;
    int ds;
    p = g_damselBarberP;
    if (p < 2 || p > 13 || a < 2 || a > 13 || b < 2 || b > 13 || a == b) {
        return;
    }
    ra = BOTC_SeatTrueRole(a);
    rb = BOTC_SeatTrueRole(b);
    if (ra == 82) {
        ds = a;
    }
    else {
        if (rb == 82) {
            ds = b;
        }
        else {
            ds = 0;
        }
    }
    if (ds > 0 && choose == ds) {
        BOTC_DamselBarberClear();
        BOTC_PmStore(g_teller, "【理发师×落难少女】说书人指定 " + BOTC_NameStr(ds) + " 继续当落难少女 → 这次不交换。");
        return;
    }
    g_damselBarberBypass = true;
    BOTC_BarberSwap(p, a, b);
    g_damselBarberBypass = false;
    BOTC_PmStore(g_teller, "【理发师×落难少女】说书人指定 " + BOTC_NameStr(choose) + " 成为落难少女 → 正常交换。");
}

void BOTC_DamselAskCancel () {
    int kind;
    int p;
    kind = g_damselAsk;
    p = g_damselBarberP;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    g_damselAsk = 0;
    g_damselAskA = 0;
    g_damselAskB = 0;
    g_damselBarberP = 0;
    g_damselHagWho = 0;
    g_damselHagActor = 0;
    g_hagDamselBypass = false;
    if (kind == 2) {
        BOTC_DamselBarberClear();
        BOTC_PmStore(g_teller, "【理发师×落难少女】说书人取消 → " + BOTC_NameStr(p) + " 这次不交换。");
        return;
    }
    if (kind == 1) {
        BOTC_PmStore(g_teller, "【麻脸巫婆×落难少女】说书人取消 → 这次不产生落难少女。");
    }
}

void BOTC_DamselAskConfirm (int t) {
    int kind;
    int a;
    int b;
    kind = g_damselAsk;
    if (kind <= 0) {
        return;
    }
    if (t < 2 || t > 13) {
        BOTC_Notice(g_teller, "先点一名玩家再确认。");
        return;
    }
    if (kind == 2 && (t != g_damselAskA && t != g_damselAskB)) {
        BOTC_Notice(g_teller, "理发师的交换只能在这两名玩家之间选择落难少女。");
        return;
    }
    a = g_damselAskA;
    b = g_damselAskB;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    g_skillRoleSel[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_who[1]), false);
    g_damselAsk = 0;
    if (kind == 1) {
        g_hagActor = g_damselHagActor;
        g_hagDamselBypass = true;
        g_damselHagWho = 0;
        g_damselHagActor = 0;
        BOTC_HagApply(t, 82);
        return;
    }
    g_damselAskA = 0;
    g_damselAskB = 0;
    BOTC_DamselBarberApply(a, b, t);
    g_damselBarberP = 0;
}

//==================================================================================================
// 【食人族（74）】（用户 2026-09-23）：吃到疯子的能力
//==================================================================================================
int BOTC_CannSeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            return i;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (g_mark[(g_teller * 14) + i] - 1 == 74) {
            return i;
        }
    }
    return 0;
}

// 只给「自动打中毒 token」用：借用食人族能力的玩家也算在内。
//   不能拿它去做改身份 / 变身那套，否则会把失忆者改成恶魔。
int BOTC_CannAbilitySeat () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_HasAbility(i, 74)) {
            return i;
        }
    }
    return 0;
}

// 【处决死亡的食人族钩子】（用户第 6 / 7 条）：
//   1. 先清掉上一位被处决者留下的中毒，再按本次死者是否邪恶决定是否重新中毒；
//   2. 只要今天有人死于处决且食人族存活，夜里就先给他发一次能力。
void BOTC_CannExecHooks (int q) {
    int cs;
    int team;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_cannPoisonSeat >= 2 && g_cannPoisonSeat <= 13) {
        g_tokOn[(((g_teller * 14) + g_cannPoisonSeat) * 256) + 178] = false;
    }
    g_cannPoisonSeat = 0;
    cs = BOTC_CannSeat();
    if (cs < 2) {
        // 【失忆者 / 借用能力者】（用户 2026-11-06）：中毒标记要落到能力持有者身上。
        cs = BOTC_CannAbilitySeat();
    }
    if (cs < 2 || cs > 13 || cs == q || BOTC_SeatDead(cs)) {
        BOTC_GrimRender(g_teller);
        return;
    }
    g_cannPending = 1;
    team = BOTC_RoleTeam(BOTC_SeatTrueRole(q));
    if (team == 2 || team == 3) {
        g_tokOn[(((g_teller * 14) + cs) * 256) + 178] = true;
        g_cannPoisonSeat = cs;
        BOTC_PmStore(g_teller, "【食人族】邪恶角色 " + BOTC_NameStr(q) + " 死于处决 → " + BOTC_NameStr(cs) + " 自动中毒，持续到下一次有人死于处决。");
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_CannAfterExec (int q) {
    int cs;
    int kind;
    BOTC_CannRevert();
    cs = BOTC_CannSeat();
    if (cs < 2 || cs == q) {
        return;
    }
    kind = 0;
    if (BOTC_SeatTrueRole(q) == 38) {
        kind = 38;
    }
    if (kind == 0) {
        return;
    }
    g_cannSeat = cs;
    g_cannKind = kind;
    g_cannSrc = q;
    BOTC_CannOpen(kind);
}

void BOTC_CannRevert () {
    int cs;
    cs = g_cannSeat;
    if (cs < 2) {
        cs = BOTC_CannSeat();
    }
    if (cs < 2) {
        return;
    }
    if (BOTC_SeatDead(cs)) {
        return;                  // 食人族死了：不还原，他始终是带着那两个标记的那个角色
    }
    if (g_cannKind > 0 || g_tokOn[(((g_teller * 14) + cs) * 256) + 97]) {
        BOTC_SetSeatRole(g_teller, cs, 74);
        g_tokOn[(((g_teller * 14) + cs) * 256) + 49] = false;
        g_tokOn[(((g_teller * 14) + cs) * 256) + 97] = false;
        if (g_cannKind > 0) {
            BOTC_ChangeRoleMsg(cs, 74);
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 变回食人族。");
        }
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[cs]);
    }
    g_cannRole = 0;
    g_cannKind = 0;
    g_cannSeat = 0;
    g_cannSrc = 0;
}

void BOTC_CannOpen (int kind) {
    if (g_cannSeat < 2) {
        return;
    }
    g_pickMode[g_teller] = 17;
    g_pickWho[g_teller] = 1;
    g_pickTeam = 3;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("食人族：选一只恶魔（疯子）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_CannPick (int role) {
    int cs;
    if (g_cannSeat < 2 || role < 0 || role > 163) {
        return;
    }
    cs = g_cannSeat;
    if (BOTC_RoleTeam(role) != 3) {
        BOTC_Notice(g_teller, "疯子只能选恶魔。");
        return;
    }
    BOTC_SetSeatRole(g_teller, cs, role);
    g_cannRole = role;
    g_seatFirstNight[cs] = g_nightNum;
    g_tokOn[(((g_teller * 14) + cs) * 256) + 97] = true;
    g_tokOn[(((g_teller * 14) + cs) * 256) + 49] = true;
    BOTC_SeatStateSync();      // 【打完「是食人族 / 是疯子」之后再算一次】（用户 2026-10-14）
    BOTC_ChangeRoleMsg(cs, role);
    BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(cs) + " 吃到了疯子的能力 → " + g_roleName[role] + "。");
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[cs]);
}

//==================================================================================================
// 【不在场身份 · 统一发送】（用户 2026-11-04）
//   ① 所有自动 / 手动发送路径都走这里：3 个身份按**最新一次**整组覆盖旧值，同一玩家只保留最新一份；
//   ② 同时在私聊频道提醒说书人：哪 3 个身份发给了哪位玩家。
//==================================================================================================
string BOTC_BluffRoleNames (int r1, int r2, int r3) {
    return g_roleName[r1 - 1] + "," + g_roleName[r2 - 1] + "," + g_roleName[r3 - 1];
}

void BOTC_BluffSlotWrite (int who, int slot, int v) {
    libNtve_gf_SetDialogItemImage(g_bluffIcon[slot], BOTC_IconName(v - 1), PlayerGroupSingle(who));
    libNtve_gf_SetDialogItemText(g_bluffName[slot], StringToText(g_roleName[v - 1]), PlayerGroupSingle(who));
    libNtve_gf_SetDialogItemStyle(g_bluffName[slot], "ModLeftSize20Bold", PlayerGroupSingle(who));
}

void BOTC_BluffGiveTo (int q, int r1, int r2, int r3) {
    int i;
    int v;
    int who;
    bool replaced;
    if (q < 2 || q > 13) {
        return;
    }
    if (r1 < 1 || r1 > 163 || r2 < 1 || r2 > 163 || r3 < 1 || r3 > 163) {
        return;
    }
    who = g_who[q];
    replaced = g_bluffGiveRole[(who * 3)] > 0;
    for (i = 0; i < 3; i += 1) {
        if (i == 0) {
            v = r1;
        }
        else if (i == 1) {
            v = r2;
        }
        else {
            v = r3;
        }
        g_bluffGiveRole[(who * 3) + i] = v;
        BOTC_BluffSlotWrite(who, i, v);
    }
    // 旧的「疯子」专用面板还挂着就收掉：同一个玩家只保留最新一份
    DialogSetVisible(g_lbluffDlg, PlayerGroupSingle(who), false);
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(who), true);
    g_bluffGot[who] = true;
    if (replaced) {
        BOTC_Notice(who, "说书人重新给了你 3 个不在场身份，以这次为准，看右下角面板。");
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + BOTC_NameStr(q) + "：" + BOTC_BluffRoleNames(r1, r2, r3) + "（覆盖了上一次发给他的 3 个身份）。");
    }
    else {
        BOTC_Notice(who, "说书人给了你 3 个不在场身份，看右下角面板。");
        BOTC_PmStore(g_teller, "【不在场身份】已发给 " + BOTC_NameStr(q) + "：" + BOTC_BluffRoleNames(r1, r2, r3) + "。");
    }
}

void BOTC_BluffSendToCannibal () {
    int i;
    int ca;
    ca = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 97]) {
            ca = i;
        }
    }
    if (ca < 2) {
        BOTC_NoticeBox(g_teller, "没找到「是食人族」。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    BOTC_BluffGiveTo(ca, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

//==================================================================================================
// 【梦殒春宵 · 四个恶魔】（用户 2026-09-21）：68 方古 / 69 亡骨魔 / 70 诺-达鲺 / 71 涡流
//   四个都走统一恶魔击杀通道 BOTC_DemonStrike，死因各自打 64 / 65 / 66 / 67。
//   常驻效果：诺-达鲺两侧最近镇民中毒；涡流让镇民信息必错 + 没人被处决就邪恶胜；
//             亡骨魔让被杀爪牙保留能力、并让邻近镇民中毒（说书人挑一侧）。
//==================================================================================================

// 环形走位：从 from 出发沿 dir（+1 顺时针 / -1 逆时针）走到座位表里的下一个座位
int BOTC_RingNext (int from, int dir) {
    int i;
    int idx;
    int n;
    BOTC_BuildSeatList();
    n = g_seatN;
    if (n <= 0) {
        return 0;
    }
    idx = -1;
    for (i = 0; i < n; i += 1) {
        if (g_seatList[i] == from) {
            idx = i;
        }
    }
    if (idx < 0) {
        return 0;
    }
    idx = idx + dir;
    if (idx < 0) {
        idx = n - 1;
    }
    if (idx >= n) {
        idx = 0;
    }
    return g_seatList[idx];
}

// 从 from 沿 dir 找下一个「真身镇民」（跳过节肢 / 外来者 / 爪牙 / 恶魔；死亡也算；skip 跳过某一格）
int BOTC_NextTownsfolk (int from, int dir, int skip) {
    int i;
    int q;
    BOTC_BuildSeatList();
    q = from;
    for (i = 0; i < g_seatN; i += 1) {
        q = BOTC_RingNext(q, dir);
        if (q < 2) {
            return 0;
        }
        if (q == skip) {
            continue;
        }
        if (BOTC_SeatTeam(q) == 0) {
            return q;
        }
    }
    return 0;
}

// 场上「活着、并且当前有这个恶魔能力」的座位在哪（0 = 没有 → 他的常驻效果也就没有了）
int BOTC_LiveDemonSeat (int role) {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (!BOTC_AbilityWorks(q, role)) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        return q;
    }
    return 0;
}

// 【诺-达鲺（70）】两侧最近的镇民中毒（死亡也算）。
//   用户 2026-09-21 口径：毒钉在最近那个镇民身上，**他死了不蔓延**；
//   只有「他不再是镇民」（角色被换 / 换了位置）时才沿同一方向往外延到**下一个镇民**。
void BOTC_NoDashiiSync () {
    int q;
    int d;
    int keep;
    int oldA;
    int oldB;
    int oldDemon;
    oldA = g_nodA;
    oldB = g_nodB;
    oldDemon = g_nodDemon;
    d = BOTC_LiveDemonSeat(70);
    if (d < 2) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
        }
        g_nodA = 0;
        g_nodB = 0;
        g_nodDemon = 0;
        g_nodManual = false;
        if (oldA >= 2 || oldB >= 2) {
            BOTC_PmStore(g_teller, "【诺-达鲺】场上没有活着的诺-达鲺 → 两份「中毒（诺-达鲺）」都撤掉。");
            BOTC_GrimRender(g_teller);
        }
        return;
    }
    // 【换了一个诺-达鲺 / 换座位 / 身份变化】（用户 2026-10-19）：旧毒口只对「同一个诺-达鲺」有效；
    //   红唇女郎在另一个位置继位后，必须从新诺-达鲺的位置重新向两侧找最近镇民。
    if (g_nodDemon != d) {
        g_nodA = 0;
        g_nodB = 0;
        g_nodManual = false;
    }
    g_nodDemon = d;
    // 【手动优先】（用户 2026-10-19）：说书人在 token 面板改过诺-达鲺的毒口后，
    //   自动同步只记录实际标记，不再清掉重打；直到身份 / 座位再次变化才恢复自动重算。
    if (g_nodManual) {
        g_nodA = 0;
        g_nodB = 0;
        for (q = 2; q <= 13; q += 1) {
            if (!g_tokOn[(((g_teller * 14) + q) * 256) + 80]) {
                continue;
            }
            if (g_nodA < 2) {
                g_nodA = q;
            }
            else {
                if (g_nodB < 2) {
                    g_nodB = q;
                }
            }
        }
        return;
    }
    // 顺时针那侧
    keep = 0;
    if (g_nodA >= 2 && g_seatOn[g_nodA] && BOTC_SeatTeam(g_nodA) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodA >= 2 && g_seatOn[g_nodA]) {
            g_nodA = BOTC_NextTownsfolk(g_nodA, 1, g_nodB);       // 他不再是镇民 → 沿这一侧再往外找一个
        }
        else {
            g_nodA = BOTC_NextTownsfolk(d, 1, g_nodB);
        }
    }
    // 逆时针那侧
    keep = 0;
    if (g_nodB >= 2 && g_seatOn[g_nodB] && BOTC_SeatTeam(g_nodB) == 0) {
        keep = 1;
    }
    if (keep == 0) {
        if (g_nodB >= 2 && g_seatOn[g_nodB]) {
            g_nodB = BOTC_NextTownsfolk(g_nodB, -1, g_nodA);
        }
        else {
            g_nodB = BOTC_NextTownsfolk(d, -1, g_nodA);
        }
    }
    // 【和尚 × 诺-达鲺】：游戏中途新产生 / 换位的诺-达鲺若即将毒到和尚邻座，
    //   和尚压制这条持续中毒到黎明；诺-达鲺当晚的攻击不受影响。
    if (g_isNight && oldDemon != d && !g_heshangNoDashiiMute) {
        if (BOTC_HeshangTryBlockSeat(d, 70, g_nodA) || BOTC_HeshangTryBlockSeat(d, 70, g_nodB)) {
            g_heshangNoDashiiMute = true;
            BOTC_PmStore(g_teller, "【和尚】诺-达鲺的持续中毒被压制到下一个黎明；诺-达鲺当晚的攻击仍然有效。");
        }
    }
    if (g_heshangNoDashiiMute) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
        }
        BOTC_GrimRender(g_teller);
        return;
    }
    // 【悟道者 × 诺-达鲺】：开局已经成型的诺-达鲺不触发；游戏过程中新产生 / 换位的
    //   诺-达鲺若让悟道者成为两侧镇民，则悟道者先变身，随后仍照常中毒。
    if (g_isNight && oldDemon != d) {
        BOTC_WudTryTrigger(g_nodA, d);
        BOTC_WudTryTrigger(g_nodB, d);
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 80] = false;
    }
    if (g_nodA >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodA) * 256) + 80] = true;
    }
    if (g_nodB >= 2) {
        g_tokOn[(((g_teller * 14) + g_nodB) * 256) + 80] = true;
    }
    if (oldA != g_nodA || oldB != g_nodB) {
        BOTC_PmStore(g_teller, "【诺-达鲺】与他相邻的两名镇民中毒：" + BOTC_NameStr(g_nodA) + "（顺时针）/ " + BOTC_NameStr(g_nodB) + "（逆时针）。");
        BOTC_GrimRender(g_teller);
    }
}

// 【熊孩子（151）】：选中的镇民角色真实对应玩家获得「捣蛋」；借用能力不算。
void BOTC_RascalSync () {
    int s;
    int q;
    int role;
    for (q = 1; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 170] = false;
    }
    for (s = 1; s <= 13; s += 1) {
        if (!g_rascalActive[s]) {
            continue;
        }
        if ((s != 1 && !g_seatOn[s]) || BOTC_SeatDead(s) || !BOTC_HasAbility(s, 151)) {
            g_rascalActive[s] = false;
            g_rascalRole[s] = 0;
            continue;
        }
        role = g_rascalRole[s];
        if (role < 0 || role > 163 || BOTC_RoleTeam(role) != 0) {
            g_rascalActive[s] = false;
            g_rascalRole[s] = 0;
            continue;
        }
        for (q = 2; q <= 13; q += 1) {
            if (g_seatOn[q] && BOTC_SeatTrueRole(q) == role) {
                g_tokOn[(((g_teller * 14) + q) * 256) + 170] = true;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

void BOTC_RascalDuskClear () {
    int q;
    for (q = 1; q <= 13; q += 1) {
        g_rascalActive[q] = false;
        g_rascalRole[q] = 0;
        g_tokOn[(((g_teller * 14) + q) * 256) + 170] = false;
    }
    BOTC_GrimRender(g_teller);
}

// 【涡流（71）】：只要他活着并且清醒，镇民玩家通过能力拿到的信息一定错 → 给镇民打提醒标记
void BOTC_VortoxSync () {
    int q;
    int d;
    int on;
    on = 0;
    d = BOTC_LiveDemonSeat(71);
    if (d >= 2) {
        on = 1;
    }
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        if (on == 1 && BOTC_SeatTeam(q) == 0) {
            BOTC_WudTryTrigger(q, d);
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = true;
        }
        else {
            g_tokOn[(((g_teller * 14) + q) * 256) + 84] = false;
        }
    }
    BOTC_GrimRender(g_teller);
}

// 【涡流（71）】每个黄昏：今天白天没有人被处决 → 邪恶阵营获胜
//   （处决了但没死也算「有人被处决」；流放旅行者不算 ---- 我们还没做旅行者）
void BOTC_VortoxDuskCheck () {
    int d;
    if (!g_started || g_gameOver) {
        return;
    }
    // 【第 1 夜之前不算】（用户 2026-09-21 救火）：入夜 1 时天号还是 0（准备阶段），
    //   那时候还没「白天」可谈 ---- 不加这一句，涡流第一晚就会直接判邪恶胜。
    if (g_dayNum < 1) {
        return;
    }
    d = BOTC_LiveDemonSeat(71);
    if (d < 2) {
        return;
    }
    if (g_execUsedToday) {
        BOTC_PmStore(g_teller, "【涡流】今天白天有人被处决 → 这条胜利条件不触发。");
        return;
    }
    BOTC_PmStore(g_teller, "【涡流】今天白天没有人被处决 → 邪恶阵营获胜。");
    BOTC_ShowWin(1, "*黑白颠倒，对错不再，左右变换，长短无猜。", "万物紊乱无可寻，短视死亡把命栽，何处寻答？随我来。*");
}

// 【亡骨魔（69）】被亡骨魔杀死的爪牙「保留能力」：带着 79 标记的爪牙，即使死了也照常行动
//   （百科：只要亡骨魔还活着就行；他不再是爪牙 / 死爪牙自己中毒醉酒时作废）
bool BOTC_KeepsAbilityAlive (int q) {
    int v;
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 79]) {
        return false;
    }
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) {
        return false;
    }
    if (BOTC_SeatImpaired(q)) {
        return false;
    }
    v = BOTC_AbilitySeat(69);
    if (v < 2 || v > 13 || BOTC_SeatDead(v)) {
        return false;
    }
    return true;
}

// 亡骨魔杀了爪牙之后：弹面板让说书人从「顺时针 / 逆时针各取最近的一个镇民」里挑一个中毒
void BOTC_VigPickOpen (int minion, int a, int b) {
    string ta;
    string tb;
    BOTC_MiSeatFieldsReset();
    g_vigFrom = minion;
    g_vigA = a;
    g_vigB = b;
    ta = "（这一侧没有镇民）";
    tb = "（这一侧没有镇民）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    g_miSeat = 0;
    g_miRole = 79;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText("【亡骨魔】" + BOTC_NameStr(minion) + "（被杀死的爪牙）邻近的镇民：让哪一侧中毒？")), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText("左 = " + ta + "（顺时针）　右 = " + tb + "（逆时针）"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【亡骨魔】点左边或右边，让那名镇民中毒。");
}

// 真的给这名镇民打上「中毒（亡骨魔）」；两个候选都没人时什么也不做
void BOTC_VigPoison (int who) {
    int m;
    m = g_vigFrom;
    g_vigFrom = 0;
    if (who < 2 || who > 13) {
        BOTC_PmStore(g_teller, "【亡骨魔】这一侧没有合格的镇民 → 这一次不中毒。");
        return;
    }
    BOTC_WudTryTrigger(who, m);
    g_tokOn[(((g_teller * 14) + who) * 256) + 81] = true;
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【亡骨魔】" + BOTC_NameStr(m) + "（被杀的爪牙）→ " + BOTC_NameStr(who) + " 中毒。");
}

//--------------------------------------------------------------------------------------------------
// 【风雅集（板子 10）· 店小二（115）】（用户 2026-11-06）
//   配板阶段就放好「熟客 135」和「醉酒 136」；首夜唤醒只负责把信息发给店小二。
//   · 无论清醒还是中毒 / 酒鬼 / 信息错误（涡流 84、熊孩子 170、活尸），都先问说书人：
//     要不要把当前持有这两枚 token 的两名玩家的座位号告诉他；失效时在标题里提醒应点【取消】。
//   · 选【取消】= 说书人自己填两名玩家，发完再从这两人里选一名成为新的醉酒（另一名成为新熟客），
//     旧的熟客 / 醉酒标记全部移除。
//   · 店小二只拿到两个座位号，不会知道谁是醉酒的。
//--------------------------------------------------------------------------------------------------
// 醉酒目标优先级：一次性能力者（信息分类 1）> 夜间能力者（行动 1/2 或分类 3）> 持续信息位（分类 2）
int BOTC_DxeDrunkTier (int q) {
    int r;
    r = BOTC_SeatTrueRole(q);
    if (r < 0 || r > 163) {
        return 3;
    }
    if (g_roleInfoClass[r] == 1) {
        return 0;
    }
    if (g_roleAct[r] == 1 || g_roleAct[r] == 2 || g_roleInfoClass[r] == 3) {
        return 1;
    }
    if (g_roleInfoClass[r] == 2) {
        return 2;
    }
    return 3;
}

// 熟客候选：默认只挑善良；allowEvil = 假店小二（酒鬼 / 提线木偶）时允许挑邪恶。
//   allowLunatic = 放开疯子（38）：只有没有别的候选人时才用。
int BOTC_DxePickPatron (int p, bool allowEvil, bool allowLunatic) {
    int i;
    int n;
    int r;
    int a;
    a = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == p || BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (!allowEvil) {
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_RoleTeam(r) > 1) { continue; }
        }
        if (!allowLunatic && r == 38) {
            continue;              // 疯子（38）：尽量不当熟客
        }
        n += 1;
        if (RandomInt(1, n) == 1) {
            a = i;
        }
    }
    return a;
}

// 醉酒候选：优先善良（allowEvil = 场上没有善良目标时才放开邪恶），按 BOTC_DxeDrunkTier 分层同层随机
int BOTC_DxePickDrunk (int p, int patron, bool allowEvil, bool allowLunatic) {
    int i;
    int n;
    int r;
    int tier;
    int best;
    int b;
    b = 0;
    n = 0;
    best = 9;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || i == p || i == patron || BOTC_SeatDead(i)) {
            continue;
        }
        r = BOTC_SeatTrueRole(i);
        if (r < 0 || r > 163) {
            continue;
        }
        if (!allowEvil) {
            if (BOTC_SeatAlign(i) != 0) { continue; }
            if (BOTC_RoleTeam(r) > 1) { continue; }
        }
        if (!allowLunatic && r == 38) {
            continue;              // 疯子（38）：尽量不当醉酒
        }
        tier = BOTC_DxeDrunkTier(i);
        if (tier < best) {
            best = tier;
            b = i;
            n = 1;
        }
        else {
            if (tier == best) {
                n += 1;
                if (RandomInt(1, n) == 1) {
                    b = i;
                }
            }
        }
    }
    return b;
}

// 配板阶段（以及中途被创造时）放好熟客 / 醉酒（用户 2026-11-06 二次调整）：
//   · 店小二的判定同时认「认知身份」（g_mark = 115）和借用能力，所以酒鬼 / 提线木偶假店小二也会放。
//   · 真店小二：熟客与醉酒都只从善良里挑。
//   · 假店小二（酒鬼 / 提线木偶）：熟客允许是邪恶角色，醉酒仍优先善良角色。
//   · 疯子（38）尽量不当这两枚 token 的目标。
void BOTC_DxeSetup () {
    int i;
    int p;
    int a;
    int b;
    bool fake;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 135] = false;
        g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
    }
    p = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (g_mark[(g_teller * 14) + i] - 1 == 115 || BOTC_HasAbility(i, 115)) {
            p = i;
        }
    }
    if (p < 2) {
        BOTC_GrimRender(g_teller);
        return;
    }
    // 酒鬼（14）/ 提线木偶（93）假扮的店小二：他的信息本来就是假的，熟客可以是邪恶角色
    fake = (BOTC_SeatTrueRole(p) == 14 || BOTC_SeatTrueRole(p) == 93);
    a = BOTC_DxePickPatron(p, fake, false);
    if (a < 2) {
        a = BOTC_DxePickPatron(p, fake, true);      // 实在没人时放开疯子
    }
    b = BOTC_DxePickDrunk(p, a, false, false);
    if (b < 2) {
        b = BOTC_DxePickDrunk(p, a, false, true);   // 善良里只剩疯子
    }
    if (b < 2) {
        b = BOTC_DxePickDrunk(p, a, true, false);   // 连善良目标都没有才退到邪恶
    }
    if (a >= 2) {
        g_tokOn[(((g_teller * 14) + a) * 256) + 135] = true;
    }
    if (b >= 2) {
        g_tokOn[(((g_teller * 14) + b) * 256) + 136] = true;
    }
    BOTC_GrimRender(g_teller);
    if (a >= 2 && b >= 2) {
        if (fake) {
            BOTC_PmStore(g_teller, "【店小二】" + BOTC_NameStr(p) + " 是酒鬼 / 提线木偶假扮的店小二：熟客 " + BOTC_NameStr(a) + "，醉酒 " + BOTC_NameStr(b) + "。");
        }
        else {
            BOTC_PmStore(g_teller, "【店小二】配板阶段已放置：熟客 " + BOTC_NameStr(a) + "，醉酒 " + BOTC_NameStr(b) + "。");
        }
    }
    else {
        BOTC_PmStore(g_teller, "【店小二】场上没有足够的候选玩家，本次未能放满熟客 / 醉酒标记。");
    }
}

// 首夜唤醒入口：无论店小二是否清醒，都先问说书人要不要直接告诉他当前熟客 / 醉酒的两人
void BOTC_DxeNightOpen (int q) {
    int i;
    int a;
    int b;
    string ttl;
    a = 0;
    b = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 135]) {
            a = i;
        }
        if (g_tokOn[(((g_teller * 14) + i) * 256) + 136]) {
            b = i;
        }
    }
    if (a < 2 || b < 2 || a == b) {
        BOTC_DxeManualOpen(q);
        return;
    }
    g_dxeMode = 0;
    ttl = "【店小二】把当前熟客[" + IntToString(g_lab[a] + g_nameNumShift) + "]和醉酒[" + IntToString(g_lab[b] + g_nameNumShift) + "]告诉他？（确认=告诉，取消=自己填两名）";
    if (BOTC_SeatImpaired(q) || BOTC_InfoErrorOn(q)) {
        ttl = ttl + "　（他中毒 / 醉酒 / 信息错误：应点【取消】）";
    }
    BOTC_ManInfoOpenSeats(q, ttl, 22);
}

void BOTC_DxeManualOpen (int seat) {
    g_dxeMode = 1;
    BOTC_ManInfoOpenSeats(seat, "【店小二】填他要得知的两名善良玩家（左 / 右各一个座位号 1~12），填完再选一人成为醉酒", 12);
}

//--------------------------------------------------------------------------------------------------
// 【二选一醉酒】（用户 2026-10-16）：水手（23）/ 旅店老板（26）/ 店小二（115）共用亡骨魔那套二选一面板。
//   kind：0 = 水手（左 = 他自己、右 = 他选的人）　1 = 旅店老板（他选的两名玩家）　2 = 店小二（说书人填的那两个号）
//         3 = 店小二从说书人手动填的两名玩家中选一名成为新醉酒（另一名成为新熟客，旧标记移除）
//   ⚠ 谁醉由说书人点 ---- 原来那套「按概率表自动掷」是智能说书时代的，已经不走了。
//--------------------------------------------------------------------------------------------------
void BOTC_DrunkPickOpen (int kind, int who, int a, int b) {
    string ta;
    string tb;
    string ttl;
    string note;
    BOTC_MiSeatFieldsReset();
    g_dkKind = kind;
    g_dkFrom = who;
    g_dkA = a;
    g_dkB = b;
    ta = "（没有人）";
    tb = "（没有人）";
    if (a >= 2) {
        ta = BOTC_NameStr(a);
    }
    if (b >= 2) {
        tb = BOTC_NameStr(b);
    }
    ttl = "【水手】" + BOTC_NameStr(who) + "：他自己 / 他选的玩家，谁醉酒？";
    note = "左 = " + ta + "　右 = " + tb;
    if (kind == 1) {
        ttl = "【旅店老板】" + BOTC_NameStr(who) + " 选的两名玩家：谁醉酒？";
    }
    if (kind == 2) {
        ttl = "【店小二】" + BOTC_NameStr(who) + " 得知的两个人：谁醉酒？";
    }
    if (kind == 3) {
        ttl = "【店小二】两人里谁成为新的醉酒？";
        note = "左 = " + ta + "　右 = " + tb + "　（选一人醉酒，另一人成为新熟客；旧的熟客 / 醉酒标记会移除）";
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    else if (BOTC_SeatImpaired(who)) {
        note = note + "　（他中毒/酒鬼：点【取消】= 这次谁也不醉）";
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), true);
    }
    else {
        DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    }
    g_miSeat = 0;
    g_miRole = 807;
    libNtve_gf_SetDialogItemText(g_miTitle, BOTC_NameSubstText(StringToText(ttl)), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    libNtve_gf_SetDialogItemText(g_miYes, StringToText(ta), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNo, StringToText(tb), PlayerGroupSingle(g_teller));
    DialogControlSetPosition(g_miYes, PlayerGroupSingle(g_teller), c_anchorTopLeft, 117, 79);
    DialogControlSetPosition(g_miNo, PlayerGroupSingle(g_teller), c_anchorTopLeft, 351, 79);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

// side：1 = 点了左边（候选 A）/ 0 = 点了右边（候选 B）
void BOTC_DrunkPickApply (int side) {
    int k;
    int who;
    int pick;
    int other;
    int i;
    k = g_dkKind;
    who = g_dkFrom;
    pick = g_dkB;
    if (side != 0) {
        pick = g_dkA;
    }
    other = g_dkA;
    if (pick == g_dkA) {
        other = g_dkB;
    }
    g_dkKind = 0;
    g_dkFrom = 0;
    g_dkA = 0;
    g_dkB = 0;
    if (pick < 2 || pick > 13) {
        return;
    }
    if (k != 3) {
        BOTC_WudTryTrigger(pick, who);
    }
    if (k == 0) {
        if (g_sailorDrunk >= 2 && g_sailorDrunk != pick) {
            BOTC_SailorDrunkClear("水手换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 59] = true;      // 醉酒（水手）
        g_sailorDrunk = pick;
        BOTC_SailorSync();
    }
    if (k == 1) {
        if (g_nightDrunk >= 2 && g_nightDrunk != pick) {
            BOTC_DrunkClear("旅店老板换了目标");
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 60] = true;      // 醉酒（旅店老板）
        g_nightDrunk = pick;
    }
    if (k == 2) {
        g_tokOn[(((g_teller * 14) + pick) * 256) + 136] = true;     // 醉酒（店小二）
    }
    if (k == 3) {
        // 手动重放：先把旧的熟客 / 醉酒全部清掉，选中的那人是新醉酒，另一人是新熟客
        for (i = 2; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 135] = false;
            g_tokOn[(((g_teller * 14) + i) * 256) + 136] = false;
        }
        g_tokOn[(((g_teller * 14) + pick) * 256) + 136] = true;     // 新的醉酒（店小二）
        if (other >= 2 && other <= 13 && other != pick) {
            g_tokOn[(((g_teller * 14) + other) * 256) + 135] = true;   // 另一人成为新的熟客（店小二）
        }
        BOTC_PmStore(g_teller, "【店小二】新的醉酒：" + BOTC_NameStr(pick) + "，新的熟客：" + BOTC_NameStr(other) + "（旧的熟客 / 醉酒标记已移除）。");
    }
    BOTC_BartenderSync();
    BOTC_GrimRender(g_teller);
}

//--------------------------------------------------------------------------------------------------
// 【混沌（121）】（用户 2026-10-16）：每夜*刀一个人；如果这一刀杀死了「离他最近的两名镇民之一」
//   → 除旅行者外的所有善良玩家中毒，直到下一个黄昏（转成邪恶自动失效、转回善良自动生效）。
//--------------------------------------------------------------------------------------------------
void BOTC_HunDunPoisonAll (int demon) {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_SeatAlign(i) != 0) {
            continue;                                   // 只毒善良（旅行者本图没有）
        }
        BOTC_WudTryTrigger(i, demon);
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = true;
    }
    BOTC_GrimRender(g_teller);
}

// 到黄昏把那一份「善良中毒」全清掉（混沌死亡 / 离场的那一份由 BOTC_TokGoneWithSource 负责）
void BOTC_HunDunClear () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        g_tokOn[(((g_teller * 14) + i) * 256) + 138] = false;
    }
    BOTC_GrimRender(g_teller);
}

// 这一刀要不要触发：目标是镇民 + 已经死了 + 他是「离混沌最近的两名镇民」之一
void BOTC_HunDunCheck (int demon, int target) {
    int a;
    int b;
    if (demon < 2 || demon > 13 || target < 2 || target > 13) {
        return;
    }
    // 【这一刀直接分出胜负 → 不触发中毒】（百科口径；用户 2026-10-16 要求严格照做）
    //   最典型的影响是异端分子：他要是被这枚「中毒」打上，对调胜负就失效了 ----
    //   而百科说这种「一刀结束游戏」的场合根本不该给任何人上毒。
    //   （BOTC_DemonStrike 里面已经调过 BOTC_CheckWin，所以这里能直接读到 g_gameOver）
    if (g_gameOver) {
        return;
    }
    if (!(BOTC_SeatDead(target) || g_deadPending[target])) {
        return;                                     // 没造成死亡（被免死 / 被拦下）→ 不触发
    }
    if (BOTC_SeatTeam(target) != 0) {
        return;                                     // 不是镇民 → 不触发
    }
    a = BOTC_NextTownsfolk(demon, 1, 0);
    b = BOTC_NextTownsfolk(demon, -1, 0);
    if (target != a && target != b) {
        return;
    }
    BOTC_HunDunPoisonAll(demon);
    BOTC_PmStore(g_teller, "【混沌】这一刀杀死了邻近的镇民 " + BOTC_NameStr(target) + " → 除旅行者外的所有善良玩家中毒到下个黄昏。");
}

//--------------------------------------------------------------------------------------------------
// 【逆臣（119）】（用户 2026-10-16）：谁先死于处决，另一方当晚转邪恶（处决那一侧见 BOTC_ExecToggleAt）
//--------------------------------------------------------------------------------------------------
void BOTC_TurncoatApply (int who) {
    if (who < 2 || who > 13) {
        return;
    }
    if (BOTC_SeatAlign(who) == 1) {
        return;                                     // 本来就是邪恶 → 不变成善良（百科）
    }
    g_tokOn[(((g_teller * 14) + who) * 256) + 15] = true;      // 「邪恶」token：真身也算邪恶
    BOTC_GrimRender(g_teller);
    BOTC_PmInfo(g_who[who], "【逆臣】你转变为邪恶阵营。");
    BOTC_PmStore(g_teller, "【逆臣】" + BOTC_NameStr(who) + " 转变为邪恶阵营。");
}

// 【方古（68）】先正常结算这一刀；如果这一刀**真的杀死了外来者**、而且「限一次」还没用 → 转化
void BOTC_FangGuResolve (int p, int q) {
    int wasDead;
    int isOut;
    wasDead = 0;
    isOut = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_SeatTeam(q) == 1) {
            isOut = 1;
        }
    }
    BOTC_DemonStrike(p, 68, q, false);
    if (wasDead == 1 || isOut == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        return;                       // 被保护 / 免死 / 士兵挡下 → 他没死就不转化（百科明写）
    }
    // 【「限一次」的判定】（用户 2026-09-21 问原理）：光看「现在这只方古那一格」不够 ----
    //   转化之后新方古在**另一个座位**上，他去杀外来者时读自己那格是空的，会再转化一次。
    //   所以：① 全局 g_fangUsed 记账（整局一次，跨座位）；② 第 78 格 token 只当说书人提醒，
    //   顺带也留着「手动给当前方古打上这枚 token = 这一局已经用掉」的口子。
    if (g_fangUsed || g_tokOn[(((g_teller * 14) + p) * 256) + 78]) {
        BOTC_PmStore(g_teller, "【方古】「限一次」已经用过了 → 这一刀按普通击杀结算（外来者正常死亡）。");
        return;
    }
    g_fangUsed = true;
    g_tokOn[(((g_teller * 14) + p) * 256) + 78] = true;           // 「限一次」：整局留着，方古死了也不撤
    // 【修 BUG】（用户 2026-09-23）：他不是死，是「当场变成方古」----
    //   上面 BOTC_DemonStrike 已经按「击杀」记了死亡 token / 待天亮公布，这里整条收掉，
    //   否则天一亮还会公屏播「X 死亡」，看起来就是「既变成方古又死了」。
    //   （BOTC_ClearDeath 只清死亡记录 / 红叉 / 待公布 + 一次性能力复位，不发任何公屏。）
    BOTC_ClearDeath(q);
    BOTC_SetSeatRole(g_teller, q, 68);
    BOTC_SetSeatRole(g_who[q], q, 68);
    g_tokOn[(((g_teller * 14) + q) * 256) + 15] = true;          // 转邪恶
    g_tokOn[(((g_teller * 14) + q) * 256) + 14] = false;
    BOTC_ChangeRoleMsg(q, 68);                      // 【统一身份转变提示】（用户 2026-10-01）：方古转化也走这一套
    BOTC_PmStore(g_teller, "【方古】" + BOTC_NameStr(q) + "（外来者）变成邪恶的方古；老方古（" + BOTC_NameStr(p) + "）代替他死亡。");
    BOTC_MarkDeathByTok(p, 64);                     // 老方古死亡（死因照打「死亡（方古）」）
    g_autoWoke[q] = true;
    BOTC_GrimRender(g_teller);
    BOTC_CheckWin();
}

// 【亡骨魔（69）】先正常结算这一刀；杀死的是**真身爪牙** → 给他打「保留能力」，
//   再让说书人从他两侧最近的镇民里挑一个中毒
void BOTC_VigResolve (int p, int q) {
    int wasDead;
    int isMinion;
    int a;
    int b;
    wasDead = 0;
    isMinion = 0;
    if (q >= 2 && q <= 13) {
        if (BOTC_SeatDead(q)) {
            wasDead = 1;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 2) {
            isMinion = 1;
        }
    }
    // 【先打「保留能力」再结算这一刀】（用户 2026-09-21）：他死的那一刻「离场清理」会跑 ----
    //   标记先挂着，清理才知道「这个人保留能力、别收他的 token」；没死的话再把标记撤掉。
    if (wasDead == 0 && isMinion == 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = true;
    }
    BOTC_DemonStrike(p, 69, q, false);
    if (wasDead == 1 || isMinion == 0) {
        return;
    }
    if (!BOTC_SeatDead(q)) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 79] = false;      // 没死（被保护 / 免死 / 士兵）→ 不保留，撤掉
        return;
    }
    a = BOTC_NextTownsfolk(q, 1, 0);
    b = BOTC_NextTownsfolk(q, -1, 0);
    BOTC_GrimRender(g_teller);
    BOTC_VigPickOpen(q, a, b);
}

// 【测试】把座位 2（游戏里的「玩家1」）按麻脸巫婆的能力变成某个角色（用户 2026-09-21）
//   role < 0 = 用当前板子上的第一只恶魔（测试「造出恶魔」那一套：恶魔刀无效 + 生死无常面板）
void BOTC_TestHag (int role) {
    int i;
    int b;
    int r;
    int pick;
    pick = role;
    if (pick < 0) {
        pick = 21;
        b = g_board;
        if (b < 1 || b > 15) {
            b = 1;
        }
        for (i = 0; i < g_boardRoleN[b]; i += 1) {
            r = g_boardRole[(b * 256) + i];
            if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
                pick = r;
                break;
            }
        }
    }
    BOTC_Notice(g_teller, "【麻脸巫婆·测试】把 " + BOTC_NameStr(2) + " 熬成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_PmStore(g_teller, "【麻脸巫婆·测试】-熬 指令：把 " + BOTC_NameStr(2) + " 变成 " + BOTC_RoleNameSafe(pick) + "。");
    BOTC_HagApply(2, pick);
}

// 【查看某个座位】（用户 2026-09-21）：把那个座位现在的身份 / 阵营 / 标记写进说书人日志
void BOTC_SeatDump (int q) {
    int t;
    string tk;
    string st;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    tk = "";
    for (t = 0; t < 256; t += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + t]) {
            continue;
        }
        if (BOTC_IsHiddenTok(t)) {
            continue;
        }
        if (g_tokShort[t] == "") {
            continue;
        }
        if (tk != "") {
            tk = tk + "、";
        }
        tk = tk + g_tokShort[t];
    }
    if (tk == "") {
        tk = "（没有）";
    }
    if (BOTC_SeatAlign(q) == 1) {
        st = "邪恶";
    }
    else {
        st = "善良";
    }
    if (BOTC_SeatDead(q)) {
        s = "已死亡";
    }
    else {
        s = "活着";
    }
    BOTC_Notice(g_teller, "【查看】" + BOTC_NameStr(q) + "：" + BOTC_SeatRoleStr(q));
    BOTC_PmStore(g_teller, "【查看】座位 " + IntToString(q - 1) + "（" + BOTC_NameStr(q) + "）：魔典身份 = " + BOTC_SeatRoleStr(q) + "，真身索引 = " + IntToString(BOTC_SeatTrueRole(q)));
    BOTC_PmStore(g_teller, "【查看】阵营 = " + st + "；状态 = " + s);
    BOTC_PmStore(g_teller, "【查看】身上的标记：" + tk);
}
// 【镜像双子 · 配对】（用户 2026-09-21）：说书人在「祖母那种面板」里填座位号 + 选身份（所有角色都能选）。
//   他中毒 / 酒鬼时按规则两人不该知道对方身份 → 只记下来、不发信息，让说书人自己决定。
void BOTC_TwinPair (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (g_twinA < 2) {
        // 【-t 测试 / 说书人自己那一格】（用户 2026-09-21）：他自己就是镜像双子时也能配对
        if (BOTC_SeatTrueRole(1) == 64) {
            g_twinA = 1;
        }
        else {
            BOTC_Notice(g_teller, "场上还没有镜像双子。");
            return;
        }
    }
    if (q == g_twinA) {
        BOTC_Notice(g_teller, "不能把他自己当对立双子。");
        return;
    }
    g_twinB = q;
    if (BOTC_TwinBadInfo(g_twinA)) {
        // 【中毒 / 酒鬼 / 信息错误：只告诉镜像双子一个人】（用户 2026-10-14）----
        //   配对 token 76 / 77 脚本不代打；「你的对立双子是谁」只发给镜像双子本人（说书人填的那个身份），对立双子那边一个字都不发。
        BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
        BOTC_PmStore(g_teller, "【镜像双子】" + BOTC_NameStr(g_twinA) + " 中毒/酒鬼（或带「信息错误（涡流）」）");
        BOTC_PmStore(g_teller, "请手动用token配对双子。");
        return;
    }
    g_tokOn[(((g_teller * 14) + g_twinA) * 256) + 76] = true;    // 镜像双子本人这一格（官方：配对时就打）
    g_tokOn[(((g_teller * 14) + q) * 256) + 77] = true;          // 对立双子
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镜像双子】说书人指定 " + BOTC_NameStr(q) + " 当对立双子（身份：" + g_roleName[role] + "）；配对已记下（76 / 77 两枚 token 已打）。");
    // 【清醒：照旧两边都告诉】（用户 2026-10-14）：带毒 / 信息错误的那一支在上面已经 return 了。
    BOTC_PmInfo(g_who[g_twinA], "【信息】你得知" + BOTC_NameStr(q) + "是" + g_roleName[role] + "。");
    BOTC_PmInfo(g_who[q], "【信息】你得知" + BOTC_NameStr(g_twinA) + "是" + g_roleName[64] + "。");
    BOTC_PmStore(g_teller, "【镜像双子】已把两人的身份互相告知（" + BOTC_NameStr(g_twinA) + " ↔ " + BOTC_NameStr(q) + "）。");
    // 【数学家】（用户 2026-09-21）：说书人填的身份跟那个人的真身 / 登记层都对不上 → 记一格「未正常生效」
    //   （挂在镜像双子那一格：是他这条能力给出去的信息不对）
    if (BOTC_SeatTrueRole(q) != role && BOTC_RegRoleOf(q) != role) {
        BOTC_MalfNote(g_twinA, "镜像双子配对时填的身份和真身（含登记层）都不符");
    }
}
bool BOTC_TargetMustBeLiving (int p) {
    int r;
    r = BOTC_ActRoleOf(p);
    if (r == 23 || r == 24 || r == 40 || r == 49 || r == 77 || r == 107 || r == 155 || r == 159) {
        return true;
    }
    // 痢蛭只有首夜选宿主时要求存活；之后每夜的杀人目标可以是任意玩家。
    if (r == 100 && BOTC_ActingIsFirstNight(p)) {
        return true;
    }
    return false;
}

bool BOTC_TargetIsLiving (int q) {
    if (q < 2 || q > 13 || !g_seatOn[q]) {
        return false;
    }
    // BOTC_SeatDead 已经包含公开红叉；复活待公布时它会在夜间返回 false，
    // 因此这里不能再单独用 BOTC_PublicDead 拦掉。
    if (g_zombFake[q] || BOTC_SeatDead(q)) {
        return false;
    }
    return true;
}

int BOTC_TargetsOf (int p) {
    int r;
    if (p < 1 || p > 13) {
        return 0;
    }
    if (p == 1 && g_boomKeepPick) {
        return 3;
    }
    // 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）：说书人那一格只要 1 个目标
    if (g_who[p] == g_teller && g_damselAsk > 0) {
        return 1;
    }
    r = BOTC_ActRoleOf(p);
    // 【说书人那一格】（用户 2026-09-21 报「目标2 不见了」）：生死无常 / 镜像双子配对 / 心上人
    //   这几块面板开在**玩家 1** 身上，他魔典上没有身份（r = -1）----
    //   这几个特例必须放在「没身份就 return 0」**前面**，否则它们永远只拿到 1 个目标槽。
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：两个目标槽（最多杀 2 个）
    if (g_who[p] == g_teller && g_hagKill) {
        return 2;
    }
    // 【镜像双子配对】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_twinPick) {
        return 1;
    }
    // 【心上人】（用户 2026-09-21）：说书人那一格这时只要 1 个目标槽
    if (g_who[p] == g_teller && g_sweetBySt) {
        return 1;
    }
    // 奥赫选到不在场 / 重复角色时，说书人那一格弹一次单目标选择
    if (p == 1 && g_ojoAskSt) {
        return 1;
    }
    if (p == 1 && g_boffinRecipientPick) {
        return 1;
    }
    if (g_pedantActing[p]) {
        return 1;
    }
    if (r < 0 || r > 163) {
        return 0;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔被再次唤醒时也要两个目标槽
    if (p == g_barberFrom) {
        return 2;
    }
    if (r == 46 && BOTC_ProtectTokOn(p, 52)) {
        return 3;
    }
    // 哈迪寂亚（87）：固定三个目标
    if (r == 87) {
        return 3;
    }
    return g_roleTargets[r];
}

// 「每局限一次」的角色（智能说书反刍时尽量避开）：猎手 10 / 侍臣 29 / 教授 30 / 刺客 41
bool BOTC_OneShotRole (int r) {
    if (r == 10 || r == 29 || r == 30 || r == 41) {
        return true;
    }
    return false;
}

// 技能面板的【取消】：普通角色就是关掉面板；珀的发动 / 憋刀由前置询问处理。
void BOTC_SkillCancel (int p) {
    int r;
    if (p < 1 || p > 13) {
        return;
    }
    if (p == 1 && (g_scarletPick || g_courtPick || g_halfPick)) {
        BOTC_Notice(g_teller, "请先选择一名符合条件的目标再确认。");
        return;
    }
    if (g_boomKeepPick && p == 1) {
        BOTC_Notice(g_teller, "炸弹人必须选满三名保留玩家。");
        return;
    }
    // 【落难少女 × 麻脸巫婆 / 理发师】（用户 2026-11-03）：取消 = 这次不产生落难少女
    if (g_damselAsk > 0 && g_who[p] == g_teller) {
        BOTC_DamselAskCancel();
        return;
    }
    if (g_limitedAsk[p]) {
        BOTC_LimitedDecline(p);
        return;
    }
    if (g_poAsk[p]) {
        BOTC_PoAskAnswer(p, false);
        return;
    }
    if (g_boffinRecipientPick) {
        g_boffinRecipientPick = false;
        if (g_boffinEditSource >= 2 && g_boffinEditSource <= 13) {
            g_boffinPendingBy[g_boffinEditSource] = 0;
        }
        g_skillPicking[1] = false;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
        BOTC_PmStore(g_teller, "【科学怪人】取消了这次能力接收者选择。");
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (r == 150 && g_nightNum == 2) {
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        g_skillT2[p] = 0;
        g_skillT3[p] = 0;
        g_skillRoleSel[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【召唤师】" + BOTC_NameStr(p) + " 第二个夜晚不召唤普卡，保留第三个夜晚的召唤机会。");
        return;
    }
    // 奥赫（134）由说书人选择补杀目标时，取消 = 这次不杀
    if (g_ojoAskSt && p == 1) {
        g_ojoAskSt = false;
        g_ojoFrom = 0;
        g_ojoRole = -1;
        g_skillPicking[p] = false;
        g_skillT1[p] = 0;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        BOTC_PmStore(g_teller, "【奥赫】说书人取消了这次补杀。");
        return;
    }
    // 每局限一次的角色：点【取消】就是「今晚不发动」，说书人那边要看得到（机会还在）
    //   【巡山人（77）】（用户 2026-10-04）：他也有这个按钮（BOTC_SkillRender 里 30/41/77 都显示【取消】），
    //   这里把他的那行也补上 —— 不然点取消时脚本什么都不写，说书人会以为机会用掉了。
    if (g_awake[p] && g_isNight) {
        if (r == 30 || r == 41 || r == 77) {
            BOTC_Notice(g_teller, "【" + BOTC_SeatRoleStr(p) + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
            BOTC_PmStore(g_teller, "【" + g_roleName[r] + "】" + BOTC_NameStr(p) + " 今晚不发动技能。");
        }
    }
    // 【麻脸巫婆的「生死无常」】（用户 2026-09-21）：点【取消】= 今晚一个都不杀
    if (g_hagKill && g_who[p] == g_teller) {
        g_hagKill = false;
        BOTC_PmStore(g_teller, "【麻脸巫婆】今晚一个都不杀。");
        g_skillPicking[p] = false;
        DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
        return;
    }
    // 【理发师交换】（用户 2026-09-21）：恶魔点【取消】= 放弃交换 → 撤掉「今晚理发」标记
    if (g_barberFrom >= 2 && p == g_barberFrom) {
        BOTC_BarberDecline(p);
    }
    g_skillPicking[p] = false;
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
}

// 天亮结算：只做「公开」----把昨晚记下的死亡亮出来（红叉 + 播报），再清掉只算一晚的状态
void BOTC_DawnResolve () {
    int q;
    int ob;
    BOTC_EnvoyDawnClear();
    BOTC_HeshangDawnClear();
    BOTC_NoDashiiSync();           // 和尚压制结束后，持续中毒在黎明恢复
    // 【「死于今日」的移除时机】（用户 2026-09-20）：昨天留下的「死于今日 / 死于今日（僵怖）/ 死于今日（教父）」标记，
    //   一到第二天白天就清掉 ---- 放在整个天亮流程的**最前面**，免得后面处理夜间死亡时又混进新标记。
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 11]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 57]) {
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 56]) {
        }
        g_tokOn[(((g_teller * 14) + q) * 256) + 11] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 57] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 56] = false;     // 「死于今日（教父）」也一起清掉
    }
    // 天亮：间谍「看说书人魔典」的临时权限一起收掉
    BOTC_SpyPeekEnd();
    if (g_tokOn[(((g_teller * 14) + 62) * 256) + 92] || g_barberWait) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 92] = false;
        }
        if (g_barberSeat >= 2) {
            BOTC_PmStore(g_teller, "【理发师】昨晚没结算交换 → 这次机会作废，「今晚理发」标记收掉。");
        }
        g_barberSeat = 0;
        g_barberFrom = 0;
        g_barberWait = false;
    }
    // 【梦殒春宵】数学家 / 卖花女孩 / 城镇公告员 的当日标记：天亮清掉（用户 2026-09-21）
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[(((g_teller * 14) + q) * 256) + 86] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 87] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 88] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 91] = false;      // 杂耍艺人的「干扰」标记也是当天的（用户 2026-09-21）
    }
    BOTC_GrimRender(g_teller);
    BOTC_PhiloDrunkSync();        // 天亮再同步一次（哲学家中毒/清醒的醉酒来回切）
    // 【哲学家】今天死了 → 他给的「醉酒（哲学家）」收掉（用户 2026-09-21：死亡那天在死亡结算前判不出来，所以天亮再兜一次）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 70]) {
            continue;
        }
        if (!BOTC_SeatDead(q)) {
            continue;
        }
        for (ob = 2; ob <= 13; ob += 1) {
            if (g_tokOn[(((g_teller * 14) + ob) * 256) + 90]) {
                g_tokOn[(((g_teller * 14) + ob) * 256) + 90] = false;
                BOTC_PmStore(g_teller, "【哲学家】" + BOTC_NameStr(q) + " 已经死亡 → " + BOTC_NameStr(ob) + " 不再醉酒。");
            }
        }
    }
    // 僧侣的保护只维持一晚：天亮先把「保护」标记清掉
    if (g_nightMonk >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9]) {
            g_tokOn[(((g_teller * 14) + g_nightMonk) * 256) + 9] = false;
            BOTC_GrimRender(g_teller);
        }
    }
    // 旅店老板的「不会死亡」与驱魔人的「被点名」也只算昨晚（用户 2026-09-20）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 25]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 25] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 31]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 31] = false;
        }
    }
    g_exoBlock = 0;
    g_exoNight = 0;
    BOTC_GrimRender(g_teller);
    // 疯子（38）的「被选择」标记：天亮撤掉（跟百科一致）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 48]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 48] = false;
        }
    }
    // 【天亮：死亡 / 复活排队播报】（用户 2026-09-26）
    //   顺序：先复活（按座位号），再死亡（按座位号）；进白天 4 秒后播第一条，之后每 4 秒一条。
    //   每一条 = 红叉 + 左下角公屏 + 记录，都在同一瞬间（不再一次性全放出来）。
    BOTC_SkinSourceCheck();
    g_dawnQN = 0;
    g_dawnQI = 0;
    // ① 挂着复活标记、但他本来就没死：只把标记悄悄撤掉（不播报）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43] && !g_tokOn[(((g_teller * 14) + q) * 256) + 113]) {
            continue;
        }
        // 待复活玩家在夜间按存活处理，因此这里必须看公开红叉，不能看 BOTC_SeatDead。
        if (!BOTC_PublicDead(q)) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
            g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
            BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 身上有「复活」标记但他没死，标记先撤掉。");
        }
    }
    // ② 排队：先复活（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_tokOn[(((g_teller * 14) + q) * 256) + 42] && !g_tokOn[(((g_teller * 14) + q) * 256) + 43] && !g_tokOn[(((g_teller * 14) + q) * 256) + 113]) {
            continue;
        }
        if (!BOTC_PublicDead(q)) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 1;
        g_dawnQN = g_dawnQN + 1;
    }
    // ③ 再排队：昨晚的死亡（按座位号）
    for (q = 2; q <= 13; q += 1) {
        if (!g_deadPending[q]) {
            continue;
        }
        g_dawnQ[g_dawnQN] = q;
        g_dawnKind[g_dawnQN] = 2;
        g_dawnQN = g_dawnQN + 1;
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：天亮重新算一次
    // 主谋（42）：加时那一天到了 ---- 这一天的处决决定胜负
    if (g_mmExtra && !g_mmArmed) {
        g_mmArmed = true;
        BOTC_PmStore(g_teller, "【主谋】加时的这一天开始了：今天被处决的人，他的阵营立刻落败。");
    }
    BOTC_FoolSync();              // 弄臣（34）：维护「首次未死 / 失去能力」标记
    // 月之子（36）：昨天那个「可以公开选人」的窗口到期（他今天要是又死了会重新开）
    for (q = 1; q <= 13; q += 1) {      // q 从 1 开始：说书人那一格也能声称（用户 2026-09-26）
        g_moonOpen[q] = false;
        g_moonDeclare[g_who[q]] = false;
        g_klutzDeclare[g_who[q]] = false;     // 呆瓜（63）：新的一天，死后声称的点头像阶段也清掉
    }
    // 造谣者（28）：新的一天，声明次数与内容都清掉（每天一次）
    g_gossipBy = 0;
    g_miSeat = 0;                  // 信息位答题框：换局把待发的那句清掉
    g_miRole = -1;
    g_gossipText = "";
    for (q = 1; q <= 13; q += 1) {      // 同上：说书人（q = 1）的每日声称次数也要跟着刷
        g_gossipDone[q] = false;
        g_gossipTextBy[q] = "";
        g_juggDone[q] = false;         // 杂耍艺人（58）：新的一天，又能公开猜一次（用户 2026-09-21）
        g_alsaOpen[g_who[q]] = false;  // 戏法师（149）：新的一天，重新开放猜测
        g_alsaDay[g_who[q]] = -1;
        for (ob = 0; ob <= 13; ob += 1) {
            g_alsaChoice[(g_who[q] * 14) + ob] = 0;
        }
        g_psyDone[q] = false;          // 精神病患者（84）：新的一天，又能声称一次
        g_cultDeclDone[q] = false;     // 异教领袖（106）：新的一天，又能声称一次（用户 2026-10-11）
        g_declareUsed[g_who[q]] = false;   // 猎手：每天都能声称一次（用户 2026-11-04）
        g_declarePick[g_who[q]] = false;
        g_damselDone[g_who[q]] = false;    // 猜落难：每天都能声称一次（用户 2026-11-04）
        g_damselPick[g_who[q]] = false;
    }
    g_damselUsed = false;              // 猜落难：爪牙的公开猜测机会每天刷新
    g_damselFailed = false;
    DialogSetVisible(g_alsaDlg, PlayerGroupAll(), false);

    BOTC_HdHide();

    // 【天亮播报队列】（用户 2026-09-26）：4 秒后播第一条；没东西要播就照旧立刻判胜负
    if (g_dawnQN > 0) {
        TimerStart(g_tDawn, 4.0, false, c_timeGame);
    }
    else {
        BOTC_CheckWin();
    }
    if (g_nightImp >= 2 && !BOTC_SeatDead(g_nightImp)) {
        BOTC_PmStore(g_teller, "【天亮】昨晚小恶魔那一刀没有造成死亡。");
    }
    // 【即时刷新声称按钮】（用户 2026-09-20）：昨晚死的人在这里被公开 → 他们的格子立刻换成【死后声称】
    BOTC_DeclareRender();
    // 新的一天：今天被处决过谁重新计数（送葬者问的就是「今天」被处决的人）
    for (q = 2; q <= 13; q += 1) {
        g_exec[q] = false;
    }
    BOTC_NightSkillReset();

}

// 天亮播报一条（kind：1 = 复活 / 2 = 死亡）---- 红叉 + 左下角公屏 + 记录，同一瞬间
void BOTC_DawnReveal (int q, int kind) {
    int ob;
    if (q < 2 || q > 13) {
        return;
    }
    if (kind == 1) {
        if (!BOTC_PublicDead(q)) {
            return;
        }
        BOTC_ClearDeath(q);
        // 【复活不再延迟】（用户 2026-09-26）：红叉当场撤（BOTC_ClearDeath 已经撤了）、fuhuo 当场响，不挂复活动画
        g_revFxCt[q] = 0;
        g_revFxSnd[q] = 0;
        BOTC_PlaySfx("fuhuo");
        BOTC_RestoreOneShot(q);
        g_tokOn[(((g_teller * 14) + q) * 256) + 42] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 43] = false;
        g_tokOn[(((g_teller * 14) + q) * 256) + 113] = false;
        for (ob = 1; ob <= 13; ob += 1) {
            BOTC_GrimRender(ob);
        }
        BOTC_PubAnnounce("【复活】" + BOTC_NameStr(q) + " 复活");
        BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(q) + " 复活 ----");
        BOTC_PmStore(g_teller, "【天亮】" + BOTC_NameStr(q) + " 带着「复活」标记 → 自动复活。");
        BOTC_SailorSync();
        BOTC_TeaLadySync();
        return;
    }
    if (!g_deadPending[q]) {
        return;
    }
    g_deadPending[q] = false;
    if (BOTC_PublicDead(q)) {
        // 僵怖第一次假死已经公开过红叉；第二次真死仍要在天亮补一次死亡播报。
        if (!(BOTC_HasAbility(q, 43) && g_zombUsed[q] && !g_zombFake[q])) {
            return;
        }
    }
    g_deadShown[q] = true;
    BOTC_PlaySfx("Marine_Death");
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    BOTC_PubAnnounce("【死亡】昨晚，" + BOTC_NameStr(q) + " 死亡");
    if (!g_liveCorpse[q]) {
        BOTC_BansheeAnnounce(q);
    }
    BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：昨晚 " + BOTC_NameStr(q) + " 死亡 ----");
    BOTC_PmStore(g_teller, "【死亡类型】" + BOTC_NameStr(q) + "：" + BOTC_DeadKindStr(q) + "。");
    if (g_zombFake[q]) {
        BOTC_PmStore(g_teller, "【僵怖】他其实没有死：全桌都看到他「死亡」，但他照常行动。");
    }
    BOTC_DeclareRender();
    if (g_liveCorpse[q]) {
        if (!g_deathLearned[q]) {
            g_deathLearned[q] = true;
            BOTC_MoonChildCheck(q);
            BOTC_KlutzCheck(q);
        }
    }
    else {
        BOTC_MoonChildCheck(q);
    }
}

// 天亮队列：每 4 秒播一条；播完最后一条再判胜负
bool BOTC_DawnFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_dawnQN <= 0) {
        return true;
    }
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    BOTC_DawnReveal(g_dawnQ[g_dawnQI], g_dawnKind[g_dawnQI]);
    g_dawnQI = g_dawnQI + 1;
    if (g_dawnQI >= g_dawnQN) {
        g_dawnQN = 0;
        g_dawnQI = 0;
        BOTC_CheckWin();
        return true;
    }
    TimerStart(g_tDawn, 4.0, false, c_timeGame);
    return true;
}

// 黄昏（进入夜晚）时到期的状态：投毒者的毒只算一个夜晚 + 一个白天
// 把「当前这次投毒」收回来：中毒 token 去掉、记录清空。why 只用来写给说书人看的日志。
//   触发点：① 投毒者换目标（他自己点新目标时）② 黄昏到期 ③ 投毒者死亡 ④ 投毒者换了身份
void BOTC_PoisonClear (string why) {
    if (g_nightPoison >= 2) {
        if (g_tokOn[(((g_teller * 14) + g_nightPoison) * 256) + 7]) {
            // 这里只管投毒者那份（7）；普卡的毒是 63 那一格，一直挂到普卡下一次行动，不跟黄昏清
            g_tokOn[(((g_teller * 14) + g_nightPoison) * 256) + 7] = false;
            BOTC_GrimRender(g_teller);
            BOTC_SailorSync();         // 中毒状态变了：水手的「不会死亡」标记跟着刷新
        }
    }
    g_nightPoison = 0;
    g_poisonFrom = 0;
    g_poisonDay = 0;
}

void BOTC_DuskResolve () {
    int q;
    BOTC_GudiaoDuskClear();
    BOTC_XaanPoisonClear("黄昏到期");
    // 首夜设置的毒必须完整保留一个白天；只有跨过一天后的黄昏才到期。
    if (g_nightPoison >= 2) {
        if (g_poisonDay < g_dayNum) {
            BOTC_PoisonClear("黄昏到期");
        }
        else {
            BOTC_PmStore(g_teller, "【投毒者】首夜的中毒仍在本日生效，等到下一个黄昏再清除。");
        }
    }
    BOTC_DrunkClear("黄昏到期");           // 醉酒也只算一个夜晚 + 一个白天（暂时）
    BOTC_BartenderSync();                  // 酒保若在黄昏恢复清醒 / 目标阵营变化，立即校正
    BOTC_HunDunClear();                    // 【混沌（121）】「全体善良中毒」只到下一个黄昏（用户 2026-10-16）
    // 吟游诗人（31）的全员醉酒：触发那一天**不清**，要撑到明天黄昏（用户 2026-09-20）
    if (g_minstrelDay > 0 && g_dayNum <= g_minstrelDay) {
        BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒要撑到明天黄昏 → 这一轮黄昏先不清。");
    }
    else {
        if (g_minstrelDay > 0) {
            BOTC_PmStore(g_teller, "【吟游诗人】全员醉酒到点了 → 这一轮清掉。");
        }
        for (q = 2; q <= 13; q += 1) {
            g_minstrelDrunk[q] = false;
        }
        g_minstrelDay = 0;
    }
    // 处决免死（魔鬼代言人 / 和平主义者）只保「今天白天」那一次处决：到黄昏就清掉
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 24] || g_tokOn[(((g_teller * 14) + q) * 256) + 59] || g_tokOn[(((g_teller * 14) + q) * 256) + 60] || g_tokOn[(((g_teller * 14) + q) * 256) + 61] || g_tokOn[(((g_teller * 14) + q) * 256) + 62]) {
            if (g_tokOn[(((g_teller * 14) + q) * 256) + 53] || g_tokOn[(((g_teller * 14) + q) * 256) + 54] || g_tokOn[(((g_teller * 14) + q) * 256) + 55]) {
                // 侍臣的「三个夜晚 + 三个白天」还没到点：跳过（用户 2026-09-20）
            }
            else {
                if (g_minstrelDrunk[q]) {
                    // 这一份醉酒是吟游诗人的，还没到点：跳过（用户 2026-09-20）
                }
                else {
                    if (!BOTC_PhiloDrunkSelf(q)) {      // 【哲学家×酒鬼】（用户 2026-10-13）：他这份醉酒是他自己的身份，到黄昏也不清
                        g_tokOn[(((g_teller * 14) + q) * 256) + 24] = false;
                    }
                    g_tokOn[(((g_teller * 14) + q) * 256) + 59] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 60] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 61] = false;
                    g_tokOn[(((g_teller * 14) + q) * 256) + 62] = false;
                }
            }
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 27]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 27] = false;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 28]) {
            g_tokOn[(((g_teller * 14) + q) * 256) + 28] = false;
        }
    }
    g_sailorDrunk = 0;            // 水手（23）那一份醉酒也是「到黄昏为止」，记录一起清
    BOTC_CourtierTick();          // 侍臣（29）：每个黄昏把醉酒 1 → 2 → 3 → 失去能力
    // 吟游诗人（31）的「全员醉酒」标记：到点才撤（还没到点的那些由上面的 g_minstrelDrunk 挡住）
    for (q = 2; q <= 13; q += 1) {
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 50]) {
            if (g_minstrelDrunk[q]) {
                // 还没到点：留着
            }
            else {
                g_tokOn[(((g_teller * 14) + q) * 256) + 50] = false;
            }
        }
    }
    BOTC_SailorSync();
    BOTC_TeaLadySync();           // 茶艺师（32）：黄昏重新算一次
    // 主谋（42）：加时这一天没人被处决 → 解除武装，按原本规则判（恶魔已死 → 善良胜）
    if (g_mmArmed && !g_gameOver) {
        g_mmArmed = false;
        g_mmDone = true;                 // 加时走完了（g_mmExtra 留着，免得又被判成「刚开始加时」）
        BOTC_PmStore(g_teller, "【主谋】加时这一天没人被处决 → 加时结束，按原本规则结算。");
        BOTC_CheckWin();
    }
    // 【诺-达鲺（70）/ 涡流（71）】（用户 2026-09-21）：黄昏重算常驻效果；涡流还要查「今天有没有人被处决」
    BOTC_NoDashiiSync();
    BOTC_VortoxSync();
    BOTC_VortoxDuskCheck();
    // 【利维坦（127）】放在所有黄昏标记清理 / 重算之后：第五天中毒 / 醉酒解除的那一刻才能正确判定。
    BOTC_LeviathanDuskCheck();
    // 【教父×陌客】（用户 2026-11-05）：进入夜晚前还没回答 → 按不算外来者处理。
    BOTC_GfRecluseSettle();
}

// 传位：把某个座位改成「死掉的那只恶魔」（说书人那份和他自己那份魔典一起改），并告诉他
// 【传位目标 q 是格子】（用户 2026-10-07）：给谁刷魔典要走 g_who[q]。
void BOTC_PromoteTo (int q) {
    int i;
    int idx;
    string s;
    if (q < 2 || q > 13) {
        return;
    }
    // 【变成同一只恶魔】（用户 2026-09-21）：以前固定改成小恶魔，现在看死掉的是哪一只
    if (g_demonKind < 21 || g_demonKind > 163 || BOTC_RoleTeam(g_demonKind) != 3) {
        g_demonKind = 21;
    }
    BOTC_SetSeatRole(g_teller, q, g_demonKind);
    BOTC_SetSeatRole(g_who[q], q, g_demonKind);
    // 【重要】这里**故意不清** g_pair* / g_pairV* 那套「观察者 × 座位」缓存：
    //   ① 还没看过他的中毒 / 酒鬼（共情者、占卜师等），之后第一次看他时按新身份算 ----
    //      「恶魔一定被看成善良」这条会照常生效；
    //   ② 已经把他看成邪恶的（中毒 / 酒鬼时判过），之后保持不变，不会被这次传位洗白。
    // 【诊断】把「传位前已经把他看成邪恶的中毒 / 酒鬼观察者」写一行，方便测试时核对
    s = "";
    for (i = 2; i <= 13; i += 1) {
        idx = (i * 14) + q;
        if (g_pairImp[idx] == 1) {
            if (g_pairVAlign[idx] == 1) {
                s = s + BOTC_NameStr(i) + " ";
            }
        }
    }
    if (s != "") {
        BOTC_DiagStore(g_teller, "【诊断传位】" + BOTC_NameStr(q) + " 变成恶魔，但这些人中毒 / 酒鬼时已经把他看成邪恶，之后不变：" + s);
    }
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[q]);
    // 被改成小恶魔的玩家一定要收到通知：私聊一行 + 屏幕字幕 + 提示条，三种都给
    BOTC_ChangeRoleMsg(q, g_demonKind);
    // 智能说书：新恶魔诞生，重新抽 3 个不在场身份发给他
    BOTC_SkillBtnRender();
    // 【红唇继承诺-达鲺】（用户 2026-11-04）：传位后按新恶魔位置重算两侧中毒标记，旧恶魔身边的标记清掉。
    if (g_demonKind == 70) {
        BOTC_NoDashiiSync();
    }
}

// 真正活着的人数（按说书人那份的死亡记录算：token 记的隐蔽死亡也算死）
int BOTC_AliveCountTrue () {
    int i;
    int q;
    int n;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (!BOTC_PhysicallyDead(q)) {
            n = n + 1;
        }
    }
    return n;
}

// 红唇女郎（索引 19）被动：场上没有活着的恶魔时，如果**恶魔死之后还有 ≥4 人活着**，她直接变成新的恶魔
//   （官方原话是「恶魔死前有 5 人以上活着」，两种说法等价；用户 2026-09-19 明确按 ≥4 算）
//   谁杀的、怎么死的都不看，只看「恶魔身上有没有死亡 token」---- token 里记了恶魔死了就算数
//   （哪怕还没公开红叉给别的玩家看）；她自己也必须是「token 里还活着」的那个人；
//   她中毒 / 酒鬼时能力失效（本人不当场知道）；变身是悄悄进行的（只私聊新恶魔 + 写说书人日志）。
//   变身后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）。
//   返回值：true = 已经变身（调用方不要再走「说书人传位 / 智能随机」那套）。
//==================================================================================================
void BOTC_ScarletOpenPick (string candidates) {
    g_scarletPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择红唇女郎接刀"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_skillNoPick[1], PlayerGroupSingle(g_teller), false);
    BOTC_Notice(g_teller, "【红唇女郎】场上有多名可用持有者：请选择其中一名接刀。");
    BOTC_PmStore(g_teller, "【红唇女郎】多名候选：" + candidates + "。请点其中一名确认。");
    BOTC_GrimRender(g_teller);
}

bool BOTC_ScarletPromote (int sw) {
    int i;
    int alive;
    if (sw < 2 || sw > 13 || !g_seatOn[sw] || BOTC_SeatDead(sw) || !BOTC_AbilityWorks(sw, 19)) {
        return false;
    }
    g_scarletPick = false;
    // 小怪宝局：身份仍是红唇女郎，只接手小怪宝的「是恶魔」标记。
    if (g_lmOn) {
        for (i = 1; i <= 13; i += 1) {
            g_tokOn[(((g_teller * 14) + i) * 256) + 134] = false;
        }
        g_tokOn[(((g_teller * 14) + sw) * 256) + 134] = true;
        g_lmSeat = sw;
        BOTC_SeatStateSync();
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[sw]);
        BOTC_PmInfo(g_who[sw], "【小怪宝】现在由你照看小怪宝；你的身份仍是红唇女郎。");
        BOTC_PmStore(g_teller, "【红唇女郎】" + BOTC_NameStr(sw) + " 接刀，接手照看小怪宝。");
        return true;
    }
    BOTC_PromoteTo(sw);
    g_tokOn[(((g_teller * 14) + sw) * 256) + 123] = false;
    g_alcBorrow = 0;
    g_tokOn[(((g_teller * 14) + sw) * 256) + 13] = true;
    BOTC_GrimRender(g_teller);
    alive = BOTC_AliveCountTrue();
    BOTC_Notice(g_teller, "红唇女郎规则：" + BOTC_NameStr(sw) + " 接刀，成为新的恶魔。");
    BOTC_PmStore(g_teller, "【红唇女郎】" + BOTC_NameStr(sw) + " 接刀；当前真实存活 " + IntToString(alive) + " 人。");
    return true;
}

// 僵怖首次假死是项目自定义的接刀触发点：即使僵怖内部仍算活着，也让红唇女郎接刀。
bool BOTC_ScarletAfterZombuul () {
    int i;
    int count;
    int only;
    string candidates;
    if (g_scarletPick) {
        return true;
    }
    count = 0;
    only = 0;
    candidates = "";
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i] || BOTC_SeatDead(i) || !BOTC_AbilityWorks(i, 19)) {
            continue;
        }
        count = count + 1;
        only = i;
        if (candidates != "") {
            candidates = candidates + "、";
        }
        candidates = candidates + BOTC_NameStr(i);
    }
    if (count < 1) {
        return false;
    }
    g_demonKind = 43;
    if (count > 1) {
        BOTC_ScarletOpenPick(candidates);
        BOTC_PmStore(g_teller, "【僵怖 × 红唇女郎】僵怖首次假死触发接刀；请选择一名红唇女郎。");
        return true;
    }
    BOTC_PmStore(g_teller, "【僵怖 × 红唇女郎】僵怖首次假死触发接刀：" + BOTC_NameStr(only) + " 成为新的恶魔。");
    return BOTC_ScarletPromote(only);
}

bool BOTC_ScarletCheck () {
    int i;
    int q;
    int sw;
    int alive;
    int count;
    string candidates;
    sw = 0;
    count = 0;
    candidates = "";
    if (g_scarletPick) {
        return true;
    }
    BOTC_BuildSeatList();
    // 【画皮 × 红唇女郎】恶魔成为活尸时已经真实死亡，直接按没有存活恶魔结算，不触发红唇接任。
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (g_liveCorpse[q] && BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            BOTC_PmStore(g_teller, "【画皮 × 红唇女郎】恶魔 " + BOTC_NameStr(q) + " 已成为活尸（真实死亡）→ 红唇女郎不接任。");
            return false;
        }
    }
    // 【小怪宝局】（用户 2026-10-11）：这一局的「恶魔」是**照看小怪宝的那个人**（token 134 / g_lmSeat），
    //   他的真身其实是爪牙（只是被 token 当成 112）---- 所以：
    //   ① 照看人还活着 → 轮不到红唇（原来这里只扫真身 team 3，小怪宝局里永远扫不到，
    //      于是随便死个人她都可能变身）；
    //   ② 还没指定谁照看（g_lmSeat = 0）→ 也当「没有死掉的恶魔」，她不该变身。
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;
        }
        if (!BOTC_SeatDead(g_lmSeat)) {
            return false;
        }
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(q)) == 3) {
            return false;                 // 场上还有活着的恶魔：还轮不到红唇女郎
        }
        // 【按能力认人】（用户 2026-10-13）：原来写死「真身 = 19」----
        //   可这个能力可能是**借来的**（炼金术士 95 / 哲学家 56 / 食人族 74），他们的真身不是 19，
        //   于是「炼金术士借到红唇」永远顶不上位。BOTC_HasAbility 把这四种都算上。
        if (BOTC_AbilityWorks(q, 19)) {
            sw = q;
            count = count + 1;
            if (candidates != "") {
                candidates = candidates + "、";
            }
            candidates = candidates + BOTC_NameStr(q);
        }
    }
    if (count < 1) {
        return false;                     // 场上没有活着的红唇女郎
    }
    // 人数门槛（用户 2026-09-19）：按「恶魔**死了之后**还活着几个人」算，≥4 就能顶
    alive = BOTC_AliveCountTrue();
    if (alive < 4) {
        BOTC_PmStore(g_teller, "【红唇女郎】恶魔已经死了，但场上只有 " + IntToString(alive) + " 人活着，她不能变身。");
        return false;
    }
    if (count > 1) {
        BOTC_ScarletOpenPick(candidates);
        return true;
    }
    // 【相克 · 小怪宝 × 红唇女郎】（用户 2026-10-13 更正）：她**身份不变**，只是接手照看小怪宝 ----
    //   规则上她还是红唇女郎（魔典上那张牌该写「红唇女郎」），只是「**是恶魔（小怪宝）**」----
    //   所以这里**不动真身**，只把 token 134 挪到她身上、并把 g_lmSeat 指向她（照看人 = 现在的恶魔）。
    //   胜负那边靠 token 134 / g_lmSeat 判定，所以照样是「活着的新恶魔」，不会立刻判善良胜。
    //   （原来那版把她的真身改成了 112 小怪宝 ---- 牌面会写成「小怪宝」，跟规则不符。）
    if (g_lmOn) {
        for (i = 1; i <= 13; i += 1) {
            if (i == sw) { continue; }
            g_tokOn[(((g_teller * 14) + i) * 256) + 134] = false;
        }
        g_tokOn[(((g_teller * 14) + sw) * 256) + 134] = true;
        g_lmSeat = sw;
        BOTC_SeatStateSync();      // 【「是恶魔（小怪宝）」改真身 → 重算常驻标记】（用户 2026-10-14）
        BOTC_GrimRender(g_teller);
        BOTC_GrimRender(g_who[sw]);
        BOTC_PmInfo(g_who[sw], "【小怪宝】照看它的人已经死了 → 现在由你照看小怪宝（你的身份没变，还是红唇女郎）。");
        BOTC_PmStore(g_teller, "【红唇女郎】照看小怪宝的人已经死了、场上还有 " + IntToString(alive) + " 人活着 → 改由 " + BOTC_NameStr(sw) + " 照看小怪宝（她身份不变，牌面仍是红唇女郎，只是「是恶魔」）。");
        return true;
    }
    BOTC_PromoteTo(sw);
    // 【借能力上位的人要把「借用」痕迹清掉】（用户 2026-10-13）：炼金术士(95) 靠 token 123 + g_alcBorrow 记账，
    //   BOTC_SeatTrueRole 会按它读回 95（镇民）→ 胜负那边就看不到「活着的恶魔」了。
    //   （哲学家 70 / 食人族 97 的两枚由 BOTC_SetSeatRole 的离场清理收掉，这里只管炼金那两笔。）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 123] = false;
    g_alcBorrow = 0;
    // 继位之后自动在她身上打上红唇女郎的提醒标记「是恶魔」（第 13 槽）
    g_tokOn[(((g_teller * 14) + sw) * 256) + 13] = true;
    BOTC_GrimRender(g_teller);
    BOTC_Notice(g_teller, "红唇女郎规则：恶魔已死、场上还有 " + IntToString(alive) + " 人活着 ---- " + BOTC_NameStr(sw) + " 直接变成了新的恶魔。");
    return true;
}

//==================================================================================================
// 镇长（索引 12）：被恶魔攻击时可能由别人替他死（一次性被动）+ 特殊胜利；以及通用胜负检查
//==================================================================================================
// 该弹谁：善良方只比邪恶方多 0~2 人（邪恶方快追平）→ 弹活着的邪恶；否则弹善良，优先顺序：
//   ① 已经用掉限次技能（打了「失去能力」token）② 一次性信息者（分类 1）/ 外来者 ③ 其他镇民
int BOTC_MayorPick (int mayor) {
    int i;
    int q;
    int r;
    int good;
    int evil;
    int n;
    int pick;
    int n1;
    int n2;
    int n3;
    int p1;
    int p2;
    int p3;
    good = 0;
    evil = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            evil = evil + 1;
        }
        else {
            good = good + 1;
        }
    }
    // 邪恶方快追平：弹一个活着的邪恶
    if (good - evil <= 2) {
        n = 0;
        pick = 0;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == mayor || BOTC_SeatDead(q)) {
                continue;
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleAlign(r) == 1) {
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = q;
                }
            }
        }
        return pick;
    }
    // 善良方领先：弹善良方（三个优先级各挑一个，最后按优先级取）
    n1 = 0;
    n2 = 0;
    n3 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == mayor || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 12] || g_tokOn[(((g_teller * 14) + q) * 256) + 17]) {
            n1 = n1 + 1;
            if (RandomInt(1, n1) == 1) {
                p1 = q;
            }
        }
        else {
            if (g_roleInfoClass[r] == 1 || BOTC_RoleTeam(r) == 1) {
                n2 = n2 + 1;
                if (RandomInt(1, n2) == 1) {
                    p2 = q;
                }
            }
            else {
                n3 = n3 + 1;
                if (RandomInt(1, n3) == 1) {
                    p3 = q;
                }
            }
        }
    }
    if (p1 >= 2) {
        return p1;
    }
    if (p2 >= 2) {
        return p2;
    }
    return p3;
}

// 镇长被恶魔攻击：返回 true = 这次不按正常流程打死镇长（替死的人写在 g_mayorVictim，0 = 没人死）
//   智能说书：按 g_mayorBounceChance% 判定，成功就替死并给镇长打「失去能力」token（之后不再弹）；
//   手动说书：不自动弹，只把建议写给说书人，镇长这次不死，由他自己处理。
bool BOTC_MayorBounce (int mayor) {
    int pick;
    g_mayorVictim = 0;
    if (!g_started) {
        return false;
    }
    pick = BOTC_MayorPick(mayor);
    if (pick >= 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    else {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被恶魔攻击。手动说书：要不要弹死别人由你定。");
    }
    return true;
    if (RandomInt(1, 100) > g_mayorBounceChance) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定没弹成，镇长自己死。");
        return false;
    }
    if (pick < 2) {
        BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，但场上没有能替他的人，镇长自己死。");
        return false;
    }
    g_mayorVictim = pick;
    g_tokOn[(((g_teller * 14) + mayor) * 256) + 18] = true;   // 一次性被动：内部记账（这一格不显示在面板 / 圆桌上）
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(mayor) + " 夜里被攻击：判定成功，" + BOTC_NameStr(pick) + " 替他死了。");
    return true;
}

//==================================================================================================
// 【镇长（12）手动拍板】（用户 2026-09-21）：恶魔那一刀现在是脚本自己打 token 的，
//   所以改成 ---- 一旦**即将**给镇长打上「夜间」死亡 token，就弹窗问说书人：
//     【是】→ 说书人在魔典上点一个座位，那个人替他死（镇长不死）；
//     【否】→ 镇长自己死（把挂起来的那次死亡补上）。
//   智能说书还是老样子：按 g_mayorBounceChance% 自动判定。
//==================================================================================================
bool BOTC_MayorCanAsk (int q) {
    if (q < 2 || q > 13) {
        return false;
    }
    if (!g_started || g_gameOver) {
        return false;
    }
    if (g_mayorBusy || g_mayorAskOn || g_mayorPick) {
        return false;
    }
    if (!BOTC_AbilityWorks(q, 12)) {
        return false;                       // 中毒 / 酒鬼 → 能力失效
    }
    return true;
}

// 记下「等一下要补的那次死亡」，并决定是弹窗还是自动判定；返回 true = 这次死亡先别记
bool BOTC_MayorTakeOver (int q, int row, int byDemon, int srcRole, int src, bool tokPath, int tok) {
    if (!BOTC_MayorCanAsk(q)) {
        return false;
    }
    g_mayorAskQ = q;
    g_mayorAskRow = row;
    g_mayorAskByDemon = byDemon;
    g_mayorAskSrcRole = srcRole;
    g_mayorAskSrc = src;
    g_mayorUseTokPath = tokPath;
    g_mayorAskTok = tok;
    BOTC_MayorAskShow(q);
    g_mayorHold = true;
    return true;
}

// 记死亡那条通道（死亡 token 一打上就走这里）
bool BOTC_MayorInterceptRow (int q, int row, int tok) {
    if (row < 0 || row >= g_deathN) {
        return false;
    }
    if (g_deathKind[row] != 1) {
        return false;                       // 只拦「夜间」死因：处决 / 白天死的不算
    }
    return BOTC_MayorTakeOver(q, row, g_deathByDemon[row], -1, 0, false, tok);
}

// 说书人在 token 面板手动打死亡 token 那条通道
bool BOTC_MayorInterceptTok (int q, int t) {
    int k;
    for (k = 0; k < g_deathN; k += 1) {
        if (g_deathTok[k] == t) {
            if (g_deathKind[k] != 1) {
                return false;
            }
            return BOTC_MayorTakeOver(q, k, g_deathByDemon[k], -1, 0, true, t);
        }
    }
    return false;
}

void BOTC_BuildMayorAsk () {
    // 【技能框往右挪 200】（用户 2026-09-23）：镇长弹刀那个框
    DialogCreate(684, 153, c_anchorRight, 185, -70, false);
    g_mayorDlg = DialogLastCreated();
    DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    g_mayorTitle = BOTC_NewLabel(g_mayorDlg, 666, 44, 18, 13, StringToText("镇长夜里要死了：要不要让别人替他死？"));
    libNtve_gf_SetDialogItemStyle(g_mayorTitle, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mayorTitle, false, PlayerGroupAll());
    g_mayorYes = BOTC_NewButton(g_mayorDlg, 306, 50, 27, 81, "是：我选一个人替他死");
    g_mayorNo = BOTC_NewButton(g_mayorDlg, 306, 50, 351, 81, "否：镇长自己死");
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
}

void BOTC_MayorAskShow (int q) {
    g_mayorAskOn = true;
    libNtve_gf_SetDialogItemText(g_mayorTitle, BOTC_PlayerNameText(q) + StringToText(" 夜里要死了：要不要让别人替他死？"), PlayerGroupSingle(g_teller));
    // 【换座位后的说书人也要有按钮】（用户 2026-10-18）
    DialogControlSetVisible(g_mayorYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorYes, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_mayorNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_mayorNo, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_mayorDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "镇长夜里要死了：选【是】= 你点一个人替他死，选【否】= 镇长自己死。");
}

void BOTC_MayorAskHide () {
    g_mayorAskOn = false;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 换局 / 收摊：这一套状态清干净
void BOTC_MayorClear () {
    g_mayorAskOn = false;
    g_mayorPick = false;
    g_mayorBusy = false;
    g_mayorHold = false;
    g_mayorAskQ = 0;
    g_mayorAskRow = 0;
    g_mayorAskSrc = 0;
    g_mayorAskSrcRole = -1;
    g_mayorAskByDemon = 0;
    g_mayorUseTokPath = false;
    g_mayorAskTok = 0;
    if (g_mayorDlg > 0) {
        DialogSetVisible(g_mayorDlg, PlayerGroupAll(), false);
    }
}

// 把挂起来的那次死亡补上（回答【否】/ 放弃替死都走这里）
void BOTC_MayorResolveSelf () {
    int q;
    q = g_mayorAskQ;
    if (q < 2 || q > 13) {
        BOTC_MayorClear();
        return;
    }
    g_mayorBusy = true;
    if (g_mayorUseTokPath) {
        BOTC_SyncDeathFromTok(q, g_mayorAskTok);
    }
    else {
        BOTC_MarkDeathRowTok(q, g_mayorAskRow, g_mayorAskTok, false);
        if (g_mayorAskSrc >= 2) {
            BOTC_PmStore(g_teller, "【夜间】" + BOTC_NameStr(q) + " 被 " + BOTC_NameStr(g_mayorAskSrc) + "（" + BOTC_RoleNameSafe(BOTC_SeatTrueRole(g_mayorAskSrc)) + "）击杀。");
        }
        if (g_mayorAskByDemon != 0) {
            BOTC_NanaLinkCheck(q);
        }
    }
    g_mayorBusy = false;
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 说书人点了【是】/【否】
void BOTC_MayorAnswer (int ans) {
    if (!g_mayorAskOn) {
        return;
    }
    BOTC_MayorAskHide();
    if (ans == 0) {
        BOTC_MayorResolveSelf();
        return;
    }
    g_mayorPick = true;
    g_execPick = false;
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    if (g_deadPick) {
        g_deadPick = false;
        libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "选择一个玩家");
    BOTC_BigHintShow(1, "点一个座位：这个人替镇长死。");
}

// 说书人在魔典上点了座位：这个人替死
void BOTC_MayorVictimAt (int v) {
    int q;
    q = g_mayorAskQ;
    if (v < 2 || v > 13 || v == q || BOTC_SeatDead(v)) {
        BOTC_Notice(g_teller, "这个人不能替他死，换一个。");
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    g_mayorBusy = true;
    BOTC_MarkDeathRowTok(v, g_mayorAskRow, g_mayorAskTok, false);   // 替死：把**同一个**死亡 token 原样转移过去
    g_mayorBusy = false;
    g_tokOn[(((g_teller * 14) + q) * 256) + 18] = true;      // 一次性被动：用掉了
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【镇长】" + BOTC_NameStr(v) + " 替 " + BOTC_NameStr(q) + " 死了。");
    BOTC_MayorClear();
    BOTC_CheckWin();
}

// 点座位之前反悔（按【死亡标记】= 放弃这次替死，镇长照常死）
void BOTC_MayorCancel () {
    if (!g_mayorPick) {
        return;
    }
    g_mayorPick = false;
    BOTC_BigHintHide(g_teller);
    BOTC_MayorResolveSelf();
}

// 通用胜负检查：每次有人死之后都可以调
//   善良胜：场上没有活着的恶魔；邪恶胜：场上只剩 2 人活着；
//   两条同时满足（比如剩 3 人时恶魔被处决）时判善良胜。
bool BOTC_AtheistOn () {
    return BOTC_AbilityInPlay(83);
}

void BOTC_CheckWin () {
    int i;
    int q;
    int r;
    int alive;
    int demonAlive;
    int demonSeat;                 // 已经死掉的那只恶魔坐在哪（0 = 没有）
    bool mmAlive;                  // 主谋是不是活着且清醒
    if (g_gameOver || !g_started) {
        return;
    }
    if (g_scarletPick) {
        return;                         // 等候说书人指定红唇女郎，暂不判胜负
    }
    // 【哥布林(99) 兜底判胜】（用户 2026-10-23 更正）：
    //   必须明确记录为「处决」（g_deadKind == 3）才能触发。
    //   用【死亡标记】打红叉，或其它死亡 token，都不算处决，不得触发哥布林胜利。
    for (i = 2; i <= 13; i += 1) {
        if (!g_goblinClaim[i] || g_goblinClaimDay[i] != g_nightNum) {
            continue;
        }
        if (!BOTC_SeatDead(i) || g_deadKind[i] != 3) {
            continue;
        }
        if (!BOTC_AbilityWorks(i, 99)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) == 3) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
        BOTC_ShowWin(BOTC_SeatAlign(i), "哥布林" + BOTC_NameStr(i) + "亮出了他的真身，", "他的阵营就此得逞。");
        return;
    }
    // 【天亮排队播报还没走完】（用户 2026-09-26）：先不判胜负，等最后一条播完再判
    if (g_dawnQN > 0) {
        return;
    }
    // 【主谋加时期间不判胜负】（用户 2026-09-20）：恶魔被处决之后要打完「加时的一夜 + 一天」，
    //   这段时间唯一的胜负来源是：
    //     ① 加时那一天的处决（`BOTC_ExecToggleAt` 里按真身阵营立刻判负）；
    //     ② 加时那一天没人被处决 → 那个黄昏由 `BOTC_DuskResolve` 收掉加时、再来判（恶魔已死 → 善良胜）。
    //   所以这里直接返回，免得「天一亮」就按「没有活着的恶魔」把善良判胜了。
    if (g_mmExtra && !g_mmDone) {
        return;
    }
    // 【镜像双子（64）】（用户 2026-09-21）：两个双子都活着 → 善良阵营此刻不能获胜（先把双子解决掉）
    if (BOTC_TwinBlocksGood()) {
        BOTC_PmStore(g_teller, "【镜像双子】两只双子都还活着 → 善良阵营现在不能获胜。");
        return;
    }
    demonAlive = 0;
    demonSeat = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        r = BOTC_SeatTrueRole(q);
        // 【判胜负看「确定死亡」= 红叉 + 真的死了】（用户 2026-09-20）----
        //   夜里刚记下的死亡（只有 token、还没到天亮盖红叉）**不算**：等天亮统一结算
        //   （死亡 token 自动打红叉 / 复活 token 自动复活）之后再来判胜负；
        //   僵怖那种「盖了红叉但其实还活着」的座位也不算死。
        if (BOTC_SettledDead(q)) {
            if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
                demonSeat = q;          // 已经公开死亡的恶魔（用来判断「是不是死于处决」）
            }
            continue;
        }
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleTeam(r) == 3) {
            demonAlive = demonAlive + 1;
        }
    }
    // ⓪ 主谋（42）：**恶魔死于处决**、而且主谋还活着且清醒 → 不结算胜负，改打「加时一夜 + 一天」。
    //   ⚠ 用户 2026-09-20 的口径：只有「死于处决」才给加时 ---- 夜里被刀 / 造谣者 / 月之子 / 赌徒
    //     这类死法照常结算（善良胜），主谋不管用。
    if (demonAlive == 0 && !g_mmExtra) {
        mmAlive = false;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (!BOTC_AbilityWorks(q, 42)) {
                continue;
            }
            if (BOTC_SeatDead(q)) {
                continue;
            }
            mmAlive = true;
        }
        if (demonSeat >= 2 && g_deadKind[demonSeat] == 3 && mmAlive) {
            for (i = 0; i < g_seatN; i += 1) {
                q = g_seatList[i];
                if (!BOTC_AbilityWorks(q, 42)) {
                    continue;
                }
                if (BOTC_SeatDead(q)) {
                    continue;
                }
                g_mmExtra = true;
                g_mmArmed = false;
                g_lastDeadSeat = 0;       // 这次恶魔死亡已经转化为主谋加时，不能再改写后续加时处决
                BOTC_PmStore(g_teller, "【主谋】恶魔（" + BOTC_NameStr(demonSeat) + "）死于处决，而主谋（" + BOTC_NameStr(q) + "）还活着 → 进入加时：再打一夜 + 一天；这一天的处决决定胜负。");
                return;
            }
        }
    }
    // 【小怪宝（112）】（用户 2026-10-10）：抽到他的那一局**没有**「真身是恶魔」的角色 ----
    //   恶魔 = 被说书人打上「是恶魔（小怪宝）」的那个人（g_lmSeat）。他一旦「确定死亡」→ 善良胜。
    //   还没指定谁照看（开局那一会儿 g_lmSeat = 0）就先不判，免得一开局就判善良胜。
    if (g_lmOn) {
        // 小怪宝局：照看人（= 现在的恶魔）一死就判善良胜；没别的「恶魔」可杀
        if (g_lmSeat >= 2 && BOTC_SettledDead(g_lmSeat)) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    else {
        // ① 场上没有活着的恶魔 → 善良胜（哪怕这时也只剩 2 人，两条同时满足还是判善良）
        if (demonAlive == 0 && !BOTC_AtheistOn() && !BOTC_SummonerWaiting()) {
            BOTC_ShowWin(0, "镇民们找出并处决了所有恶魔！", "");
            return;
        }
    }
    // ③ 场上只剩 2 人活着（恶魔还活着）→ 邪恶胜
    //   ⚠ 人数也按**公开死亡（红叉）**算：夜里刚死、还没到天亮的先不算 ----
    //     这样「今晚杀人 + 反刍复活」会在天亮一起结算完再判，不会因为说书人还没来得及复活就先判负。
    alive = 0;
    for (i = 0; i < g_seatN; i += 1) {
        if (!BOTC_SettledDead(g_seatList[i])) {
            alive = alive + 1;
        }
    }
    if (alive <= 2) {
        // 【无神论者的特殊胜利】（用户 2026-09-26）：真身无神论者在场 + 只剩 2 人活着（说书人没被处决）→ 说书人胜
        if (BOTC_AtheistOn()) {
            BOTC_ShowWin(2, "只剩 " + IntToString(alive) + " 名玩家存活，说书人没有被处决", "");
            return;
        }
        BOTC_ShowWin(1, "恶魔骗过了镇民，", "屠戮了整个小镇。");
    }
}

// 镇长的特殊胜利：黄昏（进夜晚）时只剩 3 个人活着、且今天没有处决过人 → 他的阵营获胜
void BOTC_CheckMayorWin () {
    int i;
    int q;
    int mayor;
    if (g_gameOver || !g_started) {
        return;
    }
    mayor = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (BOTC_AbilityWorks(q, 12)) {
            mayor = q;
        }
    }
    if (mayor < 2) {
        return;
    }
    if (g_execUsedToday) {
        return;                        // 今天处决过人
    }
    if (BOTC_AliveCountTrue() == 3) {
        BOTC_ShowWin(BOTC_SeatAlign(mayor), "伟大的镇长" + BOTC_NameStr(mayor) + "建了一堵高墙，", "将所有恶魔驱逐出境！");
    }
}

// 胜负横幅：只弹自定义画面（不动游戏自带结束按钮），说书人点【继续】收掉，然后可以开下一把
//   以后想换成图片：把 g_winBg 的贴图按 g_winSide 设成 botc_win_good.dds / botc_win_evil.dds 即可
// 【异端分子(101)】（用户 2026-10-04 / 2026-11-03）：数场上**生效的**异端分子能力份数。
//   口径（用户两次强调）：**醉酒 / 中毒 → 失去能力、不对调**；**死亡 → 不会失去能力、照样对调**。
//   BOTC_SeatImpaired = 醉酒 OR 中毒（包含了「哲学家让人醉」「心上人醉酒」那几份），
//   里面**没有任何**「死了就算失能」的判断 —— 所以这里直接用它就是对的口径。
//   ⚠ 以后别往这里加 BOTC_SeatDead：那会把「死后仍然生效」这条弄没（用户明确要求保留）。
//   （用 BOTC_AbilityWorks 判，所以「哲学家借到异端分子 / 食人族吃掉异端分子 / 炼金术士借到」也算。）
//   多份能力要按次数反复对调（2 份 = 对调 2 次 → 抵消），见 BOTC_ShowWin。
int BOTC_HereticCount () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        if (BOTC_AbilityWorks(i, 101)) {
            n = n + 1;
        }
    }
    return n;
}

bool BOTC_HereticOn () {
    return (BOTC_HereticCount() % 2) == 1;
}

// 【善良的胜利条件现在成立吗】（用户 2026-10-10）：场上没有活着的恶魔
//   小怪宝那一局：恶魔恒等于「照看他的那个人」→ 看他死没死
//   判定口径跟 BOTC_CheckWin 一致：用 BOTC_SettledDead（红叉 + 真的死了），夜里刚记的死亡不算
// 【这一格现在算不算「恶魔」】（用户 2026-10-11）：处决 / 死亡结算里判「一个事件同时达成两边」用
//   · 真身阵营是恶魔（team 3）→ 算；
//   · 小怪宝那一局：照看他的人就是恶魔 —— 他死后那枚 token 会被离场清理收掉，
//     真身会变回他原来的爪牙角色，所以这里用 g_lmSeat 兜住。
bool BOTC_IsDemonSeat (int q) {
    int r;
    if (q < 1 || q > 13) {
        return false;
    }
    r = BOTC_SeatTrueRole(q);
    if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
        return true;
    }
    if (g_lmOn && q == g_lmSeat) {
        return true;
    }
    return false;
}
bool BOTC_GoodWinNow () {
    int i;
    int q;
    int r;
    if (BOTC_SummonerWaiting()) {
        return false;                  // 召唤师未完成召唤：不自动按无恶魔判胜
    }
    if (g_lmOn) {
        if (g_lmSeat < 2) {
            return false;              // 还没指定谁照看 → 先不算善良达成
        }
        return BOTC_SettledDead(g_lmSeat);
    }
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SettledDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r >= 0 && r <= 163 && BOTC_RoleTeam(r) == 3) {
            return false;
        }
    }
    return true;
}

void BOTC_WinAdminRender () {
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupAll(), false);
    if (!g_started || g_isNight || g_gameOver) {
        g_winPanelOn = false;
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    DialogControlSetVisible(g_winAdminBtn, PlayerGroupSingle(g_teller), true);
    if (!g_winPanelOn) {
        DialogSetVisible(g_winAdminDlg, PlayerGroupAll(), false);
        return;
    }
    if (g_winLocked) {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("√ 锁定"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_winAdminLockBtn, StringToText("锁定"), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_winAdminDlg, PlayerGroupSingle(g_teller), true);
}

bool BOTC_WinAdminClick (int p, int c) {
    if (p != g_teller) {
        return false;
    }
    if (c == g_winAdminBtn) {
        g_winPanelOn = !g_winPanelOn;
        BOTC_WinAdminRender();
        return true;
    }
    if (!g_winPanelOn) {
        return false;
    }
    if (c == g_winAdminClose) {
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    if (c == g_winAdminLockBtn) {
        g_winLocked = !g_winLocked;
        BOTC_WinAdminRender();
        if (g_winLocked) {
            BOTC_NoticeKeep(g_teller, "【胜负】已锁定：所有玩家暂时无法获胜。");
        }
        else {
            BOTC_NoticeKeep(g_teller, "【胜负】已解除锁定。");
        }
        return true;
    }
    if (c == g_winAdminGoodBtn || c == g_winAdminEvilBtn) {
        if (g_winLocked) {
            BOTC_Notice(g_teller, "胜负状态已锁定：先点【解锁】才能结算。");
            return true;
        }
        g_manualWin = true;
        if (c == g_winAdminGoodBtn) {
            BOTC_ShowWin(0, "说书人手动宣布善良阵营胜利。", "");
        }
        else {
            BOTC_ShowWin(1, "说书人手动宣布邪恶阵营胜利。", "");
        }
        g_manualWin = false;
        g_winPanelOn = false;
        BOTC_WinAdminRender();
        return true;
    }
    return false;
}

void BOTC_ShowWin (int side, string why1, string why2) {
    if (g_gameOver) {
        return;
    }
    if (!g_started) {
        return;
    }
    if (g_winLocked) {
        BOTC_PmStore(g_teller, "【胜负】当前处于锁定状态，本次胜利被阻止。");
        return;
    }
    // 【双方同时达成胜利条件 → 优先善良胜】（用户 2026-10-10）：全图胜负只有这一个出口，所以规则挂在这里 ——
    //   只要这一次判的不是善良胜，而此刻**善良的胜利条件也成立**（场上没有活着的恶魔；
    //   小怪宝那局 = 照看他的人已死），一律改判**善良胜**。
    //   例：善良的圣徒正带着小怪宝被处决（圣徒规则说善良落败 + 恶魔死亡说善良获胜）→ 判善良胜。
    //   ⚠ **只认「最近一次死亡正好是恶魔」**（`g_lastDeadSeat` + `BOTC_IsDemonSeat`）：
    //     只有「这一下死的是恶魔」才叫同时达成；跟死亡无关的胜利（教派投票 / 只剩 2 人 / 镇长 / 主谋…）
    //     一律不许被这条改写。
    //     （原来用「处决结算中」那个标记会被处决函数里的早退 `return` 漏掉，标记一直留着，
    //       把后面的教派投票也抢成善良胜 —— 用户 2026-10-11 报的就是这个。）
    //   ⚠ 无神论者那局（本来就没有恶魔）不套这条，免得把「说书人胜」也盖掉。
    //   ⚠ 主谋加时中的处决必须按被处决者阵营结算，哪怕 `g_lastDeadSeat` 仍然指向
    //     加时开始前死掉的恶魔，也不能改写为善良胜。
    //   ⚠ **还要再确认「场上真的没有别的恶魔活着」**（用户 2026-10-13 报的方古 BUG）：
    //     方古那一刀是「老方古死 + 外来者当场变成新方古」，最近死的确实是恶魔，可新方古还活着
    //     → 这时候判邪恶胜（只剩 2 人）是对的，**不能**被这条改写成善良胜。
    //     所以再加一道 `BOTC_GoodWinNow()`（= 场上没有活着的恶魔；小怪宝那局 = 照看人已死）。
    if (!g_manualWin && !g_mmExtra && side != 0 && !BOTC_AtheistOn() && BOTC_GoodWinNow() && g_lastDeadSeat >= 2 && g_lastDeadSeat <= 13 && BOTC_SeatDead(g_lastDeadSeat) && BOTC_IsDemonSeat(g_lastDeadSeat)) {
        side = 0;
        why1 = "镇民们找出并处决了所有恶魔！";
        why2 = "";
        BOTC_PmStore(g_teller, "【胜负】双方同时达成胜利条件 → 按规则优先判**善良胜**。");
    }
    // 【异端分子(101)】（用户 2026-10-04）：官方口径 —— 有生效的异端分子 → **胜负对调**（死后仍然生效）。
    //   放在 BOTC_ShowWin 里 = **所有阵营胜负自动全覆盖**（用户 2026-10-04 明确要求「特殊胜利也要」）：
    //     恶魔全灭 / 只剩 2 人 / 镇长 / 圣徒 / 镜像双子 / 哥布林 / 恐惧之灵 / 主谋加时两个分支 /
    //     无神论者被处决 / 处决说书人 …… 全图只有这一个出口，所以都是在同一处对调。
    //   ⚠ 没有例外（用户 2026-10-04 定稿「异端分子会反转所有胜负」）：
    //     连「说书人胜」（side 2 = 无神论者那条「只剩两人存活且说书人没被处决」）也一起反转，
    //     说书人那一侧是对局里的「邪恶」方 → 反转后记成**善良胜**（side 0）。
    //   ⚠ 多份异端分子能力按次数叠加对调（2 份 = 对调两次 → 抵消；3 份 = 对调一次）。
    if (!g_manualWin && BOTC_HereticOn()) {
        if (side == 0) {
            side = 1;
        }
        else {
            side = 0;
        }
        // 结局文案要**明说**被改写过：不然原来那句（例如「哥布林…他的阵营就此得逞」、
        // 「神之使徒…」这类按「谁赢」写死的话）会跟真实结果自相矛盾。
        why1 = "【异端分子】在场，结局已被改写——" + why1;
        why2 = why2 + "（异端分子在场：胜负结果已被对调）";
        BOTC_PmStore(g_teller, "【异端分子】能力生效 → 这次胜负对调。");
    }

    g_gameOver = true;
    // 【场次统计】（用户 2026-10-20）：唯一胜负出口只记一次；此时阵营 / 说书人座位都已经确定。
    BOTC_StatsRecord(side);
    // 【中途退出的座位要留到重新开始】（用户 2026-11-03）：结算期间玩家还要复盘看全场身份和 token，
    //   所以这里不再移除；等说书人点【重新开始】时才由 BOTC_WinRestart() 调用 BOTC_ClearLeftSeats()。
    // 【胜负那一刻也清投票状态】（用户 2026-10-10）：白天可能正停在提名 / 投票中间就分出了胜负 ——
    //   跟入夜用的是同一个 BOTC_NomReset()：已投 / 弃权 / 票数 / 待处决 / 提名记录全清，
    //   并退出提名阶段（免得胜负面板后面还挂着上一轮的投票标记）。
    BOTC_NomReset();
    g_cultOn = false;          // 【教派投票】：胜负已定就把这一轮投票收掉
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    g_winSide = side;
    g_winChat1 = why1;
    g_winChat2 = why2;
    if (StringLength(why2) > 0) {
        g_winReason = why1 + "\n" + why2;
    }
    else {
        g_winReason = why1;
    }
    g_winStage = true;
    BOTC_MusicStop();
    BOTC_PlaySfxTimed(g_sfxJieSuanName, 2.0);
    BOTC_EndNoticeShow();
    TimerStart(g_tWinStage, 5.0, false, c_timeGame);
}

// 胜利该放哪一首（善良胜 + 存活 ≤ 3 → 第二首；邪恶胜 → 那首邪恶曲）
string BOTC_WinTrackName () {
    if (g_winSide == 1) {
        return g_musicEvilName;
    }
    if (BOTC_AliveCountTrue() <= 3) {
        return g_musicGood2Name;
    }
    return g_musicGood1Name;
}

// 2 秒过场结束：弹胜利面板 + 播胜利曲
bool BOTC_WinStageFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_winStage) {
        return true;
    }
    g_winStage = false;
    BOTC_EndNoticeHide();          // 字幕收掉，换成胜利面板
    BOTC_ShowWinNow();
    BOTC_MusicPlay(BOTC_WinTrackName(), 6, 0.0);   // 优先级 6：比准备阶段（4）还高，谁都盖不掉
    return true;
}

//--------------------------------------------------------------------------------------------------
// 结算过场：屏幕正中那句「游戏结束，我们得到的结果是：」
//   放 jiesuan 音效的时候弹出来，一直留到胜利面板弹出 ---- 所以它有自己的一套显隐，
//   不走 BOTC_BigNotice 那个「3.5 秒自动收起」。
//--------------------------------------------------------------------------------------------------

// 跟 BOTC_NewLabelC 一样，但创建标签最后那个固定值（2.0）能自己给 ---- 用聊天指令 wbig 试它是不是字号倍率
int BOTC_NewLabelCY (int d, int w, int h, int x, int y, text t, fixed f) {
    libNtve_gf_CreateDialogItemLabel(d, w, h, c_anchorTopLeft, x, y, t, ColorWithAlpha(0.0, 0.0, 0.0, 0.0), true, f);
    return DialogControlLastCreated();
}

void BOTC_EndNoticeMake () {
    if (g_endDlg != 0) {
        DialogDestroy(g_endDlg);       // 用 wbig 调参数时重建：先把旧的拆掉，免得叠层
        g_endDlg = 0;
    }
    DialogCreate(900, 120, c_anchorCenter, 0, 0, false);
    g_endDlg = DialogLastCreated();
    DialogSetImageVisible(g_endDlg, false);
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
    // 文字在标签里是**左对齐**的，居中得靠自己补偏移：这句 13 个字大概 390 宽，
    //   所以左边缘放在「中间往左 195」= 对话框内 x 255。嫌偏左偏右就改这个 255。
    g_endLbl = BOTC_NewLabelCY(g_endDlg, 880, 120, 255, 0, TextWithColor(StringToText("游戏结束，我们得到的结果是："), Color(255, 215, 60)), g_endSize);
    libNtve_gf_SetDialogItemStyle(g_endLbl, g_endStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_endLbl, false, PlayerGroupAll());
}

void BOTC_BuildEndNotice () {
    BOTC_EndNoticeMake();
}

void BOTC_EndNoticeShow () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), true);
}

void BOTC_EndNoticeHide () {
    DialogSetVisible(g_endDlg, PlayerGroupAll(), false);
}

// 真正弹面板（原来的 BOTC_ShowWin 内容）
void BOTC_ShowWinNow () {
    // 【屏蔽】（用户 2026-11-06）：结算时自动解除所有玩家的屏蔽，复盘阶段大家都能看到全部发言。
    BOTC_BlockClearAll();
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_winLabel, StringToText("特殊胜利"), PlayerGroupAll());
        BOTC_PubAnnounce("【胜负】特殊胜利 ---- 说书人获胜：" + g_winChat1);
        if (StringLength(g_winChat2) > 0) {
            BOTC_PubAnnounce(g_winChat2);
        }
    }
    else {
        if (g_winSide == 1) {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("邪恶阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】邪恶阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
        else {
            libNtve_gf_SetDialogItemText(g_winLabel, StringToText("善良阵营胜利"), PlayerGroupAll());
            BOTC_PubAnnounce("【胜负】善良阵营胜利 ---- " + g_winChat1);
            if (StringLength(g_winChat2) > 0) {
                BOTC_PubAnnounce(g_winChat2);
            }
        }
    }
    // 分胜负了：邪恶小窗也一起关掉（免得盖在结算面板上）
    BOTC_EvilClose();
    libNtve_gf_SetDialogItemText(g_winSub, BOTC_NameSubst(g_winReason), PlayerGroupAll());   // 结算面板的正文：名字换成真名
    DialogSetVisible(g_winDlg, PlayerGroupAll(), true);
    BOTC_RateShowAll();             // 【说书人评分】结算面板下方的打分行发给除说书人以外的玩家
    // 【结算即自动公开真魔典】（用户 2026-11-03）：胜负一出就把说书人那份魔典（身份 + 全部 token）
    //   摊给全场，复盘时人人都能看到所有人的角色和标记；不再需要说书人手动点【复盘（公开魔典）】。
    BOTC_ReplayReveal();
    // 【换座位后的说书人也要能点】（用户 2026-10-18）：继续 / 复盘按钮按「现在的」说书人露出来
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_winBtn, PlayerGroupSingle(g_teller), true);
    // 结算时已经自动公开真魔典，不再保留单独的复盘按钮。
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    // 胜利面板上面那条「恭喜...获胜」（名字带各自的颜色）
    //   【2026-09-16 用户要求】要的是「去掉对话框（黑框）、信息留住」---- 所以这里照常显示，
    //   黑底在 BOTC_BuildWinCongrats() 里已经关掉了（那两行注释）。
    if (g_winSide == 2) {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsStText(), PlayerGroupAll());
    }
    else {
        libNtve_gf_SetDialogItemText(g_congratsLbl, BOTC_CongratsText(), PlayerGroupAll());
    }
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), true);
}

void BOTC_BuildWin () {
    DialogCreate(660, 250, c_anchorCenter, 150, 0, false);
    g_winDlg = DialogLastCreated();
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】胜利面板不要底图：对话框自带的那层默认面板图也关掉，
    //   只留文字 + 复盘 / 继续两个按钮（黑图那层早就在下面 g_winBg 处隐藏了）
    DialogSetImageVisible(g_winDlg, false);
    libNtve_gf_CreateDialogItemImage(g_winDlg, 660, 250, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_winBg = DialogControlLastCreated();
    DialogControlSetPosition(g_winBg, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    libNtve_gf_SetDialogItemAcceptMouse(g_winBg, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_winBg, "botc_black.dds", PlayerGroupAll());
    // 【2026-09-16 用户要求】胜利面板先不要黑底：底图控件直接藏掉
    //   ⚠ 不能只是「不设贴图」---- 没贴图的图片控件会被星际画成占位蓝块，所以是「设了贴图再隐藏」
    DialogControlSetVisible(g_winBg, PlayerGroupAll(), false);
    g_winLabel = BOTC_NewLabelC(g_winDlg, 640, 60, 85, 55, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_winLabel, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winLabel, false, PlayerGroupAll());
g_winSub = BOTC_NewLabelC(g_winDlg, 1160, 64, 10, 118, StringToText(""));
libNtve_gf_SetDialogItemStyle(g_winSub, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_winSub, false, PlayerGroupAll());
    g_winBtn = BOTC_NewButton(g_winDlg, 260, 40, 200, 180, "重新开始");
    DialogControlSetVisible(g_winBtn, PlayerGroupAll(), false);
    // 【复盘】说书人专用：把自己的魔典（含 token）替换给全场
    g_replayBtn = BOTC_NewButton(g_winDlg, 240, 40, 80, 180, "复盘（公开魔典）");
    DialogControlSetVisible(g_replayBtn, PlayerGroupAll(), false);
    DialogControlSetPosition(g_winBtn, PlayerGroupAll(), c_anchorTopLeft, 340, 180);
}

// 【说书人评分】（用户 2026-11-02）：结算面板下方的 1..5 分打分框。
//   只发给除说书人以外的在场真人；点完一次后本局不能再改。
void BOTC_BuildRate () {
    int i;
    DialogCreate(660, 46, c_anchorCenter, 150, 150, false);
    g_rateDlg = DialogLastCreated();
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    DialogSetImageVisible(g_rateDlg, false);
    g_rateLbl = BOTC_NewLabel(g_rateDlg, 170, 30, 8, 8, StringToText("为说书人打分："));
    libNtve_gf_SetDialogItemStyle(g_rateLbl, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_rateLbl, false, PlayerGroupAll());
    for (i = 0; i < 5; i += 1) {
        g_rateBtn[i] = BOTC_NewButton(g_rateDlg, 84, 30, 178 + (i * 92), 8, IntToString(i + 1) + " 分");
        libNtve_gf_SetDialogItemStyle(g_rateBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupAll(), false);
    }
}

void BOTC_RateShowAll () {
    int p;
    int i;
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);
    for (i = 0; i < 5; i += 1) {
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupAll(), false);
    }
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (PlayerType(g_teller) != 1) {
        return;                            // 电脑说书人不接受评分
    }
    for (p = 2; p <= 13; p += 1) {
        if (p == g_teller) {
            continue;
        }
        if (PlayerType(p) != 1) {
            continue;
        }
        if (PlayerStatus(p) == 2) {
            continue;
        }
        libNtve_gf_SetDialogItemText(g_rateLbl, StringToText("为说书人打分："), PlayerGroupSingle(p));
        DialogControlSetSize(g_rateLbl, PlayerGroupSingle(p), 170, 30);
        for (i = 0; i < 5; i += 1) {
            DialogControlSetVisible(g_rateBtn[i], PlayerGroupSingle(p), true);
        }
        DialogSetVisible(g_rateDlg, PlayerGroupSingle(p), true);
    }
}

void BOTC_RateSubmit (int p, int v) {
    bank bk;
    int rs;
    int rc;
    int rep;
    int i;
    if (!g_gameOver) {
        return;
    }
    if (p < 2 || p > 13 || p == g_teller) {
        return;
    }
    if (g_ratedP[p]) {
        return;
    }
    if (v < 1 || v > 5) {
        return;
    }
    if (g_teller < 1 || g_teller > 13 || PlayerType(g_teller) != 1) {
        return;
    }
    if (PlayerType(p) != 1 || PlayerStatus(p) == 2) {
        return;
    }
    g_ratedP[p] = true;
    BOTC_BankInit();
    bk = g_bank[g_teller];
    rs = 0;
    rc = 0;
    if (BankKeyExists(bk, "stats", "rs")) {
        rs = BankValueGetAsInt(bk, "stats", "rs");
    }
    if (BankKeyExists(bk, "stats", "rc")) {
        rc = BankValueGetAsInt(bk, "stats", "rc");
    }
    BankValueSetFromInt(bk, "stats", "rs", rs + v);
    BankValueSetFromInt(bk, "stats", "rc", rc + 1);
    // 【声望值】（用户 2026-11-03）：按分数增减，最低 0。
    rep = BOTC_TellerRepGet(bk) + BOTC_RepDelta(v);
    if (rep < 0) {
        rep = 0;
    }
    BankValueSetFromInt(bk, "stats", "rep", rep);
    // 【积分】（用户 2026-11-06）：说书人按每名玩家打的分累计积分，1..5 星 +10/+15/+20/+25/+30；
    //   每名玩家本局只计一次（g_ratedP 已在上方拦截重复打分）。
    BOTC_StatsPointAdd(bk, BOTC_RatePointDelta(v));
    BankSave(bk);
    libNtve_gf_SetDialogItemText(g_rateLbl, StringToText("已评分：" + IntToString(v) + " 分，感谢反馈。"), PlayerGroupSingle(p));
    // 【评分文字被省略号截断】（用户 2026-11-05）：打分按钮收起后把标签放宽，保证整句显示完整
    DialogControlSetSize(g_rateLbl, PlayerGroupSingle(p), 460, 30);
    for (i = 0; i < 5; i += 1) {
        DialogControlSetVisible(g_rateBtn[i], PlayerGroupSingle(p), false);
    }
}

// 胜利面板上面那条「恭喜...获胜」：单独一个对话框，放在胜利面板正上方
//   名字用每个玩家自己的颜色，字体跟「提名开始」那 4 个字一样大
void BOTC_BuildWinCongrats () {
    DialogCreate(1100, 76, c_anchorCenter, 150, -186, false);
    g_congratsDlg = DialogLastCreated();
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条也不要底图（对话框自带的默认面板图）
    DialogSetImageVisible(g_congratsDlg, false);
    // 【2026-09-16 用户要求】「恭喜...获胜」那条先不要黑底（想恢复就把下面两行放开）
    //   原来注释：给这条恭喜也铺一块黑底（跟胜利面板同款），不然文字直接压在草地上看不清
    // DialogSetImage(g_congratsDlg, "botc_black.dds");
    // DialogSetImageVisible(g_congratsDlg, true);
    g_congratsLbl = BOTC_NewLabelC(g_congratsDlg, 1080, 76, 10, 0, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_congratsLbl, g_nomBigStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_congratsLbl, false, PlayerGroupAll());
}

// 拼「恭喜 玩家1、玩家2 获胜」----赢的那一方（g_winSide：0 = 善良 / 1 = 邪恶）
//   每个名字用他自己的玩家颜色
text BOTC_CongratsText () {
    int i;
    int q;
    text t;
    bool first;
    t = StringToText("恭喜 ");
    first = true;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        // 【按阵营算，不按身份】（用户 2026-09-20）：默认镇民 / 外来 = 善良、爪牙 / 恶魔 = 邪恶，
        //   但身上打了「善良(14) / 邪恶(15)」token 的座位按那个 token 算（莽夫转阵营就靠这个）。
        if (BOTC_WinAlignOf(q) != g_winSide) {
            continue;
        }
        if (!first) {
            t = t + StringToText("、");
        }
        t = t + BOTC_PlayerNameText(q);
        first = false;
    }
    if (first) {
        return StringToText("本局结束");
    }
    return t + StringToText(" 获胜");
}

// 【特殊胜利】（无神论者在场 + 只剩 2 人活着）：「恭喜…」那行只写说书人的名字
text BOTC_CongratsStText () {
    return StringToText("恭喜 ") + BOTC_PlayerNameText(1) + StringToText(" 获胜");
}

// 复盘：把说书人那份魔典（身份 + 全部 token）复制给每个玩家自己那份，并摊开给全场看
void BOTC_ReplayReveal () {
    int ob;
    int q;
    int t;
    int k;
    BOTC_BuildSeatList();
    for (q = 2; q <= 13; q += 1) {
        if (g_who[q] < 1) {
            continue;
        }
        ob = g_who[q];
        for (t = 2; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = g_mark[(g_teller * 14) + t];
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = g_tokOn[(((g_teller * 14) + t) * 256) + k];
            }
        }
    }
    g_replayOn = true;
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    BOTC_PubAnnounce("【复盘】说书人把真实魔典（身份 + token）公开给全场。");
}

// 清空所有玩家各自魔典里的「缓存身份 + token」
//   （【取消正式开始】/【切换板子】时用）：玩家那一行整行清干净，连自己座位上的
//   身份标记也不留，避免上一把 / 上一张板子的角色和 token 带进下一把。
//   说书人那一行是真值，不能清；玩家要看自己的角色走【我的角色】页面。
void BOTC_GrimResetPerPlayer () {
    int ob;
    int t;
    int k;
    for (ob = 1; ob <= 13; ob += 1) {
        if (ob == g_teller) {
            continue;                          // 说书人那一行是真值，不能清
        }
        for (t = 0; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = 0;
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
    }
    g_replayOn = false;
    for (ob = 1; ob <= 13; ob += 1) {
        g_grimSnapOn[ob] = false;
        BOTC_GrimRender(ob);
    }
}

// 【取消正式开始 / 切换板子 · 全场清空】（用户 2026-11-06）：连说书人真值行一起清，
//   所有人魔典上的角色标记和 token 全部归零，回到「还没发牌」的干净状态。
//   ⚠ 只在取消正式开始 / 换板子时调用；发牌流程里不能用，否则会把刚配好的真值身份清掉。
void BOTC_GrimClearAllRows () {
    int ob;
    int t;
    int k;
    for (ob = 1; ob <= 13; ob += 1) {
        for (t = 0; t <= 13; t += 1) {
            g_mark[(ob * 14) + t] = 0;
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((ob * 14) + t) * 256) + k] = false;
            }
        }
    }
    g_replayOn = false;
    for (ob = 1; ob <= 13; ob += 1) {
        g_grimSnapOn[ob] = false;
        BOTC_GrimRender(ob);
    }
}

void BOTC_WinClose () {
    DialogSetVisible(g_winDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_congratsDlg, PlayerGroupAll(), false);   // 上面那条「恭喜...」一起收掉
    DialogSetVisible(g_rateDlg, PlayerGroupAll(), false);       // 【说书人评分】打分框一起收掉
    g_gameOver = false;
    // ⚠ 这里**不**停胜利曲：面板收掉之后胜利 BGM 还要一直放着，
    //   直到说书人点【取消正式开始】（那一步会 BOTC_MusicStop）。
}

// 【重新开始】（用户 2026-11-01）：结算面板上原来那个【继续】改成【重新开始】，
//   点一下就把这一局清干净（等同【取消正式开始】）并回到剧本选择页面。
void BOTC_WinRestart () {
    BOTC_WinClose();
    // 【这时候才移除中途退出的座位】（用户 2026-11-03）：结算期间它们要留着给全场复盘，
    //   说书人点【重新开始】才统一从圆桌上拿掉；接着 BOTC_GameStartCancel() 的换局重置会再清一次表。
    BOTC_ClearLeftSeats();
    BOTC_GameStartCancel();        // 清掉上一局：天数 / token / 魔典 / 日志 / 音乐都回到准备阶段
    g_dealConfirmed = false;       // 重新选剧本，旧的发牌作废
    BOTC_BoardOpen();              // 进入剧本选择页面
}

//==================================================================================================
// 传位面板：恶魔死了之后，说书人点一名活着的爪牙，让他变成新的小恶魔
//   （智能说书模式不弹这个面板，直接随机挑一名；面板是纯自定义界面，跟游戏自带结束按钮无关）
//==================================================================================================
void BOTC_BuildPromote () {
    int i;
    DialogCreate(378, 288, c_anchorRight, 338, -70, false);
    g_promDlg = DialogLastCreated();
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
    g_promTitle = BOTC_NewLabelC(g_promDlg, 360, 30, 9, 7, StringToText("恶魔死了：点一名爪牙接位"));
    libNtve_gf_SetDialogItemStyle(g_promTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_promTitle, false, PlayerGroupAll());
    for (i = 0; i < 12; i += 1) {
        g_promBtn[i] = BOTC_NewButton(g_promDlg, 162, 31, 18 + ((i % 2) * 180), 41 + ((i / 2) * 34), "");
        DialogControlSetVisible(g_promBtn[i], PlayerGroupAll(), false);
        g_promSeat[i] = 0;
    }
    g_promClose = BOTC_NewButton(g_promDlg, 198, 31, 90, 248, "取消（我自己处理）");
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
}

void BOTC_PromoteOpen () {
    int i;
    int q;
    int n;
    if (g_gameOver || !g_started) {
        return;
    }
    for (i = 0; i < 12; i += 1) {
        DialogControlSetVisible(g_promBtn[i], PlayerGroupSingle(g_teller), false);
        g_promSeat[i] = 0;
    }
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!BOTC_SeatIsMinion(q)) {
            continue;
        }
        libNtve_gf_SetDialogItemText(g_promBtn[n], BOTC_PlayerNameText(q) + StringToText("（" + BOTC_SeatRoleStr(q) + "）"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_promBtn[n], PlayerGroupSingle(g_teller), true);
        g_promSeat[n] = q;
        n = n + 1;
        if (n >= 12) {
            break;
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "场上没有活着的爪牙，没人能接位。");
        return;
    }
    // 【换座位后的说书人也要有关闭键】（用户 2026-10-18）
    DialogControlSetVisible(g_promClose, PlayerGroupAll(), false);
    DialogControlSetVisible(g_promClose, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_promDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_PromoteHide () {
    DialogSetVisible(g_promDlg, PlayerGroupAll(), false);
}

// 小恶魔自刀之后的传位：智能说书随机挑一名活着的爪牙；手动说书只解锁身份编辑，说书人自己点
// 小恶魔自刀之后的传位：返回 true = 有人接了位子（游戏继续，不算善良胜）
bool BOTC_ImpPromote () {
    int i;
    int q;
    int n;
    int pick;
    BOTC_BuildSeatList();
    n = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (BOTC_SeatAliveQ(q)) {
            if (BOTC_SeatIsMinion(q)) {
                n = n + 1;
            }
        }
    }
    if (n <= 0) {
        BOTC_Notice(g_teller, "小恶魔自刀死了，场上没有活着的爪牙，邪恶方没人可传。");
        BOTC_PmStore(g_teller, "【天亮】小恶魔自刀死了，场上没有活着的爪牙。");
        return false;         // 没人接位：交给调用方按胜负条件判（没有恶魔 → 善良胜）
    }
    // 手动说书：弹传位面板，说书人点一名爪牙接位（身份面板也顺手解锁，兜底用）
    g_promoteOpen = true;
    BOTC_PromoteOpen();
    BOTC_PmStore(g_teller, "【传位】等说书人传位。活着的爪牙：" + BOTC_MinionListStr());
    return true;              // 等说书人接位，这局先不算结束
}

//==================================================================================================
// 占卜师（Fortune Teller）：每晚选两名玩家，说书人回答「有 / 没有」恶魔
//   干扰项也算恶魔；间谍 / 陌客按各自的登记算；中毒 / 酒鬼的占卜师会收到相反答案（大概率）
//   信息统一由 1 号（智能说书）通过私聊发给本人
//==================================================================================================

// 占卜师点了座位：选满两个人就出结果
void BOTC_FtPick (int p, int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (!g_ftPick[p]) {
        return;
    }
    if (g_ftFirst[p] == 0) {
        g_ftFirst[p] = q;
        BOTC_Notice(p, "已选 " + BOTC_NameStr(q) + "，再点第二位玩家。");
        return;
    }
    if (q == g_ftFirst[p]) {
        BOTC_Notice(p, "两个人不能是同一个，换一个。");
        return;
    }
    BOTC_FtAnswer(p, g_ftFirst[p], q);
    g_ftPick[p] = false;
    g_ftFirst[p] = 0;
}

//==================================================================================================
// 【酒鬼 / 中毒的占卜师专用】看不见的「假干扰项」
//   占卜师中毒 → 1 个假干扰项；占卜师是酒鬼 → 2 个（放在 2 个非恶魔玩家身上，其中一个也可能是爪牙）。
//   持有者大概率是「被动触发 / 大信息位」：按随机发牌同款镇民分类，
//   持续信息位（2）/ 死亡能力（4）/ 无主动能力（6）的镇民最合适，另外陌客也算；
//   极小概率落在一次性信息者（分类 1，含首夜信息位），其余角色是中概率。
//   占卜师验到假干扰项的持有者，一律报「有恶魔」，不吃那 70% 的看反概率。
//   只给智能说书判定用：没有界面、不占 g_tokOn；占卜师死了或者中毒解除就移除。
//==================================================================================================

// 这个身份当假干扰项「有多合适」（权重；<= 0 = 不给这个身份）
int BOTC_FtFakeWeight (int r) {
    if (r < 0 || r > 163) {
        return 0;
    }
    // 【改读随机发牌同款镇民分类】（用户 2026-11-06）：不再硬编码共情者 / 守鸦人 / 士兵 / 镇长。
    //   持续信息位 2 / 死亡能力 4 / 无主动能力 6 的镇民最适合当假干扰项。
    if (BOTC_RoleTeam(r) == 0 && (g_roleInfoClass[r] == 2 || g_roleInfoClass[r] == 4 || g_roleInfoClass[r] == 6)) {
        return 12;                     // 持续信息 / 死亡能力 / 无主动能力：最适合
    }
    if (r == 15) {
        return 12;                     // 陌客：外来者干扰身份
    }
    if (g_roleInfoClass[r] == 1) {
        return 1;                      // 一次性信息者（含首夜信息位）：极小概率
    }
    return 4;                          // 其他角色：中概率
}

// 在「可以当假干扰项」的座位里按权重抽一个
//   mode：0 = 只要善良 / 1 = 只要爪牙 / 2 = 善良或爪牙都行
//   allowChecked = false 时跳过占卜师已经验过的座位（免得他验过「没恶魔」之后又变成有恶魔）
int BOTC_FtFakePickSeat (int ft, int mode, bool allowChecked) {
    int i;
    int q;
    int r;
    int w;
    int wsum;
    int pick;
    pick = 0;
    wsum = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == ft) {
            continue;
        }
        if (BOTC_SeatDead(q)) {
            continue;
        }
        if (!allowChecked) {
            if (g_ftChkSeat[q]) {
                continue;
            }
        }
        if (BOTC_SeatTeam(q) == 3) {
            continue;                  // 恶魔永远不上这个假干扰项
        }
        if (q == g_herring) {
            continue;                  // 真干扰项那个座位不重复占
        }
        if (q == g_ftFakeSeat[0] || q == g_ftFakeSeat[1]) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0) {
            continue;
        }
        if (mode == 0) {
            if (BOTC_RoleAlign(r) != 0) {
                continue;
            }
        }
        if (mode == 1) {
            if (BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        if (mode == 2) {
            if (BOTC_RoleAlign(r) != 0 && BOTC_RoleTeam(r) != 2) {
                continue;
            }
        }
        w = BOTC_FtFakeWeight(g_mark[(g_teller * 14) + q] - 1);
        if (w <= 0) {
            continue;
        }
        wsum = wsum + w;
        if (RandomInt(1, wsum) <= w) {
            pick = q;
        }
    }
    return pick;
}

// 每次占卜师要验人之前调一次：把假干扰项同步到「当前该有的样子」----
//   占卜师清醒 / 已死 → 全部移除；酒鬼 → 2 个；中毒 → 1 个。状态没变就沿用，不重抽。
void BOTC_FtFakeSync () {
    int i;
    int q;
    int ft;
    int w;
    int mode;
    int pick;
    int n;
    string s;
    ft = 0;
    w = 0;
    if (w <= 0) {
        if (g_ftFakeOwner != 0) {
            BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项已移除（占卜师清醒 / 已死亡）。");
        }
        g_ftFakeSeat[0] = 0;
        g_ftFakeSeat[1] = 0;
        g_ftFakeOwner = 0;
        g_ftFakeWant = 0;
        return;
    }
    if (g_ftFakeOwner == ft && g_ftFakeWant == w) {
        // 状态没变：基本沿用已经打好的假干扰项，但有两种例外要处理 ----
        //   持有者「还没被验过就死了」→ 把 token 转给别的玩家（优先级 / 权重跟原来一样）；
        //   已经验过的持有者不动（信息已经发出去了，再换人就自相矛盾了）。
        for (i = 0; i < 2; i += 1) {
            q = g_ftFakeSeat[i];
            if (q < 2) {
                continue;
            }
            if (!BOTC_SeatDead(q)) {
                continue;
            }
            if (g_ftChkSeat[q]) {
                continue;              // 已经验过：不转移
            }
            g_ftFakeSeat[i] = 0;       // 先空出来，免得抽到自己
            mode = 0;
            if (i == 1) {
                if (RandomInt(1, 100) <= 30) {
                    mode = 1;
                }
            }
            pick = BOTC_FtFakePickSeat(ft, mode, false);
            if (pick <= 0 && mode == 1) {
                pick = BOTC_FtFakePickSeat(ft, 0, false);
            }
            if (pick <= 0) {
                pick = BOTC_FtFakePickSeat(ft, 2, false);
            }
            if (pick <= 0) {
                // 实在没得挑（比如只剩验过的人）才允许放到验过的座位上
                pick = BOTC_FtFakePickSeat(ft, 2, true);
            }
            g_ftFakeSeat[i] = pick;
            if (pick >= 2) {
                BOTC_DiagStore(g_teller, "【诊断占卜师】假干扰项转移： " + BOTC_NameStr(q) + " 还没被验过就死了 → 转到 " + BOTC_NameStr(pick) + "。");
            }
        }
        return;
    }
    g_ftFakeOwner = ft;
    g_ftFakeWant = w;
    g_ftFakeSeat[0] = 0;
    g_ftFakeSeat[1] = 0;
    for (i = 0; i < w; i += 1) {
        mode = 0;                      // 默认给善良角色
        if (i == 1) {
            // 第 2 个假干扰项：小概率落在爪牙身上（酒鬼占卜师两个，其中一个可以是爪牙）
            if (RandomInt(1, 100) <= 30) {
                mode = 1;
            }
        }
        pick = BOTC_FtFakePickSeat(ft, mode, false);
        if (pick <= 0 && mode == 1) {
            pick = BOTC_FtFakePickSeat(ft, 0, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, false);
        }
        if (pick <= 0) {
            pick = BOTC_FtFakePickSeat(ft, 2, true);
        }
        g_ftFakeSeat[i] = pick;
    }
    // 【诊断】写清楚打给了谁（不占 token、玩家看不到）
    s = "【诊断占卜师】假干扰项（他是" + BOTC_DiagStateStr(ft) + "）：";
    n = 0;
    for (i = 0; i < 2; i += 1) {
        if (g_ftFakeSeat[i] >= 2) {
            if (n > 0) {
                s = s + "、";
            }
            s = s + BOTC_NameStr(g_ftFakeSeat[i]);
            n = n + 1;
        }
    }
    if (n <= 0) {
        s = s + "没找到合适的人";
    }
    BOTC_PmStore(g_teller, s + " ---- 验到他们会报「有恶魔」");
}

// 给出答案：有 / 没有 恶魔（信息只给本人）
void BOTC_FtAnswer (int ob, int a, int b) {
    bool demon;
    bool realDemon;
    bool lie;
    // 先记下「这两个座位已经被验过了」再同步：这样正在验的这个座位不会被当成
    //   「没验过就死了」而把假干扰项转走（他这一验就是验它）。
    if (a >= 2 && a <= 13) {
        g_ftChkSeat[a] = true;
    }
    if (b >= 2 && b <= 13) {
        g_ftChkSeat[b] = true;
    }
    BOTC_FtFakeSync();                 // 再按当前状态把「假干扰项」同步好（酒鬼 2 个 / 中毒 1 个 / 清醒清掉；
                                       // 持有者没被验过就死了会在这里转给别人）
    // 真值：按「登记」那一层算（干扰项也算恶魔）
    realDemon = false;
    if (a == g_herring || b == g_herring) {
        realDemon = true;
    }
    if (BOTC_RegAsDemon(ob, a) || BOTC_RegAsDemon(ob, b)) {
        realDemon = true;
    }
    // 他实际被告知的答案：清醒 = 真值；中毒 / 酒鬼 = 他自己那一层（一个座位只判一次）
    demon = false;
    if (BOTC_RegistersAsDemonToFT(ob, a)) {
        demon = true;
    }
    if (BOTC_RegistersAsDemonToFT(ob, b)) {
        demon = true;
    }
    lie = (demon != realDemon);
    // 【真人说书 · 信息位答题框】（用户 2026-09-20）：弹一个填数字的小窗给说书人，填完自动发给占卜师本人。
    //   要不要骗他（酒鬼 / 中毒）由你在框里填什么数字决定。
    BOTC_ManInfoOpen(BOTC_PosOf(ob), 5, BOTC_NameStr(a) + " / " + BOTC_NameStr(b));
    BOTC_PmStore(g_teller, BOTC_NameStr(BOTC_PosOf(ob)) + " 选择了 " + BOTC_NameStr(a) + "、" + BOTC_NameStr(b));
    if (BOTC_SeatImpaired(BOTC_PosOf(ob))) {
        // 中毒 / 酒鬼：单独一行写清楚（报的什么 / 真值 / 两个座位各自是不是干扰项）
        BOTC_DiagFtLine(BOTC_PosOf(ob), a, b, demon, realDemon);
    }
    else {
        BOTC_DiagSeatLine("占卜师", BOTC_PosOf(ob), lie, a, b);
    }
}

// 给一个「不一样的身份」（中毒 / 酒鬼说假话时用；只在 0..16 的善良身份里挑，免得答案太离谱）
int BOTC_WrongRole (int r) {
    int k;
    int i;
    for (i = 0; i < 40; i += 1) {
        k = RandomInt(0, 16);
        if (k != r) {
            return k;
        }
    }
    if (r == 0) {
        return 1;
    }
    return 0;
}

