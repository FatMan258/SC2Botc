    g_tipLine[706] = StringToText("如果最后一名存活的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("死于处决，游戏继续。玩家们不会得知刚死去的是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("。在下");
    g_tipLine[707] = StringToText("一个白天，如果一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家被处决----无论该玩家是否死于处决----") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营获胜。");
    g_tipLine[708] = StringToText("如果一名") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("玩家被处决，或者没有人被处决，则") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipLine[709] = StringToText("已死亡的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("无法进行攻击，如常失去自己的能力。在这个额外的夜晚和白天，其他角");
    g_tipLine[710] = StringToText("色的能力会正常生效。");
    g_tipLine[711] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("死亡且只剩余两名存活玩家，游戏仍然会额外进行一天----") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营不会因为");
    g_tipLine[712] = StringToText("只剩两名存活玩家而获胜，而") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营也不会因为杀死了") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("而获胜。") + TextWithColor(StringToText("主谋"), Color(255, 69, 0)) + StringToText("的能力为「");
    g_tipLine[713] = StringToText("额外进行一天一夜」，此能力会覆盖游戏常规规则。");
