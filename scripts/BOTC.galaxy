    // ---- 黯月初升 25 个角色的提示文案（能力 / 简介 / 规则细节）----
    //   来源：钟楼百科各角色页；**线下游玩相关的建议已过滤**（用户 2026-09-19 要求）
    g_tipLine[400] = StringToText("【角色能力】");
    g_tipLine[401] = StringToText("在你的首个夜晚，你会得知一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家和他的角色。");
    g_tipLine[402] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("杀死了他，你也会死亡。");
    g_tipLine[403] = StringToText("【角色简介】");
    g_tipLine[404] = TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("知道自己的孙子是谁，但是如果孙子被") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("杀死，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("也会死亡。");
    g_tipLine[405] = StringToText("在首个夜晚，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("会得知自己的孙子----一名") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("玩家的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("角色信息。孙子");
    g_tipLine[406] = StringToText("不会得知自己有位") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[407] = StringToText("如果") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("杀死了孙子，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("也会死亡。如果孙子通过任何其他方式死亡----例如处决，");
    g_tipLine[408] = StringToText("或在夜晚因其他原因死亡----") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("不会因此死亡。");
    g_tipLine[409] = StringToText("【规则细节】");
    g_tipLine[410] = StringToText("在绝大多数情况下，") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("得知的角色都应该是") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("角色。因为如果") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("得知了") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("角色");
    g_tipLine[411] = StringToText("，这会带来") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + StringToText("能力之外的额外信息（有处于") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营的") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("角色，又或者在剧本条件");
    g_tipLine[412] = StringToText("不允许的情况下作为了") + TextWithColor(StringToText("祖母"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的明确提示）。");
    g_tipLine[413] = StringToText("相克规则：");
    g_tipLine[414] = StringToText("利维坦");
    g_tipLine[415] = StringToText("：如果利维坦在场，孙子死于处决，") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营获胜。");
    g_tipLine[416] = StringToText("暴乱");
    g_tipLine[417] = StringToText("：如果暴乱在场，孙子死于处决，") + TextWithColor(StringToText("邪恶"), Color(139,0,0)) + StringToText("阵营获胜。");
    g_tipRoleAt[22] = 5056;    // 祖母
    g_tipRoleN[22] = 16;
    g_tipLine[418] = StringToText("【角色能力】");
    g_tipLine[419] = StringToText("每个夜晚，你要选择一名存活的玩家：你或他之一会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到下个黄昏。");
    g_tipLine[420] = StringToText("你不会死亡。");
    g_tipLine[421] = StringToText("【角色简介】");
    g_tipLine[422] = TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("要么自己") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，要么让别人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。只要") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("是清醒状态，就不会死亡。");
    g_tipLine[423] = StringToText("每个夜晚，") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，该玩家可能会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[424] = StringToText("如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了自己，他失去自己的「不会死亡」能力，直到恢复清醒为止。");
    g_tipLine[425] = StringToText("如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("不小心选择了已死亡的玩家，说书人应提醒他重新选择。");
    g_tipLine[426] = StringToText("如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了其他玩家，由说书人来选择哪名玩家将会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。如果") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("选择了一个镇");
    g_tipLine[427] = StringToText("民，说书人通常会让该") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，但如果选择了") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("或是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，那么说书人通");
    g_tipLine[428] = StringToText("常会让") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("自己") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[429] = StringToText("在") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("清醒时，他不会死亡，即使") + TextWithColor(StringToText("水手"), Color(0, 191, 255)) + StringToText("还没在夜晚被唤醒。");
    g_tipRoleAt[23] = 7042;    // 水手
    g_tipRoleN[23] = 16;
    g_tipLine[430] = StringToText("【角色能力】");
    g_tipLine[431] = StringToText("每个夜晚，你要选择除你以外的两名存活的玩家：你会得知他们中有几人在当晚因其自");
    g_tipLine[432] = StringToText("身能力而被唤醒。");
    g_tipLine[433] = StringToText("【角色简介】");
    g_tipLine[434] = TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("能得知谁在夜晚被唤醒过。");
    g_tipLine[435] = StringToText("每个夜晚，") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("需要选择两名玩家，并得知他们是否在当晚被唤醒过。") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("必须选择存");
    g_tipLine[436] = StringToText("活的玩家，且不能选择自己。这个能力不会探查出这些玩家中谁被唤醒过，仅仅是告知");
    g_tipLine[437] = StringToText("数量。");
    g_tipLine[438] = TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("的能力只会探查到为了使用自己的能力而被唤醒的角色。该能力不会探查因任何其");
    g_tipLine[439] = StringToText("他原因被唤醒的角色----例如说书人唤醒") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("让他们得知谁是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，唤醒") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("给与他在");
    g_tipLine[440] = StringToText("首个夜晚会获得的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("信息，因另一个角色的能力而唤醒一位玩家，或是不小心唤醒了");
    g_tipLine[441] = StringToText("某个人。");
    g_tipLine[442] = StringToText("如果一名角色在之前的夜晚被唤醒，但在这个夜晚没有，就不会被") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("探查到。");
    g_tipLine[443] = TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("的玩家当晚因自己的能力被唤醒，仍然会计算在内。");
    g_tipLine[444] = StringToText("如果") + TextWithColor(StringToText("侍女"), Color(0, 191, 255)) + StringToText("不小心选择了已死亡的玩家或是自己，说书人应提醒她重新选择。（该条规则");
