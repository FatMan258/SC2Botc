    DialogControlSetVisible(g_boardImg, PlayerGroupAll(), false);
    // 人数配置（镇/外/爪/恶）：紧贴板子图**下方**，并且和夜晚大字在同一条中线上。
    //   板子图块在魔典内 y 392~648 → 这里放 628（图块下沿往回一点，紧贴着图的底边）；
    //   文字同样是左对齐的，所以 x 要自己补偏移：现在 **460**（按实机截图量的：原来 440 时整串偏左，
    //   往右推 20 才和夜晚大字的中心落在同一条竖线上）。想再微调就改这个 460。
    //   字号比原来大一档（原来 UnitWireframeVitalLarge 太小）：换成聊天行那种 ModLeftSize20Bold。
    g_boardInfo = BOTC_NewLabelC(g_grimDlg, 360, 30, 441, 522, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_boardInfo, "ModLeftSize20Bold", PlayerGroupAll());
