    g_wikiTitle = BOTC_NewLabel(g_wikiDlg, 860, 34, 292, 12, StringToText("规则百科"));
    libNtve_gf_SetDialogItemStyle(g_wikiTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_wikiTitle, false, PlayerGroupAll());
    g_wikiList = BOTC_NewList(g_wikiDlg, 876, 770, 292, 56);
    libNtve_gf_SetDialogItemStyle(g_wikiList, "ModLeftSize16Bold", PlayerGroupAll());
    for (i = 0; i < 10; i += 1) {
        g_wikiCatBtn[i] = BOTC_NewButton(g_wikiDlg, 262, 58, 16, 56 + (i * 70), BOTC_WikiName(i));
        libNtve_gf_SetDialogItemStyle(g_wikiCatBtn[i], "ModLeftSize16Bold", PlayerGroupAll());
    }
    g_wikiClose = BOTC_NewButton(g_wikiDlg, 160, 36, 1008, 848, "关闭");
    libNtve_gf_SetDialogItemStyle(g_wikiClose, "ModLeftSize16Bold", PlayerGroupAll());
    g_wikiArtBtn = BOTC_NewButton(g_wikiDlg, 200, 36, 16, 848, "拓展阅读");
    libNtve_gf_SetDialogItemStyle(g_wikiArtBtn, "ModLeftSize16Bold", PlayerGroupAll());
}

void BOTC_WikiRender (int p) {
    int i;
    int k;
    k = g_wikiSel[p];
    if (k < 0 || k > 9) {
        k = 0;
        g_wikiSel[p] = 0;
    }
    libNtve_gf_SetDialogItemText(g_wikiTitle, StringToText("规则百科 · " + BOTC_WikiName(k)), PlayerGroupSingle(p));
    DialogControlRemoveAllItems(g_wikiList, PlayerGroupSingle(p));
    for (i = 0; i < g_wikiN[k]; i += 1) {
        DialogControlAddItem(g_wikiList, PlayerGroupSingle(p), BOTC_KeyColor(g_wikiLine[g_wikiAt[k] + i]));
    }
    for (i = 0; i < 10; i += 1) {
        if (i == k) {
            libNtve_gf_SetDialogItemText(g_wikiCatBtn[i], StringToText("● " + BOTC_WikiName(i)), PlayerGroupSingle(p));
        }
        else {
            libNtve_gf_SetDialogItemText(g_wikiCatBtn[i], StringToText(BOTC_WikiName(i)), PlayerGroupSingle(p));
        }
    }
}

void BOTC_WikiOpen (int p) {
    g_wikiOpen[p] = true;
    BOTC_WikiRender(p);
    DialogSetVisible(g_wikiDlg, PlayerGroupSingle(p), true);
}

