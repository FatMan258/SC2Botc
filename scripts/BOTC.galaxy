bool        g_invitePick;         // 房主正在「点一个玩家 → 邀请他加入当前私聊」
int         g_inviteBy;           // 正在选人的房主（0 = 没有）
int[14]     g_dissolveBtn;        // 【解散私聊】按钮（私聊面板右下角，紧挨着【邀请加入】；只有房主能看到）
bool[14]    g_dissolveOn;         // 【解散私聊】当前是不是显示着（缓存）
