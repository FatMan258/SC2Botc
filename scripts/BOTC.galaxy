    g_tipLine[553] = StringToText("【角色能力】");
    g_tipLine[554] = StringToText("当一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("死于处决时，除了你和旅行者以外的所有其他玩家") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("直到明天黄昏。");
    g_tipLine[555] = StringToText("【角色简介】");
    g_tipLine[556] = StringToText("如果有") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("因为处决而死去，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("会让所有人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[557] = StringToText("如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决且死亡，所有玩家（除了") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("）会立即变得") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，并在整");
    g_tipLine[558] = StringToText("个夜晚和下一个白天都保持") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("状态。") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("外来者"), Color(0,191,255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("、甚至是") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("都会") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("，但");
    g_tipLine[559] = StringToText("是旅行者不会。如果") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("在夜晚死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("不会使人") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[560] = StringToText("如果一名已死亡的") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发----已死亡的角色不会再");
    g_tipLine[561] = StringToText("次死亡！如果一名") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("玩家被处决但没有死亡，") + TextWithColor(StringToText("吟游诗人"), Color(0, 191, 255)) + StringToText("的能力不会触发。如果一名爪");
