    }
    g_jrCloseBtn[p] = BOTC_NewButton(g_jrDlg[p], 220, 40, 170, 344, "关闭（保存）");
    DialogSetVisible(g_jrDlg[p], PlayerGroupSingle(p), false);
}

void BOTC_JrOpen (int p) {
    int t;
    int v;
    if (p < 1 || p > 13) {
        return;
    }
    v = BOTC_JrMaskLoad(p);
    for (t = 0; t < 4; t += 1) {
        g_jrWant[(p * 4) + t] = BOTC_JrBit(v, t);
    }
    g_jrOn[p] = 1;
    BOTC_JrRender(p);
    DialogSetVisible(g_jrDlg[p], PlayerGroupSingle(p), true);
}

void BOTC_JrClose (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_jrOn[p] == 1) {
        BOTC_JrSave(p);
    }
    g_jrOn[p] = 0;
    DialogSetVisible(g_jrDlg[p], PlayerGroupAll(), false);
}

void BOTC_JrToggle (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_jrOn[p] == 1) {
        BOTC_JrClose(p);
    }
    else {
        BOTC_JrOpen(p);
    }
}

void BOTC_JrTypeClick (int p, int t) {
    if (g_jrOn[p] != 1 || t < 0 || t > 3) {
        return;
    }
    if (g_jrWant[(p * 4) + t] == 1) {
        g_jrWant[(p * 4) + t] = 0;
    }
    else {
        g_jrWant[(p * 4) + t] = 1;
    }
    BOTC_JrRender(p);
}

// 打开：先把存过的内容填回输入框
