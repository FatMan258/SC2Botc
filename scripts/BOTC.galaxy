}

// 【工程师（78）】（用户 2026-11-09）：改为工程师本人选择。
//   恶魔：工程师选 1 个恶魔角色后立刻结算 —— 不在场则场上的恶魔全部变成它，已在场则无事发生。
//   爪牙：工程师选 2 个不同爪牙角色并确定后，只有两个都不在场才由说书人指派谁变哪个；
//   两个都在场无事发生；只有一个在场时直接把另一名爪牙换成不在场的那个角色。
//   提交后才消耗「失去能力」token，工程师本人不会收到是否改变成功的提示。
void BOTC_EngReset () {
    g_engStage = 0;
    g_engMode = 0;
    g_engR1 = -1;
    g_engR2 = -1;
    g_engSeatA = 0;
    g_engSeatB = 0;
    g_engSeat = 0;
}

// 工程师本人（物理玩家号）。面板、身份网格都发给这个人，不再发给说书人。
int BOTC_EngPlayer () {
    if (g_engSeat < 1 || g_engSeat > 13) {
        return 0;
    }
    if (g_who[g_engSeat] < 1 || g_who[g_engSeat] > 13) {
        return 0;
    }
    return g_who[g_engSeat];
}

void BOTC_EngOpen (int seat) {
    int pl;
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_EngReset();
    g_engSeat = seat;
    g_engStage = 0;
    pl = BOTC_EngPlayer();
    if (pl < 1 || pl > 13) {
        BOTC_EngReset();
        return;
    }
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText("【工程师】选择要改变的邪恶角色类型"), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText("恶魔（1 个）"), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText("爪牙（2 个）"), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engClose, StringToText("取消（不使用能力）"), PlayerGroupSingle(pl));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(pl), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(pl), true);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(pl), true);
}

void BOTC_EngGrid (int p, int team) {
    int q;
    string title;
    if (p < 1 || p > 13) {
        return;
    }
    DialogSetVisible(g_engDlg, PlayerGroupSingle(p), false);
    g_pickMode[p] = 19;
    g_pickWho[p] = g_engSeat;
    g_pickTeam = team;
    g_pickAlign = -1;
    BOTC_PickFilter(p, false);
    // 第二个爪牙不能与第一个重复：把第一个角色所在的格子藏起来。
    if (g_engMode == 2 && g_engR1 >= 0) {
        for (q = 0; q < g_gridN; q += 1) {
            if (g_gridSlot[q] == g_engR1) {
                DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(p), false);
                DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(p), false);
                DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(p), false);
            }
        }
    }
    if (g_engMode == 3) {
        title = "【工程师】选择 1 个本剧本的恶魔角色";
    }
    else {
        if (g_engStage == 1) {
            title = "【工程师】选择第 1 个爪牙角色";
        }
        else {
            title = "【工程师】选择第 2 个爪牙角色（不能重复）";
        }
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText(title), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（不使用能力）"), PlayerGroupSingle(p));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), true);
}

void BOTC_EngPickResult (int role) {
    int pl;
    pl = BOTC_EngPlayer();
    if (role < 0 || role > 163) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 3) {
        g_engR1 = role;
        g_engR2 = -1;
        g_engStage = 3;
        BOTC_EngDemonNow();
        return;
    }
    if (g_engStage == 1) {
        g_engR1 = role;
        g_engStage = 2;
        BOTC_EngGrid(pl, 2);
        return;
    }
    if (role == g_engR1) {
        if (pl >= 1 && pl <= 13) {
            BOTC_Notice(pl, "两个爪牙角色不能重复，请重新选择。");
        }
        BOTC_EngGrid(pl, 2);
        return;
    }
    g_engR2 = role;
    g_engStage = 3;
    BOTC_EngConfirmShow();
}

// 【恶魔分支】选中的那一刻立刻结算：不在场 → 场上所有存活恶魔换成它；已在场 → 无事发生。
void BOTC_EngDemonNow () {
    int i;
    int n;
    int pl;
    bool present;
    pl = BOTC_EngPlayer();
    if (g_engSeat < 2 || g_engSeat > 13 || g_engR1 < 0) {
        BOTC_EngCancel();
        return;
    }
    // 提交即消耗「失去能力」token。
    g_tokOn[(((g_teller * 14) + g_engSeat) * 256) + 99] = true;
    BOTC_GrimRender(g_teller);
    if (pl >= 1 && pl <= 13) {
        DialogSetVisible(g_engDlg, PlayerGroupSingle(pl), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(pl), false);
    }
    if (!BOTC_SkillWorks(g_engSeat)) {
        BOTC_PmStore(g_teller, "【工程师】" + BOTC_NameStr(g_engSeat) + " 中毒/酒鬼/提线木偶：能力失效，未改变任何身份。");
        BOTC_EngReset();
        return;
    }
    present = false;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 3) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == g_engR1) {
            present = true;
        }
    }
    if (present) {
        BOTC_PmStore(g_teller, "【工程师】选择恶魔「" + g_roleName[g_engR1] + "」：该恶魔已在场，无事发生。");
        BOTC_EngReset();
        return;
    }
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 3) {
            continue;
        }
        BOTC_EngSetRole(i, g_engR1);
        n += 1;
    }
    BOTC_PmStore(g_teller, "【工程师】选择恶魔「" + g_roleName[g_engR1] + "」：不在场，" + IntToString(n) + " 名存活恶魔全部变成「" + g_roleName[g_engR1] + "」。");
    BOTC_EngReset();
}

void BOTC_EngConfirmShow () {
    string title;
    int pl;
    pl = BOTC_EngPlayer();
    if (g_engSeat < 2 || g_engSeat > 13 || pl < 1 || pl > 13) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode == 3) {
        title = "【工程师】已选恶魔「" + g_roleName[g_engR1] + "」。点【确定】提交；点【取消】不使用能力。";
    }
    else {
        title = "【工程师】已选爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」。点【确定】提交；点【取消】不使用能力。";
    }
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText(title), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText("确定"), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText("取消"), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(pl));
    libNtve_gf_SetDialogItemText(g_engClose, StringToText("取消（不使用能力）"), PlayerGroupSingle(pl));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(pl), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(pl), true);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(pl), true);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(pl), true);
}

// 只改真实身份；目标已经是这个角色时保持不动。
void BOTC_EngSetRole (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (BOTC_SeatTrueRole(q) == role) {
        return;
    }
    BOTC_SetSeatRole(g_teller, q, role);
    BOTC_ChangeRoleMsg(q, role);
}

void BOTC_EngAssign (int swap) {
    int qa;
    int qb;
    int ra;
    int rb;
    qa = g_engSeatA;
    qb = g_engSeatB;
    if (qa < 2 || qb < 2) {
        BOTC_EngCancel();
        return;
    }
    if (swap != 0) {
        ra = g_engR2;
        rb = g_engR1;
    }
    else {
        ra = g_engR1;
        rb = g_engR2;
    }
    BOTC_EngSetRole(qa, ra);
    BOTC_EngSetRole(qb, rb);
    BOTC_PmStore(g_teller, "【工程师】" + BOTC_NameStr(qa) + " 变成「" + g_roleName[ra] + "」，" + BOTC_NameStr(qb) + " 变成「" + g_roleName[rb] + "」。");
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    BOTC_EngReset();
}

// 场上只有一名存活爪牙、且两个选择的爪牙都不在场时：由说书人决定他变成哪一个。
void BOTC_EngAssignOne (int which) {
    int q;
    int r;
    q = g_engSeatA;
    if (q < 2 || q > 13) {
        BOTC_EngCancel();
        return;
    }
    if (which != 0) {
        r = g_engR2;
    }
    else {
        r = g_engR1;
    }
    if (r < 0) {
        BOTC_EngCancel();
        return;
    }
    BOTC_EngSetRole(q, r);
    BOTC_PmStore(g_teller, "【工程师】" + BOTC_NameStr(q) + " 变成「" + g_roleName[r] + "」。");
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    BOTC_EngReset();
}

void BOTC_EngSubmit () {
    int q;
    int i;
    int n;
    int a;
    int b;
    int extra;
    int pl;
    int tgt;
    int ra;
    int rb;
    bool pa;
    bool pb;
    q = g_engSeat;
    pl = BOTC_EngPlayer();
    if (q < 2 || q > 13) {
        BOTC_EngCancel();
        return;
    }
    if (g_engMode != 2 || g_engR1 < 0 || g_engR2 < 0) {
        BOTC_EngCancel();
        return;
    }
    // 提交后才消耗工程师的「失去能力」token。
    g_tokOn[(((g_teller * 14) + q) * 256) + 99] = true;
    BOTC_GrimRender(g_teller);
    if (pl >= 1 && pl <= 13) {
        DialogSetVisible(g_engDlg, PlayerGroupSingle(pl), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(pl), false);
    }
    if (!BOTC_SkillWorks(q)) {
        BOTC_PmStore(g_teller, "【工程师】" + BOTC_NameStr(q) + " 中毒/酒鬼/提线木偶：能力失效，未改变任何身份。");
        BOTC_EngReset();
        return;
    }
    // 收集存活爪牙。
    a = 0;
    b = 0;
    extra = 0;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) {
            continue;
        }
        n += 1;
        if (a == 0) {
            a = i;
        }
        else {
            if (b == 0) {
                b = i;
            }
            else {
                extra += 1;
            }
        }
    }
    if (a == 0) {
        BOTC_PmStore(g_teller, "【工程师】提交爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」：场上没有存活爪牙，未改变任何身份。");
        BOTC_EngReset();
        return;
    }
    // 两个选择的爪牙角色是否已经在场。
    pa = false;
    pb = false;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i)) {
            continue;
        }
        if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) {
            continue;
        }
        if (BOTC_SeatTrueRole(i) == g_engR1) {
            pa = true;
        }
        if (BOTC_SeatTrueRole(i) == g_engR2) {
            pb = true;
        }
    }
    if (pa && pb) {
        BOTC_PmStore(g_teller, "【工程师】提交爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」：两个角色均已在场，无事发生。");
        BOTC_EngReset();
        return;
    }
    if (pa || pb) {
        // 只有一个在场：在场的那名爪牙不变，把另一名爪牙换成不在场的那个角色，无需说书人选择。
        if (pa) {
            ra = g_engR1;
            rb = g_engR2;
        }
        else {
            ra = g_engR2;
            rb = g_engR1;
        }
        tgt = 0;
        for (i = 2; i <= 13; i += 1) {
            if (BOTC_SeatDead(i)) {
                continue;
            }
            if (BOTC_RoleTeam(BOTC_SeatTrueRole(i)) != 2) {
                continue;
            }
            if (BOTC_SeatTrueRole(i) == ra) {
                continue;
            }
            tgt = i;
            break;
        }
        if (tgt == 0) {
            BOTC_PmStore(g_teller, "【工程师】提交爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」：只有一名爪牙且已经在场，无事发生。");
            BOTC_EngReset();
            return;
        }
        BOTC_EngSetRole(tgt, rb);
        BOTC_PmStore(g_teller, "【工程师】提交爪牙「" + g_roleName[g_engR1] + "」、「" + g_roleName[g_engR2] + "」：" + BOTC_NameStr(tgt) + " 变成「" + g_roleName[rb] + "」。");
        BOTC_EngReset();
        return;
    }
    if (b == 0) {
        // 场上只有一名存活爪牙，且两个选择都不在场：由说书人决定他变成哪一个。
        g_engSeatA = a;
        g_engSeatB = 0;
        g_engStage = 5;
        libNtve_gf_SetDialogItemText(g_engTitle, StringToText("【工程师】场上只有一名爪牙，选择他变成「" + g_roleName[g_engR1] + "」还是「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_engBtn1, StringToText(IntToString(g_lab[a]) + "号变「" + g_roleName[g_engR1] + "」"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_engBtn2, StringToText(IntToString(g_lab[a]) + "号变「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_engX, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    if (extra > 0) {
        BOTC_PmStore(g_teller, "【工程师】场上有 " + IntToString(n) + " 名存活爪牙，只调整前两名。");
    }
    g_engSeatA = a;
    g_engSeatB = b;
    g_engStage = 4;
    libNtve_gf_SetDialogItemText(g_engTitle, StringToText("【工程师】选择谁变成「" + g_roleName[g_engR1] + "」，另一位变成「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn1, StringToText(IntToString(g_lab[a]) + "号变「" + g_roleName[g_engR1] + "」/ " + IntToString(g_lab[b]) + "号变「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn2, StringToText(IntToString(g_lab[b]) + "号变「" + g_roleName[g_engR1] + "」/ " + IntToString(g_lab[a]) + "号变「" + g_roleName[g_engR2] + "」"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_engBtn3, StringToText(""), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_engBtn1, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn2, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_engBtn3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engClose, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_engX, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_EngCancel () {
    int pl;
    DialogSetVisible(g_engDlg, PlayerGroupSingle(g_teller), false);
    pl = BOTC_EngPlayer();
    if (pl >= 1 && pl <= 13 && pl != g_teller) {
        DialogSetVisible(g_engDlg, PlayerGroupSingle(pl), false);
    }
    // 只有还没提交时取消才算「这次不使用能力」，不写 token 99。
    BOTC_EngReset();
}

void BOTC_FarmerOpen (int seat, bool viaLevi) {
    if (seat < 2 || seat > 13) {
        return;
    }
    if (!viaLevi) {
        g_farmPending[seat] = false;
    }
    // 【中毒 / 醉酒适配】（用户 2026-09-26）：农夫死的时候中毒/酒鬼 → 能力失效，不挑人
    if (BOTC_SeatImpaired(seat)) {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(seat) + " 死的时候中毒/酒鬼 → 能力失效，没人变成农夫。");
        return;
    }
    g_farmSeat = seat;
    g_farmViaLevi = viaLevi;
    if (viaLevi) {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫×利维坦】" + BOTC_NameStr(seat) + " 的能力被触发：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_farmTitle, StringToText("【农夫】" + BOTC_NameStr(seat) + " 夜里死了：填一个存活善良玩家的座位号（1~12），他会变成农夫"), PlayerGroupSingle(g_teller));
    }
    libNtve_gf_SetDialogItemText(g_farmEdit, StringToText(""), PlayerGroupSingle(g_teller));
    // 【换座位出来的说书人也要有确认键】（用户 2026-10-18）：同上
    DialogControlSetVisible(g_farmOk, PlayerGroupAll(), false);
    DialogControlSetVisible(g_farmOk, PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_FarmerSend () {
    int n;
    int t;
    string s;
    if (g_farmSeat < 2 || g_farmSeat > 13) {
        return;
    }
    s = libNtve_gf_DialogItemEditValue(g_farmEdit, g_teller);
    n = BOTC_TextNum(s);
    if (n < 1 || n > 12) {
        BOTC_Notice(g_teller, "填 1~12 的座位号。");
        return;
    }
    t = n + 1;
    if (!g_seatOn[t]) {
        BOTC_Notice(g_teller, "这个座位没有玩家。");
        return;
    }
    if (!BOTC_TargetIsLiving(t)) {
        BOTC_Notice(g_teller, "要挑一个还活着的玩家。");
        return;
    }
    if (BOTC_SeatAlign(t) != 0) {
        BOTC_Notice(g_teller, "要挑一个善良阵营的玩家。");
        return;
    }
    BOTC_SetSeatRole(g_teller, t, 80);
    BOTC_SetSeatRole(g_who[t], t, 80);
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[t]);
    BOTC_ChangeRoleMsg(t, 80);
    if (g_farmViaLevi) {
        BOTC_PmStore(g_teller, "【农夫×利维坦】相克触发 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    else {
        BOTC_PmStore(g_teller, "【农夫】" + BOTC_NameStr(g_farmSeat) + " 夜里死亡 → " + BOTC_NameStr(t) + " 变成了农夫。");
    }
    DialogSetVisible(g_farmDlg, PlayerGroupSingle(g_teller), false);
    g_farmSeat = 0;
    g_farmViaLevi = false;
}

void BOTC_ManInfoOk () {
    string s2;
    string s;
    int n;
    int seat;
    int kind;
    int role;
    int tru;                      // 数学家核对用的正确答案
    int i;
    int inNum;                    // 假疯子刀人：正在读一个座位号
    int cnt;                      // 假疯子刀人：已经收进多少个座位
    string sep;                   // 假疯子刀人：多个目标之间的分隔符
    bool[14] seen;                // 假疯子刀人：目标去重

    if (g_miRole == 816) {
        BOTC_ManualDeathConfirm();
        return;
    }

    // 【瘟疫医生相克】填写要受影响的玩家座位号（男爵 / 炸弹人 / 镜像双子 / 提线木偶 / 爪牙获得）。
    if (g_miRole == 819) {
        BOTC_PlagueDoctorSeatApply();
        return;
    }

    // 【半仙（158）】不占用技能三目标面板，避免与典狱长等多选角色互相覆盖。
    if (g_miRole == 815) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (!g_halfPick || seat != g_halfBy) {
            BOTC_Notice(g_teller, "这次半仙改选已经失效。");
            DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "请填写一名邪恶玩家的座位号（1~12）。");
            return;
        }
        BOTC_HalfImmortalApply(seat, g_halfSlot, n + 1);
        return;
    }

    // 【典狱长（163）】上一批无人死于处决：说书人填写一名候选座位，确认后立即结算死亡。
    if (g_miRole == 814) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "请填写一名候选玩家的座位号（1~12）。");
            return;
        }
        if (g_wardenAskBy == 0 || seat != g_wardenAskBy) {
            BOTC_Notice(g_teller, "这次典狱长判定已经失效。");
            DialogSetVisible(g_miDlg, PlayerGroupAll(), false);
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_WardenKillChoice(n + 1);
        return;
    }

    // 【科学怪人状态面板】只用于查看，点关闭即可，不发送任何信息。
    if (g_miRole == 810) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_miText = "";
        libNtve_gf_SetDialogItemText(g_miOk, StringToText("确定（发给他）"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_miCancel, StringToText("取消"), PlayerGroupSingle(g_teller));
        return;
    }

    // 【牙噶巴卜（133）】首夜秘密短语：只私聊发给本人；之后每个白天自动统计他说出短语的次数，
    //   夜晚他的夜序位次再把次数告诉说书人，杀谁仍由说书人手动决定。
    if (g_miRole == 809) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先输入一段秘密短语再点【确定】。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        // 记录短语：之后每个白天在公聊里统计他说出的次数
        g_yaggaWord = s;
        g_yaggaSay = 0;
        g_yaggaDay = g_dayNum;
        BOTC_PmStore(g_teller, "【牙噶巴卜】秘密短语已发给 " + BOTC_NameStr(seat) + "：" + s + "。之后每个白天会自动统计他在公聊说出短语的次数，夜晚夜序位次提醒你。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }

    // 【发送特定信息 · 自定义文本】（用户 2026-10-21）：自动在输入内容前加「你得知」，结尾补句号。
    if (g_miRole == 808) {
        seat = g_miSeat;
        if (seat < 2 || seat > 13) {
            return;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "自定义文本是空的：先输入内容再发送。");
            return;
        }
        s = "你得知" + s + "。";
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], BOTC_InfoText(s));
        BOTC_PmStore(g_teller, "【说书人工具】自定义文本已发给 " + BOTC_NameStr(seat) + "：" + BOTC_InfoText(s));
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        g_specTo = 0;
        return;
    }

    // 【事务官（142）】：一个框 = 一名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 14) {
        seat = g_miSeat;
        g_evilA = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        if (g_evilA < 2) {
            BOTC_Notice(g_teller, "请填写一个玩家座位号（1~12）。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 167] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【事务官】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + "。");
        return;
    }
    // 【骑士（122）】：两个框 = 两名玩家 → 私聊告知，并打「得知」。
    if (g_miRole == 41 && g_miKind == 13) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(g_evilA) + "," + BOTC_NameStr(g_evilB));
        g_tokOn[(((g_teller * 14) + g_evilA) * 256) + 141] = true;
        g_tokOn[(((g_teller * 14) + g_evilB) * 256) + 141] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【骑士】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "。");
        return;
    }
    // 【店小二（115）】（用户 2026-11-06）：清醒时先问要不要把当前熟客 / 醉酒的两名玩家告诉他
    if (g_miRole == 41 && g_miKind == 22) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        for (i = 2; i <= 13; i += 1) {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 135]) {
                g_evilA = i;
            }
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 136]) {
                g_evilB = i;
            }
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_dxeMode = 0;
        if (g_evilA < 2 || g_evilB < 2 || g_evilA == g_evilB) {
            BOTC_DxeManualOpen(seat);
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知[" + IntToString(g_lab[g_evilA] + g_nameNumShift) + "],[" + IntToString(g_lab[g_evilB] + g_nameNumShift) + "]。");
        BOTC_PmStore(g_teller, "【店小二】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "（当前熟客 / 醉酒）。");
        return;
    }
    // 【风雅集（板子 10）· 店小二（115）】：两个框 = 他要得知的两名玩家 → 私聊告诉他
    //   配板阶段已经放好熟客 / 醉酒（用户 2026-11-06）；只有说书人点了【取消】才走这里，
    //   填完再让说书人从这两人里选一名成为新的醉酒（另一名成为新熟客）。
    if (g_miRole == 41 && g_miKind == 12) {
        seat = g_miSeat;
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        if (g_evilA < 2 || g_evilB < 2) {
            BOTC_Notice(g_teller, "两个框都要填座位号（1~12）。");
            return;
        }
        if (g_evilA == g_evilB) {
            BOTC_Notice(g_teller, "两个框不能填同一个人。");
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_PmInfo(g_who[seat], "【信息】你得知[" + IntToString(g_lab[g_evilA] + g_nameNumShift) + "],[" + IntToString(g_lab[g_evilB] + g_nameNumShift) + "]。");
        BOTC_PmStore(g_teller, "【店小二】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(g_evilA) + " 和 " + BOTC_NameStr(g_evilB) + "。");
        if (g_dxeMode == 1) {
            BOTC_DrunkPickOpen(3, seat, g_evilA, g_evilB);   // 这两人里选一名成为新醉酒，另一名成为新熟客
        }
        g_dxeMode = 0;
        return;
    }

    // 【风雅集（板子 10）· 郎中（116）】（用户 2026-10-16）：框里那个词原样私聊发给他
    if (g_miRole == 806) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一个词再点【确定】。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s);
        BOTC_PmStore(g_teller, "【郎中】已告诉 " + BOTC_NameStr(seat) + "：" + s);
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【军团 · 假军团（疯子）】（用户 2026-09-30）：说书人填的两个座位号 = 这两个军团不给疯子看
    //   两个框都空 / 点取消 = 不屏蔽（疯子看到所有队友）
    if (g_miRole == 41 && g_miKind == 9) {
        g_evilA = 0;
        g_evilB = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LegionLunaticApply(g_evilA, g_evilB);
        BOTC_NotifyDemonsLunatic();
        return;
    }
    if (g_miRole == 85) {
        seat = g_miSeat;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s) <= 0) {
            BOTC_Notice(g_teller, "先打一段短语再点【确定】。");
            return;
        }
        s2 = "【信息】你得知" + s;
        BOTC_PmInfo(g_who[seat], s2);
        // 【灵言师 · 关键词监听】（用户 2026-11-11 改版）：只记下关键词；收回夜间唤醒后
        //   才开始监听公聊，说出关键词的善良玩家要等到下一个夜晚灵言师夜序才转邪恶。
        g_mezeWord = s;
        g_mezeSeat = seat;
        g_mezeSay = 0;
        g_mezeSayNight = 0;
        g_mezeDone = false;
        BOTC_PmStore(g_teller, "【灵言师】关键词已发给 " + BOTC_NameStr(seat) + "：「" + s + "」（收回夜间唤醒后开始监听公聊）");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【将军(96)】（用户 2026-10-03）：把框里的字（善良 / 邪恶 / 均势）原样私聊发给他
    if (g_miRole == 96) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        if (StringLength(s2) <= 0) {
            s2 = "（说书人没填内容）";
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s2);
        BOTC_PmStore(g_teller, "【将军】已告诉 " + BOTC_NameStr(seat) + "：" + s2 + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【何方教众 · 国王(104) / 村夫(105) / 解谜大师(109)】（用户 2026-10-10）：框里的字原样发给他
    if (g_miRole == 109) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        // 【解谜大师 · 错误信息】（用户 2026-11-07）：说书人填什么就原样发什么，
        //   由 BOTC_PmInfo 统一包成「你得知「…」」，不再附加「谁是恶魔」字样。
        if (StringLength(s2) <= 0) {
            s2 = "（说书人没填内容）";
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + s2);
        BOTC_PmStore(g_teller, "【解谜大师】已告诉 " + BOTC_NameStr(seat) + "（错误信息）：" + s2 + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【发送特定信息】（用户 2026-10-10）：假疯子 / 疯子刀人（文案跟以前智能说书那套一字不差）
    if (g_miRole == 801) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的编号（那个被说成「疯子」的人）。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "是疯子。");
        BOTC_PmStore(g_teller, "【假疯子】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是疯子。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    if (g_miRole == 802) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n >= 1 && n <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1));
            BOTC_PmStore(g_teller, "【疯子刀人】已发给 " + BOTC_NameStr(seat) + "：他今晚「杀」的是 " + BOTC_NameStr(n + 1) + "。");
        }
        else {
            BOTC_PmInfo(g_who[seat], "【信息】你得知没有目标。");
            BOTC_PmStore(g_teller, "【疯子刀人】已发给 " + BOTC_NameStr(seat) + "：疯子今晚没有选择目标。");
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    // 【发送特定信息 · 国王】（用户 2026-10-10）：填一个编号 → 告诉他「谁是国王」
    if (g_miRole == 803) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的编号（谁是国王）。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "是国王。");
        BOTC_PmStore(g_teller, "【国王】已发给 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是国王。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        g_specMode = 0;
        return;
    }
    // 【唱诗男孩（108）】：只发送得知的座位号，不附加阵营结论
    if (g_miRole == 804) {
        seat = g_miSeat;
        s2 = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s2);
        if (n < 1 || n > 12) {
            BOTC_Notice(g_teller, "先填一个 1~12 的座位号。");
            return;
        }
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "。");
        BOTC_PmStore(g_teller, "【唱诗男孩】已告诉 " + BOTC_NameStr(seat) + "：你得知" + BOTC_NameStr(n + 1) + "。");
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole == 41) {
        seat = g_miSeat;
        kind = g_miKind;
        g_evilA = 0;
        g_evilB = 0;
        g_evilC = 0;
        g_evilD = 0;
        s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilA = n + 1;
        }
        else {
            if (StringLength(s) > 0) {
                BOTC_PmStore(g_teller, "【调试】第一个框读到：「" + s + "」");
            }
        }
        s = libNtve_gf_DialogItemEditValue(g_miEdit2, g_teller);
        n = BOTC_TextNum(s);
        if (n >= 1 && n <= 12) {
            g_evilB = n + 1;
        }
        else {
            if (StringLength(s) > 0) {
                BOTC_PmStore(g_teller, "【调试】第二个框读到：「" + s + "」");
            }
        }
        // 疯子假爪牙按剧本上限读第 3、4 个框；假军团固定读满四个；其它格式仍只用前两个框。
        if (kind == 0 || kind == 19) {
            i = 4;
            if (kind == 0) {
                i = BOTC_LunaticMinionMax();
            }
            if (i >= 3) {
                s = libNtve_gf_DialogItemEditValue(g_miEdit3, g_teller);
                n = BOTC_TextNum(s);
                if (n >= 1 && n <= 12) {
                    g_evilC = n + 1;
                }
            }
            if (i >= 4) {
                s = libNtve_gf_DialogItemEditValue(g_miEdit4, g_teller);
                n = BOTC_TextNum(s);
                if (n >= 1 && n <= 12) {
                    g_evilD = n + 1;
                }
            }
        }
        // 【寡妇清醒下毒 · 在场告知】（用户 2026-11-02）：说书人填的座位必须是一名善良玩家。
        if (kind == 17) {
            if (g_evilA < 2) {
                return;
            }
            if (BOTC_SeatAlign(g_evilA) != 0) {
                BOTC_Notice(g_teller, "请选择一名善良玩家。");
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知寡妇在场。";
            BOTC_PmInfo(g_who[g_evilA], s2);
            BOTC_PmStore(g_teller, "【寡妇】已告诉 " + BOTC_NameStr(g_evilA) + "：「你得知寡妇在场。」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【疯子 × 国王】（用户 2026-11-02）：和书生一致，说书人点【确认】= 告诉疯子「国王在场」。
        if (kind == 18) {
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知国王在场。";
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【国王】已告诉疯子 " + BOTC_NameStr(seat) + "：「你得知国王在场。」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【疯子 · 提线木偶】（用户 2026-11-01）：爪牙信息之后，说书人可选再告诉疯子一名提线木偶。
        if (kind == 15) {
            if (g_evilA < 2) {
                return;
            }
            // 【不能和已发的爪牙同一个座位】（用户 2026-11-06）：重复时提醒并留在弹窗里重新填。
            for (i = 0; i < 4; i += 1) {
                if (g_lunMin[i] >= 2 && g_lunMin[i] == g_evilA) {
                    BOTC_Notice(g_teller, "该座位已经是刚发出的爪牙，不能再作为提线木偶，请重新填写。");
                    return;
                }
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + " 是提线木偶。";
            // 【提线木偶行动轮次】：这条此时单独发送，不再和爪牙信息合批。
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【疯子·假提线】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【疯子 · 假疯子】（用户 2026-11-10）：告诉疯子「某人是疯子」，用来维持他以为自己是恶魔的认知。
        if (kind == 23) {
            if (g_evilA < 2) {
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + " 是疯子。";
            // 【疯子信息合批】（用户 2026-11-10）：这是整条链的最后一条，攒完立刻一起发。
            BOTC_LunInfoAdd(seat, s2);
            BOTC_PmStore(g_teller, "【疯子·假疯子】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            g_lunFake = g_evilA;
            g_lunFakeTo = seat;
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            BOTC_LunInfoFlush();
            return;
        }
        // 【疯子 · 假疯子刀人】（用户 2026-11-10）：每晚可告诉疯子「（那名假）疯子杀了谁」。
        if (kind == 24) {
            // 【多目标】（用户 2026-11-11）：珀「攻击三次」、饕餮「可选任意数量」这类恶魔一次杀多人，
            //   一个框里填多个座位号（逗号 / 空格 / 顿号分隔都认），按填写顺序去重后合成一行，
            //   与真疯子被唤醒时脚本发给恶魔的那条格式保持一致。
            s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
            for (i = 1; i <= 13; i += 1) {
                seen[i] = false;
            }
            // 饕餮（154）那条真信息用半角逗号，其他恶魔（含珀）用顿号：假信息跟着他以为的身份走。
            sep = "、";
            if (BOTC_LunFakeBelievedRole(seat) == 154) {
                sep = ",";
            }
            s2 = "";
            n = 0;
            inNum = 0;
            cnt = 0;
            for (i = 1; i <= StringLength(s) + 1; i += 1) {
                if (i <= StringLength(s) && BOTC_IsDigitChar(StringSub(s, i, i))) {
                    n = (n * 10) + StringToInt(StringSub(s, i, i));
                    inNum = 1;
                }
                else if (inNum != 0) {
                    if (n >= 1 && n <= 12 && !seen[n + 1]) {
                        seen[n + 1] = true;
                        if (cnt > 0) {
                            s2 = s2 + sep;
                        }
                        s2 = s2 + BOTC_NameStr(n + 1);
                        cnt = cnt + 1;
                    }
                    n = 0;
                    inNum = 0;
                }
            }
            if (cnt <= 0) {
                BOTC_Notice(g_teller, "先填 1~12 的座位号，多个用英文逗号隔开。");
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            // 【疯子·假疯子刀人】（用户 2026-11-10）：格式必须和真恶魔收到的一字不差
            //   （真恶魔收到的是「【信息】疯子选择了Y。」，见 BOTC_LunaticPickNotify），
            //   否则疯子一眼就能看出自己不是恶魔。
            s2 = "【信息】疯子选择了" + s2 + "。";
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【疯子·假疯子】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【疯子 · 奥赫假刀人】（用户 2026-11-10）：他以为自己是奥赫，这里填的是角色名而不是座位。
        if (kind == 25) {
            s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
            i = BOTC_LunFakeRoleByName(s);
            if (i < 0) {
                BOTC_Notice(g_teller, "先填一个正确的角色名。");
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】疯子选择了" + g_roleName[i] + "。";
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【疯子·奥赫】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【书生 × 疯子】（用户 2026-11-01）：说书人点【确认】= 也告诉疯子「书生在场」。
        if (kind == 16) {
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知书生在场。";
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【书生】已告诉疯子 " + BOTC_NameStr(seat) + "：「你得知书生在场。」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【国王 · 剧本里但不在场】（用户 2026-11-04）：确认 = 给所有恶魔发假信息「某玩家是国王」。
        if (kind == 21) {
            if (g_evilA < 2) {
                BOTC_Notice(g_teller, "先填一个 1~12 的座位号。");
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i] || BOTC_SeatDead(i) || !BOTC_IsDemonSeat(i)) {
                    continue;
                }
                BOTC_PmInfo(g_who[i], "【信息】你得知" + BOTC_NameStr(g_evilA) + " 是国王。");
            }
            BOTC_PmStore(g_teller, "【国王·假信息】已告诉所有恶魔：「" + BOTC_NameStr(g_evilA) + " 是国王。」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            return;
        }
        // 【疯子 × 军团】说书人手动填写这名疯子认为的善良玩家名单。
        if (kind == 19) {
            s2 = "";
            if (g_evilA >= 2) { s2 = BOTC_NameStr(g_evilA); }
            if (g_evilB >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilB);
            }
            if (g_evilC >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilC);
            }
            if (g_evilD >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilD);
            }
            if (StringLength(s2) <= 0) {
                BOTC_Notice(g_teller, "至少填写一名善良玩家的座位号。");
                return;
            }
            DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
            s2 = "【信息】你得知所有善良玩家：" + s2 + "。";
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【军团】已手动发给疯子 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            g_miSeat = 0;
            g_miRole = -1;
            g_miKind = 0;
            g_lgPend = false;
            return;
        }
        if (g_evilA < 2 && g_evilB < 2 && g_evilC < 2 && g_evilD < 2) {
            return;
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        s2 = "";
        if (kind == 2) {
            // 贤者（59）：两个玩家，其中一个是杀死他的那只恶魔（用户 2026-09-21）
            if (g_evilA >= 2 && g_evilB >= 2) {
                s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + "," + BOTC_NameStr(g_evilB) + "。";
            }
            else {
                if (g_evilA >= 2) {
                    s2 = "【信息】你得知" + BOTC_NameStr(g_evilA) + "。";
                }
                else {
                    s2 = "【信息】你得知" + BOTC_NameStr(g_evilB) + "。";
                }
            }
            BOTC_PmInfo(g_who[seat], s2);
            BOTC_PmStore(g_teller, "【贤者】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
            // 【数学家】核对（用户 2026-09-21）：说书人填的这两个座位里**真身**都没有恶魔 → 记一格「未正常生效」
            //   （按说书人填的座位判，不看 token）
            if (BOTC_RoleEffInPlay(50) && g_evilA >= 2 && g_evilB >= 2) {
                if (BOTC_RoleTeam(BOTC_SeatTrueRole(g_evilA)) != 3 && BOTC_RoleTeam(BOTC_SeatTrueRole(g_evilB)) != 3) {
                    BOTC_MalfNote(seat, "贤者指的两个人都不是恶魔（按说书人填的座位判）");
                }
            }
            g_miSeat = 0;
            g_miRole = -1;
            return;
        }
        if (kind == 0) {
            s2 = "";
            if (g_evilA >= 2) { s2 = BOTC_NameStr(g_evilA); }
            if (g_evilB >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilB);
            }
            if (g_evilC >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilC);
            }
            if (g_evilD >= 2) {
                if (s2 != "") { s2 = s2 + ","; }
                s2 = s2 + BOTC_NameStr(g_evilD);
            }
            s2 = "【信息】你得知" + s2 + " 是爪牙。";
        }
        else {
            s2 = "【信息】你得知";
            if (g_evilA >= 2) {
                s2 = s2 + BOTC_NameStr(g_evilA) + " 是恶魔。";
            }
            if (g_evilB >= 2) {
                s2 = s2 + "爪牙：" + BOTC_NameStr(g_evilB) + "。";
            }
        }
        if (kind == 0) {
            // 【疯子信息合批】（用户 2026-11-10）：先攒着，等提线木偶 / 假疯子都问完再一起发。
            BOTC_LunInfoAdd(seat, s2);
        }
        else {
            BOTC_PmInfo(g_who[seat], s2);
        }
        BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(seat) + "：「" + s2 + "」");
        // 【提线木偶不能和已发的爪牙重座】（用户 2026-11-06）：先把这次发出去的爪牙座位记下来，
        //   紧接着追问提线木偶时用它拦重复。
        if (kind == 0) {
            g_lunMin[0] = g_evilA;
            g_lunMin[1] = g_evilB;
            g_lunMin[2] = g_evilC;
            g_lunMin[3] = g_evilD;
        }
        g_miSeat = 0;
        g_miRole = -1;
        // 【疯子 · 假疯子】：假爪牙信息后先追问假疯子；假提线木偶改成等提线木偶行动轮次再问。
        if (kind == 0) {
            g_miKind = 0;
            if (!BOTC_LunaticFakeAsk(seat)) {
                BOTC_LunInfoFlush();
            }
        }
        return;
    }
    if (g_miRole == 40) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        if (StringLength(g_miText) > 0) {
            BOTC_PmInfo(g_who[g_miSeat], BOTC_InfoText(g_miText));
            BOTC_PmStore(g_teller, "【邪恶信息】已发给 " + BOTC_NameStr(g_miSeat) + "：「" + BOTC_InfoText(g_miText) + "」");
        }
        g_miSeat = 0;
        g_miRole = -1;
        g_miText = "";
        return;
    }
    if (g_miRole != 3 && g_miRole != 4 && g_miRole != 24 && g_miRole != 47 && g_miRole != 50 && g_miRole != 53 && g_miRole != 58 && g_miRole != 125) {
    if (g_miRole == 42) {
        BOTC_MiDreamerSend();
        return;
    }
    if (g_miRole >= 60) {
        BOTC_MiFnSend();
        return;
    }
        return;
    }
    if (g_miSeat < 1 || g_miSeat > 13) {
        return;
    }
    seat = g_miSeat;
    role = g_miRole;
    // ⚠ 空框读出来是空字符串：先拦掉，再交给 BOTC_TextNum 认数字
    s = libNtve_gf_DialogItemEditValue(g_miEdit, g_teller);
    if (StringLength(s) == 0) {
        return;
    }
    n = BOTC_TextNum(s);
    if (n < 0) {
        return;
    }
    // 【杂耍艺人】（用户 2026-11-13）：白天最多猜 5 组，猜对个数只能是 0~5，超出范围不收。
    if (role == 58 && n > 5) {
        BOTC_Notice(g_teller, "杂耍艺人一天最多猜 5 次：猜对个数只能填 0~5。");
        return;
    }
    // 【侍女（24）】（用户 2026-11-13）：选的是两名玩家，结果只能是 0 / 1 / 2，超出范围不收。
    if (role == 24 && n > 2) {
        BOTC_Notice(g_teller, "侍女查询的是选中两人中今晚被唤醒的人数：只能填 0、1 或 2。");
        return;
    }
    // 【女祭司（125）】（用户 2026-11-13）：填的是座位号（1~12），不是计数：超范围要当场拒绝，
    //   不能走下面的 n>12→9 兜底，否则填 13 会被静默当成 9 号座位发出去。
    if (role == 125 && (n < 1 || n > 12)) {
        BOTC_Notice(g_teller, "女祭司要给一个 1~12 的玩家座位号。");
        return;
    }
    if (n > 12) {
        n = 9;
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    // 【数学家】核对（用户 2026-09-21）：说书人填的数字和真身不符 → 记一格「未正常生效」
    //   ⚠ 以前这段被塞进了 if (role == 3) 里面，所以只有厨师会核；现在挪到所有数字题的前面：
    //     厨师 3 / 共情者 4 / 侍女 24 / 钟表匠 47 / 数学家 50 / 神谕者 53 都会核（杂耍艺人 58 单独判区间）
    tru = BOTC_TrueNumAns(role, seat);
    if (tru >= 0 && tru != n) {
        BOTC_MalfNote(seat, "填的数字和真身不符");
    }
    if (role == 3) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 4) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    // 【气球驾驶员（72）】（用户 2026-09-23）：填的数字 = 要给他看的座位号（1~12 → 玩家 2~13）
    if (role == 72) {
        if (n >= 1 && n <= 12) {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + "。");
            g_tokOn[(((g_teller * 14) + (n + 1)) * 256) + 95] = true;      // Learned (Balloonist)
        }
        else {
            BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
        }
    }
    if (role == 24) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 47) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 50) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 53) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
    }
    if (role == 125) {
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + BOTC_NameStr(n + 1) + " 是说书人认为你最应该与其交流的玩家。");
        BOTC_PmStore(g_teller, "【女祭司】已告诉 " + BOTC_NameStr(seat) + "：" + BOTC_NameStr(n + 1) + " 是最应该交流的玩家。");
    }
    if (role == 58) {
        // 猜对几个由说书人自行判断（用户 2026-11-04）：不再用脚本计数给数学家做自动核对。
        BOTC_PmInfo(g_who[seat], "【信息】你得知" + IntToString(n));
        g_juggUsed[seat] = true;       // 得过信息了：这一局不再唤醒他
    }
    BOTC_PmStore(g_teller, "已把「" + IntToString(n) + "」发给 " + BOTC_NameStr(seat) + "（" + BOTC_SeatRoleStr(seat) + "）。");
    g_miSeat = 0;
    g_miRole = -1;
}

// 输入框里那行字 → 数字（认不出来返回 -1）
//   ⚠ 先拿**整串**去认（不用 StringFind / StringToInt：实测输入框取回来的字串
//     取子串 / 转数字都可能读歪），整串认不出再退回去试第 1、第 2 个字符。
int BOTC_TextNum (string s) {
    if (StringLength(s) <= 0) {
        return -1;
    }
    return StringToInt(s);
}

// 占卜师：说书人点【有恶魔】/【没有恶魔】，点完立刻私聊发给占卜师本人
void BOTC_ManInfoYesNo (int yes) {
    int seat;
    string ans;
    string who;
    int tru;
    // 【帽匠 · 茶会换角色】（用户 2026-11-09）：是 → 弹恶魔 / 爪牙角色网格；否 / X → 这一位不换。
    if (g_miRole == 818) {
        seat = g_miSeat;
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miRole = -1;
        if (yes != 0) {
            BOTC_HatRoleOpenGrid(seat);
        }
        else {
            BOTC_PmStore(g_teller, "【帽匠】" + BOTC_NameStr(seat) + " 保持不变。");
            BOTC_HatRoleNext();
        }
        return;
    }
    // 【蛊雕（162）】左 = 保持方向，右 = 每局一次改变方向。
    if (g_miRole == 813) {
        seat = g_miSeat;
        BOTC_GudiaoAnswer(seat, yes == 0);
        return;
    }
    // 【筑梦师】（42）：那两个按钮其实是「选善良角色 / 选邪恶角色」（用户 2026-09-21）
    if (g_miRole == 42) {
        BOTC_MiRoleBtn(yes);
        return;
    }
    // 【亡骨魔（69）】（用户 2026-09-21）：这两个按钮 = 「左 / 右两名候选镇民」，点哪个哪个中毒
    if (g_miRole == 79) {
        if (yes != 0) {
            BOTC_VigPoison(g_vigA);
        }
        else {
            BOTC_VigPoison(g_vigB);
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miRole = -1;
        return;
    }
    // 【二选一醉酒】（用户 2026-10-16）：左边 = 候选 A，右边 = 候选 B，点谁谁醉
    if (g_miRole == 807) {
        BOTC_DrunkPickApply(yes);
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miRole = -1;
        return;
    }
    // 【村夫（105）】（用户 2026-10-10）：左边 = 善良、右边 = 邪恶
    if (g_miRole == 105) {
        seat = g_miSeat;
        ans = "【信息】你得知邪恶。";
        if (yes != 0) {
            ans = "【信息】你得知善良。";
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], ans);
        BOTC_PmStore(g_teller, "【村夫】已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    // 【引路人（156）】（用户 2026-11-06）：是 / 否 → 把对应答案私聊发给目标
    if (g_miRole == 156) {
        seat = g_miSeat;
        ans = "【信息】你得知否";
        if (yes != 0) {
            ans = "【信息】你得知是";
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        if (seat >= 1 && seat <= 13) {
            BOTC_PmInfo(g_who[seat], ans);
        }
        BOTC_PmStore(g_teller, "【引路人】已询问目标：" + g_miExtra + "；发送答案" + ans + "。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole == 811) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_EnvoyAnswer(yes != 0);
        return;
    }
    if (g_miRole == 812) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_BrokerAnswer(yes != 0);
        return;
    }
    // 【半兽人 × 陌客 / 间谍】（用户 2026-11-11）：击杀 / 不杀。
    if (g_miRole == 805) {
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        g_miSeat = 0;
        g_miRole = -1;
        BOTC_LycanAnswer(yes);
        return;
    }
    // 【首夜信息位】（60+角色编号）：那个按钮是「选身份」（用户 2026-09-21）
    if (g_miRole >= 60) {
        BOTC_MiFnPickRole();
        return;
    }
    if (g_miSeat < 1 || g_miSeat > 13) {
        return;
    }
    // 【梦殒春宵】是非题：卖花女孩（51）/ 城镇公告员（52）/ 女裁缝（55）（用户 2026-09-21）
    if (g_miRole == 51 || g_miRole == 52 || g_miRole == 55) {
        seat = g_miSeat;
        if (seat < 1 || seat > 13) {
            return;
        }
        if (g_miRole == 51 || g_miRole == 52 || g_miRole == 55) {
            ans = "【信息】你得知否";
            if (yes != 0) {
                ans = "【信息】你得知是";
            }
        }
        DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
        BOTC_PmInfo(g_who[seat], ans);
        tru = BOTC_TrueYesNoAns(g_miRole, seat);
        if (tru >= 0 && tru != yes) {
            BOTC_MalfNote(seat, "答的和真身不符");
        }
        BOTC_PmStore(g_teller, "已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
        g_miSeat = 0;
        g_miRole = -1;
        return;
    }
    if (g_miRole != 5) {
        return;
    }
    seat = g_miSeat;
    ans = "否";
    if (yes != 0) {
        ans = "是";
    }
    who = g_miExtra;
    // 【数学家】核对（占卜师）：说书人点的答案和真身不符 → 记一格「未正常生效」
    tru = BOTC_TrueYesNoAns(5, seat);
    if (tru >= 0 && tru != yes) {
        BOTC_MalfNote(seat, "占卜师的答案和真身不符");
    }
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), false);
    BOTC_PmInfo(g_who[seat], "【信息】你得知" + ans);
    BOTC_PmStore(g_teller, "占卜师：已把「" + ans + "」发给 " + BOTC_NameStr(seat) + "。");
    g_miSeat = 0;
    g_miRole = -1;
}

// 造谣者的死者：跟镇长弹刀同一套口径（先数场上善良/邪恶存活数，邪恶快追平时挑邪恶，
//   否则挑善良并按「已失去能力 > 一次性信息者（分类 1）/ 外来者 > 其它」三级优先）。排除造谣者自己。
int BOTC_GossipVictim (int by) {
    int i;
    int q;
    int r;
    int good;
    int evil;
    int n;
    int pick;
    int n1;
    int n2;
    int n3;
    int p1;
    int p2;
    int p3;
    good = 0;
    evil = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == by || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            evil = evil + 1;
        }
        else {
            good = good + 1;
        }
    }
    if (good - evil <= 2) {
        n = 0;
        pick = 0;
        for (i = 0; i < g_seatN; i += 1) {
            q = g_seatList[i];
            if (q == by || BOTC_SeatDead(q)) {
                continue;
            }
            r = BOTC_SeatTrueRole(q);
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleAlign(r) == 1) {
                n = n + 1;
                if (RandomInt(1, n) == 1) {
                    pick = q;
                }
            }
        }
        return pick;
    }
    n1 = 0;
    n2 = 0;
    n3 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == by || BOTC_SeatDead(q)) {
            continue;
        }
        r = BOTC_SeatTrueRole(q);
        if (r < 0 || r > 163) {
            continue;
        }
        if (BOTC_RoleAlign(r) == 1) {
            continue;
        }
        if (g_tokOn[(((g_teller * 14) + q) * 256) + 12] || g_tokOn[(((g_teller * 14) + q) * 256) + 17]) {
            n1 = n1 + 1;
            if (RandomInt(1, n1) == 1) {
                p1 = q;
            }
        }
        else {
            if (g_roleInfoClass[r] == 1 || BOTC_RoleTeam(r) == 1) {
                n2 = n2 + 1;
                if (RandomInt(1, n2) == 1) {
                    p2 = q;
                }
            }
            else {
                n3 = n3 + 1;
                if (RandomInt(1, n3) == 1) {
                    p3 = q;
                }
            }
        }
    }
    if (p1 >= 2) {
        return p1;
    }
    if (p2 >= 2) {
        return p2;
    }
    return p3;
}

// 智能说书：夜间该醒的都处理完之后结算造谣者的声明（真人说书由他自己判）
void BOTC_GossipNightResolve () {
    int by;
    int victim;
    string blk;
    by = g_gossipBy;
    if (by < 2 || by > 13) {
        return;
    }
    if (StringLength(g_gossipText) <= 0) {
        return;
    }
    if (!BOTC_AbilityWorks(by, 28)) {
        BOTC_PmStore(g_teller, "【造谣者】" + BOTC_NameStr(by) + " 没有可用的造谣者能力（来源失效 / 中毒 / 不是该能力）→ 今晚不结算。");
        return;
    }
    if (RandomInt(1, 100) > 50) {
        BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 声明「" + g_gossipText + "」→ 判定为假，今晚没有死亡。");
        return;
    }
    victim = BOTC_GossipVictim(by);
    if (victim < 2) {
        BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 的声明判真，但场上没有可以死的人。");
        return;
    }
    blk = BOTC_DeathBlocker(victim, 1, 0, false);
    if (blk != "") {
        BOTC_PmStore(g_teller, "造谣者声明判真，本来会死的是 " + BOTC_NameStr(victim) + "，但他带着【" + blk + "】，没有死。");
        if (blk == "首次未死（弄臣）") {
            BOTC_FoolSave(victim);
        }
        return;
    }
    BOTC_MarkDeathQuietSrc(victim, 1, 0, 28);     // 造谣者：打「死亡（造谣者）」
    BOTC_PmStore(g_teller, "造谣者(" + BOTC_NameStr(by) + ") 声明「" + g_gossipText + "」→ 判定为真：今晚 " + BOTC_NameStr(victim) + " 死亡。");
}

// ■ 侍臣（29）：每局限一次，选一个**角色**，让带有这个角色的人醉酒三个夜晚和三个白天。
void BOTC_CourtierOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    // 【座位机制】（用户 2026-10-07）：p 是格子；g_courtUsed 按格子存，g_pick* / 投递按客户端
    cp = g_who[p];
    if (g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]) {
        BOTC_Notice(cp, "你这一局的侍臣能力已经用过了或已失去能力。");
        return;
    }
    g_pickMode[cp] = 5;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("不发动技能"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_CourtierPick (int p, int role) {
    int i;
    int seat;
    int count;
    string candidates;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_courtUsed[p] || g_tokOn[(((g_teller * 14) + p) * 256) + 47]) {
        return;                                  // 已经用过了或已失去能力：重复调用直接忽略
    }
    if (role < 0 || role > 163) {
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_courtUsed[p] = true;                       // 不管成不成，这一次机会都用掉
    g_courtRole = role;
    g_tokOn[(((g_teller * 14) + p) * 256) + 47] = true;      // 发动过了，立即失去本角色能力
    if (!BOTC_SkillWorks(p)) {
        BOTC_GrimRender(g_teller);
        BOTC_SkillBtnRender();
        return;
    }
    seat = 0;
    count = 0;
    candidates = "";
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_RegRoleOf(i) == role) {         // 谁「被看成」这个角色就算谁（间谍可能被看成镇民）
            seat = i;
            count = count + 1;
            if (candidates != "") {
                candidates = candidates + "、";
            }
            candidates = candidates + BOTC_NameStr(i);
        }
    }
    if (seat < 2) {
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选了「" + BOTC_RoleNameSafe(role) + "」，但本局没有这个角色 → 什么也没发生。");
        BOTC_SkillBtnRender();
        return;
    }
    if (count > 1) {
        g_courtPick = true;
        g_courtBy = p;
        g_skillPicking[1] = true;
        g_skillT1[1] = 0;
        g_skillT2[1] = 0;
        g_skillT3[1] = 0;
        BOTC_SkillRender(1);
        DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
        libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择哪名「" + BOTC_RoleNameSafe(role) + "」醉酒"), PlayerGroupSingle(g_teller));
        DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_skillNoPick[1], PlayerGroupSingle(g_teller), false);
        BOTC_Notice(g_teller, "【侍臣】场上有 " + IntToString(count) + " 名「" + BOTC_RoleNameSafe(role) + "」：请选择其中一名醉酒。");
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选择角色「" + BOTC_RoleNameSafe(role) + "」，候选：" + candidates + "。请你点其中一名确认。");
        BOTC_GrimRender(g_teller);
        BOTC_SkillBtnRender();
        return;
    }
    BOTC_CourtierApply(p, seat, role);
}

// 侍臣的最终落点：角色唯一时直接结算；同角色多人时由说书人在待选面板里调用。
// 【侍臣 × 无神论者 · 说书人判定】（用户 2026-11-12）：选中无神论者时先问说书人这次是否生效；
//   选否也算侍臣能力已经发动（g_courtUsed / token 47 已在 BOTC_CourtierPick 里打上），不会重新选择。
void BOTC_CourtierApply (int p, int seat, int role) {
    if (p < 1 || p > 13 || seat < 2 || seat > 13) {
        return;
    }
    if (role == 83) {
        g_courtPick = false;
        g_courtBy = 0;
        BOTC_GrimRender(g_teller);
        BOTC_SkillBtnRender();
        BOTC_JudgeAsk(1, "【侍臣】" + BOTC_NameStr(p) + " 选择了「无神论者」。是否让这次醉酒生效？", p, seat, role);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选了无神论者 → 请选择【是：生效】或【否：不生效】。");
        return;
    }
    BOTC_CourtierApplyNow(p, seat, role);
}

void BOTC_CourtierApplyNow (int p, int seat, int role) {
    if (p < 1 || p > 13 || seat < 2 || seat > 13) {
        return;
    }
    g_courtRole = role;
    g_courtSeat = seat;
    g_courtLeft = 3;                             // 醉酒1 / 2 / 3：每个黄昏换一张（跟百科一致）
    g_tokOn[(((g_teller * 14) + seat) * 256) + 53] = true;     // 醉酒1
    g_tokOn[(((g_teller * 14) + p) * 256) + 47] = true;        // 发动过了 → 立刻在自己身上打「失去能力（侍臣）」（用户 2026-09-20）
    g_courtPick = false;
    g_courtBy = 0;
    if (role == 141) {
        BOTC_PmInfo(g_who[seat], "【维齐尔×侍臣相克】你被侍臣选中，失去能力并醉酒；白天免死不再生效。");
        BOTC_PmStore(g_teller, "【维齐尔×侍臣相克】" + BOTC_NameStr(seat) + " 失去能力并醉酒，已撤销白天免死。");
        BOTC_VizierSync();
    }
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(p) + " 选了「" + BOTC_RoleNameSafe(role) + "」→ " + BOTC_NameStr(seat) + " 醉酒三个夜晚和三个白天。");
    BOTC_SkillBtnRender();
}

// 【说书人判定 · 是 / 否】（用户 2026-11-12）：侍臣选中无神论者、无神论者局吟游诗人遇到
//   爪牙被处决，都弹这个面板问说书人这次能力是否生效。
void BOTC_JudgeAsk (int kind, string title, int a, int b, int c) {
    string yl;
    string nl;
    yl = "是：生效";
    nl = "否：不生效";
    if (kind == 2) { yl = "是：触发"; nl = "否：不触发"; }
    if (kind == 10) { yl = "是：处决提名者"; nl = "否：不处决"; }
    if (kind == 11) { yl = "是：死亡"; nl = "否：不死亡"; }
    if (kind == 12) { yl = "是：死亡"; nl = "否：不死亡"; }
    if (kind == 13) { yl = "是：视为恶魔"; nl = "否：不视为恶魔"; }
    if (kind == 14) { yl = "是：视为爪牙"; nl = "否：不视为爪牙"; }
    if (kind == 15) { yl = "是：触发"; nl = "否：不触发"; }
    if (kind == 16) { yl = "是：复活"; nl = "否：不复活"; }
    if (kind == 17) { yl = "是：视为邪恶"; nl = "否：视为善良"; }
    if (kind == 18) { yl = "是：死亡"; nl = "否：不死亡"; }
    if (g_judgeKind != 0) {
        BOTC_JudgeAnswer(0);                 // 上一个没答完 → 先按「否」收掉
    }
    g_judgeKind = kind;
    g_judgeA = a;
    g_judgeB = b;
    g_judgeC = c;
    libNtve_gf_SetDialogItemText(g_judgeYes, StringToText(yl), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_judgeNo, StringToText(nl), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_judgeTitle, StringToText(title), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_judgeDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_JudgeAnswer (int yes) {
    int kind;
    int a;
    int b;
    int c;
    int i;
    kind = g_judgeKind;
    a = g_judgeA;
    b = g_judgeB;
    c = g_judgeC;
    g_judgeKind = 0;
    g_judgeA = 0;
    g_judgeB = 0;
    g_judgeC = 0;
    if (g_judgeDlg != 0) {
        DialogSetVisible(g_judgeDlg, PlayerGroupAll(), false);
    }
    if (kind == 1) {
        if (yes == 0) {
            BOTC_GrimRender(g_teller);
            BOTC_PmStore(g_teller, "【侍臣】说书人判定对无神论者不生效 → 能力已经用掉，什么也没发生。");
            BOTC_SkillBtnRender();
            return;
        }
        BOTC_CourtierApplyNow(a, b, c);
        // 无神论者被醉倒 → 能力失效、场上没有恶魔：立刻结算善良胜。
        BOTC_CheckWin();
        return;
    }
    if (kind == 2) {
        if (yes == 0) {
            BOTC_PmStore(g_teller, "【吟游诗人】说书人判定这次不触发 → 没有人醉酒。");
            return;
        }
        BOTC_MinstrelApply(a, b);
        BOTC_CheckWin();
        return;
    }
    // 【贞洁者 × 间谍 / 陌客能力者】（用户 2026-11-12）：a = 提名者，b = 贞洁者
    if (kind == 10) {
        if (yes != 0) {
            BOTC_VirginAuto(a, b);
        }
        else {
            BOTC_PmStore(g_teller, "【贞洁者】说书人判定 " + BOTC_NameStr(a) + " 这次不算镇民 → 不处决。");
        }
        return;
    }
    // 【魔像 × 间谍 / 陌客能力者】：a = 魔像，b = 目标
    if (kind == 11) {
        if (yes != 0) {
            BOTC_GolemKill(b);
        }
        else {
            BOTC_PmStore(g_teller, "【魔像】说书人判定 " + BOTC_NameStr(b) + " 这次不死亡。");
        }
        return;
    }
    // 【月之子 × 间谍 / 陌客能力者】：a = 月之子，b = 目标
    if (kind == 12) {
        if (yes != 0) {
            BOTC_MarkDeathQuietSrc(b, 1, 0, 36);
            BOTC_PmStore(g_teller, "【月之子】说书人判定 " + BOTC_NameStr(b) + " 按善良结算 → 今晚死亡。");
        }
        else {
            BOTC_PmStore(g_teller, "【月之子】说书人判定 " + BOTC_NameStr(b) + " 这次不算善良 → 不死亡。");
        }
        return;
    }
    // 【驱魔人 × 陌客能力者】：a = 驱魔人，b = 目标
    if (kind == 13) {
        if (yes != 0) {
            for (i = 2; i <= 13; i += 1) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 31] = false;
            }
            g_tokOn[(((g_teller * 14) + b) * 256) + 31] = true;
            g_exoBlock = b;
            g_exoNight = g_nightNum;
            g_exoFrom = a;
            BOTC_GrimRender(g_teller);
            BOTC_PmInfo(g_who[b], "【信息】你被驱魔人选中了。");
            if (BOTC_SeatTrueRole(b) == 44) {
                BOTC_PukkaExorcistResolve(b);
            }
            BOTC_PmStore(g_teller, "【驱魔人】说书人判定 " + BOTC_NameStr(b) + " 按恶魔处理 → 今晚封刀。");
        }
        else {
            BOTC_PmStore(g_teller, "【驱魔人】说书人判定 " + BOTC_NameStr(b) + " 这次不是恶魔 → 没有效果。");
        }
        return;
    }
    // 【传教士 × 间谍 / 陌客能力者】：a = 传教士，b = 目标
    if (kind == 14) {
        if (yes != 0) {
            g_tokOn[(((g_teller * 14) + b) * 256) + 125] = true;
            BOTC_GrimRender(g_teller);
            if (BOTC_HasAbility(b, 141)) {
                BOTC_PmInfo(g_who[b], "【维齐尔×传教士相克】你被传教士选中：失去能力，但白天仍然不会死亡。");
                BOTC_PmStore(g_teller, "【维齐尔×传教士相克】" + BOTC_NameStr(b) + " 失去能力并得知此事；白天免死仍保留。");
                BOTC_VizierSync();
            }
            else {
                BOTC_PmInfo(g_who[b], "【信息】你被传教士选中了：能力失效。");
                BOTC_PmStore(g_teller, "【传教士】说书人判定 " + BOTC_NameStr(b) + " 按爪牙处理 → 失去能力。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【传教士】说书人判定 " + BOTC_NameStr(b) + " 这次不算爪牙 → 无事发生。");
        }
        return;
    }
    // 【吟游诗人 × 间谍 / 陌客能力者】：a = 被处决者，b = 吟游诗人
    if (kind == 15) {
        if (yes != 0) {
            BOTC_MinstrelApply(a, b);
            BOTC_CheckWin();
        }
        else {
            BOTC_PmStore(g_teller, "【吟游诗人】说书人判定 " + BOTC_NameStr(a) + " 这次不算爪牙 → 不触发全员醉酒。");
        }
        return;
    }
    // 【教授 × 间谍能力者】：a = 教授，b = 目标（能力已经用掉）
    if (kind == 16) {
        if (yes != 0) {
            if (BOTC_PublicDead(b)) {
                g_tokOn[(((g_teller * 14) + b) * 256) + 42] = true;
                BOTC_GrimRender(g_teller);
                BOTC_PmStore(g_teller, "【教授】说书人判定复活 " + BOTC_NameStr(b) + "：红叉先留着，天亮统一公布。");
            }
            else {
                BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(b) + " 没有红叉 → 目标无效，没有复活。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【教授】说书人判定这次不复活 " + BOTC_NameStr(b) + "。");
        }
        BOTC_SkillBtnRender();
        return;
    }
    // 【食人族 × 间谍 / 陌客能力者】：a = 被处决者
    if (kind == 17) {
        g_cannFedEvilSet[a] = true;
        g_cannFedEvil[a] = (yes != 0);
        BOTC_PmStore(g_teller, "【食人族】说书人判定 " + BOTC_NameStr(a) + " 被处决时按" + BOTC_AlignName(yes) + "阵营结算。");
        BOTC_CannExecHooks(a);
        return;
    }
    // 【茶艺师 × 间谍 / 陌客能力者】：a = 目标，b = 1 处决 / 0 其他死亡
    if (kind == 18) {
        if (yes != 0) {
            g_teaDieOk[a] = true;
            if (b == 1) {
                BOTC_ExecApplyKill(a);
            }
            else {
                BOTC_MarkDeathQuietSrc(a, g_teaQuietKind, g_teaQuietByDemon, g_teaQuietSrc);
            }
            g_teaDieOk[a] = false;
        }
        else {
            if (b == 1) {
                BOTC_PubAnnounce("【处决】" + BOTC_NameStr(a) + " 被处决了，但不知道为什么，他并没有死亡。");
                BOTC_PeriodRecord("---- " + BOTC_PeriodStr() + "：" + BOTC_NameStr(a) + " 被处决（没有死亡）----");
                if (g_phase != 0) {
                    BOTC_NomCloseEx(false);
                }
            }
            else {
                BOTC_PmStore(g_teller, "【茶艺师】说书人判定 " + BOTC_NameStr(a) + " 这次受到保护 → 不死亡。");
            }
        }
        return;
    }
}

// 侍臣的时长（跟百科一致）：每个**黄昏**把醉酒1换成醉酒2、醉酒2换成醉酒3，
//   第三次黄昏把醉酒3换掉，并在侍臣自己身上打「失去能力（侍臣）」。
void BOTC_CourtierTick () {
    int s;
    if (g_courtSeat < 2) {
        return;
    }
    s = g_courtSeat;
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 53]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 53] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 54] = true;
        g_courtLeft = 2;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(s) + " 的醉酒：醉酒1 → 醉酒2。");
        return;
    }
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 54]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 54] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 55] = true;
        g_courtLeft = 1;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【侍臣】" + BOTC_NameStr(s) + " 的醉酒：醉酒2 → 醉酒3。");
        return;
    }
    if (g_tokOn[(((g_teller * 14) + s) * 256) + 55]) {
        g_tokOn[(((g_teller * 14) + s) * 256) + 55] = false;
        g_tokOn[(((g_teller * 14) + s) * 256) + 47] = true;     // 失去能力（侍臣）打在他自己身上
        g_courtLeft = 0;
        BOTC_GrimRender(g_teller);
    }
}

// ■ 奥赫（134）：每个夜晚*选择一个角色；角色在场则持有者死亡，不在场时由说书人选择死亡玩家。
void BOTC_OjoOpen (int p) {
    int cp;
    if (p < 1 || p > 13) {
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼 / 提线木偶：这次选角色不产生死亡。");
        BOTC_MalfMark(p);
        return;
    }
    cp = g_who[p];
    g_ojoFrom = p;
    g_ojoRole = -1;
    g_ojoAskSt = false;
    g_pickMode[cp] = 30;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("今晚不发动技能"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_OjoDecline (int p) {
    g_ojoFrom = 0;
    g_ojoRole = -1;
    g_ojoAskSt = false;
    BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 今晚不发动技能。");
}

void BOTC_OjoOpenStTarget (int p, int role) {
    if (p < 1 || p > 13 || role < 0 || role > 163) {
        return;
    }
    DialogSetVisible(g_skillDlg[p], PlayerGroupSingle(g_who[p]), false);
    g_ojoFrom = p;
    g_ojoRole = role;
    g_ojoAskSt = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "【奥赫】点一名合法的存活的玩家，再按【确认】。");
}

void BOTC_OjoResolveTarget (int p, int target) {
    if (p < 1 || p > 13 || target < 2 || target > 13) {
        return;
    }
    if (!g_ojoAllow[target]) {
        BOTC_Notice(g_teller, "这个座位不在奥赫这次可选的范围内。");
        return;
    }
    g_ojoAskSt = false;
    g_ojoFrom = 0;
    g_ojoRole = -1;
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼 / 失去能力：这次没有死亡。");
        return;
    }
    BOTC_GoonTouch(p, target);
    BOTC_WudTryTrigger(target, p);
    BOTC_DemonStrike(p, 134, target, false);
}

void BOTC_OjoPick (int p, int role) {
    int q;
    int matches;
    int alive;
    int last;
    int sent;
    if (p < 1 || p > 13 || role < 0 || role > 163) {
        return;
    }
    if (p != g_ojoFrom) {
        return;
    }
    BOTC_TellRoleChoice(p, role);
    g_ojoRole = role;
    // 【奥赫疯子】：疯子的奥赫能力不产生死亡，只把自己选择的角色报给所有真恶魔。
    if (BOTC_IsLunatic(p)) {
        g_ojoFrom = 0;
        g_ojoAskSt = false;
        if (BOTC_SkillWorks(p)) {
            // 【奥赫疯子】：奥赫只报角色名、不产生死亡，选完角色后直接私聊所有真恶魔。
            sent = BOTC_PmInfoDemons("【信息】疯子选择了" + g_roleName[role] + "。");
            if (sent > 0) {
                BOTC_PmStore(g_teller, "【疯子】已直接私聊告诉 " + IntToString(sent) + " 只恶魔：奥赫疯子选择了「" + g_roleName[role] + "」。");
            }
            else {
                BOTC_PmStore(g_teller, "【疯子】场上没有可接收信息的真恶魔；奥赫疯子实际选择了「" + g_roleName[role] + "」。");
            }
        }
        else {
            BOTC_PmStore(g_teller, "【疯子】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这次没有发送给恶魔；他实际选择了「" + g_roleName[role] + "」，这条别外传。");
        }
        return;
    }
    if (!BOTC_SkillWorks(p)) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 中毒 / 酒鬼 / 失去能力：选择了「" + g_roleName[role] + "」，但这次没有死亡。");
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_ojoAllow[q] = false;
    }
    matches = 0;
    alive = 0;
    last = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_SeatTrueRole(q) != role) {
            continue;
        }
        matches = matches + 1;
        if (!BOTC_SeatDead(q)) {
            g_ojoAllow[q] = true;
            alive = alive + 1;
            last = q;
        }
    }
    if (matches == 0) {
        for (q = 2; q <= 13; q += 1) {
            if (!g_seatOn[q] || BOTC_SeatDead(q)) {
                continue;
            }
            g_ojoAllow[q] = true;
            alive = alive + 1;
            last = q;
        }
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了不在场的「" + g_roleName[role] + "」→ 改由说书人选择死亡玩家。");
    }
    else if (alive == 0) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」，但持有者已经死亡，没有新的死亡。");
        return;
    }
    else {
        BOTC_PmStore(g_teller, "【奥赫】" + BOTC_NameStr(p) + " 选择了「" + g_roleName[role] + "」：场上有 " + IntToString(alive) + " 名存活持有者。");
    }
    if (alive == 0) {
        g_ojoFrom = 0;
        BOTC_PmStore(g_teller, "【奥赫】场上没有可被杀死的玩家。");
        return;
    }
    if (alive == 1) {
        BOTC_OjoResolveTarget(p, last);
        return;
    }
    BOTC_OjoOpenStTarget(p, role);
}

// ■ 卡扎力（135）：随机发牌时把原有爪牙位置替换成不在场的善良角色；首夜自动唤醒后只与说书人私聊安排。
void BOTC_KazaliCompositionApply () {
    int i;
    int q;
    int n;
    int pick;
    int r;
    int oldR;
    int made;
    if (g_kazCompositionDone) {
        return;
    }
    g_kazCompositionDone = true;
    if (!BOTC_RoleInPlay(135)) {
        return;
    }
    made = 0;
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q] || BOTC_RoleTeam(BOTC_SeatTrueRole(q)) != 2) {
            continue;
        }
        n = 0;
        pick = -1;
        for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
            r = g_boardRole[(g_board * 256) + i];
            if (r < 0 || r > 163) {
                continue;
            }
            if (BOTC_RoleTeam(r) != 0 && BOTC_RoleTeam(r) != 1) {
                continue;
            }
            if (BOTC_RoleInPlay(r)) {
                continue;
            }
            n = n + 1;
            if (RandomInt(1, n) == 1) {
                pick = r;
            }
        }
        if (pick < 0) {
            BOTC_PmStore(g_teller, "【卡扎力】配板时没有足够的不在场善良角色，无法替换 " + BOTC_NameStr(q) + " 的爪牙身份。");
            continue;
        }
        oldR = BOTC_SeatTrueRole(q);
        BOTC_SetSeatRole(g_teller, q, pick);
        g_scrUsed[oldR] = false;
        g_scrUsed[pick] = true;
        made = made + 1;
        BOTC_PmStore(g_teller, "【卡扎力】配板：" + BOTC_NameStr(q) + " 的 " + g_roleName[oldR] + " 已替换为不在场的善良角色「" + g_roleName[pick] + "」。");
    }
}

// ■ 科学怪人（132）：每个能力来源座位独立保存一份善良角色 → 接收者。
bool BOTC_BoffinSourceIs (int b) {
    if (b < 2 || b > 13 || !g_seatOn[b]) {
        return false;
    }
    if (BOTC_SeatTrueRole(b) == 132) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + b) * 256) + 123] && g_alcBorrow == 132) {
        return true;
    }
    if (g_tokOn[(((g_teller * 14) + b) * 256) + 97] && g_cannRole == 132) {
        return true;
    }
    if (g_grantRoleBy[b] == 133) {       // 手工赋予科学怪人能力
        return true;
    }
    // 【性能】只有这个座位自己确实从科怪那里获得了「科怪」能力，
    // 才需要继续找它的科怪来源；普通对局和普通科怪来源在这里直接返回。
    if (!g_bnestChosenBy[b] || g_bnestRoleBy[b] != 133) {
        return false;
    }
    if (BOTC_BoffinNestedSourceIs(b)) {
        return true;
    }
    return false;
}

// 科怪把哲学家 / 炼金术士给恶魔后，由恶魔选择并获得的嵌套能力。
// 这里只附加能力：不改 g_mark，不打「是哲学家」70 / 「是炼金术士」123。
bool BOTC_BoffinNestedSourceIs (int q) {
    int src;
    int outerRole;
    if (q < 2 || q > 13) {
        return false;
    }
    for (src = 2; src <= 13; src += 1) {
        if (src == q || !g_bnestChosenBy[src] || g_boffinTargetBy[src] != q) {
            continue;
        }
        outerRole = g_boffinRoleBy[src] - 1;
        if (outerRole != 56 && outerRole != 95) {
            continue;
        }
        if (g_bnestRoleBy[src] != 133) {
            continue;
        }
        if (BOTC_BoffinSourceIs(src)) {
            return true;
        }
    }
    return false;
}

bool BOTC_BoffinNestedWorksAt (int src, int q) {
    int outerRole;
    if (src < 2 || src > 13 || q < 2 || q > 13) {
        return false;
    }
    if (!g_bnestChosenBy[src] || g_boffinTargetBy[src] != q) {
        return false;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    if (outerRole != 56 && outerRole != 95) {
        return false;
    }
    return BOTC_BoffinWorksAt(src);
}

int BOTC_BoffinNestedSourceFor (int q, int role) {
    int src;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return 0;
    }
    for (src = 2; src <= 13; src += 1) {
        if (BOTC_BoffinNestedWorksAt(src, q) && g_bnestRoleBy[src] == role + 1) {
            return src;
        }
    }
    return 0;
}

bool BOTC_BoffinNestedHasRole (int q, int role) {
    return (BOTC_BoffinNestedSourceFor(q, role) >= 2);
}

int BOTC_BoffinNestedPhiloDrunkTarget (int src) {
    int q;
    int role;
    if (src < 2 || src > 13 || !g_bnestChosenBy[src] || g_boffinRoleBy[src] - 1 != 56) {
        return 0;
    }
    if (!BOTC_BoffinSourceIs(src)) {
        return 0;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13 || BOTC_SeatDead(src) || BOTC_SeatImpairedRaw(src)) {
        return 0;
    }
    if (BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
        return 0;
    }
    role = g_bnestRoleBy[src] - 1;
    if (role < 0 || role > 163) {
        return 0;
    }
    return BOTC_SeatOfRoleNot(role, q);
}

bool BOTC_BoffinNestedPhiloDrunkAt (int seat) {
    int src;
    if (seat < 2 || seat > 13) {
        return false;
    }
    for (src = 2; src <= 13; src += 1) {
        if (BOTC_BoffinNestedPhiloDrunkTarget(src) == seat) {
            return true;
        }
    }
    return false;
}

void BOTC_BoffinNestedClearSource (int src) {
    int i;
    if (src < 2 || src > 13) {
        return;
    }
    g_bnestRoleBy[src] = 0;
    g_bnestChosenBy[src] = false;
    for (i = 0; i <= 13; i += 1) {
        g_bnestDoneBy[(src * 14) + i] = false;
        if (g_bnestSource[i] == src) {
            g_bnestActing[i] = false;
            g_bnestSource[i] = 0;
        }
    }
}

void BOTC_BoffinNestedOpen (int src) {
    int cp;
    int i;
    int pick;
    int q;
    int outerRole;
    if (src < 2 || src > 13 || !BOTC_BoffinWorksAt(src)) {
        return;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13) {
        return;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    g_boffinEditSource = src;
    // 哲学家能力由恶魔玩家自己选择；电脑恶魔由脚本替他选。
    if (outerRole == 56 && BOTC_SeatIsComputer(q)) {
        pick = BOTC_AIPhiloRandomRole(-2);
        if (pick >= 0) {
            BOTC_BoffinNestedPick(src, pick);
        }
        else {
            BOTC_PmStore(g_teller, "当前板子没有可自动选择的角色。");
        }
        return;
    }
    // 炼金术士能力仍由说书人选择；哲学家能力显示给恶魔本人。
    if (outerRole == 95) {
        cp = g_teller;
    }
    else {
        cp = g_who[q];
    }
    g_pickWho[cp] = src;
    if (outerRole == 56) {
        g_pickMode[cp] = 35;
        BOTC_PickFilter(cp, true);
        for (i = 0; i < 64; i += 1) {
            if (g_gridSlot[i] != 56 && g_gridSlot[i] != 95 && g_gridSlot[i] != 148) {
                continue;
            }
            DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(cp), false);
        }
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    }
    else if (outerRole == 95) {
        g_pickMode[cp] = 36;
        g_pickTeam = 2;
        BOTC_PickFilter(cp, false);
        for (i = 0; i < 64; i += 1) {
            if (BOTC_RoleTeam(g_gridSlot[i]) == 2) {
                continue;
            }
            DialogControlSetVisible(g_pickBtn[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickIcon[i], PlayerGroupSingle(cp), false);
            DialogControlSetVisible(g_pickName[i], PlayerGroupSingle(cp), false);
        }
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(cp));
    }
    else {
        return;
    }
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
}

void BOTC_BoffinNestedPick (int src, int role) {
    int q;
    int outerRole;
    if (src < 2 || src > 13 || role < 0 || role > 163 || !BOTC_BoffinWorksAt(src)) {
        return;
    }
    q = g_boffinTargetBy[src];
    if (q < 2 || q > 13) {
        return;
    }
    outerRole = g_boffinRoleBy[src] - 1;
    if (outerRole == 56 && role == 148) {
        BOTC_Notice(g_teller, "科学怪人×食人魔：恶魔无法获得食人魔的能力。");
        return;
    }
    if (outerRole == 56 && BOTC_RoleAlign(role) != 0) {
        BOTC_Notice(g_teller, "这里只能选择善良角色。");
        return;
    }
    if (outerRole == 95 && BOTC_RoleTeam(role) != 2) {
        BOTC_Notice(g_teller, "这里只能选择爪牙角色。");
        return;
    }
    g_bnestRoleBy[src] = role + 1;
    g_bnestChosenBy[src] = true;
    g_bnestDoneBy[(src * 14) + q] = false;
    g_boffinDoneBy[(src * 14) + q] = true;     // 外层哲学家 / 炼金术士选择已经在这一步完成
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_GrimRender(g_who[q]);
    BOTC_PmInfo(g_who[q], "【信息】你得知" + g_roleName[role]);
    BOTC_PmStore(g_teller, BOTC_NameStr(q) + " 选择了 " + g_roleName[role]);
    if (role == 132) {
        g_bnestDoneBy[(src * 14) + q] = true;
        BOTC_BoffinOpenRole(q);
    }
}

int BOTC_BoffinNestedRoleOrderFor (int src, int q) {
    int role;
    int act;
    if (!BOTC_BoffinNestedWorksAt(src, q)) {
        return 0;
    }
    role = g_bnestRoleBy[src] - 1;
    if (role < 0 || role > 163) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    act = g_roleAct[role];
    if (act == 2 && g_nightNum < 2) { return 0; }
    if (act == 5 && g_nightNum > g_seatFirstNight[q]) { return 0; }
    if (act != 1 && act != 2 && act != 5 && act != 6) { return 0; }
    return BOTC_NightOrder(role);
}

int BOTC_BoffinNestedWakeSource (int q) {
    int src;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (src = 2; src <= 13; src += 1) {
        if (g_bnestDoneBy[(src * 14) + q]) {
            continue;
        }
        o = BOTC_BoffinNestedRoleOrderFor(src, q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = src;
            bestOrd = o;
        }
    }
    return best;
}

int BOTC_BoffinNestedWakeOrder (int q) {
    int src;
    src = BOTC_BoffinNestedWakeSource(q);
    if (src < 2) {
        return 0;
    }
    return BOTC_BoffinNestedRoleOrderFor(src, q);
}

int BOTC_BoffinNestedWakeSeat () {
    int src;
    int q;
    int o;
    int bestQ;
    int bestOrd;
    bestQ = 0;
    bestOrd = 0;
    for (src = 2; src <= 13; src += 1) {
        q = g_boffinTargetBy[src];
        if (g_bnestDoneBy[(src * 14) + q]) {
            continue;
        }
        o = BOTC_BoffinNestedRoleOrderFor(src, q);
        if (o > 0 && (bestQ < 2 || o < bestOrd)) {
            bestQ = q;
            bestOrd = o;
        }
    }
    return bestQ;
}

void BOTC_BoffinClearSource (int b) {
    int j;
    if (b < 2 || b > 13) {
        return;
    }
    BOTC_BoffinNestedClearSource(b);
    g_boffinRoleBy[b] = 0;
    g_boffinChosenBy[b] = false;
    g_boffinTargetBy[b] = 0;
    g_boffinAnnouncedBy[b] = 0;
    g_boffinPendingBy[b] = 0;
    for (j = 0; j <= 13; j += 1) {
        g_boffinDoneBy[(b * 14) + j] = false;
        if (g_boffinActingSource[j] == b) {
            g_boffinActing[j] = false;
            g_boffinActingSource[j] = 0;
        }
    }
    if (g_boffinEditSource == b) {
        g_boffinEditSource = 0;
        g_boffinRecipientPick = false;
    }
}

int BOTC_BoffinSeat () {
    int q;
    for (q = 2; q <= 13; q += 1) {
        if (BOTC_BoffinSourceIs(q)) {
            return q;
        }
    }
    return 0;
}

int BOTC_BoffinDemonSeat () {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinSourceIs(b) && g_boffinChosenBy[b]) {
            return g_boffinTargetBy[b];
        }
    }
    return 0;
}

bool BOTC_BoffinWorksAt (int b) {
    int q;
    if (!BOTC_BoffinSourceIs(b) || !g_boffinChosenBy[b]) {
        return false;
    }
    if (g_boffinRoleBy[b] < 1 || g_boffinRoleBy[b] > 163) {
        return false;
    }
    q = g_boffinTargetBy[b];
    if (q < 2 || q > 13 || !g_seatOn[q] || !BOTC_IsDemonSeat(q)) {
        return false;
    }
    if (BOTC_SeatDead(b) || BOTC_SeatImpaired(b)) {
        return false;
    }
    if (g_grantRoleBy[b] == 133 && g_grantDrunkBy[b]) {
        if (BOTC_SeatTrueRole(b) != 132) {
            if (!(g_tokOn[(((g_teller * 14) + b) * 256) + 123] && g_alcBorrow == 132)) {
                if (!(g_tokOn[(((g_teller * 14) + b) * 256) + 97] && g_cannRole == 132)) {
                    return false;
                }
            }
        }
    }
    return true;
}

bool BOTC_BoffinSourceWorks () {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinWorksAt(b)) {
            return true;
        }
    }
    return false;
}

bool BOTC_BoffinActiveFrom (int b, int q, int role) {
    if (!BOTC_BoffinWorksAt(b) || q < 2 || q > 13 || g_boffinTargetBy[b] != q) {
        return false;
    }
    return (g_boffinRoleBy[b] == role + 1);
}

bool BOTC_BoffinActiveFor (int q, int role) {
    int b;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return false;
    }
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinActiveFrom(b, q, role)) {
            return true;
        }
    }
    return false;
}

int BOTC_BoffinTargetWithRole (int role) {
    int b;
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinActiveFrom(b, g_boffinTargetBy[b], role)) {
            return g_boffinTargetBy[b];
        }
    }
    return 0;
}

bool BOTC_BoffinMustStayEvil (int q) {
    // 官方相克：异教领袖 / 莽夫的能力不能把科学怪人局的恶魔变成善良。
    return (BOTC_BoffinActiveFor(q, 106) || BOTC_BoffinActiveFor(q, 37));
}

bool BOTC_BoffinRoleAllowed (int role) {
    int i;
    int n;
    if (role < 0 || role > 163) {
        return false;
    }
    if (BOTC_RoleTeam(role) != 0 && BOTC_RoleTeam(role) != 1) {
        return false;
    }
    if (BOTC_RoleAlign(role) != 0) {
        return false;
    }
    // 【科学怪人 × 村夫】：角色列表最多三张村夫，因此场上有 0~2 名村夫时仍可授予。
    if (role == 105) {
        n = 0;
        for (i = 2; i <= 13; i += 1) {
            if (g_seatOn[i] && BOTC_SeatTrueRole(i) == 105) {
                n = n + 1;
            }
        }
        return (n < 3);
    }
    if (BOTC_RoleTrueInPlay(role)) {
        return false;
    }
    // 认知覆盖、会再次改身份、或官方明确不允许恶魔获得的能力不在候选里。
    // 哲学家 / 炼金术士例外：走专用嵌套附加能力，不修改恶魔牌面。
    if (role == 14 || role == 38 || role == 62 || role == 74 || role == 80) {
        return false;
    }
    if (role == 91 || role == 97 || role == 101 || role == 117 || role == 118 || role == 124 || role == 148) {
        return false;
    }
    return true;
}

void BOTC_BoffinOpenRole (int source) {
    int q;
    if (!BOTC_BoffinSourceIs(source)) {
        return;
    }
    g_boffinEditSource = source;
    g_boffinPendingBy[source] = 0;
    g_boffinRecipientPick = false;
    g_pickMode[g_teller] = 32;
    g_pickWho[g_teller] = 1;
    BOTC_PickFilter(g_teller, false);
    for (q = 0; q < 64; q += 1) {
        if (BOTC_BoffinRoleAllowed(g_gridSlot[q])) {
            continue;
        }
        DialogControlSetVisible(g_pickBtn[q], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickIcon[q], PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_pickName[q], PlayerGroupSingle(g_teller), false);
    }
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择一个角色"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BoffinOpenStatus (int q) {
    string note;
    if (q < 2 || q > 13) {
        return;
    }
    BOTC_MiSeatFieldsReset();
    if (g_boffinChosenBy[q] && g_boffinTargetBy[q] >= 2 && g_boffinRoleBy[q] >= 1 && g_boffinRoleBy[q] <= 163) {
        note = "已赋予" + BOTC_NameStr(g_boffinTargetBy[q]) + "：" + g_roleName[g_boffinRoleBy[q] - 1] + "。";
        if (g_bnestChosenBy[q] && g_bnestRoleBy[q] >= 1 && g_bnestRoleBy[q] <= 163) {
            note = note + " 嵌套能力：" + g_roleName[g_bnestRoleBy[q] - 1] + "。";
        }
    }
    else {
        note = "这个来源尚未选择要赋予恶魔的能力。";
    }
    g_miSeat = 0;
    g_miRole = 810;
    g_miText = "";
    libNtve_gf_SetDialogItemText(g_miTitle, StringToText("【科学怪人】能力状态"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_miNote, StringToText(note), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_miNote, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_miEdit, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit2, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit3, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miEdit4, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miYes, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miNo, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miCancel, PlayerGroupSingle(g_teller), false);
    DialogControlSetVisible(g_miOk, PlayerGroupSingle(g_teller), true);
    libNtve_gf_SetDialogItemText(g_miOk, StringToText("关闭"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_miDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BoffinSyncKnowledge () {
    int b;
    int d;
    int role;
    for (b = 2; b <= 13; b += 1) {
        if (!BOTC_BoffinWorksAt(b)) {
            continue;
        }
        d = g_boffinTargetBy[b];
        role = g_boffinRoleBy[b] - 1;
        if (d == g_boffinAnnouncedBy[b]) {
            continue;
        }
        BOTC_PmInfo(g_who[d], "【信息】你得知" + g_roleName[role]);
        if (BOTC_SeatTrueRole(b) == 95) {
            BOTC_PmStore(g_teller, "【炼金科怪】只通知恶魔 " + BOTC_NameStr(d) + "：" + BOTC_NameStr(b) + " 给予「" + g_roleName[role] + "」能力。");
        }
        else {
            BOTC_PmInfo(g_who[b], "【信息】你得知" + g_roleName[role]);
            BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(b) + " 赋予恶魔 " + BOTC_NameStr(d) + "「" + g_roleName[role] + "」能力。");
        }
        g_boffinAnnouncedBy[b] = d;
    }
}

void BOTC_BoffinPick (int role) {
    int src;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src) || !BOTC_BoffinRoleAllowed(role)) {
        BOTC_Notice(g_teller, "科学怪人只能把不在场的善良角色能力赋给恶魔。");
        return;
    }
    g_boffinPendingBy[src] = role + 1;
    BOTC_BoffinRecipientOpen();
}

void BOTC_BoffinRecipientOpen () {
    int i;
    int role;
    int src;
    bool hasDemon;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src)) {
        return;
    }
    role = g_boffinPendingBy[src];
    if (role <= 0) {
        role = g_boffinRoleBy[src];
    }
    if (role < 1 || role > 163) {
        BOTC_Notice(g_teller, "先选择科学怪人要赋予的能力。");
        return;
    }
    hasDemon = false;
    for (i = 2; i <= 13; i += 1) {
        if (g_seatOn[i] && !BOTC_SeatDead(i) && BOTC_IsDemonSeat(i)) {
            hasDemon = true;
        }
    }
    if (!hasDemon) {
        BOTC_PmStore(g_teller, "【科学怪人】场上没有存活恶魔，暂时不能选择能力接收者。");
        BOTC_Notice(g_teller, "场上没有存活恶魔：无法指定科怪能力接收者。");
        return;
    }
    g_boffinRecipientPick = true;
    g_skillPicking[1] = true;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    BOTC_SkillRender(1);
    libNtve_gf_SetDialogItemText(g_skillTitle[1], StringToText("选择一名玩家"), PlayerGroupSingle(g_teller));
    DialogControlSetVisible(g_skillCancel[1], PlayerGroupSingle(g_teller), true);
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一名存活恶魔，再按【确认】。");
}

void BOTC_BoffinSetRecipient (int q) {
    int old;
    int oldRole;
    int role;
    int src;
    src = g_boffinEditSource;
    if (!BOTC_BoffinSourceIs(src) || q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || !BOTC_IsDemonSeat(q)) {
        BOTC_Notice(g_teller, "只能选择一名存活的恶魔。");
        return;
    }
    role = g_boffinPendingBy[src];
    if (role <= 0) {
        role = g_boffinRoleBy[src];
    }
    if (role < 1 || role > 163) {
        return;
    }
    old = g_boffinTargetBy[src];
    oldRole = g_boffinRoleBy[src] - 1;
    if (oldRole == 56 || oldRole == 95) {
        BOTC_BoffinNestedClearSource(src);
    }
    if (old >= 2 && old <= 13 && old != q && g_boffinActingSource[old] == src) {
        g_boffinActing[old] = false;
        g_boffinActingSource[old] = 0;
    }
    if (old >= 2 && old <= 13 && old != q) {
        BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(src) + " 更换接收者：旧接收者 " + BOTC_NameStr(old) + " 失去这份能力。");
    }
    g_boffinRoleBy[src] = role;
    g_boffinChosenBy[src] = true;
    g_boffinTargetBy[src] = q;
    g_boffinAnnouncedBy[src] = 0;
    g_boffinPendingBy[src] = 0;
    g_boffinDoneBy[(src * 14) + q] = false;
    g_boffinRecipientPick = false;
    g_skillPicking[1] = false;
    g_skillT1[1] = 0;
    g_skillT2[1] = 0;
    g_skillT3[1] = 0;
    DialogSetVisible(g_skillDlg[1], PlayerGroupSingle(g_teller), false);
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【科学怪人】" + BOTC_NameStr(src) + " 选择「" + g_roleName[role - 1] + "」，接收者 " + BOTC_NameStr(q) + "。");
    // 【疯子·假科学怪人能力】（用户 2026-11-10）：科学怪人这一步走完之后，可以再给疯子一份
    //   「假的善良能力」——他只是以为自己拿到了，结算不产生任何效果。
    BOTC_LunFakeAbilAsk(BOTC_RealLunaticSeat());
}

bool BOTC_BoffinFirstWakeStep () {
    int b;
    int src;
    src = 0;
    // 【科学怪人 · 恶魔更替】（用户 2026-11-02）：不再只限首夜。
    //   旧恶魔死亡、红唇女郎顶位后，接收者会被清空；下一夜必须重新唤醒科学怪人给新恶魔发能力。
    for (b = 2; b <= 13; b += 1) {
        if (BOTC_BoffinSourceIs(b) && !BOTC_SeatDead(b) && !g_boffinChosenBy[b]) {
            src = b;
            break;
        }
    }
    if (src < 2) {
        return false;
    }
    g_boffinEditSource = src;
    if (!g_awake[src]) {
        BOTC_WakeToggle(src);
    }
    if (!g_awake[src]) {
        return false;
    }
    if (!g_boffinChosenBy[src] && g_pickMode[g_teller] != 32) {
        BOTC_BoffinOpenRole(src);
    }
    g_insertWake[src] = false;
    g_autoWoke[src] = true;
    g_autoLast = src;
    BOTC_TellerPmTo(src);
    BOTC_WakeRender();
    return true;
}

int BOTC_ActRoleOf (int p) {
    int src;
    if (p < 1 || p > 13) {
        return -1;
    }
    // 【使用技能】（用户 2026-11-06）：说书人临时扮演的角色，只影响座 1 的夜间行动。
    if (p == 1 && g_tellCastRole > 0 && g_tellCastRole <= 163) {
        return g_tellCastRole - 1;
    }
    if (p == 1 && g_pdRole > 0 && g_pdRole <= 163) {
        return g_pdRole - 1;
    }
    if (g_lunFakeAct[p] && g_lunFakeAbil > 0 && g_lunFakeAbil <= 164) {
        return g_lunFakeAbil - 1;
    }
    if (g_boffinActing[p]) {
        src = g_boffinActingSource[p];
        if (BOTC_BoffinWorksAt(src)) {
            return g_boffinRoleBy[src] - 1;
        }
        return -1;
    }
    if (g_bnestActing[p]) {
        src = g_bnestSource[p];
        if (BOTC_BoffinNestedWorksAt(src, p) && g_bnestRoleBy[src] > 0 && g_bnestRoleBy[src] <= 163) {
            return g_bnestRoleBy[src] - 1;
        }
        return -1;
    }
    if (g_grantActing[p] && g_grantRoleBy[p] > 0 && g_grantRoleBy[p] <= 163) {
        return g_grantRoleBy[p] - 1;
    }
    return g_mark[(g_teller * 14) + p] - 1;
}

int BOTC_BoffinRoleOrderForSource (int src, int q) {
    int role;
    int act;
    if (q < 2 || q > 13 || BOTC_SeatDead(q) || g_boffinTargetBy[src] != q) {
        return 0;
    }
    if (!BOTC_BoffinWorksAt(src)) {
        return 0;
    }
    role = g_boffinRoleBy[src] - 1;
    if (role < 0 || role > 163) {
        return 0;
    }
    // 哲学家 / 炼金术士是一次性选择：完成选择后不再自动唤醒这两种能力本身。
    if ((role == 56 || role == 95) && g_bnestChosenBy[src]) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    act = g_roleAct[role];
    if (act == 2 && g_nightNum < 2) { return 0; }
    if (act == 5 && g_nightNum > 1) { return 0; }
    if (act != 1 && act != 2 && act != 5 && act != 6) { return 0; }
    return BOTC_NightOrder(role);
}

int BOTC_BoffinSourceActionOrder (int src, int q) {
    if (g_boffinDoneBy[(src * 14) + q]) {
        return 0;
    }
    return BOTC_BoffinRoleOrderForSource(src, q);
}

int BOTC_BoffinWakeSource (int q) {
    int b;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (b = 2; b <= 13; b += 1) {
        o = BOTC_BoffinSourceActionOrder(b, q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = b;
            bestOrd = o;
        }
    }
    return best;
}

int BOTC_BoffinWakeOrder (int q) {
    int src;
    src = BOTC_BoffinWakeSource(q);
    if (src < 2) {
        return 0;
    }
    return BOTC_BoffinSourceActionOrder(src, q);
}

int BOTC_BoffinWakeSeat () {
    int b;
    int q;
    int o;
    int bestQ;
    int bestOrd;
    bestQ = 0;
    bestOrd = 0;
    for (b = 2; b <= 13; b += 1) {
        q = g_boffinTargetBy[b];
        o = BOTC_BoffinSourceActionOrder(b, q);
        if (o > 0 && (bestQ < 2 || o < bestOrd)) {
            bestQ = q;
            bestOrd = o;
        }
    }
    return bestQ;
}

// 手工赋予能力的夜序：获得能力的那一夜视为这项能力的「首个夜晚」。
// 【食人族 / 杂耍艺人】（用户 2026-11-04）：白天猜过并被处决 / 死亡的杂耍艺人，
//   当晚由获得该能力的玩家代替他听到「猜对几个」的信息（默认第一夜也能触发）。
bool BOTC_JugglerDiedAfterGuess () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_HasAbility(i, 58) && g_juggDone[i] && g_deadKind[i] >= 2 && g_deadDay[i] == g_dayNum) {
            return true;
        }
    }
    return false;
}

int BOTC_GrantNightOrder (int q) {
    int role;
    int act;
    int first;
    int o;
    if (q < 2 || q > 13 || !g_seatOn[q] || g_grantRoleBy[q] <= 0) {
        return 0;
    }
    role = g_grantRoleBy[q] - 1;
    first = g_grantFirstNight[q];
    if (role < 0 || role > 163 || first < 1 || g_nightNum < first) {
        return 0;
    }
    act = g_roleAct[role];
    if (act == 2 && g_nightNum == first) {
        // 杂耍艺人白天猜过之后死亡：借到能力的玩家当晚就要拿到猜测结果。
        if (role == 58 && BOTC_JugglerDiedAfterGuess()) {
            return BOTC_NoOtherOf(58);
        }
        return 0;                         // 带星号角色本身没有首夜行动
    }
    if (act == 5 && g_nightNum != first) {
        return 0;                         // 首夜信息只在它的首个夜晚出现
    }
    if (act != 1 && act != 2 && act != 5 && act != 6) {
        return 0;
    }
    if (g_nightNum == first) {
        o = BOTC_NoFirstOf(role);
        // 【食人族吃到处决的教授】（用户 2026-11-08）：教授这类角色只在「其他夜」
        //   顺序表里有位置，首夜顺序为空。首次获得能力的当晚必须回退到正常夜序，
        //   否则返回 0，永远进不了唤醒队列。
        if (o > 0 || act == 5) {
            return o;
        }
        return BOTC_NoOtherOf(role);
    }
    return BOTC_NoOtherOf(role);
}

bool BOTC_ActingIsFirstNight (int q) {
    if (q == 1) {
        // 【使用技能】（用户 2026-11-06）：说书人临时扮演首夜角色时按首夜分支走。
        return (g_nightNum <= 1);
    }
    if (q < 2 || q > 13) {
        return false;
    }
    if (g_grantActing[q]) {
        return (g_grantFirstNight[q] >= 1 && g_nightNum == g_grantFirstNight[q]);
    }
    return (g_nightNum <= g_seatFirstNight[q]);
}

int BOTC_GrantWakeOrder (int q) {
    int role;
    int own;
    if (q < 2 || q > 13 || !g_seatOn[q] || BOTC_SeatDead(q) || g_grantDoneNight[q]) {
        return 0;
    }
    role = g_grantRoleBy[q] - 1;
    own = g_mark[(g_teller * 14) + q] - 1;
    if (role < 0 || role > 163 || role == own) {
        return 0;
    }
    if (role == 29 && g_courtUsed[q]) { return 0; }
    if (role == 30 && g_profUsed[q]) { return 0; }
    if (role == 55 && g_tokOn[(((g_teller * 14) + q) * 256) + 68]) { return 0; }
    if (role == 77 && g_tokOn[(((g_teller * 14) + q) * 256) + 98]) { return 0; }
    if (role == 109 && g_tokOn[(((g_teller * 14) + q) * 256) + 130]) { return 0; }
    if (role == 128 && g_tokOn[(((g_teller * 14) + q) * 256) + 147]) { return 0; }
    if (role == 147) { return 0; }       // 限只做被动结算，不进入唤醒队列
    // 【杂耍艺人（58）】（用户 2026-11-10）：这份能力只在「当天公开猜过、且这一局还没拿过结果」
    //   的那一夜唤醒一次；唯一例外是杂耍艺人本人当天猜测后当天被处决 → 当晚直接替他拿结果。
    if (role == 58 && g_juggUsed[q]) { return 0; }
    if (role == 58 && !g_juggDone[q] && !BOTC_JugglerDiedAfterGuess()) { return 0; }
    return BOTC_GrantNightOrder(q);
}

int BOTC_GrantWakeSeat () {
    int q;
    int o;
    int best;
    int bestOrd;
    best = 0;
    bestOrd = 0;
    for (q = 2; q <= 13; q += 1) {
        o = BOTC_GrantWakeOrder(q);
        if (o > 0 && (best < 2 || o < bestOrd)) {
            best = q;
            bestOrd = o;
        }
    }
    return best;
}

bool BOTC_AbilityWorks (int q, int role) {
    int tr;
    if (q >= 2 && q <= 13 && g_liveCorpse[q]) {
        return false;
    }
    if (!BOTC_HasAbility(q, role)) {
        return false;
    }
    if (q == 1 && g_pdRole == role + 1) {
        return true;                       // 获得后不再受瘟疫医生之后的醉酒 / 中毒影响
    }
    tr = BOTC_SeatTrueRole(q);
    if (tr == role) {
        return !BOTC_SeatImpaired(q);
    }
    if (BOTC_BoffinActiveFor(q, role)) {
        return true;                       // 恶魔自身中毒/醉酒不影响来自科学怪人的能力
    }
    if (BOTC_BoffinNestedHasRole(q, role)) {
        return true;
    }
    if (g_grantRoleBy[q] == role + 1) {
        return (!g_grantDrunkBy[q] && !BOTC_SeatImpaired(q));
    }
    return !BOTC_SeatImpaired(q);
}

// 【找当前可用的某项能力】---- 原生身份、哲学家 / 食人族 / 炼金术士借来的、
// 科怪赋予的、说书人手工赋予的都算；能力处于醉酒 / 中毒或来源失效时不算。
// 只用于被动能力的全局查询，不用于【真身是什么】的身份登记。
int BOTC_AbilitySeat (int role) {
    int q;
    if (role < 0 || role > 163) {
        return 0;
    }
    for (q = 1; q <= 13; q += 1) {
        if (q >= 2 && !g_seatOn[q]) {
            continue;
        }
        if (BOTC_AbilityWorks(q, role)) {
            return q;
        }
    }
    return 0;
}

bool BOTC_AbilityInPlay (int role) {
    return (BOTC_AbilitySeat(role) >= 1);
}

// ■ 教授（30）：每局限一次，选一名已死亡的玩家；如果他是镇民就复活他（并恢复一次性能力）。
void BOTC_ProfessorResolve (int p, int seat) {
    int real;
    if (p < 1 || p > 13 || seat < 2 || seat > 13) {
        return;
    }
    g_profUsed[p] = true;
    g_tokOn[(((g_teller * 14) + p) * 256) + 44] = true;          // 失去能力（教授）：只要用了能力就打（百科明确写）
    BOTC_GrimRender(g_teller);
    if (!BOTC_SkillWorks(p)) {
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 中毒/酒鬼 → 这一次复活无效。");
        BOTC_SkillBtnRender();
        return;
    }
    // 【教授 × 间谍能力者】（用户 2026-11-12）：是否复活改由说书人选择；无论是否复活都算用掉能力。
    if (BOTC_IsSpyAbility(seat)) {
        BOTC_JudgeAsk(16, "【教授】" + BOTC_NameStr(p) + " 选择了间谍能力者 " + BOTC_NameStr(seat) + "：这次是否复活他？", p, seat, 0);
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 选择了间谍能力者 " + BOTC_NameStr(seat) + "：请选择是否复活（能力已消耗）。");
        return;
    }
    real = BOTC_RegRoleOf(seat);          // 是不是镇民按「互动干扰」那一层算
    if (real < 0 || real > 163) {
        return;
    }
    if (!BOTC_RegIsTownsfolk(seat)) {
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(seat) + "（" + BOTC_RoleNameSafe(real) + "）---- 不是镇民，没有复活。");
        BOTC_SkillBtnRender();
        return;
    }
    if (BOTC_PublicDead(seat)) {
        // 【复活也等天亮统一结算】（用户 2026-09-20）：以前这里直接 BOTC_DeathToggle 就把红叉去掉了，
        //   全桌当场看见「复活」；现在只在夜里记一个「复活（教授）」标记 ----
        //   红叉先留着，天亮才统一公布「【复活】X 复活」并清掉死亡 token / 红叉。
        g_tokOn[(((g_teller * 14) + seat) * 256) + 42] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【教授】已记下复活 " + BOTC_NameStr(seat) + "：红叉先留着，天亮统一公布「复活」并清掉死亡标记。");
    }
    else {
        // 【只有「公开死亡（红叉）」才算有效目标】（用户 2026-09-20）：选到没红叉的人 → 告知目标无效、什么都不做
        BOTC_Notice(g_who[p], "要选一个已经死了的人。");
        BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 选了 " + BOTC_NameStr(seat) + "，但对方没有红叉 → 目标无效、没有复活。");
        BOTC_SkillBtnRender();
        return;
    }
    BOTC_PmStore(g_teller, "【教授】" + BOTC_NameStr(p) + " 复活了 " + BOTC_NameStr(seat) + "（" + BOTC_RoleNameSafe(real) + "）。");
    BOTC_SkillBtnRender();
}

// 复活之后恢复这个座位的一次性能力（百科明确写：连用过的「每局限一次」也恢复）
void BOTC_RestoreOneShot (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    g_limitedAsk[q] = false;
    g_poAsk[q] = false;
    g_skillRoleSel[q] = 0;
    g_declareUsed[g_who[q]] = false;           // 猎手：又能声称了（客户端口径 → 换成那个人的客户端号）
    g_moonClaimed[q] = false;                  // 月之子：复活后重新获得一次声称机会
    g_klutzClaimed[q] = false;                 // 呆瓜：复活后重新获得一次声称机会
    g_tokOn[(((g_teller * 14) + q) * 256) + 12] = false;         // 失去能力（猎手）
    g_tokOn[(((g_teller * 14) + q) * 256) + 17] = false;         // 失去能力（贞洁者）
    g_courtUsed[q] = false;                        // 侍臣：又能用一次
    g_profUsed[q] = false;                         // 教授自己（保险）
    // 【其余「一局一次」的能力也一起恢复】（用户 2026-10-14 报：刺客复活后刺杀没刷新）----
    //   以前这里只有猎手 / 贞洁者 / 侍臣 / 教授；刺客 / 弄臣 / 巡山人 / 解谜大师 / 女裁缝 / 僵怖 /
    //   沙巴洛斯 这一批都漏了，现在一并补上（口径：复活 = 重新进场，一次性能力全部恢复）。
    g_assiUsed[q] = false;                         // 刺客（41）：又能刺杀一次
    g_tokOn[(((g_teller * 14) + q) * 256) + 44] = false;         // 失去能力（教授）
    g_tokOn[(((g_teller * 14) + q) * 256) + 45] = false;         // 失去能力（刺客）
    g_tokOn[(((g_teller * 14) + q) * 256) + 47] = false;         // 失去能力（侍臣）
    g_foolUsed[q] = false;                         // 弄臣（34）：第一次免死恢复
    g_tokOn[(((g_teller * 14) + q) * 256) + 46] = false;         // 失去能力（弄臣）
    g_tokOn[(((g_teller * 14) + q) * 256) + 98] = false;         // 失去能力（巡山人 77）
    g_tokOn[(((g_teller * 14) + q) * 256) + 99] = false;         // 失去能力（工程师 78）
    g_tokOn[(((g_teller * 14) + q) * 256) + 130] = false;        // 已猜测（解谜大师 109）
    g_tokOn[(((g_teller * 14) + q) * 256) + 68] = false;         // 失去能力（女裁缝 55）
    g_tokOn[(((g_teller * 14) + q) * 256) + 145] = false;        // 已使用（鸩 124）：复活后重新获得一次机会
    g_tokOn[(((g_teller * 14) + q) * 256) + 147] = false;        // 已使用（守夜人 128）：复活后恢复一次机会
    g_zombUsed[q] = false;                         // 僵怖（43）：第一次不会死恢复
    g_sabRegurgDone[q] = false;                    // 沙巴洛斯（45）：一局一次的反刍恢复
    g_tokOn[(((g_teller * 14) + q) * 256) + 101] = false;        // 无法提名（魔像 81）：一局一次的提名恢复
    // 【方古（68）**不**在这里恢复】（用户 2026-10-14）：它的「限一次转化」是**整局全局**的效果 ----
    //   连之后上位的新方古也一样不能传刀，所以复活时不清 g_fangUsed / token 78。
    // ==========================================================================================
    // 【★ 登记处】（用户 2026-10-14 定的规矩）：以后凡是要新增「一局一次 / 限一次」的角色，
    //   一律在本函数（BOTC_RestoreOneShot）里把「用掉」的标记清掉 ----
    //   一般要清两样：① 那个角色自己的 bool 记账（例如 g_assiUsed / g_foolUsed）；
    //   ② 它用掉之后打在自己身上的那枚 token（例如 45 失去能力（刺客））。
    //   另一半（可声称 / 死亡触发那一批：猎手 / 造谣者 / 月之子 / 杂耍艺人 / 呆瓜）在
    //   BOTC_ClearDeath() 里，两处都要登记、都别漏。
    //   ⚠ 例外：**整局全局**的效果不刷（例如方古 68 的「限一次转化」，新方古也不能传刀）。
    // ==========================================================================================
    BOTC_FoolSync();                               // 弄臣：把「首次未死」标记重新点亮（46 已经在上面收掉了）
    BOTC_GrimRender(g_teller);
    // 【重新进场：首夜重新算】（用户 2026-09-20）：复活之后的下一个夜晚又算他的「首夜」----
    //   首夜信息位（洗衣妇 / 图管 / 调查员 / 厨师 / 祖母 / 教父...）可以再被唤醒一次、信息再给一次；
    //   祖母那种「你的首个夜晚」的能力也会重新挑一次孙子（旧 token 由 BOTC_NanaPick 清掉）。
    if (g_dayNum <= 0) {
        g_seatFirstNight[q] = 1;
    }
    else {
        g_seatFirstNight[q] = g_dayNum + 1;        // 下一个夜晚 = 他的新首夜
    }
    BOTC_PmStore(g_teller, "【复活】" + BOTC_NameStr(q) + " 的一次性能力已恢复。");
    // 【食人族（74）复活补发】（用户 2026-11-10）：食人族经教授 / 沙巴洛斯复活后，
    //   重新获得「最近一次死于处决的玩家」的能力；跨天也算，不再要求处决发生在当天。
    if (BOTC_HasAbility(q, 74) && g_cannFedSeat >= 2 && g_cannFedSeat <= 13) {
        if (BOTC_SeatTrueRole(g_cannFedSeat) >= 0 && BOTC_SeatTrueRole(g_cannFedSeat) <= 163) {
            g_cannPending = 1;
            g_cannRestore[q] = true;
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(q) + " 复活 → 下一夜重新获得最近一次处决者「" + BOTC_NameStr(g_cannFedSeat) + "」的能力。");
        }
    }
    BOTC_DeclareRender();
    BOTC_SkillBtnRender();
}

//==================================================================================================
// 【黯月初升 · 角色实现 第 4 批】（用户 2026-09-20）：31 吟游诗人 / 32 茶艺师 / 33 和平主义者
//==================================================================================================

// ■ 吟游诗人（31）：「当一名爪牙死于处决时，除了你和旅行者以外的所有其他玩家醉酒直到明天黄昏。」
//   被动角色，不唤醒；只挂在「处决」这一步上（处决尸体不算，因为那不是真的死）。
void BOTC_MinstrelCheck (int executed) {
    int i;
    int m;
    if (executed < 2 || executed > 13) {
        return;
    }
    m = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_AbilityWorks(i, 31)) {
            m = i;
        }
    }
    if (m < 2) {
        return;
    }
    if (BOTC_SeatDead(m)) {
        return;
    }
    // 【吟游诗人 × 间谍 / 陌客能力者】（用户 2026-11-12）：是否按爪牙处决由说书人裁定。
    if (BOTC_IsDisguiseAbility(executed)) {
        BOTC_JudgeAsk(15, "【吟游诗人】" + BOTC_NameStr(executed) + "（间谍 / 陌客能力者）被处决：这次是否按爪牙处决触发全员醉酒？", executed, m, 0);
        BOTC_PmStore(g_teller, "【吟游诗人】" + BOTC_NameStr(executed) + " 是间谍 / 陌客能力者 → 请选择是否按爪牙处决触发。");
        return;
    }
    if (!BOTC_RegIsMinion(executed)) {
        return;                                  // 必须是爪牙（按「互动干扰」那一层算）
    }
    // 【无神论者局 · 吟游诗人】（用户 2026-11-12）：场上存在无神论者时，
    //   爪牙被处决是否触发全员醉酒由说书人决定；选否就不触发。
    if (BOTC_AtheistOn()) {
        BOTC_JudgeAsk(2, "【吟游诗人】爪牙 " + BOTC_NameStr(executed) + " 被处决。无神论者在场，是否触发全员醉酒？", executed, m, 0);
        BOTC_PmStore(g_teller, "【吟游诗人】场上存在无神论者 → 请选择【是：触发】或【否：不触发】。");
        return;
    }
    BOTC_MinstrelApply(executed, m);
}

void BOTC_MinstrelApply (int executed, int m) {
    int i;
    if (executed < 2 || executed > 13 || m < 2 || m > 13) {
        return;
    }
    for (i = 0; i <= 13; i += 1) {
        g_minstrelDrunk[i] = false;
    }
    g_minstrelDay = g_dayNum;                     // 记住触发的那一天：要撑到「明天黄昏」
    for (i = 2; i <= 13; i += 1) {
        if (i == m || !g_seatOn[i] || BOTC_SeatDead(i)) {
            continue;
        }
        BOTC_WudTryTrigger(i, m);
        g_tokOn[(((g_teller * 14) + i) * 256) + 62] = true;     // 醉酒（吟游诗人）：到明天黄昏（用户 2026-09-20）
        g_minstrelDrunk[i] = true;                // 记号：这一份醉酒是吟游诗人的（当天黄昏不清）
    }
    g_tokOn[(((g_teller * 14) + m) * 256) + 50] = true;         // 全员醉酒（吟游诗人）标记
    g_minstrelDrunk[m] = true;                    // 吟游诗人自己也记一份（他那格是 50）
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【吟游诗人】爪牙 " + BOTC_NameStr(executed) + " 被处决 → 除了吟游诗人以外的所有其他玩家醉酒到明天黄昏。");
}

// ■ 茶艺师（32）：「与你邻近的两名存活的玩家是善良的 → 他们不会死亡。」（动态判定，只认真身）
bool BOTC_TeaLadyProtects (int q) {
    int i;
    int n1;
    int n2;
    if (q < 2 || q > 13) {
        return false;
    }
    for (i = 2; i <= 13; i += 1) {
        if (!BOTC_AbilityWorks(i, 32)) {
            continue;
        }
        if (BOTC_SeatDead(i) || BOTC_SeatImpaired(i)) {
            continue;
        }
        n1 = BOTC_EmpathNeighbor(i, -1);
        n2 = BOTC_EmpathNeighbor(i, 1);
        if (n1 < 2 || n2 < 2 || n1 == n2) {
            continue;
        }
        if (q != n1 && q != n2) {
            continue;
        }
        // 【间谍 / 陌客能力者邻居】（用户 2026-11-12）：是否保护由说书人弹窗裁定。
        if (BOTC_IsDisguiseAbility(q)) {
            return true;
        }
        if (BOTC_SeatRegAlign(n1) == 0 && BOTC_SeatRegAlign(n2) == 0) {   // 善良按「互动干扰」那一层
            return true;                         // 两个邻居都是善良 → 这两个人都不会死
        }
    }
    return false;
}

// 把「不会死亡（茶艺师）」标记刷新到该保护的人身上（天亮 / 黄昏 / 有人死之后各刷一次）
void BOTC_TeaLadySync () {
    int i;
    int k;
    int n1;
    int n2;
    int tl;
    int[14] on;
    for (i = 0; i <= 13; i += 1) {
        on[i] = 0;
    }
    for (k = 2; k <= 13; k += 1) {
        if (!BOTC_AbilityWorks(k, 32)) {
            continue;
        }
        if (BOTC_SeatDead(k) || BOTC_SeatImpaired(k)) {
            continue;
        }
        n1 = BOTC_EmpathNeighbor(k, -1);
        n2 = BOTC_EmpathNeighbor(k, 1);
        if (n1 < 2 || n2 < 2 || n1 == n2) {
            continue;
        }
        // 【间谍 / 陌客能力者邻居】（用户 2026-11-12）：不自动打「不会死亡（茶艺师）」。
        if (BOTC_IsDisguiseAbility(n1) || BOTC_IsDisguiseAbility(n2)) {
            continue;
        }
        if (BOTC_SeatRegAlign(n1) == 0 && BOTC_SeatRegAlign(n2) == 0) {   // 善良按「互动干扰」那一层
            BOTC_WudTryTrigger(n1, k);
            BOTC_WudTryTrigger(n2, k);
            on[n1] = 1;
            on[n2] = 1;
        }
    }
    for (i = 2; i <= 13; i += 1) {
        if (on[i] != 0) {
            if (!g_tokOn[(((g_teller * 14) + i) * 256) + 51]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 51] = true;
            }
        }
        else {
            if (g_tokOn[(((g_teller * 14) + i) * 256) + 51]) {
                g_tokOn[(((g_teller * 14) + i) * 256) + 51] = false;
            }
        }
    }
    BOTC_GrimRender(g_teller);
}

// ■ 和平主义者（33）：「被处决的善良玩家可能不会死亡。」
//   **只有智能说书**才会自动掷（用户 2026-09-20）：掷中就在目标身上打「处决不死（和平主义者）」token(28)，
//   紧接着那条「处决不死」分支会把这次处决挡掉（公屏只播中性那句，原因写说书人私聊）。
//   真人说书**不掷**：想保谁就自己在他身上打「处决不死（和平主义者）」token，再点处决。
bool BOTC_PacifistSave (int q) {
    int i;
    int pf;
    int chance;
    int nextChance;
    if (q < 2 || q > 13) {
        return false;
    }
    return false;                            // 真人说书：不掷（自己打 token）
    pf = 0;
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_AbilityWorks(i, 33)) {
            pf = i;
        }
    }
    if (pf < 2) {
        return false;
    }
    if (BOTC_SeatDead(pf) || BOTC_SeatImpaired(pf)) {
        return false;
    }
    if (BOTC_SeatRegAlign(q) != 0) {
        BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(q) + " 按互动干扰算不是善良 → 这一次不判定。");
        return false;
    }
    // 概率（用户 2026-09-20）：**30% 起，每成功发动一次就 -10%，最低 5%**（30 → 20 → 10 → 5 → 5 ...）
    chance = 30 - (g_pacifistUsed * 10);
    if (chance < 5) {
        chance = 5;                              // 最低 5%：不会再往下掉（用户 2026-09-20）
    }
    if (RandomInt(1, 100) <= chance) {
        g_pacifistUsed = g_pacifistUsed + 1;
        nextChance = 30 - (g_pacifistUsed * 10);
        if (nextChance < 5) {
            nextChance = 5;
        }
        // 判定成功：自动给他打「处决不死（和平主义者）」标记（用户 2026-09-20）
        g_tokOn[(((g_teller * 14) + q) * 256) + 28] = true;
        BOTC_GrimRender(g_teller);
        BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(pf) + " 让被处决的 " + BOTC_NameStr(q) + " 活了下来。");
        return true;
    }
    BOTC_PmStore(g_teller, "【和平主义者】" + BOTC_NameStr(pf) + " 这次没有保住 " + BOTC_NameStr(q) + "，照常处决。");
    return false;
}

