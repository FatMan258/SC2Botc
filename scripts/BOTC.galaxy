            g_boffinDoneBy[(i * 14) + j] = false;
            g_bnestDoneBy[(i * 14) + j] = false;
        }
    }
    // 【换局清空全部观察者 token 行】（用户 2026-10-26）：
    //   以前 BOTC_Deal 只清当前 g_teller 那一行；手动配板则一行都没彻底清。
    //   换过说书人后旧行里的死亡 token 会在下一局重新被读到，表现为有人一开局就死、
    //   只能投死人票。这里一次性清空 14×14×256 的全部 token。
    for (i = 0; i <= 13; i += 1) {
        for (j = 0; j <= 13; j += 1) {
            for (k = 0; k < 256; k += 1) {
                g_tokOn[(((i * 14) + j) * 256) + k] = false;
            }
        }
    }
    // 「观察者 × 座位」的登记缓存：全部作废（重新发牌之后按新身份重掷）
    for (i = 0; i <= 13; i += 1) {
        for (j = 2; j <= 13; j += 1) {
            g_pairTeam[(i * 14) + j] = -1;
            g_pairAlign[(i * 14) + j] = -1;
            g_pairSeen[(i * 14) + j] = -2;
            g_pairImp[(i * 14) + j] = -1;
            g_pairRole[(i * 14) + j] = -2;
            g_pairSubImp[(i * 14) + j] = -1;
        }
    }
    g_started = false;
    g_gameOver = false;
    g_execUsedToday = false;
    g_phase = 0;
    g_dayNum = 0;
    g_nightNum = 0;
    for (i = 0; i <= 13; i += 1) {
        g_seatFirstNight[i] = 1;
    }
    BOTC_PsyRpsClear();          // 新局 / 取消开局：猜拳状态和面板一起清掉
    BOTC_AutoWakeReset();
}

void BOTC_GameStartCancel () {
    // 还在 10 秒倒计时里（还没真的开始）：撤掉倒计时、把发牌按钮放回来，别的什么都不用还原
    if (g_startPending && !g_started) {
        BOTC_StartCdStop();
        g_startPending = false;
        BOTC_DissolveAllSess(false);     // 取消正式开始：连说书人的私聊一起强制结束
        BOTC_ClearAllLogs();
        // 【先收夜间唤醒弹窗】（用户 2026-11-07）：玩家技能面板 / 说书人夜间弹窗全部关闭
        BOTC_WakePopupsCloseAll();
        // 【全场魔典一起清】（用户 2026-11-06）：连说书人真值行也清，角色标记和 token 全归零
        BOTC_GrimClearAllRows();
        g_dealConfirmed = false;
        g_swapUnlocked = true;      // 【取消正式开始 → 放回"换座位"按钮】（用户 2026-10-07）
        BOTC_PlaySfx(g_sfxStartName);
        libNtve_gf_SetDialogItemText(g_grimStart, StringToText("游戏正式开始"), PlayerGroupSingle(g_teller));
        BOTC_NomUI();
        BOTC_Notice(g_teller, "已撤掉正式开始：倒计时取消了，还没进夜晚。【换座位】按钮已放回。全场魔典已清空，请重新发牌。");
        return;
    }
    if (!g_started) {
        return;
    }
    BOTC_ResetGameVars();          // 换局：回到准备阶段，先把上一局的记录清干净
    g_started = false;
    g_startPending = false;
    BOTC_StartCdStop();            // 正式开始那个 10 秒倒计时要是还在演，一起收掉
    // 取消正式开始 = 回到「还没开始」：天数 / 夜数计数一起归零
    //   （不然重新正式开始时会从「第 5 夜」这种数字接着算，日志里的时段标记也会乱）
    g_dayNum = 0;
    g_nightNum = 0;
    BOTC_AutoWakeReset();
    // 取消正式开始（含结算页【重新开始】）：所有私聊房间强制结束，包括说书人自己开的
    BOTC_DissolveAllSess(false);
    // 回到「还没开始」：发言时段也回到默认的公聊（用户 2026-09-17）
    g_chatMode = 2;
    BOTC_ChatBtnRender();
    // 【取消正式开始也清日志】（用户 2026-11-02）：正开始 / 取消开始两条路径都清一次。
    BOTC_ClearAllLogs();
    // 【取消正式开始 = 回到刚进游戏的状态】（用户 2026-11-07）：死亡、已读、留存尸体等
    //   全部由上面的 BOTC_ResetGameVars() 复位；这里先把玩家和说书人还开着的夜间唤醒弹窗
    //   全部静默收起，再把两边的魔典一起清空，所有身份标记、token、红叉、复盘快照一起归零。
    BOTC_WakePopupsCloseAll();
    BOTC_GrimClearAllRows();
    // 【说书人点座位标记模式也复位】（用户 2026-11-07）：取消开始时如果正停在「处决中 / 死亡中」，
    //   退出该模式并把按钮文字还原，和刚进游戏时一致，避免下一局还挂着上一次的标记状态。
    g_execPick = false;
    g_deadPick = false;
    BOTC_BigHintHide(0);
    libNtve_gf_SetDialogItemText(g_execBtn, StringToText("处决标记"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_deadBtn, StringToText("死亡标记"), PlayerGroupSingle(g_teller));
    g_dealConfirmed = false;
    libNtve_gf_SetDialogItemText(g_grimStart, StringToText("游戏正式开始"), PlayerGroupSingle(g_teller));
    // 上一把的胜利 BGM 到这里才收掉（面板关掉后它一直放着），紧接着换回准备阶段那首
    BOTC_MusicStop();
    BOTC_MusicStart();             // 退回「还没正式开始」：背景音乐接着放
    BOTC_PeriodRecord("---- 说书人取消了正式开始 ----");
    BOTC_Notice(g_teller, "已取消正式开始：全场魔典（含说书人）已清空，请重新发牌或手动标记身份。");
    g_herringLock = false;
    BOTC_ClaimBtnRender();
    BOTC_SkillBtnRender();
    BOTC_DeclareRender();
    BOTC_NomUI();
}

void BOTC_BuildNight () {
    int i;
    // 屏幕正上方的昼夜按钮（只有说书人看得到）
    DialogCreate(240, 40, c_anchorTopLeft, 840, 8, false);
    g_nightBtnDlg = DialogLastCreated();
    DialogSetVisible(g_nightBtnDlg, PlayerGroupAll(), false);
    g_nightBtn = BOTC_NewButton(g_nightBtnDlg, 240, 40, 0, 0, "进入夜晚");

    // 【聊天：公聊 / 私聊】（用户 2026-09-19）：放在【进入夜晚】左边，所有玩家都有自己一份
    //   点一下切换：私聊模式下回车打的内容直接进自己那条私聊，公聊模式就是正常公聊。
    for (i = 1; i <= 13; i += 1) {
        // 【加宽】（用户 2026-11-01）：240 宽放不下「聊天：公聊（Tab切换）」→ 320 宽，右边缘仍对齐 840
        DialogCreate(320, 40, c_anchorTopLeft, 520, 8, false);
        g_sayBtnDlg[i] = DialogLastCreated();
        DialogSetVisible(g_sayBtnDlg[i], PlayerGroupAll(), false);
        g_sayBtnP[i] = BOTC_NewButton(g_sayBtnDlg[i], 320, 40, 0, 0, "聊天：公聊（Tab切换）");
        // 【取消金色描边】（用户 2026-11-01）
        DialogSetVisible(g_sayBtnDlg[i], PlayerGroupSingle(i), true);
    }
    DialogSetVisible(g_nightBtnDlg, PlayerGroupSingle(g_teller), false);   // 正式开始之后才由 NomUI 放出来

    // 昼夜按钮右侧：提名环节开关（同样只有说书人看得到）
    DialogCreate(240, 40, c_anchorTopLeft, 1090, 8, false);
    g_nomBtnDlg = DialogLastCreated();
    DialogSetVisible(g_nomBtnDlg, PlayerGroupAll(), false);
    g_nomBtn = BOTC_NewButton(g_nomBtnDlg, 240, 40, 0, 0, "进入提名环节");
    DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), false);

    // 【切换板子】（用户 2026-09-20）：正式开始之前，说书人点它重新走一遍选板子页面
    DialogCreate(240, 40, c_anchorTopLeft, 1340, 8, false);
    g_bsBtnDlg = DialogLastCreated();
    DialogSetVisible(g_bsBtnDlg, PlayerGroupAll(), false);
    g_bsBtn = BOTC_NewButton(g_bsBtnDlg, 240, 40, 0, 0, "切换板子");
    DialogSetVisible(g_bsBtnDlg, PlayerGroupSingle(g_teller), false);
    // 【换说书人】（用户 2026-10-06）：「切换板子」**左边**那颗（x = 1340 - 250）
    DialogCreate(240, 40, c_anchorTopLeft, 1090, 8, false);
    g_tsBtnDlg = DialogLastCreated();
    DialogSetVisible(g_tsBtnDlg, PlayerGroupAll(), false);
    g_tsBtn = BOTC_NewButton(g_tsBtnDlg, 240, 40, 0, 0, "换座位");   // 【换座位】（用户 2026-10-07，替掉原来的【换说书人】）
    DialogSetVisible(g_tsBtnDlg, PlayerGroupSingle(g_teller), false);
    // 【测试·换座位】（用户 2026-10-09 发布版**已隐藏**）：位置留在 (600, 96)（原来 (840,8) 会压住【进入白天/夜晚】），想恢复就把下面 4 处可见性改回 true。
    //   现在放在 (600, 96)：左边空档（聊天面板右边、魔典左边）、又在【开局前提示】红字下面，跟任何控件都不重叠。
    //   点按钮 → 点两个玩家格 = 互换这两格（可以点「说书人」那一格）。
    DialogCreate(240, 40, c_anchorTopLeft, 600, 96, false);
    g_swapDlg = DialogLastCreated();
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);          // 【测试·换座位】发布版隐藏（用户 2026-10-09）；想恢复就把这 4 处改回 true
    g_swapBtn = BOTC_NewButton(g_swapDlg, 240, 40, 0, 0, "测试·换座位");
    DialogSetVisible(g_swapDlg, PlayerGroupAll(), false);

    // 提名按钮右侧：聊天时段切换（自由 → 公聊 → 私聊 循环），同样只有说书人看得到
    DialogCreate(240, 40, c_anchorTopLeft, 1340, 8, false);
    g_chatBtnDlg = DialogLastCreated();
    DialogSetVisible(g_chatBtnDlg, PlayerGroupAll(), false);
    g_chatBtn = BOTC_NewButton(g_chatBtnDlg, 240, 40, 0, 0, "进入私聊阶段");
    DialogSetVisible(g_chatBtnDlg, PlayerGroupSingle(g_teller), false);

    // 【邪恶小窗】开关（说书人）：正式开始之后的白天才显示（NomUI 按昼夜切）
    DialogCreate(240, 40, c_anchorTopLeft, 1680, 58, false);
    g_evilBtnDlg = DialogLastCreated();
    DialogSetVisible(g_evilBtnDlg, PlayerGroupAll(), false);
    g_evilBtn = BOTC_NewButton(g_evilBtnDlg, 240, 40, 0, 0, "邪恶小窗：关");

    // 【快进到提名】（用户 2026-09-16 定稿，就在屏幕上方这个老位置）：
    //   · 玩家 2..13：一个**能按的按钮**「快进到提名 N/M」
    //   · 说书人：**只有一行字**「快进提名票数 N/M」---- 没有按钮、没有边框（跟聊天框一样透明），
    //     他看得到票数，但快不快进由他自己点【进入提名环节】决定
    DialogCreate(190, 40, c_anchorTopLeft, 1585, 8, false);
    g_skipDlg = DialogLastCreated();
    DialogSetVisible(g_skipDlg, PlayerGroupAll(), false);
    g_skipBtn = BOTC_NewButton(g_skipDlg, 190, 40, 0, 0, "快进到提名 0/0");
    DialogControlSetVisible(g_skipBtn, PlayerGroupAll(), true);   // 【给谁看】由 BOTC_SkipRender 按当时的 g_teller 决定（用户 2026-10-09）
    g_skipLbl = BOTC_NewLabel(g_skipDlg, 190, 26, 4, 8, StringToText("快进提名票数 0/0"));
    libNtve_gf_SetDialogItemStyle(g_skipLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_skipLbl, false, PlayerGroupAll());
    DialogControlSetVisible(g_skipLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_skipLbl, PlayerGroupSingle(g_teller), true);
    BOTC_SkipRender();             // 正式开局前 / 夜里 / 提名阶段会自动收起

    g_isNight = false;
    // 开局先用白天光照，保证和按钮上的"进入夜晚"一致
    GameSetLighting("Agria", 0.0);
}

// 【添加传奇 / 奇遇角色】的按钮和面板（用户 2026-11-06）：
//   对话框按创建先后分层，后建的在上。这颗按钮和弹窗原来建在 BOTC_BuildNight 里，
//   比魔典（BOTC_BuildGrim）早，所以弹窗一直被魔典压住。
//   现在单独放到 BOTC_Init 最末尾创建，保证它压在魔典、日志和帮助面板之上。
void BOTC_BuildLegacyPanel () {
    int i;
    DialogCreate(240, 40, c_anchorTopLeft, 1590, 8, false);
    g_legBtnDlg = DialogLastCreated();
    DialogSetVisible(g_legBtnDlg, PlayerGroupAll(), false);
    g_legBtn = BOTC_NewButton(g_legBtnDlg, 240, 40, 0, 0, "添加传奇角色");
    DialogSetVisible(g_legBtnDlg, PlayerGroupSingle(g_teller), false);
    DialogCreate(600, 320, c_anchorTopLeft, 1340, 56, false);
    g_legPanel = DialogLastCreated();
    DialogSetVisible(g_legPanel, PlayerGroupAll(), false);
    g_legTitle = BOTC_NewLabel(g_legPanel, 560, 34, 20, 10, StringToText("添加传奇 / 奇遇角色（本板子带的）"));
    for (i = 0; i < 4; i += 1) {
        g_legRowName[i] = BOTC_NewLabel(g_legPanel, 300, 40, 20, 56 + (i * 56), StringToText(""));
        g_legRowBtn[i] = BOTC_NewButton(g_legPanel, 240, 40, 330, 56 + (i * 56), "");
        g_legRowRole[i] = -1;
    }
    g_legClose = BOTC_NewButton(g_legPanel, 160, 40, 20, 268, "关闭");
}

// 全图视野：显示整张地图（真视野，亮色）+ 迷雾透明
void BOTC_RevealAll () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        VisRevealArea(p, RegionEntireMap(), 0.0, false);
        VisSetFoWAlpha(p, 0.0);
    }
}

// 【银色圆角外框】（用户 2026-11-01）：4 条银色直边 + 4 个圆角角块。
//   角块半径 20，所以直边从 20 开始、两端让出 20（总长 = w/h - 40），跟角块首尾接上。
void BOTC_FrameSilver (int d, int w, int h) {
    BOTC_NewImageItem(d, w - 40, 3, 20, 0, "botc_frame_silver.dds");
    BOTC_NewImageItem(d, w - 40, 3, 20, h - 3, "botc_frame_silver.dds");
    BOTC_NewImageItem(d, 3, h - 40, 0, 20, "botc_frame_silver.dds");
    BOTC_NewImageItem(d, 3, h - 40, w - 3, 20, "botc_frame_silver.dds");
    BOTC_NewImageItem(d, 24, 24, 0, 0, "botc_corner_tl.dds");
    BOTC_NewImageItem(d, 24, 24, w - 24, 0, "botc_corner_tr.dds");
    BOTC_NewImageItem(d, 24, 24, 0, h - 24, "botc_corner_bl.dds");
    BOTC_NewImageItem(d, 24, 24, w - 24, h - 24, "botc_corner_br.dds");
}

// 公聊窗 / 私聊窗下面那两块黑底：单独两个对话框（尺寸和窗口一模一样，铺 botc_black.dds）
//   ⚠ 必须建在 BOTC_BuildChat / BOTC_BuildPmBox **之前** ---- 对话框按创建先后分层，
//     建晚了就会盖在文字上面。
//   透明度走对话框自己的 DialogSetTransparency（值越大越透明；想改就聊天里发 bg <数字>）
void BOTC_BuildChatBackdrop () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        // 私聊窗那块（紧挨私聊面板正下方：左上 10,514，900x218 ---- 10 行 × 21 + 8）
        DialogCreate(900, 302, c_anchorTopLeft, 10, 320, false);
        g_pmBgDlg[p] = DialogLastCreated();
        DialogSetVisible(g_pmBgDlg[p], PlayerGroupAll(), false);
        DialogSetImage(g_pmBgDlg[p], "botc_black.dds");
        DialogSetImageVisible(g_pmBgDlg[p], true);
        DialogSetTransparency(g_pmBgDlg[p], IntToFixed(g_chatAlpha));
        // 私聊窗外框：银色圆角（用户 2026-11-01），单独一层
        DialogCreate(908, 310, c_anchorTopLeft, 6, 316, false);
        g_pmFrameDlg[p] = DialogLastCreated();
        DialogSetImageVisible(g_pmFrameDlg[p], false);
        DialogSetVisible(g_pmFrameDlg[p], PlayerGroupAll(), false);
        BOTC_FrameSilver(g_pmFrameDlg[p], 908, 310);
        // 公聊窗那块（左下 10,10，900x554 ---- 26 行 × 21 + 8）
        DialogCreate(900, 554, c_anchorBottomLeft, 10, 10, false);
        g_chatBgDlg[p] = DialogLastCreated();
        DialogSetVisible(g_chatBgDlg[p], PlayerGroupAll(), false);
        DialogSetImage(g_chatBgDlg[p], "botc_black.dds");
        DialogSetImageVisible(g_chatBgDlg[p], true);
        DialogSetTransparency(g_chatBgDlg[p], IntToFixed(g_chatAlpha));
        // 公聊窗外框：银色圆角（用户 2026-11-01），单独一层（不跟着黑底透明度变化，始终清晰）
        DialogCreate(908, 562, c_anchorBottomLeft, 6, 6, false);
        g_chatFrameDlg[p] = DialogLastCreated();
        DialogSetImageVisible(g_chatFrameDlg[p], false);
        DialogSetVisible(g_chatFrameDlg[p], PlayerGroupAll(), false);
        BOTC_FrameSilver(g_chatFrameDlg[p], 908, 562);
    }
}

// 把当前的 g_chatAlpha 应用到底图那两块对话框上（默认值在 BOTC_GrimInitData 里设，
//   所以要在它之后再调一次；聊天指令 bg <数字> 也走这个）
void BOTC_ChatBgApply () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (g_chatBgDlg[p] != 0) {
            DialogSetTransparency(g_chatBgDlg[p], IntToFixed(g_chatAlpha));
        }
        if (g_pmBgDlg[p] != 0) {
            DialogSetTransparency(g_pmBgDlg[p], IntToFixed(g_chatAlpha));
        }
    }
}

void BOTC_BuildChat (int p) {
    int i;
    // 公聊窗：26 行、行高 21，高度 = 26*21 + 8 = 554（用户 2026-09-19：直接铺满到说书人面板下面）
    DialogCreate(900, 554, c_anchorBottomLeft, 10, 10, false);
    g_chatDlg[p] = DialogLastCreated();
    DialogSetVisible(g_chatDlg[p], PlayerGroupAll(), false);
    for (i = 0; i < 26; i += 1) {
        g_chatRow[(p * 26) + i] = BOTC_NewLabel(g_chatDlg[p], 872, 21, 14, 4 + (i * 21), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_chatRow[(p * 26) + i], "ModLeftSize20Bold", PlayerGroupSingle(p));
    }
    // 这个窗口自己没有底图：黑底是 BOTC_BuildChatBackdrop 里那个单独的对话框（在它下面一层）
    DialogSetImageVisible(g_chatDlg[p], false);
    DialogSetVisible(g_chatDlg[p], PlayerGroupSingle(p), true);
    DialogSetVisible(g_chatBgDlg[p], PlayerGroupSingle(p), true);
    DialogSetVisible(g_chatFrameDlg[p], PlayerGroupSingle(p), true);
}

void BOTC_BuildPmBox (int p) {
    int i;
    // 私聊窗：紧贴说书人面板下沿（左上 10,320），14 行、行高 21，高度 = 14*21 + 8 = 302
    DialogCreate(900, 302, c_anchorTopLeft, 10, 320, false);
    g_pmDlg[p] = DialogLastCreated();
    DialogSetVisible(g_pmDlg[p], PlayerGroupAll(), false);
    for (i = 0; i < 14; i += 1) {
        g_pmRow[(p * 14) + i] = BOTC_NewLabel(g_pmDlg[p], 872, 21, 14, 4 + (i * 21), StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_pmRow[(p * 14) + i], "ModLeftSize20Bold", PlayerGroupSingle(p));
    }
    DialogSetImageVisible(g_pmDlg[p], false);
    DialogSetVisible(g_pmDlg[p], PlayerGroupSingle(p), true);
    DialogSetVisible(g_pmBgDlg[p], PlayerGroupSingle(p), true);
    DialogSetVisible(g_pmFrameDlg[p], PlayerGroupSingle(p), true);
}

//--------------------------------------------------------------------------------------------------
// 魔典：数据初始化
//--------------------------------------------------------------------------------------------------
// 角色提示面板的文案表（能力 / 简介 / 规则细节 + 三段通用文案）
//   数据来源：clocktower-wiki 的暗流涌动角色页；换板子/加角色只补这里
//   ⚠ 单独一个函数：长字符串堆在 GrimInitData 里会把编译器搞出「内部编译器错误」
void BOTC_InitRoleTexts () {
    // 角色提示面板文案：每行已切成「普通段 + 关键词彩色段」的 text（生成时做好，运行时不再切）
    g_tipLine[0] = StringToText("【角色能力】");
    g_tipLine[1] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色。");
    g_tipLine[2] = StringToText("【角色简介】");
    g_tipLine[3] = TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[4] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会被唤醒，得知两名玩家，并得知其中一人的角色。");
    g_tipLine[5] = StringToText("· ") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[6] = StringToText("【规则细节】");
    g_tipLine[7] = StringToText("· 不同于") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("和") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("永远不可能得知没有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("在场。在极端情况下（如5人局且有") + TextWithColor(StringToText("男爵"), Color(255, 69, 0)) + StringToText("在场时），") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("会得知自己");
    g_tipLine[8] = StringToText("与任意一名玩家之中有") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("，但这在大部分情况下也等同于明示") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("有") + TextWithColor(StringToText("男爵"), Color(255, 69, 0)) + StringToText("在场了。因此如果这种情形可能发生，说书人也应该调整");
    g_tipLine[9] = StringToText("角色配置让本局游戏更加有趣一些。");
    g_tipLine[10] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或醉酒，") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("标记的玩家），或得知错误的角色，或两者兼而有之。但");
    g_tipLine[11] = StringToText("即使如此，说书人也应该让") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，否则等同于在明示") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("她自己醉酒") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，且给出的信息也不符合") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("应该获取的");
    g_tipLine[12] = StringToText("信息内容。");
    g_tipLine[13] = StringToText("· 特定角色互动： ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("洗衣妇"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("当作") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，并得知") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[14] = StringToText("【角色能力】");
    g_tipLine[15] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场）。");
    g_tipLine[16] = StringToText("【角色简介】");
    g_tipLine[17] = TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[18] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("会得知两名玩家其中一人的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[19] = StringToText("· ") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[20] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("是") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("。如果") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("得知两名玩家中有") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("，他不会得知") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩家以为的那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[21] = StringToText("【规则细节】");
    g_tipLine[22] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或醉酒，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置他的提示标记的玩家），或得知错误的角色，或两者兼而有");
    g_tipLine[23] = StringToText("之。但即使如此，说书人也应该让") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，否则等同于在明示") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("他自己醉酒") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("了，且给出的信息也不符合");
    g_tipLine[24] = TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("应该获取的信息内容。");
    g_tipLine[25] = StringToText("· 因为给出「0」这样的信息也在") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("的合理信息范围内，因此醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("在某些情况下，说书人也可以给出「0");
    g_tipLine[26] = StringToText("」这样的信息以进行信息混淆。（如场上有") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("，但本剧本中还含有哨兵的时候，玩家将无法确信场上是否有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("）但大部分时候，在");
    g_tipLine[27] = StringToText("很容易能确定场上有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的场合下给出「0」这样的信息，基本上等同于明示") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("醉酒了。");
    g_tipLine[28] = StringToText("· 特定角色互动： ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：在仅有一名") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("且为") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("的情况下，") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("可能会将") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("当作非") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，从而得知没有") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在");
    g_tipLine[29] = StringToText("场。 ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("：") + TextWithColor(StringToText("图书管理员"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("当作") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，并得知") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色。");
    g_tipLine[30] = StringToText("【角色能力】");
    g_tipLine[31] = StringToText("在你的首个夜晚，你会得知两名玩家和一个") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色：这两名玩家之一是该角色（或者你会得知没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场）。");
    g_tipLine[32] = StringToText("【角色简介】");
    g_tipLine[33] = TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("会得知一个特定的在场") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，但不知道是谁在扮演该角色。");
    g_tipLine[34] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("会得知两名玩家其中一人的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[35] = StringToText("· ") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("只会得知一次信息，之后便无法获取更多信息。");
    g_tipLine[36] = StringToText("【规则细节】");
    g_tipLine[37] = StringToText("· 在仅有一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("且为") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("的情况下，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("可能会将") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("当作非") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，从而得知没有") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场。这种情况下，实际上也与「得知");
    g_tipLine[38] = StringToText("两名玩家其中之一是") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("」相似（因为基本上不可能存在初始没有任何") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("在场的情况），但相对来说") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("在得知「0」的时候会对谁");
    g_tipLine[39] = StringToText("是") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("这一事实毫无头绪。");
    g_tipLine[40] = StringToText("· 由于麻脸巫婆这样的角色存在，很有可能出现某局游戏进行到一半时没有任何") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色在场，此时有新的") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("产生时，也会因此得");
    g_tipLine[41] = StringToText("知「0」。");
    g_tipLine[42] = StringToText("· 如果在首夜就") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("或醉酒，") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("可能会得知错误的玩家（没有放置他的提示标记的玩家），或得知错误的角色，或两者兼而有之。");
    g_tipLine[43] = StringToText("但即使如此，说书人也应该让") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("得知") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色，否则等同于在明示") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("他自己醉酒") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，且给出的信息也不符合") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("应该获取的");
    g_tipLine[44] = StringToText("信息内容。");
    g_tipLine[45] = StringToText("· 特定角色互动： ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("：") + TextWithColor(StringToText("调查员"), Color(0, 191, 255)) + StringToText("能将") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("当作") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，并得知") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("和任意其他玩家之中有一个任意") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色。");
    g_tipLine[46] = StringToText("· 相克规则：");
    g_tipLine[47] = StringToText("【角色能力】");
    g_tipLine[48] = StringToText("在你的首个夜晚，你会得知场上邻座的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家有多少对。");
    g_tipLine[49] = StringToText("【角色简介】");
    g_tipLine[50] = TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会得知是否有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家相邻而坐。");
    g_tipLine[51] = StringToText("· 在第一个夜晚，") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会得知有多少对") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家相邻而坐。两名相邻而坐的玩家为一对，然而每名玩家都能分别与两侧的玩家各组成一");
    g_tipLine[52] = StringToText("对。因此，两名相邻而坐的玩家是一对，三名相邻而坐的玩家是两对，四名相邻而坐的玩家是三对，以此类推。");
    g_tipLine[53] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("会像探查其他角色类型一样探查") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("旅行者，但仅仅只会关注那些在") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("行动前加入游戏的旅行者。");
    g_tipLine[54] = StringToText("【规则细节】");
    g_tipLine[55] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的单次能力会为玩家进行多次检测判断。因此具有互动干扰类能力的角色可能会在与其左右相邻的玩家组合中被当作不同的阵营");
    g_tipLine[56] = StringToText("。但通常来说，我们建议按照在") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的单次能力探查中始终保持同一阵营来进行判断，以提升") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("玩家的游戏体验。毕竟，不仅互动干扰");
    g_tipLine[57] = StringToText("能力会影响") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的结果，醉酒和") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("也会。");
    g_tipLine[58] = StringToText("· ") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("的能力探查的是相邻玩家，且并未加「存活」这一附加条件。在游戏中途产生的") + TextWithColor(StringToText("厨师"), Color(0, 191, 255)) + StringToText("，获取到的信息仍然会考虑仍然在游戏中的");
    g_tipLine[59] = StringToText("所有玩家（已经提前离开游戏的旅行者则不算在内）。");
    g_tipLine[60] = StringToText("【角色能力】");
    g_tipLine[61] = StringToText("每个夜晚，你会得知与你邻近的两名存活的玩家中") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家的数量。");
    g_tipLine[62] = StringToText("【角色简介】");
    g_tipLine[63] = TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("会持续得知与自己邻近的玩家是否为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[64] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("只会得知与自己邻近的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家数量，但不会得知具体哪一名玩家是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[65] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("不会探查已死亡的玩家。因此，如果") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("与一位已死亡玩家相邻，他不会获取到有关死亡玩家的任何信息。取而代之的是，");
    g_tipLine[66] = StringToText("他会获取与那位死亡玩家同一方向上最近的存活玩家的信息。");
    g_tipLine[67] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后行动，因此如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死了") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("邻近玩家之一，") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("不会得知有关那位现在已死的玩家的信息。") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("的信息");
    g_tipLine[68] = StringToText("以当晚黎明时的状态为基准，而非黄昏。");
    g_tipLine[69] = StringToText("【规则细节】");
    g_tipLine[70] = StringToText("· ") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("得知的信息是当晚黎明时的状况，而非黄昏时的，因此在当晚复活的角色（通常会是在") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("行动之前复活），也可能会因为");
    g_tipLine[71] = StringToText("成为与") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("邻近的存活玩家，从而影响") + TextWithColor(StringToText("共情者"), Color(0, 191, 255)) + StringToText("获取的信息。");
    g_tipLine[72] = StringToText("【角色能力】");
    g_tipLine[73] = StringToText("每个夜晚，你要选择两名玩家：你会得知他们之中是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。 会有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家始终被你的能力当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[74] = StringToText("【角色简介】");
    g_tipLine[75] = TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("能探查谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，但某些时候也会误以为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[76] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("需要选择两名玩家，得知其中是否有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。他不会得知具体哪一名玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，只知道两名玩家之中有") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果");
    g_tipLine[77] = StringToText("两名玩家均不是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他会得知「否」。");
    g_tipLine[78] = StringToText("· 不幸的是，会有一名被称作「干扰项」的玩家，会被") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("在选中时当作") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。「干扰项」在一整场游戏中只会是同一名玩家。这名");
    g_tipLine[79] = StringToText("玩家可以是任何") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，甚至是") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("自己。") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("不会知道哪一名玩家是他的「干扰项」。");
    g_tipLine[80] = StringToText("· ") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("可以选择任意两名玩家----无论他们存活与否，甚至可以选择自己。如果") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("选中了已死亡的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，仍然会得知「是」。");
    g_tipLine[81] = StringToText("【规则细节】");
    g_tipLine[82] = StringToText("· 虽然在") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的角色详解中提及了「'干扰项'在一整场游戏中只会是同一名玩家」，但这是由于在暗流涌动中不会出现阵营转变效");
    g_tipLine[83] = StringToText("果而导致的。不去介绍更深层次的规则仅仅只是不希望玩家在一开始就因为接收到过于复杂的规则而变得迷惑（正常来说，玩家需要进入");
    g_tipLine[84] = StringToText("到梦殒春宵后才会接触到阵营转变的效果）。实际上，") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的能力包含了动态检测效果，一旦被他标记为「干扰项」的那名玩家变为邪");
    g_tipLine[85] = StringToText("恶阵营，说书人就需要重新选择另一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家并放置「干扰项」标记。但只要被标记为「干扰项」的玩家阵营没有发生变化，那么他就");
    g_tipLine[86] = StringToText("始终都会是「干扰项」。这种情况其实与得知寡妇在场的玩家变为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营后，会重新有一名") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家得知寡妇在场是类似的。");
    g_tipLine[87] = StringToText("· 虽然在绝大部分情况下这并没有什么用，但是以为自己是") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("因为不具有") + TextWithColor(StringToText("占卜师"), Color(0, 191, 255)) + StringToText("的能力，也就因此不会有「干扰项」这个标");
    g_tipLine[88] = StringToText("记。提线木偶同理。");
    g_tipLine[89] = StringToText("· 特定角色互动：");
    g_tipLine[90] = StringToText("【角色能力】");
    g_tipLine[91] = StringToText("每个夜晚*，你会得知今天白天死于处决的玩家的角色。");
    g_tipLine[92] = StringToText("【角色简介】");
    g_tipLine[93] = TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会得知当天因处决而死亡的角色。");
    g_tipLine[94] = StringToText("· 只有死于处决的玩家才会被") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("得知是哪一种角色。在白天因为其他原因造成的死亡，例如枪手杀死的玩家，或对旅行者的流放，");
    g_tipLine[95] = StringToText("不算在内。");
    g_tipLine[96] = StringToText("· ") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会在除首个夜晚以外的每晚醒来，因为在首个夜晚之前不会有任何处决发生。");
    g_tipLine[97] = StringToText("· 如果当天没有玩家死亡，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("不会得知任何消息。说书人在夜晚时要么不唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，要么唤醒他但并不对他展示角色标记。");
    g_tipLine[98] = StringToText("· 如果") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("被处决，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("会被展示") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("标记，而非那名") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩家以为自己是的那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("标记。");
    g_tipLine[99] = StringToText("【规则细节】");
    g_tipLine[100] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("可能不会被唤醒，也可能会被唤醒但不得知任何消息。说书人可以自行决定");
    g_tipLine[101] = StringToText("并提前告知玩家本场游戏将以何种方式运作。然而，不论是否唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，都不应该对侍女获得的消息产生影响。（即：如果说书人决定");
    g_tipLine[102] = StringToText("不唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，那么无论实际操作中是否唤醒") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("，侍女都不应探查到") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("被唤醒，反之亦然。）");
    g_tipLine[103] = StringToText("· 如果白天无人被处决，或发生了处决但无人死亡，但涡流在场，") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("不会因此得知错误的信息。因为无人因处决而死，所以") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255));
    g_tipLine[104] = StringToText("不会因此获得信息，也就不会受到涡流的影响。");
    g_tipLine[105] = StringToText("· 在夜晚因处决而死亡的玩家其角色不会被") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("得知。");
    g_tipLine[106] = StringToText("【角色能力】");
    g_tipLine[107] = StringToText("每个夜晚*，你要选择除你以外的一名玩家：当晚") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对他无效。");
    g_tipLine[108] = StringToText("【角色简介】");
    g_tipLine[109] = TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("会保护他人免受") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("侵害。");
    g_tipLine[110] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("可以保护除自己以外的任意玩家。");
    g_tipLine[111] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了被") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("保护的玩家，那名玩家不会死亡。") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("也不能再去攻击另一名玩家----当晚会没有任何人死亡。");
    g_tipLine[112] = StringToText("· ") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("无法保护被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名并处决的玩家。");
    g_tipLine[113] = StringToText("【规则细节】");
    g_tipLine[114] = StringToText("· ") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("能够保护的有害效果包括：死亡，醉酒，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，疯狂，阵营变化，来自与该玩家（保护目标）阵营不同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角色变");
    g_tipLine[115] = StringToText("化，涡流的错误信息，等等。");
    g_tipLine[116] = StringToText("· 相克规则：");
    g_tipLine[117] = StringToText("【角色能力】");
    g_tipLine[118] = StringToText("如果你在夜晚死亡，你会被唤醒，然后你要选择一名玩家：你会得知他的角色。");
    g_tipLine[119] = StringToText("【角色简介】");
    g_tipLine[120] = TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("仅当在夜晚死去时，才能得知任意玩家的角色。");
    g_tipLine[121] = StringToText("· ") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("会在他死去的那个夜晚被唤醒，然后立刻选择一名玩家。");
    g_tipLine[122] = StringToText("· 如果") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("愿意，他可以选择一名已死亡的玩家。");
    g_tipLine[123] = StringToText("【规则细节】");
    g_tipLine[124] = StringToText("· 只要") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("死在夜晚，不论因什么原因而死，他都能被唤醒并使用能力。");
    g_tipLine[125] = StringToText("· 醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("，或是以为自己是") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("或提线木偶如果在夜晚死亡，仍然会被唤醒并使用能力。");
    g_tipLine[126] = StringToText("· ") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("只会得知玩家的角色，不会得知玩家的阵营。") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("在得知信息时会受到互动干扰类能力的影响而可能得知错误的角色。");
    g_tipLine[127] = StringToText("· 相克规则：");
    g_tipLine[128] = StringToText("【角色能力】");
    g_tipLine[129] = StringToText("当你首次被提名时，如果提名你的玩家是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，他立刻被处决。");
    g_tipLine[130] = StringToText("【角色简介】");
    g_tipLine[131] = TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("不会被处决......也许吧。提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的玩家通常会死亡。");
    g_tipLine[132] = StringToText("· 如果一名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("，那名") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("会立即被处决。因为每天只能有最多一次处决，提名的流程会立即结束，即使有其他玩家被提");
    g_tipLine[133] = StringToText("名且即将被处决。");
    g_tipLine[134] = StringToText("· 只有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("才会被") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的能力处决。如果") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("，") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("，无事发生，并且提名流程会继续。");
    g_tipLine[135] = StringToText("· ") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的能力非常强大，因为如果有") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("提名了") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("并死亡，那么几乎可以确定这两名角色一定都是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[136] = StringToText("· 当第一次被提名后，") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("会失去能力，即使发起提名者没有死亡，或者") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("处于醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("状态。");
    g_tipLine[137] = StringToText("【规则细节】");
    g_tipLine[138] = StringToText("· 如果提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的玩家其") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色不会因为处决而死亡（如弄臣、水手或被魔鬼代言人保护的玩家），则说书人会宣布该玩家被处决");
    g_tipLine[139] = StringToText("但没有死亡（不会说明具体原因），然后因为有处决发生，所以白天阶段依然会立即结束。");
    g_tipLine[140] = StringToText("· 如果提名") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("玩家同时被女巫诅咒，则女巫的诅咒与") + TextWithColor(StringToText("贞洁者"), Color(0, 191, 255)) + StringToText("的处决在同一时间被触发。在这种情况下，由说书人来对以何种");
    g_tipLine[141] = StringToText("顺序结算这两个效果做出决定，但应该倾向于产生更多信息的结果（参考隐性规则第1条，同时触发）。因此，在大部分情况下，即使该");
    g_tipLine[142] = StringToText("玩家的角色是还未触发能力的弄臣，也建议当晚") + TextWithColor(StringToText("送葬者"), Color(0, 191, 255)) + StringToText("依然能够得知该玩家的角色。");
    g_tipLine[143] = StringToText("【角色能力】");
    g_tipLine[144] = StringToText("每局游戏限一次，你可以在白天时公开选择一名玩家：如果他是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，他死亡。");
    g_tipLine[145] = StringToText("【角色简介】");
    g_tipLine[146] = TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("可以通过猜测谁是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("来杀死他。");
    g_tipLine[147] = StringToText("· ") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("可以在白天里的任何时间选择使用他的能力，且必须在使用能力时对所有人进行宣布。如果") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("选中了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("会立刻死亡。");
    g_tipLine[148] = StringToText("否则，无事发生。（点击魔典左上方的【声称】发动技能）");
    g_tipLine[149] = StringToText("· 玩家无法得知死去玩家的真实角色。毕竟，他有可能是") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("！");
    g_tipLine[150] = StringToText("· 处于醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("状态下且使用了自己能力的") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("将无法再次使用他的能力。");
    g_tipLine[151] = StringToText("· ") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("通常会选择一名存活玩家。即使") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("选中了一个已死亡的") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("，也会无事发生，因为已死亡的玩家无法再次死亡。");
    g_tipLine[152] = StringToText("· 玩家可以在任何时间发表任何言论，因此假装是") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的玩家可以假装使用了") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的能力。");
    g_tipLine[153] = StringToText("【规则细节】");
    g_tipLine[154] = StringToText("· 相克规则：");
    g_tipLine[155] = StringToText("【角色能力】");
    g_tipLine[156] = TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的负面能力对你无效。");
    g_tipLine[157] = StringToText("【角色简介】");
    g_tipLine[158] = TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("无法被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死。");
    g_tipLine[159] = StringToText("· ") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("无法因为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力而死去。因此，如果") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("在夜晚攻击") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("，无事发生。没有任何人会死亡。") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("也不能再去选择攻击另");
    g_tipLine[160] = StringToText("外一名玩家。");
    g_tipLine[161] = StringToText("· 即使发起提名的玩家是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("仍然会因为处决而死亡。") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("的能力会保护自己不被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的能力杀死，但无法保护自己被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("玩家");
    g_tipLine[162] = StringToText("的其他行为杀死。");
    g_tipLine[163] = StringToText("【规则细节】");
    g_tipLine[164] = StringToText("· 与") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("的能力相似，") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("能够免疫的有害效果包括：死亡，醉酒，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，疯狂，阵营变化，来自与自身阵营不同的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("对他进行的角");
    g_tipLine[165] = StringToText("色变化，等等。");
    g_tipLine[166] = StringToText("· 相克规则：");
    g_tipLine[167] = StringToText("【角色能力】");
    g_tipLine[168] = StringToText("如果只有三名玩家存活且白天没有人被处决，你的阵营获胜。 如果你在夜晚即将死亡，可能会有一名其他玩家代替你死亡。");
    g_tipLine[169] = StringToText("【角色简介】");
    g_tipLine[170] = TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("可以在最后一天通过和平的方式获得胜利。");
    g_tipLine[171] = StringToText("· 为了生存，") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("偶尔会让其他玩家「意外地」被杀死。如果") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("被攻击且即将死去时，说书人可以选择另一名玩家死亡。没有人会得");
    g_tipLine[172] = StringToText("知该玩家的死亡原因，仅仅只是得知该玩家死亡了。");
    g_tipLine[173] = StringToText("· 如果在某个白天结束时只有三名玩家存活，并且那个白天没有人被处决，那么游戏结束且") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[174] = StringToText("· 旅行者的数量也会被计入") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件中，因此他们必须先被流放。请记住流放并不是处决。（译注：如果场上有旅行者且包含旅");
    g_tipLine[175] = StringToText("行者在内的存活玩家只有三名，显然此时已经达成了") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营的胜利条件。因此如果游戏还未结束，说明场上至少还有三名非旅行者玩家");
    g_tipLine[176] = StringToText("，此时需要先对旅行者进行流放才能满足") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件。）");
    g_tipLine[177] = StringToText("· 传奇角色的数量不会被计入") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的胜利条件中，因为说书人不是一名玩家。");
    g_tipLine[178] = StringToText("· 如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("，且说书人选择了一名已死亡玩家、") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("或被") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("保护的玩家作为替代，则当晚不会有玩家死亡。（但这种情况");
    g_tipLine[179] = StringToText("不建议频繁发生）");
    g_tipLine[180] = StringToText("【规则细节】");
    g_tipLine[181] = StringToText("· 如果") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的替死能力被触发，代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的角色，其死亡原因会与") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("保持一致。也就是说，如果") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("攻击了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("且贤者代替了镇");
    g_tipLine[182] = StringToText("长死亡，贤者能够触发他的能力。在判断那些死亡触发能力的角色的死亡原因时，这一点会显得比较重要。");
    g_tipLine[183] = StringToText("· 同样地，在造成死亡的这个能力中，代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的角色会被当作选中为该能力的目标。原本这项能力是选择") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("并生效的，改为选");
    g_tipLine[184] = StringToText("择「代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡的目标」并生效（不论这项选择是能力所属的玩家做出的还是说书人做出的）。也就是说，如果月之子选择了") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("而说");
    g_tipLine[185] = StringToText("书人想要通过") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的能力改为「让一名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家代替") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死亡」，这会导致在能力实际生效时，被当作「月之子在白天选中了那名") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩");
    g_tipLine[186] = StringToText("家」而导致不满足回溯条件，从而使得月之子无法通过能力杀死任何玩家。这虽然是可行的，但") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("能力的触发选择权在说书人，过于复");
    g_tipLine[187] = StringToText("杂的互动方式会让玩家难以理解，且结果并不一定会容易被所有玩家接受，不如参考") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("词条运作方式中的建议。此外") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("死在月之子手");
    g_tipLine[188] = StringToText("里和被大家当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家并死于处决其实结果并无区别，说书人应该考虑更为简单的处理方式。");
    g_tipLine[189] = StringToText("· 虽然") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的特殊胜利在黄昏时宣布，但") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("的特殊胜利能力触发是在白天，因此") + TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("或者其他能让") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的角色仍然会阻");
    g_tipLine[190] = StringToText("止") + TextWithColor(StringToText("镇长"), Color(0, 191, 255)) + StringToText("因为自己的能力而以特殊方式获胜。");
    g_tipLine[191] = StringToText("· 特定角色互动：");
    g_tipLine[192] = StringToText("· 相克规则：");
    g_tipLine[193] = StringToText("【角色能力】");
    g_tipLine[194] = StringToText("每个夜晚，你要选择除你以外的一名玩家：明天白天，只有他投票时你才能投票。");
    g_tipLine[195] = StringToText("【角色简介】");
    g_tipLine[196] = TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("只能在他的主人投票时才能投票。");
    g_tipLine[197] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("需要选择一名玩家来成为自己的主人。这名玩家可以是与前一夜相同的，也可以是与前一夜不同的。");
    g_tipLine[198] = StringToText("· 如果主人在投票时举手，或主人的投票已经被统计时，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("可以举手参与投票。");
    g_tipLine[199] = StringToText("· 如果主人放下了他的手，表明他不参与投票，或在投票被统计前将手放下，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("也必须将自己的手放下。");
    g_tipLine[200] = StringToText("· 说书人没有监视") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的责任。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("需要为自己的投票负责。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("在不应该投票的场合下故意投票会被视为作弊。");
    g_tipLine[201] = StringToText("· 因为角色能力不能以任何形式影响流放流程，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("可以在流放表决中自由参与表决。");
    g_tipLine[202] = StringToText("· 已死亡的玩家只能在拥有投票标记时才能举手投票。如果") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("选择了一名已死亡玩家作为主人，这种情况仍然适用。");
    g_tipLine[203] = StringToText("· ") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的能力从不会被强制必须投票。");
    g_tipLine[204] = StringToText("· ") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的投票可以在他主人之前或之后被说书人计票。座次顺序并不重要。");
    g_tipLine[205] = StringToText("【规则细节】");
    g_tipLine[206] = StringToText("· 即使") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("作弊投票，他的票也仍然会被统计并且有效。") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("不应该，也无法用这种方式来证明自己是") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("。");
    g_tipLine[207] = StringToText("· 对于") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的作弊行为，不要以「不好的事」来进行处罚，因为这样会导致游戏产生相对于正常情况的额外信息，这不利于玩家进行推");
    g_tipLine[208] = StringToText("理分析。「被视为作弊」其实更多地是一种基于社交上的措辞，是对于玩家不遵守游戏规则的一种客观的表达，但并不意味着作弊的玩家");
    g_tipLine[209] = StringToText("需要在游戏中受到处罚。如果真的有作弊的现象发生，那么跟这位玩家在游戏结束后私下好好谈谈吧。");
    g_tipLine[210] = StringToText("· 对于轮盘计票方式中，主人坐在") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("下家的情况而导致") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("可能无法参与投票的情况，有以下几种建议： 提倡玩家养成提前举手的");
    g_tipLine[211] = StringToText("习惯。因为即使提前举手，也会在说书人的手指向某个玩家时，才会计算该玩家的票，提前举手也会成为一些谈判和背叛的策略。在这种");
    g_tipLine[212] = StringToText("情况下，如果主人提前举手了，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("自然就能正常举手且不算做作弊。即使") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的投票被说书人统计后主人在自己的票被统计之前又把手");
    g_tipLine[213] = StringToText("放下，") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("的票依然会被计算且不算作弊。 对于线上游戏，很难在短时间内观察主人的举手情况并做出反馈时，建议以以下方式进行互");
    g_tipLine[214] = StringToText("动：") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("玩家可以在交流阶段公开声明自己是") + TextWithColor(StringToText("管家"), Color(0, 191, 255)) + StringToText("，并询问主人自己可以参与针对哪些玩家的提名投票，向主人寻求建议。");
    g_tipLine[215] = StringToText("· 相克规则：");
    g_tipLine[216] = StringToText("【角色能力】");
    g_tipLine[217] = StringToText("你不知道你是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("。你以为你是一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，但其实你不是。");
    g_tipLine[218] = StringToText("【角色简介】");
    g_tipLine[219] = TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("以为自己是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("，且对自己实际上是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("一事毫不知情。");
    g_tipLine[220] = StringToText("· 在初始设置时，不会将") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("的角色标记放进盲抽袋中。作为替代，会有一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("的角色标记放进盲抽袋中，且抽到该角色标记的玩家");
    g_tipLine[221] = StringToText("会在整场游戏中秘密地成为") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("。说书人知道哪位") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("实际上是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("，而") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩家无从得知。");
    g_tipLine[222] = StringToText("· ") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("没有任何能力。不论他获得的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("标记是否会以某些方式影响游戏，") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("却无法使用这一") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能力。然而，说书人会装作") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("玩");
    g_tipLine[223] = StringToText("家是他以为的那种") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("。如果那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("会在夜晚醒来，") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("同样会被唤醒并如同那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("的方式进行行动。如果那个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("能够获取信息，");
    g_tipLine[224] = StringToText("说书人可以对") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("给出错误的信息作为替代----我们也建议说书人这样去做。");
    g_tipLine[225] = StringToText("【规则细节】");
    g_tipLine[226] = StringToText("· 如果") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，他不会有任何变化。属于认知覆盖类的能力不会因为醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("失效。一旦玩家成为了") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("这个角色，玩家会");
    g_tipLine[227] = StringToText("始终认为自己是") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("（除非玩家通过推理分析得出自己实际上是") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("）。");
    g_tipLine[228] = StringToText("· 认知覆盖类能力的角色只要还是这个角色，说书人就能对其进行合理的欺骗，但前提条件是需要让他持续认为自己是满足自己当前角");
    g_tipLine[229] = StringToText("色「认知范围」内的角色，且无法对「认知范围」以外的内容进行欺骗。例如，说书人无法欺骗一个未转变阵营的") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("说他的阵营发生了");
    g_tipLine[230] = StringToText("变化。但是，如果有") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家声称自己是农夫且在夜晚死亡，说书人能够欺骗") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("并告诉他他变成了农夫，因为农夫仍然是一个") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色");
    g_tipLine[231] = StringToText("，这满足") + TextWithColor(StringToText("酒鬼"), Color(0, 191, 255)) + StringToText("的「认知范围」。");
    g_tipLine[232] = StringToText("· 特定角色互动：");
    g_tipLine[233] = StringToText("· 相克规则：");
    g_tipLine[234] = StringToText("【角色能力】");
    g_tipLine[235] = StringToText("你可能会被当作") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("角色或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色，即使你已死亡。");
    g_tipLine[236] = StringToText("【角色简介】");
    g_tipLine[237] = TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("会看起来像是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("一员，但实际上是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的。");
    g_tipLine[238] = StringToText("· 任何时候要探查") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("的阵营时，由说书人来决定") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("还是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("。");
    g_tipLine[239] = StringToText("· 任何时候") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("被影响特定的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色的能力选择时，由说书人来决定") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("是否会被当作某种特定的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或是") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色。");
    g_tipLine[240] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("能在同一个夜晚的不同能力中分别被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("或") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营，") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色。由说书人来选择最有趣的结果。");
    g_tipLine[241] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("在被当作特定的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("或") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("角色时，不会获得这一角色的能力。例如，被当作") + TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("的") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("无法在夜晚被唤醒，也无法让一名玩");
    g_tipLine[242] = StringToText("家") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[243] = StringToText("【规则细节】");
    g_tipLine[244] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("有很多「可以但不建议」的内容，希望各位说书人在有") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[245] = StringToText("· ") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，那么") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("是有可能被当作");
    g_tipLine[246] = StringToText("「") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("」或者是「") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("陌客"), Color(0, 191, 255)) + StringToText("」的（如舞蛇人和食人族）。");
    g_tipLine[247] = StringToText("· 相克规则：");
    g_tipLine[248] = StringToText("【角色能力】");
    g_tipLine[249] = StringToText("如果你死于处决，你的阵营落败。");
    g_tipLine[250] = StringToText("【角色简介】");
    g_tipLine[251] = TextWithColor(StringToText("圣徒"), Color(0, 191, 255)) + StringToText("在被处决时会导致游戏结束。");
    g_tipLine[252] = StringToText("· 如果") + TextWithColor(StringToText("圣徒"), Color(0, 191, 255)) + StringToText("因处决而死亡，游戏结束。") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营落败，") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营获胜。");
    g_tipLine[253] = StringToText("· 如果") + TextWithColor(StringToText("圣徒"), Color(0, 191, 255)) + StringToText("因处决以外的任何方式死亡----例如被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死----游戏仍会继续。");
    g_tipLine[254] = StringToText("【规则细节】");
    g_tipLine[255] = StringToText("· 特定角色互动：");
    g_tipLine[256] = StringToText("【角色能力】");
    g_tipLine[257] = StringToText("每个夜晚，你要选择一名玩家：他在当晚和明天白天") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[258] = StringToText("【角色简介】");
    g_tipLine[259] = TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("能秘密地干扰其他角色的能力。");
    g_tipLine[260] = StringToText("· 每个夜晚，") + TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("会选择一名玩家在当晚的剩余时间和接下来的一整个白天阶段里") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("。");
    g_tipLine[261] = StringToText("· ") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的玩家会失去能力，但说书人会装作他仍具有能力。他的能力不会真实地影响游戏。为了保证") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的玩家处于未") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的幻象中，");
    g_tipLine[262] = StringToText("说书人会在正确的时间下唤醒他，并如同他未") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("一样走过场来执行他的能力。如果") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("玩家的角色能力能够获取信息，说书人可以给他");
    g_tipLine[263] = StringToText("提供错误信息。");
    g_tipLine[264] = StringToText("· 如果一名") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的玩家在他") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的期间里使用了「每局游戏限一次」的能力，他无法再次使用这项能力。");
    g_tipLine[265] = StringToText("【规则细节】");
    g_tipLine[266] = StringToText("· 虽然") + TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("的能力描述中，") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("的持续时间看似与水手和旅店老板等有所差别，但实际上这只是为了新手玩家便于理解，而不用特意");
    g_tipLine[267] = StringToText("引出「黄昏」这个概念。实际上，") + TextWithColor(StringToText("投毒者"), Color(255, 69, 0)) + StringToText("的能力描述同样可以写为：「每个夜晚，你要选择一名玩家：他会") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("到下个黄昏。」");
    g_tipLine[268] = StringToText("【角色能力】");
    g_tipLine[269] = StringToText("每个夜晚，你能查看魔典。 你可能会被当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营、") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色，即使你已死亡。");
    g_tipLine[270] = StringToText("【角色简介】");
    g_tipLine[271] = TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("知道所有人的具体角色。") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("看起来像是") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("一员，但实际上是") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的。");
    g_tipLine[272] = StringToText("· 如果任何角色的能力会探查或影响") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家，") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("可能会被那名角色当作") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营。如果任何角色的能力会探查或影响") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色或外");
    g_tipLine[273] = StringToText("来者角色，") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("可能会被那名角色当作是一个特定的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色。由说书人来决定") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("被当作什么，在同一个夜晚") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("能被多次当");
    g_tipLine[274] = StringToText("作不同阵营或不同的角色。");
    g_tipLine[275] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("在被当作特定的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("或") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色时，不会获得这一角色的能力。例如，被当作") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("的") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("无法猎杀") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[276] = StringToText("【规则细节】");
    g_tipLine[277] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("有很多「可以但不建议」的内容，希望各位说书人在有") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("在场的对局中为玩家提供良好的游戏体验而非寻求创意。");
    g_tipLine[278] = StringToText("· 说书人不应该利用") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("能够被当作任意角色或阵营这一点，来将") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("在魔典中的角色标记替换成其他角色标记，以此向能够查看魔典");
    g_tipLine[279] = StringToText("的角色传递额外的信息。") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家之间的交流需要玩家自己自发进行，而且需要让") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("玩家有迹可循。");
    g_tipLine[280] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("的互动干扰能力中，阵营与角色是独立判断的。也就是说，如果有既能探查阵营也能探查角色的能力，那么") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("是有可能被当作");
    g_tipLine[281] = StringToText("「") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("的") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("」或者是「") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("」的（如食人族）。");
    g_tipLine[282] = StringToText("· 养成良好的魔典使用习惯非常重要。这不仅仅是在有") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("或是寡妇的时候能确保他们获得正确的信息，也是对说书人记录繁杂的游戏");
    g_tipLine[283] = StringToText("信息并确保各项处理结算无误的重要支撑。必要时，说书人还应该利用提示标记以外的其他方式去记录信息，但这些信息不会被") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("得知");
    g_tipLine[284] = StringToText("。在线上游戏中，") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("不应该也无法看到说书人做的任何自定义笔记。");
    g_tipLine[285] = StringToText("· 如果说书人觉得自己的某些提示标记处理可能与常规处理方式不同，想办法在白天时私下与") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("沟通（例如夜晚拍醒他并用手机打字");
    g_tipLine[286] = StringToText("示意让他白天来私聊你）来确保") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("正确理解了你魔典里的提示标记的位置和放置逻辑。");
    g_tipLine[287] = StringToText("· ") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("的三个不在场") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色（即伪装）是否出现在魔典中，取决于说书人是否将伪装在展示给") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后放在魔典中或放回剧本盒（剧");
    g_tipLine[288] = StringToText("本盒也位于魔典内的左侧下方，用于收纳不在场的角色和提示标记，但这些标记不会平铺在魔典左侧）。如果说书人选择在展示完后放回");
    g_tipLine[289] = StringToText("剧本盒，则") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("无法看到这一信息。");
    g_tipLine[290] = StringToText("· ") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("查看魔典时，除去角色标记和提示标记之外，还能查看玩家的阵营。对于非旅行者角色标记，正面放置代表该玩家阵营与其角色");
    g_tipLine[291] = StringToText("初始阵营相同，倒转放置代表该玩家阵营与其角色初始阵营不同。对于旅行者角色标记，正面放置代表该玩家为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营，倒转放置代表");
    g_tipLine[292] = StringToText("该玩家为") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("阵营。");
    g_tipLine[293] = StringToText("· 查看魔典也属于「获取信息」。如果") + TextWithColor(StringToText("间谍"), Color(255, 69, 0)) + StringToText("醉酒或") + TextWithColor(StringToText("中毒"), Color(128, 0, 128)) + StringToText("，说书人对他展示的魔典内容可能会是错误的。");
    g_tipLine[294] = StringToText("· 相克规则：");
    g_tipLine[295] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[296] = StringToText("【角色能力】");
    g_tipLine[297] = StringToText("如果大于等于五名玩家存活时（旅行者不计算在内）") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("死亡，你变成那个") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[298] = StringToText("【角色简介】");
    g_tipLine[299] = TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("会在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("死亡时变成") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[300] = StringToText("· 如果在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("死前有五名或更多的玩家存活；或者说，如果在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("死后有四名或更多的玩家存活，那么") + TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("会立刻变成") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，游戏");
    g_tipLine[301] = StringToText("会如同") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("尚未死亡一样继续进行。");
    g_tipLine[302] = StringToText("· 当") + TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("的能力触发时，旅行者的数量不会计算在内。");
    g_tipLine[303] = StringToText("· 如果在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("被处决时少于五名玩家存活，游戏会结束，并且") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。");
    g_tipLine[304] = StringToText("· 如果在") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("选择自杀时，有五名或更多的玩家存活，必须是由") + TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("来变成新的") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("。（前提是，") + TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("此时能力正常生效");
    g_tipLine[305] = StringToText("）");
    g_tipLine[306] = StringToText("· 如果") + TextWithColor(StringToText("红唇女郎"), Color(255, 69, 0)) + StringToText("变成了") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，她在各种意义上都会成为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("。如果她被处决，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营会获胜。她会在每个晚上攻击玩家。她被当作恶");
    g_tipLine[307] = StringToText("魔。");
    g_tipLine[308] = StringToText("【规则细节】");
    g_tipLine[309] = StringToText("· 特定角色互动：");
    g_tipLine[310] = StringToText("· 相克规则：");
    g_tipLine[311] = StringToText("· 相克规则（与华灯系列角色）：");
    g_tipLine[312] = StringToText("【角色能力】");
    g_tipLine[313] = StringToText("会有额外的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("在场。[+2 ") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("]");
    g_tipLine[314] = StringToText("【角色简介】");
    g_tipLine[315] = TextWithColor(StringToText("男爵"), Color(255, 69, 0)) + StringToText("会改变在场的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("数量。");
    g_tipLine[316] = StringToText("· ") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("的数量变化会发生在初始设置时，且不会因为") + TextWithColor(StringToText("男爵"), Color(255, 69, 0)) + StringToText("死亡而恢复成原本的数量。对角色在初始设置时的更改，而在游戏过程中不");
    g_tipLine[317] = StringToText("产生影响的能力，都会在角色列表和角色标记上以方括号标注在角色描述的末尾----就像[这样]。");
    g_tipLine[318] = StringToText("· 增加的") + TextWithColor(StringToText("外来者"), Color(0, 191, 255)) + StringToText("角色总是会替换掉原本的") + TextWithColor(StringToText("镇民"), Color(0, 191, 255)) + StringToText("角色，而不是其他角色类型。");
    g_tipLine[319] = StringToText("【规则细节】");
    g_tipLine[320] = StringToText("· 相克规则：");
    g_tipLine[321] = StringToText("【角色能力】");
    g_tipLine[322] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式自杀，一名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("会变成") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("。");
    g_tipLine[323] = StringToText("【角色简介】");
    g_tipLine[324] = TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("会在夜晚杀戮，且能创造自己的分身......以可怕的代价。");
    g_tipLine[325] = StringToText("· 除首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("会选择一名玩家进行杀戮。因为夜间大多数角色都在") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("之后行动，被") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("杀死的玩家可能在当");
    g_tipLine[326] = StringToText("晚无法使用他的能力。");
    g_tipLine[327] = StringToText("· ") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("作为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，能够得知哪些玩家是他的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("，也能得知三个不在场的") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("角色，他能较为安全地伪装成这些角色。");
    g_tipLine[328] = StringToText("· 如果") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("死亡，游戏结束且") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营获胜。然而，如果") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("选择在夜晚杀死自己，他会死亡并且会有一名存活的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("变成") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0));
    g_tipLine[329] = StringToText("。新的") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("在当晚无法进行行动，但现在那名") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("现在在各种意义上都会成为") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("----他会在此后的每个夜晚杀戮，且会在死亡时让邪");
    g_tipLine[330] = StringToText("恶阵营落败。");
    g_tipLine[331] = StringToText("【规则细节】");
    g_tipLine[332] = StringToText("·") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("是唯一的") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("：如果") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("死了而且没有别人接位，") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("阵营立刻获胜。");
    g_tipLine[333] = StringToText("·") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("可以在夜里自杀，把") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("身份传给一名活着的") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("（这时会有一位新的") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("）。");
    g_tipLine[334] = StringToText("·注意：只有「") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("自己那一刀」打死自己才会传位；被处决、被") + TextWithColor(StringToText("猎手"), Color(0, 191, 255)) + StringToText("打中都不会传位。");
    g_tipLine[335] = StringToText("·对抗办法：尽量逼") + TextWithColor(StringToText("小恶魔"), Color(255, 0, 0)) + StringToText("在白天被处决，或者在夜里用") + TextWithColor(StringToText("僧侣"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("士兵"), Color(0, 191, 255)) + StringToText("、") + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + StringToText("这类角色拖住他的刀。");
    g_tipLine[336] = StringToText("·在白天与其他玩家私聊交换信息，在公聊与其他玩家互相分享获得的信息。");
    g_tipLine[337] = StringToText("·通过整合的信息与逻辑推理找出撒谎的") + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + StringToText("玩家，并处决") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("，最终取得胜利。");
    g_tipLine[338] = StringToText("·利用你的能力，为") + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + StringToText("方制造混乱亦或是将") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("从危机中解救。");
    g_tipLine[339] = StringToText("·保护") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("直到只剩 2 人存活，为此不惜付出你的生命。");
    g_tipLine[340] = StringToText("·在白天与") + TextWithColor(StringToText("恶魔"), Color(255, 0, 0)) + StringToText("取得联系：他会获得 3 个不在场身份，供你们伪装。");
    g_tipLine[341] = StringToText("·不惜一切代价存活下来，直到仅剩 2 人，为此你可以牺牲掉") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("。");
    g_tipLine[342] = StringToText("·你会获得 3 个不在场身份，他们是你完美的伪装。");
    g_tipLine[343] = StringToText("·在白天与") + TextWithColor(StringToText("爪牙"), Color(255, 69, 0)) + StringToText("们取得联系，把伪装身份分享给他们，并一起策划阴谋。");
    g_tipLine[344] = StringToText("·游戏进行昼夜交替，白天投票处决人，夜晚有能力玩家进行行动。");
    g_tipLine[345] = StringToText("·在白天分为私聊，自由与公聊和提名阶段，由说书人决定。通常情况前两天会先进行私聊/自由到公聊，最后到提名处决阶段。");
    g_tipLine[346] = StringToText("·如果你的角色在夜间可以行动，请等待说书人唤醒你。");
    g_tipLine[347] = StringToText("·关于提名阶段：");
    g_tipLine[348] = StringToText("〔1〕在提名阶段的时间内，所有玩家无法说话，只有提名者与被提名者在提名与辩护的阶段可以单独发言。任何一个存活玩家都可以点");
    g_tipLine[349] = StringToText("击发起提名，点击一个玩家的座位即可对其进行提名，所有玩家可以进行投票，票数过半者将会被标记待处决，一天内得票最高者将会被");
    g_tipLine[350] = StringToText("处决。");
    g_tipLine[351] = StringToText("〔2〕提名和投票有以下限制：〔a〕提名玩家必须存活，但被提名的玩家可以是任意玩家。〔b〕一名玩家一天内最多可以提名与被提");
    g_tipLine[352] = StringToText("名一次。〔c〕存活的玩家在提名阶段可以投票给任意数量的玩家；死亡后仍会拥有一次投票的机会。");
    g_tipLine[353] = TextWithColor(StringToText("·在血染钟楼，死亡并不代表结束：无论"), Color(235, 70, 70)) + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + TextWithColor(StringToText("还是"), Color(235, 70, 70)) + TextWithColor(StringToText("邪恶"), Color(139, 0, 0)) + TextWithColor(StringToText("，你仍然拥有发言的权力与一次投票的机会，"), Color(235, 70, 70)) + TextWithColor(StringToText("守鸦人"), Color(0, 191, 255)) + TextWithColor(StringToText("一类的角色也可以在死亡后发"), Color(235, 70, 70));
    g_tipLine[354] = TextWithColor(StringToText("动技能，与其他"), Color(235, 70, 70)) + TextWithColor(StringToText("善良"), Color(30, 144, 255)) + TextWithColor(StringToText("玩家分享自己的信息。因此不要因为死亡就退出游戏，帮助你的队友在决胜局投出关键的一票吧！"), Color(235, 70, 70));
    g_tipRoleAt[0] = 4800;   g_tipRoleN[0] = 15;
