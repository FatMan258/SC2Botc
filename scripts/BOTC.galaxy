    g_jinxText3[113] = "";
    g_jinxA[114] = 150;  g_jinxB[114] = 67;
    g_jinxText[114] = "召唤师与麻脸巫婆：如果召唤师创造了第二名存活的恶魔，当晚死亡由说书人决定。";
