    g_abListNext2 = BOTC_NewButton(g_abListDlg, 200, 40, 240, 860, "下一页");
    g_abListClose2 = BOTC_NewButton(g_abListDlg, 160, 40, 1000, 860, "关闭");
}

// 每条摆到 (col,row)：图标按钮 + 名字 + 能力（能力文字取提示数据里【角色能力】的下一行）
void BOTC_RoleListEntry (int p, int slot, int r, int col, int row) {
    int x;
    int y;
    x = 20 + (col * 580);
    y = 50 + (row * 84);
    g_abListRole[slot] = r;
    libNtve_gf_SetDialogItemText(g_abListName[slot], StringToText(g_roleName[r]), PlayerGroupSingle(p));
    DialogControlSetPosition(g_abListIcon[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetPosition(g_abListImg[slot], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    libNtve_gf_SetDialogItemImage(g_abListImg[slot], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetVisible(g_abListImg[slot], PlayerGroupSingle(p), true);
    DialogControlSetPosition(g_abListName[slot], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 4);
    DialogControlSetPosition(g_abListAb[slot], PlayerGroupSingle(p), c_anchorTopLeft, x + 92, y + 34);
    libNtve_gf_SetDialogItemText(g_abListAb[slot], g_tipLine[g_tipRoleAt[r] + 1], PlayerGroupSingle(p));
    DialogControlSetVisible(g_abListIcon[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abListName[slot], PlayerGroupSingle(p), true);
    DialogControlSetVisible(g_abListAb[slot], PlayerGroupSingle(p), true);
}

void BOTC_RoleListRender (int p) {
    int i;
    int r;
    int col;
    int row;
    for (i = 0; i < 22; i += 1) {
        DialogControlSetVisible(g_abListIcon[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListName[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListAb[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListImg[i], PlayerGroupSingle(p), false);
    }
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_abListSec[i], PlayerGroupSingle(p), false);
    }
    if (g_abPage[p] <= 1) {
        libNtve_gf_SetDialogItemText(g_abTitle, StringToText("角色能力表  1 / 2 ---- 善良阵营·镇民"), PlayerGroupSingle(p));
        for (i = 0; i <= 12; i += 1) {
            if (i < 7) { col = 0; row = i; }
            else { col = 1; row = i - 7; }
            BOTC_RoleListEntry(p, i, i, col, row);
        }
    }
    else {
        libNtve_gf_SetDialogItemText(g_abTitle, StringToText("角色能力表  2 / 2 ---- 外来者 / 爪牙 / 恶魔"), PlayerGroupSingle(p));
        // 每段两列：外来者 2+2、爪牙 2+2、恶魔 1，一共只用 8 行，不会压到下面的按钮
        libNtve_gf_SetDialogItemText(g_abListSec[0], StringToText("善良阵营·外来者"), PlayerGroupSingle(p));
        DialogControlSetPosition(g_abListSec[0], PlayerGroupSingle(p), c_anchorTopLeft, 20, 46);
        DialogControlSetVisible(g_abListSec[0], PlayerGroupSingle(p), true);
        BOTC_RoleListEntry(p, 0, 13, 0, 1);
        BOTC_RoleListEntry(p, 1, 14, 0, 2);
        BOTC_RoleListEntry(p, 2, 15, 1, 1);
        BOTC_RoleListEntry(p, 3, 16, 1, 2);
        libNtve_gf_SetDialogItemText(g_abListSec[1], StringToText("邪恶阵营·爪牙"), PlayerGroupSingle(p));
        DialogControlSetPosition(g_abListSec[1], PlayerGroupSingle(p), c_anchorTopLeft, 20, 46 + (3 * 84));
        DialogControlSetVisible(g_abListSec[1], PlayerGroupSingle(p), true);
        BOTC_RoleListEntry(p, 4, 17, 0, 4);
        BOTC_RoleListEntry(p, 5, 18, 0, 5);
        BOTC_RoleListEntry(p, 6, 19, 1, 4);
        BOTC_RoleListEntry(p, 7, 20, 1, 5);
        libNtve_gf_SetDialogItemText(g_abListSec[2], StringToText("邪恶阵营·恶魔"), PlayerGroupSingle(p));
        DialogControlSetPosition(g_abListSec[2], PlayerGroupSingle(p), c_anchorTopLeft, 20, 46 + (6 * 84));
        DialogControlSetVisible(g_abListSec[2], PlayerGroupSingle(p), true);
        BOTC_RoleListEntry(p, 8, 21, 0, 7);
    }
    for (i = 13; i < 22; i += 1) {
        DialogControlSetVisible(g_abListIcon[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListName[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListAb[i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_abListImg[i], PlayerGroupSingle(p), false);
    }
}

