    libNtve_gf_SetDialogItemText(g_pickSec[2], TextWithColor(StringToText("爪牙"), Color(255, 69, 0)), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_pickSec[3], TextWithColor(StringToText("恶魔"), Color(255, 0, 0)), PlayerGroupAll());

    // 【分类按钮】（用户 2026-11-03）：镇民 / 外来者 / 爪牙 / 恶魔 放在左上角，点击只显示对应类别。
    for (j = 0; j < 4; j += 1) {
        g_pickCatBtn[j] = BOTC_NewButton(g_pickDlg, 130, 30, 30 + (j * 140), 42, "");
        DialogControlSetVisible(g_pickCatBtn[j], PlayerGroupAll(), false);
    }
    // 建 64 格（位置 / 图标 / 名字 都由 BOTC_PickLayout 按当前板子摆；用不到的格会藏起来）
    for (j = 0; j < 64; j += 1) {
        g_pickBtn[j] = BOTC_NewButton(g_pickDlg, 85, 85, 60, 76, "");
        libNtve_gf_CreateDialogItemImage(g_pickDlg, 85, 85, c_anchorTopLeft, 60, 76, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_pickIcon[j] = DialogControlLastCreated();
        DialogControlSetSize(g_pickIcon[j], PlayerGroupAll(), 85, 85);
        libNtve_gf_SetDialogItemAcceptMouse(g_pickIcon[j], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_pickIcon[j], "botc_blank.dds", PlayerGroupAll());
        g_pickName[j] = BOTC_NewLabelC(g_pickDlg, 105, 20, 50, 162, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_pickName[j], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_pickName[j], false, PlayerGroupAll());
    }
    for (p = 1; p <= 13; p += 1) {
        for (j = 0; j < 4; j += 1) {
            g_pickCatPageBy[(p * 4) + j] = 1;
        }
    }
    for (j = 0; j < 4; j += 1) {
        g_pickCatPage[j] = 1;          // 旧字段保留兼容
        y = BOTC_GridBlockY(j) + 86;
        if (j == 0) {
            y = 292;
        }
        g_pickCatPrev[j] = BOTC_NewButton(g_pickDlg, 38, 22, 865, y, "<");
        g_pickCatNext[j] = BOTC_NewButton(g_pickDlg, 38, 22, 909, y, ">");
        DialogControlSetVisible(g_pickCatPrev[j], PlayerGroupAll(), false);
        DialogControlSetVisible(g_pickCatNext[j], PlayerGroupAll(), false);
    }
    for (j = 1; j <= 13; j += 1) {
        g_pickFilterGood[j] = false;
        g_pickFilterTeam[j] = -1;
        g_pickFilterAlign[j] = -1;
    }
    BOTC_PickLayout();
    // 【强制阵营】（用户 2026-10-21）：放在身份网格右侧，善良 / 邪恶互斥勾选。
    g_pickAlignLbl = BOTC_NewLabel(g_pickDlg, 220, 28, 930, 40, StringToText("身份阵营"));
    libNtve_gf_SetDialogItemStyle(g_pickAlignLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_pickAlignLbl, false, PlayerGroupAll());
    g_pickGoodBtn = BOTC_NewButton(g_pickDlg, 220, 64, 930, 76, "善良");
    libNtve_gf_CreateDialogItemImage(g_pickDlg, 48, 48, c_anchorTopLeft, 936, 84, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_pickGoodIcon = DialogControlLastCreated();
    libNtve_gf_SetDialogItemAcceptMouse(g_pickGoodIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_pickGoodIcon, "botc_tk_good.dds", PlayerGroupAll());
    g_pickEvilBtn = BOTC_NewButton(g_pickDlg, 220, 64, 930, 148, "邪恶");
    libNtve_gf_CreateDialogItemImage(g_pickDlg, 48, 48, c_anchorTopLeft, 936, 156, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_pickEvilIcon = DialogControlLastCreated();
    libNtve_gf_SetDialogItemAcceptMouse(g_pickEvilIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_pickEvilIcon, "botc_tk_evil.dds", PlayerGroupAll());
    DialogControlSetVisible(g_pickAlignLbl, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickGoodBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickGoodIcon, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickEvilBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_pickEvilIcon, PlayerGroupAll(), false);
    // 【认知偏差】（用户 2026-11-09）：阵营勾选下面一排互斥按钮，只给目标打对应 token。
    //   剧本里没有对应角色时由 BOTC_PickCogRender 逐个隐藏。
    g_pickCogLbl = BOTC_NewLabel(g_pickDlg, 220, 28, 930, 222, StringToText("认知偏差"));
    libNtve_gf_SetDialogItemStyle(g_pickCogLbl, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_pickCogLbl, false, PlayerGroupAll());
    for (j = 0; j < 4; j += 1) {
        g_pickCogBtn[j] = BOTC_NewButton(g_pickDlg, 220, 52, 930, 256 + (j * 60), "");
        DialogControlSetVisible(g_pickCogBtn[j], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_pickCogLbl, PlayerGroupAll(), false);
    // 【左下角单类分页 / 右下角取消与清除身份】（用户 2026-11-03）
    g_pickPagePrev = BOTC_NewButton(g_pickDlg, 46, 40, 30, 812, "<");
    g_pickPageNext = BOTC_NewButton(g_pickDlg, 46, 40, 86, 812, ">");
    g_pickPageLbl = BOTC_NewLabel(g_pickDlg, 220, 40, 150, 812, StringToText("第 1 / 1 页"));
