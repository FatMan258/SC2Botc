// 【打开发送目标选择】（用户 2026-11-06）：只给说书人；按钮按当前剧本动态排列，
//   所有恶魔始终有，爪牙看告密者(92)，疯子看疯子(38)，可选项有几个就出现几个。
void BOTC_BluffTgtOpen () {
    int n;
    DialogControlSetVisible(g_bluffTgtBtn[0], PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffTgtBtn[1], PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffTgtBtn[2], PlayerGroupAll(), false);
    DialogControlSetPosition(g_bluffTgtBtn[0], PlayerGroupAll(), c_anchorTopLeft, 40, 56);
    DialogControlSetVisible(g_bluffTgtBtn[0], PlayerGroupAll(), true);
    n = 1;
    if (BOTC_BoardHasRole(92)) {
        DialogControlSetPosition(g_bluffTgtBtn[1], PlayerGroupAll(), c_anchorTopLeft, 40, 56 + (n * 46));
        DialogControlSetVisible(g_bluffTgtBtn[1], PlayerGroupAll(), true);
        n = n + 1;
    }
    if (BOTC_BoardHasRole(38)) {
        DialogControlSetPosition(g_bluffTgtBtn[2], PlayerGroupAll(), c_anchorTopLeft, 40, 56 + (n * 46));
        DialogControlSetVisible(g_bluffTgtBtn[2], PlayerGroupAll(), true);
        n = n + 1;
    }
    DialogControlSetPosition(g_bluffTgtCancelBtn, PlayerGroupAll(), c_anchorTopLeft, 40, 56 + (n * 46));
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupSingle(g_teller), true);
}

// 【关闭发送目标选择】（用户 2026-11-06）：对所有玩家收起。
void BOTC_BluffTgtClose () {
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
}

void BOTC_BluffSendStart () {
    int i;
    if (g_bluffPickSeat) {
        g_bluffPickSeat = false;
        BOTC_Notice(g_teller, "已取消发送不在场身份。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    g_bluffPickSeat = true;
    BOTC_GrimRender(g_teller);
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(g_teller), true);
    BOTC_Notice(g_teller, "点一个座位：把这 3 个不在场身份发给他。");
}

void BOTC_BluffSendAt (int q) {
    int i;
    g_bluffPickSeat = false;
    if (q < 2 || q > 13) {
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] == 0) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（可以点【随机 3 个】）。");
            return;
        }
    }
    BOTC_BluffGiveTo(q, g_bluffPick[0], g_bluffPick[1], g_bluffPick[2]);
}

void BOTC_BuildBluff () {
    int i;
    int x;
    DialogCreate(396, 198, c_anchorBottomRight, 0, 0, false);
    g_bluffDlg = DialogLastCreated();
    DialogSetVisible(g_bluffDlg, PlayerGroupAll(), false);

    g_bluffTitle = BOTC_NewLabel(g_bluffDlg, 378, 26, 9, 4, StringToText("不在场身份"));
    libNtve_gf_SetDialogItemStyle(g_bluffTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bluffTitle, false, PlayerGroupAll());

    for (i = 0; i < 3; i += 1) {
        x = 14 + (i * 126);
        g_bluffSeat[i] = BOTC_NewButton(g_bluffDlg, 112, 112, x, 32, "");
        libNtve_gf_CreateDialogItemImage(g_bluffDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
        g_bluffIcon[i] = DialogControlLastCreated();
        DialogControlSetPosition(g_bluffIcon[i], PlayerGroupAll(), c_anchorTopLeft, x - 7, 27);
        libNtve_gf_SetDialogItemAcceptMouse(g_bluffIcon[i], false, PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_bluffIcon[i], "botc_blank.dds", PlayerGroupAll());
        g_bluffName[i] = BOTC_NewLabel(g_bluffDlg, 112, 26, x, 119, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_bluffName[i], "ModLeftSize20Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_bluffName[i], false, PlayerGroupAll());
        // 3 个坑位只有说书人能点（恶魔那边只显示图，不给点）
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_bluffSeat[i], PlayerGroupSingle(g_teller), true);
    }

    g_bluffRollBtn = BOTC_NewButton(g_bluffDlg, 175, 36, 14, 151, "随机 3 个");
    g_bluffSendBtn = BOTC_NewButton(g_bluffDlg, 175, 36, 207, 151, "发送");
    // 【发送给所有恶魔】（用户 2026-09-30）：面板右上角，一键发给所有恶魔（军团局省事）
    g_bluffSendAllBtn = BOTC_NewButton(g_bluffDlg, 150, 26, 237, 2, "发送给所有恶魔");
    // 【字体小一号】（用户 2026-09-30）：默认按钮字体太大，150 宽的按钮里「发送给所有恶魔」挤得慌；
    //   项目里能用的最小档就是 ModLeftSize16Bold（14 那档当前依赖里没有，见记忆里那次乱码事故）
    libNtve_gf_SetDialogItemStyle(g_bluffSendAllBtn, "ModLeftSize16Bold", PlayerGroupAll());
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffRollBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendBtn, PlayerGroupSingle(g_teller), true);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_bluffSendAllBtn, PlayerGroupSingle(g_teller), true);
    // 【发送给特定玩家】（用户 2026-11-06）：剧本含告密者 / 疯子时，原【发送给所有恶魔】改为打开这个弹窗；
    //   按当前剧本决定出现哪几个目标（所有恶魔始终有，爪牙看告密者，疯子看疯子），并提供【取消】。
    //   面板本身不再加高，避免遮挡魔典和日志。
    DialogCreate(360, 260, c_anchorCenter, 0, 0, false);
    g_bluffTgtDlg = DialogLastCreated();
    DialogSetVisible(g_bluffTgtDlg, PlayerGroupAll(), false);
    BOTC_FrameSilver(g_bluffTgtDlg, 360, 260);
    g_bluffTgtTitle = BOTC_NewLabel(g_bluffTgtDlg, 320, 28, 20, 14, StringToText("发送不在场身份给："));
    libNtve_gf_SetDialogItemStyle(g_bluffTgtTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bluffTgtTitle, false, PlayerGroupAll());
    g_bluffTgtBtn[0] = BOTC_NewButton(g_bluffTgtDlg, 280, 36, 40, 56, "所有恶魔");
    g_bluffTgtBtn[1] = BOTC_NewButton(g_bluffTgtDlg, 280, 36, 40, 102, "所有爪牙");
    g_bluffTgtBtn[2] = BOTC_NewButton(g_bluffTgtDlg, 280, 36, 40, 148, "所有疯子");
    g_bluffTgtCancelBtn = BOTC_NewButton(g_bluffTgtDlg, 280, 36, 40, 194, "取消");

    g_bluffSent = false;
    g_bluffTarget = 0;
    g_availN = 0;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
        g_bluffOut[i] = 0;
    }
    BOTC_BluffRender();
    DialogSetVisible(g_bluffDlg, PlayerGroupSingle(g_teller), true);
}

//--------------------------------------------------------------------------------------------------
// 【首夜不在场身份弹窗】（用户 2026-11-04）：爪牙互认（恶魔信息）时依次给说书人弹窗。
//   队列顺序：全场恶魔 → 疯子（若有）→ 告密者在场时逐个真爪牙。
//   每个收件人一份 3 个不在场身份，可【随机 3 个】/ 手动选 /【发送】/【取消】。
//--------------------------------------------------------------------------------------------------
void BOTC_BuildBluffAsk () {
    int i;
    int x;
    DialogCreate(760, 300, c_anchorCenter, 0, -40, false);
    g_bluffAskDlg = DialogLastCreated();
    DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
    BOTC_FrameSilver(g_bluffAskDlg, 760, 300);
    g_bluffAskTitle = BOTC_NewLabel(g_bluffAskDlg, 720, 30, 20, 10, StringToText("首夜不在场身份"));
    libNtve_gf_SetDialogItemStyle(g_bluffAskTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bluffAskTitle, false, PlayerGroupAll());
    g_bluffAskHint = BOTC_NewLabel(g_bluffAskDlg, 720, 52, 20, 42, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_bluffAskHint, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_bluffAskHint, false, PlayerGroupAll());
    for (i = 0; i < 3; i += 1) {
        x = 60 + (i * 240);
        // 【身份卡】（用户 2026-11-04）：正方形，中间头像，左下角角色名
        g_bluffAskBtn[i] = BOTC_NewButton(g_bluffAskDlg, 110, 110, x, 100, "");
        g_bluffAskIcon[i] = BOTC_NewImageItem(g_bluffAskDlg, 110, 110, x, 100, "botc_blank.dds");
        g_bluffAskName[i] = BOTC_NewLabel(g_bluffAskDlg, 102, 20, x + 4, 186, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_bluffAskName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_bluffAskName[i], false, PlayerGroupAll());
    }
    g_bluffAskRollBtn = BOTC_NewButton(g_bluffAskDlg, 200, 44, 40, 216, "随机 3 个");
    g_bluffAskSendBtn = BOTC_NewButton(g_bluffAskDlg, 200, 44, 280, 216, "发送");
    g_bluffAskCancelBtn = BOTC_NewButton(g_bluffAskDlg, 200, 44, 520, 216, "取消");
    BOTC_BluffAskRender();
}

void BOTC_BluffAskStart () {
    int i;
    int q;
    g_bluffAskQn = 0;
    g_bluffAskQi = 0;
    if (g_nightNum != 1) {
        return;
    }
    if (BOTC_LegionOn()) {
        return;
    }
    // 罂粟种植者只阻止互认（BOTC_SendFirstNightDemonInfo 已被跳过），
    // 不在场身份仍要照常发给恶魔与疯子。
    // 1) 全场所有恶魔（0 = 收件人为恶魔整体）
    if (BOTC_EvilSeatAt(1) >= 2) {
        g_bluffAskQ[g_bluffAskQn] = 0;
        g_bluffAskQn = g_bluffAskQn + 1;
    }
    // 2) 疯子（真疯子，哲学家假装的那个不算）
    q = BOTC_RealLunaticSeat();
    if (q >= 2 && q <= 13) {
        g_bluffAskQ[g_bluffAskQn] = q;
        g_bluffAskQn = g_bluffAskQn + 1;
    }
    // 3) 告密者在场：每个真爪牙各收一次（提线木偶不算；罂粟在场也生效）
    if (BOTC_AbilityInPlay(92)) {
        i = 2;
        while (i <= 14) {
            q = BOTC_EvilSeatAt(i);
            if (q < 2 || q > 13) {
                break;
            }
            if (g_bluffAskQn >= 14) {
                break;
            }
            g_bluffAskQ[g_bluffAskQn] = q;
            g_bluffAskQn = g_bluffAskQn + 1;
            i = i + 1;
        }
    }
    if (g_bluffAskQn <= 0) {
        return;
    }
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
    }
    g_bluffAskOn = true;
    BOTC_BluffAskRender();
}

void BOTC_BluffAskRender () {
    int i;
    int q;
    string s;
    if (!g_bluffAskOn) {
        DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
        return;
    }
    if (g_bluffAskQi < 0 || g_bluffAskQi >= g_bluffAskQn) {
        g_bluffAskOn = false;
        DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
        return;
    }
    q = g_bluffAskQ[g_bluffAskQi];
    if (q == 0) {
        s = "首夜不在场身份（发给全场所有恶魔）";
    }
    else {
        s = "首夜不在场身份（发给 " + BOTC_NameStr(q) + "）";
    }
    libNtve_gf_SetDialogItemText(g_bluffAskTitle, StringToText(s), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_bluffAskHint, StringToText("点【随机 3 个】自动填充，或点身份格手动选；【发送】给当前收件人，【取消】后可从右下角面板手动发送。"), PlayerGroupSingle(g_teller));
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemText(g_bluffAskBtn[i], StringToText(""), PlayerGroupSingle(g_teller));
        if (g_bluffPick[i] > 0 && g_bluffPick[i] <= 163) {
            s = g_roleName[g_bluffPick[i] - 1];
            libNtve_gf_SetDialogItemImage(g_bluffAskIcon[i], BOTC_IconName(g_bluffPick[i] - 1), PlayerGroupSingle(g_teller));
        }
        else {
            s = "选身份";
            libNtve_gf_SetDialogItemImage(g_bluffAskIcon[i], "botc_blank.dds", PlayerGroupSingle(g_teller));
        }
        libNtve_gf_SetDialogItemText(g_bluffAskName[i], StringToText(s), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_bluffAskDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BluffAskRoll () {
    if (!g_bluffAskOn) {
        return;
    }
    BOTC_BluffRoll();
    BOTC_BluffAskRender();
}

void BOTC_BluffAskPick (int slot) {
    if (!g_bluffAskOn) {
        return;
    }
    if (slot < 0 || slot > 2) {
        return;
    }
    g_pickMode[g_teller] = 50;
    g_pickBluffSlot[g_teller] = slot;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(slot + 1) + " 个不在场善良角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, true);
    DialogControlSetVisible(g_blockBtnPick, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_bluffAskDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_BluffAskSend () {
    int i;
    int q;
    if (!g_bluffAskOn) {
        return;
    }
    for (i = 0; i < 3; i += 1) {
        if (g_bluffPick[i] <= 0 || g_bluffPick[i] > 163) {
            BOTC_Notice(g_teller, "请先选满 3 个不在场身份（可以点【随机 3 个】）。");
            return;
        }
    }
    q = g_bluffAskQ[g_bluffAskQi];
    if (q == 0) {
        BOTC_BluffSendToDemons();
    }
    else {
        BOTC_BluffSendAt(q);
    }
    g_bluffAskQi = g_bluffAskQi + 1;
    if (g_bluffAskQi >= g_bluffAskQn) {
        g_bluffAskOn = false;
        DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
        BOTC_PmStore(g_teller, "【首夜不在场身份】已全部发送完毕。");
    }
    else {
        BOTC_BluffAskRender();
    }
}

void BOTC_BluffAskCancel () {
    int i;
    g_bluffAskOn = false;
    g_bluffAskQi = 0;
    g_bluffAskQn = 0;
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = 0;
    }
    DialogSetVisible(g_bluffAskDlg, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【首夜不在场身份】已取消；可从右下角【不在场身份】面板手动发送。");
}

//--------------------------------------------------------------------------------------------------
// 提名 / 投票
//--------------------------------------------------------------------------------------------------
string BOTC_CdImg (int sec) {
    if (sec < 0) {
        sec = 0;
    }
    if (sec > 10) {
        sec = 10;
    }
    if (sec == 10) {
        return "botc_cd10.dds";
    }
    return "botc_cd" + IntToString(sec) + ".dds";
}

string BOTC_NomHeadStr () {
    if (g_nomFrom > 0 && g_nomTo > 0) {
        return BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo);
    }
    return "提名环节";
}

string BOTC_NomHintStr () {
    // 【教派投票】（用户 2026-10-10）：这一行不写固定文案 —— 由 BOTC_CdRender 每半秒写成「倒计时：X 秒」
    if (g_phase == 0) {
        return "";
    }
    if (g_phase == 1) {
        return "";                      // 小字提示删掉（用户 2026-09-22）：改成屏幕正中那条大字提示
    }
    if (g_phase == 2) {
        return BOTC_NameStr(g_nomPickBy) + " 正在选择提名对象。";
    }
    if (g_phase == 3) {
        if (g_nomFrom == g_nomTo) {
            return BOTC_NameStr(g_nomFrom) + " 提名自己（只需发言一次，最多 60 秒），说完点右下角【结束发言】。";
        }
        return BOTC_NameStr(g_nomFrom) + " 陈述提名理由（最多 60 秒），说完点右下角【结束发言】。";
    }
    if (g_phase == 4) {
        return BOTC_NameStr(g_nomTo) + " 反驳（最多 60 秒），说完点右下角【结束发言】。";
    }
    if (g_phase == 5) {
        return "投票中：点【投票】或【弃权】，倒计时结束前都可以改（死者一人只有一张票，弃权不用掉）。";
    }
    return "投票已结束，不能再改票。说书人确认后点【结束本次提名】。";
}

// 倒计时显示的唯一出处：界面重建（BOTC_NomUI）和每半秒的刷新（BOTC_Tick_Func）都调这里，
// 这样重建界面时不会把倒计时图片打回默认的"10"。
//   阶段 3 / 4：把"（剩余 N 秒）"拼在提示行后面
//   阶段 5   ：按计时器真实剩余秒数画倒计时图片
void BOTC_CdRender () {
    int sec;
    fixed rem;
    int imgSec;
    string hint;
    string sub;
    // 【只更新变化的部分】（用户 2026-11-04）：每半秒重写文字会让整行闪烁，只有内容变了才写
    //   text 是句柄，比较永远不相等，必须存 string 源文才能真正跳过未变化的重写。
    hint = BOTC_NomHintStr();
    if (hint != g_cdHintLast) {
        libNtve_gf_SetDialogItemText(g_nomHint, BOTC_NameSubst(hint), PlayerGroupAll());
        g_cdHintLast = hint;
    }
    sub = "";
    imgSec = -1;
    // 炸弹人的 10 秒指向投票复用提名倒计时素材。
    if (g_boomVoteOn) {
        rem = TimerGetRemaining(g_tVote);
        sec = FixedToInt(rem);
        if (sec < 1) {
            sec = 1;
        }
        imgSec = sec;
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    }
    else {
        if (g_phase == 3 || g_phase == 4) {
            rem = TimerGetRemaining(g_tSpeech);
            sec = FixedToInt(rem);
            if (sec < 0) {
                sec = 0;
            }
            sub = "（剩余 " + IntToString(sec) + " 秒）";
        }
        // 【发起提名 · 选人倒计时】（用户 2026-11-02）：10 秒内没选玩家会自动取消
        if (g_phase == 2 && g_nomPickBy >= 1 && g_nomPickBy <= 13) {
            sec = (g_nomPickSec[g_nomPickBy] + 1) / 2;
            if (sec < 0) {
                sec = 0;
            }
            sub = "（剩余 " + IntToString(sec) + " 秒）";
        }
        // 【教派投票】（用户 2026-10-10）：提示行写成活动倒计时（写法照抄上面提名"反驳"那一支）
        if (g_cultOn) {
            rem = TimerGetRemaining(g_tVote);
            sec = FixedToInt(rem);
            if (sec < 0) {
                sec = 0;
            }
            sub = "倒计时：" + IntToString(sec) + " 秒";
        }
        if (g_phase == 5 && !g_cultOn) {       // 【教派投票】不画那个倒计时图
            rem = TimerGetRemaining(g_tVote);
            sec = FixedToInt(rem);
            if (sec < 0) {
                sec = 0;
            }
            imgSec = sec;
        }
    }
    if (sub != g_cdSubLast) {
        libNtve_gf_SetDialogItemText(g_nomCd, StringToText(sub), PlayerGroupAll());
        g_cdSubLast = sub;
    }
    if (imgSec >= 0 && imgSec != g_cdImgLast) {
        libNtve_gf_SetDialogItemImage(g_cdLbl, BOTC_CdImg(imgSec), PlayerGroupAll());
        g_cdImgLast = imgSec;
    }
}

void BOTC_NomTally () {
    int yes;
    int no;
    int none;
    int k;
    int t;
    int q;
    int alive;
    int need;
    int w;
    bool dvTok;
    string s;
    yes = 0;
    no = 0;
    none = 0;
    dvTok = false;
    // 只统计在场的座位：空位不算「未投」
    BOTC_BuildSeatList();
    for (t = 0; t < g_seatN; t += 1) {
        q = g_seatList[t];
        if (g_vote[q] == 1) {
            if (BOTC_ButlerVoteCounts(q)) {
                w = BOTC_BansheeVoteWeight(q);
                yes = yes + w;
                if (g_voteWasDead[q] && w < 2) {
                    g_deadVoteUsed[q] = true;      // 这一票是「死后投的」而且真的记进票数了 → 他的死人票就此用掉
                    // 【已投票 token】（用户 2026-11-05）：只在**说书人**的魔典上自动打上，
                    //   其他观察者的魔典不自动同步，需要各自手动标记。
                    if (!g_tokOn[(((g_teller * 14) + q) * 256) + 181]) {
                        g_tokOn[(((g_teller * 14) + q) * 256) + 181] = true;
                        dvTok = true;
                    }
                }
            }
            else {
                no = no + 1;       // 街头风琴手局：主人没投赞成，管家这一票按弃权统计
            }
        }
        if (g_vote[q] == 2) {
            no = no + 1;
        }
        if (g_vote[q] == 0) {
            none = none + 1;
        }
    }
    if (dvTok) {
        BOTC_GrimRender(g_teller);     // 说书人魔典上补画「已投票」
    }
    alive = BOTC_AliveCount();
    need = (alive + 1) / 2;
    if (need < 1) {
        need = 1;
    }
    // 投票统计日志：一条完整记录（屏幕字幕和说书人私聊日志都不再弹统计）
    s = BOTC_PeriodStr() + " · " + BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo) + "：赞成 " + IntToString(yes) + "（";
    k = 0;
    for (t = 0; t < g_seatN; t += 1) {
        q = g_seatList[t];
        if (g_vote[q] == 1 && BOTC_ButlerVoteCounts(q)) {
            if (k > 0) {
                s = s + ",";
            }
            s = s + IntToString(q - 1);
            if (BOTC_BansheeVoteWeight(q) > 1) {
                s = s + "（2票）";
            }
            k = k + 1;
        }
    }
    if (k == 0) {
        s = s + "无";
    }
    s = s + " 号）／弃权 " + IntToString(no) + "／未投 " + IntToString(none) + "｜需 " + IntToString(need) + " 票，";
    if (yes >= need) {
        if (g_todoNew) {
            s = s + "达标并标记为待处决";
        }
        else {
            s = s + "达标但未超过当前待处决票数";
        }
    }
    else {
        s = s + "未达门槛";
    }
    if (BOTC_OrganActive()) {
        for (q = 2; q <= 13; q += 1) {
            g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
        }
        if (g_todoSeat >= 2) {
            g_tokOn[((((g_teller * 14) + g_todoSeat) * 256) + 165)] = true;
        }
        BOTC_PmStore(g_teller, "【街头风琴手·秘密票数】" + s);
        BOTC_GrimRender(g_teller);
        // 官网口径：不公开票数、门槛和投票人名单；完整记录只给说书人。
        s = BOTC_PeriodStr() + " · " + BOTC_NameStr(g_nomFrom) + " 提名 " + BOTC_NameStr(g_nomTo) + "：投票已秘密统计（票数与投票人保密）";
        BOTC_VoteLogAdd(s);
        return;
    }
    for (q = 2; q <= 13; q += 1) {
        g_tokOn[((((g_teller * 14) + q) * 256) + 165)] = false;
    }
    BOTC_VoteLogAdd(s);
}

// 存活人数 = 在场的参与者 - 说书人标了「死亡」token 的座位
int BOTC_AliveCount () {
    int q;
    int n;
    playergroup ag;
    ag = PlayerGroupActive();
    n = 0;
    for (q = 2; q <= 13; q += 1) {
        if (PlayerGroupHasPlayer(ag, g_who[q])) {      // 【座位机制】q 是格子 → 问"坐这格的人"在不在
            if (!BOTC_PublicDead(q)) {
                n = n + 1;
            }
        }
    }
    return n;
}

void BOTC_NomUI () {
    int i;
    int ob;
    int pb;
    int ps;
    bool organBlind;
    string s;
    organBlind = BOTC_OrganActive();
    BOTC_BsBtnRender();
    BOTC_FakeBtnRender();          // 板子里有间谍 / 寡妇时才给说书人显示【伪造魔典】
    // 阶段锁：只有发牌 / 开始按钮按阶段和开局状态显隐；
    // 日志、魔典、角色能力表在提名阶段也能看（魔典始终能关）
    DialogControlSetVisible(g_grimClose, PlayerGroupAll(), true);
    DialogControlSetVisible(g_grimDeal, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimConfirm, PlayerGroupAll(), false);
    DialogControlSetVisible(g_rsOpenBtn, PlayerGroupAll(), false);
    // 开局前提示：只在「选择剧本」页面显示（用户 2026-11-01）
    DialogSetVisible(g_preDlg, PlayerGroupAll(), false);
    if (g_boardOpen) {
        BOTC_PreNoticeRender();        // 换说书人后那行名字要跟着更新（用户 2026-11-01）
        DialogSetVisible(g_preDlg, PlayerGroupAll(), true);
    }
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupAll(), false);
    if (g_phase == 0 && !g_gameOver) {
        // 发牌 / 确认发放：只要点了【游戏正式开始】（g_startPending）就**立刻**收掉（用户 2026-09-17）
        if (!g_started && !g_startPending) {
            DialogControlSetVisible(g_grimDeal, PlayerGroupSingle(g_teller), true);
            DialogControlSetVisible(g_grimConfirm, PlayerGroupSingle(g_teller), true);
            DialogControlSetVisible(g_rsOpenBtn, PlayerGroupSingle(g_teller), true);
        }
        DialogControlSetVisible(g_grimStart, PlayerGroupSingle(g_teller), true);
    }
    // 处决 / 死亡标记按钮：正式开局之前隐藏（用户 2026-11-06），开局后说书人任何阶段都能按
    //   （刚投完票就要标记处决）
    if (g_started) {
        DialogControlSetVisible(g_execBtn, PlayerGroupSingle(g_teller), true);
        DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(g_teller), true);
    }
    for (ob = 1; ob <= 13; ob += 1) {
        DialogSetVisible(g_logBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_grimBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_abBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_tipBtnDlg[ob], PlayerGroupSingle(ob), true);
        DialogSetVisible(g_noteBtnDlg[ob], PlayerGroupSingle(ob), true);
    }
    // 发起提名：阶段 1，且今天还没发起过
    DialogControlSetVisible(g_nomStart, PlayerGroupAll(), false);
    // 【进入夜晚】【进入提名环节】【聊天：...】这三个：**正式开局（10 秒倒数走完）之前一律藏起来**（用户 2026-09-17）
    DialogSetVisible(g_nightBtnDlg, PlayerGroupSingle(g_teller), g_started);
    DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    DialogSetVisible(g_chatBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight));
    // 【邪恶小窗】：只有「正式开局之后的白天」给说书人看（入夜会自动关、按钮也收起来）
    DialogSetVisible(g_evilBtnDlg, PlayerGroupSingle(g_teller), (g_started && !g_isNight && g_evilEnable));
    BOTC_EvilBtnRender();
    // 顶部那条「提名阶段 / 谁提名谁」只在提名阶段显示，自由阶段藏掉
    DialogControlSetVisible(g_nomHead, PlayerGroupAll(), (g_phase != 0));
    // 【强制玩家发起提名】（用户 2026-11-03）：只在自由提名阶段给说书人用
    DialogControlSetVisible(g_fnBtn, PlayerGroupAll(), false);
    if (g_phase == 1) {
        DialogControlSetVisible(g_fnBtn, PlayerGroupSingle(g_teller), true);
    }
    else {
        // 不在自由提名阶段 → 顺手把已经打开的弹窗收掉
        DialogSetVisible(g_fnDlg, PlayerGroupAll(), false);
    }
    if (g_phase == 1 && g_nomStartOn) {
        // 【换过说书人也要给】（用户 2026-10-09）：原来写死"2..13"，而 1 号位换过之后可能是普通玩家 ----
        //   说书人不管坐在哪个物理座位都不发起提名（按 g_teller 判），g_nomUsed 是**格子**表（要 BOTC_PosOf）。
        for (pb = 1; pb <= 13; pb += 1) {
            ps = BOTC_PosOf(pb);
            if (pb != g_teller && ((!BOTC_SeatDead(ps) && !g_nomUsed[ps]) || BOTC_BansheeCanNominate(ps)) && g_nomPickCool[ps] <= 0) {
                DialogControlSetVisible(g_nomStart, PlayerGroupSingle(pb), true);
            }
        }
    }
    // 结束发言
    DialogControlSetVisible(g_nomEnd, PlayerGroupAll(), false);
    if (g_phase == 3) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupSingle(g_who[g_nomFrom]), true);
    }
    if (g_phase == 4) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupSingle(g_who[g_nomTo]), true);
    }
    // 说书人只保留一个【强制下一阶段】，不再显示【结束发言】（用户 2026-11-02）
    // 强制下一阶段（说书人）
    DialogControlSetVisible(g_nomForce, PlayerGroupAll(), false);
    if (g_phase >= 2) {
        DialogControlSetVisible(g_nomForce, PlayerGroupSingle(g_teller), true);
    }
    if (g_phase == 6) {
        libNtve_gf_SetDialogItemText(g_nomForce, StringToText("结束本次提名"), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_nomForce, StringToText("强制下一阶段"), PlayerGroupSingle(g_teller));
    }
    // 【教派投票】（用户 2026-10-10）：这一轮不该出现【结束发言 / 强制下一阶段】，收掉
    if (g_cultOn) {
        DialogControlSetVisible(g_nomEnd, PlayerGroupAll(), false);
        DialogControlSetVisible(g_nomForce, PlayerGroupAll(), false);
    }
    // 投票 / 弃权
    DialogControlSetVisible(g_voteYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteNo, PlayerGroupAll(), false);
    if (g_phase >= 3 && g_phase <= 5) {       // 用户 2026-09-19：选目标（阶段 2）时先不显示投票
        DialogControlSetVisible(g_voteYes, PlayerGroupAll(), true);
        DialogControlSetVisible(g_voteNo, PlayerGroupAll(), true);
        // 说书人不投票
        DialogControlSetVisible(g_voteYes, PlayerGroupSingle(g_teller), false);
        DialogControlSetVisible(g_voteNo, PlayerGroupSingle(g_teller), false);
        // 【教派投票】（用户 2026-10-10）：这两颗按钮走的就是这一支 —— 对**除说书人以外**的所有玩家显示
        //   （教派投票也在 phase 5，所以其他玩家同样看得到）
    }
    // 文案与投票标记
    libNtve_gf_SetDialogItemText(g_nomHead, BOTC_NameSubst(BOTC_NomHeadStr()), PlayerGroupAll());   // 提名标题：名字换成真名
    // 【教派投票】（用户 2026-10-10）：标题走自己那个标签（左移 80），提名标题与【进入提名环节】按钮这一轮都收起来
    if (g_cultOn) {
        libNtve_gf_SetDialogItemText(g_cultHead, BOTC_PlayerNameText(g_cultWho) + StringToText(" 邀请所有人加入他的教派"), PlayerGroupAll());
        DialogControlSetVisible(g_cultHead, PlayerGroupAll(), true);
        DialogControlSetVisible(g_nomHead, PlayerGroupAll(), false);
        DialogSetVisible(g_nomBtnDlg, PlayerGroupSingle(g_teller), false);
    }
    else {
        DialogControlSetVisible(g_cultHead, PlayerGroupAll(), false);
    }
    libNtve_gf_SetDialogItemText(g_nomHint, BOTC_NameSubst(BOTC_NomHintStr()), PlayerGroupAll());
    g_cdHintLast = BOTC_NomHintStr();      // 已经写过提示行，同步缓存，避免下面 BOTC_CdRender 再写一遍
    // 【倒计时不要先清空】（用户 2026-11-04）：阶段 3/4 的「剩余 X 秒」由末尾 BOTC_CdRender 统一刷新；
    //   这里清空后缓存仍是旧值，CdRender 会以为没变化而跳过，文字要等下一秒才回来，看起来就是闪烁。
    if (!g_boomVoteOn && (g_cultOn || (g_phase >= 2 && g_phase <= 4))) {
        g_cdSubLast = "";                  // 有秒数要显示：清缓存，让下面那次 CdRender 立即重写当前秒数
    }
    else {
        libNtve_gf_SetDialogItemText(g_nomCd, StringToText(""), PlayerGroupAll());
        g_cdSubLast = "";
    }
    for (i = 0; i < 12; i += 1) {
        ob = i + 2;
        if (g_vote[ob] == 1) {
            s = "botc_voted.dds";
        }
        else {
            if (g_vote[ob] == 2) {
                s = "botc_abstain.dds";
            }
            else {
                s = "botc_blank.dds";
            }
        }
        if (organBlind) {
            s = "botc_blank.dds";          // 街头风琴手：投票标记也隐藏
        }
        libNtve_gf_SetDialogItemImage(g_voteTag[ob], s, PlayerGroupAll());
        DialogControlSetVisible(g_voteTag[ob], PlayerGroupAll(), !organBlind);
        // 图片是裁剪显示的，所以控件尺寸必须和图片一致（110x34），只调整位置
        DialogControlSetSize(g_voteTag[ob], PlayerGroupAll(), 99, 31);
        DialogControlSetPosition(g_voteTag[ob], PlayerGroupAll(), c_anchorTopLeft, g_seatX[ob - 2] - 50, g_seatY[ob - 2] - 54);
        // 票数与待处决标记（所有人可见）
        if (g_boomResult) {
            libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(IntToString(g_boomCount[ob]) + "票"), PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
        }
        else {
            if (g_nomVotes[ob] > 0 && !organBlind) {
                libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(IntToString(g_nomVotes[ob]) + "票"), PlayerGroupAll());
                if (g_nomPass[ob]) {
                    libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_todo.dds", PlayerGroupAll());
                }
                else {
                    libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
                }
            }
            else {
                // 【被提名但没有票】（用户 2026-11-04）：显示「被提名」，不再是一片空白。
                if (g_nomTargeted[ob]) {
                    libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText("被提名"), PlayerGroupAll());
                }
                else {
                    libNtve_gf_SetDialogItemText(g_markTag[ob], StringToText(""), PlayerGroupAll());
                }
                libNtve_gf_SetDialogItemImage(g_todoTag[ob], "botc_blank.dds", PlayerGroupAll());
            }
        }
        DialogControlSetSize(g_todoTag[ob], PlayerGroupAll(), 108, 31);
        DialogControlSetPosition(g_todoTag[ob], PlayerGroupAll(), c_anchorTopLeft, g_seatX[ob - 2] - 54, g_seatY[ob - 2] + 79);
        // ★ 提名阶段也显示 ＋（用户 2026-09-17：提名时也能在魔典上打 token）
        if (g_seatOn[ob]) {
            DialogControlSetVisible(g_grimTokBtn[ob], PlayerGroupAll(), true);
        }
        else {
            DialogControlSetVisible(g_grimTokBtn[ob], PlayerGroupAll(), false);
        }
    }
    // 【说书人那一格】：被提名 / 票数 / 待处决（用户 2026-11-04）
    if (g_boomResult) {
        libNtve_gf_SetDialogItemText(g_markTag[1], StringToText(""), PlayerGroupAll());
        libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_blank.dds", PlayerGroupAll());
    }
    else {
        if (g_nomVotes[1] > 0 && !organBlind) {
            libNtve_gf_SetDialogItemText(g_markTag[1], StringToText(IntToString(g_nomVotes[1]) + "票"), PlayerGroupAll());
            if (g_nomPass[1]) {
                libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_todo.dds", PlayerGroupAll());
            }
            else {
                libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_blank.dds", PlayerGroupAll());
            }
        }
        else {
            if (g_nomTargeted[1]) {
                libNtve_gf_SetDialogItemText(g_markTag[1], StringToText("被提名"), PlayerGroupAll());
            }
            else {
                libNtve_gf_SetDialogItemText(g_markTag[1], StringToText(""), PlayerGroupAll());
            }
            libNtve_gf_SetDialogItemImage(g_todoTag[1], "botc_blank.dds", PlayerGroupAll());
        }
    }
    // 倒计时面板：这里只管显不显示，图片内容统一交给 BOTC_CdRender 按真实剩余秒数画
    if ((g_phase == 5 && !g_cultOn) || g_boomVoteOn) {       // 炸弹人复用提名投票倒计时
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), true);
    }
    else {
        DialogSetVisible(g_cdDlg, PlayerGroupAll(), false);
    }
    // 必须放在最后：秒数要写在上面那句 BOTC_NomHintStr() 赋值之后，否则会被覆盖
    // 【阶段 2 也要画】：选提名对象时同样有「剩余 X 秒」，不在这里补画会先空半秒再恢复
    if (g_phase >= 2 && g_phase <= 5) {
        BOTC_CdRender();
    }
    // 【快进到提名】按钮：提名阶段 / 夜晚 / 没开局一律收起（每次切阶段都刷一次）
    BOTC_SkipRender();
    BOTC_GrimShareRender();       // 玩家魔典右下角：一键发送魔典
}

// 【把所有人开着的「声称」收掉】（用户 2026-10-12）：进提名环节那一刻调 ----
//   ① 声称面板还开着的（g_pickMode == 3）→ 关掉；
//   ② 已经点了【声称】、正在点头像选目标的（猎手 / 炼金术士 / 精神病患者 / 月之子）→ 标记一起复位；
//   被取消的人各提示一句（不然他以为自己还点着）。
void BOTC_DeclareCancelAll () {
    int p;
    for (p = 1; p <= 13; p += 1) {
        if (g_pickMode[p] == 3) {
            g_pickMode[p] = 0;
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：声称自动取消。");
            }
        }
        if (g_declarePick[p]) {
            g_declarePick[p] = false;
            g_psyDeclare[p] = false;
            g_moonDeclare[p] = false;
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：你这次声称自动取消了。");
            }
        }
        if (g_alcChoice[p] || g_alcPick[p]) {
            g_alcChoice[p] = false;
            g_alcPick[p] = false;
            g_alcRolePick[p] = 0;
            DialogSetVisible(g_alcDlg, PlayerGroupSingle(p), false);
            if (p != g_teller) {
                BOTC_Notice(p, "提名环节开始了：你这次炼金术士声称自动取消了。");
            }
        }
    }
    BOTC_DeclareRender();
}

void BOTC_PhaseSet (int ph) {
    g_phase = ph;
    // 【进提名环节 → 把大家开着的声称收掉】（用户 2026-10-12）
    if (ph >= 1) {
        BOTC_DeclareCancelAll();
    }
    BOTC_NomUI();
    // 选人提示（用户 2026-09-19）：用白天/夜晚大字那块地方，选人期间一直挂着
    if (ph == 2) {
        BOTC_BigHintShowMid(1, "选择一个玩家。");
    }
    else {
        // 【一次提名结束后提示要回来】（用户 2026-09-22）----
        //   只有「刚开环节」（g_nomJustOpen，4 个大字还在演）时不挂；
        //   其余任何回到自由提名（phase 1）的时候都把「点【发起提名】选人」重新挂上。
        if (ph == 1 && !g_nomJustOpen) {
            BOTC_BigHintShowMid(1, "点【发起提名】选人");
        }
        else {
            BOTC_BigHintHide(g_teller);
        }
    }
}

// 【公开还活着的人数】（用户 2026-10-03）：按打红叉的人数倒推（不含说书人）---- 僵怖假死时也算「公开已死」，
//   这样提名 BGM 的小局判定不会因为僵怖露馅（原来用 BOTC_AliveCountTrue 会把他算成活人）。
int BOTC_AliveCountPublic () {
    int i;
    int total;
    int dead;
    total = 0;
    dead = 0;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) {
            continue;
        }
        total = total + 1;
        if (BOTC_PublicDead(i)) {
            dead = dead + 1;
        }
    }
    return total - dead;
}
void BOTC_NomOpen () {
    int ob;
    // 开环节前按在场人数把圆桌摆成圈（没人的座位不会占位）
    BOTC_GrimRelayout();
    // 【快进到提名】进入提名阶段：上面的票数清空（按钮本身也会被 BOTC_SkipRender 收起来）
    BOTC_SkipReset();
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    g_boomResult = false;
    for (ob = 2; ob <= 13; ob += 1) {
        g_vote[ob] = 0;
        g_boomCount[ob] = 0;
    }
    libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("结束提名环节"), PlayerGroupSingle(g_teller));
    g_nomJustOpen = true;              // 刚开环节：提示等「提名开始」那 4 个字收掉再挂（见 NomBigTimer）
    g_nomStartOn = false;              // 【发起提名】先锁上：等「提名开始」4 个大字收掉、提示挂上那一刻再开（见 BOTC_NomBigTimer_Func）
    BOTC_PhaseSet(1);
    g_nomJustOpen = false;
    // 【进入提名阶段：自动解散除说书人以外的私聊】（用户 2026-11-02）
    BOTC_DissolveAllSess(true);
    BOTC_ChatModeSet(2);
    BOTC_PullAllToPublic();
    // 【提名提示改到动画之后出现】（用户 2026-09-22）：以前在这里就挂上「点【发起提名】选人」，
    //   会跟屏幕正中那 4 个「提名开始」大字撞在一起 ---- 现在改到那 4 个字收掉时再挂。
    //   （挂的位置 / 时机看 BOTC_NomBigTimer_Func 里那条 g_nomBigHold >= 2 的分支。）
    for (ob = 1; ob <= 13; ob += 1) {
        BOTC_GrimRender(ob);
    }
    // 魔典不马上弹：延迟 4 秒再弹（中间留给"现在是提名阶段"的大提示；
    //   这 4 秒里要是提名已经结束/入夜了，BOTC_NomPop_Func 就不会弹）
    TimerStart(g_tNomPop, 4.0, false, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("提名环节开始"));
    // 屏幕正中演「提名开始」4 个大字（一个一个浮现 → 3.75 秒一起收掉），同时放 timingkaishi
    BOTC_NomBigShow();
    // 提名阶段换一首音乐（白天才会换；夜里由 NightToggle 统一放夜晚那首）
    if (g_started && !g_isNight) {
        if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
            // 小局（**存活 ≤ 4 人**）：提名阶段用 timing2
            BOTC_MusicPlay(g_musicNomSmallName, 2, 4.0);
        }
        else {
            BOTC_MusicPlay(g_musicNomName, 2, 4.0);   // 优先级 2；也留 4 秒，等提示播完再进音乐
        }
    }
    // 【自由提名时间】（默认 30 秒，按开局「本局设置」投票）只有智能说书模式才倒数：有人提名（阶段 2..6）时暂停，
    //   这轮提名结束回到阶段 1 再接着倒数；倒数到 0 由 BOTC_NomFreeFunc 收掉环节。
    //   真人说书：不倒数，想开多久开多久（自己点【结束提名环节】收）。
    g_nomFreeOn = false;
}

// 提名开始 4 秒后：把魔典弹给全场（已经开着日志 / 能力表的人不弹，别盖住他们的面板）
bool BOTC_NomPop_Func (bool testConds, bool runActions) {
    int ob;
    if (!runActions) {
        return true;
    }
    if (g_phase == 0) {
        return true;                   // 提名已经结束了（甚至已经入夜）：不弹
    }
    // 兜底：万一提名 BGM 没放起来（比如那首已经在放、被 BOTC_MusicPlay 提前 return 了），
    //   这 4 秒的魔典弹出计时器到了也把【发起提名】开出来，免得玩家被锁死。
    if (g_phase == 1 && !g_nomStartOn) {
        g_nomStartOn = true;
        BOTC_NomUI();
    }
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), true);
    for (ob = 1; ob <= 13; ob += 1) {
        if (g_logOpen[ob] || g_abOpen[ob] || g_tipOpen[ob] || g_noOpen[ob]) {
            DialogSetVisible(g_grimDlg, PlayerGroupSingle(ob), false);
        }
    }
    return true;
}

void BOTC_NomCloseEx (bool toNight) {
    g_nomFreeOn = false;           // 环节收掉了：自由提名时间的倒数也停
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    BOTC_NomBigHide();             // 提名提前结束的话，那 4 个字也一起收掉
    libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("进入提名环节"), PlayerGroupSingle(g_teller));
    BOTC_PhaseSet(0);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("提名环节结束"));
    // 提名结束：回到公聊那首（如果紧接着就入夜，NightToggle 会再换成夜晚那首）
    if (g_started && !g_isNight) {
        BOTC_MusicDropPrio(1);               // 先放弃提名那一层的优先级
        BOTC_MusicPlay(BOTC_DayTrackName(), 1, 2.5);   // 小局会自动换成 gongliao2
    }
    // 【什么情况下自动入夜】（用户 2026-09-20 起，2026-09-26 再改）：
    //   现在只剩「智能说书自己的自动流程」（自由提名时间到点那条 BOTC_NomFreeFunc）还用「收环节 + 自动入夜」；
    //   真人说书点【结束提名环节】走的是 BOTC_NomCloseEx(false) ---- 只收环节，留在白天，入夜自己点【进入夜晚】。
    if (toNight) {
        if (g_started && !g_isNight) {
            BOTC_NightToggle();
        }
    }
}

// 收掉提名环节 + 自动入夜（只给智能说书的自动流程用；真人说书请调 BOTC_NomCloseEx(false)）
void BOTC_NomClose () {
    BOTC_NomCloseEx(true);
}

// 【提名环节】自由提名时间的倒数（每秒一拍）
//   阶段 1（没人正在提名）= 倒数；阶段 2..6（有提名在进行）= 暂停
//   倒数到 0：智能说书模式下有人过票就先按票数处决，然后收掉环节（收环节会自动入夜）
bool BOTC_NomFreeFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (!g_nomFreeOn) {
        return true;                   // 没在倒数（环节没开 / 已经收掉）
    }
    if (g_gameOver || g_isNight) {
        g_nomFreeOn = false;           // 已经分出胜负或已经入夜：停
        return true;
    }
    if (g_phase != 1) {
        return true;                   // 有提名正在进行：**暂停计时**（提名结束后回到阶段 1 继续）
    }
    g_nomFreeSec = g_nomFreeSec - 1;
    if (g_nomFreeSec <= 0) {
        g_nomFreeOn = false;
        BOTC_Ann("【提名】自由提名时间结束：本轮提名环节关闭");
        BOTC_NomClose();
        return true;
    }
    BOTC_NomUI();                      // 刷新提示行里的剩余秒数
    return true;
}

// 【音轨恢复】过场（猎手射杀 / 胜利结算）之后，按当前状态把该放的那首接回来
void BOTC_MusicResume () {
    BOTC_MusicStop();                      // 先把「静音轨」那层停掉（不然它优先级高、盖着不让新曲子进来）
    if (!g_started) {
        BOTC_MusicStart();                 // 还没正式开始：准备阶段那首
        return;
    }
    if (g_isNight) {
        BOTC_MusicPlay(g_musicNightName, 3, 2.5);
        return;
    }
    if (g_phase != 0) {
        // 提名环节还在：接回提名那首
        if (BOTC_AliveCountPublic() <= 4) {   // 用「打红叉」口径，别让僵怖露馅（用户 2026-10-03）
            BOTC_MusicPlay(g_musicNomSmallName, 2, 2.5);
        }
        else {
            BOTC_MusicPlay(g_musicNomName, 2, 2.5);
        }
        return;
    }
    BOTC_MusicPlay(BOTC_DayTrackName(), 1, 2.5);   // 白天：按时段那首
}

// 【猎手射中恶魔】的过场计时器：
//   一拍（2 秒后）= 放充能音 Raynor_PenetratorRoundChargeUp，并把下一拍设成 2.5 秒
//   二拍（再 2.5 秒后）= 放枪声 RaynorSnipeSound → 结算死亡（死亡（白天/其他）token + 红叉）
//                        → 然后马上恢复音轨
bool BOTC_SnipeFunc (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_snipeStage == 1) {
        BOTC_PlaySfx(g_sfxChargeName);
        g_snipeStage = 2;
        TimerStart(g_tSnipe, 2.5, false, c_timeGame);
        return true;
    }
    if (g_snipeStage == 2) {
        g_snipeStage = 0;
        BOTC_PlaySfx(g_sfxSnipeName);
        // 枪声这一刻才播「命中了恶魔」，紧跟着才是死亡播报（顺序：命中 → 死亡）
        if (g_snipeHunter >= 2 && g_snipeHunter <= 13) {
            BOTC_PubAnnounce(BOTC_NameStr(g_snipeHunter) + " 的猎杀命中了恶魔！");
        }
        if (g_snipeTarget >= 2 && g_snipeTarget <= 13) {
            // 白天死亡（其他）：红叉 + 公开播报 + 恶魔死亡后的传位 / 红唇女郎 / 胜负判定都走它
            BOTC_DeathToggle(g_snipeTarget, 2, 0);
        }
        g_snipeTarget = 0;
        // 【枪声命中后 2 秒再恢复音轨】
        g_snipeStage = 3;
        TimerStart(g_tSnipe, 2.0, false, c_timeGame);
        return true;
    }
    if (g_snipeStage == 3) {
        g_snipeStage = 0;
        g_snipeHunter = 0;
        BOTC_MusicResume();            // 恶魔死了 2 秒之后，把音轨接回来
    }
    return true;
}

void BOTC_NomWant (int p) {
    int i;
    if (g_phase != 1) {
        return;
    }
    // 【超时取消后的冷却】（用户 2026-11-02）：10 秒没选人取消后，5 秒内不能再发起
    if (g_nomPickCool[p] > 0) {
        BOTC_Notice(g_who[p], "刚取消过一次发起提名，请等 5 秒后再试。");
        return;
    }
    // 【死人不能提名】（用户 2026-09-22）：普通死者不能发起提名；已获得能力的报丧女妖例外。
    if (BOTC_SeatDead(p) && !BOTC_BansheeDeadPower(p)) {
        BOTC_Notice(g_who[p], "你已经死了：普通死者不能发起提名。只有已获得能力且当前能力生效的报丧女妖可以提名。");
        return;
    }
    if (g_nomUsed[p] && !BOTC_BansheeCanNominate(p)) {
        if (BOTC_BansheeDeadPower(p)) {
            BOTC_Notice(g_who[p], "你的两次提名都已经用完了。");
        }
        else {
            BOTC_Notice(g_who[p], "你今天已经发起过提名了。");
        }
        return;
    }
    if (BOTC_ProtectTokOn(p, 101)) {
        BOTC_Notice(g_who[p], "魔像这一局只能发起一次提名（已经用过了）。");
        return;
    }
    // 新一轮提名：清掉上一轮的投票
    g_boomResult = false;
    for (i = 2; i <= 13; i += 1) {
        g_vote[i] = 0;
        g_boomCount[i] = 0;
    }
    g_nomPickBy = p;
    g_nomPickSec[p] = 20;          // 10 秒（0.5 秒一拍）
    BOTC_PhaseSet(2);
    BOTC_Notice(g_who[p], "点你要提名的玩家座位（10 秒内不选会自动取消）。");
}

void BOTC_NomPick (int p, int q) {
    int i;
    if (g_phase != 2) {
        return;
    }
    if (p != g_nomPickBy) {
        return;
    }
    if (q < 2 || q > 13) {
        if (q != 1) {
            return;
        }
    }
    if (g_nomTargeted[q]) {
        BOTC_Notice(g_who[p], BOTC_NameStr(q) + " 今天已经被提名过了，换一个。");
        return;
    }
    g_nomFrom = p;
    BOTC_WitchNomCheck(p);      // 【女巫（65）】（用户 2026-09-21）：被诅咒的人发起提名 → 当场死亡
    g_nomTo = q;
    g_vizierSeat = q;
    g_vizierGood = 0;
    for (i = 1; i <= 13; i += 1) {
        g_vizierClaimed[i] = false;
    }
    g_nomFromOf[q] = p;         // 【恐惧之灵(102)】（用户 2026-10-04）：处决时要查「是不是恐惧之灵本人提的名」
    g_nomPickSec[p] = 0;
    g_nomPickBy = 0;
    if (g_nomUsed[p]) {
        g_bansheeSecondNom[p] = true;
    }
    g_nomUsed[p] = true;
    g_nomTargeted[q] = true;
    // 【梦殒春宵】城镇公告员（52）：爪牙发起提名 → 在他身上打「爪牙已提名」（用户 2026-09-21）
    if (BOTC_RoleTeam(BOTC_SeatTrueRole(p)) == 2 || BOTC_SeatTrueRole(p) == 94) {
        BOTC_TokMarkRole(52, 88, BOTC_NameStr(p) + " 是爪牙，今天提名过");
    }
    BOTC_PubLine("【提名】" + BOTC_NameStr(p) + " 提名 " + BOTC_NameStr(q));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, BOTC_PlayerNameText(p) + StringToText(" 提名 ") + BOTC_PlayerNameText(q));
    if (BOTC_HasAbility(p, 81)) {
        g_tokOn[(((g_teller * 14) + p) * 256) + 101] = true;
        BOTC_GrimRender(g_teller);
        BOTC_GolemAsk(p, q);
    }

    // 贞洁者：被提名的是贞洁者时，可能立刻处决提名者并直接进夜晚（处理完就不再走发言流程）
    if (BOTC_VirginCheck(g_nomFrom, g_nomTo)) {
        return;
    }
    // 先启动计时器再切阶段：切阶段会立刻刷新倒计时，必须先有新计时器的值
    libNtve_gf_StopTimer(g_tSpeech);
    TimerStart(g_tSpeech, 60.0, false, c_timeGame);
    BOTC_PhaseSet(3);
}

void BOTC_SpeechAdvance () {
    if (g_phase == 5) {
        // 说书人可以在 10 秒走完前直接结束投票，结算方式与倒计时到点完全一致
        BOTC_VoteDone();
        return;
    }
    if (g_phase == 3) {
        // 自己提名自己：只需要发言一次，直接进入投票倒计时
        if (g_nomFrom == g_nomTo) {
            libNtve_gf_StopTimer(g_tSpeech);
            libNtve_gf_StopTimer(g_tVote);
            TimerStart(g_tVote, 10.0, false, c_timeGame);       // 提名阶段的投票倒计时：10 秒（用户 2026-09-19 明确要保持 10）
            if (BOTC_OrganActive()) { BOTC_PubAnnounce("【街头风琴手】请所有玩家闭眼投票，票数秘密统计。"); }
            BOTC_PhaseSet(5);
            return;
        }
        libNtve_gf_StopTimer(g_tSpeech);
        TimerStart(g_tSpeech, 60.0, false, c_timeGame);
        BOTC_PhaseSet(4);
        return;
    }
    if (g_phase == 4) {
        libNtve_gf_StopTimer(g_tSpeech);
        libNtve_gf_StopTimer(g_tVote);
        TimerStart(g_tVote, 10.0, false, c_timeGame);       // 提名阶段的投票倒计时：10 秒（用户 2026-09-19 明确要保持 10）
        if (BOTC_OrganActive()) { BOTC_PubAnnounce("【街头风琴手】请所有玩家闭眼投票，票数秘密统计。"); }
        BOTC_PhaseSet(5);
        return;
    }
    if (g_phase == 2) {
        if (g_nomPickBy >= 1 && g_nomPickBy <= 13) {
            g_nomPickSec[g_nomPickBy] = 0;
        }
        g_nomPickBy = 0;
        BOTC_PhaseSet(1);
        return;
    }
    if (g_phase == 6) {
        // 本轮提名结束（处决与否由说书人之后单独操作）
        g_nomFrom = 0;
        g_nomTo = 0;
        if (g_nomPickBy >= 1 && g_nomPickBy <= 13) {
            g_nomPickSec[g_nomPickBy] = 0;
        }
        g_nomPickBy = 0;
        BOTC_PhaseSet(1);
        return;
    }
}

void BOTC_VoteSet (int p, int v) {
    bool bansheeVote;
    // 【投票为什么没算】（用户 2026-10-03）：不在投票时段点投票原来一句话都不说 -> 玩家完全不知道为什么无效
    if (g_phase < 2 || g_phase > 5) {
        BOTC_Notice(g_who[p], "现在不是投票时间：等说书人喊投票、倒计时出来的时候再点。");
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    // 【异教领袖的教派投票】（用户 2026-10-10）：这一轮**死人也能投，而且不消耗死人票** ——
    //   死人票「一局一次」那套限制、以及管家规则，在教派投票里全部不适用，点【投票】/【弃权】直接记下就行。
    if (g_cultOn) {
        g_vote[p] = v;
        g_voteWasDead[p] = false;
        BOTC_NomUI();
        return;
    }
    bansheeVote = BOTC_BansheeDeadPower(p);
    if (bansheeVote && v == 1) {
        BOTC_Notice(g_who[p], "报丧女妖能力：这一票计 2 票，并且不消耗死人票。");
    }
    // 【死人票】官方规则：死掉的人这一局**只能再投一次**。
    //   「用掉」= 这一票真的被**记进票数**（统计那一步，BOTC_NomTally）---- 在那之前改成弃权可以收回来。
    if (BOTC_SeatDead(p) && !bansheeVote) {
        if (v == 1) {
            if (g_deadVoteUsed[p]) {
                BOTC_Notice(g_who[p], "你已经用掉你那张死人票了：死者一局只能投一次（弃权不受限制）。");
                return;
            }
            BOTC_Notice(g_who[p], "这是你那张死人票：它被记进票数之后就用掉了（在那之前改弃权还能拿回来）。");
        }
        else {
            if (g_vote[p] == 1) {
                BOTC_Notice(g_who[p], "你改成弃权：那张死人票还没记进票数，这一局还能再投一次。");
            }
        }
    }
    // 管家规则：只有他昨晚选的主人先投了「有罪票」，他才能投有罪票；
    //   主人没投（或者弃权）时，管家这一票只能算弃权。管家自己中毒 / 酒鬼时不受这条限制。
    //   【管家已经死了就不管这条】（用户 2026-10-13）：死了的人是「死人票」，不该再被生前的主人卡住。
    if (v == 1 && !BOTC_OrganActive() && p == g_butlerSeat && g_butlerSeat >= 2 && !BOTC_SeatDead(p)) {
        if (!BOTC_SeatImpaired(p)) {
            if (g_butlerMaster >= 2) {
                if (g_vote[g_butlerMaster] != 1) {
                    g_vote[p] = 2;
                    BOTC_Notice(g_who[p], "管家规则：你的主人（" + BOTC_NameStr(g_butlerMaster) + "）还没投有罪票，你这一票只能算弃权。");
                    BOTC_NomUI();
                    return;
                }
            }
        }
    }
    // 【狂热者（110）】（用户 2026-10-10）：存活 ≥ 5 人时他必须在所有提名中投票 → 不给弃权
    if (v == 2 && BOTC_ZealotMustVote(p)) {
        BOTC_Notice(g_who[p], "狂热者规则：存活 ≥ 5，必须投票。");
        return;
    }
    g_vote[p] = v;
    // 【主人撤票 → 管家那一票跟着作废】（用户 2026-10-13）：管家是「主人先投有罪票，他才能投」，
    //   主人后来改成弃权时，管家已经举着的那一票要一起收掉（不然他会一直举着一张无效票）。
    if (v != 1 && !BOTC_OrganActive() && p == g_butlerMaster && g_butlerSeat >= 2) {
        if (g_vote[g_butlerSeat] == 1 && !BOTC_SeatImpaired(g_butlerSeat) && !BOTC_SeatDead(g_butlerSeat)) {
            g_vote[g_butlerSeat] = 2;      // 【不提示】（用户 2026-10-13）：直接把那一票收成弃权
        }
    }
    // 【记下这一票投出时他死没死】（用户 2026-10-02）：统计那一步只吃「投的时候就已经死了」的死人票；
    //   否则白天被猎手打死的玩家，会因为他活着时投过的票在统计时被判成「死人票已用掉」。
    if (v == 1) {
        g_voteWasDead[p] = BOTC_SeatDead(p);
    }
    else {
        g_voteWasDead[p] = false;
    }
    // 【梦殒春宵】卖花女孩（51）：恶魔投过票 → 在她身上打「恶魔已投票」（用户 2026-09-21）
    if (v == 1 && BOTC_RoleTeam(BOTC_SeatTrueRole(p)) == 3) {
        BOTC_TokMarkRole(51, 87, BOTC_NameStr(p) + " 是恶魔，今天投过票");
    }
    BOTC_NomUI();
}

void BOTC_VoteDone () {
    int i;
    int yes;
    int alive;
    int need;
    int nom;
    int good;
    yes = 0;
    good = 0;
    nom = g_nomTo;
    for (i = 2; i <= 13; i += 1) {
        if (g_vote[i] == 1) {
            if (BOTC_ButlerVoteCounts(i)) {
                yes = yes + BOTC_BansheeVoteWeight(i);
                if (BOTC_SeatRegAlign(i) == 0) {
                    good = good + 1;
                }
            }
        }
    }
    alive = BOTC_AliveCount();
    need = (alive + 1) / 2;
    if (need < 1) {
        need = 1;
    }
    if (g_nomTo > 0) {
        g_nomVotes[g_nomTo] = yes;
        // 唯一最高票：只有票数比当前最高的更高，才把待处决标记换过去
        if (yes >= need && yes > g_todoVotes) {
            g_todoSeat = g_nomTo;
            g_todoVotes = yes;
            g_todoNew = true;
        }
        else {
            g_todoNew = false;
        }
        for (i = 1; i <= 13; i += 1) {
            g_nomPass[i] = false;
            if (!BOTC_OrganActive() && i == g_todoSeat) {
                g_nomPass[i] = true;
            }
        }
    }
    BOTC_NomTally();
    if (BOTC_OrganActive()) {
        BOTC_PubAnnounce("【街头风琴手】投票结束，请所有玩家睁开眼睛。");
    }
    // 本轮结束：直接回到"可以继续发起提名"的状态，不需要说书人再点确认
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    BOTC_PhaseSet(1);
    BOTC_VizierAfterVote(nom, good);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("投票结束"));
}

void BOTC_NomReset () {
    int i;
    for (i = 1; i <= 13; i += 1) {        // 【含说书人】（用户 2026-10-03）：他每天也能被提名一次（原来从 2 开始，导致他头一次被提名后就再也不能被提名）
        g_nomUsed[i] = false;
        g_bansheeSecondNom[i] = false;
        g_nomTargeted[i] = false;
        g_nomFromOf[i] = 0;
        g_vote[i] = 0;
        g_voteWasDead[i] = false;
        g_nomVotes[i] = 0;
        g_nomPass[i] = false;
        g_vizierClaimed[i] = false;
        g_boomCount[i] = 0;
    }
    g_boomResult = false;
    g_vizierSeat = 0;
    g_vizierGood = 0;
    g_todoSeat = 0;
    g_todoVotes = 0;
    g_todoNew = false;
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    if (g_phase != 0) {
        libNtve_gf_SetDialogItemText(g_nomBtn, StringToText("进入提名环节"), PlayerGroupSingle(g_teller));
        BOTC_PhaseSet(0);
    }
    else {
        BOTC_NomUI();
    }
}

bool BOTC_SpeechTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // 【投票倒计时被旧发言计时器提前打断】（用户 2026-11-02）：只在陈述 / 反驳阶段响应；
    //   进入投票（阶段 5）后，上一轮遗留的 g_tSpeech 到点不能再触发 BOTC_VoteDone。
    if (g_phase != 3 && g_phase != 4) {
        return true;
    }
    BOTC_SpeechAdvance();
    return true;
}

bool BOTC_VoteTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (g_boomVoteOn) {
        BOTC_BoomVoteEnd();
        return true;
    }
    // 说书人提前结束过投票时，这个计时器仍在后台跑；到点时若已经不是投票阶段就忽略，
    // 免得把之后发起的新一轮提名打断
    if (g_phase != 5) {
        return true;
    }
    // 【教派投票】（用户 2026-10-10）：到点了不走"提名统计"，走教派的判定
    if (g_cultOn) {
        BOTC_CultEnd(true);
        return true;
    }
    BOTC_VoteDone();
    return true;
}

// 【-laugh】（用户 2026-09-22）：所有玩家可用；公聊大字体 + laugh 音效；全桌公用 30 秒冷却，冷却中完全静默
void BOTC_Laugh (int p) {
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    if (g_laughCd > 0) {
        return;
    }
    g_laughCd = 60;
    s = BOTC_NameTag(BOTC_PosOf(p)) + "爽朗的大笑！";
    g_chatWhoNow = BOTC_PosOf(p);
    BOTC_PubSayLine(p, s);
    g_chatWhoNow = 0;
    BOTC_PlaySfx("laugh");
}

// 【-laugh 冷却 + 复活动画】（用户 2026-09-22）：挂在 0.5 秒的 tick 上
void BOTC_LaughTick () {
    int q;
    if (g_laughCd > 0) {
        g_laughCd = g_laughCd - 1;
    }
    for (q = 2; q <= 13; q += 1) {
        if (g_revFxCt[q] <= 0) {
            continue;
        }
        g_revFxCt[q] = g_revFxCt[q] - 1;              // 红叉计数（12 拍 = 6 秒）
        if (g_revFxSnd[q] > 0) {
            g_revFxSnd[q] = g_revFxSnd[q] - 1;
            if (g_revFxSnd[q] <= 0) {
                g_revFxSnd[q] = 0;
                BOTC_PlaySfx("fuhuo");          // 音效第 4 秒播（用户 2026-09-22）
            }
        }
        if (g_revFxCt[q] <= 0) {
            g_revFxCt[q] = 0;
            g_deadShown[q] = false;             // 红叉第 6 秒才撤（用户 2026-09-22）
            BOTC_GrimRender(g_teller);
        }
    }
}

// 【玩家离开游戏】（用户 2026-10-02）：每半秒查一次 PlayerStatus，谁第一次变成「已离开」就在**公聊**播一句
//   「玩家N 离开了小镇」（2 = c_playerStatusLeft，直接写数字免得依赖常量名）；
//   「离开了小镇」四个字的红字由 BOTC_KeyColor 那张关键词表负责。
void BOTC_LeftCheck () {
    int q;
    int p;
    for (q = 2; q <= 13; q += 1) {
        if (g_leftShown[q]) {
            continue;
        }
        if (!g_seatOn[q]) {
            continue;
        }
        if (PlayerStatus(g_who[q]) != 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"在不在
            continue;
        }
        g_leftShown[q] = true;
        BOTC_PubAnnounce(BOTC_NameStr(q) + " 离开了小镇");
        if (!g_started) {
            // 【游戏未开始】直接删掉这个座位：重排后座位表会少一格
            BOTC_GrimRelayout();
            continue;
        }
        // 【游戏进行中】（用户 2026-11-03）：不再标记「已退出」，只保留座位和名字；
        //   活着的补蓝叉；已经死过的把原来的红叉改成蓝叉（退出图标统一为蓝色）。
        p = g_who[q];
        g_leftKeepP[p] = true;              // 座位保留到胜利结算后再移除
        g_leftDeadP[p] = true;              // 蓝叉（存活 / 已死亡都统一成蓝色）
        if (!BOTC_SeatDead(q)) {
            BOTC_MarkDeadPlain(q);
            g_zombFake[q] = false;          // 中途退出不是僵怖假死，按真死处理
            g_deadShown[q] = true;
            g_deadPending[q] = false;
        }
        BOTC_GrimRelayout();
        BOTC_CheckWin();
    }
    BOTC_TellerLeftHandover();
}

// 【说书人中途退出】（用户 2026-11-01 / 2026-11-03）：
//   ① 跟普通玩家一样在公聊播一句「[编号] 战网名 离开了小镇」；
//   ② 按场次统计里的**说书人场次 s** 挑还在游戏中的真人接手（已经退出的玩家不参与评选）：
//      未开始 → 场次最高者；进行中 → 先取「死亡玩家（不分阵营）且场次 ≥ 5」的最高者，
//      没有则取「善良阵营场次最高者」（不设最低场次）；
//   ③ 游戏已开始时，老说书人本人也按退出死亡处理（蓝叉，座位保留到结算）。
void BOTC_TellerLeftHandover () {
    int q;
    int p;
    int best;
    int bestS;
    int deadBest;
    int deadS;
    int goodBest;
    int goodS;
    int v;
    int seat;
    int oldTeller;
    if (g_teller < 1 || g_teller > 13) {
        return;
    }
    if (PlayerType(g_teller) != 1) {
        return;                            // 电脑说书人不会"退出游戏"，不触发自动交接
    }
    if (g_leftShown[1]) {
        return;
    }
    if (PlayerStatus(g_teller) != 2) {
        return;
    }
    g_leftShown[1] = true;
    BOTC_PubAnnounce(BOTC_SayToken(g_teller) + " 离开了小镇");
    oldTeller = g_teller;
    best = 0;
    bestS = 0;
    deadBest = 0;
    deadS = 0;
    goodBest = 0;
    goodS = 0;
    BOTC_BankInit();
    BOTC_BuildSeatList();
    // 【说书人继承规则】（用户 2026-11-03）：
    //   游戏未开始 → 直接取在场玩家中说书场次最高的；
    //   游戏进行中 → 第一优先：死亡玩家（不分阵营）中说书场次最高且至少 5 场；
    //                第二优先：善良阵营玩家，取说书场次最高（不设最低场次）；
    //   已经退出游戏的玩家不参与评选；场次并列时取玩家号较小的（循环顺序天然保证）。
    for (q = 2; q <= 13; q += 1) {
        if (!g_seatOn[q]) {
            continue;
        }
        p = g_who[q];
        if (p < 2 || p > 13) {
            continue;
        }
        if (PlayerType(p) != 1) {
            continue;
        }
        if (PlayerStatus(p) == 2) {
            continue;
        }
        BOTC_BankReloadFor(p);
        v = BOTC_StatsOwnGet(g_bank[p], "s");
        if (!g_started) {
            if (best == 0 || v > bestS) {
                best = p;
                bestS = v;
            }
            continue;
        }
        if (BOTC_SeatDead(q)) {
            if (v >= 5 && (deadBest == 0 || v > deadS)) {
                deadBest = p;
                deadS = v;
            }
        }
        if (BOTC_SeatAlign(q) == 0) {
            if (goodBest == 0 || v > goodS) {
                goodBest = p;
                goodS = v;
            }
        }
    }
    if (g_started) {
        if (deadBest != 0) {
            best = deadBest;
        }
        else if (goodBest != 0) {
            best = goodBest;
        }
        else {
            best = 0;
        }
    }
    if (best == 0) {
        // 兜底：座位表还没搭好 / 统计全是 0 时，按进房顺序找下一个在场真人接手
        best = BOTC_FirstPresentSeat();
    }
    if (best == 0) {
        BOTC_GrimRelayout();
        return;
    }
    seat = BOTC_PosOf(best);
    if (seat < 2 || seat > 13) {
        return;
    }
    BOTC_TellerHandover(best, seat);
    if (!g_started) {
        BOTC_GrimRelayout();
        return;
    }
    // 【交接后老说书人落在新说书人原来那一格】：退出即死亡，打蓝叉并保留到结算
    q = BOTC_PosOf(oldTeller);
    if (q >= 2 && q <= 13) {
        if (!BOTC_SeatDead(q)) {
            BOTC_MarkDeadPlain(q);
        }
        g_zombFake[q] = false;
        g_deadShown[q] = true;
        g_deadPending[q] = false;
        g_leftKeepP[oldTeller] = true;
        g_leftDeadP[oldTeller] = true;
    }
    BOTC_GrimRelayout();
    BOTC_CheckWin();
}

//==================================================================================================
// 【投票踢人】（用户 2026-10-02）
//   发 -kick → 弹魔典点座位 → 发起投票；公聊播报 + 屏幕中间无背景对话框（是 / 否 + 底部票数）；
//   赞成票到「在场人数的 2/3（向上取整）」就 KickFromGame；60 秒没投完作废。被踢的人不能投自己。
//==================================================================================================
void BOTC_BuildKick () {
    DialogCreate(700, 240, c_anchorCenter, 0, 0, false);
    g_kickDlg = DialogLastCreated();
    DialogSetImageVisible(g_kickDlg, false);              // 隐藏背景（用户要求）
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), false);
    g_kickTitle = BOTC_NewLabel(g_kickDlg, 700, 34, 150, 20, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_kickTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_kickTitle, false, PlayerGroupAll());
    g_kickYes = BOTC_NewButton(g_kickDlg, 160, 40, 60, 140, "是");
    g_kickNo = BOTC_NewButton(g_kickDlg, 160, 40, 480, 140, "否");
    g_kickCnt = BOTC_NewLabel(g_kickDlg, 700, 26, 250, 195, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_kickCnt, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_kickCnt, false, PlayerGroupAll());
}

// 场上人数（在座、还没走的）
int BOTC_KickPresentN () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2) {
            continue;
        }
        if (PlayerStatus(g_who[q]) == 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"
            continue;
        }
        n = n + 1;
    }
    return n;
}


// 门槛（用户 2026-10-02 改成 2/3）：在场人数的 2/3，**向上取整**（票必须是整数）
//   例：6 人 = 4 票、5 人 = 4 票、10 人 = 7 票、12 人 = 8 票
int BOTC_KickNeed () {
    int n;
    n = BOTC_KickPresentN();
    return ((n * 2) + 2) / 3;
}

// 这一轮「能投票的人」有几个（用户 2026-10-02）：场上的人（被踢的那个除外）；
//   说书人在「不是他发起、也不是被踢的那个」时不能投，所以只有他发起时才 +1。
int BOTC_KickVoterN () {
    int i;
    int q;
    int n;
    n = 0;
    BOTC_BuildSeatList();
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q < 2) {
            continue;
        }
        if (q == g_kickTar) {
            continue;
        }
        if (PlayerStatus(g_who[q]) == 2) {      // 【座位机制】q 是格子 → 查"坐这格的人"
            continue;
        }
        n = n + 1;
    }
    if (g_kickBy == g_teller && g_kickTar != 1) {
        n = n + 1;                 // 说书人发起的：他自己也投
    }
    if (n < 1) {
        n = 1;
    }
    return n;
}

int BOTC_KickCountYes () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_kickVote[i] == 1) {
            n = n + 1;
        }
    }
    return n;
}

int BOTC_KickCountVoted () {
    int i;
    int n;
    n = 0;
    for (i = 2; i <= 13; i += 1) {
        if (g_kickVote[i] != 0) {
            n = n + 1;
        }
    }
    return n;
}

// 标题 + 票数那行（每投一票 / 每秒刷一次）
void BOTC_KickRender () {
    int yes;
    int no;
    if (g_kickTar < 1) {
        return;
    }
    yes = BOTC_KickCountYes();
    no = BOTC_KickCountVoted() - yes;
    libNtve_gf_SetDialogItemText(g_kickTitle, BOTC_NameSubstText(StringToText("是否踢出 " + BOTC_NameStr(g_kickTar))), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_kickCnt, StringToText("目前票数：是 " + IntToString(yes) + " / 否 " + IntToString(no) + "（需要 " + IntToString(BOTC_KickNeed()) + " 票 · 剩 " + IntToString(g_kickSec) + " 秒）"), PlayerGroupAll());
}


// 进入 / 退出「-kick 选人」模式（用户 2026-10-02 回到点击座位这版）
void BOTC_KickPickStart (int p) {
    if (p < 1 || p > 13) {
        return;
    }
    if (g_kickMode == p) {
        g_kickMode = 0;
        BOTC_Notice(p, "已取消踢人投票。");
        return;
    }
    if (g_kickTar >= 1) {
        BOTC_Notice(p, "已经有一个踢出投票在进行中了。");
        return;
    }
    if (g_kickMode >= 1) {
        BOTC_Notice(p, "现在有别人正在选踢人对象，等他用完。");
        return;
    }
    g_kickMode = p;
    DialogSetVisible(g_grimDlg, PlayerGroupSingle(p), true);
    BOTC_Notice(p, "点一个座位：对他发起踢出投票（点「说书人」那一格 = 对说书人发起；再发一次 -kick 取消）。");
}

// 发起投票
void BOTC_KickStart (int by, int q) {
    int i;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_kickTar >= 1) {
        BOTC_Notice(by, "已经有一个踢出投票在进行中了。");
        return;
    }
    if (PlayerStatus(g_who[q]) == 2) {    // q 是格子 → 查"那格现在坐的人"在不在
        BOTC_Notice(by, "那个人已经离开游戏了。");
        return;
    }
    g_kickTar = q;
    g_kickBy = by;
    for (i = 0; i <= 13; i += 1) {
        g_kickVote[i] = 0;
    }
    g_kickSec = 60;
    g_kickHalf = 0;
    BOTC_PubAnnounce(BOTC_NameStr(BOTC_PosOf(by)) + " 对 " + BOTC_NameStr(q) + " 发起了踢出投票");
    BOTC_KickRender();
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), true);
    DialogControlSetVisible(g_kickYes, PlayerGroupAll(), true);
    DialogControlSetVisible(g_kickNo, PlayerGroupAll(), true);
    if (g_kickBy != g_teller) {
        DialogControlSetVisible(g_kickYes, PlayerGroupSingle(g_teller), false);   // 说书人不投 ---- 除非这个投票就是他发起的
        DialogControlSetVisible(g_kickNo, PlayerGroupSingle(g_teller), false);
    }
    DialogControlSetVisible(g_kickYes, PlayerGroupSingle(g_who[q]), false);   // 被踢的人不能投自己
    DialogControlSetVisible(g_kickNo, PlayerGroupSingle(g_who[q]), false);
    BOTC_PmStore(g_teller, "【踢人投票】" + BOTC_NameStr(BOTC_PosOf(by)) + " 发起：是否踢出 " + BOTC_NameStr(q) + "（门槛 " + IntToString(BOTC_KickNeed()) + " 票，60 秒）。");
}

// 投一票：yes = 1（是）/ 0（否）
void BOTC_KickCast (int p, int yes) {
    if (g_kickTar < 1) {
        return;
    }
    if (p < 1 || p > 13 || p == g_who[g_kickTar]) {   // g_kickTar 是格子：被踢的人不投自己
        return;                       // 被踢的人不投自己
    }
    if (p == g_teller && g_kickBy != g_teller) {
        return;                       // 说书人不投 ---- 除非这个投票就是他发起的（用户 2026-10-02）
    }
    if (PlayerStatus(p) == 2) {
        return;
    }
    if (yes == 1) {
        g_kickVote[p] = 1;
    }
    else {
        g_kickVote[p] = 2;
    }
    BOTC_KickRender();
    // 【投完就把框收掉】（用户 2026-10-02）：这一票不改了 ---- 只收他自己那份，别人那份还在，可以继续投
    DialogSetVisible(g_kickDlg, PlayerGroupSingle(p), false);
    if (BOTC_KickCountYes() >= BOTC_KickNeed()) {
        BOTC_KickPass();
        return;
    }
    if (BOTC_KickCountVoted() >= BOTC_KickVoterN()) {
        BOTC_KickFail("能投的人都投完了，没到门槛。");
    }
}

// 通过：踢人
void BOTC_KickPass () {
    int q;
    int p;
    q = g_kickTar;
    BOTC_PubAnnounce("【踢出】" + BOTC_NameStr(q) + " 已被投票踢出游戏。");
    BOTC_PmStore(g_teller, "【踢人投票】通过 → 把 " + BOTC_NameStr(q) + " 踢出。");
    BOTC_KickEnd();
    // 【被投票踢出 = 与主动退出一样处理】（用户 2026-11-04）：
    //   游戏已开局时保留座位和名字，补蓝叉；不再让座位直接消失。
    //   g_leftShown 只在对局已开始时用踢出播报顶替「离开了小镇」；
    //   未开局时不占位，交给 BOTC_LeftCheck 按主动退出的流程直接删座。
    if (q >= 2 && q <= 13 && g_seatOn[q]) {
        if (g_started) {
            g_leftShown[q] = true;
            p = g_who[q];
            g_leftKeepP[p] = true;
            g_leftDeadP[p] = true;
            if (!BOTC_SeatDead(q)) {
                BOTC_MarkDeadPlain(q);
                g_zombFake[q] = false;
                g_deadShown[q] = true;
                g_deadPending[q] = false;
            }
            BOTC_GrimRelayout();
            BOTC_CheckWin();
        }
    }
    KickFromGame(PlayerGroupSingle(g_who[q]));
}

// 没通过 / 超时
void BOTC_KickFail (string why) {
    BOTC_PubAnnounce("【踢人投票】没通过：" + why);
    BOTC_KickEnd();
}

// 收尾：清状态 + 收起对话框
void BOTC_KickEnd () {
    int i;
    g_kickTar = 0;
    g_kickBy = 0;
    g_kickSec = 0;
    g_kickHalf = 0;
    g_kickMode = 0;
    for (i = 0; i <= 13; i += 1) {
        g_kickVote[i] = 0;
    }
    DialogSetVisible(g_kickDlg, PlayerGroupAll(), false);
}

// 挂在 0.5 秒 tick 里：倒计时（两拍一秒）+ 每秒刷票数
void BOTC_KickTick () {
    if (g_kickTar < 1) {
        return;
    }
    if (PlayerStatus(g_who[g_kickTar]) == 2) {     // 【座位机制】g_kickTar 是格子
        BOTC_PubAnnounce("【踢人投票】被投票的人已经离开了，投票作废。");
        BOTC_KickEnd();
        return;
    }
    g_kickHalf = g_kickHalf + 1;
    if (g_kickHalf >= 2) {
        g_kickHalf = 0;
        g_kickSec = g_kickSec - 1;
        if (g_kickSec <= 0) {
            BOTC_KickFail("时间到了（60 秒）。");
            return;
        }
        BOTC_KickRender();
    }
}

bool BOTC_Tick_Func (bool testConds, bool runActions) {
    int p;
    int i;
    int sec;
    int ch;
    int by;
    bool nomUiRefresh;
    if (!runActions) {
        return true;
    }
    nomUiRefresh = false;
    // 【猎手 / 精神病请求 · 15 秒兜底】（用户 2026-11-01）：30 拍（0.5 秒一拍）= 15 秒，
    //   说书人没拍板就自动按【否】（无事发生），不会一直卡在那里。
    if (g_slayAskOn && g_slayAskSec > 0) {
        g_slayAskSec = g_slayAskSec - 1;
        if (g_slayAskSec <= 0) {
            if (g_slayAuto) {
                if (g_slayCanYes) {
                    BOTC_SlayAnswer(1);    // 真有对应能力 → 返回是
                }
                else {
                    // 真猎手的这一次声称仍然用掉了机会（含中毒 / 醉酒 / 目标不是恶魔）
                    if (!g_slayAskPsy && BOTC_HasAbility(g_slayAskP, 10)) {
                        BOTC_LoseAbility(g_slayAskP, 12);
                    }
                    BOTC_SlayAnswer(0);    // 没能力 / 中毒醉酒 → 返回否（无事发生）
                }
            }
            else {
                BOTC_SlayAnswer(0);        // 说书人 15 秒没拍板 → 自动按【否】
            }
        }
    }
    // 【发起提名 · 10 秒不选人自动取消 / 5 秒冷却】（用户 2026-11-02）
    if (g_phase == 2 && g_nomPickBy >= 1 && g_nomPickBy <= 13) {
        if (g_nomPickSec[g_nomPickBy] > 0) {
            g_nomPickSec[g_nomPickBy] = g_nomPickSec[g_nomPickBy] - 1;
            if (g_nomPickSec[g_nomPickBy] <= 0) {
                by = g_nomPickBy;
                g_nomPickSec[by] = 0;
                g_nomPickBy = 0;
                g_nomPickCool[by] = 10;         // 5 秒
                BOTC_PhaseSet(1);
                BOTC_Notice(g_who[by], "10 秒内没有选择提名对象，已取消发起提名；5 秒后才能再次发起。");
            }
        }
    }
    for (p = 1; p <= 13; p += 1) {
        if (g_nomPickCool[p] > 0) {
            g_nomPickCool[p] = g_nomPickCool[p] - 1;
            if (g_nomPickCool[p] <= 0 && g_phase == 1) {
                nomUiRefresh = true;
            }
        }
    }
    if (nomUiRefresh) {
        BOTC_NomUI();
    }
    if (g_vixenTarget >= 2) {
        BOTC_VixenSync();
    }
    // 选板子页面：黑屏渐变 + 倒计时刷新
    if (g_boardOpen) {
        BOTC_BoardTick();
        if (g_cOpen && g_csel[130]) {
            BOTC_BootleggerCapture();
        }
        // 保存按钮触发的这一拍，编辑框往往还没提交新文本；下一拍失焦后再补写规则。
        if (g_bootSavePending) {
            BOTC_BootleggerCapture();
            BOTC_CustomSaveBootOnly(g_bootSaveSlot, g_bootText);
            g_bootSavePending = false;
            BOTC_NoticeKeep(g_teller, "【私货商人】规则已补存：" + IntToString(StringLength(g_bootText)) + " 个字符。");
        }
        // 【自定义剧本 · 读档重试】（用户 2026-10-04）：进图头一两秒读 bank 可能还没就绪
        //   （写是几十秒后点的【保存】，所以写得进、读不回来）。选板子阶段每 0.5 秒重试一次，读到就停。
        //   面板已经开着时不再重试 —— 免得把说书人刚刚手动选好的东西冲掉。
        if (g_customSlot >= 1 && g_customSlot <= 6 && !g_customBankOk && g_bankTry < 60) {
            // 【读档重试】每 0.5 秒试一次，最多试 60 次（≈30 秒）—— **有上限**，
            //   免得万一读不到就一直去碰 bank（线上每次碰 bank 都可能要跟 Battle.net 同步，反复碰会拖慢游戏）。
            //   ⚠ `BOTCSave` 这个名字必须在地图触发器里挂过「数据存档 - 为玩家1打开数据存档」，
            //     引擎才会真的去读它（用户 2026-10-04 实测：不挂永远读到空壳）。
            //   ⚠ 那条动作**必须放在"加载结束之后"执行**（例如：另一个触发器「地图初始化 → 等待 5 秒 → 打开数据存档」）。
            //     放在地图初始化里直接开档，**线上会卡在加载进度条**（跟开几个玩家无关，用户 2026-10-04 实测）。
            g_bankTry = g_bankTry + 1;
            BOTC_CustomLoadBank(false);
            if (g_customBankOk && g_cOpen) {
                BOTC_BootleggerEditRefresh();
                BOTC_CustomRender();         // 面板已经开着时读到了 → 补一次重画
            }
        }
    }
    BOTC_CdRender();
    // 【狂热者（110）】（用户 2026-10-10）：投票阶段里**每秒掷一次**，中了就替他点【投票】
    //   （不是一进投票阶段就投）：剩 > 10 秒每秒 10%；剩 10..4 秒从 30% 起、每秒 +8%；剩 ≤ 3 秒 100%。
    //   中毒 / 酒鬼 / 已死 / 教派投票 都不算（BOTC_ZealotMustVote 里已经排掉）。
    if (g_phase == 5 && !g_cultOn) {
        sec = FixedToInt(TimerGetRemaining(g_tVote));
        if (sec < 0) { sec = 0; }
        if (sec != g_zealotSec) {
            g_zealotSec = sec;
            for (i = 2; i <= 13; i += 1) {
                if (!g_seatOn[i]) { continue; }
                if (g_vote[i] == 1) { continue; }
                if (!BOTC_ZealotMustVote(i)) { continue; }
                ch = 10;
                if (sec <= 10) { ch = 30 + ((10 - sec) * 8); }
                if (sec <= 3) { ch = 100; }
                if (RandomInt(1, 100) <= ch) {
                    g_vote[i] = 1;
                    g_voteWasDead[i] = BOTC_SeatDead(i);
                    BOTC_NomUI();
                }
            }
        }
    }
    if (g_cultOn) {
        BOTC_CultRender();             // 【教派投票】倒计时 + 还没投的人（用户 2026-10-10）
    }
    BOTC_TimerAiInit();            // 只负责「入夜把倒计时收掉」（2026-10-16 起不再自动开表、不再自动换类型）
    BOTC_TimerTick();              // 时段倒计时走表
    BOTC_LaughTick();              // -laugh 公用冷却 + 复活动画（用户 2026-09-22）
    BOTC_GrimShareCdTick();        // 一键发送魔典：每个玩家独立的 15 秒冷却
    BOTC_GateCdTick();             // 【防刷屏】声称 / 快进 / 屏蔽冷却和公聊禁言倒计时
    BOTC_ReqTick();                // 【私聊 / 换座位请求 15 秒超时 + 拒绝冷却】（用户 2026-11-02）
    BOTC_DeadPickTimeout();        // 月之子 / 呆瓜 的 60 秒兜底（用户 2026-09-21）
    BOTC_LeftCheck();              // 【玩家离开游戏】检测 → 公聊播一句（用户 2026-10-02）
    BOTC_VizierSync();             // 维齐尔免死 token 跟随中毒 / 醉酒 / 死亡 / 离场状态
    // 【界面自愈】（用户 2026-10-07 报「换位之后有时候渲染不对、第二遍才对」）：每 0.5 秒重画一次
    //   说书人那份魔典（只 1 个客户端）—— 哪怕哪一步漏刷，最多半个 tick 就自己补上。
    BOTC_GrimRender(g_teller);
    BOTC_KickTick();               // 【投票踢人】倒计时 + 每秒刷票数（用户 2026-10-02）
    // 【请求加入】按私聊列表的选中状态冒出来：
    //   列表点选不一定触发控件事件，所以借这个 0.5 秒的 tick 每拍对一次状态（用户 2026-09-19）
    for (p = 1; p <= 13; p += 1) {
        BOTC_PmJoinRender(p);
        BOTC_InviteRender(p);          // 【邀请加入】（用户 2026-10-10）：说书人在私聊里时才冒出来
        BOTC_DissolveRender(p);        // 【解散私聊】（用户 2026-10-10）：同上
        BOTC_LogMenuTick(p);           // 【看某玩家 · 菜单】选中哪一行就切到那个人的视图
    }
    return true;
}

//==================================================================================================
// 【临时测试】开局 3 秒后自动跑一遍提名，方便用玩家2的视角看流程。
//   想改谁提名谁：把下面 NomWant / NomPick 的两个数字换掉即可（例如 3 提名 2 就写成 NomWant(3) + NomPick(3, 2)）
//   想只自动开环节、自己去点"发起提名"：把 NomWant 和 NomPick 两行删掉
//   测试完：把这整个函数 + BOTC_Init 里带"临时测试"注释的三行一起删掉
//==================================================================================================

//==================================================================================================
// 【临时测试】智能说书两天流程测试（正式版把这整段删掉）
//   开局：随机发牌 → 玩家1（座位 2）改成猎手 → 强制智能说书 → 跳过选板子 → 游戏正式开始（第 1 夜）
//   夜里：按「今晚该醒的角色」逐个自动唤醒；每个先醒一拍（2 秒），没自己选目标的由脚本随便选一个再收回
//   流程：第 1 夜 → 天亮（第 1 天，40 秒自由时间）→ 第 2 夜 → 天亮（第 2 天）
//         → 第 2 天 20 秒后自动处决 玩家3（座位 4）→ 入夜（测试到这里结束，之后你自己玩）
//   另外：玩家1 那份魔典会同步成「说书人的真魔典」，随时可以对照场上信息
//==================================================================================================

// 【测试】把说书人那份真魔典（身份 + token）整行复制给玩家1（不强制打开面板）

// 【测试】同步完再摊开给玩家1看

// 【测试】把玩家1（座位 2）弄成送葬者：场上本来有送葬者就和他对调（身份 + token），没有就直接改

// 【测试】把玩家1（座位 2）弄成「酒鬼送葬者」：魔典上写着送葬者，身上带「是酒鬼」token
//   ---- 也就是他以为自己是送葬者（收信息 / 唤醒都按送葬者走，但信息是假的）。
//   场上本来有送葬者就跟他换身份 + token（配板人数不变）；酒鬼 token 只留座位 2 这一个。

// 【测试】把玩家1（座位 2）弄成「酒鬼占卜师」：魔典上写着占卜师，身上带「是酒鬼」token
//   ---- 他以为自己是占卜师，验人走 BOTC_FtAnswer（所以会吃到 2 个「假干扰项」）。
//   跟酒鬼送葬者那套一样：优先跟场上原本的占卜师对调身份 + token，其次跟原本的酒鬼，
//   都没有就跟一个镇民对调（免得座位 2 正好是恶魔 / 爪牙，一改就把配板弄坏）。

// 【测试】把玩家1（座位 2）弄成贞洁者（索引 9）：场上本来有贞洁者就跟他换身份 + token，
//   没有就跟一个镇民换（免得座位 2 正好是恶魔 / 爪牙，一改就把配板弄坏），
//   最后再确认座位 2 身上没有「是酒鬼」token（这样测的才是真的贞洁者）。
// 【测试】"给你那个座位"：玩家1 是电脑（= AI 说书人）时你在玩家2（座位 3），
//   否则你在玩家1（座位 2）。测试给的角色、保护、提名都针对这个座位。


// 【电脑哲学家】从当前板子的角色池里随机挑一个候选。
// mode = -1 善良角色 / -2 善良角色但排除食人魔 / 0 镇民 / 1 外来者 / 3 恶魔。
int BOTC_AIPhiloRandomRole (int mode) {
    int i;
    int r;
    int n;
    int pick;
    n = 0;
    pick = -1;
    for (i = 0; i < g_boardRoleN[g_board]; i += 1) {
        r = g_boardRole[(g_board * 256) + i];
        if (r < 0 || r > 163 || r == 56) {
            continue;
        }
        if (mode < 0) {
            if (BOTC_RoleAlign(r) != 0) {
                continue;
            }
            if (mode == -2 && r == 148) {
                continue;
            }
        }
        else {
            if (BOTC_RoleTeam(r) != mode) {
                continue;
            }
            if (mode == 1 && (r == 14 || r == 38)) {
                continue;
            }
        }
        n = n + 1;
        if (RandomInt(1, n) == 1) {
            pick = r;
        }
    }
    return pick;
}

// 【测试】帮没自己选目标的玩家随便选一个合法目标并确认（占卜师会选两个）
void BOTC_TestAutoSkill (int p) {
    int i;
    int q;
    int n;
    int need;
    int r;
    int cp;
    int kind;
    string s;
    if (p < 1 || p > 13) {
        return;
    }
    if (!g_awake[p] && p != g_barberFrom) {
        return;
    }
    r = BOTC_ActRoleOf(p);
    if (r < 0 || r > 163) {
        return;
    }
    if (r == 154) {
        if (!g_taotieOpen[g_who[p]]) { BOTC_TaotieOpen(p); }
        BOTC_TaotieNone(g_who[p]);
        return;
    }
    // 卡扎力首夜只与说书人私聊；电脑玩家也不能由兜底逻辑替他选刀人目标。
    if (r == 135 && BOTC_ActingIsFirstNight(p)) {
        return;
    }
    // 赌徒（27）：人已经选好了，在等他自己在身份网格里点角色 ---- 等到这一拍还没点，智能说书兜底代猜一个
    //   （跟别的角色「没自己选就帮他选」一个道理；纯随机，不往「猜中」偏）
    if (r == 27 && g_gambleWait[p]) {
        n = BOTC_RandomBoardRole();
        if (n >= 0 && n <= 163) {
            BOTC_GambleGuess(p, n);
        }
        return;
    }
    // 哲学家（56）：电脑玩家直接完成善良角色选择和必要的第二次认知选择。
    if (r == 56 && !g_boffinActing[p] && !g_bnestActing[p]) {
        if (g_tokOn[(((g_teller * 14) + p) * 256) + 70]) {
            return;
        }
        cp = g_who[p];
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), false);
        g_pickMode[cp] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        n = BOTC_AIPhiloRandomRole(-1);
        if (n < 0) {
            BOTC_PmStore(g_teller, "【电脑·哲学家】当前板子没有可自动选择的善良角色。");
            return;
        }
        BOTC_PhiloPick(p, n);
        kind = n;
        if (kind == 14 || kind == 38 || kind == 118) {
            DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
            g_pickMode[g_teller] = 0;
            g_pickTeam = -1;
            g_pickAlign = -1;
            if (kind == 14) {
                q = BOTC_AIPhiloRandomRole(0);
            }
            else if (kind == 38) {
                q = BOTC_AIPhiloRandomRole(3);
            }
            else {
                q = BOTC_AIPhiloRandomRole(1);
            }
            if (q >= 0) {
                BOTC_PhiloBelieve(p, q);
                BOTC_PmStore(g_teller, BOTC_NameStr(p) + " 选择了 " + g_roleName[n]);
            }
            else {
                BOTC_PmStore(g_teller, "【电脑·哲学家】选择了「" + g_roleName[n] + "」，但当前板子没有可用于第二次认知选择的角色。");
            }
        }
        else {
            BOTC_PmStore(g_teller, BOTC_NameStr(p) + " 选择了 " + g_roleName[n]);
        }
        return;
    }
    // 侍臣（29）：他选的是**角色**不是座位 ---- 先开门让玩家自己点，等不到就兜底随便选一个
    //   （跟赌徒一样：玩家自己点才算，智能说书只兜底）
    if (r == 29) {
        if (g_courtUsed[p]) {
            return;
        }
        if (g_pickMode[g_who[p]] != 5) {
            BOTC_CourtierOpen(p);
            return;
        }
        n = BOTC_RandomBoardRole();
        if (n >= 0 && n <= 163) {
            BOTC_CourtierPick(p, n);
        }
        return;
    }
    need = BOTC_TargetsOf(p);
    if (need <= 0) {
        return;
    }
    if (g_skillT1[p] > 0) {
        return;                        // 他自己已经选好了
    }
    g_skillT1[p] = 0;
    g_skillT2[p] = 0;
    g_skillT3[p] = 0;
    n = 0;
    BOTC_BuildSeatList();
    // 【测试】占卜师（含酒鬼占卜师）：先让他验「假干扰项」那个座位 ---- 这样日志里一定看得到
    //   「验到假干扰项 → 有恶魔」这条；第二个目标随便挑一个不是假干扰项的人。
    if (r == 5) {
        BOTC_FtFakeSync();
        s = "【测试】占卜师的假干扰项：";
        n = 0;
        for (i = 0; i < 2; i += 1) {
            q = g_ftFakeSeat[i];
            if (q >= 2 && q != p) {
                if (!BOTC_SeatDead(q)) {
                    if (n > 0) {
                        s = s + "、";
                    }
                    s = s + BOTC_NameStr(q);
                    n = n + 1;
                    if (g_skillT1[p] <= 0) {
                        g_skillT1[p] = q;
                    }
                    else {
                        g_skillT2[p] = q;
                    }
                }
            }
        }
        if (n <= 0) {
            s = s + "（现在没有）";
        }
        // ⚠ 测试播报一律走 BOTC_Ann（debug 关了就不出声），别用 BOTC_PubAnnounce 直接播
        BOTC_Ann(s + " ---- 验到他们会报有恶魔");
        n = 0;
    }
    for (i = 0; i < g_seatN; i += 1) {
        q = g_seatList[i];
        if (q == p) {
            continue;
        }
        if (r == 30) {                               // 教授（30）：只看「打了红叉（公开死亡）」的人
            if (!BOTC_PublicDead(q)) {
                continue;
            }
        }
        else {
            if (BOTC_SeatDead(q)) {
                continue;
            }
        }
        if (q == g_skillT1[p] || q == g_skillT2[p]) {
            continue;                  // 已经在上面当假干扰项排进去了
        }
        n = n + 1;
        if (g_skillT1[p] <= 0) {
            g_skillT1[p] = q;
        }
        else {
            if (need >= 2 && g_skillT2[p] <= 0) {
                g_skillT2[p] = q;
            }
            else {
                if (need >= 3 && g_skillT3[p] <= 0) {
                    g_skillT3[p] = q;
                }
            }
        }
    }
    if (g_skillT1[p] <= 0) {
        if (r == 30) {
            BOTC_PmStore(g_teller, "【教授】场上没有已经死了的玩家：这一次没有目标可选。");
        }
        return;
    }
    // 【寡妇（75）】（用户 2026-09-23）：她要手动按【确认】才下毒 ----
    //   这条「自动选目标」的路径（电脑玩家 / 自动测试）原来会顺手替她确认，
    //   表现就是「面板刚显示 目标：X，人就中毒了」。这里跳过她。
    if (r != 75) {
        BOTC_SkillConfirm(p);
    }
}

// 【测试】被唤醒的角色这次给几秒行动时间：
//   要自己选目标的（g_roleTargets > 0：占卜师 / 守鸦人 / 僧侣 / 投毒者 / 管家 / 小恶魔...）→ 20 秒
//   **间谍也 20 秒**（用户 2026-09-19）：他虽然不用选目标，但要整张魔典翻着看，5 秒不够；
//   只听说书人报一句话的那些（洗衣妇 / 图管 / 调查员 / 厨师 / 共情者 / 送葬者）才是 5 秒。
int BOTC_WakeSeconds (int r) {
    if (r == 18) {
        return 20;                 // 间谍：看魔典，给足 20 秒
    }
    if (r == 154) {
        return 45;                 // 饕餮：多选最多 12 名玩家
    }
    if (r >= 0 && r <= 163) {
        if (g_roleTargets[r] > 0) {
            return 20;
        }
    }
    return 5;
}

// 【测试】每晚的一拍：先把「已经醒了一拍」的人处理掉（自动选目标 + 收回），再唤醒下一个该醒的角色
//   返回 true = 今晚还没处理完；false = 今晚该醒的都处理完了

// 【测试】清空这一夜的唤醒记录

// 【测试】让一个随机活着的玩家提名 target（用来验证贞洁者 / 提名流程）
// 【测试】随便挑一个还活着的人（智能说书人自动提名时用；以前固定挑「你」那个座位）


// 【测试】白天推进（每秒调一次）。第 1~2 天 = 私聊 4 分钟 → 公聊 3 分钟；第 3 天起 = 全程公聊 4 分钟，
//   然后智能说书人开提名环节（玩家投满 80% 的【快进到提名】也会提前开）。
//   提名 1 分钟后由智能说书人结束环节（有够票的待处决人就先处决），然后进入夜晚。
// 返回 true = 今天还没跑完

// 【测试】今天随机处决一个还活着的人（不会选玩家1）
//   ⚠ 现在测试流程已经改成「智能说书人按投票结果处决」，这个函数留着备用、不再调用。

// 【测试】4 天流程：奇数阶段 = 夜晚（按顺序自动唤醒 → 天亮），偶数阶段 = 白天（16 秒后随机处决一人 → 入夜）

// 聊天指令 -handles：把每个座位的句柄写进说书人私聊。
// 黑名单本身在私有依赖中，这个调试指令只负责显示句柄。
void BOTC_HandleListToPm () {
    int p;
    string h;
    for (p = 1; p <= 13; p += 1) {
        if (PlayerType(p) != 1) {
            BOTC_PmStore(g_teller, "【句柄】" + IntToString(p) + " 号 = ");
            continue;
        }
        h = PlayerHandle(p);
        BOTC_PmStore(g_teller, "【句柄】" + IntToString(p) + " 号 = " + h);
    }
}

void BOTC_Init () {
    int p;
    int i;
    g_teller = 1;                 // 【换说书人】每局开始：说书人默认坐 1 号位（用户 2026-10-06）
    g_pmVisOn = false;            // 【默认不可见】（用户 2026-11-03）：私聊列表默认不向其他玩家公开
    g_cdHintLast = "";             // 【倒计时缓存】（用户 2026-11-04）：开局重置，保证第一帧一定写一次
    g_cdSubLast = "";
    g_cdImgLast = -1;
    for (i = 1; i <= 13; i += 1) {
        g_lab[i] = i - 1;         // 【编号表】格子 i 的显示编号 = i - 1（玩家1 = 格子 2）；换说书人时**不动**
        // 【座位颜色】用户 2026-10-06：**玩家1（= 物理座位 2）从红色开始**，往后 蓝/青/紫/黄/橙/绿/粉…
        //   （物理座位 1 是说书人那一格，固定白色，这里给个占位值就行）
        g_seatColor[i] = i - 1;
        g_who[i] = i;             // 【座位→人】开局：位置 i 就是物理座位 i
        if (g_seatColor[i] < 1) {
            g_seatColor[i] = 1;
        }
    }
    // 【说书人那一格固定用「深粉」】（用户 2026-10-14）：**色号 15 = 深粉**（用户实测：8 是淡粉、太淡）----
    //   下面所有按位置取色的地方（魔典名字行、座位面板…）都会跟着走，换成别色只改这一行。
    g_seatColor[1] = 15;
    for (p = 0; p <= 13; p += 1) {
        g_mySess[p] = 0;
        g_sessOwner[p] = 0;
        g_sessAlive[p] = false;
        g_reqFrom[p] = 0;
        g_reqJoinSess[p] = 0;
        g_reqJoinWho[p] = 0;
        g_invSess[p] = 0;
        g_invFrom[p] = 0;
        g_joinWho[p] = 0;
        g_joinPending[p] = false;
        g_hidden[p] = false;
        g_logMode[p] = 0;
        g_logTarget[p] = 0;
        g_logMenuSel[p] = 0;
        g_logViewWho[p] = 0;
        g_logPickOn[p] = false;
        g_logPick[p] = false;
        g_logOpen[p] = false;
        g_abOpen[p] = false;
        g_pmLogCount[p] = 0;
        g_chatCount[p] = 0;
        g_pickMode[p] = 0;
        g_pickBluffSlot[p] = 0;
        g_nomUsed[p] = false;
        g_bansheeSecondNom[p] = false;
        g_nomTargeted[p] = false;
        g_nomFromOf[p] = 0;
        g_vote[p] = 0;
    }
    for (i = 0; i < 196; i += 1) {
        g_member[i] = false;
        g_joinVote[i] = false;
        g_listSess[i] = 0;
    }
    for (i = 0; i < 2400; i += 1) {
        g_pubLog[i] = "";
    }
    for (i = 0; i < 8400; i += 1) {
        g_pmLog[i] = "";
    }
    for (i = 0; i < 4200; i += 1) {
        g_chatLines[i] = "";
    }
    for (i = 0; i < 600; i += 1) {
        g_voteLog[i] = "";
    }
    g_pubLogCount = 0;
    g_voteLogCount = 0;
    g_started = false;
    g_dayNum = 0;
    g_nightNum = 0;

    // 【图层 + 顺序】（用户 2026-10-04 定稿）：
    //   数据 → 汉字预热（被黑布盖住）→ 黑布 → 公聊/私聊窗 → …其余面板… → 选板子页 / 自定义剧本面板
    //   · BOTC_GrimInitData() 必须最先跑：它是**纯数据**（角色名 / 阵营 / token / 字体样式 / 曲子名…），
    //     后面的界面全要用它；提前到这儿，也让下面的「汉字预热」能拿到真正的角色名。
    //   · 黑布单独一个对话框、建得比所有游戏内面板都早 → 选板子阶段聊天框压在黑布上面，能看见聊天；
    //   · 汉字预热建在黑布**之前**（＝比黑布更低）→ 被黑布盖住，玩家看不见（它就是个字形缓存）；
    //   · 选板子页 / 自定义剧本面板建得最晚 → 它们的按钮压在聊天框上面，照样能点。
    BOTC_GrimInitData();
    BOTC_WikiInit();               // 规则百科静态文本（纯数据，界面在 BuildWiki）
    BOTC_ArtInit();                // 拓展阅读静态文本（纯数据，暂未接入界面）
    BOTC_BuildGlyphWarm();         // 汉字字形预热（建在黑布之前才会被盖住；这时角色名/字体样式已就位）
    BOTC_BuildBlack();             // 黑布（建得比预热晚 = 压在预热上面；比聊天早 = 聊天压在它上面）
    // ⚠ 公聊 / 私聊的黑底必须建在这两个窗口**之前**（对话框按创建先后分层，建晚了会盖住文字）
    //   聊天窗（连黑底）建在黑布之上：所有面板 / 魔典 / 弹框都压在它上面
    BOTC_BuildChatBackdrop();
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildChat(p);
        BOTC_BuildPmBox(p);
    }

    BOTC_BuildNight();
    BOTC_RevealAll();

    BOTC_BuildLog();
    BOTC_BuildLogPick();       // 【看某玩家】的下拉列表
    BOTC_BuildAbility();       // 旧面板照样建出来（只是不显示）---- 不建的话它的控件 id 是 0，HideAllUI 等处会报错
    BOTC_BuildRoleList();     // 新版自绘能力表：第一步（只建面板 + 图标 + 文字，先验证不崩）
    // 左侧那个面板：留在魔典**下面**（跟以前一样，免得挡住圆桌上的点击）
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildPanel(p);
    }
    // 【数据初始化已提前】（用户 2026-10-04）：BOTC_GrimInitData() 现在在 BOTC_Init 开头（黑布之前）调用，
    //   因为上面的「汉字预热」要用它填的 g_roleName / g_grimNameStyle
    BOTC_BuildGrim();              // 魔典
    BOTC_BuildFakeGrim();          // 【伪造魔典】（用户 2026-11-07）：说书人专用
    BOTC_BuildExperimentalRoles();
    // 【汉字预热搬走了】（用户 2026-10-04）：它现在建在最前面（黑布之后、聊天之前），见 BOTC_Init 开头
    BOTC_BuildRoleSet();
    BOTC_BuildPreNotice();     // 开局前那行提示（用户 2026-09-19）
    BOTC_BuildTimer();         // 时段计时：说书人面板 + 全屏倒计时条（用户 2026-09-19）           // 【手动配板】按钮 + 面板（用户 2026-09-19）
    BOTC_BuildEvil();              // 邪恶小窗（建在魔典之后：压在魔典上面）
    BOTC_BuildPick();
    BOTC_BuildWakeChoice();        // 多重能力专用选择框（和身份网格完全分离）
    BOTC_BuildTok();
    BOTC_BuildGossip();        // 造谣者（28）的公开声明输入框
    BOTC_BuildJuggler();       // 杂耍艺人（58）：5 组「座位号 + 身份」的公开猜测面板（用户 2026-09-21）
    BOTC_BuildAlsaahir();      // 戏法师（149）：多元爪牙 / 恶魔分类公开猜测
    BOTC_BuildTaotie();        // 饕餮（154）：12 座位任意数量多选
    BOTC_BuildBluff();
    BOTC_BuildBluffAsk();      // 【首夜不在场身份弹窗】（用户 2026-11-04）
    BOTC_BuildLBluff();        // 疯子那套「不在场身份」面板以前漏建，控件 id 一直是 0 → 换座位 / 发给疯子时报 triggerControl 错误
    BOTC_BuildBoard();
    BOTC_BuildCustom();            // 【自定义剧本】面板（用户 2026-10-03）
    BOTC_ChatBgApply();            // 黑底透明度（默认值在 GrimInitData 里设，这里应用一次）
    BOTC_BuildWin();
    BOTC_BuildRate();          // 【说书人评分】结算面板下方的 1..5 分打分框
    BOTC_BuildWinCongrats();
    BOTC_BuildPromote();
    BOTC_BuildBigNotice();
    BOTC_BuildNomBig();
    BOTC_BuildEndNotice();
    BOTC_BuildSlayAsk();
    BOTC_BuildLevRecluse();     // 【利维坦×陌客】说书人判定框（用户 2026-11-02）
    BOTC_BuildGfRecluse();      // 【教父×陌客】说书人判定框（用户 2026-11-05）
    BOTC_BuildPacifistAsk();    // 【和平主义者（33）】处决弹窗（用户 2026-11-06）
    BOTC_BuildHagAsk();         // 【麻脸巫婆】跨阵营改造二次确认框（用户 2026-11-03）
    BOTC_BuildPsyRps();         // 【精神病患者】处决猜拳：石头 / 剪刀 / 布（用户 2026-11-03）
    BOTC_BuildShugenja();       // 【修行者（114）】说书人两选一面板（用户 2026-10-16）
    BOTC_BuildGambleDecide();   // 【赌徒】说书人「死亡 / 存活」面板（用户 2026-11-01）
    BOTC_BuildMayorAsk();
    BOTC_BuildManInfo();        // 【真人说书】信息位答题框（共情者 / 厨师 / 占卜师）
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildSkill(p);

        BOTC_BuildHd(p);
    }
    BOTC_BuildKick();           // 【投票踢人】那个中间的对话框（用户 2026-10-02）
    BOTC_BuildSeatAsk();        // 【换座位 · 请求框】（用户 2026-10-07）：魔典底部下方的无背景框
    BOTC_BuildCopyAsk();        // 【是否抄录魔典】（用户 2026-11-06）：间谍 / 寡妇看完真魔典后选择
    BOTC_BuildFakeAsk();        // 【伪造魔典】中毒 / 醉酒间谍或寡妇看魔典时的二选一
    BOTC_BuildSpec();           // 【发送特定信息】面板（用户 2026-10-10）
    BOTC_BuildRecog();          // 【发送互认】手动填写面板
    BOTC_BuildMBluff();         // 【手动发送不在场身份】独立面板（用户 2026-11-04）
    BOTC_BuildGrant();          // 【赋予能力】说书人测试面板
    BOTC_BuildCult();           // 【教派投票】面板（用户 2026-10-10）
    BOTC_BuildWinAdmin();       // 【胜负控制】独立面板最后创建，保证压在魔典和其他面板之上
    // 【面板层级】（用户 2026-11-04）：对话框按创建先后分层，后建的在上。
    //   这里统一把三个大弹窗和笔记放到最后：夜间顺序 → 剧本角色表 → 游戏帮助 → 笔记，
    //   从而保证 笔记 > 游戏帮助 > 剧本角色表（夜序与剧本角色同属一个层级）。
    BOTC_BuildNightOrder();
    BOTC_BuildAbNew();
    BOTC_BuildTip();
    BOTC_BuildWiki();          // 【规则百科】压在游戏帮助之上、笔记之下
    BOTC_BuildArt();           // 【拓展阅读】入口在规则百科里，压在规则百科之上
    for (p = 1; p <= 13; p += 1) {
        BOTC_BuildNotes(p);
    }
    // 【面板层级】（用户 2026-11-06）：【添加传奇角色】按钮和弹窗放到最后建，
    //   保证它们压在魔典 / 日志 / 帮助等所有面板之上，不会被遮住。
    BOTC_BuildLegacyPanel();

    // 开局定模式：玩家1是电脑就走智能说书
    //   ⚠ 想「强制」按智能说书跑（测试时懒得去大厅把玩家1 改成电脑）：把下面这行改成 true
    g_p1ForceComputer = false;
    BOTC_InitMode();
    // 【开局随机分配座位号】（用户 2026-10-07）：说书人已定（BOTC_InitMode 里顺位过），
    //   把"说书人以外的在场玩家"在玩家格上洗一次；还没发牌，只动 g_who 就够。
    BOTC_ShuffleSeats();
    BOTC_NomUI();
    BOTC_WakeRender();

    BOTC_RefreshSessListAll();

    g_tClick = TriggerCreate("BOTC_Click_Func");
    TriggerAddEventDialogControl(g_tClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    // 回车发送先不挂：c_triggerControlEventTypeEditCompleted 这个版本里不存在
    g_tChat = TriggerCreate("BOTC_Chat_Func");
    TriggerAddEventChatMessage(g_tChat, c_playerAny, "", false);
    // 【一键切换公聊 / 私聊】按 Tab ＝ 触发「选择英雄 1」这个槽（用户 2026-09-30）
    g_tHotKey = TriggerCreate("BOTC_HotKey_Func");
    TriggerAddEventHotkeyPressed(g_tHotKey, c_playerAny, c_hotkeySubgroupNext, true);
    // 私聊成员栏：鼠标滚轮左右查看
    g_tWheel = TriggerCreate("BOTC_Wheel_Func");
    TriggerAddEventMouseWheel(g_tWheel, c_playerAny);
    // 【私聊横向滚动条】按下 / 拖动 / 松开；与左右按钮并存。
    g_tSessBarDown = TriggerCreate("BOTC_SessBarDown_Func");
    TriggerAddEventMouseClicked(g_tSessBarDown, c_playerAny, c_mouseButtonLeft, true);
    g_tSessBarUp = TriggerCreate("BOTC_SessBarUp_Func");
    TriggerAddEventMouseClicked(g_tSessBarUp, c_playerAny, c_mouseButtonLeft, false);
    g_tSessBarMove = TriggerCreate("BOTC_SessBarMove_Func");
    TriggerAddEventMouseMoved(g_tSessBarMove, c_playerAny);
    // 【面板拖动 · 位置记忆】（用户 2026-11-04）：笔记 / 剧本角色表 / 夜间顺序按住顶部拖动
    g_tDlgDragDown = TriggerCreate("BOTC_DlgDragDown_Func");
    TriggerAddEventMouseClicked(g_tDlgDragDown, c_playerAny, c_mouseButtonLeft, true);
    g_tDlgDragUp = TriggerCreate("BOTC_DlgDragUp_Func");
    TriggerAddEventMouseClicked(g_tDlgDragUp, c_playerAny, c_mouseButtonLeft, false);
    g_tDlgDragMove = TriggerCreate("BOTC_DlgDragMove_Func");
    TriggerAddEventMouseMoved(g_tDlgDragMove, c_playerAny);
    // 【一键切换公聊 / 私聊】（用户 2026-09-30）：按 Tab 切"自己那份"（说书人也一样）。
    //   事件放在编辑器里的那个触发器里（事件"单位使用技能"、技能 qiehuan），
    //   动作写：BOTC_HotSwitch(EventPlayer());

    // 提名系统：阶段的计时器
    g_phase = 0;
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    g_tSpeech = TimerCreate();
    g_tVote = TimerCreate();
    g_tTick = TimerCreate();
    g_tSpeechTrig = TriggerCreate("BOTC_SpeechTimer_Func");
    TriggerAddEventTimer(g_tSpeechTrig, g_tSpeech);
    g_tVoteTrig = TriggerCreate("BOTC_VoteTimer_Func");
    TriggerAddEventTimer(g_tVoteTrig, g_tVote);
    // 【教派投票】（用户 2026-10-10）：20 秒倒计时
    g_tCult = TimerCreate();
    g_tCultTrig = TriggerCreate("BOTC_CultTimer_Func");
    TriggerAddEventTimer(g_tCultTrig, g_tCult);
    g_tTickTrig = TriggerCreate("BOTC_Tick_Func");
    TriggerAddEventTimer(g_tTickTrig, g_tTick);
    g_tDawn = TimerCreate();
    g_tDawnTrig = TriggerCreate("BOTC_DawnFunc");
    TriggerAddEventTimer(g_tDawnTrig, g_tDawn);
    TimerStart(g_tTick, 0.5, true, c_timeGame);


    // 板子：30 秒没选完就按票数（或默认第一个）收尾
    g_tBoard = TimerCreate();
    g_tBoardTrig = TriggerCreate("BOTC_BoardTimer_Func");
    TriggerAddEventTimer(g_tBoardTrig, g_tBoard);

    // 背景音乐：换曲子时等上一首淡出完（1.5 秒）再放新的
    g_tMusic = TimerCreate();
    g_tMusicTrig = TriggerCreate("BOTC_MusicTimer_Func");
    TriggerAddEventTimer(g_tMusicTrig, g_tMusic);

    // 限时音效（天亮那声 baitian）：到点淡出停掉
    g_tSfxStop = TimerCreate();
    g_tSfxStopTrig = TriggerCreate("BOTC_SfxStopFunc");
    TriggerAddEventTimer(g_tSfxStopTrig, g_tSfxStop);

    // 入夜倒计时（白天 → 黑夜要等 5 秒）
    g_tNightPend = TimerCreate();
    g_tNightPendTrig = TriggerCreate("BOTC_NightPendFunc");
    TriggerAddEventTimer(g_tNightPendTrig, g_tNightPend);

    // 胜利过场（结算音效放 2 秒 → 弹面板 + 播胜利曲）
    g_tWinStage = TimerCreate();
    g_tWinStageTrig = TriggerCreate("BOTC_WinStageFunc");
    TriggerAddEventTimer(g_tWinStageTrig, g_tWinStage);

    // 提名环节的「20 秒自由提名时间」倒数
    g_tNomFree = TimerCreate();
    g_tNomFreeTrig = TriggerCreate("BOTC_NomFreeFunc");
    TriggerAddEventTimer(g_tNomFreeTrig, g_tNomFree);

    // 猎手射中恶魔的两段过场（2 秒充能 → 2.5 秒枪声）
    g_tSnipe = TimerCreate();
    g_tSnipeTrig = TriggerCreate("BOTC_SnipeFunc");
    TriggerAddEventTimer(g_tSnipeTrig, g_tSnipe);
    // 哈迪寂亚：电脑座位自动替他选生 / 死
    g_tHdAuto = TimerCreate();
    g_tHdAutoTrig = TriggerCreate("BOTC_HdAutoFunc");
    TriggerAddEventTimer(g_tHdAutoTrig, g_tHdAuto);

    // 提名环节：延迟 4 秒弹魔典（给"现在是提名阶段"的大提示留时间）
    g_tNomPop = TimerCreate();
    g_tNomPopTrig = TriggerCreate("BOTC_NomPop_Func");
    TriggerAddEventTimer(g_tNomPopTrig, g_tNomPop);

    // 【游戏正式开始】的 10 秒倒计时（每秒一拍）
    g_tStartCd = TimerCreate();
    g_tStartCdTrig = TriggerCreate("BOTC_StartCdFunc");
    TriggerAddEventTimer(g_tStartCdTrig, g_tStartCd);

    // 开局先黑屏选板子（前 1 分钟）
    BOTC_BoardOpen();


    // 【按句柄踢人】（用户 2026-10-02）：开局检查一遍黑名单（名单在脚本里，删本地存档没用）
    // 黑名单由私有依赖中的 MapInit 触发器独立执行。
}
// 规则百科文本数据（由 work/gen_wiki.py 从钟楼 wiki 整理生成）
void BOTC_WikiInit () {
    // 0 规则概要
    g_wikiAt[0] = 0;
    g_wikiN[0] = 278;
    g_wikiLine[0] = StringToText("【一、初始设置】");
    g_wikiLine[1] = StringToText("【1.召集你的玩家。】让玩家的座位形成一个环形，能够明确区分顺时针座次。");
    g_wikiLine[2] = StringToText("给每位玩家准备一把椅子，并使每个座位都能朝向所有人。这些座位需要形成一个圆形或方形，");
    g_wikiLine[3] = StringToText("但无需规整，只要保证玩家之间有明确的顺时针或逆时针座次即可。作为说书人的你需要经常地进出这个");
    g_wikiLine[4] = StringToText("围圈，所以在两把椅子之间留一个空隙可以方便你走动。场地中心应尽可能空旷，");
    g_wikiLine[5] = StringToText("不要有会使人绊倒的桌子或危险物。");
    g_wikiLine[6] = StringToText("【2.准备魔典。】组装魔典和魔典支架，放置在玩家不容易查看的地方。");
    g_wikiLine[7] = StringToText("通过用两个金属夹来夹紧尽可能靠近游戏盒上下角落的位置，以此来形成一个坚固的书本形状的容器。");
    g_wikiLine[8] = StringToText("将魔典放在展开并组装的两件式魔典支架上面，并把它放在玩家四处走动时也难以看到魔典内容的地方。");
    g_wikiLine[9] = StringToText("从游戏盒中取出与本局游戏相关的所有标记物并把它们放在魔典里。（我们推荐放在魔典右侧的左下角。）");
    g_wikiLine[10] = StringToText("【3.选择一套剧本套装。】选择一个剧本，将剧本盒打开，放在魔典的左下角，");
    g_wikiLine[11] = StringToText("并将剧本的夜晚顺序表放置于魔典的右侧。");
    g_wikiLine[12] = StringToText("《染》的游戏盒内包含三个剧本：《暗流涌动》，《黯月初升》和《梦殒春宵》。你可以选择其中之一，");
    g_wikiLine[13] = StringToText("找到相应的剧本收纳盒打开并放在魔典的左下角。（这会方便你寻找所需的角色标记和相关提示标记。）");
    g_wikiLine[14] = StringToText("将此剧本的夜晚顺序表放置于魔典右侧。");
    g_wikiLine[15] = StringToText("《暗流涌动》需要五名或更多的玩家。另两个剧本则需要七名或更多玩家。");
    g_wikiLine[16] = StringToText("虽然少于七名玩家也可以进行游戏，但不推荐人数不足时玩另两个剧本。（《黯月初升》和《梦殒春宵》");
    g_wikiLine[17] = StringToText("中的一些角色，如沙巴洛斯, 莽夫, 方古, 镜像双子等角色在五或六人的游戏中对于某个阵营是很");
    g_wikiLine[18] = StringToText("不公平的。）");
    g_wikiLine[19] = StringToText("我们建议你从《暗流涌动》开始游戏，然后再尝试其他剧本套装。同样，我们建议你通过先主持一两场五");
    g_wikiLine[20] = StringToText("到十名玩家的游戏来掌握说书人的窍门，然后再尝试更多人的游戏。");
    g_wikiLine[21] = StringToText("【4.准备城镇广场。】将城镇广场面板放在游戏区域正中，其上放置于玩家相对应的生命标记。");
    g_wikiLine[22] = StringToText("在城镇广场的下方放置旅行者列表。");
    g_wikiLine[23] = StringToText("把城镇广场游戏面板放置在场地中央的位置。在城镇广场上与每名玩家座位对应的位置放置一个生命标记。");
    g_wikiLine[24] = StringToText("将投票标记堆放在城镇广场的中心。将旅行者列表放在城镇广场下面，方便所有玩家都能查看本局游戏中");
    g_wikiLine[25] = StringToText("镇民、外来者和爪牙的数量。");
    g_wikiLine[26] = StringToText("【5.给新玩家宣读规则。】");
    g_wikiLine[27] = StringToText("规则解释上面有新玩家开始游戏前需要知道的所有主要规则。你只需念出写在规则纸上的文字即可，");
    g_wikiLine[28] = StringToText("或者让玩家自行私下查看。");
    g_wikiLine[29] = StringToText("部分规则将提示你演示各种手势信号。你最好在讲规则的时候演示这些手势，");
    g_wikiLine[30] = StringToText("以使一些玩家能更直观地进行学习。");
    g_wikiLine[31] = StringToText("你可以现在就念出规则中有关提名和处决的内容，但如果你在第一次提名处决开始时讲解有关规则会更加");
    g_wikiLine[32] = StringToText("有助于玩家理解。");
    g_wikiLine[33] = StringToText("放在城镇广场下方的旅行者列表的背面有一份规则解释副本。为节省时间，");
    g_wikiLine[34] = StringToText("你可以让一名老手玩家宣读这张表上的规则，这样你就可以在他讲解规则的时候设置游戏了。");
    g_wikiLine[35] = StringToText("【6.秘密选择角色。】根据游戏人数，参照旅行者列表设置本局出场角色。如果人数超过十五人，");
    g_wikiLine[36] = StringToText("超出这个数量的玩家需要自愿成为旅行者。");
    g_wikiLine[37] = StringToText("根据游戏设置中本局镇民玩家数量，从你选择的剧本盒中选取对应数量的镇民角色标记。");
    g_wikiLine[38] = StringToText("把这些角色标记放置在魔典的左侧，把其他未使用的镇民角色标记放回剧本盒中。用相同方法选取外来者、");
    g_wikiLine[39] = StringToText("爪牙和恶魔。秘密进行这些操作，确保玩家们不知道本局你选择了哪些角色。");
    g_wikiLine[40] = StringToText("如果游戏中有超过15名玩家，那么超出这个数量的玩家必须自愿成为旅行者。旅行者的能力都十分强大，");
    g_wikiLine[41] = StringToText("但是对团队负的责任较小，他们往往可以加快游戏的进程。让这些玩家查看旅行者列表，");
    g_wikiLine[42] = StringToText("让他们选择他们想成为的旅行者。你可以在「旅行者」页面中查看关于旅行者的更多信息。");
    g_wikiLine[43] = StringToText("在你的第一场游戏中，我们不建议你加入旅行者或传奇角色。");
    g_wikiLine[44] = StringToText("【谨慎地选择角色。】你选择的角色将极大地影响游戏的玩法。选择你认为有趣的，较好互动的，");
    g_wikiLine[45] = StringToText("或者只是你觉得有能力处理的角色配置。如果这是你的第一局游戏，而你不知道该选择哪些角色，");
    g_wikiLine[46] = StringToText("请考虑在暗流涌动页面最下方的推荐配置，或稍作修改以适应你的风格。");
    g_wikiLine[47] = StringToText("【7.添加/移除角色。】根据出场角色的「[]」能力（有橙色花瓣提示），调整角色配置。");
    g_wikiLine[48] = StringToText("如果你选择的角色标记的顶部标有橙色花瓣，你需要按照角色详解对应条目的描述来添加或移除一些角色");
    g_wikiLine[49] = StringToText("标记。");
    g_wikiLine[50] = StringToText("在角色标记上的方括号文字——[像这样]——简要描述了当这个角色出现在游戏时需要做出的改变。");
    g_wikiLine[51] = StringToText("这种调整仅在选择角色时生效，不会在游戏进行过程中发生。");
    g_wikiLine[52] = StringToText("在你添加/移除完角色标记后，角色标记的数量应当与玩家数量相同。");
    g_wikiLine[53] = StringToText("男爵的标记上有「[+2外来者]」字样。男爵会让游戏中增加两个外来者角色标记，");
    g_wikiLine[54] = StringToText("并移除两个镇民角色标记。另一个角色酒鬼也有类似的操作。");
    g_wikiLine[55] = StringToText("【8.向魔典中添加提示标记。】根据角色顶部的叶子数量添加对应的提示标记。");
    g_wikiLine[56] = StringToText("如果你选择的角色标记顶部拥有绿色叶子，把这些角色的提示标记放入魔典。");
    g_wikiLine[57] = StringToText("将所有剩余的提示标记放回剧本盒中。");
    g_wikiLine[58] = StringToText("同一个角色的提示标记与他的角色标记拥有着相同的图案。角色标记顶部的绿色叶子的数量代表该角色拥");
    g_wikiLine[59] = StringToText("有的提示标记数量：如果顶部有一片叶子，添加一个提示标记，如果有两片叶子，就是两个，以此类推。");
    g_wikiLine[60] = StringToText("调查员的标记是一个放大镜图案，所以，调查员的两个提示标记上面都是同样的放大镜图案。");
    g_wikiLine[61] = StringToText("【9.分发角色。】洗混角色标记放入盲抽袋中，让每名玩家抽取一个角色标记。");
    g_wikiLine[62] = StringToText("洗混角色标记然后把它们放进盲抽袋中。让每名玩家抽取一枚角色标记，然后把盲抽袋交给下一位玩家。");
    g_wikiLine[63] = StringToText("重复此操作，直到每名玩家都抽取了一枚角色标记。所有玩家秘密查看自己的角色标记，");
    g_wikiLine[64] = StringToText("不要让其他玩家看见。");
    g_wikiLine[65] = StringToText("【10.把角色标记放置在魔典中。】玩家确认自己角色后，收集所有玩家的角色标记，");
    g_wikiLine[66] = StringToText("将它们放置在魔典中与玩家位置相对应。");
    g_wikiLine[67] = StringToText("待所有玩家查看后，收集所有玩家的角色标记，并将它们放置在魔典中对应每名玩家的位置上。");
    g_wikiLine[68] = StringToText("收集角色标记最安全的方法是，让所有玩家伸出手来，手中握着的角色标记背面朝上。");
    g_wikiLine[69] = StringToText("你可以轻松地从他们的手中接下角色标记，以确保你在这样做的时候没有人看到一闪而过的角色颜色。");
    g_wikiLine[70] = StringToText("每个角色标记在魔典中的具体位置由你来决定。如果三名玩家都坐在同一张沙发上，");
    g_wikiLine[71] = StringToText("那么将这三个标记紧挨着放置在一起会更有帮助，这样你就可以记住他们三个人是「沙发三胞胎」。");
    g_wikiLine[72] = StringToText("只要玩家的顺时针/逆时针顺序在现实中和魔典中是一样的就没有问题了。");
    g_wikiLine[73] = StringToText("【二、夜晚阶段】");
    g_wikiLine[74] = StringToText("【1.准备夜晚阶段】");
    g_wikiLine[75] = StringToText("在进行夜晚阶段之前，你需要进行一些准备。在理想情况下，夜晚不需要你太多思考，");
    g_wikiLine[76] = StringToText("就能够快速且流畅地进行。如果你能把需要思考的内容都提前想好，你对夜晚阶段的准备就十分完备了。");
    g_wikiLine[77] = StringToText("玩家们可以在你准备夜晚阶段的时候自由讨论。");
    g_wikiLine[78] = StringToText("· 选择夜晚顺序表的正确一面。");
    g_wikiLine[79] = StringToText("首先，准备好你的夜晚顺序表，将它放在魔典的右侧。");
    g_wikiLine[80] = StringToText("如果这是本局游戏的首个夜晚，使用「首个夜晚」这一面的行动顺序。");
    g_wikiLine[81] = StringToText("如果这不是游戏过程中的首个夜晚，使用「其他夜晚」这一面的行动顺序。");
    g_wikiLine[82] = StringToText("· 根据需要添加或移除提示标记。");
    g_wikiLine[83] = StringToText("· 如果是首个夜晚，且为七人及以上游戏，在「恶魔信息」和「爪牙信息」旁放置夜晚标记。");
    g_wikiLine[84] = StringToText("· 如果当前有旅行者在场，在夜晚顺序表的「黄昏」旁边放置一个夜晚标记。");
    g_wikiLine[85] = StringToText("将你今晚需要使用的提示标记放置在魔典的左侧对应的位置。将任何你今晚不需要的提示标记放置在魔典");
    g_wikiLine[86] = StringToText("的右侧。");
    g_wikiLine[87] = StringToText("【提示标记】：即使这些标记的使用方式看起来相当明显，你也可以在角色详解中对应角色的条目下找到");
    g_wikiLine[88] = StringToText("标记的详细使用说明。例如，洗衣妇的两个提示标记应当放置在她第一夜获取信息的两名玩家角色标记旁");
    g_wikiLine[89] = StringToText("边。");
    g_wikiLine[90] = StringToText("【叶子】：想要知道哪些角色需要夜晚标记，最简单的办法就是查看角色标记上的叶子，");
    g_wikiLine[91] = StringToText("左侧的叶子代表这个角色会在首个夜晚行动，右侧的叶子代表这个角色会在其他夜晚行动。");
    g_wikiLine[92] = StringToText("【筹划】：现在是一个思考你在接下来的夜晚需要做什么的好时机。例如，如果这是首个夜晚，");
    g_wikiLine[93] = StringToText("你将会向恶魔展示三个不在游戏中的角色标记来帮助他伪装。你将会向他展示哪些角色呢？");
    g_wikiLine[94] = StringToText("如果一名玩家是酒鬼，今晚会使用能力，你会给他什么样的错误信息呢？提前确定好你想要做什么有助于");
    g_wikiLine[95] = StringToText("加快你在夜晚做事的节奏，也能够让玩家保持专注。");
    g_wikiLine[96] = StringToText("【2.进行夜晚阶段】");
    g_wikiLine[97] = StringToText("· 让所有玩家闭眼，然后进入黄昏。");
    g_wikiLine[98] = StringToText("夜晚阶段，玩家们需要保持闭眼。一些玩家将会被唤醒，获取信息或者是使用角色能力。一般来说，");
    g_wikiLine[99] = StringToText("恶魔都会在夜晚发动攻击，杀死一名或多名玩家，或者大肆破坏。");
    g_wikiLine[100] = StringToText("夜晚来临时，告诉所有玩家闭上眼睛。说：「所有玩家，闭眼。」或者其他类似的提示。必要时，");
    g_wikiLine[101] = StringToText("确认他们是否真的都闭眼了。然后依照夜晚顺序表从上到下进行行动。");
    g_wikiLine[102] = StringToText("· 在夜晚，玩家仍可自由发言，但是说书人应该禁止玩家聊到与当晚有关的任何事情，");
    g_wikiLine[103] = StringToText("也应该建议玩家不在首个夜晚针对自己的角色进行发言。");
    g_wikiLine[104] = StringToText("· 如果这是首个夜晚，并且为七人及以上游戏，进行下面两个步骤：");
    g_wikiLine[105] = StringToText("【(1)同时唤醒所有的爪牙，告诉他们谁是恶魔。】");
    g_wikiLine[106] = StringToText("让爪牙们同时睁眼，使他们能够互相看到彼此。然后向他们展示「他是恶魔」的信息标记并同时指认恶魔。");
    g_wikiLine[107] = StringToText("确保所有的爪牙都看见了你指的是谁。然后让所有爪牙闭上眼睛。");
    g_wikiLine[108] = StringToText("【(2)唤醒恶魔，告诉他谁是爪牙。然后给他展示三个不在场的善良角色。】");
    g_wikiLine[109] = StringToText("向恶魔展示「他们是你的爪牙」的信息标记，并依次指认每一名爪牙。然后，");
    g_wikiLine[110] = StringToText("向恶魔展示「这些角色不在场」的信息标记，并向恶魔展示三个不在游戏中的善良角色。");
    g_wikiLine[111] = StringToText("【伪装】：展示这些角色标记将会帮助恶魔伪装成其中一个角色。最佳的方案通常是向恶魔展示两个镇民");
    g_wikiLine[112] = StringToText("标记和一个外来者标记。这样的话，他就能够选择到底是伪装成一个镇民还是一个外来者。当然，");
    g_wikiLine[113] = StringToText("他也可以完全无视你给出的提示，伪装成任何一个他想要伪装的角色。");
    g_wikiLine[114] = StringToText("· 根据夜晚顺序表的顺序，依次唤醒每一个能醒来使用角色能力的玩家。");
    g_wikiLine[115] = StringToText("唤醒每一个能够在今晚使用自己角色能力的玩家，按照夜晚顺序表从上到下的顺序，每次唤醒一名玩家。");
    g_wikiLine[116] = StringToText("结算他们的能力效果，然后再让他们重新入睡。");
    g_wikiLine[117] = StringToText("当一个角色行动的时候，按照需要放置提示标记。夜晚顺序表上的角色旁的紫色圆形标记代表你可能需要");
    g_wikiLine[118] = StringToText("将该角色的提示标记放置在某个位置。例如，在投毒者选择一名玩家后，你就需要将投毒者的「中毒」标");
    g_wikiLine[119] = StringToText("记放置在该玩家的角色标记旁，来提醒你自己该玩家中毒了。");
    g_wikiLine[120] = StringToText("· 当夜晚阶段到达黎明时，等待五到十秒，然后告诉所有玩家睁眼，并宣布这个夜晚死亡和复活的玩家");
    g_wikiLine[121] = StringToText("（相对于黄昏而言生死状态发生了变化的玩家才会宣布），但不告诉玩家他们的死亡和复活原因为何。");
    g_wikiLine[122] = StringToText("当夜晚阶段到达黎明时，简单的等待五到十秒。然后告诉所有玩家他们可以睁开眼睛了。说：「所有玩家，");
    g_wikiLine[123] = StringToText("睁眼。」或者类似的话。");
    g_wikiLine[124] = StringToText("如果一名玩家在夜晚死亡了，在黎明时立刻告诉所有玩家该玩家已死亡。不要说出他的死亡原因。");
    g_wikiLine[125] = StringToText("如果没有人在夜晚死亡，也需要告诉玩家，但是不要说为什么没有人死亡。");
    g_wikiLine[126] = StringToText("你将会在规则书的「处决与死亡」部分中看到更多有关于角色死亡的规则。");
    g_wikiLine[127] = StringToText("【恰当地进行黎明的操作。】黎明前的短暂等待，可以防止玩家们察觉自己可能是在夜晚最后一个行动的");
    g_wikiLine[128] = StringToText("玩家。同样，立刻宣布一名玩家的死亡，可以避免该玩家喊出：「我死了！我上一个夜晚没有行动！");
    g_wikiLine[129] = StringToText("」来证明自己是某个特定角色。");
    g_wikiLine[130] = StringToText("【我怎么知道晚上该唤醒谁？】即使某名玩家的角色在夜晚顺序表上有夜晚标记，");
    g_wikiLine[131] = StringToText("说书人也需根据游戏的实际情况判断是否唤醒他。角色本身的能力描述说明了他们在什么情况下将会在夜");
    g_wikiLine[132] = StringToText("晚醒来。");
    g_wikiLine[133] = StringToText("例如，守鸦人有一个夜晚标记，因为他可能需要被唤醒，但也可能不会。如果恶魔在夜晚杀死了守鸦人，");
    g_wikiLine[134] = StringToText("你稍后需要唤醒守鸦人，并给他提供信息。如果恶魔没有这么做，只需跳过守鸦人那天晚上的行动——没");
    g_wikiLine[135] = StringToText("必要无缘无故叫醒他。");
    g_wikiLine[136] = StringToText("再举一个例子，造谣者的能力可能会杀死一名玩家，但造谣者不会被唤醒来得知他的能力产生了效果。");
    g_wikiLine[137] = StringToText("【各个角色的能力如何运作？】通常在一名玩家醒来后，他会选择一名玩家来使用自己的能力，");
    g_wikiLine[138] = StringToText("或者通过你的手势获取一些信息。每个角色的能力在夜晚顺序表中都有罗列，在角色详解中也有详述。");
    g_wikiLine[139] = StringToText("你可以在规则书的「角色能力」部分中了解更多内容。你不必在完成你的前一两局游戏之前查看这部分的");
    g_wikiLine[140] = StringToText("内容。");
    g_wikiLine[141] = StringToText("有的角色可以在夜里杀死其他角色。在夜晚阶段，如果角色在被唤醒前死亡了，该角色就不会被唤醒了。");
    g_wikiLine[142] = StringToText("在「处决与死亡」部分可以了解更多内容。");
    g_wikiLine[143] = StringToText("【3.夜晚的交流方式】");
    g_wikiLine[144] = StringToText("你需要使用手势与其他玩家在夜晚进行交流。在夜晚时所有玩家都会闭上眼睛。醒来的玩家会秘密地行动，");
    g_wikiLine[145] = StringToText("因此你需要尽可能保持安静，以免将他的角色泄露给其他玩家。在这个过程中产生的任何复杂问题都可以");
    g_wikiLine[146] = StringToText("在白天阶段私下处理。你可以用一只手来给出所有的信息，而用另一只手持魔典。");
    g_wikiLine[147] = StringToText("◆睁眼：要在夜晚唤醒一名玩家，在他的肩膀或膝盖上轻拍两下。");
    g_wikiLine[148] = StringToText("◆闭眼：要在夜晚让一名玩家重新入睡，用你的手遮住眼睛作为示意。");
    g_wikiLine[149] = StringToText("◆是：点头示意肯定。");
    g_wikiLine[150] = StringToText("◆否：摇头示意否定。");
    g_wikiLine[151] = StringToText("◆善良：拇指朝上示意某名玩家是「善良」的。");
    g_wikiLine[152] = StringToText("◆邪恶：拇指朝下示意某名玩家是「邪恶」的。");
    g_wikiLine[153] = StringToText("◆数字：用对应的手势来传达特定的数字。用拇指与其他手指的指尖相对以形成一个「0」的形状来表达");
    g_wikiLine[154] = StringToText("数字0。");
    g_wikiLine[155] = StringToText("◆特定的玩家：为了表示一名特定的玩家，用手指指向那名玩家。");
    g_wikiLine[156] = StringToText("◆特定的角色：为了表示一个特定的角色，展示那个角色标记，或在玩家的角色列表上指出对应的角色图");
    g_wikiLine[157] = StringToText("标。（确保你把标记拿到玩家可以看清的位置——通常距离在30厘米或更近。）");
    g_wikiLine[158] = StringToText("如果某名玩家是共情者（他每天晚上醒来并得知与他邻近的玩家有多少是邪恶的），");
    g_wikiLine[159] = StringToText("而他旁边坐着一个邪恶玩家。整个流程如下：");
    g_wikiLine[160] = StringToText("在共情者的膝盖上轻拍两次来唤醒他。竖起一根手指以表示「1」。然后用你的手遮住眼睛，");
    g_wikiLine[161] = StringToText("示意他重新入睡。");
    g_wikiLine[162] = StringToText("或者，如果某名玩家是守鸦人（他在死亡时会被唤醒并选择一名玩家，得知该玩家的角色）。流程如下：");
    g_wikiLine[163] = StringToText("在守鸦人的膝盖上轻拍两次来唤醒他。让守鸦人指向一名玩家，当他这样做时，");
    g_wikiLine[164] = StringToText("你也要指向该玩家（来确认他具体指向了谁），然后从魔典中拿出该玩家的角色标记，并展示给守鸦人。");
    g_wikiLine[165] = StringToText("当他看过角色标记后，将该标记放回魔典，然后用你的手遮住眼睛，示意他该闭上眼睛了。");
    g_wikiLine[166] = StringToText("【三、白天阶段】");
    g_wikiLine[167] = StringToText("在白天，玩家们会互相交谈。他们可以谋划、撒谎、分享信息或保持沉默以及试着猜出谁是谁。然后，");
    g_wikiLine[168] = StringToText("他们需要投票来决定谁将成为那个被处决的玩家。白天阶段是游戏的主要部分，");
    g_wikiLine[169] = StringToText("且大多数时候可以由玩家们自己来处理。");
    g_wikiLine[170] = StringToText("【1.白天的交流】");
    g_wikiLine[171] = StringToText("为了让讨论开始，只需要让玩家之间相互交谈即可。这时你不需要做什么事情。");
    g_wikiLine[172] = StringToText("玩家可以说任何想说的内容，或保持沉默。");
    g_wikiLine[173] = StringToText("通常善良的玩家会透露他们的角色和他们持有的信息，而邪恶的玩家会伪装成一个善良角色并提供虚假信");
    g_wikiLine[174] = StringToText("息。大多数的善良玩家都会说实话，但一些善良玩家也会有撒谎的动机，而这取决于他们的想法。");
    g_wikiLine[175] = StringToText("玩家可以公开交流，互相耳语，甚至离开他们的座位与其他玩家私聊。但是请他们在走动和私聊时尽量不");
    g_wikiLine[176] = StringToText("要离开椅子所围成的圈。");
    g_wikiLine[177] = StringToText("玩家也可以在白天私下拜访说书人以确认自己的角色能力相关问题，针对某个其他角色的能力运作方式进");
    g_wikiLine[178] = StringToText("行询问，或寻求一些策略建议（寻求策略建议仅限新人玩家）。");
    g_wikiLine[179] = StringToText("如果是正在进行线上游戏，因为玩家的一举一动难以被其他玩家察觉，因此如果需要进行私聊，");
    g_wikiLine[180] = StringToText("需要告知所有人正在与某位玩家进行私聊。在线下游戏中，所有玩家同处一室，");
    g_wikiLine[181] = StringToText("所以即使玩家之间想要以手机信息的方式进行交流，也会很容易被其他玩家察觉到他正在使用手机。");
    g_wikiLine[182] = StringToText("但「染」是一款语言互动类桌游，我们也建议玩家在线下游玩时尽量脱离手机，");
    g_wikiLine[183] = StringToText("以面对面的形式与大家进行交流。");
    g_wikiLine[184] = StringToText("【说书人不应该以任何形式参与到玩家的聊天行为中！！！（例如：主动为邪恶玩家创建群聊等）】");
    g_wikiLine[185] = StringToText("【有任何疑问？】有些玩家可能会问你一些问题。即使你在游戏设置时读过了主要规则，");
    g_wikiLine[186] = StringToText("他们依然可能会忘记。某些玩家可能会询问特定角色的能力。《染》与其他游戏不同之处是在于不需要所");
    g_wikiLine[187] = StringToText("有玩家在游戏之前都熟悉所有规则。我们更强调参与，所以请尽可能帮助那些有问题的玩家。");
    g_wikiLine[188] = StringToText("如果你不知道术语问题的答案，查看「术语汇总」部分。如果你不知道有关角色能力的问题，");
    g_wikiLine[189] = StringToText("请查看角色详解中对应角色的条目内容。");
    g_wikiLine[190] = StringToText("你可以公开回答问题，以便所有玩家都听到。你当然也可以私下回答。对自己的角色能力有疑问的玩家可");
    g_wikiLine[191] = StringToText("能会希望和你私下交谈，这样可以避免别人知道他的角色或他问的问题。");
    g_wikiLine[192] = StringToText("【2.提名与投票】");
    g_wikiLine[193] = StringToText("由说书人宣布白天进入提名环节。在你觉得合适的时候让玩家们开始提名。");
    g_wikiLine[194] = StringToText("在5~10分钟的讨论后要求玩家们发起提名往往是最好的，但也有些玩家可能希望交谈更长或者更短的");
    g_wikiLine[195] = StringToText("时间。在开始提名时，确保此时每名玩家都回到了他们原本的座位上。");
    g_wikiLine[196] = StringToText("你可以说：「现在进入提名环节」，或者类似的话。玩家可以简单地说「我提名道哥」之类的话来提名某");
    g_wikiLine[197] = StringToText("人，当你听到提名时，重复一遍，例如：「小美提名道哥！」这样，每名玩家都知道你已经听到了并且受");
    g_wikiLine[198] = StringToText("理了提名。");
    g_wikiLine[199] = StringToText("· 提名有以下几个限制：如果玩家们尝试以不符合规则的方式发起提名，那就告诉他们这样是被禁止的。");
    g_wikiLine[200] = StringToText("· 同一时间只能有一名玩家被提名。如果一项提名已经被发起但处决投票尚未结束，");
    g_wikiLine[201] = StringToText("则不能再提出另一项提名。");
    g_wikiLine[202] = StringToText("· 只有存活的玩家可以发起提名。虽然死亡的玩家也可以被提名，但这在绝大多数情况下都不是一个明");
    g_wikiLine[203] = StringToText("智的举动。");
    g_wikiLine[204] = StringToText("· 每名玩家每天只能发起一次提名，并且每名玩家每天只能被提名一次。");
    g_wikiLine[205] = StringToText("在投票之前，给被提名的玩家一个为自己辩护的机会，10~30秒的辩护时间比较合适，");
    g_wikiLine[206] = StringToText("当然也可以更长一些。");
    g_wikiLine[207] = StringToText("统计投票。此时你需要站在圆圈的中央，一只手拿着魔典，另一只手指向被提名的玩家。");
    g_wikiLine[208] = StringToText("当你说出他的名字时，投票统计就开始了。");
    g_wikiLine[209] = StringToText("然后，一边慢慢地顺时针旋转，一边大声地数投票数，直到你转完一圈，重新指向被提名的玩家。");
    g_wikiLine[210] = StringToText("（大声数数有助于犹豫的玩家决定是否投票。）被提名的玩家可以投票给自己，");
    g_wikiLine[211] = StringToText("如果他愿意的话——他的票会在最后被统计。如果一名玩家在你指向他的时候举起了手，");
    g_wikiLine[212] = StringToText("那就代表他投了一票。否则就是未投票。");
    g_wikiLine[213] = StringToText("· 在统计投票时：");
    g_wikiLine[214] = StringToText("· 每名存活的玩家每天可以投票给任意数量的玩家。");
    g_wikiLine[215] = StringToText("· 每名死亡的玩家在他死亡后，只剩最后一次投票机会。");
    g_wikiLine[216] = StringToText("在计票结束之后，会宣布本次投票结果。");
    g_wikiLine[217] = StringToText("· 投票在以下情况成功：");
    g_wikiLine[218] = StringToText("· 被提名的玩家获得的票数在今天所有被提名的玩家中最多。（不得是与其他人同为最多）");
    g_wikiLine[219] = StringToText("· 他的票数等于或超过了存活玩家人数的一半。");
    g_wikiLine[220] = StringToText("此时玩家会进入「即将被处决」状态。");
    g_wikiLine[221] = StringToText("在一场游戏中，还有六名玩家存活，而四名玩家已死亡。此时道哥被提名并获得了三票，因此投票成功。");
    g_wikiLine[222] = StringToText("无论这三票是来自活着的还是死去的玩家，只需要六名存活的玩家的一半（也就是三票）投票就能成功。");
    g_wikiLine[223] = StringToText("如果投票成功，宣布被提名的玩家即将被处决。这名玩家今天将被处决……除非接下来被提名的玩家获得");
    g_wikiLine[224] = StringToText("更多票数。继续询问是否还有玩家要发起提名，如果有就统计下一位被提名玩家的票数。");
    g_wikiLine[225] = StringToText("（即将被处决的玩家如果当天还没有发起过提名，也仍可以发起提名。）");
    g_wikiLine[226] = StringToText("如果投票失败，被提名的玩家将不会被处决。继续询问是否还有玩家要发起提名，");
    g_wikiLine[227] = StringToText("如果有就统计下一位被提名玩家的票数。");
    g_wikiLine[228] = StringToText("如果一名被提名玩家的所得票数，与当天早些时候被提名成功且即将被处决的玩家的得票数相同，");
    g_wikiLine[229] = StringToText("那么这些被提名的玩家都不会被处决。（他们也就不再是「即将被处决的玩家」）。");
    g_wikiLine[230] = StringToText("继续询问是否还有玩家要发起提名，如果有就统计下一位被提名玩家的票数。");
    g_wikiLine[231] = StringToText("接下来被提名玩家的得票数必须超过原本打平的票数，你才能宣布那名玩家即将被处决。");
    g_wikiLine[232] = StringToText("一旦你觉得当天的提名和投票已经足够多了，或者已经没有玩家再发起提名了，");
    g_wikiLine[233] = StringToText("就给出当天的最后一次提名机会。走进场地中间，说「最后一次提名！3...2...1...」以此");
    g_wikiLine[234] = StringToText("让所有玩家们在最后一刻快速做出决定。 如果没有人再发起提名，那么宣布当天白天的提名阶段结束。");
    g_wikiLine[235] = StringToText("【3.处决与死亡】");
    g_wikiLine[236] = StringToText("在处决阶段，当前「即将被处决」的玩家会被处决。说书人会宣布这名玩家死亡（或宣布这名玩家被处决");
    g_wikiLine[237] = StringToText("但没有死亡，如果他因为任何效果导致不死的话）。");
    g_wikiLine[238] = StringToText("· 每个白天只能有一名玩家被处决。在处决结束后，白天阶段随即结束。");
    g_wikiLine[239] = StringToText("· 并非每个白天都需要处决一名玩家。如果玩家们不打算提名任何人，或是被提名的玩家没有得到足够");
    g_wikiLine[240] = StringToText("的票数，亦或者是最高得票出现了平局，这个白天都会以无人被处决而结束。");
    g_wikiLine[241] = StringToText("当一名玩家死亡时，让他将自己的生命标记翻转至较暗的那一面，并在上面放置一个投票标记。");
    g_wikiLine[242] = StringToText("· 死亡玩家需要遵循以下规则：");
    g_wikiLine[243] = StringToText("· 在魔典中他的角色标记上放置一个帷幕标记。");
    g_wikiLine[244] = StringToText("· 他立即失去角色能力。他的能力也不再以任何方式影响游戏（除非在能力中注明了「即使你已死亡」）");
    g_wikiLine[245] = StringToText("。他也不会在夜晚被唤醒以执行行动，所以可以移除他的角色提示标记和夜晚标记。");
    g_wikiLine[246] = StringToText("· 他不能发起提名，并且在游戏的剩下时间里只能再投票一次。当他选择投票时，");
    g_wikiLine[247] = StringToText("在计票后移除他的投票标记。没有投票标记的死亡玩家不能投票。");
    g_wikiLine[248] = StringToText("· 他仍要在夜晚闭上眼睛，并且可以继续随心所欲地和其他玩家谈话。");
    g_wikiLine[249] = StringToText("· 死亡的玩家和其他存活的玩家一样，与自己的阵营一同胜利，或是失败。");
    g_wikiLine[250] = StringToText("· 死亡玩家的角色不会公开。");
    g_wikiLine[251] = StringToText("【当一名玩家死亡时，他的角色会公开么？】不会。有的说书人可能更熟悉某些其他社交推理游戏中公布");
    g_wikiLine[252] = StringToText("死亡玩家角色的规则。但在《染》里，死亡玩家的角色仍然是个谜。如果死去的邪恶玩家被误认为善良玩");
    g_wikiLine[253] = StringToText("家，他们仍旧可以继续对局面造成破坏。");
    g_wikiLine[254] = StringToText("在处决结算完毕后，花三十秒左右的时间来准备你的夜晚阶段。你可能需要添加或移除一部分提示标记和");
    g_wikiLine[255] = StringToText("夜晚标记。当你准备好之后，宣布白天结束，并要求所有玩家闭上他们的眼睛。");
    g_wikiLine[256] = StringToText("【四、游戏结束】");
    g_wikiLine[257] = StringToText("在首个夜晚之后，进入白天阶段，之后会再次进入夜晚阶段（记得在第一个白天阶段结束时将夜晚顺序表");
    g_wikiLine[258] = StringToText("翻至其他夜晚的那面，并重新设置夜晚标记）。这样往复轮替白天与黑夜阶段，");
    g_wikiLine[259] = StringToText("直到有阵营获胜时宣告本局游戏结束。");
    g_wikiLine[260] = StringToText("在鸦木布拉夫，死亡并不是终点。如果善良阵营获胜，所有善良玩家无论生死都会共同获胜。");
    g_wikiLine[261] = StringToText("如果邪恶阵营获胜，所有邪恶玩家无论生死也都会共同获胜。而当一个阵营获胜时，");
    g_wikiLine[262] = StringToText("也就意味着另一个阵营会落败，在这个游戏里永远都不会有中间地带。");
    g_wikiLine[263] = StringToText("· 善良阵营的胜利方式：所有恶魔均死亡。");
    g_wikiLine[264] = StringToText("善良阵营在恶魔死亡时获胜。宣布善良阵营获胜，然后让他们来个握手、拥抱，");
    g_wikiLine[265] = StringToText("因胜利的喜悦而放声尖叫吧。");
    g_wikiLine[266] = StringToText("· 邪恶阵营的胜利方式：场上只剩两名玩家存活。（旅行者的数量不计算在内）");
    g_wikiLine[267] = StringToText("邪恶阵营在场上只剩下两名玩家存活时获胜。宣布邪恶阵营获胜，然后让他们来个碰拳、比手枪，");
    g_wikiLine[268] = StringToText("或是开一场恣意的派对来庆祝吧。（邪恶阵营可以通过恶魔杀死一名玩家或者处决了一名错误的玩家来赢");
    g_wikiLine[269] = StringToText("得游戏胜利。）");
    g_wikiLine[270] = StringToText("· 如果两个阵营同时达成胜利条件，善良阵营获胜。");
    g_wikiLine[271] = StringToText("如果两个阵营同时达成胜利条件，则善良阵营获胜。例如，在恶魔死亡后仅剩两名存活玩家，");
    g_wikiLine[272] = StringToText("那么善良阵营获胜。");
    g_wikiLine[273] = StringToText("【一旦有恶魔死亡游戏就会结束吗？】不一定噢，有些像红唇女郎这样的角色可以在恶魔死亡后让游戏继");
    g_wikiLine[274] = StringToText("续下去，而善良阵营并不知道发生了什么。");
    g_wikiLine[275] = StringToText("在某些中等或者进阶难度的剧本中，可能会有多个恶魔同时存活，甚至游戏中还会出现善良的恶魔。");
    g_wikiLine[276] = StringToText("无论游戏中恶魔出现的数量，他们是善良的还是邪恶的，善良阵营必须在所有恶魔都死亡时才能赢得游戏");
    g_wikiLine[277] = StringToText("胜利。");
    // 1 重要细节
    g_wikiAt[1] = 278;
    g_wikiN[1] = 253;
    g_wikiLine[278] = StringToText("【一、规则特例】");
    g_wikiLine[279] = StringToText("【如果规则书中没有提及 「你不能做某件事情」，那么你就可以做这件事情。】没错，");
    g_wikiLine[280] = StringToText("玩家可以对自己发起提名。没错，玩家可以在对自己的提名中投票。没错，");
    g_wikiLine[281] = StringToText("恶魔可以攻击一名已死亡的玩家。没错，善良阵营的玩家也可以说谎。没错，在夜晚选择「任意玩家」，");
    g_wikiLine[282] = StringToText("意思就是可以选择自己或是选择已死亡的玩家。没错，死亡玩家也可以发言。");
    g_wikiLine[283] = StringToText("因为这些都没有在规则书中提及「不可以这么做」。但是，死亡玩家不能发起提名，");
    g_wikiLine[284] = StringToText("且只能在有投票标记时进行一次处决投票，因为规则书中提及到过这些规则。");
    g_wikiLine[285] = StringToText("· :与此同时，你的目标是主持一场有趣好玩且参与度高的游戏。【有些事你可以做，");
    g_wikiLine[286] = StringToText("但不意味着你应该去做。】你是否只顾自己取乐而给玩家们添乱？你是否正在牺牲玩家的乐趣来放纵自己？");
    g_wikiLine[287] = StringToText("比如当小恶魔在夜里将自己杀死时，你「可以」将陌客当作是爪牙并让他因此变成一个善良的小恶魔，");
    g_wikiLine[288] = StringToText("但这并不意味着这样做是有趣或平衡的。比如说你「可以」说服一名迷惑的善良阵营玩家，");
    g_wikiLine[289] = StringToText("告诉他他是邪恶阵营的，但这并不意味着玩家在得知真相后会享受这个过程。");
    g_wikiLine[290] = StringToText("又比如说你「可以」给博学者提供完全没用的信息，但显然提供有趣且独特的信息会更好。作为说书人，");
    g_wikiLine[291] = StringToText("你在每一局游戏当中都需要做出很多有趣的决定。而这每一个决定的目的都应该是使游戏变得更好玩，");
    g_wikiLine[292] = StringToText("为大家带来更多乐趣。这通常意味着你需要给善良阵营制造尽可能多的混乱，将他们引入歧途，");
    g_wikiLine[293] = StringToText("因为这对所有人来说都是有趣的。但请牢记在心，维持游戏的公平性同样重要，");
    g_wikiLine[294] = StringToText("你主持游戏是为了让玩家都能够享受到游戏中的精彩。");
    g_wikiLine[295] = StringToText("· 说书人的言语即是游戏规则。但请告诉所有玩家你对某些细节的处理方式是什么。");
    g_wikiLine[296] = StringToText("· :如果你对如何解释一条规则不太确定，或是玩家不太清楚某个角色能力是什么，你作为说书人，");
    g_wikiLine[297] = StringToText("有最终解释权。你当然应该注意倾听玩家的声音，但如果你对《染》的某个费解的措辞或是角色互动不太");
    g_wikiLine[298] = StringToText("确定时，定下你的规则，并在接下来的游戏中遵守它。告诉你的玩家们你会以什么方式来进行处理，");
    g_wikiLine[299] = StringToText("然后让游戏继续进行。");
    g_wikiLine[300] = StringToText("· 角色能力与核心规则冲突时，以角色能力为准。");
    g_wikiLine[301] = StringToText("· :如果一个角色的能力与本书中的核心规则冲突，那么应该遵照这个角色的能力来进行处理。");
    g_wikiLine[302] = StringToText("· 角色能力无法在旅行者的流放流程中产生效果。");
    g_wikiLine[303] = StringToText("【二、角色能力】");
    g_wikiLine[304] = StringToText("《染》的每一个角色都有其独特的能力，这些能力会在这个角色的角色标记，角色列表和角色详解中列出。");
    g_wikiLine[305] = StringToText("角色标记和角色列表中的能力描述偏口语化，在绝大多数情况下你都能够依照它们处理角色能力。");
    g_wikiLine[306] = StringToText("但是一旦你遇到了能力之间冲突的情况或是发现了奇怪的角色互动方式，你就可能需要寻找更多更详细的");
    g_wikiLine[307] = StringToText("解释，这时就请查看角色详解中对应条目下的规则，或是在钟楼百科里进行搜索。");
    g_wikiLine[308] = StringToText("【1.当角色使用能力时，它会立即生效。】");
    g_wikiLine[309] = StringToText("例如，如果恶魔攻击占卜师，那么占卜师会立即死亡，无法在当晚稍后时分醒来以使用自己的能力。");
    g_wikiLine[310] = StringToText("又例如，僧侣使用能力保护了共情者，恶魔在这之后攻击共情者时，共情者就不会死亡。");
    g_wikiLine[311] = StringToText("【2.说书人仅需要告诉玩家他通过自己的角色能力能够得知的信息。】");
    g_wikiLine[312] = StringToText("秘密就是秘密。如果小恶魔死亡后红唇女郎变成了小恶魔，其他玩家会知道这件事情发生了吗？");
    g_wikiLine[313] = StringToText("他们不知道。如果猎手使用了自己的能力但什么事情也没发生，其他玩家会知道他真的是猎手吗？");
    g_wikiLine[314] = StringToText("他们不知道。如果僧侣保护了洗衣妇，洗衣妇会知道自己被保护了吗？她不知道。当夜晚结束时，");
    g_wikiLine[315] = StringToText("玩家会知道是什么能力杀死了哪名玩家吗？不，他们只会知道哪些玩家死亡，但不会知道是如何死亡的。");
    g_wikiLine[316] = StringToText("【3.角色能力会在死亡，中毒或醉酒的那一刻立即失去，同时能力产生的所有持续型效果也会终止。");
    g_wikiLine[317] = StringToText("】但如果角色从中毒或醉酒中恢复健康和清醒，角色能力和原本已经生效的持续型效果也会继续生效，");
    g_wikiLine[318] = StringToText("但中毒与醉酒期间的能力不会产生任何效果。");
    g_wikiLine[319] = StringToText("如果一名玩家死亡，他会立即失去自己的能力，并且因他能力而产生的所有持续性效果都会终止，");
    g_wikiLine[320] = StringToText("因此你可以移除他的角色对应的所有提示标记。例如，如果投毒者在夜晚让猎手中毒，");
    g_wikiLine[321] = StringToText("但在同一晚的稍后时分死去，猎手也就不再中毒。即使投毒者的能力可以「持续到黄昏」，");
    g_wikiLine[322] = StringToText("但一旦投毒者死亡，他会立即失去能力，持续性效果也随之终止。");
    g_wikiLine[323] = StringToText("当玩家醉酒或中毒时，你可以移除他的角色对应的提示标记。然而很多时候，");
    g_wikiLine[324] = StringToText("你可以通过倒转放置他的角色对应的提示标记来表示这些标记暂时没有效果，");
    g_wikiLine[325] = StringToText("这样方便在这名玩家恢复清醒和健康之后让这些效果继续产生作用。");
    g_wikiLine[326] = StringToText("你可以在这些玩家醉酒和中毒时忽略他们角色对应的提示标记，把他们当作已经死亡一样。例如，");
    g_wikiLine[327] = StringToText("如果清醒的旅店老板保护了侍女，但随后旅店老板醉酒，那么侍女就不再被旅店老板保护了。又例如，");
    g_wikiLine[328] = StringToText("如果小佳让小米中毒，随后小文让小佳中毒，那么小米也就不再处于中毒状态。");
    g_wikiLine[329] = StringToText("【4.有的角色会在其死亡后继续保留部分或是全部能力。请留意能力描述中 「即使你已死亡」 或 ");
    g_wikiLine[330] = StringToText("「当你死亡时」 字样。】");
    g_wikiLine[331] = StringToText("如果一项能力中包含「即使你已死亡」，或这项能力在角色死亡时才会触发，");
    g_wikiLine[332] = StringToText("这些能力就会在死后继续生效。但这些能力仍然会在玩家醉酒或中毒时暂时失去。");
    g_wikiLine[333] = StringToText("如果守鸦人在夜晚被杀死，他就会使用他的能力。他的能力描述是「如果你在夜晚死亡，你会被唤醒，");
    g_wikiLine[334] = StringToText("然后你要选择一名玩家：你会得知他的角色。」即使守鸦人死亡，他仍会短暂地拥有自己的能力，");
    g_wikiLine[335] = StringToText("因为他的能力描述提到会在守鸦人死亡时产生作用。");
    g_wikiLine[336] = StringToText("【5.如果一项能力描述中没有 「选择」 一词，这项能力就由说书人来做出选择。】");
    g_wikiLine[337] = StringToText("例如，如果一项能力描述是「每个夜晚，会有一名玩家中毒」，那么由说书人来选择是哪名玩家中毒。");
    g_wikiLine[338] = StringToText("如果一项能力描述是「每个夜晚，你要选择一名玩家：他中毒」，这意味着这项能力所属角色的玩家来执");
    g_wikiLine[339] = StringToText("行选择。");
    g_wikiLine[340] = StringToText("【6.如果一名玩家尝试以错误的方式使用他的能力，立刻提醒他。如无法选择自己作为目标的玩家选择");
    g_wikiLine[341] = StringToText("了自己等。】");
    g_wikiLine[342] = StringToText("如果是在白天，那么口头告诉他，如果是在夜晚，那么摇头来表示不可以这么做。");
    g_wikiLine[343] = StringToText("僧侣的能力无法选择自己，因此如果僧侣玩家这么做了，那就摇头示意，并用手势提醒他重新选择一名玩");
    g_wikiLine[344] = StringToText("家。侍女必须选择存活的玩家，如果侍女玩家选择了死亡玩家，那你应该摇头，让她重新选择。");
    g_wikiLine[345] = StringToText("【7.如果一名玩家在游戏过程中复活、变化或交换了角色，视为他获得了一个新的角色。】");
    g_wikiLine[346] = StringToText("· 他会立即获得这个新角色的能力，并失去原本的角色能力。");
    g_wikiLine[347] = StringToText("他会立即失去原角色能力，和原角色能力有关的所有持续性效果也会立即终止。");
    g_wikiLine[348] = StringToText("如果新的能力是一项「每局游戏限一次」的能力且此前已经有人使用过，他仍然能再次使用这项能力一次。");
    g_wikiLine[349] = StringToText("如果新的能力原本只在游戏的首个夜晚产生效果，那么它会在角色变化的当晚产生效果。从死亡中复活，");
    g_wikiLine[350] = StringToText("或因为交换角色的能力而改变了角色的，也用上述同样的方式来重新获得新角色的能力。");
    g_wikiLine[351] = StringToText("· 如果一名玩家在游戏过程中变成了爪牙或恶魔角色，他不会得知其他邪恶玩家是谁，");
    g_wikiLine[352] = StringToText("也不会因为变成了恶魔角色而得知三个不在场的善良角色。");
    g_wikiLine[353] = StringToText("邪恶玩家互知是在游戏开始时的第一个夜晚才能获取的信息，因此这些信息与角色能力无关，");
    g_wikiLine[354] = StringToText("也就不会因为角色改变而得知这些初始信息。");
    g_wikiLine[355] = StringToText("· 方括号能力 [] 仅在初始设置时有效，在游戏过程中不会产生任何效果。");
    g_wikiLine[356] = StringToText("如果有玩家变成了这样的角色，这部分内容的能力也不会有任何效果。");
    g_wikiLine[357] = StringToText("【8.有的角色能力可能会在不同于夜晚顺序表列出的时机触发效果。】");
    g_wikiLine[358] = StringToText("· 如果带有 「在你的首个夜晚」 角色在游戏中途被创造，这些角色会尽可能快地进行进场能力的效");
    g_wikiLine[359] = StringToText("果结算，因为他们的能力不会在夜晚顺序表的 「其他夜晚」 部分出现。但仍需注意，");
    g_wikiLine[360] = StringToText("绝大部分获取信息的能力应该在所有会造成死亡的效果之后结算。");
    g_wikiLine[361] = StringToText("· 如果带有 「当你死亡时」 能力的角色死亡，且能力位于夜晚顺序表上时，");
    g_wikiLine[362] = StringToText("这个夜晚顺序表的位置通常来说意味着 「结算该角色死亡效果的最晚时机」。");
    g_wikiLine[363] = StringToText("说书人可以按照最及时的顺序来结算角色死亡效果，但也能依照夜晚顺序表的顺序来执行效果，");
    g_wikiLine[364] = StringToText("夜晚顺序表是作为这些角色能力生效的提示，以免说书人遗忘。在大部分情况下，");
    g_wikiLine[365] = StringToText("这两种结算方式的结果都不会有太大的差别。但是如果一项「死亡触发能力」在本该触发的时候已经过了");
    g_wikiLine[366] = StringToText("「夜晚顺序表」的顺序时，也应当在某一角色死亡时立即如常被触发。（参考罂粟种植者的夜晚顺序）");
    g_wikiLine[367] = StringToText("夜晚顺序表列举出了哪些角色会以什么样的顺序来进行行动，但有的能力的生效时机可能会不同于夜晚顺");
    g_wikiLine[368] = StringToText("序表，在更早或更晚的时候生效，例如那些在一名角色死亡时会立即生效的能力。");
    g_wikiLine[369] = StringToText("夜晚顺序表是用于帮助提醒你以什么顺序来唤醒玩家的，它可以引导你放置他们的提示标记和帷幕标记，");
    g_wikiLine[370] = StringToText("这样不会有本该进行夜晚行动但被遗忘的角色出现。按照角色标记上的能力描述结算效果相比遵守夜晚顺");
    g_wikiLine[371] = StringToText("序表的结算顺序来说更加重要。");
    g_wikiLine[372] = StringToText("恶魔杀死了贤者。说书人应该立即唤醒贤者，但是他忘记了。下一个夜晚顺序表上的角色是心上人。");
    g_wikiLine[373] = StringToText("心上人在白天时死亡了。说书人忘记在心上人死亡时立即让一名玩家醉酒，因此他现在开始执行这个操作。");
    g_wikiLine[374] = StringToText("下一个夜晚顺序表上的角色是贤者。说书人唤醒了贤者并结算了他的能力。");
    g_wikiLine[375] = StringToText("【三、状态】");
    g_wikiLine[376] = StringToText("《染》里面，玩家可能具有多种多样的状态——拥有某个角色，醉酒或清醒，存活或死亡，健康或中毒。");
    g_wikiLine[377] = StringToText("（当然，这并不是指的现实意义上的。）这些都被称之为状态。一般来说，不同的状态之间互不干涉，");
    g_wikiLine[378] = StringToText("都属于一名玩家的持续型要素。例如，如果你处于醉酒状态并改变了你的角色，你会仍然保持醉酒状态。");
    g_wikiLine[379] = StringToText("如果你处于中毒状态，你同时也能处于醉酒状态。");
    g_wikiLine[380] = StringToText("状态与玩家绑定，而不与角色绑定！");
    g_wikiLine[381] = StringToText("玩家的状态有：【角色、阵营、生死、醉酒、中毒、疯狂。】");
    g_wikiLine[382] = StringToText("在游戏开始后，【玩家的不同状态之间相互独立，互不干涉。】");
    g_wikiLine[383] = StringToText("例如：");
    g_wikiLine[384] = StringToText("抽取到善良角色的玩家初始为善良阵营，但玩家角色如果在游戏中途变成了邪恶角色，");
    g_wikiLine[385] = StringToText("不会让玩家因此转变为邪恶阵营。");
    g_wikiLine[386] = StringToText("因其他角色能力而醉酒的玩家角色发生了变化，不会让玩家因此解除醉酒。");
    g_wikiLine[387] = StringToText("【1.存活与死亡】");
    g_wikiLine[388] = StringToText("【在任意时间点，一名玩家一定会处于存活或死亡两种状态之一。】通常来说，");
    g_wikiLine[389] = StringToText("玩家会在白天因为处决而死亡，或在夜晚因为一些角色能力而死亡。");
    g_wikiLine[390] = StringToText("【处决的概念与死亡有所不同。某些情况下，一名玩家可能被处决，但仍然存活而不死亡。");
    g_wikiLine[391] = StringToText("】同一名玩家在一局游戏中可能会被多次处决，甚至已死亡的玩家也能再次被处决。");
    g_wikiLine[392] = StringToText("不论根据投票结果处决了一名存活或是已经死亡的玩家，每天都只会进行一次处决。");
    g_wikiLine[393] = StringToText("【已经死亡的玩家无法再次死亡。】例如，如果一名已死亡的玩家被恶魔攻击，他不会再一次死亡，");
    g_wikiLine[394] = StringToText("因此他被恶魔攻击这件事情也就不会被其他玩家所得知。");
    g_wikiLine[395] = StringToText("【2.阵营与角色】");
    g_wikiLine[396] = StringToText("【在任意时间点，一名玩家一定会处于善良或邪恶两种状态之一。】玩家的角色决定了玩家初始所属的阵");
    g_wikiLine[397] = StringToText("营是善良还是邪恶，但玩家的阵营可能会在游戏过程中发生变化。某些时候，");
    g_wikiLine[398] = StringToText("镇民也有可能会变成邪恶阵营。同样的，恶魔也有可能会变成善良阵营。");
    g_wikiLine[399] = StringToText("如果一名善良阵营的玩家拥有一个邪恶角色，或一名邪恶阵营的玩家拥有一个善良角色时，");
    g_wikiLine[400] = StringToText("你可以在魔典中将这些角色标记倒转放置，用以标记该玩家的当前阵营与其角色标记的颜色相反。");
    g_wikiLine[401] = StringToText("角色与阵营这两个状态之间是相对独立的。如果一名玩家改变了阵营，他的角色会保持不变，反之亦然。");
    g_wikiLine[402] = StringToText("例如，如果莽夫变为邪恶，他仍然还是莽夫。又例如，麻脸巫婆将善良的杂耍艺人变成了女巫，");
    g_wikiLine[403] = StringToText("这位女巫仍然属于善良阵营。");
    g_wikiLine[404] = StringToText("【在游戏过程中，如果玩家的阵营或角色发生变化，该玩家会在第一时间秘密得知这一变化内容。】");
    g_wikiLine[405] = StringToText("你通常可以通过展示「你是」标记以及他新的角色标记或阵营手势来告知他。");
    g_wikiLine[406] = StringToText("这些变化的产生时机会在夜晚顺序表和角色详解中体现，以此提醒你唤醒那些发生变化的玩家并告知他。");
    g_wikiLine[407] = StringToText("【得知自己的角色或阵营发生变化并不算是获得信息。因此也不会受到醉酒、");
    g_wikiLine[408] = StringToText("中毒或者类似涡流这样的角色所影响。】这是为了确保玩家都能正确地得知自己的阵营和角色。当然，");
    g_wikiLine[409] = StringToText("也会有一些例外。有时玩家会以为自己是与自己真实角色不同的角色，或是与自己真实阵营不同的阵营。");
    g_wikiLine[410] = StringToText("例如，酒鬼和疯子的设计就是为了让玩家不知道自己的真实角色是什么。");
    g_wikiLine[411] = StringToText("【3.醉酒与中毒】");
    g_wikiLine[412] = StringToText("【在任意时间点，一名玩家一定会处于清醒或醉酒两种状态之一，也一定会处于中毒或健康两种状态之一。");
    g_wikiLine[413] = StringToText("】醉酒状态与中毒状态实际上是相似的。无论玩家存活还是死亡，玩家都能醉酒或中毒。");
    g_wikiLine[414] = StringToText("【醉酒或中毒的玩家会失去能力。如果一名玩家在他醉酒或中毒期间尝试使用自己的「每局游戏限一次」");
    g_wikiLine[415] = StringToText("的能力，他无法在之后再次使用这项能力。使用机会会被浪费。】醉酒的猎手无法杀死任何人，");
    g_wikiLine[416] = StringToText("中毒的恶魔也是如此。醉酒的贞洁者无法在被提名时使用他的能力来造成处决，");
    g_wikiLine[417] = StringToText("中毒的侍臣也无法让任何人醉酒。");
    g_wikiLine[418] = StringToText("【醉酒或中毒的玩家能有机会恢复能力。】如果一名醉酒的玩家恢复清醒，或一名中毒的玩家恢复健康，");
    g_wikiLine[419] = StringToText("那么他就能恢复自己的能力。即便如此，如果他已经使用了自己的 「每局游戏限一次」 能力，很不幸，");
    g_wikiLine[420] = StringToText("他仍无法再次使用这项能力。");
    g_wikiLine[421] = StringToText("【不要告诉玩家他醉酒或是中毒了！取而代之的是，让他们以清醒和健康的状态来执行行动。】例如，");
    g_wikiLine[422] = StringToText("醉酒的僧侣仍然会在夜晚醒来并选择一名玩家来保护，但那名玩家不会受到保护。");
    g_wikiLine[423] = StringToText("中毒的恶魔仍然会在夜晚醒来并攻击玩家，但没有人会因此死亡，恶魔也不会得知究竟发生了什么。");
    g_wikiLine[424] = StringToText("某些时候你可能想要提示他们正醉酒或中毒，例如在没有人宣称自己是镇长的时候告诉送葬者白天被处决");
    g_wikiLine[425] = StringToText("的是镇长来提示他中毒，但这种允许你给出提示的机会比较少见。");
    g_wikiLine[426] = StringToText("【醉酒或中毒的玩家，其角色能力可能会获取到错误的信息。】醉酒或中毒的玩家会失去能力，");
    g_wikiLine[427] = StringToText("但会认为自己还拥有能力。因此如果他们的能力能够获取信息，你可以给出错误的信息。例如，");
    g_wikiLine[428] = StringToText("醉酒的共情者仍会在每个夜晚醒来并得知信息，但你可以告诉他错误的数字。");
    g_wikiLine[429] = StringToText("送葬者本该看到当天死于处决的玩家的角色标记，但你可以对中毒的他展示错误的角色标记。");
    g_wikiLine[430] = StringToText("你并非一定要给出错误信息，但你可以这么做，通常你也应该这么做！");
    g_wikiLine[431] = StringToText("【醉酒与中毒状态不会互相抵消。】一名醉酒的玩家中毒并不意味着他会因此恢复清醒和健康！");
    g_wikiLine[432] = StringToText("他仅仅只是同时醉酒并中毒了。");
    g_wikiLine[433] = StringToText("【对醉酒或中毒的玩家所使用的能力仍然会正常生效。】例如，共情者会正确地得知与他邻近的醉酒玩家");
    g_wikiLine[434] = StringToText("的阵营。占卜师也能正确地判断出中毒的恶魔角色。如果公爵夫人——一个能对三名玩家提供信息的传奇");
    g_wikiLine[435] = StringToText("角色——被一名中毒的猎手拜访，猎手仍然会因此获得正确的信息。在这个例子里，即使猎手中毒，");
    g_wikiLine[436] = StringToText("公爵夫人的能力正常生效。");
    g_wikiLine[437] = StringToText("【即使玩家醉酒或中毒，说书人也要保持给他们提供正确的规则。】玩家需要在规则方面完全地信任你。");
    g_wikiLine[438] = StringToText("【虽然在范例参考中经常提到 「中毒或醉酒的角色」，但是醉酒和中毒状态是玩家的状态，");
    g_wikiLine[439] = StringToText("而非角色状态。】如果一名醉酒的玩家改变了自己的角色，他仍然处于醉酒状态。");
    g_wikiLine[440] = StringToText("如果一名中毒的玩家与其他玩家交换了角色，他仍然处于中毒状态。");
    g_wikiLine[441] = StringToText("【如果一项能力是持续型的能力或者正在游戏中产生效果，玩家会在醉酒或中毒时失去这些能力，");
    g_wikiLine[442] = StringToText("但会在恢复清醒和健康时继续执行这些能力的效果。】");
    g_wikiLine[443] = StringToText("（注：生死类互动干扰能力是例外，它包含了即时型效果和持续型效果两个部分，");
    g_wikiLine[444] = StringToText("在醉酒中毒时只会让持续型效果部分失效，但即时型效果部分因为已经生效所以不会再变为无效。");
    g_wikiLine[445] = StringToText("具体可以参考互动干扰页面或相关角色页面）");
    g_wikiLine[446] = StringToText("茶艺师中毒了，因此她无法再保护与她邻近的玩家。稍晚时分，茶艺师恢复了健康，");
    g_wikiLine[447] = StringToText("因此她能再次保护与她邻近的玩家。");
    g_wikiLine[448] = StringToText("处于清醒状态的女巫诅咒了一名玩家。随后女巫醉酒，因此那名玩家不再被诅咒。当女巫恢复清醒时，");
    g_wikiLine[449] = StringToText("那名玩家就会再次被诅咒。");
    g_wikiLine[450] = StringToText("当玩家在醉酒或中毒的状态下使用或触发了能力，他的能力就被浪费了。这时他的能力没有效果，");
    g_wikiLine[451] = StringToText("即使之后他恢复了清醒和健康以后，这项能力也不会再次生效。");
    g_wikiLine[452] = StringToText("中毒的心上人死亡了。心上人就不会让一名玩家醉酒。即使之后心上人恢复了健康，");
    g_wikiLine[453] = StringToText("也不会有玩家因此醉酒。");
    g_wikiLine[454] = StringToText("醉酒的旅店老板选择保护了两名玩家。这些玩家不会获得被保护的效果，即使旅店老板恢复了清醒也不会。");
    g_wikiLine[455] = StringToText("如果一项能力在玩家清醒和健康时被触发或被使用，能力就会正常生效。即使这项能力需要依靠使用之前");
    g_wikiLine[456] = StringToText("的某个条件来作为前提，在能力生效之前的醉酒或中毒状态也不会对这些前提条件产生影响。（参考：");
    g_wikiLine[457] = StringToText("回溯型能力）");
    g_wikiLine[458] = StringToText("即使杂耍艺人在白天进行猜测的时候处于醉酒状态，只要他夜晚醒来时是清醒的，他就会得到正确的信息。");
    g_wikiLine[459] = StringToText("《染》在设计的过程中尽可能避开了一些奇怪的作用时机。当你有任何疑问时，");
    g_wikiLine[460] = StringToText("参考角色详解中对应条目以获得相关解释。");
    g_wikiLine[461] = StringToText("小贴士：为了更好地让醉酒和中毒效果产生实际作用，仔细聆听那些邪恶玩家的谎言，");
    g_wikiLine[462] = StringToText("并在允许的情况下来提供能够支撑这些谎言的信息。例如，如果醉酒的守鸦人选择了想要得知道哥的角色，");
    g_wikiLine[463] = StringToText("而道哥是谎称自己是镇长的男爵。你能通过对守鸦人展示镇长角色标记来协助邪恶阵营。");
    g_wikiLine[464] = StringToText("如果醉酒的守鸦人选择想要得知一名善良玩家的角色，那么展示一个邪恶角色标记同样能够起到作用。");
    g_wikiLine[465] = StringToText("一般来说，你应该让中毒和醉酒效果对对应的玩家尽可能产生不利的结果。");
    g_wikiLine[466] = StringToText("【4.疯狂】");
    g_wikiLine[467] = StringToText("《梦殒春宵》剧本套装中，会引出疯狂这个状态。在众多的剧本套装中，疯狂这个状态会非常少见，");
    g_wikiLine[468] = StringToText("只有少部分角色会造成疯狂。比起游戏状态来说，疯狂效果更像是一个现实中的状态。");
    g_wikiLine[469] = StringToText("你无法在魔典中查看一名角色是否疯狂，但你可以通过观察和聆听玩家们的言语来断定一名玩家是否疯狂。");
    g_wikiLine[470] = StringToText("当一名玩家需要 「疯狂」 地证明某件事情时，意味着他应该去努力说服其他玩家那件事情是真的。");
    g_wikiLine[471] = StringToText("有的角色要求玩家需要 「疯狂」 地证明某件事情，也有的角色会要求玩家不能 「疯狂」 地证明某");
    g_wikiLine[472] = StringToText("件事情（也就意味着他应该去努力说服其他玩家那件事情是假的）。");
    g_wikiLine[473] = StringToText("当一名玩家没有按照角色能力要求来疯狂地向他人证明某件事情时，说书人可以对他进行惩罚。同样，");
    g_wikiLine[474] = StringToText("如果他疯狂地证明了那件事情，说书人可以给他奖励。对疯狂的要求，奖励和惩罚都会在对应角色标记和");
    g_wikiLine[475] = StringToText("角色列表上的能力描述中找到。");
    g_wikiLine[476] = StringToText("畸形秀演员的能力是「如果你‘疯狂’地证明你是外来者，你可能会被处决。」小艾的角色是畸形秀演员。");
    g_wikiLine[477] = StringToText("如果他尝试对其他玩家证明他是畸形秀演员，或者说自己是一名外来者，那他就是在疯狂地证明「自己是");
    g_wikiLine[478] = StringToText("外来者」这件事情。小艾可能会说一些类似「我是畸形秀演员！」或是「我不是一个镇民……但我不会告");
    g_wikiLine[479] = StringToText("诉你我的角色。」之类的话。在这两种情况下，说书人都可以立即处决他。");
    g_wikiLine[480] = StringToText("小艾也可能会改为尝试一些更加隐晦的表达。他可以说类似「我不会告诉你我的角色是什么，");
    g_wikiLine[481] = StringToText("但我一定不是畸形秀演员」，并咧嘴露出俏皮的笑容，或是在其他玩家指控他是畸形秀演员时保持沉默。");
    g_wikiLine[482] = StringToText("在这两种情况下，说书人可以判定小艾在尝试说服其他玩家自己是畸形秀演员。在第一个例子里，");
    g_wikiLine[483] = StringToText("他虽然说的是某个意思，但实际上却在暗示另一个意思。在第二个例子里，他虽然什么都没有说，");
    g_wikiLine[484] = StringToText("但他正希望其他玩家因为自己什么而不说而断定他就是畸形秀演员。在这两种情况下，");
    g_wikiLine[485] = StringToText("说书人都可能会处决他。");
    g_wikiLine[486] = StringToText("同样地，甚至是在说书人没有注意到小艾告诉任何人他是一个外来者时，一名邪恶玩家私下对说书人说：");
    g_wikiLine[487] = StringToText("「小艾告诉我他是畸形秀演员」，那么这就有足够的证据来证明小艾正尝试告诉其他玩家自己就是畸形秀");
    g_wikiLine[488] = StringToText("演员，因此说书人能够处决他。");
    g_wikiLine[489] = StringToText("洗脑师的能力会告知一名玩家让他「疯狂」地证明自己是某个特定的角色，");
    g_wikiLine[490] = StringToText("被洗脑的玩家如果没有表现出疯狂的行为，就会被处决。洗脑师选择小美来疯狂地证明自己是贤者，");
    g_wikiLine[491] = StringToText("所以小美应该尽她最大努力来向他人证明她就是贤者，否则她就冒着被处决的风险。");
    g_wikiLine[492] = StringToText("而小美只是坐在那里一言不发，她成功地做出了或许是一名贤者应有的行为——保持沉默——但她仍然没");
    g_wikiLine[493] = StringToText("有尝试向其他玩家证明她真的是贤者。这需要她表达更多——她可以用以下发言作为开头：「我是贤者。");
    g_wikiLine[494] = StringToText("我昨天在自己的角色上撒了谎，这样恶魔就会来攻击我了。但是，哎，这并没有产生什么作用。好吧，");
    g_wikiLine[495] = StringToText("我摊牌了，我就是贤者。」但小美没有这么做而是保持沉默，因此说书人认为小美并没有非常努力地说服");
    g_wikiLine[496] = StringToText("大家她是贤者，说书人可以自行决定是否处决她。");
    g_wikiLine[497] = StringToText("不要强迫玩家 「疯狂」 地去证明某事。玩家可以随时说任何他们想说的话——他们不会被强迫来说出");
    g_wikiLine[498] = StringToText("任何他们不愿意说出的内容。疯狂这一机制，会鼓励玩家说一部分内容，而不鼓励玩家说另一部分内容。");
    g_wikiLine[499] = StringToText("如果一名玩家确确实实地说出了「我现在疯狂了」，或者其他有明显暗示意味的内容，那");
    g_wikiLine[500] = StringToText("么说书人可以对这些玩家给出相应的惩罚或移除相应的奖励。因为这种言论会像是玩家在说「我并不希望");
    g_wikiLine[501] = StringToText("因为这件事情而显得疯狂，我情愿接受惩罚。」即使玩家仅仅在暗示自己正处于疯狂状态，");
    g_wikiLine[502] = StringToText("这也算是他没有做出疯狂的行为。");
    g_wikiLine[503] = StringToText("一名此前曾疯狂过而现在未疯狂的玩家可以自由谈论他之前的行为而无需接受惩罚。一旦玩家不再疯狂了，");
    g_wikiLine[504] = StringToText("他就能够让其他玩家知道他曾经疯狂过，而不会受到惩罚。例如，被洗脑师在上上个夜晚选择过但上个夜");
    g_wikiLine[505] = StringToText("晚未选择的玩家，可以开心地告诉其他人自己曾经被洗脑过这件事情，无需担心自己会被处决。");
    g_wikiLine[506] = StringToText("已经死亡的畸形秀演员不再具有自己的能力，也因此不用再害怕自己的能力可能会引起的后果。");
    g_wikiLine[507] = StringToText("你作为说书人，有对玩家的表现是否符合「疯狂」状态的最终裁决权。没有任何规则来限定疯狂状态下什");
    g_wikiLine[508] = StringToText("么必须说，什么必须不能说。一切都取决于你是如何看待玩家试图去做某件事情的目的。");
    g_wikiLine[509] = StringToText("让我们回到前面那个畸形秀演员的例子，如果你认为那名玩家正在诚挚地向大家证明自己不是畸形秀演员，");
    g_wikiLine[510] = StringToText("那么他就没有在自己是畸形秀演员这件事情上显露疯狂。但如果你认为他正在向大家证明他是一名外来者，");
    g_wikiLine[511] = StringToText("不论那有多么隐晦，他也完蛋了。他现在任由你处置了。");
    g_wikiLine[512] = StringToText("我们再回到前面洗脑师的例子，如果你认为被洗脑师洗脑的玩家正诚挚地尽最大可能来向其他玩家证明他");
    g_wikiLine[513] = StringToText("是贤者，那么他就在证明自己是贤者这件事情上显露疯狂，因此他也就能免于被处决。");
    g_wikiLine[514] = StringToText("但如果你认为他只是半真半假，并未发自内心地说一些干瘪的话语，且他没有想要让人相信的诚意，");
    g_wikiLine[515] = StringToText("甚至仅仅只是在你看来他在尽最大的努力不让其他人相信他而已，那么你可以随你的意愿来让他承受被处");
    g_wikiLine[516] = StringToText("决的惩罚。");
    g_wikiLine[517] = StringToText("通常来说，你应该在你的裁决上显得强硬。如果玩家开始相信他只需要逢场作戏就可避免疯狂效果的惩罚，");
    g_wikiLine[518] = StringToText("他们就会按那种方式来进行游戏。如果这种情况发生了，并不意味着世界会因此毁灭，");
    g_wikiLine[519] = StringToText("然而疯狂机制的乐趣就是在于有意识地去对自己的阵营传播谎言和错误信息，");
    g_wikiLine[520] = StringToText("且不能在你恢复理智前承认它！");
    g_wikiLine[521] = StringToText("进阶的玩家应该能明白如何在疯狂效果下游刃有余，然而一些新手玩家可能会因此困惑。");
    g_wikiLine[522] = StringToText("说书人应该将这种情况也纳入考量，来决定是否应该在某个疯狂效果上去惩罚一名玩家。");
    g_wikiLine[523] = StringToText("例如，小黑作为一名高手玩家，正被指示要疯狂地证明自己是卖花女孩，那么他最好是告诉大家在之前的");
    g_wikiLine[524] = StringToText("哪些天里恶魔投票了。如果小黑表现的像是自己真的是卖花女孩，对大家表明了自己的角色，");
    g_wikiLine[525] = StringToText("那么其他玩家也没有理由去拒绝他给出的卖花女孩的信息。因为他是高手玩家，");
    g_wikiLine[526] = StringToText("在疯狂这一效果上他不会有任何宽容的余地。如果他切实努力地证明自己是卖花女孩，那么他就能存活！");
    g_wikiLine[527] = StringToText("对新手玩家则应该稍加放宽要求。只要你认为他们正在尽自己努力进行证明，");
    g_wikiLine[528] = StringToText("那么你在判断他们是否达到 「疯狂」 要求时就可以有所保留。玩家并不需要真正说服其他人才算达成");
    g_wikiLine[529] = StringToText(" 「疯狂」 的要求，他们仅仅只是需要在这一行为上有足够的诚意。");
    g_wikiLine[530] = StringToText("关于疯狂的拓展阅读：疯狂规则如何运作？——疯狂的小精灵");
    // 2 术语汇总
    g_wikiAt[2] = 531;
    g_wikiN[2] = 156;
    g_wikiLine[531] = StringToText("【白天：】所有玩家睁眼，相互交谈，并为处决投票的阶段。每个白天阶段结束后，会进入夜晚阶段。");
    g_wikiLine[532] = StringToText("每个夜晚阶段结束后，会进入白天阶段。");
    g_wikiLine[533] = StringToText("【不在场：】指在当前游戏中不存在，但出现在角色列表上的角色。");
    g_wikiLine[534] = StringToText("【城镇广场：】放置在游戏区域正中的紫色游戏面板。城镇广场上会有玩家的生命标记和投票标记，");
    g_wikiLine[535] = StringToText("在下方会放置旅行者列表。");
    g_wikiLine[536] = StringToText("【初始设置表：】详细列举了说书人需要在一局游戏开始时做的事情的列表。");
    g_wikiLine[537] = StringToText("【处决：】在白天时玩家集体决定杀死一位非旅行者玩家的行为。每个白天最多能够进行一次处决，");
    g_wikiLine[538] = StringToText("但也可以不进行处决。在一天的处决提名中得到至少等同于当前存活玩家数量一半的票数，");
    g_wikiLine[539] = StringToText("且得到比其他被提名的玩家更多票数的玩家会被处决。");
    g_wikiLine[540] = StringToText("【传奇角色：】一种说书人可用的角色类型。传奇角色均为中立，被说书人公开选择，");
    g_wikiLine[541] = StringToText("且通常用于在少见的情形下让游戏变得更加公平。");
    g_wikiLine[542] = StringToText("【存活：】尚未死亡的玩家。存活玩家会具有他们的角色能力，能够在任意提名中参与投票，");
    g_wikiLine[543] = StringToText("也可以对玩家发起提名。有三人以上的玩家存活时，游戏就会持续进行。");
    g_wikiLine[544] = StringToText("【错误信息：】错误的信息，例如错误的陈述，手势，或角色标记。当一名角色被当作与之不同的角色或");
    g_wikiLine[545] = StringToText("阵营时，或使用能力的角色醉酒或中毒时，说书人可以给出错误的信息。（参考正确信息部分。）");
    g_wikiLine[546] = StringToText("【当作：】具有「被当作」特定的角色或阵营的玩家会在游戏规则或其他玩家的能力中被当作对应的角色");
    g_wikiLine[547] = StringToText("或阵营。例如，如果一名善良玩家「被当作邪恶阵营」，该玩家仍然是善良玩家（且会在善良阵营获胜时");
    g_wikiLine[548] = StringToText("获胜），但该玩家会在其他探查邪恶阵营的效果作用时被当作邪恶。被当作某种角色并不会真正获取这种");
    g_wikiLine[549] = StringToText("角色的能力。");
    g_wikiLine[550] = StringToText("【恶魔：】一种初始为邪恶阵营的角色类型。如果所有的恶魔均已死亡，善良阵营获胜。");
    g_wikiLine[551] = StringToText("恶魔通常会在夜晚攻击玩家，且会有一些其他的危害善良阵营的能力。");
    g_wikiLine[552] = StringToText("【恶魔玩家：】拥有恶魔角色的玩家。在一场有多个恶魔存在的游戏中，每名恶魔玩家存活与否都会被计");
    g_wikiLine[553] = StringToText("入善良阵营获胜条件之中。");
    g_wikiLine[554] = StringToText("【恶魔信息：】缩略词，出现在七人及以上的游戏中夜晚顺序表上，代表恶魔玩家在首个夜晚时获得的信");
    g_wikiLine[555] = StringToText("息。恶魔会得知哪些玩家是爪牙，且会得知三个不在场的善良角色，以助于恶魔进行伪装。");
    g_wikiLine[556] = StringToText("【疯狂：】处于疯狂状态的玩家需要尝试向他人证明某件事情是正确的。一些玩家会被告知需要疯狂证明");
    g_wikiLine[557] = StringToText("某事——如果说书人认为该玩家没有尝试向他人证明那件事情，可能会有相应的惩罚出现。");
    g_wikiLine[558] = StringToText("一些玩家会被告知需要避免疯狂证明某事——如果说书人认为该玩家尝试向他人证明那件事情，");
    g_wikiLine[559] = StringToText("可能会有相应的惩罚出现。");
    g_wikiLine[560] = StringToText("【复活（起死回生/被反刍/重生/破坟）：】一名已死亡玩家再次变为存活玩家的行为。当复活发生后，");
    g_wikiLine[561] = StringToText("玩家会重新获得能力，即使是那些「每局游戏限一次」且该玩家已使用过的能力也会重新获得。");
    g_wikiLine[562] = StringToText("如果该能力是仅在首个夜晚生效的能力，会在复活的当晚生效。");
    g_wikiLine[563] = StringToText("【公开：】让绝大多数玩家及说书人知晓的内容或行为。");
    g_wikiLine[564] = StringToText("【规则解释：】在一局游戏开始时需要念出的内容，以便让新手玩家能够得知重要规则。");
    g_wikiLine[565] = StringToText("如果这些玩家愿意，他们也可以选择独自阅读这些规则。");
    g_wikiLine[566] = StringToText("【唤醒：】在夜晚阶段时玩家睁开眼睛的行为。说书人会在玩家的膝盖或肩膀上轻拍两下以唤醒一名玩家，");
    g_wikiLine[567] = StringToText("或在黎明时宣布「所有人睁眼」以唤醒所有玩家。");
    g_wikiLine[568] = StringToText("【黄昏：】夜晚的开始时点，在所有玩家闭眼之后。进行「在黄昏时」相关行动的角色会在绝大多数其他");
    g_wikiLine[569] = StringToText("玩家之前进行行动。具有「持续至黄昏」的能力效果会在所有玩家闭眼后终止。");
    g_wikiLine[570] = StringToText("【获胜：】在一局游戏结束时，某一阵营会获胜。如果某一阵营获胜，该阵营内的所有玩家均会获胜，");
    g_wikiLine[571] = StringToText("不论这些玩家是否存活。当所有恶魔死亡时，善良阵营获胜。当仅有两名玩家存活时（旅行者的数量不计");
    g_wikiLine[572] = StringToText("算在内），邪恶阵营获胜。");
    g_wikiLine[573] = StringToText("【即将被处决：】指在一天的处决提名中得到足够的票数，且得到比其他玩家更多票数的玩家。");
    g_wikiLine[574] = StringToText("【健康：】未中毒状态。");
    g_wikiLine[575] = StringToText("【角色：】玩家扮演的对象，例如管家。角色会被罗列在对应剧本套装的角色列表及角色详解中。");
    g_wikiLine[576] = StringToText("角色可能会有在场和不在场两种状态。");
    g_wikiLine[577] = StringToText("【角色标记：】每名玩家在游戏开始时会拿到的表明自己角色的较大圆形标记。");
    g_wikiLine[578] = StringToText("玩家之间不能互相查看对方的角色标记。");
    g_wikiLine[579] = StringToText("【角色类型：】用于区分不同种类的角色：镇民、外来者、爪牙、恶魔、旅行者、传奇角色或奇遇角色。");
    g_wikiLine[580] = StringToText("【角色列表：】一叠罗列出对应剧本中可能出现的所有角色及角色能力的纸张。");
    g_wikiLine[581] = StringToText("【剧本：】一套多个角色汇集成的列表，通过剧本工具生成，且能被打印并用作角色列表。");
    g_wikiLine[582] = StringToText("【剧本工具：】允许你自由组合你所拥有的角色标记并生成剧本的在线工具。");
    g_wikiLine[583] = StringToText("【剧本套装：】《染》的多个剧本之一，包含一套角色标记、角色列表和一份角色详解。");
    g_wikiLine[584] = StringToText("例如《暗流涌动》。每一个剧本套装都具有一个较为统一的主题、策略以及基调。");
    g_wikiLine[585] = StringToText("【可能：】在角色标记与角色列表上的缩略词。某件事情「可能」发生，代表由说书人来决定该事情是否");
    g_wikiLine[586] = StringToText("发生。");
    g_wikiLine[587] = StringToText("【黎明：】夜晚的结束时点，下一个白天开始之前。进行「在黎明时」相关行动的角色会在绝大多数其他");
    g_wikiLine[588] = StringToText("玩家之后进行行动。");
    g_wikiLine[589] = StringToText("【流放：】在白天时玩家集体决定杀死一位旅行者玩家的行为。每个白天可以进行任意次数的流放，");
    g_wikiLine[590] = StringToText("也可以不进行任何流放。任何玩家都可以支持流放，已死亡玩家也可以不消耗投票标记进行支持。");
    g_wikiLine[591] = StringToText("角色能力不能以任何形式影响流放。即使流放与投票处决相似，但流放的流程不是投票，流放也不是处决。");
    g_wikiLine[592] = StringToText("（参考投票与处决部分。）");
    g_wikiLine[593] = StringToText("【旅行者：】一种为晚到或想要提前离开的玩家准备的角色类型。由玩家自己选择旅行者角色，");
    g_wikiLine[594] = StringToText("然后由说书人来选择旅行者玩家的阵营。旅行者具有强大的能力，但能被玩家集体流放。");
    g_wikiLine[595] = StringToText("【旅行者列表：】放置于小镇广场之下的列表。列举出了当前游戏中会有多少名镇民、外来者、");
    g_wikiLine[596] = StringToText("爪牙和恶魔，且列举了所有旅行者的能力。");
    g_wikiLine[597] = StringToText("【落败：】在一局游戏结束时，某一阵营会落败。如果某一阵营落败，该阵营内的所有玩家均会落败，");
    g_wikiLine[598] = StringToText("不论这些玩家是否存活。当所有恶魔死亡时，邪恶阵营落败。当仅有两名玩家存活时（旅行者的数量不计");
    g_wikiLine[599] = StringToText("算在内），善良阵营落败。");
    g_wikiLine[600] = StringToText("【每个夜晚：】每个夜晚阶段。");
    g_wikiLine[601] = StringToText("【每个夜晚*：】位于角色列表和角色标记上的缩略词，指代「除第一个夜晚阶段之外的每个夜晚阶段」。");
    g_wikiLine[602] = StringToText("【每局游戏限一次：】一项玩家仅能使用一次的能力。如果一名玩家使用了这种能力，");
    g_wikiLine[603] = StringToText("即使该玩家在使用能力时醉酒或中毒，该玩家也无法再次使用这种能力。如果一名玩家在未使用这种能力");
    g_wikiLine[604] = StringToText("的情况下死亡，该玩家失去使用机会。");
    g_wikiLine[605] = StringToText("【盟友：】同一阵营的玩家。");
    g_wikiLine[606] = StringToText("【明天：】在当前夜晚阶段之后的下一个白天和夜晚阶段。");
    g_wikiLine[607] = StringToText("【魔典：】用于存放钟楼配件的盒子，在游戏中会由说书人持有并实时更新。玩家无法查看魔典。");
    g_wikiLine[608] = StringToText("魔典中会显示所有角色的实际状态，如哪些玩家存活，哪些玩家中毒，哪些玩家会在夜晚行动，等等。");
    g_wikiLine[609] = StringToText("【能力：】角色带有的特殊力量或惩罚，会出现在角色标记、对应剧本套装中的角色列表及角色详解中。");
    g_wikiLine[610] = StringToText("角色能力的定义文本会显示在角色列表上，而角色详解则用于作为规则指引。当角色死亡、醉酒或中毒时，");
    g_wikiLine[611] = StringToText("角色会失去能力。");
    g_wikiLine[612] = StringToText("【清醒：】未醉酒状态。");
    g_wikiLine[613] = StringToText("【染：】《染·钟楼谜团》，世界上最棒的语言类游戏！");
    g_wikiLine[614] = StringToText("【善良：】指善良阵营。所有的镇民和外来者（蓝色的角色）初始为善良。当所有的恶魔均已死亡时，");
    g_wikiLine[615] = StringToText("善良阵营获胜。");
    g_wikiLine[616] = StringToText("【善良角色：】镇民和外来者。");
    g_wikiLine[617] = StringToText("【生命标记：】放置在小镇广场上的标记，每个标记对应一个玩家的座位，");
    g_wikiLine[618] = StringToText("会展示有哪些玩家存活或已死亡。标记较亮的一面表示该玩家存活，较暗的一面表示该玩家已死亡。");
    g_wikiLine[619] = StringToText("【首个夜晚：】游戏开始时的第一个夜晚阶段。有一些角色仅在首个夜晚进行行动。");
    g_wikiLine[620] = StringToText("有一些角色在除首个夜晚以外的每个夜晚行动。玩家仅能在首个夜晚之后才能开始讨论与自己的角色有关");
    g_wikiLine[621] = StringToText("的话题。");
    g_wikiLine[622] = StringToText("【说书人：】主持游戏的人。说书人会持有魔典，遵从游戏规则，且对需要进行判断的状况做出最终决定。");
    g_wikiLine[623] = StringToText("【私下：】两名玩家之间，或一名玩家与说书人之间耳语的内容，以使其他玩家无法听到。");
    g_wikiLine[624] = StringToText("【提名：】被说书人宣告的，玩家发起集体投票以处决一名玩家的行为。每名玩家每个白天能发起一次提");
    g_wikiLine[625] = StringToText("名，每名玩家每个白天仅能被提名一次。只有存活玩家才可以发起提名。");
    g_wikiLine[626] = StringToText("【提示标记：】帮助说书人记录各种事情的小标记。每个提示标记都属于特定的角色。");
    g_wikiLine[627] = StringToText("【投票：】当说书人统计一次处决提名时，举手表示赞成这次处决的行为。");
    g_wikiLine[628] = StringToText("每个白天玩家可以进行任意次数的投票。已死亡玩家在余下的游戏时间里只能进行一次投票。");
    g_wikiLine[629] = StringToText("投票会以顺时针方向进行统计，并终止于当前被提名的玩家。流放流程，虽然与投票相似，但并不是投票。");
    g_wikiLine[630] = StringToText("（参考流放部分。）");
    g_wikiLine[631] = StringToText("【投票标记：】当玩家死亡时，被放置于玩家生命标记之上的圆形标记。当已死亡玩家投票后，");
    g_wikiLine[632] = StringToText("其投票标记会移除，且无法在余下的游戏时间里进行投票。");
    g_wikiLine[633] = StringToText("【外来者：】一种初始为善良阵营的角色类型。外来者拥有对善良阵营无用的能力。");
    g_wikiLine[634] = StringToText("旅行者列表中列举了不同游戏人数下的外来者数量。");
    g_wikiLine[635] = StringToText("【玩家：】任何拥有一个在场角色的人，说书人不包括在内。");
    g_wikiLine[636] = StringToText("【帷幕标记：】黑色旗帜形状的标记，用于在魔典中表示一名玩家已死亡。");
    g_wikiLine[637] = StringToText("【邪恶：】指邪恶阵营。所有的爪牙和恶魔（红色的角色）初始为邪恶。当仅有两名玩家存活时（旅行者");
    g_wikiLine[638] = StringToText("的数量不计算在内），邪恶阵营获胜。");
    g_wikiLine[639] = StringToText("【邪恶角色：】爪牙和恶魔。");
    g_wikiLine[640] = StringToText("【信息：】玩家从说书人处获得的内容，如（对游戏内事实的）陈述，手势，或角色标记。");
    g_wikiLine[641] = StringToText("【信息标记：】方形的标记，用于给出信息，会在夜晚的某些时候向玩家展示。例如，「这是恶魔」标记。");
    g_wikiLine[642] = StringToText("【宣布：】对玩家群体的声明，以便让所有人都能听到你的声音的行为。");
    g_wikiLine[643] = StringToText("【选择：】这一术语出现在角色能力描述中，表明对应的玩家需要做出一些决定。");
    g_wikiLine[644] = StringToText("如果该术语在角色能力中未曾出现，则相应的决定由说书人做出。");
    g_wikiLine[645] = StringToText("【叶子：】在一些角色标记上出现的有颜色区分的记号，用于辅助说书人来进行游戏。");
    g_wikiLine[646] = StringToText("顶侧的绿色叶子会显示该角色会添加进魔典的提示标记的数量。左侧的绿色叶子代表该角色需要一个夜晚");
    g_wikiLine[647] = StringToText("标记用于首个夜晚。右侧的绿色叶子代表该角色需要一个夜晚标记用于其他夜晚。");
    g_wikiLine[648] = StringToText("橙色的花瓣代表该角色会在游戏的常规初始设置上修改设置方式。");
    g_wikiLine[649] = StringToText("【夜晚：】所有玩家闭眼，特定玩家会被唤醒以进行行动或获取信息的阶段。游戏会从夜晚阶段开始。");
    g_wikiLine[650] = StringToText("每个夜晚阶段结束后，会进入白天阶段。每个白天阶段结束后，会进入夜晚阶段。");
    g_wikiLine[651] = StringToText("【夜晚标记：】说书人放置在夜晚顺序表旁边，用于表示哪些角色需要进行夜晚行动的标记。");
    g_wikiLine[652] = StringToText("角色标记上左右两侧的叶子显示了这些角色是否需要对应的夜晚标记。");
    g_wikiLine[653] = StringToText("【夜晚顺序表：】说书人用于知晓哪些角色会以哪种顺序进行行动的列表。");
    g_wikiLine[654] = StringToText("夜晚顺序表的一面适用于首个夜晚，另一面适用于其他夜晚。");
    g_wikiLine[655] = StringToText("【死亡：】不再存活的玩家。已死亡玩家在余下的游戏中仅能参与最多一次投票。当一名玩家死亡后，");
    g_wikiLine[656] = StringToText("玩家的生命标记会翻转，并获得一枚投票标记。在魔典中，该玩家的角色会获得帷幕标记，");
    g_wikiLine[657] = StringToText("该玩家会立即失去角色能力，其角色能力所产生的任何持续性的效果也会立即终止。");
    g_wikiLine[658] = StringToText("【以为：】如果一名玩家以为自己是不同于原本角色的其他角色，该玩家会收到一个与魔典中他的实际角");
    g_wikiLine[659] = StringToText("色不符的角色标记。说书人会做出虚假的行为让该玩家以为自己是这个错误的角色。");
    g_wikiLine[660] = StringToText("【与之邻近的存活玩家：】两名在座次上与相关玩家距离最近的存活玩家——其中一名为顺时针距离最近，");
    g_wikiLine[661] = StringToText("另一名为逆时针距离最近——不包括任何在这些玩家之间入座的已死亡玩家。");
    g_wikiLine[662] = StringToText("【与之邻近的玩家：】在座次上与相关玩家分别为顺时针和逆时针距离最近的两名玩家。例如：");
    g_wikiLine[663] = StringToText("与之邻近的存活玩家为在顺时针和逆时针上距离最近的两名存活玩家，与之邻近的镇民玩家为在顺时针和");
    g_wikiLine[664] = StringToText("逆时针上距离最近的两名镇民玩家。");
    g_wikiLine[665] = StringToText("【在场：】指在当前游戏中存在的角色，可能存活或已死亡。");
    g_wikiLine[666] = StringToText("【在你的首个夜晚得知：】英文原文为缩略词，中文未缩略。「在你的首个夜晚得知」信息的角色会在首");
    g_wikiLine[667] = StringToText("个夜晚获取信息，或者如果这种角色在游戏中途产生，则会在那个时间点下获取信息。");
    g_wikiLine[668] = StringToText("【爪牙：】一种初始为邪恶阵营的角色类型。爪牙拥有能协助邪恶阵营的能力。");
    g_wikiLine[669] = StringToText("一局游戏中通常会有一至三名爪牙。旅行者列表中列举了不同游戏人数下的爪牙数量。");
    g_wikiLine[670] = StringToText("【爪牙信息：】缩略词，出现在七人及以上的游戏中夜晚顺序表上，代表爪牙玩家在首个夜晚时获得的信");
    g_wikiLine[671] = StringToText("息。爪牙会得知还有哪些玩家是爪牙，以及得知哪位玩家是恶魔。");
    g_wikiLine[672] = StringToText("【阵营：】玩家当前所属的队伍。阵营有善良与邪恶之分。如果玩家改变了阵营，");
    g_wikiLine[673] = StringToText("他的角色会保留与之前一致。如果玩家改变了角色，他的阵营会保留与之前一致。");
    g_wikiLine[674] = StringToText("玩家始终会得知其当前的阵营。「你的阵营」指代「你和与你同一阵营的所有其他玩家」。");
    g_wikiLine[675] = StringToText("【镇民：】一种初始为善良阵营的角色类型。镇民拥有能协助善良阵营的能力。通常来说，");
    g_wikiLine[676] = StringToText("绝大多数在场角色都会是镇民。旅行者列表中列举了不同游戏人数下的镇民数量。");
    g_wikiLine[677] = StringToText("【正确信息：】正确的信息，例如正确的陈述，手势，或角色标记。说书人必须始终给出关于游戏规则的");
    g_wikiLine[678] = StringToText("正确信息。（参考错误信息部分。）");
    g_wikiLine[679] = StringToText("【中毒：】中毒的玩家会失去能力，但会认为自己仍具有能力，说书人会做出这些玩家仍然具有能力的行");
    g_wikiLine[680] = StringToText("为。如果中毒玩家的角色能力会给他提供信息，说书人可能会给出错误信息。");
    g_wikiLine[681] = StringToText("中毒的玩家不会得知自己中毒。（参考醉酒部分。）");
    g_wikiLine[682] = StringToText("【状态：】玩家当前所具有的特性。玩家总是会处于下述几项对立状态之中的一种：醉酒或清醒，");
    g_wikiLine[683] = StringToText("中毒或健康，存活或死亡，善良或邪恶，疯狂或理智。");
    g_wikiLine[684] = StringToText("【醉酒：】醉酒的玩家会失去能力，但会认为自己仍具有能力，说书人会做出这些玩家仍然具有能力的行");
    g_wikiLine[685] = StringToText("为。如果醉酒玩家的角色能力会给他提供信息，说书人可能会给出错误信息。");
    g_wikiLine[686] = StringToText("醉酒的玩家不会得知自己醉酒。");
    // 3 给说书人的建议
    g_wikiAt[3] = 687;
    g_wikiN[3] = 251;
    g_wikiLine[687] = StringToText("【让游戏流程丝般顺滑】");
    g_wikiLine[688] = StringToText("【1. 当一个阵营已经能确定获胜时，你就可以提前结束游戏。】");
    g_wikiLine[689] = StringToText("当所有的存活玩家都属于邪恶阵营时，这意味着恶魔无法被提名了，此时你就可以直接宣告邪恶阵营获胜。");
    g_wikiLine[690] = StringToText("通常情况下，当场上仅剩四名存活玩家，而一名善良玩家处决了一名非恶魔玩家时，");
    g_wikiLine[691] = StringToText("你就可以宣布游戏结束了。因为如果你让游戏继续进行下去的话，由于只剩三名存活玩家，");
    g_wikiLine[692] = StringToText("恶魔可以通过在夜晚杀死其中一名玩家使得游戏结束，这个过程会显得毫无意义。但是，");
    g_wikiLine[693] = StringToText("如果僧侣和士兵还依然存活的话，恶魔在那天晚上也许无法杀死玩家，这就使得游戏可以继续进行下去，");
    g_wikiLine[694] = StringToText("恶魔就有可能会在下一个白天被处决。");
    g_wikiLine[695] = StringToText("在你想要提前宣布游戏结束之前，要仔细判断场上的局面。如果劣势阵营依旧有赢的可能性，");
    g_wikiLine[696] = StringToText("即使这个可能性微乎其微，也要使游戏继续进行下去。");
    g_wikiLine[697] = StringToText("【2. 在夜晚，用你的手指亲自确认玩家的选择。】");
    g_wikiLine[698] = StringToText("有些时候，玩家会很快地指出自己的选择目标，或是指向了一个你无法确定他的选择目标的角度。");
    g_wikiLine[699] = StringToText("与其猜测玩家的意图，不如走到你认为的目标玩家旁边，用你的手指竖直向下地指向这个被选择的玩家的");
    g_wikiLine[700] = StringToText("头顶。这能让正在进行选择的玩家清楚地了解到你正在确认他们的选择，如果他点了点头，");
    g_wikiLine[701] = StringToText("然后你也点了点头，那么你们都确认了他选择的目标。");
    g_wikiLine[702] = StringToText("这种做法，或者类似的有同样效果的做法，都是值得提倡的，因为它可以避免一些简单的误会。");
    g_wikiLine[703] = StringToText("【3. 在夜晚，刻意进行一些不必要的走动。】");
    g_wikiLine[704] = StringToText("这可以让狡猾的玩家们难以确认你做了些什么骚操作。如果你每个夜晚的第一件事就是走到场地中的一个");
    g_wikiLine[705] = StringToText("固定区域，而且你的鞋子还发出声音的话，那么玩家可能会怀疑恶魔就坐在那个区域。");
    g_wikiLine[706] = StringToText("但如果你在场地里即兴地进行走动，即使你发出了一些声响，玩家也很难猜测发生了什么。");
    g_wikiLine[707] = StringToText("【4. 注意在魔典中移动角色提示标记。】");
    g_wikiLine[708] = StringToText("通常在善良角色（例如猎手、杂耍艺人）使用完角色能力后，你需要在魔典中移动角色提示标记。");
    g_wikiLine[709] = StringToText("当邪恶的玩家将自己伪装成这些角色时，你也要在魔典中假装移动这些标记。");
    g_wikiLine[710] = StringToText("这样做可以让老玩家无法通过观察你的手部动作来判断是否有人在伪装自己的角色。");
    g_wikiLine[711] = StringToText("【5. 轻拍需要被唤醒的玩家的肩膀或膝盖，不要发出声响。】");
    g_wikiLine[712] = StringToText("如果你的拍打发出了声音，邻座的玩家可能会听到并对这名被拍打的玩家产生怀疑。");
    g_wikiLine[713] = StringToText("如果玩家因为穿着厚衣服而感受不到轻轻拍打的话，你可以用手用力地按压他们两次来代替轻轻拍打。");
    g_wikiLine[714] = StringToText("【6. 当你在夜晚唤醒了一名玩家但他并不知道自己该做些什么的时候，");
    g_wikiLine[715] = StringToText("你可以指向玩家的角色列表上的能力描述。】");
    g_wikiLine[716] = StringToText("一些新手玩家可能会忘记他的角色能力需要在夜晚使用，或者是忘记了如何使用自己的能力。");
    g_wikiLine[717] = StringToText("你只需要在角色列表上指出对应角色的能力描述给他看，这种情况下他就应该知道要做些什么了。");
    g_wikiLine[718] = StringToText("【7. 在走动的时候尽量保持魔典处于水平位置。】");
    g_wikiLine[719] = StringToText("只要你不把魔典以非常倾斜的角度拿在手上，魔典高高的侧边应该能够挡住玩家往里看的视线。");
    g_wikiLine[720] = StringToText("玩家需要坐在合适的高度以确保视线不会高于魔典的顶部，以免意外看到里面的内容。");
    g_wikiLine[721] = StringToText("从魔典的上方或下方紧握住中间的书脊。这样一来你就可以腾出另一只手来移动标记了。");
    g_wikiLine[722] = StringToText("不要只握住魔典的左右边缘，因为这样可能会导致魔典断裂开来...然后标记物就会洒一地。");
    g_wikiLine[723] = StringToText("如果要将魔典携带出门时，确保魔典的书脊朝下放置。如果你要把魔典放进一个袋子里，");
    g_wikiLine[724] = StringToText("那么将所有的重量压在盒子最强有力的书脊这一面，这样有助于防止盒子的角落被磨损或弯曲，");
    g_wikiLine[725] = StringToText("从而保持盒子良好的状态。");
    g_wikiLine[726] = StringToText("【8. 当你在宣布重要的事情的时候，请尽可能待在玩家围坐的圆圈当中，");
    g_wikiLine[727] = StringToText("确保所有玩家都能听见或看见你。】");
    g_wikiLine[728] = StringToText("例如正在进行投票或说「还有没有人要提名！3...2...1...」。");
    g_wikiLine[729] = StringToText("如果你不希望以牺牲玩家的乐趣为代价来使得自己被关注到，这种视觉提示（指站在场地当中）");
    g_wikiLine[730] = StringToText("是一种让玩家们知道你有重要事情要宣布的好方法。");
    g_wikiLine[731] = StringToText("【9. 如果你犯了错误，请继续游戏，把后面的游戏主持好。】");
    g_wikiLine[732] = StringToText("不要尝试通过给另一阵营一些补偿来「平衡游戏」，因为这是很难处理好的。");
    g_wikiLine[733] = StringToText("善良阵营的玩家可能会根据你给哪个阵营提供了哪些补偿来回顾问题的源头，进而知道你到底犯了什么错。");
    g_wikiLine[734] = StringToText("所有的说书人都可能犯错，这是经常发生的事。也许你允许恶魔杀死了士兵？或者你忘记了镇长已经醉酒，");
    g_wikiLine[735] = StringToText("然后宣告善良阵营获胜？不要太过纠结。如果一方阵营因此受益而获胜，那就向落败的阵营道歉吧。");
    g_wikiLine[736] = StringToText("如果一方阵营因此受益但仍然落败，那就好好地恭喜一番获胜的阵营吧！");
    g_wikiLine[737] = StringToText("当你意识到自己犯了个错误时，最好要尽快告诉大家，但是不要告诉他们你犯了什么错。这样一来，");
    g_wikiLine[738] = StringToText("他们已经有够多的信息要去处理了，同时也不会给另一方阵营带来太多的损害。");
    g_wikiLine[739] = StringToText("这里有个例外：当你在夜里忘记唤醒一名本该被唤醒的玩家时，你可以在早上暂时让所有玩家重新入睡然");
    g_wikiLine[740] = StringToText("后单独唤醒该玩家，或者是你可以与该玩家请求一次私聊并处理他们的能力。举个例子，");
    g_wikiLine[741] = StringToText("如果你忘记唤醒管家，要么你让所有玩家入睡来处理管家的能力，要么单独把管家叫到一旁来问他上一个");
    g_wikiLine[742] = StringToText("夜晚想要选谁作为他的主人。如果你觉得这样能纠正错误，那就尽管做。");
    g_wikiLine[743] = StringToText("如果你每个夜晚阶段都很放松并缓慢进行，你会发现你犯的错误会越来越少。如果有人催促你要快一些，");
    g_wikiLine[744] = StringToText("请放松并慢慢来。那如果你对某个事情感到困惑呢？也只需要：放松，慢慢来。");
    g_wikiLine[745] = StringToText("【10. 最好在私底下回答问题。】");
    g_wikiLine[746] = StringToText("大多数玩家的问题会和他们的角色相关。当在私底下沟通时，你的回答可以更加直接并且具有针对性。");
    g_wikiLine[747] = StringToText("在对问题进行公开回答时，请使用玩家的名字来进行表述，而不是他们的角色名称，");
    g_wikiLine[748] = StringToText("通过这种方式来表述就不会向大家透露过多的信息。举个例子，如果共情者公开询问：");
    g_wikiLine[749] = StringToText("「昨晚的一根手指表示什么意思？」然后你回答了「这意味着你邻座一名玩家是邪恶的」。");
    g_wikiLine[750] = StringToText("这无疑是向大家确认了共情者就是这个人。或者是如果僧侣问道：「我一天晚上可以选多少名玩家？」，");
    g_wikiLine[751] = StringToText("然后你回答道：「一名玩家」，那你可就透露太多信息给大家了。如果这些对话是在私底下发生的，");
    g_wikiLine[752] = StringToText("那会方便很多。");
    g_wikiLine[753] = StringToText("【11. 尽量不要让玩家在第一个夜晚开始之前讨论他们的角色。】");
    g_wikiLine[754] = StringToText("你甚至可以禁止这种行为。如果玩家总是在恶魔得到三个不在场角色之前就揭露自己的角色，");
    g_wikiLine[755] = StringToText("这会使得恶魔在准备好之前就开始面临着要揭露自己角色的巨大压力。尽管这样违背了「你可以随时说你");
    g_wikiLine[756] = StringToText("想说的话」的原则，但是阻止善良玩家使用这种「策略」是很有必要的。游戏在进入第一个夜晚之后才算");
    g_wikiLine[757] = StringToText("真正开始。大多数玩家会理解这一点，并且在这之前不会讨论自己的角色。但如果真的出现了这样的问题，");
    g_wikiLine[758] = StringToText("要么要求玩家不要这么做，要么将地狱藏书员这个传奇角色加入到游戏当中。");
    g_wikiLine[759] = StringToText("【12. 你可能也需要制止玩家在夜晚使用角色能力时，不停谈论他们自己的能力。】");
    g_wikiLine[760] = StringToText("如果玩家在夜晚把自己正在使用的能力讲了出来，比如说：「我现在醒了，");
    g_wikiLine[761] = StringToText("我得知了被处决的玩家是士兵」，如果大家都这么做，对于邪恶玩家来说就太难进行伪装了，");
    g_wikiLine[762] = StringToText("因为他们需要在夜晚睡觉的时候假装说出自己的行为。大多数玩家都会本能地在夜晚保持沉默，");
    g_wikiLine[763] = StringToText("或者在早上醒来之前不要讨论自己的行为。但如果真的出现了这样的问题，要么要求玩家不要这么做，");
    g_wikiLine[764] = StringToText("要么将地狱藏书员加入到游戏当中。");
    g_wikiLine[765] = StringToText("【13. 游戏中，尽量让玩家待在由椅子围成的圆圈里。】");
    g_wikiLine[766] = StringToText("这样能够防止玩家四处游荡，也能让你可以更容易叫大家坐回原位进行提名。");
    g_wikiLine[767] = StringToText("让大家尽量待在圆圈里可以促使老玩家和新玩家之间，或者新玩家和新玩家之间，进行沟通。");
    g_wikiLine[768] = StringToText("你最不想要看到的就是老玩家三三两两地四处游荡，然后留下一个新玩家独自坐在圈子里。");
    g_wikiLine[769] = StringToText("【14. 鼓励玩家离开自己的座位去和坐在圆圈另一边的玩家进行私下聊天。】");
    g_wikiLine[770] = StringToText("让每个玩家之间都可以互相进行近距离的交流。玩家之间进行私下聊天是这个游戏非常重要的一部分。");
    g_wikiLine[771] = StringToText("无论是善良阵营还是邪恶阵营，都可以利用私下聊天来开展更高层级的战略部署。");
    g_wikiLine[772] = StringToText("【15. 善用、活用旅行者。】");
    g_wikiLine[773] = StringToText("如果你正在主持一场人数较多的游戏，玩家们想让游戏进程更快一些，但你不想使用诸如于末日预言者的");
    g_wikiLine[774] = StringToText("传奇角色，这时你需要让旅行者玩家去选择能加快游戏的速度的角色。能够造成玩家死亡或者使得处决更");
    g_wikiLine[775] = StringToText("容易发生的角色，包括枪手、官员、巫毒师、主教、屠夫、流莺和咖啡师等，");
    g_wikiLine[776] = StringToText("不管哪个角色都会使得游戏更快地进入最后一天。而替罪羊、乞丐、窃贼、");
    g_wikiLine[777] = StringToText("女舍监和怪咖等角色会使得游戏时间变长，因为他们通常都不会造成死亡或者避免处决的发生。");
    g_wikiLine[778] = StringToText("【16. 如果你在白天阶段有空闲的时间，你可以阅读在场角色的角色标记上的文字，");
    g_wikiLine[779] = StringToText("】这将会帮助你准确地理解每个角色的运作方式，以及他们如何与游戏中的其他角色进行互动。");
    g_wikiLine[780] = StringToText("特别是在你第一次主持一个新剧本时，这样做会很有帮助。一些角色的描述可能不是特别直接，");
    g_wikiLine[781] = StringToText("你可能会在第一次阅读的时候漏掉一些细节。你通常只需要了解那些在场的角色能力，");
    g_wikiLine[782] = StringToText("因为角色列表上的其他不在场的角色一般不会对游戏产生影响。");
    g_wikiLine[783] = StringToText("【17. 当你准备好了就可以结束白天并进入夜晚阶段。】");
    g_wikiLine[784] = StringToText("在处决发生过后，让大家闭眼之前，你需要做的就是为夜晚阶段准备好魔典。花一些时间确认，");
    g_wikiLine[785] = StringToText("所有的提示标记已经放置在正确的位置，并且夜晚标记都已经就绪了。提前做好这些准备玩家就不会觉得");
    g_wikiLine[786] = StringToText("夜晚十分漫长。");
    g_wikiLine[787] = StringToText("游戏中一些如猎手、造谣者、艺术家、博学者和杂耍艺人的角色拥有一些「在白天」使用的能力。");
    g_wikiLine[788] = StringToText("这些能力最好是在处决之前使用。有的玩家可能会询问，在处决发生后，进入夜晚之前是否可以使用这些");
    g_wikiLine[789] = StringToText("能力，是或否这将由你来决定。你可以在处决发生过后就立即进入夜晚阶段，在你叫大家闭眼之后，");
    g_wikiLine[790] = StringToText("如果有玩家还想要使用他们的白天能力，就已经晚了。");
    g_wikiLine[791] = StringToText("【让游戏内容妙趣横生】");
    g_wikiLine[792] = StringToText("你可以在一个玩家将要被处决之前询问他：「你想要以什么方式死去？」。");
    g_wikiLine[793] = StringToText("这样公开地进行询问可以让临死的玩家想出各种有趣的方式来进行死刑。有些玩家在可能要体验走跳板，");
    g_wikiLine[794] = StringToText("有些玩家则可能会想以一种轻松愉快的方式死亡。");
    g_wikiLine[795] = StringToText("你可以帮他们把「死亡的故事」加入更多细节。当然，最好要保持故事简短、轻松和有趣。");
    g_wikiLine[796] = StringToText("不要让他显得尴尬。举个例子，如果有玩家说：「我在一场为我颁奖的宴会上，死于背刺」，");
    g_wikiLine[797] = StringToText("你可以将故事展开来讲，比如说：「嗯……镇上的人正聚集在一起举行一场盛大的宴会，");
    g_wikiLine[798] = StringToText("你正在发表获奖感言，突然之间张三用他吃蛋糕的叉子从你身后来了个背刺，");
    g_wikiLine[799] = StringToText("但其实你早就被之前的演讲无聊死了」。如果你讲的故事当中包含一些过于露骨的、血腥的描述，");
    g_wikiLine[800] = StringToText("可能会使得人们感到恶心不适，并且以后可能就不再和你一起玩了。");
    g_wikiLine[801] = StringToText("如果可以的话，尽量保持一种有趣的、搞笑的气氛。如果你做不到，那就什么也别说。请记住，");
    g_wikiLine[802] = StringToText("人们不喜欢在公共场合讨论的一些不合时宜的话题，特别是和两性以及个人隐私相关的事情。");
    g_wikiLine[803] = StringToText("所以与大家开玩笑的时候要适度。");
    g_wikiLine[804] = StringToText("你可以在游戏中或多或少地讲一些故事。在游戏开始时，稍微铺陈一下故事背景，");
    g_wikiLine[805] = StringToText("这可以为你的游戏增加一些悬念并奠定基调。例如：「这是一个雷雨交加的夜晚……」。当然，");
    g_wikiLine[806] = StringToText("为晚上死亡的玩家讲述一个故事，或者是在白天召集镇民到城镇广场时加一点描述，");
    g_wikiLine[807] = StringToText("都是一些能让游戏变得特别的方法，虽然这可能需要一定的文采、创造力和独立思考的能力。");
    g_wikiLine[808] = StringToText("不过这些事情并不是必需的。如果你觉得尴尬，完全可以跳过这个部分。即使是一个沉默寡语的说书人也");
    g_wikiLine[809] = StringToText("一定可以主持一场完整的、令人兴奋的游戏。玩家们往往会在游戏中创造属于他们自己的乐趣。");
    g_wikiLine[810] = StringToText("【1. 不要破坏规则。】");
    g_wikiLine[811] = StringToText("即使这样做可能令人兴奋也不要。不要轻易地决定玩家的生死，或者是在游戏中随意改变爪牙或恶魔角色");
    g_wikiLine[812] = StringToText("的数量。可靠的信息是善良阵营能取胜的关键。如果他们的逻辑是基于错误的信息，");
    g_wikiLine[813] = StringToText("并且没有方法可以发现信息错误，他们就只是在胡乱猜测而不是在推理，这样对大家来说并不好玩。");
    g_wikiLine[814] = StringToText("即使你认为在游戏中偷偷把恶魔去掉会很搞笑，或者是突然加入一个酒鬼，");
    g_wikiLine[815] = StringToText("又或者是改变一些重要的游戏规则，玩家们可能并不会欣赏你的这些举动，");
    g_wikiLine[816] = StringToText("因为他们可能会觉得自己输得不公平或者赢得不光彩。");
    g_wikiLine[817] = StringToText("完整的《染》套装当中包含了200个以上的角色，总有一个能让你去做你想做到的那些疯狂的事情，");
    g_wikiLine[818] = StringToText("这样也会显得比较有趣和公平。");
    g_wikiLine[819] = StringToText("【2. 让玩家们自己做决定。】");
    g_wikiLine[820] = StringToText("在夜晚，玩家有时候会做出一些奇怪的选择，比如占卜师可能每个夜晚都选择了同样的玩家，");
    g_wikiLine[821] = StringToText("僧侣也许想要保护一个已死亡的玩家，恶魔可能会攻击一个已经现身的守鸦人，");
    g_wikiLine[822] = StringToText("投毒者可能会想给恶魔下毒。你永远不知道玩家到底在想什么，那么也最好不要强迫他们去接受你所认为");
    g_wikiLine[823] = StringToText("的最佳方案。在以上的例子中，占卜师可能是在测试他自己是否醉酒，僧侣可能是想使得今晚有人死亡让");
    g_wikiLine[824] = StringToText("明天只剩三名玩家存活来达成镇长的胜利条件，恶魔也许想让守鸦人早点死亡，");
    g_wikiLine[825] = StringToText("投毒者可能想要通过没有人死亡这件事来伪装他就是士兵。让玩家们做出自己的选择，");
    g_wikiLine[826] = StringToText("也许他们的选择不是最好的选择，没有关系，这是他们的权利。");
    g_wikiLine[827] = StringToText("【3. 处理消极的行为是你必须要做的事情。】");
    g_wikiLine[828] = StringToText("与所有的社交聚会一样，有些时候玩家会以不尊重他人的语气发言。《染》是一款社交游戏，");
    g_wikiLine[829] = StringToText("这意味着社交手段在游戏中会发挥出他的用处。幽默、风趣以及展现个人魅力都是玩家友好且有趣的社交");
    g_wikiLine[830] = StringToText("属性，但有时候玩家们可能会被兴奋冲昏了头脑转而出现一些消极的行为，例如大喊大叫、");
    g_wikiLine[831] = StringToText("胁迫或情绪勒索。任何令人不快的或者是破坏游戏良好氛围的玩家行为都应该被扼杀在摇篮之中。");
    g_wikiLine[832] = StringToText("这些行为是不能被接受的，也许其他玩家仅仅是感到不适，但最糟糕的情况下玩家们可能因此吵架或受到");
    g_wikiLine[833] = StringToText("伤害。每一名玩家都应该处于一个他们能感到被认同、被尊重以及能够轻松做出决定的环境当中。");
    g_wikiLine[834] = StringToText("如果你发现了一些消极的行为，请将玩家带离到一边进行私下劝导。向他们解释他们的行为可能会使得其");
    g_wikiLine[835] = StringToText("他玩家感到不适。并且强调问题不在于个人，而是在于行为。大多数玩家会立刻意识到自己可能过于应激，");
    g_wikiLine[836] = StringToText("并改变他们与其他玩家的互动方式。他们可能会感谢你让他们意识到自己当时的情绪或较真已经产生负面");
    g_wikiLine[837] = StringToText("影响了。");
    g_wikiLine[838] = StringToText("你不应该容忍那些为自己的欺凌、冒犯行为进行辩解并把责任推到他人身上的玩家。");
    g_wikiLine[839] = StringToText("直到他们改善这种行为之前，不要再让他们继续参与到你主持的游戏中。");
    g_wikiLine[840] = StringToText("玩家假装自己被冒犯或者被伤害的也是很糟糕的行为。例如，一名玩家在被提名时，假装变得很恼火、");
    g_wikiLine[841] = StringToText("很受伤或者很愤怒，也会带来不好的游戏氛围。乐观、有趣、包容的情绪会比游戏的输赢更重要。");
    g_wikiLine[842] = StringToText("更重要的是，你需要观察玩家是否在游戏中表现是不是真的不悦，这样你才能采取适当的、");
    g_wikiLine[843] = StringToText("富有同情心的行动。如果一名玩家假装自己很不高兴，滥用你对他们的信任，那么你应该和他们私下谈谈，");
    g_wikiLine[844] = StringToText("劝告他们不要再这么做了。");
    g_wikiLine[845] = StringToText("判断什么是冒犯行为或者不愉快的行为对你来说可能会非常棘手，所以你要慎重做出决定。你会发现，");
    g_wikiLine[846] = StringToText("有些对话之所以难以进行下去是因为玩家的语气使人感到不适，而不是他们所说的内容。");
    g_wikiLine[847] = StringToText("根据你所在的玩家群体，互相谩骂、说脏话、讨论粗俗或有争议的话题可能不会有问题。但人身攻击、");
    g_wikiLine[848] = StringToText("侮辱他人或者是任何让玩家感到被冒犯、受伤的行为都应该被禁止。");
    g_wikiLine[849] = StringToText("【4. 注意忌讳的话题和敏感的话题。】");
    g_wikiLine[850] = StringToText("例如死亡、两性、性别以及玄学，可能会使一些玩家感到顾虑。同样的，可能一些特定角色会冒犯到部分");
    g_wikiLine[851] = StringToText("玩家或者是让他们在游玩过程中感到不适。虽然最简单的方法就是让他们去玩另一款游戏，");
    g_wikiLine[852] = StringToText("但你可以通过制作自己的角色列表（加入你想游玩的角色，剔除你认为不合适的角色）");
    g_wikiLine[853] = StringToText("来迎合对特定角色有强烈厌恶感的玩家。");
    g_wikiLine[854] = StringToText("【5. 关于害羞的玩家。】");
    g_wikiLine[855] = StringToText("虽然这看起来很矛盾，但是害羞的玩家他们往往非常喜欢《染》这种刺激紧张的社交互动。");
    g_wikiLine[856] = StringToText("很多这类玩家会保持沉默并只是安静地在一旁倾听，不时地通过揭露信息和充分利用他们的投票来参与到");
    g_wikiLine[857] = StringToText("游戏中来。然而当他们试图说些什么的时候，很可能会被其他玩家打断，或者是他们的声音不够响亮无法");
    g_wikiLine[858] = StringToText("引起大家的注意。");
    g_wikiLine[859] = StringToText("如果你发现有玩家正处于上述的状态当中，可以尝试每隔一段时间就为他制造一个说话的机会。");
    g_wikiLine[860] = StringToText("并且让其他玩家保持安静，让害羞的玩家说出他们想说的话。永远不要强制让一名害羞的玩家说话，");
    g_wikiLine[861] = StringToText("而是询问他是否有什么要说的。");
    g_wikiLine[862] = StringToText("当一名害羞的玩家被提名时就是询问他们是否愿意说些什么的最佳时机，因为此时大家的注意力都会放在");
    g_wikiLine[863] = StringToText("他身上。你只需要简单地说：「你被提名了，你有什么话想说吗？」，就可以为他们制造一个说话的机会，");
    g_wikiLine[864] = StringToText("而且你根本不需要让大家保持安静，大家也会自觉地听他发言。");
    g_wikiLine[865] = StringToText("你会逐渐发现几场游戏过后，原本害羞的玩家会变得越来越自信并且开始更加积极地参与游戏。");
    g_wikiLine[866] = StringToText("同样的，不要要求一名健谈的玩家保持安静，除非是在你要求所有人都安静下来的时候。");
    g_wikiLine[867] = StringToText("仅仅只是不让健谈的玩家说话而允许其他人说话，会使他们觉得自己受到了不公的对待，");
    g_wikiLine[868] = StringToText("因为他们一直都是这么健谈的。再者说，《染》是一款语言类的游戏。如果你需要让所有人都能听到你的");
    g_wikiLine[869] = StringToText("声音，或者是让一名害羞的玩家说的话能被听清，在你要求话匣子不要说话的同时，");
    g_wikiLine[870] = StringToText("也要让大家一起安静下来。");
    g_wikiLine[871] = StringToText("【6. 设法让游戏进行到最后一天。】");
    g_wikiLine[872] = StringToText("《染》最刺激的时候就是当场上只剩下三到四名玩家，也许一次关键处决就可以决定游戏的胜败。");
    g_wikiLine[873] = StringToText("游戏在这个时候结束通常会更加紧张刺激、更具有戏剧性，你还能够在这种情况下听到获胜方更大的欢呼");
    g_wikiLine[874] = StringToText("声。那么...你会怎么帮助游戏进行到最后一天呢？");
    g_wikiLine[875] = StringToText("尽可能帮助弱势的阵营。作为说书人，你不能随意变更游戏规则，但在很多地方，");
    g_wikiLine[876] = StringToText("你可以稍微偏袒一下弱势阵营，为他们带来一些无形的运气。");
    g_wikiLine[877] = StringToText("邪恶阵营已经对善良阵营形成了碾压般的优势？那么你可以在一些夜晚给一名酒鬼共情者提供正确的信息，");
    g_wikiLine[878] = StringToText("或者让送葬者得知被处决的间谍就是真的间谍。也许当镇长被攻击时，你可以杀死一名爪牙而不是镇民呢？");
    g_wikiLine[879] = StringToText("善良阵营几乎快要摧毁邪恶阵营了？仔细考虑一下你会给那些醉酒或中毒的镇民什么信息。有时，");
    g_wikiLine[880] = StringToText("在恰当的时机提供错误的信息可以戏剧性地扭转游戏的局势。");
    g_wikiLine[881] = StringToText("如果你不知道你应该帮助哪个阵营，要么哪个阵营都不帮，要么就帮助邪恶阵营。不管你有没有意识到，");
    g_wikiLine[882] = StringToText("邪恶阵营总是需要一些帮助的。对于善良阵营而言，哪怕得到一次小小的运气就可以轻松取胜，");
    g_wikiLine[883] = StringToText("而对于邪恶阵营而言，他们需要每天都如此走运。");
    g_wikiLine[884] = StringToText("【不要利用游戏规则来使某个阵营获胜。】例如，通过杀死修补匠或当镇长被攻击时杀死场上最后一名邪");
    g_wikiLine[885] = StringToText("恶玩家来结束游戏，这样做是很不公平的。不过你可以通过处决一名应该「疯狂」但没有照做的玩家来结");
    g_wikiLine[886] = StringToText("束游戏，因为这一般会是玩家自己的选择，而不是你的选择。尽力让玩家觉得游戏中最有趣和最精彩的部");
    g_wikiLine[887] = StringToText("分都是因他们自己的行为和选择而产生的。");
    g_wikiLine[888] = StringToText("【7. 仔细聆听邪恶阵营玩家在游戏中使用的角色伪装，并在游戏中配合他们。】");
    g_wikiLine[889] = StringToText("如果小恶魔声称自己是猎手并且想要「使用他的猎手能力」，你应当配合他以确保这个能力看起来好像只");
    g_wikiLine[890] = StringToText("是没有生效，但是确实像真正的猎手在使用自己的能力。如果间谍在声称自己是占卜师之后被守鸦人选中");
    g_wikiLine[891] = StringToText("了，你就可以在守鸦人的角色能力生效时，让间谍被当作占卜师，并展示给守鸦人看。");
    g_wikiLine[892] = StringToText("邪恶阵营的玩家非常依赖于你的帮助，这样他们的谎言听起来才更加真实。请尽可能地帮助他们。");
    g_wikiLine[893] = StringToText("举个例子，如果一名邪恶玩家声称自己是贞洁者并且被提名了，那么会无事发生。");
    g_wikiLine[894] = StringToText("但为了让这名邪恶的玩家看起来像是真正的贞洁者，你可以摆弄一下魔典。");
    g_wikiLine[895] = StringToText("这样你看起来像是在把「失去能力」的提示标记放在了贞洁者的角色标记旁 ，");
    g_wikiLine[896] = StringToText("而这本该是在真正的贞洁者被提名时你要做的事情。新手玩家可能不会注意到这些细节，");
    g_wikiLine[897] = StringToText("但是老玩家可能会。");
    g_wikiLine[898] = StringToText("【8. 如果想要让玩家们在游戏结束时能够尽情地欢呼雀跃，你可以花一些心思在宣告胜利上。】");
    g_wikiLine[899] = StringToText("只是轻声轻语地说「邪恶阵营获胜」可能不足以让邪恶阵营的玩家跳起来互相击掌。");
    g_wikiLine[900] = StringToText("你可以在进行宣告时故意稍作停顿，让大家把注意力都放到你身上来，再用一种非常隆重的腔调来宣布获");
    g_wikiLine[901] = StringToText("胜的阵营，并鼓励大家尽情地击掌和拥抱。获胜玩家总会找到适合他们的方式来庆祝。这场胜利属于他们，");
    g_wikiLine[902] = StringToText("是他们靠自己赢得的胜利。一旦你作为恶魔在一场超过15名玩家的游戏中体验到了获胜的兴奋劲儿，");
    g_wikiLine[903] = StringToText("你就会了解到这时候尽情庆祝是多么有利于情绪的释放。即使是在一场这么多人的游戏中意外落败，");
    g_wikiLine[904] = StringToText("也能被玩家惦记好几个月。");
    g_wikiLine[905] = StringToText("【9. 允许一些创新的、意料之外的策略。】");
    g_wikiLine[906] = StringToText("当玩家在《染》这款社交推理游戏中做出了一些异于常理、但能被接受的行为时，游戏将会变得非常有趣。");
    g_wikiLine[907] = StringToText("也许你的邪恶玩家们通过手机互相发信息？问题不大，毕竟同处一室的敏锐玩家或许能察觉到他们的这些");
    g_wikiLine[908] = StringToText("小动作。也许你的善良玩家们为了让邪恶方难以察觉，一直在伪装自己的角色？那可就太棒了！");
    g_wikiLine[909] = StringToText("也许玩家们在跟你私下沟通过后，回头却和大家说了完全不一样内容？简直无敌了！");
    g_wikiLine[910] = StringToText("玩家们的创意当然是越多越好，多多益善！");
    g_wikiLine[911] = StringToText("【当然对于这条规则而言也存在一些显而易见的例外。】游戏的规则是必须被遵守的，");
    g_wikiLine[912] = StringToText("但欺凌和羞辱是绝对不被接受的。此外，应制止将游戏内容与游戏外的利益挂钩的行为。");
    g_wikiLine[913] = StringToText("玩家用真实的货币收买他人的投票，或者是承诺在游戏结束后提供一些什么，这样的行为会使游戏变味儿。");
    g_wikiLine[914] = StringToText("友好的氛围能帮助你避免很多问题。【总的来说，如果玩家的行为是不同寻常的、");
    g_wikiLine[915] = StringToText("有创意的并且会使游戏变得更加有趣的，那就默许它发生。但如果这种行为会使得游戏变得糟糕，");
    g_wikiLine[916] = StringToText("那就应该禁止它。】");
    g_wikiLine[917] = StringToText("【10. 在游戏一开始将所有的恶魔和爪牙一起唤醒会非常有趣。】");
    g_wikiLine[918] = StringToText("邪恶的玩家们可以互相知道对方是邪恶玩家、进行眼神接触甚至是沉浸于这段邪恶的友谊当中。（注：");
    g_wikiLine[919] = StringToText("但这并不意味着邪恶玩家能够以手势进行交流）");
    g_wikiLine[920] = StringToText("如果不采用「唤醒爪牙并指向恶魔、然后再唤醒恶魔并指向爪牙」的方式，");
    g_wikiLine[921] = StringToText("而是一起唤醒所有恶魔和爪牙的话，你依然需要展示「他是恶魔」和「他们是你的爪牙」信息标记。");
    g_wikiLine[922] = StringToText("这样玩家们才能知道谁是恶魔。并且在向恶魔展示三名可用于伪装的不在场角色标记之前，");
    g_wikiLine[923] = StringToText("你仍然需要先让爪牙们回去睡觉。没错，是挺麻烦的。");
    g_wikiLine[924] = StringToText("通常情况下爪牙们和恶魔是分开被唤醒的，以便于诸如疯子和魔术师这样的角色的能力生效，");
    g_wikiLine[925] = StringToText("也可以确保爪牙们不会因此看到恶魔的角色伪装。如果你当前主持的剧本中角色列表上没有包含上述这些");
    g_wikiLine[926] = StringToText("角色，你可以尝试对比一下哪种唤醒方法更适合你。");
    g_wikiLine[927] = StringToText("【11. 你的目标是主持一场有趣好玩且参与度高的游戏。】");
    g_wikiLine[928] = StringToText("【有些事你可以做，但不意味着你应该去做。】你是否只顾自己取乐而给玩家们添乱？");
    g_wikiLine[929] = StringToText("你是否正在牺牲玩家的乐趣来放纵自己？比如说当小恶魔在夜里将自己杀死时，");
    g_wikiLine[930] = StringToText("你「可以」将陌客当作是爪牙并让他因此变成一个善良的小恶魔，但这并不意味着这样做是有趣或平衡的。");
    g_wikiLine[931] = StringToText("比如说你「可以」说服一名迷惑的善良阵营玩家，告诉他他是邪恶阵营的，");
    g_wikiLine[932] = StringToText("但这并不意味着玩家在得知真相后会享受这个过程。又比如说你「可以」给博学者提供完全没用的信息，");
    g_wikiLine[933] = StringToText("但显然提供有趣且独特的信息会更好。");
    g_wikiLine[934] = StringToText("作为说书人，你在每一局游戏当中都需要做出很多有趣的决定。而这每一个决定的目的都应该是使游戏变");
    g_wikiLine[935] = StringToText("得更好玩，为大家带来更多乐趣。这通常意味着你需要给善良阵营制造尽可能多的混乱，将他们引入歧途，");
    g_wikiLine[936] = StringToText("因为这对所有人来说都是有趣的。但请牢记在心，维持游戏的公平性是同样重要的，");
    g_wikiLine[937] = StringToText("你主持游戏是为了让玩家都能够享受到游戏中的精彩。");
    // 4 规则解释
    g_wikiAt[4] = 938;
    g_wikiN[4] = 64;
    g_wikiLine[938] = StringToText("这个页面的内容用于向初次游玩《染·钟楼谜团》这款游戏的玩家介绍在第一次游玩时所需要了解的重要");
    g_wikiLine[939] = StringToText("内容。在游戏开始前，你只需要将这些内容念出，或者让玩家自行查阅即可。");
    g_wikiLine[940] = StringToText("部分规则将提示你演示各种手势信号。你最好在你讲规则的时候演示这些手势，");
    g_wikiLine[941] = StringToText("以使一些玩家能更直观地进行学习。");
    g_wikiLine[942] = StringToText("你可以现在就念出规则中有关提名和处决的内容，但如果你在第一次提名处决开始时讲解有关规则会更加");
    g_wikiLine[943] = StringToText("有助于玩家理解。");
    g_wikiLine[944] = StringToText("放在城镇广场下方的旅行者列表的背面有一份规则表副本。为了节省时间，");
    g_wikiLine[945] = StringToText("你可以让一名老手玩家阅读这张表上的规则，这样你就可以在他们讲解规则的时候设置游戏了。");
    g_wikiLine[946] = StringToText("【在游戏开始之前】");
    g_wikiLine[947] = StringToText("在很久很久以前，一个叫做鸦木布拉夫的沉睡小镇里，雷雨交加。正当午夜之时……你们听到了一声尖叫。");
    g_wikiLine[948] = StringToText("当你们冲到城镇广场查看时，你们发现受人爱戴的说书人被谋杀了……他被钉在钟楼的时针上，");
    g_wikiLine[949] = StringToText("鲜血不断滴落到下方的鹅卵石上。你们猜测这正是恶魔所为，没错——恶魔会在夜晚杀戮，");
    g_wikiLine[950] = StringToText("而在白天化为人形隐匿于镇民之中。");
    g_wikiLine[951] = StringToText("你们将会收到一个红色或蓝色的角色标记。如果你的标记是蓝色的，你属于善良的一方。如果是红色的，");
    g_wikiLine[952] = StringToText("你会是邪恶的一方。如果你是善良的，你的目标是找到并处决所有恶魔。如果所有恶魔都死亡，");
    g_wikiLine[953] = StringToText("善良阵营获胜。如果你是邪恶的，你的目标是摧毁这个城镇。如果只剩两个玩家还活着，邪恶阵营获胜。");
    g_wikiLine[954] = StringToText("游戏分为两个阶段：白天阶段和夜晚阶段。在白天，你们会互相交谈。你们每个人都有一个秘密身份，");
    g_wikiLine[955] = StringToText("也就是一个剧本列表中的角色。通常善良的玩家会分享他们所知道的一切，");
    g_wikiLine[956] = StringToText("并尝试去弄清楚每个人的具体身份。大多数善良的玩家都会说实话，但有的善良玩家也会有伪装的动机。");
    g_wikiLine[957] = StringToText("如果你是邪恶的，那你肯定需要伪装！最好挑个善良角色来伪装，并尽可能多地散布虚假信息。");
    g_wikiLine[958] = StringToText("在夜晚时，所有人都会闭上眼睛。说书人会唤醒部分玩家，当你被唤醒了就通常就可以使用自己的角色能");
    g_wikiLine[959] = StringToText("力或是获取某种类型的信息。晚上，说书人会保持沉默，但会使用这些手势和动作跟你们交流：");
    g_wikiLine[960] = StringToText("（在你说话时演示以下内容。）");
    g_wikiLine[961] = StringToText("· （拍拍）在你的肩膀或膝盖上轻拍 2 次，你就可以睁开眼睛");
    g_wikiLine[962] = StringToText("· （用你的手遮住自己眼睛）这个动作，你就需要闭眼");
    g_wikiLine[963] = StringToText("· （点头）点头代表肯定，（摇头）摇头代表否定");
    g_wikiLine[964] = StringToText("· （拇指朝上）这个手势代表善良，（拇指朝下）这个手势代表邪恶");
    g_wikiLine[965] = StringToText("· （数字手势）这是代表数字的手势， 0、1、2、3 ……");
    g_wikiLine[966] = StringToText("· （☞）如果你要在晚上选择一名玩家，只需像这样指向他");
    g_wikiLine[967] = StringToText("你们中的大多数人都会死。这是一件好事！在鸦木布拉夫小镇，死亡并不是终点。");
    g_wikiLine[968] = StringToText("某些玩家甚至可能想要赶紧死，因为他们死掉时就能获得信息。如果你死了，你仍然参与游戏，");
    g_wikiLine[969] = StringToText("你可以继续说话，你会与你的阵营一同获胜或落败。");
    g_wikiLine[970] = StringToText("在这个游戏中会有很多信息。但是其中一些可能是错误的。如果你醉酒或中毒，你会失去角色能力，");
    g_wikiLine[971] = StringToText("但说书人会假装你仍有能力。说书人会给你假信息——你得到的任何信息都可能错误，");
    g_wikiLine[972] = StringToText("但你不会知道你有没有醉酒或中毒。例如，如果你是酒鬼，你会从袋子里抽出一个镇民角色标记，");
    g_wikiLine[973] = StringToText("只有说书人知道你实际上是酒鬼。或者，如果投毒者使你中毒了，你仍然可以在晚上醒来使用你的能力，");
    g_wikiLine[974] = StringToText("但它不会起作用。");
    g_wikiLine[975] = StringToText("【四项原则】");
    g_wikiLine[976] = StringToText("熟悉全部规则的信息量太大了，所以最开始游戏，你只需要简单地记住四件事：");
    g_wikiLine[977] = StringToText("【1）你可以在任何时候说任何你想说的话。】");
    g_wikiLine[978] = StringToText("这是一个聊天为主的游戏。你可以自己决定是和所有人一起公聊或者去找人私聊。");
    g_wikiLine[979] = StringToText("【2) 禁止偷看。】");
    g_wikiLine[980] = StringToText("请对你的角色标记保密，也不准偷看魔典，魔典里面有所有游戏中的角色信息。");
    g_wikiLine[981] = StringToText("如果你看到不应该看到的东西，会破坏游戏的乐趣。");
    g_wikiLine[982] = StringToText("【3）有任何疑问都可以问说书人。】");
    g_wikiLine[983] = StringToText("如果你有不懂的，不明白的地方，包括你的角色或者你想要伪装的角色能力，");
    g_wikiLine[984] = StringToText("在晚上发生了你无法理解的事，或者你想了解玩法...无论是什么问题都可以问说书人。");
    g_wikiLine[985] = StringToText("说书人是中立的，他的职责就是帮助你理解规则，然后玩得开心。你有问题就可以直接问说书人，");
    g_wikiLine[986] = StringToText("如果你不想让别人知道你问了什么，也可以找说书人私聊。");
    g_wikiLine[987] = StringToText("【4) 玩得开心。】");
    g_wikiLine[988] = StringToText("这个游戏里会有欺骗和诡计，所以请互相尊重和体谅。要以优雅的方式杀戮，也要以有尊严的方式死去。");
    g_wikiLine[989] = StringToText("【在首次提名之前】");
    g_wikiLine[990] = StringToText("说书人将会让大家开始提名。");
    g_wikiLine[991] = StringToText("想要提名一名玩家，只需说出他名字。例如：「我提名小帅。」当一名玩家被提名时，");
    g_wikiLine[992] = StringToText("每个人都要投票表决是否要处决他。例如：我会像这样指他（指向小帅），并说「对小帅的提名计票，");
    g_wikiLine[993] = StringToText("从现在开始。」说书人会按顺时针方向移动他的手（亲自演示），当说书人指到你的时候，如果你举手了，");
    g_wikiLine[994] = StringToText("那你就是投了赞成票，如果你没举手，那你就是放弃了投票。");
    g_wikiLine[995] = StringToText("每个白天，你可以给不同的玩家投票，投票次数不限，当天得票最多的人会被处决。");
    g_wikiLine[996] = StringToText("而且处决的赞成票数需要大于等于存活玩家人数的一半的，才算投票成功，否则被提名的人就不会被处决。");
    g_wikiLine[997] = StringToText("如果多名玩家的票数打平，这些玩家都不会被处决。");
    g_wikiLine[998] = StringToText("即使你死了也不会出局。你仍然可以说话，你在夜晚仍然要闭上眼睛。最重要的是，");
    g_wikiLine[999] = StringToText("你仍然可以帮助自己的阵营获胜。事实上，胜负经常是由死去玩家的投票和意见决定的。如果你死了，");
    g_wikiLine[1000] = StringToText("你会失去你的角色能力，你不再能发起提名，并且你在游戏的剩下时间里只剩最后一票，所以要谨慎，");
    g_wikiLine[1001] = StringToText("想清楚再投。");
    // 5 相克规则
    g_wikiAt[5] = 1002;
    g_wikiN[5] = 288;
    g_wikiLine[1002] = StringToText("本页面用于整理收录目前官方列出的所有相克角色组合和相克规则。");
    g_wikiLine[1003] = StringToText("【相关说明】");
    g_wikiLine[1004] = StringToText("· 如果说书人需要宣布一项相克规则，则需要在游戏中加入灯神角色以提示玩家当前剧本中存在着相克");
    g_wikiLine[1005] = StringToText("规则。");
    g_wikiLine[1006] = StringToText("· 相克规则是规则而非灯神的能力，灯神的能力只是允许说书人来宣布这些规则。");
    g_wikiLine[1007] = StringToText("所有因相克规则而导致自己能力未正常生效的，不会计入到数学家的能力检测中。");
    g_wikiLine[1008] = StringToText("（如红唇女郎因为方古的相克规则，本该转变为方古但未转变成功，不会被数学家得知。）");
    g_wikiLine[1009] = StringToText("· 对于所有能够「获得能力」的角色，如果玩家即将获得某一角色的能力但该角色与另一在场角色满足");
    g_wikiLine[1010] = StringToText("「互为克星的角色在同一时间里只能有其中一个角色在场」的相克规则，则说书人需要提醒该玩家，");
    g_wikiLine[1011] = StringToText("他因为相克规则而无法获取对应角色的能力且告知相应的原因（如哲学家，");
    g_wikiLine[1012] = StringToText("此时需要为他展示相克规则的那个在场角色，且哲学家的能力会被视作已经使用）；");
    g_wikiLine[1013] = StringToText("或如果获取能力的操作为说书人选择，则说书人在规则允许的情况下为该玩家选择另一项可用能力（如炼");
    g_wikiLine[1014] = StringToText("金术士）。");
    g_wikiLine[1015] = StringToText("· 诸如麻脸巫婆将某名邪恶玩家变成哲学家后该哲学家选择获得异端分子之类的「三角色相克」问题，");
    g_wikiLine[1016] = StringToText("目前Steven的回复是：「三角色问题会比双角色问题更加复杂，需要考虑的东西更多」因此在短期");
    g_wikiLine[1017] = StringToText("内（话先不说死）不会整理「三角色相克」规则。但说书人依然可以类比双角色相克规则来进行处理，");
    g_wikiLine[1018] = StringToText("比如上述问题的处理方式可以参考：「允许麻脸巫婆将邪恶玩家变成哲学家，");
    g_wikiLine[1019] = StringToText("但不允许‘一名邪恶的哲学家’获得异端分子的能力」。");
    g_wikiLine[1020] = StringToText("【相克规则列表】");
    g_wikiLine[1021] = StringToText("哈迪寂亚与公主：如果公主在首个白天提名并处决了一名玩家，没有人会因为哈迪寂亚而死亡。");
    g_wikiLine[1022] = StringToText("(公主与哈迪寂亚角色互动结果本应如此，此条仅作说明)");
    g_wikiLine[1023] = StringToText("哈迪寂亚与主谋：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：");
    g_wikiLine[1024] = StringToText("如果他们都选择存活，邪恶阵营获胜。否则，善良阵营获胜。");
    g_wikiLine[1025] = StringToText("炼金术士与间谍：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改为间谍一定在场。");
    g_wikiLine[1026] = StringToText("每次处决后，存活的炼金术士可以公开猜测一名存活玩家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_wikiLine[1027] = StringToText("炼金术士与寡妇：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。");
    g_wikiLine[1028] = StringToText("每次处决后，存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_wikiLine[1029] = StringToText("炼金术士与亡魂：如果炼金术士本应获得亡魂的能力，那么他不会拥有该能力并改为亡魂一定在场。");
    g_wikiLine[1030] = StringToText("每次处决后，存活的炼金术士可以公开猜测一名存活玩家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_wikiLine[1031] = StringToText("赏金猎人与卡扎力：如果卡扎力把赏金猎人变成了爪牙，赏金猎人不会带来邪恶的镇民。");
    g_wikiLine[1032] = StringToText("异端分子与男爵：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1033] = StringToText("异端分子与痢蛭：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1034] = StringToText("异端分子与麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1035] = StringToText("异端分子与教父：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1036] = StringToText("异端分子与间谍：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1037] = StringToText("异端分子与寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1038] = StringToText("军团与工程师：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，");
    g_wikiLine[1039] = StringToText("工程师失去能力并改为得知这一信息。");
    g_wikiLine[1040] = StringToText("军团与帽匠：如果帽匠创造了军团，所有邪恶玩家会变成军团。如果军团在场，帽匠失去能力。");
    g_wikiLine[1041] = StringToText("军团与政客：政客可能会被军团当作邪恶玩家。");
    g_wikiLine[1042] = StringToText("军团与狂热者：狂热者可能会被军团当作邪恶玩家。");
    g_wikiLine[1043] = StringToText("军团与传教士：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_wikiLine[1044] = StringToText("军团与吟游诗人：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处");
    g_wikiLine[1045] = StringToText("决的玩家是军团。");
    g_wikiLine[1046] = StringToText("利维坦与驱魔人：如果利维坦提名并处决了驱魔人上个夜晚选择的那名玩家，善良阵营获胜。");
    g_wikiLine[1047] = StringToText("利维坦与帽匠：利维坦不能在第五天之后加入游戏。");
    g_wikiLine[1048] = StringToText("利维坦与旅店老板：如果利维坦提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1049] = StringToText("利维坦与镇长：如果利维坦和镇长在第五天存活且没有处决发生，善良阵营获胜。");
    g_wikiLine[1050] = StringToText("利维坦与僧侣：如果利维坦提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_wikiLine[1051] = StringToText("利维坦与麻脸巫婆：利维坦不能在第五天之后加入游戏。");
    g_wikiLine[1052] = StringToText("利维坦与士兵：如果利维坦提名并处决了士兵，善良阵营获胜。");
    g_wikiLine[1053] = StringToText("利维坦与守鸦人：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1054] = StringToText("如果守鸦人被选择，他的能力生效但不会死亡。");
    g_wikiLine[1055] = StringToText("利维坦与贤者：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1056] = StringToText("如果贤者被选择，他的能力生效但不会死亡。");
    g_wikiLine[1057] = StringToText("利维坦与报丧女妖：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1058] = StringToText("如果报丧女妖被选择，他死亡并能力生效。");
    g_wikiLine[1059] = StringToText("利维坦与农夫：每个夜晚*，利维坦要选择一名存活玩家（与之前的每个夜晚不同）：如果农夫被选择，");
    g_wikiLine[1060] = StringToText("他的能力生效但不会死亡。");
    g_wikiLine[1061] = StringToText("利维坦与祖母：如果利维坦在场，孙子死于处决，邪恶阵营获胜。");
    g_wikiLine[1062] = StringToText("利维坦与国王：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_wikiLine[1063] = StringToText("小怪宝与帽匠：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_wikiLine[1064] = StringToText("小怪宝与罂粟种植者：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，");
    g_wikiLine[1065] = StringToText("直到其中一名玩家选择照看小怪宝。");
    g_wikiLine[1066] = StringToText("小怪宝与精神病患者：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_wikiLine[1067] = StringToText("小怪宝与红唇女郎：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，");
    g_wikiLine[1068] = StringToText("之后红唇女郎必须要一直照看小怪宝。");
    g_wikiLine[1069] = StringToText("小怪宝与维齐尔：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_wikiLine[1070] = StringToText("小怪宝与魔术师：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_wikiLine[1071] = StringToText("魔术师与军团：如果魔术师在场，军团将被分组唤醒并得知非魔术师的善良玩家。");
    g_wikiLine[1072] = StringToText("魔术师与提线木偶：如果魔术师存活，恶魔不会得知谁是提线木偶。");
    g_wikiLine[1073] = StringToText("魔术师与维齐尔：如果维齐尔在场，魔术师不会拥有能力，但他会免疫维齐尔的能力。");
    g_wikiLine[1074] = StringToText("魔术师与亡魂：每次处决后，存活的魔术师可以公开猜测一名存活玩家是亡魂：如果猜对了，");
    g_wikiLine[1075] = StringToText("恶魔当晚必须选择亡魂。");
    g_wikiLine[1076] = StringToText("提线木偶与气球驾驶员：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_wikiLine[1077] = StringToText("提线木偶与巡山人：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_wikiLine[1078] = StringToText("提线木偶与卡扎力：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_wikiLine[1079] = StringToText("提线木偶与小怪宝：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_wikiLine[1080] = StringToText("提线木偶与炼金术士：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一");
    g_wikiLine[1081] = StringToText("定在场。");
    g_wikiLine[1082] = StringToText("主谋与亡骨魔：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_wikiLine[1083] = StringToText("主谋与炼金术士：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_wikiLine[1084] = StringToText("数学家与疯子：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。");
    g_wikiLine[1085] = StringToText("数学家与酒鬼：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_wikiLine[1086] = StringToText("数学家与提线木偶：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_wikiLine[1087] = StringToText("瘟疫医生与男爵：如果说书人获得了男爵的能力，改为至多两名玩家会变成外来者。");
    g_wikiLine[1088] = StringToText("瘟疫医生与炸弹人：如果说书人本应获得炸弹人的能力，改为一名玩家会变成炸弹人。");
    g_wikiLine[1089] = StringToText("瘟疫医生与镜像双子：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_wikiLine[1090] = StringToText("瘟疫医生与恐惧之灵：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获得此能力，");
    g_wikiLine[1091] = StringToText("且他会得知此事。");
    g_wikiLine[1092] = StringToText("瘟疫医生与哥布林：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1093] = StringToText("瘟疫医生与红唇女郎：如果说书人本应获得红唇女郎的能力，改为一名爪牙玩家获得此能力，");
    g_wikiLine[1094] = StringToText("且他会得知此事。");
    g_wikiLine[1095] = StringToText("瘟疫医生与间谍：如果说书人本应获得间谍的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1096] = StringToText("瘟疫医生与亡魂：如果说书人本应获得亡魂的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1097] = StringToText("瘟疫医生与提线木偶：如果说书人本应获得提线木偶的能力，改为一名与恶魔邻近的善良玩家变成提线木");
    g_wikiLine[1098] = StringToText("偶。");
    g_wikiLine[1099] = StringToText("陌客与贤者：陌客可能会被贤者当作杀死他的恶魔。");
    g_wikiLine[1100] = StringToText("陌客与食人魔：如果陌客被食人魔当作邪恶阵营，食人魔会得知自己转变为邪恶。");
    g_wikiLine[1101] = StringToText("暴乱与无神论者：在暴乱的提名链中，如果说书人被提名，玩家要进行投票。如果说书人「即将被处决」，");
    g_wikiLine[1102] = StringToText("游戏结束；否则，说书人要重新发起提名。");
    g_wikiLine[1103] = StringToText("暴乱与驱魔人：如果暴乱提名并处决了驱魔人上个夜晚选择的那名玩家，善良阵营获胜。");
    g_wikiLine[1104] = StringToText("暴乱与祖母：如果暴乱在场，孙子死于处决，邪恶阵营获胜。");
    g_wikiLine[1105] = StringToText("暴乱与旅店老板：如果暴乱提名并处决了旅店老板上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1106] = StringToText("暴乱与镇长：镇长可以停止暴乱的提名链。如果他这样做了，并且场上只有一名暴乱存活，善良阵营获胜；");
    g_wikiLine[1107] = StringToText("否则，邪恶阵营获胜。");
    g_wikiLine[1108] = StringToText("暴乱与僧侣：如果暴乱提名并处决了僧侣上个夜晚保护的那名玩家，善良阵营获胜。");
    g_wikiLine[1109] = StringToText("暴乱与士兵：如果暴乱提名并处决了士兵，善良阵营获胜。");
    g_wikiLine[1110] = StringToText("暴乱与农夫：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果农夫被选择，");
    g_wikiLine[1111] = StringToText("他的能力生效但不会死亡。");
    g_wikiLine[1112] = StringToText("暴乱与贤者：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：如果贤者被选择，");
    g_wikiLine[1113] = StringToText("他的能力生效但不会死亡。");
    g_wikiLine[1114] = StringToText("暴乱与守鸦人：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1115] = StringToText("如果守鸦人被选择，他的能力生效但不会死亡。");
    g_wikiLine[1116] = StringToText("暴乱与报丧女妖：每个夜晚*，暴乱要选择一名存活玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1117] = StringToText("如果报丧女妖被选择，他死亡并能力生效。");
    g_wikiLine[1118] = StringToText("暴乱与国王：如果暴乱在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_wikiLine[1119] = StringToText("红唇女郎与哈迪寂亚：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，");
    g_wikiLine[1120] = StringToText("则红唇女郎变成的恶魔会变回红唇女郎。");
    g_wikiLine[1121] = StringToText("红唇女郎与方古：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_wikiLine[1122] = StringToText("间谍与罂粟种植者：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_wikiLine[1123] = StringToText("间谍与魔术师：当间谍查看魔典时，魔术师和恶魔的角色标记会被说书人移除。");
    g_wikiLine[1124] = StringToText("间谍与落难少女：如果间谍正在场或曾经在场，落难少女中毒。");
    g_wikiLine[1125] = StringToText("间谍与食人魔：间谍必定被食人魔当作邪恶阵营。");
    g_wikiLine[1126] = StringToText("召唤师与钟表匠：召唤师会被钟表匠当作恶魔。");
    g_wikiLine[1127] = StringToText("召唤师与侍臣：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_wikiLine[1128] = StringToText("召唤师与工程师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_wikiLine[1129] = StringToText("召唤师与帽匠：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_wikiLine[1130] = StringToText("召唤师与卡扎力：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_wikiLine[1131] = StringToText("召唤师与军团：如果召唤师召唤了军团，所有邪恶玩家会变成军团。");
    g_wikiLine[1132] = StringToText("召唤师与堤丰之首：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，");
    g_wikiLine[1133] = StringToText("且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_wikiLine[1134] = StringToText("召唤师与提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_wikiLine[1135] = StringToText("召唤师与麻脸巫婆：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_wikiLine[1136] = StringToText("召唤师与罂粟种植者：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，");
    g_wikiLine[1137] = StringToText("由说书人来决定哪名玩家发生转变。");
    g_wikiLine[1138] = StringToText("召唤师与传教士：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_wikiLine[1139] = StringToText("召唤师与普卡：召唤师可以在第二个夜晚召唤普卡来替代第三个夜晚的召唤。");
    g_wikiLine[1140] = StringToText("召唤师与炼金术士：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔角色，但不选择玩家，");
    g_wikiLine[1141] = StringToText("由说书人决定哪一名玩家变成邪恶的恶魔。如果他在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_wikiLine[1142] = StringToText("召唤师与僵怖：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_wikiLine[1143] = StringToText("维齐尔与戏法师：说书人不会宣布维齐尔在场。");
    g_wikiLine[1144] = StringToText("维齐尔与侍臣：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_wikiLine[1145] = StringToText("维齐尔与调查员：说书人不会宣布维齐尔在场。");
    g_wikiLine[1146] = StringToText("维齐尔与传教士：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_wikiLine[1147] = StringToText("维齐尔与恐惧之灵：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。");
    g_wikiLine[1148] = StringToText("他会得知恐惧之灵选择了哪名玩家，并且无法使用自己的能力让那名玩家立即被处决。");
    g_wikiLine[1149] = StringToText("维齐尔与政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_wikiLine[1150] = StringToText("维齐尔与狂热者：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_wikiLine[1151] = StringToText("涡流与报丧女妖：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的‘通用简化原则");
    g_wikiLine[1152] = StringToText("’已涵盖包括多角色互动下的涡流信息的简化处理方式，此条仅作说明。）");
    g_wikiLine[1153] = StringToText("寡妇与罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_wikiLine[1154] = StringToText("寡妇与魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_wikiLine[1155] = StringToText("寡妇与落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_wikiLine[1156] = StringToText("牙噶巴卜与驱魔人：如果驱魔人选中了牙噶巴卜，那么牙噶巴卜在当晚无法造成死亡。");
    g_wikiLine[1157] = StringToText("侍女与数学家：侍女会得知数学家是否醒来，即使她是在数学家之前醒来。");
    g_wikiLine[1158] = StringToText("哲学家与赏金猎人：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_wikiLine[1159] = StringToText("食人族与杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，");
    g_wikiLine[1160] = StringToText("当晚食人族会替杂耍艺人得知对应的信息。");
    g_wikiLine[1161] = StringToText("食人族与管家：如果食人族获得了管家的能力，他会得知这一信息。");
    g_wikiLine[1162] = StringToText("食人族与狂热者：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_wikiLine[1163] = StringToText("食人族与公主：如果食人族提名并处决了公主且公主因此死亡，当晚恶魔不会造成死亡。");
    g_wikiLine[1164] = StringToText("麻脸巫婆与落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_wikiLine[1165] = StringToText("麻脸巫婆与政客：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。");
    g_wikiLine[1166] = StringToText("麻脸巫婆与异教领袖：被麻脸巫婆创造的邪恶异教领袖无法因为自身能力转变为善良阵营。");
    g_wikiLine[1167] = StringToText("麻脸巫婆与莽夫：被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。");
    g_wikiLine[1168] = StringToText("麻脸巫婆与食人魔：被麻脸巫婆创造的邪恶食人魔无法因为自身能力转变为善良阵营。");
    g_wikiLine[1169] = StringToText("麻脸巫婆与村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，");
    g_wikiLine[1170] = StringToText("村夫的醉酒效果可能会更换目标。");
    g_wikiLine[1171] = StringToText("洗脑师与哥布林：洗脑师可以选择将玩家洗脑成哥布林。");
    g_wikiLine[1172] = StringToText("街头风琴手与管家：如果街头风琴手使得玩家需要闭眼投票，管家可以自由举手投票，");
    g_wikiLine[1173] = StringToText("但只在他的主人投票时他的票才会被统计。");
    g_wikiLine[1174] = StringToText("街头风琴手与炼金术士：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。");
    g_wikiLine[1175] = StringToText("如果炼金术士和街头风琴手都是清醒的，改为他们都醉酒。");
    g_wikiLine[1176] = StringToText("科学怪人与异教领袖：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_wikiLine[1177] = StringToText("科学怪人与莽夫：如果恶魔拥有莽夫的能力，他无法因为该能力转变为善良阵营。");
    g_wikiLine[1178] = StringToText("科学怪人与异端分子：恶魔无法拥有异端分子的能力。");
    g_wikiLine[1179] = StringToText("科学怪人与食人魔：恶魔无法拥有食人魔的能力。");
    g_wikiLine[1180] = StringToText("科学怪人与政客：恶魔无法拥有政客的能力。");
    g_wikiLine[1181] = StringToText("科学怪人与酒鬼：恶魔无法拥有酒鬼的能力。");
    g_wikiLine[1182] = StringToText("科学怪人与炼金术士：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔因此获得了哪个角色的");
    g_wikiLine[1183] = StringToText("能力。");
    g_wikiLine[1184] = StringToText("科学怪人与村夫：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_wikiLine[1185] = StringToText("痢蛭与主谋：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_wikiLine[1186] = StringToText("痢蛭与猎手：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_wikiLine[1187] = StringToText("【暂时没有相克规则，但建议额外设立规则的组合】");
    g_wikiLine[1188] = StringToText("理发师与异教领袖/莽夫/政客/食人魔：参考麻脸巫婆。建议「恶魔无法将一名邪恶玩家与异教领袖/");
    g_wikiLine[1189] = StringToText("莽夫/政客/食人魔交换角色，理发师的能力会因此被浪费」。");
    g_wikiLine[1190] = StringToText("理发师与落难少女：参考麻脸巫婆。建议「如果恶魔选择交换落难少女的角色，");
    g_wikiLine[1191] = StringToText("参与角色交换的另一名玩家改为由说书人来决定」。");
    g_wikiLine[1192] = StringToText("食人族与月之子/呆瓜：参考食人族&管家。建议「如果食人族获得了月之子/呆瓜的能力，");
    g_wikiLine[1193] = StringToText("他会得知这一信息。」");
    g_wikiLine[1194] = StringToText("【与华灯初上系列角色相关的相克规则】");
    g_wikiLine[1195] = StringToText("戏子与间谍：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1196] = StringToText("戏子与教父：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1197] = StringToText("戏子与镜像双子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1198] = StringToText("戏子与麻脸巫婆：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1199] = StringToText("戏子与寡妇：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1200] = StringToText("戏子与提线木偶：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1201] = StringToText("戏子与亡魂：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1202] = StringToText("戏子与召唤师：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1203] = StringToText("戏子与堤丰之首：堤丰之首和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜");
    g_wikiLine[1204] = StringToText("晚变成戏子，说书人会在这一效果生效之前先告知堤丰之首两侧的玩家是邪恶的爪牙。");
    g_wikiLine[1205] = StringToText("戏子与暴乱：在戏子存在于剧本中时，暴乱可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_wikiLine[1206] = StringToText("说书人会在当晚杀死这名玩家。");
    g_wikiLine[1207] = StringToText("戏子与军团：在戏子存在于剧本中时，军团可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_wikiLine[1208] = StringToText("说书人会在夜晚一同唤醒所有军团，并询问他们是否要一同死亡。");
    g_wikiLine[1209] = StringToText("戏子与利维坦：在戏子存在于剧本中时，利维坦可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_wikiLine[1210] = StringToText("说书人会在当晚杀死这名玩家。");
    g_wikiLine[1211] = StringToText("戏子与普卡：在戏子存在于剧本中时，普卡可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_wikiLine[1212] = StringToText("说书人会在当晚杀死这名玩家。");
    g_wikiLine[1213] = StringToText("戏子与僵怖：在戏子存在于剧本中时，僵怖可以在游戏中任意时候向说书人示意自己「想要死亡」。");
    g_wikiLine[1214] = StringToText("无论僵怖是否触发过「假死」，当晚僵怖会变为死亡状态。");
    g_wikiLine[1215] = StringToText("戏子与牙噶巴卜：在戏子存在于剧本中时，牙噶巴卜可以在游戏中任意时候向说书人示意自己「想要死亡");
    g_wikiLine[1216] = StringToText("」。不论他是否说过秘密短语，说书人都会在当晚杀死这名玩家。");
    g_wikiLine[1217] = StringToText("戏子与卡扎力：卡扎力和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变");
    g_wikiLine[1218] = StringToText("成戏子，卡扎力会在这一效果生效之前先进行转变爪牙的行动。");
    g_wikiLine[1219] = StringToText("戏子与无神论者：戏子无法反转处决说书人导致的胜负结果。");
    g_wikiLine[1220] = StringToText("戏子与哥布林：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_wikiLine[1221] = StringToText("戏子与恐惧之灵：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_wikiLine[1222] = StringToText("狸猫与教授：如果狸猫与使用过能力的教授交换角色，新教授仍然失去能力。");
    g_wikiLine[1223] = StringToText("狸猫与报丧女妖：如果狸猫与报丧女妖交换角色，不会触发报丧女妖的能力。");
    g_wikiLine[1224] = StringToText("狸猫与科学怪人：如果因科学怪人获得狸猫能力的恶魔与「太子」交换角色，");
    g_wikiLine[1225] = StringToText("改为「太子」变成狸猫且恶魔获得「太子」原本角色的能力。");
    g_wikiLine[1226] = StringToText("引路人与侍女：侍女会得知引路人是否醒来，即使她是在引路人之前醒来。");
    g_wikiLine[1227] = StringToText("引路人与数学家：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。");
    g_wikiLine[1228] = StringToText("鸩与罂粟种植者：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。");
    g_wikiLine[1229] = StringToText("鸩与半仙：如果鸩选择了半仙，半仙会中毒并死亡。");
    g_wikiLine[1230] = StringToText("悟道者与村夫：如果村夫在场数量不足3人，悟道者可以变成新的村夫。如果因此使得村夫的在场数量超");
    g_wikiLine[1231] = StringToText("过1人，会有一名村夫醉酒。");
    g_wikiLine[1232] = StringToText("悟道者与数学家：数学家会得知悟道者产生了错误信息或「能力未正常生效」。");
    g_wikiLine[1233] = StringToText("入殓师与红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，");
    g_wikiLine[1234] = StringToText("红唇女郎不会变成恶魔。");
    g_wikiLine[1235] = StringToText("入殓师与哈迪寂亚：如果出现两名存活的哈迪寂亚，则入殓师变成的哈迪寂亚会变回入殓师，");
    g_wikiLine[1236] = StringToText("但阵营保持邪恶。");
    g_wikiLine[1237] = StringToText("入殓师与小怪宝：如果在五名及以上的玩家存活时，入殓师提名并处决了照看小怪宝的玩家，");
    g_wikiLine[1238] = StringToText("入殓师会变为邪恶的该角色，之后原入殓师玩家必须要一直照看小怪宝。");
    g_wikiLine[1239] = StringToText("入殓师与痢蛭：如果在大于等于五名玩家存活时，入殓师提名并处决了宿主且他死于这次处决，");
    g_wikiLine[1240] = StringToText("原本的痢蛭会在当晚死亡，入殓师变为邪恶的痢蛭且当晚无法攻击。");
    g_wikiLine[1241] = StringToText("瘟疫医生与赶尸人：如果说书人本应获得赶尸人的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1242] = StringToText("瘟疫医生与狐媚娘：如果说书人本应获得狐媚娘的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1243] = StringToText("瘟疫医生与养蛊人：如果说书人本应获得养蛊人的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1244] = StringToText("异端分子与狐媚娘：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1245] = StringToText("科学怪人与悟道者：恶魔无法拥有悟道者的能力。");
    g_wikiLine[1246] = StringToText("孟婆与罂粟种植者：如果孟婆选中了罂粟种植者，罂粟种植者会得知自己被孟婆选中并死亡。");
    g_wikiLine[1247] = StringToText("孟婆与红唇女郎：如果恶魔选择死亡且红唇女郎即将变成恶魔，改为恶魔与红唇女郎交换角色，");
    g_wikiLine[1248] = StringToText("随后原恶魔死亡。");
    g_wikiLine[1249] = StringToText("蛊雕与炼金术士：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改为蛊雕一定在场。");
    g_wikiLine[1250] = StringToText("每次处决后，存活的炼金术士可以公开猜测一名存活玩家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_wikiLine[1251] = StringToText("蛊雕与魔术师：蛊雕会跳过魔术师。");
    g_wikiLine[1252] = StringToText("蛊雕与食人魔：如果「蛊毒」玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。");
    g_wikiLine[1253] = StringToText("蛊雕与瘟疫医生：如果说书人本应获得蛊雕的能力，改为一名爪牙玩家获得此能力，且他会得知此事。");
    g_wikiLine[1254] = StringToText("蛊雕与戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1255] = StringToText("暴乱与打更人：如果暴乱提名并处决了打更人上个夜晚猜测的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1256] = StringToText("暴乱与和尚：如果暴乱提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_wikiLine[1257] = StringToText("暴乱与狸猫：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1258] = StringToText("如果「太子」被选择，他会与狸猫交换角色但不会死亡。");
    g_wikiLine[1259] = StringToText("暴乱与巡察：如果暴乱提名并处决了巡察上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1260] = StringToText("利维坦与和尚：如果利维坦提名并处决了与和尚邻近的其中一名存活玩家，善良阵营获胜。");
    g_wikiLine[1261] = StringToText("利维坦与打更人：如果利维坦提名并处决了打更人上个夜晚猜测的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1262] = StringToText("利维坦与狸猫：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1263] = StringToText("如果「太子」被选择，他会与狸猫交换角色但不会死亡。");
    g_wikiLine[1264] = StringToText("利维坦与巡察：如果利维坦提名并处决了巡察上个夜晚保护的其中一名玩家，善良阵营获胜。");
    g_wikiLine[1265] = StringToText("典狱长与召唤师：召唤师可以在第二个夜晚召唤典狱长来替代第三个夜晚的召唤。");
    g_wikiLine[1266] = StringToText("梼杌与红唇女郎：红唇女郎在梼杌的能力判断中被当作「不具有能力」。");
    g_wikiLine[1267] = StringToText("梼杌与镜像双子：镜像双子在梼杌的能力判断中被当作「不具有能力」。");
    g_wikiLine[1268] = StringToText("梼杌与主谋：主谋在梼杌的能力判断中被当作「不具有能力」。");
    g_wikiLine[1269] = StringToText("梼杌与街头风琴手：当梼杌被处决时，如果街头风琴手具有能力，说书人会宣布「无人被处决」。");
    g_wikiLine[1270] = StringToText("梼杌与提线木偶：梼杌不会得知谁是提线木偶。在梼杌使得提线木偶失去能力后，");
    g_wikiLine[1271] = StringToText("梼杌会得知对应的那一名提线木偶是谁，但提线木偶会仍然以为自己是一个善良角色。");
    g_wikiLine[1272] = StringToText("梼杌与帽匠：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_wikiLine[1273] = StringToText("梼杌与麻脸巫婆：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_wikiLine[1274] = StringToText("梼杌与工程师：如果梼杌变成了其他恶魔，因为梼杌而失去能力的爪牙会立即死亡。");
    g_wikiLine[1275] = StringToText("梼杌与舞蛇人：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_wikiLine[1276] = StringToText("梼杌与理发师：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_wikiLine[1277] = StringToText("痢蛭与半仙：痢蛭的宿主及其中毒效果无法被转移。");
    g_wikiLine[1278] = StringToText("痢蛭与使节：痢蛭的宿主及其中毒效果无法被转移。");
    g_wikiLine[1279] = StringToText("痢蛭与掮客：痢蛭的宿主及其中毒效果无法被转移。");
    g_wikiLine[1280] = StringToText("姑获鸟与驱魔人：一名已获得过爪牙能力的姑获鸟被驱魔人选中，他能够因为爪牙的能力被唤醒。");
    g_wikiLine[1281] = StringToText("姑获鸟与主谋：如果姑获鸟死亡，获得主谋能力的姑获鸟保留主谋的能力。");
    g_wikiLine[1282] = StringToText("姑获鸟与镜像双子：如果姑获鸟获得了镜像双子的能力，新对立双子会知道「姑获鸟在场」，");
    g_wikiLine[1283] = StringToText("但不会知道姑获鸟是谁。");
    g_wikiLine[1284] = StringToText("姑获鸟与哥布林：姑获鸟无法获得哥布林的能力。");
    g_wikiLine[1285] = StringToText("姑获鸟与精神病患者：如果姑获鸟获得了精神病患者的能力，他会在被处决时死亡。");
    g_wikiLine[1286] = StringToText("姑获鸟与提线木偶：姑获鸟无法获得提线木偶的能力。");
    g_wikiLine[1287] = StringToText("姑获鸟与维齐尔：姑获鸟无法获得维齐尔的能力。");
    g_wikiLine[1288] = StringToText("姑获鸟与召唤师：如果召唤师成功召唤了姑获鸟，召唤师会变成一个不在场的爪牙。");
    g_wikiLine[1289] = StringToText("姑获鸟与亡魂：如果姑获鸟本应获得亡魂的能力，改为亡魂保留能力。");
    // 6 可以但不建议
    g_wikiAt[6] = 1290;
    g_wikiN[6] = 88;
    g_wikiLine[1290] = StringToText("【简要说明】");
    g_wikiLine[1291] = StringToText("此处列举了一些属于「规则允许，但不建议让说书人这么做」的行为（简称「YBD」，");
    g_wikiLine[1292] = StringToText("指「Yes but don't」）。《染》是一款对规则持开放态度的游戏，");
    g_wikiLine[1293] = StringToText("然而这并不意味着某些事情能做，就必须要去这么做。设计师也在「给说书人的建议」里强调了这一点。");
    g_wikiLine[1294] = StringToText("为此，我们在这里整理了部分属于「可以但不建议」的游戏行为，方便大家查找。");
    g_wikiLine[1295] = StringToText("因为游戏中角色的数量逐渐增加，角色之间的互动也会变得越来越多，难免会出现新的「YBD」，");
    g_wikiLine[1296] = StringToText("而没有及时在这里列出，此时说书人需要结合自己的实际经验来进行判断，");
    g_wikiLine[1297] = StringToText("尽可能给玩家带来一个良好的游戏体验。");
    g_wikiLine[1298] = StringToText("【基础规则部分】");
    g_wikiLine[1299] = StringToText("· 恶魔的伪装");
    g_wikiLine[1300] = StringToText("在恶魔得知三个不在场的善良角色时，得知酒鬼或提线木偶以为的角色。（虽然这些角色的确不在场，");
    g_wikiLine[1301] = StringToText("但这不利于恶魔进行伪装，也不够有趣。）");
    g_wikiLine[1302] = StringToText("· 旅行者的加入游戏");
    g_wikiLine[1303] = StringToText("在初始游戏人数不足七人，或当前场中剩余存活人数不足七人时加入旅行者。");
    g_wikiLine[1304] = StringToText("· 旅行者的角色转换");
    g_wikiLine[1305] = StringToText("让旅行者在游戏中途变成非旅行者，或者非旅行者在游戏中途变成旅行者。（如果你实在想这么做，");
    g_wikiLine[1306] = StringToText("需要在游戏开始前告知所有玩家，并在游戏中始终保持旅行者角色的公开，但这无法保证游戏的乐趣。");
    g_wikiLine[1307] = StringToText("另外，在这一规则下，麻脸巫婆也仍无法将玩家变成旅行者，因为旅行者角色不满足「不在场」的定义，");
    g_wikiLine[1308] = StringToText("详情参考术语汇总。）");
    g_wikiLine[1309] = StringToText("· 疯狂");
    g_wikiLine[1310] = StringToText("在进入夜晚时因为玩家白天的行为而判定他不够疯狂，让他夜晚时受到惩罚。");
    g_wikiLine[1311] = StringToText("（因为疯狂的判断通常更多时候需要参考玩家较近时间内的表现而非更早时候的行为，");
    g_wikiLine[1312] = StringToText("延迟对疯狂的判断本身就是在制造混乱。详情可以参考小精灵的拓展阅读）");
    g_wikiLine[1313] = StringToText("【暗流涌动】");
    g_wikiLine[1314] = StringToText("· 镇长");
    g_wikiLine[1315] = StringToText("频繁地让镇长的能力触发并因此选择无法死去的玩家作为代替镇长死亡的目标。");
    g_wikiLine[1316] = StringToText("· 陌客");
    g_wikiLine[1317] = StringToText("1.让陌客在「爪牙信息」和「恶魔信息」阶段，被当作爪牙或恶魔，以此让真爪牙得知陌客与真恶魔两");
    g_wikiLine[1318] = StringToText("名恶魔玩家；或让真恶魔得知陌客与其他爪牙是他的爪牙；或与爪牙一起睁眼；");
    g_wikiLine[1319] = StringToText("或作为恶魔睁眼得知所有爪牙和恶魔伪装。（为了达成同样的目的，可以在剧本中加入魔术师，");
    g_wikiLine[1320] = StringToText("而不必让陌客作为一个外来者在此处发挥正面的作用）");
    g_wikiLine[1321] = StringToText("2.让陌客在小恶魔自杀时被当作爪牙，并因此将一个与原本的小恶魔实际阵营不同的陌客变成小恶魔。");
    g_wikiLine[1322] = StringToText("3.让陌客在死亡时被当作恶魔，并因此让红唇女郎变成对应那种被当作的恶魔。");
    g_wikiLine[1323] = StringToText("4.让陌客被当作爪牙或恶魔并因此被工程师改变角色。");
    g_wikiLine[1324] = StringToText("5.让能查看魔典的角色（间谍和寡妇）在查看魔典时，将陌客角色标记替换成爪牙或恶魔角色标记。");
    g_wikiLine[1325] = StringToText("（同样的，这一行为可以通过魔术师来实现）");
    g_wikiLine[1326] = StringToText("6.在没有其他恶魔存活的时候，将陌客当作恶魔，并因此让游戏继续而不是让善良阵营获胜。");
    g_wikiLine[1327] = StringToText("【（规则不可以，也不建议）】");
    g_wikiLine[1328] = StringToText("7.不向教父提供陌客在场的信息，或在陌客死亡的时候不当作外来者并因此无法触发教父的能力。");
    g_wikiLine[1329] = StringToText("8.在方古杀死陌客时，不将陌客当作外来者，并因此无法触发方古的能力。");
    g_wikiLine[1330] = StringToText("9.让陌客成为占卜师的「干扰项」。（陌客本身就可以被占卜师当作恶魔，");
    g_wikiLine[1331] = StringToText("并且这可能会在陌客被占卜师当作邪恶阵营时，转移「干扰项」并误导占卜师将新的「干扰项」误认为是");
    g_wikiLine[1332] = StringToText("原本爪牙现在为小恶魔。）");
    g_wikiLine[1333] = StringToText("10.让陌客在被麻脸巫婆创造的时候当作创造了一个恶魔，并因此触发麻脸巫婆的能力由说书人决定当");
    g_wikiLine[1334] = StringToText("晚的死亡。");
    g_wikiLine[1335] = StringToText("11.在舞蛇人选中陌客时，将陌客当作恶魔，从而触发了舞蛇人的能力进行了阵营与角色的交换。");
    g_wikiLine[1336] = StringToText("· 酒鬼");
    g_wikiLine[1337] = StringToText("让酒鬼以为的角色是与某个在场镇民相同的角色。（默认实体规则下，通常每个镇民角色标记只有一个，");
    g_wikiLine[1338] = StringToText("而线上游戏或是有多套实体游戏则能实现这个操作。如果你实在想这么做，");
    g_wikiLine[1339] = StringToText("需要在游戏开始前告诉大家这一规则，同时这也会让酒鬼这个角色多少背离原本的设计意图。");
    g_wikiLine[1340] = StringToText("为了达成同样的目的，可以在剧本中加入小精灵来实现，并且也通常建议这么做。）");
    g_wikiLine[1341] = StringToText("· 间谍");
    g_wikiLine[1342] = StringToText("1.让间谍成为占卜师的「干扰项」。");
    g_wikiLine[1343] = StringToText("2.让能查看魔典的角色（间谍和寡妇）在查看魔典时，将间谍角色标记替换成镇民或外来者角色标记。");
    g_wikiLine[1344] = StringToText("（没 有 必 要）");
    g_wikiLine[1345] = StringToText("3.让间谍在「爪牙信息」和「恶魔信息」阶段，被当作镇民或外来者并因此不参与爪牙互认，");
    g_wikiLine[1346] = StringToText("不获取谁是恶魔的信息，或让恶魔无法得知间谍是他的爪牙。");
    g_wikiLine[1347] = StringToText("4.让间谍被当作善良阵营，从而成为镜像双子的对立双子。");
    g_wikiLine[1348] = StringToText("5.在小恶魔自杀时，将间谍当作善良角色，使得间谍无法变成小恶魔，而导致游戏结束。");
    g_wikiLine[1349] = StringToText("【黯月初升】");
    g_wikiLine[1350] = StringToText("· 祖母");
    g_wikiLine[1351] = StringToText("让祖母成为自己的孙子。（祖 母 悖 论 要 不 得）");
    g_wikiLine[1352] = StringToText("· 教授");
    g_wikiLine[1353] = StringToText("在教授夜晚行动时，允许教授挨个点一遍他眼里的存活玩家来确认有谁当晚死亡。");
    g_wikiLine[1354] = StringToText("（建议教授选择他认知里已死亡的玩家，而只有那些在教授醒来前复活的玩家说书人需要提醒教授重新更");
    g_wikiLine[1355] = StringToText("换目标）");
    g_wikiLine[1356] = StringToText("· 造谣者");
    g_wikiLine[1357] = StringToText("让造谣者的能力选择一名无法死亡的玩家死亡。");
    g_wikiLine[1358] = StringToText("· 疯子");
    g_wikiLine[1359] = StringToText("欺骗疯子让他以为自己被舞蛇人的效果选中从而变成了舞蛇人。（从规则上来说，这是不允许的，");
    g_wikiLine[1360] = StringToText("因为疯子的认知覆盖能力需要确保他一直以为自己是恶魔角色。这里也放在了一起，");
    g_wikiLine[1361] = StringToText("但需要注意这是【「规则不可以，也不建议」】）");
    g_wikiLine[1362] = StringToText("【梦殒春宵】");
    g_wikiLine[1363] = StringToText("· 舞蛇人");
    g_wikiLine[1364] = StringToText("让醉酒或中毒的舞蛇人以为自己选中并变成了恶魔角色。【（规则不可以，也不建议）】");
    g_wikiLine[1365] = StringToText("【实验性角色】");
    g_wikiLine[1366] = StringToText("· 小精灵");
    g_wikiLine[1367] = StringToText("让小精灵的能力得知小精灵在场。");
    g_wikiLine[1368] = StringToText("· 赏金猎人");
    g_wikiLine[1369] = StringToText("让赏金猎人因为自己的初始设置效果而转变为邪恶阵营的同时，让赏金猎人的能力得知自己。");
    g_wikiLine[1370] = StringToText("· 解谜大师");
    g_wikiLine[1371] = StringToText("让解谜大师的能力使自身或恶魔醉酒。");
    g_wikiLine[1372] = StringToText("· 事务官");
    g_wikiLine[1373] = StringToText("让事务官的能力得知玩家自己。");
    g_wikiLine[1374] = StringToText("· 魔术师");
    g_wikiLine[1375] = StringToText("让魔术师成为镜像双子的对立双子。");
    g_wikiLine[1376] = StringToText("· 小怪宝");
    g_wikiLine[1377] = StringToText("让疯子以为自己是小怪宝。");
    // 7 夜晚行动顺序一览
    g_wikiAt[7] = 1378;
    g_wikiN[7] = 318;
    g_wikiLine[1378] = StringToText("由于华灯初上发布后，现有的在线魔典和剧本的功能正在调整中，因此在这里列出包含所有现有官方角色");
    g_wikiLine[1379] = StringToText("和华灯初上角色的夜晚顺序总表，方便玩家查询。");
    g_wikiLine[1380] = StringToText("注：部分官方角色的顺序相对原本的顺序有所调整，针对部分角色的顺序进行了优化。");
    g_wikiLine[1381] = StringToText("说书人在查询夜晚顺序表时，可以自行选择【依照原本的夜晚顺序表的顺序】执行角色行动，");
    g_wikiLine[1382] = StringToText("或是【按此处推荐的顺序】执行角色行动。针对做出了顺序变化的角色，会以备注的形式说明调整的原因。");
    g_wikiLine[1383] = StringToText("【首个夜晚】");
    g_wikiLine[1384] = StringToText("【黄昏】：检查所有玩家是否闭上眼睛。部分旅行者、传奇角色和奇遇角色会在这时行动。（官员、窃贼、");
    g_wikiLine[1385] = StringToText("学徒、咖啡师）");
    g_wikiLine[1386] = StringToText("【堤丰之首】：将位于堤丰之首两侧的对应数量的玩家变成邪恶的爪牙，并分别唤醒他们通知他们的角色");
    g_wikiLine[1387] = StringToText("和阵营变化。");
    g_wikiLine[1388] = StringToText("【卡扎力】：唤醒卡扎力，让他选择玩家变成邪恶爪牙。");
    g_wikiLine[1389] = StringToText("【亡魂】：从现在开始，亡魂可以在夜晚睁眼。每当你要在夜晚唤醒一名邪恶玩家时，先唤醒亡魂。");
    g_wikiLine[1390] = StringToText("当你让这名邪恶玩家重新入睡时，也让亡魂入睡。");
    g_wikiLine[1391] = StringToText("【科学怪人】：（分别或同时）唤醒科学怪人和恶魔，通知他们恶魔因为科学怪人而获得的善良角色的能");
    g_wikiLine[1392] = StringToText("力。");
    g_wikiLine[1393] = StringToText("【失忆者】：决定失忆者的能力，并根据具体能力决定是否需要唤醒失忆者、何时唤醒、");
    g_wikiLine[1394] = StringToText("唤醒后让他做出什么操作或得知什么信息。（调整理由：根据失忆者的能力，");
    g_wikiLine[1395] = StringToText("失忆者的夜晚顺序会相应地进行调整。因此，将失忆者放在夜晚顺序的最开始部分，");
    g_wikiLine[1396] = StringToText("以便提醒说书人在此时决定失忆者的唤醒时机，并在当晚的合适时机下唤醒失忆者并令其进行行动。）");
    g_wikiLine[1397] = StringToText("【哲学家】：唤醒哲学家，他可以摇头不使用能力，或选择获得角色列表上的一个善良角色的能力。");
    g_wikiLine[1398] = StringToText("【炼金术士】：唤醒炼金术士，对他展示他获得的能力所对应的爪牙角色标记。");
    g_wikiLine[1399] = StringToText("【罂粟种植者】：如果罂粟种植者在场，跳过今晚的爪牙信息与恶魔信息环节中互相认识的部分。");
    g_wikiLine[1400] = StringToText("【魔术师】：如果魔术师在场，则需要对爪牙信息环节和恶魔信息环节的相关内容进行调整。（添加理由：");
    g_wikiLine[1401] = StringToText("在爪牙信息开始前添加魔术师的行动顺序，用以提醒说书人在提供给爪牙和恶魔信息时，不要出错。");
    g_wikiLine[1402] = StringToText("因为魔术师与罂粟种植者同属对首夜邪恶信息的干扰，因此将魔术师的行动放在了这里。）");
    g_wikiLine[1403] = StringToText("【遗忘之门】：如果遗忘之门加入游戏，跳过爪牙信息和恶魔信息环节。");
    g_wikiLine[1404] = StringToText("【爪牙信息】：如果有七名或更多玩家，唤醒所有爪牙：展示「他是恶魔」信息标记。指向恶魔。");
    g_wikiLine[1405] = StringToText("如果下方的其他对爪牙暴露的角色在场，不要让爪牙入睡，而是一并给出相关信息后再让爪牙入睡。");
    g_wikiLine[1406] = StringToText("【告密者】：如果告密者在场，对爪牙展示三个不在场的善良角色标记。");
    g_wikiLine[1407] = StringToText("【落难少女】：如果落难少女在场，对爪牙展示落难少女角色标记。（调整理由：");
    g_wikiLine[1408] = StringToText("原本的落难少女行动顺序只涉及到巡山人相关，而巡山人的夜晚行动中本身已经提示了说书人需要对落难");
    g_wikiLine[1409] = StringToText("少女进行角色变更和唤醒操作，故原本的落难少女行动提示略显累赘。因为落难少女本身具有对爪牙的暴");
    g_wikiLine[1410] = StringToText("露能力，因此将其首夜行动调整到这里，并删除其他夜晚行动，同时也可以对「暴露角色」相关能力解释");
    g_wikiLine[1411] = StringToText("优化以便于理解。）");
    g_wikiLine[1412] = StringToText("【召唤师】：唤醒召唤师，对他展示三个不在场的善良角色标记。");
    g_wikiLine[1413] = StringToText("【疯子】：唤醒疯子并向他提供恶魔信息。如需要，则让疯子先于恶魔进行相应的恶魔行动。");
    g_wikiLine[1414] = StringToText("随后在恶魔被唤醒时对恶魔提供疯子的相关信息。");
    g_wikiLine[1415] = StringToText("【梼杌】：如果梼杌在场，跳过他的恶魔信息环节。");
    g_wikiLine[1416] = StringToText("【恶魔信息】：如果有七名或更多玩家，唤醒恶魔：展示「他们是你的爪牙」信息标记。指向所有爪牙。");
    g_wikiLine[1417] = StringToText("展示「这些角色不在场」信息标记。展示三个不在场的善良角色。如果其他对恶魔暴露的角色在场，");
    g_wikiLine[1418] = StringToText("不要让恶魔入睡，而是一并给出相关信息后再让恶魔入睡。");
    g_wikiLine[1419] = StringToText("【国王】：如果国王在场，对恶魔展示国王角色标记并指向国王玩家。");
    g_wikiLine[1420] = StringToText("【提线木偶】：如果提线木偶在场，对恶魔展示提线木偶角色标记并指向提线木偶玩家。（调整理由：");
    g_wikiLine[1421] = StringToText("与疯子和国王同属暴露给恶魔的角色，因此调整顺序使得说书人方便一次性向恶魔展示所有信息。）");
    g_wikiLine[1422] = StringToText("【书生】：如果书生在场，对恶魔展示书生角色标记。");
    g_wikiLine[1423] = StringToText("【戏子】：唤醒所有戏子并让他们互认。");
    g_wikiLine[1424] = StringToText("【掮客】：唤醒掮客，让他选择两名玩家，如果这两名玩家阵营相同，放置「熟客」标记。");
    g_wikiLine[1425] = StringToText("【水手】：唤醒水手，让他选择一名玩家。决定他俩其中谁因为水手能力醉酒。");
    g_wikiLine[1426] = StringToText("【工程师】：唤醒工程师，他可以摇头不使用能力，或选择角色列表上的恶魔或爪牙角色，");
    g_wikiLine[1427] = StringToText("来执行同角色类型的这些玩家的角色变化。");
    g_wikiLine[1428] = StringToText("【传教士】：唤醒传教士，让他选择一名玩家。如果他选中了爪牙，该爪牙失去能力。");
    g_wikiLine[1429] = StringToText("在传教士入睡后通知该爪牙被传教士选中。");
    g_wikiLine[1430] = StringToText("【小怪宝】：唤醒所有爪牙选择由谁照看小怪宝。");
    g_wikiLine[1431] = StringToText("【痢蛭】：唤醒痢蛭，让他选择一名玩家以寄生。");
    g_wikiLine[1432] = StringToText("【画皮】：唤醒画皮，让他攻击一名存活玩家，该玩家变成活尸。");
    g_wikiLine[1433] = StringToText("【限】：在等同初始外来者数量的夜晚，所有镇民中毒。");
    g_wikiLine[1434] = StringToText("【投毒者】：唤醒投毒者，让他选择一名玩家，那名玩家中毒。");
    g_wikiLine[1435] = StringToText("【寡妇】：唤醒寡妇，让她查看魔典。在她查看完毕后让她选择一名玩家，那名玩家中毒。");
    g_wikiLine[1436] = StringToText("随后如果寡妇未醉酒中毒，唤醒一名善良玩家，对他展示寡妇角色标记。");
    g_wikiLine[1437] = StringToText("【蛊雕】：唤醒蛊雕，他可以摇头不改变方向，或点头改变方向。随后，对蛊雕展示被放置「蛊毒」提示");
    g_wikiLine[1438] = StringToText("标记玩家的角色标记。");
    g_wikiLine[1439] = StringToText("【侍臣】：唤醒侍臣，他可以摇头不使用能力，或选择角色列表上的一个任意角色，");
    g_wikiLine[1440] = StringToText("该角色对应的玩家之一醉酒。");
    g_wikiLine[1441] = StringToText("【巫师】：如果有必要，让巫师的能力生效。");
    g_wikiLine[1442] = StringToText("【舞蛇人】：唤醒舞蛇人，让他选择一名存活玩家。如果选中恶魔则执行角色和阵营的交换，");
    g_wikiLine[1443] = StringToText("并在舞蛇人入睡后通知旧恶魔角色变化。");
    g_wikiLine[1444] = StringToText("【教父】：唤醒教父，对他展示外来者角色标记，告诉他有哪些外来者在场。");
    g_wikiLine[1445] = StringToText("【街头风琴手】：让街头风琴手选择自己是否醉酒。如果他点头，标记街头风琴手醉酒。");
    g_wikiLine[1446] = StringToText("【魔鬼代言人】：唤醒魔鬼代言人，让他选择一名玩家，那名玩家处决不死。");
    g_wikiLine[1447] = StringToText("【镜像双子】：分别独自唤醒镜像双子和对立双子，告知他们由于镜像双子能力而得知的信息。");
    g_wikiLine[1448] = StringToText("【女巫】：唤醒女巫，让她选择一名玩家，那名玩家被诅咒。");
    g_wikiLine[1449] = StringToText("【洗脑师】：唤醒洗脑师，让他选择一名玩家和角色列表上的一个善良角色，");
    g_wikiLine[1450] = StringToText("那名玩家明天需要「疯狂」证明自己是那个角色。在洗脑师入睡后通知那名玩家被洗脑。");
    g_wikiLine[1451] = StringToText("【恐惧之灵】：唤醒恐惧之灵，让他选择一名玩家，随后通知所有玩家恐惧之灵选择了一名玩家。");
    g_wikiLine[1452] = StringToText("【鹰身女妖】：唤醒鹰身女妖，让她选择两名玩家，第一名玩家明天需要「疯狂」证明第二名玩家邪恶。");
    g_wikiLine[1453] = StringToText("在鹰身女妖入睡后通知第一名玩家被鹰身女妖选中。");
    g_wikiLine[1454] = StringToText("【灵言师】：唤醒灵言师，对他展示他的关键词。");
    g_wikiLine[1455] = StringToText("【狐媚娘】：唤醒狐媚娘，让她选择一名玩家。在狐媚娘入睡后通知那名玩家狐媚娘在场。");
    g_wikiLine[1456] = StringToText("【普卡】：唤醒普卡，让他选择一名玩家，那名玩家中毒。");
    g_wikiLine[1457] = StringToText("【牙噶巴卜】：唤醒牙噶巴卜，对他展示他的秘密短语。");
    g_wikiLine[1458] = StringToText("【典狱长】：唤醒典狱长，让他选择至多三名玩家。");
    g_wikiLine[1459] = StringToText("【酿酒师】：唤醒酿酒师，让他选择角色列表上的一个镇民角色并让他给出信息。");
    g_wikiLine[1460] = StringToText("【熊孩子】：唤醒熊孩子，让他选择角色列表上的一个镇民角色，该角色会产生错误信息。");
    g_wikiLine[1461] = StringToText("【小精灵】：唤醒小精灵，对他展示一个在场镇民角色标记。");
    g_wikiLine[1462] = StringToText("【巡山人】：唤醒巡山人，他可以摇头不使用能力，或选择一名玩家。如果巡山人选中了落难少女，");
    g_wikiLine[1463] = StringToText("则在巡山人入睡后通知落难少女角色变化。");
    g_wikiLine[1464] = StringToText("【洗衣妇】：唤醒洗衣妇，对她指向两名玩家，并展示一个镇民角色标记。");
    g_wikiLine[1465] = StringToText("这两名玩家其中之一是这个镇民。");
    g_wikiLine[1466] = StringToText("【图书管理员】：唤醒图书管理员，对他指向两名玩家，并展示一个外来者角色标记。");
    g_wikiLine[1467] = StringToText("这两名玩家其中之一是这个外来者。");
    g_wikiLine[1468] = StringToText("【调查员】：唤醒调查员，对他指向两名玩家，并展示一个爪牙角色标记。");
    g_wikiLine[1469] = StringToText("这两名玩家其中之一是这个爪牙。");
    g_wikiLine[1470] = StringToText("【厨师】：唤醒厨师，对他用手势比划数字来告知他邻座邪恶玩家有几对。");
    g_wikiLine[1471] = StringToText("【共情者】：唤醒共情者，对他用手势比划数字来告知他与他邻近的存活玩家中有几人是邪恶玩家。");
    g_wikiLine[1472] = StringToText("【占卜师】：唤醒占卜师，让他选择两名玩家。以点头或摇头告知他是否选中了恶魔。");
    g_wikiLine[1473] = StringToText("【管家】：唤醒管家，让他选择一名除自己以外的玩家，那名玩家成为他的主人。");
    g_wikiLine[1474] = StringToText("【逆臣】：唤醒逆臣，让他选择一名除自己以外的玩家，那名玩家现在与他不共戴天。");
    g_wikiLine[1475] = StringToText("【祖母】：唤醒祖母，对她指向一名善良玩家，并展示该玩家的角色标记。");
    g_wikiLine[1476] = StringToText("【钟表匠】：唤醒钟表匠，对他用手势比划数字来告知他恶魔与爪牙之间的最近距离。");
    g_wikiLine[1477] = StringToText("【筑梦师】：唤醒筑梦师，让他选择一名除自己以外的非旅行者玩家。对他展示一善一恶两个角色标记。");
    g_wikiLine[1478] = StringToText("【女裁缝】：唤醒女裁缝，她可以摇头不使用能力，或选择除自己以外的两名玩家。");
    g_wikiLine[1479] = StringToText("以点头或摇头告知她选择的玩家是否为同一阵营。");
    g_wikiLine[1480] = StringToText("【事务官】：唤醒事务官，对他指向一名善良玩家。");
    g_wikiLine[1481] = StringToText("【骑士】：唤醒骑士，对他指向两名非恶魔玩家。");
    g_wikiLine[1482] = StringToText("【贵族】：唤醒贵族，对他指向三名玩家。这三名玩家中有且仅有一名是邪恶玩家。");
    g_wikiLine[1483] = StringToText("【气球驾驶员】：唤醒气球驾驶员，对他指向一名玩家。");
    g_wikiLine[1484] = StringToText("【阴阳师】：唤醒阴阳师，对他展示两个善良角色和两个邪恶角色。");
    g_wikiLine[1485] = StringToText("【郎中】：唤醒郎中，让他指向一名玩家。对郎中展示一个与该玩家能力相关的词语。");
    g_wikiLine[1486] = StringToText("【店小二】：唤醒店小二，对他指向两名善良玩家。");
    g_wikiLine[1487] = StringToText("【村夫】：唤醒村夫，让他指向一名玩家，用手势告诉他那名玩家的阵营。");
    g_wikiLine[1488] = StringToText("【方士】：唤醒方士，让他选择一个数字。如果他选择了当晚对应的数字，");
    g_wikiLine[1489] = StringToText("向他展示对应数量在场的角色标记。");
    g_wikiLine[1490] = StringToText("【修行者】：唤醒修行者，对他指向对应方向来告知他最近的邪恶玩家的方向。");
    g_wikiLine[1491] = StringToText("【钦天监】：唤醒钦天监，对他指向对应方向来告知他最近的邪恶玩家的方向。");
    g_wikiLine[1492] = StringToText("【赏金猎人】：（在进入首个夜晚时立即通知赏金猎人转变的那个镇民他的阵营发生了变化）");
    g_wikiLine[1493] = StringToText("唤醒赏金猎人，对他指向一名邪恶玩家。");
    g_wikiLine[1494] = StringToText("【守夜人】：唤醒守夜人，他可以摇头不使用能力，或选择一名玩家。如果守夜人选择了玩家，");
    g_wikiLine[1495] = StringToText("则在守夜人入睡后通知那名玩家谁是守夜人。");
    g_wikiLine[1496] = StringToText("【异教领袖】：如果异教领袖的阵营发生了变化，将他唤醒并通知他最新阵营。");
    g_wikiLine[1497] = StringToText("【间谍】：唤醒间谍，让他查看魔典。");
    g_wikiLine[1498] = StringToText("【食人魔】：唤醒食人魔，让他选择一名玩家。如果他选择了邪恶玩家，将他的角色标记在魔典中倒置以");
    g_wikiLine[1499] = StringToText("表示他转变为邪恶阵营。");
    g_wikiLine[1500] = StringToText("【女祭司】：唤醒女祭司，对她指向一名玩家。");
    g_wikiLine[1501] = StringToText("【将军】：唤醒将军，对他用手势比划当前的优势阵营。");
    g_wikiLine[1502] = StringToText("【侍女】：唤醒侍女，让她选择两名除自己以外的存活玩家。用手势比划数字来告知她这些玩家中因自己");
    g_wikiLine[1503] = StringToText("能力而唤醒的玩家数量。");
    g_wikiLine[1504] = StringToText("【引路人】：唤醒引路人，让他选择一至三名除自己以外的玩家，以点头或摇头告知他选择的玩家中是否");
    g_wikiLine[1505] = StringToText("有玩家在当晚被邪恶玩家的能力选择或影响过。");
    g_wikiLine[1506] = StringToText("【数学家】：唤醒数学家，用手势比划数字来告诉他今天有多少玩家的能力未正常生效。");
    g_wikiLine[1507] = StringToText("【黎明】：等待数秒。让所有玩家睁眼。");
    g_wikiLine[1508] = StringToText("【利维坦】：如果利维坦在场，告知所有人利维坦在场，现在是第一个白天。");
    g_wikiLine[1509] = StringToText("【维齐尔】：如果维齐尔在场，告知所有人谁是维齐尔。");
    g_wikiLine[1510] = StringToText("【其他夜晚】");
    g_wikiLine[1511] = StringToText("【黄昏】：检查所有玩家是否闭上眼睛。部分旅行者、传奇角色和奇遇角色会在这时行动。（官员、窃贼、");
    g_wikiLine[1512] = StringToText("学徒、咖啡师、流莺、集骨者、公爵夫人）");
    g_wikiLine[1513] = StringToText("【亡魂】：从现在开始，亡魂可以在夜晚睁眼。每当你要在夜晚唤醒一名邪恶玩家时，先唤醒亡魂。");
    g_wikiLine[1514] = StringToText("当你让这名邪恶玩家重新入睡时，也让亡魂入睡。");
    g_wikiLine[1515] = StringToText("【失忆者】：根据失忆者的具体能力决定是否需要唤醒失忆者、何时唤醒、");
    g_wikiLine[1516] = StringToText("唤醒后让他做出什么操作或得知什么信息。（调整理由：与首夜相同，根据失忆者的能力，");
    g_wikiLine[1517] = StringToText("失忆者的夜晚顺序会相应地进行调整。）");
    g_wikiLine[1518] = StringToText("【哲学家】：如果哲学家未曾使用能力，唤醒哲学家，他可以摇头不使用能力，");
    g_wikiLine[1519] = StringToText("或选择获得角色列表上的一个善良角色的能力。");
    g_wikiLine[1520] = StringToText("【帽匠】：如果帽匠死于白天，（建议分别）唤醒恶魔和爪牙并让他们选择是否改变角色。");
    g_wikiLine[1521] = StringToText("如果帽匠死于夜晚，则在当前玩家行动结束后立即开始茶会。");
    g_wikiLine[1522] = StringToText("【罂粟种植者】：如果罂粟种植者死于白天，插入执行爪牙信息和恶魔信息（不包含恶魔伪装）流程。");
    g_wikiLine[1523] = StringToText("如果罂粟种植者死于夜晚，则在当前玩家行动结束后立即执行相关流程。");
    g_wikiLine[1524] = StringToText("【掮客】：唤醒掮客，让他选择两名玩家，如果这两名玩家阵营相同，放置「熟客」标记。");
    g_wikiLine[1525] = StringToText("【水手】：唤醒水手，让他选择一名玩家。决定他俩其中谁因为水手能力醉酒。");
    g_wikiLine[1526] = StringToText("【工程师】：如果工程师未曾使用能力，唤醒工程师，他可以摇头不使用能力，");
    g_wikiLine[1527] = StringToText("或选择角色列表上的恶魔或爪牙角色，来执行同角色类型的这些玩家的角色变化。");
    g_wikiLine[1528] = StringToText("【传教士】：唤醒传教士，让他选择一名玩家。如果他选中了爪牙，该爪牙失去能力。");
    g_wikiLine[1529] = StringToText("在传教士入睡后通知该爪牙被传教士选中。");
    g_wikiLine[1530] = StringToText("【麻脸巫婆】：唤醒麻脸巫婆，让她选择一名玩家和角色列表上的一个角色。如果该角色不在场，");
    g_wikiLine[1531] = StringToText("则在麻脸巫婆入睡后通知该玩家角色变化。根据实际情况，可以将相关通知合并，例如玩家变成了恶魔，");
    g_wikiLine[1532] = StringToText("则在恶魔行动时一并唤醒，通知角色变化并让他执行相应行动。（调整理由：");
    g_wikiLine[1533] = StringToText("使得麻脸巫婆在创造出任意爪牙时，都能够在当晚能够立即行动，避免与原本比麻脸巫婆先行动的角色在");
    g_wikiLine[1534] = StringToText("参与麻脸巫婆的变化时，会有一天的时间不具有任何能力，从而导致非良性互动。请注意：");
    g_wikiLine[1535] = StringToText("即使麻脸巫婆的顺序改变，她的能力造成死亡的时机仍然需要等到首个能够造成死亡的恶魔角色行动之前。");
    g_wikiLine[1536] = StringToText("）");
    g_wikiLine[1537] = StringToText("【限】：在等同初始外来者数量的夜晚，所有镇民中毒。");
    g_wikiLine[1538] = StringToText("【投毒者】：唤醒投毒者，让他选择一名玩家，那名玩家中毒。");
    g_wikiLine[1539] = StringToText("【孟婆】：唤醒孟婆，他可以摇头不使用能力，或选择一名存活玩家。");
    g_wikiLine[1540] = StringToText("【蛊雕】：如果蛊雕未改变过方向，唤醒蛊雕，他可以摇头不改变方向，或点头改变方向。随后，");
    g_wikiLine[1541] = StringToText("对蛊雕展示被放置「蛊毒」提示标记玩家的角色标记。");
    g_wikiLine[1542] = StringToText("【旅店老板】：唤醒旅店老板，让他选择两名玩家。这两名玩家今晚不死，");
    g_wikiLine[1543] = StringToText("同时需要决定他俩其中谁因为旅店老板能力醉酒。");
    g_wikiLine[1544] = StringToText("【侍臣】：如果侍臣未曾使用能力，唤醒侍臣，他可以摇头不使用能力，或选择角色列表上的一个任意角");
    g_wikiLine[1545] = StringToText("色，该角色对应的玩家之一醉酒。");
    g_wikiLine[1546] = StringToText("【巫师】：如果有必要，让巫师的能力生效。");
    g_wikiLine[1547] = StringToText("【打更人】：唤醒打更人，让他进行猜测，并放置提示标记到对应玩家旁。");
    g_wikiLine[1548] = StringToText("【锦衣卫】：唤醒锦衣卫，让他选择一名玩家。他现在开始保护那名玩家。");
    g_wikiLine[1549] = StringToText("【狸猫】：唤醒狸猫，让他选择一名玩家。如果这名玩家是善良角色且在当晚被邪恶角色能力杀死，");
    g_wikiLine[1550] = StringToText("狸猫与他交换角色。");
    g_wikiLine[1551] = StringToText("【巡察】：唤醒巡察，让他选择角色列表上的两个善良角色的图标。如果对应的两名玩家都存活，");
    g_wikiLine[1552] = StringToText("他们今晚不死。");
    g_wikiLine[1553] = StringToText("【赌徒】：唤醒赌徒，让他进行猜测。如果猜测错误，他死亡。");
    g_wikiLine[1554] = StringToText("【杂技演员】：唤醒杂技演员，让他选择一名玩家。如果当晚这名玩家醉酒或中毒，杂技演员死亡。");
    g_wikiLine[1555] = StringToText("【舞蛇人】：唤醒舞蛇人，让他选择一名存活玩家。如果选中恶魔则执行角色和阵营的交换，");
    g_wikiLine[1556] = StringToText("并在舞蛇人入睡后通知旧恶魔角色变化。");
    g_wikiLine[1557] = StringToText("【僧侣】：唤醒僧侣，让他选择除自己以外的一名玩家，那名玩家今晚免受恶魔负面效果影响。");
    g_wikiLine[1558] = StringToText("【酿酒师】：唤醒酿酒师，让他选择角色列表上的一个镇民角色并让他给出信息。");
    g_wikiLine[1559] = StringToText("【熊孩子】：唤醒熊孩子，让他选择角色列表上的一个镇民角色，该角色会产生错误信息。");
    g_wikiLine[1560] = StringToText("【街头风琴手】：让街头风琴手选择自己是否醉酒。如果他点头，标记街头风琴手醉酒。如果他摇头，");
    g_wikiLine[1561] = StringToText("移除街头风琴手的醉酒标记。");
    g_wikiLine[1562] = StringToText("【魔鬼代言人】：唤醒魔鬼代言人，让他选择一名与上一晚不同的玩家，那名玩家处决不死。");
    g_wikiLine[1563] = StringToText("【女巫】：唤醒女巫，让她选择一名玩家，那名玩家被诅咒。");
    g_wikiLine[1564] = StringToText("【洗脑师】：唤醒洗脑师，让他选择一名玩家和角色列表上的一个善良角色，");
    g_wikiLine[1565] = StringToText("那名玩家明天需要「疯狂」证明自己是那个角色。在洗脑师入睡后通知那名玩家被洗脑。");
    g_wikiLine[1566] = StringToText("【恐惧之灵】：唤醒恐惧之灵，让他选择一名玩家，随后如果恐惧之灵的目标发生了变更，");
    g_wikiLine[1567] = StringToText("通知所有玩家恐惧之灵选择了一名玩家。");
    g_wikiLine[1568] = StringToText("【鹰身女妖】：唤醒鹰身女妖，让她选择两名玩家，第一名玩家明天需要「疯狂」证明第二名玩家邪恶。");
    g_wikiLine[1569] = StringToText("在鹰身女妖入睡后通知第一名玩家被鹰身女妖选中。");
    g_wikiLine[1570] = StringToText("【灵言师】：如果首次有善良玩家说出了灵言师的关键词，唤醒该玩家并通知他阵营变化。");
    g_wikiLine[1571] = StringToText("【狐媚娘】：如果狐媚娘死于处决，唤醒她选择的玩家并通知他阵营变化。");
    g_wikiLine[1572] = StringToText("【逆臣】：如果逆臣或他的目标玩家，这两人之一死于处决，唤醒另一名玩家并通知他阵营变化。");
    g_wikiLine[1573] = StringToText("【入殓师】：如果入殓师的能力曾被触发，唤醒他并告知他变成了哪个恶魔角色。");
    g_wikiLine[1574] = StringToText("【红唇女郎】：如果红唇女郎的能力曾被触发，唤醒她并告知她变成了哪个恶魔角色。");
    g_wikiLine[1575] = StringToText("【召唤师】：如果这是游戏中的第三个夜晚，唤醒召唤师，让他选择一名玩家和一个恶魔角色，");
    g_wikiLine[1576] = StringToText("那名玩家变成由他选择的邪恶恶魔。");
    g_wikiLine[1577] = StringToText("【疯子】：如果疯子以为的恶魔会在当晚行动，唤醒疯子，并让他以恶魔的方式行动。");
    g_wikiLine[1578] = StringToText("【驱魔人】：唤醒驱魔人，让他选择一名与上一晚不同的玩家。如果他选中了恶魔，");
    g_wikiLine[1579] = StringToText("则在驱魔人入睡后通知该恶魔谁是驱魔人。");
    g_wikiLine[1580] = StringToText("【道士】：唤醒道士，让他选择一名玩家。如果该玩家是恶魔，道士死亡，该玩家醉酒。");
    g_wikiLine[1581] = StringToText("【半兽人】：唤醒半兽人，让他选择一名玩家。如果该玩家是善良玩家，该玩家死亡，");
    g_wikiLine[1582] = StringToText("且当晚恶魔不会造成死亡。");
    g_wikiLine[1583] = StringToText("【公主】：如果公主在今天白天提名并处决了一名玩家，当晚恶魔不会造成死亡。");
    g_wikiLine[1584] = StringToText("【军团】：决定今晚谁会因为军团能力死亡。");
    g_wikiLine[1585] = StringToText("【小恶魔】：唤醒小恶魔，让他攻击一名玩家。如果他成功自杀，则在他入睡后通知一名爪牙角色变化。");
    g_wikiLine[1586] = StringToText("【僵怖】：如果白天无人死亡，唤醒僵怖，让他攻击一名玩家。");
    g_wikiLine[1587] = StringToText("【普卡】：唤醒普卡，让他选择一名玩家，该玩家中毒。上一个被普卡中毒的玩家死亡。");
    g_wikiLine[1588] = StringToText("【沙巴洛斯】：决定上一夜被沙巴洛斯选择的玩家是否被反刍。然后唤醒沙巴洛斯，让他攻击两名玩家。");
    g_wikiLine[1589] = StringToText("【珀】：唤醒珀，他可以攻击一名玩家或不进行攻击，如果他上一次选择了不进行攻击，");
    g_wikiLine[1590] = StringToText("则此次必须攻击三名玩家。");
    g_wikiLine[1591] = StringToText("【方古】：唤醒方古，让他攻击一名玩家。如果该玩家是外来者并成功转化，则方古死亡，");
    g_wikiLine[1592] = StringToText("在他入睡后通知那名外来者角色变化。");
    g_wikiLine[1593] = StringToText("【诺-达鲺】：唤醒诺-达鲺，让他攻击一名玩家。");
    g_wikiLine[1594] = StringToText("【涡流】：唤醒涡流，让他攻击一名玩家。");
    g_wikiLine[1595] = StringToText("【亡骨魔】：唤醒亡骨魔，让他攻击一名玩家。");
    g_wikiLine[1596] = StringToText("【奥赫】：唤醒奥赫，让他选择角色列表上的一个角色。该角色对应的玩家死亡，如果该角色不在场，");
    g_wikiLine[1597] = StringToText("替奥赫决定今晚谁会因为奥赫能力死亡。");
    g_wikiLine[1598] = StringToText("【堤丰之首】：唤醒堤丰之首，让他攻击一名玩家。");
    g_wikiLine[1599] = StringToText("【哈迪寂亚】：唤醒哈迪寂亚，让他选择三名玩家。执行哈迪寂亚的能力流程（参考哈迪寂亚的百科页面）");
    g_wikiLine[1600] = StringToText("。");
    g_wikiLine[1601] = StringToText("【痢蛭】：唤醒痢蛭，让他攻击一名玩家。");
    g_wikiLine[1602] = StringToText("【小怪宝】：唤醒所有爪牙选择由谁照看小怪宝。随后，决定今晚谁会因为小怪宝能力死亡。");
    g_wikiLine[1603] = StringToText("【牙噶巴卜】：根据已放置的提示标记数量，选择最多等同于该数量的玩家死亡。");
    g_wikiLine[1604] = StringToText("该夜晚行动只是一个提示，死亡的造成时机可以是白天，也可以是夜晚的任何时候。");
    g_wikiLine[1605] = StringToText("【卡扎力】：唤醒卡扎力，让他攻击一名玩家。");
    g_wikiLine[1606] = StringToText("【混沌】：唤醒混沌，让他攻击一名玩家。如果他杀死了自己邻近的镇民，所有善良玩家中毒。");
    g_wikiLine[1607] = StringToText("【穷奇】：唤醒穷奇，让他攻击一名玩家。如果今天白天有外来者死亡，他攻击并杀死的玩家成为活尸，");
    g_wikiLine[1608] = StringToText("随后决定今晚谁会因为穷奇能力死亡。");
    g_wikiLine[1609] = StringToText("【饕餮】：唤醒饕餮，让他选择任意数量的非旅行者玩家或一名旅行者玩家。如果这些玩家角色类型不同，");
    g_wikiLine[1610] = StringToText("他们死亡。");
    g_wikiLine[1611] = StringToText("【梼杌】：唤醒梼杌，让他攻击一名玩家。");
    g_wikiLine[1612] = StringToText("【暴君】：唤醒暴君，让他攻击一名玩家。如果他杀死了与爪牙邻近的玩家，");
    g_wikiLine[1613] = StringToText("那么他下个夜晚可以攻击最多两名玩家。");
    g_wikiLine[1614] = StringToText("【姑获鸟】：唤醒姑获鸟，让他攻击一名玩家。");
    g_wikiLine[1615] = StringToText("【奸佞】：唤醒奸佞，让他攻击一名玩家。随后，唤醒被标记「爪牙死亡」的玩家，让他攻击一名玩家。");
    g_wikiLine[1616] = StringToText("【典狱长】：唤醒典狱长，让他选择至多三名玩家。根据上个夜晚被典狱长选择的玩家中是否有玩家死于");
    g_wikiLine[1617] = StringToText("处决来决定谁死亡。");
    g_wikiLine[1618] = StringToText("【书生】：如果恶魔猜中了书生，让恶魔选择一名玩家，该玩家死亡。");
    g_wikiLine[1619] = StringToText("【刺客】：如果刺客未曾使用能力，唤醒刺客，他可以摇头不使用能力，或选择攻击一名玩家。");
    g_wikiLine[1620] = StringToText("【教父】：如果今天白天有外来者死亡，唤醒教父，让他攻击一名玩家。");
    g_wikiLine[1621] = StringToText("【养蛊人】：今天白天提名了存活的养蛊人的玩家死亡。");
    g_wikiLine[1622] = StringToText("【歌伶】：如果歌伶今天白天使用了自己的能力且恶魔成为了观众，歌伶死亡。");
    g_wikiLine[1623] = StringToText("【鸩】：如果鸩未曾使用能力，唤醒鸩，他可以摇头不使用能力，或选择一个镇民角色。");
    g_wikiLine[1624] = StringToText("【造谣者】：如果造谣者今天白天的声明正确，一名玩家死亡。（调整理由：会造成死亡的能力效果，");
    g_wikiLine[1625] = StringToText("放在死亡触发能力效果之前，避免错过了死亡触发能力的最终提示时机。注：根据规则，");
    g_wikiLine[1626] = StringToText("死亡触发能力的夜晚顺序并不重要，仅作为能力遗漏触发时的提示，下同。）");
    g_wikiLine[1627] = StringToText("【修补匠】：在夜晚的任意时机，你都可以决定杀死修补匠。这里只是一个提示以免遗忘修补匠。");
    g_wikiLine[1628] = StringToText("（调整理由：会造成死亡的能力效果，放在死亡触发能力效果之前，避免错过了死亡触发能力的最终提示");
    g_wikiLine[1629] = StringToText("时机。）");
    g_wikiLine[1630] = StringToText("【月之子】：如果月之子在今天白天的时候使用自己的能力选择了一名善良玩家，那名玩家死亡。");
    g_wikiLine[1631] = StringToText("（调整理由：会造成死亡的能力效果，放在死亡触发能力效果之前，避免错过了死亡触发能力的最终提示");
    g_wikiLine[1632] = StringToText("时机。）");
    g_wikiLine[1633] = StringToText("【煞星】：如果煞星死亡，决定是否让一名与他邻近的存活玩家死亡。");
    g_wikiLine[1634] = StringToText("【祖母】：如果恶魔杀死了孙子，祖母死亡。（调整理由：为「由死亡触发能力」而触发的死亡效果，");
    g_wikiLine[1635] = StringToText("顺序提前到所有其他死亡触发能力之前。）");
    g_wikiLine[1636] = StringToText("【遗忘之门】：如果遗忘之门加入游戏，今晚有玩家死亡，向他展示「你是」信息标记，");
    g_wikiLine[1637] = StringToText("他的角色标记和阵营。");
    g_wikiLine[1638] = StringToText("【理发师】：如果理发师死于白天，唤醒恶魔让他决定是否使用理发师的能力。如果理发师死于夜晚，");
    g_wikiLine[1639] = StringToText("（如果让除攻击理发师以外的恶魔进行选择则需要等当前恶魔入睡后）让一名恶魔决定是否使用理发师的");
    g_wikiLine[1640] = StringToText("能力。");
    g_wikiLine[1641] = StringToText("【心上人】：如果心上人死亡，一名玩家醉酒。");
    g_wikiLine[1642] = StringToText("【守鸦人】：如果守鸦人死于夜晚，唤醒守鸦人，让他选择一名玩家。对他展示这名玩家的角色标记。");
    g_wikiLine[1643] = StringToText("【贤者】：如果贤者被恶魔杀死，唤醒贤者，对他指向两名玩家。其中之一是杀死贤者的恶魔。");
    g_wikiLine[1644] = StringToText("【秉笔】：如果秉笔在白天死亡，唤醒秉笔，对他指向一名善良玩家；如果秉笔在夜晚死亡，唤醒秉笔，");
    g_wikiLine[1645] = StringToText("对他指向一名邪恶玩家。");
    g_wikiLine[1646] = StringToText("【瘟疫医生】：如果瘟疫医生死亡，说书人获得一项爪牙能力。");
    g_wikiLine[1647] = StringToText("【唱诗男孩】：如果恶魔杀死了国王，唤醒唱诗男孩，对他指向恶魔。");
    g_wikiLine[1648] = StringToText("【农夫】：如果农夫死于夜晚，唤醒一名存活的善良玩家告知他角色变化。");
    g_wikiLine[1649] = StringToText("【报丧女妖】：如果恶魔杀死了报丧女妖，宣布「报丧女妖觉醒了」，并使用「具有能力」标记报丧女妖。");
    g_wikiLine[1650] = StringToText("【教授】：如果教授未曾使用能力且在城镇广场上有玩家死亡，唤醒教授，他可以摇头不使用能力，");
    g_wikiLine[1651] = StringToText("或选择一名已死亡的玩家。如果该玩家是镇民，该玩家被起死回生。");
    g_wikiLine[1652] = StringToText("【巡山人】：如果巡山人未曾使用能力，唤醒巡山人，他可以摇头不使用能力，或选择一名玩家。");
    g_wikiLine[1653] = StringToText("如果巡山人选中了落难少女，则在巡山人入睡后通知落难少女角色变化。");
    g_wikiLine[1654] = StringToText("【信息类角色行动开始】：如果是一项首夜会获取信息的能力，且在游戏中途由于角色变化或获得能力而");
    g_wikiLine[1655] = StringToText("导致该能力需要在非首夜触发，则该能力会在此时被触发。如果有多项能力在同一个夜晚被触发，");
    g_wikiLine[1656] = StringToText("则由说书人来决定这些能力的触发顺序。");
    g_wikiLine[1657] = StringToText("【共情者】：唤醒共情者，对他用手势比划数字来告知他与他邻近的存活玩家中有几人是邪恶玩家。");
    g_wikiLine[1658] = StringToText("【占卜师】：唤醒占卜师，让他选择两名玩家。以点头或摇头告知他是否选中了恶魔。");
    g_wikiLine[1659] = StringToText("【管家】：唤醒管家，让他选择一名除自己以外的玩家，那名玩家成为他的主人。");
    g_wikiLine[1660] = StringToText("【送葬者】：如果今天白天有玩家死于处决，唤醒送葬者，对他展示那名玩家的角色标记。");
    g_wikiLine[1661] = StringToText("【提刑官】：如果今天白天提刑官发起过提名，唤醒提刑官，对他展示那名玩家的角色标记。");
    g_wikiLine[1662] = StringToText("【筑梦师】：唤醒筑梦师，让他选择一名除自己以外的非旅行者玩家。对他展示一善一恶两个角色标记。");
    g_wikiLine[1663] = StringToText("【卖花女孩】：唤醒卖花女孩，以点头或摇头告知她今天白天是否有恶魔参与投票。");
    g_wikiLine[1664] = StringToText("【城镇公告员】：唤醒城镇公告员，以点头或摇头告知他今天白天是否有爪牙发起提名。");
    g_wikiLine[1665] = StringToText("【神谕者】：唤醒神谕者，对他用手势比划数字来告知他当前死亡玩家中邪恶玩家的数量。");
    g_wikiLine[1666] = StringToText("【女裁缝】：如果女裁缝未曾使用能力，唤醒女裁缝，她可以摇头不使用能力，");
    g_wikiLine[1667] = StringToText("或选择除自己以外的两名玩家。以点头或摇头告知她选择的玩家是否为同一阵营。");
    g_wikiLine[1668] = StringToText("【杂耍艺人】：如果杂耍艺人在今天白天使用了能力，唤醒杂耍艺人，对他用手势比划数字来告知他白天");
    g_wikiLine[1669] = StringToText("猜测正确的次数。");
    g_wikiLine[1670] = StringToText("【气球驾驶员】：唤醒气球驾驶员，对他指向一名玩家，这名玩家与之前气球驾驶员得知过的玩家属于不");
    g_wikiLine[1671] = StringToText("同的角色类型。");
    g_wikiLine[1672] = StringToText("【郎中】：唤醒郎中，让他指向一名玩家。对郎中展示一个与该玩家能力相关的词语。");
    g_wikiLine[1673] = StringToText("【村夫】：唤醒村夫，让他指向一名玩家，用手势告诉他那名玩家的阵营。");
    g_wikiLine[1674] = StringToText("【方士】：在对应数字的夜晚，唤醒方士，向他展示对应数量在场的角色标记。");
    g_wikiLine[1675] = StringToText("【驿使】：如果驿使进行了宣称，唤醒驿使。如果驿使被标记「是」，点头告知是；");
    g_wikiLine[1676] = StringToText("如果驿使被标记「否」，摇头告知否。");
    g_wikiLine[1677] = StringToText("【知府】：唤醒知府，以点头或摇头告知他今天白天和当晚是否有非镇民且非旅行者的玩家死亡。");
    g_wikiLine[1678] = StringToText("【国王】：如果满足国王的唤醒条件，唤醒国王，对他展示一个存活的角色标记。");
    g_wikiLine[1679] = StringToText("【赏金猎人】：如果赏金猎人之前得知的玩家死亡，唤醒赏金猎人，对他指向一名新的邪恶玩家。");
    g_wikiLine[1680] = StringToText("【守夜人】：如果守夜人未曾使用能力，唤醒守夜人，他可以摇头不使用能力，或选择一名玩家。");
    g_wikiLine[1681] = StringToText("如果守夜人选择了玩家，则在守夜人入睡后通知那名玩家谁是守夜人。");
    g_wikiLine[1682] = StringToText("【异教领袖】：如果异教领袖的阵营发生了变化，将他唤醒并通知他最新阵营。");
    g_wikiLine[1683] = StringToText("【间谍】：唤醒间谍，让他查看魔典。");
    g_wikiLine[1684] = StringToText("【女祭司】：唤醒女祭司，对她指向一名玩家。");
    g_wikiLine[1685] = StringToText("【将军】：唤醒将军，对他用手势比划当前的优势阵营。");
    g_wikiLine[1686] = StringToText("【侍女】：唤醒侍女，让她选择两名除自己以外的存活玩家。用手势比划数字来告知她这些玩家中因自己");
    g_wikiLine[1687] = StringToText("能力而唤醒的玩家数量。");
    g_wikiLine[1688] = StringToText("【引路人】：唤醒引路人，让他选择一至三名除自己以外的玩家，以点头或摇头告知他选择的玩家中是否");
    g_wikiLine[1689] = StringToText("有玩家在当晚被邪恶玩家的能力选择或影响过。");
    g_wikiLine[1690] = StringToText("【数学家】：唤醒数学家，用手势比划数字来告诉他今天有多少玩家的能力未正常生效。");
    g_wikiLine[1691] = StringToText("【暴乱】：如果这是游戏中的第三个夜晚，唤醒爪牙告知他们角色变化。");
    g_wikiLine[1692] = StringToText("【黎明】：等待数秒。让所有玩家睁眼。宣布黄昏存活但现在死亡的玩家死亡，");
    g_wikiLine[1693] = StringToText("宣布黄昏死亡但现在存活的玩家复活。");
    g_wikiLine[1694] = StringToText("【利维坦】：如果利维坦在场，告知所有人利维坦在场，现在是第几个白天。（如果玩家一致同意，");
    g_wikiLine[1695] = StringToText("则无需在已经知晓利维坦在场的前提下在其他夜晚执行此项操作。）");
    // 8 隐性规则
    g_wikiAt[8] = 1696;
    g_wikiN[8] = 47;
    g_wikiLine[1696] = StringToText("本页面内容持续更新中，汇总所有游戏中没有明确提及但作为规则处理的默认倾向，");
    g_wikiLine[1697] = StringToText("或是一些默认作为共识但未整理形成正式说明的规则。");
    g_wikiLine[1698] = StringToText("【1.同时触发】");
    g_wikiLine[1699] = StringToText("如果在同一时间多个能力同时满足触发条件，则由说书人来决定这些能力的结算顺序。");
    g_wikiLine[1700] = StringToText("但说书人应该尽可能按照更有趣而不是更混乱的方式进行结算。");
    g_wikiLine[1701] = StringToText("哲学家获得了舞蛇人的能力，且同时舞蛇人在场但醉酒。这两名玩家都会在轮到舞蛇人的夜晚顺序时被唤");
    g_wikiLine[1702] = StringToText("醒。通常来说，说书人应该优先唤醒哲学家让他行动，然后再唤醒舞蛇人，");
    g_wikiLine[1703] = StringToText("这是由于哲学家的行动可能导致哲学家发生角色交换而使得舞蛇人不再醉酒，");
    g_wikiLine[1704] = StringToText("因此舞蛇人的能力也能正常产生效果。");
    g_wikiLine[1705] = StringToText("【2.不能最大】");
    g_wikiLine[1706] = StringToText("两个能力（或规则）之间互相冲突时，如果一个能力允许做某事，而另一个能力禁止做某事，");
    g_wikiLine[1707] = StringToText("则始终以「不能」的能力生效。");
    g_wikiLine[1708] = StringToText("处决并导致场上所有恶魔死亡会让善良阵营获胜，而镜像双子的能力则会让善良阵营无法获胜。");
    g_wikiLine[1709] = StringToText("此时镜像双子的能力会生效从而导致满足善良阵营获胜条件时游戏仍然继续。");
    g_wikiLine[1710] = StringToText("弄臣等能力会造成免死效果，而刺客的能力会让「保护某人不会死亡」的能力无法产生效果，");
    g_wikiLine[1711] = StringToText("因此刺客的攻击能够杀死具有保护效果的玩家。");
    g_wikiLine[1712] = StringToText("【3.自我/循环的醉酒/中毒/失去能力】");
    g_wikiLine[1713] = StringToText("让自己中毒的能力成功生效时，自身会只保留「让自己中毒」这一条能力的「中毒效果」和「中毒结束条");
    g_wikiLine[1714] = StringToText("件」，其余的所有能力会全部失去。多个角色之间循环中毒同理，醉酒同理。");
    g_wikiLine[1715] = StringToText("普卡攻击自身，会让自己中毒，且因为中毒没有结束条件，普卡会因此永久中毒。");
    g_wikiLine[1716] = StringToText("水手让普卡醉酒，旅店老板让水手醉酒（普卡因此清醒），普卡让旅店老板中毒（水手因此清醒，");
    g_wikiLine[1717] = StringToText("同时导致普卡醉酒），这三名玩家会一同醉酒/中毒。在下一个黄昏时，水手和旅店老板造成的醉酒结束，");
    g_wikiLine[1718] = StringToText("普卡的中毒效果仍然持续，此时则只有旅店老板中毒。");
    g_wikiLine[1719] = StringToText("【4.角色唯一】");
    g_wikiLine[1720] = StringToText("相同的角色同一时间只会在场上存在最多一个。如果一项能力允许玩家改变角色，但无明确说明，");
    g_wikiLine[1721] = StringToText("则这一规则不会被打破。（无神论者例外，因为说书人打破了这一规则）");
    g_wikiLine[1722] = StringToText("工程师的能力生效后造成的角色变化，不会使变化后的这些玩家具有相同的角色。");
    g_wikiLine[1723] = StringToText("（除非变成了军团一类的角色）");
    g_wikiLine[1724] = StringToText("【5.死亡顺序】");
    g_wikiLine[1725] = StringToText("不会存在同一时间多于一名玩家死亡的情况。所有的死亡效果（至少现在来说）");
    g_wikiLine[1726] = StringToText("都是依照某个顺序让玩家依次死亡的。（痢蛭的宿主与痢蛭的先后死亡的过程中不会插入胜负条件的判断。");
    g_wikiLine[1727] = StringToText("）");
    g_wikiLine[1728] = StringToText("恶魔造成的死亡通过攻击顺序决定。流莺会先让她的目标死亡，然后再是自己死亡。");
    g_wikiLine[1729] = StringToText("【6.夜晚行动过时不候】");
    g_wikiLine[1730] = StringToText("在夜晚时，如果已经开始某个角色的能力结算，那么当晚任何新创建出来的这种角色及具有这种角色能力");
    g_wikiLine[1731] = StringToText("的角色都不会在当晚进行相应的行动。");
    g_wikiLine[1732] = StringToText("轮到小恶魔行动，小恶魔的自杀使得一名爪牙变成了小恶魔，因为夜晚行动已经结算到小恶魔，");
    g_wikiLine[1733] = StringToText("因此新的小恶魔不会在当晚行动。");
    g_wikiLine[1734] = StringToText("痢蛭杀死了理发师后，交换了自己和一名爪牙的角色，新的痢蛭【仍然】需要进行选择宿主的行动，");
    g_wikiLine[1735] = StringToText("因为痢蛭非首夜的夜晚行动中只包含「攻击一名玩家」这个部分，而痢蛭的选择宿主是进场能力，");
    g_wikiLine[1736] = StringToText("会正常被触发。");
    g_wikiLine[1737] = StringToText("【7.角色详解不考虑中毒醉酒及特殊互动】");
    g_wikiLine[1738] = StringToText("角色详解只提供角色的基本操作方式和常见案例，另外对于官方剧本角色来说，");
    g_wikiLine[1739] = StringToText("角色详解可能只会涉及剧本内的互动。因此如果在考虑中毒醉酒互动，或跨官方剧本、");
    g_wikiLine[1740] = StringToText("混合剧本中的角色互动时，请勿完全死板依照运作方式进行（指每个角色页面的「角色简介」及「运作方");
    g_wikiLine[1741] = StringToText("式」这些部分）。理解角色能力本身的逻辑，或者运用游戏理念进行问题的分析，比什么都重要。另外，");
    g_wikiLine[1742] = StringToText("如果关于某些角色的互动问题如果频繁出现，可能会将细则更新至该角色页面下的「规则详解」部分。");
    // 9 规则调整提前公示
    g_wikiAt[9] = 1743;
    g_wikiN[9] = 314;
    g_wikiLine[1743] = StringToText("基于「实验性角色」的特性，部分相关规则和相克规则可能会发生调整。这些调整在应用前会先在此页面");
    g_wikiLine[1744] = StringToText("进行公示。");
    g_wikiLine[1745] = StringToText("你也可以直接通过本页面来查询有哪些规则做出了调整。");
    g_wikiLine[1746] = StringToText("本页面所有调整均来自于Steven的设计日志，国外也会相应做出变动。（不排除存在回调的可能性。");
    g_wikiLine[1747] = StringToText("）");
    g_wikiLine[1748] = StringToText("【角色能力调整】");
    g_wikiLine[1749] = StringToText("【国王】：");
    g_wikiLine[1750] = StringToText("调整前：每个夜晚，如果死亡的玩家数量大于存活的玩家数量，你会得知一个存活的角色。");
    g_wikiLine[1751] = StringToText("恶魔知道你是国王。");
    g_wikiLine[1752] = StringToText("调整后：每个夜晚，如果死亡的玩家数量大于【或等于】存活的玩家数量，你会得知一个存活的角色。");
    g_wikiLine[1753] = StringToText("恶魔知道你是国王。");
    g_wikiLine[1754] = StringToText("【小怪宝】：");
    g_wikiLine[1755] = StringToText("调整前：每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，");
    g_wikiLine[1756] = StringToText("会有一名玩家死亡。[+1爪牙]");
    g_wikiLine[1757] = StringToText("调整后：每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，");
    g_wikiLine[1758] = StringToText("【可能】会有一名玩家死亡。[+1爪牙]");
    g_wikiLine[1759] = StringToText("【气球驾驶员】：");
    g_wikiLine[1760] = StringToText("调整前：每个夜晚，你会得知一名不同角色类型的玩家，直到场上所有的角色类型你都得知过一次。");
    g_wikiLine[1761] = StringToText("[+1 外来者]");
    g_wikiLine[1762] = StringToText("调整后：每个夜晚，你会得知一名【与上个夜晚得知的玩家角色类型不同】的玩家。");
    g_wikiLine[1763] = StringToText("[+【0~】1外来者]");
    g_wikiLine[1764] = StringToText("【瘟疫医生】：");
    g_wikiLine[1765] = StringToText("第一版：如果你死亡，说书人获得一个【不在场的】爪牙能力。");
    g_wikiLine[1766] = StringToText("第二版：【如果你死亡】，说书人会获得一个爪牙能力。");
    g_wikiLine[1767] = StringToText("调整后：【当你死亡时】，说书人会获得一个爪牙能力。");
    g_wikiLine[1768] = StringToText("【鹰身女妖】：");
    g_wikiLine[1769] = StringToText("调整前：每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，");
    g_wikiLine[1770] = StringToText("否则他们可能会死亡。");
    g_wikiLine[1771] = StringToText("调整后：每个夜晚，你要选择两名玩家：明天第一名玩家需要「疯狂」地证明第二名玩家是邪恶的，");
    g_wikiLine[1772] = StringToText("否则他们【之中】可能会【有人】死亡。");
    g_wikiLine[1773] = StringToText("【痢蛭】：");
    g_wikiLine[1774] = StringToText("调整前：每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，");
    g_wikiLine[1775] = StringToText("只有他死亡时你才会一同死亡。");
    g_wikiLine[1776] = StringToText("调整后：每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一名存活的玩家：他中毒，");
    g_wikiLine[1777] = StringToText("只有【当他处于死亡状态时你才会立即死亡】。");
    g_wikiLine[1778] = StringToText("【街头风琴手】：");
    g_wikiLine[1779] = StringToText("第一版：所有玩家在投票时闭眼，且票数会秘密统计。【对你的提名只在你投票时才会统计票数】。");
    g_wikiLine[1780] = StringToText("第二版：所有玩家在投票时闭眼，且票数会秘密统计。【每个夜晚，你要选择自己是否醉酒，");
    g_wikiLine[1781] = StringToText("直到你下次选择】。");
    g_wikiLine[1782] = StringToText("调整后：所有玩家在投票时闭眼，且票数会秘密统计。每个夜晚，你要选择自己是否醉酒【直到下个黄昏");
    g_wikiLine[1783] = StringToText("】。");
    g_wikiLine[1784] = StringToText("【杂技演员】：");
    g_wikiLine[1785] = StringToText("杂技演员角色类型变为镇民");
    g_wikiLine[1786] = StringToText("调整前：每个夜晚*，【如果与你邻近的存活善良玩家之一醉酒或中毒，你死亡】。");
    g_wikiLine[1787] = StringToText("调整后：每个夜晚*，【你要选择一名玩家：如果当晚他醉酒或中毒，你死亡】。");
    g_wikiLine[1788] = StringToText("【农夫】：");
    g_wikiLine[1789] = StringToText("调整前：【如果你在夜晚死亡】，一名存活的善良玩家会变成农夫。");
    g_wikiLine[1790] = StringToText("调整后：【当你在夜晚死亡时】，一名存活的善良玩家会变成农夫。");
    g_wikiLine[1791] = StringToText("【戏法师】：");
    g_wikiLine[1792] = StringToText("调整前：每个白天【限一次，你可以公开猜测谁是爪牙，谁是恶魔】。如果你猜对，善良阵营获胜。");
    g_wikiLine[1793] = StringToText("调整后：每个白天，【你可以公开进行一次谁是爪牙，谁是恶魔的猜测】。如果你猜对，善良阵营获胜。");
    g_wikiLine[1794] = StringToText("【炸弹人】：");
    g_wikiLine[1795] = StringToText("调整前：如果你被处决，除三名玩家以外的其他所有玩家均会死亡。【一分钟之后】，");
    g_wikiLine[1796] = StringToText("被最多玩家手指指着的玩家死亡。");
    g_wikiLine[1797] = StringToText("调整后：如果你被处决，除三名玩家以外的其他所有玩家均会死亡。【倒数十声后】，");
    g_wikiLine[1798] = StringToText("被最多玩家手指指着的玩家死亡。");
    g_wikiLine[1799] = StringToText("【半兽人】：");
    g_wikiLine[1800] = StringToText("调整前：每个夜晚*，你要选择一名存活的玩家：如果他是善良的，他死亡，");
    g_wikiLine[1801] = StringToText("【并且当晚不会再有其他玩家死亡】。");
    g_wikiLine[1802] = StringToText("调整后：每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，【并且当晚恶魔不会造成死亡。");
    g_wikiLine[1803] = StringToText("会有一名善良玩家始终被当作邪恶阵营】。");
    g_wikiLine[1804] = StringToText("【暴乱】（角色详情页待更新）：");
    g_wikiLine[1805] = StringToText("调整前：【被提名的玩家死亡，但他可以立刻再次发起提名（第三个白天他必须这么做）。");
    g_wikiLine[1806] = StringToText("在第三个白天结束时，邪恶阵营获胜。[所有爪牙都是暴乱]】");
    g_wikiLine[1807] = StringToText("调整后：【在第三个白天，所有爪牙会变成暴乱，当天被提名的玩家会立即死亡且必须再次提名一名存活");
    g_wikiLine[1808] = StringToText("的玩家】。");
    g_wikiLine[1809] = StringToText("【炼金术士】：");
    g_wikiLine[1810] = StringToText("调整前：你拥有一个【不在场的】爪牙角色的能力。");
    g_wikiLine[1811] = StringToText("调整后：你拥有一个爪牙角色的能力。【当你使用能力时，说书人可能会要求你更换选择】。");
    g_wikiLine[1812] = StringToText("【哈迪寂亚】：");
    g_wikiLine[1813] = StringToText("调整前：每个夜晚*，你【要】选择三名玩家（所有玩家都会得知你选了谁）：");
    g_wikiLine[1814] = StringToText("他们分别秘密决定自己的生死，然后如果他们都存活则都死亡。");
    g_wikiLine[1815] = StringToText("调整后：每个夜晚*，你【可以】选择三名玩家（所有玩家都会得知你选了谁）：");
    g_wikiLine[1816] = StringToText("他们分别秘密决定自己的生死，然后如果他们都存活则都死亡。");
    g_wikiLine[1817] = StringToText("【相克规则新增】");
    g_wikiLine[1818] = StringToText("召唤师与麻脸巫婆：召唤师无法创造已经在场的恶魔。如果召唤师创造了一个不在场的恶魔，");
    g_wikiLine[1819] = StringToText("当晚的死亡由说书人决定。");
    g_wikiLine[1820] = StringToText("维齐尔与政客：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_wikiLine[1821] = StringToText("召唤师与帽匠：召唤师无法创造已经在场的恶魔。如果召唤师创造了一个不在场的恶魔，");
    g_wikiLine[1822] = StringToText("当晚的死亡由说书人决定。");
    g_wikiLine[1823] = StringToText("召唤师与侍臣：如果召唤师因为侍臣的能力在第三个夜晚醉酒，由召唤师来选择创造哪种恶魔，");
    g_wikiLine[1824] = StringToText("由说书人来决定哪名玩家发生转变。");
    g_wikiLine[1825] = StringToText("召唤师与僵怖：如果召唤师将一名已死亡的玩家变成了僵怖，该玩家会变成「已经死过一次」的僵怖。");
    g_wikiLine[1826] = StringToText("召唤师与普卡：召唤师可以选择在第二个夜晚将一名玩家变成普卡。");
    g_wikiLine[1827] = StringToText("召唤师与工程师：如果工程师的能力使得召唤师在使用自己的能力前离场，");
    g_wikiLine[1828] = StringToText("召唤师会在此前立即使用自己的能力。");
    g_wikiLine[1829] = StringToText("麻脸巫婆与异教领袖：被麻脸巫婆创造的邪恶异教领袖无法因为自身能力转变为善良阵营。");
    g_wikiLine[1830] = StringToText("麻脸巫婆与莽夫：被麻脸巫婆创造的邪恶莽夫无法因为自身能力转变为善良阵营。");
    g_wikiLine[1831] = StringToText("食人族与杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，");
    g_wikiLine[1832] = StringToText("当晚食人族会替杂耍艺人得知对应的信息。");
    g_wikiLine[1833] = StringToText("哲学家与赏金猎人：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_wikiLine[1834] = StringToText("军团与吟游诗人：如果军团死于处决，所有军团保留能力，但吟游诗人可能会在当晚得知今天白天死于处");
    g_wikiLine[1835] = StringToText("决的玩家是军团。");
    g_wikiLine[1836] = StringToText("召唤师与传教士：如果召唤师在第三个夜晚或之前被传教士选中，由召唤师来选择创造哪种恶魔，");
    g_wikiLine[1837] = StringToText("由说书人来决定哪名玩家发生转变。");
    g_wikiLine[1838] = StringToText("卡扎力与士兵：卡扎力可以把士兵转变成邪恶的爪牙。");
    g_wikiLine[1839] = StringToText("食人族与罂粟种植者：如果食人族获得了罂粟种植者的能力，当他获得下一个能力时，");
    g_wikiLine[1840] = StringToText("爪牙和恶魔也会互相认识。");
    g_wikiLine[1841] = StringToText("利维坦与驱魔人：如果驱魔人存活并且成功选中过利维坦，即使有多于一名善良玩家被处决，");
    g_wikiLine[1842] = StringToText("邪恶阵营也不会获胜。");
    g_wikiLine[1843] = StringToText("利维坦与国王：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_wikiLine[1844] = StringToText("炼金术士与提线木偶：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该能力并改为提线木偶一");
    g_wikiLine[1845] = StringToText("定在场。");
    g_wikiLine[1846] = StringToText("炼金术士与主谋：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改为主谋一定不在场。");
    g_wikiLine[1847] = StringToText("炼金术士与街头风琴手：如果炼金术士获得街头风琴手的能力，街头风琴手一定在场。");
    g_wikiLine[1848] = StringToText("如果炼金术士和街头风琴手都是清醒的，改为他们都醉酒。");
    g_wikiLine[1849] = StringToText("【相克规则调整】");
    g_wikiLine[1850] = StringToText("2025年10月试运行相克现已经全面正式上线，详情请移步相克规则。");
    g_wikiLine[1851] = StringToText("间谍与落难少女：");
    g_wikiLine[1852] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1853] = StringToText("调整后：【如果间谍正在场或曾经在场，落难少女中毒。】");
    g_wikiLine[1854] = StringToText("寡妇与落难少女：");
    g_wikiLine[1855] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1856] = StringToText("调整后：【如果寡妇正在场或曾经在场，落难少女中毒。】");
    g_wikiLine[1857] = StringToText("召唤师与卡扎力：");
    g_wikiLine[1858] = StringToText("调整前：卡扎力无法创造召唤师。");
    g_wikiLine[1859] = StringToText("调整后：【召唤师无法创造已经在场的恶魔。如果召唤师创造了一个不在场的恶魔，");
    g_wikiLine[1860] = StringToText("当晚的死亡由说书人决定。】");
    g_wikiLine[1861] = StringToText("麻脸巫婆与政客：");
    g_wikiLine[1862] = StringToText("调整前：麻脸巫婆无法将一名邪恶玩家变成政客。");
    g_wikiLine[1863] = StringToText("调整后：【被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵营。】");
    g_wikiLine[1864] = StringToText("维齐尔与魔术师：");
    g_wikiLine[1865] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1866] = StringToText("调整后：【如果维齐尔和魔术师都在场，恶魔不会得知谁是爪牙。】");
    g_wikiLine[1867] = StringToText("小怪宝与魔术师：");
    g_wikiLine[1868] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1869] = StringToText("调整后：【每个夜晚，由魔术师来选择一个爪牙角色：如果他和小怪宝均存活，由他来照看小怪宝。】");
    g_wikiLine[1870] = StringToText("进阶可选规则：每个夜晚，由魔术师来选择一个爪牙角色：如果他和小怪宝均存活，由他来照看小怪宝。");
    g_wikiLine[1871] = StringToText("【否则，由魔术师来照看小怪宝，但如果魔术师在照看小怪宝时死亡，邪恶阵营获胜。】");
    g_wikiLine[1872] = StringToText("间谍与异端分子：");
    g_wikiLine[1873] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1874] = StringToText("调整后：【异端分子会被间谍当作一个不在场的外来者，异端分子会知道是哪个外来者。】");
    g_wikiLine[1875] = StringToText("寡妇与异端分子：");
    g_wikiLine[1876] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1877] = StringToText("调整后：【异端分子会被寡妇当作一个不在场的外来者，异端分子会知道是哪个外来者。】");
    g_wikiLine[1878] = StringToText("教父与异端分子：");
    g_wikiLine[1879] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1880] = StringToText("调整后：【异端分子会被教父当作一个不在场的外来者，异端分子会知道是哪个外来者。】");
    g_wikiLine[1881] = StringToText("哈迪寂亚与主谋：");
    g_wikiLine[1882] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。邪恶阵营玩家在游戏开始时知道这两者");
    g_wikiLine[1883] = StringToText("中是什么角色在场，是哪一名玩家。");
    g_wikiLine[1884] = StringToText("调整后：【如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：");
    g_wikiLine[1885] = StringToText("如果他们都选择存活，邪恶阵营获胜。否则，善良阵营获胜。】");
    g_wikiLine[1886] = StringToText("军团与传教士：");
    g_wikiLine[1887] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1888] = StringToText("调整后：【如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。】");
    g_wikiLine[1889] = StringToText("提线木偶与气球驾驶员：");
    g_wikiLine[1890] = StringToText("调整前：如果提线木偶抽到了气球驾驶员，也会+1外来者。");
    g_wikiLine[1891] = StringToText("调整后：如果提线木偶抽到了气球驾驶员，也【可能】会+1外来者。");
    g_wikiLine[1892] = StringToText("卡扎力与莽夫：");
    g_wikiLine[1893] = StringToText("调整前：如果卡扎力在选择爪牙时选择了莽夫，接下来的爪牙转变由说书人来做出决定。");
    g_wikiLine[1894] = StringToText("调整后：【卡扎力可以把莽夫变成邪恶的爪牙。】");
    g_wikiLine[1895] = StringToText("炼金术士与寡妇/间谍：");
    g_wikiLine[1896] = StringToText("第一版：炼金术士无法获得寡妇/间谍的能力。");
    g_wikiLine[1897] = StringToText("第二版：");
    g_wikiLine[1898] = StringToText("【如果炼金术士获得了寡妇的能力，他无法查看魔典。】");
    g_wikiLine[1899] = StringToText("【如果炼金术士获得了间谍的能力，他无法查看魔典，并且间谍不能被当作善良阵营、");
    g_wikiLine[1900] = StringToText("镇民角色或外来者角色。】");
    g_wikiLine[1901] = StringToText("调整后：");
    g_wikiLine[1902] = StringToText("【如果炼金术士本应获得寡妇/间谍的能力，那么他不会拥有该能力并改为寡妇/间谍一定在场。");
    g_wikiLine[1903] = StringToText("每个白天发生处决后，存活的炼金术士可以公开猜测一名存活玩家是寡妇/间谍：如果猜对了，");
    g_wikiLine[1904] = StringToText("恶魔今晚必须选择寡妇/间谍。】");
    g_wikiLine[1905] = StringToText("暴乱与驱魔人：");
    g_wikiLine[1906] = StringToText("调整前：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_wikiLine[1907] = StringToText("调整后：【如果驱魔人在第三个夜晚选中了暴乱，爪牙不会变成暴乱。】");
    g_wikiLine[1908] = StringToText("暴乱与农夫/守鸦人/贤者：");
    g_wikiLine[1909] = StringToText("调整前：如果暴乱提名并杀死了农夫/守鸦人/贤者，当晚会有一名存活的善良玩家变成农夫/守鸦人会");
    g_wikiLine[1910] = StringToText("被唤醒并使用其能力/贤者会被唤醒并使用其能力。");
    g_wikiLine[1911] = StringToText("调整后：【每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_wikiLine[1912] = StringToText("如果农夫/守鸦人/贤者被选择，他的能力生效但不会死亡。】（建议在暴乱选择农夫/守鸦人/贤者并");
    g_wikiLine[1913] = StringToText("触发这些角色的能力后，这些角色失去能力）");
    g_wikiLine[1914] = StringToText("暴乱与祖母：");
    g_wikiLine[1915] = StringToText("调整前：如果暴乱提名并杀死了孙子，祖母会一同死亡。");
    g_wikiLine[1916] = StringToText("调整后：【如果暴乱在场，孙子在白天死亡，祖母会一同死亡。】");
    g_wikiLine[1917] = StringToText("暴乱与旅店老板/僧侣/士兵：");
    g_wikiLine[1918] = StringToText("调整前：如果暴乱提名了一名前一晚曾被旅店老板/僧侣成功保护的玩家、士兵，那名玩家不会死亡。");
    g_wikiLine[1919] = StringToText("调整后：【如果暴乱在场，旅店老板/僧侣保护的玩家、士兵免疫所有邪恶阵营的负面效果。】");
    g_wikiLine[1920] = StringToText("暴乱与镇长：");
