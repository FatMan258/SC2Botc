    g_tipLine[733] = StringToText("【角色简介】");
    g_tipLine[734] = TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("能秘密地在墓地中保持存活。");
    g_tipLine[735] = StringToText("当") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("因任何原因死亡后，他会保持存活状态，但说书人会表现得如同") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("死亡了一样");
    g_tipLine[736] = StringToText("。") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("第二次死亡时，才会真正地死亡，且") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipLine[737] = StringToText("看似死亡的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("在绝大多数情况下都算作已死亡。该玩家在城镇广场的生命标记会翻面");
    g_tipLine[738] = StringToText("以标识死亡。下一次该玩家投票时，会失去投票标记。该玩家不能发起提名，该玩家可");
    g_tipLine[739] = StringToText("以在有巫毒师的情况下投票，该玩家不算作") + TextWithColor(StringToText("茶艺师"), Color(0, 191, 255)) + StringToText("的存活邻近玩家，等等。不同之处是");
    g_tipLine[740] = StringToText("游戏还会继续，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("仍然能发起攻击，且游戏会在只剩两名其他存活玩家的情况下继续");
    g_tipLine[741] = StringToText("进行。");
    g_tipLine[742] = StringToText("如果无人在白天死亡，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("才会在夜晚被唤醒并发起攻击。如果一名已死亡的玩家被处");
    g_tipLine[743] = StringToText("决，该玩家无法再次死亡，因此") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("仍然会被唤醒。");
    g_tipLine[744] = StringToText("如果一个") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("死亡，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。如果一个「死亡」的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128));
    g_tipLine[745] = StringToText("，不要宣布该玩家存活。");
    g_tipLine[746] = StringToText("【规则细节】");
    g_tipLine[747] = StringToText("相克规则：");
    g_tipLine[748] = StringToText("召唤师");
    g_tipLine[749] = StringToText("：如果召唤师将一名已死亡的玩家变成了") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("，该玩家会变成「已经死过一次」的") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0));
    g_tipLine[750] = StringToText("。");
    g_tipLine[751] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[752] = StringToText("戏子");
    g_tipLine[753] = StringToText("：在戏子存在于剧本中时，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要死亡」");
    g_tipLine[754] = StringToText("。无论") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("是否触发过「假死」，当晚") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("会变为死亡状态。");
    g_tipLine[755] = StringToText("戏子（改）");
    g_tipLine[756] = StringToText("：在戏子（改）存在于剧本中时，") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要");
    g_tipLine[757] = StringToText("死亡」。无论") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("是否触发过「假死」，当晚") + TextWithColor(StringToText("僵怖"), Color(255, 0, 0)) + StringToText("会变为死亡状态。");
    g_tipRoleAt[43] = 730;    // 僵怖
    g_tipRoleN[43] = 28;
    g_tipLine[758] = StringToText("【角色能力】");
    g_tipLine[759] = StringToText("每个夜晚，你要选择一名玩家：他") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。");
    g_tipLine[760] = StringToText("上个因你的能力") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的玩家会死亡并恢复健康。");
    g_tipLine[761] = StringToText("【角色简介】");
    g_tipLine[762] = TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("能让他的受害者") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，并在之后毒发身亡。");
    g_tipLine[763] = StringToText("当") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("攻击时，他的受害者会立即") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。在下一个夜晚，该名玩家会在") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("发起下一次");
    g_tipLine[764] = StringToText("攻击之后的时间点死亡。");
    g_tipLine[765] = StringToText("不同于其他") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("在首个夜晚就会行动。");
    g_tipLine[766] = TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("能防止") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("被唤醒来使玩家") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("。") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("能防止") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("杀死已经") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("的玩家，随");
    g_tipLine[767] = StringToText("后该玩家会恢复健康。");
    g_tipLine[768] = StringToText("如果") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("状态的") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("选择了一名玩家，该玩家不会") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，也不会在下一个夜晚死亡。");
    g_tipLine[769] = StringToText("如果") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("在上一个夜晚选择玩家时是清醒的，但是当晚") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("了，该玩家不会死亡。但是");
    g_tipLine[770] = StringToText("当") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("恢复清醒，") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("效果会恢复，且会在随后的夜晚杀死该玩家。");
    g_tipLine[771] = StringToText("【规则细节】");
    g_tipLine[772] = StringToText("相克规则：");
    g_tipLine[773] = StringToText("召唤师");
    g_tipLine[774] = StringToText("：召唤师可以在第二个夜晚召唤") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("来替代第三个夜晚的召唤。");
    g_tipLine[775] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[776] = StringToText("戏子");
    g_tipLine[777] = StringToText("：在戏子存在于剧本中时，") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要死亡」");
    g_tipLine[778] = StringToText("。说书人会在当晚杀死这名玩家。");
    g_tipLine[779] = StringToText("戏子（改）");
    g_tipLine[780] = StringToText("：在戏子（改）存在于剧本中时，") + TextWithColor(StringToText("普卡"), Color(255, 0, 0)) + StringToText("可以在游戏中任意时候向说书人示意自己「想要");
    g_tipLine[781] = StringToText("死亡」。说书人会在当晚杀死这名玩家。");
    g_tipRoleAt[44] = 758;    // 普卡
    g_tipRoleN[44] = 24;
    g_tipLine[782] = StringToText("【角色能力】");
    g_tipLine[783] = StringToText("每个夜晚*，你要选择两名玩家：他们死亡。");
    g_tipLine[784] = StringToText("你上个夜晚选择过且当前死亡的玩家之一可能会被你反刍。");
    g_tipLine[785] = StringToText("【角色简介】");
    g_tipLine[786] = TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("每个夜晚能够吞食两名玩家，但是可能会在下一个夜晚将其中一名吐出来。");
    g_tipLine[787] = StringToText("不同于其他") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，") + TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("每个夜晚会攻击两次。在攻击后的下一个夜晚，说书人可以");
    g_tipLine[788] = StringToText("决定让") + TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("攻击过的两名玩家其中之一重获新生。");
    g_tipLine[789] = StringToText("被复活的玩家可以是在存活状态下被") + TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("攻击的玩家，也可以是在死亡状态下被沙");
    g_tipLine[790] = StringToText("巴洛斯攻击的玩家。");
    g_tipLine[791] = StringToText("因反刍而复活的玩家重新获得自己的能力，即使是已经使用过的「每局游戏限一次」的");
    g_tipLine[792] = StringToText("能力也会重新获得。如果有「在你的首个夜晚」的能力，玩家可以再次使用该能力。");
    g_tipLine[793] = StringToText("【规则细节】");
    g_tipLine[794] = StringToText("关于") + TextWithColor(StringToText("沙巴洛斯"), Color(255, 0, 0)) + StringToText("造成的反刍所带来的首夜能力使用时机的疑问：在这三个官方剧本中，角");
    g_tipLine[795] = StringToText("色详解通常只用于解决剧本内的一些互动方式，如果将角色互动拉到全角色和混合剧本");
    g_tipLine[796] = StringToText("的维度，则需要使用到统一的规则。在黯月初升中，因为只会至多有一名") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("在场，并");
    g_tipLine[797] = StringToText("且") + TextWithColor(StringToText("爪牙"), Color(255,69,0)) + StringToText("发起攻击的情形不太常见，所以在大部分情况下，你可以让反刍的角色在沙巴洛");
    g_tipLine[798] = StringToText("斯的行动结束后立即行动。然而如果是混合剧本，则需要综合考虑，选择更准确的，不");
    g_tipLine[799] = StringToText("会出错的处理方式进行游戏的主持。");
    g_tipRoleAt[45] = 782;    // 沙巴洛斯
    g_tipRoleN[45] = 18;
    g_tipLine[800] = StringToText("【角色能力】");
    g_tipLine[801] = StringToText("每个夜晚*，你可以选择一名玩家：他死亡。");
    g_tipLine[802] = StringToText("如果你上次选择时没有选择任何玩家，当晚你要选择三名玩家：他们死亡。");
    g_tipLine[803] = StringToText("【角色简介】");
    g_tipLine[804] = TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("能选择在夜晚不发起攻击，但会在下一夜疯狂杀戮。");
    g_tipLine[805] = StringToText("如同其他的") + TextWithColor(StringToText("恶魔"), Color(255,0,0)) + StringToText("，") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("可以在每晚攻击一名玩家。然而，如果") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("不选择任何人，那么在下");
    g_tipLine[806] = StringToText("个夜晚") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("可以攻击三名玩家。");
    g_tipLine[807] = StringToText("如果") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("在上一个夜晚不选择任何人时处于") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("，当晚") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("仍然能够选择三名玩家。");
    g_tipLine[808] = StringToText("当要求") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("选择三名玩家时，他必须要选择。") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("不能再次不选择任何人。");
    g_tipLine[809] = StringToText("只有当") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("不选择任何人，才能得到三次攻击的机会。如果") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("在上一次进行选择时攻击了");
    g_tipLine[810] = StringToText("某人但该玩家没有死亡，") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("也不会获得三次攻击的机会。");
    g_tipLine[811] = TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("在首个夜晚不行动，但这不算作") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("「没有选择」。");
    g_tipLine[812] = StringToText("如果") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择了") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("，") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("不会行动，但是这并不算作") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("「没有选择任何人」。然而，如");
    g_tipLine[813] = StringToText("果") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("在") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择他的前一夜就没有选择任何人，那么在") + TextWithColor(StringToText("驱魔人"), Color(0, 191, 255)) + StringToText("选择") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("的下一夜，") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("能");
    g_tipLine[814] = StringToText("够选择三名玩家，因为") + TextWithColor(StringToText("珀"), Color(255, 0, 0)) + StringToText("在上一次选择时没有选择任何人。");
    g_tipRoleAt[46] = 800;    // 珀
    g_tipRoleN[46] = 15;
    // ---- 梦殒春宵（板子 3）+ 瓦釜雷鸣（板子 4）4 个新角色：角色提示面板文案 ----
    //   来源 = 钟楼百科各角色页的【角色能力 / 角色简介 / 规则细节】原文（用户 2026-09-23 要求照抄）。
    //   加工只有三步：① 按标点切成不超过 38 个字一行（星际的列表不自动换行）；
    //   ② 线下游玩相关的建议整行丢掉；③ 弯引号 / 直引号统一换成「」，去掉 [n] 这类脚注记号。
    //   这里只写纯文本，关键词的颜色由 BOTC_KeyColor 自动加。
    g_tipLine[815] = StringToText("【角色能力】");
    g_tipLine[816] = StringToText("在你的首个夜晚，你会得知恶魔与爪牙之间最近的距离。（邻座的玩家距离为1）");
    g_tipLine[817] = StringToText("【角色简介】");
    g_tipLine[818] = StringToText("钟表匠能得知恶魔与爪牙之间最近的距离。");
    g_tipLine[819] = StringToText("钟表匠只在第一个夜晚得知该信息。");
    g_tipLine[820] = StringToText("距离指代恶魔与爪牙之间坐着的玩家数量，从恶魔旁边的玩家开始，到最近的爪牙结束，");
    g_tipLine[821] = StringToText("顺时针或逆时针均可。");
    g_tipLine[822] = StringToText("【规则细节】");
    g_tipLine[823] = StringToText("当钟表匠即将被唤醒之前，说书人会根据当前场上的情况给出实时的信息。这意味着钟表匠得知的信息可");
    g_tipLine[824] = StringToText("能会与游戏初始时的情况有所不同，因为有一些角色的能力能够在游戏的过程中改变玩家的角色（如麻脸");
    g_tipLine[825] = StringToText("巫婆和理发师等）。");
    g_tipLine[826] = StringToText("钟表匠在获得信息时，说书人需要每次抽取两名玩家（其中一名为恶魔，另一名为爪牙，");
    g_tipLine[827] = StringToText("必须是两名不同的玩家）进行距离计算，直到将场上所有的「恶魔-爪牙」组合遍历完毕。");
    g_tipLine[828] = StringToText("这一过程类似于厨师，会进行多次判断，因此某些角色可能会在不同的玩家组合中被当作为不同的结果（");
    g_tipLine[829] = StringToText("如间谍、陌客、照看小怪宝的爪牙等）。最后，说书人会将这些距离值中的最小值作为信息提供给钟表匠。");
    g_tipLine[830] = StringToText("在计算距离时，距离值等同于：恶魔与爪牙这两名玩家之间的玩家数量+1。");
    g_tipLine[831] = StringToText("因此，钟表匠能得知的最小数字为「1」。（然而，在极端情况下，如果场上缺乏某种类型的角色，");
    g_tipLine[832] = StringToText("如无恶魔或无爪牙的时候，钟表匠会得知「0」。）");
    g_tipLine[833] = StringToText("在抽取两名玩家的组合时，即使是已死亡的玩家也依然会被钟表匠进行探查。");
    g_tipLine[834] = StringToText("相克规则：");
    g_tipLine[835] = StringToText("召唤师：召唤师会被钟表匠当作恶魔。");
    g_tipRoleAt[47] = 5225;   g_tipRoleN[47] = 21;
    g_tipLine[836] = StringToText("【角色能力】");
    g_tipLine[837] = StringToText("每个夜晚，你要选择除你及旅行者以外的一名玩家：你会得知一个善良角色和一个邪恶角色，");
    g_tipLine[838] = StringToText("该玩家是其中一个角色。");
    g_tipLine[839] = StringToText("【角色简介】");
    g_tipLine[840] = StringToText("筑梦师能得知一名玩家可能对应的角色，但不能确认哪个是正确的。");
    g_tipLine[841] = StringToText("每个夜晚，筑梦师需要选择一名其他玩家，并得知一个善良角色与一个邪恶角色，");
    g_tipLine[842] = StringToText("其中一个是那名玩家的真实角色。");
    g_tipLine[843] = StringToText("筑梦师得知的错误角色标记取决于所选玩家的真正的角色类型。如果筑梦师选择的玩家是镇民或外来者，");
    g_tipLine[844] = StringToText("对应的错误的邪恶角色可以是爪牙或恶魔。如果筑梦师选择的玩家是爪牙或恶魔，");
    g_tipLine[845] = StringToText("对应的错误的善良角色可以是镇民或外来者。");
    g_tipLine[846] = StringToText("筑梦师不能选择自己和旅行者作为目标。");
    g_tipRoleAt[48] = 7118;   g_tipRoleN[48] = 18;
    g_tipLine[847] = StringToText("【角色能力】");
    g_tipLine[848] = StringToText("每个夜晚，你要选择一名存活的玩家：如果你选中了恶魔，你和他交换角色和阵营，然后他中毒。");
    g_tipLine[849] = StringToText("【角色简介】");
    g_tipLine[850] = StringToText("舞蛇人会得知哪些玩家不是恶魔……但是如果舞蛇人太过于冒失或贪婪，自己就会成为恶魔。");
    g_tipLine[851] = StringToText("每个夜晚，舞蛇人需要选择一名存活玩家。如果那名玩家不是恶魔，无事发生。");
    g_tipLine[852] = StringToText("当选中一名恶魔时，舞蛇人变成那个恶魔并转为邪恶，那名恶魔则转为善良并永久中毒。");
    g_tipLine[853] = StringToText("如果具有舞蛇人能力的哲学家选中了恶魔玩家并变成了新的恶魔，原本的恶魔会变成中毒的哲学家。");
    g_tipLine[854] = StringToText("【规则细节】");
    g_tipLine[855] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[856] = StringToText("梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_tipRoleAt[49] = 5257;   g_tipRoleN[49] = 10;
    g_tipLine[857] = StringToText("【角色能力】");
    g_tipLine[858] = StringToText("每个夜晚，你会得知有多少名玩家的能力因为其他角色的能力而未正常生效。");
    g_tipLine[859] = StringToText("（从上个黎明到你被唤醒时）");
    g_tipLine[860] = StringToText("【角色简介】");
    g_tipLine[861] = StringToText("数学家会得知从黎明开始，有多少事情「出错了」。");
    g_tipLine[862] = StringToText("当一个角色的能力受到其他角色的影响而无法按预期方式发挥作用时，数学家会得知这些异常的发生。");
    g_tipLine[863] = StringToText("如果由于其他角色的影响使得一名玩家获得一条本应正确，实则错误的信息时，");
    g_tipLine[864] = StringToText("或者本应产生效果的角色能力没有生效时，数学家就会得知这些情况。");
    g_tipLine[865] = StringToText("数学家不会得知异常发生在哪名玩家身上，只会得知异常在多少名玩家身上发生了。");
    g_tipLine[866] = StringToText("数学家的能力不会检测数学家自身是否未正常生效。");
    g_tipLine[867] = StringToText("数学家不会检测中毒和醉酒这些状态本身，而是检测因为中毒和醉酒而导致的没有按照预期发挥作用的能");
    g_tipLine[868] = StringToText("力。陌客被厨师当作了邪恶玩家，中毒的士兵被小恶魔杀死，此类情况会被数学家检测到。");
    g_tipLine[869] = StringToText("中毒的共情者获取了正确信息则不会被检测到。");
    g_tipLine[870] = StringToText("【规则细节】");
    g_tipLine[871] = StringToText("相克规则：");
    g_tipLine[872] = StringToText("侍女：侍女会得知数学家是否醒来，即使她是在数学家之前醒来。");
    g_tipLine[873] = StringToText("疯子：数学家会得知疯子是否攻击了与真正的恶魔不同的目标。");
    g_tipLine[874] = StringToText("酒鬼：数学家会得知酒鬼产生了错误信息或「能力未正常生效」。");
    g_tipLine[875] = StringToText("提线木偶：数学家会得知提线木偶产生了错误信息或「能力未正常生效」。");
    g_tipLine[876] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[877] = StringToText("悟道者：数学家会得知悟道者产生了错误信息或「能力未正常生效」。");
    g_tipLine[878] = StringToText("引路人：引路人会得知数学家是否被影响，即使他是在数学家之前醒来。");
    g_tipRoleAt[50] = 5267;   g_tipRoleN[50] = 21;
    g_tipLine[879] = StringToText("【角色能力】");
    g_tipLine[880] = StringToText("每个夜晚*，你会得知在今天白天时是否有恶魔投过票。");
    g_tipLine[881] = StringToText("【角色简介】");
    g_tipLine[882] = StringToText("卖花女孩会得知恶魔是否参与了投票。");
    g_tipLine[883] = StringToText("无论被提名的玩家是否被处决，恶魔的投票都会被卖花女孩计算在内。");
    g_tipLine[884] = StringToText("卖花女孩的能力不会检测到恶魔玩家因为其他的原因而举手表决。例如恶魔玩家举手「投票」选择晚餐吃");
    g_tipLine[885] = StringToText("什么，或者恶魔玩家举手赞成流放旅行者，都不会被卖花女孩的能力检测到。");
    g_tipLine[886] = StringToText("如果在原恶魔投票之后，卖花女孩得知该信息之前，恶魔玩家发生了改变，卖花女孩的能力还是会检测到");
    g_tipLine[887] = StringToText("原恶魔是否投票。");
    g_tipLine[888] = StringToText("如果有两名或更多的恶魔玩家在场，卖花女孩的能力都会检测他们当中是否有任一恶魔投票，");
    g_tipLine[889] = StringToText("即使那些死去的恶魔也能检测到。哪怕只有一名恶魔玩家投票，卖花女孩得知的信息都是「是」。");
    g_tipRoleAt[51] = 5288;   g_tipRoleN[51] = 13;
    g_tipLine[890] = StringToText("【角色能力】");
    g_tipLine[891] = StringToText("每个夜晚*，你会得知在今天白天时是否有爪牙发起过提名。");
    g_tipLine[892] = StringToText("【角色简介】");
    g_tipLine[893] = StringToText("城镇公告员得知爪牙是否提名。");
    g_tipLine[894] = StringToText("每个夜晚，城镇公告员都会得知「是」或「否」。");
    g_tipLine[895] = StringToText("他不会得知哪些玩家是爪牙或有多少爪牙进行了提名，只会得知今天白天是否有爪牙发起了提名。");
    g_tipRoleAt[52] = 5301;   g_tipRoleN[52] = 8;
    g_tipLine[896] = StringToText("【角色能力】");
    g_tipLine[897] = StringToText("每个夜晚*，你会得知有多少名死亡的玩家是邪恶的。");
    g_tipLine[898] = StringToText("【角色简介】");
    g_tipLine[899] = StringToText("神谕者会得知有多少死亡玩家是邪恶的。");
    g_tipLine[900] = StringToText("由于神谕者每晚在恶魔之后行动，所以神谕者的信息以当晚黎明时的状态为基准，");
    g_tipLine[901] = StringToText("他得知的是在所有玩家都睁开眼睛时，死亡的邪恶玩家数量。");
    g_tipLine[902] = StringToText("神谕者能力能检测死去的爪牙和恶魔，以及任何属于邪恶阵营的玩家。例如邪恶的旅行者，");
    g_tipLine[903] = StringToText("或者变得邪恶的镇民或外来者。");
    g_tipLine[904] = StringToText("在计算死亡玩家的数量时，请记住计算在魔典中倒置的镇民和外来者角色标记，");
    g_tipLine[905] = StringToText("因为这意味着他们现在属于邪恶阵营。");
    g_tipRoleAt[53] = 7136;   g_tipRoleN[53] = 13;
    g_tipLine[906] = StringToText("【角色能力】");
    g_tipLine[907] = StringToText("每个白天，你可以私下询问说书人以得知两条信息：一个是正确的，一个是错误的。");
    g_tipLine[908] = StringToText("【角色简介】");
    g_tipLine[909] = StringToText("博学者能得知惊人的信息，每一个白天，甚至每一局游戏里他能得到的信息都不会相同，");
    g_tipLine[910] = StringToText("但其中一半是错误的。");
    g_tipLine[911] = StringToText("每个白天，说书人选择两条信息提供给博学者……发挥创造力！一条必须是正确的，");
    g_tipLine[912] = StringToText("一条必须是错误的，博学者不知道哪条对哪条错。");
    g_tipLine[913] = StringToText("是否与说书人交谈取决于博学者而非说书人。博学者从说书人处获取信息不是公开交流，");
    g_tipLine[914] = StringToText("因此其他玩家不能旁听。博学者会秘密地获取信息。");
    g_tipLine[915] = StringToText("博学者可以选择不从说书人那里获取信息，如果他愿意的话。");
    g_tipLine[916] = StringToText("醉酒或中毒的博学者可能会得到两条正确信息或两条错误信息。");
    g_tipLine[917] = StringToText("【规则细节】");
    g_tipLine[918] = StringToText("博学者在中文社区内的「谜题」式信息方式引起了设计师的兴趣，对于「是否应该给博学者提供谜题类信");
    g_tipLine[919] = StringToText("息」，设计师的回复如下（原文翻译）：「从规则上来讲，给出这样的信息是不允许的，");
    g_tipLine[920] = StringToText("因为这种含糊不清的内容并不能算是「正确」或是「错误」的信息。然而，如果说书人愿意以这样的方式");
    g_tipLine[921] = StringToText("给出信息，也没有任何问题。因为这允许了新人玩家在伪装自己是博学者时有更为宽松的要求——他们不");
    g_tipLine[922] = StringToText("需要编造明显正确或是错误的信息便能成功地伪装。说书人能够在一定限度内去「犯一些错」，");
    g_tipLine[923] = StringToText("而这会使得玩家们也因此在伪装上更为容易。编造谜题也会让游戏变得更加有趣。」");
    g_tipLine[924] = StringToText("如果你在作为说书人时想要给出谜题类的信息，那么你需要注意适时给出更为严肃的信息来「以假乱真」");
    g_tipLine[925] = StringToText("，或是适当协助邪恶玩家进行一些谜题的伪造，来帮助他们显得更像是真正从你这里获得了谜题类信息一样。");
    g_tipRoleAt[54] = 5319;   g_tipRoleN[54] = 21;
    g_tipLine[926] = StringToText("【角色能力】");
    g_tipLine[927] = StringToText("每局游戏限一次，在夜晚时，你可以选择除你以外的两名玩家：你会得知他们是否为同一阵营。");
    g_tipLine[928] = StringToText("【角色简介】");
    g_tipLine[929] = StringToText("女裁缝能得知两名玩家是否属于同一阵营。");
    g_tipLine[930] = StringToText("女裁缝每场游戏只能得到一次信息，所以女裁缝最好是选择最佳时机来使用能力，");
    g_tipLine[931] = StringToText("还要选择最关键的玩家。");
    g_tipLine[932] = StringToText("女裁缝可以选择除自己外的任何玩家，无论他是生是死，甚至可以选择旅行者。");
    g_tipRoleAt[55] = 7149;   g_tipRoleN[55] = 13;
    g_tipLine[933] = StringToText("【角色能力】");
    g_tipLine[934] = StringToText("每局游戏限一次，在夜晚时，你可以选择一个善良角色：你获得该角色的能力。");
    g_tipLine[935] = StringToText("如果这个角色在场，他醉酒。");
    g_tipLine[936] = StringToText("【角色简介】");
    g_tipLine[937] = StringToText("哲学家能够决定自己的能力是什么。");
    g_tipLine[938] = StringToText("他可以选择获得其他角色的能力，但每局仅限一次。当他这么做时，他获得那个角色的能力，");
    g_tipLine[939] = StringToText("但不会变成那个角色。");
    g_tipLine[940] = StringToText("他在选择获得谁的能力时可能会想要思考一小会儿。如果哲学家选择了一个已经在游戏中的角色，");
    g_tipLine[941] = StringToText("该角色对应的玩家醉酒。如果哲学家死亡，醉酒或中毒了，那么那名醉酒的玩家会再次恢复清醒。");
    g_tipLine[942] = StringToText("如果哲学家之前选择了不在场的角色，但之后被选择的角色在场了，被选择的角色对应的玩家也会醉酒。");
    g_tipLine[943] = StringToText("如果哲学家获得了一种在夜晚使用的能力，他将在该角色应该被唤醒的时候被唤醒。");
    g_tipLine[944] = StringToText("如果这个角色能力是「首个夜晚」能力，他会在当晚使用该能力。");
    g_tipLine[945] = StringToText("如果哲学家通过集骨者重新获得了他的能力，或由于咖啡师使用了两次他的能力，");
    g_tipLine[946] = StringToText("哲学家可以选择一个新的能力，或者和以前一样的能力。");
    g_tipLine[947] = StringToText("如果哲学家获取的能力在死亡时生效，例如呆瓜的能力，那么当哲学家死亡后，");
    g_tipLine[948] = StringToText("他选择的角色能力就会生效。");
    g_tipLine[949] = StringToText("【规则细节】");
    g_tipLine[950] = StringToText("与侍臣相似的是，如果哲学家所选择的角色的在场数量超过1人，那么哲学家的能力只会使得其中一名玩");
    g_tipLine[951] = StringToText("家醉酒。但通常来说，说书人应该倾向于优先让存活的玩家醉酒。");
    g_tipLine[952] = StringToText("相克规则：");
    g_tipLine[953] = StringToText("赏金猎人：如果哲学家获得了赏金猎人的能力，可能会有一名镇民玩家转变为邪恶。");
    g_tipRoleAt[56] = 5347;   g_tipRoleN[56] = 21;
    g_tipLine[954] = StringToText("【角色能力】");
    g_tipLine[955] = StringToText("每局游戏限一次，在白天时，你可以私下询问说书人一个是非问题，你会得知该问题的答案。");
    g_tipLine[956] = StringToText("【角色简介】");
    g_tipLine[957] = StringToText("艺术家可以向说书人提出任一是非问题。");
    g_tipLine[958] = StringToText("艺术家可以询问有关任何内容的问题，也可以随心所欲的遣词造句来提问。说书人需要诚实地回答「是」");
    g_tipLine[959] = StringToText("、「不是」，或「我不知道。」");
    g_tipLine[960] = StringToText("是否提问由艺术家决定，而非说书人。艺术家向说书人询问不是公开交流，因此其他玩家不能旁听。");
    g_tipLine[961] = StringToText("艺术家会秘密地询问并获取问题的答案。");
    g_tipLine[962] = StringToText("【规则细节】");
    g_tipLine[963] = StringToText("请注意说书人有权回答「我不知道」，且这样会使得艺术家的能力被浪费掉。");
    g_tipLine[964] = StringToText("针对含糊不清的问题，或者玩家尝试用多个问题嵌套成一个问题，或是如果说书人认为让玩家「重新再问");
    g_tipLine[965] = StringToText("一个问题」会导致对现在的问题有一定程度的暗示作用，那么这种时候，说书人都可以回答「我不知道」。");
    g_tipRoleAt[57] = 5368;   g_tipRoleN[57] = 12;
    g_tipLine[966] = StringToText("【角色能力】");
    g_tipLine[967] = StringToText("在你的首个白天，你可以公开猜测任意玩家的角色最多五次。在当晚，你会得知猜测正确的角色数量。");
    g_tipLine[968] = StringToText("【角色简介】");
    g_tipLine[969] = StringToText("杂耍艺人会冒着风险说服别人在第一天就透露他们的角色，希望尽可能多地猜测说实话的人。");
    g_tipLine[970] = StringToText("在第一个白天，杂耍艺人可以对任意玩家的角色进行猜测。当晚，他会得知他猜对的次数……如果他没有被杀害的话。");
    g_tipLine[971] = StringToText("他必须公开猜测，以使所有玩家听到他猜测的内容。他可以猜测零个角色，或者最多猜测五个角色，");
    g_tipLine[972] = StringToText("他所猜测的玩家和角色可以相同也可以不同。");
    g_tipLine[973] = StringToText("如果杂耍艺人在醉酒或中毒时做出了猜测，但当晚他的能力触发时却清醒且健康，");
    g_tipLine[974] = StringToText("那么说书人仍然会给他真实的信息。");
    g_tipLine[975] = StringToText("【规则细节】");
    g_tipLine[976] = StringToText("不建议杂耍艺人在进行猜测时，多次进行所选玩家与角色的猜测组合完全相同的猜测。");
    g_tipLine[977] = StringToText("（如猜测小明是数学家三次。）但杂耍艺人仍然可以猜测同一名玩家为不同的角色多次，");
    g_tipLine[978] = StringToText("或猜测多名玩家为同一角色多次。");
    g_tipLine[979] = StringToText("如果杂耍艺人的玩家是新人玩家，说书人可以对他进行宽容处理：在他忘记使用自己的能力的当晚唤醒他");
    g_tipLine[980] = StringToText("，并正常告知他信息。此时「0」为正确信息。然而如果是老手玩家，说书人则需要严格进行要求，");
    g_tipLine[981] = StringToText("那名玩家必须要公开声明自己是杂耍艺人之后，才能够在夜晚获得信息（即使他公开声明之后不进行任何");
    g_tipLine[982] = StringToText("猜测，也一样能够获得信息）。");
    g_tipLine[983] = StringToText("相克规则：");
    g_tipLine[984] = StringToText("食人族：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，当晚食人族会替杂耍艺人得知对应的信息。");
    g_tipRoleAt[58] = 5380;   g_tipRoleN[58] = 21;
    g_tipLine[985] = StringToText("【角色能力】");
    g_tipLine[986] = StringToText("如果恶魔杀死了你，在当晚你会被唤醒并得知两名玩家，其中一名是杀死你的那个恶魔。");
    g_tipLine[987] = StringToText("【角色简介】");
    g_tipLine[988] = StringToText("贤者在活着的时候什么也不知道，但当贤者被恶魔杀死时，他会得知谁是恶魔。");
    g_tipLine[989] = StringToText("贤者只有在被恶魔杀死时才会获取信息，死于处决时不会。");
    g_tipLine[990] = StringToText("【规则细节】");
    g_tipLine[991] = StringToText("相克规则：");
    g_tipLine[992] = StringToText("陌客：陌客可能会被贤者当作杀死他的恶魔。");
    g_tipLine[993] = StringToText("利维坦：每个夜晚*，利维坦要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[994] = StringToText("如果贤者被选择，他的能力生效但不会死亡。");
    g_tipLine[995] = StringToText("暴乱：每个夜晚*，暴乱要选择一名存活的善良玩家（与之前的每个夜晚不同）：");
    g_tipLine[996] = StringToText("如果贤者被选择，他的能力生效但不会死亡。");
    g_tipRoleAt[59] = 5401;   g_tipRoleN[59] = 12;
    g_tipLine[997] = StringToText("【角色能力】");
    g_tipLine[998] = StringToText("如果你「疯狂」地证明自己是外来者，你可能被处决。");
    g_tipLine[999] = StringToText("【角色简介】");
    g_tipLine[1000] = StringToText("畸形秀演员如果试图揭露自己是谁，他就会被处决。");
    g_tipLine[1001] = StringToText("「疯狂」是一个术语，意思是「你正在尝试说服他人相信某件事情」。所以，");
    g_tipLine[1002] = StringToText("「畸形秀演员「疯狂」地证明自己是畸形秀演员」，这意味着他正在试图说服他人相信他是畸形秀演员。");
    g_tipLine[1003] = StringToText("「他「疯狂」地证明他是外来者」，这意味着他正在试图说服他人相信他是外来者。");
    g_tipLine[1004] = StringToText("说服的形式包含口头暗示自己的角色，也包含在自己的角色被质疑时的保持沉默。");
    g_tipLine[1005] = StringToText("畸形秀演员是否「疯狂」由说书人来决定。如果你认为他正在以任何方式证明自己是一名外来者，");
    g_tipLine[1006] = StringToText("你就可以处决他，即使在提名阶段之外，甚至是在晚上都可以处决他。如果你这样做，");
    g_tipLine[1007] = StringToText("正常情况下这意味今天白天不会再有其他人被处决，因为每个白天只有一次处决。");
    g_tipLine[1008] = StringToText("如果畸形秀演员晚上暗示他是畸形秀演员，那么你在当晚可以处决他，即使今天白天已经有人被处决。");
    g_tipLine[1009] = StringToText("宣布他的死亡，并正常进行夜晚。明天仍然可能发生一场处决。");
    g_tipRoleAt[60] = 3938;   g_tipRoleN[60] = 15;
    g_tipLine[1010] = StringToText("【角色能力】");
    g_tipLine[1011] = StringToText("当你死亡时，会有一名玩家开始醉酒。");
    g_tipLine[1012] = StringToText("【角色简介】");
    g_tipLine[1013] = StringToText("心上人死亡的时候，一名玩家会在剩余的游戏时间里醉酒。");
    g_tipLine[1014] = StringToText("由说书人选择哪名玩家醉酒。");
    g_tipLine[1015] = StringToText("这项能力当心上人死亡时才会被触发。");
    g_tipRoleAt[61] = 3953;   g_tipRoleN[61] = 8;
    g_tipLine[1016] = StringToText("【角色能力】");
    g_tipLine[1017] = StringToText("如果你死亡，在当晚恶魔可以选择两名玩家（不能选择其他恶魔）交换角色。");
    g_tipLine[1018] = StringToText("【角色简介】");
    g_tipLine[1019] = StringToText("理发师能允许恶魔交换两名玩家的角色。");
    g_tipLine[1020] = StringToText("玩家阵营在交换角色时保持不变。每名玩家都会得知他们变成了什么角色。");
    g_tipLine[1021] = StringToText("恶魔可以选择不进行角色交换。");
    g_tipLine[1022] = StringToText("如果玩家变成了一个新的角色，他们会获得新角色的能力，包括「在你的首个夜晚」的能力或已经被使用");
    g_tipLine[1023] = StringToText("的「每局游戏限一次」的能力。");
    g_tipLine[1024] = StringToText("如果有两名或者更多的存活恶魔，由说书人选择哪个恶魔来操作交换。");
    g_tipLine[1025] = StringToText("恶魔可以选择自己进行角色交换。");
    g_tipLine[1026] = StringToText("恶魔不能选择另一名恶魔玩家进行角色交换。");
    g_tipLine[1027] = StringToText("如果一名玩家在死亡之后变成了理发师，恶魔不能在当晚交换两个玩家的角色。");
    g_tipLine[1028] = StringToText("【规则细节】");
    g_tipLine[1029] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1030] = StringToText("梼杌：如果梼杌的角色发生了交换，因为梼杌失去能力的爪牙依然失去能力。");
    g_tipRoleAt[62] = 3961;   g_tipRoleN[62] = 15;
    g_tipLine[1031] = StringToText("【角色能力】");
    g_tipLine[1032] = StringToText("当你得知你死亡时，你要公开选择一名存活的玩家：如果他是邪恶的，你的阵营落败。");
    g_tipLine[1033] = StringToText("【角色简介】");
    g_tipLine[1034] = StringToText("呆瓜可能会导致他的阵营突然落败，除非他很聪明。");
    g_tipLine[1035] = StringToText("当呆瓜死亡时，他必须公开选择一名玩家。他可能需要花几分钟来做决定——毕竟，");
    g_tipLine[1036] = StringToText("这是一个大决定，而且其他玩家可以向他提供建议，但最终决定始终由呆瓜来做出。");
    g_tipLine[1037] = StringToText("如果他选择了一名邪恶玩家，那游戏就立即结束，善良阵营落败。如果他选择了一名善良玩家，");
    g_tipLine[1038] = StringToText("无事发生，游戏继续。");
    g_tipLine[1039] = StringToText("说书人没有义务提醒呆瓜公开表明自己的角色并选择一名玩家。呆瓜必须在他得知自己死亡后，");
    g_tipLine[1040] = StringToText("尽快去这样做。故意不这样做会被认为是作弊。");
    g_tipRoleAt[63] = 3976;   g_tipRoleN[63] = 11;
    g_tipLine[1041] = StringToText("【角色能力】");
    g_tipLine[1042] = StringToText("你与一名对立阵营的玩家互相知道对方是什么角色。");
    g_tipLine[1043] = StringToText("如果其中善良玩家被处决，邪恶阵营获胜。");
    g_tipLine[1044] = StringToText("如果你们都存活，善良阵营无法获胜。");
    g_tipLine[1045] = StringToText("【角色简介】");
    g_tipLine[1046] = StringToText("镜像双子会与对立阵营一人互为镜像，其他玩家不知道双子的正邪。");
    g_tipLine[1047] = StringToText("由说书人来选择镜像双子与一名对立阵营玩家配对，被选择的玩家是对立双子。");
    g_tipLine[1048] = StringToText("在首个夜晚，双子两人会被一同唤醒，并得知对方的角色。");
    g_tipLine[1049] = StringToText("如果双子中善良一方被处决，邪恶阵营获胜。如果邪恶一方被处决，游戏继续。");
    g_tipLine[1050] = StringToText("死去的镜像双子会失去能力，如果在他死后处决善良双子，邪恶阵营不会获胜。");
    g_tipLine[1051] = StringToText("两个双子都存活时善良阵营无法获胜。此时即使恶魔死亡，游戏也会继续。善良阵营要杀死镜像双子以取得胜利。");
    g_tipLine[1052] = StringToText("如果一名善良玩家变成了镜像双子，他仍然是善良玩家，此时一名邪恶玩家成为他的对立双子。");
    g_tipLine[1053] = StringToText("另一个双子是什么角色并不重要，真正重要的是他们的阵营，好人可以安全处决邪恶的双子，");
    g_tipLine[1054] = StringToText("但如果处决的是善良的双子，邪恶阵营获胜。");
    g_tipLine[1055] = StringToText("如果两个双子都是相同阵营，则由说书人为镜像双子重新选择一名玩家成为对立双子。");
    g_tipLine[1056] = StringToText("【规则细节】");
    g_tipLine[1057] = StringToText("在游玩梦殒春宵剧本时，以上述运作方式来唤醒镜像双子与对立双子是没有任何问题的，");
    g_tipLine[1058] = StringToText("但是这一方式在扩展到其他混合剧本的时候可能会出现问题。（例如镜像双子被传教士影响，");
    g_tipLine[1059] = StringToText("或有涡流在场时炼金术士获得了镜像双子的能力，等等。）我们建议说书人在熟悉镜像双子的角色能力逻");
    g_tipLine[1060] = StringToText("辑之后，分别单独唤醒镜像双子和其对立双子，并用原本的提示方式对两名玩家单独进行提示，");
    g_tipLine[1061] = StringToText("而不是让他们进行眼神接触来确认。");
    g_tipLine[1062] = StringToText("相克规则：");
    g_tipLine[1063] = StringToText("瘟疫医生：如果说书人本应获得镜像双子的能力，改为一名玩家会变成镜像双子。");
    g_tipLine[1064] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1065] = StringToText("戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1066] = StringToText("梼杌：镜像双子在梼杌的能力判断中被当作「不具有能力」。");
    g_tipLine[1067] = StringToText("戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1068] = StringToText("姑获鸟：如果姑获鸟获得了镜像双子的能力，新对立双子会知道「姑获鸟在场」，");
    g_tipLine[1069] = StringToText("但不会知道姑获鸟是谁。");
    g_tipRoleAt[64] = 1041;   g_tipRoleN[64] = 29;
    g_tipLine[1070] = StringToText("【角色能力】");
    g_tipLine[1071] = StringToText("每个夜晚，你要选择一名玩家：如果他明天白天发起提名，他死亡。如果只有三名存活的玩家，你失去此能力。");
    g_tipLine[1072] = StringToText("【角色简介】");
    g_tipLine[1073] = StringToText("女巫能诅咒玩家，被诅咒的玩家如果发起提名，就会被咒杀。");
    g_tipLine[1074] = StringToText("每个夜晚，女巫会选择一名玩家诅咒。那名玩家如果在下个白天提名了任何玩家，");
    g_tipLine[1075] = StringToText("就会死亡。尽管如此，他的提名仍然生效。");
    g_tipLine[1076] = StringToText("女巫的诅咒只持续一个白天，但女巫可以每晚一次又一次地诅咒同一名玩家。");
    g_tipLine[1077] = StringToText("只剩三名玩家存活时，女巫的诅咒立即解除，女巫也无法再进行夜晚行动。");
    g_tipRoleAt[65] = 1070;   g_tipRoleN[65] = 8;
    g_tipLine[1078] = StringToText("【角色能力】");
    g_tipLine[1079] = StringToText("每个夜晚，你要选择一名玩家和一个善良角色。他明天白天和夜晚需要「疯狂」地证明自己是这个角色，");
    g_tipLine[1080] = StringToText("不然他可能被处决。");
    g_tipLine[1081] = StringToText("【角色简介】");
    g_tipLine[1082] = StringToText("洗脑师促使玩家假装成与自己实际角色不同的角色。");
    g_tipLine[1083] = StringToText("洗脑师会选择让一名玩家「疯狂」地证明自己是某个镇民或外来者角色。被选择的玩家明天必须试图说服");
    g_tipLine[1084] = StringToText("其他玩家相信他是这个角色，否则就会死亡。");
    g_tipLine[1085] = StringToText("简短的暗示不足以避免死亡。玩家必须付出努力说服其他玩家。虽然疯狂的玩家不会被强迫一定要说出他");
    g_tipLine[1086] = StringToText("不想说的东西，但是如果说书人感受不到他的努力，他就会付出代价。");
    g_tipLine[1087] = StringToText("疯狂的邪恶玩家可能会以这种方式被处决，但「可能」意味着你可以选择不这么做，");
    g_tipLine[1088] = StringToText("以防止邪恶玩家通过这种策略获胜。");
    g_tipLine[1089] = StringToText("像畸形秀演员一样，执行处决惩罚计入每天的处决限制。");
    g_tipLine[1090] = StringToText("【规则细节】");
    g_tipLine[1091] = StringToText("相克规则：");
    g_tipLine[1092] = StringToText("哥布林：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipRoleAt[66] = 1078;   g_tipRoleN[66] = 15;
    g_tipLine[1093] = StringToText("【角色能力】");
    g_tipLine[1094] = StringToText("每个夜晚*，你要选择一名玩家和一个角色，如果该角色不在场，他变成该角色。");
    g_tipLine[1095] = StringToText("如果因此创造了一个恶魔，当晚的死亡由说书人决定。");
    g_tipLine[1096] = StringToText("【角色简介】");
    g_tipLine[1097] = StringToText("麻脸巫婆能将玩家变为不同的角色。");
    g_tipLine[1098] = StringToText("除首个夜晚以外的每个夜晚，麻脸巫婆需要选择一名玩家和一个角色，那名玩家变为她选择的角色。");
    g_tipLine[1099] = StringToText("她无法创造重复角色，如果那个角色已在场，则无事发生。");
    g_tipLine[1100] = StringToText("【规则细节】");
    g_tipLine[1101] = StringToText("说书人应该如何处理「因为麻脸巫婆创造了恶魔」而导致的死亡：");
    g_tipLine[1102] = StringToText("麻脸巫婆造成死亡的时间范围为当前剧本中首个能够造成死亡的恶魔行动开始前，");
    g_tipLine[1103] = StringToText("到最后一个能够造成死亡的恶魔行动结束后。");
    g_tipLine[1104] = StringToText("在这个期间，说书人能够自由决定是否让某名玩家死亡，或让被恶魔攻击的某名玩家存活。");
    g_tipLine[1105] = StringToText("说书人在这个时间范围内，可以分别在不同的恶魔行动前或后多次执行造成或阻止死亡的效果。");
    g_tipLine[1106] = StringToText("一旦说书人决定杀死某个还未唤醒的恶魔，这名恶魔玩家当晚就不会被唤醒。");
    g_tipLine[1107] = StringToText("否则，就需要唤醒这名玩家。这对于在创造出哈迪寂亚等带有特殊效果的恶魔时非常重要。");
    g_tipLine[1108] = StringToText("说书人只能造成更多的死亡或阻止原本要发生的死亡，其他类型的恶魔能力无法阻止，");
    g_tipLine[1109] = StringToText("如普卡的中毒、哈迪寂亚的复活等。");
    g_tipLine[1110] = StringToText("不建议说书人阻止恶魔成功攻击的玩家的死亡，并再自己决定让这名玩家死亡，");
    g_tipLine[1111] = StringToText("因为这会造成更多的混乱。恶魔攻击后无法杀死某名玩家再由说书人决定杀死，");
    g_tipLine[1112] = StringToText("这种情况不算在内。");
    g_tipLine[1113] = StringToText("说书人造成的死亡视为麻脸巫婆造成，因此不会触发贤者、唱诗男孩等角色的能力，");
    g_tipLine[1114] = StringToText("也能够成功杀死士兵（如果麻脸巫婆没有照看小怪宝的话）。");
    g_tipLine[1115] = StringToText("只要麻脸巫婆创造了恶魔，即使在那之后麻脸巫婆离场、失去能力或死亡，当晚说书人仍然可以决定造成或阻止死亡。");
    g_tipLine[1116] = StringToText("说书人只能阻止恶魔造成的死亡，由非恶魔玩家造成的死亡无法阻止。");
    g_tipLine[1117] = StringToText("相克规则：");
    g_tipLine[1118] = StringToText("村夫：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，");
    g_tipLine[1119] = StringToText("村夫的醉酒效果可能会更换目标。");
    g_tipLine[1120] = StringToText("异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1121] = StringToText("落难少女：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[1122] = StringToText("异教领袖/政客/莽夫/食人魔：被麻脸巫婆创造的邪恶异教领袖/政客/莽夫/食人魔无法因为自身能");
    g_tipLine[1123] = StringToText("力转变为善良阵营。");
    g_tipLine[1124] = StringToText("召唤师：如果召唤师创造了第二个存活的恶魔，当晚的死亡由说书人决定。");
    g_tipLine[1125] = StringToText("利维坦：利维坦不能在第五天之后加入游戏。");
    g_tipLine[1126] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1127] = StringToText("戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1128] = StringToText("梼杌：如果梼杌变成了其他角色，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipLine[1129] = StringToText("戏子（改）：麻脸巫婆无法创造戏子（改），麻脸巫婆创造的邪恶玩家无法获得戏子（改）的能力。");
    g_tipRoleAt[67] = 1093;   g_tipRoleN[67] = 37;
    g_tipLine[1130] = StringToText("【角色能力】");
    g_tipLine[1131] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[1132] = StringToText("被该能力杀死的外来者改为变成邪恶的方古且你代替他死亡，但每局游戏仅能成功转化一次。[+1外来者]");
    g_tipLine[1133] = StringToText("【角色简介】");
    g_tipLine[1134] = StringToText("方古会侵染外来者。");
    g_tipLine[1135] = StringToText("方古首次攻击并成功杀死外来者时，改为方古死亡，外来者变成邪恶的方古。");
    g_tipLine[1136] = StringToText("这种情况在整局游戏仅能出现一次。如果新的方古攻击外来者，外来者正常死亡。");
    g_tipLine[1137] = StringToText("新的方古也是恶魔，如果他死亡，善良阵营获胜。但他不会得知哪些玩家是爪牙。");
    g_tipLine[1138] = StringToText("方古会使得在初始设置时增加一名外来者。");
    g_tipLine[1139] = StringToText("如果方古攻击外来者，但外来者没有因此死亡，则外来者不会成为邪恶的方古，方古也不会死。");
    g_tipLine[1140] = StringToText("【规则细节】");
    g_tipLine[1141] = StringToText("相克规则：");
    g_tipLine[1142] = StringToText("红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，红唇女郎不会变成恶魔。");
    g_tipRoleAt[68] = 1130;   g_tipRoleN[68] = 13;
    g_tipLine[1143] = StringToText("【角色能力】");
    g_tipLine[1144] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[1145] = StringToText("被你杀死的爪牙保留他的能力，且与他邻近的两名镇民之一中毒。[-1外来者]");
    g_tipLine[1146] = StringToText("【角色简介】");
    g_tipLine[1147] = StringToText("亡骨魔每当杀死自己的爪牙时，会使爪牙保留能力。");
    g_tipLine[1148] = StringToText("每当亡骨魔杀死一名爪牙时，虽然爪牙会死亡，但只要亡骨魔还存活，该爪牙就能保留能力，");
    g_tipLine[1149] = StringToText("且仍能在夜晚行动。");
    g_tipLine[1150] = StringToText("类似于诺-达鲺，那个被亡骨魔杀死的爪牙顺时针或逆时针方向最近的镇民玩家会中毒，");
    g_tipLine[1151] = StringToText("即使该镇民已经死亡。如果亡骨魔死亡或失去能力，受亡骨魔影响的中毒玩家恢复健康。");
    g_tipLine[1152] = StringToText("亡骨魔在杀死爪牙时总是会使一名镇民玩家中毒，在说书人选择中毒玩家时会跳过与爪牙相邻的非镇民角");
    g_tipLine[1153] = StringToText("色。由说书人选择该爪牙哪一侧的镇民中毒。");
    g_tipLine[1154] = StringToText("不仅是最后一个被亡骨魔杀死的爪牙，所有被亡骨魔杀死的爪牙都会保留能力并使一名镇民中毒。");
    g_tipLine[1155] = StringToText("如果死亡的爪牙变成非爪牙角色，便不再使相应的镇民中毒，且不再保留能力。");
    g_tipLine[1156] = StringToText("如果死亡的爪牙醉酒或中毒，也会失去能力直到再次恢复清醒和健康。");
    g_tipLine[1157] = StringToText("【规则细节】");
    g_tipLine[1158] = StringToText("相克规则：");
    g_tipLine[1159] = StringToText("主谋：如果亡骨魔死亡，被亡骨魔杀死的主谋依然保留能力。");
    g_tipRoleAt[69] = 1143;   g_tipRoleN[69] = 17;
    g_tipLine[1160] = StringToText("【角色能力】");
    g_tipLine[1161] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[1162] = StringToText("与你邻近的两名镇民中毒。");
    g_tipLine[1163] = StringToText("【角色简介】");
    g_tipLine[1164] = StringToText("诺-达鲺会使与它邻近的镇民中毒。");
    g_tipLine[1165] = StringToText("在诺-达鲺顺时针和逆时针方向上最近的镇民中毒，无论这些镇民是存活还是死亡。");
    g_tipLine[1166] = StringToText("如果诺-达鲺死亡或者因为其他原因失去能力，那么这两名镇民玩家恢复健康。");
    g_tipLine[1167] = StringToText("总是会有两名镇民玩家因此中毒，诺-达鲺的效果会跳过与他相邻的非镇民角色。");
    g_tipLine[1168] = StringToText("如果有玩家成为新的诺-达鲺，或一个中毒的镇民变成了一个非镇民角色，都会根据新位置关系立刻改变中毒的玩家。");
    g_tipRoleAt[70] = 1160;   g_tipRoleN[70] = 9;
    g_tipLine[1169] = StringToText("【角色能力】");
    g_tipLine[1170] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。");
    g_tipLine[1171] = StringToText("镇民玩家的能力都会产生错误信息。");
    g_tipLine[1172] = StringToText("如果白天没人被处决，邪恶阵营获胜。");
    g_tipLine[1173] = StringToText("【角色简介】");
    g_tipLine[1174] = StringToText("涡流使所有信息变得错误。");
    g_tipLine[1175] = StringToText("任何时候角色是镇民的玩家通过能力获取信息时，他们会得知错误信息。哪怕他们醉酒或中毒，");
    g_tipLine[1176] = StringToText("信息也一定是错误的。");
    g_tipLine[1177] = StringToText("涡流不会影响其他人通过其他方式获得的信息，例如说书人解释的规则或玩家的角色或阵营的变化。");
    g_tipLine[1178] = StringToText("当夜晚降临时，如果今天白天没有人被处决，邪恶阵营胜利。流放旅行者不算在内。");
    g_tipLine[1179] = StringToText("【规则细节】");
    g_tipLine[1180] = StringToText("相克规则：");
    g_tipLine[1181] = StringToText("报丧女妖：如果涡流杀死了报丧女妖，玩家仍然会得知正确信息。（中文百科上的「通用简化原则」已涵");
    g_tipLine[1182] = StringToText("盖包括多角色互动下的涡流信息的简化处理方式，此条仅作说明。）");
    g_tipRoleAt[71] = 1169;   g_tipRoleN[71] = 14;
    g_tipLine[1183] = StringToText("【角色能力】");
    g_tipLine[1184] = StringToText("每个夜晚，你会得知一名与上个夜晚得知的玩家角色类型不同的玩家。[+0~1外来者]");
    g_tipLine[1185] = StringToText("【角色简介】");
    g_tipLine[1186] = StringToText("气球驾驶员能得知不同角色类型的玩家。");
    g_tipLine[1187] = StringToText("气球驾驶员每次必须得知不同于上一次得知玩家的角色类型的玩家。");
    g_tipLine[1188] = StringToText("气球驾驶员不会得知玩家的角色类型。");
    g_tipLine[1189] = StringToText("向气球驾驶员展示的玩家可以存活或死亡。");
    g_tipLine[1190] = StringToText("向气球驾驶员展示的玩家可以善良或邪恶。");
    g_tipLine[1191] = StringToText("如果气球驾驶员中毒或醉酒，他可以得知与上一次得知玩家的角色类型相同的玩家。");
    g_tipLine[1192] = StringToText("如果之后气球驾驶员恢复了健康清醒，他们必须得知与上一次得知玩家的角色类型不同的玩家。");
    g_tipLine[1193] = StringToText("设置调整阶段，说书人可以决定是否让气球驾驶员添加一名额外的外来者。");
    g_tipLine[1194] = StringToText("【规则细节】");
    g_tipLine[1195] = StringToText("相克规则：");
    g_tipLine[1196] = StringToText("提线木偶：如果提线木偶抽到了气球驾驶员，在设置调整阶段可能会+1外来者。");
    g_tipRoleAt[72] = 5413;   g_tipRoleN[72] = 14;
    g_tipLine[1197] = StringToText("【角色能力】");
    g_tipLine[1198] = StringToText("你不知道你的能力是什么。每个白天你可以找说书人猜测一次，你会得知你的猜测有多准确。");
    g_tipLine[1199] = StringToText("【角色简介】");
    g_tipLine[1200] = StringToText("失忆者不会知道他的能力是什么。");
    g_tipLine[1201] = StringToText("由说书人来决定失忆者的具体能力。这可以是来自《染·钟楼谜团》中现有角色的能力，");
    g_tipLine[1202] = StringToText("也可以是与之相似的能力，或是完全原创的能力。");
    g_tipLine[1203] = StringToText("失忆者可能会在夜晚的任意时刻被唤醒，以得知信息或者选择玩家。他的能力也可以是被动效果，");
    g_tipLine[1204] = StringToText("无需失忆者玩家主动做出任何行动。");
    g_tipLine[1205] = StringToText("每个白天，失忆者都可以私下拜访说书人，并猜测自己的能力是什么。说书人用以下方式回答失忆者的猜");
    g_tipLine[1206] = StringToText("测：「无关」代表猜测与实际差距较大，「有关」代表猜测的方向正确，「接近」代表猜测的结果与实际");
    g_tipLine[1207] = StringToText("能力较为接近，而「完美」代表猜测的结果与实际能力完全相符。");
    g_tipLine[1208] = StringToText("失忆者的猜测可以是具体的，例如「我是否是在每个夜晚得知两名阵营相同的玩家？");
    g_tipLine[1209] = StringToText("」，也可以是较为模糊的，例如「我的能力是否与已死亡的玩家有关？」。");
    g_tipLine[1210] = StringToText("【规则细节】");
    g_tipLine[1211] = StringToText("失忆者的夜晚行动顺序并非要完全依照在线魔典的原定顺序。说书人应该根据自己为失忆者设定的能力的");
    g_tipLine[1212] = StringToText("具体情况，来决定失忆者应该在什么顺序被唤醒。通常来说，如果失忆者的能力会造成醉酒/中毒，");
    g_tipLine[1213] = StringToText("或是具有一些保护效果，或是在较早行动才能获得更多的收益时，应该让失忆者在夜晚靠前的顺序中被唤");
    g_tipLine[1214] = StringToText("醒。如果失忆者的能力会得知一些信息，或是需要基于一些其他行动来被唤醒，");
    g_tipLine[1215] = StringToText("或是在较晚行动才能获得更多的收益时，应该让失忆者在夜晚靠后的顺序中被唤醒。");
    g_tipLine[1216] = StringToText("但需要注意的是，一旦你决定好失忆者的能力在夜晚的唤醒顺序时，就不应该再擅自改动，");
    g_tipLine[1217] = StringToText("而是在每个夜晚都以这个顺序来将失忆者唤醒（当然，由于能力的不同，且同一剧本中其他角色首夜和非");
    g_tipLine[1218] = StringToText("首夜的顺序差异，失忆者在首个夜晚的顺序可能会与其他夜晚有所不同）。");
    g_tipRoleAt[73] = 5427;   g_tipRoleN[73] = 23;
    g_tipLine[1219] = StringToText("【角色能力】");
    g_tipLine[1220] = StringToText("你拥有上个死于处决的玩家的能力。如果该玩家属于邪恶阵营，你中毒直到下个善良玩家死于处决。");
    g_tipLine[1221] = StringToText("【角色简介】");
    g_tipLine[1222] = StringToText("食人族会吃下被处决的角色，并获得他们的能力。");
    g_tipLine[1223] = StringToText("如果一名善良玩家死于处决，食人族能获得他的能力。如果一名邪恶玩家死于处决，");
    g_tipLine[1224] = StringToText("食人族也只会认为自己获得了能力，因为他中毒了，说书人可能会对他撒谎。");
    g_tipLine[1225] = StringToText("每当有一名玩家死于处决时，食人族会失去上一次获得的能力。");
    g_tipLine[1226] = StringToText("处决一名已经死亡的玩家不会让食人族获得能力。处决一名存活但并未导致死亡的玩家也不会让食人族获");
    g_tipLine[1227] = StringToText("得能力。玩家必须要被处决并因此死亡，才会让食人族获得能力。");
    g_tipLine[1228] = StringToText("食人族不会被告知自己获得了什么能力。他必须自己弄明白。");
    g_tipLine[1229] = StringToText("如果食人族获得了「即使你已死亡」的能力，例如陌客，或在死亡后才会生效的能力，");
    g_tipLine[1230] = StringToText("例如守鸦人或心上人，食人族会在死亡时仍然保留这些能力，但失去食人族自己角色本身的能力。");
    g_tipLine[1231] = StringToText("【规则细节】");
    g_tipLine[1232] = StringToText("如果死于处决的玩家在随后改变角色或转换阵营，同样会被食人族持续检测。");
    g_tipLine[1233] = StringToText("特定角色互动：");
    g_tipLine[1234] = StringToText("异教领袖/莽夫：获得这些能力将允许食人族转变阵营，如果有另一名无法转变阵营的玩家在食人族转变");
    g_tipLine[1235] = StringToText("为原来阵营之前死于处决，食人族将被锁定为他当前的阵营。");
    g_tipLine[1236] = StringToText("杂耍艺人：如果杂耍艺人死于处决，食人族只能在第二天无人死于处决的情况下从杂耍艺人的能力获得信");
    g_tipLine[1237] = StringToText("息。在杂耍艺人被处决的下一个白天是食人族杂耍艺人的「首个白天」，所以他必须在当天进行公开猜测");
    g_tipLine[1238] = StringToText("，并且必须确保无人死于处决。以便食人族杂耍艺人保持他的能力，在当晚得到猜测的结果。");
    g_tipLine[1239] = StringToText("酒鬼：如果食人族获得酒鬼的能力，你可以欺骗食人族是任何镇民，包括酒鬼自以为的那个角色。");
    g_tipLine[1240] = StringToText("疯子：如果食人族获得疯子的能力，你应该告诉食人族，他现在是剧本上的某个恶魔，");
    g_tipLine[1241] = StringToText("并在疯子的夜晚行动顺序时唤醒食人族进行攻击，之后唤醒恶魔，恶魔得知食人族玩家是疯子以及攻击目标。");
    g_tipLine[1242] = StringToText("畸形秀演员：如果食人族拥有畸形秀演员能力，他可以声称自己是一个拥有畸形秀演员能力的食人族，");
    g_tipLine[1243] = StringToText("并且不会被处决，因为他没有声称自己是外来者。然而，如果他声称自己是畸形秀演员，");
    g_tipLine[1244] = StringToText("他可能会被处决。");
    g_tipLine[1245] = StringToText("政客：如果食人族获得政客的能力，他将与已经死亡的政客发生竞争。因为只有一名玩家能够为自己阵营");
    g_tipLine[1246] = StringToText("失败负最大责任，所以只有一名玩家可以转变阵营并获胜。");
    g_tipLine[1247] = StringToText("洗脑师：如果一名玩家被洗脑并对特定角色疯狂，他不能声称自己是拥有该角色能力的食人族，");
    g_tipLine[1248] = StringToText("期望以此逃避违反洗脑疯狂的处决。因为他没有声称自己就是这个角色，这不符合疯狂的要求。");
    g_tipLine[1249] = StringToText("教授/沙巴洛斯：当食人族复活，他将获得最近死于处决的玩家能力。");
    g_tipLine[1250] = StringToText("呆瓜/月之子：参考管家的相克规则，如果食人族玩家在获得这些角色能力的时候死亡，");
    g_tipLine[1251] = StringToText("且不知道自己是否获得了对应的能力的时候，说书人应该对他进行提醒。即使不进行提醒，");
    g_tipLine[1252] = StringToText("也不应该算作是作弊。");
    g_tipLine[1253] = StringToText("相克规则：");
    g_tipLine[1254] = StringToText("杂耍艺人：如果杂耍艺人在自己的首个白天猜测后在当天死于处决，当晚食人族会替杂耍艺人得知对应的信息。");
    g_tipLine[1255] = StringToText("管家：如果食人族获得了管家的能力，他会得知这一信息。");
    g_tipLine[1256] = StringToText("狂热者：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[1257] = StringToText("公主：如果食人族提名并处决了公主且公主因此死亡，当晚恶魔不会造成死亡。");
    g_tipRoleAt[74] = 5450;   g_tipRoleN[74] = 42;
    g_tipLine[1258] = StringToText("【角色能力】");
    g_tipLine[1259] = StringToText("在你的首个夜晚，你能查看魔典并选择一名玩家：他中毒。随后，始终会有一名善良玩家知道寡妇在场。");
    g_tipLine[1260] = StringToText("【角色简介】");
    g_tipLine[1261] = StringToText("寡妇查看魔典并毒害一名她选择的玩家。");
    g_tipLine[1262] = StringToText("寡妇仅在她的首个夜晚行动并使一名玩家中毒。");
    g_tipLine[1263] = StringToText("因寡妇中毒的玩家会一直保持中毒直到寡妇死亡。");
    g_tipLine[1264] = StringToText("在寡妇行动的那个夜晚，会有一名善良玩家知道寡妇在场，他不会得知谁是寡妇，");
    g_tipLine[1265] = StringToText("也不会得知谁中毒了。");
    g_tipLine[1266] = StringToText("【规则细节】");
    g_tipLine[1267] = StringToText("相克规则：");
    g_tipLine[1268] = StringToText("魔术师：当寡妇查看魔典时，魔术师和恶魔的标记会被说书人移除。");
    g_tipLine[1269] = StringToText("罂粟种植者：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[1270] = StringToText("炼金术士：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改为寡妇一定在场。");
    g_tipLine[1271] = StringToText("每次处决后，存活的炼金术士可以公开猜测一名存活玩家是寡妇：如果猜对了，");
    g_tipLine[1272] = StringToText("恶魔当晚必须选择寡妇。");
    g_tipLine[1273] = StringToText("落难少女：如果寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[1274] = StringToText("异端分子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1275] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1276] = StringToText("戏子：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1277] = StringToText("戏子（改）：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipRoleAt[75] = 1258;   g_tipRoleN[75] = 20;
    g_tipLine[1278] = StringToText("【角色能力】");
    g_tipLine[1279] = StringToText("在你的首个夜晚，你会得知三名玩家：其中有且只有一名玩家是邪恶的。");
    g_tipLine[1280] = StringToText("【角色简介】");
    g_tipLine[1281] = StringToText("贵族能得知三名玩家中的一名是邪恶的。");
    g_tipLine[1282] = StringToText("贵族只会在第一个夜晚得知他的信息。");
    g_tipLine[1283] = StringToText("如果贵族在游戏中途被创造，他会在自己作为贵族时的第一个夜晚得知信息。");
    g_tipLine[1284] = StringToText("贵族得知的是两名善良玩家和一名邪恶玩家。他不会得知一名善良玩家和两名邪恶玩家，");
    g_tipLine[1285] = StringToText("也不会得知三名邪恶玩家。");
    g_tipLine[1286] = StringToText("【规则细节】");
    g_tipLine[1287] = StringToText("特定角色互动：");
    g_tipLine[1288] = StringToText("异教领袖：就算在首夜因为自身能力就变为邪恶，也不会被贵族当做邪恶玩家得知。");
    g_tipLine[1289] = StringToText("因为异教领袖的首夜行动顺序在贵族之后，他在贵族在被唤醒时始终都是善良的。");
    g_tipLine[1290] = StringToText("舞蛇人：可能在贵族醒来之前阵营发生交换，所以在贵族信息中需要展示新的阵营状态。");
    g_tipLine[1291] = StringToText("莽夫：在贵族醒来时，莽夫的阵营可能已经变为邪恶，所以可以将莽夫作为邪恶玩家展示。");
    g_tipLine[1292] = StringToText("注意，贵族没有使用自身能力选择莽夫。");
    g_tipLine[1293] = StringToText("陌客/间谍：可以被贵族当作邪恶或善良。");
    g_tipRoleAt[76] = 5492;   g_tipRoleN[76] = 16;
    g_tipLine[1294] = StringToText("【角色能力】");
    g_tipLine[1295] = StringToText("每局游戏限一次，在夜晚时，你可以选择一名存活的玩家：如果你选中了落难少女，");
    g_tipLine[1296] = StringToText("她会变成一个不在场的镇民角色。[+落难少女]");
    g_tipLine[1297] = StringToText("【角色简介】");
    g_tipLine[1298] = StringToText("巡山人能够在爪牙找到落难少女之前拯救她……至少说希望如此。");
    g_tipLine[1299] = StringToText("落难少女可以在巡山人不在场时出现在游戏中。在游戏设置阶段，如果巡山人在场而落难少女不在场，");
    g_tipLine[1300] = StringToText("那么落难少女就会被添加进来并替换掉一个其他镇民。而如果落难少女已经在场，");
    g_tipLine[1301] = StringToText("巡山人不会因此再将另外一名落难少女添加进场。");
    g_tipLine[1302] = StringToText("如果巡山人在夜晚时正确地选中了落难少女，那么落难少女就会立即变成一个不在场的镇民角色。");
    g_tipLine[1303] = StringToText("由说书人来决定会变成哪一个镇民角色，且落难少女会得知自己变成了什么角色。");
    g_tipLine[1304] = StringToText("如果落难少女变成了镇民，她会获得那个镇民的能力并失去落难少女的能力。");
    g_tipLine[1305] = StringToText("巡山人只有一次猜测和选择的机会，并且会在夜晚进行。");
    g_tipLine[1306] = StringToText("在白天，爪牙们一共有一次公开猜测的机会。如果爪牙猜对了谁是落难少女，");
    g_tipLine[1307] = StringToText("邪恶阵营获胜。如果爪牙猜错了谁是落难少女，其他爪牙就不能通过猜对落难少女是谁获胜了。");
    g_tipLine[1308] = StringToText("如果落难少女在被巡山人选择时醉酒或中毒，只要巡山人清醒且健康，那么落难少女就能够变成镇民。");
    g_tipLine[1309] = StringToText("【规则细节】");
    g_tipLine[1310] = StringToText("落难少女被选中后角色变为不在场的镇民角色，玩家的角色类型也会跟着改变，");
    g_tipLine[1311] = StringToText("而不仅仅只是获得镇民的能力。");
    g_tipLine[1312] = StringToText("拥有落难少女能力的其他角色被巡山人选择，该玩家并不会变成一个不在场的镇民角色。");
    g_tipLine[1313] = StringToText("特定角色互动：");
    g_tipLine[1314] = StringToText("气球驾驶员：如果时机合适，可以得知落难少女两次——一次作为外来者，一次作为被巡山人改变后的镇民。");
    g_tipLine[1315] = StringToText("侍臣：如果侍臣让落难少女醉酒，然后巡山人选中落难少女，他变为一个新的角色，");
    g_tipLine[1316] = StringToText("这名原落难少女玩家仍然会继续醉酒。");
    g_tipLine[1317] = StringToText("教父/方古：如果被巡山人选中的落难少女玩家改变的角色后在白天死亡，教父无法在晚上被唤醒杀人；");
    g_tipLine[1318] = StringToText("方古不能转化到该玩家身上。该玩家不再是落难少女，所以不再是外来者。");
    g_tipLine[1319] = StringToText("提线木偶：如果巡山人在场，落难少女不会是提线木偶。不过，巡山人可能是提线木偶。");
    g_tipLine[1320] = StringToText("痢蛭：即使落难少女是宿主，他仍然能被巡山人改变，但仍然继续中毒。");
    g_tipLine[1321] = StringToText("咖啡师：如果受到咖啡师行动两次的效果影响，如果巡山人还没进行选择，他可以在一晚内选择两名玩家");
    g_tipLine[1322] = StringToText("；或者如果巡山人已经在之前选择过一次，他会被唤醒并再次选择。如果落难少女被选中，");
    g_tipLine[1323] = StringToText("他仍然只会改变角色一次。");
    g_tipLine[1324] = StringToText("相克规则：");
    g_tipLine[1325] = StringToText("提线木偶：如果提线木偶抽到了巡山人，在设置调整阶段会增加落难少女。");
    g_tipRoleAt[77] = 5508;   g_tipRoleN[77] = 33;
    g_tipLine[1326] = StringToText("【角色能力】");
    g_tipLine[1327] = StringToText("每局游戏限一次，在夜晚时，你可以选择让恶魔变成你选择的恶魔角色，或让所有爪牙变成你选择的爪牙角色。");
    g_tipLine[1328] = StringToText("【角色简介】");
    g_tipLine[1329] = StringToText("工程师能够决定镇子即将面临何种威胁。");
    g_tipLine[1330] = StringToText("工程师能够决定在场的爪牙种类，或在场的恶魔种类，但无法同时决定这两者。");
    g_tipLine[1331] = StringToText("当工程师创造新的角色时，原本的恶魔玩家会仍然是恶魔，原本的爪牙玩家会仍然是爪牙。");
    g_tipLine[1332] = StringToText("邪恶玩家的总数量不会因此发生改变。");
    g_tipLine[1333] = StringToText("如果工程师尝试创造一个已经在场的角色时，那个角色所属的玩家不会发生变化。");
    g_tipLine[1334] = StringToText("工程师不会得知这一消息，也不能再次使用自己的能力了。");
    g_tipLine[1335] = StringToText("如果要创造爪牙，工程师需要根据本局游戏的玩家总数，选择等同于原本应该在场的爪牙数量的爪牙角色");
    g_tipLine[1336] = StringToText("。（参考旅行者列表或设置列表）");
    g_tipLine[1337] = StringToText("如果工程师无意中选择了数量不符的角色时，说书人应该以较为公平且可行的方式来改变一定数量的邪恶玩家的角色。");
    g_tipLine[1338] = StringToText("工程师只能选择来自于当前剧本列表中的角色。");
    g_tipLine[1339] = StringToText("【规则细节】");
    g_tipLine[1340] = StringToText("特定角色互动：");
    g_tipLine[1341] = StringToText("侍女：爪牙/恶魔因为得知他们的新角色而被唤醒，不会被侍女探查，除非他们因为自身获得的新能力醒来。");
    g_tipLine[1342] = StringToText("方古/小恶魔：如果工程师选择的时候，场上有复数的相同角色恶魔，这些相同角色的恶魔玩家都会改变角色。");
    g_tipLine[1343] = StringToText("小怪宝：如果小怪宝在场的时候，工程师选择其他恶魔，当前照看小怪宝的玩家会变成那个恶魔，");
    g_tipLine[1344] = StringToText("不管他之前是什么角色。如果工程师选择让小怪宝进入游戏，之前的恶魔会变成一个不在场的爪牙角色并");
    g_tipLine[1345] = StringToText("且正在照看小怪宝。");
    g_tipLine[1346] = StringToText("提线木偶：如果提线木偶被工程师带入游戏，提线木偶不需要与恶魔相邻。变为提线木偶的玩家不会被展");
    g_tipLine[1347] = StringToText("示他是提线木偶，而是改为展示「你是」，然后展示任何一个镇民或外来者角色标记。");
    g_tipLine[1348] = StringToText("如果提线木偶被工程师变为其他爪牙，他将被展示「你是」，并且展示新的爪牙角色标记。");
    g_tipLine[1349] = StringToText("珀：如果一个没被唤醒的恶魔被工程师变为珀，珀在当晚不能三杀。");
    g_tipLine[1350] = StringToText("传教士：如果爪牙已经被传教士布道，然后被工程师转变，爪牙得知他的角色改变但仍然会被传教士影响");
    g_tipLine[1351] = StringToText("，所以他的新角色仍然失去能力。");
    g_tipLine[1352] = StringToText("陌客：理论上可以被当作爪牙/恶魔，然后被工程师转变或者影响其他发生转变的角色……不要这样做，陌客是外来者。");
    g_tipLine[1353] = StringToText("间谍：可以不被当作爪牙，同时无视工程师的转换，保持他的能力。");
    g_tipLine[1354] = StringToText("亡骨魔：如果被工程师变为其他恶魔，被亡骨魔杀死的爪牙失去能力，与这些爪牙相邻的中毒玩家会立即解除中毒。");
    g_tipLine[1355] = StringToText("寡妇：如果被工程师带入游戏，当晚一名善良玩家得知场上有寡妇。");
    g_tipLine[1356] = StringToText("僵怖：如果把假死的僵怖变为其他恶魔，他在城镇广场上将继续表现为死亡，");
    g_tipLine[1357] = StringToText("但在其他所有情况下都当作存活。");
    g_tipLine[1358] = StringToText("相克规则：");
    g_tipLine[1359] = StringToText("召唤师：如果存活的召唤师从游戏中离场，说书人会获得召唤师的能力。");
    g_tipLine[1360] = StringToText("军团：如果工程师创造了军团，所有邪恶玩家会变成军团。如果军团在场，工程师失去能力并改为得知这一信息。");
    g_tipLine[1361] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1362] = StringToText("梼杌：如果梼杌变成了其他恶魔，因为梼杌而失去能力的爪牙会立即死亡。");
    g_tipRoleAt[78] = 5541;   g_tipRoleN[78] = 44;
    g_tipLine[1363] = StringToText("【角色能力】");
    g_tipLine[1364] = StringToText("每局游戏限一次，在白天时，你可以让说书人给你一些能帮助你的阵营获胜的建议。");
    g_tipLine[1365] = StringToText("【角色简介】");
    g_tipLine[1366] = StringToText("渔夫知道其他人不知道的事情：接下来该做什么。");
    g_tipLine[1367] = StringToText("渔夫自由选择什么时候使用他的能力。");
    g_tipLine[1368] = StringToText("当渔夫拜访说书人时，说书人会给他一条建议。");
    g_tipLine[1369] = StringToText("说书人的建议不需要是事实。他是说书人觉得能帮助渔夫获胜的策略指示，如果他这样做的话。");
    g_tipLine[1370] = StringToText("如果渔夫醉酒或中毒，说书人可以给渔夫一条糟糕的建议。");
    g_tipRoleAt[79] = 7162;   g_tipRoleN[79] = 15;
    g_tipLine[1371] = StringToText("【角色能力】");
    g_tipLine[1372] = StringToText("当你在夜晚死亡时，一名存活的善良玩家会变成农夫。");
    g_tipLine[1373] = StringToText("【角色简介】");
    g_tipLine[1374] = StringToText("农夫能够创造更多的农夫。");
    g_tipLine[1375] = StringToText("如果一名农夫在夜晚死亡，会有另一名玩家变成农夫。");
    g_tipLine[1376] = StringToText("只有善良玩家能够通过这种方式变成农夫。");
    g_tipLine[1377] = StringToText("如果这名新的农夫也在夜晚死亡了，会再次有另一名农夫被创造出来。");
    g_tipLine[1378] = StringToText("在白天死亡的农夫，例如因处决而死亡，无法创造新的农夫。");
    g_tipLine[1379] = StringToText("已经转为邪恶阵营的农夫，例如受到灵言师的能力所影响，仍然可以创造新的农夫。");
    g_tipLine[1380] = StringToText("然而已经转为邪恶阵营的镇民和外来者无法因为这种方式被变成农夫。");
    g_tipLine[1381] = StringToText("农夫们之间不会互相认识，但是每名变成农夫的玩家都会得知他现在是农夫了。");
    g_tipLine[1382] = StringToText("当一名玩家变成农夫后，他不再是原本的角色，也不再拥有那个角色的能力。");
    g_tipLine[1383] = StringToText("所有与他原本能力相关的持续性效果都会立即终止。");
    g_tipLine[1384] = StringToText("【规则细节】");
    g_tipLine[1385] = StringToText("存活且善良的玩家才会因农夫的能力变成农夫，所以在农夫行动顺序之前已经死亡的玩家或已经转变为邪");
    g_tipLine[1386] = StringToText("恶阵营的玩家不会因农夫的能力变成农夫。");
    g_tipLine[1387] = StringToText("特定角色互动：");
    g_tipLine[1388] = StringToText("食人族/哲学家/小精灵：如果获得农夫能力的玩家在夜晚死亡，他会让一个存活善良玩家变成农夫，");
    g_tipLine[1389] = StringToText("而不是变成他原本实际的角色。");
    g_tipLine[1390] = StringToText("侍女：当晚如果一名玩家仅被唤醒告知角色变成农夫，他是因为之前农夫的能力被唤醒，");
    g_tipLine[1391] = StringToText("所以不会被侍女探查。然而，如果当晚该玩家在变成农夫之前因自身能力醒来，");
    g_tipLine[1392] = StringToText("尽管他现在拥有的是不同的能力，侍女仍会探查。");
    g_tipLine[1393] = StringToText("赌徒：如果赌徒已经赌错并死亡，他不能在当晚的晚些时候变成农夫，因为他已经死亡。");
    g_tipLine[1394] = StringToText("造谣者：如果当晚造谣者在行动顺序之前变成农夫，没有玩家会因造谣者而死，");
    g_tipLine[1395] = StringToText("因为造谣者这个角色离场了。然而，农夫可以因为造谣者的能力死亡后让造谣者自己变成农夫。");
    g_tipLine[1396] = StringToText("半兽人：如果半兽人杀死农夫，然后变成农夫，当晚恶魔能够造成死亡，因为场上不再有半兽人能力阻止恶魔的杀戮。");
    g_tipLine[1397] = StringToText("数学家：玩家变成农夫并且不再能够使用他之前的能力，数学家不会检测。");
    g_tipLine[1398] = StringToText("镇长：农夫可以代替镇长死亡，之后善良的镇长也可以变成农夫。");
    g_tipLine[1399] = StringToText("罂粟种植者：如果罂粟种植者变成农夫，邪恶阵营无法互认。");
    g_tipLine[1400] = StringToText("莽夫：可以变成农夫。先前的农夫玩家没有使用自身能力选择莽夫，是说书人选择，");
    g_tipLine[1401] = StringToText("所以莽夫不会导致之前的农夫醉酒。");
    g_tipLine[1402] = StringToText("间谍：可以被当作善良玩家，变成农夫。");
    g_tipLine[1403] = StringToText("旅行者：根据标准钟楼规则，旅行者不能改变角色，因此存活的善良旅行者无法变成农夫。");
    g_tipLine[1404] = StringToText("咖啡师：如果当晚因为咖啡师导致农夫能力生效两次，农夫的死亡会导致两名存活善良玩家变成农夫。");
    g_tipLine[1405] = StringToText("相克规则：");
    g_tipLine[1406] = StringToText("利维坦：每个夜晚*，利维坦要选择一名存活玩家（与之前的每个夜晚不同）：");
    g_tipLine[1407] = StringToText("如果农夫被选择，他的能力生效但不会死亡。");
    g_tipLine[1408] = StringToText("暴乱：每个夜晚*，暴乱要选择一名存活玩家（与之前的每个夜晚不同）：如果农夫被选择，");
    g_tipLine[1409] = StringToText("他的能力生效但不会死亡。");
    g_tipRoleAt[80] = 5593;   g_tipRoleN[80] = 40;
    g_tipLine[1410] = StringToText("【角色能力】");
    g_tipLine[1411] = StringToText("每局游戏你只能发起提名一次。当你发起提名时，如果被你提名的玩家不是恶魔，他死亡。");
    g_tipLine[1412] = StringToText("【角色简介】");
    g_tipLine[1413] = StringToText("魔像会杀死他提名的玩家。");
    g_tipLine[1414] = StringToText("当魔像提名了一名玩家后，那名玩家会立即死亡。提名流程会继续正常进行。");
    g_tipLine[1415] = StringToText("如果魔像提名了恶魔，无事发生。说书人无需对魔像的提名进行确认或否决，");
    g_tipLine[1416] = StringToText("而是继续如常进行投票流程。如果玩家有需要，说书人也可以说「无事发生」。");
    g_tipLine[1417] = StringToText("当魔像进行了一次提名之后，不论被他提名的人是否死亡，魔像在这局游戏中都不能再进行提名。");
    g_tipLine[1418] = StringToText("不再进行提名是玩家的责任而非说书人的责任，故意在不应该提名的情况下进行提名会被当作是作弊。");
    g_tipLine[1419] = StringToText("【规则细节】");
    g_tipLine[1420] = StringToText("特定角色互动：");
    g_tipLine[1421] = StringToText("弄臣/水手/茶艺师/暴风捕手：在满足能力要求的情况下都可以阻止魔像造成的死亡。");
    g_tipLine[1422] = StringToText("陌客：可以被当作恶魔，从而免于因魔像的能力而死。");
    g_tipLine[1423] = StringToText("修补匠：可以令修补匠在适当时刻死亡以（让对方）模拟魔像。");
    g_tipLine[1424] = StringToText("女巫：如果健康清醒且被女巫诅咒的魔像提名非恶魔玩家，说书人来决定谁的能力优先触发。");
    g_tipLine[1425] = StringToText("但通常是让魔像先触发，这样可以保证两个角色的能力都能正常生效。如果魔像提名的是女巫，");
    g_tipLine[1426] = StringToText("那么说书人就只能从其中选择一个能力来进行触发了（因为一个效果触发后导致一名玩家死亡，");
    g_tipLine[1427] = StringToText("另一个效果就无法被触发了）。");
    g_tipLine[1428] = StringToText("咖啡师：即使受到咖啡能力生效两次效果的影响，魔像仍被限制为每局游戏只能提名一次。");
    g_tipLine[1429] = StringToText("但当魔像提名时，被提名玩家会死亡两次。所以受咖啡行动两次效果影响的魔像可以在一次提名中直接杀");
    g_tipLine[1430] = StringToText("死一个未使用能力的弄臣。如果魔像已经使用了他唯一的一次提名机会，那么咖啡师对他没有任何效果。");
    g_tipRoleAt[81] = 3987;   g_tipRoleN[81] = 21;
    g_tipLine[1431] = StringToText("【角色能力】");
    g_tipLine[1432] = StringToText("所有爪牙都知道落难少女在场。每局游戏限一次，任意爪牙可以公开猜测你是落难少女，");
    g_tipLine[1433] = StringToText("如果猜对，你的阵营落败。");
    g_tipLine[1434] = StringToText("【角色简介】");
    g_tipLine[1435] = StringToText("落难少女需要避免被爪牙发现。");
    g_tipLine[1436] = StringToText("如果一名爪牙公开猜中了落难少女（因此所有玩家都知道他是爪牙），邪恶阵营获胜。");
    g_tipLine[1437] = StringToText("不论有多少爪牙在场，他们都仅仅只有一次猜测的机会。如果有爪牙做出了猜测但答案错误，");
    g_tipLine[1438] = StringToText("后续做出的任何猜测都不会再生效。");
    g_tipLine[1439] = StringToText("如果恶魔假装自己是爪牙并做出了猜测，这次猜测不会计算在内。爪牙仍然能够进行猜测并在猜中后获胜。");
    g_tipLine[1440] = StringToText("爪牙可以在任何时候做出猜测。");
    g_tipLine[1441] = StringToText("如果落难少女死亡，她将不再承担被爪牙猜中的风险，因为她在死亡时已经失去了能力。");
    g_tipLine[1442] = StringToText("巡山人并非一定会与落难少女一同出场。但如果巡山人在场，且在夜晚时选中了落难少女，");
    g_tipLine[1443] = StringToText("那么落难少女就会变成一个不在场的镇民，且不再是落难少女。落难少女会得知自己变成了哪一镇民，");
    g_tipLine[1444] = StringToText("且从那一刻起具有这一镇民的能力。");
    g_tipLine[1445] = StringToText("【规则细节】");
    g_tipLine[1446] = StringToText("如果落难少女玩家因巡山人变为具有设置调整能力的镇民，设置调整能力不会生效。");
    g_tipLine[1447] = StringToText("特定角色互动：");
    g_tipLine[1448] = StringToText("食人族：如果食人族获得落难少女的能力，爪牙可以通过猜测该玩家「是落难少女」让食人族玩家的阵营落败。");
    g_tipLine[1449] = StringToText("僧侣：僧侣只能在夜晚保护，并且针对的是恶魔而不是爪牙，所以僧侣的保护不会阻止爪牙正确猜测落难");
    g_tipLine[1450] = StringToText("少女并结束游戏。除了，一个正在照顾小怪宝的爪牙在夜晚进行猜测，此时落难少女被僧侣保护，");
    g_tipLine[1451] = StringToText("我将裁定在这种情况下游戏不会结束。（僧侣的保护能力能阻止恶魔通过触发落难少女的能力来获胜，");
    g_tipLine[1452] = StringToText("即使这个能力来自于落难少女而不是恶魔。）");
    g_tipLine[1453] = StringToText("理发师：如果落难少女被交换，你不需要重新告知爪牙落难少女在场，尽管落难少女的能力已经重新进场");
    g_tipLine[1454] = StringToText("，爪牙们会从之前的告知中继续知道落难少女在场。如果一名玩家之前不是爪牙，");
    g_tipLine[1455] = StringToText("然后被交换为爪牙角色，他会被告知落难少女在场。");
    g_tipLine[1456] = StringToText("莽夫：爪牙猜测莽夫是落难少女不会触发莽夫的阵营转换——爪牙没有使用自身能力选择莽夫。");
    g_tipLine[1457] = StringToText("陌客：可以被当作爪牙并猜测落难少女，并结束游戏。如果你是陌客，也许不去猜测是最好的！");
    g_tipLine[1458] = StringToText("理论上你可以在对应时刻将陌客当作爪牙并告诉他有落难少女在场，但请不要这样做。");
    g_tipLine[1459] = StringToText("红唇女郎/小恶魔：如果恶魔死亡，并且红唇女郎/某个爪牙变为恶魔，他不能猜测落难少女。");
    g_tipLine[1460] = StringToText("女巫：即使只有三名玩家存活，女巫失去能力，他仍然可以猜测落难少女");
    g_tipLine[1461] = StringToText("军团：军团由于被当作爪牙而能够猜测落难少女。");
    g_tipLine[1462] = StringToText("小怪宝：所有爪牙，包括那名正在照看宝宝而因此还被当作恶魔的爪牙，都会得知落难少女在场并能够进行猜测。");
    g_tipLine[1463] = StringToText("沙巴洛斯：如果落难少女被复活，爪牙同样不会被重新告知有落难少女在场，");
    g_tipLine[1464] = StringToText("他们在游戏开始时被告知就足够了。如果场上出现之前没有被告知过的新爪牙，");
    g_tipLine[1465] = StringToText("他会被告知。因此，最好不要让沙巴洛斯复活落难少女。如果在落难少女之前猜测机会已经使用过，");
    g_tipLine[1466] = StringToText("在落难少女复活的新场合中，猜测次数重置，因此爪牙还有一次猜测机会。");
    g_tipLine[1467] = StringToText("侍女：如果落难少女玩家因巡山人变成镇民角色的当晚被侍女选择，只有该玩家因为自身新能力醒来才会");
    g_tipLine[1468] = StringToText("被侍女算入已唤醒。落难少女玩家不是因为自身能力而醒来得知自己的新角色，");
    g_tipLine[1469] = StringToText("所以不会被侍女探查。");
    g_tipLine[1470] = StringToText("水手：如果落难少女因巡山人变为成水手，他在当晚不能选择与其他玩家喝酒，");
    g_tipLine[1471] = StringToText("因为水手的夜晚顺序已经过去了。因此这名（原落难少女）水手玩家在当晚和下一个白天都不会死亡。");
    g_tipLine[1472] = StringToText("相克规则：");
    g_tipLine[1473] = StringToText("麻脸巫婆：如果麻脸巫婆创造了落难少女，改为由说书人来决定哪一名玩家变成落难少女。");
    g_tipLine[1474] = StringToText("间谍/寡妇：如果间谍/寡妇正在场或曾经在场，落难少女中毒。");
    g_tipLine[1475] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1476] = StringToText("戏子（改）：落难少女不会因为戏子（改）的能力醉酒。");
    g_tipRoleAt[82] = 4008;   g_tipRoleN[82] = 45;
    g_tipLine[1477] = StringToText("【角色能力】");
    g_tipLine[1478] = StringToText("说书人可以打破游戏规则，如果说书人被处决，善良阵营获胜，即使你已死亡。");
    g_tipLine[1479] = StringToText("[无邪恶角色在场]");
    g_tipLine[1480] = StringToText("【角色简介】");
    g_tipLine[1481] = StringToText("无神论者会知道所有玩家均为善良，不存在任何恶魔。");
    g_tipLine[1482] = StringToText("如果无神论者会在游戏中出场，那么这局游戏就不会有邪恶玩家——没有爪牙，也没有恶魔。");
    g_tipLine[1483] = StringToText("善良玩家会在说书人被处决时获胜。任何存活玩家都可以提名说书人，并且如果存活玩家数量一半或以上");
    g_tipLine[1484] = StringToText("的玩家都参与投票，说书人就会被处决。（注：与常规的处决方式相同，所以仍然需要满足其他处决条件）");
    g_tipLine[1485] = StringToText("如果无神论者不在场，但说书人被处决了，那么邪恶阵营获胜。");
    g_tipLine[1486] = StringToText("善良阵营会在仅剩两名玩家存活时落败。");
    g_tipLine[1487] = StringToText("说书人可以打破游戏中的任何规则。他可以在一名玩家提名时杀死该玩家来模拟女巫的诅咒，");
    g_tipLine[1488] = StringToText("在夜晚杀死一名玩家来模拟恶魔的攻击，给出玩家错误的信息来模拟醉酒，在夜晚改变玩家的角色来模拟");
    g_tipLine[1489] = StringToText("麻脸巫婆的能力，甚至设置不符合常规数量的外来者在场。");
    g_tipLine[1490] = StringToText("【规则细节】");
    g_tipLine[1491] = StringToText("特定角色互动：");
    g_tipLine[1492] = StringToText("炸弹人：在无神论者对局中，说书人有可能决定一名特定玩家将拥有炸弹人的能力，");
    g_tipLine[1493] = StringToText("如果他被处决，将杀死除三名玩家外的所有玩家。如果你想这样做的话，你应该向玩家确认：");
    g_tipLine[1494] = StringToText("如果他们认为这是无神论者的对局，他们可以指向说书人，并且作为炸弹人能力的一部分，");
    g_tipLine[1495] = StringToText("会导致说书人「被杀」，并让玩家赢得游戏。");
    g_tipLine[1496] = StringToText("侍臣/旅店老板/吟游诗人/解谜大师/水手/心上人：（通常来说）无神论者成功中毒或醉酒将立即结");
    g_tipLine[1497] = StringToText("束游戏，因为没有存活恶魔，并且说书人不能再通过打破规则来阻止游戏结束。");
    g_tipLine[1498] = StringToText("建议打破规则来阻止这种事情的发生，因为这可能会导致一个不愉快的结局。");
    g_tipLine[1499] = StringToText("疯子：如果你让疯子在场，你需要将一个恶魔角色标记放入盲抽袋。然而，他只能是疯子而不是恶魔，");
    g_tipLine[1500] = StringToText("尽管他抽到的是红色标记。");
    g_tipLine[1501] = StringToText("提线木偶：如果你希望无神论者是提线木偶，你将需要使用提线木偶设置规则的方法2（参考提线木偶页");
    g_tipLine[1502] = StringToText("面），并且将恶魔设置为无神论者的邻座，以便让无神论者成为提线木偶。");
    g_tipLine[1503] = StringToText("政客：如果政客对他的阵营在无神论者对局中落败负最大责任，他可以转变为邪恶阵营并获胜。");
    g_tipLine[1504] = StringToText("相克规则：");
    g_tipLine[1505] = StringToText("暴乱：在暴乱的提名链中，如果说书人被提名，玩家要进行投票。如果说书人「即将被处决」，");
    g_tipLine[1506] = StringToText("游戏结束；否则，说书人要重新发起提名。");
    g_tipLine[1507] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1508] = StringToText("戏子：戏子无法反转处决说书人导致的胜负结果。");
    g_tipLine[1509] = StringToText("戏子（改）：戏子（改）无法反转处决说书人导致的胜负结果，无神论者不会因为戏子（改）的能力醉酒。");
    g_tipRoleAt[83] = 5633;   g_tipRoleN[83] = 34;
    g_tipLine[1510] = StringToText("【角色能力】");
    g_tipLine[1511] = StringToText("每个白天，在提名开始前，你可以公开选择一名玩家：他死亡。");
    g_tipLine[1512] = StringToText("如果你被处决，提名你的玩家需要和你猜拳，只有你输了你才会死亡。");
    g_tipLine[1513] = StringToText("【角色简介】");
    g_tipLine[1514] = StringToText("精神病患者在光天化日之下展开杀戮。");
    g_tipLine[1515] = StringToText("在白天时，如果精神病患者宣布自己是精神病患者并公开选择一名玩家，那名玩家死亡。");
    g_tipLine[1516] = StringToText("这个能力每个白天只能使用一次，且只能在说书人要求开始提名前进行。");
    g_tipLine[1517] = StringToText("精神病患者的能力并非强制使用，他可以在自己不想要使用能力时不这么做。");
    g_tipLine[1518] = StringToText("精神病患者能够正常被提名和投票。如果精神病患者被处决，他可能不会死亡。");
    g_tipLine[1519] = StringToText("他会和提名他的玩家进行一次猜拳（石头剪刀布）。提名他的玩家需要赢得猜拳才能让这次处决成功杀死");
    g_tipLine[1520] = StringToText("精神病患者。如果平局或者猜拳失败，精神病患者会仍然存活。");
    g_tipLine[1521] = StringToText("对精神病患者的处决同样计入每个白天限制一次的次数里。如果精神病患者被处决，");
    g_tipLine[1522] = StringToText("那么今天白天不会再有其他提名和处决发生了。");
    g_tipLine[1523] = StringToText("如果精神病患者因为其他原因死亡，例如恶魔的攻击，那么他不会进行猜拳，而是直接死亡。");
    g_tipLine[1524] = StringToText("【规则细节】");
    g_tipLine[1525] = StringToText("特定角色互动：");
    g_tipLine[1526] = StringToText("炼金术士：如果炼金术士获得精神病患者的能力并提名贞洁者而因此被处决，");
    g_tipLine[1527] = StringToText("他将会和说书人猜拳。");
    g_tipLine[1528] = StringToText("咖啡师：「行动两次」的效果将允许精神病患者在白天杀死2人（咖啡师可能会被立即流放），");
    g_tipLine[1529] = StringToText("但如果在接下来的这个白天精神病患者被处决，仍然只会进行一次猜拳。");
    g_tipLine[1530] = StringToText("屠夫：每天都可以重新提名精神病患者来进行第二次处决并尝试杀死他。");
    g_tipLine[1531] = StringToText("魔鬼代言人 ：即使受到魔鬼代言人的保护，精神病患者仍然应该进行猜拳，");
    g_tipLine[1532] = StringToText("只有当他输了时，善良阵营才会发现精神病患者受到了魔鬼代言人的保护，因为精神病患者没有死于一次");
    g_tipLine[1533] = StringToText("「猜拳胜利」的处决。");
    g_tipLine[1534] = StringToText("弄臣/水手/茶艺师：如果精神病患者的目标不能死亡，目标不会死亡。这会被数学家记录。");
    g_tipLine[1535] = StringToText("法官：如果法官强制使对精神病患者的提名通过，这只能确保精神病患者被处决，");
    g_tipLine[1536] = StringToText("并且将需要进行猜拳来确定他是否会死亡。");
    g_tipLine[1537] = StringToText("呆瓜/月之子：如果精神病患者杀死他，他会在白天得知他的死亡，因此必须在同一天做出选择。");
    g_tipLine[1538] = StringToText("亡骨魔：如果精神病患者被亡骨魔杀死并因此在死亡状态保留了他的能力，如果他在死亡状态被处决，");
    g_tipLine[1539] = StringToText("则没有必要进行猜拳——他已经死亡，因此无论猜拳的结果如何都不会再次死亡。");
    g_tipLine[1540] = StringToText("相克规则：");
    g_tipLine[1541] = StringToText("小怪宝：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[1542] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1543] = StringToText("姑获鸟：如果姑获鸟获得了精神病患者的能力，他会在被处决时死亡。");
    g_tipRoleAt[84] = 1510;   g_tipRoleN[84] = 34;
    g_tipLine[1544] = StringToText("【角色能力】");
    g_tipLine[1545] = StringToText("在你的首个夜晚，你会得知一个关键词。首个说出该关键词的善良玩家会在当晚转变为邪恶阵营。");
    g_tipLine[1546] = StringToText("【角色简介】");
    g_tipLine[1547] = StringToText("灵言师向善良玩家提出一笔交易：是否要转为邪恶。");
    g_tipLine[1548] = StringToText("在首个夜晚，灵言师从说书人处得知一个关键词。");
    g_tipLine[1549] = StringToText("如果善良玩家说出了关键词，不论是公开说出或是私下对说书人说出，他就会在当晚转为邪恶阵营。");
    g_tipLine[1550] = StringToText("前提条件是说书人需要实际听到那名玩家确切地说出了这个关键词。");
    g_tipLine[1551] = StringToText("灵言师不会得知是否有玩家转为了邪恶。说出关键词的善良玩家直到当晚才会得知他是否转为了邪恶。");
    g_tipLine[1552] = StringToText("如果灵言师在夜晚是清醒且健康的，那么即使他在白天善良玩家说出关键词时醉酒或中毒，");
    g_tipLine[1553] = StringToText("仍然会让这名善良玩家转为邪恶。但如果一名玩家即将在夜里转为邪恶时灵言师醉酒中毒了，");
    g_tipLine[1554] = StringToText("那么那名玩家会仍然保持善良阵营不变——灵言师会因此消耗他的能力的使用次数，");
    g_tipLine[1555] = StringToText("并且无法在随后再让其他玩家转为邪恶阵营。");
    g_tipRoleAt[85] = 1544;   g_tipRoleN[85] = 12;
    g_tipLine[1556] = StringToText("【角色能力】");
    g_tipLine[1557] = StringToText("爪牙和恶魔互相不认识。如果你死亡，当晚他们会互相认识。");
    g_tipLine[1558] = StringToText("【角色简介】");
    g_tipLine[1559] = StringToText("罂粟种植者能够阻止邪恶玩家互相认识。");
    g_tipLine[1560] = StringToText("恶魔仍然能够得知三个不在场的角色进行伪装。");
    g_tipLine[1561] = StringToText("如果罂粟种植者死亡，恶魔和爪牙会如同是首个夜晚一样互相认识。");
    g_tipLine[1562] = StringToText("如果罂粟种植者在游戏中途醉酒或中毒，不会立即使得恶魔和爪牙互相认识。");
    g_tipLine[1563] = StringToText("如果罂粟种植者在死亡时醉酒或中毒，因为他此时没有任何能力，因此恶魔和爪牙也不会互相认识。");
    g_tipLine[1564] = StringToText("邪恶的旅行者在加入游戏时仍然能够得知谁是恶魔。");
    g_tipLine[1565] = StringToText("【规则细节】");
    g_tipLine[1566] = StringToText("拥有爪牙或恶魔角色的玩家在罂粟种植者死亡时相互认识，无论阵营和生/死状态。");
    g_tipLine[1567] = StringToText("将罂粟种植者变成另一个角色，或罂粟种植者死亡时处于中毒或醉酒状态，将不会导致爪牙/恶魔互认。");
    g_tipLine[1568] = StringToText("特定角色互动：");
    g_tipLine[1569] = StringToText("学徒：如果学徒是邪恶阵营，仍然会知道恶魔是谁。 学徒罂粟种植者在被恶魔杀死或被流放后，");
    g_tipLine[1570] = StringToText("导致邪恶阵营互相认识，因为流放也会导致死亡。");
    g_tipLine[1571] = StringToText("食人族/小精灵：如果罂粟种植者被处决并被食人族吃掉或已经被足够疯狂的小精灵知晓，");
    g_tipLine[1572] = StringToText("食人族或小精灵将在罂粟种植者死亡的同时获得的罂粟种植者能力并阻止恶魔/爪牙互认。");
    g_tipLine[1573] = StringToText("军团：军团玩家不会知道其他军团玩家是谁，但需要单独唤醒他们以提供他们的三个不在场角色。");
    g_tipLine[1574] = StringToText("疯子：剧本里同时有罂粟种植者时，可以向疯子假装有罂粟种植者在场，从而在首夜不告诉疯子，");
    g_tipLine[1575] = StringToText("他的「爪牙」是谁。");
    g_tipLine[1576] = StringToText("数学家：首夜不会检测恶魔/爪牙没有互认，因为他们不是通过自身能力获得这些信息，");
    g_tipLine[1577] = StringToText("而是通过他们的角色类型。 然而，数学家会检测到罂粟种植者在死亡时中毒/醉酒并因此不允许恶魔/爪牙互认。");
    g_tipLine[1578] = StringToText("告密者：即使罂粟种植者在场，爪牙也会被单独唤醒并被展示三个不在场角色。");
    g_tipLine[1579] = StringToText("相克规则：");
    g_tipLine[1580] = StringToText("间谍：如果罂粟种植者拥有能力，间谍无法查看魔典。");
    g_tipLine[1581] = StringToText("寡妇：如果罂粟种植者拥有能力，寡妇无法查看魔典。");
    g_tipLine[1582] = StringToText("召唤师：如果罂粟种植者在第三个夜晚存活，由召唤师来选择创造哪种恶魔，");
    g_tipLine[1583] = StringToText("由说书人来决定哪名玩家发生转变。");
    g_tipLine[1584] = StringToText("小怪宝：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，直到其中一名玩家选择照看小怪宝。");
    g_tipLine[1585] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1586] = StringToText("鸩：如果鸩选择了罂粟种植者，罂粟种植者不会因为鸩的能力中毒。");
    g_tipLine[1587] = StringToText("孟婆：如果孟婆选中了罂粟种植者，罂粟种植者会得知自己被孟婆选中并死亡。");
    g_tipRoleAt[86] = 5667;   g_tipRoleN[86] = 34;
    g_tipLine[1588] = StringToText("【角色能力】");
    g_tipLine[1589] = StringToText("每个夜晚*，你可以选择三名玩家（所有玩家都会得知你选了谁）：他们分别秘密决定自己的生死，");
    g_tipLine[1590] = StringToText("然后如果他们都存活则都死亡。");
    g_tipLine[1591] = StringToText("【角色简介】");
    g_tipLine[1592] = StringToText("哈迪寂亚会让三名玩家一同陷入囚徒困境——究竟谁会选择死亡，来让其他人得以存活？");
    g_tipLine[1593] = StringToText("哈迪寂亚可以在除首个夜晚以外的每个夜晚选择三名玩家。所有玩家都会得知哈迪寂亚选择了哪些玩家。");
    g_tipLine[1594] = StringToText("在前一名被选择的玩家秘密做出自己的选择之后，才会公布下一名被选择的玩家。");
    g_tipLine[1595] = StringToText("在夜晚哈迪寂亚的能力生效期间，所有玩家必须保持沉默。从说书人首次宣布一名玩家被选择开始，");
    g_tipLine[1596] = StringToText("直至说书人宣布哈迪寂亚的能力结算完毕。");
    g_tipLine[1597] = StringToText("如果哈迪寂亚没有进行选择，说书人不会发出声明，当晚不会有玩家因哈迪寂亚的能力死亡。");
    g_tipLine[1598] = StringToText("在能力结算期间，说书人会大声询问被选择的玩家如何决定自己的生死。如果该玩家点头，");
    g_tipLine[1599] = StringToText("那么他存活。如果他摇头，那么他死亡。通过这个方式，可以让已经死亡的玩家复活。");
    g_tipLine[1600] = StringToText("如果在结算完毕这些玩家的选择之后他们都存活，那么他们会死亡。选择了死亡，");
    g_tipLine[1601] = StringToText("但因为某些效果使得仍然存活的玩家也会因此再次死亡。");
    g_tipLine[1602] = StringToText("哈迪寂亚可以不进行选择，当这种情况发生时，说书人不会宣布哈迪寂亚在场并选择玩家的播报，");
    g_tipLine[1603] = StringToText("夜晚继续进行，没有任何迹象表明恶魔还活着。");
    g_tipLine[1604] = StringToText("【规则细节】");
    g_tipLine[1605] = StringToText("已死亡的玩家如果选择「活着」，会被复活。");
    g_tipLine[1606] = StringToText("「如果他们都存活」判断条件不会关注这些玩家是如何做出选择的，而只看在这些选择结算后玩家是否存");
    g_tipLine[1607] = StringToText("活。选择「死去」的存活玩家如果受到免死能力的保护，会因此存活并计入「如果他们都存活」的判断条件。");
    g_tipLine[1608] = StringToText("如果哈迪寂亚醉酒或中毒，他在使用自己的能力时不会产生任何效果：玩家们不会被告知哈迪寂亚的效果");
    g_tipLine[1609] = StringToText("生效，哈迪寂亚的选择不会被宣布，被他选择的玩家不会被唤醒，不会有玩家因此被杀死或被复活，等等。");
    g_tipLine[1610] = StringToText("当哈迪寂亚死亡时，他如常失去自己的能力。此前被他杀死或复活的玩家依然保持当前的生死状态。");
    g_tipLine[1611] = StringToText("哈迪寂亚的能力不会再继续产生效果。在黎明时，如常宣布玩家生死状态的改变情况。");
    g_tipLine[1612] = StringToText("相克规则：");
    g_tipLine[1613] = StringToText("红唇女郎：如果即将出现两名存活的恶魔，其中之一是由红唇女郎转变的，则红唇女郎变成的恶魔会变回红唇女郎。");
    g_tipLine[1614] = StringToText("主谋：如果哈迪寂亚死于处决，且主谋存活，当晚哈迪寂亚要选择三名善良玩家：");
    g_tipLine[1615] = StringToText("如果他们都选择存活，邪恶阵营获胜。否则，善良阵营获胜。");
    g_tipLine[1616] = StringToText("公主：如果公主在首个白天提名并处决了一名玩家，没有人会因为哈迪寂亚而死亡。");
    g_tipLine[1617] = StringToText("(公主与哈迪寂亚角色互动结果本应如此，此条仅做说明)");
    g_tipRoleAt[87] = 1588;   g_tipRoleN[87] = 30;
    g_tipLine[1618] = StringToText("【角色能力】");
    g_tipLine[1619] = StringToText("在初始设置时，可能会额外增加或减少一个外来者。");
    g_tipLine[1620] = StringToText("【角色简介】");
    g_tipLine[1621] = StringToText("哨兵能够使你剧本中外来者的在场数量保持神秘。");
    g_tipLine[1622] = StringToText("官方的角色列表是经过精心设计的，所以外来者的数量永远不会被完全得知，");
    g_tipLine[1623] = StringToText("这使得邪恶阵营的玩家可以安全地将自己伪装成外来者。许多使用剧本工具创建的角色列表可能不会这么");
    g_tipLine[1624] = StringToText("严谨。如果由于种种原因，游戏中的外来者数量非常显而易见，说书人可以将哨兵加入游戏。");
    g_tipLine[1625] = StringToText("这将使得情况变得复杂，并且为邪恶阵营伪装成外来者提供了帮助，或使得在场的外来者看起来更可疑。");
    g_tipLine[1626] = StringToText("哨兵在场的游戏中可能会存在比起正常情况下多一个或少一个的外来者，也有可能保持正常的数量，");
    g_tipLine[1627] = StringToText("这取决于说书人。");
    g_tipRoleAt[88] = 1618;   g_tipRoleN[88] = 10;
    g_tipLine[1628] = StringToText("【角色能力】");
    g_tipLine[1629] = StringToText("游戏过程中邪恶玩家的总数最多能比初始设置多一名。");
    g_tipLine[1630] = StringToText("【角色简介】");
    g_tipLine[1631] = StringToText("圣洁之魂可以维持邪恶玩家的数量公平和平衡。");
    g_tipLine[1632] = StringToText("当通过剧本工具创造角色列表时，最好不要包含超过一个会添加邪恶玩家数量的角色。");
    g_tipLine[1633] = StringToText("如果有两名或多名玩家变成邪恶阵营，邪恶阵营可能会轻易获胜。因为他们只要揭露自己的角色，");
    g_tipLine[1634] = StringToText("就可以凭借人数优势用投票来取得胜利。通过加入圣洁之魂可以阻止过多的玩家转变为邪恶阵营，");
    g_tipLine[1635] = StringToText("以此创造一个对善良阵营更有趣、更公平的游戏。");
    g_tipLine[1636] = StringToText("当圣洁之魂在场时，标准阵营人数之外最多只会有一名玩家转变为邪恶阵营。");
    g_tipLine[1637] = StringToText("如果第二名玩家将要转变为邪恶阵营，该玩家会保持为善良阵营。");
    g_tipLine[1638] = StringToText("标准的邪恶玩家数量印在了旅行者列表和初始设置表上。");
    g_tipRoleAt[89] = 1628;   g_tipRoleN[89] = 11;
    g_tipLine[1639] = StringToText("【角色能力】");
    g_tipLine[1640] = StringToText("在你的首个夜晚，你会得知一名邪恶玩家。");
    g_tipLine[1641] = StringToText("每当你得知的玩家死亡，你会在当晚得知另一名邪恶玩家。[会有一名镇民转变为邪恶阵营]");
    g_tipLine[1642] = StringToText("【角色简介】");
    g_tipLine[1643] = StringToText("赏金猎人会一个个地追踪邪恶玩家。");
    g_tipLine[1644] = StringToText("在赏金猎人的首个夜晚，他会得知一名邪恶玩家。当赏金猎人得知的那名玩家死亡后，");
    g_tipLine[1645] = StringToText("他会再得知另一名邪恶玩家。");
    g_tipLine[1646] = StringToText("赏金猎人只会得知一名邪恶玩家，而不会得知他的具体角色。");
    g_tipLine[1647] = StringToText("如果赏金猎人在应当得知新玩家的时候醉酒或中毒了，说书人可以让赏金猎人得知一名善良玩家。");
    g_tipLine[1648] = StringToText("当这名玩家死亡后，赏金猎人会在当晚得知一名新玩家。");
    g_tipLine[1649] = StringToText("赏金猎人不会重复得知同一个邪恶玩家两次。");
    g_tipLine[1650] = StringToText("如果赏金猎人初始就加入了本局游戏，在设置调整阶段，会有一名镇民加入邪恶阵营。");
    g_tipLine[1651] = StringToText("赏金猎人可以得知这名邪恶的镇民玩家。");
    g_tipLine[1652] = StringToText("【规则细节】");
    g_tipLine[1653] = StringToText("请注意，赏金猎人在首个夜晚的行动顺序非常靠后。那是唤醒赏金猎人，向他展示他所得知的邪恶玩家的");
    g_tipLine[1654] = StringToText("时机。然而，被赏金猎人转变的玩家从一开始就已经属于邪恶阵营，应该在首个夜晚立即告知他是邪恶的");
    g_tipLine[1655] = StringToText("，并且你作为说书人应当在给出其他夜晚信息之前谨记这回事——那名玩家已经属于邪恶阵营，");
    g_tipLine[1656] = StringToText("尽管赏金猎人还未被唤醒。");
    g_tipLine[1657] = StringToText("如果赏金猎人醉酒或中毒或处于涡流在场的游戏中，在他能够得到信息的时候，");
    g_tipLine[1658] = StringToText("你可以（在涡流在场时必须）向他给出错误信息并展示一名善良玩家。如果赏金猎人在之后清醒，");
    g_tipLine[1659] = StringToText("他不会因此得知新的信息，即使他仍然认为那名善良玩家是邪恶的。当赏金猎人得知的玩家死亡，");
    g_tipLine[1660] = StringToText("他在当晚得知一名新的玩家。");
    g_tipLine[1661] = StringToText("如果「被得知」的邪恶玩家在之后转变为善良，这不会影响赏金猎人，赏金猎人为了获得进一步信息仍然");
    g_tipLine[1662] = StringToText("需要那名玩家死亡。");
    g_tipLine[1663] = StringToText("值得注意的是，如果你觉得赏金猎人已经获得过很多信息了，可以向他指出一名死亡的邪恶玩家。");
    g_tipLine[1664] = StringToText("死亡玩家不能再次死亡，所以赏金猎人不会获得新的信息，除非那名玩家被复活并再次被杀死。");
    g_tipLine[1665] = StringToText("对于旅行者，离开游戏和被流放都会导致他死亡——所以如果赏金猎人此前得知了一名旅行者，");
    g_tipLine[1666] = StringToText("上述两种情况都会使得赏金猎人在当晚获得新的信息。");
    g_tipRoleAt[90] = 5701;   g_tipRoleN[90] = 31;
    g_tipLine[1667] = StringToText("【角色能力】");
    g_tipLine[1668] = StringToText("在你的首个夜晚，你会得知一个在场的镇民角色。如果你「疯狂」地证明你是该角色，");
    g_tipLine[1669] = StringToText("当他死亡时你获得该角色的能力。");
    g_tipLine[1670] = StringToText("【角色简介】");
    g_tipLine[1671] = StringToText("小精灵会假装成与别人相同的角色。");
    g_tipLine[1672] = StringToText("在首个夜晚，小精灵会得知一个在场的镇民角色。由说书人来决定他得知的是哪个镇民角色。");
    g_tipLine[1673] = StringToText("小精灵不会知道哪名玩家是这个角色。");
    g_tipLine[1674] = StringToText("如果小精灵假装他是这个镇民，他会在对应的镇民玩家死亡时获得这个镇民角色的能力。");
    g_tipLine[1675] = StringToText("他可以只在某天里声称自己是这个角色，也可以每天都假装自己是这个角色，");
    g_tipLine[1676] = StringToText("或者指责那个镇民玩家说他是骗子——由说书人来判断小精灵是否有尝试在「疯狂」地证明自己是这个角色。");
    g_tipLine[1677] = StringToText("当那个镇民玩家死亡时，小精灵不会得知这一信息，也不会被告知自己获得了新的能力。");
    g_tipLine[1678] = StringToText("他可能会由于自己在夜晚被唤醒并获得信息或是被要求选择玩家，从而间接得知自己获得了能力。");
    g_tipLine[1679] = StringToText("如果小精灵得知的角色所对应的玩家他的角色发生了变化，并随后死亡，小精灵会获得他得知的那个角色");
    g_tipLine[1680] = StringToText("的能力，而非那名玩家死亡时的角色的能力。");
    g_tipLine[1681] = StringToText("【规则细节】");
    g_tipLine[1682] = StringToText("如果小精灵在得知信息时，因为醉酒中毒等原因导致得知了错误信息时，仍然会正常将他的「疯狂」标记");
    g_tipLine[1683] = StringToText("放置在一名镇民玩家的角色标记旁。只要小精灵在那名玩家死亡时清醒健康，");
    g_tipLine[1684] = StringToText("且说书人判断他足够疯狂，便能获得他所得知的那个镇民角色的能力（不一定是标记了「疯狂」的那名玩");
    g_tipLine[1685] = StringToText("家的角色能力，小精灵可以以此获得一个不在场的镇民角色能力）。");
    g_tipRoleAt[91] = 5732;   g_tipRoleN[91] = 20;
    g_tipLine[1686] = StringToText("【角色能力】");
    g_tipLine[1687] = StringToText("爪牙会在其首个夜晚得知三个伪装。");
    g_tipLine[1688] = StringToText("【角色简介】");
    g_tipLine[1689] = StringToText("告密者能够使邪恶阵营获得额外的信息。");
    g_tipLine[1690] = StringToText("告密者使得爪牙能够在游戏的首个夜晚得知三个不在场的角色，如同恶魔一样。");
    g_tipLine[1691] = StringToText("爪牙得知的三个不在场角色可能与恶魔得知的相同，也可能不同。");
    g_tipLine[1692] = StringToText("多名爪牙可能会得知不同的角色，也可能得知相同的角色。");
    g_tipRoleAt[92] = 4053;   g_tipRoleN[92] = 10;
    g_tipLine[1693] = StringToText("【角色能力】");
    g_tipLine[1694] = StringToText("你以为你是一个善良角色，但其实你不是。恶魔会知道你是提线木偶。[提线木偶会与恶魔邻座]");
    g_tipLine[1695] = StringToText("【角色简介】");
    g_tipLine[1696] = StringToText("提线木偶对自己是爪牙一事全然不知。");
    g_tipLine[1697] = StringToText("提线木偶会从盲抽袋中抽取到一个镇民或外来者角色，但是他实际上是提线木偶。");
    g_tipLine[1698] = StringToText("提线木偶与恶魔是邻座。他们之间不会有其他的玩家。");
    g_tipLine[1699] = StringToText("恶魔会知道哪一名玩家是提线木偶。");
    g_tipLine[1700] = StringToText("提线木偶不会在游戏的首个夜晚被唤醒以得知其他邪恶玩家都有谁，其他爪牙也不会得知谁是提线木偶。");
    g_tipLine[1701] = StringToText("认为自己是提线木偶的玩家所抽取到的善良角色对应的能力不会产生任何效果，");
    g_tipLine[1702] = StringToText("但说书人会假装这些效果生效了。这与酒鬼的运作方式相似。");
    g_tipLine[1703] = StringToText("提线木偶在互动时被当作邪恶阵营以及爪牙角色。");
    g_tipLine[1704] = StringToText("提线木偶不会因其他角色能力导致他确认自己是爪牙而被唤醒。例如：告密者，");
    g_tipLine[1705] = StringToText("传教士，小怪宝，罂粟种植者，帽匠，落难少女等。");
    g_tipRoleAt[93] = 1693;   g_tipRoleN[93] = 13;
    g_tipLine[1706] = StringToText("【角色能力】");
    g_tipLine[1707] = StringToText("每个夜晚*，可能有一名玩家死亡。如果一项提名只有邪恶玩家投票，投票无效。");
    g_tipLine[1708] = StringToText("你也会被当作是爪牙。[多数玩家为军团]");
    g_tipLine[1709] = StringToText("【角色简介】");
    g_tipLine[1710] = StringToText("军团由多个恶魔组成。");
    g_tipLine[1711] = StringToText("如果军团在场，推荐将在场善良和邪恶玩家的数量在通常的数量上进行反转。");
    g_tipLine[1712] = StringToText("例如，在一局十人游戏中，你可以采取近似七名军团和三名善良玩家的设置。");
    g_tipLine[1713] = StringToText("非军团的玩家可以是镇民也可以是外来者，由说书人来决定这些善良玩家的角色类型组合方式。");
    g_tipLine[1714] = StringToText("如果一项提名中至少有一名善良玩家参与投票，并且被提名的玩家「即将被处决」，");
    g_tipLine[1715] = StringToText("那么在处决阶段时处决会正常发生。如果一项提名中只有邪恶玩家参与了投票，");
    g_tipLine[1716] = StringToText("那么在统计票数的时候会记为零票。");
    g_tipLine[1717] = StringToText("每名军团在互动时被当作恶魔，同时也被当作爪牙。");
    g_tipLine[1718] = StringToText("由说书人来决定哪一名玩家会在夜晚死亡。");
    g_tipLine[1719] = StringToText("如果游戏中只剩一名善良玩家存活，说书人可以宣布邪恶阵营获胜，因为在这种条件下善良阵营无法获胜。");
    g_tipLine[1720] = StringToText("说书人可以不向军团提供恶魔的伪装。");
    g_tipLine[1721] = StringToText("炼金术士（镇民）");
    g_tipLine[1722] = StringToText("【角色能力】");
    g_tipLine[1723] = StringToText("你拥有一个爪牙角色的能力。当你使用能力时，说书人可能会要求你更换");
    g_tipLine[1724] = StringToText("选择。");
    g_tipLine[1725] = StringToText("【角色简介】");
    g_tipLine[1726] = StringToText("炼金术士具有爪牙的能力。");
    g_tipLine[1727] = StringToText("炼金术士通常会获得一个不在场爪牙的能力，但可以获得一个在场爪牙的");
    g_tipLine[1728] = StringToText("能力。");
    g_tipLine[1729] = StringToText("炼金术士会在自己的首个夜晚得知自己获得了哪一项爪牙的能力。");
    g_tipLine[1730] = StringToText("炼金术士仍然是善良的镇民。他会在善良阵营获胜时一同获胜，也会在善");
    g_tipLine[1731] = StringToText("良阵营落败时一同落败。他被当作善良阵营的炼金术士。");
    g_tipLine[1732] = StringToText("不同于一般的爪牙，炼金术士不会被唤醒以得知其他爪牙以及恶魔分别是");
    g_tipLine[1733] = StringToText("哪些玩家。");
    g_tipLine[1734] = StringToText("如果炼金术士获得的爪牙能力会导致在设置阶段添加或移除角色，这一能");
    g_tipLine[1735] = StringToText("力也会在设置阶段生效。");
    g_tipLine[1736] = StringToText("如果炼金术士获得了一个可以选择的能力，比如投毒者或维齐尔，说书人");
    g_tipLine[1737] = StringToText("可以让炼金术士换个选择，炼金术士就必须更换自己的选择。");
    g_tipLine[1738] = StringToText("【规则细节】");
    g_tipLine[1739] = StringToText("特定角色互动：");
    g_tipLine[1740] = StringToText("学徒 ：善良学徒可以获得炼金术士的能力，进而获得一个爪牙的能力。");
    g_tipLine[1741] = StringToText("赏金猎人 ：赏金猎人可以让炼金术士转变为邪恶，让爪牙能力回归邪恶");
    g_tipLine[1742] = StringToText("阵营。");
    g_tipLine[1743] = StringToText("洗脑师 ：无论洗脑师或炼金洗脑师，告知目标玩家「疯狂」的流程都一");
    g_tipLine[1744] = StringToText("样，对该玩家展示洗脑师角色标记和需要「疯狂」的角色标记。");
    g_tipLine[1745] = StringToText("侍女 ：炼金术士会在第一夜被唤醒得知他获得了什么爪牙能力，之后是");
    g_tipLine[1746] = StringToText("否被唤醒取决于他获得的爪牙能力。");
    g_tipLine[1747] = StringToText("镜像双子 ：如果炼金术士获得镜像双子能力，则将一名邪恶玩家设置为");
    g_tipLine[1748] = StringToText("他的「对立双子」。如果这名善良的炼金双子被处决，邪恶阵营获胜。");
    g_tipLine[1749] = StringToText("恐惧之灵 ：获得恐惧之灵能力的炼金术士在夜晚触发的公开宣布与恐惧");
    g_tipLine[1750] = StringToText("之灵相同：「恐惧之灵选择了一名玩家」。");
    g_tipLine[1751] = StringToText("哥布林 ：炼金哥布林触发哥布林能力需要声明自己是哥布林，而不是炼");
    g_tipLine[1752] = StringToText("金哥布林。实际上，如果不允许将这两种情况当作同样处理，也太过于为");
    g_tipLine[1753] = StringToText("难玩家了。");
    g_tipLine[1754] = StringToText("军团 ：炼金术士无法获得军团的能力。");
    g_tipLine[1755] = StringToText("小怪宝 ：炼金术士不是爪牙，所以不会在为秘密决定由哪名玩家照看小");
    g_tipLine[1756] = StringToText("怪宝时醒来。");
    g_tipLine[1757] = StringToText("精神病患者 ：当炼金精神病患者发动能力选择一名玩家时，说书人可以");
    g_tipLine[1758] = StringToText("公开要求他重新选择一名玩家，他必须更换选择。（说书人也可以要求精");
    g_tipLine[1759] = StringToText("神病患者重新选择一名玩家，他可以不更换选择）");
    g_tipLine[1760] = StringToText("相克规则：");
    g_tipLine[1761] = StringToText("寡妇 ：如果炼金术士本应获得寡妇的能力，那么他不会拥有该能力并改");
    g_tipLine[1762] = StringToText("为寡妇一定在场。每次处决后，存活的炼金术士可以公开猜测一名存活玩");
    g_tipLine[1763] = StringToText("家是寡妇：如果猜对了，恶魔当晚必须选择寡妇。");
    g_tipLine[1764] = StringToText("间谍 ：如果炼金术士本应获得间谍的能力，那么他不会拥有该能力并改");
    g_tipLine[1765] = StringToText("为间谍一定在场。每次处决后，存活的炼金术士可以公开猜测一名存活玩");
    g_tipLine[1766] = StringToText("家是间谍：如果猜对了，恶魔当晚必须选择间谍。");
    g_tipLine[1767] = StringToText("召唤师 ：获得召唤师能力的炼金术士不会获得伪装。他要选择一个恶魔");
    g_tipLine[1768] = StringToText("角色，但不选择玩家，由说书人决定哪一名玩家变成邪恶的恶魔。如果他");
    g_tipLine[1769] = StringToText("在选择之前死亡，邪恶阵营获胜。[无恶魔在场]");
    g_tipLine[1770] = StringToText("科学怪人 ：如果炼金术士拥有科学怪人的能力，炼金术士不会得知恶魔");
    g_tipLine[1771] = StringToText("因此获得了哪个角色的能力。");
    g_tipLine[1772] = StringToText("亡魂 ：如果炼金术士本应获得亡魂的能力，那么他不会拥有该能力并改");
    g_tipLine[1773] = StringToText("为亡魂一定在场。每次处决后，存活的炼金术士可以公开猜测一名存活玩");
    g_tipLine[1774] = StringToText("家是亡魂：如果猜对了，恶魔当晚必须选择亡魂。");
    g_tipLine[1775] = StringToText("提线木偶 ：如果炼金术士本应获得提线木偶的能力，那么他不会拥有该");
    g_tipLine[1776] = StringToText("能力并改为提线木偶一定在场。");
    g_tipLine[1777] = StringToText("主谋 ：如果炼金术士本应获得主谋的能力，那么他不会拥有该能力并改");
    g_tipLine[1778] = StringToText("为主谋一定不在场。");
    g_tipLine[1779] = StringToText("街头风琴手 ：如果炼金术士获得街头风琴手的能力，街头风琴手一定在");
    g_tipLine[1780] = StringToText("场。如果炼金术士和街头风琴手都是清醒的，改为他们都醉酒。");
    g_tipLine[1781] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1782] = StringToText("蛊雕 ：如果炼金术士本应获得蛊雕的能力，那么他不会拥有该能力并改");
    g_tipLine[1783] = StringToText("为蛊雕一定在场。每次处决后，存活的炼金术士可以公开猜测一名存活玩");
    g_tipLine[1784] = StringToText("家是蛊雕：如果猜对了，恶魔当晚必须选择蛊雕。");
    g_tipLine[1785] = StringToText("将军（镇民）");
    g_tipLine[1786] = StringToText("【角色能力】");
    g_tipLine[1787] = StringToText("每个夜晚，你会得知说书人认为哪个阵营当前更有优势（善良/邪恶/均");
    g_tipLine[1788] = StringToText("势）。");
    g_tipLine[1789] = StringToText("【角色简介】");
    g_tipLine[1790] = StringToText("将军清楚哪个阵营更具有优势。");
    g_tipLine[1791] = StringToText("如果善良阵营更具优势，说书人会给出大拇指朝上的手势。如果邪恶阵营");
    g_tipLine[1792] = StringToText("更具优势，说书人会给出大拇指朝下的手势。如果双方阵营势均力敌，或");
    g_tipLine[1793] = StringToText("说书人并不确信哪一方更具优势，说书人会给出大拇指水平指向一侧的手");
    g_tipLine[1794] = StringToText("势。");
    g_tipLine[1795] = StringToText("说书人需要对阵营的优势做出判断。很多因素都会作为考量，例如每个阵");
    g_tipLine[1796] = StringToText("营有多少存活的玩家，善良阵营获取的信息程度如何，邪恶阵营的伪装的");
    g_tipLine[1797] = StringToText("取信程度如何，玩家们即将打算处决谁，或是恶魔玩家的游戏经验是否丰");
    g_tipLine[1798] = StringToText("富。上述所有内容以及一些其他因素都会影响说书人的判断。");
    g_tipLine[1799] = StringToText("说书人判断的是将军被唤醒的那一刻更具有优势的阵营。当晚较早时段里");
    g_tipLine[1800] = StringToText("发生的事情也可能会影响判断。");
    g_tipLine[1801] = StringToText("政客（外来者）");
    g_tipLine[1802] = StringToText("【角色能力】");
    g_tipLine[1803] = StringToText("如果你是对你的阵营落败负最大责任的人，你转变阵营并获胜，即使你已");
    g_tipLine[1804] = StringToText("死亡。");
    g_tipLine[1805] = StringToText("【角色简介】");
    g_tipLine[1806] = StringToText("如果政客落败，政客可以转变他的阵营。");
    g_tipLine[1807] = StringToText("当游戏结束时，如果政客是善良阵营落败负最大责任的人，政客会加入邪");
    g_tipLine[1808] = StringToText("恶阵营并一起获胜。");
    g_tipLine[1809] = StringToText("当决定谁获胜的关键时候，政客玩家应当非常有影响力。简单的散布错误");
    g_tipLine[1810] = StringToText("信息或投票善良玩家通常是不够的——他需要比任何一个其他的善良玩家");
    g_tipLine[1811] = StringToText("起到让善良阵营落败的关键作用，同时最好也是比任何一个邪恶玩家的作");
    g_tipLine[1812] = StringToText("用大。由说书人决定政客是否符合条件。");
    g_tipLine[1813] = StringToText("政客也可以和其他角色一样，以善良阵营获胜。");
    g_tipLine[1814] = StringToText("中毒或醉酒的政客不能转变阵营。");
    g_tipLine[1815] = StringToText("如果邪恶玩家的总数已经比初始设置多了一名，即使政客是对善良阵营落");
    g_tipLine[1816] = StringToText("败负最大责任的人，由于圣洁之魂的存在，也不能转变阵营获胜。");
    g_tipLine[1817] = StringToText("【规则细节】");
    g_tipLine[1818] = StringToText("相克规则：");
    g_tipLine[1819] = StringToText("麻脸巫婆 ：被麻脸巫婆创造的邪恶政客无法因为自身能力转变为善良阵");
    g_tipLine[1820] = StringToText("营。");
    g_tipLine[1821] = StringToText("维齐尔 ：维齐尔的能力可能会将政客当作邪恶阵营。");
    g_tipLine[1822] = StringToText("科学怪人 ：恶魔无法拥有政客的能力。");
    g_tipLine[1823] = StringToText("军团 ：政客可能会被军团当作邪恶玩家。");
    g_tipLine[1824] = StringToText("巫师（爪牙）");
    g_tipLine[1825] = StringToText("【角色能力】");
    g_tipLine[1826] = StringToText("每局游戏限一次，你可以向说书人许愿。如果愿望被实现，可能会伴随着");
    g_tipLine[1827] = StringToText("代价和线索。");
    g_tipLine[1828] = StringToText("【角色简介】");
    g_tipLine[1829] = StringToText("巫师许下愿望。");
    g_tipLine[1830] = StringToText("这个愿望只受限于玩家的想象力，它可以是任何事。巫师可以在夜晚用手");
    g_tipLine[1831] = StringToText("机屏幕展示愿望内容给说书人，也可以在白天私下告诉说书人。如果巫师");
    g_tipLine[1832] = StringToText("有些鲁莽，他也可以公开许愿。");
    g_tipLine[1833] = StringToText("说书人不必立刻公开宣布巫师许下了愿望，而是可以稍后再宣布。");
    g_tipLine[1834] = StringToText("许多愿望都伴随着代价。代价可能会以某种方式影响游戏，或是影响这个");
    g_tipLine[1835] = StringToText("愿望本身。它也可以是任何事，由说书人认真思考后决定。说书人可以决");
    g_tipLine[1836] = StringToText("定是否告诉巫师愿望的代价。代价的目的是为了从能力的效果上平衡这个");
    g_tipLine[1837] = StringToText("愿望，以免它对善良阵营造成不公平的影响。");
    g_tipLine[1838] = StringToText("许多愿望会留下线索。线索可以是任何事，由说书人认真思考后决定，然");
    g_tipLine[1839] = StringToText("后再公开宣布。线索的目的是为了从信息上平衡这个愿望，以免它对善良");
    g_tipLine[1840] = StringToText("阵营造成不公平的影响。");
    g_tipLine[1841] = StringToText("当巫师死亡，愿望可能会继续生效，也可能会失效，取决于愿望和代价具");
    g_tipLine[1842] = StringToText("体是什么。");
    g_tipLine[1843] = StringToText("如果巫师许了一个说书人不理解的愿望，或者说书人认为他无法实现，说");
    g_tipLine[1844] = StringToText("书人可以让巫师重新许愿，或者告诉巫师，他的愿望被消耗了。");
    g_tipLine[1845] = StringToText("哥布林（爪牙）");
    g_tipLine[1846] = StringToText("【角色能力】");
    g_tipLine[1847] = StringToText("如果你在被提名后公开声明自己是哥布林且在那个白天被处决，你的阵营");
    g_tipLine[1848] = StringToText("获胜。");
    g_tipLine[1849] = StringToText("【角色简介】");
    g_tipLine[1850] = StringToText("哥布林会在小镇明知他是哥布林却要处决他时采取报复。");
    g_tipLine[1851] = StringToText("如果哥布林被处决，邪恶阵营获胜。");
    g_tipLine[1852] = StringToText("为了让这种情况发生，哥布林需要在被提名后，开始投票前告知其他玩家");
    g_tipLine[1853] = StringToText("他是哥布林。他的公开宣言需要让所有人都听见，因为善良玩家必须清楚");
    g_tipLine[1854] = StringToText("自己接下来的行为所带来的风险。");
    g_tipLine[1855] = StringToText("如果哥布林没有公布自己的角色就被处决了，那么哥布林死亡，游戏如常");
    g_tipLine[1856] = StringToText("进行。");
    g_tipLine[1857] = StringToText("哥布林必须在被处决的当天宣布自己的角色，只有这样他的能力才会生效");
    g_tipLine[1858] = StringToText("。在前一天或更早的时间里宣布不会产生效果。");
    g_tipLine[1859] = StringToText("任何玩家都可以在被提名时声称自己是哥布林。");
    g_tipLine[1860] = StringToText("【规则细节】");
    g_tipLine[1861] = StringToText("相克规则：");
    g_tipLine[1862] = StringToText("瘟疫医生 ：如果说书人本应获得哥布林的能力，改为一名爪牙玩家获得");
    g_tipLine[1863] = StringToText("此能力，且他会得知此事。");
    g_tipLine[1864] = StringToText("洗脑师 ：洗脑师可以选择将玩家洗脑成哥布林。");
    g_tipLine[1865] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1866] = StringToText("戏子 ：戏子无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[1867] = StringToText("戏子（改） ：戏子（改）无法反转由哥布林的能力产生的胜负结果。");
    g_tipLine[1868] = StringToText("姑获鸟 ：姑获鸟无法获得哥布林的能力。");
    g_tipLine[1869] = StringToText("痢蛭（恶魔）");
    g_tipLine[1870] = StringToText("【角色能力】");
    g_tipLine[1871] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。在你的首个夜晚，你要选择一");
    g_tipLine[1872] = StringToText("名存活的玩家：他中毒，只有当他处于死亡状态时你才会立即死亡。");
    g_tipLine[1873] = StringToText("【角色简介】");
    g_tipLine[1874] = StringToText("痢蛭在宿主存活时存活，在宿主死亡时死亡。");
    g_tipLine[1875] = StringToText("在首个夜晚，痢蛭会选择一名玩家，被选择的玩家会在游戏的剩余时间内");
    g_tipLine[1876] = StringToText("都处于中毒状态。");
    g_tipLine[1877] = StringToText("如果这名玩家存活，痢蛭就不会死亡。如果痢蛭被处决，说书人会告诉大");
    g_tipLine[1878] = StringToText("家这名玩家仍然存活，但不会说明原因。");
    g_tipLine[1879] = StringToText("如果这名首夜被痢蛭选择的玩家死亡，痢蛭也会死亡。如果此时只剩一名");
    g_tipLine[1880] = StringToText("或两名玩家存活，那么善良阵营还是会获胜，因为恶魔死亡了。");
    g_tipLine[1881] = StringToText("从第二个夜晚开始，痢蛭会攻击并杀死玩家，但不会让他中毒。");
    g_tipLine[1882] = StringToText("如果痢蛭在游戏过程中被创造，他会在当晚令一名玩家中毒。他必须要选");
    g_tipLine[1883] = StringToText("择一名存活的玩家。");
    g_tipLine[1884] = StringToText("【规则细节】");
    g_tipLine[1885] = StringToText("当痢蛭醉酒或中毒时，宿主恢复健康。如果宿主在这个期间死亡，痢蛭不");
    g_tipLine[1886] = StringToText("会受到影响，当痢蛭恢复清醒/健康后会立即死亡。如果痢蛭在醉酒或中");
    g_tipLine[1887] = StringToText("毒时死亡，他死亡，因为他的能力在醉酒/中毒时无法阻止死亡。如果痢");
    g_tipLine[1888] = StringToText("蛭的宿主醉酒/中毒，对痢蛭没有影响。");
    g_tipLine[1889] = StringToText("痢蛭仍然是恶魔，宿主仍然是他相应的角色类型，痢蛭对宿主的选择不会");
    g_tipLine[1890] = StringToText("对他的角色产生任何改变。注意，宿主可以是任何存活玩家，不管是什么");
    g_tipLine[1891] = StringToText("角色类型。");
    g_tipLine[1892] = StringToText("特定角色互动：");
    g_tipLine[1893] = StringToText("驱魔人 ：如果痢蛭在他的首个夜晚之后被驱魔，他不会醒来，但宿主仍");
    g_tipLine[1894] = StringToText("然中毒，并且除非宿主死亡，痢蛭不会死。如果痢蛭在游戏过程中被创造");
    g_tipLine[1895] = StringToText("，因为痢蛭的「选择玩家让他中毒」的能力属于进场能力且不属于信息类");
    g_tipLine[1896] = StringToText("能力，所以该能力会尽可能快地进行结算，从而使得在轮到驱魔人行动时");
    g_tipLine[1897] = StringToText("，如果驱魔人选中了痢蛭，也不会因为「痢蛭无法因为自己的能力被唤醒");
    g_tipLine[1898] = StringToText("」而导致「痢蛭没有宿主」的情况出现。");
    g_tipLine[1899] = StringToText("士兵 ：如果士兵被痢蛭选为宿主，他不会中毒。然而，如果他因为任何");
    g_tipLine[1900] = StringToText("原因死亡（被处决，半兽人等等），痢蛭也会死亡。");
    g_tipLine[1901] = StringToText("莽夫 ：如果莽夫在首个夜晚被选为宿主，这会使得痢蛭醉酒直到下个黄");
    g_tipLine[1902] = StringToText("昏，并且莽夫变为邪恶。如果莽夫在首个白天被处决，痢蛭仍然会死亡，");
    g_tipLine[1903] = StringToText("因为莽夫的醉酒效果由于莽夫的死亡而消失了。莽夫在整局游戏中都不会");
    g_tipLine[1904] = StringToText("因为痢蛭的能力中毒（可以将痢蛭的中毒标记倒转放置在莽夫的角色标记");
    g_tipLine[1905] = StringToText("旁，仅做寄生的提示用），但如果他死亡，痢蛭也会死亡。");
    g_tipLine[1906] = StringToText("疯子 ：如果疯子自认为是痢蛭，真正的恶魔会被告知疯子在首个夜晚选");
    g_tipLine[1907] = StringToText("择谁作为宿主，但是，举例来说，这与疯子自认为是 普卡 并在首个夜");
    g_tipLine[1908] = StringToText("晚做出选择没有什么区别——真正的恶魔不会知道这里面的区别。");
    g_tipLine[1909] = StringToText("麻脸巫婆 ：如果创造出新的恶魔，仍然需要杀死宿主才能杀死痢蛭，麻");
    g_tipLine[1910] = StringToText("脸巫婆不能无视痢蛭免死的能力。");
    g_tipLine[1911] = StringToText("旅行者 ：可以被选为宿主，但不建议。因为如果旅行者离开，他死亡，");
    g_tipLine[1912] = StringToText("并且痢蛭因此死亡。");
    g_tipLine[1913] = StringToText("咖啡师 ：如果咖啡2不是在首个夜晚，痢蛭可以杀害两次。如果咖啡2");
    g_tipLine[1914] = StringToText("在首个夜晚，痢蛭选择两名玩家，从现在开始他们两个都中毒。无论如何");
    g_tipLine[1915] = StringToText("，必须这两名玩家都死亡，痢蛭才会死亡。");
    g_tipLine[1916] = StringToText("相克规则：");
    g_tipLine[1917] = StringToText("猎手 ：如果猎手选择了痢蛭的宿主，则宿主会死亡。");
    g_tipLine[1918] = StringToText("主谋 ：如果主谋存活且痢蛭的宿主死于处决，痢蛭存活但失去能力。");
    g_tipLine[1919] = StringToText("异端分子 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1920] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1921] = StringToText("半仙 ：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[1922] = StringToText("使节 ：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[1923] = StringToText("掮客 ：痢蛭的宿主及其中毒效果无法被转移。");
    g_tipLine[1924] = StringToText("异端分子（外来者）");
    g_tipLine[1925] = StringToText("【角色能力】");
    g_tipLine[1926] = StringToText("对调胜负结果，即使你已死亡。");
    g_tipLine[1927] = StringToText("【角色简介】");
    g_tipLine[1928] = StringToText("异端分子能够转换胜负结果。");
    g_tipLine[1929] = StringToText("如果一局游戏会使得善良阵营获胜，异端分子会导致所有善良玩家落败，");
    g_tipLine[1930] = StringToText("且邪恶玩家获胜。");
    g_tipLine[1931] = StringToText("如果一局游戏将由邪恶阵营获胜而结束，邪恶玩家落败，善良玩家获胜。");
    g_tipLine[1932] = StringToText("异端分子的能力会应用于所有的胜利条件，包括只剩两名非旅行者玩家存");
    g_tipLine[1933] = StringToText("活，所有恶魔死亡，或一项能力导致的游戏结束。");
    g_tipLine[1934] = StringToText("异端分子的能力在他死亡时仍然正常生效，但在他醉酒中毒时不会生效。");
    g_tipLine[1935] = StringToText("【规则细节】");
    g_tipLine[1936] = StringToText("特定角色互动：");
    g_tipLine[1937] = StringToText("食人族 ：（参考最新的 处决 流程整理）如果异端分子被处决并导致");
    g_tipLine[1938] = StringToText("游戏结束，食人族不会获得异端分子的能力。");
    g_tipLine[1939] = StringToText("将军 ：将军的信息应该将异端分子考虑在内。如果善良阵营已经非常接");
    g_tipLine[1940] = StringToText("近找出并处决恶魔，但异端分子在场，因为处决恶魔会导致邪恶阵营获胜");
    g_tipLine[1941] = StringToText("，所以应该展示邪恶更有优势。");
    g_tipLine[1942] = StringToText("哲学家 ：如果哲学家选择异端分子，随后死亡，哲学家仍然保留这个能");
    g_tipLine[1943] = StringToText("力，因为那是「死后能力保留」的能力。然而，原始异端分子也会在哲学");
    g_tipLine[1944] = StringToText("家死亡时恢复清醒，这意味着游戏中有两个正常生效的异端分子能力。");
    g_tipLine[1945] = StringToText("镜像双子 ：异端分子的能力只有在游戏因为满足某个胜利条件而结束的");
    g_tipLine[1946] = StringToText("时候才会生效。所以镜像双子将会阻止因善良阵营获胜而结束游戏，但如");
    g_tipLine[1947] = StringToText("果游戏因邪恶阵营获胜而结束，异端分子能力会生效并转为让善良阵营获");
    g_tipLine[1948] = StringToText("胜。");
    g_tipLine[1949] = StringToText("相克规则：");
    g_tipLine[1950] = StringToText("教父 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1951] = StringToText("间谍 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1952] = StringToText("寡妇 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1953] = StringToText("麻脸巫婆 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1954] = StringToText("痢蛭 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1955] = StringToText("男爵 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1956] = StringToText("科学怪人 ：恶魔无法拥有异端分子的能力。");
    g_tipLine[1957] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1958] = StringToText("狐媚娘 ：互为克星的角色在同一时间里只能有其中一个角色在场。");
    g_tipLine[1959] = StringToText("恐惧之灵（爪牙）");
    g_tipLine[1960] = StringToText("【角色能力】");
    g_tipLine[1961] = StringToText("每个夜晚，你要选择一名玩家：如果你提名他且他被处决，他的阵营落败");
    g_tipLine[1962] = StringToText("。当你首次选择或更换目标时，所有玩家都会得知你选择了新的玩家。");
    g_tipLine[1963] = StringToText("【角色简介】");
    g_tipLine[1964] = StringToText("恐惧之灵在提名中掺入猜疑。");
    g_tipLine[1965] = StringToText("在游戏的首个夜晚，恐惧之灵选择了一名玩家后，所有玩家都会得知这件");
    g_tipLine[1966] = StringToText("事情。");
    g_tipLine[1967] = StringToText("在其他夜晚，每当恐惧之灵选择了与上次选择不同的一名玩家后，所有玩");
    g_tipLine[1968] = StringToText("家都会得知这件事情。如果恐惧之灵选择的玩家与上一次选择的相同，玩");
    g_tipLine[1969] = StringToText("家不会得知任何内容。");
    g_tipLine[1970] = StringToText("玩家只会得知恐惧之灵是否采取了行动，但不会得知恐惧之灵具体选择了");
    g_tipLine[1971] = StringToText("哪一名玩家。");
    g_tipLine[1972] = StringToText("如果恐惧之灵提名了他当前选择的玩家，且该玩家因此被处决时，该玩家");
    g_tipLine[1973] = StringToText("的阵营落败，游戏结束。");
    g_tipLine[1974] = StringToText("只有恐惧之灵当前选择的玩家会受到恐惧之灵的能力影响。他此前选择的");
    g_tipLine[1975] = StringToText("玩家不会受到影响。");
    g_tipLine[1976] = StringToText("如果被选择的玩家被恐惧之灵提名并处决后没有死亡，他的阵营仍然会落");
    g_tipLine[1977] = StringToText("败。");
    g_tipLine[1978] = StringToText("【规则细节】");
    g_tipLine[1979] = StringToText("相克规则：");
    g_tipLine[1980] = StringToText("瘟疫医生 ：如果说书人本应获得恐惧之灵的能力，改为一名爪牙玩家获");
    g_tipLine[1981] = StringToText("得此能力，且他会得知此事。");
    g_tipLine[1982] = StringToText("维齐尔 ：在恐惧之灵因为自己的能力被唤醒时，维齐尔会一同被唤醒。");
    g_tipLine[1983] = StringToText("他会得知恐惧之灵选择了哪名玩家，并且无法使用自己的能力让那名玩家");
    g_tipLine[1984] = StringToText("立即被处决。");
    g_tipLine[1985] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[1986] = StringToText("戏子 ：戏子无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[1987] = StringToText("戏子（改） ：戏子（改）无法反转由恐惧之灵的能力产生的胜负结果。");
    g_tipLine[1988] = StringToText("【角色能力】");
    g_tipLine[1989] = StringToText("每个夜晚，你要选择一名玩家：如果你选中了爪牙，他会得知被传教士选中。");
    g_tipLine[1990] = StringToText("所有被你选中的爪牙失去能力。");
    g_tipLine[1991] = StringToText("【角色简介】");
    g_tipLine[1992] = StringToText("传教士会净化爪牙的能力。");
    g_tipLine[1993] = StringToText("如果传教士选择了一名爪牙，爪牙会被唤醒得知他被布道了，并且他在传教士存活清醒健康的时候无法行动。");
    g_tipLine[1994] = StringToText("如果传教士选择了不是爪牙的玩家，无事发生。");
    g_tipLine[1995] = StringToText("传教士可以选择死亡玩家。");
    g_tipLine[1996] = StringToText("如果传教士在醉酒或中毒的时候选择了一名玩家，那名玩家不会被传教士的能力影响。");
    g_tipLine[1997] = StringToText("如果传教士醉酒或中毒，被布道的爪牙会重新获得能力，直到传教士恢复清醒健康。");
    g_tipLine[1998] = StringToText("【规则细节】");
    g_tipLine[1999] = StringToText("关于传教士的「失去能力」与其他角色的醉酒中毒效果会有所不同，暂且作为「特例」进行处理。");
    g_tipLine[2000] = StringToText("如果想要了解与其他情况下失去能力的效果的详细差别，请参考这里。");
    g_tipLine[2001] = StringToText("如果传教士死亡，这些爪牙恢复能力。已经使用了「每局游戏限一次」的能力的爪牙无法再次使用能力。");
    g_tipLine[2002] = StringToText("受传教士影响的爪牙不会被告知传教士已经死亡，但他们可能会在再次被唤醒时意识到这一点。");
    g_tipLine[2003] = StringToText("如果传教士醉酒或中毒，因传教士失去能力的爪牙恢复能力，但会在传教士恢复健康清醒后再次失去能力。");
    g_tipLine[2004] = StringToText("如果被传教士选中的爪牙在之后变成其他角色类型的角色(也就是不再是爪牙)，");
    g_tipLine[2005] = StringToText("那么他不再受到传教士能力的影响。此外，邪恶玩家不会仅仅因为属于邪恶阵营就受到传教士能力的影响，");
    g_tipLine[2006] = StringToText("他需要明确地作为爪牙角色才能受到影响。");
    g_tipLine[2007] = StringToText("同理，一名后来变成爪牙的非爪牙玩家不会因为在变成爪牙之前被传教士选择而受到其能力影响。");
    g_tipLine[2008] = StringToText("如果他在变成爪牙后被传教士选中，传教士能力正常生效。");
    g_tipLine[2009] = StringToText("如果因传教士而失去能力的爪牙在死亡后复活，他不会恢复能力，只要传教士仍然存活，他仍然失去能力。");
    g_tipLine[2010] = StringToText("特定角色互动：");
    g_tipLine[2011] = StringToText("咖啡师：被布道的爪牙获得咖啡师能力1不会恢复能力。");
    g_tipLine[2012] = StringToText("工程师：如果工程师做出行动，被布道的爪牙会被告知他的爪牙角色发生改变，但他会继续受到传教士影响，");
    g_tipLine[2013] = StringToText("并且不会恢复能力。");
    g_tipLine[2014] = StringToText("小怪宝：正在持有小怪宝角色标记的爪牙被传教士选中，会失去他的爪牙能力，但保留小怪宝恶魔的能力。");
    g_tipLine[2015] = StringToText("数学家：那些原本该醒来或使用能力的爪牙，因为被布道而无法这样做时，");
    g_tipLine[2016] = StringToText("会被数学家当作是他的能力未正常生效。");
    g_tipLine[2017] = StringToText("灵言师：如果灵言师在首个夜晚被布道，他不会得知关键词。然而，如果传教士死亡或醉酒中毒，");
    g_tipLine[2018] = StringToText("灵言师会在那个时候得知他的关键词。如果灵言师在其他夜晚被布道，");
    g_tipLine[2019] = StringToText("在这之后说出关键词的玩家不会转变为邪恶但仍然消耗灵言师的能力，");
    g_tipLine[2020] = StringToText("同样的情况适用于如果玩家在白天说出关键词，接着灵言师在夜晚被布道。");
    g_tipLine[2021] = StringToText("玩家不能在灵言师得知关键词之前说出关键词，在灵言师被告知关键词之前，关键词实际上并不存在，");
    g_tipLine[2022] = StringToText("所以提前使用相关词语不算作灵言师能力的一次使用，既没有消耗能力，也没有让玩家转变为邪恶。");
    g_tipLine[2023] = StringToText("陌客：陌客可以被传教士当作是爪牙角色，并得知被传教士选中。通常来说你应该避免这样做——请注意，");
    g_tipLine[2024] = StringToText("如果你这样做，陌客仍然保留能力——如果陌客失去能力，他会停止被当作爪牙，这意味着「布道」");
    g_tipLine[2025] = StringToText("提示标记应该被移除并且因此陌客不再被布道，所以陌客重新恢复能力。");
    g_tipLine[2026] = StringToText("间谍：间谍可以在被传教士选中时被当作非爪牙角色，并且避免受到传教士能力影响。");
    g_tipLine[2027] = StringToText("亡骨魔：传教士可以选中在亡骨魔的保留能力效果下的死亡爪牙。在这种情况下，传教士的能力会更胜一筹，");
    g_tipLine[2028] = StringToText("意味着爪牙会像被正常选中那样失去能力。在此之后，如果传教士死亡，受到影响的爪牙将恢复能力。");
    g_tipLine[2029] = StringToText("寡妇：如果寡妇在首个夜晚被传教士选中，那么他不能查看魔典并选择一名玩家中毒，");
    g_tipLine[2030] = StringToText("也不会有一名善良玩家知道寡妇在场。然而，如果传教士死亡或醉酒中毒，");
    g_tipLine[2031] = StringToText("寡妇会在那个时候查看魔典并选择一名玩家中毒，随后会有一名善良玩家知道寡妇在场。");
    g_tipLine[2032] = StringToText("相克规则：");
    g_tipLine[2033] = StringToText("维齐尔：如果维齐尔失去能力，他会得知此事，但不会在白天死亡。");
    g_tipLine[2034] = StringToText("召唤师：如果存活的召唤师失去能力，说书人会获得召唤师能力。");
    g_tipLine[2035] = StringToText("军团：如果传教士选中了军团，军团仍然保留能力，但传教士可能会得知自己选中了军团。");
    g_tipLine[2036] = StringToText("【角色能力】");
    g_tipLine[2037] = StringToText("每个夜晚，如果死亡的玩家数量大于或等于存活的玩家数量，你会得知一个存活的角色。");
    g_tipLine[2038] = StringToText("恶魔知道你是国王。");
    g_tipLine[2039] = StringToText("【角色简介】");
    g_tipLine[2040] = StringToText("国王能得知仍然存活的角色。");
    g_tipLine[2041] = StringToText("国王会在游戏的数个夜晚之后获得能力——只要死亡玩家的数量大于或等于存活玩家的数量。");
    g_tipLine[2042] = StringToText("在游戏开始时的第一个夜晚，恶魔会得知谁是国王。如果国王在游戏中途被创造，恶魔会在当晚得知谁是国王。");
    g_tipLine[2043] = StringToText("国王未必能幸存到能够使用自己的能力。然而一旦死亡玩家的数量大于或等于存活玩家的数量，");
    g_tipLine[2044] = StringToText("国王就能在此后的每个夜晚得知一个存活角色。");
    g_tipLine[2045] = StringToText("国王既有可能得知善良角色，也有可能得知邪恶角色，甚至还有可能多次得知同一个角色。");
    g_tipLine[2046] = StringToText("唱诗男孩并非一定在场。但如果唱诗男孩在场，且在恶魔杀死国王时仍然存活，唱诗男孩就能够得知谁是恶魔。");
    g_tipLine[2047] = StringToText("【规则细节】");
    g_tipLine[2048] = StringToText("特定角色互动：");
    g_tipLine[2049] = StringToText("食人族：如果食人族在场时国王死于处决，恶魔会在当晚被唤醒并告知这名食人族玩家是国王。");
    g_tipLine[2050] = StringToText("侍女：直到死亡的玩家数量大于或等于存活的玩家数量，国王才会被唤醒，因此在此之前，侍女不会探查到国王，");
    g_tipLine[2051] = StringToText("然后从国王被唤醒开始，才会被侍女的探查。");
    g_tipLine[2052] = StringToText("哲学家 / 小精灵：其获得能力当晚恶魔应该被展示国王的角色标记，而不是哲学家/小精灵。");
    g_tipLine[2053] = StringToText("罂粟种植者：罂粟种植者不会干扰恶魔知道谁是国王。");
    g_tipLine[2054] = StringToText("教授 / 沙巴洛斯 / 集骨者：复活/反刍/重获能力角色选择国王将导致恶魔再次被告知国王是谁。");
    g_tipLine[2055] = StringToText("舞蛇人 / 理发师 / 麻脸巫婆 / 红唇女郎 / 方古 / 小恶魔 / 小怪宝：");
    g_tipLine[2056] = StringToText("如果恶魔更换了玩家，此时国王仍存活且清醒和健康，新的恶魔玩家会知道国王是谁。");
    g_tipLine[2057] = StringToText("理发师 / 麻脸巫婆：如果国王被交换到另外一名玩家，或者被重新创造，恶魔会被告知新国王玩家。");
    g_tipLine[2058] = StringToText("酒鬼 / 提线木偶：如果国王被选为酒鬼/提线木偶，恶魔不会被告知哪名玩家是国王。");
    g_tipLine[2059] = StringToText("莽夫：国王没有使用自己的能力主动选择莽夫，所以国王得知莽夫时不会因为莽夫的能力而醉酒。");
    g_tipLine[2060] = StringToText("疯子：疯子可以被告知国王在场，无论正确与否。");
    g_tipLine[2061] = StringToText("陌客：理论上你可以向陌客展示国王是谁，但这并不有趣。");
    g_tipLine[2062] = StringToText("涡流：恶魔会被告知除该国王玩家以外的任意玩家是国王。国王得知错误信息：不在场或者已经死亡的角色。");
    g_tipLine[2063] = StringToText("僵怖：假死的僵怖在国王「死亡玩家数量大于或等于存活玩家数量」的能力里，被算作死亡。");
    g_tipLine[2064] = StringToText("学徒：如果获得国王能力，恶魔会被告知。");
    g_tipLine[2065] = StringToText("咖啡师：只有当死亡玩家数量大于或等于存活玩家数量时，其才会在国王获得信息时产生效果。1）");
    g_tipLine[2066] = StringToText("国王获得正确信息，2）国王得知两个角色标记。");
    g_tipLine[2067] = StringToText("相克规则：");
    g_tipLine[2068] = StringToText("利维坦：如果利维坦在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[2069] = StringToText("暴乱：如果暴乱在场，当至少一名玩家死亡时，国王每晚就会得知一个存活的角色。");
    g_tipLine[2070] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[2071] = StringToText("戏子（改）：国王不会因为戏子（改）的能力醉酒。");
    g_tipLine[2072] = StringToText("【角色能力】");
    g_tipLine[2073] = StringToText("每个夜晚，你要选择一名玩家：你会得知他的阵营。[+0~2村夫，复数村夫中有一人醉酒]");
    g_tipLine[2074] = StringToText("【角色简介】");
    g_tipLine[2075] = StringToText("村夫结伴而行，他们能得知玩家的阵营。");
    g_tipLine[2076] = StringToText("由说书人在进行游戏设置时决定哪一名村夫醉酒。");
    g_tipLine[2077] = StringToText("在场村夫的数量可能是1、2或3，这与一局游戏的玩家人数无关。");
    g_tipLine[2078] = StringToText("如果在场村夫的数量为1，他会是清醒的。");
    g_tipLine[2079] = StringToText("醉酒的村夫仍然可能会得知正确信息。");
    g_tipLine[2080] = StringToText("在游戏设置时如果添加了额外的村夫，他们会替换其他的镇民角色标记。");
    g_tipLine[2081] = StringToText("如果村夫在游戏过程中被创造，只有被创造的村夫会发生角色变化。不会有其他玩家因此变成村夫。");
    g_tipLine[2082] = StringToText("多名村夫在夜晚会分别独自行动，而不是一同被唤醒。");
    g_tipLine[2083] = StringToText("如果所有清醒的村夫都离场，剩余的醉酒村夫仍然保持醉酒状态。");
    g_tipLine[2084] = StringToText("如果一名清醒的村夫因为其他效果醉酒或中毒，处于醉酒状态的村夫仍然保持醉酒状态。");
    g_tipLine[2085] = StringToText("【规则细节】");
    g_tipLine[2086] = StringToText("「复数村夫中有一人醉酒」这一项能力既是设置调整能力（需要在为首夜准备时进行调整），");
    g_tipLine[2087] = StringToText("又是持续检测型能力。在游戏过程中，只要村夫的在场数量超过1人，且村夫的醉酒提示标记尚未被放置，");
    g_tipLine[2088] = StringToText("就需要立即放置该标记。");
    g_tipLine[2089] = StringToText("只要村夫在场，即使村夫的在场数量不足3人，说书人都无法将村夫作为恶魔的伪装提供给恶魔。");
    g_tipLine[2090] = StringToText("然而如果有酒鬼或是提线木偶以为自己是村夫，将村夫作为伪装提供给恶魔不算是「YBD」。");
    g_tipLine[2091] = StringToText("根据角色标记的实物限制原则，当村夫数量为3人时，不建议再为学徒等角色提供村夫的角色能力。同时，");
    g_tipLine[2092] = StringToText("如果有任何村夫在场，也不建议让酒鬼认为自己是村夫。");
    g_tipLine[2093] = StringToText("哲学家、食人族、学徒等角色的获得能力效果，不会参与到「村夫在场数量」的计算之中。也就是说，");
    g_tipLine[2094] = StringToText("如果村夫在场数量为1人，那么即使有其他具有村夫能力的角色，");
    g_tipLine[2095] = StringToText("这些角色包括村夫在内就都不会因为村夫的能力而醉酒。（在统计相克规则中的在场数量时，仍然会参与计算，");
    g_tipLine[2096] = StringToText("这是由于受到角色标记的实物数量限制导致的。）");
    g_tipLine[2097] = StringToText("特定角色互动：");
    g_tipLine[2098] = StringToText("卡扎力：如果有复数个村夫在场，卡扎力的设置调整优先生效，其他的村夫因卡扎力的能力变成了爪牙，");
    g_tipLine[2099] = StringToText("剩下的那名村夫一定是清醒的，因为这时村夫已经只有一个了。");
    g_tipLine[2100] = StringToText("相克规则：");
    g_tipLine[2101] = StringToText("麻脸巫婆：如果村夫在场数量不足3人，麻脸巫婆可以创造新的村夫。如果她这么做，");
    g_tipLine[2102] = StringToText("村夫的醉酒效果可能会更换目标。");
    g_tipLine[2103] = StringToText("科学怪人：如果村夫在场数量不足3人，科学怪人可以让恶魔拥有村夫的能力。");
    g_tipLine[2104] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[2105] = StringToText("悟道者：如果村夫在场数量不足3人，悟道者可以变成新的村夫。如果因此使得村夫的在场数量超过1人，");
    g_tipLine[2106] = StringToText("会有一名村夫醉酒。");
    g_tipLine[2107] = StringToText("【角色能力】");
    g_tipLine[2108] = StringToText("每个夜晚，你会转变为与你邻近的一名存活的玩家的阵营。");
    g_tipLine[2109] = StringToText("每个白天，你可以提议所有玩家加入你的教派，如果所有善良玩家同意加入，你的阵营获胜。");
    g_tipLine[2110] = StringToText("【角色简介】");
    g_tipLine[2111] = StringToText("异教领袖会在所有人加入他的教派时获胜。");
    g_tipLine[2112] = StringToText("在每个夜晚结束时，异教领袖会转变为一名邻近存活玩家的阵营。");
    g_tipLine[2113] = StringToText("每个白天限一次，异教领袖可以公开创立一个教派。如果所有善良玩家投票加入教派，游戏立刻结束，");
    g_tipLine[2114] = StringToText("异教领袖的阵营获胜。");
    g_tipLine[2115] = StringToText("异教领袖可以在一天的任何时候创立教派。");
    g_tipLine[2116] = StringToText("投票加入教派不需要消耗投票标记。");
    g_tipLine[2117] = StringToText("玩家可以在任何时候说任何事情，所以当玩家要伪装异教领袖的时候，他可以假装要创立一个教派。");
    g_tipLine[2118] = StringToText("【规则细节】");
    g_tipLine[2119] = StringToText("相克规则：");
    g_tipLine[2120] = StringToText("麻脸巫婆：被麻脸巫婆创造的邪恶异教领袖无法因为自身能力转变为善良阵营。");
    g_tipLine[2121] = StringToText("科学怪人：如果恶魔拥有异教领袖的能力，他无法因为该能力转变为善良阵营。");
    g_tipLine[2122] = StringToText("【角色能力】");
    g_tipLine[2123] = StringToText("每个夜晚*，你要选择一名存活玩家：如果他是善良的，他死亡，并且当晚恶魔不会造成死亡。");
    g_tipLine[2124] = StringToText("会有一名善良玩家始终被当作邪恶阵营。");
    g_tipLine[2125] = StringToText("【角色简介】");
    g_tipLine[2126] = StringToText("半兽人会在夜晚游荡，猎杀无辜，与此同时恶魔在自己的老巢里蛰伏。");
    g_tipLine[2127] = StringToText("半兽人必须在每个夜晚选择一名存活的玩家。如果半兽人选择了已死亡的玩家，");
    g_tipLine[2128] = StringToText("说书人会摇头并让半兽人重新选择。");
    g_tipLine[2129] = StringToText("如果半兽人选择的玩家是善良玩家，那名玩家死亡，并且当晚恶魔不能造成死亡。");
    g_tipLine[2130] = StringToText("如果半兽人选择的玩家是邪恶玩家，那名玩家不会死亡，并且恶魔可以造成死亡。");
    g_tipLine[2131] = StringToText("如果半兽人攻击了善良的玩家但没有导致那名玩家死亡，恶魔可以造成死亡。");
    g_tipLine[2132] = StringToText("恶魔与造成死亡无关的能力仍然会正常运作，不会受到半兽人的能力影响。");
    g_tipLine[2133] = StringToText("一名善良玩家始终被当作邪恶阵营。他同样也被半兽人当作邪恶阵营，因此半兽人无法杀死这名玩家。");
    g_tipLine[2134] = StringToText("【规则细节】");
    g_tipLine[2135] = StringToText("在为首个夜晚进行准备时，将半兽人的「失足」提示标记放置在任意善良角色标记旁，标记那名玩家为「失足」。");
    g_tipLine[2136] = StringToText("除首个夜晚之外的每个夜晚，唤醒半兽人。让他指向任意一名存活的玩家。让半兽人重新入睡。");
    g_tipLine[2137] = StringToText("如果被选择的玩家是善良的，那名玩家死亡——在那名玩家的角色标记旁放置「死亡」标记。当晚，");
    g_tipLine[2138] = StringToText("和平常一样唤醒恶魔进行选择，但是恶魔无法造成死亡。如果被选择的玩家是邪恶的，什么事都不会发生。");
    g_tipLine[2139] = StringToText("失足");
    g_tipLine[2140] = StringToText("放置时机：在为首个夜晚做准备时放置。");
    g_tipLine[2141] = StringToText("放置条件：放置在任意一个善良玩家的角色标记旁边，可以是半兽人自己。");
    g_tipLine[2142] = StringToText("移除条件：半兽人死亡或离场时。");
    g_tipLine[2143] = StringToText("死亡");
    g_tipLine[2144] = StringToText("放置时机：在半兽人夜晚行动并选择了玩家后放置。");
    g_tipLine[2145] = StringToText("放置条件：半兽人选择的玩家当前存活，为善良玩家，且能被半兽人杀死，且半兽人未醉酒中毒，");
    g_tipLine[2146] = StringToText("那么在该玩家的角色标记旁放置，用以提醒说书人在黎明时分宣布当晚的死亡玩家。");
    g_tipLine[2147] = StringToText("移除时机：在黎明时宣布死亡玩家后，说书人可以任由自己方便来进行移除。");
    g_tipLine[2148] = StringToText("【角色能力】");
    g_tipLine[2149] = StringToText("如果恶魔杀死了国王，你会得知哪名玩家是恶魔。[+国王]");
    g_tipLine[2150] = StringToText("【角色简介】");
    g_tipLine[2151] = StringToText("唱诗男孩会在国王被戕害时得知谁是恶魔。");
    g_tipLine[2152] = StringToText("国王可以在唱诗男孩不在场时出现在游戏中。在游戏设置阶段，如果唱诗男孩在场而国王不在场，");
    g_tipLine[2153] = StringToText("那么国王就会被添加进来并替换掉一个其他镇民。而如果国王已经在场，");
    g_tipLine[2154] = StringToText("唱诗男孩不会因此再将另外一名国王添加进场。");
    g_tipLine[2155] = StringToText("如果恶魔使用自己的能力杀死了国王，唱诗男孩会得知哪名玩家是恶魔。恶魔提名并处决国王时，");
    g_tipLine[2156] = StringToText("不算做使用自己的能力杀死国王。爪牙使用能力杀死国王，例如刺客，也不会计算在内。");
    g_tipLine[2157] = StringToText("如果恶魔攻击了国王但未能将其杀死，唱诗男孩不会得知恶魔是谁。");
    g_tipLine[2158] = StringToText("唱诗男孩得知的是恶魔的具体玩家，但不得知具体角色。");
    g_tipLine[2159] = StringToText("【规则细节】");
    g_tipLine[2160] = StringToText("在进行游戏设置，将角色标记放进盲抽袋之前，如果国王不在即将要放入盲抽袋的这些角色之中，");
    g_tipLine[2161] = StringToText("那么移除一个镇民角色标记，并加入国王。");
    g_tipLine[2162] = StringToText("除首个夜晚之外的每个夜晚，如果恶魔杀死了国王，在让恶魔重新入睡后唤醒唱诗男孩。对他指向一名恶魔玩家。");
    g_tipLine[2163] = StringToText("然后让唱诗男孩重新入睡。");
    g_tipLine[2164] = StringToText("无");
    g_tipLine[2165] = StringToText("【角色能力】");
    g_tipLine[2166] = StringToText("一名玩家醉酒，即使你已死亡。每局游戏限一次，你可以猜测谁是那个醉酒的玩家，如果猜对了，");
    g_tipLine[2167] = StringToText("你会得知谁是恶魔，但如果猜错了，你会得知错误的「谁是恶魔」信息。");
    g_tipLine[2168] = StringToText("【角色简介】");
    g_tipLine[2169] = StringToText("解谜大师需要尝试找出谁醉酒了。");
    g_tipLine[2170] = StringToText("会有一名玩家因为解谜大师的能力在整局游戏中醉酒。通常来说会是镇民，也有可能会是外来者。");
    g_tipLine[2171] = StringToText("该玩家不会知道自己醉酒了。");
    g_tipLine[2172] = StringToText("每局游戏限一次，解谜大师可以猜测谁是那名醉酒的玩家。可以进行公开猜测，也可以私下找说书人猜测。");
    g_tipLine[2173] = StringToText("不论他猜了什么，说书人都会私下告诉解谜大师一名玩家的名字。如果解谜大师猜测正确，");
    g_tipLine[2174] = StringToText("他得知的会是恶魔玩家。如果解谜大师猜测错误，他得知的则是非恶魔玩家。");
    g_tipLine[2175] = StringToText("解谜大师不会得知自己的猜测正确与否。");
    g_tipLine[2176] = StringToText("只有猜中因解谜大师的能力醉酒的玩家才算作猜测正确。猜测因为其他原因醉酒的玩家不算猜测正确。");
    g_tipLine[2177] = StringToText("在解谜大师死亡后，他的能力造成的醉酒玩家会依然醉酒。已经死亡的解谜大师不能猜测，");
    g_tipLine[2178] = StringToText("他这一部分的能力因为死亡而失去了。");
    g_tipLine[2179] = StringToText("【规则细节】");
    g_tipLine[2180] = StringToText("如果场上存在多名恶魔，只告诉解谜大师一名恶魔。优先告诉解谜大师当前存活的邪恶的恶魔。");
    g_tipLine[2181] = StringToText("特定角色互动：");
    g_tipLine[2182] = StringToText("哈迪寂亚 / 沙巴洛斯：如果解谜大师复活，因解谜大师而醉酒的玩家可以改变，解谜大师也会刷新猜测能力。");
    g_tipLine[2183] = StringToText("食人族：如果食人族获得解谜大师的能力，会有某名玩家因此开始醉酒，直到其他玩家被处决并死亡。在此期间，");
    g_tipLine[2184] = StringToText("食人族解谜大师可以猜测因其被醉酒的玩家并被告知恶魔。如果食人解谜大师在获得新的能力前就死亡，");
    g_tipLine[2185] = StringToText("他会继续使那名玩家醉酒直到游戏结束。");
    g_tipLine[2186] = StringToText("【角色能力】");
    g_tipLine[2187] = StringToText("如果有大于等于五名玩家存活，你必须在所有提名中投票。");
    g_tipLine[2188] = StringToText("【角色简介】");
    g_tipLine[2189] = StringToText("狂热者热衷于所有投票。");
    g_tipLine[2190] = StringToText("如果存活玩家数量为五人或更多，狂热者必须在所有提名中投票。如果只有四名或更少的玩家存活，");
    g_tipLine[2191] = StringToText("狂热者可以自由选择是否参与投票。");
    g_tipLine[2192] = StringToText("在狂热者的能力中，旅行者的数量也计入存活玩家的数量内。");
    g_tipLine[2193] = StringToText("如果狂热者死亡，他可以像其他死亡玩家一样正常选择是否投票。");
    g_tipLine[2194] = StringToText("狂热者在流放中不是必须要举手赞成的。");
    g_tipLine[2195] = StringToText("即使狂热者认定自己醉酒或中毒，他也必须强制参与投票。");
    g_tipLine[2196] = StringToText("说书人没有义务提醒狂热者。狂热者必须为自己的投票行为负责。故意不参与投票将被认定为作弊。");
    g_tipLine[2197] = StringToText("【规则细节】");
    g_tipLine[2198] = StringToText("相克规则：");
    g_tipLine[2199] = StringToText("食人族：如果食人族获得了狂热者的能力，他会得知这一信息。");
    g_tipLine[2200] = StringToText("维齐尔：维齐尔的能力可能会将狂热者当作邪恶阵营。");
    g_tipLine[2201] = StringToText("军团：狂热者可能会被军团当作邪恶玩家。");
    g_tipLine[2202] = StringToText("【角色能力】");
    g_tipLine[2203] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。[邪恶角色全部邻座，你靠近正中，+1爪牙，");
    g_tipLine[2204] = StringToText("-或+任意数量外来者]");
    g_tipLine[2205] = StringToText("【角色简介】");
    g_tipLine[2206] = StringToText("堤丰之首被爪牙围绕。");
    g_tipLine[2207] = StringToText("所有邪恶角色玩家全都连续相邻而坐。");
    g_tipLine[2208] = StringToText("在游戏开始时，堤丰之首的左右两侧必须都要有邪恶角色玩家。他不能位于一连串邪恶角色玩家队列的两侧。");
    g_tipLine[2209] = StringToText("邪恶阵营在游戏开始时有一名额外的爪牙。");
    g_tipLine[2210] = StringToText("可能会有任意数量的外来者在场。");
    g_tipLine[2211] = StringToText("与提线木偶相似，由说书人来决定哪名玩家在初始设置时成为爪牙。此外说书人还会决定爪牙的具体角色。");
    g_tipLine[2212] = StringToText("如果堤丰之首在游戏中途被创造，则他无需与其他邪恶角色玩家的位置相邻。");
    g_tipLine[2213] = StringToText("【规则细节】");
    g_tipLine[2214] = StringToText("虽然在运作方式中没有提到，然而堤丰之首在设置时也可以移除一部分原有的外来者，");
    g_tipLine[2215] = StringToText("并用对应数量的镇民进行替换。");
    g_tipLine[2216] = StringToText("如果游戏因堤丰之首而导致有4名邪恶爪牙在场，那么堤丰之首可以不在这5名邪恶玩家的正中间（但不能位于一");
    g_tipLine[2217] = StringToText("连串邪恶角色玩家队列的两侧）。");
    g_tipLine[2218] = StringToText("相克规则：");
    g_tipLine[2219] = StringToText("召唤师：如果召唤师创造了堤丰之首，则堤丰之首必须与一名爪牙相邻，");
    g_tipLine[2220] = StringToText("且堤丰之首另一侧的玩家会变成一个邪恶的爪牙。");
    g_tipLine[2221] = StringToText("相克规则（与华灯系列角色）：");
    g_tipLine[2222] = StringToText("戏子：堤丰之首和戏子不能在初始时同时在场。如果有角色能力能够使得善良玩家在第一个夜晚变成戏子，");
    g_tipLine[2223] = StringToText("说书人会在这一效果生效之前先告知堤丰之首两侧的玩家是邪恶的爪牙。");
    g_tipLine[2224] = StringToText("【角色能力】");
    g_tipLine[2225] = StringToText("每个夜晚，所有爪牙要秘密决定由哪名玩家来照看小怪宝并且「是恶魔」。每个夜晚*，可能会有一名玩家死亡。");
    g_tipLine[2226] = StringToText("[+1爪牙]");
    g_tipLine[2227] = StringToText("【角色简介】");
    g_tipLine[2228] = StringToText("小怪宝不是玩家，而是被一名爪牙照顾的宝宝。");
    g_tipLine[2229] = StringToText("每个夜晚，所有爪牙玩家一起睁眼，他们秘密决定谁照顾小怪宝。");
    g_tipLine[2230] = StringToText("爪牙们通过指向一名玩家或以其他明显的方式达成一致意见。如果他们不能达成一致，");
    g_tipLine[2231] = StringToText("由说书人决定谁照顾小怪宝。");
    g_tipLine[2232] = StringToText("如果说书人觉得有趣，可以把小怪宝的角色标记交给正照顾小怪宝的玩家。他需要把小怪宝藏进他的口袋，");
    g_tipLine[2233] = StringToText("放在他的帽子里，或其他合适的地方。玩家不能要求其他人清空他们的口袋。");
    g_tipLine[2234] = StringToText("正照顾小怪宝的玩家「是恶魔」。如果他死亡了，善良阵营获胜。他会被其他角色能力检测到「是恶魔」，");
    g_tipLine[2235] = StringToText("例如占卜师。");
    g_tipLine[2236] = StringToText("如果一个善良玩家正照顾小怪宝，他「是恶魔」，但依旧是善良的。一个死亡玩家照顾小怪宝会让游戏结束，");
    g_tipLine[2237] = StringToText("因为恶魔已经死亡了。");
    g_tipLine[2238] = StringToText("照顾小怪宝的玩家保留他原有的能力。");
    g_tipLine[2239] = StringToText("小怪宝不是玩家，所以不会醉酒或中毒。");
    g_tipLine[2240] = StringToText("【规则细节】");
    g_tipLine[2241] = StringToText("小怪宝这个角色也会被视作是「在场角色」，但它不属于任何一名玩家，也无法被常规的「选择一名玩家」");
    g_tipLine[2242] = StringToText("的能力选中。");
    g_tipLine[2243] = StringToText("「非指向性」的死亡效果可以杀死小怪宝，例如麻脸巫婆、小怪宝等角色的能力。在这种情况下，小怪宝死亡，");
    g_tipLine[2244] = StringToText("并会因此移除小怪宝的角色标记与所有提示标记。从现在起，小怪宝会被视作是「不在场」来处理。");
    g_tipLine[2245] = StringToText("如果某个能力让一名玩家变成小怪宝，该玩家的角色不会发生变化，而是改为正在照看小怪宝。");
    g_tipLine[2246] = StringToText("但如果是工程师选择让小怪宝在场，会让一名恶魔因此变成一个正在照看小怪宝的不在场爪牙。");
    g_tipLine[2247] = StringToText("反之如果工程师选择了其他的恶魔而导致小怪宝需要发生角色变化，");
    g_tipLine[2248] = StringToText("当前照看小怪宝的玩家会变成工程师所选择的恶魔，同时小怪宝会离场。");
    g_tipLine[2249] = StringToText("相克规则：");
    g_tipLine[2250] = StringToText("红唇女郎：如果在五名及以上的玩家存活时照看小怪宝的玩家死亡，之后红唇女郎必须要一直照看小怪宝。");
    g_tipLine[2251] = StringToText("魔术师：如果魔术师存活，由说书人决定谁照看小怪宝。");
    g_tipLine[2252] = StringToText("罂粟种植者：如果小怪宝和罂粟种植者都存活，爪牙们会依次单独被唤醒，直到其中一名玩家选择照看小怪宝。");
    g_tipLine[2253] = StringToText("帽匠：如果帽匠死亡，恶魔选择了小怪宝，则还需要选择变成一个爪牙角色。");
    g_tipLine[2254] = StringToText("精神病患者：如果精神病患者正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[2255] = StringToText("提线木偶：如果提线木偶本应初始在场，他们会在恶魔之后进场并与恶魔邻座。");
    g_tipLine[2256] = StringToText("维齐尔：如果维齐尔正照看小怪宝，他会在被处决时死亡。");
    g_tipLine[2257] = StringToText("【角色能力】");
    g_tipLine[2258] = StringToText("游戏开始时，你要宣布一个善良角色。如果该角色在场，他只能死于处决，");
    g_tipLine[2259] = StringToText("但所有邪恶玩家会在首个夜晚得知他是哪一名玩家。");
    g_tipLine[2260] = StringToText("【角色简介】");
    g_tipLine[2261] = StringToText("暴风捕手可以让游戏的焦点集中于一个特定的善良角色上。");
    g_tipLine[2262] = StringToText("如果你想要基于一个特定的善良角色的行动或信息来创建一个剧本，");
    g_tipLine[2263] = StringToText("又或者是你希望在每一局游戏中都让这个角色出场（或者至少会有一名邪恶玩家想要伪装成这个角色），");
    g_tipLine[2264] = StringToText("你可以使用暴风捕手。你所选择的角色会在游戏中占据举足轻重的位置，会在多数时候成为公开讨论的焦点，");
    g_tipLine[2265] = StringToText("且大多数时候都会存活直至游戏的最后一天。");
    g_tipLine[2266] = StringToText("被说书人宣布的角色在除处决以外的所有情况下都不会死亡。这个角色可能会在场，也可能不在场。如果他在场，");
    g_tipLine[2267] = StringToText("那么这名善良玩家的生死就会完全取决于其他善良玩家的意愿，因为邪恶玩家无法杀死他。如果他不在场，");
    g_tipLine[2268] = StringToText("所有邪恶玩家都会得知这一信息，因此任何一名邪恶玩家都能够轻易伪装成这个角色。（他们不是必须要这样做，");
    g_tipLine[2269] = StringToText("但他们可以这样做。）");
    g_tipLine[2270] = StringToText("【规则细节】");
    g_tipLine[2271] = StringToText("在游戏开始时，宣布暴风捕手在场。将暴风捕手的角色标记放入魔典。宣布暴风捕手对哪个善良角色「青睐有加」");
    g_tipLine[2272] = StringToText("。如果被暴风捕手选择的角色在场，使用暴风捕手的「不会死亡」提示标记标记那个角色。");
    g_tipLine[2273] = StringToText("在首个夜晚，分别依次唤醒每个邪恶玩家。如果有善良角色标记了暴风捕手的「不会死亡」提示标记，");
    g_tipLine[2274] = StringToText("对邪恶玩家展示「这名玩家是」信息标记，对应的善良角色标记，并指向对应的善良玩家，");
    g_tipLine[2275] = StringToText("然后让邪恶玩家重新入睡。如果没有玩家被暴风捕手标记，对邪恶玩家展示「这些角色不在场」");
    g_tipLine[2276] = StringToText("信息标记和对应的善良角色标记，然后让邪恶玩家重新入睡。");
    g_tipLine[2277] = StringToText("如果被暴风捕手的「不会死亡」提示标记标记的角色被处决，那么他死亡。如果他会因为其他方式死亡，");
    g_tipLine[2278] = StringToText("那么他保持存活。");
    g_tipLine[2279] = StringToText("不会死亡");
    g_tipLine[2280] = StringToText("放置时机：在为首个夜晚做准备时。");
    g_tipLine[2281] = StringToText("放置条件：放置在说书人宣布了暴风捕手的目标所对应的角色标记旁。");
    g_tipLine[2282] = StringToText("移除时机：游戏结束时。");
    g_tipLine[2283] = StringToText("【角色能力】");
    g_tipLine[2284] = StringToText("在你的首个夜晚，你会得知距离最近的邪恶玩家位于你的顺时针还是逆时针方向。");
    g_tipLine[2285] = StringToText("如果两侧的邪恶玩家与你距离相等，你得知的信息由说书人决定。");
    g_tipLine[2286] = StringToText("【角色简介】");
    g_tipLine[2287] = StringToText("修行者会倾向于信任位于他某一侧的玩家。");
    g_tipLine[2288] = StringToText("· 距离最近的邪恶玩家 = 与他之间坐着的玩家数量最少的邪恶玩家。");
    g_tipLine[2289] = StringToText("· 他不会得知具体的距离；两侧距离相等时由说书人决定给哪一侧，他也不会");
    g_tipLine[2290] = StringToText("  知道这次信息到底是不是随机的。");
    g_tipLine[2291] = StringToText("【规则细节】");
    g_tipLine[2292] = StringToText("首个夜晚唤醒修行者，用手指水平指向某一侧来告知方向。");
    g_tipLine[2293] = StringToText("如果修行者在游戏中途被创造，他会在当晚被唤醒并获取信息。");
    g_tipLine[2294] = StringToText("修行者没有提示标记。");
    g_tipLine[2295] = StringToText("【角色能力】");
    g_tipLine[2296] = StringToText("在你的首个夜晚，你会得知两名善良玩家。他们之中会有一人醉酒，即使你已死亡。");
    g_tipLine[2297] = StringToText("【角色简介】");
    g_tipLine[2298] = StringToText("店小二对他店里的顾客非常熟悉，但也为某些酒量不高的顾客感到焦虑。");
    g_tipLine[2299] = StringToText("· 他得知的两名玩家都属于善良阵营，其中一人会一直醉酒直到本局结束，店小二死亡也不会解除。");
    g_tipLine[2300] = StringToText("· 如果店小二在游戏中途被创造，他会在当晚得知两名玩家，其中一人醉酒。");
    g_tipLine[2301] = StringToText("· 已经死亡的玩家变成店小二时不会得知信息，但仍然会让一名善良玩家醉酒。");
    g_tipLine[2302] = StringToText("【规则细节】");
    g_tipLine[2303] = StringToText("配置版型阶段就把「熟客」和「醉酒」两枚提示标记分别放在两名善良玩家的");
    g_tipLine[2304] = StringToText("角色标记旁；醉酒的那名玩家会一直醉酒到本局结束，店小二死亡后依然醉酒。");
    g_tipLine[2305] = StringToText("首个夜晚唤醒店小二：清醒时可直接告诉他这两名玩家，也可改成手动填两名。");
    g_tipLine[2306] = StringToText("挑谁醉酒时优先一次性能力者，其次夜间能力者，最后持续信息位；即使店小二");
    g_tipLine[2307] = StringToText("自己中毒或醉酒，也照旧让其中一名（尽量挑善良玩家）醉酒。");
    g_tipLine[2308] = StringToText("【角色能力】");
    g_tipLine[2309] = StringToText("每个夜晚，你要选择除你以外的一名玩家：你会得知一个与他能力相关的词语。");
    g_tipLine[2310] = StringToText("【角色简介】");
    g_tipLine[2311] = StringToText("郎中精通望闻问切，能够通过他人的面相进行初步的推测。");
    g_tipLine[2312] = StringToText("· 说书人把词语写在纸上，或用能记录词语的设备给郎中看（跟灵言师的关键词一样）。");
    g_tipLine[2313] = StringToText("· 词语可以取自那名玩家能力里的词（夜晚 / 死亡 / 公开），也可以是概括性的");
    g_tipLine[2314] = StringToText("  （勇敢 / 牺牲）。");
    g_tipLine[2315] = StringToText("· 每次只给一个词，通常 2~4 个字。可以连续多晚选同一个人，也可以选已死亡的");
    g_tipLine[2316] = StringToText("  玩家，但不能选自己。");
    g_tipLine[2317] = StringToText("【规则细节】");
    g_tipLine[2318] = StringToText("每个夜晚唤醒郎中，让他指向除自己以外的任意一名玩家，再把词语给他看。");
    g_tipLine[2319] = StringToText("建议游戏早期尽量给模糊的词语，免得郎中很快锁定对方的角色。");
    g_tipLine[2320] = StringToText("【角色能力】");
    g_tipLine[2321] = StringToText("每个白天，如果你「疯狂」地证明自己是一个善良角色（与之前不同），你可能会在");
    g_tipLine[2322] = StringToText("当晚获得那个角色的能力，直到下个黄昏。");
    g_tipLine[2323] = StringToText("【角色简介】");
    g_tipLine[2324] = StringToText("变脸师擅长在万千样貌中变化自如。");
    g_tipLine[2325] = StringToText("· 疯狂证明的角色必须与之前拿到过能力的角色不同：同一个角色的能力不能重复获得。");
    g_tipLine[2326] = StringToText("· 每次获得的能力持续到下个黄昏；跨度不同的角色（杂耍艺人 / 歌伶）在他疯狂");
    g_tipLine[2327] = StringToText("  证明的那一刻就能用。");
    g_tipLine[2328] = StringToText("· 说书人通常一局给 1~2 次：需要他否定之前演过的角色、并说明更换的理由。");
    g_tipLine[2329] = StringToText("【规则细节】");
    g_tipLine[2330] = StringToText("某个白天他疯狂证明了一个此前没拿过能力的善良角色时，当晚起直到下一个黄昏");
    g_tipLine[2331] = StringToText("结束，他可能获得那个角色的能力。");
    g_tipLine[2332] = StringToText("说书人决定给不给：给的话，把他的角色标记换成获得能力的那个角色，并放上");
    g_tipLine[2333] = StringToText("「是变脸师」提示标记。这个标记在黄昏、他死亡或离场时移除。");
    g_tipLine[2334] = StringToText("【角色能力】");
    g_tipLine[2335] = StringToText("你以为你是一个外来者，但你实际上不是。如果有邪恶玩家的能力选择或影响了你，");
    g_tipLine[2336] = StringToText("你会立即变成一个不在场的镇民角色。");
    g_tipLine[2337] = StringToText("【角色简介】");
    g_tipLine[2338] = StringToText("悟道者误以为自己置身事外，然而当邪恶睥睨时，他才终于醒悟。");
    g_tipLine[2339] = StringToText("· 设置时他不占外来者名额：代替他的是一个不在场的外来者标记，他自己以为扮演");
    g_tipLine[2340] = StringToText("  的是那个外来者，也没有那个外来者的能力。");
    g_tipLine[2341] = StringToText("· 被邪恶玩家的能力选择或影响时，在效果生效前他先变成一名不在场的镇民。");
    g_tipLine[2342] = StringToText("· 角色变化发生在白天时，说书人在当晚所有人闭眼后第一时间唤醒他并告知。");
    g_tipLine[2343] = StringToText("【规则细节】");
    g_tipLine[2344] = StringToText("设置：移除悟道者标记、加一个不在场的外来者标记，再让玩家抽取。");
    g_tipLine[2345] = StringToText("首个夜晚做准备时，把「是悟道者」提示标记放在那个外来者标记旁。");
    g_tipLine[2346] = StringToText("他无法以为自己扮演的是酒鬼或疯子（这两个角色不会作为标记发出去）。");
    g_tipLine[2347] = StringToText("相克：诺-达鲺（开局相邻时他直接中毒，不发生角色变化；游戏中变成的邪恶");
    g_tipLine[2348] = StringToText("诺-达鲺则照常触发）。");
    g_tipLine[2349] = StringToText("【角色能力】");
    g_tipLine[2350] = StringToText("在你的首个夜晚，你要选择除你以外的一名玩家：如果他先死于处决，你会在当晚");
    g_tipLine[2351] = StringToText("转变为邪恶；如果你先死于处决，他会在当晚转变为邪恶。");
    g_tipLine[2352] = StringToText("【角色简介】");
    g_tipLine[2353] = StringToText("逆臣与一名其他玩家势不两立。");
    g_tipLine[2354] = StringToText("· 谁先死于处决，另一人就在当晚转变为邪恶阵营；其他死法不触发。");
    g_tipLine[2355] = StringToText("· 即使目标因为别的原因已经死亡，逆臣死于处决照样会让他转变阵营。");
    g_tipLine[2356] = StringToText("· 如果逆臣自己因为其他原因死亡，能力失效；如果本来选的就是邪恶玩家，他不会");
    g_tipLine[2357] = StringToText("  因此变成善良。");
    g_tipLine[2358] = StringToText("【规则细节】");
    g_tipLine[2359] = StringToText("首个夜晚唤醒逆臣，让他指向一名其他玩家，把「不共戴天」提示标记放在那名");
    g_tipLine[2360] = StringToText("玩家的角色标记旁（即使逆臣中毒醉酒也照常放）。");
    g_tipLine[2361] = StringToText("两人里先死于处决的那一夜，唤醒另一名玩家，展示「你是」标记与向下的大拇指，");
    g_tipLine[2362] = StringToText("告诉他现在的阵营；魔典上把他的角色标记倒置，并移除「不共戴天」。");
    g_tipLine[2363] = StringToText("逆臣死亡且没有触发阵营转变时，也要把「不共戴天」移除。");
    g_tipLine[2364] = StringToText("【角色能力】");
    g_tipLine[2365] = StringToText("如果你死亡，当晚爪牙和恶魔玩家可以选择变成新的爪牙和恶魔角色。");
    g_tipLine[2366] = StringToText("【角色简介】");
    g_tipLine[2367] = StringToText("帽匠允许邪恶角色的玩家改变自己的角色。");
    g_tipLine[2368] = StringToText("· 每名邪恶玩家都可以选择不改变；改变的人获得新角色的能力（包括「首个夜晚」");
    g_tipLine[2369] = StringToText("  和「每局限一次」的能力）。");
    g_tipLine[2370] = StringToText("· 一旦有人选了某个角色，别人就不能再选同一个；有人重复选择时摇一次头让他重选。");
    g_tipLine[2371] = StringToText("· 如果帽匠是在死后才被变成帽匠，当晚邪恶玩家不会因此改变角色。");
    g_tipLine[2372] = StringToText("【规则细节】");
    g_tipLine[2373] = StringToText("帽匠死亡（且清醒健康）时，在他角色标记旁放「今晚茶会」提示标记。");
    g_tipLine[2374] = StringToText("当晚唤醒所有爪牙和恶魔，展示「该角色的能力对你生效」和帽匠标记，让他们");
    g_tipLine[2375] = StringToText("摇头或指向与自己当前角色类型相同的一个角色。");
    g_tipLine[2376] = StringToText("结算完统一改角色，然后移除「今晚茶会」。可选规则：允许恶魔变成爪牙、");
    g_tipLine[2377] = StringToText("（仅）一名爪牙变成恶魔。");
    g_tipLine[2378] = StringToText("【角色能力】");
    g_tipLine[2379] = StringToText("每个夜晚*，你要选择一名玩家：他死亡。如果你以这种方式杀死了一名与你邻近的");
    g_tipLine[2380] = StringToText("镇民玩家，除旅行者外的所有善良玩家会中毒直到下个黄昏。");
    g_tipLine[2381] = StringToText("【角色简介】");
    g_tipLine[2382] = StringToText("混沌伺机而动，能够让善良玩家集体中毒。");
    g_tipLine[2383] = StringToText("· 触发条件是「被杀死的那名玩家是镇民，且是离混沌最近的两名镇民之一」；");
    g_tipLine[2384] = StringToText("  杀死邪恶的镇民同样会触发。");
    g_tipLine[2385] = StringToText("· 被杀的镇民若有死亡触发能力，先结算完这些能力，再让全体善良玩家中毒。");
    g_tipLine[2386] = StringToText("· 如果这一刀直接导致游戏结束，中毒不触发；攻击已死亡的镇民、或没能造成死亡，");
    g_tipLine[2387] = StringToText("  也不触发。");
    g_tipLine[2388] = StringToText("【规则细节】");
    g_tipLine[2389] = StringToText("除首个夜晚外的每个夜晚唤醒混沌，让他指向一名玩家：那名玩家死亡。");
    g_tipLine[2390] = StringToText("成功杀死邻近镇民时，在魔典正中央放「善良中毒」提示标记：只要是善良阵营");
    g_tipLine[2391] = StringToText("（旅行者除外）就中毒；下个黄昏开始时移除（混沌死亡或离场也移除）。");
    g_tipLine[2392] = StringToText("中毒期间转成善良的人立刻中毒，转成邪恶的人立刻解除。");

    g_tipRoleAt[103] = 5809;   g_tipRoleN[103] = 52;
    g_tipRoleAt[104] = 5861;   g_tipRoleN[104] = 39;
    g_tipRoleAt[105] = 5900;   g_tipRoleN[105] = 35;
