    if (b == 6) { return 4; }        // 罂粟花开
    if (b == 8) { return 3; }        // 横行霸道
    if (b == 9) { return 3; }        // 何方教众
    if (b == 10) { return 5; }       // 风雅集
    if (b == 11) { return 3; }       // 心理博弈 XI
    if (b == 12) { return 3; }       // 信口雌黄
    if (b == 13) { return 5; }       // 全员追忆
    if (b == 14) { return 3; }       // 成双成对
