    g_deathTok[11] = 94;  g_deathKind[11] = 2;  g_deathByDemon[11] = 0;  g_deathImp[11] = 0;  // 死亡（女巫）：白天、非恶魔杀（诅咒致死）
    g_deathTok[12] = 115; g_deathKind[12] = 1; g_deathByDemon[12] = 1; g_deathImp[12] = 0;
