    g_saySeatBtn = BOTC_NewButton(g_grimDlg, 112, 112, 841, 67, "");     // 说书人格子的位置（用户 2026-11-04：再往右挪 20，仍留在魔典边框内）
    DialogControlSetVisible(g_saySeatBtn, PlayerGroupAll(), true);
    // 【说书人那一格的身份头像】（用户 2026-09-26）：只有说书人自己看得见（无神论局方便用）
    libNtve_gf_CreateDialogItemImage(g_grimDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
