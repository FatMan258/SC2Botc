    g_tipLine[628] = StringToText("每个夜晚，被唤醒的玩家之中，首个使用自己的能力选择了") + TextWithColor(StringToText("莽夫"), Color(0, 191, 255)) + StringToText("的玩家将会立即") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("。");
