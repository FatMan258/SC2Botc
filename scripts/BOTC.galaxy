// 开始教派投票（q = 提议人的格子）
void BOTC_CultStart (int q) {
    int i;
    if (q < 1 || q > 13) {
        return;
    }
    if (g_cultOn) {
        BOTC_Notice(g_who[q], "已经有一次教派提议在投票了，等这一轮结束。");
        return;
    }
    g_cultOn = true;
    g_cultWho = q;                  // 【提议人（格子）】（用户 2026-10-11 修）：原来这行被漏掉了，结算里读到的永远是 0
    // 【用提名那套原生投票】（用户 2026-10-10）：没有提名人 / 被提名人，直接进"投票阶段"
    g_nomFrom = 0;
    g_nomTo = 0;
    g_nomPickBy = 0;
    for (i = 0; i <= 13; i += 1) {
        g_vote[i] = 0;                 // 原生那张投票表：这一轮重新投
        g_voteWasDead[i] = false;
        g_cultVote[i] = 0;
    }
    g_cultPhaseBak = g_phase;          // 【借代码不照搬】记下进来之前的阶段，结束以后原样还原
    //   ⚠ 不是"开提名环节"：投票期间那颗【进入提名环节】按钮由 NomUI 收着

    BOTC_PhaseSet(5);                  // 进投票阶段：投票 / 弃权按钮 + 座位上的投票标记都是原生那套
    libNtve_gf_StopTimer(g_tSpeech);
    libNtve_gf_StopTimer(g_tVote);
    TimerStart(g_tVote, 20.0, false, c_timeGame);   // 原生那个投票计时器：这次是 20 秒
    // 【只有有能力的人才提醒】（用户 2026-11-09）：任何人都能公开声称异教领袖，但假声称不再给说书人私聊提醒；
    //   投票本身是公屏可见的，说书人不需要靠私聊得知。
    if (BOTC_HasAbility(q, 106)) {
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(q) + " 公开提议入教 → 20 秒投票。");
    }
    BOTC_NomUI();
}

// 投票 / 弃权（p = 格子）
void BOTC_CultVoteAt (int p, int v) {
    if (!g_cultOn) {
        return;
    }
    if (p < 1 || p > 13) {
        return;
    }
    g_cultVote[p] = v;
    BOTC_CultRender();
    // 【必须等满 20 秒】（用户 2026-10-10）：这里**不**提前结算，到点由 g_tCult 计时器统一结算
}

// 存活善良玩家是不是都投了【投票】
bool BOTC_CultAllAgreed () {
    int i;
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        // 【死了的善良玩家也要投】（用户 2026-10-10）：教派投票里死人不算弃权，照样要点【投票】才算全员同意
        if (BOTC_SeatAlign(i) != 0) { continue; }
        if (g_vote[i] != 1) {           // 【原生那张表】（用户 2026-10-10）
            return false;
        }
    }
    return true;
}

// 刷新：倒计时 + 还没投的善良玩家
void BOTC_CultRender () {
    int i;
    int sec;
    string s;
    bool secret;
    if (!g_cultOn) {
        return;
    }
    libNtve_gf_SetDialogItemText(g_cultTitle, BOTC_NameSubstText(StringToText("教派提议：" + BOTC_NameStr(g_cultWho) + " 邀请所有人加入他的教派")), PlayerGroupAll());
    sec = FixedToInt(TimerGetRemaining(g_tCult));
    if (sec < 0) {
        sec = 0;
    }
    libNtve_gf_SetDialogItemText(g_cultCnt, StringToText("剩余 " + IntToString(sec) + " 秒"), PlayerGroupAll());
    s = "";
    secret = BOTC_OrganActive();
    for (i = 2; i <= 13; i += 1) {
        if (!g_seatOn[i]) { continue; }
        // 【死了的善良玩家也要投】（用户 2026-10-10）：这里跟 BOTC_CultAllAgreed 同一口径
        if (BOTC_SeatAlign(i) != 0) { continue; }
        if (g_vote[i] == 1) { continue; }
        if (secret) { continue; }
        if (StringLength(s) > 0) { s = s + ","; }
        s = s + BOTC_NameStr(i);
    }
    if (secret) {
        s = "街头风琴手能力生效：投票人与票数均保密";
    }
    else {
        if (StringLength(s) <= 0) {
            s = "（善良玩家都投完了）";
        }
        s = "还没投的善良玩家：" + s;
    }
    libNtve_gf_SetDialogItemText(g_cultInfo, BOTC_NameSubstText(StringToText(s)), PlayerGroupAll());
}

// 结算 + 清空（timeout = 是不是倒计时到点）
void BOTC_CultEnd (bool timeout) {
    int i;
    int side;
    bool ok;
    if (!g_cultOn) {
        return;
    }
    ok = BOTC_CultAllAgreed();
    // 【没能力 / 中毒酒鬼 → 不结算胜利】（用户 2026-10-11）：投票照走，但只有真有这个能力的人才判胜
    if (ok) {
        if (!BOTC_AbilityWorks(g_cultWho, 106)) {
            ok = false;
            BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(g_cultWho) + " 全员同意，但没有可用的异教领袖能力（科学怪人来源失效 / 中毒 / 无此能力）→ 不结算胜利。");
        }
    }
    side = BOTC_SeatAlign(g_cultWho);
    g_cultOn = false;
    for (i = 0; i <= 13; i += 1) {
        g_cultVote[i] = 0;               // 【倒计时一结束就清空】（用户 2026-10-10）
        g_vote[i] = 0;                   // 原生那张投票表也清掉（原生收尾口径）
        g_voteWasDead[i] = false;
    }
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);    // 我自己那块面板不再用了，顺手收掉
    // 【20 秒到点就把【投票】/【弃权】收回】（用户 2026-10-10）：这里显式收一次，
    //   不管还原成哪个阶段都保证这两颗按钮一定消失（座位上的投票标记由 g_vote 清空后 NomUI 重画成空白）
    DialogControlSetVisible(g_voteYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteNo, PlayerGroupAll(), false);
    BOTC_PhaseSet(g_cultPhaseBak);     // 【借代码不照搬】还原成进来之前的阶段（一般是 0 = 没在提名环节）
    BOTC_NomUI();
    if (ok) {
        BOTC_PubAnnounce("【教派】所有善良玩家都同意加入教派！");
        BOTC_PmStore(g_teller, "【异教领袖】全员同意 → 按异教领袖现在的阵营判胜负。");
        BOTC_ShowWin(side, "所有善良玩家都加入了异教领袖的教派，", "小镇从此只有一种声音。");
    }
    else {
        BOTC_PubAnnounce("【说书人】：无事发生。");
        BOTC_PmStore(g_teller, "【异教领袖】" + BOTC_NameStr(g_cultWho) + " 的教派提议没有全员同意 → 提议失败。");
    }
}

// 【教派投票 · 中断】（用户 2026-11-08）：投票没走完就入夜 / 收环节时，把这一轮直接作废。
//   ⚠ 不能只靠 20 秒计时器收尾：入夜时阶段已被收成 0，计时器到点会因为「不是阶段 5」直接返回，
//     结果 g_cultOn 永远为真，【进入提名环节】被一直藏起来，白天再也开不了提名。
void BOTC_CultCancel (string why) {
    int i;
    if (!g_cultOn) {
        return;
    }
    g_cultOn = false;
    for (i = 0; i <= 13; i += 1) {
        g_cultVote[i] = 0;
        g_vote[i] = 0;
        g_voteWasDead[i] = false;
    }
    g_cultPhaseBak = 0;
    libNtve_gf_StopTimer(g_tVote);           // 20 秒投票计时器一起停掉，免得下一轮提名被它提前结算
    DialogSetVisible(g_cultDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteYes, PlayerGroupAll(), false);
    DialogControlSetVisible(g_voteNo, PlayerGroupAll(), false);
    DialogControlSetVisible(g_cultHead, PlayerGroupAll(), false);
    BOTC_PmStore(g_teller, "【异教领袖】教派投票被中断（" + why + "），这一轮作废。");
    BOTC_NomUI();
}

bool BOTC_CultTimer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    BOTC_CultEnd(true);
    return true;
}
// 【说书人工具 · 再点一次 = 取消】（用户 2026-11-08）：自定义文本 / 玩家号 + 身份 / 发送互认 /
//   赋予能力 / 使用技能 / 标记能力使用 点开后会收起工具面板、进入等待状态；此时再点【说书人工具】
//   直接取消这次操作并给出反馈，不再重新打开工具面板。（快捷发送互认是立即发送，无等待状态。）
bool BOTC_SpecToolCancel () {
    // 自定义文本 / 玩家号 + 身份 / 发送互认：正在等说书人点座位选收件人
    if (g_specMode == 1 || g_specMode == 2 || g_specMode == 5) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_NoticeKeep(g_teller, "已取消，没有发给任何人。");
        return true;
    }
    // 发送互认：收件人已选好，手动填写面板还开着
    if (g_recogTo >= 2 && g_recogTo <= 13) {
        BOTC_RecogClose();
        BOTC_NoticeKeep(g_teller, "【发送互认】已取消，没有发给任何人。");
        return true;
    }
    // 赋予能力：正在身份网格里选能力
    if (g_pickMode[g_teller] == 34) {
        g_pickMode[g_teller] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        g_grantOn = false;
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除身份"), PlayerGroupSingle(g_teller));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
        BOTC_NoticeKeep(g_teller, "【赋予能力】已取消，没有赋予任何能力。");
        return true;
    }
    // 赋予能力：面板还开着
    if (g_grantOn) {
        g_grantOn = false;
        DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
        BOTC_NoticeKeep(g_teller, "【赋予能力】已取消，没有赋予任何能力。");
        return true;
    }
    // 使用技能：正在身份网格里选角色
    if (g_pickMode[g_teller] == 52) {
        g_pickMode[g_teller] = 0;
        g_pickTeam = -1;
        g_pickAlign = -1;
        g_pickWho[g_teller] = 0;
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), false);
        BOTC_NoticeKeep(g_teller, "【使用技能】已取消。");
        return true;
    }
    // 标记能力使用：退出点座位
    if (g_markUseMode) {
        g_markUseMode = false;
        BOTC_NoticeKeep(g_teller, "已退出【标记能力使用】。");
        return true;
    }
    // 手动唤醒：退出点座位唤醒 / 收回
    if (g_wakeMode) {
        g_wakeMode = false;
        g_wakeChoiceSeat = 0;
        DialogSetVisible(g_wakeChoiceDlg, PlayerGroupAll(), false);
        BOTC_WakeRender();
        BOTC_NoticeKeep(g_teller, "已退出【手动唤醒】：点座位不再唤醒 / 收回。");
        return true;
    }
    return false;
}

void BOTC_SpecOpen () {
    int i;
    // 【再点【说书人工具】= 关闭面板】（用户 2026-11-08）：面板已经打开时再点按钮直接收起，
    //   不再重复打开；面板处于收件人 / 独立面板等待状态时按原有取消逻辑处理。
    if (DialogIsVisible(g_specDlg, g_teller)) {
        BOTC_SpecClose();
        return;
    }
    // 【再点【说书人工具】= 取消等待状态】（用户 2026-11-08）：见 BOTC_SpecToolCancel。
    if (BOTC_SpecToolCancel()) {
        return;
    }
    // 【再点【发送特定信息】= 取消等待发送】（用户 2026-11-04）：此时已经选好 3 个不在场身份、
    //   正等说书人点座位，再点按钮不再重新打开面板，而是取消本次发送并给出反馈。
    if (g_specMode == 7) {
        g_specMode = 0;
        g_specTo = 0;
        g_specPickSlot = 0;
        g_specBluffOn = false;
        g_mbOn = false;
        DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
        for (i = 0; i < 6; i += 1) {
            g_specRoleSel[i] = 0;
        }
        BOTC_NoticeKeep(g_teller, "【发送不在场身份】已取消，没有发给任何人。");
        return;
    }
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    // 【手动发送不在场身份】（用户 2026-11-04）：再点【发送特定信息】= 取消等待发送的独立面板
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specGrantBtn, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specMarkBtn, PlayerGroupAll(), true);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), false);
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), false);
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送给他"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, StringToText("说书人工具"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("前三种方式需要先点一名玩家作为收件人；快捷发送互认直接自动发给全场恶魔和爪牙；使用技能只能在夜间由说书人发动一个本剧本角色；赋予能力可给任意玩家附加一份角色能力。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("关闭"), PlayerGroupAll());
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecClose () {
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
}

void BOTC_BuildGrant () {
    DialogCreate(780, 400, c_anchorCenter, 0, -80, false);
    g_grantDlg = DialogLastCreated();
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
    g_grantTitle = BOTC_NewLabelC(g_grantDlg, 740, 34, 20, 12, StringToText("赋予能力"));
    libNtve_gf_SetDialogItemStyle(g_grantTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_grantTitle, false, PlayerGroupAll());
    BOTC_NewLabel(g_grantDlg, 150, 30, 30, 66, StringToText("玩家号（1~12）"));
    g_grantSeatEdit = BOTC_NewEdit(g_grantDlg, 150, 42, 30, 100);
    g_grantRoleBtn = BOTC_NewButton(g_grantDlg, 260, 42, 210, 100, "选择能力");
    g_grantDrunkBtn = BOTC_NewButton(g_grantDlg, 160, 42, 500, 100, "醉酒");
    g_grantOk = BOTC_NewButton(g_grantDlg, 180, 44, 90, 250, "赋予");
    g_grantRecycleBtn = BOTC_NewButton(g_grantDlg, 180, 44, 300, 250, "回收");
    g_grantClose = BOTC_NewButton(g_grantDlg, 180, 44, 510, 250, "关闭");
    libNtve_gf_SetDialogItemText(g_grantSeatEdit, StringToText(""), PlayerGroupAll());
}

void BOTC_GrantOpen () {
    g_grantRoleSel = 0;
    g_grantDrunk = false;
    g_grantOn = true;
    libNtve_gf_SetDialogItemText(g_grantSeatEdit, StringToText(""), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_grantRoleBtn, StringToText("选择能力"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_grantDrunkBtn, StringToText("醉酒"), PlayerGroupAll());
    DialogSetVisible(g_grantDlg, PlayerGroupSingle(g_teller), true);
}

// 自定义板 7 的 g_boardRole 可能来自开局缓存；打开赋予能力前按实际勾选重建，
// 防止新加到 g_csel 的角色没有进入当前板子角色池。
void BOTC_CustomSyncBoardRoles () {
    int r;
    int n;
    if (g_board != 7) {
        return;
    }
    n = 0;
    for (r = 0; r <= 163; r += 1) {
        if (!g_csel[r] || !BOTC_CustomRoleVisible(r)) {
            continue;
        }
        if (g_roleTeam[r] == 4 || g_roleTeam[r] == 5) {
            continue;
        }
        if (n >= 128) {
            break;
        }
        g_boardRole[(7 * 256) + n] = r;
        n = n + 1;
    }
    if (n > 0) {
        g_boardRoleN[7] = n;
    }
}

void BOTC_GrantRoleOpen () {
    BOTC_CustomSyncBoardRoles();
    g_pickMode[g_teller] = 34;
    g_pickWho[g_teller] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(g_teller, false);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("赋予能力：选择一个任意角色"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消"), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_grantDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_GrantDrunkToggle () {
    g_grantDrunk = !g_grantDrunk;
    if (g_grantDrunk) {
        libNtve_gf_SetDialogItemText(g_grantDrunkBtn, TextWithColor(StringToText("√ 醉酒"), Color(255, 160, 60)), PlayerGroupSingle(g_teller));
    }
    else {
        libNtve_gf_SetDialogItemText(g_grantDrunkBtn, StringToText("醉酒"), PlayerGroupSingle(g_teller));
    }
}

// 替换 / 回收手工能力前，撤掉旧能力自己维护的游戏标记，避免旧被动继续残留。
void BOTC_GrantClearPassiveMarks (int q) {
    int old;
    if (q < 2 || q > 13) {
        return;
    }
    old = g_grantRoleBy[q];
    if (old == 24) {                       // 水手（23）+ 1：不会死亡（水手）26
        g_tokOn[(((g_teller * 14) + q) * 256) + 26] = false;
    }
    if (old == 35) {                       // 弄臣（34）+ 1：首次未死（弄臣）29
        g_tokOn[(((g_teller * 14) + q) * 256) + 29] = false;
    }
}

void BOTC_GrantApply () {
    int n;
    int q;
    string s;
    s = libNtve_gf_DialogItemEditValue(g_grantSeatEdit, g_teller);
    n = BOTC_TextNum(s);
    q = n + 1;
    if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_Notice(g_teller, "玩家号要填 1~12，并且那个座位有人。");
        return;
    }
    if (g_grantRoleSel <= 0 || g_grantRoleSel > 163) {
        BOTC_Notice(g_teller, "先选择一个要赋予的角色能力。");
        return;
    }
    BOTC_GrantClearPassiveMarks(q);
    g_grantRoleBy[q] = g_grantRoleSel;
    g_grantDrunkBy[q] = g_grantDrunk;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = g_nightNum;
    if (!g_isNight || g_grantFirstNight[q] < 1) {
        g_grantFirstNight[q] = g_nightNum + 1;
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    s = "（正常）";
    if (g_grantDrunk) {
        s = "（醉酒·无效）";
    }
    BOTC_PmStore(g_teller, "【赋予能力】" + BOTC_NameStr(q) + " 获得「" + g_roleName[g_grantRoleSel - 1] + "」能力" + s + "。第 " + IntToString(g_grantFirstNight[q]) + " 夜按这项能力的首个夜晚处理；未向玩家发送提示。");
    g_grantOn = false;
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
}

void BOTC_GrantRecycle () {
    int b;
    int n;
    int q;
    string s;
    s = libNtve_gf_DialogItemEditValue(g_grantSeatEdit, g_teller);
    n = BOTC_TextNum(s);
    q = n + 1;
    if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
        BOTC_Notice(g_teller, "玩家号要填 1~12，并且那个座位有人。");
        return;
    }
    // 回收该玩家持有的手工附加能力，以及所有绑定到他的科怪借用能力。
    BOTC_GrantClearPassiveMarks(q);
    g_grantRoleBy[q] = 0;
    g_grantDrunkBy[q] = false;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = 0;
    g_boffinActing[q] = false;
    g_boffinActingSource[q] = 0;
    g_insertWake[q] = false;
    for (b = 2; b <= 13; b += 1) {
        if (b == q || g_boffinTargetBy[b] == q) {
            BOTC_BoffinClearSource(b);
        }
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    BOTC_PmStore(g_teller, "【回收能力】已回收 " + BOTC_NameStr(q) + " 的所有附加能力。未向玩家发送提示。");
}

// 【换身份 = 借来的能力一并收回】（用户 2026-11-11）：失忆者 / 食人族 / 小精灵 / 说书人【赋予能力】
//   挂在 g_grantRoleBy 上的能力，来源都是「他原来的身份」。身份被真正换掉（舞蛇人 / 理发师 /
//   麻脸巫婆 / 说书人改身份等）之后必须一起收回，否则换到新身份的人还会被当成拥有旧能力
//   （例：失忆者换到恶魔后，仍被 BOTC_HasAbility 判定为「拥有舞蛇人能力」）。
void BOTC_GrantLostByRoleChange (int q) {
    int old;
    if (q < 2 || q > 13) {
        return;
    }
    old = g_grantRoleBy[q];
    if (old > 0 && old <= 163) {
        BOTC_GrantClearPassiveMarks(q);      // 水手 / 弄臣那类挂在这份能力上的被动标记先撤掉
        BOTC_PmStore(g_teller, "【换身份】" + BOTC_NameStr(q) + " 的原身份离场 → 收回他借来的「" + g_roleName[old - 1] + "」能力。");
    }
    g_grantRoleBy[q] = 0;
    g_grantDrunkBy[q] = false;
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = 0;
}

void BOTC_GrantClose () {
    g_grantOn = false;
    DialogSetVisible(g_grantDlg, PlayerGroupAll(), false);
}

// ===== 【获得别人能力】（用户 2026-11-03）=====
// 失忆者 73 / 食人族 74 / 变脸师 117 / 小精灵 91 / 炼金术士 95 获得能力时，统一走 g_grantRoleBy 这一层附加能力。
// 这几位获得能力本身都不改本人魔典（玩家自己那份）的角色标记；只有真身是哲学家(56) / 炼金术士(95) /
// 变脸师(117) 时，才把说书人魔典真值行的角色标记换成借到的角色，并补「是哲学家 / 是炼金术士 / 是变脸师」token；
// 二次借用（如变脸师借到哲学家能力后再选一项）只挂能力层，不再改标记、不再追加 token。
void BOTC_AttachGrant (int q, int role, bool useNow) {
    int i;
    bool real;
    bool cann;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    i = 0;
    // 【食人族得知 · 相克】（用户 2026-11-11）：先记下这次获得能力前该座位是不是食人族
    //   （真身 74，或哲学家等借来的食人族能力）；下面覆盖 g_grantRoleBy 后就读不到了。
    cann = BOTC_HasAbility(q, 74);
    // 【套娃不改标记】（用户 2026-11-10）：只有真身是变脸师（117）才改魔典角色标记；
    //   失忆者 / 食人族 / 小精灵 / 哲学家 / 炼金术士等借来变脸师能力时只挂能力层。
    real = false;
    if (g_facePicking == q && BOTC_SeatTrueRole(q) == 117) {
        real = true;
    }
    // 【变脸师（117）】（用户 2026-11-10）：先备份这一层原本借到的能力，夜里恢复时原样还原。
    //   g_faceBase 存的是魔典标记值（角色索引 + 1），还原时直接写回 g_mark，不会差一位。
    //   借用者不改标记，备份值写 0，夜里还原时只清临时状态、不动魔典。
    if (g_facePicking == q && g_faceShow[q] <= 0) {
        if (real) {
            g_faceBase[q] = BOTC_SeatTrueRole(q) + 1;
        }
        else {
            g_faceBase[q] = 0;
        }
        g_facePrevRole[q] = g_grantRoleBy[q];
        g_facePrevFirstNight[q] = g_grantFirstNight[q];
        g_facePrevDrunkBy[q] = g_grantDrunkBy[q];
        g_facePrevActing[q] = g_grantActing[q];
        g_facePrevDoneNight[q] = g_grantDoneNight[q];
    }
    BOTC_GrantClearPassiveMarks(q);
    // 食人族得到新能力时失去旧能力：用 g_grantRoleBy 覆盖即可。被中毒 / 醉酒也照样记录（用户第 10 条）。
    g_grantRoleBy[q] = role + 1;
    // 【变脸师（117）】（用户 2026-11-10）：记录本局获得过的角色，之后网格里不再出现。
    if (BOTC_SeatTrueRole(q) == 117) {
        g_faceEver[(q * 164) + role] = true;
    }
    // 【变脸师（117）】（用户 2026-11-10）：这个座位重新获得「变脸师」能力（哲学家 / 食人族 /
    //   说书人赋予等）时，清掉之前留下的「疯狂失败」记录，之后每个夜晚照常单独询问他。
    if (role == 117) {
        g_faceFail[q] = false;
    }
    // 【真身酒鬼 / 提线木偶借能力】（用户 2026-11-11）：哲学家 / 炼金术士 / 变脸师在真实身份是
    //   酒鬼(14) 或提线木偶(93) 时，照常可以选择角色并借到能力，说书人魔典上的角色标记不改；
    //   这份借来的能力夜间仍按「附加能力」正常唤醒，但视为醉酒状态下使用 ---- 不会正确生效。
    g_grantDrunkBy[q] = false;
    if (BOTC_SeatTrueRole(q) == 14 || BOTC_SeatTrueRole(q) == 93) {
        g_grantDrunkBy[q] = true;
    }
    g_grantActing[q] = false;
    g_grantDoneNight[q] = false;
    g_grantFirstNight[q] = g_nightNum;
    if (!g_isNight || g_grantFirstNight[q] < 1) {
        g_grantFirstNight[q] = g_nightNum + 1;
    }
    // 【变脸师（117）】（用户 2026-11-10）：真身变脸师获得能力后把说书人魔典上的角色标记临时
    //   改成该角色，并在说书人魔典上多放一枚「是变脸师」标记；进入下一个夜晚自动变回。
    //   玩家本人魔典始终显示变脸师本人（用户 2026-11-10）。
    if (g_facePicking == q) {
        g_faceShow[q] = role + 1;
        g_faceEver[(q * 164) + role] = true;
        if (real) {
            i = 1;
            BOTC_FaceMarkSet(q, role);
            BOTC_FaceTokenSet(q, true);
        }
        g_facePicking = 0;
    }
    BOTC_SeatStateSync();
    BOTC_GrimRender(g_teller);
    if (i == 1 && g_who[q] >= 1 && g_who[q] <= 13 && g_who[q] != g_teller) {
        BOTC_GrimRender(g_who[q]);
    }
    if (i == 1) {
        BOTC_PmStore(g_teller, "【变脸师】" + BOTC_NameStr(q) + " 今晚获得「" + g_roleName[role] + "」能力：说书人魔典上的角色标记已临时改成该角色，并放置「是变脸师」标记（他本人魔典仍显示变脸师）；下个夜晚自动变回。");
    }
    else {
        if (g_faceShow[q] > 0) {
            BOTC_PmStore(g_teller, "【变脸师】" + BOTC_NameStr(q) + " 今晚获得「" + g_roleName[role] + "」能力（借用变脸师能力，不改魔典角色标记）；下个夜晚自动失效并恢复借来的变脸师能力。");
        }
        else {
            BOTC_PmStore(g_teller, "【获得能力】" + BOTC_NameStr(q) + " 获得「" + g_roleName[role] + "」能力（不改身份、不打哲学 / 炼金术士 token）。");
        }
    }
    // 【食人族×疯子】（用户 2026-11-10）：吃到疯子能力 → 告知他现在是剧本上的某个恶魔（说书人从恶魔网格里选），
    //   之后按疯子的夜序唤醒他假刀；换成其他能力时清掉这层认知。
    if (BOTC_HasAbility(q, 74)) {
        if (role == 38) {
            if (!g_cannLun[q]) {
                g_cannLun[q] = true;
                g_cannLunDemon[q] = -1;
                g_cannSeat = q;
                g_cannSrc = 0;
                BOTC_CannOpen(38);
            }
        }
        else {
            g_cannLun[q] = false;
            g_cannLunDemon[q] = -1;
        }
    }
    // 【食人族得知 · 相克】（用户 2026-11-11）：食人族吃到「狂热者」或「管家」时，本人直接得知
    //   获得了这项能力（相克文案：如果食人族获得了狂热者的能力，他会得知这一信息）。
    if (cann && (role == 110 || role == 13)) {
        BOTC_PmInfo(g_who[q], "你得知：你获得了「" + g_roleName[role] + "」能力。");
    }
}

// 获得能力时若选到哲学家 / 炼金术士：继续选一层真正生效的能力（第 5 条）。
void BOTC_AttachGrantOrNest (int q, int role) {
    int cp;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    if (role == 56) {
        cp = g_teller;
        BOTC_PmStore(cp, "【获得能力】" + BOTC_NameStr(q) + " 获得的是哲学家能力：再选择一项善良能力。");
        g_pickMode[cp] = 35;
        g_pickAttachSeat[cp] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(cp, true);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("哲学家能力：再选择一项善良能力（" + BOTC_NameStr(q) + "）"), PlayerGroupSingle(cp));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
        return;
    }
    if (role == 95) {
        cp = g_teller;
        BOTC_PmStore(cp, "【获得能力】" + BOTC_NameStr(q) + " 获得的是炼金术士能力：再选择一项爪牙能力。");
        g_pickMode[cp] = 36;
        g_pickAttachSeat[cp] = q;
        g_pickTeam = -1;
        g_pickAlign = -1;
        BOTC_PickFilter(cp, false);
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("炼金术士能力：再选择一项爪牙能力（" + BOTC_NameStr(q) + "）"), PlayerGroupSingle(cp));
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
        return;
    }
    BOTC_AttachGrant(q, role, true);
}

// 放弃这次获得能力；失忆者取消（DIY）时只提醒说书人，不再打 token。
void BOTC_AttachCancel (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    // 【变脸师（117）】（用户 2026-11-12）：取消只代表今晚不给予能力，下个夜晚仍会询问；
    //   永久停用改由弹窗里的【永久失去】处理。
    if (g_facePicking == q) {
        g_facePicking = 0;
        BOTC_PmStore(g_teller, "【变脸师】" + BOTC_NameStr(q) + " 今晚不获得能力；下个夜晚仍会询问。");
        return;
    }
    if (BOTC_SeatTrueRole(q) == 73) {
        BOTC_PmStore(g_teller, "【失忆者】已按「DIY 能力」处理：" + BOTC_NameStr(q) + "，能力由说书人自行裁定。");
    }
}

void BOTC_PickAbortAttach (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    q = g_pickAttachSeat[p];
    if (q <= 0) {
        return;
    }
    g_pickAttachSeat[p] = 0;
    BOTC_AttachCancel(q);
}

// 【变脸师（117）】（用户 2026-11-12）：说书人判定他没有疯狂且暴露了变脸师身份 → 永久失去能力。
//   关闭能力网格并记入 g_faceFail，此后这个座位不再弹窗询问。
void BOTC_FaceLoseNow (int p) {
    int q;
    if (p < 1 || p > 13) {
        return;
    }
    q = g_pickAttachSeat[p];
    g_pickAttachSeat[p] = 0;
    g_pickMode[p] = 0;
    g_pickTeam = -1;
    g_pickAlign = -1;
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(p), false);
    if (q >= 2 && q <= 13) {
        g_facePicking = 0;
        g_faceFail[q] = true;
        BOTC_PmStore(g_teller, "【变脸师】" + BOTC_NameStr(q) + "：说书人判定他没有疯狂并暴露了身份，永久失去能力，本局不再为他弹窗。");
    }
}

// 失忆者首夜：全部善良角色（含当前剧本没有的）
void BOTC_AmnePickOpen (int q) {
    int cp;
    if (q < 2 || q > 13) {
        return;
    }
    cp = g_teller;
    g_pickMode[cp] = 46;
    g_pickAttachSeat[cp] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（DIY能力）"), PlayerGroupSingle(cp));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(cp), true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【失忆者】首夜：选择他获得的能力（全部善良角色 / 爪牙）"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
    BOTC_PmStore(cp, "【失忆者】首夜选择：" + BOTC_NameStr(q) + " 的能力（善良角色或爪牙）。点角色 = 获得该能力；取消 = 由说书人 DIY。");
}

// 食人族：处决夜先从当前剧本全部角色里发能力
void BOTC_CannPickOpen (int q) {
    int cp;
    if (q < 2 || q > 13) {
        return;
    }
    cp = g_teller;
    g_pickMode[cp] = 47;
    g_pickAttachSeat[cp] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（不给能力）"), PlayerGroupSingle(cp));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(cp), true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【食人族】今日有人死于处决：选择他获得的能力"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
    BOTC_PmStore(cp, "【食人族】今日处决结算：先给 " + BOTC_NameStr(q) + " 选一项本剧本角色能力，取消 = 不获得。");
}

// 【变脸师（117）】（用户 2026-11-10）：第二夜起每晚由说书人决定是否给予一项镇民能力；
//   取消 = 今晚不给（下个夜晚仍会询问）；【永久失去】= 本局不再询问这个座位。
void BOTC_FacePickOpen (int q) {
    int cp;
    if (q < 2 || q > 13) {
        return;
    }
    cp = g_teller;
    g_facePicking = q;
    g_pickMode[cp] = 48;
    g_pickAttachSeat[cp] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（今晚不给）"), PlayerGroupSingle(cp));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(cp), true);
    // 【永久失去】（用户 2026-11-12）：取消旁边多一个按钮，点后本局不再弹窗。
    libNtve_gf_SetDialogItemText(g_pickClose, StringToText("永久失去"), PlayerGroupSingle(cp));
    DialogControlSetVisible(g_pickClose, PlayerGroupSingle(cp), true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【变脸师】是否给予今晚的能力？（本剧本善良角色，不能选已获得过的）"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
    if (BOTC_SeatTrueRole(q) == 117) {
        BOTC_PmStore(cp, "【变脸师】" + BOTC_NameStr(q) + "：点角色 = 今晚获得该能力，说书人魔典上的角色标记临时改成该角色，并放置「是变脸师」标记（他本人魔典仍显示变脸师）；取消 = 今晚不给，下个夜晚仍会询问；永久失去 = 判定他没有疯狂并暴露身份，本局不再询问。");
    }
    else if (BOTC_SeatTrueRole(q) == 14 || BOTC_SeatTrueRole(q) == 93) {
        BOTC_PmStore(cp, "【变脸师】" + BOTC_NameStr(q) + " 真身是酒鬼/提线木偶：照常给一项善良角色能力，但按醉酒处理（不会正确生效）；说书人魔典上的角色标记不改。取消 = 今晚不给，下个夜晚仍会询问；永久失去 = 本局不再询问他。");
    }
    else {
        BOTC_PmStore(cp, "【变脸师】" + BOTC_NameStr(q) + " 是借用变脸师能力（失忆者 / 食人族 / 小精灵 / 哲学家等）：点角色只挂能力、不改魔典角色标记；取消 = 今晚不给，下个夜晚仍会询问；永久失去 = 本局不再询问他。");
    }
}


// 【变脸师（117）】把说书人真值行的角色标记临时改成借到的角色（玩家本人那一份不改）。
void BOTC_FaceMarkSet (int q, int role) {
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    g_mark[(g_teller * 14) + q] = role + 1;
}

// 【变脸师（117）】「是变脸师」标记只放在说书人的魔典上。
void BOTC_FaceTokenSet (int q, bool on) {
    int i;
    if (q < 2 || q > 13) {
        return;
    }
    for (i = 0; i < 14; i += 1) {
        g_tokOn[(((i * 14) + q) * 256) + 205] = on && (i == g_teller);
    }
}

// 【变脸师（117）】身份被真正改掉 / 新局时，清空临时变脸状态（不还原标记，由调用方写入新身份）。
void BOTC_FaceStateClear (int q) {
    int i;
    if (q < 1 || q > 13) {
        return;
    }
    g_faceShow[q] = 0;
    g_faceBase[q] = 0;
    g_faceFail[q] = false;
    g_facePrevRole[q] = 0;
    g_facePrevFirstNight[q] = 0;
    g_facePrevDrunkBy[q] = false;
    g_facePrevActing[q] = false;
    g_facePrevDoneNight[q] = false;
    for (i = 0; i < 14; i += 1) {
        g_tokOn[(((i * 14) + q) * 256) + 205] = false;
    }
}

// 【变脸师（117）】进入下一个夜晚：把说书人真值行的角色标记还原成变脸师本人，移除「是变脸师」标记，
//   并还原本层借用的能力（玩家本人那一份始终显示变脸师，不用还原）。
void BOTC_FaceNightRevert () {
    int q;
    int i;
    bool any;
    any = false;
    for (q = 2; q <= 13; q += 1) {
        if (g_faceShow[q] <= 0) {
            continue;
        }
        any = true;
        // 只说书人真值行：玩家本人魔典上这一格从没被改过。
        if (g_faceBase[q] > 0) {
            if (g_mark[(g_teller * 14) + q] == g_faceShow[q]) {
                g_mark[(g_teller * 14) + q] = g_faceBase[q];
            }
        }
        g_faceShow[q] = 0;
        g_faceBase[q] = 0;
        for (i = 0; i < 14; i += 1) {
            g_tokOn[(((i * 14) + q) * 256) + 205] = false;
        }
        // 还原这一层「变脸师」覆盖前借到的能力（真变脸师原本没有 → 清空）。
        g_grantRoleBy[q] = g_facePrevRole[q];
        g_grantFirstNight[q] = g_facePrevFirstNight[q];
        g_grantDrunkBy[q] = g_facePrevDrunkBy[q];
        g_grantActing[q] = g_facePrevActing[q];
        g_grantDoneNight[q] = g_facePrevDoneNight[q];
        g_facePrevRole[q] = 0;
        g_facePrevFirstNight[q] = 0;
        g_facePrevDrunkBy[q] = false;
        g_facePrevActing[q] = false;
        g_facePrevDoneNight[q] = false;
    }
    if (any) {
        BOTC_GrimRender(g_teller);
        for (q = 2; q <= 13; q += 1) {
            if (g_who[q] >= 1 && g_who[q] <= 13 && g_who[q] != g_teller) {
                BOTC_GrimRender(g_who[q]);
            }
        }
        BOTC_PmStore(g_teller, "【变脸师】进入新的夜晚：已移除「是变脸师」标记，说书人魔典上的角色标记已还原成变脸师本人。");
    }
}

// 小精灵：得知的镇民死亡后，说书人确认是否获得其能力
void BOTC_PixieAskOpen (int q, int role) {
    int cp;
    if (q < 2 || q > 13 || role < 0 || role > 163) {
        return;
    }
    cp = g_teller;
    g_pickOnlyRole = role;
    g_pickMode[cp] = 49;
    g_pickAttachSeat[cp] = q;
    g_pickTeam = -1;
    g_pickAlign = -1;
    BOTC_PickFilter(cp, false);
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("取消（不获得）"), PlayerGroupSingle(cp));
    DialogControlSetVisible(g_pickClear, PlayerGroupSingle(cp), true);
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("【小精灵】得知的" + g_roleName[role] + "已死亡：是否获得其能力？"), PlayerGroupSingle(cp));
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(cp), true);
    BOTC_PmStore(cp, "【小精灵】" + BOTC_NameStr(q) + " 得知的镇民「" + g_roleName[role] + "」死亡：点角色 = 获得能力，取消 = 不获得。");
}

// 夜间唤醒之前的「非唤醒、非私聊」能力发放步骤（用户第 4 / 7 / 11 条）。
bool BOTC_PreGrantStep () {
    int q;
    int role;
    int i;
    if (!g_isNight) {
        return false;
    }
    // 1. 失忆者首夜
    if (g_amneDoneNight <= 0) {
        q = BOTC_SeatOfRole(73);
        if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false) {
            g_amneDoneNight = 1;
            BOTC_AmnePickOpen(q);
            return true;
        }
    }
    // 2. 食人族：今天有人死于处决
    //    【持续检测】（用户 2026-11-10）：中途被创造出来的食人族也按「饱餐」标记判断——
    //    只要最后一名死于处决的玩家就死在刚刚结束的这一天，就照样补发一次能力。
    //    【自动获得】（用户 2026-11-10）：食人族没中毒 / 醉酒时不再由说书人选，
    //    直接自动获得「饱餐」持有者（最后一名死于处决的玩家）的能力；
    //    中毒 / 醉酒时才弹出身份网格，由说书人自己决定给什么能力（或取消不给）。
    if (g_cannDoneNight != g_nightNum && (g_cannPending > 0 || (g_cannFedSeat >= 2 && g_cannFedSeat <= 13 && g_cannFedDay == g_dayNum))) {
        g_cannPending = 0;
        // 【检测食人族能力者】（用户 2026-11-10）：按能力判定，而不是只看真实角色 74——
        //   失忆者 / 哲学家等借到食人族能力的座位同样要发这一次能力。
        q = BOTC_CannSeat();
        if (q < 2) {
            q = BOTC_CannAbilitySeat();
        }
        if (q >= 2 && q <= 13 && BOTC_SeatDead(q) == false) {
            g_cannDoneNight = g_nightNum;
            // 【一定手动发放】（用户 2026-11-12）：不再自动附加能力，统一打开角色网格由说书人选。
            g_cannRestore[q] = false;
            BOTC_PmStore(g_teller, "【食人族】" + BOTC_NameStr(q) + " 今晚获得一次能力：请手动选择要发放的角色（可取消不给）。");
            BOTC_CannPickOpen(q);
            return true;
        }
    }
    // 3. 变脸师（含借用该能力的座位）：第二夜起每晚一次；取消过（疯狂失败）的座位不再询问
    if (g_nightNum >= 2) {
        for (i = 2; i <= 13; i += 1) {
            if (BOTC_SeatDead(i) || g_faceFail[i] || g_faceDone[i] == g_nightNum) {
                continue;
            }
            // 【真身酒鬼 / 提线木偶的变脸师】（用户 2026-11-11）：魔典上写着变脸师就照常问，
            //   借到的能力按醉酒处理（不会正确生效）。
            if (!BOTC_HasAbility(i, 117) && g_mark[(g_teller * 14) + i] - 1 != 117) {
                continue;
            }
            g_faceDone[i] = g_nightNum;
            BOTC_FacePickOpen(i);
            return true;
        }
    }
    // 4. 小精灵（借到该能力的座位，例如食人族）：还没挑过镇民玩家 → 先让说书人挑一个在场的镇民玩家
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i) == false && BOTC_HasAbility(i, 91) && BOTC_SeatTrueRole(i) != 91 && g_pixieRoleBy[i] <= 0 && !g_pixieAsked[i]) {
            g_pixieAsked[i] = true;
            BOTC_MiFnOpen(i, 26);
            return true;
        }
    }
    // 5. 小精灵：得知的镇民已经死亡，且还没用掉机会
    for (i = 2; i <= 13; i += 1) {
        if (BOTC_SeatDead(i) == false && g_pixieRoleBy[i] > 0 && !g_pixieDone[i] && BOTC_HasAbility(i, 91)) {
            role = g_pixieRoleBy[i] - 1;
            // 【退出玩家不触发】（用户 2026-11-11）：得知的镇民是退出 / 掉线 / 被踢出的蓝叉玩家时，
            //   这次死亡不算数，不给小精灵补发能力（他仍在场、仍可等这名镇民真正的死亡）。
            if (g_pixieSeatBy[i] > 0 && BOTC_SeatDead(g_pixieSeatBy[i]) && !g_leftDeadP[g_who[g_pixieSeatBy[i]]]) {
                g_pixieDone[i] = true;
                BOTC_PixieAskOpen(i, role);
                return true;
            }
        }
    }
    return false;
}

void BOTC_SpecSeatRender () {
    int i;
    int x;
    string s;
    bool card;
    for (i = 0; i < 6; i += 1) {
        card = (g_specBluffOn && i < 3);
        if (card) {
            // 【身份卡】（用户 2026-11-04）：正方形，中间头像，左下角角色名
            x = 30 + (i * 120);
            DialogControlSetSize(g_specRoleBtn[i], PlayerGroupAll(), 100, 100);
            DialogControlSetPosition(g_specRoleBtn[i], PlayerGroupAll(), c_anchorTopLeft, x, 126);
            DialogControlSetSize(g_specRoleIcon[i], PlayerGroupAll(), 100, 100);
            DialogControlSetPosition(g_specRoleIcon[i], PlayerGroupAll(), c_anchorTopLeft, x, 126);
            DialogControlSetPosition(g_specRoleName[i], PlayerGroupAll(), c_anchorTopLeft, x + 4, 202);
            libNtve_gf_SetDialogItemText(g_specRoleBtn[i], StringToText(""), PlayerGroupAll());
            if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
                s = g_roleName[g_specRoleSel[i] - 1];
                libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], BOTC_IconName(g_specRoleSel[i] - 1), PlayerGroupAll());
            }
            else {
                s = "选身份";
                libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], "botc_blank.dds", PlayerGroupAll());
            }
            libNtve_gf_SetDialogItemText(g_specRoleName[i], StringToText(s), PlayerGroupAll());
            DialogControlSetVisible(g_specRoleIcon[i], PlayerGroupAll(), true);
            DialogControlSetVisible(g_specRoleName[i], PlayerGroupAll(), true);
        }
        else {
            x = 30 + (i * 180);
            DialogControlSetSize(g_specRoleBtn[i], PlayerGroupAll(), 160, 44);
            DialogControlSetPosition(g_specRoleBtn[i], PlayerGroupAll(), c_anchorTopLeft, x, 162);
            if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
                s = IntToString(i + 1) + "：" + g_roleName[g_specRoleSel[i] - 1];
            }
            else {
                s = IntToString(i + 1) + "：选身份";
            }
            libNtve_gf_SetDialogItemText(g_specRoleBtn[i], StringToText(s), PlayerGroupAll());
            libNtve_gf_SetDialogItemImage(g_specRoleIcon[i], "botc_blank.dds", PlayerGroupAll());
            DialogControlSetVisible(g_specRoleIcon[i], PlayerGroupAll(), false);
            DialogControlSetVisible(g_specRoleName[i], PlayerGroupAll(), false);
        }
    }
}

void BOTC_SpecSeatClear () {
    int i;
    for (i = 0; i < 6; i += 1) {
        libNtve_gf_SetDialogItemText(g_specSeatEdit[i], StringToText(""), PlayerGroupAll());
        g_specRoleSel[i] = 0;
    }
    BOTC_SpecSeatRender();
}

void BOTC_SpecSeatShow (int q) {
    int i;
    if (q < 2 || q > 13) {
        return;
    }
    g_specTo = q;
    g_specMode = 3;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specGrantBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specMarkBtn, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), true);
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), true);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemText(g_specInfoClear, StringToText("清空全部"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送给他"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, BOTC_NameSubstText(StringToText("玩家号 + 身份：发给 " + BOTC_NameStr(q))), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("玩家号最多 6 个（1~12）；身份按钮可选 0~6 个。只填玩家号 → 发玩家号；1 个玩家号 + 1 个身份 → A是B；有多个结果 → 自动拼成列表。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("取消"), PlayerGroupAll());
    BOTC_SpecSeatClear();
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecRoleOpen (int i) {
    if (i < 0 || i > 5) {
        return;
    }
    // 【发送不在场身份】（用户 2026-11-04）：模式 6（选角色）/ 8（已选好收件人）只允许前 3 个坑位
    if (g_specMode == 6 || g_specMode == 8) {
        if (i > 2) {
            return;
        }
        g_specBluffOn = true;
        g_specPickSlot = i;
        g_specMode = 4;
        g_pickMode[g_teller] = 29;
        g_pickWho[g_teller] = g_specTo;
        g_pickTeam = -1;
        g_pickAlign = -1;
        libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(i + 1) + " 个不在场身份"), PlayerGroupSingle(g_teller));
        libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
        BOTC_PickFilter(g_teller, false);
        DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), false);
        DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
        return;
    }
    if (g_specMode != 3 || g_specTo < 2 || g_specTo > 13) {
        return;
    }
    g_specBluffOn = false;
    g_specPickSlot = i;
    g_specMode = 4;
    g_pickMode[g_teller] = 29;
    g_pickWho[g_teller] = g_specTo;
    g_pickTeam = -1;
    g_pickAlign = -1;
    libNtve_gf_SetDialogItemText(g_pickTitle, StringToText("选择第 " + IntToString(i + 1) + " 个身份（点空白处不选）"), PlayerGroupSingle(g_teller));
    libNtve_gf_SetDialogItemText(g_pickClear, StringToText("清除这个身份"), PlayerGroupSingle(g_teller));
    BOTC_PickFilter(g_teller, false);
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), false);
    DialogSetVisible(g_pickDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecSeatSend () {
    int i;
    int n;
    int r;
    int seatN;
    int roleN;
    string one;
    string seats;
    string roles;
    string msg;
    // 【发送不在场身份】（用户 2026-11-04）：模式 8 的【发送】走自己的流程
    if (g_specMode == 8) {
        BOTC_SpecBluffSend();
        return;
    }
    // 模式 6：独立面板的【发送】→ 收起面板，点座位直接发送
    if (g_specMode == 6) {
        BOTC_MBluffSend();
        return;
    }
    if (g_specTo < 2 || g_specTo > 13) {
        return;
    }
    seats = "";
    roles = "";
    seatN = 0;
    roleN = 0;
    for (i = 0; i < 6; i += 1) {
        one = libNtve_gf_DialogItemEditValue(g_specSeatEdit[i], g_teller);
        if (StringLength(one) > 0) {
            n = BOTC_TextNum(one);
            if (n < 1 || n > 12) {
                BOTC_Notice(g_teller, "第 " + IntToString(i + 1) + " 个玩家号不对：只能填 1~12，留空表示不用这一格。");
                return;
            }
            if (seatN > 0) {
                seats = seats + ",";
            }
            seats = seats + BOTC_NameStr(n + 1);
            seatN = seatN + 1;
        }
        if (g_specRoleSel[i] > 0 && g_specRoleSel[i] <= 163) {
            r = g_specRoleSel[i] - 1;
            if (roleN > 0) {
                roles = roles + ",";
            }
            roles = roles + g_roleName[r];
            roleN = roleN + 1;
        }
    }
    if (seatN <= 0 && roleN <= 0) {
        BOTC_Notice(g_teller, "至少填一个玩家号，或选择一个身份。");
        return;
    }
    if (seatN > 0 && roleN <= 0) {
        msg = "【信息】你得知" + seats + "。";
    }
    else {
        if (seatN <= 0) {
            msg = "【信息】你得知" + roles + "。";
        }
        else {
            if (seatN == 1 && roleN == 1) {
                msg = "【信息】你得知" + seats + "是" + roles + "。";
            }
            else {
                msg = "【信息】你得知" + seats + "中有" + roles + "。";
            }
        }
    }
    BOTC_PmInfo(g_who[g_specTo], msg);
    BOTC_PmStore(g_teller, "【说书人工具】已发给 " + BOTC_NameStr(g_specTo) + "：" + msg);
    BOTC_SpecClose();
}

void BOTC_RecogClose () {
    int i;
    for (i = 0; i < 7; i += 1) {
        libNtve_gf_SetDialogItemText(g_recogEdit[i], StringToText(""), PlayerGroupAll());
    }
    g_recogTo = 0;
    DialogSetVisible(g_recogDlg, PlayerGroupAll(), false);
}

void BOTC_RecogOpen (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    BOTC_RecogClose();
    g_recogTo = q;
    libNtve_gf_SetDialogItemText(g_recogTitle, BOTC_NameSubstText(StringToText("发送互认：发给 " + BOTC_NameStr(q))), PlayerGroupSingle(g_teller));
    DialogSetVisible(g_recogDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_RecogSend () {
    int i;
    int j;
    int n;
    int q;
    int dn;
    int mn;
    int[7] vals;
    string raw;
    string sd;
    string sm;
    string msg;
    if (g_recogTo < 2 || g_recogTo > 13) {
        BOTC_Notice(g_teller, "先点一名玩家作为互认信息的收件人。");
        return;
    }
    sd = "";
    sm = "";
    dn = 0;
    mn = 0;
    for (i = 0; i < 7; i += 1) {
        vals[i] = 0;
    }
    for (i = 0; i < 7; i += 1) {
        raw = libNtve_gf_DialogItemEditValue(g_recogEdit[i], g_teller);
        if (StringLength(raw) <= 0) {
            continue;
        }
        n = BOTC_TextNum(raw);
        q = n + 1;
        if (n < 1 || n > 12 || q < 2 || q > 13 || !g_seatOn[q]) {
            BOTC_Notice(g_teller, "第 " + IntToString(i + 1) + " 个输入框只能填 1~12，并且对应座位必须有人。");
            return;
        }
        for (j = 0; j < i; j += 1) {
            if (vals[j] == q) {
                BOTC_Notice(g_teller, "座位号 " + IntToString(n) + " 重复填写了。");
                return;
            }
        }
        vals[i] = q;
        if (i < 2) {
            if (dn > 0) {
                sd = sd + ",";
            }
            sd = sd + BOTC_NameStr(q);
            dn = dn + 1;
        }
        else {
            if (mn > 0) {
                sm = sm + ",";
            }
            sm = sm + BOTC_NameStr(q);
            mn = mn + 1;
        }
    }
    if (dn <= 0 && mn <= 0) {
        BOTC_Notice(g_teller, "至少填写一个恶魔或爪牙的座位号。");
        return;
    }
    if (dn > 0) {
        msg = "【信息】你得知" + sd + "是恶魔。";
        if (mn > 0) {
            msg = msg + "爪牙：" + sm + "。";
        }
    }
    else {
        msg = "【信息】你得知爪牙：" + sm + "。";
    }
    BOTC_PmInfo(g_who[g_recogTo], msg);
    BOTC_PmStore(g_teller, "【发送互认】已发给 " + BOTC_NameStr(g_recogTo) + "：" + msg);
    BOTC_RecogClose();
}

// 选好收件人（q = 格子）：自定义文本走共用答题框；玩家号 + 身份 / 手动互认走各自面板
void BOTC_SpecPickSeat (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    if (g_specMode == 1) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_ManInfoOpen(q, 808, "输入自定义文本（发送时自动加「你得知」）");
        return;
    }
    if (g_specMode == 2) {
        BOTC_SpecSeatShow(q);
        return;
    }
    if (g_specMode == 5) {
        g_specMode = 0;
        g_specTo = 0;
        BOTC_RecogOpen(q);
        return;
    }
    // 【发送不在场身份 · 独立面板】（用户 2026-11-04）：已点【发送】，点座位 = 直接发送
    if (g_specMode == 7) {
        if (q < 2 || q > 13) {
            return;
        }
        g_specTo = q;
        BOTC_SpecBluffSend();
    }
}

// ==================================================================================================
// 【发送不在场身份】（用户 2026-11-04）：说书人不再用右下角面板手动选 / 发送。
//   流程：发送特定信息 → 发送不在场身份 → 点 3 个身份按钮各选一个角色 → 自动提示点座位选收件人
//         → 面板重新弹出显示 3 个角色 + 【发送】/【取消】。
//   左下角原有的「不在场身份」面板改为只给收到的玩家看，说书人不再显示。
// ==================================================================================================
void BOTC_SpecBluffRoleShow () {
    g_specMode = 6;
    g_specBluffOn = true;
    g_mbOn = true;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_MBluffRender();
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecBluffOpen () {
    int i;
    g_specTo = 0;
    g_specPickSlot = 0;
    for (i = 0; i < 6; i += 1) {
        g_specRoleSel[i] = 0;
    }
    BOTC_SpecBluffRoleShow();
}

// 3 个角色已经选满 → 收起面板，等说书人点一个座位当收件人
void BOTC_SpecBluffSeatAsk () {
    g_specMode = 7;
    DialogSetVisible(g_specDlg, PlayerGroupAll(), false);
    BOTC_NoticeKeep(g_teller, "【发送不在场身份】已选好 3 个身份：点一个玩家的座位 = 收件人；不想发送就再点【说书人工具】取消。");
}

// 收件人已选好：面板重新弹出，显示 3 个角色 + 【发送】/【取消】
void BOTC_SpecBluffSeatShow () {
    int i;
    g_specMode = 8;
    g_specBluffOn = true;
    DialogControlSetVisible(g_specBtn1, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn2, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specRecogBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specQuickBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specCastBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specGrantBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specMarkBtn, PlayerGroupAll(), false);
    for (i = 0; i < 6; i += 1) {
        DialogControlSetVisible(g_specSeatEdit[i], PlayerGroupAll(), false);
    }
    for (i = 0; i < 3; i += 1) {
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), true);
    }
    for (i = 3; i < 6; i += 1) {
        DialogControlSetVisible(g_specRoleBtn[i], PlayerGroupAll(), false);
    }
    DialogControlSetVisible(g_specInfoClear, PlayerGroupAll(), true);
    DialogControlSetVisible(g_specInfoOk, PlayerGroupAll(), true);
    libNtve_gf_SetDialogItemText(g_specInfoClear, StringToText("随机 3 个"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specInfoOk, StringToText("发送"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specTitle, BOTC_NameSubstText(StringToText("发送不在场身份（2 / 2：发给 " + BOTC_NameStr(g_specTo) + "）")), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specHint, StringToText("点【发送】把这 3 个不在场身份发给他；也可以点【随机 3 个】重抽；点【取消】不发送。"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(g_specClose, StringToText("取消"), PlayerGroupAll());
    BOTC_SpecSeatRender();
    DialogSetVisible(g_specDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_SpecBluffSeatPick (int q) {
    if (q < 2 || q > 13) {
        return;
    }
    g_specTo = q;
    BOTC_SpecBluffSeatShow();
}

// ==================================================================================================
// 【发送不在场身份 · 独立面板】（用户 2026-11-04）：不再和【发送特定信息】共用面板。
//   流程：发送特定信息 → 发送不在场身份 → 独立面板选 / 随机 3 个角色 → 点【发送】
//         → 面板收起，直接点一名玩家的座位即可发送；不想发就再点【说书人工具】取消。
void BOTC_MBluffRender () {
    int i;
    int v;
    string s;
    if (!g_mbOn) {
        DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
        return;
    }
    libNtve_gf_SetDialogItemText(g_mbTitle, StringToText("手动发送不在场身份"), PlayerGroupSingle(g_teller));
    // 【游戏正式开始前隐藏【发送】】（用户 2026-11-08）：准备阶段只允许选身份，正式开始后才能发送
    if (g_started) {
        DialogControlSetVisible(g_mbSendBtn, PlayerGroupAll(), true);
        libNtve_gf_SetDialogItemText(g_mbHint, StringToText("点【随机 3 个】自动填充，或点身份卡逐个选择；点【发送】后，直接点一名玩家的座位即可发送。不想发送就再点【说书人工具】取消。"), PlayerGroupSingle(g_teller));
    }
    else {
        DialogControlSetVisible(g_mbSendBtn, PlayerGroupAll(), false);
        libNtve_gf_SetDialogItemText(g_mbHint, StringToText("点【随机 3 个】自动填充，或点身份卡逐个选择；游戏正式开始后才能发送。不想发送就再点【说书人工具】取消。"), PlayerGroupSingle(g_teller));
    }
    for (i = 0; i < 3; i += 1) {
        libNtve_gf_SetDialogItemText(g_mbRoleBtn[i], StringToText(""), PlayerGroupSingle(g_teller));
        v = g_specRoleSel[i];
        if (v >= 1 && v <= 163) {
            s = g_roleName[v - 1];
            libNtve_gf_SetDialogItemImage(g_mbRoleIcon[i], BOTC_IconName(v - 1), PlayerGroupSingle(g_teller));
        }
        else {
            s = "选身份";
            libNtve_gf_SetDialogItemImage(g_mbRoleIcon[i], "botc_blank.dds", PlayerGroupSingle(g_teller));
        }
        libNtve_gf_SetDialogItemText(g_mbRoleName[i], StringToText(s), PlayerGroupSingle(g_teller));
    }
    DialogSetVisible(g_mbDlg, PlayerGroupSingle(g_teller), true);
}

void BOTC_MBluffRoll () {
    int i;
    BOTC_BluffRoll();
    for (i = 0; i < 3; i += 1) {
        g_specRoleSel[i] = g_bluffPick[i];
    }
    BOTC_MBluffRender();
}

void BOTC_MBluffSend () {
    int i;
    int v;
    // 【游戏正式开始前不允许发送】（用户 2026-11-08）
    if (!g_started) {
        BOTC_Notice(g_teller, "游戏正式开始后才能发送不在场身份。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        v = g_specRoleSel[i];
        if (v < 1 || v > 163) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（第 " + IntToString(i + 1) + " 个还是空的）。");
            return;
        }
    }
    g_specMode = 7;
    g_mbOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    BOTC_NoticeKeep(g_teller, "【发送不在场身份】已选好 3 个身份：点一名玩家的座位即可发送；不想发送就再点【说书人工具】取消。");
}

void BOTC_MBluffCancel () {
    g_mbOn = false;
    g_specMode = 0;
    g_specTo = 0;
    g_specPickSlot = 0;
    g_specBluffOn = false;
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
}

void BOTC_BuildMBluff () {
    int i;
    int x;
    DialogCreate(760, 300, c_anchorCenter, 0, -40, false);
    g_mbDlg = DialogLastCreated();
    DialogSetVisible(g_mbDlg, PlayerGroupAll(), false);
    BOTC_FrameSilver(g_mbDlg, 760, 300);
    g_mbTitle = BOTC_NewLabel(g_mbDlg, 720, 30, 20, 10, StringToText("手动发送不在场身份"));
    libNtve_gf_SetDialogItemStyle(g_mbTitle, "ModLeftSize20Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mbTitle, false, PlayerGroupAll());
    g_mbHint = BOTC_NewLabel(g_mbDlg, 720, 52, 20, 42, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_mbHint, "ModLeftSize16Bold", PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_mbHint, false, PlayerGroupAll());
    for (i = 0; i < 3; i += 1) {
        x = 60 + (i * 240);
        g_mbRoleBtn[i] = BOTC_NewButton(g_mbDlg, 110, 110, x, 100, "");
        g_mbRoleIcon[i] = BOTC_NewImageItem(g_mbDlg, 110, 110, x, 100, "botc_blank.dds");
        g_mbRoleName[i] = BOTC_NewLabel(g_mbDlg, 102, 20, x + 4, 186, StringToText(""));
        libNtve_gf_SetDialogItemStyle(g_mbRoleName[i], "ModLeftSize16Bold", PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(g_mbRoleName[i], false, PlayerGroupAll());
    }
    g_mbRollBtn = BOTC_NewButton(g_mbDlg, 200, 44, 40, 216, "随机 3 个");
    g_mbSendBtn = BOTC_NewButton(g_mbDlg, 200, 44, 280, 216, "发送");
    g_mbCancelBtn = BOTC_NewButton(g_mbDlg, 200, 44, 520, 216, "取消");
    BOTC_MBluffRender();
}

// 【随机 3 个】（用户 2026-11-04）：规则与发给恶魔的随机不在场一致
void BOTC_SpecBluffRoll () {
    BOTC_MBluffRoll();
}

void BOTC_SpecBluffSend () {
    int i;
    int v;
    // 【游戏正式开始前不允许发送】（用户 2026-11-08）
    if (!g_started) {
        BOTC_Notice(g_teller, "游戏正式开始后才能发送不在场身份。");
        return;
    }
    if (g_specTo < 2 || g_specTo > 13) {
        BOTC_Notice(g_teller, "还没有选择收件人：点一个玩家的座位。");
        return;
    }
    for (i = 0; i < 3; i += 1) {
        v = g_specRoleSel[i];
        if (v < 1 || v > 163) {
            BOTC_Notice(g_teller, "请先把 3 个不在场身份选满（第 " + IntToString(i + 1) + " 个还是空的）。");
            return;
        }
    }
    for (i = 0; i < 3; i += 1) {
        g_bluffPick[i] = g_specRoleSel[i];
    }
    BOTC_BluffSendAt(g_specTo);       // 共用原来那套：给对方显示右下角面板 + 通知
    BOTC_SpecClose();
}
void BOTC_BuildGrim () {
    int i;
    int q;
    int t;
    int f;
    DialogCreate(1053, 936, c_anchorRight, 0, -70, false);
    g_grimDlg = DialogLastCreated();
    DialogSetVisible(g_grimDlg, PlayerGroupAll(), false);
    g_grimTitle = BOTC_NewLabel(g_grimDlg, 450, 34, 14, 12, StringToText("魔典"));
    // 标题只是文字，不要让它的控件范围盖住左边新加的【强制玩家发起提名】按钮
    libNtve_gf_SetDialogItemAcceptMouse(g_grimTitle, false, PlayerGroupAll());
    // 说书人专用的「游戏正式开始」按钮（正式开始后变成「取消正式开始」）
    g_grimStart = BOTC_NewButton(g_grimDlg, 223, 36, 803, 9, "游戏正式开始");
    DialogControlSetVisible(g_grimStart, PlayerGroupAll(), false);
    DialogControlSetVisible(g_grimStart, PlayerGroupSingle(g_teller), true);
    // 说书人专用的「处决标记」按钮（按一下再点座位）
    g_execBtn = BOTC_NewButton(g_grimDlg, 162, 36, 468, 9, "处决标记");
    DialogControlSetVisible(g_execBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_execBtn, PlayerGroupSingle(g_teller), true);
    // 说书人专用的「死亡标记」按钮（夜杀 / 诅咒致死等，不占处决名额）
    g_deadBtn = BOTC_NewButton(g_grimDlg, 162, 36, 635, 9, "死亡标记");
    DialogControlSetVisible(g_deadBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_deadBtn, PlayerGroupSingle(g_teller), true);
    // 【强制玩家发起提名】（用户 2026-11-03）：放在处决标记左边；按钮够宽，不能出现省略号
    g_fnBtn = BOTC_NewButton(g_grimDlg, 240, 36, 222, 9, "强制玩家发起提名");
    DialogControlSetVisible(g_fnBtn, PlayerGroupAll(), false);
    // 弹窗：目标1 / 目标2 各一个列表，选好后点【发起提名】或【取消】
    DialogCreate(700, 380, c_anchorCenter, 0, 0, false);
    g_fnDlg = DialogLastCreated();
    DialogSetVisible(g_fnDlg, PlayerGroupAll(), false);
    BOTC_NewLabel(g_fnDlg, 660, 32, 20, 12, StringToText("强制发起提名"));
    BOTC_NewLabel(g_fnDlg, 660, 40, 20, 46, StringToText("目标1 = 发起提名的玩家；目标2 = 被提名的玩家。"));
    BOTC_NewLabel(g_fnDlg, 310, 30, 20, 92, StringToText("目标1：发起提名"));
    BOTC_NewLabel(g_fnDlg, 310, 30, 370, 92, StringToText("目标2：被提名"));
    g_fnList1 = BOTC_NewList(g_fnDlg, 310, 180, 20, 124);
    g_fnList2 = BOTC_NewList(g_fnDlg, 310, 180, 370, 124);
    g_fnOk = BOTC_NewButton(g_fnDlg, 200, 44, 130, 322, "发起提名");
    g_fnCancel = BOTC_NewButton(g_fnDlg, 200, 44, 370, 322, "取消");
    g_fnX = BOTC_NewButton(g_fnDlg, 30, 26, 664, 6, "X");

    // 【说书人也能点这个【声称】】（用户 2026-09-26）：按钮和分支对所有玩家（含 p = 1）都开着
    // 说书人专用的「唤醒」按钮（按一下再点座位：唤醒他 / 再点一次收回他的技能）
    g_wakeBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 54, "唤醒");
    DialogControlSetVisible(g_wakeBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_wakeBtn, PlayerGroupSingle(g_teller), true);
    // 【手动唤醒】（用户 2026-11-11）：放回【唤醒 / 唤醒下一个】右边；仅夜间对说书人可见，
    //   点完直接进入点座位模式（与白天同位置的【声称/猜测】不会同时出现）。
    g_wakeManualBtn = BOTC_NewButton(g_grimDlg, 180, 36, 207, 54, "手动唤醒");
    DialogControlSetVisible(g_wakeManualBtn, PlayerGroupAll(), false);
    // 【说书人工具】：原发送互认按钮位置，面板内含赋予能力 / 使用技能 / 标记能力使用等。
    //   点开一个小面板，里面装着几条固定文案（假疯子 / 疯子刀人 …），都是「先点一条 → 再点收件人 → 填编号」
    g_specBtn = BOTC_NewButton(g_grimDlg, 180, 36, 18, 96, "说书人工具");
    DialogControlSetVisible(g_specBtn, PlayerGroupAll(), false);
    DialogControlSetVisible(g_specBtn, PlayerGroupSingle(g_teller), false);
    // 所有人共用的【声称】按钮（白天才有；目前只有猎手能声称）---- 放在【唤醒】右边
    g_declareBtn = BOTC_NewButton(g_grimDlg, 240, 36, 207, 54, "声称/猜测");
    DialogControlSetVisible(g_declareBtn, PlayerGroupAll(), false);
    // 【死后声称】（用户 2026-09-20）：**跟【声称】同一个位置**（两者永远不会同时出现：活着用上面那个，
    //   死了用这个）；面板复刻白天声称那一套，只是里面**只列「死后声称」的角色**（现在只有月之子 36）。
    //   任何玩家都能点（假声称照旧只是声明，真月之子才会真结算）。
    g_dclaimBtn = BOTC_NewButton(g_grimDlg, 240, 36, 207, 54, "声称/猜测");
    DialogControlSetVisible(g_dclaimBtn, PlayerGroupAll(), false);

    // 「说书人」那一格（用户 2026-09-19 晚）：**完全照搬普通玩家座位的样式** ----
    //   同样 124×124 的座位框；名字那一行也摆在框内偏下的同一个位置（座位中心 +34）、
    //   用座位名字那套样式，内容 = 「说书人 [玩家1的战网名]」---- 座位那边写「编号 [名字]」，
    //   这里用「说书人」顶掉编号，战网名按他自己的玩家颜色上色（在 BOTC_GrimRender 里刷）。
    //   没有身份图标、旁边也没有 ＋；所有玩家一直看得见。平时点它没有任何反应，
    //   只有在「发起私聊」的选人模式里点它，才等于向说书人发起私聊。
    g_saySeatBtn = BOTC_NewButton(g_grimDlg, 112, 112, 841, 67, "");     // 说书人格子的位置（用户 2026-11-04：再往右挪 20，仍留在魔典边框内）
    DialogControlSetVisible(g_saySeatBtn, PlayerGroupAll(), true);
    // 【说书人那一格的身份头像】（用户 2026-09-26）：只有说书人自己看得见（无神论局方便用）
    libNtve_gf_CreateDialogItemImage(g_grimDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_saySeatIcon = DialogControlLastCreated();
    DialogControlSetPosition(g_saySeatIcon, PlayerGroupAll(), c_anchorTopLeft, 834, 62);
    libNtve_gf_SetDialogItemAcceptMouse(g_saySeatIcon, false, PlayerGroupAll());
    libNtve_gf_SetDialogItemImage(g_saySeatIcon, "botc_blank.dds", PlayerGroupAll());
    DialogControlSetVisible(g_saySeatIcon, PlayerGroupAll(), false);
    // 名字行跟着说书人格一起右移；宽度收窄到 203，右边界仍停在 1044，不越出魔典
    g_saySeatLbl = BOTC_NewLabelC(g_grimDlg, 203, 26, 841, 153, StringToText(""));
    libNtve_gf_SetDialogItemStyle(g_saySeatLbl, g_grimNameStyle, PlayerGroupAll());
    libNtve_gf_SetDialogItemAcceptMouse(g_saySeatLbl, true, PlayerGroupAll());
    DialogControlSetVisible(g_saySeatLbl, PlayerGroupAll(), true);
    // 「说书人」那一格的红叉（用户 2026-09-20）：死亡标记也能给说书人自己打
    libNtve_gf_CreateDialogItemImage(g_grimDlg, 112, 112, c_anchorCenter, 0, 0, StringToText(""), null, c_triggerImageTypeNormal, true, Color(100, 100, 100), c_triggerBlendModeNormal);
    g_saySeatDead = DialogControlLastCreated();
