// 画一行：col 0 = 首夜 / 1 = 第二夜起，row 0..11，r = 身份索引
void BOTC_NightOrderRow (int p, int col, int row, int r) {
    int idx;
    int x;
    int y;
    idx = (p * 24) + (col * 12) + row;
    x = 40 + (col * 490);
    y = 60 + (row * 84);
    libNtve_gf_SetDialogItemImage(g_noIcon[idx], BOTC_NightIconName(r), PlayerGroupSingle(p));
    DialogControlSetPosition(g_noIcon[idx], PlayerGroupSingle(p), c_anchorTopLeft, x, y);
    DialogControlSetVisible(g_noIcon[idx], PlayerGroupSingle(p), true);
    libNtve_gf_SetDialogItemText(g_noName[idx], TextWithColor(StringToText(g_roleName[r]), BOTC_RoleTeamColor(r)), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[idx], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[idx], PlayerGroupSingle(p), c_anchorTopLeft, x + 97, y + 30);
    DialogControlSetVisible(g_noName[idx], PlayerGroupSingle(p), true);
}

// 铺内容：左栏「首夜」（第 0 行固定写爪牙与恶魔互相得知）、右栏「第二夜起」
void BOTC_NightOrderRender (int p) {
    int i;
    int r;
    int o;
    int row;
    int b;
    int base;
    bool[164] showRole;
    base = p * 24;
    for (i = 0; i < 24; i += 1) {
        DialogControlSetVisible(g_noIcon[base + i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(g_noName[base + i], PlayerGroupSingle(p), false);
    }
    b = g_board;
    if (b < 1 || b > 15) {
        b = 1;
    }
    for (r = 0; r <= 163; r += 1) {
        showRole[r] = false;
    }
    for (i = 0; i < g_boardRoleN[b]; i += 1) {
        r = g_boardRole[(b * 256) + i];
        if (r >= 0 && r <= 163) {
            showRole[r] = true;
        }
    }
    // 实际发到玩家身上的角色也显示，避免手工改身份 / 自定义板漏角色。
    for (i = 2; i <= 13; i += 1) {
        r = g_mark[(g_teller * 14) + i] - 1;
        if (r >= 0 && r <= 163) {
            showRole[r] = true;
        }
    }
    for (r = 0; r <= 163; r += 1) {
        if (g_legacyOn[r]) {
            showRole[r] = true;
        }
    }
    // 【全员追忆 / 小怪宝】（用户 2026-11-07）：照看者本身的魔典身份是爪牙，
    // 角色 112 不会发到任何玩家手里；只要本局已识别为小怪宝局，就保证夜序表列出它。
    if (g_lmOn || b == 13) {
        showRole[112] = true;
        // 运行时兜底：即使有旧的板子初始化或读档把这两格清成 0，夜序表也仍能显示小怪宝。
        if (g_noAllFirst[112] <= 0) {
            g_noAllFirst[112] = 26;
        }
        if (g_noAllOther[112] <= 0) {
            g_noAllOther[112] = 59;
        }
    }
    g_noMaxRows[p] = 0;
    // 左栏第 0 行：固定（跟着翻页平移，翻下去就藏起来）
    libNtve_gf_SetDialogItemText(g_noName[base], StringToText("爪牙与恶魔互相得知"), PlayerGroupSingle(p));
    libNtve_gf_SetDialogItemStyle(g_noName[base], "ModLeftSize20Bold", PlayerGroupSingle(p));
    DialogControlSetPosition(g_noName[base], PlayerGroupSingle(p), c_anchorTopLeft, 44, 90 - (g_noShift[p] * 84));
    DialogControlSetVisible(g_noName[base], PlayerGroupSingle(p), (g_noShift[p] == 0));
    // 左栏：按首夜顺序
    row = 1;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 163; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllFirst[r] != o) {
                continue;
            }
            if ((row - g_noShift[p]) >= 0 && (row - g_noShift[p]) < 11) {
                BOTC_NightOrderRow(p, 0, row - g_noShift[p], r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows[p]) {
        g_noMaxRows[p] = row;
    }
    // 右栏：第二夜起
    row = 0;
    for (o = 1; o <= 127; o += 1) {
        for (r = 0; r <= 163; r += 1) {
            if (!showRole[r]) { continue; }
            if (g_noAllOther[r] != o) {
                continue;
            }
            if ((row - g_noShift[p]) >= 0 && (row - g_noShift[p]) < 11) {
                BOTC_NightOrderRow(p, 1, row - g_noShift[p], r);
            }
            row = row + 1;
        }
    }
    if (row > g_noMaxRows[p]) {
        g_noMaxRows[p] = row;
    }
    libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("显示第 " + IntToString(g_noShift[p] + 1) + " - " + IntToString(g_noShift[p] + 11) + " 行（最长一栏 " + IntToString(g_noMaxRows[p]) + " 行）"), PlayerGroupSingle(p));
    if (g_noShift[p] + 11 >= g_noMaxRows[p]) {
        libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("显示第 " + IntToString(g_noShift[p] + 1) + " - " + IntToString(g_noMaxRows[p]) + " 行（共 " + IntToString(g_noMaxRows[p]) + " 行）"), PlayerGroupSingle(p));
    }
    if (g_noMaxRows[p] <= 11) {
        libNtve_gf_SetDialogItemText(g_noPageLbl[p], StringToText("共 " + IntToString(g_noMaxRows[p]) + " 行"), PlayerGroupSingle(p));
    }
}

// 翻页：delta = +6 / -6；越界自动夹住（最长一栏 - 12 = 最后一页）
void BOTC_NightOrderScroll (int p, int delta) {
    int maxShift;
    maxShift = g_noMaxRows[p] - 11;
    if (maxShift < 0) {
        maxShift = 0;
    }
    g_noShift[p] = g_noShift[p] + delta;
    if (g_noShift[p] < 0) {
        g_noShift[p] = 0;
    }
    if (g_noShift[p] > maxShift) {
        g_noShift[p] = maxShift;
    }
    BOTC_NightOrderRender(p);
}

void BOTC_NightOrderOpen (int p) {
    int ox;
    int oy;
    g_noShift[p] = 0;              // 每次打开都从最上面开始
    BOTC_NightOrderRender(p);
    g_noOpen[p] = true;
    g_abOpen[p] = false;
    DialogSetVisible(g_abNewDlg[p], PlayerGroupSingle(p), false);
    // 与剧本角色表共用一个窗口：尺寸、位置完全一致，拖动其中一个两个视图一起走
    ox = g_abOffX[p];
    oy = g_abOffY[p];
    if (ox < -370) { ox = -370; }
    if (ox > 370) { ox = 370; }
    if (oy < -30) { oy = -30; }
    if (oy > 30) { oy = 30; }
    DialogSetPosition(g_noDlg[p], c_anchorCenter, ox, oy);
    DialogSetPosition(g_abNewDlg[p], c_anchorCenter, ox, oy);
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), true);
}

void BOTC_NightOrderClose (int p) {
    g_noOpen[p] = false;
    DialogSetVisible(g_noDlg[p], PlayerGroupSingle(p), false);
}

// 【剧本角色表 ↔ 夜间行动顺序】（用户 2026-11-04）：同一个弹窗，左上角按钮切换两个视图
