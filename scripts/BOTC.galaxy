    g_tipLine[491] = StringToText("暴乱");
    g_tipLine[492] = StringToText("：如果暴乱提名并处决了") + TextWithColor(StringToText("旅店老板"), Color(0, 191, 255)) + StringToText("上个夜晚保护的其中一名玩家，") + TextWithColor(StringToText("善良"), Color(30,144,255)) + StringToText("阵营获胜。");
    g_tipRoleAt[26] = 5119;    // 旅店老板
    g_tipRoleN[26] = 14;
    g_tipLine[493] = StringToText("【角色能力】");
    g_tipLine[494] = StringToText("每个夜晚*，你要选择一名玩家并猜测该玩家的角色：如果你猜错了，你会死亡。");
    g_tipLine[495] = StringToText("【角色简介】");
    g_tipLine[496] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("能够猜测玩家的角色......但是猜错的代价是相当巨大的。");
    g_tipLine[497] = StringToText("除了首个夜晚以外的每个夜晚，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("需要选择一名玩家，并在角色列表上指向一个角色");
    g_tipLine[498] = StringToText("图标来猜测其角色。如果猜测正确，无事发生。如果猜测错误，") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("死亡。");
    g_tipLine[499] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("不会从说书人处得知自己的猜测是正确还是错误。");
    g_tipLine[500] = TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("可以选择任何玩家，无论是已死亡还是存活，甚至可以是") + TextWithColor(StringToText("赌徒"), Color(0, 191, 255)) + StringToText("自己。");
    g_tipRoleAt[27] = 7058;    // 赌徒
    g_tipRoleN[27] = 12;
    g_tipLine[501] = StringToText("【角色能力】");
    g_tipLine[502] = StringToText("每个白天，你可以公开发表一个声明。如果该声明正确，在当晚会有一名玩家死亡。");
    g_tipLine[503] = StringToText("【角色简介】");
    g_tipLine[504] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("会故意编造谎言，希望能借此揭开真相。");
    g_tipLine[505] = StringToText("每个白天，") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("可以公开发表一个声明。如果该声明是正确的，说书人会在当晚杀死");
    g_tipLine[506] = StringToText("一名玩家。如果声明是错误的，那就没有玩家会因") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("而死。");
    g_tipLine[507] = StringToText("含糊不清的词语、低声细语、说书人无法判断对错的声明、或是发表声明时有人没听到");
    g_tipLine[508] = StringToText("等情况下，声明都不作数。如同猎手的能力，说书人和每一名玩家都必须要听到并明确");
    g_tipLine[509] = TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("发表的声明，明白") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("正在使用自己的能力，以此来让说书人判定接下来会发");
    g_tipLine[510] = StringToText("生什么。");
    g_tipLine[511] = StringToText("如果") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("在白天处于") + TextWithColor(StringToText("醉酒"), Color(128,0,128)) + StringToText("或") + TextWithColor(StringToText("中毒"), Color(128,0,128)) + StringToText("时发表了一个正确的声明，但当晚") + TextWithColor(StringToText("造谣者"), Color(0, 191, 255)) + StringToText("能力触发时");
    g_tipLine[512] = StringToText("他恢复了清醒和健康，那么说书人仍然会杀死一名玩家。（点击魔典左上方的【声称】发动技能）");
    g_tipRoleAt[28] = 7070;    // 造谣者
