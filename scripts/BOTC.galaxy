    g_jinxText3[131] = "";
    g_jinxA[132] = 162;  g_jinxB[132] = 148;
    g_jinxText[132] = "蛊雕与食人魔：如果「蛊毒」玩家被食人魔当作邪恶的蛊雕，食人魔会得知自己转变为邪恶。";
