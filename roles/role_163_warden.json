    }
  ],
  "effects": [
    {
      "kind": "custom",
      "id": "select_next_batch",
      "notes": "首夜及之后每夜可选择零至三名不同玩家，先登记为下一批判罚；直接确认时本夜不放置新判罚。"
    },
    {
      "kind": "custom",
      "id": "resolve_previous_batch",
      "notes": "玩家选择新一批后，才结算上一批；若选择莽夫导致典狱长醉酒，会先阻止上一批死亡结算。"
    },
    {
      "kind": "custom",
      "id": "execution_chain",
      "notes": "上一批中有人白天死于处决时，除该死者外的其他上一批玩家在当晚死亡。"
    },
    {
      "kind": "custom",
      "id": "no_execution_single_death",
      "notes": "上一批无人死于处决时，由说书人从上一批仍能死亡的玩家中选择一人在典狱长行动轮次死亡。"
    }
  ],
  "randomness": {
    "declared": false,
    "notes": "无人死于处决时由说书人选择死亡玩家，不使用随机数。"
  },
  "tests": [
    "首夜可以选择零至三名不同玩家；选择零人时直接确认且不放置判罚标记。",
    "第二夜先选择新一批，再结算上一批。",
    "上一批有人白天死于处决时，其他上一批玩家当晚死亡。",
    "上一批无人死于处决时，由说书人选择其中一名仍能死亡的玩家死亡。",
    "新一批选择到莽夫并导致典狱长醉酒时，上一批死亡结算被阻止。",
    "判罚标记在典狱长中毒或醉酒时仍要放置。",
    "典狱长死亡或离场时清除判罚与死于今日标记。"
